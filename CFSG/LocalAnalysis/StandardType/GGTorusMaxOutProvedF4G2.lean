theorem tmOut_F4
    (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower) (hd : d.1 = .F4 q)
    (J : Type) [Group J] [Finite J]
    (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  subst hd
  obtain ⟨e⟩ := e
  have ht : tmLieOut (.F4 q) = q.exponent * (if q.p = 2 then 2 else 1) := rfl
  have hout : Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.F4 q, hv⟩).Group) ∣
      tmLieOut (.F4 q) := by
    rw [ht]
    by_cases h2 : q.p = 2
    · rw [if_pos h2]
      have h := gl12kE_F4_card_outer q hv
      rwa [Nat.mul_comm 2 q.exponent] at h
    · rw [if_neg h2, Nat.mul_one]
      obtain ⟨K, _, _, hK, -, ⟨eK⟩⟩ :=
        exists_catEquiv_adjointGroup CFSG.TauCetiBridge.Even.chevalleyBridgesAll.f4 q hv
      have hK' : Nat.card K = q.p ^ q.exponent :=
        hK.trans (TauCeti.PrimePower.card_def q)
      obtain ⟨-, Θ, -, -, hker, -⟩ :=
        CFSG.LieType.Chevalley.odd_F4_and_nonexceptional_G2_automorphism_normal_form
          q.prime_p h2 q.exponent_pos K hK' .F4 (Or.inl rfl)
      calc Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.F4 q, hv⟩).Group)
          = Nat.card (Outer (adjointGroup .F4 K)) := gl12kE_card_outer_congr eK
        _ ∣ Nat.card (K ≃+* K) := gl12kE_card_outer_dvd Θ hker
        _ = q.exponent :=
            (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic
              q.prime_p K hK').1
  have houtJ : Nat.card (Outer J) ∣ tmLieOut (.F4 q) := by
    rw [gl12kE_card_outer_congr e]
    exact hout
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd houtJ

theorem tmOut_G2
    (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower) (hd : d.1 = .G2 q)
    (J : Type) [Group J] [Finite J]
    (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  subst hd
  obtain ⟨e⟩ := e
  have hq3 : 3 ≤ q.card := by
    have h := ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
    simpa [TauCeti.LieTypeIndex.inStandardRange_iff] using h
  have ht : tmLieOut (.G2 q) = q.exponent * (if q.p = 3 then 2 else 1) := rfl
  have hout : Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.G2 q, hv⟩).Group) ∣
      tmLieOut (.G2 q) := by
    rw [ht]
    by_cases h3 : q.p = 3
    · rw [if_pos h3]
      have h := gl12kE_G2_card_outer q hv hq3
      rwa [Nat.mul_comm 2 q.exponent] at h
    · rw [if_neg h3, Nat.mul_one]
      obtain ⟨K, _, _, hK, -, ⟨eK⟩⟩ :=
        exists_catEquiv_adjointGroup CFSG.TauCetiBridge.Even.chevalleyBridgesAll.g2 q hv
      have hK' : Nat.card K = q.p ^ q.exponent :=
        hK.trans (TauCeti.PrimePower.card_def q)
      have hdvd : Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.G2 q, hv⟩).Group) ∣ q.exponent := by
        by_cases h2 : q.p = 2
        · have hf2 : 2 ≤ q.exponent := by
            by_contra hlt
            have h1 : q.exponent = 1 := by have := q.exponent_pos; omega
            rw [TauCeti.PrimePower.card_def, h2, h1] at hq3
            omega
          have hK2 : Nat.card K = 2 ^ q.exponent := by rw [hK', h2]
          obtain ⟨-, Θ, -, -, hker, -⟩ :=
            CFSG.ComponentClassification.UnbalancedCatalog.even_G2_exact_automorphism_normal_form
              hf2 K hK2
          calc Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.G2 q, hv⟩).Group)
              = Nat.card (Outer (adjointGroup .G2 K)) := gl12kE_card_outer_congr eK
            _ ∣ Nat.card (K ≃+* K) := gl12kE_card_outer_dvd Θ hker
            _ = q.exponent :=
                (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic
                  q.prime_p K hK').1
        · obtain ⟨-, Θ, -, -, hker, -⟩ :=
            CFSG.LieType.Chevalley.odd_F4_and_nonexceptional_G2_automorphism_normal_form
              q.prime_p h2 q.exponent_pos K hK' .G2 (Or.inr ⟨rfl, h3⟩)
          calc Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.G2 q, hv⟩).Group)
              = Nat.card (Outer (adjointGroup .G2 K)) := gl12kE_card_outer_congr eK
            _ ∣ Nat.card (K ≃+* K) := gl12kE_card_outer_dvd Θ hker
            _ = q.exponent :=
                (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic
                  q.prime_p K hK').1
      exact hdvd
  have houtJ : Nat.card (Outer J) ∣ tmLieOut (.G2 q) := by
    rw [gl12kE_card_outer_congr e]
    exact hout
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd houtJ

