variable {G : Type} [Group G] [Finite G]

omit [Finite G] in
theorem ggN2_le_of_isSubnormal {A B : Subgroup G} (h : CFSG.Open.IsSubnormal A B) :
    A ≤ B := by
  induction h with
  | refl => exact le_rfl
  | step hHM _ _ ih => exact hHM.trans ih

omit [Finite G] in
theorem ggN2_isSubnormal_trans {A B C : Subgroup G} (h₁ : CFSG.Open.IsSubnormal A B)
    (h₂ : CFSG.Open.IsSubnormal B C) : CFSG.Open.IsSubnormal A C := by
  revert h₂
  induction h₁ with
  | refl => exact id
  | step hHM hn _ ih => exact fun h₂ => CFSG.Open.IsSubnormal.step hHM hn (ih h₂)

theorem ggN2_isComponentOf_pLayer_of_normal {p : ℕ} [Fact p.Prime] {H₀ J : Subgroup G}
    (hJH₀ : J ≤ H₀) (hJ : (J.subgroupOf H₀).Normal) (u : G) {K : Subgroup G}
    (hK : CFSG.Open.IsComponentOf K (LargeEvenPLayer p (J ⊓ Subgroup.centralizer {u}))) :
    CFSG.Open.IsComponentOf K (LargeEvenPLayer p (H₀ ⊓ Subgroup.centralizer {u})) := by
  set A := J ⊓ Subgroup.centralizer ({u} : Set G) with hA
  set B := H₀ ⊓ Subgroup.centralizer ({u} : Set G) with hB
  have hAB : A ≤ B := inf_le_inf_right _ hJH₀
  have hAn : (A.subgroupOf B).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hAB]
    intro y m hy hm
    exact ⟨(Subgroup.normal_subgroupOf_iff hJH₀).mp hJ y m hy.1 hm.1,
      Subgroup.mul_mem _ (Subgroup.mul_mem _ hm.2 hy.2) (Subgroup.inv_mem _ hm.2)⟩
  have hle : LargeEvenPLayer p A ≤ LargeEvenPLayer p B := by
    rw [largeEvenPLayer_eq_lBalancePLayer, largeEvenPLayer_eq_lBalancePLayer]
    exact sSup_le fun L hL => le_sSup (lBalanceIsPComponent_of_normal hAB
      (ggN2_le_of_isSubnormal hL.1) hL)
  have hBA : B ≤ Subgroup.normalizer (A : Set G) := fun g hg =>
    Subgroup.mem_normalizer_iff.mpr fun y =>
      ⟨fun hy => (Subgroup.normal_subgroupOf_iff hAB).mp hAn y g hy hg, fun hy => by
        have h1 := (Subgroup.normal_subgroupOf_iff hAB).mp hAn _ g⁻¹ hy (B.inv_mem hg)
        rwa [show g⁻¹ * (g * y * g⁻¹) * g⁻¹⁻¹ = y by group] at h1⟩
  have hn : ((LargeEvenPLayer p A).subgroupOf (LargeEvenPLayer p B)).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hle]
    intro y g hy hg
    have hgB : g ∈ B := by
      rw [largeEvenPLayer_eq_lBalancePLayer] at hg
      exact lBalancePLayer_le p B hg
    have hA' : A.map (MulAut.conj g).toMonoidHom = A := by
      have hgN := hBA hgB
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact (Subgroup.mem_normalizer_iff.mp hgN y).mp hy
      · intro hx
        refine ⟨g⁻¹ * x * g, (Subgroup.mem_normalizer_iff.mp hgN (g⁻¹ * x * g)).mpr ?_, ?_⟩
        · rwa [show g * (g⁻¹ * x * g) * g⁻¹ = x by group]
        · show g * (g⁻¹ * x * g) * g⁻¹ = x
          group
    have hmap : (LargeEvenPLayer p A).map (MulAut.conj g).toMonoidHom = LargeEvenPLayer p A := by
      rw [largeEvenPLayer_map_conj, hA']
    rw [← hmap]
    exact ⟨y, hy, rfl⟩
  exact ⟨hK.1.trans hle, ggN2_isSubnormal_trans hK.2.1
    (CFSG.Open.IsSubnormal.step hle hn (CFSG.Open.IsSubnormal.refl _)), hK.2.2⟩

end CFSG.StandardType

