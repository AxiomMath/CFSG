private lemma ggQ2xE8_cover_w2_or (v : GGBCV 8) (hw : ggBCWt v = 2) (ε : ZMod 3)
    (hε : ε = 1 ∨ ε = -1) : v ∈ ggQ2xE8_dataSet ε := by
  obtain ⟨i, j, a, b, hij, ha, hb, rfl⟩ := ggQ2xE8_weight_two hw
  rcases hε with h | h
  · rw [h]
    rcases lt_or_gt_of_ne hij with hlt | hgt
    · exact ggQ2xE8_cover_w2_1 i j a b hlt ha hb
    · rw [show a • (Pi.single i 1 : GGBCV 8) + b • Pi.single j 1
          = b • Pi.single j 1 + a • Pi.single i 1 from add_comm _ _]
      exact ggQ2xE8_cover_w2_1 j i b a hgt hb ha
  · rw [h]
    rcases lt_or_gt_of_ne hij with hlt | hgt
    · exact ggQ2xE8_cover_w2_m1 i j a b hlt ha hb
    · rw [show a • (Pi.single i 1 : GGBCV 8) + b • Pi.single j 1
          = b • Pi.single j 1 + a • Pi.single i 1 from add_comm _ _]
      exact ggQ2xE8_cover_w2_m1 j i b a hgt hb ha

