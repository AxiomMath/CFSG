lemma ggQ2xE8_cover (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    ∀ v : GGBCV 8, ggQ2xE8_RootSet ε v → v ∈ ggQ2xE8_dataSet ε := by
  intro v hv
  rcases hv with hw | hh
  · exact ggQ2xE8_cover_w2_or v hw ε hε
  · rcases hε with h | h
    · rw [h] at hh ⊢; exact ggQ2xE8_cover_hs_1 hh.1 hh.2
    · rw [h] at hh ⊢; exact ggQ2xE8_cover_hs_m1 hh.1 hh.2

lemma ggQ2xE8_s_mem (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    ∀ v : GGBCV 8, ggQ2xE8_RootSet ε v → ∀ k : Fin 8,
      ggQ2xE8_RootSet ε (ggQ2xE8_s ε k v) := by
  intro v hv k
  rcases hv with hw | hh
  · exact ggQ2xE8_s_mem_w2_or v hw ε hε k
  · rcases hε with h | h
    · rw [h] at hh ⊢; exact ggQ2xE8_s_mem_hs_1 hh.1 hh.2 k
    · rw [h] at hh ⊢; exact ggQ2xE8_s_mem_hs_m1 hh.1 hh.2 k

lemma ggQ2xE8_simpleRefl_apply (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (k : (ggQ2xE8_D ε hε).ι) (v : (ggQ2xE8_D ε hε).V) :
    (ggQ2xE8_D ε hε).simpleRefl k v = ggQ2xE8_s ε k v := by
  change Module.preReflection (ggQ2xE8_z ε k) (ggBCDot (ggQ2xE8_z ε k)) v = ggQ2xE8_s ε k v
  change v - (ggBCDot (ggQ2xE8_z ε k) v) • ggQ2xE8_z ε k = ggQ2xE8_s ε k v
  rw [ggQ2xE8_dot_apply]

private lemma ggQ2xE8_two_mul : ∀ x : ZMod 3, (2 : ZMod 3) * x = -x := by decide

private lemma ggQ2xE8_two_smul (r : ZMod 3) (z : GGBCV 8) :
    ((2 : ZMod 3) * r) • z = -(r • z) := by
  rw [show (2 : ZMod 3) * r = -r from ggQ2xE8_two_mul r]
  exact neg_smul r z

lemma ggQ2xE8_simpleRefl_eq_refl (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (k : (ggQ2xE8_D ε hε).ι) :
    (ggQ2xE8_D ε hε).simpleRefl k = ggBCRefl (ggQ2xE8_z ε k) (ggQ2xE8_hz ε hε k) := by
  apply LinearEquiv.ext
  intro v
  change Module.preReflection (ggQ2xE8_z ε k) (ggBCDot (ggQ2xE8_z ε k)) v =
    ggBCRefl (ggQ2xE8_z ε k) (ggQ2xE8_hz ε hε k) v
  change v - (ggBCDot (ggQ2xE8_z ε k) v) • ggQ2xE8_z ε k =
    ggBCRefl (ggQ2xE8_z ε k) (ggQ2xE8_hz ε hε k) v
  rw [ggQ2xE8_dot_apply, ggQ2xE8_refl_apply, ggQ2xE8_norm ε hε k]
  rw [ggQ2xE8_two_smul (ggQ2xE8_z ε k ⬝ᵥ v) (ggQ2xE8_z ε k), sub_eq_add_neg]

private lemma ggQ2xE8_iso_scalar : ∀ r d p q : ZMod 3, d * d = 1 →
    r + d * p * q + d * q * (p + d * p * d) = r := by decide

lemma ggQ2xE8_refl_isometry {n : ℕ} (c : GGBCV n) (hc : c ⬝ᵥ c ≠ 0) (x y : GGBCV n) :
    (ggBCRefl c hc x) ⬝ᵥ (ggBCRefl c hc y) = x ⬝ᵥ y := by
  have hcast : ∀ z : ZMod 3, z ≠ 0 → z * z = 1 := by decide
  have hdd : (c ⬝ᵥ c) * (c ⬝ᵥ c) = 1 := hcast _ hc
  rw [ggQ2xE8_refl_apply, ggQ2xE8_refl_apply]
  simp only [add_dotProduct, dotProduct_add, smul_dotProduct, dotProduct_smul, smul_eq_mul]
  rw [dotProduct_comm (c : GGBCV n) x, dotProduct_comm (c : GGBCV n) y]
  rw [ggQ2xE8_iso_scalar (x ⬝ᵥ y) (c ⬝ᵥ c) (x ⬝ᵥ c) (y ⬝ᵥ c) hdd]

@[expose] def ggQ2xE8_IsIso {n : ℕ} (b : GGBCV n ≃ₗ[ZMod 3] GGBCV n) : Prop :=
  ∀ x y, (b x) ⬝ᵥ (b y) = x ⬝ᵥ y

private lemma ggQ2xE8_isIso_one {n : ℕ} : ggQ2xE8_IsIso (1 : GGBCV n ≃ₗ[ZMod 3] GGBCV n) :=
  fun _ _ => rfl

private lemma ggQ2xE8_isIso_mul {n : ℕ} {a b : GGBCV n ≃ₗ[ZMod 3] GGBCV n}
    (ha : ggQ2xE8_IsIso a) (hb : ggQ2xE8_IsIso b) : ggQ2xE8_IsIso (a * b) := by
  intro x y
  rw [LinearEquiv.mul_apply, LinearEquiv.mul_apply, ha, hb]

private lemma ggQ2xE8_isIso_inv {n : ℕ} {a : GGBCV n ≃ₗ[ZMod 3] GGBCV n}
    (ha : ggQ2xE8_IsIso a) : ggQ2xE8_IsIso a⁻¹ := by
  intro x y
  have h := ha (a⁻¹ x) (a⁻¹ y)
  simpa using h.symm

private noncomputable def ggQ2xE8_Drefl (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (c : (ggQ2xE8_D ε hε).V) (hc : c ⬝ᵥ c ≠ 0) :
    (ggQ2xE8_D ε hε).V ≃ₗ[ZMod 3] (ggQ2xE8_D ε hε).V :=
  ggBCRefl c hc

lemma ggQ2xE8_conj_refl {n : ℕ} (b : GGBCV n ≃ₗ[ZMod 3] GGBCV n)
    (hb : ggQ2xE8_IsIso b) (c : GGBCV n) (hc : c ⬝ᵥ c ≠ 0) :
    b * ggBCRefl c hc * b.symm = ggBCRefl (b c) (by rw [hb]; exact hc) := by
  have hbc : (b c) ⬝ᵥ (b c) = c ⬝ᵥ c := hb c c
  ext v
  have hbv : (b c) ⬝ᵥ v = c ⬝ᵥ (b.symm v) := by
    conv_lhs => rw [← LinearEquiv.apply_symm_apply b v]
    rw [hb c (b.symm v)]
  rw [LinearEquiv.mul_apply, LinearEquiv.mul_apply, ggQ2xE8_refl_apply, ggQ2xE8_refl_apply,
    map_add, map_smul, LinearEquiv.apply_symm_apply, hbc, hbv]

private lemma ggQ2xE8_Drefl_conj (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (b : (ggQ2xE8_D ε hε).V ≃ₗ[ZMod 3] (ggQ2xE8_D ε hε).V)
    (hb : ggQ2xE8_IsIso b) (c : (ggQ2xE8_D ε hε).V) (hc : c ⬝ᵥ c ≠ 0) :
    b * ggQ2xE8_Drefl ε hε c hc * b.symm =
      ggQ2xE8_Drefl ε hε (b c) (by rw [hb]; exact hc) :=
  ggQ2xE8_conj_refl b hb c hc

private lemma ggQ2xE8_weyl_maps (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    ∀ w ∈ (ggQ2xE8_D ε hε).weyl, ggQ2xE8_IsIso w ∧
      (∀ c : GGBCV 8, ggQ2xE8_RootSet ε c → ggQ2xE8_RootSet ε (w c)) := by
  intro w hw
  rw [GGQ2Lin.weyl, GGQ2Lin.parab] at hw
  refine Subgroup.closure_induction
    (p := fun w _ => ggQ2xE8_IsIso w ∧
      (∀ c : GGBCV 8, ggQ2xE8_RootSet ε c → ggQ2xE8_RootSet ε (w c)))
    ?_ ?_ ?_ ?_ hw
  · rintro _ ⟨j, -, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [ggQ2xE8_simpleRefl_eq_refl ε hε j]
      exact ggQ2xE8_refl_isometry _ _
    · intro c hc
      have h : ((ggQ2xE8_D ε hε).simpleRefl j) c = ggQ2xE8_s ε j c := by
        change Module.preReflection (ggQ2xE8_z ε j) (ggBCDot (ggQ2xE8_z ε j)) c =
          ggQ2xE8_s ε j c
        change c - (ggBCDot (ggQ2xE8_z ε j) c) • ggQ2xE8_z ε j = ggQ2xE8_s ε j c
        rw [ggQ2xE8_dot_apply]
      convert ggQ2xE8_s_mem ε hε c hc j using 1
  · exact ⟨ggQ2xE8_isIso_one, fun c hc => hc⟩
  · rintro x y _ _ ⟨hix, hpx⟩ ⟨hiy, hpy⟩
    exact ⟨ggQ2xE8_isIso_mul hix hiy, fun c hc => hpx _ (hpy c hc)⟩
  · rintro x _ ⟨hix, hpx⟩
    refine ⟨ggQ2xE8_isIso_inv hix, ?_⟩
    intro c hc
    have hfin : ({v : GGBCV 8 | ggQ2xE8_RootSet ε v} : Set (GGBCV 8)).Finite := Set.toFinite _
    have hmaps : Set.MapsTo x {v : GGBCV 8 | ggQ2xE8_RootSet ε v}
        {v : GGBCV 8 | ggQ2xE8_RootSet ε v} := fun v hv => hpx v hv
    have hinj : Set.InjOn x {v : GGBCV 8 | ggQ2xE8_RootSet ε v} :=
      fun a _ b _ h => x.injective h
    have hbij := (Set.Finite.injOn_iff_bijOn_of_mapsTo hfin hmaps).mp hinj
    obtain ⟨b, hb, hbw⟩ := hbij.surjOn hc
    rw [← hbw]
    simpa using hb

private lemma ggQ2xE8_z_mem_1 : ∀ k : Fin 8, ggQ2xE8_RootSet 1 (ggQ2xE8_z 1 k) := by decide

private lemma ggQ2xE8_z_mem_m1 : ∀ k : Fin 8, ggQ2xE8_RootSet (-1) (ggQ2xE8_z (-1) k) := by
  decide

lemma ggQ2xE8_z_mem (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) (k : Fin 8) :
    ggQ2xE8_RootSet ε (ggQ2xE8_z ε k) := by
  rcases hε with h | h
  · rw [h]; exact ggQ2xE8_z_mem_1 k
  · rw [h]; exact ggQ2xE8_z_mem_m1 k

private def ggQ2xE8_vecWord (ε : ZMod 3) : List (Fin 8) → GGBCV 8
  | [] => 0
  | k0 :: rest => rest.foldl (fun v j => ggQ2xE8_s ε j v) (ggQ2xE8_z ε k0)

private noncomputable def ggQ2xE8_wprod (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    List (Fin 8) → (GGBCV 8 ≃ₗ[ZMod 3] GGBCV 8)
  | [] => 1
  | _ :: rest => rest.foldl (fun acc j => acc.trans ((ggQ2xE8_D ε hε).simpleRefl j)) 1

private lemma ggQ2xE8_foldl_apply (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (rest : List (Fin 8)) (g : GGBCV 8 ≃ₗ[ZMod 3] GGBCV 8) (v : GGBCV 8) :
    (rest.foldl (fun acc j => acc.trans ((ggQ2xE8_D ε hε).simpleRefl j)) g) v =
      rest.foldl (fun u j => (ggQ2xE8_D ε hε).simpleRefl j u) (g v) := by
  induction rest generalizing g with
  | nil => rfl
  | cons j t ih =>
    rw [List.foldl_cons, List.foldl_cons, ih]
    rfl

private lemma ggQ2xE8_foldl_s_eq (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (rest : List (Fin 8)) (v : GGBCV 8) :
    rest.foldl (fun u j => (ggQ2xE8_D ε hε).simpleRefl j u) v =
      rest.foldl (fun u j => ggQ2xE8_s ε j u) v := by
  induction rest generalizing v with
  | nil => rfl
  | cons j t ih =>
    rw [List.foldl_cons, List.foldl_cons]
    rw [show (ggQ2xE8_D ε hε).simpleRefl j v = ggQ2xE8_s ε j v from
      ggQ2xE8_simpleRefl_apply ε hε j v]
    exact ih _

private lemma ggQ2xE8_wprod_apply (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) (k0 : Fin 8)
    (rest : List (Fin 8)) :
    ggQ2xE8_wprod ε hε (k0 :: rest) (ggQ2xE8_z ε k0) =
      ggQ2xE8_vecWord ε (k0 :: rest) := by
  rw [ggQ2xE8_wprod, ggQ2xE8_vecWord, ggQ2xE8_foldl_apply, ggQ2xE8_foldl_s_eq]
  rfl

private lemma ggQ2xE8_wprod_mem (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) (word : List (Fin 8)) :
    ggQ2xE8_wprod ε hε word ∈ (ggQ2xE8_D ε hε).weyl := by
  have h : ∀ (l : List (Fin 8)) (acc : GGBCV 8 ≃ₗ[ZMod 3] GGBCV 8),
      acc ∈ (ggQ2xE8_D ε hε).weyl →
      l.foldl (fun acc j => acc.trans ((ggQ2xE8_D ε hε).simpleRefl j)) acc ∈
        (ggQ2xE8_D ε hε).weyl := by
    intro l
    induction l with
    | nil => intro acc hacc; simpa using hacc
    | cons j t ih =>
      intro acc hacc
      rw [List.foldl_cons]
      exact ih _ (Subgroup.mul_mem _ (ggQ2xQ_simpleRefl_mem_weyl (ggQ2xE8_D ε hε) j) hacc)
  match word with
  | [] => exact Subgroup.one_mem _
  | _ :: rest => exact h rest 1 (Subgroup.one_mem _)

private def ggQ2xE8_wordfun (ε : ZMod 3) : GGBCV 8 × List (Fin 8) → Bool :=
  fun p => decide (ggQ2xE8_vecWord ε p.2 = p.1)

private lemma ggQ2xE8_word_correct_1_1 :
    (ggQ2xE8_data1_1.all (ggQ2xE8_wordfun 1)) = true := by decide
private lemma ggQ2xE8_word_correct_1_2 :
    (ggQ2xE8_data1_2.all (ggQ2xE8_wordfun 1)) = true := by decide
private lemma ggQ2xE8_word_correct_1_3 :
    (ggQ2xE8_data1_3.all (ggQ2xE8_wordfun 1)) = true := by decide
private lemma ggQ2xE8_word_correct_1_4 :
    (ggQ2xE8_data1_4.all (ggQ2xE8_wordfun 1)) = true := by decide
private lemma ggQ2xE8_word_correct_2_1 :
    (ggQ2xE8_data2_1.all (ggQ2xE8_wordfun (-1))) = true := by decide
private lemma ggQ2xE8_word_correct_2_2 :
    (ggQ2xE8_data2_2.all (ggQ2xE8_wordfun (-1))) = true := by decide
private lemma ggQ2xE8_word_correct_2_3 :
    (ggQ2xE8_data2_3.all (ggQ2xE8_wordfun (-1))) = true := by decide
private lemma ggQ2xE8_word_correct_2_4 :
    (ggQ2xE8_data2_4.all (ggQ2xE8_wordfun (-1))) = true := by decide

private lemma ggQ2xE8_word_correct_raw_1 :
    (ggQ2xE8_data1.all (ggQ2xE8_wordfun 1)) = true := by
  rw [ggQ2xE8_data1]
  simp [List.all_append, ggQ2xE8_word_correct_1_1, ggQ2xE8_word_correct_1_2,
    ggQ2xE8_word_correct_1_3, ggQ2xE8_word_correct_1_4]

private lemma ggQ2xE8_word_correct_raw_m1 :
    (ggQ2xE8_data2.all (ggQ2xE8_wordfun (-1))) = true := by
  rw [ggQ2xE8_data2]
  simp [List.all_append, ggQ2xE8_word_correct_2_1, ggQ2xE8_word_correct_2_2,
    ggQ2xE8_word_correct_2_3, ggQ2xE8_word_correct_2_4]

private lemma ggQ2xE8_word_nonempty_raw_1 :
    (ggQ2xE8_data1.all (fun p => decide (p.2 ≠ []))) = true := by decide

private lemma ggQ2xE8_word_nonempty_raw_m1 :
    (ggQ2xE8_data2.all (fun p => decide (p.2 ≠ []))) = true := by decide

private lemma ggQ2xE8_word_correct (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (p : GGBCV 8 × List (Fin 8)) (hp : p ∈ ggQ2xE8_data ε) :
    ggQ2xE8_vecWord ε p.2 = p.1 := by
  rcases hε with h | h
  · subst h
    rw [ggQ2xE8_data_one] at hp
    exact of_decide_eq_true ((List.all_eq_true.mp ggQ2xE8_word_correct_raw_1) p hp)
  · subst h
    rw [ggQ2xE8_data_neg] at hp
    exact of_decide_eq_true ((List.all_eq_true.mp ggQ2xE8_word_correct_raw_m1) p hp)

private lemma ggQ2xE8_word_nonempty (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1)
    (p : GGBCV 8 × List (Fin 8)) (hp : p ∈ ggQ2xE8_data ε) : p.2 ≠ [] := by
  rcases hε with h | h
  · subst h
    rw [ggQ2xE8_data_one] at hp
    exact of_decide_eq_true ((List.all_eq_true.mp ggQ2xE8_word_nonempty_raw_1) p hp)
  · subst h
    rw [ggQ2xE8_data_neg] at hp
    exact of_decide_eq_true ((List.all_eq_true.mp ggQ2xE8_word_nonempty_raw_m1) p hp)

lemma ggQ2xE8_orbit (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) {c : GGBCV 8}
    (hc : ggQ2xE8_RootSet ε c) :
    ∃ (k : Fin 8) (w : GGBCV 8 ≃ₗ[ZMod 3] GGBCV 8),
      w ∈ (ggQ2xE8_D ε hε).weyl ∧
      w (ggQ2xE8_z ε k) = c := by
  obtain ⟨p, hp, hp1⟩ := List.mem_map.mp (ggQ2xE8_cover ε hε c hc)
  obtain ⟨k, rest, hk⟩ := List.exists_cons_of_ne_nil (ggQ2xE8_word_nonempty ε hε p hp)
  have hpeq : (p.1, k :: rest) = p := Prod.ext rfl hk.symm
  have hp' : (p.1, k :: rest) ∈ ggQ2xE8_data ε := hpeq ▸ hp
  have hw : ggQ2xE8_wprod ε hε (k :: rest) (ggQ2xE8_z ε k) = c := by
    rw [ggQ2xE8_wprod_apply, ggQ2xE8_word_correct ε hε (p.1, k :: rest) hp']
    exact hp1
  exact ⟨k, ggQ2xE8_wprod ε hε (k :: rest), ggQ2xE8_wprod_mem ε hε (k :: rest), hw⟩

private lemma ggQ2xE8_isConjRefl_subset (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε) ⊆
      ggBCReflSet {v : GGBCV 8 | ggQ2xE8_RootSet ε v} := by
  rintro t ⟨k, w, hw, rfl⟩
  obtain ⟨hiso, hpres⟩ := ggQ2xE8_weyl_maps ε hε w hw
  have hz0 : (w (ggQ2xE8_z ε k)) ⬝ᵥ (w (ggQ2xE8_z ε k)) ≠ 0 := by
    intro hc
    exact ggQ2xE8_hz ε hε k ((hiso (ggQ2xE8_z ε k) (ggQ2xE8_z ε k)).symm.trans hc)
  have hconj : w * (ggQ2xE8_D ε hε).simpleRefl k * w⁻¹ =
      ggBCRefl (w (ggQ2xE8_z ε k)) hz0 := by
    rw [show w⁻¹ = w.symm from rfl]
    rw [show (ggQ2xE8_D ε hε).simpleRefl k =
      ggQ2xE8_Drefl ε hε (ggQ2xE8_z ε k) (ggQ2xE8_hz ε hε k) from
      ggQ2xE8_simpleRefl_eq_refl ε hε k]
    exact ggQ2xE8_Drefl_conj ε hε w hiso (ggQ2xE8_z ε k) (ggQ2xE8_hz ε hε k)
  rw [hconj]
  exact ⟨w (ggQ2xE8_z ε k), hpres _ (ggQ2xE8_z_mem ε hε k), _, rfl⟩

private lemma ggQ2xE8_reflSet_subset_isConjRefl (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    ggBCReflSet {v : GGBCV 8 | ggQ2xE8_RootSet ε v} ⊆
      ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε) := by
  rintro t ⟨c, hc, hcc, rfl⟩
  obtain ⟨k, w, hw, hwv⟩ := ggQ2xE8_orbit ε hε hc
  obtain ⟨hiso, -⟩ := ggQ2xE8_weyl_maps ε hε w hw
  refine ⟨k, w, hw, ?_⟩
  have hconj : w * (ggQ2xE8_D ε hε).simpleRefl k * w⁻¹ = ggBCRefl c hcc := by
    rw [show w⁻¹ = w.symm from rfl, ggQ2xE8_simpleRefl_eq_refl ε hε k]
    rw [ggQ2xE8_conj_refl w hiso (ggQ2xE8_z ε k) (ggQ2xE8_hz ε hε k)]
    cases hwv
    rfl
  exact hconj.symm

private lemma ggQ2xE8_isConjRefl_eq (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε) =
      ggBCReflSet {v : GGBCV 8 | ggQ2xE8_RootSet ε v} :=
  Set.Subset.antisymm (ggQ2xE8_isConjRefl_subset ε hε)
    (ggQ2xE8_reflSet_subset_isConjRefl ε hε)

lemma ggQ2xE8_rootSet_eq (ε : ZMod 3) :
    {v : GGBCV 8 | ggQ2xE8_RootSet ε v} = ggDRoots 8 ∪ {z | ggDHalfSpin ε z} := by
  ext v
  simp [ggQ2xE8_RootSet, ggDRoots, ggDHalfSpin]

private lemma ggQ2xE8_finiteLinearEquiv : Finite (GGBCV 8 ≃ₗ[ZMod 3] GGBCV 8) :=
  Finite.of_injective (fun e : GGBCV 8 ≃ₗ[ZMod 3] GGBCV 8 => (e : GGBCV 8 → GGBCV 8))
    (fun a b h => LinearEquiv.ext (congrFun h))

theorem ggQ2_D_inner_E8 (ε : ZMod 3) (hε : ε = 1 ∨ ε = -1) :
    GGQ2QuandleInner (ggBCReflSet (ggDRoots 8 ∪ {z | ggDHalfSpin ε z}))
      (ggBCReflGp (ggDRoots 8 ∪ {z | ggDHalfSpin ε z})) := by
  rw [← ggQ2xE8_rootSet_eq ε]
  intro π hT hinj hπ
  haveI : Finite ((ggQ2xE8_D ε hε).V ≃ₗ[ZMod 3] (ggQ2xE8_D ε hε).V) :=
    ggQ2xE8_finiteLinearEquiv
  have hTS : ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε) =
      ggBCReflSet {v : GGBCV 8 | ggQ2xE8_RootSet ε v} :=
    ggQ2xE8_isConjRefl_eq ε hε
  have hfin : (ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε)).Finite :=
    Set.Finite.subset (Set.finite_univ) (Set.subset_univ _)
  have hmaps : Set.MapsTo π (ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε))
      (ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε)) := by
    intro t ht
    rw [hTS] at ht ⊢
    exact hT t ht
  have hinj' : Set.InjOn π (ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε)) := by
    intro s hs t ht heq
    rw [hTS] at hs ht
    exact hinj hs ht heq
  have hπ' : ∀ s ∈ ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε),
      ∀ t ∈ ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε),
      π (s * t * s⁻¹) = π s * π t * (π s)⁻¹ := by
    intro s hs t ht
    rw [hTS] at hs ht
    exact hπ s hs t ht
  have hsurj : Set.SurjOn π (ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε))
      (ggQ2xQ_isConjRefl (ggQ2xE8_D ε hε)) :=
    ((Set.Finite.injOn_iff_bijOn_of_mapsTo hfin hmaps).mp hinj').surjOn
  obtain ⟨g, hg, hgt⟩ := ggQ2_quandle_aut_E (ggQ2xE8_D ε hε) (ggQ2xE8_D_basis ε hε)
    (ggQ2xE8_D_isE ε hε) π hmaps hinj' hsurj hπ'
  have hweyl_le : ∀ x ∈ (ggQ2xE8_D ε hε).weyl,
      x ∈ ggBCReflGp {v : GGBCV 8 | ggQ2xE8_RootSet ε v} := by
    intro x hx
    rw [GGQ2Lin.weyl, GGQ2Lin.parab] at hx
    refine Subgroup.closure_induction
      (p := fun x _ => x ∈ ggBCReflGp {v : GGBCV 8 | ggQ2xE8_RootSet ε v}) ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨k, -, rfl⟩
      exact Subgroup.subset_closure
        ⟨ggQ2xE8_z ε k, ggQ2xE8_z_mem ε hε k, ggQ2xE8_hz ε hε k,
          (ggQ2xE8_simpleRefl_eq_refl ε hε k)⟩
    · exact Subgroup.one_mem _
    · intro a b _ _ ha hb; exact Subgroup.mul_mem _ ha hb
    · intro a _ ha; exact Subgroup.inv_mem _ ha
  refine ⟨g, hweyl_le g hg, ?_⟩
  intro t ht
  rw [← hTS] at ht
  exact hgt t ht

