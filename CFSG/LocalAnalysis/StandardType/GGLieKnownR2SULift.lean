private theorem l10sU3_pow_two_eq_two {f : ℕ} (h : 2 ^ f = 2) : f = 1 :=
  Nat.pow_right_injective (le_refl 2) (h.trans (pow_one 2).symm)

private theorem l10sU3_not_and_of_not {f n : ℕ} (hnf : ¬ (n = 3 ∧ f = 1)) :
    ¬ (n = 3 ∧ 2 ^ f = 2) := by
  rintro ⟨hn3, hf2⟩
  exact hnf ⟨hn3, l10sU3_pow_two_eq_two hf2⟩

private theorem l10sU3_pair_ne_of_not {f n : ℕ} (hnf : ¬ (n = 3 ∧ f = 1)) :
    (n, 2 ^ f) ≠ (3, 2) := by
  rintro h
  exact hnf ⟨congrArg Prod.fst h, l10sU3_pow_two_eq_two (congrArg Prod.snd h)⟩

private theorem l10sU3_one_le_of_card_eq_sq {F : Type} [Field F] [Finite F] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) : 1 ≤ f := by
  by_contra h
  have hf0 : f = 0 := by omega
  rw [hf0] at hF
  have h1 : Nat.card F = 1 := by simpa using hF
  have h2 : 2 ≤ Nat.card F := by
    haveI : Fintype F := Fintype.ofFinite F
    have hc : 1 < Fintype.card F := Fintype.one_lt_card
    rw [Nat.card_eq_fintype_card]
    omega
  omega

private theorem l10sU3_eq_one_of_forall_mul_inv_mem_center {S : Type*} [Group S]
    [Group.IsPerfect S] {τ : MulAut S} (h : ∀ s : S, τ s * s⁻¹ ∈ Subgroup.center S) :
    τ = 1 := by
  let z : S →* S :=
    { toFun := fun s => τ s * s⁻¹
      map_one' := by simp
      map_mul' := fun s t => by
        have ht : (τ t * t⁻¹) * s⁻¹ = s⁻¹ * (τ t * t⁻¹) :=
          ((Subgroup.mem_center_iff.mp (h t)) s⁻¹).symm
        calc τ (s * t) * (s * t)⁻¹
            = τ s * (τ t * t⁻¹) * s⁻¹ := by rw [map_mul]; group
          _ = τ s * ((τ t * t⁻¹) * s⁻¹) := by group
          _ = τ s * (s⁻¹ * (τ t * t⁻¹)) := by rw [ht]
          _ = (τ s * s⁻¹) * (τ t * t⁻¹) := by group }
  have hzc : ∀ s, z s ∈ Subgroup.center S := h
  have hcomm : ⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ ≤ z.ker := by
    rw [Subgroup.commutator_le]
    intro a _ b _
    rw [MonoidHom.mem_ker, map_commutatorElement]
    have hab := (Subgroup.mem_center_iff.mp (hzc a)) (z b)
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact hab.symm
  have htop : ⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ = ⊤ := Group.IsPerfect.commutator_eq_top
  rw [htop] at hcomm
  refine MulEquiv.ext fun s => ?_
  have hs : z s = 1 := hcomm (Subgroup.mem_top s)
  change τ s * s⁻¹ = 1 at hs
  rw [MulAut.one_apply]
  exact eq_of_mul_inv_eq_one hs

private theorem l10sU3_hom_eq_of_inv_mul_mem_center {K Q : Type*} [Group K] [Group Q]
    [Group.IsPerfect K] (f g : K →* Q)
    (h : ∀ s, (g s)⁻¹ * f s ∈ Subgroup.center Q) : g = f := by
  let z : K →* Subgroup.center Q :=
    { toFun := fun s => ⟨(g s)⁻¹ * f s, h s⟩
      map_one' := by ext; simp
      map_mul' := fun s t => by
        ext
        have hc := Subgroup.mem_center_iff.mp (h s) (g t)⁻¹
        simp only [map_mul, mul_inv_rev, Subgroup.coe_mul]
        calc (g t)⁻¹ * (g s)⁻¹ * (f s * f t)
            = (g t)⁻¹ * ((g s)⁻¹ * f s) * f t := by group
          _ = (g s)⁻¹ * f s * (g t)⁻¹ * f t := by rw [hc]
          _ = (g s)⁻¹ * f s * ((g t)⁻¹ * f t) := by group }
  have hz : z = 1 := by
    have hp : Group.IsPerfect z.range := Group.IsPerfect.range z
    have hs : Subsingleton z.range := Group.IsPerfect.subsingleton_of_isMulCommutative
    ext s
    have h1 : (⟨z s, s, rfl⟩ : z.range) = 1 := Subsingleton.elim _ _
    simpa using congrArg Subtype.val h1
  ext s
  have h2 := congrArg (fun w : K →* Subgroup.center Q => ((w s : Subgroup.center Q) : Q)) hz
  simp only [z, MonoidHom.coe_mk, OneHom.coe_mk, MonoidHom.one_apply, Subgroup.coe_one] at h2
  exact inv_mul_eq_one.mp h2

private theorem l10sU3_eq_one_of_mem_inf_of_isPGroup_two_of_odd_card {G : Type*} [Group G]
    {K R : Subgroup G} (hKodd : Odd (Nat.card K)) (hR : IsPGroup 2 R)
    {x : G} (hxR : x ∈ R) (hxK : x ∈ K) : x = 1 := by
  obtain ⟨k, hk⟩ := (isPGroup_iff_orderOf_dvd_pow.mp hR) ⟨x, hxR⟩
  rw [Subgroup.orderOf_mk] at hk
  have hdvd : orderOf x ∣ Nat.card K := Subgroup.orderOf_dvd_natCard K hxK
  exact orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (hKodd.coprime_two_left.pow_left k) hk hdvd)

private theorem l10sU3_le_of_isPGroup_le_sup_of_odd_central {G : Type*} [Group G]
    {K R S : Subgroup G} [K.Normal] (hKc : K ≤ Subgroup.center G) (hKodd : Odd (Nat.card K))
    (hR : IsPGroup 2 R) (hS : IsPGroup 2 S) (hSR : S ≤ R ⊔ K) : S ≤ R := by
  intro g hgS
  obtain ⟨j, hj⟩ := hS ⟨g, hgS⟩
  have hgj : g ^ 2 ^ j = 1 := by simpa using congrArg Subtype.val hj
  obtain ⟨r, hrR, z, hzK, hrz⟩ := (Subgroup.mem_sup_of_normal_right (s := R) (t := K)).mp (hSR hgS)
  have hcomm : Commute r z := Subgroup.mem_center_iff.mp (hKc hzK) r
  have hpow : (r * z) ^ 2 ^ j = r ^ 2 ^ j * z ^ 2 ^ j := hcomm.mul_pow _
  have hrp : r ^ 2 ^ j * z ^ 2 ^ j = 1 := by rw [← hpow, hrz, hgj]
  have hzpowR : z ^ 2 ^ j ∈ R := by
    have hz : z ^ 2 ^ j = (r ^ 2 ^ j)⁻¹ := eq_inv_of_mul_eq_one_right hrp
    rw [hz]
    exact R.inv_mem (R.pow_mem hrR _)
  have hzpowK : z ^ 2 ^ j ∈ K := K.pow_mem hzK _
  have hzpow1 : z ^ 2 ^ j = 1 :=
    l10sU3_eq_one_of_mem_inf_of_isPGroup_two_of_odd_card hKodd hR hzpowR hzpowK
  have hz1 : z = 1 := by
    have hdvd1 : orderOf z ∣ 2 ^ j := orderOf_dvd_of_pow_eq_one hzpow1
    have hdvd2 : orderOf z ∣ Nat.card K := Subgroup.orderOf_dvd_natCard K hzK
    exact orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes (hKodd.coprime_two_left.pow_left j) hdvd1 hdvd2)
  rw [← hrz, hz1, mul_one]
  exact hrR

private noncomputable def l10sU3_centralQuotEquiv {H H' : Type*} [Group H] [Group H']
    (hH : commutator H = ⊤) (ψ : H →* H') (hψ : Function.Surjective ψ)
    (hk : ψ.ker ≤ Subgroup.center H) :
    H ⧸ Subgroup.center H ≃* H' ⧸ Subgroup.center H' :=
  let χ : H →* H' ⧸ Subgroup.center H' := (QuotientGroup.mk' (Subgroup.center H')).comp ψ
  have hχ : Function.Surjective χ := (QuotientGroup.mk'_surjective _).comp hψ
  have hkerχ : χ.ker = Subgroup.comap ψ (Subgroup.center H') := by
    rw [← MonoidHom.comap_ker (QuotientGroup.mk' (Subgroup.center H')) ψ,
      QuotientGroup.ker_mk']
  have hker : χ.ker = Subgroup.center H := by
    rw [hkerχ]
    exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.comap_center_of_surjective
      hH ψ hψ hk
  (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective χ hχ)

private theorem l10sU3_centralQuotEquiv_mk {H H' : Type*} [Group H] [Group H']
    (hH : commutator H = ⊤) (ψ : H →* H') (hψ : Function.Surjective ψ)
    (hk : ψ.ker ≤ Subgroup.center H) (x : H) :
    l10sU3_centralQuotEquiv hH ψ hψ hk (QuotientGroup.mk' (Subgroup.center H) x) =
      QuotientGroup.mk' (Subgroup.center H') (ψ x) := by
  simp only [l10sU3_centralQuotEquiv, MulEquiv.trans_apply, QuotientGroup.mk'_apply]
  rw [QuotientGroup.quotientMulEquivOfEq_mk]
  simp [QuotientGroup.quotientKerEquivOfSurjective,
    QuotientGroup.quotientKerEquivOfRightInverse, QuotientGroup.kerLift_mk,
    QuotientGroup.mk'_apply, MonoidHom.comp_apply]

private theorem l10sU3_exists_lift {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) (hnf : ¬ (n = 3 ∧ f = 1))
    {X : Type} [Group X]
    (φ : ↥(Unitary.SU (unitaryInvolution F 2 f) n) →* X)
    (hker : φ.ker ≤ Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (y : MulAut ↥φ.range) :
    ∃ ŷ : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n),
      ∀ s, y (φ.rangeRestrict s) = φ.rangeRestrict (ŷ s) := by
  classical
  let K := ↥(Unitary.SU (unitaryInvolution F 2 f) n)
  let Q := ↥φ.range
  let q : K →* Q := φ.rangeRestrict
  have hq : Function.Surjective q := φ.rangeRestrict_surjective
  have hkerq : q.ker ≤ Subgroup.center K := by
    rw [show q.ker = φ.ker from MonoidHom.ker_rangeRestrict φ]
    exact hker
  have hperf : Group.IsPerfect K :=
    isPerfect_SU_ctua hF hn (l10sU3_not_and_of_not hnf)
  haveI hQperf : Group.IsPerfect Q := hperf.ofSurjective hq
  have hcomm : commutator K = ⊤ := hperf.commutator_eq_top
  let e0 : K ⧸ Subgroup.center K ≃* Q ⧸ Subgroup.center Q :=
    l10sU3_centralQuotEquiv hcomm q hq hkerq
  have he0 : ∀ x : K, e0 (QuotientGroup.mk' (Subgroup.center K) x) =
      QuotientGroup.mk' (Subgroup.center Q) (q x) := fun x =>
    l10sU3_centralQuotEquiv_mk hcomm q hq hkerq x
  have hf : 1 ≤ f := l10sU3_one_le_of_card_eq_sq hF
  have h : UnitaryFieldData 2 f F :=
    { prime := Nat.prime_two, one_le := hf, card := by rw [hF, ← pow_mul, mul_comm] }
  have hC : IsPrimeFormGram (ctuaAntidiagGL n F) := isPrimeFormGram_ctuaAntidiagGL
  set C : Matrix (Fin n) (Fin n) F :=
    ((ctuaAntidiagGL n F : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) with hCdef
  have hE : Unitary.SU (unitaryInvolution F 2 f) n = gramSU h C := SU_eq_gramSU h
  let E : K ≃* gramSU h C := MulEquiv.subgroupCongr hE
  let eK : K ⧸ Subgroup.center K ≃*
      gramSU h C ⧸ Subgroup.center (gramSU h C) :=
    QuotientGroup.congr (Subgroup.center K) (Subgroup.center (gramSU h C)) E
      (Subgroup.map_center_eq E)
  let eQ : gramSU h C ⧸ Subgroup.center (gramSU h C) ≃* primeFormP h C :=
    QuotientGroup.quotientMulEquivOfEq
      (F4Pilot.center_gramSU_eq_normOneScalars h hC hn (l10sU3_not_and_of_not hnf))
  let eP : K ⧸ Subgroup.center K ≃* primeFormP h C := eK.trans eQ
  let e : Q ⧸ Subgroup.center Q ≃* primeFormP h C := e0.symm.trans eP
  let ybarQ : MulAut (Q ⧸ Subgroup.center Q) :=
    QuotientGroup.congr (Subgroup.center Q) (Subgroup.center Q) y (Subgroup.map_center_eq y)
  let αb : MulAut (primeFormP h C) := MulAut.congr e ybarQ
  obtain ⟨⟨A, φf⟩, hAφ⟩ :=
    primeFormPsi_surjective h hC hn (l10sU3_not_and_of_not hnf) αb
  let γ : gramSU h C ≃* gramSU h C :=
    (primeFormFieldSU h hC φf).trans (primeFormConjSU h C A)
  let ŷ : MulAut K := E.trans (γ.trans E.symm)
  have hγE : ∀ x : K, E (ŷ x) = γ (E x) := by
    intro x
    change E (E.symm (γ (E x))) = γ (E x)
    rw [MulEquiv.apply_symm_apply]
  have heP_mk : ∀ x : K, eP (QuotientGroup.mk' (Subgroup.center K) x) =
      QuotientGroup.mk' (normOneScalars h (gramSU h C) n) (E x) := by
    intro x
    change eQ (eK (QuotientGroup.mk' (Subgroup.center K) x)) =
      QuotientGroup.mk' (normOneScalars h (gramSU h C) n) (E x)
    have h1 : eK (QuotientGroup.mk' (Subgroup.center K) x) =
        QuotientGroup.mk' (Subgroup.center (gramSU h C)) (E x) :=
      QuotientGroup.congr_mk' (Subgroup.center K) (Subgroup.center (gramSU h C)) E
        (Subgroup.map_center_eq E) x
    rw [h1]
    exact QuotientGroup.quotientMulEquivOfEq_mk
      (F4Pilot.center_gramSU_eq_normOneScalars h hC hn (l10sU3_not_and_of_not hnf)) (E x)
  have he_mk : ∀ x : K, e (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
      eP (QuotientGroup.mk' (Subgroup.center K) x) := by
    intro x
    change eP (e0.symm (QuotientGroup.mk' (Subgroup.center Q) (q x))) =
      eP (QuotientGroup.mk' (Subgroup.center K) x)
    rw [← he0 x, MulEquiv.symm_apply_apply]
  have hprime : ∀ g : gramSU h C, primeFormPsi h hC ⟨A, φf⟩ (g : primeFormP h C) =
      (γ g : primeFormP h C) := by
    intro g
    change (primeFormConjAut h C A) ((primeFormFieldAut h hC φf) (g : primeFormP h C)) =
      (γ g : primeFormP h C)
    rw [primeFormFieldAut_mk, primeFormConjAut_mk]
    rfl
  have hγ : MulAut.congr eP (F4Pilot.centerQuotientAut ŷ) =
      primeFormPsi h hC ⟨A, φf⟩ := by
    refine MulEquiv.ext fun z => ?_
    obtain ⟨y0, rfl⟩ := QuotientGroup.mk'_surjective (normOneScalars h (gramSU h C) n) z
    change MulAut.congr eP (F4Pilot.centerQuotientAut ŷ) (y0 : primeFormP h C) =
      primeFormPsi h hC ⟨A, φf⟩ (y0 : primeFormP h C)
    have hz : (y0 : primeFormP h C) =
        eP (QuotientGroup.mk' (Subgroup.center K) (E.symm y0)) := by
      rw [heP_mk (E.symm y0), MulEquiv.apply_symm_apply]
      rfl
    rw [hz]
    have h1 : MulAut.congr eP (F4Pilot.centerQuotientAut ŷ)
        (eP (QuotientGroup.mk' (Subgroup.center K) (E.symm y0))) =
        eP (F4Pilot.centerQuotientAut ŷ
          (QuotientGroup.mk' (Subgroup.center K) (E.symm y0))) := by
      simp [MulAut.congr_apply]
    rw [h1, F4Pilot.centerQuotientAut_mk, heP_mk (ŷ (E.symm y0)), hγE (E.symm y0),
      MulEquiv.apply_symm_apply]
    exact (hprime y0).symm
  have hmod : ∀ x : K, ybarQ (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
      QuotientGroup.mk' (Subgroup.center Q) (q (ŷ x)) := by
    intro x
    apply e.injective
    calc e (ybarQ (QuotientGroup.mk' (Subgroup.center Q) (q x)))
        = (MulAut.congr e ybarQ) (e (QuotientGroup.mk' (Subgroup.center Q) (q x))) := by
            simp [MulAut.congr_apply]
      _ = αb (eP (QuotientGroup.mk' (Subgroup.center K) x)) := by rw [he_mk x]
      _ = (primeFormPsi h hC ⟨A, φf⟩) (eP (QuotientGroup.mk' (Subgroup.center K) x)) := by
            rw [← hAφ]
      _ = eP (QuotientGroup.mk' (Subgroup.center K) (ŷ x)) := by
            rw [← hγ]
            have h1 : MulAut.congr eP (F4Pilot.centerQuotientAut ŷ)
                (eP (QuotientGroup.mk' (Subgroup.center K) x)) =
                eP (F4Pilot.centerQuotientAut ŷ
                  (QuotientGroup.mk' (Subgroup.center K) x)) := by
              simp [MulAut.congr_apply]
            rw [h1, F4Pilot.centerQuotientAut_mk]
      _ = e (QuotientGroup.mk' (Subgroup.center Q) (q (ŷ x))) := (he_mk (ŷ x)).symm
  have hybar_mk : ∀ x : K, ybarQ (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
      QuotientGroup.mk' (Subgroup.center Q) (y (q x)) := by
    intro x
    exact QuotientGroup.congr_mk' (Subgroup.center Q) (Subgroup.center Q) y
      (Subgroup.map_center_eq y) (q x)
  have hc : ∀ x : K, (y (q x))⁻¹ * q (ŷ x) ∈ Subgroup.center Q := by
    intro x
    have hx : QuotientGroup.mk (s := Subgroup.center Q) (y (q x)) =
        QuotientGroup.mk (s := Subgroup.center Q) (q (ŷ x)) := by
      change QuotientGroup.mk' (Subgroup.center Q) (y (q x)) =
        QuotientGroup.mk' (Subgroup.center Q) (q (ŷ x))
      exact (hybar_mk x).symm.trans (hmod x)
    rw [QuotientGroup.eq] at hx
    simpa using hx
  have hhom : y.toMonoidHom.comp q = q.comp ŷ.toMonoidHom :=
    l10sU3_hom_eq_of_inv_mul_mem_center (q.comp ŷ.toMonoidHom) (y.toMonoidHom.comp q) hc
  refine ⟨ŷ, fun s => ?_⟩
  exact congrArg (fun g : K →* Q => g s) hhom

private theorem l10sU3_lift_unique {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) (hnf : ¬ (n = 3 ∧ f = 1))
    {X : Type} [Group X]
    (φ : ↥(Unitary.SU (unitaryInvolution F 2 f) n) →* X)
    (hker : φ.ker ≤ Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    {y₁ y₂ : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n)}
    (h : ∀ s, φ.rangeRestrict (y₁ s) = φ.rangeRestrict (y₂ s)) : y₁ = y₂ := by
  haveI : Group.IsPerfect ↥(Unitary.SU (unitaryInvolution F 2 f) n) :=
    isPerfect_SU_ctua hF hn (l10sU3_not_and_of_not hnf)
  let δ : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n) := y₁ * y₂⁻¹
  have hδ : δ = 1 := by
    refine l10sU3_eq_one_of_forall_mul_inv_mem_center fun s => ?_
    refine hker ?_
    rw [MonoidHom.mem_ker]
    have h1 : φ.rangeRestrict (δ s) = φ.rangeRestrict s := by
      have h2 := h (y₂⁻¹ s)
      simpa [δ, MulAut.mul_apply, MulEquiv.apply_symm_apply] using h2
    have hv : φ (δ s) = φ s := by simpa using congrArg Subtype.val h1
    simp [map_mul, hv]
  have hmul : y₁ * y₂⁻¹ = 1 := hδ
  calc y₁ = y₁ * y₂⁻¹ * y₂ := by group
    _ = 1 * y₂ := by rw [hmul]
    _ = y₂ := by group

private theorem l10sU3_normalizer_pCore_map {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    {n : ℕ} {X : Type} [Group X] [Finite X]
    (φ : ↥(Unitary.SU (unitaryInvolution F 2 f) n) →* X)
    (hker : φ.ker ≤ Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (hodd : Odd (Nat.card φ.ker))
    {R : Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)} (hR : IsPGroup 2 R) :
    Subgroup.normalizer ((R.map φ.rangeRestrict : Subgroup ↥φ.range) : Set ↥φ.range) =
        (Subgroup.normalizer (R : Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))).map
          φ.rangeRestrict ∧
      pCoreOf 2 (Subgroup.normalizer
          ((R.map φ.rangeRestrict : Subgroup ↥φ.range) : Set ↥φ.range)) =
        (pCoreOf 2 (Subgroup.normalizer
          (R : Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))).map φ.rangeRestrict := by
  have hker' : φ.rangeRestrict.ker ≤
      Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n) := by
    rwa [MonoidHom.ker_rangeRestrict]
  have hodd' : Odd (Nat.card φ.rangeRestrict.ker) := by
    rwa [MonoidHom.ker_rangeRestrict]
  have hM : φ.rangeRestrict.ker ≤
      Subgroup.normalizer (R : Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :=
    hker'.trans (Subgroup.center_le_normalizer
      (R : Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))
  have hrange : φ.rangeRestrict.range = ⊤ :=
    MonoidHom.range_eq_top.2 (MonoidHom.rangeRestrict_surjective φ)
  have hN := map_normalizer_eq_range_inf_normalizer_map hker' hodd' hR
  rw [hrange, top_inf_eq] at hN
  have hP := map_pCoreOf_eq_of_odd_central_ker hker' hodd' hM
  rw [hN] at hP
  exact ⟨hN.symm, hP.symm⟩

private theorem l10sU3_lift_map_eq {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    {n : ℕ} {X : Type} [Group X]
    (φ : ↥(Unitary.SU (unitaryInvolution F 2 f) n) →* X)
    (hker : φ.ker ≤ Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (hodd : Odd (Nat.card φ.ker))
    {R : Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)} (hR : IsPGroup 2 R)
    (ŷ : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (y : MulAut ↥φ.range) (hŷ : ∀ s, y (φ.rangeRestrict s) = φ.rangeRestrict (ŷ s))
    (hy : (R.map φ.rangeRestrict).map y.toMonoidHom = R.map φ.rangeRestrict) :
    R.map ŷ.toMonoidHom = R := by
  have hle : R.map ŷ.toMonoidHom ≤ R ⊔ φ.ker := by
    rintro x ⟨r, hrR, rfl⟩
    have hmem : φ.rangeRestrict r ∈ R.map φ.rangeRestrict :=
      Subgroup.mem_map.mpr ⟨r, hrR, rfl⟩
    have hyr : y (φ.rangeRestrict r) ∈ R.map φ.rangeRestrict := by
      have hyr' : y (φ.rangeRestrict r) ∈ (R.map φ.rangeRestrict).map y.toMonoidHom :=
        Subgroup.mem_map.mpr ⟨φ.rangeRestrict r, hmem, rfl⟩
      rwa [hy] at hyr'
    have hmem' : φ.rangeRestrict (ŷ r) ∈ R.map φ.rangeRestrict := by
      rwa [← hŷ r]
    obtain ⟨r', hr'R, hr'eq⟩ := Subgroup.mem_map.mp hmem'
    have hker_mem : ŷ r * r'⁻¹ ∈ φ.ker := by
      rw [MonoidHom.mem_ker]
      have hv : φ r' = φ (ŷ r) := by simpa using congrArg Subtype.val hr'eq
      rw [map_mul, map_inv, hv, mul_inv_cancel]
    have hrw : (MulEquiv.toMonoidHom ŷ) r = (MulEquiv.toMonoidHom ŷ) r * r'⁻¹ * r' := by
      group
    rw [hrw]
    simpa [sup_comm] using Subgroup.mul_mem_sup hker_mem hr'R
  have hS : IsPGroup 2 (R.map ŷ.toMonoidHom) := hR.map ŷ.toMonoidHom
  haveI : (φ.ker).Normal := φ.normal_ker
  have hle' : R.map ŷ.toMonoidHom ≤ R :=
    l10sU3_le_of_isPGroup_le_sup_of_odd_central hker hodd hR hS hle
  have hcard : Nat.card (R.map ŷ.toMonoidHom) = Nat.card R :=
    Subgroup.card_map_of_injective ŷ.injective
  exact Subgroup.eq_of_le_of_card_ge hle' (le_of_eq hcard.symm)

theorem ggRootNormInner_map_SU {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) (hnf : ¬ (n = 3 ∧ f = 1))
    {X : Type} [Group X] [Finite X]
    (φ : ↥(Unitary.SU (unitaryInvolution F 2 f) n) →* X)
    (hker : φ.ker ≤ Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    {R : Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)} (hR : IsPGroup 2 R)
    (hI : PSL.GGRootNormInnerZ R) :
    GGRootNormInner ((R.map φ).subgroupOf φ.range) := by
  have hf : 1 ≤ f := l10sU3_one_le_of_card_eq_sq hF
  have hodd : Odd (Nat.card φ.ker) := by
    have h1 : Nat.card φ.ker ∣ Nat.card (Subgroup.center
        ↥(Unitary.SU (unitaryInvolution F 2 f) n)) := Subgroup.card_dvd_of_le hker
    exact Odd.of_dvd_nat (odd_card_center_SU hF hf hn (l10sU3_pair_ne_of_not hnf)) h1
  intro y hy2 hyR hymod
  obtain ⟨ŷ, hŷ⟩ := l10sU3_exists_lift hF hn hnf φ hker y
  have hpow : ∀ m : ℕ, ∀ s : ↥(Unitary.SU (unitaryInvolution F 2 f) n),
      φ.rangeRestrict ((ŷ ^ m) s) = (y ^ m) (φ.rangeRestrict s) := by
    intro m
    induction m with
    | zero => intro s; simp
    | succ m ih =>
      intro s
      rw [pow_succ, pow_succ]
      simp only [MulAut.mul_apply]
      rw [ih, ← hŷ]
  have hŷ2 : ∃ k : ℕ, ŷ ^ 2 ^ k = 1 := by
    obtain ⟨k, hk⟩ := hy2
    refine ⟨k, ?_⟩
    refine l10sU3_lift_unique hF hn hnf φ hker ?_
    intro s
    rw [hpow, hk]
    simp
  have hRbar : R.map φ.rangeRestrict = (R.map φ).subgroupOf φ.range := by
    ext x
    rw [Subgroup.mem_map, Subgroup.mem_subgroupOf]
    constructor
    · rintro ⟨r, hr, hx⟩
      exact ⟨r, hr, by simpa using congrArg Subtype.val hx⟩
    · rintro ⟨r, hr, hx⟩
      exact ⟨r, hr, Subtype.ext (by simpa using hx)⟩
  have hŷR : R.map ŷ.toMonoidHom = R := by
    refine l10sU3_lift_map_eq φ hker hodd hR ŷ y hŷ ?_
    rw [hRbar]
    exact hyR
  have hŷmod : ∀ m ∈ Subgroup.normalizer (R : Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)),
      ŷ m * m⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer (R : Set
        ↥(Unitary.SU (unitaryInvolution F 2 f) n))) ⊔
        Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n) := by
    intro m hm
    have hN := (l10sU3_normalizer_pCore_map φ hker hodd hR).1
    have hP := (l10sU3_normalizer_pCore_map φ hker hodd hR).2
    have hmbar : φ.rangeRestrict m ∈ Subgroup.normalizer
        (((R.map φ).subgroupOf φ.range : Subgroup ↥φ.range) : Set ↥φ.range) := by
      rw [← hRbar, hN]
      exact ⟨m, hm, rfl⟩
    have h1 := hymod (φ.rangeRestrict m) hmbar
    rw [← hRbar] at h1
    rw [hP] at h1
    rw [hŷ m, ← map_inv, ← map_mul] at h1
    obtain ⟨m', hm', hm'n⟩ := Subgroup.mem_map.mp h1
    have hker_mem : m'⁻¹ * (ŷ m * m⁻¹) ∈ φ.ker := by
      rw [MonoidHom.mem_ker]
      have hval : φ m' = φ (ŷ m * m⁻¹) := by
        simpa only [MonoidHom.coe_rangeRestrict] using congrArg Subtype.val hm'n
      rw [map_mul, map_inv, hval]
      simp
    have hmem := Subgroup.mul_mem_sup hm' (hker hker_mem)
    rwa [show m' * (m'⁻¹ * (ŷ m * m⁻¹)) = ŷ m * m⁻¹ by group] at hmem
  obtain ⟨k, hk⟩ := hI ŷ hŷ2 hŷR hŷmod
  refine ⟨φ.rangeRestrict k, ?_⟩
  ext t
  obtain ⟨s, hs⟩ := MonoidHom.rangeRestrict_surjective φ t
  rw [← hs, hŷ s, hk]
  simp [MulAut.conj_apply, map_mul]

