theorem ggLinearOn_orth_paired {K V : Type} [Field K] [Finite K] [CharP K 2] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    {x : ↥(orthDerived Q)} (hx : OddOrderIsometry Q 3 (x : V ≃ₗ[K] V)) {h : K[X]}
    (hh : h ∈ primaryFactors (x : V ≃ₗ[K] V).toLinearMap) (hne1 : h ≠ X - 1)
    (hpair : ¬ h = reciprocalPolynomial h)
    (hq : CFSG.Open.IsQuasisimple ↥(specialBlock Q (x : V ≃ₗ[K] V) h))
    (y : ↥(orthDerived Q)) (hy : (y : V ≃ₗ[K] V) ∈ isometryCentralizer Q (x : V ≃ₗ[K] V))
    (J : Subgroup (orthDerived Q ⧸ (scalars K V).subgroupOf (orthDerived Q)))
    (hJq : CFSG.Open.IsQuasisimple ↥J)
    (hJeq : J = componentImage Q (x : V ≃ₗ[K] V) h)
    (hJ : MulAut.conj (QuotientGroup.mk' (N := (scalars K V).subgroupOf (orthDerived Q)) y) ∈
      CFSG.GroupActions.subgroupStabAut J) :
    GGLinearOn J
      (MulAut.conj (QuotientGroup.mk' (N := (scalars K V).subgroupOf (orthDerived Q)) y)) := by
  classical
  haveI : Fact (Irreducible h) := ⟨irreducible_of_mem_primaryFactors hh⟩
  let xe : V ≃ₗ[K] V := (x : V ≃ₗ[K] V)
  let F : Type := AdjoinRoot h
  let M : Type := primaryComponent xe.toLinearMap h
  haveI : CharP (AdjoinRoot h) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AdjoinRoot h)).injective 2
  haveI : Finite (AdjoinRoot h) := by
    have hmon : h.Monic := (mem_primaryFactors.mp hh).2.1
    haveI : Module.Finite K (AdjoinRoot h) := hmon.finite_adjoinRoot
    exact Module.finite_of_finite K
  have h4 : 4 ≤ Nat.card F := by
    have hlt := hx.p_lt_card_adjoinRoot Nat.prime_three hh hne1
    change 4 ≤ Nat.card (AdjoinRoot h)
    omega
  have hleQ : specialBlock Q xe h ≤ TauCeti.QuadraticMap.orthogonalGroup Q := fun g hg =>
    (Subgroup.mem_inf.mp (specialBlock_le_isometryCentralizer (Q := Q) (x := xe) h hg)).1
  have hleOrth : specialBlock Q xe h ≤ orthDerived Q := by
    haveI : Group.IsPerfect ↥(specialBlock Q xe h) := ⟨hq.1⟩
    calc specialBlock Q xe h = ⁅specialBlock Q xe h, specialBlock Q xe h⁆ :=
          (Subgroup.commutator_eq_self).symm
      _ ≤ orthDerived Q := Subgroup.commutator_mono hleQ hleQ
  let ρ : ↥(orthDerived Q) →* ProjOrthDerived Q :=
    QuotientGroup.mk' (N := (scalars K V).subgroupOf (orthDerived Q))
  let A_sub : Subgroup ↥(orthDerived Q) := (specialBlock Q xe h).subgroupOf (orthDerived Q)
  have hAJ : A_sub.map ρ = J := by rw [hJeq]; rfl
  let e₀ : ↥(specialBlock Q xe h) ≃* ↥A_sub := (Subgroup.subgroupOfEquivOfLe hleOrth).symm
  let π₀ : ↥A_sub →* ↥J := (MulEquiv.subgroupCongr hAJ).toMonoidHom.comp (ρ.subgroupMap A_sub)
  let e₁ : ↥(specialBlock Q xe h) ≃* SpecialLinearGroup F M :=
    MulEquiv.ofBijective (specialToSL Q xe h)
      ⟨hx.specialToSL_injective hh, hx.specialToSL_surjective_paired hh hpair⟩
  let m : ℕ := primaryMultiplicity xe.toLinearMap h - 1
  have hmpos : 1 ≤ primaryMultiplicity xe.toLinearMap h :=
    Nat.succ_le_of_lt (hx.primaryMultiplicity_pos hh)
  have hfin : Module.finrank F M = m + 1 := by
    show Module.finrank (AdjoinRoot h) (primaryComponent xe.toLinearMap h) =
      primaryMultiplicity xe.toLinearMap h - 1 + 1
    rw [Nat.sub_add_cancel hmpos]
  let b : Basis (Fin (m + 1)) F M := Module.finBasisOfFinrankEq F M hfin
  let e₂ : Matrix.SpecialLinearGroup (Fin (m + 1)) F ≃* SpecialLinearGroup F M :=
    Matrix.SpecialLinearGroup.toLin_equiv b
  let φ : Matrix.SpecialLinearGroup (Fin (m + 1)) F →* ↥J :=
    π₀.comp (e₀.toMonoidHom.comp (e₁.symm.toMonoidHom.comp e₂.toMonoidHom))
  let γ : BlockGL xe h := centralizerGL xe h ⟨(y : V ≃ₗ[K] V), (Subgroup.mem_inf.mp hy).2⟩
  let eGL : GL (Fin (m + 1)) F ≃* BlockGL xe h :=
    Units.mapEquiv (Matrix.toLinAlgEquiv b).toRingEquiv.toMulEquiv
  let A : GL (Fin (m + 1)) F := eGL.symm γ
  have hAtoLin : Matrix.toLinAlgEquiv b (A : Matrix (Fin (m + 1)) (Fin (m + 1)) F) =
      (γ : M →ₗ[F] M) := by
    have h := Units.coe_mapEquiv ((Matrix.toLinAlgEquiv b).toRingEquiv.toMulEquiv) A
    rw [show eGL A = γ from MulEquiv.apply_symm_apply eGL γ] at h
    exact h.symm
  have hAinv : Matrix.toLinAlgEquiv b ((A⁻¹ : GL (Fin (m + 1)) F) :
      Matrix (Fin (m + 1)) (Fin (m + 1)) F) = ((γ⁻¹ : BlockGL xe h) : M →ₗ[F] M) := by
    have h := Units.coe_mapEquiv ((Matrix.toLinAlgEquiv b).toRingEquiv.toMulEquiv) A⁻¹
    rw [map_inv, show eGL A = γ from MulEquiv.apply_symm_apply eGL γ] at h
    exact h.symm
  have hπ₀ : Function.Surjective π₀ :=
    (MulEquiv.subgroupCongr hAJ).surjective.comp (ρ.subgroupMap_surjective A_sub)
  have hφ : Function.Surjective φ :=
    hπ₀.comp (e₀.surjective.comp (e₁.symm.surjective.comp e₂.surjective))
  have hπ₀ker : π₀.ker ≤ Subgroup.center ↥A_sub := by
    intro a ha
    have h2 : (ρ.subgroupMap A_sub) a = 1 := by
      have h := congrArg (MulEquiv.subgroupCongr hAJ).symm ha
      simpa [π₀] using h
    have h3 : QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q))
        (a : ↥(orthDerived Q)) = 1 := congrArg Subtype.val h2
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h3
    obtain ⟨c, hc⟩ := mem_scalars.mp (Subgroup.mem_subgroupOf.mp h3)
    rw [Subgroup.mem_center_iff]
    intro b
    refine Subtype.ext (Subtype.ext (LinearEquiv.ext fun v => ?_))
    change (b : V ≃ₗ[K] V) ((a : V ≃ₗ[K] V) v) = (a : V ≃ₗ[K] V) ((b : V ≃ₗ[K] V) v)
    rw [hc v, hc, map_smul]
  have hker : φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) F) := by
    intro B hB
    have h1 : e₀ (e₁.symm (e₂ B)) ∈ π₀.ker := by
      rw [MonoidHom.mem_ker] at hB ⊢
      exact hB
    have h2 : e₀ (e₁.symm (e₂ B)) ∈ Subgroup.center ↥A_sub := hπ₀ker h1
    have h3 : e₁.symm (e₂ B) ∈ Subgroup.center ↥(specialBlock Q xe h) :=
      (MulEquivClass.apply_mem_center_iff e₀).mp h2
    have h4' : e₂ B ∈ Subgroup.center (SpecialLinearGroup F M) :=
      (MulEquivClass.apply_mem_center_iff e₁.symm).mp h3
    exact (MulEquivClass.apply_mem_center_iff e₂).mp h4'
  have hA : ∀ B, MulAut.conj (ρ y) (φ B) =
      (φ (InnerDiagA.conjSL A B) : ProjOrthDerived Q) := by
    intro B
    set s : ↥(specialBlock Q xe h) := e₁.symm (e₂ B)
    have hs : e₁ s = e₂ B := e₁.apply_symm_apply (e₂ B)
    have hms : (y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹ ∈ specialBlock Q xe h :=
      conj_mem_specialBlock (Q := Q) (x := xe) (h := h) hy s.2
    have hgls : (specialBlockGL Q xe h s : M →ₗ[F] M) =
        Matrix.toLinAlgEquiv b (B : Matrix (Fin (m + 1)) (Fin (m + 1)) F) := by
      have h2 : ((e₁ s : M ≃ₗ[F] M) : M →ₗ[F] M) =
          (specialBlockGL Q xe h s : M →ₗ[F] M) := rfl
      rw [← h2, hs]
      exact Matrix.SpecialLinearGroup.toLin_equiv.toLinearMap_eq b B
    have hkey : e₁ ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hms⟩ =
        e₂ (InnerDiagA.conjSL A B) := by
      apply Subtype.ext
      apply LinearEquiv.toLinearMap_injective
      have hL : ((e₁ ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hms⟩ :
              M ≃ₗ[F] M) : M →ₗ[F] M) =
          (γ : M →ₗ[F] M) * (Matrix.toLinAlgEquiv b (B : Matrix (Fin (m + 1)) (Fin (m + 1)) F)) *
            ((γ⁻¹ : BlockGL xe h) : M →ₗ[F] M) := by
        rw [show ((e₁ ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hms⟩ :
              M ≃ₗ[F] M) : M →ₗ[F] M) =
            (specialBlockGL Q xe h ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) *
              (y : V ≃ₗ[K] V)⁻¹, hms⟩ : M →ₗ[F] M) from rfl]
        rw [specialBlockGL_conj (Q := Q) (x := xe) (h := h) (y : V ≃ₗ[K] V) hy s hms]
        rw [Units.val_mul, Units.val_mul, hgls]
      have hR : ((e₂ (InnerDiagA.conjSL A B) : M ≃ₗ[F] M) : M →ₗ[F] M) =
          (γ : M →ₗ[F] M) * (Matrix.toLinAlgEquiv b (B : Matrix (Fin (m + 1)) (Fin (m + 1)) F)) *
            ((γ⁻¹ : BlockGL xe h) : M →ₗ[F] M) := by
        have h1 : ((e₂ (InnerDiagA.conjSL A B) : M ≃ₗ[F] M) : M →ₗ[F] M) =
            Matrix.toLinAlgEquiv b ((InnerDiagA.conjSL A B :
              Matrix.SpecialLinearGroup (Fin (m + 1)) F) :
              Matrix (Fin (m + 1)) (Fin (m + 1)) F) :=
          Matrix.SpecialLinearGroup.toLin_equiv.toLinearMap_eq b _
        rw [h1, InnerDiagA.coe_conjSL, map_mul, map_mul, hAtoLin, hAinv]
      rw [hL, hR]
    have hπ₀val : ∀ t : ↥(specialBlock Q xe h),
        (π₀ (e₀ t) : ProjOrthDerived Q) = ρ ⟨t, hleOrth t.2⟩ := by
      intro t
      rfl
    have hφB : φ B = π₀ (e₀ s) := rfl
    have hφc : φ (InnerDiagA.conjSL A B) = π₀ (e₀ ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) *
        (y : V ≃ₗ[K] V)⁻¹, hms⟩) := by
      have h1 : e₁.symm (e₂ (InnerDiagA.conjSL A B)) =
          ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hms⟩ := by
        rw [← hkey]
        exact e₁.symm_apply_apply _
      change π₀ (e₀ (e₁.symm (e₂ (InnerDiagA.conjSL A B)))) =
        π₀ (e₀ ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hms⟩)
      rw [h1]
    rw [hφB, hφc, MulAut.conj_apply]
    rw [hπ₀val s, hπ₀val ⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hms⟩]
    rw [show (⟨(y : V ≃ₗ[K] V) * (s : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V)⁻¹, hleOrth hms⟩ :
        ↥(orthDerived Q)) = y * ⟨s, hleOrth s.2⟩ * y⁻¹ from rfl]
    rw [map_mul, map_mul, map_inv]
  exact ggLinearOn_of_slConj hJq h4 φ hφ hker A hA

