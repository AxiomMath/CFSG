variable {G : Type} [Group G] [Finite G] {Bs K : Subgroup G} {z : G}
  {F : Type} [Field F] [Finite F] [CharP F 2] {a : ℕ}

theorem bstar_eq_zpowers_sup_inf_of_native_sp (ha : 3 ≤ a) (hF : Nat.card F = 2)
    (e : K ≃* StatedSp a F) (hBs : IsElemAbelian 3 Bs)
    (hN : Bs ≤ Subgroup.normalizer (K : Set G))
    (hker : Bs ⊓ Subgroup.centralizer (K : Set G) = Subgroup.zpowers z)
    (hBstar : ∀ g ∈ Subgroup.centralizer (Bs : Set G), g ^ 3 = 1 → g ∈ Bs) :
    Bs = Subgroup.zpowers z ⊔ Bs ⊓ K := by
  have hcenter : Subgroup.center K = ⊥ := by
    apply Subgroup.eq_bot_of_card_eq
    rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv,
      CFSG.ClassicalGroups.Symplectic.center_statedSp_eq_bot_of_charP_two (by omega),
      Subgroup.card_bot]
  have hKC : K ⊓ Subgroup.centralizer (K : Set G) = ⊥ := by
    refine le_antisymm (fun x hx => ?_) bot_le
    have hxZ : (⟨x, hx.1⟩ : K) ∈ Subgroup.center K := by
      rw [Subgroup.mem_center_iff]
      exact fun y => Subtype.ext ((Subgroup.mem_centralizer_iff.mp hx.2) y y.property)
    rw [hcenter, Subgroup.mem_bot] at hxZ
    exact Subgroup.mem_bot.mpr (congrArg Subtype.val hxZ)
  have hinner : ∀ b ∈ Bs, ∃ k ∈ K, ∀ x ∈ K, b * x * b⁻¹ = k * x * k⁻¹ := by
    intro b hb
    obtain ⟨k, hk⟩ :=
      CFSG.LocalAnalysis.RankThreeTheoremC.ParabCensus.allInner_of_mulEquiv_statedSp
        ha hF e (K.normalizerMonoidHom ⟨b, hN hb⟩)
    refine ⟨k, k.property, fun x hx => ?_⟩
    have h := congrArg (fun α : MulAut K => ((α ⟨x, hx⟩ : K) : G)) hk
    simpa only [Subgroup.normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply,
      Subgroup.coe_mul, Subgroup.coe_inv] using h
  have hsplit := CFSG.RankThree.PartTwo.Sec14.Ronan148J.sup_eq_of_forall_inner
    (fun b hb c hc => IsElemAbelian.comm hBs hb hc) hBs.2 hBstar hKC hN hinner
  rw [hker] at hsplit
  exact hsplit.symm

theorem selfCentralizing_native_sp_torus (ha : 3 ≤ a) (hF : Nat.card F = 2)
    (e : K ≃* StatedSp a F) (hBs : IsElemAbelian 3 Bs)
    (hN : Bs ≤ Subgroup.normalizer (K : Set G))
    (hker : Bs ⊓ Subgroup.centralizer (K : Set G) = Subgroup.zpowers z)
    (hBstar : ∀ g ∈ Subgroup.centralizer (Bs : Set G), g ^ 3 = 1 → g ∈ Bs) :
    ∀ Z : StatedSp a F,
      (∀ Y ∈ (Bs.subgroupOf K).map e.toMonoidHom, Z * Y = Y * Z) →
      Z ^ 3 = 1 → Z ∈ (Bs.subgroupOf K).map e.toMonoidHom :=
  selfCentralizing_torus_of_split_model e hker
    (bstar_eq_zpowers_sup_inf_of_native_sp ha hF e hBs hN hker hBstar) hBstar

theorem exists_spFrame_of_native_sp_bstar (ha : 3 ≤ a) (hF : Nat.card F = 2)
    (e : K ≃* StatedSp a F) (hBs : IsElemAbelian 3 Bs)
    (hN : Bs ≤ Subgroup.normalizer (K : Set G))
    (hker : Bs ⊓ Subgroup.centralizer (K : Set G) = Subgroup.zpowers z)
    (hBstar : ∀ g ∈ Subgroup.centralizer (Bs : Set G), g ^ 3 = 1 → g ∈ Bs) :
    (∃ (L : Type) (_ : Field L) (_ : Algebra F L) (_ : Module.Finite F L) (ζ : L)
        (P : ChoiceTwo.SpFrame F a ζ ((Bs.subgroupOf K).map e.toMonoidHom)),
        Module.finrank F L = 2 ∧ IsPrimitiveRoot ζ 3 ∧ P.s = a) ∧
      Nat.card ((Bs.subgroupOf K).map e.toMonoidHom) = 3 ^ a := by
  obtain ⟨hframe, hcard, -, -⟩ := exists_spFrame_of_selfCent_two hF
    ((hBs.subgroupOf K).map e.toMonoidHom)
    (selfCentralizing_native_sp_torus ha hF e hBs hN hker hBstar)
  exact ⟨hframe, hcard⟩

theorem native_sp_torus_action_data (ha : 3 ≤ a) (hF : Nat.card F = 2)
    (e : K ≃* StatedSp a F) (hBs : IsElemAbelian 3 Bs)
    (hN : Bs ≤ Subgroup.normalizer (K : Set G))
    (hker : Bs ⊓ Subgroup.centralizer (K : Set G) = Subgroup.zpowers z)
    (hBstar : ∀ g ∈ Subgroup.centralizer (Bs : Set G), g ^ 3 = 1 → g ∈ Bs)
    (hNK : Subgroup.normalizer (Bs : Set G) ⊓ Subgroup.centralizer ({z} : Set G) ≤
      Subgroup.normalizer (K : Set G))
    {L : Type} [Field L] [Algebra F L] {ζ : L}
    (P : ChoiceTwo.SpFrame F a ζ ((Bs.subgroupOf K).map e.toMonoidHom))
    (hζ : IsPrimitiveRoot ζ 3) :
    ∃ T : Multiplicative (Fin P.s → ZMod 3) →* G, Function.Injective T ∧
      T.range = Bs ⊓ K ∧
      (∀ g ∈ Subgroup.normalizer (Bs : Set G) ⊓ Subgroup.centralizer ({z} : Set G),
        ∃ (π : Equiv.Perm (Fin P.s)) (η : Fin P.s → Bool), ∀ f,
          g * T (Multiplicative.ofAdd f) * g⁻¹ =
            T (Multiplicative.ofAdd (ChoiceTwo.moveExp π η f))) ∧
      ∀ (π : Equiv.Perm (Fin P.s)) (η : Fin P.s → Bool),
        ∃ g ∈ Subgroup.normalizer (Bs : Set G) ⊓ Subgroup.centralizer ({z} : Set G),
          ∀ f, g * T (Multiplicative.ofAdd f) * g⁻¹ =
            T (Multiplicative.ofAdd (ChoiceTwo.moveExp π η f)) := by
  classical
  let ψ : StatedSp a F →* G := K.subtype.comp e.symm.toMonoidHom
  have hψ : Function.Injective ψ := fun x y h => e.symm.injective (Subtype.ext h)
  let tor : Multiplicative (Fin P.s → ZMod 3) →* StatedSp a F :=
    { toFun := fun f => P.tor (Multiplicative.toAdd f)
      map_one' := P.tor_zero
      map_mul' := fun f f' => P.tor_add hζ.pow_eq_one _ _ }
  let T : Multiplicative (Fin P.s → ZMod 3) →* G := ψ.comp tor
  have hT : Function.Injective T := by
    intro f f' h
    exact Multiplicative.toAdd.injective (P.tor_injective hζ (hψ h))
  have hmem : ∀ Y : StatedSp a F,
      Y ∈ (Bs.subgroupOf K).map e.toMonoidHom ↔ ψ Y ∈ Bs := by
    intro Y
    constructor
    · intro hY
      obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.mp hY
      change ((e.symm (e k) : K) : G) ∈ Bs
      rw [MulEquiv.symm_apply_apply]
      exact Subgroup.mem_subgroupOf.mp hk
    · intro hY
      exact Subgroup.mem_map.mpr ⟨e.symm Y, hY, e.apply_symm_apply Y⟩
  have hrange : T.range = Bs ⊓ K := by
    ext b
    constructor
    · rintro ⟨f, rfl⟩
      exact ⟨(hmem _).mp (P.tor_mem _), (e.symm (P.tor (Multiplicative.toAdd f))).property⟩
    · intro hb
      have hbE : e ⟨b, hb.2⟩ ∈ (Bs.subgroupOf K).map e.toMonoidHom :=
        Subgroup.mem_map_of_mem e.toMonoidHom hb.1
      obtain ⟨f, hf⟩ := P.mem_tor _ hbE
      refine ⟨Multiplicative.ofAdd f, ?_⟩
      change ψ (P.tor f) = b
      rw [hf]
      change ((e.symm (e ⟨b, hb.2⟩) : K) : G) = b
      rw [MulEquiv.symm_apply_apply]
  refine ⟨T, hT, hrange, ?_, ?_⟩
  · intro g hg
    let α : MulAut (StatedSp a F) :=
      MulAut.congr e (K.normalizerMonoidHom ⟨g, hNK hg⟩)
    have hconj : ∀ Y, ψ (α Y) = g * ψ Y * g⁻¹ := by
      intro Y
      change ((e.symm (α Y) : K) : G) = g * ((e.symm Y : K) : G) * g⁻¹
      simp only [α, MulAut.congr_apply,
        MulEquiv.trans_apply, MulEquiv.symm_apply_apply]
      exact Subgroup.normalizerMonoidHom_apply_apply_coe K ⟨g, hNK hg⟩ (e.symm Y)
    have hα : ∀ f, α (P.tor f) ∈ (Bs.subgroupOf K).map e.toMonoidHom := by
      intro f
      apply (hmem _).mpr
      rw [hconj]
      exact (Subgroup.mem_normalizer_iff.mp hg.1 _).mp ((hmem _).mp (P.tor_mem f))
    obtain ⟨π, η, hπη⟩ := P.exists_moveExp_of_mulAut ha hF hζ α hα
    refine ⟨π, η, fun f => ?_⟩
    change g * ψ (P.tor f) * g⁻¹ = ψ (P.tor (ChoiceTwo.moveExp π η f))
    rw [← hconj, hπη]
  · intro π η
    let w := P.move π η
    let g := ψ w
    have hgT : ∀ f, g * T (Multiplicative.ofAdd f) * g⁻¹ =
        T (Multiplicative.ofAdd (ChoiceTwo.moveExp π η f)) := by
      intro f
      change ψ (P.move π η) * ψ (P.tor f) * (ψ (P.move π η))⁻¹ =
        ψ (P.tor (ChoiceTwo.moveExp π η f))
      rw [← map_inv, ← map_mul, ← map_mul, P.move_conj hζ.pow_eq_one]
    have hzK : z ∈ Subgroup.centralizer (K : Set G) := by
      have hz : z ∈ Bs ⊓ Subgroup.centralizer (K : Set G) := by
        rw [hker]
        exact Subgroup.mem_zpowers z
      exact hz.2
    have hgK : g ∈ K := (e.symm w).property
    have hgc : g ∈ Subgroup.centralizer ({z} : Set G) :=
      Subgroup.mem_centralizer_singleton_iff.mpr
        ((Subgroup.mem_centralizer_iff.mp hzK) g hgK)
    have hzg : z ∈ Subgroup.centralizer ({g} : Set G) :=
      Subgroup.mem_centralizer_singleton_iff.mpr
        (Subgroup.mem_centralizer_singleton_iff.mp hgc).symm
    have hgZ : g ∈ Subgroup.normalizer (Subgroup.zpowers z : Set G) := by
      apply CFSG.LocalAnalysis.ComponentInitial.mem_normalizer_of_forall_conj_mem
      intro t ht
      have hgt : g * t = t * g :=
        (Subgroup.mem_centralizer_singleton_iff.mp ((Subgroup.zpowers_le.mpr hzg) ht)).symm
      rw [hgt, mul_assoc, mul_inv_cancel, mul_one]
      exact ht
    have hgE : g ∈ Subgroup.normalizer (T.range : Set G) := by
      apply CFSG.LocalAnalysis.ComponentInitial.mem_normalizer_of_forall_conj_mem
      rintro t ⟨f, rfl⟩
      exact ⟨Multiplicative.ofAdd (ChoiceTwo.moveExp π η (Multiplicative.toAdd f)),
        (hgT (Multiplicative.toAdd f)).symm⟩
    have hsplit : Bs = Subgroup.zpowers z ⊔ T.range := by
      rw [hrange]
      exact bstar_eq_zpowers_sup_inf_of_native_sp ha hF e hBs hN hker hBstar
    have hgBs : g ∈ Subgroup.normalizer (Bs : Set G) := by
      rw [hsplit]
      exact (Subgroup.normalizer_inf_normalizer_le_normalizer_sup
        (Subgroup.zpowers z) T.range) ⟨hgZ, hgE⟩
    exact ⟨g, ⟨hgBs, hgc⟩, hgT⟩

theorem native_sp_rank_eq_of_card_bstar {G : Type} [Group G] [Finite G]
    {Bs K : Subgroup G} {z : G} {F : Type} [Field F] [Finite F] [CharP F 2] {a n : ℕ}
    (ha : 3 ≤ a) (hF : Nat.card F = 2) (e : K ≃* StatedSp a F)
    (hBs : IsElemAbelian 3 Bs) (hcard : Nat.card Bs = 3 ^ n) (hz : z ∈ Bs) (hz1 : z ≠ 1)
    (hN : Bs ≤ Subgroup.normalizer (K : Set G))
    (hker : Bs ⊓ Subgroup.centralizer (K : Set G) = Subgroup.zpowers z)
    (hBstar : ∀ g ∈ Subgroup.centralizer (Bs : Set G), g ^ 3 = 1 → g ∈ Bs) : a + 1 = n := by
  let Z := Subgroup.zpowers z
  let E := Bs ⊓ K
  have hsplit : Bs = Z ⊔ E := bstar_eq_zpowers_sup_inf_of_native_sp ha hF e hBs hN hker hBstar
  have hZK : Z ≤ Subgroup.centralizer (K : Set G) := by
    change Subgroup.zpowers z ≤ Subgroup.centralizer (K : Set G)
    rw [← hker]
    exact inf_le_right
  have hcomm : ∀ x ∈ Z, ∀ y ∈ E, x * y = y * x := fun x hx y hy =>
    ((Subgroup.mem_centralizer_iff.mp (hZK hx)) y hy.2).symm
  have hcenter : Subgroup.center K = ⊥ := by
    apply Subgroup.eq_bot_of_card_eq
    rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv,
      CFSG.ClassicalGroups.Symplectic.center_statedSp_eq_bot_of_charP_two (by omega),
      Subgroup.card_bot]
  have hdisj : Z ⊓ E = ⊥ := by
    refine le_antisymm (fun x hx => ?_) bot_le
    have hmem : (⟨x, hx.2.2⟩ : K) ∈ Subgroup.center K := by
      rw [Subgroup.mem_center_iff]
      exact fun k => Subtype.ext ((Subgroup.mem_centralizer_iff.mp (hZK hx.1)) k k.property)
    rw [hcenter, Subgroup.mem_bot] at hmem
    exact Subgroup.mem_bot.mpr (congrArg Subtype.val hmem)
  have hprod : Nat.card Bs = Nat.card Z * Nat.card E := by
    calc
      Nat.card Bs = Nat.card (Z ⊔ E : Subgroup G) :=
        congrArg (fun H : Subgroup G => Nat.card H) hsplit
      _ = Nat.card (Z × E) := (Nat.card_congr
          (CFSG.GH74.E2.prodSupEquiv Z E hcomm hdisj).toEquiv).symm
      _ = _ := Nat.card_prod Z E
  let eqv : (Bs.subgroupOf K) ≃ E :=
    { toFun := fun x => ⟨((x : K) : G), ⟨x.property, (x : K).property⟩⟩
      invFun := fun x => ⟨⟨x, x.property.2⟩, x.property.1⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hnative := (exists_spFrame_of_native_sp_bstar ha hF e hBs hN hker hBstar).2
  rw [Subgroup.card_map_of_injective e.injective] at hnative
  have hE : Nat.card E = 3 ^ a := by rw [← Nat.card_congr eqv, hnative]
  have hzord : orderOf z = 3 := by
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact orderOf_eq_prime (hBs.2 z hz) hz1
  have hZ : Nat.card Z = 3 := by rw [Nat.card_zpowers, hzord]
  have hp : 3 ^ n = 3 ^ (a + 1) := by
    simpa only [hcard, hZ, hE, pow_succ, Nat.mul_comm] using hprod
  exact (Nat.pow_right_injective (by decide : 1 < 3) hp).symm


end CFSG.StandardType.FrameRoute

