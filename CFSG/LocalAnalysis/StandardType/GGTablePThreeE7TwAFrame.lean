private theorem e7uf_eq_of_labelIso {lab : LargeEvenLabel} {m : ℕ} (hm : m = 5 ∨ m = 6)
    (h : GGLabelIso lab ⟨.twA, m, 1⟩) : lab = ⟨.twA, m, 1⟩ := by
  obtain ⟨t, r, n⟩ := lab
  unfold GGLabelIso at h
  rcases h with h | h | h | h | h | h | h | h
  · exact h
  all_goals simp_all

theorem exists_frame_of_twA_component_E7 {L : Type} [Field L] [IsAlgClosed L]
    [CharP L 2] {p₀ : ℕ} (S : LangSetup Tag.E7 L p₀)
    {a : Fin Tag.E7.rank → Lˣ} (hT : rootDiagUnit Tag.E7 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) (h1 : rootDiagUnit Tag.E7 a ≠ 1) {C : Type} [Group C] [Finite C]
    (ι : C →* ModGL Tag.E7 L) (hι : Function.Injective ι) (hrange : ι.range = S.Γ)
    (β : MulAut C)
    (hβ : ∀ c, ι (β c) = rootDiagUnit Tag.E7 a * ι c * (rootDiagUnit Tag.E7 a)⁻¹)
    {J : Subgroup C} (hJ : CFSG.Assembly.IsComponentOf J (fixSubgroup β)) {m : ℕ}
    (hm : m = 5 ∨ m = 6)
    (hlab : GGHasLabel ⟨.twA, m, 1⟩ (↥J ⧸ Subgroup.center ↥J)) :
    ∃ (i : KernelComponent (rootCharHom a)) (ψ : SL(m + 1, L) →* ModGL Tag.E7 L)
      (σ : Fin (m + 1) → Fin (m + 1) → Fin Tag.E7.rank → ℤ),
      J.map ι = rationalComponent S.ρ S.Γ (rootCharHom a) i ∧ IsSLFrame ψ σ ∧
        componentRoots (rootCharHom a) i = frameRoots σ := by
  classical
  have h3 : ((3 : ℕ) : L) ≠ 0 := by
    have h2 : ((2 : ℕ) : L) = 0 := CharP.cast_eq_zero L 2
    have h3 : ((3 : ℕ) : L) = 1 := by
      have hcast : ((3 : ℕ) : L) = ((2 : ℕ) : L) + 1 := by norm_num
      rw [hcast, h2, zero_add]
    rw [h3]; exact one_ne_zero
  have hTp : rootDiagUnit Tag.E7 a ^ 3 = 1 := by
    rw [rootDiagUnit_pow]
    rw [show a ^ 3 = 1 from funext fun j => hap j, rootDiagUnit_one]
  have hTame := CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.langSetup_hTame_of_prime
    S Nat.prime_three h3 (fun h => absurd h (by decide)) hT hap h1
  obtain ⟨i, hqs, hmap⟩ := components_of_langSetup S Nat.prime_three ι hι hrange β hβ hT hap h1
    hTame (CFSG.Assembly.isComponentOf_iff_open.mp hJ)
  have hlabR : GGHasLabel ⟨.twA, m, 1⟩
      (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) :=
    ggHasLabel_quotCenter_of_mulEquiv
      ((Subgroup.equivMapOfInjective J ι hι).trans (MulEquiv.subgroupCongr hmap)) hlab
  have hΛ : LargeEvenInLambda2 ⟨.twA, m, 1⟩ := by
    rcases hm with rfl | rfl <;> simp [LargeEvenInLambda2]
  have hrigid : ∀ lab : LargeEvenLabel, RationalLabelIs S i lab → lab = ⟨.twA, m, 1⟩ := by
    intro lab hRL
    exact e7uf_eq_of_labelIso hm
      (ggLabelRigidInput_holds lab ⟨.twA, m, 1⟩
        (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
          Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i))
        hRL.1 hΛ hRL.2 hlabR)
  have htw : ∀ lab : LargeEvenLabel, RationalLabelIs S i lab → lab.tag = .twA :=
    fun lab hRL => by rw [hrigid lab hRL]
  obtain ⟨v, μ, x, c, -, hc, -, hlen, -, hrank, hncard⟩ :=
    exists_cand_of_class kacE7 facts_E7 e7_tree e7_adj e7_check e7_lt e7_card S Nat.prime_three
      h3 hTp i
  have hshape := e7_shape c hc hlen
  rw [← hncard, ← hrank] at hshape
  have hnorank4 : compRank (componentRoots (rootCharHom a) i) ≠ 4 :=
    (e78_three_classes (Or.inl rfl) h3 hap).1 i
  rcases hshape with hA | hD | hE
  · obtain ⟨lab, -, hrankR, -, -, hRL⟩ :=
      rationalLabel_typeA S Nat.prime_three hT hap h1 i hA hqs
    have hlab_eq : lab = ⟨.twA, m, 1⟩ := hrigid lab hRL
    have hrm : compRank (componentRoots (rootCharHom a) i) = m := by
      rw [← hrankR, hlab_eq]
    have h2 : 2 ≤ compRank (componentRoots (rootCharHom a) i) := by
      rw [hrm]; rcases hm with rfl | rfl <;> norm_num
    obtain ⟨ν, ψ, σ, -, hψ, hnorm, hΨ⟩ :=
      exists_frame_of_typeA_E7_T_of_prime S Nat.prime_three h3 hTp i h2 hA.2
    have hcount := CFSG.LocalAnalysis.GLTheoremA.kd147c_frameRoots_ncard hψ
      (κ := 1) one_ne_zero hnorm
    have hnν : (frameRoots σ).ncard = m * (m + 1) := by
      rw [← hΨ, hA.2, hrm]
    have heq : ν * (ν - 1) = m * (m + 1) := hcount.symm.trans hnν
    have hm5 : 5 ≤ m := by rcases hm with rfl | rfl <;> norm_num
    have hνm : ν = m + 1 := by
      by_contra hne
      rcases Nat.lt_or_gt_of_ne hne with hlt | hgt
      · have h1 : ν ≤ m := by omega
        have h2 : ν - 1 ≤ m - 1 := Nat.sub_le_sub_right h1 1
        have h3 : ν * (ν - 1) ≤ m * (m - 1) := Nat.mul_le_mul h1 h2
        rw [heq] at h3
        have h4 : m * (m - 1) < m * (m + 1) :=
          Nat.mul_lt_mul_of_pos_left (by omega) (by omega)
        omega
      · have h1 : m + 2 ≤ ν := by omega
        have h2 : m + 1 ≤ ν - 1 := by omega
        have h3 : (m + 2) * (m + 1) ≤ ν * (ν - 1) := Nat.mul_le_mul h1 h2
        rw [heq] at h3
        have h4 : m * (m + 1) < (m + 2) * (m + 1) :=
          Nat.mul_lt_mul_of_pos_right (by omega) (by omega)
        omega
    subst hνm
    exact ⟨i, ψ, σ, hmap, hψ, hΨ⟩
  · by_cases hinner : twistInner (componentRoots (rootCharHom a) i)
        ((S.ρ : (Fin Tag.E7.rank → ℤ) → _)^[componentOrbitLength S.ρ
          (componentRoots (rootCharHom a) i)])
    · obtain ⟨lab, -, htag, -, hRL⟩ :=
        rationalLabel_innerD_E78 (Or.inl rfl) S Nat.prime_three h3 hT hTp i hD hinner hqs
      cases htag.symm.trans (htw lab hRL)
    · obtain ⟨lab, -, h1c, -, -, hRL⟩ :=
        rationalLabel_outerD S Nat.prime_three hT hap h1 i hD hinner hqs
      have htwo : twistKind S.ρ (rootCharHom a) i = .twoD := by
        rcases twistKind_outerD S.ρ (rootCharHom a) i hD hinner with h | ⟨h, h4⟩
        · exact h
        · exact absurd h4 hnorank4
      cases (h1c htwo hnorank4).1.symm.trans (htw lab hRL)
  · by_cases hinner : twistInner (componentRoots (rootCharHom a) i)
        ((S.ρ : (Fin Tag.E7.rank → ℤ) → _)^[componentOrbitLength S.ρ
          (componentRoots (rootCharHom a) i)])
    · obtain ⟨lab, -, htag, hRL⟩ :=
        rationalLabel_innerE_E78 (Or.inl rfl) S Nat.prime_three h3 hT hTp i hE hinner hqs
      rcases htag with h | h | h <;> cases h.symm.trans (htw lab hRL)
    · obtain ⟨lab, -, htag, hRL⟩ :=
        rationalLabel_outerE_E78 (Or.inl rfl) S Nat.prime_three h3 hT hTp i hE hinner hqs
      cases htag.symm.trans (htw lab hRL)

