open CFSG.RankThree.Classical2 (conjSLn statedSUToSL)

theorem exists_stdSetup_suCover_of_twA_component_E7 {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = 2) {s : ↥(adjointGroup Tag.E7 F)} (hs3 : s ^ 3 = 1) (hs1 : s ≠ 1)
    {J : Subgroup ↥(adjointGroup Tag.E7 F)}
    (hJ : CFSG.Assembly.IsComponentOf J (Subgroup.centralizer {s})) {m : ℕ}
    (hm : m = 5 ∨ m = 6) (hlab : GGHasLabel ⟨.twA, m, 1⟩ (↥J ⧸ Subgroup.center ↥J)) :
    ∃ (S : LangSetup Tag.E7 (AlgebraicClosure F) 5)
      (a : Fin Tag.E7.rank → (AlgebraicClosure F)ˣ)
      (ι : ↥(adjointGroup Tag.E7 F) →* ModGL Tag.E7 (AlgebraicClosure F)),
      S.D.q = 2 ∧ (∀ γ, S.ρ γ = -γ) ∧ rootDiagUnit Tag.E7 a ∈ S.D.torus ∧
      (∀ i, a i ^ 3 = 1) ∧ rootDiagUnit Tag.E7 a ≠ 1 ∧ Function.Injective ι ∧
      ι.range = S.Γ ∧ ι s = rootDiagUnit Tag.E7 a ∧
      (∀ c, ι (MulAut.conj s c) =
        rootDiagUnit Tag.E7 a * ι c * (rootDiagUnit Tag.E7 a)⁻¹) ∧
      (∃ Fr : AlgebraicClosure F →+* AlgebraicClosure F, (∀ c, Fr c = c ^ 2) ∧
        S.D.Φ = Units.map (entrywiseHom Fr)) ∧
      S.D.n = canonicalRep (coxeterSystem Tag.E7) (AlgebraicClosure F) e7Neg ∧
      (∃ h ∈ adjointGroup Tag.E7 (AlgebraicClosure F), ∀ z,
        ι z = h * baseChangeGL (algebraMap F (AlgebraicClosure F))
          (z : ModGL Tag.E7 F) * h⁻¹) ∧
      ∃ (i : KernelComponent (rootCharHom a))
        (ψ : SL(m + 1, AlgebraicClosure F) →* ModGL Tag.E7 (AlgebraicClosure F))
        (σ : Fin (m + 1) → Fin (m + 1) → Fin Tag.E7.rank → ℤ),
        J.map ι = rationalComponent S.ρ S.Γ (rootCharHom a) i ∧ IsSLFrame ψ σ ∧
        componentRoots (rootCharHom a) i = frameRoots σ ∧
        ∃ (z : ModGL Tag.E7 (AlgebraicClosure F)) (W : GL (Fin (m + 1)) (AlgebraicClosure F)),
          z ∈ adjointGroup Tag.E7 (AlgebraicClosure F) ∧
          (∀ X, z * ψ X * z⁻¹ = ψ (conjSLn W X)) ∧
          ∃ K : Subfield (AlgebraicClosure F), Nat.card K = 4 ∧ (∀ c, c ∈ K ↔ c ^ 4 = c) ∧
            ∃ (Φ : StatedSU (m + 1) 2 K →* J)
              (θ : ↥J ⧸ Subgroup.center ↥J ≃*
                LargeEvenProj (LargeEvenSUGroup (Fin (m + 1)) K 2)),
              (∀ x, ι (Φ x) = z * ψ (statedSUToSL K (m + 1) 2 x) * z⁻¹) ∧
              (∀ x, θ (QuotientGroup.mk (Φ x)) =
                LargeEvenProjMk (LargeEvenSUGroup (Fin (m + 1)) K 2) x) ∧
              Function.Surjective Φ ∧ Φ.ker ≤ Subgroup.center (StatedSU (m + 1) 2 K) := by
  letI : Fintype F := Fintype.ofFinite F
  have : CharP F 2 := charP_of_card_eq_prime_pow (f := 1)
    (by rw [← Nat.card_eq_fintype_card, hF]; norm_num)
  have : CharP (AlgebraicClosure F) 2 :=
    charP_of_injective_algebraMap (algebraMap F (AlgebraicClosure F)).injective 2
  have : Finite (ModGL Tag.E7 F) := finite_modGL
  obtain ⟨S, a, ι, hq, hρ, hT, ha3, ha1, hι, hr, hs, hc, hFr, hn, hh⟩ :=
    ChevQ.E7InnerAbs.exists_stdSetup_of_inner_frobenius_conj_baseChange hF hs3 hs1
  have hfix : fixSubgroup (MulAut.conj s) = Subgroup.centralizer {s} := by
    ext g
    rw [mem_fixSubgroup, Subgroup.mem_centralizer_singleton_iff, MulAut.conj_apply,
      mul_inv_eq_iff_eq_mul]
    exact eq_comm
  obtain ⟨i, ψ, σ, hJι, hψ, hΨ⟩ := exists_frame_of_twA_component_E7 S hT ha3 ha1 ι hι hr
    (MulAut.conj s) hc (hfix ▸ hJ) hm hlab
  have hν : 3 ≤ m + 1 := by omega
  have hνq : (m + 1, 2 ^ 1) ≠ (3, 2) := by rcases hm with rfl | rfl <;> decide
  obtain ⟨z, W, hzC, hW, K, hK, hKmem, Φ, θ, hΦ, hθ, hsurj, hker⟩ :=
    SCFourCover.exists_suCover_of_unitary_frame_of_neg S hρ hT i hψ hΨ (r := 2) (e := 1)
      Nat.prime_two one_pos (by rw [hq, pow_one]) hν hνq hι hJι
  exact ⟨S, a, ι, hq, hρ, hT, ha3, ha1, hι, hr, hs, hc, hFr, hn, hh, i, ψ, σ, hJι, hψ, hΨ,
    z, W, hzC, hW, K, hK, hKmem, Φ, θ, hΦ, hθ, hsurj, hker⟩

end SUCover

