private theorem fiveB_gen_closure_card_central {G : Type} [Group G] [Finite G]
    (g : Fin 9 → G)
    (hpow : ∀ i : Fin 9, g i ^ 5 = prodAsc g pw[i.val]!)
    (hcomm : ∀ i j : Fin 9, i < j →
      g i * g j * (g i)⁻¹ = prodAsc g cw[i.val * 9 + j.val]!)
    (hz : g 8 ≠ 1) :
    Nat.card ↥(Subgroup.closure (Set.range g)) = 5 ^ 9 ∧
      Subgroup.closure (Set.range g) ≤ Subgroup.centralizer ({g 8} : Set G) := by
  have H := CFSG.KC.MonPcFive.pcHyp_of_rel hpow hcomm
  refine ⟨fiveSylow_card g hpow hcomm hz, fun x hx => ?_⟩
  have hc := CFSG.KC.MonPcFive.comm_last_of_mem H hx
  refine Subgroup.mem_centralizer_singleton_iff.2 ?_
  first
  | exact hc
  | exact hc.symm

end FiveBHelpers

theorem factorization_Gmat_five :
    (Nat.card Gmat).factorization 5 = 9 := by
  obtain ⟨-, hcard, hm, -⟩ := gmat_five_setup
  have hm0 : monsterOrder / 5 ^ 9 ≠ 0 := by norm_num [monsterOrder]
  rw [hcard, Nat.factorization_mul (pow_ne_zero _ (by norm_num)) hm0, Finsupp.add_apply,
    Nat.prime_five.factorization_pow, Nat.factorization_eq_zero_of_not_dvd hm]
  simp

theorem five_sylow_closure :
    Nat.card ↥(Subgroup.closure (Set.range fiveGenG)) = 5 ^ 9 ∧
      Subgroup.closure (Set.range fiveGenG) ≤ Subgroup.centralizer ({xFiveB} : Set Gmat) := by
  obtain ⟨-, -, -, hpow, hcomm, hz⟩ := gmat_five_setup
  exact fiveB_gen_closure_card_central fiveGenG hpow hcomm hz

theorem five_factorization_le_of_closure_le
    {L : Subgroup Gmat} (hL : Subgroup.closure (Set.range fiveGenG) ≤ L) :
    (Nat.card Gmat).factorization 5 ≤ (Nat.card ↥L).factorization 5 := by
  have hS := five_sylow_closure.1
  have hdvd : 5 ^ 9 ∣ Nat.card ↥L := by
    have h := Subgroup.card_dvd_of_le hL
    rwa [hS] at h
  rw [factorization_Gmat_five]
  exact (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_five Nat.card_pos.ne').1 hdvd

end CFSG.StandardType.SporadicShape
