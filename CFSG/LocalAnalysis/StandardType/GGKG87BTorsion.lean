theorem e6AdToral_of_rootGroup_line
    {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ} {h : twistedE6InndiagGL K σ}
    (D : TwE6LineLang K σ q h)
    (hdim : twE6MatFixDim K σ h = 28 ∨ twE6MatFixDim K σ h = 30 ∨ twE6MatFixDim K σ h = 46)
    {X : Subgroup (ModGL Tag.E6 (AlgebraicClosure K))} (hX : IsElemAbelian 3 X)
    (hXM : ∀ x ∈ X, D.S.D.g0⁻¹ * x * D.S.D.g0 ∈
      toralRootGroup Tag.E6 (AlgebraicClosure K) D.a) :
    E6AdToral X := by
  have : Fact (ringChar K).Prime := ⟨D.hℓ⟩
  have := D.hchar
  have hg := D.S.D.g0_mem
  have hk : (kernelRoots (rootCharHom D.a)).ncard ∈ ({22, 24, 40} : Set ℕ) := by
    have := D.hker
    rcases hdim with h | h | h
    · left; omega
    · right; left; omega
    · right; right; show _ = 40; omega
  refine (e6AdToral_map_conj (inv_mem hg) X).1 (e6LeviThreeToralBar (AlgebraicClosure K)
    (ringChar K) ?_ (isAlgebraic_zmod_algebraicClosure_of_finite K (ringChar K)) D.a D.hap hk _
    (hX.map _) ?_)
  · intro h3
    apply D.hL3
    rw [← h3]
    exact CharP.cast_eq_zero _ _
  · rintro _ ⟨x, hx, rfl⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
    exact hXM x hx

theorem fixDim_eq_of_rootGroup_line
    {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ} {h : twistedE6InndiagGL K σ}
    (D : TwE6LineLang K σ q h) (hh3 : h ^ 3 = 1) (hh1 : h ≠ 1)
    {X : Subgroup (ModGL Tag.E6 (AlgebraicClosure K))} (hX : IsElemAbelian 3 X)
    (hXM : ∀ x ∈ X, D.S.D.g0⁻¹ * x * D.S.D.g0 ∈
      toralRootGroup Tag.E6 (AlgebraicClosure K) D.a)
    (hnt : ¬ E6AdToral X) :
    twE6MatFixDim K σ h = 24 ∨ twE6MatFixDim K σ h = 36 := by
  have hK3 : ringChar K ≠ 3 := fun h3 => by
    apply D.hL3
    have := D.hchar
    rw [← h3]
    exact CharP.cast_eq_zero _ _
  have hmem := twE6MatFixDim_mem_of_pow_three hK3 hh3 hh1
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hmem
  rcases hmem with h24 | h28 | h30 | h36 | h46
  · exact Or.inl h24
  · exact absurd (e6AdToral_of_rootGroup_line D (Or.inl h28) hX hXM) hnt
  · exact absurd (e6AdToral_of_rootGroup_line D (Or.inr (Or.inl h30)) hX hXM) hnt
  · exact Or.inr h36
  · exact absurd (e6AdToral_of_rootGroup_line D (Or.inr (Or.inr h46)) hX hXM) hnt

