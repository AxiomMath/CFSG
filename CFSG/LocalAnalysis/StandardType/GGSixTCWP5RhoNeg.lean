section RhoNeg

theorem permLattice_e6Graph_eq_neg_twE6W0
    (x : Fin Tag.E6.rank → ℤ) :
    permLattice e6Graph x = -(twE6W0 • x) := by
  rw [twE6W0_smul, neg_neg]
  rfl

theorem rho_eq_neg_smul_of_twE6
    {ρ : Equiv.Perm (Fin Tag.E6.rank → ℤ)} {w : WeylGroup Tag.E6}
    (hw : ∀ γ, IsRoot Tag.E6 γ → ρ γ = w • permLattice e6Graph γ) :
    ∃ w' : WeylGroup Tag.E6, ∀ γ, IsRoot Tag.E6 γ → ρ γ = -(w' • γ) := by
  refine ⟨w * twE6W0, fun γ hγ => ?_⟩
  rw [hw γ hγ, permLattice_e6Graph_eq_neg_twE6W0, smul_neg, mul_smul]

end RhoNeg

