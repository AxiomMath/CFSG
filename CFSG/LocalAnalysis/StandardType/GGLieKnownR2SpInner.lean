private theorem l10ss1_inner_map_mulEquiv {K K' : Type*} [Group K] [Group K'] (e : K ≃* K')
    {R : Subgroup K} (h : GGRootNormInner R) : GGRootNormInner (R.map e.toMonoidHom) :=
  ggRootNormInner_map_mulEquiv e h

private theorem l10ss1c_mem_of_map_eq {G : Type*} [Group G] {H : Subgroup G} {φ : MulAut G}
    (h : H.map φ.toMonoidHom = H) {x : G} : φ x ∈ H ↔ x ∈ H := by
  constructor
  · intro hx
    have hx' : φ x ∈ H.map φ.toMonoidHom := by rw [h]; exact hx
    rw [Subgroup.mem_map] at hx'
    obtain ⟨y, hy, hyx⟩ := hx'
    rwa [φ.injective hyx] at hy
  · intro hx
    rw [← h]
    exact Subgroup.mem_map_of_mem φ.toMonoidHom hx

private theorem l10ss1c_fieldSp_diagSp {n : ℕ} {F : Type} [Field F] (σ : F ≃+* F)
    (t : Fin n → Fˣ) :
    fieldSp n F σ (diagSp F n t) =
      diagSp F n (fun i => Units.map σ.toRingHom.toMonoidHom (t i)) := by
  apply mat_injective
  change (mat n F (diagSp F n t)).map σ =
    mat n F (diagSp F n (fun i => Units.map σ.toRingHom.toMonoidHom (t i)))
  rw [mat_diagSp, mat_diagSp, diagonal_map (map_zero σ)]
  congr 1
  funext a
  rcases a with i | i <;> simp [diagSpEntry, map_inv₀]

private theorem l10ss1c_diagSp_mulVec_single {n : ℕ} {F : Type} [Field F]
    (t : Fin n → Fˣ) (j : Fin n ⊕ Fin n) :
    mat n F (diagSp F n t) *ᵥ Pi.single j 1 = diagSpEntry t j • Pi.single j 1 := by
  rw [mat_diagSp]
  ext i
  rw [Matrix.mulVec_diagonal]
  simp only [Pi.smul_apply, Pi.single_apply, smul_eq_mul]
  by_cases hij : i = j <;> simp [hij]

private theorem l10ss1c_fieldSp_diagSp_mulVec_single {n : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) (t : Fin n → Fˣ) (j : Fin n ⊕ Fin n) :
    mat n F (fieldSp n F σ (diagSp F n t)) *ᵥ Pi.single j 1 =
      σ (diagSpEntry t j) • Pi.single j 1 := by
  rw [l10ss1c_fieldSp_diagSp, l10ss1c_diagSp_mulVec_single]
  congr 1
  rcases j with i | i <;> simp [diagSpEntry, map_inv₀]

private theorem l10ss1c_fieldSp_rootGroup {n : ℕ} {F : Type} [Field F] (σ : F ≃+* F)
    {β : Fin n → ℤ} (hβ : β ∈ (Symplectic.rootDatum n F).roots) :
    ((rootGroup n F β).map (fieldSp n F σ).toMonoidHom) = rootGroup n F β := by
  obtain ⟨r, hr⟩ := exists_stdVec_of_mem_roots hβ
  ext x
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨c, rfl⟩ := (mem_rootGroup_iff hr).1 hy
    change fieldSp n F σ (elt r c) ∈ rootGroup n F β
    rw [CFSG.SeitzReduction.F4Pilot.fieldSp_elt]
    exact (mem_rootGroup_iff hr).2 ⟨σ c, rfl⟩
  · intro hx
    obtain ⟨c, rfl⟩ := (mem_rootGroup_iff hr).1 hx
    refine ⟨elt r (σ.symm c), (mem_rootGroup_iff hr).2 ⟨σ.symm c, rfl⟩, ?_⟩
    change fieldSp n F σ (elt r (σ.symm c)) = elt r c
    rw [CFSG.SeitzReduction.F4Pilot.fieldSp_elt]
    simp

private theorem l10ss1c_conj_mem_normalizer {n : ℕ} {F : Type} [Field F]
    {β : Fin n → ℤ} (hβ : β ∈ (Symplectic.rootDatum n F).roots)
    (s : StatedSp n F) (σ : F ≃+* F)
    (hyR : ((rootGroup n F β).map (MulAut.conj s * fieldSp n F σ).toMonoidHom) =
      rootGroup n F β) :
    s ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) := by
  have hfield := l10ss1c_fieldSp_rootGroup σ hβ
  have hcancel : ∀ x : StatedSp n F, fieldSp n F σ ((fieldSp n F σ⁻¹) x) = x := by
    intro x
    rw [map_inv (fieldSp n F) σ, ← MulAut.mul_apply, mul_inv_cancel, MulAut.one_apply]
  have hφeq : ∀ x : StatedSp n F,
      s * x * s⁻¹ = (MulAut.conj s * fieldSp n F σ) ((fieldSp n F σ⁻¹) x) := by
    intro x
    rw [MulAut.mul_apply, MulAut.conj_apply, hcancel]
  rw [Subgroup.mem_normalizer_iff]
  intro x
  have hiff := l10ss1c_mem_of_map_eq (φ := fieldSp n F σ) hfield (x := (fieldSp n F σ⁻¹) x)
  rw [hcancel] at hiff
  constructor
  · intro hx
    have hx' : (fieldSp n F σ⁻¹) x ∈ rootGroup n F β := hiff.1 hx
    have hφx : (MulAut.conj s * fieldSp n F σ) ((fieldSp n F σ⁻¹) x) ∈
        rootGroup n F β :=
      (l10ss1c_mem_of_map_eq (φ := MulAut.conj s * fieldSp n F σ) hyR).2 hx'
    rwa [← hφeq x] at hφx
  · intro hx
    have hφx : (MulAut.conj s * fieldSp n F σ) ((fieldSp n F σ⁻¹) x) ∈
        rootGroup n F β := by
      rw [← hφeq x]; exact hx
    have hx' : (fieldSp n F σ⁻¹) x ∈ rootGroup n F β :=
      (l10ss1c_mem_of_map_eq (φ := MulAut.conj s * fieldSp n F σ) hyR).1 hφx
    exact hiff.2 hx'

private theorem l10ss1c_eq_one_of_pow_two {F : Type} [Field F] [Finite F] [CharP F 2]
    (μ : F) (k : ℕ) (h : μ ^ 2 ^ k = 1) : μ = 1 := by
  have hodd : Odd (Nat.card Fˣ) := by
    have h1 := odd_card_rootTorusSp (K := F) (n := 1) 0
    rw [card_rootTorusSp, ← Nat.card_units] at h1
    exact h1
  have hcop : Nat.Coprime (2 ^ k) (Nat.card Fˣ) :=
    Nat.Coprime.pow_left _ (Nat.coprime_two_left.2 hodd)
  by_cases hμ0 : μ = 0
  · exfalso
    rw [hμ0, zero_pow (pow_ne_zero k (by norm_num : (2 : ℕ) ≠ 0))] at h
    exact zero_ne_one h
  · set u : Fˣ := Units.mk0 μ hμ0 with hu
    have hu1 : u ^ 2 ^ k = 1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_one]
      simpa [hu] using h
    have h1 : orderOf u ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hu1
    have h2 : orderOf u ∣ Nat.card Fˣ := orderOf_dvd_natCard u
    have hone : u = 1 := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hcop h1 h2)
    have : (u : F) = 1 := by rw [hone, Units.val_one]
    simpa [hu] using this

private theorem l10ss1c_isTransGroup_pos {n : ℕ} {F : Type} [Field F] {β : Fin n → ℤ}
    {i : Fin n} (hr : stdVec (RootSubgroupIndex.positiveLong i) = toStd n β) :
    IsTransGroup (Pi.single (Sum.inl i) 1) (rootGroup n F β) := by
  have hγ : toStd n β = 2 • Pi.single i 1 := by rw [← hr]; rfl
  refine ⟨(mem_rootGroup_pos_iff (F := F) hγ), fun c => ?_⟩
  exact ⟨elt (RootSubgroupIndex.positiveLong i) c, by
    rw [mat_elt]
    show 1 + c • E F (RootSubgroupIndex.positiveLong i) =
      1 + c • spNil (Pi.single (Sum.inl i) 1)
    rw [spNil_inl]
    rfl⟩

private theorem l10ss1c_isTransGroup_neg {n : ℕ} {F : Type} [Field F] {β : Fin n → ℤ}
    {i : Fin n} (hr : stdVec (RootSubgroupIndex.negativeLong i) = toStd n β) :
    IsTransGroup (Pi.single (Sum.inr i) 1) (rootGroup n F β) := by
  have hγ : toStd n β = -(2 • Pi.single i 1) := by rw [← hr]; rfl
  refine ⟨(mem_rootGroup_neg_iff (F := F) hγ), fun c => ?_⟩
  exact ⟨elt (RootSubgroupIndex.negativeLong i) (-c), by
    rw [mat_elt]
    show 1 + (-c) • E F (RootSubgroupIndex.negativeLong i) =
      1 + c • spNil (Pi.single (Sum.inr i) 1)
    rw [spNil_inr]
    simp [E, smul_neg, neg_smul]⟩

private theorem l10ss1c_pCore_spLine_mulVec_eq_self {n : ℕ} {F : Type} [Field F]
    [Finite F] [CharP F 2] {a : Fin n ⊕ Fin n → F} (ha : a ≠ 0)
    {T : Subgroup (StatedSp n F)} (hT : IsTransGroup a T)
    {r : StatedSp n F}
    (hr : r ∈ pCoreOf 2 (Subgroup.normalizer (T : Set (StatedSp n F)))) :
    mat n F r *ᵥ a = a := by
  have hN : Subgroup.normalizer (T : Set (StatedSp n F)) =
      CFSG.Timmesfeld.Transvection.ModelRank.spLine a :=
    CFSG.Timmesfeld.Transvection.ModelRank.normalizer_eq_spLine ha hT
  have hrs : r ∈ CFSG.Timmesfeld.Transvection.ModelRank.spLine a := by
    have h1 := GGRootNorm.pCoreOf_le (Subgroup.normalizer (T : Set (StatedSp n F))) hr
    rwa [hN] at h1
  obtain ⟨μ, _hμne, hμ⟩ := hrs
  have hpow : ∀ m : ℕ, mat n F (r ^ m) *ᵥ a = (μ ^ m) • a := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
        rw [pow_succ, map_mul, ← Matrix.mulVec_mulVec, hμ, Matrix.mulVec_smul, ih, smul_smul,
          ← pow_succ']
  obtain ⟨k, hk⟩ := (GGRootNorm.isPGroup_pCoreOf
    (Subgroup.normalizer (T : Set (StatedSp n F)))).exists_pow_pow_eq_one ⟨r, hr⟩
  have hk' : r ^ 2 ^ k = 1 := by
    have h := congrArg Subtype.val hk
    simpa using h
  have hμa : μ ^ 2 ^ k • a = a := by
    rw [← hpow (2 ^ k), hk', map_one, Matrix.one_mulVec]
  have hμpow : μ ^ 2 ^ k = 1 := by
    have h1 : (μ ^ 2 ^ k - 1) • a = 0 := by rw [sub_smul, hμa, one_smul, sub_self]
    rcases smul_eq_zero.mp h1 with h | h
    · exact sub_eq_zero.mp h
    · exact absurd h ha
  have hμ1 : μ = 1 := l10ss1c_eq_one_of_pow_two μ k hμpow
  have h1 : mat n F r *ᵥ a = μ • a := by simpa using hpow 1
  rw [h1, hμ1, one_smul]

private theorem l10ss1c_scalar_eq {n : ℕ} {F : Type} [Field F]
    {a : Fin n ⊕ Fin n → F} (ha : a ≠ 0)
    (s t : StatedSp n F) (σ : F ≃+* F) (c : F)
    (htv : mat n F t *ᵥ a = c • a)
    (hfw : mat n F (fieldSp n F σ t) *ᵥ (mat n F s⁻¹ *ᵥ a) =
      σ c • (mat n F s⁻¹ *ᵥ a))
    (hrv : mat n F ((MulAut.conj s * fieldSp n F σ) t * t⁻¹) *ᵥ a = a) :
    σ c = c := by
  have hφ : mat n F ((MulAut.conj s * fieldSp n F σ) t) *ᵥ a = σ c • a := by
    rw [show (MulAut.conj s * fieldSp n F σ) t = s * fieldSp n F σ t * s⁻¹ by
      simp [MulAut.mul_apply, MulAut.conj_apply]]
    rw [map_mul, map_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hfw,
      Matrix.mulVec_smul, Matrix.mulVec_mulVec, ← map_mul, mul_inv_cancel, map_one,
      Matrix.one_mulVec]
  have hrt : mat n F ((MulAut.conj s * fieldSp n F σ) t) *ᵥ a = c • a := by
    rw [show (MulAut.conj s * fieldSp n F σ) t =
      ((MulAut.conj s * fieldSp n F σ) t * t⁻¹) * t by group]
    rw [map_mul, ← Matrix.mulVec_mulVec, htv, Matrix.mulVec_smul, hrv]
  have hsc : σ c • a = c • a := hφ.symm.trans hrt
  have h0 : (σ c - c) • a = 0 := by rw [sub_smul, hsc, sub_self]
  rcases smul_eq_zero.mp h0 with h | h
  · exact sub_eq_zero.mp h
  · exact absurd h ha

private theorem l10ss1c_spJ_mulVec_single {n : ℕ} {F : Type} [Field F] [CharP F 2]
    (b : Fin n ⊕ Fin n) :
    spJ n F *ᵥ Pi.single b 1 = Pi.single b.swap 1 := by
  ext k
  rcases b with i | i <;> rcases k with k | k <;>
    simp [spJ, Matrix.mulVec, dotProduct, Pi.single_apply, Matrix.fromBlocks,
      Fintype.sum_sum_type, Matrix.one_apply, CharTwo.neg_eq, eq_comm]

private theorem l10ss1c_std_dot_J_single {n : ℕ} {F : Type} [Field F] [CharP F 2]
    (a b : Fin n ⊕ Fin n) :
    (Pi.single a (1 : F) : Fin n ⊕ Fin n → F) ⬝ᵥ (spJ n F *ᵥ Pi.single b 1) =
      if a = b.swap then 1 else 0 := by
  rw [l10ss1c_spJ_mulVec_single]
  simp only [dotProduct_single, Pi.single_apply, mul_one]
  by_cases h : a = b.swap
  · simp [h]
  · have h' : ¬ b.swap = a := fun hh => h hh.symm
    simp [h, h']

private theorem l10ss1c_vecMulVec_single {ι : Type} [DecidableEq ι] {F : Type} [Field F]
    (i j : ι) :
    Matrix.vecMulVec (Pi.single i (1 : F)) (Pi.single j 1) = Matrix.single i j 1 := by
  ext a b
  rw [Matrix.vecMulVec_apply, Pi.single_apply, Pi.single_apply, Matrix.single_apply]
  by_cases ha : a = i
  · subst ha
    by_cases hb : b = j
    · subst hb; simp
    · simp [hb, Ne.symm hb]
  · by_cases hb : b = j
    · subst hb; simp [ha, Ne.symm ha]
    · simp [ha, hb, Ne.symm ha, Ne.symm hb]

private theorem l10ss1c_spAltSiegel_eq_rootGroup {n : ℕ} {F : Type} [Field F]
    {β : Fin n → ℤ} {r : RootSubgroupIndex n} (hr : stdVec r = toStd n β)
    {a₁ a₂ : Fin n ⊕ Fin n → F}
    (hE : Matrix.vecMulVec a₁ (spJ n F *ᵥ a₂) + Matrix.vecMulVec a₂ (spJ n F *ᵥ a₁) =
      E F r) :
    spAltSiegel n F a₁ a₂ = rootGroup n F β := by
  have hmap : (rootGroup n F β).map (StatedSp n F).subtype = altSiegelGroup (spJ n F) a₁ a₂ := by
    apply le_antisymm
    · rintro _ ⟨x, hx, rfl⟩
      obtain ⟨c, rfl⟩ := (mem_rootGroup_iff hr).1 hx
      unfold altSiegelGroup
      refine Subgroup.subset_closure ⟨c, ?_⟩
      change mat n F (elt r c) = 1 + c • (Matrix.vecMulVec a₁ (spJ n F *ᵥ a₂) +
        Matrix.vecMulVec a₂ (spJ n F *ᵥ a₁))
      rw [mat_elt, hE]
    · unfold altSiegelGroup
      refine (Subgroup.closure_le _).2 ?_
      rintro g ⟨c, hc⟩
      refine Subgroup.mem_map.mpr ⟨elt r c, (mem_rootGroup_iff hr).2 ⟨c, rfl⟩, ?_⟩
      apply Units.ext
      change mat n F (elt r c) = (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
      rw [mat_elt, ← hE, hc]
  rw [spAltSiegel, ← hmap]
  exact Subgroup.comap_map_eq_self_of_injective (StatedSp n F).subtype_injective _

private theorem l10ss1c_isTotallyIsotropic_span_pair {n : ℕ} {F : Type} [Field F]
    {a₁ a₂ : Fin n ⊕ Fin n → F}
    (s1 : a₁ ⬝ᵥ (spJ n F *ᵥ a₁) = 0) (s2 : a₂ ⬝ᵥ (spJ n F *ᵥ a₂) = 0)
    (s12 : a₁ ⬝ᵥ (spJ n F *ᵥ a₂) = 0) (s21 : a₂ ⬝ᵥ (spJ n F *ᵥ a₁) = 0) :
    (spForm n F).IsTotallyIsotropic (Submodule.span F {a₁, a₂}) := by
  intro x hx y hy
  obtain ⟨c₁, c₂, rfl⟩ := Submodule.mem_span_pair.mp hx
  obtain ⟨d₁, d₂, rfl⟩ := Submodule.mem_span_pair.mp hy
  simp only [spForm_β, Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add,
    smul_dotProduct, dotProduct_smul, smul_eq_mul, s1, s2, s12, s21]
  ring

private theorem l10ss1c_diagSp_scalar_on_span {n : ℕ} {F : Type} [Field F]
    {a₁ a₂ : Fin n ⊕ Fin n → F} {u : Fin n → Fˣ} {c : F}
    (h₁ : mat n F (diagSp F n u) *ᵥ a₁ = c • a₁)
    (h₂ : mat n F (diagSp F n u) *ᵥ a₂ = c • a₂) :
    ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F (diagSp F n u) *ᵥ w = c • w := by
  intro w hw
  obtain ⟨α, β, rfl⟩ := Submodule.mem_span_pair.mp hw
  rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, h₁, h₂, smul_add]
  congr 1 <;> rw [smul_smul, smul_smul, mul_comm]

private theorem l10ss1c_fieldSp_diagSp_scalar_on_span {n : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) {a₁ a₂ : Fin n ⊕ Fin n → F} {u : Fin n → Fˣ} {c : F}
    (h₁ : mat n F (fieldSp n F σ (diagSp F n u)) *ᵥ a₁ = c • a₁)
    (h₂ : mat n F (fieldSp n F σ (diagSp F n u)) *ᵥ a₂ = c • a₂) :
    ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F (fieldSp n F σ (diagSp F n u)) *ᵥ w = c • w := by
  intro w hw
  obtain ⟨α, β, rfl⟩ := Submodule.mem_span_pair.mp hw
  rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, h₁, h₂, smul_add]
  congr 1 <;> rw [smul_smul, smul_smul, mul_comm]

private theorem l10ss1c_long {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    {β : Fin n → ℤ} (hβ : β ∈ (Symplectic.rootDatum n F).roots)
    (s : StatedSp n F) (σ : F ≃+* F)
    (hyR : ((rootGroup n F β).map (MulAut.conj s * fieldSp n F σ).toMonoidHom) = rootGroup n F β)
    (hy : ∀ m ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
        Set (StatedSp n F)), (MulAut.conj s * fieldSp n F σ) m * m⁻¹ ∈
        pCoreOf 2 (Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
          Set (StatedSp n F))))
    {a : Fin n ⊕ Fin n → F} (ha : a ≠ 0) (hT : IsTransGroup a (rootGroup n F β))
    (t : StatedSp n F) (lam : Fˣ)
    (htv : mat n F t *ᵥ a = (lam : F) • a)
    (hfv : mat n F (fieldSp n F σ t) *ᵥ a = σ (lam : F) • a) :
    σ (lam : F) = (lam : F) := by
  have hN : Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) = CFSG.Timmesfeld.Transvection.ModelRank.spLine a :=
    CFSG.Timmesfeld.Transvection.ModelRank.normalizer_eq_spLine ha hT
  have htN : t ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) := by
    rw [hN]
    exact ⟨(lam : F), Units.ne_zero lam, htv⟩
  have hr_mem := hy t htN
  have hrv : mat n F (((MulAut.conj s * fieldSp n F σ) t) * t⁻¹) *ᵥ a = a :=
    l10ss1c_pCore_spLine_mulVec_eq_self ha hT hr_mem
  have hsN : s ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) := l10ss1c_conj_mem_normalizer hβ s σ hyR
  have hsv : ∃ ν : F, ν ≠ 0 ∧ mat n F s⁻¹ *ᵥ a = ν • a := by
    have h1 := inv_mem hsN
    rwa [hN] at h1
  have hfw : mat n F (fieldSp n F σ t) *ᵥ (mat n F s⁻¹ *ᵥ a) =
      σ (lam : F) • (mat n F s⁻¹ *ᵥ a) := by
    obtain ⟨ν, _, hν⟩ := hsv
    rw [hν, Matrix.mulVec_smul, hfv, smul_smul, smul_smul, mul_comm]
  exact l10ss1c_scalar_eq ha s t σ (lam : F) htv hfw hrv

private theorem l10ss1c_short {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    {β : Fin n → ℤ} (hβ : β ∈ (Symplectic.rootDatum n F).roots)
    (s : StatedSp n F) (σ : F ≃+* F)
    (hyR : ((rootGroup n F β).map (MulAut.conj s * fieldSp n F σ).toMonoidHom) = rootGroup n F β)
    (hy : ∀ m ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
        Set (StatedSp n F)), (MulAut.conj s * fieldSp n F σ) m * m⁻¹ ∈
        pCoreOf 2 (Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
          Set (StatedSp n F))))
    {a₁ a₂ b₁ b₂ : Fin n ⊕ Fin n → F} (hXeq : spAltSiegel n F a₁ a₂ = rootGroup n F β)
    (hp : SpPlanePair n F a₁ a₂ b₁ b₂)
    (hW : (spForm n F).IsTotallyIsotropic (Submodule.span F {a₁, a₂})) (ha₁ : a₁ ≠ 0)
    (t : StatedSp n F) (lam : Fˣ)
    (htW : ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F t *ᵥ w = (lam : F) • w)
    (htW_inv : ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F t⁻¹ *ᵥ w = ((lam : F)⁻¹) • w)
    (hftW : ∀ w ∈ Submodule.span F {a₁, a₂},
      mat n F (fieldSp n F σ t) *ᵥ w = σ (lam : F) • w) :
    σ (lam : F) = (lam : F) := by
  have hN : Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) = SymplecticFlag.stabilizer n F (Submodule.span F {a₁, a₂}) := by
    rw [← hXeq, normalizer_spAltSiegel_eq_stabilizer hp]
  have htN : t ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) := by
    rw [hN]
    refine SymplecticFlag.mem_stabilizer_of_mulVec_mem (fun v hv => ?_) (fun v hv => ?_)
    · change mat n F t *ᵥ v ∈ Submodule.span F {a₁, a₂}
      rw [htW v hv]; exact Submodule.smul_mem _ _ hv
    · change mat n F t⁻¹ *ᵥ v ∈ Submodule.span F {a₁, a₂}
      rw [htW_inv v hv]; exact Submodule.smul_mem _ _ hv
  have hr_mem := hy t htN
  have hr_sprad : ((MulAut.conj s * fieldSp n F σ) t) * t⁻¹ ∈
      sprad (Submodule.span F {a₁, a₂}) hW := by
    have hle : pCoreOf 2 (Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
        Set (StatedSp n F))) ≤ sprad (Submodule.span F {a₁, a₂}) hW := by
      rw [hN]; exact pCoreOf_stabilizer_le_sprad hp
    exact hle hr_mem
  have ha₁W : a₁ ∈ Submodule.span F {a₁, a₂} :=
    Submodule.mem_span_pair.mpr ⟨1, 0, by simp⟩
  have hrv : mat n F (((MulAut.conj s * fieldSp n F σ) t) * t⁻¹) *ᵥ a₁ = a₁ := by
    have hfix := (mem_rad.mp hr_sprad).1 a₁ ha₁W
    rw [natRep_apply] at hfix
    change ((↑(((MulAut.conj s * fieldSp n F σ) t) * t⁻¹) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ a₁ = a₁
    exact hfix
  have hsN : s ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
      Set (StatedSp n F)) := l10ss1c_conj_mem_normalizer hβ s σ hyR
  have hsW : mat n F s⁻¹ *ᵥ a₁ ∈ Submodule.span F {a₁, a₂} := by
    have h1 : s⁻¹ ∈ Subgroup.normalizer ((rootGroup n F β : Subgroup (StatedSp n F)) :
        Set (StatedSp n F)) := inv_mem hsN
    rw [hN] at h1
    have h2 := rep_mem_of_mem_stabilizer h1 ha₁W
    rw [natRep_apply] at h2
    change ((↑(s⁻¹) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ a₁ ∈ Submodule.span F {a₁, a₂}
    exact h2
  have hfw : mat n F (fieldSp n F σ t) *ᵥ (mat n F s⁻¹ *ᵥ a₁) =
      σ (lam : F) • (mat n F s⁻¹ *ᵥ a₁) := hftW _ hsW
  exact l10ss1c_scalar_eq ha₁ s t σ (lam : F) (htW a₁ ha₁W) hfw hrv

private theorem l10ss1_field_trivial {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    {β : Fin (Symplectic.rootDatum n F).rank → ℤ}
    (hβ : β ∈ (Symplectic.rootDatum n F).roots) (s : ↥(StatedSp n F)) (σ : F ≃+* F)
    (hyR : ((Symplectic.rootDatum n F).rootGroup β).map
        (MulAut.conj s * fieldSp n F σ).toMonoidHom = (Symplectic.rootDatum n F).rootGroup β)
    (hy : ∀ m ∈ Subgroup.normalizer
        (((Symplectic.rootDatum n F).rootGroup β : Subgroup ↥(StatedSp n F)) :
          Set ↥(StatedSp n F)),
      (MulAut.conj s * fieldSp n F σ) m * m⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer
        (((Symplectic.rootDatum n F).rootGroup β : Subgroup ↥(StatedSp n F)) :
          Set ↥(StatedSp n F)))) :
    σ = RingEquiv.refl F := by
  obtain ⟨r, hr⟩ := exists_stdVec_of_mem_roots hβ
  have hunits : ∀ lam : Fˣ, σ (lam : F) = (lam : F) := by
    intro lam
    cases r with
    | positiveLong i =>
        let a : Fin n ⊕ Fin n → F := Pi.single (Sum.inl i) 1
        have ha : a ≠ 0 := by
          intro h
          have h1 := congrFun h (Sum.inl i)
          simp [a] at h1
        have hT : IsTransGroup a (rootGroup n F β) := l10ss1c_isTransGroup_pos hr
        let t : StatedSp n F := diagSp F n (Pi.mulSingle i lam)
        have htv : mat n F t *ᵥ a = (lam : F) • a := by
          change mat n F (diagSp F n (Pi.mulSingle i lam)) *ᵥ Pi.single (Sum.inl i) 1 =
            (lam : F) • Pi.single (Sum.inl i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [diagSpEntry]
        have hfv : mat n F (fieldSp n F σ t) *ᵥ a = σ (lam : F) • a := by
          change mat n F (fieldSp n F σ (diagSp F n (Pi.mulSingle i lam))) *ᵥ
            Pi.single (Sum.inl i) 1 = σ (lam : F) • Pi.single (Sum.inl i) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [diagSpEntry]
        exact l10ss1c_long hβ s σ hyR hy ha hT t lam htv hfv
    | negativeLong i =>
        let a : Fin n ⊕ Fin n → F := Pi.single (Sum.inr i) 1
        have ha : a ≠ 0 := by
          intro h
          have h1 := congrFun h (Sum.inr i)
          simp [a] at h1
        have hT : IsTransGroup a (rootGroup n F β) := l10ss1c_isTransGroup_neg hr
        let t : StatedSp n F := diagSp F n (Pi.mulSingle i lam⁻¹)
        have htv : mat n F t *ᵥ a = (lam : F) • a := by
          change mat n F (diagSp F n (Pi.mulSingle i lam⁻¹)) *ᵥ Pi.single (Sum.inr i) 1 =
            (lam : F) • Pi.single (Sum.inr i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [diagSpEntry, inv_inv]
        have hfv : mat n F (fieldSp n F σ t) *ᵥ a = σ (lam : F) • a := by
          change mat n F (fieldSp n F σ (diagSp F n (Pi.mulSingle i lam⁻¹))) *ᵥ
            Pi.single (Sum.inr i) 1 = σ (lam : F) • Pi.single (Sum.inr i) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [diagSpEntry, inv_inv]
        exact l10ss1c_long hβ s σ hyR hy ha hT t lam htv hfv
    | difference i j hij =>
        let a₁ : Fin n ⊕ Fin n → F := Pi.single (Sum.inl i) 1
        let a₂ : Fin n ⊕ Fin n → F := Pi.single (Sum.inr j) 1
        let b₁ : Fin n ⊕ Fin n → F := Pi.single (Sum.inr i) 1
        let b₂ : Fin n ⊕ Fin n → F := Pi.single (Sum.inl j) 1
        have ha₁ : a₁ ≠ 0 := by
          intro h
          have h1 := congrFun h (Sum.inl i)
          simp [a₁] at h1
        have hE : Matrix.vecMulVec a₁ (spJ n F *ᵥ a₂) +
            Matrix.vecMulVec a₂ (spJ n F *ᵥ a₁) =
            E F (RootSubgroupIndex.difference i j hij) := by
          change Matrix.vecMulVec (Pi.single (Sum.inl i) 1)
              (spJ n F *ᵥ Pi.single (Sum.inr j) 1) +
            Matrix.vecMulVec (Pi.single (Sum.inr j) 1) (spJ n F *ᵥ Pi.single (Sum.inl i) 1) =
            Matrix.single (Sum.inl i) (Sum.inl j) 1 - Matrix.single (Sum.inr j) (Sum.inr i) 1
          rw [l10ss1c_spJ_mulVec_single, l10ss1c_spJ_mulVec_single,
            l10ss1c_vecMulVec_single, l10ss1c_vecMulVec_single]
          ext a b
          rw [Matrix.add_apply, Matrix.sub_apply, CharTwo.sub_eq_add]
          simp [Sum.swap_inl, Sum.swap_inr, Matrix.single_apply]
        have hXeq : spAltSiegel n F a₁ a₂ = rootGroup n F β :=
          l10ss1c_spAltSiegel_eq_rootGroup hr hE
        have hp : SpPlanePair n F a₁ a₂ b₁ b₂ := by
          simp only [SpPlanePair]
          refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_⟩⟩ <;>
            rw [l10ss1c_std_dot_J_single] <;>
            simp [a₁, a₂, b₁, b₂, hij, hij.symm]
        have hW : (spForm n F).IsTotallyIsotropic (Submodule.span F {a₁, a₂}) :=
          l10ss1c_isTotallyIsotropic_span_pair
            (by simp [a₁, l10ss1c_std_dot_J_single])
            (by simp [a₂, l10ss1c_std_dot_J_single])
            (by simp [a₁, a₂, l10ss1c_std_dot_J_single, hij, hij.symm])
            (by simp [a₁, a₂, l10ss1c_std_dot_J_single, hij, hij.symm])
        let tfun : Fin n → Fˣ := fun a => if a = i then lam else if a = j then lam⁻¹ else 1
        let t : StatedSp n F := diagSp F n tfun
        have htv₁ : mat n F t *ᵥ a₁ = (lam : F) • a₁ := by
          change mat n F (diagSp F n tfun) *ᵥ Pi.single (Sum.inl i) 1 =
            (lam : F) • Pi.single (Sum.inl i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij]
        have htv₂ : mat n F t *ᵥ a₂ = (lam : F) • a₂ := by
          change mat n F (diagSp F n tfun) *ᵥ Pi.single (Sum.inr j) 1 =
            (lam : F) • Pi.single (Sum.inr j) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij, hij.symm, inv_inv]
        have htW : ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F t *ᵥ w = (lam : F) • w :=
          l10ss1c_diagSp_scalar_on_span htv₁ htv₂
        have hfv₁ : mat n F (fieldSp n F σ t) *ᵥ a₁ = σ (lam : F) • a₁ := by
          change mat n F (fieldSp n F σ (diagSp F n tfun)) *ᵥ Pi.single (Sum.inl i) 1 =
            σ (lam : F) • Pi.single (Sum.inl i) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij]
        have hfv₂ : mat n F (fieldSp n F σ t) *ᵥ a₂ = σ (lam : F) • a₂ := by
          change mat n F (fieldSp n F σ (diagSp F n tfun)) *ᵥ Pi.single (Sum.inr j) 1 =
            σ (lam : F) • Pi.single (Sum.inr j) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij, hij.symm, inv_inv]
        have hftW : ∀ w ∈ Submodule.span F {a₁, a₂},
            mat n F (fieldSp n F σ t) *ᵥ w = σ (lam : F) • w :=
          l10ss1c_fieldSp_diagSp_scalar_on_span σ hfv₁ hfv₂
        have htv₁_inv : mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ a₁ =
            (lam : F)⁻¹ • a₁ := by
          change mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ Pi.single (Sum.inl i) 1 =
            (lam : F)⁻¹ • Pi.single (Sum.inl i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij]
        have htv₂_inv : mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ a₂ =
            (lam : F)⁻¹ • a₂ := by
          change mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ Pi.single (Sum.inr j) 1 =
            (lam : F)⁻¹ • Pi.single (Sum.inr j) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij, hij.symm, inv_inv]
        have htW_inv : ∀ w ∈ Submodule.span F {a₁, a₂},
            mat n F t⁻¹ *ᵥ w = ((lam : F)⁻¹) • w := by
          intro w hw
          change mat n F (diagSp F n tfun)⁻¹ *ᵥ w = ((lam : F)⁻¹) • w
          rw [← map_inv (diagSp F n) tfun]
          exact l10ss1c_diagSp_scalar_on_span htv₁_inv htv₂_inv w hw
        exact l10ss1c_short hβ s σ hyR hy hXeq hp hW ha₁ t lam htW htW_inv hftW
    | positiveSum i j hij =>
        let a₁ : Fin n ⊕ Fin n → F := Pi.single (Sum.inl i) 1
        let a₂ : Fin n ⊕ Fin n → F := Pi.single (Sum.inl j) 1
        let b₁ : Fin n ⊕ Fin n → F := Pi.single (Sum.inr i) 1
        let b₂ : Fin n ⊕ Fin n → F := Pi.single (Sum.inr j) 1
        have ha₁ : a₁ ≠ 0 := by
          intro h
          have h1 := congrFun h (Sum.inl i)
          simp [a₁] at h1
        have hE : Matrix.vecMulVec a₁ (spJ n F *ᵥ a₂) +
            Matrix.vecMulVec a₂ (spJ n F *ᵥ a₁) =
            E F (RootSubgroupIndex.positiveSum i j hij) := by
          change Matrix.vecMulVec (Pi.single (Sum.inl i) 1)
              (spJ n F *ᵥ Pi.single (Sum.inl j) 1) +
            Matrix.vecMulVec (Pi.single (Sum.inl j) 1) (spJ n F *ᵥ Pi.single (Sum.inl i) 1) =
            Matrix.single (Sum.inl i) (Sum.inr j) 1 + Matrix.single (Sum.inl j) (Sum.inr i) 1
          rw [l10ss1c_spJ_mulVec_single, l10ss1c_spJ_mulVec_single,
            l10ss1c_vecMulVec_single, l10ss1c_vecMulVec_single]
          simp [Sum.swap_inl, Sum.swap_inr]
        have hXeq : spAltSiegel n F a₁ a₂ = rootGroup n F β :=
          l10ss1c_spAltSiegel_eq_rootGroup hr hE
        have hp : SpPlanePair n F a₁ a₂ b₁ b₂ := by
          simp only [SpPlanePair]
          refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_⟩⟩ <;>
            rw [l10ss1c_std_dot_J_single] <;>
            simp [a₁, a₂, b₁, b₂, hij.ne, hij.ne']
        have hW : (spForm n F).IsTotallyIsotropic (Submodule.span F {a₁, a₂}) :=
          l10ss1c_isTotallyIsotropic_span_pair
            (by simp [a₁, l10ss1c_std_dot_J_single])
            (by simp [a₂, l10ss1c_std_dot_J_single])
            (by simp [a₁, a₂, l10ss1c_std_dot_J_single])
            (by simp [a₁, a₂, l10ss1c_std_dot_J_single])
        let tfun : Fin n → Fˣ := fun a => if a = i then lam else if a = j then lam else 1
        let t : StatedSp n F := diagSp F n tfun
        have htv₁ : mat n F t *ᵥ a₁ = (lam : F) • a₁ := by
          change mat n F (diagSp F n tfun) *ᵥ Pi.single (Sum.inl i) 1 =
            (lam : F) • Pi.single (Sum.inl i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne']
        have htv₂ : mat n F t *ᵥ a₂ = (lam : F) • a₂ := by
          change mat n F (diagSp F n tfun) *ᵥ Pi.single (Sum.inl j) 1 =
            (lam : F) • Pi.single (Sum.inl j) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne']
        have htW : ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F t *ᵥ w = (lam : F) • w :=
          l10ss1c_diagSp_scalar_on_span htv₁ htv₂
        have hfv₁ : mat n F (fieldSp n F σ t) *ᵥ a₁ = σ (lam : F) • a₁ := by
          change mat n F (fieldSp n F σ (diagSp F n tfun)) *ᵥ Pi.single (Sum.inl i) 1 =
            σ (lam : F) • Pi.single (Sum.inl i) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne']
        have hfv₂ : mat n F (fieldSp n F σ t) *ᵥ a₂ = σ (lam : F) • a₂ := by
          change mat n F (fieldSp n F σ (diagSp F n tfun)) *ᵥ Pi.single (Sum.inl j) 1 =
            σ (lam : F) • Pi.single (Sum.inl j) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne']
        have hftW : ∀ w ∈ Submodule.span F {a₁, a₂},
            mat n F (fieldSp n F σ t) *ᵥ w = σ (lam : F) • w :=
          l10ss1c_fieldSp_diagSp_scalar_on_span σ hfv₁ hfv₂
        have htv₁_inv : mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ a₁ =
            (lam : F)⁻¹ • a₁ := by
          change mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ Pi.single (Sum.inl i) 1 =
            (lam : F)⁻¹ • Pi.single (Sum.inl i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne']
        have htv₂_inv : mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ a₂ =
            (lam : F)⁻¹ • a₂ := by
          change mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ Pi.single (Sum.inl j) 1 =
            (lam : F)⁻¹ • Pi.single (Sum.inl j) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne']
        have htW_inv : ∀ w ∈ Submodule.span F {a₁, a₂},
            mat n F t⁻¹ *ᵥ w = ((lam : F)⁻¹) • w := by
          intro w hw
          change mat n F (diagSp F n tfun)⁻¹ *ᵥ w = ((lam : F)⁻¹) • w
          rw [← map_inv (diagSp F n) tfun]
          exact l10ss1c_diagSp_scalar_on_span htv₁_inv htv₂_inv w hw
        exact l10ss1c_short hβ s σ hyR hy hXeq hp hW ha₁ t lam htW htW_inv hftW
    | negativeSum i j hij =>
        let a₁ : Fin n ⊕ Fin n → F := Pi.single (Sum.inr i) 1
        let a₂ : Fin n ⊕ Fin n → F := Pi.single (Sum.inr j) 1
        let b₁ : Fin n ⊕ Fin n → F := Pi.single (Sum.inl i) 1
        let b₂ : Fin n ⊕ Fin n → F := Pi.single (Sum.inl j) 1
        have ha₁ : a₁ ≠ 0 := by
          intro h
          have h1 := congrFun h (Sum.inr i)
          simp [a₁] at h1
        have hE : Matrix.vecMulVec a₁ (spJ n F *ᵥ a₂) +
            Matrix.vecMulVec a₂ (spJ n F *ᵥ a₁) =
            E F (RootSubgroupIndex.negativeSum i j hij) := by
          change Matrix.vecMulVec (Pi.single (Sum.inr i) 1)
              (spJ n F *ᵥ Pi.single (Sum.inr j) 1) +
            Matrix.vecMulVec (Pi.single (Sum.inr j) 1) (spJ n F *ᵥ Pi.single (Sum.inr i) 1) =
            Matrix.single (Sum.inr i) (Sum.inl j) 1 + Matrix.single (Sum.inr j) (Sum.inl i) 1
          rw [l10ss1c_spJ_mulVec_single, l10ss1c_spJ_mulVec_single,
            l10ss1c_vecMulVec_single, l10ss1c_vecMulVec_single]
          simp [Sum.swap_inl, Sum.swap_inr]
        have hXeq : spAltSiegel n F a₁ a₂ = rootGroup n F β :=
          l10ss1c_spAltSiegel_eq_rootGroup hr hE
        have hp : SpPlanePair n F a₁ a₂ b₁ b₂ := by
          simp only [SpPlanePair]
          refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_⟩⟩ <;>
            rw [l10ss1c_std_dot_J_single] <;>
            simp [a₁, a₂, b₁, b₂, hij.ne, hij.ne']
        have hW : (spForm n F).IsTotallyIsotropic (Submodule.span F {a₁, a₂}) :=
          l10ss1c_isTotallyIsotropic_span_pair
            (by simp [a₁, l10ss1c_std_dot_J_single])
            (by simp [a₂, l10ss1c_std_dot_J_single])
            (by simp [a₁, a₂, l10ss1c_std_dot_J_single])
            (by simp [a₁, a₂, l10ss1c_std_dot_J_single])
        let tfun : Fin n → Fˣ := fun a => if a = i then lam⁻¹ else if a = j then lam⁻¹ else 1
        let t : StatedSp n F := diagSp F n tfun
        have htv₁ : mat n F t *ᵥ a₁ = (lam : F) • a₁ := by
          change mat n F (diagSp F n tfun) *ᵥ Pi.single (Sum.inr i) 1 =
            (lam : F) • Pi.single (Sum.inr i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne', inv_inv]
        have htv₂ : mat n F t *ᵥ a₂ = (lam : F) • a₂ := by
          change mat n F (diagSp F n tfun) *ᵥ Pi.single (Sum.inr j) 1 =
            (lam : F) • Pi.single (Sum.inr j) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne', inv_inv]
        have htW : ∀ w ∈ Submodule.span F {a₁, a₂}, mat n F t *ᵥ w = (lam : F) • w :=
          l10ss1c_diagSp_scalar_on_span htv₁ htv₂
        have hfv₁ : mat n F (fieldSp n F σ t) *ᵥ a₁ = σ (lam : F) • a₁ := by
          change mat n F (fieldSp n F σ (diagSp F n tfun)) *ᵥ Pi.single (Sum.inr i) 1 =
            σ (lam : F) • Pi.single (Sum.inr i) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne', inv_inv, map_inv₀]
        have hfv₂ : mat n F (fieldSp n F σ t) *ᵥ a₂ = σ (lam : F) • a₂ := by
          change mat n F (fieldSp n F σ (diagSp F n tfun)) *ᵥ Pi.single (Sum.inr j) 1 =
            σ (lam : F) • Pi.single (Sum.inr j) 1
          rw [l10ss1c_fieldSp_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne', inv_inv, map_inv₀]
        have hftW : ∀ w ∈ Submodule.span F {a₁, a₂},
            mat n F (fieldSp n F σ t) *ᵥ w = σ (lam : F) • w :=
          l10ss1c_fieldSp_diagSp_scalar_on_span σ hfv₁ hfv₂
        have htv₁_inv : mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ a₁ =
            (lam : F)⁻¹ • a₁ := by
          change mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ Pi.single (Sum.inr i) 1 =
            (lam : F)⁻¹ • Pi.single (Sum.inr i) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne', inv_inv]
        have htv₂_inv : mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ a₂ =
            (lam : F)⁻¹ • a₂ := by
          change mat n F (diagSp F n (fun a => (tfun a)⁻¹)) *ᵥ Pi.single (Sum.inr j) 1 =
            (lam : F)⁻¹ • Pi.single (Sum.inr j) 1
          rw [l10ss1c_diagSp_mulVec_single]
          congr 1
          simp [tfun, diagSpEntry, hij.ne', inv_inv]
        have htW_inv : ∀ w ∈ Submodule.span F {a₁, a₂},
            mat n F t⁻¹ *ᵥ w = ((lam : F)⁻¹) • w := by
          intro w hw
          change mat n F (diagSp F n tfun)⁻¹ *ᵥ w = ((lam : F)⁻¹) • w
          rw [← map_inv (diagSp F n) tfun]
          exact l10ss1c_diagSp_scalar_on_span htv₁_inv htv₂_inv w hw
        exact l10ss1c_short hβ s σ hyR hy hXeq hp hW ha₁ t lam htW htW_inv hftW
  refine RingEquiv.ext fun c => ?_
  by_cases hc : c = 0
  · rw [hc, map_zero]
    rfl
  · have h1 := hunits (Units.mk0 c hc)
    simpa using h1

private theorem l10ss1_rank_single_one_eq_one {F : Type} [Field F] {ι : Type} [Fintype ι]
    [DecidableEq ι] (i j : ι) : (Matrix.single i j (1 : F)).rank = 1 := by
  have hsub := Matrix.rank_submatrix_le (Matrix.single i j (1 : F))
    (fun _ : Fin 1 => i) (fun _ : Fin 1 => j)
  have h1 : (Matrix.single i j (1 : F)).submatrix
      (fun _ : Fin 1 => i) (fun _ : Fin 1 => j) = 1 := by
    ext a b
    fin_cases a; fin_cases b
    simp [Matrix.single_apply]
  rw [h1, Matrix.rank_one] at hsub
  simp only [Fintype.card_fin, Finset.univ_unique, Finset.card_singleton] at hsub
  have hle : (Matrix.single i j (1 : F)).rank ≤ 1 := by
    rw [Matrix.single_eq_single_vecMulVec_single]
    exact Matrix.rank_vecMulVec_le _ _
  exact le_antisymm hle hsub

private theorem l10ss1_rank_sub_ge_two {F : Type} [Field F] {ι : Type} [Fintype ι]
    [DecidableEq ι] (i j k l : ι) (hik : i ≠ k) (hjl : j ≠ l) :
    2 ≤ (Matrix.single i j (1 : F) - Matrix.single k l (1 : F)).rank := by
  have hsub := Matrix.rank_submatrix_le
    (Matrix.single i j (1 : F) - Matrix.single k l (1 : F))
    (fun a : Fin 2 => if a = 0 then i else k) (fun a : Fin 2 => if a = 0 then j else l)
  have hM : (Matrix.single i j (1 : F) - Matrix.single k l (1 : F)).submatrix
      (fun a : Fin 2 => if a = 0 then i else k)
      (fun a : Fin 2 => if a = 0 then j else l) = !![(1 : F), 0; 0, -1] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [Matrix.single_apply, hik, hjl, hik.symm, hjl.symm]
  rw [hM] at hsub
  have hunit : IsUnit (!![(1 : F), 0; 0, -1] : Matrix (Fin 2) (Fin 2) F) := by
    rw [Matrix.isUnit_iff_isUnit_det]
    simp [Matrix.det_fin_two, isUnit_neg_one]
  have hrank : (!![(1 : F), 0; 0, -1] : Matrix (Fin 2) (Fin 2) F).rank = 2 := by
    rw [Matrix.rank_of_isUnit _ hunit]
    simp
  rw [hrank] at hsub
  exact hsub

private theorem l10ss1_rank_add_ge_two {F : Type} [Field F] {ι : Type} [Fintype ι]
    [DecidableEq ι] (i j k l : ι) (hik : i ≠ k) (hjl : j ≠ l) :
    2 ≤ (Matrix.single i j (1 : F) + Matrix.single k l (1 : F)).rank := by
  have hsub := Matrix.rank_submatrix_le
    (Matrix.single i j (1 : F) + Matrix.single k l (1 : F))
    (fun a : Fin 2 => if a = 0 then i else k) (fun a : Fin 2 => if a = 0 then j else l)
  have hM : (Matrix.single i j (1 : F) + Matrix.single k l (1 : F)).submatrix
      (fun a : Fin 2 => if a = 0 then i else k)
      (fun a : Fin 2 => if a = 0 then j else l) = !![(1 : F), 0; 0, 1] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [Matrix.single_apply, hik, hjl, hik.symm, hjl.symm]
  rw [hM] at hsub
  have hunit : IsUnit (!![(1 : F), 0; 0, 1] : Matrix (Fin 2) (Fin 2) F) := by
    rw [Matrix.isUnit_iff_isUnit_det]
    simp [Matrix.det_fin_two]
  have hrank : (!![(1 : F), 0; 0, 1] : Matrix (Fin 2) (Fin 2) F).rank = 2 := by
    rw [Matrix.rank_of_isUnit _ hunit]
    simp
  rw [hrank] at hsub
  exact hsub

private def l10ss1_IsLongIdx : RootSubgroupIndex 2 → Prop
  | .positiveLong _ => True
  | .negativeLong _ => True
  | _ => False

private theorem l10ss1_rank_E_eq_one_of_long {F : Type} [Field F] {r : RootSubgroupIndex 2}
    (h : l10ss1_IsLongIdx r) : (E F r).rank = 1 := by
  cases r with
  | positiveLong i => exact l10ss1_rank_single_one_eq_one (Sum.inl i) (Sum.inr i)
  | negativeLong i => exact l10ss1_rank_single_one_eq_one (Sum.inr i) (Sum.inl i)
  | difference i j hij => exact h.elim
  | positiveSum i j hij => exact h.elim
  | negativeSum i j hij => exact h.elim

private theorem l10ss1_rank_E_ge_two_of_short {F : Type} [Field F] {r : RootSubgroupIndex 2}
    (h : ¬ l10ss1_IsLongIdx r) : 2 ≤ (E F r).rank := by
  cases r with
  | positiveLong i => exact absurd trivial h
  | negativeLong i => exact absurd trivial h
  | difference i j hij =>
      exact l10ss1_rank_sub_ge_two (Sum.inl i) (Sum.inl j) (Sum.inr j) (Sum.inr i)
        (by simp) (by simp)
  | positiveSum i j hij =>
      exact l10ss1_rank_add_ge_two (Sum.inl i) (Sum.inr j) (Sum.inl j) (Sum.inr i)
        (by simp [hij.ne]) (by simp [hij.ne'])
  | negativeSum i j hij =>
      exact l10ss1_rank_add_ge_two (Sum.inr i) (Sum.inl j) (Sum.inr j) (Sum.inl i)
        (by simp [hij.ne]) (by simp [hij.ne'])

private theorem l10ss1_isLongIdx_tauIdx_flip (r : RootSubgroupIndex 2) :
    l10ss1_IsLongIdx (CFSG.SeitzReduction.F4Pilot.tauIdx r) ↔ ¬ l10ss1_IsLongIdx r := by
  cases r with
  | positiveLong i => fin_cases i <;> simp [CFSG.SeitzReduction.F4Pilot.tauIdx, l10ss1_IsLongIdx]
  | negativeLong i => fin_cases i <;> simp [CFSG.SeitzReduction.F4Pilot.tauIdx, l10ss1_IsLongIdx]
  | difference i j hij =>
      fin_cases i <;> fin_cases j <;>
        simp_all [CFSG.SeitzReduction.F4Pilot.tauIdx, l10ss1_IsLongIdx]
  | positiveSum i j hij => simp [CFSG.SeitzReduction.F4Pilot.tauIdx, l10ss1_IsLongIdx]
  | negativeSum i j hij => simp [CFSG.SeitzReduction.F4Pilot.tauIdx, l10ss1_IsLongIdx]

private theorem l10ss1_rank_E_tauIdx_ne {F : Type} [Field F] (r : RootSubgroupIndex 2) :
    (E F r).rank ≠ (E F (CFSG.SeitzReduction.F4Pilot.tauIdx r)).rank := by
  intro h
  by_cases hr : l10ss1_IsLongIdx r
  · have h1 : (E F r).rank = 1 := l10ss1_rank_E_eq_one_of_long hr
    have hn : ¬ l10ss1_IsLongIdx (CFSG.SeitzReduction.F4Pilot.tauIdx r) :=
      fun hlt => (l10ss1_isLongIdx_tauIdx_flip r).mp hlt hr
    have h2 : 2 ≤ (E F (CFSG.SeitzReduction.F4Pilot.tauIdx r)).rank :=
      l10ss1_rank_E_ge_two_of_short hn
    omega
  · have h1 : 2 ≤ (E F r).rank := l10ss1_rank_E_ge_two_of_short hr
    have hl : l10ss1_IsLongIdx (CFSG.SeitzReduction.F4Pilot.tauIdx r) :=
      (l10ss1_isLongIdx_tauIdx_flip r).mpr hr
    have h2 : (E F (CFSG.SeitzReduction.F4Pilot.tauIdx r)).rank = 1 :=
      l10ss1_rank_E_eq_one_of_long hl
    omega

private theorem l10ss1_no_graph {F : Type} [Field F] [CharP F 2]
    {β : Fin (Symplectic.rootDatum 2 F).rank → ℤ} (hβ : β ∈ (Symplectic.rootDatum 2 F).roots)
    (y : MulAut ↥(StatedSp 2 F)) (s : ↥(StatedSp 2 F)) (σ : F ≃+* F)
    (hy : ∀ g, y g = s * fieldSp 2 F σ (CFSG.QuasithinUnique.Lin2.Five.tauSp g) * s⁻¹) :
    ((Symplectic.rootDatum 2 F).rootGroup β).map y.toMonoidHom ≠
      (Symplectic.rootDatum 2 F).rootGroup β := by
  intro h
  obtain ⟨r, hr⟩ := exists_stdVec_of_mem_roots hβ
  have hxmem : elt r (1 : F) ∈ (Symplectic.rootDatum 2 F).rootGroup β := by
    change elt r (1 : F) ∈ rootGroup 2 F β
    exact (mem_rootGroup_iff (n := 2) (F := F) hr).2 ⟨1, rfl⟩
  have hxmem' : y (elt r (1 : F)) ∈ (Symplectic.rootDatum 2 F).rootGroup β := by
    have := Subgroup.mem_map_of_mem y.toMonoidHom hxmem
    rwa [h] at this
  obtain ⟨d, hd⟩ := (mem_rootGroup_iff (n := 2) (F := F) hr).1 hxmem'
  have hfield : fieldSp 2 F σ (elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F)) =
      elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F) := by
    rw [CFSG.SeitzReduction.F4Pilot.fieldSp_elt, map_one]
  have hy1 : y (elt r (1 : F)) =
      s * elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F) * s⁻¹ := by
    rw [hy, CFSG.SeitzReduction.F4Pilot.tauSp_elt]
    simp only [one_pow, hfield]
  have helt : elt r d = s * elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F) * s⁻¹ :=
    hd.symm.trans hy1
  have hmatEq : (1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) F) + d • E F r =
      mat 2 F s * (1 + E F (CFSG.SeitzReduction.F4Pilot.tauIdx r)) * mat 2 F s⁻¹ := by
    rw [← mat_elt r d, helt]
    simp only [map_mul, mat_elt, one_smul]
  have hmul : mat 2 F s * mat 2 F s⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel, map_one]
  have hEeq : d • E F r =
      mat 2 F s * E F (CFSG.SeitzReduction.F4Pilot.tauIdx r) * mat 2 F s⁻¹ := by
    have h' := hmatEq
    simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_one, hmul] at h'
    exact add_left_cancel h'
  have hdet : IsUnit (mat 2 F s).det := by
    rw [mat_apply]
    exact (Matrix.isUnit_iff_isUnit_det _).mp (Units.isUnit _)
  have hdet' : IsUnit (mat 2 F s⁻¹).det := by
    rw [mat_apply]
    exact (Matrix.isUnit_iff_isUnit_det _).mp (Units.isUnit _)
  have hrank : (d • E F r).rank =
      (E F (CFSG.SeitzReduction.F4Pilot.tauIdx r)).rank := by
    rw [hEeq]
    rw [Matrix.rank_mul_eq_left_of_isUnit_det _ _ hdet',
        Matrix.rank_mul_eq_right_of_isUnit_det _ _ hdet]
  have helt_ne : elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F) ≠ 1 := by
    intro h1
    exact one_ne_zero (elt_injective (F := F) (CFSG.SeitzReduction.F4Pilot.tauIdx r)
      (by rw [h1, elt_zero]))
  have hconj : s * elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F) * s⁻¹ ≠ 1 := by
    intro hc
    have hx : elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F) = 1 := by
      have h2 : (MulAut.conj s) (elt (CFSG.SeitzReduction.F4Pilot.tauIdx r) (1 : F)) =
          (MulAut.conj s) 1 := by
        simpa [MulAut.conj_apply] using hc
      exact (MulAut.conj s).injective h2
    exact helt_ne hx
  have hd0 : d ≠ 0 := by
    intro h0
    exact hconj (by rw [← helt, h0, elt_zero])
  have hdmem : d ∈ nonZeroDivisors F := by
    rw [mem_nonZeroDivisors_iff_ne_zero]
    exact hd0
  have hrank' : (E F r).rank = (E F (CFSG.SeitzReduction.F4Pilot.tauIdx r)).rank := by
    rw [← Matrix.rank_smul_of_mem_nonZeroDivisors (E F r) hdmem]
    exact hrank
  exact l10ss1_rank_E_tauIdx_ne r hrank'

theorem ggRootNormInner_sp {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2] (hn : 2 ≤ n)
    {β : Fin (Symplectic.rootDatum n F).rank → ℤ} (hβ : β ∈ (Symplectic.rootDatum n F).roots)
    (u : ↥(StatedSp n F)) :
    GGRootNormInner (((Symplectic.rootDatum n F).rootGroup β).map (MulAut.conj u).toMonoidHom) := by
  have h0 : GGRootNormInner ((Symplectic.rootDatum n F).rootGroup β) := by
    intro y hy2 hyR hymod
    rcases lt_or_ge n 3 with hlt | hge
    · have hn2 : n = 2 := by omega
      subst n
      obtain ⟨s, σ, hf | hg⟩ := CFSG.Quasithin.Background.Harris.AutBorel.exists_form y
      · have hyA : y = MulAut.conj s * fieldSp 2 F σ := by
          refine MulEquiv.ext fun g => ?_
          rw [hf g]
          simp [MulAut.conj_apply]
        have hyR' : (((Symplectic.rootDatum 2 F).rootGroup β).map
            (MulAut.conj s * fieldSp 2 F σ).toMonoidHom) =
            (Symplectic.rootDatum 2 F).rootGroup β := by
          rw [← hyA]; exact hyR
        have hymod' : ∀ m ∈ Subgroup.normalizer
            (((Symplectic.rootDatum 2 F).rootGroup β : Subgroup ↥(StatedSp 2 F)) :
              Set ↥(StatedSp 2 F)),
            (MulAut.conj s * fieldSp 2 F σ) m * m⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer
              (((Symplectic.rootDatum 2 F).rootGroup β : Subgroup ↥(StatedSp 2 F)) :
                Set ↥(StatedSp 2 F))) := by
          intro m hm
          rw [← hyA]; exact hymod m hm
        have hσ := l10ss1_field_trivial (n := 2) hβ s σ hyR' hymod'
        have hσ' : fieldSp 2 F σ = 1 := by rw [hσ]; exact map_one (fieldSp 2 F)
        refine ⟨s, ?_⟩
        rw [hyA, hσ', mul_one]
      · exact absurd hyR (l10ss1_no_graph hβ y s σ hg)
    · obtain ⟨s, σ, hyA⟩ :=
        CFSG.SeitzReduction.SymplecticPilot.exists_eq_conj_mul_fieldSp (r := n) (K := F)
          (by omega) y
      have hyR' : (((Symplectic.rootDatum n F).rootGroup β).map
          (MulAut.conj s * fieldSp n F σ).toMonoidHom) =
          (Symplectic.rootDatum n F).rootGroup β := by
        rw [← hyA]; exact hyR
      have hymod' : ∀ m ∈ Subgroup.normalizer
          (((Symplectic.rootDatum n F).rootGroup β : Subgroup ↥(StatedSp n F)) :
            Set ↥(StatedSp n F)),
          (MulAut.conj s * fieldSp n F σ) m * m⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer
            (((Symplectic.rootDatum n F).rootGroup β : Subgroup ↥(StatedSp n F)) :
              Set ↥(StatedSp n F))) := by
        intro m hm
        rw [← hyA]; exact hymod m hm
      have hσ := l10ss1_field_trivial hβ s σ hyR' hymod'
      have hσ' : fieldSp n F σ = 1 := by rw [hσ]; exact map_one (fieldSp n F)
      refine ⟨s, ?_⟩
      rw [hyA, hσ', mul_one]
  exact l10ss1_inner_map_mulEquiv (MulAut.conj u) h0

end CFSG.StandardType.LieKnownR2.PSp
