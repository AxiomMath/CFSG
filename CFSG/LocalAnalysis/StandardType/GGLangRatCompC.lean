theorem langRatComp_of_component_of_ne_G2
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ}
    (S : LangSetup τ L p₀) (hτ : τ ≠ .G2) (hp : p.Prime) (hpL : (p : L) ≠ 0)
    {K : Type} [Field K] [Finite K]
    (ι : ↥(adjointGroup τ K) →* ModGL τ L) (hι : Function.Injective ι) (hrange : ι.range = S.Γ)
    {a : ↥(adjointGroup τ K)} {a' : Fin τ.rank → Lˣ} (hιa : ι a = rootDiagUnit τ a')
    (hT : rootDiagUnit τ a' ∈ S.D.torus) (hap : ∀ i, a' i ^ p = 1) (ha1 : a ≠ 1)
    {X : Subgroup ↥(adjointGroup τ K)} (hX : IsComponentOf X (Subgroup.centralizer {a})) :
    ∃ i : KernelComponent (rootCharHom a'),
      CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a') i) ∧
        X.map ι = rationalComponent S.ρ S.Γ (rootCharHom a') i := by
  have hsmall : τ = .G2 → 5 ≤ p ∨ 4 ≤ S.D.q := fun h => absurd h hτ
  have h1 : rootDiagUnit τ a' ≠ 1 := by
    intro h
    apply ha1
    apply hι
    rw [hιa, h, map_one]
  have hTame := langSetup_hTame_of_prime S hp hpL hsmall hT hap h1
  have hβ : ∀ c, ι (MulAut.conj a c) = rootDiagUnit τ a' * ι c * (rootDiagUnit τ a')⁻¹ := by
    intro c
    rw [MulAut.conj_apply, map_mul, map_mul, map_inv, hιa]
  have hfix : fixSubgroup (MulAut.conj a) = Subgroup.centralizer {a} := by
    ext x
    rw [mem_fixSubgroup, Subgroup.mem_centralizer_singleton_iff, MulAut.conj_apply]
    constructor
    · intro h
      calc x * a = a * x * a⁻¹ * a := by rw [h]
        _ = a * x := inv_mul_cancel_right _ _
    · intro h
      rw [← h, mul_inv_cancel_right]
  rw [← hfix] at hX
  exact components_of_langSetup S hp ι hι hrange (MulAut.conj a) hβ hT hap h1 hTame hX

theorem langRatComp_of_component
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ}
    (S : LangSetup τ L p₀) (hτ : τ = .E7 ∨ τ = .E8) (hp : p.Prime) (hpL : (p : L) ≠ 0)
    {K : Type} [Field K] [Finite K]
    (ι : ↥(adjointGroup τ K) →* ModGL τ L) (hι : Function.Injective ι) (hrange : ι.range = S.Γ)
    {a : ↥(adjointGroup τ K)} {a' : Fin τ.rank → Lˣ} (hιa : ι a = rootDiagUnit τ a')
    (hT : rootDiagUnit τ a' ∈ S.D.torus) (hap : ∀ i, a' i ^ p = 1) (ha1 : a ≠ 1)
    {X : Subgroup ↥(adjointGroup τ K)} (hX : IsComponentOf X (Subgroup.centralizer {a})) :
    ∃ i : KernelComponent (rootCharHom a'),
      CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a') i) ∧
        X.map ι = rationalComponent S.ρ S.Γ (rootCharHom a') i :=
  langRatComp_of_component_of_ne_G2 S (by rcases hτ with rfl | rfl <;> simp) hp hpL ι hι hrange hιa
    hT hap ha1 hX

end CFSG.StandardType.LangRat
