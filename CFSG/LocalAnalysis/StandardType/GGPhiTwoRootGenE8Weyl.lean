@[expose] def e8D4Char : Multiplicative (Fin Tag.E8.rank → ℤ) →* ℤˣ × ℤˣ :=
  (maskChar (τ := .E8) e8BitsD8).prod
    (maskChar (τ := .E8) (listMask [false, false, false, false, false, true, false, false]))

theorem mem_kernelRoots_e8D4Char {γ : Fin Tag.E8.rank → ℤ} :
    γ ∈ kernelRoots e8D4Char ↔ IsRoot .E8 γ ∧ Even (γ (e8Node 0)) ∧ Even (γ (e8Node 5)) := by
  have h5 : maskPairing (listMask (τ := .E8)
      [false, false, false, false, false, true, false, false]) γ = γ (e8Node 5) := by
    rw [maskPairing]
    change (∑ j : Fin 8,
      if listMask (τ := .E8)
        [false, false, false, false, false, true, false, false] j = true then γ j else 0) =
      γ (e8Node 5)
    rw [Fin.sum_univ_eight]
    simp [listMask, e8Node]
  have h0 : maskPairing (τ := .E8) e8BitsD8 γ = γ (e8Node 0) :=
    maskPairing_e8BitsD8 γ
  have hmem : γ ∈ kernelRoots e8D4Char ↔
      γ ∈ kernelRoots (maskChar (τ := .E8) e8BitsD8) ∧
        γ ∈ kernelRoots (maskChar (τ := .E8) (listMask
          [false, false, false, false, false, true, false, false])) := by
    rw [e8D4Char, kernelRoots, Set.mem_ofPred_eq, MonoidHom.prod_apply, Prod.mk_eq_one]
    constructor
    · rintro ⟨hI, he1, he2⟩
      rw [maskChar_apply, neg_one_zpow_eq_one_iff] at he1 he2
      exact ⟨mem_kernelRoots_maskChar.2 ⟨hI, he1⟩,
        mem_kernelRoots_maskChar.2 ⟨hI, he2⟩⟩
    · rintro ⟨h1, h2⟩
      rw [mem_kernelRoots_maskChar] at h1 h2
      refine ⟨h1.1, ?_, ?_⟩
      · rw [maskChar_apply, neg_one_zpow_eq_one_iff]
        exact h1.2
      · rw [maskChar_apply, neg_one_zpow_eq_one_iff]
        exact h2.2
  rw [hmem]
  simp only [mem_kernelRoots_maskChar, h0, h5]
  tauto

private theorem e8Neg_eq_prod_rootReflection :
    e8Neg = (([0, 1, 2, 3, 4, 5, 6, 7] : List (Fin 8)).map
      fun i => rootReflection (frameE8Root i)).prod := by
  refine ext_single fun i => ?_
  rw [e8Neg_smul]
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_smul, one_smul]
  rw [rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 0)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 1)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 2)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 3)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 4)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 5)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 6)),
    rootReflection_smul (mem_rootFinset.1 (frameE8Root_mem 7))]
  ext j
  revert i j
  decide

theorem e8Neg_mem_closure_rootReflection_kernelRoots_e8D4Char :
    e8Neg ∈ Subgroup.closure ((fun α => rootReflection α) '' kernelRoots e8D4Char) := by
  have hpar : ∀ i : Fin 8, Even (frameE8Root i (e8Node 0)) ∧
      Even (frameE8Root i (e8Node 5)) := by
    decide +kernel
  rw [e8Neg_eq_prod_rootReflection]
  refine Subgroup.list_prod_mem _ ?_
  intro x hx
  obtain ⟨i, -, rfl⟩ := List.mem_map.1 hx
  refine Subgroup.subset_closure ⟨frameE8Root i, ?_, rfl⟩
  rw [mem_kernelRoots_e8D4Char]
  exact ⟨mem_rootFinset.1 (frameE8Root_mem i), (hpar i).1, (hpar i).2⟩

theorem e8Neg_mem_closure_rootReflection_kernelRoots_e8BitsD8 :
    e8Neg ∈ Subgroup.closure ((fun α => rootReflection α) ''
      kernelRoots (maskChar (τ := .E8) e8BitsD8)) := by
  have hsub : kernelRoots e8D4Char ⊆
      kernelRoots (maskChar (τ := .E8) e8BitsD8) := by
    intro γ hγ
    rw [mem_kernelRoots_e8D4Char] at hγ
    rw [mem_kernelRoots_maskChar, maskPairing_e8BitsD8]
    exact ⟨hγ.1, hγ.2.1⟩
  exact Subgroup.closure_mono
    (Set.image_mono (f := fun α => rootReflection α) hsub)
    e8Neg_mem_closure_rootReflection_kernelRoots_e8D4Char

section WordMatrices


private theorem e8Cover_wordTwo_apply_zero (δ : Fin Tag.E8.rank → ℤ) :
    (((coxeterSystem .E8).wordProd
      [0, 2, 3, 1, 4, 3, 2, 0, 5, 4, 3, 1, 2, 3, 4, 5]) • δ) (e8Node 0) =
      -δ (e8Node 5) + 2 * δ (e8Node 6) := by
  rw [wordProd_smul_eq_wordMat_mulVec, Matrix.mulVec_apply_eq_sum]
  change (∑ j : Fin 8, (fun k : Fin 8 => wordMat Tag.E8
      [0, 2, 3, 1, 4, 3, 2, 0, 5, 4, 3, 1, 2, 3, 4, 5] (e8Node 0) k) j *
        (fun k : Fin 8 => δ k) j) = -δ (e8Node 5) + 2 * δ (e8Node 6)
  have hrow : (fun j : Fin 8 => wordMat Tag.E8
      [0, 2, 3, 1, 4, 3, 2, 0, 5, 4, 3, 1, 2, 3, 4, 5] (e8Node 0) j) =
      ![0, 0, 0, 0, 0, -1, 2, 0] := by
    decide +kernel
  rw [hrow, Fin.sum_univ_eight]
  simp [e8Node]

private theorem e8Cover_wordThree_apply_zero (δ : Fin Tag.E8.rank → ℤ) :
    (((coxeterSystem .E8).wordProd [0, 2, 3, 1, 4, 3, 2, 0]) • δ) (e8Node 0) =
      -δ (e8Node 0) + δ (e8Node 5) := by
  rw [wordProd_smul_eq_wordMat_mulVec, Matrix.mulVec_apply_eq_sum]
  change (∑ j : Fin 8, (fun k : Fin 8 => wordMat Tag.E8
      [0, 2, 3, 1, 4, 3, 2, 0] (e8Node 0) k) j * (fun k : Fin 8 => δ k) j) =
      -δ (e8Node 0) + δ (e8Node 5)
  have hrow : (fun j : Fin 8 => wordMat Tag.E8
      [0, 2, 3, 1, 4, 3, 2, 0] (e8Node 0) j) = ![-1, 0, 0, 0, 0, 1, 0, 0] := by
    decide +kernel
  rw [hrow, Fin.sum_univ_eight]
  simp [e8Node]

end WordMatrices

theorem exists_D8_cover_E8
    {γ : Fin Tag.E8.rank → ℤ} (hγ : IsRoot .E8 γ) :
    ∃ (v : WeylGroup .E8) (S : Set (Fin Tag.E8.rank → ℤ)), γ ∈ S ∧ kernelRoots e8D4Char ⊆ S ∧
      ∀ δ ∈ S, IsRoot .E8 δ ∧ Even ((v⁻¹ • δ) (e8Node 0)) := by
  by_cases h0 : Even (γ (e8Node 0))
  · refine ⟨1, {δ : Fin Tag.E8.rank → ℤ | IsRoot .E8 δ ∧ Even (δ (e8Node 0))},
      ⟨hγ, h0⟩, ?_, ?_⟩
    · intro δ hδ
      rw [mem_kernelRoots_e8D4Char] at hδ
      exact ⟨hδ.1, hδ.2.1⟩
    · intro δ hδ
      exact ⟨hδ.1, by simpa using hδ.2⟩
  · by_cases h5 : Even (γ (e8Node 5))
    · refine ⟨((coxeterSystem .E8).wordProd
          [0, 2, 3, 1, 4, 3, 2, 0, 5, 4, 3, 1, 2, 3, 4, 5])⁻¹,
        {δ : Fin Tag.E8.rank → ℤ | IsRoot .E8 δ ∧ Even (δ (e8Node 5))},
        ⟨hγ, h5⟩, ?_, ?_⟩
      · intro δ hδ
        rw [mem_kernelRoots_e8D4Char] at hδ
        exact ⟨hδ.1, hδ.2.2⟩
      · intro δ hδ
        refine ⟨hδ.1, ?_⟩
        rw [inv_inv, e8Cover_wordTwo_apply_zero]
        exact Even.add hδ.2.neg (even_two_mul (δ (e8Node 6)))
    · refine ⟨((coxeterSystem .E8).wordProd [0, 2, 3, 1, 4, 3, 2, 0])⁻¹,
        {δ : Fin Tag.E8.rank → ℤ | IsRoot .E8 δ ∧
          Even (δ (e8Node 0) + δ (e8Node 5))},
        ⟨hγ, ?_⟩, ?_, ?_⟩
      · refine Int.even_add.mpr ⟨?_, ?_⟩
        · intro h0'; exact (h0 h0').elim
        · intro h5'; exact (h5 h5').elim
      · intro δ hδ
        rw [mem_kernelRoots_e8D4Char] at hδ
        exact ⟨hδ.1, Even.add hδ.2.1 hδ.2.2⟩
      · intro δ hδ
        refine ⟨hδ.1, ?_⟩
        rw [inv_inv, e8Cover_wordThree_apply_zero]
        have hsub : Even (δ (e8Node 5) - δ (e8Node 0)) :=
          Int.even_sub.mpr (Int.even_add.mp hδ.2).symm
        simpa [sub_eq_add_neg, add_comm] using hsub

