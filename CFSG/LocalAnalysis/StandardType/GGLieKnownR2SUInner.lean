private theorem l10su1_innerZ_map_mulEquiv {K K' : Type*} [Group K] [Group K'] (e : K ≃* K')
    {R : Subgroup K} (h : PSL.GGRootNormInnerZ R) : PSL.GGRootNormInnerZ (R.map e.toMonoidHom) := by
  intro y' hy'2 hy'R hy'mod
  set y : MulAut K := (MulAut.congr e).symm y' with hy_def
  have hycongr : MulAut.congr e y = y' := by
    rw [hy_def]; exact MulEquiv.apply_symm_apply _ _
  have hyapply : ∀ x : K, y' (e x) = e (y x) := by
    intro x
    rw [← hycongr]
    change e (y (e.symm (e x))) = e (y x)
    simp
  have hy2 : ∃ k : ℕ, y ^ 2 ^ k = 1 := by
    obtain ⟨k, hk⟩ := hy'2
    refine ⟨k, ?_⟩
    have hh := congrArg ((MulAut.congr e).symm) hk
    rw [map_pow, map_one] at hh
    simpa [hy_def] using hh
  have hyR : R.map y.toMonoidHom = R := by
    have h1 : (R.map y.toMonoidHom).map e.toMonoidHom
        = (R.map e.toMonoidHom).map y'.toMonoidHom := by
      rw [Subgroup.map_map, Subgroup.map_map]
      have hh : e.toMonoidHom.comp y.toMonoidHom = y'.toMonoidHom.comp e.toMonoidHom := by
        ext x; exact (hyapply x).symm
      rw [hh]
    rw [hy'R] at h1
    exact Subgroup.map_injective e.injective h1
  have hymod : ∀ n ∈ Subgroup.normalizer (R : Set K),
      y n * n⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer (R : Set K)) ⊔ Subgroup.center K := by
    intro n hn
    have hen : e n ∈ Subgroup.normalizer ((R.map e.toMonoidHom : Subgroup K') : Set K') := by
      rw [GGRootNorm.normalizer_map_mulEquiv e R, Subgroup.mem_map_equiv]
      simpa using hn
    have hmod := hy'mod (e n) hen
    have hcenter : (Subgroup.center K).map e.toMonoidHom = Subgroup.center K' := by
      rw [MulEquiv.toMonoidHom_eq_coe e]
      exact Subgroup.map_center_eq e
    have hmapcenter : pCoreOf 2 (Subgroup.normalizer
          ((R.map e.toMonoidHom : Subgroup K') : Set K')) ⊔ Subgroup.center K' =
        ((pCoreOf 2 (Subgroup.normalizer (R : Set K)) ⊔
          Subgroup.center K).map e.toMonoidHom) := by
      rw [GGRootNorm.normalizer_map_mulEquiv e R,
        GGRootNorm.pCoreOf_map_mulEquiv e (Subgroup.normalizer (R : Set K)),
        ← hcenter, ← Subgroup.map_sup]
    rw [hmapcenter] at hmod
    rw [Subgroup.mem_map_equiv] at hmod
    have heq : e.symm (y' (e n) * (e n)⁻¹) = y n * n⁻¹ := by
      rw [map_mul, map_inv, hyapply n]
      simp
    rwa [heq] at hmod
  obtain ⟨k, hk⟩ := h y hy2 hyR hymod
  refine ⟨e k, ?_⟩
  rw [← hycongr, hk, GGRootNorm.congr_conj]

open CFSG.Timmesfeld.LieEmbed Matrix in
private def l10su1_basis {F : Type} [Zero F] [One F] {n : ℕ} (i : Fin n) : Fin n → F :=
  Pi.single i 1

private theorem l10su1_basis_apply {F : Type} [Zero F] [One F] {n : ℕ} (i a : Fin n) :
    l10su1_basis (F := F) i a = if a = i then 1 else 0 := by
  simp [l10su1_basis, Pi.single_apply]

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_uForm_single {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    (i j : Fin n) :
    uForm σ (l10su1_basis (F := F) i) (l10su1_basis (F := F) j) =
      if j = Fin.rev i then 1 else 0 := by
  rw [uForm_eq, Finset.sum_eq_single i]
  · rw [l10su1_basis_apply, if_pos rfl, map_one, one_mul, l10su1_basis_apply]
    by_cases h : Fin.rev i = j
    · rw [if_pos h, if_pos h.symm]
    · rw [if_neg h, if_neg (fun hh => h hh.symm)]
  · intro a _ ha
    rw [l10su1_basis_apply, if_neg ha, map_zero, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ i) h

private theorem l10su1_basis_ne_zero {F : Type} [Field F] {n : ℕ}
    (i : Fin n) : l10su1_basis (F := F) i ≠ 0 := by
  intro h
  have := congrFun h i
  rw [l10su1_basis_apply, if_pos rfl, Pi.zero_apply] at this
  exact one_ne_zero this

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_uForm_add3 {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    (a b c : Fin n → F) :
    uForm σ (a + b + c) (a + b + c) =
      uForm σ a a + uForm σ a b + uForm σ a c + uForm σ b a + uForm σ b b + uForm σ b c +
        uForm σ c a + uForm σ c b + uForm σ c c := by
  simp only [uForm_add_left, uForm_add_right]
  abel

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_uForm_add_single {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F}
    {n : ℕ} {i j : Fin n} (hi : i ≠ Fin.rev i) (hj : j ≠ Fin.rev j) :
    uForm σ (l10su1_basis (F := F) i + l10su1_basis (F := F) j)
      (l10su1_basis (F := F) i + l10su1_basis (F := F) j) = 0 := by
  have h3 := l10su1_uForm_add3 (σ := σ) (l10su1_basis (F := F) i)
    (l10su1_basis (F := F) j) 0
  have hleft : ∀ x : Fin n → F, uForm σ x (0 : Fin n → F) = 0 := by
    intro x; rw [uForm_eq]; simp
  have hright : ∀ x : Fin n → F, uForm σ (0 : Fin n → F) x = 0 := by
    intro x; rw [uForm_eq]; simp
  have h0' : (l10su1_basis (F := F) i : Fin n → F) + l10su1_basis (F := F) j + 0 =
      l10su1_basis (F := F) i + l10su1_basis (F := F) j := by simp
  rw [h0'] at h3
  rw [h3]
  simp only [l10su1_uForm_single, hleft, hright, if_neg hi, if_neg hj, zero_mul, mul_zero,
    add_zero, zero_add]
  by_cases h : j = Fin.rev i
  · have h' : i = Fin.rev j := by
      have hh := congrArg Fin.rev h
      rw [Fin.rev_rev] at hh
      exact hh.symm
    rw [if_pos h, if_pos h']
    exact CharTwo.add_self_eq_zero 1
  · have h' : i ≠ Fin.rev j := fun hh => h (by rw [hh, Fin.rev_rev])
    rw [if_neg h, if_neg h']
    simp

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_uForm_right_single {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    (y : Fin n → F) (a : Fin n) :
    uForm σ y (l10su1_basis (F := F) a) = σ (y (Fin.rev a)) := by
  rw [uForm_eq, Finset.sum_eq_single (Fin.rev a)]
  · rw [l10su1_basis_apply, Fin.rev_rev, if_pos rfl, mul_one]
  · intro b _ hb
    have h : Fin.rev b ≠ a := by
      intro hh
      apply hb
      have := congrArg Fin.rev hh
      rwa [Fin.rev_rev] at this
    rw [l10su1_basis_apply, if_neg h, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ _) h

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_rev_eq_self_unique {n : ℕ} {i j : Fin n}
    (hi : i = Fin.rev i) (hj : j = Fin.rev j) : i = j := by
  have h1 := congrArg Fin.val hi
  have h2 := congrArg Fin.val hj
  simp only [Fin.val_rev] at h1 h2
  exact Fin.ext (by omega)

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_uForm_isometry {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    {B : Matrix (Fin n) (Fin n) F}
    (hB : conjTr σ B * antidiag n * B = antidiag n) (x y : Fin n → F) :
    uForm σ (B *ᵥ x) (B *ᵥ y) = uForm σ x y := by
  have h : uForm σ (B *ᵥ x) (B *ᵥ y) = uRow σ (B *ᵥ x) ⬝ᵥ (B *ᵥ y) :=
    (uRow_dotProduct σ _ _).symm
  rw [h, Matrix.dotProduct_mulVec, uRow_mulVec_vecMul_of_isometry hB, uRow_dotProduct]

private theorem l10su1_isometry_pow {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    {A : GL (Fin n) F}
    (hA : conjTr σ (A : Matrix (Fin n) (Fin n) F) * antidiag n *
      (A : Matrix (Fin n) (Fin n) F) = antidiag n) (j : ℕ) :
    conjTr σ ((A ^ j : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) * antidiag n *
      ((A ^ j : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = antidiag n := by
  induction j with
  | zero =>
    rw [pow_zero, Units.val_one, CFSG.LieType.Universal.Unitary.conjTr_one,
      Matrix.one_mul, Matrix.mul_one]
  | succ j ih =>
    rw [pow_succ, Units.val_mul, CFSG.LieType.Universal.Unitary.conjTr_mul]
    calc conjTr σ (A : Matrix (Fin n) (Fin n) F) *
          conjTr σ ((A ^ j : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) * antidiag n *
            (((A ^ j : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
              (A : Matrix (Fin n) (Fin n) F))
        = conjTr σ (A : Matrix (Fin n) (Fin n) F) *
            (conjTr σ ((A ^ j : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) * antidiag n *
              ((A ^ j : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) *
              (A : Matrix (Fin n) (Fin n) F) := by
          simp only [Matrix.mul_assoc]
      _ = conjTr σ (A : Matrix (Fin n) (Fin n) F) * antidiag n *
            (A : Matrix (Fin n) (Fin n) F) := by rw [ih]
      _ = antidiag n := hA

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_scalar_of_commute_isometry {F : Type} [Field F] [CharP F 2]
    {σ : F ≃+* F} {n : ℕ} (hn : 3 ≤ n) (htr : ∃ c : F, c + σ c = 1)
    {B : GL (Fin n) F}
    (hiso : ∀ x y : Fin n → F, uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ x)
      ((B : Matrix (Fin n) (Fin n) F) *ᵥ y) = uForm σ x y)
    (hline : ∀ v : Fin n → F, uForm σ v v = 0 → v ≠ 0 →
      ∃ l : F, (B : Matrix (Fin n) (Fin n) F) *ᵥ v = l • v) :
    ∃ lam : F, (B : Matrix (Fin n) (Fin n) F) = lam • 1 := by
  classical
  have hn2 : 2 ≤ n := by omega
  let i0 : Fin n := ⟨0, by omega⟩
  have hi0 : i0 ≠ Fin.rev i0 := by
    intro h
    have h1 := congrArg Fin.val h
    simp [i0, Fin.val_rev] at h1
    omega
  have hri0 : Fin.rev i0 ≠ Fin.rev (Fin.rev i0) := by
    rw [Fin.rev_rev]; exact fun h => hi0 h.symm
  have hiso_e : ∀ i : Fin n, i ≠ Fin.rev i →
      uForm σ (l10su1_basis (F := F) i) (l10su1_basis (F := F) i) = 0 := by
    intro i hi
    rw [l10su1_uForm_single, if_neg hi]
  have hisoadd : ∀ i j : Fin n, i ≠ Fin.rev i → j ≠ Fin.rev j →
      uForm σ (l10su1_basis (F := F) i + l10su1_basis (F := F) j)
        (l10su1_basis (F := F) i + l10su1_basis (F := F) j) = 0 :=
    fun i j hi hj => l10su1_uForm_add_single hi hj
  obtain ⟨lam, hlam⟩ := hline _ (hiso_e i0 hi0) (l10su1_basis_ne_zero i0)
  have hlam0 : lam ≠ 0 := by
    intro h
    have h1 : (B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) i0 = 0 := by
      rw [hlam, h, zero_smul]
    have h2 : ((B⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
        ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) i0) =
          l10su1_basis (F := F) i0 := by
      rw [mulVec_mulVec]
      have h1' : ((B⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
          (B : Matrix (Fin n) (Fin n) F) = 1 := by
        simpa using congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
          (inv_mul_cancel B)
      rw [h1', one_mulVec]
    rw [h1, mulVec_zero] at h2
    exact l10su1_basis_ne_zero i0 h2.symm
  have hnon : ∀ i : Fin n, i ≠ Fin.rev i →
      (B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) i =
        lam • l10su1_basis (F := F) i := by
    intro i hi
    by_cases hi01 : i = i0
    · rw [hi01]; exact hlam
    · obtain ⟨li, hli⟩ := hline _ (hiso_e i hi) (l10su1_basis_ne_zero i)
      have hvne : l10su1_basis (F := F) i0 + l10su1_basis (F := F) i ≠ 0 := by
        intro h
        have h1 := congrFun h i0
        rw [Pi.add_apply, l10su1_basis_apply, if_pos rfl, l10su1_basis_apply,
          if_neg (Ne.symm hi01), add_zero, Pi.zero_apply] at h1
        exact one_ne_zero h1
      obtain ⟨nu, hnu⟩ := hline _ (hisoadd i0 i hi0 hi) hvne
      have hsum : (B : Matrix (Fin n) (Fin n) F) *ᵥ
          (l10su1_basis (F := F) i0 + l10su1_basis (F := F) i) =
          lam • l10su1_basis (F := F) i0 + li • l10su1_basis (F := F) i := by
        rw [mulVec_add, hlam, hli]
      have h1 : ((B : Matrix (Fin n) (Fin n) F) *ᵥ
          (l10su1_basis (F := F) i0 + l10su1_basis (F := F) i)) i0 =
          (nu • (l10su1_basis (F := F) i0 + l10su1_basis (F := F) i)) i0 := by rw [hnu]
      rw [hsum] at h1
      have hc1 : lam = nu := by
        simpa [Pi.add_apply, Pi.smul_apply, l10su1_basis_apply, Ne.symm hi01, hi01,
          mul_one, mul_zero, add_zero] using h1
      have h2 : ((B : Matrix (Fin n) (Fin n) F) *ᵥ
          (l10su1_basis (F := F) i0 + l10su1_basis (F := F) i)) i =
          (nu • (l10su1_basis (F := F) i0 + l10su1_basis (F := F) i)) i := by rw [hnu]
      rw [hsum] at h2
      have hc2 : li = nu := by
        simpa [Pi.add_apply, Pi.smul_apply, l10su1_basis_apply, Ne.symm hi01, hi01,
          mul_one, mul_zero, add_zero] using h2
      rw [hli, hc2, ← hc1]
  have hmid : ∀ k : Fin n, k = Fin.rev k →
      (B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k =
        lam • l10su1_basis (F := F) k := by
    intro k hk
    have hik : i0 ≠ k := by
      intro hh
      apply hi0
      rw [hh]
      exact hk
    have hrk : Fin.rev i0 ≠ k := by
      intro hh
      apply hi0
      have h1 : Fin.rev i0 = i0 := by
        calc Fin.rev i0 = k := hh
          _ = Fin.rev k := hk
          _ = Fin.rev (Fin.rev i0) := by rw [hh.symm]
          _ = i0 := Fin.rev_rev i0
      exact h1.symm
    have hzero : ∀ a : Fin n, a ≠ Fin.rev a →
        ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k) (Fin.rev a) = 0 := by
      intro a ha
      have h1 : uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k)
          ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) a) =
          uForm σ (l10su1_basis (F := F) k) (l10su1_basis (F := F) a) := hiso _ _
      rw [hnon a ha, uForm_smul_right] at h1
      have h2 : uForm σ (l10su1_basis (F := F) k) (l10su1_basis (F := F) a) = 0 := by
        rw [l10su1_uForm_right_single]
        have hka : k ≠ Fin.rev a := by
          intro hka'
          apply ha
          have h1 : Fin.rev k = a := by
            have := congrArg Fin.rev hka'
            rwa [Fin.rev_rev] at this
          exact (h1.symm.trans hk.symm).trans hka'
        rw [l10su1_basis_apply, if_neg (Ne.symm hka), map_zero]
      rw [h2] at h1
      have h3 : uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k)
          (l10su1_basis (F := F) a) = 0 :=
        (mul_eq_zero.mp h1).resolve_left hlam0
      rw [l10su1_uForm_right_single] at h3
      exact (map_eq_zero σ).mp h3
    obtain ⟨c, hc⟩ := htr
    have hvk : l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
        c • l10su1_basis (F := F) (Fin.rev i0) ≠ 0 := by
      intro h
      have h1 := congrFun h k
      simp only [Pi.add_apply, Pi.smul_apply, l10su1_basis_apply] at h1
      simp only [if_true, if_neg (Ne.symm hik), if_neg (Ne.symm hrk), smul_zero, add_zero,
        Pi.zero_apply] at h1
      exact one_ne_zero h1
    have hisok : uForm σ (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
        c • l10su1_basis (F := F) (Fin.rev i0))
        (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
          c • l10su1_basis (F := F) (Fin.rev i0)) = 0 := by
      rw [l10su1_uForm_add3]
      simp only [uForm_smul_left, uForm_smul_right, l10su1_uForm_single]
      rw [← hk, Fin.rev_rev]
      simp only [hik, hrk, Ne.symm hik, Ne.symm hrk, hi0, Ne.symm hi0, if_true, if_false,
        zero_mul, mul_zero, add_zero, zero_add, mul_one, one_mul]
      linear_combination hc + CharTwo.add_self_eq_zero (1 : F)
    obtain ⟨mu, hmu⟩ := hline _ hisok hvk
    have hsum : (B : Matrix (Fin n) (Fin n) F) *ᵥ
        (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
          c • l10su1_basis (F := F) (Fin.rev i0)) =
        (B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k +
          lam • l10su1_basis (F := F) i0 + (c * lam) • l10su1_basis (F := F) (Fin.rev i0) := by
      rw [mulVec_add, mulVec_add, mulVec_smul, hlam, hnon (Fin.rev i0) hri0, smul_smul]
    have hk1 : ((B : Matrix (Fin n) (Fin n) F) *ᵥ
        (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
          c • l10su1_basis (F := F) (Fin.rev i0))) k =
        (mu • (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
          c • l10su1_basis (F := F) (Fin.rev i0))) k := by rw [hmu]
    rw [hsum] at hk1
    have hbk : ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k) k = mu := by
      simpa [Pi.add_apply, Pi.smul_apply, l10su1_basis_apply, hik, Ne.symm hik, hrk,
        Ne.symm hrk, mul_zero, mul_one, add_zero, zero_add] using hk1
    have hi0z : ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k) i0 = 0 := by
      have h := hzero (Fin.rev i0) hri0
      rwa [Fin.rev_rev] at h
    have hk2 : ((B : Matrix (Fin n) (Fin n) F) *ᵥ
        (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
          c • l10su1_basis (F := F) (Fin.rev i0))) i0 =
        (mu • (l10su1_basis (F := F) k + l10su1_basis (F := F) i0 +
          c • l10su1_basis (F := F) (Fin.rev i0))) i0 := by rw [hmu]
    rw [hsum] at hk2
    have hlam_mu : lam = mu := by
      simpa [Pi.add_apply, Pi.smul_apply, l10su1_basis_apply, hi0z, hi0, hik, Ne.symm hik,
        hrk, Ne.symm hrk, mul_zero, mul_one, add_zero, zero_add] using hk2
    have hcolk : (B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k =
        lam • l10su1_basis (F := F) k := by
      funext x
      by_cases hx : x = k
      · subst hx
        rw [hbk, hlam_mu]
        simp [l10su1_basis]
      · have hx' : x ≠ Fin.rev x := fun h => hx (l10su1_rev_eq_self_unique h hk)
        have hx2 : ((B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) k) x = 0 := by
          have h := hzero (Fin.rev x) (by rw [Fin.rev_rev]; exact fun hh => hx' hh.symm)
          rwa [Fin.rev_rev] at h
        rw [hx2]
        simp [l10su1_basis_apply, hx]
    exact hcolk
  have hall : ∀ j : Fin n, (B : Matrix (Fin n) (Fin n) F) *ᵥ l10su1_basis (F := F) j =
      lam • l10su1_basis (F := F) j := by
    intro j
    by_cases hj : j = Fin.rev j
    · exact hmid j hj
    · exact hnon j hj
  refine ⟨lam, ?_⟩
  ext a b
  have h := congrFun (hall b) a
  simpa [l10su1_basis, mulVec_single_one, Matrix.smul_apply, Matrix.one_apply,
    Pi.single_apply, mul_ite, mul_one, mul_zero] using h

private theorem l10su1_index_pow_range {U : Type} [CommGroup U] [IsCyclic U] [Finite U]
    (n : ℕ) :
    ((powMonoidHom n : U →* U).range).index = (Nat.card U).gcd n := by
  have hcard : Nat.card (powMonoidHom n : U →* U).range =
      Nat.card U / (Nat.card U).gcd n := IsCyclic.card_powMonoidHom_range U n
  have hmul := Subgroup.card_mul_index ((powMonoidHom n : U →* U).range)
  rw [hcard] at hmul
  have hg : (Nat.card U).gcd n ∣ Nat.card U := Nat.gcd_dvd_left _ _
  have h1 : (Nat.card U).gcd n * (Nat.card U / (Nat.card U).gcd n) = Nat.card U :=
    Nat.mul_div_cancel' hg
  have hNpos : 0 < Nat.card U := Nat.card_pos
  have hNg : 0 < Nat.card U / (Nat.card U).gcd n :=
    Nat.div_pos (Nat.le_of_dvd hNpos hg) (Nat.gcd_pos_of_pos_left n hNpos)
  have h3 : (Nat.card U / (Nat.card U).gcd n) * ((powMonoidHom n : U →* U).range).index =
      (Nat.card U / (Nat.card U).gcd n) * (Nat.card U).gcd n := by
    rw [hmul, mul_comm, h1]
  exact Nat.mul_left_cancel hNg h3

private theorem l10su1_mem_of_pow_mem_of_coprime {G : Type} [CommGroup G] [Finite G]
    {H : Subgroup G} {x : G} {k d : ℕ} (hH : H.index = d) (hx : x ^ k ∈ H)
    (hcop : Nat.Coprime k d) : x ∈ H := by
  have hindex_ne : H.index ≠ 0 := Subgroup.index_ne_zero_of_finite (G := G) (H := H)
  have h1d : 1 ≤ d := by rw [← hH]; exact Nat.one_le_iff_ne_zero.mpr hindex_ne
  rcases eq_or_lt_of_le h1d with hd | hd
  · have htop : H = ⊤ := Subgroup.index_eq_one.mp (by rw [hH, hd])
    rw [htop]; exact Subgroup.mem_top x
  · obtain ⟨m, -, hm⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hd
    have hdH : x ^ d ∈ H := by rw [← hH]; exact Subgroup.pow_index_mem H x
    have hkm : x ^ (k * m) ∈ H := by
      rw [pow_mul]; exact Subgroup.pow_mem (K := H) hx m
    set t := k * m / d with ht
    have hkm_eq : k * m = d * t + 1 := by
      rw [ht]
      have := Nat.mod_add_div (k * m) d
      rw [hm] at this
      omega
    have hkey' : x ^ (k * m) = (x ^ d) ^ t * x := by
      rw [hkm_eq, pow_add, pow_one, ← pow_mul]
    have hkey : x ^ (k * m) * ((x ^ d) ^ t)⁻¹ = x := by
      rw [hkey']
      group
    rw [← hkey]
    exact mul_mem hkm (inv_mem (Subgroup.pow_mem (K := H) hdH _))

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_uForm_pair_smul {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    {i : Fin n} (hi : i ≠ Fin.rev i) (c : F) :
    uForm σ (l10su1_basis (F := F) i + c • l10su1_basis (F := F) (Fin.rev i))
      (l10su1_basis (F := F) i + c • l10su1_basis (F := F) (Fin.rev i)) = c + σ c := by
  rw [uForm_add_left, uForm_add_right, uForm_add_right, uForm_smul_left, uForm_smul_left,
    uForm_smul_right, uForm_smul_right]
  simp only [l10su1_uForm_single, Fin.rev_rev, hi, Ne.symm hi, if_true, if_false]
  ring

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1_scalar_norm {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    (hn : 2 ≤ n) (htr : ∃ c : F, c + σ c = 1) {B : GL (Fin n) F}
    (hiso : ∀ x y : Fin n → F, uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ x)
      ((B : Matrix (Fin n) (Fin n) F) *ᵥ y) = uForm σ x y)
    {lam : F} (hB : (B : Matrix (Fin n) (Fin n) F) = lam • 1) : σ lam * lam = 1 := by
  obtain ⟨c, hc⟩ := htr
  let v : Fin n → F :=
    l10su1_basis (F := F) ⟨0, by omega⟩ + c • l10su1_basis (F := F) (Fin.rev ⟨0, by omega⟩)
  have hi0 : (⟨0, by omega⟩ : Fin n) ≠ Fin.rev ⟨0, by omega⟩ := by
    intro h
    have h1 := congrArg Fin.val h
    simp [Fin.val_rev] at h1
    omega
  have hv : uForm σ v v = 1 := by
    simp only [v]
    rw [l10su1_uForm_pair_smul hi0 c, hc]
  have h1 := hiso v v
  rw [hB] at h1
  have hmv : (lam • (1 : Matrix (Fin n) (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ v =
      lam • v := by rw [Matrix.smul_mulVec, Matrix.one_mulVec]
  rw [hmv, uForm_smul_left, uForm_smul_right, hv, mul_one] at h1
  exact h1

private theorem l10su1_det_norm {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    {A : GL (Fin n) F}
    (hA : conjTr σ (A : Matrix (Fin n) (Fin n) F) * antidiag n *
      (A : Matrix (Fin n) (Fin n) F) = antidiag n) :
    σ ((A : Matrix (Fin n) (Fin n) F).det) * (A : Matrix (Fin n) (Fin n) F).det = 1 := by
  have hJ0 : (antidiag (F := F) n).det ≠ 0 := by
    have h2 : (antidiag (F := F) n).det * (antidiag (F := F) n).det = 1 := by
      have h := congrArg (fun M : Matrix (Fin n) (Fin n) F => M.det)
        (CFSG.LieType.Universal.Unitary.antidiag_mul_self (F := F) n)
      rw [Matrix.det_mul, Matrix.det_one] at h
      exact h
    exact fun h => by rw [h, mul_zero] at h2; exact zero_ne_one h2
  have hconj : ((conjTr σ (A : Matrix (Fin n) (Fin n) F)).det) =
      σ ((A : Matrix (Fin n) (Fin n) F).det) := by
    rw [conjTr, Matrix.det_transpose]
    exact (RingHom.map_det (σ : F →+* F) (A : Matrix (Fin n) (Fin n) F)).symm
  have hdet := congrArg Matrix.det hA
  rw [Matrix.det_mul, Matrix.det_mul, hconj] at hdet
  have h4 : (antidiag (F := F) n).det * (σ ((A : Matrix (Fin n) (Fin n) F).det) *
      (A : Matrix (Fin n) (Fin n) F).det) = (antidiag (F := F) n).det * 1 := by
    rw [mul_one]
    calc (antidiag (F := F) n).det * (σ ((A : Matrix (Fin n) (Fin n) F).det) *
            (A : Matrix (Fin n) (Fin n) F).det)
        = σ ((A : Matrix (Fin n) (Fin n) F).det) * (antidiag (F := F) n).det *
            (A : Matrix (Fin n) (Fin n) F).det := by ring
      _ = (antidiag (F := F) n).det := hdet
  exact mul_left_cancel₀ hJ0 h4

private theorem l10su1_det_root {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n m : ℕ} {dA lam : F}
    (hdA0 : dA ≠ 0) (hlam0 : lam ≠ 0)
    (hsigma : unitaryInvolution F 2 f dA * dA = 1)
    (hlam : lam ^ (2 ^ f + 1) = 1) (hdet : dA ^ (2 ^ m) = lam ^ n) :
    ∃ μ : F, μ ^ (2 ^ f + 1) = 1 ∧ dA = μ ^ n := by
  have hcardF : Nat.card Fˣ = (2 ^ f) ^ 2 - 1 := by
    rw [Nat.card_units, hF]
  have hgcd : ((2 ^ f) ^ 2 - 1).gcd (2 ^ f + 1) = 2 ^ f + 1 := by
    apply Nat.gcd_eq_right
    refine ⟨2 ^ f - 1, ?_⟩
    rw [← Nat.sq_sub_sq]
  let U : Subgroup Fˣ := (powMonoidHom (2 ^ f + 1) : Fˣ →* Fˣ).ker
  have hUcard : Nat.card U = 2 ^ f + 1 := by
    change Nat.card ((powMonoidHom (2 ^ f + 1) : Fˣ →* Fˣ).ker) = 2 ^ f + 1
    rw [IsCyclic.card_powMonoidHom_ker Fˣ (2 ^ f + 1), hcardF, hgcd]
  let x : Fˣ := Units.mk0 dA hdA0
  let l : Fˣ := Units.mk0 lam hlam0
  have hxU : x ∈ U := by
    rw [MonoidHom.mem_ker]
    apply Units.ext
    rw [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_one]
    change dA ^ (2 ^ f + 1) = 1
    rw [pow_succ, ← CFSG.LieType.BorelTits.unitaryInvolution_apply]
    exact hsigma
  have hlU : l ∈ U := by
    rw [MonoidHom.mem_ker, powMonoidHom_apply]
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    exact hlam
  have hxl : x ^ (2 ^ m) = l ^ n := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
    exact hdet
  let H : Subgroup U := (powMonoidHom n : U →* U).range
  have hHindex : H.index = (Nat.card U).gcd n := l10su1_index_pow_range n
  have hxHpow : (⟨x, hxU⟩ : U) ^ (2 ^ m) ∈ H := by
    rw [show (⟨x, hxU⟩ : U) ^ (2 ^ m) = ⟨l, hlU⟩ ^ n from by
      apply Subtype.ext
      rw [Subgroup.coe_pow, Subgroup.coe_pow]
      exact hxl]
    exact ⟨⟨l, hlU⟩, rfl⟩
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with hf0 | hf
    · exfalso
      rw [hf0] at hF
      simp at hF
      have h2 : 1 < Nat.card F := Finite.one_lt_card
      omega
    · exact hf
  have hodd : Odd ((Nat.card U).gcd n) := by
    rw [hUcard]
    exact Odd.of_dvd_nat (by
      have : Even (2 ^ f) := (Nat.even_pow' (by omega : f ≠ 0)).mpr even_two
      exact this.add_one) (Nat.gcd_dvd_left _ _)
  have hcop : Nat.Coprime (2 ^ m) ((Nat.card U).gcd n) :=
    (Nat.coprime_two_left.mpr hodd).pow_left m
  have hxH : (⟨x, hxU⟩ : U) ∈ H := l10su1_mem_of_pow_mem_of_coprime hHindex hxHpow hcop
  obtain ⟨u, hu⟩ := hxH
  refine ⟨(u : Fˣ), ?_, ?_⟩
  · have h : (powMonoidHom (2 ^ f + 1) : Fˣ →* Fˣ) (u : Fˣ) = 1 := u.2
    have h' : (((u : Fˣ) : F)) ^ (2 ^ f + 1) = 1 := by
      have := congrArg (fun w : Fˣ => (w : F)) h
      simpa [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_one] using this
    exact h'
  · have hu' : (((u : Fˣ) : F)) ^ n = dA := by
      have h1 := congrArg (fun w : U => (w : Fˣ)) hu
      have h2 := congrArg (fun w : Fˣ => (w : F)) h1
      simpa [H, x, powMonoidHom_apply, Units.val_pow_eq_pow_val] using h2
    exact hu'.symm

open CFSG.Timmesfeld.LieEmbed Matrix in
theorem inner_of_isometry {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    (y : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n)) (hy2 : ∃ k : ℕ, y ^ 2 ^ k = 1)
    (A : GL (Fin n) F) (hA : conjTr (unitaryInvolution F 2 f) (A : Matrix (Fin n) (Fin n) F) *
      antidiag n * (A : Matrix (Fin n) (Fin n) F) = antidiag n)
    (hyA : ∀ x : ↥(Unitary.SU (unitaryInvolution F 2 f) n),
      ((y x : ↥(Unitary.SU (unitaryInvolution F 2 f) n)) : GL (Fin n) F) =
        A * (x : GL (Fin n) F) * A⁻¹) :
    ∃ k : ↥(Unitary.SU (unitaryInvolution F 2 f) n), y = MulAut.conj k := by
  classical
  let σ : F ≃+* F := unitaryInvolution F 2 f
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hσ : ∀ c, σ c = c ^ 2 ^ f := by
    intro c
    change unitaryInvolution F 2 f c = c ^ 2 ^ f
    exact CFSG.LieType.BorelTits.unitaryInvolution_apply F 2 f c
  have hσ' : ∀ c, σ (σ c) = c := by
    intro c
    change unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c
    exact CFSG.LieType.BorelTits.unitaryInvolution_involutive hF c
  obtain ⟨m, hm⟩ := hy2
  set B : GL (Fin n) F := A ^ 2 ^ m with hBdef
  have hBisom : conjTr σ (B : Matrix (Fin n) (Fin n) F) * antidiag n *
      (B : Matrix (Fin n) (Fin n) F) = antidiag n := by
    rw [hBdef]; exact l10su1_isometry_pow (σ := σ) hA (2 ^ m)
  have hpow : ∀ (j : ℕ) (x : ↥(Unitary.SU σ n)),
      (((y ^ j) x : ↥(Unitary.SU σ n)) : GL (Fin n) F) =
        A ^ j * (x : GL (Fin n) F) * (A ^ j)⁻¹ := by
    intro j
    induction j with
    | zero => intro x; simp
    | succ j ih =>
      intro x
      rw [pow_succ', MulAut.mul_apply, hyA ((y ^ j) x), ih x, pow_succ']
      group
  have hBcomm : ∀ x : ↥(Unitary.SU σ n), B * (x : GL (Fin n) F) = (x : GL (Fin n) F) * B := by
    intro x
    have h1 := hpow (2 ^ m) x
    rw [hm, MulAut.one_apply, ← hBdef] at h1
    have h1' : B * (x : GL (Fin n) F) * B⁻¹ = (x : GL (Fin n) F) := h1.symm
    calc B * (x : GL (Fin n) F) = B * (x : GL (Fin n) F) * B⁻¹ * B := by group
      _ = (x : GL (Fin n) F) * B := by rw [h1']
  have hline : ∀ v : Fin n → F, uForm σ v v = 0 → v ≠ 0 →
      ∃ l : F, (B : Matrix (Fin n) (Fin n) F) *ᵥ v = l • v := by
    intro v hvv hv0
    obtain ⟨x, hx⟩ := CFSG.Timmesfeld.Transvection.ModelRank.exists_suMat_eq_uTrans
      (σ := σ) hσ' hvv (c := 1) (by rw [map_one]; exact CharTwo.add_self_eq_zero 1)
    have hcommx : (B : Matrix (Fin n) (Fin n) F) * uTrans σ v 1 =
        uTrans σ v 1 * (B : Matrix (Fin n) (Fin n) F) := by
      have h := hBcomm x
      have h' : (B : Matrix (Fin n) (Fin n) F) *
          ((x : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
          ((x : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
            (B : Matrix (Fin n) (Fin n) F) :=
        congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F)) h
      rwa [← suMat_apply, hx] at h'
    have hBinv : (B : Matrix (Fin n) (Fin n) F) *
        ((B⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = 1 := by
      simpa using congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
        (mul_inv_cancel B)
    have ht : uTrans σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ v) 1 = uTrans σ v 1 := by
      have h1 := CFSG.Timmesfeld.LieEmbed.mul_uTrans_of_isometry (σ := σ) hBisom v 1
      have h2 : uTrans σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ v) 1 *
          (B : Matrix (Fin n) (Fin n) F) = uTrans σ v 1 * (B : Matrix (Fin n) (Fin n) F) :=
        h1.symm.trans hcommx
      have h3 := congrArg (fun M : Matrix (Fin n) (Fin n) F =>
        M * ((B⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) h2
      simpa [Matrix.mul_assoc, hBinv] using h3
    obtain ⟨e, he⟩ := Function.ne_iff.1 (uRow_ne_zero σ hv0)
    have hvu : uForm σ v (l10su1_basis (F := F) e) ≠ 0 := by
      rw [← uRow_dotProduct σ v (l10su1_basis (F := F) e), l10su1_basis]
      simpa [dotProduct, Pi.single_apply] using he
    have happ := congrArg (fun M : Matrix (Fin n) (Fin n) F =>
      M *ᵥ l10su1_basis (F := F) e) ht
    simp only [uTrans_mulVec, one_mul] at happ
    have h2 : uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ v) (l10su1_basis (F := F) e) •
        ((B : Matrix (Fin n) (Fin n) F) *ᵥ v) =
        uForm σ v (l10su1_basis (F := F) e) • v := add_left_cancel happ
    have hBu : uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ v) (l10su1_basis (F := F) e) ≠ 0 := by
      intro h0
      rw [h0, zero_smul] at h2
      exact hv0 ((smul_eq_zero.1 h2.symm).resolve_left hvu)
    refine ⟨(uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ v)
      (l10su1_basis (F := F) e))⁻¹ * uForm σ v (l10su1_basis (F := F) e), ?_⟩
    have h3 := congrArg (fun w => (uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ v)
      (l10su1_basis (F := F) e))⁻¹ • w) h2
    simpa [smul_smul, inv_mul_cancel₀ hBu] using h3
  have hisoB : ∀ x y : Fin n → F, uForm σ ((B : Matrix (Fin n) (Fin n) F) *ᵥ x)
      ((B : Matrix (Fin n) (Fin n) F) *ᵥ y) = uForm σ x y :=
    l10su1_uForm_isometry (σ := σ) hBisom
  have htr : ∃ c : F, c + σ c = 1 :=
    CFSG.LieType.BorelTits.exists_add_unitaryInvolution_eq hF (map_one σ)
  obtain ⟨lam, hBscalar⟩ := l10su1_scalar_of_commute_isometry (σ := σ) hn htr hisoB hline
  have hlam_norm : σ lam * lam = 1 := l10su1_scalar_norm (σ := σ) (by omega) htr hisoB hBscalar
  have hlamN : lam ^ (2 ^ f + 1) = 1 := by
    rw [pow_succ, ← hσ]
    exact hlam_norm
  have hdA0 : (A : Matrix (Fin n) (Fin n) F).det ≠ 0 := by
    have h := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F).det)
      (mul_inv_cancel A)
    simp only [Units.val_mul, Units.val_one, Matrix.det_mul, Matrix.det_one] at h
    intro h0
    rw [h0, zero_mul] at h
    exact zero_ne_one h
  have hlam0 : lam ≠ 0 := by
    intro h
    rw [h, map_zero, zero_mul] at hlam_norm
    exact zero_ne_one hlam_norm
  have hdetB : (B : Matrix (Fin n) (Fin n) F).det = lam ^ n := by
    rw [hBscalar, Matrix.det_smul, Matrix.det_one, Fintype.card_fin, mul_one]
  have hdetB' : (B : Matrix (Fin n) (Fin n) F).det =
      ((A : Matrix (Fin n) (Fin n) F).det) ^ (2 ^ m) := by
    rw [hBdef, Units.val_pow_eq_pow_val, Matrix.det_pow]
  have hdet_rel : ((A : Matrix (Fin n) (Fin n) F).det) ^ (2 ^ m) = lam ^ n := by
    rw [← hdetB', hdetB]
  have hdA_norm : σ ((A : Matrix (Fin n) (Fin n) F).det) *
      (A : Matrix (Fin n) (Fin n) F).det = 1 := l10su1_det_norm (σ := σ) hA
  obtain ⟨mu, hmuN, hmudet⟩ := l10su1_det_root (F := F) hF hdA0 hlam0
    hdA_norm hlamN hdet_rel
  have hmu0 : mu ≠ 0 := by
    intro h
    rw [h, zero_pow (by omega : n ≠ 0)] at hmudet
    exact hdA0 hmudet
  let mun : Fˣ := Units.mk0 mu hmu0
  let sc : GL (Fin n) F := Matrix.GeneralLinearGroup.scalar (Fin n) mun⁻¹
  let k : GL (Fin n) F := sc * A
  have hsc_center : sc ∈ Subgroup.center (GL (Fin n) F) := by
    rw [Matrix.GeneralLinearGroup.mem_center_iff_val_mem_range_scalar]
    refine ⟨((mun⁻¹ : Fˣ) : F), ?_⟩
    rw [Matrix.GeneralLinearGroup.coe_scalar]
  have hsc_comm : ∀ g : GL (Fin n) F, sc * g = g * sc :=
    fun g => (Subgroup.mem_center_iff.mp hsc_center g).symm
  have hscalar : (sc : Matrix (Fin n) (Fin n) F) =
      ((mun⁻¹ : Fˣ) : F) • (1 : Matrix (Fin n) (Fin n) F) := by
    rw [Matrix.GeneralLinearGroup.coe_scalar]
    ext i j
    by_cases h : i = j <;> simp [Matrix.scalar_apply, h]
  have hkmat : (k : Matrix (Fin n) (Fin n) F) =
      ((mun⁻¹ : Fˣ) : F) • (A : Matrix (Fin n) (Fin n) F) := by
    change ((sc * A : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = _
    rw [Units.val_mul, hscalar, Matrix.smul_mul, Matrix.one_mul]
  have hmu_inv_norm : σ ((mun⁻¹ : Fˣ) : F) * ((mun⁻¹ : Fˣ) : F) = 1 := by
    have h1 : σ ((mun⁻¹ : Fˣ) : F) = (σ ((mun : Fˣ) : F))⁻¹ := map_inv₀ σ _
    have hmun : ((mun : Fˣ) : F) = mu := by simp [mun]
    rw [h1, Units.val_inv_eq_inv_val, ← _root_.mul_inv_rev,
      mul_comm ((mun : Fˣ) : F) (σ ((mun : Fˣ) : F)), hσ, ← pow_succ, hmun, hmuN,
      inv_one]
  have hk_mem : k ∈ Unitary.SU σ n := by
    rw [Unitary.mem_SU]
    constructor
    · rw [hkmat, Matrix.det_smul, Fintype.card_fin, hmudet, ← mul_pow]
      have hc : ((mun⁻¹ : Fˣ) : F) = mu⁻¹ := by simp [mun]
      rw [hc, inv_mul_cancel₀ hmu0, one_pow]
    · rw [hkmat]
      have hconj_smul : conjTr σ (((mun⁻¹ : Fˣ) : F) •
          (A : Matrix (Fin n) (Fin n) F)) =
          σ ((mun⁻¹ : Fˣ) : F) • conjTr σ (A : Matrix (Fin n) (Fin n) F) := by
        ext i j
        simp [conjTr, Matrix.map_apply]
      rw [hconj_smul, Matrix.smul_mul, Matrix.smul_mul, Matrix.mul_smul, smul_smul, hA,
        hmu_inv_norm, one_smul]
  have hk_conj : ∀ g : GL (Fin n) F, k * g * k⁻¹ = A * g * A⁻¹ := by
    intro g
    have h1 : sc * (A * g * A⁻¹) = (A * g * A⁻¹) * sc := hsc_comm (A * g * A⁻¹)
    rw [show k = sc * A from rfl, _root_.mul_inv_rev]
    calc sc * A * g * (A⁻¹ * sc⁻¹) = sc * (A * g * A⁻¹) * sc⁻¹ := by group
      _ = A * g * A⁻¹ := by rw [h1, mul_assoc, mul_inv_cancel, mul_one]
  refine ⟨⟨k, hk_mem⟩, ?_⟩
  apply MulEquiv.ext
  intro x
  apply Subtype.ext
  rw [hyA x, MulAut.conj_apply]
  change A * (x : GL (Fin n) F) * A⁻¹ = k * (x : GL (Fin n) F) * k⁻¹
  rw [hk_conj (x : GL (Fin n) F)]

open CFSG.Timmesfeld.LieEmbed Matrix in
private def l10su1b_uTransGL {F : Type} [Field F] [CharP F 2] {n : ℕ} {σ : F ≃+* F}
    {v : Fin n → F} (hvv : uForm σ v v = 0) (c : F) : GL (Fin n) F where
  val := uTrans σ v c
  inv := uTrans σ v c
  val_inv := by
    rw [uTrans_mul_uTrans σ hvv, show c + c = 0 from CharTwo.add_self_eq_zero c, uTrans_zero σ]
  inv_val := by
    rw [uTrans_mul_uTrans σ hvv, show c + c = 0 from CharTwo.add_self_eq_zero c, uTrans_zero σ]

open CFSG.Timmesfeld.LieEmbed Matrix in
private def l10su1b_transvSubgroup {F : Type} [Field F] [CharP F 2] {n : ℕ} {σ : F ≃+* F}
    {v : Fin n → F} (hvv : uForm σ v v = 0) : Subgroup (GL (Fin n) F) where
  carrier := {g | ∃ c : F, σ c = c ∧ (g : Matrix (Fin n) (Fin n) F) = uTrans σ v c}
  mul_mem' := by
    rintro g h ⟨a, ha, hg⟩ ⟨b, hb, hh⟩
    refine ⟨a + b, by rw [map_add, ha, hb], ?_⟩
    rw [Units.val_mul, hg, hh, uTrans_mul_uTrans σ hvv]
  one_mem' := by
    refine ⟨0, map_zero σ, ?_⟩
    rw [Units.val_one, uTrans_zero σ]
  inv_mem' := by
    rintro g ⟨a, ha, hg⟩
    refine ⟨a, ha, ?_⟩
    have hsq : uTrans σ v a * uTrans σ v a = 1 := by
      rw [uTrans_mul_uTrans σ hvv, show a + a = 0 from CharTwo.add_self_eq_zero a, uTrans_zero σ]
    rw [Matrix.coe_units_inv, hg]
    exact Matrix.inv_eq_right_inv (by rw [hsq])

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_unitTransvGroup_eq_transvections {F : Type} [Field F] [CharP F 2]
    {n : ℕ} {σ : F ≃+* F} {v : Fin n → F} (hvv : uForm σ v v = 0) :
    CFSG.StandardType.ClassicalPosition.unitTransvGroup σ.toRingHom (antidiag n) v =
      l10su1b_transvSubgroup hvv := by
  apply le_antisymm
  · rw [CFSG.StandardType.ClassicalPosition.unitTransvGroup]
    apply (Subgroup.closure_le (l10su1b_transvSubgroup hvv)).2
    rintro g ⟨c, hc, hg⟩
    exact ⟨c, hc, by rw [hg]; rfl⟩
  · intro g hg
    obtain ⟨c, hc, hg⟩ := hg
    rw [CFSG.StandardType.ClassicalPosition.unitTransvGroup]
    refine Subgroup.subset_closure ⟨c, hc, ?_⟩
    rw [hg]
    rfl

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_isUTransGroup_of_map_subtype_eq {F : Type} [Field F] [CharP F 2]
    {n : ℕ} {σ : F ≃+* F} (hσ : ∀ c, σ (σ c) = c) {v : Fin n → F}
    {X : Subgroup (SU σ n)} (hvv : uForm σ v v = 0)
    (hmap : X.map (SU σ n).subtype =
      CFSG.StandardType.ClassicalPosition.unitTransvGroup σ.toRingHom (antidiag n) v) :
    IsUTransGroup σ v X := by
  have htr : ∀ c : F, c + σ c = 0 ↔ σ c = c := by
    intro c
    constructor
    · intro h
      have h2 : σ c = -c := eq_neg_of_add_eq_zero_right h
      rw [h2, CharTwo.neg_eq]
    · intro h
      rw [h]
      exact CharTwo.add_self_eq_zero c
  have hset := l10su1b_unitTransvGroup_eq_transvections (σ := σ) hvv
  have hxiff : ∀ x : SU σ n, (x : GL (Fin n) F) ∈ X.map (SU σ n).subtype ↔ x ∈ X := by
    intro x
    rw [Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, hyx⟩
      have : y = x := Subtype.ext hyx
      rwa [← this]
    · intro hx
      exact ⟨x, hx, rfl⟩
  constructor
  · intro x
    rw [← hxiff x, hmap, hset]
    constructor
    · rintro ⟨c, hc, hx⟩
      exact ⟨c, (htr c).2 hc, hx⟩
    · rintro ⟨c, hc, hx⟩
      exact ⟨c, (htr c).1 hc, hx⟩
  · intro c hc
    obtain ⟨x, hx⟩ :=
      CFSG.Timmesfeld.Transvection.ModelRank.exists_suMat_eq_uTrans (σ := σ) hσ hvv hc
    exact ⟨x, hx⟩

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_center_scalar {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    {z : SU (unitaryInvolution F 2 f) n}
    (hz : z ∈ Subgroup.center (SU (unitaryInvolution F 2 f) n)) :
    ∃ u : Fˣ, ((z : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      Matrix.scalar (Fin n) (u : F) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨P, hP⟩ := CFSG.LieType.Universal.Unitary.exists_wittMatrix (p := 2) (f := f) hF n
  let e : SU (unitaryInvolution F 2 f) n ≃* SUid (unitaryInvolution F 2 f) n :=
    CFSG.LieType.Universal.Unitary.conjEquiv P hP
  have hc : (Subgroup.center (SU (unitaryInvolution F 2 f) n)).map e.toMonoidHom =
      Subgroup.center (SUid (unitaryInvolution F 2 f) n) := by
    rw [MulEquiv.toMonoidHom_eq_coe e]
    exact Subgroup.map_center_eq e
  have hz' : e z ∈ Subgroup.center (SUid (unitaryInvolution F 2 f) n) := by
    rw [← hc]
    exact ⟨z, hz, rfl⟩
  obtain ⟨u, hu⟩ := CFSG.ClassicalInvolution.Phan.exists_scalar_of_mem_center
    (CFSG.ClassicalGroups.Unitary.isUnitaryInvolution_unitaryInvolution hF) hn hz'
  refine ⟨u, ?_⟩
  have hPe : ((e z : SUid (unitaryInvolution F 2 f) n) : GL (Fin n) F) =
      P * (z : GL (Fin n) F) * P⁻¹ := rfl
  have huGL : P * (z : GL (Fin n) F) * P⁻¹ =
      Matrix.GeneralLinearGroup.scalar (Fin n) u := by
    apply Units.ext
    rw [Matrix.GeneralLinearGroup.coe_scalar]
    rw [← hPe]
    exact hu
  have hz_eq : (z : GL (Fin n) F) = Matrix.GeneralLinearGroup.scalar (Fin n) u := by
    have h1 : (z : GL (Fin n) F) = P⁻¹ * (P * (z : GL (Fin n) F) * P⁻¹) * P := by group
    rw [h1, huGL]
    have hcent : Matrix.GeneralLinearGroup.scalar (Fin n) u ∈ Subgroup.center (GL (Fin n) F) :=
      TauCeti.scalar_mem_center u
    calc P⁻¹ * Matrix.GeneralLinearGroup.scalar (Fin n) u * P
        = P⁻¹ * (Matrix.GeneralLinearGroup.scalar (Fin n) u * P) := by group
      _ = P⁻¹ * (P * Matrix.GeneralLinearGroup.scalar (Fin n) u) := by
            rw [Subgroup.mem_center_iff.mp hcent P]
      _ = Matrix.GeneralLinearGroup.scalar (Fin n) u := by
            rw [← mul_assoc, inv_mul_cancel, one_mul]
  rw [hz_eq, Matrix.GeneralLinearGroup.coe_scalar]

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_exists_SU_std_eigen {F : Type} [Field F] [Finite F] [CharP F 2]
    {f : ℕ} (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) {lam : F} (hlam : lam ≠ 0) :
    ∃ t : SU (unitaryInvolution F 2 f) n,
      suMat (unitaryInvolution F 2 f) n t *ᵥ
        Pi.single (⟨0, by omega⟩ : Fin n) 1 =
          lam • Pi.single (⟨0, by omega⟩ : Fin n) 1 := by
  let σ : F ≃+* F := unitaryInvolution F 2 f
  haveI : Fintype F := Fintype.ofFinite F
  have hσ' : ∀ c, σ (σ c) = c := CFSG.LieType.BorelTits.unitaryInvolution_involutive hF
  have hσpow : ∀ c, σ c = c ^ 2 ^ f := by
    intro c
    exact CFSG.LieType.BorelTits.unitaryInvolution_apply F 2 f c
  rcases eq_or_lt_of_le hn with hn3 | hn4
  · subst hn3
    let t : Fin 3 → F := ![lam, lam ^ (2 ^ f - 1), (σ lam)⁻¹]
    have hpow1 : lam * lam ^ (2 ^ f - 1) = lam ^ (2 ^ f) := by
      rw [← pow_succ' lam (2 ^ f - 1), Nat.sub_add_cancel (Nat.one_le_two_pow)]
    have hpow2 : (lam ^ (2 ^ f - 1)) ^ (2 ^ f) * lam ^ (2 ^ f - 1) = 1 := by
      rw [← pow_mul, ← pow_add, show (2 ^ f - 1) * 2 ^ f + (2 ^ f - 1) =
        (2 ^ f) ^ 2 - 1 by
        set m := 2 ^ f
        have hm : 1 ≤ m := Nat.one_le_two_pow
        have hmm : m ≤ m * m := Nat.le_mul_of_pos_left m (by omega)
        rw [pow_two, Nat.sub_mul, one_mul]
        omega]
      rw [← hF, Nat.card_eq_fintype_card]
      exact FiniteField.pow_card_sub_one_eq_one lam hlam
    have ht : ∀ a, σ (t a) * t (Fin.rev a) = 1 := by
      intro a
      fin_cases a
      · simp [t, hσpow]
        exact mul_inv_cancel₀ (pow_ne_zero _ hlam)
      · simpa [t, hσpow] using hpow2
      · change σ (t (2 : Fin 3)) * t (Fin.rev (2 : Fin 3)) = 1
        rw [show Fin.rev (2 : Fin 3) = 0 from by decide]
        rw [show t (2 : Fin 3) = (σ lam)⁻¹ from by simp [t]]
        rw [show t (0 : Fin 3) = lam from by simp [t]]
        rw [map_inv₀, hσ']
        exact inv_mul_cancel₀ hlam
    have hdet : ∏ a, t a = 1 := by
      rw [Fin.prod_univ_three]
      simp [t]
      rw [hpow1, hσpow]
      exact mul_inv_cancel₀ (pow_ne_zero _ hlam)
    refine ⟨CFSG.StandardType.RootDetectSU.diagSU σ t ht hdet, ?_⟩
    rw [suMat_apply, CFSG.StandardType.RootDetectSU.coe_diagSU,
      CFSG.StandardType.RootDetectSU.coe_diagGL]
    funext i
    by_cases hi : i = 0
    · subst hi
      simp [Matrix.mulVec, Matrix.diagonal, Pi.single_apply, t]
    · simp [Matrix.mulVec, Matrix.diagonal, Pi.single_apply, hi]
  ·
    let a0 : Fin n := ⟨0, by omega⟩
    let a1 : Fin n := ⟨1, by omega⟩
    let a2 : Fin n := ⟨n - 2, by omega⟩
    let a3 : Fin n := ⟨n - 1, by omega⟩
    have hr0 : Fin.rev a0 = a3 := by
      ext; simp only [Fin.val_rev, a0, a3]; try omega
    have hr1 : Fin.rev a1 = a2 := by
      ext; simp only [Fin.val_rev, a1, a2]; try omega
    have hr2 : Fin.rev a2 = a1 := by
      ext; simp only [Fin.val_rev, a1, a2]; try omega
    have hr3 : Fin.rev a3 = a0 := by
      ext; simp only [Fin.val_rev, a0, a3]; try omega
    have hdist : a0 ≠ a1 ∧ a0 ≠ a2 ∧ a0 ≠ a3 ∧ a1 ≠ a2 ∧ a1 ≠ a3 ∧ a2 ≠ a3 := by
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
        (intro h; have := congrArg Fin.val h; simp [a0,a1,a2,a3] at this; try omega)
    let v : Fin n → F := Pi.single a0 1
    let w : Fin n → F := Pi.single a1 1
    let v' : Fin n → F := Pi.single a2 1
    let w' : Fin n → F := Pi.single a3 1
    have hB : ∀ (x y : Fin n → F) (i j : Fin n), x = Pi.single i 1 → y = Pi.single j 1 →
        (CFSG.StandardType.LieKnownR2.Short.suH hF n).β x y =
          (if j = Fin.rev i then 1 else 0) := by
      rintro x y i j rfl rfl
      change (CFSG.StandardType.GGOppRadSpU.suForm σ
        (CFSG.LieType.BorelTits.unitaryInvolution_involutive hF) n).β
          (Pi.single i 1) (Pi.single j 1) = _
      rw [CFSG.Timmesfeld.Transvection.ModelRank.suForm_β_eq_uForm
        (CFSG.LieType.BorelTits.unitaryInvolution_involutive hF)]
      exact l10su1_uForm_single i j
    have hfr : CFSG.StandardType.LieKnownR2.Short.SUFrame hF n v w v' w' := by
      refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_⟩⟩
      · rw [hB v w' a0 a3 rfl rfl, if_pos (by rw [hr0])]
      · rw [hB w v' a1 a2 rfl rfl, if_pos (by rw [hr1])]
      · rw [hB v v a0 a0 rfl rfl, if_neg (by rw [hr0]; exact hdist.2.2.1)]
      · rw [hB w w a1 a1 rfl rfl, if_neg (by rw [hr1]; exact hdist.2.2.2.1)]
      · rw [hB v' v' a2 a2 rfl rfl, if_neg (by rw [hr2]; exact Ne.symm hdist.2.2.2.1)]
      · rw [hB w' w' a3 a3 rfl rfl, if_neg (by rw [hr3]; exact Ne.symm hdist.2.2.1)]
      · rw [hB v w a0 a1 rfl rfl, if_neg (by rw [hr0]; exact hdist.2.2.2.2.1)]
      · rw [hB v v' a0 a2 rfl rfl, if_neg (by rw [hr0]; exact hdist.2.2.2.2.2)]
      · rw [hB w w' a1 a3 rfl rfl, if_neg (by rw [hr1]; exact Ne.symm hdist.2.2.2.2.2)]
      · rw [hB v' w' a2 a3 rfl rfl, if_neg (by rw [hr2]; exact Ne.symm hdist.2.2.2.2.1)]
    have hv0 : v ≠ 0 := by
      intro h
      have := congrFun h a0
      simp [v, Pi.single_eq_same] at this
    obtain ⟨g, hg1, -⟩ := CFSG.StandardType.LieKnownR2.Short.exists_mem_SU_torus hfr
      (μ := lam) (ν := lam⁻¹) hlam (inv_ne_zero hlam) (by rw [mul_inv_cancel₀ hlam, map_one])
    refine ⟨g, ?_⟩
    rw [show suMat σ n g *ᵥ Pi.single (⟨0, by omega⟩ : Fin n) 1 =
      CFSG.LieType.BorelTits.natRep (SU σ n) g v from by
        simp [CFSG.LieType.BorelTits.natRep_apply, suMat_apply, v, a0]]
    rw [hg1]

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_smul_of_uTrans_eq {F : Type} [Field F] {n : ℕ} {σ : F ≃+* F}
    {v w : Fin n → F} {d : F} (h : uTrans σ v 1 = uTrans σ w d) :
    ∃ m : F, v = m • w := by
  have h' : (1 : Matrix (Fin n) (Fin n) F) + (1 : F) • uNil σ v =
      1 + d • uNil σ w := by
    simpa [uTrans] using h
  have h2 : (1 : F) • uNil σ v = d • uNil σ w := add_left_cancel h'
  exact exists_eq_smul_of_uNil_eq (by simpa using h2)

private theorem l10su1b_mem_map_subtype_iff {F : Type} [Field F] {n : ℕ} {σ : F ≃+* F}
    {X : Subgroup (SU σ n)} {g : SU σ n} :
    (g : GL (Fin n) F) ∈ X.map (SU σ n).subtype ↔ g ∈ X := by
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨y, hy, hyx⟩
    have : y = g := Subtype.ext hyx
    rwa [← this]
  · intro hg
    exact ⟨g, hg, rfl⟩

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_glAut_rootGroup_map_eq {F : Type} [Field F] {n : ℕ}
    {σ φ : F ≃+* F} (hσ : ∀ c, σ (σ c) = c) (hcomm : ∀ x, φ (σ x) = σ (φ x))
    (γ : Fin (n / 2) → ℤ) :
    ((Unitary.rootGroup σ hσ n γ).map (SU σ n).subtype).map (glAut φ).toMonoidHom =
      (Unitary.rootGroup σ hσ n γ).map (SU σ n).subtype := by
  have hcomm_inv : ∀ x, φ⁻¹ (σ x) = σ (φ⁻¹ x) := by
    intro x
    apply φ.injective
    calc φ (φ⁻¹ (σ x)) = σ x := φ.apply_symm_apply _
      _ = φ (σ (φ⁻¹ x)) := by rw [hcomm]; simp
  apply le_antisymm
  · rintro g ⟨z, hz, rfl⟩
    obtain ⟨x, hx, hxz⟩ := hz
    obtain ⟨z', hz', hz'mat⟩ :=
      CFSG.StandardType.OrdPGraph.exists_glAut_mem_rootGroup hσ φ hcomm γ hx
    exact ⟨z', hz', hz'mat.trans (congrArg (glAut φ) hxz)⟩
  · intro g hg
    obtain ⟨z, hz, hzg⟩ := hg
    obtain ⟨z'', hz'', hz''mat⟩ :=
      CFSG.StandardType.OrdPGraph.exists_glAut_mem_rootGroup hσ φ⁻¹ hcomm_inv γ hz
    refine ⟨z'', ⟨z'', hz'', rfl⟩, ?_⟩
    rw [hz''mat]
    have hinv : glAut φ⁻¹ = (glAut φ)⁻¹ := map_inv (glAut (ι := Fin n)) φ
    have h1 : (glAut φ) ((glAut φ⁻¹) ((z : GL (Fin n) F))) = (z : GL (Fin n) F) := by
      rw [hinv]
      exact MulEquiv.apply_symm_apply (glAut φ) _
    change (glAut φ) ((glAut φ⁻¹) ((z : GL (Fin n) F))) = g
    rw [h1]
    exact hzg

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1b_exists_SU_eigen {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) {v : Fin n → F} (hv0 : v ≠ 0)
    (hvv : uForm (unitaryInvolution F 2 f) v v = 0) {lam : F} (hlam : lam ≠ 0) :
    ∃ t : SU (unitaryInvolution F 2 f) n,
      suMat (unitaryInvolution F 2 f) n t *ᵥ v = lam • v := by
  let σ : F ≃+* F := unitaryInvolution F 2 f
  let e0 : Fin n → F := Pi.single (⟨0, by omega⟩ : Fin n) 1
  have he00 : e0 ≠ 0 := by
    intro h
    have := congrFun h (⟨0, by omega⟩ : Fin n)
    simp [e0, Pi.single_eq_same] at this
  have he0iso : uForm σ e0 e0 = 0 := by
    have hi : (⟨0, by omega⟩ : Fin n) ≠ Fin.rev (⟨0, by omega⟩ : Fin n) := by
      intro h
      have := congrArg Fin.val h
      simp [Fin.val_rev] at this
      omega
    change uForm σ (l10su1_basis (F := F) (⟨0, by omega⟩ : Fin n))
      (l10su1_basis (F := F) (⟨0, by omega⟩ : Fin n)) = 0
    rw [l10su1_uForm_single, if_neg hi]
  obtain ⟨g0, hg0⟩ := CFSG.Timmesfeld.Transvection.ModelRank.exists_suMat_mulVec_eq_of_iso
    (p := 2) (f := f) hF hn he00 he0iso hv0 hvv
  obtain ⟨t0, ht0⟩ := l10su1b_exists_SU_std_eigen (f := f) hF hn hlam
  refine ⟨g0 * t0 * g0⁻¹, ?_⟩
  have hg0inv : suMat σ n g0⁻¹ *ᵥ v = e0 := by
    rw [← hg0, mulVec_mulVec, ← map_mul, inv_mul_cancel, map_one, one_mulVec]
  rw [map_mul, map_mul, ← mulVec_mulVec, ← mulVec_mulVec, hg0inv,
    show suMat σ n t0 *ᵥ e0 = lam • e0 from ht0, mulVec_smul, hg0]

private theorem l10su1c_toStd_weylAction_long {n : ℕ}
    (w : (coxeterMatrix (isFiniteType_cartan n)).Group)
    {γ : Fin (n / 2) → ℤ} {i : Fin n} (hi : i ≠ Fin.rev i) (h : toStd n γ = 2 • weight n i) :
    ∃ j : Fin n, j ≠ Fin.rev j ∧
      toStd n (weylAction (isFiniteType_cartan n) w γ) = 2 • weight n j := by
  induction w using (coxeterMatrix (isFiniteType_cartan n)).toCoxeterSystem.simple_induction_left
    with
  | one =>
    rw [map_one, Module.End.one_apply]
    exact ⟨i, hi, h⟩
  | mul_simple_left w k ih =>
    obtain ⟨j, hj, hj'⟩ := ih
    refine ⟨levelPerm k j, levelPerm_ne_rev k hj, ?_⟩
    rw [weylAction_mul_apply, weylAction_simple, toStd_reflection, hj', stdRefl_nsmul,
      weight_levelPerm]

private theorem l10su1c_exists_highest {n : ℕ} (hn : 2 ≤ n) :
    ∃ θ : Fin (n / 2) → ℤ,
      toStd n θ = 2 • weight n (lowIdx (⟨0, by omega⟩ : Fin (n / 2))) := by
  have hm : 0 < n / 2 := by omega
  by_cases he : Even n
  · refine ⟨fun a => if a.val + 1 = n / 2 then 1 else 2, ?_⟩
    funext a
    rw [toStd_apply_of_even he, Pi.smul_apply, weight_lowIdx]
    simp only [Pi.single_apply, nsmul_eq_mul]
    by_cases h0 : a.val = 0
    · have : a = ⟨0, hm⟩ := Fin.ext h0
      subst this
      simp
      split_ifs <;> simp_all <;> omega
    · have h1 : 0 < a.val := Nat.pos_of_ne_zero h0
      have hne : ¬ (a = ⟨0, hm⟩) := fun e => h0 (by rw [e])
      simp [h1, hne]
      split_ifs <;> simp_all <;> omega
  · refine ⟨fun _ => 2, ?_⟩
    funext a
    simp only [toStd, he, ite_false, Pi.smul_apply, weight_lowIdx, Pi.single_apply, nsmul_eq_mul]
    by_cases h0 : a.val = 0
    · have : a = ⟨0, hm⟩ := Fin.ext h0
      subst this
      simp
    · have h1 : 0 < a.val := Nat.pos_of_ne_zero h0
      have hne : ¬ (a = ⟨0, hm⟩) := fun e => h0 (by rw [e])
      simp [h1, hne]

private theorem l10su1c_exists_weight_of_ggLongRoot {F : Type} [Field F] [Finite F] {f : ℕ}
    [CharP F 2] (hc : Nat.card F = (2 ^ f) ^ 2) {n : ℕ}
    {β : Fin (rootDatum hc n).rank → ℤ} (hβ : β ∈ (rootDatum hc n).roots)
    (hl : GGLongRoot (rootDatum hc n) β) :
    ∃ i : Fin n, i ≠ Fin.rev i ∧ toStd n β = 2 • weight n i := by
  have hn : 2 ≤ n := by
    have hβ' : β ∈ roots (isFiniteType_cartan n) (divisible n) := hβ
    rcases hβ' with ⟨_, l, _⟩ | ⟨_, l, _, _⟩ <;> have := l.isLt <;> omega
  obtain ⟨w, γ₀, hγ₀, hmax, rfl⟩ := hl
  have hγ' : γ₀ ∈ roots (isFiniteType_cartan n) (divisible n) := hγ₀
  have hm : 0 < n / 2 := by omega
  obtain ⟨θ, hθ⟩ := l10su1c_exists_highest hn
  have hθr : θ ∈ roots (isFiniteType_cartan n) (divisible n) := by
    rw [roots_eq]
    exact Or.inr (Or.inl ⟨lowIdx ⟨0, hm⟩, lowIdx_ne_rev _ _, hθ⟩)
  have hle : ht (ι := Fin (n / 2)) θ ≤ ht (ι := Fin (n / 2)) γ₀ := hmax θ hθr
  have hθ2 : ht (ι := Fin (n / 2)) θ = (n : ℤ) - 1 := by
    have h := two_mul_ht θ
    have h0 : (lowIdx (⟨0, hm⟩ : Fin (n / 2))).val = 0 := rfl
    rw [hθ, map_nsmul, lv_weight, h0] at h
    simp only [nsmul_eq_mul, Nat.cast_ofNat, Nat.cast_zero, mul_zero, sub_zero] at h
    omega
  have h2 := two_mul_ht γ₀
  have hγ'' := hγ'
  rw [roots_eq] at hγ''
  rcases hγ'' with ⟨i, j, hij, hi, hj, hji, h⟩ | ⟨i, hi, h⟩ | ⟨he, i, hi, h⟩
  · exfalso
    rw [h, map_sub, lv_weight, lv_weight] at h2
    have hi' := i.isLt
    have hj' := j.isLt
    exact hji (Fin.ext (by rw [Fin.val_rev]; omega))
  · exact l10su1c_toStd_weylAction_long w hi h
  · exfalso
    rw [h, lv_weight] at h2
    have hi' := i.isLt
    omega

private theorem l10su1_field_aut_of_div_pow {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (φ : F ≃+* F)
    (h : ∀ c : F, c ≠ 0 → (φ c / c) ^ Nat.gcd n (2 ^ f + 1) = 1) :
    φ = RingEquiv.refl F ∨ ((2 ^ f + 1) ∣ n ∧ ∀ c : F, φ c = c ^ 2 ^ f) := by
  have hfpos : 0 < f := by
    by_contra hf
    have hf0 : f = 0 := Nat.eq_zero_of_not_pos hf
    rw [hf0] at hF
    norm_num at hF
    have hcard_gt : 1 < Nat.card F := Finite.one_lt_card
    omega
  have hcard : Nat.card F = 2 ^ (2 * f) := by
    rw [hF, ← pow_mul]
    congr 1
    omega
  letI : Algebra (ZMod 2) F := ZMod.algebra F 2
  let algφ : F ≃ₐ[ZMod 2] F :=
    AlgEquiv.ofRingEquiv (f := φ) (by
      intro x
      change φ (ZMod.cast x) = ZMod.cast x
      rw [ZMod.cast_eq_val, map_natCast])
  have hfin : Module.finrank (ZMod 2) F = 2 * f := by
    have hpow := FiniteField.pow_finrank_eq_natCard 2 F
    rw [hcard] at hpow
    exact Nat.pow_right_injective (by norm_num) hpow
  obtain ⟨e, he⟩ :=
    (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) F).2 algφ
  have he_lt : e.val < 2 * f := by
    simpa [hfin] using e.isLt
  have hφe : ∀ c : F, φ c = c ^ 2 ^ e.val := by
    intro c
    have hcoe : (⇑(FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) F) : F → F)^[e.val]
        = fun x => x ^ 2 ^ e.val := by
      rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
      simp
    have h1 : (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) F ^ e.val) c
        = c ^ 2 ^ e.val := by
      rw [AlgEquiv.coe_pow]
      exact congrFun hcoe c
    have h2 : algφ c = c ^ 2 ^ e.val := by
      simpa [he] using h1
    simpa [algφ] using h2
  obtain ⟨g, hg⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := Fˣ)
  have hgcard : orderOf g = 2 ^ (2 * f) - 1 := by
    calc
      orderOf g = Nat.card Fˣ := hg
      _ = Nat.card F - 1 := Nat.card_units F
      _ = 2 ^ (2 * f) - 1 := by rw [hcard]
  let d : ℕ := Nat.gcd n (2 ^ f + 1)
  have hdvd : d ∣ 2 ^ f + 1 := Nat.gcd_dvd_right n (2 ^ f + 1)
  have hdpos : 0 < d := by
    dsimp [d]
    positivity
  have h1 : ((g : F) ^ (2 ^ e.val) / (g : F)) ^ d = 1 := by
    have hh := h (g : F) g.ne_zero
    rwa [hφe] at hh
  have h2 : (g : F) ^ ((2 ^ e.val - 1) * d) = 1 := by
    calc
      (g : F) ^ ((2 ^ e.val - 1) * d) = ((g : F) ^ (2 ^ e.val - 1)) ^ d := by
        rw [pow_mul]
      _ = ((g : F) ^ (2 ^ e.val) / (g : F)) ^ d := by
        congr 1
        simpa [div_eq_mul_inv] using
          (pow_sub₀ (g : F) g.ne_zero (n := 1) (m := 2 ^ e.val)
            (Nat.one_le_pow e.val 2 (by norm_num)))
      _ = 1 := h1
  have h3 : orderOf (g : F) ∣ (2 ^ e.val - 1) * d :=
    orderOf_dvd_iff_pow_eq_one.mpr h2
  have hgen : 2 ^ (2 * f) - 1 ∣ (2 ^ e.val - 1) * d := by
    rwa [orderOf_units, hgcard] at h3
  by_cases he0 : e.val = 0
  · left
    ext c
    simpa [he0] using hφe c
  · right
    obtain ⟨m, hm⟩ := hdvd
    have hA : 2 ^ (2 * f) - 1 = ((2 ^ f - 1) * m) * d := by
      have hsq : 2 ^ (2 * f) = (2 ^ f) ^ 2 := by
        rw [← pow_mul]
        congr 1
        omega
      rw [hsq]
      change (2 ^ f) ^ 2 - 1 ^ 2 = ((2 ^ f - 1) * m) * d
      rw [Nat.sq_sub_sq, hm]
      ring
    have hAdvd : ((2 ^ f - 1) * m) * d ∣ (2 ^ e.val - 1) * d := by
      simpa [hA] using hgen
    have hmul : (2 ^ f - 1) * m ∣ 2 ^ e.val - 1 :=
      (mul_dvd_mul_iff_right hdpos.ne').mp hAdvd
    have hqminus : 2 ^ f - 1 ∣ 2 ^ e.val - 1 :=
      dvd_trans (dvd_mul_right (2 ^ f - 1) m) hmul
    have hgcd : Nat.gcd (2 ^ f - 1) (2 ^ e.val - 1) = 2 ^ f - 1 :=
      Nat.gcd_eq_left hqminus
    have hgcdpow := Nat.pow_sub_one_gcd_pow_sub_one 2 f e.val
    have hge : 2 ^ Nat.gcd f e.val - 1 = 2 ^ f - 1 := by
      rw [← hgcdpow]
      exact hgcd
    have hge2 : 2 ^ Nat.gcd f e.val = 2 ^ f := by
      have hpg : 0 < 2 ^ Nat.gcd f e.val := by positivity
      have hpf : 0 < 2 ^ f := by positivity
      omega
    have hgcd_eq : Nat.gcd f e.val = f :=
      Nat.pow_right_injective (by norm_num) hge2
    have hfe : f ∣ e.val := Nat.gcd_eq_left_iff_dvd.mp hgcd_eq
    have hef : e.val = f := Nat.eq_of_dvd_of_lt_two_mul he0 hfe he_lt
    have hφq : ∀ c : F, φ c = c ^ 2 ^ f := by
      intro c
      simpa [hef] using hφe c
    have hmul' : (2 ^ f - 1) * m ∣ 2 ^ f - 1 := by
      simpa [hef] using hmul
    have hq1pos : 0 < 2 ^ f - 1 := by
      have h2f : 2 ≤ 2 ^ f := by
        calc
          2 = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hfpos
      omega
    have hmle : (2 ^ f - 1) * m ≤ 2 ^ f - 1 := Nat.le_of_dvd hq1pos hmul'
    have hm1 : m = 1 := by
      have hle : m ≤ 1 := by
        apply Nat.le_of_mul_le_mul_left _ hq1pos
        simpa using hmle
      have hmpos : 0 < m := by
        by_contra hm0
        have hmz : m = 0 := Nat.eq_zero_of_not_pos hm0
        rw [hmz, mul_zero] at hm
        omega
      omega
    have hdval : d = 2 ^ f + 1 := by
      have h := hm
      rw [hm1, mul_one] at h
      exact h.symm
    exact ⟨by rw [← hdval]; exact Nat.gcd_dvd_left n (2 ^ f + 1), hφq⟩

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1c_y_mulVec {F : Type} [Field F] {n : ℕ} {σ φ : F ≃+* F}
    (y : MulAut ↥(SU σ n)) {A : GL (Fin n) F}
    (hyA : ∀ x : ↥(SU σ n),
      ((y x : ↥(SU σ n)) : GL (Fin n) F) = A * glAut φ (x : GL (Fin n) F) * A⁻¹)
    (g : ↥(SU σ n)) (x : Fin n → F) :
    suMat σ n (y g) *ᵥ ((A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (x i))) =
      (A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ ((suMat σ n g *ᵥ x) i)) := by
  have hkey : ((glAut φ (g : GL (Fin n) F) : GL (Fin n) F) :
        Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (x i)) =
      (fun i => φ ((suMat σ n g *ᵥ x) i)) := by
    rw [CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.coe_glAut]
    exact (map_mulVec_sigma (σ := φ) (suMat σ n g) x).symm
  have hAA : ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
      (A : Matrix (Fin n) (Fin n) F) = 1 := by
    simpa using congrArg (fun u : GL (Fin n) F => (u : Matrix (Fin n) (Fin n) F))
      (inv_mul_cancel A)
  have hmat : suMat σ n (y g) = (A : Matrix (Fin n) (Fin n) F) *
      ((glAut φ (g : GL (Fin n) F) : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
      ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) := by
    rw [suMat_apply, hyA g]
    rfl
  have hinner : ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
      ((A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (x i))) = (fun i => φ (x i)) := by
    rw [Matrix.mulVec_mulVec, hAA, Matrix.one_mulVec]
  calc suMat σ n (y g) *ᵥ ((A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (x i)))
      = ((A : Matrix (Fin n) (Fin n) F) *
          ((glAut φ (g : GL (Fin n) F) : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
          ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) *ᵥ
            ((A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (x i))) := by rw [hmat]
    _ = (A : Matrix (Fin n) (Fin n) F) *ᵥ
          (((glAut φ (g : GL (Fin n) F) : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
            (((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
              ((A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (x i))))) := by
          rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    _ = (A : Matrix (Fin n) (Fin n) F) *ᵥ
          (((glAut φ (g : GL (Fin n) F) : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
            (fun i => φ (x i))) := by
          rw [hinner]
    _ = (A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ ((suMat σ n g *ᵥ x) i)) := by
          rw [hkey]

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1c_center_scalar {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    {z : ↥(SU (unitaryInvolution F 2 f) n)}
    (hz : z ∈ Subgroup.center ↥(SU (unitaryInvolution F 2 f) n)) :
    ∃ u : Fˣ, ((z : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      Matrix.scalar (Fin n) (u : F) ∧ (u : F) ^ n = 1 ∧ (u : F) ^ (2 ^ f + 1) = 1 := by
  obtain ⟨u, hu⟩ := l10su1b_center_scalar hF hn hz
  have hzSU : (z : GL (Fin n) F) ∈ SU (unitaryInvolution F 2 f) n := z.2
  have hdet : (((z : GL (Fin n) F)) : Matrix (Fin n) (Fin n) F).det = 1 :=
    (CFSG.LieType.Universal.Unitary.mem_SU.mp hzSU).1
  have hunit := (CFSG.LieType.Universal.Unitary.mem_SU.mp hzSU).2
  refine ⟨u, hu, ?_, ?_⟩
  · have h := hdet
    rw [hu, Matrix.scalar_apply, Matrix.det_diagonal] at h
    simpa [Finset.prod_const, Fintype.card_fin] using h
  · have hconj : conjTr (unitaryInvolution F 2 f) (Matrix.scalar (Fin n) (u : F)) =
        Matrix.scalar (Fin n) (unitaryInvolution F 2 f (u : F)) := by
      ext i j
      simp [conjTr, Matrix.scalar_apply, Matrix.diagonal_apply, eq_comm]
    have hL : conjTr (unitaryInvolution F 2 f) (Matrix.scalar (Fin n) (u : F)) *
        antidiag n * Matrix.scalar (Fin n) (u : F) =
        (((unitaryInvolution F 2 f (u : F)) * (u : F) : F)) •
          (antidiag n : Matrix (Fin n) (Fin n) F) := by
      rw [hconj, Matrix.scalar_apply, Matrix.scalar_apply]
      rw [← Matrix.smul_eq_diagonal_mul, ← Matrix.smul_eq_mul_diagonal, smul_smul, mul_comm]
    have hunit' : (((unitaryInvolution F 2 f (u : F)) * (u : F) : F)) •
        (antidiag n : Matrix (Fin n) (Fin n) F) = antidiag n := by
      rw [← hL, ← hu]
      exact hunit
    have hentry := congrFun (congrFun hunit' ⟨0, by omega⟩) (Fin.rev ⟨0, by omega⟩)
    have hdiag : (antidiag n : Matrix (Fin n) (Fin n) F) ⟨0, by omega⟩
        (Fin.rev ⟨0, by omega⟩) = 1 := by
      simp [antidiag]
    simp only [Matrix.smul_apply, smul_eq_mul, hdiag, mul_one] at hentry
    rw [pow_succ, ← CFSG.LieType.BorelTits.unitaryInvolution_apply F 2 f (u : F)]
    exact hentry

open CFSG.Timmesfeld.LieEmbed CFSG.Timmesfeld.Transvection.ModelRank Matrix in
private theorem l10su1_field_part {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) (hnf : ¬ (n = 3 ∧ f = 1))
    {β : Fin (Unitary.rootDatum hF n).rank → ℤ} (hl : GGLongRoot (Unitary.rootDatum hF n) β)
    (y : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (hyR : ((Unitary.rootDatum hF n).rootGroup β).map y.toMonoidHom =
      (Unitary.rootDatum hF n).rootGroup β)
    (hy : ∀ m ∈ Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))),
      y m * m⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))) ⊔
        Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
    ∃ (A : GL (Fin n) F) (φ : F ≃+* F),
      conjTr (unitaryInvolution F 2 f) (A : Matrix (Fin n) (Fin n) F) * antidiag n *
        (A : Matrix (Fin n) (Fin n) F) = antidiag n ∧
      (∀ x : ↥(Unitary.SU (unitaryInvolution F 2 f) n),
        ((y x : ↥(Unitary.SU (unitaryInvolution F 2 f) n)) : GL (Fin n) F) =
          A * glAut φ (x : GL (Fin n) F) * A⁻¹) ∧
      (φ = RingEquiv.refl F ∨ ((2 ^ f + 1) ∣ n ∧ ∀ c : F, φ c = c ^ 2 ^ f)) := by
  classical
  let σ : F ≃+* F := unitaryInvolution F 2 f
  have hσ : ∀ c, σ c = c ^ 2 ^ f := by
    intro c
    exact CFSG.LieType.BorelTits.unitaryInvolution_apply F 2 f c
  have hσ' : ∀ c, σ (σ c) = c := CFSG.LieType.BorelTits.unitaryInvolution_involutive hF
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with hf0 | hfpos
    · exfalso
      rw [hf0] at hF
      simp at hF
      have h2 : 1 < Nat.card F := Finite.one_lt_card
      omega
    · exact hfpos
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hnf' : ¬ (n = 3 ∧ 2 ^ f = 2) := by
    rintro ⟨hn3, hq⟩
    refine hnf ⟨hn3, ?_⟩
    exact Nat.pow_right_injective (by norm_num : 2 ≤ 2) (by simpa using hq)
  obtain ⟨A, φ, hA, hyA⟩ :=
    CFSG.SeitzReduction.SymplecticPilot.exists_conj_glAut_of_mulAut_SU
      (F := F) (f := f) (r := n) hF hf hn hnf' y
  have hcomm : ∀ c, φ (σ c) = σ (φ c) := by
    intro c
    rw [hσ c, hσ (φ c), map_pow]
  have hF' : Nat.card F = 2 ^ (2 * f) := by
    rw [hF, ← pow_mul, mul_comm]
  obtain ⟨e, he, hφe⟩ :=
    CFSG.ClassicalInvolution.ModelFacts.ChevAut.exists_ringEquiv_eq_frobenius_pow
      (p := 2) (f := 2 * f) (by norm_num) (by omega) hF' φ
  have hβ : β ∈ (Unitary.rootDatum hF n).roots := by
    obtain ⟨w, γ₀, hγ₀, hmax, rfl⟩ := hl
    exact CFSG.LieType.CurtisTits.weylAction_mem_roots (D := Unitary.rootDatum hF n) hγ₀ w
  obtain ⟨v, w, hvv0, hww0, hvw0, hR0, hRneg0⟩ :=
    CFSG.StandardType.LieKnownR2.Geo.exists_unitTransvGroup_eq_conj_rootGroup_SU
      (f := f) hF n hβ hl 1
  let R : Subgroup (SU σ n) := (Unitary.rootDatum hF n).rootGroup β
  have hR : R.map (SU σ n).subtype =
      CFSG.StandardType.ClassicalPosition.unitTransvGroup σ.toRingHom (antidiag n) v := by
    have hconj : MulAut.conj (1 : SU (unitaryInvolution F 2 f) n) =
        (1 : MulAut (SU (unitaryInvolution F 2 f) n)) := map_one MulAut.conj
    have hmapid : ∀ X : Subgroup (SU (unitaryInvolution F 2 f) n),
        Subgroup.map (MulEquiv.toMonoidHom
          (MulAut.conj (1 : SU (unitaryInvolution F 2 f) n))) X = X := by
      intro X
      have h1' : (MulEquiv.toMonoidHom
          (MulAut.conj (1 : SU (unitaryInvolution F 2 f) n)) :
            SU (unitaryInvolution F 2 f) n →* SU (unitaryInvolution F 2 f) n) =
          MonoidHom.id _ := by
        ext x
        simp
      rw [h1', Subgroup.map_id]
    rw [hmapid] at hR0
    simpa [R, σ] using hR0
  have hvec : ∀ x y : Fin n → F,
      (fun i => σ (x i)) ᵥ* antidiag n ⬝ᵥ y = uForm σ x y := by
    intro x y
    rw [uForm_eq]
    simp only [dotProduct, CFSG.Timmesfeld.LieEmbed.vecMul_antidiag]
    rw [← Equiv.sum_comp (Fin.revPerm (n := n)) (fun j => σ (x j) * y (Fin.rev j))]
    apply Finset.sum_congr rfl
    intro i _
    simp [Fin.revPerm_apply, Fin.rev_rev]
  have hvv : uForm σ v v = 0 := by
    rw [← hvec v v]
    exact hvv0
  have hvw : uForm σ v w = 1 := by
    rw [← hvec v w]
    exact hvw0
  have hv0 : v ≠ 0 := by
    intro h
    rw [h, uForm_eq] at hvw
    simp at hvw
  have h1 : (1 : F) + σ 1 = 0 := by rw [map_one]; exact CharTwo.add_self_eq_zero 1
  have hTtrans : CFSG.StandardType.ClassicalPosition.unitTransvGroup σ.toRingHom
      (antidiag n) v = l10su1b_transvSubgroup hvv :=
    l10su1b_unitTransvGroup_eq_transvections hvv
  have hT : IsUTransGroup σ v R :=
    l10su1b_isUTransGroup_of_map_subtype_eq hσ' hvv hR
  have hN : Subgroup.normalizer (R : Set (SU σ n)) = uLine σ v :=
    CFSG.Timmesfeld.Transvection.ModelRank.normalizer_eq_uLine hσ' hv0 hT
  obtain ⟨x, hxmat⟩ :=
    CFSG.Timmesfeld.Transvection.ModelRank.exists_suMat_eq_uTrans (σ := σ) hσ' hvv h1
  have hxR : x ∈ R := by
    rw [← l10su1b_mem_map_subtype_iff (X := R)]
    rw [hR, hTtrans]
    exact ⟨1, by rw [map_one], hxmat⟩
  obtain ⟨z, hzR, hzmat⟩ :=
    CFSG.StandardType.OrdPGraph.exists_glAut_mem_rootGroup hσ' φ hcomm β hxR
  have hzcalc : ((z : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      uTrans σ (fun i => φ (v i)) 1 := by
    rw [hzmat]
    change ((glAut φ (x : GL (Fin n) F) : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F) = _
    rw [CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.coe_glAut]
    rw [show ((x : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = uTrans σ v 1 from hxmat]
    rw [CFSG.Timmesfeld.LieEmbed.map_uTrans φ hcomm v 1, map_one]
  have hzmem : ∃ d : F, σ d = d ∧
      ((z : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = uTrans σ v d := by
    have hmem : (z : GL (Fin n) F) ∈
        CFSG.StandardType.ClassicalPosition.unitTransvGroup σ.toRingHom (antidiag n) v := by
      rw [← hR]
      exact ⟨z, hzR, rfl⟩
    rw [hTtrans] at hmem
    exact hmem
  obtain ⟨dval, hdσ, hdmat⟩ := hzmem
  have heqφ : uTrans σ (fun i => φ (v i)) 1 = uTrans σ v dval := by
    rw [← hzcalc]
    exact hdmat
  obtain ⟨mval, hmval⟩ := l10su1b_smul_of_uTrans_eq (σ := σ)
    (v := fun i => φ (v i)) (w := v) (d := dval) heqφ
  have hTgl : (R.map (SU σ n).subtype).map (glAut φ).toMonoidHom =
      R.map (SU σ n).subtype := by
    have hRd : R = Unitary.rootGroup σ hσ' n β := rfl
    rw [hRd]
    exact l10su1b_glAut_rootGroup_map_eq (σ := σ) hσ' hcomm β
  have h1fix : σ 1 = 1 := map_one σ
  have htgl : l10su1b_uTransGL hvv 1 ∈ R.map (SU σ n).subtype := by
    rw [hR, hTtrans]
    exact ⟨1, h1fix, rfl⟩
  have hpre : l10su1b_uTransGL hvv 1 ∈
      (R.map (SU σ n).subtype).map (glAut φ).toMonoidHom := by
    rw [hTgl]
    exact htgl
  rw [Subgroup.mem_map] at hpre
  obtain ⟨g, hgT, hgg⟩ := hpre
  rw [Subgroup.mem_map] at hgT
  obtain ⟨x', hx'R, hx'g⟩ := hgT
  have hglx' : glAut φ (x' : GL (Fin n) F) = l10su1b_uTransGL hvv 1 := by
    have hx'g' : (x' : GL (Fin n) F) = g := hx'g
    rw [hx'g']
    exact hgg
  have hyR' : R.map y.toMonoidHom = R := by simpa [R] using hyR
  have hyx'R : y x' ∈ R := by
    have h : y x' ∈ R.map y.toMonoidHom := ⟨x', hx'R, rfl⟩
    rwa [hyR'] at h
  have hyx'mat : ((y x' : SU σ n) : GL (Fin n) F) =
      A * l10su1b_uTransGL hvv 1 * A⁻¹ := by
    rw [hyA x', hglx']
  have hAmat : (A : Matrix (Fin n) (Fin n) F) * uTrans σ v 1 *
      ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
        uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
    have hmul := CFSG.Timmesfeld.LieEmbed.mul_uTrans_of_isometry (σ := σ) hA v 1
    have hAA : (A : Matrix (Fin n) (Fin n) F) *
        ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = 1 := by
      have := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
        (mul_inv_cancel A)
      simpa using this
    calc (A : Matrix (Fin n) (Fin n) F) * uTrans σ v 1 *
          ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)
        = uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 * (A : Matrix (Fin n) (Fin n) F) *
          ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) := by rw [hmul]
      _ = uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
            rw [Matrix.mul_assoc, hAA, Matrix.mul_one]
  have hmatA : (((y x' : SU σ n) : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
    have h := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F)) hyx'mat
    rw [h] 
    change (A : Matrix (Fin n) (Fin n) F) *
      ((l10su1b_uTransGL hvv 1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
      ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
        uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1
    rw [show ((l10su1b_uTransGL hvv 1 : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F) = uTrans σ v 1 from rfl]
    exact hAmat
  have hAvT : ((y x' : SU σ n) : GL (Fin n) F) ∈
      CFSG.StandardType.ClassicalPosition.unitTransvGroup σ.toRingHom (antidiag n) v := by
    rw [← hR]
    exact ⟨y x', hyx'R, rfl⟩
  rw [hTtrans] at hAvT
  obtain ⟨dA, hdAσ, hdAmat⟩ := hAvT
  obtain ⟨nval, hnval⟩ := l10su1b_smul_of_uTrans_eq (σ := σ)
    (v := ((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) (w := v) (d := dA) (by rw [← hmatA]; exact hdAmat)
  have hmval0 : mval ≠ 0 := by
    intro h
    apply hv0
    have h' : (fun i => φ (v i)) = 0 := by rw [hmval, h, zero_smul]
    funext i
    have hi := congrFun h' i
    exact φ.injective (by simpa using hi)
  have hnval0 : nval ≠ 0 := by
    intro h
    apply hv0
    have h' : (A : Matrix (Fin n) (Fin n) F) *ᵥ v = 0 := by rw [hnval, h, zero_smul]
    have hAA : ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
        (A : Matrix (Fin n) (Fin n) F) = 1 := by
      simpa using congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
        (inv_mul_cancel A)
    calc v = (1 : Matrix (Fin n) (Fin n) F) *ᵥ v := by rw [Matrix.one_mulVec]
      _ = (((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
            (A : Matrix (Fin n) (Fin n) F)) *ᵥ v := by rw [hAA]
      _ = ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
            ((A : Matrix (Fin n) (Fin n) F) *ᵥ v) := by rw [Matrix.mulVec_mulVec]
      _ = 0 := by rw [h', Matrix.mulVec_zero]
  let Bv : Fin n → F := (A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (v i))
  have hBv : Bv = (mval * nval) • v := by
    dsimp only [Bv]
    rw [hmval, Matrix.mulVec_smul, hnval, smul_smul]
  have hBv0 : Bv ≠ 0 := by
    intro h
    rw [hBv] at h
    rcases smul_eq_zero.mp h with h' | h'
    · exact mul_ne_zero hmval0 hnval0 h'
    · exact hv0 h'
  have hmain : ∀ lam : F, lam ≠ 0 → (φ lam / lam) ^ Nat.gcd n (2 ^ f + 1) = 1 := by
    intro lam hlam
    obtain ⟨t, ht⟩ := l10su1b_exists_SU_eigen (f := f) hF hn hv0 hvv hlam
    have htline : t ∈ uLine σ v := ⟨lam, hlam, ht⟩
    have htN : t ∈ Subgroup.normalizer (R : Set (SU σ n)) := by rwa [hN]
    have hyt := hy t (by simpa [R] using htN)
    have hmem : y t * t⁻¹ ∈ (pCoreOf 2 (Subgroup.normalizer (R : Set (SU σ n))) ⊔
        Subgroup.center (SU σ n) : Subgroup (SU σ n)) := hyt
    rw [Subgroup.mem_sup_of_normal_right] at hmem
    obtain ⟨r, hr, z, hz, hrz⟩ := hmem
    have hrH : r ∈ Subgroup.normalizer (R : Set (SU σ n)) :=
      CFSG.LieType.BorelTits.pCoreOf_le 2 _ hr
    have hrline : r ∈ uLine σ v := by rwa [hN] at hrH
    obtain ⟨k, hk⟩ := isPGroup_iff_pow_pow_eq_one.mp
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) (G := SU σ n)
        (Subgroup.normalizer (R : Set (SU σ n)))) ⟨r, hr⟩
    have hk' : r ^ 2 ^ k = 1 := by simpa using congrArg Subtype.val hk
    have hrv : suMat σ n r *ᵥ v = v :=
      CFSG.Timmesfeld.Transvection.ModelRank.suMat_mulVec_eq_of_pow_two_pow hv0 hrline hk'
    obtain ⟨u, hu, hdetpow, hunitpow⟩ := l10su1c_center_scalar hF hn hz
    let ζ : F := (u : F)
    have hzv : suMat σ n z *ᵥ Bv = ζ • Bv := by
      rw [suMat_apply, hu, Matrix.scalar_apply, Matrix.diagonal_const_mulVec]
    have hrvB : suMat σ n r *ᵥ Bv = Bv := by
      rw [hBv, Matrix.mulVec_smul, hrv]
    have hyt_eq : y t = r * z * t := by
      rw [hrz]; group
    have htB : suMat σ n t *ᵥ Bv = lam • Bv := by
      rw [hBv, Matrix.mulVec_smul, ht]
      simp only [smul_smul]
      congr 1
      ring
    have hytB : suMat σ n (y t) *ᵥ Bv = (φ lam) • Bv := by
      have h := l10su1c_y_mulVec (σ := σ) (φ := φ) y (A := A) hyA t v
      have hphi : (fun i => φ ((lam • v) i)) = φ lam • (fun i => φ (v i)) := by
        ext i
        simp only [Pi.smul_apply, smul_eq_mul, map_mul]
      change suMat σ n (y t) *ᵥ Bv = (φ lam) • Bv
      rw [show Bv = (A : Matrix (Fin n) (Fin n) F) *ᵥ (fun i => φ (v i)) from rfl, h, ht,
        hphi, Matrix.mulVec_smul]
    have hytB' : suMat σ n (y t) *ᵥ Bv = (ζ * lam) • Bv := by
      rw [hyt_eq, map_mul, map_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, htB,
        Matrix.mulVec_smul, hzv, Matrix.mulVec_smul, Matrix.mulVec_smul, hrvB, smul_smul]
      congr 1
      ring
    have hscalareq : φ lam = ζ * lam := by
      have h := hytB.symm.trans hytB'
      obtain ⟨i, hi⟩ := Function.ne_iff.mp hBv0
      have h2 := congrFun h i
      simp only [Pi.smul_apply, smul_eq_mul] at h2
      exact mul_right_cancel₀ hi h2
    have hzpow : ζ ^ Nat.gcd n (2 ^ f + 1) = 1 := by
      have h1 : u ^ n = 1 := by
        apply Units.ext
        simpa using hdetpow
      have h2 : u ^ (2 ^ f + 1) = 1 := by
        apply Units.ext
        simpa using hunitpow
      have h3 : orderOf u ∣ Nat.gcd n (2 ^ f + 1) :=
        Nat.dvd_gcd (orderOf_dvd_iff_pow_eq_one.mpr h1) (orderOf_dvd_iff_pow_eq_one.mpr h2)
      have h4 : u ^ Nat.gcd n (2 ^ f + 1) = 1 := orderOf_dvd_iff_pow_eq_one.mp h3
      have := congrArg (fun w : Fˣ => (w : F)) h4
      simpa [ζ, Units.val_pow_eq_pow_val] using this
    have hratio : φ lam / lam = ζ := by
      rw [div_eq_iff hlam, hscalareq]
    rw [hratio, hzpow]
  exact ⟨A, φ, hA, hyA, l10su1_field_aut_of_div_pow hF φ hmain⟩

private theorem l10su1d_eq_one_of_mem_inf_of_isPGroup_two_of_odd {G : Type*} [Group G]
    {K R : Subgroup G} (hKodd : Odd (Nat.card K)) (hR : IsPGroup 2 R)
    {x : G} (hxR : x ∈ R) (hxK : x ∈ K) : x = 1 := by
  obtain ⟨k, hk⟩ := (isPGroup_iff_orderOf_dvd_pow.mp hR) ⟨x, hxR⟩
  rw [Subgroup.orderOf_mk] at hk
  have hdvd : orderOf x ∣ Nat.card K := Subgroup.orderOf_dvd_natCard K hxK
  exact orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (hKodd.coprime_two_left.pow_left k) hk hdvd)

open CFSG.Open in
private theorem l10su1d_mul_inv_mem_pCoreOf {K : Type} [Group K] [Finite K]
    {N : Subgroup K} {y : MulAut K} (hodd : Odd (Nat.card (Subgroup.center K)))
    (hy : ∀ m ∈ N, y m * m⁻¹ ∈ pCoreOf 2 N ⊔ Subgroup.center K)
    {m : K} (hm : m ∈ N) (hm2 : m * m = 1) :
    y m * m⁻¹ ∈ pCoreOf 2 N := by
  obtain ⟨r, hrP, z, hzZ, hrz⟩ :=
    (Subgroup.mem_sup_of_normal_right (s := pCoreOf 2 N) (t := Subgroup.center K)).mp
      (hy m hm)
  have hzr : Commute z r := (Subgroup.mem_center_iff.mp hzZ r).symm
  have hzm : Commute z m := (Subgroup.mem_center_iff.mp hzZ m).symm
  have hm_inv : m⁻¹ = m := inv_eq_of_mul_eq_one_right hm2
  have hy2 : (y m) * (y m) = 1 := by
    have h := map_mul y m m
    rw [hm2, map_one] at h
    exact h.symm
  have hc_eq : y m = z * (r * m) := by
    have h1 : y m = (r * z) * m := by
      rw [hrz]
      group
    rw [h1, mul_assoc, hzm.eq, ← mul_assoc]
    exact (hzr.mul_right hzm).eq.symm
  have hcomm_rm : Commute z (r * m) := hzr.mul_right hzm
  have hsq : (y m) * (y m) = z ^ 2 * ((r * m) * (r * m)) := by
    rw [hc_eq, ← pow_two, hcomm_rm.mul_pow 2, pow_two, pow_two]
  have hconj : m * r * m⁻¹ ∈ pCoreOf 2 N :=
    (Subgroup.mem_normalizer_iff.mp
      (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 N hm) r).mp hrP
  have hrmsq : (r * m) * (r * m) ∈ pCoreOf 2 N := by
    have h : (r * m) * (r * m) = r * (m * r * m⁻¹) := by rw [hm_inv]; group
    rw [h]
    exact (pCoreOf 2 N).mul_mem hrP hconj
  have hz2P : z ^ 2 ∈ pCoreOf 2 N := by
    have h : z ^ 2 * ((r * m) * (r * m)) = 1 := by rw [← hsq, hy2]
    rw [eq_inv_of_mul_eq_one_left h]
    exact (pCoreOf 2 N).inv_mem hrmsq
  have hz2Z : z ^ 2 ∈ Subgroup.center K := (Subgroup.center K).pow_mem hzZ 2
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hz2 : z ^ 2 = 1 := l10su1d_eq_one_of_mem_inf_of_isPGroup_two_of_odd hodd
    (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 N) hz2P hz2Z
  have hz1 : z = 1 := by
    have hdvd1 : orderOf z ∣ 2 := by
      have h : z ^ 2 = 1 := hz2
      exact orderOf_dvd_of_pow_eq_one h
    have hdvd2 : orderOf z ∣ Nat.card (Subgroup.center K) :=
      Subgroup.orderOf_dvd_natCard (Subgroup.center K) hzZ
    exact orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes hodd.coprime_two_left hdvd1 hdvd2)
  rw [← hrz, hz1, mul_one]
  exact hrP

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1d_uForm_phi {F : Type} [Field F] {σ φ : F ≃+* F} {n : ℕ}
    (hcomm : ∀ c, φ (σ c) = σ (φ c)) (x y : Fin n → F) :
    uForm σ (fun i => φ (x i)) (fun i => φ (y i)) = φ (uForm σ x y) := by
  rw [uForm_eq, uForm_eq, map_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [map_mul, ← hcomm]

open CFSG.Timmesfeld.LieEmbed Matrix in
private theorem l10su1d_B_uForm {F : Type} [Field F] {n : ℕ} {σ φ : F ≃+* F}
    (hcomm : ∀ c, φ (σ c) = σ (φ c))
    {A : Matrix (Fin n) (Fin n) F}
    (hA : conjTr σ A * antidiag n * A = antidiag n) (x y : Fin n → F) :
    uForm σ (A *ᵥ (fun i => φ (x i))) (A *ᵥ (fun i => φ (y i))) = φ (uForm σ x y) := by
  rw [l10su1_uForm_isometry hA, l10su1d_uForm_phi hcomm]

private theorem l10su1d_rev_ne {n : ℕ} {p q : Fin n} (h : p ≠ Fin.rev q) : Fin.rev p ≠ q :=
  fun hh => h (by have := congrArg Fin.rev hh; rwa [Fin.rev_rev] at this)

private theorem l10su1d_rev_ne_rev {n : ℕ} {p q : Fin n} (h : p ≠ q) :
    Fin.rev p ≠ Fin.rev q := fun hh => h (Fin.rev_injective hh)

open CFSG.Timmesfeld.LieEmbed in
private theorem l10su1d_uForm_single_apply {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    (a b : Fin n) :
    uForm σ (Pi.single a 1 : Fin n → F) (Pi.single b 1) =
      if b = Fin.rev a then 1 else 0 := by
  rw [uForm_single_left, Pi.single_apply]
  by_cases h : b = Fin.rev a
  · rw [if_pos h, if_pos h.symm]
  · rw [if_neg h, if_neg (fun hh => h hh.symm)]

open CFSG.Timmesfeld.LieEmbed in
private theorem l10su1d_uForm_single_eq_zero {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    {a b : Fin n} (h : b ≠ Fin.rev a) :
    uForm σ (Pi.single a 1 : Fin n → F) (Pi.single b 1) = 0 := by
  rw [l10su1d_uForm_single_apply, if_neg h]

open CFSG.Timmesfeld.LieEmbed in
private theorem l10su1d_uForm_single_eq_one {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    {a b : Fin n} (h : b = Fin.rev a) :
    uForm σ (Pi.single a 1 : Fin n → F) (Pi.single b 1) = 1 := by
  rw [l10su1d_uForm_single_apply, if_pos h]

open CFSG.Timmesfeld.LieEmbed in
private theorem l10su1d_uForm_expand4 {F : Type} [Field F] {σ : F ≃+* F} {n : ℕ}
    (a b c d : F) (x y z w : Fin n → F) :
    uForm σ (a • x + b • y) (c • z + d • w) =
      σ a * c * uForm σ x z + σ a * d * uForm σ x w +
        σ b * c * uForm σ y z + σ b * d * uForm σ y w := by
  simp only [uForm_add_left, uForm_add_right, uForm_smul_left, uForm_smul_right]
  ring

open CFSG.Timmesfeld.LieEmbed CFSG.Timmesfeld.Transvection.ModelRank Matrix in
private theorem l10su1_not_bar {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) (hnf : ¬ (n = 3 ∧ f = 1))
    (hdvd : (2 ^ f + 1) ∣ n)
    {β : Fin (Unitary.rootDatum hF n).rank → ℤ} (hl : GGLongRoot (Unitary.rootDatum hF n) β)
    (y : MulAut ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (hyR : ((Unitary.rootDatum hF n).rootGroup β).map y.toMonoidHom =
      (Unitary.rootDatum hF n).rootGroup β)
    (hy : ∀ m ∈ Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))),
      y m * m⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))) ⊔
        Subgroup.center ↥(Unitary.SU (unitaryInvolution F 2 f) n))
    (A : GL (Fin n) F) (hA : conjTr (unitaryInvolution F 2 f) (A : Matrix (Fin n) (Fin n) F) *
      antidiag n * (A : Matrix (Fin n) (Fin n) F) = antidiag n)
    (φ : F ≃+* F) (hφ : ∀ c : F, φ c = c ^ 2 ^ f)
    (hyA : ∀ x : ↥(Unitary.SU (unitaryInvolution F 2 f) n),
      ((y x : ↥(Unitary.SU (unitaryInvolution F 2 f) n)) : GL (Fin n) F) =
        A * glAut φ (x : GL (Fin n) F) * A⁻¹) :
    False := by
  classical
  let σ : F ≃+* F := unitaryInvolution F 2 f
  have hσ' : ∀ c, σ (σ c) = c := CFSG.LieType.BorelTits.unitaryInvolution_involutive hF
  have hσpow : ∀ c, σ c = c ^ 2 ^ f := by
    intro c
    exact CFSG.LieType.BorelTits.unitaryInvolution_apply F 2 f c
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with hf0 | hf
    · exfalso
      rw [hf0] at hF
      simp at hF
      have h2 : 1 < Nat.card F := Finite.one_lt_card
      omega
    · exact hf
  have h2pow : 2 ≤ 2 ^ f := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  have hn3 : n ≠ 3 := by
    rintro rfl
    have hle : 2 ^ f + 1 ≤ 3 := Nat.le_of_dvd (by norm_num) hdvd
    have hge : 3 ≤ 2 ^ f + 1 := by omega
    have h2 : 2 ^ f = 2 := by omega
    exact hnf ⟨rfl, Nat.pow_right_injective (by norm_num : 2 ≤ 2) (by simpa using h2)⟩
  have hn4 : 4 ≤ n := by omega
  have hβ : β ∈ (Unitary.rootDatum hF n).roots := by
    obtain ⟨w, γ₀, hγ₀, hmax, rfl⟩ := hl
    exact CFSG.LieType.CurtisTits.weylAction_mem_roots (D := Unitary.rootDatum hF n) hγ₀ w
  obtain ⟨i, hi, hβi⟩ := l10su1c_exists_weight_of_ggLongRoot hF hβ hl
  let v : Fin n → F := Pi.single i 1
  let w : Fin n → F := Pi.single (Fin.rev i) 1
  have hvv : uForm σ v v = 0 := by
    change uForm (unitaryInvolution F 2 f) (Pi.single i 1) (Pi.single i 1) = 0
    exact uForm_single_self (σ := unitaryInvolution F 2 f) hi
  have hww : uForm σ w w = 0 := by
    change uForm (unitaryInvolution F 2 f) (Pi.single (Fin.rev i) 1)
      (Pi.single (Fin.rev i) 1) = 0
    refine uForm_single_self (σ := unitaryInvolution F 2 f) ?_
    intro h
    exact hi (by rw [Fin.rev_rev] at h; exact h.symm)
  have hvw : uForm σ v w = 1 := by
    change uForm (unitaryInvolution F 2 f) (Pi.single i 1) (Pi.single (Fin.rev i) 1) = 1
    rw [CFSG.Timmesfeld.LieEmbed.uForm_single_right, Fin.rev_rev, Pi.single_eq_same, map_one]
  have hv0 : v ≠ 0 := by
    intro h
    have := congrFun h i
    simp [v] at this
  let R : Subgroup (SU σ n) := (Unitary.rootDatum hF n).rootGroup β
  have hRd : R = Unitary.rootGroup σ hσ' n β := rfl
  have hT : IsUTransGroup σ v R := by
    rw [hRd]
    exact CFSG.Timmesfeld.Transvection.ModelRank.isUTransGroup_rootGroup_long' hσ' hi hβi
  have h1 : (1 : F) + σ 1 = 0 := by rw [map_one]; exact CharTwo.add_self_eq_zero 1
  have hN : Subgroup.normalizer (R : Set (SU σ n)) = uLine σ v :=
    CFSG.Timmesfeld.Transvection.ModelRank.normalizer_eq_uLine hσ' hv0 hT
  have hcomm : ∀ c, φ (σ c) = σ (φ c) := by
    intro c
    rw [hσpow c, hσpow (φ c), map_pow]
  have hTgl : (R.map (SU σ n).subtype).map (glAut φ).toMonoidHom =
      R.map (SU σ n).subtype := by
    rw [hRd]
    exact l10su1b_glAut_rootGroup_map_eq (σ := σ) hσ' hcomm β
  obtain ⟨x1, hx1⟩ := hT.2 1 h1
  have htgl : l10su1b_uTransGL hvv 1 ∈ R.map (SU σ n).subtype := by
    refine ⟨x1, (hT.1 x1).mpr ⟨1, h1, hx1⟩, ?_⟩
    exact Units.ext hx1
  have hpre : l10su1b_uTransGL hvv 1 ∈
      (R.map (SU σ n).subtype).map (glAut φ).toMonoidHom := by
    rw [hTgl]
    exact htgl
  rw [Subgroup.mem_map] at hpre
  obtain ⟨g, hgT, hgg⟩ := hpre
  rw [Subgroup.mem_map] at hgT
  obtain ⟨x', hx'R, hx'g⟩ := hgT
  have hglx' : glAut φ (x' : GL (Fin n) F) = l10su1b_uTransGL hvv 1 := by
    have hx'g' : (x' : GL (Fin n) F) = g := hx'g
    rw [hx'g']
    exact hgg
  have hyR' : R.map y.toMonoidHom = R := by simpa [R] using hyR
  have hyx'R : y x' ∈ R := by
    have h : y x' ∈ R.map y.toMonoidHom := ⟨x', hx'R, rfl⟩
    rwa [hyR'] at h
  have hyx'mat : ((y x' : SU σ n) : GL (Fin n) F) =
      A * l10su1b_uTransGL hvv 1 * A⁻¹ := by
    rw [hyA x', hglx']
  have hAmat : (A : Matrix (Fin n) (Fin n) F) * uTrans σ v 1 *
      ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
    have hmul := CFSG.Timmesfeld.LieEmbed.mul_uTrans_of_isometry (σ := σ) hA v 1
    have hAA : (A : Matrix (Fin n) (Fin n) F) *
        ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = 1 := by
      have := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
        (mul_inv_cancel A)
      simpa using this
    calc (A : Matrix (Fin n) (Fin n) F) * uTrans σ v 1 *
          ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)
        = uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 *
            (A : Matrix (Fin n) (Fin n) F) *
          ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) := by rw [hmul]
      _ = uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
            rw [Matrix.mul_assoc, hAA, Matrix.mul_one]
  have hmatA : (((y x' : SU σ n) : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
    have h := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F)) hyx'mat
    rw [h]
    change (A : Matrix (Fin n) (Fin n) F) *
      ((l10su1b_uTransGL hvv 1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
      ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1
    rw [show ((l10su1b_uTransGL hvv 1 : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F) = uTrans σ v 1 from rfl]
    exact hAmat
  have hyx'T : suMat σ n (y x') = uTrans σ (((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) 1 := by
    rw [suMat_apply]
    exact hmatA
  obtain ⟨dA, hdAσ, hdAmat⟩ := (hT.1 (y x')).mp hyx'R
  obtain ⟨nval, hnval⟩ := l10su1b_smul_of_uTrans_eq (σ := σ)
    (v := ((A : Matrix (Fin n) (Fin n) F)) *ᵥ v) (w := v) (d := dA)
    (by rw [← hyx'T]; exact hdAmat)
  have hnval0 : nval ≠ 0 := by
    intro h
    apply hv0
    have h' : (A : Matrix (Fin n) (Fin n) F) *ᵥ v = 0 := by rw [hnval, h, zero_smul]
    have hAA : ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
        (A : Matrix (Fin n) (Fin n) F) = 1 := by
      simpa using congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
        (inv_mul_cancel A)
    calc v = (1 : Matrix (Fin n) (Fin n) F) *ᵥ v := by rw [Matrix.one_mulVec]
      _ = (((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
            (A : Matrix (Fin n) (Fin n) F)) *ᵥ v := by rw [hAA]
      _ = ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
            ((A : Matrix (Fin n) (Fin n) F) *ᵥ v) := by rw [Matrix.mulVec_mulVec]
      _ = 0 := by rw [h', Matrix.mulVec_zero]
  have hAA0 : ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *
      (A : Matrix (Fin n) (Fin n) F) = 1 := by
    simpa using congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F))
      (inv_mul_cancel A)
  have hAinv : ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ v = nval⁻¹ • v := by
    calc ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ v
        = ((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
            (nval⁻¹ • ((A : Matrix (Fin n) (Fin n) F) *ᵥ v)) := by
            congr 1
            rw [hnval, smul_smul, inv_mul_cancel₀ hnval0, one_smul]
      _ = nval⁻¹ • (((A⁻¹ : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) *ᵥ
            ((A : Matrix (Fin n) (Fin n) F) *ᵥ v)) := by rw [Matrix.mulVec_smul]
      _ = nval⁻¹ • v := by rw [Matrix.mulVec_mulVec, hAA0, Matrix.one_mulVec]
  have hcIdx : ∃ c : Fin n, c ≠ i ∧ c ≠ Fin.rev i ∧ c ≠ Fin.rev c := by
    by_contra h
    push Not at h
    have hfix : ∀ c : Fin n, c ≠ i → c ≠ Fin.rev i → c = Fin.rev c :=
      fun c h1 h2 => h c h1 h2
    let T : Finset (Fin n) := (Finset.univ.erase i).erase (Fin.rev i)
    have h2mem : Fin.rev i ∈ (Finset.univ.erase i : Finset (Fin n)) := by
      rw [Finset.mem_erase]
      exact ⟨fun hh => hi hh.symm, Finset.mem_univ _⟩
    have hTcard : T.card = n - 2 := by
      dsimp only [T]
      rw [Finset.card_erase_of_mem h2mem, Finset.card_erase_of_mem (Finset.mem_univ i),
        Finset.card_univ, Fintype.card_fin]
      omega
    have hT1 : 1 < T.card := by rw [hTcard]; omega
    obtain ⟨a, haT, b, hbT, hab⟩ := Finset.one_lt_card.mp hT1
    have ha : a ≠ i ∧ a ≠ Fin.rev i := by
      have h1 := Finset.mem_erase.mp haT
      exact ⟨(Finset.mem_erase.mp h1.2).1, h1.1⟩
    have hb : b ≠ i ∧ b ≠ Fin.rev i := by
      have h1 := Finset.mem_erase.mp hbT
      exact ⟨(Finset.mem_erase.mp h1.2).1, h1.1⟩
    exact hab (l10su1_rev_eq_self_unique (hfix a ha.1 ha.2) (hfix b hb.1 hb.2))
  let cIdx : Fin n := Classical.choose hcIdx
  have hc1 : cIdx ≠ i := (Classical.choose_spec hcIdx).1
  have hc2 : cIdx ≠ Fin.rev i := (Classical.choose_spec hcIdx).2.1
  have hc3 : cIdx ≠ Fin.rev cIdx := (Classical.choose_spec hcIdx).2.2
  have hnq : (n, 2 ^ f) ≠ (3, 2) := by
    intro h
    have h1 : n = 3 := congrArg Prod.fst h
    have h2 : 2 ^ f = 2 := congrArg Prod.snd h
    exact hnf ⟨h1, Nat.pow_right_injective (by norm_num : 2 ≤ 2) (by simpa using h2)⟩
  have hoddCenter : Odd (Nat.card (Subgroup.center (SU σ n))) :=
    CFSG.SeitzReduction.SymplecticPilot.odd_card_center_SU hF hf hn hnq
  have htr : ∀ c : F, σ c = c → ∃ e, e + σ e = c :=
    fun c hc => CFSG.LieType.BorelTits.exists_add_unitaryInvolution_eq hF hc
  have hnormu : ∀ c : F, σ c = c → ∃ l, σ l * l = c :=
    fun c hc => CFSG.Timmesfeld.LieEmbed.exists_sigma_mul_self_eq (p := 2) (f := f) hF hc
  have hΘ : SUThetaFacts σ v w R := suThetaFacts_holds hσ' htr hvv hww hvw hT
  have hG : SUGeomFacts σ v w := suGeomFacts_holds hσ' htr hnormu hn4 hvv hww hvw
  have hPcore : pCoreOf 2 (Subgroup.normalizer (R : Set (SU σ n))) = uRad σ v :=
    pCoreOf_normalizer_eq_uRad hσ' hv0 hT hΘ hG
  have hBu_all : ∀ u : Fin n → F, u ∈ perpPair σ v w → uForm σ u u = 0 → u ≠ 0 →
      ∃ a b : F, A *ᵥ (fun i => φ (u i)) = a • u + b • v := by
    intro u huW huiso hu0
    obtain ⟨k, hk⟩ : ∃ k, u k ≠ 0 := by
      by_contra h
      push Not at h
      exact hu0 (funext h)
    have hui : u i = 0 := by
      have h := huW.2
      rw [show w = Pi.single (Fin.rev i) 1 from rfl,
        CFSG.Timmesfeld.LieEmbed.uForm_single_left (Fin.rev i) u, Fin.rev_rev] at h
      exact h
    have huir : u (Fin.rev i) = 0 := by
      have h := huW.1
      rw [show v = Pi.single i 1 from rfl,
        CFSG.Timmesfeld.LieEmbed.uForm_single_left i u] at h
      exact h
    have hki : k ≠ i := fun h => hk (h ▸ hui)
    have hkir : k ≠ Fin.rev i := fun h => hk (h ▸ huir)
    let x' : Fin n → F := Pi.single (Fin.rev k) 1
    have hx'W : x' ∈ perpPair σ v w := by
      have hx'eq : x' = Pi.single (Fin.rev k) 1 := rfl
      refine mem_perpPair.mpr ⟨?_, ?_⟩
      · rw [show v = Pi.single i 1 from rfl, hx'eq,
          CFSG.Timmesfeld.LieEmbed.uForm_single_left i (Pi.single (Fin.rev k) 1),
          Pi.single_apply]
        exact if_neg (fun h => hki (by
          have h2 := congrArg Fin.rev h
          rw [Fin.rev_rev, Fin.rev_rev] at h2
          exact h2.symm))
      · rw [show w = Pi.single (Fin.rev i) 1 from rfl, hx'eq,
          CFSG.Timmesfeld.LieEmbed.uForm_single_left (Fin.rev i) (Pi.single (Fin.rev k) 1),
          Fin.rev_rev, Pi.single_apply]
        exact if_neg (fun h => hkir (by
          have h2 := congrArg Fin.rev h
          rw [Fin.rev_rev] at h2
          exact h2.symm))
    have hux' : uForm σ u x' ≠ 0 := by
      rw [show x' = Pi.single (Fin.rev k) 1 from rfl,
        CFSG.Timmesfeld.LieEmbed.uForm_single_right u (Fin.rev k), Fin.rev_rev]
      exact (map_ne_zero σ).mpr hk
    obtain ⟨τ, hτ⟩ :=
      CFSG.Timmesfeld.Transvection.ModelRank.exists_suMat_eq_uTrans hσ' huiso h1
    have huv : uForm σ u v = 0 := by
      rw [← CFSG.Timmesfeld.LieEmbed.uForm_conj σ hσ' v u, huW.1, map_zero]
    have hτv : suMat σ n τ *ᵥ v = v := by
      rw [hτ, CFSG.Timmesfeld.LieEmbed.uTrans_mulVec, huv, mul_zero, zero_smul, add_zero]
    have hτ2 : τ * τ = 1 := by
      apply eq_of_suMat_mulVec_eq (σ := σ)
      intro z
      rw [map_mul, hτ, CFSG.Timmesfeld.LieEmbed.uTrans_mul_uTrans σ huiso,
        show (1 : F) + 1 = 0 from CharTwo.add_self_eq_zero 1,
        CFSG.Timmesfeld.LieEmbed.uTrans_zero, map_one, Matrix.one_mulVec]
    have hτline : τ ∈ uLine σ v := ⟨1, one_ne_zero, by rw [hτv, one_smul]⟩
    have hτN : τ ∈ Subgroup.normalizer (R : Set (SU σ n)) := by rw [hN]; exact hτline
    have hyt : y τ * τ⁻¹ ∈ uRad σ v := by
      rw [← hPcore]
      exact l10su1d_mul_inv_mem_pCoreOf hoddCenter (fun m hm => hy m hm) hτN hτ2
    set r : SU σ n := y τ * τ⁻¹ with hr_def
    have hr : r ∈ uRad σ v := by rw [hr_def]; exact hyt
    have hyτ : y τ = r * τ := by rw [hr_def]; group
    set Bx' : Fin n → F := A *ᵥ (fun i => φ (x' i)) with hBx'_def
    set Bu : Fin n → F := A *ᵥ (fun i => φ (u i)) with hBu_def
    have hBv : A *ᵥ (fun i => φ (v i)) = nval • v := by
      have hvphi : (fun i => φ (v i)) = v := by
        funext j
        by_cases hj : j = i
        · subst hj; simp [v]
        · simp [v, Pi.single_apply, hj]
      rw [hvphi, hnval]
    have hBx'v : uForm σ v Bx' = 0 := by
      have h := l10su1d_B_uForm hcomm hA v x'
      rw [hBv, ← hBx'_def, hx'W.1, map_zero] at h
      rw [CFSG.Timmesfeld.LieEmbed.uForm_smul_left] at h
      exact (mul_eq_zero.mp h).resolve_left ((map_ne_zero σ).mpr hnval0)
    have hperp : uForm σ v (suMat σ n τ *ᵥ Bx') = 0 := by
      have h := CFSG.Timmesfeld.LieEmbed.uForm_mulVec σ τ v Bx'
      rw [hτv, hBx'v] at h
      exact h
