theorem ggRootNormInnerZ_su_long {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n) (hnf : ¬ (n = 3 ∧ f = 1))
    {β : Fin (Unitary.rootDatum hF n).rank → ℤ} (hl : GGLongRoot (Unitary.rootDatum hF n) β)
    (u : ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
    PSL.GGRootNormInnerZ
      (((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom) := by
  have hroot : PSL.GGRootNormInnerZ ((Unitary.rootDatum hF n).rootGroup β) := by
    intro y hy2 hyR hyC
    obtain ⟨A, φ, hA, hyA, hcases⟩ := l10su1_field_part hF hn hnf hl y hyR hyC
    rcases hcases with hrefl | ⟨hdvd, hbar⟩
    · refine inner_of_isometry hF hn y hy2 A hA ?_
      intro x
      have h1 : glAut (RingEquiv.refl F) = (1 : MulAut (GL (Fin n) F)) := map_one glAut
      rw [hyA x, hrefl, h1]
      simp
    · exact (l10su1_not_bar hF hn hnf hdvd hl y hyR hyC A hA φ hbar hyA).elim
  exact l10su1_innerZ_map_mulEquiv (MulAut.conj u) hroot

