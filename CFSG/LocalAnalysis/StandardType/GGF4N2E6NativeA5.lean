variable {F : Type} [Field F] [Finite F] [CharP F 2]

theorem e6Isogeny_slToE6Sc_blockSL2 (k : Fin 5) (s : SL(2, F)) :
    ((e6Isogeny F (slToE6Sc F (blockSL2 F 5 k s)) : ↥(adjointGroup .E6 F)) : ModGL .E6 F) =
      rootSL2 .E6 F (Pi.single (CFSG.SeitzReduction.E6Pilot.chainNode k) 1) s := by
  have hext : (adjointGroup .E6 F).subtype.comp
      ((e6Isogeny F).comp ((slToE6Sc F).comp (blockSL2 F 5 k))) =
      rootSL2 .E6 F (Pi.single (CFSG.SeitzReduction.E6Pilot.chainNode k) 1) := by
    refine MonoidHom.eq_of_eqOn_dense
      (CFSG.LocalAnalysis.ComponentInitial.sl2_closure_upper_lower (K := F)) ?_
    rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩)
    · have hu : CFSG.LocalAnalysis.ComponentInitial.sl2Upper F c = uSL c := rfl
      have hx : (rootOperatorFamily .E6).eltElement
          (simpleRoot .E6 (CFSG.SeitzReduction.E6Pilot.chainNode k)) c =
          xElement (CFSG.SeitzReduction.E6Pilot.chainNode k) c :=
        Subtype.ext ((rootOperatorFamily .E6).eltUnit_simple _ c)
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype]
      rw [hu, CFSG.RankThree.PartOne.KA5L.blockSL2_uSL, slToE6Sc_transvection_castSucc_succ,
        e6Isogeny_xm_single, hx,
        CFSG.RankThree.Chevalley.rootSL2_uSL_of_charTwo (isRoot_single .E6 _), pinnedX_single]
      rfl
    · have hv : CFSG.LocalAnalysis.ComponentInitial.sl2Lower F c = vSL c := rfl
      have hy : (rootOperatorFamily .E6).eltElement
          (-simpleRoot .E6 (CFSG.SeitzReduction.E6Pilot.chainNode k)) c =
          yElement (CFSG.SeitzReduction.E6Pilot.chainNode k) c :=
        Subtype.ext ((rootOperatorFamily .E6).eltUnit_neg_simple _ c)
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype]
      rw [hv, CFSG.RankThree.PartOne.KA5L.blockSL2_vSL, slToE6Sc_transvection_succ_castSucc,
        e6Isogeny_xm_neg_single, hy,
        CFSG.RankThree.Chevalley.rootSL2_vSL_of_charTwo (isRoot_single .E6 _), pinnedX_neg_single]
      rfl
  exact DFunLike.congr_fun hext s

theorem e6Isogeny_slToE6Sc_blockSL2_gamma (i : Fin 3) (s : SL(2, F)) :
    ((e6Isogeny F (slToE6Sc F (blockSL2 F 5 ⟨2 * i, by omega⟩ s)) : ↥(adjointGroup .E6 F)) :
        ModGL .E6 F) =
      rootSL2 .E6 F (e6NativeGamma i.castSucc) s := by
  rw [e6Isogeny_slToE6Sc_blockSL2]
  congr 2
  revert i
  decide

end CFSG.StandardType.N2E6Native

