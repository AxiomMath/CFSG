@[expose] def a4cS (k : Fin 4) : Vn 5 ≃ₗ[ZMod 3] Vn 5 := letLin (letAt a4cGens k)

theorem a4c_certOK : certOK a4cGens (oneN 5) a4cSets a4cPats a4cReps a4cS2 = true := by
  decide +kernel

theorem a4c_cov : permCovB 5 a4cPats = true := by
  decide +kernel

theorem a4c_adj : ∀ i : Fin 4, letAt a4cGens i =
    (Pi.single i.castSucc 1 - Pi.single i.succ 1, Pi.single i.castSucc 1 - Pi.single i.succ 1) := by
  decide +kernel

theorem a4c_test : ∀ A Mg : Subgroup (Vn 5 ≃ₗ[ZMod 3] Vn 5),
    TestHyp (Subgroup.closure (Set.range a4cS)) (oneN 5) A Mg →
    ∀ r ∈ Mg, IsRefl r → ¬ FixesLine (oneN 5) r →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (oneN 5) t → t ∈ Mg :=
  linTest_perm_of_certOK a4cS a4cGens rfl (fun _ => rfl)
    (permGroup_le_of_gens a4cS a4cGens (fun _ => rfl) (by norm_num) a4c_adj)
    a4c_certOK a4c_cov

end CFSG.StandardType.TestLin

