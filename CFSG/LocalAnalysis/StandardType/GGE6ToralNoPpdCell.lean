theorem finsum_cellSum_of_familyKernel_eq_parabolicRoots
    [Fintype (WeylGroup Tag.E6)] {K : Type} [Field K] {b : Fin Tag.E6.rank → Kˣ}
    {J : Set (Fin Tag.E6.rank)} (hkerJ : familyKernel (fun _ : Unit => b) = parabolicRoots Tag.E6 J)
    (q : ℕ) :
    ∑ᶠ w : familyStabilizerSubgroup (fun _ : Unit => b),
        q ^ (familyKernel (fun _ : Unit => b) ∩ inversionSet (w : WeylGroup Tag.E6)).ncard =
      Nat.card (kernelPosStabilizer (rootCharHom3 b)) * parabolicSum Tag.E6 J q := by
  classical
  set χ := rootCharHom3 b with hχ
  have hS : ∀ w : WeylGroup Tag.E6,
      w ∈ familyStabilizerSubgroup (fun _ : Unit => b) ↔ w ∈ charStabilizer χ := fun w => by
    rw [familyStabilizerSubgroup, Subgroup.mem_iInf]
    exact ⟨fun h => h (), fun h _ => h⟩
  have hSig : familyKernel (fun _ : Unit => b) = kernelRoots χ :=
    Set.ext fun α => ⟨fun h => ⟨h.1, h.2 ()⟩, fun h => ⟨h.1, fun _ => h.2⟩⟩
  have hker : kernelRoots χ = parabolicRoots Tag.E6 J := hSig.symm.trans hkerJ
  have hWJ : kernelWeylGroup χ = parabolicWeylGroup Tag.E6 J := by
    refine le_antisymm ?_ ?_
    · rw [kernelWeylGroup_eq_closure, Subgroup.closure_le]
      rintro _ ⟨α, hα, rfl⟩
      rw [hker] at hα
      obtain ⟨u, hu, j, hj, hu'⟩ := CFSG.RankThree.Chevalley.exists_smul_single_of_mem_parabolicRoots hα
      rw [SetLike.mem_coe, rootReflection_eq_conj hu']
      exact mul_mem (mul_mem hu (Subgroup.subset_closure ⟨j, hj, rfl⟩)) (inv_mem hu)
    · rw [parabolicWeylGroup, Subgroup.closure_le]
      rintro _ ⟨j, hj, rfl⟩
      have hej : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ kernelRoots χ := by
        rw [hker]
        exact single_mem_parabolicRoots hj
      have h := rootReflection_mem_kernelWeylGroup hej
      rwa [rootReflection_eq_conj (w := 1) (one_smul _ _), one_mul, inv_one, mul_one] at h
  have hWJmem : ∀ u : parabolicWeylGroup Tag.E6 J, (u : WeylGroup Tag.E6) ∈ kernelWeylGroup χ :=
    fun u => by rw [hWJ]; exact u.2
  have hlen : ∀ u : parabolicWeylGroup Tag.E6 J,
      (kernelRoots χ ∩ inversionSet (u : WeylGroup Tag.E6)).ncard =
        (coxeterSystem Tag.E6).length (u : WeylGroup Tag.E6) := by
    intro u
    have hsub : inversionSet (u : WeylGroup Tag.E6) ⊆ kernelRoots χ := by
      intro α hα
      rw [hker]
      exact (inversionSet_subset_parabolicPosRoots u.2 hα).1
    rw [Set.inter_eq_right.2 hsub, (weyl_inversion_length Tag.E6).1]
  haveI : Fintype (familyStabilizerSubgroup fun _ : Unit => b) := Fintype.ofFinite _
  haveI : Fintype (kernelPosStabilizer χ) := Fintype.ofFinite _
  haveI : Fintype (parabolicWeylGroup Tag.E6 J) := Fintype.ofFinite _
  let F : parabolicWeylGroup Tag.E6 J × kernelPosStabilizer χ →
      familyStabilizerSubgroup (fun _ : Unit => b) := fun p =>
    ⟨(p.1 : WeylGroup Tag.E6) * p.2,
      (hS _).2 (mul_mem (kernelWeylGroup_le (hWJmem p.1)) (kernelPosStabilizer_le p.2.2))⟩
  have hF : Function.Bijective F := by
    constructor
    · rintro ⟨u, o⟩ ⟨u', o'⟩ h
      have h' : (u : WeylGroup Tag.E6) * o = u' * o' := congrArg Subtype.val h
      obtain ⟨p, -, hp⟩ := existsUnique_mul_of_mem_charStabilizer ((hS _).1 (F (u, o)).2)
      have e1 := hp ((u : WeylGroup Tag.E6), (o : WeylGroup Tag.E6)) ⟨hWJmem u, o.2, rfl⟩
      have e2 := hp ((u' : WeylGroup Tag.E6), (o' : WeylGroup Tag.E6)) ⟨hWJmem u', o'.2, h'⟩
      have e3 := e1.trans e2.symm
      simp only [Prod.mk.injEq] at e3
      rw [Subtype.ext e3.1, Subtype.ext e3.2]
    · rintro ⟨w, hw⟩
      obtain ⟨p, ⟨hu, ho, hwp⟩, -⟩ := existsUnique_mul_of_mem_charStabilizer ((hS w).1 hw)
      have hu' : p.1 ∈ parabolicWeylGroup Tag.E6 J := by rw [← hWJ]; exact hu
      refine ⟨(⟨p.1, hu'⟩, ⟨p.2, ho⟩), Subtype.ext ?_⟩
      change p.1 * p.2 = w
      rw [hwp]
  have hterm : ∀ p : parabolicWeylGroup Tag.E6 J × kernelPosStabilizer χ,
      q ^ (kernelRoots χ ∩ inversionSet ((Equiv.ofBijective F hF p :
        familyStabilizerSubgroup (fun _ : Unit => b)) : WeylGroup Tag.E6)).ncard =
        q ^ (coxeterSystem Tag.E6).length (p.1 : WeylGroup Tag.E6) := by
    intro p
    change q ^ (kernelRoots χ ∩ inversionSet ((p.1 : WeylGroup Tag.E6) * p.2)).ncard = _
    rw [CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6ThreeInner.ncard_kernelRoots_inter_inversionSet_mul _ p.2.2, hlen]
  rw [hSig, finsum_eq_sum_of_fintype, ← (Equiv.ofBijective F hF).sum_comp]
  simp only [hterm]
  rw [Fintype.sum_prod_type]
  simp only [Finset.sum_const, Finset.card_univ, smul_eq_mul]
  rw [← Finset.mul_sum, ← CFSG.LieType.SeitzGeneration.finsum_parabolicWeylGroup_eq J q,
    finsum_eq_sum_of_fintype, Nat.card_eq_fintype_card]

private theorem geomSum_mul_sub_one (n s q : ℕ) (hq : 1 ≤ q) :
    geomSum n s q * (q ^ s - 1) = q ^ (s * n) - 1 := by
  induction n with
  | zero => simp [geomSum]
  | succ n ih =>
    rw [geomSum, Finset.sum_range_succ, ← geomSum, add_mul, ih,
      show s * (n + 1) = s * n + s by ring, pow_add]
    have h1 : 1 ≤ q ^ (s * n) := Nat.one_le_pow _ _ hq
    have h2 : 1 ≤ q ^ s := Nat.one_le_pow _ _ hq
    have h3 : 1 ≤ q ^ (s * n) * q ^ s := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
    zify [h1, h2, h3]
    ring

private theorem excE6Fac_bound : ∀ i : Fin Tag.E6.rank, ∀ x ∈ excE6Fac i,
    1 ≤ x.1 ∧ 1 ≤ x.2 ∧ x.1 * x.2 ≤ 8 := by
  decide +kernel

theorem not_dvd_parabolicSum_of_ppd
    [Fintype (WeylGroup Tag.E6)] {f : ℕ} (hf : 1 ≤ f) {J : Set (Fin Tag.E6.rank)}
    (hJ : J ≠ Set.univ) {e r : ℕ} (he : e ∈ ggOutdiagExpsE6) (hr : IsTwoPowPpd f e r) :
    ¬ r ∣ parabolicSum Tag.E6 J (2 ^ f) := by
  classical
  have he9 : 9 ≤ e := by
    simp only [ggOutdiagExpsE6, List.mem_cons, List.not_mem_nil, or_false] at he
    omega
  obtain ⟨i, hi⟩ : ∃ i, i ∉ J := by
    by_contra h
    push Not at h
    exact hJ (Set.eq_univ_of_forall h)
  have hsub : J ⊆ (maskSet Tag.E6 (excE6Mask i) : Set (Fin Tag.E6.rank)) := fun k hk =>
    excE6Mask_cover i k (fun h => hi (h ▸ hk))
  intro hdvd
  have hdvd' : r ∣ parabolicSum Tag.E6 (maskSet Tag.E6 (excE6Mask i)) (2 ^ f) := by
    rw [parabolicSum_eq_mul hsub]
    exact Dvd.dvd.mul_left hdvd _
  rw [parabolicSum_E6_coat_eq, (Nat.Prime.prime hr.1).dvd_prod_iff] at hdvd'
  obtain ⟨_, hmem, hx⟩ := hdvd'
  obtain ⟨x, hxmem, rfl⟩ := List.mem_map.1 hmem
  obtain ⟨hn, hs, hns⟩ := excE6Fac_bound i x hxmem
  have hq : 1 ≤ 2 ^ f := Nat.one_le_two_pow
  have h1 : r ∣ (2 ^ f) ^ (x.2 * x.1) - 1 := by
    rw [← geomSum_mul_sub_one x.1 x.2 _ hq]
    exact Dvd.dvd.mul_right hx _
  rw [← pow_mul] at h1
  refine (CFSG.Timmesfeld.Bang.primitive_of_orderOf hr.2).2 (f * (x.2 * x.1)) ?_ ?_ h1
  · exact Nat.mul_pos (by omega) (Nat.mul_pos (by omega) (by omega))
  · have : x.2 * x.1 < e := by nlinarith
    calc f * (x.2 * x.1) < f * e := Nat.mul_lt_mul_of_pos_left this (by omega)
      _ = e * f := Nat.mul_comm f e

