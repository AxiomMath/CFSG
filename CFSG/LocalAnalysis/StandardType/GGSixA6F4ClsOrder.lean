private theorem ggA6F4_card {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) :
    Nat.card (adjointGroup .F4 K) = 3311126603366400 := by
  rw [CFSG.Timmesfeld.ExceptionalOrders.card_adjointGroup_F4, hK]
  norm_num [CFSG.Open.ordF4]

theorem ggA6F4_not_five
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) {G : Type} [Group G] [Finite G]
    (e : G ≃* ↥(adjointGroup .F4 K)) {D J : Subgroup G} (hD : IsElemAbelian 5 D)
    (hDc : Nat.card D = 5 ^ 2) (hJ : Nonempty (↥J ≃* alternatingGroup (Fin 6)))
    (hDJ : D ≤ Subgroup.centralizer (J : Set G)) : False := by
  have hG : Nat.card G = 3311126603366400 := by
    rw [Nat.card_congr e.toEquiv, ggA6F4_card hK]
  have hJcard : Nat.card J = 360 := by
    rw [Nat.card_congr hJ.some.toEquiv, nat_card_alternatingGroup]
    norm_num
  have hcenterJ : Subgroup.center ↥J = ⊥ := by
    obtain ⟨φ⟩ := hJ
    rw [← Subgroup.map_center_eq φ.symm,
      alternatingGroup.center_eq_bot (by norm_num : 4 ≤ Nat.card (Fin 6))]
    exact Subgroup.map_bot _
  have hbot : J ⊓ D = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    rw [Subgroup.mem_inf] at hx
    obtain ⟨hxJ, hxD⟩ := hx
    have hmem : (⟨x, hxJ⟩ : ↥J) ∈ Subgroup.center ↥J := by
      rw [Subgroup.mem_center_iff]
      intro y
      apply Subtype.ext
      simpa using Subgroup.mem_centralizer_iff.mp (hDJ hxD) (y : G) y.2
    have h1 : (⟨x, hxJ⟩ : ↥J) = 1 := by
      have : (⟨x, hxJ⟩ : ↥J) ∈ (⊥ : Subgroup ↥J) := by
        rw [← hcenterJ]
        exact hmem
      simpa using this
    simpa using congrArg Subtype.val h1
  have hcomm : ∀ (m : ↥J) (n : ↥D), Commute (J.subtype m) (D.subtype n) :=
    fun m n => Subgroup.mem_centralizer_iff.mp (hDJ n.2) (m : G) m.2
  let f : ↥J × ↥D →* G := MonoidHom.noncommCoprod J.subtype D.subtype hcomm
  have hf : Function.Injective f := by
    intro x y hxy
    dsimp only [f] at hxy
    rw [MonoidHom.noncommCoprod_apply, MonoidHom.noncommCoprod_apply] at hxy
    have hmem : (x.1 : G)⁻¹ * (y.1 : G) ∈ J ⊓ D := by
      refine ⟨J.mul_mem (J.inv_mem x.1.2) y.1.2, ?_⟩
      have heq : (x.1 : G)⁻¹ * (y.1 : G) = (x.2 : G) * (y.2 : G)⁻¹ := by
        have h2 : (x.2 : G) = (x.1 : G)⁻¹ * ((y.1 : G) * (y.2 : G)) := by
          have h := congrArg (fun t => (x.1 : G)⁻¹ * t) hxy
          simpa using h
        rw [h2]
        group
      rw [heq]
      exact D.mul_mem x.2.2 (D.inv_mem y.2.2)
    have hone : (x.1 : G)⁻¹ * (y.1 : G) = 1 := by
      have : (x.1 : G)⁻¹ * (y.1 : G) ∈ (⊥ : Subgroup G) := by
        rw [← hbot]
        exact hmem
      exact Subgroup.mem_bot.mp this
    have hx1 : x.1 = y.1 := Subtype.ext (inv_mul_eq_one.mp hone)
    have hx2 : x.2 = y.2 := by
      have h := hxy
      rw [hx1] at h
      exact Subtype.ext (mul_left_cancel h)
    exact Prod.ext hx1 hx2
  have hdvd : 9000 ∣ Nat.card G := by
    have h0 : 9000 ∣ Nat.card (↥J × ↥D) := by
      rw [Nat.card_prod, hJcard, hDc]
      norm_num
    exact h0.trans (Subgroup.card_dvd_of_injective f hf)
  rw [hG] at hdvd
  exact absurd hdvd (by norm_num : ¬ (9000 ∣ 3311126603366400))

theorem ggA6F4_prime_cases
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) {G : Type} [Group G] [Finite G]
    (e : G ≃* ↥(adjointGroup .F4 K)) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {D : Subgroup G} (hDc : Nat.card D = p ^ 2) : p = 3 ∨ p = 5 ∨ p = 7 := by
  have hG : Nat.card G = 3311126603366400 := by
    rw [Nat.card_congr e.toEquiv, ggA6F4_card hK]
  have hdvd : p ^ 2 ∣ 3311126603366400 := by
    rw [← hG, ← hDc]
    exact Subgroup.card_subgroup_dvd_card D
  have hp_dvd : p ∣ 3311126603366400 := (show p ∣ p ^ 2 from ⟨p, by ring⟩).trans hdvd
  have hN : 3311126603366400 = 2 ^ 24 * (3 ^ 6 * (5 ^ 2 * (7 ^ 2 * (13 * 17)))) := by
    norm_num
  rw [hN] at hp_dvd
  rcases hp.dvd_mul.mp hp_dvd with h | h
  · exact absurd (Nat.prime_dvd_prime_iff_eq hp (by norm_num) |>.mp (hp.dvd_of_dvd_pow h)) hp2
  rcases hp.dvd_mul.mp h with h | h
  · exact Or.inl (Nat.prime_dvd_prime_iff_eq hp (by norm_num) |>.mp (hp.dvd_of_dvd_pow h))
  rcases hp.dvd_mul.mp h with h | h
  · exact Or.inr (Or.inl
      (Nat.prime_dvd_prime_iff_eq hp (by norm_num) |>.mp (hp.dvd_of_dvd_pow h)))
  rcases hp.dvd_mul.mp h with h | h
  · exact Or.inr (Or.inr
      (Nat.prime_dvd_prime_iff_eq hp (by norm_num) |>.mp (hp.dvd_of_dvd_pow h)))
  rcases hp.dvd_mul.mp h with h | h
  · exfalso
    have hp13 : p = 13 := Nat.prime_dvd_prime_iff_eq hp (by norm_num) |>.mp h
    rw [hp13] at hdvd
    norm_num at hdvd
  · exfalso
    have hp17 : p = 17 := Nat.prime_dvd_prime_iff_eq hp (by norm_num) |>.mp h
    rw [hp17] at hdvd
    norm_num at hdvd

