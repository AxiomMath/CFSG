private theorem j4d_exists_orthogonal_of_ncard
    {τ : Tag} (hτ : SimplyLacedTag τ) {M : Type*} [CommGroup M]
    {χ : Multiplicative (Fin τ.rank → ℤ) →* M} {i : KernelComponent χ}
    (hn2 : (componentRoots χ i).ncard ≠ 2) (hn6 : (componentRoots χ i).ncard ≠ 6)
    {γ : Fin τ.rank → ℤ} (hγ : γ ∈ componentRoots χ i) :
    ∃ δ ∈ componentRoots χ i, iform γ δ = 0 := by
  classical
  set Ψ := componentRoots χ i with hΨdef
  have hn2' : Ψ.ncard ≠ 2 := by rwa [hΨdef]
  have hn6' : Ψ.ncard ≠ 6 := by rwa [hΨdef]
  have hγ' : γ ∈ Ψ := by rwa [hΨdef]
  have hΨ : IsRootComponent Ψ := isRootComponent_componentRoots i
  have hfin : Ψ.Finite := (finite_setOf_isRoot τ).subset fun α hα => hΨ.isRoot α hα
  by_contra hcon
  push Not at hcon
  have hγr : IsRoot τ γ := hΨ.isRoot γ hγ'
  have hselfγ : iform γ γ = 2 := iform_self_eq_two_of_simplyLaced' hτ hγr
  have hno : ∀ θ ∈ Ψ, ∀ ε ∈ Ψ, iform θ ε ≠ 0 := by
    intro θ hθ ε hε hzero
    obtain ⟨w, hw, hwθ⟩ := exists_weyl_smul_eq_of_mem_componentRoots hτ hγ' hθ
    have hmem : w⁻¹ • ε ∈ Ψ := by
      rw [outer_smul_mem_iff hΨ (inv_mem hw)]
      exact hε
    have h1 : iform (w • γ) ε = iform γ (w⁻¹ • ε) := by
      have h := iform_smul w γ (w⁻¹ • ε)
      simpa using h
    exact hcon (w⁻¹ • ε) hmem (by rw [← h1, hwθ]; exact hzero)
  by_cases h2 : Ψ.ncard = 2
  · exact hn2' h2
  have hγne : γ ≠ -γ := by
    intro h
    have h1 : iform γ γ = iform γ (-γ) := congrArg (fun x => iform γ x) h
    have h2 : iform γ (-γ) = -iform γ γ := by
      rw [← neg_one_smul ℤ γ, iform_smul_right]
      ring
    rw [hselfγ] at h1 h2
    omega
  obtain ⟨δ, hδ, hδne, hδnen⟩ : ∃ δ ∈ Ψ, δ ≠ γ ∧ δ ≠ -γ := by
    by_contra hc
    push Not at hc
    have hsubset : Ψ ⊆ ({γ, -γ} : Set (Fin τ.rank → ℤ)) := by
      intro α hα
      by_cases h : α = γ
      · simp [h]
      · have h' : α = -γ := hc α hα h
        simp [h']
    have hup : ({γ, -γ} : Set (Fin τ.rank → ℤ)).ncard ≤ 2 := by
      calc _ ≤ ({-γ} : Set (Fin τ.rank → ℤ)).ncard + 1 := Set.ncard_insert_le γ _
        _ = 2 := by simp
    have hlow : 2 ≤ Ψ.ncard := by
      have hpair : ({γ, -γ} : Set (Fin τ.rank → ℤ)) ⊆ Ψ := by
        intro x hx
        rcases hx with rfl | rfl
        · exact hγ'
        · exact hΨ.neg_mem γ hγ'
      have h' := Set.ncard_le_ncard hpair hfin
      rwa [Set.ncard_pair hγne] at h'
    have hle := Set.ncard_le_ncard hsubset (Set.toFinite _)
    omega
  have hδr : IsRoot τ δ := hΨ.isRoot δ hδ
  have hselfδ : iform δ δ = 2 := iform_self_eq_two_of_simplyLaced' hτ hδr
  have hγneδ : γ ≠ δ := fun h => hδne h.symm
  have hγnenδ : γ ≠ -δ := by
    intro h
    exact hδnen (by rw [h, neg_neg])
  have hsq := iform_sq_lt hγr hδr hγneδ hγnenδ
  rw [hselfγ, hselfδ] at hsq
  have hpm : iform γ δ = 1 ∨ iform γ δ = -1 := by
    have h1 : iform γ δ ≤ 1 := by nlinarith
    have h2 : -1 ≤ iform γ δ := by nlinarith
    have hne0 : iform γ δ ≠ 0 := hcon δ hδ
    by_cases hpos : 0 < iform γ δ
    · left; omega
    · right; omega
  obtain ⟨δ, hδ, hγδ⟩ : ∃ δ ∈ Ψ, iform γ δ = -1 := by
    rcases hpm with h | h
    · refine ⟨-δ, hΨ.neg_mem δ hδ, ?_⟩
      rw [← neg_one_smul ℤ δ, iform_smul_right, h]
      ring
    · exact ⟨δ, hδ, h⟩
  have hδr : IsRoot τ δ := hΨ.isRoot δ hδ
  have hselfδ : iform δ δ = 2 := iform_self_eq_two_of_simplyLaced' hτ hδr
  have hγneδ : γ ≠ δ := by
    intro h
    have h' : iform γ δ = 2 := by rw [h]; exact hselfδ
    omega
  have hγnenδ : γ ≠ -δ := by
    intro h
    have h' : iform γ δ = -2 := by
      rw [h, ← neg_one_smul ℤ δ, iform_smul_left, hselfδ]
      ring
    omega
  have hroot : IsRoot τ (γ + δ) := isRoot_add_of_iform_neg hγr hδr hγnenδ (by omega)
  have hsum : γ + δ ∈ Ψ := hΨ.add_mem γ hγ' δ hδ hroot
  have hind := linIndepPair_of_ne hγr hδr hγneδ hγnenδ
  have hsub : Ψ ⊆ ({γ, -γ, δ, -δ, γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ)) := by
    intro ε hε
    by_contra hεS
    have hεγne : ε ≠ γ := by
      intro h
      exact hεS (by rw [h]; simp)
    have hεnγne : ε ≠ -γ := by
      intro h
      exact hεS (by rw [h]; simp)
    have hεδne : ε ≠ δ := by
      intro h
      exact hεS (by rw [h]; simp)
    have hεnδne : ε ≠ -δ := by
      intro h
      exact hεS (by rw [h]; simp)
    have hεsumne : ε ≠ γ + δ := by
      intro h
      exact hεS (by rw [h]; simp)
    have hεnsumne : ε ≠ -(γ + δ) := by
      intro h
      exact hεS (by rw [h]; simp)
    have hεr : IsRoot τ ε := hΨ.isRoot ε hε
    have hselfε : iform ε ε = 2 := iform_self_eq_two_of_simplyLaced' hτ hεr
    have key : ∀ β : Fin τ.rank → ℤ, β ∈ Ψ → IsRoot τ β → ε ≠ β → ε ≠ -β →
        iform ε β = 1 ∨ iform ε β = -1 := by
      intro β hβΨ hβ h1 h2
      have hsq := iform_sq_lt hεr hβ h1 h2
      rw [hselfε, iform_self_eq_two_of_simplyLaced' hτ hβ] at hsq
      have h1' : iform ε β ≤ 1 := by nlinarith
      have h2' : -1 ≤ iform ε β := by nlinarith
      have hne0 : iform ε β ≠ 0 := hno ε hε β hβΨ
      by_cases hpos : 0 < iform ε β
      · left; omega
      · right; omega
    have h1 := key γ hγ' hγr hεγne hεnγne
    have h2 := key δ hδ hδr hεδne hεnδne
    have h3 := key (γ + δ) hsum hroot hεsumne hεnsumne
    rw [iform_add_right] at h3
    rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;> rcases h3 with h3 | h3 <;> omega
  have hle6 : Ψ.ncard ≤ 6 := by
    have h1 : Ψ.ncard ≤
        ({γ, -γ, δ, -δ, γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ)).ncard :=
      Set.ncard_le_ncard hsub (Set.toFinite _)
    have h2 : ({γ, -γ, δ, -δ, γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ)).ncard ≤ 6 := by
      have h1 := Set.ncard_insert_le γ
        ({-γ, δ, -δ, γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ))
      have h2 := Set.ncard_insert_le (-γ)
        ({δ, -δ, γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ))
      have h3 := Set.ncard_insert_le δ
        ({-δ, γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ))
      have h4 := Set.ncard_insert_le (-δ)
        ({γ + δ, -(γ + δ)} : Set (Fin τ.rank → ℤ))
      have h5 := Set.ncard_insert_le (γ + δ)
        ({-(γ + δ)} : Set (Fin τ.rank → ℤ))
      have h6 : ({-(γ + δ)} : Set (Fin τ.rank → ℤ)).ncard = 1 := by simp
      omega
    omega
  have hge6 : 6 ≤ Ψ.ncard := by
    let f : Fin 6 → (Fin τ.rank → ℤ) :=
      fun i => (j4dSixC i).1 • γ + (j4dSixC i).2 • δ
    have hinj : Function.Injective f := by
      intro i j hij
      have hij' : (j4dSixC i).1 • γ + (j4dSixC i).2 • δ =
          (j4dSixC j).1 • γ + (j4dSixC j).2 • δ := hij
      have hzero : ((j4dSixC i).1 - (j4dSixC j).1) • γ +
          ((j4dSixC i).2 - (j4dSixC j).2) • δ = 0 := by
        have e : ((j4dSixC i).1 - (j4dSixC j).1) • γ +
            ((j4dSixC i).2 - (j4dSixC j).2) • δ =
            (j4dSixC i).1 • γ + (j4dSixC i).2 • δ -
              ((j4dSixC j).1 • γ + (j4dSixC j).2 • δ) := by
          rw [sub_smul, sub_smul]
          abel
        rw [e, hij', sub_self]
      obtain ⟨ha, hb⟩ := hind _ _ hzero
      have hc : j4dSixC i = j4dSixC j := by
        have h1 : (j4dSixC i).1 = (j4dSixC j).1 := by omega
        have h2 : (j4dSixC i).2 = (j4dSixC j).2 := by omega
        exact Prod.ext h1 h2
      exact j4dSixC_injective hc
    have hsub' : Set.range f ⊆ Ψ := by
      rintro _ ⟨i, rfl⟩
      fin_cases i
      · simpa [f, j4dSixC] using hγ'
      · simpa [f, j4dSixC] using hδ
      · simpa [f, j4dSixC] using hsum
      · simpa [f, j4dSixC] using hΨ.neg_mem γ hγ'
      · simpa [f, j4dSixC] using hΨ.neg_mem δ hδ
      · simpa [f, j4dSixC, neg_add, add_comm] using hΨ.neg_mem (γ + δ) hsum
    have hcard : (Set.range f).ncard = 6 := by
      rw [Set.ncard_range_of_injective hinj]
      simp
    have hle := Set.ncard_le_ncard hsub' hfin
    omega
  exact hn6' (le_antisymm hle6 hge6)

theorem j4d_allStable_kills
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup τ L p₀)
    (hτ : τ = .E6 ∨ τ = .E7 ∨ τ = .E8) (hq : S.D.q = 2) (hAlg : S.IsAlgebraic)
    {a b : Fin τ.rank → Lˣ} (i : KernelComponent (rootCharHom a))
    (hstable : ∀ δ ∈ componentRoots (rootCharHom a) i, S.ρ δ = δ ∨ S.ρ δ = -δ)
    (hnot : ¬ LangSmallSolv S.D.q S.ρ (rootCharHom a) i)
    (hout : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[1]))
    (hle : rationalComponent S.ρ S.Γ (rootCharHom a) i ≤
      Subgroup.centralizer {rootDiagUnit τ b}) :
    ∀ γ ∈ componentRoots (rootCharHom a) i, rootChar b γ = 1 := by
  classical
  intro γ hγ
  have hΨ : IsRootComponent (componentRoots (rootCharHom a) i) :=
    isRootComponent_componentRoots i
  have hfin : (componentRoots (rootCharHom a) i).Finite :=
    (finite_setOf_isRoot τ).subset fun α hα => hΨ.isRoot α hα
  have hmaps : ∀ δ ∈ componentRoots (rootCharHom a) i,
      S.ρ δ ∈ componentRoots (rootCharHom a) i := by
    intro δ hδ
    rcases hstable δ hδ with h | h
    · rwa [h]
    · rw [h]
      exact hΨ.neg_mem δ hδ
  have hs1 : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1 :=
    componentOrbitLength_eq_one hfin hmaps
  have hq2s : S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2 := by
    rw [hs1, pow_one, hq]
  have hn2 : (componentRoots (rootCharHom a) i).ncard ≠ 2 := by
    intro h2
    exact hnot (Or.inl ⟨by rw [hq2s]; norm_num, h2⟩)
  have hn6 : (componentRoots (rootCharHom a) i).ncard ≠ 6 := by
    intro h6
    have hc : compRank (componentRoots (rootCharHom a) i) = 2 :=
      compRank_eq_two_of_ncard_eq_six hΨ h6
    have htk : twistKind S.ρ (rootCharHom a) i = .suN := by
      unfold twistKind
      rw [hs1, if_neg hout]
      have hexc : ¬ ((compRank (componentRoots (rootCharHom a) i) = 6 ∧
            (componentRoots (rootCharHom a) i).ncard = 72) ∨
          (compRank (componentRoots (rootCharHom a) i) = 4 ∧
            (componentRoots (rootCharHom a) i).ncard = 24 ∧
            ¬ twistInner (componentRoots (rootCharHom a) i)
              ((S.ρ : (Fin τ.rank → ℤ) → _)^[2 * 1]))) := by
        rintro (⟨h, _⟩ | ⟨h, _⟩) <;> omega
      have htwoD : ¬ (4 ≤ compRank (componentRoots (rootCharHom a) i) ∧
          (componentRoots (rootCharHom a) i).ncard =
            2 * compRank (componentRoots (rootCharHom a) i) *
              (compRank (componentRoots (rootCharHom a) i) - 1)) := by
        rintro ⟨h, _⟩
        omega
      have hsuN : 2 ≤ compRank (componentRoots (rootCharHom a) i) ∧
          (componentRoots (rootCharHom a) i).ncard =
            compRank (componentRoots (rootCharHom a) i) *
              (compRank (componentRoots (rootCharHom a) i) + 1) := by
        constructor
        · omega
        · rw [h6, hc]
      rw [if_neg hexc, if_neg htwoD, if_pos hsuN]
    exact hnot (Or.inr ⟨hq2s, htk, h6⟩)
  obtain ⟨δ, hδ, hγδ⟩ :=
    j4d_exists_orthogonal_of_ncard (Or.inr hτ) hn2 hn6 (χ := rootCharHom a) (i := i) hγ
  obtain ⟨u, hu, huγ⟩ := exists_weyl_smul_eq_of_mem_componentRoots (Or.inr hτ) hγ hδ
  have horth : iform (u • γ) γ = 0 := by
    rw [huγ, iform_comm]
    exact hγδ
  exact langRatKills_of_reflection_commutator (f := 1) S (Or.inr hτ)
    (by simpa using hq) hAlg b i (fun x hx => hx) hstable hγ hu horth hle

