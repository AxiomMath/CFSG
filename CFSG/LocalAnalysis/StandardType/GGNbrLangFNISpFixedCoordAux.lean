theorem kgfniSpFix_exists_smul_of_mem_adjoin {K V : Type} [Field K] [AddCommGroup V]
    [Module K V] {A g : Module.End K V} (hg : A * g = g) {z : Module.End K V}
    (hz : z ∈ Algebra.adjoin K ({A} : Set (Module.End K V))) :
    ∃ c : K, z * g = c • g := by
  refine Algebra.adjoin_induction (p := fun z _ => ∃ c : K, z * g = c • g) ?_ ?_ ?_ ?_ hz
  · intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact ⟨1, by rw [one_smul, hg]⟩
  · intro c
    exact ⟨c, by rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]⟩
  · rintro z₁ z₂ hz₁ hz₂ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
    exact ⟨c₁ + c₂, by rw [add_mul, hc₁, hc₂, add_smul]⟩
  · rintro z₁ z₂ hz₁ hz₂ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
    refine ⟨c₁ * c₂, ?_⟩
    rw [mul_assoc, hc₂, mul_smul_comm, hc₁, smul_smul, mul_comm]

theorem kgfniSpFix_avg_mul_eq_of_mul_eq {K V : Type} [Field K] [AddCommGroup V] [Module K V]
    [CharP K 2] {A : Module.End K V} {p : ℕ} (hp : Odd p) (hA : A ^ p = 1)
    {e : Module.End K V} (he : A * e = e) :
    CFSG.RankThree.PartOne.OddIso.avg A p * e = e := by
  have hpow : ∀ i : ℕ, A ^ i * e = e := by
    intro i
    induction i with
    | zero => rw [pow_zero, one_mul]
    | succ i ih => rw [pow_succ, mul_assoc, he, ih]
  unfold CFSG.RankThree.PartOne.OddIso.avg
  rw [Finset.sum_mul]
  simp_rw [hpow]
  rw [Finset.sum_const, Finset.card_range, ← Nat.cast_smul_eq_nsmul K,
    CFSG.RankThree.PartOne.OddIso.natCast_odd_eq_one hp, one_smul]

theorem kgfniSpFix_range_toLin'_eq_ker {K : Type} [Field K] [Fintype K] [CharP K 2] {n : ℕ}
    (u : GL (Fin n ⊕ Fin n) K) (hu : u ∈ StatedSp n K) (hodd : Odd (orderOf u))
    {ε : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K}
    (hε : IsPrimAdjIdemIn (RingHom.id K)
      (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K)
      (Algebra.adjoin K (Units.val '' ({u} : Set (GL (Fin n ⊕ Fin n) K)))) ε)
    (h1 : (u : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K) * ε = ε) :
    (Matrix.toLin' ε).range =
      LinearMap.ker (Matrix.toLin' (u : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K) - 1) := by
  classical
  let β : StatedSp n K := ⟨u, hu⟩
  let A : Module.End K (Fin n ⊕ Fin n → K) := CFSG.RankThree.Classical.spEnd β
  let p : Module.End K (Fin n ⊕ Fin n → K) := Matrix.toLin' ε
  let φ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K ≃ₐ[K]
      Module.End K (Fin n ⊕ Fin n → K) := Matrix.toLinAlgEquiv'
  let g : Module.End K (Fin n ⊕ Fin n → K) :=
    CFSG.RankThree.PartOne.OddIso.avg A (orderOf β)
  have hoddβ : Odd (orderOf β) := by
    change Odd (orderOf (⟨u, hu⟩ : StatedSp n K))
    rw [Subgroup.orderOf_mk u hu]
    exact hodd
  have hApow : A ^ orderOf β = 1 := CFSG.RankThree.Classical.spEnd_pow
    (pow_orderOf_eq_one β)
  have hgidem : g * g = g :=
    CFSG.RankThree.PartOne.OddIso.avg_mul_self hoddβ hApow
  have hAg : A * g = g := CFSG.RankThree.PartOne.OddIso.mul_avg hApow
  have hφp : φ ε = p := by
    apply LinearMap.ext
    intro v
    rw [Matrix.toLinAlgEquiv'_apply, Matrix.toLin'_apply]
  have hAε : A * p = p := by
    rw [show A = Matrix.toLin' (u : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K) from by
      apply LinearMap.ext
      intro v
      rw [CFSG.RankThree.Classical.spEnd_apply, Matrix.toLin'_apply]]
    rw [Module.End.mul_eq_comp, ← Matrix.toLin'_mul, h1]
  have hφb : φ ((u : GL (Fin n ⊕ Fin n) K) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K) = A := by
    apply LinearMap.ext
    intro v
    rw [Matrix.toLinAlgEquiv'_apply, CFSG.RankThree.Classical.spEnd_apply]
  have hAdjoin : (Algebra.adjoin K
      (Units.val '' ({u} : Set (GL (Fin n ⊕ Fin n) K)))).map φ.toAlgHom =
      Algebra.adjoin K ({A} : Set (Module.End K (Fin n ⊕ Fin n → K))) := by
    rw [AlgHom.map_adjoin]
    simp only [Set.image_singleton, AlgEquiv.coe_toAlgHom, hφb]
  have hεA : φ ε ∈ Algebra.adjoin K ({A} : Set (Module.End K (Fin n ⊕ Fin n → K))) := by
    rw [← hAdjoin]
    exact ⟨ε, hε.1, rfl⟩
  have hgA : g ∈ Algebra.adjoin K ({A} : Set (Module.End K (Fin n ⊕ Fin n → K))) := by
    unfold g CFSG.RankThree.PartOne.OddIso.avg
    exact Subalgebra.sum_mem _ fun i _ =>
      Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) i
  have hεg : g * φ ε = φ ε := by
    rw [hφp]
    exact kgfniSpFix_avg_mul_eq_of_mul_eq hoddβ hApow hAε
  obtain ⟨c, hc⟩ := kgfniSpFix_exists_smul_of_mem_adjoin hAg hεA
  have hcomm : Commute (φ ε) g :=
    (Algebra.commute_of_mem_adjoin_singleton_of_commute hεA
      (CFSG.RankThree.PartOne.OddIso.avg_commute A (orderOf β)).symm).symm
  have hε_eq : φ ε = c • g := by
    rw [← hεg, ← hcomm.eq, hc]
  have hp_idem : p * p = p := by
    rw [show p = Matrix.toLin' ε from rfl, Module.End.mul_eq_comp, ← Matrix.toLin'_mul,
      hε.2.1.eq]
  have hp_cg : p = c • g := by rw [← hφp, hε_eq]
  have hgne : g ≠ 0 := by
    intro hg0
    have hp0 : p = 0 := by rw [hp_cg, hg0, smul_zero]
    exact hε.2.2.1 (Matrix.toLin'.map_eq_zero_iff.mp hp0)
  have hc_eq : c = 1 := by
    have hmulgg : (c • g) * (c • g) = (c * c) • (g * g) := by
      rw [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, smul_smul]
    have hcc : (c * c) • g = c • g := by
      calc (c * c) • g = (c * c) • (g * g) := by rw [hgidem]
        _ = (c • g) * (c • g) := hmulgg.symm
        _ = p * p := by rw [← hp_cg]
        _ = p := hp_idem
        _ = c • g := hp_cg
    have hscal : (c * c - c) • g = 0 := by
      calc (c * c - c) • g = (c * c) • g - c • g := sub_smul (c * c) c g
        _ = c • g - c • g := by rw [hcc]
        _ = 0 := sub_self _
    rcases smul_eq_zero.mp hscal with h0 | hg0
    · have hmul : c * (c - 1) = 0 := by
        rw [mul_sub, mul_one]
        exact h0
      rcases mul_eq_zero.mp hmul with hc0 | hc1
      · exfalso
        have hp0 : p = 0 := by rw [hp_cg, hc0, zero_smul]
        exact hε.2.2.1 (Matrix.toLin'.map_eq_zero_iff.mp hp0)
      · exact sub_eq_zero.mp hc1
    · exact absurd hg0 hgne
  have hpg : p = g := by rw [hp_cg, hc_eq, one_smul]
  rw [show (Matrix.toLin' ε) = p from rfl, hpg]
  exact CFSG.RankThree.PartOne.OddIso.range_avg hoddβ hApow

end CFSG.StandardType

