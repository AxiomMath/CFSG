theorem kgfniSpFix_restrict_ker_sub_one_nondegenerate {K V : Type} [Field K] [CharP K 2]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    {A : Module.End K V} {m : ℕ} (hm : Odd m) (hA : A ^ m = 1)
    (hiso : ∀ x y, B (A x) (A y) = B x y) :
    (B.restrict (LinearMap.ker (A - 1))).Nondegenerate := by
  have hcompl : IsCompl (LinearMap.ker (A - 1)) (LinearMap.range (A - 1)) :=
    CFSG.RankThree.PartOne.OddIso.isCompl_ker_range hm hA
  rw [LinearMap.BilinForm.nondegenerate_iff_ker_eq_bot, Submodule.eq_bot_iff]
  intro x hx
  have hx0 : (B.restrict (LinearMap.ker (A - 1))) x = 0 := LinearMap.mem_ker.mp hx
  have hxfix : A (x : V) = x := by
    have := x.2
    rwa [LinearMap.mem_ker, LinearMap.sub_apply, Module.End.one_apply, sub_eq_zero] at this
  have hBx : B (x : V) = 0 := by
    apply LinearMap.ext
    intro v
    have hv : v ∈ LinearMap.ker (A - 1) ⊔ LinearMap.range (A - 1) := by
      rw [hcompl.sup_eq_top]
      exact Submodule.mem_top
    obtain ⟨v₁, hv₁, v₂, hv₂, rfl⟩ := Submodule.mem_sup.mp hv
    have h1 : B (x : V) v₁ = 0 := by
      have := LinearMap.congr_fun hx0 ⟨v₁, hv₁⟩
      simpa [LinearMap.BilinForm.restrict_apply] using this
    have h2 : B (x : V) v₂ = 0 := by
      obtain ⟨w, rfl⟩ := hv₂
      exact CFSG.RankThree.PartOne.OddIso.B_fix_range B hiso hxfix w
    calc B (x : V) (v₁ + v₂) = B (x : V) v₁ + B (x : V) v₂ := map_add _ _ _
      _ = 0 := by rw [h1, h2, add_zero]
  have hxV : (x : V) ∈ LinearMap.ker B := LinearMap.mem_ker.mpr hBx
  rw [LinearMap.BilinForm.nondegenerate_iff_ker_eq_bot.mp hB] at hxV
  exact Subtype.ext (by simpa using hxV)

theorem kgfniSpFix_semMat_transpose_mul_form {K W : Type} [Field K] [AddCommGroup W]
    [Module K W] {ι : Type} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι K W) (J : Matrix ι ι K) (BW : LinearMap.BilinForm K W)
    (hb : LinearMap.BilinForm.toMatrix b BW = J) (S : W ≃+ W) {σ : K ≃+* K}
    (hS : ∀ (c : K) (v : W), S (c • v) = σ c • S v)
    (hform : ∀ x y : W, BW (S x) (S y) = σ (BW x y))
    (hJ : ∀ i j, σ (J i j) = J i j) :
    Matrix.transpose (semMat b S) * J * semMat b S = J := by
  ext i j
  set M := semMat b S with hM
  have hSi : S (b i) = ∑ k, M k i • b k := by
    rw [← Module.Basis.sum_repr b (S (b i))]
    rfl
  have hSj : S (b j) = ∑ l, M l j • b l := by
    rw [← Module.Basis.sum_repr b (S (b j))]
    rfl
  have hbij : ∀ k l, BW (b k) (b l) = J k l := fun k l => by
    rw [← hb, LinearMap.BilinForm.toMatrix_apply]
  have hexp : BW (S (b i)) (S (b j)) =
      ∑ k, ∑ l, M k i * J k l * M l j := by
    rw [hSi, hSj, LinearMap.BilinForm.sum_left]
    apply Finset.sum_congr rfl
    intro k _
    rw [LinearMap.BilinForm.sum_right]
    apply Finset.sum_congr rfl
    intro l _
    rw [LinearMap.BilinForm.smul_left, LinearMap.BilinForm.smul_right, hbij k l]
    ring
  have hmul : (Matrix.transpose M * J * M) i j =
      ∑ k, ∑ l, M k i * J k l * M l j := by
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    simp only [Finset.sum_mul]
    rw [Finset.sum_comm]
  rw [hmul, ← hexp, hform, hbij i j, hJ]

end CFSG.StandardType
