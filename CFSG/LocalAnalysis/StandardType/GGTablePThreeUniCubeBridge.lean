theorem uni_cube_mem_primeFormUnitary {K : Type} [Field K] {q n f : ℕ}
    (h : UnitaryFieldData 2 f K) (hq : q = 2 ^ f)
    {d : GL (Fin n) K} (hd : IsHermIsometry q (d : Matrix (Fin n) (Fin n) K)) :
    d ∈ primeFormUnitary h (idGram K n) := by
  rw [mem_primeFormUnitary]
  have hbar : ∀ c : K, h.bar c = c ^ q := by
    intro c
    rw [UnitaryFieldData.bar_apply, hq]
  have hform : ∀ x y : Fin n → K, gramForm h (idGram K n) x y = ∑ i, x i ^ q * y i := by
    intro x y
    rw [gramForm_apply]
    simp only [idGram, Units.val_one, Matrix.one_mulVec, dotProduct, hbar]
  refine (gramForm_isometry_iff h (idGram K n) (d : Matrix (Fin n) (Fin n) K)).mp ?_
  intro x y
  rw [hform, hform]
  exact hd x y

theorem uni_cube_unitaryPrimaryData {K : Type} [Field K] {f n : ℕ}
    (h : UnitaryFieldData 2 f K) {d : GL (Fin n) K}
    (hd : d ∈ primeFormUnitary h (idGram K n)) (hd3 : d ^ 3 = 1) :
    UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d) := by
  exact CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_primaryData_toLin' h hd
    Nat.prime_three (by norm_num) (by rw [hd3, map_one])

private noncomputable def cubeConj {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K)
    {d : GL (Fin n) K} (hd : d ∈ primeFormUnitary h (idGram K n))
    (g : LargeEvenSUGroup (Fin n) K (2 ^ f)) : LargeEvenSUGroup (Fin n) K (2 ^ f) :=
  ⟨d * (g : GL (Fin n) K) * d⁻¹, by
    have hg : (g : GL (Fin n) K) ∈
        gramSU h ((1 : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) :=
      CFSG.StandardType.InndiagSU.largeEvenSUGroup_eq_gramSU (d := n) h ▸ g.2
    have hmem : d * (g : GL (Fin n) K) * d⁻¹ ∈
        gramSU h ((1 : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) :=
      conj_mem_gramSU h ((1 : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) hd hg
    exact (congrArg (fun S : Subgroup (GL (Fin n) K) =>
        d * (g : GL (Fin n) K) * d⁻¹ ∈ S)
      (CFSG.StandardType.InndiagSU.largeEvenSUGroup_eq_gramSU (d := n) h).symm).mp hmem⟩

private theorem cube_projEquiv_conj {K : Type} [Field K] {n f : ℕ}
    (h : UnitaryFieldData 2 f K) (hn : 1 ≤ n)
    {d : GL (Fin n) K} {δ' : MulAut (PSUg n K (2 ^ f))} (hδ : IsConjBy d δ')
    (hd : d ∈ primeFormUnitary h (idGram K n)) (x : PSUg n K (2 ^ f)) :
    CFSG.StandardType.InndiagSU.projEquiv h hn (δ' x) =
      (primeFormConjHom h (idGram K n) ⟨d, hd⟩)
        (CFSG.StandardType.InndiagSU.projEquiv h hn x) := by
  refine QuotientGroup.induction_on x ?_
  intro g
  rw [show δ' (g : PSUg n K (2 ^ f)) = (cubeConj h hd g : PSUg n K (2 ^ f)) from
      hδ g (cubeConj h hd g) rfl,
    CFSG.StandardType.InndiagSU.projEquiv_mk h hn (cubeConj h hd g),
    CFSG.StandardType.InndiagSU.projEquiv_mk h hn g,
    primeFormConjHom_mk h (idGram K n) ⟨d, hd⟩
      ⟨(g : GL (Fin n) K),
        CFSG.StandardType.InndiagSU.largeEvenSUGroup_eq_gramSU (d := n) h ▸ g.2⟩]
  congr 1

theorem uni_cube_fixSubgroup_projEquiv {K : Type} [Field K] {n f : ℕ}
    (h : UnitaryFieldData 2 f K) (hn : 1 ≤ n)
    {d : GL (Fin n) K} {δ' : MulAut (PSUg n K (2 ^ f))} (hδ : IsConjBy d δ')
    (hd : d ∈ primeFormUnitary h (idGram K n)) :
    ∀ x : PSUg n K (2 ^ f),
      x ∈ ggAutFixedSubgroup δ' ↔
        CFSG.StandardType.InndiagSU.projEquiv h hn x ∈
          CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
            (primeFormConjHom h (idGram K n) ⟨d, hd⟩) := by
  intro x
  rw [CFSG.StandardType.mem_ggAutFixedSubgroup,
    CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup,
    ← cube_projEquiv_conj h hn hδ hd x]
  exact (CFSG.StandardType.InndiagSU.projEquiv h hn).injective.eq_iff.symm

theorem uni_cube_primeForm_component_eq_specialBlock {K : Type} [Field K] {f n : ℕ}
    (h : UnitaryFieldData 2 f K)
    (A : primeFormUnitary h (idGram K n)) (hA3 : (A : GL (Fin n) K) ^ 3 = 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K)))
    (T : Subgroup (primeFormP h (idGram K n)))
    (hT : CFSG.Open.IsComponentOf T
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
        (primeFormConjHom h (idGram K n) A))) :
    ∃ μ : K, μ ^ 3 = 1 ∧
      T = ((specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K))
              (Polynomial.X - Polynomial.C μ)).comap
            (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n)).map
          (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) := by
  haveI := h.finite
  haveI : Finite (GL (Fin n) K) :=
    Finite.of_injective (fun g : GL (Fin n) K => (g : Matrix (Fin n) (Fin n) K)) Units.val_injective
  obtain ⟨i, hi⟩ := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.component_mem_named_factors
    (fun i : CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psub_Idx h n A =>
      (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psub_block A i).map
        (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)))
    (fun i => CFSG.HardMathSupport.Dickson.Bal207.Uni.uni_block_isComponent A H i)
    (fun P hPC hP => CFSG.HardMathSupport.Dickson.Bal207.Uni.uni_perfect_le_blocks A H P hPC
      (Subgroup.isPerfect_iff.1 ⟨hP⟩)) hT
  obtain ⟨μ, hμ, hμeq⟩ :=
    CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_primaryFactor_eq
      (h := h) (n := n) A hA3 i.1.2
  have hblk : CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psub_block A i =
      (specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K))
        (Polynomial.X - Polynomial.C μ)).comap
        (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n) := by
    unfold CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psub_block
    rw [hμeq]
    rfl
  exact ⟨μ, hμ, hi.trans (by rw [hblk])⟩

theorem uni_cube_primeForm_t6psub_block_isComponent {K : Type} [Field K] {f n : ℕ}
    (h : UnitaryFieldData 2 f K)
    (A : primeFormUnitary h (idGram K n))
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K)))
    (i : CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psub_Idx h n A) :
    CFSG.Open.IsComponentOf
      ((CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psub_block A i).map
        (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)))
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
        (primeFormConjHom h (idGram K n) A)) := by
  exact CFSG.HardMathSupport.Dickson.Bal207.Uni.uni_block_isComponent A H i

