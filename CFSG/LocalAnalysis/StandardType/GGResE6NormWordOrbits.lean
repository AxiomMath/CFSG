@[expose] def normTwoWitness (h : Fin 6 → ZMod 3) : Fin 72 × ZMod 3 :=
  normTwoWitnessTable.getD (vecKey h) (0, 0)

theorem normTwoWitness_spec :
    ∀ (h : Fin 6 → ZMod 3), norm h = 2 →
      h = rootVec (normTwoWitness h).1 + (normTwoWitness h).2 • r := by
  decide +kernel

theorem norm_rootVec_add :
    ∀ (m : Fin 72) (t : ZMod 3), norm (rootVec m + t • r) = 2 := by
  decide +kernel

theorem norm_two_iff (h : Fin 6 → ZMod 3) :
    norm h = 2 ↔ ∃ m : Fin 72, ∃ t : ZMod 3, h = rootVec m + t • r := by
  constructor
  · intro hh
    exact ⟨(normTwoWitness h).1, (normTwoWitness h).2, normTwoWitness_spec h hh⟩
  · rintro ⟨m, t, rfl⟩
    exact norm_rootVec_add m t

theorem norm_rootVec (m : Fin 72) : norm (rootVec m) = 2 := by
  simpa using norm_rootVec_add m 0

