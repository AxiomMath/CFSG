@[expose] def qWord (h : Fin 6 → ZMod 3) : List (Fin 6) :=
  normOneWordsByKey.getD (vecKey h) []

@[expose] def translationWord (h : Fin 6 → ZMod 3) : List (Fin 6) :=
  (qWord h).reverse ++ baseWord ++ qWord h

theorem translationWord_spec :
    ∀ (h : Fin 6 → ZMod 3), norm h = 1 → applyWord (translationWord h) h = h + r := by
  decide +kernel

theorem Cmul_add (v u : Fin 6 → ZMod 3) : Cmul (v + u) = Cmul v + Cmul u := by
  rw [Cmul_eq_mulVec, Cmul_eq_mulVec, Cmul_eq_mulVec]
  exact Matrix.mulVec_add C v u

@[expose] def sectionMatrix : Matrix (Fin 6) (Fin 6) (ZMod 3) :=
  !![0, 2, 2, 1, 1, 1;
     0, 2, 0, 0, 1, 2;
     0, 1, 0, 2, 0, 1;
     0, 0, 0, 0, 2, 1;
     0, 0, 0, 0, 0, 2;
     0, 0, 0, 0, 0, 0]

@[expose] def sectionVec : Fin 6 → ZMod 3 := ![1, 0, 0, 0, 0, 0]

theorem section_mulVec (c : Fin 6 → ZMod 3) :
    C *ᵥ (sectionMatrix *ᵥ c) + (c ⬝ᵥ r) • sectionVec = c := by
  revert c
  decide +kernel

theorem exists_mulVec_eq_of_dot_radical_eq_zero (c : Fin 6 → ZMod 3)
    (hc : c ⬝ᵥ r = 0) : ∃ u : Fin 6 → ZMod 3, C *ᵥ u = -c := by
  refine ⟨-(sectionMatrix *ᵥ c), ?_⟩
  have h := section_mulVec c
  rw [hc, zero_smul, add_zero] at h
  calc
    C *ᵥ (-(sectionMatrix *ᵥ c)) = -(C *ᵥ (sectionMatrix *ᵥ c)) :=
      Matrix.mulVec_neg _ C
    _ = -c := congrArg Neg.neg h

end CFSG.StandardType.E6NormWordOrbit

