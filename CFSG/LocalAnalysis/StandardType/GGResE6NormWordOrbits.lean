@[expose] def rootVec (m : Fin 72) : Fin 6 → ZMod 3 :=
  fun i => (rootList.getD m.val []).getD i.val 0

theorem rootVec_eq_source :
    ∀ (m : Fin 72) (i : Fin 6), rootVec m i = ((e6RootVec m.val i : ℤ) : ZMod 3) := by
  decide +kernel

@[expose] def applyWord (w : List (Fin 6)) (v : Fin 6 → ZMod 3) : Fin 6 → ZMod 3 :=
  w.foldl (fun v i => s i v) v

@[expose] def vecKey (v : Fin 6 → ZMod 3) : Nat :=
  (v 0).val + 3 * (v 1).val + 9 * (v 2).val + 27 * (v 3).val +
    81 * (v 4).val + 243 * (v 5).val

theorem Cmul_r : Cmul r = 0 := by
  funext i
  fin_cases i <;>
    simp [Cmul, C, Cℤ, r, Fin.sum_univ_six] <;>
    ring_nf <;>
    reduce_mod_char

theorem s_r : ∀ i : Fin 6, s i r = r := by
  intro i
  rw [s, Cmul_r]
  simp

theorem Cmul_s : ∀ (i : Fin 6) (v : Fin 6 → ZMod 3),
    Cmul (s i v) = sDual i (Cmul v) := by
  intro i v
  ext j
  fin_cases i <;> fin_cases j <;>
    simp [Cmul, s, sDual, C, Cℤ, unitRoot, Pi.single_apply, Fin.sum_univ_six] <;>
    ring_nf <;>
    reduce_mod_char

theorem applyWord_fixes_r : ∀ w : List (Fin 6), applyWord w r = r
  | [] => rfl
  | i :: is => by
      change applyWord is (s i r) = r
      rw [s_r i, applyWord_fixes_r is]

