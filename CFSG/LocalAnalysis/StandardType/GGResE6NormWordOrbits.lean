@[expose] def Cℤ : Matrix (Fin 6) (Fin 6) ℤ :=
  !![2, 0, -1, 0, 0, 0;
     0, 2, 0, -1, 0, 0;
     -1, 0, 2, -1, 0, 0;
     0, -1, -1, 2, -1, 0;
     0, 0, 0, -1, 2, -1;
     0, 0, 0, 0, -1, 2]

theorem Cℤ_eq_mathlib : Cℤ = CartanMatrix.E 6 := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

@[expose] def C : Matrix (Fin 6) (Fin 6) (ZMod 3) :=
  Cℤ.map (Int.castRingHom (ZMod 3))

theorem C_eq_mathlib :
    C = (CartanMatrix.E 6).map (Int.castRingHom (ZMod 3)) := by
  rw [C, Cℤ_eq_mathlib]

@[expose] def Cmul (v : Fin 6 → ZMod 3) : Fin 6 → ZMod 3 :=
  fun i => ∑ j, C i j * v j

theorem Cmul_eq_mulVec (v : Fin 6 → ZMod 3) : Cmul v = C *ᵥ v := rfl

@[expose] def r : Fin 6 → ZMod 3 := ![1, 0, 2, 0, 1, 2]

@[expose] def norm (v : Fin 6 → ZMod 3) : ZMod 3 :=
  ∑ i, v i * Cmul v i

@[expose] def unitRoot (i : Fin 6) : Fin 6 → ZMod 3 := Pi.single i 1

@[expose] def s (i : Fin 6) (v : Fin 6 → ZMod 3) : Fin 6 → ZMod 3 :=
  v - Cmul v i • unitRoot i

@[expose] def sDual (i : Fin 6) (h : Fin 6 → ZMod 3) : Fin 6 → ZMod 3 :=
  h - h i • (fun j => C j i)

