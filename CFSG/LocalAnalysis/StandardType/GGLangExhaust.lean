theorem perfect_le_iSup_rationalComponent_of_ne_G2
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ}
    (S : LangSetup τ L p₀) (hτ : τ ≠ .G2) (hp : p.Prime) (hpL : (p : L) ≠ 0)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1)
    (h1 : rootDiagUnit τ a ≠ 1)
    (P : Subgroup (ModGL τ L)) (hP : P ≤ S.Γ ⊓ Subgroup.centralizer {rootDiagUnit τ a})
    (hperf : ⁅P, P⁆ = P) :
    P ≤ ⨆ i : KernelComponent (rootCharHom a),
      ⨆ (_ : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i)),
        rationalComponent S.ρ S.Γ (rootCharHom a) i :=
  CFSG.HardMathSupport.Dickson.Sec6.perfect_le_iSup_rationalComponent S hp hT hap
    (langSetup_hTame_of_prime S hp hpL (fun h => absurd h hτ) hT hap h1) P hP hperf

theorem exists_rationalComponent_eq_of_isComponentOf_of_ne_G2
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ}
    (S : LangSetup τ L p₀) (hτ : τ ≠ .G2) (hp : p.Prime) (hpL : (p : L) ≠ 0)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1)
    (h1 : rootDiagUnit τ a ≠ 1) {K : Subgroup (ModGL τ L)}
    (hK : IsComponentOf K (S.Γ ⊓ Subgroup.centralizer {rootDiagUnit τ a})) :
    ∃ i : KernelComponent (rootCharHom a),
      CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i) ∧
        K = rationalComponent S.ρ S.Γ (rootCharHom a) i := by
  haveI := S.finite
  have hfin : Finite S.Γ := Finite.of_injective
    (Subgroup.inclusion (Subgroup.commutator_le_self S.D.model)) (Subgroup.inclusion_injective _)
  exact CFSG.HardMathSupport.Dickson.Sec6.Up34Exc.exists_rationalComponent_eq_of_isComponentOf S hp
    hT hap (langSetup_hTame_of_prime S hp hpL (fun h => absurd h hτ) hT hap h1) hfin hK

end Exhaust

