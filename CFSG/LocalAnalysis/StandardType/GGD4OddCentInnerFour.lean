private theorem four_omFixDim_eq (t : Om8 K) :
    D4Rank.omFixDim t = Module.finrank K (fixedSpace
      ((CFSG.RankThree.PartOne.KCOrthComm.matrixDerivedEquiv (coordinateQuadPlus 4 K) t :
        orthDerived (coordinateQuadPlus 4 K)) : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K))) := by
  refine congrArg (fun W : Submodule K (Fin (2 * 4) → K) => Module.finrank K W) ?_
  ext v
  rw [D4Rank.mem_ker_omRep_sub_one, mem_fixedSpace]
  rfl

private theorem four_exists_SL2 {n : ℕ} (hK : Nat.card K = 2 ^ n) (hodd : Odd n)
    {x : orthDerived (coordinateQuadPlus 4 K)} (hx3 : orderOf x = 3)
    (hfix : Module.finrank K
      (fixedSpace (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K))) = 4)
    {L : Subgroup (ProjOrthDerived (coordinateQuadPlus 4 K))}
    (hL : CFSG.Open.IsComponentOf L (centralizerImage (coordinateQuadPlus 4 K)
      (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)))) :
    2 ≤ n ∧ ∃ (k : Type) (_ : Field k) (_ : Finite k), Nat.card k = 2 ^ n ∧
      Nonempty (↥L ≃* Matrix.SpecialLinearGroup (Fin 2) k) := by
  classical
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadPlus 4 K (by norm_num)
  have : Nontrivial (Fin (2 * 4) → K) := by
    obtain ⟨U, hU3, -⟩ := hT
    exact Module.nontrivial_of_finrank_pos (R := K)
      (lt_of_lt_of_le (by norm_num : 0 < 3) (hU3 ▸ Submodule.finrank_le U))
  have hpl : (3 : ℕ) ≠ ringChar K := by
    rw [ringChar.eq K 2]
    norm_num
  have hx := oddOrderIsometry_of_orthDerived Nat.prime_three hpl hQ x hx3
  have hx1 : (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) ≠ 1 := fun h1 => by
    have : x = 1 := Subtype.ext h1
    rw [this, orderOf_one] at hx3
    omega
  have hpq : 3 ∣ Nat.card K + 1 := by
    rw [hK]
    simpa using Odd.nat_add_dvd_pow_add_pow 2 1 hodd
  have hplus : CFSG.GroupTheory.WeirSylow.IsPlusType (coordinateQuadPlus 4 K) :=
    (CFSG.GroupTheory.WeirSylow.isPlusType_congr (coordinatePlusIsometry 4 K)).1
      (CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus K 4)
  obtain ⟨-, t, ht, htm, htype⟩ := CFSG.HardMathSupport.Dickson.Bal207.OrthFix.dims hx hpq hx1
    (n := 4) (by rw [Module.finrank_fin_fun]) (iff_of_true hplus (by decide))
  obtain rfl : t = 2 := by omega
  rcases CFSG.LocalAnalysis.GLTheoremA.KD264Lie.exists_component_dichotomy Nat.prime_three
      (by norm_num) hQ hT hpl hx L hL with
    ⟨h, hh, hne1, hq, hLeq⟩ | ⟨-, F, hFq, hFle, hFn, hLeq⟩
  ·
    obtain rfl := CFSG.HardMathSupport.Dickson.Bal207.OrthFix.eq_phi hx hpq hh hne1
    obtain ⟨k, _, _, hk, ⟨eS⟩⟩ := SevOmSmall.exists_specialBlock_equiv_SL2 hx Nat.prime_three
      (by norm_num) hpq hh hne1 (by omega)
    have hsΩ := specialBlock_le_orthDerived_of_perfect hq.1
      ((specialBlock_le_isometryCentralizer _).trans fun _ hg => (Subgroup.mem_inf.mp hg).1)
    have hn : 2 ≤ n := by
      by_contra hn
      have hn1 : n = 1 := by
        obtain ⟨j, rfl⟩ := hodd
        omega
      have := CFSG.LocalCores.isQuasisimple_nontrivial hq
      have : Group.IsPerfect ↥(specialBlock (coordinateQuadPlus 4 K)
          (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) (X ^ 2 + X + 1)) := hq.1
      have := SevOmSmall.isSolvable_SL_two (hk.trans (by rw [hK, hn1, pow_one]))
      exact Group.IsPerfect.not_isSolvable _
        (Group.isSolvable_of_isSolvable_injective (f := eS.toMonoidHom) eS.injective)
    refine ⟨hn, k, inferInstance, inferInstance, hk.trans hK, ⟨?_⟩⟩
    subst hLeq
    exact ((Subgroup.equivMapOfInjective _ (CFSG.RankThree.PartOne.piOrth _)
      (CFSG.RankThree.PartOne.piOrth_injective hQ)).symm.trans
        (Subgroup.subgroupOfEquivOfLe hsΩ)).trans eS
  ·
    have hFΩ : F ≤ orthDerived (coordinateQuadPlus 4 K) :=
      hFle.trans hx.supportedFixedDerived_le_orthDerived
    have hR := hx.polarBilin_fixed_nondegenerate
    let eS := supportedFixedDerivedEquiv hx
    let N := (F.subgroupOf (supportedFixedDerived (coordinateQuadPlus 4 K)
      (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)))).map eS.toMonoidHom
    let eFN : ↥F ≃* ↥N := (Subgroup.subgroupOfEquivOfLe hFle).symm.trans
      (Subgroup.equivMapOfInjective _ eS.toMonoidHom eS.injective)
    have hNn : N.Normal := hFn.map eS.toMonoidHom eS.surjective
    let eNT : ↥N ≃* ↥(N.map (orthDerived _).subtype) :=
      N.equivMapOfInjective _ (orthDerived _).subtype_injective
    have hTq := CFSG.LocalCores.isQuasisimple_of_mulEquiv (eFN.trans eNT) hFq
    obtain ⟨S, hS, hSs⟩ := (htype (by norm_num)).2 (by decide)
    obtain ⟨-, ⟨hns, -⟩ | ⟨-, h4, ψ, hψ, hψT⟩⟩ :=
      OmNonsplit.structure_of_isSubnormal hR hTq (four_isSubnormal_map_subtype N hNn)
    · exact (hns ⟨hfix, S, by omega, hSs⟩).elim
    · have hn : 2 ≤ n := by
        by_contra hn
        have hn1 : n = 1 := by
          obtain ⟨j, rfl⟩ := hodd
          omega
        rw [hK, hn1] at h4
        norm_num at h4
      refine ⟨hn, K, inferInstance, inferInstance, hK, ⟨?_⟩⟩
      subst hLeq
      exact ((Subgroup.equivMapOfInjective _ (CFSG.RankThree.PartOne.piOrth _)
        (CFSG.RankThree.PartOne.piOrth_injective hQ)).symm.trans
          (Subgroup.subgroupOfEquivOfLe hFΩ)).trans (eFN.trans (eNT.trans
            ((MulEquiv.subgroupCongr hψT.symm).trans (MonoidHom.ofInjective hψ).symm)))

theorem ggD4InnerFourInput_holds : GGD4InnerFourInput := by
  intro K _ _ _ n hK hodd s hs3 hd J hJ
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadPlus 4 K (by norm_num)
  have : Nontrivial (Fin (2 * 4) → K) := by
    obtain ⟨U, hU3, -⟩ := hT
    exact Module.nontrivial_of_finrank_pos (R := K)
      (lt_of_lt_of_le (by norm_num : 0 < 3) (hU3 ▸ Submodule.finrank_le U))
  set E : Om8 K ≃* ProjOrthDerived (coordinateQuadPlus 4 K) :=
    projEquiv8.trans (CFSG.RankThree.PartOne.KCOrthogonalAut.coordBridge
      (coordinateQuadPlus 4 K) (by norm_num : 0 < 2 * 4)) with hE
  set x : orthDerived (coordinateQuadPlus 4 K) :=
    CFSG.RankThree.PartOne.KCOrthComm.matrixDerivedEquiv (coordinateQuadPlus 4 K) s with hx
  have hfix : Module.finrank K
      (fixedSpace (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K))) = 4 :=
    (four_omFixDim_eq s).symm.trans hd
  have hx3 : orderOf x = 3 := by
    refine orderOf_eq_prime (by rw [hx, ← map_pow, hs3, map_one]) fun h1 => ?_
    have htop : fixedSpace (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) = ⊤ := by
      refine eq_top_iff.2 fun v _ => mem_fixedSpace.2 ?_
      rw [h1]
      rfl
    rw [htop, finrank_top, Module.finrank_fin_fun] at hfix
    omega
  have hcent : (Subgroup.centralizer ({s} : Set (Om8 K))).map
      (E : Om8 K →* ProjOrthDerived (coordinateQuadPlus 4 K)) =
      centralizerImage (coordinateQuadPlus 4 K)
        (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) := by
    rw [four_map_centralizer, hE, bridge_apply_eq_mk,
      CFSG.RankThree.PartOne.centralizerImage_eq hQ x]
    rfl
  have hJ' : CFSG.Open.IsComponentOf
      (J.map (E : Om8 K →* ProjOrthDerived (coordinateQuadPlus 4 K)))
      (centralizerImage (coordinateQuadPlus 4 K)
        (x : (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K))) := by
    rw [← hcent, ← four_ggAutFixed_conj]
    exact CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map E
      (CFSG.Assembly.isComponentOf_iff_open.1 hJ)
  obtain ⟨hn, k, _, _, hk, ⟨e⟩⟩ := four_exists_SL2 hK hodd hx3 hfix hJ'
  exact largeEvenMarking_A1_of_mulEquiv hJ.2.2.1 hn hk
    ((J.equivMapOfInjective (E : Om8 K →* ProjOrthDerived (coordinateQuadPlus 4 K))
      E.injective).trans e)

