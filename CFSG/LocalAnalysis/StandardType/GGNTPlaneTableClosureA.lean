private abbrev n1cA_PS2 (j : ℕ) : Prop :=
  n1cA_parent2.getD j 0 < j ∧
  n1cA_genIdx2.getD j 0 < 5 ∧
  n1cA_closure2.getD j 0 =
    n1cA_codeMul (n1cA_closure2.getD (n1cA_parent2.getD j 0) 0)
      (n1cA_genSmall2.getD (n1cA_genIdx2.getD j 0) 0) ∧
  n1cA_inRange (n1cA_prod (n1cA_closure2.getD (n1cA_parent2.getD j 0) 0)
    (n1cA_genSmall2.getD (n1cA_genIdx2.getD j 0) 0)) = true
private theorem n1cA_walk2 :
    n1cA_walk n1cA_genSmall2 1 0 (n1cA_closure2.drop 0) (n1cA_closure2.drop 1)
      (n1cA_parent2.drop 1) (n1cA_genIdx2.drop 1) = true := by
  decide +kernel

private theorem n1cA_len2 :
    n1cA_closure2.length = 720 ∧ n1cA_parent2.length = 720 ∧ n1cA_genIdx2.length = 720 := by
  decide +kernel

private theorem n1cA_PS2_b0 : ∀ i : Fin 480, n1cA_PS2 (i.val + 1) := fun i => by
  have := n1cA_len2
  exact n1cA_walk_sound _ _ _ _ _ 1 0 rfl n1cA_walk2 _ (by omega) (by omega) (by omega) (by omega)

private theorem n1cA_PS2_b1 : ∀ i : Fin 239, n1cA_PS2 (i.val + 481) := fun i => by
  have := n1cA_len2
  exact n1cA_walk_sound _ _ _ _ _ 1 0 rfl n1cA_walk2 _ (by omega) (by omega) (by omega) (by omega)

private theorem n1cA_PS2_all (i : ℕ) (h0 : 0 < i) (hi : i < 720) : n1cA_PS2 i := by
  by_cases h1 : i < 481
  · have : i = (i - 1) + 1 := by omega
    rw [this]
    exact n1cA_PS2_b0 ⟨i - 1, by omega⟩
  have : i = (i - 481) + 481 := by omega
  rw [this]
  exact n1cA_PS2_b1 ⟨i - 481, by omega⟩

private theorem n1cA_reach2 (i : ℕ) (hi : i < n1cA_closure2.length) :
    n1cA_decode (n1cA_closure2.getD i 0) ∈
      Submonoid.closure (↑(n1cA_genSmall (reps 2)).toFinset :
        Set (Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ)) := by
  induction i using Nat.strong_induction_on with
  | h i ih =>
    rcases Nat.eq_zero_or_pos i with rfl | hpos
    · have h0 : n1cA_closure2.getD 0 0 =
          n1cA_encode (1 : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ) := by decide +kernel
      have hb := n1cA_inRange_sound (1 : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ)
        (by decide +kernel)
      rw [h0, n1cA_decode_encode _ hb]
      exact Submonoid.one_mem _
    · have hi' : i < 720 := by
        have : n1cA_closure2.length = 720 := by decide +kernel
        omega
      obtain ⟨hpar, hgi, hprod, hrange⟩ := n1cA_PS2_all i hpos hi'
      have hb := n1cA_inRange_sound _ hrange
      have hEq : n1cA_decode (n1cA_codeMul
            (n1cA_closure2.getD (n1cA_parent2.getD i 0) 0)
            (n1cA_genSmall2.getD (n1cA_genIdx2.getD i 0) 0)) =
          n1cA_decode (n1cA_closure2.getD (n1cA_parent2.getD i 0) 0) *
          n1cA_decode (n1cA_genSmall2.getD (n1cA_genIdx2.getD i 0) 0) :=
        n1cA_decode_encode _ hb
      rw [hprod, hEq]
      apply Submonoid.mul_mem
      · exact ih (n1cA_parent2.getD i 0) hpar (by omega)
      · have hlen : (n1cA_genSmall (reps 2)).length = 5 := by decide +kernel
        have hmem : n1cA_decode (n1cA_genSmall2.getD (n1cA_genIdx2.getD i 0) 0) ∈
            n1cA_genSmall (reps 2) := by
          have hcheck : ∀ j : Fin 5,
              n1cA_decode (n1cA_genSmall2.getD j.val 0) ∈ n1cA_genSmall (reps 2) := by
            decide +kernel
          exact hcheck ⟨n1cA_genIdx2.getD i 0, hgi⟩
        exact Submonoid.subset_closure (by simpa [Finset.mem_coe, List.mem_toFinset] using hmem)

private theorem n1cA_genSmall2_sub :
    (↑(n1cA_genSmall (reps 2)).toFinset :
        Set (Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ)) ⊆ kerReflSet (reps 2) := by
  intro M hM
  rw [Finset.mem_coe, List.mem_toFinset] at hM
  rw [n1cA_genSmall] at hM
  obtain ⟨α, hα, rfl⟩ := List.mem_map.mp hM
  exact ⟨α, n1cA_mem_kerRootList_iff.mp (List.drop_subset _ _ hα), rfl⟩

private theorem n1cA_lower2 :
    ∃ L : List (Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ), L.Nodup ∧
      L.length = repKerGroupOrder 2 ∧ ∀ g ∈ L, g ∈ Submonoid.closure (kerReflSet (reps 2)) := by
  refine ⟨n1cA_closureMats2, ?_, ?_, ?_⟩
  · apply CFSG.Decide.nodup_of_bitsetNodup (fun M => n1cA_encode M % (2^20))
    decide +kernel
  · rw [n1cA_closureMats2, List.length_map]
    decide +kernel
  · intro g hg
    rw [n1cA_closureMats2] at hg
    obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hg
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hc
    rw [← List.getD_eq_getElem n1cA_closure2 0 hi]
    exact Submonoid.closure_mono n1cA_genSmall2_sub (n1cA_reach2 i (by simpa using hi))

theorem exists_nodup_closure_kerReflSet_rep_lt3 (k : Fin 7) (hk : k.val < 3) :
    ∃ L : List (Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ), L.Nodup ∧
      L.length = repKerGroupOrder k ∧ ∀ g ∈ L, g ∈ Submonoid.closure (kerReflSet (reps k)) := by
  have hk' : k = 0 ∨ k = 1 ∨ k = 2 := by
    have h := k.isLt
    omega
  rcases hk' with rfl | rfl | rfl
  · exact n1cA_lower0
  · rw [show kerReflSet (reps 1) = kerReflSet (reps 0) from by
      simp only [kerReflSet, n1cA_kerRoots_one_eq]]
    simpa [repKerGroupOrder] using n1cA_lower0
  · exact n1cA_lower2

