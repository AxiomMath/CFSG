open CFSG.Blueprint.Chevalley

@[expose] def n1cA_kerRootList (x : X3) : List (Fin Tag.E6.rank → ℤ) :=
  e6RootList.filter (fun α => pairVec x α = 0)

@[expose] def n1cA_genSmall (x : X3) :
    List (Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ) :=
  ((n1cA_kerRootList x).drop ((n1cA_kerRootList x).length - 5)).map reflMatRoot

@[expose] def n1cA_digitList (M : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ) : List ℕ :=
  List.ofFn fun k : Fin 36 =>
    (M ⟨k.val / 6, by have h : Tag.E6.rank = 6 := rfl; omega⟩
       ⟨k.val % 6, by have h : Tag.E6.rank = 6 := rfl; omega⟩ + 3).toNat

@[expose] def n1cA_encode (M : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ) : ℕ :=
  Nat.ofDigits 7 (n1cA_digitList M)

@[expose] def n1cA_decode (c : ℕ) : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ :=
  Matrix.of fun i j => ((c / 7 ^ (6 * i.val + j.val)) % 7 : ℕ) - 3

@[expose] def n1cA_prod (c d : ℕ) : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ :=
  n1cA_decode c * n1cA_decode d

@[expose] def n1cA_codeMul (c1 c2 : ℕ) : ℕ :=
  n1cA_encode (n1cA_prod c1 c2)

@[expose] def n1cA_inRange (M : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ) : Bool :=
  (List.ofFn fun i : Fin Tag.E6.rank =>
    (List.ofFn fun j : Fin Tag.E6.rank => decide (-3 ≤ M i j ∧ M i j ≤ 3)).all id).all id

private theorem n1cA_inRange_sound (M : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ)
    (h : n1cA_inRange M = true) : ∀ i j, -3 ≤ M i j ∧ M i j ≤ 3 := by
  intro i j
  have h1 : (List.ofFn fun j : Fin Tag.E6.rank =>
      decide (-3 ≤ M i j ∧ M i j ≤ 3)).all id = true :=
    List.all_eq_true.mp h _ (List.mem_ofFn.mpr ⟨i, rfl⟩)
  exact of_decide_eq_true (List.all_eq_true.mp h1 _ (List.mem_ofFn.mpr ⟨j, rfl⟩))

private theorem n1cA_kerRoots_eq_filter (k : Fin 7) :
    kerRoots (reps k) = ↑(e6RootList.filter (fun α => pairVec (reps k) α = 0)).toFinset := by
  ext α
  simp [kerRoots, isRoot_iff_mem_e6RootList]

private theorem n1cA_mem_kerRootList_iff {x : X3} {α : Fin Tag.E6.rank → ℤ} :
    α ∈ n1cA_kerRootList x ↔ α ∈ kerRoots x := by
  rw [n1cA_kerRootList, List.mem_filter]
  constructor
  · intro h
    exact ⟨(isRoot_iff_mem_e6RootList α).mpr h.1, of_decide_eq_true h.2⟩
  · intro h
    exact ⟨(isRoot_iff_mem_e6RootList α).mp h.1, decide_eq_true h.2⟩

theorem ncard_kerRoots_rep_lt3 (k : Fin 7) (hk : k.val < 3) :
    (kerRoots (reps k)).ncard = repKerCard k := by
  have hk' : k = 0 ∨ k = 1 ∨ k = 2 := by
    have h := k.isLt
    omega
  rcases hk' with rfl | rfl | rfl <;>
  rw [n1cA_kerRoots_eq_filter] <;>
  rw [Set.ncard_coe_finset] <;>
  decide +kernel

private theorem n1cA_dig_ofDigits (L : List ℕ) (hL : ∀ l ∈ L, l < 7) :
    ∀ (a : ℕ) (ha : a < L.length), Nat.ofDigits 7 L / 7^a % 7 = L[a] := by
  induction L with
  | nil => intro a ha; simp at ha
  | cons d tl ih =>
    intro a ha
    cases a with
    | zero =>
      simp only [Nat.ofDigits_cons, pow_zero, Nat.div_one, List.getElem_cons_zero]
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hL d (by simp))]
    | succ a =>
      simp only [Nat.ofDigits_cons, pow_succ, List.getElem_cons_succ]
      have hd : d < 7 := hL d (by simp)
      have hlt : a < tl.length := by simpa using ha
      have hih := ih (fun l hl => hL l (by simp [hl])) a hlt
      rw [Nat.mul_comm (7^a) 7, ← Nat.div_div_eq_div_mul]
      rw [Nat.add_mul_div_left d (Nat.ofDigits 7 tl) (by norm_num : 0 < 7)]
      rw [Nat.div_eq_of_lt hd, Nat.zero_add]
      exact hih

private theorem n1cA_decode_encode (M : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ)
    (hM : ∀ i j, -3 ≤ M i j ∧ M i j ≤ 3) :
    n1cA_decode (n1cA_encode M) = M := by
  ext i j
  simp only [n1cA_decode, n1cA_encode, Matrix.of_apply]
  have hmem : ∀ l ∈ n1cA_digitList M, l < 7 := by
    intro l hl
    simp only [n1cA_digitList, List.mem_ofFn] at hl
    obtain ⟨k, rfl⟩ := hl
    have h := hM ⟨k.val / 6, by have h : Tag.E6.rank = 6 := rfl; omega⟩
      ⟨k.val % 6, by have h : Tag.E6.rank = 6 := rfl; omega⟩
    omega
  have hlen : 6 * i.val + j.val < (n1cA_digitList M).length := by
    simp only [n1cA_digitList, List.length_ofFn]
    have h : Tag.E6.rank = 6 := rfl
    omega
  rw [n1cA_dig_ofDigits _ hmem _ hlen]
  have hget : (n1cA_digitList M)[6 * i.val + j.val] = (M i j + 3).toNat := by
    have h1 : (⟨(6 * i.val + j.val) / 6, by have h : Tag.E6.rank = 6 := rfl; omega⟩ :
        Fin Tag.E6.rank) = i := by
      ext; simp
      have hi : i.val < 6 := by have h : Tag.E6.rank = 6 := rfl; omega
      have hj : j.val < 6 := by have h : Tag.E6.rank = 6 := rfl; omega
      omega
    have h2 : (⟨(6 * i.val + j.val) % 6, by have h : Tag.E6.rank = 6 := rfl; omega⟩ :
        Fin Tag.E6.rank) = j := by
      ext; simp
      have hj : j.val < 6 := by have h : Tag.E6.rank = 6 := rfl; omega
      omega
    simp only [n1cA_digitList, List.getElem_ofFn]
    rw [h1, h2]
  rw [hget]
  have := hM i j
  omega

private theorem n1cA_reps_one : reps 1 = 2 • reps 0 := by
  ext i
  fin_cases i <;> decide

private theorem n1cA_pairVec_two_smul (x : X3) (v : Fin Tag.E6.rank → ℤ) :
    pairVec (2 • x) v = 2 * pairVec x v := by
  simp only [pairVec, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring

private theorem n1cA_kerRoots_one_eq : kerRoots (reps 1) = kerRoots (reps 0) := by
  ext α
  simp only [kerRoots, Set.mem_setOf_eq]
  rw [n1cA_reps_one, n1cA_pairVec_two_smul]
  constructor
  · intro h
    have h2 : (2 : ZMod 3) ≠ 0 := by decide
    rcases mul_eq_zero.mp h.2 with h' | h'
    · exact absurd h' h2
    · exact ⟨h.1, h'⟩
  · intro h
    exact ⟨h.1, by rw [h.2, mul_zero]⟩

private def n1cA_dig (c t : ℕ) : ℕ := c / 7 ^ t % 7

private def n1cA_row (p i : ℕ) : List ℕ :=
  List.ofFn fun j : Fin Tag.E6.rank => n1cA_dig p (6 * i + j.val)

private def n1cA_col (g k : ℕ) : List ℕ :=
  List.ofFn fun j : Fin Tag.E6.rank => n1cA_dig g (6 * j.val + k)

private noncomputable def n1cA_dot9 (R : List ℕ) : List ℕ → ℕ :=
  List.rec (motive := fun _ => List ℕ → ℕ) (fun _ => 0)
    (fun a _ ih C => List.rec (motive := fun _ => ℕ) 0 (fun b C' _ => a * b + 9 + ih C') C) R

private theorem n1cA_dot9_cons (a b : ℕ) (R C : List ℕ) :
    n1cA_dot9 (a :: R) (b :: C) = a * b + 9 + n1cA_dot9 R C := rfl

private theorem n1cA_dot9_ofFn {n : ℕ} (a b : Fin n → ℕ) :
    n1cA_dot9 (List.ofFn a) (List.ofFn b) = ∑ j, (a j * b j + 9) := by
  induction n with
  | zero => rfl
  | succ n ih => rw [List.ofFn_succ, List.ofFn_succ, n1cA_dot9_cons, ih, Fin.sum_univ_succ]

private theorem n1cA_prod_add_three (p g : ℕ) (i k : Fin Tag.E6.rank) :
    n1cA_prod p g i k + 3 = ((n1cA_dot9 (n1cA_row p i) (n1cA_col g k) + 3 : ℕ) : ℤ) -
      ((3 * ((n1cA_row p i).sum + (n1cA_col g k).sum) : ℕ) : ℤ) := by
  have h : ∀ x y : ℤ, (x - 3) * (y - 3) = (x * y + 9) - 3 * (x + y) := fun x y => by ring
  simp only [n1cA_row, n1cA_col, n1cA_dot9_ofFn, List.sum_ofFn, n1cA_prod, n1cA_decode,
    Matrix.mul_apply, Matrix.of_apply, n1cA_dig, h, Finset.sum_sub_distrib]
  push_cast
  rw [← Finset.sum_add_distrib, Finset.mul_sum]
  ring

private noncomputable def n1cA_entry (R C : List ℕ) : ℕ :=
  if 3 * (R.sum + C.sum) ≤ n1cA_dot9 R C + 3 then n1cA_dot9 R C + 3 - 3 * (R.sum + C.sum) else 7

private noncomputable def n1cA_prodDigs (p g : ℕ) : List ℕ :=
  (List.ofFn fun i : Fin 6 => List.ofFn fun k : Fin 6 =>
    n1cA_entry (n1cA_row p i) (n1cA_col g k)).flatten

private theorem n1cA_prodDigs_sound {p g : ℕ} (h : ∀ d ∈ n1cA_prodDigs p g, d < 7) :
    n1cA_digitList (n1cA_prod p g) = n1cA_prodDigs p g ∧
      n1cA_inRange (n1cA_prod p g) = true := by
  have hE : Tag.E6.rank = 6 := rfl
  have key : ∀ i k : ℕ, i < 6 → k < 6 →
      3 * ((n1cA_row p i).sum + (n1cA_col g k).sum) ≤ n1cA_dot9 (n1cA_row p i) (n1cA_col g k) + 3 ∧
      n1cA_dot9 (n1cA_row p i) (n1cA_col g k) + 3 ≤
        3 * ((n1cA_row p i).sum + (n1cA_col g k).sum) + 6 := by
    intro i k hi hk
    have hm := h (n1cA_entry (n1cA_row p i) (n1cA_col g k))
      (List.mem_flatten.mpr ⟨_, List.mem_ofFn.mpr ⟨⟨i, hi⟩, rfl⟩, List.mem_ofFn.mpr ⟨⟨k, hk⟩, rfl⟩⟩)
    simp only [n1cA_entry] at hm
    split_ifs at hm with hle <;> omega
  refine ⟨?_, ?_⟩
  · rw [n1cA_digitList, List.ofFn_mul (m := 6) (n := 6), n1cA_prodDigs]
    refine congrArg List.flatten (List.ofFn_inj.mpr (funext fun i =>
      List.ofFn_inj.mpr (funext fun k => ?_)))
    have hP := n1cA_prod_add_three p g ⟨i.val, by omega⟩ ⟨k.val, by omega⟩
    obtain ⟨h1, -⟩ := key i.val k.val i.isLt k.isLt
    have hi : (i.val * 6 + k.val) / 6 = i.val := by omega
    have hk : (i.val * 6 + k.val) % 6 = k.val := by omega
    simp only [hi, hk]
    rw [hP, n1cA_entry, if_pos h1, Int.toNat_sub]
  · simp only [n1cA_inRange, List.all_eq_true, List.mem_ofFn, id_eq, forall_exists_index,
      forall_apply_eq_imp_iff, decide_eq_true_eq]
    intro i k
    have hP := n1cA_prod_add_three p g i k
    obtain ⟨h1, h2⟩ := key i.val k.val (by omega) (by omega)
    omega

private noncomputable def n1cA_stepOK (c p g : ℕ) : Bool :=
  (n1cA_prodDigs p g).all (· < 7) && c == Nat.ofDigits 7 (n1cA_prodDigs p g)

private theorem n1cA_stepOK_sound {c p g : ℕ} (h : n1cA_stepOK c p g = true) :
    c = n1cA_codeMul p g ∧ n1cA_inRange (n1cA_prod p g) = true := by
  simp only [n1cA_stepOK, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq,
    beq_iff_eq] at h
  obtain ⟨hd, hr⟩ := n1cA_prodDigs_sound h.1
  exact ⟨by rw [h.2, n1cA_codeMul, n1cA_encode, hd], hr⟩

private noncomputable def n1cA_walk (gens : List ℕ) :
    ℕ → ℕ → List ℕ → List ℕ → List ℕ → List ℕ → Bool
  | j, q, qs, c :: cs, p :: ps, g :: gs =>
      (q ≤ p && p < j && g < 5 && n1cA_stepOK c ((qs.drop (p - q)).headD 0) (gens.getD g 0)) &&
        n1cA_walk gens (j + 1) p (qs.drop (p - q)) cs ps gs
  | _, _, _, _, _, _ => true

private abbrev n1cA_PS (clos par gi gens : List ℕ) (j : ℕ) : Prop :=
  par.getD j 0 < j ∧
  gi.getD j 0 < 5 ∧
  clos.getD j 0 = n1cA_codeMul (clos.getD (par.getD j 0) 0) (gens.getD (gi.getD j 0) 0) ∧
  n1cA_inRange (n1cA_prod (clos.getD (par.getD j 0) 0) (gens.getD (gi.getD j 0) 0)) = true

private theorem n1cA_getD_of_drop {l l' : List ℕ} {j a : ℕ} (h : l.drop j = a :: l') :
    l.getD j 0 = a := by
  have h0 := congrArg (·[0]?) h
  simp only [List.getElem?_drop, Nat.add_zero, List.getElem?_cons_zero] at h0
  rw [List.getD_eq_getElem?_getD, h0, Option.getD_some]

private theorem n1cA_drop_succ_of_drop {l l' : List ℕ} {j a : ℕ} (h : l.drop j = a :: l') :
    l.drop (j + 1) = l' := by
  rw [← List.drop_drop, h, List.drop_one, List.tail_cons]

private theorem n1cA_walk_sound (clos par gi gens : List ℕ) :
    ∀ (cs : List ℕ) (j q : ℕ), clos.drop j = cs →
      n1cA_walk gens j q (clos.drop q) cs (par.drop j) (gi.drop j) = true →
      ∀ t, j ≤ t → t < clos.length → t < par.length → t < gi.length →
        n1cA_PS clos par gi gens t := by
  intro cs
  induction cs with
  | nil =>
    intro j q hcs _ t hjt ht _ _
    have := List.drop_eq_nil_iff.mp hcs
    omega
  | cons c cs ih =>
    intro j q hcs hw t hjt ht hpt hgt
    obtain ⟨p, ps, hps⟩ : ∃ p ps, par.drop j = p :: ps := by
      cases h : par.drop j with
      | nil => have := List.drop_eq_nil_iff.mp h; omega
      | cons p ps => exact ⟨p, ps, rfl⟩
    obtain ⟨g, gs, hgs⟩ : ∃ g gs, gi.drop j = g :: gs := by
      cases h : gi.drop j with
      | nil => have := List.drop_eq_nil_iff.mp h; omega
      | cons g gs => exact ⟨g, gs, rfl⟩
    rw [hps, hgs] at hw
    simp only [n1cA_walk, Bool.and_eq_true, decide_eq_true_eq] at hw
    obtain ⟨⟨⟨⟨hqp, hpj⟩, hg5⟩, hstep⟩, hrest⟩ := hw
    have hdrop : (clos.drop q).drop (p - q) = clos.drop p := by
      rw [List.drop_drop]
      congr 1
      omega
    rw [hdrop] at hstep hrest
    rcases Nat.eq_or_lt_of_le hjt with heq | hlt
    · rw [← heq]
      have hp : par.getD j 0 = p := n1cA_getD_of_drop hps
      have hg : gi.getD j 0 = g := n1cA_getD_of_drop hgs
      have hc : clos.getD j 0 = c := n1cA_getD_of_drop hcs
      rw [List.headD_eq_head?_getD, List.head?_drop, ← List.getD_eq_getElem?_getD] at hstep
      obtain ⟨h1, h2⟩ := n1cA_stepOK_sound hstep
      refine ⟨hp ▸ hpj, hg ▸ hg5, ?_, ?_⟩
      · rw [hc, hp, hg]
        exact h1
      · rw [hp, hg]
        exact h2
    · rw [← n1cA_drop_succ_of_drop hps, ← n1cA_drop_succ_of_drop hgs] at hrest
      exact ih (j + 1) p (n1cA_drop_succ_of_drop hcs) hrest t hlt ht hpt hgt

