theorem twisted_setup_plus
    {f : ℕ} (hf : 1 ≤ f)
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ f) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (2 ^ f)) (h3 : 3 ∣ 2 ^ f + 1) :
    ∃ (S : LangSetup Tag.E6 (AlgebraicClosure K) 5)
      (e : twistedE6RootGroup K σ ≃* S.Γ),
      S.DescendsTwE6 ∧ (∀ α, S.ρ α = -α) ∧
      (∀ a : Fin Tag.E6.rank → (AlgebraicClosure K)ˣ, (∀ i, a i ^ 3 = 1) →
        rootDiagUnit Tag.E6 a ∈ S.D.torus) ∧
      (∀ φ ∈ twistedE6Inn K σ ⊔ twistedE6Diag K σ,
        ∃ d ∈ S.D.model, ∀ x : twistedE6RootGroup K σ,
          (e (φ x) : ModGL Tag.E6 (AlgebraicClosure K)) =
            d * (e x : ModGL Tag.E6 (AlgebraicClosure K)) * d⁻¹) ∧
      (∀ d ∈ S.D.model, (∀ x : S.Γ, d * (x : ModGL Tag.E6 (AlgebraicClosure K)) * d⁻¹ = x) →
        d = 1) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let L := AlgebraicClosure K
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (f := f * 2) (by
    rw [← Nat.card_eq_fintype_card, hK, ← pow_mul])
  haveI : CharP L 2 := charP_of_injective_algebraMap (algebraMap K L).injective 2
  haveI : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  let Fr : L →+* L := iterateFrobenius L 2 f
  have hFr : ∀ c : L, Fr c = c ^ 2 ^ f := fun c => iterateFrobenius_def 2 f c
  let D : LangDatum TwistTag.E6.tag L := CFSG.LocalAnalysis.GLTheoremA.Y10F.twE6EnnolaDatum
    (ℓ := 2) (Ω := L) Nat.prime_two hf hK hFr
  have hDΦ : D.Φ = twistHom TwistTag.E6 L Fr := rfl
  have hρ : FrobRootMap D (Equiv.neg (Fin Tag.E6.rank → ℤ)) :=
    CFSG.LocalAnalysis.GLTheoremA.Y10F.twE6EnnolaDatum_frob (ℓ := 2) (Ω := L)
      Nat.prime_two hf hK hFr
  have hf0 : f ≠ 0 := by omega
  have hqpow : IsPrimePow D.q ∧ ((D.q : ℕ) : L) = 0 := by
    constructor
    · change IsPrimePow (2 ^ f)
      exact Nat.prime_two.isPrimePow.pow hf0
    · change (((2 ^ f : ℕ)) : L) = 0
      exact (CharP.cast_eq_zero_iff L 2 (2 ^ f)).2 (dvd_pow_self 2 hf0)
  have hpq : ¬ 5 ∣ D.q := by
    change ¬ (5 : ℕ) ∣ 2 ^ f
    intro h
    have h52 : (5 : ℕ) ∣ 2 := Nat.prime_five.dvd_of_dvd_pow h
    norm_num at h52
  have hfin : Finite D.model :=
    finite_model_twistedE6 Nat.prime_two hf hK hσ hFr D hDΦ
  let S : LangSetup TwistTag.E6.tag L 5 :=
    D.toSetup 5 (Equiv.neg (Fin Tag.E6.rank → ℤ)) hρ Nat.prime_five (Or.inl le_rfl)
      hqpow hpq hfin
  have hAlg : S.IsAlgebraic := by
    refine S.isAlgebraic_of_isAlgClosure K 2 ?_
    change Nat.card K = (2 ^ f) ^ 2
    exact hK
  let e : twistedE6RootGroup K σ ≃* S.Γ :=
    twistedE6EquivΓ (ℓ := 2) Nat.prime_two hf hK hσ hFr D hDΦ
  have hcoe : ∀ y : twistedE6RootGroup K σ,
      (e y : ModGL TwistTag.E6.tag L) =
        D.g0⁻¹ * baseChangeGL (algebraMap K L) (y : ModGL TwistTag.E6.tag K) * D.g0 :=
    fun y => coe_twistedE6EquivΓ Nat.prime_two hf hK hσ hFr D hDΦ y
  have hmodel : D.model = (twistedFixedGroup TwistTag.E6 L Fr).map
      (MulAut.conj D.g0⁻¹).toMonoidHom :=
    model_eq_map_twistedFixedGroup D hDΦ
  refine ⟨S, e, ?_, ?_, ?_, ?_, ?_⟩
  · refine LangSetup.descendsTwE6 S ⟨Fr, ?_, ?_⟩ hAlg
    · intro c
      change Fr c = c ^ (2 ^ f)
      exact hFr c
    · change D.Φ = twistHom TwistTag.E6 L Fr
      exact hDΦ
  · intro α
    change (Equiv.neg (Fin Tag.E6.rank → ℤ)) α = -α
    rfl
  · intro a ha
    have hq1 : ∀ i, a i ^ (2 ^ f + 1) = 1 := by
      intro i
      obtain ⟨k, hk⟩ := h3
      rw [hk, pow_mul, ha i, one_pow]
    exact (CFSG.LocalAnalysis.GLTheoremA.Y10F.twE6EnnolaDatum_torus
      (ℓ := 2) (Ω := L) Nat.prime_two hf hK hFr).2 hq1
  · intro φ hφ
    have hφrange : φ ∈ (twistedE6InndiagConj K σ).range := by
      rw [range_twistedE6InndiagConj]
      exact hφ
    obtain ⟨ĝ, hĝ⟩ := hφrange
    let b : ModGL TwistTag.E6.tag L :=
      baseChangeGL (algebraMap K L) (ĝ : ModGL TwistTag.E6.tag K)
    have hbR : b ∈ twistedFixedGroup TwistTag.E6 L Fr :=
      map_twistedE6InndiagGL_le_twistedFixedGroup Nat.prime_two hf hK σ hσ Fr hFr
        (Subgroup.mem_map_of_mem (baseChangeGL (algebraMap K L)) ĝ.2)
    refine ⟨D.g0⁻¹ * b * D.g0, ?_, fun x => ?_⟩
    · change D.g0⁻¹ * b * D.g0 ∈ D.model
      rw [hmodel]
      refine ⟨b, hbR, ?_⟩
      change (MulAut.conj D.g0⁻¹) b = D.g0⁻¹ * b * D.g0
      rw [MulAut.conj_apply]
      simp
    · have hφx : ((φ x : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) =
          (ĝ : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) *
            (ĝ : ModGL TwistTag.E6.tag K)⁻¹ := by
        rw [← hĝ]
        exact twistedE6InndiagConj_apply ĝ x
      change (e (φ x) : ModGL TwistTag.E6.tag L) =
        (D.g0⁻¹ * b * D.g0) * (e x : ModGL TwistTag.E6.tag L) *
          (D.g0⁻¹ * b * D.g0)⁻¹
      rw [hcoe (φ x), hcoe x, hφx, map_mul, map_mul, map_inv]
      dsimp only [b]
      group
  · intro d hd hcent
    change d ∈ D.model at hd
    rw [hmodel] at hd
    obtain ⟨b, hbR, hbd⟩ := Subgroup.mem_map.mp hd
    have hd_eq : d = D.g0⁻¹ * b * D.g0 := by
      rw [← hbd]
      change (MulAut.conj D.g0⁻¹) b = D.g0⁻¹ * b * D.g0
      rw [MulAut.conj_apply]
      simp
    have hσ' : ∀ c : K, σ.toRingHom c = c ^ 2 ^ f := fun c => by
      rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
      exact hσ c
    have hbC : b ∈ Subgroup.centralizer
        ((twistedE6RootGroup K σ).map (baseChangeGL (algebraMap K L))) := by
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      obtain ⟨c, hc, rfl⟩ := Subgroup.mem_map.mp hy
      have h1 := hcent (e ⟨c, hc⟩)
      rw [hd_eq] at h1
      rw [hcoe ⟨c, hc⟩] at h1
      have h2 : b * (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) * b⁻¹ =
          baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K) := by
        have h1' : (MulAut.conj D.g0⁻¹)
            (b * (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) * b⁻¹) =
            (MulAut.conj D.g0⁻¹)
              (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) := by
          rw [MulAut.conj_apply, MulAut.conj_apply, inv_inv]
          rw [show D.g0⁻¹ * (b * (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) *
                b⁻¹) * D.g0 =
              (D.g0⁻¹ * b * D.g0) * (D.g0⁻¹ * (baseChangeGL (algebraMap K L)
                (c : ModGL TwistTag.E6.tag K)) * D.g0) * (D.g0⁻¹ * b * D.g0)⁻¹ from by
            group]
          exact h1
        exact (MulAut.conj D.g0⁻¹).injective h1'
      have h2s : b * (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) =
          (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) * b := by
        calc b * (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) =
            (b * (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) * b⁻¹) * b := by
              group
          _ = (baseChangeGL (algebraMap K L) (c : ModGL TwistTag.E6.tag K)) * b := by rw [h2]
      exact h2s.symm
    have hbot :=
      (CFSG.LieType.AlgebraicGroups.E6_rational_twisted_fixed_group_faithful_action
        Nat.prime_two hf K hK σ.toRingHom hσ' L Fr hFr).2.2.1
    have hb_bot : b ∈ (⊥ : Subgroup (ModGL TwistTag.E6.tag L)) := by
      rw [← hbot]
      exact Subgroup.mem_inf.2 ⟨hbR, hbC⟩
    have hb1 : b = 1 := Subgroup.mem_bot.mp hb_bot
    rw [hd_eq]
    change (D.g0⁻¹ * b * D.g0 : ModGL TwistTag.E6.tag L) = (1 : ModGL TwistTag.E6.tag L)
    rw [hb1]
    simp

end CFSG.StandardType
