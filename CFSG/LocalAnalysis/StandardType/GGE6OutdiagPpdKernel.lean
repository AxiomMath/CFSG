private theorem cntB_pos_e6 : ∀ m0 m1 m2 m3 m4 m5 : Fin 4,
    (m0.val + 2 * m1.val + 2 * m2.val + 3 * m3.val + 2 * m4.val + m5.val ≤ 3) →
    0 < cntB m0.val m1.val m2.val m3.val m4.val m5.val := by
  decide +kernel

theorem twist_mem_rootCharStabilizerSubgroup
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) (h3q : 3 ∣ S.D.q - 1) {w : WeylGroup Tag.E6}
    (hn : S.D.n = canonicalRep (coxeterSystem Tag.E6) L w) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1) :
    w ∈ rootCharStabilizerSubgroup a := by
  have hTa := (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hT).2
  have hq : 1 ≤ S.D.q := by
    by_contra h0
    have h00 : S.D.q = 0 := by omega
    have h := hFr 0
    rw [map_zero, h00, pow_zero] at h
    exact zero_ne_one h
  obtain ⟨m, hm⟩ := h3q
  have hqm : S.D.q = 3 * m + 1 := by omega
  have hFa : (fun i => Units.map Fr.toMonoidHom (a i)) = a := by
    funext i
    apply Units.ext
    change Fr ((a i : Lˣ) : L) = ((a i : Lˣ) : L)
    rw [hFr, hqm, pow_succ, pow_mul]
    have h3 : ((a i : Lˣ) : L) ^ 3 = 1 := by
      rw [← Units.val_pow_eq_pow_val, hap i, Units.val_one]
    rw [h3, one_pow, one_mul]
  have hΦd : S.D.Φ (rootDiagUnit Tag.E6 a) = rootDiagUnit Tag.E6 a := by
    rw [hΦ, units_map_entrywiseHom_eq_baseChangeGL, baseChangeGL_rootDiagUnit, hFa]
  rw [hΦd, hn] at hTa
  refine (conj_canonicalRep_eq_iff a w).1 ?_
  calc rootDiagUnit Tag.E6 a * canonicalRep (coxeterSystem Tag.E6) L w * (rootDiagUnit Tag.E6 a)⁻¹
      = (canonicalRep (coxeterSystem Tag.E6) L w * rootDiagUnit Tag.E6 a *
          (canonicalRep (coxeterSystem Tag.E6) L w)⁻¹) * canonicalRep (coxeterSystem Tag.E6) L w *
          (rootDiagUnit Tag.E6 a)⁻¹ := by rw [hTa]
    _ = canonicalRep (coxeterSystem Tag.E6) L w := by group

private theorem twist_mem_of_twistInner_d4
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) {w : WeylGroup Tag.E6}
    (hn : S.D.n = canonicalRep (coxeterSystem Tag.E6) L w) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1)
    (h24 : (kernelRoots (rootCharHom a)).ncard = 24) (i : KernelComponent (rootCharHom a))
    (hin : twistInner (componentRoots (rootCharHom a) i) S.ρ) : w ∈ kernelReflectionGroup a := by
  classical
  obtain ⟨v, hv, -, -⟩ := CFSG.LocalAnalysis.GLTheoremA.T158.e6D4T2_class S hT hap h24 i
  obtain ⟨u, hu, hρu⟩ := hin
  have hx : ∀ j ∈ CFSG.RankThree.PartOne.KD4T.d4Set Tag.E6,
      (v⁻¹ * u⁻¹ * w * v) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) = Pi.single j 1 := by
    intro j hj
    have hjΦ : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
        parabolicRoots Tag.E6 (CFSG.RankThree.PartOne.KE.d4Nodes Tag.E6) := by
      refine ⟨IsRoot.basis j, fun k hk => ?_⟩
      have hkj : k ≠ j := fun h => hk (h ▸ hj)
      simp [Pi.single_apply, hkj]
    have hγ : v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ componentRoots (rootCharHom a) i := by
      rw [hv]
      exact ⟨_, hjΦ, rfl⟩
    have hroot : IsRoot Tag.E6 (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := hγ.1.1
    have h1 : w • (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
        u • (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := by
      rw [← S.rho_eq_smul_of_frob hFr hΦ hn hroot]
      exact hρu _ hγ
    calc (v⁻¹ * u⁻¹ * w * v) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)
        = v⁻¹ • u⁻¹ • w • v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) := by simp only [mul_smul]
      _ = Pi.single j 1 := by rw [h1, inv_smul_smul, inv_smul_smul]
  have hx1 := CFSG.LocalAnalysis.GLTheoremA.T158.e6d4t2_centralizer_trivial hx
  have hwu : w = u := by
    have h := congrArg (fun y => u * v * y * v⁻¹) hx1
    simp only [mul_one] at h
    calc w = u * v * (v⁻¹ * u⁻¹ * w * v) * v⁻¹ := by group
      _ = u := by rw [h]; group
  rw [hwu]
  have hle : Subgroup.closure {s : WeylGroup Tag.E6 | ∃ γ ∈ componentRoots (rootCharHom a) i,
      s = rootReflection γ} ≤ kernelReflectionGroup a := by
    rw [CFSG.RankThree.Chevalley.kernelReflectionGroup_eq_closure_rootReflection]
    refine Subgroup.closure_mono ?_
    rintro _ ⟨γ, hγ, rfl⟩
    exact ⟨γ, hγ.1, rfl⟩
  exact hle hu

theorem kernel_cases_of_twist_not_mem
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) (h3q : 3 ∣ S.D.q - 1) {w : WeylGroup Tag.E6}
    (hn : S.D.n = canonicalRep (coxeterSystem Tag.E6) L w) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1)
    (hw : w ∉ kernelReflectionGroup a) :
    ((kernelRoots (rootCharHom a)).ncard = 18 ∧
        ∀ i, componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 3) ∨
      ((kernelRoots (rootCharHom a)).ncard = 24 ∧
        ∀ i, ¬ twistInner (componentRoots (rootCharHom a) i) S.ρ) := by
  classical
  have hwa := twist_mem_rootCharStabilizerSubgroup S hFr hΦ h3q hn hT hap
  have h3L : ((3 : ℕ) : L) ≠ 0 := by
    have h2 : ((2 : ℕ) : L) = 0 := CharP.cast_eq_zero L 2
    have h3 : ((3 : ℕ) : L) = 1 := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, Nat.cast_add, h2, zero_add, Nat.cast_one]
    rw [h3]
    exact one_ne_zero
  obtain ⟨ζ, w₀, m0, m1, m2, m3, m4, m5, hζ, hsum, hchar, hcl⟩ := kac_class_data h3L hap
  have hcnt := ncard_kernelRoots_eq_cntB hζ w₀ hchar
  rcases CFSG.LocalAnalysis.GLTheoremA.KD264Lie.kernelCount_cases_of_kac_E6 m0 m1 m2 m3 m4 m5 hsum with
    hconn | h24 | h18 | h72
  ·
    exfalso
    have hk : (kernelRoots (rootCharHom a)).ncard ∈ ({22, 30, 40} : Set ℕ) := by
      rw [hcnt]
      rcases hconn with h | h | h <;> simp [h]
    exact hw (e6_stab_le_kernelReflectionGroup_of_conn a hap hk hwa)
  ·
    exact Or.inr ⟨hcnt.trans h24, fun i hin =>
      hw (twist_mem_of_twistInner_d4 S hFr hΦ hn hT hap (hcnt.trans h24) i hin)⟩
  ·
    have h18' : (kernelRoots (rootCharHom a)).ncard = 18 := hcnt.trans h18
    obtain ⟨c, hc, -⟩ := kernel_classes_of_ncard_eighteen h3L hap h18'
    rcases orbit_dichotomy S hT hc with ⟨j₀, hj₀⟩ | hall
    · exfalso
      apply hw
      refine CFSG.LocalAnalysis.GLTheoremA.KD264Lie.mem_kernelReflectionGroup_of_mapsTo_a2CubeClass
        h3L hap h18' hwa j₀ fun α hα => ?_
      have hspec := (outer_componentOrbitLength_spec S hT j₀).2.1
      rw [hj₀, Function.iterate_one] at hspec
      have hα' : S.ρ α ∈ componentRoots (rootCharHom a) j₀ := by
        rw [← hspec]
        exact Set.mem_image_of_mem _ hα
      rwa [S.rho_eq_smul_of_frob hFr hΦ hn hα.1.1] at hα'
    · exact Or.inl ⟨h18', fun i => (hall i).1⟩
  ·
    exfalso
    have hpos : 0 < (kernelRoots (rootCharHom a)).ncard := by
      rw [hcnt]
      exact cntB_pos_e6 m0 m1 m2 m3 m4 m5 hsum
    obtain ⟨α, hα⟩ := Set.nonempty_of_ncard_ne_zero hpos.ne'
    set i : KernelComponent (rootCharHom a) := ⟦⟨α, hα⟩⟧
    obtain ⟨x, hx, -, hncard, -, -⟩ := hcl i
    have hfin : {v : Fin Tag.E6.rank → ℤ | IsRoot Tag.E6 v}.Finite := finite_setOf_isRoot Tag.E6
    have hsub : kernelRoots (rootCharHom a) ⊆ {v | IsRoot Tag.E6 v} := fun γ hγ => hγ.1
    have hall : kernelRoots (rootCharHom a) = {v | IsRoot Tag.E6 v} := by
      refine Set.eq_of_subset_of_ncard_le hsub ?_ hfin
      rw [ncard_setOf_isRoot]
      calc Tag.E6.rootCount ≤ (componentRoots (rootCharHom a) i).ncard := by
            rw [hncard, h72 x hx]
            decide
        _ ≤ (kernelRoots (rootCharHom a)).ncard :=
            Set.ncard_le_ncard (fun γ hγ => hγ.1) (hfin.subset hsub)
    apply hw
    have htop : kernelReflectionGroup a = ⊤ := by
      refine eq_top_iff.2 ?_
      rw [← closure_range_simple]
      refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨j, rfl⟩
      refine Subgroup.subset_closure ⟨1, j, ?_, by simp⟩
      rw [one_smul]
      have hj : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ kernelRoots (rootCharHom a) := by
        rw [hall]
        exact IsRoot.basis j
      exact hj
    rw [htop]
    exact Subgroup.mem_top w

