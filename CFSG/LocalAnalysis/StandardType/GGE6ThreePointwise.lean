theorem commute_kernelSpan_of_inner_component_two
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (M : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : M.tau = .E6)
    (j : Fin M.row.D.orbits.length) (hj : ∀ k, k = j) (hqs : M.row.D.orbits[j].qs = true)
    (hfield : M.row.D.orbits[j].lab.n = lab.n) (hn : lab.n = 1)
    (hinner : twistInner (componentRoots (rootCharHom M.a) (M.repr j))
      ((M.setup.ρ : (Fin M.tau.rank → ℤ) → _)^[componentOrbitLength M.setup.ρ
        (componentRoots (rootCharHom M.a) (M.repr j))]))
    {z : ModGL M.tau Omega} (hzF : M.setup.D.step z = z)
    (hcomm : ∀ x ∈ component M j, Commute z (M.iota x)) :
    ∀ y ∈ kernelSpan M, Commute z y := by
  have hs1 : componentOrbitLength M.setup.ρ (componentRoots (rootCharHom M.a) (M.repr j)) = 1 := by
    rw [M.orbit_length]
    have h := M.field_exp j
    rw [hfield, hn] at h
    simpa using h.symm
  have hq : M.setup.D.q = 2 := by rw [M.q_eq, hn]; norm_num
  have hTp : rootDiagUnit M.tau M.a ^ 3 = 1 := by
    rw [rootDiagUnit_pow]
    have ha : M.a ^ 3 = 1 := funext M.a_pow
    rw [ha, rootDiagUnit_one]
  have hG2 : M.tau ≠ .G2 := by rw [hE6]; decide
  have hQ : CFSG.IsQuasisimple
      (rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j)) := M.qs j hqs
  have hRank := two_lt_ncard_of_inner_quasisimple_two M.setup Nat.prime_three hG2
    M.a_torus hTp M.a_ne (M.repr j) hinner hs1 hq hQ
  have hRat : ∀ x ∈ rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j), Commute z x := by
    intro x hx
    have hxGamma : x ∈ M.setup.Γ := (le_trans (Subgroup.commutator_le_self _) inf_le_right) hx
    rw [← M.iota_range] at hxGamma
    obtain ⟨y, hyx⟩ := MonoidHom.mem_range.mp hxGamma
    have hy : y ∈ component M j := by
      change M.iota y ∈ rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j)
      rwa [hyx]
    rw [← hyx]
    exact hcomm y hy
  have hGeom := commute_rootSpan_of_commute_component_two_of_tableCheck M.setup (Or.inl hE6)
    (by rw [hE6]; exact CFSG.LieType.Chevalley.RootOps.tableCheck_E6) M.a_torus
    (M.repr j) hinner hs1 hq hRank z hRat
  have hle : rootSpan M.tau Omega (componentRoots (rootCharHom M.a) (M.repr j)) ≤
      Subgroup.centralizer ({z} : Set (ModGL M.tau Omega)) := fun x hx =>
    Subgroup.mem_centralizer_singleton_iff.mpr (hGeom x hx).symm.eq
  have hOrbit := CFSG.StandardType.F4ExplicitPos.OrbitKernel.rootSpan_rationalRoots_le_centralizer_of_fixed
    M.setup (M.repr j) hzF hle
  have hKernel : kernelSpan M ≤ Subgroup.centralizer ({z} : Set (ModGL M.tau Omega)) := by
    rw [kernelSpan, ← iSup_componentRootSpan]
    refine iSup_le fun c => ?_
    obtain ⟨k, hk⟩ := M.orbit_cover c
    rw [hj k] at hk
    have hIncl : componentRoots (rootCharHom M.a) c ⊆ rationalRoots M.setup.ρ (rootCharHom M.a) c :=
      fun beta hbeta => ⟨0, beta, hbeta, rfl⟩
    exact (rootSpan_mono hIncl).trans (hk ▸ hOrbit)
  intro y hy
  exact (Subgroup.mem_centralizer_singleton_iff.mp (hKernel hy)).symm

theorem b2SatQ2On_r4Opp_of_inner
    (Omega : Type) [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    (hinner : ∀ (lab : LargeEvenLabel) (R : Type) [Group R] (I : Set (MulAut R))
      (phi : MulAut R) (M : MarkedRationalKacRealization Omega lab 3 R I phi)
      (j : Fin M.row.D.orbits.length),
      LargeEvenInLambda2 lab → (∀ k, k = j) → M.row.D.orbits[j].qs = true →
      GGE6ThreeR4OppLabels1585 lab M.row.D.orbits[j].lab → lab.n = 1 →
      twistInner (componentRoots (rootCharHom M.a) (M.repr j))
        ((M.setup.ρ : (Fin M.tau.rank → ℤ) → _)^[componentOrbitLength M.setup.ρ
          (componentRoots (rootCharHom M.a) (M.repr j))])) :
    B2SatQ2On Omega GGE6ThreeR4OppLabels1585 := by
  intro lab R _ I phi M j hL hj hqs hrow hn z hz hzM hcomm
  have htau : M.tau = .E6 := by
    have htag : lab.tag = .E6 := by
      rcases hrow with ⟨h, _, _⟩ | ⟨_, h, _⟩
      · exact h
      · rw [hn] at h
        norm_num at h
    have hreq := M.row.type_eq
    simp only [ggKacTypeOfLabel, htag, Option.some.injEq, Prod.mk.injEq] at hreq
    rw [← M.tau_eq, ← hreq.1]
    rfl
  have hfield : M.row.D.orbits[j].lab.n = lab.n := by
    rcases hrow with ⟨_, _, h⟩ | ⟨_, _, h⟩ <;> rw [h]
  exact commute_kernelSpan_of_inner_component_two M htau j hj hqs hfield hn
    (hinner lab R I phi M j hL hj hqs hrow hn) hzM.2 hcomm

