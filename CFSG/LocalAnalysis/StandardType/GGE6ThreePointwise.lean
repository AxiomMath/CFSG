theorem mem_connectedCentre_of_commute_kernelSpan
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (M : MarkedRationalKacRealization Omega lab 3 R I phi)
    {z : ModGL M.tau Omega} (hz : z ∈ connectedCentralizer M)
    (hcomm : ∀ y ∈ kernelSpan M, Commute z y) : z ∈ connectedCentre M := by
  have hle : connectedCentralizer M ≤ toralRootGroup M.tau Omega M.a := by
    unfold connectedCentralizer toralRootGroup
    apply sup_le
    · apply le_trans ?_ le_sup_left
      rw [Subgroup.closure_le]
      rintro _ ⟨b, rfl⟩
      exact rootDiagUnit_mem_torusGroup b
    · exact le_sup_right
  have hsq : M.zeta ^ 2 ≠ 1 := by
    intro h
    have hd : orderOf M.zeta ∣ 2 := orderOf_dvd_of_pow_eq_one h
    rw [M.zeta_order] at hd
    norm_num at hd
  have hzT := mem_torusGroup_of_mem_toralRootGroup_of_commute M.a M.zeta hsq (hle hz) hcomm
  obtain ⟨b, hb⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup hzT
  have hCent : connectedCentralizer M ≤ Subgroup.centralizer ({z} : Set (ModGL M.tau Omega)) := by
    unfold connectedCentralizer
    apply sup_le
    · rw [Subgroup.closure_le]
      rintro _ ⟨b', rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff, hb,
        ← rootDiagUnit_mul, ← rootDiagUnit_mul, mul_comm b' b]
    · intro x hx
      exact Subgroup.mem_centralizer_singleton_iff.mpr (hcomm x hx).symm.eq
  unfold connectedCentre
  refine Subgroup.mem_map.mpr ⟨⟨z, hz⟩, ?_, rfl⟩
  rw [Subgroup.mem_center_iff]
  intro y
  apply Subtype.ext
  exact Subgroup.mem_centralizer_singleton_iff.mp (hCent y.property)

theorem mem_connectedCentre_of_geom_commute_kernelSpan
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (M : MarkedRationalKacRealization Omega lab 3 R I phi)
    (htau : M.tau = Tag.E6)
    {z : ModGL M.tau Omega} (hz : z ∈ geomCentralizer M)
    (hcomm : ∀ y ∈ kernelSpan M, Commute z y) : z ∈ connectedCentre M := by
  have hsq : M.zeta ^ 2 ≠ 1 := by
    intro h
    have hd : orderOf M.zeta ∣ 2 := orderOf_dvd_of_pow_eq_one h
    rw [M.zeta_order] at hd
    norm_num at hd
  have htor : ∀ (tau : Tag), tau = Tag.E6 →
      ∀ (a : Fin tau.rank → Omegaˣ), (∀ i, a i ^ 3 = 1) →
      ∀ (zeta : Omegaˣ), zeta ^ 2 ≠ 1 → ∀ z ∈ toralCentralizer tau Omega a,
        (∀ y ∈ rootSpan tau Omega (kernelRoots (rootCharHom a)), Commute z y) →
          z ∈ torusGroup tau Omega := by
    intro tau htau'
    subst htau'
    exact fun a ha zeta hzeta z hz hcomm =>
      mem_torusGroup_of_mem_toralCentralizer_of_cubic_commute
        a ha zeta hzeta hz hcomm
  have hzT : z ∈ torusGroup M.tau Omega := htor M.tau htau M.a M.a_pow M.zeta hsq z hz hcomm
  have hzC : z ∈ connectedCentralizer M := by
    obtain ⟨b, hb⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup hzT
    rw [hb, connectedCentralizer]
    exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨b, rfl⟩)
  exact mem_connectedCentre_of_commute_kernelSpan M hzC hcomm

theorem commute_kernelSpan_of_fix_component_of_four_le
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (M : MarkedRationalKacRealization Omega lab 3 R I phi)
    (j : Fin M.row.D.orbits.length) (hj : ∀ k, k = j) (h4 : 4 ≤ 2 ^ lab.n)
    {z : ModGL M.tau Omega}
    (hcomm : ∀ x ∈ component M j, Commute z (M.iota x)) :
    ∀ y ∈ kernelSpan M, Commute z y := by
  have hτ : M.tau ≠ .G2 := by
    rw [← M.tau_eq]
    cases M.row.T <;> (intro h; cases h)
  have hq4 : 4 ≤ M.setup.D.q := by rw [M.q_eq]; exact h4
  have hq3 : 3 ≤ M.setup.D.q := by omega
  have hcomm_all : ∀ i : KernelComponent (rootCharHom M.a),
      ∀ x ∈ rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) i, Commute z x := by
    intro i x hx
    obtain ⟨j', hj'⟩ := M.orbit_cover i
    rw [hj j'] at hj'
    have hcomp : rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) i =
        rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j) := by
      unfold rationalComponent rationalSpan
      rw [hj']
    rw [hcomp] at hx
    have hxΓ : x ∈ M.setup.Γ :=
      (le_trans (Subgroup.commutator_le_self _) inf_le_right) hx
    rw [← M.iota_range] at hxΓ
    obtain ⟨y, hyx⟩ := MonoidHom.mem_range.mp hxΓ
    have hy : y ∈ component M j := by
      change M.iota y ∈ rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j)
      rw [hyx]
      exact hx
    rw [← hyx]
    exact hcomm y hy
  have hle : rootSpan M.tau Omega (kernelRoots (rootCharHom M.a)) ≤
      Subgroup.centralizer ({z} : Set (ModGL M.tau Omega)) := by
    rw [← iSup_componentRootSpan (τ := M.tau) (K := Omega) (χ := rootCharHom M.a)]
    refine iSup_le fun i => ?_
    intro g hg
    have hm : 0 < componentOrbitLength M.setup.ρ
        (componentRoots (rootCharHom M.a) i) :=
      (CFSG.HardMathSupport.Timmesfeld.LangTorus.outer_componentOrbitLength_spec
        (S := M.setup) (hT := M.a_torus) (i := i)).1
    have hQ4 : 4 ≤ M.setup.D.q ^ componentOrbitLength M.setup.ρ
        (componentRoots (rootCharHom M.a) i) := by
      calc 4 ≤ M.setup.D.q := hq4
        _ = M.setup.D.q ^ 1 := (pow_one _).symm
        _ ≤ _ := pow_le_pow_right₀ (by omega : 1 ≤ M.setup.D.q) hm
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (CFSG.HardMathSupport.Timmesfeld.LangTorus.commute_rootSpan_of_commute_component_anyT
      (S := M.setup) hτ (a := M.a) M.a_torus i hq3 hQ4 z (hcomm_all i) g hg).symm
  intro y hy
  exact (Subgroup.mem_centralizer_singleton_iff.mp (hle hy)).symm

theorem b2SatQ2On_r3_holds (Omega : Type) [Field Omega] [IsAlgClosed Omega] [CharP Omega 2] :
    CFSG.StandardType.S2MathAs1E6Companion1625.B2SatQ2On Omega
      CFSG.StandardType.GGE6ThreeR3Labels1585 := by
  intro lab R _ I phi M j hL hj hqs hrow hn z hz hzM hcomm
  have hQexp : M.row.D.orbits[j].lab.n = 3 * lab.n := by
    rcases hrow with ⟨_, _, h⟩ | ⟨_, _, h⟩ <;> rw [h]
  have hLen : (M.orbitNodes j).length = 3 := by
    have h := M.field_exp j
    rw [hQexp, hn] at h
    simpa using h.symm
  have hQ4 : 4 ≤ M.setup.D.q ^ componentOrbitLength M.setup.ρ
      (componentRoots (rootCharHom M.a) (M.repr j)) := by
    rw [M.orbit_length, hLen, M.q_eq, hn]
    norm_num
  have hG2 : M.tau ≠ Tag.G2 := by
    rw [← M.tau_eq]
    cases M.row.T <;> decide
  have hNormal : ∀ c : KernelComponent (rootCharHom M.a),
      z ∈ Subgroup.normalizer (rootSpan M.tau Omega (componentRoots (rootCharHom M.a) c) : Set _) := by
    intro c
    apply mem_normalizer_rootSpan_of_mem_Z (a := M.a) _ c
    have hle : CFSG.StandardType.E6Centralizer1585.connectedCentralizer M ≤
        torusGroup M.tau Omega ⊔ rootSpan M.tau Omega (kernelRoots (rootCharHom M.a)) := by
      unfold CFSG.StandardType.E6Centralizer1585.connectedCentralizer
      apply sup_le
      · rw [Subgroup.closure_le]
        rintro _ ⟨b, rfl⟩
        exact Subgroup.mem_sup_left (rootDiagUnit_mem_torusGroup b)
      · exact le_sup_right
    exact hle hz
  have hzF : M.setup.D.step z = z := hzM.2
  have hRat : ∀ x ∈ rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j), Commute z x := by
    intro x hx
    have hxGamma : x ∈ M.setup.Γ :=
      (le_trans (Subgroup.commutator_le_self _) inf_le_right) hx
    rw [← M.iota_range] at hxGamma
    obtain ⟨y, hyx⟩ := MonoidHom.mem_range.mp hxGamma
    have hy : y ∈ CFSG.StandardType.E6Centralizer1585.component M j := by
      change M.iota y ∈ rationalComponent M.setup.ρ M.setup.Γ (rootCharHom M.a) (M.repr j)
      rwa [hyx]
    rw [← hyx]
    exact hcomm y hy
  have hGeom := commute_rootSpan_of_commute_component_fixed M.setup hG2 M.a_torus
    (M.repr j) hQ4 z hzF hNormal hRat
  have hle : rootSpan M.tau Omega (componentRoots (rootCharHom M.a) (M.repr j)) ≤
      Subgroup.centralizer ({z} : Set (ModGL M.tau Omega)) := fun x hx =>
    Subgroup.mem_centralizer_singleton_iff.mpr (hGeom x hx).symm.eq
  have hOrbit := CFSG.StandardType.F4ExplicitPos.OrbitKernel.rootSpan_rationalRoots_le_centralizer_of_fixed
    M.setup (M.repr j) hzF hle
  have hKernel : CFSG.StandardType.S2MathAs1E6Companion1625.kernelSpan M ≤
      Subgroup.centralizer ({z} : Set (ModGL M.tau Omega)) := by
    rw [CFSG.StandardType.S2MathAs1E6Companion1625.kernelSpan, ← iSup_componentRootSpan]
    refine iSup_le fun c => ?_
    obtain ⟨k, hk⟩ := M.orbit_cover c
    rw [hj k] at hk
    have hIncl : componentRoots (rootCharHom M.a) c ⊆
        rationalRoots M.setup.ρ (rootCharHom M.a) c := by
      intro beta hbeta
      exact ⟨0, beta, hbeta, rfl⟩
    exact (rootSpan_mono hIncl).trans (hk ▸ hOrbit)
  intro y hy
  exact (Subgroup.mem_centralizer_singleton_iff.mp (hKernel hy)).symm

