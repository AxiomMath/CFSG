theorem mem_fullCentre_of_fix_component
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {row : LargeEvenLabel → LargeEvenLabel → Prop}
    (hQ2 : B2SatQ2On Omega row)
    (hOuterQ2 : B3On Omega (fun lab labJ => row lab labJ ∧ lab.n = 1))
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (M : MarkedRationalKacRealization Omega lab 3 R I phi)
    (j : Fin M.row.D.orbits.length)
    (hL : LargeEvenInLambda2 lab) (hj : ∀ k, k = j) (hqs : M.row.D.orbits[j].qs = true)
    (hrow : row lab M.row.D.orbits[j].lab) (htau : M.tau = Tag.E6)
    {u : MulAut R} (hu : u ∈ centralizerGroup M)
    (hfix : ∀ x ∈ component M j, u x = x) : u ∈ fullCentre M := by
  have hinner : innerOn (component M j) u := by
    refine ⟨1, (component M j).one_mem, ?_⟩
    intro x hx
    simpa only [one_mul, inv_one, mul_one] using hfix x hx
  by_cases hn : lab.n = 1
  · have huConn : u ∈ conn M := by
      by_contra hnot
      exact hOuterQ2 lab R I phi M j hL hj hqs ⟨hrow, hn⟩ u hu hnot hinner
    obtain ⟨z, hz, hzu⟩ := Subgroup.mem_map.mp huConn
    have hz' := Subgroup.mem_subgroupOf.mp hz
    have hcomm : ∀ x ∈ component M j, Commute (z : ModGL M.tau Omega) (M.iota x) := by
      intro x hx
      have h := M.modelAction_compat z x
      rw [hzu, hfix x hx] at h
      exact mul_inv_eq_iff_eq_mul.mp h.symm
    have hc := mem_connectedCentre_of_commute_kernelSpan M hz'.1
      (hQ2 lab R I phi M j hL hj hqs hrow hn z hz'.1 hz'.2 hcomm)
    exact Subgroup.mem_map.mpr ⟨z, Subgroup.mem_subgroupOf.mpr ⟨hc, z.2⟩, hzu⟩
  · have hn2 : 2 ≤ lab.n := by have := hL.1; omega
    have h4 : 4 ≤ 2 ^ lab.n := by
      have h := Nat.pow_le_pow_right (by norm_num : 1 ≤ (2 : ℕ)) hn2
      norm_num at h
      exact h
    have hC := ((b1aOn_holds Omega) lab R I phi M j hL hj hqs).1
    rw [hC] at hu
    obtain ⟨z, hz, hzu⟩ := Subgroup.mem_map.mp hu
    have hz' := Subgroup.mem_subgroupOf.mp hz
    have hcomm : ∀ x ∈ component M j, Commute (z : ModGL M.tau Omega) (M.iota x) := by
      intro x hx
      have h := M.modelAction_compat z x
      rw [hzu, hfix x hx] at h
      exact mul_inv_eq_iff_eq_mul.mp h.symm
    have hc := mem_connectedCentre_of_geom_commute_kernelSpan M htau hz'.1
      (commute_kernelSpan_of_fix_component_of_four_le M j hj h4 hcomm)
    exact Subgroup.mem_map.mpr ⟨z, Subgroup.mem_subgroupOf.mpr ⟨hc, z.2⟩, hzu⟩

theorem isCyclic_of_marked_row_of_cuts
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {row : LargeEvenLabel → LargeEvenLabel → Prop}
    (hQ2 : B2SatQ2On Omega row)
    (hOuterQ2 : B3On Omega (fun lab labJ => row lab labJ ∧ lab.n = 1))
    (hCyc : GGE6ThreeFullCentreCyclicOn1585 Omega row)
    (lab : LargeEvenLabel) (R : Type) [Group R] (I : Set (MulAut R)) (phi : MulAut R)
    (M : MarkedRationalKacRealization Omega lab 3 R I phi)
    (j : Fin M.row.D.orbits.length)
    (hL : LargeEvenInLambda2 lab) (hj : ∀ k, k = j) (hqs : M.row.D.orbits[j].qs = true)
    (hrow : row lab M.row.D.orbits[j].lab) (htau : M.tau = Tag.E6)
    (E : Subgroup (MulAut R)) (hE : E ≤ centralizerGroup M)
    (hfix : ∀ u ∈ E, ∀ x ∈ component M j, u x = x) : IsCyclic E := by
  have hLE : E ≤ fullCentre M := fun u hu =>
    mem_fullCentre_of_fix_component hQ2 hOuterQ2 M j hL hj hqs hrow htau
      (hE hu) (hfix u hu)
  let : IsCyclic (fullCentre M) := hCyc lab R I phi M j hL hj hqs hrow
  exact Subgroup.isCyclic_of_le hLE

theorem isCyclic_of_marked_cover_row_of_cuts
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {row : LargeEvenLabel → LargeEvenLabel → Prop}
    (hQ2 : B2SatQ2On Omega row)
    (hOuterQ2 : B3On Omega (fun lab labJ => row lab labJ ∧ lab.n = 1))
    (hCyc : GGE6ThreeFullCentreCyclicOn1585 Omega row)
    {L R : Type} [Group L] [Group R] (hperf : commutator L = ⊤)
    (theta : L ⧸ Subgroup.center L ≃* R)
    (lab : LargeEvenLabel) (I : Set (MulAut R)) (y : MulAut L)
    (M : MarkedRationalKacRealization Omega lab 3 R I (ggInducedAut theta y))
    (j : Fin M.row.D.orbits.length) (hlab : LargeEvenInLambda2 lab)
    (hj : ∀ k, k = j) (hqs : M.row.D.orbits[j].qs = true)
    (hrow : row lab M.row.D.orbits[j].lab) (htau : M.tau = Tag.E6)
    (E : Subgroup (MulAut L)) (hInd : GGInducedInn E theta I)
    (hcomm : ∀ u ∈ E, Commute u y)
    (J : Subgroup L)
    (hJmap : J.map (theta.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center L))) =
      component M j)
    (hfix : ∀ u ∈ E, ∀ x ∈ J, u x = x) : IsCyclic E := by
  let f := ggInducedAut theta
  have hE : E.map f ≤ centralizerGroup M := by
    rintro u ⟨a, ha, rfl⟩
    refine ⟨?_, ?_⟩
    · change f a ∈ M.modelAction.range
      rw [MonoidHom.mem_range]
      have hI : f a ∈ I := hInd a ha
      rw [← M.modelAction_range] at hI
      exact hI
    · change f a ∈ Subgroup.centralizer {(ggInducedAut theta) y}
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact ((hcomm a ha).map f).eq
  have hfixR : ∀ u ∈ E.map f, ∀ x ∈ component M j, u x = x := by
    rintro u ⟨a, ha, rfl⟩ x hx
    rw [← hJmap] at hx
    obtain ⟨l, hl, rfl⟩ := Subgroup.mem_map.mp hx
    change ggInducedAut theta a (theta (l : L ⧸ Subgroup.center L)) =
      theta (l : L ⧸ Subgroup.center L)
    rw [ggInducedAut_apply, hfix a ha l hl]
  let : IsCyclic (E.map f) :=
    isCyclic_of_marked_row_of_cuts hQ2 hOuterQ2 hCyc lab R I (f y) M j
      hlab hj hqs hrow htau (E.map f) hE hfixR
  let eqv : E ≃* E.map f :=
    Subgroup.equivMapOfInjective E f (ggInducedAut_injective_of_perfect hperf theta)
  exact isCyclic_of_injective eqv.toMonoidHom eqv.injective

