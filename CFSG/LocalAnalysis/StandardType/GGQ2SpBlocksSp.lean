private theorem commutatorEquivOfMulEquiv {G : Type} [Group G] {H : Type} [Group H]
    {B : Subgroup G} {S : Subgroup H} (e : ↥B ≃* ↥S) :
    Nonempty (↥⁅B, B⁆ ≃* ↥⁅S, S⁆) := by
  let c₁ : ↥⁅B, B⁆ ≃* ↥(commutator ↥B) :=
    (((commutator ↥B).equivMapOfInjective B.subtype B.subtype_injective).trans
      (MulEquiv.subgroupCongr B.map_subtype_commutator)).symm
  let c₂ : ↥(commutator ↥B) ≃* ↥(commutator ↥S) :=
    ((commutator ↥B).equivMapOfInjective e.toMonoidHom e.injective).trans
      (MulEquiv.subgroupCongr (by
        rw [commutator_def, commutator_def, Subgroup.map_commutator,
          ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.2 e.surjective]))
  let c₃ : ↥(commutator ↥S) ≃* ↥⁅S, S⁆ :=
    ((commutator ↥S).equivMapOfInjective S.subtype
      (Subgroup.subtype_injective _)).trans
      (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator S))
  exact ⟨c₁.trans (c₂.trans c₃)⟩

theorem largeEvenMarking_commutator_of_mulEquiv_statedSp_two (hK : Nat.card K = 2)
    {B : Subgroup G} (e : ↥B ≃* ↥(StatedSp 2 K)) :
    CFSG.StandardType.LargeEvenMarking ↥⁅B, B⁆
      (fun lab _ _ _ _ _ => lab = (⟨.B2der, 0, 1⟩ : LargeEvenLabel)) := by
  let H := ⁅LargeEvenSpGroup K 2, LargeEvenSpGroup K 2⁆
  obtain ⟨φ⟩ := commutatorEquivOfMulEquiv e
  have hφH : ↥⁅B, B⁆ ≃* ↥H := φ
  have hSp4B : CFSG.IsQuasisimple ↥(commutator ↥B) :=
    (CFSG.RankThree.PartOne.derived_of_mulEquiv_sympFour
      (e.trans (CFSG.SeitzReduction.F4Pilot.sp4EquivSympFour hK))).1
  let c₁ : ↥⁅B, B⁆ ≃* ↥(commutator ↥B) :=
    (((commutator ↥B).equivMapOfInjective B.subtype B.subtype_injective).trans
      (MulEquiv.subgroupCongr B.map_subtype_commutator)).symm
  have hIsQB : CFSG.IsQuasisimple ↥⁅B, B⁆ :=
    CFSG.IsQuasisimple.of_mulEquiv c₁ hSp4B
  have hcommB : commutator ↥⁅B, B⁆ = ⊤ := hIsQB.1.commutator_eq_top
  obtain ⟨eR⟩ := nonempty_b2der_equiv_alternatingGroup hK
  obtain ⟨eH⟩ := nonempty_largeEvenProj_equiv_of_card_two hK H
  have hSimpleA6 : IsSimpleGroup (alternatingGroup (Fin 6)) :=
    CFSG.HardMathSupport.Dickson.I271.alt6_isSimpleGroup
  have hSimpleR : IsSimpleGroup (LargeEvenProj H) := eR.isSimpleGroup
  have hSimpleH : IsSimpleGroup ↥H := MulEquiv.isSimpleGroup eH.symm
  have hSimpleB : IsSimpleGroup ↥⁅B, B⁆ := hφH.isSimpleGroup
  have hnabA6 : ∃ a b : ↥(alternatingGroup (Fin 6)), a * b ≠ b * a :=
    CFSG.HardMathSupport.Dickson.I271.alt6_nonabelian
  have hnabR : ∃ a b : LargeEvenProj H, a * b ≠ b * a :=
    nonabelian_of_mulEquiv eR.symm hnabA6
  have hnabH : ∃ a b : ↥H, a * b ≠ b * a :=
    nonabelian_of_mulEquiv eH hnabR
  have hnabB : ∃ a b : ↥⁅B, B⁆, a * b ≠ b * a :=
    nonabelian_of_mulEquiv hφH.symm hnabH
  have hscalarsH : (LargeEvenScalars (Fin 2 ⊕ Fin 2) K).subgroupOf H = ⊥ := by
    rw [largeEvenScalars_eq_bot hK, Subgroup.bot_subgroupOf]
  have hcenterB : Subgroup.center ↥⁅B, B⁆ = ⊥ :=
    center_eq_bot_of_isSimpleGroup_of_nonabelian hnabB
  let θ : ↥⁅B, B⁆ ⧸ Subgroup.center ↥⁅B, B⁆ ≃* LargeEvenProj H :=
    QuotientGroup.congr (Subgroup.center ↥⁅B, B⁆)
      ((LargeEvenScalars (Fin 2 ⊕ Fin 2) K).subgroupOf H) hφH
      (by rw [hcenterB, hscalarsH, Subgroup.map_bot])
  refine ⟨hcommB, ⟨⟨.B2der, 0, 1⟩, ⟨le_rfl, rfl, rfl⟩, ?_⟩⟩
  refine ⟨K, inferInstance, inferInstance, by rw [hK], ?_⟩
  exact ⟨hSimpleR, hnabR, ⟨θ, rfl⟩⟩

theorem largeEvenMarking_commutator_of_mulEquiv_statedSp (hK : Nat.card K = 2)
    {B : Subgroup G} {k : ℕ} (hk : 3 ≤ k) (e : ↥B ≃* ↥(StatedSp k K)) :
    CFSG.StandardType.LargeEvenMarking ↥⁅B, B⁆
      (fun lab _ _ _ _ _ => lab = (⟨.C, k, 1⟩ : LargeEvenLabel)) := by
  let S : Subgroup (GL (Fin k ⊕ Fin k) K) := StatedSp k K
  have hS : CFSG.IsQuasisimple ↥S := by
    have h := CFSG.LieType.Universal.Symplectic.isQuasisimple (n := k) (F := K)
      (by omega) (Or.inr (Or.inr ⟨hK, hk⟩))
    exact h
  obtain ⟨φ₀⟩ := commutatorEquivOfMulEquiv e
  have hCommS : ⁅S, S⁆ = S := by
    rw [← Subgroup.map_subtype_commutator S, hS.1.commutator_eq_top, Subgroup.map_top,
      Subgroup.range_subtype]
  let φ : ↥⁅B, B⁆ ≃* ↥S := φ₀.trans (MulEquiv.subgroupCongr hCommS)
  have hCommB : commutator ↥⁅B, B⁆ = ⊤ := by
    have hPerf : Group.IsPerfect ↥S := hS.1
    have hPerfB : Group.IsPerfect ↥⁅B, B⁆ :=
      @Group.IsPerfect.ofSurjective ↥S ↥⁅B, B⁆ _ _ φ.symm.toMonoidHom hPerf φ.symm.surjective
    exact hPerfB.commutator_eq_top
  have hnabS : ∃ a b : ↥S ⧸ Subgroup.center ↥S, a * b ≠ b * a := hS.2.2
  have hnabR : ∃ a b : LargeEvenProj (LargeEvenSpGroup K k), a * b ≠ b * a :=
    nonabelian_of_mulEquiv (CFSG.LieType.Universal.Symplectic.centerQuotientEquiv k K) hnabS
  have hSimpleR : IsSimpleGroup (LargeEvenProj (LargeEvenSpGroup K k)) := by
    have : IsSimpleGroup (↥(StatedSp k K) ⧸ Subgroup.center ↥(StatedSp k K)) := hS.2.1
    exact (CFSG.LieType.Universal.Symplectic.centerQuotientEquiv k K).symm.isSimpleGroup
  let θ : ↥⁅B, B⁆ ⧸ Subgroup.center ↥⁅B, B⁆ ≃* LargeEvenProj (LargeEvenSpGroup K k) :=
    (QuotientGroup.congr _ _ φ (Subgroup.map_center_eq φ)).trans
      (CFSG.LieType.Universal.Symplectic.centerQuotientEquiv k K)
  refine ⟨hCommB, ⟨⟨.C, k, 1⟩, ?_, ?_⟩⟩
  · simp only [LargeEvenInLambda2]
    omega
  · refine ⟨K, inferInstance, inferInstance, by rw [hK]; norm_num, ?_⟩
    exact ⟨hSimpleR, hnabR, θ, rfl⟩

theorem not_isComponentOf_commutator_of_mulEquiv_statedSp (hK : Nat.card K = 2)
    {B : Subgroup G} {k : ℕ} (hk : k ≤ 1) (e : ↥B ≃* ↥(StatedSp k K)) (X : Subgroup G) :
    ¬ CFSG.Assembly.IsComponentOf X ⁅B, B⁆ := by
  have hB : Group.IsSolvable ↥B := by
    rcases Nat.eq_zero_or_pos k with hk0 | hk1
    · subst hk0
      have : Subsingleton ↥B :=
        ⟨fun x y => e.injective (Subsingleton.elim (e x) (e y))⟩
      infer_instance
    · have hk1' : k = 1 := by omega
      subst hk1'
      have hcard : Nat.card (StatedSp 1 K) = 6 := by
        have e' : ↥(StatedSp 1 K) ≃* ↥(CFSG.Open.StatedSL 2 K) :=
          (CFSG.ClassicalInvolution.Models.SymplecticPairs.longBlockEquivOne K).symm.trans
            (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 K)
        rw [Nat.card_congr e'.toEquiv, CFSG.Open.StatedAPI.card_statedSL_two, hK]
        norm_num
      have hsol : Group.IsSolvable ↥(StatedSp 1 K) :=
        CFSG.GroupTheory.groups_order_below_sixty_solvable (by rw [hcard]; norm_num)
      exact Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective
  have hcomm : Group.IsSolvable ↥⁅B, B⁆ :=
    Group.isSolvable_of_isSolvable_injective
      (f := Subgroup.inclusion (Subgroup.commutator_le_self B))
      (Subgroup.inclusion_injective (Subgroup.commutator_le_self B))
  exact CFSG.StandardType.ResU3Three.not_isComponentOf_of_isSolvable hcomm

