private theorem ltqSl_list
    {labX : LargeEvenLabel} {p n : ℕ} {S : LargeEvenLabel → Prop} {X : Type} [Group X]
    [Finite X] {A Ab : Subgroup (MulAut X)} {σ : MulAut X} {J : Subgroup X}
    (hx : GGExcTwoLabel labX) (h : GGCompList labX p S) (hΛX : LargeEvenInLambda2 labX)
    (hSΛ : ∀ l, S l → LargeEvenInLambda2 l)
    (hd : GGTPNDatumB p n (fun _ _ => True) A Ab σ J)
    (hhX : GGHasLabel labX (X ⧸ Subgroup.center X))
    {labJ : LargeEvenLabel} (hΛJ : LargeEvenInLambda2 labJ)
    (hhJ : GGHasLabel labJ (↥J ⧸ Subgroup.center ↥J)) :
    ∃ l, S l ∧ GGLabelIso labJ l := by
  obtain ⟨l, hSl, hlabel⟩ :=
    GGCompList.of_basicB h hΛX (ltqSl_rig hx) hd.1 hhX
  exact ⟨l, hSl, ggLabelRigidInput_holds labJ l (↥J ⧸ Subgroup.center ↥J) hΛJ (hSΛ l hSl) hhJ
    hlabel⟩

private theorem ltqSl_isElemAbelian_map {G H : Type*} [Group G] [Group H] {p : ℕ}
    {E : Subgroup G} (f : G →* H) (hE : IsElemAbelian p E) :
    IsElemAbelian p (E.map f) := by
  obtain ⟨hc, hp⟩ := hE
  refine ⟨⟨⟨fun u v => ?_⟩⟩, fun z hz => ?_⟩
  · obtain ⟨x, hx, hxu⟩ := u.2
    obtain ⟨y, hy, hyv⟩ := v.2
    apply Subtype.ext
    change (u : H) * v = v * u
    rw [← hxu, ← hyv, ← map_mul, ← map_mul, Subgroup.mul_comm_of_mem_isMulCommutative E hx hy]
  · obtain ⟨x, hx, rfl⟩ := hz
    rw [← map_pow, hp x hx, map_one]

private theorem ltqSl_small
    {labX : LargeEvenLabel} {p n : ℕ} {X : Type} [Group X] [Finite X]
    {A Ab : Subgroup (MulAut X)} {σ : MulAut X} {J : Subgroup X}
    (hp3 : p = 3) (hx : GGExcTwoLabel labX) (hΛX : LargeEvenInLambda2 labX)
    (htag : labX.tag = .triD4 ∨ labX.tag = .G2der ∨ labX.tag = .twF4der)
    (hd : GGTPNDatumB p n (fun _ _ => True) A Ab σ J)
    (hhX : GGHasLabel labX (X ⧸ Subgroup.center X)) : False := by
  obtain ⟨hlocCore, hflat, hcardAb, -, -, -, -, hm⟩ := hd.1
  obtain ⟨hAbA, -, -, -⟩ := hflat
  have hAab : IsElemAbelian p A := hlocCore.1
  unfold GGTPNMarked at hm
  obtain ⟨hperf, lab, hΛlab, hraw⟩ := hm
  have hlabHas : GGHasLabel lab (X ⧸ Subgroup.center X) := by
    unfold GGHasLabel
    refine largeEvenRawDatum_mono ?_ hraw
    rintro R _ I F ⟨-, -, θ, -⟩
    exact ⟨θ⟩
  have hlab_eq : lab = labX :=
    ltqSl_rig' hx lab hΛlab
      (ggLabelRigidInput_holds lab labX (X ⧸ Subgroup.center X) hΛlab hΛX hlabHas hhX)
  subst lab
  have hp : p.Prime := by rw [hp3]; norm_num
  have hnx : labX.n = 1 := hx.1
  have hAll : LargeEvenLabelAll labX (fun R _ I _ => ∀ X : Subgroup (MulAut R),
      (X : Set (MulAut R)) ⊆ I → IsElemAbelian p X → Nat.card X < p ^ 3) := by
    rcases htag with h | h | h
    · exact NbrInnerNine.largeEvenLabelAll_card_lt_triD4_of hp hΛX h (Or.inl hp3)
    · exact TableBExcSmallRest.largeEvenLabelAll_card_lt_G2der hp hΛX h
        (Or.inr (Or.inr (Or.inr ⟨hnx, hp3⟩)))
    · exact TableBExcSmallRest.largeEvenLabelAll_card_lt_twF4der_holds hp hΛX h
        (Or.inr (Or.inr (Or.inr ⟨hnx, hp3⟩)))
  obtain ⟨R, _, I, F, hQ, hP'⟩ := largeEvenRawDatum_exists (hAll _ hraw)
  obtain ⟨-, -, θ, hP₀⟩ := hQ
  have hind : GGInducedInn A θ I := hP₀.2.2
  have hAbab : IsElemAbelian p Ab := by
    obtain ⟨hc, hp'⟩ := hAab
    haveI : IsMulCommutative A := hc
    refine ⟨⟨⟨fun u v => ?_⟩⟩, fun z hz => ?_⟩
    · apply Subtype.ext
      exact Subgroup.mul_comm_of_mem_isMulCommutative A (hAbA u.2) (hAbA v.2)
    · exact hp' z (hAbA hz)
  let Y : Subgroup (MulAut R) := Ab.map (ggInducedAut θ)
  have hYI : (Y : Set (MulAut R)) ⊆ I := by
    intro y hy
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hy
    exact hind a (hAbA ha)
  have hYab : IsElemAbelian p Y := ltqSl_isElemAbelian_map (ggInducedAut θ) hAbab
  have hYcard : Nat.card Y = Nat.card Ab :=
    Subgroup.card_map_of_injective (ggInducedAut_injective_of_perfect hperf θ)
  have hlt : Nat.card Y < p ^ 3 := hP' Y hYI hYab
  rw [hYcard] at hlt
  exact absurd hcardAb (not_le.mpr hlt)

private theorem ltqSl_p
    {labX : LargeEvenLabel} {p n : ℕ} {X : Type} [Group X] [Finite X]
    {A Ab : Subgroup (MulAut X)} {σ : MulAut X} {J : Subgroup X}
    (hp : p.Prime) (hx : GGExcTwoLabel labX) (hΛX : LargeEvenInLambda2 labX)
    (hd : GGTPNDatumB p n (fun _ _ => True) A Ab σ J)
    (hhX : GGHasLabel labX (X ⧸ Subgroup.center X)) :
    p = 3 ∨ (p = 7 ∧ labX = ⟨.E6, 0, 1⟩) := by
  obtain ⟨-, -, -, -, -, -, -, hm⟩ := hd.1
  unfold GGTPNMarked at hm
  obtain ⟨lab, hΛlab, hlabHas, R, _, I, F, θ, hP⟩ := largeEvenMarking_exists_hasLabel hm
  have hlab_eq : lab = labX :=
    ltqSl_rig' hx lab hΛlab
      (ggLabelRigidInput_holds lab labX (X ⧸ Subgroup.center X) hΛlab hΛX hlabHas hhX)
  subst lab
  have hhalf : LargeEvenHalfSplit p labX (Subgroup.center X = ⊥) := hP.2.1
  rcases largeEvenHalfSplit_dvd hΛX hhalf with hdvd | h7
  · left
    rw [hx.1] at hdvd
    norm_num at hdvd
    rcases (Nat.dvd_prime (by norm_num : Nat.Prime 3)).1 hdvd with h1 | h3
    · exact absurd h1 hp.ne_one
    · exact h3
  · rcases h7 with ⟨hp7, hlab | hlab⟩
    · exfalso
      rw [hlab] at hx
      simp [GGExcTwoLabel] at hx
    · exact Or.inr ⟨hp7, hlab⟩

