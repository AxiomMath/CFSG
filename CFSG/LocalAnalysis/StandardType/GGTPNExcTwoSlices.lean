private theorem ltqSl_rig {labX : LargeEvenLabel} (hx : GGExcTwoLabel labX) :
    ∀ l : LargeEvenLabel, LargeEvenInLambda2 l → GGLabelIso labX l → l = labX := by
  intro l _ hiso
  obtain ⟨tx, rx, nx⟩ := labX
  obtain ⟨t, r, n⟩ := l
  obtain ⟨-, htag⟩ := hx
  rcases htag with h | h | h | h | h | h | h | h <;>
    (subst h
     unfold GGLabelIso at hiso
     rcases hiso with h | h | h | h | h | h | h | h <;> simp_all)

private theorem ltqSl_rig' {labX : LargeEvenLabel} (hx : GGExcTwoLabel labX) :
    ∀ l : LargeEvenLabel, LargeEvenInLambda2 l → GGLabelIso l labX → l = labX := by
  intro l _ hiso
  obtain ⟨tx, rx, nx⟩ := labX
  obtain ⟨t, r, n⟩ := l
  obtain ⟨-, htag⟩ := hx
  rcases htag with h | h | h | h | h | h | h | h <;>
    (subst h
     unfold GGLabelIso at hiso
     rcases hiso with h | h | h | h | h | h | h | h <;> simp_all)

private theorem ltqSl_iso_A_of_tag_A {labJ l : LargeEvenLabel} (htag : labJ.tag = .A)
    (h : GGLabelIso labJ l) (hl : l.tag = .A) : labJ = l := by
  unfold GGLabelIso at h
  rcases h with h | h | h | h | h | h | h | h
  · exact h
  · rcases h.1 with hB | hC
    · exact absurd (hB ▸ htag) (by simp)
    · exact absurd (hC ▸ htag) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · exact absurd (h.2 ▸ hl) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · exact absurd (h.1 ▸ hl) (by simp)

private theorem ltqSl_not_iso_A {labJ l : LargeEvenLabel} (htag : labJ.tag = .A)
    (hr : 3 ≤ labJ.rank) (h : GGLabelIso labJ l) (hl : l.tag ≠ .A)
    (h4 : l.tag ≠ .D ∨ l.rank ≠ 3) : False := by
  unfold GGLabelIso at h
  rcases h with h | h | h | h | h | h | h | h
  · exact hl (h ▸ htag)
  · rcases h.1 with hB | hC
    · exact absurd (hB ▸ htag) (by simp)
    · exact absurd (hC ▸ htag) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · rcases h4 with hD | hr3
    · exact hD (by rw [h.2])
    · exact hr3 (by rw [h.2])
  · exact absurd (h.1 ▸ htag) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · exact absurd (h.1 ▸ htag) (by simp)
  · exfalso
    have hrk := congrArg LargeEvenLabel.rank h.2
    simp at hrk
    omega

theorem ltqSl_iso_n_le_one {labJ l : LargeEvenLabel} (h2 : 2 ≤ labJ.n)
    (h : GGLabelIso labJ l) (hl : l.n = 1) (h8 : ¬ (l.tag = .twD ∧ l.rank = 2)) : False := by
  unfold GGLabelIso at h
  rcases h with h | h | h | h | h | h | h | h
  · rw [h] at h2; omega
  · rw [h.2.2.2] at h2; omega
  · have hthis : labJ.n = 1 := by simpa [hl] using (congrArg LargeEvenLabel.n h.2).symm
    omega
  · have hthis : labJ.n = 1 := by simpa [hl] using (congrArg LargeEvenLabel.n h.2).symm
    omega
  · have hthis : labJ.n = 1 := by simpa [hl] using (congrArg LargeEvenLabel.n h.2).symm
    omega
  · have hthis : labJ.n = 1 := by simpa [hl] using (congrArg LargeEvenLabel.n h.2).symm
    omega
  · have hthis : labJ.n = 1 := by simpa [hl] using (congrArg LargeEvenLabel.n h.2).symm
    omega
  · exact h8 ⟨by rw [h.1], by rw [h.1]⟩

