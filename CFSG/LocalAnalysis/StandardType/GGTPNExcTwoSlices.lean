private theorem ltqSl_card_le_nine_of_pRank {J : Type} [Group J] [Finite J]
    (h : CFSG.Open.pRank 3 (⊤ : Subgroup (MulAut J)) ≤ 2) :
    ∀ E : Subgroup (MulAut J), IsElemAbelian 3 E → Nat.card E ≤ 3 ^ 2 := by
  intro E hE
  have hE3 : IsPGroup 3 E := fun x => ⟨1, by
    apply Subtype.ext
    simpa using hE.2 (x : MulAut J) x.2⟩
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.1 hE3
  have hn2 : n ≤ 2 :=
    (CFSG.SectionRank.le_pRank (by norm_num : 1 < 3) le_top hE hn).trans h
  rw [hn]
  exact Nat.pow_le_pow_right (by norm_num) hn2

theorem ltqSl_T4 (hZ : GGE6TwoCenterBot) (hR : GGE6TwoLocalRankThree)
    {n : ℕ} {X : Type} [Group X] [Finite X] {A Ab : Subgroup (MulAut X)} {σ : MulAut X}
    {J : Subgroup X} (hd : GGTPNDatumB 3 n (fun _ _ => True) A Ab σ J)
    (hhX : GGHasLabel ⟨.E6, 0, 1⟩ (X ⧸ Subgroup.center X))
    (hhJ : GGHasLabel ⟨.A, 2, 2⟩ (↥J ⧸ Subgroup.center ↥J)) : False := by
  obtain ⟨hlocCore, hflat, -, hrank, -, -, -, hm⟩ := hd.1
  obtain ⟨hAbA, hσAb, -, hker⟩ := hflat
  have hnormA : ∀ a ∈ A, ∀ j ∈ J, a j ∈ J := hlocCore.2.2.2.2
  have hperfJ : commutator ↥J = ⊤ := hlocCore.2.2.2.1.2.2.1
  have hAbab : IsElemAbelian 3 Ab := by
    obtain ⟨hc, hp⟩ := hlocCore.1
    haveI : IsMulCommutative A := hc
    refine ⟨⟨⟨fun u v => ?_⟩⟩, fun z hz => ?_⟩
    · apply Subtype.ext
      exact Subgroup.mul_comm_of_mem_isMulCommutative A (hAbA u.2) (hAbA v.2)
    · exact hp z (hAbA hz)
  unfold GGTPNMarked at hm
  have hperfX : commutator X = ⊤ := hm.1
  have hZX : Subgroup.center X = ⊥ := hZ X hperfX hhX
  have hR4 : 4 ≤ LargeEvenTwoLocalRank 3 X := hR X hperfX hhX
  obtain ⟨m, hmcard, hmrank⟩ := hrank
  have hmrank' : LargeEvenTwoLocalRank 3 X ≤ m := by simpa [hZX] using hmrank
  have hm4 : 4 ≤ m := hR4.trans hmrank'
  have hAut : ∀ E : Subgroup (MulAut ↥J), IsElemAbelian 3 E → Nat.card E ≤ 3 ^ 2 :=
    ltqSl_card_le_nine_of_pRank
      (CFSG.LocalAnalysis.GLTheoremB.MovingAround.InputsSeitz3.pRank_mulAut_le_two_of_l34 hperfJ
        (ltqSl_isLThreeFour_of_hasLabel hhJ))
  have hnorm : ∀ a ∈ Ab, ∀ j ∈ J, a j ∈ J := fun a ha j hj => hnormA a (hAbA ha) j hj
  have hbound : Nat.card Ab ≤ 3 ^ 3 := by
    have h := B36.card_le_of_kernel_le_zpowers (p := 3) (by norm_num) hAbab hσAb hnorm hker
      (k := 2) hAut
    simpa using h
  have hb4 : 3 ^ 4 ≤ Nat.card Ab := by
    rw [hmcard]
    exact Nat.pow_le_pow_right (by norm_num) hm4
  have hnot : ¬ (3 ^ 4 ≤ 3 ^ 3) := by norm_num
  exact hnot (hb4.trans hbound)

theorem ltqSl_labelX_eq {labX : LargeEvenLabel} {t : LargeEvenLieTag} (ht : labX.tag = t)
    (hΛ : LargeEvenInLambda2 labX) (hn : labX.n = 1)
    (htags : t = .E6 ∨ t = .twE6 ∨ t = .E7 ∨ t = .E8 ∨ t = .F4 ∨ t = .triD4 ∨ t = .G2der ∨
      t = .twF4der) : labX = ⟨t, 0, 1⟩ := by
  obtain ⟨t', r, nn⟩ := labX
  dsimp only at ht hn
  subst ht
  have hr : r = 0 := by
    rcases htags with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      first | exact hΛ.2 | exact hΛ.2.1
  rw [hn, hr]

theorem ltqSl_A3_false_of_F4
    (hF4 : GGF4TwoThreeComp)
    {X : Type} [Group X] [Finite X] {A Ab : Subgroup (MulAut X)} {σ : MulAut X}
    {J : Subgroup X} {n : ℕ} {labX : LargeEvenLabel}
    (hd : GGTPNDatumB 3 n (fun _ _ => True) A Ab σ J)
    (hΛX : LargeEvenInLambda2 labX) (htagX : labX.tag = .F4) (hnX : labX.n = 1)
    (hhX : GGHasLabel labX (X ⧸ Subgroup.center X))
    (hhJ : GGHasLabel (⟨.A, 3, 1⟩ : LargeEvenLabel) (↥J ⧸ Subgroup.center ↥J)) :
    False := by
  have hx : GGExcTwoLabel labX :=
    ⟨hnX, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl htagX))))⟩
  have hlabX : labX = ⟨.F4, 0, 1⟩ :=
    ltqSl_labelX_eq htagX hΛX hnX (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))
  have hcomp : GGCompList labX 3 (fun l => l ∈ [⟨.C, 3, 1⟩]) := by
    rw [hlabX]; exact hF4
  obtain ⟨l, hSl, hiso⟩ := ltqSl_list hx hcomp hΛX
    (by intro l hl; simp only [List.mem_cons, List.mem_nil_iff, or_false] at hl
        rcases hl with rfl <;> simp [LargeEvenInLambda2])
    hd hhX (by simp [LargeEvenInLambda2]) hhJ
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hSl
  subst hSl
  exact ltqSl_not_iso_A (labJ := ⟨.A, 3, 1⟩) (l := ⟨.C, 3, 1⟩) rfl (by norm_num) hiso
    (by simp) (Or.inl (by simp))

theorem ggTablePKnownR_am2ExcTwo
