theorem kgfniSp_pairBlock_coord {K : Type} [Field K] [Fintype K] [CharP K 2] {n p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2)
    (u : GL (Fin n ⊕ Fin n) K) (hu : u ∈ StatedSp n K) (hodd : Odd (orderOf u))
    (hup : u ^ p = 1)
    {ε e e' : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K}
    (hε : IsPrimAdjIdemIn (RingHom.id K)
      (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K)
      (Algebra.adjoin K (Units.val '' ({u} : Set (GL (Fin n ⊕ Fin n) K)))) ε)
    (he : IsPrimIdemIn (Algebra.adjoin K (Units.val '' ({u} : Set (GL (Fin n ⊕ Fin n) K)))) e)
    (he' : IsPrimIdemIn (Algebra.adjoin K (Units.val '' ({u} : Set (GL (Fin n ⊕ Fin n) K)))) e')
    (hne : e ≠ e') (hεe : ε = e + e')
    {σ : K ≃+* K} (hσ : σ ≠ 1) (hσp : σ ^ p = 1)
    (hσu : Matrix.GeneralLinearGroup.map (σ : K →+* K) u = u) :
    ∃ (m : ℕ) (E : Type) (_ : Field E) (_ : Finite E) (_ : CharP E 2)
      (eG : ↥(glBlockCentralizer (StatedSp n K).subtype {u} ε) ≃* GL (Fin m) E)
      (B : GL (Fin m) E) (τ : E ≃+* E), τ ≠ 1 ∧
      ∀ g g' : ↥(glBlockCentralizer (StatedSp n K).subtype {u} ε),
        ((g' : StatedSp n K) : GL (Fin n ⊕ Fin n) K) =
            Matrix.GeneralLinearGroup.map (σ : K →+* K)
              ((g : StatedSp n K) : GL (Fin n ⊕ Fin n) K) →
          eG g' = B * Matrix.GeneralLinearGroup.map τ.toRingHom (eG g) * B⁻¹ := by
  classical
  let β : StatedSp n K := ⟨u, hu⟩
  have hoddβ : Odd (orderOf β) := by
    change Odd (orderOf (⟨u, hu⟩ : StatedSp n K))
    rw [Subgroup.orderOf_mk u hu]
    exact hodd
  have hpK : (p : K) ≠ 0 := by
    intro h
    have h2 : 2 ∣ p := (CharP.cast_eq_zero_iff K 2 p).mp h
    exact hp2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp h2).symm
  have hβp : β ^ p = 1 := by
    apply Subtype.ext
    change u ^ p = 1
    exact hup
  have hspEndp : spEnd β ^ p = 1 := by
    change (((spLin n K β : LinearMap.GeneralLinearGroup K (Fin n ⊕ Fin n → K))) :
      Module.End K (Fin n ⊕ Fin n → K)) ^ p = 1
    rw [← Units.val_pow_eq_pow_val, ← map_pow, hβp, map_one, Units.val_one]
  have H : AltPrimaryData (spForm n K) (spLin n K β) := altPrimaryData_spLin hpK hβp
  obtain ⟨a, ha, hae⟩ := ggJS1_prim_idem_eq_primaryProjection β hoddβ he
  obtain ⟨a', ha', ha'e⟩ := ggJS1_prim_idem_eq_primaryProjection β hoddβ he'
  obtain ⟨hrec, hane⟩ := ggJS1_reciprocal_of_prim_pair β hoddβ ha ha' hae ha'e hεe hne
    he.2.2.1 he'.2.2.1 he.1 he.2.1 hε.2.2.2.2 hε.2.2.2.1
  have ha'e' : Matrix.toLinAlgEquiv' e' =
      primaryProjection (spEnd β) (reciprocalPolynomial a) := by
    rw [hrec] at ha'e
    exact ha'e
  have hsub : glBlockCentralizer (StatedSp n K).subtype
      ({u} : Set (GL (Fin n ⊕ Fin n) K)) ε =
      spSupported β {a, reciprocalPolynomial a} := by
    simpa using ggJS1_glBlockCentralizer_eq_spSupported β hoddβ ha hane hae ha'e' hεe
  haveI : Fact (Irreducible a) := ⟨irreducible_of_mem_primaryFactors ha⟩
  let E : Type := AdjoinRoot a
  haveI hEfinite : Finite E := Module.finite_of_finite K
  haveI hEfintype : Fintype E := Fintype.ofFinite E
  haveI hEchar : CharP E 2 :=
    charP_of_injective_algebraMap (algebraMap K E).injective 2
  let W : Type := primaryComponent (spEnd β) a
  let m : ℕ := Module.finrank E W
  let b : Module.Basis (Fin m) E W := Module.finBasis E W
  let S : (Fin n ⊕ Fin n → K) ≃+ (Fin n ⊕ Fin n → K) := vecMap σ
  have hS : ∀ (c : K) (v : Fin n ⊕ Fin n → K), S (c • v) = σ c • S v :=
    fun c v => vecMap_smul σ c v
  have hσu' : Matrix.GeneralLinearGroup.map (σ : K →+* K)
      (β : GL (Fin n ⊕ Fin n) K) = (β : GL (Fin n ⊕ Fin n) K) := by
    simpa using hσu
  have hSx : ∀ v, S (spEnd β v) = spEnd β (S v) :=
    vecMap_spEnd β hσu'
  let xe : (Fin n ⊕ Fin n → K) ≃ₗ[K] (Fin n ⊕ Fin n → K) :=
    LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n ⊕ Fin n → K) (spLin n K β)
  have hSxe : ∀ v, S (xe v) = xe (S v) := by
    intro v
    simpa [xe, spEnd] using hSx v
  have haσ : a.map (σ : K →+* K) = a :=
    primaryFactors_map_eq_self_of_semilinear hp hpK hspEndp hσp S hS hSxe a ha
  let τ : E ≃+* E := extAut a σ haσ
  let SW : W ≃+ W := semilinRestrict (F := K) (V := Fin n ⊕ Fin n → K) (σ := σ)
    (S := S) (xe := xe) hS hSxe haσ
  let B : GL (Fin m) E := semMatUnit b SW (semilinRestrict_smul hS hSxe haσ)
  have hτ : τ ≠ 1 := by
    intro h
    exact hσ ((extAut_eq_one_iff haσ).mp h)
  have hL := supportedUnitary_le_sesq β {a, reciprocalPolynomial a}
  let gU : ↥(glBlockCentralizer (StatedSp n K).subtype {u} ε) →
      ↥(supportedUnitary (spForm n K) (spLin n K β) {a, reciprocalPolynomial a}) :=
    fun g => (comapSpLinEquiv (supportedUnitary (spForm n K) (spLin n K β)
      {a, reciprocalPolynomial a}) hL) ((MulEquiv.subgroupCongr hsub) g)
  let pre : ↥(glBlockCentralizer (StatedSp n K).subtype {u} ε) ≃*
      blockGL (spEnd β) a :=
    (MulEquiv.subgroupCongr hsub).trans
      ((comapSpLinEquiv (supportedUnitary (spForm n K) (spLin n K β)
        {a, reciprocalPolynomial a}) hL).trans (H.pairedEquiv ha hane))
  let eG : ↥(glBlockCentralizer (StatedSp n K).subtype {u} ε) ≃* GL (Fin m) E :=
    pre.trans (Matrix.GeneralLinearGroup.toLin' b).symm
  refine ⟨m, E, inferInstance, hEfinite, hEchar, eG, B, τ, hτ, ?_⟩
  intro g g' hgg'
  have hblock : ∀ (x : ↥(glBlockCentralizer (StatedSp n K).subtype {u} ε)) (w : W),
      ((pre x : W →ₗ[E] W) w : Fin n ⊕ Fin n → K) =
        spEnd (x : StatedSp n K) (w : Fin n ⊕ Fin n → K) := by
    intro x w
    have h1 := H.blockApply_pairedEquiv ha hane (gU x) (w : Fin n ⊕ Fin n → K) w.2
    have hpre : pre x = H.pairedEquiv ha hane (gU x) := by
      rfl
    have h2 : ((pre x : W →ₗ[E] W) w : Fin n ⊕ Fin n → K) =
        (LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n ⊕ Fin n → K)
          ((gU x : ↥(supportedUnitary (spForm n K) (spLin n K β)
            {a, reciprocalPolynomial a})) :
            LinearMap.GeneralLinearGroup K (Fin n ⊕ Fin n → K)))
          (w : Fin n ⊕ Fin n → K) := by
      rw [hpre, ← LinearMap.GeneralLinearGroup.generalLinearEquiv_to_linearMap]
      simpa [blockApply] using h1
    have hgl : ((gU x : ↥(supportedUnitary (spForm n K) (spLin n K β)
        {a, reciprocalPolynomial a})) :
        LinearMap.GeneralLinearGroup K (Fin n ⊕ Fin n → K)) =
        spLin n K (x : StatedSp n K) := by
      change ((comapSpLinEquiv (supportedUnitary (spForm n K) (spLin n K β)
        {a, reciprocalPolynomial a}) hL) ((MulEquiv.subgroupCongr hsub) x) :
        LinearMap.GeneralLinearGroup K (Fin n ⊕ Fin n → K)) =
        spLin n K (x : StatedSp n K)
      exact coe_comapSpLinEquiv (supportedUnitary (spForm n K) (spLin n K β)
        {a, reciprocalPolynomial a}) hL ((MulEquiv.subgroupCongr hsub) x)
    have h3 : LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n ⊕ Fin n → K)
        ((gU x : ↥(supportedUnitary (spForm n K) (spLin n K β)
          {a, reciprocalPolynomial a})) :
          LinearMap.GeneralLinearGroup K (Fin n ⊕ Fin n → K)) =
        LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n ⊕ Fin n → K)
          (spLin n K (x : StatedSp n K)) :=
      congrArg (LinearMap.GeneralLinearGroup.generalLinearEquiv K
        (Fin n ⊕ Fin n → K)) hgl
    rw [h2, h3]
    exact congrArg (fun f : (Fin n ⊕ Fin n → K) →ₗ[K] (Fin n ⊕ Fin n → K) =>
      f (w : Fin n ⊕ Fin n → K))
      (LinearMap.GeneralLinearGroup.generalLinearEquiv_to_linearMap
        (spLin n K (x : StatedSp n K)))
  have hrelV : ∀ w : W, ((pre g' : W →ₗ[E] W) w : Fin n ⊕ Fin n → K) =
      S (((pre g : W →ₗ[E] W) (SW.symm w) : W) : Fin n ⊕ Fin n → K) := by
    intro w
    let M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K :=
      (((g : StatedSp n K) : GL (Fin n ⊕ Fin n) K) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K)
    have hmat : (((g' : StatedSp n K) : GL (Fin n ⊕ Fin n) K) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K) = M.map (σ : K →+* K) := by
      have h := congrArg (fun z : GL (Fin n ⊕ Fin n) K =>
        (z : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K)) hgg'
      simpa [M, Matrix.GeneralLinearGroup.map_apply] using h
    calc ((pre g' : W →ₗ[E] W) w : Fin n ⊕ Fin n → K)
        = spEnd (g' : StatedSp n K) (w : Fin n ⊕ Fin n → K) := hblock g' w
      _ = ((((g' : StatedSp n K) : GL (Fin n ⊕ Fin n) K) :
            Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K)).mulVec
            (w : Fin n ⊕ Fin n → K) := spEnd_apply _ _
      _ = (M.map (σ : K →+* K)).mulVec (w : Fin n ⊕ Fin n → K) := by rw [hmat]
      _ = S (M.mulVec (S.symm (w : Fin n ⊕ Fin n → K))) :=
        map_mulVec_eq_vecMap σ M (w : Fin n ⊕ Fin n → K)
      _ = S (spEnd (g : StatedSp n K) (S.symm (w : Fin n ⊕ Fin n → K))) := by
        rw [spEnd_apply]
      _ = S (((pre g : W →ₗ[E] W) (SW.symm w) : W) : Fin n ⊕ Fin n → K) := by
        rw [hblock g (SW.symm w)]
        rfl
  have hrelW : ∀ w : W, (pre g' : W →ₗ[E] W) w =
      SW ((pre g : W →ₗ[E] W) (SW.symm w)) := by
    intro w
    apply Subtype.ext
    change ((pre g' : W →ₗ[E] W) w : Fin n ⊕ Fin n → K) =
      S (((pre g : W →ₗ[E] W) (SW.symm w) : W) : Fin n ⊕ Fin n → K)
    exact hrelV w
  have hsq := toLin'_symm_conj_semilin b SW (semilinRestrict_smul hS hSxe haσ)
    (pre g) (pre g') hrelW
  change (Matrix.GeneralLinearGroup.toLin' b).symm (pre g') =
    B * Matrix.GeneralLinearGroup.map (τ : E →+* E)
      ((Matrix.GeneralLinearGroup.toLin' b).symm (pre g)) * B⁻¹
  exact hsq

end CFSG.StandardType
