theorem tcjLabel_rawDatum_canonical_to_legacy {lab : LargeEvenLabel}
    {T : (R : Type) → [Group R] → Prop}
    (h : CFSG.Assembly.LargeEvenRawDatum lab (fun R _ _ _ => T R)) :
    CFSG.StandardType.LargeEvenRawDatum lab (fun R _ _ _ => T R) := by
  obtain ⟨tag, rank, exponent⟩ := lab
  cases tag
  all_goals
    dsimp only [CFSG.Assembly.LargeEvenRawDatum, CFSG.StandardType.LargeEvenRawDatum] at h ⊢
  all_goals try split_ifs at h ⊢
  all_goals first
    | (obtain ⟨K, i1, i2, hK, b, c, hbc, hq⟩ := h
       exact ⟨K, i1, i2, hK, b, c, hbc, hq⟩)
    | (obtain ⟨K, i1, i2, hK, hq⟩ := h
       exact ⟨K, i1, i2, hK, hq⟩)

theorem tcjLabel_n_dvd_canonLabel_n {lab : LargeEvenLabel} (hlab : LargeEvenInLambda2 lab) :
    lab.n ∣ (canonLabel lab).n := by
  obtain ⟨t, r, n⟩ := lab
  cases t
  case B2der => obtain ⟨-, -, h1⟩ := hlab; subst h1; exact one_dvd _
  case G2der => obtain ⟨-, -, h1⟩ := hlab; subst h1; exact one_dvd _
  case twF4der => obtain ⟨-, -, h1⟩ := hlab; subst h1; exact one_dvd _
  case D => simp only [canonLabel]; split_ifs <;> exact dvd_rfl
  case twD =>
    simp only [canonLabel]
    split_ifs
    · exact dvd_rfl
    · exact dvd_mul_left n 2
    · exact dvd_rfl
  all_goals exact dvd_rfl

theorem tcjLabel_canonLabel_inLambda2 {lab : LargeEvenLabel} (h : LargeEvenInLambda2 lab)
    (hnd : lab.tag ≠ .B2der ∧ lab.tag ≠ .G2der ∧ lab.tag ≠ .twF4der) :
    LargeEvenInLambda2 (canonLabel lab) := by
  obtain ⟨t, r, n⟩ := lab
  obtain ⟨h1, h2, h3⟩ := hnd
  cases t
  case A => exact h
  case twA => exact h
  case B => exact h
  case C => dsimp only [canonLabel]; exact h
  case D =>
    dsimp only [canonLabel]
    split_ifs with hr
    · dsimp only [LargeEvenInLambda2] at h ⊢
      exact ⟨h.1, by omega, by omega⟩
    · exact h
  case twD =>
    dsimp only [canonLabel]
    split_ifs with hr3 hr2
    · dsimp only [LargeEvenInLambda2] at h ⊢
      exact ⟨h.1, by omega, by omega⟩
    · dsimp only [LargeEvenInLambda2] at h ⊢
      exact ⟨by omega, by omega, by omega⟩
    · exact h
  case E6 => exact h
  case E7 => exact h
  case E8 => exact h
  case F4 => exact h
  case twE6 => exact h
  case triD4 => exact h
  case G2 => exact h
  case twB2 => exact h
  case twF4 => exact h
  case B2der => exact absurd rfl h1
  case G2der => exact absurd rfl h2
  case twF4der => exact absurd rfl h3

theorem tcjLabel_derived_canonLabel_n {lab : LargeEvenLabel}
    (h : lab.tag = .B2der ∨ lab.tag = .G2der ∨ lab.tag = .twF4der) :
    (canonLabel lab).n = 1 := by
  obtain ⟨t, r, n⟩ := lab
  rcases h with h | h | h <;> simp only at h <;> subst h <;> rfl

theorem tcjLabel_ggLabelIso_canonLabel {lab : LargeEvenLabel}
    (hnd : lab.tag ≠ .B2der ∧ lab.tag ≠ .G2der ∧ lab.tag ≠ .twF4der) :
    GGLabelIso lab (canonLabel lab) := by
  obtain ⟨t, r, n⟩ := lab
  obtain ⟨h1, h2, h3⟩ := hnd
  cases t
  case D =>
    dsimp only [canonLabel]
    split_ifs with hr
    · exact Or.inr (Or.inr (Or.inl ⟨by rw [hr], rfl⟩))
    · exact Or.inl rfl
  case twD =>
    dsimp only [canonLabel]
    split_ifs with hr3 hr2
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨by rw [hr3], rfl⟩))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
        (Or.inl ⟨by rw [hr2], rfl⟩))))))
    · exact Or.inl rfl
  case C => exact Or.inr (Or.inl ⟨Or.inr rfl, Or.inl rfl, rfl, rfl⟩)
  case B2der => exact absurd rfl h1
  case G2der => exact absurd rfl h2
  case twF4der => exact absurd rfl h3
  all_goals exact Or.inl rfl

theorem tcjLabel_ggHasLabel_canonLabel {X : Type} [Group X] {lab : LargeEvenLabel}
    (hnd : lab.tag ≠ .B2der ∧ lab.tag ≠ .G2der ∧ lab.tag ≠ .twF4der)
    (h : GGHasLabel lab X) : GGHasLabel (canonLabel lab) X := by
  unfold GGHasLabel at h ⊢
  exact largeEvenRawDatum_of_ggLabelIso (tcjLabel_ggLabelIso_canonLabel hnd) h

theorem tcj_component_hasLabel {S : Type} [Group S] [Finite S]
    (p : ℕ) (hp : p.Prime)
    (hp2 : p ≠ 2) (lab : LargeEvenLabel) (α : MulAut S) (K : Subgroup S)
    (hlab : LargeEvenInLambda2 lab) (hcen : Subgroup.center S = ⊥) (hin : InnDiagKind S lab α)
    (hα : α ^ p = 1) (hK : CFSG.Assembly.IsComponentOf K (ggFixSub α)) :
    ∃ labJ0 : LargeEvenLabel, LargeEvenInLambda2 labJ0 ∧
      HasLabel ↥K (fun l : GLALabel => l = labJ0) := by
  obtain ⟨hcomm, labK, hlabK, hraw⟩ := hin
  obtain ⟨R, hR, I, F, hsimpleR, hnaR, θ, -⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  haveI : IsSimpleGroup R := hsimpleR
  let e : S ≃* R :=
    (((QuotientGroup.quotientMulEquivOfEq hcen).trans QuotientGroup.quotientBot).symm).trans θ
  have hsimpleS : IsSimpleGroup S := e.isSimpleGroup
  have hnaS : ∃ a b : S, a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hnaR
    exact ⟨e.symm a, e.symm b, fun h => hab (by simpa using congrArg e h)⟩
  have hlegacy : CFSG.StandardType.LargeEvenMarking S (fun _ _ _ _ _ _ => True) :=
    ⟨hcomm, labK, hlabK, tcjLabel_rawDatum_canonical_to_legacy
      (CFSG.StandardType.Canonical.largeEvenRawDatum_mono
        (fun R _ I F hq => ⟨hq.1, hq.2.1, hq.2.2.choose, trivial⟩) hraw)⟩
  have hchevS : IsChevSimple 2 S :=
    CFSG.LocalAnalysis.GLTheoremB.MovingAround.Lemma1315b.isChevSimple_two_of_isChevTwo
      (isChevTwo_of_largeEvenMarking_of_center_eq_bot hlegacy hcen)
  have hEel : IsElemAbelian p (Subgroup.zpowers α) := by
    refine ⟨Subgroup.zpowers_isMulCommutative α, fun x hx => ?_⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    rw [← _root_.zpow_natCast, ← _root_.zpow_mul, mul_comm, _root_.zpow_mul,
      _root_.zpow_natCast, hα, _root_.one_zpow]
  have hfix : CFSG.LocalAnalysis.GLTheoremA.I142.centFix (Subgroup.zpowers α) = ggFixSub α := by
    rw [CFSG.LocalAnalysis.GLTheoremA.I142.centFix_zpowers]
    rfl
  have hKo : CFSG.Open.IsComponentOf K
      (CFSG.LocalAnalysis.GLTheoremA.I142.centFix (Subgroup.zpowers α)) := by
    rw [hfix]
    exact (CFSG.Assembly.isComponentOf_iff_open).mp hK
  have hchevK : IsChevSimple 2 (↥K ⧸ Subgroup.center ↥K) :=
    CFSG.LocalAnalysis.GLTheoremA.I142T.compTypesElem_holds S hsimpleS hnaS hchevS p hp hp2
      (Subgroup.zpowers α) hEel K hKo
  obtain ⟨hcommK, labJ0, hlabJ0, hrawK⟩ :=
    CFSG.StandardType.ChevTwo.ys08_holds ↥K hK.2.2 hchevK
  refine ⟨labJ0, hlabJ0, ?_⟩
  refine ⟨hcommK, labJ0, hlabJ0, CFSG.StandardType.Canonical.largeEvenRawDatum_mono ?_ hrawK⟩
  rintro R _ I F ⟨hs, hna, θ, -⟩
  exact ⟨hs, hna, θ, rfl⟩

theorem tcj_ggHasLabel_of_hasLabel {X : Type} [Group X] {labJ0 : LargeEvenLabel}
    (h : HasLabel X (fun l : GLALabel => l = labJ0)) :
    GGHasLabel labJ0 (X ⧸ Subgroup.center X) := by
  obtain ⟨hcomm, lab, hlab, hraw⟩ := h
  obtain ⟨R, hR, I, F, hs, hna, θ, heq⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  have hraw' : CFSG.Assembly.LargeEvenRawDatum lab
      (fun R _ _ _ => Nonempty (X ⧸ Subgroup.center X ≃* R)) :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_mono
      (fun R _ I F hq => ⟨hq.2.2.choose⟩) hraw
  rw [heq] at hraw'
  unfold GGHasLabel
  exact tcjLabel_rawDatum_canonical_to_legacy hraw'

theorem tcj_relabel {X : Type} [Group X] {lab labJ0 : LargeEvenLabel}
    (hlab : LargeEvenInLambda2 lab) (hJ0 : LargeEvenInLambda2 labJ0)
    (hdvd : (canonLabel lab).n ∣ (canonLabel labJ0).n) (hhas : GGHasLabel labJ0 X) :
    ∃ labJ : LargeEvenLabel, LargeEvenInLambda2 labJ ∧ lab.n ∣ labJ.n ∧ GGHasLabel labJ X := by
  by_cases hder : labJ0.tag = .B2der ∨ labJ0.tag = .G2der ∨ labJ0.tag = .twF4der
  · have hcn : (canonLabel lab).n = 1 :=
      Nat.dvd_one.mp (hdvd.trans (by rw [tcjLabel_derived_canonLabel_n hder]))
    have hln : lab.n = 1 := Nat.dvd_one.mp (hcn ▸ tcjLabel_n_dvd_canonLabel_n hlab)
    exact ⟨labJ0, hJ0, by rw [hln]; exact one_dvd _, hhas⟩
  · have hnd : labJ0.tag ≠ .B2der ∧ labJ0.tag ≠ .G2der ∧ labJ0.tag ≠ .twF4der :=
      ⟨fun h => hder (Or.inl h), fun h => hder (Or.inr (Or.inl h)),
        fun h => hder (Or.inr (Or.inr h))⟩
    exact ⟨canonLabel labJ0, tcjLabel_canonLabel_inLambda2 hJ0 hnd,
      (tcjLabel_n_dvd_canonLabel_n hlab).trans hdvd, tcjLabel_ggHasLabel_canonLabel hnd hhas⟩

