private theorem excPayV_lieModel_adjointGroup (n : ℕ) (hn : 1 ≤ n) :
    LieModel ↥(adjointGroup .E7 (GaloisField 2 n)) .E7 0 2 n := by
  have hk : Nat.card (GaloisField 2 n) = 2 ^ n := GaloisField.card 2 n (by omega)
  have hChev : ChevalleyExceptionalModel ↥(adjointGroup .E7 (GaloisField 2 n)) .E7 2 n :=
    ⟨⟨Nat.prime_two, hn, rfl⟩,
      CFSG.HardMathSupport.Dickson.Sec6.I923.untwisted_adjointGroup hk⟩
  exact Or.inr (Or.inl ⟨rfl, by decide, hChev⟩)

private theorem excPayV_e7_raw_data {G : Type} [Group G] [Finite G] {p : ℕ} {Bs X : Subgroup G}
    {k : ℕ}
    (hmark : GGInnerDiagOnLabel (fun p lab => ggRowP_EE7 p lab ∧ k ≤ lab.n) p Bs X) :
    ∃ (f : ℕ) (K : Type) (_ : Field K) (_ : Finite K)
      (θ : ↥X ⧸ Subgroup.center ↥X ≃* TableBExc.RecipeGroup .E7 K),
      k ≤ f ∧ p ∣ 2 ^ f + 1 ∧ Nat.card K = 2 ^ f ∧
      MarkedModel ⟨.E7, 0, f⟩ (TableBExc.RecipeGroup .E7 K) ∧
      IsSimpleGroup (TableBExc.RecipeGroup .E7 K) ∧
      (∃ a b : TableBExc.RecipeGroup .E7 K, a * b ≠ b * a) ∧
      (∀ b ∈ Bs, b ∈ Subgroup.normalizer (X : Set G)) ∧
      (∀ b ∈ Bs, ∃ φ ∈ TableBExc.RecipeID .E7 K,
        LargeEvenInduces θ (fun l l' => (l' : G) = b⁻¹ * l * b) φ) := by
  obtain ⟨hperf, lab, hlab, hraw⟩ := hmark
  have hraw' := largeEvenRawDatum_markedModel hlab (fun R _ I F hq => hq.2.1) hraw
  rcases lab with ⟨tag, rank, n⟩
  cases tag
  case E7 =>
    simp only [LargeEvenRawDatum] at hraw'
    obtain ⟨K, hK_field, hK_finite, hK_card, hQ'⟩ := hraw'
    obtain ⟨hQ, hm⟩ := hQ'
    obtain ⟨hsimple, hna, θ, hP⟩ := hQ
    obtain ⟨⟨hE7, hp⟩, hkn⟩ := hP.1
    obtain ⟨hBsN, hBsInd⟩ := hP.2
    exact ⟨n, K, hK_field, hK_finite, θ, hkn, hp, hK_card, hm, hsimple, hna, hBsN, hBsInd⟩
  all_goals
    obtain ⟨R, hR, I, F, hQ⟩ := largeEvenRawDatum_exists hraw'
    obtain ⟨hQ_orig, hm⟩ := hQ
    obtain ⟨hsimple, hna, θ, hP⟩ := hQ_orig
    exact absurd hP.1.1.1 (by simp)

private theorem excPayV_e7_center_eq_bot {X : Type} [Group X] [Finite X]
    {f : ℕ} {K : Type} [Field K] [Finite K]
    (hperf : commutator X = ⊤) (hsimple : IsSimpleGroup (TableBExc.RecipeGroup .E7 K))
    (hna : ∃ a b : TableBExc.RecipeGroup .E7 K, a * b ≠ b * a)
    (eR : TableBExc.RecipeGroup .E7 K ≃* ↥(adjointGroup .E7 (GaloisField 2 f)))
    (hf : 1 ≤ f)
    (θ : X ⧸ Subgroup.center X ≃* TableBExc.RecipeGroup .E7 K) :
    Subgroup.center X = ⊥ := by
  have hQuasi : CFSG.IsQuasisimple X := by
    haveI hsimple' : IsSimpleGroup (TableBExc.RecipeGroup .E7 K) := hsimple
    have hna' : ∃ a b : X ⧸ Subgroup.center X, a * b ≠ b * a := by
      obtain ⟨a, b, hab⟩ := hna
      refine ⟨θ.symm a, θ.symm b, fun h => hab ?_⟩
      simpa using congrArg θ h
    exact ⟨⟨hperf⟩, θ.isSimpleGroup, hna'⟩
  have hk : Nat.card (GaloisField 2 f) = 2 ^ f := GaloisField.card 2 f (by omega)
  let eZ : AdjointQuotient .E7 (GaloisField 2 f) ≃* ↥(adjointGroup .E7 (GaloisField 2 f)) :=
    (QuotientGroup.quotientMulEquivOfEq (center_adjointGroup_eq_bot)).trans
      QuotientGroup.quotientBot
  exact CFSG.HardMathSupport.Meierfrankenfeld.Proving.E7Curtis.center_eq_bot_of_E7
    hQuasi (by omega) hk (θ.trans (eR.trans eZ.symm))

private theorem excPayV_e7_equiv {X : Type} [Group X] [Finite X]
    {f : ℕ} {K : Type} [Field K] [Finite K]
    (eR : TableBExc.RecipeGroup .E7 K ≃* ↥(adjointGroup .E7 (GaloisField 2 f)))
    (hZ : Subgroup.center X = ⊥)
    (θ : X ⧸ Subgroup.center X ≃* TableBExc.RecipeGroup .E7 K) :
    ∃ (eXiso : X ≃* TableBExc.RecipeGroup .E7 K)
      (κ : ↥(adjointGroup .E7 (GaloisField 2 f)) ≃* X),
      ∀ z : X, eXiso z = θ (QuotientGroup.mk z) := by
  let eXiso : X ≃* TableBExc.RecipeGroup .E7 K :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans θ
  refine ⟨eXiso, eR.symm.trans eXiso.symm, ?_⟩
  intro z
  rfl

private theorem excPayV_e7_equiv_of_marking {G : Type} [Group G] [Finite G] {p : ℕ}
    {Bs X : Subgroup G} {k : ℕ} (hk : 1 ≤ k)
    (hmark : GGInnerDiagOnLabel (fun p lab => ggRowP_EE7 p lab ∧ k ≤ lab.n) p Bs X) :
    ∃ (f : ℕ) (K : Type) (_ : Field K) (_ : Finite K)
      (θ : ↥X ⧸ Subgroup.center ↥X ≃* TableBExc.RecipeGroup .E7 K)
      (eXiso : ↥X ≃* TableBExc.RecipeGroup .E7 K)
      (κ : ↥(adjointGroup .E7 (GaloisField 2 f)) ≃* ↥X),
      k ≤ f ∧ p ∣ 2 ^ f + 1 ∧
      (∀ z : ↥X, eXiso z = θ (QuotientGroup.mk z)) ∧
      (∀ b ∈ Bs, b ∈ Subgroup.normalizer (X : Set G)) ∧
      (∀ b ∈ Bs, ∃ r : TableBExc.RecipeGroup .E7 K, LargeEvenInduces θ
        (fun l l' => (l' : G) = b⁻¹ * l * b) (MulAut.conj r)) := by
  obtain ⟨f, K, hK_field, hK_finite, θ, hkf, hpf, hK_card,
    hm, hsimple, hna, hBsN, hBsIndI⟩ := excPayV_e7_raw_data hmark
  have hm' : LieModel (TableBExc.RecipeGroup .E7 K) .E7 0 2 f := hm
  obtain ⟨eR⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.Seitz2313Cover.lieModel_unique_even
      (t := .E7) (by trivial) hm' (excPayV_lieModel_adjointGroup f (by omega))
  have hZ : Subgroup.center ↥X = ⊥ :=
    excPayV_e7_center_eq_bot hmark.1 hsimple hna eR (by omega) θ
  obtain ⟨eXiso, κ, heXiso⟩ := excPayV_e7_equiv eR hZ θ
  have hBsInd : ∀ b ∈ Bs, ∃ r : TableBExc.RecipeGroup .E7 K, LargeEvenInduces θ
      (fun l l' => (l' : G) = b⁻¹ * l * b) (MulAut.conj r) := by
    intro b hb
    obtain ⟨φ, hφI, hφInd⟩ := hBsIndI b hb
    haveI : Fintype K := Fintype.ofFinite K
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hcard : Fintype.card K = 2 ^ f := by
      rw [← Nat.card_eq_fintype_card, hK_card]
    haveI : CharP K 2 := charP_of_card_eq_prime_pow hcard
    obtain ⟨r, hr⟩ := TableBExc.idImage_subset_inn_E7 K hφI
    exact ⟨r, hr ▸ hφInd⟩
  exact ⟨f, K, hK_field, hK_finite, θ, eXiso, κ, hkf, hpf, heXiso, hBsN, hBsInd⟩

private theorem excPayV_e7_inner {G : Type} [Group G] {Bs X : Subgroup G}
    {K : Type} [Field K] [Finite K]
    (θ : ↥X ⧸ Subgroup.center ↥X ≃* TableBExc.RecipeGroup .E7 K)
    (eXiso : ↥X ≃* TableBExc.RecipeGroup .E7 K)
    (heXiso : ∀ z : ↥X, eXiso z = θ (QuotientGroup.mk z))
    (hBsN : ∀ b ∈ Bs, b ∈ Subgroup.normalizer (X : Set G))
    (hBsInd : ∀ b ∈ Bs, ∃ r : TableBExc.RecipeGroup .E7 K, LargeEvenInduces θ
      (fun l l' => (l' : G) = b⁻¹ * l * b) (MulAut.conj r)) :
    ∀ b ∈ Bs, b ∈ Subgroup.normalizer (X : Set G) ∧
      ∃ x ∈ X, ∀ y ∈ X, b * y * b⁻¹ = x * y * x⁻¹ := by
  intro b hb
  refine ⟨hBsN b hb, ?_⟩
  obtain ⟨r, hφInd⟩ := hBsInd b hb
  let x : ↥X := eXiso.symm r⁻¹
  use x
  constructor
  · exact x.2
  · intro y hy
    have hb_norm : b ∈ Subgroup.normalizer (X : Set G) := hBsN b hb
    let yX : ↥X := ⟨y, hy⟩
    let l : ↥X := ⟨b * y * b⁻¹, (Subgroup.mem_normalizer_iff.1 hb_norm y).1 hy⟩
    have h_ind : MulAut.conj r (eXiso l) = eXiso yX := by
      have h := hφInd l yX (by dsimp [l, yX]; group)
      simpa [heXiso] using h
    have hx : eXiso x = r⁻¹ := by
      dsimp [x]
      exact eXiso.apply_symm_apply r⁻¹
    have hφ_app : MulAut.conj r (eXiso l) = r * eXiso l * r⁻¹ := rfl
    rw [hφ_app] at h_ind
    have h_eq : x⁻¹ * l * x = yX := by
      have h1 : eXiso (x⁻¹ * l * x) = eXiso yX := by
        rw [map_mul, map_mul, map_inv, hx, inv_inv]
        rw [h_ind]
      exact eXiso.injective h1
    have h_l_eq : l = x * yX * x⁻¹ := by
      calc
        l = x * (x⁻¹ * l * x) * x⁻¹ := by group
        _ = x * yX * x⁻¹ := by rw [h_eq]
    calc
      b * y * b⁻¹ = (l : G) := rfl
      _ = (x * yX * x⁻¹ : ↥X) := by rw [h_l_eq]
      _ = (x : G) * y * (x⁻¹ : G) := by simp [yX]

theorem exists_e7Equiv_of_marking_of_le {G : Type} [Group G] [Finite G] {p : ℕ} {Bs X : Subgroup G}
    {k : ℕ} (hk : 1 ≤ k)
    (hmark : GGInnerDiagOnLabel (fun p lab => ggRowP_EE7 p lab ∧ k ≤ lab.n) p Bs X) :
    ∃ f : ℕ, k ≤ f ∧ p ∣ 2 ^ f + 1 ∧
      ∃ _ : ↥(adjointGroup .E7 (GaloisField 2 f)) ≃* ↥X,
        ∀ b ∈ Bs, b ∈ Subgroup.normalizer (X : Set G) ∧
          ∃ x ∈ X, ∀ y ∈ X, b * y * b⁻¹ = x * y * x⁻¹ := by
  obtain ⟨f, K, hK_field, hK_finite, θ, eXiso, κ, hkf, hpf, heXiso, hBsN, hBsInd⟩ :=
    excPayV_e7_equiv_of_marking hk hmark
  exact ⟨f, hkf, hpf, κ, excPayV_e7_inner θ eXiso heXiso hBsN hBsInd⟩

theorem exists_e7Equiv_of_marking {G : Type} [Group G] [Finite G] {p : ℕ} {Bs X : Subgroup G}
    (hmark : GGInnerDiagOnLabel (fun p lab => ggRowP_EE7 p lab ∧ 2 ≤ lab.n) p Bs X) :
    ∃ f : ℕ, 2 ≤ f ∧ p ∣ 2 ^ f + 1 ∧
      ∃ _ : ↥(adjointGroup .E7 (GaloisField 2 f)) ≃* ↥X,
        ∀ b ∈ Bs, b ∈ Subgroup.normalizer (X : Set G) ∧
          ∃ x ∈ X, ∀ y ∈ X, b * y * b⁻¹ = x * y * x⁻¹ :=
  exists_e7Equiv_of_marking_of_le (k := 2) (by norm_num) hmark

theorem isCentralQuotientOf_E7_of_equiv {Y : Type} [Group Y] {f : ℕ}
    (κ : ↥(adjointGroup .E7 (GaloisField 2 f)) ≃* Y) :
    IsCentralQuotientOf (lieUniversal .E7 0 2 f Nat.prime_two) Y := by
  let e : (lieUniversal .E7 0 2 f Nat.prime_two).K ≃* Y :=
    (CFSG.LieType.AschbacherSeitz.e7EquivAlg f).trans κ
  refine ⟨e.toMonoidHom, e.surjective, ?_⟩
  intro x hx
  rw [MonoidHom.mem_ker] at hx
  have hx1 : x = 1 := e.injective (by simpa using hx)
  rw [hx1]
  exact Subgroup.one_mem _

