private lemma largeEven_le_gramSU {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K) :
    LargeEvenSUGroup (Fin n) K (2 ^ f) ≤ gramSU h (idGram K n) := by
  rw [CFSG.StandardType.InndiagSU.largeEvenSUGroup_eq_gramSU (d := n) h]

private lemma gramSU_le_largeEven {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K) :
    gramSU h (idGram K n) ≤ LargeEvenSUGroup (Fin n) K (2 ^ f) := by
  rw [CFSG.StandardType.InndiagSU.largeEvenSUGroup_eq_gramSU (d := n) h]

private abbrev toEnd {K : Type} [Field K] {n : ℕ} (u : GL (Fin n) K) :
    Module.End K (Fin n → K) := Matrix.GeneralLinearGroup.toLin u

private lemma toEnd_mulVec {K : Type} [Field K] {n : ℕ} (u : GL (Fin n) K) (v : Fin n → K) :
    toEnd u v = ((u : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v := rfl

private lemma X_sub_C_injective {K : Type} [Field K] {p q : K} :
    Polynomial.X - Polynomial.C p = Polynomial.X - Polynomial.C q → p = q := by
  intro hc
  have hp := congrArg (fun r : Polynomial K => r.coeff 0) hc
  exact neg_injective (by simpa using hp)

private lemma bar_mul_self_of_three_dvd {K : Type} [Field K] {f : ℕ}
    (h : UnitaryFieldData 2 f K) (hq3 : 3 ∣ 2 ^ f + 1) {μ : K} (hμ : μ ^ 3 = 1) :
    h.bar μ * μ = 1 := by
  obtain ⟨m, hm⟩ := hq3
  rw [UnitaryFieldData.bar_apply, ← pow_succ, hm, pow_mul, hμ, one_pow]

private lemma dualPoly_X_sub_C_of_cube {K : Type} [Field K] {f : ℕ}
    (h : UnitaryFieldData 2 f K) (hq3 : 3 ∣ 2 ^ f + 1) {ν : K} (hν : ν ^ 3 = 1) :
    dualPoly h.bar (Polynomial.X - Polynomial.C ν) = Polynomial.X - Polynomial.C ν := by
  have hb := bar_mul_self_of_three_dvd h hq3 hν
  have hb0 : h.bar ν ≠ 0 := fun h0 => by rw [h0, zero_mul] at hb; exact zero_ne_one hb
  rw [CFSG.RankThree.PartOne.KCUnitaryBlock.dualPoly_X_sub_C hb0]
  congr 2
  exact inv_eq_of_mul_eq_one_right hb

private lemma primaryFactor_eq_X_sub_C {K : Type} [Field K] {n f : ℕ} {h : UnitaryFieldData 2 f K}
    {d : GL (Fin n) K} (hd : d ∈ primeFormUnitary h (idGram K n))
    (hd3 : (d : GL (Fin n) K) ^ 3 = 1) {b : Polynomial K}
    (hb : b ∈ primaryFactors (toEnd d)) :
    ∃ ν : K, ν ^ 3 = 1 ∧ b = Polynomial.X - Polynomial.C ν :=
  CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_primaryFactor_eq ⟨d, hd⟩ (by simpa using hd3) hb

private lemma primaryProjection_eq_zero_of_orth {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {b : Polynomial K} (hb : b ∈ primaryFactors (toEnd d))
    (hdb : dualPoly h.bar b = b) {u : Fin n → K}
    (hu : ∀ w ∈ primaryComponent (toEnd d) b, idForm h n w u = 0) :
    primaryProjection (toEnd d) b u = 0 := by
  have hmem : primaryProjection (toEnd d) b u ∈ primaryComponent (toEnd d) b :=
    primaryProjection_mem H.squarefree hb u
  have hsep := CFSG.RankThree.PartOne.KCUnitary.separatingLeft_primaryComponent_selfDual H hb hdb
  have hzero : (⟨primaryProjection (toEnd d) b u, hmem⟩ :
      ↥(primaryComponent (toEnd d) b)) = 0 := by
    refine hsep _ fun w => ?_
    change idForm h n (primaryProjection (toEnd d) b u) (w : Fin n → K) = 0
    have hadj : CFSG.RankThree.PartOne.KCUnitary.hermAdjoint H.symm H.sep
        (primaryProjection (toEnd d) b) = primaryProjection (toEnd d) b := by
      change H.adj (primaryProjection (toEnd d) b) = primaryProjection (toEnd d) b
      rw [CFSG.RankThree.PartOne.KCUnitary.adj_primaryProjection H hb, hdb]
    have h1 := CFSG.RankThree.PartOne.KCUnitary.hermAdjoint_spec H.symm H.sep
      (primaryProjection (toEnd d) b) u (w : Fin n → K)
    rw [hadj, primaryProjection_of_mem H.squarefree hb w.2] at h1
    rw [h1]
    exact (H.symm.eq_iff).mpr (hu (w : Fin n → K) w.2)
  simpa using congrArg Subtype.val hzero

private lemma cubeSupp_of_mem_specialBlock {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (hd : d ∈ primeFormUnitary h (idGram K n)) (hq3 : 3 ∣ 2 ^ f + 1)
    {μ : K} (hμ : μ ^ 3 = 1) {g : GL (Fin n) K}
    (hg : Matrix.GeneralLinearGroup.toLin g ∈
      specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
        (Polynomial.X - Polynomial.C μ)) :
    ∀ ν : K, ν ^ 3 = 1 → ν ≠ μ → ∀ v ∈ cubeEigen d ν,
      ((g : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v = v := by
  intro ν hν hνμ v hv
  obtain ⟨horb, hgc, hdet⟩ := mem_specialBlock.mp hg
  have hdual := dualPoly_X_sub_C_of_cube h hq3 hμ
  have hv'' : toEnd d v = ν • v := Module.End.mem_eigenspace_iff.mp hv
  have hv' : v ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C ν) :=
    (CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_mem_primaryComponent_iff ⟨d, hd⟩ ν v).mpr hv''
  by_cases hmem : Polynomial.X - Polynomial.C ν ∈ primaryFactors (toEnd d)
  · have hnot : Polynomial.X - Polynomial.C ν ∉
        ({Polynomial.X - Polynomial.C μ,
          dualPoly h.bar (Polynomial.X - Polynomial.C μ)} : Set (Polynomial K)) := by
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨fun h' => hνμ (X_sub_C_injective h'),
        fun h' => hνμ (X_sub_C_injective (h'.trans hdual))⟩
    have hfix := horb.2 (Polynomial.X - Polynomial.C ν) hmem hnot v hv'
    rw [toEnd_mulVec g v] at hfix
    exact hfix
  · have hv0 : v = 0 := by
      by_contra hvne
      exact hmem (CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_mem_primaryFactors
        ⟨d, hd⟩ hv' hvne)
    simp [hv0]

private lemma mem_of_projZero {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {μ : K} {u : Fin n → K}
    (hu : ∀ c ∈ primaryFactors (toEnd d), c ≠ Polynomial.X - Polynomial.C μ →
        primaryProjection (toEnd d) c u = 0) :
    u ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C μ) := by
  have hsum := sum_primaryProjection (x := toEnd d) H.squarefree
  have h1 := LinearMap.congr_fun hsum u
  rw [LinearMap.sum_apply] at h1
  simp only [Module.End.one_apply] at h1
  rw [← h1]
  refine Submodule.sum_mem _ fun c hc => ?_
  by_cases hca : c = Polynomial.X - Polynomial.C μ
  · rw [hca] at hc ⊢
    exact primaryProjection_mem H.squarefree hc u
  · rw [hu c hc hca]
    exact Submodule.zero_mem _

private lemma fix_of_cubeSupp {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (hd : d ∈ primeFormUnitary h (idGram K n)) (hd3 : (d : GL (Fin n) K) ^ 3 = 1)
    {μ : K} {g : GL (Fin n) K}
    (hsupp : ∀ ν : K, ν ^ 3 = 1 → ν ≠ μ → ∀ v ∈ cubeEigen d ν,
      ((g : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v = v) :
    ∀ c ∈ primaryFactors (toEnd d), c ≠ Polynomial.X - Polynomial.C μ →
      ∀ w ∈ primaryComponent (toEnd d) c, (toEnd g) w = w := by
  intro c hc hcμ w hw
  obtain ⟨ν, hν, rfl⟩ := primaryFactor_eq_X_sub_C hd hd3 hc
  have hνμ : ν ≠ μ := fun h' => hcμ (by rw [h'])
  have hw'' : toEnd d w = ν • w :=
    (CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_mem_primaryComponent_iff ⟨d, hd⟩ ν w).mp hw
  have hw' : w ∈ cubeEigen d ν := Module.End.mem_eigenspace_iff.mpr hw''
  have hs := hsupp ν hν hνμ w hw'
  rw [toEnd_mulVec g w]
  exact hs

private lemma hid_aux {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K} (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {μ : K} (hμ : μ ^ 3 = 1) {g : GL (Fin n) K}
    (hfix : ∀ c ∈ primaryFactors (toEnd d), c ≠ Polynomial.X - Polynomial.C μ →
      ∀ w ∈ primaryComponent (toEnd d) c, (toEnd g) w = w)
    {v : Fin n → K}
    (hv : ∀ w ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C μ), idForm h n w v = 0) :
    (toEnd g) v = v := by
  have hsum := sum_primaryProjection (x := toEnd d) H.squarefree
  have h1 := LinearMap.congr_fun hsum v
  rw [LinearMap.sum_apply] at h1
  simp only [Module.End.one_apply] at h1
  calc (toEnd g) v
      = (toEnd g) (∑ c ∈ primaryFactors (toEnd d), primaryProjection (toEnd d) c v) := by
        conv_lhs => rw [← h1]
    _ = ∑ c ∈ primaryFactors (toEnd d), (toEnd g) (primaryProjection (toEnd d) c v) := by
        rw [map_sum]
    _ = ∑ c ∈ primaryFactors (toEnd d), primaryProjection (toEnd d) c v := by
        refine Finset.sum_congr rfl fun c hc => ?_
        by_cases hca : c = Polynomial.X - Polynomial.C μ
        · rw [hca] at hc ⊢
          have hP0 : primaryProjection (toEnd d) (Polynomial.X - Polynomial.C μ) v = 0 :=
            primaryProjection_eq_zero_of_orth H hc (dualPoly_X_sub_C_of_cube h hq3 hμ) hv
          rw [hP0, map_zero]
        · exact hfix c hc hca _ (primaryProjection_mem H.squarefree hc v)
    _ = v := h1

private lemma apply_mem_V_mu {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K} (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    (hd : d ∈ primeFormUnitary h (idGram K n)) (hd3 : (d : GL (Fin n) K) ^ 3 = 1)
    {μ : K} (hμ : μ ^ 3 = 1) {g : GL (Fin n) K}
    (hgU : Matrix.GeneralLinearGroup.toLin g ∈ sesqUnitaryGroup (idForm h n))
    (hfix : ∀ c ∈ primaryFactors (toEnd d), c ≠ Polynomial.X - Polynomial.C μ →
      ∀ w ∈ primaryComponent (toEnd d) c, (toEnd g) w = w)
    (hdD : Polynomial.X - Polynomial.C μ ∈ primaryFactors (toEnd d))
    {v : Fin n → K} (hv : v ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C μ)) :
    (toEnd g) v ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C μ) := by
  refine mem_of_projZero H fun c hc hcμ => ?_
  obtain ⟨ν, hν, rfl⟩ := primaryFactor_eq_X_sub_C hd hd3 hc
  have hνμ : ν ≠ μ := fun h' => hcμ (by rw [h'])
  refine primaryProjection_eq_zero_of_orth H hc (dualPoly_X_sub_C_of_cube h hq3 hν) ?_
  intro w hw
  have hgw : (toEnd g) w = w := hfix (Polynomial.X - Polynomial.C ν) hc hcμ w hw
  have hiso := (mem_sesqUnitaryGroup.mp hgU) w v
  rw [hgw] at hiso
  have horth : idForm h n w v = 0 :=
    CFSG.RankThree.PartOne.KCUnitary.orthogonal_of_ne_dualPoly H hc hdD
      (by rw [dualPoly_X_sub_C_of_cube h hq3 hν]
          exact fun h' => hνμ (X_sub_C_injective h').symm) hw hv
  rw [hiso, horth]

private lemma hcomm_aux {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K} (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    (hd : d ∈ primeFormUnitary h (idGram K n)) (hd3 : (d : GL (Fin n) K) ^ 3 = 1)
    {μ : K} (hμ : μ ^ 3 = 1) {g : GL (Fin n) K}
    (hgU : Matrix.GeneralLinearGroup.toLin g ∈ sesqUnitaryGroup (idForm h n))
    (hfix : ∀ c ∈ primaryFactors (toEnd d), c ≠ Polynomial.X - Polynomial.C μ →
      ∀ w ∈ primaryComponent (toEnd d) c, (toEnd g) w = w)
    (hdD : Polynomial.X - Polynomial.C μ ∈ primaryFactors (toEnd d)) :
    Commute (toEnd g) (toEnd d) := by
  rw [commute_iff_eq]
  refine ext_primaryComponent H.squarefree ?_
  intro b hb v hv
  change (toEnd g) ((toEnd d) v) = (toEnd d) ((toEnd g) v)
  obtain ⟨ν, hν, rfl⟩ := primaryFactor_eq_X_sub_C hd hd3 hb
  have hx : (toEnd d) v = ν • v :=
    (CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_mem_primaryComponent_iff ⟨d, hd⟩ ν v).mp hv
  by_cases hνμ : ν = μ
  · subst ν
    have hmem : (toEnd g) v ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C μ) :=
      apply_mem_V_mu hq3 H hd hd3 hμ hgU hfix hdD hv
    rw [hx, map_smul]
    rw [show (toEnd d) ((toEnd g) v) = μ • ((toEnd g) v) from
      (CFSG.HardMathSupport.Dickson.Sec6.I1431.u6r_mem_primaryComponent_iff ⟨d, hd⟩ μ
        ((toEnd g) v)).mp hmem]
  · have hgv : (toEnd g) v = v :=
      hfix (Polynomial.X - Polynomial.C ν) hb (fun h' => hνμ (X_sub_C_injective h')) v hv
    rw [hx, map_smul, hgv, hx]

private noncomputable def phiTrans {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K) :
    ↥(LargeEvenSUGroup (Fin n) K (2 ^ f)) →* ↥(gramSU h (idGram K n)) :=
  Subgroup.inclusion (largeEven_le_gramSU (n := n) h)

private noncomputable def phiTrans' {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K) :
    ↥(gramSU h (idGram K n)) →* ↥(LargeEvenSUGroup (Fin n) K (2 ^ f)) :=
  Subgroup.inclusion (gramSU_le_largeEven (n := n) h)

private lemma phiTrans_coe {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K)
    (y : ↥(LargeEvenSUGroup (Fin n) K (2 ^ f))) :
    ((phiTrans h y : ↥(gramSU h (idGram K n))) : GL (Fin n) K) = (y : GL (Fin n) K) := rfl

private lemma phiTrans'_coe {K : Type} [Field K] {n f : ℕ} (h : UnitaryFieldData 2 f K)
    (y : ↥(gramSU h (idGram K n))) :
    ((phiTrans' h y : ↥(LargeEvenSUGroup (Fin n) K (2 ^ f))) : GL (Fin n) K) =
      (y : GL (Fin n) K) := rfl

private lemma gramSU_to_sesqUnitary {K : Type} [Field K] {n f : ℕ} {h : UnitaryFieldData 2 f K}
    (g : ↥(gramSU h (idGram K n))) :
    Matrix.GeneralLinearGroup.toLin (g : GL (Fin n) K) ∈ sesqUnitaryGroup (idForm h n) :=
  (toLin_mem_sesqUnitaryGroup_iff (g : GL (Fin n) K)).mpr g.2.1

private lemma gramSU_det {K : Type} [Field K] {n f : ℕ} {h : UnitaryFieldData 2 f K}
    (g : ↥(gramSU h (idGram K n))) : LinearMap.det (toEnd (g : GL (Fin n) K)) = 1 := by
  change LinearMap.det (Matrix.toLin' ((g : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)) = 1
  rw [LinearMap.det_toLin']
  simpa using g.2.2

private lemma mem_specialBlock_of_cubeSupp {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (hd : d ∈ primeFormUnitary h (idGram K n))
    (hd3 : (d : GL (Fin n) K) ^ 3 = 1) (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {μ : K} (hμ : μ ^ 3 = 1) (hdD : Polynomial.X - Polynomial.C μ ∈ primaryFactors (toEnd d))
    {g : GL (Fin n) K}
    (hgU : Matrix.GeneralLinearGroup.toLin g ∈ sesqUnitaryGroup (idForm h n))
    (hdetg : LinearMap.det (toEnd g) = 1)
    (hsupp : ∀ ν : K, ν ^ 3 = 1 → ν ≠ μ → ∀ v ∈ cubeEigen d ν,
      ((g : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v = v) :
    Matrix.GeneralLinearGroup.toLin g ∈
      specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
        (Polynomial.X - Polynomial.C μ) := by
  have hfix := fix_of_cubeSupp hd hd3 hsupp
  have hcomm := hcomm_aux hq3 H hd hd3 hμ hgU hfix hdD
  have hid : ∀ v : Fin n → K,
      (∀ w ∈ primaryComponent (toEnd d) (Polynomial.X - Polynomial.C μ),
        idForm h n w v = 0) → (toEnd g) v = v :=
    fun v hv => hid_aux hq3 H hμ hfix hv
  exact CFSG.RankThree.PartOne.KCUnitaryBlock.mem_specialBlock_of_degree_one
    H (bar_mul_self_of_three_dvd h hq3 hμ) hdD hgU hcomm hid hdetg

private lemma mem_map_phiTrans_eigSub_iff {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K} {μ : K}
    (y : ↥(gramSU h (idGram K n))) :
    y ∈ (eigSub (2 ^ f) d μ).map (phiTrans h) ↔
      ∀ ν : K, ν ^ 3 = 1 → ν ≠ μ → ∀ v ∈ cubeEigen d ν,
        ((y : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v = v := by
  constructor
  · intro hy
    obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp hy
    have hyval : (y : GL (Fin n) K) = (x : GL (Fin n) K) := by
      rw [← hxy]
      exact phiTrans_coe h x
    intro ν hν hνμ v hv
    rw [hyval]
    exact hx ν hν hνμ v hv
  · intro hsupp
    refine Subgroup.mem_map.mpr ⟨phiTrans' h y, ?_, ?_⟩
    · intro ν hν hνμ v hv
      rw [phiTrans'_coe h y]
      exact hsupp ν hν hνμ v hv
    · exact Subtype.ext rfl

private lemma eq_one_of_fix_primaryComponent {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {g : GL (Fin n) K}
    (hfix : ∀ c ∈ primaryFactors (toEnd d),
      ∀ v ∈ primaryComponent (toEnd d) c, (toEnd g) v = v) :
    g = 1 := by
  have htoEnd : toEnd g = 1 :=
    CFSG.RankThree.PartOne.KCPrimary.ext_primaryComponent H.squarefree hfix
  have htoLin_one : Matrix.GeneralLinearGroup.toLin g =
      Matrix.GeneralLinearGroup.toLin 1 := by
    apply Units.ext
    simpa using htoEnd
  exact Matrix.GeneralLinearGroup.toLin.injective htoLin_one

private lemma mem_comap_toLinSU_specialBlock_iff {K : Type} [Field K] {n f : ℕ}
    {h : UnitaryFieldData 2 f K} {d : GL (Fin n) K}
    (hd : d ∈ primeFormUnitary h (idGram K n))
    (hd3 : (d : GL (Fin n) K) ^ 3 = 1) (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {μ : K} (hμ : μ ^ 3 = 1)
    (y : ↥(gramSU h (idGram K n))) :
    y ∈ (specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
          (Polynomial.X - Polynomial.C μ)).comap
        (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n) ↔
      ∀ ν : K, ν ^ 3 = 1 → ν ≠ μ → ∀ v ∈ cubeEigen d ν,
        ((y : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v = v := by
  constructor
  · intro hy
    have hmem := Subgroup.mem_comap.mp hy
    exact cubeSupp_of_mem_specialBlock hd hq3 hμ (g := (y : GL (Fin n) K)) hmem
  · intro hsupp
    by_cases hdD : Polynomial.X - Polynomial.C μ ∈ primaryFactors (toEnd d)
    · have hyB : Matrix.GeneralLinearGroup.toLin (y : GL (Fin n) K) ∈
          specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
            (Polynomial.X - Polynomial.C μ) :=
        mem_specialBlock_of_cubeSupp hd hd3 hq3 H hμ hdD
          (gramSU_to_sesqUnitary y) (gramSU_det y) hsupp
      refine Subgroup.mem_comap.mpr ?_
      exact hyB
    · have hfix := fix_of_cubeSupp hd hd3 hsupp
      have hg1 : (y : GL (Fin n) K) = 1 :=
        eq_one_of_fix_primaryComponent H fun c hc v hv =>
          hfix c hc (fun hca => hdD (hca ▸ hc)) v hv
      refine Subgroup.mem_comap.mpr ?_
      have hyg : y = 1 := by
        apply Subtype.ext
        exact hg1
      rw [hyg, map_one]
      exact Subgroup.one_mem _

private lemma uni_cube_specialBlock_eq_eigBlock_aux {K : Type} [Field K] {n f : ℕ}
    (h : UnitaryFieldData 2 f K) (hn : 1 ≤ n)
    {d : GL (Fin n) K} (hd : d ∈ primeFormUnitary h (idGram K n))
    (hd3 : (d : GL (Fin n) K) ^ 3 = 1) (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {μ : K} (hμ : μ ^ 3 = 1) :
    (eigBlock (2 ^ f) d μ).map
        (CFSG.StandardType.InndiagSU.projEquiv h hn).toMonoidHom =
      ((specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
          (Polynomial.X - Polynomial.C μ)).comap
        (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n)).map
        (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) := by
  have hSB : (eigSub (2 ^ f) d μ).map (phiTrans h) =
      (specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
          (Polynomial.X - Polynomial.C μ)).comap
        (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n) := by
    apply Subgroup.ext
    intro y
    exact (mem_map_phiTrans_eigSub_iff (d := d) (μ := μ) y).trans
      (mem_comap_toLinSU_specialBlock_iff hd hd3 hq3 H hμ y).symm
  have hpe : (CFSG.StandardType.InndiagSU.projEquiv h hn).toMonoidHom.comp
        (LargeEvenProjMk (LargeEvenSUGroup (Fin n) K (2 ^ f))) =
      (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)).comp (phiTrans h) := by
    ext g
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply, QuotientGroup.mk'_apply]
    change (CFSG.StandardType.InndiagSU.projEquiv h hn)
        (g : LargeEvenProj (LargeEvenSUGroup (Fin n) K (2 ^ f))) =
      (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) (phiTrans h g)
    rw [CFSG.StandardType.InndiagSU.projEquiv_mk, QuotientGroup.mk'_apply]
    exact congrArg (fun s : ↥(gramSU h (idGram K n)) => (s : primeFormP h (idGram K n)))
      (Subtype.ext rfl)
  calc (eigBlock (2 ^ f) d μ).map
          (CFSG.StandardType.InndiagSU.projEquiv h hn).toMonoidHom
      = ((eigSub (2 ^ f) d μ).map
          (LargeEvenProjMk (LargeEvenSUGroup (Fin n) K (2 ^ f)))).map
          (CFSG.StandardType.InndiagSU.projEquiv h hn).toMonoidHom := rfl
    _ = (eigSub (2 ^ f) d μ).map
          ((CFSG.StandardType.InndiagSU.projEquiv h hn).toMonoidHom.comp
            (LargeEvenProjMk (LargeEvenSUGroup (Fin n) K (2 ^ f)))) :=
        Subgroup.map_map _ _ _
    _ = (eigSub (2 ^ f) d μ).map
          ((QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)).comp
            (phiTrans h)) := by rw [hpe]
    _ = ((eigSub (2 ^ f) d μ).map (phiTrans h)).map
          (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) :=
        (Subgroup.map_map _ _ _).symm
    _ = ((specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
          (Polynomial.X - Polynomial.C μ)).comap
        (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n)).map
        (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) := by rw [hSB]

theorem uni_cube_specialBlock_eq_eigBlock {K : Type} [Field K] {n f : ℕ}
    (h : UnitaryFieldData 2 f K) (hn : 1 ≤ n)
    {d : GL (Fin n) K} (hd : d ∈ primeFormUnitary h (idGram K n))
    (hd3 : (d : GL (Fin n) K) ^ 3 = 1) (hq3 : 3 ∣ 2 ^ f + 1)
    (H : UnitaryPrimaryData h.bar (idForm h n) (Matrix.GeneralLinearGroup.toLin d))
    {μ : K} (hμ : μ ^ 3 = 1) :
    (eigBlock (2 ^ f) d μ).map
        (CFSG.StandardType.InndiagSU.projEquiv h hn).toMonoidHom =
      ((specialBlock (idForm h n) (Matrix.GeneralLinearGroup.toLin d)
          (Polynomial.X - Polynomial.C μ)).comap
        (CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_toLinSU h n)).map
        (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) := by
  exact uni_cube_specialBlock_eq_eigBlock_aux h hn hd hd3 hq3 H hμ

