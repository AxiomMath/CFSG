theorem ggG2_rawDatum
    {Y : Type} [Group Y] {k : Type} [Field k] [Finite k] {n : ℕ}
    (hn : 2 ≤ n) (hk : Nat.card k = 2 ^ n) (e : Y ≃* ↥(adjointGroup Tag.G2 k)) :
    LargeEvenRawDatum ⟨.G2, 0, n⟩ fun R₀ _ _ _ =>
      IsSimpleGroup R₀ ∧ (∃ a b : R₀, a * b ≠ b * a) ∧ Nonempty (Y ≃* R₀) := by
  have hk3 : 3 ≤ Nat.card k := by
    rw [hk]
    calc 3 ≤ 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hperf : Group.IsPerfect ↥(adjointGroup Tag.G2 k) :=
    ExcCopy.isPerfect_adjointGroup Tag.G2 k fun _ => hk3
  obtain ⟨hs, hnab⟩ := ExcCopy.isSimpleGroup_adjointGroup_of_perfect Tag.G2 k hperf
  have hZ : Subgroup.center ↥(adjointGroup Tag.G2 k) = ⊥ :=
    CFSG.LieType.Chevalley.center_adjointGroup_eq_bot
  obtain ⟨e₁⟩ := centerQuot_chevGroup_equiv k Tag.G2
  let e₂ : AdjointQuotient Tag.G2 k ≃* ↥(adjointGroup Tag.G2 k) :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  dsimp only [LargeEvenRawDatum]
  refine ⟨k, inferInstance, inferInstance, hk, ?_⟩
  haveI : IsSimpleGroup ↥(adjointGroup Tag.G2 k) := hs
  exact ⟨MulEquiv.isSimpleGroup (e₁.trans e₂),
    nonabelian_of_mulEquiv (e₁.trans e₂).symm hnab,
    ⟨e.trans (e₁.trans e₂).symm⟩⟩

theorem ggG2der_rawDatum
    {Y : Type} [Group Y] {k : Type} [Field k] [Finite k]
    (hk : Nat.card k = 2) (e : Y ≃* ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆) :
    LargeEvenRawDatum ⟨.G2der, 0, 1⟩ fun R₀ _ _ _ =>
      IsSimpleGroup R₀ ∧ (∃ a b : R₀, a * b ≠ b * a) ∧ Nonempty (Y ≃* R₀) := by
  obtain ⟨hDs, hDcard⟩ := ExcCopy.g2Two_derived_exc hk
  obtain ⟨eD⟩ := nonempty_commutator_subgroup_equiv (adjointGroup Tag.G2 k)
  haveI : IsSimpleGroup ↥(commutator ↥(adjointGroup Tag.G2 k)) := hDs
  haveI hDs' : IsSimpleGroup ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ :=
    MulEquiv.isSimpleGroup eD
  have hDnc : ∃ a b : ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆, a * b ≠ b * a := by
    by_contra hcon
    push Not at hcon
    letI : CommGroup ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ :=
      { (inferInstance : Group ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆) with
        mul_comm := hcon }
    have hp := IsSimpleGroup.prime_card
      (α := ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆)
    have hcardD : Nat.card ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ = 6048 := by
      rw [Nat.card_congr eD.toEquiv, hDcard]
    rw [hcardD] at hp
    exact absurd hp (by norm_num)
  have hZD : Subgroup.center ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
      (Subgroup.center ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆) with h | h
    · exact h
    · obtain ⟨a, b, hab⟩ := hDnc
      have ha : a ∈ Subgroup.center ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ := by
        rw [h]; exact Subgroup.mem_top a
      exact absurd (Subgroup.mem_center_iff.mp ha b).symm hab
  obtain ⟨e₁⟩ := centerQuot_commutator_chevGroup_equiv k Tag.G2
  let e₂ : DerivedCentralQuotient (adjointGroup Tag.G2 k) ≃*
      ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ :=
    (QuotientGroup.quotientMulEquivOfEq hZD).trans QuotientGroup.quotientBot
  dsimp only [LargeEvenRawDatum]
  refine ⟨k, inferInstance, inferInstance, hk, ?_⟩
  exact ⟨MulEquiv.isSimpleGroup (e₁.trans e₂),
    nonabelian_of_mulEquiv (e₁.trans e₂).symm hDnc,
    ⟨e.trans (e₁.trans e₂).symm⟩⟩

