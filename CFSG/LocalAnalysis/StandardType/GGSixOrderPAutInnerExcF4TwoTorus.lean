theorem dvd_add_one_and_not_dvd_sub_one_of_orderOf_eq_two {p q : ℕ} (hp : p.Prime) (hq : 1 ≤ q)
    (he : orderOf (q : ZMod p) = 2) : p ∣ q + 1 ∧ ¬ p ∣ q - 1 := by
  have : Fact p.Prime := ⟨hp⟩
  have hsq : (q : ZMod p) ^ 2 = 1 := by
    have := pow_orderOf_eq_one (q : ZMod p)
    rwa [he] at this
  have hne1 : (q : ZMod p) ≠ 1 := by
    intro h
    have h1 : orderOf (q : ZMod p) = 1 := orderOf_eq_one_iff.2 h
    omega
  have hz : (q : ZMod p) + 1 = 0 := by
    have hm : ((q : ZMod p) - 1) * ((q : ZMod p) + 1) = 0 := by linear_combination hsq
    exact (mul_eq_zero.mp hm).resolve_left (sub_ne_zero.mpr hne1)
  refine ⟨?_, ?_⟩
  · have h1 : ((q + 1 : ℕ) : ZMod p) = 0 := by push_cast; exact hz
    exact (ZMod.natCast_eq_zero_iff _ _).mp h1
  · intro h
    have h1 : ((q - 1 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr h
    rw [Nat.cast_sub hq, Nat.cast_one, sub_eq_zero] at h1
    exact hne1 h1

theorem factorization_sq_sub_one_of_orderOf_eq_two {p q : ℕ} (hp : p.Prime) (hq : 1 ≤ q)
    (he : orderOf (q : ZMod p) = 2) :
    (q ^ 2 - 1).factorization p = (q + 1).factorization p := by
  obtain ⟨-, hnd⟩ := dvd_add_one_and_not_dvd_sub_one_of_orderOf_eq_two hp hq he
  have hs : q ^ 2 - 1 = (q - 1) * (q + 1) := by
    obtain ⟨m, hm⟩ : ∃ m, q = m + 1 := ⟨q - 1, by omega⟩
    rw [hm]
    simp only [Nat.add_sub_cancel]
    zify [Nat.one_le_pow 2 (m + 1) (by omega)]
    ring
  have hq1 : q - 1 ≠ 0 := by
    intro h
    exact hnd (by rw [h]; exact dvd_zero p)
  have hq2 : q + 1 ≠ 0 := by omega
  rw [hs, Nat.factorization_mul hq1 hq2, Finsupp.add_apply,
    Nat.factorization_eq_zero_of_not_dvd hnd]
  simp

section F4Two


theorem factorization_card_adjointGroup_F4_of_orderOf_eq_two (K : Type) [Field K] [Finite K]
    {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (he : orderOf ((Nat.card K : ℕ) : ZMod p) = 2) :
    p ^ (Nat.card (adjointGroup Tag.F4 K)).factorization p =
      (p ^ (Nat.card K ^ 2 - 1).factorization p) ^ 4 := by
  have hq2 : 1 ≤ Nat.card K := Nat.card_pos
  obtain ⟨had, -⟩ := dvd_add_one_and_not_dvd_sub_one_of_orderOf_eq_two (p := p) hp hq2 he
  have hfac := factorization_sq_sub_one_of_orderOf_eq_two (p := p) hp hq2 he
  have hcard := CFSG.LieType.SeitzGeneration.ExcHigh.factorization_card_F4_of_dvd_add_one
    (K := K) hp (five_le_of_three_lt hp hp3) had
  rw [hcard, hfac, Nat.mul_comm 4, pow_mul]

theorem sylowTorus_F4_two (K : Type) [Field K] [Finite K] {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (he : orderOf ((Nat.card K : ℕ) : ZMod p) = 2) : SylowTorus (adjointGroup Tag.F4 K) p 4 := by
  classical
  have hMword : CFSG.RankThree.PartOne.KE.IsWeylMatrix Tag.F4 (wordMat Tag.F4 f4TwoWord) :=
    CFSG.RankThree.PartOne.KE.IsWeylMatrix.of_word Tag.F4 f4TwoWord
  set M := wordMat Tag.F4 f4TwoWord with hMdef
  have hM : CFSG.RankThree.PartOne.KE.IsWeylMatrix Tag.F4 M := by
    rw [hMdef]; exact hMword
  obtain ⟨w, hw⟩ := hM
  have : Fact p.Prime := ⟨hp⟩
  have : Fintype K := Fintype.ofFinite K
  have : Finite (ModGL Tag.F4 K) := finite_modGL
  obtain ⟨f, hℓ, hf⟩ := FiniteField.card K (ringChar K)
  have : Fact (ringChar K).Prime := ⟨hℓ⟩
  have hq : Nat.card K = ringChar K ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hf
  have : CharP K (ringChar K) := ringChar.charP K
  let L := AlgebraicClosure K
  have : CharP L (ringChar K) := charP_of_injective_algebraMap (algebraMap K L).injective _
  have : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  let Fr : L →+* L := iterateFrobenius L (ringChar K) (f : ℕ)
  have hFr : ∀ c, Fr c = c ^ Nat.card K := fun c => by
    rw [hq]
    exact iterateFrobenius_def (ringChar K) (f : ℕ) c
  have hℓq : ringChar K ∣ Nat.card K := by
    rw [hq]
    exact dvd_pow_self _ f.ne_zero
  have hq2 : 2 ≤ Nat.card K := Finite.one_lt_card
  have hpq : ¬ p ∣ Nat.card K := not_dvd_of_orderOf_pos hp he (by norm_num)
  obtain ⟨g0, hg0C, hg0⟩ := lang_conjugator Tag.F4 K (ℓ := ringChar K) (f := (f : ℕ)) f.pos L w
  let ι : adjointGroup Tag.F4 K →* ModGL Tag.F4 L :=
    (baseChangeGL (algebraMap K L)).comp (adjointGroup Tag.F4 K).subtype
  have hrange : ι.range = (adjointGroup Tag.F4 K).map (baseChangeGL (algebraMap K L)) := by
    change ((baseChangeGL (algebraMap K L)).comp (adjointGroup Tag.F4 K).subtype).range = _
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hι : Function.Injective ι :=
    (baseChangeGL_injective _).comp (Subgroup.subtype_injective _)
  have hT0 : twistedTorus (canonicalRep (coxeterSystem Tag.F4) L w) Fr =
      (fixedCharTuples M Fr).map (rootDiagUnitHom Tag.F4 L) := by
    ext x
    constructor
    · intro hx
      obtain ⟨a, rfl⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup (mem_twistedTorus.1 hx).1
      refine ⟨a, ?_, rfl⟩
      rw [← twistedFixedTuples_eq_fixedCharTuples hw Fr]
      exact mem_twistedFixedTuples_iff_conj.2 (mem_twistedTorus.1 hx).2
    · rintro ⟨a, ha, rfl⟩
      rw [← twistedFixedTuples_eq_fixedCharTuples hw Fr] at ha
      exact mem_twistedTorus.2 ⟨rootDiagUnit_mem_torusGroup a, mem_twistedFixedTuples_iff_conj.1 ha⟩
  have hcomm : IsMulCommutative (twistedTorusOf (canonicalRep (coxeterSystem Tag.F4) L w)
      (Units.map (entrywiseHom Fr))) := by
    show IsMulCommutative (twistedTorus (canonicalRep (coxeterSystem Tag.F4) L w) Fr)
    rw [hT0]
    exact isMulCommutative_map _ inferInstance
  set B : Matrix (Fin Tag.F4.rank) (Fin Tag.F4.rank) ℤ :=
    M - (Nat.card K : ℤ) • (1 : Matrix (Fin Tag.F4.rank) (Fin Tag.F4.rank) ℤ) with hB
  have hdetB : B.det.natAbs = (M.charpoly.eval (Nat.card K : ℤ)).natAbs :=
    (natAbs_eval_charpoly M _).symm
  have hchar : M.charpoly = cyclotomic 2 ℤ ^ 4 * 1 := by
    rw [hMdef, f4Two_charpoly]
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    ring
  have hpow : M ^ 2 = 1 := by rw [hMdef]; exact f4Two_pow
  have hn0 : (2 : ℕ) ≠ 0 := by norm_num
  have hn : ¬ p ∣ 2 := by
    intro h
    have hle := Nat.le_of_dvd (by norm_num) h
    omega
  have hR : ¬ (p : ℤ) ∣ (1 : ℤ[X]).eval (Nat.card K : ℤ) := by
    rw [Polynomial.eval_one]
    intro h
    exact hp.one_lt.ne' (Nat.dvd_one.1 (Int.natCast_dvd_natCast.1 h))
  have hpos : 0 < (cyclotomic 2 ℤ).eval (Nat.card K : ℤ) :=
    cyclotomic_pos' 2 (by exact_mod_cast hq2)
  have hRne : (1 : ℤ[X]).eval (Nat.card K : ℤ) ≠ 0 := by
    rw [Polynomial.eval_one]; exact one_ne_zero
  have hev : M.charpoly.eval (Nat.card K : ℤ) ≠ 0 := by
    rw [hchar, eval_mul, eval_pow]
    exact mul_ne_zero (pow_ne_zero 4 hpos.ne') hRne
  have hBne : B.det ≠ 0 := fun h => hev (Int.natAbs_eq_zero.1 (hdetB ▸ by rw [h]; rfl))
  have hcop := not_dvd_natAbs_det_sub hℓ hℓq M hn0 hpow
  have hcard : Nat.card (twistedTorusOf (canonicalRep (coxeterSystem Tag.F4) L w)
      (Units.map (entrywiseHom Fr))) = (M.charpoly.eval (Nat.card K : ℤ)).natAbs := by
    show Nat.card (twistedTorus (canonicalRep (coxeterSystem Tag.F4) L w) Fr) = _
    rw [hT0, Subgroup.card_map_of_injective rootDiagUnit_injective,
      natCard_fixedCharTuples M Fr hFr hBne hcop, hdetB]
  have hpℓ : p ≠ ringChar K := by
    intro h
    rw [← h] at hℓq
    exact hpq hℓq
  have htors : Nat.card (torsionSubgroup (twistedTorusOf (canonicalRep (coxeterSystem Tag.F4) L w)
      (Units.map (entrywiseHom Fr))) hcomm p) = p ^ 4 := by
    rw [natCard_torsion_eq (fixedCharTuples M Fr) _ hT0 hcomm p,
      natCard_fixedTorsion M Fr hℓ hFr hp hpℓ,
      natCard_solutions_modMat hp M 1 hpow hn hchar hpq he hR]
  have hord := factorization_card_adjointGroup_F4_of_orderOf_eq_two K hp hp3 he
  have hordN : p ^ (Nat.card (adjointGroup Tag.F4 K)).factorization p =
      p ^ ((M.charpoly.eval (Nat.card K : ℤ)).natAbs).factorization p := by
    rw [hord, hchar, ordProj_cyclotomic_pow_mul_eval hp hq2 he (by norm_num) hR]
  have hrat' : ∀ (X : Subgroup (ModGL Tag.F4 L)) [Finite X], X ≤ adjointGroup Tag.F4 L →
      (∀ x ∈ X, Units.map (entrywiseHom Fr) x = x) → ∀ P : Subgroup (ModGL Tag.F4 L), P ≤ X →
        IsPGroup p P → P ≤ ι.range := by
    intro X _ hXC hXF P hPX _
    rw [hrange]
    intro y hy
    have hXle : X ≤ (adjointGroup Tag.F4 K).map (baseChangeGL (algebraMap K L)) := by
      intro z hz
      rw [← (CFSG.RankThree.Chevalley.G2_F4_exact_finite_field_fixed_root_matrices Tag.F4
        (Or.inr rfl) K L Fr hFr).1]
      exact ⟨hXC hz, hXF z hz⟩
    exact hXle (hPX hy)
  exact sylowTorus_of_twisted_torus ι hι (Units.map (entrywiseHom Fr))
    (canonicalRep (coxeterSystem Tag.F4) L w) g0 hg0C hg0 hp (Int.natAbs_ne_zero.2 hev) hrat'
    hcomm hcard htors hordN

end F4Two

