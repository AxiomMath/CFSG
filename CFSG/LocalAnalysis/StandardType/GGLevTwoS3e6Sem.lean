@[expose] def levTwoS3e6_vec (n : ℕ) (v : List ℤ) : Fin n → ℤ := fun i => v.getD i.val 0

theorem levTwoS3e6_vec_ofFn (n : ℕ) (f : Fin n → ℤ) :
    levTwoS3e6_vec n (List.ofFn f) = f := by
  funext i
  simp [levTwoS3e6_vec, List.getElem_ofFn]

theorem levTwoS3e6_ofFn_vec (n : ℕ) {v : List ℤ} (hv : v.length = n) :
    List.ofFn (levTwoS3e6_vec n v) = v := by
  apply List.ext_getElem
  · simp [List.length_ofFn, hv]
  · intro i h1 h2
    simp only [levTwoS3e6_vec, List.getElem_ofFn]
    exact List.getD_eq_getElem v 0 h2

theorem levTwoS3e6_foldl_add_eq_sum : ∀ (l : List ℤ) (a : ℤ), l.foldl (· + ·) a = a + l.sum
  | [], a => by simp
  | b :: l, a => by
      rw [List.foldl_cons, levTwoS3e6_foldl_add_eq_sum l (a + b), List.sum_cons]
      ring

theorem levTwoS3e6_zipWith_ofFn (n : ℕ) (F : ℤ → ℤ → ℤ) (f g : Fin n → ℤ) :
    List.zipWith F (List.ofFn f) (List.ofFn g) = List.ofFn (fun i => F (f i) (g i)) := by
  apply List.ext_getElem
  · simp [List.length_zipWith]
  · intro i h1 h2
    rw [List.getElem_zipWith, List.getElem_ofFn, List.getElem_ofFn, List.getElem_ofFn]

theorem levTwoS3e6_dotv_ofFn (n : ℕ) (f g : Fin n → ℤ) :
    levTwoS3e6_dotv (List.ofFn f) (List.ofFn g) = ∑ i, f i * g i := by
  rw [levTwoS3e6_dotv, levTwoS3e6_zipWith_ofFn, levTwoS3e6_foldl_add_eq_sum, zero_add,
    List.sum_ofFn]

theorem levTwoS3e6_mulC_ofFn (v : Fin (Tag.rank Tag.E6) → ℤ) :
    levTwoS3e6_mulC (List.ofFn v) =
      List.ofFn (fun i : Fin (Tag.rank Tag.E6) =>
        ∑ j : Fin (Tag.rank Tag.E6), Tag.cartan Tag.E6 i j * v j) := by
  rw [levTwoS3e6_mulC, levTwoS3e6_cart_eq, List.map_ofFn]
  congr 1
  funext i
  exact levTwoS3e6_dotv_ofFn (Tag.rank Tag.E6) (fun j => Tag.cartan Tag.E6 i j) v

theorem levTwoS3e6_ipf_ofFn (g v : Fin (Tag.rank Tag.E6) → ℤ) :
    levTwoS3e6_ipf (List.ofFn g) (List.ofFn v) = g ⬝ᵥ (Tag.cartan Tag.E6).mulVec v := by
  rw [levTwoS3e6_ipf, levTwoS3e6_mulC_ofFn, levTwoS3e6_dotv_ofFn]
  rfl

theorem levTwoS3e6_symmetrizedCartan_eq : Tag.symmetrizedCartan Tag.E6 = Tag.cartan Tag.E6 := by
  decide +kernel

theorem levTwoS3e6_ipf_eq_iform (g v : Fin (Tag.rank Tag.E6) → ℤ) :
    levTwoS3e6_ipf (List.ofFn g) (List.ofFn v) = iform (τ := Tag.E6) g v := by
  rw [levTwoS3e6_ipf_ofFn, ← levTwoS3e6_symmetrizedCartan_eq]
  exact dotProduct_mulVec_eq_iform (τ := Tag.E6) g v

theorem levTwoS3e6_ipf_eq_iform_of_length {g v : List ℤ}
    (hg : g.length = Tag.rank Tag.E6) (hv : v.length = Tag.rank Tag.E6) :
    levTwoS3e6_ipf g v =
      iform (τ := Tag.E6) (levTwoS3e6_vec (Tag.rank Tag.E6) g) (levTwoS3e6_vec (Tag.rank Tag.E6) v) := by
  rw [← levTwoS3e6_ofFn_vec (Tag.rank Tag.E6) hg, ← levTwoS3e6_ofFn_vec (Tag.rank Tag.E6) hv]
  exact levTwoS3e6_ipf_eq_iform _ _

theorem levTwoS3e6_reflv_ofFn (g v : Fin (Tag.rank Tag.E6) → ℤ) :
    levTwoS3e6_reflv (List.ofFn g) (List.ofFn v) =
      List.ofFn (fun i => v i - levTwoS3e6_ipf (List.ofFn g) (List.ofFn v) * g i) := by
  dsimp only [levTwoS3e6_reflv]
  rw [levTwoS3e6_zipWith_ofFn]

theorem levTwoS3e6_vec_reflv {g v : List ℤ}
    (hg : g.length = Tag.rank Tag.E6) (hv : v.length = Tag.rank Tag.E6) :
    levTwoS3e6_vec (Tag.rank Tag.E6) (levTwoS3e6_reflv g v) =
      levTwoS3e6_vec (Tag.rank Tag.E6) v - levTwoS3e6_ipf g v • levTwoS3e6_vec (Tag.rank Tag.E6) g := by
  conv_lhs => rw [← levTwoS3e6_ofFn_vec (Tag.rank Tag.E6) hg, ← levTwoS3e6_ofFn_vec (Tag.rank Tag.E6) hv]
  conv_rhs => rw [← levTwoS3e6_ofFn_vec (Tag.rank Tag.E6) hg, ← levTwoS3e6_ofFn_vec (Tag.rank Tag.E6) hv]
  rw [levTwoS3e6_reflv_ofFn, levTwoS3e6_vec_ofFn, levTwoS3e6_vec_ofFn, levTwoS3e6_vec_ofFn]
  funext i
  simp [Pi.sub_apply]

theorem levTwoS3e6_e6_weylAction_reflv
    {g v : List ℤ} (hg : IsRoot Tag.E6 (levTwoS3e6_vec (Tag.rank Tag.E6) g))
    (_hv : IsRoot Tag.E6 (levTwoS3e6_vec (Tag.rank Tag.E6) v))
    (hg_len : g.length = Tag.rank Tag.E6) (hv_len : v.length = Tag.rank Tag.E6) :
    weylAction (isFiniteType_cartan Tag.E6)
        (rRefl (isFiniteType_cartan Tag.E6) (levTwoS3e6_vec (Tag.rank Tag.E6) g))
        (levTwoS3e6_vec (Tag.rank Tag.E6) v) =
      levTwoS3e6_vec (Tag.rank Tag.E6) (levTwoS3e6_reflv g v) := by
  simp only [levTwoS3a_rRefl_eq, levTwoS3a_weylAction_eq]
  rw [rootReflection_smul hg, corootPair_eq_iform (Or.inr (Or.inl rfl)) hg,
    ← levTwoS3e6_ipf_eq_iform_of_length hg_len hv_len, levTwoS3e6_vec_reflv hg_len hv_len]

