private theorem e6Levi_monomial_toral {L : Type} [Field L] [IsAlgClosed L] (hL : ringChar L ≠ 3)
    (a : Fin Tag.E6.rank → Lˣ) (ha : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard ∈ ({22, 24, 40} : Set ℕ))
    {X : Subgroup (ModGL Tag.E6 L)} (hab : ∀ x ∈ X, ∀ y ∈ X, x * y = y * x)
    (hexp : ∀ x ∈ X, x ^ 3 = 1) (hN : ∀ x ∈ X, x ∈ monomialSubgroup .E6 L)
    (hM : ∀ x ∈ X, x ∈ toralRootGroup .E6 L a) :
    ∃ g ∈ adjointGroup .E6 L, ∀ x ∈ X, g * x * g⁻¹ ∈ torusGroup .E6 L := by
  classical
  by_cases hall : ∀ x (hx : x ∈ X), weylQuotientHom .E6 L ⟨x, hN x hx⟩ = 1
  · exact ⟨1, one_mem _, fun x hx => by
      simpa using mem_torusGroup_of_weylQuotientHom_eq_one (hN x hx) (hall x hx)⟩
  push Not at hall
  obtain ⟨x₀, hx₀, hx₀1⟩ := hall
  have hWK : ∀ x (hx : x ∈ X), weylQuotientHom .E6 L ⟨x, hN x hx⟩ ∈ kernelReflectionGroup a :=
    fun x hx => d4t2tp_weyl_mem_kernelReflectionGroup (hN x hx) (hM x hx)
  have hW3 : ∀ x (hx : x ∈ X), weylQuotientHom .E6 L ⟨x, hN x hx⟩ ^ 3 = 1 :=
    fun x hx => weylQuotientHom_pow_eq_one (hN x hx) (hexp x hx)
  set A : Subgroup (ModGL Tag.E6 L) := X ⊓ torusGroup .E6 L with hA
  obtain ⟨g, hg, hgA, hgx₀⟩ := e6Levi_exists_conj_block_step hL
    (fun w hw h3 h1 => e6Levi_eq_pairRefl_of_pow_three a ha hk hw h3 h1) (hN x₀ hx₀)
    (hexp x₀ hx₀) (hWK x₀ hx₀) (A := A) inf_le_right (fun y hy => hab x₀ hx₀ y hy.1)
  refine ⟨g, hg, fun x hx => ?_⟩
  have hc : weylQuotientHom .E6 L ⟨x₀, hN x₀ hx₀⟩ * weylQuotientHom .E6 L ⟨x, hN x hx⟩ =
      weylQuotientHom .E6 L ⟨x, hN x hx⟩ * weylQuotientHom .E6 L ⟨x₀, hN x₀ hx₀⟩ := by
    rw [← map_mul, ← map_mul]
    exact congrArg _ (Subtype.ext (hab x₀ hx₀ x hx))
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.1
    ((e6Levi_pow_three_comm_mem_zpowers a ha hk (hWK x₀ hx₀) (hWK x hx) (hW3 x₀ hx₀)
      (hW3 x hx) hc).resolve_left hx₀1)
  have hyX : x₀ ^ (-i) * x ∈ X := mul_mem (zpow_mem hx₀ _) hx
  have hyN : x₀ ^ (-i) * x ∈ monomialSubgroup .E6 L := hN _ hyX
  have hy1 : weylQuotientHom .E6 L ⟨x₀ ^ (-i) * x, hyN⟩ = 1 := by
    have e : (⟨x₀ ^ (-i) * x, hyN⟩ : monomialSubgroup .E6 L) =
        (⟨x₀, hN x₀ hx₀⟩ : monomialSubgroup .E6 L) ^ (-i) * ⟨x, hN x hx⟩ := Subtype.ext (by simp)
    rw [e, map_mul, map_zpow, ← hi, zpow_neg, inv_mul_cancel]
  have hyA : x₀ ^ (-i) * x ∈ A := ⟨hyX, mem_torusGroup_of_weylQuotientHom_eq_one hyN hy1⟩
  have hgy : g * (x₀ ^ (-i) * x) * g⁻¹ = x₀ ^ (-i) * x := by
    rw [hgA _ hyA, mul_inv_cancel_right]
  have e : g * x * g⁻¹ = (g * x₀ * g⁻¹) ^ i * (g * (x₀ ^ (-i) * x) * g⁻¹) := by
    rw [conj_zpow]
    have hxx : x₀ ^ i * (x₀ ^ (-i) * x) = x := by
      rw [← mul_assoc, ← zpow_add, add_neg_cancel, zpow_zero, one_mul]
    calc g * x * g⁻¹ = g * (x₀ ^ i * (x₀ ^ (-i) * x)) * g⁻¹ := by rw [hxx]
      _ = _ := by group
  rw [e, hgy]
  exact mul_mem (zpow_mem hgx₀ i) hyA.2

theorem e6LeviThreeToralBar : E6LeviThreeToralBar := by
  classical
  intro L _ _ ℓ hℓp _ hℓ halg a ha hk X hX hXM
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hL3 : ringChar L ≠ 3 := by rw [ringChar.eq L ℓ]; exact hℓ
  have h3 : ((3 : ℕ) : L) ≠ 0 := fun h0 =>
    hℓ ((Nat.prime_dvd_prime_iff_eq hℓp.out Nat.prime_three).1
      ((CharP.cast_eq_zero_iff L ℓ 3).1 h0))
  have hXfin := e6ModGL_finite_of_isElemAbelian_three h3 hX
  have hXC : X ≤ toralCentralizer .E6 L a := hXM.trans (toralRootGroup_le a)
  have hXA : X ≤ adjointGroup .E6 L := fun x hx => (mem_toralCentralizer.1 (hXC hx)).1
  have hXd : ∀ x ∈ X, rootDiagUnit .E6 a * x = x * rootDiagUnit .E6 a := fun x hx =>
    mul_inv_eq_iff_eq_mul.1 (mem_toralCentralizer.1 (hXC hx)).2
  have hcomm : ∀ x ∈ X, ∀ y ∈ X, x * y = y * x := fun x hx y hy => hX.comm hx hy
  obtain ⟨z, hz, hzd, hzN⟩ :=
    exists_conj_le_monomial_centralizer_bar hℓ halg a hXA hXfin hXd hX.2
  have hzC : z ∈ toralCentralizer .E6 L a :=
    mem_toralCentralizer.2 ⟨hz, by rw [hzd, mul_inv_cancel_right]⟩
  have hCN : ∀ {x : ModGL Tag.E6 L}, x ∈ toralRootGroup .E6 L a →
      z * x * z⁻¹ ∈ toralRootGroup .E6 L a := fun hx =>
    (Subgroup.mem_normalizer_iff.1 (toralCentralizer_le_normalizer a hzC) _).1 hx
  obtain ⟨g, hg, hgX⟩ := e6Levi_monomial_toral hL3 a ha hk
    (X := X.map (MulAut.conj z).toMonoidHom)
    (by
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      calc z * x * z⁻¹ * (z * y * z⁻¹) = z * (x * y) * z⁻¹ := by group
        _ = z * (y * x) * z⁻¹ := by rw [hcomm x hx y hy]
        _ = z * y * z⁻¹ * (z * x * z⁻¹) := by group)
    (by
      rintro _ ⟨x, hx, rfl⟩
      exact conj_pow_eq_one' z (hX.2 x hx))
    (by
      rintro _ ⟨x, hx, rfl⟩
      exact hzN x hx)
    (by
      rintro _ ⟨x, hx, rfl⟩
      exact hCN (hXM hx))
  refine ⟨g * z, mul_mem hg hz, fun x hx => ?_⟩
  have h := hgX (z * x * z⁻¹) ⟨x, hx, rfl⟩
  rwa [show g * z * x * (g * z)⁻¹ = g * (z * x * z⁻¹) * g⁻¹ by group]

