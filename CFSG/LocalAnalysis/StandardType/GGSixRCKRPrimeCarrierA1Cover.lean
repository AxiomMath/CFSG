theorem rckA1_componentRoots_eq_pair {τ : Tag} {M : Type*} [CommGroup M]
    {χ : Multiplicative (Fin τ.rank → ℤ) →* M} (i : KernelComponent χ)
    (h1 : compRank (componentRoots χ i) = 1) :
    ∃ β : Fin τ.rank → ℤ, IsRoot τ β ∧ componentRoots χ i = {β, -β} := by
  classical
  have hΨ : IsRootComponent (componentRoots χ i) :=
    CFSG.LieType.Chevalley.isRootComponent_componentRoots i
  have hcard : (simpleRoots (componentRoots χ i)).card = 1 := by
    have h := h1
    rw [CFSG.HardMathSupport.Timmesfeld.RootAut.compRank_eq_card hΨ] at h
    exact h
  obtain ⟨β, hβcard⟩ := Finset.card_eq_one.1 hcard
  have hβmem : β ∈ simpleRoots (componentRoots χ i) := by
    rw [hβcard]
    exact Finset.mem_singleton_self β
  have hβroot : IsRoot τ β :=
    CFSG.LieType.Chevalley.simpleRoots_isRoot hβmem
  refine ⟨β, hβroot, ?_⟩
  ext α
  constructor
  · intro hα
    obtain ⟨c, e⟩ := CFSG.LieType.Chevalley.exists_coords hΨ hα
    rw [hβcard, Finset.sum_singleton] at e
    have hc : c β = 1 ∨ c β = -1 :=
      (hΨ.isRoot α hα).eq_one_or_neg_one_of_eq_smul e
    rcases hc with h | h
    · rw [h, one_smul] at e
      rw [e]
      exact Set.mem_insert β ({-β} : Set (Fin τ.rank → ℤ))
    · rw [h, neg_one_smul] at e
      rw [e]
      exact Set.mem_insert_of_mem _ rfl
  · intro hα
    rcases Set.mem_insert_iff.1 hα with rfl | hα
    · exact CFSG.LieType.Chevalley.simpleRoots_subset hβmem
    · rw [Set.mem_singleton_iff] at hα
      rw [hα]
      exact hΨ.neg_mem β (CFSG.LieType.Chevalley.simpleRoots_subset hβmem)

theorem rckA1_twistInner_pair {τ : Tag} {β : Fin τ.rank → ℤ} (hβ : IsRoot τ β)
    {σ : (Fin τ.rank → ℤ) → (Fin τ.rank → ℤ)} (hσ : σ '' {β, -β} = {β, -β})
    (hneg : σ (-β) = -σ β) :
    twistInner {β, -β} σ := by
  have hσβ : σ β ∈ ({β, -β} : Set (Fin τ.rank → ℤ)) :=
    hσ ▸ Set.mem_image_of_mem σ (Set.mem_insert β ({-β} : Set (Fin τ.rank → ℤ)))
  rcases Set.mem_insert_iff.1 hσβ with h | h
  · refine ⟨1, Subgroup.one_mem _, ?_⟩
    intro γ hγ
    rcases Set.mem_insert_iff.1 hγ with rfl | hγ
    · rw [h, one_smul]
    · rw [Set.mem_singleton_iff] at hγ
      rw [hγ, hneg, h, one_smul]
  · rw [Set.mem_singleton_iff] at h
    refine ⟨CFSG.LieType.Chevalley.rootReflection β, Subgroup.subset_closure
      ⟨β, Set.mem_insert β ({-β} : Set (Fin τ.rank → ℤ)), rfl⟩, ?_⟩
    intro γ hγ
    rcases Set.mem_insert_iff.1 hγ with rfl | hγ
    · rw [CFSG.LieType.Chevalley.rootReflection_smul_self hβ, h]
    · rw [Set.mem_singleton_iff] at hγ
      have hrefl : CFSG.LieType.Chevalley.rootReflection β • (-β) = β := by
        rw [← CFSG.LieType.Chevalley.rootReflection_neg hβ,
          CFSG.LieType.Chevalley.rootReflection_smul_self
            (CFSG.LieType.Chevalley.IsRoot.neg hβ), neg_neg]
      rw [hγ, hneg, h, neg_neg, hrefl]

end Roots

