theorem isPerfect_CQ_of_four_le_pow {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p : ℕ}
    (S : LangSetup τ L p) {a : Fin τ.rank → Lˣ} (i : KernelComponent (rootCharHom a)) {s : ℕ}
    (σ : L ≃+* L) (hσ : ∀ c, σ c = c ^ (S.D.q ^ s)) (hQ : 4 ≤ S.D.q ^ s) :
    Group.IsPerfect ↥(CQ σ i) := by
  classical
  obtain ⟨r, e, hr, hchar, he, hq⟩ := exists_char_pow S
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : CharP L r := hchar
  have hs : 0 < s := by
    by_contra h0
    have h0' : s = 0 := by omega
    rw [h0', pow_zero] at hQ
    omega
  have hσ' : ∀ c : L, σ c = c ^ (r ^ (e * s)) := fun c => by
    rw [hσ, hq, ← pow_mul]
  have hQ' : 4 ≤ r ^ (e * s) := by
    rw [pow_mul, ← hq]
    exact hQ
  obtain ⟨t, ht⟩ := CFSG.HardMathSupport.Timmesfeld.LangTorus.exists_unit_sq_ne_one
    (L := L) σ hσ' (Nat.mul_pos he hs) hQ'
  have hperfC : Group.IsPerfect
      ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.isPerfect_componentRootSpan_of_sq_ne_one
      (K := fixSubfield σ) (χ := rootCharHom a) ht i
  rw [CFSG.HardMathSupport.Timmesfeld.LangTorus.CQ_eq_map
    (χ := rootCharHom a) (i := i) σ]
  exact Group.IsPerfect.ofSurjective
    (f := (Subgroup.equivMapOfInjective
      (componentRootSpan (fixSubfield σ) (rootCharHom a) i)
      (baseChangeGL (fixSubfield σ).subtype)
      (CFSG.LieType.Chevalley.baseChangeGL_injective (fixSubfield σ).subtype)).toMonoidHom)
    (Subgroup.equivMapOfInjective
      (componentRootSpan (fixSubfield σ) (rootCharHom a) i)
      (baseChangeGL (fixSubfield σ).subtype)
      (CFSG.LieType.Chevalley.baseChangeGL_injective (fixSubfield σ).subtype)).surjective

theorem rckA1_mem_CQ_of_commute {τ : Tag} {L : Type} [Field L] [CharP L 2] {M : Type*}
    [CommGroup M] {χ : Multiplicative (Fin τ.rank → ℤ) →* M} (i : KernelComponent χ)
    {β : Fin τ.rank → ℤ} (hΨ : componentRoots χ i = {β, -β}) (σ : L ≃+* L) {g : ModGL τ L}
    (hg : g ∈ rootSpan τ L (componentRoots χ i))
    (hc : ∀ x ∈ rootSpan τ L (componentRoots χ i),
      x * (frobGL σ g * g⁻¹) = (frobGL σ g * g⁻¹) * x) :
    g ∈ CQ σ i := by
  classical
  have hβmem : β ∈ componentRoots χ i := by
    rw [hΨ]
    exact Set.mem_insert β ({-β} : Set (Fin τ.rank → ℤ))
  have hβ : IsRoot τ β := CFSG.LieType.Chevalley.isRoot_of_mem_componentRoots hβmem
  have hspan : rootSpan τ L (componentRoots χ i) = (rootSL2 τ L β).range := by
    rw [hΨ, CFSG.LieType.HighestRoot.rootSpan_pair_eq,
      CFSG.RankThree.Chevalley.range_rootSL2_of_isRoot hβ]
  rw [hspan] at hg
  obtain ⟨A, rfl⟩ := hg
  set C : Matrix.SpecialLinearGroup (Fin 2) L :=
    Matrix.SpecialLinearGroup.map σ.toRingHom A * A⁻¹ with hCdef
  have hcentral : C ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) L) := by
    rw [Subgroup.mem_center_iff]
    intro B
    apply CFSG.RankThree.Chevalley.rootSL2_injective_of_field (K := L) β
    have hx : rootSL2 τ L β B ∈ rootSpan τ L (componentRoots χ i) := by
      rw [hspan]
      exact ⟨B, rfl⟩
    have hcomm := hc (rootSL2 τ L β B) hx
    have hcval : frobGL σ (rootSL2 τ L β A) * (rootSL2 τ L β A)⁻¹ =
        rootSL2 τ L β C := by
      rw [CFSG.RankThree.Chevalley.entrywise_rootSL2_of_field σ.toRingHom β A]
      rw [hCdef, map_mul, map_inv]
    rw [hcval] at hcomm
    simpa only [map_mul] using hcomm
  obtain ⟨r, hr2, hrC⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hcentral
  have hr2' : r ^ 2 = 1 := by simpa using hr2
  have hr1 : r = 1 := by
    have hsq : (r - 1) ^ 2 = 0 := by
      have h2 : (2 : L) = 0 := CharP.cast_eq_zero L 2
      calc (r - 1) ^ 2 = r ^ 2 - 2 * r + 1 := by ring
        _ = 1 - 2 * r + 1 := by rw [hr2']
        _ = 0 := by linear_combination (1 - r) * h2
    have h0 : r - 1 = 0 := sq_eq_zero_iff.mp hsq
    exact sub_eq_zero.mp h0
  have hC1 : C = 1 := by
    apply Subtype.ext
    rw [← hrC, hr1]
    simp
  rw [hCdef] at hC1
  have hmapA : Matrix.SpecialLinearGroup.map σ.toRingHom A = A :=
    mul_inv_eq_one.mp hC1
  have hfix : ∀ i j, σ ((A : Matrix (Fin 2) (Fin 2) L) i j) =
      (A : Matrix (Fin 2) (Fin 2) L) i j := by
    intro i j
    have h := congrArg (fun X : Matrix.SpecialLinearGroup (Fin 2) L =>
      (X : Matrix (Fin 2) (Fin 2) L) i j) hmapA
    simpa using h
  obtain ⟨A₀, hA₀⟩ : ∃ A₀ : Matrix.SpecialLinearGroup (Fin 2) ↥(fixSubfield σ),
      Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype A₀ = A := by
    choose g hg using fun i j =>
      (⟨⟨(A : Matrix (Fin 2) (Fin 2) L) i j, (mem_fixSubfield σ).2 (hfix i j)⟩, rfl⟩ :
        ∃ k : ↥(fixSubfield σ), (fixSubfield σ).subtype k =
          (A : Matrix (Fin 2) (Fin 2) L) i j)
    have hdet : (Matrix.of g).det = 1 := by
      apply (fixSubfield σ).subtype_injective
      rw [RingHom.map_det, map_one]
      have hmap : (fixSubfield σ).subtype.mapMatrix (Matrix.of g) =
          (A : Matrix (Fin 2) (Fin 2) L) := by
        ext i j
        exact hg i j
      rw [hmap, A.2]
    exact ⟨⟨Matrix.of g, hdet⟩, by
      ext i j
      exact hg i j⟩
  have hC : componentRootSpan (fixSubfield σ) χ i =
      (rootSL2 τ (fixSubfield σ) β).range := by
    rw [CFSG.RankThree.Chevalley.range_rootSL2_of_isRoot hβ]
    show rootSpan τ (fixSubfield σ) (componentRoots χ i) = _
    rw [hΨ]
    simp only [rootSpan, iSup_insert, iSup_singleton]
  have hx : rootSL2 τ (fixSubfield σ) β A₀ ∈ componentRootSpan (fixSubfield σ) χ i := by
    rw [hC]
    exact ⟨A₀, rfl⟩
  have heq : baseChangeGL (fixSubfield σ).subtype (rootSL2 τ (fixSubfield σ) β A₀) =
      rootSL2 τ L β A := by
    rw [CFSG.RankThree.Chevalley.baseChangeGL_rootSL2_of_field, hA₀]
  rw [CFSG.HardMathSupport.Timmesfeld.LangTorus.CQ_eq_map (χ := χ) (i := i) σ]
  rw [← heq]
  exact Subgroup.mem_map_of_mem (baseChangeGL (fixSubfield σ).subtype) hx

theorem rckA1_exists_cover {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p : ℕ}
    (S : LangSetup τ L p) {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {β : Fin τ.rank → ℤ}
    (hΨ : componentRoots (rootCharHom a) i = {β, -β}) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    (σ : L ≃+* L) (hσ : ∀ c, σ c = c ^ (S.D.q ^ s)) {z : ModGL τ L}
    (hnorm : ∀ j : KernelComponent (rootCharHom a), ∀ g : ModGL τ L,
      g ∈ rootSpan τ L (componentRoots (rootCharHom a) j) ↔
        z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) j))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    {h : ℕ} (hq : S.D.q = 2 ^ h)
    (hqs : CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    2 ≤ h * s ∧
      ∃ φ : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 (h * s)) →* ModGL τ L,
        φ.range = rationalComponent S.ρ S.Γ (rootCharHom a) i ∧
          φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 (h * s))) := by
  classical
  obtain ⟨r, e, hr, hchar, he, hqr⟩ := exists_char_pow S
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : CharP L r := hchar
  have hs0 : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  have hσ' : ∀ c : L, σ c = c ^ (r ^ (e * s)) := fun c => by
    rw [hσ, hqr, ← pow_mul]
  obtain ⟨hfinK, hKcard⟩ := exists_fixSubfield_fintype S hs0 hσ
  haveI : Finite (fixSubfield σ) := hfinK
  have hsL : ∃ u : Lˣ, u ^ 2 ≠ 1 := by
    obtain ⟨c, hc⟩ := Infinite.exists_notMem_finset ({0, 1, -1} : Finset L)
    have hc0 : c ≠ 0 := fun h => hc (by simp [h])
    refine ⟨Units.mk0 c hc0, fun h => hc ?_⟩
    have h2 : c ^ 2 = 1 := by simpa using congrArg (fun x : Lˣ => (x : L)) h
    have h3 : (c - 1) * (c + 1) = 0 := by linear_combination h2
    rcases mul_eq_zero.1 h3 with h | h
    · simp [sub_eq_zero.1 h]
    · simp [eq_neg_of_add_eq_zero_left h]
  obtain ⟨f, hf1, hker, hf2⟩ :=
    rationalComponent_eq_range_componentRootSpanT S hT i hs hmin σ z hnorm hz hsL
  have hβmem : β ∈ componentRoots (rootCharHom a) i := by
    rw [hΨ]
    exact Set.mem_insert β ({-β} : Set (Fin τ.rank → ℤ))
  have hβ : IsRoot τ β := CFSG.LieType.Chevalley.isRoot_of_mem_componentRoots hβmem
  have hC : componentRootSpan (fixSubfield σ) (rootCharHom a) i =
      (rootSL2 τ (fixSubfield σ) β).range := by
    rw [CFSG.RankThree.Chevalley.range_rootSL2_of_isRoot hβ]
    show rootSpan τ (fixSubfield σ) (componentRoots (rootCharHom a) i) = _
    rw [hΨ]
    simp only [rootSpan, iSup_insert, iSup_singleton]
  let eSL : Matrix.SpecialLinearGroup (Fin 2) ↥(fixSubfield σ) ≃*
      ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
    (MonoidHom.ofInjective (CFSG.RankThree.Chevalley.rootSL2_injective_of_field
      (K := ↥(fixSubfield σ)) β)).trans (MulEquiv.subgroupCongr hC.symm)
  by_cases h2 : 2 ≤ h * s
  · refine ⟨h2, ?_⟩
    have hQ : 4 ≤ S.D.q ^ s := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ (h * s) := Nat.pow_le_pow_right (by norm_num) h2
        _ = S.D.q ^ s := by rw [hq, ← pow_mul]
    have hQ' : 4 ≤ r ^ (e * s) := by
      rw [pow_mul, ← hqr]
      exact hQ
    obtain ⟨t, ht⟩ := CFSG.HardMathSupport.Timmesfeld.LangTorus.exists_unit_sq_ne_one
      (L := L) σ hσ' (Nat.mul_pos he hs0) hQ'
    have hperfC : Group.IsPerfect
        ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
      CFSG.HardMathSupport.Timmesfeld.CrossChar.isPerfect_componentRootSpan_of_sq_ne_one
        (K := fixSubfield σ) (χ := rootCharHom a) ht i
    have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
      le_antisymm (hf2 (Subgroup.isPerfect_iff.1 hperfC)) hf1
    haveI : Fintype ↥(fixSubfield σ) := Fintype.ofFinite _
    haveI : Fintype (GaloisField 2 (h * s)) := Fintype.ofFinite _
    have hG : Nat.card (GaloisField 2 (h * s)) = 2 ^ (h * s) :=
      GaloisField.card 2 (h * s) (by omega)
    have hF : Nat.card ↥(fixSubfield σ) = 2 ^ (h * s) := by
      rw [hKcard, hq, ← pow_mul]
    have hG' : Fintype.card (GaloisField 2 (h * s)) = 2 ^ (h * s) := by
      rw [← Nat.card_eq_fintype_card]
      exact hG
    have hF' : Fintype.card ↥(fixSubfield σ) = 2 ^ (h * s) := by
      rw [← Nat.card_eq_fintype_card]
      exact hF
    have hcard : Fintype.card (GaloisField 2 (h * s)) = Fintype.card ↥(fixSubfield σ) := by
      rw [hG', hF']
    let κ : GaloisField 2 (h * s) ≃+* ↥(fixSubfield σ) :=
      FiniteField.ringEquivOfCardEq hcard
    let eκ : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 (h * s)) ≃*
        Matrix.SpecialLinearGroup (Fin 2) ↥(fixSubfield σ) :=
      { toFun := Matrix.SpecialLinearGroup.map κ.toRingHom
        invFun := Matrix.SpecialLinearGroup.map κ.symm.toRingHom
        left_inv := fun A => by
          apply Subtype.ext
          ext i j
          change κ.symm (κ ((A : Matrix (Fin 2) (Fin 2) (GaloisField 2 (h * s))) i j)) =
            (A : Matrix (Fin 2) (Fin 2) (GaloisField 2 (h * s))) i j
          exact κ.symm_apply_apply _
        right_inv := fun B => by
          apply Subtype.ext
          ext i j
          change ((κ (κ.symm ((B : Matrix (Fin 2) (Fin 2) ↥(fixSubfield σ)) i j)) :
            ↥(fixSubfield σ)) : L) =
            (((B : Matrix (Fin 2) (Fin 2) ↥(fixSubfield σ)) i j : ↥(fixSubfield σ)) : L)
          rw [κ.apply_symm_apply]
        map_mul' := fun A B => map_mul (Matrix.SpecialLinearGroup.map κ.toRingHom) A B }
    let e : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 (h * s)) ≃*
        ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) := eκ.trans eSL
    refine ⟨f.comp e.toMonoidHom, ?_, ?_⟩
    · rw [← MonoidHom.map_range f e.toMonoidHom,
        MonoidHom.range_eq_top_of_surjective e.toMonoidHom e.surjective,
        Subgroup.map_top]
      exact hRf
    · exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.ker_comp_mulEquiv_le_center
        e f hker
  · exfalso
    have hle : h * s ≤ 1 := by omega
    have hKle : Nat.card (fixSubfield σ) ≤ 3 := by
      rw [hKcard]
      calc S.D.q ^ s = 2 ^ (h * s) := by rw [hq, ← pow_mul]
        _ ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) hle
        _ ≤ 3 := by norm_num
    haveI : Group.IsSolvable (Matrix.SpecialLinearGroup (Fin 2) ↥(fixSubfield σ)) :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.isSolvable_specialLinear_two_of_card_le_three
        hKle
    haveI : Group.IsSolvable ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
      Group.isSolvable_of_isSolvable_injective (f := eSL.symm.toMonoidHom)
        eSL.symm.injective
    haveI : Group.IsSolvable ↥f.range :=
      Group.isSolvable_of_surjective (f := f.rangeRestrict) f.rangeRestrict_surjective
    haveI : Group.IsSolvable ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
      Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hf1)
    exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.not_isSolvable_of_isQuasisimple
      hqs inferInstance

end Cover

