theorem statedClassicalModel_rationalComponent_a5t1 {K : Type} [Field K] [Finite K]
    {σ : K ≃+* K} {q : ℕ} {h : twistedE6InndiagGL K σ} (D : TwE6LineLang K σ q h)
    (h3q : 3 ∣ q + 1) (hdim : twE6MatFixDim K σ h = 36)
    (i : KernelComponent (rootCharHom D.a)) :
    StatedClassicalModel
      (↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i) ⧸
        Subgroup.center ↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i))
      .PSU 6 (ringChar K) D.e := by
  classical
  have h30 : (kernelRoots (rootCharHom D.a)).ncard = 30 := by
    have hker := D.hker
    omega
  obtain ⟨m, hm, v, ψ₀, σ₀, hψ₀, hn₀, hΨ₀, -, hS1⟩ :=
    KSConn.conn_class_data D.hL3 D.hap (Or.inr h30) i
  have hψ := hψ₀.transport v
  have hnorm : ∀ x y, x ≠ y → iform (v • σ₀ x y) (v • σ₀ x y) = 2 := fun x y hxy => by
    rw [CFSG.LieType.Chevalley.iform_smul]
    exact hn₀ x y hxy
  have hΨ : componentRoots (rootCharHom D.a) i = frameRoots (fun x y => v • σ₀ x y) := by
    rw [hΨ₀, IsSLFrame.frameRoots_smul]
  rcases hm with rfl | rfl | rfl
  ·
    have h22 := (hS1 rfl).2.2
    omega
  ·
    exfalso
    have h20 : (componentRoots (rootCharHom D.a) i).ncard = 20 := by
      have hc := CFSG.LocalAnalysis.GLTheoremA.kd147c_frameRoots_ncard hψ one_ne_zero
        fun x y hxy => (hnorm x y hxy).trans (mul_one 2).symm
      rw [← hΨ] at hc
      omega
    have hsub : ∀ k, componentRoots (rootCharHom D.a) k ⊆ kernelRoots (rootCharHom D.a) :=
      fun k γ hγ => hγ.1
    by_cases hone : ∀ k : KernelComponent (rootCharHom D.a), k = i
    · have heq : kernelRoots (rootCharHom D.a) = componentRoots (rootCharHom D.a) i :=
        Set.Subset.antisymm (fun α hα => ⟨hα, hone _⟩) (hsub i)
      rw [heq] at h30
      omega
    obtain ⟨j, hji⟩ := not_forall.1 hone
    have hcl := kernel_classes_le_two D.hL3 D.hap (by omega) i j
    have heq : kernelRoots (rootCharHom D.a) =
        componentRoots (rootCharHom D.a) i ∪ componentRoots (rootCharHom D.a) j := by
      refine Set.Subset.antisymm (fun α hα => ?_) (Set.union_subset (hsub i) (hsub j))
      rcases hcl ⟦⟨α, hα⟩⟧ with hc | hc | hc
      · exact absurd hc.symm hji
      · exact Or.inl ⟨hα, hc.symm⟩
      · exact Or.inr ⟨hα, hc.symm⟩
    have hdisj : Disjoint (componentRoots (rootCharHom D.a) i)
        (componentRoots (rootCharHom D.a) j) :=
      Set.disjoint_left.2 fun α ⟨_, hαi⟩ ⟨_, hαj⟩ => hji (hαj.symm.trans hαi)
    have hfin : (kernelRoots (rootCharHom D.a)).Finite :=
      (CFSG.Blueprint.Chevalley.finite_setOf_isRoot Tag.E6).subset fun γ hγ => hγ.1
    have hcard := Set.ncard_union_eq hdisj (hfin.subset (hsub i)) (hfin.subset (hsub j))
    rw [← heq, h30, h20] at hcard
    rcases (TwE6UniqAbs.kac_facts D.hL3 D.hap).sizes j with hc | hc | hc <;> omega
  ·
    obtain ⟨t, ht, Fr, hFr, hΦ0⟩ := D.hS
    obtain rfl : t = .E6 := by
      cases t
      · rfl
      · exact absurd ht (by decide)
    have hΦ : D.S.D.Φ = twistHom TwistTag.E6 (AlgebraicClosure K) Fr :=
      MonoidHom.ext fun g => (hΦ0 g).trans rfl
    have h3q' : 3 ∣ D.S.D.q + 1 := by
      rw [D.hSq, ← D.hqe]
      exact h3q
    obtain ⟨u, hu, hρ⟩ := KSConn.exists_rho_neg_weyl_of_conn D.S hFr hΦ D.hT D.hap h3q'
      (by rw [h30]; simp)
    obtain ⟨π, hπ1⟩ := KSConn.exists_unitary_perm_of_rho_eq_neg i hψ hnorm hΨ D.S.ρ hu hρ
    have hstab : ∀ γ ∈ componentRoots (rootCharHom D.a) i,
        D.S.ρ γ ∈ componentRoots (rootCharHom D.a) i := by
      intro γ hγ
      rw [hΨ] at hγ ⊢
      obtain ⟨x, y, hxy, rfl⟩ := hγ
      exact ⟨π y, π x, fun hyx => hxy (π.injective hyx).symm, hπ1 x y hxy⟩
    have hfin : (componentRoots (rootCharHom D.a) i).Finite :=
      (CFSG.Blueprint.Chevalley.finite_setOf_isRoot Tag.E6).subset fun γ hγ => hγ.1.1
    have hs1 := componentOrbitLength_eq_one hfin hstab
    have hπ : ∀ x y, x ≠ y → (D.S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[componentOrbitLength D.S.ρ
        (componentRoots (rootCharHom D.a) i)] (v • σ₀ x y) = v • σ₀ (π y) (π x) :=
      fun x y hxy => by
        rw [hs1, Function.iterate_one]
        exact hπ1 x y hxy
    have hmodel := KSExact.rationalComponent_suN_model D.S D.hT i (ν := 5 + 1) (by norm_num) hψ
      hΨ π hπ D.hℓ D.hchar D.he D.hSq (by simp)
    rw [hs1, Nat.mul_one] at hmodel
    exact hmodel

