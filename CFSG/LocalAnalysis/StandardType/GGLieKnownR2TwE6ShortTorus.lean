private theorem l10se2b2_rad_centralizer
    {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 2 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f))
    {μ : (fixedSubfield θ)ˣ} (hμ : μ ≠ 1) :
    ∀ x ∈ (twE6Rad θ).map (CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ),
      x * CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ (twE6LevelTorus θ μ) =
        CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ (twE6LevelTorus θ μ) * x →
      x = 1 := by
  have hθ : ∀ c, θ (θ c) = c := CFSG.SeitzReduction.F4Pilot.involutive_of_natCard_eq hK hσ
  have hf1 : 1 ≤ f := by omega
  haveI : Finite ↥(e6Data_valid.minGroup k) :=
    CFSG.ClassicalInvolution.ModelFacts.ChevAut.finite_minGroup e6Data_valid k
  haveI : Finite (fixedGroup k θ) := Subtype.finite
  intro x hx hxt
  obtain ⟨y, hy, rfl⟩ := hx
  have hle : twE6Rad θ ≤ (twE6Rad θ).comap (MulAut.conj (twE6LevelTorus θ μ)).toMonoidHom := by
    rw [twE6Rad, ggSub]
    refine iSup₂_le fun γ hγ z hz => ?_
    rw [Subgroup.mem_comap]
    have h1 : twE6LevelTorus θ μ * z * (twE6LevelTorus θ μ)⁻¹ ∈ (twistedDatum k θ).rootGroup γ :=
      ((Subgroup.mem_normalizer_iff.1 (twE6LevelTorus_mem_normalizer θ hθ μ hγ.1)) z).1 hz
    exact (le_iSup₂_of_le γ hγ le_rfl :
      (twistedDatum k θ).rootGroup γ ≤ ⨆ γ ∈ _, (twistedDatum k θ).rootGroup γ) h1
  set T := twE6LevelTorus θ μ with hTdef
  have hc : y * T * y⁻¹ * T⁻¹ ∈ twE6Rad θ := by
    have h1 : T * y⁻¹ * T⁻¹ ∈ twE6Rad θ := hle (Subgroup.inv_mem _ hy)
    have e : y * T * y⁻¹ * T⁻¹ = y * (T * y⁻¹ * T⁻¹) := by group
    rw [e]
    exact Subgroup.mul_mem _ hy h1
  have hck : y * T * y⁻¹ * T⁻¹ ∈ (CFSG.SeitzReduction.F4Pilot.twistedIsogenyC hf1 hK θ hσ).ker := by
    rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, map_inv, hxt]
    group
  have hcZ : y * T * y⁻¹ * T⁻¹ ∈ Subgroup.center (fixedGroup k θ) := by
    rw [← CFSG.SeitzReduction.F4Pilot.ker_twistedIsogenyC hf1 hK θ hσ]
    exact hck
  obtain ⟨m, hm⟩ := (isPGroup_two_twE6Rad θ hθ) ⟨_, hc⟩
  have hm' : (y * T * y⁻¹ * T⁻¹) ^ 2 ^ m = 1 := by
    have h := congrArg Subtype.val hm
    simpa using h
  have hdvd1 : orderOf (y * T * y⁻¹ * T⁻¹) ∣ 2 ^ m := orderOf_dvd_of_pow_eq_one hm'
  have hdvd2 : orderOf (y * T * y⁻¹ * T⁻¹) ∣ Nat.card (Subgroup.center (fixedGroup k θ)) :=
    Subgroup.orderOf_dvd_natCard _ hcZ
  have hodd : Odd (Nat.card (Subgroup.center (fixedGroup k θ))) := by
    rw [(CFSG.LieType.Steinberg.CentralExt.TwistedE6Closed.card_center_fixedGroup
      (θ := θ) (q := 2 ^ f) hK hσ).1]
    rcases (Nat.dvd_prime Nat.prime_three).1 (Nat.gcd_dvd_left 3 (2 ^ f + 1)) with h | h
    · rw [h]; norm_num
    · rw [h]; norm_num
  have hcop : Nat.Coprime (Nat.card (Subgroup.center (fixedGroup k θ))) (2 ^ m) :=
    (Nat.coprime_two_right.2 hodd).pow_right m
  have hc1 : y * T * y⁻¹ * T⁻¹ = 1 :=
    orderOf_eq_one_iff.1 (Nat.eq_one_of_dvd_coprimes hcop hdvd2 hdvd1)
  have hyT : T * y = y * T := by
    calc T * y = (y * T * y⁻¹ * T⁻¹)⁻¹ * (y * T) := by group
      _ = y * T := by rw [hc1, inv_one, one_mul]
  rw [twE6Rad_eq_one_of_commute_levelTorus θ hθ hμ hy hyT, map_one]

private theorem l10se2b2_pinnedX_mem
    {k : Type} [Field k] [CharP k 2] (θ : k →+* k) {γ : Fin Tag.E6.rank → ℤ}
    (hγ : γ ∈ twE6ShortCoreRoots) :
    pinnedX TwistTag.E6.tag k γ 1 ∈ graphFixedRootGroup TwistTag.E6 k θ := by
  obtain ⟨hr, hh, hρ, -⟩ := l10se2b2_root_facts hγ
  have hρ' : permLattice TwistTag.E6.perm γ = γ := hρ
  have h2 : (2 : k) = 0 := CharP.cast_eq_zero k 2
  show _ ∈ graphFixedPosUnipotent TwistTag.E6 k θ ⊔ graphFixedNegUnipotent TwistTag.E6 k θ
  refine Subgroup.mem_sup_left (Subgroup.mem_inf.2 ⟨?_, ?_⟩)
  · exact rootSpan_le_posUnipotent (S := {γ})
      (fun α hα => by rw [Set.mem_singleton_iff.1 hα]; exact ⟨mem_rootFinset.1 hr, hh⟩)
      (pinnedX_mem_rootSpan (Set.mem_singleton γ) 1)
  · refine (mem_twistedFixedGroup_iff_twistHom TwistTag.E6 k θ).2
      ⟨pinnedX_mem_adjointGroup _ _, ?_⟩
    rw [CFSG.LieType.Chevalley.E6GraphRadical.twistHom_pinnedX_of_two h2 θ (mem_rootFinset.1 hr) 1,
      hρ', map_one]

private theorem l10se2b2_exists_mu
    {f : ℕ} {k : Type} [Field k] [Finite k] (hf : 2 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f)) :
    ∃ μ : (fixedSubfield θ)ˣ, μ ≠ 1 := by
  have hF : Nat.card (fixedSubfield θ) = 2 ^ f := card_fixedSubfield_of_card θ hK hσ
  have : Finite (fixedSubfield θ) := Subtype.finite
  have h1 : 1 < Nat.card (fixedSubfield θ)ˣ := by
    rw [Nat.card_units, hF]
    have : 4 ≤ 2 ^ f := le_trans (by norm_num) (Nat.pow_le_pow_right (by norm_num) hf)
    omega
  have : Nontrivial (fixedSubfield θ)ˣ := Finite.one_lt_card_iff_nontrivial.1 h1
  exact exists_ne 1

theorem twE6_short_levelTorus_adj
    {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 2 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f)) :
    ∃ t : graphFixedRootGroup TwistTag.E6 k θ,
      t ∈ Subgroup.normalizer
        ((((twistedDatum k θ).rootGroup twE6Alpha).map
          (CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ) :
          Subgroup (graphFixedRootGroup TwistTag.E6 k θ)) :
          Set (graphFixedRootGroup TwistTag.E6 k θ)) ∧
      (∀ x ∈ (twE6Rad θ).map (CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ),
        x * t = t * x → x = 1) ∧
      (∀ γ ∈ twE6ShortCoreRoots,
        pinnedX TwistTag.E6.tag k γ 1 ∈ graphFixedRootGroup TwistTag.E6 k θ) ∧
