private theorem l10se2b2_mem_core {γ : Fin Tag.E6.rank → ℤ}
    (hγ : γ ∈ twE6ShortCoreRoots) : γ = l10se2b2_e1 ∨ γ = l10se2b2_e3 ∨ γ = l10se2b2_r := hγ

private theorem l10se2b2_root_facts
    {γ : Fin Tag.E6.rank → ℤ} (hγ : γ ∈ twE6ShortCoreRoots) :
    γ ∈ rootFinset .E6 ∧ 0 < height (τ := Tag.E6) γ ∧ rho γ = γ ∧ γ 0 = 0 ∧ γ 5 = 0 ∧
      γ ≠ l10se2b2_a ∧ γ ≠ -l10se2b2_a ∧ γ + l10se2b2_a ∉ rootFinset .E6 ∧
      γ ≠ rho l10se2b2_a ∧ γ ≠ -rho l10se2b2_a ∧ γ + rho l10se2b2_a ∉ rootFinset .E6 := by
  rcases l10se2b2_mem_core hγ with rfl | rfl | rfl <;>
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide +kernel

private theorem l10se2b2_a_facts :
    IsRoot .E6 l10se2b2_a ∧ proj l10se2b2_a = twE6Alpha ∧ rho l10se2b2_a ≠ l10se2b2_a := by
  refine ⟨mem_rootFinset.1 (by decide +kernel), by decide +kernel, by decide +kernel⟩

private theorem l10se2b2_mem_normalizer_of_forall {G : Type*} [Group G] [Finite G]
    {X : Subgroup G} {z : G} (h : ∀ x ∈ X, z * x * z⁻¹ ∈ X) :
    z ∈ Subgroup.normalizer (X : Set G) := by
  have hle : X.map (MulAut.conj z).toMonoidHom ≤ X := by
    rintro _ ⟨x, hx, rfl⟩
    exact h x hx
  have heq : X.map (MulAut.conj z).toMonoidHom = X :=
    Subgroup.eq_of_le_of_card_ge hle
      (by rw [Subgroup.card_map_of_injective (MulAut.conj z).injective])
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨h x, fun hx => ?_⟩
  rw [← heq] at hx
  obtain ⟨x', hx', hxx'⟩ := hx
  have e : x' = x := by
    have e1 : z * x' * z⁻¹ = z * x * z⁻¹ := hxx'
    simpa using e1
  rwa [← e]

private theorem l10se2b2_coe_pi_xPair
    {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 2 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f))
    (hθ : ∀ c, θ (θ c) = c) (c : k) :
    ((CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ
      (xPair θ hθ l10se2b2_a_facts.1 l10se2b2_a_facts.2.2 c) :
        graphFixedRootGroup TwistTag.E6 k θ) :
        ModGL TwistTag.E6.tag k) =
      pinnedX TwistTag.E6.tag k l10se2b2_a c *
        pinnedX TwistTag.E6.tag k (rho l10se2b2_a) (θ c) := by
  rw [CFSG.SeitzReduction.F4Pilot.coe_twistedIsogenyC]
  change ((CFSG.LieType.Steinberg.Isogeny.e6Isogeny k
      ((xPair θ hθ l10se2b2_a_facts.1 l10se2b2_a_facts.2.2 c : fixedGroup k θ) :
        e6Data_valid.minGroup k) : adjointGroup .E6 k) : ModGL .E6 k) = _
  have hs : ((twistSign l10se2b2_a : ℤ) : k) = 1 := by
    rcases twistSign_eq_one_or l10se2b2_a with h | h
    · rw [h, Int.cast_one]
    · rw [h, Int.cast_neg, Int.cast_one, CharTwo.neg_eq]
  rw [xPair_val, map_mul, Subgroup.coe_mul,
    CFSG.SeitzReduction.E6Pilot.coe_e6Isogeny_xm l10se2b2_a_facts.1,
    CFSG.SeitzReduction.E6Pilot.coe_e6Isogeny_xm (isRoot_rho l10se2b2_a_facts.1), hs, one_mul]
  rfl

private theorem l10se2b2_diag_conj
    {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 2 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f))
    (hθ : ∀ c, θ (θ c) = c) {z : graphFixedRootGroup TwistTag.E6 k θ} {b : Fin Tag.E6.rank → kˣ}
    (hz : (z : ModGL TwistTag.E6.tag k) = rootDiagUnit TwistTag.E6.tag b) (c : k) :
    z * CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ
        (xPair θ hθ l10se2b2_a_facts.1 l10se2b2_a_facts.2.2 c) * z⁻¹ =
      CFSG.SeitzReduction.F4Pilot.twistedIsogenyC (by omega) hK θ hσ
        (xPair θ hθ l10se2b2_a_facts.1 l10se2b2_a_facts.2.2
          ((rootChar b l10se2b2_a : k) * c)) := by
  apply Subtype.ext
  rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv, hz, l10se2b2_coe_pi_xPair hf hK θ hσ hθ,
    l10se2b2_coe_pi_xPair hf hK θ hσ hθ]
  have hr := l10se2b2_a_facts.1
  have hzF : twistHom TwistTag.E6 k θ (rootDiagUnit TwistTag.E6.tag b) =
      rootDiagUnit TwistTag.E6.tag b := by
    have h := ((mem_twistedFixedGroup_iff_twistHom TwistTag.E6 k θ).1
      (graphFixedRootGroup_le TwistTag.E6 k θ z.2)).2
    rwa [hz] at h
  have hb : ∀ i, b (TwistTag.E6.perm i) = Units.map θ.toMonoidHom (b i) :=
    compat_of_twistHom_rootDiagUnit hzF
  have hχ : rootChar (τ := TwistTag.E6.tag) b (rho l10se2b2_a) =
      Units.map θ.toMonoidHom (rootChar (τ := TwistTag.E6.tag) b l10se2b2_a) := by
    refine (rootChar_permLattice (τ := TwistTag.E6.tag) b TwistTag.E6.perm l10se2b2_a).trans ?_
    simp only [hb, rootChar, map_prod, map_zpow]
  have e : ∀ d P Q : ModGL TwistTag.E6.tag k, d * (P * Q) * d⁻¹ = (d * P * d⁻¹) * (d * Q * d⁻¹) :=
    fun d P Q => by group
  rw [e, rootDiagUnit_conj_pinnedX (τ := TwistTag.E6.tag) b hr,
    rootDiagUnit_conj_pinnedX (τ := TwistTag.E6.tag) b (isRoot_rho hr), hχ, Units.coe_map,
    map_mul θ]
  rfl

private theorem l10se2b2_root_commute
    {k : Type} [Field k] {γ : Fin Tag.E6.rank → ℤ} (hγ : γ ∈ twE6ShortCoreRoots)
    (c : k) :
    Commute (pinnedX TwistTag.E6.tag k γ 1) (pinnedX TwistTag.E6.tag k l10se2b2_a c) ∧
      Commute (pinnedX TwistTag.E6.tag k γ 1) (pinnedX TwistTag.E6.tag k (rho l10se2b2_a) c) := by
  obtain ⟨hr, -, -, -, -, h1, h2, h3, h4, h5, h6⟩ := l10se2b2_root_facts hγ
  have hA : IsRoot TwistTag.E6.tag l10se2b2_a := l10se2b2_a_facts.1
  have hA' : IsRoot TwistTag.E6.tag (rho l10se2b2_a) := isRoot_rho l10se2b2_a_facts.1
  exact ⟨CFSG.LieType.Chevalley.E6GraphLevi.commute_pinnedX_of_not_isRoot
      (mem_rootFinset.1 hr) hA h1 h2 (fun h => h3 (mem_rootFinset.2 h)) 1 c,
    CFSG.LieType.Chevalley.E6GraphLevi.commute_pinnedX_of_not_isRoot
      (mem_rootFinset.1 hr) hA' h4 h5 (fun h => h6 (mem_rootFinset.2 h)) 1 c⟩

private theorem l10se2b2_prod_zpow {G : Type*} [CommGroup G] {ι : Type*} (t : Finset ι)
    (y : G) (e : ι → ℤ) : (∏ i ∈ t, y ^ e i) = y ^ (∑ i ∈ t, e i) := by
  classical
  refine Finset.induction_on t ?_ ?_
  · simp
  · intro a t ha ih
    rw [Finset.prod_insert ha, Finset.sum_insert ha, zpow_add, ih]

