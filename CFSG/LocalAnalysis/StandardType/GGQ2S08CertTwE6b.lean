theorem e6b_certOK : certOK e6bGens (xLast 5) e6bSets e6bPats e6bReps e6bS2 = true := by
  decide +kernel

theorem e6b_cov : dCovB 5 e6bPats = true := by
  decide +kernel

theorem e6b_refl : reflCertB e6bGens e6bCerts = true := by
  decide +kernel

theorem e6b_frame : dFrameB 5 e6bCerts = true := by
  decide +kernel

@[expose] def e6bS (k : Fin 6) : Vn 6 ≃ₗ[ZMod 3] Vn 6 := letLin (letAt e6bGens k)

theorem e6b_S (k : Fin 6) : e6bS k = letLin (letAt e6bGens k) := rfl

theorem e6b_test : ∀ A Mg : Subgroup (Vn 6 ≃ₗ[ZMod 3] Vn 6),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 6 => e6bS k)) (xLast 5) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 5) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 5) t → t ∈ Mg :=
  linTest_dframe_of_certOK (by norm_num) _ e6bGens rfl e6b_S e6b_refl e6b_frame e6b_certOK e6b_cov

