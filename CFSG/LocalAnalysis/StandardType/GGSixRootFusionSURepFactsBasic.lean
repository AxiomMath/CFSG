variable {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F} {n : ℕ} {G : Type} [Group G]
  {ψ : SU σ n →* G}

theorem ggInvSU_mul_self_of_le {l : ℕ} (h : 2 * l ≤ n) : ggInvSU σ n l * ggInvSU σ n l = 1 := by
  apply Subtype.ext
  apply Units.ext
  rw [Subgroup.coe_mul, Units.val_mul, coe_ggInvSU σ h, Subgroup.coe_one, Units.val_one]
  exact ggInvUMatrix_mul_self _ _

theorem eq_one_of_mem_center_SU_of_two_pow {z : SU σ n} (hz : z ∈ Subgroup.center (SU σ n))
    {k : ℕ} (hk : z ^ 2 ^ k = 1) : z = 1 :=
  eq_one_of_pow_two_pow_eq_one_of_forall (K := Subgroup.center (SU σ n))
    (fun _ hz hz2 => eq_one_of_mem_center_SU_of_sq_eq_one σ hz hz2) k z hz hk

theorem commute_of_map_commute_SU (hker : ψ.ker ≤ Subgroup.center (SU σ n))
    {u g : SU σ n} (hu : u * u = 1) (h : ψ g * ψ u = ψ u * ψ g) : g * u = u * g := by
  set z := g * u * g⁻¹ * u⁻¹ with hz
  have hzk : z ∈ ψ.ker := by
    rw [MonoidHom.mem_ker, hz, map_mul, map_mul, map_mul, map_inv, map_inv]
    calc ψ g * ψ u * (ψ g)⁻¹ * (ψ u)⁻¹ = (ψ g * ψ u) * (ψ g)⁻¹ * (ψ u)⁻¹ := rfl
      _ = (ψ u * ψ g) * (ψ g)⁻¹ * (ψ u)⁻¹ := by rw [h]
      _ = 1 := by group
  have hzc := hker hzk
  have hzu : u * z = z * u := Subgroup.mem_center_iff.mp hzc u
  have h1 : g * u * g⁻¹ = z * u := by rw [hz]; group
  have h2 : z ^ 2 = 1 := by
    calc z ^ 2 = z * z * (u * u) := by rw [hu, mul_one, sq]
      _ = (z * u) * (z * u) := by
          rw [show (z * u) * (z * u) = z * (u * z) * u by group, hzu]; group
      _ = (g * u * g⁻¹) * (g * u * g⁻¹) := by rw [h1]
      _ = g * (u * u) * g⁻¹ := by group
      _ = 1 := by rw [hu]; group
  have hz1 : z = 1 := eq_one_of_mem_center_SU_of_sq_eq_one σ hzc h2
  rw [hz] at hz1
  calc g * u = g * u * g⁻¹ * u⁻¹ * (u * g) := by group
    _ = u * g := by rw [hz1, one_mul]

theorem ordProj_two_card_map_SU [Finite F] (hker : ψ.ker ≤ Subgroup.center (SU σ n))
    (X : Subgroup (SU σ n)) :
    ordProj[2] (Nat.card (X.map ψ)) = ordProj[2] (Nat.card X) := by
  set φ := ψ.comp X.subtype with hφ
  have hrange : φ.range = X.map ψ := by rw [hφ, MonoidHom.range_comp, Subgroup.range_subtype]
  have hsplit := Subgroup.card_ker_mul_card_range φ
  have hk1 : ordProj[2] (Nat.card φ.ker) = 1 := by
    refine SLAlpha.ordProj_two_card_eq_one fun y hy => ?_
    have hy' : ((y : X) : SU σ n) ^ 2 = 1 := by
      have := congrArg (fun t : φ.ker => ((t : X) : SU σ n)) hy
      simpa using this
    have hyk : ((y : X) : SU σ n) ∈ ψ.ker := y.2
    exact Subtype.ext (Subtype.ext (eq_one_of_mem_center_SU_of_sq_eq_one σ (hker hyk) hy'))
  have hX0 : Nat.card X ≠ 0 := Nat.card_pos.ne'
  have h0 : Nat.card φ.range ≠ 0 := fun h => hX0 (by rw [← hsplit, h, mul_zero])
  have h0' : Nat.card φ.ker ≠ 0 := fun h => hX0 (by rw [← hsplit, h, zero_mul])
  rw [← hrange, ← hsplit, Nat.ordProj_mul 2 h0' h0, hk1, one_mul]

omit [CharP F 2] in
theorem finite_of_le_range_SU [Finite F] {K : Subgroup G} (hK : K ≤ ψ.range) : Finite K := by
  have : Finite ψ.range := Finite.of_surjective ψ.rangeRestrict ψ.rangeRestrict_surjective
  exact Finite.of_injective (Subgroup.inclusion hK) (Subgroup.inclusion_injective hK)

theorem eq_of_map_eq_of_isPGroup_SU (hker : ψ.ker ≤ Subgroup.center (SU σ n))
    {X : Subgroup (SU σ n)} (hX : IsPGroup 2 X) {x y : SU σ n} (hx : x ∈ X) (hy : y ∈ X)
    (hxy : ψ x = ψ y) : x = y := by
  have hm : x * y⁻¹ ∈ X := mul_mem hx (inv_mem hy)
  have hk : x * y⁻¹ ∈ ψ.ker := by rw [MonoidHom.mem_ker, map_mul, map_inv, hxy, mul_inv_cancel]
  obtain ⟨k, hk2⟩ := hX ⟨_, hm⟩
  have h2 : (x * y⁻¹) ^ 2 ^ k = 1 := by
    have := congrArg Subtype.val hk2
    simpa using this
  exact mul_inv_eq_one.mp (eq_one_of_mem_center_SU_of_two_pow (hker hk) h2)

theorem card_map_of_isPGroup_SU (hker : ψ.ker ≤ Subgroup.center (SU σ n))
    {X : Subgroup (SU σ n)} (hX : IsPGroup 2 X) : Nat.card (X.map ψ) = Nat.card X := by
  refine (Nat.card_congr (Equiv.ofBijective (fun x : X => (⟨ψ x, x, x.2, rfl⟩ : X.map ψ))
    ⟨fun x y hxy => ?_, ?_⟩)).symm
  · exact Subtype.ext (eq_of_map_eq_of_isPGroup_SU hker hX x.2 y.2 (congrArg Subtype.val hxy))
  · rintro ⟨_, x, hx, rfl⟩
    exact ⟨⟨x, hx⟩, rfl⟩

end Transfer

theorem odd_unitaryFactor {a j : ℕ} (ha : 1 ≤ a) (hj : 1 ≤ j) :
    Odd (CFSG.SeitzReduction.LinearPilot.unitaryFactor (2 ^ a) j) := by
  have hev : Even ((2 ^ a) ^ j) := (even_two.pow_of_ne_zero (by omega)).pow_of_ne_zero (by omega)
  have hpos : 1 ≤ (2 ^ a) ^ j := Nat.one_le_pow _ _ (by positivity)
  unfold CFSG.SeitzReduction.LinearPilot.unitaryFactor
  split_ifs
  · exact Nat.Even.sub_odd hpos hev odd_one
  · exact hev.add_one

theorem ordProj_two_card_SU_six {F : Type} [Field F] [Finite F] [CharP F 2] {a : ℕ} (ha : 1 ≤ a)
    (hF : Nat.card F = (2 ^ a) ^ 2) :
    ordProj[2] (Nat.card (SU (unitaryInvolution F 2 a) 6)) = 2 ^ (15 * a) := by
  have h : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 a F :=
    ⟨Nat.prime_two, ha, by rw [hF, ← pow_mul, mul_comm]⟩
  rw [Nat.card_congr (equivStatedSU hF 6).toEquiv]
  have hc := CFSG.SeitzReduction.LinearPilot.card_unitarySU_eq_nat (n := 6) h (by norm_num)
  change ordProj[2] (Nat.card (CFSG.ClassicalGroups.UnitaryFlag.unitarySU 2 a F 6)) = _
  rw [hc]
  have hodd : Odd (∏ j ∈ Finset.Icc 2 6, CFSG.SeitzReduction.LinearPilot.unitaryFactor (2 ^ a) j) :=
    Finset.prod_induction _ Odd (fun _ _ h1 h2 => h1.mul h2) odd_one
      fun j hj => odd_unitaryFactor ha (by simp at hj; omega)
  rw [Nat.factorization_mul (by positivity) hodd.pos.ne', Finsupp.add_apply,
    Nat.factorization_eq_zero_of_not_dvd (fun h2 => (Nat.not_even_iff_odd.mpr hodd)
      (even_iff_two_dvd.mpr h2)), add_zero, ← pow_mul, Nat.factorization_pow,
    Finsupp.smul_apply, Nat.Prime.factorization_self Nat.prime_two, smul_eq_mul, mul_one]
  congr 1
  norm_num
  ring

