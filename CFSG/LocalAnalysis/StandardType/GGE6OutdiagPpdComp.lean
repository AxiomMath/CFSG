private theorem exists_restrict_of_mem_kernelReflectionGroup
    {L : Type} [Field L] {a : Fin Tag.E6.rank → Lˣ} {v : WeylGroup Tag.E6}
    (hv : v ∈ kernelReflectionGroup a) (i : KernelComponent (rootCharHom a)) :
    ∃ u ∈ Subgroup.closure {s : WeylGroup Tag.E6 |
        ∃ γ ∈ componentRoots (rootCharHom a) i, s = rootReflection γ},
      ∀ β ∈ componentRoots (rootCharHom a) i, v • β = u • β := by
  classical
  have hcomp := isRootComponent_componentRoots i
  set W := Subgroup.closure {s : WeylGroup Tag.E6 |
    ∃ γ ∈ componentRoots (rootCharHom a) i, s = rootReflection γ} with hW
  have hpres : ∀ u ∈ W, ∀ β ∈ componentRoots (rootCharHom a) i,
      u • β ∈ componentRoots (rootCharHom a) i := by
    intro u hu
    induction hu using Subgroup.closure_induction'' with
    | mem s hs =>
      obtain ⟨γ, hγ, rfl⟩ := hs
      exact fun β hβ => hcomp.reflection_mem β hβ γ hγ
    | inv_mem s hs =>
      obtain ⟨γ, hγ, rfl⟩ := hs
      intro β hβ
      rw [rootReflection_inv (hcomp.isRoot γ hγ)]
      exact hcomp.reflection_mem β hβ γ hγ
    | one => intro β hβ; rwa [one_smul]
    | mul x y _ _ hx hy => intro β hβ; rw [mul_smul]; exact hx _ (hy β hβ)
  have hgen : ∀ γ ∈ rootCharKernel a, ∃ u ∈ W, ∀ β ∈ componentRoots (rootCharHom a) i,
      rootReflection γ • β = u • β := by
    intro γ hγ
    have hγk : γ ∈ kernelRoots (rootCharHom a) := hγ
    by_cases hγi : (⟦⟨γ, hγk⟩⟧ : KernelComponent (rootCharHom a)) = i
    · exact ⟨rootReflection γ, Subgroup.subset_closure ⟨γ, ⟨hγk, hγi⟩, rfl⟩, fun β _ => rfl⟩
    · refine ⟨1, W.one_mem, fun β hβ => ?_⟩
      obtain ⟨hβk, hβi⟩ := hβ
      have hne : (⟦⟨γ, hγk⟩⟧ : KernelComponent (rootCharHom a)) ≠ ⟦⟨β, hβk⟩⟧ := by
        rw [hβi]
        exact hγi
      rw [one_smul]
      exact rootReflection_smul_of_iform_eq_zero hγ.1 (iform_eq_zero_of_mk_ne hne)
  rw [CFSG.RankThree.Chevalley.kernelReflectionGroup_eq_closure_rootReflection] at hv
  induction hv using Subgroup.closure_induction'' with
  | mem s hs =>
    obtain ⟨γ, hγ, rfl⟩ := hs
    exact hgen γ hγ
  | inv_mem s hs =>
    obtain ⟨γ, hγ, rfl⟩ := hs
    rw [rootReflection_inv hγ.1]
    exact hgen γ hγ
  | one => exact ⟨1, W.one_mem, fun β _ => rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨u₁, hu₁, h₁⟩ := hx
    obtain ⟨u₂, hu₂, h₂⟩ := hy
    refine ⟨u₁ * u₂, W.mul_mem hu₁ hu₂, fun β hβ => ?_⟩
    rw [mul_smul, h₂ β hβ, h₁ _ (hpres u₂ hu₂ β hβ), mul_smul]

private theorem rho_iterate_three
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) {w : WeylGroup Tag.E6}
    (hn : S.D.n = canonicalRep (coxeterSystem Tag.E6) L w) {γ : Fin Tag.E6.rank → ℤ}
    (hγ : IsRoot Tag.E6 γ) : (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[3] γ = w ^ 3 • γ := by
  have h1 := S.rho_eq_smul_of_frob hFr hΦ hn hγ
  have h2 := S.rho_eq_smul_of_frob hFr hΦ hn (IsRoot.smul hγ w)
  have h3 := S.rho_eq_smul_of_frob hFr hΦ hn (IsRoot.smul (IsRoot.smul hγ w) w)
  show S.ρ (S.ρ (S.ρ γ)) = w ^ 3 • γ
  rw [h1, h2, h3, pow_succ, pow_succ, pow_one, mul_smul, mul_smul]

theorem exists_orderOf_ppd_of_orbit_three
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) {f : ℕ} (hq : S.D.q = 2 ^ f)
    (h3q : 3 ∣ S.D.q - 1) {w : WeylGroup Tag.E6}
    (hn : S.D.n = canonicalRep (coxeterSystem Tag.E6) L w) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1)
    (h18 : (kernelRoots (rootCharHom a)).ncard = 18) (i : KernelComponent (rootCharHom a))
    (hs3 : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 3)
    {r : ℕ} (hr : IsTwoPowPpd f 9 r) :
    ∃ z ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i, orderOf z = r := by
  classical
  haveI : CharP L 2 := CFSG.StandardType.LangRat.charP_two_of_langSetup_q_eq_two_pow S hq
  have hf : 1 ≤ f := by
    by_contra h0
    have h := S.hqpow.1
    rw [hq, show f = 0 by omega, pow_zero] at h
    exact not_isPrimePow_one h
  haveI : Fact r.Prime := ⟨hr.1⟩
  have h3L : ((3 : ℕ) : L) ≠ 0 := by
    have h2 : ((2 : ℕ) : L) = 0 := CharP.cast_eq_zero L 2
    have h3 : ((3 : ℕ) : L) = 1 := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, Nat.cast_add, h2, zero_add, Nat.cast_one]
    rw [h3]
    exact one_ne_zero
  have hwa := twist_mem_rootCharStabilizerSubgroup S hFr hΦ h3q hn hT hap
  obtain ⟨c, hc, hc6⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.kernel_classes_of_ncard_eighteen
      h3L hap h18
  obtain ⟨k, hk⟩ := hc.2 i
  have hi6 : (componentRoots (rootCharHom a) i).ncard = 6 := hk ▸ hc6 k
  obtain ⟨ψ, σ, hψ, hnorm, hΨ⟩ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.TwE6UniqAbs.kac_facts h3L hap).frame i hi6
  have hw3 := CFSG.LocalAnalysis.GLTheoremA.T158.e6d4t2_cube_mem hap hwa
  obtain ⟨u, hu, hwu⟩ := exists_restrict_of_mem_kernelReflectionGroup hw3 i
  rw [hΨ] at hu hwu
  obtain ⟨π, hπ⟩ := CFSG.LocalAnalysis.GLTheoremA.K1419E.l3u3_inn_weyl_perm hψ (κ := 1) one_ne_zero
    (fun x y hxy => by rw [hnorm x y hxy]; norm_num) hu
  have hsplit : ∀ x y, x ≠ y → (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[componentOrbitLength S.ρ
      (componentRoots (rootCharHom a) i)] (σ x y) = σ (π x) (π y) := by
    intro x y hxy
    have hmem : σ x y ∈ frameRoots σ := ⟨x, y, hxy, rfl⟩
    have hroot : IsRoot Tag.E6 (σ x y) := by
      rw [← hΨ] at hmem
      exact hmem.1.1
    rw [hs3, rho_iterate_three S hFr hΦ hn hroot, hwu _ hmem, hπ x y hxy]
  obtain ⟨K, _, _, f', hf'1, hKcard, hf'eq, -, g, hgsurj, hgker⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.RationalModel.exists_slCover_rationalComponent_splitFrame S hT i
      (le_refl 3) hψ hΨ π hsplit
  have hK : Nat.card K = 2 ^ (3 * f) := by
    rw [hKcard, hf'eq, hs3, hq, ← pow_mul, mul_comm]
  have hord := hr.2
  have hdvd9 : r ∣ 2 ^ (9 * f) - 1 :=
    (CFSG.Timmesfeld.Bang.primitive_of_orderOf hord).1
  have hndvd3 : ¬ r ∣ 2 ^ (3 * f) - 1 :=
    (CFSG.Timmesfeld.Bang.primitive_of_orderOf hord).2 (3 * f) (by omega) (by omega)
  haveI : Fintype K := Fintype.ofFinite K
  have hGL : Nat.card (GL (Fin 3) K) = ∏ j : Fin 3, (Fintype.card K ^ 3 - Fintype.card K ^ (j : ℕ)) :=
    Matrix.card_GL_field 3
  have hcardK : Fintype.card K = 2 ^ (3 * f) := by rw [← Nat.card_eq_fintype_card, hK]
  have hrGL : r ∣ Nat.card (GL (Fin 3) K) := by
    rw [hGL, Fin.prod_univ_three]
    refine Dvd.dvd.mul_right (Dvd.dvd.mul_right ?_ _) _
    rw [hcardK, Fin.val_zero, pow_zero, ← pow_mul, show 3 * f * 3 = 9 * f by ring]
    exact hdvd9
  have hunits : Nat.card Kˣ = 2 ^ (3 * f) - 1 := by rw [Nat.card_units, hK]
  have hrSL : r ∣ Nat.card (Matrix.SpecialLinearGroup (Fin 3) K) := by
    have h := Matrix.card_SL_mul_card_units (n := Fin 3) (R := K)
    rw [← h, hunits] at hrGL
    rcases (Nat.Prime.dvd_mul hr.1).1 hrGL with h1 | h1
    · exact h1
    · exact absurd h1 hndvd3
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' r hrSL
  have hx3 : x ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) K) → False := by
    intro hxc
    obtain ⟨c', hc', hcx⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hxc
    have hx3' : x ^ 3 = 1 := by
      apply Subtype.ext
      rw [Matrix.SpecialLinearGroup.coe_pow, ← hcx, Matrix.SpecialLinearGroup.coe_one,
        ← map_pow]
      rw [Fintype.card_fin] at hc'
      rw [hc', map_one]
    have h3 : r ∣ 3 := hx ▸ orderOf_dvd_of_pow_eq_one hx3'
    have hr3 : r = 3 := (Nat.prime_dvd_prime_iff_eq hr.1 Nat.prime_three).1 h3
    have hnd := (CFSG.Timmesfeld.Bang.primitive_of_orderOf hr.2).2 2 (by omega) (by omega)
    exact hnd (by rw [hr3]; norm_num)
  have hgx : orderOf (g x) = r := by
    refine orderOf_eq_prime ?_ ?_
    · rw [← map_pow, ← hx, pow_orderOf_eq_one, map_one]
    · intro h1
      exact hx3 (hgker (MonoidHom.mem_ker.2 h1))
  exact ⟨g x, (g x).2, by rw [Subgroup.orderOf_coe, hgx]⟩

theorem exists_orderOf_ppd_of_triality
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) {f : ℕ} (hq : S.D.q = 2 ^ f)
    (h3q : 3 ∣ S.D.q - 1) {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) (h24 : (kernelRoots (rootCharHom a)).ncard = 24)
    (i : KernelComponent (rootCharHom a))
    (hnin : ¬ twistInner (componentRoots (rootCharHom a) i) S.ρ) {r : ℕ} (hr : IsTwoPowPpd f 12 r) :
    ∃ z ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i, orderOf z = r := by
  classical
  haveI : CharP L 2 := CFSG.StandardType.LangRat.charP_two_of_langSetup_q_eq_two_pow S hq
  have hf : 1 ≤ f := by
    by_contra h0
    have h := S.hqpow.1
    rw [hq, show f = 0 by omega, pow_zero] at h
    exact not_isPrimePow_one h
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact r.Prime := ⟨hr.1⟩
  obtain ⟨v, hv, hsub, hρ⟩ := CFSG.LocalAnalysis.GLTheoremA.T158.e6D4T2_class S hT hap h24 i
  obtain ⟨⟨e⟩, -⟩ := CFSG.LocalAnalysis.GLTheoremA.T158.d4t2un_rationalComponent_equiv S hFr hΦ
    (ℓ := 2) hf hq (hq ▸ h3q) hT hap i v hv hsub hρ hnin
  have hcard : Nat.card (rationalComponent S.ρ S.Γ (rootCharHom a) i) = CFSG.Open.ordTrialityD4 (2 ^ f) := by
    rw [Nat.card_congr e.toEquiv,
      CFSG.RankThree.PartTwo.Sec11.KSListsProof.card_trialityD4_carrier, TauCeti.PrimePower.card_def]
  have hdvd12 : r ∣ 2 ^ (12 * f) - 1 := (CFSG.Timmesfeld.Bang.primitive_of_orderOf hr.2).1
  have hndvd4 : ¬ r ∣ 2 ^ (4 * f) - 1 :=
    (CFSG.Timmesfeld.Bang.primitive_of_orderOf hr.2).2 (4 * f) (by omega) (by omega)
  have hX1 : 1 ≤ 2 ^ (4 * f) := Nat.one_le_two_pow
  have hfac : (2 ^ (4 * f) - 1) * ((2 ^ (4 * f)) ^ 2 + 2 ^ (4 * f) + 1) = 2 ^ (12 * f) - 1 := by
    have h12 : 2 ^ (12 * f) = (2 ^ (4 * f)) ^ 3 := by rw [← pow_mul]; ring_nf
    have hX3 : 1 ≤ (2 ^ (4 * f)) ^ 3 := Nat.one_le_pow _ _ (by omega)
    rw [h12]
    zify [hX1, hX3]
    ring
  have hdvd84 : r ∣ (2 ^ (4 * f)) ^ 2 + 2 ^ (4 * f) + 1 := by
    rw [← hfac] at hdvd12
    rcases (Nat.Prime.dvd_mul hr.1).1 hdvd12 with h | h
    · exact absurd h hndvd4
    · exact h
  have hdvd : r ∣ CFSG.Open.ordTrialityD4 (2 ^ f) := by
    have e8 : (2 ^ f) ^ 8 + (2 ^ f) ^ 4 + 1 = (2 ^ (4 * f)) ^ 2 + 2 ^ (4 * f) + 1 := by
      rw [← pow_mul, ← pow_mul, ← pow_mul]
      ring_nf
    unfold CFSG.Open.ordTrialityD4
    rw [e8]
    exact Dvd.dvd.mul_right (Dvd.dvd.mul_right (Dvd.dvd.mul_left hdvd84 _) _) _
  have hpos : CFSG.Open.ordTrialityD4 (2 ^ f) ≠ 0 := by
    have hQ : 2 ≤ 2 ^ f := Nat.le_self_pow (by omega) 2
    have h6 : 1 ≤ (2 ^ f) ^ 6 - 1 := by
      have := Nat.pow_le_pow_left hQ 6
      omega
    have h2 : 1 ≤ (2 ^ f) ^ 2 - 1 := by
      have := Nat.pow_le_pow_left hQ 2
      omega
    unfold CFSG.Open.ordTrialityD4
    positivity
  haveI : Finite ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; exact hpos)
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' r (hcard ▸ hdvd)
  exact ⟨z, z.2, by rw [Subgroup.orderOf_coe, hz]⟩

