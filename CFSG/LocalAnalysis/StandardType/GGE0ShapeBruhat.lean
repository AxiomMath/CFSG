theorem familyCentralizer_eq_of_weylGood
    {τ : Tag} {L : Type} [Field L] {ι : Type}
    (a : ι → Fin τ.rank → Lˣ) (h : WeylGood a) :
    familyCentralizer τ L a = familyGroup a := by
  apply le_antisymm _ (familyGroup_le_familyCentralizer a)
  intro g hg
  obtain ⟨w, hw, t, ht, u, hu, v, hv, rfl⟩ := familyCentralizer_factors τ L a g hg
  have hn := LangRetype.canonicalRep_mem_familyGroup_of_mem_closure a (h w hw)
  have hu' : u ∈ familyGroup a :=
    Subgroup.mem_sup_right ((rootSpan_mono Set.inter_subset_left) hu)
  have hv' : v ∈ familyGroup a :=
    Subgroup.mem_sup_right ((rootSpan_mono Set.inter_subset_left) hv)
  exact mul_mem (mul_mem (mul_mem (Subgroup.mem_sup_left ht) hu') hn) hv'

theorem familyCentralizer_le_each_of_pairWeylGood
    {L : Type} [Field L]
    (a : Fin 2 → Fin Tag.E6.rank → Lˣ) (h : PairWeylGood a) (i : Fin 2) :
    familyCentralizer .E6 L a ≤ familyGroup (fun _ : Unit => a i) := by
  intro g hg
  obtain ⟨w, hw, t, ht, u, hu, v, hv, rfl⟩ := familyCentralizer_factors .E6 L a g hg
  have hn := LangRetype.canonicalRep_mem_familyGroup_of_mem_closure
    (fun _ : Unit => a i) (h w hw i)
  have hker : familyKernel a ⊆ familyKernel (fun _ : Unit => a i) :=
    fun _ hα => ⟨hα.1, fun _ => hα.2 i⟩
  have hu' : u ∈ familyGroup (fun _ : Unit => a i) :=
    Subgroup.mem_sup_right ((rootSpan_mono (Set.Subset.trans Set.inter_subset_left hker)) hu)
  have hv' : v ∈ familyGroup (fun _ : Unit => a i) :=
    Subgroup.mem_sup_right ((rootSpan_mono (Set.Subset.trans Set.inter_subset_left hker)) hv)
  exact mul_mem (mul_mem (mul_mem (Subgroup.mem_sup_left ht) hu') hn) hv'

theorem rigid_pair_in_connected
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    (halg : letI := ZMod.algebra L 2; Algebra.IsAlgebraic (ZMod 2) L)
    {β : ModGL .E6 L} {E : Subgroup (ModGL .E6 L)}
    (hβ : β ∈ adjointGroup .E6 L) (hpair : RigidPair β E)
    (g : ModGL .E6 L) (hg : g ∈ adjointGroup .E6 L)
    (b : Fin Tag.E6.rank → Lˣ) (hb : g * β * g⁻¹ = rootDiagUnit .E6 b) :
    E.map (MulAut.conj g).toMonoidHom ≤ familyGroup (fun _ : Unit => b) := by
  rcases hpair with ⟨_, hβ3, hEC, a, k, hk, _, hEk, _, hgood⟩
  let y : ModGL .E6 L := k * β * k⁻¹
  have hyC : y ∈ familyCentralizer .E6 L a := by
    refine mem_familyCentralizer.2 ⟨mul_mem (mul_mem hk hβ) (inv_mem hk), ?_⟩
    intro i
    have hdi : rootDiagUnit .E6 (a i) ∈ E.map (MulAut.conj k).toMonoidHom := by
      rw [hEk]
      exact Subgroup.subset_closure ⟨i, rfl⟩
    obtain ⟨e, he, hki⟩ := Subgroup.mem_map.mp hdi
    have hc := congrArg (MulAut.conj k) (Subgroup.mem_centralizer_singleton_iff.mp (hEC he))
    simp only [map_mul] at hc
    change (MulAut.conj k) e * y = y * (MulAut.conj k) e at hc
    change (MulAut.conj k) e = rootDiagUnit .E6 (a i) at hki
    rw [hki] at hc
    rw [hc, mul_assoc, mul_inv_cancel, mul_one]
  have hy3 : y ^ 3 = 1 := by
    change ((MulAut.conj k) β) ^ 3 = 1
    rw [← map_pow, hβ3, map_one]
  have hmap : E.map (MulAut.conj g).toMonoidHom =
      (Subgroup.closure (Set.range fun i => rootDiagUnit .E6 (a i))).map
        (MulAut.conj (g * k⁻¹)).toMonoidHom := by
    rw [← hEk, Subgroup.map_map]
    congr 1
    ext e
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  rw [hmap, Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  change (g * k⁻¹) * rootDiagUnit .E6 (a i) * (g * k⁻¹)⁻¹ ∈
    familyGroup (fun _ : Unit => b)
  apply conj_rootDiagUnit_mem_familyGroup_E6_three halg
    (familyCentralizer_le_each_of_pairWeylGood a hgood i hyC) hy3
    (mul_mem hg (inv_mem hk))
  calc (g * k⁻¹) * y * (g * k⁻¹)⁻¹ = g * β * g⁻¹ := by dsimp [y]; group
       _ = rootDiagUnit .E6 b := hb

