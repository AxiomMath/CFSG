theorem entrywise_fixedFieldInclusion {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (u : adjointGroup .F4 (fixSubfield σ)) :
    entrywiseAdjointAut .F4 σ (fixedFieldInclusion σ u) = fixedFieldInclusion σ u := by
  have h : baseChangeGL (fixSubfield σ).subtype (u : ModGL .F4 (fixSubfield σ)) ∈
      fixedFieldImage .F4 σ := ⟨u, u.2, rfl⟩
  exact Subtype.ext ((coe_entrywiseAdjointAut _ σ _).trans (fixedFieldImage_le h).2)

end Lang

