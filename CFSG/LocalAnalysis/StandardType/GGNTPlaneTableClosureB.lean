private theorem n1cBe6RootList_nodup : e6RootList.Nodup := by
  decide +kernel

private lemma n1cBkerReflSet_eq (x : X3) :
    kerReflSet x = ↑(n1cBkerReflList x).toFinset := by
  ext M
  simp only [kerReflSet, kerRoots, Set.mem_setOf_eq, Finset.mem_coe, List.mem_toFinset,
    List.mem_map, List.mem_filter, decide_eq_true_eq, n1cBkerReflList, n1cBkerList]
  constructor
  · rintro ⟨α, ⟨hroot, hpair⟩, rfl⟩
    exact ⟨α, ⟨(isRoot_iff_mem_e6RootList α).1 hroot, by simpa using hpair⟩, rfl⟩
  · rintro ⟨α, ⟨⟨hmem, hpair⟩, rfl⟩⟩
    exact ⟨α, ⟨(isRoot_iff_mem_e6RootList α).2 hmem, by simpa using hpair⟩, rfl⟩

private theorem n1cBncard_kerRoots (x : X3) :
    (kerRoots x).ncard = (n1cBkerList x).length := by
  have hnod : (n1cBkerList x).Nodup :=
    n1cBe6RootList_nodup.filter _
  have hset : kerRoots x = ↑(n1cBkerList x).toFinset := by
    ext α
    simp only [kerRoots, Set.mem_setOf_eq, Finset.mem_coe, List.mem_toFinset, List.mem_filter,
      decide_eq_true_eq, n1cBkerList]
    rw [isRoot_iff_mem_e6RootList]
  rw [hset, Set.ncard_coe_finset, List.toFinset_card_of_nodup hnod]

private lemma n1cBnodup_map_dec {l : List ℕ} (hl : l.Nodup)
    (henc : ∀ c ∈ l, n1cBenc (n1cBdec c) = c) : (l.map n1cBdec).Nodup := by
  rw [List.nodup_map_iff_inj_on hl]
  intro a ha b hb hab
  have h := congrArg n1cBenc hab
  rwa [henc a ha, henc b hb] at h

private lemma n1cBprod_mem_of_codes {M : Type*} [Monoid M] (dec : ℕ → M)
    (codes gens : List ℕ) (tab : List (List ℕ))
    (hlt : ∀ (i : Fin codes.length) (j : Fin gens.length),
       (tab.getD i.val []).getD j.val 0 < codes.length)
    (hspec : ∀ (i : Fin codes.length) (j : Fin gens.length),
       dec (codes.getD ((tab.getD i.val []).getD j.val 0) 0) =
         dec (codes.get i) * dec (gens.get j)) :
    ∀ g ∈ codes.map dec, ∀ s ∈ gens.map dec, g * s ∈ codes.map dec := by
  intro g hg s hs
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hg
  obtain ⟨d, hd, rfl⟩ := List.mem_map.1 hs
  obtain ⟨i, hi⟩ := List.mem_iff_get.1 hc
  obtain ⟨j, hj⟩ := List.mem_iff_get.1 hd
  rw [← hi, ← hj, ← hspec i j]
  refine List.mem_map_of_mem ?_
  rw [List.getD_eq_getElem (l := codes) (d := 0) (hlt i j)]
  exact List.get_mem _ _

private lemma n1cBmem_closure_of_par {M : Type*} [Monoid M] (S : Set M) (dec : ℕ → M)
    (codes gens : List ℕ) (par gi : ℕ → ℕ) (genSet : Set ℕ)
    (hgen : ∀ c ∈ gens, c ∈ genSet) (hgenS : ∀ c ∈ genSet, dec c ∈ S)
    (h0 : dec (codes.getD 0 0) = 1)
    (hpar : ∀ i, i < codes.length → 0 < i → par i < i)
    (hgi : ∀ i, i < codes.length → 0 < i → gi i < gens.length)
    (hstep : ∀ i, i < codes.length → 0 < i →
       dec (codes.getD i 0) = dec (codes.getD (par i) 0) * dec (gens.getD (gi i) 0)) :
    ∀ c ∈ codes, dec c ∈ Submonoid.closure S := by
  have key : ∀ i, i < codes.length → dec (codes.getD i 0) ∈ Submonoid.closure S := by
    intro i
    induction i using Nat.strong_induction_on with
    | _ i ih =>
      intro hi
      rcases Nat.eq_zero_or_pos i with h | h
      · subst h
        rw [h0]
        exact Submonoid.one_mem _
      · rw [hstep i hi h]
        refine mul_mem (ih (par i) (hpar i hi h) (lt_trans (hpar i hi h) hi)) ?_
        rw [List.getD_eq_getElem (l := gens) (d := 0) (hgi i hi h)]
        exact Submonoid.subset_closure (hgenS _ (hgen _ (List.get_mem _ _)))
  intro c hc
  obtain ⟨i, hi⟩ := List.mem_iff_get.1 hc
  have hgi' : codes.get i = codes.getD i.val 0 := by
    rw [List.get_eq_getElem, List.getD_eq_getElem (l := codes) (d := 0) i.isLt]
  rw [← hi, hgi']
  exact key i.val i.isLt

private lemma n1cBgetD_getD_lt {tab : List (List ℕ)} {n : ℕ} (hn : 0 < n)
    (h : ∀ row ∈ tab, ∀ t ∈ row, t < n) (i j : ℕ) : (tab.getD i []).getD j 0 < n := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD]
  cases hrow : tab[i]? with
  | none => simpa using hn
  | some row =>
    rw [Option.getD_some]
    cases ht : row[j]? with
    | none => simpa using hn
    | some t => exact h row (List.mem_of_getElem? hrow) t (List.mem_of_getElem? ht)

private def n1cBdig (c n : ℕ) : ℕ := (c >>> (3 * n)) &&& 7

private def n1cBsum6 (f : ℕ → ℕ) : ℕ := f 0 + f 1 + f 2 + f 3 + f 4 + f 5

private def n1cBentryOK (a b c i j : ℕ) : Bool :=
  n1cBdig a (6 * i + j) + 3 * n1cBsum6 (fun k => n1cBdig b (6 * i + k)) +
      3 * n1cBsum6 (fun k => n1cBdig c (6 * k + j)) ==
    n1cBsum6 (fun k => n1cBdig b (6 * i + k) * n1cBdig c (6 * k + j)) + 57

private def n1cBmulOK (a b c : ℕ) : Bool :=
  (List.range 6).all fun i => (List.range 6).all fun j => n1cBentryOK a b c i j

private theorem n1cBmulOK_sound {a b c : ℕ} (h : n1cBmulOK a b c = true) :
    n1cBdec a = n1cBdec b * n1cBdec c := by
  ext i j
  have hij : n1cBentryOK a b c i j = true :=
    List.all_eq_true.1 (List.all_eq_true.1 h i (List.mem_range.2 i.isLt)) j
      (List.mem_range.2 j.isLt)
  have hZ := congrArg (Nat.cast : ℕ → ℤ) (beq_iff_eq.1 hij)
  have hsum (f : ℕ → ℤ) : ∑ k : Fin 6, f k.val = f 0 + f 1 + f 2 + f 3 + f 4 + f 5 := by
    rw [Fin.sum_univ_six]
    rfl
  change ((n1cBdig a (6 * i.val + j.val) : ℕ) : ℤ) - 3 =
    ∑ k : Fin 6, (((n1cBdig b (6 * i.val + k.val) : ℕ) : ℤ) - 3) *
      (((n1cBdig c (6 * k.val + j.val) : ℕ) : ℤ) - 3)
  rw [hsum fun k => (((n1cBdig b (6 * i.val + k) : ℕ) : ℤ) - 3) *
    (((n1cBdig c (6 * k + j.val) : ℕ) : ℤ) - 3)]
  simp only [n1cBsum6, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] at hZ
  linear_combination hZ

private theorem n1cBcodes_nodup : ∀ k : Fin 7, (n1cBcodes k).Nodup := by
