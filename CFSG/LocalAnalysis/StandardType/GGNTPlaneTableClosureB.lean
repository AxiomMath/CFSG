private theorem n1cBcard_closure_3 :
    Nat.card (Submonoid.closure (kerReflSet (reps 3))) = repKerGroupOrder 3 := by
  have hnd : (n1cBell 3).Nodup := by
    rw [n1cBell]
    exact n1cBnodup_map_dec (n1cBcodes_nodup 3) (fun c hc => n1cBenc_dec 3 c hc)
  have h1 : (1 : Matrix (Fin Tag.E6.rank) (Fin Tag.E6.rank) ℤ) ∈ n1cBell 3 :=
    n1cBone_mem 3 (by decide)
  have hcl : ∀ g ∈ n1cBell 3, ∀ s ∈ kerReflSet (reps 3), g * s ∈ n1cBell 3 := by
    rw [n1cBkerReflSet_eq_gens 3 (by decide)]
    intro g hg s hs
    rw [Finset.mem_coe, List.mem_toFinset] at hs
    exact n1cBprod_mem_of_codes n1cBdec (n1cBcodes 3) (n1cBgens 3) (n1cBtab 3)
      (fun i j => n1cBtab_lt 3 i j) (fun i j => n1cBtab_spec_3 i j) g hg s hs
  have hreach : ∀ g ∈ n1cBell 3, g ∈ Submonoid.closure (kerReflSet (reps 3)) := by
    intro g hg
    obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hg
    exact n1cBmem_closure_of_par (kerReflSet (reps 3)) n1cBdec (n1cBcodes 3) (n1cBgens 3)
      (fun i => (n1cBpar 3).getD i 0) (fun i => (n1cBpgi 3).getD i 0)
      {c | c ∈ n1cBgens 3} (fun c hc => hc)
      (fun c hc => by
        rw [n1cBkerReflSet_eq_gens 3 (by decide)]
        exact List.mem_toFinset.2 (List.mem_map_of_mem hc))
      (n1cBone_code 3 (by decide))
      (fun i hi hpos => n1cBpar_lt 3 ⟨i, hi⟩ hpos)
      (fun i hi hpos => n1cBpgi_lt 3 ⟨i, hi⟩ hpos)
      (fun i hi hpos => n1cBpar_spec_3 ⟨i, hi⟩ hpos) c hc
  rw [card_closure_of_closed (kerReflSet (reps 3)) (n1cBell 3) hnd h1 hcl hreach]
  exact n1cBell_length 3 (by decide)

