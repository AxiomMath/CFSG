variable {F : Type} [Field F]

theorem simpleSL2_e6_tv01 (i : Fin (CFSG.Blueprint.Chevalley.Tag.rank .E6)) (c : F) :
    simpleSL2 e6Data_valid F i (tv 0 1 c) = e6Data_valid.xm F (Pi.single i 1) c := by
  rw [Timmesfeld.LevisExtras.tv01_eq_sl2Upper]
  exact CFSG.RankThree.PartTwo.Census.Exceptional.simpleSL2_upper e6Data_valid F i c

theorem simpleSL2_e6_tv10 (i : Fin (CFSG.Blueprint.Chevalley.Tag.rank .E6)) (c : F) :
    simpleSL2 e6Data_valid F i (tv 1 0 c) = e6Data_valid.xm F (-Pi.single i 1) c := by
  rw [Timmesfeld.LevisExtras.tv10_eq_sl2Lower]
  refine e6Data_valid.endo_injective F ?_
  rw [CFSG.RankThree.PartTwo.Census.Exceptional.endo_simpleSL2, e6Data_valid.endo_xm]
  exact e6Data_valid.blockOp_lower F i c

variable [Finite F] [CharP F 2]

theorem slToE6Sc_comp_blockSL2 (k : Fin 5) :
    (slToE6Sc F).comp (blockSL2 F 5 k) = simpleSL2 e6Data_valid F (chainNode k) := by
  refine CFSG.ClassicalInvolution.WeakCT.hom_ext_sl2 (fun c => ?_) (fun c => ?_)
  · rw [MonoidHom.comp_apply, simpleSL2_e6_tv01 (chainNode k) c,
      tv_of_ne (show (0 : Fin 2) ≠ 1 by decide),
      CFSG.ClassicalInvolution.WeakCT.blockSL2_transvection_up]
    exact CFSG.SeitzReduction.F4Pilot.slToE6Sc_transvection_castSucc_succ k c
  · rw [MonoidHom.comp_apply, simpleSL2_e6_tv10 (chainNode k) c,
      tv_of_ne (show (1 : Fin 2) ≠ 0 by decide),
      CFSG.ClassicalInvolution.WeakCT.blockSL2_transvection_down]
    exact CFSG.SeitzReduction.F4Pilot.slToE6Sc_transvection_succ_castSucc k c

end Native

open CFSG.ClassicalInvolution.Generic CFSG.Assembly.LowTwoRank in
theorem ggE6Psi_of_twoSL6Charts_marked {G : Type} [Group G] {f : ℕ} (hf : 2 ≤ f)
    (ψ₁ ψ₂ : Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 f) →* G)
    (h₁ : ψ₁.ker ≤ Subgroup.center _) (h₂ : ψ₂.ker ≤ Subgroup.center _)
    (hJ : ψ₁.comp (blockSL (GaloisField 2 f) 6 4 0 (by norm_num)) =
      ψ₂.comp (blockSL (GaloisField 2 f) 6 4 0 (by norm_num)))
    (hM : ∀ a ∈ (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).range.map ψ₁,
      ∀ b ∈ (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).range.map ψ₂, a * b = b * a) :
    ∃ Ψ : (modelUniv .E6 0 2 f Fact.out).K →* G, Ψ.ker ≤ Subgroup.center _ ∧
      Ψ.range = ψ₁.range ⊔ (blockSL2 (GaloisField 2 f) 5 3).range.map ψ₂ ∧
      Ψ.comp (slToE6Sc (GaloisField 2 f)) = ψ₁ ∧
      (∀ k : Fin 5, Ψ.comp (simpleSL2 e6Data_valid (GaloisField 2 f) (chainNode k)) =
        ψ₁.comp (blockSL2 (GaloisField 2 f) 5 k)) ∧
      Ψ.comp (simpleSL2 e6Data_valid (GaloisField 2 f) (1 : Fin 6)) =
        ψ₂.comp (blockSL2 (GaloisField 2 f) 5 3) := by
  classical
  have hadm : StatedLieAdmissible .E6 0 2 f := ⟨Nat.prime_two, by omega, rfl⟩
  let ρ : Fin 6 → Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f) →* G :=
    ![ψ₁.comp (blockSL2 _ 5 0), ψ₂.comp (blockSL2 _ 5 3), ψ₁.comp (blockSL2 _ 5 1),
      ψ₁.comp (blockSL2 _ 5 2), ψ₁.comp (blockSL2 _ 5 3), ψ₁.comp (blockSL2 _ 5 4)]
  have hρchain : ∀ k : Fin 5, ρ (chainNode k) = ψ₁.comp (blockSL2 _ 5 k) := by
    intro k
    fin_cases k <;> rfl
  have e : ∀ j : Fin 5, (j : ℕ) ≤ 2 → ψ₂.comp (blockSL2 (GaloisField 2 f) 5 j) =
      ψ₁.comp (blockSL2 (GaloisField 2 f) 5 j) := by
    intro j hj
    have h' : blockSL2 (GaloisField 2 f) 5 j =
        (blockSL (GaloisField 2 f) 6 4 0 (by norm_num)).comp
          (blockSL (GaloisField 2 f) 4 2 j (by omega)) := by
      rw [CFSG.ClassicalInvolution.WeakCT.blockSL_comp]
      show blockSL (GaloisField 2 f) 6 2 j (by omega) = _
      congr 1
      omega
    rw [h', ← MonoidHom.comp_assoc, ← MonoidHom.comp_assoc, hJ]
  have hdisj : ∀ (ψ : Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 f) →* G) (i j : Fin 5),
      (i : ℕ) + 2 ≤ j → ∀ a ∈ (ψ.comp (blockSL2 _ 5 i)).range,
        ∀ b ∈ (ψ.comp (blockSL2 _ 5 j)).range, a * b = b * a := by
    rintro ψ i j hij _ ⟨A, rfl⟩ _ ⟨B, rfl⟩
    simp only [MonoidHom.comp_apply]
    rw [← map_mul, ← map_mul]
    exact congrArg ψ (CFSG.ClassicalInvolution.WeakCT.blockSL_comm (K := GaloisField 2 f) (m := 6)
      (k := 2) (l := 2) (i := i) (j := j) (by omega) (by omega) (Or.inl hij) A B)
  have hU3 : (blockSL2 (GaloisField 2 f) 5 3).range ≤
      (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).range := by
    have h' : blockSL2 (GaloisField 2 f) 5 3 = (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).comp
        (blockSL (GaloisField 2 f) 3 2 0 (by norm_num)) := by
      rw [CFSG.ClassicalInvolution.WeakCT.blockSL_comp]
      rfl
    rw [h', MonoidHom.range_comp]
    exact Subgroup.map_le_range _ _
  have hU4 : (blockSL2 (GaloisField 2 f) 5 4).range ≤
      (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).range := by
    have h' : blockSL2 (GaloisField 2 f) 5 4 = (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).comp
        (blockSL (GaloisField 2 f) 3 2 1 (by norm_num)) := by
      rw [CFSG.ClassicalInvolution.WeakCT.blockSL_comp]
      rfl
    rw [h', MonoidHom.range_comp]
    exact Subgroup.map_le_range _ _
  have hMb : ∀ j : Fin 5, 3 ≤ (j : ℕ) → ∀ a ∈ (ψ₁.comp (blockSL2 (GaloisField 2 f) 5 j)).range,
      ∀ b ∈ (ψ₂.comp (blockSL2 (GaloisField 2 f) 5 3)).range, a * b = b * a := by
    intro j hj a ha b hb
    rw [MonoidHom.range_comp] at ha hb
    have hj' : (blockSL2 (GaloisField 2 f) 5 j).range ≤
        (blockSL (GaloisField 2 f) 6 3 3 (by norm_num)).range := by
      fin_cases j
      all_goals first | exact absurd hj (by decide) | exact hU3 | exact hU4
    exact hM a (Subgroup.map_mono hj' ha) b (Subgroup.map_mono hU3 hb)
  have cs : ∀ {A C : Subgroup G}, (∀ a ∈ A, ∀ b ∈ C, a * b = b * a) →
      ∀ b ∈ C, ∀ a ∈ A, b * a = a * b := fun h b hb a ha => (h a ha b hb).symm
  have c03 := hdisj ψ₁ 0 2 (by decide)
  have c04 := hdisj ψ₁ 0 3 (by decide)
  have c05 := hdisj ψ₁ 0 4 (by decide)
  have c24 := hdisj ψ₁ 1 3 (by decide)
  have c25 := hdisj ψ₁ 1 4 (by decide)
  have c35 := hdisj ψ₁ 2 4 (by decide)
  obtain ⟨V, hV⟩ : ∃ V : Fin 6 → Subgroup G, ∀ k, V k = (ρ k).range := ⟨_, fun _ => rfl⟩
  have d03 : ∀ a ∈ V 0, ∀ b ∈ V 3, a * b = b * a := by rw [hV, hV]; exact c03
  have d04 : ∀ a ∈ V 0, ∀ b ∈ V 4, a * b = b * a := by rw [hV, hV]; exact c04
  have d05 : ∀ a ∈ V 0, ∀ b ∈ V 5, a * b = b * a := by rw [hV, hV]; exact c05
  have d24 : ∀ a ∈ V 2, ∀ b ∈ V 4, a * b = b * a := by rw [hV, hV]; exact c24
  have d25 : ∀ a ∈ V 2, ∀ b ∈ V 5, a * b = b * a := by rw [hV, hV]; exact c25
  have d35 : ∀ a ∈ V 3, ∀ b ∈ V 5, a * b = b * a := by rw [hV, hV]; exact c35
  have d01 : ∀ a ∈ V 0, ∀ b ∈ V 1, a * b = b * a := by
    have h := hdisj ψ₂ 0 3 (by decide)
    rw [e 0 (by decide)] at h
    rw [hV, hV]
    exact h
  have d12 : ∀ a ∈ V 1, ∀ b ∈ V 2, a * b = b * a := by
    have h := hdisj ψ₂ 1 3 (by decide)
    rw [e 1 (by decide)] at h
    rw [hV, hV]
    exact cs h
  have d14 : ∀ a ∈ V 1, ∀ b ∈ V 4, a * b = b * a := by
    rw [hV, hV]
    exact cs (hMb 3 (by decide))
  have d15 : ∀ a ∈ V 1, ∀ b ∈ V 5, a * b = b * a := by
    rw [hV, hV]
    exact cs (hMb 4 (by decide))
  have hcomm : ∀ i j : Fin 6, i ≠ j → ¬ edgeE 6 i j → ¬ edgeE 6 j i →
      ∀ u ∈ V i, ∀ v ∈ V j, u * v = v * u := by
    intro i j hij h1 h2
    fin_cases i <;> fin_cases j
    all_goals first
      | exact absurd rfl hij
      | exact absurd (by decide) h1
      | exact absurd (by decide) h2
      | exact d01 | exact cs d01 | exact d03 | exact cs d03 | exact d04 | exact cs d04
      | exact d05 | exact cs d05 | exact d12 | exact cs d12 | exact d14 | exact cs d14
      | exact d15 | exact cs d15 | exact d24 | exact cs d24 | exact d25 | exact cs d25
      | exact d35 | exact cs d35
  have hρ : ∀ k, Function.Injective (ρ k) ∧ (ρ k).range = V k := by
    intro k
    refine ⟨?_, (hV k).symm⟩
    fin_cases k
    · exact CFSG.ClassicalInvolution.WeakCT.comp_blockSL_injective h₁ _ (by norm_num)
    · exact CFSG.ClassicalInvolution.WeakCT.comp_blockSL_injective h₂ _ (by norm_num)
    all_goals exact CFSG.ClassicalInvolution.WeakCT.comp_blockSL_injective h₁ _ (by norm_num)
  have hchain : ∀ (ψ : Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 f) →* G) (j : Fin 5)
      (hj : (j : ℕ) + 1 < 5),
      (ψ.comp (blockSL (GaloisField 2 f) 6 3 j (by omega))).comp (blk (GaloisField 2 f) 0) =
        ψ.comp (blockSL2 (GaloisField 2 f) 5 j) ∧
      (ψ.comp (blockSL (GaloisField 2 f) 6 3 j (by omega))).comp (blk (GaloisField 2 f) 1) =
        ψ.comp (blockSL2 (GaloisField 2 f) 5 ⟨j + 1, hj⟩) := by
    intro ψ j hj
    constructor
    · rw [MonoidHom.comp_assoc]
      exact congrArg ψ.comp (CFSG.ClassicalInvolution.WeakCT.blockSL_comp (K := GaloisField 2 f)
        (m := 6) (k := 3) (i := j) (l := 2) (j := 0) (by omega) (by omega))
    · rw [MonoidHom.comp_assoc]
      exact congrArg ψ.comp (CFSG.ClassicalInvolution.WeakCT.blockSL_comp (K := GaloisField 2 f)
        (m := 6) (k := 3) (i := j) (l := 2) (j := 1) (by omega) (by omega))
  have hψ : ∀ i j : Fin 6, edgeE 6 i j → ∃ ψ : Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 f) →* G,
      ψ.comp (blk (GaloisField 2 f) 0) = ρ i ∧ ψ.comp (blk (GaloisField 2 f) 1) = ρ j := by
    intro i j h
    fin_cases i <;> fin_cases j
    all_goals first
      | exact absurd h (by decide)
      | skip
    · exact ⟨_, hchain ψ₁ 0 (by decide)⟩
    · refine ⟨(ψ₂.comp (blockSL (GaloisField 2 f) 6 3 2 (by norm_num))).comp
        (CFSG.ClassicalInvolution.Q3.Q3V.blockSwapAut (K := GaloisField 2 f)).toMonoidHom, ?_, ?_⟩
      · rw [CFSG.ClassicalInvolution.Q3.Q3V.comp_blockSwapAut_blk]
        exact (hchain ψ₂ 2 (by decide)).2
      · rw [CFSG.ClassicalInvolution.Q3.Q3V.comp_blockSwapAut_blk]
        exact (hchain ψ₂ 2 (by decide)).1.trans (e 2 (by decide))
    · exact ⟨_, hchain ψ₁ 1 (by decide)⟩
    · exact ⟨_, hchain ψ₁ 2 (by decide)⟩
    · exact ⟨_, hchain ψ₁ 3 (by decide)⟩
  obtain ⟨Ψ, hker, hrange, -, -, hpin⟩ :=
    CFSG.LieType.SeitzGeneration.ExcHigh.E8Tw.e6_frame_subgroup_pinned hadm hcomm hρ hψ
  have hsimple : ∀ k : Fin 6, Ψ.comp (simpleSL2 e6Data_valid (GaloisField 2 f) k) = ρ k := by
    intro k
    refine CFSG.ClassicalInvolution.WeakCT.hom_ext_sl2 (fun c => ?_) (fun c => ?_)
    · rw [MonoidHom.comp_apply, simpleSL2_e6_tv01 k c]
      exact (hpin k c).1
    · rw [MonoidHom.comp_apply, simpleSL2_e6_tv10 k c]
      exact (hpin k c).2
  have hnodes : ∀ k : Fin 5, Ψ.comp (simpleSL2 e6Data_valid (GaloisField 2 f) (chainNode k)) =
      ψ₁.comp (blockSL2 (GaloisField 2 f) 5 k) := fun k => (hsimple _).trans (hρchain k)
  have key : ∃ Ψ : ↥(e6Data_valid.minGroup (GaloisField 2 f)) →* G, Ψ.ker ≤ Subgroup.center _ ∧
      Ψ.range = ψ₁.range ⊔ (blockSL2 (GaloisField 2 f) 5 3).range.map ψ₂ ∧
      Ψ.comp (slToE6Sc (GaloisField 2 f)) = ψ₁ ∧
      (∀ k : Fin 5, Ψ.comp (simpleSL2 e6Data_valid (GaloisField 2 f) (chainNode k)) =
        ψ₁.comp (blockSL2 (GaloisField 2 f) 5 k)) ∧
      Ψ.comp (simpleSL2 e6Data_valid (GaloisField 2 f) (1 : Fin 6)) =
        ψ₂.comp (blockSL2 (GaloisField 2 f) 5 3) := by
    refine ⟨Ψ, hker, ?_, ?_, hnodes, hsimple 1⟩
    ·
      have hgen : ψ₁.range = ⨆ i : Fin 5, (ψ₁.comp (blockSL2 (GaloisField 2 f) 5 i)).range := by
        simp only [MonoidHom.range_comp]
        rw [← Subgroup.map_iSup,
          (CFSG.ClassicalInvolution.WeakCT.weakCTSystem_standard (K := GaloisField 2 f) 5).gen,
          ← MonoidHom.range_eq_map]
      rw [hrange, hgen, ← MonoidHom.range_comp]
      simp only [hV]
      apply le_antisymm
      · refine iSup_le fun k => ?_
        fin_cases k
        · exact le_sup_of_le_left (le_iSup (fun i => (ψ₁.comp (blockSL2 _ 5 i)).range) 0)
        · exact le_sup_right
        · exact le_sup_of_le_left (le_iSup (fun i => (ψ₁.comp (blockSL2 _ 5 i)).range) 1)
        · exact le_sup_of_le_left (le_iSup (fun i => (ψ₁.comp (blockSL2 _ 5 i)).range) 2)
        · exact le_sup_of_le_left (le_iSup (fun i => (ψ₁.comp (blockSL2 _ 5 i)).range) 3)
        · exact le_sup_of_le_left (le_iSup (fun i => (ψ₁.comp (blockSL2 _ 5 i)).range) 4)
      · refine sup_le (iSup_le fun i => ?_) (le_iSup (fun k => (ρ k).range) 1)
        rw [← hρchain i]
        exact le_iSup (fun k => (ρ k).range) (chainNode i)
    · refine CFSG.ClassicalInvolution.WeakCT.hom_ext_blockSL2 fun k => ?_
      rw [MonoidHom.comp_assoc, slToE6Sc_comp_blockSL2]
      exact hnodes k
  exact key

end CFSG.StandardType

