theorem e6d_certOK : certOK e6dGens (xLast 5) e6dSets e6dPats e6dReps e6dS2 = true := by
  decide +kernel

theorem e6d_cov : dCovB 5 e6dPats = true := by
  decide +kernel

theorem e6d_refl : reflCertB e6dGens e6dCerts = true := by
  decide +kernel

theorem e6d_frame : dFrameB 5 e6dCerts = true := by
  decide +kernel

@[expose] def e6dS (k : Fin 6) : Vn 6 ≃ₗ[ZMod 3] Vn 6 := letLin (letAt e6dGens k)

theorem e6d_S (k : Fin 6) : e6dS k = letLin (letAt e6dGens k) := rfl

theorem e6d_test : ∀ A Mg : Subgroup (Vn 6 ≃ₗ[ZMod 3] Vn 6),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 6 => e6dS k)) (xLast 5) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 5) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 5) t → t ∈ Mg :=
  linTest_dframe_of_certOK (by norm_num) _ e6dGens rfl e6d_S e6d_refl e6d_frame e6d_certOK e6d_cov

