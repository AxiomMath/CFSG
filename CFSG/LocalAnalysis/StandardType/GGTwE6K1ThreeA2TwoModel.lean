theorem statedClassicalModel_component_threeA2_two {K : Type} [Field K] [Finite K]
    {σ : K ≃+* K} (hK : Nat.card K = 4) (hσ : ∀ c, σ c = c ^ 2)
    {h : twistedE6InndiagGL K σ} (hh1 : h ≠ 1) (hh3 : h ^ 3 = 1)
    (hdim : twE6MatFixDim K σ h = 24) {J : Subgroup (twistedE6RootGroup K σ)}
    (hJ : CFSG.Open.IsComponentOf J
      (CFSG.LieType.Seitz.fixedPoints (Subgroup.zpowers (twistedE6InndiagConj K σ h)))) :
    Subgroup.center ↥J = ⊥ ∧ StatedClassicalModel (↥J ⧸ Subgroup.center ↥J) .PSU 3 2 3 := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (f := 2)
    (by rw [← Nat.card_eq_fintype_card]; exact hK.trans (by norm_num))
  have hchar : ringChar K = 2 := ringChar.eq K 2
  have hK3 : ringChar K ≠ 3 := by
    rw [hchar]
    decide
  obtain ⟨D⟩ := nonempty_twE6LineLang K σ 2 hK3 hσ (hK.trans (by norm_num)) (le_refl 2) h hh1 hh3
  have he : D.e = 1 := by
    have h1 := D.hqe
    rw [hchar] at h1
    exact Nat.pow_right_injective (le_refl 2) (h1.symm.trans (pow_one 2).symm)
  have h3q : 3 ∣ D.S.D.q + 1 := D.three_dvd_sq (by norm_num)
  obtain ⟨i, hqs, hJi⟩ := D.exists_rationalComponent hJ
  obtain ⟨hi6, hone | hall⟩ := twE6LineLang_orbit_one_or_three D hdim (by norm_num)
  ·
    exfalso
    obtain ⟨ψ, σ', π, hψ, hΨ, hπ⟩ := exists_unitary_frame_of_odd_orbit D.S D.hL3 D.hT D.hap D.h1 i
      (hi6 i) (by rw [hone i]) h3q
    have h216 := (rationalComponent_of_unitary_frame_T D.S D.hT i (le_refl 3) hψ hΨ π hπ).2
      (by rw [hone i, pow_one, D.sq_eq])
    obtain ⟨hperf, hsimp, -⟩ := hqs
    haveI := hperf
    haveI := hsimp
    haveI : Nontrivial ↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i) :=
      (QuotientGroup.mk_surjective (s := Subgroup.center _)).nontrivial
    exact Group.IsPerfect.not_isSolvable _ (isSolvable_of_card_dvd_216 h216)
  have hs3 := (hall i).1
  obtain ⟨ψ, σ', π, hψ, hΨ, hπ⟩ := exists_unitary_frame_of_odd_orbit D.S D.hL3 D.hT D.hap D.h1 i
    (hi6 i) (by rw [hs3]) h3q
  have hZ := center_rationalComponent_eq_bot_of_orbit_three D.S D.hT D.hap i (hi6 i) hψ hΨ π hπ
    D.hℓ D.hchar D.he D.hSq hs3 h3q
  have hQ : ((3 : ℕ), ringChar K ^ (D.e * componentOrbitLength D.S.ρ
      (componentRoots (rootCharHom D.a) i))) ≠ (3, 2) := by
    rw [hs3, hchar, he]
    decide
  have hmodel := KSExact.rationalComponent_suN_model D.S D.hT i (le_refl 3) hψ hΨ π hπ D.hℓ
    D.hchar D.he D.hSq hQ
  rw [hs3, hchar, he, Nat.one_mul] at hmodel
  let eJ := (J.equivMapOfInjective D.ι D.hinj).trans (MulEquiv.subgroupCongr hJi)
  have hZJ : Subgroup.center ↥J = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro z hz
    have hz' : eJ z ∈ Subgroup.center ↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i) := by
      rw [Subgroup.mem_center_iff]
      intro y
      obtain ⟨x, rfl⟩ := eJ.surjective y
      rw [← map_mul eJ, ← map_mul eJ, Subgroup.mem_center_iff.1 hz x]
    rw [hZ, Subgroup.mem_bot] at hz'
    exact eJ.injective (hz'.trans (map_one eJ).symm)
  have hmap : (Subgroup.center ↥J).map eJ.toMonoidHom = Subgroup.center
      ↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i) := by
    rw [hZJ, hZ, Subgroup.map_bot]
  exact ⟨hZJ, StatedAPI.statedClassicalModel_of_mulEquiv
    (QuotientGroup.congr _ _ eJ hmap).symm hmodel⟩

