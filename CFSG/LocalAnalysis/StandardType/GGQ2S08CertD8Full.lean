    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 8) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 8) t → t ∈ Mg :=
  linTest_dframe_of_certOK (by norm_num) _ d8fGens rfl d8f_S d8f_refl d8f_frame d8f_certOK d8f_cov

