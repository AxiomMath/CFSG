private theorem exists_mem_pow_eq_one {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    {E : Subgroup G} (hE : IsPGroup p E) (hne : E ≠ ⊥) : ∃ z ∈ E, z ≠ 1 ∧ z ^ p = 1 := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Nontrivial ↥E := (Subgroup.nontrivial_iff_ne_bot E).2 hne
  have hdvd : p ∣ Nat.card ↥E := by
    rcases hE.card_eq_or_dvd with h | h
    · exact absurd h (Finite.one_lt_card (α := ↥E)).ne'
    · exact h
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' p hdvd
  refine ⟨x, x.2, fun h => ?_, ?_⟩
  · have hx1 : x = 1 := Subtype.ext h
    rw [hx1, orderOf_one] at hx
    exact hp.one_lt.ne hx
  · have h := pow_orderOf_eq_one x
    rw [hx] at h
    exact congrArg Subtype.val h

private theorem isPGroup_and_comm_range {A G : Type*} [Group A] [Group G] {p : ℕ} (σ : A →* G)
    (hp : IsPGroup p A) (hc : ∀ a b : A, a * b = b * a) :
    IsPGroup p σ.range ∧ ∀ u ∈ σ.range, ∀ v ∈ σ.range, u * v = v * u := by
  refine ⟨hp.of_surjective σ.rangeRestrict σ.rangeRestrict_surjective, ?_⟩
  rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
  rw [← map_mul, ← map_mul, hc]

