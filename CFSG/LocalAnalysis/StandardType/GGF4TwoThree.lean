private lemma ltqF4_recipe_data {Q : LargeEvenRawCont}
    (h : LargeEvenRawDatum (⟨.F4, 0, 1⟩ : LargeEvenLabel) Q) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = 2 ∧
      Q (LargeEvenCenterQuot (LargeEvenChevH LargeEvenCartanF4 K false))
        (LargeEvenChevIDImage LargeEvenCartanF4 K
          (LargeEvenChevH LargeEvenCartanF4 K false))
        (LargeEvenChevFieldImage LargeEvenCartanF4 K
          (LargeEvenChevH LargeEvenCartanF4 K false)) := by
  simpa only [LargeEvenRawDatum, LargeEvenRecipeChevalley, pow_one] using h

private lemma ltqF4_ggHasLabel_C_of_statedClassicalModel {X : Type} [Group X]
    (h : CFSG.Open.StatedClassicalModel X .PSp 3 2 1) : GGHasLabel ⟨.C, 3, 1⟩ X := by
  obtain ⟨-, K, hKfield, hKfin, hKcard, he⟩ := h
  refine ⟨K, hKfield, hKfin, ?_, ?_⟩
  · simpa using hKcard
  · change Nonempty (X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSp 3 K))
    exact he

private lemma ltqF4_comp_statement {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) :
    ∀ (L' : Type) [Group L'] [Finite L']
      (ψ : L' →* LargeEvenCenterQuot (LargeEvenChevH LargeEvenCartanF4 K false)),
      Function.Surjective ψ → ψ.ker ≤ Subgroup.center L' → commutator L' = ⊤ →
      ∀ e : MulAut L', e ^ 3 = 1 → e ≠ 1 →
        (∃ φ ∈ LargeEvenChevIDImage LargeEvenCartanF4 K
            (LargeEvenChevH LargeEvenCartanF4 K false),
          ∀ l : L', φ (ψ l) = ψ (e l)) →
        ∀ J : Subgroup L', CFSG.Assembly.IsComponentOf J (ggFixSub e) →
          ∃ labJ : LargeEvenLabel, labJ ∈ [⟨.C, 3, 1⟩] ∧
            GGHasLabel labJ (↥J ⧸ Subgroup.center ↥J) := by
  intro L' _ _ ψ hψ hker hperf e he he1 hφind J hJ
  obtain ⟨φ, hφI, hφ⟩ := hφind
  refine TCJ.ggTCJ_cover_prop (p := 3) ψ hψ hker e he φ hφ
    (fun X _ => ∃ labJ : LargeEvenLabel, labJ ∈ [⟨.C, 3, 1⟩] ∧ GGHasLabel labJ X)
    (fun X Y _ _ ex h => ?_) ?_ J hJ
  · obtain ⟨labJ, hmem, hlab⟩ := h
    exact ⟨labJ, hmem, ggHasLabel_of_mulEquiv ex hlab⟩
  · intro hφp Kcomp hKcomp
    have hKsub : Subsingleton Kˣ := by
      have h1 : Nat.card Kˣ = 1 := by rw [Nat.card_units, hK]
      exact (Nat.card_eq_one_iff_unique.mp h1).1
    obtain ⟨r, hr⟩ := (chevIDImage_subset_inn_of_subsingleton
      (A := LargeEvenCartanF4) (H := LargeEvenChevH LargeEvenCartanF4 K false)) hφI
    let eR : LargeEvenCenterQuot (LargeEvenChevH LargeEvenCartanF4 K false) ≃*
        ↥(adjointGroup Tag.F4 K) := TableBExc.recipeEquiv .F4 K
    let x : ↥(adjointGroup Tag.F4 K) := eR r
    have hconj : MulAut.congr eR φ = MulAut.conj x := by
      rw [← hr]
      ext y
      simp only [MulAut.congr_apply, MulEquiv.trans_apply, MulAut.conj_apply, map_mul, map_inv,
        MulEquiv.apply_symm_apply]
      rfl
    have hφ1 : φ ≠ 1 := by
      intro hphi
      apply he1
      refine CFSG.HardMathSupport.Dickson.Bal207.mulAut_eq_one_of_forall_mem_center hperf e ?_
      intro y
      apply hker
      rw [MonoidHom.mem_ker, map_mul, map_inv]
      have hy : ψ (e y) = ψ y := by
        have h := congrArg (fun f : MulAut _ => f (ψ y)) hphi
        rw [hφ] at h
        exact h
      rw [hy, inv_mul_cancel]
    have hx1 : x ≠ 1 := by
      intro hx
      apply hφ1
      have h1 : MulAut.congr eR φ = 1 := by rw [hconj, hx, map_one]
      exact (MulAut.congr eR).injective (by rw [h1, map_one])
    have hx3 : x ^ 3 = 1 := by
      have h3 : MulAut.conj (x ^ 3) = 1 := by
        rw [map_pow, ← hconj, ← map_pow, hφp, map_one]
      have hc : x ^ 3 ∈ Subgroup.center ↥(adjointGroup Tag.F4 K) := by
        rw [Subgroup.mem_center_iff]
        intro g
        have hg := congrArg (fun f : MulAut ↥(adjointGroup Tag.F4 K) => f g) h3
        rw [MulAut.conj_apply, MulAut.one_apply] at hg
        calc g * x ^ 3 = (x ^ 3 * g * (x ^ 3)⁻¹) * x ^ 3 := by rw [hg]
          _ = x ^ 3 * g := by group
      rwa [CFSG.LieType.Chevalley.center_adjointGroup_eq_bot, Subgroup.mem_bot] at hc
    have hx : orderOf x = 3 := by
      haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
      exact orderOf_eq_prime hx3 hx1
    have hfixeq : ggFixSub φ = CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup φ :=
      Subgroup.ext (fun y => by
        rw [mem_ggFixSub, CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup])
    have hKcompOpen : CFSG.Open.IsComponentOf Kcomp
        (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup φ) := by
      rw [← hfixeq]
      exact (CFSG.Assembly.isComponentOf_iff_open).mp hKcomp
    let L : Subgroup ↥(adjointGroup Tag.F4 K) :=
      Kcomp.map (eR : LargeEvenCenterQuot (LargeEvenChevH LargeEvenCartanF4 K false) →*
        ↥(adjointGroup Tag.F4 K))
    have hmapfix : CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj x) =
        (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup φ).map
          (eR : _ →* ↥(adjointGroup Tag.F4 K)) := by
      rw [← hconj]
      exact CFSG.HardMathSupport.Dickson.Bal207.fixSubgroup_mulAutCongr eR φ
    have hL : CFSG.Open.IsComponentOf L
        (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj x)) := by
      have h1 := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map eR hKcompOpen
      rw [hmapfix]
      exact h1
    have hle : ∀ J' : Subgroup ↥(adjointGroup Tag.F4 K),
        CFSG.Open.IsComponentOf J'
          (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj x)) → J' ≤ L := by
      intro J' hJ'
      rw [CFSG.LocalAnalysis.GLTheoremA.CatB.I2610.eq_of_isComponentOf_fixSubgroup_conj
        hK hx hJ' hL]
    have hSC : CFSG.Open.StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSp 3 2 1 :=
      CFSG.LocalAnalysis.GLTheoremA.S265.SG.model_of_le_component_F4 (F := K) (f := 1)
        (by simpa using hK) (by norm_num) x hx hL hle
    have hlabelL : GGHasLabel ⟨.C, 3, 1⟩ (↥L ⧸ Subgroup.center ↥L) :=
      ltqF4_ggHasLabel_C_of_statedClassicalModel hSC
    let eL : ↥Kcomp ≃* ↥L := Kcomp.equivMapOfInjective
      (eR : _ →* ↥(adjointGroup Tag.F4 K)) eR.injective
    exact ⟨⟨.C, 3, 1⟩, by simp,
      ggHasLabel_of_mulEquiv
        (CFSG.HardMathSupport.Dickson.Bal207.centerQuotientCongr eL).symm hlabelL⟩

theorem ggF4TwoThreeComp_holds :
    GGF4TwoThreeComp := by
  intro Q hQ
  obtain ⟨K, hKfield, hKfin, hKcard, hQK⟩ := ltqF4_recipe_data hQ
  simp only [LargeEvenRawDatum, LargeEvenRecipeChevalley, pow_one]
  refine ⟨K, hKfield, hKfin, hKcard, hQK, ?_⟩
  exact ltqF4_comp_statement hKcard

