private theorem apply_eq_self_of_pow_three {K : Type} [Field K] {δ : K ≃+* K} (hδ : δ ^ 3 = 1)
    {c : K} (hc : c ^ 3 = 1) : δ c = c := by
  by_cases hc1 : c = 1
  · rw [hc1, map_one]
  have hq : c ^ 2 + c + 1 = 0 := by
    have h : (c - 1) * (c ^ 2 + c + 1) = 0 := by linear_combination hc
    exact (mul_eq_zero.1 h).resolve_left (sub_ne_zero.2 hc1)
  have hqy : δ c ^ 2 + δ c + 1 = 0 := by
    have h := congrArg δ hq
    rwa [map_add, map_add, map_pow, map_one, map_zero] at h
  have hfac : (δ c - c) * (δ c - c ^ 2) = 0 := by linear_combination hqy - δ c * hq + hc
  refine sub_eq_zero.1 ((mul_eq_zero.1 hfac).resolve_right fun h => hc1 ?_)
  have hy : δ c = c ^ 2 := sub_eq_zero.1 h
  have h3 : δ (δ (δ c)) = c := by
    have h := RingEquiv.ext_iff.1 hδ c
    rwa [pow_succ, pow_succ, pow_one, RingAut.mul_apply, RingAut.mul_apply] at h
  rw [hy, map_pow, hy, map_pow, map_pow, hy] at h3
  have h8 : c ^ 2 = c := by
    calc c ^ 2 = ((c ^ 2) ^ 2) ^ 2 := by linear_combination (-(c ^ 5 + c ^ 2)) * hc
      _ = c := h3
  have hc0 : c ≠ 0 := by
    rintro rfl
    norm_num at hc
  exact mul_left_cancel₀ hc0 (by rw [mul_one, ← pow_two, h8])

private theorem three_dvd_of_three_dvd_pow_mul {d : ℕ} (h : 3 ∣ 2 ^ (3 * d) + 1) :
    3 ∣ 2 ^ d + 1 := by
  rw [pow_mul', Nat.dvd_iff_mod_eq_zero, Nat.add_mod, Nat.pow_mod] at h
  rw [Nat.dvd_iff_mod_eq_zero, Nat.add_mod]
  have hm : 2 ^ d % 3 < 3 := Nat.mod_lt _ (by norm_num)
  generalize 2 ^ d % 3 = m at h hm ⊢
  interval_cases m <;> simp_all

private theorem exists_eq_conj_of_induces
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (hs : IsSimpleGroup (TwE6Delta.RecipeR K n))
    (hna : ∃ a b : TwE6Delta.RecipeR K n, a * b ≠ b * a)
    (hconj : GGRawFieldConj 3 (TwE6Delta.RecipeR K n) (TwE6Delta.RecipeI K n)
      (LargeEvenChevFieldImage (LargeEvenCartanE 6) K (TwE6Delta.RecipeH K n)))
    {L' : Type} [Group L'] {ψ : L' →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center L') (hperf : commutator L' = ⊤)
    {x : MulAut (TwE6Delta.RecipeR K n)}
    (hx : x ∈ Subgroup.closure (TwE6Delta.RecipeI K n ∪
      LargeEvenChevFieldImage (LargeEvenCartanE 6) K (TwE6Delta.RecipeH K n)))
    (hxI : x ∉ TwE6Delta.RecipeI K n) (hx3 : x ^ 3 = 1) {b : MulAut L'}
    (hb : ∀ l, x (ψ l) = ψ (b l)) {a : MulAut L'} (hab : a * b = b * a)
    {φ : MulAut (TwE6Delta.RecipeR K n)} (hφ : φ ∈ TwE6Delta.RecipeI K n)
    (hφa : ∀ l, φ (ψ l) = ψ (a l)) :
    ∃ k : L', a = MulAut.conj k ∧ φ = MulAut.conj (ψ k) := by
  have hcomm : φ * x = x * φ := TypeA.induced_unique ψ hψ (a := a * b)
    (fun l => by rw [MulAut.mul_apply, MulAut.mul_apply, hb, hφa])
    (fun l => by rw [hab, MulAut.mul_apply, MulAut.mul_apply, hφa, hb])
  obtain ⟨r, hr⟩ := mem_range_conj_of_commute_field hn hK hs hna hconj hx hxI hx3 hφ hcomm
  obtain ⟨k, rfl⟩ := hψ r
  refine ⟨k, TypeA.mulAut_eq_of_forall ψ hker hperf fun l => ?_, hr.symm⟩
  rw [← hφa, ← hr, MulAut.conj_apply, MulAut.conj_apply, map_mul, map_mul, map_inv]

private theorem exists_conj_mul_pow
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (ε : ↥(twistedE6RootGroup K σ) ≃* TwE6Delta.RecipeR K n)
    (hε : ∀ y, MulAut.congr ε y ∈ TwE6Delta.RecipeI K n ↔ y ∈ (RecipeExcLang.twConj K σ).range)
    {δ : K ≃+* K} (hδ : orderOf δ = 3) {L' : Type} [Group L']
    {ψ : L' →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ) {A : Subgroup (MulAut L')}
    (hA : IsElemAbelian 3 A)
    (hAind : ∀ a ∈ A, ∃ φ : MulAut (TwE6Delta.RecipeR K n), ∀ l, φ (ψ l) = ψ (a l))
    {b : MulAut L'} (hbA : b ∈ A)
    (hb : ∀ l, MulAut.congr ε (fieldActor (t := TwistTag.E6) σ δ) (ψ l) = ψ (b l))
    (hinner : ∀ a ∈ A, ∀ φ ∈ TwE6Delta.RecipeI K n, (∀ l, φ (ψ l) = ψ (a l)) →
      ∃ k : L', a = MulAut.conj k ∧ φ = MulAut.conj (ψ k)) :
    ∀ a ∈ A, ∃ k : L', MulAut.conj k ∈ A ∧ ∃ j < 3, a = MulAut.conj k * b ^ j := by
  classical
  obtain ⟨-, -, -, -, -, -, -, -, ⟨Θ, hΘ, -, hker, -⟩, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hn K hK σ hσ
  have hΘf : ∀ δ', Θ (fieldActor (t := TwistTag.E6) σ δ') = δ' := fun δ' =>
    hΘ _ 1 1 δ' (by rw [map_one, map_one, one_mul, one_mul])
  have hΘ1 : ∀ y, Θ y = 1 → y ∈ (RecipeExcLang.twConj K σ).range := fun y hy => by
    have hy' : y ∈ Θ.ker := hy
    rw [hker, ← range_twistedE6InndiagConj] at hy'
    exact TwE6EndNode3.range_twistedE6InndiagConj_le σ hy'
  have : IsCyclic (K ≃+* K) := CFSG.LocalAnalysis.GLTheoremA.FP.isCyclic_ringEquiv K
  have : Finite (K ≃+* K) :=
    Finite.of_injective (fun g : K ≃+* K => (g : K → K)) DFunLike.coe_injective
  intro a ha
  obtain ⟨φ, hφa⟩ := hAind a ha
  have hφ3 : φ ^ 3 = 1 := TypeA.induced_unique ψ hψ (TypeA.induced_pow ψ hφa 3) fun l => by
    rw [hA.2 a ha]
    rfl
  have hθ : Θ ((MulAut.congr ε).symm φ) ∈ Subgroup.zpowers δ := by
    have h3 : Θ ((MulAut.congr ε).symm φ) ^ 3 = 1 := by
      rw [← map_pow, ← map_pow, hφ3, map_one, map_one]
    rcases (Nat.dvd_prime Nat.prime_three).1 (orderOf_dvd_of_pow_eq_one h3) with h1 | h1
    · rw [orderOf_eq_one_iff.1 h1]
      exact Subgroup.one_mem _
    · have hz : Subgroup.zpowers (Θ ((MulAut.congr ε).symm φ)) = Subgroup.zpowers δ := by
        rw [IsCyclic.subgroup_eq_iff_card_eq, Nat.card_zpowers, Nat.card_zpowers, h1, hδ]
      exact hz ▸ Subgroup.mem_zpowers _
  obtain ⟨j, hj, hθj⟩ : ∃ j < 3, δ ^ j = Θ ((MulAut.congr ε).symm φ) := by
    obtain ⟨j, hj, hθj⟩ := Finset.mem_image.1 (mem_zpowers_iff_mem_range_orderOf.1 hθ)
    exact ⟨j, hδ ▸ Finset.mem_range.1 hj, hθj⟩
  have hbj := TypeA.induced_pow ψ hb j
  have hφ₀ : ∀ l, (φ * (MulAut.congr ε (fieldActor (t := TwistTag.E6) σ δ) ^ j)⁻¹) (ψ l) =
      ψ ((a * (b ^ j)⁻¹) l) := by
    intro l
    have hinv : (MulAut.congr ε (fieldActor (t := TwistTag.E6) σ δ) ^ j)⁻¹ (ψ l) =
        ψ ((b ^ j)⁻¹ l) := by
      apply (MulAut.congr ε (fieldActor (t := TwistTag.E6) σ δ) ^ j).injective
      rw [MulAut.apply_inv_self, hbj, MulAut.apply_inv_self]
    rw [MulAut.mul_apply, MulAut.mul_apply, hinv, hφa]
  have hφ₀I : φ * (MulAut.congr ε (fieldActor (t := TwistTag.E6) σ δ) ^ j)⁻¹ ∈
      TwE6Delta.RecipeI K n := by
    have h := (hε ((MulAut.congr ε).symm
      (φ * (MulAut.congr ε (fieldActor (t := TwistTag.E6) σ δ) ^ j)⁻¹))).2 (hΘ1 _ (by
        rw [map_mul, map_inv, map_pow, MulEquiv.symm_apply_apply, map_mul, map_inv, map_pow, hΘf,
          ← hθj, mul_inv_cancel]))
    rwa [MulEquiv.apply_symm_apply] at h
  have hmem : a * (b ^ j)⁻¹ ∈ A := mul_mem ha (inv_mem (pow_mem hbA j))
  obtain ⟨k, hk, -⟩ := hinner _ hmem _ hφ₀I hφ₀
  exact ⟨k, hk ▸ hmem, j, hj, by rw [← hk, inv_mul_cancel_right]⟩

private theorem card_inf_range_conj {L' : Type} [Group L'] {A : Subgroup (MulAut L')}
    (hcard : Nat.card A = 3 ^ 5) {b : MulAut L'} (hbA : b ∈ A)
    (hb : b ∉ (MulAut.conj : L' →* MulAut L').range)
    (hAb : ∀ a ∈ A, ∃ k : L', MulAut.conj k ∈ A ∧ ∃ j < 3, a = MulAut.conj k * b ^ j) :
    Nat.card ↥(A ⊓ (MulAut.conj : L' →* MulAut L').range) = 3 ^ 4 := by
  have : Finite A := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  have : Finite ↥(A ⊓ (MulAut.conj : L' →* MulAut L').range) :=
    Finite.of_injective _ (Subgroup.inclusion_injective inf_le_left)
  let f : ↥(A ⊓ (MulAut.conj : L' →* MulAut L').range) × Fin 3 → A := fun p =>
    ⟨p.1 * b ^ (p.2 : ℕ), mul_mem (inf_le_left (b := (MulAut.conj : L' →* MulAut L').range) p.1.2)
      (pow_mem hbA _)⟩
  have hf : Function.Surjective f := by
    rintro ⟨a, ha⟩
    obtain ⟨k, hkA, j, hj, rfl⟩ := hAb a ha
    exact ⟨(⟨MulAut.conj k, hkA, k, rfl⟩, ⟨j, hj⟩), rfl⟩
  have hle := Nat.card_le_card_of_surjective f hf
  rw [Nat.card_prod, Nat.card_eq_fintype_card (α := Fin 3), Fintype.card_fin, hcard] at hle
  have hdvd : Nat.card ↥(A ⊓ (MulAut.conj : L' →* MulAut L').range) ∣ 3 ^ 5 :=
    hcard ▸ Subgroup.card_dvd_of_le inf_le_left
  have hne : Nat.card ↥(A ⊓ (MulAut.conj : L' →* MulAut L').range) ≠ 3 ^ 5 := by
    intro h
    have heq : A ⊓ (MulAut.conj : L' →* MulAut L').range = A :=
      Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [hcard, h])
    have hb' : b ∈ A ⊓ (MulAut.conj : L' →* MulAut L').range := by rw [heq]; exact hbA
    exact hb (Subgroup.mem_inf.1 hb').2
  obtain ⟨m, hm, hm'⟩ := (Nat.dvd_prime_pow Nat.prime_three).1 hdvd
  rw [hm'] at hle hne ⊢
  interval_cases m <;> simp_all

private theorem rgrpModel_eq
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n) {Ω : Type} [Field Ω] [Algebra K Ω]
    [IsAlgClosure K Ω] (Fr : Ω →+* Ω) (hFr : ∀ c, Fr c = c ^ 2 ^ n)
    (ε : ↥(twistedE6RootGroup K σ) ≃* TwE6Delta.RecipeR K n) {L' : Type} [Group L']
    {ψ : L' →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ) (A : Subgroup (MulAut L')) :
    rgrpModel hn hK σ hσ Fr hFr ε
        (TypeA.inducedSub ψ (A ⊓ (MulAut.conj : L' →* MulAut L').range)) =
      ((((A.comap (MulAut.conj : L' →* MulAut L')).map ψ).map ε.symm.toMonoidHom).map
        (twistedE6RootGroup K σ).subtype).map (baseChangeGL (τ := Tag.E6) (algebraMap K Ω)) := by
  have hre : ∀ e : ↥(twistedE6RootGroup K σ), rgrpRecipeAut hn hK σ hσ Fr hFr ε
      (twInndiagEquivRgrp hn hK σ hσ Fr hFr
        ⟨e, RecipeExcLang.graphFixedRootGroup_le_twInndiag σ e.2⟩) = MulAut.conj (ε e) := by
    intro e
    change MulAut.congr ε (rgrpConjAut hn hK σ hσ Fr hFr (twInndiagEquivRgrp hn hK σ hσ Fr hFr
      ⟨e, RecipeExcLang.graphFixedRootGroup_le_twInndiag σ e.2⟩)) = _
    rw [rgrpConjAut_apply_baseChange, RecipeExcLang.twConj_of_mem_C0, CFSG.mulAut_congr_conj]
  have hind : ∀ k l, MulAut.conj (ψ k) (ψ l) = ψ (MulAut.conj k l) := fun k l => by
    rw [MulAut.conj_apply, MulAut.conj_apply, map_mul, map_mul, map_inv]
  ext y
  rw [mem_rgrpModel]
  constructor
  · rintro ⟨hy, a, ⟨haA, k, rfl⟩, hφa⟩
    have h1 : rgrpRecipeAut hn hK σ hσ Fr hFr ε ⟨y, hy⟩ = rgrpRecipeAut hn hK σ hσ Fr hFr ε
        (twInndiagEquivRgrp hn hK σ hσ Fr hFr
          ⟨ε.symm (ψ k), RecipeExcLang.graphFixedRootGroup_le_twInndiag σ (ε.symm (ψ k)).2⟩) := by
      rw [hre, MulEquiv.apply_symm_apply]
      exact TypeA.induced_unique ψ hψ hφa (hind k)
    have h2 := congrArg Subtype.val (rgrpRecipeAut_injective hn hK σ hσ Fr hFr ε h1)
    exact ⟨_, ⟨ε.symm (ψ k), ⟨ψ k, ⟨k, haA, rfl⟩, rfl⟩, rfl⟩, h2.symm⟩
  · rintro ⟨_, ⟨_, ⟨_, ⟨k, hkA, rfl⟩, rfl⟩, rfl⟩, rfl⟩
    refine ⟨(twInndiagEquivRgrp hn hK σ hσ Fr hFr
      ⟨ε.symm (ψ k), RecipeExcLang.graphFixedRootGroup_le_twInndiag σ (ε.symm (ψ k)).2⟩).2, ?_⟩
    change rgrpRecipeAut hn hK σ hσ Fr hFr ε (twInndiagEquivRgrp hn hK σ hσ Fr hFr
      ⟨ε.symm (ψ k), RecipeExcLang.graphFixedRootGroup_le_twInndiag σ (ε.symm (ψ k)).2⟩) ∈ _
    rw [hre, MulEquiv.apply_symm_apply]
    exact ⟨MulAut.conj k, ⟨hkA, k, rfl⟩, hind k⟩

theorem ggHeisFieldCompRad_recipe_of_lineLang
    {n : ℕ} (hn : 1 ≤ n) (h3 : 3 ∣ 2 ^ n + 1) {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ n) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (hLang : ∀ h : twistedE6InndiagGL K σ, h ≠ 1 → h ^ 3 = 1 →
      Nonempty (TwE6LineLangIota K σ (2 ^ n) h))
    (hconj : GGRawFieldConj 3 (TwE6Delta.RecipeR K n) (TwE6Delta.RecipeI K n)
      (LargeEvenChevFieldImage (LargeEvenCartanE 6) K (TwE6Delta.RecipeH K n)))
    (hs : IsSimpleGroup (TwE6Delta.RecipeR K n))
    (hna : ∃ a b : TwE6Delta.RecipeR K n, a * b ≠ b * a) :
