theorem parabolic_inndiag_Levi
    (τ : Tag) (K : Type) [Field K] [Finite K] (J : Set (Fin τ.rank)) :
    (rootDiagUnitHom τ K).range ≤ normalizer (parabolicRadical τ K J : Set (ModGL τ K)) ∧
    (rootDiagUnitHom τ K).range ≤ normalizer (parabolicLevi τ K J : Set (ModGL τ K)) ∧
    adjointGroup τ K ⊓ (rootDiagUnitHom τ K).range ≤ torusGroup τ K ∧
    parabolicRadical τ K J ⊓ (parabolicLevi τ K J ⊔ (rootDiagUnitHom τ K).range) = ⊥ ∧
    (adjointGroup τ K ⊔ (rootDiagUnitHom τ K).range) ⊓
        normalizer (parabolicRadical τ K J : Set (ModGL τ K)) =
      parabolicSubgroup τ K J ⊔ (rootDiagUnitHom τ K).range ∧
    ∀ y ∈ parabolicSubgroup τ K J ⊔ (rootDiagUnitHom τ K).range,
      ∃ u ∈ parabolicRadical τ K J, ∃ m ∈ parabolicLevi τ K J ⊔ (rootDiagUnitHom τ K).range,
        y = u * m := by
  classical
  obtain ⟨hQP, -, -, hMP, hQM, -, huniq, -⟩ := parabolic_root_radical_Levi_factors τ K J
  have hN := adjointGroup_inf_normalizer_parabolicRadical (τ := τ) (K := K) J
  have hPS := parabolicSubgroup_le_adjointGroup τ K J
  set D : Subgroup (ModGL τ K) := (rootDiagUnitHom τ K).range with hD
  set S := adjointGroup τ K
  set Q := parabolicRadical τ K J
  set M := parabolicLevi τ K J
  set P := parabolicSubgroup τ K J
  have hPN : P ≤ normalizer (Q : Set (ModGL τ K)) := by rw [← hN]; exact inf_le_right
  have split : ∀ {H T : Subgroup (ModGL τ K)}, T ≤ normalizer (H : Set (ModGL τ K)) →
      ∀ x ∈ H ⊔ T, ∃ h ∈ H, ∃ t ∈ T, x = h * t := by
    intro H T hT x hx
    have hx' : x ∈ ((H ⊔ T : Subgroup (ModGL τ K)) : Set (ModGL τ K)) := hx
    rw [Subgroup.coe_mul_of_right_le_normalizer_left H T hT] at hx'
    obtain ⟨h, hh, t, ht, rfl⟩ := hx'
    exact ⟨h, hh, t, ht, rfl⟩
  have memD : ∀ y, y ∈ D ↔ ∃ a, rootDiagUnit τ a = y := fun y => Iff.rfl
  have h1 : D ≤ normalizer (Q : Set (ModGL τ K)) := by
    rintro _ ⟨a, rfl⟩
    exact CFSG.LieType.SeitzGeneration.ExcWideThree.rootDiagUnit_mem_normalizer_parabolicRadical a J
  have hmapM : ∀ a, M.map (MulAut.conj (rootDiagUnit τ a)).toMonoidHom ≤ M := by
    intro a
    simp only [M, parabolicLevi, Subgroup.map_sup, MonoidHom.map_closure]
    refine sup_le_sup ?_ ((Subgroup.closure_mono ?_))
    · rintro _ ⟨h, hh, rfl⟩
      change rootDiagUnit τ a * h * (rootDiagUnit τ a)⁻¹ ∈ torusGroup τ K
      rw [rootDiagUnit_mul_comm_of_mem_torusGroup a hh, mul_inv_cancel_right]
      exact hh
    · rintro _ ⟨g, ⟨j, hj, c, hg⟩, rfl⟩
      obtain ⟨hx, hy, -⟩ := root_diagonal_conjugation τ K a
      rcases hg with rfl | rfl
      · exact ⟨j, hj, (a j : K) * c, Or.inl (hx j c)⟩
      · exact ⟨j, hj, ((a j)⁻¹ : Kˣ) * c, Or.inr (hy j c)⟩
  have h2 : D ≤ normalizer (M : Set (ModGL τ K)) := by
    rintro _ ⟨a, rfl⟩
    rw [mem_normalizer_iff]
    intro h
    constructor
    · intro hh; exact hmapM a ⟨h, hh, rfl⟩
    · intro hh
      have := hmapM a⁻¹ ⟨_, hh, rfl⟩
      change rootDiagUnit τ a⁻¹ * (rootDiagUnit τ a * h * (rootDiagUnit τ a)⁻¹) *
        (rootDiagUnit τ a⁻¹)⁻¹ ∈ M at this
      have e : rootDiagUnit τ a⁻¹ = (rootDiagUnit τ a)⁻¹ := map_inv (rootDiagUnitHom τ K) a
      rw [e] at this
      simpa [mul_assoc] using this
  have h3 : S ⊓ D ≤ torusGroup τ K := by
    rintro y ⟨hyS, a, rfl⟩
    exact CFSG.SeitzReduction.E6Pilot.rootDiagUnit_mem_torusGroup_of_mem_adjointGroup a hyS
  have hTM : torusGroup τ K ≤ M := le_sup_left
  have hMS : M ≤ S := hMP.trans hPS
  have hQS : Q ≤ S := hQP.trans hPS
  have h4 : Q ⊓ (M ⊔ D) = ⊥ := by
    rw [eq_bot_iff]
    rintro u ⟨huQ, huMD⟩
    obtain ⟨m, hm, d, hd, rfl⟩ := split h2 _ huMD
    have hdS : d ∈ S := by
      have : d = m⁻¹ * (m * d) := by group
      rw [this]; exact S.mul_mem (S.inv_mem (hMS hm)) (hQS huQ)
    have hdM : d ∈ M := hTM (h3 ⟨hdS, hd⟩)
    have : m * d ∈ Q ⊓ M := ⟨huQ, M.mul_mem hm hdM⟩
    rwa [hQM] at this
  have hDS : D ≤ normalizer (S : Set (ModGL τ K)) := by
    rintro _ ⟨a, rfl⟩
    exact (root_diagonal_conjugation τ K a).2.2
  have h5 : (S ⊔ D) ⊓ normalizer (Q : Set (ModGL τ K)) = P ⊔ D := by
    apply le_antisymm
    · rintro y ⟨hy, hyN⟩
      obtain ⟨s, hs, d, hd, rfl⟩ := split hDS y hy
      have hsN : s ∈ normalizer (Q : Set (ModGL τ K)) := by
        have : s = (s * d) * d⁻¹ := by group
        rw [this]; exact Subgroup.mul_mem _ hyN (Subgroup.inv_mem _ (h1 hd))
      have hsP : s ∈ P := by rw [← hN]; exact ⟨hs, hsN⟩
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hsP) (Subgroup.mem_sup_right hd)
    · exact sup_le (le_inf (hPS.trans le_sup_left) hPN) (le_inf le_sup_right h1)
  refine ⟨h1, h2, h3, h4, h5, ?_⟩
  intro y hy
  have hy' : y ∈ (S ⊔ D) ⊓ normalizer (Q : Set (ModGL τ K)) := by rw [h5]; exact hy
  obtain ⟨s, hs, d, hd, hsd⟩ := split hDS y hy'.1
  have hsN : s ∈ normalizer (Q : Set (ModGL τ K)) := by
    have : s = y * d⁻¹ := by rw [hsd]; group
    rw [this]; exact Subgroup.mul_mem _ hy'.2 (Subgroup.inv_mem _ (h1 hd))
  have hsP : s ∈ P := by rw [← hN]; exact ⟨hs, hsN⟩
  obtain ⟨⟨u, m⟩, ⟨hu, hm, hum⟩, -⟩ := huniq s hsP
  refine ⟨u, hu, m * d,
    Subgroup.mul_mem _ (Subgroup.mem_sup_left hm) (Subgroup.mem_sup_right hd), ?_⟩
  rw [hsd, hum, mul_assoc]

theorem exists_odd_lift_inndiag
    (τ : Tag) (K : Type) [Field K] [Finite K] [CharP K 2]
    (A : Subgroup (MulAut ↥(adjointGroup τ K))) (hA : Odd (Nat.card A))
    (hAI : A ≤ LayerSixE.inndiagAut τ K) :
    ∃ Â : Subgroup (ModGL τ K), Â ≤ adjointGroup τ K ⊔ (rootDiagUnitHom τ K).range ∧
      Odd (Nat.card Â) ∧
      (LayerSixE.autFix A).map (adjointGroup τ K).subtype =
        adjointGroup τ K ⊓ centralizer (Â : Set (ModGL τ K)) := by
  classical
  haveI : Finite (ModGL τ K) := finite_modGL
  have hDS : (rootDiagUnitHom τ K).range ≤ normalizer (adjointGroup τ K : Set (ModGL τ K)) := by
    rintro _ ⟨a, rfl⟩
    exact (root_diagonal_conjugation τ K a).2.2
  have hHN : adjointGroup τ K ⊔ (rootDiagUnitHom τ K).range ≤
      normalizer (adjointGroup τ K : Set (ModGL τ K)) := sup_le Subgroup.le_normalizer hDS
  obtain ⟨ψ, hψapp⟩ : ∃ ψ : ↥(adjointGroup τ K ⊔ (rootDiagUnitHom τ K).range) →*
      MulAut ↥(adjointGroup τ K), ∀ h x, ((ψ h x : adjointGroup τ K) : ModGL τ K) =
        (h : ModGL τ K) * x * (h : ModGL τ K)⁻¹ :=
    ⟨(adjointGroup τ K).normalizerMonoidHom.comp (Subgroup.inclusion hHN),
      fun h x => Subgroup.normalizerMonoidHom_apply_apply_coe _ _ x⟩
  have hAψ : A ≤ ψ.range := by
    refine hAI.trans (sup_le ?_ ?_)
    · rintro _ ⟨s, rfl⟩
      refine ⟨⟨s, Subgroup.mem_sup_left s.2⟩, ?_⟩
      ext x
      rw [hψapp]; rfl
    · rintro _ ⟨a, rfl⟩
      refine ⟨⟨rootDiagUnit τ a, Subgroup.mem_sup_right ⟨a, rfl⟩⟩, ?_⟩
      ext x
      rw [hψapp]; rfl
  refine ⟨(A.comap ψ).map (adjointGroup τ K ⊔ (rootDiagUnitHom τ K).range).subtype,
    Subgroup.map_subtype_le _, ?_, ?_⟩
  ·
    rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective _)]
    by_contra hev
    rw [Nat.not_odd_iff_even, even_iff_two_dvd] at hev
    obtain ⟨⟨y, hyA⟩, hy2⟩ := exists_prime_orderOf_dvd_card' (G := A.comap ψ) 2 hev
    have hy1 : y ≠ 1 := by
      intro h; subst h
      have : orderOf (1 : A.comap ψ) = 2 := by simpa using hy2
      simp at this
    have hysq : y ^ 2 = 1 := by
      have := pow_orderOf_eq_one (⟨y, hyA⟩ : A.comap ψ)
      rw [hy2] at this
      exact congrArg Subtype.val this
    have hψy : ψ y = 1 := by
      have hpow : (⟨ψ y, hyA⟩ : A) ^ 2 = 1 := Subtype.ext (by simp [← map_pow, hysq])
      have hdvd1 : orderOf (⟨ψ y, hyA⟩ : A) ∣ 2 := orderOf_dvd_of_pow_eq_one hpow
      have hdvd2 : orderOf (⟨ψ y, hyA⟩ : A) ∣ Nat.card A := orderOf_dvd_natCard _
      have hcop : Nat.Coprime 2 (Nat.card A) := Nat.coprime_two_left.mpr hA
      have := Nat.eq_one_of_dvd_coprimes hcop hdvd1 hdvd2
      exact congrArg Subtype.val (orderOf_eq_one_iff.mp this)
    have hy' : (y : ModGL τ K) ∈
        ((adjointGroup τ K ⊔ (rootDiagUnitHom τ K).range : Subgroup (ModGL τ K)) :
          Set (ModGL τ K)) := y.2
    rw [Subgroup.coe_mul_of_right_le_normalizer_left _ _ hDS] at hy'
    obtain ⟨s, hs, d, ⟨a, rfl⟩, hsd⟩ := hy'
    change s * rootDiagUnit τ a = (y : ModGL τ K) at hsd
    have hd2 : rootDiagUnit τ a ^ 2 ∈ adjointGroup τ K := by
      have h1 : (y : ModGL τ K) ^ 2 = 1 := congrArg Subtype.val hysq
      rw [← hsd] at h1
      have ht : rootDiagUnit τ a * s * (rootDiagUnit τ a)⁻¹ ∈ adjointGroup τ K :=
        (mem_normalizer_iff.mp (hDS ⟨a, rfl⟩) s).mp hs
      have h2 : s * (rootDiagUnit τ a * s * (rootDiagUnit τ a)⁻¹) * rootDiagUnit τ a ^ 2 = 1 := by
        calc s * (rootDiagUnit τ a * s * (rootDiagUnit τ a)⁻¹) * rootDiagUnit τ a ^ 2
            = (s * rootDiagUnit τ a) * (s * rootDiagUnit τ a) := by group
          _ = 1 := by rw [← sq]; exact h1
      have : rootDiagUnit τ a ^ 2 = (s * (rootDiagUnit τ a * s * (rootDiagUnit τ a)⁻¹))⁻¹ :=
        eq_inv_of_mul_eq_one_right h2
      rw [this]; exact Subgroup.inv_mem _ (Subgroup.mul_mem _ hs ht)
    have hn : rootDiagUnit τ a ^ Nat.card Kˣ = 1 := by
      change rootDiagUnitHom τ K a ^ Nat.card Kˣ = 1
      rw [← map_pow (rootDiagUnitHom τ K) a]
      have : a ^ Nat.card Kˣ = 1 := by
        funext i; simp [Pi.pow_apply, pow_card_eq_one']
      rw [this, map_one]
    have hKodd : Odd (Nat.card Kˣ) := by
      haveI := Fintype.ofFinite K
      rw [Nat.card_eq_fintype_card, Fintype.card_units]
      obtain ⟨n, hn, hcard⟩ := FiniteField.card K 2
      rw [hcard]
      have he : Even (2 ^ (n : ℕ)) := (Nat.even_pow.mpr ⟨even_two, n.ne_zero⟩)
      have hpos : 0 < 2 ^ (n : ℕ) := by positivity
      obtain ⟨k, hk⟩ := he
      exact ⟨k - 1, by omega⟩
    obtain ⟨m, hm⟩ := hKodd
    have hdS : rootDiagUnit τ a ∈ adjointGroup τ K := by
      have : rootDiagUnit τ a = (rootDiagUnit τ a ^ 2) ^ (m + 1) := by
        rw [← pow_mul, show 2 * (m + 1) = Nat.card Kˣ + 1 by omega, pow_succ, hn, one_mul]
      rw [this]; exact Subgroup.pow_mem _ hd2 _
    have hyS : (y : ModGL τ K) ∈ adjointGroup τ K := by
      rw [← hsd]; exact Subgroup.mul_mem _ hs hdS
    have hcen : (⟨y, hyS⟩ : adjointGroup τ K) ∈ Subgroup.center (adjointGroup τ K) := by
      rw [Subgroup.mem_center_iff]
      intro x
      have := congrArg (fun φ : MulAut (adjointGroup τ K) => ((φ x : adjointGroup τ K) :
        ModGL τ K)) hψy
      simp only [hψapp, MulAut.one_apply] at this
      apply Subtype.ext
      change (x : ModGL τ K) * y = y * x
      calc (x : ModGL τ K) * y = (y * x * (y : ModGL τ K)⁻¹) * y := by rw [this]
        _ = y * x := by group
    rw [center_adjointGroup_eq_bot_field, Subgroup.mem_bot] at hcen
    exact hy1 (Subtype.ext (by simpa using congrArg Subtype.val hcen))
  ·
    apply le_antisymm
    · rintro _ ⟨x, hx, rfl⟩
      refine ⟨x.2, Subgroup.mem_centralizer_iff.mpr ?_⟩
      rintro _ ⟨h, hh, rfl⟩
      have := congrArg Subtype.val ((LayerSixE.mem_autFix.mp hx) (ψ h) hh)
      rw [hψapp] at this
      change (h : ModGL τ K) * x = x * h
      calc (h : ModGL τ K) * x = (h * x * (h : ModGL τ K)⁻¹) * h := by group
        _ = x * h := by rw [this]
    · rintro x ⟨hxS, hxc⟩
      refine ⟨⟨x, hxS⟩, LayerSixE.mem_autFix.mpr ?_, rfl⟩
      intro α hα
      obtain ⟨h, rfl⟩ := hAψ hα
      apply Subtype.ext
      rw [hψapp]
      have := (Subgroup.mem_centralizer_iff.mp hxc) h ⟨h, hα, rfl⟩
      change (h : ModGL τ K) * x * (h : ModGL τ K)⁻¹ = x
      rw [this]; group

theorem graphFixedParabolic_inndiag_Levi
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K)
    (J : Set (Fin TwistTag.E6.foldedTag.rank)) :
    let D : Subgroup (ModGL TwistTag.E6.tag K) :=
      (TableB.TwE6.compat σ.toRingHom).map (rootDiagUnitHom TwistTag.E6.tag K)
    let L := graphFixedParabolicLevi TwistTag.E6 K σ.toRingHom J
    let Q := graphFixedParabolicRadical TwistTag.E6 K σ.toRingHom J
    D ≤ normalizer (Q : Set _) ∧ D ≤ normalizer (L : Set _) ∧
    graphFixedRootGroup TwistTag.E6 K σ.toRingHom ⊓ D ≤ L ∧
    Q ⊓ (L ⊔ D) = ⊥ ∧
    (graphFixedRootGroup TwistTag.E6 K σ.toRingHom ⊔ D) ⊓ normalizer (Q : Set _) =
      graphFixedParabolic TwistTag.E6 K σ.toRingHom J ⊔ D ∧
    ∀ y ∈ graphFixedParabolic TwistTag.E6 K σ.toRingHom J ⊔ D,
      ∃ u ∈ Q, ∃ m ∈ L ⊔ D, y = u * m := by
  classical
  intro D L Q
  obtain ⟨-, -, -, -, -, -, hQM0, -, hQP0, -, hLP0, hdec0, -⟩ :=
    diagram_fixed_parabolic_root_radical_Levi_factors TwistTag.E6 K σ J
  have hN0 := diagram_fixed_parabolic_root_radical_normalizers TwistTag.E6 K σ J
  have hU := parabolic_inndiag_Levi TwistTag.E6.tag K (TwistTag.E6.orbitUnion J)
  have hDD : D ≤ (rootDiagUnitHom TwistTag.E6.tag K).range := by
    rintro _ ⟨b, -, rfl⟩; exact ⟨b, rfl⟩
  have hC0S : graphFixedRootGroup TwistTag.E6 K σ.toRingHom ≤ adjointGroup TwistTag.E6.tag K :=
    (graphFixedRootGroup_le TwistTag.E6 K σ.toRingHom).trans inf_le_left
  have hC0F := graphFixedRootGroup_le TwistTag.E6 K σ.toRingHom
  have hQC0 : Q ≤ graphFixedRootGroup TwistTag.E6 K σ.toRingHom :=
    graphFixedParabolicRadical_le_graphFixedRootGroup TwistTag.E6 K σ.toRingHom J
  have hLC0 : L ≤ graphFixedRootGroup TwistTag.E6 K σ.toRingHom := inf_le_right
  have hPC0 := graphFixedParabolic_le TwistTag.E6 K σ.toRingHom J
  have hPN : graphFixedParabolic TwistTag.E6 K σ.toRingHom J ≤ normalizer (Q : Set _) := by
    rw [← hN0]; exact inf_le_right
  have split : ∀ {H T : Subgroup (ModGL TwistTag.E6.tag K)}, T ≤ normalizer (H : Set _) →
      ∀ x ∈ H ⊔ T, ∃ h ∈ H, ∃ t ∈ T, x = h * t := by
    intro H T hT x hx
    have hx' : x ∈ ((H ⊔ T : Subgroup (ModGL TwistTag.E6.tag K)) : Set _) := hx
    rw [Subgroup.coe_mul_of_right_le_normalizer_left H T hT] at hx'
    obtain ⟨h, hh, t, ht, rfl⟩ := hx'
    exact ⟨h, hh, t, ht, rfl⟩
  have h1 : D ≤ normalizer (Q : Set _) := by
    rintro _ ⟨b, hb, rfl⟩
    exact CFSG.LieType.SeitzGeneration.ExcWideThree.mem_normalizer_inf_of_mem_normalizer_twE6
      (hU.1 ⟨b, rfl⟩) (rootDiagUnit_mem_normalizer_twistedFixedGroup hb)
  have hDC0 : D ≤ normalizer (graphFixedRootGroup TwistTag.E6 K σ.toRingHom : Set _) := by
    rintro _ ⟨b, hb, rfl⟩
    exact rootDiagUnit_mem_normalizer_graphFixedRootGroup hb
  have h2 : D ≤ normalizer (L : Set _) := fun d hd =>
    CFSG.LieType.SeitzGeneration.ExcWideThree.mem_normalizer_inf_of_mem_normalizer_twE6
      (hU.2.1 (hDD hd)) (hDC0 hd)
  have h3 : graphFixedRootGroup TwistTag.E6 K σ.toRingHom ⊓ D ≤ L := by
    rintro d ⟨hdC, hdD⟩
    exact ⟨(le_sup_left : torusGroup TwistTag.E6.tag K ≤ _) (hU.2.2.1 ⟨hC0S hdC, hDD hdD⟩), hdC⟩
  have h4 : Q ⊓ (L ⊔ D) = ⊥ := by
    rw [eq_bot_iff]
    rintro u ⟨huQ, huLD⟩
    obtain ⟨l, hl, d, hd, rfl⟩ := split h2 _ huLD
    have hdC : d ∈ graphFixedRootGroup TwistTag.E6 K σ.toRingHom := by
      have : d = l⁻¹ * (l * d) := by group
      rw [this]; exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (hLC0 hl)) (hQC0 huQ)
    have hlL : l * d ∈ L := Subgroup.mul_mem _ hl (h3 ⟨hdC, hd⟩)
    have : l * d ∈ graphFixedParabolicRadical TwistTag.E6 K σ.toRingHom J ⊓
        (parabolicLevi TwistTag.E6.tag K (TwistTag.E6.orbitUnion J) ⊓
          twistedFixedGroup TwistTag.E6 K σ.toRingHom) := ⟨huQ, hlL.1, hC0F hlL.2⟩
    rwa [hQM0] at this
  have h5 : (graphFixedRootGroup TwistTag.E6 K σ.toRingHom ⊔ D) ⊓ normalizer (Q : Set _) =
      graphFixedParabolic TwistTag.E6 K σ.toRingHom J ⊔ D := by
    apply le_antisymm
    · rintro y ⟨hy, hyN⟩
      obtain ⟨c, hc, d, hd, rfl⟩ := split hDC0 y hy
      have hcN : c ∈ normalizer (Q : Set _) := by
        have : c = (c * d) * d⁻¹ := by group
        rw [this]; exact Subgroup.mul_mem _ hyN (Subgroup.inv_mem _ (h1 hd))
      have hcP : c ∈ graphFixedParabolic TwistTag.E6 K σ.toRingHom J := by
        rw [← hN0]; exact ⟨hc, hcN⟩
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hcP) (Subgroup.mem_sup_right hd)
    · exact sup_le (le_inf (hPC0.trans le_sup_left) hPN) (le_inf le_sup_right h1)
  refine ⟨h1, h2, h3, h4, h5, ?_⟩
  intro y hy
  have hy' : y ∈ (graphFixedRootGroup TwistTag.E6 K σ.toRingHom ⊔ D) ⊓ normalizer (Q : Set _) := by
    rw [h5]; exact hy
  obtain ⟨c, hc, d, hd, hcd⟩ := split hDC0 y hy'.1
  have hcN : c ∈ normalizer (Q : Set _) := by
    have : c = y * d⁻¹ := by rw [hcd]; group
    rw [this]; exact Subgroup.mul_mem _ hy'.2 (Subgroup.inv_mem _ (h1 hd))
  have hcP : c ∈ graphFixedParabolic TwistTag.E6 K σ.toRingHom J := by
    rw [← hN0]; exact ⟨hc, hcN⟩
  obtain ⟨⟨u, m⟩, ⟨hu, hm, hum⟩, -⟩ := hdec0 c hcP
  refine ⟨u, hu, m * d,
    Subgroup.mul_mem _ (Subgroup.mem_sup_left hm) (Subgroup.mem_sup_right hd), ?_⟩
  rw [hcd, hum, mul_assoc]

theorem exists_odd_lift_twInndiag
    (K : Type) [Field K] [Finite K] [CharP K 2] (σ : K →+* K)
    (hσ : Function.Surjective σ)
    (A : Subgroup (MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ))) (hA : Odd (Nat.card A))
    (hAI : A ≤ (MulAut.conj : ↥(graphFixedRootGroup TwistTag.E6 K σ) →*
      MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ)).range ⊔ (RootCentExc.compatParamAut σ).range) :
    ∃ Â : Subgroup (ModGL TwistTag.E6.tag K),
      Â ≤ graphFixedRootGroup TwistTag.E6 K σ ⊔
        (TableB.TwE6.compat σ).map (rootDiagUnitHom TwistTag.E6.tag K) ∧
      Odd (Nat.card Â) ∧
      (LayerSixE.autFix A).map (graphFixedRootGroup TwistTag.E6 K σ).subtype =
        graphFixedRootGroup TwistTag.E6 K σ ⊓ centralizer (Â : Set _) := by
  classical
  haveI : Finite (ModGL TwistTag.E6.tag K) := finite_modGL
  have hDS : (TableB.TwE6.compat σ).map (rootDiagUnitHom TwistTag.E6.tag K) ≤
      normalizer (graphFixedRootGroup TwistTag.E6 K σ : Set (ModGL TwistTag.E6.tag K)) := by
    rintro _ ⟨b, hb, rfl⟩
    exact rootDiagUnit_mem_normalizer_graphFixedRootGroup hb
  have hHN : graphFixedRootGroup TwistTag.E6 K σ ⊔
      (TableB.TwE6.compat σ).map (rootDiagUnitHom TwistTag.E6.tag K) ≤
      normalizer (graphFixedRootGroup TwistTag.E6 K σ : Set (ModGL TwistTag.E6.tag K)) :=
    sup_le Subgroup.le_normalizer hDS
  obtain ⟨ψ, hψapp⟩ : ∃ ψ : ↥(graphFixedRootGroup TwistTag.E6 K σ ⊔
      (TableB.TwE6.compat σ).map (rootDiagUnitHom TwistTag.E6.tag K)) →*
      MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ), ∀ h x,
        ((ψ h x : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K) =
          (h : ModGL TwistTag.E6.tag K) * x * (h : ModGL TwistTag.E6.tag K)⁻¹ :=
    ⟨(graphFixedRootGroup TwistTag.E6 K σ).normalizerMonoidHom.comp (Subgroup.inclusion hHN),
      fun h x => Subgroup.normalizerMonoidHom_apply_apply_coe _ _ x⟩
  have hAψ : A ≤ ψ.range := by
    refine hAI.trans (sup_le ?_ ?_)
    · rintro _ ⟨s, rfl⟩
      refine ⟨⟨s, Subgroup.mem_sup_left s.2⟩, ?_⟩
      ext x
      rw [hψapp]; rfl
    · rintro _ ⟨b, rfl⟩
      refine ⟨⟨rootDiagUnit TwistTag.E6.tag (b : Fin 6 → Kˣ),
        Subgroup.mem_sup_right ⟨(b : Fin 6 → Kˣ), b.2, rfl⟩⟩, ?_⟩
      ext x
      rw [hψapp, RootCentExc.coe_compatParamAut_apply]
  refine ⟨(A.comap ψ).map (Subgroup.subtype _), Subgroup.map_subtype_le _, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective _)]
    by_contra hev
    rw [Nat.not_odd_iff_even, even_iff_two_dvd] at hev
    obtain ⟨⟨y, hyA⟩, hy2⟩ := exists_prime_orderOf_dvd_card' (G := A.comap ψ) 2 hev
    have hy1 : y ≠ 1 := by
      intro h; subst h
      have : orderOf (1 : A.comap ψ) = 2 := by simpa using hy2
      simp at this
    have hysq : y ^ 2 = 1 := by
      have := pow_orderOf_eq_one (⟨y, hyA⟩ : A.comap ψ)
      rw [hy2] at this
      exact congrArg Subtype.val this
    have hψy : ψ y = 1 := by
      have hpow : (⟨ψ y, hyA⟩ : A) ^ 2 = 1 := Subtype.ext (by simp [← map_pow, hysq])
      have hdvd1 : orderOf (⟨ψ y, hyA⟩ : A) ∣ 2 := orderOf_dvd_of_pow_eq_one hpow
      have hdvd2 : orderOf (⟨ψ y, hyA⟩ : A) ∣ Nat.card A := orderOf_dvd_natCard _
      have hcop : Nat.Coprime 2 (Nat.card A) := Nat.coprime_two_left.mpr hA
      have := Nat.eq_one_of_dvd_coprimes hcop hdvd1 hdvd2
      exact congrArg Subtype.val (orderOf_eq_one_iff.mp this)
    have hy' : (y : ModGL TwistTag.E6.tag K) ∈
        ((graphFixedRootGroup TwistTag.E6 K σ ⊔
          (TableB.TwE6.compat σ).map (rootDiagUnitHom TwistTag.E6.tag K) :
            Subgroup (ModGL TwistTag.E6.tag K)) : Set (ModGL TwistTag.E6.tag K)) := y.2
    rw [Subgroup.coe_mul_of_right_le_normalizer_left _ _ hDS] at hy'
    obtain ⟨s, hs, d, ⟨b, hb, rfl⟩, hsd⟩ := hy'
    change s * rootDiagUnit TwistTag.E6.tag b = (y : ModGL TwistTag.E6.tag K) at hsd
    have hd2 : rootDiagUnit TwistTag.E6.tag b ^ 2 ∈ graphFixedRootGroup TwistTag.E6 K σ := by
      have h1 : (y : ModGL TwistTag.E6.tag K) ^ 2 = 1 := congrArg Subtype.val hysq
      rw [← hsd] at h1
      have ht : rootDiagUnit TwistTag.E6.tag b * s * (rootDiagUnit TwistTag.E6.tag b)⁻¹ ∈
          graphFixedRootGroup TwistTag.E6 K σ :=
        (mem_normalizer_iff.mp (hDS ⟨b, hb, rfl⟩) s).mp hs
      have h2 : s * (rootDiagUnit TwistTag.E6.tag b * s * (rootDiagUnit TwistTag.E6.tag b)⁻¹) *
          rootDiagUnit TwistTag.E6.tag b ^ 2 = 1 := by
        calc s * (rootDiagUnit TwistTag.E6.tag b * s * (rootDiagUnit TwistTag.E6.tag b)⁻¹) *
              rootDiagUnit TwistTag.E6.tag b ^ 2
            = (s * rootDiagUnit TwistTag.E6.tag b) * (s * rootDiagUnit TwistTag.E6.tag b) := by
              group
          _ = 1 := by rw [← sq]; exact h1
      have : rootDiagUnit TwistTag.E6.tag b ^ 2 =
          (s * (rootDiagUnit TwistTag.E6.tag b * s * (rootDiagUnit TwistTag.E6.tag b)⁻¹))⁻¹ :=
        eq_inv_of_mul_eq_one_right h2
      rw [this]; exact Subgroup.inv_mem _ (Subgroup.mul_mem _ hs ht)
    have hn : rootDiagUnit TwistTag.E6.tag b ^ Nat.card Kˣ = 1 := by
      change rootDiagUnitHom TwistTag.E6.tag K b ^ Nat.card Kˣ = 1
      rw [← map_pow (rootDiagUnitHom TwistTag.E6.tag K) b]
      have : b ^ Nat.card Kˣ = 1 := by
        funext i; simp [Pi.pow_apply, pow_card_eq_one']
      rw [this, map_one]
    have hKodd : Odd (Nat.card Kˣ) := by
      haveI := Fintype.ofFinite K
      rw [Nat.card_eq_fintype_card, Fintype.card_units]
      obtain ⟨n, hn, hcard⟩ := FiniteField.card K 2
      rw [hcard]
      have he : Even (2 ^ (n : ℕ)) := (Nat.even_pow.mpr ⟨even_two, n.ne_zero⟩)
      have hpos : 0 < 2 ^ (n : ℕ) := by positivity
      obtain ⟨k, hk⟩ := he
      exact ⟨k - 1, by omega⟩
    obtain ⟨m, hm⟩ := hKodd
    have hdS : rootDiagUnit TwistTag.E6.tag b ∈ graphFixedRootGroup TwistTag.E6 K σ := by
      have : rootDiagUnit TwistTag.E6.tag b = (rootDiagUnit TwistTag.E6.tag b ^ 2) ^ (m + 1) := by
        rw [← pow_mul, show 2 * (m + 1) = Nat.card Kˣ + 1 by omega, pow_succ, hn, one_mul]
      rw [this]; exact Subgroup.pow_mem _ hd2 _
    have hyS : (y : ModGL TwistTag.E6.tag K) ∈ graphFixedRootGroup TwistTag.E6 K σ := by
      rw [← hsd]; exact Subgroup.mul_mem _ hs hdS
    have hcen : (⟨y, hyS⟩ : graphFixedRootGroup TwistTag.E6 K σ) ∈
        Subgroup.center (graphFixedRootGroup TwistTag.E6 K σ) := by
      rw [Subgroup.mem_center_iff]
      intro x
      have := congrArg (fun φ : MulAut (graphFixedRootGroup TwistTag.E6 K σ) =>
        ((φ x : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K)) hψy
      simp only [hψapp, MulAut.one_apply] at this
      apply Subtype.ext
      change (x : ModGL TwistTag.E6.tag K) * y = y * x
      calc (x : ModGL TwistTag.E6.tag K) * y = (y * x * (y : ModGL TwistTag.E6.tag K)⁻¹) * y := by
            rw [this]
        _ = y * x := by group
    rw [center_graphFixedRootGroup_eq_bot hσ, Subgroup.mem_bot] at hcen
    exact hy1 (Subtype.ext (by simpa using congrArg Subtype.val hcen))
  · apply le_antisymm
    · rintro _ ⟨x, hx, rfl⟩
      refine ⟨x.2, Subgroup.mem_centralizer_iff.mpr ?_⟩
      rintro _ ⟨h, hh, rfl⟩
      have := congrArg Subtype.val ((LayerSixE.mem_autFix.mp hx) (ψ h) hh)
      rw [hψapp] at this
      change (h : ModGL TwistTag.E6.tag K) * x = x * h
      calc (h : ModGL TwistTag.E6.tag K) * x = (h * x * (h : ModGL TwistTag.E6.tag K)⁻¹) * h := by
            group
        _ = x * h := by rw [this]
    · rintro x ⟨hxS, hxc⟩
      refine ⟨⟨x, hxS⟩, LayerSixE.mem_autFix.mpr ?_, rfl⟩
      intro α hα
      obtain ⟨h, rfl⟩ := hAψ hα
      apply Subtype.ext
      rw [hψapp]
      have := (Subgroup.mem_centralizer_iff.mp hxc) h ⟨h, hα, rfl⟩
      change (h : ModGL TwistTag.E6.tag K) * x * (h : ModGL TwistTag.E6.tag K)⁻¹ = x
      rw [this]; group

