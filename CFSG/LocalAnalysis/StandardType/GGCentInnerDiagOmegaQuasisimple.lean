variable {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K] [Finite K] [CharP K 2]

noncomputable def statedOmegaMulEquivOfIsometry
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] [Field K]
    {Φ : QuadraticForm K (ι → K)} {Ψ : QuadraticForm K (κ → K)}
    (e : Φ.IsometryEquiv Ψ) :
    ↥(StatedOmega ⇑Φ) ≃* ↥(StatedOmega ⇑Ψ) :=
  (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived (Q := Φ) rfl).trans
    ((CFSG.RankThree.PartOne.orthDerivedEquiv e).trans
      (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived (Q := Ψ) rfl).symm)

private theorem isQuasisimple_statedOmega_of_small
    {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K] [Finite K] [CharP K 2]
    {Q : QuadraticForm K (ι → K)}
    (hnd : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hd : Module.finrank K (ι → K) = 4 ∨ Module.finrank K (ι → K) = 6)
    (hts : ∀ U : Submodule K (ι → K),
      Module.finrank K U = Module.finrank K (ι → K) / 2 → ∃ u ∈ U, Q u ≠ 0) :
    CFSG.IsQuasisimple ↥(StatedOmega ⇑Q) := by
  obtain ⟨hs, -, hnonab, -⟩ :=
    CFSG.RankThree.PartOne.even_minus_four_six_actual_derived_extraction Q hnd hd hts
  have := hs
  have hqs : CFSG.IsQuasisimple ↥(CFSG.RankThree.Classical2.orthDerived Q) :=
    CFSG.RankThree.PartOne.KCOrthogonal.isQuasisimple_of_simple_nonabelian hnonab
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv
    (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived (Q := Q) rfl).symm hqs

private theorem isQuasisimple_statedOmega_of_isometry_quadPlus
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] [Field K]
    {Φ : QuadraticForm K (ι → K)} {n : ℕ} (hn : 3 ≤ n)
    (e : Φ.IsometryEquiv (CFSG.LieType.Universal.Spin.quadPlus n K)) :
    CFSG.IsQuasisimple ↥(StatedOmega ⇑Φ) := by
  have hmodel : CFSG.IsQuasisimple
      ↥(StatedOmega ⇑(CFSG.LieType.Universal.Spin.quadPlus n K)) := by
    rw [CFSG.LieType.Universal.Spin.coe_quadPlus]
    exact CFSG.LieType.Universal.Spin.isQuasisimple_statedOmega_quadPlus hn
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv
    (statedOmegaMulEquivOfIsometry e).symm hmodel

private theorem isQuasisimple_statedOmega_of_isometry_quadMinus
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Field K] [Finite K]
    {Φ : QuadraticForm K (ι → K)} {n : ℕ} (hn : 4 ≤ n) {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (e : Φ.IsometryEquiv (CFSG.LieType.Universal.Spin.quadMinus n K b c)) :
    CFSG.IsQuasisimple ↥(StatedOmega ⇑Φ) := by
  have hmodel : CFSG.IsQuasisimple
      ↥(StatedOmega ⇑(CFSG.LieType.Universal.Spin.quadMinus n K b c)) := by
    rw [CFSG.LieType.Universal.Spin.coe_quadMinus]
    exact CFSG.LieType.Universal.Spin.isQuasisimple_statedOmega_quadMinus hn hirr
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv
    (statedOmegaMulEquivOfIsometry e).symm hmodel

private theorem isQuasisimple_statedOmega_of_isometry_quadMinus_two
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Field K] [Finite K] [CharP K 2]
    {Φ : QuadraticForm K (ι → K)} {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (e : Φ.IsometryEquiv (CFSG.LieType.Universal.Spin.quadMinus 2 K b c)) :
    CFSG.IsQuasisimple ↥(StatedOmega ⇑Φ) := by
  have hnd := CFSG.LieType.Universal.Spin.nondegenerate_polarBilin_quadMinus_of_finite
    2 K hirr
  have hd : Module.finrank K (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) = 4 ∨
      Module.finrank K (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) = 6 := by
    left
    rw [CFSG.GroupTheory.WeirSylow.finrank_quadMinus_space (m := 2) (by norm_num)]
  have hts : ∀ U : Submodule K (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K),
      Module.finrank K U =
        Module.finrank K (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) / 2 →
        ∃ u ∈ U, CFSG.LieType.Universal.Spin.quadMinus 2 K b c u ≠ 0 := by
    intro U hU
    rw [CFSG.GroupTheory.WeirSylow.finrank_quadMinus_space (m := 2) (by norm_num),
      Nat.mul_div_cancel_left 2 (by norm_num)] at hU
    exact CFSG.RankThree.GF2n.Stroth80.exists_quadMinus_ne_zero_of_finrank
      (n := 2) (by norm_num) hirr U hU
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv
    (statedOmegaMulEquivOfIsometry e).symm (isQuasisimple_statedOmega_of_small hnd hd hts)

private theorem isQuasisimple_statedOmega_of_isometry_quadMinus_three
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Field K] [Finite K] [CharP K 2]
    {Φ : QuadraticForm K (ι → K)} {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (e : Φ.IsometryEquiv (CFSG.LieType.Universal.Spin.quadMinus 3 K b c)) :
    CFSG.IsQuasisimple ↥(StatedOmega ⇑Φ) := by
  have hnd := CFSG.LieType.Universal.Spin.nondegenerate_polarBilin_quadMinus_of_finite
    3 K hirr
  have hd : Module.finrank K (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → K) = 4 ∨
      Module.finrank K (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → K) = 6 := by
    right
    rw [CFSG.GroupTheory.WeirSylow.finrank_quadMinus_space (m := 3) (by norm_num)]
  have hts : ∀ U : Submodule K (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → K),
      Module.finrank K U =
        Module.finrank K (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → K) / 2 →
        ∃ u ∈ U, CFSG.LieType.Universal.Spin.quadMinus 3 K b c u ≠ 0 := by
    intro U hU
    rw [CFSG.GroupTheory.WeirSylow.finrank_quadMinus_space (m := 3) (by norm_num),
      Nat.mul_div_cancel_left 3 (by norm_num)] at hU
    exact CFSG.RankThree.GF2n.Stroth80.exists_quadMinus_ne_zero_of_finrank
      (n := 3) (by norm_num) hirr U hU
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv
    (statedOmegaMulEquivOfIsometry e).symm (isQuasisimple_statedOmega_of_small hnd hd hts)

theorem isQuasisimple_statedOmega (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h : 6 ≤ Fintype.card ι ∨ (Fintype.card ι = 4 ∧
      ¬ ∃ T : Submodule K (ι → K), Module.finrank K T = 2 ∧ ∀ x ∈ T, Φ x = 0)) :
    CFSG.Assembly.IsQuasisimple ↥(StatedOmega ⇑Φ) := by
  have hfinrank : Module.finrank K (ι → K) = Fintype.card ι :=
    Module.finrank_fintype_fun_eq_card K
  have hqs : CFSG.IsQuasisimple ↥(StatedOmega ⇑Φ) := by
    rcases h with h6 | ⟨h4, hno⟩
    · obtain ⟨n, hn⟩ : ∃ n, Fintype.card ι = 2 * n := by
        obtain ⟨n, hn⟩ :=
          CFSG.ComponentClassification.UnbalancedCatalog.even_finrank_of_charTwo Φ hΦ
        rw [hfinrank] at hn
        exact ⟨n, by omega⟩
      have hdim : Module.finrank K (ι → K) = 2 * n := by rw [hfinrank, hn]
      have hn3 : 3 ≤ n := by omega
      rcases CFSG.GroupTheory.WeirSylow.exists_isometry_quadPlus_or_quadMinus Φ hΦ
          (n := n) (by omega) hdim with he | ⟨b, c, hirr, he⟩
      · obtain ⟨e⟩ := he
        exact isQuasisimple_statedOmega_of_isometry_quadPlus (κ := Fin n ⊕ Fin n) hn3 e
      · by_cases hn4 : 4 ≤ n
        · obtain ⟨e⟩ := he
          exact isQuasisimple_statedOmega_of_isometry_quadMinus
            (κ := Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) hn4 hirr e
        · obtain rfl : n = 3 := by omega
          obtain ⟨e⟩ := he
          exact isQuasisimple_statedOmega_of_isometry_quadMinus_three
            (κ := Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) hirr e
    · have hdim : Module.finrank K (ι → K) = 4 := by rw [hfinrank, h4]
      rcases CFSG.GroupTheory.WeirSylow.exists_isometry_quadPlus_or_quadMinus Φ hΦ
          (n := 2) (by norm_num) (by omega) with he | ⟨b, c, hirr, he⟩
      · obtain ⟨e⟩ := he
        have hp : CFSG.GroupTheory.WeirSylow.IsPlusType Φ :=
          (CFSG.GroupTheory.WeirSylow.isPlusType_congr e).mpr
            (CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus K 2)
        obtain ⟨W, hW, hWs⟩ := hp
        exact absurd ⟨W, by omega, hWs⟩ hno
      · obtain ⟨e⟩ := he
        exact isQuasisimple_statedOmega_of_isometry_quadMinus_two
          (κ := Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) hirr e
  exact ((CFSG.Foundations.SteinbergCA.quasisimple_iff _).2.1).mp hqs

private noncomputable def statedOmegaMulEquivOfEq
    {κ K : Type} [Fintype κ] [DecidableEq κ] [Field K]
    {Q : QuadraticForm K (κ → K)} {Q₀ : (κ → K) → K} (hQ : ⇑Q = Q₀) :
    ↥(StatedOmega ⇑Q) ≃* ↥(StatedOmega Q₀) :=
  (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived (Q := Q) rfl).trans
    (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived (Q := Q) hQ).symm

private theorem center_statedSL_eq_of_map_center (n : ℕ) (K : Type) [Field K] :
    Subgroup.center (CFSG.Open.StatedSL n K) =
      (CFSG.Open.StatedScalars (Fin n) K).subgroupOf (CFSG.Open.StatedSL n K) := by
  have h1 := Subgroup.map_center_eq
    (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL n K)
  rw [CFSG.Assembly.LowTwoRank.map_center_eq_statedScalars n K] at h1
  exact h1.symm

private noncomputable def statedOmegaCenterQuotientMulEquiv
    {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    {Φ : QuadraticForm K (ι → K)} :
    ↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ) ≃*
      ↥(CFSG.RankThree.Classical2.orthDerived Φ) ⧸
        Subgroup.center ↥(CFSG.RankThree.Classical2.orthDerived Φ) :=
  let eΩ := CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived (Q := Φ) rfl
  QuotientGroup.congr _ _ eΩ (Subgroup.map_center_eq eΩ)

theorem exists_statedClassicalModel_statedOmega_of_isometry_quadPlus_three
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Field K] [Finite K] [CharP K 2]
    {Φ : QuadraticForm K (ι → K)} (e : Φ.IsometryEquiv
      (CFSG.LieType.Universal.Spin.quadPlus 3 K)) {f : ℕ} (hf : 1 ≤ f)
    (hcard : Nat.card K = 2 ^ f) :
    StatedClassicalModel
      (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .PSL 4 2 f := by
  obtain ⟨hnd, hT⟩ := CFSG.ClassicalGroups.Orthogonal.regular_quadPlus
    (K := K) (n := 3) (by norm_num)
  obtain ⟨κ⟩ := CFSG.HardMathSupport.Dickson.Sec6.OrthBlocks.klein_commutator_orthogonal_six_all
    (CFSG.LieType.Universal.Spin.quadPlus 3 K) hnd
    (by rw [CFSG.GroupTheory.WeirSylow.finrank_quadPlus_space]) hT
  let E : ↥(StatedOmega ⇑Φ) ≃* ↥(CFSG.Open.StatedSL 4 K) :=
    (statedOmegaMulEquivOfIsometry e).trans
      ((CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived
          (Q := CFSG.LieType.Universal.Spin.quadPlus 3 K) rfl).trans
        ((CFSG.RankThree.PartOne.orthDerivedEquivCommutator
            (CFSG.LieType.Universal.Spin.quadPlus 3 K)).symm.trans κ))
  let Q : ↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ) ≃*
      CFSG.Open.StatedProj (CFSG.Open.StatedSL 4 K) :=
    (QuotientGroup.congr _ _ E (Subgroup.map_center_eq E)).trans
      (QuotientGroup.quotientMulEquivOfEq (center_statedSL_eq_of_map_center 4 K))
  refine ⟨⟨Nat.prime_two, hf, by norm_num, ?_, ?_⟩, K, inferInstance, inferInstance,
    hcard, ⟨Q⟩⟩
  · intro h
    exact absurd (Prod.mk.inj h).1 (by norm_num)
  · intro h
    exact absurd (Prod.mk.inj h).1 (by norm_num)

theorem exists_statedClassicalModel_statedOmega_of_isometry_quadMinus_three
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Field K] [Finite K] [CharP K 2]
    {Φ : QuadraticForm K (ι → K)} {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (e : Φ.IsometryEquiv (CFSG.LieType.Universal.Spin.quadMinus 3 K b c))
    {f : ℕ} (hf : 1 ≤ f) (hcard : Nat.card K = 2 ^ f) :
    StatedClassicalModel
      (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .PSU 4 2 f := by
  obtain ⟨F, hF, hFin, hFcard, ⟨eSU⟩⟩ :=
    CFSG.RankThree.GF2n.Stroth80.exists_statedOmega_quadMinus_three_mulEquiv
      (f := f) hcard hirr
  let : Field F := hF
  let : Finite F := hFin
  let E : ↥(StatedOmega ⇑Φ) ≃* ↥(CFSG.Open.StatedSU 4 (2 ^ f) F) :=
    ((statedOmegaMulEquivOfIsometry e).trans
      (statedOmegaMulEquivOfEq (Q := CFSG.LieType.Universal.Spin.quadMinus 3 K b c)
        (CFSG.LieType.Universal.Spin.coe_quadMinus 3 K b c))).trans eSU
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hZ := (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card
    (p := 2) (f := f) (n := 4) hFcard (by norm_num)
    (fun h => absurd (Prod.mk.inj h).1 (by norm_num))).2
  let Q : ↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ) ≃*
      CFSG.Open.StatedProj (CFSG.Open.StatedSU 4 (2 ^ f) F) :=
    (QuotientGroup.congr _ _ E (Subgroup.map_center_eq E)).trans
      (QuotientGroup.quotientMulEquivOfEq hZ)
  refine ⟨⟨Nat.prime_two, hf, by norm_num, ?_⟩, F, inferInstance, inferInstance,
    hFcard, ⟨Q⟩⟩
  intro h
  exact absurd (Prod.mk.inj h).1 (by norm_num)

theorem exists_statedClassicalModel_statedOmega_of_isometry_quadMinus_two
    {ι κ K : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Field K] [Finite K] [CharP K 2]
    {Φ : QuadraticForm K (ι → K)} {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (e : Φ.IsometryEquiv (CFSG.LieType.Universal.Spin.quadMinus 2 K b c))
    {f : ℕ} (hf : 1 ≤ f) (hcard : Nat.card K = 2 ^ f) :
    StatedClassicalModel
      (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .PSL 2 2 (2 * f) := by
  obtain ⟨F, hF, hFin, hFcard, ⟨eSL⟩⟩ :=
    CFSG.RankThree.GF2n.Stroth80.exists_statedOmega_quadMinus_two_mulEquiv hirr
  let : Field F := hF
  let : Finite F := hFin
  have hFcard2 : Nat.card F = 2 ^ (2 * f) := by
    rw [hFcard, hcard, ← pow_mul, Nat.mul_comm]
  let E : ↥(StatedOmega ⇑Φ) ≃* ↥(CFSG.Open.StatedSL 2 F) :=
    ((statedOmegaMulEquivOfIsometry e).trans
      (statedOmegaMulEquivOfEq (Q := CFSG.LieType.Universal.Spin.quadMinus 2 K b c)
        (CFSG.LieType.Universal.Spin.coe_quadMinus 2 K b c))).trans eSL
  let Q : ↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ) ≃*
      CFSG.Open.StatedProj (CFSG.Open.StatedSL 2 F) :=
    (QuotientGroup.congr _ _ E (Subgroup.map_center_eq E)).trans
      (QuotientGroup.quotientMulEquivOfEq (center_statedSL_eq_of_map_center 2 F))
  have h4 : 4 ≤ 2 ^ (2 * f) := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (2 * f) := Nat.pow_le_pow_right (by norm_num) (by omega)
  refine ⟨⟨Nat.prime_two, by omega, by norm_num, ?_, ?_⟩, F, inferInstance, inferInstance,
    hFcard2, ⟨Q⟩⟩
  · intro h
    exact absurd (Prod.mk.inj h).2 (by omega)
  · intro h
    exact absurd (Prod.mk.inj h).2 (by omega)

theorem exists_statedClassicalModel_statedOmega_cases (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h : 6 ≤ Fintype.card ι ∨ (Fintype.card ι = 4 ∧
      ¬ ∃ T : Submodule K (ι → K), Module.finrank K T = 2 ∧ ∀ x ∈ T, Φ x = 0)) :
    (∃ n f : ℕ, 4 ≤ n ∧ StatedClassicalModel
        (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .POmegaPlus n 2 f) ∨
      (∃ n f : ℕ, 4 ≤ n ∧ StatedClassicalModel
        (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .POmegaMinus n 2 f) ∨
      (∃ f : ℕ, StatedClassicalModel
        (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .PSL 4 2 f) ∨
      (∃ f : ℕ, StatedClassicalModel
        (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .PSU 4 2 f) ∨
      (∃ f : ℕ, StatedClassicalModel
        (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) .PSL 2 2 (2 * f)) := by
  let : Fintype K := Fintype.ofFinite K
  obtain ⟨f, hf, hcardF⟩ := FiniteField.card K 2
  have hf1 : 1 ≤ (f : ℕ) := f.pos
  have hcard : Nat.card K = 2 ^ (f : ℕ) := by
    rw [Nat.card_eq_fintype_card, hcardF]
  have hfinrank : Module.finrank K (ι → K) = Fintype.card ι :=
    Module.finrank_fintype_fun_eq_card K
  rcases h with h6 | ⟨h4, hno⟩
  · obtain ⟨n, hn⟩ : ∃ n, Fintype.card ι = 2 * n := by
      obtain ⟨n, hn⟩ :=
        CFSG.ComponentClassification.UnbalancedCatalog.even_finrank_of_charTwo Φ hΦ
      rw [hfinrank] at hn
      exact ⟨n, by omega⟩
    have hdim : Module.finrank K (ι → K) = 2 * n := by rw [hfinrank, hn]
    by_cases hn4 : 4 ≤ n
    · obtain hm | hm :=
        CFSG.HardMathSupport.Dickson.Sec6.OrthBlocks.lieModel_quotient_orthDerived_pm
          hΦ hn4 hdim hf1 hcard (MulEquiv.refl _)
      · exact Or.inl ⟨n, f, hn4,
          CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by omega)
            (CFSG.Blueprint.LieModel.of_mulEquiv
              (statedOmegaCenterQuotientMulEquiv (Φ := Φ)).symm hm)⟩
      · exact Or.inr (Or.inl ⟨n, f, hn4,
          CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by omega)
            (CFSG.Blueprint.LieModel.of_mulEquiv
              (statedOmegaCenterQuotientMulEquiv (Φ := Φ)).symm hm)⟩)
    · obtain rfl : n = 3 := by omega
      rcases CFSG.GroupTheory.WeirSylow.exists_isometry_quadPlus_or_quadMinus Φ hΦ
          (n := 3) (by norm_num) hdim with he | ⟨b, c, hirr, he⟩
      · obtain ⟨e⟩ := he
        exact Or.inr (Or.inr (Or.inl ⟨f,
          exists_statedClassicalModel_statedOmega_of_isometry_quadPlus_three
            (κ := Fin 3 ⊕ Fin 3) e hf1 hcard⟩))
      · obtain ⟨e⟩ := he
        exact Or.inr (Or.inr (Or.inr (Or.inl ⟨f,
          exists_statedClassicalModel_statedOmega_of_isometry_quadMinus_three
            (κ := Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) hirr e hf1 hcard⟩)))
  · have hdim : Module.finrank K (ι → K) = 4 := by rw [hfinrank, h4]
    rcases CFSG.GroupTheory.WeirSylow.exists_isometry_quadPlus_or_quadMinus Φ hΦ
        (n := 2) (by norm_num) (by omega) with he | ⟨b, c, hirr, he⟩
    · obtain ⟨e⟩ := he
      have hp : CFSG.GroupTheory.WeirSylow.IsPlusType Φ :=
        (CFSG.GroupTheory.WeirSylow.isPlusType_congr e).mpr
          (CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus K 2)
      obtain ⟨W, hW, hWs⟩ := hp
      exact absurd ⟨W, by omega, hWs⟩ hno
    · obtain ⟨e⟩ := he
      exact Or.inr (Or.inr (Or.inr (Or.inr ⟨f,
        exists_statedClassicalModel_statedOmega_of_isometry_quadMinus_two
          (κ := Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) hirr e hf1 hcard⟩)))

theorem exists_statedClassicalModel_statedOmega (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h : 6 ≤ Fintype.card ι ∨ (Fintype.card ι = 4 ∧
      ¬ ∃ T : Submodule K (ι → K), Module.finrank K T = 2 ∧ ∀ x ∈ T, Φ x = 0)) :
    ∃ (t : StatedLieTag) (n f : ℕ), StatedClassicalModel
      (↥(StatedOmega ⇑Φ) ⧸ Subgroup.center ↥(StatedOmega ⇑Φ)) t n 2 f := by
  rcases exists_statedClassicalModel_statedOmega_cases Φ hΦ h with
    ⟨n, f, _, hM⟩ | ⟨n, f, _, hM⟩ | ⟨f, hM⟩ | ⟨f, hM⟩ | ⟨f, hM⟩
  · exact ⟨.POmegaPlus, n, f, hM⟩
  · exact ⟨.POmegaMinus, n, f, hM⟩
  · exact ⟨.PSL, 4, f, hM⟩
  · exact ⟨.PSU, 4, f, hM⟩
  · exact ⟨.PSL, 2, 2 * f, hM⟩

end CFSG.StandardType
