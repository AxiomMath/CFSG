variable {G : Type} [Group G] {Bs K : Subgroup G} {n r m d : ℕ}
  {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))} {π : Fin (r + 2) ≃ Fin n}
  {g : (ZMod 2)[X]} [Fact (Irreducible g)]
  {ε : Fin m ≃ (Fin (CoordSL.rootPB g).dim × Fin (r + 1)) ⊕ Fin d}
  {hC : (CoordSL.rootMat g).det = 1} {hCp : CoordSL.rootMat g ^ 3 = 1}
  {κ : SL(m, ZMod 2) →* G}

theorem centralizer_coordEq_le_normalizer [Finite G]
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hBs : ∀ x ∈ Subgroup.centralizer (Bs : Set G), x ^ 3 = 1 → x ∈ Bs)
    {y : G} (hyB : y ∈ Bs)
    (hK : CFSG.Open.IsComponentOf K (Subgroup.centralizer ({y} : Set G)))
    (i j k : Fin (r + 1)) (hki : k ≠ i) (hkj : k ≠ j) :
    Subgroup.centralizer (ggBsCoordEq Bs eta (π i.succ) (π j.succ) : Set G) ≤
      Subgroup.normalizer (K : Set G) := by
  classical
  let H := ggBsCoordEq Bs eta (π i.succ) (π j.succ)
  have hycoords : ggSecFiveBPermQTwoCoords eta π ⟨y, hyB⟩ = 1 :=
    hF.coords_eq_one_of_commute fun x hx =>
      (Subgroup.mem_centralizer_singleton_iff.mp (hK.1 hx)).symm
  have hyH : y ∈ H := by
    apply (coe_mem_ggBsCoordEq (b := ⟨y, hyB⟩)).mpr
    apply Multiplicative.toAdd.injective
    change Multiplicative.toAdd (ggSecFiveBPermQTwoCoords eta π ⟨y, hyB⟩) i =
      Multiplicative.toAdd (ggSecFiveBPermQTwoCoords eta π ⟨y, hyB⟩) j
    rw [hycoords]
    rfl
  let t := CoordSL.frameHom κ 1 ε hC hCp (Multiplicative.ofAdd (Pi.single k 1))
  have htK : t ∈ K := hF.frameHom_mem_K _
  have htB : t ∈ Bs := hF.frameHom_mem_Bs hBs _
  have htH : t ∈ H := by
    apply (coe_mem_ggBsCoordEq (b := ⟨t, htB⟩)).mpr
    apply Multiplicative.toAdd.injective
    change Multiplicative.toAdd (ggSecFiveBPermQTwoCoords eta π ⟨t, htB⟩) i =
      Multiplicative.toAdd (ggSecFiveBPermQTwoCoords eta π ⟨t, htB⟩) j
    rw [hF.coords_frameHom hBs]
    simp [hki, hkj]
  have htnc : t ∉ Subgroup.centralizer (K : Set G) := by
    intro h
    have h1 : t = 1 := hF.eq_one_of_central htK fun x hx =>
      (Subgroup.mem_centralizer_iff.mp h x hx).symm
    have h2 := hF.frameHom_injective (h1.trans (map_one _).symm)
    have h3 := congrFun (congrArg Multiplicative.toAdd h2) k
    simp at h3
  intro c hc
  have hcy : c ∈ Subgroup.centralizer ({y} : Set G) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (Subgroup.mem_centralizer_iff.mp hc y hyH).symm
  exact ggMem_normalizer_of_component (CFSG.Assembly.isComponentOf_iff_open.mpr hK)
    htK htnc (Subgroup.le_normalizer hcy)
    (Subgroup.mem_centralizer_iff.mp hc t htH).symm

private theorem reflGen_scalar (u v : ZMod 3) :
    u + -(v - u) = v + (v - u) := by
  revert u v
  decide

theorem coordEq_gen
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hBs : ∀ x ∈ Subgroup.centralizer (Bs : Set G), x ^ 3 = 1 → x ∈ Bs)
    (i j : Fin (r + 1)) (hij : i ≠ j) :
    ∀ b ∈ Bs, ∃ h ∈ ggBsCoordEq Bs eta (π i.succ) (π j.succ), ∃ a : ℤ,
      b = h * (CoordSL.frameHom κ 1 ε hC hCp
        (Multiplicative.ofAdd (Pi.single i 1 - Pi.single j 1))) ^ a := by
  classical
  let δ : Fin (r + 1) → ZMod 3 := Pi.single i 1 - Pi.single j 1
  let t := CoordSL.frameHom κ 1 ε hC hCp (Multiplicative.ofAdd δ)
  have htB : t ∈ Bs := hF.frameHom_mem_Bs hBs _
  let C : ↥Bs →* Multiplicative (Fin (r + 1) → ZMod 3) :=
    { toFun := ggSecFiveBPermQTwoCoords eta π
      map_one' := by
        apply Multiplicative.toAdd.injective
        funext l
        simp [ggSecFiveBPermQTwoCoords]
      map_mul' := GGSecFiveBPermQTwoKFrame.coords_mul }
  let tB : ↥Bs := ⟨t, htB⟩
  have htC : C tB = Multiplicative.ofAdd δ := hF.coords_frameHom hBs _
  intro b hb
  let bB : ↥Bs := ⟨b, hb⟩
  let a : ZMod 3 := (C bB).toAdd j - (C bB).toAdd i
  let h : ↥Bs := bB * (tB ^ a.val)⁻¹
  refine ⟨h, ?_, (a.val : ℤ), ?_⟩
  · apply (coe_mem_ggBsCoordEq (b := h)).mpr
    apply Multiplicative.toAdd.injective
    change (C h).toAdd i = (C h).toAdd j
    dsimp only [h]
    rw [map_mul, map_inv, map_pow, htC]
    simp only [toAdd_mul, Pi.add_apply, toAdd_inv, Pi.neg_apply,
      toAdd_pow, toAdd_ofAdd]
    have hsmul (l : Fin (r + 1)) : (a.val • δ) l = a.val • δ l :=
      map_nsmul (Pi.evalAddMonoidHom (fun _ : Fin (r + 1) => ZMod 3) l) a.val δ
    have hδi : δ i = 1 := by simp [δ, hij]
    have hδj : δ j = -1 := by
      simp [δ, hij.symm]

    simp only [hsmul, nsmul_eq_mul, ZMod.natCast_zmod_val, hδi, hδj, mul_one,
      _root_.mul_neg_one, _root_.neg_neg]
    exact reflGen_scalar ((C bB).toAdd i) ((C bB).toAdd j)
  · change b = (b * (t ^ a.val)⁻¹) * t ^ (a.val : ℤ)
    rw [zpow_natCast]
    group

private theorem classSet_pair (i j : Fin (r + 1)) (hij : i ≠ j) :
    CoordSL.classSet (Pi.single i 1 + Pi.single j 1 : Fin (r + 1) → ZMod 3) 1 = {i, j} := by
  classical
  ext l
  rw [CoordSL.mem_classSet, Finset.mem_insert, Finset.mem_singleton]
  by_cases hli : l = i
  · subst l
    simp [hij]
  by_cases hlj : l = j
  · subst l
    simp [hij.symm]
  simp [hli, hlj]

private theorem sum_anti (i j : Fin (r + 1)) :
    ∑ l, (Pi.single i 1 - Pi.single j 1 : Fin (r + 1) → ZMod 3) l = 0 := by
    simp only [Pi.sub_apply, Pi.single_apply, sub_eq_add_neg]
    simp only [neg_ite, _root_.neg_zero]
    rw [Finset.sum_add_distrib]
    simp

theorem antiTorus_mem_fieldPair
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (i j : Fin (r + 1)) (hij : i ≠ j) :
    CoordSL.frameHom κ 1 ε hC hCp (Multiplicative.ofAdd (Pi.single i 1 - Pi.single j 1)) ∈
      (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
        (κ.comp (CoordSL.theta g ε)) := by
  classical
  have hζ : AdjoinRoot.root g ^ 3 = 1 :=
    (CoordSL.root_isPrimitiveRoot Nat.prime_three (by decide) hF.2.2.1).pow_eq_one
  have hsupp : ∀ l, (Pi.single i 1 + Pi.single j 1 : Fin (r + 1) → ZMod 3) l ≠ 1 →
      (Pi.single i 1 - Pi.single j 1 : Fin (r + 1) → ZMod 3) l = 0 := by
    intro l hl
    by_cases hli : l = i
    · subst l
      simp [hij] at hl
    by_cases hlj : l = j
    · subst l
      simp [hij.symm] at hl
    simp [hli, hlj]
  have hsum := sum_anti i j
  obtain ⟨D, hD, hθD⟩ := CoordSL.diag_mem_classBlock (ε := ε) (hC := hC) hζ hsupp hsum
  refine ⟨D, ?_, ?_⟩
  · change D ∈ CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}
    rw [← classSet_pair i j hij]
    exact hD
  · change κ (CoordSL.theta g ε D) =
      CoordSL.frameHom κ 1 ε hC hCp (Multiplicative.ofAdd (Pi.single i 1 - Pi.single j 1))
    rw [hθD, GGSecFiveBPermQTwoKFrame.frameHom_ofAdd]

theorem fieldPair_le_centralizer
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (i j : Fin (r + 1)) (hij : i ≠ j) :
    (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
      (κ.comp (CoordSL.theta g ε)) ≤
      Subgroup.centralizer (ggBsCoordEq Bs eta (π i.succ) (π j.succ) : Set G) := by
  classical
  rintro z ⟨M, hM, rfl⟩
  rw [← classSet_pair i j hij] at hM
  rw [Subgroup.mem_centralizer_iff]
  intro b hb
  have hbB := ggBsCoordEq_le (π i.succ) (π j.succ) hb
  let bB : ↥Bs := ⟨b, hbB⟩
  have hbEq := (coe_mem_ggBsCoordEq (b := bB)).mp hb
  have htEq : (ggSecFiveBPermQTwoCoords eta π bB).toAdd i =
      (ggSecFiveBPermQTwoCoords eta π bB).toAdd j := congrArg Multiplicative.toAdd hbEq
  have hconst : ∀ a c,
      (Pi.single i 1 + Pi.single j 1 : Fin (r + 1) → ZMod 3) a = 1 →
      (Pi.single i 1 + Pi.single j 1 : Fin (r + 1) → ZMod 3) c = 1 →
      ((ggSecFiveBPermQTwoCoords eta π bB).toAdd a).val =
        ((ggSecFiveBPermQTwoCoords eta π bB).toAdd c).val := by
    intro a c ha hc
    have haJ : a = i ∨ a = j := by
      simpa only [classSet_pair i j hij, Finset.mem_insert, Finset.mem_singleton] using
        (CoordSL.mem_classSet.mpr ha)
    have hcJ : c = i ∨ c = j := by
      simpa only [classSet_pair i j hij, Finset.mem_insert, Finset.mem_singleton] using
        (CoordSL.mem_classSet.mpr hc)
    rcases haJ with rfl | rfl <;> rcases hcJ with rfl | rfl <;> simp [htEq]
  have hcomm := CoordSL.comm_classBlock_of_torus (ε := ε) (hC := hC) hconst hM
  have hmap := congrArg κ hcomm
  rw [map_mul, map_mul] at hmap
  have h1 := hF.2.2.2 bB (CoordSL.theta g ε M)
  rw [← ofAdd_toAdd (ggSecFiveBPermQTwoCoords eta π bB),
    GGSecFiveBPermQTwoKFrame.frameHom_ofAdd] at h1
  have h2 : b * κ (CoordSL.theta g ε M) * b⁻¹ = κ (CoordSL.theta g ε M) := by
    rw [h1, ← hmap, mul_inv_cancel_right]
  exact mul_inv_eq_iff_eq_mul.mp h2

private theorem frameHom_mem_coordEq
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hBs : ∀ x ∈ Subgroup.centralizer (Bs : Set G), x ^ 3 = 1 → x ∈ Bs)
    (i j : Fin (r + 1)) (t : Multiplicative (Fin (r + 1) → ZMod 3))
    (ht : t.toAdd i = t.toAdd j) :
    CoordSL.frameHom κ 1 ε hC hCp t ∈ ggBsCoordEq Bs eta (π i.succ) (π j.succ) := by
  have htB := hF.frameHom_mem_Bs hBs t
  apply (coe_mem_ggBsCoordEq (b := ⟨_, htB⟩)).mpr
  apply Multiplicative.toAdd.injective
  change (ggSecFiveBPermQTwoCoords eta π ⟨_, htB⟩).toAdd i =
    (ggSecFiveBPermQTwoCoords eta π ⟨_, htB⟩).toAdd j
  rw [hF.coords_frameHom hBs]
  exact ht

theorem centralizer_coordEq_le_map_pair_centralizer
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hBs : ∀ x ∈ Subgroup.centralizer (Bs : Set G), x ^ 3 = 1 → x ∈ Bs)
    (i j k : Fin (r + 1)) (hij : i ≠ j) (hki : k ≠ i) (hkj : k ≠ j) :
    K ⊓ Subgroup.centralizer (ggBsCoordEq Bs eta (π i.succ) (π j.succ) : Set G) ≤
      (Subgroup.centralizer
        ({SLNS.nsSL ε hC (fun l => ((Pi.single i 1 + Pi.single j 1 : Fin (r + 1) → ZMod 3) l).val),
          SLNS.nsSL ε hC (fun l => ((Pi.single k 1 : Fin (r + 1) → ZMod 3) l).val)} :
          Set (SL(m, ZMod 2)))).map κ := by
  classical
  let β : Fin (r + 1) → ZMod 3 := Pi.single i 1 + Pi.single j 1
  let γ : Fin (r + 1) → ZMod 3 := Pi.single k 1
  have hβH := frameHom_mem_coordEq hF hBs i j (Multiplicative.ofAdd β) (by
    simp [β, hij, hij.symm])
  have hγH := frameHom_mem_coordEq hF hBs i j (Multiplicative.ofAdd γ) (by
    simp [γ, hki, hkj])
  rintro z ⟨hzK, hzH⟩
  rw [← hF.2.1] at hzK
  obtain ⟨u, rfl⟩ := hzK
  refine ⟨u, ?_, rfl⟩
  change u ∈ Subgroup.centralizer
    ({SLNS.nsSL ε hC (fun l => (β l).val), SLNS.nsSL ε hC (fun l => (γ l).val)} :
      Set (SL(m, ZMod 2)))
  apply Subgroup.mem_centralizer_iff.mpr
  have hcomm (a : Fin (r + 1) → ZMod 3)
      (ha : CoordSL.frameHom κ 1 ε hC hCp (Multiplicative.ofAdd a) ∈
        ggBsCoordEq Bs eta (π i.succ) (π j.succ)) :
      SLNS.nsSL ε hC (fun l => (a l).val) * u = u * SLNS.nsSL ε hC (fun l => (a l).val) := by
    apply hF.1
    rw [map_mul, map_mul]
    have h := Subgroup.mem_centralizer_iff.mp hzH _ ha
    rw [GGSecFiveBPermQTwoKFrame.frameHom_ofAdd] at h
    exact h
  intro v hv
  rcases Set.mem_insert_iff.mp hv with h | h
  · subst v
    exact hcomm β hβH
  · rw [Set.mem_singleton_iff] at h
    subst v
    exact hcomm γ hγH

private theorem conjugate_transvection_of_diagonal {F : Type} [Field F] {s : ℕ}
    {D : SL(s, F)} (v : Fin s → Fˣ)
    (hD : (D : Matrix (Fin s) (Fin s) F) = Matrix.diagonal fun l => (v l : F))
    {a b : Fin s} (hab : a ≠ b) (c : F) :
    D * Matrix.SpecialLinearGroup.transvection hab c * D⁻¹ =
      Matrix.SpecialLinearGroup.transvection hab ((v a : F) * c * ((v b)⁻¹ : Fˣ)) := by
  have hmul : D * Matrix.SpecialLinearGroup.transvection hab c =
      Matrix.SpecialLinearGroup.transvection hab ((v a : F) * c * ((v b)⁻¹ : Fˣ)) * D := by
    apply Subtype.ext
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.transvection_coe,
      hD, Matrix.mul_add, Matrix.add_mul, Matrix.mul_one, Matrix.one_mul]
    ext u w
    simp only [Matrix.add_apply, Matrix.diagonal_mul, Matrix.mul_diagonal]
    by_cases hua : u = a
    · subst u
      by_cases hwb : w = b
      · subst w
        simp only [Matrix.single_apply]
        simp [mul_assoc]
      · simp [Ne.symm hwb]
    · simp [Ne.symm hua]
  rw [hmul, _root_.mul_inv_cancel_right]

theorem native_fieldPair_le_commutator_antiTorus
    {ε : Fin m ≃ (Fin (CoordSL.rootPB g).dim × Fin 3) ⊕ Fin d}
    (hg : g ∣ cyclotomic 3 (ZMod 2)) (i j : Fin 3) (hij : i ≠ j) :
    (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map (CoordSL.theta g ε) ≤
      ⁅(CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map (CoordSL.theta g ε),
        Subgroup.zpowers (SLNS.nsSL ε hC
          (fun l => ((Pi.single i 1 - Pi.single j 1 : Fin 3 → ZMod 3) l).val))⁆ := by
  classical
  let L := AdjoinRoot g
  let δ : Fin 3 → ZMod 3 := Pi.single i 1 - Pi.single j 1
  let β : Fin 3 → ZMod 3 := Pi.single i 1 + Pi.single j 1
  let R := (CFSG.RankThree.CALinearPlane.coordBlockSL L {i, j}).map (CoordSL.theta g ε)
  let t := SLNS.nsSL ε hC (fun l => (δ l).val)
  have hprim : IsPrimitiveRoot (AdjoinRoot.root g) 3 :=
    CoordSL.root_isPrimitiveRoot Nat.prime_three (by decide) hg
  let z : Lˣ := (hprim.isUnit (by decide)).unit
  have hz : (z : L) = AdjoinRoot.root g := IsUnit.unit_spec _
  have hzprim : IsPrimitiveRoot z 3 := IsPrimitiveRoot.coe_units_iff.mp (by simpa [hz] using hprim)
  let v : Fin 3 → Lˣ := fun l => z ^ (δ l).val
  have hδi : δ i = 1 := by simp [δ, hij]
  have hδj : δ j = -1 := by simp [δ, hij.symm]
  have hvi : v i = z := by
    dsimp only [v]
    rw [hδi, show (1 : ZMod 3).val = 1 by decide, _root_.pow_one]
  have hvj : v j = z ^ 2 := by
    dsimp only [v]
    rw [hδj, show (-1 : ZMod 3).val = 2 by decide]
  have hz12 : z ≠ z ^ 2 := by
    intro h
    have hn := hzprim.pow_inj (by decide : 1 < 3) (by decide : 2 < 3) (by simpa using h)
    norm_num at hn
  have hsupp : ∀ l, β l ≠ 1 → δ l = 0 := by
    intro l hl
    by_cases hli : l = i
    · subst l
      simp [β, hij] at hl
    by_cases hlj : l = j
    · subst l
      simp [β, hij.symm] at hl
    simp [δ, hli, hlj]
  obtain ⟨D, hD, hθD⟩ := CoordSL.diag_mem_classBlock (ε := ε) (hC := hC)
    hprim.pow_eq_one hsupp (sum_anti (r := 2) i j)
  have hDpair : D ∈ CFSG.RankThree.CALinearPlane.coordBlockSL L {i, j} := by
    simpa only [β, classSet_pair (r := 2) i j hij] using hD
  have hDcoe : (D : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal fun l => (v l : L) := by
    have hraw : (D : Matrix (Fin 3) (Fin 3) L) =
        Matrix.diagonal fun l => AdjoinRoot.root g ^ (δ l).val := by
      apply QTwoBlocks.thetaMat_injective (ε := ε)
      rw [CoordSL.thetaMat_diagonal]
      exact congrArg Subtype.val hθD
    simpa [v, hz] using hraw
  have htR : t ∈ R := ⟨D, hDpair, hθD⟩
  rw [Subgroup.map_le_iff_le_comap]
  refine (coordBlockSL_le_closure (F := L) {i, j}).trans ((Subgroup.closure_le _).mpr ?_)
  rintro A ⟨a, b, hab, ha, hb, c, rfl⟩
  change CoordSL.theta g ε (Matrix.SpecialLinearGroup.transvection hab c) ∈ ⁅R, Subgroup.zpowers t⁆
  have hvab : v a ≠ v b := by
    simp only [Finset.mem_insert, Finset.mem_singleton] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · exact False.elim (hab rfl)
    · simpa only [hvi, hvj] using hz12
    · simpa only [hvi, hvj] using Ne.symm hz12
    · exact False.elim (hab rfl)
  let μ : L := (v a : L) * (((v b)⁻¹ : Lˣ) : L)
  have hμ : μ ≠ 1 := by
    intro h
    apply hvab
    exact mul_inv_eq_one.mp (Units.ext h)
  let c' : L := c / (μ - 1)
  have hU : CoordSL.theta g ε (Matrix.SpecialLinearGroup.transvection hab c') ∈ R :=
    ⟨_, SLRep.transvection_mem_coordBlockSL ha hb hab c', rfl⟩
  have hcomm : ⁅t, CoordSL.theta g ε (Matrix.SpecialLinearGroup.transvection hab c')⁆ ∈
      ⁅R, Subgroup.zpowers t⁆ := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.commutator_mem_commutator ⟨(1 : ℤ), by simp⟩ hU
  have hconj := conjugate_transvection_of_diagonal v hDcoe hab c'
  have hsrc : ⁅D, Matrix.SpecialLinearGroup.transvection hab c'⁆ =
      Matrix.SpecialLinearGroup.transvection hab c := by
    rw [commutatorElement_def, hconj, Matrix.SpecialLinearGroup.transvection_inv,
      ← Matrix.SpecialLinearGroup.transvection_add]
    congr 1
    change (v a : L) * c' * (((v b)⁻¹ : Lˣ) : L) + -c' = c
    have hden : μ - 1 ≠ 0 := sub_ne_zero.mpr hμ
    calc
      (v a : L) * c' * (((v b)⁻¹ : Lˣ) : L) + -c' = (μ - 1) * c' := by
        dsimp only [μ]
        ring
      _ = c := by
        dsimp only [c']
        rw [_root_.mul_comm, div_mul_cancel₀ _ hden]
  have hEq : ⁅t, CoordSL.theta g ε (Matrix.SpecialLinearGroup.transvection hab c')⁆ =
      CoordSL.theta g ε (Matrix.SpecialLinearGroup.transvection hab c) := by
    simpa only [map_commutatorElement, hθD, t] using congrArg (CoordSL.theta g ε) hsrc

  exact hEq ▸ hcomm

theorem fieldPair_le_commutator_antiTorus
    {ε : Fin m ≃ (Fin (CoordSL.rootPB g).dim × Fin 3) ⊕ Fin d}
    (hg : g ∣ cyclotomic 3 (ZMod 2)) (i j : Fin 3) (hij : i ≠ j) :
    (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
      (κ.comp (CoordSL.theta g ε)) ≤
      ⁅(CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
          (κ.comp (CoordSL.theta g ε)),
        Subgroup.zpowers (CoordSL.frameHom κ 1 ε hC hCp
          (Multiplicative.ofAdd (Pi.single i 1 - Pi.single j 1)))⁆ := by
  have hn := native_fieldPair_le_commutator_antiTorus (ε := ε) (hC := hC) hg i j hij
  have hm := Subgroup.map_mono (f := κ) hn
  simpa only [Subgroup.map_commutator, MonoidHom.map_zpowers, Subgroup.map_map,
    GGSecFiveBPermQTwoKFrame.frameHom_ofAdd] using hm

private theorem exists_third (i j : Fin 3) : ∃ k : Fin 3, k ≠ i ∧ k ≠ j := by
  revert i j
  decide

theorem reflComm [Finite G]
    {π : Fin 4 ≃ Fin n}
    {ε : Fin m ≃ (Fin (CoordSL.rootPB g).dim × Fin 3) ⊕ Fin d}
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hm : m = 6 ∨ m = 7)
    (hBs : ∀ x ∈ Subgroup.centralizer (Bs : Set G), x ^ 3 = 1 → x ∈ Bs)
    {y : G} (hyB : y ∈ Bs)
    (hK : CFSG.Open.IsComponentOf K (Subgroup.centralizer ({y} : Set G)))
    (i j : Fin 3) (hij : i ≠ j) :
    ⁅Subgroup.centralizer (ggBsCoordEq Bs eta (π i.succ) (π j.succ) : Set G), Bs⁆ =
      (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
        (κ.comp (CoordSL.theta g ε)) := by
  classical
  let H := ggBsCoordEq Bs eta (π i.succ) (π j.succ)
  let R := (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
    (κ.comp (CoordSL.theta g ε))
  let t := CoordSL.frameHom κ 1 ε hC hCp (Multiplicative.ofAdd (Pi.single i 1 - Pi.single j 1))
  obtain ⟨k, hki, hkj⟩ := exists_third i j
  let Ck := Subgroup.centralizer
    ({SLNS.nsSL ε hC (fun l => ((Pi.single i 1 + Pi.single j 1 : Fin 3 → ZMod 3) l).val),
      SLNS.nsSL ε hC (fun l => ((Pi.single k 1 : Fin 3 → ZMod 3) l).val)} : Set (SL(m, ZMod 2)))
  have hN : Subgroup.centralizer (H : Set G) ≤ Subgroup.normalizer (K : Set G) :=
    centralizer_coordEq_le_normalizer hF hBs hyB hK i j k hki hkj
  have htB : t ∈ Bs := hF.frameHom_mem_Bs hBs _
  have htR : t ∈ R := antiTorus_mem_fieldPair hF i j hij
  have hRC : R ≤ Subgroup.centralizer (H : Set G) := fieldPair_le_centralizer hF i j hij
  have hRK : R ≤ K := by
    rintro z ⟨M, hM, rfl⟩
    rw [← hF.2.1]
    exact ⟨CoordSL.theta g ε M, rfl⟩
  have hRD : R ≤ K ⊓ Subgroup.centralizer (H : Set G) := le_inf hRK hRC
  have hRt : R ≤ ⁅R, Subgroup.zpowers t⁆ :=
    fieldPair_le_commutator_antiTorus hF.2.2.1 i j hij
  have hCD : K ⊓ Subgroup.centralizer (H : Set G) ≤ Ck.map κ :=
    centralizer_coordEq_le_map_pair_centralizer hF hBs i j k hij hki hkj
  have hNative : ⁅Ck, Ck⁆ =
      (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map (CoordSL.theta g ε) :=
    QTwoBlocks.pair_centralizer_derived hm hF.2.2.1 ε hC hCp i j k hij hki hkj
  have hDR : ⁅K ⊓ Subgroup.centralizer (H : Set G),
      K ⊓ Subgroup.centralizer (H : Set G)⁆ ≤ R := by
    calc
      _ ≤ ⁅Ck.map κ, Ck.map κ⁆ := Subgroup.commutator_mono hCD hCD
      _ = R := by rw [← Subgroup.map_commutator, hNative, Subgroup.map_map]
  have htD : t ∈ ⁅K ⊓ Subgroup.centralizer (H : Set G),
      K ⊓ Subgroup.centralizer (H : Set G)⁆ :=
    Subgroup.commutator_mono hRD (Subgroup.zpowers_le.mpr (hRD htR)) (hRt htR)
  have hBc : ∀ a ∈ Bs, ∀ b ∈ Bs, a * b = b * a := by
    intro a ha b hb
    have h : (⟨a, ha⟩ : ↥Bs) * ⟨b, hb⟩ = ⟨b, hb⟩ * ⟨a, ha⟩ :=
      eta.injective (by rw [map_mul, map_mul, _root_.mul_comm])
    exact congrArg Subtype.val h
  exact ggCommutator_centralizer_eq hBc (ggBsCoordEq_le _ _) htB (coordEq_gen hF hBs i j hij)
    hN htD hDR hRC hRt

theorem original_adjacent_root_eq_fieldPair [Finite G]
    {π : Fin 4 ≃ Fin n} {L : Subgroup G}
    {ε : Fin m ≃ (Fin (CoordSL.rootPB g).dim × Fin 3) ⊕ Fin d}
    {σ : SL(4, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hFL : GGSecFiveBPermSpLFrame Bs L eta π σ χ) (hm : m = 6 ∨ m = 7)
    (hBs : ∀ a ∈ Subgroup.centralizer (Bs : Set G), a ^ 3 = 1 → a ∈ Bs)
    {x y : G} (hxB : x ∈ Bs) (hyB : y ∈ Bs)
    (hL : CFSG.Assembly.IsComponentOf L (Subgroup.centralizer {x}))
    (hK : CFSG.Open.IsComponentOf K (Subgroup.centralizer {y})) (a : Fin 2) :
    (σ.comp (CFSG.ClassicalInvolution.WeakCT.blockSL2 (GaloisField 2 2) 3 a.succ)).range =
      (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {a.castSucc, a.succ}).map
        (κ.comp (CoordSL.theta g ε)) := by
  have hBc : ∀ u ∈ Bs, ∀ v ∈ Bs, u * v = v * u := by
    intro u hu v hv
    have h : (⟨u, hu⟩ : ↥Bs) * ⟨v, hv⟩ = ⟨v, hv⟩ * ⟨u, hu⟩ :=
      eta.injective (by rw [map_mul, map_mul, _root_.mul_comm])
    exact congrArg Subtype.val h
  have hOld := ggSecFiveBPermSp_reflComm_L (p := 3) (r := 2) (f := 2)
    (by decide) (by decide) hBc hBs hxB hL hFL a.succ
  have hNew := reflComm hF hm hBs hyB hK a.castSucc a.succ
    (show a.castSucc ≠ a.succ by
      intro h
      have hv := congrArg Fin.val h
      simp only [Fin.val_castSucc, Fin.val_succ] at hv
      omega)
  exact hOld.symm.trans hNew

private theorem reindex_innerDiag {F : Type} [Field F] (e : Equiv.Perm (Fin 4))
    (d : Fin 4 → Fˣ) (u : SL(4, F)) :
    CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := F) e
      (InnerDiagA.conjSL (InnerDiagA.diagGL (d ∘ e)) u) =
      InnerDiagA.conjSL (InnerDiagA.diagGL d)
        (CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := F) e u) := by
  apply Subtype.ext
  ext a b
  change ((InnerDiagA.conjSL (InnerDiagA.diagGL (d ∘ e)) u : SL(4, F)) :
      Matrix (Fin 4) (Fin 4) F) (e.symm a) (e.symm b) = _
  simp only [InnerDiagA.coe_conjSL, InnerDiagA.coe_diagGL, InnerDiagA.coe_diagGL_inv,
    Matrix.mul_diagonal, Matrix.diagonal_mul, Function.comp_apply, Equiv.apply_symm_apply]
  rfl

private theorem lframe_reindex {π : Fin 4 ≃ Fin n} {L : Subgroup G}
    {σ : SL(4, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hFL : GGSecFiveBPermSpLFrame Bs L eta π σ χ) (e : Equiv.Perm (Fin 4)) :
    GGSecFiveBPermSpLFrame Bs L eta (e.trans π)
      (σ.comp (CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear
        (K := GaloisField 2 2) e).toMonoidHom) χ := by
  let ρ := CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := GaloisField 2 2) e
  refine ⟨?_, ?_, hFL.2.2.1, ?_⟩
  · intro u hu
    have hc : ρ u ∈ Subgroup.center SL(4, GaloisField 2 2) :=
      hFL.1 (show σ (ρ u) = 1 from MonoidHom.mem_ker.mp hu)
    rw [Subgroup.mem_center_iff]
    intro v
    apply ρ.injective
    rw [map_mul, map_mul]
    exact Subgroup.mem_center_iff.mp hc (ρ v)
  · rw [← hFL.2.1]
    apply le_antisymm
    · rintro z ⟨u, rfl⟩
      exact ⟨ρ u, rfl⟩
    · rintro z ⟨u, rfl⟩
      obtain ⟨v, rfl⟩ := ρ.surjective u
      exact ⟨v, rfl⟩
  · intro b u
    change (b : G) * σ (ρ u) * (b : G)⁻¹ = _
    rw [hFL.2.2.2 b (ρ u)]
    exact congrArg σ (reindex_innerDiag e (fun a => χ (eta b (π a))) u).symm

theorem original_root_eq_fieldPair [Finite G]
    {π : Fin 4 ≃ Fin n} {L : Subgroup G}
    {ε : Fin m ≃ (Fin (CoordSL.rootPB g).dim × Fin 3) ⊕ Fin d}
    {σ : SL(4, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hF : GGSecFiveBPermQTwoKFrame Bs K eta π ε hC hCp κ)
    (hFL : GGSecFiveBPermSpLFrame Bs L eta π σ χ) (hm : m = 6 ∨ m = 7)
    (hBs : ∀ a ∈ Subgroup.centralizer (Bs : Set G), a ^ 3 = 1 → a ∈ Bs)
    {x y : G} (hxB : x ∈ Bs) (hyB : y ∈ Bs)
    (hL : CFSG.Assembly.IsComponentOf L (Subgroup.centralizer {x}))
    (hK : CFSG.Open.IsComponentOf K (Subgroup.centralizer {y})) (i j : Fin 3) (hij : i ≠ j) :
    (CFSG.RankThree.CALinearPlane.coordBlockSL (GaloisField 2 2) {i.succ, j.succ}).map σ =
      (CFSG.RankThree.CALinearPlane.coordBlockSL (AdjoinRoot g) {i, j}).map
        (κ.comp (CoordSL.theta g ε)) := by
  classical
  let e : Equiv.Perm (Fin 4) := Equiv.swap 0 i.succ * Equiv.swap 1 j.succ
  let ρ := CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := GaloisField 2 2) e
  have h0i : e 0 = i.succ := by
    simp [e, Equiv.Perm.mul_apply, Equiv.swap_apply_def,
      show (0 : Fin 4) ≠ 1 by decide, Ne.symm (Fin.succ_ne_zero j)]
  have h1j : e 1 = j.succ := by
    have hji : j.succ ≠ i.succ := fun h => hij (Fin.succ_inj.mp h).symm
    simp [e, Equiv.Perm.mul_apply, Equiv.swap_apply_def, hji, Fin.succ_ne_zero j]
  have hBc : ∀ u ∈ Bs, ∀ v ∈ Bs, u * v = v * u := by
    intro u hu v hv
    have h : (⟨u, hu⟩ : ↥Bs) * ⟨v, hv⟩ = ⟨v, hv⟩ * ⟨u, hu⟩ :=
      eta.injective (by rw [map_mul, map_mul, _root_.mul_comm])
    exact congrArg Subtype.val h
  have hOld := ggSecFiveBPermSp_reflComm_L (p := 3) (r := 2) (f := 2)
    (by decide) (by decide) hBc hBs hxB hL (lframe_reindex hFL e) 0
  have hCoords : (e.trans π) (0 : Fin 3).castSucc = π i.succ ∧
      (e.trans π) (0 : Fin 3).succ = π j.succ := by
    constructor
    · change π (e 0) = _
      rw [h0i]
    · change π (e 1) = _
      rw [h1j]
  rw [hCoords.1, hCoords.2] at hOld
  have hRange : ((σ.comp ρ.toMonoidHom).comp
      (CFSG.ClassicalInvolution.WeakCT.blockSL2 (GaloisField 2 2) 3 0)).range =
      (CFSG.RankThree.CALinearPlane.coordBlockSL (GaloisField 2 2) {i.succ, j.succ}).map σ := by
    rw [MonoidHom.range_comp, ← Subgroup.map_map,
      CFSG.SeitzReduction.LinearPilot.range_blockSL2_eq]
    have hMap := CFSG.SeitzReduction.SymplecticPilot.map_reindex_blockSpecialLinear
      (F := GaloisField 2 2) e ({0, 1} : Finset (Fin 4))
    have hSet : ({0, 1} : Finset (Fin 4)).map e.toEmbedding = {i.succ, j.succ} := by
      simp [h0i, h1j]
    rw [hSet] at hMap
    change ((CFSG.SeitzReduction.LinearPilot.blockSpecialLinear
      (K := GaloisField 2 2) ({0, 1} : Finset (Fin 4))).map ρ.toMonoidHom).map σ = _
    rw [hMap, ← blockSpecialLinear_eq_coordBlockSL]
  rw [hRange] at hOld
  exact hOld.symm.trans (reflComm hF hm hBs hyB hK i j hij)

end CFSG.StandardType.GGSecFiveBPermQTwoKFrame

