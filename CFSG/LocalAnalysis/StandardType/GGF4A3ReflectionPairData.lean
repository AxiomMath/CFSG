theorem stage2A1 : ∀ x₀, x₀ < 24 → ∀ x₂, x₂ < 24 →
    relA (Rm x₀) (Sm 1) (Rm x₂) →
      conjW (W2A1 (x₀ * 24 + x₂)) (Rm x₀) = Rm 5 ∧
        conjW (W2A1 (x₀ * 24 + x₂)) (Rm x₂) = Rm 6 ∧
        conjW (W2A1 (x₀ * 24 + x₂)) (Sm 1) = Sm 1 := by
  decide +kernel

