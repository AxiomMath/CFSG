namespace CFSG.StandardType.F4Model

@[expose] def relab (a₀ a₁ a₂ : M4) : Bool :=
  pw3 (a₀.mul a₁) == M4.one && a₀.mul a₁ != M4.one &&
    pw3 (a₁.mul a₂) == M4.one && a₁.mul a₂ != M4.one &&
    pw2 (a₀.mul a₂) == M4.one && a₀.mul a₂ != M4.one

@[expose] def relA (a₀ a₁ a₂ : M4) : Prop := relab a₀ a₁ a₂ = true

instance (a₀ a₁ a₂ : M4) : Decidable (relA a₀ a₁ a₂) :=
  inferInstanceAs (Decidable (relab a₀ a₁ a₂ = true))

theorem relA_iff (a₀ a₁ a₂ : M4) : relA a₀ a₁ a₂ ↔
    (pw3 (a₀.mul a₁) = M4.one ∧ a₀.mul a₁ ≠ M4.one ∧
      pw3 (a₁.mul a₂) = M4.one ∧ a₁.mul a₂ ≠ M4.one ∧
      pw2 (a₀.mul a₂) = M4.one ∧ a₀.mul a₂ ≠ M4.one) := by
  simp [relA, relab, Bool.and_eq_true, and_assoc]

