private theorem odd_sub_one_of_even {q : ℕ} (hq : Even q) (h2 : 2 ≤ q) : Odd (q - 1) := by
  obtain ⟨r, rfl⟩ := hq
  have hr : 1 ≤ r := by omega
  exact ⟨r - 1, by omega⟩

private theorem odd_add_one_of_even {q : ℕ} (hq : Even q) : Odd (q + 1) := by
  obtain ⟨r, rfl⟩ := hq
  exact ⟨r, by omega⟩

private theorem gcd_two_sub_one_of_even {q : ℕ} (hq : Even q) (h2 : 2 ≤ q) :
    Nat.gcd 2 (q - 1) = 1 :=
  Nat.Coprime.gcd_eq_one (Nat.coprime_two_left.mpr (odd_sub_one_of_even hq h2))

private theorem gcd_two_add_one_of_even {q : ℕ} (hq : Even q) : Nat.gcd 2 (q + 1) = 1 :=
  Nat.Coprime.gcd_eq_one (Nat.coprime_two_left.mpr (odd_add_one_of_even hq))

theorem four_le_card_of_charP_two_of_ne_two (E : Type) [Field E] [Fintype E] [CharP E 2]
    (h : Fintype.card E ≠ 2) : 4 ≤ Fintype.card E := by
  obtain ⟨n, -, hn⟩ := FiniteField.card E 2
  have h2 : 2 ≤ Fintype.card E := Fintype.one_lt_card
  rw [hn] at h h2 ⊢
  have hn2 : 2 ≤ (n : ℕ) := by
    by_contra hlt
    have hle : (n : ℕ) ≤ 1 := by omega
    have hp2 : 2 ^ (n : ℕ) ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) hle
    simp only [pow_one] at hp2
    have hge3 : 3 ≤ 2 ^ (n : ℕ) := by omega
    omega
  calc 4 = 2 ^ 2 := by norm_num
    _ ≤ 2 ^ (n : ℕ) := Nat.pow_le_pow_right (by norm_num) hn2

private theorem ggSpLayerOrd_one {q : ℕ} (hq : Even q) (h2 : 2 ≤ q) :
    ggSpLayerOrd 1 q = ordA 1 q := by
  have hg := gcd_two_sub_one_of_even hq h2
  have hnot : ¬ ((1 : ℕ) = 2 ∧ q = 2) := by omega
  simp only [ggSpLayerOrd, hnot, if_false, ordBC, ordA, hg]
  norm_num

private theorem ordTwistedA_one_eq_ordA_one {q : ℕ} (hq : Even q) (h2 : 2 ≤ q) :
    ordTwistedA 1 q = ordA 1 q := by
  have hg := gcd_two_add_one_of_even hq
  have hg' := gcd_two_sub_one_of_even hq h2
  have h2' : ((q : ℤ) ^ 2).toNat = q ^ 2 := by
    apply Nat.cast_injective (R := ℤ)
    rw [Int.toNat_of_nonneg]
    · push_cast; ring
    · positivity
  simp only [ordTwistedA, ordA]
  norm_num
  rw [h2', hg, hg']

theorem isChevTwoLayeredBy_specialLinear (n : Type) [Fintype n] [DecidableEq n]
    (E : Type) [Field E] [Fintype E] [CharP E 2] :
    IsChevTwoLayeredBy (Matrix.SpecialLinearGroup n E)
      [ordA (Fintype.card n - 1) (Fintype.card E)] := by
  let m := Fintype.card n
  let e : n ≃ Fin m := Fintype.equivFin n
  let ere : Matrix.SpecialLinearGroup n E ≃* Matrix.SpecialLinearGroup (Fin m) E :=
    CFSG.RankThree.PartOne.KFCL.BlockSL.reindexSL e
  haveI : Finite (Matrix.SpecialLinearGroup n E) := inferInstance
  by_cases hm : m ≤ 1
  · haveI : Subsingleton (Matrix.SpecialLinearGroup (Fin m) E) := by
      have hm01 : m = 0 ∨ m = 1 := by omega
      rcases hm01 with hm0 | hm1
      · rw [hm0]; exact inferInstance
      · rw [hm1]; exact inferInstance
    haveI : Subsingleton (Matrix.SpecialLinearGroup n E) :=
      ⟨fun a b => ere.injective (Subsingleton.elim (ere a) (ere b))⟩
    exact isChevTwoLayeredBy_of_isSolvable
      (Group.isSolvable_of_comm fun a b => Subsingleton.elim _ _) _
  · push Not at hm
    have hm2 : 2 ≤ m := by omega
    by_cases h22 : m = 2 ∧ Fintype.card E = 2
    · obtain ⟨hm2', hcardE⟩ := h22
      have hcardn : Fintype.card n = 2 := by simpa [m] using hm2'
      let e2n : n ≃ Fin 2 := Fintype.equivFinOfCardEq hcardn
      let ere2 : Matrix.SpecialLinearGroup n E ≃* Matrix.SpecialLinearGroup (Fin 2) E :=
        CFSG.RankThree.PartOne.KFCL.BlockSL.reindexSL e2n
      obtain ⟨e2⟩ := CFSG.StandardType.RCSPSL.nonempty_sl2_equiv_perm
        (F := E) (by rwa [Nat.card_eq_fintype_card])
      haveI : Group.IsSolvable (Equiv.Perm (Fin 3)) := Equiv.Perm.isSolvable (by simp)
      have hsolv2 : Group.IsSolvable (Matrix.SpecialLinearGroup (Fin 2) E) :=
        Group.isSolvable_of_isSolvable_injective (f := e2.toMonoidHom) e2.injective
      have hsolv : Group.IsSolvable (Matrix.SpecialLinearGroup n E) :=
        Group.isSolvable_of_isSolvable_injective (f := ere2.toMonoidHom) ere2.injective
      exact isChevTwoLayeredBy_of_isSolvable hsolv _
    · have hring : ringChar E = 2 := ringChar.eq E 2
      have hE4 : m = 2 → 4 ≤ Fintype.card E := by
        intro hm2'
        exact four_le_card_of_charP_two_of_ne_two E (fun hc => h22 ⟨hm2', hc⟩)
      have hFD : CFSG.HardMathSupport.Solomon.Coordinator.LieComp.LieFactorData 2
          (Matrix.SpecialLinearGroup (Fin m) E) := by
        simpa [hring] using
          CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds E m hm2 hE4
      have h22' : m ≠ 2 ∨ Nat.card E ≠ 2 := by
        by_cases hm2' : m = 2
        · right
          intro hc
          exact h22 ⟨hm2', by rwa [Nat.card_eq_fintype_card] at hc⟩
        · left; exact hm2'
      have h23' : m ≠ 2 ∨ Nat.card E ≠ 3 := by
        by_cases hm2' : m = 2
        · right
          have h4 := hE4 hm2'
          have hc := Nat.card_eq_fintype_card (α := E)
          omega
        · left; exact hm2'
      have hQ : CFSG.Open.IsQuasisimple (Matrix.SpecialLinearGroup (Fin m) E) :=
        CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp
          (CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_quasisimple
            m E hm2 h22' h23')
      have hcard : Nat.card (Matrix.SpecialLinearGroup (Fin m) E ⧸
          Subgroup.center (Matrix.SpecialLinearGroup (Fin m) E)) =
          ordA (m - 1) (Fintype.card E) := by
        haveI : Finite E := Finite.of_fintype E
        rw [Nat.card_congr
            (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj m E).toEquiv,
          card_statedProj_statedSL (by omega), Nat.card_eq_fintype_card, ordA,
          Nat.sub_add_cancel (by omega : 1 ≤ m), mul_comm (m - 1) m]
      have hcomp := isChevTwoLayeredBy_of_isQuasisimple hQ hFD.chev
      have hcomp' : IsChevTwoLayeredBy (Matrix.SpecialLinearGroup (Fin m) E)
          [ordA (m - 1) (Fintype.card E)] := by
        simpa [hcard] using hcomp
      simpa [m] using hcomp'.of_mulEquiv ere

private theorem isChevTwoLayeredBy_comm_sp_four_two (E : Type) [Field E] [Fintype E]
    (hE : Fintype.card E = 2) :
    IsChevTwoLayeredBy ↥(commutator ↥(StatedSp 2 E)) [360] := by
  have hk : Nat.card E = 2 := by rwa [Nat.card_eq_fintype_card]
  let eSp : StatedSp 2 E ≃* CFSG.ComponentClassification.PresentationLocal.sympFour :=
    (CFSG.Monster.Existence.Compat.statedProjEquivOfBot (StatedSp 2 E)
      (CFSG.Monster.Existence.Compat.statedScalars_eq_bot hk)).symm.trans
      (CFSG.RankThree.PartOne.KCSpComm.statedProjEquivSympFour hk)
  have hmap : (commutator (StatedSp 2 E)).map eSp.toMonoidHom =
      commutator CFSG.ComponentClassification.PresentationLocal.sympFour := by
    rw [commutator_def, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
      MonoidHom.range_eq_top.mpr eSp.surjective]
  let eComm : ↥(commutator (StatedSp 2 E)) ≃*
      ↥(commutator CFSG.ComponentClassification.PresentationLocal.sympFour) :=
    (eSp.subgroupMap (commutator (StatedSp 2 E))).trans (MulEquiv.subgroupCongr hmap)
  let eA6 : ↥(commutator (StatedSp 2 E)) ≃* alternatingGroup (Fin 6) :=
    eComm.trans CFSG.ComponentClassification.PresentationLocal.commutatorEquivAlternating
  have hNcard : Nat.card ↥(commutator (StatedSp 2 E)) = 360 := by
    rw [Nat.card_congr eA6.toEquiv,
      CFSG.ComponentClassification.CatalogueSchreierAlternating.DegreeSix.card_alternating_six]
  have hQN : CFSG.Open.IsQuasisimple ↥(commutator (StatedSp 2 E)) :=
    CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp
      (CFSG.HardMathSupport.Cooperstein.Coordinator.LieInput.isChevComponent_comm_sp_four_two
        hk).1
  haveI : IsSimpleGroup
      ↥(commutator CFSG.ComponentClassification.PresentationLocal.sympFour) :=
    CFSG.ComponentClassification.PresentationLocal.isSimpleGroup_commutator_sympFour
  haveI : IsSimpleGroup ↥(commutator (StatedSp 2 E)) := eComm.isSimpleGroup
  have hcen : Subgroup.center ↥(commutator (StatedSp 2 E)) = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
      (Subgroup.center ↥(commutator (StatedSp 2 E))) with h | h
    · exact h
    · exfalso
      haveI : IsSimpleGroup (↥(commutator (StatedSp 2 E)) ⧸
          Subgroup.center ↥(commutator (StatedSp 2 E))) := hQN.2
      have hsub : Subsingleton (↥(commutator (StatedSp 2 E)) ⧸
          Subgroup.center ↥(commutator (StatedSp 2 E))) := QuotientGroup.subsingleton_iff.mpr h
      exact not_subsingleton _ hsub
  have h360 : Nat.card (↥(commutator (StatedSp 2 E)) ⧸
      Subgroup.center ↥(commutator (StatedSp 2 E))) = 360 := by
    rw [Nat.card_congr (QuotientGroup.quotientMulEquivOfEq hcen).toEquiv,
      Nat.card_congr QuotientGroup.quotientBot.toEquiv, hNcard]
  have hNFD : CFSG.HardMathSupport.Solomon.Coordinator.LieComp.LieFactorData 2
      ↥(commutator ↥(StatedSp 2 E)) :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.spFourTwoFacts_holds E hE
  have hcomp := isChevTwoLayeredBy_of_isQuasisimple hQN hNFD.chev
  simpa [h360] using hcomp

theorem isChevTwoLayeredBy_statedSp (m : ℕ) (E : Type) [Field E] [Fintype E] [CharP E 2] :
    IsChevTwoLayeredBy ↥(StatedSp m E) [ggSpLayerOrd m (Fintype.card E)] := by
  haveI : Finite ↥(StatedSp m E) := inferInstance
  haveI : Finite E := Finite.of_fintype E
  have hq : Even (Fintype.card E) :=
    Nat.even_iff.mpr (FiniteField.even_card_of_char_two (ringChar.eq E 2))
  have h2 : 2 ≤ Fintype.card E := Fintype.one_lt_card
  have hcardSp : ∀ k : ℕ, Nat.card (↥(StatedSp k E) ⧸ Subgroup.center (StatedSp k E)) =
      ordBC k (Fintype.card E) := by
    intro k
    rw [Nat.card_congr (CFSG.LieType.Universal.Symplectic.centerQuotientEquiv k E).toEquiv,
      card_statedProj_statedSp_of_charTwo, ordBC, gcd_two_sub_one_of_even hq h2, Nat.div_one]
    simp [Nat.card_eq_fintype_card, sq]
  rcases Nat.eq_zero_or_pos m with hm0 | hmpos
  · subst m
    haveI : Subsingleton ↥(StatedSp 0 E) := inferInstance
    exact isChevTwoLayeredBy_of_isSolvable
      (Group.isSolvable_of_comm fun a b => Subsingleton.elim _ _) _
  · by_cases hm1 : m = 1
    · subst m
      have hSL := isChevTwoLayeredBy_specialLinear (Fin 2) E
      have h := hSL.of_mulEquiv
        (CFSG.ClassicalInvolution.Models.SymplecticPairs.longBlockEquivOne E).symm
      rw [ggSpLayerOrd_one hq h2]
      simpa using h
    · have hm2 : 2 ≤ m := by omega
      by_cases h22 : m = 2 ∧ Fintype.card E = 2
      · obtain ⟨hm2', hcardE⟩ := h22
        subst hm2'
        have hcommNorm : (commutator ↥(StatedSp 2 E)).Normal := inferInstance
        have hN : IsChevTwoLayeredBy ↥(commutator ↥(StatedSp 2 E)) [360] :=
          isChevTwoLayeredBy_comm_sp_four_two E hcardE
        haveI : IsMulCommutative
            (↥(StatedSp 2 E) ⧸ commutator ↥(StatedSp 2 E)) :=
          Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr le_rfl
        have hq' : Group.IsSolvable
            (↥(StatedSp 2 E) ⧸ commutator ↥(StatedSp 2 E)) :=
          Group.isSolvable_of_comm fun a b => mul_comm' a b
        have hmain := hN.of_normal_of_solvable_quotient
          (commutator ↥(StatedSp 2 E)) hq'
        have hgg : ggSpLayerOrd 2 (Fintype.card E) = 360 := by
          simp [ggSpLayerOrd, hcardE]
        rwa [hgg]
      · have hne : (m, Fintype.card E) ≠ (2, 2) := fun h => h22 (by simpa using h)
        have hnot : ¬ (m = 2 ∧ Fintype.card E = 2) := fun h => hne (by simpa using h)
        have hring : ringChar E = 2 := ringChar.eq E 2
        have hFD : CFSG.HardMathSupport.Solomon.Coordinator.LieComp.LieFactorData 2
            ↥(StatedSp m E) := by
          simpa [hring] using
            CFSG.HardMathSupport.Solomon.Coordinator.LieComp.spFactorFacts_holds E m hm2 hne
        have hF : (Infinite E ∨ 4 ≤ Nat.card E) ∨ (Nat.card E = 3 ∧ 2 ≤ m) ∨
            (Nat.card E = 2 ∧ 3 ≤ m) := by
          by_cases h2' : Nat.card E = 2
          · right; right
            have hcardE : Fintype.card E = 2 := by rwa [Nat.card_eq_fintype_card] at h2'
            have hmne : m ≠ 2 := fun hm' => hne (by rw [hm', hcardE])
            exact ⟨h2', by omega⟩
          · left; right
            have hc : Fintype.card E ≠ 2 := fun hc =>
              h2' (by rwa [Nat.card_eq_fintype_card])
            simpa [Nat.card_eq_fintype_card] using
              four_le_card_of_charP_two_of_ne_two E hc
        have hQ : CFSG.Open.IsQuasisimple ↥(StatedSp m E) :=
          CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp
            (CFSG.LieType.Universal.Symplectic.isQuasisimple m E (by omega) hF)
        have hcard : Nat.card (↥(StatedSp m E) ⧸ Subgroup.center (StatedSp m E)) =
            ggSpLayerOrd m (Fintype.card E) := by
          rw [show ggSpLayerOrd m (Fintype.card E) = ordBC m (Fintype.card E) by
            simp [ggSpLayerOrd, hnot]]
          exact hcardSp m
        have hcomp := isChevTwoLayeredBy_of_isQuasisimple hQ hFD.chev
        simpa [hcard] using hcomp

theorem isChevTwoLayeredBy_statedSU (m q : ℕ) (K : Type) [Field K] [Fintype K] [CharP K 2]
    (hK : Fintype.card K = q ^ 2) :
    IsChevTwoLayeredBy ↥(StatedSU m q K) [ordTwistedA (m - 1) q] := by
  haveI : Finite ↥(StatedSU m q K) := inferInstance
  haveI : Finite K := Finite.of_fintype K
  have hq2 : 2 ≤ q := by
    by_contra h
    have hq1 : q ≤ 1 := by omega
    have hle : q ^ 2 ≤ 1 := by nlinarith
    have hcard := Fintype.one_lt_card (α := K)
    omega
  have hKq : Nat.card K = q ^ 2 := by rwa [Nat.card_eq_fintype_card]
  obtain ⟨hp, f, hf, hqf⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.prime_ringChar_and_eq_pow_of_card_sq
      K q hKq hq2
  have hring : ringChar K = 2 := ringChar.eq K 2
  have hqpow : q = 2 ^ f := by rw [hring] at hqf; exact hqf
  rw [hqpow] at hK hKq ⊢
  have h2f : 2 ≤ 2 ^ f := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  have hevenf : Even (2 ^ f) := Nat.even_pow.mpr ⟨even_two, by omega⟩
  rcases Nat.lt_or_ge m 2 with hm2 | hm2
  · have hm01 : m = 0 ∨ m = 1 := by omega
    rcases hm01 with hm0 | hm1
    · subst m
      haveI : Subsingleton ↥(StatedSU 0 (2 ^ f) K) := inferInstance
      exact isChevTwoLayeredBy_of_isSolvable
        (Group.isSolvable_of_comm fun a b => Subsingleton.elim _ _) _
    · subst m
      have hcomm : ∀ A B : ↥(StatedSU 1 (2 ^ f) K), A * B = B * A := by
        intro A B
        apply Subtype.ext
        apply Units.ext
        ext i j
        fin_cases i
        fin_cases j
        simp [Matrix.mul_apply, mul_comm]
      exact isChevTwoLayeredBy_of_isSolvable (Group.isSolvable_of_comm hcomm) _
  · by_cases hm2' : m = 2
    · subst m
      haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      have hK' : Nat.card K = (2 ^ f) ^ 2 := hKq
      obtain ⟨e⟩ :=
        CFSG.RankThree.SubgroupLists.nonempty_sl2_mulEquiv_statedSU_two
          (K := K) (r := 2) (f := f) hK'
      haveI : Fintype ↥(CFSG.LieType.Steinberg.fixedSubfield K 2 f) := Fintype.ofFinite _
      have hSL := isChevTwoLayeredBy_specialLinear (Fin 2)
        (CFSG.LieType.Steinberg.fixedSubfield K 2 f)
      have hcard : Fintype.card (CFSG.LieType.Steinberg.fixedSubfield K 2 f) = 2 ^ f := by
        rw [← Nat.card_eq_fintype_card, CFSG.LieType.Steinberg.card_fixedSubfield hK']
      have hSL' : IsChevTwoLayeredBy
          (Matrix.SpecialLinearGroup (Fin 2) (CFSG.LieType.Steinberg.fixedSubfield K 2 f))
          [ordA 1 (2 ^ f)] := by
        simpa [hcard] using hSL
      have h := hSL'.of_mulEquiv e.symm
      rw [ordTwistedA_one_eq_ordA_one (q := 2 ^ f) hevenf h2f]
      simpa using h
    · by_cases h32 : m = 3 ∧ 2 ^ f = 2
      · obtain ⟨hm3, hq3⟩ := h32
        subst hm3
        rw [hq3] at hK hKq ⊢
        have hK' : Nat.card K = (2 ^ 1) ^ 2 := by rw [hKq]; norm_num
        have h216 :=
          CFSG.Quasithin.Background.Harris.OrdinaryProofs.card_statedSU_three_two_of_card_four
            hK'
        have h216' : Nat.card ↥(StatedSU 3 2 K) = 216 := by
          simpa using h216
        haveI : Fintype ↥(StatedSU 3 2 K) := Fintype.ofFinite _
        have hcard : Fintype.card ↥(StatedSU 3 2 K) = 2 ^ 3 * 3 ^ 3 := by
          rw [← Nat.card_eq_fintype_card, h216']
          norm_num
        have hsolv : Group.IsSolvable ↥(StatedSU 3 2 K) :=
          CFSG.Burnside.finite_group_isSolvable_of_card_eq_prime_pow_mul_prime_pow
            Nat.prime_two Nat.prime_three (by norm_num) hcard
        exact isChevTwoLayeredBy_of_isSolvable hsolv _
      · have hm3 : 3 ≤ m := by omega
        have hmq : (m, 2 ^ f) ≠ (3, 2) := by
          intro h
          rw [Prod.mk.injEq] at h
          exact h32 h
        have hFD : CFSG.HardMathSupport.Solomon.Coordinator.LieComp.LieFactorData 2
            ↥(StatedSU m (2 ^ f) K) := by
          simpa [hring] using
            CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds
              K m (2 ^ f) hK hm3 hmq
        have hF' : Nat.card K = (2 ^ f) ^ 2 := hKq
        have hQZ :=
          CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card
            (p := 2) (f := f) (F := K) (n := m) hF' hm3 hmq
        have hQ : CFSG.Open.IsQuasisimple ↥(StatedSU m (2 ^ f) K) :=
          CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp hQZ.1
        have hcard : Nat.card (↥(StatedSU m (2 ^ f) K) ⧸
            Subgroup.center (StatedSU m (2 ^ f) K)) =
            ordTwistedA (m - 1) (2 ^ f) := by
          rw [Nat.card_congr (QuotientGroup.quotientMulEquivOfEq hQZ.2).toEquiv,
            card_statedProj_statedSU Nat.prime_two hf hF' (by omega : 2 ≤ m), ordTwistedA,
            Nat.sub_add_cancel (by omega : 1 ≤ m), mul_comm (m - 1) m]
        have hcomp := isChevTwoLayeredBy_of_isQuasisimple hQ hFD.chev
        simpa [hcard] using hcomp

end CFSG.StandardType
