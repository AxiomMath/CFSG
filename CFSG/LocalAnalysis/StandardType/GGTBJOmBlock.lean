variable {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type} [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] {Q : QuadraticForm K V} {p r : ℕ} {A : Subgroup (V ≃ₗ[K] V)}

theorem TBJOmData.blockData [Fact p.Prime] (hp2 : p ≠ 2) (Δ : TBJOmData Q p A r)
    (hQ : (polarBilin Q).Nondegenerate)
    (hT : ∃ T : Submodule K V, finrank K T = 3 ∧ ∀ v ∈ T, Q v = 0) (hA : A ≤ orthDerived Q)
    (hW : ∃ v : V, v ≠ 0 ∧ ∀ a ∈ A, a v = v) (f₀ : Fin r → Multiplicative (ZMod p))
    {J : Subgroup ↥(orthDerived Q)}
    (hJ : CFSG.Open.IsComponentOf J
      (Subgroup.centralizer ({Δ.τΩ hA f₀} : Set ↥(orthDerived Q)))) :
    ∃ (a : ZMod p) (P : Fin r → Prop),
      (∀ i, P i → toAdd (f₀ i) = a ∨ toAdd (f₀ i) = -a) ∧
      (∀ i k : Fin r, i ≠ k → P i → P k → toAdd (f₀ i) = toAdd (f₀ k) →
        ∃ n ∈ J, ∀ f, n * Δ.τΩ hA f * n⁻¹ = Δ.τΩ hA (permAut (Equiv.swap i k) f)) ∧
      (a ≠ 0 → ∀ i k : Fin r, P i → P k → toAdd (f₀ i) = a → toAdd (f₀ k) = -a →
        ∃ n ∈ J, ∀ f, n * Δ.τΩ hA f * n⁻¹ = Δ.τΩ hA (permAut (Equiv.swap i k) (dinv i k f))) ∧
      (a = 0 → 2 ≤ Nat.card {i : Fin r // P i} → ∀ i : Fin r, P i →
        ∃ n ∈ J, ∀ f, n * Δ.τΩ hA f * n⁻¹ = Δ.τΩ hA (sgnAut i f)) ∧
      (∀ f : Fin r → Multiplicative (ZMod p),
        (∃ m : ZMod p, ∀ i, P i → toAdd (f i) = m * toAdd (f₀ i)) →
          ∀ j ∈ J, Δ.τΩ hA f * j = j * Δ.τΩ hA f) := by
  classical
  let ye : V ≃ₗ[K] V := Δ.τ f₀
  let y : ↥(orthDerived Q) := Δ.τΩ hA f₀
  have hy : OddOrderIsometry Q p ye := Δ.oddOrderIsometry hp2 hQ hA f₀
  haveI : Nontrivial V := Module.nontrivial_of_finrank_pos (R := K) (by
    obtain ⟨T, hT3, -⟩ := hT
    have hle := Submodule.finrank_le T
    omega)
  let ρ : ↥(orthDerived Q) →* ProjOrthDerived Q :=
    QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q))
  have hbot : (scalars K V).subgroupOf (orthDerived Q) = ⊥ := by
    refine (Subgroup.eq_bot_iff_forall _).2 fun g hg => ?_
    have hgs : (g : V ≃ₗ[K] V) ∈ scalars K V := Subgroup.mem_subgroupOf.mp hg
    have hgΩ : (g : V ≃ₗ[K] V) ∈ orthDerived Q := g.2
    exact Subtype.ext
      (CFSG.RankThree.PartOne.eq_one_of_mem_scalars_of_mem_orthDerived hQ hgΩ hgs)
  have hinj : Function.Injective ρ := by
    intro a b hab
    have h1 : ρ (a * b⁻¹) = 1 := by rw [map_mul, map_inv, hab, mul_inv_cancel]
    change QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)) (a * b⁻¹) = 1 at h1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hbot, Subgroup.mem_bot] at h1
    exact mul_inv_eq_one.mp h1
  have hcent_eq : Subgroup.centralizer ({y} : Set ↥(orthDerived Q)) =
      (isometryCentralizer Q ye).subgroupOf (orthDerived Q) := by
    ext g
    rw [Subgroup.mem_subgroupOf, mem_isometryCentralizer, Subgroup.mem_centralizer_singleton_iff]
    constructor
    · intro hg
      refine ⟨fun v => TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp
        (orthDerived_le_orthogonalGroup g.2) v, fun v => ?_⟩
      have h2 : (g : V ≃ₗ[K] V) * ye = ye * (g : V ≃ₗ[K] V) :=
        congrArg (fun e : ↥(orthDerived Q) => (e : V ≃ₗ[K] V)) hg
      exact congrArg (fun e : V ≃ₗ[K] V => e v) h2
    · intro hg
      have h2 : (g : V ≃ₗ[K] V) * ye = ye * (g : V ≃ₗ[K] V) := by
        ext v
        exact hg.2 v
      apply Subtype.ext
      show (g : V ≃ₗ[K] V) * (y : V ≃ₗ[K] V) = (y : V ≃ₗ[K] V) * (g : V ≃ₗ[K] V)
      exact h2
  have hJasm : CFSG.Assembly.IsComponentOf J
      (Subgroup.centralizer ({y} : Set ↥(orthDerived Q))) :=
    CFSG.Assembly.isComponentOf_iff_open.mpr hJ
  have hmap := CFSG.LocalAnalysis.ComponentInitial.isComponentOf_map_of_injective hJasm ρ hinj
  have hJ'asm : CFSG.Assembly.IsComponentOf (J.map ρ) (centralizerImage Q ye) := by
    rw [centralizerImage, ← hcent_eq]
    exact hmap
  have hJ' : CFSG.Open.IsComponentOf (J.map ρ) (centralizerImage Q ye) :=
    CFSG.Assembly.isComponentOf_iff_open.mp hJ'asm
  have hpℓ : p ≠ ringChar K := by rw [ringChar.eq K 2]; exact hp2
  rcases CFSG.LocalAnalysis.GLTheoremA.KD264Lie.exists_component_dichotomy
      (x := y) (Fact.out : p.Prime) hp2 hQ hT hpℓ hy (J.map ρ) hJ' with
    ⟨h, hh, hX, hq, hJeq⟩ | ⟨hlist, F, hFq, hFle, hFn, hJeq⟩
  ·
    obtain ⟨a, P, ha0, -, hP, hGswap, hGmixed, hGcent⟩ := Δ.blockG hp2 hQ hA f₀ hh hX
    have hJmem : ∀ n : ↥(orthDerived Q), n ∈ J ↔
        (n : V ≃ₗ[K] V) ∈ specialBlock Q ye h := by
      intro n
      constructor
      · intro hn
        have hmem : ρ n ∈ ((specialBlock Q ye h).subgroupOf (orthDerived Q)).map ρ := by
          have h1 : ρ n ∈ J.map ρ := Subgroup.mem_map_of_mem ρ hn
          rwa [hJeq, componentImage] at h1
        obtain ⟨m, hm, hmn⟩ := Subgroup.mem_map.mp hmem
        have hmn' : m = n := hinj hmn
        rw [hmn'] at hm
        exact Subgroup.mem_subgroupOf.mp hm
      · intro hn
        have hmem : ρ n ∈ J.map ρ := by
          rw [hJeq, componentImage]
          exact Subgroup.mem_map_of_mem ρ (Subgroup.mem_subgroupOf.mpr hn)
        obtain ⟨j, hj, hjn⟩ := Subgroup.mem_map.mp hmem
        have hjn' : j = n := hinj hjn
        rwa [hjn'] at hj
    refine ⟨a, P, hP, ?_, ?_, ?_, ?_⟩
    · intro i k hik hi hk hik'
      obtain ⟨w, hw, hwconj⟩ := hGswap i k hik hi hk hik'
      refine ⟨⟨w, (Subgroup.mem_inf.mp hw).2⟩, (hJmem _).mpr (Subgroup.mem_inf.mp hw).1, ?_⟩
      intro f
      refine Subtype.ext ?_
      change w * Δ.τ f * w⁻¹ = Δ.τ (permAut (Equiv.swap i k) f)
      exact hwconj f
    · intro ha i k hi hk hia hka
      obtain ⟨w, hw, hwconj⟩ := hGmixed i k hi hk hia hka
      refine ⟨⟨w, (Subgroup.mem_inf.mp hw).2⟩, (hJmem _).mpr (Subgroup.mem_inf.mp hw).1, ?_⟩
      intro f
      refine Subtype.ext ?_
      change w * Δ.τ f * w⁻¹ = Δ.τ (permAut (Equiv.swap i k) (dinv i k f))
      exact hwconj f
    · intro ha
      exact absurd ha ha0
    · intro f hf j hj
      have hjSB : (j : V ≃ₗ[K] V) ∈ specialBlock Q ye h := (hJmem j).mp hj
      refine Subtype.ext ?_
      change Δ.τ f * (j : V ≃ₗ[K] V) = (j : V ≃ₗ[K] V) * Δ.τ f
      exact hGcent f hf (j : V ≃ₗ[K] V) hjSB
  ·
    let P : Fin r → Prop := fun i => toAdd (f₀ i) = 0
    have hZ := Δ.blockZ hp2 hQ hA hW f₀
    have hPne : supportedFixedDerived Q ye ≠ ⊥ := by
      intro hb
      have hFne : F ≠ ⊥ :=
        (Subgroup.nontrivial_iff_ne_bot F).mp (CFSG.LocalCores.isQuasisimple_nontrivial hFq)
      exact hFne (le_bot_iff.mp (hFle.trans (le_of_eq hb)))
    have hF_eq_of_two : 2 ≤ Nat.card {i : Fin r // P i} →
        F = supportedFixedDerived Q ye := by
      intro h2
      have h4 : 4 < finrank K (fixedSpace ye) := hZ.2.2.2 h2
      obtain ⟨n, F', hF'q, hF'sup, -, hF'fix⟩ :=
        CFSG.HardMathSupport.Dickson.Bal207.OrthFix.exists_fixedFactors' (Q := Q) hy
      have hn : n ≠ 0 := by
        intro hn0
        apply hPne
        rw [← hF'sup hlist]
        haveI : IsEmpty (Fin n) := ⟨fun i => by
          have := i.isLt
          omega⟩
        exact iSup_of_empty _
      have hnpos : 0 < n := Nat.pos_of_ne_zero hn
      let i0 : Fin n := ⟨0, hnpos⟩
      have hF'i0 : F' i0 = supportedFixedDerived Q ye :=
        (hF'fix i0).resolve_left (by omega)
      have hqP : CFSG.IsQuasisimple ↥(supportedFixedDerived Q ye) := hF'i0 ▸ (hF'q i0).1
      let A : Subgroup ↥(supportedFixedDerived Q ye) :=
        F.subgroupOf (supportedFixedDerived Q ye)
      haveI : A.Normal := hFn
      have hqPopen : CFSG.Open.IsQuasisimple ↥(supportedFixedDerived Q ye) :=
        (CFSG.Foundations.SteinbergCA.quasisimple_iff
          ↥(supportedFixedDerived Q ye)).2.2.1.mp hqP
      rcases CFSG.ComponentClassification.Quasisimple.normal_le_center_or_eq_top hqPopen A
        with hc | ht
      · exfalso
        haveI : Group.IsPerfect ↥F := hFq.1
        haveI : Group.IsPerfect ↥A :=
          Group.IsPerfect.ofSurjective
            (f := (Subgroup.subgroupOfEquivOfLe hFle).symm.toMonoidHom)
            (Subgroup.subgroupOfEquivOfLe hFle).symm.surjective
        have hAbot : A = ⊥ :=
          CFSG.ComponentClassification.Quasisimple.perfect_le_center_eq_bot A hc
        have hFbot : F = ⊥ := by
          rw [eq_bot_iff]
          intro g hg
          have h1 : (⟨g, hFle hg⟩ : ↥(supportedFixedDerived Q ye)) ∈ A := hg
          rw [hAbot, Subgroup.mem_bot] at h1
          rw [Subgroup.mem_bot]
          exact congrArg Subtype.val h1
        have hFne : F ≠ ⊥ :=
          (Subgroup.nontrivial_iff_ne_bot F).mp (CFSG.LocalCores.isQuasisimple_nontrivial hFq)
        exact hFne hFbot
      · refine le_antisymm hFle ?_
        intro p hp
        have h1 : (⟨p, hp⟩ : ↥(supportedFixedDerived Q ye)) ∈ A := by
          rw [ht]; exact Subgroup.mem_top _
        exact Subgroup.mem_subgroupOf.mp h1
    have hJmem : ∀ n : ↥(orthDerived Q), n ∈ J ↔ (n : V ≃ₗ[K] V) ∈ F := by
      intro n
      constructor
      · intro hn
        have hmem : ρ n ∈ (F.subgroupOf (orthDerived Q)).map ρ := by
          have h1 : ρ n ∈ J.map ρ := Subgroup.mem_map_of_mem ρ hn
          rwa [hJeq] at h1
        obtain ⟨m, hm, hmn⟩ := Subgroup.mem_map.mp hmem
        have hmn' : m = n := hinj hmn
        rw [hmn'] at hm
        exact Subgroup.mem_subgroupOf.mp hm
      · intro hn
        have hmem : ρ n ∈ J.map ρ := by
          rw [hJeq]
          exact Subgroup.mem_map_of_mem ρ (Subgroup.mem_subgroupOf.mpr hn)
        obtain ⟨j, hj, hjn⟩ := Subgroup.mem_map.mp hmem
        have hjn' : j = n := hinj hjn
        rwa [hjn'] at hj
    refine ⟨0, P, ?_, ?_, ?_, ?_, ?_⟩
    · intro i hi
      exact Or.inl hi
    · intro i k hik hi hk hik'
      have h2 : 2 ≤ Nat.card {i : Fin r // P i} := by
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
        exact Finset.one_lt_card.mpr
          ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩,
           k, Finset.mem_filter.mpr ⟨Finset.mem_univ k, hk⟩, hik⟩
      have hFeq := hF_eq_of_two h2
      obtain ⟨w, hwSD, hwconj⟩ := hZ.1 i k hik hi hk
      have hwF : w ∈ F := by rw [hFeq]; exact hwSD
      refine ⟨⟨w, hy.supportedFixedDerived_le_orthDerived hwSD⟩, (hJmem _).mpr hwF, ?_⟩
      intro f
      refine Subtype.ext ?_
      change w * Δ.τ f * w⁻¹ = Δ.τ (permAut (Equiv.swap i k) f)
      exact hwconj f
    · intro ha
      exact absurd rfl ha
    · intro ha h2 i hi
      have hFeq := hF_eq_of_two h2
      obtain ⟨w, hwSD, hwconj⟩ := hZ.2.1 h2 i hi
      have hwF : w ∈ F := by rw [hFeq]; exact hwSD
      refine ⟨⟨w, hy.supportedFixedDerived_le_orthDerived hwSD⟩, (hJmem _).mpr hwF, ?_⟩
      intro f
      refine Subtype.ext ?_
      change w * Δ.τ f * w⁻¹ = Δ.τ (sgnAut i f)
      exact hwconj f
    · intro f hf j hj
      obtain ⟨c, hc⟩ := hf
      have hff : ∀ i, toAdd (f₀ i) = 0 → f i = 1 := by
        intro i hi
        apply toAdd.injective
        rw [hc i hi, hi, mul_zero, toAdd_one]
      have hjSD : (j : V ≃ₗ[K] V) ∈ supportedFixedDerived Q ye := hFle ((hJmem j).mp hj)
      refine Subtype.ext ?_
      change Δ.τ f * (j : V ≃ₗ[K] V) = (j : V ≃ₗ[K] V) * Δ.τ f
      exact hZ.2.2.1 f hff (j : V ≃ₗ[K] V) hjSD

end OrthTorus

