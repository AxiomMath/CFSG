@[expose] def _root_.CFSG.LieType.SeitzGeneration.ExcWideThree.TwLangData.restrict {K : Type}
    [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ} {A B : Subgroup (ModGL TwistTag.E6.tag K)}
    (D : TwLangData K σ q A) (hBA : B ≤ A) : TwLangData K σ q B where
  v := D.v
  Fr := D.Fr
  hFr := D.hFr
  g0 := D.g0
  hg0C := D.hg0C
  hg0 := D.hg0
  c := D.c
  hcI := D.hcI
  hc := fun x hx => D.hc x (hBA hx)

@[expose] noncomputable def twMatPre (K : Type) [Field K] [Finite K] (σ : K ≃+* K)
    (S : Subgroup (MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ.toRingHom))) :
    Subgroup (ModGL TwistTag.E6.tag K) :=
  (S.comap (RecipeExcLang.twConj K σ)).map (RecipeExcLang.twInndiagGroup K σ).subtype

section Cube

variable {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
  (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n) (Fr : AlgebraicClosure K →+* AlgebraicClosure K)
  (hFr : ∀ c, Fr c = c ^ 2 ^ n)

theorem baseChange_eq_of_mem_langCube {g : ModGL Tag.E6 (AlgebraicClosure K)}
    {S : Subgroup (MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ.toRingHom))}
    (hS : S ≤ TwE6DD2.langCube hn hK σ hσ Fr hFr g) {x : ModGL TwistTag.E6.tag K}
    (hx : x ∈ twMatPre K σ S) :
    ∃ b : Fin Tag.E6.rank → (AlgebraicClosure K)ˣ, (∀ i, b i ^ 3 = 1) ∧
      baseChangeGL (algebraMap K (AlgebraicClosure K)) x = g * rootDiagUnit Tag.E6 b * g⁻¹ := by
  obtain ⟨w, hwS, rfl⟩ := hx
  obtain ⟨b, hb, hbR, hbw⟩ := (TwE6DD2.mem_langCube hn hK σ hσ Fr hFr).1 (hS hwS)
  refine ⟨b, hb, ?_⟩
  have h1 : (NoOffTwE6Three.twInndiagEquivRgrp hn hK σ hσ Fr hFr).symm ⟨_, hbR⟩ = w := by
    apply NoOffTwE6Three.twConj_injective hn hK σ hσ
    rw [← hbw]
    rfl
  have h2 : (⟨_, hbR⟩ : ↥(TwistedDiag.Rgrp (AlgebraicClosure K) Fr)) =
      NoOffTwE6Three.twInndiagEquivRgrp hn hK σ hσ Fr hFr w := by
    rw [← h1, MulEquiv.apply_symm_apply]
  have h3 := congrArg Subtype.val h2
  rw [NoOffTwE6Three.twInndiagEquivRgrp_apply] at h3
  exact h3.symm

@[expose] noncomputable def langCubeData (h3 : 3 ∣ 2 ^ n + 1)
    {g : ModGL Tag.E6 (AlgebraicClosure K)} (hg : g ∈ adjointGroup Tag.E6 (AlgebraicClosure K))
    (hgn : g⁻¹ * twistE6 (AlgebraicClosure K) Fr g = TwistedDiag.n0 (AlgebraicClosure K))
    {S : Subgroup (MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ.toRingHom))}
    (hS : S ≤ TwE6DD2.langCube hn hK σ hσ Fr hFr g) :
    TwLangData K σ (2 ^ n) (twMatPre K σ S) where
  v := CFSG.HardMathSupport.Lang.E6Descent.twE6W0
  Fr := Fr
  hFr := hFr
  g0 := g
  hg0C := hg
  hg0 := inv_mul_eq_iff_eq_mul.mp hgn
  c := 1
  hcI := one_mem _
  hc := by
    intro x hx
    obtain ⟨b, hb, hbx⟩ := baseChange_eq_of_mem_langCube hn hK σ hσ Fr hFr hS hx
    rw [one_mul, inv_one, mul_one, hbx]
    refine ⟨rootDiagUnit Tag.E6 b, ⟨rootDiagUnit_mem_torusGroup b, ?_⟩, rfl⟩
    have hq : ∀ i, b i ^ (2 ^ n + 1) = 1 := by
      intro i
      obtain ⟨m, hm⟩ := h3
      rw [hm, pow_mul, hb i, one_pow]
    exact (TwistedDiag.theta_rootDiagUnit_eq_iff Fr hFr b).2 hq

theorem langCubeData_v (h3 : 3 ∣ 2 ^ n + 1)
    {g : ModGL Tag.E6 (AlgebraicClosure K)} (hg : g ∈ adjointGroup Tag.E6 (AlgebraicClosure K))
    (hgn : g⁻¹ * twistE6 (AlgebraicClosure K) Fr g = TwistedDiag.n0 (AlgebraicClosure K))
    {S : Subgroup (MulAut ↥(graphFixedRootGroup TwistTag.E6 K σ.toRingHom))}
    (hS : S ≤ TwE6DD2.langCube hn hK σ hσ Fr hFr g) (γ : Fin TwistTag.E6.tag.rank → ℤ) :
    (langCubeData hn hK σ hσ Fr hFr h3 hg hgn hS).v • permLattice TwistTag.E6.perm γ = -γ := by
  have h := CFSG.HardMathSupport.Lang.E6Descent.twE6W0_smul
    (permLattice CFSG.RankThree.E6.e6Rho γ)
  exact h.trans (congrArg Neg.neg (TwistedDiag.permLattice_permLattice' γ))

end Cube

