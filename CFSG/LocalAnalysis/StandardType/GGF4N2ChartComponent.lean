open CFSG.Assembly (LargeEvenPLayer)

theorem center_SL2_eq_bot_of_charTwo (F : Type) [Field F] [CharP F 2] :
    Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) = ⊥ := by
  rw [eq_bot_iff]
  intro A hA
  obtain ⟨r, hr, hrA⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hA
  have hr2 : r ^ 2 = 1 := by simpa using hr
  have h2 : (2 : F) = 0 := by exact_mod_cast CharP.cast_eq_zero F 2
  have hr1 : r = 1 := by
    have hsq : (r - 1) ^ 2 = 0 := by linear_combination hr2 + (1 - r) * h2
    exact sub_eq_zero.mp (pow_eq_zero_iff (by norm_num) |>.mp hsq)
  rw [Subgroup.mem_bot]
  apply Subtype.ext
  rw [← hrA, hr1, map_one, Matrix.SpecialLinearGroup.coe_one]

theorem card_SL2_sixteen :
    Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4)) = 4080 := by
  let : Fintype (GaloisField 2 4) := Fintype.ofFinite _
  have hcard : Fintype.card (GaloisField 2 4) = 16 := by
    rw [← Nat.card_eq_fintype_card, GaloisField.card 2 4 (by norm_num)]
    norm_num
  rw [Matrix.card_SL_field, hcard]
  decide

variable {G : Type} [Group G] [Finite G] {ψ : SL6 →* G}

theorem isComponentOf_pLayer_of_normal_lift (hψ : ψ.ker ≤ Subgroup.center SL6)
    {X : Subgroup G} (hX : X ≤ ψ.range) {s : SL6} (hs : s ^ 5 = 1) {N : Subgroup SL6}
    (hNX : N ≤ X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6))
    (hNn : ∀ g ∈ X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6), ∀ n ∈ N, g * n * g⁻¹ ∈ N)
    (hinj : ∀ n ∈ N, ψ n = 1 → n = 1) (hq : CFSG.IsQuasisimple N)
    (eN : N ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4)) :
    CFSG.Open.IsComponentOf (N.map ψ)
        (LargeEvenPLayer 5 (X ⊓ Subgroup.centralizer ({ψ s} : Set G))) ∧
      Nonempty (N.map ψ ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4)) := by
  set Y := X ⊓ Subgroup.centralizer ({ψ s} : Set G) with hYdef
  set K := N.map ψ with hKdef
  have hY : (X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6)).map ψ = Y :=
    map_comap_inf_centralizer hψ hX hs
  have hKY : K ≤ Y := by
    rw [← hY]
    exact Subgroup.map_mono hNX
  have hKn : ∀ y ∈ Y, ∀ k ∈ K, y * k * y⁻¹ ∈ K := by
    intro y hy k hk
    rw [← hY] at hy
    obtain ⟨g, hg, rfl⟩ := hy
    obtain ⟨n, hn, rfl⟩ := hk
    exact ⟨g * n * g⁻¹, hNn g hg n hn, by rw [map_mul, map_mul, map_inv]⟩
  have hker : (ψ.comp N.subtype).ker = ⊥ := by
    rw [eq_bot_iff]
    intro t ht
    exact Subtype.ext (hinj t t.2 ht)
  have hrange : (ψ.comp N.subtype).range = K := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  let eK : N ≃* K := (MonoidHom.ofInjective ((MonoidHom.ker_eq_bot_iff _).mp hker)).trans
    (MulEquiv.subgroupCongr hrange)
  let e : K ≃* Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4) := eK.symm.trans eN
  have hqSL : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4)) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv eN hq
  have hqK : CFSG.IsQuasisimple K := CFSG.LocalCores.isQuasisimple_of_mulEquiv eK hq
  have hcardK : Nat.card K = 4080 := by rw [Nat.card_congr e.toEquiv, card_SL2_sixteen]
  have : Nontrivial K := by
    apply Finite.one_lt_card_iff_nontrivial.mp
    rw [hcardK]
    norm_num
  have : IsSimpleGroup (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4)) := by
    have hZ := center_SL2_eq_bot_of_charTwo (GaloisField 2 4)
    have := hqSL.2.1
    have hsurj : Function.Surjective
        ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).toMonoidHom :=
      MulEquiv.surjective _
    have : Nontrivial (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 4)) := e.symm.toEquiv.nontrivial
    exact IsSimpleGroup.isSimpleGroup_of_surjective _ hsurj
  have : IsSimpleGroup K :=
    IsSimpleGroup.isSimpleGroup_of_surjective e.symm.toMonoidHom e.symm.surjective
  have hnc : ∃ a b : K, a * b ≠ b * a := by
    by_contra hall
    push Not at hall
    have hcomm : commutator K = ⊥ := by
      rw [commutator, Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro a _ b _
      exact (hall b a)
    have htop : commutator K = ⊤ := hqK.1.commutator_eq_top
    rw [hcomm] at htop
    obtain ⟨a, ha⟩ := exists_ne (1 : K)
    exact ha (by simpa using (Subgroup.eq_top_iff' (⊥ : Subgroup K)).mp htop a)
  have hKnormal : (K.subgroupOf Y).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hKY]
    intro k y hk hy
    exact hKn y hy k hk
  have hKL : K ≤ LargeEvenPLayer 5 Y := by
    rw [CFSG.Assembly.LargeEven.largeEvenPLayer_eq_glaPLayer]
    exact CFSG.HardMathSupport.Solomon.Coordinator.le_glaPLayer_of_normal_simple Nat.prime_five
      hKY hKnormal hnc (by rw [hcardK]; norm_num)
  have hLY : LargeEvenPLayer 5 Y ≤ Y := by
    rw [CFSG.Assembly.LargeEven.largeEvenPLayer_eq_glaPLayer]
    exact sSup_le fun L hL => hL.1
  refine ⟨⟨hKL, CFSG.Open.IsSubnormal.step hKL ?_ (CFSG.Open.IsSubnormal.refl _),
    ⟨hqK.1.commutator_eq_top, hqK.2.1⟩⟩, ⟨e⟩⟩
  rw [Subgroup.normal_subgroupOf_iff hKL]
  intro k y hk hy
  exact hKn y (hLY hy) k hk

