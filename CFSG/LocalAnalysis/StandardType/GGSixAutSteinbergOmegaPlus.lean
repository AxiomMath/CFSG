section PlusModel

variable {K : Type} [Field K] {n : ℕ}

theorem range_spinMatrix_plus (hn : 3 ≤ n) :
    (spinMatrix (quadPlus n K)).range = StatedOmega ⇑(quadPlus n K) := by
  rw [coe_quadPlus]
  exact range_spinMatrix_quadPlus hn

@[expose] noncomputable def spinModelPlus (hn : 3 ≤ n) :
    spinGroup (quadPlus n K) →* matrixDerived (coordinateQuadPlus n K) :=
  spinModel (plusIndexEquiv n) (quadPlus n K) (range_spinMatrix_plus hn)

theorem spinModelPlus_mulVec (hn : 3 ≤ n) (x : spinGroup (quadPlus n K))
    (v : Fin n ⊕ Fin n → K) :
    Matrix.mulVec ((spinModelPlus hn x : GL (Fin (2 * n)) K) :
        Matrix (Fin (2 * n)) (Fin (2 * n)) K) (reindexVectorEquiv (plusIndexEquiv n) v) =
      reindexVectorEquiv (plusIndexEquiv n) (spinAction (quadPlus n K) x v) :=
  spinModel_mulVec _ _ _ x v

theorem spinModelPlus_surjective (hn : 3 ≤ n) : Function.Surjective (spinModelPlus (K := K) hn) :=
  spinModel_surjective _ _ _

variable [CharP K 2]

theorem spinModelPlus_injective (hn : 3 ≤ n) : Function.Injective (spinModelPlus (K := K) hn) :=
  spinModel_injective _ _ _ RootCentOmega.spinAction_quadPlus_injective

theorem ker_spinModelPlus (hn : 3 ≤ n) :
    (spinModelPlus (K := K) hn).ker = Subgroup.center (spinGroup (quadPlus n K)) := by
  rw [(MonoidHom.ker_eq_bot_iff _).2 (spinModelPlus_injective hn),
    RootCentOmega.center_spinGroup_quadPlus_eq_bot_charTwo hn]

end PlusModel

section Kernel

variable {K : Type} [Field K] {d : ℕ} {Q : QuadraticForm K (Fin d → K)}

theorem right_eq_one_of_conjAct_mem_inner (hnd : Q.polarBilin.Nondegenerate)
    (hT : ∃ T : Submodule K (Fin d → K), Module.finrank K T = 3 ∧ ∀ v ∈ T, Q v = 0)
    (hAP : CFSG.ComponentClassification.CatalogueBOrthogonalPointAction.ActionProperties Q
      (projectivePointAction Q)) {g : similarityPairs Q}
    (hg : conjAct Q g ∈ inner (matrixDerived Q)) : g.val.right = 1 := by
  obtain ⟨γ, hγ⟩ := hg
  have hγO : γ.val ∈ matrixIsometries Q := matrixDerived_le_isometries _ γ.2
  have e : conjAct Q (matrixIsometryInclusion Q ⟨γ.val, hγO⟩) = MulAut.conj γ :=
    conjAct_inclusion_of_mem ⟨γ.val, hγO⟩ γ.2
  have h1 : conjAct Q (g * (matrixIsometryInclusion Q ⟨γ.val, hγO⟩)⁻¹) = 1 := by
    rw [map_mul, map_inv, e, hγ]
    exact mul_inv_cancel _
  have h2 : matrixProjectiveConjugationHom Q
      (g * (matrixIsometryInclusion Q ⟨γ.val, hγO⟩)⁻¹) = 1 := by
    refine MulEquiv.ext fun x => ?_
    obtain ⟨A, rfl⟩ := matrixProjectiveProjection_surjective _ x
    change matrixProjectiveConjugation _ _ (matrixProjectiveProjection _ A) =
      matrixProjectiveProjection _ A
    rw [matrixProjectiveConjugation_mk]
    congr 1
    exact congrArg (fun α : MulAut (matrixDerived Q) => α A) h1
  have h3 := ((CFSG.RankThree.Classical.SteinbergBY.matrixProjectiveConjugationHom_eq_one_iff Q
    hnd hT hAP _).1 h2).1
  rw [← fieldProjection_apply, map_mul, map_inv, fieldProjection_apply, fieldProjection_apply,
    matrixIsometryInclusion_val, SemidirectProduct.right_inl, inv_one, mul_one] at h3
  exact h3

theorem mem_matrixDerived_of_conjAct_mem_inner [CharP K 2] (hnd : Q.polarBilin.Nondegenerate)
    (hT : ∃ T : Submodule K (Fin d → K), Module.finrank K T = 3 ∧ ∀ v ∈ T, Q v = 0)
    (hAP : CFSG.ComponentClassification.CatalogueBOrthogonalPointAction.ActionProperties Q
      (projectivePointAction Q)) (hQ : ∃ v, Q v ≠ 0) (B : matrixIsometries Q)
    (hB : conjAct Q (matrixIsometryInclusion Q B) ∈ inner (matrixDerived Q)) :
    B.val ∈ matrixDerived Q := by
  obtain ⟨γ, hγ⟩ := hB
  have hγO : γ.val ∈ matrixIsometries Q := matrixDerived_le_isometries _ γ.2
  have e : conjAct Q (matrixIsometryInclusion Q ⟨γ.val, hγO⟩) = MulAut.conj γ :=
    conjAct_inclusion_of_mem ⟨γ.val, hγO⟩ γ.2
  have h1 : conjAct Q (matrixIsometryInclusion Q B *
      (matrixIsometryInclusion Q ⟨γ.val, hγO⟩)⁻¹) = 1 := by
    rw [map_mul, map_inv, e, hγ]
    exact mul_inv_cancel _
  obtain ⟨a, ha⟩ := scalar_of_conjAct_eq_one hnd hT hAP h1
  have hleft : (matrixIsometryInclusion Q B *
      (matrixIsometryInclusion Q ⟨γ.val, hγO⟩)⁻¹).val.left = B.val * (γ.val)⁻¹ := by
    rw [← map_inv, ← map_mul, matrixIsometryInclusion_val, SemidirectProduct.left_inl]
    rfl
  rw [hleft] at ha
  have hmem : Matrix.GeneralLinearGroup.scalar (Fin d) a ∈ matrixIsometries Q := by
    rw [← ha]
    exact mul_mem B.2 (inv_mem hγO)
  have ha1 := scalar_eq_one_of_mem_isometries hQ hmem
  rw [ha1, map_one] at ha
  have hBγ : B.val = γ.val := by
    have := congrArg (· * γ.val) ha
    simpa using this
  rw [hBγ]
  exact γ.2

end Kernel

section Compl

open CFSG.SeitzReduction
open CFSG.RankThree.PartOne.KCOrthogonalSubfield (fieldPair fieldPair_val)

variable {K : Type} [Field K] [Finite K] [CharP K 2] (n : ℕ)

@[expose] noncomputable def fieldAutP :
    (K ≃+* K) →* MulAut (matrixDerived (coordinateQuadPlus n K)) where
  toFun σ := conjAct _
    (fieldPair (coordinateQuadPlus n K) σ (E7Pilot.coordinateQuadPlus_fieldMap n σ))
  map_one' := by
    change conjAct _ (fieldPair _ _ _) = 1
    rw [OmegaPilot.fieldPair_one, map_one]
  map_mul' σ τ := by
    rw [OmegaPilot.fieldPair_mul, map_mul]

omit [Finite K] [CharP K 2] in
theorem fieldAutP_apply (σ : K ≃+* K) :
    fieldAutP n σ = conjAct _
      (fieldPair (coordinateQuadPlus n K) σ (E7Pilot.coordinateQuadPlus_fieldMap n σ)) := rfl

variable {n}

theorem plusUnitVector_form (hn : 1 ≤ n) :
    coordinateQuadPlus n K (OmegaPilot.plusUnitVector hn) = 1 :=
  OmegaPilot.map_plusUnitVector hn

theorem plusUnitVector_form_ne_zero (hn : 1 ≤ n) :
    coordinateQuadPlus n K (OmegaPilot.plusUnitVector hn) ≠ 0 := by
  rw [plusUnitVector_form]
  exact one_ne_zero

noncomputable abbrev plusRefl (hn : 1 ≤ n) : MulAut (matrixDerived (coordinateQuadPlus n K)) :=
  reflAut (coordinateQuadPlus n K) (OmegaPilot.plusUnitVector hn) (plusUnitVector_form_ne_zero hn)

theorem plusRefl_mul_self (hn : 1 ≤ n) : plusRefl (K := K) hn * plusRefl hn = 1 :=
  reflAut_mul_self _ _

theorem reflMat_eq_symmetryGL (hn : 1 ≤ n) :
    reflMat (coordinateQuadPlus n K) (OmegaPilot.plusUnitVector hn)
        (plusUnitVector_form_ne_zero hn) =
      CFSG.ComponentClassification.UnbalancedCatalog.symmetryGL (coordinateQuadPlus n K)
        (OmegaPilot.plusUnitVector hn) := by
  apply Units.ext
  refine Matrix.toLin'.injective (LinearMap.ext fun x => ?_)
  rw [Matrix.toLin'_apply, Matrix.toLin'_apply, reflMat_mulVec_one _ (plusUnitVector_form hn),
    CFSG.ComponentClassification.UnbalancedCatalog.symmetryGL_mulVec_of_charTwo
      (plusUnitVector_form hn)]

theorem plusRefl_mul_fieldAutP (hn : 1 ≤ n) (σ : K ≃+* K) :
    plusRefl hn * fieldAutP n σ = fieldAutP n σ * plusRefl hn := by
  rw [plusRefl, reflAut, fieldAutP_apply, ← map_mul, ← map_mul]
  congr 1
  have h := OmegaPilot.matrixIsometryInclusion_symmetry_mul_fieldPair (F := K) hn σ
  have e : (⟨reflMat (coordinateQuadPlus n K) (OmegaPilot.plusUnitVector hn)
      (plusUnitVector_form_ne_zero hn), reflMat_mem_isometries _ _⟩ :
        matrixIsometries (coordinateQuadPlus n K)) =
      CFSG.ComponentClassification.UnbalancedCatalog.symmetryIsometry (coordinateQuadPlus n K)
        (OmegaPilot.plusUnitVector hn) :=
    Subtype.ext (reflMat_eq_symmetryGL hn)
  rw [e]
  exact h

@[expose] noncomputable def plusCompl (hn : 1 ≤ n) :
    Subgroup (MulAut (matrixDerived (coordinateQuadPlus n K))) where
  carrier := {c | ∃ σ : K ≃+* K, c = fieldAutP n σ ∨ c = plusRefl hn * fieldAutP n σ}
  mul_mem' := by
    rintro a b ⟨σ, rfl | rfl⟩ ⟨τ, rfl | rfl⟩
    · exact ⟨σ * τ, Or.inl (map_mul _ σ τ).symm⟩
    · refine ⟨σ * τ, Or.inr ?_⟩
      rw [map_mul, ← mul_assoc, ← plusRefl_mul_fieldAutP, mul_assoc]
    · exact ⟨σ * τ, Or.inr (by rw [map_mul, mul_assoc])⟩
    · refine ⟨σ * τ, Or.inl ?_⟩
      rw [map_mul, mul_assoc, ← mul_assoc (fieldAutP n σ), ← plusRefl_mul_fieldAutP, ← mul_assoc,
        ← mul_assoc, plusRefl_mul_self, one_mul]
  one_mem' := ⟨1, Or.inl (map_one _).symm⟩
  inv_mem' := by
    rintro a ⟨σ, rfl | rfl⟩
    · exact ⟨σ⁻¹, Or.inl (map_inv _ σ).symm⟩
    · refine ⟨σ⁻¹, Or.inr ?_⟩
      have hρ : (plusRefl (K := K) hn)⁻¹ = plusRefl hn :=
        inv_eq_of_mul_eq_one_left (plusRefl_mul_self hn)
      rw [_root_.mul_inv_rev, hρ, ← map_inv, plusRefl_mul_fieldAutP]

theorem mem_plusCompl {hn : 1 ≤ n} {c : MulAut (matrixDerived (coordinateQuadPlus n K))} :
    c ∈ plusCompl hn ↔ ∃ σ : K ≃+* K, c = fieldAutP n σ ∨ c = plusRefl hn * fieldAutP n σ :=
  Iff.rfl

end Compl

section Structure

open CFSG.SeitzReduction
open CFSG.RankThree.PartOne.KCOrthogonalSubfield (fieldPair fieldPair_val)

variable {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}

theorem exists_inner_mul_plusCompl (hn5 : 5 ≤ n)
    (α : MulAut (matrixDerived (coordinateQuadPlus n K))) :
    ∃ ι ∈ inner (matrixDerived (coordinateQuadPlus n K)), ∃ c ∈ plusCompl (by omega : 1 ≤ n),
      α = ι * c := by
  have hn : 1 ≤ n := by omega
  obtain ⟨hnd, hT⟩ := regular_coordinateQuadPlus n K (by omega)
  have hv0 := plusUnitVector_form_ne_zero (K := K) hn
  have htop := CFSG.RankThree.PartOne.KCOrthogonalAut.matrixProjectiveImage_eq_top_plus K n hn5
  obtain ⟨g, hgα⟩ := exists_pair_of_aut ⟨_, hv0⟩ htop α
  subst hgα
  set σ := g.val.right with hσ
  have hℓ : (g * (fieldPair (coordinateQuadPlus n K) σ
      (E7Pilot.coordinateQuadPlus_fieldMap n σ))⁻¹).val.right = 1 := by
    rw [← fieldProjection_apply, map_mul, map_inv, fieldProjection_apply, fieldProjection_apply,
      fieldPair_val, SemidirectProduct.right_inr, ← hσ, mul_inv_cancel]
  obtain ⟨B, hB⟩ := CFSG.RankThree.PartOne.OutStructure.exists_isometry_of_linear _ ⟨_, hv0⟩
    ⟨_, (mem_linearSimilarityPairs_iff _ _).2 hℓ⟩
  have hℓB := conjAct_eq_of_isometry hB
  have hα : conjAct (coordinateQuadPlus n K) g =
      conjAct (coordinateQuadPlus n K) (matrixIsometryInclusion _ B) * fieldAutP n σ := by
    rw [← hℓB, fieldAutP_apply, ← map_mul, inv_mul_cancel_right]
  rcases mem_or_mul_reflMat_mem hnd hT B.2 (OmegaPilot.plusUnitVector hn) hv0 with hBΓ | hBΓ
  · exact ⟨_, conjAct_inclusion_mem_inner B hBΓ, _, ⟨σ, Or.inl rfl⟩, hα⟩
  · have hR := reflMat_mem_isometries (Q := coordinateQuadPlus n K)
      (OmegaPilot.plusUnitVector hn) hv0
    have hιB : matrixIsometryInclusion (coordinateQuadPlus n K) B =
        matrixIsometryInclusion (coordinateQuadPlus n K)
          ⟨B.val * reflMat _ (OmegaPilot.plusUnitVector hn) hv0, mul_mem B.2 hR⟩ *
          matrixIsometryInclusion (coordinateQuadPlus n K)
            ⟨reflMat _ (OmegaPilot.plusUnitVector hn) hv0, hR⟩ := by
      rw [← map_mul]
      congr 1
      apply Subtype.ext
      change B.val = B.val * reflMat _ (OmegaPilot.plusUnitVector hn) hv0 *
        reflMat _ (OmegaPilot.plusUnitVector hn) hv0
      rw [mul_assoc, reflMat_mul_self, mul_one]
    refine ⟨_, conjAct_inclusion_mem_inner (Q := coordinateQuadPlus n K)
      ⟨B.val * reflMat _ (OmegaPilot.plusUnitVector hn) hv0, mul_mem B.2 hR⟩ hBΓ, _,
      ⟨σ, Or.inr rfl⟩, ?_⟩
    rw [hα, hιB, map_mul, mul_assoc]
    rfl

theorem eq_one_of_mem_inner_plusCompl (hn3 : 3 ≤ n) {σ : K ≃+* K}
    {c : MulAut (matrixDerived (coordinateQuadPlus n K))}
    (hc : c = fieldAutP n σ ∨ c = plusRefl (by omega) * fieldAutP n σ)
    (hcI : c ∈ inner (matrixDerived (coordinateQuadPlus n K))) : σ = 1 := by
  obtain ⟨hnd, hT⟩ := regular_coordinateQuadPlus n K hn3
  have hAP := coordinate_plus_point_action_properties n K hn3
  rcases hc with rfl | rfl
  · have h := right_eq_one_of_conjAct_mem_inner hnd hT hAP hcI
    rwa [fieldPair_val, SemidirectProduct.right_inr] at h
  · rw [plusRefl, reflAut, fieldAutP_apply, ← map_mul] at hcI
    have h := right_eq_one_of_conjAct_mem_inner hnd hT hAP hcI
    rw [← fieldProjection_apply, map_mul, fieldProjection_apply, fieldProjection_apply,
      fieldPair_val, SemidirectProduct.right_inr, matrixIsometryInclusion_val,
      SemidirectProduct.right_inl, one_mul] at h
    exact h

theorem plusRefl_not_mem_inner (hn3 : 3 ≤ n) :
    plusRefl (K := K) (by omega : 1 ≤ n) ∉ inner (matrixDerived (coordinateQuadPlus n K)) := by
  obtain ⟨hnd, hT⟩ := regular_coordinateQuadPlus n K hn3
  have hAP := coordinate_plus_point_action_properties n K hn3
  intro h
  have hn : 1 ≤ n := by omega
  exact reflMat_not_mem_derived hnd hT _ (plusUnitVector_form_ne_zero (K := K) hn)
    (mem_matrixDerived_of_conjAct_mem_inner hnd hT hAP ⟨_, plusUnitVector_form_ne_zero hn⟩ _ h)

theorem inner_inf_plusCompl (hn3 : 3 ≤ n) :
    inner (matrixDerived (coordinateQuadPlus n K)) ⊓ plusCompl (by omega : 1 ≤ n) = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  rintro c ⟨hcI, σ, hc⟩
  have hσ := eq_one_of_mem_inner_plusCompl hn3 hc hcI
  subst hσ
  rcases hc with rfl | rfl
  · exact map_one _
  · rw [map_one, mul_one] at hcI
    exact absurd hcI (plusRefl_not_mem_inner hn3)

theorem eq_one_of_fieldAutP_eq_one (hn3 : 3 ≤ n) {σ : K ≃+* K} (h : fieldAutP n σ = 1) :
    σ = 1 :=
  eq_one_of_mem_inner_plusCompl hn3 (Or.inl rfl) (h ▸ one_mem _)

theorem involution_plusCompl (hn3 : 3 ≤ n) {c : MulAut (matrixDerived (coordinateQuadPlus n K))}
    (hc : c ∈ plusCompl (by omega : 1 ≤ n)) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1) :
    c = plusRefl (by omega) ∨ ∃ σ : K ≃+* K, σ * σ = 1 ∧ σ ≠ 1 ∧
      (c = fieldAutP n σ ∨ c = plusRefl (by omega) * fieldAutP n σ) := by
  obtain ⟨σ, hcσ⟩ := hc
  have hσσ : σ * σ = 1 := by
    apply eq_one_of_fieldAutP_eq_one hn3
    rw [map_mul]
    rcases hcσ with rfl | rfl
    · rwa [sq] at hc2
    · rw [sq, mul_assoc, ← mul_assoc (fieldAutP n σ), ← plusRefl_mul_fieldAutP, ← mul_assoc,
        ← mul_assoc, plusRefl_mul_self, one_mul] at hc2
      exact hc2
  by_cases hσ1 : σ = 1
  · subst hσ1
    rcases hcσ with rfl | rfl
    · exact absurd (map_one _) hc1
    · left
      rw [map_one, mul_one]
  · exact Or.inr ⟨σ, hσσ, hσ1, hcσ⟩

end Structure

