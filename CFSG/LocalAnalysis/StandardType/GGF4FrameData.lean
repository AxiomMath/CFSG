@[expose] def f4OrbT (v : F4Vec) : List (Fin 4) := (f4OrbTData.lookup v).getD []

@[expose] def f4OrbPi (v : F4Vec) (k : Fin 4) : List (Fin 4) := (f4OrbPiData.lookup (v, k)).getD []

@[expose] def f4Frame (va vb : F4Vec) : List (Fin 4) × List (Fin 4) × List (Fin 4) × List (Fin 4) :=
  (f4FrameData.lookup (va, vb)).getD ([], [], [], [])

theorem f4Orb_closed :
    f4E1 ∈ f4ShortOrb ∧ ∀ v ∈ f4ShortOrb, ∀ k : Fin 4, (Sm k).mulv v ∈ f4ShortOrb := by
  decide +kernel

theorem f4OrbT_spec : f4OrbT f4E1 = [] ∧ ∀ v ∈ f4ShortOrb, (evalW (f4OrbT v)).mulv f4E1 = v := by
  decide +kernel

theorem f4OrbPi_spec : ∀ v ∈ f4ShortOrb, ∀ k : Fin 4,
    (Sm k).mul (evalW (f4OrbT v)) = (evalW (f4OrbT ((Sm k).mulv v))).mul (evalW (f4OrbPi v k)) ∧
      ∀ i ∈ f4OrbPi v k, i ≠ 3 := by
  decide +kernel

@[expose] def F4FrameCond (va vb : F4Vec) : Prop :=
  (Sm 2).mulv va = va ∧ (Sm 3).mulv va ≠ va ∧ (Sm 3).mulv vb = vb ∧ (Sm 2).mulv vb ≠ vb

instance (va vb : F4Vec) : Decidable (F4FrameCond va vb) := by
  unfold F4FrameCond
  infer_instance

@[expose] def F4FrameGood (va vb : F4Vec) : Prop :=
  (conjW (f4Frame va vb).1 (Sm 2)).mulv va = va ∧
    (conjW (f4Frame va vb).1 (Sm 1)).mulv va = va ∧
    (conjW (f4Frame va vb).1 (Sm 3)).mulv vb = vb ∧
    (conjW (f4Frame va vb).1 (Sm 1)).mulv vb = vb ∧
    (evalW (f4Frame va vb).2.1).mulv va = va ∧
    conjW ((f4Frame va vb).2.1 ++ (f4Frame va vb).1).reverse (Sm 2) =
      evalW (f4Frame va vb).2.2.1 ∧
    conjW ((f4Frame va vb).2.1 ++ (f4Frame va vb).1).reverse (Sm 3) =
      evalW (f4Frame va vb).2.2.2 ∧
    (∀ i ∈ (f4Frame va vb).2.2.1, i ≠ 0) ∧ (∀ i ∈ (f4Frame va vb).2.2.2, i ≠ 0) ∧
    ((evalW (f4Frame va vb).1.reverse).mulv va = f4E1 ∨
      (evalW (f4Frame va vb).1.reverse).mulv va = f4E1.neg ∨
      (evalW (f4Frame va vb).1.reverse).mulv va = f4E2 ∨
      (evalW (f4Frame va vb).1.reverse).mulv va = f4E2.neg)

instance (va vb : F4Vec) : Decidable (F4FrameGood va vb) := by
  unfold F4FrameGood
  infer_instance

theorem f4Frame_spec : ∀ va ∈ f4ShortOrb, ∀ vb ∈ f4ShortOrb, F4FrameCond va vb →
    F4FrameGood va vb := by
  decide +kernel

theorem f4PCWords_spec : f4PCWords.length = 48 ∧ (f4PCWords.map evalW).Nodup ∧
    ∀ l ∈ f4PCWords, ∀ i ∈ l, i ≠ 0 := by
  decide +kernel

