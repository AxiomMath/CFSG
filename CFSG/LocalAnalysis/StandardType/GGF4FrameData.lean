@[expose] def M4.mulv (x : M4) (v : F4Vec) : F4Vec :=
  ⟨x.m00 * v.v0 + x.m01 * v.v1 + x.m02 * v.v2 + x.m03 * v.v3,
   x.m10 * v.v0 + x.m11 * v.v1 + x.m12 * v.v2 + x.m13 * v.v3,
   x.m20 * v.v0 + x.m21 * v.v1 + x.m22 * v.v2 + x.m23 * v.v3,
   x.m30 * v.v0 + x.m31 * v.v1 + x.m32 * v.v2 + x.m33 * v.v3⟩

@[expose] def F4Vec.neg (v : F4Vec) : F4Vec := ⟨-v.v0, -v.v1, -v.v2, -v.v3⟩

