private theorem twE6Adj_one_notMem_orbitUnion_J0 :
    (1 : Fin TwistTag.E6.tag.rank) ∉ TwistTag.E6.orbitUnion J0 := by
  rw [TwistTag.mem_orbitUnion]
  rintro ⟨a, ha, h1⟩
  fin_cases a
  · exact (by decide : ¬ ((1 : Fin TwistTag.E6.tag.rank) ∈ TwistTag.E6.orbit 0)) h1
  · exact (by decide : ¬ ((1 : Fin TwistTag.E6.tag.rank) ∈ TwistTag.E6.orbit 1)) h1
  · exact (by decide : ¬ ((1 : Fin TwistTag.E6.tag.rank) ∈ TwistTag.E6.orbit 2)) h1
  · exact ha rfl

private theorem mem_orbitUnion_J0_of_ne_one {i : Fin TwistTag.E6.tag.rank} (hi : i ≠ 1) :
    i ∈ TwistTag.E6.orbitUnion J0 := by
  rw [TwistTag.mem_orbitUnion]
  fin_cases i
  · exact ⟨0, by simp [J0, a2], by decide⟩
  · exact absurd rfl hi
  · exact ⟨1, by simp [J0, a2], by decide⟩
  · exact ⟨2, by simp [J0, a2], by decide⟩
  · exact ⟨1, by simp [J0, a2], by decide⟩
  · exact ⟨0, by simp [J0, a2], by decide⟩

private theorem parabolicDegree_orbitUnion_J0 (v : Fin TwistTag.E6.tag.rank → ℤ) :
    parabolicDegree TwistTag.E6.tag (TwistTag.E6.orbitUnion J0) v = v 1 := by
  classical
  change (∑ i : Fin TwistTag.E6.tag.rank,
    if i ∈ TwistTag.E6.orbitUnion J0 then (0 : ℤ) else v i) = v 1
  rw [Finset.sum_eq_single (f := fun i : Fin TwistTag.E6.tag.rank =>
      if i ∈ TwistTag.E6.orbitUnion J0 then (0 : ℤ) else v i)
    (s := Finset.univ) (1 : Fin TwistTag.E6.tag.rank)
    (fun b _ hb => by rw [if_pos (mem_orbitUnion_J0_of_ne_one hb)])
    (fun h => absurd (Finset.mem_univ 1) h)]
  rw [if_neg twE6Adj_one_notMem_orbitUnion_J0]

private theorem e6_root_coord
    {α : Fin TwistTag.E6.tag.rank → ℤ} (hα : IsRoot TwistTag.E6.tag α) :
    α 1 ≤ 2 ∧ (α 1 = 2 → α = e6HighestRoot) := by
  obtain ⟨k, hk, rfl⟩ := (RootCertificate.isRoot_iff (Tag.rootCertificate_check _)).1 hα
  have h : (List.range (Tag.rootCertificate TwistTag.E6.tag).roots.length).all fun k =>
      decide ((Tag.rootCertificate TwistTag.E6.tag).root k 1 ≤ 2 ∧
        ((Tag.rootCertificate TwistTag.E6.tag).root k 1 = 2 →
          (List.ofFn ((Tag.rootCertificate TwistTag.E6.tag).root k) ==
            List.ofFn e6HighestRoot) = true)) := by
    decide +kernel
  simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
  exact ⟨(h k hk).1, fun h2 => RootCertificate.eq_of_ofFn_beq ((h k hk).2 h2)⟩

theorem coreFour_adjoint_twE6_highest
    {k : Type} [Field k] [Finite k] [CharP k 2] (θ : k →+* k) :
    ⁅pCoreOf 2 (Subgroup.normalizer (((rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap
          (graphFixedRootGroup TwistTag.E6 k θ).subtype : Subgroup ↥(graphFixedRootGroup
            TwistTag.E6 k θ)) : Set ↥(graphFixedRootGroup TwistTag.E6 k θ))),
      pCoreOf 2 (Subgroup.normalizer (((rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap
          (graphFixedRootGroup TwistTag.E6 k θ).subtype : Subgroup ↥(graphFixedRootGroup
            TwistTag.E6 k θ)) : Set ↥(graphFixedRootGroup TwistTag.E6 k θ)))⁆ ≤
        (rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap
          (graphFixedRootGroup TwistTag.E6 k θ).subtype ∧
      pCoreOf 2 (Subgroup.normalizer (((rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap
          (graphFixedRootGroup TwistTag.E6 k θ).subtype : Subgroup ↥(graphFixedRootGroup
            TwistTag.E6 k θ)) : Set ↥(graphFixedRootGroup TwistTag.E6 k θ))) ≤
        Subgroup.centralizer (((rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap
          (graphFixedRootGroup TwistTag.E6 k θ).subtype : Subgroup ↥(graphFixedRootGroup
            TwistTag.E6 k θ)) : Set ↥(graphFixedRootGroup TwistTag.E6 k θ)) := by
  classical
  let σ : k ≃+* k := RingEquiv.ofBijective θ
    ⟨RingHom.injective θ, Finite.surjective_of_injective (RingHom.injective θ)⟩
  have hσθ : σ.toRingHom = θ := RingHom.ext fun _ => rfl
  set G : Subgroup (ModGL TwistTag.E6.tag k) := graphFixedRootGroup TwistTag.E6 k θ
  set X : Subgroup G :=
    (rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap G.subtype
  set Q : Subgroup G := pCoreOf 2 (Subgroup.normalizer X)
  let QA : Subgroup (ModGL TwistTag.E6.tag k) := graphFixedParabolicRadical TwistTag.E6 k θ J0
  have hQeq : Q = QA.subgroupOf G := by
    have hrad := radical_std_eq (K := k) σ
    rw [hσθ] at hrad
    simp only [twE6LongRootRadical, twE6LongRootParabolic, pCoreOf] at hrad
    rw [ringChar.eq k 2] at hrad
    exact hrad
  rw [hQeq]
  let A : Set (Fin TwistTag.E6.tag.rank) := TwistTag.E6.orbitUnion J0
  have hroots2 : levelRoots TwistTag.E6.tag A 2 = {e6HighestRoot} := by
    ext α
    simp only [levelRoots, Set.mem_setOf_eq, Set.mem_singleton_iff]
    constructor
    · rintro ⟨hroot, -, hdeg⟩
      rw [parabolicDegree_orbitUnion_J0] at hdeg
      exact (e6_root_coord hroot).2 (le_antisymm (e6_root_coord hroot).1 hdeg)
    · rintro rfl
      exact ⟨isRoot_e6HighestRoot, by rw [height_e6HighestRoot]; norm_num,
        by rw [parabolicDegree_orbitUnion_J0]; decide⟩
  have hroots3 : levelRoots TwistTag.E6.tag A 3 = ∅ := by
    ext α
    simp only [levelRoots, Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
    rintro ⟨hroot, -, hdeg⟩
    rw [parabolicDegree_orbitUnion_J0] at hdeg
    have hle := (e6_root_coord hroot).1
    omega
  have hlev2 : levelRadical TwistTag.E6.tag k A 2 =
      rootSubgroup TwistTag.E6.tag k e6HighestRoot := by
    unfold levelRadical
    rw [hroots2, rootSpan_singleton]
  have hlev3 : levelRadical TwistTag.E6.tag k A 3 = ⊥ := levelRadical_eq_bot hroots3
  have hQA1 : QA ≤ levelRadical TwistTag.E6.tag k A 1 := by
    rw [levelRadical_one]
    exact inf_le_left
  have hcommModGL : ⁅QA, QA⁆ ≤ rootSubgroup TwistTag.E6.tag k e6HighestRoot := by
    refine (Subgroup.commutator_mono hQA1 hQA1).trans ?_
    have h := commutator_levelRadical_le (K := k) A 1 1
    rw [show (1 : ℤ) + 1 = 2 by norm_num] at h
    exact h.trans (le_of_eq hlev2)
  have hcentModGL : QA ≤ Subgroup.centralizer
      ((rootSubgroup TwistTag.E6.tag k e6HighestRoot :
        Subgroup (ModGL TwistTag.E6.tag k)) : Set (ModGL TwistTag.E6.tag k)) := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have hx1 : x ∈ levelRadical TwistTag.E6.tag k A 1 := hQA1 hx
    have hy2 : y ∈ levelRadical TwistTag.E6.tag k A 2 := by rw [hlev2]; exact hy
    have hc3 : ⁅x, y⁆ ∈ levelRadical TwistTag.E6.tag k A 3 := by
      have h := commutator_levelRadical_le (K := k) A 1 2
      rw [show (1 : ℤ) + 2 = 3 by norm_num] at h
      exact h (Subgroup.commutator_mem_commutator hx1 hy2)
    rw [hlev3, Subgroup.mem_bot] at hc3
    exact (commutatorElement_eq_one_iff_mul_comm.mp hc3).symm
  constructor
  · refine Subgroup.commutator_le.mpr fun x hx y hy => ?_
    have hx' : (x : ModGL TwistTag.E6.tag k) ∈ QA := Subgroup.mem_subgroupOf.mp hx
    have hy' : (y : ModGL TwistTag.E6.tag k) ∈ QA := Subgroup.mem_subgroupOf.mp hy
    change ((⁅x, y⁆ : G) : ModGL TwistTag.E6.tag k) ∈
      rootSubgroup TwistTag.E6.tag k e6HighestRoot
    have hcoe : ((⁅x, y⁆ : G) : ModGL TwistTag.E6.tag k) =
        ⁅(x : ModGL TwistTag.E6.tag k), (y : ModGL TwistTag.E6.tag k)⁆ :=
      map_commutatorElement (f := G.subtype) x y
    rw [hcoe]
    exact hcommModGL (Subgroup.commutator_mem_commutator hx' hy')
  · intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    apply Subtype.ext
    have hx' : (x : ModGL TwistTag.E6.tag k) ∈ QA := Subgroup.mem_subgroupOf.mp hx
    have hy' : (y : ModGL TwistTag.E6.tag k) ∈
      rootSubgroup TwistTag.E6.tag k e6HighestRoot := hy
    simpa only [Subgroup.coe_mul] using
      (Subgroup.mem_centralizer_iff.mp (hcentModGL hx')) y hy'

