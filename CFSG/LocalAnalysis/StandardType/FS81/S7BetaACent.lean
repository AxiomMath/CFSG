private theorem e7Incl_mem_rootPairSL2_highRoot {x : ↥(adjointGroup .E7 (ZMod 2))}
    (hx : x ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7)) :
    e7Incl x ∈ E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) := by
  have hmap : (E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7)).map e7Incl =
      E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) := by
    rw [E8Pilot.map_rootPairSL2_eq_of_forall e7Incl (highRoot .E7)
      (a := fun c => EPilot.pinnedElt .E8 (E8Pilot.e7Embed (highRoot .E7))
        (zmodTwoEquivGalois c))
      (b := fun c => EPilot.pinnedElt .E8 (E8Pilot.e7Embed (-(highRoot .E7)))
        (zmodTwoEquivGalois c))
      (fun c => e7Incl_pinnedElt (isRoot_highRoot .E7) c)
      (fun c => e7Incl_pinnedElt (IsRoot.neg (isRoot_highRoot .E7)) c)]
    rw [E8Pilot.rootPairSL2_eq_closure, E8Pilot.e7Embed_neg]
    congr 1
    ext g
    simp only [Set.mem_union, Set.mem_range]
    constructor
    · rintro (⟨c, hc⟩ | ⟨c, hc⟩)
      · exact Or.inl ⟨zmodTwoEquivGalois c, hc⟩
      · exact Or.inr ⟨zmodTwoEquivGalois c, hc⟩
    · rintro (⟨c, hc⟩ | ⟨c, hc⟩)
      · exact Or.inl ⟨zmodTwoEquivGalois.symm c, by simpa using hc⟩
      · exact Or.inr ⟨zmodTwoEquivGalois.symm c, by simpa using hc⟩
  exact hmap ▸ Subgroup.mem_map_of_mem e7Incl hx

private theorem perpLevi_map_conj_centralizes_e7Incl
    (w : WeylGroup .E8) (hw : w • highRoot .E8 = E8Pilot.e7Embed (highRoot .E7))
    {d : adjointGroup .E8 GF₂}
    (hd : d ∈ (EPilot.perpLevi .E8 GF₂).map
      (MulAut.conj (E8Pilot.canonicalRepElt GF₂ w)).toMonoidHom)
    {x : ↥(adjointGroup .E7 (ZMod 2))}
    (hx : x ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7)) :
    d * e7Incl x = e7Incl x * d := by
  set n := E8Pilot.canonicalRepElt GF₂ w with hn
  have hmapJ : (E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8)).map
      (MulAut.conj n).toMonoidHom =
      E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) := by
    rw [hn, E8Pilot.map_conj_canonicalRep_rootPairSL2 w (isRoot_highRoot .E8), hw]
  have hbase : EPilot.perpLevi .E8 GF₂ ≤ Subgroup.centralizer
      (E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8) : Set (adjointGroup .E8 GF₂)) := by
    intro d₀ hd₀
    rw [Subgroup.mem_centralizer_iff]
    intro j₀ hj₀
    exact Subtype.ext (Subgroup.mem_centralizer_iff.1
      (EPilot.highRootSL2_le_centralizer_perpLevi (K := GF₂) (Or.inr (Or.inr rfl))
        (Subgroup.mem_subgroupOf.1 hj₀))
      (d₀ : ModGL .E8 GF₂) (Subgroup.mem_subgroupOf.1 hd₀)).symm
  have hconj : (EPilot.perpLevi .E8 GF₂).map (MulAut.conj n).toMonoidHom ≤
      Subgroup.centralizer ((E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8)).map
        (MulAut.conj n).toMonoidHom : Set (adjointGroup .E8 GF₂)) := by
    intro d₁ hd₁
    obtain ⟨d₀, hd₀, rfl⟩ := Subgroup.mem_map.1 (by simpa only [SetLike.mem_coe] using hd₁)
    rw [Subgroup.mem_centralizer_iff]
    intro j₁ hj₁
    obtain ⟨j₀, hj₀, rfl⟩ := Subgroup.mem_map.1 (by simpa only [SetLike.mem_coe] using hj₁)
    have hb := hbase hd₀
    rw [Subgroup.mem_centralizer_iff] at hb
    show (MulAut.conj n) j₀ * (MulAut.conj n) d₀ = (MulAut.conj n) d₀ * (MulAut.conj n) j₀
    rw [← map_mul, ← map_mul, hb j₀ hj₀]
  have hdC : d ∈ Subgroup.centralizer
      (E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) :
        Set (adjointGroup .E8 GF₂)) := by
    have h := hconj hd
    rwa [hmapJ] at h
  exact (Subgroup.mem_centralizer_iff.1 hdC (e7Incl x)
    (e7Incl_mem_rootPairSL2_highRoot hx)).symm

private theorem centralizer_e7Incl_eq_zpowers_sup_map_conj
    (w : WeylGroup .E8) (hw : w • highRoot .E8 = E8Pilot.e7Embed (highRoot .E7))
    {r : ↥(adjointGroup .E7 (ZMod 2))}
    (hrJ : r ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7))
    (hr3 : orderOf r = 3) :
    Subgroup.centralizer ({e7Incl r} : Set (adjointGroup .E8 GF₂)) =
      Subgroup.zpowers (e7Incl r) ⊔
        (EPilot.perpLevi .E8 GF₂).map
          (MulAut.conj (E8Pilot.canonicalRepElt GF₂ w)).toMonoidHom := by
  set n := E8Pilot.canonicalRepElt GF₂ w with hn
  set ρ := e7Incl r with hρdef
  set ρθ := n⁻¹ * ρ * n with hρθdef
  have hρroot : ρ ∈ E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) :=
    e7Incl_mem_rootPairSL2_highRoot hrJ
  have hmapJ : (E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8)).map
      (MulAut.conj n).toMonoidHom =
      E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) := by
    rw [hn, E8Pilot.map_conj_canonicalRep_rootPairSL2 w (isRoot_highRoot .E8), hw]
  have hρθJ : ρθ ∈ E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8) := by
    obtain ⟨j₀, hj₀, hj₀eq⟩ := Subgroup.mem_map.1 (hmapJ ▸ hρroot)
    have : n⁻¹ * ρ * n = j₀ := by
      rw [← hj₀eq]
      change n⁻¹ * (n * j₀ * n⁻¹) * n = j₀
      group
    rwa [hρθdef, this]
  have hρ3 : orderOf ρ = 3 := by
    rw [hρdef, orderOf_injective e7Incl e7Incl_injective, hr3]
  have hρθ3 : orderOf ρθ = 3 := by
    rw [hρθdef]
    rw [show n⁻¹ * ρ * n = (MulAut.conj n⁻¹) ρ by rw [MulAut.conj_apply]; group]
    rw [MulEquiv.orderOf_eq (MulAut.conj n⁻¹) ρ, hρ3]
  have hXJ : Subgroup.zpowers ρθ ≤
      (EPilot.highRootSL2 .E8 GF₂).subgroupOf (adjointGroup .E8 GF₂) := by
    rw [Subgroup.zpowers_le]
    exact hρθJ
  have hcyc : IsCyclic (Subgroup.zpowers ρθ) := Subgroup.isCyclic_zpowers ρθ
  have hX : Nat.card (Subgroup.zpowers ρθ) = Nat.card GF₂ + 1 := by
    rw [Nat.card_zpowers, hρθ3]
    norm_num [natCard_galoisField_two_one]
  obtain ⟨heq, -, -⟩ :=
    E6Pilot.centralizer_nonsplit_of_descent (K := GF₂) (Or.inr (Or.inr rfl))
      E8Pilot.perpLeviFrobDescent_E8 hXJ hcyc hX
  have hcentX : Subgroup.centralizer (Subgroup.zpowers ρθ : Set (adjointGroup .E8 GF₂)) =
      Subgroup.centralizer ({ρθ} : Set (adjointGroup .E8 GF₂)) := by
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  have hmain : Subgroup.centralizer ({ρ} : Set (adjointGroup .E8 GF₂)) =
      Subgroup.zpowers ρ ⊔ (EPilot.perpLevi .E8 GF₂).map (MulAut.conj n).toMonoidHom := by
    have h1 : Subgroup.centralizer ({ρ} : Set (adjointGroup .E8 GF₂)) =
        (Subgroup.centralizer ({ρθ} : Set (adjointGroup .E8 GF₂))).map
          (MulAut.conj n).toMonoidHom := by
      rw [Subgroup.map_conj_centralizer_singleton,
        show n * ρθ * n⁻¹ = ρ by rw [hρθdef]; group]
    rw [h1, ← hcentX, heq, Subgroup.map_sup, MonoidHom.map_zpowers]
    rw [show (MulAut.conj n).toMonoidHom ρθ = ρ by
      rw [hρθdef]
      change n * (n⁻¹ * ρ * n) * n⁻¹ = ρ
      group]
    rfl
  rw [hρdef, hn] at hmain
  exact hmain

private theorem exists_inverting_e7Incl_in_perpLevi_map_conj
    (w : WeylGroup .E8) (hw : w • highRoot .E8 = E8Pilot.e7Embed (highRoot .E7))
    {r : ↥(adjointGroup .E7 (ZMod 2))}
    (hrJ : r ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7))
    (hr3 : orderOf r = 3) :
    ∃ t : adjointGroup .E8 GF₂,
      t * e7Incl r * t⁻¹ = (e7Incl r)⁻¹ ∧
      ∀ d ∈ (EPilot.perpLevi .E8 GF₂).map
        (MulAut.conj (E8Pilot.canonicalRepElt GF₂ w)).toMonoidHom, t * d = d * t := by
  set n := E8Pilot.canonicalRepElt GF₂ w with hn
  set ρ := e7Incl r with hρdef
  set ρθ := n⁻¹ * ρ * n with hρθdef
  set θx := EPilot.pinnedElt .E8 (highRoot .E8) (1 : GF₂) with hθxdef
  have h2 : (2 : GF₂) = 0 := CharTwo.two_eq_zero
  have hρroot : ρ ∈ E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) :=
    e7Incl_mem_rootPairSL2_highRoot hrJ
  have hmapJ : (E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8)).map
      (MulAut.conj n).toMonoidHom =
      E8Pilot.rootPairSL2 .E8 GF₂ (E8Pilot.e7Embed (highRoot .E7)) := by
    rw [hn, E8Pilot.map_conj_canonicalRep_rootPairSL2 w (isRoot_highRoot .E8), hw]
  have hρθJ : ρθ ∈ E8Pilot.rootPairSL2 .E8 GF₂ (highRoot .E8) := by
    obtain ⟨j₀, hj₀, hj₀eq⟩ := Subgroup.mem_map.1 (hmapJ ▸ hρroot)
    have : n⁻¹ * ρ * n = j₀ := by
      rw [← hj₀eq]
      change n⁻¹ * (n * j₀ * n⁻¹) * n = j₀
      group
    rwa [hρθdef, this]
  have hρ3 : orderOf ρ = 3 := by
    rw [hρdef, orderOf_injective e7Incl e7Incl_injective, hr3]
  have hρθ3 : orderOf ρθ = 3 := by
    rw [hρθdef]
    rw [show n⁻¹ * ρ * n = (MulAut.conj n⁻¹) ρ by rw [MulAut.conj_apply]; group]
    rw [MulEquiv.orderOf_eq (MulAut.conj n⁻¹) ρ, hρ3]
  have hρθmod : (ρθ : ModGL .E8 GF₂) ∈ EPilot.highRootSL2 .E8 GF₂ :=
    Subgroup.mem_subgroupOf.1 hρθJ
  rw [← E6Pilot.range_rootSL2_highRoot (K := GF₂)] at hρθmod
  obtain ⟨A, hA⟩ := hρθmod
  have hA3 : A ^ 3 = 1 := by
    apply E6Pilot.rootSL2_highRoot_injective (K := GF₂)
    rw [map_pow, map_one, hA, ← Subgroup.coe_pow,
      show ρθ ^ 3 = 1 by rw [← hρθ3]; exact pow_orderOf_eq_one ρθ]
    rfl
  have hA1 : A ≠ 1 := by
    intro h
    rw [h, map_one] at hA
    have h1 : ρθ = 1 := Subtype.ext hA.symm
    rw [h1, orderOf_one] at hρθ3
    omega
  have htθ_inv : θx * ρθ * θx⁻¹ = ρθ⁻¹ := by
    have hρθeq : ρθ = rootThree .E8 GF₂ (highRoot .E8) ∨
        ρθ = (rootThree .E8 GF₂ (highRoot .E8))⁻¹ := by
      rcases CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.PlanesTwo.sl2_eq_uv_or_vu
        (K := GF₂) natCard_galoisField_two_one A hA3 hA1 with hAuv | hAvu
      · left
        apply Subtype.ext
        rw [coe_rootThree (isRoot_highRoot .E8)]
        rw [hAuv] at hA
        exact hA.symm
      · right
        have huv_inv : (uSL (1 : GF₂) * vSL 1)⁻¹ = vSL 1 * uSL 1 := by
          rw [← inv_inv (vSL (1 : GF₂) * uSL 1),
            CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.PlanesTwo.vu_inv
              (K := GF₂) natCard_galoisField_two_one]
        apply Subtype.ext
        show (ρθ : ModGL .E8 GF₂) =
          ((rootThree .E8 GF₂ (highRoot .E8))⁻¹ : adjointGroup .E8 GF₂)
        rw [Subgroup.coe_inv, ← hA, hAvu, huv_inv.symm, map_inv,
          coe_rootThree (isRoot_highRoot .E8)]
    rcases hρθeq with h | h
    · rw [h]
      exact pinnedElt_mul_rootThree_mul_inv (K := GF₂) (isRoot_highRoot .E8)
    · rw [h]
      have h1 := pinnedElt_mul_rootThree_mul_inv (K := GF₂) (isRoot_highRoot .E8)
      calc θx * (rootThree .E8 GF₂ (highRoot .E8))⁻¹ * θx⁻¹
          = (θx * rootThree .E8 GF₂ (highRoot .E8) * θx⁻¹)⁻¹ := by group
        _ = ((rootThree .E8 GF₂ (highRoot .E8))⁻¹)⁻¹ := by rw [h1]
        _ = rootThree .E8 GF₂ (highRoot .E8) := inv_inv _
  have hTDθ : ∀ d₀ ∈ EPilot.perpLevi .E8 GF₂, θx * d₀ = d₀ * θx := by
    intro d₀ hd₀
    obtain ⟨hC, -⟩ := centralizer_pinnedElt_highRoot_E8 (K := GF₂)
    have h1 : d₀ ∈ Subgroup.centralizer ({θx} : Set (adjointGroup .E8 GF₂)) := by
      rw [hθxdef, hC]
      exact Subgroup.mem_sup_right hd₀
    exact Subgroup.mem_centralizer_iff.1 h1 θx (Set.mem_singleton θx)
  refine ⟨n * θx * n⁻¹, ?_, ?_⟩
  · have h1 : n * θx * n⁻¹ * ρ * (n * θx * n⁻¹)⁻¹ = ρ⁻¹ := by
      have e : n * θx * n⁻¹ * ρ * (n * θx * n⁻¹)⁻¹ =
          n * (θx * ρθ * θx⁻¹) * n⁻¹ := by rw [hρθdef]; group
      rw [e, htθ_inv]
      rw [show n * ρθ⁻¹ * n⁻¹ = ρ⁻¹ by rw [hρθdef]; group]
    rwa [hρdef] at h1
  · intro d hd
    obtain ⟨d₀, hd₀, rfl⟩ := Subgroup.mem_map.1 (by simpa only [SetLike.mem_coe] using hd)
    change (MulAut.conj n).toMonoidHom θx * (MulAut.conj n).toMonoidHom d₀ =
      (MulAut.conj n).toMonoidHom d₀ * (MulAut.conj n).toMonoidHom θx
    rw [← map_mul, ← map_mul, hTDθ d₀ hd₀]

private theorem isConjLine_zpowers_conj {G : Type} [Group G] {b₀ g g' : G} {c : G}
    (hc : c * g * c⁻¹ = g') :
    IsConjLine b₀ (Subgroup.zpowers g) ↔ IsConjLine b₀ (Subgroup.zpowers g') := by
  constructor
  · rintro ⟨y, hy⟩
    refine ⟨c * y, ?_⟩
    have hc' : (MulAut.conj c).toMonoidHom g = g' := by
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      exact hc
    have hmap : (Subgroup.zpowers (y * b₀ * y⁻¹)).map (MulAut.conj c).toMonoidHom =
        Subgroup.zpowers g' := by
      rw [hy, MonoidHom.map_zpowers, hc']
    have harg : (c * y) * b₀ * (c * y)⁻¹ = (MulAut.conj c).toMonoidHom (y * b₀ * y⁻¹) := by
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group
    rw [← hmap, MonoidHom.map_zpowers, harg]
  · rintro ⟨y, hy⟩
    refine ⟨c⁻¹ * y, ?_⟩
    have hc' : (MulAut.conj c⁻¹).toMonoidHom g' = g := by
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      rw [← hc]
      group
    have hmap : (Subgroup.zpowers (y * b₀ * y⁻¹)).map (MulAut.conj c⁻¹).toMonoidHom =
        Subgroup.zpowers g := by
      rw [hy, MonoidHom.map_zpowers, hc']
    have harg : (c⁻¹ * y) * b₀ * (c⁻¹ * y)⁻¹ =
        (MulAut.conj c⁻¹).toMonoidHom (y * b₀ * y⁻¹) := by
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group
    rw [← hmap, MonoidHom.map_zpowers, harg]

private def eℓ : Coords 8 := Pi.single 0 1 + Pi.single 1 (2 : ZMod 3)

private theorem vec_eℓ {G : Type} [Group G] {b₀ : G} {B : Basis3 G 8} (h0 : B.b 0 = b₀) :
    B.vec eℓ = b₀ * (B.b 1)⁻¹ := by
  rw [eℓ, B.vec_add, B.vec_single, Basis3.vec_single_eq_pow, h0,
    show (2 : ZMod 3).val = 2 from rfl]
  congr 1
  have h3 : (B.b 1) ^ 3 = 1 := by rw [← B.ord 1]; exact pow_orderOf_eq_one _
  exact eq_inv_of_mul_eq_one_left (by rw [← pow_succ, show 2 + 1 = 3 from rfl]; exact h3)

private theorem wt_single_two : wt (Pi.single (2 : Fin 8) 1) = 1 := by decide +kernel

private theorem wt_single_three : wt (Pi.single (3 : Fin 8) 1) = 1 := by decide +kernel

private theorem wt_single_four_five : wt (Pi.single (4 : Fin 8) 1 + Pi.single 5 1) = 2 := by
  decide +kernel

private theorem wt_single_two_smul :
    ∀ c : ZMod 3, c ≠ 0 → wt (c.val • eℓ + Pi.single (2 : Fin 8) 1) = 3 := by
  decide +kernel

private theorem wt_single_three_smul :
    ∀ c : ZMod 3, c ≠ 0 → wt (c.val • eℓ + Pi.single (3 : Fin 8) 1) = 3 := by
  decide +kernel

private theorem wt_single_four_five_smul :
    ∀ c : ZMod 3, c ≠ 0 → wt (c.val • eℓ + (Pi.single (4 : Fin 8) 1 + Pi.single 5 1)) = 4 := by
  decide +kernel

private theorem ne_zero_single_two_smul :
    ∀ c : ZMod 3, c ≠ 0 → c.val • eℓ + Pi.single (2 : Fin 8) 1 ≠ 0 := by
  decide +kernel

private theorem ne_zero_single_three_smul :
    ∀ c : ZMod 3, c ≠ 0 → c.val • eℓ + Pi.single (3 : Fin 8) 1 ≠ 0 := by
  decide +kernel

private theorem ne_zero_single_four_five_smul :
    ∀ c : ZMod 3, c ≠ 0 → c.val • eℓ + (Pi.single (4 : Fin 8) 1 + Pi.single 5 1) ≠ 0 := by
  decide +kernel

private theorem span_commute {G : Type} [Group G] {k : ℕ} (B : Basis3 G k) :
    ∀ a ∈ B.span, ∀ b ∈ B.span, a * b = b * a := by
  have h : B.span ≤ Subgroup.centralizer (B.span : Set G) := by
    rw [Basis3.span, Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    refine Subgroup.mem_centralizer_iff.2 fun b hb => ?_
    have hc : Commute (B.b i) b := by
      induction hb using Subgroup.closure_induction with
      | mem y hy => obtain ⟨j, rfl⟩ := hy; exact B.comm i j
      | one => exact Commute.one_right _
      | mul y z _ _ ihy ihz => exact ihy.mul_right ihz
      | inv y _ ihy => exact ihy.inv_right
    exact hc.eq.symm
  intro a ha b hb
  exact (Subgroup.mem_centralizer_iff.1 (h ha) b hb).symm

private theorem weight_contradiction_two {G : Type} [Group G] [Finite G] {b₀ : G} {B : Basis3 G 8}
    (hrec : RecOutTwD7 B b₀) {c : ZMod 3} (hc : c ≠ 0)
    (hiff : IsConjLine b₀ (B.line (Pi.single (2 : Fin 8) 1)) ↔
      IsConjLine b₀ (B.line (c.val • eℓ + Pi.single (2 : Fin 8) 1))) : False := by
  have hne : c.val • eℓ + Pi.single (2 : Fin 8) 1 ≠ 0 := ne_zero_single_two_smul c hc
  have h1 : IsConjLine b₀ (B.line (Pi.single (2 : Fin 8) 1)) :=
    (hrec.2.1 (Pi.single (2 : Fin 8) 1) (by decide +kernel)).mpr (by
      rw [wt_single_two]; norm_num)
  have h3 := (hrec.2.1 (c.val • eℓ + Pi.single (2 : Fin 8) 1) hne).mp (hiff.1 h1)
  rw [wt_single_two_smul c hc] at h3
  norm_num at h3

private theorem weight_contradiction_three {G : Type} [Group G] [Finite G] {b₀ : G} {B : Basis3 G 8}
    (hrec : RecOutTwD7 B b₀) {c : ZMod 3} (hc : c ≠ 0)
    (hiff : IsConjLine b₀ (B.line (Pi.single (3 : Fin 8) 1)) ↔
      IsConjLine b₀ (B.line (c.val • eℓ + Pi.single (3 : Fin 8) 1))) : False := by
  have hne : c.val • eℓ + Pi.single (3 : Fin 8) 1 ≠ 0 := ne_zero_single_three_smul c hc
  have h1 : IsConjLine b₀ (B.line (Pi.single (3 : Fin 8) 1)) :=
    (hrec.2.1 (Pi.single (3 : Fin 8) 1) (by decide +kernel)).mpr (by
      rw [wt_single_three]; norm_num)
  have h3 := (hrec.2.1 (c.val • eℓ + Pi.single (3 : Fin 8) 1) hne).mp (hiff.1 h1)
  rw [wt_single_three_smul c hc] at h3
  norm_num at h3

private theorem weight_contradiction_four_five {G : Type} [Group G] [Finite G] {b₀ : G}
    {B : Basis3 G 8}
    (hrec : RecOutTwD7 B b₀) {c : ZMod 3} (hc : c ≠ 0)
    (hiff : IsConjLine b₀ (B.line (Pi.single (4 : Fin 8) 1 + Pi.single 5 1)) ↔
      IsConjLine b₀
        (B.line (c.val • eℓ + (Pi.single (4 : Fin 8) 1 + Pi.single 5 1)))) : False := by
  have hne : c.val • eℓ + (Pi.single (4 : Fin 8) 1 + Pi.single 5 1) ≠ 0 :=
    ne_zero_single_four_five_smul c hc
  have hR : IsConjLine b₀
      (B.line (c.val • eℓ + (Pi.single (4 : Fin 8) 1 + Pi.single 5 1))) :=
    (hrec.2.1 (c.val • eℓ + (Pi.single (4 : Fin 8) 1 + Pi.single 5 1)) hne).mpr (by
      rw [wt_single_four_five_smul c hc]; norm_num)
  have h3 := (hrec.2.1 (Pi.single (4 : Fin 8) 1 + Pi.single 5 1)
    (by decide +kernel)).mp (hiff.2 hR)
  rw [wt_single_four_five] at h3
  norm_num at h3

private theorem map_conj_eq {M N : Type*} [Group M] [Group N] (f : M →* N) (c a : M) :
    f c * f a * (f c)⁻¹ = f (c * a * c⁻¹) := by
  rw [← map_mul f c a]
  rw [← map_inv f c]
  rw [← map_mul f (c * a) c⁻¹]

theorem s79A_centralizes_map_e7Incl_highRootSL2 {G : Type} [Group G] [Finite G] {b₀ : G}
    {K E : Subgroup G} {B : Basis3 G (Row.twD7.n + 1)} {Y : Subgroup G}
    (h : RootSetting Row.twD7 b₀ K E B Y) (ι : adjointGroup .E8 GF₂ →* G)
    (hι : Function.Injective ι) (hrange : ι.range = Y) (hβ : ι sθ = b₀ * B.b 1)
    (hA : s79A Row.twD7 B ≤ (Dθ).map ι) {r : ↥(adjointGroup .E7 (ZMod 2))}
    (hr : (r : ModGL .E7 (ZMod 2)) ∈ EPilot.highRootSL2 .E7 (ZMod 2)) (hr3 : orderOf r = 3)
    (hℓ : ι (e7Incl r) = b₀ * (B.b 1)⁻¹) :
    ∀ x : ↥(adjointGroup .E7 (ZMod 2)),
      (x : ModGL .E7 (ZMod 2)) ∈ EPilot.highRootSL2 .E7 (ZMod 2) →
      ∀ a ∈ s79A Row.twD7 B, a * ι (e7Incl x) = ι (e7Incl x) * a := by
  have hrange' := hrange
  have hβ' := hβ
  obtain ⟨w, hw⟩ := EPilot.exists_smul_highRoot_eq (Or.inr (Or.inr rfl))
    (E8Pilot.isRoot_e7Embed (isRoot_highRoot .E7))
  set n := E8Pilot.canonicalRepElt GF₂ w with hn
  set Dρ := (EPilot.perpLevi .E8 GF₂).map (MulAut.conj n).toMonoidHom with hDρdef
  have hrJ : r ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7) :=
    Subgroup.mem_subgroupOf.2 hr
  have hAc : ∀ x : ↥(adjointGroup .E7 (ZMod 2)),
      x ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7) →
      ∀ d ∈ Dρ, d * e7Incl x = e7Incl x * d :=
    fun x hx d hd => perpLevi_map_conj_centralizes_e7Incl w hw hd hx
  have hCent := centralizer_e7Incl_eq_zpowers_sup_map_conj w hw hrJ hr3
  have hCent' : Subgroup.centralizer ({e7Incl r} : Set (adjointGroup .E8 GF₂)) =
      Subgroup.zpowers (e7Incl r) ⊔ Dρ := hCent
  obtain ⟨t, htinv, htcent⟩ := exists_inverting_e7Incl_in_perpLevi_map_conj w hw hrJ hr3
  have hEab : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := by
    intro a ha b hb
    rw [← h.adapted.1] at ha hb
    exact span_commute B a ha b hb
  set ℓ := b₀ * (B.b 1)⁻¹ with hℓdef
  have hb0E : b₀ ∈ E := by rw [← h.adapted.2.1, ← h.adapted.1]; exact B.b_mem_span 0
  have hℓE : ℓ ∈ E := E.mul_mem hb0E (E.inv_mem (h.adapted.1 ▸ B.b_mem_span 1))
  have hℓvec : B.vec eℓ = ℓ := (vec_eℓ h.adapted.2.1).trans hℓdef.symm
  have hℓord : orderOf (B.vec eℓ) = 3 := by
    rw [hℓvec, ← hℓ, orderOf_injective ι hι,
      orderOf_injective e7Incl e7Incl_injective, hr3]
  have hρ3 : orderOf (e7Incl r) = 3 :=
    (orderOf_injective e7Incl e7Incl_injective r).trans hr3
  have key : ∀ (g : G) (e : Coords 8), g = B.vec e →
      (∀ c : ZMod 3, c ≠ 0 → (IsConjLine b₀ (B.line e) ↔
        IsConjLine b₀ (B.line (c.val • eℓ + e))) → False) →
      g ∈ (Dθ).map ι → g ∈ E → g ∈ Dρ.map ι := by
    intro g e hgv hcontra hgD hgE
    have hgℓ : g * ℓ = ℓ * g := hEab _ hgE _ hℓE
    obtain ⟨α, hαD, hαι⟩ := Subgroup.mem_map.1 (by simpa only [SetLike.mem_coe] using hgD)
    have hαcomm : α * e7Incl r = e7Incl r * α := by
      apply hι
      rw [map_mul, map_mul, hαι, hℓ]
      exact hgℓ
    have hαC : α ∈ Subgroup.centralizer ({e7Incl r} : Set (adjointGroup .E8 GF₂)) :=
      Subgroup.mem_centralizer_singleton_iff.2 hαcomm
    have hzpN : Subgroup.zpowers (e7Incl r) ≤
        Subgroup.normalizer (Dρ : Set (adjointGroup .E8 GF₂)) := by
      rw [Subgroup.zpowers_le]
      exact Subgroup.centralizer_le_normalizer _
        (Subgroup.mem_centralizer_iff.2 fun d hd => hAc r hrJ d hd)
    have hαC' : α ∈ Subgroup.zpowers (e7Incl r) ⊔ Dρ := hCent' ▸ hαC
    rw [← SetLike.mem_coe,
      Subgroup.coe_mul_of_left_le_normalizer_right (Subgroup.zpowers (e7Incl r)) Dρ hzpN] at hαC'
    obtain ⟨y, hy, d, hd, hyd⟩ := Set.mem_mul.1 hαC'
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    by_cases hk : (e7Incl r) ^ k = 1
    · refine Subgroup.mem_map.2 ⟨d, hd, ?_⟩
      rw [← hαι]
      congr 1
      rw [← hyd, hk, one_mul]
    · exfalso
      have hc : (k : ZMod 3) ≠ 0 := by
        intro hc0
        apply hk
        rw [E7Frame.zpow_eq_pow_val hρ3 k, hc0]
        simp
      have hgα : g = ι ((e7Incl r) ^ k * d) := by rw [← hαι, ← hyd]
      have htd : t * d * t⁻¹ = d := by rw [htcent d hd]; group
      have htρk : t * (e7Incl r) ^ k * t⁻¹ = (e7Incl r) ^ (-k) := by
        have h1 : (MulAut.conj t) ((e7Incl r) ^ k) = ((MulAut.conj t) (e7Incl r)) ^ k :=
          map_zpow (MulAut.conj t) (e7Incl r) k
        rw [MulAut.conj_apply, MulAut.conj_apply, htinv, inv_zpow'] at h1
        exact h1
      have htα : t * ((e7Incl r) ^ k * d) * t⁻¹ = (e7Incl r) ^ (-k) * d := by
        rw [show t * ((e7Incl r) ^ k * d) * t⁻¹ =
          (t * (e7Incl r) ^ k * t⁻¹) * (t * d * t⁻¹) by group, htρk, htd]
      have hgdecomp : g = ℓ ^ k * ι d := by rw [hgα, map_mul, map_zpow, hℓ]
      have hrel : ι t * g * (ι t)⁻¹ = ℓ ^ (-2*k) * g := by
        have h1 : ι t * g * (ι t)⁻¹ = ι ((e7Incl r) ^ (-k) * d) := by
          rw [hgα, map_conj_eq, htα]
        have hR : ι ((e7Incl r) ^ k * d) = ℓ ^ k * ι d := by
          rw [map_mul, map_zpow, hℓ]
        have hL : ι ((e7Incl r) ^ (-k) * d) = ℓ ^ (-k) * ι d := by
          rw [map_mul, map_zpow, hℓ]
        have h2 : ι ((e7Incl r) ^ (-k) * d) = ℓ ^ (-2*k) * g := by
          rw [hgα, hR, hL]
          group
        exact h1.trans h2
      have hcast : (k : ZMod 3) = ((-2*k : ℤ) : ZMod 3) := by
        have h1 : ((-2*k : ℤ) : ZMod 3) = (-2 : ZMod 3) * (k : ZMod 3) := by push_cast; ring
        rw [h1, show (-2 : ZMod 3) = 1 from by decide, one_mul]
      have hℓord_ℓ : orderOf ℓ = 3 := by rw [← hℓvec]; exact hℓord
      have hℓpow : B.vec (((k : ZMod 3).val) • eℓ) = ℓ ^ (-2*k) := by
        calc B.vec (((k : ZMod 3).val) • eℓ)
            = (B.vec eℓ) ^ ((k : ZMod 3).val) := Basis3.vec_nsmul B _ eℓ
          _ = ℓ ^ ((k : ZMod 3).val) := by rw [hℓvec]
          _ = ℓ ^ (((-2*k : ℤ) : ZMod 3).val) := by rw [hcast]
          _ = ℓ ^ (-2*k) := (E7Frame.zpow_eq_pow_val hℓord_ℓ (-2*k)).symm
      have hline2 : ℓ ^ (-2*k) * g = B.vec (((k : ZMod 3).val) • eℓ + e) := by
        rw [← hℓpow, hgv]
        exact (Basis3.vec_add B (((k : ZMod 3).val) • eℓ) e).symm
      have hiff' : IsConjLine b₀ (B.line e) ↔
          IsConjLine b₀ (B.line (((k : ZMod 3).val) • eℓ + e)) := by
        have hz := isConjLine_zpowers_conj (b₀ := b₀) (c := ι t) hrel
        rwa [hline2, hgv] at hz
      exact hcontra (k : ZMod 3) hc hiff'
  have hgen : ∀ g ∈ ({B.b 2, B.b 3, B.b 4 * B.b 5} : Set G), g ∈ Dρ.map ι := by
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl | rfl
    · refine key (B.b 2) (Pi.single (2 : Fin 8) 1) (B.vec_single 2).symm ?_
        (hA (Subgroup.subset_closure (by simp))) (h.adapted.1 ▸ B.b_mem_span 2)
      intro c hc hiff
      exact weight_contradiction_two h.recOut hc hiff
    · refine key (B.b 3) (Pi.single (3 : Fin 8) 1) (B.vec_single 3).symm ?_
        (hA (Subgroup.subset_closure (by simp))) (h.adapted.1 ▸ B.b_mem_span 3)
      intro c hc hiff
      exact weight_contradiction_three h.recOut hc hiff
    · refine key (B.b 4 * B.b 5) (Pi.single (4 : Fin 8) 1 + Pi.single 5 1) ?_ ?_
        (hA (Subgroup.subset_closure (by simp)))
        (E.mul_mem (h.adapted.1 ▸ B.b_mem_span 4) (h.adapted.1 ▸ B.b_mem_span 5))
      · have hv1 : B.b 4 = B.vec (Pi.single (4 : Fin 8) 1) := (B.vec_single 4).symm
        have hv2 : B.b 5 = B.vec (Pi.single (5 : Fin 8) 1) := (B.vec_single 5).symm
        rw [hv1, hv2]
        exact (Basis3.vec_add B (Pi.single (4 : Fin 8) 1) (Pi.single (5 : Fin 8) 1)).symm
      · intro c hc hiff
        exact weight_contradiction_four_five h.recOut hc hiff
  have hAle : s79A Row.twD7 B ≤ Dρ.map ι := by
    rw [s79A]
    exact (Subgroup.closure_le (Dρ.map ι)).2 hgen
  intro x hx a ha
  have hxD : x ∈ E8Pilot.rootPairSL2 .E7 (ZMod 2) (highRoot .E7) :=
    Subgroup.mem_subgroupOf.2 hx
  obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.1
    (by simpa only [SetLike.mem_coe] using hAle ha)
  rw [← map_mul, ← map_mul, hAc x hxD d hd]

