namespace CFSG.StandardType.FrameRoute.FS81.D6M

open CFSG.SeitzReduction.OmegaPilot CFSG.LocalAnalysis.GLTheoremA.KD264Lie.OmC

abbrev V12 : Type := Fin 6 ⊕ Fin 6 → ZMod 2

noncomputable abbrev Q12 : QuadraticForm (ZMod 2) V12 :=
  CFSG.LieType.Universal.Spin.quadPlus 6 (ZMod 2)

noncomputable abbrev Om12 : Subgroup (V12 ≃ₗ[ZMod 2] V12) :=
  ⁅TauCeti.QuadraticMap.orthogonalGroup Q12, TauCeti.QuadraticMap.orthogonalGroup Q12⁆

noncomputable abbrev lin : GL (Fin 6 ⊕ Fin 6) (ZMod 2) →* (V12 ≃ₗ[ZMod 2] V12) :=
  (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (Fin 6 ⊕ Fin 6) (ZMod 2)).toMonoidHom

@[expose] noncomputable def rootL (B P : Finset (Fin 6)) : Subgroup (V12 ≃ₗ[ZMod 2] V12) :=
  ((siegelBlockGL (ZMod 2) B).map (MulAut.conj (flipGL (ZMod 2) P)).toMonoidHom).map lin

@[expose] noncomputable def node (j : Fin 6) : Subgroup (V12 ≃ₗ[ZMod 2] V12) :=
  rootL (plusNodeSet 6 j) (plusNodeFlip 6 j)

theorem node_eq_map_siegelNode (j : Fin 6) : node j = (siegelNode (ZMod 2) 6 j).map lin := rfl

@[expose] noncomputable def flip0 : Subgroup (V12 ≃ₗ[ZMod 2] V12) := rootL {0, 1} {1}

@[expose] noncomputable def flip2 : Subgroup (V12 ≃ₗ[ZMod 2] V12) := rootL {2, 3} {3}

@[expose] def vec (s t : Finset (Fin 6)) : V12 :=
  Sum.elim (fun i => if i ∈ s then 1 else 0) (fun i => if i ∈ t then 1 else 0)

@[expose] def framePair : Fin 6 → V12 × V12 :=
  ![(vec {1} {0, 1}, vec {0, 1} {1}), (vec {1} {1}, vec {0, 1} {0}),
    (vec {3} {2, 3}, vec {2, 3} {3}), (vec {3} {3}, vec {2, 3} {2}),
    (vec {5} {4, 5}, vec {4, 5} {5}), (vec {5} {5}, vec {4, 5} {4})]

@[expose] def frameList : List (V12 × V12) := List.ofFn framePair

@[expose] noncomputable def frameRot (i : Fin 6) : V12 ≃ₗ[ZMod 2] V12 :=
  rot Q12 (framePair i).1 (framePair i).2

@[expose] def planeSpan (P : Finset (Fin 6)) : Submodule (ZMod 2) V12 where
  carrier := {v | ∀ i, i ∉ P → v (Sum.inl i) = 0 ∧ v (Sum.inr i) = 0}
  add_mem' {a b} ha hb i hi := by
    simp only [Pi.add_apply, (ha i hi).1, (hb i hi).1, (ha i hi).2, (hb i hi).2, add_zero,
      and_self]
  zero_mem' _ _ := ⟨rfl, rfl⟩
  smul_mem' c v hv i hi := by
    simp only [Pi.smul_apply, (hv i hi).1, (hv i hi).2, smul_zero, and_self]

theorem mem_planeSpan {P : Finset (Fin 6)} {v : V12} :
    v ∈ planeSpan P ↔ ∀ i, i ∉ P → v (Sum.inl i) = 0 ∧ v (Sum.inr i) = 0 := Iff.rfl

@[expose] def Y2 : Submodule (ZMod 2) V12 := planeSpan {2, 3}

@[expose] def IsHypPlane (P : Submodule (ZMod 2) V12) : Prop :=
  P ≤ Y2 ∧ ∃ u u' : V12, P = Submodule.span (ZMod 2) {u, u'} ∧ Q12 u = 0 ∧ Q12 u' = 0 ∧
    QuadraticMap.polar Q12 u u' = 1

@[expose] noncomputable def perpY2 (P : Submodule (ZMod 2) V12) : Submodule (ZMod 2) V12 :=
  Y2 ⊓ LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin Q12) P

@[expose] def SigOf (P : Submodule (ZMod 2) V12) (c : V12 ≃ₗ[ZMod 2] V12) : Prop :=
  c ∈ flip2 ∧ c ≠ 1 ∧ ∃ m ∈ node 2, ∀ v ∈ P, (m * c) v ∈ P

end CFSG.StandardType.FrameRoute.FS81.D6M
