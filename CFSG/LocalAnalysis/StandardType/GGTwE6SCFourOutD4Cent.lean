private theorem d4Cent_eq_six {ρ : ℕ} (hρ : ρ < 8)
    (h : (kernelRoots (triChar (vec3 (τ := .E6) (e6ThreeReps.getD ρ [])))).ncard = 24) :
    ρ = 6 := by
  have h1 := ncard_kernelRoots_triChar_filter (vec3 (τ := .E6) (e6ThreeReps.getD ρ []))
    (fun _ => True)
  simp only [and_true, Set.setOf_mem_eq] at h1
  rw [h1] at h
  clear h1
  revert ρ
  decide +kernel

private theorem d4Cent_exists_repD {L : Type} [Field L] {a : Fin Tag.E6.rank → Lˣ}
    (hap : ∀ i, a i ^ 3 = 1) (hall : (kernelRoots (rootCharHom a)).ncard = 24) :
    ∃ (b : Fin Tag.E6.rank → ZMod 3) (t : WeylGroup Tag.E6),
      kernelRoots (rootCharHom a) = kernelRoots (triChar b) ∧
        ∀ v, triPairing b (t • v) = triPairing repD v := by
  classical
  obtain ⟨χ', hker⟩ := exists_triChar_ker_eq (rootCharHom3 a) (rootCharHom3_pow_three a hap)
  obtain ⟨b, rfl⟩ : ∃ b, χ' = triChar b := ⟨_, eq_triChar χ'⟩
  have hker' : kernelRoots (rootCharHom a) = kernelRoots (triChar b) := kernelRoots_congr_ker hker
  obtain ⟨ρ, hρ, t, ht⟩ := exists_isCharConj_of_orbitCheck3 e6ThreeScCheck_spec.1 (triChar b)
  have hρ8 : ρ < 8 := hρ
  have hpair : ∀ v, triPairing b v =
      triPairing (vec3 (τ := .E6) (e6ThreeReps.getD ρ [])) (t⁻¹ • v) := fun v => by
    have h := ht v
    rw [triChar_apply, triChar_apply] at h
    exact Z3.ofAdd_eq_ofAdd_iff.1 h
  have himg : (fun v => t⁻¹ • v) '' kernelRoots (triChar b) =
      kernelRoots (triChar (vec3 (τ := .E6) (e6ThreeReps.getD ρ []))) := by
    ext α
    constructor
    · rintro ⟨β, hβ, rfl⟩
      obtain ⟨hβr, hβ0⟩ := mem_kernelRoots_triChar.1 hβ
      exact mem_kernelRoots_triChar.2 ⟨IsRoot.smul hβr t⁻¹, by rw [← hpair]; exact hβ0⟩
    · intro hα
      obtain ⟨hαr, hα0⟩ := mem_kernelRoots_triChar.1 hα
      refine ⟨t • α, mem_kernelRoots_triChar.2 ⟨IsRoot.smul hαr t, ?_⟩, inv_smul_smul t α⟩
      rw [hpair, inv_smul_smul]
      exact hα0
  have h6 : ρ = 6 := by
    refine d4Cent_eq_six hρ8 ?_
    rw [← himg, Set.ncard_image_of_injective _ (MulAction.injective t⁻¹), ← hker', hall]
  subst h6
  refine ⟨b, t, hker', fun v => ?_⟩
  rw [hpair, inv_smul_smul]
  congr 1
  decide +kernel

private theorem d4Cent_mem_torusGroup {L : Type} [Field L] [IsAlgClosed L]
    {a : Fin Tag.E6.rank → Lˣ} (hap : ∀ i, a i ^ 3 = 1)
    (hall : (kernelRoots (rootCharHom a)).ncard = 24) {y : ModGL Tag.E6 L}
    (hy : y ∈ adjointGroup Tag.E6 L)
    (hc : ∀ β ∈ kernelRoots (rootCharHom a), ∀ c : L, Commute y (pinnedX Tag.E6 L β c)) :
    y ∈ torusGroup Tag.E6 L := by
  obtain ⟨b, t, hker, htb⟩ := d4Cent_exists_repD hap hall
  obtain ⟨Γ', hΓ'mem, hΓ'reg⟩ := exists_regFam (b := repD) (Or.inl rfl)
  have hΓ' : ∀ x ∈ Γ', IsRoot Tag.E6 x.1 := fun x hx => (hΓ'mem x hx).1
  set Γ : List ((Fin Tag.E6.rank → ℤ) × ℤ) := Γ'.map fun x => (t • x.1, x.2) with hΓdef
  have hΓroot : ∀ x ∈ Γ, IsRoot Tag.E6 x.1 := by
    intro x hx
    obtain ⟨x', hx', rfl⟩ := List.mem_map.1 hx
    exact IsRoot.smul (hΓ' x' hx') t
  have hΓker : ∀ x ∈ Γ,
      x.1 ∈ kernelRoots (rootCharHom a) ∧ -x.1 ∈ kernelRoots (rootCharHom a) := by
    intro x hx
    obtain ⟨x', hx', rfl⟩ := List.mem_map.1 hx
    have h0 : triPairing b (t • x'.1) = 0 := by rw [htb]; exact (hΓ'mem x' hx').2
    have h1 : triPairing b (-(t • x'.1)) = 0 := by
      have h2 := triPairing_add b (t • x'.1) (-(t • x'.1))
      rw [add_neg_cancel, triPairing_zero, h0, zero_add] at h2
      exact h2.symm
    rw [hker]
    exact ⟨mem_kernelRoots_triChar.2 ⟨IsRoot.smul (hΓ' x' hx') t, h0⟩,
      mem_kernelRoots_triChar.2 ⟨IsRoot.neg (IsRoot.smul (hΓ' x' hx') t), h1⟩⟩
  have hreg : ∀ α : Fin Tag.E6.rank → ℤ, IsRoot Tag.E6 α →
      (∑ j, regCoweight Γ j * α j) ≠ 0 ∧ (∑ j, regCoweight Γ j * α j).natAbs < 12 := by
    intro α hα
    rw [hΓdef, sum_regCoweight_map_smul t Γ' hΓ' α]
    exact hΓ'reg _ (IsRoot.smul hα t⁻¹)
  obtain ⟨ℓ, hℓge, hℓ⟩ := Nat.exists_infinite_primes (12 + ringChar L + 8)
  have hℓ7 : 7 < ℓ := by omega
  have hℓL : (ℓ : L) ≠ 0 := by
    intro h0
    rcases hℓ.eq_one_or_self_of_dvd _ (ringChar.dvd h0) with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · omega
  have : NeZero (ℓ : L) := ⟨hℓL⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L ℓ
  set ζ : Lˣ := (hζ₀.isUnit hℓ.ne_zero).unit
  have hζ : orderOf ζ = ℓ := (IsPrimitiveRoot.coe_units_iff.1 hζ₀).eq_orderOf.symm
  have hreg' : ∀ α : Fin Tag.E6.rank → ℤ, IsRoot Tag.E6 α →
      ¬ (ℓ : ℤ) ∣ ∑ j, regCoweight Γ j * α j := by
    intro α hα hdvd
    obtain ⟨hne, hlt⟩ := hreg α hα
    have h1 : ℓ ∣ (∑ j, regCoweight Γ j * α j).natAbs := Int.natCast_dvd.1 hdvd
    have h2 := Nat.le_of_dvd (Int.natAbs_pos.2 hne) h1
    omega
  have hcomm : ∀ x ∈ Γ, ∀ s : Lˣ, Commute y (rootTorusSL2 Tag.E6 L x.1 s) := fun x hx s =>
    commute_rootTorusSL2_of_commute (hΓroot x hx) (hc _ (hΓker x hx).1) (hc _ (hΓker x hx).2) s
  obtain ⟨P, hPT, hyP, hPχ⟩ := exists_commute_rootTorus_prod' ζ Γ hΓroot hcomm
  have hdz : rootDiagUnit Tag.E6 (fun j => ζ ^ regCoweight Γ j) ∈ torusGroup Tag.E6 L := by
    obtain ⟨-, t', ht'⟩ :=
      exceptional_Lang_adjoint_diagonal_lift Tag.E6 L (fun j => ζ ^ regCoweight Γ j)
    rw [ht']
    refine Subgroup.list_prod_mem _ fun q hq => ?_
    obtain ⟨j, -, rfl⟩ := List.mem_map.1 hq
    exact torusElt_mem_torusGroup j _
  have hPeq : P = rootDiagUnit Tag.E6 (fun j => ζ ^ regCoweight Γ j) :=
    eq_of_torusRootChar_single hPT hdz fun j => by
      rw [hPχ j, torusRootChar_rootDiagUnit _ (isRoot_single Tag.E6 j), rootChar_single']
  rw [hPeq] at hyP
  rw [← toralCentralizer_eq_torusGroup_of_regular (τ := Tag.E6) (Or.inl rfl) hℓ hℓ7 hζ _ hreg']
  exact Subgroup.mem_inf.2 ⟨hy, Subgroup.mem_centralizer_singleton_iff.2 hyP.eq⟩

theorem mem_torusGroup_of_commute_d4 {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ}
    {h : twistedE6InndiagGL K σ} (D : TwE6LineLang K σ q h) (hdim : twE6MatFixDim K σ h = 30)
    (i : KernelComponent (rootCharHom D.a))
    (hin : twistInner (componentRoots (rootCharHom D.a) i)
      (D.S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)))
    {y : ModGL Tag.E6 (AlgebraicClosure K)} (hy : y ∈ adjointGroup Tag.E6 (AlgebraicClosure K))
    (hc : ∀ x ∈ rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i, Commute y x) :
    y ∈ torusGroup Tag.E6 (AlgebraicClosure K) := by
  classical
  have hall : (kernelRoots (rootCharHom D.a)).ncard = 24 := by
    have := D.hker
    omega
  obtain ⟨-, hcard⟩ := d4t2_class_of_card D.hL3 D.hap hall i
  have hfin := finite_kernelRoots_E6 (rootCharHom D.a)
  have hker : componentRoots (rootCharHom D.a) i = kernelRoots (rootCharHom D.a) :=
    Set.eq_of_subset_of_ncard_le (componentRoots_subset_kernelRoots _ i) (by rw [hcard, hall])
      hfin
  have hρ : ∀ γ ∈ componentRoots (rootCharHom D.a) i,
      D.S.ρ γ ∈ componentRoots (rootCharHom D.a) i := by
    intro γ hγ
    rw [hker] at hγ ⊢
    exact outer_rho_mem_kernelRoots D.S D.hT hγ
  have hs1 : componentOrbitLength D.S.ρ (componentRoots (rootCharHom D.a) i) = 1 :=
    componentOrbitLength_eq_one (hfin.subset (componentRoots_subset_kernelRoots _ i)) hρ
  have hq : D.S.D.q = 2 ∨ 4 ≤ D.S.D.q := by
    have hp2 := D.hℓ.two_le
    have hp3 : ringChar K ≠ 3 := fun h3 => D.hL3 (by
      haveI := D.hchar
      rw [← h3]
      exact CharP.cast_eq_zero _ _)
    rw [D.hSq]
    rcases Nat.lt_or_ge D.e 2 with he | he
    · have he1 : D.e = 1 := by have := D.he; omega
      rw [he1, pow_one]
      omega
    · right
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ ringChar K ^ 2 := Nat.pow_le_pow_left hp2 2
        _ ≤ ringChar K ^ D.e := Nat.pow_le_pow_right (by omega) he
  have hspan : ∀ g ∈ rootSpan Tag.E6 (AlgebraicClosure K) (componentRoots (rootCharHom D.a) i),
      Commute y g := by
    rcases hq with hq | hq
    · exact commute_rootSpan_of_commute_component_two D.S (Or.inl rfl) D.hT i
        (by rw [hs1, Function.iterate_one]; exact hin) hs1 hq (by rw [hcard]; norm_num) y hc
    · exact commute_rootSpan_of_commute_component_anyT D.S (by decide) D.hT i (by omega)
        (by rw [hs1, pow_one]; exact hq) y hc
  refine d4Cent_mem_torusGroup D.hap hall hy fun β hβ c => hspan _ (pinnedX_mem_rootSpan ?_ c)
  rw [hker]
  exact hβ

