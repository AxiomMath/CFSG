theorem b5c_refl : reflCertB b5cGens b5cCerts = true := by
  decide +kernel

theorem b5c_frame : bFrameB 5 b5cCerts = true := by
  decide +kernel

theorem b5c_S (k : Fin 5) : bcFullS 5 k = letLin (letAt b5cGens k) := by
  refine LinearEquiv.toLinearMap_injective ((Pi.basisFun (ZMod 3) (Fin 6)).ext fun j => ?_)
  rw [Pi.basisFun_apply]
  revert k j
  decide +kernel

theorem b5c_test : ∀ A Mg : Subgroup (Vn 6 ≃ₗ[ZMod 3] Vn 6),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 5 => bcFullS 5 k)) (xLast 5) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 5) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 5) t → t ∈ Mg :=
  linTest_bframe_of_certOK _ b5cGens rfl b5c_S b5c_refl b5c_frame b5c_certOK b5c_cov

