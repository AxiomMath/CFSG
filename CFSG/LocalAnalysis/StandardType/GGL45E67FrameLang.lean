theorem ggL45E67_weyl_eq_of_frame
    {τ : Tag} {L : Type} [Field L] {F₀ : ModGL τ L →* ModGL τ L} {A : Subgroup (ModGL τ L)}
    {w m : WeylGroup τ}
    (hFA : ∀ a ∈ A, F₀ a =
      (canonicalRep (coxeterSystem τ) L m)⁻¹ * a * canonicalRep (coxeterSystem τ) L m)
    (hAw : A ≤ twistedTorusOf (canonicalRep (coxeterSystem τ) L w) F₀)
    (hC : adjointGroup τ L ⊓ Subgroup.centralizer (A : Set (ModGL τ L)) = torusGroup τ L) :
    w = m := by
  let n_w := canonicalRep (coxeterSystem τ) L w
  let n_m := canonicalRep (coxeterSystem τ) L m
  let y := n_w * n_m⁻¹
  have hyAdj : y ∈ adjointGroup τ L :=
    Subgroup.mul_mem _ (canonicalRep_mem_adjointGroup (coxeterSystem τ) L w)
      (Subgroup.inv_mem _ (canonicalRep_mem_adjointGroup (coxeterSystem τ) L m))
  have hyCent : y ∈ Subgroup.centralizer (A : Set (ModGL τ L)) := by
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    have hya : y * a * y⁻¹ = a := by
      calc y * a * y⁻¹ = n_w * (n_m⁻¹ * a * n_m) * n_w⁻¹ := by
            simp only [y]; group
        _ = n_w * F₀ a * n_w⁻¹ := by rw [hFA a ha]
        _ = a := ((mem_twistedTorusOf (n := n_w) (Φ := F₀)).1 (hAw ha)).2
    have hya' : y * a = a * y := by
      calc y * a = (y * a * y⁻¹) * y := by group
        _ = a * y := by rw [hya]
    exact hya'.symm
  have hyT : y ∈ torusGroup τ L := by
    rw [← hC]
    exact Subgroup.mem_inf.mpr ⟨hyAdj, hyCent⟩
  have hEq : y * n_m = 1 * n_w := by
    calc y * n_m = n_w * n_m⁻¹ * n_m := rfl
      _ = 1 * n_w := by group
  exact (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6ThreeInner.eq_of_torus_mul_canonicalRep_eq
    hyT (one_mem _) hEq).symm

theorem ggL45E67_frob_eq_self_of_pow_three_eq_one
    {L : Type} [Field L] [CharP L 2] {e : ℕ} (h3 : 3 ∣ 2 ^ e - 1)
    {a : ModGL Tag.E6 L} (ha : a ∈ torusGroup Tag.E6 L) (ha3 : a ^ 3 = 1) :
    frobTwistGL Tag.E6 L 2 e 1 a = a := by
  rw [frobTwistGL_apply, one_mul, inv_one, mul_one]
  rw [CFSG.Quasithin.H13.NQSetup.units_map_entrywiseHom_eq_pow_of_mem_torusGroup
    (iterateFrobenius L 2 e) (fun c => iterateFrobenius_def 2 e c) ha]
  obtain ⟨k, hk⟩ := h3
  have hle : 1 ≤ 2 ^ e := Nat.one_le_two_pow
  have heq : 2 ^ e = 3 * k + 1 := by
    rw [← Nat.sub_add_cancel hle, hk]
  have hmod : 2 ^ e % 3 = 1 := by
    rw [heq, Nat.mul_add_mod_self_left]
  calc a ^ 2 ^ e = a ^ (2 ^ e % 3) := pow_eq_pow_mod (2 ^ e) ha3
    _ = a := by rw [hmod, pow_one]

private theorem ggL45E67_twFrob_rootDiagUnit
    {L : Type} [Field L] [CharP L 2] {e : ℕ} (h3 : 3 ∣ 2 ^ e + 1)
    {b : Fin Tag.E6.rank → Lˣ} (hb : ∀ i, b i ^ 3 = 1) :
    frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L) (rootDiagUnit Tag.E6 b) =
      (TwistedDiag.n0 L)⁻¹ * rootDiagUnit Tag.E6 b * TwistedDiag.n0 L := by
  let n := canonicalRep (coxeterSystem Tag.E6) L twE6W0
  have hkey : n * twistE6 L (iterateFrobenius L 2 e) (rootDiagUnit Tag.E6 b) * n⁻¹ =
      rootDiagUnit Tag.E6 b := by
    simpa [n] using conj_twistE6_rootDiagUnit_of_cube (Fr := iterateFrobenius L 2 e)
      (fun c => iterateFrobenius_def 2 e c) h3 b hb
  have htw : twistE6 L (iterateFrobenius L 2 e) (rootDiagUnit Tag.E6 b) =
      n⁻¹ * rootDiagUnit Tag.E6 b * n := by
    calc twistE6 L (iterateFrobenius L 2 e) (rootDiagUnit Tag.E6 b) =
        n⁻¹ * (n * twistE6 L (iterateFrobenius L 2 e) (rootDiagUnit Tag.E6 b) * n⁻¹) * n :=
          by group
      _ = n⁻¹ * rootDiagUnit Tag.E6 b * n := by rw [hkey]
  have hfrob : frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L)
      (rootDiagUnit Tag.E6 b) =
        twistE6 L (iterateFrobenius L 2 e) (rootDiagUnit Tag.E6 b) := rfl
  rw [hfrob]
  simpa [n, TwistedDiag.n0] using htw

theorem ggL45E67_twFrob_eq_conj_of_pow_three_eq_one
    {L : Type} [Field L] [CharP L 2] {e : ℕ} (h3 : 3 ∣ 2 ^ e + 1)
    {a : ModGL Tag.E6 L} (ha : a ∈ torusGroup Tag.E6 L) (ha3 : a ^ 3 = 1) :
    frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L) a =
      (TwistedDiag.n0 L)⁻¹ * a * TwistedDiag.n0 L := by
  obtain ⟨b, rfl⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup ha
  have hb : ∀ i, b i ^ 3 = 1 := by
    have hb3 : b ^ 3 = 1 := by
      apply DiagTorus.rootDiagUnit_injective
      rw [rootDiagUnit_one]
      have hpow : (rootDiagUnit Tag.E6 b) ^ 3 = rootDiagUnit Tag.E6 (b ^ 3) := by
        rw [pow_three', pow_three', rootDiagUnit_mul, rootDiagUnit_mul]
      rw [← hpow]
      exact ha3
    intro i
    simpa using congrFun hb3 i
  exact ggL45E67_twFrob_rootDiagUnit h3 hb

private theorem ggL45E67_frame_iterate_three
    {L : Type} [Field L] [CharP L 2] {e : ℕ} (Fr : L →+* L)
    (hFr : ∀ c, Fr c = c ^ 2 ^ (3 * e)) (x : ModGL Tag.E6 L) :
    (⇑(frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L)))^[3] x =
      twistE6 L Fr x := by
  let P : ModGL Tag.E6 L := diagramMap TwistTag.E6 L
  let F₀ := frobTwistGL Tag.E6 L 2 e P
  have hQ : entrywiseFrobGL Tag.E6 L 2 e P = P :=
    units_map_entrywiseHom_diagramMap (t := TwistTag.E6) (K := L)
      (σ := iterateFrobenius L 2 e)
  have hiter := frobTwistGL_iterate (p := 2) (e := e) (Q := P) hQ 3 x
  have hPP : P * P = 1 := by
    change diagramMap TwistTag.E6 L * diagramMap TwistTag.E6 L = 1
    calc diagramMap TwistTag.E6 L * diagramMap TwistTag.E6 L =
        (diagramMap TwistTag.E6 L)⁻¹ * diagramMap TwistTag.E6 L := by
          rw [diagramMap_E6_inv (K := L)]
      _ = 1 := inv_mul_cancel _
  have hP3 : P ^ 3 = P := by
    rw [pow_succ, pow_two, hPP, one_mul]
  have hFr' : iterateFrobenius L 2 (e * 3) = Fr := by
    ext c
    rw [iterateFrobenius_def, hFr, Nat.mul_comm]
  have hEF : entrywiseFrobGL Tag.E6 L 2 (e * 3) = Units.map (entrywiseHom Fr) := by
    change Units.map (entrywiseHom (iterateFrobenius L 2 (e * 3))) =
      Units.map (entrywiseHom Fr)
    rw [hFr']
  calc (⇑F₀)^[3] x = P ^ 3 * entrywiseFrobGL Tag.E6 L 2 (e * 3) x * (P ^ 3)⁻¹ := hiter
    _ = P * Units.map (entrywiseHom Fr) x * P⁻¹ := by rw [hP3, hEF]
    _ = twistE6 L Fr x := rfl

private theorem ggL45E67_frame_n0
    {L : Type} [Field L] [CharP L 2] {e : ℕ} :
    frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L) (TwistedDiag.n0 L) =
        TwistedDiag.n0 L ∧
      TwistedDiag.n0 L * TwistedDiag.n0 L = 1 := by
  let P : ModGL Tag.E6 L := diagramMap TwistTag.E6 L
  let F₀ := frobTwistGL Tag.E6 L 2 e P
  have hdelta : TwistedDiag.delta twE6W0 = twE6W0 := by
    have h := TwistedDiag.w0_mul_delta_mul_w0_inv twE6W0
    calc TwistedDiag.delta twE6W0 =
        twE6W0⁻¹ * (twE6W0 * TwistedDiag.delta twE6W0 * twE6W0⁻¹) * twE6W0 := by group
      _ = twE6W0⁻¹ * twE6W0 * twE6W0 := by rw [h]
      _ = twE6W0 := by group
  constructor
  · have h : F₀ (TwistedDiag.n0 L) = TwistedDiag.n0 L := by
      change twistE6 L (iterateFrobenius L 2 e) (TwistedDiag.n0 L) =
        TwistedDiag.n0 L
      calc twistE6 L (iterateFrobenius L 2 e) (TwistedDiag.n0 L) =
          canonicalRep (coxeterSystem Tag.E6) L (TwistedDiag.delta twE6W0) := by
            rw [show TwistedDiag.n0 L =
              canonicalRep (coxeterSystem Tag.E6) L twE6W0 from rfl]
            exact twistHom_canonicalRep TwistTag.E6 L (iterateFrobenius L 2 e) twE6W0
        _ = TwistedDiag.n0 L := by rw [hdelta]; rfl
    simpa [F₀, P, MulAut.conj_apply] using h
  · have h := CFSG.RankThree.PartOne.Q1327T.canonicalRep_mul_charTwo
      (τ := Tag.E6) (R := L) twE6W0 twE6W0
    rw [TwistedDiag.twE6W0_mul_self, canonicalRep_one] at h
    exact h.symm

theorem ggL45E67_isLang_of_frame
    {L : Type} [Field L] [CharP L 2] {e : ℕ} (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2 ^ (3 * e))
    {g u : ModGL Tag.E6 L} (hg : g ∈ adjointGroup Tag.E6 L)
    (hFg : frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L) g = g * TwistedDiag.n0 L)
    (hu : u ∈ adjointGroup Tag.E6 L)
    (hu3 : (⇑(frobTwistGL Tag.E6 L 2 e (diagramMap TwistTag.E6 L)))^[3] u = u) :
    E6ThreeModel.IsLang Fr (u * g) := by
  let P : ModGL Tag.E6 L := diagramMap TwistTag.E6 L
  let F₀ := frobTwistGL Tag.E6 L 2 e P
  have hF3 : ∀ x, (⇑F₀)^[3] x = twistE6 L Fr x := by
    intro x
    simpa [F₀, P] using ggL45E67_frame_iterate_three (L := L) (e := e) Fr hFr x
  have hn0 := ggL45E67_frame_n0 (L := L) (e := e)
  have hF0n0 : F₀ (TwistedDiag.n0 L) = TwistedDiag.n0 L := by
    simpa [F₀, P] using hn0.1
  have hn0sq : TwistedDiag.n0 L * TwistedDiag.n0 L = 1 := hn0.2
  have hFFg : F₀ (F₀ g) = g := by
    calc F₀ (F₀ g) = F₀ (g * TwistedDiag.n0 L) := by rw [hFg]
      _ = F₀ g * F₀ (TwistedDiag.n0 L) := by rw [map_mul]
      _ = (g * TwistedDiag.n0 L) * TwistedDiag.n0 L := by rw [hFg, hF0n0]
      _ = g := by rw [mul_assoc, hn0sq, mul_one]
  have hF2g : (⇑F₀)^[2] g = g := by
    rw [show (2 : ℕ) = 1 + 1 by norm_num, Function.iterate_succ_apply']
    simpa using hFFg
  have hF3g : (⇑F₀)^[3] g = g * TwistedDiag.n0 L := by
    rw [show (3 : ℕ) = 2 + 1 by norm_num, Function.iterate_succ_apply', hF2g, hFg]
  refine ⟨Subgroup.mul_mem _ hu hg, ?_⟩
  calc (u * g)⁻¹ * twistE6 L Fr (u * g)
      = (u * g)⁻¹ * (⇑F₀)^[3] (u * g) := by rw [← hF3]
    _ = (u * g)⁻¹ * ((⇑F₀)^[3] u * (⇑F₀)^[3] g) := by rw [iterate_map_mul]
    _ = (u * g)⁻¹ * (u * (g * TwistedDiag.n0 L)) := by rw [hu3, hF3g]
    _ = TwistedDiag.n0 L := by group

