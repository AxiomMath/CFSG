  decide +kernel

theorem h4b_mu : ∀ j : Fin 60, h4bTab.coroot j 0 = 0 →
    (fun l => h4bTab.root j (h4Perm.symm l)) = (sgnR (h4bMuS j) : ZAl) • h3Tab.root (h4bMu j) ∧
      (fun l => h4bTab.coroot j (h4Perm.symm l)) =
        (sgnR (h4bMuS j) : ZAl) • h3Tab.coroot (h4bMu j) := by
  decide +kernel

