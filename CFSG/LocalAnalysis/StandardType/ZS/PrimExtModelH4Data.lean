    reflZ (h4bTab.root 21) (h4bTab.coroot 21) = diagZ 1 ∧
    reflZ (h4bTab.root 18) (h4bTab.coroot 18) = diagZ 2 ∧
    reflZ (h4bTab.root 59) (h4bTab.coroot 59) = diagZ 3 := by
  decide +kernel

