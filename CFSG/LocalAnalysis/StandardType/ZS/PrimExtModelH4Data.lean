theorem h4bTab_gen : ∀ k : Fin 5,
    reflZ (h4bTab.root (h4bTab.gen k)) (h4bTab.coroot (h4bTab.gen k)) = h4bG k := by
  decide +kernel

theorem h4bTab_form : ∀ k : Fin 5,
    (∑ i, h4bD i * h4bTab.root (h4bTab.gen k) i ^ 2) • h4bTab.coroot (h4bTab.gen k) =
      (4 : ZAl) • fun i => h4bD i * h4bTab.root (h4bTab.gen k) i := by
  decide +kernel

