theorem j34Tab_valid : j34Tab.Valid GoodGa :=
  ⟨by decide +kernel, by decide +kernel, by decide +kernel, by decide +kernel,
    by decide +kernel⟩

theorem j34Tab_gen : ∀ k : Fin 4,
    reflZ (j34Tab.root (j34Tab.gen k)) (j34Tab.coroot (j34Tab.gen k)) = j34G k := by
  decide +kernel

theorem j34Tab_wit : ∀ j, (∀ i ∉ ({0, 1} : Finset (Fin 4)), j34Tab.root j i = 0) →
    (∀ i ∉ ({0, 1} : Finset (Fin 4)), j34Tab.root (j34Wit j) i = 0) ∧
      dotProduct (j34Tab.coroot j) (j34Tab.root (j34Wit j)) = 0 ∧
      j34Tab.cls (j34Wit j) = j34Tab.cls 0 := by
  decide +kernel

theorem j34Tab_diag : reflZ (j34Tab.root 0) (j34Tab.coroot 0) = diagZ 0 ∧
    reflZ (j34Tab.root 1) (j34Tab.coroot 1) = diagZ 1 ∧
    reflZ (j34Tab.root 3) (j34Tab.coroot 3) = diagZ 2 := by
  decide +kernel

theorem j34_pt_act : ∀ (k : Fin 4) (x : Fin 43),
    (2 : ZGa) • j34Pt x - dotProduct (j34Tab.coroot (j34Tab.gen k)) (j34Pt x) •
      j34Tab.root (j34Tab.gen k) = (2 : ZGa) • j34Pt (j34Pi k x) := by
  decide +kernel

theorem j34_pt_ne : ∀ x y : Fin 43, x ≠ y → ∃ l, GoodGa (j34Pt x l - j34Pt y l) := by
  decide +kernel

theorem j34_orb_nxt : ∀ (k : Fin 4) (i : Fin 336),
    j34Orb (j34Nxt k i) = fun l => j34Pi k (j34Orb i l) := by
  decide +kernel

theorem j34_orb_pred : ∀ i : Fin 336, i = 0 ∨
    (j34Pred i < i ∧ j34Orb i = fun l => j34Pi (j34Pk i) (j34Orb (j34Pred i) l)) := by
  decide +kernel

theorem j34_orb_key : CFSG.Decide.bitsetNodup ((List.ofFn j34Orb).map fun t =>
    CFSG.Decide.finFunKey fun l : Fin 3 => t l.castSucc) = true := by
  decide +kernel

theorem j34_span : ∀ i : Fin 4,
    ∑ l, j34Span i l • j34Pt (j34Orb 0 l) = (2 : ZGa) ^ 1 • Pi.single i 1 := by
  decide +kernel

