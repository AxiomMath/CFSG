private theorem gkb3_mem_normalizer_zpowers {G : Type*} [Group G] [Finite G] {g z : G}
    (h : g * z * g⁻¹ ∈ Subgroup.zpowers z) :
    g ∈ Subgroup.normalizer (Subgroup.zpowers z : Set G) := by
  refine Subgroup.mem_normalizer_fintype fun m hm => ?_
  obtain ⟨e, rfl⟩ := Subgroup.mem_zpowers_iff.1 hm
  have : g * z ^ e * g⁻¹ = (g * z * g⁻¹) ^ e := (conj_zpow).symm
  rw [this]
  exact Subgroup.zpow_mem _ h e

private theorem gkb3_conj_cases {G : Type*} [Group G] {z s : G} (hz : z ^ 3 = 1) (hz1 : z ≠ 1)
    (hs : s * z * s⁻¹ ∈ Subgroup.zpowers z) : s * z * s⁻¹ = z ∨ s * z * s⁻¹ = z ^ 2 := by
  obtain ⟨e, he⟩ := Subgroup.mem_zpowers_iff.1 hs
  rw [zpow_eq_zpow_emod' e hz] at he
  have h3 : e % ((3 : ℕ) : ℤ) = 0 ∨ e % ((3 : ℕ) : ℤ) = 1 ∨ e % ((3 : ℕ) : ℤ) = 2 := by omega
  rcases h3 with h0 | h0 | h0
  · exfalso
    rw [h0, zpow_zero] at he
    apply hz1
    have : z = s⁻¹ * (s * z * s⁻¹) * s := by group
    rw [this, ← he]
    group
  · left
    rw [h0, zpow_one] at he
    exact he.symm
  · right
    rw [h0] at he
    simpa using he.symm

private theorem gkb3_sq_commute {G : Type*} [Group G] {z s : G} (hz : z ^ 3 = 1) (hz1 : z ≠ 1)
    (hs : s * z * s⁻¹ ∈ Subgroup.zpowers z) : s ^ 2 * z = z * s ^ 2 := by
  rcases gkb3_conj_cases hz hz1 hs with h | h
  · have h1 : Commute s z := mul_inv_eq_iff_eq_mul.1 h
    exact (h1.pow_left 2).eq
  · have h4 : z ^ 4 = z := by
      rw [show (4 : ℕ) = 3 + 1 by norm_num, pow_add, hz, one_mul, pow_one]
    have h2 : s * z ^ 2 * s⁻¹ = z := by
      calc s * z ^ 2 * s⁻¹ = (s * z * s⁻¹) ^ 2 := (conj_pow).symm
        _ = (z ^ 2) ^ 2 := by rw [h]
        _ = z := by rw [← pow_mul]; exact h4
    have h5 : s ^ 2 * z * (s ^ 2)⁻¹ = z := by
      calc s ^ 2 * z * (s ^ 2)⁻¹ = s * (s * z * s⁻¹) * s⁻¹ := by
            simp only [pow_two, mul_inv_rev, mul_assoc]
        _ = s * z ^ 2 * s⁻¹ := by rw [h]
        _ = z := h2
    exact mul_inv_eq_iff_eq_mul.1 h5

private theorem gkb3_pgroup_centralizes {G : Type*} [Group G] {z s : G} (hz : z ^ 3 = 1)
    (hz1 : z ≠ 1) (hs : s * z * s⁻¹ ∈ Subgroup.zpowers z) {k : ℕ} (hsk : s ^ (3 ^ k) = 1) :
    s * z = z * s := by
  have hodd : Odd (3 ^ k) := Odd.pow (by decide)
  obtain ⟨m, hm⟩ := hodd
  have hs1 : s = (s ^ 2) ^ (m + 1) := by
    rw [← pow_mul]
    calc s = s ^ (3 ^ k) * s := by rw [hsk, one_mul]
      _ = s ^ (3 ^ k + 1) := by rw [pow_succ]
      _ = s ^ (2 * (m + 1)) := by rw [hm]; ring_nf
  have hc : Commute (s ^ 2) z := gkb3_sq_commute hz hz1 hs
  have := (hc.pow_left (m + 1)).eq
  rw [← hs1] at this
  exact this

private theorem gkb3_F1F4_of_heis {G : Type} [Group G] [Finite G] {n : ℕ} {x y : Fin n → G}
    {z : G} (h : HeisCfg 3 n x y z) (hy3 : ∀ i, y i ^ 3 = 1) (hn : 0 < n) (L : Subgroup G)
    (hQL : heisSub x y ≤ L) (hLN : L ≤ Subgroup.normalizer (heisSub x y : Set G))
    (hLz : ∀ l ∈ L, l * z * l⁻¹ ∈ Subgroup.zpowers z)
    (hL3 : (Nat.card G).factorization 3 ≤ (Nat.card L).factorization 3)
    (hCQ : ∀ P : Subgroup G, P ≤ Subgroup.centralizer (heisSub x y : Set G) → IsPGroup 3 P →
      Nat.card P ≤ 3)
    (hdich : ∀ N : Subgroup G, N ≤ heisSub x y →
      (∀ a ∈ L, a ^ 60 ∈ Subgroup.normalizer (N : Set G)) →
        N ≤ Subgroup.zpowers z ∨ N = heisSub x y)
    (hg1 : LargeEvenPPrimeCore 3 ↥(Subgroup.centralizer ({z} : Set G)) = ⊥)
    (hno : ∀ C : Subgroup G, ¬ LargeEvenPComponent 3 (Subgroup.centralizer ({z} : Set G)) C) :
    BMPCentralF1At 3 z ∧ BMPCentralF4At 3 z := by
  haveI hp3 : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hz3 := h.zp
  have hz1 := h.z1
  have hzo : orderOf z = 3 := orderOf_eq_prime hz3 hz1
  obtain ⟨S, hS⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 L
  have hSL : S ≤ L := hS.le
  have hSp : IsPGroup 3 S := hS.isPGroup
  have hQp : IsPGroup 3 (heisSub x y) :=
    IsPGroup.of_card (n := 2 * n + 1) (card_heisSub h hy3 hn)
  have hQS : heisSub x y ≤ S := by
    obtain ⟨P, rfl⟩ := hS
    haveI : ((heisSub x y).subgroupOf L).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hQL).mpr hLN
    have hp' : IsPGroup 3 ((heisSub x y).subgroupOf L) :=
      hQp.of_equiv (Subgroup.subgroupOfEquivOfLe hQL).symm
    have hle : (heisSub x y).subgroupOf L ≤ (P : Subgroup L) := IsPGroup.le_sylow_of_normal hp' P
    intro q hq
    exact Subgroup.mem_map.mpr ⟨⟨q, hQL hq⟩, hle (Subgroup.mem_subgroupOf.mpr hq), rfl⟩
  have hScard : Nat.card S = 3 ^ (Nat.card G).factorization 3 := by
    rw [hS.card_eq]
    have hdvd : Nat.card L ∣ Nat.card G := Subgroup.card_subgroup_dvd_card L
    have hle : (Nat.card L).factorization 3 ≤ (Nat.card G).factorization 3 :=
      (Nat.factorization_le_iff_dvd Nat.card_pos.ne' Nat.card_pos.ne').2 hdvd 3
    rw [le_antisymm hle hL3]
  have hSc : S ≤ Subgroup.centralizer ({z} : Set G) := by
    intro s hs
    obtain ⟨k, hk⟩ := hSp ⟨s, hs⟩
    exact Subgroup.mem_centralizer_singleton_iff.2
      (gkb3_pgroup_centralizes hz3 hz1 (hLz s (hSL hs)) (k := k)
        (by simpa using congrArg Subtype.val hk))
  have hzS : Subgroup.zpowers z ≤ S :=
    (Subgroup.zpowers_le.2 (z_mem h hn)).trans hQS
  have hQexp := heisSub3_pow_three h hy3 hn
  have hQcomm := heisSub3_commutator h hy3 hn
  have hQcent := heisSub3_inf_centralizer h hy3 hn
  have hzC : Subgroup.zpowers z ≤ Subgroup.centralizer (heisSub x y : Set G) :=
    hQcent.symm.le.trans inf_le_right
  have hCS : S ⊓ Subgroup.centralizer (heisSub x y : Set G) = Subgroup.zpowers z := by
    have hz' : Subgroup.zpowers z ≤ S ⊓ Subgroup.centralizer (heisSub x y : Set G) :=
      le_inf hzS hzC
    have hP3 : IsPGroup 3 ↥(S ⊓ Subgroup.centralizer (heisSub x y : Set G)) :=
      hSp.to_le (inf_le_left : S ⊓ Subgroup.centralizer (heisSub x y : Set G) ≤ S)
    have hc := hCQ (S ⊓ Subgroup.centralizer (heisSub x y : Set G))
      (inf_le_right : S ⊓ Subgroup.centralizer (heisSub x y : Set G) ≤ _) hP3
    have hcard : Nat.card ↥(S ⊓ Subgroup.centralizer (heisSub x y : Set G)) ≤
        Nat.card ↥(Subgroup.zpowers z) := by
      rw [Nat.card_zpowers, hzo]
      exact hc
    exact (Subgroup.eq_of_le_of_card_ge hz' hcard).symm
  have hirr : ∀ R : Subgroup G, Subgroup.zpowers z ≤ R → R ≤ heisSub x y →
      (∀ g ∈ Subgroup.centralizer ({z} : Set G) ⊓
        Subgroup.normalizer (heisSub x y : Set G), ∀ r ∈ R, g * r * g⁻¹ ∈ R) →
      R = Subgroup.zpowers z ∨ R = heisSub x y := by
    intro R hzR hRQ hinv
    have hn60 : ∀ a ∈ L, a ^ 60 ∈ Subgroup.normalizer (R : Set G) := by
      intro a ha
      have hcomm : Commute (a ^ 2) z := gkb3_sq_commute hz3 hz1 (hLz a ha)
      have hc : a ^ 60 ∈ Subgroup.centralizer ({z} : Set G) := by
        have : a ^ 60 = (a ^ 2) ^ 30 := by rw [← pow_mul]
        rw [this]
        exact Subgroup.mem_centralizer_singleton_iff.2 (hcomm.pow_left 30).eq
      have hq : a ^ 60 ∈ Subgroup.normalizer (heisSub x y : Set G) :=
        Subgroup.pow_mem _ (hLN ha) 60
      exact Subgroup.mem_normalizer_fintype fun r hr => hinv (a ^ 60) ⟨hc, hq⟩ r hr
    rcases hdich R hRQ hn60 with h1 | h1
    · exact Or.inl (le_antisymm h1 hzR)
    · exact Or.inr h1
  exact bmPCentralF1At_F4At_of_pLocal Nat.prime_three hzo hSp hScard hSc hQS
    (hSL.trans hLN) hQexp hQcomm hQcent hCS hirr hg1 hno

theorem ggSporK_bThree_F1F4_z
    :
    ∃ z : NativeSporadic.B, orderOf z = 3 ∧ rk z = 2916 ∧
      ((∀ C : Subgroup NativeSporadic.B,
          ¬ LargeEvenPComponent 3 (Subgroup.centralizer ({z} : Set NativeSporadic.B)) C) →
        BMPCentralF1At 3 z ∧ BMPCentralF4At 3 z) := by
  obtain ⟨x, y, z, g, hH, hy3, hgx, hgy, hgz, hrk⟩ := bNF_holds
  haveI : Finite NativeSporadic.B := CFSG.Monster.B.Pinned.finite_B
  have hn : 0 < 4 := by norm_num
  have hz3 : z ^ 3 = 1 := hH.zp
  have hzo : orderOf z = 3 := orderOf_z hH
  refine ⟨z, hzo, hrk, fun hno => ?_⟩
  have hdX : ∀ (k : Fin 2) (j : Fin 4), ∀ i < 9,
      (nfXData.getD (4 * k.val + j.val) []).getD i 0 < 3 := by decide +kernel
  have hdY : ∀ (k : Fin 2) (j : Fin 4), ∀ i < 9,
      (nfYData.getD (4 * k.val + j.val) []).getD i 0 < 3 := by decide +kernel
  set Q := heisSub x y with hQ
  have hgxQ : ∀ k j, g k * x j * (g k)⁻¹ ∈ Q := fun k j => by
    rw [hgx k j, nfProd_eq_heisNF _ _ _ _ (hdX k j)]
    exact heisNF_mem hH hn _ _
  have hgyQ : ∀ k j, g k * y j * (g k)⁻¹ ∈ Q := fun k j => by
    rw [hgy k j, nfProd_eq_heisNF _ _ _ _ (hdY k j)]
    exact heisNF_mem hH hn _ _
  have hgN : ∀ k, g k ∈ Subgroup.normalizer (Q : Set NativeSporadic.B) := fun k =>
    mem_normalizer_of_conj_mem (hgxQ k) (hgyQ k)
  have hmat : ∀ k : Fin 2, heisMat hH hy3 (g k) = tMat k.val := fun k =>
    heisMat_eq_of_nf hH hy3 hn (tMat k.val)
      (fun j => ⟨_, by
        rw [hgx k j, nfProd_eq_heisNF _ _ _ _ (hdX k j)]
        congr 1
        funext i
        simp [tMat]⟩)
      (fun j => ⟨_, by
        rw [hgy k j, nfProd_eq_heisNF _ _ _ _ (hdY k j)]
        congr 1
        funext i
        simp [tMat]⟩)
  have hmat0 : heisMat hH hy3 (g 0) = tA := by
    have h0 := hmat 0
    simp only [Fin.val_zero] at h0
    rw [h0, tMat_zero]
  have hmat1 : heisMat hH hy3 (g 1) = tB := by
    have h1 := hmat 1
    simp only [Fin.val_one] at h1
    rw [h1, tMat_one]
  set L : Subgroup NativeSporadic.B :=
    Subgroup.closure (Set.range g ∪ (Set.range x ∪ Set.range y)) with hL
  have hQL : Q ≤ L := Subgroup.closure_mono Set.subset_union_right
  have hxQ : ∀ i, x i ∈ Q := fun i => Subgroup.subset_closure (Or.inl ⟨i, rfl⟩)
  have hyQ : ∀ i, y i ∈ Q := fun i => Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)
  have hLN : L ≤ Subgroup.normalizer (Q : Set NativeSporadic.B) := by
    rw [hL, Subgroup.closure_le]
    rintro _ (⟨k, rfl⟩ | ⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact hgN k
    · exact Subgroup.le_normalizer (hxQ i)
    · exact Subgroup.le_normalizer (hyQ i)
  have hgL : ∀ k, g k ∈ L := fun k => Subgroup.subset_closure (Or.inl ⟨k, rfl⟩)
  have hHim : sylH ≤ (heisRepL hH hy3 hn L hLN).range := by
    refine sylH_le.trans ((Subgroup.closure_le _).2 ?_)
    rintro _ (rfl | rfl)
    · exact mem_range_heisRepL hH hy3 hn L hLN (hgL 0) (by rw [hmat0]; rfl)
    · exact mem_range_heisRepL hH hy3 hn L hLN (hgL 1) (by rw [hmat1]; rfl)
  have hG3 : (Nat.card NativeSporadic.B).factorization 3 ≤ 2 * 4 + 1 + 4 := by
    rw [factorization_card_B_three]
  have hCQ := hCQ_of_image hH hy3 hn L hQL hLN 4 sylH hHim card_sylH hG3
