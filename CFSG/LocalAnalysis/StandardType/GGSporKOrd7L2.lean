private theorem lr2osm_pslTwoArith (q f : ℕ) (hf : f ≠ 0) (h7 : ¬ 7 ∣ f) (hq : 2 ≤ q) :
    (q * (q ^ 2 - 1) * f).factorization 7 ≤
      (q * (q ^ 2 - 1) / Nat.gcd 2 (q - 1)).factorization 7 := by
  let g := Nat.gcd 2 (q - 1)
  have hg2 : g ∣ 2 := Nat.gcd_dvd_left 2 (q - 1)
  have hg0 : g ≠ 0 := by
    intro h
    rw [h] at hg2
    norm_num at hg2
  have hg_dvd : g ∣ q * (q ^ 2 - 1) := by
    have h1 : g ∣ q - 1 := Nat.gcd_dvd_right 2 (q - 1)
    have h2 : q - 1 ∣ q ^ 2 - 1 := by
      rw [pow_two, mul_self_tsub_one]
      exact dvd_mul_left (q - 1) (q + 1)
    exact (h1.trans h2).trans (dvd_mul_left (q ^ 2 - 1) q)
  have hn0 : q * (q ^ 2 - 1) ≠ 0 := by
    have hq0 : 0 < q := by omega
    have hq21 : 0 < q ^ 2 - 1 := by
      have : 1 < q ^ 2 := by nlinarith
      omega
    exact (Nat.mul_pos hq0 hq21).ne'
  have hng0 : q * (q ^ 2 - 1) / g ≠ 0 := by
    intro h0
    have : q * (q ^ 2 - 1) = 0 := by
      rw [← Nat.div_mul_cancel hg_dvd, h0, zero_mul]
    exact hn0 this
  have h7g : ¬ 7 ∣ g := by
    intro h
    have h72 : 7 ∣ 2 := h.trans hg2
    norm_num at h72
  have h7f : f.factorization 7 = 0 := Nat.factorization_eq_zero_of_not_dvd h7
  have hfac : (q * (q ^ 2 - 1) * f).factorization 7 =
      (q * (q ^ 2 - 1) / g).factorization 7 := by
    calc
      (q * (q ^ 2 - 1) * f).factorization 7
          = (q * (q ^ 2 - 1)).factorization 7 + f.factorization 7 := by
              rw [Nat.factorization_mul hn0 hf, Finsupp.add_apply]
      _ = (q * (q ^ 2 - 1)).factorization 7 := by rw [h7f, add_zero]
      _ = ((q * (q ^ 2 - 1) / g) * g).factorization 7 := by
              conv_lhs => rw [← Nat.div_mul_cancel hg_dvd]
      _ = (q * (q ^ 2 - 1) / g).factorization 7 + g.factorization 7 := by
              rw [Nat.factorization_mul hng0 hg0, Finsupp.add_apply]
      _ = (q * (q ^ 2 - 1) / g).factorization 7 := by
              rw [Nat.factorization_eq_zero_of_not_dvd h7g, add_zero]
  exact le_of_eq hfac

theorem ord7Param_PSL_two {p f : ℕ} (hp : p.Prime) (h7 : ¬ 7 ∣ f) : Ord7Param .PSL 2 p f := by
  intro R _ _ _hR hmodel
  haveI : Fact p.Prime := ⟨hp⟩
  have hf : 1 ≤ f := hmodel.admissible.2.1
  have hClass : StatedClassicalModel R .PSL 2 p f :=
    hmodel.statedClassicalModel_of_ne_zero (by norm_num)
  obtain ⟨e⟩ := CFSG.LocalAnalysis.GLTheoremA.small_psl_iso hf hClass
  have hAut : Nat.card (MulAut R) = p ^ f * ((p ^ f) ^ 2 - 1) * f :=
    CFSG.LocalAnalysis.GLTheoremA.small_card_aut_psl hf e
  have hR : Nat.card R = p ^ f * ((p ^ f) ^ 2 - 1) / Nat.gcd 2 (p ^ f - 1) := by
    have hLie : Nat.card R = CFSG.Open.ordA 1 (p ^ f) :=
      (hmodel.card_eq_lieOrd (by norm_num)).trans rfl
    rw [hLie, CFSG.GH74.Generic.S3.L3Ord.ordA_one]
  have hq2 : 2 ≤ p ^ f := by
    have hp2 : 2 ≤ p := hp.two_le
    have hle : p ≤ p ^ f := le_self_pow hp.one_lt.le (by omega)
    omega
  rw [hAut, hR]
  exact lr2osm_pslTwoArith (p ^ f) f (by omega) h7 hq2

