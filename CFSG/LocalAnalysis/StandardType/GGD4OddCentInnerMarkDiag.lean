private noncomputable def d1_restrict {X : Type*} [Group X] (J : Subgroup X) (a : MulAut X)
    (ha : ∀ j : X, a j ∈ J ↔ j ∈ J) : MulAut ↥J where
  toFun j := ⟨a j, (ha j).2 j.2⟩
  invFun j := ⟨a⁻¹ j, (ha (a⁻¹ j)).1 (by simp)⟩
  left_inv j := Subtype.ext (by simp)
  right_inv j := Subtype.ext (by simp)
  map_mul' j k := Subtype.ext (by simp [map_mul])

private theorem d1_key {n : ℕ} (hK : Nat.card K = 2 ^ n) (hn : Odd n) (hn3 : 3 ≤ n)
    {s : Om8 K} (hs3 : s ^ 3 = 1) (hd : D4Rank.omFixDim s = 2)
    (hperf : commutator ↥(centDer s) = ⊤)
    {A : Subgroup (MulAut (Om8 K))} (hAJ : ∀ a ∈ A, ∀ j ∈ centDer s, a j ∈ centDer s)
    {E : Type} [Field E] {m : ℕ} (hm : 2 ≤ m) (hE : Nat.card E = (2 ^ m) ^ 2)
    (hm3 : 3 ∣ 2 ^ m + 1)
    (θ : ↥(centDer s) ⧸ Subgroup.center ↥(centDer s) ≃*
      LargeEvenProj (LargeEvenSUGroup (Fin 3) E (2 ^ m)))
    (hind : GGAutsInduceOn A (centDer s) θ
      (LargeEvenMatConjImage (LargeEvenProjMk (LargeEvenSUGroup (Fin 3) E (2 ^ m)))
        (LargeEvenGUSet (Fin 3) E (2 ^ m)))) :
    InnDiagOn A s (centDer s) := by
  obtain ⟨E₀, _, h₀, ι, hιC, hιJ, hιsurj, hιinj⟩ := d1_exists_model hK hn hn3 hs3 hd
  have hE' : UnitaryFieldData 2 m E :=
    ⟨Nat.prime_two, by omega, by rw [hE, ← pow_mul, Nat.mul_comm]⟩
  have hn3' : 3 ∣ 2 ^ n + 1 := by simpa using Odd.nat_add_dvd_pow_add_pow 2 1 hn
  have hq₀ : 2 < 2 ^ n := by
    have h8 : 2 ^ 3 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn3
    omega
  have hq : 2 < 2 ^ m := by
    have h4 : 2 ^ 2 ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) hm
    omega
  let f : ↥(unitarySU 2 n E₀ 3) →* ↥(centDer s) :=
    (ι.comp (Subgroup.inclusion (unitarySU_le_unitaryIsom3 (h := h₀)))).codRestrict (centDer s)
      fun g => hιJ g
  have hf : Function.Bijective f := by
    refine ⟨fun g g' hgg' => ?_, fun y => ?_⟩
    · have h1 := hιinj (congrArg Subtype.val hgg')
      exact Subgroup.inclusion_injective (unitarySU_le_unitaryIsom3 (h := h₀)) h1
    · obtain ⟨g, hg⟩ := hιsurj y y.2
      exact ⟨g, Subtype.ext hg⟩
  let κ : ↥(unitarySU 2 n E₀ 3) ≃* ↥(centDer s) := MulEquiv.ofBijective f hf
  have hκ : ∀ g : ↥(unitarySU 2 n E₀ 3),
      ((κ g : ↥(centDer s)) : Om8 K) = ι ⟨g, unitarySU_le_unitaryIsom3 g.2⟩ := fun g => rfl
  intro a ha
  have hres : ∀ j : Om8 K, a j ∈ centDer s ↔ j ∈ centDer s := fun j =>
    ⟨fun h => by simpa using hAJ a⁻¹ (A.inv_mem ha) (a j) h, fun h => hAJ a ha j h⟩
  set α := d1_restrict (centDer s) a hres
  obtain ⟨φ, hφI, hφind⟩ := hind a ha
  have hφeq : φ = ggInducedAut θ α := by
    ext x
    obtain ⟨q, rfl⟩ := θ.surjective x
    obtain ⟨j, rfl⟩ := QuotientGroup.mk_surjective q
    calc φ (θ (QuotientGroup.mk j))
        = θ (QuotientGroup.mk (α j)) := hφind j (α j) rfl
      _ = ggInducedAut θ α (θ (QuotientGroup.mk j)) := (ggInducedAut_apply θ α j).symm
  rw [hφeq] at hφI
  obtain ⟨A₀, hA₀⟩ := d1_exists_suConj hperf h₀ hn3' hq₀ κ hE' hm3 hq θ hφI
  refine ⟨ι A₀, hιC A₀, fun j hj => ?_⟩
  obtain ⟨g, hg⟩ := hιsurj j hj
  have hsu : (⟨(suConj h₀ A₀ g : GL (Fin 3) E₀), unitarySU_le_unitaryIsom3 (suConj h₀ A₀ g).2⟩ :
      ↥(unitaryIsom3 h₀)) = A₀ * ⟨g, unitarySU_le_unitaryIsom3 g.2⟩ * A₀⁻¹ :=
    Subtype.ext (coe_suConj A₀ g)
  calc a j = ((α (κ g) : ↥(centDer s)) : Om8 K) := by
        show a j = a ((κ g : ↥(centDer s)) : Om8 K)
        rw [hκ, hg]
    _ = ((κ (suConj h₀ A₀ g) : ↥(centDer s)) : Om8 K) := by rw [hA₀]
    _ = ι A₀ * j * (ι A₀)⁻¹ := by rw [hκ, hsu, map_mul, map_mul, map_inv, hg]

end Leaf

variable {K : Type} [Field K] [Finite K] [CharP K 2]

theorem innDiagOn_of_ggAutsInduceOn {n : ℕ} (hK : Nat.card K = 2 ^ n) (hn : Odd n) (hn3 : 3 ≤ n)
    {s : Om8 K} (hs3 : s ^ 3 = 1) (hd : D4Rank.omFixDim s = 2) {J : Subgroup (Om8 K)}
    (hJ : IsComponentOf J (ggAutFixedSubgroup (MulAut.conj s)))
    {A : Subgroup (MulAut (Om8 K))} (hAJ : ∀ a ∈ A, ∀ j ∈ J, a j ∈ J) :
    GGMarkingAll (K := ↥J) fun lab _ _ I _ θ =>
      (GGLabelA2 lab ∧ lab.tag = .twA) → GGAutsInduceOn A J θ I → InnDiagOn A s J := by
  obtain rfl := eq_centDer_of_isComponentOf hK hn hn3 hs3 hd hJ
  intro P hP
  obtain ⟨hX, lab, hlab, hraw⟩ := hP
  refine ⟨hX, lab, hlab, ?_⟩
  by_cases hs : GGLabelA2 lab ∧ lab.tag = .twA
  · obtain ⟨t, l, m⟩ := lab
    obtain ⟨⟨hl, hm, hrow⟩, htw⟩ := hs
    dsimp only at hl hm hrow htw
    subst hl
    subst htw
    have hm3 : 3 ∣ 2 ^ m + 1 := by
      rcases hrow with hA | htwA
      · exact absurd hA.1 (by decide)
      · exact htwA.2
    obtain ⟨E, _, _, hE, hsi, hna, θ, hθ⟩ := hraw
    exact ⟨E, inferInstance, inferInstance, hE, hsi, hna, θ, hθ, fun _ hind =>
      d1_key hK hn hn3 hs3 hd hX hAJ hm hE hm3 θ hind⟩
  · refine largeEvenRawDatum_mono ?_ hraw
    rintro R _ I F ⟨hsi, hna, θ, hθ⟩
    exact ⟨hsi, hna, θ, hθ, fun h => absurd h hs⟩

end D4Inner

