private theorem d1_congr_apply {X Y : Type*} [Group X] [Group Y] (e : X ≃* Y) (f : MulAut X)
    (y : Y) : (MulAut.congr e f) y = e (f (e.symm y)) := rfl

private noncomputable def d1_psuEquiv {E : Type} [Field E] {m : ℕ} (h : UnitaryFieldData 2 m E) :
    unitaryPSU h 3 ≃* LargeEvenProj (LargeEvenSUGroup (Fin 3) E (2 ^ m)) :=
  unitaryPSUEquiv h (by norm_num : 1 ≤ 3)

private theorem d1_exists_psuConj_of_mem {E : Type} [Field E] {m : ℕ}
    (h : UnitaryFieldData 2 m E) {x : MulAut (LargeEvenProj (LargeEvenSUGroup (Fin 3) E (2 ^ m)))}
    (hx : x ∈ LargeEvenMatConjImage (LargeEvenProjMk (LargeEvenSUGroup (Fin 3) E (2 ^ m)))
      (LargeEvenGUSet (Fin 3) E (2 ^ m))) :
    ∃ A : ↥(unitaryIsom3 h), MulAut.congr (d1_psuEquiv h) (psuConj h A) = x := by
  suffices hs : ∃ A : ↥(unitaryIsom3 h),
      MulAut.congr (unitaryPSUEquiv h (by norm_num : 1 ≤ 3)) (psuConj h A) = x from hs
  set e := unitaryPSUEquiv h (by norm_num : 1 ≤ 3)
  obtain ⟨M, hM, hgraph⟩ := hx
  obtain ⟨u, hu⟩ := TableBU63.exists_unitary_of_gu h hM
  have hA : (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M : GL (Fin 3) E) ∈ unitaryIsom3 h := by
    rw [mem_unitaryIsom3]
    have hmem := (mem_primeFormUnitary.mp hu)
    simpa only [idGram, Units.val_one, Matrix.mul_one] using hmem
  refine ⟨⟨Matrix.GeneralLinearGroup.scalar (Fin 3) u * M, hA⟩, ?_⟩
  refine MulEquiv.ext fun z => QuotientGroup.induction_on z fun g => ?_
  rw [d1_congr_apply]
  have hes : e.symm (QuotientGroup.mk g :
        CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ m) E)) = (g : unitaryPSU h 3) := by
    have h1 : (QuotientGroup.mk g : CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ m) E)) =
        e (unitaryProj h 3 g) :=
      (unitaryPSUEquiv_unitaryProj h (by norm_num : 1 ≤ 3) g).symm
    rw [h1, MulEquiv.symm_apply_apply]
    rfl
  rw [hes, psuConj_mk]
  have hemk : e ((suConj h ⟨Matrix.GeneralLinearGroup.scalar (Fin 3) u * M, hA⟩ g :
        unitarySU 2 m E 3) : unitaryPSU h 3) =
      (QuotientGroup.mk (suConj h ⟨Matrix.GeneralLinearGroup.scalar (Fin 3) u * M, hA⟩ g) :
        LargeEvenProj (LargeEvenSUGroup (Fin 3) E (2 ^ m))) :=
    unitaryPSUEquiv_unitaryProj h (by norm_num : 1 ≤ 3) _
  rw [hemk]
  have hrel : (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M) * (g : GL (Fin 3) E) *
      (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M)⁻¹ = M * (g : GL (Fin 3) E) * M⁻¹ := by
    rw [show (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M) * (g : GL (Fin 3) E) *
          (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M)⁻¹ =
        Matrix.GeneralLinearGroup.scalar (Fin 3) u * (M * (g : GL (Fin 3) E) * M⁻¹) *
          (Matrix.GeneralLinearGroup.scalar (Fin 3) u)⁻¹ by group]
    rw [(TypeA.PGLTor.commute_scalar u (M * (g : GL (Fin 3) E) * M⁻¹)).eq]
    group
  have hmem : (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M) * (g : GL (Fin 3) E) *
      (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M)⁻¹ ∈ LargeEvenSUGroup (Fin 3) E (2 ^ m) :=
    conj_mem_unitarySU hA g.2
  have hsu : (⟨(Matrix.GeneralLinearGroup.scalar (Fin 3) u * M) * (g : GL (Fin 3) E) *
        (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M)⁻¹, hmem⟩ :
        ↥(LargeEvenSUGroup (Fin 3) E (2 ^ m))) =
      suConj h ⟨Matrix.GeneralLinearGroup.scalar (Fin 3) u * M, hA⟩ g :=
    Subtype.ext (by rw [coe_suConj]; rfl)
  rw [← hsu]
  exact (hgraph g (⟨(Matrix.GeneralLinearGroup.scalar (Fin 3) u * M) * (g : GL (Fin 3) E) *
    (Matrix.GeneralLinearGroup.scalar (Fin 3) u * M)⁻¹, hmem⟩) hrel).symm

private theorem d1_exists_suConj {X : Type} [Group X] (hX : commutator X = ⊤)
    {E₀ : Type} [Field E₀] {n : ℕ} (h₀ : UnitaryFieldData 2 n E₀) (hn3 : 3 ∣ 2 ^ n + 1)
    (hq₀ : 2 < 2 ^ n) (κ : ↥(unitarySU 2 n E₀ 3) ≃* X)
    {E : Type} [Field E] {m : ℕ} (hE : UnitaryFieldData 2 m E) (hm3 : 3 ∣ 2 ^ m + 1)
    (hq : 2 < 2 ^ m)
    (θ : X ⧸ Subgroup.center X ≃* LargeEvenProj (LargeEvenSUGroup (Fin 3) E (2 ^ m)))
    {α : MulAut X}
    (hα : ggInducedAut θ α ∈ LargeEvenMatConjImage
      (LargeEvenProjMk (LargeEvenSUGroup (Fin 3) E (2 ^ m))) (LargeEvenGUSet (Fin 3) E (2 ^ m))) :
    ∃ A₀ : ↥(unitaryIsom3 h₀), ∀ g, α (κ g) = κ (suConj h₀ A₀ g) := by
  obtain ⟨A', hA'⟩ := d1_exists_psuConj_of_mem hE hα
  set eE := d1_psuEquiv hE
  have hA'' : ∀ r, ggInducedAut θ α r = eE (psuConj hE A' (eE.symm r)) := fun r =>
    (DFunLike.congr_fun hA' r).symm
  set κbar : unitaryPSU h₀ 3 ≃* X ⧸ Subgroup.center X :=
    (suCenterEquiv h₀ hq₀).symm.trans (centerQuotCongr κ)
  have hκ : ∀ g : unitarySU 2 n E₀ 3,
      κbar (g : unitaryPSU h₀ 3) = ((κ g : X) : X ⧸ Subgroup.center X) := fun g => rfl
  set β : unitaryPSU hE 3 ≃* unitaryPSU h₀ 3 := eE.trans (θ.symm.trans κbar.symm) with hβdef
  obtain ⟨A₀, hA₀⟩ :=
    CFSG.RankThree.PartTwo.Sec21.Item223CensusResProof.congr_mem_psuConj_range h₀ hE hn3 hm3 hq β
    (τ := psuConj hE A') ⟨A', rfl⟩
  refine ⟨A₀, fun g => ?_⟩
  have hβs : ∀ g : unitarySU 2 n E₀ 3, β.symm (g : unitaryPSU h₀ 3) =
      eE.symm (θ ((κ g : X) : X ⧸ Subgroup.center X)) := by
    intro g
    rw [hβdef, MulEquiv.symm_trans_apply, MulEquiv.symm_trans_apply, MulEquiv.symm_symm,
      MulEquiv.symm_symm, hκ]
  have hconj : ∀ y, β.symm (psuConj h₀ A₀ (β y)) = psuConj hE A' y := by
    intro y
    rw [hA₀, d1_congr_apply]
    simp only [MulEquiv.symm_apply_apply]
  have key : α = MulAut.congr κ (suConj h₀ A₀) := by
    apply ggInducedAut_injective_of_perfect hX θ
    refine MulEquiv.ext fun r => ?_
    obtain ⟨q, rfl⟩ := θ.surjective r
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨g, rfl⟩ := κ.surjective x
    rw [hA'', ggInducedAut_apply, d1_congr_apply κ, MulEquiv.symm_apply_apply, ← hconj,
      ← hβs g, MulEquiv.apply_symm_apply, psuConj_mk, hβs, MulEquiv.apply_symm_apply]
  rw [key, d1_congr_apply, MulEquiv.symm_apply_apply]

end Unitary

