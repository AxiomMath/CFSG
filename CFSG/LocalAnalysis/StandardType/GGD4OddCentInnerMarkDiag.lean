private theorem d1_exists_model {n : ℕ} (hK : Nat.card K = 2 ^ n) (hn : Odd n) (hn3 : 3 ≤ n)
    {s : Om8 K} (hs3 : s ^ 3 = 1) (hd : D4Rank.omFixDim s = 2) :
    ∃ (E₀ : Type) (_ : Field E₀) (h₀ : UnitaryFieldData 2 n E₀)
      (ι : ↥(unitaryIsom3 h₀) →* Om8 K),
      (∀ A, ι A ∈ Subgroup.centralizer ({s} : Set (Om8 K))) ∧
      (∀ g : ↥(unitarySU 2 n E₀ 3), ι ⟨g, unitarySU_le_unitaryIsom3 g.2⟩ ∈ centDer s) ∧
      (∀ y ∈ centDer s, ∃ g : ↥(unitarySU 2 n E₀ 3), ι ⟨g, unitarySU_le_unitaryIsom3 g.2⟩ = y) ∧
      Function.Injective ι := by
  classical
  have hreg :=
    CFSG.ComponentClassification.CatalogueBOrthogonalPointData.regular_coordinateQuadPlus 4 K
      (by norm_num)
  have hx : OddOrderIsometry (coordinateQuadPlus 4 K) 3
      ((omLift s : orthDerived (coordinateQuadPlus 4 K)) :
        (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) := oddOrderIsometry_omLift hs3 hd
  have hmem := phi_mem_primaryFactors_omLift hK hn hs3 hd
  have : Fact (Irreducible (X ^ 2 + X + 1 : K[X])) := ⟨irreducible_of_mem_primaryFactors hmem⟩
  have hm := primaryMultiplicity_phi_omLift hK hn hs3 hd
  have hn1 : 1 ≤ n := by omega
  have hmq : ¬(3 = 3 ∧ 2 ^ n = 2) := fun h => by
    have h8 : 2 ^ 3 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn3
    omega
  obtain ⟨hU, H, b, -, hb, hrange, hspec⟩ := exists_phiFrame hK hn1 hx rfl hmem hm le_rfl hmq
  have hsupp := supportedBlock_le_orthDerived hreg.1 hreg.2 hU b hb hrange hspec
  have hmap := map_blockSU_phiBlockEquiv hx hmem hU b hb hrange hsupp
  obtain ⟨Φb, hΦb⟩ : ∃ Φb, Φb = phiBlockEquiv hx hmem hU b hb hrange := ⟨_, rfl⟩
  rw [← hΦb] at hmap
  have hcomp := map_centDer_eq_componentImage_phi hK hn hn3 hs3 hd
  have heq : unitaryIsom3 hU =
      primeFormUnitary hU (oneGram (AdjoinRoot (X ^ 2 + X + 1 : K[X])) 3) := by
    ext A
    rw [mem_unitaryIsom3, mem_primeFormUnitary]
    simp only [oneGram, Units.val_one, Matrix.mul_one]
  let ι : ↥(unitaryIsom3 hU) →* Om8 K :=
    (omBridge (K := K)).symm.toMonoidHom.comp ((piOrth (coordinateQuadPlus 4 K)).comp
      ((Subgroup.inclusion hsupp).comp (Φb.toMonoidHom.comp
        (MulEquiv.subgroupCongr heq).toMonoidHom)))
  have hιapp : ∀ A, omBridge (ι A) = piOrth (coordinateQuadPlus 4 K)
      (Subgroup.inclusion hsupp (Φb (MulEquiv.subgroupCongr heq A))) := fun A =>
    MulEquiv.apply_symm_apply _ _
  refine ⟨AdjoinRoot (X ^ 2 + X + 1 : K[X]), inferInstance, hU, ι, fun A => ?_, fun g => ?_,
    fun y hy => ?_, ?_⟩
  ·
    rw [Subgroup.mem_centralizer_singleton_iff]
    apply (omBridge (K := K)).injective
    have hgC := (mem_isometryCentralizer.mp
      (mem_supportedBlock.mp (Φb (MulEquiv.subgroupCongr heq A)).2).1).2
    have hcomm : Subgroup.inclusion hsupp (Φb (MulEquiv.subgroupCongr heq A)) * omLift s =
        omLift s * Subgroup.inclusion hsupp (Φb (MulEquiv.subgroupCongr heq A)) := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro v
      exact hgC v
    rw [map_mul, map_mul, hιapp, omBridge_apply, ← map_mul, ← map_mul, hcomm]
  ·
    have hgB : MulEquiv.subgroupCongr heq ⟨(g : GL (Fin 3) (AdjoinRoot (X ^ 2 + X + 1 : K[X]))),
        unitarySU_le_unitaryIsom3 g.2⟩ ∈ blockSU hU 3 := by
      have hg : (g : GL (Fin 3) (AdjoinRoot (X ^ 2 + X + 1 : K[X]))) ∈
          gramSU hU (1 : Matrix (Fin 3) (Fin 3) (AdjoinRoot (X ^ 2 + X + 1 : K[X]))) := by
        rw [← unitarySU_eq_gramSU hU 3]
        exact g.2
      exact Subgroup.mem_subgroupOf.mpr hg
    have h1 : Subgroup.inclusion hsupp (Φb (MulEquiv.subgroupCongr heq
        ⟨(g : GL (Fin 3) (AdjoinRoot (X ^ 2 + X + 1 : K[X]))), unitarySU_le_unitaryIsom3 g.2⟩)) ∈
        (specialBlock (coordinateQuadPlus 4 K)
          ((omLift s : orthDerived (coordinateQuadPlus 4 K)) :
            (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) (X ^ 2 + X + 1)).subgroupOf
          (orthDerived (coordinateQuadPlus 4 K)) := by
      rw [← hmap]
      exact ⟨_, hgB, rfl⟩
    have h2 : piOrth (coordinateQuadPlus 4 K) (Subgroup.inclusion hsupp (Φb
        (MulEquiv.subgroupCongr heq ⟨(g : GL (Fin 3) (AdjoinRoot (X ^ 2 + X + 1 : K[X]))),
          unitarySU_le_unitaryIsom3 g.2⟩))) ∈
        (centDer s).map (omBridge (K := K)).toMonoidHom := by
      rw [hcomp]
      exact ⟨_, h1, rfl⟩
    obtain ⟨y, hy, hyeq⟩ := h2
    have hιy : ι ⟨g, unitarySU_le_unitaryIsom3 g.2⟩ = y := by
      apply (omBridge (K := K)).injective
      rw [hιapp]
      exact hyeq.symm
    rw [hιy]
    exact hy
  ·
    have h1 : omBridge y ∈ componentImage (coordinateQuadPlus 4 K)
        ((omLift s : orthDerived (coordinateQuadPlus 4 K)) :
          (Fin (2 * 4) → K) ≃ₗ[K] (Fin (2 * 4) → K)) (X ^ 2 + X + 1) := by
      rw [← hcomp]
      exact ⟨y, hy, rfl⟩
    obtain ⟨z, hz, hzy⟩ := h1
    have hz' : z ∈ (blockSU hU 3).map ((Subgroup.inclusion hsupp).comp Φb.toMonoidHom) := by
      rw [hmap]
      exact hz
    obtain ⟨M, hM, hMz⟩ := hz'
    have hMg : (M : GL (Fin 3) (AdjoinRoot (X ^ 2 + X + 1 : K[X]))) ∈
        unitarySU 2 n (AdjoinRoot (X ^ 2 + X + 1 : K[X])) 3 := by
      rw [unitarySU_eq_gramSU hU]
      exact Subgroup.mem_subgroupOf.mp hM
    refine ⟨⟨M, hMg⟩, ?_⟩
    apply (omBridge (K := K)).injective
    rw [hιapp, ← hzy, ← hMz]
    rfl
  ·
    intro A B hAB
    have h1 := congrArg (omBridge (K := K)) hAB
    rw [hιapp, hιapp] at h1
    exact (MulEquiv.subgroupCongr heq).injective (Φb.injective
      (Subgroup.inclusion_injective hsupp
        (CFSG.RankThree.PartOne.piOrth_injective hreg.1 h1)))

