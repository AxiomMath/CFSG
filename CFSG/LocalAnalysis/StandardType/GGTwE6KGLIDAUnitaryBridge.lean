private theorem map_bar_eq {E : Type} [Field E] [Finite E] [CharP E 2] {f n : ℕ}
    (hE : UnitaryFieldData 2 f E) (A : Matrix (Fin n) (Fin n) E) :
    A.map hE.bar = A.map (unitaryInvolution E 2 f) := by
  ext i j
  rw [Matrix.map_apply, Matrix.map_apply, UnitaryFieldData.bar_apply, unitaryInvolution_apply]

private theorem isJUnitary_of_primeFormUnitary {E : Type} [Field E] [Finite E] [CharP E 2]
    {f n : ℕ} (hE : UnitaryFieldData 2 f E) {P M : GL (Fin n) E}
    (hP : conjTr (unitaryInvolution E 2 f) (P : Matrix (Fin n) (Fin n) E) *
      (P : Matrix (Fin n) (Fin n) E) = antidiag n)
    (hM : M ∈ primeFormUnitary hE (1 : Matrix (Fin n) (Fin n) E)) :
    InnerDiagSU.IsJUnitary (unitaryInvolution E 2 f) (P⁻¹ * M * P) := by
  have hMid : conjTr (unitaryInvolution E 2 f) (M : Matrix (Fin n) (Fin n) E) *
      (M : Matrix (Fin n) (Fin n) E) = 1 := by
    have h := hM
    rw [mem_primeFormUnitary, Matrix.mul_one, map_bar_eq hE] at h
    exact h
  unfold InnerDiagSU.IsJUnitary
  rw [Units.val_mul, Units.val_mul]
  set σ := unitaryInvolution E 2 f
  set Pm := (P : Matrix (Fin n) (Fin n) E)
  set Pi := ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E)
  set Mm := (M : Matrix (Fin n) (Fin n) E)
  have hPP : Pm * Pi = 1 := by rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  calc conjTr σ (Pi * Mm * Pm) * antidiag n * (Pi * Mm * Pm)
      = conjTr σ (Pi * Mm * Pm) * (conjTr σ Pm * Pm) * (Pi * Mm * Pm) := by rw [hP]
    _ = conjTr σ Pm * (conjTr σ Mm * (conjTr σ (Pm * Pi) * (Pm * Pi)) * Mm) * Pm := by
        simp only [conjTr_mul, Matrix.mul_assoc]
    _ = antidiag n := by
        rw [hPP, conjTr_one, Matrix.one_mul, Matrix.mul_one, hMid, Matrix.mul_one, hP]

theorem ggUnitaryOn_of_sesqSUConj {G : Type} [Group G] {J : Subgroup G} {t : MulAut G}
    (hJ : CFSG.Open.IsQuasisimple ↥J) {E W : Type} [Field E] [AddCommGroup W] [Module E W]
    [FiniteDimensional E W] {f : ℕ} {hE : UnitaryFieldData 2 f E}
    {B : W →ₛₗ[hE.bar] W →ₗ[E] E} (hBs : B.IsSymm) (hBl : B.SeparatingLeft)
    (π' : ↥(sesqSpecialUnitaryGroup B) →* ↥J) (hπ : Function.Surjective π')
    (hker : π'.ker ≤ Subgroup.center ↥(sesqSpecialUnitaryGroup B)) (g : ↥(sesqUnitaryGroup B))
    (hconj : ∀ s, t (π' s) = (π' (sesqSUConj g s) : G)) : GGUnitaryOn J t := by
  classical
  haveI := hE.finite
  haveI := hE.charP
  have hF : Nat.card E = (2 ^ f) ^ 2 := by rw [hE.card, ← pow_mul, mul_comm]
  obtain ⟨e, he⟩ := hE.exists_orthonormal_basis (M := W) hBs hBl
  have he' : ∀ i j, B (e i) (e j) =
      (1 : Matrix (Fin (Module.finrank E W)) (Fin (Module.finrank E W)) E) i j := fun i j => by
    rw [Matrix.one_apply]
    exact he i j
  obtain ⟨P, hP⟩ := exists_wittMatrix hF (Module.finrank E W)
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ↥(SU (unitaryInvolution E 2 f) (Module.finrank E W)) ≃*
        ↥(sesqSpecialUnitaryGroup B),
      ∀ u, ((Θ u : ↥(sesqSpecialUnitaryGroup B)) : LinearMap.GeneralLinearGroup E W) =
        Matrix.GeneralLinearGroup.toLin' e (P * (u : GL (Fin (Module.finrank E W)) E) * P⁻¹) :=
    ⟨((conjEquiv P hP).trans (MulEquiv.subgroupCongr ((SUid_eq_statedSU hF _).trans
      (unitarySU_eq_gramSU hE (Module.finrank E W))))).trans
      (gramSUEquivSesqSpecialUnitaryGroup hE e he'), fun u => by
        rw [MulEquiv.trans_apply, gramSUEquivSesqSpecialUnitaryGroup_apply]
        rfl⟩
  obtain ⟨M, hgM⟩ : ∃ M : GL (Fin (Module.finrank E W)) E,
      Matrix.GeneralLinearGroup.toLin' e M = (g : LinearMap.GeneralLinearGroup E W) :=
    ⟨_, MulEquiv.apply_symm_apply _ _⟩
  have hM : M ∈ primeFormUnitary hE
      (1 : Matrix (Fin (Module.finrank E W)) (Fin (Module.finrank E W)) E) := by
    rw [← toLin'_mem_sesqUnitaryGroup_iff_primeFormUnitary hE e he' M, hgM]
    exact g.2
  have hA := isJUnitary_of_primeFormUnitary hE hP hM
  have hφ : Function.Surjective (π'.comp Θ.toMonoidHom) := hπ.comp Θ.surjective
  obtain ⟨hk, hkq⟩ := two_le_of_su_isQuasisimple hF hE.one_le _ hφ hJ
  refine ⟨E, inferInstance, inferInstance, inferInstance, f, Module.finrank E W, hF, hE.one_le,
    hk, hkq, π'.comp Θ.toMonoidHom, hφ, fun u hu => ?_, P⁻¹ * M * P, hA, fun u => ?_⟩
  · rw [← InnerDiagSU.mem_center_iff_of_mulEquiv Θ]
    exact hker (MonoidHom.mem_ker.2 (MonoidHom.mem_ker.1 hu))
  · have hc : Θ (InnerDiagSU.conjSU (P⁻¹ * M * P) hA u) = sesqSUConj g (Θ u) := by
      apply Subtype.ext
      rw [hΘ, sesqSUConj_apply, hΘ, InnerDiagSU.coe_conjSU, ← hgM, ← map_inv, ← map_mul,
        ← map_mul]
      congr 1
      group
    change t (π' (Θ u)) = (π' (Θ (InnerDiagSU.conjSU (P⁻¹ * M * P) hA u)) : G)
    rw [hc]
    exact hconj (Θ u)

