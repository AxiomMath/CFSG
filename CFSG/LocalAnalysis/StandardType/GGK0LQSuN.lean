private lemma lk0xlqsun_mul_succ_injective :
    Function.Injective (fun n : ℕ => n * (n + 1)) := by
  have hmono : StrictMono (fun n : ℕ => n * (n + 1)) := by
    intro a b hab
    calc a * (a + 1) < (a + 1) * (a + 1) :=
          Nat.mul_lt_mul_of_pos_right (Nat.lt_succ_self a) (Nat.succ_pos a)
      _ ≤ b * (b + 1) := Nat.mul_le_mul (by omega) (by omega)
  exact hmono.injective

private lemma lk0xlqsun_frame_branches
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a))
    (hk : twistKind S.ρ (rootCharHom a) i = .suN)
    {ν : ℕ} (hν : 3 ≤ ν)
    {ψ : Matrix.SpecialLinearGroup (Fin ν) L →* ModGL τ L}
    {σ : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : CFSG.HardMathSupport.Timmesfeld.CrossChar.IsSLFrame ψ σ) {κ : ℤ} (hκ : κ ≠ 0)
    (hnorm : ∀ a b, a ≠ b →
      CFSG.LieType.Steinberg.Adjoint.iform (σ a b) (σ a b) = 2 * κ)
    (hΨ : componentRoots (rootCharHom a) i =
      CFSG.HardMathSupport.Timmesfeld.CrossChar.frameRoots σ) :
    ((ν, S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)) ≠ (3, 2) →
        CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i)) ∧
      ((ν, S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)) = (3, 2) →
        Nat.card (rationalComponent S.ρ S.Γ (rootCharHom a) i) ∣ 216) := by
  classical
  obtain ⟨hs0, hs, -⟩ := outer_componentOrbitLength_spec S hT i
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) with hsdef
  have hout : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[s]) := by
    intro h
    unfold twistKind at hk
    rw [ite_eq_left_iff.2 (fun h' => absurd h h')] at hk
    exact absurd hk (by decide)
  have hmaps : ∀ x y, x ≠ y → (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (σ x y) ∈
      CFSG.HardMathSupport.Timmesfeld.CrossChar.frameRoots σ := by
    intro x y hxy
    have h1 : σ x y ∈ componentRoots (rootCharHom a) i := by
      rw [hΨ]
      exact ⟨x, y, hxy, rfl⟩
    have h2 : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (σ x y) ∈
        (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i := ⟨_, h1, rfl⟩
    rw [hs, hΨ] at h2
    exact h2
  have hneg : ∀ (n : ℕ) (γ : Fin τ.rank → ℤ),
      (S.ρ : (Fin τ.rank → ℤ) → _)^[n] (-γ) = -(S.ρ : (Fin τ.rank → ℤ) → _)^[n] γ := by
    intro n
    induction n with
    | zero => exact fun γ => rfl
    | succ n ih =>
      intro γ
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, S.frob.neg_eq]
  rcases hψ.aut_cases hν hκ hnorm ((S.ρ : (Fin τ.rank → ℤ) → _)^[s]) hmaps (hneg s)
      (iform_rho_iterate S s) with ⟨π, hπ⟩ | ⟨π, hπ⟩
  · exfalso
    apply hout
    obtain ⟨w, hw, hwσ⟩ := hψ.exists_weyl_perm hκ hnorm π
    refine ⟨w, ?_, fun γ hγ => ?_⟩
    · rw [hΨ]
      exact hw
    · rw [hΨ] at hγ
      obtain ⟨x, y, hxy, rfl⟩ := hγ
      rw [hπ x y hxy, hwσ]
  · exact CFSG.HardMathSupport.Timmesfeld.CrossChar.rationalComponent_of_unitary_frame_T
      S hT i hν hψ hΨ π hπ

theorem lq_suN_quasisimple
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ}
    (S : LangSetup τ L p₀) {a : Fin τ.rank → Lˣ} (hp : p.Prime) (hpL : (p : L) ≠ 0)
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hTp : rootDiagUnit τ a ^ p = 1)
    (i : KernelComponent (rootCharHom a)) (hk : twistKind S.ρ (rootCharHom a) i = .suN)
    (hnot : ¬ (compRank (componentRoots (rootCharHom a) i) = 2 ∧
      S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2)) :
    CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
  classical
  obtain ⟨h2, hn⟩ := CFSG.HardMathSupport.Timmesfeld.CrossChar.suN_rank_ncard hk
  obtain ⟨ν, ψ, σ, κ, hν, hψ, hκ, hnorm, hΨ⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_frame_of_typeA_tag_T_of_prime
      CFSG.HardMathSupport.Timmesfeld.CrossChar.g2LongA2Frame_proved S hp hpL hTp i h2 hn
  obtain ⟨h1, -⟩ := lk0xlqsun_frame_branches S hT i hk hν hψ hκ hnorm hΨ
  have hcard : (CFSG.HardMathSupport.Timmesfeld.CrossChar.frameRoots σ).ncard =
      ν * (ν - 1) := CFSG.LocalAnalysis.GLTheoremA.kd147c_frameRoots_ncard hψ hκ hnorm
  have hcard' : (componentRoots (rootCharHom a) i).ncard = ν * (ν - 1) := by
    rw [hΨ]; exact hcard
  have hkey : compRank (componentRoots (rootCharHom a) i) = ν - 1 := by
    apply lk0xlqsun_mul_succ_injective
    have hνpos : 1 ≤ ν := by omega
    have hνsplit : ν = (ν - 1) + 1 := (Nat.sub_add_cancel hνpos).symm
    calc compRank (componentRoots (rootCharHom a) i) *
            (compRank (componentRoots (rootCharHom a) i) + 1)
        = (componentRoots (rootCharHom a) i).ncard := hn.symm
      _ = (CFSG.HardMathSupport.Timmesfeld.CrossChar.frameRoots σ).ncard := by rw [hΨ]
      _ = ν * (ν - 1) := hcard
      _ = ((ν - 1) + 1) * (ν - 1) := by rw [← hνsplit]
      _ = (ν - 1) * ((ν - 1) + 1) := by rw [Nat.mul_comm]
  apply h1
  intro h
  apply hnot
  obtain ⟨hν3, hq⟩ := Prod.ext_iff.mp h
  exact ⟨by omega, hq⟩

theorem lq_suN_solvable
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ}
    (S : LangSetup τ L p₀) {a : Fin τ.rank → Lˣ} (hp : p.Prime) (hpL : (p : L) ≠ 0)
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hTp : rootDiagUnit τ a ^ p = 1)
    (i : KernelComponent (rootCharHom a)) (hk : twistKind S.ρ (rootCharHom a) i = .suN)
    (hsmall : compRank (componentRoots (rootCharHom a) i) = 2 ∧
      S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2) :
    Group.IsSolvable (rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
  classical
  obtain ⟨h2, hn⟩ := CFSG.HardMathSupport.Timmesfeld.CrossChar.suN_rank_ncard hk
  obtain ⟨ν, ψ, σ, κ, hν, hψ, hκ, hnorm, hΨ⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_frame_of_typeA_tag_T_of_prime
      CFSG.HardMathSupport.Timmesfeld.CrossChar.g2LongA2Frame_proved S hp hpL hTp i h2 hn
  obtain ⟨-, h2'⟩ := lk0xlqsun_frame_branches S hT i hk hν hψ hκ hnorm hΨ
  have hcard : (CFSG.HardMathSupport.Timmesfeld.CrossChar.frameRoots σ).ncard =
      ν * (ν - 1) := CFSG.LocalAnalysis.GLTheoremA.kd147c_frameRoots_ncard hψ hκ hnorm
  have hcard' : (componentRoots (rootCharHom a) i).ncard = ν * (ν - 1) := by
    rw [hΨ]; exact hcard
  have hkey : compRank (componentRoots (rootCharHom a) i) = ν - 1 := by
    apply lk0xlqsun_mul_succ_injective
    have hνpos : 1 ≤ ν := by omega
    have hνsplit : ν = (ν - 1) + 1 := (Nat.sub_add_cancel hνpos).symm
    calc compRank (componentRoots (rootCharHom a) i) *
            (compRank (componentRoots (rootCharHom a) i) + 1)
        = (componentRoots (rootCharHom a) i).ncard := hn.symm
      _ = (CFSG.HardMathSupport.Timmesfeld.CrossChar.frameRoots σ).ncard := by rw [hΨ]
      _ = ν * (ν - 1) := hcard
      _ = ((ν - 1) + 1) * (ν - 1) := by rw [← hνsplit]
      _ = (ν - 1) * ((ν - 1) + 1) := by rw [Nat.mul_comm]
  have hν3 : ν = 3 := by omega
  exact CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.isSolvable_of_card_dvd_216
    (h2' (by rw [hν3, hsmall.2]))

