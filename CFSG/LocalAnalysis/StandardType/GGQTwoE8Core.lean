private def ggQ2xE8c_cm (i j : ℕ) : ℕ := (ggQ2xE8c_cartan.getD i []).getD j 0

private def ggQ2xE8c_dotC (i v : ℕ) : ℕ :=
  (List.range 8).foldl (fun s k => s + ggQ2xE8c_cm i k * ggQ2xE8c_dig v k) 0 % 3

private def ggQ2xE8c_beta (u v : ℕ) : ℕ :=
  (List.range 8).foldl (fun s i => s + ggQ2xE8c_dig u i * ggQ2xE8c_dotC i v) 0 % 3

private def ggQ2xE8c_sref (i v : ℕ) : ℕ :=
  Nat.ofDigits 3 (List.ofFn (fun k : Fin 8 =>
    if (k : ℕ) = i then (ggQ2xE8c_dig v (k : ℕ) + 3 - ggQ2xE8c_dotC i v) % 3
    else ggQ2xE8c_dig v (k : ℕ)))

private def ggQ2xE8c_zc (z w : ℕ) : ℕ :=
  let nz := ggQ2xE8c_beta z z
  let inv := if nz == 1 then 1 else 2
  (2 * inv * ggQ2xE8c_beta z w) % 3

private def ggQ2xE8c_zref (z w : ℕ) : ℕ :=
  Nat.ofDigits 3 (List.ofFn (fun k : Fin 8 =>
    (ggQ2xE8c_dig w (k : ℕ) + 9 - ggQ2xE8c_zc z w * ggQ2xE8c_dig z (k : ℕ)) % 3))


private def ggQ2xE8c_lamMask (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE8c_lamMask_0
  | 1 => ggQ2xE8c_lamMask_1
  | 7 => ggQ2xE8c_lamMask_7
  | _ => 0

private def ggQ2xE8c_lamDist (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE8c_lamDist_0
  | 1 => ggQ2xE8c_lamDist_1
  | 7 => ggQ2xE8c_lamDist_7
  | _ => 0

private def ggQ2xE8c_lamList (a : ℕ) : List ℕ :=
  match a with
  | 0 => ggQ2xE8c_lamList_0
  | 1 => ggQ2xE8c_lamList_1
  | 7 => ggQ2xE8c_lamList_7
  | _ => []

private def ggQ2xE8c_distTab (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE8c_distTab_0
  | 1 => ggQ2xE8c_distTab_1
  | 7 => ggQ2xE8c_distTab_7
  | _ => 0

private def ggQ2xE8c_witTab (a : ℕ) : ℕ :=
