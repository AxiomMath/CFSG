private lemma ggQ2xE8c_eq_of_dig_eq : ∀ (n a b : ℕ), a < 3 ^ n → b < 3 ^ n →
    (∀ i, i < n → ggQ2xE8c_dig a i = ggQ2xE8c_dig b i) → a = b := by
  intro n
  induction n with
  | zero =>
      intro a b ha hb _
      interval_cases a <;> interval_cases b <;> rfl
  | succ n ih =>
      intro a b ha hb h
      have h0 : a % 3 = b % 3 := by
        have hh := h 0 (by omega)
        simpa [ggQ2xE8c_dig] using hh
      have ha' : a / 3 < 3 ^ n := by
        rw [Nat.div_lt_iff_lt_mul (by norm_num)]; simpa [pow_succ] using ha
      have hb' : b / 3 < 3 ^ n := by
        rw [Nat.div_lt_iff_lt_mul (by norm_num)]; simpa [pow_succ] using hb
      have hdig : ∀ i, i < n → ggQ2xE8c_dig (a/3) i = ggQ2xE8c_dig (b/3) i := by
        intro i hi
        have := h (i+1) (by omega)
        simpa [ggQ2xE8c_dig, pow_succ, Nat.mul_comm, Nat.div_div_eq_div_mul] using this
      have hdiv : a / 3 = b / 3 := ih (a/3) (b/3) ha' hb' hdig
      calc a = a % 3 + 3 * (a / 3) := (Nat.mod_add_div a 3).symm
        _ = b % 3 + 3 * (b / 3) := by rw [h0, hdiv]
        _ = b := Nat.mod_add_div b 3

