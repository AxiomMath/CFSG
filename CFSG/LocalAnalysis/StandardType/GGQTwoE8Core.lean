    rw [show ggQ2xE8c_dig (3 ^ (j : ℕ)) i = ggQ2xE8c_dig (3 ^ (j : ℕ)) (⟨i, hi⟩ : Fin 8) from rfl,
      ggQ2xE8c_dig_pow3]
    by_cases hij : (⟨i, hi⟩ : Fin 8) = j
