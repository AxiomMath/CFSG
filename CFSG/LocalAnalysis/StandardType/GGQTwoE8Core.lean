private theorem ggQ2xE8c_srefK_eq_D : ggQ2xE8c_srefK = ggQ2xE8c_srefD := by
  funext i v
  unfold ggQ2xE8c_srefD
  cases hv : Nat.blt v 6561
  · rfl
  · cases hi : Nat.blt i 8
    · rfl
    · change ggQ2xE8c_srefK i v = ggQ2xE8c_srefS i v
      have hv' : v < 6561 := Nat.le_of_ble_eq_true hv
      have hi' : i < 8 := Nat.le_of_ble_eq_true hi
      have key : (List.range 6561).all (fun v =>
          Nat.beq (ggQ2xE8c_srefK i v) (ggQ2xE8c_srefS i v)) = true →
          ggQ2xE8c_srefK i v = ggQ2xE8c_srefS i v := fun h =>
        Nat.eq_of_beq_eq_true (List.all_eq_true.mp h v (List.mem_range.mpr hv'))
      clear hi
      interval_cases i
      · exact key ggQ2xE8c_srefS_chk_0
      · exact key ggQ2xE8c_srefS_chk_1
