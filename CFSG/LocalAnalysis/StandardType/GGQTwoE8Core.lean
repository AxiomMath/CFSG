theorem ggQ2_E8_Z (a : Fin 8) (ha : a = 0 ∨ a = 1 ∨ a = 7) (Z : Set (Fin 8 → ZMod 3))
    (hZ0 : ∀ z ∈ Z, ggEBil 8 z z ≠ 0) (hZroots : ggEClosure 8 Set.univ ⊆ Z)
    (hZcl : ∀ z ∈ Z, ∀ w ∈ Z, ggERefl 8 z w ∈ Z)
    (hHL : ∀ z ∈ Z, z a = 0 → ∀ ρ ∈ ggEClosure 8 {k | k ≠ a}, ∀ ρ' ∈ ggEClosure 8 {k | k ≠ a},
      ggERefl 8 (ggERefl 8 z ρ) ρ' ∈ ggEClosure 8 {k | k ≠ a}) :
    Z ⊆ ggEClosure 8 Set.univ := by
  have hset : {k : Fin 8 | k ≠ a} = {k : Fin 8 | (k : ℕ) ≠ (a : ℕ)} := ggQ2xE8c_set_eq a
  have hav : (a : ℕ) = 0 ∨ (a : ℕ) = 1 ∨ (a : ℕ) = 7 := by
    rcases ha with h | h | h
    · left; rw [h]; rfl
    · right; left; rw [h]; rfl
    · right; right; rw [h]; rfl
  have hHL' : ∀ z ∈ Z, z a = 0 → ∀ ρ ∈ ggEClosure 8 {k | (k : ℕ) ≠ (a : ℕ)},
      ∀ ρ' ∈ ggEClosure 8 {k | (k : ℕ) ≠ (a : ℕ)},
      ggERefl 8 (ggERefl 8 z ρ) ρ' ∈ ggEClosure 8 {k | (k : ℕ) ≠ (a : ℕ)} := by
    intro z hz hza ρ hρ ρ' hρ'
    have h1 := hHL z hz hza ρ (by rwa [← hset] at hρ) ρ' (by rwa [← hset] at hρ')
    rwa [hset] at h1
  have hβ_enc : ∀ z ∈ Z, ggQ2xE8c_beta (ggQ2xE8c_enc z) (ggQ2xE8c_enc z) ≠ 0 := by
    intro z hz h0
    have hbe := ggQ2xE8c_beta_eq z z
    rw [h0, Nat.cast_zero] at hbe
    exact hZ0 z hz hbe
  have aux : ∀ d, ∀ (z' : Fin 8 → ZMod 3), z' ∈ Z →
      ggQ2xE8c_rootBit (ggQ2xE8c_enc z') = false →
      ggQ2xE8c_distOf (a : ℕ) (ggQ2xE8c_enc z') = d → False := by
    intro d
    refine Nat.strong_induction_on d ?_
    intro d ih z' hz' hb' hd'
    rcases ggQ2xE8c_okVec_spec (a : ℕ) (ggQ2xE8c_enc z')
        (ggQ2xE8c_okVec_true (a : ℕ) hav (ggQ2xE8c_enc z') (ggQ2xE8c_enc_lt z'))
        (hβ_enc z' hz') hb' with ⟨h0, hbad⟩ | ⟨hne, j, hbj, hdec⟩
    · obtain ⟨i, i2, hi, hi2, hdig, hcc, hlam⟩ :=
        ggQ2xE8c_isBadW_spec (a : ℕ) (ggQ2xE8c_enc z') hbad
      let ρ := (ggQ2xE8c_lamList (a : ℕ)).getD i 0
      let ρ' := (ggQ2xE8c_lamList (a : ℕ)).getD i2 0
      have hρmem : ρ ∈ ggQ2xE8c_lamList (a : ℕ) := ggQ2xE8c_getD_mem 0 hi
      have hρ'mem : ρ' ∈ ggQ2xE8c_lamList (a : ℕ) := ggQ2xE8c_getD_mem 0 hi2
      have hρlt : ρ < 3 ^ 8 := ggQ2xE8c_lamList_lt (a : ℕ) hav ρ hρmem
      have hρ'lt : ρ' < 3 ^ 8 := ggQ2xE8c_lamList_lt (a : ℕ) hav ρ' hρ'mem
      have hρbit : ggQ2xE8c_lamBit (a : ℕ) ρ = true :=
        ggQ2xE8c_lamList_bit (a : ℕ) hav ρ hρmem
      have hρ'bit : ggQ2xE8c_lamBit (a : ℕ) ρ' = true :=
        ggQ2xE8c_lamList_bit (a : ℕ) hav ρ' hρ'mem
      have hρcl : ggQ2xE8c_dec ρ ∈ ggEClosure 8 {k | (k : ℕ) ≠ (a : ℕ)} := by
        refine ggQ2xE8c_lam_mem (a : ℕ) hav (ggQ2xE8c_dec ρ) ?_
        rwa [ggQ2xE8c_enc_dec ρ hρlt]
      have hρ'cl : ggQ2xE8c_dec ρ' ∈ ggEClosure 8 {k | (k : ℕ) ≠ (a : ℕ)} := by
        refine ggQ2xE8c_lam_mem (a : ℕ) hav (ggQ2xE8c_dec ρ') ?_
        rwa [ggQ2xE8c_enc_dec ρ' hρ'lt]
      have hz'a : z' a = 0 := ZMod.val_injective 3 (by
        rw [← ggQ2xE8c_dig_enc z' a, hdig, ZMod.val_zero])
      have hfin : ggERefl 8 (ggERefl 8 z' (ggQ2xE8c_dec ρ)) (ggQ2xE8c_dec ρ') ∈
          ggEClosure 8 {k | (k : ℕ) ≠ (a : ℕ)} :=
        hHL' z' hz' hz'a (ggQ2xE8c_dec ρ) hρcl (ggQ2xE8c_dec ρ') hρ'cl
      have henc1 : ggQ2xE8c_enc (ggERefl 8 z' (ggQ2xE8c_dec ρ)) =
          ggQ2xE8c_zref (ggQ2xE8c_enc z') ρ := by
        rw [ggQ2xE8c_enc_refl z' (ggQ2xE8c_dec ρ) (hZ0 z' hz'), ggQ2xE8c_enc_dec ρ hρlt]
      have hβ2 : ggEBil 8 (ggERefl 8 z' (ggQ2xE8c_dec ρ))
          (ggERefl 8 z' (ggQ2xE8c_dec ρ)) ≠ 0 := by
        intro h0'
        have hv := ggQ2xE8c_beta_val (ggERefl 8 z' (ggQ2xE8c_dec ρ))
          (ggERefl 8 z' (ggQ2xE8c_dec ρ))
        rw [h0', ZMod.val_zero, henc1] at hv
        exact hcc hv.symm
      have henc2 : ggQ2xE8c_enc
          (ggERefl 8 (ggERefl 8 z' (ggQ2xE8c_dec ρ)) (ggQ2xE8c_dec ρ')) =
          ggQ2xE8c_zref (ggQ2xE8c_zref (ggQ2xE8c_enc z') ρ) ρ' := by
        rw [ggQ2xE8c_enc_refl _ (ggQ2xE8c_dec ρ') hβ2, henc1, ggQ2xE8c_enc_dec ρ' hρ'lt]
      have hcontra := ggQ2xE8c_lam_closed_mem (a : ℕ) hav _ hfin
      rw [henc2] at hcontra
      rw [hlam] at hcontra
      exact Bool.false_ne_true hcontra
    · have hwZ : ggERefl 8 (Pi.single j 1) z' ∈ Z :=
        hZcl (Pi.single j 1) (hZroots (ggQ2xE8c_single_mem Set.univ j (Set.mem_univ j))) z' hz'
      rw [ggQ2xE8c_refl_single j z'] at hwZ
      have hencw : ggQ2xE8c_enc (ggESimple 8 j z') = ggQ2xE8c_sref (j : ℕ) (ggQ2xE8c_enc z') :=
        ggQ2xE8c_enc_simple j z'
      have hbr : ggQ2xE8c_rootBit (ggQ2xE8c_enc (ggESimple 8 j z')) = false := by
        rw [hencw]; exact hbj
      have hlt : ggQ2xE8c_distOf (a : ℕ) (ggQ2xE8c_enc (ggESimple 8 j z')) < d := by
        rw [hencw]; omega
      exact ih _ hlt (ggESimple 8 j z') hwZ hbr rfl
  intro z hz
  by_cases hb : ggQ2xE8c_rootBit (ggQ2xE8c_enc z) = true
  · exact ggQ2xE8c_root_mem z hb
  · have hbf : ggQ2xE8c_rootBit (ggQ2xE8c_enc z) = false := by
      cases hh : ggQ2xE8c_rootBit (ggQ2xE8c_enc z)
      · rfl
      · exact absurd hh hb
    exact False.elim (aux (ggQ2xE8c_distOf (a : ℕ) (ggQ2xE8c_enc z)) z hz hbf rfl)

