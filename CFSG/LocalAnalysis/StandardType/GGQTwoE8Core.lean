  | 0 => ggQ2xE8c_witTab_0
  | 1 => ggQ2xE8c_witTab_1
  | 7 => ggQ2xE8c_witTab_7
  | _ => 0

private def ggQ2xE8c_rootBit (v : ℕ) : Bool := ggQ2xE8c_rootMask.testBit v

private def ggQ2xE8c_lamBit (a v : ℕ) : Bool := (ggQ2xE8c_lamMask a).testBit v

private def ggQ2xE8c_rootDistOf (v : ℕ) : ℕ := ggQ2xE8c_rootDist >>> (5 * v) % 32

private def ggQ2xE8c_lamDistOf (a v : ℕ) : ℕ := (ggQ2xE8c_lamDist a) >>> (5 * v) % 32

private def ggQ2xE8c_distOf (a v : ℕ) : ℕ := (ggQ2xE8c_distTab a) >>> (5 * v) % 32

private def ggQ2xE8c_witOf (a v : ℕ) : ℕ := (ggQ2xE8c_witTab a) >>> (14 * v) % 16384

private def ggQ2xE8c_isSimple (v : ℕ) : Bool :=
  (List.range 8).any (fun k => v == 3 ^ k)

private def ggQ2xE8c_isSimpleA (a v : ℕ) : Bool :=
  (List.range 8).any (fun k => decide (k ≠ a) && (v == 3 ^ k))

private def ggQ2xE8c_isBadW (a z : ℕ) : Bool :=
  let w := ggQ2xE8c_witOf a z
  let i := w % 128
  let i2 := w / 128
  let l := ggQ2xE8c_lamList a
  let ρ := l.getD i 0
  let ρ' := l.getD i2 0
  let c := ggQ2xE8c_zref z ρ
  decide (i < l.length) && decide (i2 < l.length) && (ggQ2xE8c_dig z a == 0) &&
    (ggQ2xE8c_beta c c != 0) && !(ggQ2xE8c_lamBit a (ggQ2xE8c_zref c ρ'))

private def ggQ2xE8c_okVec (a v : ℕ) : Bool :=
  if ggQ2xE8c_beta v v == 0 || ggQ2xE8c_rootBit v then true
  else if ggQ2xE8c_distOf a v == 0 then ggQ2xE8c_isBadW a v
  else (List.range 8).any (fun j => !(ggQ2xE8c_rootBit (ggQ2xE8c_sref j v)) &&
    ggQ2xE8c_distOf a (ggQ2xE8c_sref j v) + 1 == ggQ2xE8c_distOf a v)

private def ggQ2xE8c_okLam (a v : ℕ) : Bool :=
  if !(ggQ2xE8c_lamBit a v) then true
  else if ggQ2xE8c_lamDistOf a v == 0 then ggQ2xE8c_isSimpleA a v
  else (List.range 8).any (fun j => decide (j ≠ a) && ggQ2xE8c_lamBit a (ggQ2xE8c_sref j v) &&
    ggQ2xE8c_lamDistOf a (ggQ2xE8c_sref j v) + 1 == ggQ2xE8c_lamDistOf a v)

private def ggQ2xE8c_okRoot (v : ℕ) : Bool :=
  if !(ggQ2xE8c_rootBit v) then true
  else if ggQ2xE8c_rootDistOf v == 0 then ggQ2xE8c_isSimple v
  else (List.range 8).any (fun j => ggQ2xE8c_rootBit (ggQ2xE8c_sref j v) &&
    ggQ2xE8c_rootDistOf (ggQ2xE8c_sref j v) + 1 == ggQ2xE8c_rootDistOf v)

private def ggQ2xE8c_okLamClosed (a : ℕ) : Bool :=
  (List.range 8).all (fun k => !decide (k ≠ a) || ggQ2xE8c_lamBit a (3 ^ k)) &&
  (List.range 8).all (fun j => !decide (j ≠ a) ||
    (List.range (3 ^ 8)).all (fun v => !(ggQ2xE8c_lamBit a v) ||
      ggQ2xE8c_lamBit a (ggQ2xE8c_sref j v)))

private def ggQ2xE8c_chk (a : ℕ) : Bool :=
  (List.range (3 ^ 8)).all (ggQ2xE8c_okVec a) &&
  (List.range (3 ^ 8)).all (ggQ2xE8c_okLam a) &&
  (List.range (3 ^ 8)).all ggQ2xE8c_okRoot &&
  ggQ2xE8c_okLamClosed a

private def ggQ2xE8c_cmP : ℕ := 212679886783398373142776319480743591970

private def ggQ2xE8c_cmK (i k : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ) 0
    (Nat.land (Nat.shiftRight ggQ2xE8c_cmP (Nat.mul 2 (Nat.add (Nat.mul 8 i) k))) 3)
    (Nat.blt i 8)

private def ggQ2xE8c_dotCK (i v : ℕ) : ℕ :=
  Nat.mod (GGQ2E8K.recAdd (fun k => Nat.mul (ggQ2xE8c_cmK i k) (GGQ2E8K.digK v k)) 8) 3

private def ggQ2xE8c_betaK (u v : ℕ) : ℕ :=
  Nat.mod (GGQ2E8K.recAdd (fun i => Nat.mul (GGQ2E8K.digK u i) (ggQ2xE8c_dotCK i v)) 8) 3

private def ggQ2xE8c_srefK (i v : ℕ) : ℕ :=
  GGQ2E8K.recSum (fun k => Bool.rec (motive := fun _ => ℕ) (GGQ2E8K.digK v k)
    (Nat.mod (Nat.sub (Nat.add (GGQ2E8K.digK v k) 3) (ggQ2xE8c_dotCK i v)) 3) (Nat.beq k i)) 8

private def ggQ2xE8c_srefS (i v : ℕ) : ℕ :=
  Nat.add (Nat.sub v (Nat.mul (GGQ2E8K.digK v i) (Nat.pow 3 i)))
    (Nat.mul (Nat.mod (Nat.sub (Nat.add (GGQ2E8K.digK v i) 3) (ggQ2xE8c_dotCK i v)) 3)
      (Nat.pow 3 i))

private def ggQ2xE8c_srefD (i v : ℕ) : ℕ :=
  Bool.rec (motive := fun _ => ℕ) (ggQ2xE8c_srefK i v) (ggQ2xE8c_srefS i v)
    (Bool.rec (motive := fun _ => Bool) false (Nat.blt i 8) (Nat.blt v 6561))

private theorem ggQ2xE8c_cmK_chk : (List.range 8).all (fun i => (List.range 8).all (fun k =>
    Nat.beq (ggQ2xE8c_cm i k)
      (Nat.land (Nat.shiftRight ggQ2xE8c_cmP (Nat.mul 2 (Nat.add (Nat.mul 8 i) k))) 3))) =
    true := by
  decide +kernel

private theorem ggQ2xE8c_cm_eq_K {i k : ℕ} (hk : k < 8) : ggQ2xE8c_cm i k = ggQ2xE8c_cmK i k := by
  unfold ggQ2xE8c_cmK
  by_cases hi : i < 8
  · have hb : Nat.blt i 8 = true := Nat.ble_eq_true_of_le hi
    rw [hb]
    exact Nat.eq_of_beq_eq_true (List.all_eq_true.mp (List.all_eq_true.mp ggQ2xE8c_cmK_chk i
      (List.mem_range.mpr hi)) k (List.mem_range.mpr hk))
  · have hb : Nat.blt i 8 = false := by
      cases h : Nat.blt i 8
      · rfl
      · exact absurd (Nat.le_of_ble_eq_true h) hi
    rw [hb]
    unfold ggQ2xE8c_cm
    rw [List.getD_eq_getElem?_getD (l := ggQ2xE8c_cartan),
      List.getElem?_eq_none (by change 8 ≤ i; omega)]
    try rfl

private theorem ggQ2xE8c_recAdd_congr {f g : ℕ → ℕ} : ∀ n, (∀ k < n, f k = g k) →
    GGQ2E8K.recAdd f n = GGQ2E8K.recAdd g n
  | 0, _ => rfl
  | n + 1, h => by
    change Nat.add (GGQ2E8K.recAdd f n) (f n) = Nat.add (GGQ2E8K.recAdd g n) (g n)
    rw [ggQ2xE8c_recAdd_congr n (fun k hk => h k (Nat.lt_succ_of_lt hk)), h n (Nat.lt_succ_self n)]

private theorem ggQ2xE8c_dotC_eq_K : ggQ2xE8c_dotC = ggQ2xE8c_dotCK := by
  funext i v
  unfold ggQ2xE8c_dotC ggQ2xE8c_dotCK
  rw [GGQ2E8K.foldl_range_eq_rec (fun k => ggQ2xE8c_cm i k * ggQ2xE8c_dig v k) 8]
  exact congrArg (· % 3) (ggQ2xE8c_recAdd_congr 8 fun k hk => by rw [ggQ2xE8c_cm_eq_K hk]; try rfl)

private theorem ggQ2xE8c_beta_eq_K : ggQ2xE8c_beta = ggQ2xE8c_betaK := by
  funext u v
  unfold ggQ2xE8c_beta ggQ2xE8c_betaK
  rw [GGQ2E8K.foldl_range_eq_rec (fun i => ggQ2xE8c_dig u i * ggQ2xE8c_dotC i v) 8,
    ggQ2xE8c_dotC_eq_K]
  try rfl

private theorem ggQ2xE8c_sref_eq_K : ggQ2xE8c_sref = ggQ2xE8c_srefK := by
  funext i v
  unfold ggQ2xE8c_sref ggQ2xE8c_srefK
  rw [GGQ2E8K.ofDigits_ofFn_eight (fun k => if k = i then (ggQ2xE8c_dig v k + 3 -
    ggQ2xE8c_dotC i v) % 3 else ggQ2xE8c_dig v k)]
  refine GGQ2E8K.recSum_congr (fun k => ?_) 8
  rw [GGQ2E8K.ite_eq_rec, ggQ2xE8c_dotC_eq_K]
  try rfl

