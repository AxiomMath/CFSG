theorem mem_subfield_iff_pow_eq_self {Ω : Type} [Field Ω] [IsAlgClosed Ω] {ℓ : ℕ}
    [Fact ℓ.Prime] [CharP Ω ℓ] {n : ℕ} (hn : 1 ≤ n) {F : Subfield Ω}
    (hF : Nat.card F = (ℓ ^ n) ^ 2) (c : Ω) :
    c ∈ F ↔ c ^ (ℓ ^ n) ^ 2 = c := by
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hq : (ℓ ^ n) ^ 2 = ℓ ^ (2 * n) := by rw [← pow_mul, mul_comm]
  have : Finite F :=
    Nat.finite_of_card_ne_zero (by rw [hF]; exact pow_ne_zero _ (pow_ne_zero _ hℓ0))
  have : Fintype F := Fintype.ofFinite F
  have hpow : ∀ x ∈ F, x ^ (ℓ ^ n) ^ 2 = x := fun x hx => by
    have h := FiniteField.pow_card (⟨x, hx⟩ : F)
    rw [Fintype.card_eq_nat_card, hF] at h
    exact congrArg Subtype.val h
  set T : Set Ω := {x | x ^ ℓ ^ (2 * n) = x} with hTdef
  have hT : Nat.card T = ℓ ^ (2 * n) :=
    CFSG.RankThree.Classical2.natCard_setOf_pow_eq_self (by omega)
  have hsub : (F : Set Ω) ⊆ T := fun x hx => by
    change x ^ ℓ ^ (2 * n) = x
    rw [← hq]
    exact hpow x hx
  have hTfin : T.Finite :=
    Set.finite_coe_iff.1 (Nat.finite_of_card_ne_zero (by rw [hT]; exact pow_ne_zero _ hℓ0))
  have heq : (F : Set Ω) = T := Set.eq_of_subset_of_ncard_le hsub
    (by rw [← Nat.card_coe_set_eq, ← Nat.card_coe_set_eq, hT, ← hq]; exact hF.ge) hTfin
  refine ⟨hpow c, fun hc => ?_⟩
  have hcT : c ∈ T := by
    change c ^ ℓ ^ (2 * n) = c
    rw [← hq]
    exact hc
  rw [← heq] at hcT
  exact hcT

theorem exists_psu_equiv_of_conj_frame {Ω : Type} [Field Ω] [IsAlgClosed Ω] {ℓ : ℕ}
    (hℓ : ℓ.Prime) [CharP Ω ℓ] {n : ℕ} (hn : 1 ≤ n) {σQ : Ω ≃+* Ω}
    (hσQ : ∀ c, σQ c = c ^ ℓ ^ n) {ν : ℕ} (hν : 3 ≤ ν) (hνq : (ν, ℓ ^ n) ≠ (3, 2))
    {G : Type} [Group G] {ψ : SL(ν, Ω) →* G} (hker : ψ.ker ≤ Subgroup.center SL(ν, Ω)) (z : G)
    {L' : Type} [Group L'] {J : Subgroup L'} {ι : L' →* G} (hι : Function.Injective ι)
    (hJ : ∀ g : G, g ∈ J.map ι ↔
      ∃ Y ∈ fixSubgroup (stdUnitaryEquiv (ν := ν) σQ), g = z * ψ Y * z⁻¹) :
    ∃ F : Subfield Ω, Nat.card F = (ℓ ^ n) ^ 2 ∧ (∀ c, c ∈ F ↔ c ^ (ℓ ^ n) ^ 2 = c) ∧
      ∃ (Φ : StatedSU ν (ℓ ^ n) F →* J)
        (θ : ↥J ⧸ Subgroup.center ↥J ≃* LargeEvenProj (LargeEvenSUGroup (Fin ν) F (ℓ ^ n))),
        (∀ s, ι (Φ s) = z * ψ (statedSUToSL F ν (ℓ ^ n) s) * z⁻¹) ∧
        (∀ s, θ (QuotientGroup.mk (Φ s)) =
          LargeEvenProjMk (LargeEvenSUGroup (Fin ν) F (ℓ ^ n)) s) ∧
        Function.Surjective Φ ∧ Φ.ker ≤ Subgroup.center (StatedSU ν (ℓ ^ n) F) := by
  classical
  have : Fact ℓ.Prime := ⟨hℓ⟩
  obtain ⟨F, hFcard, e, he⟩ :=
    KSConn.two_suN_exists_equiv_link (ν := ν) hℓ hn σQ hσQ hν
  have : Finite F :=
    Nat.finite_of_card_ne_zero (by rw [hFcard]; exact pow_ne_zero _ (pow_ne_zero _ hℓ.ne_zero))
  have hperf : Group.IsPerfect (StatedSU ν (ℓ ^ n) F) :=
    CFSG.ClassicalGroups.Unitary.isPerfect_statedSU (p := ℓ) (f := n) hFcard hν hνq
  have hZ := (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card (F := ↥F) (p := ℓ)
    (f := n) hFcard hν hνq).2
  let Φ₀ : StatedSU ν (ℓ ^ n) F →* G :=
    (MulAut.conj z).toMonoidHom.comp (ψ.comp (statedSUToSL F ν (ℓ ^ n)))
  have hmem : ∀ s, Φ₀ s ∈ J.map ι := fun s =>
    (hJ _).2 ⟨statedSUToSL F ν (ℓ ^ n) s, by rw [← he]; exact (e s).2, rfl⟩
  let eJ := J.equivMapOfInjective ι hι
  let Φ : StatedSU ν (ℓ ^ n) F →* J := eJ.symm.toMonoidHom.comp (Φ₀.codRestrict _ hmem)
  have hΦ : ∀ s, ι (Φ s) = z * ψ (statedSUToSL F ν (ℓ ^ n) s) * z⁻¹ := fun s => by
    have h1 : (eJ (Φ s) : G) = ι (Φ s) := J.coe_equivMapOfInjective_apply ι hι (Φ s)
    have h2 : eJ (Φ s) = Φ₀.codRestrict _ hmem s := eJ.apply_symm_apply _
    rw [← h1, h2]
    rfl
  have hsurj : Function.Surjective Φ := by
    intro l
    obtain ⟨Y, hY, hYl⟩ := (hJ (ι l)).1 (Subgroup.mem_map_of_mem ι l.2)
    refine ⟨e.symm ⟨Y, hY⟩, Subtype.ext (hι ?_)⟩
    rw [hΦ, ← he, MulEquiv.apply_symm_apply, hYl]
  have hkerΦ : Φ.ker ≤ Subgroup.center (StatedSU ν (ℓ ^ n) F) := by
    intro s hs
    have h1 : ψ (statedSUToSL F ν (ℓ ^ n) s) = 1 := by
      have h2 : ι (Φ s) = 1 := by
        rw [MonoidHom.mem_ker.1 hs, OneMemClass.coe_one, map_one]
      rw [hΦ] at h2
      exact conj_eq_one_iff.1 h2
    have hc := hker (MonoidHom.mem_ker.2 h1)
    rw [Subgroup.mem_center_iff]
    intro t
    apply statedSUToSL_injective F ν (ℓ ^ n)
    rw [map_mul, map_mul]
    exact Subgroup.mem_center_iff.1 hc _
  let χ : StatedSU ν (ℓ ^ n) F →* ↥J ⧸ Subgroup.center ↥J := (QuotientGroup.mk' _).comp Φ
  have hχ : Function.Surjective χ := (QuotientGroup.mk'_surjective _).comp hsurj
  have hkerχ : (StatedScalars (Fin ν) F).subgroupOf (StatedSU ν (ℓ ^ n) F) = χ.ker := by
    rw [← hZ, ← CFSG.LocalCores.comap_center_eq_of_perfect hperf Φ hsurj hkerΦ]
    ext s
    rw [Subgroup.mem_comap, MonoidHom.mem_ker]
    exact (QuotientGroup.eq_one_iff _).symm
  let θ' := (QuotientGroup.quotientMulEquivOfEq hkerχ).trans
    (QuotientGroup.quotientKerEquivOfSurjective χ hχ)
  exact ⟨F, hFcard, mem_subfield_iff_pow_eq_self hn hFcard, Φ, θ'.symm, hΦ,
    fun s => θ'.symm_apply_eq.2 rfl, hsurj, hkerΦ⟩

theorem exists_psu_equiv_of_conj_frame_of_subfield {Ω : Type} [Field Ω] [IsAlgClosed Ω]
    {ℓ : ℕ} (hℓ : ℓ.Prime) [CharP Ω ℓ] {n : ℕ} (hn : 1 ≤ n) {σQ : Ω ≃+* Ω}
    (hσQ : ∀ c, σQ c = c ^ ℓ ^ n) {ν : ℕ} (hν : 3 ≤ ν) (hνq : (ν, ℓ ^ n) ≠ (3, 2))
    {G : Type} [Group G] {ψ : SL(ν, Ω) →* G}
    (hker : ψ.ker ≤ Subgroup.center SL(ν, Ω)) (z : G) {L' : Type} [Group L']
    {J : Subgroup L'} {ι : L' →* G} (hι : Function.Injective ι)
    (hJ : ∀ g : G, g ∈ J.map ι ↔
      ∃ Y ∈ fixSubgroup (stdUnitaryEquiv (ν := ν) σQ), g = z * ψ Y * z⁻¹)
    {F : Subfield Ω} (hFcard : Nat.card F = (ℓ ^ n) ^ 2)
    (hF : ∀ c, c ∈ F ↔ c ^ (ℓ ^ n) ^ 2 = c) :
    ∃ (Φ : StatedSU ν (ℓ ^ n) F →* J)
      (θ : ↥J ⧸ Subgroup.center ↥J ≃* LargeEvenProj (LargeEvenSUGroup (Fin ν) F (ℓ ^ n))),
      (∀ s, ι (Φ s) = z * ψ (statedSUToSL F ν (ℓ ^ n) s) * z⁻¹) ∧
      (∀ s, θ (QuotientGroup.mk (Φ s)) =
        LargeEvenProjMk (LargeEvenSUGroup (Fin ν) F (ℓ ^ n)) s) ∧
      Function.Surjective Φ ∧ Φ.ker ≤ Subgroup.center (StatedSU ν (ℓ ^ n) F) := by
  obtain ⟨F', hF'card, hF'mem, Φ, θ, hΦ, hθ, hsurj, hker'⟩ :=
    exists_psu_equiv_of_conj_frame hℓ hn hσQ hν hνq hker z hι hJ
  have hFF' : F' = F := Subfield.ext fun a => by rw [hF'mem a, hF a]
  subst hFF'
  exact ⟨Φ, θ, hΦ, hθ, hsurj, hker'⟩

