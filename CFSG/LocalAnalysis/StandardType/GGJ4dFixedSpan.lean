theorem j4d_string_dichotomy
    {τ : Tag} (hτ : SimplyLacedTag τ) {f ν : Fin τ.rank → ℤ}
    (hf : IsRoot τ f) (hν : IsRoot τ ν) (hne : iform f ν ≠ 0)
    (hnot : f ≠ ν) (hnotneg : f ≠ -ν) :
    (iform f ν = 1 ∧ IsRoot τ (f - ν)) ∨ (iform f ν = -1 ∧ IsRoot τ (f + ν)) := by
  have hff : iform f f = 2 := iform_self_eq_two_of_simplyLaced' hτ hf
  have hνν : iform ν ν = 2 := iform_self_eq_two_of_simplyLaced' hτ hν
  have hlt := iform_sq_lt hf hν ?_ ?_
  · have h1 : iform f ν ≤ 1 := by nlinarith [hlt, hff, hνν]
    have h2 : -1 ≤ iform f ν := by nlinarith [hlt, hff, hνν]
    have hcases : iform f ν = 1 ∨ iform f ν = -1 := by omega
    rcases hcases with h | h
    · exact Or.inl ⟨h, isRoot_sub_of_iform_pos hf hν hnot (by rw [h]; norm_num)⟩
    · exact Or.inr ⟨h, isRoot_add_of_iform_neg hf hν hnotneg (by rw [h]; norm_num)⟩
  · intro h; exact hnot h
  · intro h; exact hnotneg h

theorem j4d_exists_fixed_moved_edge
    {τ : Tag} {Ψ F : Set (Fin τ.rank → ℤ)}
    (hΨ : IsRootComponent Ψ) (hFsub : F ⊆ Ψ) (hFne : F.Nonempty)
    (hMne : ∃ m, m ∈ Ψ ∧ m ∉ F) :
    ∃ f ∈ F, ∃ m ∈ Ψ, m ∉ F ∧ iform f m ≠ 0 := by
  by_contra h
  push_neg at h
  have hsplit := hΨ.irreducible F hFsub (fun α hα β hβ hβF => h α hα β hβ hβF)
  rcases hsplit with hF | hF
  · exact hFne.ne_empty hF
  · obtain ⟨m, hmΨ, hmF⟩ := hMne
    exact hmF (hF ▸ hmΨ)

end CFSG.StandardType.LangRat

