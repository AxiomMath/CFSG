theorem halfSplit_cases {p : ℕ} {lab : LargeEvenLabel} {c : Prop}
    (h : LargeEvenHalfSplit p lab c) :
    p ∣ 2 ^ lab.n - 1 ∨ p ∣ 2 ^ lab.n + 1 ∨ p = 3 ∨ (lab.tag = .A ∧ lab.n = 2 ∧ p = 5) ∨
      ((lab.tag = .A ∨ lab.tag = .E6) ∧ lab.n = 1 ∧ p = 7) := by
  rcases h with (h | h | h | h) | h | h | h | h | h
  · exact Or.inl h.2
  · exact Or.inr (Or.inl h.2.2)
  · exact Or.inl h.2
  · exact Or.inr (Or.inr (Or.inl h.2))
  · exact Or.inr (Or.inl h.2)
  · exact Or.inl h.2
  · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨h.1, h.2.2.1, h.2.2.2.2⟩)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨Or.inl h.1, h.2.2.1, h.2.2.2⟩)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨Or.inr h.1, h.2.1, h.2.2⟩)))

theorem markPSL_cases {lab : LargeEvenLabel} {f : ℕ} (hT : markTag lab = .PSL)
    (hC : markChar lab = 2) (hD : markDeg lab = f) :
    (lab.tag = .A ∧ lab.n = f) ∨ (lab.tag = .D ∧ lab.n = f) ∨ (lab.tag = .twD ∧ 2 * lab.n = f) := by
  obtain ⟨t, l, n⟩ := lab
  cases t <;> simp only [markTag, markChar, markDeg, reduceCtorEq] at hT hC hD ⊢
  · exact Or.inl ⟨trivial, hD⟩
  · exact Or.inr (Or.inl ⟨trivial, hD⟩)
  · split_ifs at hD with hl
    · exact Or.inr (Or.inr ⟨trivial, hD⟩)
    · simp only [hl, ite_false] at hT
      split_ifs at hT
  · omega

theorem eq_seven_of_halfSplit_markPSL {lab : LargeEvenLabel} {p f : ℕ} (hp3 : p ≠ 3)
    (hT : markTag lab = .PSL) (hC : markChar lab = 2) (hD : markDeg lab = f) {c : Prop}
    (h : LargeEvenHalfSplit p lab c) (hq1 : ¬ p ∣ 2 ^ f - 1) (hq2 : ¬ p ∣ 2 ^ f + 1) :
    f = 1 ∧ p = 7 := by
  have key := halfSplit_cases h
  rcases markPSL_cases hT hC hD with ⟨ht, hn⟩ | ⟨ht, hn⟩ | ⟨ht, hn⟩
  · rw [hn] at key
    rcases key with h1 | h1 | h1 | ⟨-, rfl, rfl⟩ | ⟨-, h1, h2⟩
    · exact absurd h1 hq1
    · exact absurd h1 hq2
    · exact absurd h1 hp3
    · exact absurd (by norm_num) hq2
    · exact ⟨h1, h2⟩
  · rw [hn] at key
    rcases key with h1 | h1 | h1 | ⟨h0, -, -⟩ | ⟨h0, -, -⟩
    · exact absurd h1 hq1
    · exact absurd h1 hq2
    · exact absurd h1 hp3
    · rw [ht] at h0
      exact absurd h0 (by decide)
    · rw [ht] at h0
      exact absurd h0 (by decide)
  · subst hn
    have e : 2 ^ (2 * lab.n) - 1 = (2 ^ lab.n + 1) * (2 ^ lab.n - 1) := by
      rw [pow_mul']
      simpa using Nat.sq_sub_sq (2 ^ lab.n) 1
    rcases key with h1 | h1 | h1 | ⟨h0, -, -⟩ | ⟨h0, -, -⟩
    · exact absurd (e ▸ h1.mul_left _) hq1
    · exact absurd (e ▸ h1.mul_right _) hq1
    · exact absurd h1 hp3
    · rw [ht] at h0
      exact absurd h0 (by decide)
    · rw [ht] at h0
      exact absurd h0 (by decide)

theorem lieModel_range_sl {G : Type} [Group G] {k f : ℕ} {D' : Type} [Field D'] [Finite D']
    (hD' : Nat.card D' = 2 ^ f) (hadm : StatedLieAdmissible .PSL (k + 1) 2 f)
    (hperf : commutator (SpecialLinearGroup (Fin (k + 1)) D') = ⊤)
    (ψ' : SpecialLinearGroup (Fin (k + 1)) D' →* G)
    (hker : ψ'.ker ≤ Subgroup.center (SpecialLinearGroup (Fin (k + 1)) D')) :
    LieModel (↥ψ'.range ⧸ Subgroup.center ↥ψ'.range) .PSL (k + 1) 2 f := by
  have hZ : Subgroup.center ↥ψ'.range =
      (Subgroup.center (SpecialLinearGroup (Fin (k + 1)) D')).map ψ'.rangeRestrict := by
    ext l
    obtain ⟨u, rfl⟩ := ψ'.rangeRestrict_surjective l
    constructor
    · intro hu
      exact ⟨u, InnerDiagA.mem_center_of_rangeRestrict_mem_center hperf ψ' hker hu, rfl⟩
    · rintro ⟨v, hv, hvu⟩
      rw [← hvu, Subgroup.mem_center_iff]
      intro l'
      obtain ⟨w, rfl⟩ := ψ'.rangeRestrict_surjective l'
      rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hv w]
  have e := CFSG.LieType.CurtisTits.centerQuotientEquivOfSurjective ψ'.rangeRestrict
    ψ'.rangeRestrict_surjective (by rw [MonoidHom.ker_rangeRestrict]; exact hker) hZ
  exact Or.inl ⟨by decide, statedClassicalModel_of_mulEquiv' e
    (CFSG.LieType.Universal.SpecialLinear.statedClassicalModel_center_quotient k D' hadm hD')⟩

theorem ne_three_of_not_dvd {p f : ℕ} (hq1 : ¬ p ∣ 2 ^ f - 1) (hq2 : ¬ p ∣ 2 ^ f + 1) :
    p ≠ 3 := by
  rintro rfl
  have h3 : 3 ∣ (2 ^ f + 1) * (2 ^ f - 1) := by
    have e : 4 ^ f - 1 = (2 ^ f + 1) * (2 ^ f - 1) := by
      rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_mul, pow_mul']
      simpa using Nat.sq_sub_sq (2 ^ f) 1
    rw [← e]
    simpa using Nat.sub_dvd_pow_sub_pow 4 1 f
  rcases (Nat.Prime.dvd_mul Nat.prime_three).mp h3 with h | h
  · exact hq2 h
  · exact hq1 h


theorem inndiagCommLinearLabel_of_markPSL {lab : LargeEvenLabel} {k : ℕ} (hk : 2 ≤ k)
    (hT : markTag lab = .PSL) (hC : markChar lab = 2) (hR : markRank lab = k + 1) :
    GGInndiagCommLinearLabel lab := by
  obtain ⟨t, l, n⟩ := lab
  cases t <;> simp only [markTag, markChar, markRank, reduceCtorEq] at hT hC hR
  all_goals first
    | exact Or.inl ⟨rfl, by dsimp only; omega⟩
    | omega
    | (by_cases hl : l = 3
       · exact Or.inr ⟨rfl, hl⟩
       · simp [hl] at hT)
    | (by_cases hl : l = 2
       · simp [hl] at hR
         omega
       · by_cases hl3 : l = 3 <;> simp [hl, hl3] at hT)

