theorem not_ggNbrClauseFiveMarking_sl {G : Type} [Group G] [Finite G] {k : ℕ} (hk : 1 ≤ k)
    {D' : Type} [Field D'] [Finite D'] {f : ℕ} (hf : 1 ≤ f) (hD' : Nat.card D' = 2 ^ f)
    (hk1 : k = 1 → 2 ≤ f)
    {ψ' : SpecialLinearGroup (Fin (k + 1)) D' →* G}
    (hker : ψ'.ker ≤ Subgroup.center (SpecialLinearGroup (Fin (k + 1)) D'))
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hq1 : ¬ p ∣ 2 ^ f - 1) (hq2 : ¬ p ∣ 2 ^ f + 1)
    (h7 : f = 1 → p ≠ 7) {x : G} {u : GL (Fin (k + 1)) D'}
    (hu : (x, u) ∈ LinFusion.ggInducedPairs ψ')
    (hcent : k = 1 → x ∈ Subgroup.centralizer (ψ'.range : Set G)) :
    ¬ GGNbrClauseFiveMarking p x ψ'.range := by
  have : CharP D' 2 := charP_two_of_card hD'
  have hp3 : p ≠ 3 := ne_three_of_not_dvd hq1 hq2
  have hgood : 3 ≤ k + 1 ∨ ∃ s : Finset D', s.card = 4 := by
    rcases Nat.lt_or_ge k 2 with hk2 | hk2
    · right
      have h4 : 4 ≤ Nat.card D' := by rw [hD']; exact four_le_two_pow (hk1 (by omega))
      have := Fintype.ofFinite D'
      obtain ⟨s, -, hs⟩ := Finset.exists_subset_card_eq (s := (Finset.univ : Finset D')) (n := 4)
        (by rw [Finset.card_univ, ← Nat.card_eq_fintype_card]; exact h4)
      exact ⟨s, hs⟩
    · exact Or.inl (by omega)
  have hperf : commutator (SpecialLinearGroup (Fin (k + 1)) D') = ⊤ :=
    Group.isPerfect_def.mp (CFSG.RankThree.PartOne.KCUnitary.isQuasisimple_SL (by omega) hgood).1
  have hadm : StatedLieAdmissible .PSL (k + 1) 2 f := by
    refine ⟨Nat.prime_two, hf, by omega, fun h => ?_, fun h => ?_⟩
    · simp only [Prod.mk.injEq] at h
      have h4 := four_le_two_pow (hk1 (by omega))
      omega
    · simp only [Prod.mk.injEq] at h
      exact two_pow_ne_three f h.2
  have hL := lieModel_range_sl hD' hadm hperf ψ' hker
  intro hmark
  rcases largeEvenMarking_or hmark with hHS | hPF
  ·
    obtain ⟨lab, hlab, R, _, I, F, θ, -, -, hHS', hMM⟩ := largeEvenMarking_exists_markedModel hHS
    have hX : MarkedModel lab (↥ψ'.range ⧸ Subgroup.center ↥ψ'.range) :=
      MarkedModel.of_mulEquiv θ.symm hMM
    by_cases hc : markChar lab = 2
    · have hdet : markTag lab = .PSL ∧ markRank lab = k + 1 ∧ markDeg lab = f := by
        rcases Nat.lt_or_ge k 2 with hk2 | hk2
        · obtain rfl : k = 1 := by omega
          have hX' : LieModel (↥ψ'.range ⧸ Subgroup.center ↥ψ'.range) (markTag lab)
              (markRank lab) 2 (markDeg lab) := by
            have h := hX
            unfold MarkedModel at h
            rwa [hc] at h
          exact CFSG.SeitzReduction.RankOne.sl2EvenTypeDet _ f _ _ _ hL
            (CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel hX') hX'
        · have hX' : LieModel (↥ψ'.range ⧸ Subgroup.center ↥ψ'.range) (markTag lab)
              (markRank lab) 2 (markDeg lab) := by
            have h := hX
            unfold MarkedModel at h
            rwa [hc] at h
          exact CFSG.SeitzReduction.LinearPilot.lieModel_PSL_two_unique (by omega) hL hX'
      obtain ⟨hf1, hp7⟩ := eq_seven_of_halfSplit_markPSL hp3 hdet.1 hc hdet.2.2 hHS' hq1 hq2
      exact h7 hf1 hp7
    ·
      obtain ⟨t, l, n⟩ := lab
      cases t
      all_goals first
        | exact absurd rfl hc
        | (obtain ⟨-, hl⟩ := hlab
           obtain ⟨-, hn⟩ := hl
           simp only at hn
           subst hn
           rcases halfSplit_cases hHS' with h1 | h1 | h1 | ⟨h0, -, -⟩ | ⟨h0 | h0, -, -⟩
           · exact hp.one_lt.ne' (Nat.dvd_one.mp (by simpa using h1))
           · exact hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp (by simpa using h1))
           · exact hp3 h1
           all_goals simp at h0)
  ·
    rcases Nat.lt_or_ge k 2 with hk2 | hk2
    · obtain rfl : k = 1 := by omega
      have hxc := hcent rfl
      obtain ⟨-, lab, hlab, hraw'⟩ := hPF
      obtain ⟨R, _, I, F, -, -, θ, -, f', -, u', -, hord, hind⟩ := largeEvenRawDatum_exists hraw'
      have h1 : u' * f' * u'⁻¹ = 1 := by
        ext r
        obtain ⟨q, rfl⟩ := θ.surjective r
        obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective q
        have hl : (l : G) = x⁻¹ * l * x := by
          rw [mul_assoc, Subgroup.mem_centralizer_iff.mp hxc (l : G) l.2, inv_mul_cancel_left]
        simpa using hind l l hl
      have hf1 : f' = 1 := by
        calc f' = u'⁻¹ * (u' * f' * u'⁻¹) * u' := by group
          _ = 1 := by rw [h1]; group
      rw [hf1, orderOf_one] at hord
      exact hp.one_lt.ne hord
    ·
      have hS : ∀ (lab : LargeEvenLabel) (R : Type) [Group R] (I F : Set (MulAut R))
          (θ : ↥ψ'.range ⧸ Subgroup.center ↥ψ'.range ≃* R),
          (LargeEvenPrimeField p lab I F (LargeEvenInduces θ fun j j' => (j' : G) = x⁻¹ * j * x) ∧
            MarkedModel lab R) →
          GGInndiagCommLinearLabel lab ∨ lab.tag = .B2der ∨ lab.tag = .G2der := by
        intro lab R _ I F θ hP
        have hX : MarkedModel lab (↥ψ'.range ⧸ Subgroup.center ↥ψ'.range) :=
          MarkedModel.of_mulEquiv θ.symm hP.2
        by_cases hc : markChar lab = 2
        · have hX' : LieModel (↥ψ'.range ⧸ Subgroup.center ↥ψ'.range) (markTag lab)
              (markRank lab) 2 (markDeg lab) := by
            have h := hX
            unfold MarkedModel at h
            rwa [hc] at h
          obtain ⟨hT, hR, -⟩ :=
            CFSG.SeitzReduction.LinearPilot.lieModel_PSL_two_unique (by omega) hL hX'
          exact Or.inl (inndiagCommLinearLabel_of_markPSL hk2 hT hc hR)
        · right
          obtain ⟨t, l, n⟩ := lab
          cases t <;> first | exact absurd rfl hc | simp
      have hall : ∀ lab, LargeEvenInLambda2 lab →
          (GGInndiagCommLinearLabel lab ∨ lab.tag = .B2der ∨ lab.tag = .G2der) →
          LargeEvenLabelAll lab fun R _ I F => (∀ φ ∈ F, φ = 1) ∨
            (LargeEvenSimpleGuard GGInndiagCommEq R I F ∧ GGRawInnField p R I F) := by
        intro lab hlab hS
        rcases hS with hlin | hB | hG2
        · refine LargeEvenLabelAll.mono (fun R _ I F h => Or.inr h)
            (largeEvenLabelAll_and (largeEvenLabelAll_inndiagComm_linear hlin)
              (ggRawInnFieldOn_linear p hp hp2 lab hlab ?_))
          rcases hlin with ⟨h, -⟩ | ⟨h, hl⟩
          · exact Or.inl h
          · exact Or.inr (Or.inl ⟨h, hl⟩)
        · exact largeEvenLabelAll_b2der hB fun K _ _ hK =>
            Or.inl fun φ hφ => matFieldImage_eq_one_of_card_two hK _ hφ
        · exact largeEvenLabelAll_smallExc hlab (Or.inl hG2) fun A K _ _ hK H =>
            Or.inl fun φ hφ => chevFieldImage_eq_one_of_card_two hK H hφ
      have hPF' := largeEvenMarking_and_labelAll hall hS (largeEvenMarking_markedModel hPF)
      obtain ⟨-, lab, hlab, hraw'⟩ := hPF'
      obtain ⟨R, _, I, F, hs, hna, θ, ⟨⟨-, f', hf', u', hu', hord, hind⟩, -⟩, hP'⟩ :=
        largeEvenRawDatum_exists hraw'
      rcases hP' with htriv | ⟨hcomm, hRIF⟩
      · rw [htriv f' hf', orderOf_one] at hord
        exact hp.one_lt.ne hord
      obtain ⟨hmul, hinv, hinn, hnot⟩ := hRIF hs hna
      have hZ : Subgroup.center ↥ψ'.range =
          (Subgroup.center (SpecialLinearGroup (Fin (k + 1)) D')).map ψ'.rangeRestrict := by
        ext l
        obtain ⟨w, rfl⟩ := ψ'.rangeRestrict_surjective l
        constructor
        · intro hw
          exact ⟨w, InnerDiagA.mem_center_of_rangeRestrict_mem_center hperf ψ' hker hw, rfl⟩
        · rintro ⟨v, hv, hvw⟩
          rw [← hvw, Subgroup.mem_center_iff]
          intro l'
          obtain ⟨w', rfl⟩ := ψ'.rangeRestrict_surjective l'
          rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hv w']
      have hcomp : Function.Surjective
          ((QuotientGroup.mk' (Subgroup.center ↥ψ'.range)).comp ψ'.rangeRestrict) :=
        (QuotientGroup.mk'_surjective _).comp ψ'.rangeRestrict_surjective
      have hkerc : ((QuotientGroup.mk' (Subgroup.center ↥ψ'.range)).comp ψ'.rangeRestrict).ker =
          Subgroup.center (SpecialLinearGroup (Fin (k + 1)) D') := by
        rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk', hZ,
          Subgroup.comap_map_eq_self (by rw [MonoidHom.ker_rangeRestrict]; exact hker)]
      set ε : CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL (k + 1) D' ≃*
          ↥ψ'.range ⧸ Subgroup.center ↥ψ'.range :=
        (QuotientGroup.quotientMulEquivOfEq
          ((CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center (k + 1) D').trans
            hkerc.symm)).trans (QuotientGroup.quotientKerEquivOfSurjective _ hcomp) with hεdef
      have hε : ∀ s, ε (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (k + 1) D' s) =
          QuotientGroup.mk (ψ'.rangeRestrict s) := fun s => by
        simp only [hεdef, MulEquiv.trans_apply, CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj,
          QuotientGroup.mk'_apply, QuotientGroup.quotientMulEquivOfEq_mk]
        rfl
      have hcongr : MulAut.congr (ε.trans θ)
          (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.conjAut (k + 1) D' u⁻¹) =
            u' * f' * u'⁻¹ := by
        ext r
        obtain ⟨q, rfl⟩ := θ.surjective r
        obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective q
        obtain ⟨s, rfl⟩ := ψ'.rangeRestrict_surjective l
        have hpair := LinFusion.mem_ggInducedPairs.mp
          (by simpa using (LinFusion.ggInducedPairs ψ').inv_mem hu) s
        have hss : InnerDiagA.conjSL u⁻¹ s =
            CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation (k + 1) D'
              u⁻¹ s := by
          apply Subtype.ext
          rw [InnerDiagA.coe_conjSL,
            CFSG.LocalAnalysis.ComponentInitial.LinearFlag.coe_slConjugation]
        rw [hind (ψ'.rangeRestrict s) (ψ'.rangeRestrict (InnerDiagA.conjSL u⁻¹ s)) (by
          show ψ' (InnerDiagA.conjSL u⁻¹ s) = x⁻¹ * ψ' s * x
          rw [← hpair, inv_inv])]
        rw [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply]
        have e1 : (ε.trans θ).symm (θ (QuotientGroup.mk (ψ'.rangeRestrict s))) =
            CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (k + 1) D' s := by
          rw [MulEquiv.symm_apply_eq, MulEquiv.trans_apply, hε]
        rw [e1, CFSG.LocalAnalysis.ComponentInitial.LinearFlag.conjAut_proj, ← hss,
          MulEquiv.trans_apply, hε]
      have hcomm' : u' * f' * u'⁻¹ ∈ ggInndiagComm R := by
        rw [← hcongr]
        exact (mem_ggInndiagComm_congr_iff (ε.trans θ) _).mp (conjAut_mem_ggInndiagComm u⁻¹)
      have hI : u' * f' * u'⁻¹ ∈ I :=
        (ggL45_mem_ggInndiag_iff hmul hinv hinn).mp (by rw [hcomm hs hna]; exact hcomm')
      refine hnot f' hf' hord ?_
      have h1 := hmul _ (hmul _ (hinv _ hu') _ hI) _ hu'
      rwa [show u'⁻¹ * (u' * f' * u'⁻¹) * u' = f' by group] at h1

end Main

