lemma ggOmegaBlk_adjoin_commute_commutant {K V : Type} [Field K] [AddCommGroup V]
    [Module K V] (x : Module.End K V) :
    ∀ z ∈ Algebra.adjoin K ({x} : Set (Module.End K V)),
      ∀ w ∈ commutant x, z * w = w * z := by
  intro z hz
  refine Algebra.adjoin_induction (p := fun z _ => ∀ w ∈ commutant x, z * w = w * z)
    ?_ ?_ ?_ ?_ hz
  · intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    intro w hw
    rw [Subalgebra.mem_centralizer_iff] at hw
    exact hw x (Set.mem_singleton x)
  · intro c w _
    exact (Algebra.commute_algebraMap_left c w).eq
  · intro y z hy hz ihy ihz w hw
    rw [add_mul, mul_add, ihy w hw, ihz w hw]
  · intro y z hy hz ihy ihz w hw
    rw [mul_assoc, ihz w hw, ← mul_assoc, ihy w hw, mul_assoc]

lemma ggOmegaBlk_primaryProjection_mem_adjoin {K V : Type} [Field K] [AddCommGroup V]
    [Module K V] (x : Module.End K V) (a : K[X]) :
    primaryProjection x a ∈ Algebra.adjoin K ({x} : Set (Module.End K V)) := by
  unfold primaryProjection
  exact ((primaryIdempotent x a).aeval x :
    Algebra.adjoin K ({x} : Set (Module.End K V))).2

lemma ggOmegaBlk_primaryProjection_idem {K V : Type} [Field K] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {x : Module.End K V} (hsq : Squarefree (minpoly K x))
    {a : K[X]} (ha : a ∈ primaryFactors x) : IsIdempotentElem (primaryProjection x a) :=
  primaryProjection_mul_self hsq ha

lemma ggOmegaBlk_adjoin_le_commutant {K V : Type} [Field K] [AddCommGroup V]
    [Module K V] (x : Module.End K V) :
    Algebra.adjoin K ({x} : Set (Module.End K V)) ≤ commutant x := by
  refine Algebra.adjoin_le ?_
  intro y hy
  rw [Set.mem_singleton_iff] at hy
  rw [hy]
  exact (mem_commutant x).mpr (Commute.refl x)

lemma ggOmegaBlk_primaryProjection_mul_eq_zero {K V : Type} [Field K] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {x : Module.End K V} (hsq : Squarefree (minpoly K x))
    {a b : K[X]} (ha : a ∈ primaryFactors x) (hb : b ∈ primaryFactors x) (hab : a ≠ b) :
    primaryProjection x a * primaryProjection x b = 0 := by
  apply LinearMap.ext
  intro v
  rw [Module.End.mul_apply, LinearMap.zero_apply]
  exact primaryProjection_of_mem_ne hsq ha hb (Ne.symm hab) (primaryProjection_mem hsq hb v)

lemma ggOmegaBlk_isPrimIdem_map {K : Type} [Field K] {ι : Type} [Fintype ι] [DecidableEq ι]
    {V : Type} [AddCommGroup V] [Module K V]
    (φ : Matrix ι ι K ≃ₐ[K] Module.End K V)
    {A : Subalgebra K (Matrix ι ι K)} {e : Matrix ι ι K} (he : IsPrimIdemIn A e) :
    ∀ e' ∈ A.map φ, IsIdempotentElem e' → e' * (φ e) = e' → e' = 0 ∨ e' = φ e := by
  intro e' he' hid' he'e
  rw [Subalgebra.mem_map] at he'
  obtain ⟨a, ha, hφa⟩ := he'
  rw [← hφa] at hid' he'e ⊢
  have haid : IsIdempotentElem a := by
    rw [isIdempotentElem_iff] at hid' ⊢
    exact φ.injective (by rw [map_mul]; exact hid')
  have hae : a * e = a := by
    apply φ.injective
    rw [map_mul]
    exact he'e
  rcases he.2.2.2 a ha haid hae with h0 | heq
  · left; rw [h0, map_zero]
  · right; rw [heq]; rfl

lemma ggOmegaBlk_toLinAlgEquiv'_eq_toLin' {K : Type} [Field K] {ι : Type}
    [Fintype ι] [DecidableEq ι] (M : Matrix ι ι K) :
    Matrix.toLinAlgEquiv' M = Matrix.toLin' M := by
  apply LinearMap.ext
  intro v
  rw [Matrix.toLinAlgEquiv'_apply, Matrix.toLin'_apply]

lemma ggOmegaBlk_toLinEquiv_toLinearMap {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (u : GL ι K) :
    (CFSG.ClassicalGroups.Orthogonal.toLinEquiv ι K u).toLinearMap =
      Matrix.toLin' (u : Matrix ι ι K) := by
  apply LinearMap.ext
  intro v
  show (CFSG.ClassicalGroups.Orthogonal.toLinEquiv ι K u) v =
    Matrix.toLin' (u : Matrix ι ι K) v
  rw [CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply, Matrix.toLin'_apply]

lemma ggOmegaBlk_prim_idem_eq_primaryProjection
    {K : Type} [Field K] {ι : Type} [Fintype ι] [DecidableEq ι]
    (b : GL ι K)
    (hsq : Squarefree (minpoly K (Matrix.toLin' (b : Matrix ι ι K))))
    {e : Matrix ι ι K}
    (he : IsPrimIdemIn (Algebra.adjoin K (Units.val '' ({b} : Set (GL ι K)))) e) :
    ∃ a ∈ primaryFactors (Matrix.toLin' (b : Matrix ι ι K)),
      Matrix.toLinAlgEquiv' e = primaryProjection (Matrix.toLin' (b : Matrix ι ι K)) a := by
  classical
  let x : Module.End K (ι → K) := Matrix.toLin' (b : Matrix ι ι K)
  let φ : Matrix ι ι K ≃ₐ[K] Module.End K (ι → K) := Matrix.toLinAlgEquiv'
  let A : Subalgebra K (Matrix ι ι K) :=
    Algebra.adjoin K (Units.val '' ({b} : Set (GL ι K)))
  let A' : Subalgebra K (Module.End K (ι → K)) :=
    Algebra.adjoin K ({x} : Set (Module.End K (ι → K)))
  have hφb : φ (b : Matrix ι ι K) = x := by
    show Matrix.toLinAlgEquiv' (b : Matrix ι ι K) = Matrix.toLin' (b : Matrix ι ι K)
    rw [ggOmegaBlk_toLinAlgEquiv'_eq_toLin']
  have hA' : A.map φ = A' := by
    rw [AlgHom.map_adjoin]
    simp only [A, A', Set.image_singleton, AlgEquiv.coe_toAlgHom, hφb]
  have heA : φ e ∈ A' := by
    rw [← hA']
    exact ⟨e, he.1, rfl⟩
  have heidem : IsIdempotentElem (φ e) := by
    rw [isIdempotentElem_iff]
    rw [← map_mul, he.2.1.eq]
  have hene : φ e ≠ 0 := by
    intro h
    exact he.2.2.1 (φ.injective (by rw [h, map_zero]))
  have he_comm : φ e ∈ commutant x := ggOmegaBlk_adjoin_le_commutant x heA
  have hprim : ∀ e' ∈ A', IsIdempotentElem e' → e' * (φ e) = e' → e' = 0 ∨ e' = φ e := by
    rw [← hA']
    exact ggOmegaBlk_isPrimIdem_map φ he
  have hsum : ∑ a ∈ primaryFactors x, primaryProjection x a = 1 := sum_primaryProjection hsq
  have heq_sum : φ e = ∑ a ∈ primaryFactors x, φ e * primaryProjection x a := by
    rw [← Finset.mul_sum, hsum, mul_one]
  have hterm : ∀ a ∈ primaryFactors x,
      φ e * primaryProjection x a = 0 ∨ φ e * primaryProjection x a = φ e := by
    intro a ha
    have hPmem : primaryProjection x a ∈ A' := ggOmegaBlk_primaryProjection_mem_adjoin x a
    have hPidem : IsIdempotentElem (primaryProjection x a) :=
      ggOmegaBlk_primaryProjection_idem hsq ha
    have htmem : φ e * primaryProjection x a ∈ A' := A'.mul_mem heA hPmem
    have hcomm : primaryProjection x a * φ e = φ e * primaryProjection x a := by
      have h := mul_comm' (⟨primaryProjection x a, hPmem⟩ : ↥A') (⟨φ e, heA⟩ : ↥A')
      exact congrArg Subtype.val h
    have htidem : IsIdempotentElem (φ e * primaryProjection x a) :=
      IsIdempotentElem.mul_of_commute hcomm.symm heidem hPidem
    have hte : (φ e * primaryProjection x a) * φ e = φ e * primaryProjection x a := by
      rw [mul_assoc, hcomm, ← mul_assoc, heidem.eq]
    exact hprim _ htmem htidem hte
  obtain ⟨a₀, ha₀, ha₀e⟩ : ∃ a ∈ primaryFactors x,
      φ e * primaryProjection x a = φ e := by
    by_contra hcon
    push Not at hcon
    have hall : ∀ a ∈ primaryFactors x, φ e * primaryProjection x a = 0 :=
      fun a ha => (hterm a ha).resolve_right (hcon a ha)
    rw [Finset.sum_eq_zero hall] at heq_sum
    exact hene heq_sum
  have hpc : IsPrimitiveCentralIdempotent K (primaryProjectionR x a₀) :=
    (isPrimitiveCentralIdempotent_iff hsq _).mpr ⟨a₀, ha₀, rfl⟩
  have hg_center : (⟨φ e, he_comm⟩ : commutant x) ∈ Subalgebra.center K (commutant x) := by
    rw [Subalgebra.mem_center_iff]
    intro z
    apply Subtype.ext
    change (z : Module.End K (ι → K)) * φ e = φ e * (z : Module.End K (ι → K))
    exact (ggOmegaBlk_adjoin_commute_commutant x (φ e) heA (z : Module.End K (ι → K)) z.2).symm
  have hg_idem : IsIdempotentElem (⟨φ e, he_comm⟩ : commutant x) := by
    rw [isIdempotentElem_iff]
    apply Subtype.ext
    exact heidem.eq
  have hg_mul : (⟨φ e, he_comm⟩ : commutant x) * primaryProjectionR x a₀ =
      ⟨φ e, he_comm⟩ := by
    apply Subtype.ext
    exact ha₀e
  rcases hpc.2.2.2 _ hg_center hg_idem hg_mul with h0 | heq
  · exact absurd (congrArg Subtype.val h0) hene
  · refine ⟨a₀, ?_, ?_⟩
    · simpa [x] using ha₀
    · have h : Matrix.toLinAlgEquiv' e = primaryProjection x a₀ :=
        congrArg Subtype.val heq
      simpa [x] using h

lemma ggOmegaBlk_G_isUnit_det {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate) :
    IsUnit (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).det := by
  have hEqB : Matrix.toLinearMap₂' K (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ))
      = QuadraticMap.polarBilin Φ := by
    rw [show LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)
      = LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Φ) from rfl]
    exact Matrix.toLinearMap₂'_toMatrix' _
  have hJnd : (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).Nondegenerate := by
    refine ⟨Matrix.separatingLeft_def.mpr fun v hv => ?_,
      Matrix.separatingRight_def.mpr fun w hw => ?_⟩
    · apply hΦ.1 v
      intro w
      have h := hv w
      rwa [← Matrix.toLinearMap₂'_apply'
        (M := LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)), hEqB] at h
    · apply hΦ.2 w
      intro v
      have h := hw v
      rwa [← Matrix.toLinearMap₂'_apply'
        (M := LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)), hEqB] at h
  exact isUnit_iff_ne_zero.mpr (Matrix.nondegenerate_iff_det_ne_zero.mp hJnd)

lemma ggOmegaBlk_G_transpose {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) :
    Matrix.transpose ((LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).map (RingHom.id K))
      = LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ) := by
  rw [show (⇑(RingHom.id K) : K → K) = id from rfl, Matrix.map_id]
  ext i j
  rw [Matrix.transpose_apply, LinearMap.toMatrix₂'_apply, LinearMap.toMatrix₂'_apply]
  exact QuadraticMap.polar_comm Φ (Pi.single j 1) (Pi.single i 1)

lemma ggOmegaBlk_polar_eq_dot {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) (x y : ι → K) :
    QuadraticMap.polar Φ x y =
      dotProduct x ((LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).mulVec y) := by
  have h1 : (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)) =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Φ) := rfl
  rw [h1]
  rw [← Matrix.toBilin'_apply' (LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Φ)) x y,
    Matrix.toBilin'_toMatrix', QuadraticMap.polarBilin_apply_apply]

lemma ggOmegaBlk_formAdj_id {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (G a : Matrix ι ι K) : formAdj (RingHom.id K) G a = G⁻¹ * a.transpose * G := by
  unfold formAdj
  rw [show a.map (⇑(RingHom.id K)) = a from by ext i j; rfl]

lemma ggOmegaBlk_formAdj_mulVec {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    {G a : Matrix ι ι K} (hG : IsUnit G.det) (y : ι → K) :
    G.mulVec ((formAdj (RingHom.id K) G a).mulVec y) = a.transpose.mulVec (G.mulVec y) := by
  have hmat : G * (G⁻¹ * a.transpose * G) = a.transpose * G := by
    rw [← Matrix.mul_assoc G (G⁻¹ * a.transpose) G,
      ← Matrix.mul_assoc G G⁻¹ a.transpose, Matrix.mul_nonsing_inv G hG, Matrix.one_mul]
  rw [ggOmegaBlk_formAdj_id, Matrix.mulVec_mulVec, hmat, Matrix.mulVec_mulVec]

lemma ggOmegaBlk_dotProduct_mulVec_transpose {ι K : Type} [Fintype ι] [CommSemiring K]
    (M : Matrix ι ι K) (x y : ι → K) :
    dotProduct (M.mulVec x) y = dotProduct x (M.transpose.mulVec y) := by
  exact ((Matrix.dotProduct_mulVec x M.transpose y).trans
    (by rw [Matrix.vecMul_transpose])).symm

lemma ggOmegaBlk_formAdj_apply {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K))
    (hG : IsUnit (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).det)
    (a : Matrix ι ι K) (x y : ι → K) :
    QuadraticMap.polar Φ (a.mulVec x) y =
      QuadraticMap.polar Φ x ((formAdj (RingHom.id K)
        (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)) a).mulVec y) := by
  rw [ggOmegaBlk_polar_eq_dot Φ, ggOmegaBlk_polar_eq_dot Φ,
    ggOmegaBlk_dotProduct_mulVec_transpose a x
      ((LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).mulVec y),
    ggOmegaBlk_formAdj_mulVec hG y]

lemma ggOmegaBlk_polar_selfAdjoint {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K))
    (hG : IsUnit (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).det)
    {E : Matrix ι ι K}
    (hE : formAdj (RingHom.id K)
      (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)) E = E) (x y : ι → K) :
    QuadraticMap.polar Φ (E.mulVec x) y = QuadraticMap.polar Φ x (E.mulVec y) := by
  rw [ggOmegaBlk_formAdj_apply Φ hG E x y, hE]

lemma ggOmegaBlk_blk_isometry {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K))
    (hG : IsUnit (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).det)
    {E A : Matrix ι ι K} (hEid : IsIdempotentElem E)
    (hEadj : formAdj (RingHom.id K)
      (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)) E = E)
    (hAE : A * E = E * A) (hAiso : ∀ v, Φ (A.mulVec v) = Φ v) :
    ∀ v, Φ ((A * E + (1 - E)).mulVec v) = Φ v := by
  intro v
  have hE1 : E * (1 - E) = 0 := by
    rw [Matrix.mul_sub, Matrix.mul_one, hEid, sub_self]
  have hE1mul : E.mulVec ((1 - E).mulVec v) = 0 := by
    rw [Matrix.mulVec_mulVec, hE1, Matrix.zero_mulVec]
  have hsplit1 : (1 - E).mulVec v = v - E.mulVec v := by
    rw [Matrix.sub_mulVec, Matrix.one_mulVec]
  have hX : (A * E + (1 - E)).mulVec v =
      A.mulVec (E.mulVec v) + (1 - E).mulVec v := by
    rw [Matrix.add_mulVec, ← Matrix.mulVec_mulVec]
  rw [hX, QuadraticMap.map_add (⇑Φ)]
  have hQA : Φ (A.mulVec (E.mulVec v)) = Φ (E.mulVec v) := hAiso _
  have hpolar : QuadraticMap.polar Φ (A.mulVec (E.mulVec v)) ((1 - E).mulVec v) = 0 := by
    have hAu : A.mulVec (E.mulVec v) = E.mulVec (A.mulVec v) := by
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hAE]
    rw [hAu, ggOmegaBlk_polar_selfAdjoint Φ hG hEadj (A.mulVec v) ((1 - E).mulVec v),
      hE1mul]
    exact QuadraticMap.polar_zero_right Φ (A.mulVec v)
  have hQv : Φ v = Φ (E.mulVec v) + Φ ((1 - E).mulVec v) := by
    have hvs : v = E.mulVec v + (1 - E).mulVec v := by
      rw [hsplit1]
      abel
    conv_lhs => rw [hvs]
    rw [QuadraticMap.map_add (⇑Φ),
      ggOmegaBlk_polar_selfAdjoint Φ hG hEadj v ((1 - E).mulVec v), hE1mul,
      QuadraticMap.polar_zero_right, add_zero]
  rw [hQA, hpolar, add_zero, hQv]

lemma ggOmegaBlk_polar_primaryProjection_reciprocal
    {K V : Type} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} {p : ℕ} {x : V ≃ₗ[K] V} (hx : OddOrderIsometry Q p x)
    {r : K[X]} (hr : r ∈ primaryFactors x.toLinearMap) {u : V}
    (hu : u ∈ primaryComponent x.toLinearMap r) (y : V) :
    QuadraticMap.polar Q u y =
      QuadraticMap.polar Q u (primaryProjection x.toLinearMap (reciprocalPolynomial r) y) := by
  classical
  have hsum : y = ∑ a ∈ primaryFactors x.toLinearMap, primaryProjection x.toLinearMap a y := by
    have := LinearMap.congr_fun (sum_primaryProjection hx.squarefree_minpoly) y
    rw [LinearMap.sum_apply] at this
    simpa using this.symm
  have h := map_sum (QuadraticMap.polarBilin Q u)
    (fun a => primaryProjection x.toLinearMap a y) (primaryFactors x.toLinearMap)
  simp only [QuadraticMap.polarBilin_apply_apply] at h
  conv_lhs => rw [hsum]
  rw [h, Finset.sum_eq_single (reciprocalPolynomial r)]
  · intro a ha har
    exact hx.polar_primaryComponent_eq_zero hr ha har hu
      (primaryProjection_mem hx.squarefree_minpoly ha y)
  · intro hr'
    exact absurd (hx.reciprocalPolynomial_mem hr) hr'

lemma ggOmegaBlk_polar_adjoint_primaryProjection
    {K V : Type} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} {p : ℕ} {x : V ≃ₗ[K] V} (hx : OddOrderIsometry Q p x)
    {c : K[X]} (hc : c ∈ primaryFactors x.toLinearMap) (u w : V) :
    QuadraticMap.polar Q (primaryProjection x.toLinearMap c u) w =
      QuadraticMap.polar Q u (primaryProjection x.toLinearMap (reciprocalPolynomial c) w) := by
  have h1 := ggOmegaBlk_polar_primaryProjection_reciprocal hx hc
    (primaryProjection_mem hx.squarefree_minpoly hc u) w
  have hc' := hx.reciprocalPolynomial_mem hc
  have h2 := ggOmegaBlk_polar_primaryProjection_reciprocal hx hc'
    (primaryProjection_mem hx.squarefree_minpoly hc' w) u
  rw [hx.reciprocal_reciprocal_eq hc] at h2
  calc QuadraticMap.polar Q (primaryProjection x.toLinearMap c u) w
      = QuadraticMap.polar Q (primaryProjection x.toLinearMap c u)
          (primaryProjection x.toLinearMap (reciprocalPolynomial c) w) := h1
    _ = QuadraticMap.polar Q (primaryProjection x.toLinearMap (reciprocalPolynomial c) w)
          (primaryProjection x.toLinearMap c u) := QuadraticMap.polar_comm Q _ _
    _ = QuadraticMap.polar Q (primaryProjection x.toLinearMap (reciprocalPolynomial c) w) u :=
          h2.symm
    _ = QuadraticMap.polar Q u (primaryProjection x.toLinearMap (reciprocalPolynomial c) w) :=
          QuadraticMap.polar_comm Q _ _

lemma ggOmegaBlk_matrix_adjoint_primaryProjection
    {K : Type} [Field K] {ι : Type} [Fintype ι] [DecidableEq ι]
    (Φ : QuadraticForm K (ι → K)) (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    {p : ℕ} {x : (ι → K) ≃ₗ[K] (ι → K)} (hx : OddOrderIsometry Φ p x)
    {c : K[X]} (hc : c ∈ primaryFactors x.toLinearMap) {e : Matrix ι ι K}
    (hae : Matrix.toLinAlgEquiv' e = primaryProjection x.toLinearMap c) :
    Matrix.toLinAlgEquiv' (formAdj (RingHom.id K)
      (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)) e) =
      primaryProjection x.toLinearMap (reciprocalPolynomial c) := by
  have hG : IsUnit (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)).det :=
    ggOmegaBlk_G_isUnit_det Φ hΦ
  rw [ggOmegaBlk_toLinAlgEquiv'_eq_toLin']
  apply LinearMap.ext
  intro w
  rw [← sub_eq_zero]
  apply hΦ.1
  intro u
  rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar_sub_left, sub_eq_zero]
  rw [QuadraticMap.polar_comm Φ _ u, QuadraticMap.polar_comm Φ _ u]
  have h1 : QuadraticMap.polar Φ u (Matrix.toLin' (formAdj (RingHom.id K)
      (LinearMap.toMatrix₂' K (QuadraticMap.polarBilin Φ)) e) w) =
      QuadraticMap.polar Φ (e.mulVec u) w := by
    rw [Matrix.toLin'_apply, ← ggOmegaBlk_formAdj_apply Φ hG e u w]
  rw [h1, ← ggOmegaBlk_polar_adjoint_primaryProjection hx hc u w,
    ← Matrix.toLinAlgEquiv'_apply, hae]

lemma ggOmegaBlk_threeSingular
    {ι K : Type} [Fintype ι] [Field K] [Fintype K] [CharP K 2]
    (Φ : QuadraticForm K (ι → K)) (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h8 : 8 ≤ Fintype.card ι) :
    ∃ T : Submodule K (ι → K), Module.finrank K T = 3 ∧ ∀ u ∈ T, Φ u = 0 := by
  have hdim : Module.finrank K (ι → K) = Fintype.card ι := Module.finrank_fintype_fun_eq_card K
  obtain ⟨m, hm⟩ := CFSG.ComponentClassification.UnbalancedCatalog.even_finrank_of_charTwo Φ hΦ
  have hm2 : Module.finrank K (ι → K) = 2 * m := by omega
  have hm4 : 4 ≤ m := by omega
  exact CFSG.RankThree.PartOne.exists_threeSingular_of_dim Φ hΦ hm4 hm2

lemma ggOmegaBlk_supportedBlock_le_orthDerived
    {ι K : Type} [Fintype ι] [Field K] [Fintype K] [CharP K 2]
    (Φ : QuadraticForm K (ι → K)) (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h8 : 8 ≤ Fintype.card ι)
    {p : ℕ} {x : (ι → K) ≃ₗ[K] (ι → K)} (hx : OddOrderIsometry Φ p x)
    (hp2 : Odd p) {a : K[X]} (ha : a ∈ primaryFactors x.toLinearMap)
    (hne1 : a ≠ X - 1) :
    supportedBlock Φ x a ≤ orthDerived Φ := by
  intro g hg
  apply CFSG.RankThree.PartOne.FieldFix.omegaGroup_le_orthDerived hΦ
    (ggOmegaBlk_threeSingular Φ hΦ h8)
  rw [mem_omegaGroup]
  exact ⟨(Subgroup.mem_inf.mp (mem_supportedBlock.mp hg).1).1,
    hx.even_finrank_commSpace_of_mem_supportedBlock hp2 ha hne1 hg⟩

lemma ggOmegaBlk_mem_glFixing_iff {K : Type} [Field K] {ι : Type} [Fintype ι]
    [DecidableEq ι] (u : GL ι K) (P : Matrix ι ι K) :
    u ∈ glFixing P ↔
      ∀ v, Matrix.toLin' (u : Matrix ι ι K) (Matrix.toLin' P v) = Matrix.toLin' P v := by
  constructor
  · intro h v
    rw [← Matrix.toLin'_mul_apply (u : Matrix ι ι K) P v, h]
  · intro h
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_mul_apply, h v]

lemma ggOmegaBlk_toLin_one_sub {K : Type} [Field K] {ι : Type} [Fintype ι] [DecidableEq ι]
    (ε : Matrix ι ι K) :
    Matrix.toLin' (1 - ε : Matrix ι ι K) = 1 - Matrix.toLin' ε := by
  apply LinearMap.ext
  intro v
  rw [Matrix.toLin'_apply, Matrix.sub_mulVec, Matrix.one_mulVec, LinearMap.sub_apply,
    Module.End.one_apply, Matrix.toLin'_apply]

