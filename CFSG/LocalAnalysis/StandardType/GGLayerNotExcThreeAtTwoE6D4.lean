theorem closure_rootReflection_le_rootCharStabilizer {a : Fin Tag.E6.rank → Lˣ}
    {Ψ : Set (Fin Tag.E6.rank → ℤ)} (hker : ∀ γ ∈ Ψ, IsRoot Tag.E6 γ ∧ rootChar a γ = 1) :
    Subgroup.closure {s : WeylGroup Tag.E6 | ∃ γ ∈ Ψ, s = rootReflection γ} ≤
      rootCharStabilizerSubgroup a := by
  refine (Subgroup.closure_le _).2 ?_
  rintro _ ⟨γ, hγ, rfl⟩
  obtain ⟨w, j, hwj⟩ := isRoot_iff_exists_smul_single.1 (hker γ hγ).1
  refine kernelReflectionGroup_le a ?_
  rw [← hwj, ← conj_simple_eq_rootReflection]
  exact Subgroup.subset_closure ⟨w, j, hwj ▸ hker γ hγ, rfl⟩

theorem eq_one_of_fix_d4Nodes {y : WeylGroup Tag.E6}
    (h : ∀ j ∈ d4Nodes Tag.E6, y • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) = Pi.single j 1) :
    y = 1 :=
  eq_one_of_smul_D4 (h 1 ⟨by decide, by decide⟩) (h 2 ⟨by decide, by decide⟩)
    (h 3 ⟨by decide, by decide⟩) (h 4 ⟨by decide, by decide⟩)

theorem exists_pinned_d4Class_E6 (S : LangSetup Tag.E6 L p₀) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1)
    (h1 : rootDiagUnit Tag.E6 a ≠ 1) (i : KernelComponent (rootCharHom a))
    (hrank : compRank (componentRoots (rootCharHom a) i) = 4)
    (hcard : (componentRoots (rootCharHom a) i).ncard = 24) :
    ∃ v : WeylGroup Tag.E6, componentRoots (rootCharHom a) i =
        (fun α => v • α) '' parabolicRoots Tag.E6 (d4Nodes Tag.E6) ∧
      ∀ γ ∈ componentRoots (rootCharHom a) i, S.ρ γ ∈ componentRoots (rootCharHom a) i := by
  have hℓ3 : ringChar L ≠ 3 := ringChar_ne_of_pow_eq_one Nat.prime_three hap h1
  have hpL : ((3 : ℕ) : L) ≠ 0 := natCast_ne_zero_of_ringChar_ne Nat.prime_three hℓ3
  have hTp := rootDiagUnit_pow_eq_one_of_forall (p := 3) hap
  exact S.d4_pinnedT_of_prime Nat.prime_three hpL facts_E6 kacCount_E6_four (by decide)
    (by decide)
    (fun y hy => far_d4_E6 y fun z hz => by
      have h := hy z hz
      rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
    ⟨none, by decide⟩ (lt_of_eq_of_lt kacCount_far_E6 (by decide)) hT hTp i hrank hcard

theorem rootChar_rho_eq_inv (S : LangSetup Tag.E6 L p₀) (hq2 : S.D.q = 2)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) {δ : Fin Tag.E6.rank → ℤ} (hδ : IsRoot Tag.E6 δ) :
    rootChar a (S.ρ δ) = (rootChar a δ)⁻¹ := by
  rw [S.frob.rootChar_eq a hT δ hδ, hq2, eq_inv_iff_mul_eq_one, ← pow_succ]
  exact rootChar_pow_eq_one hap δ

theorem rootChar_rho_iterate_parity (S : LangSetup Tag.E6 L p₀) (hq2 : S.D.q = 2)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) (m : ℕ) :
    ∀ β : Fin Tag.E6.rank → ℤ, IsRoot Tag.E6 β →
      IsRoot Tag.E6 ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[m] β) ∧
        rootChar a ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[m] β) =
          if Even m then rootChar a β else (rootChar a β)⁻¹ := by
  induction m with
  | zero => intro β hβ; exact ⟨hβ, by simp⟩
  | succ m ih =>
    intro β hβ
    obtain ⟨h1, h2⟩ := ih β hβ
    rw [Function.iterate_succ_apply']
    refine ⟨(S.frob.isRoot_iff _).2 h1, ?_⟩
    rw [rootChar_rho_eq_inv S hq2 hT hap h1, h2]
    by_cases he : Even m <;> simp [he, Nat.even_add_one]

theorem rho_iterate_eq_pow_smul (S : LangSetup Tag.E6 L p₀) (hq2 : S.D.q = 2)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) {w : WeylGroup Tag.E6}
    (hρw : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = w • γ) (m : ℕ) (γ : Fin Tag.E6.rank → ℤ)
    (hγ : IsRoot Tag.E6 γ) : (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[m] γ = (w ^ m) • γ := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Function.iterate_succ_apply', hρw _ (rootChar_rho_iterate_parity S hq2 hT hap m γ hγ).1,
      ih, ← mul_smul, pow_succ']

theorem rootDiagUnit_eq_one_of_pow_mem_closure (S : LangSetup Tag.E6 L p₀) (hq2 : S.D.q = 2)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) {w : WeylGroup Tag.E6}
    (hρw : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = w • γ) {Ψ : Set (Fin Tag.E6.rank → ℤ)}
    (hker : ∀ γ ∈ Ψ, IsRoot Tag.E6 γ ∧ rootChar a γ = 1) {k : ℕ} (hk : Odd k)
    (hmem : w ^ k ∈ Subgroup.closure {s : WeylGroup Tag.E6 | ∃ γ ∈ Ψ, s = rootReflection γ}) :
    rootDiagUnit Tag.E6 a = 1 := by
  have hall : ∀ β : Fin Tag.E6.rank → ℤ, IsRoot Tag.E6 β → rootChar a β = 1 := by
    intro β hβ
    have e1 := (rootChar_rho_iterate_parity S hq2 hT hap k β hβ).2
    rw [if_neg (Nat.not_even_iff_odd.2 hk), rho_iterate_eq_pow_smul S hq2 hT hap hρw k β hβ,
      closure_rootReflection_le_rootCharStabilizer hker hmem β] at e1
    have h2 : rootChar a β ^ 2 = 1 := by
      rw [eq_inv_iff_mul_eq_one] at e1
      simpa [sq] using e1
    calc rootChar a β = rootChar a β ^ 3 * (rootChar a β ^ 2)⁻¹ := by group
      _ = 1 := by rw [rootChar_pow_eq_one hap β, h2]; simp
  have ha : a = 1 := by
    funext j
    have h := hall (Pi.single j 1) (isRoot_single _ _)
    have h2 := rootChar_nsmul_single a j 1
    rw [one_smul, pow_one] at h2
    rw [h2] at h
    exact h
  rw [ha]
  exact rootDiagUnit_one

theorem false_of_leaf_cube_eq_one (S : LangSetup Tag.E6 L p₀) (hq2 : S.D.q = 2)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) (h1 : rootDiagUnit Tag.E6 a ≠ 1)
    {w : WeylGroup Tag.E6} (hρw : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = w • γ)
    {Ψ : Set (Fin Tag.E6.rank → ℤ)} {v : WeylGroup Tag.E6}
    (hΨ : Ψ = (fun α => v • α) '' parabolicRoots Tag.E6 (d4Nodes Tag.E6))
    (hker : ∀ γ ∈ Ψ, IsRoot Tag.E6 γ ∧ rootChar a γ = 1)
    {u w₀ : WeylGroup Tag.E6} (hu : u ∈ parabolicWeylGroup Tag.E6 (d4Nodes Tag.E6))
    (hw₀ : v⁻¹ * w * v = u * w₀) {π : Equiv.Perm (Fin Tag.E6.rank)} (hπ : IsD4LeafPerm π)
    (hw₀π : ∀ j ∈ d4Set Tag.E6, w₀ • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) = Pi.single (π j) 1)
    (hπ3 : π * π * π = 1) : False := by
  have hconj : ∀ x ∈ parabolicWeylGroup Tag.E6 (d4Nodes Tag.E6),
      w₀ * x * w₀⁻¹ ∈ parabolicWeylGroup Tag.E6 (d4Nodes Tag.E6) := by
    intro x hx
    have hle : (parabolicWeylGroup Tag.E6 (d4Nodes Tag.E6)).map (MulAut.conj w₀).toMonoidHom ≤
        parabolicWeylGroup Tag.E6 (d4Nodes Tag.E6) := by
      rw [parabolicWeylGroup, MonoidHom.map_closure, Subgroup.closure_le]
      rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
      refine Subgroup.subset_closure ⟨π j, hπ.mem_d4Set hj, ?_⟩
      change simple Tag.E6 (π j) = w₀ * simple Tag.E6 j * w₀⁻¹
      rw [← rootReflection_single, ← rootReflection_eq_conj (hw₀π j hj)]
    exact hle ⟨x, hx, rfl⟩
  have hcube : w₀ ^ 3 = 1 := by
    have hfix : ∀ j : Fin Tag.E6.rank, j ∈ d4Set Tag.E6 →
        (w₀ ^ 3) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) = Pi.single j 1 := by
      intro j hj
      have h1' := hπ.mem_d4Set hj
      have h2' := hπ.mem_d4Set h1'
      have hjj : π (π (π j)) = j := by
        have := congrArg (fun σ : Equiv.Perm (Fin Tag.E6.rank) => σ j) hπ3
        simpa using this
      rw [pow_three, mul_smul, mul_smul, hw₀π j hj, hw₀π _ h1', hw₀π _ h2', hjj]
    exact eq_one_of_fix_d4Nodes hfix
  have hx₁ := hconj u hu
  have hx₂ := hconj _ hx₁
  have hw : w = v * (u * w₀) * v⁻¹ := by
    rw [← hw₀]
    group
  have hpow : w ^ 3 = v * (u * (w₀ * u * w₀⁻¹) * (w₀ * (w₀ * u * w₀⁻¹) * w₀⁻¹)) * v⁻¹ := by
    have h3 : (u * w₀) ^ 3 =
        u * (w₀ * u * w₀⁻¹) * (w₀ * (w₀ * u * w₀⁻¹) * w₀⁻¹) * w₀ ^ 3 := by
      simp only [pow_succ, pow_zero, one_mul]
      group
    rw [hw, conj_pow, h3, hcube, mul_one]
  have hmem : w ^ 3 ∈ Subgroup.closure {s : WeylGroup Tag.E6 | ∃ γ ∈ Ψ, s = rootReflection γ} := by
    rw [hpow, hΨ]
    exact conj_mem_closure_rootReflection v (mul_mem (mul_mem hu hx₁) hx₂)
  exact h1 (rootDiagUnit_eq_one_of_pow_mem_closure S hq2 hT hap hρw hker (k := 3) (by decide) hmem)

