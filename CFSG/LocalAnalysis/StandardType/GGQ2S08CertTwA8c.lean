theorem a8c_cov : prefCovB 8 a8cPats = true := by
  rw [a8c_prefCovB_eq]
  refine List.all_eq_true.mpr fun a ha => ?_
  have ha' : a < 9 := List.mem_range.mp ha
  rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3 ∨ a = 4 ∨ a = 5 ∨ a = 6 ∨ a = 7 ∨ a = 8) with
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [a8c_cov_0, a8c_cov_1, a8c_cov_2, a8c_cov_3, a8c_cov_4, a8c_cov_5, a8c_cov_6,
    a8c_cov_7, a8c_cov_8]

theorem a8c_adj : ∀ i : Fin 7, letAt a8cGens i =
    (Pi.single i.castSucc.castSucc 1 - Pi.single i.succ.castSucc 1,
      Pi.single i.castSucc.castSucc 1 - Pi.single i.succ.castSucc 1) := by
  decide +kernel

theorem a8c_test : ∀ A Mg : Subgroup (Vn 9 ≃ₗ[ZMod 3] Vn 9),
    TestHyp (Subgroup.closure (Set.range a8cS)) (xLast 8) A Mg →
    ∀ r ∈ Mg, IsRefl r → ¬ FixesLine (xLast 8) r →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 8) t → t ∈ Mg :=
  linTest_prefix_of_certOK (k := 7) a8cS a8cGens rfl (fun _ => rfl) (by norm_num)
    a8c_adj a8c_certOK a8c_cov

