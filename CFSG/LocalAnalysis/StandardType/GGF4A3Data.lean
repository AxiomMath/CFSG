@[expose] def a3GL (y y' k : Nat) : List (Fin 5) := ((a3GLdata.getD y []).getD y' []).getD k []

@[expose] def a3GS (y y' k : Nat) : List (Fin 5) := ((a3GSdata.getD y []).getD y' []).getD k []

@[expose] def a3difL (y y' : Nat) : Bool :=
  decide (a3frL y < 3) && decide (a3frL y' < 3) && a3frL y != a3frL y'

@[expose] def a3difS (y y' : Nat) : Bool :=
  decide (a3frS y < 3) && decide (a3frS y' < 3) && a3frS y != a3frS y'

theorem relAb_iff (a₀ a₁ a₂ : M4) : relAb a₀ a₁ a₂ = true ↔
    (ord3b a₀ a₁ = true ∧ ord3b a₁ a₂ = true ∧ ord2b a₀ a₂ = true) := by
  simp [relAb, and_assoc]

theorem a3_Rm_conj : ∀ x, x < 24 → conjW (W1 x).reverse (Sm (T1 x)) = Rm x := by decide +kernel

theorem a3_rL : conjW [1, 0, 2] (Sm 1) = Rm a3xL := by decide +kernel

theorem a3_rS : conjW [0, 2, 1, 2] (Sm 3) = Rm a3xS := by decide +kernel

theorem a3_stage2L :
    ∀ x₀, x₀ < 24 → ∀ x₂, x₂ < 24 → relAb (Rm x₀) (Sm 1) (Rm x₂) = true →
      ∃ k, k < 24 ∧ conjW (a3W2L k) (Rm x₀) = Sm 0 ∧ conjW (a3W2L k) (Rm x₂) = Rm a3xL ∧
        conjW (a3W2L k) (Sm 1) = Sm 1 := by
  decide +kernel

theorem a3_stage2S :
    ∀ x₀, x₀ < 24 → ∀ x₂, x₂ < 24 → relAb (Rm x₀) (Sm 2) (Rm x₂) = true →
      ∃ k, k < 24 ∧ conjW (a3W2S k) (Rm x₀) = Sm 3 ∧ conjW (a3W2S k) (Rm x₂) = Rm a3xS ∧
        conjW (a3W2S k) (Sm 2) = Sm 2 := by
  decide +kernel

theorem a3L_norm :
    ∀ j : Fin 3, normM (Sm 0) (a3QL j) ∧ normM (Sm 1) (a3QL j) ∧ normM (Rm a3xL) (a3QL j) := by
  decide +kernel

theorem a3S_norm :
    ∀ j : Fin 3, normM (Sm 3) (a3QS j) ∧ normM (Sm 2) (a3QS j) ∧ normM (Rm a3xS) (a3QS j) := by
  decide +kernel

theorem a3L_notnorm : ∀ j : Fin 3, ∃ i : Fin 4, ∃ c ∈ a3QL j, c < 24 ∧
    ∀ c' ∈ a3QL j, (Sm i).mul ((Rm c).mul (Sm i)) ≠ Rm c' := by
  decide +kernel

theorem a3S_notnorm : ∀ j : Fin 3, ∃ i : Fin 4, ∃ c ∈ a3QS j, c < 24 ∧
    ∀ c' ∈ a3QS j, (Sm i).mul ((Rm c).mul (Sm i)) ≠ Rm c' := by
  decide +kernel

theorem a3L_frame : ∀ y, y < 24 → a3frL y ≤ 3 ∧
    ∀ j : Fin 3, (a3frL y = 3 ∨ a3frL y = j.val) → normM (Rm y) (a3QL j) := by
  decide +kernel

theorem a3S_frame : ∀ y, y < 24 → a3frS y ≤ 3 ∧
    ∀ j : Fin 3, (a3frS y = 3 ∨ a3frS y = j.val) → normM (Rm y) (a3QS j) := by
  decide +kernel

theorem a3L_gen : ∀ y, y < 24 → ∀ y', y' < 24 → a3difL y y' = true →
    evalG5 (quintF (Sm 0) (Sm 1) (Rm a3xL) (Rm y) (Rm y')) (a3GL y y' 0) = Sm 2 ∧
      evalG5 (quintF (Sm 0) (Sm 1) (Rm a3xL) (Rm y) (Rm y')) (a3GL y y' 1) = Sm 3 := by
  decide +kernel

theorem a3S_gen : ∀ y, y < 24 → ∀ y', y' < 24 → a3difS y y' = true →
    evalG5 (quintF (Sm 3) (Sm 2) (Rm a3xS) (Rm y) (Rm y')) (a3GS y y' 0) = Sm 0 ∧
      evalG5 (quintF (Sm 3) (Sm 2) (Rm a3xS) (Rm y) (Rm y')) (a3GS y y' 1) = Sm 1 := by
  decide +kernel

theorem a3L_ord3 : ∀ y, y < 24 → ∀ y', y' < 24 → ord3b (Rm y) (Rm y') = true →
    (a3frL y = 3 ∧ a3frL y' = 3) ∨ a3difL y y' = true := by
  decide +kernel

theorem a3S_ord3 : ∀ y, y < 24 → ∀ y', y' < 24 → ord3b (Rm y) (Rm y') = true →
    (a3frS y = 3 ∧ a3frS y' = 3) ∨ a3difS y y' = true := by
  decide +kernel

