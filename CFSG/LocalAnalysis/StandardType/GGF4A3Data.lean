@[expose] def quintF (a b c d e : M4) : Fin 5 → M4 :=
  fun i => if i.val = 0 then a else if i.val = 1 then b else if i.val = 2 then c else
    if i.val = 3 then d else e

@[expose] def evalG5 (x : Fin 5 → M4) (l : List (Fin 5)) : M4 :=
  l.foldr (fun i m => (x i).mul m) M4.one

