@[expose] def GGRootNormInnerZ {K : Type*} [Group K] (R : Subgroup K) : Prop :=
  ∀ y : MulAut K, (∃ k : ℕ, y ^ 2 ^ k = 1) → R.map y.toMonoidHom = R →
    (∀ n ∈ Subgroup.normalizer (R : Set K),
      y n * n⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer (R : Set K)) ⊔ Subgroup.center K) →
    ∃ k : K, y = MulAut.conj k

private theorem lr2z_rootNormInnerZ_map_mulEquiv {K K' : Type*} [Group K] [Group K']
    (e : K ≃* K') {R : Subgroup K} (h : GGRootNormInnerZ R) :
    GGRootNormInnerZ (R.map e.toMonoidHom) := by
  intro y' hy'2 hy'R hy'mod
  set y : MulAut K := (MulAut.congr e).symm y' with hy_def
  have hycongr : MulAut.congr e y = y' := by
    rw [hy_def]; exact MulEquiv.apply_symm_apply _ _
  have hyapply : ∀ x : K, y' (e x) = e (y x) := by
    intro x
    rw [← hycongr]
    change e (y (e.symm (e x))) = e (y x)
    simp
  have hy2 : ∃ k : ℕ, y ^ 2 ^ k = 1 := by
    obtain ⟨k, hk⟩ := hy'2
    refine ⟨k, ?_⟩
    have hh := congrArg ((MulAut.congr e).symm) hk
    rw [map_pow, map_one] at hh
    simpa [hy_def] using hh
  have hyR : R.map y.toMonoidHom = R := by
    have h1 : (R.map y.toMonoidHom).map e.toMonoidHom
        = (R.map e.toMonoidHom).map y'.toMonoidHom := by
      rw [Subgroup.map_map, Subgroup.map_map]
      have hh : e.toMonoidHom.comp y.toMonoidHom = y'.toMonoidHom.comp e.toMonoidHom := by
        ext x; exact (hyapply x).symm
      rw [hh]
    rw [hy'R] at h1
    exact Subgroup.map_injective e.injective h1
  have hymod : ∀ n ∈ Subgroup.normalizer (R : Set K),
      y n * n⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer (R : Set K)) ⊔ Subgroup.center K := by
    intro n hn
    have hen : e n ∈ Subgroup.normalizer ((R.map e.toMonoidHom : Subgroup K') : Set K') := by
      rw [GGRootNorm.normalizer_map_mulEquiv e R, Subgroup.mem_map_equiv]
      simpa using hn
    have hmod := hy'mod (e n) hen
    have hcenter : (Subgroup.center K).map e.toMonoidHom = Subgroup.center K' := by
      rw [MulEquiv.toMonoidHom_eq_coe e]
      exact Subgroup.map_center_eq e
    have hmapcenter : pCoreOf 2 (Subgroup.normalizer
          ((R.map e.toMonoidHom : Subgroup K') : Set K')) ⊔ Subgroup.center K' =
        ((pCoreOf 2 (Subgroup.normalizer (R : Set K)) ⊔
          Subgroup.center K).map e.toMonoidHom) := by
      rw [GGRootNorm.normalizer_map_mulEquiv e R,
        GGRootNorm.pCoreOf_map_mulEquiv e (Subgroup.normalizer (R : Set K)),
        ← hcenter, ← Subgroup.map_sup]
    rw [hmapcenter] at hmod
    rw [Subgroup.mem_map_equiv] at hmod
    have heq : e.symm (y' (e n) * (e n)⁻¹) = y n * n⁻¹ := by
      rw [map_mul, map_inv, hyapply n]
      simp
    rwa [heq] at hmod
  obtain ⟨k, hk⟩ := h y hy2 hyR hymod
  refine ⟨e k, ?_⟩
  rw [← hycongr, hk, GGRootNorm.congr_conj]

private theorem lr2z_datumElt_proof_irrel {k E V : Type} [Field k] [Field E] [Algebra k E]
    [AddCommGroup V] [Module k V] [Module.Finite k V]
    (ι : E →ₗ[k] V) (π : V →ₗ[k] E) (h1 h2 : ∀ t, π (ι t) = 0) (t : E) :
    datumElt ι π h1 t = datumElt ι π h2 t := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro v
  rfl

private theorem lr2z_datumRoot_congr {k E V : Type} [Field k] [Field E] [Algebra k E]
    [AddCommGroup V] [Module k V] [Module.Finite k V]
    {ι ι' : E →ₗ[k] V} {π π' : V →ₗ[k] E}
    (h : ∀ t, π (ι t) = 0) (h' : ∀ t, π' (ι' t) = 0) (hι : ι = ι') (hπ : π = π') :
    datumRoot ι π h = datumRoot ι' π' h' := by
  cases hι
  cases hπ
  unfold datumRoot
  apply congrArg Subgroup.closure
  ext g
  constructor
  · rintro ⟨t, ht⟩
    exact ⟨t, by rw [← lr2z_datumElt_proof_irrel ι π h h' t]; exact ht⟩
  · rintro ⟨t, ht⟩
    exact ⟨t, by rw [lr2z_datumElt_proof_irrel ι π h h' t]; exact ht⟩

private theorem lr2z_rootSL_congr {k X : Type} [Field k] [AddCommGroup X] [Module k X]
    [Module.Finite k X] (ex : X ≃ₗ[k] k) :
    (rootSL k k X).map (SpecialLinearGroup.congr_linearEquiv
      ((LinearEquiv.refl k k).prodCongr (ex.prodCongr (LinearEquiv.refl k k)))).toMonoidHom
      = rootSL k k k := by
  let L : DSpace k X ≃ₗ[k] DSpace k k :=
    (LinearEquiv.refl k k).prodCongr (ex.prodCongr (LinearEquiv.refl k k))
  have hstd : ∀ t : k, stdPi k k X (stdIota k k X t) = 0 := fun _ => rfl
  have hstd' : ∀ t : k, stdPi k k k (stdIota k k k t) = 0 := fun _ => rfl
  have h' : ∀ t : k,
      (stdPi k k X ∘ₗ L.symm.toLinearMap) ((L.toLinearMap ∘ₗ stdIota k k X) t) = 0 := by
    intro t
    simp only [LinearMap.comp_apply, LinearEquiv.symm_apply_apply]
    rfl
  have hLstd : L.toLinearMap ∘ₗ stdIota k k X = stdIota k k k := by
    apply LinearMap.ext
    intro t
    simp [L, stdIota, LinearEquiv.prodCongr_apply]
  have hLpi : stdPi k k X ∘ₗ L.symm.toLinearMap = stdPi k k k := by
    apply LinearMap.ext
    intro v
    obtain ⟨a, y, b⟩ := v
    simp [L, stdPi, LinearEquiv.prodCongr_symm, LinearEquiv.prodCongr_apply]
  calc (rootSL k k X).map (SpecialLinearGroup.congr_linearEquiv L).toMonoidHom
      = (datumRoot (stdIota k k X) (stdPi k k X) hstd).map
          (SpecialLinearGroup.congr_linearEquiv L).toMonoidHom := by
        rw [datumRoot_std hstd]
    _ = datumRoot (L.toLinearMap ∘ₗ stdIota k k X)
          (stdPi k k X ∘ₗ L.symm.toLinearMap) h' :=
        map_datumRoot_congr L _ _ hstd h'
    _ = datumRoot (stdIota k k k) (stdPi k k k) hstd' :=
        lr2z_datumRoot_congr h' hstd' hLstd hLpi
    _ = rootSL k k k := datumRoot_std hstd'

theorem ggRootNormInnerZ_rootSL_psl
    {k X : Type} [Field k] [Finite k] [CharP k 2] [AddCommGroup X] [Module k X]
    [Module.Finite k X]
    (hdim : (4 ≤ Nat.card k ∧ 2 ≤ Module.finrank k X) ∨
      (8 ≤ Nat.card k ∧ 1 ≤ Module.finrank k X) ∨
      (Nat.card k = 2 ∧ 3 ≤ Module.finrank k X)) :
    GGRootNormInnerZ (rootSL k k X) := by
  intro y hy2 hyR hyC
  have hXpos : 0 < Module.finrank k X := by
    rcases hdim with ⟨-, h⟩ | ⟨-, h⟩ | ⟨-, h⟩ <;> omega
  have hcore : pCoreOf 2 (Subgroup.normalizer (rootSL k k X : Set
      (SpecialLinearGroup k (DSpace k X)))) = QK k k X :=
    pCoreOf_normalizer_rootSL (k := k) (E := k) (X := X) hXpos
  rcases hdim with ⟨h4, hX2⟩ | ⟨h8, hX1⟩ | ⟨hk2, hX3⟩
  · refine exists_conj_of_two_element_mem_Y (k := k) (E := k) (X := X) ?_ ?_ y hyR ?_ hy2
    · rw [Module.finrank_self]; omega
    · right; exact ⟨by rw [Module.finrank_self], h4, hX2⟩
    · rw [hcore] at hyC; exact hyC
  · rcases Nat.lt_or_ge (Module.finrank k X) 2 with hlt | hge
    · have hX1' : Module.finrank k X = 1 := by omega
      let ex : X ≃ₗ[k] k := LinearEquiv.ofFinrankEq X k (by rw [hX1', Module.finrank_self])
      let eSL := SpecialLinearGroup.congr_linearEquiv
        ((LinearEquiv.refl k k).prodCongr (ex.prodCongr (LinearEquiv.refl k k)))
      have hRS : (rootSL k k X).map eSL.toMonoidHom = rootSL k k k := lr2z_rootSL_congr ex
      have hZ : GGRootNormInnerZ (rootSL k k k) := by
        intro z hz2 hzR hzC
        rw [pCoreOf_normalizer_rootSL (k := k) (E := k) (X := k)
          (by rw [Module.finrank_self]; norm_num)] at hzC
        exact exists_conj_of_two_element_mem_Y_rankOne_Z h8 z hzR hzC hz2
      have hI : GGRootNormInnerZ ((rootSL k k k).map eSL.symm.toMonoidHom) :=
        lr2z_rootNormInnerZ_map_mulEquiv eSL.symm hZ
      have hgoal : (rootSL k k k).map eSL.symm.toMonoidHom = rootSL k k X := by
        rw [← hRS, Subgroup.map_map]
        have hcomp : eSL.symm.toMonoidHom.comp eSL.toMonoidHom = MonoidHom.id _ := by
          apply MonoidHom.ext
          intro x
          simp
        rw [hcomp, Subgroup.map_id]
      rw [hgoal] at hI
      exact hI y hy2 hyR hyC
    · refine exists_conj_of_two_element_mem_Y (k := k) (E := k) (X := X) ?_ ?_ y hyR ?_ hy2
      · rw [Module.finrank_self]; omega
      · right; exact ⟨by rw [Module.finrank_self], by omega, hge⟩
      · rw [hcore] at hyC; exact hyC
  · refine exists_conj_of_two_element_mem_Y_two (k := k) (E := k) (X := X) hk2 ?_ hX3
      y hyR ?_ hy2
    · rw [Module.finrank_self]
    · rw [hcore] at hyC; exact hyC

theorem ggRootNormInnerZ_specialLinear {m g : ℕ}
    (hdim : (g = 1 ∧ 4 ≤ m) ∨ (2 ≤ g ∧ 3 ≤ m) ∨ (3 ≤ g ∧ 2 ≤ m)) {β : Fin m → ℤ}
    (hβ : β ∈ roots (SpecialLinear.isFiniteType_A m) ∅)
    (u : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)) :
    GGRootNormInnerZ (ggRootSub (SpecialLinear.rootDatum m (GaloisField 2 g))
      (MonoidHom.id (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g))) β u) := by
  let F := GaloisField 2 g
  let K := Matrix.SpecialLinearGroup (Fin (m + 1)) F
  have hij : (SpecialLinear.idx m β).1 ≠ (SpecialLinear.idx m β).2 :=
    (SpecialLinear.idx_spec m hβ).1
  obtain ⟨X', _, _, _, e, he, hdimX⟩ :=
    SpecialLinearNC.exists_mulEquiv_rootSubgroup_eq_rootSL (F := F) hij
  have hgpos : g ≠ 0 := by
    rcases hdim with ⟨h, _⟩ | ⟨h, _⟩ | ⟨h, _⟩ <;> omega
  have hcard : Nat.card F = 2 ^ g := GaloisField.card 2 g hgpos
  have hm2 : 2 ≤ m := by
    rcases hdim with ⟨_, h⟩ | ⟨_, h⟩ | ⟨_, h⟩ <;> omega
  have hX'dim : Module.finrank F X' = m - 1 := by omega
  have hdim' : (4 ≤ Nat.card F ∧ 2 ≤ Module.finrank F X') ∨
      (8 ≤ Nat.card F ∧ 1 ≤ Module.finrank F X') ∨
      (Nat.card F = 2 ∧ 3 ≤ Module.finrank F X') := by
    rcases hdim with ⟨hg1, hm4⟩ | ⟨hg2, hm3⟩ | ⟨hg3, hm2⟩
    · right; right
      exact ⟨by rw [hcard, hg1]; norm_num, by omega⟩
    · left
      exact ⟨by
        rw [hcard]
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ g := Nat.pow_le_pow_right (by norm_num) hg2, by omega⟩
    · right; left
      exact ⟨by
        rw [hcard]
        calc 8 = 2 ^ 3 := by norm_num
          _ ≤ 2 ^ g := Nat.pow_le_pow_right (by norm_num) hg3, by omega⟩
  have hI : GGRootNormInnerZ (rootSL F F X') :=
    ggRootNormInnerZ_rootSL_psl (k := F) (X := X') hdim'
  let g' : K ≃* SpecialLinearGroup F (DSpace F X') :=
    e.trans (MulAut.conj ((e u)⁻¹))
  have hcomp : g'.toMonoidHom.comp (MulAut.conj u).toMonoidHom = e.toMonoidHom := by
    apply MonoidHom.ext
    intro y
    change (MulAut.conj (e u))⁻¹ (e (u * y * u⁻¹)) = e y
    simp only [map_mul, map_inv, MulAut.conj_inv_apply]
    group
  have hmap : ((SpecialLinear.rootSubgroup m F hij).map (MulAut.conj u).toMonoidHom).map
      g'.toMonoidHom = rootSL F F X' := by
    rw [Subgroup.map_map, hcomp, he]
  have hsub : ggRootSub (SpecialLinear.rootDatum m F) (MonoidHom.id K) β u
      = (SpecialLinear.rootSubgroup m F hij).map (MulAut.conj u).toMonoidHom := by
    unfold ggRootSub
    change Subgroup.map (MonoidHom.id K)
        (Subgroup.map (MulAut.conj u).toMonoidHom (SpecialLinear.rootGroup m F β)) =
      Subgroup.map (MulAut.conj u).toMonoidHom (SpecialLinear.rootSubgroup m F hij)
    rw [SpecialLinear.rootGroup_eq_idx m F hβ, Subgroup.map_id]
  have hI' : GGRootNormInnerZ ((rootSL F F X').map g'.symm.toMonoidHom) :=
    lr2z_rootNormInnerZ_map_mulEquiv g'.symm hI
  have hgoal : (rootSL F F X').map g'.symm.toMonoidHom
      = (SpecialLinear.rootSubgroup m F hij).map (MulAut.conj u).toMonoidHom := by
    rw [← hmap, Subgroup.map_map]
    have hcomp2 : g'.symm.toMonoidHom.comp g'.toMonoidHom = MonoidHom.id K := by
      apply MonoidHom.ext
      intro x
      simp
    rw [hcomp2, Subgroup.map_id]
  rw [hsub, ← hgoal]
  exact hI'

private theorem lr2h1_eq_one_of_forall_mul_inv_mem_center {S : Type*} [Group S]
    [Group.IsPerfect S] {τ : MulAut S} (h : ∀ s : S, s⁻¹ * τ s ∈ Subgroup.center S) :
    τ = 1 := by
  let z : S →* S :=
    { toFun := fun s => s⁻¹ * τ s
      map_one' := by simp
      map_mul' := fun s t => by
        have ht := Subgroup.mem_center_iff.mp (h s)
        calc (s * t)⁻¹ * τ (s * t) = t⁻¹ * (s⁻¹ * τ s) * τ t := by
              rw [map_mul]
              group
          _ = s⁻¹ * τ s * (t⁻¹ * τ t) := by
              rw [ht t⁻¹]
              group }
  have hzc : ∀ s, z s ∈ Subgroup.center S := h
  have hcomm : ⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ ≤ z.ker := by
    rw [Subgroup.commutator_le]
    intro a _ b _
    rw [MonoidHom.mem_ker, map_commutatorElement]
    have hab := Subgroup.mem_center_iff.mp (hzc a) (z b)
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact hab.symm
  have htop : ⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ = ⊤ := Group.IsPerfect.commutator_eq_top
  rw [htop] at hcomm
  refine MulEquiv.ext fun s => ?_
  have hs : z s = 1 := hcomm (Subgroup.mem_top s)
  change s⁻¹ * τ s = 1 at hs
  rw [MulAut.one_apply]
  exact (inv_mul_eq_one.mp hs).symm

private theorem lr2h1_eq_of_mul_inv_mem_center {S : Type*} [Group S] [Group.IsPerfect S]
    {τ σ : MulAut S} (h : ∀ s : S, (τ s)⁻¹ * σ s ∈ Subgroup.center S) : τ = σ := by
  have hω : σ * τ⁻¹ = 1 := by
    apply lr2h1_eq_one_of_forall_mul_inv_mem_center
    intro u
    have := h (τ⁻¹ u)
    simpa using this
  exact (mul_inv_eq_one.mp hω).symm

private theorem lr2h1_map_eq_self_of_le_center_cyclic {K : Type*} [Group K] [Finite K]
    [IsCyclic (Subgroup.center K)] (ŷ : MulAut K) {N : Subgroup K}
    (hN : N ≤ Subgroup.center K) : N.map ŷ.toMonoidHom = N := by
  have hmap : N.map ŷ.toMonoidHom ≤ Subgroup.center K := by
    calc N.map ŷ.toMonoidHom ≤ (Subgroup.center K).map ŷ.toMonoidHom := Subgroup.map_mono hN
      _ = Subgroup.center K := Subgroup.map_center_eq ŷ
  have h1 : Nat.card (N.map ŷ.toMonoidHom) =
      Nat.card ((N.map ŷ.toMonoidHom).subgroupOf (Subgroup.center K)) := by
    have h := Subgroup.card_map_of_injective (Subgroup.subtype_injective (Subgroup.center K))
      (K := (N.map ŷ.toMonoidHom).subgroupOf (Subgroup.center K))
    rwa [Subgroup.map_subgroupOf_eq_of_le hmap] at h
  have h2 : Nat.card N = Nat.card (N.subgroupOf (Subgroup.center K)) := by
    have h := Subgroup.card_map_of_injective (Subgroup.subtype_injective (Subgroup.center K))
      (K := N.subgroupOf (Subgroup.center K))
    rwa [Subgroup.map_subgroupOf_eq_of_le hN] at h
  have h3 : Nat.card (N.map ŷ.toMonoidHom) = Nat.card N :=
    Subgroup.card_map_of_injective (f := ŷ.toMonoidHom) ŷ.injective
  have hcard : Nat.card ((N.map ŷ.toMonoidHom).subgroupOf (Subgroup.center K)) =
      Nat.card (N.subgroupOf (Subgroup.center K)) := by
    rw [← h1, h3, h2]
  have hEq : (N.map ŷ.toMonoidHom).subgroupOf (Subgroup.center K) =
      N.subgroupOf (Subgroup.center K) :=
    (IsCyclic.subgroup_eq_iff_card_eq).mpr hcard
  have := congrArg (Subgroup.map (Subgroup.center K).subtype) hEq
  rwa [Subgroup.map_subgroupOf_eq_of_le hmap, Subgroup.map_subgroupOf_eq_of_le hN] at this

private noncomputable def lr2h1_centralQuotEquiv {H H' : Type*} [Group H] [Group H']
    (hH : commutator H = ⊤) (ψ : H →* H') (hψ : Function.Surjective ψ)
    (hk : ψ.ker ≤ Subgroup.center H) :
    H ⧸ Subgroup.center H ≃* H' ⧸ Subgroup.center H' :=
  let χ : H →* H' ⧸ Subgroup.center H' := (QuotientGroup.mk' (Subgroup.center H')).comp ψ
  have hχ : Function.Surjective χ := (QuotientGroup.mk'_surjective _).comp hψ
  have hkerχ : χ.ker = Subgroup.comap ψ (Subgroup.center H') := by
    rw [← MonoidHom.comap_ker (QuotientGroup.mk' (Subgroup.center H')) ψ,
      QuotientGroup.ker_mk']
  have hker : χ.ker = Subgroup.center H := by
    rw [hkerχ]
    exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.comap_center_of_surjective
      hH ψ hψ hk
  (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective χ hχ)

private theorem lr2h1_centralQuotEquiv_mk {H H' : Type*} [Group H] [Group H']
    (hH : commutator H = ⊤) (ψ : H →* H') (hψ : Function.Surjective ψ)
    (hk : ψ.ker ≤ Subgroup.center H) (x : H) :
    lr2h1_centralQuotEquiv hH ψ hψ hk (QuotientGroup.mk' (Subgroup.center H) x) =
      QuotientGroup.mk' (Subgroup.center H') (ψ x) := by
  simp only [lr2h1_centralQuotEquiv, MulEquiv.trans_apply, QuotientGroup.mk'_apply]
  rw [QuotientGroup.quotientMulEquivOfEq_mk]
  simp [QuotientGroup.quotientKerEquivOfSurjective,
    QuotientGroup.quotientKerEquivOfRightInverse, QuotientGroup.kerLift_mk,
    QuotientGroup.mk'_apply, MonoidHom.comp_apply]

theorem exists_lift_mulAut_specialLinear {m g : ℕ} (hm : 2 ≤ m) (hg : 1 ≤ g)
    {X : Type} [Group X] [Finite X]
    (φ : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g) →* X)
    (hker : φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)))
    (y : MulAut ↥φ.range) :
    ∃ ŷ : MulAut (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)),
      ∀ s, y (φ.rangeRestrict s) = φ.rangeRestrict (ŷ s) := by
  classical
  let K := Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)
  let Q := ↥φ.range
  let q : K →* Q := φ.rangeRestrict
  have hq : Function.Surjective q := φ.rangeRestrict_surjective
  have hkerq : q.ker ≤ Subgroup.center K := by
    rw [show q.ker = φ.ker from MonoidHom.ker_rangeRestrict φ]
    exact hker
  have hm3 : 3 ≤ m + 1 := by omega
  have hperf : Group.IsPerfect K :=
    CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect hm3
  haveI hQperf : Group.IsPerfect Q := hperf.ofSurjective hq
  haveI : IsCyclic (Subgroup.center K) :=
    CFSG.LieType.Steinberg.isCyclic_center_specialLinearGroup (m + 1) (GaloisField 2 g)
  have hcomm : commutator K = ⊤ := hperf.commutator_eq_top
  let e0 : K ⧸ Subgroup.center K ≃* Q ⧸ Subgroup.center Q :=
    lr2h1_centralQuotEquiv hcomm q hq hkerq
  have he0 : ∀ x : K, e0 (QuotientGroup.mk' (Subgroup.center K) x) =
      QuotientGroup.mk' (Subgroup.center Q) (q x) := fun x =>
    lr2h1_centralQuotEquiv_mk hcomm q hq hkerq x
  let e_proj : CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL (m + 1)
        (GaloisField 2 g) ≃* K ⧸ Subgroup.center K :=
    QuotientGroup.quotientMulEquivOfEq
      (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center (m + 1)
        (GaloisField 2 g))
  let e : Q ⧸ Subgroup.center Q ≃* CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL
        (m + 1) (GaloisField 2 g) := e0.symm.trans e_proj.symm
  let ybarQ : MulAut (Q ⧸ Subgroup.center Q) :=
    QuotientGroup.congr (Subgroup.center Q) (Subgroup.center Q) y (Subgroup.map_center_eq y)
  obtain ⟨A, σ, ε, hε, hstd⟩ :=
    CFSG.RankThree.PartOne.AUTSL.exists_std_of_mulEquiv hm3 e ybarQ
  let ŷ : MulAut K :=
    CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation (m + 1)
        (GaloisField 2 g) A *
      CFSG.ComponentClassification.CatalogueBHigherLinearField.slFieldAut (Fin (m + 1))
        (GaloisField 2 g) σ *
      CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut (m + 1)
        (GaloisField 2 g) ^ ε
  have hdesc : CFSG.LocalAnalysis.ComponentInitial.LinearFlag.descendAut (m + 1)
        (GaloisField 2 g) ŷ =
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.conjAut (m + 1) (GaloisField 2 g) A *
        CFSG.LocalAnalysis.ComponentInitial.LinearFlag.fieldAut (m + 1) (GaloisField 2 g) σ *
          CFSG.LocalAnalysis.ComponentInitial.LinearFlag.dualAut (m + 1)
            (GaloisField 2 g) ^ ε := by
    simp only [ŷ, map_mul, map_pow,
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.conjAut,
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.fieldAut,
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.dualAut, MonoidHom.comp_apply]
  have hdesc' : MulAut.congr e ybarQ =
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.descendAut (m + 1) (GaloisField 2 g) ŷ := by
    rw [hstd, hdesc]
  let N : Subgroup K := q.ker
  have hN : N.map ŷ.toMonoidHom = N := lr2h1_map_eq_self_of_le_center_cyclic ŷ hkerq
  let eQ : K ⧸ N ≃* Q :=
    MulEquiv.ofBijective (QuotientGroup.kerLift q)
      ⟨QuotientGroup.kerLift_injective q, by
        intro z
        obtain ⟨x, rfl⟩ := hq z
        exact ⟨QuotientGroup.mk x, QuotientGroup.kerLift_mk q x⟩⟩
  let ŷN : MulAut (K ⧸ N) := QuotientGroup.congr N N ŷ hN
  let ŷ' : MulAut Q := MulAut.congr eQ ŷN
  have heQ : ∀ x : K, eQ (QuotientGroup.mk' N x) = q x := by
    intro x
    change (QuotientGroup.kerLift q) (QuotientGroup.mk' N x) = q x
    exact QuotientGroup.kerLift_mk q x
  have hŷ'_mk : ∀ x : K, ŷ' (q x) = q (ŷ x) := by
    intro x
    have hŷN : ŷN (QuotientGroup.mk' N x) = QuotientGroup.mk' N (ŷ x) :=
      QuotientGroup.congr_mk' N N ŷ hN x
    change MulAut.congr eQ ŷN (q x) = q (ŷ x)
    rw [← heQ x]
    rw [show MulAut.congr eQ ŷN (eQ (QuotientGroup.mk' N x)) =
        eQ (ŷN (QuotientGroup.mk' N x)) by simp [MulAut.congr_apply]]
    rw [hŷN, heQ (ŷ x)]
  have he_proj : ∀ x : K,
      e_proj (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1) (GaloisField 2 g) x) =
        QuotientGroup.mk' (Subgroup.center K) x := by
    intro x
    exact QuotientGroup.quotientMulEquivOfEq_mk
      (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center (m + 1)
        (GaloisField 2 g)) x
  have he_apply : ∀ x : K,
      e (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
        CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1) (GaloisField 2 g) x := by
    intro x
    have h1 : e0.symm (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
        QuotientGroup.mk' (Subgroup.center K) x := by
      rw [← he0 x]
      exact MulEquiv.symm_apply_apply e0 _
    have h2 : e_proj.symm (QuotientGroup.mk' (Subgroup.center K) x) =
        CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1) (GaloisField 2 g) x := by
      rw [← he_proj x]
      exact MulEquiv.symm_apply_apply e_proj _
    change (e0.symm.trans e_proj.symm) (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1) (GaloisField 2 g) x
    rw [MulEquiv.trans_apply, h1, h2]
  have hmod : ∀ x : K, ybarQ (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
      QuotientGroup.mk' (Subgroup.center Q) (q (ŷ x)) := by
    intro x
    apply e.injective
    calc e (ybarQ (QuotientGroup.mk' (Subgroup.center Q) (q x)))
        = (MulAut.congr e ybarQ) (e (QuotientGroup.mk' (Subgroup.center Q) (q x))) := by
            simp [MulAut.congr_apply]
      _ = (MulAut.congr e ybarQ)
            (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1)
              (GaloisField 2 g) x) := by rw [he_apply x]
      _ = (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.descendAut (m + 1)
            (GaloisField 2 g) ŷ)
            (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1)
              (GaloisField 2 g) x) := by rw [hdesc']
      _ = CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj (m + 1) (GaloisField 2 g)
            (ŷ x) := CFSG.LocalAnalysis.ComponentInitial.LinearFlag.descendAut_proj _ _ _ _
      _ = e (QuotientGroup.mk' (Subgroup.center Q) (q (ŷ x))) := (he_apply (ŷ x)).symm
  have hybar_mk : ∀ x : K, ybarQ (QuotientGroup.mk' (Subgroup.center Q) (q x)) =
      QuotientGroup.mk' (Subgroup.center Q) (y (q x)) := by
    intro x
    exact QuotientGroup.congr_mk' (Subgroup.center Q) (Subgroup.center Q) y
      (Subgroup.map_center_eq y) (q x)
  have hcenter : ∀ z : Q, (y z)⁻¹ * ŷ' z ∈ Subgroup.center Q := by
    intro z
    obtain ⟨x, rfl⟩ := hq z
    rw [hŷ'_mk x]
    have hx : QuotientGroup.mk (s := Subgroup.center Q) (y (q x)) =
        QuotientGroup.mk (s := Subgroup.center Q) (q (ŷ x)) := by
      change QuotientGroup.mk' (Subgroup.center Q) (y (q x)) =
        QuotientGroup.mk' (Subgroup.center Q) (q (ŷ x))
      exact (hybar_mk x).symm.trans (hmod x)
    rw [QuotientGroup.eq] at hx
    simpa using hx
  have hy : y = ŷ' := lr2h1_eq_of_mul_inv_mem_center hcenter
  refine ⟨ŷ, fun s => ?_⟩
  have hs : y (q s) = ŷ' (q s) := congrArg (fun f : MulAut Q => f (q s)) hy
  change y (q s) = q (ŷ s)
  rw [hs, hŷ'_mk s]

private theorem lr2h2_eq_one_of_forall_mul_inv_mem_center {S : Type*} [Group S]
    [Group.IsPerfect S] {τ : MulAut S} (h : ∀ s : S, τ s * s⁻¹ ∈ Subgroup.center S) :
    τ = 1 := by
  let z : S →* S :=
    { toFun := fun s => τ s * s⁻¹
      map_one' := by simp
      map_mul' := fun s t => by
        have ht : (τ t * t⁻¹) * s⁻¹ = s⁻¹ * (τ t * t⁻¹) :=
          ((Subgroup.mem_center_iff.mp (h t)) s⁻¹).symm
        calc τ (s * t) * (s * t)⁻¹
            = τ s * (τ t * t⁻¹) * s⁻¹ := by rw [map_mul]; group
          _ = τ s * ((τ t * t⁻¹) * s⁻¹) := by group
          _ = τ s * (s⁻¹ * (τ t * t⁻¹)) := by rw [ht]
          _ = (τ s * s⁻¹) * (τ t * t⁻¹) := by group }
  have hzc : ∀ s, z s ∈ Subgroup.center S := h
  have hcomm : ⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ ≤ z.ker := by
    rw [Subgroup.commutator_le]
    intro a _ b _
    rw [MonoidHom.mem_ker, map_commutatorElement]
    have hab := (Subgroup.mem_center_iff.mp (hzc a)) (z b)
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact hab.symm
  have htop : ⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ = ⊤ := Group.IsPerfect.commutator_eq_top
  rw [htop] at hcomm
  refine MulEquiv.ext fun s => ?_
  have hs : z s = 1 := hcomm (Subgroup.mem_top s)
  change τ s * s⁻¹ = 1 at hs
  rw [MulAut.one_apply]
  exact eq_of_mul_inv_eq_one hs

theorem lift_mulAut_unique_specialLinear {m g : ℕ} (hm : 2 ≤ m) (hg : 1 ≤ g)
    {X : Type} [Group X] [Finite X]
    (φ : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g) →* X)
    (hker : φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)))
    {y₁ y₂ : MulAut (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g))}
    (h : ∀ s, φ.rangeRestrict (y₁ s) = φ.rangeRestrict (y₂ s)) : y₁ = y₂ := by
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)) :=
    CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect (by omega)
  let δ : MulAut (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)) := y₁ * y₂⁻¹
  have hδ : δ = 1 := by
    refine lr2h2_eq_one_of_forall_mul_inv_mem_center fun s => ?_
    refine hker ?_
    rw [MonoidHom.mem_ker]
    have h1 : φ.rangeRestrict (δ s) = φ.rangeRestrict s := by
      have h2 := h (y₂⁻¹ s)
      simpa [δ, MulAut.mul_apply, MulEquiv.apply_symm_apply] using h2
    have hv : φ (δ s) = φ s := by simpa using congrArg Subtype.val h1
    simp [map_mul, hv]
  have hmul : y₁ * y₂⁻¹ = 1 := hδ
  calc y₁ = y₁ * y₂⁻¹ * y₂ := by group
    _ = 1 * y₂ := by rw [hmul]
    _ = y₂ := by group

theorem normalizer_pCore_map_specialLinear {m g : ℕ}
    {X : Type} [Group X] [Finite X]
    (φ : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g) →* X)
    (hker : φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)))
    (hodd : Odd (Nat.card φ.ker))
    {R : Subgroup (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g))}
    (hR : IsPGroup 2 R) :
    Subgroup.normalizer ((R.map φ.rangeRestrict : Subgroup ↥φ.range) : Set ↥φ.range) =
        (Subgroup.normalizer (R : Set (Matrix.SpecialLinearGroup (Fin (m + 1))
          (GaloisField 2 g)))).map φ.rangeRestrict ∧
      pCoreOf 2 (Subgroup.normalizer
          ((R.map φ.rangeRestrict : Subgroup ↥φ.range) : Set ↥φ.range)) =
        (pCoreOf 2 (Subgroup.normalizer (R : Set (Matrix.SpecialLinearGroup (Fin (m + 1))
          (GaloisField 2 g))))).map φ.rangeRestrict := by
  have hker' : φ.rangeRestrict.ker ≤
      Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)) := by
    rwa [MonoidHom.ker_rangeRestrict]
  have hodd' : Odd (Nat.card φ.rangeRestrict.ker) := by
    rwa [MonoidHom.ker_rangeRestrict]
  have hM : φ.rangeRestrict.ker ≤
      Subgroup.normalizer (R : Set (Matrix.SpecialLinearGroup (Fin (m + 1))
        (GaloisField 2 g))) :=
    hker'.trans (Subgroup.center_le_normalizer
      (R : Set (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g))))
  have hrange : φ.rangeRestrict.range = ⊤ :=
    MonoidHom.range_eq_top.2 (MonoidHom.rangeRestrict_surjective φ)
  have hN := map_normalizer_eq_range_inf_normalizer_map hker' hodd' hR
  rw [hrange, top_inf_eq] at hN
  have hP := map_pCoreOf_eq_of_odd_central_ker hker' hodd' hM
  rw [hN] at hP
  exact ⟨hN.symm, hP.symm⟩

private theorem lr2h2_eq_one_of_mem_inf_of_isPGroup_two_of_odd_card {G : Type*} [Group G]
    {K R : Subgroup G} (hKodd : Odd (Nat.card K)) (hR : IsPGroup 2 R)
    {x : G} (hxR : x ∈ R) (hxK : x ∈ K) : x = 1 := by
  obtain ⟨k, hk⟩ := (isPGroup_iff_orderOf_dvd_pow.mp hR) ⟨x, hxR⟩
  rw [Subgroup.orderOf_mk] at hk
  have hdvd : orderOf x ∣ Nat.card K := Subgroup.orderOf_dvd_natCard K hxK
  exact orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (hKodd.coprime_two_left.pow_left k) hk hdvd)

private theorem lr2h2_le_of_isPGroup_le_sup_of_odd_central {G : Type*} [Group G]
    {K R S : Subgroup G} [K.Normal] (hKc : K ≤ Subgroup.center G) (hKodd : Odd (Nat.card K))
    (hR : IsPGroup 2 R) (hS : IsPGroup 2 S) (hSR : S ≤ R ⊔ K) : S ≤ R := by
  intro g hgS
  obtain ⟨j, hj⟩ := hS ⟨g, hgS⟩
  have hgj : g ^ 2 ^ j = 1 := by simpa using congrArg Subtype.val hj
  obtain ⟨r, hrR, z, hzK, hrz⟩ := (Subgroup.mem_sup_of_normal_right (s := R) (t := K)).mp (hSR hgS)
  have hcomm : Commute r z := Subgroup.mem_center_iff.mp (hKc hzK) r
  have hpow : (r * z) ^ 2 ^ j = r ^ 2 ^ j * z ^ 2 ^ j := hcomm.mul_pow _
  have hrp : r ^ 2 ^ j * z ^ 2 ^ j = 1 := by rw [← hpow, hrz, hgj]
  have hzpowR : z ^ 2 ^ j ∈ R := by
    have hz : z ^ 2 ^ j = (r ^ 2 ^ j)⁻¹ := eq_inv_of_mul_eq_one_right hrp
    rw [hz]
    exact R.inv_mem (R.pow_mem hrR _)
  have hzpowK : z ^ 2 ^ j ∈ K := K.pow_mem hzK _
  have hzpow1 : z ^ 2 ^ j = 1 :=
    lr2h2_eq_one_of_mem_inf_of_isPGroup_two_of_odd_card hKodd hR hzpowR hzpowK
  have hz1 : z = 1 := by
    have hdvd1 : orderOf z ∣ 2 ^ j := orderOf_dvd_of_pow_eq_one hzpow1
    have hdvd2 : orderOf z ∣ Nat.card K := Subgroup.orderOf_dvd_natCard K hzK
    exact orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes (hKodd.coprime_two_left.pow_left j) hdvd1 hdvd2)
  rw [← hrz, hz1, mul_one]
  exact hrR

theorem lift_map_eq_of_map_eq_specialLinear {m g : ℕ}
    {X : Type} [Group X] [Finite X]
    (φ : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g) →* X)
    (hker : φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)))
    (hodd : Odd (Nat.card φ.ker))
    {R : Subgroup (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g))}
    (hR : IsPGroup 2 R) (ŷ : MulAut (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)))
    (y : MulAut ↥φ.range) (hŷ : ∀ s, y (φ.rangeRestrict s) = φ.rangeRestrict (ŷ s))
    (hy : (R.map φ.rangeRestrict).map y.toMonoidHom = R.map φ.rangeRestrict) :
    R.map ŷ.toMonoidHom = R := by
  have hle : R.map ŷ.toMonoidHom ≤ R ⊔ φ.ker := by
    rintro x ⟨r, hrR, rfl⟩
    have hmem : φ.rangeRestrict r ∈ R.map φ.rangeRestrict :=
      Subgroup.mem_map.mpr ⟨r, hrR, rfl⟩
    have hyr : y (φ.rangeRestrict r) ∈ R.map φ.rangeRestrict := by
      have hyr' : y (φ.rangeRestrict r) ∈ (R.map φ.rangeRestrict).map y.toMonoidHom :=
        Subgroup.mem_map.mpr ⟨φ.rangeRestrict r, hmem, rfl⟩
      rwa [hy] at hyr'
    have hmem' : φ.rangeRestrict (ŷ r) ∈ R.map φ.rangeRestrict := by
      rwa [← hŷ r]
    obtain ⟨r', hr'R, hr'eq⟩ := Subgroup.mem_map.mp hmem'
    have hker_mem : ŷ r * r'⁻¹ ∈ φ.ker := by
      rw [MonoidHom.mem_ker]
      have hv : φ r' = φ (ŷ r) := by simpa using congrArg Subtype.val hr'eq
      rw [map_mul, map_inv, hv, mul_inv_cancel]
    have hrw : (MulEquiv.toMonoidHom ŷ) r = (MulEquiv.toMonoidHom ŷ) r * r'⁻¹ * r' := by
      group
    rw [hrw]
    simpa [sup_comm] using Subgroup.mul_mem_sup hker_mem hr'R
  have hS : IsPGroup 2 (R.map ŷ.toMonoidHom) := hR.map ŷ.toMonoidHom
  haveI : (φ.ker).Normal := φ.normal_ker
  have hle' : R.map ŷ.toMonoidHom ≤ R :=
    lr2h2_le_of_isPGroup_le_sup_of_odd_central hker hodd hR hS hle
  have hcard : Nat.card (R.map ŷ.toMonoidHom) = Nat.card R :=
    Subgroup.card_map_of_injective ŷ.injective
  exact Subgroup.eq_of_le_of_card_ge hle' (le_of_eq hcard.symm)

theorem ggRootNormInner_map_specialLinear {m g : ℕ} (hm : 2 ≤ m) (hg : 1 ≤ g)
    {X : Type} [Group X] [Finite X]
    (φ : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g) →* X)
    (hker : φ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)))
    {R : Subgroup (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g))}
    (hR : IsPGroup 2 R) (hI : GGRootNormInnerZ R) :
    GGRootNormInner ((R.map φ).subgroupOf φ.range) := by
  have hodd : Odd (Nat.card φ.ker) := by
    have h1 : Nat.card φ.ker ∣ Nat.card (Subgroup.center (Matrix.SpecialLinearGroup
        (Fin (m + 1)) (GaloisField 2 g))) := Subgroup.card_dvd_of_le hker
    have h2 : Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1))
        (GaloisField 2 g))) ∣ Nat.gcd (m + 1) (Nat.card (GaloisField 2 g) - 1) :=
      CFSG.LieType.Steinberg.card_center_specialLinearGroup_dvd (n := m + 1) (by omega)
        (GaloisField 2 g)
    have h3 : Odd (Nat.gcd (m + 1) (Nat.card (GaloisField 2 g) - 1)) := by
      refine Odd.of_dvd_nat ?_ (Nat.gcd_dvd_right _ _)
      rw [GaloisField.card 2 g (by omega)]
      exact Nat.Even.sub_odd (Nat.one_le_pow g 2 (by norm_num))
        (Even.pow_of_ne_zero (by norm_num : Even 2) (by omega)) odd_one
    exact Odd.of_dvd_nat h3 (h1.trans h2)
  intro y hy2 hyR hymod
  obtain ⟨ŷ, hŷ⟩ := exists_lift_mulAut_specialLinear hm hg φ hker y
  have hpow : ∀ n : ℕ, ∀ s : Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g),
      φ.rangeRestrict ((ŷ ^ n) s) = (y ^ n) (φ.rangeRestrict s) := by
    intro n
    induction n with
    | zero => intro s; simp
    | succ n ih =>
      intro s
      rw [pow_succ, pow_succ]
      simp only [MulAut.mul_apply]
      rw [ih, ← hŷ]
  have hŷ2 : ∃ k : ℕ, ŷ ^ 2 ^ k = 1 := by
    obtain ⟨k, hk⟩ := hy2
    refine ⟨k, ?_⟩
    refine lift_mulAut_unique_specialLinear hm hg φ hker ?_
    intro s
    rw [hpow, hk]
    simp
  have hRbar : R.map φ.rangeRestrict = (R.map φ).subgroupOf φ.range := by
    ext x
    rw [Subgroup.mem_map, Subgroup.mem_subgroupOf]
    constructor
    · rintro ⟨r, hr, hx⟩
      exact ⟨r, hr, by simpa using congrArg Subtype.val hx⟩
    · rintro ⟨r, hr, hx⟩
      exact ⟨r, hr, Subtype.ext (by simpa using hx)⟩
  have hŷR : R.map ŷ.toMonoidHom = R := by
    refine lift_map_eq_of_map_eq_specialLinear φ hker hodd hR ŷ y hŷ ?_
    rw [hRbar]
    exact hyR
  have hŷmod : ∀ n ∈ Subgroup.normalizer (R : Set (Matrix.SpecialLinearGroup
        (Fin (m + 1)) (GaloisField 2 g))),
      ŷ n * n⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer (R : Set (Matrix.SpecialLinearGroup
        (Fin (m + 1)) (GaloisField 2 g)))) ⊔
        Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) (GaloisField 2 g)) := by
    intro n hn
    have hN := (normalizer_pCore_map_specialLinear φ hker hodd hR).1
    have hP := (normalizer_pCore_map_specialLinear φ hker hodd hR).2
    have hnbar : φ.rangeRestrict n ∈ Subgroup.normalizer
        (((R.map φ).subgroupOf φ.range : Subgroup ↥φ.range) : Set ↥φ.range) := by
      rw [← hRbar, hN]
      exact ⟨n, hn, rfl⟩
    have h1 := hymod (φ.rangeRestrict n) hnbar
    rw [← hRbar] at h1
    rw [hP] at h1
    rw [hŷ n, ← map_inv, ← map_mul] at h1
    obtain ⟨m, hm, hmn⟩ := Subgroup.mem_map.mp h1
    have hker_mem : m⁻¹ * (ŷ n * n⁻¹) ∈ φ.ker := by
      rw [MonoidHom.mem_ker]
      have hval : φ m = φ (ŷ n * n⁻¹) := by
        simpa only [MonoidHom.coe_rangeRestrict] using congrArg Subtype.val hmn
      rw [map_mul, map_inv, hval]
      simp
    have hmem := Subgroup.mul_mem_sup hm (hker hker_mem)
    rwa [show m * (m⁻¹ * (ŷ n * n⁻¹)) = ŷ n * n⁻¹ by group] at hmem
  obtain ⟨k, hk⟩ := hI ŷ hŷ2 hŷR hŷmod
  refine ⟨φ.rangeRestrict k, ?_⟩
  ext t
  obtain ⟨s, hs⟩ := MonoidHom.rangeRestrict_surjective φ t
  rw [← hs, hŷ s, hk]
  simp [MulAut.conj_apply, map_mul]

private theorem lr2m_ggRootNormInner_ggU_psl
    {m g : ℕ} (hdim : (g = 1 ∧ 4 ≤ m) ∨ (2 ≤ g ∧ 3 ≤ m) ∨ (3 ≤ g ∧ 2 ≤ m))
    {X : Type} [Group X] [Finite X]
    (φ : (ggU .PSL (m + 1) g).K →* X) (hker : φ.ker ≤ Subgroup.center (ggU .PSL (m + 1) g).K)
    {β : Fin (ggU .PSL (m + 1) g).D.rank → ℤ} (hβ : β ∈ (ggU .PSL (m + 1) g).D.roots)
    (u : (ggU .PSL (m + 1) g).K) :
    GGRootNormInner ((ggRootSub (ggU .PSL (m + 1) g).D φ β u).subgroupOf φ.range) := by
  have hm : 2 ≤ m := by omega
  have hg : 1 ≤ g := by omega
  have hRg : IsPGroup 2 (ggRootSub (ggU .PSL (m + 1) g).D
      (MonoidHom.id (ggU .PSL (m + 1) g).K) β u) :=
    rootGroup_isPGroup_PSL hβ u rfl
  have hIZ : GGRootNormInnerZ (ggRootSub (ggU .PSL (m + 1) g).D
      (MonoidHom.id (ggU .PSL (m + 1) g).K) β u) :=
    ggRootNormInnerZ_specialLinear hdim hβ u
  have hmap := ggRootNormInner_map_specialLinear hm hg φ hker hRg hIZ
  have heq : ggRootSub (ggU .PSL (m + 1) g).D φ β u =
      (ggRootSub (ggU .PSL (m + 1) g).D
        (MonoidHom.id (ggU .PSL (m + 1) g).K) β u).map φ :=
    CFSG.StandardType.LieKnownR2.Short.ggRootSub_eq_map _ _ _ _
  rw [heq]
  exact hmap

theorem ggRootInnerAt_ggU_psl
    {m g : ℕ} (hdim : (g = 1 ∧ 4 ≤ m) ∨ (2 ≤ g ∧ 3 ≤ m) ∨ (3 ≤ g ∧ 2 ≤ m))
    {X : Type} [Group X] [Finite X]
    (φ : (ggU .PSL (m + 1) g).K →* X) (hker : φ.ker ≤ Subgroup.center (ggU .PSL (m + 1) g).K)
    {β : Fin (ggU .PSL (m + 1) g).D.rank → ℤ} (hβ : β ∈ (ggU .PSL (m + 1) g).D.roots)
    (u : (ggU .PSL (m + 1) g).K) :
    GGRootInnerAt φ.range (ggRootSub (ggU .PSL (m + 1) g).D φ β u) := by
  have hI := lr2m_ggRootNormInner_ggU_psl hdim φ hker hβ u
  intro Y hY2 hYK hYR hNY
  refine ggRootNormInner_le_sup_centralizer ?_ hYK hYR hY2 hNY hI
  exact Subgroup.map_le_range _ _

theorem itemThree_ggU_psl
    {m g : ℕ} (hdim : (g = 1 ∧ 4 ≤ m) ∨ (2 ≤ g ∧ 3 ≤ m) ∨ (3 ≤ g ∧ 2 ≤ m))
    {X : Type} [Group X] [Finite X]
    (ψ : (ggU .PSL (m + 1) g).K →* X) (hker : ψ.ker ≤ Subgroup.center (ggU .PSL (m + 1) g).K)
    {β : Fin (ggU .PSL (m + 1) g).D.rank → ℤ} (hβ : β ∈ (ggU .PSL (m + 1) g).D.roots)
    (u : (ggU .PSL (m + 1) g).K) {R : Subgroup X}
    (hR : R = ggRootSub (ggU .PSL (m + 1) g).D ψ β u) :
    ∀ Y : Subgroup X, IsPGroup 2 Y → Y ≤ Subgroup.normalizer (ψ.range : Set X) →
      Y ≤ Subgroup.normalizer (R : Set X) →
      ⁅Y, ψ.range ⊓ Subgroup.normalizer (R : Set X)⁆ ≤
        pCoreOf 2 (ψ.range ⊓ Subgroup.normalizer (R : Set X)) →
      Y ≤ ψ.range ⊔ Subgroup.centralizer (ψ.range : Set X) := by
  have hI := lr2m_ggRootNormInner_ggU_psl hdim ψ hker hβ u
  intro Y hY2 hYK hYR hcomm
  refine ggRootNormInner_le_sup_centralizer_of_commutator ?_ hYK hYR hY2 hcomm ?_
  · rw [hR]
    exact Subgroup.map_le_range _ _
  · rw [hR]
    exact hI

