private theorem ggAutFixedSubgroup_conj_eq_centralizer {R : Type*} [Group R] (s : R) :
    ggAutFixedSubgroup (MulAut.conj s) = Subgroup.centralizer ({s} : Set R) := by
  ext g
  rw [mem_ggAutFixedSubgroup, MulAut.conj_apply, mul_inv_eq_iff_eq_mul,
    Subgroup.mem_centralizer_singleton_iff]
  exact ⟨fun h => h.symm, fun h => h.symm⟩

private theorem map_centralizer_singleton_eq {A B : Type*} [Group A] [Group B] (e : A ≃* B)
    (s : A) :
    (Subgroup.centralizer ({s} : Set A)).map (e : A →* B) =
      Subgroup.centralizer ({e s} : Set B) := by
  ext b
  simp only [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff, MonoidHom.coe_coe]
  constructor
  · rintro ⟨a, ha, rfl⟩
    rw [← map_mul, ← map_mul, ha]
  · intro hb
    refine ⟨e.symm b, ?_, by simp⟩
    apply e.injective
    rw [map_mul, map_mul, e.apply_symm_apply]
    exact hb

private theorem lit_fixedSpace_eq {F V : Type*} [Field F] [AddCommGroup V] [Module F V]
    (x : V ≃ₗ[F] V) : LIT.fixedSpace x = KCOrthogonal.fixedSpace x := by
  ext v
  rw [LIT.mem_fixedSpace, KCOrthogonal.mem_fixedSpace]

theorem ggD4InnerOneInput_holds : GGD4InnerOneInput := by
  intro K _ _ _ hK2 s hs3 hd J hJ
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hQ, -⟩ := regular_coordinateQuadPlus (K := K) (n := 4) (by norm_num)
  have hV : CFSG.GroupTheory.WeirSylow.IsPlusType (coordinateQuadPlus 4 K) ↔ Even 4 :=
    iff_of_true ((CFSG.GroupTheory.WeirSylow.isPlusType_congr (coordinatePlusIsometry 4 K)).1
      (CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus K 4)) (by decide)
  have hs1 : s ≠ 1 := by
    rintro rfl
    rw [D4Rank.omFixDim_one] at hd
    omega
  have hs : orderOf s = 3 := orderOf_eq_prime hs3 hs1
  have hJ' : CFSG.Open.IsComponentOf J (Subgroup.centralizer ({s} : Set (Om8 K))) := by
    rw [← ggAutFixedSubgroup_conj_eq_centralizer]
    exact CFSG.Assembly.isComponentOf_iff_open.1 hJ
  have hL := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map
    (projEquiv8.trans (KCOrthogonalAut.coordBridge (coordinateQuadPlus 4 K)
      (by norm_num : 0 < 2 * 4))) hJ'
  rw [map_centralizer_singleton_eq, bridge_apply_eq_mk] at hL
  have hfd := OPlusEight.omFixDim_eq_finrank_fixedSpace s
  have hx3 : orderOf (KCOrthComm.matrixDerivedEquiv (coordinateQuadPlus 4 K) s) = 3 := by
    rw [MulEquiv.orderOf_eq]
    exact hs
  generalize KCOrthComm.matrixDerivedEquiv (coordinateQuadPlus 4 K) s = x at hL hfd hx3
  obtain ⟨hx, -, hmem, s', hs', hsm, htype⟩ :=
    dims_of_orderOf_three (Or.inl hK2) hQ (by rw [Module.finrank_fin_fun]) hV x hx3
  have h2s : D4Rank.omFixDim s = 2 * s' := by
    rw [hfd, lit_fixedSpace_eq]
    exact hs'
  rcases inner_comp_cases (Or.inl hK2) hQ x hx3 hL with ⟨-, hq, -⟩ |
    ⟨G, hGq, hGle, hGn, -, -⟩
  ·
    have h4 := (specialBlock_phi_type (Or.inl hK2) hx hmem hq).1 hK2
    omega
  ·
    refine fixed_not_small hQ hx hs' htype ?_ hGq hGle hGn
    rcases hd with hd | hd
    · exact Or.inl (by omega)
    · exact Or.inr ⟨by omega, hK2⟩

