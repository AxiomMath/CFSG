theorem tmOrb_list8_ok : ∀ j < 4, (tmOrb_list8 j).length = 240 ∧
    (tmOrb_list8 j).all (fun u => !(decide (u = 0)) && tmOrb_lab8 (tmOrb_code8 u) == j) = true := by
  decide +kernel

theorem tmOrb_list8_codes : ∀ j < 4, CFSG.Decide.bitsetNodup ((tmOrb_list8 j).map tmOrb_code8) = true := by
  decide +kernel

theorem tmOrb_dual8_dual8 (i : Fin 8) (c : Fin 8 → ZMod 3) : tmOrb_dual8 i (tmOrb_dual8 i c) = c := by
  funext j
  have hii : tmOrb_negCart8 i i = 1 := by fin_cases i <;> rfl
  have h3 : (3 : ZMod 3) = 0 := rfl
  simp only [tmOrb_dual8, hii]
  linear_combination (c i * tmOrb_negCart8 i j) * h3

theorem tmOrb_dual8_zero (i : Fin 8) : tmOrb_dual8 i 0 = 0 := by
  funext j
  simp [tmOrb_dual8]

theorem tmOrb_dual8_card (T : Set (Fin 8 → ZMod 3)) (hT : ∀ i, ∀ c ∈ T, tmOrb_dual8 i c ∈ T)
    {c : Fin 8 → ZMod 3} (hc : c ∈ T) (hc0 : c ≠ 0) : 240 ≤ T.ncard := by
  have hok : ∀ v : Fin 8 → ZMod 3, v ≠ 0 →
      tmOrb_lab8 (tmOrb_code8 v) < 4 ∧
      (∀ i, tmOrb_lab8 (tmOrb_code8 (tmOrb_dual8 i v)) = tmOrb_lab8 (tmOrb_code8 v)) ∧
      (tmOrb_dep8 (tmOrb_code8 v) = 0 → v = tmOrb_rep8 (tmOrb_lab8 (tmOrb_code8 v))) ∧
      (tmOrb_dep8 (tmOrb_code8 v) ≠ 0 → ∃ i,
        tmOrb_dep8 (tmOrb_code8 (tmOrb_dual8 i v)) < tmOrb_dep8 (tmOrb_code8 v)) := by
    intro v hv
    have h := tmOrb_ok8_all v
    simp only [tmOrb_ok8, hv, decide_false, Bool.false_or, Bool.and_eq_true, decide_eq_true_eq,
      List.all_eq_true, List.mem_finRange, true_implies, beq_iff_eq] at h
    obtain ⟨⟨hlt, hlab⟩, hrest⟩ := h
    refine ⟨hlt, hlab, fun h0 => ?_, fun h0 => ?_⟩
    · simpa [h0] using hrest
    · simpa [h0, List.any_eq_true] using hrest
  obtain ⟨hlt, -, -, -⟩ := hok c hc0
  obtain ⟨hlen, hall⟩ := tmOrb_list8_ok _ hlt
  have hL := CFSG.Decide.nodup_of_bitsetNodup tmOrb_code8 (tmOrb_list8_codes _ hlt)
  rw [← hlen]
  refine tmOrb_length_le_ncard_of_tables tmOrb_dual8 tmOrb_dual8_dual8 tmOrb_dual8_zero
    (fun v => tmOrb_lab8 (tmOrb_code8 v)) (fun v => tmOrb_dep8 (tmOrb_code8 v)) tmOrb_rep8
    (fun v hv => (hok v hv).2.1) (fun v hv => (hok v hv).2.2.1) (fun v hv => (hok v hv).2.2.2)
    hT hc hc0 _ hL fun u hu => ?_
  rw [List.all_eq_true] at hall
  have := hall u hu
  simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, beq_iff_eq] at this
  exact this

theorem tmOrb_negCart8_symm (i j : Fin 8) : tmOrb_negCart8 i j = tmOrb_negCart8 j i := by
  revert i j; decide

theorem tmOrb_cmap8_inv (x : Fin 8 → ZMod 3) :
    (fun k => ∑ j, tmOrb_negCartInv8 k j * tmOrb_cmap8 x j) = x := by
  have h : ∀ k l : Fin 8, ∑ j, tmOrb_negCartInv8 k j * tmOrb_negCart8 j l = if k = l then 1 else 0 := by
    decide
  funext k
  simp only [tmOrb_cmap8, Finset.mul_sum, ← mul_assoc]
  rw [Finset.sum_comm]
  simp only [← Finset.sum_mul, h, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ,
    if_true]

theorem tmOrb_cmap8_injective : Function.Injective tmOrb_cmap8 := fun x y hxy => by
  rw [← tmOrb_cmap8_inv x, ← tmOrb_cmap8_inv y, hxy]

theorem tmOrb_dual8_cmap8 (i : Fin 8) (x : Fin 8 → ZMod 3) :
    tmOrb_dual8 i (tmOrb_cmap8 x) = tmOrb_cmap8 (tmOrb_refl8 i x) := by
  funext k
  simp only [tmOrb_dual8, tmOrb_cmap8, tmOrb_refl8, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
    mul_add, Finset.sum_add_distrib, Pi.single_apply, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [tmOrb_negCart8_symm i k]
  congr 1
  rw [mul_comm]
  congr 1
  exact Finset.sum_congr rfl fun j _ => by rw [tmOrb_negCart8_symm]

theorem tmOrb_refl8_card (X : Set (Fin 8 → ZMod 3)) (hX : ∀ i, ∀ x ∈ X, tmOrb_refl8 i x ∈ X)
    {x : Fin 8 → ZMod 3} (hx : x ∈ X) (hx0 : x ≠ 0) : 240 ≤ X.ncard := by
  have h0 : tmOrb_cmap8 0 = 0 := by funext k; simp [tmOrb_cmap8]
  rw [← Set.ncard_image_of_injective X tmOrb_cmap8_injective]
  refine tmOrb_dual8_card _ (fun i c hc => ?_) (Set.mem_image_of_mem _ hx)
    fun h => hx0 (tmOrb_cmap8_injective (h.trans h0.symm))
  obtain ⟨y, hy, rfl⟩ := hc
  rw [tmOrb_dual8_cmap8]
  exact Set.mem_image_of_mem _ (hX i y hy)

