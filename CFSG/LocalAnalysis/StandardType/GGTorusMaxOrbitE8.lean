theorem tmOrb_ok8_c20 : ∀ c d e f g h : ZMod 3, tmOrb_ok8 ![2, 0, c, d, e, f, g, h] = true := by
  decide +kernel

theorem tmOrb_ok8_c21 : ∀ c d e f g h : ZMod 3, tmOrb_ok8 ![2, 1, c, d, e, f, g, h] = true := by
  decide +kernel

theorem tmOrb_ok8_c22 : ∀ c d e f g h : ZMod 3, tmOrb_ok8 ![2, 2, c, d, e, f, g, h] = true := by
