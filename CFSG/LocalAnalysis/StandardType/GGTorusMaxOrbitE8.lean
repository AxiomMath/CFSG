theorem tmOrb_ok8_all (v : Fin 8 → ZMod 3) : tmOrb_ok8 v = true := by
  have hv : v = ![v 0, v 1, v 2, v 3, v 4, v 5, v 6, v 7] := by
    funext k; fin_cases k <;> rfl
  rw [hv]
  generalize v 0 = a, v 1 = b, v 2 = c, v 3 = d, v 4 = e, v 5 = f, v 6 = g, v 7 = h
  fin_cases a <;> fin_cases b
  · exact tmOrb_ok8_c00 c d e f g h
  · exact tmOrb_ok8_c01 c d e f g h
  · exact tmOrb_ok8_c02 c d e f g h
  · exact tmOrb_ok8_c10 c d e f g h
  · exact tmOrb_ok8_c11 c d e f g h
  · exact tmOrb_ok8_c12 c d e f g h
  · exact tmOrb_ok8_c20 c d e f g h
  · exact tmOrb_ok8_c21 c d e f g h
  · exact tmOrb_ok8_c22 c d e f g h

