theorem ggKGOmM_isChevSimple_statedOmega {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hn : 4 ≤ n) {b c : K} (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    CFSG.Yardstones.Md0ec50421ce4.IsChevSimple 2
      (↥(StatedOmega (StatedQuadMinus n K b c))) := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  let V := Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → K
  let Q : QuadraticForm K V := CFSG.LieType.Universal.Spin.quadMinus n K b c
  have hQ : ⇑Q = StatedQuadMinus n K b c :=
    CFSG.LieType.Universal.Spin.coe_quadMinus n K b c
  have hnd : (QuadraticMap.polarBilin Q).Nondegenerate :=
    CFSG.LieType.Universal.Spin.nondegenerate_polarBilin_quadMinus_of_finite n K hirr
  have hE := CFSG.ClassicalGroups.Orthogonal.commutator_orthogonalGroup_quadMinus
    (n := n) (K := K) hn hirr
  have hqΩ := CFSG.LieType.Universal.Spin.isQuasisimple_statedOmega_quadMinus
    (n := n) (K := K) hn hirr
  have hEq : CFSG.RankThree.Classical2.orthDerived Q =
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup Q := hE
  have e := CFSG.ClassicalGroups.Orthogonal.statedOmegaEquiv hQ hE
  have hqE : CFSG.IsQuasisimple ↥(CFSG.ClassicalGroups.Orthogonal.elementaryGroup Q) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv e hqΩ
  have hqOrth : CFSG.IsQuasisimple (CFSG.RankThree.Classical2.orthDerived Q) := hEq.symm ▸ hqE
  have hqL : CFSG.IsQuasisimple ↥(⊤ : Subgroup (CFSG.RankThree.Classical2.orthDerived Q)) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv (Subgroup.topEquiv).symm hqOrth
  obtain ⟨X, hXg, hXf, hLie, f, hf, hk⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.omegaFactorFacts_holds
      (K := K) (V := V) (Q := Q) hnd (⊤ : Subgroup (CFSG.RankThree.Classical2.orthDerived Q))
      inferInstance hqL
  have hLie2 : CFSG.HardMathSupport.Solomon.Coordinator.LieComp.LieFactorData 2 X :=
    ringChar.eq K 2 ▸ hLie
  let eL : ↥(StatedOmega (StatedQuadMinus n K b c)) ≃*
      ↥(⊤ : Subgroup (CFSG.RankThree.Classical2.orthDerived Q)) :=
    e.trans ((MulEquiv.subgroupCongr hEq).symm.trans (Subgroup.topEquiv).symm)
  let f' : X →* ↥(StatedOmega (StatedQuadMinus n K b c)) := eL.symm.toMonoidHom.comp f
  have hf' : Function.Surjective f' := eL.symm.surjective.comp hf
  have hk' : f'.ker ≤ Subgroup.center X := by
    intro x hx
    apply hk
    rw [MonoidHom.mem_ker] at hx ⊢
    exact eL.symm.injective (by rw [map_one]; exact hx)
  have hLCD : CFSG.HardMathSupport.Solomon.Coordinator.LieComp.LieCompData 2
      (↥(StatedOmega (StatedQuadMinus n K b c))) := hLie2.lieCompData f' hf' hk'
  have hchevZ := hLCD.chev
  have hZ : Subgroup.center (↥(StatedOmega (StatedQuadMinus n K b c))) = ⊥ :=
    center_statedOmega_quadMinus_eq_bot hn hirr
  have eZ : (↥(StatedOmega (StatedQuadMinus n K b c)) ⧸
      Subgroup.center (↥(StatedOmega (StatedQuadMinus n K b c)))) ≃*
      ↥(StatedOmega (StatedQuadMinus n K b c)) :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.isChevSimple_congr eZ hchevZ

end CFSG.StandardType

