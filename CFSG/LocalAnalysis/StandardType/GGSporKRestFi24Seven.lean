private theorem ggSporKRestFi24Seven_generating
    {x : J} (hx : IsConj C7 x) :
    SporKRestGenerating 7 x := by
  obtain ⟨S, hS⟩ := Q7_sylow
  have hc91 := fi7_facts.c91
  have hc77 := fi7_facts.c77
  have hC : C7 ∈ (S : Subgroup J) := hS ▸ C7_mem
  refine ggSporKRest_generating_of_closure (by norm_num) S hx gens7 ?_ ?_
  · intro z hz
    simp only [gens7, Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨1, C7, hC, by simp, Subgroup.mem_centralizer_singleton_iff.2 s7_1085_comm⟩
    · exact ⟨1, C7, hC, by simp, Subgroup.mem_centralizer_singleton_iff.2 s7_1086_comm⟩
    · refine ⟨M7 91, cube7 91, hS ▸ cube7_mem 91,
        (cube7_eq_conj (by decide) hc91).symm, ?_⟩
      refine Subgroup.mem_centralizer_singleton_iff.2 ?_
      rw [s7_1089, s7_1087, cube7_eq_conj (by decide) hc91]
      exact conj_cent s7_1085_comm
    · refine ⟨M7 91, cube7 91, hS ▸ cube7_mem 91,
        (cube7_eq_conj (by decide) hc91).symm, ?_⟩
      refine Subgroup.mem_centralizer_singleton_iff.2 ?_
      rw [s7_1090, s7_1087, cube7_eq_conj (by decide) hc91]
      exact conj_cent s7_1086_comm
    · refine ⟨M7 77, cube7 77, hS ▸ cube7_mem 77,
        (cube7_eq_conj (by decide) hc77).symm, ?_⟩
      refine Subgroup.mem_centralizer_singleton_iff.2 ?_
      rw [s7_1091, s7_1088, cube7_eq_conj (by decide) hc77]
      exact conj_cent s7_1085_comm
    · refine ⟨M7 77, cube7 77, hS ▸ cube7_mem 77,
        (cube7_eq_conj (by decide) hc77).symm, ?_⟩
      refine Subgroup.mem_centralizer_singleton_iff.2 ?_
      rw [s7_1092, s7_1088, cube7_eq_conj (by decide) hc77]
      exact conj_cent s7_1086_comm
  · rw [eq_top_iff, ← fi7_gens_top]
    exact Subgroup.closure_mono Set.subset_union_right

private theorem ggSporKRestFi24Seven_cover_J :
    SporKRestCover 7 ↥J := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  letI : MulAction.IsPretransitive ↥J (Sylow 7 ↥J) := Sylow.isPretransitive_of_finite (p := 7) (G := ↥J)
  intro E hE hcard
  obtain ⟨P, hEP⟩ := (IsPGroup.of_card (n := 2) hcard).exists_le_sylow
  obtain ⟨QS, hQS⟩ := Q7_sylow
  obtain ⟨c, hc⟩ := MulAction.IsPretransitive.exists_smul_eq (M := ↥J) (α := Sylow 7 ↥J) QS P
  have hP : (P : Subgroup J) = Q7.map (MulAut.conj c).toMonoidHom := by
    have hc' : ((c • QS : Sylow 7 J) : Subgroup J) = (P : Subgroup J) :=
      congrArg (fun P : Sylow 7 J => (P : Subgroup J)) hc
    rw [← hc', ← hQS]
    ext x
    change x ∈ (((c • QS : Sylow 7 J) : Set J)) ↔
      x ∈ (((QS : Subgroup J).map (MulAut.conj c).toMonoidHom) : Set J)
    rw [Sylow.coe_smul, Subgroup.coe_map]
    simp only [Set.mem_smul_set, Set.mem_image, MulAut.conj_apply]
    constructor <;> rintro ⟨y, hy, hyx⟩ <;> exact ⟨y, hy, hyx⟩
  have hEc : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := fun a ha b hb => hE.comm ha hb
  have hmem : c * C7 * c⁻¹ ∈ E :=
    ((sevenLine_c.conj c).mem_plane (hP ▸ hEP) hcard hEc).1
  refine ⟨c * C7 * c⁻¹, hmem, ?_, ggSporKRestFi24Seven_generating (isConj_iff.2 ⟨c, rfl⟩)⟩
  intro h
  apply C7_ne_one
  have h2 : C7 = c⁻¹ * (c * C7 * c⁻¹) * c := by group
  rw [h2, h]
  group

theorem sporKRest_cover_Fi24Prime_7_carrier :
    SporKRestCover 7 Blueprint.NativeSporadic.Fi24prime :=
  @SporKRestCover.of_mulEquiv ↥J Blueprint.NativeSporadic.Fi24prime inferInstance inferInstance
    fi24EquivJ.symm 7 ggSporKRestFi24Seven_cover_J

theorem sporKRest_cover_Fi24Prime_7 :
    SporKRestCover 7 (TauCeti.CFSGIndex.sporadic .Fi24Prime).Group := by
  obtain ⟨e⟩ := CFSG.Sporadic.Bridge.Fi24.nonempty_mulEquiv
  exact @SporKRestCover.of_mulEquiv Blueprint.NativeSporadic.Fi24prime
    (TauCeti.CFSGIndex.sporadic .Fi24Prime).Group inferInstance inferInstance e 7
    sporKRest_cover_Fi24Prime_7_carrier

