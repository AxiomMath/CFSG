theorem tmOut_trialityD4
    (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower)
    (hd : d.1 = .trialityD4 q)
    (J : Type) [Group J] [Finite J] (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  have hd' : d' = .trialityD4 q := hd
  subst hd'
  obtain ⟨e⟩ := e
  have houtCat :
      Nat.card (Outer (TauCeti.CFSGIndex.lie ⟨.trialityD4 q, hv⟩).Group) ∣ 3 * q.exponent :=
    CFSG.RankThree.PartTwo.Sec13.K135GL12.gl12kE_3D4_card_outer q hv
  have houtJ : Nat.card (Outer J) ∣ 3 * q.exponent := by
    rw [CFSG.RankThree.PartTwo.Sec13.K135GL12.gl12kE_card_outer_congr e]
    exact houtCat
  have ht : tmLieOut (.trialityD4 q) = 3 * q.exponent := by simp only [tmLieOut]
  rw [ht]
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd houtJ

theorem tmOut_suzuki
    (d : TauCeti.ValidLieTypeIndex) (m : ℕ) (hd : d.1 = .suzuki m)
    (J : Type) [Group J] [Finite J] (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  have hd' : d' = .suzuki m := hd
  subst hd'
  obtain ⟨e⟩ := e
  have houtJ : Nat.card (Outer J) ∣ 2 * m + 1 := by
    rw [CFSG.RankThree.PartTwo.Sec13.K135GL12.gl12kE_card_outer_congr e]
    exact (CFSG.LieType.Suzuki.Suzuki_model_and_perfect_cover_outer_cyclicity.{0} _ 2 (2 * m + 1)
      (CFSG.LieType.SeitzGeneration.suzukiModel_cat hv)).1.2.1
  have ht : tmLieOut (.suzuki m) = 2 * m + 1 := by simp only [tmLieOut]
  rw [ht]
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd houtJ

theorem tmOut_reeG2
    (d : TauCeti.ValidLieTypeIndex) (m : ℕ) (hd : d.1 = .reeG2 m)
    (J : Type) [Group J] [Finite J] (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  have hd' : d' = .reeG2 m := hd
  subst hd'
  obtain ⟨e⟩ := e
  obtain ⟨X, hfield, hfinite, hchar, hXcard, ⟨e2⟩⟩ :=
    CFSG.LieType.SeitzGeneration.exists_reeGamma_equiv_cat_G2 hv
  let : Field X := hfield
  let : Finite X := hfinite
  let : CharP X CFSG.LieType.Ree.ReeTag.G2.prime := hchar
  have hm : 1 ≤ m := by
    have h := ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
    simpa [TauCeti.LieTypeIndex.inStandardRange_iff] using h
  have houtΓ : Nat.card (Outer (CFSG.LieType.Ree.ReeTag.G2.reeGamma X m)) = 2 * m + 1 :=
    (CFSG.ComponentClassification.LiteratureLocal.SmallRee.outer_reeGamma_cyclic hm hXcard).2
  have houtJ : Nat.card (Outer J) ∣ 2 * m + 1 := by
    rw [CFSG.RankThree.PartTwo.Sec13.K135GL12.gl12kE_card_outer_congr (e.trans e2), houtΓ]
  have ht : tmLieOut (.reeG2 m) = 2 * m + 1 := by simp only [tmLieOut]
  rw [ht]
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd houtJ

theorem tmOut_reeF4
    (d : TauCeti.ValidLieTypeIndex) (m : ℕ) (hd : d.1 = .reeF4 m)
    (J : Type) [Group J] [Finite J] (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  have hd' : d' = .reeF4 m := hd
  subst hd'
  obtain ⟨e⟩ := e
  have hmodel : CFSG.Blueprint.ReeTitsModel J .twistedF4 2 (2 * m + 1) :=
    CFSG.HardMathSupport.Timmesfeld.DefChar.lot_reeTitsModel_twistedF4_of_index m hv e
  have houtJ : Nat.card (Outer J) = 2 * m + 1 :=
    (large_Ree_model_field_outer_group_and_inner_involutions
      J 2 (2 * m + 1) hmodel).2.2.2.2.1
  have ht : tmLieOut (.reeF4 m) = 2 * m + 1 := by simp only [tmLieOut]
  rw [ht]
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd (houtJ ▸ dvd_refl _)

