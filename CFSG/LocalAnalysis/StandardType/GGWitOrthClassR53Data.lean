@[expose] def owR53D_idx (w : Fin 3 → ZMod 5) (c : ZMod 5) : ℕ :=
  (w 0).val.pred + 4 * (w 1).val.pred + 16 * (w 2).val.pred + 64 * c.val.pred

@[expose] def owR53D_root (w : Fin 3 → ZMod 5) (c : ZMod 5) (i : Fin 4) : Fin 3 → ZMod 5 :=
  fun k => ((owR53D_rootTab.getD (owR53D_idx w c) []).getD (3 * i.val + k.val) 0 : ZMod 5)

@[expose] def owR53D_lam (w : Fin 3 → ZMod 5) (c : ZMod 5) (i : Fin 4) : ZMod 5 :=
  ((owR53D_lamTab.getD (owR53D_idx w c) []).getD i.val 0 : ZMod 5)

@[expose] def owR53D_len (w : Fin 3 → ZMod 5) (c : ZMod 5) : ℕ :=
  (owR53D_lenTab.getD (owR53D_idx w c) 0)

@[expose] def owR53D_xs (w : Fin 3 → ZMod 5) (c : ZMod 5) (k : ℕ) : Fin 3 → ZMod 5 :=
  fun i => ((owR53D_xsTab.getD (owR53D_idx w c) []).getD (3 * k + i.val) 0 : ZMod 5)

@[expose] def owR53D_par (w : Fin 3 → ZMod 5) (c : ZMod 5) (k : ℕ) : ℕ :=
  ((owR53D_parTab.getD (owR53D_idx w c) []).getD k 0)

@[expose] def owR53D_gen (w : Fin 3 → ZMod 5) (c : ZMod 5) (k : ℕ) : Fin 4 :=
  Fin.ofNat 4 ((owR53D_genTab.getD (owR53D_idx w c) []).getD k 0)

abbrev owR53D_guard (w : Fin 3 → ZMod 5) (c : ZMod 5) : Prop :=
  w 0 ≠ 0 ∧ w 1 ≠ 0 ∧ w 2 ≠ 0 ∧ c ≠ 0 ∧ ¬ IsSquare (-(w 0 * w 1 * w 2) * c)

theorem owR53D_norms : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ i : Fin 4, (∑ k, w k * (owR53D_root w c i k * owR53D_root w c i k)) = c := by
  decide +kernel

theorem owR53D_cartan : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ i j : Fin 4,
      (owR53D_lam w c i)⁻¹ * owR53D_lam w c j * ((2 * c⁻¹) *
        ∑ k, w k * (owR53D_root w c i k * owR53D_root w c j k)) =
      (CartanMatrix.A 4 i j : ZMod 5) := by
  decide +kernel


@[expose] def owR53D_rf (w : Fin 3 → ZMod 5) (c : ZMod 5) (a : Fin 3 → ZMod 5)
    (v : Fin 3 → ZMod 5) : Fin 3 → ZMod 5 :=
  fun i => v i - ((2 * c⁻¹) * ∑ k, w k * (v k * a k)) * a i

theorem owR53D_cover : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ y : Fin 3 → ZMod 5, (∑ k, w k * (y k * y k)) = c →
      ∃ k : Fin (owR53D_len w c),
        y = owR53D_xs w c k.val ∨ (fun i => -y i) = owR53D_xs w c k.val := by
  decide +kernel

theorem owR53D_chain : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ k : ℕ, 4 ≤ k → k < owR53D_len w c →
      owR53D_xs w c k = owR53D_rf w c (owR53D_root w c (owR53D_gen w c k))
        (owR53D_xs w c (owR53D_par w c k)) := by
  decide +kernel



theorem owR53D_base : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ k : ℕ, k < 4 → owR53D_xs w c k = owR53D_root w c (Fin.ofNat 4 k) := by
  decide +kernel



theorem owR53D_xs_norm : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ k : ℕ, k < owR53D_len w c →
      (∑ i, w i * (owR53D_xs w c k i * owR53D_xs w c k i)) = c := by
  decide +kernel

theorem owR53D_par_lt : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c →
    ∀ k : ℕ, 4 ≤ k → k < owR53D_len w c → owR53D_par w c k < k := by
  decide +kernel



theorem owR53D_lam_mul_self : ∀ w : Fin 3 → ZMod 5, ∀ c : ZMod 5, owR53D_guard w c → ∀ i : Fin 4,
    owR53D_lam w c i * owR53D_lam w c i = 1 := by decide +kernel

theorem owR53D_c_inv : ∀ c : ZMod 5, c ≠ 0 → c⁻¹ * c = 1 := by decide +kernel


