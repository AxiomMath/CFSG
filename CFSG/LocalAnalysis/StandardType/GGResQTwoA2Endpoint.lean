@[expose] def ggResQTwoJIdx (ib : Fin 3) : Fin 2 → Fin 3 :=
  fun i =>
    match ib, i with
    | 0, 0 => 1
    | 0, 1 => 2
    | 1, 0 => 0
    | 1, 1 => 2
    | 2, 0 => 0
    | 2, 1 => 1

theorem ggResQTwoJIdx_injective (ib : Fin 3) :
    Function.Injective (ggResQTwoJIdx ib) := by
  intro i j h
  fin_cases ib <;> fin_cases i <;> fin_cases j <;>
    simp [ggResQTwoJIdx] at h ⊢

theorem ggResQTwoJIdx_ne (ib : Fin 3) (i : Fin 2) : ggResQTwoJIdx ib i ≠ ib := by
  fin_cases ib <;> fin_cases i <;> decide

theorem ggResQTwoJIdx_surjective (ib : Fin 3) :
    ∀ j : Fin 3, j ≠ ib → ∃ i : Fin 2, ggResQTwoJIdx ib i = j := by
  intro j hj
  fin_cases ib <;> fin_cases j <;>
    first
    | exact absurd rfl hj
    | exact ⟨0, rfl⟩
    | exact ⟨1, rfl⟩

private noncomputable def ggResQTwoJEquivE {Λ : Type} {b : Λ} (e : Fin 3 ≃ Λ) (ib : Fin 3)
    (heib : e ib = b) : Fin 2 ≃ {i : Λ // i ≠ b} :=
  Equiv.ofBijective
    (fun k => ⟨e (ggResQTwoJIdx ib k), by
      intro hb
      exact ggResQTwoJIdx_ne ib k (e.injective (hb.trans heib.symm))⟩)
    ⟨fun i j hij =>
        ggResQTwoJIdx_injective ib (e.injective (Subtype.ext_iff.mp hij)),
     fun j => by
       have hne : e.symm j.1 ≠ ib := by
         intro hb
         apply j.2
         calc j.1 = e (e.symm j.1) := (e.apply_symm_apply j.1).symm
           _ = e ib := by rw [hb]
           _ = b := heib
       obtain ⟨k, hk⟩ := ggResQTwoJIdx_surjective ib (e.symm j.1) hne
       refine ⟨k, Subtype.ext ?_⟩
       change e (ggResQTwoJIdx ib k) = j.1
       rw [hk, e.apply_symm_apply]⟩

theorem ggResQTwoResidual_A2_pairing (tag : GGResQTwoResidual)
    (htag1 : tag ≠ .B3b0c2) (htag2 : tag ≠ .C3b0c2)
    {C : Matrix (Fin 3) (Fin 3) ℤ} {ib : Fin 3}
    (hC : C = (ggResQTwoResidualData tag).C)
    (hib : ib = (ggResQTwoResidualData tag).ib) :
    ∀ i j : Fin 2, C (ggResQTwoJIdx ib i) (ggResQTwoJIdx ib j) =
      CartanMatrix.A 2 i j := by
  subst hC
  subst hib
  cases tag <;>
    first
    | (intro i j; fin_cases i <;> fin_cases j <;> decide)
    | exact absurd rfl htag1
    | exact absurd rfl htag2

theorem GGResQTwoResidualCell.exists_tag
    {Λ : Type} {b : Λ} {CL : Matrix Λ Λ ℤ}
    {CK : Matrix (Option {i : Λ // i ≠ b}) (Option {i : Λ // i ≠ b}) ℤ} {u v : ZMod 3}
    (h : GGResQTwoResidualCell b CL CK u v) :
    ∃ tag : GGResQTwoResidual, GGResQTwoResidualCellTag tag b CL CK u v := by
  obtain ⟨n, C, ib, ic, e₁, e₂, e, tag, hCe, hib, hrow, hcol, hCKaa, hshape⟩ := h
  exact ⟨tag, n, C, ib, ic, e₁, e₂, e, hCe, hib, hrow, hcol, hCKaa, hshape⟩

private theorem lineDatum_core
    {G : Type} [Group G] {Bs J : Subgroup G}
    {Λ : Type} [Fintype Λ] [DecidableEq Λ] {b : Λ}
    {V : Type} [AddCommGroup V] [Module (ZMod 3) V]
    {ι : Additive ↥Bs ≃+ V} {φ : Option Λ → MulAut ↥Bs}
    {h : Option Λ → V} {α : Option Λ → Module.Dual (ZMod 3) V}
    {CL : Matrix Λ Λ ℤ} {C : Matrix (Fin 3) (Fin 3) ℤ} {ib : Fin 3}
    {e : Fin 3 ≃ Λ}
    (hCe : ∀ i j, CL (e i) (e j) = C i j) (hib : e ib = b)
    (hφ : ∀ o w, ggLin (p := 3) ι (φ o) w = w - α o w • h o)
    (hrefl : ∀ o, GGIsReflection 3 (φ o))
    (hL : ∀ i j : Λ, α (some i) (h (some j)) = (CL i j : ZMod 3))
    (hsel : LinearIndependent (ZMod 3) h)
    (hJ : ggAutomizer J Bs = Subgroup.closure
      (Set.range fun j : {i : Λ // i ≠ b} => φ (some j)))
    (hpair : ∀ i j : Fin 2, C (ggResQTwoJIdx ib i) (ggResQTwoJIdx ib j) =
      CartanMatrix.A 2 i j) :
    GGResLineJDatum 3 Bs J .A2 := by
  let r : Fin 2 → MulAut ↥Bs := fun k => φ (some (e (ggResQTwoJIdx ib k)))
  let hv : Fin 2 → V := fun k => h (some (e (ggResQTwoJIdx ib k)))
  let αv : Fin 2 → Module.Dual (ZMod 3) V := fun k => α (some (e (ggResQTwoJIdx ib k)))
  let eJ : Fin 2 ≃ {i : Λ // i ≠ b} := ggResQTwoJEquivE e ib hib
  have hrange : Set.range r = Set.range (fun j : {i : Λ // i ≠ b} => φ (some j.1)) := by
    ext ψ
    constructor
    · rintro ⟨k, rfl⟩
      exact ⟨eJ k, rfl⟩
    · rintro ⟨j, rfl⟩
      obtain ⟨k, hk⟩ := eJ.surjective j
      refine ⟨k, ?_⟩
      change φ (some (e (ggResQTwoJIdx ib k))) = φ (some j.1)
      rw [show e (ggResQTwoJIdx ib k) = j.1 from congrArg Subtype.val hk]
  refine ⟨V, inferInstance, inferInstance, ι, r, hv, αv, ?_, ?_, ?_, ?_, ?_⟩
  · intro k w
    exact hφ (some (e (ggResQTwoJIdx ib k))) w
  · intro k
    exact hrefl (some (e (ggResQTwoJIdx ib k)))
  · intro i j
    have hCL : CL (e (ggResQTwoJIdx ib i)) (e (ggResQTwoJIdx ib j)) =
        CartanMatrix.A 2 i j := (hCe _ _).trans (hpair i j)
    rw [hL, hCL]
    rfl
  · exact hsel.comp (fun k => some (e (ggResQTwoJIdx ib k))) (by
      intro i j hij
      exact ggResQTwoJIdx_injective ib (e.injective (Option.some_injective _ hij)))
  · calc ggAutomizer J Bs
      = Subgroup.closure (Set.range (fun j : {i : Λ // i ≠ b} => φ (some j.1))) := hJ
      _ = Subgroup.closure (Set.range r) := congrArg Subgroup.closure hrange.symm

theorem GGResQTwoResidualCellTag.lineJDatum_A2
    {G : Type} [Group G] {Bs J : Subgroup G}
    {Λ : Type} [Fintype Λ] [DecidableEq Λ] {b : Λ}
    {V : Type} [AddCommGroup V] [Module (ZMod 3) V]
    {ι : Additive ↥Bs ≃+ V} {φ : Option Λ → MulAut ↥Bs}
    {h : Option Λ → V} {α : Option Λ → Module.Dual (ZMod 3) V}
    {CL : Matrix Λ Λ ℤ}
    {CK : Matrix (Option {i : Λ // i ≠ b}) (Option {i : Λ // i ≠ b}) ℤ}
    {u v : ZMod 3} {tag : GGResQTwoResidual}
    (htag1 : tag ≠ .B3b0c2) (htag2 : tag ≠ .C3b0c2)
    (hcell : GGResQTwoResidualCellTag tag b CL CK u v)
    (hφ : ∀ o w, ggLin (p := 3) ι (φ o) w = w - α o w • h o)
    (hrefl : ∀ o, GGIsReflection 3 (φ o))
    (hL : ∀ i j : Λ, α (some i) (h (some j)) = (CL i j : ZMod 3))
    (hsel : LinearIndependent (ZMod 3) h)
    (hJ : ggAutomizer J Bs = Subgroup.closure
      (Set.range fun j : {i : Λ // i ≠ b} => φ (some j))) :
    GGResLineJDatum 3 Bs J .A2 := by
  obtain ⟨n, C, ib, ic, e₁, e₂, e, hCe, heib, _hrow, _hcol, _hCKaa, hshape⟩ := hcell
  have hn : n = 3 := ggResQTwoResidualShape_n_eq_three tag n C ib ic e₁ e₂ u v hshape
  subst hn
  rw [ggResQTwoResidualShape_three] at hshape
  obtain ⟨hC, hib, -, -, -, -, -⟩ := hshape
  exact lineDatum_core hCe heib hφ hrefl hL hsel hJ
    (ggResQTwoResidual_A2_pairing tag htag1 htag2 hC hib)

theorem GGResLeviDatumCell.lineJDatum_A2
    {G : Type} [Group G] {Bs L J K : Subgroup G}
    {tag : GGResQTwoResidual}
    (htag1 : tag ≠ .B3b0c2) (htag2 : tag ≠ .C3b0c2)
