  rcases hshape with h | h | h | h | h | h
  · have hlab : o.lab = ⟨.twD, 5, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, hres, Or.inl rfl⟩))
  · have hlab : o.lab = ⟨.twA, 5, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, hres, Or.inr (Or.inl rfl)⟩))
  · have hlab : o.lab = ⟨.D, 4, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
