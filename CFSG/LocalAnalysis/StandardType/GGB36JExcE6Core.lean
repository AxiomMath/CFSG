private theorem ltqE6c_rig {labX : LargeEvenLabel} (htag : labX.tag = .E6 ∨ labX.tag = .twE6) :
    ∀ l : LargeEvenLabel, LargeEvenInLambda2 l → GGLabelIso labX l → l = labX := by
  intro l _ hiso
  obtain ⟨tx, rx, nx⟩ := labX
  obtain ⟨t, r, n⟩ := l
  rcases htag with h | h <;>
    (subst h
     unfold GGLabelIso at hiso
     rcases hiso with h | h | h | h | h | h | h | h <;> simp_all)

private theorem ltqE6c_three_dvd (n : ℕ) : 3 ∣ 2 ^ n - 1 ∨ 3 ∣ 2 ^ n + 1 := by
  induction n with
  | zero => left; norm_num
  | succ n ih =>
    rcases ih with h | h
    · right
      obtain ⟨k, hk⟩ := h
      have h1 : 1 ≤ 2 ^ n := Nat.one_le_two_pow
      refine ⟨2 * k + 1, ?_⟩
      rw [pow_succ]; omega
    · left
      obtain ⟨k, hk⟩ := h
      have h1 : 1 ≤ 2 ^ n := Nat.one_le_two_pow
      refine ⟨2 * k - 1, ?_⟩
      rw [pow_succ]; omega

private theorem ltqE6c_kacRE {lab : LargeEvenLabel} (hΛ : LargeEvenInLambda2 lab)
    (htag : lab.tag = .E6 ∨ lab.tag = .twE6) : GGKacRE lab 3 := by
  refine ⟨by norm_num, by norm_num, ltqE6c_three_dvd lab.n, ?_⟩
  rcases htag with h | h
  · exact Or.inr (Or.inl ⟨Or.inl h, Or.inl rfl⟩)
  · exact Or.inr (Or.inl ⟨Or.inr h, Or.inl rfl⟩)

theorem ltqE6c_label_eq {labX : LargeEvenLabel} (hΛ : LargeEvenInLambda2 labX)
    (htag : labX.tag = .E6 ∨ labX.tag = .twE6) : labX = ⟨labX.tag, 0, labX.n⟩ := by
  obtain ⟨t, r, n⟩ := labX
  simp only at htag
  rcases htag with h | h <;> subst h
  · have : r = 0 := hΛ.2
    subst this; rfl
  · have : r = 0 := hΛ.2
    subst this; rfl

theorem ltqE6c_typeOfLabel_eq {labX : LargeEvenLabel} (hΛ : LargeEvenInLambda2 labX)
    (htag : labX.tag = .E6 ∨ labX.tag = .twE6) :
    ggKacTypeOfLabel labX = some (.E6, labX.tag == .twE6) := by
  rcases htag with h | h
  · rw [ltqE6c_label_eq hΛ (Or.inl h), h]; rfl
  · rw [ltqE6c_label_eq hΛ (Or.inr h), h]; rfl

private theorem ltqE6c_GGB36JLabel_tag {labL labJ : LargeEvenLabel}
    (h : GGB36JLabel labL labJ) : labJ.tag ≠ .E6 ∧ labJ.tag ≠ .twE6 := by
