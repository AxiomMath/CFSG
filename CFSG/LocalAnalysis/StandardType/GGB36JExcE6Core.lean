  | false, 2 => [(.D, 5, 1), (.A, 5, 1), (.D, 4, 1), (.triD4, 0, 1), (.A, 2, 3), (.E6, 0, 1)]
  | false, 1 => [(.A, 5, 1), (.twD, 4, 1), (.E6, 0, 1)]
  | true, 2 => [(.twA, 5, 1), (.twD, 4, 1), (.twE6, 0, 1)]
  | true, 1 => [(.twD, 5, 1), (.twA, 5, 1), (.D, 4, 1), (.triD4, 0, 1), (.twA, 2, 3),
      (.twE6, 0, 1)]
  | _, _ => []

