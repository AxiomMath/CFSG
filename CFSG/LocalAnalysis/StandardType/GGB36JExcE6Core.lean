private theorem ltqE6c_classify_shape_false1 {n : ℕ} {o : GGKacOrbit} (hn : 1 ≤ n)
    (hshape : ggKacShapeLabel n o.lab ∈ ltqE6c_shapes false 1) (hdvd : n ∣ o.lab.n)
