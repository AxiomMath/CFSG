private theorem ltqE6c_len_one_of_shape {n n₀ : ℕ} {D D' : GGKacDatum}
    (hDeq : GGKacDatum.shape n D = GGKacDatum.shape n₀ D') (hDlen : D.orbits.length = 1) :
    D'.orbits.length = 1 := by
  have h1 : D.orbits.length = D'.orbits.length := by
    have := congrArg (fun x : Multiset (LargeEvenLieTag × ℕ × ℕ) × ℕ × ℕ =>
      (x.1 : Multiset (LargeEvenLieTag × ℕ × ℕ)).card) hDeq
    simpa [GGKacDatum.shape] using this
  omega

private theorem ltqE6c_len_one_of_pos {tw : Bool} {n : ℕ} (hn2 : 2 ≤ n) {D : GGKacDatum}
    {o : GGKacOrbit} (hDmem : D ∈ ggKacTable .E6 tw 3 n) (ho : o ∈ D.orbits)
    (hpos : ∀ i j : Fin D.orbits.length, D.orbits[i].qs = true → D.orbits[j].qs = true →
      i = j) : D.orbits.length = 1 := by
  have hqs_all : ∀ i : Fin D.orbits.length, D.orbits[i].qs = true :=
    fun i => ggKacTable_qs_of_two_le .E6 tw 3 hn2 D hDmem D.orbits[i] (List.get_mem D.orbits i)
  have hsub : Subsingleton (Fin D.orbits.length) :=
    ⟨fun i j => hpos i j (hqs_all i) (hqs_all j)⟩
  have h1 : 1 ≤ D.orbits.length := List.length_pos_of_mem ho
  have h2 : D.orbits.length ≤ 1 := by
    by_contra h
    have hlt : 1 < D.orbits.length := by omega
    have hne : (⟨0, by omega⟩ : Fin D.orbits.length) ≠ ⟨1, hlt⟩ := by simp
    exact hne (Subsingleton.elim _ _)
  omega

private theorem ltqE6c_huniq_of_pos {D : GGKacDatum} {o : GGKacOrbit} (ho : o ∈ D.orbits)
    (hqs : o.qs = true)
    (hpos : ∀ i j : Fin D.orbits.length, D.orbits[i].qs = true → D.orbits[j].qs = true →
      i = j) :
    ∀ o' ∈ D.orbits, o'.qs = true → o' = o := by
  intro o' ho' hqs'
  obtain ⟨i, hieq⟩ := List.mem_iff_get.mp ho'
  obtain ⟨j, hjeq⟩ := List.mem_iff_get.mp ho
  have hqsi : (D.orbits.get i).qs = true := hieq ▸ hqs'
  have hqsj : (D.orbits.get j).qs = true := hjeq ▸ hqs
  have hij : i = j := hpos i j hqsi hqsj
  rw [← hieq, ← hjeq, hij]

private theorem ltqE6c_classify_E6 {n : ℕ} (hn : 1 ≤ n) {D : GGKacDatum} {o : GGKacOrbit}
    (hDmem : D ∈ ggKacTable .E6 false 3 n) (ho : o ∈ D.orbits) (hqs : o.qs = true)
    (hpos : ∀ i j : Fin D.orbits.length, D.orbits[i].qs = true → D.orbits[j].qs = true →
      i = j) (hdvd : n ∣ o.lab.n) :
    GGB36JLabel ⟨.E6, 0, n⟩ o.lab ∨ o.lab = ⟨.E6, 0, n⟩ := by
  have huniq := ltqE6c_huniq_of_pos ho hqs hpos
  by_cases hn1 : n = 1
  · subst hn1
    exact ltqE6c_classify_one_false D hDmem o ho hqs huniq
  · have hn2 : 2 ≤ n := by omega
    rcases ltqE6c_three_dvd n with h3 | h3
    · have hshape := ggKacTable_shape .E6 false (p := 3) (n := n) (n' := 2)
        (by norm_num) hn (by norm_num) (Or.inl ⟨h3, by norm_num⟩)
      obtain ⟨D', hD'mem', o', ho', heqo, hDeq⟩ := ltqE6c_shape_transfer hshape hDmem ho
      have hlen' : D'.orbits.length = 1 :=
        ltqE6c_len_one_of_shape hDeq (ltqE6c_len_one_of_pos hn2 hDmem ho hpos)
      have hsh : ggKacShapeLabel n o.lab ∈ ltqE6c_shapes false 2 := by
        rw [heqo]; exact ltqE6c_shapes_false2 D' hD'mem' hlen' o' ho'
      exact ltqE6c_classify_shape_false2 hn hsh hdvd h3
    · have hshape := ggKacTable_shape .E6 false (p := 3) (n := n) (n' := 1)
        (by norm_num) hn (by norm_num) (Or.inr ⟨h3, by norm_num⟩)
      obtain ⟨D', hD'mem', o', ho', heqo, hDeq⟩ := ltqE6c_shape_transfer hshape hDmem ho
      have hlen' : D'.orbits.length = 1 :=
        ltqE6c_len_one_of_shape hDeq (ltqE6c_len_one_of_pos hn2 hDmem ho hpos)
      have hsh : ggKacShapeLabel n o.lab ∈ ltqE6c_shapes false 1 := by
        rw [heqo]; exact ltqE6c_shapes_false1 D' hD'mem' hlen' o' ho'
      exact ltqE6c_classify_shape_false1 hn hsh hdvd h3

private theorem ltqE6c_classify_twE6 {n : ℕ} (hn : 1 ≤ n) {D : GGKacDatum} {o : GGKacOrbit}
    (hDmem : D ∈ ggKacTable .E6 true 3 n) (ho : o ∈ D.orbits) (hqs : o.qs = true)
    (hpos : ∀ i j : Fin D.orbits.length, D.orbits[i].qs = true → D.orbits[j].qs = true →
      i = j) (hdvd : n ∣ o.lab.n) :
    GGB36JLabel ⟨.twE6, 0, n⟩ o.lab ∨ o.lab = ⟨.twE6, 0, n⟩ := by
  have huniq := ltqE6c_huniq_of_pos ho hqs hpos
  by_cases hn1 : n = 1
  · subst hn1
    exact ltqE6c_classify_one_true D hDmem o ho hqs huniq
  · have hn2 : 2 ≤ n := by omega
    rcases ltqE6c_three_dvd n with h3 | h3
    · have hshape := ggKacTable_shape .E6 true (p := 3) (n := n) (n' := 2)
        (by norm_num) hn (by norm_num) (Or.inl ⟨h3, by norm_num⟩)
      obtain ⟨D', hD'mem', o', ho', heqo, hDeq⟩ := ltqE6c_shape_transfer hshape hDmem ho
      have hlen' : D'.orbits.length = 1 :=
        ltqE6c_len_one_of_shape hDeq (ltqE6c_len_one_of_pos hn2 hDmem ho hpos)
      have hsh : ggKacShapeLabel n o.lab ∈ ltqE6c_shapes true 2 := by
        rw [heqo]; exact ltqE6c_shapes_true2 D' hD'mem' hlen' o' ho'
      exact ltqE6c_classify_shape_true2 hn hsh hdvd h3
    · have hshape := ggKacTable_shape .E6 true (p := 3) (n := n) (n' := 1)
        (by norm_num) hn (by norm_num) (Or.inr ⟨h3, by norm_num⟩)
      obtain ⟨D', hD'mem', o', ho', heqo, hDeq⟩ := ltqE6c_shape_transfer hshape hDmem ho
      have hlen' : D'.orbits.length = 1 :=
        ltqE6c_len_one_of_shape hDeq (ltqE6c_len_one_of_pos hn2 hDmem ho hpos)
      have hsh : ggKacShapeLabel n o.lab ∈ ltqE6c_shapes true 1 := by
        rw [heqo]; exact ltqE6c_shapes_true1 D' hD'mem' hlen' o' ho'
      exact ltqE6c_classify_shape_true1 hn hsh hdvd h3

theorem ltqE6c_classify {tw : Bool} {labX : LargeEvenLabel}
    (hΛX : LargeEvenInLambda2 labX) (htagX : labX.tag = .E6 ∨ labX.tag = .twE6)
    (htw : ggKacTypeOfLabel labX = some (.E6, tw))
    {D : GGKacDatum} {o : GGKacOrbit} (hDmem : D ∈ ggKacTable .E6 tw 3 labX.n)
    (ho : o ∈ D.orbits) (hqs : o.qs = true)
    (hpos : ∀ i j : Fin D.orbits.length, D.orbits[i].qs = true → D.orbits[j].qs = true →
      i = j) (hdvd : labX.n ∣ o.lab.n) :
    GGB36JLabel labX o.lab ∨ o.lab = labX := by
  rcases htagX with hE6 | hTw
  · have hlabXE6 : labX = ⟨.E6, 0, labX.n⟩ := by
      rw [ltqE6c_label_eq hΛX (Or.inl hE6), hE6]
    have htwE6 : tw = false := by
      have h' : ggKacTypeOfLabel labX = some (.E6, false) := by rw [hlabXE6]; rfl
      rw [h'] at htw
      simp only [Option.some.injEq, Prod.mk.injEq] at htw
      exact htw.2.symm
    subst htwE6
    have hthis := ltqE6c_classify_E6 hΛX.1 hDmem ho hqs hpos hdvd
    rw [← hlabXE6] at hthis
    exact hthis
  · have hlabXTw : labX = ⟨.twE6, 0, labX.n⟩ := by
