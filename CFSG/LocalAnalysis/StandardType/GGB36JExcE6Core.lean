private theorem ltqE6c_classify_one_false :
    ∀ D ∈ ggKacTable .E6 false 3 1, ∀ o ∈ D.orbits, o.qs = true →
      (∀ o' ∈ D.orbits, o'.qs = true → o' = o) →
      GGB36JLabel ⟨.E6, 0, 1⟩ o.lab ∨ o.lab = ⟨.E6, 0, 1⟩ := by
  intro D hD o ho hqs huniq
  have hmem := ltqE6c_memOne_false D hD o ho hqs huniq
  simp only [ltqE6c_labelsOne, List.mem_cons, List.mem_nil_iff, or_false] at hmem
  rcases hmem with h | h | h | h
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inl ⟨rfl, by norm_num, Or.inl rfl⟩)
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inl ⟨rfl, by norm_num, Or.inr (Or.inl rfl)⟩)
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inl ⟨rfl, by norm_num, Or.inr (Or.inr ⟨rfl, rfl⟩)⟩)
  · right; rw [h]

