      GGRegimeB36J p n labJ labX ∧ (labX.tag = .E6 ∨ labX.tag = .twE6) ∧
        ¬ ((labX.tag = .E6 ∧ 3 ∣ 2 ^ labX.n - 1 ∧
            (labJ = ⟨.triD4, 0, labX.n⟩ ∨ labJ = ⟨.A, 2, 3 * labX.n⟩)) ∨
