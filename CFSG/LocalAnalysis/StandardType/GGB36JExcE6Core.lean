  intro D hD o ho hqs huniq
  have hmem := ltqE6c_memOne_true D hD o ho hqs huniq
  simp only [ltqE6c_labelsOne, List.mem_cons, List.mem_nil_iff, or_false] at hmem
  rcases hmem with h | h | h | h | h | h | h
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, by norm_num,
      Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩))))⟩))
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, by norm_num,
      Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))⟩))
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, by norm_num, Or.inr (Or.inl rfl)⟩))
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, by norm_num, Or.inr (Or.inr (Or.inl rfl))⟩))
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, by norm_num, Or.inl rfl⟩))
  · right; rw [h]
  · left; rw [h]; unfold GGB36JLabel; dsimp only
    exact Or.inr (Or.inr (Or.inr ⟨rfl, by norm_num,
      Or.inr (Or.inr (Or.inr (Or.inl rfl)))⟩))

private theorem ltqE6c_shape_eq {n k : ℕ} {o : GGKacOrbit} {tag : LargeEvenLieTag} {rank : ℕ}
    (h : ggKacShapeLabel n o.lab = (tag, rank, k)) (htag : tag ≠ .C) :
    o.lab.tag = tag ∧ o.lab.rank = rank ∧ o.lab.n / n = k := by
  obtain ⟨⟨t, r, nn⟩, q⟩ := o
  simp only [ggKacShapeLabel] at h
  split at h
  · simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3⟩ := h
    exact absurd h1.symm htag
  · simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3⟩ := h
    exact ⟨h1, h2, h3⟩

private theorem ltqE6c_shape_lab {n : ℕ} {o : GGKacOrbit} {tag : LargeEvenLieTag} {rank k : ℕ}
    (h : ggKacShapeLabel n o.lab = (tag, rank, k)) (htag : tag ≠ .C) (hdvd : n ∣ o.lab.n) :
    o.lab = ⟨tag, rank, k * n⟩ := by
  obtain ⟨⟨t, r, nn⟩, q⟩ := o
  simp only [ggKacShapeLabel] at h
  split at h
  · simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3⟩ := h
    exact absurd h1.symm htag
  · simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3⟩ := h
    have hnmul : nn = k * n := by
      have hh := Nat.div_mul_cancel hdvd
      rw [h3] at hh
      exact hh.symm
    subst h1
    subst h2
    rw [hnmul]

private theorem ltqE6c_shape_transfer {tw : Bool} {n n₀ : ℕ}
    (hshape : (↑((ggKacTable .E6 tw 3 n).map (GGKacDatum.shape n)) :
        Multiset (Multiset (LargeEvenLieTag × ℕ × ℕ) × ℕ × ℕ)) =
      ↑((ggKacTable .E6 tw 3 n₀).map (GGKacDatum.shape n₀)))
    {D : GGKacDatum} (hD : D ∈ ggKacTable .E6 tw 3 n) {o : GGKacOrbit}
    (ho : o ∈ D.orbits) :
    ∃ D' ∈ ggKacTable .E6 tw 3 n₀, ∃ o' ∈ D'.orbits,
      ggKacShapeLabel n o.lab = ggKacShapeLabel n₀ o'.lab ∧
        GGKacDatum.shape n D = GGKacDatum.shape n₀ D' := by
  have hmem : GGKacDatum.shape n D ∈
      (↑((ggKacTable .E6 tw 3 n).map (GGKacDatum.shape n)) :
        Multiset (Multiset (LargeEvenLieTag × ℕ × ℕ) × ℕ × ℕ)) :=
    Multiset.mem_coe.mpr (List.mem_map.mpr ⟨D, hD, rfl⟩)
  rw [hshape] at hmem
  obtain ⟨D', hD'mem, hD'eq⟩ := List.mem_map.mp (Multiset.mem_coe.mp hmem)
  have hshapeOrb : ggKacShapeLabel n o.lab ∈
      (↑(D.orbits.map (fun o => ggKacShapeLabel n o.lab)) :
        Multiset (LargeEvenLieTag × ℕ × ℕ)) :=
    Multiset.mem_coe.mpr (List.mem_map.mpr ⟨o, ho, rfl⟩)
  have hfst : (↑(D.orbits.map (fun o => ggKacShapeLabel n o.lab)) :
        Multiset (LargeEvenLieTag × ℕ × ℕ)) =
      ↑(D'.orbits.map (fun o => ggKacShapeLabel n₀ o.lab)) := by
    have := congrArg Prod.fst hD'eq
    simpa [GGKacDatum.shape] using this.symm
  rw [hfst] at hshapeOrb
  obtain ⟨o', ho', heqo⟩ := List.mem_map.mp (Multiset.mem_coe.mp hshapeOrb)
  exact ⟨D', hD'mem, o', ho', heqo.symm, hD'eq.symm⟩

private theorem ltqE6c_classify_shape_false2 {n : ℕ} {o : GGKacOrbit} (hn : 1 ≤ n)
    (hshape : ggKacShapeLabel n o.lab ∈ ltqE6c_shapes false 2) (hdvd : n ∣ o.lab.n)
    (hres : 3 ∣ 2 ^ n - 1) :
    GGB36JLabel ⟨.E6, 0, n⟩ o.lab ∨ o.lab = ⟨.E6, 0, n⟩ := by
  simp only [ltqE6c_shapes, List.mem_cons, List.mem_nil_iff, or_false] at hshape
  rcases hshape with h | h | h | h | h | h
  · have hlab : o.lab = ⟨.D, 5, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inl ⟨rfl, hres, Or.inl rfl⟩
  · have hlab : o.lab = ⟨.A, 5, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inl ⟨rfl, hres, Or.inr (Or.inl rfl)⟩
  · have hlab : o.lab = ⟨.D, 4, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inl ⟨rfl, hres, Or.inr (Or.inr (Or.inl rfl))⟩
  · have hlab : o.lab = ⟨.triD4, 0, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inl ⟨rfl, hres, Or.inr (Or.inr (Or.inr (Or.inl rfl)))⟩
  · have hlab : o.lab = ⟨.A, 2, 3 * n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    left; rw [hlab]; unfold GGB36JLabel; dsimp only
    exact Or.inl ⟨rfl, hres, Or.inr (Or.inr (Or.inr (Or.inr rfl)))⟩
  · have hlab : o.lab = ⟨.E6, 0, n⟩ := by simpa using ltqE6c_shape_lab h (by decide) hdvd
    right; rw [hlab]

