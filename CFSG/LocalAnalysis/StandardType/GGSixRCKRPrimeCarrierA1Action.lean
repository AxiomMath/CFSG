private theorem rckA1_conj_transport {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    (σ : L ≃+* L) {z : ModGL τ L}
    (hnorm : ∀ j : KernelComponent (rootCharHom a), ∀ g : ModGL τ L,
      g ∈ rootSpan τ L (componentRoots (rootCharHom a) j) ↔
        z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) j))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    {u : ModGL τ L} (hu : u ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (huZ : iterHom S.D.step s u * u⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z) :
    ∃ g₀ ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      u = z * g₀ * z⁻¹ ∧ frobGL σ g₀ * g₀⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z := by
  classical
  set P := outerOrbitFamily S hT i hs hmin with hP
  have hzA : ∀ a ∈ P.A, z * a * z⁻¹ ∈ P.A := by
    have h : P.A ≤ P.A.comap (MulAut.conj z).toMonoidHom := by
      refine iSup_le fun k => ?_
      obtain ⟨j, hj⟩ := outer_iterate_image_component S hT i k.val
      intro w hw
      have hw' : w ∈ rootSpan τ L (componentRoots (rootCharHom a) j) := by
        rw [hj]
        exact hw
      have h2 := (hnorm j w).1 hw'
      rw [hj] at h2
      exact P.S_le_A k h2
    exact fun w hw => h hw
  have hZconj : ∀ X : ModGL τ L, z * X * z⁻¹ ∈ P.Z → X ∈ P.Z := by
    intro X hX
    rw [CycFamily.mem_Z] at hX ⊢
    intro w hw
    have h := hX (z * w * z⁻¹) (hzA w hw)
    have e : z * w * z⁻¹ * (z * X * z⁻¹) = z * (w * X) * z⁻¹ := by group
    have e' : z * X * z⁻¹ * (z * w * z⁻¹) = z * (X * w) * z⁻¹ := by group
    rw [e, e'] at h
    simpa using h
  have hg0 : z⁻¹ * u * z ∈ rootSpan τ L (componentRoots (rootCharHom a) i) :=
    (hnorm i (z⁻¹ * u * z)).2 (by
      rw [show z * (z⁻¹ * u * z) * z⁻¹ = u by group]
      exact hu)
  refine ⟨z⁻¹ * u * z, hg0, by group, hZconj _ ?_⟩
  have h1 := hz _ hg0
  rw [show z * (z⁻¹ * u * z) * z⁻¹ = u by group] at h1
  have e2 : z * (frobGL σ (z⁻¹ * u * z) * (z⁻¹ * u * z)⁻¹) * z⁻¹ =
      (z * frobGL σ (z⁻¹ * u * z) * z⁻¹) * u⁻¹ := by group
  rw [e2, ← h1]
  exact huZ

private theorem rckA1_commutator_mem_conj_CQ {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    (σ : L ≃+* L) {z : ModGL τ L}
    (hnorm : ∀ j : KernelComponent (rootCharHom a), ∀ g : ModGL τ L,
      g ∈ rootSpan τ L (componentRoots (rootCharHom a) j) ↔
        z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) j))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    {u u' : ModGL τ L}
    (hu : u ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (hu' : u' ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (huZ : iterHom S.D.step s u * u⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z)
    (huZ' : iterHom S.D.step s u' * u'⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z) :
    ∃ c ∈ CQ σ i, ⁅u, u'⁆ = z * c * z⁻¹ := by
  obtain ⟨g₀, hg₀, rfl, hg₀Z⟩ := rckA1_conj_transport S hT i hs hmin σ hnorm hz hu huZ
  obtain ⟨g₁, hg₁, rfl, hg₁Z⟩ := rckA1_conj_transport S hT i hs hmin σ hnorm hz hu' huZ'
  have hsL : ∃ v : Lˣ, v ^ 2 ≠ 1 := by
    obtain ⟨v, hv⟩ :=
      CFSG.HardMathSupport.Timmesfeld.LangTorus.exists_units_zpow_ne_one
        (L := L) (m := 2) (by norm_num)
    exact ⟨v, by simpa using hv⟩
  have hmem : ⁅g₀, g₁⁆ ∈ CQ σ i :=
    orbit_commutator_mem_CQT S hT i hs hmin σ hsL hg₀ hg₁ hg₀Z hg₁Z
  refine ⟨⁅g₀, g₁⁆, hmem, ?_⟩
  simp only [commutatorElement_def]
  group

private theorem rckA1_norm_hom_of_hom {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    {C : Type*} [Group C] (θ : C →* ModGL τ L)
    (hθS : ∀ c, θ c ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (hθfix : ∀ c, iterHom S.D.step s (θ c) = θ c)
    (hθY : ∀ g g' : ModGL τ L, g ∈ rootSpan τ L (componentRoots (rootCharHom a) i) →
      g' ∈ rootSpan τ L (componentRoots (rootCharHom a) i) →
      iterHom S.D.step s g * g⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z →
      iterHom S.D.step s g' * g'⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z → ⁅g, g'⁆ ∈ θ.range)
    {y : ModGL τ L} (hyF : S.D.step y = y)
    {α : MulAut C} (hθα : ∀ c, θ (α c) = y * θ c * y⁻¹) :
    ∃ f : C →* ModGL τ L,
      rationalComponent S.ρ S.Γ (rootCharHom a) i ≤ f.range ∧
      (Group.IsPerfect C → f.range ≤ rationalComponent S.ρ S.Γ (rootCharHom a) i) ∧
      (∀ c, f (α c) = y * f c * y⁻¹) := by
  classical
  set P := outerOrbitFamily S hT i hs hmin with hP
  set Ψ := componentRoots (rootCharHom a) i with hΨ
  have hP0 : P.S 0 = rootSpan τ L Ψ := by
    rw [hP, outerOrbitFamily_S, ZMod.val_zero]
    simp only [Function.iterate_zero, id_eq, Set.image_id']
    rfl
  let θ₀ : C →* P.S 0 := θ.codRestrict (P.S 0) fun c => by
    rw [hP0]
    exact hθS c
  have hθ₀ : ∀ c, ((θ₀ c : P.S 0) : ModGL τ L) = θ c := fun c => rfl
  let f : C →* ModGL τ L := P.norm.comp θ₀
  have hfix : ∀ c, iterHom S.D.step s ((θ₀ c : P.S 0) : ModGL τ L) = θ₀ c := fun c => by
    rw [hθ₀]
    exact hθfix c
  have hYW : ⁅P.Y, P.Y⁆ ≤ θ.range := by
    rw [Subgroup.commutator_le]
    intro u hu u' hu'
    obtain ⟨hu0, huZ⟩ := P.mem_Y.1 hu
    obtain ⟨hu0', huZ'⟩ := P.mem_Y.1 hu'
    rw [hP0] at hu0 hu0'
    exact hθY u u' hu0 hu0' huZ huZ'
  have hΓM : S.Γ ≤ S.D.model := Subgroup.commutator_le_self _
  have hrsA : rationalSpan S.ρ S.Γ (rootCharHom a) i ≤ P.Afix := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.1 hx
    refine ⟨?_, (hΓM hx2).2⟩
    rw [hP, outerOrbitFamily_A]
    exact hx1
  have hle : rationalComponent S.ρ S.Γ (rootCharHom a) i ≤ f.range := by
    intro g hg
    have h1 := P.commutator_Afix_le (Subgroup.commutator_mono hrsA hrsA hg)
    obtain ⟨y', hyY, rfl⟩ := P.mem_normImage.1 h1
    obtain ⟨c, hc⟩ := hYW hyY
    refine ⟨c, ?_⟩
    change P.norm (θ₀ c) = P.norm y'
    congr 1
    exact Subtype.ext hc
  have hperf_le : Group.IsPerfect C →
      f.range ≤ rationalComponent S.ρ S.Γ (rootCharHom a) i := by
    intro hperf
    rintro _ ⟨x, rfl⟩
    exact outer_norm_mem_rationalComponent S hT i hs hmin hperf θ₀ hfix x
  have hfα : ∀ c, f (α c) = y * f c * y⁻¹ := by
    intro c
    change P.norm (θ₀ (α c)) = y * P.norm (θ₀ c) * y⁻¹
    refine CFSG.LocalAnalysis.GLTheoremA.T171Sh.cycFamily_norm_conj P hyF ?_
    rw [hθ₀ (α c), hθ₀ c, hθα c]
  exact ⟨f, hle, hperf_le, hfα⟩

theorem rationalComponent_conj_inner_of_untwist {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    (σ : L ≃+* L) {z : ModGL τ L}
    (hnorm : ∀ j : KernelComponent (rootCharHom a), ∀ g : ModGL τ L,
      g ∈ rootSpan τ L (componentRoots (rootCharHom a) j) ↔
        z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) j))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    (hperf : Group.IsPerfect ↥(CQ σ i)) {y g : ModGL τ L} (hyF : S.D.step y = y)
    (hg : g ∈ CQ σ i)
    (hgy : ∀ x ∈ CQ σ i, z * (g * x * g⁻¹) * z⁻¹ = y * (z * x * z⁻¹) * y⁻¹) :
    ∃ r ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i,
      ∀ x ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i, y * x * y⁻¹ = r * x * r⁻¹ := by
  classical
  have hgC : MulAut.conj g ∈ CFSG.GroupActions.subgroupStabAut (CQ σ i) := by
    change (CQ σ i).map (MulAut.conj g).toMonoidHom = CQ σ i
    apply le_antisymm
    · rintro _ ⟨c, hc, rfl⟩
      change g * (c : ModGL τ L) * g⁻¹ ∈ CQ σ i
      exact mul_mem (mul_mem hg hc) (inv_mem hg)
    · intro c hc
      refine ⟨g⁻¹ * c * g, mul_mem (mul_mem (inv_mem hg) hc) hg, ?_⟩
      change g * (g⁻¹ * c * g) * g⁻¹ = c
      group
  let α : MulAut ↥(CQ σ i) :=
    CFSG.GroupActions.subgroupStabRestrict (CQ σ i) ⟨MulAut.conj g, hgC⟩
  have hαeq : α = MulAut.conj ⟨g, hg⟩ := by
    ext c
    rfl
  let θ : ↥(CQ σ i) →* ModGL τ L := (MulAut.conj z).toMonoidHom.comp (CQ σ i).subtype
  have hθ : ∀ c : ↥(CQ σ i), θ c = z * (c : ModGL τ L) * z⁻¹ := fun _ => rfl
  have hθS : ∀ c : ↥(CQ σ i), θ c ∈ rootSpan τ L (componentRoots (rootCharHom a) i) := by
    intro c
    rw [hθ]
    exact (hnorm i _).1 (CQ_le_rootSpan σ i c.2)
  have hθfix : ∀ c : ↥(CQ σ i), iterHom S.D.step s (θ c) = θ c := by
    intro c
    rw [hθ, hz _ (CQ_le_rootSpan σ i c.2), frobGL_eq_self_of_mem_CQ σ i c.2]
  have hθY : ∀ u u' : ModGL τ L,
      u ∈ rootSpan τ L (componentRoots (rootCharHom a) i) →
      u' ∈ rootSpan τ L (componentRoots (rootCharHom a) i) →
      iterHom S.D.step s u * u⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z →
      iterHom S.D.step s u' * u'⁻¹ ∈ (outerOrbitFamily S hT i hs hmin).Z →
      ⁅u, u'⁆ ∈ θ.range := by
    intro u u' hu hu' huZ huZ'
    obtain ⟨c, hc, hceq⟩ :=
      rckA1_commutator_mem_conj_CQ S hT i hs hmin σ hnorm hz hu hu' huZ huZ'
    exact ⟨⟨c, hc⟩, by rw [hθ, hceq]⟩
  have hθα : ∀ c : ↥(CQ σ i), θ (α c) = y * θ c * y⁻¹ := by
    intro c
    have hc : ((α c : ↥(CQ σ i)) : ModGL τ L) = g * (c : ModGL τ L) * g⁻¹ := by
      rw [hαeq]
      rfl
    rw [hθ, hθ, hc]
    exact hgy c c.2
  obtain ⟨f, hle, hperf_le, hfα⟩ :=
    rckA1_norm_hom_of_hom S hT i hs hmin θ hθS hθfix hθY hyF hθα
  refine ⟨f ⟨g, hg⟩, hperf_le hperf ⟨⟨g, hg⟩, rfl⟩, fun x hx => ?_⟩
  obtain ⟨c, rfl⟩ := hle hx
  rw [← hfα c]
  have hαg : (α c : ↥(CQ σ i)) = ⟨g, hg⟩ * c * ⟨g, hg⟩⁻¹ := by
    rw [hαeq]
    rfl
  rw [hαg, map_mul, map_mul, map_inv]

private theorem rckA1_frob_conj_commute {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (i : KernelComponent (rootCharHom a)) {s : ℕ} (σ : L ≃+* L)
    {z y g : ModGL τ L}
    (hnorm : ∀ g : ModGL τ L, g ∈ rootSpan τ L (componentRoots (rootCharHom a) i) ↔
      z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    (hyF : S.D.step y = y) (hgS : g ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (hgconj : ∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      (z⁻¹ * y * z) * x * (z⁻¹ * y * z)⁻¹ = g * x * g⁻¹)
    {x : ModGL τ L} (hx : x ∈ rootSpan τ L (componentRoots (rootCharHom a) i)) :
    g * frobGL σ x * g⁻¹ = frobGL σ (g * x * g⁻¹) := by
  set H : ModGL τ L := iterHom S.D.step s (z * x * z⁻¹) with hHdef
  have hzx : z * x * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) i) :=
    (hnorm x).1 hx
  have hH : H ∈ rootSpan τ L (componentRoots (rootCharHom a) i) := by
    rw [hHdef, hz x hx]
    exact (hnorm _).1 (frobGL_mem_rootSpan σ hx)
  have hHconj : z⁻¹ * H * z ∈ rootSpan τ L (componentRoots (rootCharHom a) i) :=
    (hnorm (z⁻¹ * H * z)).2 (by
      rw [show z * (z⁻¹ * H * z) * z⁻¹ = H by group]
      exact hH)
  have hfx : frobGL σ x = z⁻¹ * H * z := by
    rw [hHdef, hz x hx]
    group
  have hx' : g * x * g⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) i) :=
    mul_mem (mul_mem hgS hx) (inv_mem hgS)
  have hfu : frobGL σ (g * x * g⁻¹) =
      z⁻¹ * iterHom S.D.step s (z * (g * x * g⁻¹) * z⁻¹) * z := by
    rw [hz _ hx']
    group
  have hzconj : z * (g * x * g⁻¹) * z⁻¹ = y * (z * x * z⁻¹) * y⁻¹ := by
    rw [← hgconj x hx]
    group
  have hstep : iterHom S.D.step s (y * (z * x * z⁻¹) * y⁻¹) =
      y * iterHom S.D.step s (z * x * z⁻¹) * y⁻¹ := by
    rw [map_mul, map_mul, map_inv,
      CFSG.LocalAnalysis.GLTheoremA.T171Sh.iterHom_eq_self_of_fixed hyF s]
  calc g * frobGL σ x * g⁻¹
      = g * (z⁻¹ * H * z) * g⁻¹ := by rw [hfx]
    _ = (z⁻¹ * y * z) * (z⁻¹ * H * z) * (z⁻¹ * y * z)⁻¹ := (hgconj _ hHconj).symm
    _ = z⁻¹ * y * H * y⁻¹ * z := by group
    _ = z⁻¹ * iterHom S.D.step s (y * (z * x * z⁻¹) * y⁻¹) * z := by
      rw [hstep, hHdef]
      group
    _ = z⁻¹ * iterHom S.D.step s (z * (g * x * g⁻¹) * z⁻¹) * z := by rw [← hzconj]
    _ = frobGL σ (g * x * g⁻¹) := by rw [hfu]

omit [IsAlgClosed L] in
private theorem rckA1_twist_centralizes {a : Fin τ.rank → Lˣ}
    (i : KernelComponent (rootCharHom a)) {σ : L ≃+* L} {g : ModGL τ L}
    (hgS : g ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (hcomm : ∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      g * frobGL σ x * g⁻¹ = frobGL σ (g * x * g⁻¹)) :
    ∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      (frobGL σ g * g⁻¹) * x = x * (frobGL σ g * g⁻¹) := by
  have hcancel : ∀ u : ModGL τ L, frobGL σ (frobGL σ.symm u) = u := by
    intro u
    have h := units_map_entrywiseHom_mul_ringEquiv σ σ.symm u
    have hinv : σ * σ.symm = 1 := mul_inv_cancel σ
    rw [hinv, units_map_entrywiseHom_one_ringEquiv] at h
    exact h.symm
  intro x hx
  have hdcent : ∀ u ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      (g * (frobGL σ g)⁻¹) * frobGL σ u * (g * (frobGL σ g)⁻¹)⁻¹ = frobGL σ u := by
    intro u hu
    have hy : g⁻¹ * u * g ∈ rootSpan τ L (componentRoots (rootCharHom a) i) :=
      mul_mem (mul_mem (inv_mem hgS) hu) hgS
    have h1 := hcomm (g⁻¹ * u * g) hy
    have e1 : g * frobGL σ (g⁻¹ * u * g) * g⁻¹ =
        (g * (frobGL σ g)⁻¹) * frobGL σ u * (g * (frobGL σ g)⁻¹)⁻¹ := by
      rw [map_mul, map_mul, map_inv]
      group
    have e2 : g * (g⁻¹ * u * g) * g⁻¹ = u := by group
    rw [e1, e2] at h1
    exact h1
  have hdcomm : ∀ u ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      (g * (frobGL σ g)⁻¹) * u = u * (g * (frobGL σ g)⁻¹) := by
    intro u hu
    have hu' := frobGL_mem_rootSpan σ.symm hu
    have h := hdcent (frobGL σ.symm u) hu'
    rw [hcancel u] at h
    exact mul_inv_eq_iff_eq_mul.mp h
  have h := hdcomm x hx
  have hinv : frobGL σ g * g⁻¹ = (g * (frobGL σ g)⁻¹)⁻¹ := by group
  rw [hinv]
  calc (g * (frobGL σ g)⁻¹)⁻¹ * x
      = (g * (frobGL σ g)⁻¹)⁻¹ * (x * (g * (frobGL σ g)⁻¹)) *
          (g * (frobGL σ g)⁻¹)⁻¹ := by group
    _ = (g * (frobGL σ g)⁻¹)⁻¹ * ((g * (frobGL σ g)⁻¹) * x) *
          (g * (frobGL σ g)⁻¹)⁻¹ := by rw [h]
    _ = x * (g * (frobGL σ g)⁻¹)⁻¹ := by group

theorem rck_exists_mem_CQ_conj_of_commute {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (i : KernelComponent (rootCharHom a)) {s : ℕ} (σ : L ≃+* L)
    (hC : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      (∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
        x * (frobGL σ g * g⁻¹) = (frobGL σ g * g⁻¹) * x) → g ∈ CQ σ i)
    {z : ModGL τ L} (hzZ : z ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)))
    (hnorm : ∀ g : ModGL τ L, g ∈ rootSpan τ L (componentRoots (rootCharHom a) i) ↔
      z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) i))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    {y : ModGL τ L} (hyZ : y ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)))
    (hyF : S.D.step y = y) :
    ∃ g ∈ CQ σ i, ∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      z * (g * x * g⁻¹) * z⁻¹ = y * (z * x * z⁻¹) * y⁻¹ := by
  classical
  set y₁ : ModGL τ L := z⁻¹ * y * z with hy₁def
  have hy₁Z : y₁ ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)) :=
    mul_mem (mul_mem (inv_mem hzZ) hyZ) hzZ
  obtain ⟨g, hgU, hgconj⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.T171Sh.exists_mem_rootSpan_conj_eq_of_mem_Z
      (a := a) i hy₁Z
  have hgS : g ∈ rootSpan τ L (componentRoots (rootCharHom a) i) := by
    have h := hgU
    change g ∈ rootSpan τ L (unionRoots (rootCharHom a)
      ({i} : Set (KernelComponent (rootCharHom a)))) at h
    rwa [unionRoots_singleton] at h
  have hcomm : ∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      g * frobGL σ x * g⁻¹ = frobGL σ (g * x * g⁻¹) :=
    fun x hx => rckA1_frob_conj_commute S i σ hnorm hz hyF hgS
      (fun x hx => by simpa only [hy₁def] using hgconj x hx) (x := x) hx
  refine ⟨g, hC g hgS (fun x hx =>
    (rckA1_twist_centralizes i hgS hcomm x hx).symm), fun x hx => ?_⟩
  rw [← hgconj x hx, hy₁def]
  group

theorem rck_torus_conj_inner_of_commute {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    (σ : L ≃+* L)
    (hC : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      (∀ x ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
        x * (frobGL σ g * g⁻¹) = (frobGL σ g * g⁻¹) * x) → g ∈ CQ σ i)
    {z : ModGL τ L} (hzZ : z ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)))
    (hnorm : ∀ j : KernelComponent (rootCharHom a), ∀ g : ModGL τ L,
      g ∈ rootSpan τ L (componentRoots (rootCharHom a) j) ↔
        z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) j))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    (hperf : Group.IsPerfect ↥(CQ σ i)) {b : ModGL τ L} (hb : b ∈ S.D.torus) :
    ∃ r ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i,
      ∀ x ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i, b * x * b⁻¹ = r * x * r⁻¹ := by
  obtain ⟨hbH, hbF⟩ := CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hb
  obtain ⟨g, hg, hgy⟩ := rck_exists_mem_CQ_conj_of_commute S i σ hC hzZ (hnorm i) hz
    (Subgroup.mem_sup_left hbH) hbF
  exact rationalComponent_conj_inner_of_untwist S hT i hs hmin σ hnorm hz hperf hbF hg
    fun x hx => hgy x (CQ_le_rootSpan σ i hx)

theorem rckA1_torus_conj_inner [CharP L 2] {p : ℕ} (S : LangSetup τ L p)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {β : Fin τ.rank → ℤ}
    (hΨ : componentRoots (rootCharHom a) i = {β, -β}) {s : ℕ} [NeZero s]
    (hs : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i =
      componentRoots (rootCharHom a) i)
    (hmin : ∀ k, 0 < k → k < s →
      (S.ρ : (Fin τ.rank → ℤ) → _)^[k] '' componentRoots (rootCharHom a) i ≠
        componentRoots (rootCharHom a) i)
    (σ : L ≃+* L) {z : ModGL τ L}
    (hzZ : z ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)))
    (hnorm : ∀ j : KernelComponent (rootCharHom a), ∀ g : ModGL τ L,
      g ∈ rootSpan τ L (componentRoots (rootCharHom a) j) ↔
        z * g * z⁻¹ ∈ rootSpan τ L (componentRoots (rootCharHom a) j))
    (hz : ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
      iterHom S.D.step s (z * g * z⁻¹) = z * frobGL σ g * z⁻¹)
    (hperf : Group.IsPerfect ↥(CQ σ i)) {b : ModGL τ L} (hb : b ∈ S.D.torus) :
    ∃ r ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i,
      ∀ x ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i, b * x * b⁻¹ = r * x * r⁻¹ :=
  rck_torus_conj_inner_of_commute S hT i hs hmin σ
    (fun _ hg hc => rckA1_mem_CQ_of_commute i hΨ σ hg hc) hzZ hnorm hz hperf hb

