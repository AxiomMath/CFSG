theorem f4_langDatum_through {K : Type} [Field K] [Finite K] [CharP K 2] {f : ℕ} (hf : 1 ≤ f)
    (hK : Nat.card K = 2 ^ f) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (b : ↥(adjointGroup Tag.F4 K)) (hb : b ^ p = 1) :
    ∃ D : LangDatum Tag.F4 (AlgebraicClosure K),
      D.Φ = Units.map (entrywiseHom (iterateFrobenius (AlgebraicClosure K) 2 f)) ∧
      D.q = 2 ^ f ∧
      baseChangeGL (algebraMap K (AlgebraicClosure K)) (b : ModGL Tag.F4 K) ∈
        D.torus.map (MulAut.conj D.g0).toMonoidHom := by
  classical
  let L := AlgebraicClosure K
  have : IsAlgClosed L := inferInstance
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP L 2 := inferInstance
  let ι : K →+* L := algebraMap K L
  let u : ModGL Tag.F4 L := bcGL (τ := Tag.F4) ι (b : ModGL Tag.F4 K)
  have hhL : u ∈ adjointGroup Tag.F4 L := by
    exact bcGL_mem_adjointGroup (τ := Tag.F4) ι b.2
  have hFrq : ∀ c : L, iterateFrobenius L 2 f c = c ^ (2 ^ f) := by
    intro c
    rw [iterateFrobenius_def]
  have hFr : ∀ c : L, iterateFrobenius L 2 f c = c ^ Nat.card K := by
    intro c
    rw [iterateFrobenius_def, ← hK]
  have hup : u ^ p = 1 := by
    change bcGL (τ := Tag.F4) ι (b : ModGL Tag.F4 K) ^ p = 1
    rw [← map_pow, ← Subgroup.coe_pow, hb]
    exact map_one _
  have hfixu : entrywiseFrobGL Tag.F4 L 2 f u = u := by
    have h := units_map_entrywiseHom_bcGL_algebraMap (K := K) (L := L)
      (Fr := iterateFrobenius L 2 f) hFr (b : ModGL Tag.F4 K)
    simpa only [entrywiseFrobGL, u, ι] using h
  let A : Subgroup (ModGL Tag.F4 L) := Subgroup.zpowers u
  have hA : A ≤ adjointGroup Tag.F4 L := by
    simpa [A] using (Subgroup.zpowers_le.2 hhL)
  have hfin : Finite A := by
    have horder : IsOfFinOrder u :=
      isOfFinOrder_iff_pow_eq_one.mpr ⟨p, hp.pos, hup⟩
    change Finite (Subgroup.zpowers u)
    exact horder.finite_zpowers
  have hel : CFSG.Open.IsElemAbelian p A := by
    change CFSG.Open.IsElemAbelian p (Subgroup.zpowers u)
    exact CFSG.Open.isElemAbelian_zpowers (p := p) hup
  have hcardA : Nat.card A ≤ p ^ 2 := by
    have hdvd : orderOf u ∣ p := orderOf_dvd_of_pow_eq_one hup
    have hle : orderOf u ≤ p := Nat.le_of_dvd hp.pos hdvd
    have hcard_eq : Nat.card A = orderOf u := by
      change Nat.card (Subgroup.zpowers u) = orderOf u
      exact Nat.card_zpowers u
    rw [hcard_eq]
    calc
      orderOf u ≤ p := hle
      _ ≤ p ^ 2 := by
        calc
          p = p * 1 := (Nat.mul_one p).symm
          _ ≤ p * p := Nat.mul_le_mul_left p hp.one_lt.le
          _ = p ^ 2 := (pow_two p).symm
  have halg : letI := ZMod.algebra L 2; Algebra.IsAlgebraic (ZMod 2) L := by
    have h := isAlgebraic_zmod_algebraicClosure_of_finite K 2
    simpa [L] using h
  have htor : IsToralSubgroup Tag.F4 L A :=
    isToralSubgroup_F4_of_card_le_sq (L := L) halg hp hp2 hA hfin hel hcardA
  rcases htor with ⟨g, hg, hgA⟩
  have huH : u ∈ (entrywiseFrobGL Tag.F4 L 2 f).eqLocus (MonoidHom.id _) := by
    change entrywiseFrobGL Tag.F4 L 2 f u = u
    exact hfixu
  have hFix : ∀ x ∈ A, entrywiseFrobGL Tag.F4 L 2 f x = x := by
    intro x hx
    have hxH : x ∈ (entrywiseFrobGL Tag.F4 L 2 f).eqLocus (MonoidHom.id _) := by
      exact (Subgroup.zpowers_le.2 huH) (by simpa [A] using hx)
    change entrywiseFrobGL Tag.F4 L 2 f x = x at hxH
    exact hxH
  have hexp : ∀ x ∈ A, x ^ p = 1 := hel.2
  have hpq : Nat.Coprime p (2 ^ f) :=
    Nat.Coprime.pow_right _ ((Nat.coprime_primes hp Nat.prime_two).2 hp2)
  obtain ⟨w, g0, hg0C, hg0Lang, hAinTwisted⟩ :=
    f4_exists_lang_torus_of_conj_torus (Ω := L) (A := A) (p := p)
      f hf hpq hexp hFix hg hgA
  let D : LangDatum Tag.F4 L :=
    LangDatum.ofFrobenius (iterateFrobenius L 2 f) (2 ^ f) hFrq w hg0C
      (by simpa only [entrywiseFrobGL] using hg0Lang)
  refine ⟨D, ?_, ?_, ?_⟩
  · rfl
  · rfl
  · have huA : u ∈ A := by
      change u ∈ Subgroup.zpowers u
      exact Subgroup.mem_zpowers u
    have huTwisted := hAinTwisted u huA
    rw [f4_baseChangeGL_eq_bcGL]
    simpa only [D, LangDatum.torus, LangDatum.ofFrobenius, u, ι, entrywiseFrobGL] using huTwisted


end NativeF4LangThrough

theorem exc_langDatum_through_fixed {τ : Tag}
    (hτ : τ = .G2 ∨ τ = .F4 ∨ τ = .D4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) {K : Type} [Field K]
    [Finite K] [CharP K 2] {f : ℕ} (hf : 1 ≤ f) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (u : ModGL τ (AlgebraicClosure K)) (hu : u ∈ adjointGroup τ (AlgebraicClosure K))
    (hup : u ^ p = 1) (hfix : entrywiseFrobGL τ (AlgebraicClosure K) 2 f u = u) :
    ∃ D : LangDatum τ (AlgebraicClosure K),
      D.Φ = Units.map (entrywiseHom (iterateFrobenius (AlgebraicClosure K) 2 f)) ∧
      D.q = 2 ^ f ∧ u ∈ D.torus.map (MulAut.conj D.g0).toMonoidHom := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective _
  have hmon : MonomialToralAt τ p :=
    monomialToralAt_exc monomialToralAt_E6_five monomialToralAt_E7_five hτ hp hp2
  have hconj := exists_conj_torusGroup_of_pow_eq_one hp hmon (Ne.symm hp2)
    (isAlgebraic_zmod_algebraicClosure_of_finite K 2) hu hup
  have hpq : Nat.Coprime p (2 ^ f) :=
    Nat.Coprime.pow_right _ ((Nat.coprime_primes hp Nat.prime_two).2 hp2)
  exact exists_langDatum_of_toral_untw f hf hpq hup hfix hconj


