theorem four_dvd_aut_innerFullThreeTorus_of_weyl_mem
    {L : Type} [Field L] [IsAlgClosed L] {p : ℕ} (S : LangSetup Tag.E6 L p)
    (hq : S.D.q = 2) (hAlg : S.IsAlgebraic)
    (hρ : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = -γ)
    {a : Fin Tag.E6.rank → Lˣ} (i : KernelComponent (rootCharHom a))
    {α β : Fin Tag.E6.rank → ℤ} (hα : IsRoot Tag.E6 α) (hβ : IsRoot Tag.E6 β)
    (horth : iform α β = 0)
    (hαJ : rootSL2 Tag.E6 L α WSL ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i)
    (hβJ : rootSL2 Tag.E6 L β WSL ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i)
    {ζ : Lˣ} (hζ3 : ζ ^ 3 = 1) (hζ1 : ζ ≠ 1)
    (hdΓ : rootDiagUnit Tag.E6 (fun j => ζ ^ corootPair α (Pi.single j 1)) ∈ S.Γ)
    (heΓ : rootDiagUnit Tag.E6 (fun j => ζ ^ corootPair β (Pi.single j 1)) ∈ S.Γ) :
    4 ∣ Nat.card (ggAutomizer
      (rationalComponent S.ρ S.Γ (rootCharHom a) i)
      (fullThreeTorus S ⊓ S.Γ)) := by
  classical
  haveI : CharP L 2 := charP_two_of_langSetup_q_eq_two_pow S (f := 1) (by rw [hq]; norm_num)
  let nα := rootSL2 Tag.E6 L α WSL
  let nβ := rootSL2 Tag.E6 L β WSL
  let d := rootDiagUnit Tag.E6 (fun j => ζ ^ corootPair α (Pi.single j 1))
  let e := rootDiagUnit Tag.E6 (fun j => ζ ^ corootPair β (Pi.single j 1))
  have hdΓ' : d ∈ S.Γ := by
    simpa [d] using hdΓ
  have heΓ' : e ∈ S.Γ := by
    simpa [e] using heΓ
  obtain ⟨hα2, hβ2, hcomm, hα1, hβ1, hne, hdA, heA, hmoveα, hmoveβ,
    hfixβ, hfixα, hmoveab, -⟩ :=
    rootWeylSL2_pair_action_data S (Or.inl rfl) hq hρ hα hβ horth hζ3 hζ1
  let A0 : Subgroup (ModGL Tag.E6 L) := fullThreeTorus S ⊓ S.Γ
  have hdA0 : d ∈ A0 := ⟨hdA, hdΓ'⟩
  have heA0 : e ∈ A0 := ⟨heA, heΓ'⟩
  have hJ0Γ : rationalComponent S.ρ S.Γ (rootCharHom a) i ≤ S.Γ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.rationalComponent_le_Γ S i
  have hnαΓ : nα ∈ S.Γ := hJ0Γ hαJ
  have hnβΓ : nβ ∈ S.Γ := hJ0Γ hβJ
  have hnαN : nα ∈ Subgroup.normalizer (A0 : Set (ModGL Tag.E6 L)) := by
    refine Subgroup.inf_normalizer_le_normalizer_inf ⟨?_, ?_⟩
    · exact rootWeylSL2_mem_normalizer_fullThreeTorus S hα (hρ α hα)
    · exact Subgroup.le_normalizer hnαΓ
  have hnβN : nβ ∈ Subgroup.normalizer (A0 : Set (ModGL Tag.E6 L)) := by
    refine Subgroup.inf_normalizer_le_normalizer_inf ⟨?_, ?_⟩
    · exact rootWeylSL2_mem_normalizer_fullThreeTorus S hβ (hρ β hβ)
    · exact Subgroup.le_normalizer hnβΓ
  exact four_dvd_ggAutomizer_of_coroot_witnesses hαJ hβJ hnαN hnβN hdA0 heA0
    hα2 hβ2 hcomm hα1 hβ1 hne hmoveα hmoveβ hfixβ hfixα hmoveab

theorem corootTuple_mem_Γ_of_rho_neg
    {L : Type} [Field L] [IsAlgClosed L] {p : ℕ} (S : LangSetup Tag.E6 L p)
    (hq : S.D.q = 2) (hρ : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = -γ)
    {α : Fin Tag.E6.rank → ℤ} (hα : IsRoot Tag.E6 α) {ζ : Lˣ} (hζ3 : ζ ^ 3 = 1) :
    rootDiagUnit Tag.E6 (fun j => ζ ^ corootPair α (Pi.single j 1)) ∈ S.Γ := by
  haveI : CharP L 2 := charP_two_of_langSetup_q_eq_two_pow S (f := 1) (by rw [hq]; norm_num)
  let d := rootDiagUnit Tag.E6 (fun j => ζ ^ corootPair α (Pi.single j 1))
  let n := rootSL2 Tag.E6 L α WSL
  have hd : d ∈ fullThreeTorus S := corootTuple_mem_fullThreeTorus S
    (Or.inr (Or.inl rfl)) hq hρ hα hζ3
  have hdM : d ∈ S.D.model := S.D.torus_le_model hd.1
  have hnM : n ∈ S.D.model := rootWeylSL2_mem_model_of_rho_neg S hα (hρ α hα)
  have hdSL : rootSL2 Tag.E6 L α (HSL ζ) = d :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.rootSL2_HSL_eq hα ζ
  have hinv : n * d * n⁻¹ = d⁻¹ := by
    have hconj := congrArg (rootSL2 Tag.E6 L α) (CFSG.StandardType.splitWSL_conj_HSL ζ)
    have hn : n * d * n⁻¹ = rootSL2 Tag.E6 L α (HSL ζ⁻¹) := by
      simpa only [map_mul, map_inv, hdSL, n] using hconj
    have hdinv : rootSL2 Tag.E6 L α (HSL ζ⁻¹) = d⁻¹ := by
      rw [← CFSG.StandardType.splitDiagHSL_inv, map_inv, hdSL]
    exact hn.trans hdinv
  let M : Subgroup (ModGL Tag.E6 L) := S.D.model
  let dm : ↥M := ⟨d, hdM⟩
  let nm : ↥M := ⟨n, hnM⟩
  have hmInv : nm * dm * nm⁻¹ = dm⁻¹ := Subtype.ext hinv
  have hm3 : dm ^ 3 = 1 := Subtype.ext hd.2
  have hdc : dm ∈ commutator ↥M :=
    @CFSG.HardMathSupport.Solomon.Coordinator.mem_commutator_of_conj_eq_inv
      ↥M M.toGroup nm dm hmInv hm3
  have hmap : d ∈ (commutator ↥M).map M.subtype := ⟨dm, hdc, rfl⟩
  have hderived : (commutator ↥M).map M.subtype = S.Γ := by
    rw [map_commutator_eq, Subgroup.range_subtype]
    rfl
  exact hderived ▸ hmap

theorem four_dvd_aut_innerFullThreeTorus_of_quasisimple_component
    {L : Type} [Field L] [IsAlgClosed L] {p : ℕ} (S : LangSetup Tag.E6 L p)
    (hq : S.D.q = 2) (hAlg : S.IsAlgebraic)
    (hρ : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = -γ)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (ha3 : ∀ j, a j ^ 3 = 1) (ha1 : rootDiagUnit Tag.E6 a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (hQ : CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    4 ∣ Nat.card (ggAutomizer (rationalComponent S.ρ S.Γ (rootCharHom a) i)
      (fullThreeTorus S ⊓ S.Γ)) := by
  haveI : CharP L 2 := charP_two_of_langSetup_q_eq_two_pow S (f := 1) (by rw [hq]; norm_num)
  have h3 := three_le_rank_of_quasisimple_component S (Or.inl rfl) hq hAlg hρ hT ha3 ha1 i hQ
  have hd3 : rootDiagUnit Tag.E6 a ^ 3 = 1 := by
    rw [rootDiagUnit_pow, show a ^ 3 = 1 from funext ha3, rootDiagUnit_one]
  obtain ⟨ψ, σ, hψ, hnorm, hsub⟩ := exists_A3_subframe_E6 S hq hd3 i h3
  obtain ⟨α, β, hα, hβ, horth, hαJ, hβJ⟩ :=
    exists_orthogonal_weyl_pair_of_subframe S (Or.inl rfl) hq hAlg hρ i
      (by norm_num) hψ hnorm hsub
  obtain ⟨ζ, hζ3, hζ1⟩ := exists_primitive_cube_root (L := L)
  exact four_dvd_aut_innerFullThreeTorus_of_weyl_mem S hq hAlg hρ i hα.1.1 hβ.1.1
    horth hαJ hβJ hζ3 hζ1
    (corootTuple_mem_Γ_of_rho_neg S hq hρ hα.1.1 hζ3)
    (corootTuple_mem_Γ_of_rho_neg S hq hρ hβ.1.1 hζ3)

