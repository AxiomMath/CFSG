theorem rckTwE6_core_conj {G : Type*} [Group G] {X : Subgroup G} {x : G} (s : G)
    (h : pCoreOf 2 (centralizer ({x} : Set G)) ≤ centralizer (X : Set G)) :
    pCoreOf 2 (centralizer ({s * x * s⁻¹} : Set G)) ≤
      centralizer ((X.map (MulAut.conj s).toMonoidHom : Subgroup G) : Set G) := by
  have hmap : (Subgroup.centralizer ({x} : Set G)).map (MulAut.conj s).toMonoidHom =
      Subgroup.centralizer ({s * x * s⁻¹} : Set G) := by
    rw [CFSG.GroupTheory.map_centralizer_eq_of_mulEquiv, Set.image_singleton]
    congr 1
  rw [← hmap, CFSG.GroupTheory.map_pCoreOf_mulEquiv]
  refine (Subgroup.map_mono h).trans_eq ?_
  rw [CFSG.GroupTheory.map_centralizer_eq_of_mulEquiv]
  rfl

@[expose] def rckTwE6RootA : Fin (Tag.rank .E6) → ℤ := ![1, 1, 1, 2, 2, 1]

theorem rckTwE6RootA_facts :
    IsRoot .E6 rckTwE6RootA ∧ proj rckTwE6RootA = twE6Alpha ∧ rho rckTwE6RootA ≠ rckTwE6RootA ∧
      rckTwE6RootA = E6Pilot.yBetaAS ∧ rho rckTwE6RootA = E6Pilot.yAlphaAS := by
  refine ⟨mem_rootFinset.1 (by decide +kernel), by decide +kernel, by decide +kernel,
    rfl, by decide +kernel⟩

@[expose] noncomputable def rckTwE6X
    {k : Type} [Field k]
    (θ : k →+* k) (hθ : ∀ c, θ (θ c) = c) (c : k) : fixedGroup k θ :=
  xPair θ hθ rckTwE6RootA_facts.1 rckTwE6RootA_facts.2.2.1 c

section Generic


theorem rckTwE6_mem_rootGroup_iff {k : Type} [Field k] (θ : k →+* k) (hθ : ∀ c, θ (θ c) = c)
    (x : fixedGroup k θ) :
    x ∈ (twistedDatum k θ).rootGroup twE6Alpha ↔ ∃ c, x = rckTwE6X θ hθ c := by
  have ha : IsRoot .E6 rckTwE6RootA := rckTwE6RootA_facts.1
  have hp : proj rckTwE6RootA = twE6Alpha := rckTwE6RootA_facts.2.1
  have hne : rho rckTwE6RootA ≠ rckTwE6RootA := rckTwE6RootA_facts.2.2.1
  constructor
  · intro hx
    obtain ⟨c, hc⟩ := (mem_twistedRootGroup_iff_of_pair θ ha hp hne x).1 hx
    refine ⟨c, Subtype.ext ?_⟩
    exact hc.trans (xPair_val θ hθ ha hne c).symm
  · rintro ⟨c, rfl⟩
    have h := xPair_mem θ hθ ha hne c
    rw [hp] at h
    exact h

theorem rckTwE6X_zero {k : Type} [Field k] (θ : k →+* k) (hθ : ∀ c, θ (θ c) = c) :
    rckTwE6X θ hθ 0 = 1 := by
  apply Subtype.ext
  simp [rckTwE6X, xPair_val, e6Data_valid.xm_zero]

theorem rckTwE6X_mul_self {k : Type} [Field k] [CharP k 2] (θ : k →+* k)
    (hθ : ∀ c, θ (θ c) = c) (c : k) : rckTwE6X θ hθ c * rckTwE6X θ hθ c = 1 := by
  have ha : IsRoot .E6 rckTwE6RootA := rckTwE6RootA_facts.1
  have hne : rho rckTwE6RootA ≠ rckTwE6RootA := rckTwE6RootA_facts.2.2.1
  set d : k := (twistSign rckTwE6RootA : k) * θ c with hd
  apply Subtype.ext
  simp only [Subgroup.coe_mul, OneMemClass.coe_one, rckTwE6X, xPair_val]
  change (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k (rho rckTwE6RootA) d) *
      (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k (rho rckTwE6RootA) d) = 1
  rw [show (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k (rho rckTwE6RootA) d) *
        (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k (rho rckTwE6RootA) d) =
      (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k rckTwE6RootA c) *
        (e6Data_valid.xm k (rho rckTwE6RootA) d *
          e6Data_valid.xm k (rho rckTwE6RootA) d) from by
    calc e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k (rho rckTwE6RootA) d *
          (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k (rho rckTwE6RootA) d)
        = e6Data_valid.xm k rckTwE6RootA c *
            (e6Data_valid.xm k (rho rckTwE6RootA) d *
              e6Data_valid.xm k rckTwE6RootA c) * e6Data_valid.xm k (rho rckTwE6RootA) d :=
          by group
      _ = e6Data_valid.xm k rckTwE6RootA c *
            (e6Data_valid.xm k rckTwE6RootA c *
              e6Data_valid.xm k (rho rckTwE6RootA) d) * e6Data_valid.xm k (rho rckTwE6RootA) d :=
          by rw [← (commute_xm_rho ha hne c d).eq]
      _ = (e6Data_valid.xm k rckTwE6RootA c * e6Data_valid.xm k rckTwE6RootA c) *
            (e6Data_valid.xm k (rho rckTwE6RootA) d *
              e6Data_valid.xm k (rho rckTwE6RootA) d) := by group,
    ← e6Data_valid.xm_add, ← e6Data_valid.xm_add,
    CharTwo.add_self_eq_zero c, CharTwo.add_self_eq_zero d,
    e6Data_valid.xm_zero, e6Data_valid.xm_zero, mul_one]

theorem rckTwE6X_one_ne_one {k : Type} [Field k] (θ : k →+* k) (hθ : ∀ c, θ (θ c) = c) :
    rckTwE6X θ hθ 1 ≠ 1 := by
  intro h
  have h' : (rckTwE6X θ hθ 1 : e6Data_valid.minGroup k) = 1 := congrArg Subtype.val h
  rw [rckTwE6X, xPair_val] at h'
  have h0 : e6Data_valid.xm k rckTwE6RootA 1 *
        e6Data_valid.xm k (rho rckTwE6RootA)
          ((twistSign rckTwE6RootA : k) * θ 1) =
      e6Data_valid.xm k rckTwE6RootA 0 * e6Data_valid.xm k (rho rckTwE6RootA) 0 := by
    rw [h', e6Data_valid.xm_zero, e6Data_valid.xm_zero, mul_one]
  obtain ⟨h1, -⟩ :=
    xm_mul_xm_rho_inj rckTwE6RootA_facts.1 rckTwE6RootA_facts.2.2.1 h0
  exact one_ne_zero h1

theorem rckTwE6_exists_conj_xPair {k : Type} [Field k] (θ : k →+* k) (hθ : ∀ c, θ (θ c) = c)
    {c : k} (hc : c ≠ 0) :
    ∃ s : fixedGroup k θ, ∀ d : k, s * rckTwE6X θ hθ d * s⁻¹ = rckTwE6X θ hθ (c * d) := by
  let u₀ : kˣ := Units.mk0 c hc
  let u6 : Fin 6 → kˣ := ![u₀, 1, 1, 1, 1, Units.map θ.toMonoidHom u₀]
  let u : Fin (Tag.rank .E6) → kˣ := u6
  have hu : IsSymU θ u := by
    intro a
    fin_cases a
    · change u6 (5 : Fin 6) = Units.map θ.toMonoidHom (u6 (0 : Fin 6))
      simp [u6, u₀]
    · change u6 (1 : Fin 6) = Units.map θ.toMonoidHom (u6 (1 : Fin 6))
      simp [u6]
    · change u6 (4 : Fin 6) = Units.map θ.toMonoidHom (u6 (2 : Fin 6))
      simp [u6]
    · change u6 (3 : Fin 6) = Units.map θ.toMonoidHom (u6 (3 : Fin 6))
      simp [u6]
    · change u6 (2 : Fin 6) = Units.map θ.toMonoidHom (u6 (4 : Fin 6))
      simp [u6]
    · change u6 (0 : Fin 6) = Units.map θ.toMonoidHom (u6 (5 : Fin 6))
      change u₀ = Units.map θ.toMonoidHom (Units.map θ.toMonoidHom u₀)
      rw [show Units.map θ.toMonoidHom (Units.map θ.toMonoidHom u₀) = u₀ from by
        apply Units.ext
        simp [u₀, hθ]]
  have hχ : (CFSG.LieType.Chevalley.ExceptionalCover.rootChar k rckTwE6RootA u : k) = c := by
    rw [CFSG.LieType.Chevalley.ExceptionalCover.rootChar_apply]
    change ((∏ i : Fin 6, u6 i ^
      CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA i : kˣ) : k) = c
    rw [Fin.prod_univ_six]
    have h0 : CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA
        (0 : Fin 6) = 1 := by decide +kernel
    have h1 : CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA
        (1 : Fin 6) = 0 := by decide +kernel
    have h2 : CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA
        (2 : Fin 6) = -1 := by decide +kernel
    have h3 : CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA
        (3 : Fin 6) = 0 := by decide +kernel
    have h4 : CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA
        (4 : Fin 6) = 1 := by decide +kernel
    have h5 : CFSG.LieType.Chevalley.ExceptionalCover.cartanCoord rckTwE6RootA
        (5 : Fin 6) = 0 := by decide +kernel
    simp [u6, u₀, h0, h1, h2, h3, h4, h5]
  have hconj := torU_conj_xPair θ hθ hu rckTwE6RootA_facts.1 rckTwE6RootA_facts.2.2.1
  rw [hχ] at hconj
  exact ⟨torU θ u hu, fun d => hconj d⟩

theorem rckTwE6_coe_pi_xPair {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 1 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f))
    (hθ : ∀ c, θ (θ c) = c) (c : k) :
    ((F4Pilot.twistedIsogenyC hf hK θ hσ (rckTwE6X θ hθ c) :
        graphFixedRootGroup TwistTag.E6 k θ) : ModGL TwistTag.E6.tag k) =
      pinnedX .E6 k E6Pilot.yBetaAS c * pinnedX .E6 k E6Pilot.yAlphaAS (θ c) := by
  obtain ⟨ha, hp, hne, hβ, hα⟩ := rckTwE6RootA_facts
  rw [CFSG.SeitzReduction.F4Pilot.coe_twistedIsogenyC]
  change ((CFSG.LieType.Steinberg.Isogeny.e6Isogeny k
      ((xPair θ hθ ha hne c : fixedGroup k θ) : e6Data_valid.minGroup k) :
        adjointGroup .E6 k) : ModGL .E6 k) = _
  have hs : ((twistSign rckTwE6RootA : ℤ) : k) = 1 := by
    rcases twistSign_eq_one_or rckTwE6RootA with h | h
    · rw [h, Int.cast_one]
    · rw [h, Int.cast_neg, Int.cast_one, CharTwo.neg_eq]
  rw [xPair_val, map_mul, Subgroup.coe_mul,
    CFSG.SeitzReduction.E6Pilot.coe_e6Isogeny_xm ha,
    CFSG.SeitzReduction.E6Pilot.coe_e6Isogeny_xm (isRoot_rho ha), hs, one_mul, hα, hβ]

theorem rckTwE6_pi_xPair_one {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 1 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f))
    (hθ : ∀ c, θ (θ c) = c) :
    F4Pilot.twistedIsogenyC hf hK θ hσ (rckTwE6X θ hθ 1) = stdRepC (apply_apply_eq hK hσ) 1 := by
  apply Subtype.ext
  rw [rckTwE6_coe_pi_xPair hf hK θ hσ hθ 1, map_one]
  change pinnedX .E6 k E6Pilot.yBetaAS 1 * pinnedX .E6 k E6Pilot.yAlphaAS 1 =
    pinnedX .E6 k twistedE6ClassRootU 1 * pinnedX .E6 k twistedE6ClassRootU' 1
  rfl

