     0] ![0, 0, 0, 0, 0, 0, 0, 1]),
   ((![2, 2, 2, 2, 2, 2, 2, 1], ![0, 0, 0, 0, 0, 0, 0, 2]), .symw [] 6),
   ((![2, 2, 2, 2, 2, 2, 2, 1], ![2, 2, 2, 2, 2, 2, 2, 1]), .excl [8, 6, 5, 7, 6, 8, 6, 7, 5, 6,
     8] 4 0 ![0, 0, 0, 0, 0, 0, 1, 0]),
   ((![2, 2, 2, 2, 2, 2, 2, 2], ![0, 0, 0, 0, 0, 0, 0, 1]), .symw [] 6),
   ((![2, 2, 2, 2, 2, 2, 2, 2], ![2, 2, 2, 2, 2, 2, 2, 2]), .excl [8, 6, 5, 7, 6, 8, 6, 7, 5, 6,
     8] 4 0 ![0, 0, 0, 0, 0, 0, 1, 0])]
@[expose] def a8bReps : List (Vn 8 × Vn 8) :=
  [(![0, 0, 0, 0, 0, 1, 1, 1], ![2, 2, 2, 2, 2, 0, 0, 2]),
   (![0, 0, 0, 0, 0, 1, 1, 2], ![2, 2, 2, 2, 2, 0, 0, 1])]
@[expose] def a8bS2 : List (S2V 8) :=
  [.inn [],
   .excl [8, 4, 6, 9, 6, 4, 8] 3 0 ![0, 0, 0, 0, 0, 0, 1, 0],
   .excl [8, 4, 6, 9, 6, 4, 8] 3 0 ![0, 0, 0, 0, 0, 0, 1, 0],
   .inn []]

@[expose] def a8bS (k : Fin 8) : Vn 8 ≃ₗ[ZMod 3] Vn 8 := letLin (letAt a8bGens k)

theorem a8b_certOK :
    certOK a8bGens (xLast 7) a8bSets a8bPats a8bReps a8bS2 = true := by
  decide +kernel

theorem a8b_cov : prefCovB 7 a8bPats = true := by
  decide +kernel

theorem a8b_adj : ∀ i : Fin 6, letAt a8bGens i =
    (Pi.single i.castSucc.castSucc 1 - Pi.single i.succ.castSucc 1,
      Pi.single i.castSucc.castSucc 1 - Pi.single i.succ.castSucc 1) := by
  decide +kernel

theorem a8b_test : ∀ A Mg : Subgroup (Vn 8 ≃ₗ[ZMod 3] Vn 8),
    TestHyp (Subgroup.closure (Set.range a8bS)) (xLast 7) A Mg →
    ∀ r ∈ Mg, IsRefl r → ¬ FixesLine (xLast 7) r →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 7) t → t ∈ Mg :=
  linTest_prefix_of_certOK (k := 6) a8bS a8bGens rfl (fun _ => rfl) (by norm_num)
    a8b_adj a8b_certOK a8b_cov

end CFSG.StandardType.TestLin

