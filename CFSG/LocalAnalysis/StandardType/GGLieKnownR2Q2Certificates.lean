def mulVecAux : List Nat → Nat → Nat → Nat
  | [], _, acc => acc
  | c :: M, v, acc => mulVecAux M (v / 2) (if v % 2 = 1 then acc ^^^ c else acc)

def mulVec (M : List Nat) (v : Nat) : Nat := mulVecAux M v 0

def mul (M N : List Nat) : List Nat := N.map (mulVec M)

def ident (d : Nat) : List Nat := (List.range d).map (2 ^ ·)

def mpow (d : Nat) (M : List Nat) : Nat → List Nat
  | 0 => ident d
  | n + 1 => mul M (mpow d M n)

def addId (M : List Nat) : List Nat := (M.zipIdx).map fun (c, i) => c ^^^ 2 ^ i

def wordMat (d : Nat) (gens : List (List Nat)) (word : List Nat) : List Nat :=
  word.foldl (fun P i => mul P (gens.getD i [])) (ident d)

def cert (d : Nat) (gens : List (List Nat)) (word : List Nat) (n : Nat) (inv : List Nat) : Bool :=
  gens.all (fun g => g.length == d && g.all (· < 2 ^ d)) && n % 2 == 1 &&
    mpow d (wordMat d gens word) n == ident d && mul (addId (wordMat d gens word)) inv == ident d

