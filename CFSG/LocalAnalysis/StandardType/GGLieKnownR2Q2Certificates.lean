@[expose] def bit (x i : Nat) : ZMod 2 := if x.testBit i then 1 else 0

@[expose] def toMat (d : Nat) (M : List Nat) : Matrix (Fin d) (Fin d) (ZMod 2) :=
  Matrix.of fun i j => bit (M.getD j 0) i

theorem bit_xor (a b i : Nat) : bit (a ^^^ b) i = bit a i + bit b i := by
  unfold bit
  rw [Nat.testBit_xor]
  cases a.testBit i <;> cases b.testBit i <;> decide

theorem bit_zero (i : Nat) : bit 0 i = 0 := by simp [bit]

theorem bit_two_pow (j i : Nat) : bit (2 ^ j) i = if j = i then 1 else 0 := by
  unfold bit
  rw [Nat.testBit_two_pow]
  by_cases h : j = i <;> simp [h]

theorem bit_mulVecAux (M : List Nat) (v acc i : Nat) :
    bit (mulVecAux M v acc) i =
      bit acc i + ∑ k ∈ Finset.range M.length, bit (M.getD k 0) i * bit v k := by
  induction M generalizing v acc with
  | nil => simp [mulVecAux]
  | cons c M ih =>
    rw [mulVecAux, ih, List.length_cons, Finset.sum_range_succ']
    have h0 : bit v 0 = if v % 2 = 1 then 1 else 0 := by
      unfold bit; rw [Nat.testBit_zero]; by_cases h : v % 2 = 1 <;> simp [h]
    have hs : ∀ k, bit (v / 2) k = bit v (k + 1) := fun k => by
      unfold bit; rw [Nat.testBit_div_two]
    simp only [hs, List.getD_cons_succ, List.getD_cons_zero, h0]
    split_ifs <;> simp [bit_xor] <;> ring

theorem mulVec_zero (M : List Nat) : mulVec M 0 = 0 := by
  unfold mulVec
  suffices ∀ M : List Nat, mulVecAux M 0 0 = 0 from this M
  intro M
  induction M with
  | nil => rfl
  | cons c M ih => simpa [mulVecAux] using ih

theorem bit_mulVec {d : Nat} (M : List Nat) (hM : M.length ≤ d) (v : Nat) (i : Nat) :
    bit (mulVec M v) i = ∑ k : Fin d, bit (M.getD k 0) i * bit v k := by
  rw [mulVec, bit_mulVecAux, bit_zero, zero_add, Fin.sum_univ_eq_sum_range
    (fun k => bit (M.getD k 0) i * bit v k)]
  refine Finset.sum_subset (Finset.range_subset_range.2 hM) fun k _ hk => ?_
  rw [Finset.mem_range, not_lt] at hk
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none hk, Option.getD_none, bit_zero,
    zero_mul]

theorem getD_mul (M N : List Nat) (j : Nat) : (mul M N).getD j 0 = mulVec M (N.getD j 0) := by
  unfold mul
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases N[j]? with
  | none => simp [mulVec_zero]
  | some x => simp

theorem toMat_mul {d : Nat} (M N : List Nat) (hM : M.length ≤ d) :
    toMat d (mul M N) = toMat d M * toMat d N := by
  ext i j
  simp only [toMat, Matrix.of_apply, Matrix.mul_apply, getD_mul, bit_mulVec M hM]

theorem length_mul (M N : List Nat) : (mul M N).length = N.length := by simp [mul]

theorem length_ident (d : Nat) : (ident d).length = d := by simp [ident]

theorem toMat_ident (d : Nat) : toMat d (ident d) = 1 := by
  ext i j
  have hj : (ident d).getD j 0 = 2 ^ (j : Nat) := by
    rw [List.getD_eq_getElem?_getD]
    simp [ident, j.isLt]
  simp only [toMat, Matrix.of_apply, hj, bit_two_pow, Matrix.one_apply]
  by_cases h : i = j
  · simp [h]
  · have : (j : Nat) ≠ i := fun e => h (Fin.ext e.symm)
    simp [h, this]

theorem toMat_mpow {d : Nat} (M : List Nat) (hM : M.length = d) (n : Nat) :
    toMat d (mpow d M n) = toMat d M ^ n := by
  induction n with
  | zero => rw [mpow, toMat_ident, pow_zero]
  | succ n ih => rw [mpow, toMat_mul M _ hM.le, ih, pow_succ']

theorem toMat_addId {d : Nat} (M : List Nat) (hM : M.length = d) :
    toMat d (addId M) = toMat d M + 1 := by
  ext i j
  have hj : (addId M).getD j 0 = M.getD j 0 ^^^ 2 ^ (j : Nat) := by
    have hjl : (j : Nat) < M.length := hM ▸ j.isLt
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD]
    simp [addId, hjl, List.getElem?_eq_getElem hjl]
  simp only [toMat, Matrix.of_apply, Matrix.add_apply, hj, bit_xor, bit_two_pow,
    Matrix.one_apply]
  by_cases h : i = j
  · simp [h]
  · have : (j : Nat) ≠ i := fun e => h (Fin.ext e.symm)
    simp [h, this]

@[expose] def wordProd (d : Nat) (gens : List (List Nat)) (word : List Nat) :
    Matrix (Fin d) (Fin d) (ZMod 2) :=
  (word.map fun i => toMat d (gens.getD i [])).prod

theorem foldl_spec {d : Nat} (gens : List (List Nat)) (hg : ∀ g ∈ gens, g.length = d) :
    ∀ (word : List Nat), (∀ i ∈ word, i < gens.length) → ∀ P : List Nat, P.length = d →
      (word.foldl (fun P i => mul P (gens.getD i [])) P).length = d ∧
      toMat d (word.foldl (fun P i => mul P (gens.getD i [])) P) =
        toMat d P * wordProd d gens word
  | [], _, P, hP => by simp [wordProd, hP]
  | i :: w, hw, P, hP => by
    have hi : i < gens.length := hw i List.mem_cons_self
    have hgi : (gens.getD i []).length = d := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some]
      exact hg _ (List.getElem_mem hi)
    obtain ⟨h1, h2⟩ := foldl_spec gens hg w (fun j hj => hw j (List.mem_cons_of_mem _ hj))
      (mul P (gens.getD i [])) (by rw [length_mul, hgi])
    refine ⟨h1, ?_⟩
    rw [List.foldl_cons, h2, toMat_mul _ _ hP.le]
    simp only [wordProd, List.map_cons, List.prod_cons, mul_assoc]

theorem cert_spec {d : Nat} {gens : List (List Nat)} {word : List Nat} {n : Nat}
    {inv : List Nat} (hw : ∀ i ∈ word, i < gens.length) (h : cert d gens word n inv = true) :
    Odd n ∧ wordProd d gens word ^ n = 1 ∧ (wordProd d gens word + 1) * toMat d inv = 1 := by
  simp only [cert, Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨hg, hn⟩, hp⟩, hi⟩ := h
  have hg' : ∀ g ∈ gens, g.length = d := fun g hg0 => (hg g hg0).1
  obtain ⟨hl, ht⟩ := foldl_spec gens hg' word hw (ident d) (length_ident d)
  replace hl : (wordMat d gens word).length = d := hl
  have hW : toMat d (wordMat d gens word) = wordProd d gens word := by
    rw [wordMat, ht, toMat_ident, one_mul]
  refine ⟨Nat.odd_iff.2 hn, ?_, ?_⟩
  · have := congrArg (toMat d) hp
    rwa [toMat_mpow _ hl, toMat_ident, hW] at this
  · have := congrArg (toMat d) hi
    rwa [toMat_mul _ _ (by rw [addId, List.length_map, List.length_zipIdx]; exact hl.le),
      toMat_addId _ hl, toMat_ident, hW] at this

end CFSG.StandardType.LieKnownR2.Q2
