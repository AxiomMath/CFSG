@[expose] def rckTw78_toMatRingEquiv (k : Type*) [Field k] (d : ℕ) :
    Module.End k (Fin d →₀ k) ≃+* Matrix (Fin d) (Fin d) k where
  toFun := toMat
  invFun := ofMat
  left_inv := ofMat_toMat
  right_inv := toMat_ofMat
  map_mul' := toMat_mul
  map_add' A B := map_add (LinearMap.toMatrix Finsupp.basisSingleOne Finsupp.basisSingleOne) A B

theorem rckTw78_toEnd_map
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d M : ℕ) :
    (toMat (toEnd k d M)).map e = toMat (toEnd l d M) := by
  ext i j
  rw [Matrix.map_apply, toMat_toEnd_apply, toMat_toEnd_apply]
  exact map_intCast (f := e.toRingHom) (entryZ M i j)

theorem rckTw78_rootOp_map
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) {τ : Tag}
    (D : MinData τ) (γ : Fin τ.rank → ℤ) :
    (toMat (D.rootOp k γ)).map e = toMat (D.rootOp l γ) := by
  classical
  unfold MinData.rootOp
  split_ifs with h
  · rw [MinData.E, MinData.E]
    exact rckTw78_toEnd_map e D.d (D.op (Nat.find h))
  · simp only [toMat, map_zero, Matrix.map_zero]

@[expose] def rckTw78_endMap {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d : ℕ) :
    Module.End k (Fin d →₀ k) ≃+* Module.End l (Fin d →₀ l) :=
  (rckTw78_toMatRingEquiv k d).trans
    (((e.mapMatrix : Matrix (Fin d) (Fin d) k ≃+* Matrix (Fin d) (Fin d) l)).trans
      (rckTw78_toMatRingEquiv l d).symm)

theorem rckTw78_endMap_toMat {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d : ℕ)
    (A : Module.End k (Fin d →₀ k)) :
    toMat (rckTw78_endMap e d A) = (toMat A).map e := by
  show (rckTw78_toMatRingEquiv l d)
      ((rckTw78_toMatRingEquiv k d).trans
        (((e.mapMatrix : Matrix (Fin d) (Fin d) k ≃+* Matrix (Fin d) (Fin d) l)).trans
          (rckTw78_toMatRingEquiv l d).symm) A) = (toMat A).map e
  simp only [RingEquiv.trans_apply, RingEquiv.apply_symm_apply]
  rfl

theorem rckTw78_toMat_xu
    {k : Type*} [Field k] {τ : Tag} (D : MinData τ) (hV : D.Valid)
    (γ : Fin τ.rank → ℤ) (c : k) :
    toMat ((hV.xu k γ c : (Module.End k (Fin D.d →₀ k))ˣ) : Module.End k (Fin D.d →₀ k)) =
      1 + c • toMat (D.rootOp k γ) := by
  rw [hV.xu_val]
  show LinearMap.toMatrix Finsupp.basisSingleOne Finsupp.basisSingleOne (1 + c • D.rootOp k γ) =
    1 + c • LinearMap.toMatrix Finsupp.basisSingleOne Finsupp.basisSingleOne (D.rootOp k γ)
  rw [map_add, map_smul, LinearMap.toMatrix_one]

theorem rckTw78_endMap_xu
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) {τ : Tag}
    (D : MinData τ) (hV : D.Valid) (γ : Fin τ.rank → ℤ) (c : k) :
    rckTw78_endMap e D.d
        ((hV.xu k γ c : (Module.End k (Fin D.d →₀ k))ˣ) : Module.End k (Fin D.d →₀ k)) =
      ((hV.xu l γ (e c) : (Module.End l (Fin D.d →₀ l))ˣ) : Module.End l (Fin D.d →₀ l)) := by
  apply (rckTw78_toMatRingEquiv l D.d).injective
  change toMat (rckTw78_endMap e D.d
      ((hV.xu k γ c : (Module.End k (Fin D.d →₀ k))ˣ) : Module.End k (Fin D.d →₀ k))) =
    toMat ((hV.xu l γ (e c) : (Module.End l (Fin D.d →₀ l))ˣ) : Module.End l (Fin D.d →₀ l))
  rw [rckTw78_endMap_toMat, rckTw78_toMat_xu D hV γ c, rckTw78_toMat_xu D hV γ (e c)]
  have key : (1 + c • toMat (D.rootOp k γ)).map e =
      1 + e c • toMat (D.rootOp l γ) := by
    ext i j
    have hM := congrFun (congrFun (rckTw78_rootOp_map e D γ) i) j
    simp only [Matrix.map_apply] at hM
    simp only [Matrix.map_apply, Matrix.add_apply, Matrix.one_apply, Matrix.smul_apply,
      Pi.smul_apply, smul_eq_mul, map_add, map_mul, map_one, map_zero]
    rw [hM]
    split_ifs <;> simp
  exact key

@[expose] def rckTw78_endUnitMap {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d : ℕ) :
    (Module.End k (Fin d →₀ k))ˣ ≃* (Module.End l (Fin d →₀ l))ˣ :=
  Units.mapEquiv (rckTw78_endMap e d).toMulEquiv

theorem rckTw78_endUnitMap_apply {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d : ℕ)
    (g : (Module.End k (Fin d →₀ k))ˣ) :
    ((rckTw78_endUnitMap e d g : (Module.End l (Fin d →₀ l))ˣ) :
      Module.End l (Fin d →₀ l)) = rckTw78_endMap e d (g : Module.End k (Fin d →₀ k)) := rfl

theorem rckTw78_endUnitMap_xu
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) {τ : Tag}
    (D : MinData τ) (hV : D.Valid) (γ : Fin τ.rank → ℤ) (c : k) :
    rckTw78_endUnitMap e D.d (hV.xu k γ c) = hV.xu l γ (e c) := by
  apply Units.ext
  rw [rckTw78_endUnitMap_apply]
  exact rckTw78_endMap_xu e D hV γ c

theorem rckTw78_endUnitMap_pUnit
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) :
    rckTw78_endUnitMap e e6Data.d (pUnit k) = pUnit l := by
  apply Units.ext
  show rckTw78_endMap e e6Data.d (toEnd k e6Data.d pCode) = toEnd l e6Data.d pCode
  apply (rckTw78_toMatRingEquiv l e6Data.d).injective
  change toMat (rckTw78_endMap e e6Data.d (toEnd k e6Data.d pCode)) =
    toMat (toEnd l e6Data.d pCode)
  rw [rckTw78_endMap_toMat, rckTw78_toEnd_map]

theorem rckTw78_endMap_frobT {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d : ℕ)
    (θ : k →+* k) (θ' : l →+* l) (hθ : ∀ x, θ' (e x) = e (θ x))
    (A : Module.End k (Fin d →₀ k)) :
    rckTw78_endMap e d (frobT θ A) = frobT θ' (rckTw78_endMap e d A) := by
  apply (rckTw78_toMatRingEquiv l d).injective
  change toMat (rckTw78_endMap e d (frobT θ A)) =
    toMat (frobT θ' (rckTw78_endMap e d A))
  rw [rckTw78_endMap_toMat, frobT, frobT, toMat_ofMat, toMat_ofMat, rckTw78_endMap_toMat]
  ext i j
  simp only [Matrix.map_apply, Matrix.transpose_apply]
  rw [hθ]

theorem rckTw78_endUnitMap_dualHom {k l : Type*} [Field k] [Field l] (e : k ≃+* l) (d : ℕ)
    (θ : k →+* k) (θ' : l →+* l) (hθ : ∀ x, θ' (e x) = e (θ x))
    (g : (Module.End k (Fin d →₀ k))ˣ) :
    rckTw78_endUnitMap e d (dualHom θ g) =
      dualHom θ' (rckTw78_endUnitMap e d g) := by
  apply Units.ext
  show rckTw78_endMap e d (frobT θ ((g⁻¹ : (Module.End k (Fin d →₀ k))ˣ) :
      Module.End k (Fin d →₀ k))) =
    frobT θ' (((rckTw78_endUnitMap e d g)⁻¹ : (Module.End l (Fin d →₀ l))ˣ) :
      Module.End l (Fin d →₀ l))
  rw [rckTw78_endMap_frobT e d θ θ' hθ]
  congr 1

theorem rckTw78_endUnitMap_sigmaGL
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l)
    (θ : k →+* k) (θ' : l →+* l) (hθ : ∀ x, θ' (e x) = e (θ x))
    (g : (Module.End k (Fin e6Data.d →₀ k))ˣ) :
    rckTw78_endUnitMap e e6Data.d (sigmaGL k θ g) =
      sigmaGL l θ' (rckTw78_endUnitMap e e6Data.d g) := by
  simp only [sigmaGL, CFSG.LieType.Steinberg.Twist.twistHom_apply, map_mul, map_inv]
  rw [rckTw78_endUnitMap_pUnit,
    rckTw78_endUnitMap_dualHom e e6Data.d θ θ' hθ]

theorem rckTw78_minGroup_map
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) {τ : Tag}
    (D : MinData τ) (hV : D.Valid) :
    (hV.minGroup k).map (rckTw78_endUnitMap e D.d).toMonoidHom = hV.minGroup l := by
  rw [MinData.Valid.minGroup, MonoidHom.map_closure, MinData.Valid.minGroup]
  congr 1
  ext g
  constructor
  · rintro ⟨g, ⟨γ, hγ, c, rfl⟩, rfl⟩
    exact ⟨γ, hγ, e c, by simpa using (rckTw78_endUnitMap_xu e D hV γ c)⟩
  · rintro ⟨γ, hγ, c, rfl⟩
    exact ⟨hV.xu k γ (e.symm c), ⟨γ, hγ, e.symm c, rfl⟩,
      by simpa [e.apply_symm_apply] using (rckTw78_endUnitMap_xu e D hV γ (e.symm c))⟩

@[expose] def rckTw78_Tmin
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) {τ : Tag}
    (D : MinData τ) (hV : D.Valid) : hV.minGroup k ≃* hV.minGroup l :=
  ((rckTw78_endUnitMap e D.d).subgroupMap (hV.minGroup k)).trans
    (MulEquiv.subgroupCongr (rckTw78_minGroup_map e D hV))

theorem rckTw78_Tmin_coe
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l) {τ : Tag}
    (D : MinData τ) (hV : D.Valid) (g : hV.minGroup k) :
    ((rckTw78_Tmin e D hV g : hV.minGroup l) : (Module.End l (Fin D.d →₀ l))ˣ) =
      rckTw78_endUnitMap e D.d (g : (Module.End k (Fin D.d →₀ k))ˣ) := rfl

theorem rckTw78_Tmin_sigma
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l)
    (θ : k →+* k) (θ' : l →+* l) (hθ : ∀ x, θ' (e x) = e (θ x))
    (g : e6Data_valid.minGroup k) :
    rckTw78_Tmin e e6Data e6Data_valid (sigma k θ g) =
      sigma l θ' (rckTw78_Tmin e e6Data e6Data_valid g) := by
  apply Subtype.ext
  show rckTw78_endUnitMap e e6Data.d
      (sigmaGL k θ (g : (Module.End k (Fin e6Data.d →₀ k))ˣ)) =
    sigmaGL l θ' (rckTw78_endUnitMap e e6Data.d
      (g : (Module.End k (Fin e6Data.d →₀ k))ˣ))
  exact rckTw78_endUnitMap_sigmaGL e θ θ' hθ
    (g : (Module.End k (Fin e6Data.d →₀ k))ˣ)

theorem rckTw78_fixedGroup_map
    {k l : Type*} [Field k] [Field l] (e : k ≃+* l)
    (θ : k →+* k) (θ' : l →+* l) (hθ : ∀ x, θ' (e x) = e (θ x)) :
    (fixedGroup k θ).map (rckTw78_Tmin e e6Data e6Data_valid).toMonoidHom =
      fixedGroup l θ' := by
  ext g
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hx' : sigma k θ x = x := by
      change x ∈ fixedGroup k θ at hx
      rwa [mem_fixedGroup] at hx
    have hmain : sigma l θ' (rckTw78_Tmin e e6Data e6Data_valid x) =
        rckTw78_Tmin e e6Data e6Data_valid x := by
      rw [← rckTw78_Tmin_sigma e θ θ' hθ x, hx']
    rw [mem_fixedGroup]
    simpa only [MulEquiv.coe_toMonoidHom] using hmain
  · intro hg
    rw [mem_fixedGroup] at hg
    refine ⟨(rckTw78_Tmin e e6Data e6Data_valid).symm g, ?_, by simp⟩
    change (rckTw78_Tmin e e6Data e6Data_valid).symm g ∈ fixedGroup k θ
    rw [mem_fixedGroup]
    apply (rckTw78_Tmin e e6Data e6Data_valid).injective
    rw [rckTw78_Tmin_sigma e θ θ' hθ, MulEquiv.apply_symm_apply, hg]

@[expose] def rckTw78_twistedE6Equiv
    (h : ℕ) (hh : 0 < h) :
    twistedE6Group 2 h ≃* fixedGroup (K2 CoeffField 2 h) (theta2 CoeffField 2 h) := by
  haveI : CharP CoeffField 2 := inferInstance
  haveI : Finite (K2 CoeffField 2 h) := finite_frobeniusFixedField (L := CoeffField) (ℓ := 2) (m := 2 * h)
    (by omega)
  have hcard : Nat.card (K2 CoeffField 2 h) = 2 ^ (2 * h) :=
    card_K2 (L := CoeffField) (ℓ := 2) (f := h) (by omega)
  let e : GaloisField 2 (2 * h) ≃+* K2 CoeffField 2 h :=
    (CFSG.ClassicalModels.finiteFieldEquivGaloisField (K2 CoeffField 2 h) 2 (2 * h) (by omega)
      hcard).symm
  have hθ : ∀ x, theta2 CoeffField 2 h (e x) = e (frobQ 2 h x) := by
    intro x
    apply Subtype.ext
    rw [theta2_apply, frobQ_apply, map_pow]
    rfl
  exact ((rckTw78_Tmin e e6Data e6Data_valid).subgroupMap
      (fixedGroup (GaloisField 2 (2 * h)) (frobQ 2 h))).trans
    (MulEquiv.subgroupCongr (rckTw78_fixedGroup_map e (frobQ 2 h) (theta2 CoeffField 2 h) hθ))

