private theorem langAsm_charP_two_of_langSetup
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {f : ℕ} (hf : 0 < f) (hq : S.D.q = 2 ^ f) : (2 : L) = 0 := by
  have hcast : ((2 ^ f : ℕ) : L) = 0 := by rw [← hq]; exact S.hqpow.2
  rw [Nat.cast_pow] at hcast
  exact (pow_eq_zero_iff hf.ne').mp hcast

private theorem langAsm_not_isSolvable_of_isQuasisimple {Q : Type} [Group Q]
    (hQ : CFSG.IsQuasisimple Q) : ¬ Group.IsSolvable Q := by
  intro hs
  haveI := hs
  obtain ⟨-, hsimple, a, b, hab⟩ := hQ
  exact hab ((IsSimpleGroup.comm_iff_isSolvable.mpr inferInstance) a b)

private theorem langAsm_isSolvable_of_le {G : Type} [Group G] {H K : Subgroup G}
    (hle : H ≤ K) (hK : Group.IsSolvable ↥K) : Group.IsSolvable ↥H := by
  haveI := hK
  exact Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hle)
    (Subgroup.inclusion_injective hle)

private theorem langAsm_mem_normalizer_of_conj_mem {G : Type} [Group G] {X : Subgroup G}
    {g : G} [Finite ↥X] (h : ∀ x ∈ X, g * x * g⁻¹ ∈ X) :
    g ∈ Subgroup.normalizer (X : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨h x, fun hx => ?_⟩
  let f : ↥X → ↥X := fun y => ⟨g * (y : G) * g⁻¹, h y y.2⟩
  have hf : Function.Injective f := by
    intro y z hyz
    apply Subtype.ext
    have h1 := congrArg (fun w : ↥X => (w : G)) hyz
    simp only [f] at h1
    exact mul_left_cancel (mul_right_cancel h1)
  have hsurj : Function.Surjective f := Finite.injective_iff_surjective.1 hf
  obtain ⟨y, hy⟩ := hsurj ⟨g * x * g⁻¹, hx⟩
  have hthis : g * (y : G) * g⁻¹ = g * x * g⁻¹ := by
    have := congrArg (fun w : ↥X => (w : G)) hy
    simpa only [f] using this
  have hyx : (y : G) = x := mul_left_cancel (mul_right_cancel hthis)
  rw [← hyx]
  exact y.2

private theorem langAsm_ggCompFieldAt_congr {G H : Type} [Group G] [Group H]
    {X : Subgroup G} {Y : Subgroup H} {Q : ℕ}
    (h : GGCompFieldAt Q X) (θ : ↥X ≃* ↥Y) : GGCompFieldAt Q Y := by
  obtain ⟨lab, hlab, hchar, hdeg, h1, h2, h3, hhas, R, instR, hR, ⟨φ⟩⟩ := h
  letI : Group R := instR
  have hq : (↥X ⧸ Subgroup.center ↥X) ≃* (↥Y ⧸ Subgroup.center ↥Y) :=
    QuotientGroup.congr _ _ θ (Subgroup.map_center_eq θ)
  have hhas' : GGHasLabel lab (↥Y ⧸ Subgroup.center ↥Y) := by
    unfold GGHasLabel at hhas ⊢
    refine largeEvenRawDatum_mono ?_ hhas
    rintro R' _ I F ⟨ψ⟩
    exact ⟨hq.symm.trans ψ⟩
  exact ⟨lab, hlab, hchar, hdeg, h1, h2, h3, hhas', R, instR, hR, ⟨hq.symm.trans φ⟩⟩

private theorem langAsm_langPairAt
    {τ : Tag} (hτ : τ = .E7 ∨ τ = .E8) {K : Type} [Field K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hpK : ¬ p ∣ Nat.card K) (hq1 : ¬ p ∣ Nat.card K - 1)
    (hq2 : ¬ p ∣ Nat.card K + 1) {a b : ↥(adjointGroup τ K)} (ha : a ^ p = 1)
    (hb : b ^ p = 1) (hab : a * b = b * a) (ha1 : a ≠ 1) :
    LangPair.LangPairAt τ K p a b := by
  rcases hτ with rfl | rfl
  · exact LangPair.langPairAt_E7 hp hpK hq1 hq2 ha hb hab ha1
  · exact LangPair.langPairAt_E8 hp hpK hq1 hq2 ha hb hab ha1

theorem ggExcCompLiftRestInput_of_model
    {τ : Tag} (hτ : τ = .E7 ∨ τ = .E8) (H : ℕ → ℕ → Prop)
    (hK : LangRatCompKillsP) (hI : LangRatCompInnerAct) (hB : LangRatCompFieldLen)
    (hB1 : LangFullFieldAt) : GGExcCompLiftRestInput τ H := by
  intro K _ _ _ p hp hp2 hq1 hq2 hH a b ha hb hab ha1 X hX hpX
  classical
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Finite (ModGL τ K) := finite_modGL
  obtain ⟨f, -, hfcard⟩ := FiniteField.card K 2
  have hk : Nat.card K = 2 ^ (f : ℕ) := by
    rw [Nat.card_eq_fintype_card]; exact hfcard
  have hpK : ¬ p ∣ Nat.card K := by
    rw [hk]
    intro h
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h))
  have hpair := langAsm_langPairAt hτ hp hpK hq1 hq2 ha hb hab ha1
  obtain ⟨L, _, _, S, ι, hq, hAlg, _, hιinj, hιrange, hιaT, hιbT⟩ := hpair
  have h2L : (2 : L) = 0 :=
    langAsm_charP_two_of_langSetup S f.pos (by rw [hq, hk])
  haveI : CharP L 2 := CharTwo.of_one_ne_zero_of_two_eq_zero (one_ne_zero : (1 : L) ≠ 0) h2L
  have hpL : (p : L) ≠ 0 := by
    intro hp0
    have h2p : 2 ∣ p := (CharP.cast_eq_zero_iff L 2 p).mp hp0
    exact hp2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp h2p).symm
  obtain ⟨a', ha'⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup
    (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hιaT).1
  obtain ⟨b', hb'⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup
    (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hιbT).1
  have ha'_tor : rootDiagUnit τ a' ∈ S.D.torus := by rw [← ha']; exact hιaT
  have hb'_tor : rootDiagUnit τ b' ∈ S.D.torus := by rw [← hb']; exact hιbT
  have ha'p : ∀ j, a' j ^ p = 1 := by
    have hpow : a' ^ p = 1 := by
      apply rootDiagUnit_injective
      calc rootDiagUnit τ (a' ^ p) = (rootDiagUnit τ a') ^ p :=
            map_pow (rootDiagUnitHom τ L) a' p
        _ = (ι a) ^ p := by rw [← ha']
        _ = ι (a ^ p) := (map_pow ι a p).symm
        _ = 1 := by rw [ha, map_one]
        _ = rootDiagUnit τ (1 : Fin τ.rank → Lˣ) := (rootDiagUnit_one).symm
    intro j
    simpa using congrFun hpow j
  have hb'p : ∀ j, b' j ^ p = 1 := by
    have hpow : b' ^ p = 1 := by
      apply rootDiagUnit_injective
      calc rootDiagUnit τ (b' ^ p) = (rootDiagUnit τ b') ^ p :=
            map_pow (rootDiagUnitHom τ L) b' p
        _ = (ι b) ^ p := by rw [← hb']
        _ = ι (b ^ p) := (map_pow ι b p).symm
        _ = 1 := by rw [hb, map_one]
        _ = rootDiagUnit τ (1 : Fin τ.rank → Lˣ) := (rootDiagUnit_one).symm
    intro j
    simpa using congrFun hpow j
  have ha'ne : rootDiagUnit τ a' ≠ 1 := by
    intro h
    exact ha1 (hιinj (by rw [ha', h, map_one]))
  obtain ⟨i, hqs_i, hmap_i⟩ :=
    langRatComp_of_component S hτ hp hpL ι hιinj hιrange ha' ha'_tor ha'p ha1
      (CFSG.Assembly.isComponentOf_iff_open.1 hX)
  have hcard_i : Nat.card ↥(rationalComponent S.ρ S.Γ (rootCharHom a') i) =
      Nat.card ↥X := by
    rw [← hmap_i]
    exact Subgroup.card_map_of_injective hιinj
  have hpR : ¬ p ∣ Nat.card ↥(rationalComponent S.ρ S.Γ (rootCharHom a') i) := by
    rw [hcard_i]; exact hpX
  have hkills :=
    hK τ L p S hτ hAlg p hp hp2 a' b' ha'_tor hb'_tor ha'p hb'p ha'ne i hqs_i hpR
  set mi : ℕ := componentOrbitLength S.ρ (componentRoots (rootCharHom a') i) with hmi
  have hfield_i : GGCompFieldAt (S.D.q ^ mi)
      (rationalComponent S.ρ S.Γ (rootCharHom a') i) := by
    rw [hmi]
    exact hB τ L p S hτ p hp hp2 a' ha'_tor ha'p ha'ne i hqs_i
  have hQdvd_i : (S.D.q ^ mi) ^ 2 - 1 ∣ Nat.card ↥X := by
    rw [← hcard_i]
    exact ggCompFieldAt_dvd hfield_i
  by_cases hb1 : b = 1
  · have hcent : Subgroup.centralizer ({b} : Set ↥(adjointGroup τ K)) = ⊤ := by
      rw [hb1]
      ext x
      rw [Subgroup.mem_centralizer_singleton_iff]
      simp
    have hqs_adj : CFSG.IsQuasisimple ↥(adjointGroup τ K) := by
      rcases hτ with rfl | rfl
      · exact CFSG.LieType.Simplicity.isQuasisimple_adjointGroup_e7 K
      · exact isQuasisimple_e8 K
    have hqs_top : CFSG.IsQuasisimple ↥(⊤ : Subgroup ↥(adjointGroup τ K)) :=
      CFSG.IsQuasisimple.of_mulEquiv
        (Subgroup.topEquiv :
          ↥(⊤ : Subgroup ↥(adjointGroup τ K)) ≃* ↥(adjointGroup τ K)) hqs_adj
    have hqs_topO : CFSG.Open.IsQuasisimple ↥(⊤ : Subgroup ↥(adjointGroup τ K)) :=
      ⟨hqs_top.1.commutator_eq_top, hqs_top.2.1⟩
    have hcomp : IsComponentOf (⊤ : Subgroup ↥(adjointGroup τ K))
        (Subgroup.centralizer ({b} : Set ↥(adjointGroup τ K))) := by
      rw [hcent]
      exact ⟨le_top, IsSubnormal.refl ⊤, hqs_topO⟩
    have hfield_top : GGCompFieldAt (Nat.card K) (⊤ : Subgroup ↥(adjointGroup τ K)) :=
      hB1 τ hτ K
    have hdvd : (Nat.card K) ^ 2 - 1 ∣ Nat.card ↥X := by
      have h1 : (Nat.card K) ^ 2 - 1 ∣ (Nat.card K ^ mi) ^ 2 - 1 :=
        sq_sub_one_dvd_pow_sq_sub_one (Nat.card K) mi
      have h2 : (Nat.card K ^ mi) ^ 2 - 1 ∣ Nat.card ↥X := by
        have h3 := hQdvd_i
        rw [hq] at h3
        exact h3
      exact h1.trans h2
    have hnorm_top : a ∈ Subgroup.normalizer (⊤ : Subgroup ↥(adjointGroup τ K)) := by
      rw [Subgroup.mem_normalizer_iff]
      intro x
      simp
    have hinn_top : ∃ k ∈ (⊤ : Subgroup ↥(adjointGroup τ K)),
        ∀ l ∈ (⊤ : Subgroup ↥(adjointGroup τ K)), a⁻¹ * l * a = k⁻¹ * l * k :=
      ⟨a, trivial, fun l _ => rfl⟩
    have hinner : GGInnerDiagOn (Subgroup.zpowers a) (⊤ : Subgroup ↥(adjointGroup τ K)) :=
      ggInnerDiagOn_of_fieldAt hqs_top hfield_top hnorm_top hinn_top
    exact ⟨⊤, CFSG.Assembly.isComponentOf_iff_open.2 hcomp, le_top,
      ⟨Nat.card K, 1, le_refl 1, by rw [pow_one], hdvd, hfield_top⟩, hinner⟩
  · have hb'ne : rootDiagUnit τ b' ≠ 1 := by
      intro h
      exact hb1 (hιinj (by rw [hb', h, map_one]))
    obtain ⟨j, -, hdiv, hle_ij⟩ := exists_orbit_of_kills S ha'_tor hb'_tor i hkills
    have hsmall : τ = .G2 → 5 ≤ p ∨ 4 ≤ S.D.q := by
      intro h
      rcases hτ with rfl | rfl <;> cases h
    have htame := CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.langSetup_hTame_of_prime
      S hp hpL hsmall hb'_tor hb'p hb'ne j
    have hqs_j : CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom b') j) := by
      rcases htame with h | h
      · exact h
      · exact absurd (langAsm_isSolvable_of_le hle_ij h)
          (langAsm_not_isSolvable_of_isQuasisimple hqs_i)
    set mj : ℕ := componentOrbitLength S.ρ (componentRoots (rootCharHom b') j) with hmj
    have hdiv' : mj ∣ mi := by rw [hmj, hmi]; exact hdiv
    have hfield_j : GGCompFieldAt (S.D.q ^ mj)
        (rationalComponent S.ρ S.Γ (rootCharHom b') j) := by
      rw [hmj]
      exact hB τ L p S hτ p hp hp2 b' hb'_tor hb'p hb'ne j hqs_j
    have hmj_pos : 1 ≤ mj := by
      rw [hmj]; exact (outer_componentOrbitLength_spec S hb'_tor j).1
    have hQdvd : (Nat.card K ^ mj) ^ 2 - 1 ∣ Nat.card ↥X := by
      obtain ⟨k, hk⟩ := hdiv'
      have h1 : (Nat.card K ^ mj) ^ 2 - 1 ∣ ((Nat.card K ^ mj) ^ k) ^ 2 - 1 :=
        sq_sub_one_dvd_pow_sq_sub_one (Nat.card K ^ mj) k
      have h2 : ((Nat.card K ^ mj) ^ k) ^ 2 - 1 = (Nat.card K ^ mi) ^ 2 - 1 := by
        rw [hk, pow_mul]
      have h3 : (Nat.card K ^ mi) ^ 2 - 1 ∣ Nat.card ↥X := by
        have h4 := hQdvd_i
        rw [hq] at h4
        exact h4
      rw [h2] at h1
      exact h1.trans h3
    let X' : Subgroup ↥(adjointGroup τ K) :=
      (rationalComponent S.ρ S.Γ (rootCharHom b') j).comap ι
    have hRj_range : rationalComponent S.ρ S.Γ (rootCharHom b') j ≤ ι.range := by
      rw [hιrange]
      exact (CFSG.HardMathSupport.Dickson.Sec6.Up34Exc.isComponentOf_rationalComponent
        S hb'_tor j hqs_j).1.trans inf_le_left
    have hX'_map : X'.map ι = rationalComponent S.ρ S.Γ (rootCharHom b') j :=
      Subgroup.map_comap_eq_self hRj_range
    let θ : ↥X' ≃* ↥(rationalComponent S.ρ S.Γ (rootCharHom b') j) :=
      (Subgroup.equivMapOfInjective X' ι hιinj).trans (MulEquiv.subgroupCongr hX'_map)
    have hQX' : GGCompFieldAt (Nat.card K ^ mj) X' := by
      have hfield_j' : GGCompFieldAt (S.D.q ^ mj) X' :=
        langAsm_ggCompFieldAt_congr hfield_j θ.symm
      rwa [hq] at hfield_j'
    have hXX' : X ≤ X' := by
      intro x hx
      change ι x ∈ rationalComponent S.ρ S.Γ (rootCharHom b') j
      have hxR : ι x ∈ rationalComponent S.ρ S.Γ (rootCharHom a') i := by
        rw [← hmap_i]
        exact Subgroup.mem_map_of_mem ι hx
      exact hle_ij hxR
    have hcomp_j : IsComponentOf (rationalComponent S.ρ S.Γ (rootCharHom b') j)
        (S.Γ ⊓ Subgroup.centralizer ({rootDiagUnit τ b'} : Set (ModGL τ L))) :=
      CFSG.HardMathSupport.Dickson.Sec6.Up34Exc.isComponentOf_rationalComponent
        S hb'_tor j hqs_j
    have hK_range : S.Γ ⊓ Subgroup.centralizer ({rootDiagUnit τ b'} : Set (ModGL τ L)) ≤
        ι.range := by rw [hιrange]; exact inf_le_left
    have hcomap : (S.Γ ⊓ Subgroup.centralizer
        ({rootDiagUnit τ b'} : Set (ModGL τ L))).comap ι =
        Subgroup.centralizer ({b} : Set ↥(adjointGroup τ K)) := by
      ext x
      rw [Subgroup.mem_comap, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff,
        Subgroup.mem_centralizer_singleton_iff]
      constructor
      · rintro ⟨-, hx⟩
        apply hιinj
        rw [map_mul, map_mul, hb']
        exact hx
      · intro hx
        refine ⟨?_, ?_⟩
        · rw [← hιrange]; exact MonoidHom.mem_range.2 ⟨x, rfl⟩
        · rw [← hb', ← map_mul, ← map_mul, hx]
    have hX'_comp : IsComponentOf X'
        (Subgroup.centralizer ({b} : Set ↥(adjointGroup τ K))) := by
      rw [← hcomap]
      exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.isComponentOf_comap_of_injective
        ι hιinj hRj_range hK_range hcomp_j
    have hQp : ¬ p ∣ (S.D.q ^ mj) ^ 2 - 1 := by
      rw [hq]
      intro h
      exact hpX (h.trans hQdvd)
    obtain ⟨k, hkR, hkconj⟩ :=
      hI τ L p S hτ hAlg p hp hp2 a' b' ha'_tor hb'_tor ha'p j hqs_j hQp
    obtain ⟨k', hk'X', hk'eq⟩ : ∃ k' ∈ X', ι k' = k := by
      have hkmap : k ∈ X'.map ι := by rw [hX'_map]; exact hkR
      exact Subgroup.mem_map.1 hkmap
    have hconj_l : ∀ l ∈ X', a⁻¹ * l * a = k'⁻¹ * l * k' := by
      intro l hl
      have hlR : ι l ∈ rationalComponent S.ρ S.Γ (rootCharHom b') j := by
        have : ι l ∈ X'.map ι := Subgroup.mem_map_of_mem ι hl
        rwa [hX'_map] at this
      have h1 := hkconj (ι l) hlR
      rw [← ha', ← hk'eq] at h1
      apply hιinj
      simpa only [map_mul, map_inv] using h1
    have h2conj : ∀ x ∈ X', a⁻¹ * x * a ∈ X' := by
      intro x hx
      rw [hconj_l x hx]
      exact X'.mul_mem (X'.mul_mem (X'.inv_mem hk'X') hx) hk'X'
    have hnorm' : a ∈ Subgroup.normalizer (X' : Set ↥(adjointGroup τ K)) := by
      have hmem : a⁻¹ ∈ Subgroup.normalizer (X' : Set ↥(adjointGroup τ K)) :=
        langAsm_mem_normalizer_of_conj_mem h2conj
      have := (Subgroup.normalizer (X' : Set ↥(adjointGroup τ K))).inv_mem hmem
      simpa using this
    have hqs_X' : CFSG.IsQuasisimple ↥X' := CFSG.IsQuasisimple.of_mulEquiv θ hqs_j
    have hinner : GGInnerDiagOn (Subgroup.zpowers a) X' :=
      ggInnerDiagOn_of_fieldAt hqs_X' hQX' hnorm' ⟨k', hk'X', hconj_l⟩
    exact ⟨X', CFSG.Assembly.isComponentOf_iff_open.2 hX'_comp, hXX',
      ⟨Nat.card K ^ mj, mj, hmj_pos, rfl, hQdvd, hQX'⟩, hinner⟩

theorem ggExcCompLiftRestInput_holds
    {τ : Tag} (hτ : τ = .E7 ∨ τ = .E8) (H : ℕ → ℕ → Prop) : GGExcCompLiftRestInput τ H :=
  ggExcCompLiftRestInput_of_model hτ H langRatCompKillsP_holds langRatCompInnerAct_holds
    langRatCompFieldLen_holds langFullFieldAt_holds

