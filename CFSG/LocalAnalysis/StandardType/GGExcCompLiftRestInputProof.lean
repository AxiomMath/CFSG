  ggE7NonsplitCoreRestInput_of_liftRest (ggExcCompLiftRestInput_holds (Or.inl rfl) GGE7LiftHyp)
    LangSeven.ggExcSevenTwoInput_E7_holds

theorem ggE8NonsplitCoreRestInput_holds
    : GGE8NonsplitCoreRestInput :=
  ggE8NonsplitCoreRestInput_of_liftRest (ggExcCompLiftRestInput_holds (Or.inr rfl) GGE8LiftHyp)
    LangSeven.ggExcSevenTwoInput_E8_holds

