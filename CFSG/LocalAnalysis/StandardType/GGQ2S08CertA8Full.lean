theorem a8f_adj : ∀ i : Fin 7, letAt a8fGens i =
    (Pi.single i.castSucc 1 - Pi.single i.succ 1, Pi.single i.castSucc 1 - Pi.single i.succ 1) := by
  decide +kernel

theorem a8f_test : ∀ A Mg : Subgroup (Vn 8 ≃ₗ[ZMod 3] Vn 8),
    TestHyp (Subgroup.closure (Set.range a8fS)) (oneN 8) A Mg →
    (∀ i j, (i, j) ∈ a8fGiven → ∀ (hi : (letAt a8fReps i).2 ⬝ᵥ (letAt a8fReps i).1 = 2)
      (hj : (letAt a8fReps j).2 ⬝ᵥ (letAt a8fReps j).1 = 2),
      refl (letAt a8fReps i).1 (letAt a8fReps i).2 hi ∈ Mg →
      refl (letAt a8fReps j).1 (letAt a8fReps j).2 hj ∈ A →
      refl (letAt a8fReps j).1 (letAt a8fReps j).2 hj ∈ Mg) →
    ∀ r ∈ Mg, IsRefl r → ¬ FixesLine (oneN 8) r →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (oneN 8) t → t ∈ Mg :=
  linTest_perm_of_certOKGiven a8fS a8fGens rfl (fun _ => rfl)
    (permGroup_le_of_gens a8fS a8fGens (fun _ => rfl) (by norm_num) a8f_adj)
    a8f_certOK a8f_cov

