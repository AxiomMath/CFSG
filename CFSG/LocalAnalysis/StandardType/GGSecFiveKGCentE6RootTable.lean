def e6CharCoords : List (List Nat) :=
  [0, 1, 2].flatMap fun a => [0, 1, 2].flatMap fun b => [0, 1, 2].flatMap fun c =>
    [0, 1, 2].flatMap fun d => [0, 1, 2].flatMap fun e => [0, 1, 2].map fun f =>
      [a, b, c, d, e, f]

def e6DotNat (x y : List Nat) : Nat := (List.zipWith (· * ·) x y).sum

def e6EdgeNat : List Nat → List Nat → Nat
  | [x0, x1, x2, x3, x4, x5], [y0, y1, y2, y3, y4, y5] =>
    x0 * y2 + x2 * y0 + x2 * y3 + x3 * y2 + x3 * y4 + x4 * y3 + x4 * y5 + x5 * y4 +
      x1 * y3 + x3 * y1
  | _, _ => 0

def e6KerTypeEdges : Nat → List (Nat × Nat)
  | 0 => [(0, 1), (1, 2), (2, 3), (3, 4)]
  | 1 => [(0, 1), (1, 2), (2, 3), (2, 4)]
  | 2 => [(0, 1), (1, 2), (2, 3)]
  | 3 => [(0, 1), (2, 3)]
  | _ => []

def e6KerTypeSize (t : Nat) : Nat := if t = 4 then 4 else 5

def e6KerTableIdx (c : Nat) : List Nat :=
  [c / 5 % 36, c / 180 % 36, c / 6480 % 36, c / 233280 % 36, c / 8398080 % 36]

def e6KerEntryOK (z : List Nat) (c : Nat) : Bool :=
  let t := c % 5
  let rs := ((e6KerTableIdx c).take (e6KerTypeSize t)).map fun i => e6PosRootCoords.getD i []
  rs.all (fun r => e6DotNat z r % 3 == 0) &&
    (List.range (e6KerTypeSize t)).all fun i => (List.range (e6KerTypeSize t)).all fun j =>
      !(decide (i < j)) ||
        2 * e6DotNat (rs.getD i []) (rs.getD j []) +
            (if (e6KerTypeEdges t).contains (i, j) then 1 else 0)
          == e6EdgeNat (rs.getD i []) (rs.getD j [])

def e6KerTableCheck : Bool :=
  e6CharCoords.length == 729 && e6KerRootTable.length == 729 &&
    (List.zip e6CharCoords e6KerRootTable).all fun p =>
      p.1 == [0, 0, 0, 0, 0, 0] || e6KerEntryOK p.1 p.2

theorem e6KerTableCheck_eq_true : e6KerTableCheck = true := by decide +kernel

