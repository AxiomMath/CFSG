section Roots


theorem ncard_kernelRoots_d4 {L : Type} [Field L] {ζ : Lˣ} (hζo : orderOf ζ = 3) (hζ : ζ ^ 3 = 1)
    {α β : Fin Tag.E6.rank → ℤ} (hα : IsRoot Tag.E6 α) (hβ : IsRoot Tag.E6 β)
    (hαβ : iform α β = 0) :
    (kernelRoots (rootCharHom (zetaVec ζ hζ (kgExpVec α + kgExpVec β)))).ncard = 24 := by
  have h1 : kernelRoots (rootCharHom (zetaVec ζ hζ (kgExpVec α + kgExpVec β))) =
      famKernel {zetaVec ζ hζ (kgExpVec α + kgExpVec β)} := by
    ext γ
    constructor
    · rintro ⟨hγ, h⟩
      exact ⟨hγ, fun b hb => by
        rw [Set.mem_singleton_iff] at hb
        subst hb
        exact h⟩
    · rintro ⟨hγ, h⟩
      exact ⟨hγ, h _ rfl⟩
  rw [h1, famKernel_kgExpVec_add hζo hζ α β]
  obtain ⟨u, hu⟩ := exists_weyl_smul_d4 hα hβ hαβ
  rw [← hu, Set.ncard_image_of_injective _ (MulAction.injective u)]
  have h24 : ((rootFinset Tag.E6).filter fun δ : Fin Tag.E6.rank → ℤ =>
      δ 0 = 0 ∧ δ 5 = 0).card = 24 :=
    (CFSG.SeitzReduction.TwistedE6Pilot.d4Perp_check).2
  have h2 : {γ : Fin Tag.E6.rank → ℤ | IsRoot Tag.E6 γ ∧ γ 0 = 0 ∧ γ 5 = 0} =
      ↑((rootFinset Tag.E6).filter fun δ : Fin Tag.E6.rank → ℤ => δ 0 = 0 ∧ δ 5 = 0) := by
    ext γ
    simp only [Set.mem_setOf_eq, Finset.coe_filter, mem_rootFinset]
  rw [h2, Set.ncard_coe_finset]
  exact h24

end Roots

section Setup


variable {K : Type} [Field K] [Finite K] {n : ℕ} {σ : K ≃+* K}
  {A : Subgroup (ModGL TwistTag.E6.tag K)}

theorem exists_ennolaSetup_five (hn : 1 ≤ n) (hK : Nat.card K = (2 ^ n) ^ 2)
    (hσ : ∀ c, σ c = c ^ 2 ^ n) (D : TwLangData K σ (2 ^ n) A) :
    ∃ S : LangSetup TwistTag.E6.tag (AlgebraicClosure K) 5,
      S.D = LangDatum.ofTwist TwistTag.E6 D.Fr (2 ^ n) D.hFr D.v D.hg0C D.hg0 := by
  haveI : CharP K 2 := CFSG.StandardType.charP_two_of_card (m := n * 2) (by rw [hK, pow_mul])
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  obtain ⟨ρ, hρ⟩ := frobeniusOnRoots_proved _ _
    (LangDatum.ofTwist TwistTag.E6 D.Fr (2 ^ n) D.hFr D.v D.hg0C D.hg0)
  refine ⟨LangDatum.toSetup _ 5 ρ hρ Nat.prime_five (Or.inl le_rfl)
    ⟨Nat.prime_two.isPrimePow.pow (by omega), ?_⟩ ?_
    (finite_model_twistedE6 Nat.prime_two hn hK hσ D.hFr _ rfl), rfl⟩
  · change ((2 ^ n : ℕ) : AlgebraicClosure K) = 0
    rw [Nat.cast_pow, Nat.cast_ofNat, CharTwo.two_eq_zero, zero_pow (by omega)]
  · intro h
    have := Nat.Prime.dvd_of_dvd_pow Nat.prime_five h
    omega

end Setup

section Layer


theorem exists_ggLayerOf_rationalComponent_d4 {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {p₀ : ℕ} (S : LangSetup Tag.E6 L p₀) {a : Fin Tag.E6.rank → Lˣ} (hap : ∀ i, a i ^ 3 = 1)
    (h1 : rootDiagUnit Tag.E6 a ≠ 1) (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hall : (kernelRoots (rootCharHom a)).ncard = 24)
    (hρ : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = -γ)
    (hE0 : ∃ E0 : Subgroup (ModGL Tag.E6 L), CFSG.IsQuasisimple E0 ∧
      E0 ≤ S.Γ ⊓ Subgroup.centralizer {rootDiagUnit Tag.E6 a}) :
    ∃ i : KernelComponent (rootCharHom a),
      GGLayerOf (S.Γ ⊓ Subgroup.centralizer {rootDiagUnit Tag.E6 a})
        (rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
  classical
  have h3 : ((3 : ℕ) : L) ≠ 0 := by
    rw [show ((3 : ℕ) : L) = 1 + 2 by norm_num, CharTwo.two_eq_zero, add_zero]
    exact one_ne_zero
  obtain ⟨γ0, hγ0⟩ := Set.nonempty_of_ncard_ne_zero (by rw [hall]; norm_num)
  let i : KernelComponent (rootCharHom a) := ⟦⟨γ0, hγ0⟩⟧
  refine ⟨i, ?_⟩
  have hone : ∀ j : KernelComponent (rootCharHom a),
      rationalRoots S.ρ (rootCharHom a) j = rationalRoots S.ρ (rootCharHom a) i := fun j => by
    rw [d4t2_class_subsingleton h3 hap hall j i]
  have hceq : componentRoots (rootCharHom a) i = kernelRoots (rootCharHom a) :=
    d4t2_class_eq_kernel h3 hap hall i
  have hfin : (componentRoots (rootCharHom a) i).Finite :=
    (KSNotAll24.finite_kernelRoots_E6 (rootCharHom a)).subset
      (KSNotAll24.componentRoots_subset_kernelRoots _ i)
  have hker := rho_mem_kernelRoots_of_mem_torus S hT
  have hρmem : ∀ γ ∈ componentRoots (rootCharHom a) i,
      S.ρ γ ∈ componentRoots (rootCharHom a) i := by
    intro γ hγ
    rw [hceq] at hγ ⊢
    exact hker γ hγ
  have hs1 : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1 :=
    componentOrbitLength_eq_one hfin hρmem
  have hin : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]) := by
    obtain ⟨_, w, m0, m1, m2, m3, m4, m5, -, hsum, -, hcl⟩ := TwE6UniqAbs.kac_class_data h3 hap
    obtain ⟨x, hx, hroots, hncard, -, -⟩ := hcl i
    have hc : (componentRoots (rootCharHom a) i).ncard = 24 := by rw [hceq]; exact hall
    have hD4 := d4t2in_cmpF_eq_sD4 hsum hx (hncard.symm.trans hc)
    have hneg := TwE6InnerAbs.twistInner_neg_D4 w⁻¹ (σ := fun γ => -γ) (fun _ => rfl)
    rw [hs1, Function.iterate_one, hroots, hD4]
    obtain ⟨u, hu, huγ⟩ := hneg
    refine ⟨u, hu, fun γ hγ => ?_⟩
    have hγr : IsRoot Tag.E6 γ := by
      rw [← hD4, ← hroots, hceq] at hγ
      exact hγ.1
    show S.ρ γ = u • γ
    rw [hρ γ hγr]
    exact huγ γ hγ
  have hk : twistKind S.ρ (rootCharHom a) i = .inner := by
    unfold twistKind
    rw [if_pos hin]
  have hTp : rootDiagUnit Tag.E6 a ^ 3 = 1 := rootDiagUnit_pow_eq_one_of_forall hap
  have hqs : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
    rcases langSetup_tame_inner_of_prime S Nat.prime_three (fun h => absurd h (by decide)) hT hTp
      h1 i hk with hq | hsolv
    · exact hq
    · exfalso
      obtain ⟨E0, hE0q, hE0X⟩ := hE0
      have hperf : ⁅E0, E0⁆ = E0 := Subgroup.isPerfect_iff.mp hE0q.1
      have hle : E0 ≤ rationalComponent S.ρ S.Γ (rootCharHom a) i :=
        LangRat.perfect_le_rationalComponent_of_single_orbit S Nat.prime_three hT hap i hone
          E0 hE0X hperf
      haveI : Group.IsSolvable (rationalComponent S.ρ S.Γ (rootCharHom a) i) := hsolv
      haveI : Group.IsSolvable E0 :=
        solvable_of_solvable_injective (Subgroup.inclusion_injective hle)
      obtain ⟨x, y, hxy⟩ := hE0q.2.2
      obtain ⟨x', rfl⟩ := QuotientGroup.mk_surjective x
      obtain ⟨y', rfl⟩ := QuotientGroup.mk_surjective y
      haveI : Nontrivial E0 := ⟨⟨x', y', fun h => hxy (by rw [h])⟩⟩
      exact (Group.IsSolvable.commutator_lt_top_of_nontrivial E0).ne
        (Group.isPerfect_def.mp hE0q.1)
  exact LangRat.ggLayerOf_langCentralizer_of_single_orbit S Nat.prime_three hT hap i hone hqs

end Layer

