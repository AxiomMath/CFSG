section Transport

variable {G : Type} [Group G] {U : Type*} [Group U]

theorem range_inf_centralizer_of_injective {ψ : U →* G} (hψ : Function.Injective ψ) (y : U) :
    ψ.range ⊓ centralizer {ψ y} = (centralizer {y}).map ψ := by
  apply le_antisymm
  · rintro _ ⟨⟨B, rfl⟩, hB⟩
    have hB' : ψ B * ψ y = ψ y * ψ B := mem_centralizer_singleton_iff.mp hB
    exact ⟨B, mem_centralizer_singleton_iff.mpr (hψ (by rw [map_mul, map_mul, hB'])), rfl⟩
  · rintro _ ⟨B, hB, rfl⟩
    refine mem_inf.mpr ⟨⟨B, rfl⟩, ?_⟩
    have hB' : B * y = y * B := mem_centralizer_singleton_iff.mp hB
    rw [mem_centralizer_singleton_iff, ← map_mul, hB', map_mul]

theorem derivedAt_congr {p : ℕ} {G₀ : Subgroup G} {r r' : G}
    (h : G₀ ⊓ centralizer {r} = G₀ ⊓ centralizer {r'}) :
    GGRootCentDerivedAt p G₀ r ↔ GGRootCentDerivedAt p G₀ r' := by
  unfold GGRootCentDerivedAt
  rw [show ggRCSX G₀ r = ggRCSX G₀ r' by rw [ggRCSX, ggRCSX, h],
    show ggRCSXd G₀ r = ggRCSXd G₀ r' by rw [ggRCSXd, ggRCSXd, ggRCSX, ggRCSX, h]]

theorem comp_conj_injective {ψ : U →* G} (hψ : Function.Injective ψ) (h : U) :
    Function.Injective (ψ.comp (MulAut.conj h).toMonoidHom) :=
  hψ.comp (MulEquiv.injective _)

theorem range_comp_conj (ψ : U →* G) (h : U) :
    (ψ.comp (MulAut.conj h).toMonoidHom).range = ψ.range := by
  rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr (MulEquiv.surjective _),
    ← MonoidHom.range_eq_map]

end Transport

section Roots

variable {F : Type} [Field F] [CharP F 2] {n : ℕ}

theorem elt_one_eq_conj (ρ : TauCeti.GLSymplecticFin.RootSubgroupIndex n) :
    (∃ (g : StatedSp n F) (i : Fin n), elt ρ (1 : F) = g * siegDiag F i 1 * g⁻¹) ∨
      (∃ (g : StatedSp n F) (i j : Fin n), i ≠ j ∧
        elt ρ (1 : F) = g * twoCentralElt n i j (0 : F) 1 * g⁻¹) := by
  cases ρ with
  | positiveLong i => exact Or.inl ⟨1, i, by rw [elt_positiveLong_one]; group⟩
  | negativeLong i =>
    exact Or.inl ⟨_, i, by rw [elt_negativeLong_one, cj_eq_conj]⟩
  | difference i j hij =>
    exact Or.inr ⟨_, i, j, hij, by rw [elt_difference_one hij, cj_eq_conj]⟩
  | positiveSum i j hij =>
    exact Or.inr ⟨1, i, j, hij.ne, by rw [elt_positiveSum_one hij]; group⟩
  | negativeSum i j hij =>
    refine Or.inr ⟨(permSp (K := F) _ (swap_plane_mem_Hp i))⁻¹ *
      (permSp (K := F) _ (swap_plane_mem_Hp j))⁻¹, i, j, hij.ne, ?_⟩
    rw [elt_negativeSum_one hij, cj_eq_conj, elt_difference_one hij.ne, cj_eq_conj]
    group

end Roots

section Derived

variable {G : Type} [Group G] [Finite G]

theorem derivedAt_of_sup {U : Type*} [Group U] {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {G₀ : Subgroup G} {r : G} (ψ : U →* G) (hψ : Function.Injective ψ)
    {QU LU L₀ : Subgroup U} (hX : ggRCSX G₀ r = (QU ⊔ LU).map ψ) (hQ2 : IsPGroup 2 QU)
    (hLQ : LU ≤ normalizer (QU : Set U)) (hL₀L : L₀ ≤ LU) (hL₀ : CFSG.IsQuasisimple L₀)
    (hY : ⁅LU, LU⁆ ≤ L₀) (hcov : ∀ c ∈ QU ⊔ LU, c ^ p = 1 → c ∈ QU ⊔ L₀) :
    GGRootCentDerivedAt p G₀ r := by
  have hXQ : ggRCSX G₀ r ≤ normalizer ((QU.map ψ : Subgroup G) : Set G) := by
    rw [hX]
    exact ggRCST_map_le_normalizer ψ (sup_le le_normalizer hLQ)
  have hsup : (QU ⊔ L₀).map ψ = QU.map ψ ⊔ L₀.map ψ := map_sup _ _ _
  refine ggRootCentDerivedAt_of_quasisimple hp hp2 (by rw [hX]; exact map_mono le_sup_left)
    (hQ2.map ψ) hXQ (by rw [hX]; exact map_mono (hL₀L.trans le_sup_right))
    (CFSG.LocalCores.isQuasisimple_of_mulEquiv (L₀.equivMapOfInjective ψ hψ) hL₀) ?_ ?_
  · refine (CFSG.Quasithin.perfectCore_le_derivedSeriesOf _ 1).trans ?_
    change ⁅ggRCSX G₀ r, ggRCSX G₀ r⁆ ≤ _
    rw [hX, ← map_commutator, ← hsup]
    exact map_mono ((commutator_sup_le_sup_commutator_of_le_normalizer hLQ).trans
      (sup_le_sup_left hY QU))
  · intro y hy hyp
    rw [hX] at hy
    obtain ⟨c, hc, rfl⟩ := hy
    rw [← hsup]
    exact mem_map_of_mem ψ (hcov c hc (hψ (by rw [map_pow, hyp, map_one])))

theorem pow_mul_inv_mem {U : Type*} [Group U] {Q : Subgroup U} {q l : U} (hq : q ∈ Q)
    (hl : l ∈ normalizer (Q : Set U)) (k : ℕ) : (q * l) ^ k * (l ^ k)⁻¹ ∈ Q := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hlk : l ^ k ∈ normalizer (Q : Set U) := pow_mem hl k
    have h2 : l ^ k * q * (l ^ k)⁻¹ ∈ Q := (mem_normalizer_iff.mp hlk q).mp hq
    have e : (q * l) ^ (k + 1) * (l ^ (k + 1))⁻¹ =
        ((q * l) ^ k * (l ^ k)⁻¹) * (l ^ k * q * (l ^ k)⁻¹) := by
      rw [pow_succ, pow_succ]
      group
    rw [e]
    exact mul_mem ih h2

omit [Finite G] in
theorem pow_eq_one_of_mul {U : Type*} [Group U] {Q L : Subgroup U}
    (hLQ : L ≤ normalizer (Q : Set U)) (hdisj : Disjoint Q L) {q l : U} (hq : q ∈ Q) (hl : l ∈ L)
    {p : ℕ} (h : (q * l) ^ p = 1) : l ^ p = 1 := by
  have h1 := pow_mul_inv_mem hq (hLQ hl) p
  rw [h, one_mul] at h1
  have h2 : l ^ p ∈ Q := by simpa using Q.inv_mem h1
  exact (Subgroup.disjoint_def.mp hdisj) h2 (pow_mem hl p)

variable {F : Type} [Field F] [Finite F] [CharP F 2]

omit [Finite G] in
theorem ggRCSX_eq_map_centralizer {U : Type*} [Group U] (ψ : U →* G) (hψ : Function.Injective ψ)
    {x : U} (hgen : centralizer {x} ≤ ggOTwoPrime (centralizer {x})) :
    ggRCSX ψ.range (ψ x) = (centralizer {x}).map ψ := by
  change ggOTwoPrime (ψ.range ⊓ centralizer {ψ x}) = _
  rw [range_inf_centralizer_of_injective hψ]
  exact le_antisymm (ggOTwoPrime_le _)
    ((map_mono hgen).trans (LinFusion.map_ggOTwoPrime_le ψ _))

theorem derivedAt_long {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {m : ℕ}
    (hm : (1 ≤ m ∧ 4 ≤ Nat.card F) ∨ 3 ≤ m) (ψ : StatedSp (m + 1) F →* G)
    (hψ : Function.Injective ψ) (i : Fin (m + 1)) :
    GGRootCentDerivedAt p ψ.range (ψ (siegDiag F i 1)) := by
  have hX : ggRCSX ψ.range (ψ (siegDiag F i 1)) = (transvRadical F i ⊔ complSp F i).map ψ := by
    rw [ggRCSX_eq_map_centralizer ψ hψ (centralizer_siegDiag_le_ggOTwoPrime i),
      centralizer_siegDiag_eq_sup]
  have hq2 : 2 ≤ Nat.card F := Finite.one_lt_card
  have hSp : CFSG.IsQuasisimple (StatedSp m F) := by
    refine CFSG.LieType.Universal.Symplectic.isQuasisimple m F (by omega) ?_
    rcases hm with ⟨-, h4⟩ | h3
    · exact Or.inl (Or.inr h4)
    · rcases Nat.lt_or_ge (Nat.card F) 4 with h | h
      · have hF2 : Nat.card F = 2 := by
          have : Fintype F := Fintype.ofFinite F
          obtain ⟨k, -, hk⟩ := FiniteField.card F 2
          rw [Nat.card_eq_fintype_card] at h hq2 ⊢
          rw [hk] at h hq2 ⊢
          have hk1 : (k : ℕ) < 2 := by
            by_contra hk2
            push Not at hk2
            have : 2 ^ 2 ≤ 2 ^ (k : ℕ) := Nat.pow_le_pow_right (by norm_num) hk2
            omega
          have : (k : ℕ) = 1 := by have := k.ne_zero; omega
          rw [this, pow_one]
        exact Or.inr (Or.inr ⟨hF2, h3⟩)
      · exact Or.inl (Or.inr h)
  exact derivedAt_of_sup hp hp2 ψ hψ hX isPGroup_transvRadical complSp_le_normalizer_transvRadical
    le_rfl (CFSG.LocalCores.isQuasisimple_of_mulEquiv (complSpEquiv i) hSp)
    (CFSG.Quasithin.A3.commutator_self_le _) fun c hc _ => hc

theorem derivedAt_long_six {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hF : Nat.card F = 2)
    (ψ : StatedSp (2 + 1) F →* G) (hψ : Function.Injective ψ) (i : Fin (2 + 1)) :
    GGRootCentDerivedAt p ψ.range (ψ (siegDiag F i 1)) := by
  have hX : ggRCSX ψ.range (ψ (siegDiag F i 1)) = (transvRadical F i ⊔ complSp F i).map ψ := by
    rw [ggRCSX_eq_map_centralizer ψ hψ (centralizer_siegDiag_le_ggOTwoPrime i),
      centralizer_siegDiag_eq_sup]
  set e : ↥(complSp F i) ≃* CFSG.ComponentClassification.PresentationLocal.sympFour :=
    (complSpEquiv i).symm.trans (CFSG.SeitzReduction.F4Pilot.sp4EquivSympFour hF) with he
  obtain ⟨hq, hodd⟩ := CFSG.RankThree.PartOne.derived_of_mulEquiv_sympFour e
  have hmap : (commutator ↥(complSp F i)).map (complSp F i).subtype =
      ⁅complSp F i, complSp F i⁆ := Subgroup.map_subtype_commutator _
  have hL₀ : CFSG.IsQuasisimple ↥⁅complSp F i, complSp F i⁆ :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      (((commutator ↥(complSp F i)).equivMapOfInjective (complSp F i).subtype
        (Subgroup.subtype_injective _)).trans (MulEquiv.subgroupCongr hmap)) hq
  refine derivedAt_of_sup hp hp2 ψ hψ hX isPGroup_transvRadical
    complSp_le_normalizer_transvRadical (CFSG.Quasithin.A3.commutator_self_le _) hL₀ le_rfl ?_
  intro c hc hcp
  have hc' : c ∈ ((transvRadical F i ⊔ complSp F i : Subgroup (StatedSp (2 + 1) F)) :
      Set (StatedSp (2 + 1) F)) := hc
  rw [coe_mul_of_right_le_normalizer_left _ _ complSp_le_normalizer_transvRadical] at hc'
  obtain ⟨q, hq, l, hl, rfl⟩ := hc'
  have hlp := pow_eq_one_of_mul complSp_le_normalizer_transvRadical
    disjoint_transvRadical_complSp hq hl hcp
  have hl' := hodd hp hp2 ⟨l, hl⟩ (Subtype.ext (by simpa using hlp))
  rw [← hmap]
  exact mul_mem (mem_sup_left hq) (mem_sup_right ⟨⟨l, hl⟩, hl', rfl⟩)

omit [Finite F] [CharP F 2] in
theorem suppGroup_offPQ_two {i j : Fin 2} (hij : i ≠ j) :
    suppGroup {t : Fin 2 ⊕ Fin 2 | OffPQ i j t} = (⊥ : Subgroup (StatedSp 2 F)) := by
  have hoff : ∀ t : Fin 2 ⊕ Fin 2, ¬ OffPQ i j t := by
    have hk : ∀ k : Fin 2, k = i ∨ k = j := by
      intro k
      fin_cases i <;> fin_cases j <;> fin_cases k <;> simp_all
    rintro (k | k) ⟨h1, h2⟩
    · rcases hk k with rfl | rfl
      · exact h1 (inl_mem_coords _)
      · exact h2 (inl_mem_coords _)
    · rcases hk k with rfl | rfl
      · exact h1 (inr_mem_coords _)
      · exact h2 (inr_mem_coords _)
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot]
  apply mat_injective
  rw [map_one]
  ext r t
  exact hx r t fun h => hoff r h.1

theorem derivedAt_short_two {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hF4 : 4 ≤ Nat.card F)
    (ψ : StatedSp 2 F →* G) (hψ : Function.Injective ψ) {i j : Fin 2} (hij : i ≠ j) :
    GGRootCentDerivedAt p ψ.range (ψ (twoCentralElt 2 i j 0 1)) := by
  have hC : centralizer ({twoCentralElt 2 i j (0 : F) 1} : Set (StatedSp 2 F)) =
      wRadical F i j ⊔ (shortBlock F hij).range := by
    refine le_antisymm ?_ (sup_le (wRadical_le_centralizer_twoCentralElt 0 1) ?_)
    · have h := centralizer_a2_le_of_ne (K := F) hij
      rwa [suppGroup_offPQ_two hij, sup_bot_eq] at h
    · rintro _ ⟨A, rfl⟩
      exact shortBlock_mem_centralizer hij A 1
  have hX : ggRCSX ψ.range (ψ (twoCentralElt 2 i j 0 1)) =
      (wRadical F i j ⊔ (shortBlock F hij).range).map ψ := by
    rw [ggRCSX_eq_map_centralizer ψ hψ (centralizer_twoCentralElt_le_ggOTwoPrime hij), hC]
  have hCN : centralizer ({twoCentralElt 2 i j (0 : F) 1} : Set (StatedSp 2 F)) ≤
      normalizer (wRadical F i j : Set (StatedSp 2 F)) := by
    rw [centralizer_twoCentralElt_eq_sup hij (one_ne_zero (α := F))]
    exact sup_le le_normalizer (range_leviHom_le_normalizer_wRadical hij one_ne_zero)
  have hLQ : (shortBlock F hij).range ≤ normalizer (wRadical F i j : Set (StatedSp 2 F)) := by
    rw [hC] at hCN
    exact le_sup_right.trans hCN
  have hSL : CFSG.IsQuasisimple (shortBlock F hij).range :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv (MonoidHom.ofInjective (shortBlock_injective hij))
      (CFSG.SeitzReduction.LinearPilot.isQuasisimple_specialLinearGroup_of_le le_rfl
        (Or.inr hF4))
  exact derivedAt_of_sup hp hp2 ψ hψ hX (isPGroup_wRadical hij) hLQ le_rfl hSL
    (CFSG.Quasithin.A3.commutator_self_le _) fun c hc _ => hc

theorem derivedAt_long_all {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {n f : ℕ}
    (hF : Nat.card F = 2 ^ f) (hn : 2 ≤ n) (hnf : (n, 2 ^ f) ≠ (2, 2))
    (ψ : StatedSp n F →* G) (hψ : Function.Injective ψ) (i : Fin n) :
    GGRootCentDerivedAt p ψ.range (ψ (siegDiag F i 1)) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with rfl | h
    · have := Finite.one_lt_card (α := F)
      rw [hF] at this
      norm_num at this
    · exact h
  by_cases hq : 4 ≤ Nat.card F ∨ 3 ≤ m
  · refine derivedAt_long hp hp2 ?_ ψ hψ i
    rcases hq with h | h
    · exact Or.inl ⟨by omega, h⟩
    · exact Or.inr h
  · push Not at hq
    have hF2 : Nat.card F = 2 := by
      rw [hF] at hq ⊢
      have : f < 2 := by
        by_contra hf2
        push Not at hf2
        have : 2 ^ 2 ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf2
        omega
      have : f = 1 := by omega
      rw [this, pow_one]
    have hm2 : m = 2 := by
      have h1 : m ≠ 1 := by
        rintro rfl
        have h2f : 2 ^ f = 2 := hF.symm.trans hF2
        rw [h2f] at hnf
        exact hnf rfl
      omega
    subst hm2
    exact derivedAt_long_six hp hp2 hF2 ψ hψ i

end Derived

section Short

variable {F : Type} [Field F]

omit [Field F] in
theorem leviTv_eq_elt [Field F] {n : ℕ} {i j : Fin n} (hij : i ≠ j) (c : F) :
    leviTv F hij c = elt (.difference i j hij) c := by
  apply mat_injective
  rw [mat_leviTv, coe_transvectionUnit_inv_transpose, mat_elt]
  ext r t
  rcases r with a | a <;> rcases t with b | b <;>
    simp [E, Matrix.transvection, Matrix.one_apply, Matrix.single_apply, sub_eq_add_neg]
  split_ifs <;> simp

omit [Field F] in
theorem leviTv_mem_range_shortBlock [Field F] {n : ℕ} {i j : Fin n} (hij : i ≠ j) (c : F) :
    leviTv F hij c ∈ (shortBlock F hij).range ∧ leviTv F hij.symm c ∈ (shortBlock F hij).range :=
  ⟨⟨CFSG.LieType.Steinberg.sl2Upper c, by rw [shortBlock_sl2Upper, leviTv_eq_elt]⟩,
    ⟨CFSG.LieType.Steinberg.sl2Lower c, by rw [shortBlock_sl2Lower, leviTv_eq_elt]⟩⟩

variable {n : ℕ}

theorem wRadical_le_commutator_shortBlock :
    wRadical F (1 : Fin (n + 3)) 2 ≤
      ⁅wRadical F (1 : Fin (n + 3)) 2 ⊔ (shortBlock F (one_ne_two_fin (n := n))).range,
        wRadical F (1 : Fin (n + 3)) 2 ⊔ (shortBlock F (one_ne_two_fin (n := n))).range⁆ := by
  set P := wRadical F (1 : Fin (n + 3)) 2 ⊔ (shortBlock F (one_ne_two_fin (n := n))).range
    with hP
  have h12 : (1 : Fin (n + 3)) ≠ 2 := one_ne_two_fin
  have h0 : (0 : Fin (n + 3)) ≠ 1 := by simp
  have h0' : (0 : Fin (n + 3)) ≠ 2 := by
    intro h
    have h' := congrArg Fin.val h
    rw [Fin.val_zero, Fin.val_two] at h'
    omega
  have hQP : wRadical F (1 : Fin (n + 3)) 2 ≤ P := le_sup_left
  have hLP : (shortBlock F h12).range ≤ P := le_sup_right
  have hL12 : ∀ c : F, leviTv F h12 c ∈ P := fun c => hLP (leviTv_mem_range_shortBlock h12 c).1
  have hL21 : ∀ c : F, leviTv F h12.symm c ∈ P := fun c =>
    hLP (leviTv_mem_range_shortBlock h12 c).2
  have hP12 : ∀ c : F, siegPair F (1 : Fin (n + 3)) 2 c ∈ ⁅P, P⁆ := by
    intro c
    have e := commutatorElement_leviTv_siegPair (Ne.symm h0) (Ne.symm h0') c 1
    rw [mul_one] at e
    rw [← e]
    refine commutator_mem_commutator
      (hQP (leviTv_mem_wRadical h12 (Ne.symm h0) (Or.inl rfl) h0 h0' c)) (hQP ?_)
    rw [siegPair_comm]
    exact siegPair_mem_wRadical (Or.inr rfl) _
  have hD1 : ∀ c : F, siegDiag F (1 : Fin (n + 3)) c ∈ ⁅P, P⁆ := by
    intro c
    have e := commutatorElement_leviTv_siegDiag h12 1 c
    rw [one_mul, one_mul, one_mul] at e
    have h1 : ⁅leviTv F h12 1, siegDiag F 2 c⁆ ∈ ⁅P, P⁆ :=
      commutator_mem_commutator (hL12 1) (hQP (siegDiag_mem_wRadical (Or.inr rfl) c))
    rw [e] at h1
    have h2 := Subgroup.mul_mem _ (Subgroup.inv_mem _ (hP12 c)) h1
    rwa [inv_mul_cancel_left] at h2
  have hD2 : ∀ c : F, siegDiag F (2 : Fin (n + 3)) c ∈ ⁅P, P⁆ := by
    intro c
    have e := commutatorElement_leviTv_siegDiag h12.symm 1 c
    rw [one_mul, one_mul, one_mul, siegPair_comm] at e
    have h1 : ⁅leviTv F h12.symm 1, siegDiag F 1 c⁆ ∈ ⁅P, P⁆ :=
      commutator_mem_commutator (hL21 1) (hQP (siegDiag_mem_wRadical (Or.inl rfl) c))
    rw [e] at h1
    have h2 := Subgroup.mul_mem _ (Subgroup.inv_mem _ (hP12 c)) h1
    rwa [inv_mul_cancel_left] at h2
  have hL : ∀ (i j : Fin (n + 3)) (hij : i ≠ j), (i = 1 ∨ i = 2) → j ≠ 1 → j ≠ 2 → ∀ c : F,
      leviTv F hij c ∈ ⁅P, P⁆ := by
    intro i j hij hi hj1 hj2 c
    rcases hi with rfl | rfl
    · have e := commutatorElement_leviTv_leviTv h12 (Ne.symm hj2) hij c 1
      rw [mul_one] at e
      rw [← e]
      exact commutator_mem_commutator (hL12 c)
        (hQP (leviTv_mem_wRadical h12 (Ne.symm hj2) (Or.inr rfl) hj1 hj2 1))
    · have e := commutatorElement_leviTv_leviTv h12.symm (Ne.symm hj1) hij c 1
      rw [mul_one] at e
      rw [← e]
      exact commutator_mem_commutator (hL21 c)
        (hQP (leviTv_mem_wRadical h12 (Ne.symm hj1) (Or.inl rfl) hj1 hj2 1))
  have hS : ∀ (i j : Fin (n + 3)), (i = 1 ∨ i = 2) → j ≠ 1 → j ≠ 2 → ∀ c : F,
      siegPair F i j c ∈ ⁅P, P⁆ := by
    intro i j hi hj1 hj2 c
    rcases hi with rfl | rfl
    · have e := commutatorElement_leviTv_siegPair h12 hj2 c 1
      rw [mul_one] at e
      rw [← e]
      exact commutator_mem_commutator (hL12 c) (hQP (siegPair_mem_wRadical (Or.inr rfl) _))
    · have e := commutatorElement_leviTv_siegPair h12.symm hj1 c 1
      rw [mul_one] at e
      rw [← e]
      exact commutator_mem_commutator (hL21 c) (hQP (siegPair_mem_wRadical (Or.inl rfl) _))
  exact wRadical_le_of_forall_mem h12 hD1 hD2 hP12 hL hS

omit [Field F] in
theorem sumCongr_mem_Hp (σ : Equiv.Perm (Fin n)) : Equiv.sumCongr σ σ ∈ Hp n := by
  intro a
  rcases a with a | a <;> rfl

theorem cj_sumCongr_twoCentralElt [CharP F 2] (σ : Equiv.Perm (Fin n)) {i j k l : Fin n}
    (hk : σ k = i) (hl : σ l = j) :
    cj (sumCongr_mem_Hp σ) (twoCentralElt n i j (0 : F) 1) = twoCentralElt n k l 0 1 := by
  apply mat_injective
  ext a b
  rw [CFSG.RankThree.PartOne.KFCL.Sp.mat_cj_apply, mat_twoCentralElt_eq_add,
    mat_twoCentralElt_eq_add, ← hk, ← hl]
  rcases a with a | a <;> rcases b with b | b <;>
    simp [Matrix.one_apply, Matrix.single_apply, σ.injective.eq_iff]

theorem exists_perm_one_two {i j : Fin (n + 3)} (hij : i ≠ j) :
    ∃ σ : Equiv.Perm (Fin (n + 3)), σ 1 = i ∧ σ 2 = j := by
  refine ⟨Equiv.swap i 1 * Equiv.swap (Equiv.swap i 1 j) 2, ?_, ?_⟩
  · have h1 : Equiv.swap i 1 j ≠ 1 := by
      intro h
      rw [Equiv.swap_apply_eq_iff, Equiv.swap_apply_right] at h
      exact hij h.symm
    simp only [Equiv.Perm.mul_apply]
    rw [Equiv.swap_apply_of_ne_of_ne (Ne.symm h1) one_ne_two_fin, Equiv.swap_apply_right]
  · simp only [Equiv.Perm.mul_apply, Equiv.swap_apply_right, Equiv.swap_apply_self]

theorem exists_conj_one_two [CharP F 2] {i j : Fin (n + 3)} (hij : i ≠ j) :
    ∃ g : StatedSp (n + 3) F,
      twoCentralElt (n + 3) i j (0 : F) 1 = g * twoCentralElt (n + 3) 1 2 0 1 * g⁻¹ := by
  obtain ⟨σ, h1, h2⟩ := exists_perm_one_two hij
  refine ⟨permSp _ (sumCongr_mem_Hp σ), ?_⟩
  have h := cj_sumCongr_twoCentralElt (F := F) σ h1 h2
  rw [← h, CFSG.RankThree.PartOne.KFCL.Sp.cj]
  group

variable [Finite F] [CharP F 2] {G : Type} [Group G] [Finite G]

theorem layer_short_std (hK : 4 ≤ Nat.card F) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (ψ : StatedSp (n + 3) F →* G) (hψ : Function.Injective ψ) {M : Subgroup G}
    (hG₀M : ψ.range ≤ M) (hM : M ≤ normalizer (ψ.range : Set G)) {r : G}
    (hr : ψ.range ⊓ centralizer {r} =
      ψ.range ⊓ centralizer {ψ (twoCentralElt (n + 3) 1 2 (0 : F) 1)}) :
    GGRCSLayer p ψ.range M r := by
  have h12 := one_ne_two_fin (n := n)
  set QW := wRadical F (1 : Fin (n + 3)) 2 with hQW
  set S := (shortBlock F h12).range with hS
  set T := spCompl12 F n with hT
  have hC : centralizer ({twoCentralElt (n + 3) 1 2 (0 : F) 1} : Set (StatedSp (n + 3) F)) =
      QW ⊔ (S ⊔ T) := (perfectCore_centralizer_a2 hK).2
  have hX : ggRCSX ψ.range r = (QW ⊔ (S ⊔ T)).map ψ := by
    change ggOTwoPrime (ψ.range ⊓ centralizer {r}) = _
    rw [hr]
    change ggRCSX ψ.range (ψ (twoCentralElt (n + 3) 1 2 0 1)) = _
    rw [ggRCSX_eq_map_centralizer ψ hψ (centralizer_twoCentralElt_le_ggOTwoPrime h12), hC]
  have hCN : centralizer ({twoCentralElt (n + 3) 1 2 (0 : F) 1} : Set (StatedSp (n + 3) F)) ≤
      normalizer (QW : Set (StatedSp (n + 3) F)) := by
    rw [centralizer_twoCentralElt_eq_sup h12 (one_ne_zero (α := F))]
    exact sup_le le_normalizer (range_leviHom_le_normalizer_wRadical h12 one_ne_zero)
  have hSQ : S ≤ normalizer (QW : Set (StatedSp (n + 3) F)) :=
    (hC ▸ (le_sup_left.trans le_sup_right : S ≤ QW ⊔ (S ⊔ T))).trans hCN
  have hTQ : T ≤ normalizer (QW : Set (StatedSp (n + 3) F)) :=
    (hC ▸ (le_sup_right.trans le_sup_right : T ≤ QW ⊔ (S ⊔ T))).trans hCN
  have hQ2 : IsPGroup 2 (QW.map ψ) := (isPGroup_wRadical h12).map ψ
  have hO2 : CFSG.Assembly.pCoreOf 2 (ggRCSX ψ.range r) = QW.map ψ := by
    rw [hX, Subgroup.map_sup]
    refine ggRCST_pCoreOf_eq rfl hQ2 (ggRCST_map_le_normalizer ψ (sup_le hSQ hTQ)) ?_
    intro N hNM hN2 hMN
    set N' : Subgroup ↥(a2Levi F n) := (N.comap ψ).subgroupOf (a2Levi F n) with hN'
    have hN'n : N'.Normal := by
      refine ⟨fun x hx g => ?_⟩
      rw [hN', Subgroup.mem_subgroupOf, Subgroup.mem_comap] at hx ⊢
      have hg : ψ (g : StatedSp (n + 3) F) ∈ (S ⊔ T).map ψ := ⟨g, g.2, rfl⟩
      have := (Subgroup.mem_normalizer_iff.mp (hMN hg) (ψ x)).mp hx
      simpa using this
    have hN'2 : IsPGroup 2 N' := by
      rintro ⟨x, hx⟩
      rw [hN', Subgroup.mem_subgroupOf, Subgroup.mem_comap] at hx
      obtain ⟨k, hk⟩ := hN2 ⟨_, hx⟩
      refine ⟨k, Subtype.ext (Subtype.ext ?_)⟩
      apply hψ
      have := congrArg Subtype.val hk
      simpa using this
    have hbot := eq_bot_of_normal_of_isPGroup_a2Levi hK N' hN'2
    rw [eq_bot_iff]
    intro y hy
    obtain ⟨a, ha, rfl⟩ := hNM hy
    have haN : (⟨a, ha⟩ : ↥(a2Levi F n)) ∈ N' := by
      rw [hN', Subgroup.mem_subgroupOf, Subgroup.mem_comap]
      exact hy
    rw [hbot, Subgroup.mem_bot] at haN
    have : a = 1 := congrArg Subtype.val haN
    rw [this, map_one]
    exact one_mem _
  have hcomm : S.map ψ ≤ centralizer ((T.map ψ : Subgroup G) : Set G) := by
    rintro _ ⟨_, ⟨A, rfl⟩, rfl⟩
    rw [mem_centralizer_iff]
    rintro _ ⟨t, ht, rfl⟩
    have ht' : t ∈ suppGroup {t : Fin (n + 3) ⊕ Fin (n + 3) | ¬ OffPQ 1 2 t}ᶜ := by
      have : {t : Fin (n + 3) ⊕ Fin (n + 3) | ¬ OffPQ 1 2 t}ᶜ = {t | OffPQ 1 2 t} := by
        ext t
        simp
      rw [this, ← spCompl12_eq_suppGroup]
      exact ht
    have hc := (commute_suppGroup_compl (shortBlock_mem_suppGroup (n := n) A) ht').eq
    rw [← map_mul, ← map_mul, hc]
  have hSq : CFSG.IsQuasisimple (S.map ψ) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      ((MonoidHom.ofInjective (shortBlock_injective h12)).trans (S.equivMapOfInjective ψ hψ))
      (CFSG.SeitzReduction.LinearPilot.isQuasisimple_specialLinearGroup_of_le le_rfl (Or.inr hK))
  have hTq : CFSG.IsQuasisimple (T.map ψ) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      ((spCompl12Equiv F n).trans (T.equivMapOfInjective ψ hψ))
      (CFSG.LieType.Universal.Symplectic.isQuasisimple (n + 1) F (by omega) (Or.inl (Or.inr hK)))
  refine ggRCSLayer_of_two_summands hp hp2 hG₀M hM hQ2 hO2
    (by rw [hX, Subgroup.map_sup, Subgroup.map_sup, sup_assoc]) (ggRCST_map_le_normalizer ψ hSQ)
    (ggRCST_map_le_normalizer ψ hTQ) hcomm hSq hTq ?_ ?_
  · rw [← Subgroup.map_sup, ← map_commutator]
    exact map_mono wRadical_le_commutator_shortBlock
  · rw [← Subgroup.map_sup, ← map_commutator, commutator_wRadical_sup_spCompl12 hK]
    exact map_mono le_sup_left

omit [Finite F] [Finite G] in
theorem centralizer_a2_facts :
    centralizer ({twoCentralElt (n + 3) 1 2 (0 : F) 1} : Set (StatedSp (n + 3) F)) =
        wRadical F (1 : Fin (n + 3)) 2 ⊔
          ((shortBlock F (one_ne_two_fin (n := n))).range ⊔ spCompl12 F n) ∧
      (shortBlock F (one_ne_two_fin (n := n))).range ≤
        normalizer (wRadical F (1 : Fin (n + 3)) 2 : Set (StatedSp (n + 3) F)) ∧
      spCompl12 F n ≤ normalizer (wRadical F (1 : Fin (n + 3)) 2 : Set (StatedSp (n + 3) F)) ∧
      (shortBlock F (one_ne_two_fin (n := n))).range ≤
        centralizer (spCompl12 F n : Set (StatedSp (n + 3) F)) := by
  have h12 := one_ne_two_fin (n := n)
  have hC : centralizer ({twoCentralElt (n + 3) 1 2 (0 : F) 1} : Set (StatedSp (n + 3) F)) =
      wRadical F (1 : Fin (n + 3)) 2 ⊔ ((shortBlock F h12).range ⊔ spCompl12 F n) :=
    le_antisymm centralizer_a2_le (sup_le (wRadical_le_centralizer_twoCentralElt 0 1)
      (sup_le (by rintro _ ⟨A, rfl⟩; exact shortBlock_mem_centralizer h12 A 1)
        (spCompl12_le_centralizer_twoCentralElt n 0 1)))
  have hCN : centralizer ({twoCentralElt (n + 3) 1 2 (0 : F) 1} : Set (StatedSp (n + 3) F)) ≤
      normalizer (wRadical F (1 : Fin (n + 3)) 2 : Set (StatedSp (n + 3) F)) := by
    rw [centralizer_twoCentralElt_eq_sup h12 (one_ne_zero (α := F))]
    exact sup_le le_normalizer (range_leviHom_le_normalizer_wRadical h12 one_ne_zero)
  refine ⟨hC, (hC ▸ le_sup_left.trans le_sup_right).trans hCN,
    (hC ▸ le_sup_right.trans le_sup_right).trans hCN, ?_⟩
  rintro _ ⟨A, rfl⟩
  rw [mem_centralizer_iff]
  intro t ht
  have ht' : t ∈ suppGroup {t : Fin (n + 3) ⊕ Fin (n + 3) | ¬ OffPQ 1 2 t}ᶜ := by
    have : {t : Fin (n + 3) ⊕ Fin (n + 3) | ¬ OffPQ 1 2 t}ᶜ = {t | OffPQ 1 2 t} := by
      ext t
      simp
    rw [this, ← spCompl12_eq_suppGroup]
    exact ht
  exact ((commute_suppGroup_compl (shortBlock_mem_suppGroup (n := n) A) ht').eq).symm

omit [CharP F 2] [Finite G] in
theorem card_range_shortBlock_two (hK : Nat.card F = 2) {m : ℕ} {i j : Fin m} (hij : i ≠ j) :
    Nat.card (shortBlock F hij).range = 6 := by
  rw [Nat.card_congr (MonoidHom.ofInjective (shortBlock_injective hij)).symm.toEquiv,
    CFSG.LieType.Steinberg.card_specialLinearGroup_fin_two, hK]
  norm_num

theorem derivedAt_short_q2 (hK : Nat.card F = 2) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hp3 : p ≠ 3) (ψ : StatedSp (n + 3) F →* G) (hψ : Function.Injective ψ) :
    GGRootCentDerivedAt p ψ.range (ψ (twoCentralElt (n + 3) 1 2 (0 : F) 1)) := by
  have h12 := one_ne_two_fin (n := n)
  obtain ⟨hC, hSQ, hTQ, hST⟩ := centralizer_a2_facts (F := F) (n := n)
  set QW := wRadical F (1 : Fin (n + 3)) 2 with hQW
  set S := (shortBlock F h12).range with hS
  set T := spCompl12 F n with hT
  have hX : ggRCSX ψ.range (ψ (twoCentralElt (n + 3) 1 2 (0 : F) 1)) =
      (QW ⊔ (S ⊔ T)).map ψ := by
    rw [ggRCSX_eq_map_centralizer ψ hψ (centralizer_twoCentralElt_le_ggOTwoPrime h12), hC]
  have hpS : ¬ p ∣ Nat.card S := by
    rw [hS, card_range_shortBlock_two hK h12]
    intro h
    have h6 : p ∣ 2 * 3 := h
    rcases (Nat.Prime.dvd_mul hp).mp h6 with h | h
    · exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h)
    · exact hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h)
  have hSN : S ≤ normalizer ((QW ⊔ T : Subgroup (StatedSp (n + 3) F)) :
      Set (StatedSp (n + 3) F)) := fun g hg =>
    ggRCST_mem_normalizer_sup (hSQ hg) (centralizer_le_normalizer _ (hST hg))
  have hcov : ∀ c ∈ QW ⊔ (S ⊔ T), c ^ p = 1 → c ∈ QW ⊔ T := by
    intro c hc hcp
    have hc' : c ∈ S ⊔ (QW ⊔ T) := by
      have : QW ⊔ (S ⊔ T) = S ⊔ (QW ⊔ T) := by
        rw [← sup_assoc, sup_comm QW S, sup_assoc]
      rwa [this] at hc
    exact ggRCST_mem_of_mem_sup_coprime hp hpS hSN hc' hcp
  have hQ2 : IsPGroup 2 QW := isPGroup_wRadical h12
  rcases Nat.lt_or_ge n 2 with hn | hn
  · interval_cases n
    ·
      refine Or.inl fun y hy hyp => ?_
      rw [hX] at hy
      obtain ⟨c, hc, rfl⟩ := hy
      have hcp : c ^ p = 1 := hψ (by rw [map_pow, hyp, map_one])
      have hcT := hcov c hc hcp
      have hpT : ¬ p ∣ Nat.card T := by
        rw [hT, Nat.card_congr (spCompl12Equiv F 0).symm.toEquiv,
          Nat.card_congr (longBlockEquivOne F).symm.toEquiv,
          CFSG.LieType.Steinberg.card_specialLinearGroup_fin_two, hK]
        intro h
        have h6 : p ∣ 2 * 3 := h
        rcases (Nat.Prime.dvd_mul hp).mp h6 with h | h
        · exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h)
        · exact hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h)
      have hcQ : c ∈ QW := ggRCST_mem_of_mem_sup_coprime hp hpT hTQ
        (by rwa [sup_comm] at hcT) hcp
      rw [ggRCS_eq_one_of_mem_two hp hp2 hQ2 hcQ hcp, map_one]
    ·
      set e : ↥T ≃* CFSG.ComponentClassification.PresentationLocal.sympFour :=
        (CFSG.SeitzReduction.SymplecticPilot.sympFourEquivSpCompl12One hK).symm with he
      obtain ⟨hq, hodd⟩ := CFSG.RankThree.PartOne.derived_of_mulEquiv_sympFour e
      have hmap : (commutator ↥T).map T.subtype = ⁅T, T⁆ := Subgroup.map_subtype_commutator _
      have hL₀ : CFSG.IsQuasisimple ↥⁅T, T⁆ :=
        CFSG.LocalCores.isQuasisimple_of_mulEquiv
          (((commutator ↥T).equivMapOfInjective T.subtype
            (Subgroup.subtype_injective _)).trans (MulEquiv.subgroupCongr hmap)) hq
      have hdisj : Disjoint QW T := by
        have h1 := disjoint_wRadical_range_leviHom h12 (a := (0 : F)) one_ne_zero
        exact h1.mono_right (spCompl12_le_range_leviHom one_ne_zero)
      refine ggRootCentDerivedAt_of_quasisimple hp hp2 (by rw [hX]; exact map_mono le_sup_left)
        (hQ2.map ψ) (by rw [hX]; exact ggRCST_map_le_normalizer ψ (sup_le le_normalizer
          (sup_le hSQ hTQ)))
        (by rw [hX]; exact map_mono ((Subgroup.commutator_le_self _).trans
          (le_sup_right.trans le_sup_right)))
        (CFSG.LocalCores.isQuasisimple_of_mulEquiv (⁅T, T⁆.equivMapOfInjective ψ hψ) hL₀) ?_ ?_
      · change CFSG.Quasithin.perfectCore (ggRCSX ψ.range _) ≤ _
        rw [hX, ← CFSG.Quasithin.map_perfectCore, ← hC,
          CFSG.SeitzReduction.SymplecticPilot.perfectCore_centralizer_twoCentralElt_one_two hK
            (Or.inl rfl), Subgroup.map_sup]
      · intro y hy hyp
        rw [hX] at hy
        obtain ⟨c, hc, rfl⟩ := hy
        have hcp : c ^ p = 1 := hψ (by rw [map_pow, hyp, map_one])
        have hcT : c ∈ ((QW ⊔ T : Subgroup (StatedSp (1 + 3) F)) : Set (StatedSp (1 + 3) F)) :=
          hcov c hc hcp
        rw [coe_mul_of_right_le_normalizer_left _ _ hTQ] at hcT
        obtain ⟨q, hq', t, ht, rfl⟩ := hcT
        have htp := pow_eq_one_of_mul hTQ hdisj hq' ht hcp
        have ht' := hodd hp hp2 ⟨t, ht⟩ (Subtype.ext (by simpa using htp))
        rw [← Subgroup.map_sup, ← hmap]
        exact mem_map_of_mem ψ (mul_mem (mem_sup_left hq') (mem_sup_right ⟨⟨t, ht⟩, ht', rfl⟩))
  ·
    have hTq : CFSG.IsQuasisimple T :=
      CFSG.LocalCores.isQuasisimple_of_mulEquiv (spCompl12Equiv F n)
        (CFSG.LieType.Universal.Symplectic.isQuasisimple (n + 1) F (by omega)
          (Or.inr (Or.inr ⟨hK, by omega⟩)))
    refine ggRootCentDerivedAt_of_quasisimple hp hp2 (by rw [hX]; exact map_mono le_sup_left)
      (hQ2.map ψ) (by rw [hX]; exact ggRCST_map_le_normalizer ψ (sup_le le_normalizer
        (sup_le hSQ hTQ)))
      (by rw [hX]; exact map_mono (le_sup_right.trans le_sup_right))
      (CFSG.LocalCores.isQuasisimple_of_mulEquiv (T.equivMapOfInjective ψ hψ) hTq) ?_ ?_
    · change CFSG.Quasithin.perfectCore (ggRCSX ψ.range _) ≤ _
      rw [hX, ← CFSG.Quasithin.map_perfectCore, ← hC,
        CFSG.SeitzReduction.SymplecticPilot.perfectCore_centralizer_twoCentralElt_two hK hn
          (Or.inl rfl), Subgroup.map_sup]
    · intro y hy hyp
      rw [hX] at hy
      obtain ⟨c, hc, rfl⟩ := hy
      have hcp : c ^ p = 1 := hψ (by rw [map_pow, hyp, map_one])
      rw [← Subgroup.map_sup]
      exact mem_map_of_mem ψ (hcov c hc hcp)

theorem layer_short (hK : 4 ≤ Nat.card F) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (ψ : StatedSp (n + 3) F →* G) (hψ : Function.Injective ψ) {M : Subgroup G}
    (hG₀M : ψ.range ≤ M) (hM : M ≤ normalizer (ψ.range : Set G)) {r : G}
    {h : StatedSp (n + 3) F} {i j : Fin (n + 3)} (hij : i ≠ j)
    (hr : ψ.range ⊓ centralizer {r} =
      ψ.range ⊓ centralizer {ψ (h * twoCentralElt (n + 3) i j (0 : F) 1 * h⁻¹)}) :
    GGRCSLayer p ψ.range M r := by
  obtain ⟨g, hg⟩ := exists_conj_one_two (F := F) hij
  have hrange : (ψ.comp (MulAut.conj (h * g)).toMonoidHom).range = ψ.range :=
    range_comp_conj ψ (h * g)
  have h1 : ψ (h * twoCentralElt (n + 3) i j (0 : F) 1 * h⁻¹) =
      (ψ.comp (MulAut.conj (h * g)).toMonoidHom) (twoCentralElt (n + 3) 1 2 0 1) := by
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, hg]
    congr 1
    group
  have key := layer_short_std hK hp hp2 (ψ.comp (MulAut.conj (h * g)).toMonoidHom)
    (comp_conj_injective hψ _) (M := M) (by rw [hrange]; exact hG₀M) (by rw [hrange]; exact hM)
    (r := r) (by rw [hrange, ← h1]; exact hr)
  rwa [hrange] at key

theorem layer_short_q2 (hK : Nat.card F = 2) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : p ≠ 3)
    (ψ : StatedSp (n + 3) F →* G) (hψ : Function.Injective ψ) {M : Subgroup G}
    (hG₀M : ψ.range ≤ M) (hM : M ≤ normalizer (ψ.range : Set G)) {r : G}
    {h : StatedSp (n + 3) F} {i j : Fin (n + 3)} (hij : i ≠ j)
    (hr : ψ.range ⊓ centralizer {r} =
      ψ.range ⊓ centralizer {ψ (h * twoCentralElt (n + 3) i j (0 : F) 1 * h⁻¹)}) :
    GGRCSLayer p ψ.range M r := by
  obtain ⟨g, hg⟩ := exists_conj_one_two (F := F) hij
  have hrange : (ψ.comp (MulAut.conj (h * g)).toMonoidHom).range = ψ.range :=
    range_comp_conj ψ (h * g)
  have h1 : ψ (h * twoCentralElt (n + 3) i j (0 : F) 1 * h⁻¹) =
      (ψ.comp (MulAut.conj (h * g)).toMonoidHom) (twoCentralElt (n + 3) 1 2 0 1) := by
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, hg]
    congr 1
    group
  refine ggRCSLayer_of_derivedAt hp hp2 hG₀M hM ?_
  rw [derivedAt_congr (hr.trans (by rw [h1])), ← hrange]
  exact derivedAt_short_q2 hK hp hp2 hp3 _ (comp_conj_injective hψ _)

end Short

