@[expose] def GGRootCentLayerSpShortInput : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p n f : ℕ) (ψ : StatedSp n (GaloisField 2 f) →* G),
    p.Prime → p ≠ 2 → StatedLieAdmissible .PSp n 2 f → 3 ≤ n → Function.Injective ψ →
    Subgroup.centralizer (ψ.range : Set G) = ⊥ →
    GGTwoLocalRankFour p (Subgroup.normalizer (ψ.range : Set G)) →
    ∀ r : G, GGRootInvolution (Symplectic.rootDatum n (GaloisField 2 f)) .PSp ψ r →
      (∃ (h : StatedSp n (GaloisField 2 f)) (i j : Fin n), i ≠ j ∧
        ψ.range ⊓ Subgroup.centralizer {r} =
          ψ.range ⊓ Subgroup.centralizer {ψ (h * twoCentralElt n i j 0 1 * h⁻¹)}) →
      GGRCSLayer p ψ.range (Subgroup.normalizer (ψ.range : Set G)) r

@[expose] def GGRootCentLayerSpShortTwoInput : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p n : ℕ) (ψ : StatedSp n (GaloisField 2 1) →* G),
    p.Prime → p ≠ 2 → 3 ≤ n → Function.Injective ψ →
    Subgroup.centralizer (ψ.range : Set G) = ⊥ →
    GGTwoLocalRankFour p (Subgroup.normalizer (ψ.range : Set G)) →
    ∀ r : G, GGRootInvolution (Symplectic.rootDatum n (GaloisField 2 1)) .PSp ψ r →
      (∃ (h : StatedSp n (GaloisField 2 1)) (i j : Fin n), i ≠ j ∧
        ψ.range ⊓ Subgroup.centralizer {r} =
          ψ.range ⊓ Subgroup.centralizer {ψ (h * twoCentralElt n i j 0 1 * h⁻¹)}) →
      GGRCSLayer p ψ.range (Subgroup.normalizer (ψ.range : Set G)) r

@[expose] def GGRootCentLayerSpShortTwoThreeInput : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (n : ℕ) (ψ : StatedSp n (GaloisField 2 1) →* G),
    3 ≤ n → Function.Injective ψ → Subgroup.centralizer (ψ.range : Set G) = ⊥ →
    GGTwoLocalRankFour 3 (Subgroup.normalizer (ψ.range : Set G)) →
    ∀ r : G, GGRootInvolution (Symplectic.rootDatum n (GaloisField 2 1)) .PSp ψ r →
      (∃ (h : StatedSp n (GaloisField 2 1)) (i j : Fin n), i ≠ j ∧
        ψ.range ⊓ Subgroup.centralizer {r} =
          ψ.range ⊓ Subgroup.centralizer {ψ (h * twoCentralElt n i j 0 1 * h⁻¹)}) →
      GGRCSLayer 3 ψ.range (Subgroup.normalizer (ψ.range : Set G)) r

theorem ggRootCentLayerSpShortTwoInput_of_three (h3 : GGRootCentLayerSpShortTwoThreeInput) :
    GGRootCentLayerSpShortTwoInput := by
  intro G _ _ p n ψ hp hp2 hn hψ hC h4 r hr hsh
  by_cases hp3 : p = 3
  · subst hp3
    exact h3 G n ψ hn hψ hC h4 r hr hsh
  · obtain ⟨h, i, j, hij, hrc⟩ := hsh
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hK : Nat.card (GaloisField 2 1) = 2 := by
      rw [GaloisField.card 2 1 one_ne_zero, pow_one]
    exact RCSTSp.layer_short_q2 hK hp hp2 hp3 ψ hψ Subgroup.le_normalizer le_rfl hij hrc

theorem ggRootCentLayerSpShortInput_of_two (h2 : GGRootCentLayerSpShortTwoInput) :
    GGRootCentLayerSpShortInput := by
  intro G _ _ p n f ψ hp hp2 hadm hn hψ hC h4 r hr hsh
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hf1 : 1 ≤ f := hadm.2.1
  by_cases hf : f = 1
  · subst hf
    exact h2 G p n ψ hp hp2 hn hψ hC h4 r hr hsh
  · obtain ⟨h, i, j, hij, hrc⟩ := hsh
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
    have hK : 4 ≤ Nat.card (GaloisField 2 f) := by
      rw [GaloisField.card 2 f (by omega)]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact RCSTSp.layer_short hK hp hp2 ψ hψ Subgroup.le_normalizer le_rfl hij hrc

theorem ggRCSLayer_sp_of_short (hshort : GGRootCentLayerSpShortInput) {G : Type} [Group G]
    [Finite G] {p n f : ℕ} (ψ : StatedSp n (GaloisField 2 f) →* G) (hp : p.Prime) (hp2 : p ≠ 2)
    (hadm : StatedLieAdmissible .PSp n 2 f) (hψ : Function.Injective ψ)
    (hC : Subgroup.centralizer (ψ.range : Set G) = ⊥)
    (h4 : GGTwoLocalRankFour p (Subgroup.normalizer (ψ.range : Set G))) {r : G}
    (hr : GGRootInvolution (Symplectic.rootDatum n (GaloisField 2 f)) .PSp ψ r) :
    GGRCSLayer p ψ.range (Subgroup.normalizer (ψ.range : Set G)) r := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hF : Nat.card (GaloisField 2 f) = 2 ^ f :=
    GaloisField.card 2 f (by have := hadm.2.1; omega)
  obtain ⟨-, -, hn, hnf⟩ := id hadm
  have hr' := hr
  obtain ⟨hr2, γ, ⟨hγ, -⟩, u, hru⟩ := hr'
  obtain ⟨_, ⟨x, hx, rfl⟩, rfl⟩ := hru
  have hx1 : x ≠ 1 := by
    rintro rfl
    simp at hr2
  obtain ⟨ρ, hρ⟩ := exists_stdVec_of_mem_roots hγ
  obtain ⟨c, rfl⟩ := (mem_rootGroup_iff hρ).1 hx
  have hc : c ≠ 0 := by
    rintro rfl
    exact hx1 (elt_zero ρ)
  have key : ∀ y : StatedSp n (GaloisField 2 f),
      Subgroup.centralizer ({y} : Set (StatedSp n (GaloisField 2 f))) =
        Subgroup.centralizer ({elt ρ (1 : GaloisField 2 f)} : Set (StatedSp n (GaloisField 2 f))) →
      ψ.range ⊓ Subgroup.centralizer {ψ ((MulAut.conj u).toMonoidHom (elt ρ c))} =
        ψ.range ⊓ Subgroup.centralizer {ψ (u * y * u⁻¹)} := by
    intro y hy
    rw [RCSTSp.range_inf_centralizer_of_injective hψ, RCSTSp.range_inf_centralizer_of_injective hψ]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    rw [OTwoGen.centralizer_conj_eq_map, OTwoGen.centralizer_conj_eq_map,
      centralizer_elt_eq ρ hc, hy]
  have hconj : ∀ (g y : StatedSp n (GaloisField 2 f)),
      ψ (u * (g * y * g⁻¹) * u⁻¹) = (ψ.comp (MulAut.conj (u * g)).toMonoidHom) y := by
    intro g y
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    congr 1
    group
  rcases RCSTSp.elt_one_eq_conj (F := GaloisField 2 f) ρ with ⟨g, i, hg⟩ | ⟨g, i, j, hij, hg⟩
  ·
    refine ggRCSLayer_of_derivedAt hp hp2 Subgroup.le_normalizer le_rfl ?_
    rw [RCSTSp.derivedAt_congr (key _ (by rw [hg])), hconj,
      ← RCSTSp.range_comp_conj ψ (u * g)]
    exact RCSTSp.derivedAt_long_all hp hp2 hF hn hnf _ (RCSTSp.comp_conj_injective hψ _) i
  · by_cases hn3 : 3 ≤ n
    ·
      refine hshort G p n f ψ hp hp2 hadm hn3 hψ hC h4 _ hr ⟨u * g, i, j, hij, ?_⟩
      rw [key _ (by rw [hg])]
      congr 3
      group
    ·
      obtain rfl : n = 2 := by omega
      have hF4 : 4 ≤ Nat.card (GaloisField 2 f) := by
        rw [hF]
        have hf2 : 2 ^ f ≠ 2 := fun h => hnf (by rw [h])
        have : 2 ≤ f := by
          by_contra h
          have : f = 1 := by have := hadm.2.1; omega
          exact hf2 (by rw [this, pow_one])
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) this
      refine ggRCSLayer_of_derivedAt hp hp2 Subgroup.le_normalizer le_rfl ?_
      rw [RCSTSp.derivedAt_congr (key _ (by rw [hg])), hconj,
        ← RCSTSp.range_comp_conj ψ (u * g)]
      exact RCSTSp.derivedAt_short_two hp hp2 hF4 _ (RCSTSp.comp_conj_injective hψ _) hij

theorem ggRootCentLayerTag_PSp_of_short (hshort : GGRootCentLayerSpShortInput) :
    GGRootCentLayerTag .PSp := by
  intro G _ _ p n f ψ hp hp2 hadm _ hker hC h4 r hr
  have hψ : Function.Injective ψ := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    exact hker.trans (center_statedSp_eq_bot (K := GaloisField 2 f) n).le
  exact ggRCSLayer_sp_of_short hshort ψ hp hp2 hadm hψ hC h4 hr

theorem ggRootCentLayerTag_PSp_of_two (h2 : GGRootCentLayerSpShortTwoInput) :
    GGRootCentLayerTag .PSp :=
  ggRootCentLayerTag_PSp_of_short (ggRootCentLayerSpShortInput_of_two h2)

theorem ggRootCentLayerTag_PSp_of_three (h3 : GGRootCentLayerSpShortTwoThreeInput) :
    GGRootCentLayerTag .PSp :=
  ggRootCentLayerTag_PSp_of_two (ggRootCentLayerSpShortTwoInput_of_three h3)

