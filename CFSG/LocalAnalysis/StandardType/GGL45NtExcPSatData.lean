theorem pSat_E8_7 {Y : Set (Fin Tag.E8.rank → ℤ)}
    (hY : ∀ y ∈ Y, IsRoot Tag.E8 y) : PSat 7 (AddSubgroup.closure Y) :=
  pSat_of_sylow (by norm_num : Nat.Prime 7)
    (by rw [CFSG.StandardType.NoOffExc.card_weyl_E8]; norm_num)
    (orderOf_chain (by norm_num : Nat.Prime 7) chain_E8_7 (by decide +kernel) ⟨⟨0, by decide⟩, by decide +kernel⟩)
    (fun Y hY hw => pSat_case (by norm_num : Nat.Prime 7) chain_E8_7 sigma_E8_7 U_E8_7 (by decide +kernel) S_E8_7
      (roots_proj_of_check sigma_E8_7 S_E8_7 (by decide +kernel))
      (pSat_sublists (by norm_num : Nat.Prime 7) (certs := certs_E8_7) (idx := idx_E8_7) (by decide +kernel)) Y hY hw)
    hY

theorem card_weylGroup_G2' : Nat.card (WeylGroup Tag.G2) = 12 := by
  have h := CFSG.GH74.GLS.SP.card_coxeterGroup_fin_two
    (CFSG.LieType.RootSystem.coxeterMatrix (isFiniteType_cartan Tag.G2))
  simp only [CFSG.LieType.RootSystem.coxeterMatrix,
    TauCeti.coxeterMatrixOfCartanMatrix_apply, Tag.cartan] at h
  norm_num at h
  exact h

theorem pSat_of_not_dvd_W {τ : Tag} {p : ℕ} (hp : p.Prime) (hW : ¬ p ∣ Nat.card (WeylGroup τ))
    {Y : Set (Fin τ.rank → ℤ)} (hY : ∀ y ∈ Y, IsRoot τ y) : PSat p (AddSubgroup.closure Y) :=
  pSat_of_not_dvd hY hp fun hd => hW (hd.trans (Subgroup.card_subgroup_dvd_card _))

theorem pSat_roots (τ : Tag) {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2)
    (h3 : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8 → p ≠ 3) (h5 : τ = .E8 → p ≠ 5)
    (hG2 : τ = .G2 → p ≠ 3) {Y : Set (Fin τ.rank → ℤ)} (hY : ∀ y ∈ Y, IsRoot τ y) :
    PSat p (AddSubgroup.closure Y) := by
  rcases CFSG.HardMathSupport.C14Lattice.prime_cases_three_five_seven hp hp2 with
    rfl | rfl | rfl | hp7
  · cases τ
    · exact absurd rfl (hG2 rfl)
    · exact absurd rfl (h3 (Or.inl rfl))
    · exact pSat_D4_3 hY
    · exact absurd rfl (h3 (Or.inr (Or.inl rfl)))
    · exact absurd rfl (h3 (Or.inr (Or.inr (Or.inl rfl))))
    · exact absurd rfl (h3 (Or.inr (Or.inr (Or.inr rfl))))
  · cases τ
    · exact pSat_of_not_dvd_W hp
        (by rw [card_weylGroup_G2']; norm_num) hY
    · exact pSat_of_not_dvd_W hp
        (CFSG.RankThree.PartOne.KE.not_dvd_card_weylGroup_F4 (by norm_num) (by norm_num)) hY
    · exact pSat_of_not_dvd_W hp
        (CFSG.RankThree.PartOne.KGD.not_dvd_card_weylGroup_D4 (by norm_num) (by norm_num)) hY
    · exact pSat_E6_5 hY
    · exact pSat_E7_5 hY
    · exact absurd rfl (h5 rfl)
  · cases τ
    · exact pSat_of_not_dvd_W hp
        (by rw [card_weylGroup_G2']; norm_num) hY
    · exact pSat_of_not_dvd_W hp
        (CFSG.RankThree.PartOne.KE.not_dvd_card_weylGroup_F4 (by norm_num) (by norm_num)) hY
    · exact pSat_of_not_dvd_W hp
        (CFSG.RankThree.PartOne.KGD.not_dvd_card_weylGroup_D4 (by norm_num) (by norm_num)) hY
    · exact pSat_of_not_dvd_W hp
        (by rw [CFSG.StandardType.NoOffExc.card_weyl_E6]; norm_num) hY
    · exact pSat_E7_7 hY
    · exact pSat_E8_7 hY
  · refine pSat_of_not_dvd_W hp ?_ hY
    cases τ
    · rw [card_weylGroup_G2']
      intro h
      have := Nat.le_of_dvd (by norm_num) h
      interval_cases p <;> first | (norm_num at h; done) | (norm_num at hp; done)
    · exact CFSG.RankThree.PartOne.KE.not_dvd_card_weylGroup_F4 hp (by omega)
    · exact CFSG.RankThree.PartOne.KGD.not_dvd_card_weylGroup_D4 hp (by omega)
    · exact CFSG.RankThree.PartOne.KE.not_dvd_card_weylGroup_E hp hp7 (Or.inl rfl)
    · exact CFSG.RankThree.PartOne.KE.not_dvd_card_weylGroup_E hp hp7 (Or.inr (Or.inl rfl))
    · exact CFSG.RankThree.PartOne.KE.not_dvd_card_weylGroup_E hp hp7 (Or.inr (Or.inr rfl))

open CFSG.HardMathSupport.Timmesfeld.Torality in
theorem familyKernel_pSaturated {τ : Tag}
    {ι : Type} {K : Type} [Field K] {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (h3 : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8 → p ≠ 3) (h5 : τ = .E8 → p ≠ 5)
    (hG2 : τ = .G2 → p ≠ 3) (a : ι → Fin τ.rank → Kˣ) (v : Fin τ.rank → ℤ)
    (hv : p • v ∈ AddSubgroup.closure (familyKernel a)) :
    v ∈ AddSubgroup.closure (familyKernel a) :=
  pSat_roots τ hp hp2 h3 h5 hG2 (Y := familyKernel a) (fun _ hy => hy.1) v hv

end CFSG.HardMathSupport.C14PSat
