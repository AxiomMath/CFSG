theorem pSat_E6_5 {Y : Set (Fin Tag.E6.rank → ℤ)}
    (hY : ∀ y ∈ Y, IsRoot Tag.E6 y) : PSat 5 (AddSubgroup.closure Y) :=
  pSat_of_sylow (by norm_num : Nat.Prime 5)
    (by rw [CFSG.StandardType.NoOffExc.card_weyl_E6]; norm_num)
    (orderOf_chain (by norm_num : Nat.Prime 5) chain_E6_5 (by decide +kernel) ⟨⟨0, by decide⟩, by decide +kernel⟩)
    (fun Y hY hw => pSat_case (by norm_num : Nat.Prime 5) chain_E6_5 sigma_E6_5 U_E6_5 (by decide +kernel) S_E6_5
      (roots_proj_of_check sigma_E6_5 S_E6_5 (by decide +kernel))
      (pSat_sublists (by norm_num : Nat.Prime 5) (certs := certs_E6_5) (idx := idx_E6_5) (by decide +kernel)) Y hY hw)
    hY

