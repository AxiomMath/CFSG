private lemma units_pow_two_pow_eq_self_aux {L : Type} [Field L] {f : ℕ}
    (h3 : 3 ∣ 2 ^ f - 1) (x : Lˣ) (hx : x ^ 3 = 1) : x ^ (2 ^ f) = x := by
  obtain ⟨k, hk⟩ := h3
  have h1 : 1 ≤ 2 ^ f := Nat.one_le_two_pow
  have hpow : 2 ^ f = 3 * k + 1 := by omega
  rw [hpow, pow_add, pow_mul, hx, one_pow, one_mul, pow_one]

theorem split_setup_plus
    {f : ℕ} (hf : 1 ≤ f) (h3 : 3 ∣ 2 ^ f - 1) :
    ∃ (S : LangSetup Tag.E6 (AlgebraicClosure (GaloisField 2 f)) 5)
      (e : adjointGroup Tag.E6 (GaloisField 2 f) ≃* S.Γ),
      S.Descends ∧ (∀ α, S.ρ α = α) ∧
      (∀ a : Fin Tag.E6.rank → (AlgebraicClosure (GaloisField 2 f))ˣ, (∀ i, a i ^ 3 = 1) →
        rootDiagUnit Tag.E6 a ∈ S.D.torus) ∧
      (∀ φ ∈ (MulAut.conj : adjointGroup Tag.E6 (GaloisField 2 f) →*
          MulAut (adjointGroup Tag.E6 (GaloisField 2 f))).range ⊔
          (AutSt.e6DiagHom (GaloisField 2 f)).range,
        ∃ d ∈ S.D.model, ∀ x : adjointGroup Tag.E6 (GaloisField 2 f),
          (e (φ x) : ModGL Tag.E6 (AlgebraicClosure (GaloisField 2 f))) =
            d * (e x : ModGL Tag.E6 (AlgebraicClosure (GaloisField 2 f))) * d⁻¹) ∧
      (∀ d ∈ S.D.model, (∀ x : S.Γ, d * (x : ModGL Tag.E6 (AlgebraicClosure (GaloisField 2 f))) *
        d⁻¹ = x) → d = 1) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let K := GaloisField 2 f
  let L := AlgebraicClosure K
  have hK : Nat.card K = 2 ^ f := GaloisField.card 2 f (by omega)
  have hfne : f ≠ 0 := by omega
  haveI hcharK : CharP K 2 := inferInstance
  haveI hcharL : CharP L 2 := charP_of_injective_algebraMap (algebraMap K L).injective _
  let Fr : L →+* L := iterateFrobenius L 2 f
  have hFr : ∀ c : L, Fr c = c ^ 2 ^ f := fun c => iterateFrobenius_def 2 f c
  let D : LangDatum Tag.E6 L :=
    LangDatum.ofFrobenius (τ := Tag.E6) Fr (2 ^ f) hFr (1 : WeylGroup Tag.E6)
      (one_mem _) (by simp [canonicalRep_one])
  have hn1c : D.n = canonicalRep (coxeterSystem Tag.E6) L (1 : WeylGroup Tag.E6) := rfl
  have hDn : D.n = (1 : ModGL Tag.E6 L) := by
    rw [hn1c]
    exact canonicalRep_one (coxeterSystem Tag.E6) L
  have hDg0 : D.g0 = 1 := rfl
  have hDΦ : D.Φ = Units.map (entrywiseHom Fr) := rfl
  have hsurj : Function.Surjective Fr := fun y => by
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq y (by positivity : 0 < 2 ^ f)
    exact ⟨x, by rw [hFr, hx]⟩
  have hρ : FrobRootMap D (Equiv.refl (Fin Tag.E6.rank → ℤ)) :=
    { isRoot_iff := fun γ => Iff.rfl
      neg_eq := fun γ => rfl
      iform_eq := fun γ δ => rfl
      map_rootSubgroup := fun γ hγ => by
        have h := LangDatum.map_step_rootSubgroup (D := D) hsurj hDΦ
          (w := (1 : WeylGroup Tag.E6)) hn1c hγ
        simpa using h
      rootChar_eq := fun a ha γ hγ => by
        have h1 : D.Φ (rootDiagUnit Tag.E6 a) = rootDiagUnit Tag.E6 a := by
          have h := (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 ha).2
          rwa [hDn, one_mul, inv_one, mul_one] at h
        have h2 : Units.map (entrywiseHom Fr) (rootDiagUnit Tag.E6 a) =
            rootDiagUnit Tag.E6 a := by
          rw [← hDΦ]; exact h1
        have h3 : (fun i => Units.map Fr.toMonoidHom (a i)) = a := by
          apply CFSG.LieType.Chevalley.rootDiagUnit_injective
          rw [← CFSG.HardMathSupport.Timmesfeld.CrossChar.units_map_entrywiseHom_rootDiagUnit
            Fr a, h2]
        have h5 : Units.map Fr.toMonoidHom (rootChar a γ) = rootChar a γ := by
          rw [CFSG.HardMathSupport.Timmesfeld.CrossChar.units_map_rootChar, h3]
        have h6 : Units.map Fr.toMonoidHom (rootChar a γ) = rootChar a γ ^ D.q := by
          change Units.map Fr.toMonoidHom (rootChar a γ) = rootChar a γ ^ 2 ^ f
          ext
          simp [hFr]
        exact h5.symm.trans h6 }
  have hqpow : IsPrimePow D.q ∧ ((D.q : ℕ) : L) = 0 := by
    constructor
    · change IsPrimePow (2 ^ f)
      exact Nat.prime_two.isPrimePow.pow hfne
    · change (((2 ^ f : ℕ)) : L) = 0
      exact (CharP.cast_eq_zero_iff L 2 (2 ^ f)).2 (dvd_pow_self 2 hfne)
  have hpq : ¬ 5 ∣ D.q := by
    change ¬ (5 : ℕ) ∣ 2 ^ f
    intro h
    have h52 : (5 : ℕ) ∣ 2 := Nat.prime_five.dvd_of_dvd_pow h
    norm_num at h52
  have hperf : commutator ↥(adjointGroup Tag.E6 K) = ⊤ :=
    single_edge_perfect Tag.E6 K (Or.inr (Or.inr (Or.inl rfl)))
  have hFrK : ∀ c : L, Fr c = c ^ Nat.card K := fun c => by
    rw [hK]; exact hFr c
  let ι : adjointGroup Tag.E6 K →* ModGL Tag.E6 L :=
    (baseChangeGL (algebraMap K L)).comp (adjointGroup Tag.E6 K).subtype
  have hι : Function.Injective ι :=
    (baseChangeGL_injective _).comp (Subgroup.subtype_injective _)
  have hrange : ι.range = (adjointGroup Tag.E6 K).map (baseChangeGL (algebraMap K L)) := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hdesc : LangDescent D 5 ι :=
    langDescent_untw (K := K) (L := L) 3 (Or.inl ⟨rfl, rfl⟩) hFrK D hDΦ
      Nat.prime_five (by norm_num) hperf
  have hfin : Finite D.model := hdesc.finite_model
  let S : LangSetup Tag.E6 L 5 :=
    D.toSetup 5 (Equiv.refl _) hρ Nat.prime_five (Or.inl le_rfl) hqpow hpq hfin
  let e : adjointGroup Tag.E6 K ≃* S.Γ := hdesc.mulEquiv' hι
  have hK' : Nat.card K = S.D.q := by
    change Nat.card K = 2 ^ f
    exact hK
  have hmodel : D.model = D.fix := by
    ext y
    rw [LangDatum.mem_model, LangDatum.mem_fix]
    constructor
    · rintro ⟨hy, hf⟩
      exact ⟨hy, by simpa [hDn] using hf⟩
    · rintro ⟨hy, hf⟩
      exact ⟨hy, by simpa [hDn] using hf⟩
  have hΓ_eq : S.Γ = ι.range := by
    change ⁅D.model, D.model⁆ = ι.range
    rw [hmodel]
    exact hdesc.derived
  have hSΓ : S.Γ = (adjointGroup Tag.E6 K).map (baseChangeGL (algebraMap K L)) :=
    hΓ_eq.trans hrange
  have he : ∀ x : adjointGroup Tag.E6 K,
      (e x : ModGL Tag.E6 L) = baseChangeGL (algebraMap K L) (x : ModGL Tag.E6 K) := by
    intro x
    change ((hdesc.mulEquiv' hι x : D.Γ) : ModGL Tag.E6 L) = _
    rw [LangDescent.coe_mulEquiv', hDg0]
    simp only [inv_one, one_mul, mul_one]
    change baseChangeGL (algebraMap K L) (x : ModGL Tag.E6 K) =
      baseChangeGL (algebraMap K L) (x : ModGL Tag.E6 K)
    rfl
  have hΓ_model : S.Γ ≤ S.D.model := Subgroup.commutator_le_self _
  have hT3 : ∀ a : Fin Tag.E6.rank → Lˣ, (∀ i, a i ^ 3 = 1) →
      rootDiagUnit Tag.E6 a ∈ S.D.torus := by
    intro a ha
    change rootDiagUnit Tag.E6 a ∈
      CFSG.RankThree.PartOne.KE.twistedTorusOf D.n D.Φ
    rw [CFSG.RankThree.PartOne.KE.mem_twistedTorusOf]
    refine ⟨rootDiagUnit_mem_torusGroup a, ?_⟩
    rw [hDn, hDΦ]
    simp only [one_mul, inv_one, mul_one]
    rw [CFSG.HardMathSupport.Timmesfeld.CrossChar.units_map_entrywiseHom_rootDiagUnit Fr a]
    congr 1
    funext i
    apply Units.ext
    change Fr (a i : L) = (a i : L)
    rw [hFr]
    exact congrArg (fun u : Lˣ => (u : L)) (units_pow_two_pow_eq_self_aux h3 (a i) (ha i))
  have hconj_diag : ∀ b : Fin Tag.E6.rank → Kˣ, ∀ x : adjointGroup Tag.E6 K,
      baseChangeGL (algebraMap K L) ((AutSt.e6DiagHom K b x : adjointGroup Tag.E6 K) :
          ModGL Tag.E6 K) =
        baseChangeGL (algebraMap K L) (rootDiagUnit Tag.E6 b) *
          baseChangeGL (algebraMap K L) (x : ModGL Tag.E6 K) *
          (baseChangeGL (algebraMap K L) (rootDiagUnit Tag.E6 b))⁻¹ := by
    intro b x
    have hc : (AutSt.e6DiagHom K b x : ModGL Tag.E6 K) =
        rootDiagUnit Tag.E6 b * (x : ModGL Tag.E6 K) * (rootDiagUnit Tag.E6 b)⁻¹ := by
      change (exactNormalAut Tag.E6 K b 1 0 x : ModGL Tag.E6 K) = _
      rw [coe_exactNormalAut, exactQ_zero, AutSt.units_map_entrywiseHom_one, inv_one, mul_one,
        mul_one]
    rw [hc, map_mul, map_mul, map_inv]
  have hdmodel : ∀ b : Fin Tag.E6.rank → Kˣ,
      baseChangeGL (algebraMap K L) (rootDiagUnit Tag.E6 b) ∈ S.D.model := by
    letI : Fintype K := Fintype.ofFinite K
    intro b
    change baseChangeGL (algebraMap K L) (rootDiagUnit Tag.E6 b) ∈ D.model
    rw [D.mem_model]
    refine ⟨?_, ?_⟩
    · rw [baseChangeGL_rootDiagUnit]
      exact CFSG.LieType.AlgebraicGroups.torusGroup_le_adjointGroup
        (rootDiagUnit_mem_torusGroup _)
    · rw [hDn, hDΦ]
      simp only [one_mul, inv_one, mul_one]
      rw [baseChangeGL_rootDiagUnit,
        CFSG.HardMathSupport.Timmesfeld.CrossChar.units_map_entrywiseHom_rootDiagUnit Fr _]
      congr 1
      funext i
      apply Units.ext
      simp only [Units.coe_map, MonoidHom.coe_comp, Function.comp_apply]
      change Fr (algebraMap K L (b i)) = algebraMap K L (b i)
      rw [hFr, ← map_pow, ← hK, Nat.card_eq_fintype_card, FiniteField.pow_card]
  have hdict : ∀ φ ∈ (MulAut.conj : adjointGroup Tag.E6 K →*
        MulAut (adjointGroup Tag.E6 K)).range ⊔ (AutSt.e6DiagHom K).range,
      ∃ d ∈ S.D.model, ∀ x : adjointGroup Tag.E6 K,
        (e (φ x) : ModGL Tag.E6 L) = d * (e x : ModGL Tag.E6 L) * d⁻¹ := by
    let M : Subgroup (MulAut (adjointGroup Tag.E6 K)) :=
      { carrier := {φ | ∃ d ∈ S.D.model, ∀ x : adjointGroup Tag.E6 K,
          (e (φ x) : ModGL Tag.E6 L) = d * (e x : ModGL Tag.E6 L) * d⁻¹}
        one_mem' := ⟨1, one_mem _, fun x => by simp⟩
        mul_mem' := by
          rintro φ ψ ⟨d, hd, hφ⟩ ⟨d', hd', hψ⟩
          refine ⟨d * d', mul_mem hd hd', fun x => ?_⟩
          rw [MulAut.mul_apply, hφ (ψ x), hψ x]
          group
        inv_mem' := by
          rintro φ ⟨d, hd, hφ⟩
          refine ⟨d⁻¹, inv_mem hd, fun x => ?_⟩
          have h := hφ (φ⁻¹ x)
          have hxx : φ (φ⁻¹ x) = x := by simp
          rw [hxx] at h
          rw [h]
          group }
    refine fun φ hφ => ?_
    have hInn : (MulAut.conj : adjointGroup Tag.E6 K →*
        MulAut (adjointGroup Tag.E6 K)).range ≤ M := by
      rintro φ ⟨c, rfl⟩
      refine ⟨(e c : ModGL Tag.E6 L), hΓ_model (e c).2, fun x => ?_⟩
      rw [MulAut.conj_apply, map_mul, map_mul, map_inv]
      rfl
    have hDiag : (AutSt.e6DiagHom K).range ≤ M := by
      rintro φ ⟨b, rfl⟩
      refine ⟨baseChangeGL (algebraMap K L) (rootDiagUnit Tag.E6 b), hdmodel b, fun x => ?_⟩
      rw [he ((AutSt.e6DiagHom K b) x), he x]
      exact hconj_diag b x
    exact (sup_le hInn hDiag) hφ
  have hfaith : ∀ d ∈ S.D.model,
      (∀ x : S.Γ, d * (x : ModGL Tag.E6 L) * d⁻¹ = x) → d = 1 := by
    intro d hd hcent
    have hdadj : d ∈ adjointGroup Tag.E6 L := (D.mem_model.mp hd).1
    refine eq_one_of_commute_image (K := K) (L := L) (τ := Tag.E6) (algebraMap K L) hdadj ?_
    intro h hh
    have hhΓ : h ∈ S.Γ := by rw [hSΓ]; exact hh
    have h1 : d * h * d⁻¹ = h := hcent ⟨h, hhΓ⟩
    exact (mul_inv_eq_iff_eq_mul).1 h1
  exact ⟨S, e, S.descends_of_langDescent hK' hdesc, fun α => rfl, hT3, hdict, hfaith⟩

end CFSG.StandardType
