theorem j4d_rho_rootReflection_comm_stable
    {τ : Tag} (hτ : SimplyLacedTag τ) {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {π : Equiv.Perm (Fin τ.rank)} {ε : ℤ} (hε : ε = -1)
    (hρ : ∀ γ, IsRoot τ γ → S.ρ γ = ε • latPerm π γ)
    {f x : Fin τ.rank → ℤ} (hf : IsRoot τ f) (hx : IsRoot τ x)
    (hfix : S.ρ f = -f) :
    S.ρ (rootReflection f • x) = rootReflection f • (S.ρ x) := by
  have hxr : IsRoot τ (rootReflection f • x) := IsRoot.smul hx (rootReflection f)
  have hρx : S.ρ x = -latPerm π x := by
    rw [hρ x hx, hε, neg_one_smul]
  have hρfx : S.ρ (rootReflection f • x) = ε • latPerm π (rootReflection f • x) :=
    hρ _ hxr
  have hlatf : latPerm π f = f := by
    have h := hρ f hf
    rw [hfix, hε, neg_one_smul] at h
    exact (neg_inj.mp h).symm
  have hlin : latPerm π (rootReflection f • x) = latPerm π x - corootPair f x • latPerm π f := by
    rw [rootReflection_smul hf]
    ext i
    simp [latPerm, sub_eq_add_neg, Finsupp.smul_apply, smul_eq_mul]
  have hcp : corootPair f (S.ρ x) = -corootPair f x := by
    rw [corootPair_eq_iform hτ hf (S.ρ x), corootPair_eq_iform hτ hf x]
    have h := S.frob.iform_eq f x
    rw [hfix, ← neg_one_smul (R := ℤ) f, iform_smul_left] at h
    linarith
  have hleft : S.ρ (rootReflection f • x) = S.ρ x + corootPair f x • f := by
    rw [hρfx, hlin, hlatf, hε, neg_one_smul, neg_sub, hρx, sub_eq_add_neg, add_comm]
  have hright : rootReflection f • (S.ρ x) = S.ρ x + corootPair f x • f := by
    rw [rootReflection_smul hf, hcp, neg_smul, sub_neg_eq_add]
  rw [hleft, hright]

theorem j4d_rho_comm_componentWeylGroup_stable
    {τ : Tag} (hτ : SimplyLacedTag τ) {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {π : Equiv.Perm (Fin τ.rank)} {ε : ℤ} (hε : ε = -1)
    (hρ : ∀ γ, IsRoot τ γ → S.ρ γ = ε • latPerm π γ)
    {F : Set (Fin τ.rank → ℤ)}
    (hF : ∀ f ∈ F, IsRoot τ f ∧ S.ρ f = -f)
    {w : WeylGroup τ}
    (hw : w ∈ Subgroup.closure {s : WeylGroup τ | ∃ f ∈ F, s = rootReflection f}) :
    ∀ x : Fin τ.rank → ℤ, IsRoot τ x → S.ρ (w • x) = w • (S.ρ x) := by
  let P : WeylGroup τ → Prop := fun w =>
    ∀ x : Fin τ.rank → ℤ, IsRoot τ x → S.ρ (w • x) = w • (S.ρ x)
  have hP : ∀ w ∈ Subgroup.closure {s : WeylGroup τ | ∃ f ∈ F, s = rootReflection f}, P w := by
    intro w hw
    induction hw using Subgroup.closure_induction with
    | mem s hs =>
      obtain ⟨f, hfF, rfl⟩ := hs
      exact fun x hx =>
        j4d_rho_rootReflection_comm_stable hτ S hε hρ (hF f hfF).1 hx (hF f hfF).2
    | one => intro x hx; simp
    | mul a b _ _ ha hb =>
      intro x hx
      have hbx : IsRoot τ (b • x) := IsRoot.smul hx b
      rw [mul_smul, ha _ hbx, hb _ hx, mul_smul]
    | inv a _ ha =>
      intro x hx
      have hx' : IsRoot τ (a⁻¹ • x) := IsRoot.smul hx a⁻¹
      have h := ha _ hx'
      rw [smul_inv_smul] at h
      have h2 : a⁻¹ • S.ρ x = S.ρ (a⁻¹ • x) := by rw [h, ← mul_smul, inv_mul_cancel, one_smul]
      exact h2.symm
  exact hP w hw

theorem j4d_WF_stable_preserves_moved
    {τ : Tag} (hτ : SimplyLacedTag τ) {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {π : Equiv.Perm (Fin τ.rank)} {ε : ℤ} (hε : ε = -1)
    (hρ : ∀ γ, IsRoot τ γ → S.ρ γ = ε • latPerm π γ)
    {F : Set (Fin τ.rank → ℤ)}
    (hF : ∀ f ∈ F, IsRoot τ f ∧ S.ρ f = -f)
    {w : WeylGroup τ}
    (hw : w ∈ Subgroup.closure {s : WeylGroup τ | ∃ f ∈ F, s = rootReflection f})
    {x : Fin τ.rank → ℤ} (hx : IsRoot τ x) (hmove : S.ρ x ≠ -x) :
    S.ρ (w • x) ≠ -(w • x) := by
  intro h
  have hcomm := j4d_rho_comm_componentWeylGroup_stable hτ S hε hρ hF hw x hx
  rw [hcomm] at h
  rw [← smul_neg] at h
  exact hmove (smul_left_cancel w h)

theorem j4d_componentWeyl_maps_mem
    {τ : Tag} {Ψ C : Set (Fin τ.rank → ℤ)} (hΨ : IsRootComponent Ψ) (hC : C ⊆ Ψ)
    {w : WeylGroup τ}
    (hw : w ∈ Subgroup.closure {s : WeylGroup τ | ∃ γ ∈ C, s = rootReflection γ})
    {x : Fin τ.rank → ℤ} (hx : x ∈ Ψ) : w • x ∈ Ψ := by
  let P : WeylGroup τ → Prop := fun w => ∀ x ∈ Ψ, w • x ∈ Ψ
  have hP : ∀ w ∈ Subgroup.closure {s : WeylGroup τ | ∃ γ ∈ C, s = rootReflection γ}, P w := by
    intro w hw
    induction hw using Subgroup.closure_induction with
    | mem s hs =>
      obtain ⟨γ, hγC, rfl⟩ := hs
      exact fun x hx => hΨ.reflection_mem x hx γ (hC hγC)
    | one => intro x hx; simpa using hx
    | mul a b _ _ ha hb =>
      intro x hx
      rw [mul_smul]
      exact ha _ (hb _ hx)
    | inv a _ ha =>
      intro x hx
      have hfin : Ψ.Finite := (finite_setOf_isRoot τ).subset fun γ hγ => hΨ.isRoot γ hγ
      have hinj : Set.InjOn (a • ·) Ψ := fun u _ v _ h => smul_left_cancel a h
      have hsurj := (Set.Finite.injOn_iff_bijOn_of_mapsTo hfin (f := (a • ·)) ha).1 hinj
      obtain ⟨y, hy, hay⟩ := hsurj.2.2 hx
      rw [← hay, inv_smul_smul]
      exact hy
  exact hP w hw x hx

