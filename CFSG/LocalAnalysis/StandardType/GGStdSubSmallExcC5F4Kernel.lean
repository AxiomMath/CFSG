theorem omega_zpow_eq {L : Type} [Field L] [CharP L 2] {ω : Lˣ} (hω3 : ω ^ 3 = 1)
    (hq : (ω : L) ^ 2 + ω + 1 = 0) (z : ℤ) :
    ((ω ^ z : Lˣ) : L) =
      (if ¬ z % 3 = 1 then 1 else 0) + (if ¬ z % 3 = 0 then 1 else 0) * (ω : L) := by
  have h3 : ω ^ (3 : ℤ) = 1 := by exact_mod_cast hω3
  have hz : ω ^ z = ω ^ (z % 3) := by
    conv_lhs => rw [← Int.emod_add_ediv_mul z 3, zpow_add, zpow_mul', h3, one_zpow, mul_one]
  have h2 : (2 : L) = 0 := CharTwo.two_eq_zero
  rw [hz]
  rcases (by omega : z % 3 = 0 ∨ z % 3 = 1 ∨ z % 3 = 2) with h | h | h <;> rw [h]
  · simp
  · simp
  · have e1 : ¬ ((2 : ℤ) = 1) := by decide
    have e0 : ¬ ((2 : ℤ) = 0) := by decide
    rw [if_pos e1, if_pos e0, zpow_two, Units.val_mul, one_mul]
    linear_combination hq - (1 + (ω : L)) * h2

theorem card_filter_roots {τ : Tag} (P : (Fin τ.rank → ℤ) → Prop)
    [DecidablePred P] :
    (Finset.univ.filter fun α : {v : Fin τ.rank → ℤ // IsRoot τ v} => P α.1).card =
      {γ | IsRoot τ γ ∧ P γ}.ncard := by
  rw [← Nat.card_coe_set_eq, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card]
  exact Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter (fun v => IsRoot τ v) P)

theorem parity_of_eighteen : ∀ k0 ∈ [0, 1, 2], ∀ k1 ∈ [0, 1, 2], ∀ k2 ∈ [0, 1, 2],
    ∀ k3 ∈ [0, 1, 2], (rts.filter fun γ => kdL k0 k1 k2 k3 γ % 3 = 0).length = 18 →
      (4 + (rts.filter fun γ => ¬ kdL k0 k1 k2 k3 γ % 3 = 1).length) % 2 = 1 := by
  decide +kernel

section Trace

variable {L : Type} [Field L]
  [CharP L 2] {a : Fin Tag.F4.rank → Lˣ} {ω : Lˣ} {k : Fin Tag.F4.rank → ℕ}

theorem trace_rootDiagUnit_omega (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1) (hak : ∀ i, a i = ω ^ k i) :
    LinearMap.trace L (RootModule Tag.F4 L)
        ((rootDiagUnit Tag.F4 a : ModGL Tag.F4 L) : Module.End L (RootModule Tag.F4 L)) =
      ((4 + {γ : V4 | IsRoot Tag.F4 γ ∧ ¬ kdot k γ % 3 = 1}.ncard : ℕ) : L) +
        (({γ : V4 | IsRoot Tag.F4 γ ∧ ¬ kdot k γ % 3 = 0}.ncard : ℕ) : L) * (ω : L) := by
  have hq : (ω : L) ^ 2 + ω + 1 = 0 := by
    have h3 : (ω : L) ^ 3 = 1 := by rw [← Units.val_pow_eq_pow_val, hω3, Units.val_one]
    have h1 : (ω : L) ≠ 1 := fun h => hω1 (Units.val_eq_one.1 h)
    have h0 : ((ω : L) - 1) * ((ω : L) ^ 2 + ω + 1) = 0 := by linear_combination h3
    exact (mul_eq_zero.1 h0).resolve_left (sub_ne_zero.2 h1)
  rw [CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E8NonToral.trace_rootDiagUnit]
  simp only [rootChar_eq_pow_kdot hak, omega_zpow_eq hω3 hq, Finset.sum_add_distrib,
    ← Finset.sum_mul]
  rw [← Finset.natCast_card_filter, ← Finset.natCast_card_filter,
    card_filter_roots (fun γ => ¬ kdot k γ % 3 = 1),
    card_filter_roots (fun γ => ¬ kdot k γ % 3 = 0)]
  have hr : ((Tag.F4.rank : ℕ) : L) = ((4 : ℕ) : L) := rfl
  rw [hr]
  push_cast
  ring

theorem kernelA2A2_of_trace_eq_zero (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1) (hak : ∀ i, a i = ω ^ k i)
    (hk3 : ∀ i, k i < 3) (hk0 : ∃ i, k i ≠ 0)
    (htr : LinearMap.trace L (RootModule Tag.F4 L)
      ((rootDiagUnit Tag.F4 a : ModGL Tag.F4 L) : Module.End L (RootModule Tag.F4 L)) = 0) :
    KernelA2A2 k := by
  refine (classify_kernel k hk3 hk0).resolve_left fun he => ?_
  obtain ⟨hcard, -⟩ := CFSG.HardMathSupport.Dickson.Bal207.FamF42.kernel_conn_of_orth k hk3 hk0 he
  rw [ncard_roots_filter] at hcard
  have hm : ∀ n : ℕ, n < 3 → n ∈ [0, 1, 2] := fun n hn => by simp; omega
  have hpar : (4 + (rts.filter fun l => decide (¬ kdot k (vec4 l) % 3 = 1)).length) % 2 = 1 :=
    parity_of_eighteen (k (idx 0)) (hm _ (hk3 _)) (k (idx 1)) (hm _ (hk3 _)) (k (idx 2))
      (hm _ (hk3 _)) (k (idx 3)) (hm _ (hk3 _)) hcard
  rw [trace_rootDiagUnit_omega hω3 hω1 hak, ncard_roots_filter, ncard_roots_filter,
    CharP.cast_eq_mod L 2 (4 + _), hpar, CharP.cast_eq_mod L 2 (List.length _)] at htr
  have h2 : (2 : L) = 0 := CharTwo.two_eq_zero
  rcases Nat.mod_two_eq_zero_or_one
      (rts.filter fun l => decide (¬ kdot k (vec4 l) % 3 = 0)).length with h | h <;>
    rw [h] at htr
  · simp at htr
  · apply hω1
    refine Units.val_eq_one.1 ?_
    push_cast at htr
    linear_combination htr - h2

end Trace

