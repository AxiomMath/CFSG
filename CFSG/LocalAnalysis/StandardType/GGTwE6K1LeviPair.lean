namespace CFSG.StandardType.SCFourCover

open CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley
  CFSG.LocalAnalysis.ComponentInitial.FourGroupChevalley CFSG.HardMathSupport.Timmesfeld.CrossChar
open CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6ThreeInner
  (rootChar_eq_one_of_pairRefl_fixed_E6)


theorem e6_rootChar_eq_one_of_pairRefl_fixed {L : Type} [Field L] (a : Fin Tag.E6.rank → Lˣ)
    {α β : Fin Tag.E6.rank → ℤ} (h : IsA2Pair (τ := Tag.E6) α β)
    (hfix : weylTuple (pairRefl (τ := Tag.E6) (α, β)) a = a) :
    rootChar a α = 1 ∧ rootChar a β = 1 := by
  refine rootChar_eq_one_of_pairRefl_fixed_E6 h a fun v => ?_
  have e := rootChar_weylTuple (pairRefl (τ := Tag.E6) (α, β)) a (pairRefl (α, β) • v)
  rw [hfix, inv_smul_smul] at e
  exact e

end CFSG.StandardType.SCFourCover
