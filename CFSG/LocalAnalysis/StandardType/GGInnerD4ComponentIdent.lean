theorem componentD4Identification_of_W1W2 (h1 : NonfixedNotD4) (h2 : FixedD4Shape) :
    ComponentD4Identification := by
  intro hRig K V _ _ _ _ _ _ n n' hn hn' hcard Q hQ hT x hx J hJ hlab
  have hpℓ : 3 ≠ ringChar K := by
    rw [ringChar.eq (R := K) 2]
    norm_num
  have hdich :=
    CFSG.LocalAnalysis.GLTheoremA.KD264Lie.exists_component_dichotomy
      (p := 3) (by norm_num) (by norm_num) hQ hT hpℓ hx J hJ
  rcases hdich with ⟨h, hh, hne, hq, hJeq⟩ | ⟨_hlist, F, hFq, hFsup, hFnorm, hJeq⟩
  · rw [hJeq] at hlab
    exact absurd hlab (h1 hRig K V n n' hn hn' hcard Q x hx h hh hne hq)
  · obtain ⟨hn'n, hdim, hplus, hFeq⟩ :=
      h2 hRig K V n n' hn hn' hcard Q hQ x hx F hFq hFsup hFnorm J hJeq hlab
    refine ⟨hn'n, hdim, hplus, ?_⟩
    rw [hJeq, hFeq]
    rfl

theorem componentD4Identification_holds : ComponentD4Identification :=
  componentD4Identification_of_W1W2 nonfixedNotD4_holds fixedD4Shape_holds

