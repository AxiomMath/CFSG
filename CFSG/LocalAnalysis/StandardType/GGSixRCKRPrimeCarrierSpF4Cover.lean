private def conjActsOn {H G : Type*} [Group H] [Group G] (ψ : H →* G) : Subgroup G where
  carrier := {g | ∃ W : H, ∀ X, g * ψ X * g⁻¹ = ψ (W * X * W⁻¹)}
  one_mem' := ⟨1, fun X => by simp⟩
  mul_mem' := by
    rintro g h ⟨W, hW⟩ ⟨V, hV⟩
    refine ⟨W * V, fun X => ?_⟩
    have e : (g * h) * ψ X * (g * h)⁻¹ = g * (h * ψ X * h⁻¹) * g⁻¹ := by group
    rw [e, hV, hW]
    rw [show W * (V * X * V⁻¹) * W⁻¹ = (W * V) * X * (W * V)⁻¹ by group]
  inv_mem' := by
    rintro g ⟨W, hW⟩
    refine ⟨W⁻¹, fun X => ?_⟩
    have h1 := hW (W⁻¹ * X * W)
    have h2 : W * (W⁻¹ * X * W) * W⁻¹ = X := by group
    rw [h2] at h1
    calc g⁻¹ * ψ X * (g⁻¹)⁻¹
        = g⁻¹ * (g * ψ (W⁻¹ * X * W) * g⁻¹) * g := by rw [h1, inv_inv]
      _ = ψ (W⁻¹ * X * W) := by group
      _ = ψ (W⁻¹ * X * (W⁻¹)⁻¹) := by rw [inv_inv]

private theorem sp_norm_conj {G : Type*} [Group G] {F : G →* G} {s : ℕ} [NeZero s]
    (P : CycFamily F s) (y : P.S 0) {g : G} (hg : g ∈ P.S 0) :
    (P.norm y : G) * g * (P.norm y : G)⁻¹ = (y : G) * g * (y : G)⁻¹ := by
  classical
  set u : ∀ k, P.S k := P.diag y with hu
  have hu0 : u 0 = y := by
    show P.iter 0 y = y
    ext
    rw [CycFamily.coe_iter]
    simp
  have hdecomp : u = Pi.mulSingle 0 y * Function.update u 0 1 := by
    funext j
    by_cases hj : j = 0
    · subst hj
      simp [hu0]
    · simp [Pi.mul_apply, Pi.mulSingle_eq_of_ne hj, Function.update_of_ne hj]
  set m : G := P.mu (Function.update u 0 1) with hm
  have hnorm : (P.norm y : G) = (y : G) * m := by
    rw [CycFamily.norm, MonoidHom.comp_apply, ← hu, hdecomp, map_mul, P.mu_mulSingle]
  have hm_comm : Commute (g : G) m := by
    have h1 : Commute (P.mu (Pi.mulSingle 0 ⟨g, hg⟩)) (P.mu (Function.update u 0 1)) := by
      refine P.commute_mu_of_commute _ _ ?_
      funext j
      by_cases hj : j = 0
      · subst hj
        simp
      · simp [Pi.mul_apply, Pi.mulSingle_eq_of_ne hj, Function.update_of_ne hj]
    rwa [P.mu_mulSingle] at h1
  calc (P.norm y : G) * g * (P.norm y : G)⁻¹
      = ((y : G) * m) * g * (((y : G) * m))⁻¹ := by rw [hnorm]
    _ = (y : G) * g * (y : G)⁻¹ := by
      rw [_root_.mul_inv_rev]
      calc ((y : G) * m) * g * (m⁻¹ * (y : G)⁻¹)
          = (y : G) * (m * g * m⁻¹) * (y : G)⁻¹ := by group
        _ = (y : G) * g * (y : G)⁻¹ := by
          rw [hm_comm.eq.symm]
          group

theorem sp_exists_hom_act_of_frame
    {p₀ : ℕ} (S : LangSetup Tag.F4 L p₀) {a : Fin Tag.F4.rank → Lˣ}
    (hT : rootDiagUnit Tag.F4 a ∈ S.D.torus) (i : KernelComponent (rootCharHom a))
    (hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.F4.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]))
    {n : ℕ} {ψ : ↥(StatedSp n L) →* ModGL Tag.F4 L} (hψinj : Function.Injective ψ)
    (hψrange : ψ.range = rootSpan Tag.F4 L (componentRoots (rootCharHom a) i))
    (hψfrob : ∀ (σ : L ≃+* L) (X : ↥(StatedSp n L)),
      frobGL σ (ψ X) = ψ (statedSpMap (σ : L →+* L) n X))
    (hψtorus : ∀ t ∈ torusGroup Tag.F4 L, ∃ W : ↥(StatedSp n L), ∀ X,
      t * ψ X * t⁻¹ = ψ (W * X * W⁻¹))
    {h : ℕ} (hq : S.D.q = 2 ^ h)
    (hnQ : 3 ≤ n ∨ 4 ≤ 2 ^ (h * componentOrbitLength S.ρ (componentRoots (rootCharHom a) i))) :
    ∃ σQ : L ≃+* L,
      (∀ c, σQ c = c ^ (2 ^ (h * componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)))) ∧
      (∀ y ∈ torusGroup Tag.F4 L ⊔ rootSpan Tag.F4 L (kernelRoots (rootCharHom a)),
        ∃ W : ↥(StatedSp n L), ∀ X, y * ψ X * y⁻¹ = ψ (W * X * W⁻¹)) ∧
      ∃ z ∈ torusGroup Tag.F4 L ⊔ rootSpan Tag.F4 L (kernelRoots (rootCharHom a)),
      ∃ f : ↥(StatedSp n ↥(fixSubfield σQ)) →* ModGL Tag.F4 L,
        f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i ∧ Function.Injective f ∧
        ∀ (X : ↥(StatedSp n ↥(fixSubfield σQ))),
          ∀ g ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i),
            f X * g * (f X)⁻¹ =
              (z * ψ (statedSpMap (fixSubfield σQ).subtype n X) * z⁻¹) * g *
                (z * ψ (statedSpMap (fixSubfield σQ).subtype n X) * z⁻¹)⁻¹ := by
  classical
  obtain ⟨hs0, hs, hmin⟩ := outer_componentOrbitLength_spec S hT i
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) with hsdef
  haveI : NeZero s := ⟨hs0.ne'⟩
  have hs0' : 0 < s := hs0
  obtain ⟨σQ, z, hσc, hzZ, hnorm, hz⟩ := exists_untwistT_Z S hT i hs0' hinner
  have hσeq : ∀ c, σQ c = c ^ (2 ^ (h * s)) := fun c => by rw [hσc, hq, ← pow_mul]
  have hψS : ∀ X : ↥(StatedSp n L),
      ψ X ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) := fun X => by
    rw [← hψrange]
    exact ⟨X, rfl⟩
  set P := outerOrbitFamily S hT i hs hmin with hP
  have hP0 : P.S 0 = rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) := by
    rw [hP, outerOrbitFamily_S, ZMod.val_zero]
    simp only [Function.iterate_zero, id_eq, Set.image_id']
  have hconj : ∀ X : ↥(StatedSp n L), iterHom S.D.step s (z * ψ X * z⁻¹) =
      z * ψ (statedSpMap (σQ : L →+* L) n X) * z⁻¹ := by
    intro X
    rw [hz (ψ X) (hψS X), hψfrob σQ X]
  have hacts : torusGroup Tag.F4 L ⊔ rootSpan Tag.F4 L (kernelRoots (rootCharHom a)) ≤
      conjActsOn ψ := by
    refine sup_le ?_ ?_
    · intro t ht
      exact hψtorus t ht
    · rw [← iSup_componentRootSpan L (χ := rootCharHom a)]
      refine iSup_le fun j => ?_
      by_cases hji : j = i
      · subst hji
        intro g hg
        have hg' : g ∈ ψ.range := by
          rw [hψrange]
          exact hg
        obtain ⟨X, rfl⟩ := hg'
        exact ⟨X, fun Y => by simp⟩
      · intro g hg
        have h1 := componentRootSpan_le_centralizer L (χ := rootCharHom a) (Ne.symm hji)
        have h2 : ψ.range ≤ componentRootSpan L (rootCharHom a) i := by
          rw [hψrange]
          exact le_rfl
        refine ⟨1, fun X => ?_⟩
        have hcomm := Subgroup.mem_centralizer_iff.1 (h1 (h2 ⟨X, rfl⟩)) g hg
        simp only [map_one, mul_one, inv_one]
        rw [hcomm]
        group
  have hzA : ∀ y ∈ P.A, z * y * z⁻¹ ∈ P.A := by
    have h : P.A ≤ P.A.comap (MulAut.conj z).toMonoidHom := by
      refine iSup_le fun k => ?_
      obtain ⟨j, hj⟩ := outer_iterate_image_component S hT i k.val
      intro g hg
      have hg' : g ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) j) := by
        rw [hj]
        exact hg
      have h2 := (hnorm j g).1 hg'
      rw [hj] at h2
      exact P.S_le_A k h2
    exact fun y hy => h hy
  have hZconj : ∀ x : ModGL Tag.F4 L, z * x * z⁻¹ ∈ P.Z → x ∈ P.Z := by
    intro x hx
    rw [CycFamily.mem_Z] at hx ⊢
    intro y hy
    have := hx _ (hzA y hy)
    have e1 : z * y * z⁻¹ * (z * x * z⁻¹) = z * (y * x) * z⁻¹ := by group
    have e2 : z * x * z⁻¹ * (z * y * z⁻¹) = z * (x * y) * z⁻¹ := by group
    rw [e1, e2] at this
    simpa using this
  have hcenterL : Subgroup.center ↥(StatedSp n L) = ⊥ :=
    CFSG.SeitzReduction.SymplecticPilot.center_statedSp_eq_bot (K := L) n
  have hcentral : ∀ X : ↥(StatedSp n L), ψ X ∈ P.Z → X = 1 := by
    intro X hX
    have hXc : X ∈ Subgroup.center ↥(StatedSp n L) := by
      rw [Subgroup.mem_center_iff]
      intro Y
      apply hψinj
      rw [map_mul, map_mul]
      exact (CycFamily.mem_Z P).1 hX (ψ Y) (P.S_le_A 0 (by rw [hP0]; exact hψS Y))
    rw [hcenterL] at hXc
    simpa using hXc
  let K : Subfield L := fixSubfield σQ
  let ι : ↥(StatedSp n ↥K) →* ↥(StatedSp n L) := statedSpMap K.subtype n
  have hιinj : Function.Injective ι := statedSpMap_injective K.subtype n
  have hfixK : ∀ x : L, (σQ : L →+* L) x = x ↔ x ∈ Set.range K.subtype := by
    intro x
    constructor
    · intro hx
      exact ⟨⟨x, (mem_fixSubfield σQ).2 hx⟩, rfl⟩
    · rintro ⟨k, rfl⟩
      exact k.2
  have hιrange : ∀ Y : ↥(StatedSp n L), statedSpMap (σQ : L →+* L) n Y = Y →
      ∃ c : ↥(StatedSp n ↥K), ι c = Y := by
    intro Y hY
    have hY' : Y ∈ MonoidHom.eqLocus (statedSpMap (σQ : L →+* L) n) (MonoidHom.id _) := by
      simpa using hY
    rw [← range_statedSpMap_eq_eqLocus K.subtype (σQ : L →+* L) hfixK n] at hY'
    obtain ⟨c, hc⟩ := hY'
    exact ⟨c, hc⟩
  have hσι : ∀ c : ↥(StatedSp n ↥K), statedSpMap (σQ : L →+* L) n (ι c) = ι c := by
    intro c
    apply Subtype.ext
    apply Units.ext
    ext i j
    simp only [coe_statedSpMap, coe_map_GL, Matrix.map_apply]
    exact (mem_fixSubfield σQ).1
      (((c : GL (Fin n ⊕ Fin n) ↥K) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ↥K) i j).2
  let θ : ↥(StatedSp n ↥K) →* ModGL Tag.F4 L := (MulAut.conj z).toMonoidHom.comp (ψ.comp ι)
  have hθ : ∀ c, θ c = z * ψ (ι c) * z⁻¹ := fun c => rfl
  have hθS : ∀ c, θ c ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) := fun c => by
    rw [hθ]
    exact (hnorm i _).1 (hψS _)
  have hθfix : ∀ c, iterHom S.D.step s (θ c) = θ c := fun c => by
    rw [hθ, hconj, hσι]
  have hpre : ∀ g ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i),
      ∃ X : ↥(StatedSp n L), g = z * ψ X * z⁻¹ := by
    intro g hg
    have h1 : z⁻¹ * g * z ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) := by
      refine (hnorm i _).2 ?_
      have e : z * (z⁻¹ * g * z) * z⁻¹ = g := by group
      rw [e]
      exact hg
    rw [← hψrange] at h1
    obtain ⟨X, hX⟩ := h1
    exact ⟨X, by rw [hX]; group⟩
  have hfixmod : ∀ X : ↥(StatedSp n L),
      iterHom S.D.step s (z * ψ X * z⁻¹) * (z * ψ X * z⁻¹)⁻¹ ∈ P.Z →
        statedSpMap (σQ : L →+* L) n X = X := by
    intro X hX
    have e : iterHom S.D.step s (z * ψ X * z⁻¹) * (z * ψ X * z⁻¹)⁻¹ =
        z * ψ (statedSpMap (σQ : L →+* L) n X * X⁻¹) * z⁻¹ := by
      rw [hconj, map_mul, map_inv]
      group
    rw [e] at hX
    have hY := hcentral _ (hZconj _ hX)
    exact mul_inv_eq_one.mp hY
  have hθY : ∀ g g' : ModGL Tag.F4 L,
      g ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) →
      g' ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) →
      iterHom S.D.step s g * g⁻¹ ∈ P.Z →
      iterHom S.D.step s g' * g'⁻¹ ∈ P.Z → ⁅g, g'⁆ ∈ θ.range := by
    intro g g' hg hg' hgZ hg'Z
    obtain ⟨X, rfl⟩ := hpre g hg
    obtain ⟨X', rfl⟩ := hpre g' hg'
    have hX : statedSpMap (σQ : L →+* L) n X = X := hfixmod X hgZ
    have hX' : statedSpMap (σQ : L →+* L) n X' = X' := hfixmod X' hg'Z
    obtain ⟨c, hc⟩ := hιrange X hX
    obtain ⟨c', hc'⟩ := hιrange X' hX'
    refine ⟨⁅c, c'⁆, ?_⟩
    rw [map_commutatorElement]
    have hgc : θ c = z * ψ X * z⁻¹ := by rw [hθ, hc]
    have hgc' : θ c' = z * ψ X' * z⁻¹ := by rw [hθ, hc']
    rw [hgc, hgc']
  have hθZ : ∀ c : ↥(StatedSp n ↥K), θ c ∈ P.Z →
      c ∈ Subgroup.center ↥(StatedSp n ↥K) := by
    intro c hc
    rw [hθ] at hc
    have h := hcentral _ (hZconj _ hc)
    rw [Subgroup.mem_center_iff]
    intro c2
    apply hιinj
    rw [map_mul, map_mul, h]
    simp
  obtain ⟨f, hf1, hfker, hf2, hfn⟩ :=
    rationalComponent_eq_range_of_hom_norm S hT i hs hmin θ hθS hθfix hθY hθZ
  have hpos : 0 < h := by
    have hq2 : 2 ≤ S.D.q := by
      obtain ⟨r, e, hr, he, hqe⟩ := (isPrimePow_nat_iff S.D.q).1 S.hqpow.1
      rw [← hqe]
      exact le_trans hr.two_le (Nat.le_self_pow (by omega) r)
    rcases Nat.eq_zero_or_pos h with h0 | hh
    · rw [h0] at hq
      simp at hq
      omega
    · exact hh
  have hkspos : 0 < h * s := Nat.mul_pos hpos hs0'
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hfinK, hKcard⟩ := finite_card_fixSubfield (L := L) (r := 2) (n := h * s)
    hkspos σQ hσeq
  haveI : Fintype ↥K := Fintype.ofFinite ↥K
  haveI : CharP ↥K 2 := Subfield.charP K 2
  have hcenterK : Subgroup.center ↥(StatedSp n ↥K) = ⊥ :=
    CFSG.SeitzReduction.SymplecticPilot.center_statedSp_eq_bot (K := ↥K) n
  have hperfHyp : (∃ t : Finset ↥K, t.card = 4) ∨
      (Nat.card ↥K = 3 ∧ 2 ≤ n) ∨ (Nat.card ↥K = 2 ∧ 3 ≤ n) := by
    rcases hnQ with hn3 | h4
    · by_cases h4K : 4 ≤ Nat.card ↥K
      · left
        obtain ⟨t, -, ht⟩ := Finset.exists_subset_card_eq
          (s := (Finset.univ : Finset ↥K)) (n := 4)
          (by simpa [Nat.card_eq_fintype_card] using h4K)
        exact ⟨t, ht⟩
      · right
        right
        have hks1 : h * s = 1 := by
          rcases lt_or_ge (h * s) 2 with hlt | hge
          · omega
          · exfalso
            have h2le : 2 ^ 2 ≤ 2 ^ (h * s) :=
              Nat.pow_le_pow_right (by norm_num : 0 < 2) hge
            exact h4K (by
              change 4 ≤ Nat.card (fixSubfield σQ)
              rw [hKcard]
              norm_num at h2le ⊢
              exact h2le)
        refine ⟨?_, hn3⟩
        change Nat.card (fixSubfield σQ) = 2
        rw [hKcard, hks1]
        norm_num
    · left
      have h4K : 4 ≤ Nat.card ↥K := by
        change 4 ≤ Nat.card (fixSubfield σQ)
        rw [hKcard]
        exact h4
      obtain ⟨t, -, ht⟩ := Finset.exists_subset_card_eq
        (s := (Finset.univ : Finset ↥K)) (n := 4)
        (by simpa [Nat.card_eq_fintype_card] using h4K)
      exact ⟨t, ht⟩
  have hperf : Group.IsPerfect ↥(StatedSp n ↥K) :=
    CFSG.ClassicalGroups.Symplectic.isPerfect_statedSp n ↥K hperfHyp
  have hfkerbot : f.ker = ⊥ := le_bot_iff.mp (hfker.trans (le_of_eq hcenterK))
  have hfinj : Function.Injective f := (MonoidHom.ker_eq_bot_iff f).mp hfkerbot
  have hfeq : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
    le_antisymm (hf2 hperf) hf1
  let θ₀ : ↥(StatedSp n ↥K) →* P.S 0 := θ.codRestrict (P.S 0) fun c => by
    rw [hP0]
    exact hθS c
  have hfeq_norm : f = P.norm.comp θ₀ := by
    refine MonoidHom.ext fun c => ?_
    rw [hfn c (θ₀ c) rfl]
    rfl
  have hact : ∀ (X : ↥(StatedSp n ↥K)) (g : ModGL Tag.F4 L),
      g ∈ rootSpan Tag.F4 L (componentRoots (rootCharHom a) i) →
      f X * g * (f X)⁻¹ =
        (z * ψ (ι X) * z⁻¹) * g * (z * ψ (ι X) * z⁻¹)⁻¹ := by
    intro X g hg
    rw [hfeq_norm]
    have hgP : g ∈ P.S 0 := by rw [hP0]; exact hg
    change P.norm (θ₀ X) * g * (P.norm (θ₀ X))⁻¹ =
      (z * ψ (ι X) * z⁻¹) * g * (z * ψ (ι X) * z⁻¹)⁻¹
    rw [sp_norm_conj P (θ₀ X) hgP]
    change θ X * g * (θ X)⁻¹ =
      (z * ψ (ι X) * z⁻¹) * g * (z * ψ (ι X) * z⁻¹)⁻¹
    rw [hθ X]
  refine ⟨σQ, ?_, ?_⟩
  · simpa [hsdef] using hσeq
  · refine ⟨?_, z, hzZ, f, hfeq, hfinj, ?_⟩
    · intro y hy
      exact hacts hy
    · intro X g hg
      simpa [ι, K] using hact X g hg

theorem sp_exists_cover_torusConj_of_frame
    {p₀ : ℕ} (S : LangSetup Tag.F4 L p₀) {a : Fin Tag.F4.rank → Lˣ}
    (hT : rootDiagUnit Tag.F4 a ∈ S.D.torus) (i : KernelComponent (rootCharHom a))
    (hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.F4.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]))
    {n : ℕ} {ψ : ↥(StatedSp n L) →* ModGL Tag.F4 L} (hψinj : Function.Injective ψ)
    (hψrange : ψ.range = rootSpan Tag.F4 L (componentRoots (rootCharHom a) i))
    (hψfrob : ∀ (σ : L ≃+* L) (X : ↥(StatedSp n L)),
      frobGL σ (ψ X) = ψ (statedSpMap (σ : L →+* L) n X))
    (hψtorus : ∀ t ∈ torusGroup Tag.F4 L, ∃ W : ↥(StatedSp n L), ∀ X,
      t * ψ X * t⁻¹ = ψ (W * X * W⁻¹))
    {h : ℕ} (hq : S.D.q = 2 ^ h)
    (hnQ : 3 ≤ n ∨ 4 ≤ 2 ^ (h * componentOrbitLength S.ρ (componentRoots (rootCharHom a) i))) :
    ∃ σQ : L ≃+* L, Finite ↥(fixSubfield σQ) ∧
      Nat.card ↥(fixSubfield σQ) =
        S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) ∧
      ∃ f : ↥(StatedSp n ↥(fixSubfield σQ)) →* ModGL Tag.F4 L,
        f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i ∧ Function.Injective f ∧
        ∀ b ∈ S.D.torus, ∃ C : ↥(StatedSp n ↥(fixSubfield σQ)),
          ∀ X, b⁻¹ * f X * b = f (C * X * C⁻¹) := by
  obtain ⟨σQ, hσQ, hψact, z, hz, f, hfrange, hfinj, hfact⟩ :=
    sp_exists_hom_act_of_frame S hT i hinner hψinj hψrange hψfrob hψtorus hq hnQ
  obtain ⟨hs0, -, -⟩ := outer_componentOrbitLength_spec S hT i
  have hh : 0 < h := by
    obtain ⟨r, e, hr, -, he, hqr⟩ := exists_char_pow S
    refine Nat.pos_of_ne_zero fun h0 => ?_
    rw [hq, h0, pow_zero] at hqr
    exact (Nat.one_lt_pow he.ne' hr.one_lt).ne hqr
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hfin, hcard⟩ := finite_card_fixSubfield (L := L) (r := 2)
    (Nat.mul_pos hh hs0) σQ hσQ
  exact ⟨σQ, hfin, by rw [hcard, hq, ← pow_mul], f, hfrange, hfinj, fun b hb =>
    exists_spConj_of_mem_torus S hT i σQ hψinj hψrange hψact hz f hfrange hfact hb⟩

theorem sp3_exists_cover_torusConj
    {p₀ : ℕ} (S : LangSetup Tag.F4 L p₀) {a : Fin Tag.F4.rank → Lˣ}
    (hT : rootDiagUnit Tag.F4 a ∈ S.D.torus) (i : KernelComponent (rootCharHom a))
    (v : WeylGroup Tag.F4) {J : Set (Fin Tag.F4.rank)} (hJ : J = f4LeviB3 ∨ J = f4LeviC3)
    (hroots : componentRoots (rootCharHom a) i = (fun α => v • α) '' parabolicRoots Tag.F4 J)
    (hkind : twistKind S.ρ (rootCharHom a) i = .inner) {h : ℕ} (hq : S.D.q = 2 ^ h) :
    ∃ σQ : L ≃+* L, Finite ↥(fixSubfield σQ) ∧
      Nat.card ↥(fixSubfield σQ) =
        S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) ∧
      ∃ f : ↥(StatedSp 3 ↥(fixSubfield σQ)) →* ModGL Tag.F4 L,
        f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i ∧ Function.Injective f ∧
        ∀ b ∈ S.D.torus, ∃ C : ↥(StatedSp 3 ↥(fixSubfield σQ)),
          ∀ X, b⁻¹ * f X * b = f (C * X * C⁻¹) := by
  obtain ⟨ψ, hψinj, hψrange, hψfrob, hψtorus⟩ := exists_sp3Frame (L := L) v hJ
  rw [← hroots] at hψrange
  exact sp_exists_cover_torusConj_of_frame S hT i
    (twistInner_of_twistKind_eq_innerT S rootAutIsWeyl_holds hT i hkind) hψinj hψrange hψfrob
    hψtorus hq (Or.inl le_rfl)

