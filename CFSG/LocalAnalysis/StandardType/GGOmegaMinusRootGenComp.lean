section PerfectCore

variable [Finite K] [CharP K 2]

theorem kOmM_perfectCore_long_of_param {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {l : Fin r} {Ts : Set (Fin r → Kˣ)}
    {κ : Kˣ} (hκ : κ * κ ≠ 1) (hTs1 : ∀ t ∈ Ts, t l = 1)
    (hTsκ : ∀ l', l' ≠ l → Pi.mulSingle l' κ ∈ Ts) :
    perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
      centralizer (kOmMDiag K r '' Ts)) =
      (StatedOmega (StatedQuadMinus 2 K b c)).map
        (coordEmbedGL (kOmMLongEmb r l) (kOmMLongEmb_injective l)) := by
  have hw1 : ∀ t ∈ Ts, ∀ a ∈ Set.range (kOmMLongEmb r l), kOmMWeight K r t a = 1 := by
    intro t ht a ha
    rcases kOmM_mem_range_longEmb_iff.1 ha with rfl | rfl | ⟨j, rfl⟩
    · rw [kOmMWeight_inl, hTs1 t ht, Units.val_one]
    · rw [kOmMWeight_inr_inl, hTs1 t ht, inv_one, Units.val_one]
    · rfl
  have hSC : suppGL K (Set.range (kOmMLongEmb r l)) ≤ centralizer (kOmMDiag K r '' Ts) := by
    intro x hx
    rw [mem_centralizer_iff]
    rintro _ ⟨t, ht, rfl⟩
    refine ((commute_of_diag_iff (fun a b hab => kOmMDiag_apply_ne t hab) x).2
      fun a a' haa => ?_).eq.symm
    rw [kOmMDiag_apply_self, kOmMDiag_apply_self] at haa
    by_cases h : a ∈ Set.range (kOmMLongEmb r l) ∧ a' ∈ Set.range (kOmMLongEmb r l)
    · exact absurd ((hw1 t ht a h.1).trans (hw1 t ht a' h.2).symm) haa
    · have hne : a ≠ a' := fun e => haa (e ▸ rfl)
      rw [hx a a' h, Matrix.one_apply_ne hne]
  rw [perfectCore_inf_centralizer_eq_perfectCore_inf_suppGL (T := Set.univ)
      (fun x _ a b hab => absurd ⟨Set.mem_univ a, Set.mem_univ b⟩ hab) (kOmMDiag K r '' Ts)
      (by rintro _ ⟨t, -, rfl⟩ a b hab; exact kOmMDiag_apply_ne t hab)
      (fun a _ a' _ haa hS => by
        rcases hS with ha | ha
        · obtain ⟨l', hl', hal⟩ := kOmM_exists_of_not_mem_range_longEmb ha
          exact ⟨kOmMDiag K r (Pi.mulSingle l' κ),
            ⟨_, hTsκ l' hl', rfl⟩, by
              rw [kOmMDiag_apply_self, kOmMDiag_apply_self]
              exact kOmMWeight_mulSingle_ne hκ l' haa hal⟩
        · obtain ⟨l', hl', hal⟩ := kOmM_exists_of_not_mem_range_longEmb ha
          exact ⟨kOmMDiag K r (Pi.mulSingle l' κ),
            ⟨_, hTsκ l' hl', rfl⟩, by
              rw [kOmMDiag_apply_self, kOmMDiag_apply_self]
              exact (kOmMWeight_mulSingle_ne hκ l' haa.symm hal).symm⟩),
    inf_of_le_left (inf_le_right.trans hSC)]
  exact (kOmM_isCoordSplit_long b c l).perfectCore_statedOmega_inf_suppGL
    (kOmMLongEmb_injective l) (F4Pilot.commutator_statedOmega_quadMinus_two hirr)

theorem kOmM_perfectCore_short_of_param (hK : 4 ≤ Nat.card K) {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {i j : Fin r} (hij : i ≠ j)
    {Ts : Set (Fin r → Kˣ)} {κ : Kˣ} (hκ : κ * κ ≠ 1)
    (hTs1 : ∀ t ∈ Ts, t i = t j) (hTsκ : (fun _ => κ) ∈ Ts)
    (hsep : ∀ a b : Fin r ⊕ Fin r, a ≠ b → ¬ OmegaPilot.SameSide ({i, j} : Finset (Fin r)) a b →
      ∃ s ∈ Ts, diagSpEntry s a ≠ diagSpEntry s b) :
    perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
      centralizer (kOmMDiag K r '' Ts)) =
      (OmegaPilot.siegelBlockGL K {i, j}).map
        (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) := by
  have hsplit := kOmM_isCoordSplit_hyp r (K := K) b c
  have hJc : ({i, j} : Finset (Fin r)).card = 2 := Finset.card_pair hij
  have hconst : ∀ s ∈ Ts, ∀ i' ∈ ({i, j} : Finset (Fin r)),
      ∀ j' ∈ ({i, j} : Finset (Fin r)), s i' = s j' := by
    intro s hs i' hi' j' hj'
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi' hj'
    rcases hi' with rfl | rfl <;> rcases hj' with rfl | rfl
    · rfl
    · exact hTs1 s hs
    · exact (hTs1 s hs).symm
    · rfl
  have hLevi : perfectCore (StatedOmega (StatedQuadPlus r K) ⊓
      centralizer (OmegaPilot.diagOmega K r '' Ts)) = OmegaPilot.siegelBlockGL K {i, j} := by
    rw [OmegaPilot.perfectCore_statedOmega_inf_centralizer_eq_level hK (J := {i, j})
        (by rw [hJc]) Ts hconst hsep,
      OmegaPilot.siegelBlockGL_eq_map_omegaLeviSL hK (by rw [hJc])]
  rw [kOmM_perfectCore_eq_inf_suppGL_hyp hirr hκ hTsκ]
  apply le_antisymm
  · have hX : StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓ centralizer (kOmMDiag K r '' Ts) ⊓
        suppGL K (Set.range (kOmMEmb r)) ≤
        (isoClosure (StatedQuadPlus r K) ⊓ centralizer (OmegaPilot.diagOmega K r '' Ts)).map
          (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) := by
      rintro x ⟨⟨hxO, hxC⟩, hxS⟩
      obtain ⟨y, hy, rfl⟩ :=
        hsplit.statedOmega_inf_suppGL_le_map kOmMEmb_injective (mem_inf.2 ⟨hxO, hxS⟩)
      exact ⟨y, mem_inf.2 ⟨hy, (kOmM_coordEmbedGL_mem_centralizer_iff y).1 hxC⟩, rfl⟩
    calc _ ≤ perfectCore ((isoClosure (StatedQuadPlus r K) ⊓
          centralizer (OmegaPilot.diagOmega K r '' Ts)).map
            (coordEmbedGL (kOmMEmb r) kOmMEmb_injective)) := perfectCore_mono hX
      _ = (perfectCore (isoClosure (StatedQuadPlus r K) ⊓
          centralizer (OmegaPilot.diagOmega K r '' Ts))).map
            (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) :=
          (CFSG.Quasithin.map_perfectCore _ _).symm
      _ ≤ _ := by
          refine map_mono ?_
          rw [← hLevi]
          refine le_perfectCore_of_perfect ?_ (perfectCore_perfect _)
          calc perfectCore (isoClosure (StatedQuadPlus r K) ⊓
                centralizer (OmegaPilot.diagOmega K r '' Ts)) =
                ⁅perfectCore (isoClosure (StatedQuadPlus r K) ⊓
                  centralizer (OmegaPilot.diagOmega K r '' Ts)),
                perfectCore (isoClosure (StatedQuadPlus r K) ⊓
                  centralizer (OmegaPilot.diagOmega K r '' Ts))⁆ := (perfectCore_perfect _).symm
            _ ≤ ⁅isoClosure (StatedQuadPlus r K) ⊓ centralizer (OmegaPilot.diagOmega K r '' Ts),
                isoClosure (StatedQuadPlus r K) ⊓
                  centralizer (OmegaPilot.diagOmega K r '' Ts)⁆ :=
                Subgroup.commutator_mono (perfectCore_le _) (perfectCore_le _)
            _ ≤ StatedOmega (StatedQuadPlus r K) ⊓
                centralizer (OmegaPilot.diagOmega K r '' Ts) :=
                le_inf (Subgroup.commutator_mono inf_le_left inf_le_left)
                  ((Subgroup.commutator_le_self _).trans inf_le_right)
  · refine le_perfectCore_of_perfect ?_
      (by rw [← Subgroup.map_commutator, OmegaPilot.commutator_siegelBlockGL hK (by rw [hJc])])
    rintro _ ⟨y, hy, rfl⟩
    have hyO : y ∈ StatedOmega (StatedQuadPlus r K) :=
      OmegaPilot.siegelBlockGL_le_statedOmega hK (by rw [hJc]) hy
    have hyC : y ∈ centralizer (OmegaPilot.diagOmega K r '' Ts) :=
      OmegaPilot.siegelBlockGL_le_centralizer hconst hy
    exact mem_inf.2 ⟨mem_inf.2 ⟨hsplit.map_statedOmega_le kOmMEmb_injective ⟨y, hyO, rfl⟩,
      (kOmM_coordEmbedGL_mem_centralizer_iff y).2 hyC⟩,
      F4Pilot.coordEmbedGL_mem_suppGL kOmMEmb_injective y⟩

end PerfectCore

section Orders

variable [Finite K] [CharP K 2]

theorem dvd_card_omMinusLongBlock (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (hpq : p ∣ Nat.card K - 1) (l : Fin m) :
    p ∣ Nat.card ((omMinusLongBlock K b c l).subgroupOf
      (StatedOmega (StatedQuadMinus (m + 1) K b c))) := by
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe (omMinusLongBlock_le hirr l)).toEquiv]
  have hcard : Nat.card (omMinusLongBlock K b c l) = F4Pilot.ordSL 2 (Nat.card K ^ 2) :=
    kOmM_card_long hirr l
  rw [hcard, F4Pilot.ordSL_two]
  have h1 : Nat.card K - 1 ∣ Nat.card K ^ 4 - 1 := by
    have := Nat.sub_dvd_pow_sub_pow (Nat.card K) 1 4
    simpa using this
  have hpow : (Nat.card K ^ 2) ^ 2 = Nat.card K ^ 4 := by rw [← pow_mul]
  rw [hpow]
  exact Dvd.dvd.mul_left (hpq.trans h1) _

theorem dvd_card_omMinusShortBlock (hK : 4 ≤ Nat.card K) (hpq : p ∣ Nat.card K - 1)
    {i j : Fin m} (hij : i ≠ j) :
    p ∣ Nat.card ((omMinusShortBlock K i j).subgroupOf
      (StatedOmega (StatedQuadMinus (m + 1) K b c))) := by
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe (omMinusShortBlock_le hK hij)).toEquiv]
  have hcard : Nat.card (omMinusShortBlock K i j) =
      Nat.card (Matrix.SpecialLinearGroup (Fin 2) K) := kOmM_card_short hij
  have hSL2 : Nat.card (Matrix.SpecialLinearGroup (Fin 2) K) =
      Nat.card K * (Nat.card K ^ 2 - 1) := by
    classical
    have := Fintype.ofFinite K
    have hq : 1 < Fintype.card K := Fintype.one_lt_card
    rw [Matrix.card_SL_field, Fin.prod_univ_two, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
      Nat.card_eq_fintype_card, show Fintype.card K ^ 2 - Fintype.card K =
        Fintype.card K * (Fintype.card K - 1) by rw [Nat.mul_sub_one, sq], ← mul_assoc,
      Nat.mul_div_cancel _ (by omega), mul_comm]
  rw [hcard, hSL2]
  have h1 : Nat.card K - 1 ∣ Nat.card K ^ 2 - 1 := by
    have := Nat.sub_dvd_pow_sub_pow (Nat.card K) 1 2
    simpa using this
  exact Dvd.dvd.mul_left (hpq.trans h1) _

end Orders

section Components

variable [Finite K] [CharP K 2]

private theorem sgnAut_eq_self_iff {p k : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (i : Fin k)
    (f : Fin k → Multiplicative (ZMod p)) : SpCoord.sgnAut i f = f ↔ f i = 1 := by
  constructor
  · intro h
    have h1 := congrFun h i
    rw [SpCoord.sgnAut_apply, Function.update_self] at h1
    have h2 : toAdd (f i) = -toAdd (f i) := by rw [← toAdd_inv, h1]
    rw [← ofAdd_toAdd (f i), SpCoord.coord_eq_zero_of_eq_neg hp hp2 h2, ofAdd_zero]
  · intro h
    rw [SpCoord.sgnAut_apply, h, inv_one, ← h, Function.update_eq_self]

private theorem permAut_swap_eq_self_iff {p k : ℕ} {a b : Fin k}
    (f : Fin k → Multiplicative (ZMod p)) :
    SpCoord.permAut (Equiv.swap a b) f = f ↔ f a = f b := by
  constructor
  · intro h
    have h1 := congrFun h a
    rw [SpCoord.permAut_apply, Function.comp_apply, Equiv.swap_inv, Equiv.swap_apply_left] at h1
    exact h1.symm
  · intro h
    funext j
    rw [SpCoord.permAut_apply, Function.comp_apply, Equiv.swap_inv]
    by_cases hja : j = a
    · subst hja
      rw [Equiv.swap_apply_left, h]
    · by_cases hjb : j = b
      · subst hjb
        rw [Equiv.swap_apply_right, h]
      · rw [Equiv.swap_apply_of_ne_of_ne hja hjb]

private theorem omMinusTorusParam_mulSingle (hζ : ζ ^ p = 1) (j : Fin m)
    (x : Multiplicative (ZMod p)) :
    omMinusTorusParam m hζ (Pi.mulSingle j x) =
      Pi.mulSingle j (TableBSymp.zmodPowHom hζ x) := by
  funext k
  rw [omMinusTorusParam_apply, Pi.mulSingle_apply, Pi.mulSingle_apply]
  by_cases h : k = j
  · rw [if_pos h, if_pos h]
  · rw [if_neg h, if_neg h, map_one]

private theorem isComponentOf_of_perfectCore_eq {G : Type*} [Group G] {C S : Subgroup G}
    (h : perfectCore C = S) (hq : CFSG.Assembly.IsQuasisimple S) :
    CFSG.Assembly.IsComponentOf S C := by
  subst h
  exact ⟨perfectCore_le C, CFSG.Assembly.IsSubnormal.step (perfectCore_le C)
    (perfectCore_normal C) (CFSG.Assembly.IsSubnormal.refl _), hq⟩

private theorem centralizer_omMinusTorus_image (b c : K) (hζ : ζ ^ p = 1)
    (X : Set (Fin m → Multiplicative (ZMod p))) :
    Subgroup.centralizer ((omMinusTorus (p := p) b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        X) =
      (StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓
        Subgroup.centralizer
          (kOmMDiag K m '' (omMinusTorusParam m (p := p) hζ '' X))).subgroupOf
        (StatedOmega (StatedQuadMinus (m + 1) K b c)) := by
  ext x
  rw [Subgroup.mem_centralizer_iff, Subgroup.mem_subgroupOf, Subgroup.mem_inf]
  constructor
  · intro h
    refine ⟨x.2, ?_⟩
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨_, ⟨f, hf, rfl⟩, rfl⟩
    simpa only [Subgroup.coe_mul, coe_omMinusTorus, omMinusTorusGL_apply] using
      congrArg Subtype.val (h _ ⟨f, hf, rfl⟩)
  · rintro ⟨-, h⟩
    rintro _ ⟨f, hf, rfl⟩
    exact Subtype.ext (h _ ⟨_, ⟨f, hf, rfl⟩, rfl⟩)

theorem isComponentOf_omMinusLongBlock (hK : 4 ≤ Nat.card K)
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (hp : p.Prime) (hp2 : p ≠ 2)
    (hζ : ζ ^ p = 1) (hζo : orderOf ζ = p) (l : Fin m) :
    CFSG.Assembly.IsComponentOf
      ((omMinusLongBlock K b c l).subgroupOf (StatedOmega (StatedQuadMinus (m + 1) K b c)))
      (Subgroup.centralizer ((omMinusTorus b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        {f | SpCoord.sgnAut l f = f})) := by
  classical
  have hκ : ζ * ζ ≠ 1 := by
    intro h
    have h1 : orderOf ζ ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [sq]; exact h)
    rw [hζo] at h1
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h1)
  have hχg : TableBSymp.zmodPowHom hζ (ofAdd (1 : ZMod p)) = ζ := by
    have h1 := TableBSymp.zmodPowHom_natCast hζ 1
    rwa [Nat.cast_one, pow_one] at h1
  have hTs1 : ∀ t ∈ (omMinusTorusParam m hζ '' {f | SpCoord.sgnAut l f = f}), t l = 1 := by
    intro t ht
    obtain ⟨f, hf, rfl⟩ := ht
    rw [omMinusTorusParam_apply, (sgnAut_eq_self_iff hp hp2 l f).1 hf, map_one]
  have hTsκ : ∀ l' : Fin m, l' ≠ l → Pi.mulSingle l' ζ ∈
      (omMinusTorusParam m hζ '' {f | SpCoord.sgnAut l f = f}) := by
    intro l' hl'
    refine ⟨Pi.mulSingle l' (ofAdd (1 : ZMod p)), ?_, ?_⟩
    · exact (sgnAut_eq_self_iff hp hp2 l _).2 (Pi.mulSingle_eq_of_ne (Ne.symm hl') _)
    · rw [omMinusTorusParam_mulSingle, hχg]
  have hcore : perfectCore (StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓
      centralizer (kOmMDiag K m ''
        (omMinusTorusParam m hζ '' {f | SpCoord.sgnAut l f = f}))) =
      omMinusLongBlock K b c l :=
    kOmM_perfectCore_long_of_param hirr hκ hTs1 hTsκ
  have hle : omMinusLongBlock K b c l ≤ StatedOmega (StatedQuadMinus (m + 1) K b c) :=
    omMinusLongBlock_le hirr l
  have hcent : Subgroup.centralizer ((omMinusTorus b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        {f | SpCoord.sgnAut l f = f}) =
      (StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓
        Subgroup.centralizer (kOmMDiag K m ''
          (omMinusTorusParam m hζ '' {f | SpCoord.sgnAut l f = f}))).subgroupOf
        (StatedOmega (StatedQuadMinus (m + 1) K b c)) :=
    centralizer_omMinusTorus_image b c hζ {f | SpCoord.sgnAut l f = f}
  have hpc : perfectCore (Subgroup.centralizer ((omMinusTorus b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        {f | SpCoord.sgnAut l f = f})) =
      (omMinusLongBlock K b c l).subgroupOf (StatedOmega (StatedQuadMinus (m + 1) K b c)) := by
    rw [hcent, ← CFSG.ComponentClassification.RankTwoExceptional.Exc.perfectCore_subgroupOf
      (H := StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓ centralizer (kOmMDiag K m ''
        (omMinusTorusParam m hζ '' {f | SpCoord.sgnAut l f = f})))
      (A := StatedOmega (StatedQuadMinus (m + 1) K b c)) inf_le_left, hcore]
  have hqblock : CFSG.Assembly.IsQuasisimple (omMinusLongBlock K b c l) := by
    have hQ : CFSG.Assembly.IsQuasisimple (StatedOmega (StatedQuadMinus 2 K b c)) :=
      OmegaMinus.isQuasisimple_statedOmega_quadMinus_two hirr
    exact CFSG.Assembly.IsQuasisimple.of_mulEquiv
      (Subgroup.equivMapOfInjective _ _
        (F4Pilot.coordEmbedGL_injective (kOmMLongEmb_injective l))).symm hQ
  have hq : CFSG.Assembly.IsQuasisimple ((omMinusLongBlock K b c l).subgroupOf
      (StatedOmega (StatedQuadMinus (m + 1) K b c))) :=
    CFSG.Assembly.IsQuasisimple.of_mulEquiv (Subgroup.subgroupOfEquivOfLe hle) hqblock
  exact isComponentOf_of_perfectCore_eq hpc hq

theorem isComponentOf_omMinusShortBlock (hK : 4 ≤ Nat.card K)
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (hp : p.Prime) (hp2 : p ≠ 2)
    (hζ : ζ ^ p = 1) (hζo : orderOf ζ = p) {i j : Fin m} (hij : i ≠ j) :
    CFSG.Assembly.IsComponentOf
      ((omMinusShortBlock K i j).subgroupOf (StatedOmega (StatedQuadMinus (m + 1) K b c)))
      (Subgroup.centralizer ((omMinusTorus b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        {f | SpCoord.permAut (Equiv.swap i j) f = f})) := by
  classical
  have hκ : ζ * ζ ≠ 1 := by
    intro h
    have h1 : orderOf ζ ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [sq]; exact h)
    rw [hζo] at h1
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h1)
  have hχg : TableBSymp.zmodPowHom hζ (ofAdd (1 : ZMod p)) = ζ := by
    have h1 := TableBSymp.zmodPowHom_natCast hζ 1
    rwa [Nat.cast_one, pow_one] at h1
  have hζne : (ζ : K) ≠ ((ζ⁻¹ : Kˣ) : K) := fun e =>
    units_ne_inv_of_mul_self_ne_one hκ (Units.ext e)
  have hTs1 : ∀ t ∈ (omMinusTorusParam m hζ ''
      {f | SpCoord.permAut (Equiv.swap i j) f = f}), t i = t j := by
    intro t ht
    obtain ⟨f, hf, rfl⟩ := ht
    rw [omMinusTorusParam_apply, omMinusTorusParam_apply,
      (permAut_swap_eq_self_iff f).1 hf]
  have hTsκ : (fun _ : Fin m => ζ) ∈
      (omMinusTorusParam m hζ '' {f | SpCoord.permAut (Equiv.swap i j) f = f}) := by
    refine ⟨fun _ => ofAdd (1 : ZMod p), ?_, ?_⟩
    · exact (permAut_swap_eq_self_iff _).2 rfl
    · funext k
      rw [omMinusTorusParam_apply, hχg]
  have hsep : ∀ a b : Fin m ⊕ Fin m, a ≠ b →
      ¬ OmegaPilot.SameSide ({i, j} : Finset (Fin m)) a b →
      ∃ s ∈ (omMinusTorusParam m hζ ''
        {f | SpCoord.permAut (Equiv.swap i j) f = f}),
        diagSpEntry s a ≠ diagSpEntry s b := by
    intro a b hab hside
    by_cases hbJ : planeOf b ∉ ({i, j} : Finset (Fin m))
    · refine ⟨omMinusTorusParam m hζ (Pi.mulSingle (planeOf b) (ofAdd (1 : ZMod p))),
        ⟨_, (permAut_swap_eq_self_iff _).2 ?_, rfl⟩, ?_⟩
      · rw [Pi.mulSingle_eq_of_ne (fun h => hbJ (by rw [h]; simp)),
          Pi.mulSingle_eq_of_ne (fun h => hbJ (by rw [h]; simp))]
      · rw [omMinusTorusParam_mulSingle, hχg]
        exact diagSpEntry_mulSingle_ne hκ hab (Or.inr (mem_coords_planeOf b))
    · by_cases haJ : planeOf a ∉ ({i, j} : Finset (Fin m))
      · refine ⟨omMinusTorusParam m hζ (Pi.mulSingle (planeOf a) (ofAdd (1 : ZMod p))),
          ⟨_, (permAut_swap_eq_self_iff _).2 ?_, rfl⟩, ?_⟩
        · rw [Pi.mulSingle_eq_of_ne (fun h => haJ (by rw [h]; simp)),
            Pi.mulSingle_eq_of_ne (fun h => haJ (by rw [h]; simp))]
        · rw [omMinusTorusParam_mulSingle, hχg]
          exact diagSpEntry_mulSingle_ne hκ hab (Or.inl (mem_coords_planeOf a))
      · have ha_mem : planeOf a ∈ ({i, j} : Finset (Fin m)) := not_not.mp haJ
        have hb_mem : planeOf b ∈ ({i, j} : Finset (Fin m)) := not_not.mp hbJ
        have hζfun : omMinusTorusParam m hζ (fun _ => ofAdd (1 : ZMod p)) = fun _ => ζ := by
          funext k
          rw [omMinusTorusParam_apply, hχg]
        refine ⟨omMinusTorusParam m hζ (fun _ => ofAdd (1 : ZMod p)),
          ⟨_, (permAut_swap_eq_self_iff _).2 rfl, rfl⟩, ?_⟩
        rw [hζfun]
        rcases a with x | x <;> rcases b with y | y
        · exact absurd (Or.inl ⟨x, ha_mem, y, hb_mem, rfl, rfl⟩) hside
        · simp only [diagSpEntry_inl, diagSpEntry_inr]
          exact hζne
        · simp only [diagSpEntry_inl, diagSpEntry_inr]
          exact hζne.symm
        · exact absurd (Or.inr ⟨x, ha_mem, y, hb_mem, rfl, rfl⟩) hside
  have hcore : perfectCore (StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓
      centralizer (kOmMDiag K m ''
        (omMinusTorusParam m hζ ''
          {f | SpCoord.permAut (Equiv.swap i j) f = f}))) =
      omMinusShortBlock K i j :=
    kOmM_perfectCore_short_of_param hK hirr hij hκ hTs1 hTsκ hsep
  have hle : omMinusShortBlock K i j ≤ StatedOmega (StatedQuadMinus (m + 1) K b c) :=
    omMinusShortBlock_le hK hij
  have hcent : Subgroup.centralizer ((omMinusTorus b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        {f | SpCoord.permAut (Equiv.swap i j) f = f}) =
      (StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓
        Subgroup.centralizer (kOmMDiag K m ''
          (omMinusTorusParam m hζ ''
            {f | SpCoord.permAut (Equiv.swap i j) f = f}))).subgroupOf
        (StatedOmega (StatedQuadMinus (m + 1) K b c)) :=
    centralizer_omMinusTorus_image b c hζ {f | SpCoord.permAut (Equiv.swap i j) f = f}
  have hpc : perfectCore (Subgroup.centralizer ((omMinusTorus b c hζ :
        (Fin m → Multiplicative (ZMod p)) →* StatedOmega (StatedQuadMinus (m + 1) K b c)) ''
        {f | SpCoord.permAut (Equiv.swap i j) f = f})) =
      (omMinusShortBlock K i j).subgroupOf (StatedOmega (StatedQuadMinus (m + 1) K b c)) := by
    rw [hcent, ← CFSG.ComponentClassification.RankTwoExceptional.Exc.perfectCore_subgroupOf
      (H := StatedOmega (StatedQuadMinus (m + 1) K b c) ⊓ centralizer (kOmMDiag K m ''
        (omMinusTorusParam m hζ ''
          {f | SpCoord.permAut (Equiv.swap i j) f = f})))
      (A := StatedOmega (StatedQuadMinus (m + 1) K b c)) inf_le_left, hcore]
  have hqblock : CFSG.Assembly.IsQuasisimple (omMinusShortBlock K i j) := by
    refine CFSG.Assembly.IsQuasisimple.of_mulEquiv
      (Subgroup.equivMapOfInjective _ _
        (F4Pilot.coordEmbedGL_injective kOmMEmb_injective)).symm ?_
    have he : Matrix.SpecialLinearGroup (Fin ({i, j} : Finset (Fin m)).card) K ≃*
        OmegaPilot.siegelBlockGL K ({i, j} : Finset (Fin m)) :=
      (siegelBlockEquiv (F := K) ({i, j} : Finset (Fin m))).trans
        (Subgroup.equivMapOfInjective _ _ (StatedSp m K).subtype_injective)
    refine CFSG.Assembly.IsQuasisimple.of_mulEquiv he.symm ?_
    rw [Finset.card_pair hij]
    have hq := CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_quasisimple
      2 K le_rfl (Or.inr (by omega)) (Or.inr (by omega))
    exact ⟨Group.isPerfect_def.mp hq.1, hq.2.1⟩
  have hq : CFSG.Assembly.IsQuasisimple ((omMinusShortBlock K i j).subgroupOf
      (StatedOmega (StatedQuadMinus (m + 1) K b c))) :=
    CFSG.Assembly.IsQuasisimple.of_mulEquiv (Subgroup.subgroupOfEquivOfLe hle) hqblock
  exact isComponentOf_of_perfectCore_eq hpc hq

