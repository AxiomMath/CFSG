theorem kernel_ncard_eq_eighteen_of_zeroCount_eq_six
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6)
    (hzc : (Finset.univ.filter (fun i : Fin ρ.row.diagram.marks.length =>
      ρ.row.s.getD i.val 0 = 0)).card = 6)
    (hchar : rootCharHom ρ.a ≠ 1) :
    (kernelRoots (rootCharHom ρ.a)).ncard = 18 := by
  change ltrb1g2_zeroCount ρ.row.diagram.marks.length ρ.row.s = 6 at hzc
  have htau : ρ.tau = Tag.E6 := by rw [← ρ.tau_eq, hE6]; rfl
  obtain ⟨r, hr8, hd, hc, hne0⟩ := ltrb1g2_rep_data ρ hE6
  have hrank : [6, 5, 5, 5, 5, 5, 4, 6].getD r 0 = 6 := by
    rw [← ltrb1g2_compRank_reps ρ.tau htau r hr8, hc, hzc]
  rcases ltrb1g2_rank_six r hr8 hrank with rfl | rfl
  · exact absurd rfl (hne0 hchar)
  · rw [hd]
    decide

theorem kernel_ncard_eq_twentyFour_of_zeroCount_eq_four
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6)
    (hzc : (Finset.univ.filter (fun i : Fin ρ.row.diagram.marks.length =>
      ρ.row.s.getD i.val 0 = 0)).card = 4) :
    (kernelRoots (rootCharHom ρ.a)).ncard = 24 := by
  have htau : ρ.tau = Tag.E6 := by rw [← ρ.tau_eq, hE6]; rfl
  obtain ⟨r, hr8, hd, hc, _⟩ := ltrb1g2_rep_data ρ hE6
  have hrank : [6, 5, 5, 5, 5, 5, 4, 6].getD r 0 = 4 := by
    change ltrb1g2_zeroCount ρ.row.diagram.marks.length ρ.row.s = 4 at hzc
    rw [← ltrb1g2_compRank_reps ρ.tau htau r hr8, hc, hzc]
  rcases ltrb1g2_rank_four r hr8 hrank with rfl
  rw [hd]
  decide

private lemma ltrb1g2_count_of_five
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6)
