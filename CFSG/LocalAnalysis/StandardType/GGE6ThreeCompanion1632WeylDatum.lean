private theorem ltrb1g2_qq_sum {n : ℕ} (c : Fin n → ℤ)
    (B : Fin n → (Fin Tag.E6.rank → ℤ)) :
    ltrb1g2_qq (∑ i, c i • B i) = ∑ i, ((c i : ℤ) : ℚ) • ltrb1g2_qq (B i) := by
  funext j
  simp [ltrb1g2_qq, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

private def ltrb1g2_coordProj {ι : Type*} (σ : ι → Fin Tag.E6.rank) :
    (Fin Tag.E6.rank → ℚ) →ₗ[ℚ] (ι → ℚ) where
  toFun x := fun i => x (σ i)
  map_add' x y := by funext i; rfl
  map_smul' a x := by funext i; rfl

private theorem ltrb1g2_linearIndependent_of_submatrix {n : ℕ}
    (b : Fin n → (Fin Tag.E6.rank → ℚ)) (σ : Fin n → Fin Tag.E6.rank)
    (hdet : Matrix.det (fun i j => b i (σ j) : Matrix (Fin n) (Fin n) ℚ) ≠ 0) :
    LinearIndependent ℚ b :=
  LinearIndependent.of_comp (ltrb1g2_coordProj σ)
    (Matrix.linearIndependent_rows_of_det_ne_zero hdet)

private lemma ltrb1g2_mem_kernelRoots_of_check
    {n : ℕ} {b : Fin Tag.E6.rank → ZMod 3}
    {B : Fin n → (Fin Tag.E6.rank → ℤ)}
    (h : ∀ i : Fin n, B i ∈ rootFinset Tag.E6 ∧ triPairing b (B i) = 0) :
    ∀ i, B i ∈ kernelRoots (triChar b) := by
  intro i
  exact mem_kernelRoots_triChar.2 ⟨mem_rootFinset.1 (h i).1, (h i).2⟩

private theorem ltrb1g2_compRank_rep
    {n : ℕ} (b : Fin Tag.E6.rank → ZMod 3)
    (B : Fin n → (Fin Tag.E6.rank → ℤ)) (comb : (Fin Tag.E6.rank → ℤ) → Fin n → ℤ)
    (hBmem : ∀ i, B i ∈ kernelRoots (triChar b))
    (hb : LinearIndependent ℚ (fun i => ltrb1g2_qq (B i)))
    (hcomb : ∀ k : Fin e6Certificate.roots.length,
      triPairing b (e6Certificate.root k.val) = 0 →
        e6Certificate.root k.val =
          ∑ i, comb (e6Certificate.root k.val) i • B i) :
    compRank (kernelRoots (triChar b)) = n := by
  classical
  have hspan_le : Submodule.span ℚ (ltrb1g2_qq '' kernelRoots (triChar b)) ≤
      Submodule.span ℚ (Set.range (fun i => ltrb1g2_qq (B i))) := by
    rw [Submodule.span_le]
    rintro x ⟨α, hα, rfl⟩
    have hαroot : IsRoot Tag.E6 α := (mem_kernelRoots_triChar.1 hα).1
    obtain ⟨k, hk, hkv⟩ := RootCertificate.exists_root_eq e6Certificate_check hαroot
    have hP : triPairing b α = 0 → α = ∑ i, comb α i • B i := by
      have h := hcomb ⟨k, hk⟩
      rw [hkv] at h
      exact h
    rw [hP (mem_kernelRoots_triChar.1 hα).2, ltrb1g2_qq_sum]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hspan_ge : Submodule.span ℚ (Set.range (fun i => ltrb1g2_qq (B i))) ≤
      Submodule.span ℚ (ltrb1g2_qq '' kernelRoots (triChar b)) := by
    rw [Submodule.span_le]
    rintro x ⟨i, rfl⟩
    exact Submodule.subset_span ⟨B i, hBmem i, rfl⟩
  have hle : compRank (kernelRoots (triChar b)) ≤ n := by
    unfold compRank
    calc Module.finrank ℚ (Submodule.span ℚ (ltrb1g2_qq '' kernelRoots (triChar b)))
        ≤ Module.finrank ℚ (Submodule.span ℚ (Set.range (fun i => ltrb1g2_qq (B i)))) :=
          Submodule.finrank_mono hspan_le
      _ = n := by rw [finrank_span_eq_card hb]; simp
  have hge : n ≤ compRank (kernelRoots (triChar b)) := by
    unfold compRank
    calc n = Module.finrank ℚ (Submodule.span ℚ (Set.range (fun i => ltrb1g2_qq (B i)))) := by
          rw [finrank_span_eq_card hb]; simp
      _ ≤ Module.finrank ℚ (Submodule.span ℚ (ltrb1g2_qq '' kernelRoots (triChar b))) :=
          Submodule.finrank_mono hspan_ge
  omega

