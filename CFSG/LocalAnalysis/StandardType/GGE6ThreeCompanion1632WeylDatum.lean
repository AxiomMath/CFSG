private lemma ltrb1g2_triChar_zero_vec (τ : Tag) (hτ : τ = Tag.E6) :
    triChar (vec3 (τ := τ) [0, 0, 0, 0, 0, 0]) = 1 := by
  rw [hτ]
  refine MonoidHom.ext fun v => ?_
  change Z3.ofAdd (triPairing (vec3 (τ := Tag.E6) [0, 0, 0, 0, 0, 0])
      (Multiplicative.toAdd v)) = 1
  have hz : triPairing (vec3 (τ := Tag.E6) [0, 0, 0, 0, 0, 0])
      (Multiplicative.toAdd v) = 0 := by
    unfold triPairing
    apply Finset.sum_eq_zero
    intro j _
    have hj : vec3 (τ := Tag.E6) [0, 0, 0, 0, 0, 0] j = 0 := by
      fin_cases j <;> rfl
    rw [hj, zero_mul]
  rw [hz, Z3.ofAdd_zero]

private theorem ltrb1g2_finrank_span_eq_compRank {τ : Tag} (Ψ : Set (Fin τ.rank → ℤ))
    (hΨ : Ψ.Finite) :
    Module.finrank ℤ (Submodule.span ℤ Ψ) = compRank Ψ := by
  let g : (Fin τ.rank → ℤ) → (Fin τ.rank → ℚ) := fun v i => (v i : ℚ)
  let f : (Fin τ.rank → ℤ) →ₗ[ℤ] (Fin τ.rank → ℚ) :=
    { toFun := g
      map_add' := by intro a b; funext i; simp [g]
      map_smul' := by intro a b; funext i; simp [g] }
  have hfinj : Function.Injective f := by
    intro a b h
    funext i
    have h' := congrFun h i
    exact Int.cast_injective h'
  have : Module.Finite ℤ (Submodule.span ℤ (f '' Ψ)) :=
    Module.Finite.span_of_finite ℤ (hΨ.image f)
  have hmap : (Submodule.span ℤ Ψ).map f = Submodule.span ℤ (f '' Ψ) := by
    rw [Submodule.map_span]
  have heq : Module.finrank ℤ (Submodule.span ℤ Ψ) =
      Module.finrank ℤ (Submodule.span ℤ (f '' Ψ)) := by
    rw [← hmap]
    exact LinearEquiv.finrank_eq (Submodule.equivMapOfInjective f hfinj (Submodule.span ℤ Ψ))
  have hM : Module.finrank ℚ (Submodule.span ℚ (f '' Ψ)) =
      Module.finrank ℤ (Submodule.span ℤ (f '' Ψ)) :=
    Submodule.finrank_span_eq_finrank_span ℤ ℚ (f '' Ψ)
  have hcomp : compRank Ψ = Module.finrank ℚ (Submodule.span ℚ (f '' Ψ)) := by
    rw [compRank]
    rfl
  rw [hcomp, hM]
  exact heq

private lemma ltrb1g2_kernelRoots_finite {Omega : Type} [Field Omega] [IsAlgClosed Omega]
    [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) :
    (kernelRoots (rootCharHom ρ.a)).Finite :=
  (rootFinset ρ.tau).finite_toSet.subset
    (fun v hv => mem_rootFinset.2 (show IsRoot ρ.tau v from hv.1))

private lemma ltrb1g2_rep_data
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6) :
    ∃ r, r < 8 ∧
      (kernelRoots (rootCharHom ρ.a)).ncard = [72, 40, 40, 30, 22, 22, 24, 18].getD r 0 ∧
      compRank (kernelRoots (triChar (vec3 (τ := ρ.tau) (e6ThreeReps.getD r [])))) =
        ltrb1g2_zeroCount ρ.row.diagram.marks.length ρ.row.s ∧
      (rootCharHom ρ.a ≠ 1 → r ≠ 0) := by
  classical
  have htau : ρ.tau = Tag.E6 := by
    rw [← ρ.tau_eq, hE6]
    rfl
  have horbit : orbitCheck3 ρ.tau e6ThreeReps e6ThreeOrbit = true := by
    have h := e6ThreeScCheck_spec.1
    rw [← htau] at h
    exact h
  obtain ⟨χ', hker⟩ := exists_triChar_ker_eq (rootCharHom3 ρ.a)
    (rootCharHom3_pow_three ρ.a fun i => ρ.a_pow i)
  obtain ⟨r, hr8, t, ht⟩ := exists_isCharConj_of_orbitCheck3 horbit χ'
  let b : Fin ρ.tau.rank → ZMod 3 := vec3 (τ := ρ.tau) (e6ThreeReps.getD r [])
  have ht' : IsCharConj (triChar b) χ' t := ht
  have himg : kernelRoots χ' = (fun α => t • α) '' kernelRoots (triChar b) := by
    ext α
    rw [kernelRoots_iff_of_isCharConj ht']
    constructor
    · intro hα
      exact ⟨t⁻¹ • α, hα, by simp⟩
    · rintro ⟨β, hβ, rfl⟩
      simpa using hβ
  have hcount : (kernelRoots (rootCharHom ρ.a)).ncard =
      [72, 40, 40, 30, 22, 22, 24, 18].getD r 0 := by
    have h1 : (kernelRoots (rootCharHom ρ.a)).ncard = (kernelRoots χ').ncard := by
      rw [show kernelRoots (rootCharHom ρ.a) = kernelRoots (rootCharHom3 ρ.a) from rfl,
        kernelRoots_congr_ker hker]
    have h2 : (kernelRoots χ').ncard = (kernelRoots (triChar b)).ncard := by
      rw [himg, ncard_image_smul t (kernelRoots (triChar b))]
    rw [h1, h2, ← ltrb1g2_triKerCount_eq_ncard ρ.tau b,
      ltrb1g2_triKerCount_reps ρ.tau htau r hr8]
  have hrank : compRank (kernelRoots (triChar b)) =
      ltrb1g2_zeroCount ρ.row.diagram.marks.length ρ.row.s := by
    have h1 : compRank (kernelRoots (triChar b)) = compRank (kernelRoots χ') := by
      rw [himg, compRank_image t]
    have h2 : compRank (kernelRoots χ') = compRank (kernelRoots (rootCharHom ρ.a)) := by
      rw [show kernelRoots (rootCharHom ρ.a) = kernelRoots (rootCharHom3 ρ.a) from rfl,
        kernelRoots_congr_ker hker]
    have h3 : compRank (kernelRoots (rootCharHom ρ.a)) =
        ltrb1g2_zeroCount ρ.row.diagram.marks.length ρ.row.s := by
      rw [← ltrb1g2_finrank_span_eq_compRank (kernelRoots (rootCharHom ρ.a))
        (ltrb1g2_kernelRoots_finite ρ)]
      exact kernelRank_eq_zeroCount ρ hE6
    rw [h1, h2, h3]
  have hne0 : rootCharHom ρ.a ≠ 1 → r ≠ 0 := by
    intro hchar hr0
    apply hchar
    have htri : triChar b = 1 := by
      subst hr0
      have hb : b = vec3 (τ := ρ.tau) [0, 0, 0, 0, 0, 0] := by
        simp [b, e6ThreeReps]
      rw [hb]
      exact ltrb1g2_triChar_zero_vec ρ.tau htau
    have hχ' : χ' = 1 := by
      refine MonoidHom.ext fun x => ?_
      change χ' (Multiplicative.ofAdd (Multiplicative.toAdd x)) = 1
      rw [ht' (Multiplicative.toAdd x), htri]
      rfl
    have hroot : rootCharHom3 ρ.a = 1 := by
      refine MonoidHom.ext fun x => ?_
      exact (hker x).2 (by rw [hχ']; rfl)
    rw [show rootCharHom ρ.a = rootCharHom3 ρ.a from rfl]
    exact hroot
  exact ⟨r, hr8, hcount, hrank, hne0⟩

private lemma ltrb1g2_rank_six (r : ℕ) (hr : r < 8)
    (h : [6, 5, 5, 5, 5, 5, 4, 6].getD r 0 = 6) : r = 0 ∨ r = 7 := by
  interval_cases r <;> simp_all

