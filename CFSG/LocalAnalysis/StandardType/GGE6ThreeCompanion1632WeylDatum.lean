private lemma ltrb1c4_rootChar_e6Shift_of_mem_kernelReflectionGroup
    {L : Type} [Field L] {a : Fin Tag.E6.rank → Lˣ} {u : WeylGroup Tag.E6}
    (hu : u ∈ kernelReflectionGroup a) : rootChar a (e6Shift u) = 1 := by
  induction hu using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨w, i, hα, rfl⟩ := hx
    have hxW : (w * simple Tag.E6 i * w⁻¹) ∈ rootCharStabilizerSubgroup a :=
      kernelReflectionGroup_le a (Subgroup.subset_closure ⟨w, i, hα, rfl⟩)
    have hx2 : (w * simple Tag.E6 i * w⁻¹) * (w * simple Tag.E6 i * w⁻¹) = 1 := by
      have hs : simple Tag.E6 i * simple Tag.E6 i = 1 :=
        (coxeterSystem Tag.E6).simple_mul_simple_self i
      calc (w * simple Tag.E6 i * w⁻¹) * (w * simple Tag.E6 i * w⁻¹)
          = w * (simple Tag.E6 i * simple Tag.E6 i) * w⁻¹ := by group
        _ = 1 := by rw [hs, mul_one, mul_inv_cancel]
    have h := e6Shift_mul (w * simple Tag.E6 i * w⁻¹) (w * simple Tag.E6 i * w⁻¹)
    rw [hx2, e6Shift_one] at h
    have hsq : rootChar a (e6Shift (w * simple Tag.E6 i * w⁻¹)) ^ 2 = 1 := by
      have hc := congrArg (rootChar a) h
      rw [rootChar_zero, rootChar_add, hxW] at hc
      rw [pow_two]
      exact hc.symm
    have h3 : rootChar a (e6Shift (w * simple Tag.E6 i * w⁻¹)) ^ 3 = 1 :=
      e6ShiftChar_pow_three a ⟨w * simple Tag.E6 i * w⁻¹, hxW⟩
    calc rootChar a (e6Shift (w * simple Tag.E6 i * w⁻¹))
        = rootChar a (e6Shift (w * simple Tag.E6 i * w⁻¹)) *
            rootChar a (e6Shift (w * simple Tag.E6 i * w⁻¹)) ^ 2 := by rw [hsq, mul_one]
      _ = rootChar a (e6Shift (w * simple Tag.E6 i * w⁻¹)) ^ 3 := by rw [← pow_succ']
      _ = 1 := h3
  | one => rw [e6Shift_one, rootChar_zero]
  | mul x y hx hy ihx ihy =>
    have hxW : x ∈ rootCharStabilizerSubgroup a := kernelReflectionGroup_le a hx
    rw [e6Shift_mul, rootChar_add, hxW, ihx, ihy, one_mul]
  | inv x hx ihx =>
    have hxW : x ∈ rootCharStabilizerSubgroup a := kernelReflectionGroup_le a hx
    have h := e6Shift_mul x x⁻¹
    rw [mul_inv_cancel, e6Shift_one] at h
    have hc := congrArg (rootChar a) h
    rw [rootChar_zero, rootChar_add, hxW, ihx, mul_one] at hc
    exact hc.symm

private lemma ltrb1c4_shiftChar_ker
    {K : Type} [Field K] (a : Fin Tag.E6.rank → Kˣ) (h3 : ∀ i, a i ^ 3 = 1) :
    (e6ShiftChar a).ker = (kernelReflectionGroup a).subgroupOf (rootCharStabilizerSubgroup a) := by
  ext w
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  exact ⟨fun hw => mem_kernelReflectionGroup_of_e6Shift a h3 w.2 hw,
    fun hw => ltrb1c4_rootChar_e6Shift_of_mem_kernelReflectionGroup hw⟩

private lemma ltrb1c4_relIndex_eq_card_range
    {K : Type} [Field K] (a : Fin Tag.E6.rank → Kˣ) (h3 : ∀ i, a i ^ 3 = 1) :
    (kernelReflectionGroup a).relIndex (rootCharStabilizerSubgroup a) =
      Nat.card ↥(e6ShiftChar a).range := by
  rw [← Subgroup.relIndex_subgroupOf (H := kernelReflectionGroup a)
      (K := rootCharStabilizerSubgroup a) (L := rootCharStabilizerSubgroup a) (le_refl _),
    Subgroup.subgroupOf_self, ← ltrb1c4_shiftChar_ker a h3, Subgroup.relIndex_ker,
    Subgroup.map_top]

private lemma ltrb1c4_card_range_le_three
    {K : Type} [Field K] (a : Fin Tag.E6.rank → Kˣ) :
    Nat.card ↥(e6ShiftChar a).range ≤ 3 := by
  have hsub : (e6ShiftChar a).range ≤ rootsOfUnity 3 K := by
    intro x hx
    rw [MonoidHom.mem_range] at hx
    obtain ⟨w, rfl⟩ := hx
    rw [mem_rootsOfUnity]
    exact e6ShiftChar_pow_three a w
  have hle := Nat.card_le_card_of_injective
    (fun x : ↥(e6ShiftChar a).range => (⟨(x : Kˣ), hsub x.2⟩ : ↥(rootsOfUnity 3 K)))
    (fun x y hxy => Subtype.ext (congrArg (fun z : ↥(rootsOfUnity 3 K) => (z : Kˣ)) hxy))
  exact hle.trans (card_rootsOfUnity K 3)

private lemma ltrb1c4_three_le_card_range
    {K : Type} [Field K] (a : Fin Tag.E6.rank → Kˣ)
    (w : rootCharStabilizerSubgroup a) (hw : e6ShiftChar a w ≠ 1) :
    3 ≤ Nat.card ↥(e6ShiftChar a).range := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hsub : (e6ShiftChar a).range ≤ rootsOfUnity 3 K := by
    intro x hx
    rw [MonoidHom.mem_range] at hx
    obtain ⟨w, rfl⟩ := hx
    rw [mem_rootsOfUnity]
    exact e6ShiftChar_pow_three a w
  haveI : Finite ↥(e6ShiftChar a).range :=
    Finite.of_injective
      (fun x : ↥(e6ShiftChar a).range => (⟨(x : Kˣ), hsub x.2⟩ : ↥(rootsOfUnity 3 K)))
      (fun x y hxy => Subtype.ext (congrArg (fun z : ↥(rootsOfUnity 3 K) => (z : Kˣ)) hxy))
  let x : Kˣ := e6ShiftChar a w
  have hxmem : x ∈ (e6ShiftChar a).range := ⟨w, rfl⟩
  have hord : orderOf x = 3 := orderOf_eq_prime (e6ShiftChar_pow_three a w) hw
  have hdvd : 3 ∣ Nat.card ↥(e6ShiftChar a).range := by
    rw [← hord]
    let y : ↥(e6ShiftChar a).range := ⟨x, hxmem⟩
    have h := orderOf_dvd_natCard y
    rwa [← Subgroup.orderOf_coe y] at h
  exact Nat.le_of_dvd
    (Nat.pos_of_ne_zero (Nat.card_ne_zero.mpr ⟨⟨1, Subgroup.one_mem _⟩, inferInstance⟩)) hdvd

private lemma ltrb1c4_ncard_kernelRoots_eq_filter_card
    (b : Fin Tag.E6.rank → ZMod 3) :
    (kernelRoots (triChar b)).ncard =
      ((rootFinset Tag.E6).filter (fun α => triPairing b α = 0)).card := by
  rw [← Set.ncard_coe_finset]
  congr 1
  ext α
  simp only [Finset.coe_filter, Set.mem_setOf_eq, mem_rootFinset]
  exact mem_kernelRoots_triChar.symm

private lemma ltrb1c4_filter_card_reps (ρ : ℕ) (hρ : ρ < 8) :
    ((rootFinset Tag.E6).filter
        (fun α => triPairing (vec3 (e6ThreeReps.getD ρ [])) α = 0)).card =
      [72, 40, 40, 30, 22, 22, 24, 18].getD ρ 0 := by
  have hmem : ρ ∈ Finset.range 8 := Finset.mem_range.mpr hρ
  fin_cases hmem <;> decide +kernel

private theorem ltrb1c4_pi_eq_sum_single (v : Fin Tag.E6.rank → ℤ) :
    v = ∑ i, v i • (Pi.single i 1 : Fin Tag.E6.rank → ℤ) := by
  ext j
  simp [Finset.sum_apply, Pi.single_apply]

private def ltrb1c4_triPairingHom (b : Fin Tag.E6.rank → ZMod 3) :
    (Fin Tag.E6.rank → ℤ) →+ ZMod 3 where
  toFun := triPairing b
  map_zero' := triPairing_zero b
  map_add' := triPairing_add b

private theorem ltrb1c4_triPairingHom_apply (b : Fin Tag.E6.rank → ZMod 3)
    (v : Fin Tag.E6.rank → ℤ) : ltrb1c4_triPairingHom b v = triPairing b v := rfl

private theorem ltrb1c4_triPairing_smul_eq_of_basis
    {b b' : Fin Tag.E6.rank → ZMod 3} {w : WeylGroup Tag.E6}
    (h : ∀ i, triPairing b (w • (Pi.single i 1 : Fin Tag.E6.rank → ℤ)) =
      triPairing b' (Pi.single i 1)) (v : Fin Tag.E6.rank → ℤ) :
    triPairing b (w • v) = triPairing b' v := by
  conv_lhs => rw [ltrb1c4_pi_eq_sum_single v, Finset.smul_sum]
  conv_rhs => rw [ltrb1c4_pi_eq_sum_single v]
  rw [← ltrb1c4_triPairingHom_apply, ← ltrb1c4_triPairingHom_apply, map_sum, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [smul_comm, map_zsmul, map_zsmul, ltrb1c4_triPairingHom_apply, ltrb1c4_triPairingHom_apply,
    h i]

private theorem ltrb1c4_stdChar_check : ∀ i : Fin Tag.E6.rank,
    triPairing stdChar (wordAct Tag.E6 stdWord (Pi.single i 1)) =
      triPairing repD (Pi.single i 1) := by
  decide +kernel

private theorem ltrb1c4_wBeta_stab_check : ∀ i : Fin Tag.E6.rank,
    triPairing stdChar (wordAct Tag.E6 d4TrialityWord (Pi.single i 1)) =
      triPairing stdChar (Pi.single i 1) := by
  decide +kernel

private theorem ltrb1c4_wBeta_shift_check : ∀ i : Fin Tag.E6.rank,
    (3 : ℤ) * (![-2, -1, -2, -2, -1, 0] : Fin Tag.E6.rank → ℤ) i =
      wordAct Tag.E6 d4TrialityWord e6Omega3 i - e6Omega3 i := by
  decide +kernel

private theorem ltrb1c4_stdChar_shift_wBeta_check :
    triPairing stdChar (![-2, -1, -2, -2, -1, 0] : Fin Tag.E6.rank → ℤ) ≠ 0 := by
  decide +kernel

private theorem ltrb1c4_list_prod_simple_smul (l : List (Fin Tag.E6.rank))
    (v : Fin Tag.E6.rank → ℤ) :
    (l.map (simple Tag.E6)).prod • v = l.foldr (reflect Tag.E6) v := by
  induction l with
  | nil => rfl
  | cons i l ih => simp [List.map_cons, List.prod_cons, mul_smul, simple_smul, ih]

private theorem ltrb1c4_wordAct_eq_smul (ω : List (Fin Tag.E6.rank))
    (α : Fin Tag.E6.rank → ℤ) :
    wordAct Tag.E6 ω α = (coxeterSystem Tag.E6).wordProd ω • α := by
  change ω.foldr (reflect Tag.E6) α = (ω.map (simple Tag.E6)).prod • α
  rw [ltrb1c4_list_prod_simple_smul]

private theorem ltrb1c4_stdChar_smul (x : Fin Tag.E6.rank → ℤ) :
    triPairing stdChar (stdV • x) = triPairing repD x := by
  refine ltrb1c4_triPairing_smul_eq_of_basis (fun i => ?_) x
  rw [stdV, ← ltrb1c4_wordAct_eq_smul]
  exact ltrb1c4_stdChar_check i

private theorem ltrb1c4_mem_charStabilizer_wBeta :
    wBeta ∈ charStabilizer (triChar stdChar) := by
  intro v
  rw [triChar_apply, triChar_apply]
  congr 1
  refine ltrb1c4_triPairing_smul_eq_of_basis (b' := stdChar) (fun i => ?_) v
  rw [wBeta, ← ltrb1c4_wordAct_eq_smul]
  exact ltrb1c4_wBeta_stab_check i

private theorem ltrb1c4_triPairing_e6Shift_wBeta : triPairing stdChar (e6Shift wBeta) ≠ 0 := by
  have h : e6Shift wBeta = ![-2, -1, -2, -2, -1, 0] := by
    refine e6Shift_eq_of_three_smul ?_
    rw [wBeta, ← ltrb1c4_wordAct_eq_smul]
    funext i
    simp only [Pi.smul_apply, smul_eq_mul, Pi.sub_apply]
    exact ltrb1c4_wBeta_shift_check i
  rw [h]
  exact ltrb1c4_stdChar_shift_wBeta_check

private theorem ltrb1c4_charStab_conj_of_pair {b b' : Fin Tag.E6.rank → ZMod 3}
    {t : WeylGroup Tag.E6} (hpair : ∀ v, triPairing b (t • v) = triPairing b' v)
    {w : WeylGroup Tag.E6} (hw : w ∈ charStabilizer (triChar b')) :
    t * w * t⁻¹ ∈ charStabilizer (triChar b) := by
  intro v
  rw [triChar_apply, triChar_apply]
  congr 1
  have h1 : triPairing b ((t * w * t⁻¹) • v) = triPairing b' (w • (t⁻¹ • v)) := by
    rw [mul_smul, mul_smul]
    exact hpair _
  rw [h1, triPairing_smul_of_mem hw, ← hpair, smul_inv_smul]

private theorem ltrb1c4_shift_conj_of_pair {b b' : Fin Tag.E6.rank → ZMod 3}
    {t : WeylGroup Tag.E6} (hpair : ∀ v, triPairing b (t • v) = triPairing b' v)
    {w : WeylGroup Tag.E6} (hw : w ∈ charStabilizer (triChar b')) :
    triPairing b (e6Shift (t * w * t⁻¹)) = triPairing b' (e6Shift w) := by
  have hinv : t • e6Shift t⁻¹ + e6Shift t = 0 := by
    rw [← e6Shift_mul, mul_inv_cancel, e6Shift_one]
  have e1 : e6Shift (t * w * t⁻¹) = t • (w • e6Shift t⁻¹) + t • e6Shift w + e6Shift t := by
    rw [mul_assoc, e6Shift_mul, e6Shift_mul, smul_add]
  have e2 : triPairing b (e6Shift t) + triPairing b' (e6Shift t⁻¹) = 0 := by
    have := congrArg (triPairing b) hinv
    rw [triPairing_add, hpair, triPairing_zero] at this
    linear_combination this
  rw [e1, triPairing_add, triPairing_add, hpair, hpair, triPairing_smul_of_mem hw]
  linear_combination e2

private lemma ltrb1c4_d4_witness :
    ∃ w : WeylGroup Tag.E6,
      w ∈ charStabilizer (triChar (vec3 (e6ThreeReps.getD 6 []))) ∧
      triPairing (vec3 (e6ThreeReps.getD 6 [])) (e6Shift w) ≠ 0 := by
  have hrep6 : vec3 (e6ThreeReps.getD 6 []) = repD := by decide
  have hpair : ∀ v, triPairing repD (stdV⁻¹ • v) = triPairing stdChar v := by
    intro v
    rw [← ltrb1c4_stdChar_smul (stdV⁻¹ • v), smul_inv_smul]
  refine ⟨stdV⁻¹ * wBeta * (stdV⁻¹)⁻¹, ?_, ?_⟩
  · rw [hrep6]
    exact ltrb1c4_charStab_conj_of_pair hpair ltrb1c4_mem_charStabilizer_wBeta
  · rw [hrep6, ltrb1c4_shift_conj_of_pair hpair ltrb1c4_mem_charStabilizer_wBeta]
    exact ltrb1c4_triPairing_e6Shift_wBeta

private lemma ltrb1c4_line_witness :
    ∃ w : WeylGroup Tag.E6,
      w ∈ charStabilizer (triChar (vec3 (e6ThreeReps.getD 7 []))) ∧
      triPairing (vec3 (e6ThreeReps.getD 7 [])) (e6Shift w) ≠ 0 := by
  refine ⟨e6LineWeyl, ?_, ?_⟩
  · intro v
    rw [triChar_apply, triChar_apply]
    congr 1
    refine ltrb1c4_triPairing_smul_eq_of_basis
      (b' := vec3 (e6ThreeReps.getD 7 [])) (fun i => ?_) v
    rw [e6LineWeyl_smul]
    fin_cases i <;> decide +kernel
  · rw [e6Shift_e6LineWeyl]
    decide +kernel

private lemma ltrb1c4_exists_shift_ne_one
    {K : Type} [Field K] (a : Fin Tag.E6.rank → Kˣ) (h3 : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard = 18 ∨
      (kernelRoots (rootCharHom a)).ncard = 24) :
    ∃ w : rootCharStabilizerSubgroup a, e6ShiftChar a w ≠ 1 := by
  classical
  obtain ⟨χ', hker⟩ := exists_triChar_ker_eq (rootCharHom3 a) (rootCharHom3_pow_three a h3)
  obtain ⟨b, rfl⟩ : ∃ b, χ' = triChar b := ⟨_, eq_triChar χ'⟩
  have hker2 : ∀ x, rootCharHom a x = 1 ↔ triChar b x = 1 := hker
  rw [kernelRoots_congr_ker hker2] at hk
  obtain ⟨horbit, -⟩ := e6ThreeScCheck_spec
  obtain ⟨ρ_rep, hρ8, t, ht⟩ := exists_isCharConj_of_orbitCheck3 horbit (triChar b)
  have hρ8' : ρ_rep < 8 := hρ8
  have hconj : (kernelRoots (triChar b)).ncard =
      (kernelRoots (triChar (vec3 (τ := Tag.E6) (e6ThreeReps.getD ρ_rep [])))).ncard := by
    refine Set.ncard_congr (fun α _ => t⁻¹ • α) ?_ ?_ ?_
    · intro α hα
      rw [← kernelRoots_iff_of_isCharConj ht]
      simpa using hα
    · intro α β hα hβ h
      exact MulAction.injective t⁻¹ h
    · intro β hβ
      refine ⟨t • β, ?_, by simp⟩
      rw [kernelRoots_iff_of_isCharConj ht]
      simpa using hβ
  have hrep_val : ([72, 40, 40, 30, 22, 22, 24, 18].getD ρ_rep 0 = 18 ∨
      [72, 40, 40, 30, 22, 22, 24, 18].getD ρ_rep 0 = 24) := by
    rw [← ltrb1c4_filter_card_reps ρ_rep hρ8',
      ← ltrb1c4_ncard_kernelRoots_eq_filter_card
        (vec3 (τ := Tag.E6) (e6ThreeReps.getD ρ_rep [])), ← hconj]
    exact hk
  have hρ67 : ρ_rep = 6 ∨ ρ_rep = 7 := by
    have hmem : ρ_rep ∈ Finset.range 8 := Finset.mem_range.mpr hρ8'
    fin_cases hmem <;> simp_all
  have hwit : ∃ w, w ∈ charStabilizer (triChar (vec3 (e6ThreeReps.getD ρ_rep []))) ∧
      triPairing (vec3 (e6ThreeReps.getD ρ_rep [])) (e6Shift w) ≠ 0 := by
    rcases hρ67 with h | h <;> subst h
    · exact ltrb1c4_d4_witness
    · exact ltrb1c4_line_witness
  obtain ⟨w, hw_stab, hw_shift⟩ := hwit
  have hpair : ∀ v, triPairing b (t • v) =
      triPairing (vec3 (e6ThreeReps.getD ρ_rep [])) v := by
    intro v
    have h := ht (t • v)
    rw [triChar_apply, triChar_apply, Z3.ofAdd_eq_ofAdd_iff] at h
    simpa using h
  have hw'_stab : t * w * t⁻¹ ∈ charStabilizer (triChar b) :=
    ltrb1c4_charStab_conj_of_pair hpair hw_stab
  have hw'_shift : triPairing b (e6Shift (t * w * t⁻¹)) ≠ 0 := by
    rw [ltrb1c4_shift_conj_of_pair hpair hw_stab]
    exact hw_shift
  have hstab_a : t * w * t⁻¹ ∈ rootCharStabilizerSubgroup a := by
    rw [show rootCharStabilizerSubgroup a = charStabilizer (triChar b) from
      (Subgroup.ext fun _ => Iff.rfl).trans (charStabilizer_congr_ker hker)]
    exact hw'_stab
  refine ⟨⟨t * w * t⁻¹, hstab_a⟩, ?_⟩
  intro h
  apply hw'_shift
  have h1 : rootChar a (e6Shift (t * w * t⁻¹)) = 1 := h
  have h2 := (hker2 (Multiplicative.ofAdd (e6Shift (t * w * t⁻¹)))).1 h1
  rwa [triChar_apply, Z3.ofAdd_eq_one] at h2

private lemma ltrb1c4_index_three_aux
    {K : Type} [Field K] (τ : Tag) (hτ : τ = Tag.E6) (a : Fin τ.rank → Kˣ)
    (h3 : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard = 18 ∨
      (kernelRoots (rootCharHom a)).ncard = 24) :
    (kernelReflectionGroup a).relIndex (rootCharStabilizerSubgroup a) = 3 := by
  subst hτ
  rw [ltrb1c4_relIndex_eq_card_range a h3]
  obtain ⟨w, hw⟩ := ltrb1c4_exists_shift_ne_one a h3 hk
  exact le_antisymm (ltrb1c4_card_range_le_three a) (ltrb1c4_three_le_card_range a w hw)

private lemma ltrb1g2_index_three_of_count
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6)
    (hk : (kernelRoots (rootCharHom ρ.a)).ncard = 18 ∨
      (kernelRoots (rootCharHom ρ.a)).ncard = 24) :
    (kernelReflectionGroup ρ.a).relIndex (rootCharStabilizerSubgroup ρ.a) = 3 := by
  have htau : ρ.tau = Tag.E6 := by
    rw [← ρ.tau_eq, hE6]
    rfl
  exact ltrb1c4_index_three_aux ρ.tau htau ρ.a (fun i => ρ.a_pow i) hk

private lemma ltrb1g2_index_eq_stabOmega
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6) :
    (kernelReflectionGroup ρ.a).relIndex (rootCharStabilizerSubgroup ρ.a) =
      (if ρ.row.s = [0, 0, 0, 0, 1, 0, 0] ∨ ρ.row.s = [1, 1, 0, 0, 0, 0, 1] then 3 else 1) := by
  by_cases h3 : ρ.row.s = [0, 0, 0, 0, 1, 0, 0]
  · rw [if_pos (Or.inl h3)]
    exact ltrb1g2_index_three_of_count ρ hE6
      (Or.inl ((ltrb1g2_count_of_zero_count ρ hE6).1 h3))
  · by_cases h16 : ρ.row.s = [1, 1, 0, 0, 0, 0, 1]
    · rw [if_pos (Or.inr h16)]
      exact ltrb1g2_index_three_of_count ρ hE6
        (Or.inr ((ltrb1g2_count_of_zero_count ρ hE6).2.1 h16))
    · rw [if_neg (fun h => h.elim h3 h16)]
      exact ltrb1g2_index_one_of_count ρ hE6
        ((ltrb1g2_count_of_zero_count ρ hE6).2.2 h3 h16)

theorem weylIndexByDatumAt_e6
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6) :
    WeylIndexByDatumAt ρ := by
  rw [WeylIndexByDatumAt, ltrb1g2_index_eq_stabOmega ρ hE6, ltrb1g2_stabOmega_eq ρ hE6]

