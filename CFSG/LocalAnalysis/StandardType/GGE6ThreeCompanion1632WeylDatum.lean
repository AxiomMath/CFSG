private lemma ltrb1g2_triKerCount_eq_ncard
    (τ : Tag) (b : Fin τ.rank → ZMod 3) :
    ltrb1g2_triKerCount τ b = (kernelRoots (triChar b)).ncard := by
  unfold ltrb1g2_triKerCount
