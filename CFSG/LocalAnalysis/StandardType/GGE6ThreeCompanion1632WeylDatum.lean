  rcases ltrb1g2_rank_five r hr8 hrank with rfl | rfl | rfl | rfl | rfl
  · rw [hd]; decide
  · rw [hd]; decide
  · rw [hd]; decide
  · rw [hd]; decide
  · rw [hd]; decide

private lemma ltrb1g2_rootCharHom_eq_one_of_nodes
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi)
    (hnodes : ∀ i : Fin ρ.row.diagram.marks.length,
      rootChar ρ.a (ρ.nodeMap (Pi.single i 1)) = 1) :
    rootCharHom ρ.a = 1 := by
  classical
  have hroot : ∀ v : Fin ρ.tau.rank → ℤ, rootChar ρ.a v = 1 := by
    intro v
    obtain ⟨w, rfl⟩ := ρ.nodeMap_surj v
    have hw : w = ∑ i, w i • (Pi.single i 1 : Fin ρ.row.diagram.marks.length → ℤ) := by
      funext j
      simp [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
    rw [hw, map_sum, rootChar_sum]
    refine Finset.prod_eq_one fun i _ => ?_
    rw [map_smul, rootChar_zsmul, hnodes i, one_zpow]
  refine MonoidHom.ext fun x => ?_
  change rootChar ρ.a (Multiplicative.toAdd x) = 1
  exact hroot _

private lemma ltrb1g2_rootCharHom_eq_one_of_bad
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6)
    (hs : ρ.row.s = [0, 0, 0, 0, 0, 0, 3]) :
    rootCharHom ρ.a = 1 := by
  have hdiag : ρ.row.diagram = k0DiagOf (GGKacType.E6) := by
    show k0DiagOf ρ.row.T = k0DiagOf (GGKacType.E6)
    rw [hE6]
  have hlen : ρ.row.diagram.marks.length = 7 := by rw [hdiag]; rfl
  apply ltrb1g2_rootCharHom_eq_one_of_nodes ρ
  intro i
  rw [ρ.node_eval i]
  have hmod : ρ.row.s.getD i.val 0 % 3 = 0 := by
    have hi : i.val < 7 := hlen ▸ i.isLt
    rw [hs]
    interval_cases i.val <;> decide
  obtain ⟨k, hk⟩ := Nat.dvd_of_mod_eq_zero hmod
  have h3 : ρ.zeta ^ 3 = 1 := by
    have h := pow_orderOf_eq_one ρ.zeta
    rwa [ρ.zeta_order] at h
  rw [hk, pow_mul, h3, one_pow]

private lemma ltrb1g2_rootCharHom_ne_one_of_node
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi)
    (i : Fin ρ.row.diagram.marks.length) (hi : ρ.row.s.getD i.val 0 % 3 ≠ 0) :
    rootCharHom ρ.a ≠ 1 := by
  intro h1
  have hone : rootChar ρ.a (ρ.nodeMap (Pi.single i 1)) = 1 := by
    have h := congrArg (fun f => f (Multiplicative.ofAdd (ρ.nodeMap (Pi.single i 1)))) h1
    simpa [rootCharHom] using h
  rw [ρ.node_eval i] at hone
  have hdvd : 3 ∣ ρ.row.s.getD i.val 0 := by
    have h := (orderOf_dvd_iff_pow_eq_one (x := ρ.zeta)).mpr hone
    rwa [ρ.zeta_order] at h
  exact hi (Nat.mod_eq_zero_of_dvd hdvd)

private lemma ltrb1g2_bad_vector_impossible
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6)
    (hs : ρ.row.s = [0, 0, 0, 0, 0, 0, 3]) : False := by
  have hχ1 := ltrb1g2_rootCharHom_eq_one_of_bad ρ hE6 hs
  have ha1 : ρ.a = 1 := by
    funext j
    have h := congrArg (fun f => f (Multiplicative.ofAdd (Pi.single j (1 : ℤ)))) hχ1
    change rootChar ρ.a (Pi.single j 1) = 1 at h
    have h2 : rootChar ρ.a (Pi.single j 1) = ρ.a j := by
      simpa using rootChar_nsmul_single (τ := ρ.tau) ρ.a j 1
    rwa [h2] at h
  have hd1 : rootDiagUnit ρ.tau ρ.a = 1 := by
    rw [ha1]
    exact rootDiagUnit_one
  exact ρ.a_ne hd1

private lemma ltrb1g2_count_of_zero_count
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi) (hE6 : ρ.row.T = GGKacType.E6) :
    (ρ.row.s = [0, 0, 0, 0, 1, 0, 0] → (kernelRoots (rootCharHom ρ.a)).ncard = 18) ∧
    (ρ.row.s = [1, 1, 0, 0, 0, 0, 1] → (kernelRoots (rootCharHom ρ.a)).ncard = 24) ∧
    (ρ.row.s ≠ [0, 0, 0, 0, 1, 0, 0] → ρ.row.s ≠ [1, 1, 0, 0, 0, 0, 1] →
      (kernelRoots (rootCharHom ρ.a)).ncard ∈ ({22, 30, 40} : Set ℕ)) := by
  classical
  have hdiag : ρ.row.diagram = k0DiagOf (GGKacType.E6) := by
    show k0DiagOf ρ.row.T = k0DiagOf (GGKacType.E6)
    rw [hE6]
  have hlen : ρ.row.diagram.marks.length = 7 := by rw [hdiag]; rfl
  refine ⟨?_, ?_, ?_⟩
  · intro hs3
    apply kernel_ncard_eq_eighteen_of_zeroCount_eq_six ρ hE6
    · rw [hlen, hs3]; decide
    · refine ltrb1g2_rootCharHom_ne_one_of_node ρ
        (i := Fin.cast hlen.symm (4 : Fin 7)) ?_
      simp [hs3, Fin.val_cast]
  · intro hs16
    apply kernel_ncard_eq_twentyFour_of_zeroCount_eq_four ρ hE6
    rw [hlen, hs16]; decide
  · intro hs3 hs16
    obtain ⟨r, hr8, hd, hc, _⟩ := ltrb1g2_rep_data ρ hE6
    have hsList : ρ.row.s ∈ ltrb1g2_sList := by
      rw [← ltrb1g2_filter_eq_sList]
      exact List.mem_filter.mpr
        ⟨by simpa [hE6] using ρ.row.s_mem, by simpa [hE6] using ρ.row.s_min⟩
    rw [ltrb1g2_sList] at hsList
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hsList
    rcases hsList with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
    · exact (ltrb1g2_bad_vector_impossible ρ hE6 h0).elim
    · apply ltrb1g2_count_of_five ρ hE6
      rw [hlen, h1]; decide
    · exact (hs3 h2).elim
    · apply ltrb1g2_count_of_five ρ hE6
      rw [hlen, h3]; decide
    · apply ltrb1g2_count_of_five ρ hE6
      rw [hlen, h4]; decide
    · apply ltrb1g2_count_of_five ρ hE6
      rw [hlen, h5]; decide
    · apply ltrb1g2_count_of_five ρ hE6
      rw [hlen, h6]; decide
    · exact (hs16 h7).elim

