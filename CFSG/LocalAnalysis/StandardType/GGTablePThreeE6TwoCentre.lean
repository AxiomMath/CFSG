private theorem e6TwoCentre_splitPerm
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup Tag.E6 L p₀)
    {a : Fin Tag.E6.rank → Lˣ} {i : KernelComponent (rootCharHom a)}
    {ψ : SL(3, L) →* ModGL Tag.E6 L} {σ : Fin 3 → Fin 3 → Fin Tag.E6.rank → ℤ}
    (hψ : IsSLFrame ψ σ) (hnorm : ∀ x y, x ≠ y → iform (σ x y) (σ x y) = 2)
    (hΨ : componentRoots (rootCharHom a) i = frameRoots σ)
    (hinn : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[2])) :
    ∃ π : Equiv.Perm (Fin 3), ∀ x y, x ≠ y →
      (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[2] (σ x y) = σ (π x) (π y) := by
  obtain ⟨w, hw, hwγ⟩ := hinn
  have key : ∀ w ∈ Subgroup.closure {s : WeylGroup Tag.E6 | ∃ γ ∈ frameRoots σ,
      s = rootReflection γ}, ∃ π : Equiv.Perm (Fin 3),
        ∀ x y, x ≠ y → w • σ x y = σ (π x) (π y) := by
    intro w hw
    induction hw using Subgroup.closure_induction with
    | mem s hs =>
      obtain ⟨γ, hγ, rfl⟩ := hs
      obtain ⟨u, v, huv, rfl⟩ := hγ
      exact ⟨Equiv.swap u v, fun x y _ => hψ.rootReflection_smul one_ne_zero hnorm huv x y⟩
    | one => exact ⟨1, fun x y _ => by simp⟩
    | mul w₁ w₂ _ _ ih₁ ih₂ =>
      obtain ⟨π₁, h₁⟩ := ih₁
      obtain ⟨π₂, h₂⟩ := ih₂
      refine ⟨π₁ * π₂, fun x y hxy => ?_⟩
      rw [mul_smul, h₂ x y hxy, h₁ (π₂ x) (π₂ y) (π₂.injective.ne hxy)]
      simp [Equiv.Perm.mul_apply]
    | inv w₁ _ ih =>
      obtain ⟨π, hπ⟩ := ih
      refine ⟨π⁻¹, fun x y hxy => ?_⟩
      have h1 : w₁ • σ (π⁻¹ x) (π⁻¹ y) = σ x y := by
        rw [hπ (π⁻¹ x) (π⁻¹ y) (π.symm.injective.ne hxy)]
        simp
      calc w₁⁻¹ • σ x y = w₁⁻¹ • (w₁ • σ (π⁻¹ x) (π⁻¹ y)) := by rw [h1]
        _ = σ (π⁻¹ x) (π⁻¹ y) := by rw [← mul_smul, inv_mul_cancel, one_smul]
  have hw' : w ∈ Subgroup.closure {s : WeylGroup Tag.E6 | ∃ γ ∈ frameRoots σ,
      s = rootReflection γ} := by simpa [hΨ] using hw
  obtain ⟨π, hπ⟩ := key w hw'
  refine ⟨π, fun x y hxy => ?_⟩
  rw [hwγ (σ x y) (hΨ ▸ ⟨x, y, hxy, rfl⟩), hπ x y hxy]

private theorem e6TwoCentre_frame_mem_core
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup τ L p₀)
    {Ψ : Set (Fin τ.rank → ℤ)} {s ν : ℕ} (ψ : SL(ν, L) →* ModGL τ L)
    (hψΨ : ψ.range ≤ rootSpan τ L Ψ) (Φ' : SL(ν, L) ≃* SL(ν, L))
    (hFsψ : ∀ X, iterHom S.D.step s (ψ X) = ψ (Φ' X))
    (hperf : Group.IsPerfect ↥(CFSG.RankThree.Classical2.fixSubgroup Φ')) {D : SL(ν, L)}
    (hD : Φ' D = D) :
    ψ D ∈ langRatFC_core S Ψ s := by
  have hmem : ψ D ∈ (CFSG.RankThree.Classical2.fixSubgroup Φ').map ψ :=
    ⟨D, (CFSG.RankThree.Classical2.mem_fixSubgroup Φ').2 hD, rfl⟩
  refine (le_iSup₂ (f := fun (H : Subgroup (ModGL τ L)) (_ : H ≤ rootSpan τ L Ψ ∧
    (∀ g ∈ H, iterHom S.D.step s g = g) ∧ Group.IsPerfect ↥H) => H)
    ((CFSG.RankThree.Classical2.fixSubgroup Φ').map ψ) ⟨?_, ?_, ?_⟩) hmem
  · rintro _ ⟨X, -, rfl⟩
    exact hψΨ ⟨X, rfl⟩
  · rintro _ ⟨X, hX, rfl⟩
    rw [hFsψ, (CFSG.RankThree.Classical2.mem_fixSubgroup Φ').1 hX]
  · rw [Subgroup.isPerfect_iff] at hperf ⊢
    rw [← Subgroup.map_commutator, hperf]

end E6TwoCentre

theorem e6Two_rootDiagUnit_mem_rationalComponent
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p₀ : ℕ} (S : LangSetup Tag.E6 L p₀) (hq : S.D.q = 2)
    (hAlg : S.IsAlgebraic)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1)
    (h1 : rootDiagUnit Tag.E6 a ≠ 1) (i : KernelComponent (rootCharHom a))
    (hshape : compRank (componentRoots (rootCharHom a) i) = 2 ∧ (componentRoots (rootCharHom a) i).ncard = 6)
    (horb : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2)
    (hinn : twistInner (componentRoots (rootCharHom a) i) ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[2])) :
    rootDiagUnit Tag.E6 a ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : NeZero (2 : ℕ) := ⟨by norm_num⟩
  have h3 : ((3 : ℕ) : L) ≠ 0 := by
    intro h
    have hdvd : (2 : ℕ) ∣ 3 := (CharP.cast_eq_zero_iff L 2 3).1 h
    omega
  obtain ⟨ψ, σ, hψ, hnorm, hΨ⟩ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.TwE6UniqAbs.kac_facts h3 hap).frame i hshape.2
  obtain ⟨π, hπ⟩ := e6TwoCentre_splitPerm S hψ hnorm hΨ hinn
  obtain ⟨σQ, z, hσQc, _hnormz, _hz⟩ := exists_untwistT S hT i (s := 2) (by norm_num) hinn
  have hFs : ∀ x y, x ≠ y → ∃ μ : Lˣ, ∀ c : L,
      iterHom S.D.step 2 (pinnedX Tag.E6 L (σ x y) c) =
        pinnedX Tag.E6 L (σ (π x) (π y)) ((μ : L) * σQ c) := by
    intro x y hxy
    obtain ⟨μ, hμ0, hμ⟩ := iter_step_pinnedX S 2 (hψ.isRoot x y hxy)
    refine ⟨Units.mk0 μ hμ0, fun c => ?_⟩
    rw [iterHom_eq_iterate, hμ, hπ x y hxy, hσQc c, Units.val_mk0]
  obtain ⟨Φ', hFsψ, ⟨β, hβ⟩, hdg⟩ :=
    CFSG.StandardType.LangRat.langRatB_aut_split (L := L) (hν := by norm_num) hψ
      (iterHom S.D.step 2) σQ π hFs
  have hAlg2 : ∀ c : L, ∃ n : ℕ, 0 < n ∧ c ^ 2 ^ n = c := by
    intro c
    obtain ⟨n, hn, hc⟩ := hAlg c
    exact ⟨n, hn, by rw [hq] at hc; exact hc⟩
  have hperf : Group.IsPerfect ↥(CFSG.RankThree.Classical2.fixSubgroup Φ') :=
    CFSG.StandardType.LangRat.langRatB_fixed_perfect_split hAlg2 (f := 2) (by norm_num) (by norm_num)
      π β Φ' (fun x y hxy t => by rw [hβ x y hxy t, hσQc t, hq])
  have hψΨ : ψ.range ≤ rootSpan Tag.E6 L (componentRoots (rootCharHom a) i) :=
    le_of_eq (by rw [hψ.range, ← hΨ])
  have hcenter : (Subgroup.center SL(3, L)).map ψ = Subgroup.zpowers (rootDiagUnit Tag.E6 a) :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.map_center_frame_eq_zpowers_rootDiagUnit
      hap h1 i hshape.2 hψ hΨ
  have hdmem : rootDiagUnit Tag.E6 a ∈ (Subgroup.center SL(3, L)).map ψ := by
    rw [hcenter]; exact Subgroup.mem_zpowers _
  obtain ⟨D, hDc, hDψ⟩ := Subgroup.mem_map.1 hdmem
  have hD : Φ' D = D := by
    obtain ⟨ζ, hζ3, hDζ⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hDc
    rw [Fintype.card_fin] at hζ3
    have hσζ : σQ ζ = ζ := by
      rw [hσQc ζ, hq]
      rw [show (2 : ℕ) ^ 2 = 3 + 1 by norm_num, pow_succ, hζ3, one_mul]
    apply Subtype.ext
    have hdiag : (D : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal (fun _ : Fin 3 => (ζ : L)) := by
      rw [← hDζ]; rfl
    rw [hdg D (fun _ : Fin 3 => (ζ : L)) hdiag]
    simp only [hσζ]
    exact hdiag.symm
  have hcore : rootDiagUnit Tag.E6 a ∈ langRatFC_core S (componentRoots (rootCharHom a) i) 2 := by
    have h := e6TwoCentre_frame_mem_core S ψ hψΨ Φ' hFsψ hperf hD
    rwa [hDψ] at h
  obtain ⟨hs0, hs, hmin⟩ := outer_componentOrbitLength_spec S hT i
  rw [horb] at hs hmin
  set P := outerOrbitFamily S hT i hs hmin with hP
  have hP0 : P.S 0 = rootSpan Tag.E6 L (componentRoots (rootCharHom a) i) := by
    rw [hP, outerOrbitFamily_S, ZMod.val_zero]
    simp only [Function.iterate_zero, id_eq, Set.image_id']
  have hnorm := outer_norm_mem_rationalComponent S hT i hs hmin
    (isPerfect_langRatFC_core S (componentRoots (rootCharHom a) i) 2)
    (Subgroup.inclusion (by rw [hP0]; exact langRatFC_core_le_rootSpan S (componentRoots (rootCharHom a) i) 2))
    (fun x => by
      change iterHom S.D.step 2 (x : ModGL Tag.E6 L) = (x : ModGL Tag.E6 L)
      exact iterHom_step_eq_of_mem_langRatFC_core S (componentRoots (rootCharHom a) i) 2 x.2)
    ⟨rootDiagUnit Tag.E6 a, hcore⟩
  have hcoe : ((Subgroup.inclusion
        (by rw [hP0]; exact langRatFC_core_le_rootSpan S (componentRoots (rootCharHom a) i) 2)
        ⟨rootDiagUnit Tag.E6 a, hcore⟩ :
        P.S 0) : ModGL Tag.E6 L) = rootDiagUnit Tag.E6 a := rfl
  have hnorm_eq : P.norm (Subgroup.inclusion
        (by rw [hP0]; exact langRatFC_core_le_rootSpan S (componentRoots (rootCharHom a) i) 2)
        ⟨rootDiagUnit Tag.E6 a, hcore⟩) = (rootDiagUnit Tag.E6 a) ^ 2 := by
    have hstep : S.D.step (rootDiagUnit Tag.E6 a) = rootDiagUnit Tag.E6 a :=
      CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.CubeCentre.step_rootDiagUnit S hT
    rw [CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.CubeCentre.norm_eq_pow_of_fixed
      P _ (by rw [hcoe, hstep]), hcoe]
  have hd2 : (rootDiagUnit Tag.E6 a) ^ 2 ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i := by
    rw [← hnorm_eq]; exact hnorm
  have h4 : ((rootDiagUnit Tag.E6 a) ^ 2) ^ 2 = rootDiagUnit Tag.E6 a := by
    rw [← pow_mul, show (2 : ℕ) * 2 = 3 + 1 by norm_num, pow_succ,
      CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.CubeCentre.rootDiagUnit_pow_three_eq_one
        hap, one_mul]
  rw [← h4]
  exact Subgroup.pow_mem _ hd2 2

