private theorem ggL45E67Torus_conj_injective {K : Type*} [Group K] {R : Type} [Group R]
    (hK : commutator K = ⊤) (θ : K ⧸ Subgroup.center K ≃* R) :
    Function.Injective (MulAut.conj : R →* MulAut R) := by
  have hcenter : ∀ r : R, (∀ s : R, s * r = r * s) → r = 1 := by
    intro r hr
    haveI : Group.IsPerfect K := ⟨hK⟩
    have hbot : Subgroup.center (K ⧸ Subgroup.center K) = ⊥ :=
      Group.IsPerfect.center_quotient_center_eq_bot K
    have hmem : θ.symm r ∈ Subgroup.center (K ⧸ Subgroup.center K) := by
      rw [Subgroup.mem_center_iff]
      intro x
      have h := congrArg θ.symm (hr (θ x))
      simpa using h
    have h1 : θ.symm r = 1 := by rw [hbot] at hmem; simpa using hmem
    simpa using congrArg θ h1
  rw [injective_iff_map_eq_one]
  intro r hr
  apply hcenter r
  intro s
  have h1 := congrArg (fun f : MulAut R => f s) hr
  simp only [MulAut.conj_apply, MulAut.one_apply] at h1
  calc s * r = (r * s * r⁻¹) * r := by rw [h1]
    _ = r * s := by group

private theorem ggL45E67Torus_conj_apply_mul {R : Type*} [Group R] (φ : MulAut R) (r : R) :
    MulAut.conj (φ r) = φ * MulAut.conj r * φ⁻¹ := by
  ext y
  simp [MulAut.conj_apply, map_mul, map_inv]

private theorem ggL45E67Torus_iterate_three {G : Type*} [MulOneClass G] (f : G →* G) (x : G) :
    (⇑f)^[3] x = f (f (f x)) := by
  rw [show (3 : ℕ) = 2 + 1 by norm_num, Function.iterate_add_apply,
    show (2 : ℕ) = 1 + 1 by norm_num, Function.iterate_add_apply, Function.iterate_one]

private theorem ggL45E67Torus_card_B {τ : Tag} {L : Type} [Field L] {R : Type} [Group R]
    {H : Subgroup (ModGL τ L)} {K : Type} [Group K] {I : Set (MulAut R)}
    (Θ : H →* MulAut R) (hΘ : Function.Injective Θ)
    (hI : ∀ φ, φ ∈ I ↔ ∃ g, Θ g = φ) (θ : K ⧸ Subgroup.center K ≃* R)
    (hK : commutator K = ⊤) {E : Subgroup (MulAut K)}
    (hEI : ∀ e ∈ E, ggInducedAut θ e ∈ I) :
    Nat.card (((E.map (ggInducedAut θ)).comap Θ).map H.subtype) = Nat.card E := by
  have hinjAut : Function.Injective (ggInducedAut θ) := ggInducedAut_injective_of_perfect hK θ
  have hle : E.map (ggInducedAut θ) ≤ Θ.range := by
    rintro φ hφ
    obtain ⟨e, he, rfl⟩ := Subgroup.mem_map.mp hφ
    obtain ⟨g, hg⟩ := (hI _).mp (hEI e he)
    exact ⟨g, hg⟩
  have hmap : ((E.map (ggInducedAut θ)).comap Θ).map Θ = E.map (ggInducedAut θ) :=
    Subgroup.map_comap_eq_self hle
  have h1 : Nat.card (((E.map (ggInducedAut θ)).comap Θ).map Θ) =
      Nat.card ((E.map (ggInducedAut θ)).comap Θ) :=
    Subgroup.card_map_of_injective hΘ
  rw [hmap] at h1
  have h2 : Nat.card (E.map (ggInducedAut θ)) = Nat.card E :=
    Subgroup.card_map_of_injective hinjAut
  have h3 : Nat.card (((E.map (ggInducedAut θ)).comap Θ).map H.subtype) =
      Nat.card ((E.map (ggInducedAut θ)).comap Θ) :=
    Subgroup.card_map_of_injective H.subtype_injective
  rw [h3, ← h1, h2]

private theorem ggL45E67Torus_finite_ratPoints {τ : Tag} {L : Type} [Field L]
    {F₀ : ModGL τ L →* ModGL τ L} {H : Subgroup (ModGL τ L)}
    (hH : ∀ x, x ∈ H ↔ x ∈ adjointGroup τ L ∧ (⇑F₀)^[3] x = x)
    {R : Type} [Group R] (Θ : H →* MulAut R) (hΘ : Function.Injective Θ)
    {K : Type} [Group K] [Finite K] (θ : K ⧸ Subgroup.center K ≃* R) :
    Finite ↥(ratPoints F₀) := by
  haveI hRfin : Finite R := Finite.of_surjective θ θ.surjective
  haveI hAutfin : Finite (MulAut R) := TableBSymp.finite_mulAut
  haveI hHfin : Finite H := Finite.of_injective Θ hΘ
  refine Finite.of_injective (fun x : ratPoints F₀ =>
    (⟨x.1, ?_⟩ : H)) (fun x y hxy => Subtype.ext (congrArg (fun z : H => (z : ModGL τ L)) hxy))
  rw [hH]
  refine ⟨(Subgroup.mem_inf.mp x.2).1, ?_⟩
  have hx : F₀ (x : ModGL τ L) = (x : ModGL τ L) := (Subgroup.mem_inf.mp x.2).2
  rw [ggL45E67Torus_iterate_three]
  simp [hx]

private theorem ggL45E67Torus_fixed_of_iterate {G : Type*} [Group G] (f : G →* G) {x : G}
    {j : ℕ} (h3 : (⇑f)^[3] x = x) (hj : ¬ 3 ∣ j) (hjn : (⇑f)^[j] x = x) : f x = x := by
  have hj' : j % 3 ≠ 0 := fun h => hj (Nat.dvd_iff_mod_eq_zero.mpr h)
  have hmod : (⇑f)^[j % 3] x = x := by
    have h3m : ∀ m : ℕ, (⇑f)^[3 * m] x = x := by
      intro m
      induction m with
      | zero => simp
      | succ m ih => rw [Nat.mul_succ, Function.iterate_add_apply, h3, ih]
    have h1 : (⇑f)^[j] x = (⇑f)^[j % 3] ((⇑f)^[3 * (j / 3)] x) := by
      conv_lhs => rw [← Nat.div_add_mod j 3, Nat.add_comm]
      rw [Function.iterate_add_apply]
    rw [h1, h3m] at hjn
    exact hjn
  have hlt : j % 3 < 3 := Nat.mod_lt _ (by norm_num)
  rcases (by omega : j % 3 = 1 ∨ j % 3 = 2) with h1 | h2
  · rw [h1, Function.iterate_one] at hmod
    exact hmod
  · rw [h2] at hmod
    have h3' : f ((⇑f)^[2] x) = x := by
      rw [← Function.iterate_succ_apply' (f := ⇑f) (n := 2) (x := x)]
      exact h3
    rw [hmod] at h3'
    exact h3'

private theorem ggL45E67Torus_mem_adjointGroup
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {e : ℕ}
    {F₀ : ModGL τ L →* ModGL τ L} (hF₀ : IsSteinbergEnd τ L (2 ^ e) F₀) :
    ∀ g ∈ adjointGroup τ L, F₀ g ∈ adjointGroup τ L := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Fr, hFr, P, hP, hΦ⟩ := hF₀
  have hFr' : Fr = iterateFrobenius L 2 e := by
    ext c
    rw [hFr c, iterateFrobenius_def]
  have hPmat : IsDiagramTwistMatrix τ L P := by
    rcases hP with rfl | ⟨t, ht, rfl⟩
    · exact Or.inl rfl
    · subst ht
      exact Or.inr ⟨t, 1, rfl, by simp [diagramAt]⟩
  intro g hg
  rw [hΦ, hFr']
  have hconj : (adjointGroup τ L).map (MulAut.conj P).toMonoidHom = adjointGroup τ L :=
    hPmat.map_conj_eq
  rw [← hconj]
  exact ⟨entrywiseFrobGL τ L 2 e g, entrywiseFrobGL_mem (p := 2) e hg,
    by rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]⟩

private theorem ggL45E67Torus_maps_H
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {e : ℕ}
    {F₀ : ModGL τ L →* ModGL τ L} (hF₀ : IsSteinbergEnd τ L (2 ^ e) F₀)
    {H : Subgroup (ModGL τ L)} (hH : ∀ x, x ∈ H ↔ x ∈ adjointGroup τ L ∧ (⇑F₀)^[3] x = x) :
    ∀ x ∈ H, F₀ x ∈ H := by
  intro x hx
  have hxG : x ∈ adjointGroup τ L := ((hH x).mp hx).1
  have hx3 : (⇑F₀)^[3] x = x := ((hH x).mp hx).2
  rw [hH]
  refine ⟨ggL45E67Torus_mem_adjointGroup hF₀ x hxG, ?_⟩
  have hcomm : (⇑F₀)^[3] (F₀ x) = F₀ ((⇑F₀)^[3] x) := by
    rw [← Function.iterate_succ_apply (f := ⇑F₀) (n := 3) (x := x),
      Function.iterate_succ_apply']
  rw [hcomm, hx3]

private theorem ggL45E67Torus_isToral_map_conj
    {τ : Tag} {L : Type} [Field L] {B : Subgroup (ModGL τ L)} {v : ModGL τ L}
    (hv : v ∈ adjointGroup τ L) (hB : IsToralSubgroup τ L B) :
    IsToralSubgroup τ L (B.map (MulAut.conj v⁻¹).toMonoidHom) := by
  obtain ⟨g₀, hg₀, hg₀B⟩ := hB
  refine ⟨v⁻¹ * g₀, mul_mem (inv_mem hv) hg₀, ?_⟩
  rintro x ⟨b, hb, rfl⟩
  have hx : (MulEquiv.toMonoidHom (MulAut.conj v⁻¹)) b = v⁻¹ * b * v := by
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
  rw [hx]
  have h1 : (v⁻¹ * g₀)⁻¹ * (v⁻¹ * b * v) * (v⁻¹ * g₀) = g₀⁻¹ * b * g₀ := by group
  rw [h1]
  exact hg₀B b hb

@[reducible] private noncomputable def ggL45E67TorusN
    {τ : Tag} {L : Type} [Field L]
    (w : WeylGroup τ) : ModGL τ L := canonicalRep (coxeterSystem τ) L w

private theorem ggL45E67Torus_f_commutes
    {τ : Tag} {L : Type} [Field L] {K : Type} [Group K] {R : Type} [Group R]
    {H : Subgroup (ModGL τ L)} (Θ : H →* MulAut R) {ψ : MulAut K}
    {E : Subgroup (MulAut K)} (θ : K ⧸ Subgroup.center K ≃* R)
    (hEψ : ∀ e ∈ E, e * ψ = ψ * e)
    {f : MulAut R} {u : H} (hψ : ggInducedAut θ ψ = Θ u * f * (Θ u)⁻¹)
    {e : MulAut K} (he : e ∈ E) {h : H} (hΘh : Θ h = ggInducedAut θ e) :
    f * Θ (u⁻¹ * h * u) * f⁻¹ = Θ (u⁻¹ * h * u) := by
  have hψh : ggInducedAut θ ψ * Θ h = Θ h * ggInducedAut θ ψ := by
    have h1 := congrArg (ggInducedAut θ) (hEψ e he)
    rw [map_mul, map_mul, ← hΘh] at h1
    exact h1.symm
  have hfeq : f = (Θ u)⁻¹ * ggInducedAut θ ψ * Θ u := by rw [hψ]; group
  have hΘX : Θ (u⁻¹ * h * u) = (Θ u)⁻¹ * Θ h * Θ u := by rw [map_mul, map_mul, map_inv]
  have hc : f * Θ (u⁻¹ * h * u) = Θ (u⁻¹ * h * u) * f := by
    rw [hfeq, hΘX]
    calc ((Θ u)⁻¹ * ggInducedAut θ ψ * Θ u) * ((Θ u)⁻¹ * Θ h * Θ u)
        = (Θ u)⁻¹ * (ggInducedAut θ ψ * Θ h) * Θ u := by group
      _ = (Θ u)⁻¹ * (Θ h * ggInducedAut θ ψ) * Θ u := by rw [hψh]
      _ = ((Θ u)⁻¹ * Θ h * Θ u) * ((Θ u)⁻¹ * ggInducedAut θ ψ * Θ u) := by group
  rw [hc, mul_assoc, mul_inv_cancel, mul_one]

private theorem ggL45E67Torus_iterate_mem_H {τ : Tag} {L : Type} [Field L]
    {F₀ : ModGL τ L →* ModGL τ L} {H : Subgroup (ModGL τ L)}
    (hF₀H : ∀ x ∈ H, F₀ x ∈ H) {x : ModGL τ L} (hx : x ∈ H) :
    ∀ n : ℕ, (⇑F₀)^[n] x ∈ H := by
  intro n
  induction n with
  | zero => simpa using hx
  | succ n ih => rw [Function.iterate_succ_apply']; exact hF₀H _ ih

private theorem ggL45E67Torus_Xj {τ : Tag} {L : Type} [Field L]
    {F₀ : ModGL τ L →* ModGL τ L} {H : Subgroup (ModGL τ L)}
    (hH : ∀ x, x ∈ H ↔ x ∈ adjointGroup τ L ∧ (⇑F₀)^[3] x = x)
    (hF₀H : ∀ x ∈ H, F₀ x ∈ H) {R : Type} [Group R] (Θ : H →* MulAut R)
    (hΘ : Function.Injective Θ) {K : Type} [Group K] (θ : K ⧸ Subgroup.center K ≃* R)
    {ψ : MulAut K} {E : Subgroup (MulAut K)} (hEψ : ∀ e ∈ E, e * ψ = ψ * e)
    {f : MulAut R} (u : H) (hψ : ggInducedAut θ ψ = Θ u * f * (Θ u)⁻¹) {j : ℕ}
    (hfj : ∀ h h' : H, (h' : ModGL τ L) = (⇑F₀)^[j] h → f * Θ h * f⁻¹ = Θ h')
    {h : H} (hh : Θ h ∈ Subgroup.map (ggInducedAut θ) E) :
    (⇑F₀)^[j] ((u : ModGL τ L)⁻¹ * (h : ModGL τ L) * (u : ModGL τ L)) =
      (u : ModGL τ L)⁻¹ * (h : ModGL τ L) * (u : ModGL τ L) := by
  obtain ⟨e, he, heq⟩ := Subgroup.mem_map.mp hh
  have hUG : (u : ModGL τ L) ∈ adjointGroup τ L := ((hH _).mp u.2).1
  have hU3 : (⇑F₀)^[3] (u : ModGL τ L) = (u : ModGL τ L) := ((hH _).mp u.2).2
  have hhG : (h : ModGL τ L) ∈ adjointGroup τ L := ((hH _).mp h.2).1
  have hh3 : (⇑F₀)^[3] (h : ModGL τ L) = (h : ModGL τ L) := ((hH _).mp h.2).2
  set X : ModGL τ L := (u : ModGL τ L)⁻¹ * (h : ModGL τ L) * (u : ModGL τ L) with hX
  have hX3 : (⇑F₀)^[3] X = X := by
    rw [hX, iterate_map_mul, iterate_map_mul, iterate_map_inv, hU3, hh3]
  have hXG : X ∈ adjointGroup τ L := mul_mem (mul_mem (inv_mem hUG) hhG) hUG
  have hXH : X ∈ H := by rw [hH]; exact ⟨hXG, hX3⟩
  have hXHj := ggL45E67Torus_iterate_mem_H hF₀H hXH j
  have heqH : (⟨X, hXH⟩ : H) = u⁻¹ * h * u := by
    refine Subtype.ext ?_
    show X = (↑(u⁻¹ * h * u) : ModGL τ L)
    rw [hX]; rfl
  have hcomm : f * Θ ⟨X, hXH⟩ * f⁻¹ = Θ ⟨X, hXH⟩ := by
    rw [heqH]
    exact ggL45E67Torus_f_commutes Θ θ hEψ hψ he heq.symm
  have hfjX := hfj ⟨X, hXH⟩ ⟨(⇑F₀)^[j] X, hXHj⟩ rfl
  have hΘeq : Θ ⟨(⇑F₀)^[j] X, hXHj⟩ = Θ ⟨X, hXH⟩ := by
    rw [← hfjX, hcomm]
  have := congrArg (fun z : H => (z : ModGL τ L)) (hΘ hΘeq)
  simpa [hX] using this

private theorem ggL45E67Torus_le_ratPoints {τ : Tag} {L : Type} [Field L]
    {F₀ : ModGL τ L →* ModGL τ L} {H : Subgroup (ModGL τ L)}
    (hH : ∀ x, x ∈ H ↔ x ∈ adjointGroup τ L ∧ (⇑F₀)^[3] x = x)
    (hF₀H : ∀ x ∈ H, F₀ x ∈ H) {R : Type} [Group R] (Θ : H →* MulAut R)
    (hΘ : Function.Injective Θ) {K : Type} [Group K]
    (θ : K ⧸ Subgroup.center K ≃* R) {ψ : MulAut K}
