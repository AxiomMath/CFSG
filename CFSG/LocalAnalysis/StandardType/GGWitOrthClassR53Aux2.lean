def owR53_tIdx (w : Fin 3 → ZMod 5) (c : ZMod 5) : ℕ :=
  (w 0).val.pred + 4 * (w 1).val.pred + 16 * (w 2).val.pred + 64 * c.val.pred

def owR53_triple (w : Fin 3 → ZMod 5) (c : ZMod 5) : Fin 3 → Fin 3 → ZMod 5 :=
  fun k i => ((owR53_tripleTab.getD (owR53_tIdx w c) []).getD (3 * k.val + i.val) 0 : ZMod 5)

@[expose] def owR53_rf (w : Fin 3 → ZMod 5) (c : ZMod 5) (a : Fin 3 → ZMod 5)
    (v : Fin 3 → ZMod 5) : Fin 3 → ZMod 5 :=
  v - ((2 * c⁻¹) * ∑ i, w i * (v i * a i)) • a

theorem owR53_neg_scal : ∀ w : Fin 3 → ZMod 5, w 0 ≠ 0 → w 1 ≠ 0 → w 2 ≠ 0 →
    ∀ c : ZMod 5, c ≠ 0 → IsSquare (-(w 0 * w 1 * w 2) * c) →
    (∑ i, w i * (owR53_triple w c 0 i * owR53_triple w c 0 i)) = c ∧
    (∑ i, w i * (owR53_triple w c 1 i * owR53_triple w c 1 i)) = c ∧
    (∑ i, w i * (owR53_triple w c 2 i * owR53_triple w c 2 i)) = c ∧
    (∑ i, w i * (owR53_triple w c 0 i * owR53_triple w c 1 i)) = 0 ∧
    (∑ i, w i * (owR53_triple w c 0 i * owR53_triple w c 2 i)) = 0 ∧
    (∑ i, w i * (owR53_triple w c 1 i * owR53_triple w c 2 i)) = 0 := by
  decide +kernel

theorem owR53_neg_prod : ∀ w : Fin 3 → ZMod 5, w 0 ≠ 0 → w 1 ≠ 0 → w 2 ≠ 0 →
    ∀ c : ZMod 5, c ≠ 0 → IsSquare (-(w 0 * w 1 * w 2) * c) →
    ∀ v : Fin 3 → ZMod 5,
      owR53_rf w c (owR53_triple w c 0) (owR53_rf w c (owR53_triple w c 1)
        (owR53_rf w c (owR53_triple w c 2) v)) = -v := by
  decide +kernel

