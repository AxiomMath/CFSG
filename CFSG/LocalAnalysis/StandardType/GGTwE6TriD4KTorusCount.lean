@[expose] def d4Idx : Fin 4 → Fin Tag.E6.rank := ![1, 2, 3, 4]

@[expose] def d4Supp (x : Fin Tag.E6.rank → ℤ) : Bool :=
  (List.finRange Tag.E6.rank).all fun k =>
    if 1 ≤ k.val ∧ k.val ≤ 4 then true else x k == 0

@[expose] def d4Roots : List (Fin Tag.E6.rank → ℤ) :=
  ((List.range e6Certificate.roots.length).filter fun k =>
      d4Supp (e6Certificate.root k)).map e6Certificate.root

@[expose] def triD4KPairs : List (Fin 4 × Fin 4) :=
  [(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3)]

@[expose] def triD4KPairOK (b : Fin 4 → Fin Tag.E6.rank → ℤ) (p r : Fin 4) : Bool :=
  decide (∀ y : Fin 4 → ZMod 3,
    (∀ j : Fin 4, (∑ m : Fin 4, (b j (d4Idx m)) • y m) + y j = 0) →
      y p = 0 → y r = 0 → ∀ m : Fin 4, y m = 0)

@[expose] def triD4KWitness (b : Fin 4 → Fin Tag.E6.rank → ℤ) : Bool :=
  triD4KPairs.any fun pr => triD4KPairOK b pr.1 pr.2

@[expose] def triD4KMod2 (x y : Fin Tag.E6.rank → ℤ) : Bool :=
  (List.finRange Tag.E6.rank).all fun k => (x k - y k) % 2 == 0

@[expose] def triD4KMod2A (b : Fin 4 → Fin Tag.E6.rank → ℤ) : Bool :=
  triD4KMod2 (b 0 + b 1) (Pi.single 2 1 + Pi.single 4 1) &&
    triD4KMod2 (b 0 + b 3) (Pi.single 2 1 + Pi.single 1 1) &&
      triD4KMod2 (b 1 + b 3) (Pi.single 4 1 + Pi.single 1 1)

@[expose] def triD4KMod2B (b : Fin 4 → Fin Tag.E6.rank → ℤ) : Bool :=
  triD4KMod2 (b 0 + b 1) (Pi.single 4 1 + Pi.single 1 1) &&
    triD4KMod2 (b 0 + b 3) (Pi.single 4 1 + Pi.single 2 1) &&
      triD4KMod2 (b 1 + b 3) (Pi.single 1 1 + Pi.single 2 1)

@[expose] def triD4KCheck : Bool :=
  d4Roots.all fun b0 =>
    if iform b0 b0 == Tag.E6.cartan (d4Idx 0) (d4Idx 0) then
      d4Roots.all fun b1 =>
        if iform b0 b1 == Tag.E6.cartan (d4Idx 0) (d4Idx 1) then
          d4Roots.all fun b2 =>
            if (iform b0 b2 == Tag.E6.cartan (d4Idx 0) (d4Idx 2)) &&
                (iform b1 b2 == Tag.E6.cartan (d4Idx 1) (d4Idx 2)) &&
                (iform b2 b2 == Tag.E6.cartan (d4Idx 2) (d4Idx 2)) then
              d4Roots.all fun b3 =>
                if (iform b0 b3 == Tag.E6.cartan (d4Idx 0) (d4Idx 3)) &&
                    (iform b1 b3 == Tag.E6.cartan (d4Idx 1) (d4Idx 3)) &&
                    (iform b2 b3 == Tag.E6.cartan (d4Idx 2) (d4Idx 3)) &&
                    (iform b3 b3 == Tag.E6.cartan (d4Idx 3) (d4Idx 3)) then
                  !(triD4KMod2A ![b0, b1, b2, b3] || triD4KMod2B ![b0, b1, b2, b3]) ||
                    triD4KWitness ![b0, b1, b2, b3]
                else true
            else true
        else true
    else true

private theorem triD4KCheck_eq : triD4KCheck = true := by decide +kernel

private theorem d4Idx_mem' :
    ∀ m : Fin 4, 1 ≤ (d4Idx m).val ∧ (d4Idx m).val ≤ 4 := by
  decide +kernel

private theorem d4Idx_mem (m : Fin 4) : d4Idx m ∈ d4Nodes Tag.E6 := d4Idx_mem' m

private theorem d4Idx_injective : Function.Injective d4Idx := by
  intro a b hab
  fin_cases a <;> fin_cases b <;> first | rfl | exact absurd hab (by decide)

private theorem d4Idx_surj' :
    ∀ k : Fin Tag.E6.rank, 1 ≤ k.val ∧ k.val ≤ 4 → ∃ m : Fin 4, d4Idx m = k := by
  decide +kernel

private theorem d4Idx_surj {k : Fin Tag.E6.rank} (hk : k ∈ d4Nodes Tag.E6) :
    ∃ m : Fin 4, d4Idx m = k := d4Idx_surj' k hk

private theorem d4Idx_cases (k : Fin Tag.E6.rank) :
    (1 ≤ k.val ∧ k.val ≤ 4) ∨ k = 0 ∨ k = 5 := by
  fin_cases k <;> decide

private theorem d4Supp_eq_true {x : Fin Tag.E6.rank → ℤ}
    (h : ∀ k, k ∉ d4Nodes Tag.E6 → x k = 0) : d4Supp x = true := by
  rw [d4Supp, List.all_eq_true]
  intro k _
  by_cases hk : 1 ≤ k.val ∧ k.val ≤ 4
  · rw [if_pos hk]
  · rw [if_neg hk, beq_iff_eq]
    exact h k hk

private theorem mem_d4Roots
    {x : Fin Tag.E6.rank → ℤ} (hroot : IsRoot Tag.E6 x)
    (hsupp : d4Supp x = true) : x ∈ d4Roots := by
  obtain ⟨k, hk, hkx⟩ := RootCertificate.exists_root_eq e6Certificate_check hroot
  rw [d4Roots, List.mem_map]
  refine ⟨k, ?_, hkx⟩
  rw [List.mem_filter, List.mem_range]
  exact ⟨hk, by rw [hkx]; exact hsupp⟩

private theorem triD4KPairs_ne : ∀ pr ∈ triD4KPairs, pr.1 ≠ pr.2 := by
  intro pr hpr
  obtain ⟨a, b⟩ := pr
  fin_cases a <;> fin_cases b <;> simp_all [triD4KPairs]

private theorem triD4K_exists_pair
    (b : Fin 4 → Fin Tag.E6.rank → ℤ)
    (hb0 : b 0 ∈ d4Roots) (hb1 : b 1 ∈ d4Roots) (hb2 : b 2 ∈ d4Roots) (hb3 : b 3 ∈ d4Roots)
    (h00 : iform (b 0) (b 0) = Tag.E6.cartan (d4Idx 0) (d4Idx 0))
    (h01 : iform (b 0) (b 1) = Tag.E6.cartan (d4Idx 0) (d4Idx 1))
    (h02 : iform (b 0) (b 2) = Tag.E6.cartan (d4Idx 0) (d4Idx 2))
    (h12 : iform (b 1) (b 2) = Tag.E6.cartan (d4Idx 1) (d4Idx 2))
    (h22 : iform (b 2) (b 2) = Tag.E6.cartan (d4Idx 2) (d4Idx 2))
    (h03 : iform (b 0) (b 3) = Tag.E6.cartan (d4Idx 0) (d4Idx 3))
    (h13 : iform (b 1) (b 3) = Tag.E6.cartan (d4Idx 1) (d4Idx 3))
    (h23 : iform (b 2) (b 3) = Tag.E6.cartan (d4Idx 2) (d4Idx 3))
    (h33 : iform (b 3) (b 3) = Tag.E6.cartan (d4Idx 3) (d4Idx 3))
    (hmod : (triD4KMod2A b || triD4KMod2B b) = true) :
    ∃ p r : Fin 4, p ≠ r ∧ ∀ y : Fin 4 → ZMod 3,
      (∀ j : Fin 4, (∑ m : Fin 4, (b j (d4Idx m)) • y m) + y j = 0) →
        y p = 0 → y r = 0 → ∀ m : Fin 4, y m = 0 := by
  have hc := triD4KCheck_eq
  rw [triD4KCheck, List.all_eq_true] at hc
  have h0 := hc (b 0) hb0
  rw [if_pos (by rw [beq_iff_eq]; exact h00)] at h0
  rw [List.all_eq_true] at h0
  have h1 := h0 (b 1) hb1
  rw [if_pos (by rw [beq_iff_eq]; exact h01)] at h1
  rw [List.all_eq_true] at h1
  have h2 := h1 (b 2) hb2
  rw [if_pos (by
    rw [Bool.and_eq_true, Bool.and_eq_true]
    exact ⟨⟨by rw [beq_iff_eq]; exact h02, by rw [beq_iff_eq]; exact h12⟩,
      by rw [beq_iff_eq]; exact h22⟩)] at h2
  rw [List.all_eq_true] at h2
  have h3 := h2 (b 3) hb3
  rw [if_pos (by
    rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true]
    exact ⟨⟨⟨by rw [beq_iff_eq]; exact h03, by rw [beq_iff_eq]; exact h13⟩,
      by rw [beq_iff_eq]; exact h23⟩, by rw [beq_iff_eq]; exact h33⟩)] at h3
  have hbvec : (![b 0, b 1, b 2, b 3] : Fin 4 → Fin Tag.E6.rank → ℤ) = b := by
    funext j
    fin_cases j <;> rfl
  rw [hbvec, hmod, Bool.not_true, Bool.false_or] at h3
  rw [triD4KWitness, List.any_eq_true] at h3
  obtain ⟨pr, hpr, hok⟩ := h3
  exact ⟨pr.1, pr.2, triD4KPairs_ne pr hpr, of_decide_eq_true hok⟩

private theorem sum_d4Idx {M : Type*} [AddCommMonoid M] (f : Fin Tag.E6.rank → M)
    (hf : ∀ k, k ∉ d4Nodes Tag.E6 → f k = 0) :
    ∑ k, f k = ∑ m : Fin 4, f (d4Idx m) := by
  have himage : (Finset.univ.image d4Idx : Finset (Fin Tag.E6.rank)) =
      Finset.univ.filter (fun k => 1 ≤ k.val ∧ k.val ≤ 4) := by
    ext k
    rw [Finset.mem_image, Finset.mem_filter]
    constructor
    · rintro ⟨m, -, rfl⟩
      exact ⟨Finset.mem_univ _, d4Idx_mem' m⟩
    · rintro ⟨-, hk⟩
      obtain ⟨m, hm⟩ := d4Idx_surj' k hk
      exact ⟨m, Finset.mem_univ _, hm⟩
  have h1 : ∑ k ∈ Finset.univ.filter (fun k => 1 ≤ k.val ∧ k.val ≤ 4), f k = ∑ k, f k :=
    Finset.sum_subset (Finset.filter_subset _ _) (fun x _ hx => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
      exact hf x hx)
  rw [← h1, ← himage, Finset.sum_image]
  exact fun a _ b _ hab => d4Idx_injective hab

private theorem triD4KMod2_eq_true {x y : Fin Tag.E6.rank → ℤ}
    (h : ∀ k, (2 : ℤ) ∣ (x - y) k) : triD4KMod2 x y = true := by
  rw [triD4KMod2, List.all_eq_true]
  intro k _
  exact beq_iff_eq.2 (Int.emod_eq_zero_of_dvd (h k))

private theorem e6_symmetrizer_self (i : Fin Tag.E6.rank) : Tag.E6.symmetrizer i i = 1 := by
  simp [Tag.symmetrizer]

private theorem iform_single_single_e6
    (a c : Fin Tag.E6.rank) :
    iform (Pi.single a 1 : Fin Tag.E6.rank → ℤ) (Pi.single c 1) = Tag.E6.cartan a c := by
  rw [iform_single_left]
  have hsum : ∑ j, Tag.E6.cartan a j * (Pi.single c 1 : Fin Tag.E6.rank → ℤ) j =
      Tag.E6.cartan a c := by
    rw [Finset.sum_eq_single c (fun j _ hj => by rw [Pi.single_eq_of_ne hj, mul_zero])
      (fun h => absurd (Finset.mem_univ c) h)]
    rw [Pi.single_eq_same, mul_one]
  rw [hsum, e6_symmetrizer_self, one_mul]

private theorem triD4K_smul_two
    (u : WeylGroup Tag.E6) (hu : u ∈ parabolicWeylGroup Tag.E6 (d4Set Tag.E6))
    (x : Fin Tag.E6.rank → ℤ)
    (hx : ∀ i : Fin Tag.E6.rank, (1 ≤ i.val ∧ i.val ≤ 4) →
      (2 : ℤ) ∣ ∑ k, Tag.E6.cartan i k * x k) :
    ∀ i, (2 : ℤ) ∣ (u • x - x) i := by
  have hle : parabolicWeylGroup Tag.E6 (d4Set Tag.E6) ≤ Subgroup.closure L154RefJ := by
    rw [parabolicWeylGroup]
    refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨j, hj, rfl⟩
    refine Subgroup.subset_closure ⟨Pi.single j 1, single_mem_parabolicRoots hj, ?_⟩
    rw [rootReflection_eq_conj (w := 1) (j := j) (one_smul _ _), one_mul, inv_one, mul_one]
  have hx' : L154D4Ev x := by
    intro j hj
    rw [iform_single_right, e6_symmetrizer_self, one_mul]
    exact hx j hj
  exact (l154td4_parity (hle hu) x).2 hx'

private theorem prod_fst_pow {M N : Type*} [Monoid M] [Monoid N] (x : M × N) (n : ℕ) :
    (x ^ n).1 = x.1 ^ n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ, pow_succ]; exact congrArg (fun y => y * x.1) ih

private theorem card_subgroup_pow_three_le_eightyOne {L : Type*} [Field L]
    (H : Subgroup ((Lˣ × Lˣ) × (Lˣ × Lˣ))) (hH : ∀ x ∈ H, x ^ 3 = 1) :
    Nat.card H ≤ 3 ^ 4 := by
  classical
  let φ : H → (Fin 4 → rootsOfUnity 3 L) := fun x =>
    ![⟨x.1.1.1, by
        rw [mem_rootsOfUnity]
        have h := congrArg (fun w => w.1.1) (hH x.1 x.2)
        simpa [prod_fst_pow x.1 3, prod_fst_pow x.1.1 3] using h⟩,
      ⟨x.1.1.2, by
        rw [mem_rootsOfUnity]
        have h := congrArg (fun w => w.1.2) (hH x.1 x.2)
        simpa [prod_fst_pow x.1 3, prod_fst_pow x.1.1 3] using h⟩,
      ⟨x.1.2.1, by
        rw [mem_rootsOfUnity]
        have h := congrArg (fun w => w.2.1) (hH x.1 x.2)
        simpa [prod_fst_pow x.1 3, prod_fst_pow x.1.2 3] using h⟩,
      ⟨x.1.2.2, by
        rw [mem_rootsOfUnity]
        have h := congrArg (fun w => w.2.2) (hH x.1 x.2)
        simpa [prod_fst_pow x.1 3, prod_fst_pow x.1.2 3] using h⟩]
  have hφ : Function.Injective φ := by
    intro x y hxy
    have e0 := congrFun hxy 0
    have e1 := congrFun hxy 1
    have e2 := congrFun hxy 2
    have e3 := congrFun hxy 3
    apply Subtype.ext
    exact Prod.ext (Prod.ext (Subtype.ext_iff.1 e0) (Subtype.ext_iff.1 e1))
      (Prod.ext (Subtype.ext_iff.1 e2) (Subtype.ext_iff.1 e3))
  calc
    Nat.card H ≤ Nat.card (Fin 4 → rootsOfUnity 3 L) := Nat.card_le_card_of_injective φ hφ
    _ = Nat.card (rootsOfUnity 3 L) ^ 4 := by rw [Nat.card_fun, Nat.card_fin]
    _ ≤ 3 ^ 4 := Nat.pow_le_pow_left (card_rootsOfUnity (k := 3) (R := L)) 4

private theorem key
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup Tag.E6 L p₀)
    (h3 : ((3 : ℕ) : L) ≠ 0) (h3q : 3 ∣ S.D.q + 1) (v u : WeylGroup Tag.E6)
    (hu : u ∈ parabolicWeylGroup Tag.E6 (d4Set Tag.E6)) {π : Equiv.Perm (Fin Tag.E6.rank)}
    (hπJ : ∀ j : Fin 4, 1 ≤ (π (d4Idx j)).val ∧ (π (d4Idx j)).val ≤ 4)
    (hπc : ∀ j m : Fin 4,
      Tag.E6.cartan (π (d4Idx j)) (π (d4Idx m)) = Tag.E6.cartan (d4Idx j) (d4Idx m))
    (hθ : ∀ α ∈ parabolicRoots Tag.E6 (d4Nodes Tag.E6), v⁻¹ • S.ρ (v • α) = u • permLattice π α)
    (X : Subgroup (ModGL Tag.E6 L)) (hX : X ≤ S.D.torus) (hX3 : ∀ x ∈ X, x ^ 3 = 1)
    (hmod : (triD4KMod2A (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) ||
      triD4KMod2B (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ))) = true) :
    Nat.card X ≤ 3 ^ 4 := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set b : Fin 4 → Fin Tag.E6.rank → ℤ :=
    fun j => u • (Pi.single (π (d4Idx j)) 1) with hb
  have hbroot : ∀ j, IsRoot Tag.E6 (b j) := fun j =>
    IsRoot.smul (IsRoot.basis (π (d4Idx j))) u
  have hbsupp : ∀ j k, k ∉ d4Nodes Tag.E6 → b j k = 0 := by
    intro j k hk
    show (u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) k = 0
    rw [smul_apply_of_mem_parabolicWeylGroup hu _ hk]
    have hne : k ≠ π (d4Idx j) := by
      intro h
      exact hk (by rw [h]; exact hπJ j)
    have hsingle : (Pi.single (π (d4Idx j)) (1 : ℤ) : Fin Tag.E6.rank → ℤ) k = 0 := by
      rw [Pi.single_apply, if_neg hne]
    exact hsingle
  have hbgram : ∀ j m, iform (b j) (b m) = Tag.E6.cartan (d4Idx j) (d4Idx m) := by
    intro j m
    rw [hb, iform_smul, iform_single_single_e6]
    exact hπc j m
  have hθb : ∀ j : Fin 4, v⁻¹ • S.ρ (v • (Pi.single (d4Idx j) 1)) = b j := by
    intro j
    have hmem : (Pi.single (d4Idx j) 1 : Fin Tag.E6.rank → ℤ) ∈
        parabolicRoots Tag.E6 (d4Nodes Tag.E6) := single_mem_parabolicRoots (d4Idx_mem j)
    have h := hθ _ hmem
    rw [permLattice_single] at h
    rw [hb]
    exact h
  have hb0 : b 0 ∈ d4Roots := mem_d4Roots (hbroot 0) (d4Supp_eq_true (hbsupp 0))
  have hb1 : b 1 ∈ d4Roots := mem_d4Roots (hbroot 1) (d4Supp_eq_true (hbsupp 1))
  have hb2 : b 2 ∈ d4Roots := mem_d4Roots (hbroot 2) (d4Supp_eq_true (hbsupp 2))
  have hb3 : b 3 ∈ d4Roots := mem_d4Roots (hbroot 3) (d4Supp_eq_true (hbsupp 3))
  obtain ⟨p, r, hpr, hfac⟩ :=
    triD4K_exists_pair b hb0 hb1 hb2 hb3 (hbgram 0 0) (hbgram 0 1) (hbgram 0 2)
      (hbgram 1 2) (hbgram 2 2) (hbgram 0 3) (hbgram 1 3) (hbgram 2 3) (hbgram 3 3) hmod
  have hXG : X ≤ torusGroup Tag.E6 L :=
    fun x hx => (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 (hX hx)).1
  obtain ⟨β, hβ⟩ := exists_rootDiagUnitHom_comp_eq (X.subtype : X →* ModGL Tag.E6 L)
    (fun x => hXG x.2)
  have hβx : ∀ z : X, rootDiagUnit Tag.E6 (β z) = (z : ModGL Tag.E6 L) := fun z =>
    DFunLike.congr_fun hβ z
  have hc3 : ∀ z : X, (β z) ^ 3 = 1 := by
    intro z
    exact CFSG.LieType.Chevalley.rootDiagUnit_injective (τ := Tag.E6) (K := L) (by
      rw [← rootDiagUnit_pow, hβx z, hX3 z.1 z.2, rootDiagUnit_one])
  have hβ3 : ∀ z : X, ∀ i, β z i ^ 3 = 1 := by
    intro z i
    have h := congrFun (hc3 z) i
    simpa using h
  let T : X → Fin Tag.E6.rank → Lˣ := fun z k => rootChar (β z) (v • Pi.single k 1)
  have hT3 : ∀ z k, T z k ^ 3 = 1 := fun z k =>
    CFSG.RankThree.PartOne.KE.CTTorus.rootChar_pow_eq_one (hβ3 z) _
  have hq : ∀ y : Lˣ, y ^ 3 = 1 → y ^ S.D.q = y⁻¹ := by
    intro y hy
    obtain ⟨c, hc⟩ := h3q
    have h : y ^ (S.D.q + 1) = 1 := by
      rw [hc, pow_mul, hy, one_pow]
    rw [pow_succ] at h
    exact (mul_eq_one_iff_eq_inv.1 h)
  have hrel : ∀ (z : X) (j : Fin 4), (∏ k, T z k ^ (b j k)) = (T z (d4Idx j)) ^ S.D.q := by
    intro z j
    have hzT : rootDiagUnit Tag.E6 (β z) ∈ S.D.torus := by
      rw [hβx z]; exact hX z.2
    have hfr := S.frob.rootChar_eq (β z) hzT (v • (Pi.single (d4Idx j) 1))
      (IsRoot.smul (IsRoot.basis (d4Idx j)) v)
    have hstep : S.ρ (v • (Pi.single (d4Idx j) 1)) = v • b j := by
      have h := congrArg (fun x => v • x) (hθb j)
      simpa using h
    rw [hstep, d4t2out_rootChar_smul] at hfr
    exact hfr
  obtain ⟨ζ, hζord⟩ :=
    CFSG.exists_unit_orderOf_eq_of_isAlgClosed (k := L) (n := 3) (by simpa using h3)
  have hζ : IsPrimitiveRoot ζ 3 := IsPrimitiveRoot.iff_orderOf.mpr hζord
  let e := hζ.zmodEquivRootsOfUnity
  let E : X → Fin Tag.E6.rank → ZMod 3 := fun z k =>
    e.symm (Additive.ofMul ⟨T z k, by rw [mem_rootsOfUnity]; exact hT3 z k⟩)
  have hE : ∀ z k, Additive.toMul (e (E z k)) =
      (⟨T z k, by rw [mem_rootsOfUnity]; exact hT3 z k⟩ : rootsOfUnity 3 L) := by
    intro z k
    rw [show e (E z k) = Additive.ofMul ⟨T z k, by rw [mem_rootsOfUnity]; exact hT3 z k⟩
      from AddEquiv.apply_symm_apply e _]
    rfl
  have hEval : ∀ z k,
      (Subgroup.subtype (rootsOfUnity 3 L)) (Additive.toMul (e (E z k))) = T z k := by
    intro z k
    rw [hE]
    rfl
  have hEval' : ∀ z k, ((Additive.toMul (e (E z k)) : rootsOfUnity 3 L) : Lˣ) = T z k :=
    fun z k => hEval z k
  have hlin : ∀ (z : X) (j : Fin 4),
      (∑ k : Fin Tag.E6.rank, (b j k) • E z k) + E z (d4Idx j) = 0 := by
    intro z j
    have hprod : (∏ k, T z k ^ (b j k)) * T z (d4Idx j) = 1 := by
      rw [hrel z j, hq (T z (d4Idx j)) (hT3 z (d4Idx j)), inv_mul_cancel]
    have hcoe : ((∏ k, (Additive.toMul (e (E z k)) : rootsOfUnity 3 L) ^ (b j k) :
        rootsOfUnity 3 L) : Lˣ) = ∏ k, T z k ^ (b j k) := by
      change (Subgroup.subtype (rootsOfUnity 3 L))
        (∏ k, (Additive.toMul (e (E z k)) : rootsOfUnity 3 L) ^ (b j k)) =
          ∏ k, T z k ^ (b j k)
      rw [map_prod]
      refine Finset.prod_congr rfl fun k _ => ?_
      rw [map_zpow, hEval z k]
    have key1 : ↑(Additive.toMul (e (∑ k, (b j k) • E z k))) = (T z (d4Idx j))⁻¹ := by
      have h1 : Additive.toMul (e (∑ k, (b j k) • E z k)) =
          ∏ k, (Additive.toMul (e (E z k)) : rootsOfUnity 3 L) ^ (b j k) := by
        simp only [map_sum, map_zsmul, toMul_sum, toMul_zsmul]
      rw [h1, hcoe]
      exact mul_eq_one_iff_eq_inv.1 hprod
    have key2 : ↑(Additive.toMul (e (-(E z (d4Idx j))))) = (T z (d4Idx j))⁻¹ := by
      rw [map_neg, toMul_neg, Subgroup.coe_inv, hEval']
    have h1 : e (∑ k, (b j k) • E z k) = e (-(E z (d4Idx j))) := by
      apply Additive.toMul.injective
      apply Subtype.ext
      exact key1.trans key2.symm
    have h2 : ∑ k, (b j k) • E z k = -(E z (d4Idx j)) := e.injective h1
    rw [h2, neg_add_cancel]
  let χ : Fin Tag.E6.rank → X →* Lˣ := fun k =>
    { toFun := fun z => T z k
      map_one' := by
        simp only [T, map_one, CFSG.RankThree.PartOne.KE.CTTorus.rootChar_one]
      map_mul' := fun a b => by
        simp only [T, map_mul, CFSG.RankThree.PartOne.KE.CTTorus.rootChar_mul] }
  let f : X →* (Lˣ × Lˣ) × (Lˣ × Lˣ) :=
    ((χ (d4Idx p)).prod (χ (d4Idx r))).prod ((χ 0).prod (χ 5))
  have hf_apply : ∀ z : X, f z = ((T z (d4Idx p), T z (d4Idx r)), (T z 0, T z 5)) := fun z => rfl
  have hker : f.ker = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    rw [Subgroup.mem_bot]
    have hz1 : f z = 1 := MonoidHom.mem_ker.1 hz
    rw [hf_apply] at hz1
    have hp1 : T z (d4Idx p) = 1 := congrArg (fun w => w.1.1) hz1
    have hr1 : T z (d4Idx r) = 1 := congrArg (fun w => w.1.2) hz1
    have h01 : T z 0 = 1 := congrArg (fun w => w.2.1) hz1
    have h51 : T z 5 = 1 := congrArg (fun w => w.2.2) hz1
    have hEk : ∀ k, T z k = 1 → E z k = 0 := by
      intro k hk
      simp only [E]
      rw [show (⟨T z k, by rw [mem_rootsOfUnity]; exact hT3 z k⟩ : rootsOfUnity 3 L) = 1
        from Subtype.ext hk]
      simp
    have hp0 : E z (d4Idx p) = 0 := hEk _ hp1
    have hr0 : E z (d4Idx r) = 0 := hEk _ hr1
    have hsys : ∀ j : Fin 4,
        (∑ m : Fin 4, (b j (d4Idx m)) • E z (d4Idx m)) + E z (d4Idx j) = 0 := by
      intro j
      have h := hlin z j
      rw [sum_d4Idx (fun k => (b j k) • E z k)
        (fun k hk => by rw [hbsupp j k hk, zero_smul])] at h
      exact h
    have hallJ : ∀ m : Fin 4, E z (d4Idx m) = 0 :=
      hfac (fun m => E z (d4Idx m)) hsys hp0 hr0
    have hallT : ∀ k, T z k = 1 := by
      intro k
      rcases d4Idx_cases k with hk | rfl | rfl
      · obtain ⟨m, rfl⟩ := d4Idx_surj hk
        rw [← hEval' z (d4Idx m), hallJ m]
        simp
      · exact h01
      · exact h51
    have hroot1 : ∀ x : Fin Tag.E6.rank → ℤ, rootChar (β z) (v • x) = 1 := by
      intro x
      rw [d4t2out_rootChar_smul]
      refine Finset.prod_eq_one fun k _ => ?_
      change T z k ^ x k = 1
      rw [hallT k, one_zpow]
    have hc1 : β z = 1 := by
      funext i
      have h := hroot1 (v⁻¹ • Pi.single i 1)
      rwa [smul_inv_smul, CFSG.RankThree.PartOne.KE.CTTorus.rootChar_single] at h
    have hz1 : z = 1 := by
      have h := hβx z
      rw [hc1, rootDiagUnit_one] at h
      exact Subtype.ext h.symm
    exact hz1
  have hrange3 : ∀ y ∈ f.range, y ^ 3 = 1 := by
    intro y hy
    obtain ⟨z, rfl⟩ := hy
    have hy3 : z ^ 3 = 1 := by
      apply Subtype.ext
      simpa using hX3 z.1 z.2
    rw [← map_pow, hy3, map_one]
  have hrange := card_subgroup_pow_three_le_eightyOne f.range hrange3
  calc
    Nat.card X = Nat.card f.ker * Nat.card f.range := (Subgroup.card_ker_mul_card_range f).symm
    _ = Nat.card f.range := by rw [hker]; simp
    _ ≤ 3 ^ 4 := hrange

theorem card_le_of_le_torus_of_theta
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup Tag.E6 L p₀)
    (h3 : ((3 : ℕ) : L) ≠ 0) (h3q : 3 ∣ S.D.q + 1) (v u : WeylGroup Tag.E6)
    (hu : u ∈ parabolicWeylGroup Tag.E6 (d4Set Tag.E6)) {π : Equiv.Perm (Fin Tag.E6.rank)}
    (hπ : π = List.formPerm [e6Idx 1, e6Idx 2, e6Idx 4] ∨
      π = List.formPerm [e6Idx 1, e6Idx 4, e6Idx 2])
    (hθ : ∀ α ∈ parabolicRoots Tag.E6 (d4Nodes Tag.E6), v⁻¹ • S.ρ (v • α) = u • permLattice π α)
    (X : Subgroup (ModGL Tag.E6 L)) (hX : X ≤ S.D.torus) (hX3 : ∀ x ∈ X, x ^ 3 = 1) :
    Nat.card X ≤ 3 ^ 4 := by
  rcases hπ with hπ | hπ
  · have hπ1 : π (d4Idx 0) = (2 : Fin Tag.E6.rank) := by rw [hπ]; decide +kernel
    have hπ2 : π (d4Idx 1) = (4 : Fin Tag.E6.rank) := by rw [hπ]; decide +kernel
    have hπ4 : π (d4Idx 3) = (1 : Fin Tag.E6.rank) := by rw [hπ]; decide +kernel
    have hπJ : ∀ j : Fin 4, 1 ≤ (π (d4Idx j)).val ∧ (π (d4Idx j)).val ≤ 4 := by
      rw [hπ]; decide +kernel
    have hπc : ∀ j m : Fin 4,
        Tag.E6.cartan (π (d4Idx j)) (π (d4Idx m)) = Tag.E6.cartan (d4Idx j) (d4Idx m) := by
      rw [hπ]; decide +kernel
    refine key S h3 h3q v u hu hπJ hπc hθ X hX hX3 ?_
    rw [Bool.or_eq_true]
    left
    rw [triD4KMod2A, Bool.and_eq_true, Bool.and_eq_true]
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [triD4KMod2_eq_true]
      intro k
      have h := triD4K_smul_two u hu (Pi.single 2 1 + Pi.single 4 1 : Fin Tag.E6.rank → ℤ)
        (by decide +kernel) k
      have hb01 : ((fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 0 +
          (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 1) =
          u • (Pi.single 2 1 + Pi.single 4 1 : Fin Tag.E6.rank → ℤ) := by
        simp only [hπ1, hπ2, smul_add]
      rw [hb01]
      exact h
    · rw [triD4KMod2_eq_true]
      intro k
      have h := triD4K_smul_two u hu (Pi.single 2 1 + Pi.single 1 1 : Fin Tag.E6.rank → ℤ)
        (by decide +kernel) k
      have hb03 : ((fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 0 +
          (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 3) =
          u • (Pi.single 2 1 + Pi.single 1 1 : Fin Tag.E6.rank → ℤ) := by
        simp only [hπ1, hπ4, smul_add]
      rw [hb03]
      exact h
    · rw [triD4KMod2_eq_true]
      intro k
      have h := triD4K_smul_two u hu (Pi.single 4 1 + Pi.single 1 1 : Fin Tag.E6.rank → ℤ)
        (by decide +kernel) k
      have hb13 : ((fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 1 +
          (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 3) =
          u • (Pi.single 4 1 + Pi.single 1 1 : Fin Tag.E6.rank → ℤ) := by
        simp only [hπ2, hπ4, smul_add]
      rw [hb13]
      exact h
  · have hπ1 : π (d4Idx 0) = (4 : Fin Tag.E6.rank) := by rw [hπ]; decide +kernel
    have hπ2 : π (d4Idx 1) = (1 : Fin Tag.E6.rank) := by rw [hπ]; decide +kernel
    have hπ4 : π (d4Idx 3) = (2 : Fin Tag.E6.rank) := by rw [hπ]; decide +kernel
    have hπJ : ∀ j : Fin 4, 1 ≤ (π (d4Idx j)).val ∧ (π (d4Idx j)).val ≤ 4 := by
      rw [hπ]; decide +kernel
    have hπc : ∀ j m : Fin 4,
        Tag.E6.cartan (π (d4Idx j)) (π (d4Idx m)) = Tag.E6.cartan (d4Idx j) (d4Idx m) := by
      rw [hπ]; decide +kernel
    refine key S h3 h3q v u hu hπJ hπc hθ X hX hX3 ?_
    rw [Bool.or_eq_true]
    right
    rw [triD4KMod2B, Bool.and_eq_true, Bool.and_eq_true]
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [triD4KMod2_eq_true]
      intro k
      have h := triD4K_smul_two u hu (Pi.single 4 1 + Pi.single 1 1 : Fin Tag.E6.rank → ℤ)
        (by decide +kernel) k
      have hb01 : ((fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 0 +
          (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 1) =
          u • (Pi.single 4 1 + Pi.single 1 1 : Fin Tag.E6.rank → ℤ) := by
        simp only [hπ1, hπ2, smul_add]
      rw [hb01]
      exact h
    · rw [triD4KMod2_eq_true]
      intro k
      have h := triD4K_smul_two u hu (Pi.single 4 1 + Pi.single 2 1 : Fin Tag.E6.rank → ℤ)
        (by decide +kernel) k
      have hb03 : ((fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 0 +
          (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 3) =
          u • (Pi.single 4 1 + Pi.single 2 1 : Fin Tag.E6.rank → ℤ) := by
        simp only [hπ1, hπ4, smul_add]
      rw [hb03]
      exact h
    · rw [triD4KMod2_eq_true]
      intro k
      have h := triD4K_smul_two u hu (Pi.single 1 1 + Pi.single 2 1 : Fin Tag.E6.rank → ℤ)
        (by decide +kernel) k
      have hb13 : ((fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 1 +
          (fun j => u • (Pi.single (π (d4Idx j)) 1 : Fin Tag.E6.rank → ℤ)) 3) =
          u • (Pi.single 1 1 + Pi.single 2 1 : Fin Tag.E6.rank → ℤ) := by
        simp only [hπ2, hπ4, smul_add]
      rw [hb13]
      exact h

end CFSG.StandardType.TwE6TriD4K

