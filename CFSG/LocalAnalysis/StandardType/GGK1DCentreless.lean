private theorem ggK1Dz_charP_two {K : Type} [Field K] [Finite K] {nf : ℕ} (hnf : 1 ≤ nf)
    (hK : Nat.card K = 2 ^ nf) : CharP K 2 :=
  CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
    Nat.prime_two hnf hK

private theorem ggK1Dz_center_proj {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    {Q : (ι → K) → K}
    (hbot : (LargeEvenScalars ι K).subgroupOf (LargeEvenOmega Q) = ⊥)
    (hZ : Subgroup.center (LargeEvenOmega Q) = ⊥) :
    Subgroup.center (LargeEvenProj (LargeEvenOmega Q)) = ⊥ := by
  let e := TableBOrth.projMkEquiv hbot
  have h := Subgroup.map_center_eq e
  rw [hZ, Subgroup.map_bot] at h
  exact h.symm

private theorem ggK1Dz_omegaPlus_center {K : Type} [Field K] [Finite K] [CharP K 2] {r : ℕ}
    (hr : 3 ≤ r) :
    Subgroup.center (LargeEvenOmega (LargeEvenQPlus K r)) = ⊥ := by
  rw [CFSG.LieType.Universal.Spin.center_statedOmega_quadPlus hr]
  exact TableBOrth.scalars_subgroupOf_omegaPlus_eq_bot (K := K) (by omega)

private theorem ggK1Dz_omegaPlus_four_center {K : Type} [Field K] [Finite K] [CharP K 2]
    (h4 : 4 ≤ Nat.card K) :
    Subgroup.center (LargeEvenOmega (LargeEvenQPlus K 2)) = ⊥ := by
  obtain ⟨e⟩ := CFSG.RankThree.GF2n.Stroth80.statedOmega_plus_four_nonempty_equiv K h4
  rw [eq_bot_iff]
  intro x hx
  rw [Subgroup.mem_bot]
  have hy : e x ∈ Subgroup.center (↥(StatedSL 2 K) × ↥(StatedSL 2 K)) := by
    rw [Subgroup.mem_center_iff] at hx ⊢
    intro g
    obtain ⟨g', rfl⟩ := e.surjective g
    simpa only [map_mul] using congrArg e (hx g')
  rw [Subgroup.center_prod, CFSG.RankThree.GF2n.Stroth80.center_statedSL_two_eq_bot] at hy
  obtain ⟨h1, h2⟩ := Subgroup.mem_prod.1 hy
  rw [Subgroup.mem_bot] at h1 h2
  exact e.injective (by rw [map_one]; exact Prod.ext h1 h2)

private def ggK1Dz_tau : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) :=
  ⟨!![0, 1; 1, 0], by decide⟩

private def ggK1Dz_x : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) :=
  ⟨!![1, 1; 0, 1], by decide⟩

private def ggK1Dz_y : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) :=
  ⟨!![1, 0; 1, 1], by decide⟩

private def ggK1Dz_c : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) := ⁅ggK1Dz_x, ggK1Dz_y⁆

private theorem ggK1Dz_c_tau_centralizer :
    ∀ a : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      a * ggK1Dz_c = ggK1Dz_c * a → a * ggK1Dz_tau = ggK1Dz_tau * a → a = 1 := by
  decide

private theorem ggK1Dz_tau_sq : ggK1Dz_tau * ggK1Dz_tau = 1 := by decide

open CFSG.LieType.ChevTwo in
private theorem ggK1Dz_omegaPlus_two_zmod2 :
    Subgroup.center (LargeEvenOmega (LargeEvenQPlus (ZMod 2) 2)) = ⊥ := by
  classical
  rw [Subgroup.eq_bot_iff_forall]
  intro z hz
  obtain ⟨x, hx⟩ :=
    CFSG.LieType.ChevTwo.statedOmega_quadPlus_two_le_range_jProd z.2
  obtain ⟨a, b⟩ := x
  have hzab : (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) = j1 a * j2 b := by
    rw [← hx, jProd_apply]
  have hle1 : (j1 (F := ZMod 2)).range ≤ (orthGroup (StatedQuadPlus 2 (ZMod 2))) := by
    rintro _ ⟨A, rfl⟩; exact j1_mem_orthGroup A
  have hle2 : (j2 (F := ZMod 2)).range ≤ (orthGroup (StatedQuadPlus 2 (ZMod 2))) := by
    rintro _ ⟨A, rfl⟩; exact j2_mem_orthGroup A
  have hj1c : j1 ggK1Dz_c ∈ StatedOmega (StatedQuadPlus 2 (ZMod 2)) := by
    have h : j1 ggK1Dz_c ∈
        ⁅(j1 (F := ZMod 2)).range, (j1 (F := ZMod 2)).range⁆ := by
      rw [show j1 ggK1Dz_c = ⁅j1 ggK1Dz_x, j1 ggK1Dz_y⁆ by
        simp only [ggK1Dz_c, map_commutatorElement]]
      exact Subgroup.commutator_mem_commutator
        (MonoidHom.mem_range.mpr ⟨ggK1Dz_x, rfl⟩)
        (MonoidHom.mem_range.mpr ⟨ggK1Dz_y, rfl⟩)
    exact Subgroup.commutator_mono hle1 hle1 h
  have hj2c : j2 ggK1Dz_c ∈ StatedOmega (StatedQuadPlus 2 (ZMod 2)) := by
    have h : j2 ggK1Dz_c ∈
        ⁅(j2 (F := ZMod 2)).range, (j2 (F := ZMod 2)).range⁆ := by
      rw [show j2 ggK1Dz_c = ⁅j2 ggK1Dz_x, j2 ggK1Dz_y⁆ by
        simp only [ggK1Dz_c, map_commutatorElement]]
      exact Subgroup.commutator_mem_commutator
        (MonoidHom.mem_range.mpr ⟨ggK1Dz_x, rfl⟩)
        (MonoidHom.mem_range.mpr ⟨ggK1Dz_y, rfl⟩)
    exact Subgroup.commutator_mono hle2 hle2 h
  set P : GL (Fin 2 ⊕ Fin 2) (ZMod 2) := TauCeti.permutationGL (k := ZMod 2) tauPerm with hPdef
  have hPmem : P ∈ (orthGroup (StatedQuadPlus 2 (ZMod 2))) := by
    rw [hPdef]
    refine TableBSymp.mem_orthGroup_of_isometry fun v => ?_
    rw [CFSG.StandardType.TableBSymp.permutationGL_mulVec]
    exact quadPlus_comp_tauPerm v
  have hPP : P * P = 1 := by
    rw [hPdef]
    apply Units.ext
    simp only [Units.val_mul, Units.val_one, TauCeti.permutationGL_coe]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Equiv.Perm.permMatrix, Matrix.mul_apply, tauPerm, Equiv.swap_apply_def]
  have hconj : ∀ A : GL (Fin 2 ⊕ Fin 2) (ZMod 2), P * A * P = tauConj A := by
    intro A
    rw [hPdef]
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, TauCeti.permutationGL_coe, coe_tauConj]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Equiv.Perm.permMatrix, Matrix.mul_apply, tauPerm, Equiv.swap_apply_def]
  have htau2 : ∀ A : GL (Fin 2 ⊕ Fin 2) (ZMod 2), tauConj (tauConj A) = A := by
    intro A
    apply Units.ext
    rw [coe_tauConj, coe_tauConj]
    ext i j
    simp [Matrix.submatrix_apply, tauPerm_symm, tauPerm_tauPerm, Equiv.apply_symm_apply,
      Equiv.symm_apply_apply]
  have hj2t : j2 ggK1Dz_tau ∈ (orthGroup (StatedQuadPlus 2 (ZMod 2))) :=
    j2_mem_orthGroup ggK1Dz_tau
  have hPj : P * j2 ggK1Dz_tau = j1 ggK1Dz_tau * P := by
    have h := hconj (j2 ggK1Dz_tau)
    rw [show j2 ggK1Dz_tau = tauConj (j1 ggK1Dz_tau) from rfl,
      htau2 (j1 ggK1Dz_tau)] at h
    rw [← h, mul_assoc, hPP, mul_one]
    rfl
  have hj2tau2 : j2 ggK1Dz_tau * j2 ggK1Dz_tau = 1 := by
    rw [← map_mul, ggK1Dz_tau_sq, map_one]
  have hPinv : P⁻¹ = P := inv_eq_of_mul_eq_one_right hPP
  have hu_eq : ⁅P, j2 ggK1Dz_tau⁆ = j1 ggK1Dz_tau * j2 ggK1Dz_tau := by
    rw [commutatorElement_def, hPinv, hPj]
    rw [mul_assoc (j1 ggK1Dz_tau) P P, hPP, mul_one,
      inv_eq_of_mul_eq_one_right hj2tau2]
  have hu : j1 ggK1Dz_tau * j2 ggK1Dz_tau ∈ StatedOmega (StatedQuadPlus 2 (ZMod 2)) := by
    rw [← hu_eq]
    exact Subgroup.commutator_mem_commutator hPmem hj2t
  have hcomm_c1 : j1 ggK1Dz_c * (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) =
      (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) * j1 ggK1Dz_c := by
    have h := Subgroup.mem_center_iff.mp hz
      (⟨j1 ggK1Dz_c, hj1c⟩ : StatedOmega (StatedQuadPlus 2 (ZMod 2)))
    simpa using congrArg Subtype.val h
  have hcomm_c2 : j2 ggK1Dz_c * (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) =
      (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) * j2 ggK1Dz_c := by
    have h := Subgroup.mem_center_iff.mp hz
      (⟨j2 ggK1Dz_c, hj2c⟩ : StatedOmega (StatedQuadPlus 2 (ZMod 2)))
    simpa using congrArg Subtype.val h
  have hcomm_t : (j1 ggK1Dz_tau * j2 ggK1Dz_tau) *
      (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) =
      (z : GL (Fin 2 ⊕ Fin 2) (ZMod 2)) * (j1 ggK1Dz_tau * j2 ggK1Dz_tau) := by
    have h := Subgroup.mem_center_iff.mp hz
      (⟨j1 ggK1Dz_tau * j2 ggK1Dz_tau, hu⟩ : StatedOmega (StatedQuadPlus 2 (ZMod 2)))
    simpa using congrArg Subtype.val h
  have hac : a * ggK1Dz_c = ggK1Dz_c * a := by
    have h2 : jProd (F := ZMod 2) (a * ggK1Dz_c, b) =
        jProd (F := ZMod 2) (ggK1Dz_c * a, b) := by
      rw [jProd_apply, jProd_apply, map_mul, map_mul]
      rw [hzab] at hcomm_c1
      have hswap : j1 ggK1Dz_c * j2 b = j2 b * j1 ggK1Dz_c :=
        (j1_j2_commute ggK1Dz_c b).eq
      calc j1 a * j1 ggK1Dz_c * j2 b = j1 a * (j1 ggK1Dz_c * j2 b) := by group
        _ = j1 a * (j2 b * j1 ggK1Dz_c) := by rw [hswap]
        _ = j1 a * j2 b * j1 ggK1Dz_c := by group
        _ = j1 ggK1Dz_c * (j1 a * j2 b) := hcomm_c1.symm
        _ = j1 ggK1Dz_c * j1 a * j2 b := by group
    exact congrArg Prod.fst (jProd_injective (F := ZMod 2) h2)
  have hbc : b * ggK1Dz_c = ggK1Dz_c * b := by
    apply j2_injective (F := ZMod 2)
    rw [hzab] at hcomm_c2
    have h2 : j1 a * j2 (ggK1Dz_c * b) = j1 a * j2 (b * ggK1Dz_c) := by
      rw [map_mul, map_mul]
      calc j1 a * (j2 ggK1Dz_c * j2 b)
          = (j1 a * j2 ggK1Dz_c) * j2 b := by group
        _ = (j2 ggK1Dz_c * j1 a) * j2 b := by rw [(j1_j2_commute a ggK1Dz_c).eq]
        _ = j2 ggK1Dz_c * (j1 a * j2 b) := by group
        _ = (j1 a * j2 b) * j2 ggK1Dz_c := hcomm_c2
        _ = j1 a * (j2 b * j2 ggK1Dz_c) := by group
    exact (mul_left_cancel h2).symm
  have hprod : jProd (F := ZMod 2) (ggK1Dz_tau * a, ggK1Dz_tau * b) =
      jProd (F := ZMod 2) (a * ggK1Dz_tau, b * ggK1Dz_tau) := by
    rw [jProd_apply, jProd_apply, map_mul, map_mul, map_mul, map_mul]
    rw [hzab] at hcomm_t
    have h1 : j2 ggK1Dz_tau * j1 a = j1 a * j2 ggK1Dz_tau :=
      (j1_j2_commute a ggK1Dz_tau).eq.symm
    have h3 : j2 b * j1 ggK1Dz_tau = j1 ggK1Dz_tau * j2 b :=
      (j1_j2_commute ggK1Dz_tau b).eq.symm
    calc j1 ggK1Dz_tau * j1 a * (j2 ggK1Dz_tau * j2 b)
        = j1 ggK1Dz_tau * (j1 a * j2 ggK1Dz_tau) * j2 b := by group
      _ = j1 ggK1Dz_tau * (j2 ggK1Dz_tau * j1 a) * j2 b := by rw [← h1]
      _ = (j1 ggK1Dz_tau * j2 ggK1Dz_tau) * (j1 a * j2 b) := by group
      _ = (j1 a * j2 b) * (j1 ggK1Dz_tau * j2 ggK1Dz_tau) := hcomm_t
      _ = j1 a * (j2 b * j1 ggK1Dz_tau) * j2 ggK1Dz_tau := by group
      _ = j1 a * (j1 ggK1Dz_tau * j2 b) * j2 ggK1Dz_tau := by rw [h3]
      _ = j1 a * j1 ggK1Dz_tau * (j2 b * j2 ggK1Dz_tau) := by group
  have hat : a * ggK1Dz_tau = ggK1Dz_tau * a := by
    have := congrArg Prod.fst (jProd_injective (F := ZMod 2) hprod)
    exact this.symm
  have hbt : b * ggK1Dz_tau = ggK1Dz_tau * b := by
    have := congrArg Prod.snd (jProd_injective (F := ZMod 2) hprod)
    exact this.symm
  apply Subtype.ext
  rw [hzab, ggK1Dz_c_tau_centralizer a hac hat, ggK1Dz_c_tau_centralizer b hbc hbt]
  simp

private theorem ggK1Dz_omegaPlus_two {K : Type} [Field K] [Finite K] [CharP K 2]
    (hq : Nat.card K = 2) :
    Subgroup.center (LargeEvenOmega (LargeEvenQPlus K 2)) = ⊥ := by
  let σ : K ≃+* ZMod 2 := CFSG.Quasithin.FFC.ringEquivZModTwo K hq
  have hQ' : ∀ v : Fin 2 ⊕ Fin 2 → K,
      StatedQuadPlus 2 (ZMod 2) (fun i => σ (v i)) = σ (StatedQuadPlus 2 K v) := by
    intro v; simp [StatedQuadPlus, map_add, map_mul]
  let eσ : ↥(StatedOmega (StatedQuadPlus 2 K)) ≃*
      ↥(StatedOmega (StatedQuadPlus 2 (ZMod 2))) :=
    CFSG.HardMathSupport.Foote.E27.Q2.statedOmegaEquiv σ (StatedQuadPlus 2 K)
      (StatedQuadPlus 2 (ZMod 2)) hQ'
  have h := Subgroup.map_center_eq eσ
  rw [ggK1Dz_omegaPlus_two_zmod2] at h
  exact (Subgroup.map_eq_bot_iff_of_injective _ eσ.injective).mp h

theorem ggK1D_centreless_plus {p nf r : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    (hnf : 1 ≤ nf) (hK : Nat.card K = 2 ^ nf) (h2 : 2 ≤ r) :
    Subgroup.center (LargeEvenProj (LargeEvenOmega (LargeEvenQPlus K r))) = ⊥ := by
  haveI : CharP K 2 := ggK1Dz_charP_two hnf hK
  have hscal : (LargeEvenScalars (Fin r ⊕ Fin r) K).subgroupOf
      (LargeEvenOmega (LargeEvenQPlus K r)) = ⊥ :=
    TableBOrth.scalars_subgroupOf_omegaPlus_eq_bot (K := K) (by omega)
  rcases Nat.lt_or_ge r 3 with hr | hr
  · have hr2 : r = 2 := by omega
    subst hr2
    by_cases hq : Nat.card K = 2
    · exact ggK1Dz_center_proj hscal (ggK1Dz_omegaPlus_two hq)
    · have hnf2 : 2 ≤ nf := by
        by_contra h
        have h1 : nf = 1 := by omega
        rw [h1, pow_one] at hK
        exact hq hK
      have h4 : 4 ≤ Nat.card K := by
        rw [hK]
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ nf := Nat.pow_le_pow_right (by norm_num) hnf2
      exact ggK1Dz_center_proj hscal (ggK1Dz_omegaPlus_four_center h4)
  · exact ggK1Dz_center_proj hscal (ggK1Dz_omegaPlus_center hr)

theorem ggK1D_centreless_minus {p nf r : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    (hnf : 1 ≤ nf) (hK : Nat.card K = 2 ^ nf) (h2 : 2 ≤ r) {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    Subgroup.center (LargeEvenProj (LargeEvenOmega (LargeEvenQMinus (r - 1) b c))) = ⊥ := by
  haveI : CharP K 2 := ggK1Dz_charP_two hnf hK
  open CFSG.ComponentClassification.RankTwoClassical.ORigid in
  have hsimple := isSimpleGroup_statedOmega_quadMinus_of_two_le
      (K := K) (b := b) (c := c) h2 hirr
  have hperf :=
    CFSG.ComponentClassification.RankTwoClassical.ORigid.commutator_statedOmega_quadMinus_eq_top
      (K := K) (b := b) (c := c) h2 hirr
  have hna : ¬ ∀ x y : StatedOmega (StatedQuadMinus r K b c), x * y = y * x := by
    intro hc
    have hbot : commutator (StatedOmega (StatedQuadMinus r K b c)) = ⊥ := by
      rw [commutator_def, Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro x _
      rw [Subgroup.mem_centralizer_iff]
      intro y _
      exact hc y x
    rw [hperf] at hbot
    exact top_ne_bot hbot
  have hZ : Subgroup.center (StatedOmega (StatedQuadMinus r K b c)) = ⊥ := by
    push Not at hna
    obtain ⟨x, y, hxy⟩ := hna
    exact TableBOrth.center_eq_bot_of_simple hxy
  have hr1 : r - 1 + 1 = r := Nat.sub_add_cancel (by omega)
  let e := rMinusEquivStatedOmega K (r - 1) b c
  have hZ' : Subgroup.center (StatedOmega (StatedQuadMinus (r - 1 + 1) K b c)) = ⊥ := by
    rw [hr1]; exact hZ
  have h := Subgroup.map_center_eq e
  rw [hZ'] at h
  exact (Subgroup.map_eq_bot_iff_of_injective _ e.injective).mp h

