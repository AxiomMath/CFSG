variable {m : ℕ} {F : Type} [Field F]

theorem apply_mem_center_iff {X Y : Type*} [Group X] [Group Y] (e : X ≃* Y) {x : X} :
    e x ∈ Subgroup.center Y ↔ x ∈ Subgroup.center X := by
  simp only [Subgroup.mem_center_iff]
  constructor
  · intro h y
    apply e.injective
    rw [map_mul, map_mul, h (e y)]
  · intro h y
    obtain ⟨z, rfl⟩ := e.surjective y
    rw [← map_mul, ← map_mul, h z]

@[expose] noncomputable def slMapEquiv {K : Type} [Field K] (σ : F ≃+* K) (d : ℕ) :
    Matrix.SpecialLinearGroup (Fin d) F ≃* Matrix.SpecialLinearGroup (Fin d) K where
  toFun := Matrix.SpecialLinearGroup.map σ.toRingHom
  invFun := Matrix.SpecialLinearGroup.map σ.symm.toRingHom
  left_inv u := by
    ext a b
    simp
  right_inv u := by
    ext a b
    simp
  map_mul' u v := map_mul _ u v

theorem coe_slMapEquiv {K : Type} [Field K] (σ : F ≃+* K) {d : ℕ}
    (u : Matrix.SpecialLinearGroup (Fin d) F) :
    ((slMapEquiv σ d u : Matrix.SpecialLinearGroup (Fin d) K) : Matrix (Fin d) (Fin d) K) =
      (u : Matrix (Fin d) (Fin d) F).map σ :=
  rfl

theorem ker_projMk_slEquiv (K : Type) [Field K] :
    ((LargeEvenProjMk (LargeEvenSLGroup (Fin (m + 1)) K)).comp (slEquiv m K).toMonoidHom).ker =
      Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) K) := by
  ext u
  rw [MonoidHom.mem_ker]
  show (QuotientGroup.mk (slEquiv m K u) : LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K)) = 1 ↔ _
  rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf, largeEvenScalars_def, MonoidHom.mem_range]
  constructor
  · rintro ⟨c, hc⟩
    have hmat : (u : Matrix (Fin (m + 1)) (Fin (m + 1)) K) =
        Matrix.scalar (Fin (m + 1)) (c : K) := by
      rw [← coe_slEquiv, ← hc, Matrix.GeneralLinearGroup.coe_scalar]
    rw [Subgroup.mem_center_iff]
    intro v
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, hmat]
    exact (Matrix.scalar_commute (c : K) (fun r => Commute.all _ r) _).eq.symm
  · intro hu
    obtain ⟨r, hr, hru⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hu
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [zero_pow (by simp)] at hr
      exact zero_ne_one hr
    exact ⟨Units.mk0 r hr0, Units.ext (by
      rw [Matrix.GeneralLinearGroup.coe_scalar, coe_slEquiv]
      exact hru)⟩

theorem conjSL_mul (A B : GL (Fin (m + 1)) F) (u : Matrix.SpecialLinearGroup (Fin (m + 1)) F) :
    conjSL (A * B) u = conjSL A (conjSL B u) := by
  apply Subtype.ext
  rw [coe_conjSL, coe_conjSL, coe_conjSL, mul_inv_rev, Units.val_mul, Units.val_mul]
  simp only [Matrix.mul_assoc]

theorem conjSL_of_mem {S : GL (Fin (m + 1)) F} (hS : S ∈ LargeEvenSLGroup (Fin (m + 1)) F)
    (u : Matrix.SpecialLinearGroup (Fin (m + 1)) F) :
    conjSL S u = (slEquiv m F).symm ⟨S, hS⟩ * u * ((slEquiv m F).symm ⟨S, hS⟩)⁻¹ := by
  apply (slEquiv m F).injective
  rw [slEquiv_conjSL, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply]
  apply Subtype.ext
  simp [MulAut.conjNormal_apply]

theorem det_diagGL (d : Fin (m + 1) → Fˣ) :
    Matrix.GeneralLinearGroup.det (diagGL d) = ∏ k, d k := by
  apply Units.ext
  rw [Matrix.GeneralLinearGroup.val_det_apply, coe_diagGL, Matrix.det_diagonal, Units.coe_prod]

theorem diagGL_mem {d : Fin (m + 1) → Fˣ} (hd : ∏ k, d k = 1) :
    diagGL d ∈ LargeEvenSLGroup (Fin (m + 1)) F := by
  rw [LargeEvenSLGroup, MonoidHom.mem_ker, det_diagGL, hd]

theorem diagGL_inv (d : Fin (m + 1) → Fˣ) : (diagGL d)⁻¹ = diagGL d⁻¹ := by
  apply Units.ext
  rw [coe_diagGL_inv, coe_diagGL]
  rfl

@[expose] noncomputable def diagSL {d : Fin (m + 1) → Fˣ} (hd : ∏ k, d k = 1) :
    Matrix.SpecialLinearGroup (Fin (m + 1)) F :=
  (slEquiv m F).symm ⟨diagGL d, diagGL_mem hd⟩

theorem diagSL_conj_transvection {d : Fin (m + 1) → Fˣ} (hd : ∏ k, d k = 1) {i j : Fin (m + 1)}
    (hij : i ≠ j) (t : F) :
    diagSL hd * Matrix.SpecialLinearGroup.transvection hij t * (diagSL hd)⁻¹ =
      Matrix.SpecialLinearGroup.transvection hij ((d i : F) * t * ((d j)⁻¹ : Fˣ)) := by
  rw [diagSL, ← conjSL_of_mem, conjSL_diagGL_transvection]

theorem diagSL_inv {d : Fin (m + 1) → Fˣ} (hd : ∏ k, d k = 1) :
    (diagSL hd)⁻¹ = diagSL (d := d⁻¹) (by simp only [Pi.inv_apply, Finset.prod_inv_distrib, hd,
      inv_one]) := by
  rw [diagSL, diagSL, ← map_inv]
  congr 1

section Std

variable {K : Type} [Field K] (σ : F ≃+* K) {G : Type*} [Group G]
  (ψ : Matrix.SpecialLinearGroup (Fin (m + 1)) F →* G)

@[expose] noncomputable def stdProj :
    Matrix.SpecialLinearGroup (Fin (m + 1)) F →* LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K) :=
  ((LargeEvenProjMk (LargeEvenSLGroup (Fin (m + 1)) K)).comp (slEquiv m K).toMonoidHom).comp
    (slMapEquiv σ (m + 1)).toMonoidHom

theorem stdProj_apply (u : Matrix.SpecialLinearGroup (Fin (m + 1)) F) :
    stdProj σ u = (slEquiv m K (slMapEquiv σ (m + 1) u) :
      LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K)) :=
  rfl

theorem stdProj_surjective : Function.Surjective (stdProj (m := m) σ) :=
  (QuotientGroup.mk'_surjective _).comp ((slEquiv m K).surjective.comp
    (slMapEquiv σ (m + 1)).surjective)

theorem ker_stdProj :
    (stdProj (m := m) σ).ker = Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) F) := by
  ext u
  rw [stdProj, ← MonoidHom.comap_ker, ker_projMk_slEquiv, Subgroup.mem_comap]
  exact apply_mem_center_iff (slMapEquiv σ (m + 1))

@[expose] noncomputable def rangeProj :
    Matrix.SpecialLinearGroup (Fin (m + 1)) F →* ↥ψ.range ⧸ Subgroup.center ↥ψ.range :=
  (QuotientGroup.mk' _).comp ψ.rangeRestrict

theorem rangeProj_surjective : Function.Surjective (rangeProj ψ) :=
  (QuotientGroup.mk'_surjective _).comp ψ.rangeRestrict_surjective

theorem ker_rangeProj (hm : 2 ≤ m) (hker : ψ.ker ≤ Subgroup.center _) :
    (rangeProj ψ).ker = Subgroup.center (Matrix.SpecialLinearGroup (Fin (m + 1)) F) := by
  have hperf : commutator (Matrix.SpecialLinearGroup (Fin (m + 1)) F) = ⊤ :=
    CFSG.ClassicalModels.specialLinear_commutator_eq_top_of_three_le (by omega)
  ext u
  rw [MonoidHom.mem_ker]
  show (QuotientGroup.mk (ψ.rangeRestrict u) : ↥ψ.range ⧸ Subgroup.center ↥ψ.range) = 1 ↔ _
  rw [QuotientGroup.eq_one_iff]
  refine ⟨mem_center_of_rangeRestrict_mem_center hperf ψ hker, fun hu => ?_⟩
  rw [Subgroup.mem_center_iff]
  intro l
  obtain ⟨s, rfl⟩ := ψ.rangeRestrict_surjective l
  rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hu s]

@[expose] noncomputable def stdEquiv (hm : 2 ≤ m) (hker : ψ.ker ≤ Subgroup.center _) :
    ↥ψ.range ⧸ Subgroup.center ↥ψ.range ≃* LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K) :=
  (QuotientGroup.quotientKerEquivOfSurjective (rangeProj ψ) (rangeProj_surjective ψ)).symm.trans
    ((QuotientGroup.quotientMulEquivOfEq
      ((ker_rangeProj ψ hm hker).trans (ker_stdProj σ).symm)).trans
      (QuotientGroup.quotientKerEquivOfSurjective (stdProj σ) (stdProj_surjective σ)))

theorem stdEquiv_rangeProj (hm : 2 ≤ m) (hker : ψ.ker ≤ Subgroup.center _)
    (u : Matrix.SpecialLinearGroup (Fin (m + 1)) F) :
    stdEquiv σ ψ hm hker (rangeProj ψ u) = stdProj σ u := by
  have h1 : (QuotientGroup.quotientKerEquivOfSurjective (rangeProj ψ)
      (rangeProj_surjective ψ)).symm (rangeProj ψ u) =
      (u : Matrix.SpecialLinearGroup (Fin (m + 1)) F ⧸ (rangeProj ψ).ker) :=
    (MulEquiv.symm_apply_eq _).mpr rfl
  simp only [stdEquiv, MulEquiv.trans_apply, h1, QuotientGroup.quotientMulEquivOfEq_mk]
  rfl

theorem linConjAut_stdProj (A : GL (Fin (m + 1)) K)
    (u : Matrix.SpecialLinearGroup (Fin (m + 1)) F) :
    TableB.linConjAut (Fin (m + 1)) K A (stdProj σ u) =
      stdProj σ (conjSL (Matrix.GeneralLinearGroup.map σ.symm.toRingHom A) u) := by
  rw [stdProj_apply, stdProj_apply, TableB.linConjAut_mk]
  congr 1
  apply Subtype.ext
  apply Units.ext
  rw [MulAut.conjNormal_apply]
  simp only [Units.val_mul]
  change (A : Matrix (Fin (m + 1)) (Fin (m + 1)) K) * (u : Matrix _ _ F).map σ *
      ((A⁻¹ : GL (Fin (m + 1)) K) : Matrix (Fin (m + 1)) (Fin (m + 1)) K) =
    ((conjSL (Matrix.GeneralLinearGroup.map σ.symm.toRingHom A) u :
      Matrix.SpecialLinearGroup (Fin (m + 1)) F) : Matrix (Fin (m + 1)) (Fin (m + 1)) F).map σ
  have e1 : ((Matrix.GeneralLinearGroup.map σ.symm.toRingHom A : GL (Fin (m + 1)) F) :
      Matrix (Fin (m + 1)) (Fin (m + 1)) F) =
      (A : Matrix (Fin (m + 1)) (Fin (m + 1)) K).map σ.symm :=
    rfl
  have e2 : (((Matrix.GeneralLinearGroup.map σ.symm.toRingHom A)⁻¹ : GL (Fin (m + 1)) F) :
      Matrix (Fin (m + 1)) (Fin (m + 1)) F) =
      ((A⁻¹ : GL (Fin (m + 1)) K) : Matrix (Fin (m + 1)) (Fin (m + 1)) K).map σ.symm := by
    rw [← Matrix.GeneralLinearGroup.map_inv]
    rfl
  have hσ : (⇑σ ∘ ⇑σ.symm) = id := funext σ.apply_symm_apply
  rw [coe_conjSL, Matrix.map_mul, Matrix.map_mul, e1, e2, Matrix.map_map, Matrix.map_map, hσ,
    Matrix.map_id, Matrix.map_id]

