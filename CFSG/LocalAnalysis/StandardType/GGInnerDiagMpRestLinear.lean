theorem typeA_param_eq {l n' : ℕ} (hlab : LargeEvenInLambda2 ⟨.A, l, n'⟩) {X : Type} [Group X]
    (hX : MarkedModel ⟨.A, l, n'⟩ X) {t : StatedLieTag} {n f : ℕ}
    (hadm : StatedLieAdmissible t n 2 f) (hM : LieModel X t n 2 f) :
    t = .PSL ∧ n = l + 1 ∧ f = n' := by
  have hX' : LieModel X .PSL (l + 1) 2 n' := hX
  have hl1 : 1 ≤ l := hlab.2.1
  rcases Nat.lt_or_ge (l + 1) 3 with h | h
  · obtain rfl : l = 1 := by omega
    exact CFSG.SeitzReduction.RankOne.sl2EvenTypeDet X n' t n f hX' hadm hM
  · exact CFSG.SeitzReduction.LinearPilot.slmEvenTypeDetAt h X n' t n f hX' hadm hM

theorem ggInnerDiagStdOn_typeA : GGInnerDiagStdOn fun lab => lab.tag = .A := by
  intro G _ _ t n f ψ hadm hrk hker lab hlab hA Q hQ
  obtain ⟨tg, l, n'⟩ := lab
  dsimp only at hA
  subst hA
  obtain ⟨K, _, _, hK, hQK⟩ := hQ
  refine ⟨K, inferInstance, inferInstance, hK, hQK, fun _ _ hM ⟨e⟩ => ?_⟩
  obtain ⟨rfl, rfl, hfn⟩ := typeA_param_eq hlab (MarkedModel.of_mulEquiv e.symm hM) hadm
    (lieModel_range_centerQuot hadm hrk ψ hker)
  subst hfn
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hf : 1 ≤ f := hlab.1
  have hF : Nat.card (GaloisField 2 f) = 2 ^ f := GaloisField.card 2 f (by omega)
  have := Fintype.ofFinite K
  have := Fintype.ofFinite (GaloisField 2 f)
  have hcard : Fintype.card (GaloisField 2 f) = Fintype.card K := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hF, hK]
  exact ⟨stdEquiv (FiniteField.ringEquivOfCardEq hcard) ψ hrk hker,
    ggRevProp_stdEquiv _ ψ hrk hker⟩


theorem ggInnerDiagMpInputOn_typeA : GGInnerDiagMpInputOn fun lab => lab.tag = .A :=
  ggInnerDiagMpInputOn_of_std
    (fun _ hlab h => largeEvenLabelAll_inndiag_proved hlab (Or.inr (Or.inl h)))
    ggInnerDiagStdOn_typeA

theorem ggInnerDiagMpInputOn_linear : GGInnerDiagMpInputOn GGMpLinearLabel :=
  ggInnerDiagMpInputOn_mono (fun _ _ h => h.1) ggInnerDiagMpInputOn_typeA

