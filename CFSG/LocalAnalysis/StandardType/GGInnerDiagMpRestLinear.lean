variable {K : Type} [Field K]

theorem ggInndiag_subset_range :
    (ggInndiag (LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K))
      (LargeEvenMatConjImage (LargeEvenProjMk (LargeEvenSLGroup (Fin (m + 1)) K)) Set.univ) :
        Set (MulAut (LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K)))) ⊆
      Set.range (TableB.linConjAut (Fin (m + 1)) K) := by
  have h : ggInndiag (LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K))
      (LargeEvenMatConjImage (LargeEvenProjMk (LargeEvenSLGroup (Fin (m + 1)) K)) Set.univ) ≤
      (TableB.linConjAut (Fin (m + 1)) K).range := by
    refine sup_le ?_ ((Subgroup.closure_le _).mpr ?_)
    · rintro _ ⟨r, rfl⟩
      obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective r
      exact ⟨h, TableB.linConjAut_of_mem _ h.2⟩
    · intro φ hφ
      obtain ⟨A, rfl⟩ := TableB.exists_eq_linConjAut hφ
      exact ⟨A, rfl⟩
  exact fun φ hφ => h hφ

theorem exists_ne_ne (hm : 2 ≤ m) (i j : Fin (m + 1)) : ∃ k : Fin (m + 1), k ≠ i ∧ k ≠ j := by
  by_contra h
  push Not at h
  have h0 := h ⟨0, by omega⟩
  have h1 := h ⟨1, by omega⟩
  have h2 := h ⟨2, by omega⟩
  simp only [ne_eq, Fin.ext_iff] at h0 h1 h2
  omega

theorem diagSL_mem_normalizer {d : Fin (m + 1) → Fˣ} (hd : ∏ k, d k = 1) {γ : Fin m → ℤ}
    (hγ : γ ∈ (SpecialLinear.rootDatum m F).roots) :
    diagSL hd ∈ Subgroup.normalizer ((SpecialLinear.rootDatum m F).rootGroup γ :
      Set (Matrix.SpecialLinearGroup (Fin (m + 1)) F)) := by
  have hγ' : γ ∈ roots (SpecialLinear.isFiniteType_A m) ∅ := hγ
  rw [SpecialLinear.roots_eq] at hγ'
  obtain ⟨i, j, hij, hstd⟩ := hγ'
  have hX : (SpecialLinear.rootDatum m F).rootGroup γ = SpecialLinear.rootSubgroup m F hij :=
    SpecialLinear.rootGroup_eq m F hij hstd
  rw [hX]
  have key : ∀ {e : Fin (m + 1) → Fˣ} (he : ∏ k, e k = 1) (x : Matrix.SpecialLinearGroup _ F),
      x ∈ SpecialLinear.rootSubgroup m F hij →
        diagSL he * x * (diagSL he)⁻¹ ∈ SpecialLinear.rootSubgroup m F hij := by
    intro e he x hx
    obtain ⟨t, rfl⟩ := (SpecialLinear.mem_rootSubgroup hij x).mp hx
    rw [diagSL_conj_transvection]
    exact (SpecialLinear.mem_rootSubgroup hij _).mpr ⟨_, rfl⟩
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨key hd x, fun hx => ?_⟩
  have h2 := key (e := d⁻¹) (by simp only [Pi.inv_apply, Finset.prod_inv_distrib, hd, inv_one]) _
    hx
  rw [← diagSL_inv hd] at h2
  simpa [mul_assoc] using h2

variable (σ : F ≃+* K) {G : Type*} [Group G] (ψ : Matrix.SpecialLinearGroup (Fin (m + 1)) F →* G)

theorem ggRevProp_stdEquiv (hm : 2 ≤ m) (hker : ψ.ker ≤ Subgroup.center _) :
    GGRevProp (SpecialLinear.rootDatum m F) ψ ψ.range
      (ggInndiag (LargeEvenProj (LargeEvenSLGroup (Fin (m + 1)) K))
        (LargeEvenMatConjImage (LargeEvenProjMk (LargeEvenSLGroup (Fin (m + 1)) K)) Set.univ))
      (stdEquiv σ ψ hm hker) := by
  rintro c hc ⟨φ, hφ, hind⟩
  obtain ⟨A, rfl⟩ := ggInndiag_subset_range hφ
  have hperf : commutator (Matrix.SpecialLinearGroup (Fin (m + 1)) F) = ⊤ :=
    CFSG.ClassicalModels.specialLinear_commutator_eq_top_of_three_le (by omega)
  have hmem : ∀ u, c⁻¹ * ψ u * c ∈ ψ.range := fun u => by
    have := (Subgroup.mem_normalizer_iff.mp (Subgroup.inv_mem _ hc) (ψ u)).mp ⟨u, rfl⟩
    rwa [inv_inv] at this
  let α : Matrix.SpecialLinearGroup (Fin (m + 1)) F →* ↥ψ.range :=
    { toFun := fun u => ⟨c⁻¹ * ψ u * c, hmem u⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun a b => Subtype.ext (by simp [mul_assoc]) }
  have hα : ∀ u, ((α u : ↥ψ.range) : G) = c⁻¹ * ψ u * c := fun _ => rfl
  have hαβ : α = ψ.rangeRestrict.comp
      (conjSL (Matrix.GeneralLinearGroup.map σ.symm.toRingHom A)) := by
    refine TypeA.eq_of_inv_mul_mem_center hperf _ _ fun u => ?_
    have h1 := hind (ψ.rangeRestrict u) (α u) (hα u)
    have h2 : stdEquiv σ ψ hm hker (QuotientGroup.mk (ψ.rangeRestrict
        (conjSL (Matrix.GeneralLinearGroup.map σ.symm.toRingHom A) u))) =
        stdEquiv σ ψ hm hker (QuotientGroup.mk (α u)) := by
      rw [← h1]
      change stdEquiv σ ψ hm hker (rangeProj ψ
          (conjSL (Matrix.GeneralLinearGroup.map σ.symm.toRingHom A) u)) =
        TableB.linConjAut (Fin (m + 1)) K A (stdEquiv σ ψ hm hker (rangeProj ψ u))
      rw [stdEquiv_rangeProj, stdEquiv_rangeProj, linConjAut_stdProj]
    exact QuotientGroup.eq.mp ((stdEquiv σ ψ hm hker).injective h2).symm
  have hconj : ∀ u, c⁻¹ * ψ u * c =
      ψ (conjSL (Matrix.GeneralLinearGroup.map σ.symm.toRingHom A) u) := fun u => by
    rw [← hα, hαβ]
    rfl
  obtain ⟨A', hA'⟩ : ∃ A', A' = Matrix.GeneralLinearGroup.map σ.symm.toRingHom A := ⟨_, rfl⟩
  rw [← hA'] at hconj
  let d : Fin (m + 1) → Fˣ := fun a => if a = 0 then Matrix.GeneralLinearGroup.det A' else 1
  have hdprod : ∏ a, d a = Matrix.GeneralLinearGroup.det A' := by
    rw [Finset.prod_eq_single 0 (fun b _ hb => ite_eq_right hb) (by simp)]
    exact ite_eq_left rfl
  have hs : A' * (diagGL d)⁻¹ ∈ LargeEvenSLGroup (Fin (m + 1)) F := by
    rw [LargeEvenSLGroup, MonoidHom.mem_ker, map_mul, map_inv, det_diagGL, hdprod,
      mul_inv_cancel]
  have hsD : ∀ u, conjSL A' u = (slEquiv m F).symm ⟨_, hs⟩ * conjSL (diagGL d) u *
      ((slEquiv m F).symm ⟨_, hs⟩)⁻¹ := fun u => by
    calc conjSL A' u = conjSL ((A' * (diagGL d)⁻¹) * diagGL d) u := by
          rw [inv_mul_cancel_right]
      _ = _ := by rw [conjSL_mul, conjSL_of_mem hs]
  refine ⟨ψ ((slEquiv m F).symm ⟨_, hs⟩), ⟨_, rfl⟩, fun γ hγ => ?_⟩
  have hγ' : γ ∈ roots (SpecialLinear.isFiniteType_A m) ∅ := hγ
  rw [SpecialLinear.roots_eq] at hγ'
  obtain ⟨i, j, hij, hstd⟩ := hγ'
  obtain ⟨k, hki, hkj⟩ := exists_ne_ne hm i j
  let d' : Fin (m + 1) → Fˣ := fun a => d a * (if a = k then (∏ b, d b)⁻¹ else 1)
  have hd' : ∏ a, d' a = 1 := by
    rw [Finset.prod_mul_distrib, Finset.prod_eq_single k (fun b _ hb => ite_eq_right hb) (by simp),
      ite_eq_left rfl, mul_inv_cancel]
  have hdi : d' i = d i := by simp [d', hki.symm]
  have hdj : d' j = d j := by simp [d', hkj.symm]
  refine ⟨diagSL hd', ?_, fun z hz => ?_⟩
  · simp only [ggTorus, Subgroup.mem_iInf]
    intro γ' hγ''
    exact diagSL_mem_normalizer hd' hγ''
  · have hz' : z ∈ SpecialLinear.rootSubgroup m F hij := by
      have hX : (SpecialLinear.rootDatum m F).rootGroup γ = SpecialLinear.rootSubgroup m F hij :=
        SpecialLinear.rootGroup_eq m F hij hstd
      rwa [hX] at hz
    obtain ⟨t, rfl⟩ := (SpecialLinear.mem_rootSubgroup hij z).mp hz'
    rw [diagSL_conj_transvection, hdi, hdj, ← conjSL_diagGL_transvection]
    set w := (slEquiv m F).symm ⟨_, hs⟩
    calc (c * ψ w)⁻¹ * ψ (Matrix.SpecialLinearGroup.transvection hij t) * (c * ψ w)
        = (ψ w)⁻¹ * (c⁻¹ * ψ (Matrix.SpecialLinearGroup.transvection hij t) * c) * ψ w := by
          group
      _ = (ψ w)⁻¹ * ψ (w * conjSL (diagGL d) (Matrix.SpecialLinearGroup.transvection hij t) *
            w⁻¹) * ψ w := by rw [hconj, hsD]
      _ = ψ (conjSL (diagGL d) (Matrix.SpecialLinearGroup.transvection hij t)) := by
          rw [map_mul, map_mul, map_inv]
          group

end Rev

end MpLinear

