@[expose] def LangSmallSolv {τ : Tag} {L : Type} [Field L] (q : ℕ)
    (ρ : Equiv.Perm (Fin τ.rank → ℤ)) (χ : Multiplicative (Fin τ.rank → ℤ) →* Lˣ)
    (i : KernelComponent χ) : Prop :=
  (q ^ componentOrbitLength ρ (componentRoots χ i) ≤ 3 ∧ (componentRoots χ i).ncard = 2) ∨
    (q ^ componentOrbitLength ρ (componentRoots χ i) = 2 ∧ twistKind ρ χ i = .suN ∧
      (componentRoots χ i).ncard = 6)

theorem isQuasisimple_rationalComponent_of_not_langSmallSolv
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ} (S : LangSetup τ L p₀)
    (hτ : τ ≠ .G2) (hp : p.Prime) (hpL : (p : L) ≠ 0) {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (hnot : ¬ LangSmallSolv S.D.q S.ρ (rootCharHom a) i) :
    CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
  langQuasisimpleOfNotSmallSolv τ L p₀ p S hτ hp hpL a hT hap h1 i hnot

end Bridge

