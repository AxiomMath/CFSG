    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 6) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 6) t → t ∈ Mg :=
  linTest_dframe_of_certOK (by norm_num) _ d6fGens rfl d6f_S d6f_refl d6f_frame d6f_certOK d6f_cov

