private theorem perm_fin_three_eq_of_fix : ∀ g : Equiv.Perm (Fin 3), (∀ x, (g ^ 3) x = x) →
    ∀ x, g x = x → ∀ y, g y = y := by
  decide +kernel

section Classes


private theorem rho_iterate_three_eq {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {u : WeylGroup Tag.E6}
    (hu : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = -(u • γ)) {γ : Fin Tag.E6.rank → ℤ}
    (hγ : IsRoot Tag.E6 γ) : (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[3] γ = -(u ^ 3 • γ) := by
  have h1 : IsRoot Tag.E6 (-(u • γ)) := IsRoot.neg (IsRoot.smul hγ u)
  have h2 : IsRoot Tag.E6 (u • u • γ) := IsRoot.smul (IsRoot.smul hγ u) u
  change S.ρ (S.ρ (S.ρ γ)) = _
  rw [hu γ hγ, hu _ h1, smul_neg, neg_neg, hu _ h2, pow_three, mul_smul, mul_smul]

private theorem rho_iterate_three_mem {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {u : WeylGroup Tag.E6}
    (hu : ∀ γ, IsRoot Tag.E6 γ → S.ρ γ = -(u • γ)) {a : Fin Tag.E6.rank → Lˣ}
    (hu3 : u ^ 3 ∈ kernelReflectionGroup a) {i : KernelComponent (rootCharHom a)}
    {δ : Fin Tag.E6.rank → ℤ} (hδ : δ ∈ componentRoots (rootCharHom a) i) :
    (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[3] δ ∈ componentRoots (rootCharHom a) i := by
  rw [rho_iterate_three_eq S hu hδ.1.1]
  have h1 : u ^ 3 • δ ∈ componentRoots (rootCharHom a) i :=
    smul_mem_componentRoots_of_mem_kernelWeylGroup hδ hu3
  have h2 := smul_mem_componentRoots_of_mem_kernelWeylGroup h1
    (rootReflection_mem_kernelWeylGroup h1.1)
  rwa [CFSG.LieType.Chevalley.rootReflection_smul_self h1.1.1] at h2

end Classes


private theorem pow_three_mem_kernelReflectionGroup {L : Type} [Field L] [IsAlgClosed L]
    (h3 : ((3 : ℕ) : L) ≠ 0) {a : Fin Tag.E6.rank → Lˣ} (hap : ∀ j, a j ^ 3 = 1)
    (h18 : (kernelRoots (rootCharHom a)).ncard = 18) {u : WeylGroup Tag.E6}
    (hu : u ∈ rootCharStabilizerSubgroup a) : u ^ 3 ∈ kernelReflectionGroup a := by
  have hx : (QuotientGroup.mk (⟨u, hu⟩ : ↥(rootCharStabilizerSubgroup a)) :
      ↥(rootCharStabilizerSubgroup a) ⧸
        (kernelReflectionGroup a).subgroupOf (rootCharStabilizerSubgroup a)) ^ 3 = 1 :=
    orderOf_dvd_iff_pow_eq_one.1
      ((orderOf_dvd_natCard _).trans (a2cube_card_weylQuotient_dvd_three h3 hap h18))
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hx
  exact hx

private theorem orbit_one_or_three_of_twisted {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr) (h3 : ((3 : ℕ) : L) ≠ 0)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ 3 = 1) (h3q : 3 ∣ S.D.q + 1)
    (h18 : (kernelRoots (rootCharHom a)).ncard = 18) :
    (∀ i : KernelComponent (rootCharHom a), (componentRoots (rootCharHom a) i).ncard = 6) ∧
    ((∀ i : KernelComponent (rootCharHom a),
        componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1) ∨
      ∀ i : KernelComponent (rootCharHom a),
        componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 3 ∧
          rationalRoots S.ρ (rootCharHom a) i = kernelRoots (rootCharHom a)) := by
  classical
  obtain ⟨c, hc, hc6⟩ := kernel_classes_of_ncard_eighteen h3 hap h18
  refine ⟨fun i => ?_, ?_⟩
  · obtain ⟨k, rfl⟩ := hc.2 i
    exact hc6 k
  rcases orbit_dichotomy S hT hc with ⟨i₀, hi₀⟩ | hall
  swap
  · exact Or.inr hall
  left
  obtain ⟨u, hu⟩ := KSConn.exists_weyl_rho_eq_neg S hFr hΦ
  have hu3 := pow_three_mem_kernelReflectionGroup h3 hap h18
    (KSConn.mem_rootCharStabilizer_of_rho_eq_neg S hT hap h3q hu)
  have himg : ∀ k : Fin 3, ∃ m : Fin 3,
      (S.ρ : (Fin Tag.E6.rank → ℤ) → _) '' componentRoots (rootCharHom a) (c k) =
        componentRoots (rootCharHom a) (c m) := by
    intro k
    obtain ⟨j, hj⟩ := outer_exists_image_component S hT (c k)
    obtain ⟨m, rfl⟩ := hc.2 j
    exact ⟨m, hj⟩
  choose t ht using himg
  have htinj : Function.Injective t := by
    intro k k' hkk
    have hk : componentRoots (rootCharHom a) (c k) = componentRoots (rootCharHom a) (c k') := by
      apply Set.image_injective.2 S.ρ.injective
      rw [ht k, ht k', hkk]
    exact hc.1 (eq_of_componentRoots_eq hk)
  let τ : Equiv.Perm (Fin 3) := Equiv.ofBijective t (Finite.injective_iff_bijective.1 htinj)
  have hiter : ∀ (n : ℕ) (k : Fin 3), (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[n] ''
      componentRoots (rootCharHom a) (c k) = componentRoots (rootCharHom a) (c ((τ ^ n) k)) := by
    intro n
    induction n with
    | zero => intro k; simp
    | succ n ih =>
      intro k
      rw [Function.iterate_succ', Set.image_comp, ih k, ht, pow_succ', Equiv.Perm.mul_apply]
      rfl
  have hτ3 : ∀ k, (τ ^ 3) k = k := by
    intro k
    obtain ⟨δ, hδ⟩ : (componentRoots (rootCharHom a) (c k)).Nonempty :=
      Set.nonempty_of_ncard_ne_zero (by rw [hc6 k]; omega)
    have hm : (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[3] δ ∈
        componentRoots (rootCharHom a) (c ((τ ^ 3) k)) := by
      rw [← hiter 3 k]
      exact ⟨δ, hδ, rfl⟩
    exact hc.1 (hm.2.symm.trans (rho_iterate_three_mem S hu hu3 hδ).2)
  obtain ⟨k₀, rfl⟩ := hc.2 i₀
  have hk₀ : τ k₀ = k₀ := by
    obtain ⟨-, hs, -⟩ := outer_componentOrbitLength_spec S hT (c k₀)
    rw [hi₀, hiter 1 k₀, pow_one] at hs
    exact hc.1 (eq_of_componentRoots_eq hs)
  intro i
  obtain ⟨k, rfl⟩ := hc.2 i
  have h1 := hiter 1 k
  rw [pow_one, perm_fin_three_eq_of_fix τ hτ3 k₀ hk₀ k] at h1
  obtain ⟨hs0, -, -⟩ := outer_componentOrbitLength_spec S hT (c k)
  exact le_antisymm (Nat.sInf_le ⟨one_pos, h1⟩) hs0

theorem twE6LineLang_orbit_one_or_three {K : Type} [Field K] [Finite K] {σ : K ≃+* K}
    {q : ℕ} {h : twistedE6InndiagGL K σ} (D : TwE6LineLang K σ q h)
    (hdim : twE6MatFixDim K σ h = 24) (hq3 : 3 ∣ q + 1) :
    (∀ i : KernelComponent (rootCharHom D.a),
      (componentRoots (rootCharHom D.a) i).ncard = 6) ∧
    ((∀ i : KernelComponent (rootCharHom D.a),
        componentOrbitLength D.S.ρ (componentRoots (rootCharHom D.a) i) = 1) ∨
      ∀ i : KernelComponent (rootCharHom D.a),
        componentOrbitLength D.S.ρ (componentRoots (rootCharHom D.a) i) = 3 ∧
          rationalRoots D.S.ρ (rootCharHom D.a) i = kernelRoots (rootCharHom D.a)) := by
  obtain ⟨t, ht, Fr, hFr, hΦ0⟩ := D.hS
  obtain rfl : t = .E6 := by
    cases t
    · rfl
    · exact absurd ht (by decide)
  have hΦ : D.S.D.Φ = twistHom TwistTag.E6 (AlgebraicClosure K) Fr :=
    MonoidHom.ext fun g => (hΦ0 g).trans rfl
  have h3q : 3 ∣ D.S.D.q + 1 := by
    rw [D.hSq, ← D.hqe]
    exact hq3
  have h18 : (kernelRoots (rootCharHom D.a)).ncard = 18 := by
    have := D.hker
    omega
  exact orbit_one_or_three_of_twisted D.S hFr hΦ D.hL3 D.hT D.hap h3q h18

