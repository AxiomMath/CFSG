theorem exists_frame_commute_of_commLifts {n : ℕ} (hn : 1 ≤ n) (h3 : 3 ∣ 2 ^ n + 1)
    {K : Type} [Field K] [Finite K] {σ : K ≃+* K} (hK : Nat.card K = (2 ^ n) ^ 2)
    (hσ : ∀ c, σ c = c ^ 2 ^ n) {h : twistedE6InndiagGL K σ} (hh1 : h ≠ 1) (hh3 : h ^ 3 = 1)
    (h36 : twE6MatFixDim K σ h = 36)
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : CFSG.Open.IsElemAbelian 3 E)
    (hfE : twistedE6InndiagConj K σ h ∈ E)
    {J : Subgroup (twistedE6RootGroup K σ)}
    (hJ : CFSG.Open.IsComponentOf J
      (CFSG.LieType.Seitz.fixedPoints (Subgroup.zpowers (twistedE6InndiagConj K σ h))))
    (hEJ : ∀ e ∈ E, J.map e.toMonoidHom = J)
    (hCL : GGUnitaryCommLifts J n 6 (E : Set (MulAut (twistedE6RootGroup K σ)))) :
    ∃ C ∈ adjointGroup Tag.E6 (AlgebraicClosure K),
      ∃ (ψ : SL(6, AlgebraicClosure K) →* ModGL Tag.E6 (AlgebraicClosure K))
        (σ' : Fin 6 → Fin 6 → Fin Tag.E6.rank → ℤ)
        (B : ModGL Tag.E6 (AlgebraicClosure K) → GL (Fin 6) (AlgebraicClosure K)),
        IsSLFrame ψ σ' ∧
        (((E.comap (twistedE6InndiagConj K σ)).map (twistedE6InndiagGL K σ).subtype).map
            (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))).map
            (MulAut.conj C).toMonoidHom ≤
          torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range ∧
        (∀ x ∈ (((E.comap (twistedE6InndiagConj K σ)).map
            (twistedE6InndiagGL K σ).subtype).map
              (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))).map
              (MulAut.conj C).toMonoidHom,
          ∀ Y : SL(6, AlgebraicClosure K), x * ψ Y * x⁻¹ = ψ (conjSLn (B x) Y)) ∧
        ∀ x ∈ (((E.comap (twistedE6InndiagConj K σ)).map
            (twistedE6InndiagGL K σ).subtype).map
              (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))).map
              (MulAut.conj C).toMonoidHom,
          ∀ y ∈ (((E.comap (twistedE6InndiagConj K σ)).map
            (twistedE6InndiagGL K σ).subtype).map
              (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))).map
              (MulAut.conj C).toMonoidHom,
            B x * B y = B y * B x := by
  classical
  haveI : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hK
  have hq2 : 2 ≤ 2 ^ n := by
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hK3 : ringChar K ≠ 3 := by
    rw [ringChar.eq K 2]
    norm_num
  obtain ⟨D⟩ := d4t2pl_nonempty_lineLangIota K σ (2 ^ n) hK3 hσ hK hq2 h hh1 hh3
  haveI : CharP (AlgebraicClosure K) 2 := by
    have hc := D.hchar
    rwa [ringChar.eq K 2] at hc
  have hSq : D.S.D.q = 2 ^ n := D.hSq.trans D.hqe.symm
  obtain ⟨i, -, hJi⟩ := D.toTwE6LineLang.exists_rationalComponent hJ
  obtain ⟨ψ, σ', π, hψ, hΨ, hkern, hπ⟩ := exists_unitary_frame_a5t1 D.toTwE6LineLang h3 h36 i
  obtain ⟨σQ, z, W, hσQ, -, hW, hR⟩ := rationalComponent_eq_conj_fix_of_unitary_frame D.S D.hT i
    hψ hΨ π hπ Nat.prime_two inferInstance hn hSq (by norm_num)
    (fun h => absurd (congrArg Prod.fst h) (by norm_num))
  have hσQ' : ∀ c, σQ c = c ^ 2 ^ n := fun c => by rw [hσQ, hSq]
  have hJR : ∀ g, g ∈ J.map D.ι ↔
      ∃ Y ∈ fixSubgroup (stdUnitaryEquiv (ν := 6) σQ), g = z * ψ Y * z⁻¹ := fun g => by
    rw [hJi]
    exact hR g
  have hker := KSGen.frame_ker_le_center (by norm_num) hψ
  have h30 : (kernelRoots (CFSG.LieType.AlgebraicGroups.rootCharHom D.a)).ncard = 30 := by
    have := D.hker
    omega
  have hTC :=
    CFSG.HardMathSupport.Timmesfeld.Steinberg.toralCentralizer_eq_toralRootGroup_of_stabilizer_le
      Tag.E6 (AlgebraicClosure K) D.a
      (KSConn.e6_stab_le_kernelReflectionGroup_of_conn D.a D.hap (by rw [h30]; simp))
  have hTR : toralRootGroup Tag.E6 (AlgebraicClosure K) D.a =
      torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range := by
    rw [hψ.range, ← hkern]
    rfl
  have hinj := twE6_conj_injective K σ (2 ^ n) hσ hK hq2
  have hcomp0 : ∀ (x : ↥(twistedE6InndiagGL K σ)) (y : ↥(twistedE6RootGroup K σ)),
      baseChangeGL (algebraMap K (AlgebraicClosure K))
          ((twistedE6InndiagConj K σ x y : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) =
        baseChangeGL (algebraMap K (AlgebraicClosure K)) (x : ModGL TwistTag.E6.tag K) *
          baseChangeGL (algebraMap K (AlgebraicClosure K)) (y : ModGL TwistTag.E6.tag K) *
          (baseChangeGL (algebraMap K (AlgebraicClosure K)) (x : ModGL TwistTag.E6.tag K))⁻¹ := by
    intro x y
    rw [twistedE6InndiagConj_apply, map_mul, map_mul, map_inv]
  obtain ⟨P, hPcj, hPlf, hPlf', hPι⟩ : ∃ P : D4T2PlumbData ↥(twistedE6RootGroup K σ)
      ↥(twistedE6InndiagGL K σ) (ModGL Tag.E6 (AlgebraicClosure K)),
      P.cj = twistedE6InndiagConj K σ ∧
      (∀ x : ↥(twistedE6InndiagGL K σ), P.lf x = D.S.D.g0⁻¹ *
        (baseChangeGL (algebraMap K (AlgebraicClosure K)) (x : ModGL TwistTag.E6.tag K) :
          ModGL Tag.E6 (AlgebraicClosure K)) * D.S.D.g0) ∧
      (∀ x : ↥(twistedE6InndiagGL K σ), P.lf x = (MulAut.conj D.S.D.g0⁻¹).toMonoidHom
        (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))
          ((twistedE6InndiagGL K σ).subtype x))) ∧ P.ι = D.ι :=
    ⟨D4T2PlumbData.ofBaseChange (twistedE6InndiagConj K σ)
      ((baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))).comp
        (twistedE6InndiagGL K σ).subtype)
      ((baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))).comp
        (twistedE6RootGroup K σ).subtype) D.ι D.S.D.g0 hinj
      ((baseChangeGL_injective _).comp (Subgroup.subtype_injective _)) D.hinj D.hι hcomp0,
      rfl, fun x => D4T2PlumbData.ofBaseChange_lf .., fun _ => rfl, rfl⟩
  have hcomp : ∀ (x₀ : ↥(twistedE6InndiagGL K σ)) (l : ↥(twistedE6RootGroup K σ)),
      D.ι (twistedE6InndiagConj K σ x₀ l) = P.lf x₀ * D.ι l * (P.lf x₀)⁻¹ := fun x₀ l => by
    rw [← hPcj, ← hPι]
    exact P.comp x₀ l
  have hlfmem : ∀ x₀ : ↥(twistedE6InndiagGL K σ), twistedE6InndiagConj K σ x₀ ∈ E →
      P.lf x₀ ∈ P.liftSub E := fun x₀ hx₀ =>
    (P.mem_liftSub).2 ⟨x₀, by rw [hPcj]; exact hx₀, rfl⟩
  have hlfh : P.lf h = rootDiagUnit Tag.E6 D.a := by
    have h2 : D.S.D.g0 * rootDiagUnit Tag.E6 D.a * D.S.D.g0⁻¹ =
        (baseChangeGL (algebraMap K (AlgebraicClosure K)) (h : ModGL TwistTag.E6.tag K) :
          ModGL Tag.E6 (AlgebraicClosure K)) := D.hg0
    rw [hPlf h, ← h2]
    group
  have hdE : rootDiagUnit Tag.E6 D.a ∈ P.liftSub E := hlfh ▸ hlfmem h hfE
  have hEab := P.isElemAbelian_liftSub hE
  have hkey : ∀ x₀ : ↥(twistedE6InndiagGL K σ), twistedE6InndiagConj K σ x₀ ∈ E →
      P.lf x₀ ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range := by
    intro x₀ hx₀
    have hc : rootDiagUnit Tag.E6 D.a * P.lf x₀ = P.lf x₀ * rootDiagUnit Tag.E6 D.a :=
      congrArg Subtype.val (hEab.1.is_comm.comm ⟨_, hdE⟩ ⟨_, hlfmem x₀ hx₀⟩)
    have hmod : P.lf x₀ ∈ D.S.D.model := by
      rw [hPlf x₀]
      exact D.hlift x₀ x₀.2
    rw [← hTR, ← hTC, mem_toralCentralizer, hc, mul_inv_cancel_right]
    exact ⟨(D.S.D.mem_model.1 hmod).1, rfl⟩
  have hact : ∀ g : ModGL Tag.E6 (AlgebraicClosure K), ∃ M : GL (Fin 6) (AlgebraicClosure K),
      g ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range →
        ∀ Y, g * ψ Y * g⁻¹ = ψ (conjSLn M Y) := by
    intro g
    by_cases hg : g ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range
    · obtain ⟨M, hM⟩ := KSGen.mem_actsOn.1
        (sup_le (KSGen.torusGroup_le_actsOn hψ (by norm_num)) (KSGen.range_le_actsOn ψ) hg)
      exact ⟨M, fun _ => hM⟩
    · exact ⟨1, fun hg' => absurd hg' hg⟩
  choose B hB using hact
  have hmem : ∀ x ∈ (((E.comap (twistedE6InndiagConj K σ)).map
      (twistedE6InndiagGL K σ).subtype).map
        (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))).map
        (MulAut.conj D.S.D.g0⁻¹).toMonoidHom,
      ∃ x₀ : ↥(twistedE6InndiagGL K σ), twistedE6InndiagConj K σ x₀ ∈ E ∧ P.lf x₀ = x := by
    rintro _ ⟨_, ⟨_, ⟨x₀, hx₀, rfl⟩, rfl⟩, rfl⟩
    exact ⟨x₀, hx₀, hPlf' x₀⟩
  refine ⟨D.S.D.g0⁻¹, inv_mem D.S.D.g0_mem, ψ, σ', B, hψ, ?_, ?_, ?_⟩
  · intro x hx
    obtain ⟨x₀, hx₀, rfl⟩ := hmem x hx
    exact hkey x₀ hx₀
  · intro x hx
    obtain ⟨x₀, hx₀, rfl⟩ := hmem x hx
    exact hB _ (hkey x₀ hx₀)
  · intro x hx y hy
    obtain ⟨x₀, hx₀, rfl⟩ := hmem x hx
    obtain ⟨y₀, hy₀, rfl⟩ := hmem y hy
    exact frame_matrices_commute_of_commLifts hn h3 hσQ' hker hW D.hinj hJR hCL
      (a₁ := twistedE6InndiagConj K σ x₀) (a₂ := twistedE6InndiagConj K σ y₀) hx₀ hy₀
      (hEJ _ hx₀) (hEJ _ hy₀) (hB _ (hkey x₀ hx₀)) (hB _ (hkey y₀ hy₀))
      (fun l _ => hcomp x₀ l) (fun l _ => hcomp y₀ l)

private theorem map_conjSLn_witt_eq_fix {Ω : Type} [Field Ω] [IsAlgClosed Ω] [CharP Ω 2]
    {f : ℕ} (hf : 1 ≤ f) {F : Subfield Ω} (hFcard : Nat.card F = (2 ^ f) ^ 2)
    (hFmem : ∀ a, a ∈ F ↔ a ^ ((2 ^ f) ^ 2) = a)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    {σQ : Ω ≃+* Ω} (hσQ : ∀ c, σQ c = c ^ 2 ^ f)
    {P6 : GL (Fin 6) F}
    (hP6 : conjTr σ (P6 : Matrix (Fin 6) (Fin 6) F) *
      (P6 : Matrix (Fin 6) (Fin 6) F) = antidiag 6) :
    ((unitarySL σ.toRingHom).map (Matrix.SpecialLinearGroup.map F.subtype)).map
      (conjSLn (Matrix.GeneralLinearGroup.map F.subtype P6)) =
      fixSubgroup (stdUnitaryEquiv (ν := 6) σQ) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Finite F := Nat.finite_of_card_ne_zero (by rw [hFcard]; positivity)
  have hF2 : (2 : F) = 0 := by
    rw [← map_eq_zero_iff F.subtype F.subtype.injective, map_ofNat]
    exact CharP.cast_eq_zero Ω 2
  haveI : CharP F 2 := CharTwo.of_one_ne_zero_of_two_eq_zero one_ne_zero hF2
  obtain ⟨F', hF'card, eFix, heFix⟩ :=
    two_suN_exists_equiv_link (ν := 6) Nat.prime_two hf σQ hσQ (by norm_num)
  have hF'eq : F' = F := Subfield.ext fun a =>
    (mem_subfield_iff_pow_eq_self hf hF'card a).trans (hFmem a).symm
  subst F'
  let PΩ : GL (Fin 6) Ω := Matrix.GeneralLinearGroup.map F.subtype P6
  let bSL : SL(6, F) →* SL(6, Ω) := Matrix.SpecialLinearGroup.map F.subtype
  have hσU : σ = unitaryInvolution F 2 f := RingEquiv.ext fun c => by
    rw [hσ, unitaryInvolution_apply]
  have hP6U : conjTr (unitaryInvolution F 2 f) (P6 : Matrix (Fin 6) (Fin 6) F) *
      (P6 : Matrix (Fin 6) (Fin 6) F) = antidiag 6 := by
    simpa [hσU] using hP6
  let eSU : unitarySL σ.toRingHom ≃* SU (unitaryInvolution F 2 f) 6 := unitarySLEquiv hσ
  let eConj : SU (unitaryInvolution F 2 f) 6 ≃*
      SUid (unitaryInvolution F 2 f) 6 := conjEquiv P6 hP6U
  let eId : SUid (unitaryInvolution F 2 f) 6 ≃* StatedSU 6 (2 ^ f) F :=
    MulEquiv.subgroupCongr (SUid_eq_statedSU (p := 2) (f := f) hFcard 6)
  let e : unitarySL σ.toRingHom ≃* fixSubgroup (stdUnitaryEquiv (ν := 6) σQ) :=
    ((eSU.trans eConj).trans eId).trans eFix
  have hE : ∀ B : unitarySL σ.toRingHom,
      (e B : SL(6, Ω)) = conjSLn PΩ (bSL B) := by
    intro B
    change (eFix (eId (eConj (eSU B))) : SL(6, Ω)) = conjSLn PΩ (bSL B)
    rw [heFix]
    apply Subtype.ext
    rw [coe_statedSUToSL, coe_conjSLn]
    change (((eConj (eSU B) : SUid (unitaryInvolution F 2 f) 6) : GL (Fin 6) F) :
        Matrix (Fin 6) (Fin 6) F).map F.subtype =
      (PΩ : Matrix (Fin 6) (Fin 6) Ω) * (bSL B : Matrix (Fin 6) (Fin 6) Ω) *
        ((PΩ⁻¹ : GL (Fin 6) Ω) : Matrix (Fin 6) (Fin 6) Ω)
    rw [coe_conjEquiv]
    change (((P6 * ((eSU B : SU (unitaryInvolution F 2 f) 6) : GL (Fin 6) F) * P6⁻¹ :
        GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F).map F.subtype) =
      (PΩ : Matrix (Fin 6) (Fin 6) Ω) * ((B : Matrix (Fin 6) (Fin 6) F).map F.subtype) *
        ((PΩ⁻¹ : GL (Fin 6) Ω) : Matrix (Fin 6) (Fin 6) Ω)
    rw [show (eSU B : GL (Fin 6) F) = Matrix.SpecialLinearGroup.toGL (B : SL(6, F)) from
      coe_unitarySLEquiv (σ := σ.toRingHom) hσ B]
    change (((P6 * Matrix.SpecialLinearGroup.toGL (B : SL(6, F)) * P6⁻¹ : GL (Fin 6) F) :
        Matrix (Fin 6) (Fin 6) F).map F.subtype) =
      (PΩ : Matrix (Fin 6) (Fin 6) Ω) * ((B : Matrix (Fin 6) (Fin 6) F).map F.subtype) *
        ((PΩ⁻¹ : GL (Fin 6) Ω) : Matrix (Fin 6) (Fin 6) Ω)
    let gmap : GL (Fin 6) F →* GL (Fin 6) Ω := Matrix.GeneralLinearGroup.map F.subtype
    have hGL : gmap (P6 * Matrix.SpecialLinearGroup.toGL (B : SL(6, F)) * P6⁻¹) =
        gmap P6 * gmap (Matrix.SpecialLinearGroup.toGL (B : SL(6, F))) * (gmap P6)⁻¹ := by
      simp only [map_mul, map_inv]
    exact congrArg (fun g : GL (Fin 6) Ω => (g : Matrix (Fin 6) (Fin 6) Ω)) hGL
  ext Z
  constructor
  · rintro ⟨B, hB, rfl⟩
    obtain ⟨B₀, hB₀, rfl⟩ := hB
    rw [← hE ⟨B₀, hB₀⟩]
    exact (e ⟨B₀, hB₀⟩).2
  · intro hZ
    refine ⟨bSL (e.symm ⟨Z, hZ⟩), ?_, ?_⟩
    · exact ⟨e.symm ⟨Z, hZ⟩, (e.symm ⟨Z, hZ⟩).2, rfl⟩
    · rw [← hE (e.symm ⟨Z, hZ⟩)]
      exact congrArg Subtype.val (e.apply_symm_apply ⟨Z, hZ⟩)

private theorem exists_antiIdSL_cocycle_of_conj
    {Ω : Type} [Field Ω] [CharP Ω 2] {σQ : Ω ≃+* Ω}
    {P : GL (Fin 6) Ω} {S : SL(6, Ω)}
    (hP : conjTr σQ (P : Matrix (Fin 6) (Fin 6) Ω) *
      (P : Matrix (Fin 6) (Fin 6) Ω) = E6GraphLevi.antiId Ω)
    (hS : ∀ Y : Matrix (Fin 6) (Fin 6) Ω,
      (S : Matrix (Fin 6) (Fin 6) Ω) * Y *
          ((S⁻¹ : SL(6, Ω)) : Matrix (Fin 6) (Fin 6) Ω) =
        (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * Y * (P : Matrix (Fin 6) (Fin 6) Ω)) :
    ∃ J6 : SL(6, Ω),
      (J6 : Matrix (Fin 6) (Fin 6) Ω) = E6GraphLevi.antiId Ω ∧
      (realize (CharP.cast_eq_zero Ω 2) S)⁻¹ *
          twistHom TwistTag.E6 Ω σQ.toRingHom (realize (CharP.cast_eq_zero Ω 2) S) =
        realize (CharP.cast_eq_zero Ω 2) J6 := by
  classical
  let J : Matrix (Fin 6) (Fin 6) Ω := E6GraphLevi.antiId Ω
  have hJdet : J.det = 1 := by
    dsimp [J]
    exact eq_one_of_mul_self_eq_one_of_two_eq_zero (CharP.cast_eq_zero Ω 2)
      (E6GraphLevi.det_antiId_sq (E := Ω))
  let J6 : SL(6, Ω) := ⟨J, hJdet⟩
  have hJ6coe : (J6 : Matrix (Fin 6) (Fin 6) Ω) = E6GraphLevi.antiId Ω := rfl
  have hJ6sq : J6 * J6 = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, hJ6coe, Matrix.SpecialLinearGroup.coe_one]
    exact E6GraphLevi.antiId_mul_self
  have hJ6inv : J6⁻¹ = J6 := (eq_inv_of_mul_eq_one_right hJ6sq).symm
  have hSinvMat : ((S⁻¹ : SL(6, Ω)) : Matrix (Fin 6) (Fin 6) Ω) =
      (S : Matrix (Fin 6) (Fin 6) Ω)⁻¹ := by
    refine (Matrix.inv_eq_left_inv (A := (S : Matrix (Fin 6) (Fin 6) Ω))
      (B := ((S⁻¹ : SL(6, Ω)) : Matrix (Fin 6) (Fin 6) Ω)) ?_).symm
    rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
      Matrix.SpecialLinearGroup.coe_one]
  have hS' : ∀ Y : Matrix (Fin 6) (Fin 6) Ω,
      (S : Matrix (Fin 6) (Fin 6) Ω) * Y * (S : Matrix (Fin 6) (Fin 6) Ω)⁻¹ =
        (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * Y * (P : Matrix (Fin 6) (Fin 6) Ω) := by
    intro Y
    have h := hS Y
    rwa [hSinvMat] at h
  have hPdet : (P : Matrix (Fin 6) (Fin 6) Ω).det ≠ 0 :=
    Matrix.GeneralLinearGroup.det_ne_zero P
  have hPunit : IsUnit (P : Matrix (Fin 6) (Fin 6) Ω).det :=
    isUnit_iff_ne_zero.mpr hPdet
  have hSunit : IsUnit (S : Matrix (Fin 6) (Fin 6) Ω).det := by
    rw [S.2]
    exact isUnit_one
  have hPScomm : ∀ Y : Matrix (Fin 6) (Fin 6) Ω,
      ((P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω)) * Y =
        Y * ((P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω)) := by
    intro Y
    have hSY : (S : Matrix (Fin 6) (Fin 6) Ω) * Y =
        (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * Y * (P : Matrix (Fin 6) (Fin 6) Ω) *
          (S : Matrix (Fin 6) (Fin 6) Ω) := by
      calc (S : Matrix (Fin 6) (Fin 6) Ω) * Y
          = (S : Matrix (Fin 6) (Fin 6) Ω) * Y * 1 := by rw [Matrix.mul_one]
        _ = (S : Matrix (Fin 6) (Fin 6) Ω) * Y *
              ((S : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * (S : Matrix (Fin 6) (Fin 6) Ω)) := by
              rw [Matrix.nonsing_inv_mul _ hSunit]
        _ = ((S : Matrix (Fin 6) (Fin 6) Ω) * Y *
              (S : Matrix (Fin 6) (Fin 6) Ω)⁻¹) * (S : Matrix (Fin 6) (Fin 6) Ω) := by
              simp only [Matrix.mul_assoc]
        _ = ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * Y * (P : Matrix (Fin 6) (Fin 6) Ω)) *
              (S : Matrix (Fin 6) (Fin 6) Ω) := by rw [hS' Y]
        _ = _ := by rw [Matrix.mul_assoc]
    calc ((P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω)) * Y
        = (P : Matrix (Fin 6) (Fin 6) Ω) * ((S : Matrix (Fin 6) (Fin 6) Ω) * Y) := by
            rw [Matrix.mul_assoc]
      _ = (P : Matrix (Fin 6) (Fin 6) Ω) *
            ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * Y * (P : Matrix (Fin 6) (Fin 6) Ω) *
              (S : Matrix (Fin 6) (Fin 6) Ω)) := by rw [hSY]
      _ = (P : Matrix (Fin 6) (Fin 6) Ω) *
            ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ *
              (Y * (P : Matrix (Fin 6) (Fin 6) Ω))) * (S : Matrix (Fin 6) (Fin 6) Ω) := by
            simp only [Matrix.mul_assoc]
      _ = (Y * (P : Matrix (Fin 6) (Fin 6) Ω)) * (S : Matrix (Fin 6) (Fin 6) Ω) := by
            rw [Matrix.mul_nonsing_inv_cancel_left (A := (P : Matrix (Fin 6) (Fin 6) Ω))
              (B := Y * (P : Matrix (Fin 6) (Fin 6) Ω)) hPunit]
      _ = Y * ((P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω)) := by
            rw [Matrix.mul_assoc]
  obtain ⟨μ, hμscalar⟩ := Matrix.mem_range_scalar_of_commute_single
    (n := Fin 6) (M := (P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω))
    (fun i j _ => (hPScomm (Matrix.single i j 1)).symm)
  have hμ : (P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω) =
      Matrix.scalar (Fin 6) μ := hμscalar.symm
  have hμ0 : μ ≠ 0 := by
    intro h0
    have hdet : (Matrix.scalar (Fin 6) μ).det ≠ 0 := by
      rw [← hμ, Matrix.det_mul, S.2, mul_one]
      exact hPdet
    have hzero : (Matrix.scalar (Fin 6) μ).det = 0 := by simp [h0]
    exact hdet hzero
  have hSrepr : (S : Matrix (Fin 6) (Fin 6) Ω) =
      Matrix.scalar (Fin 6) μ * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ := by
    calc (S : Matrix (Fin 6) (Fin 6) Ω)
        = (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ *
            ((P : Matrix (Fin 6) (Fin 6) Ω) * (S : Matrix (Fin 6) (Fin 6) Ω)) := by
            rw [← Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hPunit, Matrix.one_mul]
      _ = (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * Matrix.scalar (Fin 6) μ := by rw [hμ]
      _ = Matrix.scalar (Fin 6) μ * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ :=
            (Matrix.scalar_commute μ (fun r => Commute.all μ r)
              ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹)).eq.symm
  have hmoveμ : (P : Matrix (Fin 6) (Fin 6) Ω) *
      (Matrix.scalar (Fin 6) μ * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹) =
      Matrix.scalar (Fin 6) μ * ((P : Matrix (Fin 6) (Fin 6) Ω) *
        (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹) := by
    rw [← Matrix.mul_assoc,
      ← (Matrix.scalar_commute μ (fun r => Commute.all μ r)
        (P : Matrix (Fin 6) (Fin 6) Ω)).eq, Matrix.mul_assoc]
  have hSinvForm : (S : Matrix (Fin 6) (Fin 6) Ω)⁻¹ =
      Matrix.scalar (Fin 6) μ⁻¹ * (P : Matrix (Fin 6) (Fin 6) Ω) := by
    refine Matrix.inv_eq_left_inv (B := Matrix.scalar (Fin 6) μ⁻¹ *
      (P : Matrix (Fin 6) (Fin 6) Ω)) ?_
    rw [hSrepr]
    calc (Matrix.scalar (Fin 6) μ⁻¹ * (P : Matrix (Fin 6) (Fin 6) Ω)) *
          (Matrix.scalar (Fin 6) μ * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹)
        = Matrix.scalar (Fin 6) μ⁻¹ *
            ((P : Matrix (Fin 6) (Fin 6) Ω) *
              (Matrix.scalar (Fin 6) μ * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹)) := by
            rw [Matrix.mul_assoc]
      _ = Matrix.scalar (Fin 6) μ⁻¹ *
            (Matrix.scalar (Fin 6) μ *
              ((P : Matrix (Fin 6) (Fin 6) Ω) * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹)) := by
            rw [hmoveμ]
      _ = Matrix.scalar (Fin 6) μ⁻¹ * Matrix.scalar (Fin 6) μ := by
            rw [Matrix.mul_nonsing_inv _ hPunit, Matrix.mul_one]
      _ = 1 := by
            rw [← map_mul, inv_mul_cancel₀ hμ0, map_one]
  have hPt : ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ =
      E6GraphLevi.antiId Ω * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ := by
    have h := hP
    rw [conjTr] at h
    have h' : ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ *
        (P : Matrix (Fin 6) (Fin 6) Ω) = E6GraphLevi.antiId Ω := h
    calc ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ
        = (((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ *
            (P : Matrix (Fin 6) (Fin 6) Ω)) * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ := by
            rw [Matrix.mul_assoc, Matrix.mul_nonsing_inv _ hPunit, Matrix.mul_one]
      _ = E6GraphLevi.antiId Ω * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ := by rw [h']
  have hmapSinv : (S : Matrix (Fin 6) (Fin 6) Ω)⁻¹.map σQ.toRingHom =
      Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
        (P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom := by
    rw [hSinvForm, Matrix.map_mul]
    congr 1
    ext i j
    by_cases h : i = j <;> simp [h, Matrix.diagonal, map_inv₀]
  have hcoeMapInv : (((Matrix.SpecialLinearGroup.map σQ.toRingHom S)⁻¹ : SL(6, Ω)) :
      Matrix (Fin 6) (Fin 6) Ω) =
      (S : Matrix (Fin 6) (Fin 6) Ω)⁻¹.map σQ.toRingHom := by
    rw [← map_inv, Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply,
      hSinvMat]
  have htrans : (Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
      (P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ =
      ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ *
        Matrix.scalar (Fin 6) ((σQ μ)⁻¹) := by
    rw [Matrix.transpose_mul, Matrix.scalar_apply, Matrix.diagonal_transpose]
  have hc_comm : ∀ M : Matrix (Fin 6) (Fin 6) Ω,
      Matrix.scalar (Fin 6) ((σQ μ)⁻¹) * M =
        M * Matrix.scalar (Fin 6) ((σQ μ)⁻¹) :=
    fun M => (Matrix.scalar_commute ((σQ μ)⁻¹) (fun r => Commute.all _ _) M).eq
  have hψSmat : (unitaryTwist σQ.toRingHom S : Matrix (Fin 6) (Fin 6) Ω) =
      Matrix.scalar (Fin 6) ((σQ μ)⁻¹) * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ *
        E6GraphLevi.antiId Ω := by
    calc (unitaryTwist σQ.toRingHom S : Matrix (Fin 6) (Fin 6) Ω)
        = E6GraphLevi.antiId Ω *
            (((Matrix.SpecialLinearGroup.map σQ.toRingHom S)⁻¹ : SL(6, Ω)) :
              Matrix (Fin 6) (Fin 6) Ω)ᵀ *
            E6GraphLevi.antiId Ω := E6GraphLevi.coe_graphSL _
      _ = E6GraphLevi.antiId Ω *
            ((S : Matrix (Fin 6) (Fin 6) Ω)⁻¹.map σQ.toRingHom)ᵀ *
            E6GraphLevi.antiId Ω := by rw [hcoeMapInv]
      _ = E6GraphLevi.antiId Ω *
            (Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
              (P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ *
            E6GraphLevi.antiId Ω := by rw [hmapSinv]
      _ = E6GraphLevi.antiId Ω *
            (((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ *
              Matrix.scalar (Fin 6) ((σQ μ)⁻¹)) *
            E6GraphLevi.antiId Ω := by rw [htrans]
      _ = Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
            (E6GraphLevi.antiId Ω *
              ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ *
              E6GraphLevi.antiId Ω) := by
            rw [← hc_comm ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ,
              ← Matrix.mul_assoc (E6GraphLevi.antiId Ω)
                (Matrix.scalar (Fin 6) ((σQ μ)⁻¹))
                ((P : Matrix (Fin 6) (Fin 6) Ω).map σQ.toRingHom)ᵀ,
              ← hc_comm (E6GraphLevi.antiId Ω)]
            simp only [Matrix.mul_assoc]
      _ = Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
            (E6GraphLevi.antiId Ω *
              (E6GraphLevi.antiId Ω * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹) *
              E6GraphLevi.antiId Ω) := by rw [hPt]
      _ = Matrix.scalar (Fin 6) ((σQ μ)⁻¹) * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ *
            E6GraphLevi.antiId Ω := by
            rw [← Matrix.mul_assoc (E6GraphLevi.antiId Ω) (E6GraphLevi.antiId Ω)
              ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹),
              E6GraphLevi.antiId_mul_self, Matrix.one_mul, Matrix.mul_assoc]
  have hCmat : ((S⁻¹ * unitaryTwist σQ.toRingHom S : SL(6, Ω)) :
      Matrix (Fin 6) (Fin 6) Ω) =
      Matrix.scalar (Fin 6) (μ⁻¹ * (σQ μ)⁻¹) * E6GraphLevi.antiId Ω := by
    rw [Matrix.SpecialLinearGroup.coe_mul, hSinvMat, hSinvForm, hψSmat]
    calc (Matrix.scalar (Fin 6) μ⁻¹ * (P : Matrix (Fin 6) (Fin 6) Ω)) *
          (Matrix.scalar (Fin 6) ((σQ μ)⁻¹) * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ *
            E6GraphLevi.antiId Ω)
        = Matrix.scalar (Fin 6) μ⁻¹ *
            ((P : Matrix (Fin 6) (Fin 6) Ω) *
              (Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
                ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * E6GraphLevi.antiId Ω))) := by
            simp only [Matrix.mul_assoc]
      _ = Matrix.scalar (Fin 6) μ⁻¹ *
            (Matrix.scalar (Fin 6) ((σQ μ)⁻¹) *
              ((P : Matrix (Fin 6) (Fin 6) Ω) * (P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ *
                E6GraphLevi.antiId Ω)) := by
            rw [← Matrix.mul_assoc (P : Matrix (Fin 6) (Fin 6) Ω)
                (Matrix.scalar (Fin 6) ((σQ μ)⁻¹))
                ((P : Matrix (Fin 6) (Fin 6) Ω)⁻¹ * E6GraphLevi.antiId Ω),
              ← hc_comm (P : Matrix (Fin 6) (Fin 6) Ω)]
            simp only [Matrix.mul_assoc]
      _ = Matrix.scalar (Fin 6) μ⁻¹ *
            (Matrix.scalar (Fin 6) ((σQ μ)⁻¹) * E6GraphLevi.antiId Ω) := by
            rw [Matrix.mul_nonsing_inv _ hPunit, Matrix.one_mul]
      _ = Matrix.scalar (Fin 6) (μ⁻¹ * (σQ μ)⁻¹) * E6GraphLevi.antiId Ω := by
            rw [← Matrix.mul_assoc, ← map_mul]
  have hCdet : (μ⁻¹ * (σQ μ)⁻¹) ^ 6 = 1 := by
    have hdet := (S⁻¹ * unitaryTwist σQ.toRingHom S).2
    rw [hCmat, Matrix.det_mul, Matrix.scalar_apply, Matrix.det_diagonal,
      Finset.prod_const, Finset.card_univ, Fintype.card_fin, hJdet, mul_one] at hdet
    exact hdet
  have hd3 : (μ⁻¹ * (σQ μ)⁻¹) ^ 3 = 1 :=
    E6GraphLevi.pow_three_eq_one_of_pow_six (CharP.cast_eq_zero Ω 2) hCdet
  have hker : S⁻¹ * unitaryTwist σQ.toRingHom S * J6⁻¹ ∈
      (realize (CharP.cast_eq_zero Ω 2)).ker := by
    rw [E6GraphLevi.mem_ker_realize (CharP.cast_eq_zero Ω 2)]
    refine ⟨μ⁻¹ * (σQ μ)⁻¹, hd3, ?_⟩
    rw [Matrix.SpecialLinearGroup.coe_mul, hCmat, hJ6inv, hJ6coe, Matrix.mul_assoc,
      E6GraphLevi.antiId_mul_self, Matrix.mul_one]
  have hCJ : realize (CharP.cast_eq_zero Ω 2)
      (S⁻¹ * unitaryTwist σQ.toRingHom S * J6⁻¹) = 1 :=
    MonoidHom.mem_ker.1 hker
  have hψCeq : realize (CharP.cast_eq_zero Ω 2)
