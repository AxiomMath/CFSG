theorem isSLFrame_realize_standard {Ω : Type} [Field Ω] [IsAlgClosed Ω] [CharP Ω 2] :
    IsSLFrame (realize (CharP.cast_eq_zero Ω 2))
      (chainσ (fun c : Fin 5 => Pi.single (pathIdx c) (1 : ℤ))) := by
  let ψ : SL(5 + 1, Ω) →* ModGL Tag.E6 Ω := realize (CharP.cast_eq_zero Ω 2)
  have hψ : IsSLFrame ψ (chainσ (fun c : Fin 5 => Pi.single (pathIdx c) (1 : ℤ))) := by
    have hβ : ∀ c : Fin 5, IsRoot Tag.E6 (Pi.single (pathIdx c) (1 : ℤ)) :=
      fun c => isRoot_single Tag.E6 (pathIdx c)
    have hG : ∀ c d : Fin 5,
        iform (Pi.single (pathIdx c) (1 : ℤ)) (Pi.single (pathIdx d) (1 : ℤ)) =
          chainGram c d := by
      intro c d
      have h := CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.TwE6InnerAbs.lA5a_chk.2.1 c d
      fin_cases c <;> fin_cases d <;> exact h
    refine isSLFrame_chainHom (Or.inr (Or.inl rfl)) hβ hG ?_
    intro c
    let ρ : SL2 Ω →* ModGL Tag.E6 Ω := ψ.comp (blockSL2 Ω 5 c)
    have hρ : ρ = rootSL2 Tag.E6 Ω (Pi.single (pathIdx c) (1 : ℤ)) := by
      rw [show rootSL2 Tag.E6 Ω (Pi.single (pathIdx c) (1 : ℤ)) =
          simpleRootSL2 Tag.E6 Ω (pathIdx c) from
        rootSL2_single (τ := Tag.E6) (L := Ω) (i := pathIdx c)]
      refine eq_simpleRootSL2 (pathIdx c) ?_ ?_
      · intro t
        show ρ (uSL t) = xUnit Tag.E6 Ω (pathIdx c) t
        rw [show ρ (uSL t) = ψ (blockSL2 Ω 5 c (uSL t)) from rfl]
        rw [show ψ (blockSL2 Ω 5 c (uSL t)) =
          realize (CharP.cast_eq_zero Ω 2) (blockSL2 Ω 5 c (uSL t)) from rfl]
        rw [show blockSL2 Ω 5 c (uSL t) =
          Matrix.SpecialLinearGroup.transvection (Fin.castSucc_lt_succ (i := c)).ne t from
            blockSL2_uSL_eq c t]
        exact realize_x (CharP.cast_eq_zero Ω 2) c t
      · intro t
        show ρ (vSL t) = yUnit Tag.E6 Ω (pathIdx c) t
        rw [show ρ (vSL t) = ψ (blockSL2 Ω 5 c (vSL t)) from rfl]
        rw [show ψ (blockSL2 Ω 5 c (vSL t)) =
          realize (CharP.cast_eq_zero Ω 2) (blockSL2 Ω 5 c (vSL t)) from rfl]
        rw [show blockSL2 Ω 5 c (vSL t) =
          Matrix.SpecialLinearGroup.transvection (Fin.castSucc_lt_succ (i := c)).ne' t from
            blockSL2_vSL_eq c t]
        exact realize_y (CharP.cast_eq_zero Ω 2) c t
    exact hρ
  exact hψ

