    exact subsystemGroup_le_centralizer_thetaSL2 h2Ω
  have hfix : ∀ x ∈ (su6Levi σ.toRingHom).map b,
      (MulAut.conj n⁻¹) x = x := by
    intro x hx
    have hxψ : x ∈ ψ.range := hbLle hx
    have hcomm : Commute x n :=
      (Subgroup.mem_centralizer_iff.1 (hcent hxψ) n hn).symm
    rw [MulAut.conj_apply]
    calc n⁻¹ * x * n = n⁻¹ * (x * n) := by group
      _ = n⁻¹ * (n * x) := by rw [hcomm.eq]
      _ = x := by group
  have hLmap : L.map ι = (su6Levi σ.toRingHom).map b := by
    calc
      L.map ι = (L.map (b.comp j)).map (MulAut.conj n⁻¹).toMonoidHom := by
        rw [Subgroup.map_map]
      _ = ((L.map j).map b).map (MulAut.conj n⁻¹).toMonoidHom := by
        rw [← Subgroup.map_map]
      _ = ((su6Levi σ.toRingHom).map b).map
            (MulAut.conj n⁻¹).toMonoidHom := by rw [hL]
      _ = (su6Levi σ.toRingHom).map b := by
        apply le_antisymm
        · rintro y ⟨x, hx, rfl⟩
          change (MulAut.conj n⁻¹) x ∈
            (su6Levi σ.toRingHom).map b
          rw [hfix x hx]
          exact hx
        · intro x hx
          exact ⟨x, hx, by simpa using hfix x hx⟩
  have hfixed : ∀ g : ModGL TwistTag.E6.tag Ω, g ∈ L.map ι ↔
      ∃ Y ∈ fixSubgroup (stdUnitaryEquiv (ν := 6) σQ),
        g = ψ S * ψ Y * (ψ S)⁻¹ := by
    intro g
    rw [hLmap, hHψ]
    constructor
    · rintro ⟨h, hh, rfl⟩
      rw [hHinv] at hh
      obtain ⟨Y, hY, rfl⟩ := hh
      exact ⟨Y, hY, (hWstd Y).symm⟩
    · rintro ⟨Y, hY, rfl⟩
      refine ⟨conjSLn P6Ω⁻¹ Y, ?_, (hWstd Y).symm⟩
      rw [hHinv]
      exact ⟨Y, hY, rfl⟩
  have hker : ψ.ker ≤ Subgroup.center SL(6, Ω) := by
    intro B hB
    rw [Matrix.SpecialLinearGroup.mem_center_iff]
    obtain ⟨l, hl3, hBmat⟩ := (mem_ker_realize h2Ω B).1 hB
    refine ⟨l, ?_, hBmat.symm⟩
    change l ^ 6 = 1
    rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, hl3, one_pow]
  have hι_inj : Function.Injective ι := by
    change Function.Injective ((MulAut.conj n⁻¹).toMonoidHom.comp (b.comp j))
    exact (MulAut.conj n⁻¹).injective.comp
      ((baseChangeGL_injective F.subtype).comp
        ((MulAut.conj (c : ModGL TwistTag.E6.tag F)).injective.comp hι₀))
  have htopmap : (⊤ : Subgroup ↥L).map (ι.comp L.subtype) = L.map ι := by
    ext g
    constructor
    · rintro ⟨x, -, rfl⟩
      exact Subgroup.mem_map_of_mem ι x.2
    · rintro ⟨h, hh, rfl⟩
      exact ⟨⟨h, hh⟩, Subgroup.mem_top _, rfl⟩
  have hJ : ∀ g : ModGL TwistTag.E6.tag Ω,
      g ∈ (⊤ : Subgroup ↥L).map (ι.comp L.subtype) ↔
        ∃ Y ∈ fixSubgroup (stdUnitaryEquiv (ν := 6) σQ),
          g = ψ S * ψ Y * (ψ S)⁻¹ := by
    intro g
    rw [htopmap]
    exact hfixed g
  obtain ⟨Φtop, θtop, hΦtop, hθtop, -, -⟩ :=
    exists_psu_equiv_of_conj_frame_of_subfield (Ω := Ω) (n := f) Nat.prime_two hf
      (σQ := σQ) hσQ (by norm_num) (fun h => absurd (congrArg Prod.fst h) (by norm_num))
      (G := ModGL TwistTag.E6.tag Ω) (ψ := ψ) hker z
      (L' := ↥L) (J := ⊤) (ι := ι.comp L.subtype)
      (hι_inj.comp (fun x y h => Subtype.ext h)) hJ
      (F := F) hFcard hFmem
  let eTop : ↥(⊤ : Subgroup ↥L) ≃* ↥L := Subgroup.topEquiv
  let Φ : StatedSU 6 (2 ^ f) F →* ↥L := eTop.toMonoidHom.comp Φtop
  let eQ : ↥L ⧸ Subgroup.center ↥L ≃*
      ↥(⊤ : Subgroup ↥L) ⧸ Subgroup.center ↥(⊤ : Subgroup ↥L) :=
    CFSG.Fischer.quotientCenterCongr
      (Subgroup.topEquiv.symm : ↥L ≃* ↥(⊤ : Subgroup ↥L))
  let θ : ↥L ⧸ Subgroup.center ↥L ≃*
      LargeEvenProj (LargeEvenSUGroup (Fin 6) F (2 ^ f)) := eQ.trans θtop
  refine ⟨n, hn, ⟨a, hcocycle⟩, S, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro g hg
    obtain ⟨a, haA, rfl⟩ := hg
    change n⁻¹ * b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
      (c : ModGL TwistTag.E6.tag F)⁻¹) * n ∈
      torusGroup Tag.E6 Ω ⊔ ψ.range
    have hroot : ∀ u : Fˣ, ∃ v : Ωˣ, v ^ 3 = Units.map F.subtype.toMonoidHom u := by
      intro u
      obtain ⟨v, hv⟩ := IsAlgClosed.exists_pow_nat_eq (F.subtype (u : F)) (by norm_num : 0 < 3)
      have hv0 : v ≠ 0 := by
        intro h
        have h0 : (0 : Ω) = F.subtype (u : F) := by simpa [h] using hv
        have hu : F.subtype (u : F) ≠ 0 := by
          simpa using F.subtype.injective.ne (Units.ne_zero u)
        exact hu h0.symm
      refine ⟨Units.mk0 v hv0, Units.ext ?_⟩
      simpa [Units.val_pow_eq_pow_val, Units.mk0_val] using hv
    have hbc_adj : b (c : ModGL TwistTag.E6.tag F) ∈ adjointGroup Tag.E6 Ω :=
      map_twistedE6InndiagGL_le σ F.subtype hroot
        (Subgroup.mem_map_of_mem b c.2)
    have hιa_root : ι₀ a ∈ twistedE6RootGroup F σ := by
      rw [← hrange]
      exact ⟨a, rfl⟩
    have hιa_adj : b (ι₀ a) ∈ adjointGroup Tag.E6 Ω :=
      baseChangeGL_mem_adjointGroup F.subtype
        (CFSG.HardMathSupport.Timmesfeld.Tables.T1b.twistedE6RootGroup_le σ hιa_root)
    have hbga_adj : b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
        (c : ModGL TwistTag.E6.tag F)⁻¹) ∈ adjointGroup Tag.E6 Ω := by
      rw [map_mul, map_mul, map_inv]
      exact mul_mem (mul_mem hbc_adj hιa_adj) (inv_mem hbc_adj)
    have hn_adj : n ∈ adjointGroup Tag.E6 Ω := by
      rw [show n = thetaSL2 Ω P2Ω from rfl]
      exact CFSG.SeitzReduction.E6Pilot.rootSL2_highRoot_mem_adjointGroup P2Ω
    have hcommA : Commute (b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
        (c : ModGL TwistTag.E6.tag F)⁻¹))
        (b ((c : ModGL TwistTag.E6.tag F) * ι₀ x *
          (c : ModGL TwistTag.E6.tag F)⁻¹)) := by
      have h0 : Commute (ι₀ a) (ι₀ x) := by
        change (ι₀ a) * (ι₀ x) = (ι₀ x) * (ι₀ a)
        have hc := hAe.1.is_comm.comm ⟨a, haA⟩ ⟨x, hxA⟩
        simpa [map_mul] using congrArg (fun z : ↥A => (ι₀.comp A.subtype) z) hc
      have h1 : Commute ((MulAut.conj (c : ModGL TwistTag.E6.tag F)) (ι₀ a))
          ((MulAut.conj (c : ModGL TwistTag.E6.tag F)) (ι₀ x)) :=
        h0.map (MulAut.conj (c : ModGL TwistTag.E6.tag F)).toMonoidHom
      have h2 := h1.map b
      simpa [map_mul, map_inv] using h2
    have hcommι : Commute (n⁻¹ * b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
        (c : ModGL TwistTag.E6.tag F)⁻¹) * n)
        (n⁻¹ * b ((c : ModGL TwistTag.E6.tag F) * ι₀ x *
          (c : ModGL TwistTag.E6.tag F)⁻¹) * n) := by
      have := hcommA.map (MulAut.conj n⁻¹).toMonoidHom
      simpa [MulAut.conj_apply] using this
    have hcomm : Commute (n⁻¹ * b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
        (c : ModGL TwistTag.E6.tag F)⁻¹) * n)
        (rootDiagUnit TwistTag.E6.tag (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag ζΩ)) := by
      rw [hconj] at hcommι
      exact hcommι
    have hζΩ1 : ζΩ ≠ 1 := by
      intro h
      apply hζ1
      apply Units.ext
      exact F.subtype.injective (by simpa [ζΩ] using congrArg (fun u : Ωˣ => (u : Ω)) h)
    have hζΩ2 : ζΩ ^ 2 ≠ 1 := by
      intro h
      apply hζ2
      have hmap : Units.map F.subtype.toMonoidHom (ζ ^ 2) = 1 := by
        simpa [ζΩ, map_pow] using h
      apply Units.ext
      exact F.subtype.injective (by simpa using congrArg (fun u : Ωˣ => (u : Ω)) hmap)
    have hm : n⁻¹ * b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
        (c : ModGL TwistTag.E6.tag F)⁻¹) * n ∈
        toralCentralizer TwistTag.E6.tag Ω (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag ζΩ) := by
      refine mem_toralCentralizer.2 ⟨?_, ?_⟩
      · exact mul_mem (mul_mem (inv_mem hn_adj) hbga_adj) hn_adj
      · change rootDiagUnit (K := Ω) TwistTag.E6.tag (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag ζΩ) *
          (n⁻¹ * b ((c : ModGL TwistTag.E6.tag F) * ι₀ a *
            (c : ModGL TwistTag.E6.tag F)⁻¹) * n) *
          (rootDiagUnit (K := Ω) TwistTag.E6.tag (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag ζΩ))⁻¹ = _
        rw [hcomm.symm.eq, mul_inv_cancel_right]
    have hrootSpan : rootSpan Tag.E6 Ω (CFSG.SeitzReduction.EPilot.perpRoots .E6) ≤ ψ.range := by
      rw [show ψ.range = subsystemGroup Tag.E6 Ω setA from range_realize h2Ω]
      exact rootSpan_perpRoots_le_subsystemGroup
    rw [CFSG.SeitzReduction.EPilot.toralCentralizer_highDiag (τ := TwistTag.E6.tag) (K := Ω)
      (Or.inl rfl) hζΩ1 hζΩ2] at hm
    exact (sup_le_sup_left hrootSpan _) hm
  · exact hLmap
  · exact hW
  · exact hfixed
  · exact ⟨ζ, hζ3, by
      simpa [ι, j, b, ζΩ, MulAut.conj_apply] using hconj⟩
  · exact hJ6out
  · refine ⟨Φ, θ, ?_, ?_⟩
    · intro s
      change ι (((eTop (Φtop s) : ↥L) : H)) =
        ψ S * ψ (statedSUToSL F 6 (2 ^ f) s) * (ψ S)⁻¹
      exact hΦtop s
    · intro s
      dsimp [θ, eQ, Φ, eTop]
      rw [CFSG.Fischer.quotientCenterCongr_mk]
      have hsym : (Subgroup.topEquiv.symm (Subgroup.topEquiv (Φtop s))) = Φtop s :=
        Subgroup.topEquiv.symm_apply_apply (Φtop s)
      rw [hsym]
      exact hθtop s

theorem naturalSU3_cover_range_eq_of_projective_eq
    {L : Type} [Group L] {F : Type} [Field F] {f : ℕ}
    (hF : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F)
    {J : Subgroup L}
    {Φ6 : StatedSU 6 (2 ^ f) F →* L}
    {θ : L ⧸ Subgroup.center L ≃*
      LargeEvenProj (LargeEvenSUGroup (Fin 6) F (2 ^ f))}
    (hθ : ∀ s, θ (QuotientGroup.mk (Φ6 s)) =
      LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) s)
    (π : L →* CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6))
    (hπ : π = (θ.trans
      (CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6))).toMonoidHom.comp
      (QuotientGroup.mk' (Subgroup.center L)))
    (hJperfect : ⁅J, J⁆ = J)
    (hq3 : 3 ≤ 2 ^ f)
    {j : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) →* CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)}
    (hJP : j.range.map
        (QuotientGroup.mk' (CFSG.ClassicalGroups.UnitaryFlag.normOneScalars hF
          (CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) 6)) = J.map π) :
    (Φ6.comp
      ((CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
        (C₀ := (1 : GL (Fin 6) F)) rfl).toMonoidHom.comp
        (j.comp
          (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
            (C₀ := (1 : GL (Fin 3) F)) rfl).symm.toMonoidHom))).range = J := by
  classical
  let κ3 : StatedSU 3 (2 ^ f) F ≃* CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) := (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF (C₀ := (1 : GL (Fin 3) F)) rfl).symm
  let κ6 : StatedSU 6 (2 ^ f) F ≃* CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) := (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF (C₀ := (1 : GL (Fin 6) F)) rfl).symm
  let jS : StatedSU 3 (2 ^ f) F →* StatedSU 6 (2 ^ f) F :=
    κ6.symm.toMonoidHom.comp (j.comp κ3.toMonoidHom)
  let Ψ3 : StatedSU 3 (2 ^ f) F →* L := Φ6.comp jS
  let q6 : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) →*
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    QuotientGroup.mk' (CFSG.ClassicalGroups.UnitaryFlag.normOneScalars hF
      (CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) 6)
  have hη : ∀ s : StatedSU 6 (2 ^ f) F, π (Φ6 s) = q6 (κ6 s) := by
    intro s
    rw [hπ]
    change (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6)))
        (QuotientGroup.mk (Φ6 s)) = q6 (κ6 s)
    rw [MulEquiv.trans_apply, hθ s]
    let sH : LargeEvenSUGroup (Fin 6) F (2 ^ f) := s
    change CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6)
        (LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) sH) = q6 (κ6 s)
    rw [show LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) sH =
        (sH : LargeEvenProj (LargeEvenSUGroup (Fin 6) F (2 ^ f))) from rfl,
      CFSG.StandardType.InndiagSU.projEquiv_mk]
    refine congrArg (fun x : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) =>
      (x : CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)))
      (Subtype.ext rfl)
  have hπeq : ∀ v : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6), π (Φ6 (κ6.symm v)) = q6 v := by
    intro v
    simpa using hη (κ6.symm v)
  have hker : π.ker ≤ Subgroup.center L := by
    rw [hπ,
      MonoidHom.ker_comp_of_injective (QuotientGroup.mk' (Subgroup.center L))
        (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF
          (by norm_num : 1 ≤ 6))).toMonoidHom
        (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF
          (by norm_num : 1 ≤ 6))).injective,
      QuotientGroup.ker_mk']
  have hFcard : Nat.card F = (2 ^ f) ^ 2 := by
    rw [hF.card, mul_comm, pow_mul]
  have hperf : Group.IsPerfect (StatedSU 3 (2 ^ f) F) := by
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    haveI : Finite F := hF.finite
    haveI : CharP F 2 := hF.charP
    exact CFSG.ClassicalGroups.Unitary.isPerfect_statedSU (p := 2) (f := f) hFcard
      (by norm_num : 3 ≤ 3) (by
        intro h
        have h2 : 2 ^ f = 2 := by simpa using congrArg Prod.snd h
        omega)
  have hΨperfect : Group.IsPerfect Ψ3.range := by
    haveI : Group.IsPerfect (StatedSU 3 (2 ^ f) F) := hperf
    exact Group.IsPerfect.range (f := Ψ3)
  have hΨcomm : ⁅Ψ3.range, Ψ3.range⁆ = Ψ3.range := by
    haveI : Group.IsPerfect Ψ3.range := hΨperfect
    exact Subgroup.commutator_eq_self
  have hrange_jS : jS.range = j.range.map κ6.symm.toMonoidHom := by
    calc
      jS.range = (j.comp κ3.toMonoidHom).range.map κ6.symm.toMonoidHom := by
        dsimp only [jS]
        rw [MonoidHom.range_comp]
      _ = (κ3.toMonoidHom.range.map j).map κ6.symm.toMonoidHom := by
        rw [MonoidHom.range_comp]
      _ = (Subgroup.map j
            (⊤ : Subgroup (CFSG.ClassicalGroups.UnitaryFlag.gramSU hF
              (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3)))).map
            κ6.symm.toMonoidHom := by
        rw [MonoidHom.range_eq_top_of_surjective _ κ3.surjective]
      _ = j.range.map κ6.symm.toMonoidHom := by
        rw [← MonoidHom.range_eq_map]
  have hΨrange : Ψ3.range = j.range.map (Φ6.comp κ6.symm.toMonoidHom) := by
    dsimp only [Ψ3]
    rw [MonoidHom.range_comp, hrange_jS, Subgroup.map_map]
  have hcomp : π.comp (Φ6.comp κ6.symm.toMonoidHom) = q6 := by
    ext v
    exact hπeq v
  have hΨmap : Ψ3.range.map π = J.map π := by
    rw [hΨrange, Subgroup.map_map, hcomp, hJP]
  have hEq : Ψ3.range = J :=
    eq_of_map_eq hker hΨcomm hJperfect hΨmap
  simpa only [Ψ3, jS, κ3, κ6, MulEquiv.symm_symm] using hEq

theorem map_range_eq_of_subgroupOfEquiv {L₀ L R : Type} [Group L₀] [Group L] [Group R]
    (eL : L₀ ≃* L) (π₀ : L₀ →* R) (π : L →* R)
    (hπ : π.comp eL.toMonoidHom = π₀)
    {J₀ : Subgroup L₀} {J : Subgroup L}
    (hJ : J₀.map eL.toMonoidHom = J) :
    J₀.map π₀ = J.map π := by
  rw [← hJ, Subgroup.map_map, hπ]

theorem naturalSU3_cover_diagram_of_standard_frame
    {Ω : Type} [Field Ω] [IsAlgClosed Ω] [CharP Ω 2]
    {F : Subfield Ω} {f : ℕ}
    (hF : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F)
    {H : Type} [Group H] {L : Subgroup H}
    {ι : H →* ModGL Tag.E6 Ω} {S : SL(6, Ω)}
    {Φ6 : StatedSU 6 (2 ^ f) F →* ↥L}
    (hΦ6 : ∀ s, ι (Φ6 s : H) =
      E6GraphLevi.realize (CharP.cast_eq_zero Ω 2) S *
        E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
          (statedSUToSL F 6 (2 ^ f) s) *
        (E6GraphLevi.realize (CharP.cast_eq_zero Ω 2) S)⁻¹)
    {j : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) →* CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)}
    (T : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6))
    (hT : ∀ P : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3),
      (((T : GL (Fin 6) F)⁻¹ : GL (Fin 6) F) :
          Matrix (Fin 6) (Fin 6) F) *
        (((j P : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F)) *
        (((T : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F)) =
      Matrix.reindex (finSumFinEquiv (m := 3) (n := 3))
        (finSumFinEquiv (m := 3) (n := 3))
        (Matrix.fromBlocks (((P : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F))
          (0 : Matrix (Fin 3) (Fin 3) F) (0 : Matrix (Fin 3) (Fin 3) F)
          (1 : Matrix (Fin 3) (Fin 3) F))) :
    let ψ : SL(6, Ω) →* ModGL Tag.E6 Ω := E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
    let TΩ : SL(6, Ω) :=
      statedSUToSL F 6 (2 ^ f)
        ((CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
          (C₀ := (1 : GL (Fin 6) F)) rfl) T)
    let C : ModGL Tag.E6 Ω := ψ S * ψ TΩ
    let ιT : H →* ModGL Tag.E6 Ω := (MulAut.conj C⁻¹).toMonoidHom.comp ι
    let Φ3 : StatedSU 3 (2 ^ f) F →* H :=
      L.subtype.comp (Φ6.comp
        ((CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
          (C₀ := (1 : GL (Fin 6) F)) rfl).toMonoidHom.comp
          (j.comp
            (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
              (C₀ := (1 : GL (Fin 3) F)) rfl).symm.toMonoidHom)))
    ιT.comp Φ3 =
      (e6FirstBlockRealize (CharP.cast_eq_zero Ω 2)).comp (statedSUToSL F 3 (2 ^ f)) := by
  classical
  let κ3 : StatedSU 3 (2 ^ f) F ≃* CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) := (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF (C₀ := (1 : GL (Fin 3) F)) rfl).symm
  let κ6 : StatedSU 6 (2 ^ f) F ≃* CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) := (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF (C₀ := (1 : GL (Fin 6) F)) rfl).symm
  let jS : StatedSU 3 (2 ^ f) F →* StatedSU 6 (2 ^ f) F :=
    κ6.symm.toMonoidHom.comp (j.comp κ3.toMonoidHom)
  let ψ : SL(6, Ω) →* ModGL Tag.E6 Ω := E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
  let TΩ : SL(6, Ω) := statedSUToSL F 6 (2 ^ f) (κ6.symm T)
  let C : ModGL Tag.E6 Ω := ψ S * ψ TΩ
  let ιT : H →* ModGL Tag.E6 Ω := (MulAut.conj C⁻¹).toMonoidHom.comp ι
  let Φ3 : StatedSU 3 (2 ^ f) F →* H := L.subtype.comp (Φ6.comp jS)
  change ιT.comp Φ3 =
    (e6FirstBlockRealize (CharP.cast_eq_zero Ω 2)).comp (statedSUToSL F 3 (2 ^ f))
  apply MonoidHom.ext
  intro s
  let P : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) := κ3 s
  let s6 : SL(6, Ω) := statedSUToSL F 6 (2 ^ f) (jS s)
  let Tm : GL (Fin 6) F := (T : GL (Fin 6) F)
  let jm : GL (Fin 6) F := (j P : GL (Fin 6) F)
  let Pm : GL (Fin 3) F := (P : GL (Fin 3) F)
  have hTΩcoe : ((TΩ : SL(6, Ω)) : Matrix (Fin 6) (Fin 6) Ω) =
      ((Tm : Matrix (Fin 6) (Fin 6) F)).map F.subtype := by
    dsimp only [TΩ]
    rw [CFSG.RankThree.Classical2.coe_statedSUToSL]
    simp [κ6, CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv, Tm]
  have hs6coe : ((s6 : SL(6, Ω)) : Matrix (Fin 6) (Fin 6) Ω) =
      ((jm : Matrix (Fin 6) (Fin 6) F)).map F.subtype := by
    dsimp only [s6]
    rw [CFSG.RankThree.Classical2.coe_statedSUToSL]
    simp [jS, κ6, CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv, jm, P]
  have hP3coe : ((statedSUToSL F 3 (2 ^ f) s : SL(3, Ω)) :
      Matrix (Fin 3) (Fin 3) Ω) = ((Pm : Matrix (Fin 3) (Fin 3) F)).map F.subtype := by
    rw [CFSG.RankThree.Classical2.coe_statedSUToSL]
    simp [P, κ3, CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv, Pm]
  have hmap_reindex : ∀ M : Matrix (Fin 3 ⊕ Fin 3) (Fin 3 ⊕ Fin 3) F,
      (Matrix.reindex (finSumFinEquiv (m := 3) (n := 3))
        (finSumFinEquiv (m := 3) (n := 3)) M).map F.subtype =
      Matrix.reindex (finSumFinEquiv (m := 3) (n := 3))
        (finSumFinEquiv (m := 3) (n := 3)) (M.map F.subtype) := by
    intro M
    rw [Matrix.reindex_apply, Matrix.reindex_apply]
    exact (Matrix.submatrix_map F.subtype
      (finSumFinEquiv (m := 3) (n := 3)).symm
      (finSumFinEquiv (m := 3) (n := 3)).symm M).symm
  have hTm_inv_map : ((((T : GL (Fin 6) F)⁻¹ : GL (Fin 6) F) :
      Matrix (Fin 6) (Fin 6) F)).map F.subtype =
      ((((T : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F)).map F.subtype)⁻¹ := by
    have hmul0 : ((T : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) *
        (((T : GL (Fin 6) F)⁻¹ : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) = 1 := by
      rw [← Matrix.GeneralLinearGroup.coe_mul, mul_inv_cancel,
        Matrix.GeneralLinearGroup.coe_one]
    have hmul : ((((T : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F)).map F.subtype) *
        (((((T : GL (Fin 6) F)⁻¹ : GL (Fin 6) F) :
          Matrix (Fin 6) (Fin 6) F)).map F.subtype) = 1 := by
      rw [← Matrix.map_mul, hmul0]
      exact Matrix.map_one F.subtype (map_zero F.subtype) (map_one F.subtype)
    exact (Matrix.inv_eq_right_inv hmul).symm
  have hpos : (((Tm : Matrix (Fin 6) (Fin 6) F)).map F.subtype)⁻¹ *
        ((jm : Matrix (Fin 6) (Fin 6) F)).map F.subtype *
        ((Tm : Matrix (Fin 6) (Fin 6) F)).map F.subtype =
      Matrix.reindex (finSumFinEquiv (m := 3) (n := 3))
        (finSumFinEquiv (m := 3) (n := 3))
        (Matrix.fromBlocks (((Pm : Matrix (Fin 3) (Fin 3) F)).map F.subtype)
          (0 : Matrix (Fin 3) (Fin 3) Ω) (0 : Matrix (Fin 3) (Fin 3) Ω)
          (1 : Matrix (Fin 3) (Fin 3) Ω)) := by
    have h := congrArg (fun M : Matrix (Fin 6) (Fin 6) F => M.map F.subtype) (hT P)
    rw [hmap_reindex] at h
    rw [Matrix.fromBlocks_map] at h
    simp only [Matrix.map_mul, Matrix.map_zero, map_zero, Matrix.map_one, map_one,
      hTm_inv_map] at h
    simpa [Tm, jm, Pm] using h
  have hs6eq : TΩ⁻¹ * s6 * TΩ =
      e6BlockSL3 Ω (statedSUToSL F 3 (2 ^ f) s) := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
      CFSG.RankThree.Classical2.coe_inv_eq_nonsing_inv, hTΩcoe, hs6coe,
      CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.coe_e6BlockSL3_reindex,
      hP3coe]
    exact hpos
  have hconj : (ψ S * ψ TΩ)⁻¹ * (ψ S * ψ s6 * (ψ S)⁻¹) * (ψ S * ψ TΩ) =
      ψ (TΩ⁻¹ * s6 * TΩ) := by
    rw [map_mul, map_mul, map_inv]
    group
  dsimp only [ιT, Φ3, C]
  change (MulAut.conj (ψ S * ψ TΩ)⁻¹)
      (ι ((Φ6 (jS s) : ↥L) : H)) =
    (e6FirstBlockRealize (CharP.cast_eq_zero Ω 2))
      (statedSUToSL F 3 (2 ^ f) s)
  rw [MulAut.conj_apply, hΦ6 (jS s)]
  simp only [inv_inv]
  calc
    (ψ S * ψ TΩ)⁻¹ * (ψ S * ψ s6 * (ψ S)⁻¹) * (ψ S * ψ TΩ)
        = ψ (TΩ⁻¹ * s6 * TΩ) := hconj
    _ = ψ (e6BlockSL3 Ω (statedSUToSL F 3 (2 ^ f) s)) := by rw [hs6eq]
    _ = (e6FirstBlockRealize (CharP.cast_eq_zero Ω 2))
        (statedSUToSL F 3 (2 ^ f) s) := rfl

theorem e6IdentityFormFrobenius_conj_inv_statedSUToSL_position
    {Ω : Type} [Field Ω] [IsAlgClosed Ω] [CharP Ω 2]
    {F : Subfield Ω} {f : ℕ}
    (hF : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F)
    (hFmem : ∀ c : Ω, c ∈ F ↔ c ^ ((2 ^ f) ^ 2) = c)
    (hFcard : Nat.card F = (2 ^ f) ^ 2)
    (σQ : Ω ≃+* Ω) (hσQ : ∀ c, σQ c = c ^ 2 ^ f)
    {J6 : SL(6, Ω)}
    (hJ6 : (J6 : Matrix (Fin 6) (Fin 6) Ω) = E6GraphLevi.antiId Ω)
    {dθ : ModGL Tag.E6 Ω} (hdθ : dθ ∈ (E6GraphLevi.thetaSL2 Ω).range)
    (T : CFSG.ClassicalGroups.UnitaryFlag.gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6))
    {g : ModGL Tag.E6 Ω}
    (hg : e6IdentityFormFrobenius (CharP.cast_eq_zero Ω 2) σQ J6 dθ g = g) :
    let ψ : SL(6, Ω) →* ModGL Tag.E6 Ω := E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
    let TΩ : SL(6, Ω) :=
      statedSUToSL F 6 (2 ^ f)
        ((CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
          (C₀ := (1 : GL (Fin 6) F)) rfl) T)
    e6IdentityFormFrobenius (CharP.cast_eq_zero Ω 2) σQ J6 dθ
        ((ψ TΩ)⁻¹ * g * ψ TΩ) = (ψ TΩ)⁻¹ * g * ψ TΩ := by
  classical
  let ψ : SL(6, Ω) →* ModGL Tag.E6 Ω := E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
  let TΩ : SL(6, Ω) :=
    statedSUToSL F 6 (2 ^ f)
      ((CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
        (C₀ := (1 : GL (Fin 6) F)) rfl) T)
  change e6IdentityFormFrobenius (CharP.cast_eq_zero Ω 2) σQ J6 dθ
      ((ψ TΩ)⁻¹ * g * ψ TΩ) = (ψ TΩ)⁻¹ * g * ψ TΩ
  have hmem : TΩ ∈ (statedSUToSL F 6 (2 ^ f)).range := ⟨_, rfl⟩
  have hunitary : Matrix.SpecialLinearGroup.toGL TΩ ∈
      CFSG.RankThree.Classical2.unitarySet (2 ^ f) 6 :=
    (CFSG.RankThree.Classical2.mem_range_statedSUToSL_iff Nat.prime_two F hFmem hFcard
      (by norm_num : 1 ≤ 6) TΩ).1 hmem
  have hfixSU : TΩ ∈ CFSG.RankThree.Classical2.fixSubgroup
      (stdUnitaryEquiv (ν := 6) σQ) :=
    (CFSG.HardMathSupport.Timmesfeld.CrossChar.mem_fixSubgroup_stdUnitaryEquiv_iff
      σQ hσQ TΩ).2 hunitary
  have hfixT : e6IdentityFormFrobenius (CharP.cast_eq_zero Ω 2) σQ J6 dθ
      (ψ TΩ) = ψ TΩ := by
    rw [CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.e6IdentityFormFrobenius_realize
      (CharP.cast_eq_zero Ω 2) σQ hJ6 hdθ TΩ]
    rw [(CFSG.RankThree.Classical2.mem_fixSubgroup
      (stdUnitaryEquiv (ν := 6) σQ)).1 hfixSU]
  rw [map_mul, map_mul, map_inv, hfixT, hg]

theorem exists_thetaTorusHom_of_mem_centralizer_su6Levi
    {f : ℕ} (hf2 : 2 ≤ f) {k F Ω : Type} [Field k] [Field F] [Field Ω] [CharP Ω 2]
    [Algebra k F] (hk : Nat.card k = 2 ^ f) (hFcard : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) (bc : F →+* Ω)
    {rF : ModGL TwistTag.E6.tag F}
    (hrF : rF ∈ twistedE6RootGroup F σ)
    (hrD : ∀ y : ModGL TwistTag.E6.tag F,
      y ∈ su6Levi σ.toRingHom → rF * y = y * rF)
    {n : ModGL TwistTag.E6.tag Ω} (hn : n ∈ (thetaSL2 Ω).range)
    {ζ : Ωˣ} (hζ : orderOf ζ = 3)
    (hcomm : Commute (n⁻¹ * baseChangeGL bc rF * n) (thetaTorusHom Ω ζ)) :
    ∃ t : Ωˣ, n⁻¹ * baseChangeGL bc rF * n = thetaTorusHom Ω t ∧
      (rF ^ 3 = 1 → t ^ 3 = 1) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Finite F := Nat.finite_of_card_ne_zero (by rw [hFcard]; positivity)
  haveI : CharP F 2 :=
    CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := f) hFcard
  have hF2 : (2 : F) = 0 := CharP.cast_eq_zero F 2
  have h2Ω : (2 : Ω) = 0 := CharP.cast_eq_zero Ω 2
  have hmem : rF ∈ thetaRankOneGroup (algebraMap k F) := by
    rw [← CFSG.SeitzReduction.TwistedE6Pilot.centralizer_su6Levi_inf_eq
      (f := f) (k := k) (K := F) hf2 hk hFcard (σ := σ.toRingHom) hσ]
    exact Subgroup.mem_inf.2
      ⟨Subgroup.mem_centralizer_iff.2 fun y hy => (hrD y hy).symm, hrF⟩
  have hmemRange : rF ∈
      ((thetaSL2 F).comp (Matrix.SpecialLinearGroup.map (algebraMap k F))).range := by
    simpa only [thetaRankOneGroup_eq_range hF2 (algebraMap k F)] using hmem
  obtain ⟨A, hA⟩ := hmemRange
  obtain ⟨N, rfl⟩ := hn
  let C : SL2 Ω := Matrix.SpecialLinearGroup.map bc
    (Matrix.SpecialLinearGroup.map (algebraMap k F) A)
  have hbase : baseChangeGL bc rF = thetaSL2 Ω C := by
    rw [← hA]
    simpa [C, thetaSL2] using
      CFSG.RankThree.Chevalley.baseChangeGL_rootSL2_of_field bc
        e6HighestRoot (Matrix.SpecialLinearGroup.map (algebraMap k F) A)
  let C' : SL2 Ω := N⁻¹ * C * N
  have hP : (thetaSL2 Ω N)⁻¹ * baseChangeGL bc rF * thetaSL2 Ω N = thetaSL2 Ω C' := by
    rw [hbase]
    simp only [C', map_mul, map_inv]
  have hcomm' : Commute (thetaSL2 Ω C') (thetaTorusHom Ω ζ) := by
    simpa [hP] using hcomm
  have hHSL : HSL ζ * C' = C' * HSL ζ := by
    refine thetaSL2_injective h2Ω ?_
    calc thetaSL2 Ω (HSL ζ * C')
        = thetaSL2 Ω (HSL ζ) * thetaSL2 Ω C' := map_mul (thetaSL2 Ω) _ _
      _ = thetaTorusHom Ω ζ * thetaSL2 Ω C' := by rw [thetaTorusHom_eq_thetaSL2]
      _ = thetaSL2 Ω C' * thetaTorusHom Ω ζ := hcomm'.eq.symm
      _ = thetaSL2 Ω C' * thetaSL2 Ω (HSL ζ) := by rw [thetaTorusHom_eq_thetaSL2]
      _ = thetaSL2 Ω (C' * HSL ζ) := (map_mul (thetaSL2 Ω) _ _).symm
  have hζ2 : ζ ^ 2 ≠ 1 := by
    intro h
    have hdiv : orderOf ζ ∣ 2 := orderOf_dvd_of_pow_eq_one h
    rw [hζ] at hdiv
    norm_num at hdiv
  obtain ⟨t, ht⟩ :=
    CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.eq_HSL_of_commute_HSL hζ2 hHSL
  refine ⟨t, ?_, ?_⟩
  · rw [hP, ht, thetaTorusHom_eq_thetaSL2]
  · intro hr3
    have hb3 : (baseChangeGL bc rF) ^ 3 = 1 := by
      rw [← map_pow, hr3, map_one]
    have hP3 : ((thetaSL2 Ω N)⁻¹ * baseChangeGL bc rF * thetaSL2 Ω N) ^ 3 = 1 := by
      have h := conj_pow (a := (thetaSL2 Ω N)⁻¹) (b := baseChangeGL bc rF) (i := 3)
      rw [hb3] at h
      simpa [inv_inv] using h
    have hC'3 : C' ^ 3 = 1 := by
      apply thetaSL2_injective h2Ω
      rw [map_pow, map_one, ← hP]
      exact hP3
    have hHSL3 : (HSL t) ^ 3 = 1 := by
      rw [← ht]
      exact hC'3
    apply CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.HSLHom_injective (K := Ω)
    rw [map_pow, map_one]
    simpa [CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.HSLHom_apply] using hHSL3

theorem exists_corootResidualTorus_of_original_data {Ω : Type} [Field Ω] [CharP Ω 2]
    {f : ℕ} (hf2 : 2 ≤ f) {F : Subfield Ω}
    (hFcard : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    {k : Type} [Field k] [Algebra k F] (hk : Nat.card k = 2 ^ f)
    {H : Type} [Group H] {ι₀ : H →* ModGL TwistTag.E6.tag F}
    (hrange : ι₀.range = twistedE6RootGroup F σ)
    {L : Subgroup H} {x : H} {c : twistedE6InndiagGL F σ}
    (hL : L.map ((MulAut.conj (c : ModGL TwistTag.E6.tag F)).toMonoidHom.comp ι₀) =
      su6Levi σ.toRingHom)
    {n : ModGL TwistTag.E6.tag Ω} (hn : n ∈ (thetaSL2 Ω).range)
    {S : SL(6, Ω)} {ζ : Ωˣ} (hζ : orderOf ζ = 3)
    (hxI : ((MulAut.conj n⁻¹).toMonoidHom.comp
        ((baseChangeGL F.subtype).comp
          ((MulAut.conj (c : ModGL TwistTag.E6.tag F)).toMonoidHom.comp ι₀))) x
      = thetaTorusHom Ω ζ)
    {d ell : H} (hell : ell ∈ L) (hd3 : d ^ 3 = 1) (hell3 : ell ^ 3 = 1)
    (hact : ∀ y ∈ L, d * y * d⁻¹ = ell * y * ell⁻¹)
    (hdx : d * x = x * d) (hxL : ∀ y ∈ L, x * y = y * x)
    {B : SL(6, Ω)}
    (hcover : ((MulAut.conj n⁻¹).toMonoidHom.comp
        ((baseChangeGL F.subtype).comp
          ((MulAut.conj (c : ModGL TwistTag.E6.tag F)).toMonoidHom.comp ι₀))) ell
      = realize (CharP.cast_eq_zero Ω 2) S * realize (CharP.cast_eq_zero Ω 2) B *
          (realize (CharP.cast_eq_zero Ω 2) S)⁻¹) :
    let ι : H →* ModGL TwistTag.E6.tag Ω :=
      (MulAut.conj n⁻¹).toMonoidHom.comp
        ((baseChangeGL F.subtype).comp
          ((MulAut.conj (c : ModGL TwistTag.E6.tag F)).toMonoidHom.comp ι₀))
    let ψS : ModGL TwistTag.E6.tag Ω := realize (CharP.cast_eq_zero Ω 2) S
    let ιW : H →* ModGL TwistTag.E6.tag Ω := (MulAut.conj ψS⁻¹).toMonoidHom.comp ι
    ∃ t : Ωˣ, t ^ 3 = 1 ∧ ιW (d * ell⁻¹) = thetaTorusHom Ω t ∧
      ιW d = thetaTorusHom Ω t * realize (CharP.cast_eq_zero Ω 2) B := by
  classical
  have h2Ω : (2 : Ω) = 0 := CharP.cast_eq_zero Ω 2
  let j : H →* ModGL TwistTag.E6.tag F :=
    (MulAut.conj (c : ModGL TwistTag.E6.tag F)).toMonoidHom.comp ι₀
  let b : ModGL TwistTag.E6.tag F →* ModGL TwistTag.E6.tag Ω := baseChangeGL F.subtype
  let ι : H →* ModGL TwistTag.E6.tag Ω := (MulAut.conj n⁻¹).toMonoidHom.comp (b.comp j)
  let ψS : ModGL TwistTag.E6.tag Ω := realize h2Ω S
  let ιW : H →* ModGL TwistTag.E6.tag Ω := (MulAut.conj ψS⁻¹).toMonoidHom.comp ι
  let r : H := d * ell⁻¹
  let rF : ModGL TwistTag.E6.tag F := j r
  have hι_apply : ∀ h : H, ι h = n⁻¹ * b (j h) * n := by
    intro h
    simp [ι, MulAut.conj_apply, inv_inv]
  have hιW_apply : ∀ h : H, ιW h = ψS⁻¹ * ι h * ψS := by
    intro h
    simp [ιW, MulAut.conj_apply, inv_inv]
  have hxI' : n⁻¹ * b (j x) * n = thetaTorusHom Ω ζ := by
    rw [← hι_apply x]
    simpa only [ι, b, j] using hxI
  have hcov' : n⁻¹ * b (j ell) * n = ψS * realize h2Ω B * ψS⁻¹ := by
    rw [← hι_apply ell]
    simpa only [ι, b, j, ψS, h2Ω] using hcover
  have hdell : d * ell = ell * d := by
    have h := hact ell hell
    rw [show ell * ell * ell⁻¹ = ell by group] at h
    calc d * ell = (d * ell * d⁻¹) * d := by group
      _ = ell * d := by rw [h]
  have hr3 : r ^ 3 = 1 := by
    have hcomm : Commute d ell := hdell
    calc r ^ 3 = (d * ell⁻¹) ^ 3 := rfl
      _ = d ^ 3 * (ell⁻¹) ^ 3 := hcomm.inv_right.mul_pow 3
      _ = 1 := by rw [hd3, inv_pow, hell3, inv_one, mul_one]
  have hrcent : ∀ y ∈ L, r * y = y * r := by
    intro y hy
    have hy' : ell⁻¹ * y * ell ∈ L :=
      L.mul_mem (L.mul_mem (L.inv_mem hell) hy) hell
    have h' : d * (ell⁻¹ * y * ell) = y * d := by
      have h2 : d * (ell⁻¹ * y * ell) * d⁻¹ = y := by
        rw [hact (ell⁻¹ * y * ell) hy']
        group
      calc d * (ell⁻¹ * y * ell) = (d * (ell⁻¹ * y * ell) * d⁻¹) * d := by group
        _ = y * d := by rw [h2]
    calc r * y = d * (ell⁻¹ * y * ell) * ell⁻¹ := by
          simp only [r]
          group
      _ = (y * d) * ell⁻¹ := by rw [h']
      _ = y * r := by
          simp only [r]
          group
  have hxr : Commute r x := by
    have hxd : Commute x d := hdx.symm
    have hxe : Commute x ell := hxL ell hell
    exact (hxd.mul_right hxe.inv_right).symm
  have hroot : ι₀ r ∈ twistedE6RootGroup F σ := by
    rw [← hrange]
    exact ⟨r, rfl⟩
  have hrFmem : rF ∈ twistedE6RootGroup F σ := by
    have h := (twistedE6InndiagConj F σ c ⟨ι₀ r, hroot⟩).2
    simpa [rF, j, MulAut.conj_apply, twistedE6InndiagConj_apply] using h
  have hrFcent : ∀ y : ModGL TwistTag.E6.tag F,
      y ∈ su6Levi σ.toRingHom → rF * y = y * rF := by
    intro y hy
    obtain ⟨l, hl, rfl⟩ := (Subgroup.mem_map).1 (by rw [hL]; exact hy)
    simpa only [rF, map_mul] using congrArg j (hrcent l hl)
  have hcommcore : Commute (n⁻¹ * b rF * n) (thetaTorusHom Ω ζ) := by
    have h := ((hxr.map j).map b).map (MulAut.conj n⁻¹).toMonoidHom
    have h' : Commute (n⁻¹ * b (j r) * n) (n⁻¹ * b (j x) * n) := by
      simpa [MulAut.conj_apply, inv_inv] using h
    rw [hxI'] at h'
    simpa [rF] using h'
  have hrF3 : rF ^ 3 = 1 := by
    simpa only [rF, map_pow, map_one] using congrArg j hr3
  obtain ⟨t, ht, ht3⟩ :=
    exists_thetaTorusHom_of_mem_centralizer_su6Levi (f := f) (k := k) (F := F) (Ω := Ω)
      hf2 hk hFcard hσ F.subtype hrFmem hrFcent hn hζ hcommcore
  have ht3' : t ^ 3 = 1 := ht3 hrF3
  have hψS_mem : ψS ∈ subsystemGroup TwistTag.E6.tag Ω setA := by
    rw [← range_realize h2Ω]
    exact ⟨S, rfl⟩
  have hcentθ : ψS ∈ Subgroup.centralizer ((thetaSL2 Ω).range : Set _) :=
    subsystemGroup_le_centralizer_thetaSL2 h2Ω hψS_mem
  have hHmem : thetaTorusHom Ω t ∈ (thetaSL2 Ω).range := by
    rw [thetaTorusHom_eq_thetaSL2]
    exact ⟨HSL t, rfl⟩
  have hcommψ : Commute (thetaTorusHom Ω t) ψS :=
    Subgroup.mem_centralizer_iff.1 hcentθ _ hHmem
  have ht' : n⁻¹ * b (j r) * n = thetaTorusHom Ω t := by
    simpa only [rF] using ht
  have hιWr : ιW r = thetaTorusHom Ω t := by
    calc ιW r = ψS⁻¹ * ι r * ψS := hιW_apply r
      _ = ψS⁻¹ * (n⁻¹ * b (j r) * n) * ψS := by rw [hι_apply r]
      _ = ψS⁻¹ * thetaTorusHom Ω t * ψS := by rw [ht']
      _ = thetaTorusHom Ω t := by
          calc ψS⁻¹ * thetaTorusHom Ω t * ψS
              = ψS⁻¹ * (thetaTorusHom Ω t * ψS) := by group
            _ = ψS⁻¹ * (ψS * thetaTorusHom Ω t) := by rw [hcommψ.eq]
            _ = thetaTorusHom Ω t := by group
  have hιWell : ιW ell = realize h2Ω B := by
    calc ιW ell = ψS⁻¹ * ι ell * ψS := hιW_apply ell
      _ = ψS⁻¹ * (n⁻¹ * b (j ell) * n) * ψS := by rw [hι_apply ell]
      _ = ψS⁻¹ * (ψS * realize h2Ω B * ψS⁻¹) * ψS := by rw [hcov']
      _ = realize h2Ω B := by group
  refine ⟨t, ht3', hιWr, ?_⟩
  calc ιW d = ιW (r * ell) := by rw [show d = r * ell by simp only [r]; group]
    _ = ιW r * ιW ell := by rw [map_mul]
    _ = thetaTorusHom Ω t * realize h2Ω B := by rw [hιWr, hιWell]
theorem conj_rootDiagUnit_cubic_original_e
    {Ω : Type} [Field Ω] {H : Type} [Group H]
    (h2 : (2 : Ω) = 0) {ιW : H →* ModGL TwistTag.E6.tag Ω}
    {x d e : H} {ζ t c dval : Ωˣ} {B T : SL(6, Ω)} {i j : ℕ}
    (hx : ιW x = thetaTorusHom Ω ζ)
    (hd : ιW d = thetaTorusHom Ω t * realize h2 B)
    (he : e = x ^ i * d ^ j)
    (hmat : (((T⁻¹ * B * T : SL(6, Ω)) : Matrix (Fin 6) (Fin 6) Ω)) =
      Matrix.diagonal fun k => ((![c, c, c, dval, dval, dval] : Fin 6 → Ωˣ) k : Ω))
    (hζ3 : ζ ^ 3 = 1) (ht3 : t ^ 3 = 1) (hc3 : c ^ 3 = 1) (hdval3 : dval ^ 3 = 1) :
    let ιT : H →* ModGL TwistTag.E6.tag Ω :=
      (MulAut.conj (realize h2 T)⁻¹).toMonoidHom.comp ιW
    ιT x = thetaTorusHom Ω ζ ∧
      ιT d = thetaTorusHom Ω t * realize h2 (T⁻¹ * B * T) ∧
      ιT e = rootDiagUnit TwistTag.E6.tag ![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] ∧
      (ζ ^ i * t ^ j) ^ 3 = 1 ∧
      ((c / dval) ^ j) ^ 3 = 1 := by
  classical
  let ψT : ModGL TwistTag.E6.tag Ω := realize h2 T
  let D : ModGL TwistTag.E6.tag Ω := realize h2 (T⁻¹ * B * T)
  let ιT : H →* ModGL TwistTag.E6.tag Ω :=
    (MulAut.conj ψT⁻¹).toMonoidHom.comp ιW
  have hιT_apply : ∀ h : H, ιT h = ψT⁻¹ * ιW h * ψT := by
    intro h
    simp [ιT, ψT, MulAut.conj_apply, inv_inv]
  have hψT_mem : ψT ∈ subsystemGroup TwistTag.E6.tag Ω setA := by
    rw [show ψT = realize h2 T from rfl, ← range_realize h2]
    exact ⟨T, rfl⟩
  have hcentψT : ψT ∈ Subgroup.centralizer ((thetaSL2 Ω).range : Set _) :=
    subsystemGroup_le_centralizer_thetaSL2 (E := Ω) h2 hψT_mem
  have hζmem : thetaTorusHom Ω ζ ∈ (thetaSL2 Ω).range := by
    rw [thetaTorusHom_eq_thetaSL2]
    exact ⟨HSL ζ, rfl⟩
  have htmem : thetaTorusHom Ω t ∈ (thetaSL2 Ω).range := by
    rw [thetaTorusHom_eq_thetaSL2]
    exact ⟨HSL t, rfl⟩
  have hcommψζ : Commute (thetaTorusHom Ω ζ) ψT :=
    Subgroup.mem_centralizer_iff.1 hcentψT _ hζmem
  have hcommψt : Commute (thetaTorusHom Ω t) ψT :=
    Subgroup.mem_centralizer_iff.1 hcentψT _ htmem
  have hζT : ψT⁻¹ * thetaTorusHom Ω ζ * ψT = thetaTorusHom Ω ζ := by
    calc ψT⁻¹ * thetaTorusHom Ω ζ * ψT
        = ψT⁻¹ * (thetaTorusHom Ω ζ * ψT) := by group
      _ = ψT⁻¹ * (ψT * thetaTorusHom Ω ζ) := by rw [hcommψζ.eq]
      _ = thetaTorusHom Ω ζ := by group
  have htT : ψT⁻¹ * thetaTorusHom Ω t * ψT = thetaTorusHom Ω t := by
    calc ψT⁻¹ * thetaTorusHom Ω t * ψT
        = ψT⁻¹ * (thetaTorusHom Ω t * ψT) := by group
      _ = ψT⁻¹ * (ψT * thetaTorusHom Ω t) := by rw [hcommψt.eq]
      _ = thetaTorusHom Ω t := by group
  have hD_mem : D ∈ subsystemGroup TwistTag.E6.tag Ω setA := by
    rw [show D = realize h2 (T⁻¹ * B * T) from rfl, ← range_realize h2]
    exact ⟨T⁻¹ * B * T, rfl⟩
  have hcentD : D ∈ Subgroup.centralizer ((thetaSL2 Ω).range : Set _) :=
    subsystemGroup_le_centralizer_thetaSL2 (E := Ω) h2 hD_mem
  have hcommDt : Commute (thetaTorusHom Ω t) D :=
    Subgroup.mem_centralizer_iff.1 hcentD _ htmem
  have hxT : ιT x = thetaTorusHom Ω ζ := by
    calc ιT x = ψT⁻¹ * ιW x * ψT := hιT_apply x
      _ = ψT⁻¹ * thetaTorusHom Ω ζ * ψT := by rw [hx]
      _ = thetaTorusHom Ω ζ := hζT
  have hreal : ψT⁻¹ * realize h2 B * ψT = D := by
    dsimp only [ψT, D]
    calc (realize h2 T)⁻¹ * realize h2 B * realize h2 T
        = realize h2 T⁻¹ * realize h2 B * realize h2 T := by rw [← map_inv]
      _ = realize h2 (T⁻¹ * B) * realize h2 T := by rw [← map_mul]
      _ = realize h2 (T⁻¹ * B * T) := by rw [← map_mul]
  have hdT : ιT d = thetaTorusHom Ω t * D := by
    calc ιT d = ψT⁻¹ * ιW d * ψT := hιT_apply d
      _ = ψT⁻¹ * (thetaTorusHom Ω t * realize h2 B) * ψT := by rw [hd]
      _ = (ψT⁻¹ * thetaTorusHom Ω t * ψT) * (ψT⁻¹ * realize h2 B * ψT) := by group
      _ = thetaTorusHom Ω t * D := by rw [htT, hreal]
  have hdiag : D = rootDiagUnit TwistTag.E6.tag ![1, 1, 1, c / dval, 1, 1] := by
    dsimp only [D]
    simpa only [TwistTag.tag] using
      (CFSG.LocalAnalysis.GLTheoremA.Y10F.ExcTwE6.realize_diagonal_eq_rootDiagUnit_cubic
        h2 (T⁻¹ * B * T) c dval hmat hc3 hdval3)
  let χ : Fin TwistTag.E6.tag.rank → Ωˣ :=
    Pi.mulSingle (3 : Fin TwistTag.E6.tag.rank) (c / dval)
  have hdiagχ : D = rootDiagUnit TwistTag.E6.tag χ := by
    rw [hdiag]
    congr 1
    funext k
    fin_cases k <;> simp [χ, Pi.mulSingle_apply] <;> rfl
  have hDpow_aux : ∀ n : ℕ, D ^ n = rootDiagUnit TwistTag.E6.tag (χ ^ n) := by
    intro n
    induction n with
    | zero => rw [pow_zero, pow_zero, rootDiagUnit_one]
    | succ n ih =>
        rw [pow_succ, ih, hdiagχ, ← rootDiagUnit_mul (τ := TwistTag.E6.tag), ← pow_succ]
  have hDpow : D ^ j = rootDiagUnit TwistTag.E6.tag (χ ^ j) := hDpow_aux j
  have hχpow : χ ^ j =
      (Pi.mulSingle (3 : Fin TwistTag.E6.tag.rank) ((c / dval) ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) := by
    simpa [χ] using (Pi.mulSingle_pow (f := fun _ : Fin TwistTag.E6.tag.rank => Ωˣ)
      (3 : Fin TwistTag.E6.tag.rank) (c / dval) j).symm
  have hspike :
      (Pi.mulSingle (1 : Fin TwistTag.E6.tag.rank) (ζ ^ i * t ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) *
      (Pi.mulSingle (3 : Fin TwistTag.E6.tag.rank) ((c / dval) ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) =
      (![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] :
        Fin TwistTag.E6.tag.rank → Ωˣ) := by
    funext k
    change (Pi.mulSingle (1 : Fin TwistTag.E6.tag.rank) (ζ ^ i * t ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) k *
      (Pi.mulSingle (3 : Fin TwistTag.E6.tag.rank) ((c / dval) ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) k =
      (![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] :
        Fin TwistTag.E6.tag.rank → Ωˣ) k
    rw [Pi.mulSingle_apply, Pi.mulSingle_apply]
    fin_cases k <;> simp [Fin.ext_iff] <;> rfl
  have htheta_eq : thetaTorusHom Ω (ζ ^ i * t ^ j) =
      rootDiagUnit TwistTag.E6.tag
        (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag (ζ ^ i * t ^ j)) := by
    rfl
  have hhigh : CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag (ζ ^ i * t ^ j) * χ ^ j =
      (![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] :
        Fin TwistTag.E6.tag.rank → Ωˣ) := by
    rw [hχpow]
    change (Pi.mulSingle (1 : Fin TwistTag.E6.tag.rank) (ζ ^ i * t ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) *
      (Pi.mulSingle (3 : Fin TwistTag.E6.tag.rank) ((c / dval) ^ j) :
        Fin TwistTag.E6.tag.rank → Ωˣ) =
      (![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] :
        Fin TwistTag.E6.tag.rank → Ωˣ)
    exact hspike
  have hιTe : ιT e =
      rootDiagUnit TwistTag.E6.tag
        (![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] :
          Fin TwistTag.E6.tag.rank → Ωˣ) := by
    calc
      ιT e = ιT (x ^ i * d ^ j) := by rw [he]
      _ = ιT (x ^ i) * ιT (d ^ j) := by rw [map_mul]
      _ = (thetaTorusHom Ω ζ) ^ i * (thetaTorusHom Ω t * D) ^ j := by
            rw [map_pow, map_pow, hxT, hdT]
      _ = (thetaTorusHom Ω ζ) ^ i *
            ((thetaTorusHom Ω t) ^ j * D ^ j) := by
            rw [hcommDt.mul_pow j]
      _ = (thetaTorusHom Ω ζ ^ i * (thetaTorusHom Ω t) ^ j) * D ^ j := by group
      _ = thetaTorusHom Ω (ζ ^ i * t ^ j) * D ^ j := by
            rw [← map_pow, ← map_pow, ← map_mul]
      _ = rootDiagUnit TwistTag.E6.tag
            (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag (ζ ^ i * t ^ j)) * D ^ j := by
            rw [htheta_eq]
      _ = rootDiagUnit TwistTag.E6.tag
            (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag (ζ ^ i * t ^ j)) *
            rootDiagUnit TwistTag.E6.tag (χ ^ j) := by rw [hDpow]
      _ = rootDiagUnit TwistTag.E6.tag
            (CFSG.SeitzReduction.EPilot.highDiag TwistTag.E6.tag (ζ ^ i * t ^ j) * χ ^ j) := by
            rw [← rootDiagUnit_mul]
      _ = rootDiagUnit TwistTag.E6.tag
            ![1, ζ ^ i * t ^ j, 1, (c / dval) ^ j, 1, 1] := by rw [hhigh]
  have hζi3 : (ζ ^ i) ^ 3 = 1 := by
    rw [← pow_mul, Nat.mul_comm i 3, pow_mul, hζ3, one_pow]
  have htj3 : (t ^ j) ^ 3 = 1 := by
    rw [← pow_mul, Nat.mul_comm j 3, pow_mul, ht3, one_pow]
  have ha3 : (ζ ^ i * t ^ j) ^ 3 = 1 := by
    rw [(Commute.all (ζ ^ i) (t ^ j)).mul_pow 3, hζi3, htj3, one_mul]
  have hb3 : (c / dval) ^ 3 = 1 := by
    rw [div_pow, hc3, hdval3, div_one]
  have hbj3 : ((c / dval) ^ j) ^ 3 = 1 := by
    rw [← pow_mul, Nat.mul_comm j 3, pow_mul, hb3, one_pow]
  exact ⟨hxT, hdT, hιTe, ha3, hbj3⟩

open CFSG.LieType.Universal CFSG.ClassicalGroups.UnitaryFlag
open CFSG.StandardType.S2MathFi1035Pos

private lemma suEquiv_symm_coe {E F : Type} [Field E] [Finite E] [CharP E 2] {f : ℕ}
    [Field F] [Finite F] [CharP F 2] (hF : Nat.card F = (2 ^ f) ^ 2)
    (τ : E ≃+* F) {n : ℕ} (P : GL (Fin n) E)
    (hP : CFSG.LieType.Universal.Unitary.conjTr
      (CFSG.LieType.BorelTits.unitaryInvolution E 2 f) (P : Matrix (Fin n) (Fin n) E) *
      (P : Matrix (Fin n) (Fin n) E) = CFSG.LieType.Universal.Unitary.antidiag n)
    (v : LargeEvenSUGroup (Fin n) F (2 ^ f)) :
    ((((CFSG.StandardType.MpStdSU.suEquiv (f := f) hF τ P hP).symm
        v : CFSG.LieType.Universal.Unitary.SU
          (CFSG.LieType.BorelTits.unitaryInvolution E 2 f) n) : GL (Fin n) E) :
      Matrix (Fin n) (Fin n) E) =
      ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) *
        (((v : GL (Fin n) F) : Matrix (Fin n) (Fin n) F).map τ.symm) *
        ((P : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) := by
  set e := CFSG.StandardType.MpStdSU.suEquiv (f := f) hF τ P hP
  have hcoe := congrArg (fun w : GL (Fin n) F => ((w : Matrix (Fin n) (Fin n) F)))
    (CFSG.StandardType.MpStdSU.coe_suEquiv (f := f) hF τ P hP (e.symm v))
  rw [e.apply_symm_apply, CFSG.StandardType.MpStdSU.coe_glMap] at hcoe
  have hu : (CFSG.StandardType.MpStdSU.glMap τ)
      (P * (e.symm v : GL (Fin n) E) * P⁻¹) = (v : GL (Fin n) F) := by
    apply Units.ext
    rw [CFSG.StandardType.MpStdSU.coe_glMap]
    exact hcoe.symm
  have hA : (e.symm v : GL (Fin n) E) =
      P⁻¹ * ((CFSG.StandardType.MpStdSU.glMap τ).symm (v : GL (Fin n) F)) * P := by
    rw [← hu, (CFSG.StandardType.MpStdSU.glMap τ).symm_apply_apply]
    group
  calc
    ((((e.symm v : CFSG.LieType.Universal.Unitary.SU
        (CFSG.LieType.BorelTits.unitaryInvolution E 2 f) n) : GL (Fin n) E)) :
        Matrix (Fin n) (Fin n) E)
        = (((P⁻¹ * ((CFSG.StandardType.MpStdSU.glMap τ).symm (v : GL (Fin n) F)) * P :
            GL (Fin n) E)) : Matrix (Fin n) (Fin n) E) := by
          exact congrArg (fun w : GL (Fin n) E => ((w : Matrix (Fin n) (Fin n) E))) hA
    _ = ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) *
          (((v : GL (Fin n) F) : Matrix (Fin n) (Fin n) F).map τ.symm) *
          ((P : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) := by
          rw [Units.val_mul, Units.val_mul, CFSG.StandardType.MpStdSU.coe_glMap_symm]

private lemma witt_inv_gram {E : Type} [Field E] {σ : E ≃+* E} {n : ℕ}
    (P : GL (Fin n) E)
    (hP : CFSG.LieType.Universal.Unitary.conjTr σ (P : Matrix (Fin n) (Fin n) E) *
      (P : Matrix (Fin n) (Fin n) E) = CFSG.LieType.Universal.Unitary.antidiag n) :
    Matrix.transpose ((((P⁻¹ : GL (Fin n) E)) : Matrix (Fin n) (Fin n) E).map σ) *
      CFSG.LieType.Universal.Unitary.antidiag n *
      (((P⁻¹ : GL (Fin n) E)) : Matrix (Fin n) (Fin n) E) = 1 := by
  have hPPi : (P : Matrix (Fin n) (Fin n) E) *
      (((P⁻¹ : GL (Fin n) E)) : Matrix (Fin n) (Fin n) E) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hPu : Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) *
      (P : Matrix (Fin n) (Fin n) E) = CFSG.LieType.Universal.Unitary.antidiag n := hP
  calc
    Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) *
        CFSG.LieType.Universal.Unitary.antidiag n * (↑(P⁻¹) : Matrix (Fin n) (Fin n) E)
        = Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) *
            (Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) *
              (P : Matrix (Fin n) (Fin n) E)) *
            (↑(P⁻¹) : Matrix (Fin n) (Fin n) E) := by rw [hPu]
    _ = (Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) *
          Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ)) *
          ((P : Matrix (Fin n) (Fin n) E) * (↑(P⁻¹) : Matrix (Fin n) (Fin n) E)) := by
          simp only [Matrix.mul_assoc]
    _ = Matrix.transpose (((P : Matrix (Fin n) (Fin n) E).map σ) *
          ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) * 1 := by
          rw [Matrix.transpose_mul, hPPi]
    _ = Matrix.transpose (((P : Matrix (Fin n) (Fin n) E) *
          (↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) := by
          rw [← Matrix.map_mul, Matrix.mul_one]
    _ = 1 := by rw [hPPi]; simp

private lemma witt_inv_adj {E : Type} [Field E] {σ : E ≃+* E} {n : ℕ}
    (P : GL (Fin n) E)
    (hP : CFSG.LieType.Universal.Unitary.conjTr σ (P : Matrix (Fin n) (Fin n) E) *
      (P : Matrix (Fin n) (Fin n) E) = CFSG.LieType.Universal.Unitary.antidiag n)
    {e : Matrix (Fin n) (Fin n) E}
    (he : Matrix.transpose (e.map σ) = e) :
    Matrix.transpose (((((P⁻¹ : GL (Fin n) E)) : Matrix (Fin n) (Fin n) E) * e *
      (P : Matrix (Fin n) (Fin n) E)).map σ) *
      CFSG.LieType.Universal.Unitary.antidiag n =
      CFSG.LieType.Universal.Unitary.antidiag n *
        ((((P⁻¹ : GL (Fin n) E)) : Matrix (Fin n) (Fin n) E) * e *
          (P : Matrix (Fin n) (Fin n) E)) := by
  have hPPi : (P : Matrix (Fin n) (Fin n) E) *
      (((P⁻¹ : GL (Fin n) E)) : Matrix (Fin n) (Fin n) E) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hPiP : ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)) * (P : Matrix (Fin n) (Fin n) E) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hJ : CFSG.LieType.Universal.Unitary.antidiag n =
      Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) *
        (P : Matrix (Fin n) (Fin n) E) := hP.symm
  have hPdag : Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) =
      CFSG.LieType.Universal.Unitary.antidiag n * (↑(P⁻¹) : Matrix (Fin n) (Fin n) E) := by
    rw [hJ]
    simp only [Matrix.mul_assoc, hPPi, Matrix.mul_one]
  have hPidag : Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) *
      CFSG.LieType.Universal.Unitary.antidiag n = (P : Matrix (Fin n) (Fin n) E) := by
    rw [hJ, ← Matrix.mul_assoc, ← Matrix.transpose_mul, ← Matrix.map_mul, hPPi,
      Matrix.map_one _ (map_zero σ) (map_one σ), Matrix.transpose_one, Matrix.one_mul]
  calc
    Matrix.transpose (((((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)) * e *
        (P : Matrix (Fin n) (Fin n) E)).map σ)) *
        CFSG.LieType.Universal.Unitary.antidiag n
        = (Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) *
            Matrix.transpose (e.map σ) *
            Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ)) *
            CFSG.LieType.Universal.Unitary.antidiag n := by
          simp only [Matrix.map_mul, Matrix.transpose_mul, Matrix.mul_assoc]
    _ = (Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) * e *
          Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ)) *
          CFSG.LieType.Universal.Unitary.antidiag n := by rw [he]
    _ = Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) * e *
          (Matrix.transpose (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)).map σ) *
            CFSG.LieType.Universal.Unitary.antidiag n) := by
          simp only [Matrix.mul_assoc]
    _ = Matrix.transpose ((P : Matrix (Fin n) (Fin n) E).map σ) * e *
          (P : Matrix (Fin n) (Fin n) E) := by rw [hPidag]
    _ = (CFSG.LieType.Universal.Unitary.antidiag n * (↑(P⁻¹) : Matrix (Fin n) (Fin n) E)) * e *
          (P : Matrix (Fin n) (Fin n) E) := by rw [hPdag]
    _ = CFSG.LieType.Universal.Unitary.antidiag n *
          (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E)) * e *
            (P : Matrix (Fin n) (Fin n) E)) := by
          simp only [Matrix.mul_assoc]

private lemma block_conj_formula {E : Type} [Field E] {n r : ℕ}
    (P : GL (Fin n) E) (Q : GL (Fin r) E)
    (U : Matrix (Fin n) (Fin r) E) (D : Matrix (Fin r) (Fin n) E)
    (e : Matrix (Fin n) (Fin n) E) (M : Matrix (Fin r) (Fin r) E) :
    (((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) *
        (U * (((Q : Matrix (Fin r) (Fin r) E)) * M *
            ((Q⁻¹ : GL (Fin r) E) : Matrix (Fin r) (Fin r) E)) * D + (1 - e)) *
        (P : Matrix (Fin n) (Fin n) E)) =
      ((((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) * U *
          (Q : Matrix (Fin r) (Fin r) E)) * M *
        (((Q⁻¹ : GL (Fin r) E) : Matrix (Fin r) (Fin r) E) * D *
          (P : Matrix (Fin n) (Fin n) E))) +
      (1 - (((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) * e *
        (P : Matrix (Fin n) (Fin n) E))) := by
  have hPP : ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) *
      (P : Matrix (Fin n) (Fin n) E) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hsub : ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) * (1 - e) *
      (P : Matrix (Fin n) (Fin n) E) =
      ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) * (P : Matrix (Fin n) (Fin n) E) -
        ((P⁻¹ : GL (Fin n) E) : Matrix (Fin n) (Fin n) E) * e *
          (P : Matrix (Fin n) (Fin n) E) := by
    rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one]
  calc
    ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) *
        (U * ((Q : Matrix (Fin r) (Fin r) E) * M * (↑(Q⁻¹) : Matrix (Fin r) (Fin r) E)) * D +
          (1 - e)) * (P : Matrix (Fin n) (Fin n) E))
        = ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) *
              (U * ((Q : Matrix (Fin r) (Fin r) E) * M * (↑(Q⁻¹) : Matrix (Fin r) (Fin r) E)) * D)) *
            (P : Matrix (Fin n) (Fin n) E) +
            ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) * (1 - e)) *
              (P : Matrix (Fin n) (Fin n) E) := by
          rw [Matrix.mul_add, Matrix.add_mul]
    _ = ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) *
              (U * ((Q : Matrix (Fin r) (Fin r) E) * M * (↑(Q⁻¹) : Matrix (Fin r) (Fin r) E)) * D)) *
            (P : Matrix (Fin n) (Fin n) E) +
            (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) * (P : Matrix (Fin n) (Fin n) E)) -
              (↑(P⁻¹) : Matrix (Fin n) (Fin n) E) * e *
                (P : Matrix (Fin n) (Fin n) E)) := by
          rw [hsub]
    _ = ((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) *
              (U * ((Q : Matrix (Fin r) (Fin r) E) * M * (↑(Q⁻¹) : Matrix (Fin r) (Fin r) E)) * D)) *
            (P : Matrix (Fin n) (Fin n) E) +
            (1 - (↑(P⁻¹) : Matrix (Fin n) (Fin n) E) * e *
              (P : Matrix (Fin n) (Fin n) E)) := by
          rw [hPP]
    _ = (((↑(P⁻¹) : Matrix (Fin n) (Fin n) E) * U * (Q : Matrix (Fin r) (Fin r) E)) * M *
              ((↑(Q⁻¹) : Matrix (Fin r) (Fin r) E) * D * (P : Matrix (Fin n) (Fin n) E))) +
            (1 - (↑(P⁻¹) : Matrix (Fin n) (Fin n) E) * e *
              (P : Matrix (Fin n) (Fin n) E)) := by
          congr 1
          simp only [Matrix.mul_assoc]

private lemma naturalSU3_block_iota
    {E F : Type} [Field E] [Finite E] [CharP E 2] {f : ℕ}
    (hE : Nat.card E = (2 ^ f) ^ 2)
    [Field F] [Finite F] [CharP F 2] (hFcard : Nat.card F = (2 ^ f) ^ 2)
    (hF : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F)
    (τ : E ≃+* F)
    {U : Matrix (Fin 6) (Fin 3) F} {D : Matrix (Fin 3) (Fin 6) F}
    {ε : Matrix (Fin 6) (Fin 6) F}
    (hD : D = Matrix.transpose (U.map hF.bar))
    (hDU : D * U = 1) (hUD : U * D = ε)
    (hε : Matrix.transpose (ε.map hF.bar) = ε)
    {j : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) →*
      gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)}
    (hformula : ∀ P : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3),
      (((j P : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) :
          GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) =
        U * ((P : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) * D + (1 - ε))
    (P3 : GL (Fin 3) E) (hP3 : CFSG.LieType.Universal.Unitary.conjTr
      (CFSG.LieType.BorelTits.unitaryInvolution E 2 f) (P3 : Matrix (Fin 3) (Fin 3) E) *
      (P3 : Matrix (Fin 3) (Fin 3) E) = CFSG.LieType.Universal.Unitary.antidiag 3)
    (P6 : GL (Fin 6) E) (hP6 : CFSG.LieType.Universal.Unitary.conjTr
      (CFSG.LieType.BorelTits.unitaryInvolution E 2 f) (P6 : Matrix (Fin 6) (Fin 6) E) *
      (P6 : Matrix (Fin 6) (Fin 6) E) = CFSG.LieType.Universal.Unitary.antidiag 6) :
    let σ : E ≃+* E := CFSG.LieType.BorelTits.unitaryInvolution E 2 f
    let E3 : CFSG.LieType.Universal.Unitary.SU σ 3 ≃* StatedSU 3 (2 ^ f) F :=
      CFSG.StandardType.MpStdSU.suEquiv (f := f) hFcard τ P3 hP3
    let E6 : CFSG.LieType.Universal.Unitary.SU σ 6 ≃* StatedSU 6 (2 ^ f) F :=
      CFSG.StandardType.MpStdSU.suEquiv (f := f) hFcard τ P6 hP6
    let κ3 : StatedSU 3 (2 ^ f) F ≃* gramSU hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) :=
      (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
        (C₀ := (1 : GL (Fin 3) F)) rfl).symm
    let κ6 : StatedSU 6 (2 ^ f) F ≃* gramSU hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
      (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
        (C₀ := (1 : GL (Fin 6) F)) rfl).symm
    let jS : StatedSU 3 (2 ^ f) F →* StatedSU 6 (2 ^ f) F :=
      κ6.symm.toMonoidHom.comp (j.comp κ3.toMonoidHom)
    let iota : CFSG.LieType.Universal.Unitary.SU σ 3 →*
        CFSG.LieType.Universal.Unitary.SU σ 6 :=
      E6.symm.toMonoidHom.comp (jS.comp E3.toMonoidHom)
    ∃ (Uad : Matrix (Fin 6) (Fin 3) E) (Dad : Matrix (Fin 3) (Fin 6) E)
      (ead : Matrix (Fin 6) (Fin 6) E),
      (∀ x : CFSG.LieType.Universal.Unitary.SU σ 3,
        ((((iota x : CFSG.LieType.Universal.Unitary.SU σ 6) : GL (Fin 6) E)) :
          Matrix (Fin 6) (Fin 6) E) =
          Uad * (((x : GL (Fin 3) E)) : Matrix (Fin 3) (Fin 3) E) * Dad + (1 - ead)) ∧
      Uad * Dad = ead ∧ Dad * Uad = 1 ∧
      ((Matrix.transpose (Matrix.map Uad σ) : Matrix (Fin 3) (Fin 6) E) *
          (CFSG.LieType.Universal.Unitary.antidiag 6 : Matrix (Fin 6) (Fin 6) E) *
          (Uad : Matrix (Fin 6) (Fin 3) E) : Matrix (Fin 3) (Fin 3) E) =
        CFSG.LieType.Universal.Unitary.antidiag 3 ∧
      Matrix.transpose (Matrix.map ead σ) * CFSG.LieType.Universal.Unitary.antidiag 6 =
        CFSG.LieType.Universal.Unitary.antidiag 6 * ead := by
  classical
  let σ : E ≃+* E := CFSG.LieType.BorelTits.unitaryInvolution E 2 f
  let E3 : CFSG.LieType.Universal.Unitary.SU σ 3 ≃* StatedSU 3 (2 ^ f) F :=
    CFSG.StandardType.MpStdSU.suEquiv (f := f) hFcard τ P3 hP3
  let E6 : CFSG.LieType.Universal.Unitary.SU σ 6 ≃* StatedSU 6 (2 ^ f) F :=
    CFSG.StandardType.MpStdSU.suEquiv (f := f) hFcard τ P6 hP6
  let κ3 : StatedSU 3 (2 ^ f) F ≃* gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) :=
    (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
      (C₀ := (1 : GL (Fin 3) F)) rfl).symm
  let κ6 : StatedSU 6 (2 ^ f) F ≃* gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
      (C₀ := (1 : GL (Fin 6) F)) rfl).symm
  let jS : StatedSU 3 (2 ^ f) F →* StatedSU 6 (2 ^ f) F :=
    κ6.symm.toMonoidHom.comp (j.comp κ3.toMonoidHom)
  let iota : CFSG.LieType.Universal.Unitary.SU σ 3 →*
      CFSG.LieType.Universal.Unitary.SU σ 6 :=
    E6.symm.toMonoidHom.comp (jS.comp E3.toMonoidHom)
  let U0 : Matrix (Fin 6) (Fin 3) E := U.map τ.symm
  let D0 : Matrix (Fin 3) (Fin 6) E := D.map τ.symm
  let ε0 : Matrix (Fin 6) (Fin 6) E := ε.map τ.symm
  let P3m : Matrix (Fin 3) (Fin 3) E := (P3 : Matrix (Fin 3) (Fin 3) E)
  let P3i : Matrix (Fin 3) (Fin 3) E := (((P3⁻¹ : GL (Fin 3) E)) : Matrix (Fin 3) (Fin 3) E)
  let P6m : Matrix (Fin 6) (Fin 6) E := (P6 : Matrix (Fin 6) (Fin 6) E)
  let P6i : Matrix (Fin 6) (Fin 6) E := (((P6⁻¹ : GL (Fin 6) E)) : Matrix (Fin 6) (Fin 6) E)
  let Uad : Matrix (Fin 6) (Fin 3) E := P6i * U0 * P3m
  let Dad : Matrix (Fin 3) (Fin 6) E := P3i * D0 * P6m
  let ead : Matrix (Fin 6) (Fin 6) E := P6i * ε0 * P6m
  have hbar : ∀ x : F, hF.bar x = CFSG.LieType.BorelTits.unitaryInvolution F 2 f x := by
    intro x
    rw [hF.bar_apply, CFSG.LieType.BorelTits.unitaryInvolution_apply]
  have hsig : ∀ x : F, τ.symm (hF.bar x) = σ (τ.symm x) := by
    intro x
    apply τ.injective
    rw [τ.apply_symm_apply, hbar x,
      CFSG.StandardType.MpStdSU.unitaryInvolution_map τ (τ.symm x), τ.apply_symm_apply]
  have hpattern : (⇑σ ∘ ⇑τ.symm) = (⇑τ.symm ∘ ⇑hF.bar) := by
    funext x
    exact (hsig x).symm
  have hD0 : Matrix.transpose (Matrix.map U0 σ) = D0 := by
    rw [show U0 = U.map τ.symm from rfl, show D0 = D.map τ.symm from rfl, hD]
    rw [Matrix.transpose_map, Matrix.map_map, Matrix.map_map, hpattern]
  have hU0D0 : U0 * D0 = ε0 := by
    rw [show U0 = U.map τ.symm from rfl, show D0 = D.map τ.symm from rfl,
      show ε0 = ε.map τ.symm from rfl, ← Matrix.map_mul, hUD]
  have hD0U0 : D0 * U0 = 1 := by
    rw [show D0 = D.map τ.symm from rfl, show U0 = U.map τ.symm from rfl,
      ← Matrix.map_mul, hDU, Matrix.map_one _ (map_zero τ.symm) (map_one τ.symm)]
  have hε0 : Matrix.transpose (Matrix.map ε0 σ) = ε0 := by
    rw [show ε0 = ε.map τ.symm from rfl, Matrix.map_map, hpattern, ← Matrix.map_map,
      ← Matrix.transpose_map, hε]
  have hP3PPi : P3m * P3i = 1 := by
    rw [show P3m = (P3 : Matrix (Fin 3) (Fin 3) E) from rfl,
      show P3i = ((P3⁻¹ : GL (Fin 3) E) : Matrix (Fin 3) (Fin 3) E) from rfl,
      ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hP3iP3 : P3i * P3m = 1 := by
    rw [show P3i = ((P3⁻¹ : GL (Fin 3) E) : Matrix (Fin 3) (Fin 3) E) from rfl,
      show P3m = (P3 : Matrix (Fin 3) (Fin 3) E) from rfl,
      ← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hP6PPi : P6m * P6i = 1 := by
    rw [show P6m = (P6 : Matrix (Fin 6) (Fin 6) E) from rfl,
      show P6i = ((P6⁻¹ : GL (Fin 6) E) : Matrix (Fin 6) (Fin 6) E) from rfl,
      ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hUadDad : Uad * Dad = ead := by
    rw [show Uad = P6i * U0 * P3m from rfl, show Dad = P3i * D0 * P6m from rfl,
      show ead = P6i * ε0 * P6m from rfl]
    rw [Matrix.mul_assoc (P6i * U0) P3m (P3i * D0 * P6m)]
    rw [← Matrix.mul_assoc P3m (P3i * D0) P6m]
    rw [← Matrix.mul_assoc P3m P3i D0]
    rw [hP3PPi, Matrix.one_mul]
    rw [← Matrix.mul_assoc (P6i * U0) D0 P6m]
    rw [Matrix.mul_assoc P6i U0 D0]
    rw [hU0D0]
  have hDadUad : Dad * Uad = 1 := by
    rw [show Uad = P6i * U0 * P3m from rfl, show Dad = P3i * D0 * P6m from rfl]
    rw [Matrix.mul_assoc (P3i * D0) P6m (P6i * U0 * P3m)]
    rw [← Matrix.mul_assoc P6m (P6i * U0) P3m]
    rw [← Matrix.mul_assoc P6m P6i U0]
    rw [hP6PPi, Matrix.one_mul]
    rw [Matrix.mul_assoc P3i D0 (U0 * P3m)]
    rw [← Matrix.mul_assoc D0 U0 P3m]
    rw [hD0U0, Matrix.one_mul, hP3iP3]
  have hAad : (Matrix.transpose (Matrix.map Uad σ) : Matrix (Fin 3) (Fin 6) E) *
      (CFSG.LieType.Universal.Unitary.antidiag 6 : Matrix (Fin 6) (Fin 6) E) *
      (Uad : Matrix (Fin 6) (Fin 3) E) =
      CFSG.LieType.Universal.Unitary.antidiag 3 := by
    have hP6i : Matrix.transpose (Matrix.map P6i σ) *
        CFSG.LieType.Universal.Unitary.antidiag 6 * P6i = 1 :=
      witt_inv_gram P6 hP6
    have hP3u : Matrix.transpose (Matrix.map P3m σ) * P3m =
        CFSG.LieType.Universal.Unitary.antidiag 3 := hP3
    rw [show Uad = P6i * U0 * P3m from rfl]
    rw [Matrix.map_mul, Matrix.map_mul, Matrix.transpose_mul, Matrix.transpose_mul, hD0]
    simp only [Matrix.mul_assoc]
    rw [← Matrix.mul_assoc (Matrix.transpose (Matrix.map P6i σ))
      (CFSG.LieType.Universal.Unitary.antidiag 6) (P6i * (U0 * P3m))]
    rw [← Matrix.mul_assoc (Matrix.transpose (Matrix.map P6i σ) *
      CFSG.LieType.Universal.Unitary.antidiag 6) P6i (U0 * P3m)]
    rw [hP6i, Matrix.one_mul]
    rw [← Matrix.mul_assoc D0 U0 P3m]
    rw [hD0U0, Matrix.one_mul, hP3u]
  have hadjEad : Matrix.transpose (Matrix.map ead σ) *
      (CFSG.LieType.Universal.Unitary.antidiag 6 : Matrix (Fin 6) (Fin 6) E) =
      (CFSG.LieType.Universal.Unitary.antidiag 6 : Matrix (Fin 6) (Fin 6) E) * ead := by
    rw [show ead = P6i * ε0 * P6m from rfl]
    exact witt_inv_adj P6 hP6 hε0
  have hE3coe : ∀ x : CFSG.LieType.Universal.Unitary.SU σ 3,
      ((((E3 x : StatedSU 3 (2 ^ f) F) : GL (Fin 3) F)) : Matrix (Fin 3) (Fin 3) F) =
        Matrix.map (P3m * (((x : GL (Fin 3) E)) : Matrix (Fin 3) (Fin 3) E) * P3i) τ := by
    intro x
    have h := congrArg (fun w : GL (Fin 3) F => ((w : Matrix (Fin 3) (Fin 3) F)))
      (CFSG.StandardType.MpStdSU.coe_suEquiv (f := f) hFcard τ P3 hP3 x)
    rw [CFSG.StandardType.MpStdSU.coe_glMap] at h
    convert h using 2
  have hE6inv : ∀ y : StatedSU 6 (2 ^ f) F,
      ((((E6.symm y : CFSG.LieType.Universal.Unitary.SU σ 6) : GL (Fin 6) E)) :
        Matrix (Fin 6) (Fin 6) E) =
        P6i * Matrix.map (((y : GL (Fin 6) F)) : Matrix (Fin 6) (Fin 6) F) τ.symm * P6m := by
    intro y
    dsimp only [E6, P6i, P6m]
    exact suEquiv_symm_coe hFcard τ P6 hP6 y
  have hκ3coe : ∀ x : CFSG.LieType.Universal.Unitary.SU σ 3,
      ((((κ3 (E3 x) : gramSU hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3)) : GL (Fin 3) F)) :
        Matrix (Fin 3) (Fin 3) F) =
      ((((E3 x : StatedSU 3 (2 ^ f) F) : GL (Fin 3) F)) : Matrix (Fin 3) (Fin 3) F) := by
    intro x
    rfl
  have hjs : ∀ x : CFSG.LieType.Universal.Unitary.SU σ 3,
      ((((jS (E3 x) : StatedSU 6 (2 ^ f) F) : GL (Fin 6) F)) :
        Matrix (Fin 6) (Fin 6) F) =
        U * ((((E3 x : StatedSU 3 (2 ^ f) F) : GL (Fin 3) F)) :
          Matrix (Fin 3) (Fin 3) F) * D + (1 - ε) := by
    intro x
    change (((j (κ3 (E3 x)) : gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) : GL (Fin 6) F) :
        Matrix (Fin 6) (Fin 6) F) = _
    rw [hformula (κ3 (E3 x)), hκ3coe x]
  have hmapdist : ∀ M : Matrix (Fin 3) (Fin 3) F,
      (Matrix.map (U * M * D + (1 - ε)) τ.symm) =
        U0 * (M.map τ.symm) * D0 + (1 - ε0) := by
    intro M
    rw [Matrix.map_add _ (map_add τ.symm), Matrix.map_mul, Matrix.map_mul,
      Matrix.map_sub _ (map_sub τ.symm),
      Matrix.map_one _ (map_zero τ.symm) (map_one τ.symm)]
  have hκ3map : ∀ x : CFSG.LieType.Universal.Unitary.SU σ 3,
      Matrix.map ((((κ3 (E3 x) : gramSU hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3)) : GL (Fin 3) F)) :
        Matrix (Fin 3) (Fin 3) F) τ.symm = P3m * (((x : GL (Fin 3) E)) :
          Matrix (Fin 3) (Fin 3) E) * P3i := by
    intro x
    rw [hκ3coe x, hE3coe x, Matrix.map_map]
    have hid : (⇑τ.symm ∘ ⇑τ) = id := by funext a; simp
    rw [hid, Matrix.map_id]
  have hι : ∀ x : CFSG.LieType.Universal.Unitary.SU σ 3,
      ((((iota x : CFSG.LieType.Universal.Unitary.SU σ 6) : GL (Fin 6) E)) :
        Matrix (Fin 6) (Fin 6) E) =
        Uad * (((x : GL (Fin 3) E)) : Matrix (Fin 3) (Fin 3) E) * Dad + (1 - ead) := by
    intro x
    calc
      ((((iota x : CFSG.LieType.Universal.Unitary.SU σ 6) : GL (Fin 6) E)) :
          Matrix (Fin 6) (Fin 6) E)
          = P6i * ((((jS (E3 x) : StatedSU 6 (2 ^ f) F) : GL (Fin 6) F)) :
              Matrix (Fin 6) (Fin 6) F).map τ.symm * P6m := hE6inv (jS (E3 x))
      _ = P6i * ((U * ((((κ3 (E3 x) : gramSU hF
              (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3)) : GL (Fin 3) F)) :
              Matrix (Fin 3) (Fin 3) F) * D + (1 - ε)).map τ.symm) * P6m := by
            rw [hjs x, hκ3coe x]
      _ = P6i * (U0 * (Matrix.map ((((κ3 (E3 x) : gramSU hF
              (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3)) : GL (Fin 3) F)) :
              Matrix (Fin 3) (Fin 3) F) τ.symm) * D0 + (1 - ε0)) * P6m := by
            rw [hmapdist]
      _ = P6i * (U0 * (P3m * (((x : GL (Fin 3) E)) : Matrix (Fin 3) (Fin 3) E) * P3i) * D0 +
            (1 - ε0)) * P6m := by rw [hκ3map x]
      _ = Uad * (((x : GL (Fin 3) E)) : Matrix (Fin 3) (Fin 3) E) * Dad + (1 - ead) :=
            block_conj_formula P6 P3 U0 D0 ε0 (((x : GL (Fin 3) E)) :
              Matrix (Fin 3) (Fin 3) E)
  dsimp only
  exact ⟨Uad, Dad, ead, hι, hUadDad, hDadUad, hAad, hadjEad⟩

lemma ggU_PSU_eq_unitary
    {f : ℕ} (hf : 1 ≤ f) (n : ℕ) :
    ggU .PSU n f =
      (⟨CFSG.LieType.Universal.Unitary.SU
          (CFSG.LieType.BorelTits.unitaryInvolution (GaloisField 2 (2 * f)) 2 f) n,
        CFSG.LieType.Universal.Unitary.rootDatum
          (CFSG.LieType.Universal.card_galoisField_two_mul 2 f hf) n⟩ : LieUniversal) := by
  simp only [ggU, lieUniversal, hf, ↓reduceDIte]

private lemma ggRootSub_cast {X : Type} [Group X] {M M' : LieUniversal} (h : M = M')
    (φ : M'.K →* X) (β : Fin M.D.rank → ℤ) (u : M.K) :
    ggRootSub M.D (φ.comp (MulEquiv.cast (M := fun M : LieUniversal => M.K) h).toMonoidHom) β u =
      ggRootSub M'.D φ (h ▸ β) (h ▸ u) := by
  cases h
  rfl

private lemma mem_roots_cast {M M' : LieUniversal} (h : M = M') {β : Fin M.D.rank → ℤ} :
    β ∈ M.D.roots ↔ (h ▸ β) ∈ M'.D.roots := by
  cases h
  rfl

private lemma longRoot_cast {M M' : LieUniversal} (h : M = M') {β : Fin M.D.rank → ℤ} :
    GGLongRoot M.D β ↔ GGLongRoot M'.D (h ▸ β) := by
  cases h
  rfl

private lemma neg_cast {M M' : LieUniversal} (h : M = M')
    (γ : Fin M'.D.rank → ℤ) :
    h.symm ▸ (-γ) = -(h.symm ▸ γ) := by
  cases h
  rfl

private lemma naturalSU3_cover_range_kernel
    {L : Type} [Group L] {F : Type} [Field F] {f : ℕ}
    (hF : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F)
    (hLperfect : Group.IsPerfect L)
    {Φ6 : StatedSU 6 (2 ^ f) F →* L}
    {θ : L ⧸ Subgroup.center L ≃*
      LargeEvenProj (LargeEvenSUGroup (Fin 6) F (2 ^ f))}
    (hθ : ∀ s, θ (QuotientGroup.mk (Φ6 s)) =
      LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) s) :
    Φ6.range = ⊤ ∧ Φ6.ker ≤ Subgroup.center (StatedSU 6 (2 ^ f) F) := by
  classical
  haveI : Finite F := hF.finite
  haveI : CharP F 2 := hF.charP
  have hFcard : Nat.card F = (2 ^ f) ^ 2 := hF.card_eq_sq
  let κ6 : StatedSU 6 (2 ^ f) F ≃* gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
      (C₀ := (1 : GL (Fin 6) F)) rfl).symm
  let q6 : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) →*
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    QuotientGroup.mk' (CFSG.ClassicalGroups.UnitaryFlag.normOneScalars hF
      (gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) 6)
  let π : L →* CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6))).toMonoidHom.comp
      (QuotientGroup.mk' (Subgroup.center L))
  have hπsurj : Function.Surjective π :=
    (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num
      : 1 ≤ 6))).surjective.comp (QuotientGroup.mk'_surjective _)
  have hπker : π.ker ≤ Subgroup.center L := by
    rw [show π = (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF
        (by norm_num : 1 ≤ 6))).toMonoidHom.comp
        (QuotientGroup.mk' (Subgroup.center L)) from rfl,
      MonoidHom.ker_comp_of_injective (QuotientGroup.mk' (Subgroup.center L))
        (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF
          (by norm_num : 1 ≤ 6))).toMonoidHom
        (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF
          (by norm_num : 1 ≤ 6))).injective,
      QuotientGroup.ker_mk']
  have hη : ∀ s : StatedSU 6 (2 ^ f) F, π (Φ6 s) = q6 (κ6 s) := by
    intro s
    change (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6)))
        (QuotientGroup.mk (Φ6 s)) = q6 (κ6 s)
    rw [MulEquiv.trans_apply, hθ s]
    let sH : LargeEvenSUGroup (Fin 6) F (2 ^ f) := s
    change CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6)
        (LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) sH) = q6 (κ6 s)
    rw [show LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) sH =
        (sH : LargeEvenProj (LargeEvenSUGroup (Fin 6) F (2 ^ f))) from rfl,
      CFSG.StandardType.InndiagSU.projEquiv_mk]
    refine congrArg (fun x : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) =>
      (x : CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF
        (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6))) (Subtype.ext rfl)
  have hPmap : Φ6.range.map π = ⊤ := by
    have hcomp : π.comp Φ6 = q6.comp κ6.toMonoidHom := MonoidHom.ext hη
    rw [show Φ6.range.map π = (π.comp Φ6).range from (MonoidHom.range_comp π Φ6).symm,
      hcomp, MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ κ6.surjective,
      ← MonoidHom.range_eq_map q6,
      MonoidHom.range_eq_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  have hPcomm : ⁅Φ6.range, Φ6.range⁆ = Φ6.range := by
    haveI : Group.IsPerfect ↥(Φ6.range) := by
      haveI : Group.IsPerfect (StatedSU 6 (2 ^ f) F) := by
        haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
        exact CFSG.ClassicalGroups.Unitary.isPerfect_statedSU (p := 2) (f := f) hFcard
          (by norm_num : 3 ≤ 6) (by intro h; have := congrArg Prod.fst h; norm_num at this)
      exact Group.IsPerfect.range (f := Φ6)
    exact Subgroup.commutator_eq_self
  have htopcomm : ⁅(⊤ : Subgroup L), (⊤ : Subgroup L)⁆ = (⊤ : Subgroup L) := by
    haveI : Group.IsPerfect L := hLperfect
    haveI : Group.IsPerfect ↥(⊤ : Subgroup L) :=
      Group.IsPerfect.ofSurjective (f := (Subgroup.topEquiv (G := L)).symm.toMonoidHom)
        (Subgroup.topEquiv (G := L)).symm.surjective
    exact Subgroup.commutator_eq_self
  have hrangeTop : Φ6.range = ⊤ := by
    refine eq_of_map_eq hπker hPcomm htopcomm ?_
    rw [hPmap, ← MonoidHom.range_eq_map π,
      MonoidHom.range_eq_top_of_surjective _ hπsurj]
  refine ⟨hrangeTop, ?_⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hkerproj : (LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f))).ker =
      (StatedScalars (Fin 6) F).subgroupOf (StatedSU 6 (2 ^ f) F) := by
    rw [LargeEvenProjMk, QuotientGroup.ker_mk']
    rfl
  intro s hs
  have hproj : LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) s = 1 := by
    have := (hθ s).symm
    simpa [MonoidHom.mem_ker.mp hs] using this
  have hmem : s ∈ (LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f))).ker :=
    MonoidHom.mem_ker.mpr hproj
  rw [hkerproj] at hmem
  exact CFSG.LieType.Universal.Unitary.statedScalars_subgroupOf_le_center 6 (2 ^ f) hmem

theorem naturalSU3_whole_pair_in_original_cover
    {X : Type} [Group X] {J L R Rm : Subgroup X}
    (hJ : CFSG.Assembly.IsQuasisimple ↥J) (hpos : GGRootPosJ J R Rm)
    (hJL : J ≤ L) (hLperfect : Group.IsPerfect ↥L)
    {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F)
    {Φ6 : StatedSU 6 (2 ^ f) F →* ↥L}
    {θ : ↥L ⧸ Subgroup.center ↥L ≃*
      LargeEvenProj (LargeEvenSUGroup (Fin 6) F (2 ^ f))}
    (hθ : ∀ s, θ (QuotientGroup.mk (Φ6 s)) =
      LargeEvenProjMk (LargeEvenSUGroup (Fin 6) F (2 ^ f)) s)
    {j : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) →*
      gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)}
    (hj : Function.Injective j)
    {U : Matrix (Fin 6) (Fin 3) F} {D : Matrix (Fin 3) (Fin 6) F}
    {ε : Matrix (Fin 6) (Fin 6) F}
    (hD : D = Matrix.transpose (U.map hF.bar))
    (hDU : D * U = 1) (hUD : U * D = ε)
    (hε : Matrix.transpose (ε.map hF.bar) = ε)
    (hformula : ∀ P : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3),
      (((j P : gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) :
        GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) =
        U * ((P : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) * D + (1 - ε))
    (hJP : j.range.map (QuotientGroup.mk' (CFSG.ClassicalGroups.UnitaryFlag.normOneScalars hF
        (gramSU hF (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6)) 6)) =
      (J.subgroupOf L).map ((θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF
        (by norm_num : 1 ≤ 6))).toMonoidHom.comp
          (QuotientGroup.mk' (Subgroup.center ↥L))))
    (hq3 : 3 ≤ 2 ^ f)
    (τ : GaloisField 2 (2 * f) ≃+* F)
    (P3 : GL (Fin 3) (GaloisField 2 (2 * f)))
    (hP3 : CFSG.LieType.Universal.Unitary.conjTr
      (CFSG.LieType.BorelTits.unitaryInvolution (GaloisField 2 (2 * f)) 2 f)
      (P3 : Matrix (Fin 3) (Fin 3) (GaloisField 2 (2 * f))) *
      (P3 : Matrix (Fin 3) (Fin 3) (GaloisField 2 (2 * f))) =
        CFSG.LieType.Universal.Unitary.antidiag 3)
    (P6 : GL (Fin 6) (GaloisField 2 (2 * f)))
    (hP6 : CFSG.LieType.Universal.Unitary.conjTr
      (CFSG.LieType.BorelTits.unitaryInvolution (GaloisField 2 (2 * f)) 2 f)
      (P6 : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) *
      (P6 : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) =
        CFSG.LieType.Universal.Unitary.antidiag 6) :
    ∃ (phiL : (ggU .PSU 6 f).K →* X),
      phiL = (L.subtype.comp (Φ6.comp
        (CFSG.StandardType.MpStdSU.suEquiv (f := f) (hF.card_eq_sq) τ P6 hP6).toMonoidHom)).comp
        (MulEquiv.cast (M := fun M : LieUniversal => M.K)
          (ggU_PSU_eq_unitary hF.one_le 6)).toMonoidHom ∧
      phiL.range = L ∧ phiL.ker ≤ Subgroup.center (ggU .PSU 6 f).K ∧
      ∃ (β : Fin (ggU .PSU 6 f).D.rank → ℤ) (r : (ggU .PSU 6 f).K),
        β ∈ (ggU .PSU 6 f).D.roots ∧ GGLongRoot (ggU .PSU 6 f).D β ∧
        R = ggRootSub (ggU .PSU 6 f).D phiL β r ∧
        Rm = ggRootSub (ggU .PSU 6 f).D phiL (-β) r := by
  classical
  have hFcard : Nat.card F = (2 ^ f) ^ 2 := hF.card_eq_sq
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let σ : GaloisField 2 (2 * f) ≃+* GaloisField 2 (2 * f) :=
    unitaryInvolution (GaloisField 2 (2 * f)) 2 f
  let hE : Nat.card (GaloisField 2 (2 * f)) = (2 ^ f) ^ 2 :=
    CFSG.LieType.Universal.card_galoisField_two_mul 2 f hF.one_le
  let M3 : LieUniversal :=
    ⟨CFSG.LieType.Universal.Unitary.SU
        (CFSG.LieType.BorelTits.unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 3,
      CFSG.LieType.Universal.Unitary.rootDatum hE 3⟩
  let M6 : LieUniversal :=
    ⟨CFSG.LieType.Universal.Unitary.SU
        (CFSG.LieType.BorelTits.unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6,
      CFSG.LieType.Universal.Unitary.rootDatum hE 6⟩
  have hM3 : ggU .PSU 3 f = M3 := by
    rw [ggU_PSU_eq_unitary hF.one_le 3]
  have hM6 : ggU .PSU 6 f = M6 := by
    rw [ggU_PSU_eq_unitary hF.one_le 6]
  let E3 : CFSG.LieType.Universal.Unitary.SU σ 3 ≃* StatedSU 3 (2 ^ f) F :=
    CFSG.StandardType.MpStdSU.suEquiv (f := f) hF.card_eq_sq τ P3 hP3
  let E6 : CFSG.LieType.Universal.Unitary.SU σ 6 ≃* StatedSU 6 (2 ^ f) F :=
    CFSG.StandardType.MpStdSU.suEquiv (f := f) hF.card_eq_sq τ P6 hP6
  let κ3 : StatedSU 3 (2 ^ f) F ≃* gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 3) :=
    (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
      (C₀ := (1 : GL (Fin 3) F)) rfl).symm
  let κ6 : StatedSU 6 (2 ^ f) F ≃* gramSU hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    (CFSG.SeitzReduction.SymplecticPilot.gramSUOneEquiv hF
      (C₀ := (1 : GL (Fin 6) F)) rfl).symm
  let jS : StatedSU 3 (2 ^ f) F →* StatedSU 6 (2 ^ f) F :=
    κ6.symm.toMonoidHom.comp (j.comp κ3.toMonoidHom)
  let iota : CFSG.LieType.Universal.Unitary.SU σ 3 →*
      CFSG.LieType.Universal.Unitary.SU σ 6 :=
    E6.symm.toMonoidHom.comp (jS.comp E3.toMonoidHom)
  let phiL₀ : CFSG.LieType.Universal.Unitary.SU σ 6 →* X :=
    L.subtype.comp (Φ6.comp E6.toMonoidHom)
  let phiJ₀ : CFSG.LieType.Universal.Unitary.SU σ 3 →* X := phiL₀.comp iota
  let e6 : (ggU .PSU 6 f).K ≃* CFSG.LieType.Universal.Unitary.SU σ 6 :=
    MulEquiv.cast (M := fun M : LieUniversal => M.K) hM6
  let phiL : (ggU .PSU 6 f).K →* X := phiL₀.comp e6.toMonoidHom
  obtain ⟨Uad, Dad, ead, hιform, hUadDad, hDadUad, hAad, hadjEad⟩ :=
    naturalSU3_block_iota hE hFcard hF τ hD hDU hUD hε hformula P3 hP3 P6 hP6
  obtain ⟨hPhi6range, hPhi6ker⟩ :=
    naturalSU3_cover_range_kernel hF hLperfect hθ
  have hphiL₀range : phiL₀.range = L := by
    change (L.subtype.comp (Φ6.comp E6.toMonoidHom)).range = L
    rw [MonoidHom.range_comp, MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ E6.surjective,
      ← MonoidHom.range_eq_map Φ6, hPhi6range,
      ← MonoidHom.range_eq_map (L.subtype), Subgroup.range_subtype]
  have hphiL₀ker : phiL₀.ker ≤ Subgroup.center (CFSG.LieType.Universal.Unitary.SU σ 6) := by
    change (L.subtype.comp (Φ6.comp E6.toMonoidHom)).ker ≤ _
    rw [MonoidHom.ker_comp_of_injective (Φ6.comp E6.toMonoidHom) L.subtype
      (Subgroup.subtype_injective L)]
    change Φ6.ker.comap E6.toMonoidHom ≤ _
    calc
      Φ6.ker.comap E6.toMonoidHom ≤
          (Subgroup.center (StatedSU 6 (2 ^ f) F)).comap E6.toMonoidHom :=
        Subgroup.comap_mono hPhi6ker
      _ ≤ Subgroup.center (CFSG.LieType.Universal.Unitary.SU σ 6) :=
        Subgroup.comap_center_le_center (f := E6.toMonoidHom) E6.injective
  have hphiLrange : phiL.range = L := by
    change (phiL₀.comp e6.toMonoidHom).range = L
    rw [MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ e6.surjective,
      ← MonoidHom.range_eq_map phiL₀, hphiL₀range]
  have hphiLker : phiL.ker ≤ Subgroup.center (ggU .PSU 6 f).K := by
    change (phiL₀.comp e6.toMonoidHom).ker ≤ _
    rw [← MonoidHom.comap_ker]
    calc
      phiL₀.ker.comap e6.toMonoidHom ≤
          (Subgroup.center (CFSG.LieType.Universal.Unitary.SU σ 6)).comap e6.toMonoidHom :=
        Subgroup.comap_mono hphiL₀ker
      _ ≤ Subgroup.center (ggU .PSU 6 f).K :=
        Subgroup.comap_center_le_center (f := e6.toMonoidHom) e6.injective
  have hJperfect : ⁅J.subgroupOf L, J.subgroupOf L⁆ = J.subgroupOf L := by
    haveI : Group.IsPerfect ↥J := Group.isPerfect_def.mpr hJ.1
    haveI : Group.IsPerfect ↥(J.subgroupOf L) :=
      Group.IsPerfect.ofSurjective
        (f := (Subgroup.subgroupOfEquivOfLe hJL).symm.toMonoidHom)
        (Subgroup.subgroupOfEquivOfLe hJL).symm.surjective
    exact Subgroup.commutator_eq_self
  let π : ↥L →* CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.primeFormP hF
      (CFSG.RankThree.PartOne.KCUnitaryModel.idGram F 6) :=
    (θ.trans (CFSG.StandardType.InndiagSU.projEquiv hF (by norm_num : 1 ≤ 6))).toMonoidHom.comp
      (QuotientGroup.mk' (Subgroup.center ↥L))
  have hnatural : (Φ6.comp jS).range = J.subgroupOf L :=
    naturalSU3_cover_range_eq_of_projective_eq hF (J := J.subgroupOf L)
      (Φ6 := Φ6) (θ := θ) hθ π rfl hJperfect hq3 (j := j) hJP
  have hphiJ₀eq : phiJ₀ = (L.subtype.comp (Φ6.comp jS)).comp E3.toMonoidHom := by
    ext x
    simp only [MonoidHom.comp_apply, phiJ₀, phiL₀, iota]
    change L.subtype (Φ6 (E6 (E6.symm (jS (E3 x))))) = L.subtype (Φ6 (jS (E3 x)))
    rw [E6.apply_symm_apply]
  have hphiJ₀range : phiJ₀.range = J := by
    rw [hphiJ₀eq, MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ E3.surjective,
      ← MonoidHom.range_eq_map (L.subtype.comp (Φ6.comp jS)),
      MonoidHom.range_comp, hnatural, Subgroup.map_subgroupOf_eq_of_le hJL]
  have hjs_inj : Function.Injective jS :=
    κ6.symm.injective.comp (hj.comp κ3.injective)
  have hi_inj : Function.Injective iota :=
    E6.symm.injective.comp (hjs_inj.comp E3.injective)
  have hphiJ₀ker : phiJ₀.ker ≤
      Subgroup.center (CFSG.LieType.Universal.Unitary.SU σ 3) := by
    change (phiL₀.comp iota).ker ≤ _
    rw [← MonoidHom.comap_ker]
    exact (Subgroup.comap_mono hphiL₀ker).trans
      (Subgroup.comap_center_le_center hi_inj)
  have hnorm : CFSG.StandardType.RCKRP.RCKNormalizedModel .PSU 3 f := by
    constructor
    · simp [GGPosTag]
    · refine ⟨Nat.prime_two, hF.one_le, by norm_num, ?_⟩
      intro h
      have h2 : 2 ^ f = 2 := congrArg Prod.snd h
      omega
  have hIRG := CFSG.StandardType.RCKRP.irg_classical_conjunct J R Rm hJ hpos
    .PSU 3 f
  rw [hM3] at hIRG
  obtain ⟨β3, u3, hβ3, hlong3, hR3, hRm3⟩ :=
    hIRG phiJ₀ hnorm hphiJ₀range hphiJ₀ker
  have hβ3' : β3 ∈ (CFSG.LieType.Universal.Unitary.rootDatum hE 3).roots := by
    change β3 ∈ (CFSG.LieType.Universal.Unitary.rootDatum hE 3).roots
    exact hβ3
  have hlong3' : GGLongRoot (CFSG.LieType.Universal.Unitary.rootDatum hE 3) β3 := by
    rcases hlong3 with h | h
    · change GGLongRoot (CFSG.LieType.Universal.Unitary.rootDatum hE 3) β3
      exact h
    · obtain ⟨hbad, -⟩ := h
      simp at hbad
  have hR3' : R = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 3) phiJ₀ β3 u3 := hR3
  have hRm3' : Rm = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 3) phiJ₀ (-β3) u3 := hRm3
  obtain ⟨γ, hγ, hlongγ, a, heqR, heqRm⟩ :=
    CFSG.StandardType.ClassicalPosition.exists_longRoot_pair_transport_of_unitary_block
      (F := GaloisField 2 (2 * f)) (f := f) (r := 3) (n := 6) hE (by norm_num)
      hUadDad hDadUad hAad hadjEad iota hιform hβ3' hlong3' u3
  let β : Fin (ggU .PSU 6 f).D.rank → ℤ := hM6.symm ▸ γ
  let r : (ggU .PSU 6 f).K := hM6.symm ▸ a
  have hγM : γ ∈ M6.D.roots := by
    change γ ∈ (CFSG.LieType.Universal.Unitary.rootDatum hE 6).roots
    exact hγ
  have hlongγM : GGLongRoot M6.D γ := by
    change GGLongRoot (CFSG.LieType.Universal.Unitary.rootDatum hE 6) γ
    exact hlongγ
  have hβ : β ∈ (ggU .PSU 6 f).D.roots := by
    dsimp only [β]
    exact (mem_roots_cast hM6.symm).mp hγM
  have hlong : GGLongRoot (ggU .PSU 6 f).D β := by
    dsimp only [β]
    exact (longRoot_cast hM6.symm).mp hlongγM
  have hRconcrete : R = ggRootSub
      (CFSG.LieType.Universal.Unitary.rootDatum hE 6) phiL₀ γ a := by
    calc
      R = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 3)
          phiJ₀ β3 u3 := hR3'
      _ = ((((CFSG.LieType.Universal.Unitary.rootDatum hE 3).rootGroup β3).map
            (MulAut.conj u3).toMonoidHom).map iota).map phiL₀ := by
        change (((CFSG.LieType.Universal.Unitary.rootDatum hE 3).rootGroup β3).map
          (MulAut.conj u3).toMonoidHom).map (phiL₀.comp iota) = _
        exact (Subgroup.map_map _ phiL₀ iota).symm
      _ = (((CFSG.LieType.Universal.Unitary.rootDatum hE 6).rootGroup γ).map
            (MulAut.conj a).toMonoidHom).map phiL₀ :=
        congrArg (fun H : Subgroup (CFSG.LieType.Universal.Unitary.SU σ 6) =>
          H.map phiL₀) heqR
      _ = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 6)
          phiL₀ γ a := rfl
  have hRmconcrete : Rm = ggRootSub
      (CFSG.LieType.Universal.Unitary.rootDatum hE 6) phiL₀ (-γ) a := by
    calc
      Rm = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 3)
          phiJ₀ (-β3) u3 := hRm3'
      _ = ((((CFSG.LieType.Universal.Unitary.rootDatum hE 3).rootGroup (-β3)).map
            (MulAut.conj u3).toMonoidHom).map iota).map phiL₀ := by
        change (((CFSG.LieType.Universal.Unitary.rootDatum hE 3).rootGroup (-β3)).map
          (MulAut.conj u3).toMonoidHom).map (phiL₀.comp iota) = _
        exact (Subgroup.map_map _ phiL₀ iota).symm
      _ = (((CFSG.LieType.Universal.Unitary.rootDatum hE 6).rootGroup (-γ)).map
            (MulAut.conj a).toMonoidHom).map phiL₀ :=
        congrArg (fun H : Subgroup (CFSG.LieType.Universal.Unitary.SU σ 6) =>
          H.map phiL₀) heqRm
      _ = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 6)
          phiL₀ (-γ) a := rfl
  have hRcanon : R = ggRootSub M6.D phiL₀ γ a := by
    change R = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 6) phiL₀ γ a
    exact hRconcrete
  have hRmcanon : Rm = ggRootSub M6.D phiL₀ (-γ) a := by
    change Rm = ggRootSub (CFSG.LieType.Universal.Unitary.rootDatum hE 6) phiL₀ (-γ) a
    exact hRmconcrete
  have hcast_symm : (MulEquiv.cast (M := fun M : LieUniversal => M.K) hM6.symm) =
      (MulEquiv.cast (M := fun M : LieUniversal => M.K) hM6).symm := by
    ext x
    simp [MulEquiv.cast_apply, MulEquiv.cast_symm_apply]
  have hphiLcomp : phiL.comp (MulEquiv.cast hM6.symm).toMonoidHom = phiL₀ := by
    rw [hcast_symm]
    change phiL₀.comp (e6.toMonoidHom.comp e6.symm.toMonoidHom) = phiL₀
    have hcomp : e6.toMonoidHom.comp e6.symm.toMonoidHom = MonoidHom.id _ := by
      apply MonoidHom.ext
      intro x
      exact e6.apply_symm_apply x
    rw [hcomp, MonoidHom.comp_id]
  have hcastR := ggRootSub_cast hM6.symm phiL γ a
  rw [hphiLcomp] at hcastR
  have hRout : R = ggRootSub (ggU .PSU 6 f).D phiL β r :=
    hRcanon.trans hcastR
  have hcastRm := ggRootSub_cast hM6.symm phiL (-γ) a
  rw [hphiLcomp] at hcastRm
  have hneg : hM6.symm ▸ (-γ) = -β := by
    dsimp only [β]
    exact neg_cast hM6 γ
  rw [hneg] at hcastRm
  have hRmout : Rm = ggRootSub (ggU .PSU 6 f).D phiL (-β) r :=
    hRmcanon.trans hcastRm
  exact ⟨phiL, rfl, hphiLrange, hphiLker, β, r, hβ, hlong, hRout, hRmout⟩
