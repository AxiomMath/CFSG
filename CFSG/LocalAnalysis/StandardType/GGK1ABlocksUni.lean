private theorem ggK1Abu_unitaryFieldData {nf : ℕ} (hnf : 1 ≤ nf) {K : Type} [Field K]
    (hK : Nat.card K = (2 ^ nf) ^ 2) : UnitaryFieldData 2 nf K :=
  ⟨Nat.prime_two, hnf, by rw [hK, ← pow_mul, mul_comm]⟩

private theorem ggK1Abu_glEnd_mul {N : ℕ} {K : Type} [Field K] (g g' : GL (Fin N) K) :
    ggK1A_glEnd (g * g') = ggK1A_glEnd g * ggK1A_glEnd g' := by
  unfold ggK1A_glEnd
  rw [Units.val_mul, Matrix.toLin'_mul]
  rfl

private theorem ggK1Abu_glEnd_one {N : ℕ} {K : Type} [Field K] :
    ggK1A_glEnd (1 : GL (Fin N) K) = 1 := by
  unfold ggK1A_glEnd
  rw [Units.val_one, Matrix.toLin'_one]
  rfl

private theorem ggK1Abu_glEnd_pow {N : ℕ} {K : Type} [Field K] (g : GL (Fin N) K) (n : ℕ) :
    ggK1A_glEnd (g ^ n) = (ggK1A_glEnd g) ^ n := by
  induction n with
  | zero => rw [pow_zero, pow_zero, ggK1Abu_glEnd_one]
  | succ n ih => rw [pow_succ, ggK1Abu_glEnd_mul, ih, pow_succ]

private theorem ggK1Abu_glEnd_pow_eq_one {p N : ℕ} {K : Type} [Field K]
    {g : GL (Fin N) K} (hg : g ^ p = 1) : (ggK1A_glEnd g) ^ p = 1 := by
  rw [← ggK1Abu_glEnd_pow, hg, ggK1Abu_glEnd_one]

private theorem ggK1Abu_dvd_X_pow_sub_one {p N : ℕ} {K : Type} [Field K]
    {g : GL (Fin N) K} (hg : g ^ p = 1) {a : K[X]}
    (ha : a ∈ primaryFactors (ggK1A_glEnd g)) : a ∣ X ^ p - 1 :=
  (mem_primaryFactors.mp ha).2.2.trans
    (minpoly.dvd K (ggK1A_glEnd g)
      (by rw [map_sub, map_pow, aeval_X, map_one, ggK1Abu_glEnd_pow_eq_one hg, sub_self]))

private noncomputable def ggK1Abu_iota (N nf : ℕ) (K : Type) [Field K] :
    ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)) →* LinearMap.GeneralLinearGroup K (Fin N → K) :=
  (Matrix.GeneralLinearGroup.toLin :
    GL (Fin N) K ≃* LinearMap.GeneralLinearGroup K (Fin N → K)).toMonoidHom.comp
      (LargeEvenSUGroup (Fin N) K (2 ^ nf)).subtype

private theorem ggK1Abu_iota_injective (N nf : ℕ) (K : Type) [Field K] :
    Function.Injective (ggK1Abu_iota N nf K) :=
  Matrix.GeneralLinearGroup.toLin.injective.comp Subtype.val_injective

private theorem ggK1Abu_iota_coe {N nf : ℕ} {K : Type} [Field K]
    (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) :
    ((ggK1Abu_iota N nf K xhat : LinearMap.GeneralLinearGroup K (Fin N → K)) :
      Module.End K (Fin N → K)) = ggK1A_glEnd xhat.1 := rfl

private theorem ggK1Abu_iota_mem_sesqSpecialUnitary {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K)
    (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) :
    ggK1Abu_iota N nf K xhat ∈ sesqSpecialUnitaryGroup (idForm h N) := by
  have heq : LargeEvenSUGroup (Fin N) K (2 ^ nf) =
      gramSU h ((1 : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) :=
    InndiagSU.largeEvenSUGroup_eq_gramSU (d := N) (n := nf) h
  have hx : (xhat : GL (Fin N) K) ∈
      gramSU h ((1 : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) := heq ▸ xhat.2
  have h1 := (toLin_mem_sesqSpecialUnitaryGroup_iff h
    ((1 : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) (xhat : GL (Fin N) K)).mpr hx
  simpa [ggK1Abu_iota, idForm, idGram] using h1

private theorem ggK1Abu_ringChar_two {nf : ℕ} {K : Type} [Field K] [Finite K]
    (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2) : ringChar K = 2 := by
  haveI : Fintype K := Fintype.ofFinite K
  rw [FiniteField.even_card_iff_char_two]
  rw [← Nat.card_eq_fintype_card, hK, pow_two]
  exact Nat.dvd_iff_mod_eq_zero.mp
    (dvd_mul_of_dvd_left (dvd_pow_self 2 (by omega : nf ≠ 0)) _)

private theorem ggK1Abu_hsq {p N nf : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1) :
    Squarefree (minpoly K (ggK1A_glEnd xhat.1)) := by
  have hchar : ringChar K = 2 := ggK1Abu_ringChar_two hnf hK
  have hpk : (p : K) ≠ 0 := by
    intro h0
    have hpdiv : ringChar K ∣ p := (CharP.cast_eq_zero_iff K (ringChar K) p).mp h0
    have hprime := CharP.prime_ringChar (R := K)
    have hring : ringChar K = p := (Nat.prime_dvd_prime_iff_eq hprime hp).mp hpdiv
    exact hp2 (hchar ▸ hring).symm
  have hval : xhat.1 ^ p = 1 := by
    have := congrArg Subtype.val hxp
    simpa using this
  refine squarefree_minpoly_of_aeval_eq_zero (p := X ^ p - C 1)
    (Polynomial.separable_X_pow_sub_C (1 : K) hpk one_ne_zero).squarefree ?_
  have hx : (ggK1A_glEnd xhat.1) ^ p = 1 := by
    rw [show ggK1A_glEnd xhat.1 =
      Matrix.toLin' (xhat.1 : Matrix (Fin N) (Fin N) K) from rfl,
      ← Matrix.toLin'_pow, ← Units.val_pow_eq_pow_val, hval]
    exact Matrix.toLin'_one
  rw [map_sub, map_pow, aeval_X, aeval_C, map_one, hx, sub_self]

private theorem ggK1Abu_primaryData {p N nf : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1) :
    UnitaryPrimaryData (ggK1Abu_unitaryFieldData hnf hK).bar
      (idForm (ggK1Abu_unitaryFieldData hnf hK) N) (ggK1Abu_iota N nf K xhat) :=
  ⟨(ggK1Abu_unitaryFieldData hnf hK).bar_bar, idForm_isSymm _ _,
    idForm_separatingLeft _ _, (ggK1Abu_iota_mem_sesqSpecialUnitary _ xhat).1,
    ggK1Abu_hsq hp hp2 hnf hK hxp⟩

private noncomputable def ggK1Abu_A {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) (a : K[X]) :
    Subgroup ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)) :=
  (specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a).comap (ggK1Abu_iota N nf K)

private noncomputable def ggK1Abu_kind {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) (a : K[X]) :
    ggK1ACo_Kind := by
  classical
  exact if dualPoly h.bar a = a then .su (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 1
    else .sl (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 2

private theorem ggK1Abu_A_le_centralizer {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) (a : K[X]) :
    ggK1Abu_A h xhat a ≤
      Subgroup.centralizer ({xhat} : Set ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) := by
  intro g hg
  rw [Subgroup.mem_centralizer_singleton_iff]
  have hgL : ggK1Abu_iota N nf K g ∈
      specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a := hg
  have hgC : ggK1Abu_iota N nf K g ∈ gl_centralizer (ggK1Abu_iota N nf K xhat) :=
    mem_gl_centralizer.mpr
      (mem_unitaryCentralizer.mp (specialBlock_le_unitaryCentralizer hgL)).2
  have hcommU : ggK1Abu_iota N nf K g * ggK1Abu_iota N nf K xhat =
      ggK1Abu_iota N nf K xhat * ggK1Abu_iota N nf K g :=
    (Subgroup.mem_centralizer_singleton_iff).mp hgC
  exact ggK1Abu_iota_injective N nf K (by rw [map_mul, map_mul, hcommU])

private noncomputable def ggK1Abu_rep {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (O : adjointOrbits h (ggK1Abu_iota N nf K xhat)) :
    primaryFactors (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) :=
  ⟨Classical.choose O.2, (Classical.choose_spec O.2).1⟩

private theorem ggK1Abu_rep_orbit {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (O : adjointOrbits h (ggK1Abu_iota N nf K xhat)) :
    ({(ggK1Abu_rep h xhat O : K[X]), dualPoly h.bar (ggK1Abu_rep h xhat O : K[X])} : Set K[X]) =
      O.1 :=
  (Classical.choose_spec O.2).2

private theorem ggK1Abu_rep_mem {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (O : adjointOrbits h (ggK1Abu_iota N nf K xhat)) :
    (ggK1Abu_rep h xhat O : K[X]) ∈ O.1 := by
  rw [← ggK1Abu_rep_orbit h xhat O]
  exact Or.inl rfl

private theorem ggK1Abu_fixSub_conj_eq_centralizer {X : Type*} [Group X] (x : X) :
    ggFixSub (MulAut.conj x) = Subgroup.centralizer ({x} : Set X) := by
  ext g
  rw [mem_ggFixSub, MulAut.conj_apply, mul_inv_eq_iff_eq_mul,
    Subgroup.mem_centralizer_singleton_iff]
  exact ⟨fun h => h.symm, fun h => h.symm⟩

private theorem ggK1Abu_conj_mem_A {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (a : K[X])
    {c : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))}
    (hc : c ∈ Subgroup.centralizer ({xhat} : Set ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))))
    {g : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hg : g ∈ ggK1Abu_A h xhat a) :
    c * g * c⁻¹ ∈ ggK1Abu_A h xhat a := by
  have hcx : c * xhat = xhat * c := (Subgroup.mem_centralizer_singleton_iff).mp hc
  have hcomm : ggK1Abu_iota N nf K c * ggK1Abu_iota N nf K xhat =
      ggK1Abu_iota N nf K xhat * ggK1Abu_iota N nf K c := by
    have := congrArg (ggK1Abu_iota N nf K) hcx
    simpa only [map_mul] using this
  have hcC : ggK1Abu_iota N nf K c ∈ gl_centralizer (ggK1Abu_iota N nf K xhat) :=
    (Subgroup.mem_centralizer_singleton_iff).mpr hcomm
  have hgL : ggK1Abu_iota N nf K g ∈
      specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a := hg
  have hconj := conj_mem_specialBlock (B := idForm h N)
    (x := ggK1Abu_iota N nf K xhat) (a := a)
    (m := ggK1Abu_iota N nf K c) (g := ggK1Abu_iota N nf K g)
    (mem_unitaryCentralizer.mpr
      ⟨(ggK1Abu_iota_mem_sesqSpecialUnitary h c).1, mem_gl_centralizer.mp hcC⟩) hgL
  show ggK1Abu_iota N nf K (c * g * c⁻¹) ∈
    specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a
  rw [map_mul, map_mul, map_inv]
  exact hconj

private theorem ggK1Abu_comm {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (O O' : adjointOrbits h (ggK1Abu_iota N nf K xhat)) (hne : O ≠ O') :
    ∀ a ∈ ggK1Abu_A h xhat (ggK1Abu_rep h xhat O).1,
    ∀ b ∈ ggK1Abu_A h xhat (ggK1Abu_rep h xhat O').1, Commute a b := by
  intro a ha b hb
  have hO : O.1 ∈ adjointOrbits h (ggK1Abu_iota N nf K xhat) := O.2
  have hO' : O'.1 ∈ adjointOrbits h (ggK1Abu_iota N nf K xhat) := O'.2
  have hdisj := adjointOrbits_disjoint H hO hO' (fun h => hne (Subtype.ext h))
  have hbO' : (ggK1Abu_rep h xhat O' : K[X]) ∈ O'.1 := ggK1Abu_rep_mem h xhat O'
  have hbnot : (ggK1Abu_rep h xhat O' : K[X]) ∉ O.1 := fun hmem =>
    Set.disjoint_left.mp hdisj hmem hbO'
  have hne1 : (ggK1Abu_rep h xhat O' : K[X]) ≠ (ggK1Abu_rep h xhat O : K[X]) := by
    intro heq
    exact hbnot (by rw [heq, ← ggK1Abu_rep_orbit h xhat O]; exact Or.inl rfl)
  have hne2 : (ggK1Abu_rep h xhat O' : K[X]) ≠
      dualPoly h.bar (ggK1Abu_rep h xhat O : K[X]) := by
    intro heq
    exact hbnot (by rw [heq, ← ggK1Abu_rep_orbit h xhat O]; exact Or.inr rfl)
  have hc := commute_specialBlock_of_ne H (ggK1Abu_rep h xhat O) (ggK1Abu_rep h xhat O')
    hne1 hne2 ha hb
  exact ggK1Abu_iota_injective N nf K (by rw [map_mul, map_mul, hc.eq])

private theorem ggK1Abu_ordQ_eq_one {p nf : ℕ} (hp : p.Prime) {K : Type} [Field K] [Fintype K]
    (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1) :
    orderOf ((Fintype.card K : ℕ) : ZMod p) = 1 := by
  have hcard : Fintype.card K = (2 ^ nf) ^ 2 := by
    rw [← Nat.card_eq_fintype_card, hK]
  classical
  have h1 : (((2 ^ nf : ℕ) : ZMod p)) ^ 2 = 1 := by
    rcases hdvd with h | h
    · have hz : ((2 ^ nf - 1 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr h
      rw [Nat.cast_sub (Nat.one_le_two_pow), Nat.cast_one] at hz
      have h2 : ((2 ^ nf : ℕ) : ZMod p) = 1 := sub_eq_zero.mp hz
      rw [h2]; ring
    · have hz : ((2 ^ nf + 1 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).mpr h
      rw [Nat.cast_add, Nat.cast_one] at hz
      have h2 : ((2 ^ nf : ℕ) : ZMod p) = -1 := by
        rw [add_eq_zero_iff_eq_neg] at hz; exact hz
      rw [h2]; ring
  rw [hcard, Nat.cast_pow, h1, orderOf_one]

private theorem ggK1Abu_natDegree_eq_one {p N nf : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1)) : a.natDegree = 1 := by
  by_cases hne : a = X - 1
  · rw [hne]
    simpa using natDegree_X_sub_C (1 : K)
  · have hchar : ringChar K = 2 := ggK1Abu_ringChar_two hnf hK
    have hpchar : p ≠ ringChar K := by rw [hchar]; exact hp2
    haveI : Fintype K := Fintype.ofFinite K
    have hval : xhat.1 ^ p = 1 := by
      have := congrArg Subtype.val hxp
      simpa using this
    have hdvda : a ∣ X ^ p - 1 := ggK1Abu_dvd_X_pow_sub_one hval ha
    have hdeg := ggK1CBl_ff_degree (K := K) hp hpchar
      (irreducible_of_mem_primaryFactors ha) (monic_of_mem_primaryFactors ha) hdvda hne
    rw [hdeg, ggK1Abu_ordQ_eq_one hp hK hdvd]

private theorem ggK1Abu_primaryMultiplicity_X_sub_one {nf N : ℕ} {K : Type} [Field K]
    (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) :
    primaryMultiplicity (ggK1A_glEnd xhat.1) (X - 1) =
      Module.finrank K (primaryComponent (ggK1A_glEnd xhat.1) (X - 1)) := by
  haveI : Fact (Irreducible (X - C (1 : K) : K[X])) :=
    ⟨irreducible_X_sub_C (1 : K)⟩
  have h := finrank_primaryComponent (ggK1A_glEnd xhat.1) (X - C (1 : K))
  rw [natDegree_X_sub_C, one_mul] at h
  exact h.symm

private theorem ggK1Abu_X_sub_one_not_mem_mult {N nf : ℕ} {K : Type} [Field K] [Finite K]
    (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1)))
    (hmem : (X - 1) ∉ primaryFactors (ggK1A_glEnd xhat.1)) :
    primaryMultiplicity (ggK1A_glEnd xhat.1) (X - 1) = 0 := by
  haveI : Fact (Irreducible (X - 1 : K[X])) :=
    ⟨show Irreducible (X - 1 : K[X]) from irreducible_X_sub_C (1 : K)⟩
  have hcop : IsCoprime (X - 1 : K[X]) (minpoly K (ggK1A_glEnd xhat.1)) := by
    rw [← prod_primaryFactors hsq]
    refine IsCoprime.prod_right fun h hh => ?_
    change IsCoprime (X - C (1 : K)) h
    rw [Irreducible.coprime_iff_not_dvd (irreducible_X_sub_C (1 : K))]
    intro hdvd
    have hne : h ≠ X - 1 := fun he => hmem (he ▸ hh)
    exact hne (eq_of_monic_of_associated (monic_of_mem_primaryFactors hh) (monic_X_sub_C 1)
      (((irreducible_X_sub_C (1 : K)).associated_of_dvd
        (irreducible_of_mem_primaryFactors hh) hdvd).symm))
  obtain ⟨u, v, huv⟩ := hcop
  have h1 : aeval (ggK1A_glEnd xhat.1) u * aeval (ggK1A_glEnd xhat.1) (X - 1 : K[X]) = 1 := by
    have := congrArg (aeval (ggK1A_glEnd xhat.1)) huv
    rw [map_add, map_mul, map_mul, minpoly.aeval, mul_zero, add_zero] at this
    simpa only [map_one] using this
  have hinj : Function.Injective (aeval (ggK1A_glEnd xhat.1) (X - 1 : K[X])) := by
    intro a b hab
    have h2 : a - b = 0 := by
      have h3 : aeval (ggK1A_glEnd xhat.1) u
          (aeval (ggK1A_glEnd xhat.1) (X - 1 : K[X]) (a - b)) = a - b := by
        rw [← Module.End.mul_apply, h1, Module.End.one_apply]
      rw [map_sub, hab, sub_self, map_zero] at h3
      exact h3.symm
    exact sub_eq_zero.mp h2
  have hker : primaryComponent (ggK1A_glEnd xhat.1) (X - 1) = ⊥ := by
    change LinearMap.ker (aeval (ggK1A_glEnd xhat.1) (X - 1 : K[X])) = ⊥
    rw [LinearMap.ker_eq_bot]
    exact hinj
  haveI : Subsingleton ↥(primaryComponent (ggK1A_glEnd xhat.1) (X - 1)) :=
    ⟨fun a b => Subtype.ext (by
      have ha : (a : Fin N → K) = 0 := by
        simpa using (show (a : Fin N → K) ∈ (⊥ : Submodule K (Fin N → K)) from hker ▸ a.2)
      have hb : (b : Fin N → K) = 0 := by
        simpa using (show (b : Fin N → K) ∈ (⊥ : Submodule K (Fin N → K)) from hker ▸ b.2)
      rw [ha, hb])⟩
  exact Module.finrank_zero_of_subsingleton

private theorem ggK1Abu_X_sub_one_mem_iff {N nf : ℕ} {K : Type} [Field K] [Finite K]
    (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1))) :
    (X - 1 : K[X]) ∈ primaryFactors (ggK1A_glEnd xhat.1) ↔
      0 < primaryMultiplicity (ggK1A_glEnd xhat.1) (X - 1) := by
  haveI : Fact (Irreducible (X - 1 : K[X])) :=
    ⟨show Irreducible (X - 1 : K[X]) from irreducible_X_sub_C (1 : K)⟩
  constructor
  · intro hmem
    haveI : Nontrivial (primaryComponent (ggK1A_glEnd xhat.1) (X - 1)) :=
      Submodule.nontrivial_iff_ne_bot.mpr (primaryComponent_ne_bot hsq hmem)
    exact Module.finrank_pos
  · intro hpos
    by_contra hmem
    have := ggK1Abu_X_sub_one_not_mem_mult xhat hsq hmem
    omega

private theorem ggK1Abu_filter_cons (m : List ℕ) :
    Multiset.ofList (m.filter (fun x => decide (x ≠ 0))) =
      (if m.getD 0 0 ≠ 0 then ({m.getD 0 0} : Multiset ℕ) else 0) +
        Multiset.ofList (m.tail.filter (fun x => decide (x ≠ 0))) := by
  cases m with
  | nil => simp
  | cons a t =>
    rw [List.filter_cons]
    by_cases ha : a = 0
    · simp [ha, List.getD]
    · simp [ha, List.getD]

private theorem ggK1Abu_multOrd_eq_one_or_two {p nf : ℕ}
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1) :
    ggMultOrd p nf = 1 ∨ ggMultOrd p nf = 2 := by
  unfold ggMultOrd
  by_cases h1 : p ∣ 2 ^ nf - 1
  · left; rw [if_pos h1]
  · right; rw [if_neg h1]
    rcases hdvd with h | h
    · exact absurd h h1
    · rw [if_pos h]

private theorem ggK1Abu_expected_trivial {p nf : ℕ} {m : List ℕ} (hd : ggMultOrd p nf = 2)
    (hlen : m.length = p) :
    ggK1ACo_expectedKinds p nf true m =
      Multiset.ofList ((m.filter (fun x => decide (x ≠ 0))).map
        (fun x => ggK1ACo_Kind.su x 1)) := by
  have hlist : ((List.range p).filter (fun j => decide (0 < m.getD j 0))).map
      (fun j => ggK1ACo_Kind.su (m.getD j 0) 1) =
      (m.filter (fun x => decide (x ≠ 0))).map (fun x => ggK1ACo_Kind.su x 1) := by
    rw [← hlen]
    rw [ggK1CBl_filter_map_getD m 0 (fun x => decide (x ≠ 0))
      (fun x => ggK1ACo_Kind.su x 1)]
    congr 1
    apply List.filter_congr
    intro k _
    simp [Nat.pos_iff_ne_zero]
  unfold ggK1ACo_expectedKinds ggK1ACo_expectedKindList
  simp only [hd, if_true, if_false, Bool.false_eq_true, false_and, true_and, or_false, true_or,
    or_true]
  rw [hlist]

private theorem ggK1Abu_expected_nontrivial {p nf : ℕ} {m : List ℕ} (hd : ggMultOrd p nf = 1) :
    ggK1ACo_expectedKinds p nf true m =
      (if 0 < m.headD 0 then ({ggK1ACo_Kind.su (m.headD 0) 1} : Multiset ggK1ACo_Kind)
        else 0) +
      Multiset.ofList (((List.range ((p - 1) / 2 + 1)).filter
        (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0))).map
          (fun j => ggK1ACo_Kind.sl (m.getD j 0) 2)) := by
  have hlist : ggK1ACo_expectedKindList p nf true m =
      (if 0 < m.headD 0 then [ggK1ACo_Kind.su (m.headD 0) 1] else []) ++
      ((List.range ((p - 1) / 2 + 1)).filter
        (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0))).map
          (fun j => ggK1ACo_Kind.sl (m.getD j 0) 2) := by
    unfold ggK1ACo_expectedKindList
    rw [if_neg (by rw [hd]; decide)]
    simp only [Bool.false_eq_true, if_false, if_true]
  rw [ggK1ACo_expectedKinds, hlist, ← Multiset.coe_add]
  congr 1
  by_cases h0 : 0 < m.headD 0
  · rw [if_pos h0, if_pos h0]; rfl
  · rw [if_neg h0, if_neg h0]; rfl

private theorem ggK1Abu_range_filter_sl (m : List ℕ) (e : ℕ) :
    ((List.range (e + 1)).filter (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0))).map
      (fun j => ggK1ACo_Kind.sl (m.getD j 0) 2) =
    (((List.range e).map (fun j => m.getD (j + 1) 0)).filter (fun x => decide (x ≠ 0))).map
      (fun x => ggK1ACo_Kind.sl x 2) := by
  rw [List.range_succ_eq_map, List.filter_cons]
  have h0 : ¬ (((fun j => decide (1 ≤ j ∧ 0 < m.getD j 0)) 0) = true) := by simp
  rw [if_neg h0]
  rw [ggK1CBl_map_filter_eq]
  conv_rhs => rw [ggK1CBl_map_filter_eq]
  rw [List.map_map, List.map_map]
  congr 1
  apply List.filter_congr
  intro k _
  simp only [Function.comp_apply, Nat.succ_eq_add_one]
  rw [decide_eq_decide]
  omega

private theorem ggK1Abu_range_iota {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) :
    (ggK1Abu_iota N nf K).range = sesqSpecialUnitaryGroup (idForm h N) := by
  ext g
  constructor
  · rintro ⟨x, rfl⟩
    exact ggK1Abu_iota_mem_sesqSpecialUnitary h x
  · intro hg
    refine ⟨⟨(Matrix.GeneralLinearGroup.toLin :
        GL (Fin N) K ≃* LinearMap.GeneralLinearGroup K (Fin N → K)).symm g, ?_⟩, ?_⟩
    · rw [InndiagSU.largeEvenSUGroup_eq_gramSU (d := N) (n := nf) h,
        ← toLin_mem_sesqSpecialUnitaryGroup_iff h (idGram K N), MulEquiv.apply_symm_apply]
      simpa [idForm, idGram] using hg
    · change Matrix.GeneralLinearGroup.toLin ((Matrix.GeneralLinearGroup.toLin :
        GL (Fin N) K ≃* LinearMap.GeneralLinearGroup K (Fin N → K)).symm g) = g
      exact MulEquiv.apply_symm_apply _ _

private theorem ggK1Abu_selfDual_of_d2 {p N nf : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (hd2 : ggMultOrd p nf = 2) {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1)) :
    dualPoly (ggK1Abu_unitaryFieldData hnf hK).bar a = a := by
  have h : UnitaryFieldData 2 nf K := ggK1Abu_unitaryFieldData hnf hK
  have hd1 : a.natDegree = 1 := ggK1Abu_natDegree_eq_one hp hp2 hnf hK hdvd hxp ha
  have hmon : a.Monic := monic_of_mem_primaryFactors ha
  set μ : K := -a.coeff 0 with hμdef
  have haμ : a = X - C μ := by
    rw [hmon.eq_X_add_C hd1, hμdef]
    simp [sub_eq_add_neg]
  have hμp : μ ^ p = 1 := by
    have hval : xhat.1 ^ p = 1 := by
      have := congrArg Subtype.val hxp; simpa using this
    obtain ⟨q, hq⟩ := ggK1Abu_dvd_X_pow_sub_one hval ha
    have h1 : Polynomial.aeval μ a = 0 := by rw [haμ]; simp
    have h2 : Polynomial.aeval μ (X ^ p - 1 : K[X]) = 0 := by
      rw [hq, map_mul, h1, zero_mul]
    exact sub_eq_zero.mp (by simpa using h2)
  have hμne : μ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hp.pos.ne'] at hμp
    exact zero_ne_one hμp
  have hp1 : p ∣ 2 ^ nf + 1 := by
    unfold ggMultOrd at hd2
    by_cases h1 : p ∣ 2 ^ nf - 1
    · rw [if_pos h1] at hd2; omega
    · rw [if_neg h1] at hd2
      by_cases h2 : p ∣ 2 ^ nf + 1
      · exact h2
      · rw [if_neg h2] at hd2; omega
  have hpow : μ ^ (2 ^ nf) = μ⁻¹ := by
    obtain ⟨k, hk⟩ := hp1
    have h1 : μ ^ (2 ^ nf) * μ = 1 := by
      rw [← pow_succ, hk, pow_mul, hμp, one_pow]
    apply mul_right_cancel₀ hμne
    rw [h1, inv_mul_cancel₀ hμne]
  have hbarμ : h.bar μ = μ ^ (2 ^ nf) := h.bar_apply μ
  have hbarne : h.bar μ ≠ 0 := by rw [hbarμ, hpow]; exact inv_ne_zero hμne
  rw [haμ, CFSG.RankThree.PartOne.KCUnitaryBlock.dualPoly_X_sub_C hbarne, hbarμ, hpow,
    inv_inv]

private theorem ggK1Abu_selfDual_eq_X_sub_one {p N nf : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (hd1 : ggMultOrd p nf = 1) {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1))
    (hself : dualPoly (ggK1Abu_unitaryFieldData hnf hK).bar a = a) :
    a = X - 1 := by
  have h : UnitaryFieldData 2 nf K := ggK1Abu_unitaryFieldData hnf hK
  have hdeg : a.natDegree = 1 := ggK1Abu_natDegree_eq_one hp hp2 hnf hK hdvd hxp ha
  have hmon : a.Monic := monic_of_mem_primaryFactors ha
  set μ : K := -a.coeff 0 with hμdef
  have haμ : a = X - C μ := by
    rw [hmon.eq_X_add_C hdeg, hμdef]
    simp [sub_eq_add_neg]
  have hμp : μ ^ p = 1 := by
    have hval : xhat.1 ^ p = 1 := by
      have := congrArg Subtype.val hxp; simpa using this
    obtain ⟨q, hq⟩ := ggK1Abu_dvd_X_pow_sub_one hval ha
    have h1 : Polynomial.aeval μ a = 0 := by rw [haμ]; simp
    have h2 : Polynomial.aeval μ (X ^ p - 1 : K[X]) = 0 := by
      rw [hq, map_mul, h1, zero_mul]
    exact sub_eq_zero.mp (by simpa using h2)
  have hμne : μ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hp.pos.ne'] at hμp
    exact zero_ne_one hμp
  have hp1 : p ∣ 2 ^ nf - 1 := by
    unfold ggMultOrd at hd1
    by_cases h1 : p ∣ 2 ^ nf - 1
    · exact h1
    · rw [if_neg h1] at hd1
      by_cases h2 : p ∣ 2 ^ nf + 1
      · rw [if_pos h2] at hd1; omega
      · rw [if_neg h2] at hd1; omega
  have hpow : μ ^ (2 ^ nf) = μ := by
    obtain ⟨k, hk⟩ := hp1
    have hk' : 2 ^ nf = p * k + 1 := by
      have h2 : 1 ≤ 2 ^ nf := Nat.one_le_two_pow
      omega
    rw [hk']
    calc μ ^ (p * k + 1) = (μ ^ p) ^ k * μ := by rw [pow_succ, pow_mul]
      _ = μ := by rw [hμp, one_pow, one_mul]
  have hbarμ : h.bar μ = μ ^ (2 ^ nf) := h.bar_apply μ
  have hbarne : h.bar μ ≠ 0 := by rw [hbarμ, hpow]; exact hμne
  have hdual : dualPoly h.bar (X - C μ) = X - C (h.bar μ)⁻¹ :=
    CFSG.RankThree.PartOne.KCUnitaryBlock.dualPoly_X_sub_C hbarne
  have hself' : X - C (h.bar μ)⁻¹ = X - C μ := by
    have hh := hself
    rw [haμ] at hh
    rw [hdual] at hh
    exact hh
  have hμinv : (h.bar μ)⁻¹ = μ := by
    have := congrArg (fun q : K[X] => q.coeff 0) hself'
    exact neg_injective (by simpa using this)
  have hbar_eq_inv : h.bar μ = μ⁻¹ := by
    have := congrArg Inv.inv hμinv
    simpa using this
  have hμ2 : μ ^ 2 = 1 := by
    have h1 : μ = μ⁻¹ := by rw [← hbar_eq_inv, hbarμ, hpow]
    rw [pow_two]
    nth_rewrite 1 [h1]
    exact inv_mul_cancel₀ hμne
  have hμ1 : μ = 1 := by
    have hord2 : orderOf μ ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hμ2
    have hordp : orderOf μ ∣ p := orderOf_dvd_iff_pow_eq_one.mpr hμp
    have hcop : Nat.Coprime 2 p :=
      (hp.coprime_iff_not_dvd.mpr
        (fun hpq => hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp hpq))).symm
    have h3 : orderOf μ ∣ Nat.gcd 2 p := Nat.dvd_gcd hord2 hordp
    rw [hcop.gcd_eq_one] at h3
    exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp h3)
  rw [haμ, hμ1]
  simp

private theorem ggK1Abu_union_val {α : Type*} [DecidableEq α] {s t : Finset α}
    (h : Disjoint s t) : (s ∪ t).val = s.val + t.val := by
  rw [← Finset.disjUnion_eq_union s t h]
  rfl

private theorem ggK1Abu_univ_sum {α β : Type} [Fintype α] [Fintype β] [DecidableEq α]
    [DecidableEq β] :
    (Finset.univ : Finset (α ⊕ β)) =
      (Finset.univ : Finset α).map ⟨Sum.inl, Sum.inl_injective⟩ ∪
        (Finset.univ : Finset β).map ⟨Sum.inr, Sum.inr_injective⟩ := by
  classical
  ext x
  rcases x with x | x <;> simp

private theorem ggK1Abu_univ_sum_map {α β γ : Type} [Fintype α] [Fintype β] [DecidableEq γ]
    (f : α ⊕ β → γ) :
    (Finset.univ : Finset (α ⊕ β)).val.map f =
      (Finset.univ : Finset α).val.map (fun a => f (Sum.inl a)) +
        (Finset.univ : Finset β).val.map (fun b => f (Sum.inr b)) := by
  classical
  rw [ggK1Abu_univ_sum,
    ggK1Abu_union_val (by
      rw [Finset.disjoint_left]
      intro x hx hx'
      rcases Finset.mem_map.mp hx with ⟨a, -, ha⟩
      rcases Finset.mem_map.mp hx' with ⟨b, -, hb⟩
      exact Sum.inl_ne_inr (ha.trans hb.symm)),
    Finset.map_val, Finset.map_val, Multiset.map_add, Multiset.map_map, Multiset.map_map]
  rfl

private theorem ggK1Abu_nonSelfDual_map_eq_two_P {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P) :
    ((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a ≠ X - 1)).val.map
        (primaryMultiplicity (ggK1A_glEnd xhat.1)) =
      2 • P.val.map (primaryMultiplicity (ggK1A_glEnd xhat.1)) := by
  classical
  set Φ := primaryFactors (ggK1A_glEnd xhat.1) with hΦ
  have hX1 : dualPoly h.bar (X - 1) = X - 1 := by
    have := CFSG.RankThree.PartOne.KCUnitary.dualPoly_X_sub_C_one h.bar
    simpa using this
  have hfilt : Φ.filter (fun a => a ≠ X - 1) = Φ.filter (fun a => dualPoly h.bar a ≠ a) := by
    apply Finset.filter_congr
    intro a ha
    simp only [ne_eq]
    constructor
    · intro hne hd; exact hne (honly a ha hd)
    · intro hd hX; exact hd (hX ▸ hX1)
  rw [hfilt]
  have hPr : Φ.filter (fun a => dualPoly h.bar a ≠ a) = P ∪ P.image (dualPoly h.bar) := by
    ext a
    simp only [Finset.mem_filter, Finset.mem_union, Finset.mem_image]
    constructor
    · rintro ⟨ha, hne⟩
      rcases hP.2.1 a ha (fun hh => hne hh.symm) with hh | hh
      · exact Or.inl hh
      · exact Or.inr ⟨dualPoly h.bar a, hh, dualPoly_dualPoly_of_mem H ha⟩
    · rintro (hh | ⟨p, hp, rfl⟩)
      · exact ⟨(hP.1 a hh).1, fun h' => (hP.1 a hh).2 h'.symm⟩
      · refine ⟨dualPoly_mem_primaryFactors H (hP.1 p hp).1, ?_⟩
        rw [dualPoly_dualPoly_of_mem H (hP.1 p hp).1]
        exact (hP.1 p hp).2
  have hdisj : Disjoint P (P.image (dualPoly h.bar)) := by
    rw [Finset.disjoint_left]
    intro a ha ha'
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp ha'
    exact hP.2.2 p hp ha
  rw [hPr, ggK1Abu_union_val hdisj, Multiset.map_add]
  have hinj : ∀ a ∈ P, ∀ b ∈ P, dualPoly h.bar a = dualPoly h.bar b → a = b := by
    intro a ha b hb hab
    exact dualPoly_injOn H (hP.1 a ha).1 (hP.1 b hb).1 hab
  have himg : (P.image (dualPoly h.bar)).val = P.val.map (dualPoly h.bar) :=
    Finset.image_val_of_injOn hinj
  rw [himg, Multiset.map_map]
  have hcongr : Multiset.map (primaryMultiplicity (ggK1A_glEnd xhat.1) ∘ dualPoly h.bar) P.val =
      P.val.map (primaryMultiplicity (ggK1A_glEnd xhat.1)) := by
    refine Multiset.map_congr rfl fun a ha => ?_
    exact primaryMultiplicity_dualPoly H (hP.1 a (Finset.mem_val.mp ha)).1
  rw [hcongr, two_smul]

private noncomputable def ggK1Abu_chosen {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (P : Finset K[X]) (O : adjointOrbits h (ggK1Abu_iota N nf K xhat)) : K[X] :=
  if (ggK1Abu_rep h xhat O).1 ∈ P then (ggK1Abu_rep h xhat O).1
    else dualPoly h.bar (ggK1Abu_rep h xhat O).1

private theorem ggK1Abu_chosen_mem {nf N : ℕ} {K : Type} [Field K] [Finite K] [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P)
    (O : adjointOrbits h (ggK1Abu_iota N nf K xhat))
    (hnsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 ≠ (ggK1Abu_rep h xhat O).1) :
    ggK1Abu_chosen h xhat P O ∈ P := by
  classical
  by_cases hmem : (ggK1Abu_rep h xhat O).1 ∈ P
  · rw [show ggK1Abu_chosen h xhat P O = (ggK1Abu_rep h xhat O).1 from if_pos hmem]
    exact hmem
  · rw [show ggK1Abu_chosen h xhat P O = dualPoly h.bar (ggK1Abu_rep h xhat O).1
        from if_neg hmem]
    rcases hP.2.1 _ (ggK1Abu_rep h xhat O).2 (Ne.symm hnsd) with hh | hh
    · exact absurd hh hmem
    · exact hh

private theorem ggK1Abu_chosen_orbit {nf N : ℕ} {K : Type} [Field K] [Finite K] [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (P : Finset K[X]) (O : adjointOrbits h (ggK1Abu_iota N nf K xhat))
    (hnsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 ≠ (ggK1Abu_rep h xhat O).1) :
    O.1 = ({ggK1Abu_chosen h xhat P O, dualPoly h.bar (ggK1Abu_chosen h xhat P O)} :
      Set K[X]) := by
  classical
  by_cases hmem : (ggK1Abu_rep h xhat O).1 ∈ P
  · rw [show ggK1Abu_chosen h xhat P O = (ggK1Abu_rep h xhat O).1 from if_pos hmem]
    rw [ggK1Abu_rep_orbit h xhat O]
  · rw [show ggK1Abu_chosen h xhat P O = dualPoly h.bar (ggK1Abu_rep h xhat O).1
        from if_neg hmem,
      dualPoly_dualPoly_of_mem H (ggK1Abu_rep h xhat O).2]
    rw [← ggK1Abu_rep_orbit h xhat O, Set.pair_comm]

private noncomputable def ggK1Abu_toSum {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P) :
    adjointOrbits h (ggK1Abu_iota N nf K xhat) →
      ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1)) ⊕ ↥P :=
  fun O =>
    if hsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 = (ggK1Abu_rep h xhat O).1 then
      Sum.inl ⟨(ggK1Abu_rep h xhat O).1, by
        rw [Finset.mem_filter]
        exact ⟨(ggK1Abu_rep h xhat O).2, honly _ (ggK1Abu_rep h xhat O).2 hsd⟩⟩
    else
      Sum.inr ⟨ggK1Abu_chosen h xhat P O, ggK1Abu_chosen_mem h xhat P hP O hsd⟩

private theorem ggK1Abu_toSum_bijective {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P) :
    Function.Bijective (ggK1Abu_toSum h xhat honly P hP) := by
  classical
  have hX1 : dualPoly h.bar (X - 1) = X - 1 := by
    have := CFSG.RankThree.PartOne.KCUnitary.dualPoly_X_sub_C_one h.bar
    simpa using this
  constructor
  · intro O O' hEq
    by_cases hsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 = (ggK1Abu_rep h xhat O).1
    · by_cases hsd' : dualPoly h.bar (ggK1Abu_rep h xhat O').1 = (ggK1Abu_rep h xhat O').1
      · have h1 : (ggK1Abu_rep h xhat O).1 = X - 1 := honly _ (ggK1Abu_rep h xhat O).2 hsd
        have h2 : (ggK1Abu_rep h xhat O').1 = X - 1 := honly _ (ggK1Abu_rep h xhat O').2 hsd'
        apply Subtype.ext
        rw [← ggK1Abu_rep_orbit h xhat O, ← ggK1Abu_rep_orbit h xhat O', h1, h2]
      · exfalso
        simp only [ggK1Abu_toSum, dif_pos hsd, dif_neg hsd'] at hEq
        exact Sum.inl_ne_inr hEq
    · by_cases hsd' : dualPoly h.bar (ggK1Abu_rep h xhat O').1 = (ggK1Abu_rep h xhat O').1
      · exfalso
        simp only [ggK1Abu_toSum, dif_neg hsd, dif_pos hsd'] at hEq
        exact Sum.inr_ne_inl hEq
      · have hval : ggK1Abu_chosen h xhat P O = ggK1Abu_chosen h xhat P O' := by
          simp only [ggK1Abu_toSum, dif_neg hsd, dif_neg hsd'] at hEq
          exact congrArg Subtype.val (Sum.inr.inj hEq)
        apply Subtype.ext
        rw [ggK1Abu_chosen_orbit h xhat H P O hsd,
          ggK1Abu_chosen_orbit h xhat H P O' hsd', hval]
  · intro s
    rcases s with ⟨a, ha⟩ | ⟨p, hp⟩
    · have haΦ : a ∈ primaryFactors (ggK1A_glEnd xhat.1) := (Finset.mem_filter.mp ha).1
      have hda : dualPoly h.bar a = a := by
        rw [(Finset.mem_filter.mp ha).2]; exact hX1
      let O : adjointOrbits h (ggK1Abu_iota N nf K xhat) :=
        ⟨({a, dualPoly h.bar a} : Set K[X]), ⟨a, Finset.mem_coe.mpr haΦ, rfl⟩⟩
      have hrep : (ggK1Abu_rep h xhat O).1 = a := by
        have hmem := ggK1Abu_rep_mem h xhat O
        change (ggK1Abu_rep h xhat O).1 ∈ ({a, dualPoly h.bar a} : Set K[X]) at hmem
        rw [hda] at hmem
        simpa using hmem
      refine ⟨O, ?_⟩
      have hsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 = (ggK1Abu_rep h xhat O).1 := by
        rw [hrep, hda]
      simp only [ggK1Abu_toSum, dif_pos hsd]
      apply congrArg Sum.inl
      exact Subtype.ext hrep
    · have hpΦ : p ∈ primaryFactors (ggK1A_glEnd xhat.1) := (hP.1 p hp).1
      have hpne : p ≠ dualPoly h.bar p := (hP.1 p hp).2
      let O : adjointOrbits h (ggK1Abu_iota N nf K xhat) :=
        ⟨({p, dualPoly h.bar p} : Set K[X]), ⟨p, Finset.mem_coe.mpr hpΦ, rfl⟩⟩
      have hrep_mem : (ggK1Abu_rep h xhat O).1 = p ∨
          (ggK1Abu_rep h xhat O).1 = dualPoly h.bar p := by
        have hmem := ggK1Abu_rep_mem h xhat O
        simpa [O] using hmem
      have hnsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 ≠ (ggK1Abu_rep h xhat O).1 := by
        rcases hrep_mem with hrep | hrep
        · rw [hrep]; exact (Ne.symm hpne)
        · rw [hrep, dualPoly_dualPoly_of_mem H hpΦ]; exact hpne
      have hchosen : ggK1Abu_chosen h xhat P O = p := by
        rcases hrep_mem with hrep | hrep
        · have : (ggK1Abu_rep h xhat O).1 ∈ P := by rw [hrep]; exact hp
          rw [show ggK1Abu_chosen h xhat P O = (ggK1Abu_rep h xhat O).1 from if_pos this, hrep]
        · have hnot : ¬ ((ggK1Abu_rep h xhat O).1 ∈ P) := by
            rw [hrep]
            exact fun h => hP.2.2 p hp h
          rw [show ggK1Abu_chosen h xhat P O = dualPoly h.bar (ggK1Abu_rep h xhat O).1
              from if_neg hnot, hrep, dualPoly_dualPoly_of_mem H hpΦ]
      refine ⟨O, ?_⟩
      simp only [ggK1Abu_toSum, dif_neg hnsd]
      apply congrArg Sum.inr
      exact Subtype.ext hchosen

private noncomputable def ggK1Abu_orbitEquivD1 {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P) :
    adjointOrbits h (ggK1Abu_iota N nf K xhat) ≃
      ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1)) ⊕ ↥P :=
  Equiv.ofBijective (ggK1Abu_toSum h xhat honly P hP)
    (ggK1Abu_toSum_bijective h xhat H honly P hP)

private theorem ggK1Abu_toSum_inl_rep {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P)
    (a : ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1)))
    (O : adjointOrbits h (ggK1Abu_iota N nf K xhat))
    (hO : ggK1Abu_toSum h xhat honly P hP O = Sum.inl a) :
    (ggK1Abu_rep h xhat O).1 = X - 1 := by
  classical
  by_cases hsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 = (ggK1Abu_rep h xhat O).1
  · have h1 : (ggK1Abu_rep h xhat O).1 = a.1 :=
      congrArg (fun x : ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1)) =>
        (x : K[X])) (Sum.inl.inj (by simpa only [ggK1Abu_toSum, dif_pos hsd] using hO))
    rw [h1]
    exact (Finset.mem_filter.mp a.2).2
  · have hcontra := hO
    simp only [ggK1Abu_toSum, dif_neg hsd] at hcontra
    exact absurd hcontra Sum.inr_ne_inl

private theorem ggK1Abu_toSum_inr_mult {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P)
    (p : ↥P) (O : adjointOrbits h (ggK1Abu_iota N nf K xhat))
    (hO : ggK1Abu_toSum h xhat honly P hP O = Sum.inr p) :
    primaryMultiplicity (ggK1A_glEnd xhat.1) (ggK1Abu_rep h xhat O).1 =
      primaryMultiplicity (ggK1A_glEnd xhat.1) p.1 := by
  classical
  by_cases hsd : dualPoly h.bar (ggK1Abu_rep h xhat O).1 = (ggK1Abu_rep h xhat O).1
  · have hcontra := hO
    simp only [ggK1Abu_toSum, dif_pos hsd] at hcontra
    exact absurd hcontra Sum.inl_ne_inr
  · have hchosen : ggK1Abu_chosen h xhat P O = p.1 :=
      congrArg (fun x : ↥P => (x : K[X])) (Sum.inr.inj (by simpa only [ggK1Abu_toSum, dif_neg hsd]
          using hO))
    by_cases hmem : (ggK1Abu_rep h xhat O).1 ∈ P
    · have hrep : (ggK1Abu_rep h xhat O).1 = p.1 := by
        rw [show ggK1Abu_chosen h xhat P O = (ggK1Abu_rep h xhat O).1 from if_pos hmem] at hchosen
        exact hchosen
      rw [hrep]
    · have hrep : (ggK1Abu_rep h xhat O).1 = dualPoly h.bar p.1 := by
        have h1 : dualPoly h.bar (ggK1Abu_rep h xhat O).1 = p.1 := by
          rw [show ggK1Abu_chosen h xhat P O = dualPoly h.bar (ggK1Abu_rep h xhat O).1
              from if_neg hmem] at hchosen
          exact hchosen
        have h2 := congrArg (dualPoly h.bar) h1
        rw [dualPoly_dualPoly_of_mem H (ggK1Abu_rep h xhat O).2] at h2
        exact h2
      rw [hrep]
      exact primaryMultiplicity_dualPoly H (hP.1 p p.2).1

private theorem ggK1Abu_orbitEquivD1_inl {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P)
    (a : ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1))) :
    (ggK1Abu_rep h xhat
      ((ggK1Abu_orbitEquivD1 h xhat H honly P hP).symm (Sum.inl a))).1 = X - 1 := by
  apply ggK1Abu_toSum_inl_rep h xhat honly P hP a
  exact Equiv.apply_symm_apply (ggK1Abu_orbitEquivD1 h xhat H honly P hP) (Sum.inl a)

private theorem ggK1Abu_orbitEquivD1_inr {nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1)
    (P : Finset K[X]) (hP : IsPairedTransversal h (ggK1Abu_iota N nf K xhat) P)
    (p : ↥P) :
    primaryMultiplicity (ggK1A_glEnd xhat.1)
      (ggK1Abu_rep h xhat
        ((ggK1Abu_orbitEquivD1 h xhat H honly P hP).symm (Sum.inr p))).1 =
      primaryMultiplicity (ggK1A_glEnd xhat.1) p.1 := by
  apply ggK1Abu_toSum_inr_mult h xhat H honly P hP p
  exact Equiv.apply_symm_apply (ggK1Abu_orbitEquivD1 h xhat H honly P hP) (Sum.inr p)

private theorem ggK1Abu_orbitMap_eq_primary {nf N : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    [Fintype (adjointOrbits h (ggK1Abu_iota N nf K xhat))]
    (hself : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a) {γ : Type}
    (f : K[X] → γ) :
    (Finset.univ : Finset (adjointOrbits h (ggK1Abu_iota N nf K xhat))).val.map
      (fun O => f (ggK1Abu_rep h xhat O).1) =
    (primaryFactors (ggK1A_glEnd xhat.1)).val.map f := by
  classical
  let e : primaryFactors (ggK1A_glEnd xhat.1) ≃ adjointOrbits h (ggK1Abu_iota N nf K xhat) :=
    { toFun := fun a => ⟨({a.1, dualPoly h.bar a.1} : Set K[X]),
        ⟨a.1, Finset.mem_coe.mpr a.2, rfl⟩⟩
      invFun := fun O => ggK1Abu_rep h xhat O
      left_inv := fun a => by
        apply Subtype.ext
        let O : adjointOrbits h (ggK1Abu_iota N nf K xhat) :=
          ⟨({a.1, dualPoly h.bar a.1} : Set K[X]),
            ⟨a.1, Finset.mem_coe.mpr a.2, rfl⟩⟩
        have h2 : (ggK1Abu_rep h xhat O : K[X]) ∈ ({a.1, dualPoly h.bar a.1} : Set K[X]) :=
          ggK1Abu_rep_mem h xhat O
        rw [hself a.1 a.2] at h2
        simpa using h2
      right_inv := fun O => by
        apply Subtype.ext
        exact ggK1Abu_rep_orbit h xhat O }
  rw [← Finset.univ_map_equiv_to_embedding e, Finset.map_val, Multiset.map_map]
  rw [← ggK1CBl_univ_map_subtype_val (primaryFactors (ggK1A_glEnd xhat.1)) f]
  refine Multiset.map_congr rfl fun a _ => ?_
  show f (ggK1Abu_rep h xhat (e a)).1 = f a.1
  rw [show ggK1Abu_rep h xhat (e a) = a from e.left_inv a]

private theorem ggK1Abu_kind_multiset_d2 {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1))) {m : List ℕ}
    (hm : GGK1AMultOf p nf N true K (xhat : GL (Fin N) K) m)
    [Fintype (adjointOrbits (ggK1Abu_unitaryFieldData hnf hK) (ggK1Abu_iota N nf K xhat))]
    (hd2 : ggMultOrd p nf = 2) :
    (Finset.univ : Finset (adjointOrbits (ggK1Abu_unitaryFieldData hnf hK)
        (ggK1Abu_iota N nf K xhat))).val.map
      (fun O => ggK1Abu_kind (ggK1Abu_unitaryFieldData hnf hK) xhat
        (ggK1Abu_rep (ggK1Abu_unitaryFieldData hnf hK) xhat O).1) =
      ggK1ACo_expectedKinds p nf true m := by
  classical
  let h : UnitaryFieldData 2 nf K := ggK1Abu_unitaryFieldData hnf hK
  change (Finset.univ : Finset (adjointOrbits h (ggK1Abu_iota N nf K xhat))).val.map
      (fun O => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat O).1) =
    ggK1ACo_expectedKinds p nf true m
  have hself : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a :=
    fun a ha => ggK1Abu_selfDual_of_d2 hp hp2 hnf hK hdvd hxp hd2 ha
  have hkind : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1),
      ggK1Abu_kind h xhat a = ggK1ACo_Kind.su (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 1 := by
    intro a ha
    unfold ggK1Abu_kind
    rw [if_pos (hself a ha)]
  rw [ggK1Abu_orbitMap_eq_primary h xhat hself (fun a => ggK1Abu_kind h xhat a)]
  rw [Multiset.map_congr rfl (fun a ha => hkind a (Finset.mem_val.mp ha))]
  rw [ggK1Abu_expected_trivial hd2 hm.length_eq]
  have hpmult : (primaryFactors (ggK1A_glEnd xhat.1)).val.map
      (primaryMultiplicity (ggK1A_glEnd xhat.1)) =
      Multiset.ofList (m.filter (fun x => decide (x ≠ 0))) := by
    have htail : Multiset.ofList (m.tail.filter (fun j => decide (j ≠ 0))) =
        (ggK1A_selfDualFactors (xhat : GL (Fin N) K)).val.map
          (primaryMultiplicity (ggK1A_glEnd xhat.1)) := by
      rcases hm.blocks_eq with ⟨⟨-, htw⟩, -⟩ | ⟨-, -, htail⟩
      · exact absurd htw (by decide)
      · exact htail
    have hhead : m.getD 0 0 =
        Module.finrank K (primaryComponent (ggK1A_glEnd xhat.1) (X - 1)) := hm.head_eq
    have hmemX : (X - 1 : K[X]) ∈ primaryFactors (ggK1A_glEnd xhat.1) ↔ 0 < m.getD 0 0 := by
      rw [hhead, ← ggK1Abu_primaryMultiplicity_X_sub_one xhat]
      exact ggK1Abu_X_sub_one_mem_iff xhat hsq
    have hsplit : (primaryFactors (ggK1A_glEnd xhat.1)).val =
        ((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun h => h = X - 1)).val +
        ((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun h => h ≠ X - 1)).val := by
      rw [Finset.filter_val, Finset.filter_val]
      exact (Multiset.filter_add_not (fun h => h = X - 1) _).symm
    have hX1 : ((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun h => h = X - 1)).val.map
        (primaryMultiplicity (ggK1A_glEnd xhat.1)) =
        if 0 < m.getD 0 0 then {m.getD 0 0} else 0 := by
      by_cases hX : (X - 1 : K[X]) ∈ primaryFactors (ggK1A_glEnd xhat.1)
      · have hpos : 0 < m.getD 0 0 := hmemX.mp hX
        rw [if_pos hpos]
        have hsing :
            (primaryFactors (ggK1A_glEnd xhat.1)).filter (fun h => h = X - 1) = {X - 1} := by
          refine Finset.eq_singleton_iff_unique_mem.mpr ⟨?_, ?_⟩
          · rw [Finset.mem_filter]; exact ⟨hX, rfl⟩
          · intro h hh; exact (Finset.mem_filter.mp hh).2
        rw [hsing, Finset.singleton_val, Multiset.map_singleton,
          ggK1Abu_primaryMultiplicity_X_sub_one xhat]
        exact congrArg (fun x => ({x} : Multiset ℕ)) hhead.symm
      · have hneg : ¬ 0 < m.getD 0 0 := fun h => hX (hmemX.mpr h)
        rw [if_neg hneg]
        have hempty : (primaryFactors (ggK1A_glEnd xhat.1)).filter (fun h => h = X - 1) = ∅ := by
          rw [Finset.filter_eq_empty_iff]
          intro h hh heq; exact hX (heq ▸ hh)
        rw [hempty]; rfl
    have hSDF : ((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun h => h ≠ X - 1)).val.map
        (primaryMultiplicity (ggK1A_glEnd xhat.1)) =
        Multiset.ofList (m.tail.filter (fun j => decide (j ≠ 0))) := by
      rw [htail]; rfl
    rw [hsplit, Multiset.map_add, hX1, hSDF]
    rw [ggK1Abu_filter_cons m]
    by_cases h0 : m.getD 0 0 = 0
    · rw [if_neg (by omega : ¬ 0 < m.getD 0 0), if_neg (by omega : ¬ m.getD 0 0 ≠ 0)]
    · rw [if_pos (by omega : 0 < m.getD 0 0), if_pos (by omega : m.getD 0 0 ≠ 0)]
  rw [show (primaryFactors (ggK1A_glEnd xhat.1)).val.map
      (fun a => ggK1ACo_Kind.su (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 1) =
      ((primaryFactors (ggK1A_glEnd xhat.1)).val.map
        (primaryMultiplicity (ggK1A_glEnd xhat.1))).map (fun x => ggK1ACo_Kind.su x 1) from by
    rw [Multiset.map_map]; rfl]
  rw [hpmult, Multiset.map_coe]

private theorem ggK1Abu_two_nsmul_cancel {α : Type*} {a b : Multiset α} (h : 2 • a = 2 • b) :
    a = b := by
  classical
  have hh : a + a = b + b := by simpa [two_smul] using h
  refine Multiset.ext.mpr fun x => ?_
  have hx := congrArg (fun s : Multiset α => s.count x) hh
  simp only [Multiset.count_add] at hx
  omega

private theorem ggK1Abu_kind_X1_filter {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    [DecidableEq K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1))) {m : List ℕ}
    (hm : GGK1AMultOf p nf N true K (xhat : GL (Fin N) K) m) :
    ((primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1)).val.map
        (fun a => ggK1Abu_kind h xhat a) =
      (if 0 < m.headD 0 then ({ggK1ACo_Kind.su (m.headD 0) 1} : Multiset ggK1ACo_Kind) else 0) := by
  classical
  have hdual : dualPoly h.bar (X - 1) = X - 1 := by
    have := CFSG.RankThree.PartOne.KCUnitary.dualPoly_X_sub_C_one h.bar
    simpa using this
  have hmemX : (X - 1 : K[X]) ∈ primaryFactors (ggK1A_glEnd xhat.1) ↔ 0 < m.getD 0 0 := by
    rw [hm.head_eq, ← ggK1Abu_primaryMultiplicity_X_sub_one xhat]
    exact ggK1Abu_X_sub_one_mem_iff xhat hsq
  have hmult : primaryMultiplicity (ggK1A_glEnd xhat.1) (X - 1) = m.getD 0 0 := by
    rw [ggK1Abu_primaryMultiplicity_X_sub_one, ← hm.head_eq]
  by_cases hX : (X - 1 : K[X]) ∈ primaryFactors (ggK1A_glEnd xhat.1)
  · have hpos : 0 < m.headD 0 := by
      rw [List.headD_eq_getD]
      exact hmemX.mp hX
    rw [if_pos hpos]
    have hsing : (primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1) = {X - 1} := by
      refine Finset.eq_singleton_iff_unique_mem.mpr ⟨?_, ?_⟩
      · rw [Finset.mem_filter]; exact ⟨hX, rfl⟩
      · intro a ha; exact (Finset.mem_filter.mp ha).2
    rw [hsing, Finset.singleton_val, Multiset.map_singleton]
    have hkind : ggK1Abu_kind h xhat (X - 1) = ggK1ACo_Kind.su (m.getD 0 0) 1 := by
      unfold ggK1Abu_kind
      rw [if_pos hdual, hmult]
    rw [hkind, List.headD_eq_getD]
  · have hneg : ¬ 0 < m.headD 0 := by
      rw [List.headD_eq_getD]
      intro hpos; exact hX (hmemX.mpr hpos)
    rw [if_neg hneg]
    have hempty : (primaryFactors (ggK1A_glEnd xhat.1)).filter (fun a => a = X - 1) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro a ha heq; exact hX (heq ▸ ha)
    rw [hempty]; rfl

private theorem ggK1Abu_det_eq_one_of_mem_specialBlock {nf N : ℕ} {K : Type} [Field K] [Finite K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1))
    {g : LinearMap.GeneralLinearGroup K (Fin N → K)}
    (hg : g ∈ specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a) :
    LinearMap.det (g : Module.End K (Fin N → K)) = 1 := by
  classical
  haveI : Fact (Irreducible a) := ⟨irreducible_of_mem_primaryFactors ha⟩
  let a' : primaryFactors (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) := ⟨a, ha⟩
  by_cases hself : dualPoly h.bar a = a
  · obtain ⟨hE, Hf, hHf, hHfl, φ, hφ, hdetK⟩ :=
      exists_selfDualFactor hself (selfDualPrimaryBlock H a' hself)
    let D : sesqUnitaryGroup Hf →* (AdjoinRoot a)ˣ :=
      (blockGLDet (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a).comp
        (sesqUnitaryGroup Hf).subtype
    have hcompat : ∀ s : orbitFactor (idForm h N) (ggK1Abu_iota N nf K xhat) a,
        ((φ s : sesqUnitaryGroup Hf) :
            blockGL (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a) =
          blockRestrict (ggK1Abu_iota N nf K xhat) a
            ⟨s.1, orbitFactor_le_gl_centralizer s.2⟩ :=
      fun s => blockGL_ext fun v hv => hφ s v hv
    have hspec : specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a =
        kerImage (orbitFactor (idForm h N) (ggK1Abu_iota N nf K xhat) a) φ D := by
      ext g
      rw [mem_specialBlock, mem_kerImage]
      constructor
      · intro hg'
        obtain ⟨hs, hgc, hdet⟩ := hg'
        refine ⟨hs, ?_⟩
        change blockGLDet (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a
          ((φ ⟨g, hs⟩ : sesqUnitaryGroup Hf) :
            blockGL (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a) = 1
        rw [hcompat ⟨g, hs⟩]
        exact hdet
      · intro hg'
        obtain ⟨hs, hdet⟩ := hg'
        refine ⟨hs, orbitFactor_le_gl_centralizer hs, ?_⟩
        change blockGLDet (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a
          ((φ ⟨g, hs⟩ : sesqUnitaryGroup Hf) :
            blockGL (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a) = 1 at hdet
        rw [hcompat ⟨g, hs⟩] at hdet
        exact hdet
    rw [hspec, mem_kerImage] at hg
    obtain ⟨hs, h⟩ := hg
    refine hdetK ⟨g, hs⟩ ?_
    have h1 : ((φ ⟨g, hs⟩ : sesqUnitaryGroup Hf) :
        blockGL (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a) ∈
          sesqUnitaryGroup Hf := (φ ⟨g, hs⟩).2
    rw [mem_sesqSpecialUnitaryGroup]
    refine ⟨h1, ?_⟩
    have := congrArg Units.val h
    simpa [D, blockGLDet] using this
  · obtain ⟨φ, hφ, hdetK⟩ :=
      exists_pairedFactor (pairedPrimaryBlock H a' (Ne.symm hself))
    have hcompat : ∀ s : orbitFactor (idForm h N) (ggK1Abu_iota N nf K xhat) a,
        φ s = blockRestrict (ggK1Abu_iota N nf K xhat) a
          ⟨s.1, orbitFactor_le_gl_centralizer s.2⟩ :=
      fun s => blockGL_ext fun v hv => hφ s v hv
    have hspec : specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a =
        kerImage (orbitFactor (idForm h N) (ggK1Abu_iota N nf K xhat) a) φ
          (blockGLDet (ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K)) a) := by
      ext g
      rw [mem_specialBlock, mem_kerImage]
      constructor
      · intro hg'
        obtain ⟨hs, hgc, hdet⟩ := hg'
        refine ⟨hs, ?_⟩
        rw [hcompat ⟨g, hs⟩]
        exact hdet
      · intro hg'
        obtain ⟨hs, hdet⟩ := hg'
        refine ⟨hs, orbitFactor_le_gl_centralizer hs, ?_⟩
        rw [hcompat ⟨g, hs⟩] at hdet
        exact hdet
    rw [hspec, mem_kerImage] at hg
    obtain ⟨hs, h⟩ := hg
    refine hdetK ⟨g, hs⟩ ?_
    have := congrArg Units.val h
    simpa [blockGLDet] using this

private theorem ggK1Abu_specialBlock_le_range {nf N : ℕ} {K : Type} [Field K] [Finite K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1)) :
    specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a ≤ (ggK1Abu_iota N nf K).range := by
  rw [ggK1Abu_range_iota h]
  intro g hg
  refine mem_sesqSpecialUnitaryGroup.mpr ⟨?_, ggK1Abu_det_eq_one_of_mem_specialBlock h xhat H ha hg⟩
  exact (specialBlock_le_unitaryCentralizer hg).1

private noncomputable def ggK1Abu_A_equiv_specialBlock {nf N : ℕ} {K : Type} [Field K] [Finite K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1)) :
    ggK1Abu_A h xhat a ≃* specialBlock (idForm h N) (ggK1Abu_iota N nf K xhat) a :=
  (Subgroup.equivMapOfInjective (ggK1Abu_A h xhat a) (ggK1Abu_iota N nf K)
      (ggK1Abu_iota_injective N nf K)).trans
    (MulEquiv.subgroupCongr (by
      rw [ggK1Abu_A, Subgroup.map_comap_eq,
        inf_eq_right.mpr (ggK1Abu_specialBlock_le_range h xhat H ha)]))

private theorem ggK1Abu_A_model {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (h : UnitaryFieldData 2 nf K)
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1)) :
    ggK1ACo_Kind.Model nf K (ggK1Abu_kind h xhat a) (ggK1Abu_A h xhat a) := by
  classical
  have hd1 : a.natDegree = 1 := ggK1Abu_natDegree_eq_one hp hp2 hnf hK hdvd hxp ha
  haveI : Fact (Irreducible a) := ⟨irreducible_of_mem_primaryFactors ha⟩
  haveI : Finite (AdjoinRoot a) := Module.finite_of_finite K
  haveI : Fintype (AdjoinRoot a) := Fintype.ofFinite _
  have hcard : Fintype.card (AdjoinRoot a) = (2 ^ nf) ^ 2 := by
    rw [← Nat.card_eq_fintype_card, natCard_adjoinRoot h, hd1, mul_one]
    ring
  by_cases hself : dualPoly h.bar a = a
  · have hkind : ggK1Abu_kind h xhat a =
        ggK1ACo_Kind.su (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 1 := by
      unfold ggK1Abu_kind
      rw [if_pos hself]
    rw [hkind]
    let e1 := ggK1Abu_A_equiv_specialBlock h xhat H ha
    obtain ⟨hE, Hf, hHf, hHfl, ⟨e2⟩⟩ :=
      CFSG.HardMathSupport.Dickson.Sec6.nonempty_specialBlock_mulEquiv_sesqSU hself
        (selfDualPrimaryBlock H ⟨a, ha⟩ hself)
    haveI : FiniteDimensional (AdjoinRoot a) ↥(primaryComponent (ggK1A_glEnd xhat.1) a) :=
      Module.Finite.of_restrictScalars_finite K (AdjoinRoot a) _
    obtain ⟨b, hb⟩ := hE.exists_orthonormal_basis (B := Hf) hHf hHfl
    obtain ⟨e3⟩ := CFSG.RankThree.CentralLift.nonempty_sesqSpecialUnitaryGroup_mulEquiv_gramSU hE b
      (G := (1 : Matrix (Fin (primaryMultiplicity (ggK1A_glEnd xhat.1) a))
        (Fin (primaryMultiplicity (ggK1A_glEnd xhat.1) a)) (AdjoinRoot a)))
      (fun i j => hb i j)
    have hgram : gramSU hE (1 : Matrix (Fin (primaryMultiplicity (ggK1A_glEnd xhat.1) a))
        (Fin (primaryMultiplicity (ggK1A_glEnd xhat.1) a)) (AdjoinRoot a)) =
        StatedSU (primaryMultiplicity (ggK1A_glEnd xhat.1) a) ((2 ^ nf) ^ 1) (AdjoinRoot a) := by
      rw [pow_one]
      rw [← unitarySU_eq_gramSU hE]
      show StatedSU (primaryMultiplicity (ggK1A_glEnd xhat.1) a) (2 ^ (nf * a.natDegree))
          (AdjoinRoot a) = StatedSU (primaryMultiplicity (ggK1A_glEnd xhat.1) a) (2 ^ nf)
            (AdjoinRoot a)
      rw [hd1, mul_one]
    exact ⟨AdjoinRoot a, inferInstance, inferInstance, hcard,
      ⟨(e1.trans e2).trans (e3.trans (MulEquiv.subgroupCongr hgram))⟩⟩
  · have hkind : ggK1Abu_kind h xhat a =
        ggK1ACo_Kind.sl (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 2 := by
      unfold ggK1Abu_kind
      rw [if_neg hself]
    rw [hkind]
    let e1 := ggK1Abu_A_equiv_specialBlock h xhat H ha
    obtain ⟨e2⟩ := CFSG.HardMathSupport.Dickson.Sec6.nonempty_specialBlock_mulEquiv_SL
      (pairedPrimaryBlock H ⟨a, ha⟩ (Ne.symm hself))
    exact ⟨AdjoinRoot a, inferInstance, inferInstance, hcard,
      ⟨MulEquiv.trans e1 e2⟩⟩

private theorem ggK1Abu_palindrome_drop {H : ℕ} {l : List ℕ} (hlen : l.length = 2 * H)
    (hpal : ∀ j, j < 2 * H → l.getD j 0 = l.getD (2 * H - 1 - j) 0) :
    l.drop H = (l.take H).reverse := by
  apply List.ext_getElem
  · rw [List.length_drop, List.length_reverse, List.length_take, hlen]; omega
  · intro i hi1 hi2
    have hH : H ≤ l.length := by omega
    have hdrop_len : (l.drop H).length = H := by rw [List.length_drop, hlen]; omega
    have htake_len : (l.take H).length = H := by rw [List.length_take, hlen]; omega
    have h1 : H + i < 2 * H := by omega
    have h2 : 2 * H - 1 - (H + i) = H - 1 - i := by omega
    have hd : (l.drop H).getD i 0 = l.getD (H + i) 0 := by
      rw [List.getD_eq_getElem (l.drop H) 0 (by rw [hdrop_len]; omega)]
      rw [List.getElem_drop (h := by rw [hdrop_len]; omega)]
      rw [← List.getD_eq_getElem l 0 (by omega : H + i < l.length)]
    have hr : ((l.take H).reverse).getD i 0 = l.getD (H - 1 - i) 0 := by
      rw [List.getD_eq_getElem ((l.take H).reverse) 0
        (by rw [List.length_reverse, htake_len]; omega)]
      rw [List.getElem_reverse (h := by rw [List.length_reverse, htake_len]; omega)]
      simp only [htake_len]
      rw [List.getElem_take (h := by omega)]
      rw [← List.getD_eq_getElem l 0 (by omega : H - 1 - i < l.length)]
    rw [← List.getD_eq_getElem (l.drop H) 0 (by rw [hdrop_len]; omega),
      ← List.getD_eq_getElem ((l.take H).reverse) 0 (by rw [List.length_reverse, htake_len]; omega)]
    rw [hd, hr, ← h2]
    exact hpal (H + i) h1

private theorem ggK1Abu_palindrome_filter {H : ℕ} {l : List ℕ} (hlen : l.length = 2 * H)
    (hpal : ∀ j, j < 2 * H → l.getD j 0 = l.getD (2 * H - 1 - j) 0) :
    Multiset.ofList (l.filter (fun x => decide (x ≠ 0))) =
      Multiset.ofList ((l.take H).filter (fun x => decide (x ≠ 0))) +
        Multiset.ofList ((l.take H).filter (fun x => decide (x ≠ 0))) := by
  have hdrop := ggK1Abu_palindrome_drop hlen hpal
  have hsplit : l = l.take H ++ l.drop H := (List.take_append_drop H l).symm
  rw [show Multiset.ofList (l.filter (fun x => decide (x ≠ 0))) =
      Multiset.ofList ((l.take H).filter (fun x => decide (x ≠ 0)) ++
        ((l.take H).filter (fun x => decide (x ≠ 0))).reverse) from by
    conv_lhs => rw [hsplit, List.filter_append, hdrop, List.filter_reverse]]
  rw [Multiset.coe_add, Multiset.coe_eq_coe]
  exact (List.reverse_perm _).append_left _

private theorem ggK1Abu_getD_tail (l : List ℕ) (j : ℕ) :
    l.tail.getD j 0 = l.getD (j + 1) 0 := by
  cases l with
  | nil => rfl
  | cons a t => rfl

private theorem ggK1Abu_tail_filter_symm {p : ℕ} {m : List ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hlen : m.length = p)
    (hsym : ∀ j, j < p → m.getD ((p - j) % p) 0 = m.getD j 0) :
    Multiset.ofList (m.tail.filter (fun j => decide (j ≠ 0))) =
      2 • Multiset.ofList (((List.range (p / 2 + 1)).filter
        (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0))).map (fun j => m.getD j 0)) := by
  obtain ⟨k, hk⟩ := hp.odd_of_ne_two hp2
  have hH : 2 * (p / 2) = p - 1 := by rw [hk]; omega
  have hlen_tail : m.tail.length = 2 * (p / 2) := by
    rw [List.length_tail, hlen, hH]
  have hpal : ∀ j, j < 2 * (p / 2) →
      m.tail.getD j 0 = m.tail.getD (2 * (p / 2) - 1 - j) 0 := by
    intro j hj
    have hj1 : j + 1 < p := by omega
    rw [show m.tail.getD j 0 = m.getD (j + 1) 0 from ggK1Abu_getD_tail m j,
      show m.tail.getD (2 * (p / 2) - 1 - j) 0 = m.getD (2 * (p / 2) - 1 - j + 1) 0 from
        ggK1Abu_getD_tail m (2 * (p / 2) - 1 - j)]
    have h2 : 2 * (p / 2) - 1 - j + 1 = p - 1 - j := by omega
    rw [h2]
    have hsym_j := hsym (j + 1) (by omega)
    have hmod : (p - (j + 1)) % p = p - 1 - j := by
      rw [Nat.mod_eq_of_lt (by omega : p - (j + 1) < p)]
      omega
    rw [hmod] at hsym_j
    exact hsym_j.symm
  have hpf := ggK1Abu_palindrome_filter hlen_tail hpal
  rw [hpf, two_smul]
  have htake_drop : (m.take (p / 2 + 1)).drop 1 = m.tail.take (p / 2) := by
    have hdrop : List.drop 1 m = m.tail := by
      cases m with
      | nil => rfl
      | cons a t => rfl
    rw [List.drop_take, show (p / 2 + 1) - 1 = p / 2 by omega, hdrop]
  have htail_map := ggK1CBl_tail_filter_map (m.take (p / 2 + 1)) id
  rw [List.length_take, min_eq_left (by omega : p / 2 + 1 ≤ m.length),
    htake_drop] at htail_map
  simp only [id_eq, List.map_id] at htail_map
  have hgetD : ∀ j, j < p / 2 + 1 → (m.take (p / 2 + 1)).getD j 0 = m.getD j 0 := by
    intro j hj
    rw [List.getD_eq_getElem _ _ (by rw [List.length_take, min_eq_left (by omega)]; omega),
      List.getD_eq_getElem _ _ (by omega), List.getElem_take]
  have hfilter : List.filter (fun j => decide (1 ≤ j ∧ 1 ≤ (m.take (p / 2 + 1)).getD j 0))
        (List.range (p / 2 + 1)) =
      List.filter (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0)) (List.range (p / 2 + 1)) := by
    apply List.filter_congr
    intro j hj
    rw [List.mem_range] at hj
    rw [hgetD j hj]
    simp only [decide_eq_decide]
    omega
  have hmap : List.map (fun j => (m.take (p / 2 + 1)).getD j 0)
        (List.filter (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0)) (List.range (p / 2 + 1))) =
      List.map (fun j => m.getD j 0)
        (List.filter (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0)) (List.range (p / 2 + 1))) := by
    apply List.map_congr_left
    intro j hj
    exact hgetD j (by
      have := (List.mem_filter.mp hj).1
      simpa using this)
  have hlist : List.filter (fun x => decide (x ≠ 0)) (List.take (p / 2) m.tail) =
      List.map (fun j => m.getD j 0)
        (List.filter (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0)) (List.range (p / 2 + 1))) := by
    rw [← htail_map, hfilter, hmap]
  have hAB : Multiset.ofList (List.filter (fun x => decide (x ≠ 0)) (List.take (p / 2) m.tail)) =
      Multiset.ofList (List.map (fun j => m.getD j 0)
        (List.filter (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0)) (List.range (p / 2 + 1)))) :=
    congrArg Multiset.ofList hlist
  rw [hAB]

private theorem ggK1Abu_kind_multiset_d1 {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1))) {m : List ℕ}
    (hm : GGK1AMultOf p nf N true K (xhat : GL (Fin N) K) m)
    [Fintype (adjointOrbits (ggK1Abu_unitaryFieldData hnf hK) (ggK1Abu_iota N nf K xhat))]
    (hd1 : ggMultOrd p nf = 1) :
    (Finset.univ : Finset (adjointOrbits (ggK1Abu_unitaryFieldData hnf hK)
        (ggK1Abu_iota N nf K xhat))).val.map
      (fun O => ggK1Abu_kind (ggK1Abu_unitaryFieldData hnf hK) xhat
        (ggK1Abu_rep (ggK1Abu_unitaryFieldData hnf hK) xhat O).1) =
      ggK1ACo_expectedKinds p nf true m := by
  classical
  let h : UnitaryFieldData 2 nf K := ggK1Abu_unitaryFieldData hnf hK
  let H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat) :=
    ggK1Abu_primaryData hp hp2 hnf hK hxp
  obtain ⟨P, hP⟩ := exists_isPairedTransversal (hK := h) H
  have honly : ∀ a ∈ primaryFactors (ggK1A_glEnd xhat.1), dualPoly h.bar a = a → a = X - 1 :=
    fun a ha hsd => ggK1Abu_selfDual_eq_X_sub_one hp hp2 hnf hK hdvd hxp hd1 ha hsd
  let e := ggK1Abu_orbitEquivD1 h xhat H honly P hP
  have hsplit : (Finset.univ : Finset (adjointOrbits h (ggK1Abu_iota N nf K xhat))).val.map
      (fun O => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat O).1) =
      (Finset.univ : Finset ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter
          (fun a => a = X - 1))).val.map
        (fun a => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm (Sum.inl a))).1) +
      (Finset.univ : Finset ↥P).val.map
        (fun p => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm (Sum.inr p))).1) := by
    rw [← Finset.univ_map_equiv_to_embedding e.symm, Finset.map_val, Multiset.map_map]
    rw [show (fun O => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat O).1) ∘ e.symm.toEmbedding =
        fun s => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm s)).1 from by
      funext s; rfl]
    rw [ggK1Abu_univ_sum_map]
  rw [hsplit]
  have hA : (Finset.univ : Finset ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter
        (fun a => a = X - 1))).val.map
        (fun a => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm (Sum.inl a))).1) =
      (if 0 < m.headD 0 then ({ggK1ACo_Kind.su (m.headD 0) 1} : Multiset ggK1ACo_Kind)
        else 0) := by
    have hcongr : (Finset.univ : Finset ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter
          (fun a => a = X - 1))).val.map
          (fun a => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm (Sum.inl a))).1) =
        (Finset.univ : Finset ↥((primaryFactors (ggK1A_glEnd xhat.1)).filter
          (fun a => a = X - 1))).val.map (fun a => ggK1Abu_kind h xhat a.1) := by
      refine Multiset.map_congr rfl (fun a _ => ?_)
      rw [ggK1Abu_orbitEquivD1_inl h xhat H honly P hP a]
      exact (congrArg (fun x => ggK1Abu_kind h xhat x) (Finset.mem_filter.mp a.2).2).symm
    rw [hcongr, ggK1CBl_univ_map_subtype_val, ggK1Abu_kind_X1_filter h xhat hsq hm]
  have hB : (Finset.univ : Finset ↥P).val.map
        (fun p => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm (Sum.inr p))).1) =
      P.val.map (fun p => ggK1ACo_Kind.sl (primaryMultiplicity (ggK1A_glEnd xhat.1) p) 2) := by
    have hcongr : (Finset.univ : Finset ↥P).val.map
          (fun p => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat (e.symm (Sum.inr p))).1) =
        (Finset.univ : Finset ↥P).val.map
          (fun p => ggK1ACo_Kind.sl (primaryMultiplicity (ggK1A_glEnd xhat.1) p.1) 2) := by
      refine Multiset.map_congr rfl (fun p _ => ?_)
      have hnsd : dualPoly h.bar (ggK1Abu_rep h xhat (e.symm (Sum.inr p))).1 ≠
          (ggK1Abu_rep h xhat (e.symm (Sum.inr p))).1 := by
        intro hsd
        have hcontra : ggK1Abu_toSum h xhat honly P hP (e.symm (Sum.inr p)) = Sum.inr p :=
          Equiv.apply_symm_apply e (Sum.inr p)
        simp only [ggK1Abu_toSum, dif_pos hsd] at hcontra
        exact Sum.inl_ne_inr hcontra
      unfold ggK1Abu_kind
      rw [if_neg hnsd, ggK1Abu_orbitEquivD1_inr h xhat H honly P hP p]
    rw [hcongr, ggK1CBl_univ_map_subtype_val P
      (fun y => ggK1ACo_Kind.sl (primaryMultiplicity (ggK1A_glEnd xhat.1) y) 2)]
  rw [hA, hB, ggK1Abu_expected_nontrivial hd1]
  congr 1
  have hsym : ∀ j, j < p → m.getD ((p - j) % p) 0 = m.getD j 0 := by
    rcases hm.blocks_eq with ⟨⟨-, htw⟩, -⟩ | ⟨-, hsym, -⟩
    · exact absurd htw (by decide)
    · exact hsym ⟨hd1, rfl⟩
  have htail : Multiset.ofList (m.tail.filter (fun j => decide (j ≠ 0))) =
      (ggK1A_selfDualFactors (xhat : GL (Fin N) K)).val.map
        (primaryMultiplicity (ggK1A_glEnd xhat.1)) := by
    rcases hm.blocks_eq with ⟨⟨-, htw⟩, -⟩ | ⟨-, -, htail⟩
    · exact absurd htw (by decide)
    · exact htail
  have htwo : (2 : ℕ) • P.val.map (primaryMultiplicity (ggK1A_glEnd xhat.1)) =
      2 • Multiset.ofList (((List.range (p / 2 + 1)).filter
        (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0))).map (fun j => m.getD j 0)) := by
    rw [← ggK1Abu_nonSelfDual_map_eq_two_P h xhat H honly P hP]
    change (ggK1A_selfDualFactors (xhat : GL (Fin N) K)).val.map
        (primaryMultiplicity (ggK1A_glEnd xhat.1)) = _
    rw [← htail, ggK1Abu_tail_filter_symm hp hp2 hm.length_eq hsym]
  have hPmult : P.val.map (primaryMultiplicity (ggK1A_glEnd xhat.1)) =
      Multiset.ofList (((List.range (p / 2 + 1)).filter
        (fun j => decide (1 ≤ j ∧ 0 < m.getD j 0))).map (fun j => m.getD j 0)) :=
    ggK1Abu_two_nsmul_cancel htwo
  have hhalf : (p - 1) / 2 = p / 2 := by
    obtain ⟨k, hk⟩ := hp.odd_of_ne_two hp2
    rw [hk]; omega
  rw [hhalf]
  have hmap := congrArg (Multiset.map (fun x => ggK1ACo_Kind.sl x 2)) hPmult
  rw [Multiset.map_map, Multiset.map_coe, List.map_map] at hmap
  exact hmap


private def ggK1Abu_Small (nf m : ℕ) : Prop :=
  m ≤ 1 ∨ (m = 2 ∧ nf = 1) ∨ (m = 3 ∧ nf = 1)

private theorem ggK1Abu_two_pow_lt_four {nf : ℕ} (hnf : 1 ≤ nf) : 2 ^ nf < 4 ↔ nf = 1 := by
  constructor
  · intro h
    by_contra hne
    have h2 : 2 ≤ nf := by omega
    have hle : 2 ^ 2 ≤ 2 ^ nf := Nat.pow_le_pow_right (by norm_num) h2
    norm_num at hle
    omega
  · rintro rfl
    norm_num

private theorem ggK1Abu_two_pow_lt_three {nf : ℕ} (hnf : 1 ≤ nf) : 2 ^ nf < 3 ↔ nf = 1 := by
  constructor
  · intro h
    by_contra hne
    have h2 : 2 ≤ nf := by omega
    have hle : 2 ^ 2 ≤ 2 ^ nf := Nat.pow_le_pow_right (by norm_num) h2
    norm_num at hle
    omega
  · rintro rfl
    norm_num

private theorem ggK1Abu_small_iff {nf m : ℕ} (hnf : 1 ≤ nf) :
    (m ≤ 1 ∨ ¬ ((m = 2 → 4 ≤ 2 ^ nf) ∧ (m = 3 → 3 ≤ 2 ^ nf))) ↔ ggK1Abu_Small nf m := by
  unfold ggK1Abu_Small
  constructor
  · rintro (h1 | h2)
    · exact Or.inl h1
    · by_cases hm2 : m = 2
      · subst hm2
        refine Or.inr (Or.inl ⟨rfl, ?_⟩)
        by_contra hne
        exact h2 ⟨fun _ => by
          by_contra hlt; exact hne ((ggK1Abu_two_pow_lt_four hnf).mp (by omega)),
          fun h => by omega⟩
      · by_cases hm3 : m = 3
        · subst hm3
          refine Or.inr (Or.inr ⟨rfl, ?_⟩)
          by_contra hne
          exact h2 ⟨fun h => by omega,
            fun _ => by by_contra hlt; exact hne ((ggK1Abu_two_pow_lt_three hnf).mp (by omega))⟩
        · omega
  · rintro (h1 | ⟨rfl, hnf1⟩ | ⟨rfl, hnf1⟩)
    · exact Or.inl h1
    · right
      subst hnf1
      intro h
      exact absurd (h.1 rfl) (by norm_num)
    · right
      subst hnf1
      intro h
      exact absurd (h.2 rfl) (by norm_num)

private theorem ggK1Abu_conditions_of_not_small {nf m : ℕ} (hnf : 1 ≤ nf)
    (h : ¬ ggK1Abu_Small nf m) :
    2 ≤ m ∧ (m = 2 → 4 ≤ 2 ^ nf) ∧ (m = 3 → 3 ≤ 2 ^ nf) := by
  unfold ggK1Abu_Small at h
  push Not at h
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨by omega, ?_, ?_⟩
  · intro hm
    subst hm
    by_contra h4
    exact h2 rfl ((ggK1Abu_two_pow_lt_four hnf).mp (by omega))
  · intro hm
    subst hm
    by_contra h4
    exact h3 rfl ((ggK1Abu_two_pow_lt_three hnf).mp (by omega))

private theorem ggK1Abu_qs_su {nf m : ℕ} (hm : 1 ≤ m) :
    (ggK1ACo_kindOrbit nf (ggK1ACo_Kind.su m 1)).qs = true ↔ ¬ ggK1Abu_Small nf m := by
  rcases m with _ | _ | _ | m
  · exfalso; omega
  · simp [ggK1ACo_kindOrbit, ggK1Abu_Small]
  · simp [ggK1ACo_kindOrbit, ggMultBlockA, ggK1Abu_Small, decide_eq_true_eq]
  · rcases m with _ | m
    · simp [ggK1ACo_kindOrbit, ggMultBlockA, ggK1Abu_Small, decide_eq_true_eq]
    · have h1 : ¬ (m + 3 = 2) := by omega
      have h2 : ¬ (m + 4 = 2) := by omega
      have h3 : ¬ (m + 4 = 3) := by omega
      have h4 : ¬ (m + 4 ≤ 1) := by omega
      simp [ggK1ACo_kindOrbit, ggMultBlockA, ggK1Abu_Small, decide_eq_true_eq, h1, h2, h3, h4]

private theorem ggK1Abu_qs_sl_two {nf m : ℕ} (hm : 1 ≤ m) :
    (ggK1ACo_kindOrbit nf (ggK1ACo_Kind.sl m 2)).qs = true ↔ 2 ≤ m := by
  rcases m with _ | _ | m
  · exfalso; omega
  · simp [ggK1ACo_kindOrbit]
  · have h : ¬ ((m + 2) - 1 = 1 ∧ 2 * nf = 1) := by
      rintro ⟨-, h⟩; omega
    simp [ggK1ACo_kindOrbit, ggMultBlockA, decide_eq_true_eq, h]

private theorem ggK1Abu_card_primeFactors_two_three (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) :
    (2 ^ a * 3 ^ b).primeFactors.card ≤ 2 := by
  rw [Nat.primeFactors_mul (by positivity) (by positivity),
    Nat.primeFactors_prime_pow ha Nat.prime_two, Nat.primeFactors_prime_pow hb Nat.prime_three]
  exact (Finset.card_union_le _ _).trans (by simp)

private theorem ggK1Abu_isSolvable_of_card_two_three {G : Type*} [Group G] [Finite G] {a b : ℕ}
    (ha : a ≠ 0) (hb : b ≠ 0) (h : Nat.card G = 2 ^ a * 3 ^ b) : Group.IsSolvable G :=
  CFSG.LocalAnalysis.ComponentInitial.isSolvable_of_card_primeFactors_le_two
    (h ▸ ggK1Abu_card_primeFactors_two_three a b ha hb)

private theorem ggK1Abu_finite_generalLinearGroup {ℓ g : ℕ} {E : Type} [Field E]
    (hE : UnitaryFieldData ℓ g E) {W : Type*} [AddCommGroup W] [Module E W]
    [FiniteDimensional E W] : Finite (LinearMap.GeneralLinearGroup E W) := by
  have := hE.finite
  have : Finite W := Module.finite_of_finite E
  have : Finite (Module.End E W) :=
    Finite.of_injective _ (DFunLike.coe_injective (F := W →ₗ[E] W))
  exact Finite.of_injective _ Units.val_injective

private theorem ggK1Abu_isSolvable_sesqUnitaryGroup_of_small {ℓ g : ℕ} {E : Type} [Field E]
    (hE : UnitaryFieldData ℓ g E) {W : Type*} [AddCommGroup W] [Module E W]
    [FiniteDimensional E W] {Hf : W →ₛₗ[hE.bar] W →ₗ[E] E} (hHf : Hf.IsSymm)
    (hHfl : Hf.SeparatingLeft)
    (hsmall : Module.finrank E W ≤ 1 ∨ (¬ ((Module.finrank E W = 2 → 4 ≤ ℓ ^ g) ∧
      (Module.finrank E W = 3 → 3 ≤ ℓ ^ g)))) : Group.IsSolvable ↥(sesqUnitaryGroup Hf) := by
  have hq2 : 2 ≤ ℓ ^ g := by
    have := Nat.one_lt_pow (by have := hE.one_le; omega : g ≠ 0) hE.prime.one_lt
    omega
  haveI := ggK1Abu_finite_generalLinearGroup hE (W := W)
  by_cases hm : 2 ≤ Module.finrank E W
  · have hq : ¬ ((Module.finrank E W = 2 → 4 ≤ ℓ ^ g) ∧
        (Module.finrank E W = 3 → 3 ≤ ℓ ^ g)) := by
      rcases hsmall with h | h
      · omega
      · exact h
    obtain ⟨hcard, -⟩ := CFSG.LinearGroups.unitary_full_group_order hE hHf hHfl
      rfl (by omega : 1 ≤ Module.finrank E W)
    have hexc : (Module.finrank E W = 2 ∧ ℓ ^ g = 2) ∨ (Module.finrank E W = 2 ∧ ℓ ^ g = 3) ∨
        (Module.finrank E W = 3 ∧ ℓ ^ g = 2) := by
      by_contra hn
      push Not at hn
      obtain ⟨h1, h2, h3⟩ := hn
      refine hq ⟨fun h2' => ?_, fun h3' => ?_⟩
      · by_contra hlt
        rcases (show ℓ ^ g = 2 ∨ ℓ ^ g = 3 by omega) with hQ | hQ
        · exact h1 h2' hQ
        · exact h2 h2' hQ
      · by_contra hlt
        exact h3 h3' (by omega)
    rcases hexc with ⟨hm2, hQ⟩ | ⟨hm2, hQ⟩ | ⟨hm3, hQ⟩
    · rw [hm2, hQ] at hcard
      have e : ((2 : ℕ) : ℤ) ^ (2 * (2 - 1) / 2) *
          ∏ i ∈ Finset.Icc 1 2, (((2 : ℕ) : ℤ) ^ i - (-1) ^ i) = 18 := by
        norm_num [Finset.prod_Icc_succ_top]
      have h18 : Nat.card ↥(sesqUnitaryGroup Hf) = 18 := by exact_mod_cast hcard.trans e
      exact ggK1Abu_isSolvable_of_card_two_three (a := 1) (b := 2) (by norm_num) (by norm_num)
        (by rw [h18]; norm_num)
    · rw [hm2, hQ] at hcard
      have e : ((3 : ℕ) : ℤ) ^ (2 * (2 - 1) / 2) *
          ∏ i ∈ Finset.Icc 1 2, (((3 : ℕ) : ℤ) ^ i - (-1) ^ i) = 96 := by
        norm_num [Finset.prod_Icc_succ_top]
      have h96 : Nat.card ↥(sesqUnitaryGroup Hf) = 96 := by exact_mod_cast hcard.trans e
      exact ggK1Abu_isSolvable_of_card_two_three (a := 5) (b := 1) (by norm_num) (by norm_num)
        (by rw [h96]; norm_num)
    · rw [hm3, hQ] at hcard
      have e : ((2 : ℕ) : ℤ) ^ (3 * (3 - 1) / 2) *
          ∏ i ∈ Finset.Icc 1 3, (((2 : ℕ) : ℤ) ^ i - (-1) ^ i) = 648 := by
        norm_num [Finset.prod_Icc_succ_top]
      have h648 : Nat.card ↥(sesqUnitaryGroup Hf) = 648 := by exact_mod_cast hcard.trans e
      exact ggK1Abu_isSolvable_of_card_two_three (a := 3) (b := 4) (by norm_num) (by norm_num)
        (by rw [h648]; norm_num)
  · refine Group.isSolvable_of_comm fun a b => Subtype.ext (Units.ext ?_)
    have := (CFSG.RankThree.PartOne.KCUnitary.End_commute_of_finrank_le_one (E := E) (W := W)
      (by omega) ((a : LinearMap.GeneralLinearGroup E W) : Module.End E W)
      ((b : LinearMap.GeneralLinearGroup E W) : Module.End E W)).eq
    simpa [Subgroup.coe_mul, Units.val_mul] using this

private theorem ggK1Abu_sesqSU_quasisimple_iff {g : ℕ} {E : Type} [Field E]
    (hE : UnitaryFieldData 2 g E) {W : Type*} [AddCommGroup W] [Module E W]
    [FiniteDimensional E W] {Hf : W →ₛₗ[hE.bar] W →ₗ[E] E} (hHf : Hf.IsSymm)
    (hHfl : Hf.SeparatingLeft) :
    CFSG.IsQuasisimple ↥(sesqSpecialUnitaryGroup Hf) ↔
      ¬ ggK1Abu_Small g (Module.finrank E W) := by
  constructor
  · intro hq hsmall
    have hsmall' : Module.finrank E W ≤ 1 ∨
        (¬ ((Module.finrank E W = 2 → 4 ≤ 2 ^ g) ∧
          (Module.finrank E W = 3 → 3 ≤ 2 ^ g))) :=
      (ggK1Abu_small_iff hE.one_le).mpr hsmall
    haveI : Group.IsSolvable ↥(sesqUnitaryGroup Hf) :=
      ggK1Abu_isSolvable_sesqUnitaryGroup_of_small hE hHf hHfl hsmall'
    haveI : Group.IsSolvable ↥(sesqSpecialUnitaryGroup Hf) :=
      Group.isSolvable_of_isSolvable_injective
        (f := Subgroup.inclusion (sesqSpecialUnitaryGroup_le Hf))
        (Subgroup.inclusion_injective (sesqSpecialUnitaryGroup_le Hf))
    haveI : Nontrivial ↥(sesqSpecialUnitaryGroup Hf) :=
      CFSG.LocalCores.isQuasisimple_nontrivial hq
    haveI : Group.IsPerfect ↥(sesqSpecialUnitaryGroup Hf) := hq.1
    exact (Group.IsPerfect.not_isSolvable ↥(sesqSpecialUnitaryGroup Hf)) inferInstance
  · intro hns
    obtain ⟨hm2, hq2, hq3⟩ := ggK1Abu_conditions_of_not_small hE.one_le hns
    exact CFSG.RankThree.PartOne.KCUnitary.isQuasisimple_sesqSpecialUnitaryGroup_of_two_le
      hE hHf hHfl hm2 ⟨hq2, hq3⟩

private theorem ggK1Abu_omega {E : Type} [Field E] {g : ℕ}
    (hE : UnitaryFieldData 2 g E) (hg : g = 1) :
    ∃ c : E, c ≠ 0 ∧ c ≠ 1 ∧ c ^ 3 = 1 ∧ hE.bar c * c = 1 := by
  subst g
  obtain ⟨c, hc⟩ := hE.exists_bar_ne
  have hc0 : c ≠ 0 := by intro h; apply hc; rw [h]; simp
  have hc1 : c ≠ 1 := by intro h; apply hc; rw [h]; simp
  haveI : Finite E := hE.finite
  haveI : Fintype E := Fintype.ofFinite E
  have hcard : Fintype.card E = 4 := by
    rw [← Nat.card_eq_fintype_card, hE.card]; norm_num
  have hc3 : c ^ 3 = 1 := by
    have := FiniteField.pow_card_sub_one_eq_one c hc0
    rwa [hcard] at this
  have hbar : hE.bar c * c = 1 := by
    rw [hE.bar_apply, ← pow_succ]
    exact hc3
  exact ⟨c, hc0, hc1, hc3, hbar⟩

private theorem ggK1Abu_gramSU_order_three_witness {E : Type} [Field E] {g : ℕ}
    (hE : UnitaryFieldData 2 g E) (hg : g = 1) {m : ℕ} (hm : m = 2 ∨ m = 3) :
    ∃ t a : ↥(gramSU hE (1 : Matrix (Fin m) (Fin m) E)), t ^ 3 = 1 ∧ a * t ≠ t * a := by
  obtain ⟨c, hc0, hc1, hc3, hbar⟩ := ggK1Abu_omega hE hg
  have hcne : c ≠ c⁻¹ := by
    intro h
    have h2 : c ^ 2 = 1 := by
      have : c * c = 1 := by
        nth_rewrite 1 [h]
        exact inv_mul_cancel₀ hc0
      simpa [pow_two] using this
    have h3 : c ^ 3 = c := by
      rw [show (3 : ℕ) = 2 + 1 by norm_num, pow_succ, h2, one_mul]
    have h1 : c = 1 := by rw [← h3]; exact hc3
    exact hc1 h1
  have hdiag_pow_two : ∀ (d : Fin 2 → E) (n : ℕ),
      (Matrix.diagonal d : Matrix (Fin 2) (Fin 2) E) ^ n = Matrix.diagonal (d ^ n) := by
    intro d n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ, ih, Matrix.diagonal_mul_diagonal, pow_succ]; rfl
  have hdiag_pow_three : ∀ (d : Fin 3 → E) (n : ℕ),
      (Matrix.diagonal d : Matrix (Fin 3) (Fin 3) E) ^ n = Matrix.diagonal (d ^ n) := by
    intro d n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ, ih, Matrix.diagonal_mul_diagonal, pow_succ]; rfl
  rcases hm with rfl | rfl
  · obtain ⟨Mlam, hMlameq, hMlammem⟩ :=
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag_mem hE hbar
        (i := (0 : Fin 2)) (j := (1 : Fin 2)) (by decide)
    obtain ⟨Msw, hMsweq, hMswmem⟩ :=
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitSignedSwapMatrix_mem (h := hE)
        (i := (0 : Fin 2)) (j := (1 : Fin 2)) (by decide)
    refine ⟨⟨Mlam, hMlammem⟩, ⟨Msw, hMswmem⟩, ?_, ?_⟩
    · apply Subtype.ext
      have hd3 : (CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag c
          (0 : Fin 2) (1 : Fin 2)) ^ 3 = (1 : Fin 2 → E) := by
        funext r; fin_cases r <;> simp [
          CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag, hc3, inv_pow]
      have ht3 : Mlam ^ 3 = 1 := by
        apply Units.ext
        rw [Units.val_one, Units.val_pow_eq_pow_val, hMlameq, hdiag_pow_two, hd3]
        simp
      simpa [Subgroup.coe_pow] using ht3
    · intro hcon
      have hne : Msw * Mlam ≠ Mlam * Msw := by
        intro h
        have h01 := congrArg (fun x : GL (Fin 2) E =>
          (x : Matrix (Fin 2) (Fin 2) E) 0 1) h
        simp [hMsweq, hMlameq, Matrix.mul_apply, Fin.sum_univ_two,
          CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitSignedSwapMatrix,
          CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag] at h01
        exact hcne h01.symm
      exact hne (by
        have := congrArg (fun x : ↥(gramSU hE (1 : Matrix (Fin 2) (Fin 2) E)) =>
          (x : GL (Fin 2) E)) hcon
        simpa [Subgroup.coe_mul] using this)
  · obtain ⟨Mlam, hMlameq, hMlammem⟩ :=
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag_mem hE hbar
        (i := (0 : Fin 3)) (j := (1 : Fin 3)) (by decide)
    obtain ⟨Msw, hMsweq, hMswmem⟩ :=
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitSignedSwapMatrix_mem (h := hE)
        (i := (0 : Fin 3)) (j := (1 : Fin 3)) (by decide)
    refine ⟨⟨Mlam, hMlammem⟩, ⟨Msw, hMswmem⟩, ?_, ?_⟩
    · apply Subtype.ext
      have hd3 : (CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag c
          (0 : Fin 3) (1 : Fin 3)) ^ 3 = (1 : Fin 3 → E) := by
        funext r; fin_cases r <;> simp [
          CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag, hc3, inv_pow]
      have ht3 : Mlam ^ 3 = 1 := by
        apply Units.ext
        rw [Units.val_one, Units.val_pow_eq_pow_val, hMlameq, hdiag_pow_three, hd3]
        simp
      simpa [Subgroup.coe_pow] using ht3
    · intro hcon
      have hne : Msw * Mlam ≠ Mlam * Msw := by
        intro h
        have h01 := congrArg (fun x : GL (Fin 3) E =>
          (x : Matrix (Fin 3) (Fin 3) E) 0 1) h
        simp [hMsweq, hMlameq, Matrix.mul_apply, Fin.sum_univ_three,
          CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitSignedSwapMatrix,
          CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitLambdaDiag] at h01
        exact hcne h01.symm
      exact hne (by
        have := congrArg (fun x : ↥(gramSU hE (1 : Matrix (Fin 3) (Fin 3) E)) =>
          (x : GL (Fin 3) E)) hcon
        simpa [Subgroup.coe_mul] using this)

private theorem ggK1Abu_sesqSU_order_three_witness {E : Type} [Field E] {g : ℕ}
    (hE : UnitaryFieldData 2 g E) (hg : g = 1) {W : Type*} [AddCommGroup W] [Module E W]
    [FiniteDimensional E W] {Hf : W →ₛₗ[hE.bar] W →ₗ[E] E} (hHf : Hf.IsSymm)
    (hHfl : Hf.SeparatingLeft)
    (hm : Module.finrank E W = 2 ∨ Module.finrank E W = 3) :
    ∃ t a : ↥(sesqSpecialUnitaryGroup Hf), t ^ 3 = 1 ∧ a * t ≠ t * a := by
  obtain ⟨b, hb⟩ := hE.exists_orthonormal_basis hHf hHfl
  obtain ⟨eGram⟩ := CFSG.RankThree.CentralLift.nonempty_sesqSpecialUnitaryGroup_mulEquiv_gramSU
    hE b (G := (1 : Matrix (Fin (Module.finrank E W)) (Fin (Module.finrank E W)) E))
      (fun i j => by rw [hb i j, Matrix.one_apply])
  obtain ⟨t, a, ht3, hne⟩ :=
    ggK1Abu_gramSU_order_three_witness hE hg (m := Module.finrank E W) hm
  exact ⟨eGram.symm t, eGram.symm a,
    by rw [← map_pow, ht3, map_one],
    fun h => hne (eGram.symm.injective (by simpa only [map_mul] using h))⟩

private theorem ggK1Abu_isQuasisimple_iff {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1)))
    (h : UnitaryFieldData 2 nf K)
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1)) :
    CFSG.IsQuasisimple ↥(ggK1Abu_A h xhat a) ↔
      (ggK1ACo_kindOrbit nf (ggK1Abu_kind h xhat a)).qs = true := by
  classical
  haveI : Fact (Irreducible a) := ⟨irreducible_of_mem_primaryFactors ha⟩
  haveI : Nontrivial (primaryComponent (ggK1A_glEnd xhat.1) a) :=
    Submodule.nontrivial_iff_ne_bot.mpr (primaryComponent_ne_bot hsq ha)
  have hm1 : 1 ≤ primaryMultiplicity (ggK1A_glEnd xhat.1) a := by
    have hpos := Module.finrank_pos (R := AdjoinRoot a)
      (M := primaryComponent (ggK1A_glEnd xhat.1) a)
    change 1 ≤ Module.finrank (AdjoinRoot a) (primaryComponent (ggK1A_glEnd xhat.1) a)
    omega
  by_cases hself : dualPoly h.bar a = a
  · have hkind : ggK1Abu_kind h xhat a =
        ggK1ACo_Kind.su (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 1 := by
      unfold ggK1Abu_kind
      rw [if_pos hself]
    rw [hkind, ggK1Abu_qs_su hm1]
    obtain ⟨hE, Hf, hHf, hHfl, ⟨eSB⟩⟩ :=
      CFSG.HardMathSupport.Dickson.Sec6.nonempty_specialBlock_mulEquiv_sesqSU hself
        (selfDualPrimaryBlock H ⟨a, ha⟩ hself)
    have eA : ggK1Abu_A h xhat a ≃* sesqSpecialUnitaryGroup Hf :=
      (ggK1Abu_A_equiv_specialBlock h xhat H ha).trans eSB
    have hSU : CFSG.IsQuasisimple ↥(sesqSpecialUnitaryGroup Hf) ↔
        ¬ ggK1Abu_Small nf (primaryMultiplicity (ggK1A_glEnd xhat.1) a) := by
      have hd : a.natDegree = 1 := ggK1Abu_natDegree_eq_one hp hp2 hnf hK hdvd hxp ha
      have hmain := ggK1Abu_sesqSU_quasisimple_iff hE hHf hHfl
      have hnf' : nf * a.natDegree = nf := by rw [hd, mul_one]
      have harg : Module.finrank (AdjoinRoot a)
          (primaryComponent ((ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K))) a) =
          primaryMultiplicity (ggK1A_glEnd xhat.1) a := by
        rw [ggK1Abu_iota_coe]
      refine hmain.trans ?_
      show (¬ ggK1Abu_Small (nf * a.natDegree)
          (Module.finrank (AdjoinRoot a)
            (primaryComponent ((ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K))) a))) ↔
        ¬ ggK1Abu_Small nf (primaryMultiplicity (ggK1A_glEnd xhat.1) a)
      rw [hnf', harg]
    exact ⟨fun hq => hSU.mp (CFSG.LocalCores.isQuasisimple_of_mulEquiv eA hq),
      fun hns => CFSG.LocalCores.isQuasisimple_of_mulEquiv eA.symm (hSU.mpr hns)⟩
  · have hkind : ggK1Abu_kind h xhat a =
        ggK1ACo_Kind.sl (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 2 := by
      unfold ggK1Abu_kind
      rw [if_neg hself]
    rw [hkind, ggK1Abu_qs_sl_two hm1]
    have hmodel := ggK1Abu_A_model hp hp2 hnf hK hdvd hxp h H ha
    rw [hkind] at hmodel
    obtain ⟨E, hEfield, hEfintype, hcard, ⟨eA⟩⟩ := hmodel
    letI : Field E := hEfield
    letI : Fintype E := hEfintype
    have hcard4 : 4 ≤ Fintype.card E := by
      rw [hcard]
      calc 4 = (2 ^ 1) ^ 2 := by norm_num
        _ ≤ (2 ^ nf) ^ 2 := by
            exact Nat.pow_le_pow_left (Nat.pow_le_pow_right (by norm_num) hnf) 2
    have hSL : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup
        (Fin (primaryMultiplicity (ggK1A_glEnd xhat.1) a)) E) ↔
        2 ≤ primaryMultiplicity (ggK1A_glEnd xhat.1) a := by
      constructor
      · intro hq
        by_contra hmlt
        have hm01 : primaryMultiplicity (ggK1A_glEnd xhat.1) a = 0 ∨
            primaryMultiplicity (ggK1A_glEnd xhat.1) a = 1 := by omega
        haveI : Subsingleton (Matrix.SpecialLinearGroup
            (Fin (primaryMultiplicity (ggK1A_glEnd xhat.1) a)) E) := by
          rcases hm01 with h0 | h1
          · rw [h0]; exact Matrix.SpecialLinearGroup.subsingleton_of_subsingleton
          · rw [h1]; exact Matrix.SpecialLinearGroup.subsingleton_of_subsingleton
        obtain ⟨-, -, u, v, huv⟩ := hq
        exact huv (Subsingleton.elim _ _)
      · intro hm2
        obtain ⟨s, -, hs⟩ := Finset.exists_subset_card_eq hcard4
        exact CFSG.RankThree.PartOne.KCUnitary.isQuasisimple_SL hm2 (Or.inr ⟨s, hs⟩)
    exact ⟨fun hq => hSL.mp (CFSG.LocalCores.isQuasisimple_of_mulEquiv eA hq),
      fun hm2 => CFSG.LocalCores.isQuasisimple_of_mulEquiv eA.symm (hSL.mpr hm2)⟩

private theorem ggK1Abu_witness_transfer {G H : Type} [Group G] [Group H]
    {A : Subgroup G} (e : ↥A ≃* H) {t a : H} (ht : t ^ 3 = 1) (hne : a * t ≠ t * a)
    (p : ℕ) (hp : p = 3) :
    ∃ t' ∈ A, t' ^ p = 1 ∧ ∃ a' ∈ A, a' * t' ≠ t' * a' := by
  refine ⟨((e.symm t : ↥A) : G), (e.symm t).2, ?_,
    ((e.symm a : ↥A) : G), (e.symm a).2, ?_⟩
  · rw [hp, ← Subgroup.coe_pow]
    have h : (e.symm t) ^ 3 = 1 := (map_pow e.symm t 3).symm.trans (by rw [ht, map_one])
    simpa using congrArg Subtype.val h
  · intro hcon
    have hA : (e.symm a : ↥A) * e.symm t = e.symm t * e.symm a := by
      apply Subtype.ext
      simpa [Subgroup.coe_mul] using hcon
    exact hne (by
      have h2 := congrArg e hA
      simpa [map_mul, e.apply_symm_apply] using h2)

private theorem ggK1Abu_hsolv_aux {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1)
    (hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1)))
    (h : UnitaryFieldData 2 nf K)
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1))
    (hh : (ggK1ACo_Kind.hasOrbit (ggK1Abu_kind h xhat a)) = true)
    (hqs : (ggK1ACo_kindOrbit nf (ggK1Abu_kind h xhat a)).qs = false) :
    ∃ t ∈ ggK1Abu_A h xhat a, t ^ p = 1 ∧
      ∃ a' ∈ ggK1Abu_A h xhat a, a' * t ≠ t * a' := by
  classical
  haveI : Fact (Irreducible a) := ⟨irreducible_of_mem_primaryFactors ha⟩
  haveI : Nontrivial (primaryComponent (ggK1A_glEnd xhat.1) a) :=
    Submodule.nontrivial_iff_ne_bot.mpr (primaryComponent_ne_bot hsq ha)
  have hm1 : 1 ≤ primaryMultiplicity (ggK1A_glEnd xhat.1) a := by
    have hpos := Module.finrank_pos (R := AdjoinRoot a)
      (M := primaryComponent (ggK1A_glEnd xhat.1) a)
    change 1 ≤ Module.finrank (AdjoinRoot a) (primaryComponent (ggK1A_glEnd xhat.1) a)
    omega
  by_cases hself : dualPoly h.bar a = a
  · have hkind : ggK1Abu_kind h xhat a =
        ggK1ACo_Kind.su (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 1 := by
      unfold ggK1Abu_kind
      rw [if_pos hself]
    rw [hkind] at hh hqs
    have hmne : primaryMultiplicity (ggK1A_glEnd xhat.1) a ≠ 1 := by
      intro h1
      rw [h1] at hh
      simp [ggK1ACo_Kind.hasOrbit] at hh
    have hsmall : ggK1Abu_Small nf (primaryMultiplicity (ggK1A_glEnd xhat.1) a) := by
      by_contra hc
      have htrue := (ggK1Abu_qs_su (nf := nf) hm1).mpr hc
      rw [htrue] at hqs
      exact Bool.noConfusion hqs
    unfold ggK1Abu_Small at hsmall
    have hnf1 : nf = 1 := by
      rcases hsmall with h1 | ⟨-, h⟩ | ⟨-, h⟩
      · omega
      · exact h
      · exact h
    have hm23 : primaryMultiplicity (ggK1A_glEnd xhat.1) a = 2 ∨
        primaryMultiplicity (ggK1A_glEnd xhat.1) a = 3 := by
      rcases hsmall with h1 | ⟨h, -⟩ | ⟨h, -⟩
      · omega
      · exact Or.inl h
      · exact Or.inr h
    have hd : a.natDegree = 1 := ggK1Abu_natDegree_eq_one hp hp2 hnf hK hdvd hxp ha
    have hp3 : p = 3 := by
      have h3 : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1 := hdvd
      rw [hnf1] at h3
      norm_num at h3
      rcases h3 with h3 | h3
      · exact absurd h3 hp.ne_one
      · exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h3
    obtain ⟨hE, Hf, hHf, hHfl, ⟨eSB⟩⟩ :=
      CFSG.HardMathSupport.Dickson.Sec6.nonempty_specialBlock_mulEquiv_sesqSU hself
        (selfDualPrimaryBlock H ⟨a, ha⟩ hself)
    have hfind : Module.finrank (AdjoinRoot a)
        (primaryComponent ((ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K))) a) =
        primaryMultiplicity (ggK1A_glEnd xhat.1) a := by
      rw [ggK1Abu_iota_coe]
    have hg : nf * a.natDegree = 1 := by rw [hnf1, hd, mul_one]
    have hdim : Module.finrank (AdjoinRoot a)
        (primaryComponent ((ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K))) a) = 2 ∨
        Module.finrank (AdjoinRoot a)
        (primaryComponent ((ggK1Abu_iota N nf K xhat : Module.End K (Fin N → K))) a) = 3 := by
      rcases hm23 with hm2 | hm3
      · left; rw [hfind, hm2]
      · right; rw [hfind, hm3]
    obtain ⟨t, a', ht3, hne⟩ := ggK1Abu_sesqSU_order_three_witness hE hg hHf hHfl hdim
    obtain ⟨eA⟩ : Nonempty (ggK1Abu_A h xhat a ≃* sesqSpecialUnitaryGroup Hf) :=
      ⟨(ggK1Abu_A_equiv_specialBlock h xhat H ha).trans eSB⟩
    exact ggK1Abu_witness_transfer eA ht3 hne p hp3
  · have hkind : ggK1Abu_kind h xhat a =
        ggK1ACo_Kind.sl (primaryMultiplicity (ggK1A_glEnd xhat.1) a) 2 := by
      unfold ggK1Abu_kind
      rw [if_neg hself]
    rw [hkind] at hh hqs
    have hmne : primaryMultiplicity (ggK1A_glEnd xhat.1) a ≠ 1 := by
      intro h1
      rw [h1] at hh
      simp [ggK1ACo_Kind.hasOrbit] at hh
    have hm2 : 2 ≤ primaryMultiplicity (ggK1A_glEnd xhat.1) a := by omega
    have htrue := (ggK1Abu_qs_sl_two (nf := nf) hm1).mpr hm2
    rw [htrue] at hqs
    exact Bool.noConfusion hqs

private theorem ggK1Abu_fixSub_eq_fixSubgroup {X : Type*} [Group X] (α : MulAut X) :
    ggFixSub α = CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α := by
  ext g
  rw [mem_ggFixSub, CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup]

private theorem ggK1Abu_isSolvable_pi_finite {ι : Type*} [Finite ι] {G : ι → Type*}
    [∀ i, Group (G i)] [∀ i, Group.IsSolvable (G i)] : Group.IsSolvable (∀ i, G i) := by
  cases nonempty_fintype ι
  have hle : ∀ m : ℕ, derivedSeries (∀ i, G i) m ≤
      Subgroup.pi Set.univ (fun i => derivedSeries (G i) m) := by
    intro m
    induction m with
    | zero =>
      simp only [derivedSeries_zero]
      rw [Subgroup.pi_top]
    | succ m ih =>
      rw [derivedSeries_succ]
      calc ⁅derivedSeries (∀ i, G i) m, derivedSeries (∀ i, G i) m⁆
          ≤ ⁅Subgroup.pi Set.univ (fun i => derivedSeries (G i) m),
              Subgroup.pi Set.univ (fun i => derivedSeries (G i) m)⁆ :=
            Subgroup.commutator_mono ih ih
        _ ≤ Subgroup.pi Set.univ (fun i => ⁅derivedSeries (G i) m, derivedSeries (G i) m⁆) :=
            Subgroup.commutator_pi_pi_le _ _
        _ = Subgroup.pi Set.univ (fun i => derivedSeries (G i) (m + 1)) := by
            simp_rw [derivedSeries_succ]
  choose d hd using fun i => (inferInstance : Group.IsSolvable (G i)).solvable
  refine ⟨⟨Finset.univ.sup d, ?_⟩⟩
  rw [eq_bot_iff]
  refine (hle _).trans ?_
  rw [le_bot_iff, Subgroup.pi_eq_bot_iff]
  intro i
  rw [eq_bot_iff, ← hd i]
  exact derivedSeries_antitone (G i) (Finset.le_sup (f := d) (Finset.mem_univ i))

private theorem ggK1Abu_A_dualPoly {nf N : ℕ} {K : Type} [Field K] [Finite K]
    (h : UnitaryFieldData 2 nf K) (xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)))
    (H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat))
    (hq : 2 ≤ 2 ^ nf) {a : K[X]} (ha : a ∈ primaryFactors (ggK1A_glEnd xhat.1))
    (hgood : IsGoodBlock h (ggK1Abu_iota N nf K xhat) ⟨a, ha⟩) :
    ggK1Abu_A h xhat (dualPoly h.bar a) = ggK1Abu_A h xhat a := by
  classical
  let x : LinearMap.GeneralLinearGroup K (Fin N → K) := ggK1Abu_iota N nf K xhat
  let H' : UnitaryPrimaryData h.bar (idForm h N) x := H
  by_cases hself : dualPoly h.bar a = a
  · rw [hself]
  · have hda : dualPoly h.bar a ∈ primaryFactors (ggK1A_glEnd xhat.1) :=
      dualPoly_mem_primaryFactors H ha
    let a' : primaryFactors (ggK1A_glEnd xhat.1) := ⟨dualPoly h.bar a, hda⟩
    have hne' : dualPoly h.bar a'.1 ≠ a'.1 := by
      intro hh
      have h2 := congrArg (dualPoly h.bar) hh
      rw [dualPoly_dualPoly_of_mem H hda, dualPoly_dualPoly_of_mem H ha] at h2
      exact hself h2
    have hm : 2 ≤ primaryMultiplicity (x : Module.End K (Fin N → K)) a := hgood.1
    have hm' : 2 ≤ primaryMultiplicity (x : Module.End K (Fin N → K)) a'.1 := by
      rw [show a'.1 = dualPoly h.bar a from rfl, primaryMultiplicity_dualPoly H' ha]
      exact hm
    have hdual_eq : orbitFactor (idForm h N) x a'.1 =
        orbitFactor (idForm h N) x a := by
      have hs : ({a'.1, dualPoly h.bar a'.1} : Set K[X]) = {a, dualPoly h.bar a} := by
        rw [show a'.1 = dualPoly h.bar a from rfl, dualPoly_dualPoly_of_mem H ha, Set.pair_comm]
      rw [show orbitFactor (idForm h N) x a'.1 =
          supportedUnitary (idForm h N) x {a'.1, dualPoly h.bar a'.1} from rfl,
        show orbitFactor (idForm h N) x a =
          supportedUnitary (idForm h N) x {a, dualPoly h.bar a} from rfl,
        hs]
    have f1 := specialBlockFacts_of_paired (hK := h) (B := idForm h N)
      (x := x) hq ⟨a, ha⟩ (pairedPrimaryBlock H' ⟨a, ha⟩ (Ne.symm hself))
    have f2 := specialBlockFacts_of_paired (hK := h) (B := idForm h N)
      (x := x) hq a' (pairedPrimaryBlock H' a' (Ne.symm hne'))
    have hspec : specialBlock (idForm h N) x (dualPoly h.bar a) =
        specialBlock (idForm h N) x a := by
      rw [show dualPoly h.bar a = a'.1 from rfl,
        ← f2.commutator_eq hm', ← f1.commutator_eq hm, hdual_eq]
    unfold ggK1Abu_A
    rw [hspec]

private theorem ggK1Abu_hcomp {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1) :
    ∀ J : Subgroup ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)),
      CFSG.Assembly.IsComponentOf J (ggFixSub (MulAut.conj xhat)) →
      ∃ i : adjointOrbits (ggK1Abu_unitaryFieldData hnf hK) (ggK1Abu_iota N nf K xhat),
        ggK1Abu_A (ggK1Abu_unitaryFieldData hnf hK) xhat
          (ggK1Abu_rep (ggK1Abu_unitaryFieldData hnf hK) xhat i).1 = J := by
  intro J hJ
  classical
  let h : UnitaryFieldData 2 nf K := ggK1Abu_unitaryFieldData hnf hK
  let H : UnitaryPrimaryData h.bar (idForm h N) (ggK1Abu_iota N nf K xhat) :=
    ggK1Abu_primaryData hp hp2 hnf hK hxp
  let G : Type := ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))
  haveI : Finite G := inferInstance
  let x : LinearMap.GeneralLinearGroup K (Fin N → K) := ggK1Abu_iota N nf K xhat
  have hq : 2 ≤ 2 ^ nf := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ nf := Nat.pow_le_pow_right (by norm_num) hnf
  have hfix : CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat) =
      Subgroup.centralizer ({xhat} : Set G) := by
    rw [← ggK1Abu_fixSub_eq_fixSubgroup (MulAut.conj xhat),
      ggK1Abu_fixSub_conj_eq_centralizer]
  have hcommφ : ∀ g : ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat)),
      Commute ((ggK1Abu_iota N nf K) g.1 : Module.End K (Fin N → K))
        ((ggK1Abu_iota N nf K) xhat : Module.End K (Fin N → K)) := by
    intro g
    have hg : g.1 ∈ Subgroup.centralizer ({xhat} : Set G) := by
      rw [← hfix]; exact g.2
    have hc := Subgroup.mem_centralizer_singleton_iff.mp hg
    have h2 := congrArg (ggK1Abu_iota N nf K) hc
    exact mem_gl_centralizer.mp
      ((Subgroup.mem_centralizer_singleton_iff).mpr (by simpa only [map_mul] using h2))
  let φ : ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat)) →*
      gl_centralizer x :=
    ((ggK1Abu_iota N nf K).comp
        (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj
            xhat)).subtype).codRestrict
      (gl_centralizer x) (fun g => by
        rw [mem_gl_centralizer]
        exact hcommφ g)
  have hφU : ∀ g : ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat)),
      (φ g : LinearMap.GeneralLinearGroup K (Fin N → K)) ∈
        unitaryCentralizer (idForm h N) x :=
    fun g => mem_unitaryCentralizer.mpr
      ⟨(ggK1Abu_iota_mem_sesqSpecialUnitary h g.1).1, hcommφ g⟩
  let Φ := primaryFactors (x : Module.End K (Fin N → K))
  let good := {a : Φ // IsGoodBlock h x a}
  let bad := {a : Φ // ¬ IsGoodBlock h x a}
  let ρ : (b : bad) → ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat)) →*
      blockGL (x : Module.End K (Fin N → K)) (b.1 : K[X]) := fun b =>
    (blockRestrict x (b.1 : K[X])).comp φ
  haveI : ∀ b : bad, Group.IsSolvable ↥(ρ b).range := fun b =>
    CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_isSolvable_range_blockRestrict_of_not_good
      (hK := h) (B := idForm h N) (x := x) hq H b.1 b.2 φ hφU
  haveI : Group.IsSolvable ((b : bad) → ↥(ρ b).range) := ggK1Abu_isSolvable_pi_finite
  haveI : Group.IsSolvable ((b : Φ) → (AdjoinRoot (b : K[X]))ˣ) := inferInstance
  let ψ : ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat)) →*
      ((b : Φ) → (AdjoinRoot (b : K[X]))ˣ) × ((b : bad) → ↥(ρ b).range) :=
    MonoidHom.prod (MonoidHom.pi fun b => (blockDetHom x (b : K[X])).comp φ)
      (MonoidHom.pi fun b => (ρ b).rangeRestrict)
  let F : good → Subgroup G := fun a =>
    (specialBlock (idForm h N) x (a.1 : K[X])).comap (ggK1Abu_iota N nf K)
  have hFmap : ∀ a : good, (F a).map (ggK1Abu_iota N nf K) =
      specialBlock (idForm h N) x (a.1 : K[X]) := fun a =>
    Subgroup.map_comap_eq_self (ggK1Abu_specialBlock_le_range h xhat H a.1.2)
  have hJopen : CFSG.Open.IsComponentOf J
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj xhat)) := by
    have h1 := (CFSG.Assembly.isComponentOf_iff_open).mp hJ
    rwa [ggK1Abu_fixSub_eq_fixSubgroup] at h1
  obtain ⟨a, ha⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.components_of_centralQuotient
      (X := G) (T := G) (π := MonoidHom.id G) (hπ := fun g => ⟨g, rfl⟩)
      (hker := by
        intro y hy
        have hy1 : y = 1 := by simpa using (MonoidHom.mem_ker.mp hy)
        rw [hy1]
        exact Subgroup.one_mem _)
      (α := MulAut.conj xhat) (β := MulAut.conj xhat) (hαβ := fun g => rfl)
      (F := F)
      (hFα := fun i => by
        rw [hfix]
        exact ggK1Abu_A_le_centralizer h xhat i.1.1)
      (hFn := fun i c hc g hg => by
        have hc' : c ∈ Subgroup.centralizer ({xhat} : Set G) := by rw [← hfix]; exact hc
        exact ggK1Abu_conj_mem_A h xhat i.1.1 hc' hg)
      (hFq := fun i =>
        CFSG.LocalCores.isQuasisimple_of_mulEquiv
          (ggK1Abu_A_equiv_specialBlock h xhat H i.1.2).symm
          ((specialBlockFacts_of_good (hK := h) (B := idForm h N) (x := x) H hq i.1
            i.2).quasisimple i.2.1))
      (ψ := ψ)
      (hψ := fun g hg => by
        have hy := hφU g
        have hdet : ∀ b : Φ, blockDetHom x (b : K[X])
            ⟨(φ g : LinearMap.GeneralLinearGroup K (Fin N → K)), hy.2⟩ = 1 :=
          fun b => congrFun (congrArg Prod.fst hg) b
        have hbad : ∀ b : Φ, ¬ IsGoodBlock h x b →
            blockRestrict x (b : K[X])
              ⟨(φ g : LinearMap.GeneralLinearGroup K (Fin N → K)), hy.2⟩ = 1 :=
          fun b hb => congrArg Subtype.val (congrFun (congrArg Prod.snd hg) ⟨b, hb⟩)
        have hmem :=
          CFSG.HardMathSupport.Dickson.Sec6.I1431.t6psuh_mem_iSup_specialBlock_of_blocks
            (H := H) hy hdet hbad
        have hmapsup : (⨆ a : good, F a).map (ggK1Abu_iota N nf K) =
            ⨆ a : good, specialBlock (idForm h N) x (a.1 : K[X]) := by
          rw [Subgroup.map_iSup]
          exact iSup_congr hFmap
        have hk : (ggK1Abu_iota N nf K) g.1 ∈
            (⨆ a : good, F a).map (ggK1Abu_iota N nf K) := by
          rw [hmapsup]
          exact hmem
        obtain ⟨s, hs, hs'⟩ := hk
        have hsg : s = g.1 := ggK1Abu_iota_injective N nf K hs'
        rw [← hsg]
        exact hs)
      J hJopen
  have hJF : ggK1Abu_A h xhat (a.1 : K[X]) = J := by
    rw [ha, Subgroup.map_id]
    rfl
  let O : adjointOrbits h (ggK1Abu_iota N nf K xhat) :=
    ⟨({(a.1 : K[X]), dualPoly h.bar (a.1 : K[X])} : Set K[X]),
      ⟨(a.1 : K[X]), Finset.mem_coe.mpr a.1.2, rfl⟩⟩
  refine ⟨O, ?_⟩
  have hrep : (ggK1Abu_rep h xhat O).1 = (a.1 : K[X]) ∨
      (ggK1Abu_rep h xhat O).1 = dualPoly h.bar (a.1 : K[X]) := by
    have hmem := ggK1Abu_rep_mem h xhat O
    simpa [O] using hmem
  rcases hrep with hrep | hrep
  · rw [hrep, hJF]
  · rw [hrep, ggK1Abu_A_dualPoly h xhat H hq a.1.2 a.2, hJF]

theorem ggK1ACo_uni_blocks_exists {p nf N : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hp2 : p ≠ 2) (hnf : 1 ≤ nf) (hK : Nat.card K = (2 ^ nf) ^ 2)
    (hdvd : p ∣ 2 ^ nf - 1 ∨ p ∣ 2 ^ nf + 1)
    {xhat : ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))} (hxp : xhat ^ p = 1) {m : List ℕ}
    (hm : GGK1AMultOf p nf N true K (xhat : GL (Fin N) K) m) :
    Nonempty (ggK1ACo_Blocks p nf true K N ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf)) xhat m) := by
  let h : UnitaryFieldData 2 nf K := ggK1Abu_unitaryFieldData hnf hK
  have hsq : Squarefree (minpoly K (ggK1A_glEnd xhat.1)) := ggK1Abu_hsq hp hp2 hnf hK hxp
  have H := ggK1Abu_primaryData hp hp2 hnf hK hxp
  haveI hfin : Fintype (adjointOrbits h (ggK1Abu_iota N nf K xhat)) := by
    rw [adjointOrbits]
    exact (Set.Finite.image _ (Finset.finite_toSet _)).fintype
  refine ⟨{
    ι := adjointOrbits h (ggK1Abu_iota N nf K xhat)
    fintype := hfin
    A := fun O => ggK1Abu_A h xhat (ggK1Abu_rep h xhat O).1
    kind := fun O => ggK1Abu_kind h xhat (ggK1Abu_rep h xhat O).1
    hcomm := ?_
    hle := ?_
    kind_multiset := ?_
    hmodel := ?_
    hqsKind := ?_
    hsolv := ?_
    hcomp := ?_
    hfactor := ?_ }⟩
  · intro O O' hOO' a ha b hb
    exact ggK1Abu_comm h xhat H O O' hOO' a ha b hb
  · intro O
    exact ggK1Abu_A_le_centralizer h xhat _
  · rcases ggK1Abu_multOrd_eq_one_or_two hdvd with hd1 | hd2
    · exact ggK1Abu_kind_multiset_d1 hp hp2 hnf hK hdvd hxp hsq hm hd1
    · exact ggK1Abu_kind_multiset_d2 hp hp2 hnf hK hdvd hxp hsq hm hd2
  · intro O
    exact ggK1Abu_A_model hp hp2 hnf hK hdvd hxp h H (ggK1Abu_rep h xhat O).2
  · intro O
    exact ggK1Abu_isQuasisimple_iff hp hp2 hnf hK hdvd hxp hsq h H (ggK1Abu_rep h xhat O).2
  · intro O hh hqs
    exact ggK1Abu_hsolv_aux hp hp2 hnf hK hdvd hxp hsq h H (ggK1Abu_rep h xhat O).2 hh hqs
  · exact ggK1Abu_hcomp hp hp2 hnf hK hxp
  · intro O hq
    have hleO : ggK1Abu_A h xhat (ggK1Abu_rep h xhat O).1 ≤
        Subgroup.centralizer ({xhat} : Set ↥(LargeEvenSUGroup (Fin N) K (2 ^ nf))) :=
      ggK1Abu_A_le_centralizer h xhat _
    refine ⟨?_, ?_, ?_⟩
    · rw [ggK1Abu_fixSub_conj_eq_centralizer]; exact hleO
    · rw [ggK1Abu_fixSub_conj_eq_centralizer]
      refine CFSG.Assembly.IsSubnormal.step hleO ?_ (CFSG.Assembly.IsSubnormal.refl _)
      refine ⟨fun n hn g => ?_⟩
      rw [Subgroup.mem_subgroupOf] at hn ⊢
      exact ggK1Abu_conj_mem_A h xhat _ g.2 hn
    · exact (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native _).mpr hq

