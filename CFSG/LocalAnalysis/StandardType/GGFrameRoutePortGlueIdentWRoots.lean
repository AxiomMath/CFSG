module

public import CFSG.LocalAnalysis.StandardType.GGFrameE78Refl
public import CFSG.Mathlib.Decide.Nodup
import CFSG.LocalAnalysis.StandardType.GGFrameRoutePortGlueIdentWRootsK

public section

namespace CFSG.StandardType.FrameRoute

open CFSG.Assembly

@[expose] def feRootKey {n : ℕ} (v : FEVec n) : ℕ :=
  CFSG.Decide.finFunKey fun i => (⟨(v i).val, ZMod.val_lt (v i)⟩ : Fin 3)

structure FERootList (n L : ℕ) (R : Fin L → FEVec n) : Prop where
  injective : Function.Injective R
  mem_col : ∀ i : Fin n, feCol n i ∈ Set.range R
  closed : ∀ (i : Fin n) (k : Fin L), (feS n i).mulVec (R k) ∈ Set.range R
  neg : ∀ k : Fin L, -R k ∈ Set.range R
  reach : ∀ k : Fin L, 0 < k.val →
    ∃ (i : Fin n) (j : Fin L), j.val < k.val ∧
      R j = (feS n i).mulVec (R k)

private theorem glueIdentWRootsAux_feCol_entry {n : ℕ} (p i : Fin n) :
    feCol n i p = (if p = i then 1 else 0) - feS n i p i := by
  have hrow : feRow n i i = 1 := by
    have h := feRow_dot n i (Pi.single i 1)
    simpa using h
  rw [feS_eq]
  simp only [Matrix.sub_apply, Matrix.one_apply, Matrix.vecMulVec_apply]
  rw [hrow]
  ring

private theorem glueIdentWRootsAux_feCol_eq {n : ℕ} (i : Fin n) :
    feCol n i = fun p => (if p = i then 1 else 0) - feS n i p i := by
  funext p
  exact glueIdentWRootsAux_feCol_entry p i

namespace FERootList

variable {n L : ℕ} {R : Fin L → FEVec n}

theorem neg_of_mem (hR : FERootList n L R) {v : FEVec n}
    (hv : v ∈ Set.range R) : -v ∈ Set.range R := by
  obtain ⟨k, rfl⟩ := hv
  exact hR.neg k

end FERootList

