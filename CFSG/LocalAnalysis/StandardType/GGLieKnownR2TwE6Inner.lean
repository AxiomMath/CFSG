private theorem l10st6i_beta_fixes_A_one
    {f : ℕ} {K : Type} [Field K] [Finite K] (hf : 1 ≤ f) (hf1 : f = 1)
    (hK : Nat.card K = (2 ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ f)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ)
    (δ : K ≃+* K) {β N : MulAut (twistedE6RootGroup K σ)} {m : twistedE6RootGroup K σ}
    (hβeq : β = MulAut.conj m * N)
    (hN : N = compatDiagAutHom TwistTag.E6 K σ.toRingHom u * fieldActor (t := TwistTag.E6) σ δ)
    (hm : (m : ModGL TwistTag.E6.tag K) ∈
      graphFixedParabolicLevi TwistTag.E6 K σ.toRingHom J0)
    {A : Subgroup (ModGL TwistTag.E6.tag K)}
    (hAJ : A ≤ thetaRankOneGroup (algebraMap (fixSubfield σ) K)) :
    ∀ x ∈ A.subgroupOf (twistedE6RootGroup K σ), β x = x := by
  have hk0 : Nat.card (fixSubfield σ) = 2 ^ f :=
    CFSG.GH74.Generic.BProg.B2.PuG2OddAux.card_fixSubfield_quad Nat.prime_two hf hK σ hσ
  have hk1 : Nat.card (fixSubfield σ) = 2 := by rw [hk0, hf1]; norm_num
  have hK1 : Nat.card K = (2 ^ 1) ^ 2 := by rw [hK, hf1]
  have hσ1 : ∀ c, σ c = c ^ 2 ^ 1 := fun c => by rw [hσ c, hf1]
  have hfacts := su6Levi_facts (k := fixSubfield σ) (σ := σ.toRingHom) hf hk0 hK hσ
  have htorBot : thetaTorus (algebraMap (fixSubfield σ) K) = ⊥ := by
    rw [eq_bot_iff]
    rintro y ⟨a, rfl⟩
    have ha : a = 1 := by
      have hc : Nat.card (fixSubfield σ)ˣ = 1 := by rw [Nat.card_units, hk1]
      haveI : Subsingleton (fixSubfield σ)ˣ := (Nat.card_eq_one_iff_unique.1 hc).1
      exact Subsingleton.elim a 1
    rw [ha]; simp
  have hmSu : (m : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom := by
    have h2 : graphFixedParabolicLevi TwistTag.E6 K σ.toRingHom J0 ≤ su6Levi σ.toRingHom := by
      rw [l10st6i_graphFixedParabolicLevi_eq σ.toRingHom, ← hfacts.2.1, htorBot, sup_bot_eq]
    exact h2 hm
  have hsub : Subsingleton (fixSubfield σ)ˣ := by
    have hc : Nat.card (fixSubfield σ)ˣ = 1 := by rw [Nat.card_units, hk1]
    exact (Nat.card_eq_one_iff_unique.1 hc).1
  have hfixk : ∀ c : fixSubfield σ,
      δ.toRingHom (algebraMap (fixSubfield σ) K c) = algebraMap (fixSubfield σ) K c := by
    intro c
    have hc : c = 0 ∨ c = 1 := by
      rcases eq_or_ne c 0 with h | h
      · exact Or.inl h
      · exact Or.inr (congrArg Units.val (Subsingleton.elim (Units.mk0 c h) 1))
    rcases hc with rfl | rfl <;> simp
  have hfixTheta : ∀ x ∈ thetaRankOneGroup (algebraMap (fixSubfield σ) K),
      Units.map (entrywiseHom δ.toRingHom) x = x := by
    intro x hx
    rw [thetaRankOneGroup, thetaRootGroup, thetaNegRootGroup, ← Subgroup.closure_union] at hx
    induction hx using Subgroup.closure_induction with
    | mem z hz =>
        rcases hz with ⟨c, rfl⟩ | ⟨c, rfl⟩
        · rw [CFSG.HardMathSupport.Timmesfeld.LangTorus.entrywise_pinnedX_units, hfixk]
        · rw [CFSG.HardMathSupport.Timmesfeld.LangTorus.entrywise_pinnedX_units, hfixk]
    | one => simp
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv, ha]
  have hθ : rootChar (compatDiag TwistTag.E6 σ.toRingHom u) e6HighestRoot = 1 :=
    rootChar_theta_eq_one_two (σ := σ.toRingHom) hK1 hσ1 (compatDiag_perm u)
  have hdCent : thetaRankOneGroup (algebraMap (fixSubfield σ) K) ≤
      Subgroup.centralizer {rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u)} :=
    thetaRankOneGroup_le_centralizer_rootDiagUnit (algebraMap (fixSubfield σ) K) hθ
  have hsuCent : su6Levi σ.toRingHom ≤
      Subgroup.centralizer (thetaRankOneGroup (algebraMap (fixSubfield σ) K) :
        Set (ModGL TwistTag.E6.tag K)) := hfacts.1
  intro x hx
  have hxA : (x : ModGL TwistTag.E6.tag K) ∈ A := Subgroup.mem_subgroupOf.1 hx
  have hxJ : (x : ModGL TwistTag.E6.tag K) ∈ thetaRankOneGroup (algebraMap (fixSubfield σ) K) :=
    hAJ hxA
  have hΔx : compatDiagAutHom TwistTag.E6 K σ.toRingHom u x = x := by
    refine Subtype.ext ?_
    rw [coe_compatDiagAutHom u x]
    have hc := (Subgroup.mem_centralizer_singleton_iff.1 (hdCent hxJ))
    rw [← hc, mul_assoc, mul_inv_cancel, mul_one]
  have hδx : fieldActor (t := TwistTag.E6) σ δ x = x := by
    refine Subtype.ext ?_
    rw [coe_fieldActor]
    exact hfixTheta _ hxJ
  have hmCent : m * x = x * m := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    exact (Subgroup.mem_centralizer_iff.1 (hsuCent hmSu) (x : ModGL TwistTag.E6.tag K) hxJ).symm
  have hβx : β x = m * (compatDiagAutHom TwistTag.E6 K σ.toRingHom u
      (fieldActor (t := TwistTag.E6) σ δ x)) * m⁻¹ := by
    rw [hβeq, hN]
    simp only [MulAut.mul_apply, MulAut.conj_apply]
  calc β x = m * (compatDiagAutHom TwistTag.E6 K σ.toRingHom u
        (fieldActor (t := TwistTag.E6) σ δ x)) * m⁻¹ := hβx
    _ = m * (compatDiagAutHom TwistTag.E6 K σ.toRingHom u x) * m⁻¹ := by rw [hδx]
    _ = m * x * m⁻¹ := by rw [hΔx]
    _ = x := by rw [show m * x * m⁻¹ = x from by rw [hmCent]; group]


private theorem l10st6i_inner_highest
    {f : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2] (hf : 1 ≤ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    GGRootNormInner (twE6RootSubgroup K σ e6HighestRoot) := by
  intro y hy2 hyR hytriv
  obtain ⟨-, -, -, -, -, -, -, hNF, -, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf K hK σ hσ
  obtain ⟨g, u, δ, hyeq⟩ := hNF y
  let N : MulAut (twistedE6RootGroup K σ) :=
    compatDiagAutHom TwistTag.E6 K σ.toRingHom u * fieldActor (t := TwistTag.E6) σ δ
  have hyeqN : y = MulAut.conj g * N := by
    rw [hyeq]; simp only [N]; group
  have hNle : (twE6RootSubgroup K σ e6HighestRoot).map N.toMonoidHom ≤
      twE6RootSubgroup K σ e6HighestRoot := l10st6i_normalActor_map_le_theta σ u δ
  have hNR : (twE6RootSubgroup K σ e6HighestRoot).map N.toMonoidHom =
      twE6RootSubgroup K σ e6HighestRoot := by
    refine Subgroup.eq_of_le_of_card_ge hNle ?_
    rw [Subgroup.card_map_of_injective N.injective]
  have hconj_le : (twE6RootSubgroup K σ e6HighestRoot).map
      (MulAut.conj g).toMonoidHom ≤ twE6RootSubgroup K σ e6HighestRoot := by
    rintro x ⟨h, hh, rfl⟩
    have hz : N⁻¹ h ∈ twE6RootSubgroup K σ e6HighestRoot := by
      have hm : h ∈ (twE6RootSubgroup K σ e6HighestRoot).map N.toMonoidHom := by
        rw [hNR]; exact hh
      obtain ⟨z, hz, hzN⟩ := hm
      have : N⁻¹ h = z := by rw [← hzN]; exact MulAut.inv_apply_self _ N z
      rw [this]; exact hz
    have hyz : y (N⁻¹ h) ∈ twE6RootSubgroup K σ e6HighestRoot := by
      have := Subgroup.mem_map_of_mem y.toMonoidHom hz
      rwa [hyR] at this
    have heq : g * h * g⁻¹ = y (N⁻¹ h) := by
      rw [hyeqN]
      simp only [MulAut.mul_apply, MulAut.conj_apply, MulAut.apply_inv_self]
    change g * h * g⁻¹ ∈ twE6RootSubgroup K σ e6HighestRoot
    rw [heq]; exact hyz
  have hconj_eq : (twE6RootSubgroup K σ e6HighestRoot).map
      (MulAut.conj g).toMonoidHom = twE6RootSubgroup K σ e6HighestRoot := by
    refine Subgroup.eq_of_le_of_card_ge hconj_le ?_
    rw [Subgroup.card_map_of_injective (MulAut.conj g).injective]
  have hgmem : g ∈ twE6LongRootParabolic (twE6RootSubgroup K σ e6HighestRoot) :=
    l10st6i_mem_normalizer_of_map_eq hconj_eq
  have hgP : (g : ModGL TwistTag.E6.tag K) ∈
      graphFixedParabolic TwistTag.E6 K σ.toRingHom J0 :=
    (mem_twE6LongRootParabolic_iff σ g).1 hgmem
  obtain ⟨-, -, -, -, -, -, hQbot, -, -, -, -, hlevi, -⟩ :=
    diagram_fixed_parabolic_root_radical_Levi_factors TwistTag.E6 K σ J0
  obtain ⟨⟨q0, m0⟩, ⟨hq0, hm0, hgqm0⟩, -⟩ := hlevi g hgP
  have hqC : q0 ∈ graphFixedRootGroup TwistTag.E6 K σ.toRingHom :=
    graphFixedParabolicRadical_le_graphFixedRootGroup (K := K) TwistTag.E6 σ.toRingHom J0 hq0
  have hmC : m0 ∈ graphFixedRootGroup TwistTag.E6 K σ.toRingHom :=
    graphFixedParabolicLevi_le (K := K) TwistTag.E6 σ.toRingHom J0 hm0
  let q : twistedE6RootGroup K σ := ⟨q0, hqC⟩
  let m : twistedE6RootGroup K σ := ⟨m0, hmC⟩
  have hgqm : g = q * m := Subtype.ext (by simpa [q, m] using hgqm0)
  let β : MulAut (twistedE6RootGroup K σ) := MulAut.conj q⁻¹ * y
  have hβeq : β = MulAut.conj m * N := by
    have hqg : q⁻¹ * g = m := by rw [hgqm]; group
    have hconj : MulAut.conj (q⁻¹ * g) = MulAut.conj q⁻¹ * MulAut.conj g := by
      ext z; simp only [MulAut.mul_apply, MulAut.conj_apply]; group
    change MulAut.conj q⁻¹ * y = MulAut.conj m * N
    rw [hyeq]
    calc MulAut.conj q⁻¹ * (MulAut.conj g * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
          fieldActor (t := TwistTag.E6) σ δ)
        = (MulAut.conj q⁻¹ * MulAut.conj g) *
            (compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
              fieldActor (t := TwistTag.E6) σ δ) := by group
      _ = MulAut.conj (q⁻¹ * g) *
            (compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
              fieldActor (t := TwistTag.E6) σ δ) := by rw [← hconj]
      _ = MulAut.conj m * N := by rw [hqg]
  have hk0 : Nat.card (fixSubfield σ) = 2 ^ f :=
    CFSG.GH74.Generic.BProg.B2.PuG2OddAux.card_fixSubfield_quad Nat.prime_two hf hK σ hσ
  have hβfix : ∀ x : twistedE6RootGroup K σ,
      (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom → β x = x :=
    l10st6i_beta_fixes_su6Levi (K := K) hf hK σ hσ (hβ := rfl) hβeq
      (fun x hx => CFSG.StandardType.KGTwE6.normalActor_mapsTo_su6Levi
        (k := ↥(fixSubfield σ)) (σ := σ) hf hk0 hK hσ u δ hx)
      hm0 hq0 hytriv
  have hβfixW : ∀ x : twistedE6RootGroup K σ,
      (x : ModGL TwistTag.E6.tag K) ∈ thetaTorus (algebraMap (fixSubfield σ) K) → β x = x :=
    l10st6i_beta_fixes_thetaTorus (K := K) hf hK σ hσ (hβ := rfl) hβeq
      (fun x hx => l10st6i_normalActor_mapsTo_thetaTorus (K := K) σ u δ hx)
      hm0 hq0 hytriv
  have hβinner : ∃ w : twistedE6RootGroup K σ, β = MulAut.conj w := by
    by_cases hf2 : 2 ≤ f
    · have hσ0 : ∀ c, σ c = c ^ 2 ^ f := hσ
      obtain ⟨w, -, hw⟩ := exists_eq_conj_of_fix_su6Levi (k := fixSubfield σ) hf2 hk0 hK
        hσ0 β hβfixW hβfix
      exact ⟨w, hw⟩
    · have hf1 : f = 1 := by omega
      have hk1 : Nat.card (fixSubfield σ) = 2 ^ 1 := by rw [hk0, hf1]
      have hK1 : Nat.card K = (2 ^ 1) ^ 2 := by rw [hK, hf1]
      have hσ1 : ∀ c, σ c = c ^ 2 ^ 1 := by intro c; rw [hσ c, hf1]
      obtain ⟨A, hAJ, hAcyc, hAcard⟩ :=
        exists_nonsplit_le_thetaRankOneGroup (k := fixSubfield σ) hf hk0 hK
      have hA3 : Nat.card A = 2 ^ 1 + 1 := by rw [hAcard, hf1]
      have hβA : ∀ x ∈ A.subgroupOf (twistedE6RootGroup K σ), β x = x :=
        l10st6i_beta_fixes_A_one (K := K) hf hf1 hK σ hσ u δ (hβeq := hβeq)
          (hN := rfl) hm0 hAJ
      obtain ⟨w, -, hw⟩ := exists_eq_conj_of_fix_nonsplit_two
        twistedE6TwoDiagonalRigidity_holds hk1 hK1 hσ1 hAJ hA3 hAcyc β hβA hβfix
      exact ⟨w, hw⟩
  obtain ⟨w, hw⟩ := hβinner
  refine ⟨q * w, ?_⟩
  have h1 : y = MulAut.conj q * β := by
    rw [show β = MulAut.conj q⁻¹ * y from rfl]
    exact (mul_inv_cancel_left (MulAut.conj q) y).symm
  calc y = MulAut.conj q * β := h1
    _ = MulAut.conj q * MulAut.conj w := congrArg (fun t => MulAut.conj q * t) hw
    _ = MulAut.conj (q * w) := (map_mul MulAut.conj q w).symm

theorem ggRootNormInner_adj_twistedE6_highest
    {f : ℕ} {k : Type} [Field k] [Finite k] [CharP k 2] (hf : 1 ≤ f)
    (hK : Nat.card k = (2 ^ f) ^ 2) (θ : k →+* k) (hσ : ∀ c, θ c = c ^ (2 ^ f)) :
    GGRootNormInner ((rootSubgroup TwistTag.E6.tag k e6HighestRoot).comap
      (graphFixedRootGroup TwistTag.E6 k θ).subtype) := by
  let σ : k ≃+* k := l10st6i_sigma θ
  have hσθ : σ.toRingHom = θ := l10st6i_sigma_toRingHom θ
  have hσ' : ∀ c, σ c = c ^ 2 ^ f := fun c => by
    rw [show σ c = θ c from congrArg (fun g : k →+* k => g c) hσθ]
    exact hσ c
  have hmain := l10st6i_inner_highest hf hK σ hσ'
  rw [← hσθ]
  exact hmain

