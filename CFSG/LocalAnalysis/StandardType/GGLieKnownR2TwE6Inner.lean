private theorem l10st6i_levi_le_normalizer_su6Levi
    {f : ℕ} {k K : Type} [Field k] [Field K] [Algebra k K]
    (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f) (hK : Nat.card K = (2 ^ f) ^ 2)
    {σ : K →+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    graphFixedParabolicLevi TwistTag.E6 K σ J0 ≤
      Subgroup.normalizer (su6Levi σ : Set (ModGL TwistTag.E6.tag K)) := by
  obtain ⟨-, hsup, -, hcomm, -, -, -⟩ := su6Levi_facts (k := k) (σ := σ) hf hk hK hσ
  rw [l10st6i_graphFixedParabolicLevi_eq σ, ← hsup]
  refine sup_le Subgroup.le_normalizer ?_
  intro h hh
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    rw [show h * x * h⁻¹ = x from by rw [← hcomm x hx h hh]; group]
    exact hx
  · intro hx
    have hc := hcomm (h * x * h⁻¹) hx h hh
    have h2 : h * x = h * (h * x * h⁻¹) := by
      calc h * x = (h * x * h⁻¹) * h := by group
        _ = h * (h * x * h⁻¹) := hc
    have hconj : h * x * h⁻¹ = x := (mul_left_cancel h2).symm
    rw [← hconj]; exact hx

private theorem l10st6i_levi_le_normalizer_thetaTorus
    {f : ℕ} {k K : Type} [Field k] [Field K] [Algebra k K]
    [CharP K 2]
    (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f) (hK : Nat.card K = (2 ^ f) ^ 2)
    {σ : K →+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    graphFixedParabolicLevi TwistTag.E6 K σ J0 ≤
      Subgroup.normalizer (thetaTorus (algebraMap k K) : Set (ModGL TwistTag.E6.tag K)) := by
  obtain ⟨hc1, hsup, -, hcomm, -, -, -⟩ := su6Levi_facts (k := k) (σ := σ) hf hk hK hσ
  rw [l10st6i_graphFixedParabolicLevi_eq σ, ← hsup]
  have hJ : su6Levi σ ≤
      Subgroup.normalizer (thetaTorus (algebraMap k K) : Set (ModGL TwistTag.E6.tag K)) :=
    (hc1.trans (Subgroup.centralizer_le
      (thetaTorus_le_thetaRankOneGroup (CharP.cast_eq_zero K 2) (algebraMap k K)))).trans
        (Subgroup.centralizer_le_normalizer _)
  exact sup_le hJ Subgroup.le_normalizer


private theorem l10st6i_beta_fixes_su6Levi
    {f : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2] (hf : 1 ≤ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ f)
    {y β N : MulAut (twistedE6RootGroup K σ)} {q m : twistedE6RootGroup K σ}
    (hβ : β = MulAut.conj q⁻¹ * y) (hβeq : β = MulAut.conj m * N)
    (hN : ∀ x : twistedE6RootGroup K σ, (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom →
      ((N x : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom)
    (hm : (m : ModGL TwistTag.E6.tag K) ∈ graphFixedParabolicLevi TwistTag.E6 K σ.toRingHom J0)
    (hq : (q : ModGL TwistTag.E6.tag K) ∈
      graphFixedParabolicRadical TwistTag.E6 K σ.toRingHom J0)
    (hytriv : ∀ n ∈ Subgroup.normalizer
        (twE6RootSubgroup K σ e6HighestRoot : Set (twistedE6RootGroup K σ)),
      y n * n⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer
        (twE6RootSubgroup K σ e6HighestRoot : Set (twistedE6RootGroup K σ)))) :
    ∀ x : twistedE6RootGroup K σ,
      (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom → β x = x := by
  have hk0 : Nat.card (fixSubfield σ) = 2 ^ f :=
    CFSG.GH74.Generic.BProg.B2.PuG2OddAux.card_fixSubfield_quad Nat.prime_two hf hK σ hσ
  set P₀ : Subgroup (twistedE6RootGroup K σ) :=
    Subgroup.normalizer (twE6RootSubgroup K σ e6HighestRoot : Set (twistedE6RootGroup K σ))
    with hP₀
  set Q₀ : Subgroup (twistedE6RootGroup K σ) := pCoreOf 2 P₀ with hQ₀
  have hQeq : Q₀ = (graphFixedParabolicRadical TwistTag.E6 K σ.toRingHom J0).subgroupOf
      (twistedE6RootGroup K σ) := by
    rw [hQ₀, hP₀]; exact l10st6i_radical_eq (K := K) σ
  have hytriv' : ∀ n ∈ P₀, y n * n⁻¹ ∈ Q₀ := by
    rw [hP₀, hQ₀]; exact hytriv
  have hqQ : q ∈ Q₀ := by
    rw [hQeq]; exact Subgroup.mem_subgroupOf.2 hq
  have hSle : (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ) ≤ P₀ := by
    intro x hx
    rw [hP₀]
    exact (mem_twE6LongRootParabolic_iff σ x).2
      (l10st6i_su6Levi_le_graphFixedParabolic σ (Subgroup.mem_subgroupOf.1 hx))
  have hQn : ∀ n ∈ P₀, ∀ z ∈ Q₀, n * z * n⁻¹ ∈ Q₀ := by
    intro n hn z hz
    rw [hQ₀] at hz ⊢
    exact (Subgroup.mem_normalizer_iff.1
      (GGRootNorm.le_normalizer_pCoreOf P₀ hn) z).1 hz
  have hβS : ∀ x ∈ (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ),
      β x ∈ (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ) := by
    intro x hx
    have hx' : (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom :=
      Subgroup.mem_subgroupOf.1 hx
    have hNx : ((N x : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈
        su6Levi σ.toRingHom := hN x hx'
    have hnorm := l10st6i_levi_le_normalizer_su6Levi (k := fixSubfield σ)
      (σ := σ.toRingHom) hf hk0 hK hσ
    have hmem := (Subgroup.mem_normalizer_iff.1 (hnorm hm)
      ((N x : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K)).1 hNx
    have hβx : β x = m * N x * m⁻¹ := by
      rw [hβeq, MulAut.mul_apply, MulAut.conj_apply]
    show ((β x : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom
    rw [hβx]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    exact hmem
  have hSQ : (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ) ⊓ Q₀ = ⊥ := by
    rw [hQeq, eq_bot_iff]
    intro y hy
    rw [Subgroup.mem_inf] at hy
    have hy1 : (y : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom :=
      Subgroup.mem_subgroupOf.1 hy.1
    have hy2 : (y : ModGL TwistTag.E6.tag K) ∈
        graphFixedParabolicRadical TwistTag.E6 K σ.toRingHom J0 :=
      Subgroup.mem_subgroupOf.1 hy.2
    have hbot : (y : ModGL TwistTag.E6.tag K) ∈
        (⊥ : Subgroup (ModGL TwistTag.E6.tag K)) := by
      rw [← l10st6i_su6Levi_inf_radical_eq_bot σ]
      exact Subgroup.mem_inf.2 ⟨hy1, hy2⟩
    exact Subgroup.mem_bot.2 (Subtype.ext (Subgroup.mem_bot.1 hbot))
  intro x hx
  exact l10st6i_beta_fix_of_le (hβ := hβ) (P := P₀) (Q := Q₀)
    (S := (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ))
    hSle hQn hytriv' hqQ hβS hSQ x (Subgroup.mem_subgroupOf.2 hx)

private theorem l10st6i_beta_fixes_thetaTorus
    {f : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2] (hf : 1 ≤ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ f)
    {y β N : MulAut (twistedE6RootGroup K σ)} {q m : twistedE6RootGroup K σ}
    (hβ : β = MulAut.conj q⁻¹ * y) (hβeq : β = MulAut.conj m * N)
    (hN : ∀ x : twistedE6RootGroup K σ,
