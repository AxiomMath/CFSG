      (l10st6i_graphFixedParabolicLevi_le_parabolicLevi σ.toRingHom)
  · exact (inf_le_left.trans (l10st6i_su6Levi_le_graphFixedParabolicLevi σ)).trans
      (l10st6i_graphFixedParabolicLevi_le_twistedFixedGroup σ.toRingHom)

private theorem l10st6i_thetaTorus_inf_radical_eq_bot
    {f : ℕ} {k K : Type} [Field k] [Field K] [Algebra k K]
    (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f) (hK : Nat.card K = (2 ^ f) ^ 2)
