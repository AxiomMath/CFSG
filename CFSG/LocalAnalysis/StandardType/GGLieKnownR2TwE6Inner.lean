private theorem l10st6i_beta_fix_of_le {G : Type*} [Group G] {y β : MulAut G} {q : G}
    (hβ : β = MulAut.conj q⁻¹ * y) {P Q S : Subgroup G}
    (hSle : S ≤ P)
    (hQn : ∀ n ∈ P, ∀ z ∈ Q, n * z * n⁻¹ ∈ Q)
    (hytriv : ∀ n ∈ P, y n * n⁻¹ ∈ Q)
    (hq : q ∈ Q)
    (hβS : ∀ x ∈ S, β x ∈ S)
    (hSQ : S ⊓ Q = ⊥) :
    ∀ x ∈ S, β x = x := by
  intro x hx
  have hxP : x ∈ P := hSle hx
  have hyt : y x * x⁻¹ ∈ Q := hytriv x hxP
  have hβx : β x = q⁻¹ * y x * q := by
    rw [hβ, MulAut.mul_apply, MulAut.conj_apply, inv_inv]
  have hmem : x⁻¹ * β x ∈ Q := by
    rw [hβx]
    have hzx : y x = (y x * x⁻¹) * x := by group
    rw [hzx]
    have h1 : x⁻¹ * (q⁻¹ * ((y x * x⁻¹) * x) * q) =
        (x⁻¹ * q⁻¹ * x) * (x⁻¹ * (y x * x⁻¹) * x) * q := by group
    rw [h1]
    refine mul_mem (mul_mem ?_ ?_) hq
    · simpa only [inv_inv] using hQn x⁻¹ (inv_mem hxP) q⁻¹ (inv_mem hq)
    · simpa only [inv_inv] using hQn x⁻¹ (inv_mem hxP) (y x * x⁻¹) hyt
  have hmemS : x⁻¹ * β x ∈ S := mul_mem (inv_mem hx) (hβS x hx)
  have hbot : x⁻¹ * β x ∈ (⊥ : Subgroup G) := by
    rw [← hSQ]; exact Subgroup.mem_inf.2 ⟨hmemS, hmem⟩
  exact (inv_mul_eq_one.mp (Subgroup.mem_bot.1 hbot)).symm

private theorem l10st6i_radical_eq
    {K : Type} [Field K] [Finite K] [CharP K 2] (σ : K ≃+* K) :
    pCoreOf 2 (Subgroup.normalizer (twE6RootSubgroup K σ e6HighestRoot :
        Set (twistedE6RootGroup K σ))) =
      (graphFixedParabolicRadical TwistTag.E6 K σ.toRingHom J0).subgroupOf
        (twistedE6RootGroup K σ) := by
  have hrad := CFSG.LieType.SeitzGeneration.ExcWideThree.TwE6LongRoot.radical_std_eq
    (K := K) σ
  simp only [twE6LongRootRadical, twE6LongRootParabolic, pCoreOf] at hrad
  rw [ringChar.eq K 2] at hrad
  exact hrad

