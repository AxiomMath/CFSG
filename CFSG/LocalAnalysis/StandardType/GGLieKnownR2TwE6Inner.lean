private theorem l10st6i_map_mem_fixSubfield {K : Type} [Field K] [Finite K] (σ δ : K ≃+* K)
    {c : K} (hc : c ∈ fixSubfield σ) : δ c ∈ fixSubfield σ := by
  rw [mem_fixSubfield] at hc ⊢
  rw [← ringEquiv_comm_of_finite σ δ c, hc]

private theorem l10st6i_map_mulSingle {ι : Type} [DecidableEq ι] {K : Type} [Field K]
    (δ : K ≃+* K) (i : ι) (u : Kˣ) :
    (fun j => Units.map δ.toMonoidHom
      (MonoidHom.mulSingle (fun _ : ι => Kˣ) i u j)) =
      MonoidHom.mulSingle (fun _ : ι => Kˣ) i (Units.map δ.toMonoidHom u) := by
  ext j
  by_cases hj : j = i
  · subst hj; simp
  · simp [MonoidHom.mulSingle_apply, Pi.mulSingle_eq_of_ne, hj]

private theorem l10st6i_delta_units_mem {K : Type} [Field K] [Finite K] (σ δ : K ≃+* K)
    (a : (fixSubfield σ)ˣ) :
    ∃ a' : (fixSubfield σ)ˣ,
      Units.map δ.toMonoidHom
          (Units.map ((algebraMap (fixSubfield σ) K).toMonoidHom) a) =
        Units.map ((algebraMap (fixSubfield σ) K).toMonoidHom) a' := by
  refine ⟨Units.mk0 ⟨δ ((Units.map ((algebraMap (fixSubfield σ) K).toMonoidHom) a : Kˣ) : K),
    l10st6i_map_mem_fixSubfield σ δ a.1.2⟩ ?_, ?_⟩
  · intro h
    exact (Units.map δ.toMonoidHom
      (Units.map ((algebraMap (fixSubfield σ) K).toMonoidHom) a)).ne_zero
        (congrArg Subtype.val h)
  · ext
    rfl

private theorem l10st6i_normalActor_mapsTo_thetaTorus
    {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ)
    (δ : K ≃+* K) {x : twistedE6RootGroup K σ}
    (hx : (x : ModGL TwistTag.E6.tag K) ∈ thetaTorus (algebraMap (fixSubfield σ) K)) :
    (((compatDiagAutHom TwistTag.E6 K σ.toRingHom u * fieldActor (t := TwistTag.E6) σ δ) x :
        twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈
      thetaTorus (algebraMap (fixSubfield σ) K) := by
  obtain ⟨a, ha⟩ := (mem_thetaTorus (algebraMap (fixSubfield σ) K)).1 hx
  obtain ⟨a', ha'⟩ := l10st6i_delta_units_mem σ δ a
  set u₀ : Kˣ := Units.map ((algebraMap (fixSubfield σ) K).toMonoidHom) a with hu₀
  set u₁ : Kˣ := Units.map ((algebraMap (fixSubfield σ) K).toMonoidHom) a' with hu₁
  set c₀ : Fin TwistTag.E6.tag.rank → Kˣ :=
    MonoidHom.mulSingle (fun _ : Fin TwistTag.E6.tag.rank => Kˣ) (e6Idx 1) u₀ with hc₀
  set c₁ : Fin TwistTag.E6.tag.rank → Kˣ :=
    MonoidHom.mulSingle (fun _ : Fin TwistTag.E6.tag.rank => Kˣ) (e6Idx 1) u₁ with hc₁
  have hroot₀ : rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₀ =
      rootDiagUnit TwistTag.E6.tag c₀ := (thetaTorusHom_apply u₀).symm
  have hroot₁ : rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₁ =
      rootDiagUnit TwistTag.E6.tag c₁ := (thetaTorusHom_apply u₁).symm
  have hsingle : (fun i => Units.map δ.toMonoidHom (c₀ i)) = c₁ := by
    rw [hc₀, hc₁, ← ha']
    exact l10st6i_map_mulSingle δ (e6Idx 1) u₀
  have hδ : Units.map (entrywiseHom δ.toRingHom)
      (rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₀) =
      rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₁ := by
    rw [hroot₀, hroot₁, units_map_entrywiseHom_rootDiagUnit, hsingle]
  set b₀ : Fin TwistTag.E6.tag.rank → Kˣ := compatDiag TwistTag.E6 σ.toRingHom u with hb₀
  have hcomm : rootDiagUnit TwistTag.E6.tag b₀ *
      rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₁ *
      (rootDiagUnit TwistTag.E6.tag b₀)⁻¹ =
      rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₁ := by
    rw [hroot₁]
    have hcm : rootDiagUnit TwistTag.E6.tag b₀ * rootDiagUnit TwistTag.E6.tag c₁ =
        rootDiagUnit TwistTag.E6.tag c₁ * rootDiagUnit TwistTag.E6.tag b₀ := by
      rw [(rootDiagUnit_mul b₀ c₁).symm, (rootDiagUnit_mul c₁ b₀).symm]
      congr 1
      ext i
      exact mul_comm _ _
    rw [hcm]; group
  set z : twistedE6RootGroup K σ :=
    ⟨rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₀, ha.symm ▸ x.2⟩ with hz
  have hzx : z = x := Subtype.ext ha
  have key : (((compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
      fieldActor (t := TwistTag.E6) σ δ) z : twistedE6RootGroup K σ) :
      ModGL TwistTag.E6.tag K) = rootTorusSL2 TwistTag.E6.tag K e6HighestRoot u₁ := by
    rw [MulAut.mul_apply]
    rw [coe_compatDiagAutHom u ((fieldActor (t := TwistTag.E6) σ δ) z)]
    rw [coe_fieldActor, hδ]
    rw [← hb₀]
    exact hcomm
  rw [← hzx, key]
  exact (mem_thetaTorus (algebraMap (fixSubfield σ) K)).2
    ⟨a', by rw [hu₁]⟩

private theorem l10st6i_su6Levi_le_graphFixedParabolic
    {K : Type} [Field K] (σ : K ≃+* K) :
    su6Levi σ.toRingHom ≤ graphFixedParabolic TwistTag.E6 K σ.toRingHom J0 := by
  rw [su6Levi, ← parabolicSubgroup_inf_graphFixedRootGroup (t := TwistTag.E6)
    (σ := σ.toRingHom) σ.surjective J0, l10st6i_orbitUnion_J0]
  refine le_inf (inf_le_left.trans ?_) inf_le_right
  exact (le_sup_right : subsystemGroup TwistTag.E6.tag K E6GraphLevi.setA ≤
    parabolicLevi TwistTag.E6.tag K E6GraphLevi.setA).trans
      (parabolicLevi_le_parabolicSubgroup E6GraphLevi.setA)

private theorem l10st6i_thetaTorus_le_graphFixedParabolic
    {f : ℕ} {k K : Type} [Field k] [Field K] [Algebra k K]
    [Finite k]
    (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f) (hK : Nat.card K = (2 ^ f) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    thetaTorus (algebraMap k K) ≤ graphFixedParabolic TwistTag.E6 K σ.toRingHom J0 := by
  rw [← parabolicSubgroup_inf_graphFixedRootGroup (t := TwistTag.E6)
    (σ := σ.toRingHom) σ.surjective J0]
  exact le_inf ((thetaTorus_le_torusGroup _).trans
    (torusGroup_le_borelGroup.trans (borelGroup_le_parabolicSubgroup _)))
    (thetaTorus_le_C0 (k := k) (K := K) hf hk hK hσ)

