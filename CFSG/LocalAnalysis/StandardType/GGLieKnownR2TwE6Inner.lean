  have hytriv' : ∀ n ∈ P₀, y n * n⁻¹ ∈ Q₀ := by
    rw [hP₀, hQ₀]; exact hytriv
  have hqQ : q ∈ Q₀ := by
    rw [hQeq]; exact Subgroup.mem_subgroupOf.2 hq
  have hSle : (thetaTorus (algebraMap (fixSubfield σ) K)).subgroupOf
      (twistedE6RootGroup K σ) ≤ P₀ := by
    intro x hx
    rw [hP₀]
    exact (mem_twE6LongRootParabolic_iff σ x).2
      (l10st6i_thetaTorus_le_graphFixedParabolic (k := fixSubfield σ) hf hk0 hK σ hσ
        (Subgroup.mem_subgroupOf.1 hx))
  have hQn : ∀ n ∈ P₀, ∀ z ∈ Q₀, n * z * n⁻¹ ∈ Q₀ := by
    intro n hn z hz
    rw [hQ₀] at hz ⊢
    exact (Subgroup.mem_normalizer_iff.1
      (GGRootNorm.le_normalizer_pCoreOf P₀ hn) z).1 hz
  have hβS : ∀ x ∈ (thetaTorus (algebraMap (fixSubfield σ) K)).subgroupOf
      (twistedE6RootGroup K σ), β x ∈
      (thetaTorus (algebraMap (fixSubfield σ) K)).subgroupOf (twistedE6RootGroup K σ) := by
    intro x hx
    have hx' : (x : ModGL TwistTag.E6.tag K) ∈ thetaTorus (algebraMap (fixSubfield σ) K) :=
      Subgroup.mem_subgroupOf.1 hx
    have hNx := hN x hx'
    have hnorm := l10st6i_levi_le_normalizer_thetaTorus (k := fixSubfield σ)
      (σ := σ.toRingHom) hf hk0 hK hσ
    have hmem := (Subgroup.mem_normalizer_iff.1 (hnorm hm)
