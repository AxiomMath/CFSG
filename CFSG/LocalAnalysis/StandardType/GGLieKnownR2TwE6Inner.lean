private theorem l10st6i_mem_normalizer_of_map_eq {G : Type*} [Group G] {X : Subgroup G} {g : G}
    (h : X.map (MulAut.conj g).toMonoidHom = X) : g ∈ Subgroup.normalizer (X : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    have h1 : (MulAut.conj g) x ∈ X.map (MulAut.conj g).toMonoidHom :=
      Subgroup.mem_map_of_mem _ hx
    rw [h] at h1
    simpa only [MulAut.conj_apply] using h1
  · intro hx
    have h1 : g * x * g⁻¹ ∈ X.map (MulAut.conj g).toMonoidHom := by
      rw [h]; exact hx
    rw [Subgroup.mem_map_equiv] at h1
    have h2 : (MulAut.conj g).symm (g * x * g⁻¹) = x := by
      rw [← MulAut.inv_apply, MulAut.conj_inv_apply]
      group
    rwa [h2] at h1

private noncomputable def l10st6i_sigma {k : Type} [Field k] [Finite k] (θ : k →+* k) :
    k ≃+* k :=
  RingEquiv.ofBijective θ
    ⟨RingHom.injective θ, Finite.surjective_of_injective (RingHom.injective θ)⟩

private theorem l10st6i_sigma_toRingHom {k : Type} [Field k] [Finite k] (θ : k →+* k) :
    (l10st6i_sigma θ).toRingHom = θ := rfl

private theorem l10st6i_normalActor_mem_rootSubgroup
    {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ)
    (δ : K ≃+* K) {x : twE6RootSubgroup K σ e6HighestRoot} :
    (((compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
        fieldActor (t := TwistTag.E6) σ δ)
        (x : twistedE6RootGroup K σ) : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈
      rootSubgroup TwistTag.E6.tag K e6HighestRoot := by
  have hx : ((x : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈
      rootSubgroup TwistTag.E6.tag K e6HighestRoot := x.2
  obtain ⟨c, hc⟩ := mem_rootSubgroup.1 hx
  have hstep : (((fieldActor (t := TwistTag.E6) σ δ) (x : twistedE6RootGroup K σ) :
      twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) =
      pinnedX TwistTag.E6.tag K e6HighestRoot (δ c) := by
    rw [coe_fieldActor, ← hc,
      CFSG.HardMathSupport.Timmesfeld.LangTorus.entrywise_pinnedX_units]
    rfl
  have hmain : (((compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
      fieldActor (t := TwistTag.E6) σ δ) (x : twistedE6RootGroup K σ) :
      twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) =
      rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u) *
        pinnedX TwistTag.E6.tag K e6HighestRoot (δ c) *
        (rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u))⁻¹ := by
    rw [MulAut.mul_apply, coe_compatDiagAutHom u
      ((fieldActor (t := TwistTag.E6) σ δ) (x : twistedE6RootGroup K σ)), hstep]
  rw [hmain, rootDiagUnit_conj_pinnedX _ isRoot_e6HighestRoot]
  exact mem_rootSubgroup.2 ⟨_, rfl⟩

private theorem l10st6i_normalActor_map_le_theta
    {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ)
    (δ : K ≃+* K) :
    (twE6RootSubgroup K σ e6HighestRoot).map
      ((compatDiagAutHom TwistTag.E6 K σ.toRingHom u * fieldActor (t := TwistTag.E6) σ δ :
        MulAut (twistedE6RootGroup K σ)).toMonoidHom) ≤
      twE6RootSubgroup K σ e6HighestRoot := by
  rintro y ⟨x, hx, rfl⟩
  exact l10st6i_normalActor_mem_rootSubgroup σ u δ (x := ⟨x, hx⟩)

