    rw [eq_top_iff]
    intro z _
    have hz : (z : ModGL Tag.E6 (AlgebraicClosure K)) ∈ f.range := by
      rw [hfrange']; exact z.2
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hz
    exact MonoidHom.mem_range.mpr ⟨x, Subtype.ext hx⟩
  have hρ₀range_le : ρ₀.range ≤ Jbar := by
    rintro y ⟨x, rfl⟩
    change ((eι.symm (f' x)) : ↥(twistedE6RootGroup K σ)) ∈ Jbar
    exact (eι.symm (f' x)).2
  have hρ₀range_ge : Jbar ≤ ρ₀.range := by
    intro y hy
    have hy' : eι ⟨y, hy⟩ ∈ f'.range := by rw [hf'range_top]; trivial
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hy'
    refine MonoidHom.mem_range.mpr ⟨x, ?_⟩
    change (Jbar.subtype (eι.symm (f' x)) : ↥(twistedE6RootGroup K σ)) = y
    rw [show f' x = eι ⟨y, hy⟩ from hx]
    exact congrArg Subtype.val (eι.symm_apply_apply ⟨y, hy⟩)
  have hρ₀range : ρ₀.range = Jbar := le_antisymm hρ₀range_le hρ₀range_ge
  have hρle1 : ρ.range ≤ J := by
    have hle : ρ.range ≤ J ⊔ Subgroup.center ↥(TwistedE6.fixedGroup K σ.toRingHom) := by
      refine (le_trans ?_ (sup_le_sup_left hπker J))
      intro x hx
      have hx' : π₀ x ∈ Jbar := by
        have hmem : π₀ x ∈ ρ₀.range := by
          rw [← hρ, MonoidHom.range_comp]
          exact ⟨x, hx, rfl⟩
        rwa [hρ₀range] at hmem
      rw [← Subgroup.comap_map_eq π₀ J]
      exact hx'
    exact CFSG.StandardType.TableCRes.perfect_le_of_le_sup_center hρperf hle
  have hρge1 : J ≤ ρ.range := by
    have hle : J ≤ ρ.range ⊔ Subgroup.center ↥(TwistedE6.fixedGroup K σ.toRingHom) := by
      intro j hj
      have hπ : π₀ (j : ↥(TwistedE6.fixedGroup K σ.toRingHom)) ∈ ρ₀.range := by
        rw [hρ₀range]
        exact Subgroup.mem_map_of_mem π₀ hj
      obtain ⟨r, hr, hjr⟩ := Subgroup.mem_map.mp (by
        rwa [← hρ, MonoidHom.range_comp] at hπ)
      have hker : r⁻¹ * j ∈ π₀.ker := by
        rw [MonoidHom.mem_ker, map_mul, map_inv, hjr, inv_mul_cancel]
      have hZj : r⁻¹ * j ∈ Subgroup.center ↥(TwistedE6.fixedGroup K σ.toRingHom) := hπker hker
      have hji : j = r * (r⁻¹ * j) := by group
      rw [hji]
      exact Subgroup.mul_mem_sup hr hZj
    exact CFSG.StandardType.TableCRes.perfect_le_of_le_sup_center hJperf' hle
  have hρrange : ρ.range = J := le_antisymm hρle1 hρge1
  have hc₀3 : c₀ ^ 3 ≠ 1 := by
    intro h
    have hmat : ((c₀ : SL(3, AlgebraicClosure K)) :
        Matrix (Fin 3) (Fin 3) (AlgebraicClosure K)) ^ 3 = 1 := by
      have h1 := congrArg (fun z : ↥(CFSG.RankThree.Classical2.fixSubgroup
        (stdUnitaryEquiv (ν := 3) σQ)) =>
          ((z : SL(3, AlgebraicClosure K)) : Matrix (Fin 3) (Fin 3) (AlgebraicClosure K))) h
      rwa [Subgroup.coe_pow, Matrix.SpecialLinearGroup.coe_pow, Subgroup.coe_one,
        Matrix.SpecialLinearGroup.coe_one] at h1
    rw [hc₀, Matrix.diagonal_pow] at hmat
    have h00 := congrArg (fun M : Matrix (Fin 3) (Fin 3) (AlgebraicClosure K) => M 0 0) hmat
    simp only [Matrix.diagonal_apply_eq, Matrix.one_apply_eq] at h00
    exact hζ3 (Units.ext h00)
  have hker_le_center : ρ.ker ≤ Subgroup.center ↥(CFSG.RankThree.Classical2.fixSubgroup
      (stdUnitaryEquiv (ν := 3) σQ)) := hρker_le
  have hcard_center_SU : Nat.card (Subgroup.center
      ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 3) σQ))) = 3 := by
    refine KSNotAll24.CubeCentre.card_center_fixSubgroup_three Nat.prime_two (f := 3 * n)
      (by omega) σQ hσQ ?_
    have h : 2 ^ (3 * n) = (2 ^ n) ^ 3 := by rw [mul_comm, pow_mul]
    rw [h, Nat.dvd_iff_mod_eq_zero, Nat.add_mod, Nat.pow_mod]
    have hmod : 2 ^ n % 3 = 2 := by omega
    rw [hmod]
  have hker_ne_bot : ρ.ker ≠ ⊥ := by
    intro hbot
    have hinj : Function.Injective ρ := (MonoidHom.ker_eq_bot_iff ρ).1 hbot
    have h1 : ρ (c₀ ^ 3) = 1 := by rw [map_pow, hcube]
    exact hc₀3 (hinj (by rw [h1, map_one]))
  have hker_eq : ρ.ker = Subgroup.center ↥(CFSG.RankThree.Classical2.fixSubgroup
      (stdUnitaryEquiv (ν := 3) σQ)) := by
    have hdvd : Nat.card (ρ.ker) ∣ Nat.card (Subgroup.center
        ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 3) σQ))) :=
      Subgroup.card_dvd_of_le hker_le_center
    rw [hcard_center_SU] at hdvd
    have hne : Nat.card (ρ.ker) ≠ 1 := by
      intro h1
      exact hker_ne_bot (Subgroup.card_eq_one.mp h1)
    rcases (Nat.dvd_prime Nat.prime_three).1 hdvd with h | h
    · exact absurd h hne
    · exact Subgroup.eq_of_le_of_card_ge hker_le_center (by rw [hcard_center_SU, h])
  have hcenterJ : Subgroup.center ↥J = ⊥ := by
    have hZquot : Subgroup.center (↥(CFSG.RankThree.Classical2.fixSubgroup
        (stdUnitaryEquiv (ν := 3) σQ)) ⧸
        Subgroup.center ↥(CFSG.RankThree.Classical2.fixSubgroup
          (stdUnitaryEquiv (ν := 3) σQ))) = ⊥ :=
      tzSc_center_quot_eq_bot (CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.open_isQuasisimple
        (hSUquasi hνQ))
    let eJ : (↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 3) σQ)) ⧸
        Subgroup.center ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 3) σQ))) ≃*
        ↥J :=
      (QuotientGroup.quotientMulEquivOfEq hker_eq.symm).trans
        ((QuotientGroup.quotientKerEquivRange ρ).trans (MulEquiv.subgroupCongr hρrange))
    have h := Subgroup.map_center_eq eJ
    rw [hZquot, Subgroup.map_bot] at h
    exact h.symm
  exact hcenterJ

end Glue

theorem twE6ScTableZ_holds
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ n) ^ 2) (hσ : ∀ c, σ c = c ^ (2 ^ n)) (h3 : 3 ∣ 2 ^ n + 1) :
    TwE6ScTableZAt K σ n :=
  twE6ScTableZ_aux K σ hn hK hσ h3

