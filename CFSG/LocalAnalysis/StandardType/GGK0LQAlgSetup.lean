namespace CFSG.StandardType.GGK0LQ

open CFSG CFSG.Assembly CFSG.StandardType CFSG.StandardType.GGK0MarkedKacIface1587
open CFSG.HardMathSupport.Timmesfeld.LangTorus

variable {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
  {lab : LargeEvenLabel} {p : ℕ} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}

theorem lq_setup_isAlgebraic
    (hAlg : ∀ c : Omega, ∃ n : ℕ, 0 < n ∧ c ^ (2 ^ n) = c)
    (A : K0LangMark Omega lab p R I phi) : A.setup.IsAlgebraic := by
  intro c
  obtain ⟨n, hn, hc⟩ := hAlg c
  refine ⟨n, hn, ?_⟩
  have hpow : ∀ k : ℕ, c ^ ((2 ^ n) ^ k) = c := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ, pow_mul, ih, hc]
  rw [A.q_eq]
  have hexp : (2 ^ lab.n) ^ n = (2 ^ n) ^ lab.n := by
    rw [← pow_mul, ← pow_mul, Nat.mul_comm]
  rw [hexp]
  exact hpow lab.n

end CFSG.StandardType.GGK0LQ

end
