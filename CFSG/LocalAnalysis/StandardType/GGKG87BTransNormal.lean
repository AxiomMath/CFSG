private theorem card_rootFinset : (rootFinset Tag.E6).card = 72 := by
  decide +kernel

private theorem prod_zpow_eq {G : Type*} [CommGroup G] {ι : Type*} (s : Finset ι) (y : G)
    (e : ι → ℤ) : ∏ i ∈ s, y ^ e i = y ^ ∑ i ∈ s, e i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert j s hj ih => rw [Finset.prod_insert hj, Finset.sum_insert hj, ih, zpow_add]

private theorem exists_pow_eq_of_pow_three {L : Type} [Field L] {ω : Lˣ} (hω : orderOf ω = 3)
    {z : Lˣ} (hz : z ^ 3 = 1) : ∃ k : Fin 3, z = ω ^ (k : ℕ) := by
  have hprim : IsPrimitiveRoot (ω : L) 3 :=
    IsPrimitiveRoot.coe_units_iff.2 (IsPrimitiveRoot.iff_orderOf.2 hω)
  have hz' : (z : L) ^ 3 = 1 := by rw [← Units.val_pow_eq_pow_val, hz, Units.val_one]
  obtain ⟨i, hi, hiz⟩ := hprim.eq_pow_of_pow_eq_one hz'
  exact ⟨⟨i, hi⟩, Units.ext (by rw [Units.val_pow_eq_pow_val]; exact hiz.symm)⟩

private theorem kerCount_reps : ∀ ρ < 8, ((rootFinset Tag.E6).filter fun α =>
    triPairing (vec3 (τ := .E6) (e6ThreeReps.getD ρ [])) α = 0).card =
      [72, 40, 40, 30, 22, 22, 24, 18].getD ρ 0 := by
  decide +kernel

private theorem vec3_rep3 : vec3 (τ := .E6) (e6ThreeReps.getD 3 []) = Pi.single 1 1 := by
  decide +kernel

private theorem ncard_kernelRoots_triChar
    (b : Fin Tag.E6.rank → ZMod 3) : (kernelRoots (triChar b)).ncard =
      ((rootFinset Tag.E6).filter fun α => triPairing b α = 0).card := by
  rw [← Set.ncard_coe_finset]
  congr 1
  ext α
  simp only [Finset.coe_filter, Set.mem_setOf_eq, mem_rootFinset]
  exact mem_kernelRoots_triChar

private theorem exists_conj_xt
    {L : Type} [Field L] {a : Fin Tag.E6.rank → Lˣ}
    (ha3 : ∀ i, a i ^ 3 = 1) (hk : (kernelRoots (rootCharHom a)).ncard = 30) :
    ∃ ω : Lˣ, orderOf ω = 3 ∧ ∃ w : WeylGroup Tag.E6,
      rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) = canonicalRep (coxeterSystem Tag.E6) L w *
        rootDiagUnit Tag.E6 a * (canonicalRep (coxeterSystem Tag.E6) L w)⁻¹ := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨i, hi⟩ : ∃ i, a i ≠ 1 := by
    by_contra h
    push Not at h
    have ha : a = 1 := funext h
    have hall : kernelRoots (rootCharHom a) = ↑(rootFinset Tag.E6) := by
      rw [kernelRoots_rootCharHom, ha]
      ext α
      simp [mem_rootFinset, rootChar]
    rw [hall, Set.ncard_coe_finset, card_rootFinset] at hk
    norm_num at hk
  set ω := a i with hωdef
  have hω : orderOf ω = 3 := orderOf_eq_prime (ha3 i) hi
  choose k hk' using fun j => exists_pow_eq_of_pow_three hω (ha3 j)
  set b : Fin Tag.E6.rank → ZMod 3 := fun j => (((k j : ℕ) : ℤ) : ZMod 3) with hb
  have hchar : ∀ v, rootChar a v = ω ^ (∑ j, ((k j : ℕ) : ℤ) * v j) := by
    intro v
    rw [rootChar, ← prod_zpow_eq]
    refine Finset.prod_congr rfl fun j _ => ?_
    rw [hk' j, ← zpow_natCast, ← zpow_mul]
  have hpair : ∀ v, triPairing b v = ((∑ j, ((k j : ℕ) : ℤ) * v j : ℤ) : ZMod 3) := by
    intro v
    simp only [triPairing, hb, Int.cast_sum, Int.cast_mul]
  have hker : kernelRoots (triChar b) = kernelRoots (rootCharHom a) := by
    rw [kernelRoots_rootCharHom]
    ext α
    rw [mem_kernelRoots_triChar, Set.mem_setOf_eq, hpair, hchar, zpow_eq_one_iff_three hω,
      ZMod.intCast_zmod_eq_zero_iff_dvd]
    norm_num
  obtain ⟨horbit, -⟩ := e6ThreeScCheck_spec
  obtain ⟨ρ, hρ, t, ht⟩ := exists_isCharConj_of_orbitCheck3 horbit (triChar b)
  have hρ8 : ρ < 8 := hρ
  have h30 : ((rootFinset Tag.E6).filter fun α =>
      triPairing (vec3 (τ := .E6) (e6ThreeReps.getD ρ [])) α = 0).card = 30 := by
    rw [← ncard_kernelRoots_triChar, ← hk, ← hker]
    have e : kernelRoots (triChar b) =
        (fun α => t • α) '' kernelRoots (triChar (vec3 (τ := .E6) (e6ThreeReps.getD ρ []))) := by
      ext α
      rw [kernelRoots_iff_of_isCharConj ht]
      exact ⟨fun h => ⟨t⁻¹ • α, h, smul_inv_smul t α⟩,
        fun ⟨β, hβ, e⟩ => by rw [← e, inv_smul_smul]; exact hβ⟩
    rw [e, Set.ncard_image_of_injective _ (MulAction.injective t)]
  have hρ3 : ρ = 3 := by
    have := kerCount_reps ρ hρ8
    rw [h30] at this
    revert this
    interval_cases ρ <;> decide
  subst hρ3
  refine ⟨ω, hω, t⁻¹, (rootDiagUnit_eq_conj_canonicalRep_iff _ _ _).2 fun v => ?_⟩
  rw [rootChar_mulSingle, hchar, zpow_eq_zpow_iff_modEq, hω]
  have h := ht v
  rw [triChar_apply, triChar_apply, Z3.ofAdd_eq_ofAdd_iff, hpair, vec3_rep3] at h
  have h1 : triPairing (Pi.single 1 1 : Fin Tag.E6.rank → ZMod 3) (t⁻¹ • v) =
      (((t⁻¹ • v) 1 : ℤ) : ZMod 3) := by
    rw [triPairing, Finset.sum_eq_single 1 (fun j _ hj => by simp [hj]) (by simp)]
    simp
  rw [h1] at h
  exact ((ZMod.intCast_eq_intCast_iff _ _ 3).1 h).symm

private theorem isElemAbelian_map {G H : Type*} [Group G] [Group H] (f : G →* H)
    {E : Subgroup G} (hE : CFSG.Open.IsElemAbelian 3 E) : CFSG.Open.IsElemAbelian 3 (E.map f) := by
  refine ⟨⟨⟨fun x y => Subtype.ext ?_⟩⟩, ?_⟩
  · obtain ⟨_, a, ha, rfl⟩ := x
    obtain ⟨_, b, hb, rfl⟩ := y
    have h := congrArg Subtype.val (hE.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
    change f a * f b = f b * f a
    rw [← map_mul, ← map_mul]
    exact congrArg f h
  · rintro _ ⟨a, ha, rfl⟩
    rw [← map_pow, hE.2 a ha, map_one]

private theorem eq_mulSingle_of {L : Type} [Field L] {c' : Fin Tag.E6.rank → Lˣ} {x y : Lˣ}
    (h0 : c' ⟨0, by decide⟩ = 1) (h2 : c' ⟨2, by decide⟩ = 1) (h4 : c' ⟨4, by decide⟩ = 1)
    (h5 : c' ⟨5, by decide⟩ = 1) (h1 : c' 1 = x) (h3 : c' 3 = y) :
    Pi.mulSingle 1 x * Pi.mulSingle 3 y = c' := by
  funext j
  fin_cases j
  · show (Pi.mulSingle 1 x * Pi.mulSingle 3 y : Fin Tag.E6.rank → Lˣ) ⟨0, by decide⟩ = _
    rw [Pi.mul_apply, Pi.mulSingle_eq_of_ne (by decide), Pi.mulSingle_eq_of_ne (by decide), h0,
      one_mul]
  · show (Pi.mulSingle 1 x * Pi.mulSingle 3 y : Fin Tag.E6.rank → Lˣ) 1 = _
    rw [Pi.mul_apply, Pi.mulSingle_eq_same, Pi.mulSingle_eq_of_ne (by decide), mul_one]
    exact h1.symm
  · show (Pi.mulSingle 1 x * Pi.mulSingle 3 y : Fin Tag.E6.rank → Lˣ) ⟨2, by decide⟩ = _
    rw [Pi.mul_apply, Pi.mulSingle_eq_of_ne (by decide), Pi.mulSingle_eq_of_ne (by decide), h2,
      one_mul]
  · show (Pi.mulSingle 1 x * Pi.mulSingle 3 y : Fin Tag.E6.rank → Lˣ) 3 = _
    rw [Pi.mul_apply, Pi.mulSingle_eq_of_ne (by decide), Pi.mulSingle_eq_same, one_mul]
    exact h3.symm
  · show (Pi.mulSingle 1 x * Pi.mulSingle 3 y : Fin Tag.E6.rank → Lˣ) ⟨4, by decide⟩ = _
    rw [Pi.mul_apply, Pi.mulSingle_eq_of_ne (by decide), Pi.mulSingle_eq_of_ne (by decide), h4,
      one_mul]
  · show (Pi.mulSingle 1 x * Pi.mulSingle 3 y : Fin Tag.E6.rank → Lˣ) ⟨5, by decide⟩ = _
    rw [Pi.mul_apply, Pi.mulSingle_eq_of_ne (by decide), Pi.mulSingle_eq_of_ne (by decide), h5,
      one_mul]

open CFSG.Open in
theorem exists_conj_thirdTorus_sup_blockGroup
    {n : ℕ} {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K)
    {E : Subgroup ↥(twistedE6RootGroup K σ)} (hE : IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 4)
    (hnt : ¬ CFSG.StandardType.SCFourCover.E6AdToral ((E.map (twistedE6RootGroup K σ).subtype).map
      (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))))
    {h₀ : ↥(twistedE6RootGroup K σ)} (hh₀ : h₀ ∈ E) (hdim : twE6FixDim K σ h₀ = 36) :
    ∃ (ω : (AlgebraicClosure K)ˣ) (Y : ModGL Tag.E6 (AlgebraicClosure K)),
      orderOf ω = 3 ∧ Y ∈ adjointGroup Tag.E6 (AlgebraicClosure K) ∧
      Y * (baseChangeGL (algebraMap K (AlgebraicClosure K)) (h₀ : ModGL TwistTag.E6.tag K) :
          ModGL Tag.E6 (AlgebraicClosure K)) * Y⁻¹ = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) ∧
      (∃ u ∈ E, Y * (baseChangeGL (algebraMap K (AlgebraicClosure K)) (u : ModGL TwistTag.E6.tag K) :
          ModGL Tag.E6 (AlgebraicClosure K)) * Y⁻¹ =
        rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2))) ∧
      ∀ e ∈ E, Y * (baseChangeGL (algebraMap K (AlgebraicClosure K)) (e : ModGL TwistTag.E6.tag K) :
          ModGL Tag.E6 (AlgebraicClosure K)) * Y⁻¹ ∈
        thirdTorus (AlgebraicClosure K) ⊔ blockGroup (AlgebraicClosure K) := by
  have : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hK
  have : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  have h3L : ((3 : ℕ) : AlgebraicClosure K) ≠ 0 := by
    rw [show (3 : ℕ) = 2 + 1 from rfl, Nat.cast_add, CharP.cast_eq_zero, zero_add, Nat.cast_one]
    exact one_ne_zero
  set bc : ↥(twistedE6RootGroup K σ) →* ModGL Tag.E6 (AlgebraicClosure K) :=
    (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))).comp
      (twistedE6RootGroup K σ).subtype with hbc
  have hbcA : ∀ e, bc e ∈ adjointGroup Tag.E6 (AlgebraicClosure K) := fun e =>
    baseChangeGL_mem_adjointGroup (algebraMap K (AlgebraicClosure K))
      ((mem_twistedFixedGroup_iff_twistHom TwistTag.E6 K σ.toRingHom).1
        (graphFixedRootGroup_le TwistTag.E6 K σ.toRingHom e.2)).1
  have hbcI : Function.Injective bc :=
    (baseChangeGL_injective _).comp (Subgroup.subtype_injective _)
  have hEc : ∀ e ∈ E, ∀ e' ∈ E, e * e' = e' * e := fun e he e' he' =>
    congrArg Subtype.val (hE.1.is_comm.comm ⟨e, he⟩ ⟨e', he'⟩)
  obtain ⟨y₁, hy₁, a, ha3, hh₀a⟩ := SmallQ3.exists_conj_toral_E6_three (K := K) (hbcA h₀)
    (by rw [← map_pow, hE.2 h₀ hh₀, map_one])
  have hk30 : (kernelRoots (rootCharHom a)).ncard = 30 := by
    have h := KSNotAll24.twE6MatFixDim_eq_of_conj σ
      ⟨(h₀ : ModGL TwistTag.E6.tag K), (le_sup_left : twistedE6RootGroup K σ ≤ _) h₀.2⟩ y₁ a
      hh₀a.symm
    have e : twE6MatFixDim K σ ⟨(h₀ : ModGL TwistTag.E6.tag K),
        (le_sup_left : twistedE6RootGroup K σ ≤ _) h₀.2⟩ = twE6FixDim K σ h₀ := rfl
    omega
  obtain ⟨ω, hω, w, hw⟩ := exists_conj_xt ha3 hk30
  set y := canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) w * y₁⁻¹ with hydef
  have hy : y ∈ adjointGroup Tag.E6 (AlgebraicClosure K) :=
    mul_mem (canonicalRep_mem_adjointGroup _ _ w) (inv_mem hy₁)
  have hyh : y * bc h₀ * y⁻¹ = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := by
    rw [hw, hh₀a, hydef]
    group
  obtain ⟨ψ, hψ⟩ := exists_frame_chainB (L := AlgebraicClosure K)
  have hTC := toralCentralizer_xt hω hψ
  set φ₀ : ↥(twistedE6RootGroup K σ) →* ModGL Tag.E6 (AlgebraicClosure K) :=
    (MulAut.conj y).toMonoidHom.comp bc with hφ₀
  have hφ₀A : ∀ e, φ₀ e ∈ adjointGroup Tag.E6 (AlgebraicClosure K) := fun e =>
    mul_mem (mul_mem hy (hbcA e)) (inv_mem hy)
  have hφ₀h : φ₀ h₀ = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := hyh
  have hφ₀c : ∀ e ∈ E, ∀ e' ∈ E, φ₀ e * φ₀ e' = φ₀ e' * φ₀ e := fun e he e' he' => by
    rw [← map_mul, ← map_mul, hEc e he e' he']
  have hφ₀M : ∀ e ∈ E, φ₀ e ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range := by
    intro e he
    rw [← hTC, mem_toralCentralizer]
    refine ⟨hφ₀A e, ?_⟩
    rw [← hφ₀h, hφ₀c h₀ hh₀ e he, mul_inv_cancel_right]
  have hact : ∀ g : ModGL Tag.E6 (AlgebraicClosure K), ∃ M : GL (Fin 6) (AlgebraicClosure K),
      g ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range → Acts ψ g M := by
    intro g
    by_cases hg : g ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range
    · obtain ⟨M, hM⟩ := KSGen.mem_actsOn.1
        (sup_le (KSGen.torusGroup_le_actsOn hψ (by norm_num)) (KSGen.range_le_actsOn ψ) hg)
      exact ⟨M, fun _ => hM⟩
    · exact ⟨1, fun hg' => absurd hg' hg⟩
  choose B hB using hact
  have hBe : ∀ e ∈ E, Acts ψ (φ₀ e) (B (φ₀ e)) := fun e he => hB _ (hφ₀M e he)
  have hcube : ∀ e : E, ∃ μ : AlgebraicClosure K,
      ((B (φ₀ e) ^ 3 : GL (Fin 6) (AlgebraicClosure K)) :
        Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) = μ • 1 := by
    intro e
    have h := acts_mul (acts_mul (hBe e e.2) (hBe e e.2)) (hBe e e.2)
    have h1 : φ₀ e * φ₀ e * φ₀ e = 1 := by
      rw [← map_mul, ← map_mul, ← pow_three', hE.2 e e.2, map_one]
    rw [h1] at h
    rw [pow_three']
    exact frame_conj_scalar hψ _ fun Z => by rw [← h Z]; group
  have hcomm : ∀ e e' : E, ∃ μ : AlgebraicClosure K,
      ((B (φ₀ e) * B (φ₀ e') * (B (φ₀ e))⁻¹ * (B (φ₀ e'))⁻¹ : GL (Fin 6) (AlgebraicClosure K)) :
        Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) = μ • 1 := by
    intro e e'
    have h := acts_mul (acts_mul (acts_mul (hBe e e.2) (hBe e' e'.2)) (acts_inv (hBe e e.2)))
      (acts_inv (hBe e' e'.2))
    have h1 : φ₀ e * φ₀ e' * (φ₀ e)⁻¹ * (φ₀ e')⁻¹ = 1 := by
      rw [hφ₀c e e.2 e' e'.2]
      group
    rw [h1] at h
    exact frame_conj_scalar hψ _ fun Z => by rw [← h Z]; group
  have hnc : ∃ e₁ e₂ : E, B (φ₀ e₁) * B (φ₀ e₂) ≠ B (φ₀ e₂) * B (φ₀ e₁) := by
    by_contra hall
    push Not at hall
    apply hnt
    have hmemX : ∀ x ∈ ((E.map (twistedE6RootGroup K σ).subtype).map
        (baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)))).map
          (MulAut.conj y).toMonoidHom, ∃ e : E, x = φ₀ e := by
      rintro _ ⟨_, ⟨_, ⟨e, he, rfl⟩, rfl⟩, rfl⟩
      exact ⟨⟨e, he⟩, rfl⟩
    rw [← e6AdToral_map_conj hy]
    refine e6AdToral_of_frame_commute h3L hψ
      (isElemAbelian_map _ (isElemAbelian_map _ (isElemAbelian_map _ hE))) ?_ B ?_ ?_
    · intro x hx
      obtain ⟨e, rfl⟩ := hmemX x hx
      exact hφ₀M e e.2
    · intro x hx
      obtain ⟨e, rfl⟩ := hmemX x hx
      exact hBe e e.2
    · intro x hx x' hx'
      obtain ⟨e, rfl⟩ := hmemX x hx
      obtain ⟨e', rfl⟩ := hmemX x' hx'
      exact hall e e'
  obtain ⟨P, ω', -, -, hP⟩ :=
    exists_heis_normal_form h3L (fun e : E => B (φ₀ e)) hcube hcomm hnc
  choose fi fj fl fm hfi hfj hfl hfm hfe using hP
  have hfe' : ∀ e : E, ((P⁻¹ * B (φ₀ e) * P : GL (Fin 6) (AlgebraicClosure K)) :
      Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) =
        heisX ω' ^ fi e * heisY ^ fj e * heisD (fl e) (fm e) := hfe
  have hdet : (P : Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)).det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).1 P.isUnit).ne_zero
  obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq
    (P : Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)).det⁻¹ (by norm_num : 0 < 6)
  obtain ⟨Q, hQ⟩ : ∃ Q : SL(6, AlgebraicClosure K),
      (Q : Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) = c • (P : Matrix _ _ _) :=
    ⟨⟨c • (P : Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)),
      by rw [Matrix.det_smul, Fintype.card_fin, hc, inv_mul_cancel₀ hdet]⟩, rfl⟩
  have hQP : ((Matrix.SpecialLinearGroup.toGL Q : GL (Fin 6) (AlgebraicClosure K)) :
      Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) = c • (P : Matrix _ _ _) := by
    rw [Matrix.SpecialLinearGroup.coe_GL_coe_matrix, hQ]
  have hQact : Acts ψ (ψ Q) (Matrix.SpecialLinearGroup.toGL Q) := fun Z => by
    rw [KSGen.conjSLn_toGL_apply, map_mul, map_mul, map_inv]
  have hQM : ψ Q ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range :=
    Subgroup.mem_sup_right ⟨Q, rfl⟩
  have hQc : rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * ψ Q =
      ψ Q * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := by
    have h := (mem_toralCentralizer.1 (hTC ▸ hQM)).2
    calc rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * ψ Q =
        (rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * ψ Q *
          (rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω))⁻¹) * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := by
          group
      _ = ψ Q * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := by rw [h]
  set Y := (ψ Q)⁻¹ * y with hYdef
  have hYA : Y ∈ adjointGroup Tag.E6 (AlgebraicClosure K) :=
    mul_mem (inv_mem (hψ.range_le_adjointGroup ⟨Q, rfl⟩)) hy
  set φ : ↥(twistedE6RootGroup K σ) →* ModGL Tag.E6 (AlgebraicClosure K) :=
    (MulAut.conj Y).toMonoidHom.comp bc with hφ
  have hφapp : ∀ e, φ e = (ψ Q)⁻¹ * φ₀ e * ψ Q := fun e => by
    change Y * bc e * Y⁻¹ = (ψ Q)⁻¹ * (y * bc e * y⁻¹) * ψ Q
    rw [hYdef]
    group
  have hφA : ∀ e, φ e ∈ adjointGroup Tag.E6 (AlgebraicClosure K) := fun e =>
    mul_mem (mul_mem hYA (hbcA e)) (inv_mem hYA)
  have hφI : Function.Injective φ := fun e e' h => by
    change Y * bc e * Y⁻¹ = Y * bc e' * Y⁻¹ at h
    exact hbcI (mul_left_cancel (mul_right_cancel h))
  have hφh : φ h₀ = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := by
    rw [hφapp, hφ₀h, mul_assoc, hQc, ← mul_assoc, inv_mul_cancel, one_mul]
  have hφM : ∀ e ∈ E, φ e ∈ torusGroup Tag.E6 (AlgebraicClosure K) ⊔ ψ.range := fun e he => by
    rw [hφapp]
    exact mul_mem (mul_mem (inv_mem hQM) (hφ₀M e he)) hQM
  have hXact : ∀ e ∈ E, Acts ψ (φ e) (P⁻¹ * B (φ₀ e) * P) := fun e he => by
    have h := acts_mul (acts_mul (acts_inv hQact) (hBe e he)) hQact
    rw [conj_eq_of_smul hQP] at h
    rw [hφapp]
    exact h
  have hfib : ∀ e e' : E, fi e = fi e' → fj e = fj e' →
      φ ((e : ↥(twistedE6RootGroup K σ))⁻¹ * e') ∈ thirdTorus (AlgebraicClosure K) := by
    intro e e' hi hj
    have hA := acts_mul (acts_inv (hXact e e.2)) (hXact e' e'.2)
    rw [← map_inv, ← map_mul] at hA
    refine mem_thirdTorus_of_acts_heisD hψ (hφM _ (E.mul_mem (E.inv_mem e.2) e'.2))
      (l := (fl e)⁻¹ * fl e') (m := (fm e)⁻¹ * fm e') ?_ hA
    have hG' : ((P⁻¹ * B (φ₀ e') * P : GL (Fin 6) (AlgebraicClosure K)) :
        Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) =
          ((P⁻¹ * B (φ₀ e) * P : GL (Fin 6) (AlgebraicClosure K)) :
            Matrix (Fin 6) (Fin 6) (AlgebraicClosure K)) *
            heisD ((fl e)⁻¹ * fl e') ((fm e)⁻¹ * fm e') := by
      rw [hfe' e, hfe' e', ← hi, ← hj, Matrix.mul_assoc _ (heisD _ _), heisD_mul_heisD,
        mul_inv_cancel_left₀ (hfl e), mul_inv_cancel_left₀ (hfm e)]
    rw [Units.val_mul, hG', ← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul]
  have : Finite ↥E := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  set E₀ : Subgroup ↥E := (thirdTorus (AlgebraicClosure K)).comap (φ.comp E.subtype) with hE₀
  set f : ↥E → Fin 3 × Fin 3 := fun e => (⟨fi e, hfi e⟩, ⟨fj e, hfj e⟩) with hf
  classical
  set sec : Fin 3 × Fin 3 → ↥E := fun v => if h : ∃ e, f e = v then h.choose else 1 with hsec
  have hsec_spec : ∀ e, f (sec (f e)) = f e := fun e => by
    have h : ∃ e', f e' = f e := ⟨e, rfl⟩
    simp only [hsec, dif_pos h]
    exact h.choose_spec
  have hmem₀ : ∀ e : ↥E, (sec (f e))⁻¹ * e ∈ E₀ := by
    intro e
    have h := hsec_spec e
    simp only [hf, Prod.mk.injEq, Fin.mk.injEq] at h
    exact hfib (sec (f e)) e h.1 h.2
  have hinj : Function.Injective
      (fun e : ↥E => (f e, (⟨(sec (f e))⁻¹ * e, hmem₀ e⟩ : ↥E₀))) := by
    intro e e' h
    simp only [Prod.mk.injEq, Subtype.mk.injEq] at h
    obtain ⟨h1, h2⟩ := h
    rw [h1] at h2
    exact mul_left_cancel h2
  have h9 : 9 ≤ Nat.card ↥E₀ := by
    have h := Nat.card_le_card_of_injective _ hinj
    have h3 : Nat.card (Fin 3) = 3 := by simp
    rw [Nat.card_prod, Nat.card_prod, h3, hcard] at h
    omega
  set S9 : Set (ModGL Tag.E6 (AlgebraicClosure K)) := Set.range fun p : Fin 3 × Fin 3 =>
    rootDiagUnit Tag.E6 (Pi.mulSingle 1 (ω ^ (p.1 : ℕ)) * Pi.mulSingle 3 (ω ^ (p.2 : ℕ)))
    with hS9
  have hS9card : Nat.card S9 ≤ 9 := (Finite.card_range_le _).trans_eq (by simp)
  have hφS9 : ∀ e : ↥E₀, φ (e : ↥E) ∈ S9 := by
    intro e
    have he2 : φ ((e : ↥E) : ↥(twistedE6RootGroup K σ)) ∈ thirdTorus (AlgebraicClosure K) := e.2
    obtain ⟨c', h0, h2, h4, h5, hc'⟩ := he2
    have hc3 : ∀ j, c' j ^ 3 = 1 := by
      have h1 : rootDiagUnit Tag.E6 (c' ^ 3) = rootDiagUnit Tag.E6 1 := by
        rw [← CFSG.LieType.Chevalley.rootDiagUnit_pow, rootDiagUnit_one, ← hc', ← map_pow,
          hE.2 _ e.1.2, map_one]
      intro j
      simpa using congrFun (CFSG.LieType.Chevalley.rootDiagUnit_injective h1) j
    obtain ⟨p, hp⟩ := exists_pow_eq_of_pow_three hω (hc3 1)
    obtain ⟨q, hq⟩ := exists_pow_eq_of_pow_three hω (hc3 3)
    refine ⟨(p, q), ?_⟩
    rw [hc']
    exact congrArg (rootDiagUnit Tag.E6) (eq_mulSingle_of h0 h2 h4 h5 hp hq)
  have hFinj : Function.Injective fun e : ↥E₀ => (⟨φ (e : ↥E), hφS9 e⟩ : ↥S9) := by
    intro e e' h
    have h' : φ (e : ↥E) = φ (e' : ↥E) := congrArg Subtype.val h
    exact Subtype.ext (Subtype.ext (hφI h'))
  have : Finite ↥S9 := Set.finite_range _ |>.to_subtype
  obtain ⟨u, hu⟩ := (hFinj.bijective_of_nat_card_le (hS9card.trans h9)).2
    ⟨rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2)), ⟨(1, 2), by simp⟩⟩
  have hu' : φ (u : ↥E) = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2)) :=
    congrArg Subtype.val hu
  refine ⟨ω, Y, hω, hYA, hφh, ⟨(u : ↥E), (u : ↥E).2, hu'⟩, fun e he => ?_⟩
  refine mem_thirdTorus_sup_blockGroup_of_commute hω (hφA e) ?_ ?_
  · change φ e * _ = _ * φ e
    rw [← hφh, ← map_mul, ← map_mul, hEc e he h₀ hh₀]
  · change φ e * _ = _ * φ e
    rw [← hu', ← map_mul, ← map_mul, hEc e he _ (u : ↥E).2]

end CFSG.StandardType.KG87B

