theorem ggHasLabel_C_of_statedClassicalModel {X : Type} [Group X] {n f : ℕ}
    (h : CFSG.Open.StatedClassicalModel X .PSp n 2 f) : GGHasLabel ⟨.C, n, f⟩ X := by
  obtain ⟨-, K, hF, hfin, hcard, ⟨e⟩⟩ := h
  exact ⟨K, hF, hfin, hcard, ⟨e⟩⟩

private theorem map_centralizer_singleton_eq_of_ker_eq_center {H G : Type} [Group H] [Group G]
    (π : H →* G) (hπ : Function.Surjective π) (hker : π.ker = Subgroup.center H)
    {z : H} (hz3 : z ^ 3 = 1) (hZ : ¬ 3 ∣ Nat.card (Subgroup.center H)) :
    (Subgroup.centralizer ({z} : Set H)).map π =
      Subgroup.centralizer ({π z} : Set G) := by
  ext w
  constructor
  · rintro ⟨c, hc, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff] at hc
    rw [Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul, hc]
  · intro hw
    rw [Subgroup.mem_centralizer_singleton_iff] at hw
    obtain ⟨c, rfl⟩ := hπ w
    refine Subgroup.mem_map.mpr ⟨c, ?_, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hmem : c * z * c⁻¹ * z⁻¹ ∈ Subgroup.center H := by
      rw [← hker, MonoidHom.mem_ker]
      have h1 : π (c * z * c⁻¹) = π z := by
        rw [map_mul, map_mul, map_inv]
        calc π c * π z * (π c)⁻¹ = π z * π c * (π c)⁻¹ := by rw [hw]
          _ = π z := by group
      rw [map_mul, h1, map_inv, mul_inv_cancel]
    have hcop : Nat.Coprime 3 (Nat.card (Subgroup.center H)) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr hZ
    have hq : ((c * z * c⁻¹ : H) : H ⧸ Subgroup.center H) =
        (z : H ⧸ Subgroup.center H) := by
      rw [QuotientGroup.eq_iff_div_mem]
      simpa only [div_eq_mul_inv] using hmem
    have hcx : c * z * c⁻¹ = z :=
      CFSG.GroupTheory.eq_of_mk_eq_of_pow_eq_one_of_coprime le_rfl hcop
        (by rw [conj_pow, hz3]; group) hz3 hq
    calc c * z = (c * z * c⁻¹) * c := by group
      _ = z * c := by rw [hcx]

private theorem component_le_map_of_ker_eq_center {H G : Type} [Group H] [Group G]
    (π : H →* G) (hπ : Function.Surjective π) (hker : π.ker = Subgroup.center H)
    {z : H} (hz3 : z ^ 3 = 1) (hZ : ¬ 3 ∣ Nat.card (Subgroup.center H))
    {J : Subgroup H} (hJ : J = LargeEvenLayer (Subgroup.centralizer ({z} : Set H)))
    {J' : Subgroup G}
    (hJ' : CFSG.Open.IsComponentOf J' (Subgroup.centralizer ({π z} : Set G))) :
    J' ≤ J.map π := by
  have hC := map_centralizer_singleton_eq_of_ker_eq_center π hπ hker hz3 hZ
  rw [← hC] at hJ'
  obtain ⟨K', hK'c, hK'map⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.I142N.exists_component_lift π
      (fun g hg => hker ▸ MonoidHom.mem_ker.mpr hg) hJ'
  have hK'J : K' ≤ J := by
    rw [hJ]
    exact CFSG.StandardType.le_largeEvenLayer ((isComponentOf_iff_open).mpr hK'c)
  calc J' = K'.map π := hK'map.symm
    _ ≤ J.map π := Subgroup.map_mono hK'J

private theorem nonempty_centerQuotientEquiv_subgroupMap {H G : Type} [Group H] [Group G]
    (π : H →* G) (hker : π.ker = Subgroup.center H) {J : Subgroup H}
    (hq : CFSG.Assembly.IsQuasisimple ↥J) :
    Nonempty (↥J ⧸ Subgroup.center ↥J ≃* ↥(J.map π) ⧸ Subgroup.center ↥(J.map π)) := by
  have hP : Group.IsPerfect ↥J := ⟨hq.1⟩
  have hkerJ : (π.subgroupMap J).ker ≤ Subgroup.center ↥J := by
    rw [Subgroup.ker_subgroupMap]
    intro x hx
    rw [Subgroup.mem_subgroupOf] at hx
    rw [Subgroup.mem_center_iff]
    intro y
    apply Subtype.ext
    exact Subgroup.mem_center_iff.mp (hker ▸ hx) (y : H)
  exact CFSG.RankThree.PartOne.nonempty_centerQuotientEquiv_of_surjective hP
    (π.subgroupMap J) (MonoidHom.subgroupMap_surjective π J) hkerJ

