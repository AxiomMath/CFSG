theorem exists_surjective_adjointGroupF4_of_ggHasLabel {H : Type} [Group H] {f : ℕ}
    (hH : GGHasLabel ⟨.F4, 0, f⟩ (H ⧸ Subgroup.center H)) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = 2 ^ f ∧
      ∃ π : H →* ↥(adjointGroup Tag.F4 K), Function.Surjective π ∧ π.ker = Subgroup.center H := by
  obtain ⟨K, hF, hfin, hcard, ⟨e⟩⟩ := hH
  let : Field K := hF
  let : Finite K := hfin
  have : CharP K 2 :=
    CFSG.HardMathSupport.Solomon.LocalBalance.Lemma56Ns.charP_two_of_card hcard
  obtain ⟨eC⟩ := centerQuot_chevGroup_equiv (K := K) Tag.F4
  let e0 : CFSG.Blueprint.AdjointQuotient Tag.F4 K ≃* adjointGroup Tag.F4 K :=
    (QuotientGroup.quotientMulEquivOfEq
      (F4ExplicitPos.CenterProofFast.center_adjointGroup_F4_charTwo_eq_bot (K := K))).trans
      QuotientGroup.quotientBot
  let eF4 : TableBF4.RecipeGroup K ≃* adjointGroup Tag.F4 K := eC.trans e0
  refine ⟨K, hF, hfin, hcard, ?_⟩
  let π : H →* ↥(adjointGroup Tag.F4 K) :=
    eF4.toMonoidHom.comp
      (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center H)))
  refine ⟨π, ?_, ?_⟩
  · exact eF4.surjective.comp
      (e.surjective.comp (QuotientGroup.mk'_surjective (Subgroup.center H)))
  · ext x
    rw [MonoidHom.mem_ker, show π x = eF4
        (e (QuotientGroup.mk' (Subgroup.center H) x)) from rfl,
      eF4.map_eq_one_iff, e.map_eq_one_iff,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]

end CentralCover



theorem not_three_dvd_card_center_of_ggHasLabel_F4 {H : Type} [Group H] [Finite H]
    [Group.IsPerfect H] {f : ℕ} (hH : GGHasLabel ⟨.F4, 0, f⟩ (H ⧸ Subgroup.center H)) :
    ¬ 3 ∣ Nat.card (Subgroup.center H) := by
  obtain ⟨K, hF, hfin, hcard, ⟨e⟩⟩ := hH
  let : Field K := hF
  let : Finite K := hfin
  have : CharP K 2 :=
    CFSG.HardMathSupport.Solomon.LocalBalance.Lemma56Ns.charP_two_of_card hcard
  have hcp := ExcSplitL.ggCenterPrime_recipe_F4 (K := K) Nat.prime_three (by norm_num)
  let ψ : H →* TableBF4.RecipeGroup K :=
    e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center H))
  have hψ : Function.Surjective ψ :=
    e.surjective.comp (QuotientGroup.mk'_surjective (Subgroup.center H))
  have hker : ψ.ker ≤ Subgroup.center H := by
    intro x hx
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply] at hx
    have hx1 : QuotientGroup.mk' (Subgroup.center H) x = 1 := e.injective (by simpa using hx)
    exact (QuotientGroup.eq_one_iff x).mp hx1
  exact hcp H ψ hψ hker (Group.IsPerfect.commutator_eq_top (G := H))


private theorem f4_order_three_model {H : Type} [Group H] [Finite H] {f : ℕ}
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ f)
    (π : H →* ↥(adjointGroup Tag.F4 K)) (hπ : Function.Surjective π)
    (hker : π.ker = Subgroup.center H) {z : H} (hz3 : z ^ 3 = 1)
    (hzord : orderOf (π z) = 3) (hZ : ¬ 3 ∣ Nat.card (Subgroup.center H))
    {J : Subgroup H} (hJ : J = LargeEvenLayer (Subgroup.centralizer ({z} : Set H)))
    (hJc : IsComponentOf J (Subgroup.centralizer ({z} : Set H))) :
    CFSG.Open.StatedClassicalModel (↥(J.map π) ⧸ Subgroup.center ↥(J.map π)) .PSp 3 2 f := by
  have hC := map_centralizer_singleton_eq_of_ker_eq_center π hπ hker hz3 hZ
  have hfix : CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj (π z)) =
      Subgroup.centralizer ({π z} : Set ↥(adjointGroup Tag.F4 K)) :=
    CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup_conj (π z)
  have hJcomp : IsComponentOf (J.map π)
      (Subgroup.centralizer ({π z} : Set ↥(adjointGroup Tag.F4 K))) := by
    have h := CFSG.ComponentClassification.HarrisLit.N36.isComponentOf_map_of_ker_le_center π
      (le_of_eq hker) hJc
    rwa [hC] at h
  have hJcompO : CFSG.Open.IsComponentOf (J.map π)
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj (π z))) := by
    rw [hfix]
    exact (isComponentOf_iff_open).mp hJcomp
  have hle : ∀ J' : Subgroup ↥(adjointGroup Tag.F4 K),
      CFSG.Open.IsComponentOf J'
        (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj (π z))) →
        J' ≤ J.map π := by
    intro J' hJ'
    rw [hfix] at hJ'
    exact component_le_map_of_ker_eq_center π hπ hker hz3 hZ hJ hJ'
  exact CFSG.LocalAnalysis.GLTheoremA.S265.SG.model_of_le_component_F4_of_card
    (F := K) hK (π z) hzord hJcompO hle

theorem ggF4OrderThree_layer_label {H : Type} [Group H] [Finite H] [Group.IsPerfect H] {f : ℕ}
    (hH : GGHasLabel ⟨.F4, 0, f⟩ (H ⧸ Subgroup.center H)) {z : H} (hz1 : z ≠ 1)
    (hz3 : z ^ 3 = 1) {J : Subgroup H}
    (hJ : J = LargeEvenLayer (Subgroup.centralizer ({z} : Set H)))
    (hJc : IsComponentOf J (Subgroup.centralizer ({z} : Set H))) :
    GGHasLabel ⟨.C, 3, f⟩ (J ⧸ Subgroup.center J) := by
  have h3 : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨K, hF, hfin, hcard, π, hπ, hker⟩ :=
    exists_surjective_adjointGroupF4_of_ggHasLabel hH
  let : Field K := hF
  let : Finite K := hfin
  have : Finite ↥(adjointGroup Tag.F4 K) :=
    CFSG.LieType.Chevalley.generated_group_finite Tag.F4 K
  have hZ : ¬ 3 ∣ Nat.card (Subgroup.center H) :=
    not_three_dvd_card_center_of_ggHasLabel_F4 hH
  have hzord : orderOf z = 3 := orderOf_eq_prime (p := 3) (hp := h3) hz3 hz1
  have hzZ : z ∉ Subgroup.center H := by
    intro hz
    apply hZ
    have hdvd : orderOf z ∣ Nat.card (Subgroup.center H) := Subgroup.orderOf_dvd_natCard _ hz
    rwa [hzord] at hdvd
  have hπz1 : π z ≠ 1 := fun h => hzZ (hker ▸ MonoidHom.mem_ker.mpr h)
  have hπzord : orderOf (π z) = 3 :=
    orderOf_eq_prime (p := 3) (hp := h3) (by rw [← map_pow, hz3, map_one]) hπz1
  have hmodel := f4_order_three_model hcard π hπ hker hz3 hπzord hZ hJ hJc
  obtain ⟨eJ⟩ := nonempty_centerQuotientEquiv_subgroupMap π hker hJc.2.2
  exact ggHasLabel_C_of_statedClassicalModel
    (CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv eJ.symm hmodel)

