theorem kernelRoots_eq_of_orbit_three
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup Tag.E6 L p₀)
    (h3 : ((3 : ℕ) : L) ≠ 0) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ j, a j ^ 3 = 1)
    (h1 : rootDiagUnit Tag.E6 a ≠ 1) (i : KernelComponent (rootCharHom a))
    (hs3 : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 3)
    (h6 : (componentRoots (rootCharHom a) i).ncard = 6) :
    (kernelRoots (rootCharHom a)).ncard = 18 ∧
      kernelRoots (rootCharHom a) =
        componentRoots (rootCharHom a) i ∪ (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) '' componentRoots (rootCharHom a) i ∪ (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] '' componentRoots (rootCharHom a) i := by
  classical
  obtain ⟨j, hj⟩ := outer_exists_image_component S hT i
  obtain ⟨k, hk⟩ := outer_exists_image_component S hT j
  have hiter2 : (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] ''
      componentRoots (rootCharHom a) i = componentRoots (rootCharHom a) k := by
    rw [show (2 : ℕ) = 1 + 1 from rfl, Function.iterate_add, Set.image_comp]
    simp only [Function.iterate_one]
    rw [hj, hk]
  have hji : i ≠ j := by
    intro h
    rw [← h] at hj
    have h1mem : 1 ∈ {s : ℕ | 0 < s ∧
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[s] ''
          componentRoots (rootCharHom a) i = componentRoots (rootCharHom a) i} :=
      ⟨by norm_num, by simpa [Function.iterate_one] using hj⟩
    have hle : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) ≤ 1 :=
      Nat.sInf_le h1mem
    omega
  have hki : i ≠ k := by
    intro h
    have h2mem : 2 ∈ {s : ℕ | 0 < s ∧
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[s] ''
          componentRoots (rootCharHom a) i = componentRoots (rootCharHom a) i} :=
      ⟨by norm_num, by rw [hiter2, ← h]⟩
    have hle : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) ≤ 2 :=
      Nat.sInf_le h2mem
    omega
  have hjk : j ≠ k := by
    intro h
    have himg : (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) ''
          componentRoots (rootCharHom a) j =
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) ''
          componentRoots (rootCharHom a) i := by
      rw [hj, hk, h]
    have hsets : componentRoots (rootCharHom a) j = componentRoots (rootCharHom a) i :=
      Set.image_injective.2 S.ρ.injective himg
    exact hji (eq_of_componentRoots_eq hsets).symm
  have F : KacFacts a := kac_facts h3 hap
  obtain ⟨h6i, h6j, h6k⟩ := F.three i j k hji hki hjk
  have hcl : ∀ c : KernelComponent (rootCharHom a), c = i ∨ c = j ∨ c = k := by
    intro c
    by_contra hc
    push Not at hc
    exact F.four i j k c hji hki (Ne.symm hc.1) hjk (Ne.symm hc.2.1) (Ne.symm hc.2.2)
  have hcover : kernelRoots (rootCharHom a) ⊆
      componentRoots (rootCharHom a) i ∪
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) '' componentRoots (rootCharHom a) i ∪
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] '' componentRoots (rootCharHom a) i := by
    intro α hα
    have hclass : α ∈ componentRoots (rootCharHom a)
        (⟦⟨α, hα⟩⟧ : KernelComponent (rootCharHom a)) := ⟨hα, rfl⟩
    rcases hcl (⟦⟨α, hα⟩⟧ : KernelComponent (rootCharHom a)) with h | h | h
    · exact Or.inl (Or.inl (h ▸ hclass))
    · exact Or.inl (Or.inr (by rw [hj]; exact h ▸ hclass))
    · exact Or.inr (by rw [hiter2]; exact h ▸ hclass)
  have hsub : componentRoots (rootCharHom a) i ∪
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) '' componentRoots (rootCharHom a) i ∪
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] '' componentRoots (rootCharHom a) i ⊆
      kernelRoots (rootCharHom a) := by
    refine Set.union_subset (Set.union_subset ?_ ?_) ?_
    · exact fun _ h => h.1
    · rw [hj]; exact fun _ h => h.1
    · rw [hiter2]; exact fun _ h => h.1
  have hker : kernelRoots (rootCharHom a) =
      componentRoots (rootCharHom a) i ∪
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) '' componentRoots (rootCharHom a) i ∪
        (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] '' componentRoots (rootCharHom a) i :=
    Set.Subset.antisymm hcover hsub
  have hdAB : Disjoint (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) ''
        componentRoots (rootCharHom a) i) := by
    rw [hj]; exact disjoint_componentRoots hji
  have hdAC : Disjoint (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] ''
        componentRoots (rootCharHom a) i) := by
    rw [hiter2]; exact disjoint_componentRoots hki
  have hdBC : Disjoint
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) '' componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] '' componentRoots (rootCharHom a) i) := by
    rw [hj, hiter2]; exact disjoint_componentRoots hjk
  have hfin : (kernelRoots (rootCharHom a)).Finite := finite_kernelRoots_E6 (rootCharHom a)
  have hfA : (componentRoots (rootCharHom a) i).Finite := hfin.subset (fun _ h => h.1)
  have hfB : ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) ''
      componentRoots (rootCharHom a) i).Finite := by
    rw [hj]; exact hfin.subset (fun _ h => h.1)
  have hfC : ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] ''
      componentRoots (rootCharHom a) i).Finite := by
    rw [hiter2]; exact hfin.subset (fun _ h => h.1)
  have hcardB : ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ)) ''
      componentRoots (rootCharHom a) i).ncard = 6 := by
    rw [hj]; exact h6j
  have hcardC : ((S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))^[2] ''
      componentRoots (rootCharHom a) i).ncard = 6 := by
    rw [hiter2]; exact h6k
  have hcard18 : (kernelRoots (rootCharHom a)).ncard = 18 := by
    rw [hker]
    rw [Set.ncard_union_eq (by rw [Set.disjoint_union_left]; exact ⟨hdAC, hdBC⟩) (hfA.union hfB) hfC,
      Set.ncard_union_eq hdAB hfA hfB, h6i, hcardB, hcardC]
  exact ⟨hcard18, hker⟩

private theorem rootChar_sum_aux {τ : Tag} {K : Type} [Field K] (x : Fin τ.rank → Kˣ)
    {ι : Type*} (s : Finset ι) (f : ι → Fin τ.rank → ℤ) :
    rootChar x (∑ i ∈ s, f i) = ∏ i ∈ s, rootChar x (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, Finset.prod_empty, rootChar_zero]
  | insert j s hj ih => rw [Finset.sum_insert hj, Finset.prod_insert hj, rootChar_add, ih]

private theorem rootChar_zsmul_aux {τ : Tag} {K : Type} [Field K] (x : Fin τ.rank → Kˣ)
    (n : ℤ) (v : Fin τ.rank → ℤ) : rootChar x (n • v) = rootChar x v ^ n := by
  simp only [rootChar, Pi.smul_apply, smul_eq_mul, ← Finset.prod_zpow]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [← zpow_mul, mul_comm]

private theorem rootChar_pow_three_eq_one {τ : Tag} {K : Type} [Field K] (x : Fin τ.rank → Kˣ)
    (hx : ∀ j, x j ^ 3 = 1) (v : Fin τ.rank → ℤ) : rootChar x v ^ 3 = 1 := by
  rw [show rootChar x v ^ 3 = rootChar x v ^ ((3 : ℕ) : ℤ) by rw [zpow_natCast],
    ← rootChar_zsmul_aux x ((3 : ℕ) : ℤ) v]
  rw [rootChar]
  refine Finset.prod_eq_one fun j _ => ?_
  rw [Pi.smul_apply, smul_eq_mul, zpow_mul, zpow_natCast, hx j, one_zpow]

private theorem exists_pow_eq_of_cube {L : Type} [Field L] {ζ : Lˣ} (hζ3 : ζ ^ 3 = 1)
    (hζ1 : ζ ≠ 1) {x : Lˣ} (hx3 : x ^ 3 = 1) : ∃ m : ℕ, m < 3 ∧ x = ζ ^ m := by
  have hζprim : IsPrimitiveRoot ζ 3 := by
    rw [IsPrimitiveRoot.iff_orderOf]
    have hdvd : orderOf ζ ∣ 3 := orderOf_dvd_iff_pow_eq_one.2 hζ3
    rcases (by norm_num : Nat.Prime 3).eq_one_or_self_of_dvd (orderOf ζ) hdvd with h | h
    · rw [orderOf_eq_one_iff] at h
      exact absurd h hζ1
    · exact h
  have hxmem : x ∈ rootsOfUnity 3 L := (mem_rootsOfUnity 3 x).mpr hx3
  obtain ⟨m, hm, hmx⟩ := hζprim.eq_pow_of_mem_rootsOfUnity hxmem
  exact ⟨m, hm, hmx.symm⟩

theorem encard_trivialOn_kernelRoots_le_three
    {L : Type} [Field L] [IsAlgClosed L] (h3 : ((3 : ℕ) : L) ≠ 0)
    {a : Fin Tag.E6.rank → Lˣ} (hap : ∀ j, a j ^ 3 = 1)
    (h18 : (kernelRoots (rootCharHom a)).ncard = 18) :
    {c : Fin Tag.E6.rank → Lˣ | (∀ j, c j ^ 3 = 1) ∧
      ∀ γ ∈ kernelRoots (rootCharHom a), rootChar c γ = 1}.encard ≤ 3 := by
  classical
  obtain ⟨w, hw⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.a2cube_exists_weyl_kernelRoots_eq
      h3 hap h18
  let v : Fin Tag.E6.rank → (Fin Tag.E6.rank → ℤ) :=
    fun j => w⁻¹ • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)
  have hexp : ∀ γ : Fin Tag.E6.rank → ℤ, γ = ∑ j, (w • γ) j • v j := by
    intro γ
    have h1 : w • γ = ∑ j, (w • γ) j • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) :=
      CFSG.HardMathSupport.Dickson.Sec6.Up34Exc.InnExcCong.eq_sum_single_smul (w • γ)
    calc γ = w⁻¹ • (w • γ) := (inv_smul_smul w γ).symm
      _ = w⁻¹ • (∑ j, (w • γ) j • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := by
            conv_lhs => rw [h1]
      _ = ∑ j, (w • γ) j • v j := by
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            exact smul_comm _ _ _
  have hroot_v : IsRoot Tag.E6 (v 3) := by
    have := IsRoot.smul (isRoot_single Tag.E6 (3 : Fin Tag.E6.rank)) w⁻¹
    simpa [v] using this
  have hv_mem : ∀ j, j ≠ 3 → v j ∈ kernelRoots (rootCharHom a) := by
    intro j hj
    rw [hw]
    refine ⟨Pi.single j 1, ⟨isRoot_single Tag.E6 j, ?_⟩, ?_⟩
    · rw [Pi.single_eq_of_ne' hj]
      exact dvd_zero 3
    · rfl
  have hv_mem' : ∀ j, j ≠ 3 → IsRoot Tag.E6 (v j) ∧ rootChar a (v j) = 1 := by
    intro j hj
    have := hv_mem j hj
    rwa [kernelRoots_rootCharHom] at this
  have hv3_not_mem : v 3 ∉ kernelRoots (rootCharHom a) := by
    intro hmem
    rw [hw] at hmem
    obtain ⟨γ, hγ, hγeq⟩ := hmem
    have hγe : γ = Pi.single (3 : Fin Tag.E6.rank) 1 := by
      have h := congrArg (fun x => w • x) hγeq
      rw [smul_inv_smul] at h
      simpa [v] using h
    rw [Set.mem_setOf_eq] at hγ
    have h1 : γ 3 = 1 := by rw [hγe, Pi.single_eq_same]
    rw [h1] at hγ
    exact absurd hγ.2 (by norm_num)
  have hzeta_ne : rootChar a (v 3) ≠ 1 := by
    intro h
    exact hv3_not_mem (by rw [kernelRoots_rootCharHom]; exact ⟨hroot_v, h⟩)
  have hchar : ∀ (x : Fin Tag.E6.rank → Lˣ), (∀ j, j ≠ 3 → rootChar x (v j) = 1) →
      ∀ γ, rootChar x γ = rootChar x (v 3) ^ ((w • γ) 3) := by
    intro x hx γ
    conv_lhs => rw [hexp γ]
    rw [rootChar_sum_aux x Finset.univ (fun j => (w • γ) j • v j)]
    rw [Finset.prod_eq_single (3 : Fin Tag.E6.rank)
      (fun j _ hj => by rw [rootChar_zsmul_aux, hx j hj, one_zpow])
      (fun h => absurd (Finset.mem_univ 3) h)]
    rw [rootChar_zsmul_aux]
  let f : Fin 3 → (Fin Tag.E6.rank → Lˣ) := fun k j => a j ^ (k : ℕ)
  have hTfin : ({f 0, f 1, f 2} : Set (Fin Tag.E6.rank → Lˣ)).Finite :=
    ((Set.finite_singleton (f 2)).insert (f 1)).insert (f 0)
  have hTncard : ({f 0, f 1, f 2} : Set (Fin Tag.E6.rank → Lˣ)).ncard ≤ 3 := by
    have h1 := Set.ncard_insert_le (f 1) ({f 2} : Set (Fin Tag.E6.rank → Lˣ))
    have h0 := Set.ncard_insert_le (f 0)
      (insert (f 1) ({f 2} : Set (Fin Tag.E6.rank → Lˣ)))
    simp only [Set.ncard_singleton] at h1
    omega
  have hrange : Set.range f = ({f 0, f 1, f 2} : Set (Fin Tag.E6.rank → Lˣ)) := by
    ext x
    constructor
    · rintro ⟨k, rfl⟩
      fin_cases k <;> simp
    · intro hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
      · exact ⟨2, rfl⟩
  have hsub : {c : Fin Tag.E6.rank → Lˣ | (∀ j, c j ^ 3 = 1) ∧
      ∀ γ ∈ kernelRoots (rootCharHom a), rootChar c γ = 1} ⊆
      ({f 0, f 1, f 2} : Set (Fin Tag.E6.rank → Lˣ)) := by
    rw [← hrange]
    intro c hc
    have hc1 : ∀ j, c j ^ 3 = 1 := hc.1
    have hc2 : ∀ γ ∈ kernelRoots (rootCharHom a), rootChar c γ = 1 := hc.2
    have hkill_c : ∀ j, j ≠ 3 → rootChar c (v j) = 1 := fun j hj => hc2 (v j) (hv_mem j hj)
    have hkill_a : ∀ j, j ≠ 3 → rootChar a (v j) = 1 := fun j hj => (hv_mem' j hj).2
    obtain ⟨m, hm3, hm⟩ := exists_pow_eq_of_cube (rootChar_pow_three_eq_one a hap (v 3))
      hzeta_ne (rootChar_pow_three_eq_one c hc1 (v 3))
    have hm' : (rootChar a (v 3)) ^ (m : ℤ) = rootChar c (v 3) := by
      rw [zpow_natCast]
      exact hm.symm
    have hceq : c = f ⟨m, hm3⟩ := by
      funext j
      let ej : Fin Tag.E6.rank → ℤ := Pi.single j (1 : ℤ)
      have hDa_j : rootChar a ej = a j := by
        simpa [ej] using rootChar_nsmul_single a j 1
      have hDc_j : rootChar c ej = c j := by
        simpa [ej] using rootChar_nsmul_single c j 1
      have hDc := hchar c hkill_c ej
      have hDa := hchar a hkill_a ej
      show c j = a j ^ m
      calc c j = rootChar c ej := hDc_j.symm
        _ = rootChar c (v 3) ^ ((w • ej) 3) := hDc
        _ = ((rootChar a (v 3)) ^ (m : ℤ)) ^ ((w • ej) 3) := by rw [← hm']
        _ = ((rootChar a (v 3)) ^ ((w • ej) 3)) ^ (m : ℤ) := by rw [zpow_comm]
        _ = (rootChar a ej) ^ (m : ℤ) := by rw [← hDa]
        _ = (a j) ^ (m : ℤ) := by rw [hDa_j]
        _ = a j ^ m := by rw [zpow_natCast]
    exact ⟨⟨m, hm3⟩, hceq.symm⟩
  have hTle : ({f 0, f 1, f 2} : Set (Fin Tag.E6.rank → Lˣ)).encard ≤ 3 := by
    rw [show (3 : ℕ∞) = ((3 : ℕ) : ℕ∞) from rfl, Set.encard_le_coe_iff_finite_ncard_le]
    exact ⟨hTfin, hTncard⟩
  exact (Set.encard_le_encard hsub).trans hTle

end CFSG.StandardType.TwE6TwA2K

