@[expose] def ggA6F4Val (e : Fin Tag.F4.rank → ZMod 7) (γ : Fin Tag.F4.rank → ℤ) : ZMod 7 :=
  ∑ i, e i * ((γ i : ℤ) : ZMod 7)

private def ggA6F4Cnt (e : Fin Tag.F4.rank → ZMod 7) (c : ZMod 7) : ℕ :=
  (rts.filter (fun l => decide (ggA6F4Val e (vec4 l) = c))).length

private def ggA6F4R : Finset (Fin Tag.F4.rank → ℤ) := (rts.map vec4).toFinset

private def ggA6F4Ps : Finset (ZMod 7 × ZMod 7) :=
  (Finset.univ : Finset (ZMod 7 × ZMod 7)).filter (fun p => p ≠ 0)

private def ggA6F4MkE (e0 e1 e2 e3 : ℕ) : Fin Tag.F4.rank → ZMod 7 :=
  fun i => if i = idx 0 then (e0 : ZMod 7) else if i = idx 1 then (e1 : ZMod 7)
    else if i = idx 2 then (e2 : ZMod 7) else (e3 : ZMod 7)

private def ggA6F4OkE (e0 e1 e2 e3 : ℕ) : Bool :=
  (e0 == 0 && e1 == 0 && e2 == 0 && e3 == 0) ||
  ((List.range 7).all (fun c => ggA6F4Cnt (ggA6F4MkE e0 e1 e2 e3) ((2 * (c : ZMod 7)))
      == ggA6F4Cnt (ggA6F4MkE e0 e1 e2 e3) (c : ZMod 7)) == false) ||
  ggA6F4Cnt (ggA6F4MkE e0 e1 e2 e3) 0 == 6

private theorem ggA6F4_all_ok :
    (List.range 7).all (fun e0 => (List.range 7).all (fun e1 =>
      (List.range 7).all (fun e2 => (List.range 7).all (fun e3 =>
        ggA6F4OkE e0 e1 e2 e3)))) = true := by
  simp only [List.all_eq_true, List.mem_range]
  intro e0 h0 e1 h1 e2 h2 e3 h3
  have hc : ∀ c : ZMod 7,
      ggA6F4Cnt (ggA6F4MkE e0 e1 e2 e3) c = KilledK.cntK e0 e1 e2 e3 c.val KilledK.RL :=
    KilledK.cnt_eq _ e0 e1 e2 e3 (by simp [ggA6F4MkE, idx, Fin.ext_iff])
      (by simp [ggA6F4MkE, idx, Fin.ext_iff]) (by simp [ggA6F4MkE, idx, Fin.ext_iff])
      (by simp [ggA6F4MkE, idx, Fin.ext_iff])
  rw [ggA6F4OkE]
  simp only [hc, KilledK.two_val, ZMod.val_natCast, ZMod.val_zero]
  exact KilledK.ok_all e0 h0 e1 h1 e2 h2 e3 h3

private theorem ggA6F4MkE_val (e : Fin Tag.F4.rank → ZMod 7) :
    ggA6F4MkE (e (idx 0)).val (e (idx 1)).val (e (idx 2)).val (e (idx 3)).val = e := by
  funext i
  fin_cases i <;> simp [ggA6F4MkE, idx, Fin.ext_iff]

private theorem ggA6F4_finite_check (e : Fin Tag.F4.rank → ZMod 7) (hne : e ≠ 0)
    (hinv : ∀ c : ZMod 7, ggA6F4Cnt e (2 * c) = ggA6F4Cnt e c) :
    ggA6F4Cnt e 0 = 6 := by
  have hE := ggA6F4MkE_val e
  have h0 : (e (idx 0)).val < 7 := ZMod.val_lt _
  have h1 : (e (idx 1)).val < 7 := ZMod.val_lt _
  have h2 : (e (idx 2)).val < 7 := ZMod.val_lt _
  have h3 : (e (idx 3)).val < 7 := ZMod.val_lt _
  have hok : ggA6F4OkE (e (idx 0)).val (e (idx 1)).val (e (idx 2)).val (e (idx 3)).val = true := by
    have h := ggA6F4_all_ok
    simp only [List.all_eq_true, List.mem_range] at h
    exact h _ h0 _ h1 _ h2 _ h3
  have hA : ((e (idx 0)).val == 0 && (e (idx 1)).val == 0 && (e (idx 2)).val == 0
      && (e (idx 3)).val == 0) = false := by
    apply Bool.eq_false_of_not_eq_true
    intro h
    simp only [Bool.and_eq_true, beq_iff_eq] at h
    apply hne
    rw [← hE, h.1.1.1, h.1.1.2, h.1.2, h.2]
    funext i
    fin_cases i <;> simp [ggA6F4MkE]
  have hB : ((List.range 7).all (fun c => ggA6F4Cnt (ggA6F4MkE (e (idx 0)).val (e (idx 1)).val
      (e (idx 2)).val (e (idx 3)).val) ((2 * (c : ZMod 7)))
      == ggA6F4Cnt (ggA6F4MkE (e (idx 0)).val (e (idx 1)).val (e (idx 2)).val (e (idx 3)).val)
        (c : ZMod 7))) = true := by
    rw [List.all_eq_true]
    intro c _
    rw [beq_iff_eq, hE]
    exact hinv (c : ZMod 7)
  rw [ggA6F4OkE, hA, hB] at hok
  rw [show (true == false) = false by decide, Bool.false_or] at hok
  rw [hE] at hok
  exact beq_iff_eq.mp hok

private theorem ggA6F4Val_add_mul (e₁ e₂ : Fin Tag.F4.rank → ZMod 7) (a b : ZMod 7)
    (γ : Fin Tag.F4.rank → ℤ) :
    ggA6F4Val (fun i => a * e₁ i + b * e₂ i) γ
      = a * ggA6F4Val e₁ γ + b * ggA6F4Val e₂ γ := by
  simp only [ggA6F4Val]
  have h : ∀ i, (a * e₁ i + b * e₂ i) * ((γ i : ℤ) : ZMod 7)
      = a * (e₁ i * ((γ i : ℤ) : ZMod 7)) + b * (e₂ i * ((γ i : ℤ) : ZMod 7)) :=
    fun i => by ring
  simp_rw [h, Finset.sum_add_distrib, Finset.mul_sum]

private theorem ggA6F4Cnt_eq_ncard
    (e : Fin Tag.F4.rank → ZMod 7) (c : ZMod 7) :
    ggA6F4Cnt e c = {γ | IsRoot Tag.F4 γ ∧ ggA6F4Val e γ = c}.ncard :=
  (ncard_roots_filter (fun γ => ggA6F4Val e γ = c)).symm

private theorem ggA6F4Cnt_eq_filter
    (e : Fin Tag.F4.rank → ZMod 7) (c : ZMod 7) :
    ggA6F4Cnt e c = (ggA6F4R.filter (fun γ => ggA6F4Val e γ = c)).card := by
  rw [ggA6F4Cnt_eq_ncard]
  unfold ggA6F4R
  rw [← Set.ncard_coe_finset]
  congr 1
  ext γ
  simp only [Set.mem_setOf_eq, Finset.mem_coe, Finset.mem_filter, List.mem_toFinset, List.mem_map]
  constructor
  · rintro ⟨hγ, hv⟩
    obtain ⟨l, hl, rfl⟩ := (mem_rts_iff γ).1 hγ
    exact ⟨⟨l, hl, rfl⟩, hv⟩
  · rintro ⟨⟨l, hl, rfl⟩, hv⟩
    exact ⟨(mem_rts_iff _).2 ⟨l, hl, rfl⟩, hv⟩

private theorem ggA6F4_scale_le {e : Fin Tag.F4.rank → ZMod 7}
    (ρ : Equiv.Perm (Fin Tag.F4.rank → ℤ))
    (hroot : ∀ γ, IsRoot Tag.F4 (ρ γ) ↔ IsRoot Tag.F4 γ)
    (hscale : ∀ γ, IsRoot Tag.F4 γ → ggA6F4Val e (ρ γ) = 2 * ggA6F4Val e γ)
    (c : ZMod 7) :
    ggA6F4Cnt e c ≤ ggA6F4Cnt e (2 * c) := by
  rw [ggA6F4Cnt_eq_filter, ggA6F4Cnt_eq_filter]
  refine Finset.card_le_card_of_injOn (fun γ => ρ γ) ?_ ?_
  · intro γ hγ
    rw [Finset.mem_coe, Finset.mem_filter] at hγ ⊢
    have hγroot : IsRoot Tag.F4 γ := by
      unfold ggA6F4R at hγ
      rw [List.mem_toFinset, List.mem_map] at hγ
      obtain ⟨l, hl, hlγ⟩ := hγ.1
      exact (mem_rts_iff γ).2 ⟨l, hl, hlγ⟩
    have hρR : IsRoot Tag.F4 (ρ γ) := (hroot γ).2 hγroot
    refine ⟨?_, ?_⟩
    · unfold ggA6F4R
      rw [List.mem_toFinset, List.mem_map]
      exact (mem_rts_iff (ρ γ)).1 hρR
    · rw [hscale γ hγroot, hγ.2]
  · intro a _ b _ hab
    exact ρ.injective hab

private theorem ggA6F4_scale_eq {e : Fin Tag.F4.rank → ZMod 7}
    (ρ : Equiv.Perm (Fin Tag.F4.rank → ℤ))
    (hroot : ∀ γ, IsRoot Tag.F4 (ρ γ) ↔ IsRoot Tag.F4 γ)
    (hscale : ∀ γ, IsRoot Tag.F4 γ → ggA6F4Val e (ρ γ) = 2 * ggA6F4Val e γ)
    (c : ZMod 7) :
    ggA6F4Cnt e (2 * c) = ggA6F4Cnt e c := by
  refine le_antisymm ?_ (ggA6F4_scale_le ρ hroot hscale c)
  have h2 := ggA6F4_scale_le ρ hroot hscale (2 * c)
  have h4 : (2 : ZMod 7) * (2 * c) = 4 * c := by ring
  rw [h4] at h2
  have h3 := ggA6F4_scale_le ρ hroot hscale (4 * c)
  have h8 : (2 : ZMod 7) * (4 * c) = c := by
    rw [← mul_assoc, show (2 : ZMod 7) * 4 = 1 by decide, one_mul]
  rw [h8] at h3
  exact le_trans h2 h3

private theorem ggA6F4_lin_count (x y : ZMod 7) :
    ((Finset.univ : Finset (ZMod 7 × ZMod 7)).filter
      (fun p => p ≠ 0 ∧ p.1 * x + p.2 * y = 0)).card =
    if x = 0 ∧ y = 0 then 48 else 6 := by
  fin_cases x <;> fin_cases y <;> decide +kernel

private theorem ggA6F4R_card : ggA6F4R.card = 48 := by
  unfold ggA6F4R
  rw [List.toFinset_card_of_nodup, List.length_map]
  · rfl
  · exact List.Nodup.map_on (fun x hx y hy hxy => vec4_injOn x hx y hy hxy)
      (nodup_artifactRoots Tag.F4)

private theorem ggA6F4Ps_card : ggA6F4Ps.card = 48 := by
  decide +kernel

theorem ggA6F4_killed_root
    (e₁ e₂ : Fin Tag.F4.rank → ZMod 7)
    (hind : ∀ a b : ZMod 7, (a ≠ 0 ∨ b ≠ 0) → ∃ i, a * e₁ i + b * e₂ i ≠ 0)
    (ρ : Equiv.Perm (Fin Tag.F4.rank → ℤ)) (hroot : ∀ γ, IsRoot Tag.F4 (ρ γ) ↔ IsRoot Tag.F4 γ)
    (h₁ : ∀ γ, IsRoot Tag.F4 γ → ggA6F4Val e₁ (ρ γ) = 2 * ggA6F4Val e₁ γ)
    (h₂ : ∀ γ, IsRoot Tag.F4 γ → ggA6F4Val e₂ (ρ γ) = 2 * ggA6F4Val e₂ γ) :
    ∀ γ, IsRoot Tag.F4 γ → ¬ (ggA6F4Val e₁ γ = 0 ∧ ggA6F4Val e₂ γ = 0) := by
  intro γ₀ hγ₀ hkill
  have hscale : ∀ (a b : ZMod 7) (γ : Fin Tag.F4.rank → ℤ), IsRoot Tag.F4 γ →
      ggA6F4Val (fun i => a * e₁ i + b * e₂ i) (ρ γ)
        = 2 * ggA6F4Val (fun i => a * e₁ i + b * e₂ i) γ := by
    intro a b γ hγ
    rw [ggA6F4Val_add_mul, ggA6F4Val_add_mul, h₁ γ hγ, h₂ γ hγ]
    ring
  let s : ℕ := (ggA6F4R.filter
    (fun γ => ggA6F4Val e₁ γ = 0 ∧ ggA6F4Val e₂ γ = 0)).card
  have hleft : ∑ p ∈ ggA6F4Ps, ggA6F4Cnt (fun i => p.1 * e₁ i + p.2 * e₂ i) 0 = 288 := by
    have h6 : ∀ p ∈ ggA6F4Ps, ggA6F4Cnt (fun i => p.1 * e₁ i + p.2 * e₂ i) 0 = 6 := by
      intro p hp
      have hpne : p ≠ 0 := (Finset.mem_filter.1 hp).2
      have hpq : p.1 ≠ 0 ∨ p.2 ≠ 0 := by
        by_contra h
        rw [not_or] at h
        exact hpne (Prod.ext (by simpa using h.1) (by simpa using h.2))
      obtain ⟨i, hi⟩ := hind p.1 p.2 hpq
      have hne : (fun i => p.1 * e₁ i + p.2 * e₂ i) ≠ 0 := by
        intro h
        exact hi (by simpa using congrFun h i)
      refine ggA6F4_finite_check _ hne ?_
      intro c
      exact ggA6F4_scale_eq ρ hroot (hscale p.1 p.2) c
    calc ∑ p ∈ ggA6F4Ps, ggA6F4Cnt (fun i => p.1 * e₁ i + p.2 * e₂ i) 0
        = ∑ _p ∈ ggA6F4Ps, (6 : ℕ) := Finset.sum_congr rfl h6
      _ = ggA6F4Ps.card * 6 := by simp [Finset.sum_const, nsmul_eq_mul]
      _ = 288 := by rw [ggA6F4Ps_card]
  have hright : ∑ p ∈ ggA6F4Ps, ggA6F4Cnt (fun i => p.1 * e₁ i + p.2 * e₂ i) 0 = 288 + 42 * s := by
    calc ∑ p ∈ ggA6F4Ps, ggA6F4Cnt (fun i => p.1 * e₁ i + p.2 * e₂ i) 0
        = ∑ p ∈ ggA6F4Ps, ∑ γ ∈ ggA6F4R,
            (if ggA6F4Val (fun i => p.1 * e₁ i + p.2 * e₂ i) γ = 0 then 1 else 0) := by
          refine Finset.sum_congr rfl (fun p _ => ?_)
          rw [ggA6F4Cnt_eq_filter, Finset.card_filter]
      _ = ∑ γ ∈ ggA6F4R, ∑ p ∈ ggA6F4Ps,
            (if ggA6F4Val (fun i => p.1 * e₁ i + p.2 * e₂ i) γ = 0 then 1 else 0) := by
          rw [Finset.sum_comm]
      _ = ∑ γ ∈ ggA6F4R,
            (if ggA6F4Val e₁ γ = 0 ∧ ggA6F4Val e₂ γ = 0 then 48 else 6) := by
