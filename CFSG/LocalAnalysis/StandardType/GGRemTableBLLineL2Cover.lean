open CFSG.Assembly CorFourTwoOpen

@[expose] def GGLinTwoLabel (p : ℕ) (lab : LargeEvenLabel) : Prop :=
  lab.tag = .A ∧ 5 ≤ lab.rank ∧ lab.n = 1 ∧ p = 3

theorem largeEvenLabelAll_linTwo_line {p : ℕ} {lab : LargeEvenLabel}
    (h : GGLinTwoLabel p lab) :
    LargeEvenLabelAll lab fun R _ I _ => GGCenterCoprime p R ∧ GGNoInvariantLineSC p R I := by
  obtain ⟨t, l, n⟩ := lab
  obtain ⟨ht, hl, hn, hp⟩ := h
  dsimp only at ht hl hn hp
  subst ht hn hp
  intro Q hQ
  dsimp only [LargeEvenRawDatum] at hQ ⊢
  obtain ⟨K, _, _, hK, hQ'⟩ := hQ
  have hK2 : Nat.card K = 2 := by simpa using hK
  exact ⟨K, inferInstance, inferInstance, hK, hQ', LineL2.ggCenterCoprime_recipe_two hK2 (by omega),
    LineL2.ggNoInvariantLineSC_recipe_two hK2⟩

theorem ggLNoInvariantLineInputOn_linTwo_holds : GGLNoInvariantLineInputOn GGLinTwoLabel :=
  ggLNoInvariantLineInputOn_of_labelsSC fun _ _ _ _ h => largeEvenLabelAll_linTwo_line h

end CFSG.StandardType

