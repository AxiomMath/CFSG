namespace CFSG.StandardType.TableCRes

open CFSG.Assembly CFSG.Blueprint CFSG.Assembly.LowTwoRank CFSG.StandardType

theorem false_of_fieldExt_of_model_PSU
    {X : Type} [Group X] {J : Subgroup X} {g r : ℕ} (hr : 3 ≤ r)
    (hmodel : CFSG.Blueprint.LieModel (↥J ⧸ Subgroup.center ↥J) .PSU r 2 (g + 1))
    (hF : GGSixLSevenFieldExtCase J .PSU (g + 1)) : False := by
  obtain ⟨t', m', f', hlt, hmod', -⟩ := hF
  have hdet : CFSG.SeitzReduction.UnitaryPilot.SUmEvenTypeDetAt r := by
    rcases Nat.lt_or_ge r 4 with h | h
    · obtain rfl : r = 3 := by omega
      exact CFSG.LocalAnalysis.EvenBN.GMSK.su3EvenTypeDet
    · exact CFSG.SeitzReduction.UnitaryPilot.sumEvenTypeDetAt h
  have := hdet (↥J ⧸ Subgroup.center ↥J) (g + 1) t' m' f' hmodel hmod'.admissible hmod'
  omega

end CFSG.StandardType.TableCRes
