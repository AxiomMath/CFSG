private theorem n1b_data_keys :
    (n1b_rootWordData.map (fun p => n1b_vecKey (n1b_rootOfWord p).1)) = n1b_keyList := by
  decide +kernel

private theorem n1b_simple_keys :
    ∀ j : Fin Tag.E6.rank, n1b_vecKey (Pi.single j 1) ∈ n1b_keyList := by
  decide +kernel

private theorem n1b_simple_mem (j : Fin Tag.E6.rank) :
    (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ e6RootList := by
  obtain ⟨β, hβ, hβk⟩ := List.mem_map.mp (n1b_simple_keys j)
  have h : β = Pi.single j 1 := n1b_vecKey_injective hβk
  rw [← h]
  exact hβ

private theorem n1b_closed_keys :
    ∀ v ∈ e6RootList, ∀ i : Fin Tag.E6.rank,
      n1b_vecKey (reflect Tag.E6 i v) ∈ n1b_keyList := by
  decide +kernel

private theorem n1b_closed (v : Fin Tag.E6.rank → ℤ) (hv : v ∈ e6RootList)
    (i : Fin Tag.E6.rank) : reflect Tag.E6 i v ∈ e6RootList := by
  obtain ⟨β, hβ, hβk⟩ := List.mem_map.mp (n1b_closed_keys v hv i)
  have h : β = reflect Tag.E6 i v := n1b_vecKey_injective hβk
  rw [← h]
  exact hβ

private theorem n1b_mem_to_isRoot (α : Fin Tag.E6.rank → ℤ) (hα : α ∈ e6RootList) :
    IsRoot Tag.E6 α := by
  have hk : n1b_vecKey α ∈ n1b_keyList := List.mem_map.mpr ⟨α, hα, rfl⟩
  rw [← n1b_data_keys] at hk
  obtain ⟨p, _, hpk⟩ := List.mem_map.mp hk
  have h : (n1b_rootOfWord p).1 = α := n1b_vecKey_injective hpk
  rw [← h]
  exact (n1b_rootOfWord p).2

theorem isRoot_iff_mem_e6RootList (α : Fin Tag.E6.rank → ℤ) :
    IsRoot Tag.E6 α ↔ α ∈ e6RootList := by
  constructor
  · intro h
    induction h with
    | basis j => exact n1b_simple_mem j
    | reflect i _ ih => exact n1b_closed _ ih i
  · exact n1b_mem_to_isRoot α

private def n1b_x3KeyNat (x : X3) : ℕ :=
  Nat.ofDigits 3 ((List.ofFn x).map (fun c => c.val))

private theorem n1b_x3KeyNat_injective : Function.Injective n1b_x3KeyNat := by
  intro x y h
  have hlen : ((List.ofFn x).map (fun c : ZMod 3 => c.val)).length =
      ((List.ofFn y).map (fun c : ZMod 3 => c.val)).length := by simp
  have hx : ∀ l ∈ (List.ofFn x).map (fun c : ZMod 3 => c.val), l < 3 := by
    intro l hl
    obtain ⟨c, _, rfl⟩ := List.mem_map.mp hl
    exact ZMod.val_lt c
  have hy : ∀ l ∈ (List.ofFn y).map (fun c : ZMod 3 => c.val), l < 3 := by
    intro l hl
    obtain ⟨c, _, rfl⟩ := List.mem_map.mp hl
    exact ZMod.val_lt c
  have hmap : (List.ofFn x).map (fun c : ZMod 3 => c.val) =
      (List.ofFn y).map (fun c : ZMod 3 => c.val) :=
    Nat.ofDigits_inj_of_len_eq (by norm_num : 1 < 3) hlen hx hy h
  have hof : List.ofFn x = List.ofFn y :=
    (List.map_injective_iff.mpr (ZMod.val_injective 3)) hmap
  exact List.ofFn_inj.mp hof

private theorem n1b_mem_map_key_iff {L : List X3} {y : X3} :
    n1b_x3KeyNat y ∈ L.map n1b_x3KeyNat ↔ y ∈ L := by
  constructor
  · intro h
    obtain ⟨z, hz, hzy⟩ := List.mem_map.mp h
    rw [n1b_x3KeyNat_injective hzy] at hz
    exact hz
  · intro h
    exact List.mem_map.mpr ⟨y, h, rfl⟩

