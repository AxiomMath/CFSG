private theorem n1b_cover_spec :
    ∀ p ∈ n1b_cover, applyWord p.2.1 p.1 = reps p.2.2 := by
  decide +kernel

private theorem n1b_cover_all_keys :
    ∀ x : X3, x ≠ 0 → n1b_x3KeyNat x ∈ (n1b_cover.map (fun p => p.1)).map n1b_x3KeyNat := by
  decide +kernel

private theorem n1b_cover_all :
    ∀ x : X3, x ≠ 0 → x ∈ n1b_cover.map (fun p => p.1) :=
  fun x hx => n1b_mem_map_key_iff.mp (n1b_cover_all_keys x hx)

theorem exists_word_to_rep (x : X3) (hx : x ≠ 0) :
    ∃ (k : Fin 7) (l : List (Fin Tag.E6.rank)), applyWord l x = reps k := by
  obtain ⟨p, hp, hp1⟩ := List.mem_map.mp (n1b_cover_all x hx)
  refine ⟨p.2.2, p.2.1, ?_⟩
  rw [← hp1]
  exact n1b_cover_spec p hp

