private theorem n1b_orbData_reach (k : Fin 7) :
    ∀ p ∈ n1b_orbData k, applyWord p.2 (reps k) = p.1 := by
  fin_cases k <;> decide +kernel

private theorem n1b_orb_mem_rep_keys (k : Fin 7) :
    n1b_x3KeyNat (reps k) ∈ ((n1b_orbData k).map (fun p => p.1)).map n1b_x3KeyNat := by
  fin_cases k <;> decide +kernel

private theorem n1b_orb_mem_rep (k : Fin 7) :
    reps k ∈ (n1b_orbData k).map (fun p => p.1) :=
  n1b_mem_map_key_iff.mp (n1b_orb_mem_rep_keys k)

private theorem n1b_orb_closed_keys (k : Fin 7) :
    ∀ p ∈ n1b_orbData k, ∀ i : Fin Tag.E6.rank,
      n1b_x3KeyNat (dualRefl i p.1) ∈
        ((n1b_orbData k).map (fun p => p.1)).map n1b_x3KeyNat := by
  fin_cases k <;> decide +kernel

private theorem n1b_orb_closed (k : Fin 7) :
    ∀ y ∈ (n1b_orbData k).map (fun p => p.1), ∀ i : Fin Tag.E6.rank,
      dualRefl i y ∈ (n1b_orbData k).map (fun p => p.1) := by
  intro y hy i
  obtain ⟨p, hp, hpy⟩ := List.mem_map.mp hy
  rw [← hpy]
  exact n1b_mem_map_key_iff.mp (n1b_orb_closed_keys k p hp i)

private theorem n1b_orb_nodup (k : Fin 7) :
    ((n1b_orbData k).map (fun p => p.1)).Nodup := by
  fin_cases k <;> exact CFSG.Decide.nodup_of_bitsetNodup n1b_x3KeyNat (by decide +kernel)

private theorem n1b_orb_len (k : Fin 7) :
    ((n1b_orbData k).map (fun p => p.1)).length = repOrbitSize k := by
  fin_cases k <;> decide +kernel

theorem ncard_wordOrbit_rep (k : Fin 7) :
    {y : X3 | ∃ l : List (Fin Tag.E6.rank), applyWord l (reps k) = y}.ncard = repOrbitSize k := by
  have hset : {y : X3 | ∃ l : List (Fin Tag.E6.rank), applyWord l (reps k) = y}
      = ↑((n1b_orbData k).map (fun p => p.1)).toFinset := by
    ext y
    simp only [Set.mem_setOf_eq, Finset.mem_coe, List.mem_toFinset]
    constructor
    · rintro ⟨l, rfl⟩
      induction l with
      | nil => simpa [applyWord] using n1b_orb_mem_rep k
      | cons i l ih =>
          simpa only [applyWord, List.foldr_cons] using
            n1b_orb_closed k (applyWord l (reps k)) ih i
    · intro hy
      obtain ⟨p, hp, hpy⟩ := List.mem_map.mp hy
      exact ⟨p.2, by rw [n1b_orbData_reach k p hp, hpy]⟩
  rw [hset, Set.ncard_coe_finset, List.toFinset_card_of_nodup (n1b_orb_nodup k)]
  exact n1b_orb_len k

