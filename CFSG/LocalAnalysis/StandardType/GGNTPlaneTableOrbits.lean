private def n1b_rootOfWord (p : Fin 6 × List (Fin 6)) :
    {v : Fin Tag.E6.rank → ℤ // IsRoot Tag.E6 v} :=
  p.2.foldl (fun acc i => ⟨reflect Tag.E6 i acc.1, IsRoot.reflect i acc.2⟩)
    (⟨Pi.single p.1 1, IsRoot.basis (τ := Tag.E6) p.1⟩ :
      {v : Fin Tag.E6.rank → ℤ // IsRoot Tag.E6 v})

private def n1b_vecKey (v : Fin Tag.E6.rank → ℤ) : List ℤ := List.ofFn v

private theorem n1b_vecKey_injective : Function.Injective n1b_vecKey :=
  List.ofFn_injective

private def n1b_keyList : List (List ℤ) := e6RootList.map n1b_vecKey

