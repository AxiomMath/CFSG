private theorem exists_conj_factor {G : Type*} [Group G] {ι : Type*} (A : ι → Subgroup G)
    (hc : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ A j, a * b = b * a) (i₀ : ι) {g : G}
    (hg : g ∈ ⨆ i, A i) : ∃ a ∈ A i₀, ∀ y ∈ A i₀, g * y * g⁻¹ = a * y * a⁻¹ := by
  refine Subgroup.iSup_induction A
    (C := fun g => ∃ a ∈ A i₀, ∀ y ∈ A i₀, g * y * g⁻¹ = a * y * a⁻¹) hg ?_ ?_ ?_
  · intro i g hg
    by_cases hi : i = i₀
    · subst hi
      exact ⟨g, hg, fun y _ => rfl⟩
    · refine ⟨1, (A i₀).one_mem, fun y hy => ?_⟩
      rw [hc i i₀ hi g hg y hy]
      group
  · exact ⟨1, (A i₀).one_mem, fun y _ => by simp⟩
  · rintro u v ⟨a, ha, hu⟩ ⟨b, hb, hv⟩
    refine ⟨a * b, (A i₀).mul_mem ha hb, fun y hy => ?_⟩
    have e : u * v * y * (u * v)⁻¹ = u * (v * y * v⁻¹) * u⁻¹ := by group
    rw [e, hv y hy, hu _ ((A i₀).mul_mem ((A i₀).mul_mem hb hy) ((A i₀).inv_mem hb))]
    group

theorem ggInnerOn_orth_fixedFactor {K V : Type} [Field K] [Finite K] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V} {g : ℕ}
    (hK : Nat.card K = 2 ^ g) {x : V ≃ₗ[K] V} (hx : OddOrderIsometry Q 3 x)
    (hlist : FixedLayerListed Q x)
    {F : Subgroup (V ≃ₗ[K] V)} (hFq : CFSG.IsQuasisimple ↥F)
    (hFle : F ≤ supportedFixedDerived Q x)
    (hFn : (F.subgroupOf (supportedFixedDerived Q x)).Normal)
    {y : ↥(orthDerived Q)} (hy : (y : V ≃ₗ[K] V) ∈ isometryCentralizer Q x) (hy3 : y ^ 3 = 1) :
    GGInnerOn ((F.subgroupOf (orthDerived Q)).map
        (QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q))))
      (MulAut.conj (QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)) y)) := by
  classical
  have : Finite V := Module.finite_of_finite K
  have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := g)
    (by rw [Fintype.card_eq_nat_card, hK])
  set ρ : ↥(orthDerived Q) →* ProjOrthDerived Q :=
    QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)) with hρ
  set P : Subgroup (V ≃ₗ[K] V) := supportedFixedDerived Q x with hP
  have hPle : P ≤ orthDerived Q := hx.supportedFixedDerived_le_orthDerived
  have hy3V : (y : V ≃ₗ[K] V) ^ 3 = 1 := by
    have := congrArg (fun e : ↥(orthDerived Q) => (e : V ≃ₗ[K] V)) hy3
    simpa using this
  have hX1 : (X - 1 : K[X]) ∈ primaryFactors x.toLinearMap :=
    X_sub_one_mem_of_fixed (by have := hlist.1; omega)
  set yW : V ≃ₗ[K] V := (CFSG.RankThree.PartOne.KCOrthogonal.blockComponent hx
    ⟨(y : V ≃ₗ[K] V), (Subgroup.mem_inf.mp hy).2⟩ (X - 1)).1 with hyW
  have hyWblock : yW ∈ supportedBlock Q x (X - 1) := hx.blockComponent_mem hy hX1
  have hyW3 : yW ^ 3 = 1 := blockComponent_fixed_pow_three hx hy hy3V
  have hQW := hx.polarBilin_fixed_nondegenerate
  have hyWP : yW ∈ P := by
    refine mem_supportedFixedDerived.mpr ⟨hyWblock, ?_⟩
    have hu3 : restrictFixed Q x ⟨yW, hyWblock⟩ ^ 3 = 1 := by
      rw [← map_pow]
      have : (⟨yW, hyWblock⟩ : ↥(supportedBlock Q x (X - 1))) ^ 3 = 1 := Subtype.ext hyW3
      rw [this, map_one]
    exact omegaGroup_le_orthDerived_of_listed (Q.comp (fixedSpace x).subtype) hQW hlist.1
      hlist.2 (CFSG.RankThree.PartOne.mem_omegaGroup_of_pow_eq_one hQW (by decide)
        (restrictFixed_mem_orthogonalGroup ⟨yW, hyWblock⟩) hu3)
  obtain ⟨n, Fam, hFamq, hFamcomm, hFamsup, -⟩ := exists_fixedFactors_comm hx
  have hFamsup' : (⨆ i, Fam i) = P := hFamsup hlist
  have hPP : (P.subgroupOf P).Normal := by
    rw [Subgroup.subgroupOf_self]
    exact Subgroup.normal_top
  have hFamcomp : ∀ i, CFSG.Open.IsComponentOf (Fam i) P := fun i =>
    CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.isComponentOf_of_normal_normal
      (hFamq i).2.1 le_rfl (hFamq i).2.2 hPP (hFamq i).1
  have hFcomp : CFSG.Open.IsComponentOf F P :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.isComponentOf_of_normal_normal
      hFle le_rfl hFn hPP hFq
  obtain ⟨i, hi⟩ := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.component_mem_named_factors
    Fam hFamcomp (fun P' hP' _ => hFamsup' ▸ hP') hFcomp
  obtain ⟨a, haFam, hconj⟩ := exists_conj_factor Fam hFamcomm i
    (by rw [hFamsup']; exact hyWP)
  have haF : a ∈ F := hi ▸ haFam
  have haΩ : a ∈ orthDerived Q := hPle (hFle haF)
  refine ⟨ρ ⟨a, haΩ⟩, Subgroup.mem_map_of_mem ρ (Subgroup.mem_subgroupOf.mpr haF), ?_⟩
  rintro _ ⟨b, hb, rfl⟩
  have hbF : (b : V ≃ₗ[K] V) ∈ F := Subgroup.mem_subgroupOf.mp hb
  have hbSB : (b : V ≃ₗ[K] V) ∈ supportedBlock Q x (X - 1) :=
    supportedFixedDerived_le_supportedBlock (hFle hbF)
  have h1 : (y : V ≃ₗ[K] V) * b * (y : V ≃ₗ[K] V)⁻¹ = a * b * a⁻¹ := by
    rw [blockComponent_fixed_conj_eq hx hy hbSB]
    exact hconj b (hi ▸ hbF)
  have h2 : y * b * y⁻¹ = (⟨a, haΩ⟩ : ↥(orthDerived Q)) * b * (⟨a, haΩ⟩ : ↥(orthDerived Q))⁻¹ :=
    Subtype.ext (by simpa using h1)
  rw [MulAut.conj_apply]
  simp only [← map_mul, ← map_inv]
  rw [h2]

