theorem kgMult_SL4 (K : Type) [Field K] [Finite K] (h4 : 4 ≤ Nat.card K)
    (N : Type) [Group N] [Finite N] (π : N →* Matrix.SpecialLinearGroup (Fin 4) K)
    (hπ : Function.Surjective π) (hker : π.ker ≤ Subgroup.center N) (hperf : commutator N = ⊤) :
    IsCyclic (Subgroup.center N) := by
  have hP : Group.IsPerfect N := ⟨hperf⟩
  obtain ⟨s, hs⟩ : ∃ s : Matrix.SpecialLinearGroup (Fin 4) K →* N, ∀ g, π (s g) = g := by
    rcases Nat.lt_or_ge (Nat.card K) 5 with h | h
    · exact CFSG.SeitzReduction.LinearPilot.exists_section_specialLinear_four_of_card_four
        (by omega) hπ hker
    · exact CFSG.SeitzReduction.LinearPilot.exists_section_specialLinear (by norm_num) h hπ hker
  have hbot : π.ker = ⊥ :=
    CFSG.LieType.Steinberg.CentralExt.SL2Closed.ker_eq_bot_of_section π hker s hs
  have hinj : Function.Injective π := (MonoidHom.ker_eq_bot_iff π).mp hbot
  have hcen : ∀ z : Subgroup.center N,
      π z ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin 4) K) := by
    intro z
    rw [Subgroup.mem_center_iff]
    intro g
    obtain ⟨n, rfl⟩ := hπ g
    rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp z.2 n]
  haveI : IsCyclic (Subgroup.center (Matrix.SpecialLinearGroup (Fin 4) K)) :=
    (MulEquiv.isCyclic (Matrix.SpecialLinearGroup.center_equiv_rootsOfUnity (n := Fin 4)
      (R := K))).mpr inferInstance
  exact isCyclic_of_injective
    (((π.comp (Subgroup.center N).subtype).codRestrict
      (Subgroup.center (Matrix.SpecialLinearGroup (Fin 4) K)) hcen))
    (fun x y hxy => Subtype.ext (hinj (congrArg Subtype.val hxy)))

private theorem stdPair_perp_finite (m : Fin 72) :
    (iform (CFSG.RankThree.E6.e6RootVec m) (highRoot Tag.E6) = 0 ∧
      iform (CFSG.RankThree.E6.e6RootVec m) (Pi.single 5 1 : Fin Tag.E6.rank → ℤ) = 0)
      ↔ (CFSG.RankThree.E6.e6RootVec m 1 = 0 ∧ CFSG.RankThree.E6.e6RootVec m 4 = 0 ∧
          CFSG.RankThree.E6.e6RootVec m 5 = 0) := by
  decide +kernel +revert

private theorem perp_cond_iff (v : Fin Tag.E6.rank → ℤ) :
    (∀ i : Fin Tag.E6.rank, i ∉ CFSG.RankThree.E6.support134 → v i = 0) ↔
      (v 1 = 0 ∧ v 4 = 0 ∧ v 5 = 0) := by
  constructor
  · intro h
    exact ⟨h 1 (by rw [CFSG.RankThree.E6.mem_support134]; decide),
      h 4 (by rw [CFSG.RankThree.E6.mem_support134]; decide),
      h 5 (by rw [CFSG.RankThree.E6.mem_support134]; decide)⟩
  · rintro ⟨h1, h4, h5⟩ i hi
    fin_cases i
    · exact absurd ((CFSG.RankThree.E6.mem_support134 0).2 (Or.inl rfl)) hi
    · exact h1
    · exact absurd ((CFSG.RankThree.E6.mem_support134 2).2 (Or.inr (Or.inl rfl))) hi
    · exact absurd ((CFSG.RankThree.E6.mem_support134 3).2 (Or.inr (Or.inr rfl))) hi
    · exact h4
    · exact h5


theorem stdPair_perp_eq_parabolicRoots :
    {γ | IsRoot Tag.E6 γ ∧ iform γ (highRoot Tag.E6) = 0 ∧
        iform γ (Pi.single 5 1 : Fin Tag.E6.rank → ℤ) = 0} =
      parabolicRoots Tag.E6 CFSG.RankThree.E6.support134 := by
  ext γ
  simp only [Set.mem_setOf_eq, parabolicRoots]
  constructor
  · rintro ⟨hγ, h1, h2⟩
    obtain ⟨m, rfl⟩ := CFSG.RankThree.E6.isRoot_iff_exists_e6RootVec.1 hγ
    exact ⟨CFSG.RankThree.E6.isRoot_e6RootVec m,
      (perp_cond_iff _).2 ((stdPair_perp_finite m).1 ⟨h1, h2⟩)⟩
  · rintro ⟨hγ, h0⟩
    obtain ⟨m, rfl⟩ := CFSG.RankThree.E6.isRoot_iff_exists_e6RootVec.1 hγ
    exact ⟨CFSG.RankThree.E6.isRoot_e6RootVec m,
      (stdPair_perp_finite m).2 ((perp_cond_iff _).1 h0)⟩


theorem exists_weyl_sigmaSetE6A3_eq {α β : Fin Tag.E6.rank → ℤ} (hα : IsRoot Tag.E6 α)
    (hβ : IsRoot Tag.E6 β) (hαβ : iform α β = 0) :
    ∃ v : WeylGroup Tag.E6, sigmaSetE6A3 v =
      {γ | IsRoot Tag.E6 γ ∧ iform γ α = 0 ∧ iform γ β = 0} := by
  obtain ⟨w, hwα, hwβ⟩ := exists_weyl_smul_orthPair hα hβ hαβ
  refine ⟨w, ?_⟩
  rw [sigmaSetE6A3, ← stdPair_perp_eq_parabolicRoots]
  ext γ
  constructor
  · rintro ⟨δ, ⟨hδ, hθ, h5⟩, rfl⟩
    exact ⟨IsRoot.smul hδ w, by rw [← hwα, iform_smul, hθ],
      by rw [← hwβ, iform_smul, h5]⟩
  · rintro ⟨hγ, h1, h2⟩
    refine ⟨w⁻¹ • γ, ⟨IsRoot.smul hγ w⁻¹, ?_, ?_⟩, smul_inv_smul w γ⟩
    · have hθα : w⁻¹ • α = highRoot Tag.E6 := by rw [← hwα, inv_smul_smul]
      have e : iform (w⁻¹ • γ) (highRoot Tag.E6) = iform γ α := by
        rw [← hθα, iform_smul]
      rw [e]; exact h1
    · have hβe : w⁻¹ • β = (Pi.single 5 1 : Fin Tag.E6.rank → ℤ) := by
        rw [← hwβ, inv_smul_smul]
      have e : iform (w⁻¹ • γ) (Pi.single 5 1 : Fin Tag.E6.rank → ℤ) = iform γ β := by
        rw [← hβe, iform_smul]
      rw [e]; exact h2

theorem kgAdjM : KGAdjM := by
  intro K _ _ _ ζ hζ hζo α β hα hβ hαβ N _ _ π hπ hker hperf
  obtain ⟨v, hvS⟩ := exists_weyl_sigmaSetE6A3_eq hα hβ hαβ
  have hfam : famKernel {zetaVec ζ hζ (kgExpVec α), zetaVec ζ hζ (kgExpVec β)} =
      {γ | IsRoot Tag.E6 γ ∧ iform γ α = 0 ∧ iform γ β = 0} :=
    famKernel_kgExpVec_pair hζo hζ hα hβ
  have hspan : rootSpan Tag.E6 K
      (famKernel {zetaVec ζ hζ (kgExpVec α), zetaVec ζ hζ (kgExpVec β)}) =
      (rhoSigmaE6A3 K v).range := by
    rw [hfam, ← hvS, ← rhoSigmaE6A3_range]
  let e : Matrix.SpecialLinearGroup (Fin 4) K ≃*
      ↥(rootSpan Tag.E6 K
        (famKernel {zetaVec ζ hζ (kgExpVec α), zetaVec ζ hζ (kgExpVec β)})) :=
    (MonoidHom.ofInjective (f := rhoSigmaE6A3 K v) (rhoSigmaE6A3_injective v)).trans
      (MulEquiv.subgroupCongr hspan.symm)
  have h4 : 4 ≤ Nat.card K := by
    have hcard : Nat.card K = Nat.card Kˣ + 1 := Nat.card_eq_card_units_add_one K
    have h3 : 3 ∣ Nat.card Kˣ := by simpa [hζo] using orderOf_dvd_natCard ζ
    have hle : 3 ≤ Nat.card Kˣ := Nat.le_of_dvd Nat.card_pos h3
    omega
  have hsurj : Function.Surjective (e.symm.toMonoidHom.comp π) := by
    intro y
    obtain ⟨n, hn⟩ := hπ (e y)
    exact ⟨n, by rw [MonoidHom.comp_apply, hn]; simpa using e.symm_apply_apply y⟩
  have hker' : (e.symm.toMonoidHom.comp π).ker ≤ Subgroup.center N := by
    rw [MonoidHom.ker_comp_of_injective π e.symm.toMonoidHom e.symm.injective]
    exact hker
  exact kgMult_SL4 K h4 N (e.symm.toMonoidHom.comp π) hsurj hker' hperf

