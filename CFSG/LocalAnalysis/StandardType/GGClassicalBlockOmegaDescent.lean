private lemma ggOmW3_sigma_sq_one {K : Type} [Field K] (σ : K ≃+* K)
    (hσ2 : ∀ x, σ (σ x) = x) : σ ^ 2 = 1 := by
  ext x
  rw [pow_two]
  exact hσ2 x

private lemma ggOmW3_orderOf_sigma {K : Type} [Field K] (σ : K ≃+* K)
    (hσ : σ ≠ RingEquiv.refl K) (hσ2 : ∀ x, σ (σ x) = x) : orderOf σ = 2 := by
  exact orderOf_eq_prime (ggOmW3_sigma_sq_one σ hσ2) hσ

private lemma ggOmW3_coe_map {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (a : GL ι K) :
    ((a.map σ.toRingHom : GL ι K) : Matrix ι ι K) = (a : Matrix ι ι K).map σ := by
  rfl

private theorem ggOmW3_hilbert90 {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (hσ : σ ≠ RingEquiv.refl K) (hσ2 : ∀ x, σ (σ x) = x) (A : GL ι K)
    (hA : A * A.map σ.toRingHom = 1) :
    ∃ P : GL ι K, A = P⁻¹ * P.map σ.toRingHom := by
  have hord : orderOf σ = 2 := ggOmW3_orderOf_sigma σ hσ hσ2
  have hAmat : (A : Matrix ι ι K) * ((A : Matrix ι ι K).map σ) = 1 := by
    have h := congrArg (fun x : GL ι K => (x : Matrix ι ι K)) hA
    simpa [ggOmW3_coe_map] using h
  have hAi : CFSG.HardMathSupport.Foote.ModuleExclusions.Ai σ (A : Matrix ι ι K) 2 = 1 := by
    simpa [CFSG.HardMathSupport.Foote.ModuleExclusions.Ai] using hAmat
  obtain ⟨B, hBdet, hAB⟩ :=
    CFSG.HardMathSupport.Foote.ModuleExclusions.speiser σ (A : Matrix ι ι K) 2
      hord (by norm_num) hAi
  let Bgl : GL ι K := Matrix.GeneralLinearGroup.mkOfDetNeZero B hBdet
  have hBgl : (Bgl : Matrix ι ι K) = B :=
    Matrix.GeneralLinearGroup.val_mkOfDetNeZero B hBdet
  have hABgl : A * Bgl.map σ.toRingHom = Bgl := by
    apply Units.ext
    simpa [ggOmW3_coe_map, hBgl] using hAB
  have hmap : Bgl.map σ.toRingHom = A⁻¹ * Bgl := by
    calc Bgl.map σ.toRingHom = A⁻¹ * (A * Bgl.map σ.toRingHom) := by rw [inv_mul_cancel_left]
      _ = A⁻¹ * Bgl := by rw [hABgl]
  refine ⟨Bgl⁻¹, ?_⟩
  rw [map_inv, hmap, _root_.mul_inv_rev, inv_inv]
  group

private lemma ggOmW3_charP_fixedField {K : Type} [Field K] [CharP K 2] (σ : K ≃+* K) :
    CharP ↥(fixedField K σ) 2 :=
  (RingHom.charP_iff (fixedField K σ).subtype (fixedField K σ).subtype.injective 2).mpr
    (inferInstance : CharP K 2)

private theorem ggOmW3_card_fixedField {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (hσ : σ ≠ RingEquiv.refl K) (hσ2 : ∀ x, σ (σ x) = x) :
    Nat.card K = Nat.card ↥(fixedField K σ) ^ 2 :=
  card_eq_fixedField_card_sq K σ (ggOmW3_orderOf_sigma σ hσ hσ2)

private def ggOmW3_fixedSubgroup {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) : Subgroup (GL ι K) where
  carrier := {X | X.map σ.toRingHom = X}
  one_mem' := map_one _
  mul_mem' {a b} ha hb := by
    change (a * b).map σ.toRingHom = a * b
    rw [map_mul, ha, hb]
  inv_mem' {a} ha := by
    change (a⁻¹).map σ.toRingHom = a⁻¹
    rw [map_inv, ha]

private noncomputable def ggOmW3_descendMatrix {ι K : Type}
    [Field K] (σ : K ≃+* K) (M : Matrix ι ι K) (hM : ∀ i j, σ (M i j) = M i j) :
    Matrix ι ι ↥(fixedField K σ) :=
  fun i j => ⟨M i j, (mem_fixedField_iff K σ (M i j)).mpr (hM i j)⟩

private lemma ggOmW3_descendMatrix_map {ι K : Type} [Field K]
    (σ : K ≃+* K) (M : Matrix ι ι K) (hM : ∀ i j, σ (M i j) = M i j) :
    (ggOmW3_descendMatrix σ M hM).map (algebraMap ↥(fixedField K σ) K) = M := by
  ext i j
  rfl

private noncomputable def ggOmW3_descendGL {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (X : GL ι K) (hX : X.map σ.toRingHom = X) :
    GL ι ↥(fixedField K σ) := by
  have hentry : ∀ i j, σ ((X : Matrix ι ι K) i j) = (X : Matrix ι ι K) i j := by
    intro i j
    have h := congrArg (fun Y : GL ι K => (Y : Matrix ι ι K) i j) hX
    simpa [Matrix.GeneralLinearGroup.val_map_apply, Matrix.map_apply] using h
  refine Matrix.GeneralLinearGroup.mkOfDetNeZero
    (ggOmW3_descendMatrix σ (X : Matrix ι ι K) hentry) ?_
  intro hdet
  have hdetmap : algebraMap ↥(fixedField K σ) K
      ((ggOmW3_descendMatrix σ (X : Matrix ι ι K) hentry).det) = (X : Matrix ι ι K).det := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply, ggOmW3_descendMatrix_map]
  rw [hdet, map_zero] at hdetmap
  exact X.det_ne_zero hdetmap.symm

private lemma ggOmW3_descendGL_map {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (X : GL ι K) (hX : X.map σ.toRingHom = X) :
    (ggOmW3_descendGL σ X hX).map (algebraMap ↥(fixedField K σ) K) = X := by
  apply Units.ext
  unfold ggOmW3_descendGL
  rw [Matrix.GeneralLinearGroup.val_map_apply,
    Matrix.GeneralLinearGroup.val_mkOfDetNeZero, ggOmW3_descendMatrix_map]

private lemma ggOmW3_descendGL_mapM {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (X : GL ι K) (hX : X.map σ.toRingHom = X) :
    ((ggOmW3_descendGL σ X hX : GL ι ↥(fixedField K σ)) : Matrix ι ι ↥(fixedField K σ)).map
        (algebraMap ↥(fixedField K σ) K) = (X : Matrix ι ι K) := by
  simpa [Matrix.GeneralLinearGroup.val_map_apply] using
    congrArg (fun Y : GL ι K => (Y : Matrix ι ι K)) (ggOmW3_descendGL_map σ X hX)

private lemma ggOmW3_map_subtype_fixed {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (Y : GL ι ↥(fixedField K σ)) :
    (Y.map (algebraMap ↥(fixedField K σ) K)).map σ.toRingHom =
      Y.map (algebraMap ↥(fixedField K σ) K) := by
  apply Units.ext
  rw [Matrix.GeneralLinearGroup.val_map_apply, Matrix.GeneralLinearGroup.val_map_apply]
  ext i j
  simp only [Matrix.map_apply]
  exact fixedField_coe K σ (Y i j)

private lemma ggOmW3_descendGL_extend {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (Y : GL ι ↥(fixedField K σ)) :
    ggOmW3_descendGL σ (Y.map (algebraMap ↥(fixedField K σ) K))
      (ggOmW3_map_subtype_fixed σ Y) = Y := by
  apply Units.ext
  show (ggOmW3_descendGL σ (Y.map (algebraMap ↥(fixedField K σ) K))
    (ggOmW3_map_subtype_fixed σ Y) : Matrix ι ι ↥(fixedField K σ)) =
      (Y : Matrix ι ι ↥(fixedField K σ))
  unfold ggOmW3_descendGL
  rw [Matrix.GeneralLinearGroup.val_mkOfDetNeZero]
  ext i j
  simp only [ggOmW3_descendMatrix, Matrix.GeneralLinearGroup.val_map_apply, Matrix.map_apply]
  rfl

private lemma ggOmW3_conj_fixed_of_hfix {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (A P g : GL ι K) (hPA : A = P⁻¹ * P.map σ.toRingHom)
    (hg : A * g.map σ.toRingHom * A⁻¹ = g) :
    (P * g * P⁻¹).map σ.toRingHom = P * g * P⁻¹ := by
  have hg' : g.map σ.toRingHom = A⁻¹ * g * A := by
    calc g.map σ.toRingHom = A⁻¹ * (A * g.map σ.toRingHom * A⁻¹) * A := by group
      _ = A⁻¹ * g * A := by rw [hg]
  calc (P * g * P⁻¹).map σ.toRingHom
      = P.map σ.toRingHom * g.map σ.toRingHom * (P⁻¹).map σ.toRingHom := by
        rw [map_mul, map_mul, map_inv]
    _ = P.map σ.toRingHom * (A⁻¹ * g * A) * (P⁻¹).map σ.toRingHom := by rw [hg']
    _ = P * g * P⁻¹ := by
        rw [hPA, _root_.mul_inv_rev, inv_inv, map_inv]
        group

private def ggOmW3_inclVec {ι K : Type} [Field K] (K₀ : Subfield K) (w : ι → K₀) : ι → K :=
  fun i => (w i : K)

private lemma ggOmW3_inclVec_injective {ι K : Type} [Field K] (K₀ : Subfield K) :
    Function.Injective (fun w : ι → K₀ => ggOmW3_inclVec K₀ w) := by
  intro w w' h
  funext i
  exact Subtype.ext (congrFun h i)

private lemma ggOmW3_coe_polar_subfield {K : Type} [Field K] (K₀ : Subfield K)
    {M : Type} [AddCommGroup M] (f : M → K₀) (x y : M) :
    ((QuadraticMap.polar f x y : K₀) : K) =
      QuadraticMap.polar (fun m => (f m : K)) x y := by
  simp [QuadraticMap.polar]

private noncomputable def ggOmW3_transformForm {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (Φ : QuadraticForm K (ι → K)) (Qm : Matrix ι ι K) :
    QuadraticForm K (ι → K) :=
  Φ.comp (Matrix.toLin' Qm)

private lemma ggOmW3_transformForm_apply {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) (Qm : Matrix ι ι K) (w : ι → K) :
    ggOmW3_transformForm Φ Qm w = Φ (Qm *ᵥ w) := by
  simp [ggOmW3_transformForm, Matrix.toLin'_apply]

private noncomputable def ggOmW3b_toLin'_linearEquiv {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (Q : GL ι K) : (ι → K) ≃ₗ[K] (ι → K) :=
  Matrix.toLin'OfInv (M := ((Q⁻¹ : GL ι K) : Matrix ι ι K))
    (M' := ((Q : GL ι K) : Matrix ι ι K)) (by simp) (by simp)

private lemma ggOmW3b_toLin'_linearEquiv_coe {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (Q : GL ι K) :
    ((ggOmW3b_toLin'_linearEquiv Q : (ι → K) ≃ₗ[K] (ι → K)) :
        (ι → K) →ₗ[K] (ι → K)) =
      Matrix.toLin' ((Q : GL ι K) : Matrix ι ι K) := rfl

private lemma ggOmW3b_compl₁₂_nondegenerate {ι K : Type} [Field K]
    (B : (ι → K) →ₗ[K] (ι → K) →ₗ[K] K)
    (e : (ι → K) ≃ₗ[K] (ι → K)) (hB : B.Nondegenerate) :
    (LinearMap.compl₁₂ B (e : (ι → K) →ₗ[K] (ι → K))
      (e : (ι → K) →ₗ[K] (ι → K))).Nondegenerate := by
  constructor
  · intro x hx
    apply e.injective
    rw [map_zero]
    apply hB.1
    intro z
    obtain ⟨y, rfl⟩ := e.surjective z
    exact hx y
  · intro y hy
    apply e.injective
    rw [map_zero]
    apply hB.2
    intro z
    obtain ⟨x, rfl⟩ := e.surjective z
    exact hy x

private lemma ggOmW3_transformForm_nondegenerate {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (Φ : QuadraticForm K (ι → K)) (Q : GL ι K)
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate) :
    (QuadraticMap.polarBilin
      (ggOmW3_transformForm Φ ((Q : GL ι K) : Matrix ι ι K))).Nondegenerate := by
  have h := QuadraticMap.polarBilin_comp Φ (Matrix.toLin' ((Q : GL ι K) : Matrix ι ι K))
  rw [ggOmW3_transformForm, h, ← ggOmW3b_toLin'_linearEquiv_coe Q]
  exact ggOmW3b_compl₁₂_nondegenerate (QuadraticMap.polarBilin Φ)
    (ggOmW3b_toLin'_linearEquiv Q) hΦ

private lemma ggOmW3_transformForm_semilinear {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (Φ : QuadraticForm K (ι → K)) (A : GL ι K)
    (hAΦ : ∀ v : ι → K, Φ ((A : Matrix ι ι K) *ᵥ fun i => σ (v i)) = σ (Φ v))
    (P : GL ι K)
    (hP : A = P⁻¹ * P.map σ.toRingHom) :
    ∀ w : ι → K,
      ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K) (fun i => σ (w i)) =
        σ (ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K) w) := by
  intro w
  have hmat : A * (P⁻¹).map σ.toRingHom = P⁻¹ := by
    rw [hP, Matrix.GeneralLinearGroup.map_inv]
    group
  have hmat' : (A : Matrix ι ι K) * ((P⁻¹ : GL ι K) : Matrix ι ι K).map σ.toRingHom
      = ((P⁻¹ : GL ι K) : Matrix ι ι K) := by
    have hcoe : ((P⁻¹.map σ.toRingHom : GL ι K) : Matrix ι ι K)
        = ((P⁻¹ : GL ι K) : Matrix ι ι K).map σ.toRingHom := by
      simpa using ggOmW3_coe_map σ P⁻¹
    rw [← hcoe]
    have h := congrArg (fun X : GL ι K => (X : Matrix ι ι K)) hmat
    simpa using h
  have hvec : ((P⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ (fun i => σ (w i)) =
      (A : Matrix ι ι K) *ᵥ
        (fun i => σ ((((P⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ w) i)) := by
    have h1 : (fun i => σ ((((P⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ w) i)) =
        ((P⁻¹ : GL ι K) : Matrix ι ι K).map σ.toRingHom *ᵥ (fun i => σ (w i)) := by
      funext i
      exact RingHom.map_mulVec σ.toRingHom ((P⁻¹ : GL ι K) : Matrix ι ι K) w i
    rw [h1, Matrix.mulVec_mulVec, hmat']
  rw [ggOmW3_transformForm_apply, ggOmW3_transformForm_apply, hvec]
  exact hAΦ (((P⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ w)

private lemma ggOmW3b_inclVec_add {ι K : Type} [Field K] (K₀ : Subfield K) (w w' : ι → K₀) :
    ggOmW3_inclVec K₀ (w + w') = ggOmW3_inclVec K₀ w + ggOmW3_inclVec K₀ w' := by
  funext i
  simp [ggOmW3_inclVec]

private lemma ggOmW3b_inclVec_smul {ι K : Type} [Field K] (K₀ : Subfield K) (a : K₀)
    (w : ι → K₀) :
    ggOmW3_inclVec K₀ (a • w) = (a : K) • ggOmW3_inclVec K₀ w := by
  funext i
  simp [ggOmW3_inclVec]

private lemma ggOmW3b_inclVec_single {ι K : Type} [DecidableEq ι] [Field K] (K₀ : Subfield K)
    (i : ι) : ggOmW3_inclVec K₀ (Pi.single i 1) = Pi.single i 1 := by
  funext j
  by_cases h : j = i
  · subst h
    simp [ggOmW3_inclVec]
  · simp [ggOmW3_inclVec, h]

private noncomputable def ggOmW3_descendForm {ι K : Type} [Field K]
    (σ : K ≃+* K) (Φ' : QuadraticForm K (ι → K))
    (hinv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w)) :
    QuadraticForm ↥(fixedField K σ) (ι → ↥(fixedField K σ)) :=
  let K₀ : Subfield K := fixedField K σ
  have hQ : ∀ w : ι → K₀, Φ' (ggOmW3_inclVec K₀ w) ∈ K₀ := fun w => by
    refine (mem_fixedField_iff K σ _).mpr ?_
    have hfix : (fun i => σ (ggOmW3_inclVec K₀ w i)) = ggOmW3_inclVec K₀ w := by
      funext i
      exact (mem_fixedField_iff K σ (w i : K)).mp (w i).2
    have h := hinv (ggOmW3_inclVec K₀ w)
    rw [hfix] at h
    exact h.symm
  QuadraticMap.ofPolar
    (fun w => ⟨Φ' (ggOmW3_inclVec K₀ w), hQ w⟩)
    (fun a w => Subtype.ext (by
      change Φ' (ggOmW3_inclVec K₀ (a • w)) = (a : K) * (a : K) * Φ' (ggOmW3_inclVec K₀ w)
      rw [ggOmW3b_inclVec_smul, QuadraticMap.map_smul, smul_eq_mul]))
    (fun x x' y => Subtype.ext (by
      rw [Subfield.coe_add, ggOmW3_coe_polar_subfield, ggOmW3_coe_polar_subfield,
        ggOmW3_coe_polar_subfield]
      change QuadraticMap.polar Φ' (ggOmW3_inclVec K₀ (x + x')) (ggOmW3_inclVec K₀ y) =
        QuadraticMap.polar Φ' (ggOmW3_inclVec K₀ x) (ggOmW3_inclVec K₀ y) +
          QuadraticMap.polar Φ' (ggOmW3_inclVec K₀ x') (ggOmW3_inclVec K₀ y)
      rw [ggOmW3b_inclVec_add, QuadraticMap.polar_add_left]))
    (fun a x y => Subtype.ext (by
      rw [smul_eq_mul, Subfield.coe_mul, ggOmW3_coe_polar_subfield, ggOmW3_coe_polar_subfield]
      change QuadraticMap.polar Φ' (ggOmW3_inclVec K₀ (a • x)) (ggOmW3_inclVec K₀ y) =
        (a : K) * QuadraticMap.polar Φ' (ggOmW3_inclVec K₀ x) (ggOmW3_inclVec K₀ y)
      rw [ggOmW3b_inclVec_smul, QuadraticMap.polar_smul_left, smul_eq_mul]))

private lemma ggOmW3_descendForm_apply {ι K : Type} [Field K]
    (σ : K ≃+* K) (Φ' : QuadraticForm K (ι → K))
    (hinv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w))
    (w : ι → ↥(fixedField K σ)) :
    (ggOmW3_descendForm σ Φ' hinv w : K) = Φ' (ggOmW3_inclVec (fixedField K σ) w) :=
  rfl

private lemma ggOmW3_coe_polar_descendForm {ι K : Type} [Field K]
    (σ : K ≃+* K) (Φ' : QuadraticForm K (ι → K))
    (hinv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w))
    (x y : ι → ↥(fixedField K σ)) :
    ((QuadraticMap.polar (ggOmW3_descendForm σ Φ' hinv) x y : ↥(fixedField K σ)) : K) =
      QuadraticMap.polar Φ' (ggOmW3_inclVec (fixedField K σ) x)
        (ggOmW3_inclVec (fixedField K σ) y) := by
  rw [QuadraticMap.polar, QuadraticMap.polar, Subfield.coe_sub, Subfield.coe_sub,
    ggOmW3_descendForm_apply, ggOmW3_descendForm_apply, ggOmW3_descendForm_apply,
    ggOmW3b_inclVec_add]

private lemma ggOmW3b_polar_eq_sum_single {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Q' : QuadraticForm K (ι → K)) (u v : ι → K) :
    QuadraticMap.polar Q' u v =
      ∑ j, v j * QuadraticMap.polar Q' u (Pi.single j 1) := by
  have hv : v = ∑ j, v j • (Pi.single j (1 : K) : ι → K) := by
    funext i
    simp [Finset.sum_apply, Pi.single_apply]
  have h := congrArg (QuadraticMap.polarBilin Q' u) hv
  rw [map_sum] at h
  rw [← QuadraticMap.polarBilin_apply_apply, h]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_smul, smul_eq_mul, QuadraticMap.polarBilin_apply_apply]

private lemma ggOmW3_descendForm_nondegenerate {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (Φ' : QuadraticForm K (ι → K))
    (hinv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w))
    (hnd : (QuadraticMap.polarBilin Φ').Nondegenerate) :
    (QuadraticMap.polarBilin (ggOmW3_descendForm σ Φ' hinv)).Nondegenerate := by
  have key : ∀ x : ι → ↥(fixedField K σ),
      (∀ y, QuadraticMap.polar (ggOmW3_descendForm σ Φ' hinv) x y = 0) → x = 0 := by
    intro x hx
    have h0 : ∀ v, QuadraticMap.polar Φ' (ggOmW3_inclVec (fixedField K σ) x) v = 0 := by
      intro v
      rw [ggOmW3b_polar_eq_sum_single]
      refine Finset.sum_eq_zero fun j _ => ?_
      have hxj := congrArg (fun z : ↥(fixedField K σ) => (z : K)) (hx (Pi.single j 1))
      rw [ggOmW3_coe_polar_descendForm, ggOmW3b_inclVec_single (fixedField K σ) j,
        Subfield.coe_zero] at hxj
      rw [hxj, mul_zero]
    have h1 : ggOmW3_inclVec (fixedField K σ) x = 0 := hnd.1 _ fun v => by
      rw [QuadraticMap.polarBilin_apply_apply, h0]
    exact ggOmW3_inclVec_injective (fixedField K σ)
      (h1.trans (by funext i; simp [ggOmW3_inclVec]))
  refine ⟨fun x hx => key x fun y => ?_, fun y hy => key y fun x => ?_⟩
  · rw [← QuadraticMap.polarBilin_apply_apply]
    exact hx y
  · rw [QuadraticMap.polar_comm, ← QuadraticMap.polarBilin_apply_apply]
    exact hy x

private lemma ggOmW3_eq_of_forall_inclVec {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) {Q₁ Q₂ : QuadraticForm K (ι → K)}
    (h : ∀ w : ι → ↥(fixedField K σ),
      Q₁ (ggOmW3_inclVec (fixedField K σ) w) = Q₂ (ggOmW3_inclVec (fixedField K σ) w)) :
    Q₁ = Q₂ := by
  have hbasis : ∀ i, Q₁ (Pi.basisFun K ι i) = Q₂ (Pi.basisFun K ι i) := fun i => by
    rw [Pi.basisFun_apply, ← ggOmW3b_inclVec_single (K₀ := fixedField K σ) i]
    exact h _
  have hsum : ∀ i j, Q₁ (Pi.basisFun K ι i + Pi.basisFun K ι j) =
      Q₂ (Pi.basisFun K ι i + Pi.basisFun K ι j) := fun i j => by
    rw [Pi.basisFun_apply, Pi.basisFun_apply,
      ← ggOmW3b_inclVec_single (K₀ := fixedField K σ) i,
      ← ggOmW3b_inclVec_single (K₀ := fixedField K σ) j, ← ggOmW3b_inclVec_add]
    exact h _
  have hpolar_basis : ∀ i j, QuadraticMap.polar Q₁ (Pi.basisFun K ι i)
      (Pi.basisFun K ι j) = QuadraticMap.polar Q₂ (Pi.basisFun K ι i)
        (Pi.basisFun K ι j) := fun i j => by
    simp only [QuadraticMap.polar, hbasis, hsum]
  have hpolar_p : ∀ p : Sym2 ι,
      QuadraticMap.polarSym2 Q₁ (Sym2.map (Pi.basisFun K ι) p) =
        QuadraticMap.polarSym2 Q₂ (Sym2.map (Pi.basisFun K ι) p) := by
    intro p
    induction p using Sym2.ind with
    | _ i j =>
      rw [Sym2.map_mk, QuadraticMap.polarSym2_sym2Mk, QuadraticMap.polarSym2_sym2Mk]
      exact hpolar_basis i j
  have hb : (Q₁ ∘ Pi.basisFun K ι) = (Q₂ ∘ Pi.basisFun K ι) := funext hbasis
  refine QuadraticMap.ext fun x => ?_
  rw [← QuadraticMap.sum_repr_sq_add_sum_repr_mul_polar Q₁ (Pi.basisFun K ι) x,
    ← QuadraticMap.sum_repr_sq_add_sum_repr_mul_polar Q₂ (Pi.basisFun K ι) x]
  simp only [hb, hpolar_p]

private lemma ggOmW3_mem_orth_conj {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) (P g : GL ι K) (hg : g ∈ matrixOrthogonal ⇑Φ) :
    P * g * P⁻¹ ∈
      matrixOrthogonal ⇑(ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K)) := by
  intro v
  rw [ggOmW3_transformForm_apply, ggOmW3_transformForm_apply]
  have hunit : P⁻¹ * (P * g * P⁻¹) = g * P⁻¹ := by group
  rw [Matrix.mulVec_mulVec, ← Units.val_mul, hunit, Units.val_mul, ← Matrix.mulVec_mulVec]
  exact hg _

private lemma ggOmW3_conj_mem_statedOmega {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) (P b : GL ι K) (hb : b ∈ StatedOmega ⇑Φ) :
    P * b * P⁻¹ ∈
      StatedOmega ⇑(ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K)) := by
  rw [statedOmega_eq_commutator
    (⇑(ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K)))]
  rw [statedOmega_eq_commutator (⇑Φ)] at hb
  have hmap : (matrixOrthogonal ⇑Φ).map (MulAut.conj P).toMonoidHom ≤
      matrixOrthogonal ⇑(ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K)) := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
    simpa [MulAut.conj_apply] using ggOmW3_mem_orth_conj Φ P y hy
  have hb' : (MulAut.conj P) b ∈
      (⁅matrixOrthogonal ⇑Φ, matrixOrthogonal ⇑Φ⁆).map (MulAut.conj P).toMonoidHom :=
    Subgroup.mem_map_of_mem _ hb
  rw [Subgroup.map_commutator] at hb'
  have hmem := (Subgroup.commutator_mono hmap hmap) hb'
  simpa [MulAut.conj_apply] using hmem

private lemma ggOmW3_commSpace_toLinEquiv {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (w : GL ι K) :
    commSpace (toLinEquiv ι K w) =
      LinearMap.range (Matrix.toLin' ((w : Matrix ι ι K) - 1)) := by
  rw [commSpace]
  have h : ((toLinEquiv ι K w : ((ι → K) ≃ₗ[K] (ι → K))) : (ι → K) →ₗ[K] (ι → K)) - 1 =
      Matrix.toLin' ((w : Matrix ι ι K) - 1) := by
    apply LinearMap.ext
    intro v
    change (toLinEquiv ι K w) v - v = (Matrix.toLin' ((w : Matrix ι ι K) - 1)) v
    rw [toLinEquiv_apply, Matrix.toLin'_apply, Matrix.sub_mulVec, Matrix.one_mulVec]
  rw [h]

private theorem ggOmW3c_exists_ne_zero_ne_one_of_card_ne_two
    {K : Type} [Field K] [Fintype K] (hK : Nat.card K ≠ 2) :
    ∃ c : K, c ≠ 0 ∧ c ≠ 1 := by
  classical
  haveI : Nontrivial K := ⟨0, 1, zero_ne_one⟩
  have h1 : 1 < Nat.card K := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have h2 : 2 < Nat.card K := by omega
  have hcard : ({0, 1} : Finset K).card = 2 := by
    rw [Finset.card_pair_eq_two_iff]
    exact zero_ne_one
  have hlt : ({0, 1} : Finset K).card < (Finset.univ : Finset K).card := by
    rw [hcard, Finset.card_univ, ← Nat.card_eq_fintype_card]
    exact h2
  obtain ⟨c, -, hc⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt
  refine ⟨c, ?_, ?_⟩
  · intro h
    exact hc (by simp [h])
  · intro h
    exact hc (by simp [h])

private theorem ggOmW3c_omegaGroup_le_commutator
    {ι K : Type} [Fintype ι] [Field K] [Fintype K] [CharP K 2]
    (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h4 : 4 ≤ Fintype.card ι) (h5 : 5 ≤ Fintype.card ι) :
    omegaGroup Φ hΦ ≤
      ⁅TauCeti.QuadraticMap.orthogonalGroup Φ, TauCeti.QuadraticMap.orthogonalGroup Φ⁆ := by
  have hdim : Module.finrank K (ι → K) = Fintype.card ι :=
    Module.finrank_fintype_fun_eq_card K
  have h4' : 4 ≤ Module.finrank K (ι → K) := by rw [hdim]; exact h4
  have h5' : 5 ≤ Module.finrank K (ι → K) := by rw [hdim]; exact h5
  refine (CFSG.RankThree.GF2n.Smith81.omegaGroup_le_elementaryGroup_of_four_le
    (V := ι → K) hΦ h4').trans ?_
  by_cases hK2 : Nat.card K = 2
  · haveI : CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.IsF2 K :=
      CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.IsF2.of_natCard_eq_two hK2
    exact CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.elementaryGroup_le_commutator
      (V := ι → K) hΦ (Or.inl h5')
  · obtain ⟨c, hc0, hc1⟩ := ggOmW3c_exists_ne_zero_ne_one_of_card_ne_two (K := K) hK2
    exact CFSG.RankThree.GF2n.Stroth80.Classify.elementaryGroup_le_commutator
      (V := ι → K) hΦ hc0 hc1

private theorem ggOmW3c_omegaGroup_eq_commutator
    {ι K : Type} [Fintype ι] [Field K] [Fintype K] [CharP K 2]
    (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h4 : 4 ≤ Fintype.card ι) (h5 : 5 ≤ Fintype.card ι) :
    omegaGroup Φ hΦ =
      ⁅TauCeti.QuadraticMap.orthogonalGroup Φ, TauCeti.QuadraticMap.orthogonalGroup Φ⁆ :=
  le_antisymm (ggOmW3c_omegaGroup_le_commutator Φ hΦ h4 h5)
    (CFSG.LargeExtraspecial.DW.commutator_le_omegaGroup hΦ)

private theorem ggOmW3_mem_statedOmega_iff_omegaGroup {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] [Fintype K] [CharP K 2] (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h4 : 4 ≤ Fintype.card ι) (h5 : 5 ≤ Fintype.card ι) (w : GL ι K) :
    w ∈ StatedOmega ⇑Φ ↔
      toLinEquiv ι K w ∈ omegaGroup Φ hΦ := by
  rw [statedOmega_eq_comap (Q := Φ) (Q₀ := ⇑Φ) rfl,
    ggOmW3c_omegaGroup_eq_commutator Φ hΦ h4 h5, Subgroup.mem_comap]
  rfl

open scoped TensorProduct

private def ggOmW3c_incl {ι K₀ K : Type} [Field K₀] [Field K] [Algebra K₀ K]
    (w : ι → K₀) : ι → K :=
  fun i => algebraMap K₀ K (w i)

private lemma ggOmW3c_incl_mulVec {ι K₀ K : Type} [Fintype ι]
    [Field K₀] [Field K] [Algebra K₀ K] (M₀ : Matrix ι ι K₀) (w : ι → K₀) :
    ggOmW3c_incl (M₀ *ᵥ w) = (M₀.map (algebraMap K₀ K)) *ᵥ ggOmW3c_incl w := by
  ext i
  simp [ggOmW3c_incl, Matrix.mulVec, dotProduct, map_sum, map_mul]

private lemma ggOmW3c_incl_sub {ι K₀ K : Type} [Field K₀] [Field K] [Algebra K₀ K]
    (u v : ι → K₀) :
    ggOmW3c_incl (K := K) (u - v) = ggOmW3c_incl (K := K) u - ggOmW3c_incl (K := K) v := by
  ext i
  simp [ggOmW3c_incl]

private lemma ggOmW3c_incl_sub_one {ι K₀ K : Type} [Fintype ι] [DecidableEq ι]
    [Field K₀] [Field K] [Algebra K₀ K] (M₀ : Matrix ι ι K₀) (w : ι → K₀) :
    ggOmW3c_incl ((M₀ - 1) *ᵥ w) =
      (M₀.map (algebraMap K₀ K) - 1) *ᵥ ggOmW3c_incl w := by
  calc ggOmW3c_incl ((M₀ - 1) *ᵥ w)
      = ggOmW3c_incl (M₀ *ᵥ w - 1 *ᵥ w) := by rw [Matrix.sub_mulVec]
    _ = ggOmW3c_incl (M₀ *ᵥ w) - ggOmW3c_incl (1 *ᵥ w) := ggOmW3c_incl_sub _ _
    _ = (M₀.map (algebraMap K₀ K)) *ᵥ ggOmW3c_incl w - ggOmW3c_incl (1 *ᵥ w) := by
          rw [ggOmW3c_incl_mulVec]
    _ = (M₀.map (algebraMap K₀ K)) *ᵥ ggOmW3c_incl w - ggOmW3c_incl w := by
          rw [Matrix.one_mulVec]
    _ = ((M₀.map (algebraMap K₀ K)) - 1) *ᵥ ggOmW3c_incl w := by
          rw [Matrix.sub_mulVec, Matrix.one_mulVec]

private noncomputable def ggOmW3c_e {ι K₀ K : Type} [Fintype ι] [DecidableEq ι]
    [Field K₀] [Field K] [Algebra K₀ K] :
    K ⊗[K₀] (ι → K₀) ≃ₗ[K] (ι → K) :=
  TensorProduct.piScalarRight K₀ K K ι

private lemma ggOmW3c_piScalarRight_tmul {ι K₀ K : Type} [Fintype ι] [DecidableEq ι]
    [Field K₀] [Field K] [Algebra K₀ K] (c : K) (w : ι → K₀) :
    ggOmW3c_e (ι := ι) (K₀ := K₀) (K := K) (c ⊗ₜ[K₀] w) = c • ggOmW3c_incl w := by
  rw [ggOmW3c_e, TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul]
  ext i
  simp [ggOmW3c_incl, Algebra.smul_def, mul_comm]

private lemma ggOmW3c_finrank_range_baseChange {ι K₀ K : Type} [Fintype ι] [DecidableEq ι]
    [Field K₀] [Field K] [Algebra K₀ K] (M₀ : Matrix ι ι K₀) :
    Module.finrank K (LinearMap.range
        (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1)))) =
      Module.finrank K₀ (LinearMap.range (Matrix.toLin' (M₀ - 1))) := by
  haveI : FiniteDimensional K (TensorProduct K₀ K (ι → K₀)) := inferInstance
  have hker : Module.finrank K (LinearMap.ker
        (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1)))) =
      Module.finrank K₀ (LinearMap.ker (Matrix.toLin' (M₀ - 1))) := by
    have h := LinearMap.kerBaseChangeEquiv (F := K₀) (E := K) (Matrix.toLin' (M₀ - 1))
    calc Module.finrank K (LinearMap.ker (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1))))
        = Module.finrank K (K ⊗[K₀] (LinearMap.ker (Matrix.toLin' (M₀ - 1)))) :=
          h.finrank_eq.symm
      _ = Module.finrank K₀ (LinearMap.ker (Matrix.toLin' (M₀ - 1))) :=
          Module.finrank_baseChange
  have hK := LinearMap.finrank_range_add_finrank_ker
    (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1)))
  have hF := LinearMap.finrank_range_add_finrank_ker (Matrix.toLin' (M₀ - 1))
  have hdom : Module.finrank K (TensorProduct K₀ K (ι → K₀)) = Module.finrank K₀ (ι → K₀) :=
    Module.finrank_baseChange
  have hK' : Module.finrank K (LinearMap.range (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1)))) +
        Module.finrank K₀ (LinearMap.ker (Matrix.toLin' (M₀ - 1))) =
      Module.finrank K₀ (ι → K₀) := by
    rw [← hker, ← hdom]
    exact hK
  exact Nat.add_right_cancel (hK'.trans hF.symm)

private lemma ggOmW3_finrank_range_map {ι K₀ K : Type} [Fintype ι] [DecidableEq ι]
    [Field K₀] [Field K] [Algebra K₀ K]
    (M₀ : Matrix ι ι K₀) :
    Module.finrank K (LinearMap.range (Matrix.toLin' (M₀.map (algebraMap K₀ K) - 1))) =
      Module.finrank K₀ (LinearMap.range (Matrix.toLin' (M₀ - 1))) := by
  have hconj : (Matrix.toLin' (M₀.map (algebraMap K₀ K) - 1)).comp
        (ggOmW3c_e (ι := ι) (K₀ := K₀) (K := K) :
          K ⊗[K₀] (ι → K₀) →ₗ[K] (ι → K)) =
      (ggOmW3c_e (ι := ι) (K₀ := K₀) (K := K) :
          K ⊗[K₀] (ι → K₀) →ₗ[K] (ι → K)).comp
        (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1))) := by
    apply LinearMap.ext
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul c w =>
        change Matrix.toLin' (M₀.map (algebraMap K₀ K) - 1) (ggOmW3c_e (c ⊗ₜ[K₀] w)) =
          ggOmW3c_e ((LinearMap.baseChange K (Matrix.toLin' (M₀ - 1))) (c ⊗ₜ[K₀] w))
        rw [ggOmW3c_piScalarRight_tmul, LinearMap.map_smul, LinearMap.baseChange_tmul,
          ggOmW3c_piScalarRight_tmul, Matrix.toLin'_apply, Matrix.toLin'_apply,
          ← ggOmW3c_incl_sub_one]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hrange : LinearMap.range (Matrix.toLin' (M₀.map (algebraMap K₀ K) - 1)) =
      (LinearMap.range (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1)))).map
        (ggOmW3c_e (ι := ι) (K₀ := K₀) (K := K) :
          K ⊗[K₀] (ι → K₀) →ₗ[K] (ι → K)) := by
    have h1 : LinearMap.range (Matrix.toLin' (M₀.map (algebraMap K₀ K) - 1)) =
        LinearMap.range ((Matrix.toLin' (M₀.map (algebraMap K₀ K) - 1)).comp
          (ggOmW3c_e (ι := ι) (K₀ := K₀) (K := K) :
            K ⊗[K₀] (ι → K₀) →ₗ[K] (ι → K))) := by
      rw [LinearMap.range_comp, ggOmW3c_e, LinearEquiv.range, Submodule.map_top]
    rw [h1, hconj, LinearMap.range_comp]
  rw [hrange]
  exact (LinearEquiv.finrank_map_eq (ggOmW3c_e (ι := ι) (K₀ := K₀) (K := K))
    (LinearMap.range (LinearMap.baseChange K (Matrix.toLin' (M₀ - 1))))).trans
    (ggOmW3c_finrank_range_baseChange M₀)

private lemma ggOmW3c_inclVec_mulVec {ι K : Type} [Fintype ι] [Field K]
    (σ : K ≃+* K) (M₀ : Matrix ι ι ↥(fixedField K σ)) (w : ι → ↥(fixedField K σ)) :
    ggOmW3_inclVec (fixedField K σ) (M₀ *ᵥ w) =
      (M₀.map (algebraMap ↥(fixedField K σ) K)) *ᵥ ggOmW3_inclVec (fixedField K σ) w := by
  change ggOmW3c_incl (M₀ *ᵥ w) =
    (M₀.map (algebraMap ↥(fixedField K σ) K)) *ᵥ ggOmW3c_incl w
  exact ggOmW3c_incl_mulVec (K₀ := ↥(fixedField K σ)) (K := K) M₀ w

private lemma ggOmW3_mem_orth_descent {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (Φ' : QuadraticForm K (ι → K))
    (hinv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w))
    (g : GL ι K) (hg : g.map σ.toRingHom = g) :
    g ∈ matrixOrthogonal ⇑Φ' ↔
      ggOmW3_descendGL σ g hg ∈
        matrixOrthogonal ⇑(ggOmW3_descendForm σ Φ' hinv) := by
  constructor
  · intro hgort w
    apply Subtype.ext
    rw [ggOmW3_descendForm_apply, ggOmW3_descendForm_apply]
    rw [ggOmW3c_inclVec_mulVec, ggOmW3_descendGL_mapM σ g hg]
    exact hgort _
  · intro hdesc
    have hQ : ggOmW3_transformForm Φ' (g : Matrix ι ι K) = Φ' := by
      apply ggOmW3_eq_of_forall_inclVec σ
      intro w
      rw [ggOmW3_transformForm_apply, ← ggOmW3_descendGL_mapM σ g hg,
        ← ggOmW3c_inclVec_mulVec, ← ggOmW3_descendForm_apply σ Φ' hinv,
        ← ggOmW3_descendForm_apply σ Φ' hinv]
      exact congrArg Subtype.val (hdesc w)
    intro v
    have hv := DFunLike.congr_fun hQ v
    rwa [ggOmW3_transformForm_apply] at hv

private lemma ggOmW3c_mem_matrixOrthogonal_iff {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (Q : QuadraticForm K (ι → K)) (A : GL ι K) :
    A ∈ matrixOrthogonal ⇑Q ↔
      toLinEquiv ι K A ∈ TauCeti.QuadraticMap.orthogonalGroup Q := by
  constructor
  · intro hA
    refine TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mpr fun v => ?_
    rw [toLinEquiv_apply]
    exact hA v
  · intro hA v
    have := TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp hA v
    rwa [toLinEquiv_apply] at this

private lemma ggOmW3_mem_statedOmega_descent {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    [Fintype K] [CharP K 2] (σ : K ≃+* K)
    (Φ' : QuadraticForm K (ι → K))
    (hΦ' : (QuadraticMap.polarBilin Φ').Nondegenerate)
    (hinv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w))
    (h8 : 8 ≤ Fintype.card ι) (g : GL ι K) (hg : g.map σ.toRingHom = g) :
    g ∈ StatedOmega ⇑Φ' ↔
      ggOmW3_descendGL σ g hg ∈ StatedOmega ⇑(ggOmW3_descendForm σ Φ' hinv) := by
  letI : Finite K := Finite.of_fintype K
  haveI : Fintype ↥(fixedField K σ) := Fintype.ofFinite ↥(fixedField K σ)
  haveI : CharP ↥(fixedField K σ) 2 := ggOmW3_charP_fixedField (K := K) σ
  have h4 : 4 ≤ Fintype.card ι := by omega
  have h5 : 5 ≤ Fintype.card ι := by omega
  have hnd₀ : (QuadraticMap.polarBilin (ggOmW3_descendForm σ Φ' hinv)).Nondegenerate :=
    ggOmW3_descendForm_nondegenerate σ Φ' hinv hΦ'
  rw [ggOmW3_mem_statedOmega_iff_omegaGroup Φ' hΦ' h4 h5,
    ggOmW3_mem_statedOmega_iff_omegaGroup (ggOmW3_descendForm σ Φ' hinv) hnd₀ h4 h5]
  have heq : Module.finrank ↥(fixedField K σ)
        (commSpace (toLinEquiv ι ↥(fixedField K σ) (ggOmW3_descendGL σ g hg))) =
      Module.finrank K (commSpace (toLinEquiv ι K g)) := by
    rw [ggOmW3_commSpace_toLinEquiv, ggOmW3_commSpace_toLinEquiv,
      ← ggOmW3_descendGL_mapM σ g hg]
    exact (ggOmW3_finrank_range_map
      (K := K)
      ((ggOmW3_descendGL σ g hg : GL ι ↥(fixedField K σ)) :
        Matrix ι ι ↥(fixedField K σ))).symm
  constructor
  · intro hmem
    rw [mem_omegaGroup] at hmem ⊢
    obtain ⟨horth, heven⟩ := hmem
    refine ⟨?_, ?_⟩
    · exact (ggOmW3c_mem_matrixOrthogonal_iff (ggOmW3_descendForm σ Φ' hinv)
        (ggOmW3_descendGL σ g hg)).mp
        ((ggOmW3_mem_orth_descent σ Φ' hinv g hg).mp
          ((ggOmW3c_mem_matrixOrthogonal_iff Φ' g).mpr horth))
    · rw [heq]
      exact heven
  · intro hmem
    rw [mem_omegaGroup] at hmem ⊢
    obtain ⟨horth, heven⟩ := hmem
    refine ⟨?_, ?_⟩
    · exact (ggOmW3c_mem_matrixOrthogonal_iff Φ' g).mp
        ((ggOmW3_mem_orth_descent σ Φ' hinv g hg).mpr
          ((ggOmW3c_mem_matrixOrthogonal_iff (ggOmW3_descendForm σ Φ' hinv)
            (ggOmW3_descendGL σ g hg)).mpr horth))
    · rw [← heq]
      exact heven

private lemma ggOmW3_descentGL_centralizer {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K)
    (b'' : GL ι K)
    (b₀ : GL ι ↥(fixedField K σ))
    (hb₀ : (b₀ : Matrix ι ι ↥(fixedField K σ)).map (algebraMap ↥(fixedField K σ) K)
      = (b'' : Matrix ι ι K))
    (g : GL ι K) (hgfix : g.map σ.toRingHom = g)
    (hgcent : g * b'' = b'' * g) :
    ggOmW3_descendGL σ g hgfix * b₀ = b₀ * ggOmW3_descendGL σ g hgfix := by
  classical
  have hφinj : Function.Injective (algebraMap ↥(fixedField K σ) K) :=
    (algebraMap ↥(fixedField K σ) K).injective
  have hb₀GL : b₀.map (algebraMap ↥(fixedField K σ) K) = b'' := by
    apply Units.ext
    rw [Matrix.GeneralLinearGroup.val_map_apply]
    exact hb₀
  apply Matrix.GeneralLinearGroup.map_injective (f := algebraMap ↥(fixedField K σ) K) hφinj
  rw [map_mul, map_mul, ggOmW3_descendGL_map, hb₀GL]
  exact hgcent

private lemma ggOmW3d_conj_commute {G : Type} [Group G] (P X Y : G) :
    (P * X * P⁻¹) * (P * Y * P⁻¹) = (P * Y * P⁻¹) * (P * X * P⁻¹) ↔
      X * Y = Y * X := by
  constructor
  · intro h
    calc X * Y = P⁻¹ * ((P * X * P⁻¹) * (P * Y * P⁻¹)) * P := by group
      _ = P⁻¹ * ((P * Y * P⁻¹) * (P * X * P⁻¹)) * P := by rw [h]
      _ = Y * X := by group
  · intro h
    calc (P * X * P⁻¹) * (P * Y * P⁻¹) = P * (X * Y) * P⁻¹ := by group
      _ = P * (Y * X) * P⁻¹ := by rw [h]
      _ = (P * Y * P⁻¹) * (P * X * P⁻¹) := by group

private lemma ggOmW3d_transformForm_comp {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) (A B : Matrix ι ι K) :
    ggOmW3_transformForm (ggOmW3_transformForm Φ A) B =
      ggOmW3_transformForm Φ (A * B) := by
  ext w
  rw [ggOmW3_transformForm_apply, ggOmW3_transformForm_apply,
    ggOmW3_transformForm_apply, Matrix.mulVec_mulVec]

private lemma ggOmW3d_transformForm_one {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (Φ : QuadraticForm K (ι → K)) :
    ggOmW3_transformForm Φ (1 : Matrix ι ι K) = Φ := by
  ext w
  rw [ggOmW3_transformForm_apply, Matrix.one_mulVec]

private lemma ggOmW3d_transformForm_inv_mul_eq {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (Φ : QuadraticForm K (ι → K)) (P : GL ι K) :
    ggOmW3_transformForm (ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K))
        (((P⁻¹ : GL ι K)⁻¹ : GL ι K) : Matrix ι ι K) = Φ := by
  rw [show (P⁻¹ : GL ι K)⁻¹ = P from inv_inv P]
  rw [ggOmW3d_transformForm_comp]
  have h : ((P⁻¹ : GL ι K) : Matrix ι ι K) * ((P : GL ι K) : Matrix ι ι K) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  rw [h, ggOmW3d_transformForm_one]

private lemma ggOmW3d_descendGL_mul {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (X Y : GL ι K) (hX : X.map σ.toRingHom = X)
    (hY : Y.map σ.toRingHom = Y) (hXY : (X * Y).map σ.toRingHom = X * Y) :
    ggOmW3_descendGL σ (X * Y) hXY =
      ggOmW3_descendGL σ X hX * ggOmW3_descendGL σ Y hY := by
  apply Matrix.GeneralLinearGroup.map_injective
    (f := algebraMap ↥(fixedField K σ) K) (algebraMap ↥(fixedField K σ) K).injective
  calc (ggOmW3_descendGL σ (X * Y) hXY).map (algebraMap ↥(fixedField K σ) K) = X * Y :=
        ggOmW3_descendGL_map σ (X * Y) hXY
    _ = (ggOmW3_descendGL σ X hX).map (algebraMap ↥(fixedField K σ) K) *
        (ggOmW3_descendGL σ Y hY).map (algebraMap ↥(fixedField K σ) K) := by
          rw [ggOmW3_descendGL_map σ X hX, ggOmW3_descendGL_map σ Y hY]
    _ = (ggOmW3_descendGL σ X hX * ggOmW3_descendGL σ Y hY).map
        (algebraMap ↥(fixedField K σ) K) := by rw [map_mul]

private lemma ggOmW3d_descendGL_congr {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) {X Y : GL ι K} (h : X = Y)
    (hX : X.map σ.toRingHom = X) (hY : Y.map σ.toRingHom = Y) :
    ggOmW3_descendGL σ X hX = ggOmW3_descendGL σ Y hY := by
  apply Matrix.GeneralLinearGroup.map_injective
    (f := algebraMap ↥(fixedField K σ) K) (algebraMap ↥(fixedField K σ) K).injective
  rw [ggOmW3_descendGL_map σ X hX, ggOmW3_descendGL_map σ Y hY, h]

private theorem ggOmW3_centralizer_equiv {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    [Fintype K] [CharP K 2] (σ : K ≃+* K)
    (Φ : QuadraticForm K (ι → K))
    (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate) (h8 : 8 ≤ Fintype.card ι)
    (A : GL ι K)
    (hAΦ : ∀ v : ι → K, Φ ((A : Matrix ι ι K) *ᵥ fun i => σ (v i)) = σ (Φ v))
    (b : GL ι K) (hb : b ∈ StatedOmega ⇑Φ)
    (hodd : Odd (orderOf b))
    (hfix : ∀ g ∈ (Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype,
      A * (g : GL ι K).map σ.toRingHom * A⁻¹ = g)
    (P : GL ι K) (hP : A = P⁻¹ * P.map σ.toRingHom)
    (b₀ : GL ι ↥(fixedField K σ))
    (hb₀ : (b₀ : Matrix ι ι ↥(fixedField K σ)).map (algebraMap ↥(fixedField K σ) K)
      = ((P * b * P⁻¹ : GL ι K) : Matrix ι ι K)) :
    Nonempty (↥((Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype) ≃*
      ↥((Subgroup.centralizer {b₀}).comap
        (StatedOmega ⇑(ggOmW3_descendForm σ
          (ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K))
          (ggOmW3_transformForm_semilinear σ Φ A hAΦ P hP))).subtype)) := by
  classical
  let K₀ : Subfield K := fixedField K σ
  let Φ' : QuadraticForm K (ι → K) :=
    ggOmW3_transformForm Φ ((P⁻¹ : GL ι K) : Matrix ι ι K)
  have hΦ'inv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w) :=
    ggOmW3_transformForm_semilinear σ Φ A hAΦ P hP
  let Φ₀ : QuadraticForm ↥K₀ (ι → ↥K₀) := ggOmW3_descendForm σ Φ' hΦ'inv
  have hΦ'nd : (QuadraticMap.polarBilin Φ').Nondegenerate :=
    ggOmW3_transformForm_nondegenerate Φ P⁻¹ hΦ
  let b'' : GL ι K := P * b * P⁻¹
  have hfixb : A * (b : GL ι K).map σ.toRingHom * A⁻¹ = b := by
    refine hfix ⟨b, hb⟩ ?_
    rw [Subgroup.mem_comap]
    exact Subgroup.mem_centralizer_iff.mpr (fun x hx => by
      rw [Set.mem_singleton_iff] at hx
      subst hx
      rfl)
  have hb''fix : b''.map σ.toRingHom = b'' :=
    ggOmW3_conj_fixed_of_hfix σ A P b hP hfixb
  have hb₀M : (b₀ : Matrix ι ι ↥K₀).map (algebraMap ↥K₀ K) = (b'' : Matrix ι ι K) := by
    simpa only [b''] using hb₀
  have hb₀GL : b₀.map (algebraMap ↥K₀ K) = b'' := by
    apply Units.ext
    rw [Matrix.GeneralLinearGroup.val_map_apply]
    exact hb₀M
  have hφinj : Function.Injective (algebraMap ↥K₀ K) := (algebraMap ↥K₀ K).injective
  let H_L : Subgroup ↥(StatedOmega ⇑Φ) :=
    (Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype
  let H_R : Subgroup ↥(StatedOmega ⇑Φ₀) :=
    (Subgroup.centralizer {b₀}).comap (StatedOmega ⇑Φ₀).subtype
  change Nonempty (↥H_L ≃* ↥H_R)
  let phi : ↥H_L → ↥H_R := fun g => by
    have hgmem : (g : GL ι K) ∈ StatedOmega ⇑Φ := g.1.2
    have hgcent : (g : GL ι K) ∈ Subgroup.centralizer {b} := by
      have h : g.1 ∈ (Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype := by
        simpa only [H_L] using g.2
      exact Subgroup.mem_comap.mp h
    have hgcent' : (g : GL ι K) * b = b * (g : GL ι K) :=
      (Subgroup.mem_centralizer_iff.mp hgcent b (Set.mem_singleton b)).symm
    have hfixg : A * (g : GL ι K).map σ.toRingHom * A⁻¹ = (g : GL ι K) :=
      hfix ⟨(g : GL ι K), hgmem⟩ (by rw [Subgroup.mem_comap]; exact hgcent)
    let X : GL ι K := P * (g : GL ι K) * P⁻¹
    have hXfix : X.map σ.toRingHom = X :=
      ggOmW3_conj_fixed_of_hfix σ A P (g : GL ι K) hP hfixg
    have hXmem : X ∈ StatedOmega ⇑Φ' :=
      ggOmW3_conj_mem_statedOmega Φ P (g : GL ι K) hgmem
    have hXcent : X * b'' = b'' * X := by
      have h := (ggOmW3d_conj_commute P (g : GL ι K) b).mpr hgcent'
      simpa only [X, b''] using h
    have hdesc_mem : ggOmW3_descendGL σ X hXfix ∈ StatedOmega ⇑Φ₀ :=
      (ggOmW3_mem_statedOmega_descent σ Φ' hΦ'nd hΦ'inv h8 X hXfix).mp hXmem
    have hdesc_cent : ggOmW3_descendGL σ X hXfix * b₀ =
        b₀ * ggOmW3_descendGL σ X hXfix :=
      ggOmW3_descentGL_centralizer σ b'' b₀ hb₀M
        X hXfix hXcent
    exact ⟨⟨ggOmW3_descendGL σ X hXfix, hdesc_mem⟩,
      Subgroup.mem_centralizer_iff.mpr (fun z hz => by
        rw [Set.mem_singleton_iff] at hz
        rw [hz]
        exact hdesc_cent.symm)⟩
  let psi : ↥H_R → ↥H_L := fun y => by
    have hy0mem : (y : GL ι ↥K₀) ∈ StatedOmega ⇑Φ₀ := y.1.2
    have hy0cent : (y : GL ι ↥K₀) ∈ Subgroup.centralizer {b₀} := by
      have h : y.1 ∈ (Subgroup.centralizer {b₀}).comap (StatedOmega ⇑Φ₀).subtype := by
        simpa only [H_R] using y.2
      exact Subgroup.mem_comap.mp h
    have hy0cent' : (y : GL ι ↥K₀) * b₀ = b₀ * (y : GL ι ↥K₀) :=
      (Subgroup.mem_centralizer_iff.mp hy0cent b₀ (Set.mem_singleton b₀)).symm
    let Y : GL ι K := (y : GL ι ↥K₀).map (algebraMap ↥K₀ K)
    have hYfix : Y.map σ.toRingHom = Y := ggOmW3_map_subtype_fixed σ (y : GL ι ↥K₀)
    have hYmem : Y ∈ StatedOmega ⇑Φ' := by
      have h1 : ggOmW3_descendGL σ Y hYfix = (y : GL ι ↥K₀) :=
        ggOmW3_descendGL_extend σ (y : GL ι ↥K₀)
      have h2 : ggOmW3_descendGL σ Y hYfix ∈ StatedOmega ⇑Φ₀ := by
        rw [h1]
        exact hy0mem
      exact (ggOmW3_mem_statedOmega_descent σ Φ' hΦ'nd hΦ'inv h8 Y hYfix).mpr h2
    have hYcent : Y * b'' = b'' * Y := by
      have h := congrArg (fun z : GL ι ↥K₀ => z.map (algebraMap ↥K₀ K)) hy0cent'
      rw [map_mul, map_mul, hb₀GL] at h
      simpa only [Y] using h
    let G' : GL ι K := P⁻¹ * Y * P
    have hG'mem : G' ∈ StatedOmega ⇑Φ := by
      have hconj := ggOmW3_conj_mem_statedOmega Φ' (P⁻¹) Y hYmem
      have hform : ggOmW3_transformForm Φ'
          (((P⁻¹ : GL ι K)⁻¹ : GL ι K) : Matrix ι ι K) = Φ :=
        ggOmW3d_transformForm_inv_mul_eq Φ P
      rw [hform] at hconj
      simpa only [G', inv_inv] using hconj
    have hG'cent : G' * b = b * G' := by
      have hYeq : Y = P * G' * P⁻¹ := by
        rw [show G' = P⁻¹ * Y * P from rfl]
        group
      have h := hYcent
      rw [show b'' = P * b * P⁻¹ from rfl, hYeq] at h
      exact (ggOmW3d_conj_commute P G' b).mp h
    exact ⟨⟨G', hG'mem⟩, Subgroup.mem_centralizer_iff.mpr (fun z hz => by
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact hG'cent.symm)⟩
  refine Nonempty.intro ?_
  refine { toFun := phi, invFun := psi, left_inv := ?_, right_inv := ?_, map_mul' := ?_ }
  · intro g
    apply Subtype.ext
    apply Subtype.ext
    dsimp only [phi, psi]
    rw [ggOmW3_descendGL_map]
    group
  · intro y
    apply Subtype.ext
    apply Subtype.ext
    apply Matrix.GeneralLinearGroup.map_injective (f := algebraMap ↥K₀ K) hφinj
    dsimp only [phi, psi]
    rw [ggOmW3_descendGL_map]
    group
  · intro g h
    have hgmem : (g : GL ι K) ∈ StatedOmega ⇑Φ := g.1.2
    have hgcent : (g : GL ι K) ∈ Subgroup.centralizer {b} := by
      have hh : g.1 ∈ (Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype := by
        simpa only [H_L] using g.2
      exact Subgroup.mem_comap.mp hh
    have hfixg : A * (g : GL ι K).map σ.toRingHom * A⁻¹ = (g : GL ι K) :=
      hfix ⟨(g : GL ι K), hgmem⟩ (by rw [Subgroup.mem_comap]; exact hgcent)
    have hgX : (P * (g : GL ι K) * P⁻¹).map σ.toRingHom =
        P * (g : GL ι K) * P⁻¹ :=
      ggOmW3_conj_fixed_of_hfix σ A P (g : GL ι K) hP hfixg
    have hhmem : (h : GL ι K) ∈ StatedOmega ⇑Φ := h.1.2
    have hhcent : (h : GL ι K) ∈ Subgroup.centralizer {b} := by
      have hh : h.1 ∈ (Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype := by
        simpa only [H_L] using h.2
      exact Subgroup.mem_comap.mp hh
    have hfixh : A * (h : GL ι K).map σ.toRingHom * A⁻¹ = (h : GL ι K) :=
      hfix ⟨(h : GL ι K), hhmem⟩ (by rw [Subgroup.mem_comap]; exact hhcent)
    have hhX : (P * (h : GL ι K) * P⁻¹).map σ.toRingHom =
        P * (h : GL ι K) * P⁻¹ :=
      ggOmW3_conj_fixed_of_hfix σ A P (h : GL ι K) hP hfixh
    apply Subtype.ext
    apply Subtype.ext
    dsimp only [phi]
    simp only [Subgroup.coe_mul]
    have harg : P * (↑↑g * ↑↑h) * P⁻¹ =
        (P * (g : GL ι K) * P⁻¹) * (P * (h : GL ι K) * P⁻¹) := by group
    have hXY : ((P * (g : GL ι K) * P⁻¹) * (P * (h : GL ι K) * P⁻¹)).map
        σ.toRingHom =
        (P * (g : GL ι K) * P⁻¹) * (P * (h : GL ι K) * P⁻¹) := by
      rw [map_mul, hgX, hhX]
    rw [ggOmW3d_descendGL_congr σ harg _ hXY]
    exact ggOmW3d_descendGL_mul σ (P * (g : GL ι K) * P⁻¹)
      (P * (h : GL ι K) * P⁻¹) hgX hhX hXY

private lemma ggOmW3_map_pow {ι K L : Type} [Fintype ι] [DecidableEq ι] [Semiring K]
    [Semiring L] (φ : K →+* L) (M : Matrix ι ι K) (n : ℕ) :
    (M ^ n).map φ = (M.map φ) ^ n := by
  have h := map_pow (RingHom.mapMatrix φ) M n
  simpa only [RingHom.mapMatrix_apply] using h

private lemma ggOmW3_isSemisimple {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (M : Matrix ι ι K) (n : ℕ) (hn : (n : AlgebraicClosure K) ≠ 0) (hM : M ^ n = 1) :
    Module.End.IsSemisimple (Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K)))) := by
  have hfpow : (Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K)))) ^ n = 1 := by
    have h1 : (M ^ n).map (algebraMap K (AlgebraicClosure K)) = 1 := by
      rw [hM]
      exact map_one (RingHom.mapMatrix (algebraMap K (AlgebraicClosure K)))
    rw [← Matrix.toLin'_pow, ← ggOmW3_map_pow, h1]
    exact map_one (Matrix.toLinAlgEquiv' (R := AlgebraicClosure K) (n := ι))
  refine Module.End.isSemisimple_of_squarefree_aeval_eq_zero
    (p := (Polynomial.X : Polynomial (AlgebraicClosure K)) ^ n - 1) ?_ ?_
  · exact (Polynomial.X_pow_sub_one_separable_iff.mpr hn).squarefree
  · simpa [Polynomial.aeval_X, hfpow]

private lemma ggOmW3_eigDim_eq_rootMultiplicity {ι K : Type} [Fintype ι] [DecidableEq ι]
    [Field K] (M : Matrix ι ι K) (n : ℕ) (hn : (n : AlgebraicClosure K) ≠ 0)
    (hM : M ^ n = 1) (l : AlgebraicClosure K) :
    eigDim M l = ((M.charpoly).map (algebraMap K (AlgebraicClosure K))).rootMultiplicity l := by
  have hf : Module.End.IsSemisimple
      (Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K)))) :=
    ggOmW3_isSemisimple M n hn hM
  have hchar : (Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K)))).charpoly =
      (M.charpoly).map (algebraMap K (AlgebraicClosure K)) := by
    rw [Matrix.charpoly_toLin', Matrix.charpoly_map]
  unfold eigDim
  rw [← hchar, ← LinearMap.finrank_maxGenEigenspace_eq,
    Module.End.IsFinitelySemisimple.maxGenEigenspace_eq_eigenspace
      (Module.End.IsSemisimple.isFinitelySemisimple hf) l]

private noncomputable def ggOmW3_polyExp {k : Type} [Field k] (inst : DecidableEq k)
    (p : Polynomial k) : ℕ :=
  letI := inst
  (Polynomial.rootMultiplicity 1 p / 2) * (Polynomial.rootMultiplicity 1 p / 2 - 1) +
    (∑ l ∈ p.roots.toFinset.erase 1,
      Polynomial.rootMultiplicity l p * (Polynomial.rootMultiplicity l p - 1) / 2) / 2

private lemma ggOmW3_blockExp_eq_polyExp {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (M : Matrix ι ι K) (n : ℕ) (hn : (n : AlgebraicClosure K) ≠ 0) (hM : M ^ n = 1) :
    blockExp true M = ggOmW3_polyExp (Classical.decEq (AlgebraicClosure K))
      ((M.charpoly).map (algebraMap K (AlgebraicClosure K))) := by
  classical
  rw [blockExp, ggOmW3_polyExp]
  simp only [if_true]
  congr 1
  · rw [ggOmW3_eigDim_eq_rootMultiplicity M n hn hM 1]
  · congr 1
    exact Finset.sum_congr rfl fun l _ => by
      rw [ggOmW3_eigDim_eq_rootMultiplicity M n hn hM l]

private lemma ggOmW3e_rank_eq_finrank_range_toLin' {F : Type} [Field F] {m n : Type}
    [Fintype m] [Fintype n] [DecidableEq n] (M : Matrix m n F) :
    M.rank = Module.finrank F (LinearMap.range (Matrix.toLin' M)) := by
  rw [Matrix.rank_eq_finrank_range_toLin M (Pi.basisFun F m) (Pi.basisFun F n),
    Matrix.toLin_eq_toLin']

private lemma ggOmW3e_eigDim_eq_card_sub_rank {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (M : Matrix ι ι K) (l : AlgebraicClosure K) :
    eigDim M l = Fintype.card ι -
      (M.map (algebraMap K (AlgebraicClosure K)) - l • 1).rank := by
  unfold eigDim
  rw [Module.End.eigenspace_def]
  have hdim : Module.finrank (AlgebraicClosure K) (ι → AlgebraicClosure K) =
      Fintype.card ι := Module.finrank_fintype_fun_eq_card (AlgebraicClosure K)
  have hlin : Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K)) - l • 1) =
      Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K))) - l • 1 := by
    change (Matrix.toLinAlgEquiv' (R := AlgebraicClosure K) (n := ι))
        (M.map (algebraMap K (AlgebraicClosure K)) - l • 1) =
      (Matrix.toLinAlgEquiv' (R := AlgebraicClosure K) (n := ι))
        (M.map (algebraMap K (AlgebraicClosure K))) - l • 1
    rw [map_sub, map_smul, map_one]
  rw [← hlin, ggOmW3e_rank_eq_finrank_range_toLin']
  have hrn := LinearMap.finrank_range_add_finrank_ker
    (Matrix.toLin' (M.map (algebraMap K (AlgebraicClosure K)) - l • 1))
  omega

private lemma ggOmW3e_eigDim_map_algHom {ι F K : Type} [Fintype ι] [DecidableEq ι] [Field F]
    [Field K] [Algebra F K] (ee : AlgebraicClosure F →+* AlgebraicClosure K)
    (hcomm : ∀ x, ee (algebraMap F (AlgebraicClosure F) x) =
      algebraMap F (AlgebraicClosure K) x)
    (M : Matrix ι ι F) (l : AlgebraicClosure F) :
    eigDim (M.map (algebraMap F K)) (ee l) = eigDim M l := by
  rw [ggOmW3e_eigDim_eq_card_sub_rank, ggOmW3e_eigDim_eq_card_sub_rank]
  congr 1
  have hmap : (M.map (algebraMap F K)).map (algebraMap K (AlgebraicClosure K)) =
      (M.map (algebraMap F (AlgebraicClosure F))).map ee := by
    rw [Matrix.map_map, Matrix.map_map]
    congr 1
    ext x
    exact (hcomm x).symm
  rw [hmap]
  have hsub : (M.map (algebraMap F (AlgebraicClosure F))).map ee - ee l • 1 =
      (M.map (algebraMap F (AlgebraicClosure F)) - l • 1).map ee := by
    rw [Matrix.map_sub (f := ⇑ee) (fun a b => map_sub ee a b),
      Matrix.map_smul' ee l _ (map_mul ee),
      Matrix.map_one (f := ⇑ee) (map_zero ee) (map_one ee)]
  rw [hsub]
  exact CFSG.RankThree.PartOne.FieldFix.rank_map_eq ee _

private lemma ggOmW3e_blockExp_map_general {ι F K : Type} [Fintype ι] [DecidableEq ι] [Field F]
    [Field K] [Algebra F K] (M : Matrix ι ι F) :
    blockExp true (M.map (algebraMap F K)) = blockExp true M := by
  classical
  let eeA : AlgebraicClosure F →ₐ[F] AlgebraicClosure K := IsAlgClosed.lift
  let ee : AlgebraicClosure F →+* AlgebraicClosure K := eeA
  have hcomm : ∀ x, ee (algebraMap F (AlgebraicClosure F) x) =
      algebraMap F (AlgebraicClosure K) x := fun x => eeA.commutes x
  have hcomp : (algebraMap K (AlgebraicClosure K)).comp (algebraMap F K) =
      ee.comp (algebraMap F (AlgebraicClosure F)) := by
    ext x
    exact (hcomm x).symm
  have hchar : ((M.map (algebraMap F K)).charpoly).map (algebraMap K (AlgebraicClosure K)) =
      ((M.charpoly).map (algebraMap F (AlgebraicClosure F))).map ee := by
    rw [Matrix.charpoly_map, Polynomial.map_map, hcomp, ← Polynomial.map_map]
  have hsplit : (((M.charpoly).map (algebraMap F (AlgebraicClosure F))).map ee).roots =
      ((M.charpoly).map (algebraMap F (AlgebraicClosure F))).roots.map ee :=
    Polynomial.Splits.roots_map (IsAlgClosed.splits _) ee
  have hrootset : ((((M.map (algebraMap F K)).charpoly).map
        (algebraMap K (AlgebraicClosure K))).roots.toFinset).erase 1 =
      ((((M.charpoly).map (algebraMap F (AlgebraicClosure F))).roots.toFinset).erase 1).image
        ee := by
    rw [hchar, hsplit, Multiset.toFinset_map, ← map_one ee,
      ← Finset.image_erase (f := ee) ee.injective _ 1]
  have heig1 : eigDim (M.map (algebraMap F K)) 1 = eigDim M 1 := by
    have h := ggOmW3e_eigDim_map_algHom ee hcomm M 1
    simpa using h
  have hsum : (∑ l ∈ ((((M.map (algebraMap F K)).charpoly).map
        (algebraMap K (AlgebraicClosure K))).roots.toFinset).erase 1,
        eigDim (M.map (algebraMap F K)) l * (eigDim (M.map (algebraMap F K)) l - 1) / 2) =
      (∑ l ∈ ((((M.charpoly).map (algebraMap F (AlgebraicClosure F))).roots.toFinset).erase 1),
        eigDim M l * (eigDim M l - 1) / 2) := by
    rw [hrootset, Finset.sum_image]
    · refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [ggOmW3e_eigDim_map_algHom ee hcomm M l]
    · intro x _ y _ hxy
      exact ee.injective hxy
  rw [blockExp, blockExp]
  simp only [if_true]
  rw [heig1, hsum]

private lemma ggOmW3_blockExp_conj {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (X M : GL ι K) (n : ℕ) (hn : (n : AlgebraicClosure K) ≠ 0) (hM : M ^ n = 1) :
    blockExp true ((X * M * X⁻¹ : GL ι K) : Matrix ι ι K) =
      blockExp true (M : Matrix ι ι K) := by
  classical
  have hconj : (X * M * X⁻¹ : GL ι K) ^ n = 1 := by
    have h := map_pow (MulAut.conj X) M n
    rw [hM, map_one, MulAut.conj_apply] at h
    exact h.symm
  have hMK : ((X * M * X⁻¹ : GL ι K) : Matrix ι ι K) ^ n = 1 := by
    rw [← Units.val_pow_eq_pow_val, hconj, Units.val_one]
  have hMmat : (M : Matrix ι ι K) ^ n = 1 := by
    rw [← Units.val_pow_eq_pow_val, hM, Units.val_one]
  have hchar : ((X * M * X⁻¹ : GL ι K) : Matrix ι ι K).charpoly =
      (M : Matrix ι ι K).charpoly := by
    have hcoe : ((X * M * X⁻¹ : GL ι K) : Matrix ι ι K) =
        (X : Matrix ι ι K) * (M : Matrix ι ι K) * ((X⁻¹ : GL ι K) : Matrix ι ι K) := by
      simp only [Units.val_mul]
    rw [hcoe]
    calc ((X : Matrix ι ι K) * (M : Matrix ι ι K) * ((X⁻¹ : GL ι K) : Matrix ι ι K)).charpoly
        = (((X⁻¹ : GL ι K) : Matrix ι ι K) *
            ((X : Matrix ι ι K) * (M : Matrix ι ι K))).charpoly :=
          Matrix.charpoly_mul_comm _ _
      _ = (M : Matrix ι ι K).charpoly := by
          rw [← Matrix.mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mul]
  rw [ggOmW3_blockExp_eq_polyExp ((X * M * X⁻¹ : GL ι K) : Matrix ι ι K) n hn hMK,
    ggOmW3_blockExp_eq_polyExp (M : Matrix ι ι K) n hn hMmat, hchar]

private lemma ggOmW3_cast_orderOf_ne_zero {K : Type} [Field K] [CharP K 2] {n : ℕ}
    (h : Odd n) : (n : AlgebraicClosure K) ≠ 0 := by
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  intro h0
  have h2 : (2 : ℕ) ∣ n := (CharP.cast_eq_zero_iff (AlgebraicClosure K) 2 n).mp h0
  exact (Nat.not_even_iff_odd.mpr h) (even_iff_two_dvd.mpr h2)

private lemma ggOmW3_orderOf_conj {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (X Y : GL ι K) : orderOf (X * Y * X⁻¹) = orderOf Y := by
  have h : SemiconjBy X Y (X * Y * X⁻¹) := by
    rw [SemiconjBy]
    group
  exact (SemiconjBy.orderOf_eq X h).symm

private lemma ggOmW3_orderOf_descendGL {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (X : GL ι K) (hX : X.map σ.toRingHom = X) :
    orderOf (ggOmW3_descendGL σ X hX) = orderOf X := by
  let Y : GL ι ↥(fixedField K σ) := ggOmW3_descendGL σ X hX
  have hYmap : Y.map (algebraMap ↥(fixedField K σ) K) = X :=
    ggOmW3_descendGL_map σ X hX
  change orderOf Y = orderOf X
  apply Nat.dvd_antisymm
  · rw [orderOf_dvd_iff_pow_eq_one]
    apply Matrix.GeneralLinearGroup.map_injective (f := algebraMap ↥(fixedField K σ) K)
      (algebraMap ↥(fixedField K σ) K).injective
    rw [map_pow, hYmap, pow_orderOf_eq_one, map_one]
  · rw [orderOf_dvd_iff_pow_eq_one]
    rw [← hYmap, ← map_pow, pow_orderOf_eq_one, map_one]

private lemma ggOmW3_blockExp_descent {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (σ : K ≃+* K) (b'' : GL ι K)
    (b₀ : GL ι ↥(fixedField K σ))
    (hb₀ : (b₀ : Matrix ι ι ↥(fixedField K σ)).map (algebraMap ↥(fixedField K σ) K)
      = (b'' : Matrix ι ι K))
    :
    blockExp true (b'' : Matrix ι ι K) =
      blockExp true (b₀ : Matrix ι ι ↥(fixedField K σ)) := by
  have h := ggOmW3e_blockExp_map_general (F := ↥(fixedField K σ)) (K := K)
    (b₀ : Matrix ι ι ↥(fixedField K σ))
  rw [hb₀] at h
  exact h

theorem descent_centralizer_Omega {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K] [Fintype K]
    [CharP K 2] (σ : K ≃+* K) (hσ : σ ≠ RingEquiv.refl K) (hσ2 : ∀ x, σ (σ x) = x)
    (Φ : QuadraticForm K (ι → K)) (hΦ : (QuadraticMap.polarBilin Φ).Nondegenerate)
    (h8 : 8 ≤ Fintype.card ι) (A : GL ι K)
    (hAΦ : ∀ v : ι → K, Φ ((A : Matrix ι ι K) *ᵥ fun i => σ (v i)) = σ (Φ v))
    (hAA : A * A.map σ.toRingHom = 1) (b : GL ι K) (hb : b ∈ StatedOmega ⇑Φ)
    (hodd : Odd (orderOf b))
    (hfix : ∀ g ∈ (Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype,
      A * (g : GL ι K).map σ.toRingHom * A⁻¹ = g) :
    ∃ (K₀ : Type) (_ : Field K₀) (_ : Fintype K₀) (_ : CharP K₀ 2)
      (Φ₀ : QuadraticForm K₀ (ι → K₀)) (b₀ : GL ι K₀),
      (QuadraticMap.polarBilin Φ₀).Nondegenerate ∧ b₀ ∈ StatedOmega ⇑Φ₀ ∧ Odd (orderOf b₀) ∧
      Fintype.card K = Fintype.card K₀ ^ 2 ∧
      Nonempty (↥((Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype) ≃*
        ↥((Subgroup.centralizer {b₀}).comap (StatedOmega ⇑Φ₀).subtype)) ∧
      blockExp true (b : Matrix ι ι K) = blockExp true (b₀ : Matrix ι ι K₀) := by
  classical
  haveI : Finite K := Finite.of_fintype K
  obtain ⟨P, hP⟩ := ggOmW3_hilbert90 σ hσ hσ2 A hAA
  let K₀ : Subfield K := fixedField K σ
  haveI : Fintype ↥K₀ := Fintype.ofFinite ↥K₀
  haveI : CharP ↥K₀ 2 := ggOmW3_charP_fixedField (K := K) σ
  let Qm : Matrix ι ι K := ((P⁻¹ : GL ι K) : Matrix ι ι K)
  let Φ' : QuadraticForm K (ι → K) := ggOmW3_transformForm Φ Qm
  have hΦ'inv : ∀ w : ι → K, Φ' (fun i => σ (w i)) = σ (Φ' w) :=
    ggOmW3_transformForm_semilinear σ Φ A hAΦ P hP
  let Φ₀ : QuadraticForm ↥K₀ (ι → ↥K₀) := ggOmW3_descendForm σ Φ' hΦ'inv
  have hΦ'nd : (QuadraticMap.polarBilin Φ').Nondegenerate :=
    ggOmW3_transformForm_nondegenerate Φ P⁻¹ hΦ
  have hΦ₀nd : (QuadraticMap.polarBilin Φ₀).Nondegenerate :=
    ggOmW3_descendForm_nondegenerate σ Φ' hΦ'inv hΦ'nd
  have hfixb : A * (b : GL ι K).map σ.toRingHom * A⁻¹ = b :=
    hfix ⟨b, hb⟩ (by
      rw [Subgroup.mem_comap]
      exact Subgroup.mem_centralizer_iff.mpr (fun x hx => by
        rw [Set.mem_singleton_iff] at hx
        subst hx
        rfl))
  let b'' : GL ι K := P * b * P⁻¹
  have hb''fix : b''.map σ.toRingHom = b'' :=
    ggOmW3_conj_fixed_of_hfix σ A P b hP hfixb
  let b₀ : GL ι ↥K₀ := ggOmW3_descendGL σ b'' hb''fix
  have hb₀map : (b₀ : Matrix ι ι ↥K₀).map (algebraMap ↥K₀ K) = (b'' : Matrix ι ι K) :=
    ggOmW3_descendGL_mapM σ b'' hb''fix
  have hb''mem : b'' ∈ StatedOmega ⇑Φ' := ggOmW3_conj_mem_statedOmega Φ P b hb
  have hb₀mem : b₀ ∈ StatedOmega ⇑Φ₀ :=
    (ggOmW3_mem_statedOmega_descent σ Φ' hΦ'nd hΦ'inv h8 b'' hb''fix).mp hb''mem
  have hodd'' : Odd (orderOf b'') := by
    rw [show b'' = P * b * P⁻¹ from rfl, ggOmW3_orderOf_conj]
    exact hodd
  have hodd₀ : Odd (orderOf b₀) := by
    rw [ggOmW3_orderOf_descendGL σ b'' hb''fix]
    exact hodd''
  have hcard : Fintype.card K = Fintype.card ↥K₀ ^ 2 := by
    have h := ggOmW3_card_fixedField σ hσ hσ2
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card] at h
    exact h
  have hiso : Nonempty (↥((Subgroup.centralizer {b}).comap (StatedOmega ⇑Φ).subtype) ≃*
      ↥((Subgroup.centralizer {b₀}).comap (StatedOmega ⇑Φ₀).subtype)) :=
    ggOmW3_centralizer_equiv σ Φ hΦ h8 A hAΦ b hb hodd hfix P hP b₀ hb₀map
  have hblock : blockExp true (b : Matrix ι ι K) = blockExp true (b₀ : Matrix ι ι ↥K₀) := by
    have h1 : blockExp true (b : Matrix ι ι K) = blockExp true (b'' : Matrix ι ι K) := by
      rw [show b'' = P * b * P⁻¹ from rfl]
      exact (ggOmW3_blockExp_conj P b (orderOf b)
        (ggOmW3_cast_orderOf_ne_zero hodd) (pow_orderOf_eq_one b)).symm
    exact h1.trans (ggOmW3_blockExp_descent σ b'' b₀ hb₀map)
  exact ⟨↥K₀, inferInstance, inferInstance, inferInstance, Φ₀, b₀, hΦ₀nd, hb₀mem, hodd₀,
    hcard, hiso, hblock⟩

