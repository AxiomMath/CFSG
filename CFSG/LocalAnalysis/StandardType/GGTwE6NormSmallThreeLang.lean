theorem exists_endNode_lang {K : Type} [Field K] [Finite K] {n : ℕ}
    (hK : Nat.card K = (2 ^ n) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ n)
    {A : Subgroup (ModGL TwistTag.E6.tag K)}
    (D : CFSG.LieType.SeitzGeneration.ExcWideThree.TwLangData K σ (2 ^ n) A) (hc : D.c = 1)
    (hv : ∀ γ, D.v • permLattice TwistTag.E6.perm γ = -γ)
    {t : ModGL TwistTag.E6.tag K} (htA : t ∈ A) (ht : t ∈ twistedE6InndiagGL K σ)
    (ht3 : t ^ 3 = 1) (ht1 : t ≠ 1) {β : MulAut ↥(twistedE6RootGroup K σ)}
    (hβ : ∀ c, ((β c : ↥(twistedE6RootGroup K σ)) : ModGL TwistTag.E6.tag K) = t * c * t⁻¹)
    {Q : Subgroup ↥(twistedE6RootGroup K σ)}
    (hQ : IsComponentOf Q (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup β)) :
    ∃ (S : LangSetup TwistTag.E6.tag (AlgebraicClosure K) 5)
      (ι : ↥(twistedE6RootGroup K σ) →* ModGL TwistTag.E6.tag (AlgebraicClosure K))
      (aT : Fin TwistTag.E6.tag.rank → (AlgebraicClosure K)ˣ)
      (i : KernelComponent (rootCharHom aT)),
      S.D = LangDatum.ofTwist TwistTag.E6 D.Fr (2 ^ n) D.hFr D.v D.hg0C D.hg0 ∧
      Function.Injective ι ∧ ι.range = S.Γ ∧
      (∀ c : ↥(twistedE6RootGroup K σ), ι c = D.g0⁻¹ *
        baseChangeGL (algebraMap K (AlgebraicClosure K)) (c : ModGL TwistTag.E6.tag K) * D.g0) ∧
      rootDiagUnit TwistTag.E6.tag aT =
        D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) t * D.g0 ∧
      (∀ γ, IsRoot TwistTag.E6.tag γ → S.ρ γ = -γ) ∧
      Q.map ι = rationalComponent S.ρ S.Γ (rootCharHom aT) i := by
  haveI : CharP K 2 := by
    have := Fintype.ofFinite K
    exact charP_of_card_eq_prime_pow (f := n * 2) (by rw [← Nat.card_eq_fintype_card, hK, pow_mul])
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  obtain ⟨φ, hφ⟩ : ∃ φ : ModGL TwistTag.E6.tag K →* ModGL TwistTag.E6.tag (AlgebraicClosure K),
      φ = (MulAut.conj D.g0⁻¹).toMonoidHom.comp
        (baseChangeGL (algebraMap K (AlgebraicClosure K))) := ⟨_, rfl⟩
  have hφx : ∀ x, φ x = D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) x * D.g0 :=
    fun x => by rw [hφ]; simp
  have hφi : Function.Injective φ := by
    rw [hφ]
    exact (MulAut.conj D.g0⁻¹).injective.comp (baseChangeGL_injective _)
  obtain ⟨t', ht', htt'⟩ := D.hc t htA
  obtain ⟨aT, rfl⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup
    (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 ht').1
  have hta : D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) t * D.g0 =
      rootDiagUnit TwistTag.E6.tag aT := by
    rw [hc, one_mul, inv_one, mul_one] at htt'
    rw [← htt', MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  obtain ⟨S, ι, -, -, hT, hι, hrange, hconj, hιc, hρ, hSD⟩ :=
    TwE6D5Core.exists_langSetup_of_twE6Frame σ hK hσ (ringChar.eq K 2) D.hFr D.hg0C D.hg0 ht hta
  have hβ' : ∀ c, ι (β c) = rootDiagUnit Tag.E6 aT * ι c * (rootDiagUnit Tag.E6 aT)⁻¹ := fun c =>
    (congrArg ι (Subtype.ext ((hβ c).trans (twistedE6InndiagConj_apply ⟨t, ht⟩ c).symm))).trans
      (hconj c)
  have hd3 : rootDiagUnit TwistTag.E6.tag aT ^ 3 = 1 := by
    rw [← hta, ← hφx, ← map_pow, ht3, map_one]
  have h1 : rootDiagUnit TwistTag.E6.tag aT ≠ 1 := by
    rw [← hta, ← hφx]
    exact fun h => ht1 (hφi (h.trans (map_one φ).symm))
  have hap : ∀ i, aT i ^ 3 = 1 := by
    have hpow : rootDiagUnit TwistTag.E6.tag (aT ^ 3) = rootDiagUnit TwistTag.E6.tag aT ^ 3 :=
      (rootDiagUnitHom TwistTag.E6.tag (AlgebraicClosure K)).map_pow aT 3
    have h : aT ^ 3 = 1 := CFSG.LieType.Chevalley.rootDiagUnit_injective
      (by rw [hpow, hd3, CFSG.LieType.Chevalley.rootDiagUnit_one])
    exact fun i => congrFun h i
  have hpL : ((3 : ℕ) : AlgebraicClosure K) ≠ 0 := fun h => by
    have := (CharP.cast_eq_zero_iff (AlgebraicClosure K) 2 3).1 h
    omega
  obtain ⟨i, -, hQi⟩ := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.components_of_langSetup S
    Nat.prime_three ι hι hrange β hβ' hT hap h1
    (CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.langSetup_hTame_of_prime S
      Nat.prime_three hpL (fun h => absurd h (by decide)) hT hap h1) hQ
  exact ⟨S, ι, aT, i, hSD, hι, hrange, hιc, hta.symm, fun γ hγ => (hρ γ hγ).trans (hv γ), hQi⟩

end CFSG.StandardType.TwE6NormThree

