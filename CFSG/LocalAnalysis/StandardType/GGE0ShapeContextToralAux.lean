theorem realization_of_model
    {G : Type} [Group G] {G0 : Subgroup G}
    {C : Type} [Group C] {I_C : Subgroup (MulAut C)}
    {Ω : Type} [Field Ω] [IsAlgClosed Ω]
    {S : LangSetup Tag.E6 Ω 5} (e : C ≃* S.Γ) (Θ : C ≃* G0)
    (act : I_C →* ModGL Tag.E6 Ω)
    (hact_mem : ∀ φ, act φ ∈ S.D.model)
    (hact_inj : Function.Injective act)
    (hinn : (MulAut.conj : C →* MulAut C).range ≤ I_C)
    (hinn_act : ∀ c, act ⟨MulAut.conj c, hinn ⟨c, rfl⟩⟩ = (e c : ModGL Tag.E6 Ω))
    (hcompat : ∀ (φ : I_C) (x : C), e (φ.1 x) = act φ * e x * (act φ)⁻¹) :
    ∃ (I : Subgroup (MulAut G0)) (R : ShapeRealization G0 I Ω),
      R.setup = S ∧
      (∀ x : C, (R.groupEquiv (Θ x) : ModGL Tag.E6 Ω) = (e x : ModGL Tag.E6 Ω)) ∧
      (∀ φ : I_C, ∃ ψ : I, R.action ψ = act φ ∧ ∀ x : C, ψ.1 (Θ x) = Θ (φ.1 x)) := by
  classical
  let f : MulAut C →* MulAut G0 := (MulAut.congr Θ).toMonoidHom
  have hf : Function.Injective f := (MulAut.congr Θ).injective
  let I : Subgroup (MulAut G0) := I_C.map f
  let eI : I_C ≃* I := I_C.equivMapOfInjective f hf
  let act' : I →* ModGL Tag.E6 Ω := act.comp eI.symm.toMonoidHom
  have hcongr_conj : ∀ c : C, MulAut.congr Θ (MulAut.conj c) = MulAut.conj (Θ c) := by
    intro c
    ext x
    simp only [MulAut.congr_apply, MulEquiv.trans_apply, MulAut.conj_apply, map_mul, map_inv,
      MulEquiv.apply_symm_apply]
  have hmemI : ∀ φ : I_C, f φ ∈ I := fun φ => Subgroup.mem_map_of_mem f φ.2
  have hfconj : ∀ c : C, f (MulAut.conj c) = MulAut.conj (Θ c) := by
    intro c
    change MulAut.congr Θ (MulAut.conj c) = MulAut.conj (Θ c)
    exact hcongr_conj c
  have hinner_le : (MulAut.conj : G0 →* MulAut G0).range ≤ I := by
    rintro _ ⟨c, rfl⟩
    refine Subgroup.mem_map.mpr ⟨MulAut.conj (Θ.symm c), hinn ⟨Θ.symm c, rfl⟩, ?_⟩
    rw [hfconj, MulEquiv.apply_symm_apply]
  refine ⟨I, ⟨ShapeRealization.mk S (Θ.symm.trans e) act' ?_ ?_ hinner_le ?_ ?_,
      rfl, ?_, ?_⟩⟩
  · intro x y hxy
    exact eI.symm.injective (hact_inj hxy)
  · intro φ
    exact hact_mem (eI.symm φ)
  · intro c
    have hpre : eI ⟨MulAut.conj (Θ.symm c), hinn ⟨Θ.symm c, rfl⟩⟩ =
        ⟨MulAut.conj c, hinner_le ⟨c, rfl⟩⟩ := by
      ext x
      rw [Subgroup.coe_equivMapOfInjective_apply]
      simp only [hfconj, MulEquiv.apply_symm_apply]
    have hsymm : eI.symm ⟨MulAut.conj c, hinner_le ⟨c, rfl⟩⟩ =
        ⟨MulAut.conj (Θ.symm c), hinn ⟨Θ.symm c, rfl⟩⟩ := by
      rw [← hpre, MulEquiv.symm_apply_apply]
    change act' ⟨MulAut.conj c, hinner_le ⟨c, rfl⟩⟩ = (e (Θ.symm c) : ModGL Tag.E6 Ω)
    rw [show act' ⟨MulAut.conj c, hinner_le ⟨c, rfl⟩⟩ =
      act (eI.symm ⟨MulAut.conj c, hinner_le ⟨c, rfl⟩⟩) from rfl, hsymm]
    rw [hinn_act]
  · intro φ x
    let φ₀ : I_C := eI.symm φ
    have hφ : eI φ₀ = φ := MulEquiv.apply_symm_apply eI φ
    have hφ1 : (φ.1 : MulAut G0) x = Θ (φ₀.1 (Θ.symm x)) := by
      rw [← hφ]
      change (MulAut.congr Θ φ₀.1) x = Θ (φ₀.1 (Θ.symm x))
      rw [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply]
    have hactφ : act' φ = act φ₀ := rfl
    change (e (Θ.symm (φ.1 x)) : ModGL Tag.E6 Ω) =
      act' φ * (e (Θ.symm x) : ModGL Tag.E6 Ω) * (act' φ)⁻¹
    rw [hφ1, MulEquiv.symm_apply_apply, hactφ, hcompat φ₀ (Θ.symm x)]
  · intro x
    simp only [MulEquiv.trans_apply, MulEquiv.symm_apply_apply]
  · intro φ
    refine ⟨eI φ, ?_, ?_⟩
    · change act (eI.symm (eI φ)) = act φ
      rw [MulEquiv.symm_apply_apply]
    · intro x
      change ((eI φ).1 : MulAut G0) (Θ x) = Θ (φ.1 x)
      change (MulAut.congr Θ φ.1) (Θ x) = Θ (φ.1 x)
      rw [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply,
        MulEquiv.symm_apply_apply]

theorem contextImage_le_of_conj
    {G C Ω : Type} [Group G] [Group C] [Field Ω] [IsAlgClosed Ω]
    {G0 H : Subgroup G} {I_C : Subgroup (MulAut C)} {I : Subgroup (MulAut G0)}
    (Θ : C ≃* G0) (Φ : Subgroup.normalizer (G0 : Set G) →* MulAut C)
    (hΦ : ∀ m y, (Θ (Φ m y) : G) = (m : G) * Θ y * (m : G)⁻¹)
    (hΦH : ∀ c : Subgroup.normalizer (G0 : Set G), (c : G) ∈ H → Φ c ∈ I_C)
    (R : ShapeRealization G0 I Ω) (act : I_C →* ModGL Tag.E6 Ω)
    (hR : ∀ φ : I_C, ∃ ψ : I, R.action ψ = act φ ∧ ∀ x : C, ψ.1 (Θ x) = Θ (φ.1 x)) :
    contextImage G0 H ≤ I := by
  intro φ hφ
  rw [contextImage, Subgroup.mem_map] at hφ
  simp only [Subgroup.mem_comap] at hφ
  obtain ⟨n, hn, rfl⟩ := hφ
  obtain ⟨ψ, _, hψ⟩ := hR ⟨Φ n, hΦH n hn⟩
  have hψeq : ψ = Subgroup.normalizerMonoidHom G0 n := by
    ext y
    obtain ⟨x, rfl⟩ := Θ.surjective y
    rw [hψ x, hΦ n x, Subgroup.normalizerMonoidHom_apply_apply_coe]
  rw [← hψeq]
  exact ψ.2

theorem realizedSubgroup_isElemAbelian
    {G : Type} [Group G] {G0 H : Subgroup G}
    {I : Subgroup (MulAut G0)} {Ω : Type} [Field Ω] [IsAlgClosed Ω]
    (R : ShapeRealization G0 I Ω)
    (hAel : IsElemAbelian 3 H) :
    IsElemAbelian 3 (realizedSubgroup R (contextImage G0 H)) := by
  change IsElemAbelian 3 ((contextImage G0 H).comap I.subtype |>.map R.action)
  have h1 : IsElemAbelian 3 (contextImage G0 H) := by
    rw [contextImage]
    exact (hAel.subgroupOf (Subgroup.normalizer (G0 : Set G))).map
      (Subgroup.normalizerMonoidHom G0)
  exact (h1.comap (Subgroup.subtype_injective I)).map R.action

theorem modelHom_mem_innerDiag_e6
    {G : Type} [Group G] [Finite G] {n f : ℕ} {ψ : (ggU .E6 n f).K →* G}
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    (hctx : GGSixCtxV2 3 B Bs x L D J (ggU .E6 n f).D .E6 n f ψ)
    (s1 : GGSixStepOne 3 B Bs x L D J) :
    ∀ (Θ : adjointGroup .E6 (GaloisField 2 f) ≃* ggG0 3 B x L D J)
      (Φ : Subgroup.normalizer (ggG0 3 B x L D J : Set G) →* MulAut
        (adjointGroup .E6 (GaloisField 2 f))),
      (∀ u, (Θ (CFSG.LieType.Steinberg.Isogeny.e6Isogeny (GaloisField 2 f) u) : G) = ψ u) →
      (∀ m y, (Θ (Φ m y) : G) = (m : G) * Θ y * (m : G)⁻¹) →
      ∀ c : Subgroup.normalizer (ggG0 3 B x L D J : Set G),
        (c : G) ∈ ggG1 ψ → Φ c ∈
          (MulAut.conj : adjointGroup .E6 (GaloisField 2 f) →*
            MulAut (adjointGroup .E6 (GaloisField 2 f))).range ⊔
          (AutSt.e6DiagHom (GaloisField 2 f)).range := by
  intro Θ Φ hΘ hΦ c hc
  have hC' : Subgroup.centralizer (ψ.range : Set G) = ⊥ := by
    rw [hctx.range_eq]; exact s1.1
  have hψ : ψ.ker = Subgroup.center (ggU .E6 n f).K :=
    ggOuterInv_ker_eq_center_of_centralizer ψ hctx.2.2.2.2.1.2 hC'
  obtain ⟨φ, hφI, hφ⟩ := ggOuterInv_e6Marking ψ hψ hc.2
  suffices Φ c = φ by rw [this]; exact hφI
  apply MulEquiv.ext
  intro y
  obtain ⟨u, rfl⟩ := CFSG.LieType.Steinberg.Isogeny.e6Isogeny_surjective (GaloisField 2 f) y
  obtain ⟨u', hu'⟩ : (c : G) * ψ u * (c : G)⁻¹ ∈ ψ.range :=
    (Subgroup.mem_normalizer_iff.mp (by rw [hctx.range_eq]; exact c.2) (ψ u)).mp ⟨u, rfl⟩
  rw [hφ u u' hu'.symm]
  exact Θ.injective (Subtype.ext (by rw [hΦ, hΘ u, hΘ u', hu']))
theorem modelHom_mem_innerDiag_twE6
    {G : Type} [Group G] [Finite G] {n f : ℕ} {ψ : (ggU .twistedE6 n f).K →* G}
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    (hctx : GGSixCtxV2 3 B Bs x L D J (ggU .twistedE6 n f).D .twistedE6 n f ψ)
    (s1 : GGSixStepOne 3 B Bs x L D J)
    (hf : 1 ≤ f)
    (hσθ : (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f).toRingHom = frobQ 2 f)
    (π : twistedE6Group 2 f →* ↥(twistedE6RootGroup (GaloisField 2 (2 * f))
      (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f)))
    (hπ : Function.Surjective π)
    (hπker : π.ker = Subgroup.center (twistedE6Group 2 f))
    (hπvalT : ∀ z, ((π z : twistedE6RootGroup (GaloisField 2 (2 * f))
      (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f)) :
        ModGL TwistTag.E6.tag (GaloisField 2 (2 * f))) =
      ((e6IsogenyT (GaloisField 2 (2 * f))
        (z : e6Data_valid.minGroup (GaloisField 2 (2 * f))) :
        adjointGroup TwistTag.E6.tag (GaloisField 2 (2 * f))) :
          ModGL TwistTag.E6.tag (GaloisField 2 (2 * f))))
    (Θ : twistedE6RootGroup (GaloisField 2 (2 * f))
      (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f) ≃* ggG0 3 B x L D J)
    (Φ : Subgroup.normalizer (ggG0 3 B x L D J : Set G) →* MulAut
      (twistedE6RootGroup (GaloisField 2 (2 * f))
        (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f)))
    (hΘ : ∀ u, (Θ (π u) : G) = ψ u)
    (hΦ : ∀ m y, (Θ (Φ m y) : G) = (m : G) * Θ y * (m : G)⁻¹) :
    ∀ c : Subgroup.normalizer (ggG0 3 B x L D J : Set G),
      (c : G) ∈ ggG1 ψ → Φ c ∈
        twistedE6Inn (GaloisField 2 (2 * f))
          (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f) ⊔
        twistedE6Diag (GaloisField 2 (2 * f))
          (iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f) := by
  intro c hc
  have hC' : Subgroup.centralizer (ψ.range : Set G) = ⊥ := by
    rw [hctx.range_eq]; exact s1.1
  have hψ : ψ.ker = Subgroup.center (twistedE6Group 2 f) :=
    ggOuterInv_ker_eq_center_of_centralizer ψ hctx.2.2.2.2.1.2 hC'
  obtain ⟨φ, hφI, hφ⟩ := ggOuterInv_twE6Marking f hf hσθ π hπ hπker hπvalT ψ hψ hc.2
  suffices Φ c = φ by rw [this]; exact hφI
  apply MulEquiv.ext
  intro y
  obtain ⟨u, rfl⟩ := hπ y
  obtain ⟨u', hu'⟩ : (c : G) * ψ u * (c : G)⁻¹ ∈ ψ.range :=
    (Subgroup.mem_normalizer_iff.mp (by rw [hctx.range_eq]; exact c.2) (ψ u)).mp ⟨u, rfl⟩
  rw [hφ u u' hu'.symm]
  exact Θ.injective (Subtype.ext (by rw [hΦ, hΘ u, hΘ u', hu']))
