private theorem two_pow_six_dvd_card_of_psl_three {X : Type} [Group X] [Finite X] {n : ℕ}
    (hn : 2 ≤ n) (hX : LieModel X .PSL 3 2 n) : 2 ^ 6 ∣ Nat.card X := by
  have hcard : Nat.card X * Nat.gcd 3 (2 ^ n - 1) =
      (2 ^ n) ^ 3 * ((2 ^ n) ^ 2 - 1) * ((2 ^ n) ^ 3 - 1) := by
    rw [CFSG.GH74.card_of_lieModel_PSL (by norm_num) hX]
    simpa only [show 3 - 1 = 2 from rfl, mul_assoc] using
      CFSG.LocalAnalysis.UniquenessCase.UC6.N588.ordA_two_mul_gcd (2 ^ n)
  have hg : Nat.gcd 3 (2 ^ n - 1) ∣ 3 := Nat.gcd_dvd_left _ _
  have hcop : Nat.Coprime (2 ^ 6) (Nat.gcd 3 (2 ^ n - 1)) :=
    (by norm_num : Nat.Coprime (2 ^ 6) 3).coprime_dvd_right hg
  apply hcop.dvd_of_dvd_mul_right
  rw [hcard]
  have hp : 2 ^ 6 ∣ (2 ^ n) ^ 3 := by
    rw [← pow_mul]
    exact pow_dvd_pow 2 (by omega)
  exact (dvd_mul_of_dvd_left hp _).mul_right _
