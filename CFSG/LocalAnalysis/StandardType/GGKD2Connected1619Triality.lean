theorem triality_classicalModelAction
    {K : Type} [Field K] [Finite K] {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ n) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (2 ^ n)) :
    ClassicalModelAction (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) := by
  intro z hz1 hz3 C hC hlab x hzx _
  have h3q : ¬ 3 ∣ 2 ^ n := by
    intro h
    have := Nat.prime_three.dvd_of_dvd_pow h
    norm_num at this
  obtain ⟨g, hA | hB⟩ := KS11Lie6Proof.d4ThreeConj_holds K (2 ^ n) σ hK hσ h3q z hz3 hz1
  all_goals
    let e : graphFixedRootGroup TwistTag.D4 K σ.toRingHom ≃*
        graphFixedRootGroup TwistTag.D4 K σ.toRingHom := MulAut.conj g
    have hez3 : (e z) ^ 3 = 1 := by rw [← map_pow, hz3, map_one]
    have hez1 : e z ≠ 1 := by
      intro h
      exact hz1 (e.injective (h.trans e.map_one.symm))
    have hCm : CFSG.Assembly.IsComponentOf (C.map e.toMonoidHom)
        (Subgroup.centralizer ({e z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) := by
      have h := CFSG.LocalAnalysis.GLTheoremA.tcent_isComponentOf_map e hC
      rwa [CFSG.LocalAnalysis.GLTheoremA.tcent_map_centralizer] at h
  · have hlabel : GGHasLabel (⟨.A, 1, 3⟩ : LargeEvenLabel)
        (↥(C.map e.toMonoidHom) ⧸ Subgroup.center ↥(C.map e.toMonoidHom)) :=
      ggHasLabel_quotCenter_of_mulEquiv
        (Subgroup.equivMapOfInjective C e.toMonoidHom e.injective) hlab
    exact (not_label_component_threeA hn hK σ hσ hA hez3 hez1 hCm hlabel).elim
  · have hex : e x ∈ Subgroup.centralizer
        ({e z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) := by
      rw [Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul, hzx]
    have hQi := quotientInner_component_threeB hn hK σ hσ hB hez3 hez1 hCm hex
    apply QuotientInner.of_map e C (MulAut.conj x) (MulAut.conj (e x)) ?_ hQi
    intro c
    simp only [MulAut.conj_apply, map_mul, map_inv]
