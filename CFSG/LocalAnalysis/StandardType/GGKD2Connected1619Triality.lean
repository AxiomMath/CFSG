theorem triality_rawActionAt {n : ℕ} (hn : 1 ≤ n) (K : Type) [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ n) ^ 3) : RawActionAt (GGTriD4R n K) (GGTriD4ID n K) := by
  have : CharP K 2 := charP_two_of_card (m := n * 3) (by rw [hK, pow_mul])
  let σ : K ≃+* K := iterateFrobeniusEquiv K 2 n
  have hσ : ∀ c, σ c = c ^ (2 ^ n) := fun c => by
    simp only [σ, iterateFrobeniusEquiv_apply, iterateFrobenius_def]
  obtain ⟨θ⟩ := TableBExcSmallRest.nonempty_triD4_equiv hn K hK σ hσ
  have hI : ∀ β ∈ GGTriD4ID n K,
      ∃ y : graphFixedRootGroup TwistTag.D4 K σ.toRingHom,
        ∀ r : GGTriD4R n K, θ (β r) = y * θ r * y⁻¹ := by
    intro β hβ
