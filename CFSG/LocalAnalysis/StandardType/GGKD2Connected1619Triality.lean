private theorem not_label_component_threeA
    {K : Type} [Field K] [Finite K] {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ n) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (2 ^ n))
    {z : graphFixedRootGroup TwistTag.D4 K σ.toRingHom}
    (hzS : z ∈ KS11Lie4Proof.d4ShortSL2 K σ.toRingHom) (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    {C : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)}
    (hC : CFSG.Assembly.IsComponentOf C (Subgroup.centralizer ({z} :
      Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)))) :
    ¬ GGHasLabel (⟨.A, 1, 3⟩ : LargeEvenLabel) (↥C ⧸ Subgroup.center ↥C) := by
  have : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
  have : Finite (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) := Subtype.finite
  obtain ⟨R, _, hRC, hcomm, hmodel⟩ := r891_threeA_model_of_conj_short hn hK σ hσ
    (MulEquiv.refl (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) hz3 hz1 1
    (by simpa only [MulEquiv.refl_apply, one_mul, inv_one, mul_one] using hzS)
  have hCR : C ≤ R := by
    rw [← ggComponent_perfect hC, Subgroup.commutator_le]
    intro a ha b hb
    rw [commutatorElement_def]
    exact hcomm a (hC.1 ha) b (hC.1 hb)
  by_cases hn1 : n = 1
  · subst n
    rcases hmodel with ⟨hev, _⟩ | ⟨_, Ω, hΩfield, hΩclosed, hΩchar, U, hU, eRU, _⟩
    · exact (by norm_num at hev)
    · let : Field Ω := hΩfield
      let : IsAlgClosed Ω := hΩclosed
      let : CharP Ω 2 := hΩchar
      obtain ⟨F, hFfield, hFfin, hF4, ⟨eUS⟩⟩ := exists_mulEquiv_statedSU_two (Ω := Ω) hU
      let : Field F := hFfield
      let : Finite F := hFfin
      have hPi : CFSG.RankThree.PartTwo.Sec4.IsSLThreePiAt ↥R (2 ^ 1) :=
        ⟨F, hFfield, hFfin,
          Or.inr ⟨by simpa using hF4, by norm_num, ⟨eRU.trans eUS⟩⟩⟩
      exact (ggComponent_not_le_of_isSolvable hC
        (FieldCentRigid82.isSolvable_of_isSLThreePiAt_two hPi) hCR).elim
  · have hn2 : 2 ≤ n := by omega
    have hmodels : CFSG.IsQuasisimple ↥R ∧
        (LieModel (↥R ⧸ Subgroup.center ↥R) .PSL 3 2 n ∨
          LieModel (↥R ⧸ Subgroup.center ↥R) .PSU 3 2 n) := by
      rcases hmodel with ⟨hev, hq, F, hFfield, hFfin, hFcard, ⟨eR⟩⟩ |
        ⟨hod, Ω, hΩfield, hΩclosed, hΩchar, U, hU, eRU, hRq⟩
      · let : Field F := hFfield
        let : Finite F := hFfin
        exact ⟨hq, Or.inl (threeCover_psl3_of_mulEquiv hn2 hev hFcard hq eR).2.2⟩
      · let : Field Ω := hΩfield
        let : IsAlgClosed Ω := hΩclosed
        let : CharP Ω 2 := hΩchar
        exact ⟨(hRq hn2).1,
          Or.inr (threeCover_psu3_of_mulEquiv hn2 hod hU (hRq hn2).1 eRU).2.2⟩
    have hEq : C = R := CFSG.LocalAnalysis.GLTheoremA.tcent_component_eq hC hRC hcomm hmodels.1
    subst C
    intro hlab
    have h8 : LieModel (↥R ⧸ Subgroup.center ↥R) .PSL 2 2 3 :=
      .inl ⟨by decide, statedClassicalModel_of_hasLabel_typeA
        (by simp [LargeEvenInLambda2]) hlab⟩
    rcases hmodels.2 with hSL | hSU
    · exact CFSG.LocalAnalysis.EvenBN.GMSK.OddBender.not_two_pow_six_dvd_card_of_lieModel_PSL_two_two_three h8
        (two_pow_six_dvd_card_of_psl_three hn2 hSL)
    · exact CFSG.LocalAnalysis.EvenBN.GMSK.not_lieModel_PSL_two_two_three_of_lieModel_PSU3 hSU h8

