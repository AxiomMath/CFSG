theorem exists_inner_on_short_of_centralizer_threeB
    {K : Type} [Field K] [Finite K] {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ n) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (2 ^ n))
    {z : graphFixedRootGroup TwistTag.D4 K σ.toRingHom}
    (hzS : z ∈ centralizer ((KS11Lie4Proof.d4ShortSL2 K σ.toRingHom :
      Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
        Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    {x : graphFixedRootGroup TwistTag.D4 K σ.toRingHom}
    (hx : x ∈ centralizer ({z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) :
    ∃ s ∈ KS11Lie4Proof.d4ShortSL2 K σ.toRingHom,
      ∀ y ∈ KS11Lie4Proof.d4ShortSL2 K σ.toRingHom, x * y * x⁻¹ = s * y * s⁻¹ := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP K 2 := finite_field_prime_power_characteristic Nat.prime_two (k := n * 3)
    (by omega) (by rw [hK, pow_mul])
  let L := AlgebraicClosure K
  have : CharP L 2 := charP_of_injective_algebraMap (algebraMap K L).injective 2
  let Fr : L →+* L := iterateFrobenius L 2 n
  have hFr : ∀ c, Fr c = c ^ (2 ^ n) := fun c => iterateFrobenius_def 2 n c
  let S : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) :=
    KS11Lie4Proof.d4ShortSL2 K σ.toRingHom
  have hsup : x ∈ S ⊔ centralizer (S : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :=
    centralizer_le_short_sup_centralizer (L := L) hn hK hσ hFr hzS hz3 hz1 hx
  have hnorm : S ≤ normalizer ((centralizer (S : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) := by
    refine le_trans ?_ (Subgroup.centralizer_le_normalizer _)
    exact Subgroup.le_centralizer_iff.mpr le_rfl
  have hprod : x ∈ (S : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) *
      ((centralizer (S : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
        Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) := by
    change x ∈ ((S ⊔ centralizer (S : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
      Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
        Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) at hsup
    rwa [Subgroup.coe_mul_of_left_le_normalizer_right S (centralizer (S : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) hnorm] at hsup
  obtain ⟨s, hs, c, hc, hsc⟩ := hprod
  refine ⟨s, hs, fun y hy => ?_⟩
  rw [← hsc]
  calc s * c * y * (s * c)⁻¹ = s * (c * y) * c⁻¹ * s⁻¹ := by group
    _ = s * (y * c) * c⁻¹ * s⁻¹ := by
      rw [← Subgroup.mem_centralizer_iff.mp hc y hy]
    _ = s * y * s⁻¹ := by group

theorem component_eq_short_of_threeB
    {K : Type} [Field K] [Finite K] {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ n) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (2 ^ n))
    {z : graphFixedRootGroup TwistTag.D4 K σ.toRingHom}
    (hzS : z ∈ centralizer ((KS11Lie4Proof.d4ShortSL2 K σ.toRingHom :
      Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
        Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    {C : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)}
    (hC : CFSG.Assembly.IsComponentOf C (centralizer ({z} :
      Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)))) :
    C = KS11Lie4Proof.d4ShortSL2 K σ.toRingHom := by
  have : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
  have : Finite (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) := Subtype.finite
  have hσ3 : σ ^ 3 = 1 := by
    ext c
    simpa [pow_succ] using ringEquiv_cube_apply_eq hK hσ c
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK, ← pow_mul]
    have h8 : 2 ^ 3 ≤ 2 ^ (n * 3) := Nat.pow_le_pow_right (by norm_num) (by omega)
    norm_num at h8 ⊢
    omega
  have hSC : KS11Lie4Proof.d4ShortSL2 K σ.toRingHom ≤
      centralizer ({z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) := by
    intro s hs
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact Subgroup.mem_centralizer_iff.mp hzS s hs
  have h3q : ¬ 3 ∣ 2 ^ n := by
    intro h
    have := Nat.prime_three.dvd_of_dvd_pow h
    norm_num at this
  have hcomm := (KS11Lie6Proof.d4ThreeBCent_holds K (2 ^ n) σ hK hσ h3q z hzS hz3 hz1).1
  exact CFSG.LocalAnalysis.GLTheoremA.tcent_component_eq hC hSC hcomm
    (KS11Lie4Proof.isQuasisimple_d4ShortSL2 hσ3 hK4)

theorem quotientInner_component_threeB
    {K : Type} [Field K] [Finite K] {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ n) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (2 ^ n))
    {z : graphFixedRootGroup TwistTag.D4 K σ.toRingHom}
    (hzS : z ∈ centralizer ((KS11Lie4Proof.d4ShortSL2 K σ.toRingHom :
      Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
        Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    {C : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)}
    (hC : CFSG.Assembly.IsComponentOf C (centralizer ({z} :
      Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))))
    {x : graphFixedRootGroup TwistTag.D4 K σ.toRingHom}
    (hx : x ∈ centralizer ({z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) :
    S2MathAs3_1619Final.QuotientInner C (MulAut.conj x) := by
  have hCS := component_eq_short_of_threeB hn hK σ hσ hzS hz3 hz1 hC
  obtain ⟨s, hs, hsin⟩ := exists_inner_on_short_of_centralizer_threeB hn hK σ hσ hzS hz3 hz1 hx
  have hsC : s ∈ C := by rwa [hCS]
  refine ⟨QuotientGroup.mk ⟨s, hsC⟩, ?_⟩
  intro c c' hcc
  have hcS : (c : graphFixedRootGroup TwistTag.D4 K σ.toRingHom) ∈
      KS11Lie4Proof.d4ShortSL2 K σ.toRingHom := hCS ▸ c.2
  have hval : (c' : graphFixedRootGroup TwistTag.D4 K σ.toRingHom) = s * c * s⁻¹ := by
    rw [← hcc, MulAut.conj_apply]
    exact hsin c hcS
  have hinside : (⟨s, hsC⟩ * c * ⟨s, hsC⟩⁻¹ : C) = c' := Subtype.ext hval.symm
  calc (c' : C ⧸ Subgroup.center C) = QuotientGroup.mk (⟨s, hsC⟩ * c * ⟨s, hsC⟩⁻¹) := by
          rw [hinside]
    _ = _ := by rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv]

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8.D4ThreeBCentralizer

