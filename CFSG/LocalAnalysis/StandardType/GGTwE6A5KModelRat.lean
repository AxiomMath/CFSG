theorem rationalComponent_eq_conj_fix_of_unitary_frame {τ : Tag} {L : Type} [Field L]
    [IsAlgClosed L] {p : ℕ} (S : LangSetup τ L p) {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus) (i : KernelComponent (rootCharHom a)) {ν : ℕ}
    {ψ : SL(ν, L) →* ModGL τ L} {σ' : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : IsSLFrame ψ σ') (hΨ : componentRoots (rootCharHom a) i = frameRoots σ')
    (π : Equiv.Perm (Fin ν)) (hπ : ∀ x y, x ≠ y → S.ρ (σ' x y) = σ' (π y) (π x))
    {r e : ℕ} (hr : r.Prime) (hchar : CharP L r) (he : 0 < e) (hq : S.D.q = r ^ e)
    (hν : 3 ≤ ν) (hνq : (ν, r ^ e) ≠ (3, 2)) :
    ∃ (σQ : L ≃+* L) (z : ModGL τ L) (W : GL (Fin ν) L), (∀ c, σQ c = c ^ S.D.q) ∧
      z ∈ adjointGroup τ L ∧ (∀ X, z * ψ X * z⁻¹ = ψ (conjSLn W X)) ∧
      ∀ g, g ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i ↔
        ∃ Y ∈ fixSubgroup (stdUnitaryEquiv (ν := ν) σQ), g = z * ψ Y * z⁻¹ := by
  classical
  haveI : CharP L r := hchar
  obtain ⟨σQ, B, -, z, hσc, -, hstd, hzmem, hz⟩ :=
    KSGen.exists_unitary_pin S hT i hν hψ hΨ π hπ hr hchar he hq
  obtain ⟨W, hW⟩ :=
    KSGen.mem_actsOn.1 (RCKRP.torusSup_le_actsOn_frame hψ (by omega) i hΨ hzmem)
  have hσc' : ∀ c, σQ c = c ^ (r ^ e) := fun c => by rw [hσc, hq]
  have hstab : ∀ γ ∈ componentRoots (rootCharHom a) i,
      S.ρ γ ∈ componentRoots (rootCharHom a) i := by
    intro γ hγ
    rw [hΨ] at hγ ⊢
    obtain ⟨x, y, hxy, rfl⟩ := hγ
    exact ⟨π y, π x, fun hyx => hxy (π.injective hyx).symm, hπ x y hxy⟩
  have hspan : rootSpan τ L (componentRoots (rootCharHom a) i) = ψ.range := by
    rw [hψ.range, hΨ]
  have hWi : ∀ X, ψ X = z * ψ (conjSLn W⁻¹ X) * z⁻¹ := fun X => by
    rw [hW, ← conjSLn_mul, mul_inv_cancel, conjSLn_one]
  have hstep : ∀ Y, S.D.step (z * ψ Y * z⁻¹) = z * ψ (stdUnitary σQ.toRingHom Y) * z⁻¹ := by
    intro Y
    rw [map_mul, map_mul, map_inv, hz, ← hstd Y]
    group
  have hker := KSGen.frame_ker_le_center hν hψ
  have hperf := Subgroup.isPerfect_iff.1
    ((stdUnitary_fixSubgroup (ν := ν) hr he σQ hσc' hν).2.1 hνq).1
  have hΓ : S.Γ ≤ S.D.model := by
    show ⁅S.D.model, S.D.model⁆ ≤ S.D.model
    exact Subgroup.commutator_le.2 fun g₁ h₁ g₂ h₂ =>
      S.D.model.mul_mem (S.D.model.mul_mem (S.D.model.mul_mem h₁ h₂) (S.D.model.inv_mem h₁))
        (S.D.model.inv_mem h₂)
  have hpart : ∀ g ∈ rationalSpan S.ρ S.Γ (rootCharHom a) i, ∃ Y : SL(ν, L),
      stdUnitary σQ.toRingHom Y * Y⁻¹ ∈ Subgroup.center SL(ν, L) ∧ g = z * ψ Y * z⁻¹ := by
    intro g hg
    obtain ⟨hg1, hg2⟩ := Subgroup.mem_inf.1 hg
    rw [KSGen.rationalRoots_eq_componentRoots S i hstab, hspan] at hg1
    obtain ⟨Y₀, rfl⟩ := hg1
    refine ⟨conjSLn W⁻¹ Y₀, ?_, hWi Y₀⟩
    have hfix : S.D.step (ψ Y₀) = ψ Y₀ := ((LangDatum.mem_model _).1 (hΓ hg2)).2
    rw [hWi Y₀, hstep] at hfix
    have h1 := mul_left_cancel (mul_right_cancel hfix)
    apply hker
    rw [MonoidHom.mem_ker, map_mul, map_inv, h1, mul_inv_cancel]
  have hζ : ∀ {ζ : SL(ν, L)}, ζ ∈ Subgroup.center SL(ν, L) → ∀ b, Commute ζ b :=
    fun hζ b => (Subgroup.mem_center_iff.1 hζ b).symm
  have hle : rationalComponent S.ρ S.Γ (rootCharHom a) i ≤
      (fixSubgroup (stdUnitaryEquiv (ν := ν) σQ)).map ((MulAut.conj z).toMonoidHom.comp ψ) := by
    refine Subgroup.commutator_le.2 fun g₁ hg₁ g₂ hg₂ => ?_
    obtain ⟨Y₁, hc₁, rfl⟩ := hpart g₁ hg₁
    obtain ⟨Y₂, hc₂, rfl⟩ := hpart g₂ hg₂
    refine ⟨⁅Y₁, Y₂⁆, ?_, ?_⟩
    · show stdUnitary σQ.toRingHom ⁅Y₁, Y₂⁆ = ⁅Y₁, Y₂⁆
      rw [map_commutatorElement, ← inv_mul_cancel_right (stdUnitary σQ.toRingHom Y₁) Y₁,
        ← inv_mul_cancel_right (stdUnitary σQ.toRingHom Y₂) Y₂]
      exact CycFamily.commutatorElement_central_mul (hζ hc₁ _) (hζ hc₁ _) (hζ hc₁ _)
        (hζ hc₂ _) (hζ hc₂ _)
    · show z * ψ ⁅Y₁, Y₂⁆ * z⁻¹ = ⁅z * ψ Y₁ * z⁻¹, z * ψ Y₂ * z⁻¹⁆
      rw [map_commutatorElement]
      simp only [commutatorElement_def]
      group
  have hψS : ∀ y, ((MulAut.conj z).toMonoidHom.comp ψ) y ∈
      rootSpan τ L (componentRoots (rootCharHom a) i) := fun y => by
    show z * ψ y * z⁻¹ ∈ _
    rw [hW, hspan]
    exact ⟨_, rfl⟩
  have hψA : ∀ y, ((MulAut.conj z).toMonoidHom.comp ψ) y ∈ adjointGroup τ L := fun y => by
    show z * ψ y * z⁻¹ ∈ _
    rw [hW]
    exact hψ.range_le_adjointGroup ⟨_, rfl⟩
  refine ⟨σQ, z, W, hσc, CFSG.LieType.AlgebraicGroups.torus_sup_rootSpan_le_adjointGroup _ hzmem,
    hW, fun g => ⟨fun hg => ?_, ?_⟩⟩
  · obtain ⟨Y, hY, rfl⟩ := hle hg
    exact ⟨Y, hY, rfl⟩
  · rintro ⟨Y, hY, rfl⟩
    exact KSGen.map_fix_le_rationalComponent S i hstab ((MulAut.conj z).toMonoidHom.comp ψ) hψS
      hψA (stdUnitary σQ.toRingHom) (fun y => hstep y) _ (fun _ hy => hy) hperf Y hY

theorem original_twistedE6_frame_fixed_normalizer
    {F : Type} [Field F] [CharP F 2] {f : ℕ}
    (hf : 1 ≤ f) (hFcard : Nat.card F = (2 ^ f) ^ 2)
    (σ : F ≃+* F) (hσ : ∀ a, σ a = a ^ (2 ^ f))
    {G₀ : Type} [Group G₀]
    (eF : G₀ ≃* twistedE6RootGroup F σ)
    (c : twistedE6InndiagGL F σ) :
    let Ω := AlgebraicClosure F
    letI : CharP Ω 2 := charP_of_injective_algebraMap
      (algebraMap F (AlgebraicClosure F)).injective 2
    let iF : F →+* Ω := algebraMap F Ω
    let Fbar : Subfield Ω := iF.fieldRange
    let σQ : Ω ≃+* Ω := iterateFrobeniusEquiv Ω 2 f
    let Ψ : ModGL Tag.E6 Ω →* ModGL Tag.E6 Ω :=
      twistHom TwistTag.E6 Ω σQ.toRingHom
    let ψ : SL(6, Ω) →* ModGL Tag.E6 Ω :=
      E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
    ∀ (xi : Fbarˣ) (n0 : ModGL Tag.E6 Ω),
      n0 ∈ (thetaSL2 Ω).range →
      n0⁻¹ * Ψ n0 = thetaSL2 Ω
        (Matrix.SpecialLinearGroup.map Fbar.subtype (nSL xi)) →
      ∀ (S J6 : SL(6, Ω)),
        (J6 : Matrix (Fin 6) (Fin 6) Ω) = E6GraphLevi.antiId Ω →
        (ψ S)⁻¹ * Ψ (ψ S) = ψ J6 →
        let η : Ωˣ := Units.map Fbar.subtype.toMonoidHom xi
        let z : ModGL Tag.E6 Ω := ψ S
        let ιF : G₀ →* ModGL Tag.E6 Ω :=
          (baseChangeGL (τ := Tag.E6) iF).comp
            ((twistedE6RootGroup F σ).subtype.comp eF.toMonoidHom)
        let cΩ : ModGL Tag.E6 Ω := baseChangeGL (τ := Tag.E6) iF c.val
        let u : ModGL Tag.E6 Ω := (n0 * z)⁻¹ * cΩ
        let ιW : G₀ →* ModGL Tag.E6 Ω :=
          (MulAut.conj u).toMonoidHom.comp ιF
        let ΓW : Subgroup (ModGL Tag.E6 Ω) := ιW.range
        ΓW ≤ adjointGroup Tag.E6 Ω ∧
        (∀ g ∈ ΓW, e6FrobEnd σQ.toRingHom η g = g) ∧
        ∀ y ∈ adjointGroup Tag.E6 Ω,
          e6FrobEnd σQ.toRingHom η y = y →
          y ∈ Subgroup.normalizer (ΓW : Set (ModGL Tag.E6 Ω)) := by
  classical
  simp only []
  intro xi n0 hn0 hcoc S J6 hJ6 hzcoc
  let Ω := AlgebraicClosure F
  let Ψ : ModGL Tag.E6 Ω →* ModGL Tag.E6 Ω :=
    twistHom TwistTag.E6 Ω (iterateFrobeniusEquiv Ω 2 f).toRingHom
  let ψ : SL(6, Ω) →* ModGL Tag.E6 Ω :=
    E6GraphLevi.realize (CharP.cast_eq_zero Ω 2)
  let η : Ωˣ := Units.map (algebraMap F Ω).fieldRange.subtype.toMonoidHom xi
  let z : ModGL Tag.E6 Ω := ψ S
  let ιF : G₀ →* ModGL Tag.E6 Ω :=
    (baseChangeGL (τ := Tag.E6) (algebraMap F Ω)).comp
      ((twistedE6RootGroup F σ).subtype.comp eF.toMonoidHom)
  let cΩ : ModGL Tag.E6 Ω := baseChangeGL (τ := Tag.E6) (algebraMap F Ω) c.val
  let u : ModGL Tag.E6 Ω := (n0 * z)⁻¹ * cΩ
  let ιW : G₀ →* ModGL Tag.E6 Ω := (MulAut.conj u).toMonoidHom.comp ιF
  let ΓW : Subgroup (ModGL Tag.E6 Ω) := ιW.range
  change ΓW ≤ adjointGroup Tag.E6 Ω ∧
    (∀ g ∈ ΓW, e6FrobEnd (iterateFrobeniusEquiv Ω 2 f).toRingHom η g = g) ∧
    ∀ y ∈ adjointGroup Tag.E6 Ω,
      e6FrobEnd (iterateFrobeniusEquiv Ω 2 f).toRingHom η y = y →
      y ∈ Subgroup.normalizer (ΓW : Set (ModGL Tag.E6 Ω))
  haveI : CharP Ω 2 := charP_of_injective_algebraMap (algebraMap F Ω).injective 2
  have hσQ : ∀ c : Ω, (iterateFrobeniusEquiv Ω 2 f) c = c ^ (2 ^ f) :=
    fun c => iterateFrobeniusEquiv_def (R := Ω) (p := 2) (n := f) c
  let Fbar : Subfield Ω := (algebraMap F Ω).fieldRange
  let dθ : ModGL Tag.E6 Ω :=
    rootSL2 Tag.E6 Ω e6HighestRoot (Matrix.SpecialLinearGroup.map Fbar.subtype (nSL xi))
  let j6 : ModGL Tag.E6 Ω := ψ J6
  let Hθ : ModGL Tag.E6 Ω := thetaTorusHom Ω η
  let δ : ModGL Tag.E6 Ω := Hθ * e6ThetaN * e6AntiIdJ
  have hJ6eq : J6 = e6AntiIdSL := by
    apply Subtype.ext
    simpa [e6AntiIdSL] using hJ6
  have hj6 : j6 = e6AntiIdJ := by
    change ψ J6 = e6AntiIdJ
    rw [hJ6eq]
    rfl
  have hmap_nSL : Matrix.SpecialLinearGroup.map Fbar.subtype (nSL xi) = nSL η := by
    rw [CFSG.LieType.Chevalley.nSL_eq_HSL_mul, map_mul,
      CFSG.LieType.Chevalley.map_HSL, CFSG.LieType.Chevalley.map_WSL,
      ← CFSG.LieType.Chevalley.nSL_eq_HSL_mul]
  have hHθ : Hθ = (thetaSL2 Ω (HSL η) : ModGL Tag.E6 Ω) :=
    E6GraphLevi.thetaTorusHom_eq_thetaSL2 η
  have hdθ : dθ = Hθ * e6ThetaN := by
    rw [hHθ]
    change rootSL2 Tag.E6 Ω e6HighestRoot
      (Matrix.SpecialLinearGroup.map Fbar.subtype (nSL xi)) = _
    rw [hmap_nSL, CFSG.LieType.Chevalley.nSL_eq_HSL_mul, map_mul]
    rfl
  have hδ : δ = dθ * j6 := by
    change Hθ * e6ThetaN * e6AntiIdJ = dθ * j6
    rw [hdθ, hj6]
  have hFrob_apply : ∀ g : ModGL Tag.E6 Ω,
      e6FrobEnd (iterateFrobeniusEquiv Ω 2 f).toRingHom η g = δ * Ψ g * δ⁻¹ := by
    intro g
    rfl
  have hΨn0 : Ψ n0 = n0 * dθ := by
    calc Ψ n0 = n0 * (n0⁻¹ * Ψ n0) := by group
      _ = n0 * dθ := by rw [hcoc]; rfl
  have hΨz : Ψ z = z * j6 := by
    calc Ψ z = z * (z⁻¹ * Ψ z) := by group
      _ = z * j6 := by rw [hzcoc]
  have hdθ_range : dθ ∈ (thetaSL2 Ω).range := ⟨_, rfl⟩
  have hz_subsys : z ∈ subsystemGroup TwistTag.E6.tag Ω E6GraphLevi.setA := by
    change ψ S ∈ subsystemGroup TwistTag.E6.tag Ω E6GraphLevi.setA
    rw [← E6GraphLevi.range_realize (CharP.cast_eq_zero Ω 2)]
    exact ⟨S, rfl⟩
  have hcomm : dθ * z = z * dθ := by
    have hcent := E6GraphLevi.subsystemGroup_le_centralizer_thetaSL2 (E := Ω)
      (CharP.cast_eq_zero Ω 2)
    exact (Subgroup.mem_centralizer_iff.1 (hcent hz_subsys)) dθ hdθ_range
  have hΨw : Ψ (n0 * z) = (n0 * z) * δ := by
    rw [map_mul, hΨn0, hΨz, hδ]
    calc (n0 * dθ) * (z * j6) = n0 * (dθ * z) * j6 := by group
      _ = n0 * (z * dθ) * j6 := by rw [hcomm]
      _ = (n0 * z) * (dθ * j6) := by group
  have hcΩ_fixed : cΩ ∈ CFSG.Blueprint.twistedFixedGroup TwistTag.E6 Ω
      (iterateFrobeniusEquiv Ω 2 f).toRingHom := by
    change baseChangeGL (τ := Tag.E6) (algebraMap F Ω) c.val ∈ _
    exact CFSG.HardMathSupport.Timmesfeld.CrossChar.map_twistedE6InndiagGL_le_twistedFixedGroup
      Nat.prime_two hf hFcard σ hσ (iterateFrobeniusEquiv Ω 2 f).toRingHom hσQ
      (Subgroup.mem_map_of_mem (baseChangeGL (τ := Tag.E6) (algebraMap F Ω)) c.2)
  have hcΩ_adj : cΩ ∈ adjointGroup Tag.E6 Ω :=
    ((CFSG.LieType.Chevalley.mem_twistedFixedGroup_iff_twistHom TwistTag.E6 Ω _).1
      hcΩ_fixed).1
  have hΨcΩ : Ψ cΩ = cΩ :=
    ((CFSG.LieType.Chevalley.mem_twistedFixedGroup_iff_twistHom TwistTag.E6 Ω _).1
      hcΩ_fixed).2
  have hΨu : Ψ u = δ⁻¹ * u := by
    change Ψ ((n0 * z)⁻¹ * cΩ) = δ⁻¹ * ((n0 * z)⁻¹ * cΩ)
    calc Ψ ((n0 * z)⁻¹ * cΩ) = (Ψ (n0 * z))⁻¹ * Ψ cΩ := by rw [map_mul, map_inv]
      _ = ((n0 * z) * δ)⁻¹ * cΩ := by rw [hΨw, hΨcΩ]
      _ = δ⁻¹ * ((n0 * z)⁻¹ * cΩ) := by group
  let Cfin : Subgroup (ModGL Tag.E6 Ω) :=
    (graphFixedRootGroup TwistTag.E6 F σ.toRingHom).map
      (baseChangeGL (τ := Tag.E6) (algebraMap F Ω))
  have hCfin_eq : ιF.range = Cfin := by
    apply le_antisymm
    · rintro g ⟨a, rfl⟩
      exact Subgroup.mem_map_of_mem (baseChangeGL (τ := Tag.E6) (algebraMap F Ω)) (eF a).2
    · rintro g hg
      change g ∈ (graphFixedRootGroup TwistTag.E6 F σ.toRingHom).map
        (baseChangeGL (τ := Tag.E6) (algebraMap F Ω)) at hg
      obtain ⟨x, hx, rfl⟩ := hg
      obtain ⟨a, ha⟩ := eF.surjective ⟨x, hx⟩
      refine ⟨a, ?_⟩
      change baseChangeGL (τ := Tag.E6) (algebraMap F Ω) (eF a).val =
        baseChangeGL (τ := Tag.E6) (algebraMap F Ω) x
      rw [show (eF a).val = x by simpa using congrArg Subtype.val ha]
  obtain ⟨-, hCfin_le, -, -, -, hnorm⟩ :=
    CFSG.LieType.Chevalley.exceptional_ambient_twisted_Frobenius_fixed_normalizer
      TwistTag.E6 Nat.prime_two hf F (by simpa [TwistTag.order] using hFcard) σ.toRingHom hσ Ω
      (iterateFrobeniusEquiv Ω 2 f).toRingHom hσQ
  have hCfin_le' : ιF.range ≤ CFSG.Blueprint.twistedFixedGroup TwistTag.E6 Ω
      (iterateFrobeniusEquiv Ω 2 f).toRingHom := by
    rw [hCfin_eq]
    exact hCfin_le
  have htheta_adj : (thetaSL2 Ω).range ≤ adjointGroup Tag.E6 Ω := by
    rintro _ ⟨B, rfl⟩
    exact CFSG.LieType.Chevalley.rootSL2_mem_adjointGroup (τ := Tag.E6) e6HighestRoot B
  have hn0_adj : n0 ∈ adjointGroup Tag.E6 Ω := htheta_adj hn0
  have hz_adj : z ∈ adjointGroup Tag.E6 Ω :=
    E6GraphLevi.subsystemGroup_le_adjointGroup hz_subsys
  have hw_adj : n0 * z ∈ adjointGroup Tag.E6 Ω := mul_mem hn0_adj hz_adj
  have hu_adj : u ∈ adjointGroup Tag.E6 Ω := by
    change (n0 * z)⁻¹ * cΩ ∈ adjointGroup Tag.E6 Ω
    exact mul_mem (inv_mem hw_adj) hcΩ_adj
  refine ⟨?_, ?_, ?_⟩
  · intro g hg
    change g ∈ ιW.range at hg
    obtain ⟨a, rfl⟩ := hg
    change u * ιF a * u⁻¹ ∈ adjointGroup Tag.E6 Ω
    exact mul_mem (mul_mem hu_adj
      ((CFSG.LieType.Chevalley.mem_twistedFixedGroup_iff_twistHom TwistTag.E6 Ω _).1
        (hCfin_le' ⟨a, rfl⟩)).1) (inv_mem hu_adj)
  · intro g hg
    change g ∈ ιW.range at hg
    obtain ⟨a, rfl⟩ := hg
    rw [hFrob_apply]
    have hΨa : Ψ (ιF a) = ιF a :=
      ((CFSG.LieType.Chevalley.mem_twistedFixedGroup_iff_twistHom TwistTag.E6 Ω _).1
        (hCfin_le' ⟨a, rfl⟩)).2
    change δ * Ψ (u * ιF a * u⁻¹) * δ⁻¹ = u * ιF a * u⁻¹
    rw [map_mul, map_mul, map_inv, hΨu, hΨa]
    group
  · intro y hy hyfix
    let v : ModGL Tag.E6 Ω := u⁻¹ * y * u
    have hfixy : δ * Ψ y * δ⁻¹ = y := by
      have h := hyfix
      rw [hFrob_apply] at h
      exact h
    have hv_adj : v ∈ adjointGroup Tag.E6 Ω := by
      change u⁻¹ * y * u ∈ adjointGroup Tag.E6 Ω
      exact mul_mem (mul_mem (inv_mem hu_adj) hy) hu_adj
    have hv_fixed : Ψ v = v := by
      change Ψ (u⁻¹ * y * u) = u⁻¹ * y * u
      calc Ψ (u⁻¹ * y * u) = (Ψ u)⁻¹ * Ψ y * Ψ u := by rw [map_mul, map_mul, map_inv]
        _ = (δ⁻¹ * u)⁻¹ * Ψ y * (δ⁻¹ * u) := by rw [hΨu]
        _ = u⁻¹ * (δ * Ψ y * δ⁻¹) * u := by group
        _ = u⁻¹ * y * u := by rw [hfixy]
    have hv_mem : v ∈ CFSG.Blueprint.twistedFixedGroup TwistTag.E6 Ω
        (iterateFrobeniusEquiv Ω 2 f).toRingHom :=
      (CFSG.LieType.Chevalley.mem_twistedFixedGroup_iff_twistHom TwistTag.E6 Ω _).2
        ⟨hv_adj, hv_fixed⟩
    have hv_norm : v ∈ Subgroup.normalizer (Cfin : Set (ModGL Tag.E6 Ω)) := hnorm hv_mem
    have hmapnorm := Subgroup.map_normalizer_eq_of_bijective Cfin
      (f := (MulAut.conj u).toMonoidHom) (MulAut.conj u).bijective
    have hy_map : y ∈ (Subgroup.normalizer (Cfin : Set (ModGL Tag.E6 Ω))).map
        (MulAut.conj u).toMonoidHom := by
      refine Subgroup.mem_map.2 ⟨v, hv_norm, ?_⟩
      change u * (u⁻¹ * y * u) * u⁻¹ = y
      group
    rw [hmapnorm] at hy_map
    have hΓW_eq : ΓW = Cfin.map (MulAut.conj u).toMonoidHom := by
      change ((MulAut.conj u).toMonoidHom.comp ιF).range = _
      rw [MonoidHom.range_comp, hCfin_eq]
    rwa [hΓW_eq]

end CFSG.StandardType.SCFourCover

