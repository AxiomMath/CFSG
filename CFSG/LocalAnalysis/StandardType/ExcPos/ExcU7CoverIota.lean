      MulEquiv.subgroupCongr_apply]
    exact CFSG.LieType.Universal.Unitary.coe_conjEquiv P' hP' A
  let ι : SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6 ≃*
      ↥(fixSubgroup (stdUnitaryEquiv (ν := 6) σQ)) :=
    (CFSG.StandardType.SURep.ggFrameEquiv hGF P' hP').trans
