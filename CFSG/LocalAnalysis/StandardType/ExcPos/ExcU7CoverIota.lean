            (P : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) := by
          rw [hDD, Matrix.mul_one]
      _ = antidiag 6 := hP
  have hprod : (∏ i, (u i : GaloisField 2 (2 * f))) = d⁻¹ := by
    rw [Finset.prod_eq_single (s := Finset.univ) (0 : Fin 6)
      (fun b _ hb => by
        have hub : u b = 1 := by
          simp only [u]
          exact Function.update_of_ne hb _ _
        rw [hub]
        simp)
      (fun h => absurd (Finset.mem_univ (0 : Fin 6)) h)]
    have hu0 : u 0 = Units.mk0 d⁻¹ (inv_ne_zero hd0) := by
      simp only [u, Function.update_self]
    rw [hu0, Units.val_mk0]
  have hdetP' : (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).det = 1 := by
    rw [hP'val, Matrix.det_mul, CFSG.SectionRank.OddCover.det_diagHom, hprod]
    exact inv_mul_cancel₀ hd0
  let P'E : GL (Fin 6) GGL := Matrix.GeneralLinearGroup.map E P'
  have hP'Eval : (P'E : Matrix (Fin 6) (Fin 6) GGL) =
      (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E := rfl
  have hdetPE : (P'E : Matrix (Fin 6) (Fin 6) GGL).det = 1 := by
    rw [hP'Eval]
    change (E.mapMatrix (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f)))).det = 1
    rw [← RingHom.map_det E (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))),
      hdetP', map_one]
  let g : SL(6, GGL) := ⟨(P'E : Matrix (Fin 6) (Fin 6) GGL), hdetPE⟩
  have hgval : (g : Matrix (Fin 6) (Fin 6) GGL) =
      (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E := hP'Eval
  have hgg : ((g⁻¹ : SL(6, GGL)) : Matrix (Fin 6) (Fin 6) GGL) =
      ((g : Matrix (Fin 6) (Fin 6) GGL))⁻¹ := by
    rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.inv_def, g.2]
    simp
  have hgg2 : (g : Matrix (Fin 6) (Fin 6) GGL) *
      ((P'⁻¹ : GL (Fin 6) (GaloisField 2 (2 * f))) :
        Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E = 1 := by
    rw [hgval, ← Matrix.map_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one,
