      Matrix.diagonal_mul_diagonal]
    rw [show (fun i => unitaryInvolution (GaloisField 2 (2 * f)) 2 f ((u i : _)) *
        (u i : _)) = fun _ => 1 from funext hDnorm, Matrix.diagonal_one]
  have hP' : conjTr (unitaryInvolution (GaloisField 2 (2 * f)) 2 f)
      (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) *
      (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) = antidiag 6 := by
    rw [hP'val, conjTr_mul]
    calc (conjTr (unitaryInvolution (GaloisField 2 (2 * f)) 2 f)
            (P : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) *
          conjTr (unitaryInvolution (GaloisField 2 (2 * f)) 2 f)
            (D : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f)))) *
