theorem excU7Cover_card_field (f : ℕ) (hf : 1 ≤ f) :
    Nat.card (GaloisField 2 (2 * f)) = (2 ^ f) ^ 2 :=
  CFSG.LieType.Universal.card_galoisField_two_mul 2 f hf

section Props


theorem excU7Cover_group_props (f : ℕ) (hf : 1 ≤ f) :
    Finite (SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6) ∧
      Group.IsPerfect (SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6) ∧
      CFSG.SeitzReduction.UnitaryPilot.OddCentralSplit
        (SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6) := by
  have hGF := excU7Cover_card_field f hf
  have h32 : (6, 2 ^ f) ≠ (3, 2) := by
    intro h
    exact absurd (congrArg Prod.fst h) (by norm_num)
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Finite (GaloisField 2 (2 * f)) :=
    Nat.finite_of_card_ne_zero (by rw [hGF]; positivity)
  let e := CFSG.LieType.Universal.Unitary.equivStatedSU
    (F := GaloisField 2 (2 * f)) (p := 2) (f := f) hGF 6
  refine ⟨inferInstance, ?_, ?_⟩
  · exact (CFSG.ClassicalGroups.Unitary.isPerfect_statedSU
      (K := GaloisField 2 (2 * f)) (p := 2) (f := f) hGF (by norm_num) h32).ofSurjective
      (f := e.symm.toMonoidHom) e.symm.surjective
  · exact (CFSG.SeitzReduction.UnitaryPilot.oddCentralSplit_statedSU
      (F := GaloisField 2 (2 * f)) (f := f) hGF (by norm_num) h32).of_mulEquiv e.symm

end Props

theorem excU7Cover_iota (f : ℕ) (hf : 1 ≤ f) (σQ : GGL ≃+* GGL) (hσQ : ∀ c, σQ c = c ^ 2 ^ f) :
    ∃ (E : GaloisField 2 (2 * f) →+* GGL) (g : SL(6, GGL))
      (ι : SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6 ≃*
        ↥(fixSubgroup (stdUnitaryEquiv (ν := 6) σQ))),
      Function.Injective E ∧
      (∀ c, E (unitaryInvolution (GaloisField 2 (2 * f)) 2 f c) = σQ (E c)) ∧
      ((g : Matrix (Fin 6) (Fin 6) GGL).map σQ)ᵀ * (g : Matrix (Fin 6) (Fin 6) GGL) =
        antidiag 6 ∧
      ∀ A : SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6,
        ((ι A : SL(6, GGL)) : Matrix (Fin 6) (Fin 6) GGL) =
          (g : Matrix (Fin 6) (Fin 6) GGL) *
            ((A : GL (Fin 6) (GaloisField 2 (2 * f))) :
              Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E *
            ((g⁻¹ : SL(6, GGL)) : Matrix (Fin 6) (Fin 6) GGL) := by
  classical
  have hGF : Nat.card (GaloisField 2 (2 * f)) = (2 ^ f) ^ 2 := excU7Cover_card_field f hf
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨F, hFcard, eC, heC⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSConn.two_suN_exists_equiv_link
      (L := GGL) (ℓ := 2) (f := f) Nat.prime_two hf σQ hσQ (by norm_num : 3 ≤ 6)
  have hfinF : Finite F := Nat.finite_of_card_ne_zero (by rw [hFcard]; positivity)
  have hcard_eq : Nat.card (GaloisField 2 (2 * f)) = Nat.card F := by rw [hGF, hFcard]
  let _ : Fintype F := Fintype.ofFinite F
  let _ : Fintype (GaloisField 2 (2 * f)) := Fintype.ofFinite _
  have hcardF : Fintype.card (GaloisField 2 (2 * f)) = Fintype.card F := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    exact hcard_eq
  let e₁ : GaloisField 2 (2 * f) ≃+* F := FiniteField.ringEquivOfCardEq hcardF
  let E : GaloisField 2 (2 * f) →+* GGL := F.subtype.comp e₁.toRingHom
  have hEinj : Function.Injective E := (Subfield.subtype_injective F).comp e₁.injective
  have hEmap : ∀ c : GaloisField 2 (2 * f),
      E (unitaryInvolution (GaloisField 2 (2 * f)) 2 f c) = σQ (E c) := by
    intro c
    rw [unitaryInvolution_apply, map_pow, hσQ]
  obtain ⟨P, hP⟩ := CFSG.LieType.Universal.Unitary.exists_wittMatrix
    (F := GaloisField 2 (2 * f)) (p := 2) (f := f) hGF 6
  set d : GaloisField 2 (2 * f) :=
    (P : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).det with hd
  have hd0 : d ≠ 0 := by
    rw [hd]
    exact Matrix.GeneralLinearGroup.det_ne_zero P
  have hmapdet : ((P : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map
      (unitaryInvolution (GaloisField 2 (2 * f)) 2 f)).det =
      unitaryInvolution (GaloisField 2 (2 * f)) 2 f d := by
    have h := (RingHom.map_det (unitaryInvolution (GaloisField 2 (2 * f)) 2 f).toRingHom
      (P : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f)))).symm
    rw [← hd] at h
    exact h
  have hdetJ : unitaryInvolution (GaloisField 2 (2 * f)) 2 f d * d =
      (antidiag 6 : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).det := by
    have h := congrArg Matrix.det hP
    rw [conjTr, Matrix.det_mul, Matrix.det_transpose, hmapdet, ← hd] at h
    exact h
  have hJs : (antidiag 6 : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) * antidiag 6 = 1 :=
    CFSG.LieType.Universal.Unitary.antidiag_mul_self 6
  have hsq : (unitaryInvolution (GaloisField 2 (2 * f)) 2 f d * d) *
      (unitaryInvolution (GaloisField 2 (2 * f)) 2 f d * d) = 1 := by
    rw [hdetJ, ← Matrix.det_mul, hJs, Matrix.det_one]
  have hnorm : unitaryInvolution (GaloisField 2 (2 * f)) 2 f d * d = 1 := by
    rcases (mul_self_eq_one_iff.mp hsq) with h | h
    · exact h
    · rwa [CharTwo.neg_eq] at h
  let u : Fin 6 → (GaloisField 2 (2 * f))ˣ :=
    Function.update (fun _ => 1) 0 (Units.mk0 d⁻¹ (inv_ne_zero hd0))
  have hDnorm : ∀ i, unitaryInvolution (GaloisField 2 (2 * f)) 2 f ((u i : _)) * (u i : _) = 1 := by
    intro i
    by_cases hi : i = 0
    · subst hi
      simp only [u, Function.update_self, Units.val_mk0]
      have hinv : unitaryInvolution (GaloisField 2 (2 * f)) 2 f d⁻¹ = d := by
        apply (unitaryInvolution (GaloisField 2 (2 * f)) 2 f).injective
        rw [unitaryInvolution_involutive hGF]
        exact (eq_inv_of_mul_eq_one_left hnorm).symm
      rw [hinv, mul_inv_cancel₀ hd0]
    · have hui : u i = 1 := by
        simp only [u]
        exact Function.update_of_ne hi _ _
      rw [hui]
      simp
  let D : GL (Fin 6) (GaloisField 2 (2 * f)) := CFSG.SectionRank.OddCover.diagHom 6 u
  let P' : GL (Fin 6) (GaloisField 2 (2 * f)) := D * P
  have hP'val : (P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) =
      (D : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) *
        (P : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) := rfl
  have hDD : conjTr (unitaryInvolution (GaloisField 2 (2 * f)) 2 f)
      (D : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) *
      (D : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))) = 1 := by
    rw [conjTr, CFSG.SectionRank.OddCover.coe_diagHom,
