  have hginv : ((g⁻¹ : SL(6, GGL)) : Matrix (Fin 6) (Fin 6) GGL) =
      ((P'⁻¹ : GL (Fin 6) (GaloisField 2 (2 * f))) :
        Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E := by
    rw [hgg, Matrix.inv_eq_right_inv hgg2]
  have hframe : ∀ A : SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) 6,
