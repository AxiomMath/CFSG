      _ = (((P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map
            (unitaryInvolution (GaloisField 2 (2 * f)) 2 f)).map E)ᵀ *
            ((P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E) := by rw [hL]
      _ = ((((P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map
            (unitaryInvolution (GaloisField 2 (2 * f)) 2 f))ᵀ).map E) *
            ((P' : Matrix (Fin 6) (Fin 6) (GaloisField 2 (2 * f))).map E) := by
