@[expose] def ExcSwappedZ {p₀ : ℕ}
    (S : LangSetup Tag.E6 GGL p₀) (a : Fin Tag.E6.rank → GGLˣ)
    (i : KernelComponent (rootCharHom a)) (f : ℕ) (A : Subgroup (ModGL Tag.E6 GGL)) : Prop :=
  Nat.card ↥A = (2 ^ f) ^ 2 ∧ A ≤ S.Γ ∧
    ∃ (α : Fin Tag.E6.rank → ℤ) (w : ModGL Tag.E6 GGL),
      α ∈ componentRoots (rootCharHom a) i ∧
      w ∈ torusGroup Tag.E6 GGL ⊔ rootSpan Tag.E6 GGL (kernelRoots (rootCharHom a)) ∧
      ((excCurve α w).map S.D.step).map S.D.step = excCurve α w ∧
      (∀ v ∈ excCurve α w, ∀ v' ∈ (excCurve α w).map S.D.step, v * v' = v' * v) ∧
      A ≤ excCurve α w ⊔ (excCurve α w).map S.D.step


private lemma u7frame_frame_dim {ν r : ℕ} (h : ν * (ν - 1) = r * (r + 1)) (hν : 3 ≤ ν) :
    ν = r + 1 := by
  obtain ⟨m, rfl⟩ : ∃ m, ν = m + 1 := ⟨ν - 1, by omega⟩
  rw [Nat.add_sub_cancel] at h
  have hm : m = r := by
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with hlt | hgt <;> nlinarith
  omega

theorem excSuClass_frame {p₀ : ℕ} (S : LangSetup Tag.E6 GGL p₀) (a : Fin Tag.E6.rank → GGLˣ)
    (i : KernelComponent (rootCharHom a)) (f p : ℕ) (h : ExcSuClass S a i f p) :
    ∃ (σQ : GGL ≃+* GGL) (ψ : SL(6, GGL) →* ModGL Tag.E6 GGL)
      (σf : Fin 6 → Fin 6 → Fin Tag.E6.rank → ℤ) (z : ModGL Tag.E6 GGL),
      (∀ c, σQ c = c ^ 2 ^ f) ∧ IsSLFrame ψ σf ∧
      componentRoots (rootCharHom a) i = frameRoots σf ∧
      z ∈ torusGroup Tag.E6 GGL ⊔ rootSpan Tag.E6 GGL (kernelRoots (rootCharHom a)) ∧
      (∀ X : SL(6, GGL),
        S.D.step (z * ψ X * z⁻¹) = z * ψ (stdUnitary σQ.toRingHom X) * z⁻¹) ∧
      ((MulAut.conj z).toMonoidHom.comp ψ).range =
        rootSpan Tag.E6 GGL (componentRoots (rootCharHom a) i) ∧
      (CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 6) σQ)).map
          ((MulAut.conj z).toMonoidHom.comp ψ) =
        rationalComponent S.ρ S.Γ (rootCharHom a) i ∧
      Group.IsPerfect ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 6) σQ)) ∧
      1 ≤ f ∧ ψ.ker ≤ Subgroup.center SL(6, GGL) ∧
      (∀ u ∈ torusGroup Tag.E6 GGL ⊔ rootSpan Tag.E6 GGL (kernelRoots (rootCharHom a)),
        ∃ M : GL (Fin 6) GGL, ∀ X : SL(6, GGL),
          u * ((MulAut.conj z).toMonoidHom.comp ψ) X * u⁻¹ =
            ((MulAut.conj z).toMonoidHom.comp ψ) (conjSLn M X)) := by
  classical
  obtain ⟨hT, hp, hp2, hTp, hq, hkind, hrank, horb, _hqs⟩ := h
  have hf1 : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h0 | hpos
    · exfalso
      have hq1 : S.D.q = 1 := by rw [hq, h0, pow_zero]
      have hp' := S.hqpow.1
      rw [hq1] at hp'
      exact not_isPrimePow_one hp'
    · exact hpos
  have hpL : (p : GGL) ≠ 0 := by
    intro h0
    have hd : 2 ∣ p := (CharP.cast_eq_zero_iff GGL 2 p).mp h0
    rcases hp.eq_two_or_odd with h2 | hodd
    · exact hp2 h2
    · exact (Nat.not_even_iff_odd.mpr (Nat.odd_iff.mpr hodd)) (even_iff_two_dvd.mpr hd)
  have hrn : 2 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard =
        compRank (componentRoots (rootCharHom a) i) *
          (compRank (componentRoots (rootCharHom a) i) + 1) :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.suN_rank_ncard hkind
  obtain ⟨ν, ψ, σf, _hν3, hψ, hnorm, hΨ⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_frame_of_typeA_E6_T_of_prime
      S hp hpL hTp i hrn.1 hrn.2
  have hcard : (frameRoots σf).ncard = ν * (ν - 1) :=
    CFSG.LocalAnalysis.GLTheoremA.kd147c_frameRoots_ncard hψ one_ne_zero hnorm
  have hEq : ν * (ν - 1) = compRank (componentRoots (rootCharHom a) i) *
      (compRank (componentRoots (rootCharHom a) i) + 1) := by
    rw [← hcard, ← hΨ, hrn.2]
  have hνr : ν = compRank (componentRoots (rootCharHom a) i) + 1 :=
    u7frame_frame_dim hEq _hν3
  have hν6 : ν = 6 := by rw [hνr, hrank]
  subst hν6
  obtain ⟨π, hπperm⟩ :=
    CFSG.HardMathSupport.Dickson.Sec6.Up34Exc.two_suN_perm S hT i hkind
      (by norm_num : 3 ≤ 6) hψ one_ne_zero hnorm hΨ
  have hπ : ∀ x y, x ≠ y → S.ρ (σf x y) = σf (π y) (π x) := by
    intro x y hxy
    have hh := hπperm x y hxy
    rwa [horb, Function.iterate_one] at hh
  obtain ⟨σQ, _B, _d, z, hσc, _hB, hstd, hzmem, hzstep⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.exists_unitary_pin
      S hT i (by norm_num : 3 ≤ 6) hψ hΨ π hπ Nat.prime_two (inferInstance : CharP GGL 2)
      (by omega : 0 < f) hq
  have hσQc : ∀ c, σQ c = c ^ 2 ^ f := by
    intro c
    rw [hσc c, hq]
  obtain ⟨W, hW⟩ := (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.mem_actsOn).1
    (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.torusSup_le_actsOn hψ
      (by norm_num : 0 < 6) i hΨ hzmem)
  have hWi : ∀ X : SL(6, GGL), ψ X = z * ψ (conjSLn W⁻¹ X) * z⁻¹ := fun X => by
    rw [hW (conjSLn W⁻¹ X),
      ← CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.conjSLn_mul_apply,
      mul_inv_cancel,
      CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.conjSLn_one_apply]
  have hWsurj : Function.Surjective (conjSLn W : SL(6, GGL) →* SL(6, GGL)) := fun X =>
    ⟨conjSLn W⁻¹ X, by
      rw [← CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.conjSLn_mul_apply,
        mul_inv_cancel,
        CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.conjSLn_one_apply]⟩
  have h32 : ((6 : ℕ), 2 ^ f) ≠ (3, 2) := by
    intro hcon
    exact (by norm_num : (6 : ℕ) ≠ 3) (congrArg Prod.fst hcon)
  set C := CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := 6) σQ) with hCdef
  have hCqs : CFSG.IsQuasisimple C :=
    (stdUnitary_fixSubgroup (ν := 6) (ℓ := 2) Nat.prime_two (f := f) hf1 σQ hσQc
      (by norm_num : 3 ≤ 6)).2.1 h32
  have hCperf : Group.IsPerfect C := hCqs.1
  have hperf : ⁅C, C⁆ = C := Subgroup.isPerfect_iff.1 hCperf
  let θ' : SL(6, GGL) →* ModGL Tag.E6 GGL := (MulAut.conj z).toMonoidHom.comp ψ
  have hstepθ : ∀ Y : SL(6, GGL), S.D.step (z * ψ Y * z⁻¹) =
      z * ψ (stdUnitary σQ.toRingHom Y) * z⁻¹ := by
    intro Y
    calc S.D.step (z * ψ Y * z⁻¹)
        = S.D.step z * S.D.step (ψ Y) * (S.D.step z)⁻¹ := by
          rw [map_mul, map_mul, map_inv]
      _ = (z * ψ _B) * S.D.step (ψ Y) * (z * ψ _B)⁻¹ := by rw [hzstep]
      _ = z * (ψ _B * S.D.step (ψ Y) * (ψ _B)⁻¹) * z⁻¹ := by group
      _ = z * ψ (stdUnitary σQ.toRingHom Y) * z⁻¹ := by rw [hstd Y]
  have hrange : θ'.range = rootSpan Tag.E6 GGL (componentRoots (rootCharHom a) i) := by
    have hfun : θ' = ψ.comp (conjSLn W) := by
      apply MonoidHom.ext
      intro X
      dsimp only [θ', MonoidHom.comp_apply]
      change z * ψ X * z⁻¹ = ψ (conjSLn W X)
      exact hW X
    rw [hfun, MonoidHom.range_comp, MonoidHom.range_eq_top.mpr hWsurj,
      ← MonoidHom.range_eq_map, hψ.range, hΨ]
  have hstab : ∀ γ ∈ componentRoots (rootCharHom a) i,
      S.ρ γ ∈ componentRoots (rootCharHom a) i := by
    intro γ hγ
    rw [hΨ] at hγ ⊢
    obtain ⟨x, y, hxy, rfl⟩ := hγ
    exact ⟨π y, π x, fun hyx => hxy (π.injective hyx).symm, hπ x y hxy⟩
  have hspan : rootSpan Tag.E6 GGL (componentRoots (rootCharHom a) i) = ψ.range := by
    rw [hψ.range, hΨ]
  have hΓ : S.Γ ≤ S.D.model := by
    show ⁅S.D.model, S.D.model⁆ ≤ S.D.model
    exact Subgroup.commutator_le.2 fun g₁ h₁ g₂ h₂ =>
      S.D.model.mul_mem (S.D.model.mul_mem (S.D.model.mul_mem h₁ h₂) (S.D.model.inv_mem h₁))
        (S.D.model.inv_mem h₂)
  have hker : ψ.ker ≤ Subgroup.center SL(6, GGL) :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.frame_ker_le_center
      (by norm_num : 3 ≤ 6) hψ
  have hpart : ∀ g ∈ rationalSpan S.ρ S.Γ (rootCharHom a) i, ∃ Y : SL(6, GGL),
      stdUnitary σQ.toRingHom Y * Y⁻¹ ∈ Subgroup.center SL(6, GGL) ∧
        g = z * ψ Y * z⁻¹ := by
    intro g hg
    obtain ⟨hg1, hg2⟩ := Subgroup.mem_inf.1 hg
    rw [CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.rationalRoots_eq_componentRoots
      S i hstab, hspan] at hg1
    obtain ⟨Y₀, rfl⟩ := hg1
    refine ⟨conjSLn W⁻¹ Y₀, ?_, hWi Y₀⟩
    have hfix : S.D.step (ψ Y₀) = ψ Y₀ := ((LangDatum.mem_model _).1 (hΓ hg2)).2
    rw [hWi Y₀, hstepθ (conjSLn W⁻¹ Y₀)] at hfix
    have h1 := mul_left_cancel (mul_right_cancel hfix)
    apply hker
    rw [MonoidHom.mem_ker, map_mul, map_inv, h1, mul_inv_cancel]
  have hζ : ∀ {ζ : SL(6, GGL)}, ζ ∈ Subgroup.center SL(6, GGL) → ∀ b, Commute ζ b :=
    fun hζ b => (Subgroup.mem_center_iff.1 hζ b).symm
  have hle : rationalComponent S.ρ S.Γ (rootCharHom a) i ≤ C.map θ' := by
    refine Subgroup.commutator_le.2 fun g₁ hg₁ g₂ hg₂ => ?_
    obtain ⟨Y₁, hc₁, rfl⟩ := hpart g₁ hg₁
    obtain ⟨Y₂, hc₂, rfl⟩ := hpart g₂ hg₂
    refine ⟨⁅Y₁, Y₂⁆, ?_, ?_⟩
    · show stdUnitary σQ.toRingHom ⁅Y₁, Y₂⁆ = ⁅Y₁, Y₂⁆
      rw [map_commutatorElement, ← inv_mul_cancel_right (stdUnitary σQ.toRingHom Y₁) Y₁,
        ← inv_mul_cancel_right (stdUnitary σQ.toRingHom Y₂) Y₂]
      exact CycFamily.commutatorElement_central_mul (hζ hc₁ _) (hζ hc₁ _) (hζ hc₁ _)
        (hζ hc₂ _) (hζ hc₂ _)
    · show z * ψ ⁅Y₁, Y₂⁆ * z⁻¹ = ⁅z * ψ Y₁ * z⁻¹, z * ψ Y₂ * z⁻¹⁆
      rw [map_commutatorElement]
      simp only [commutatorElement_def]
      group
  have hψS : ∀ y, θ' y ∈ rootSpan Tag.E6 GGL (componentRoots (rootCharHom a) i) := fun y => by
    show z * ψ y * z⁻¹ ∈ _
    rw [hW, hspan]
    exact ⟨_, rfl⟩
  have hψA : ∀ y, θ' y ∈ adjointGroup Tag.E6 GGL := fun y => by
    show z * ψ y * z⁻¹ ∈ _
    rw [hW]
    exact hψ.range_le_adjointGroup ⟨_, rfl⟩
  have hfix_le : C.map θ' ≤ rationalComponent S.ρ S.Γ (rootCharHom a) i := by
    intro g hg
    obtain ⟨Y, hY, rfl⟩ := hg
    exact CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.map_fix_le_rationalComponent
      S i hstab θ' hψS hψA (stdUnitary σQ.toRingHom) (fun y => hstepθ y) C
      (fun _ hy => hy) hperf Y hY
  have hCmap : C.map θ' = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
    le_antisymm hfix_le hle
  have hconjZ : ∀ u ∈ torusGroup Tag.E6 GGL ⊔
      rootSpan Tag.E6 GGL (kernelRoots (rootCharHom a)),
      ∃ M : GL (Fin 6) GGL, ∀ X : SL(6, GGL),
        u * θ' X * u⁻¹ = θ' (conjSLn M X) := by
    intro u hu
    have hu' : z⁻¹ * u * z ∈ torusGroup Tag.E6 GGL ⊔
        rootSpan Tag.E6 GGL (kernelRoots (rootCharHom a)) :=
      mul_mem (mul_mem (inv_mem hzmem) hu) hzmem
    obtain ⟨M, hM⟩ := (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.mem_actsOn).1
      (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSGen.torusSup_le_actsOn hψ
        (by norm_num : 0 < 6) i hΨ hu')
    refine ⟨M, fun X => ?_⟩
    show u * (z * ψ X * z⁻¹) * u⁻¹ = z * ψ (conjSLn M X) * z⁻¹
    rw [← hM X]
    group
  exact ⟨σQ, ψ, σf, z, hσQc, hψ, hΨ, hzmem, hstepθ, hrange, hCmap, hCperf, hf1, hker, hconjZ⟩

