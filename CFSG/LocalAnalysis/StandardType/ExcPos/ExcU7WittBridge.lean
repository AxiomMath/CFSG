variable {L : Type} [Field L]

theorem exists_fixed_witt_two [IsAlgClosed L] [CharP L 2] (σ : L ≃+* L) {f : ℕ} (hf : 1 ≤ f)
    (hσ : ∀ c, σ c = c ^ 2 ^ f) {u u' : Fin 3 → Fin 6 → L}
    (hu : ∀ j i, σ (σ (u j i)) = u j i) (hu' : ∀ j i, σ (σ (u' j i)) = u' j i)
    (hli : LinearIndependent L u) (hli' : LinearIndependent L u')
    (hiu : ∀ i j, ∑ k, σ (u i k) * u j k = 0) (hiu' : ∀ i j, ∑ k, σ (u' i k) * u' j k = 0) :
    ∃ k : SL(6, L), stdUnitary σ.toRingHom k = k ∧ ∃ l : L, l ≠ 0 ∧
      (k : Matrix (Fin 6) (Fin 6) L).mulVec (u 0) = l • u' 0 ∧
      (k : Matrix (Fin 6) (Fin 6) L).mulVec (u 1) = u' 1 ∧
      (k : Matrix (Fin 6) (Fin 6) L).mulVec (u 2) = u' 2 := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let F : Subfield L := CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.I292CaseALang.sqFixedField σ
  have hFmem : ∀ c : L, c ∈ F ↔ σ (σ c) = c :=
    fun c => CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.I292CaseALang.mem_sqFixedField
  let σF : F ≃+* F := CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.I292CaseALang.sqFixedAut σ
  have hσFcoe : ∀ x : F, ((σF x : F) : L) = σ x := fun x => rfl
  have hpow : ∀ c : L, c ∈ F ↔ c ^ 2 ^ (2 * f) = c := by
    intro c
    rw [hFmem]
    have hmul : 2 ^ f * 2 ^ f = 2 ^ (2 * f) := by
      rw [← pow_add]
      ring_nf
    constructor
    · intro h
      calc c ^ 2 ^ (2 * f) = c ^ (2 ^ f * 2 ^ f) := by rw [hmul]
        _ = (c ^ 2 ^ f) ^ 2 ^ f := by rw [pow_mul]
        _ = σ (c ^ 2 ^ f) := (hσ _).symm
        _ = σ (σ c) := by rw [hσ c]
        _ = c := h
    · intro h
      calc σ (σ c) = σ (c ^ 2 ^ f) := by rw [hσ c]
        _ = (c ^ 2 ^ f) ^ 2 ^ f := hσ _
        _ = c ^ (2 ^ f * 2 ^ f) := by rw [pow_mul]
        _ = c ^ 2 ^ (2 * f) := by rw [hmul]
        _ = c := h
  have hcard : Nat.card F = (2 ^ f) ^ 2 := by
    have hq : (2 ^ f) ^ 2 = 2 ^ (2 * f) := by
      rw [← pow_mul]
      ring_nf
    rw [hq, ← CFSG.RankThree.Classical2.natCard_setOf_pow_eq_self (Ω := L) (ℓ := 2)
      (e := 2 * f) (by omega)]
    exact Nat.card_congr (Equiv.subtypeEquivRight hpow)
  haveI hfin : Finite F :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero _ (pow_ne_zero _ (by norm_num)))
  haveI hchar : CharP F 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := f) hcard
  have hσFeq : σF = CFSG.LieType.BorelTits.unitaryInvolution F 2 f := by
    ext x
    rw [CFSG.LieType.BorelTits.unitaryInvolution_apply]
    calc ((σF x : F) : L) = σ (x : L) := hσFcoe x
      _ = (x : L) ^ 2 ^ f := hσ (x : L)
      _ = ((x ^ 2 ^ f : F) : L) := (Subring.coe_pow F.toSubring x (2 ^ f)).symm
  have hσU : CFSG.ClassicalGroups.Unitary.IsUnitaryInvolution σF := by
    rw [hσFeq]
    exact CFSG.ClassicalGroups.Unitary.isUnitaryInvolution_unitaryInvolution hcard
  let uF : Fin 3 → Fin 6 → F := fun j i => ⟨u j i, by rw [hFmem]; exact hu j i⟩
  let u'F : Fin 3 → Fin 6 → F := fun j i => ⟨u' j i, by rw [hFmem]; exact hu' j i⟩
  have hliF : LinearIndependent F uF := by
    rw [Fintype.linearIndependent_iff] at hli ⊢
    intro g hg i
    refine Subtype.ext ?_
    have hgL : ∑ j, (g j : L) • u j = 0 := by
      ext k
      have h := congrFun (congrArg (fun x : Fin 6 → F => fun k => ((x k : F) : L)) hg) k
      simpa [uF, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using h
    simpa using hli (fun j => (g j : L)) hgL i
  have hli'F : LinearIndependent F u'F := by
    rw [Fintype.linearIndependent_iff] at hli' ⊢
    intro g hg i
    refine Subtype.ext ?_
    have hgL : ∑ j, (g j : L) • u' j = 0 := by
      ext k
      have h := congrFun (congrArg (fun x : Fin 6 → F => fun k => ((x k : F) : L)) hg) k
      simpa [u'F, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using h
    simpa using hli' (fun j => (g j : L)) hgL i
  have hiuF : ∀ i j, ∑ k, σF (uF i k) * uF j k = 0 := by
    intro i j
    apply Subtype.ext
    have h := hiu i j
    simpa [uF, hσFcoe, Finset.sum_apply, smul_eq_mul] using h
  have hiu'F : ∀ i j, ∑ k, σF (u'F i k) * u'F j k = 0 := by
    intro i j
    apply Subtype.ext
    have h := hiu' i j
    simpa [u'F, hσFcoe, Finset.sum_apply, smul_eq_mul] using h
  have hι : exteriorPower.ιMulti F 3 uF ≠ 0 :=
    CFSG.RankThree.GF2n.Smith81.u6_iotaMulti_ne_zero_of_li hliF
  have hι' : exteriorPower.ιMulti F 3 u'F ≠ 0 :=
    CFSG.RankThree.GF2n.Smith81.u6_iotaMulti_ne_zero_of_li hli'F
  obtain ⟨h, l, hl, h0, h1, h2⟩ :=
    CFSG.RankThree.GF2n.Smith81.RootGenU.u6_witt_two hσU hι hiuF hι' hiu'F
  let M : Matrix (Fin 6) (Fin 6) F := (h : GL (Fin 6) F)
  let ML : Matrix (Fin 6) (Fin 6) L := M.map F.subtype
  have hdetM : M.det = 1 := h.2.1
  have hdetML : ML.det = 1 := by
    rw [show ML = M.map F.subtype from rfl, ← RingHom.mapMatrix_apply F.subtype,
      ← RingHom.map_det, hdetM, map_one]
  let k : SL(6, L) := ⟨ML, hdetML⟩
  have hunit : Matrix.transpose (M.map σF) * M = 1 := by
    simpa [CFSG.LieType.Universal.Unitary.conjTr] using h.2.2
  have hunitL : Matrix.transpose (ML.map σ.toRingHom) * ML = 1 := by
    have hmapσ : ML.map σ.toRingHom = (M.map σF).map F.subtype := by
      ext i j
      simp only [ML, M, Matrix.map_apply, RingEquiv.toRingHom_eq_coe,
        RingEquiv.coe_toRingHom]
      rfl
    calc Matrix.transpose (ML.map σ.toRingHom) * ML
        = Matrix.transpose ((M.map σF).map F.subtype) * M.map F.subtype := by rw [hmapσ]
      _ = (Matrix.transpose (M.map σF)).map F.subtype * M.map F.subtype := by
            rw [Matrix.transpose_map]
      _ = (Matrix.transpose (M.map σF) * M).map F.subtype := by rw [Matrix.map_mul]
      _ = (1 : Matrix (Fin 6) (Fin 6) F).map F.subtype := by rw [hunit]
      _ = 1 := by simp
  have hinv : (ML.map σ.toRingHom)⁻¹ = Matrix.transpose ML := by
    apply Matrix.inv_eq_left_inv
    have h := congrArg Matrix.transpose hunitL
    simpa only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] using h
  have hstd : stdUnitary σ.toRingHom k = k := by
    apply Subtype.ext
    rw [coe_stdUnitary]
    change Matrix.transpose ((ML.map σ.toRingHom)⁻¹) = ML
    rw [hinv, Matrix.transpose_transpose]
  refine ⟨k, hstd, (l : L), ?_, ?_, ?_, ?_⟩
  · intro hzero
    exact hl (Subtype.ext hzero)
  · change ML.mulVec (u 0) = (l : L) • u' 0
    have hv : ML.mulVec (u 0) = fun i => F.subtype ((M.mulVec (uF 0)) i) := by
      ext i
      change (M.map F.subtype).mulVec (F.subtype ∘ uF 0) i =
        F.subtype ((M.mulVec (uF 0)) i)
      rw [← RingHom.map_mulVec F.subtype M (uF 0) i]
    rw [hv, h0]
    ext i
    simp [Pi.smul_apply, smul_eq_mul, u'F]
  · change ML.mulVec (u 1) = u' 1
    have hv : ML.mulVec (u 1) = fun i => F.subtype ((M.mulVec (uF 1)) i) := by
      ext i
      change (M.map F.subtype).mulVec (F.subtype ∘ uF 1) i =
        F.subtype ((M.mulVec (uF 1)) i)
      rw [← RingHom.map_mulVec F.subtype M (uF 1) i]
    rw [hv, h1]
    ext i
    simp [u'F]
  · change ML.mulVec (u 2) = u' 2
    have hv : ML.mulVec (u 2) = fun i => F.subtype ((M.mulVec (uF 2)) i) := by
      ext i
      change (M.map F.subtype).mulVec (F.subtype ∘ uF 2) i =
        F.subtype ((M.mulVec (uF 2)) i)
      rw [← RingHom.map_mulVec F.subtype M (uF 2) i]
    rw [hv, h2]
    ext i
    simp [u'F]

end CFSG.StandardType.LieKnownR2.ExcPos.ExcU7
