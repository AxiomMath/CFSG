@[expose] def d9cS (k : Fin 8) : Vn 8 ≃ₗ[ZMod 3] Vn 8 := letLin (letAt d9cGens k)

theorem d9c_certOK : certOK d9cGens (oneN 8) d9cSets d9cPats d9cReps d9cS2 = true := by
  decide +kernel

theorem d9c_cov : permCovB 8 d9cPats = true := by
  decide +kernel

theorem d9c_adj : ∀ i : Fin 7, letAt d9cGens i =
    (Pi.single i.castSucc 1 - Pi.single i.succ 1, Pi.single i.castSucc 1 - Pi.single i.succ 1) := by
  decide +kernel

theorem d9c_test : ∀ A Mg : Subgroup (Vn 8 ≃ₗ[ZMod 3] Vn 8),
    TestHyp (Subgroup.closure (Set.range d9cS)) (oneN 8) A Mg →
    ∀ r ∈ Mg, IsRefl r → ¬ FixesLine (oneN 8) r →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (oneN 8) t → t ∈ Mg :=
  linTest_perm_of_certOK d9cS d9cGens rfl (fun _ => rfl)
    (permGroup_le_of_gens d9cS d9cGens (fun _ => rfl) (by norm_num) d9c_adj)
    d9c_certOK d9c_cov

end CFSG.StandardType.TestLin

