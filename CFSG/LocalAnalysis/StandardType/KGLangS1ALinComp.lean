private theorem kgLangS1ALinCompAux_slFieldAut_apply {d : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) (x : Matrix.SpecialLinearGroup (Fin d) F) :
    (CFSG.ComponentClassification.CatalogueBHigherLinearField.slFieldAut (Fin d) F σ) x =
      Matrix.SpecialLinearGroup.map σ.toRingHom x := rfl

private theorem kgLangS1ALinCompAux_map_injective {d : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) :
    Function.Injective (Matrix.SpecialLinearGroup.map (semilinearFixedSubfield σ).subtype :
      Matrix.SpecialLinearGroup (Fin d) (semilinearFixedSubfield σ) →*
        Matrix.SpecialLinearGroup (Fin d) F) := by
  intro a b h
  apply Subtype.ext
  ext i j
  have := congrArg (fun x : Matrix.SpecialLinearGroup (Fin d) F =>
    (x : Matrix (Fin d) (Fin d) F) i j) h
  simpa [Matrix.SpecialLinearGroup.map_apply_coe] using this

private theorem kgLangS1ALinCompAux_toGL_map {d : ℕ} {R S : Type} [CommRing R] [CommRing S]
    (φ : R →+* S) (g : Matrix.SpecialLinearGroup (Fin d) R) :
    Matrix.SpecialLinearGroup.toGL (Matrix.SpecialLinearGroup.map φ g) =
      Matrix.GeneralLinearGroup.map φ (Matrix.SpecialLinearGroup.toGL g) := by
  apply Units.ext
  ext i j
  rfl

private theorem kgLangS1ALinCompAux_fixSubgroup_eq_fieldFixed {d : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) :
    CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
        (CFSG.ComponentClassification.CatalogueBHigherLinearField.slFieldAut (Fin d) F σ) =
      CFSG.ComponentClassification.Burgoyne.PSL.fieldFixedSL d σ := by
  ext g
  rw [CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup,
    CFSG.ComponentClassification.Burgoyne.PSL.mem_fieldFixedSL]
  constructor
  · intro hg i j
    have h1 := congrArg (fun x : Matrix.SpecialLinearGroup (Fin d) F =>
      (x : Matrix (Fin d) (Fin d) F) i j) hg
    rw [kgLangS1ALinCompAux_slFieldAut_apply σ] at h1
    rw [Matrix.SpecialLinearGroup.map_apply_coe] at h1
    exact h1
  · intro hg
    apply Subtype.ext
    ext i j
    rw [kgLangS1ALinCompAux_slFieldAut_apply σ, Matrix.SpecialLinearGroup.map_apply_coe]
    exact hg i j

private theorem kgLangS1ALinCompAux_fixSubgroup_eq_range {d : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) :
    CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
        (CFSG.ComponentClassification.CatalogueBHigherLinearField.slFieldAut (Fin d) F σ) =
      (Matrix.SpecialLinearGroup.map (semilinearFixedSubfield σ).subtype :
        Matrix.SpecialLinearGroup (Fin d) (semilinearFixedSubfield σ) →*
          Matrix.SpecialLinearGroup (Fin d) F).range := by
  rw [kgLangS1ALinCompAux_fixSubgroup_eq_fieldFixed σ,
    ← CFSG.ComponentClassification.Burgoyne.PSL.range_map_fixField (n := d) σ]
  rfl

private theorem kgLangS1ALinCompAux_slConj_compat {d : ℕ} {F : Type} [Field F]
    (σ : F ≃+* F) (c : Fˣ) (M : GL (Fin d) (semilinearFixedSubfield σ))
    (h : Matrix.SpecialLinearGroup (Fin d) (semilinearFixedSubfield σ)) :
    CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F
        (Matrix.GeneralLinearGroup.scalar (Fin d) c *
          Matrix.GeneralLinearGroup.map (semilinearFixedSubfield σ).subtype M)
        (Matrix.SpecialLinearGroup.map (semilinearFixedSubfield σ).subtype h) =
      Matrix.SpecialLinearGroup.map (semilinearFixedSubfield σ).subtype
        (CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d
          (semilinearFixedSubfield σ) M h) := by
  have hA : CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F
        (Matrix.GeneralLinearGroup.scalar (Fin d) c *
          Matrix.GeneralLinearGroup.map (semilinearFixedSubfield σ).subtype M) =
      CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F
        (Matrix.GeneralLinearGroup.map (semilinearFixedSubfield σ).subtype M) := by
    rw [map_mul, CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation_scalar,
      one_mul]
  rw [hA]
  apply Matrix.SpecialLinearGroup.toGL_injective
  rw [kgLangS1ALinCompAux_toGL_map,
    CFSG.ComponentClassification.CatalogueBHigherLinearAction.toGL_slConjugation,
    kgLangS1ALinCompAux_toGL_map,
    CFSG.ComponentClassification.CatalogueBHigherLinearAction.toGL_slConjugation]
  simp only [map_mul, map_inv]

theorem kgLangS1A_lin_component {d : ℕ} {F : Type} [Field F] [Finite F] (hd : 3 ≤ d)
    {σ : F ≃+* F} {K : Type} [Group K] [Finite K]
    (κ : Matrix.SpecialLinearGroup (Fin d) F →* K) (hκ : Function.Surjective κ)
    (hker : κ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F))
    {ξ : MulAut K} (hξ : ∀ h, ξ (κ h) = κ (Matrix.SpecialLinearGroup.map σ.toRingHom h))
    {J₀ : Subgroup K} (hJ₀ : IsComponentOf J₀ (ggFixSub ξ)) :
    ∃ ρ : ↥J₀ ⧸ Subgroup.center ↥J₀ ≃* LinearFlag.projectiveSL d (semilinearFixedSubfield σ),
      ∀ (β : MulAut K) (c : Fˣ) (M : GL (Fin d) (semilinearFixedSubfield σ)),
        (∀ h, β (κ h) = κ (CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F
          (Matrix.GeneralLinearGroup.scalar (Fin d) c *
            Matrix.GeneralLinearGroup.map (semilinearFixedSubfield σ).subtype M) h)) →
        ∀ j : ↥J₀, ∃ j' : ↥J₀, (j' : K) = β j ∧
          ρ (QuotientGroup.mk j') =
            LinearFlag.conjAut d (semilinearFixedSubfield σ) M (ρ (QuotientGroup.mk j)) := by
  classical
  haveI : Fintype F := Fintype.ofFinite F
  let F₀ := semilinearFixedSubfield σ
  let ι : Matrix.SpecialLinearGroup (Fin d) F₀ →* Matrix.SpecialLinearGroup (Fin d) F :=
    Matrix.SpecialLinearGroup.map F₀.subtype
  let α : MulAut (Matrix.SpecialLinearGroup (Fin d) F) :=
    CFSG.ComponentClassification.CatalogueBHigherLinearField.slFieldAut (Fin d) F σ
  have hαβ : ∀ x, κ (α x) = ξ (κ x) := by
    intro x
    rw [show α x = Matrix.SpecialLinearGroup.map σ.toRingHom x from kgLangS1ALinCompAux_slFieldAut_apply σ x]
    exact (hξ x).symm
  have hfix : CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α = ι.range :=
    kgLangS1ALinCompAux_fixSubgroup_eq_range (d := d) (F := F) σ
  have hmapinj : Function.Injective ι := kgLangS1ALinCompAux_map_injective (d := d) (F := F) σ
  have hquasiSL : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup (Fin d) F₀) :=
    CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_quasisimple d F₀
      (by omega) (Or.inl (by omega)) (Or.inl (by omega))
  have hperf : commutator (Matrix.SpecialLinearGroup (Fin d) F₀) = ⊤ :=
    hquasiSL.1.commutator_eq_top
  have hq : CFSG.IsQuasisimple ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      ((MonoidHom.ofInjective hmapinj).trans (MulEquiv.subgroupCongr hfix.symm)) hquasiSL
  let ψtriv : ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α) →* Unit := 1
  have hψtriv : ∀ x : ↥(CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α),
      ψtriv x = 1 → (x : Matrix.SpecialLinearGroup (Fin d) F) ∈
        ⨆ _ : PUnit, CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α := by
    intro x _
    exact Subgroup.mem_iSup_of_mem () x.2
  obtain ⟨i, hi⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.components_of_centralQuotient
      κ hκ hker α ξ hαβ (fun _ : PUnit => CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α)
      (fun _ => le_rfl)
      (fun _ c hc g hg => (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α).mul_mem
        ((CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α).mul_mem hc hg)
        ((CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup α).inv_mem hc))
      (fun _ => hq) ψtriv hψtriv
      J₀ (Assembly.isComponentOf_iff_open.mp hJ₀)
  have hJ₀eq : J₀ = (κ.comp ι).range := by
    rw [hi, hfix, MonoidHom.range_comp]
  let κ₀ : Matrix.SpecialLinearGroup (Fin d) F₀ →* K := κ.comp ι
  have hrange : J₀ = κ₀.range := hJ₀eq
  let fbase : Matrix.SpecialLinearGroup (Fin d) F₀ →* ↥J₀ :=
    { toFun := fun h => ⟨κ₀ h, by rw [hrange]; exact ⟨h, rfl⟩⟩
      map_one' := Subtype.ext (map_one κ₀)
      map_mul' := fun a b => Subtype.ext (map_mul κ₀ a b) }
  have hfbase_surj : Function.Surjective fbase := by
    intro y
    have hy : (y : K) ∈ κ₀.range := by rw [← hrange]; exact y.2
    obtain ⟨h, hh⟩ := hy
    exact ⟨h, Subtype.ext hh⟩
  have hker_fbase : fbase.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) := by
    intro h hh
    rw [MonoidHom.mem_ker] at hh
    have h1 : κ₀ h = 1 := congrArg Subtype.val hh
    have h2 : ι h ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F) :=
      hker (by rw [MonoidHom.mem_ker]; exact h1)
    rw [Subgroup.mem_center_iff] at h2 ⊢
    intro x
    apply hmapinj
    rw [map_mul, map_mul]
    exact h2 (ι x)
  let Φ : Matrix.SpecialLinearGroup (Fin d) F₀ →* ↥J₀ ⧸ Subgroup.center ↥J₀ :=
    (QuotientGroup.mk' (Subgroup.center ↥J₀)).comp fbase
  have hmapcenter : (Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀)).map fbase =
      Subgroup.center ↥J₀ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.map_center_of_surjective hperf fbase
      hfbase_surj hker_fbase
  have hkerΦ : Φ.ker = Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) := by
    ext h
    change QuotientGroup.mk (fbase h) = 1 ↔ h ∈
      Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀)
    rw [QuotientGroup.eq_one_iff, ← hmapcenter, Subgroup.mem_map]
    constructor
    · rintro ⟨x, hx, hfx⟩
      have hmem : x * h⁻¹ ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) :=
        hker_fbase (by
          rw [MonoidHom.mem_ker, map_mul, map_inv, hfx, mul_inv_cancel])
      have : h * x⁻¹ ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) := by
        simpa [mul_inv_rev, inv_inv] using Subgroup.inv_mem _ hmem
      simpa using Subgroup.mul_mem _ this hx
    · intro hh
      exact ⟨h, hh, rfl⟩
  let ΦbarHom : Matrix.SpecialLinearGroup (Fin d) F₀ ⧸
        Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) →*
      (↥J₀ ⧸ Subgroup.center ↥J₀) :=
    QuotientGroup.lift (Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀)) Φ
      (le_of_eq hkerΦ.symm)
  have hΦbarHom_mk : ∀ h, ΦbarHom (QuotientGroup.mk h) = QuotientGroup.mk (fbase h) := by
    intro h
    rw [QuotientGroup.lift_mk]
    rfl
  have hΦbar_surj : Function.Surjective ΦbarHom := by
    intro y
    obtain ⟨j, rfl⟩ := QuotientGroup.mk_surjective y
    obtain ⟨h, rfl⟩ := hfbase_surj j
    exact ⟨QuotientGroup.mk h, hΦbarHom_mk h⟩
  have hΦbar_inj : Function.Injective ΦbarHom := by
    intro a b hab
    obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective b
    rw [hΦbarHom_mk, hΦbarHom_mk] at hab
    have h1 : (fbase h)⁻¹ * fbase k ∈ Subgroup.center ↥J₀ := QuotientGroup.eq.mp hab
    have h2 : fbase (h⁻¹ * k) ∈ Subgroup.center ↥J₀ := by
      rw [map_mul, map_inv]; exact h1
    rw [← hmapcenter, Subgroup.mem_map] at h2
    obtain ⟨z, hz, hfz⟩ := h2
    have h3 : z⁻¹ * (h⁻¹ * k) ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) :=
      hker_fbase (by rw [MonoidHom.mem_ker, map_mul, map_inv, hfz, inv_mul_cancel])
    have h4 : h⁻¹ * k ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) := by
      have := Subgroup.mul_mem _ hz h3
      convert this using 1
      group
    exact QuotientGroup.eq.mpr h4
  let Φbar : Matrix.SpecialLinearGroup (Fin d) F₀ ⧸
        Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) ≃* (↥J₀ ⧸ Subgroup.center ↥J₀) :=
    MulEquiv.ofBijective ΦbarHom ⟨hΦbar_inj, hΦbar_surj⟩
  have hΦbar_mk : ∀ h, Φbar (QuotientGroup.mk h) = QuotientGroup.mk (fbase h) := hΦbarHom_mk
  let ψ : Matrix.SpecialLinearGroup (Fin d) F₀ ⧸
        Subgroup.center (Matrix.SpecialLinearGroup (Fin d) F₀) ≃*
      LinearFlag.projectiveSL d F₀ :=
    QuotientGroup.quotientMulEquivOfEq (LinearFlag.scalars_eq_center d F₀).symm
  let ρ : ↥J₀ ⧸ Subgroup.center ↥J₀ ≃* LinearFlag.projectiveSL d F₀ :=
    Φbar.symm.trans ψ
  have hψ_mk : ∀ h, ψ (QuotientGroup.mk h) = LinearFlag.proj d F₀ h := by
    intro h
    rw [show ψ (QuotientGroup.mk h) =
      QuotientGroup.quotientMulEquivOfEq (LinearFlag.scalars_eq_center d F₀).symm
        (QuotientGroup.mk h) from rfl]
    rw [QuotientGroup.quotientMulEquivOfEq_mk]
    rfl
  have hρ_formula : ∀ h, ρ (QuotientGroup.mk (fbase h)) = LinearFlag.proj d F₀ h := by
    intro h
    change ψ (Φbar.symm (QuotientGroup.mk (fbase h))) = LinearFlag.proj d F₀ h
    rw [show QuotientGroup.mk (fbase h) = Φbar (QuotientGroup.mk h) from (hΦbar_mk h).symm]
    rw [MulEquiv.symm_apply_apply]
    exact hψ_mk h
  refine ⟨ρ, ?_⟩
  intro β c M hβ j
  obtain ⟨h, rfl⟩ := hfbase_surj j
  refine ⟨fbase (CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F₀ M h),
    ?_, ?_⟩
  · change κ (ι (CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F₀ M h)) =
      β (κ (ι h))
    rw [hβ (ι h)]
    congr 1
    exact (kgLangS1ALinCompAux_slConj_compat (d := d) (F := F) σ c M h).symm
  · rw [hρ_formula (CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation d F₀ M h),
      hρ_formula h]
    exact (LinearFlag.conjAut_proj M h).symm

end CFSG.StandardType
