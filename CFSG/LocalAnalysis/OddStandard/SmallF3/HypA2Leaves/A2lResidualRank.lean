namespace CFSG.OddStandard.SmallF3.HypA2Leaves

open Subgroup CFSG.Blueprint

theorem a2l_four_le_pRank_hs {K : Type} [Group K] [Finite K]
    (hZ : IsPGroup 2 ↥(center K)) (hc : center K ≠ ⊥)
    (hHS : NativeSporadic.IsSporadic (K ⧸ center K) .HS) : 4 ≤ CFSG.pRank 2 K := by
  obtain ⟨e⟩ := hHS
  obtain ⟨a₁, a₂, a₃, n, hd⟩ := RankThree.PartTwo.Sec4.Census.DoubleCoverRanks.hs_e8Datum
  obtain ⟨z, hzc, hz1, hz2⟩ := a2l_exists_central_involution hZ hc
  exact a2l_four_le_pRank_of_e8Datum hd e hzc hz1 hz2


theorem residualTwoRank_holds : HypA2.ResidualTwoRank := by
  intro K _ _ hK hZ hR
  by_cases hc : center K = ⊥
  · exact ⟨a2l_two_le_pRank_of_center_bot hK hc, fun h => absurd hc h⟩
  · have h3 : 3 ≤ CFSG.pRank 2 K := by
      rcases hR with ⟨hc', -⟩ | ⟨m, -, hc', -⟩ | hHS | hSp | hL5 | hU5 | hG2 | hL4
      · exact absurd hc' hc
      · exact absurd hc' hc
      · have := a2l_four_le_pRank_hs hZ hc hHS
        omega
      · exact absurd (a2l_center_eq_bot_psp44 hK hSp) hc
      · exact absurd (a2l_center_eq_bot_psl52 hK hL5) hc
      · exact absurd (a2l_center_eq_bot_psu52 hK hU5) hc
      · exact a2l_three_le_pRank_g2 hK hc hG2
      · exact absurd (ComponentClassification.CatFC.center_eq_bot_of_quasisimple_psl44 hK hL4) hc
    exact ⟨by omega, fun _ => h3⟩

end CFSG.OddStandard.SmallF3.HypA2Leaves
