@[expose] def a2lSplits (M : Type) [Group M] : Prop :=
  ∀ (E : Type) [Group E] [Finite E] (π : E →* M), Function.Surjective π →
    π.ker ≤ center E → IsPGroup 2 π.ker → ∃ σ : M →* E, ∀ x, π (σ x) = x

theorem a2lSplits_of_mulEquiv {M M' : Type} [Group M] [Group M'] (ι : M ≃* M')
    (h : a2lSplits M) : a2lSplits M' := by
  intro E _ _ π hπ hker h2
  have hk : (ι.symm.toMonoidHom.comp π).ker = π.ker := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      map_eq_one_iff _ ι.symm.injective]
  obtain ⟨σ, hσ⟩ := h E (ι.symm.toMonoidHom.comp π) (ι.symm.surjective.comp hπ) (hk ▸ hker)
    (hk ▸ h2)
  refine ⟨σ.comp ι.symm.toMonoidHom, fun x => ?_⟩
  have := hσ (ι.symm x)
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom] at this ⊢
  exact ι.symm.injective this

theorem a2l_ringChar_ne_two {F : Type} [Field F] [Fintype F] (h : Odd (Fintype.card F)) :
    ringChar F ≠ 2 := by
  intro h2
  have h1 : Fintype.card F % 2 = 0 := FiniteField.even_card_iff_char_two.1 h2
  exact (Nat.not_even_iff_odd.2 h) (Nat.even_iff.2 h1)

theorem a2l_unitaryFieldData_three {F : Type} [Field F] (hF : Nat.card F = (3 ^ 1) ^ 2) :
    UnitaryFieldData 3 1 F :=
  ⟨Nat.prime_three, le_rfl, by rw [hF]; norm_num⟩

theorem a2l_splits_statedSL {F : Type} [Field F] [Finite F] (hk : ringChar F ≠ 2) {n : ℕ}
    (hn : 1 ≤ n) : a2lSplits (StatedSL n F) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  refine a2lSplits_of_mulEquiv (specialLinearGroupEquivStatedSL (m + 1) F) ?_
  intro E _ _ π hπ hker h2
  obtain ⟨σ, hσ, -, -⟩ := LieType.Steinberg.sl_central_two_extension_splitting m hk hπ hker h2
  exact ⟨σ, hσ⟩

theorem a2l_splits_statedSp {F : Type} [Field F] [Finite F] (hk : ringChar F ≠ 2) (r : ℕ) :
    a2lSplits (StatedSp r F) := by
  intro E _ _ π hπ hker h2
  obtain ⟨σ, hσ, -, -⟩ :=
    LieType.Steinberg.odd_symplectic_central_two_extension_splitting hk r hπ hker h2
  exact ⟨σ, hσ⟩

theorem a2l_splits_statedSU {F : Type} [Field F] [Finite F] {p f : ℕ} [Fact p.Prime] [CharP F p]
    (hF : Nat.card F = (p ^ f) ^ 2) (hp2 : p ≠ 2) {n : ℕ} (hn : 2 ≤ n) :
    a2lSplits (StatedSU n (p ^ f) F) := by
  refine a2lSplits_of_mulEquiv (LieType.Universal.Unitary.equivStatedSU hF n) ?_
  intro E _ _ π hπ hker h2
  obtain ⟨σ, hσ, -, -⟩ :=
    LieType.Steinberg.su_central_two_extension_splitting hF hp2 hn hπ hker h2
  exact ⟨σ, hσ⟩

theorem a2l_nonempty_equiv_of_cover {K M : Type} [Group K] [Finite K] [Group.IsPerfect K]
    [Group M] [Finite M] (hsplit : a2lSplits M) (h2 : IsPGroup 2 ↥(center K))
    (N : Subgroup M) [N.Normal] (e : K ⧸ center K ≃* M ⧸ N) {m : ℕ}
    (hN : Nat.card N < 2 * m) (hm : m ≤ Nat.card (center K)) : Nonempty (K ≃* M) := by
  obtain ⟨α, hαs, hle, hZ, -⟩ := a2l_cover hsplit h2 N e
  have hker : α.ker = ⊥ := a2l_ker_eq_bot α N hle hN (hZ ▸ hm)
  exact ⟨(MulEquiv.ofBijective α ⟨(MonoidHom.ker_eq_bot_iff α).1 hker, hαs⟩).symm⟩

theorem a2l_center_eq_bot_of_cover {K M : Type} [Group K] [Finite K] [Group.IsPerfect K]
    [Group M] [Finite M] (hsplit : a2lSplits M) (h2 : IsPGroup 2 ↥(center K))
    (N : Subgroup M) [N.Normal] (e : K ⧸ center K ≃* M ⧸ N) (hN : N = ⊥) : center K = ⊥ := by
  obtain ⟨α, -, -, hZ, -⟩ := a2l_cover hsplit h2 N e
  rw [hZ, hN, Subgroup.map_bot]

theorem a2l_two_le_card_center {K : Type} [Group K] [Finite K] (h2 : IsPGroup 2 ↥(center K))
    (hZ : center K ≠ ⊥) : 2 ≤ Nat.card (center K) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨n, hn⟩ := h2.exists_card_eq
  have hn0 : n ≠ 0 := fun h0 => hZ (Subgroup.card_eq_one.1 (by rw [hn, h0, pow_zero]))
  rw [hn]
  calc 2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (Nat.one_le_iff_ne_zero.2 hn0)

theorem a2l_mem_center_of_equiv {G H : Type} [Group G] [Group H] (e : G ≃* H) {x : G}
    (hx : x ∈ center G) : e x ∈ center H := by
  have h : (center G).map e.toMonoidHom = center H := Subgroup.map_center_eq e
  rw [← h]
  exact Subgroup.mem_map_of_mem e.toMonoidHom hx

theorem a2l_centralDatum_of_equiv {K M : Type} [Group K] [Group M] (ψ : K ≃* M) {F : Type}
    [Field F] [Fintype F] {q₀ : ℕ} (hodd : Odd q₀) (h5 : 5 ≤ q₀) (hF : Fintype.card F = q₀)
    (φ₀ : SL(2, F) →* M) (hφ₀ : Function.Injective φ₀) (hz : φ₀ (a2lNegOne F) ∈ center M)
    (hTU : HypA2.TypU K) : HypA2.CentralDatum K :=
  a2l_centralDatum_of_embedding hodd h5 hF (ψ.symm.toMonoidHom.comp φ₀)
    (ψ.symm.injective.comp hφ₀) (a2l_mem_center_of_equiv ψ.symm hz) hTU

theorem a2l_scalars_sl_three_eq_bot {F : Type} [Field F] [Fintype F] (hF : Fintype.card F = 3) :
    (StatedScalars (Fin 3) F).subgroupOf (StatedSL 3 F) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨c, hc⟩ := Subgroup.mem_subgroupOf.1 hx
  have hdet := Open.StatedAPI.det_of_mem_statedSL x.2
  rw [← hc, Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, Matrix.det_diagonal,
    Finset.prod_const, Finset.card_univ, Fintype.card_fin] at hdet
  have h2 : ((c : Fˣ) : F) ^ Fintype.card F = (c : F) := FiniteField.pow_card _
  rw [hF, hdet] at h2
  have hc1 : c = 1 := Units.ext h2.symm
  rw [Subgroup.mem_bot]
  refine Subtype.ext ?_
  rw [← hc, hc1, map_one]
  rfl

theorem a2l_scalars_su_three_eq_bot {F : Type} [Field F] [Finite F] [CharP F 3]
    (hF : Nat.card F = 9) : (StatedScalars (Fin 3) F).subgroupOf (StatedSU 3 (3 ^ 1) F) = ⊥ := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨-, hexp⟩ := LieType.Steinberg.isCyclic_scalars_statedSU (K := F) (p := 3) (f := 1)
    (by rw [hF]; norm_num) (n := 3) (by norm_num)
  rw [eq_bot_iff]
  intro z hz
  have h1 := hexp ⟨z, hz⟩
  rw [show Nat.gcd 3 (3 ^ 1 + 1) = 1 by norm_num] at h1
  have h1' := (pow_one (⟨z, hz⟩ : (StatedScalars (Fin 3) F).subgroupOf
    (StatedSU 3 (3 ^ 1) F))).symm.trans h1
  rw [Subgroup.mem_bot]
  exact congrArg Subtype.val h1'

theorem a2l_card_scalars_su_four_le {F : Type} [Field F] [Finite F] [CharP F 3]
    (hF : Nat.card F = 9) :
    Nat.card ((StatedScalars (Fin 4) F).subgroupOf (StatedSU 4 (3 ^ 1) F)) ≤ 4 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hcyc, hexp⟩ := LieType.Steinberg.isCyclic_scalars_statedSU (K := F) (p := 3) (f := 1)
    (by rw [hF]; norm_num) (n := 4) (by norm_num)
  obtain ⟨z, hz⟩ := hcyc.exists_generator
  rw [← orderOf_eq_card_of_forall_mem_zpowers hz]
  refine Nat.le_of_dvd (by norm_num) (orderOf_dvd_of_pow_eq_one ?_)
  have := hexp z
  rwa [show Nat.gcd 4 (3 ^ 1 + 1) = 4 by norm_num] at this

theorem a2l_card_scalars_sp_four {F : Type} [Field F] [Finite F] (hF : Odd (Nat.card F)) :
    Nat.card ((StatedScalars (Fin 2 ⊕ Fin 2) F).subgroupOf (StatedSp 2 F)) = 2 := by
  have h1 : (StatedScalars (Fin 2 ⊕ Fin 2) F).subgroupOf (StatedSp 2 F) =
      (StatedSp 2 F ⊓ StatedScalars (Fin 2 ⊕ Fin 2) F).subgroupOf (StatedSp 2 F) := by
    rw [Subgroup.inf_subgroupOf_left]
  rw [h1, Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_left).toEquiv,
    LieType.Classical.card_statedSp_inf_statedScalars (by norm_num : 1 ≤ 2),
    LieType.Classical.card_sq_eq_one_units]
  obtain ⟨m, hm⟩ := hF
  rw [hm, Nat.add_sub_cancel]
  exact Nat.gcd_eq_left (dvd_mul_right 2 m)

