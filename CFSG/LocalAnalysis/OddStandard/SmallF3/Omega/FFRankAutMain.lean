private theorem ffOutFFRankAutMain_elemAbelian {K : Type} [Group K] {X : Subgroup (MulAut K)}
    (hsq : ∀ x ∈ X, x * x = 1) : CFSG.Open.IsElemAbelian 2 X := by
  have hc : ∀ x ∈ X, ∀ y ∈ X, x * y = y * x := by
    intro x hx y hy
    have hx2 : x * x = 1 := hsq x hx
    have hy2 : y * y = 1 := hsq y hy
    have hxy : x * y * (x * y) = 1 := hsq (x * y) (mul_mem hx hy)
    calc x * y = (x * y)⁻¹ := (inv_eq_of_mul_eq_one_left hxy).symm
      _ = y⁻¹ * x⁻¹ := mul_inv_rev x y
      _ = y * x := by rw [inv_eq_of_mul_eq_one_left hx2, inv_eq_of_mul_eq_one_left hy2]
  refine ⟨⟨⟨fun a b => Subtype.ext (hc a.1 a.2 b.1 b.2)⟩⟩, fun x hx => ?_⟩
  simpa [pow_two] using hsq x hx

private theorem ffOutFFRankAutMain_isSimple {K : Type} [Group K] {t : CFSG.Open.StatedLieTag}
    {n p f : ℕ} (h : CFSG.Open.StatedClassicalModel K t n p f) : IsSimpleGroup K :=
  (CFSG.LieType.Simplicity.fam_classical_converse K ⟨t, n, p, f, h⟩).2.2

private theorem ffOutFFRankAutMain_l29 {K : Type} [Group K] (hK : LieModel K .PSL 2 3 2)
    (X : Subgroup (MulAut K)) (hsq : ∀ x ∈ X, x * x = 1) : Nat.card X ≤ 8 := by
  obtain ⟨e⟩ := CFSG.Open.StatedAPI.nonempty_mulEquiv_alternating_six_of_psl_two_nine
    (hK.statedClassicalModel_of_ne_zero (by norm_num))
  exact CFSG.Quasithin.card_le_eight_of_alt_six e (ffOutFFRankAutMain_elemAbelian hsq)

private theorem ffOutFFRankAutMain_l281 {K : Type} [Group K] [Finite K]
    (hK : LieModel K .PSL 2 3 4) (X : Subgroup (MulAut K))
    (hsq : ∀ x ∈ X, x * x = 1) : Nat.card X ≤ 8 :=
  ffRA_aut_psl281_elemAb_le_eight hK X hsq

private theorem ffOutFFRankAutMain_l281_ab {K : Type} [Group K] [Finite K]
    (hK : LieModel K .PSL 2 3 4) (X : Subgroup (MulAut K))
    (hp : IsPGroup 2 X) (hc : IsMulCommutative X) : Nat.card X ≤ 16 :=
  aut_psl281_abelian_two_le_16 hK X hp hc

private theorem ffOutFFRankAutMain_l33 {K : Type} [Group K] [Finite K]
    (hK : LieModel K .PSL 3 3 1) (X : Subgroup (MulAut K))
    (hsq : ∀ x ∈ X, x * x = 1) : Nat.card X ≤ 8 :=
  CFSG.Quasithin.card_le_eight_of_isPSL_three_three
    (hK.statedClassicalModel_of_ne_zero (by norm_num)) (ffOutFFRankAutMain_elemAbelian hsq)

private theorem ffOutFFRankAutMain_u33 {K : Type} [Group K] [Finite K]
    (hK : LieModel K .PSU 3 3 1) (X : Subgroup (MulAut K))
    (hsq : ∀ x ∈ X, x * x = 1) : Nat.card X ≤ 8 :=
  CFSG.GH74.GLS.Stage2.Signalizer.Ivk8.L1.fu3_elemAbelian_le_eight
    ⟨3, 1, Nat.prime_three, le_rfl, by norm_num, hK⟩ X
    ((CFSG.Open.isElemAbelian_iff_isElementaryAbelian (p := 2) (E := X)).mp
      (ffOutFFRankAutMain_elemAbelian hsq))

private theorem ffOutFFRankAutMain_omega5
    {K : Type} [Group K] (hK : LieModel K .PSp 2 3 1) (X : Subgroup (MulAut K))
    (hp : IsPGroup 2 X) (hc : IsMulCommutative X) : Nat.card X ≤ 16 :=
  card_le_16_of_psp43 hK X hp hc

private theorem ffOutFFRankAutMain_omega6plus
    {K : Type} [Group K] (hK : LieModel K .PSL 4 3 1) (X : Subgroup (MulAut K))
    (hp : IsPGroup 2 X) (hc : IsMulCommutative X) : Nat.card X ≤ 32 := by
  obtain ⟨V, i1, i2, i3, Q, hQ, hdim, hsgn, ⟨e⟩⟩ := isOmegaStar_of_lieModel_psl hK
  let X' : Subgroup (MulAut ↥(omegaProj hQ)) := X.map (MulAut.congr e).toMonoidHom
  have hp' : IsPGroup 2 X' := hp.map _
  have hc' : IsMulCommutative X' := Subgroup.map_isMulCommutative X _
  have h := ffRA_mulAut_omega_plus Certificates.certificate442274 hQ hdim hsgn X' hp' hc'
  rwa [Subgroup.card_map_of_injective (MulAut.congr e).injective] at h

private theorem ffOutFFRankAutMain_omega6minus
    {K : Type} [Group K] (hK : LieModel K .PSU 4 3 1) (X : Subgroup (MulAut K))
    (hsq : ∀ x ∈ X, x * x = 1) : Nat.card X ≤ 32 := by
  obtain ⟨V, i1, i2, i3, Q, hQ, hdim, hsgn, ⟨e⟩⟩ := isOmegaStar_of_lieModel_psu hK
  let X' : Subgroup (MulAut ↥(omegaProj hQ)) := X.map (MulAut.congr e).toMonoidHom
  have hsq' : ∀ x ∈ X', x * x = 1 := by
    rintro _ ⟨x, hx, rfl⟩
    rw [← map_mul, hsq x hx, map_one]
  have h := ffRA_mulAut_omega_minus Certificates.certificate442274 hQ hdim hsgn X' hsq'
  rwa [Subgroup.card_map_of_injective (MulAut.congr e).injective] at h

theorem ffRankAut_of_cert :
    ∀ (G : Type) [Group G] [Finite G] (Y E : Subgroup G), IsQuasisimple Y →
    E ≤ normalizer (Y : Set G) → CFSG.Open.IsElemAbelian 2 E →
      ((IsL29 Y ∨ IsL281 Y ∨ IsL3Eps3 Y) →
        CFSG.Open.pRank 2 E ≤ CFSG.Open.pRank 2 (E ⊓ centralizer (Y : Set G)) + 3) ∧
      (IsOmega5 Y → CFSG.Open.pRank 2 E ≤ CFSG.Open.pRank 2 (E ⊓ centralizer (Y : Set G)) + 4) ∧
      ((IsOmega6Plus Y ∨ IsOmega6Minus Y) →
        CFSG.Open.pRank 2 E ≤ CFSG.Open.pRank 2 (E ⊓ centralizer (Y : Set G)) + 5) := by
  intro G _ _ Y E hY hEN hE
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · rcases h with hK | hK | hK | hK
    · refine ffRA_rank_of_aut hY
        (ffOutFFRankAutMain_isSimple (hK.statedClassicalModel_of_ne_zero (by norm_num)))
        hEN hE (b := 3) fun X hx => ?_
      simpa using ffOutFFRankAutMain_l29 hK X hx
    · refine ffRA_rank_of_aut hY
        (ffOutFFRankAutMain_isSimple (hK.statedClassicalModel_of_ne_zero (by norm_num)))
        hEN hE (b := 3) fun X hx => ?_
      simpa using ffOutFFRankAutMain_l281 hK X hx
    · refine ffRA_rank_of_aut hY
        (ffOutFFRankAutMain_isSimple (hK.statedClassicalModel_of_ne_zero (by norm_num)))
        hEN hE (b := 3) fun X hx => ?_
      simpa using ffOutFFRankAutMain_l33 hK X hx
    · refine ffRA_rank_of_aut hY
        (ffOutFFRankAutMain_isSimple (hK.statedClassicalModel_of_ne_zero (by norm_num)))
        hEN hE (b := 3) fun X hx => ?_
      simpa using ffOutFFRankAutMain_u33 hK X hx
  · refine ffRA_rank_of_aut hY
      (ffOutFFRankAutMain_isSimple (h.statedClassicalModel_of_ne_zero (by norm_num)))
      hEN hE (b := 4) fun X hx => ?_
    have hel := ffOutFFRankAutMain_elemAbelian hx
    simpa using ffOutFFRankAutMain_omega5 h X (CFSG.Open.IsElemAbelian.isPGroup hel) hel.1
  · rcases h with hK | hK
    · refine ffRA_rank_of_aut hY
        (ffOutFFRankAutMain_isSimple (hK.statedClassicalModel_of_ne_zero (by norm_num)))
        hEN hE (b := 5) fun X hx => ?_
      have hel := ffOutFFRankAutMain_elemAbelian hx
      simpa using ffOutFFRankAutMain_omega6plus hK X (CFSG.Open.IsElemAbelian.isPGroup hel) hel.1
    · refine ffRA_rank_of_aut hY
        (ffOutFFRankAutMain_isSimple (hK.statedClassicalModel_of_ne_zero (by norm_num)))
        hEN hE (b := 5) fun X hx => ?_
      simpa using ffOutFFRankAutMain_omega6minus hK X hx

theorem ffAbelAutBound_of_cert :
    Asc82AbelAutBound := by
  intro G _ _ Y U hY hUN hU hab
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · exact ffRA_card_autIn_le hY
      (ffOutFFRankAutMain_isSimple (h.statedClassicalModel_of_ne_zero (by norm_num)))
      hUN hU hab fun X hX hXc => ffOutFFRankAutMain_omega5 h X hX hXc
  · exact ffRA_card_autIn_le hY
      (ffOutFFRankAutMain_isSimple (h.statedClassicalModel_of_ne_zero (by norm_num)))
      hUN hU hab fun X hX hXc => ffOutFFRankAutMain_l281_ab h X hX hXc
  · exact ffRA_card_autIn_le hY
      (ffOutFFRankAutMain_isSimple (h.statedClassicalModel_of_ne_zero (by norm_num)))
      hUN hU hab fun X hX hXc => ffOutFFRankAutMain_omega6plus h X hX hXc

