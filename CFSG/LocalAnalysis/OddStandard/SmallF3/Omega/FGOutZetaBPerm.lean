module

public import CFSG.LocalAnalysis.OddStandard.SmallF3.Omega.FGOutZetaBDefs

public section

attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent
  instCommGroupOfIsSimpleGroupOfIsNilpotent

namespace CFSG.OddStandard.SmallF3.Omega

open CFSG.LieType.Multipliers CFSG.LieType.Multipliers.U43

open scoped commutatorElement

private def zetaBPermTA : Nat := 

private def zetaBPermTAi : Nat := 

private def zetaBPermTB : Nat := 

private def zetaBPermTBi : Nat := 

private def zetaBPermLk (N i : Nat) : Nat := (N >>> (10 * i)) % 1024

private def zetaBPermAct (l : Nat × Bool) (x : Nat) : Nat :=
  match l with
  | (0, true) => zetaBPermLk zetaBPermTA x
  | (0, false) => zetaBPermLk zetaBPermTAi x
  | (_, true) => zetaBPermLk zetaBPermTB x
  | (_, false) => zetaBPermLk zetaBPermTBi x

private def zetaBPermAppW (w : List (Nat × Bool)) (x : Nat) : Nat := w.foldr zetaBPermAct x

private def zetaBPermToNatWord (w : List (Fin 2 × Bool)) : List (Nat × Bool) :=
  w.map fun l => (l.1.val, l.2)

private def zetaBPermPow (N : Nat) : ℕ → Nat → Nat
  | 0, x => x
  | n + 1, x => zetaBPermPow N n (zetaBPermLk N x)

private def zetaBPermPermCheck (N M : Nat) : Bool :=
  (List.range 756).all fun x =>
    decide (zetaBPermLk N x < 756) && decide (zetaBPermLk M x < 756) &&
      decide (zetaBPermLk M (zetaBPermLk N x) = x) &&
      decide (zetaBPermLk N (zetaBPermLk M x) = x)

private theorem zetaBPermPermCheckA :
    zetaBPermPermCheck zetaBPermTA zetaBPermTAi = true := by decide +kernel

private theorem zetaBPermPermCheckB :
    zetaBPermPermCheck zetaBPermTB zetaBPermTBi = true := by decide +kernel

private theorem zetaBPermLk_lt_of_check {N M : Nat} (h : zetaBPermPermCheck N M = true)
    (x : Fin 756) : zetaBPermLk N x.val < 756 := by
  have hx := List.all_eq_true.mp h x.val (List.mem_range.mpr x.isLt)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hx
  exact hx.1.1.1

private theorem zetaBPermLk_lt_of_check' {N M : Nat} (h : zetaBPermPermCheck N M = true)
    (x : Fin 756) : zetaBPermLk M x.val < 756 := by
  have hx := List.all_eq_true.mp h x.val (List.mem_range.mpr x.isLt)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hx
  exact hx.1.1.2

private theorem zetaBPermInv_of_check {N M : Nat} (h : zetaBPermPermCheck N M = true)
    (x : Fin 756) : zetaBPermLk M (zetaBPermLk N x.val) = x.val := by
  have hx := List.all_eq_true.mp h x.val (List.mem_range.mpr x.isLt)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hx
  exact hx.1.2

private theorem zetaBPermInv_of_check' {N M : Nat} (h : zetaBPermPermCheck N M = true)
    (x : Fin 756) : zetaBPermLk N (zetaBPermLk M x.val) = x.val := by
  have hx := List.all_eq_true.mp h x.val (List.mem_range.mpr x.isLt)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hx
  exact hx.2

private def zetaBPermFA (x : Fin 756) : Fin 756 :=
  ⟨zetaBPermLk zetaBPermTA x.val, zetaBPermLk_lt_of_check zetaBPermPermCheckA x⟩

private def zetaBPermGA (x : Fin 756) : Fin 756 :=
  ⟨zetaBPermLk zetaBPermTAi x.val, zetaBPermLk_lt_of_check' zetaBPermPermCheckA x⟩

private theorem zetaBPermGA_FA (x : Fin 756) : zetaBPermGA (zetaBPermFA x) = x :=
  Fin.ext (zetaBPermInv_of_check zetaBPermPermCheckA x)

private theorem zetaBPermFA_GA (x : Fin 756) : zetaBPermFA (zetaBPermGA x) = x :=
  Fin.ext (zetaBPermInv_of_check' zetaBPermPermCheckA x)

private def zetaBPermPA : Equiv.Perm (Fin 756) where
  toFun := zetaBPermFA
  invFun := zetaBPermGA
  left_inv := zetaBPermGA_FA
  right_inv := zetaBPermFA_GA

private def zetaBPermFB (x : Fin 756) : Fin 756 :=
  ⟨zetaBPermLk zetaBPermTB x.val, zetaBPermLk_lt_of_check zetaBPermPermCheckB x⟩

private def zetaBPermGB (x : Fin 756) : Fin 756 :=
  ⟨zetaBPermLk zetaBPermTBi x.val, zetaBPermLk_lt_of_check' zetaBPermPermCheckB x⟩

private theorem zetaBPermGB_FB (x : Fin 756) : zetaBPermGB (zetaBPermFB x) = x :=
  Fin.ext (zetaBPermInv_of_check zetaBPermPermCheckB x)

private theorem zetaBPermFB_GB (x : Fin 756) : zetaBPermFB (zetaBPermGB x) = x :=
  Fin.ext (zetaBPermInv_of_check' zetaBPermPermCheckB x)

private def zetaBPermPB : Equiv.Perm (Fin 756) where
  toFun := zetaBPermFB
  invFun := zetaBPermGB
  left_inv := zetaBPermGB_FB
  right_inv := zetaBPermFB_GB

private theorem zetaBPermLift_single (l : Fin 2 × Bool) (y : Fin 756) :
    (FreeGroup.lift ![zetaBPermPA, zetaBPermPB] (FreeGroup.mk [l]) y).val =
      zetaBPermAct (l.1.val, l.2) y.val := by
  rw [FreeGroup.lift_mk]
  rcases l with ⟨i, b⟩
  fin_cases i <;> cases b <;>
    simp [zetaBPermAct, zetaBPermLk, zetaBPermPA, zetaBPermPB, zetaBPermFA, zetaBPermGA,
      zetaBPermFB, zetaBPermGB, Equiv.Perm.inv_def]

private theorem zetaBPermLift_mk_val (w : List (Fin 2 × Bool)) (x : Fin 756) :
    (FreeGroup.lift ![zetaBPermPA, zetaBPermPB] (FreeGroup.mk w) x).val =
      zetaBPermAppW (zetaBPermToNatWord w) x.val := by
  induction w generalizing x with
  | nil => simp [zetaBPermAppW, zetaBPermToNatWord]
  | cons l w ih =>
    have hsplit : FreeGroup.mk (l :: w) = FreeGroup.mk [l] * FreeGroup.mk w := by
      rw [FreeGroup.mul_mk]; rfl
    rw [hsplit, map_mul, Equiv.Perm.mul_apply]
    rw [show zetaBPermAppW (zetaBPermToNatWord (l :: w)) x.val =
        zetaBPermAct (l.1.val, l.2)
          (zetaBPermAppW (zetaBPermToNatWord w) x.val) from rfl]
    rw [← ih]
    exact zetaBPermLift_single l _

private def zetaBPermWordOK (w : List (Fin 2 × Bool)) : Bool :=
  (List.range 756).all fun x => decide (zetaBPermAppW (zetaBPermToNatWord w) x = x)

private theorem zetaBPermRelsOK :
    (coverWords rels fun i => commWords (coverPairs i)).all zetaBPermWordOK = true := by
  decide +kernel

private theorem zetaBPermLift_eq_one_of_wordOK {w : List (Fin 2 × Bool)}
    (h : zetaBPermWordOK w = true) :
    FreeGroup.lift ![zetaBPermPA, zetaBPermPB] (FreeGroup.mk w) = 1 := by
  apply Equiv.ext
  intro x
  apply Fin.ext
  rw [zetaBPermLift_mk_val w x]
  show zetaBPermAppW (zetaBPermToNatWord w) x.val = x.val
  exact of_decide_eq_true (List.all_eq_true.mp h x.val (List.mem_range.mpr x.isLt))

private theorem zetaBPermToGroup_mk {G : Type*} [Group G] {f : Fin 2 → G}
    {rels : Set (FreeGroup (Fin 2))} (h : ∀ r ∈ rels, FreeGroup.lift f r = 1)
    (z : FreeGroup (Fin 2)) :
    PresentedGroup.toGroup h (PresentedGroup.mk rels z) = FreeGroup.lift f z := rfl

private theorem zetaBPermCoverRelators :
    ∀ r ∈ coverRelators (wordSet rels) zW,
      FreeGroup.lift ![zetaBPermPA, zetaBPermPB] r = 1 := by
  intro r hr
  have hset : coverRelators (wordSet rels) zW =
      wordSet (coverWords rels fun i => commWords (coverPairs i)) :=
    coverRelators_wordSet rels (fun i => commWords (coverPairs i))
  rw [hset] at hr
  change r ∈ (coverWords rels fun i => commWords (coverPairs i)).map FreeGroup.mk at hr
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hr
  exact zetaBPermLift_eq_one_of_wordOK (List.all_eq_true.mp zetaBPermRelsOK w hw)

private def zetaBPermRho : ZetaCover →* Equiv.Perm (Fin 756) :=
  PresentedGroup.toGroup zetaBPermCoverRelators

private def zetaBPermC (k : Fin 2) : List (Fin 2 × Bool) := commWord (zU k) (zV k)

private theorem zetaBPermRho_commP (k : Fin 2) :
    zetaBPermRho (zCommP k) =
      FreeGroup.lift ![zetaBPermPA, zetaBPermPB] (FreeGroup.mk (zetaBPermC k)) := by
  unfold zCommP zetaBPermC
  rw [← mk_commWord (zU k) (zV k)]
  exact zetaBPermToGroup_mk _ _

private def zetaBPermTC0 : Nat := 

private def zetaBPermTC1 : Nat := 

private def zetaBPermTCheck (N : Nat) (w : List (Fin 2 × Bool)) : Bool :=
  (List.range 756).all fun x =>
    decide (zetaBPermAppW (zetaBPermToNatWord w) x = zetaBPermLk N x)

private theorem zetaBPermTCheck0 : zetaBPermTCheck zetaBPermTC0 (zetaBPermC 0) = true := by
  decide +kernel

private theorem zetaBPermTCheck1 : zetaBPermTCheck zetaBPermTC1 (zetaBPermC 1) = true := by
  decide +kernel

private theorem zetaBPermAppW_C0 (x : Fin 756) :
    zetaBPermAppW (zetaBPermToNatWord (zetaBPermC 0)) x.val =
      zetaBPermLk zetaBPermTC0 x.val :=
  of_decide_eq_true (List.all_eq_true.mp zetaBPermTCheck0 x.val (List.mem_range.mpr x.isLt))

private theorem zetaBPermAppW_C1 (x : Fin 756) :
    zetaBPermAppW (zetaBPermToNatWord (zetaBPermC 1)) x.val =
      zetaBPermLk zetaBPermTC1 x.val :=
  of_decide_eq_true (List.all_eq_true.mp zetaBPermTCheck1 x.val (List.mem_range.mpr x.isLt))

private theorem zetaBPermRho_commP_val (k : Fin 2) (x : Fin 756) :
    (zetaBPermRho (zCommP k) x).val =
      zetaBPermAppW (zetaBPermToNatWord (zetaBPermC k)) x.val := by
  rw [zetaBPermRho_commP k, zetaBPermLift_mk_val]

private theorem zetaBPermRho0_apply_val (x : Fin 756) :
    (zetaBPermRho (zCommP 0) x).val = zetaBPermLk zetaBPermTC0 x.val := by
  rw [zetaBPermRho_commP_val 0 x, zetaBPermAppW_C0 x]

private theorem zetaBPermRho1_apply_val (x : Fin 756) :
    (zetaBPermRho (zCommP 1) x).val = zetaBPermLk zetaBPermTC1 x.val := by
  rw [zetaBPermRho_commP_val 1 x, zetaBPermAppW_C1 x]

private theorem zetaBPermRho0_pow_val (n : ℕ) : ∀ x : Fin 756,
    (((zetaBPermRho (zCommP 0)) ^ n) x).val = zetaBPermPow zetaBPermTC0 n x.val := by
  induction n with
  | zero => intro x; rfl
  | succ n ih =>
    intro x
    rw [pow_succ, Equiv.Perm.mul_apply, ih, zetaBPermRho0_apply_val]
    rfl

private theorem zetaBPermRho1_pow_val (n : ℕ) : ∀ x : Fin 756,
    (((zetaBPermRho (zCommP 1)) ^ n) x).val = zetaBPermPow zetaBPermTC1 n x.val := by
  induction n with
  | zero => intro x; rfl
  | succ n ih =>
    intro x
    rw [pow_succ, Equiv.Perm.mul_apply, ih, zetaBPermRho1_apply_val]
    rfl

private def zetaBPermCubeCheck (N : Nat) : Bool :=
  (List.range 756).all fun x =>
    decide (zetaBPermLk N (zetaBPermLk N (zetaBPermLk N x)) = x)

private theorem zetaBPermCubeCheck0 : zetaBPermCubeCheck zetaBPermTC0 = true := by
  decide +kernel

private theorem zetaBPermCubeCheck1 : zetaBPermCubeCheck zetaBPermTC1 = true := by
  decide +kernel

private theorem zetaBPermOrder0 : zetaBPermRho (zCommP 0) ^ 3 = 1 := by
  apply Equiv.ext
  intro x
  apply Fin.ext
  rw [zetaBPermRho0_pow_val 3 x]
  show zetaBPermPow zetaBPermTC0 3 x.val = x.val
  exact of_decide_eq_true (List.all_eq_true.mp zetaBPermCubeCheck0 x.val
    (List.mem_range.mpr x.isLt))

private theorem zetaBPermOrder1 : zetaBPermRho (zCommP 1) ^ 3 = 1 := by
  apply Equiv.ext
  intro x
  apply Fin.ext
  rw [zetaBPermRho1_pow_val 3 x]
  show zetaBPermPow zetaBPermTC1 3 x.val = x.val
  exact of_decide_eq_true (List.all_eq_true.mp zetaBPermCubeCheck1 x.val
    (List.mem_range.mpr x.isLt))

private def zetaBPermCommCheck : Bool :=
  (List.range 756).all fun x =>
    decide (zetaBPermLk zetaBPermTC0 (zetaBPermLk zetaBPermTC1 x) =
      zetaBPermLk zetaBPermTC1 (zetaBPermLk zetaBPermTC0 x))

private theorem zetaBPermCommCheck_true : zetaBPermCommCheck = true := by
  decide +kernel

private theorem zetaBPermCommute :
    Commute (zetaBPermRho (zCommP 0)) (zetaBPermRho (zCommP 1)) := by
  rw [commute_iff_eq]
  apply Equiv.ext
  intro x
  apply Fin.ext
  rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, zetaBPermRho0_apply_val,
    zetaBPermRho1_apply_val, zetaBPermRho1_apply_val, zetaBPermRho0_apply_val]
  exact of_decide_eq_true (List.all_eq_true.mp zetaBPermCommCheck_true x.val
    (List.mem_range.mpr x.isLt))

private def zetaBPermMovedCheck (a b : ℕ) : Bool :=
  (List.range 756).any fun x =>
    decide (zetaBPermPow zetaBPermTC0 a (zetaBPermPow zetaBPermTC1 b x) ≠ x)

private theorem zetaBPermMoved01 : zetaBPermMovedCheck 0 1 = true := by decide +kernel

private theorem zetaBPermMoved02 : zetaBPermMovedCheck 0 2 = true := by decide +kernel

private theorem zetaBPermMoved10 : zetaBPermMovedCheck 1 0 = true := by decide +kernel

private theorem zetaBPermMoved11 : zetaBPermMovedCheck 1 1 = true := by decide +kernel

private theorem zetaBPermMoved12 : zetaBPermMovedCheck 1 2 = true := by decide +kernel

private theorem zetaBPermMoved20 : zetaBPermMovedCheck 2 0 = true := by decide +kernel

private theorem zetaBPermMoved21 : zetaBPermMovedCheck 2 1 = true := by decide +kernel

private theorem zetaBPermMoved22 : zetaBPermMovedCheck 2 2 = true := by decide +kernel

private theorem zetaBPermMovedCheck_spec {a b : ℕ} (h : zetaBPermMovedCheck a b = true) :
    ∃ x : Fin 756,
      zetaBPermPow zetaBPermTC0 a (zetaBPermPow zetaBPermTC1 b x.val) ≠ x.val := by
  obtain ⟨x, hx, hne⟩ := List.any_eq_true.mp h
  exact ⟨⟨x, List.mem_range.mp hx⟩, of_decide_eq_true hne⟩

private theorem zetaBPermNotEqOne {a b : ℕ} (h : zetaBPermMovedCheck a b = true) :
    (zetaBPermRho (zCommP 0)) ^ a * (zetaBPermRho (zCommP 1)) ^ b ≠ 1 := by
  intro heq
  obtain ⟨x, hx⟩ := zetaBPermMovedCheck_spec h
  have hval : zetaBPermPow zetaBPermTC0 a (zetaBPermPow zetaBPermTC1 b x.val) = x.val := by
    have hcongr := congrArg (fun p : Equiv.Perm (Fin 756) => (p x).val) heq
    rw [Equiv.Perm.mul_apply, zetaBPermRho0_pow_val, zetaBPermRho1_pow_val] at hcongr
    simpa using hcongr
  exact hx hval

theorem zetaPermSide_holds : ZetaPermSide := by
  unfold ZetaPermSide
  refine ⟨zetaBPermRho, zetaBPermOrder0, zetaBPermOrder1, zetaBPermCommute, ?_⟩
  intro i j h
  fin_cases i <;> fin_cases j
  · exact ⟨rfl, rfl⟩
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved01)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved02)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved10)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved11)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved12)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved20)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved21)
  · exact absurd h (zetaBPermNotEqOne zetaBPermMoved22)

end CFSG.OddStandard.SmallF3.Omega
