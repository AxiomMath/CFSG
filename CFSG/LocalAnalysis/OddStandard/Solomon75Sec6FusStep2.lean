private theorem s2_four_lift {Y : Subgroup X} {u v : ↥Y ⧸ pPrimeCore 2 ↥Y} (hu : orderOf u = 2)
    (hv : orderOf v = 2) (huv : u ≠ v) (hc : u * v = v * u) :
    ∃ a ∈ Y, ∃ b ∈ Y, orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π : ↥Y →* ↥Y ⧸ pPrimeCore 2 ↥Y := QuotientGroup.mk' (pPrimeCore 2 ↥Y) with hπ
  have hodd : Odd (Nat.card (pPrimeCore 2 ↥Y)) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
  have hu2 : u ^ 2 = 1 := by
    have h := pow_orderOf_eq_one u
    rwa [hu] at h
  have hv2 : v ^ 2 = 1 := by
    have h := pow_orderOf_eq_one v
    rwa [hv] at h
  obtain ⟨a, ha2, hau⟩ := s2_exists_sq_eq_one_mk (pPrimeCore 2 ↥Y) hodd u hu2
  have ham : a * a = 1 := by rw [← sq]; exact ha2
  have hπa : π a = u := hau
  have hC := CFSG.ComponentClassification.GSThmB.OddQuot.centralizer_singleton_map_eq ham
  have hvC : v ∈ centralizer ({π a} : Set (↥Y ⧸ pPrimeCore 2 ↥Y)) := by
    rw [Subgroup.mem_centralizer_singleton_iff, hπa]
    exact hc.symm
  rw [hC] at hvC
  obtain ⟨b₀, hb₀C, hb₀v⟩ := Subgroup.mem_map.1 hvC
  set k : ℕ := Nat.card (pPrimeCore 2 ↥Y) with hk
  set b : ↥Y := b₀ ^ k with hb
  have hb₀2 : b₀ ^ 2 ∈ pPrimeCore 2 ↥Y := by
    rw [← QuotientGroup.eq_one_iff]
    change π (b₀ ^ 2) = 1
    rw [map_pow, hb₀v, hv2]
  have hb2 : b ^ 2 = 1 := by
    have h1 : (⟨b₀ ^ 2, hb₀2⟩ : ↥(pPrimeCore 2 ↥Y)) ^ k = 1 := pow_card_eq_one'
    have h2 := congrArg Subtype.val h1
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at h2
    rw [hb, ← pow_mul, mul_comm, pow_mul]
    exact h2
  have hπb : π b = v := by
    obtain ⟨j, hj⟩ := hodd
    rw [hb, map_pow, hb₀v, hj, pow_succ, pow_mul, hv2, one_pow, one_mul]
  have hbC : b ∈ centralizer ({a} : Set ↥Y) := Subgroup.pow_mem _ hb₀C k
  have ha1 : a ≠ 1 := by
    intro h
    rw [← hπa, h, map_one, orderOf_one] at hu
    exact absurd hu (by norm_num)
  have hb1 : b ≠ 1 := by
    intro h
    rw [← hπb, h, map_one, orderOf_one] at hv
    exact absurd hv (by norm_num)
  have hab : a ≠ b := fun h => huv (by rw [← hπa, ← hπb, h])
  refine ⟨(a : X), a.2, (b : X), b.2, ?_, ?_, fun h => hab (Subtype.ext h), ?_⟩
  · rw [Subgroup.orderOf_coe]
    exact orderOf_eq_prime ha2 ha1
  · rw [Subgroup.orderOf_coe]
    exact orderOf_eq_prime hb2 hb1
  · exact congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.1 hbC).symm

private theorem s2_exists_inv_QOf_of_eleven {J V : Subgroup X}
    (hJ : IsDoubleCoverOfAlt (↥J ⧸ pPrimeCore 2 ↥J) 8) (hV : V ≤ normalizer (J : Set X))
    (h11 : 11 ∣ Nat.card (↥V ⧸ pPrimeCore 2 ↥V)) :
    ∃ r ∈ V, orderOf r = 2 ∧ r ∈ QOf J := by
