private theorem s2_exists_inv_cen {H : Subgroup X} {x : X} (hx2 : x * x = 1)
    (hxH : x ∈ normalizer (H : Set X)) (h2 : 2 ∣ Nat.card H) :
    ∃ e ∈ H, orderOf e = 2 ∧ e ∈ cen x := by
  classical
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI := Fintype.ofFinite ↥H
  have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_right hx2
  let f : Function.End ↥H := fun h => ⟨x * h * x⁻¹, (mem_normalizer_iff.1 hxH h).1 h.2⟩
  have hf : f ^ 2 ^ 1 = 1 := by
    funext h
    apply Subtype.ext
    change x * (x * (h : X) * x⁻¹) * x⁻¹ = h
    rw [hxi, ← mul_assoc, ← mul_assoc, hx2, one_mul, mul_assoc, hx2, mul_one]
  have hmod := Equiv.Perm.card_fixedPoints_modEq hf
  set K : Subgroup ↥H := (cen x).subgroupOf H with hK
  have hKfix : ∀ h : ↥H, h ∈ K ↔ h ∈ Function.fixedPoints f := fun h => by
    rw [hK, Subgroup.mem_subgroupOf, Subgroup.mem_centralizer_singleton_iff,
      Function.mem_fixedPoints]
    constructor
    · intro hc
      apply Subtype.ext
      change x * (h : X) * x⁻¹ = h
      rw [← hc, mul_inv_cancel_right]
    · intro hc
      have h1 : x * (h : X) * x⁻¹ = h := congrArg Subtype.val hc
      calc (h : X) * x = (x * h * x⁻¹) * x := by rw [h1]
        _ = x * h := by group
  have hcard : Nat.card K = Fintype.card (Function.fixedPoints f) := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_congr (Equiv.subtypeEquivRight hKfix)
  have h2K : 2 ∣ Nat.card K := by
    rw [hcard]
    have h3 : Fintype.card ↥H ≡ 0 [MOD 2] := by
      rw [← Nat.card_eq_fintype_card]
      exact Nat.modEq_zero_iff_dvd.2 h2
    exact Nat.modEq_zero_iff_dvd.1 (hmod.symm.trans h3)
  obtain ⟨e, he⟩ := exists_prime_orderOf_dvd_card' (G := ↥K) 2 h2K
  refine ⟨((e : ↥H) : X), (e : ↥H).2, ?_, Subgroup.mem_subgroupOf.1 e.2⟩
  rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe]
  exact he

