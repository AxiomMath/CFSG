private theorem s2_fixed_m11
    {F : Subgroup X} {x : X}
    (hx2 : x ^ 2 = 1) (hxN : x ∈ normalizer (F : Set X))
    (he : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.McL)) (hxF : x ∉ F ⊔ QOf F) :
    Nonempty (↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN)) ≃*
