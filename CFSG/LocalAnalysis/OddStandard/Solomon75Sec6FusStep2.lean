  obtain ⟨e⟩ := he
  set σ : MulAut Blueprint.NativeSporadic.McL := (e.symm.trans (quotConj hxN)).trans e with hσ
  have hσapp : ∀ y, σ (e y) = e (quotConj hxN y) := fun y => by
    rw [hσ]
    simp only [MulEquiv.trans_apply, MulEquiv.symm_apply_apply]
  have hin : σ ∉ ComponentClassification.OuterAutomorphisms.inner Blueprint.NativeSporadic.McL := by
    intro hin
    obtain ⟨g, hg⟩ := hin
    apply hxF
    refine s2_mem_sup_of_conj hxN (g := e.symm g) ?_
    ext y
    have h1 := congrArg (fun φ : MulAut Blueprint.NativeSporadic.McL => φ (e y)) hg
    simp only [MulAut.conj_apply] at h1
    rw [hσapp] at h1
    rw [MulAut.conj_apply]
    apply e.injective
    rw [← h1, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply]
  have hσ2 : orderOf σ = 2 := by
    refine orderOf_eq_prime ?_ ?_
    · ext x'
      obtain ⟨y, rfl⟩ := e.surjective x'
      rw [pow_two, MulAut.mul_apply, hσapp, hσapp, s2_quotConj_sq hx2 hxN, MulAut.one_apply]
    · intro h
      apply hin
      rw [h]
      exact one_mem _
  obtain ⟨eM⟩ :=
    (CFSG.Sporadic.Recognition.McLAS.mcl_outer_involutions_of_certificate).2.2 σ hσ2 hin
  let ι : ↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN)) ≃*
      ↥(CFSG.Sporadic.Recognition.McLAS.mclFixed σ) :=
    { toFun := fun y => ⟨e y, by
        rw [s2_mem_mclFixed, hσapp, (s2_mem_fixedSubgroup _ _).1 y.2]⟩
      invFun := fun z => ⟨e.symm z, by
        rw [s2_mem_fixedSubgroup]
        apply e.injective
        rw [← hσapp, MulEquiv.apply_symm_apply]
        exact (s2_mem_mclFixed _ _).1 z.2⟩
      left_inv := fun y => Subtype.ext (e.symm_apply_apply (y : ↥F ⧸ pPrimeCore 2 ↥F))
      right_inv := fun z => Subtype.ext (e.apply_symm_apply (z : Blueprint.NativeSporadic.McL))
      map_mul' := fun a b => Subtype.ext (map_mul e (a : ↥F ⧸ pPrimeCore 2 ↥F)
        (b : ↥F ⧸ pPrimeCore 2 ↥F)) }
  exact ⟨ι.trans eM⟩

end Inner

