@[expose] def Sec6FusStep2Out (X : Type) [Group X] (n : ℕ) (N : Subgroup X) : Prop :=
  ∀ x ∈ N, ∀ g y : X, y ∈ Sec6R X n N → orderOf y = 2 → x = g * y * g⁻¹ →
    (∀ F : Subgroup X, Sec6MComp X n N F →
      F.map (MulAut.conj x).toMonoidHom = F ∧ x ∉ F ⊔ QOf F) → Sec6K X n (cen x) ≤ N

private theorem s2_outer_a
    {X : Type} [Group X] [Finite X] {n : ℕ} {N : Subgroup X}
    (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N)
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (h8 : n = 8) {x : X} (hx2 : orderOf x = 2) {F : Subgroup X} (hF : Sec6MComp X n N F)
    (he8 : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.McL))
    (hxNF : x ∈ normalizer (F : Set X)) (hxF : x ∉ F ⊔ QOf F) {e : X} (he2 : orderOf e = 2)
    (hex : e ∈ cen x) (heN : cen e ≤ N) (heQ : e ∈ QOf F) : Sec6K X n (cen x) ≤ N := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hx2' : x ^ 2 = 1 := sq_eq_one_of_orderOf hx2
  have he2' : e ^ 2 = 1 := sq_eq_one_of_orderOf he2
  obtain ⟨eWM⟩ := s2_outer_W hx2' hxNF he8 hxF
  set W : Subgroup X := oTwoPrimeOf (F ⊓ cen x) with hW
  have hWF : W ≤ F := (oTwoPrimeOf_le _).trans inf_le_left
  have hWx : W ≤ cen x := (oTwoPrimeOf_le _).trans inf_le_right
  obtain ⟨hWq, -, -⟩ := s2_facts_of_m11 (primeResidual_oTwoPrimeOf _) ⟨eWM⟩
  have hWpc : IsPCompIn 2 (cen x ⊓ N) W := s2_isPCompIn_piece hF.1.1 hWq
  have heNF : e ∈ normalizer (F : Set X) := (mem_QOf_iff.1 heQ).1
  have heNW : e ∈ normalizer (W : Set X) :=
    s2_mem_normalizer_oTwoPrimeOf (mem_normalizer_inf heNF (Subgroup.le_normalizer hex))
  have heW : e ∈ centralizerSection W (pPrimeCoreOf 2 W) := by
    refine ⟨heNW, mem_normalizer_oddCoreOf_of_mem_normalizer heNW, fun w hw => ?_⟩
    have h1 : ⁅w, e⁆ ∈ pPrimeCoreOf 2 F := (mem_QOf_iff.1 heQ).2 w (hWF hw)
    have h2 : ⁅w, e⁆ ∈ W := by
      have h3 : ⁅w, e⁆ = w * (e * w⁻¹ * e⁻¹) := by
        rw [commutatorElement_def]
        group
      rw [h3]
      exact W.mul_mem hw ((mem_normalizer_iff.1 heNW w⁻¹).1 (W.inv_mem hw))
    exact s2_inf_le_oddCoreOf (fun y hy => mem_normalizer_pPrimeCoreOf_of_mem (hWF hy))
      (odd_card_oddCoreOf F) ⟨h2, h1⟩
  obtain ⟨hWepc, hWecov⟩ := isPCompIn_restrict hWpc he2' heW
  set We : Subgroup X := oTwoPrimeOf (W ⊓ cen e) with hWe
  have hWeW : We ≤ W := (oTwoPrimeOf_le _).trans inf_le_left
  have hxNe : cen x ⊓ N ⊓ cen e = cen e ⊓ cen x :=
    le_antisymm (le_inf inf_le_right (inf_le_left.trans inf_le_left))
      (le_inf (le_inf inf_le_right (inf_le_left.trans heN)) inf_le_left)
  rw [hxNe] at hWepc
  have hWeE : We ≤ pLayerOf 2 (cen x) :=
    GH74.GLS.Stage1.Thm2.Recip.le_pLayerOf_of_isPCompIn_inf he2 hex hWepc
  obtain ⟨eWe⟩ := nonempty_quot_mulEquiv_of_covers hWeW hWecov
  obtain ⟨-, hWe11, a, haWe, b, hbWe, ha, hb, hab_ne, hab⟩ :=
    s2_facts_of_m11 (primeResidual_oTwoPrimeOf _) ⟨eWe.trans eWM⟩
  have hFM : F ≤ Sec6M X n N := le_sSup hF
  have hMR : Sec6M X n N ≤ Sec6R X n N := le_sup_right
  have hcenWe : ∀ r ∈ We, orderOf r = 2 → cen r ≤ N := fun r hr hr2 =>
    hI r (hMR (hFM (hWF (hWeW hr)))) hr2
  have hWex : We ≤ cen x := hWeW.trans hWx
  have hO : oddCoreOf (cen x) ≤ N :=
    sec6Step2a_of_four hI (hFM (hWF (hWeW haWe))) (hFM (hWF (hWeW hbWe))) ha hb hab_ne hab
      (hWex haWe) (hWex hbWe)
  have hab2 : orderOf (a * b) = 2 := by
    have ha2 : a * a = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf ha
    have hb2 : b * b = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf hb
    refine orderOf_eq_prime ?_ ?_
    · rw [sq, mul_assoc, ← mul_assoc b a b, ← hab, mul_assoc a b b, hb2, mul_one, ha2]
    · intro h
      apply hab_ne
      have h1 : b = a⁻¹ := (eq_inv_of_mul_eq_one_right h)
      rw [h1, inv_eq_of_mul_eq_one_right ha2]
  refine sSup_le fun J hJ => ?_
  have hJpc : IsPCompIn 2 (cen x) J := isPCompIn_of_sec6KComp hJ
  have hOJ : pPrimeCoreOf 2 J ≤ N :=
    (pPrimeCoreOf_le_oddCoreOf hJpc.1 (isPComponent_two_iff.1 hJpc.2).1).trans hO
  have hWeJ : We ≤ J ⊔ QOf J := by
    intro y hy
    have hy' : ∃ k ∈ J, y * k⁻¹ ∈ QOf J := GH74.GLS.Stage1.Thm2.Recip.mem_innSub_iff.1
      ((GH74.GLS.Stage1.Thm2.Recip.pLayerOf_le_innSub hJpc) (hWeE hy))
    obtain ⟨k, hk, hyk⟩ := hy'
    have h1 : y = (y * k⁻¹) * k := by group
    rw [h1, sup_comm]
    exact Subgroup.mul_mem_sup hyk hk
  by_cases hα : ∃ r ∈ We, orderOf r = 2 ∧ r ∈ QOf J
  · obtain ⟨r, hrWe, hr, hrQ⟩ := hα
    exact s2_le_of_mem_QOf hJpc (sq_eq_one_of_orderOf hr) hrQ (hcenWe r hrWe hr) hO
  · push Not at hα
    rcases hJ with hJA | hJM
    · exfalso
      have hJ8 : IsDoubleCoverOfAlt (↥J ⧸ pPrimeCore 2 ↥J) 8 := h8 ▸ hJA.2
      obtain ⟨r, hrWe, hr, hrQ⟩ := s2_exists_inv_QOf_of_eleven hJ8
        (fun y hy => s2_sup_QOf_le_normalizer J (hWeJ hy)) hWe11
      exact hα r hrWe hr hrQ
    · exact s2_le_of_inner_two hgenM hgenL hJM.1.2.1 (hWeJ haWe) (hWeJ hbWe)
        (sq_eq_one_of_orderOf ha) (sq_eq_one_of_orderOf hb) (hα a haWe ha) (hα b hbWe hb)
        (hα _ (We.mul_mem haWe hbWe) hab2) hab (hcenWe a haWe ha) (hcenWe b hbWe hb) hOJ

private theorem s2_sec5Comp_map {X : Type} [Group X] {n : ℕ} {H A : Subgroup X}
    (hA : Sec5Comp X n H A) (φ : X ≃* X) :
    Sec5Comp X n (H.map φ.toMonoidHom) (A.map φ.toMonoidHom) := by
  obtain ⟨⟨u, hu⟩, hdc⟩ := hA
  obtain ⟨f⟩ := nonempty_quotPPrimeCore_equiv (A.equivMapOfInjective φ.toMonoidHom φ.injective)
  exact ⟨⟨φ u, hu.map_mulEquiv φ⟩, isDoubleCoverOfAlt_congr' f hdc⟩

private theorem s2_eq_of_two
    {X : Type} [Group X] [Finite X]
    {n : ℕ} {F J₁ J₂ : Subgroup X} {y : X} (hT : IsSec6MType n (↥F ⧸ pPrimeCore 2 ↥F))
    (hyF : y ∈ F) (hy : orderOf y = 2) (hJ₁ : IsPCompIn 2 (cen y) J₁)
    (hJ₂ : IsPCompIn 2 (cen y) J₂) (hJ₁F : J₁ ≤ F) (hJ₂F : J₂ ≤ F)
    (hc₁ : n.factorial ≤ Nat.card (↥J₁ ⧸ pPrimeCore 2 ↥J₁))
    (hc₂ : n.factorial ≤ Nat.card (↥J₂ ⧸ pPrimeCore 2 ↥J₂)) : J₁ = J₂ := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hne
  set π : ↥F →* ↥F ⧸ pPrimeCore 2 ↥F := QuotientGroup.mk' (pPrimeCore 2 ↥F) with hπ
  have hker : ¬ 2 ∣ Nat.card π.ker :=
    CFSG.ComponentClassification.GSThmB.OddQuot.not_two_dvd_card_ker
  set C : Subgroup (↥F ⧸ pPrimeCore 2 ↥F) := centralizer ({π ⟨y, hyF⟩} : Set _) with hC
  have hdc : IsDoubleCoverOfAlt ↥C n := s2_cent_dc hT (s2_orderOf_mk hyF hy)
  have hCcard : Nat.card ↥C = n.factorial := s2_card_of_dc (s2_two_le hT) hdc
  have hOC : pPrimeCore 2 ↥C = ⊥ := Sec6L51B.pPrimeCore_eq_bot_of_isDoubleCoverOfAlt hdc
  have himage : ∀ {J : Subgroup X}, J ≤ F → J ≤ cen y →
      n.factorial ≤ Nat.card (↥J ⧸ pPrimeCore 2 ↥J) → (J.subgroupOf F).map π = C := by
    intro J hJF hJy hc
    have hle : (J.subgroupOf F).map π ≤ C := by
      rintro _ ⟨j, hj, rfl⟩
      rw [hC, Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul]
      congr 1
      exact Subtype.ext
        (Subgroup.mem_centralizer_singleton_iff.1 (hJy (Subgroup.mem_subgroupOf.1 hj)))
    obtain ⟨q₁⟩ := CFSG.ComponentClassification.GSThmB.OddQuot.nonempty_quotient_pPrimeCore_equiv
      π hker (J.subgroupOf F)
    obtain ⟨q₀⟩ := nonempty_quotPPrimeCore_equiv (Subgroup.subgroupOfEquivOfLe hJF)
    have h1 : Nat.card (↥J ⧸ pPrimeCore 2 ↥J) ≤ Nat.card ↥((J.subgroupOf F).map π) := by
      rw [Nat.card_congr (q₀.symm.trans q₁).toEquiv]
      exact Nat.le_of_dvd Nat.card_pos (Subgroup.card_quotient_dvd_card _)
    exact Subgroup.eq_of_le_of_card_ge hle (by rw [hCcard]; exact hc.trans h1)
  have hI₁ := himage hJ₁F hJ₁.1 hc₁
  have hI₂ := himage hJ₂F hJ₂.1 hc₂
  have hO₁ : ∀ o ∈ oddCoreOf J₁, ∀ ho : o ∈ F, π ⟨o, ho⟩ = 1 := by
    set D : Subgroup (↥F ⧸ pPrimeCore 2 ↥F) := ((oddCoreOf J₁).subgroupOf F).map π with hD
    have hDC : D ≤ C := by
      rw [← hI₁]
      exact Subgroup.map_mono (Subgroup.subgroupOf_mono F (oddCoreOf_le J₁))
    have hDn : (D.subgroupOf C).Normal := by
      rw [Subgroup.normal_subgroupOf_iff_le_normalizer hDC, ← hI₁]
      rintro _ ⟨j, hj, rfl⟩
      rw [Subgroup.mem_normalizer_iff]
      intro d
      constructor
      · rintro ⟨o, ho, rfl⟩
        refine ⟨j * o * j⁻¹, ?_, by simp⟩
        exact Subgroup.mem_subgroupOf.2 ((mem_normalizer_iff.1 (le_normalizer_oddCoreOf J₁
          (Subgroup.mem_subgroupOf.1 hj)) o).1 (Subgroup.mem_subgroupOf.1 ho))
      · intro hd
        obtain ⟨o, ho, hoe⟩ := hd
        refine ⟨j⁻¹ * o * j, ?_, ?_⟩
        · have h1 := (mem_normalizer_iff.1 (le_normalizer_oddCoreOf J₁
            (J₁.inv_mem (Subgroup.mem_subgroupOf.1 hj))) o).1 (Subgroup.mem_subgroupOf.1 ho)
          rw [inv_inv] at h1
          exact Subgroup.mem_subgroupOf.2 h1
        · rw [map_mul, map_mul, hoe, map_inv]
          group
    have hDodd : Nat.Coprime 2 (Nat.card ↥(D.subgroupOf C)) := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDC).toEquiv]
      refine Nat.Coprime.of_dvd_right (Subgroup.card_map_dvd _ π) ?_
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe
        ((oddCoreOf_le J₁).trans hJ₁F)).toEquiv]
      exact Nat.coprime_two_left.2 (odd_card_oddCoreOf J₁)
    have hDbot : D.subgroupOf C ≤ pPrimeCore 2 ↥C := le_sSup ⟨hDn, hDodd⟩
    rw [hOC] at hDbot
    intro o ho hoF
    have hmem : π ⟨o, hoF⟩ ∈ D := ⟨⟨o, hoF⟩, Subgroup.mem_subgroupOf.2 ho, rfl⟩
    have h1 : (⟨π ⟨o, hoF⟩, hDC hmem⟩ : ↥C) ∈ D.subgroupOf C := Subgroup.mem_subgroupOf.2 hmem
    have h2 := hDbot h1
    rw [Subgroup.mem_bot] at h2
    exact congrArg Subtype.val h2
  obtain ⟨a, b, hab⟩ := hdc.1.2.2
  obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨b', rfl⟩ := QuotientGroup.mk_surjective b
  apply hab
  have ha' : (a' : ↥F ⧸ pPrimeCore 2 ↥F) ∈ (J₁.subgroupOf F).map π := by rw [hI₁]; exact a'.2
  have hb' : (b' : ↥F ⧸ pPrimeCore 2 ↥F) ∈ (J₂.subgroupOf F).map π := by rw [hI₂]; exact b'.2
  obtain ⟨j₁, hj₁, hj₁a⟩ := ha'
  obtain ⟨j₂, hj₂, hj₂b⟩ := hb'
  have hcomm : ⁅(j₁ : X), (j₂ : X)⁆ ∈ oddCoreOf J₁ :=
    commutatorElement_mem_of_ne hJ₁ hJ₂ hne (Subgroup.mem_subgroupOf.1 hj₁)
      (Subgroup.mem_subgroupOf.1 hj₂)
  have h1 : π ⁅j₁, j₂⁆ = 1 := hO₁ _ hcomm _
  rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm, hj₁a, hj₂b] at h1
  have h2 : a' * b' = b' * a' := Subtype.ext h1
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, h2]

private theorem s2_outer_b
    {X : Type} [Group X] [Finite X] {n : ℕ} {t : X} (hS : Sec6Setting X n t) {N : Subgroup X}
    (hN : N ≠ ⊤) (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N) (h8 : n = 8)
    {x g y : X} (hx2 : orderOf x = 2) (hy : y ∈ Sec6R X n N) (hy2 : orderOf y = 2)
    (hxy : x = g * y * g⁻¹) {F : Subgroup X} (hF : Sec6MComp X n N F)
    (he8 : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.McL))
    (hxNF : x ∈ normalizer (F : Set X)) (hxF : x ∉ F ⊔ QOf F)
    (hFu : ∀ F', Sec6MComp X n N F' → F' = F) (hA : ∀ A, ¬ Sec5Comp X n N A) :
    Sec6K X n (cen x) ≤ N := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hn8 : 8 ≤ n := by omega
  have hc := hS.cex
  have hK0 : K0 X n N = ⊥ := by
    rw [K0_eq_sSup_sec5Comp]
    exact sSup_eq_bot.2 fun A hA' => absurd hA' (hA A)
  have hRF : Sec6R X n N ≤ F := by
    refine sup_le ?_ (sSup_le fun F' hF' => (hFu F' hF').le)
    rw [hK0]
    exact (zStar_le ⊥).trans bot_le
  have hyF : y ∈ F := hRF hy
  have hyN : cen y ≤ N := hI y hy hy2
  have hKy : ∀ J', Sec6KComp X n (cen y) J' → J' ≤ F ∧ Sec5Comp X n (cen y) J' := by
    intro J' hJ'
    rcases hJ' with h5 | h6
    · obtain ⟨J, hJ, hJ'J⟩ := Sec6L51B.exists_sec6KComp_of_sec5Comp hc.toSolMinCEx hn8 hN hyN h5
      rcases hJ with hJ5 | hJ6
      · exact absurd hJ5 (hA J)
      · exact ⟨hJ'J.trans (hFu J hJ6).le, h5⟩
    · exfalso
      obtain ⟨J, hJ, hJ'J⟩ :=
        Sec6L51B.exists_sec6MComp_of_sec6MComp hc.toSolMinCEx hS.maxdeg hN hyN h6
      have hJ'F : J' ≤ F := hJ'J.trans (hFu J hJ).le
      have hle := s2_card_quot_le_of_cen hF.2 hyF hy2 hJ'F fun w hw => by
        rw [commutatorElement_eq_one_iff_mul_comm.2
          (Subgroup.mem_centralizer_singleton_iff.1 (h6.1.1.1 hw))]
        exact one_mem _
      have hlt := s2_factorial_lt h6.2
      omega
  have huniq : ∀ J₁ J₂, Sec6KComp X n (cen y) J₁ → Sec6KComp X n (cen y) J₂ → J₁ = J₂ := by
    intro J₁ J₂ h₁ h₂
    obtain ⟨h₁F, h₁5⟩ := hKy J₁ h₁
    obtain ⟨h₂F, h₂5⟩ := hKy J₂ h₂
    exact s2_eq_of_two hF.2 hyF hy2 (isPCompIn_of_sec6KComp h₁) (isPCompIn_of_sec6KComp h₂) h₁F h₂F
      (s2_card_of_dc (by omega) h₁5.2).ge (s2_card_of_dc (by omega) h₂5.2).ge
  set φ : X ≃* X := MulAut.conj g⁻¹ with hφ
  have hφx : φ x = y := by
    rw [hφ, MulAut.conj_apply, hxy]
    group
  have hcenφ : (cen x).map φ.toMonoidHom = cen y := by rw [cen_map, hφx]
  have hmapK : ∀ J, Sec6KComp X n (cen x) J → Sec6KComp X n (cen y) (J.map φ.toMonoidHom) := by
    intro J hJ
    rw [← hcenφ]
    rcases hJ with h5 | h6
    · exact Or.inl (s2_sec5Comp_map h5 φ)
    · exact Or.inr (h6.map_mulEquiv φ)
  have hxuniq : ∀ J₁ J₂, Sec6KComp X n (cen x) J₁ → Sec6KComp X n (cen x) J₂ → J₁ = J₂ :=
    fun J₁ J₂ h₁ h₂ => Subgroup.map_injective φ.injective (huniq _ _ (hmapK J₁ h₁) (hmapK J₂ h₂))
  have hxA : ∀ J, Sec6KComp X n (cen x) J → Sec5Comp X n (cen x) J := by
    intro J hJ
    rcases hJ with h5 | h6
    · exact h5
    · exfalso
      have h6' : Sec6MComp X n (cen y) (J.map φ.toMonoidHom) := by
        rw [← hcenφ]
        exact h6.map_mulEquiv φ
      exact ne_of_sec5Comp_of_sec6MComp mcLLyCenterFree (hKy _ (Or.inr h6')).2 h6' rfl
  have hx2' : x ^ 2 = 1 := sq_eq_one_of_orderOf hx2
  obtain ⟨eWM⟩ := s2_outer_W hx2' hxNF he8 hxF
  set W : Subgroup X := oTwoPrimeOf (F ⊓ cen x) with hW
  have hWF : W ≤ F := (oTwoPrimeOf_le _).trans inf_le_left
  have hWx : W ≤ cen x := (oTwoPrimeOf_le _).trans inf_le_right
  obtain ⟨-, hW11, a, haW, b, hbW, ha, hb, hab_ne, hab⟩ :=
    s2_facts_of_m11 (primeResidual_oTwoPrimeOf _) ⟨eWM⟩
  have hFM : F ≤ Sec6M X n N := le_sSup hF
  have hMR : Sec6M X n N ≤ Sec6R X n N := le_sup_right
  have hO : oddCoreOf (cen x) ≤ N :=
    sec6Step2a_of_four hI (hFM (hWF haW)) (hFM (hWF hbW)) ha hb hab_ne hab (hWx haW) (hWx hbW)
  refine sSup_le fun J hJ => ?_
  have hJpc : IsPCompIn 2 (cen x) J := isPCompIn_of_sec6KComp hJ
  have hKJ : Sec6K X n (cen x) = J :=
    le_antisymm (sSup_le fun J' hJ' => (hxuniq J' J hJ' hJ).le) (le_sSup hJ)
  have hWJ : W ≤ normalizer (J : Set X) := fun w hw => by
    have h1 := Sec6K_cen_normal n x (hWx hw)
    rwa [hKJ] at h1
  have hJ8 : IsDoubleCoverOfAlt (↥J ⧸ pPrimeCore 2 ↥J) 8 := h8 ▸ (hxA J hJ).2
  obtain ⟨r, hrW, hr, hrQ⟩ := s2_exists_inv_QOf_of_eleven hJ8 hWJ hW11
  exact s2_le_of_mem_QOf hJpc (sq_eq_one_of_orderOf hr) hrQ (hI r (hMR (hFM (hWF hrW))) hr) hO

private theorem s2_mem_QOf_of_isIntrinsicIn {X : Type} [Group X] [Finite X] {H L : Subgroup X}
    {u : X} (hu : IsIntrinsicIn X H L u) : u ∈ QOf L := by
  obtain ⟨-, huL, -, hLeq, -⟩ := hu
  rw [oPrimeResidualOf_two_eq_oTwoPrimeOf] at hLeq
  set P : Subgroup X := oTwoPrimeOf (L ⊓ cen u) with hP
  have hPL : P ≤ L := (oTwoPrimeOf_le _).trans inf_le_left
  have hPu : P ≤ cen u := (oTwoPrimeOf_le _).trans inf_le_right
  have huO : u ∈ normalizer (pPrimeCoreOf 2 L : Set X) := mem_normalizer_pPrimeCoreOf_of_mem huL
  refine mem_QOf_iff.2 ⟨Subgroup.le_normalizer huL, fun l hl => ?_⟩
  have hl' : l ∈ P ⊔ pPrimeCoreOf 2 L := by
    rw [sup_comm, ← hLeq]
    exact hl
  obtain ⟨p, hp, o, ho, rfl⟩ := exists_mul_of_mem_sup
    (fun q hq => mem_normalizer_pPrimeCoreOf_of_mem (hPL hq)) hl'
  have hpu : p * u = u * p := Subgroup.mem_centralizer_singleton_iff.1 (hPu hp)
  have h1 : ⁅p * o, u⁆ = p * (o * (u * o⁻¹ * u⁻¹)) * p⁻¹ := by
    rw [commutatorElement_def]
    calc p * o * u * (p * o)⁻¹ * u⁻¹ = p * o * u * o⁻¹ * (p⁻¹ * u⁻¹) := by group
      _ = p * o * u * o⁻¹ * (u⁻¹ * p⁻¹) := by
        rw [show p⁻¹ * u⁻¹ = (u * p)⁻¹ by group, ← hpu, mul_inv_rev]
      _ = p * (o * (u * o⁻¹ * u⁻¹)) * p⁻¹ := by group
  rw [h1]
  have h2 : u * o⁻¹ * u⁻¹ ∈ pPrimeCoreOf 2 L := (mem_normalizer_iff.1 huO _).1 (inv_mem ho)
  exact (mem_normalizer_iff.1 (mem_normalizer_pPrimeCoreOf_of_mem (hPL hp)) _).1
    (Subgroup.mul_mem _ ho h2)

private theorem s2_mem_normalizer_sec6R {X : Type} [Group X] {n : ℕ} {N : Subgroup X} {c : X}
    (hc : c ∈ N) : c ∈ normalizer (Sec6R X n N : Set X) := by
  have hcN : c ∈ normalizer (N : Set X) := Subgroup.le_normalizer hc
  apply mem_normalizer_of_map_conj_eq
  unfold Sec6R
  rw [Subgroup.map_sup, zStar_map_mulEquiv', map_conj_K0 n hcN, map_conj_Sec6M n hcN]

theorem sec6FusStep2Out_of_eight
    {X : Type} [Group X] [Finite X] {n : ℕ} {t : X}
    (hS : Sec6Setting X n t) (hK : Sec6Lemma51 X n) (N : Subgroup X) (hN : N ≠ ⊤)
    (hCt : cen t ≤ N) (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N)
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (h8 : n = 8) : Sec6FusStep2Out X n N := by
  intro x hxN g y hy hy2 hxy hout
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hx2 : orderOf x = 2 := by rw [hxy, orderOf_conj]; exact hy2
  have hxx : x * x = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf hx2
  obtain ⟨v, hv, hv2⟩ := exists_involution_sec6M hS hK hN hCt
  obtain ⟨F, hF⟩ : ∃ F, Sec6MComp X n N F := by
    by_contra hno
    push Not at hno
    have h0 : Sec6M X n N = ⊥ := sSup_eq_bot.2 fun F hF => absurd hF (hno F)
    rw [h0, Subgroup.mem_bot] at hv
    rw [hv, orderOf_one] at hv2
    exact absurd hv2 (by decide)
  obtain ⟨hFx, hxF⟩ := hout F hF
  have hxNF : x ∈ normalizer (F : Set X) := mem_normalizer_of_map_conj_eq hFx
  have he8 : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.McL) := by
    rcases hF.2 with ⟨-, he⟩ | ⟨h11, -⟩
    · exact he
    · omega
  have hMR : Sec6M X n N ≤ Sec6R X n N := le_sup_right
  by_cases h2 : ∃ F₂, Sec6MComp X n N F₂ ∧ F₂ ≠ F
  · obtain ⟨F₂, hF₂, hne⟩ := h2
    have hxNF₂ : x ∈ normalizer (F₂ : Set X) := mem_normalizer_of_map_conj_eq (hout F₂ hF₂).1
    have h2F₂ : 2 ∣ Nat.card F₂ := by
      have hq : IsTwoGenQuasi ↥F₂ :=
        (isTwoGenQuasi_subgroupOf_iff hF₂.1.1.1).1 (isPComponent_two_iff.1 hF₂.1.1.2).2
      obtain ⟨w, hwF₂, hw⟩ := Sec6L51B.exists_involution_of_isTwoGenQuasi hq
      have h1 := Subgroup.orderOf_dvd_natCard F₂ hwF₂
      rwa [hw] at h1
    obtain ⟨e, heF₂, he2, hex⟩ := s2_exists_inv_cen hxx hxNF₂ h2F₂
    have heN : cen e ≤ N := hI e (hMR ((le_sSup hF₂ : F₂ ≤ Sec6M X n N) heF₂)) he2
    have heQ : e ∈ QOf F := le_QOf_of_ne hF.1.1 hF₂.1.1 (Ne.symm hne) heF₂
    exact s2_outer_a hI hgenM hgenL h8 hx2 hF he8 hxNF hxF he2 hex heN heQ
  · push Not at h2
    by_cases hA : ∃ A, Sec5Comp X n N A
    · obtain ⟨A, hAc⟩ := hA
      obtain ⟨⟨u, hu⟩, -⟩ := id hAc
      have hApc : IsPCompIn 2 N A := hu.2.2.1
      have huA : u ∈ A := hu.2.1
      have huK0 : u ∈ K0 X n N := (le_sSup hAc : A ≤ K0 X n N) huA
      have huR : u ∈ Sec6R X n N := by
        refine mem_sec6R_of_mem_QOf mcLLyCenterFree ?_ fun A' hA' => ?_
        · rw [sec6K_eq]
          exact (le_sup_left : K0 X n N ≤ K0 X n N ⊔ Sec6M X n N) huK0
        · by_cases hAA : A' = A
          · rw [hAA]
            exact s2_mem_QOf_of_isIntrinsicIn hu
          · exact le_QOf_of_ne (isPCompIn_of_sec6KComp (Or.inl hA')) hApc hAA huA
      set H : Subgroup X := Sec6R X n N ⊓ K0 X n N with hH
      have hxH : x ∈ normalizer (H : Set X) := mem_normalizer_inf (s2_mem_normalizer_sec6R hxN)
        (mem_normalizer_of_map_conj_eq (map_conj_K0 n (Subgroup.le_normalizer hxN)))
      have h2H : 2 ∣ Nat.card H := by
        have h1 := Subgroup.orderOf_dvd_natCard H (show u ∈ H from ⟨huR, huK0⟩)
        rwa [hu.1] at h1
      obtain ⟨e, ⟨heR, heK⟩, he2, hex⟩ := s2_exists_inv_cen hxx hxH h2H
      have heN : cen e ≤ N := hI e heR he2
      have hK0Q : K0 X n N ≤ QOf F := by
        rw [K0_eq_sSup_sec5Comp]
        refine sSup_le fun A' hA' => ?_
        exact le_QOf_of_ne hF.1.1 (isPCompIn_of_sec6KComp (Or.inl hA'))
          (ne_of_sec5Comp_of_sec6MComp mcLLyCenterFree hA' hF).symm
      exact s2_outer_a hI hgenM hgenL h8 hx2 hF he8 hxNF hxF he2 hex heN (hK0Q heK)
    · push Not at hA
      exact s2_outer_b hS hN hI h8 hx2 hy hy2 hxy hF he8 hxNF hxF h2 hA

theorem sec6FusStep2_of_out
    {X : Type} [Group X] [Finite X] {n : ℕ} {t : X}
    (hS : Sec6Setting X n t) (N : Subgroup X)
    (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N)
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hout : Sec6FusStep2Out X n N) :
    Sec6FusStep2 X n N := by
  intro x hxN g y hy hy2 hxy
  have hx2 : orderOf x = 2 := by rw [hxy, orderOf_conj]; exact hy2
  by_cases hin : ∃ F : Subgroup X, Sec6MComp X n N F ∧ x ∈ F ⊔ QOf F
  · obtain ⟨F, hF, hxF⟩ := hin
    exact sec6FusStep2_of_inner hS hI hgenM hgenL hx2 hF hxF
  · by_cases hsw : ∃ F : Subgroup X, Sec6MComp X n N F ∧ F.map (MulAut.conj x).toMonoidHom ≠ F
    · obtain ⟨F, hF, hne⟩ := hsw
      exact sec6FusStep2_of_swap hS hI hgenM hgenL hxN hx2 hF hne
    · push Not at hin hsw
      exact hout x hxN g y hy hy2 hxy fun F hF => ⟨hsw F hF, hin F hF⟩

theorem sec6FusStep2Out_of_eleven
    {X : Type} [Group X] [Finite X] {n : ℕ} {t : X}
    (hS : Sec6Setting X n t) (hK : Sec6Lemma51 X n) (N : Subgroup X) (hN : N ≠ ⊤)
    (hCt : cen t ≤ N) (h11 : n = 11) : Sec6FusStep2Out X n N := by
  intro x _ g y _ _ _ hx
  exfalso
  obtain ⟨v, hv, hv2⟩ := exists_involution_sec6M hS hK hN hCt
  obtain ⟨F, hF⟩ : ∃ F, Sec6MComp X n N F := by
    by_contra hno
    push Not at hno
    have h0 : Sec6M X n N = ⊥ := sSup_eq_bot.2 fun F hF => absurd hF (hno F)
    rw [h0, Subgroup.mem_bot] at hv
    rw [hv, orderOf_one] at hv2
    exact absurd hv2 (by decide)
  obtain ⟨hmap, hxF⟩ := hx F hF
  have hxN : x ∈ normalizer (F : Set X) := mem_normalizer_of_map_conj_eq hmap
  have he : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.Ly) := by
    rcases hF.2 with ⟨h8, -⟩ | ⟨-, he⟩
    · omega
    · exact he
  exact hxF (s2_mem_sup_of_ly hxN he)

theorem sec6FusStep2_of
    {X : Type} [Group X] [Finite X] {n : ℕ} {t : X}
    (hS : Sec6Setting X n t) (hK : Sec6Lemma51 X n) (_h61 : Sec6L61 X n t)
    (_hC : Sec6CtrlAt X n t) (N : Subgroup X) (hN : N ≠ ⊤) (hCt : cen t ≤ N)
    (_hII : Sec6CtrlNAt X n t N)
    (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N)
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤) :
    Sec6FusStep2 X n N := by
  refine sec6FusStep2_of_out hS N hI hgenM hgenL ?_
  rcases hS.deg with h8 | h11
  · exact sec6FusStep2Out_of_eight hS hK N hN hCt hI hgenM hgenL h8
  · exact sec6FusStep2Out_of_eleven hS hK N hN hCt h11

