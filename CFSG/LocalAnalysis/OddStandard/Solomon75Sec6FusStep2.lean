private theorem s2_m11_nonab : ∃ a b : ↥Blueprint.NativeSporadic.M11, a * b ≠ b * a :=
  ⟨Sporadic.Mathieu.m11a, Sporadic.Mathieu.m11b, by decide⟩

private theorem s2_facts_of_m11 {Y : Subgroup X}
    (hY : primeResidual 2 ↥Y = ⊤)
    (h : Nonempty (↥Y ⧸ pPrimeCore 2 ↥Y ≃* ↥Blueprint.NativeSporadic.M11)) :
    IsTwoGenQuasi ↥Y ∧ 11 ∣ Nat.card (↥Y ⧸ pPrimeCore 2 ↥Y) ∧
      ∃ a ∈ Y, ∃ b ∈ Y, orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a := by
  obtain ⟨eY⟩ := h
  have hs : IsSimpleGroup ↥Blueprint.NativeSporadic.M11 := (Sporadic.Mathieu.fam_m11_simplicity).2.2
  have hq : CFSG.IsQuasisimple ↥Blueprint.NativeSporadic.M11 :=
    s2_isQuasisimple_of_simple hs s2_m11_nonab
  refine ⟨⟨hY, LocalCores.isQuasisimple_of_mulEquiv eY.symm hq⟩, ?_, ?_⟩
  · rw [Nat.card_congr eY.toEquiv, Sporadic.Mathieu.card_M11]
    norm_num
  · obtain ⟨a, b, ha, hb, hab, hc⟩ := s2_m11_four
    refine s2_four_lift (u := eY.symm a) (v := eY.symm b) ?_ ?_ ?_ ?_
    · rw [MulEquiv.orderOf_eq]
      exact ha
    · rw [MulEquiv.orderOf_eq]
      exact hb
    · exact fun h => hab (eY.symm.injective h)
    · rw [← map_mul, ← map_mul, hc]

private theorem s2_outer_W
    {F : Subgroup X} {x : X}
    (hx2 : x ^ 2 = 1) (hxN : x ∈ normalizer (F : Set X))
    (he : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.McL)) (hxF : x ∉ F ⊔ QOf F) :
    Nonempty (↥(oTwoPrimeOf (F ⊓ cen x)) ⧸ pPrimeCore 2 ↥(oTwoPrimeOf (F ⊓ cen x)) ≃*
      ↥Blueprint.NativeSporadic.M11) := by
  obtain ⟨eΦ⟩ := s2_fixed_m11 hx2 hxN he hxF
  have hs : IsSimpleGroup ↥Blueprint.NativeSporadic.M11 := (Sporadic.Mathieu.fam_m11_simplicity).2.2
  have hsΦ : IsSimpleGroup ↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN)) :=
    @MulEquiv.isSimpleGroup _ _ _ _ hs eΦ
  have h2Φ : 2 ∣ Nat.card ↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN)) := by
    rw [Nat.card_congr eΦ.toEquiv, Sporadic.Mathieu.card_M11]
    norm_num
  obtain ⟨eW⟩ := s2_W_quot hx2 hxN hsΦ h2Φ
  exact ⟨eW.trans eΦ⟩

