  by_contra hno
  push Not at hno
  set M : AhatModel X 8 J := AhatModel.ofCover hJ with hM
  let φ : ↥V →* Equiv.Perm (Fin 8) := (M.permHom le_rfl).comp (Subgroup.inclusion hV)
  have hker : φ.ker ≤ pPrimeCore 2 ↥V := by
    have hodd : Nat.Coprime 2 (Nat.card φ.ker) := by
      by_contra h
      rw [Nat.coprime_two_left, Nat.not_odd_iff_even] at h
      obtain ⟨r, hr⟩ := exists_prime_orderOf_dvd_card' (G := ↥φ.ker) 2 (even_iff_two_dvd.1 h)
      have h1 : M.perm ((r : ↥V) : X) (hV (r : ↥V).2) = 1 := r.2
      have h2 := (M.perm_eq_one_iff le_rfl (hV (r : ↥V).2)).1 h1
      refine hno _ (r : ↥V).2 ?_ (mem_QOf_iff.2 ⟨hV (r : ↥V).2, h2⟩)
      rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe]
      exact hr
    exact le_sSup ⟨inferInstance, hodd⟩
  have h1 : (pPrimeCore 2 ↥V).index ∣ φ.ker.index := Subgroup.index_dvd_of_le hker
  have h2 : φ.ker.index = Nat.card φ.range := Subgroup.index_ker φ
  have h3 : Nat.card φ.range ∣ Nat.card (Equiv.Perm (Fin 8)) := Subgroup.card_subgroup_dvd_card _
  have h4 : Nat.card (Equiv.Perm (Fin 8)) = 40320 := by
    rw [Nat.card_perm, Nat.card_fin]
    rfl
  rw [← Subgroup.index_eq_card] at h11
  have h5 := h11.trans (h1.trans (h2 ▸ h3))
  rw [h4] at h5
  norm_num at h5

