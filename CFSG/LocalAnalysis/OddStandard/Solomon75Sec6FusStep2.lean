    {n : ℕ} {Q : Type} [Group Q]
    (hT : IsSec6MType n Q) {c : Q} (hc : orderOf c = 2) :
    IsDoubleCoverOfAlt ↥(centralizer ({c} : Set Q)) n := by
  rcases hT with ⟨rfl, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩
  · exact Sec6L51B.isDoubleCoverOfAlt_centralizer_McL e c hc
  · exact Sec6L51B.isDoubleCoverOfAlt_centralizer_Ly e c hc

private theorem s2_orderOf_mk {M : Subgroup X} {s : X} (hsM : s ∈ M) (hs : orderOf s = 2) :
    orderOf (QuotientGroup.mk' (pPrimeCore 2 ↥M) (⟨s, hsM⟩ : ↥M)) = 2 := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hs' : orderOf (⟨s, hsM⟩ : ↥M) = 2 := by
    rw [Subgroup.orderOf_mk]
    exact hs
  refine orderOf_eq_prime ?_ ?_
  · rw [← map_pow, ← hs', pow_orderOf_eq_one, map_one]
  · intro h1
    have hmem : (⟨s, hsM⟩ : ↥M) ∈ pPrimeCore 2 ↥M := (QuotientGroup.eq_one_iff _).1 h1
    have h3 := Subgroup.orderOf_dvd_natCard _ hmem
    rw [hs'] at h3
    have hodd : Odd (Nat.card (pPrimeCore 2 ↥M)) :=
      Nat.coprime_two_left.1 pPrimeCore_coprime_card
    exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr h3)

private theorem s2_degree
    {n : ℕ} {L J : Subgroup X}
    {v : X} (hT : IsSec6MType n (↥L ⧸ pPrimeCore 2 ↥L)) (hvL : v ∈ L) (hv : orderOf v = 2)
    (hJ : IsAhatIntr X v J) (hJcov : J ≤ (L ⊓ cen v) ⊔ oddCoreOf (cen v)) :
    IsDoubleCoverOfAlt (↥J ⧸ pPrimeCore 2 ↥J) n := by
  obtain ⟨hJC, -, hJpc, -⟩ := hJ
  obtain ⟨J', hJ'CL, hJ'pc, -, -, ⟨q₁⟩⟩ := exists_isPComponent_inf_of_covered
    (C := cen v) (H := L) (O := oddCoreOf (cen v)) (E := L ⊓ cen v) (J := J)
    (oddCoreOf_le _) (le_normalizer_oddCoreOf _) (odd_card_oddCoreOf _) inf_le_right inf_le_left
    hJC hJpc hJcov
  have hJ'LC : J' ≤ L ⊓ cen v := by rw [inf_comm]; exact hJ'CL
  have hJ'pc' : IsPComponent 2 (J'.subgroupOf (L ⊓ cen v)) := by rw [inf_comm]; exact hJ'pc
  exact isDoubleCoverOfAlt_congr' q₁
    (Sec6L51B.isDoubleCoverOfAlt_of_isPComponent_cen hvL hv hJ'LC hJ'pc' fun c hc =>
      s2_cent_dc hT hc)

private theorem s2_card_quot_le_of_cen
    {n : ℕ} {M W : Subgroup X} {s : X} (hT : IsSec6MType n (↥M ⧸ pPrimeCore 2 ↥M)) (hsM : s ∈ M)
    (hs : orderOf s = 2) (hWM : W ≤ M) (hWs : ∀ w ∈ W, ⁅w, s⁆ ∈ pPrimeCoreOf 2 M) :
    Nat.card (↥W ⧸ pPrimeCore 2 ↥W) ≤ n.factorial := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π : ↥M →* ↥M ⧸ pPrimeCore 2 ↥M := QuotientGroup.mk' (pPrimeCore 2 ↥M) with hπ
  set f : ↥W →* ↥M ⧸ pPrimeCore 2 ↥M := π.comp (Subgroup.inclusion hWM) with hf
  have hC := s2_cent_dc hT (s2_orderOf_mk hsM hs)
  have hrange : f.range ≤ centralizer ({π ⟨s, hsM⟩} : Set (↥M ⧸ pPrimeCore 2 ↥M)) := by
    rintro _ ⟨w, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    obtain ⟨y, hy, hye⟩ := hWs w w.2
    have hy' : y = ⁅Subgroup.inclusion hWM w, (⟨s, hsM⟩ : ↥M)⁆ := Subtype.ext hye
    have h1 : π ⁅Subgroup.inclusion hWM w, (⟨s, hsM⟩ : ↥M)⁆ = 1 := by
      rw [← hy']
      exact (QuotientGroup.eq_one_iff y).2 hy
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm] at h1
    exact h1
  have hker : f.ker ≤ pPrimeCore 2 ↥W := by
    intro w hw
    have h1 : Subgroup.inclusion hWM w ∈ pPrimeCore 2 ↥M := (QuotientGroup.eq_one_iff _).1 hw
    have h2 : (w : X) ∈ W ⊓ pPrimeCoreOf 2 M := ⟨w.2, ⟨_, h1, rfl⟩⟩
    obtain ⟨w', hw', hww'⟩ := s2_inf_le_oddCoreOf
      (fun x hx => mem_normalizer_pPrimeCoreOf_of_mem (hWM hx)) (odd_card_oddCoreOf M) h2
    have : w' = w := Subtype.ext hww'
    rwa [← this]
  calc Nat.card (↥W ⧸ pPrimeCore 2 ↥W) = (pPrimeCore 2 ↥W).index := (Subgroup.index_eq_card _).symm
    _ ≤ f.ker.index := Nat.le_of_dvd (Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite)
        (Subgroup.index_dvd_of_le hker)
    _ = Nat.card f.range := Subgroup.index_ker f
    _ ≤ Nat.card ↥(centralizer ({π ⟨s, hsM⟩} : Set (↥M ⧸ pPrimeCore 2 ↥M))) :=
        Subgroup.card_le_of_le hrange
    _ = n.factorial := s2_card_of_dc (s2_two_le hT) hC

private theorem s2_transfer
    {n : ℕ} {M J : Subgroup X}
    {s c : X} (hT : IsSec6MType n (↥M ⧸ pPrimeCore 2 ↥M)) (hsM : s ∈ M) (hs : orderOf s = 2)
    (hc2 : c ^ 2 = 1) (hcs : c ∈ cen s) (hcM : c ∈ normalizer (M : Set X))
    (hcen : ∀ y ∈ M ⊓ cen s, ⁅y, c⁆ ∈ pPrimeCoreOf 2 M)
    (hJ : IsAhatIntr X s J) (hJcov : J ≤ (M ⊓ cen s) ⊔ oddCoreOf (cen s)) :
    oTwoPrimeOf (M ⊓ cen s ⊓ cen c) ≤ J ∧
      J = pPrimeCoreOf 2 J ⊔ oTwoPrimeOf (M ⊓ cen s ⊓ cen c) := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set R : Subgroup X := oTwoPrimeOf (M ⊓ cen s) with hR
  set W : Subgroup X := oTwoPrimeOf (M ⊓ cen s ⊓ cen c) with hW
  have hJn : IsDoubleCoverOfAlt (↥J ⧸ pPrimeCore 2 ↥J) n := s2_degree hT hsM hs hJ hJcov
  obtain ⟨hJC, -, hJpc, -⟩ := hJ
  have hJq : IsTwoGenQuasi ↥J :=
    (isTwoGenQuasi_subgroupOf_iff hJC).1 (isPComponent_two_iff.1 hJpc).2
  have hRM : R ≤ M ⊓ cen s := oTwoPrimeOf_le _
  have hWR : W ≤ R := oTwoPrimeOf_mono inf_le_left
  have hRgen : primeResidual 2 ↥R = ⊤ := primeResidual_oTwoPrimeOf _
  have hWgen : primeResidual 2 ↥W = ⊤ := primeResidual_oTwoPrimeOf _
  have hcR : c ∈ normalizer (R : Set X) :=
    s2_mem_normalizer_oTwoPrimeOf (mem_normalizer_inf hcM (Subgroup.le_normalizer hcs))
  have hcomm : ∀ r ∈ R, ⁅r, c⁆ ∈ pPrimeCoreOf 2 R := by
    intro r hr
    have h1 : ⁅r, c⁆ ∈ pPrimeCoreOf 2 M := hcen r (hRM hr)
    have h2 : ⁅r, c⁆ ∈ R := by
      have h3 : ⁅r, c⁆ = r * (c * r⁻¹ * c⁻¹) := by
        rw [commutatorElement_def]
        group
      rw [h3]
      exact R.mul_mem hr ((mem_normalizer_iff.1 hcR r⁻¹).1 (R.inv_mem hr))
    exact s2_inf_le_oddCoreOf (fun x hx => mem_normalizer_pPrimeCoreOf_of_mem (hRM hx).1)
      (odd_card_oddCoreOf M) ⟨h2, h1⟩
  have hcRc : c ∈ centralizerSection R (pPrimeCoreOf 2 R) :=
    ⟨hcR, mem_normalizer_oddCoreOf_of_mem_normalizer hcR, hcomm⟩
  have hcovR := oTwoPrimeOf_inf_centralizer_covers hc2 hRgen hcRc
  have hRW : R ≤ pPrimeCoreOf 2 R ⊔ W := by
    have h1 := (covers_subgroupOf_iff ((oTwoPrimeOf_le _).trans inf_le_left)).1 hcovR
    exact h1.symm.le.trans
      (sup_le (le_sup_of_le_right (oTwoPrimeOf_mono (inf_le_inf_right _ hRM))) le_sup_left)
  set Z : Subgroup X := R ⊔ oddCoreOf (cen s) with hZ
  have hJZ : J ≤ Z := by
    have hJself : oTwoPrimeOf J = J := oTwoPrimeOf_eq_self_of_primeResidual hJq.1
    rw [← hJself, oTwoPrimeOf_le_iff]
    rintro x hx ⟨k, hk⟩
    obtain ⟨o, ho, a, ha, hak, rfl⟩ := exists_conj_twoElt_of_mem_sup_odd_X
      (A := M ⊓ cen s) (N := oddCoreOf (cen s))
      (fun y hy => le_normalizer_oddCoreOf (cen s) (Subgroup.mem_inf.1 hy).2)
      (odd_card_oddCoreOf (cen s)) (hJcov hx) hk
    have haR : a ∈ R := mem_oTwoPrimeOf ha k hak
    have hoZ : o ∈ Z := le_sup_right (a := R) ho
    exact Z.mul_mem (Z.mul_mem hoZ (le_sup_left (b := oddCoreOf (cen s)) haR)) (Z.inv_mem hoZ)
  have hZs : Z ≤ cen s := sup_le (hRM.trans inf_le_right) (oddCoreOf_le _)
  have hJZpc : IsPCompIn 2 Z J := by
    refine ⟨hJZ, isPComponent_two_iff.2 ⟨?_, (isTwoGenQuasi_subgroupOf_iff hJZ).2 hJq⟩⟩
    have h1 : J.subgroupOf Z = (J.subgroupOf (cen s)).comap (Subgroup.inclusion hZs) := by
      ext x
      simp only [Subgroup.mem_subgroupOf, Subgroup.mem_comap, Subgroup.coe_inclusion]
    rw [h1]
    exact (isPComponent_two_iff.1 hJpc).1.comap _
  have hWZ : W ≤ Z := hWR.trans le_sup_left
  set N : Subgroup X := oddCoreOf R ⊔ oddCoreOf (cen s) with hN
  have hNodd : Odd (Nat.card N) :=
    s2_odd_card_sup (fun x hx => le_normalizer_oddCoreOf (cen s) ((hRM ((oddCoreOf_le R) hx)).2))
      (odd_card_oddCoreOf R) (odd_card_oddCoreOf _)
  have hNZ : N ≤ Z := sup_le ((oddCoreOf_le R).trans le_sup_left) le_sup_right
  have hZN : Z ≤ normalizer (N : Set X) := by
    refine sup_le (fun r hr => ?_) (fun o ho => ?_)
    · exact mem_normalizer_sup (le_normalizer_oddCoreOf R hr)
        (le_normalizer_oddCoreOf (cen s) (hRM hr).2)
    · exact s2_mem_normalizer_sup_of_mem (C := cen s)
        (fun x hx => ((hRM ((oddCoreOf_le R) hx)).2)) (le_normalizer_oddCoreOf (cen s)) ho
  have hNO : N ≤ oddCoreOf Z := le_oddCoreOf_of_normalized hNZ hZN hNodd
  have hWcovZ : W.subgroupOf Z ⊔ pPrimeCore 2 ↥Z = ⊤ := by
    rw [covers_subgroupOf_iff hWZ]
    refine le_antisymm (sup_le hWZ (Subgroup.map_subtype_le _)) ?_
    have h1 : Z ≤ W ⊔ N := by
      refine sup_le (hRW.trans (sup_le ?_ le_sup_left)) ?_
      · exact le_sup_left.trans le_sup_right
      · exact le_sup_right.trans le_sup_right
    exact h1.trans (sup_le_sup_left hNO _)
  have hZW : Nat.card (↥Z ⧸ pPrimeCore 2 ↥Z) ≤ Nat.card (↥W ⧸ pPrimeCore 2 ↥W) :=
    card_quot_pPrimeCore_le_of_covers hWZ le_rfl hWcovZ
  have hWn : Nat.card (↥W ⧸ pPrimeCore 2 ↥W) ≤ n.factorial :=
    s2_card_quot_le_of_cen hT hsM hs (hWR.trans (hRM.trans inf_le_left)) fun w hw => by
      have hws : w * s = s * w :=
        Subgroup.mem_centralizer_singleton_iff.1 ((hWR.trans (hRM.trans inf_le_right)) hw)
      rw [commutatorElement_eq_one_iff_mul_comm.2 hws]
      exact one_mem _
  have hJcard : Nat.card (↥J ⧸ pPrimeCore 2 ↥J) = n.factorial :=
    s2_card_of_dc (s2_two_le hT) hJn
  have hJcovZ : J.subgroupOf Z ⊔ pPrimeCore 2 ↥Z = ⊤ :=
    covers_of_card_le hJZ (hZW.trans (hWn.trans hJcard.ge))
  have hWJ : W ≤ J := by
    refine le_of_le_sup_pPrimeCoreOf hJZpc hWZ hWgen ?_
    rw [(covers_subgroupOf_iff hJZ).1 hJcovZ]
    exact hWZ
  have hJZc : Nat.card (↥J ⧸ pPrimeCore 2 ↥J) ≤ Nat.card (↥Z ⧸ pPrimeCore 2 ↥Z) :=
    card_quot_pPrimeCore_le_of_covers le_rfl hJZ (by rw [Subgroup.subgroupOf_self, top_sup_eq])
  have hWcovJ : W.subgroupOf J ⊔ pPrimeCore 2 ↥J = ⊤ := covers_of_card_le hWJ (hJZc.trans hZW)
  refine ⟨hWJ, ?_⟩
  rw [sup_comm]
  exact ((covers_subgroupOf_iff hWJ).1 hWcovJ).symm

private theorem s2_mem_of_central {L : Subgroup X} (hZ : center (↥L ⧸ pPrimeCore 2 ↥L) = ⊥)
    {g : X} (hgL : g ∈ L) (hg : ∀ l ∈ L, ⁅l, g⁆ ∈ pPrimeCoreOf 2 L) : g ∈ pPrimeCoreOf 2 L := by
  set π : ↥L →* ↥L ⧸ pPrimeCore 2 ↥L := QuotientGroup.mk' (pPrimeCore 2 ↥L) with hπ
  have hcen : π ⟨g, hgL⟩ ∈ center (↥L ⧸ pPrimeCore 2 ↥L) := by
    rw [Subgroup.mem_center_iff]
    intro x
    obtain ⟨l, rfl⟩ := QuotientGroup.mk'_surjective (pPrimeCore 2 ↥L) x
    obtain ⟨y, hy, hye⟩ := hg l l.2
    have hy' : y = ⁅l, (⟨g, hgL⟩ : ↥L)⁆ := Subtype.ext hye
    have h1 : π ⁅l, (⟨g, hgL⟩ : ↥L)⁆ = 1 := by
      rw [← hy']
      exact (QuotientGroup.eq_one_iff y).2 hy
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm] at h1
    exact h1
  rw [hZ, Subgroup.mem_bot] at hcen
  exact ⟨⟨g, hgL⟩, (QuotientGroup.eq_one_iff _).1 hcen, rfl⟩

private theorem s2_comm_mem {L : Subgroup X} {a b x : X} (hxL : x ∈ L) (hab : a⁻¹ * b ∈ QOf L)
    (hxa : x * a = a * x) (haN : a ∈ normalizer (pPrimeCoreOf 2 L : Set X)) :
    ⁅x, b⁆ ∈ pPrimeCoreOf 2 L := by
  have h1 : ⁅x, a⁻¹ * b⁆ ∈ pPrimeCoreOf 2 L := (mem_QOf_iff.1 hab).2 x hxL
  have h2 : ⁅x, b⁆ = a * ⁅x, a⁻¹ * b⁆ * a⁻¹ := by
    have hx' : a * x * a⁻¹ = x := by rw [← hxa, mul_inv_cancel_right]
    calc ⁅x, b⁆ = (a * x * a⁻¹) * b * x⁻¹ * b⁻¹ := by rw [hx', commutatorElement_def]
      _ = a * ⁅x, a⁻¹ * b⁆ * a⁻¹ := by rw [commutatorElement_def]; group
  rw [h2]
  exact (mem_normalizer_iff.1 haN _).1 h1

private theorem s2_sup_QOf_le_normalizer (L : Subgroup X) :
    L ⊔ QOf L ≤ normalizer (L : Set X) :=
  sup_le Subgroup.le_normalizer fun _ hc => (mem_QOf_iff.1 hc).1

private theorem s2_exists_inv_inner {L : Subgroup X} {c : X}
    (hZ : center (↥L ⧸ pPrimeCore 2 ↥L) = ⊥) (hc2 : c ^ 2 = 1) (hcL : c ∈ L ⊔ QOf L)
    (hc : c ∉ QOf L) : ∃ v ∈ L ⊓ cen c, orderOf v = 2 ∧ v⁻¹ * c ∈ QOf L := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hLQ : L ≤ normalizer (QOf L : Set X) := fun m hm =>
    mem_normalizer_QOf (Subgroup.le_normalizer hm)
  obtain ⟨m, hmL, q, hq, hmq⟩ := exists_mul_of_mem_sup hLQ hcL
  have hcmq : c = m * q := hmq.symm
  have hcN : c ∈ normalizer (L : Set X) := s2_sup_QOf_le_normalizer L hcL
  have hcO : c ∈ normalizer (pPrimeCoreOf 2 L : Set X) :=
    mem_normalizer_oddCoreOf_of_mem_normalizer hcN
  have hOQ : pPrimeCoreOf 2 L ≤ QOf L := oddCoreOf_le_QOf L
  have hm2Q : m ^ 2 ∈ QOf L := by
    have h3 : m * (q * m * q) = 1 := by
      rw [← hc2, hcmq, pow_two]
      group
    have h4 : q * m * q = m⁻¹ := eq_inv_of_mul_eq_one_right h3
    have key : m ^ 2 = q⁻¹ * (m⁻¹ * q⁻¹ * m⁻¹⁻¹) := by
      rw [pow_two, inv_inv, ← h4]
      group
    rw [key]
    refine (QOf L).mul_mem ((QOf L).inv_mem hq) ?_
    exact (mem_normalizer_iff.1 (hLQ (L.inv_mem hmL)) _).1 ((QOf L).inv_mem hq)
  have hm2O : m ^ (2 ^ 1) ∈ pPrimeCoreOf 2 L := by
    rw [pow_one]
    exact s2_mem_of_central hZ (L.pow_mem hmL 2) fun l hl => (mem_QOf_iff.1 hm2Q).2 l hl
  have hOcop : Nat.Coprime 2 (Nat.card (pPrimeCoreOf 2 L)) :=
    Nat.coprime_two_left.2 (odd_card_oddCoreOf L)
  obtain ⟨k, hk2, hmk⟩ := exists_zpow_twoElt_of_pow_mem hOcop hm2O
  set y : X := m ^ k with hy
  have hyL : y ∈ L := L.zpow_mem hmL k
  have hyc : y⁻¹ * c = (m⁻¹ * y)⁻¹ * q := by rw [hcmq]; group
  have hyc' : y⁻¹ * c ∈ QOf L := by
    rw [hyc]
    exact (QOf L).mul_mem (hOQ ((pPrimeCoreOf 2 L).inv_mem hmk)) hq
  have hyt : ⁅y, c⁆ ∈ pPrimeCoreOf 2 L :=
    s2_comm_mem hyL hyc' rfl (mem_normalizer_pPrimeCoreOf_of_mem hyL)
  obtain ⟨v, hv, hv2, hvy⟩ := exists_twoElt_centralizer_of_comm_mem hc2 hcO hyL hyt hk2
  refine ⟨v, hv, orderOf_eq_prime (by simpa using hv2) ?_, ?_⟩
  · rintro rfl
    apply hc
    have hyO : y ∈ pPrimeCoreOf 2 L := by simpa using hvy
    have hmO : m ∈ pPrimeCoreOf 2 L := by
      have h1 : m = y * (m⁻¹ * y)⁻¹ := by group
      rw [h1]
      exact (pPrimeCoreOf 2 L).mul_mem hyO ((pPrimeCoreOf 2 L).inv_mem hmk)
    rw [hcmq]
    exact (QOf L).mul_mem (hOQ hmO) hq
  · have h1 : v⁻¹ * c = (v⁻¹ * y) * (y⁻¹ * c) := by group
    rw [h1]
    exact (QOf L).mul_mem (hOQ hvy) hyc'

private theorem s2_piece_inner
    {n : ℕ} {H L : Subgroup X}
    {c : X} (hc2 : orderOf c = 2) (hL : Sec6MComp X n H L) (hcL : c ∈ L ⊔ QOf L)
    (hc : c ∉ QOf L) : Sec5Comp X n (cen c ⊓ H) (sec6Piece L c) := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨⟨hLpc, htype, hLJ⟩, hT⟩ := hL
  have hZ : center (↥L ⧸ pPrimeCore 2 ↥L) = ⊥ := mcLLyCenterFree _ htype
  have hc2' : c ^ 2 = 1 := by
    rw [← hc2]
    exact pow_orderOf_eq_one c
  obtain ⟨v, ⟨hvL, hvc⟩, hv, hvq⟩ := s2_exists_inv_inner hZ hc2' hcL hc
  unfold sec6Piece
  set P : Subgroup X := oTwoPrimeOf (L ⊓ cen c) with hP
  have hPL : P ≤ L := (oTwoPrimeOf_le _).trans inf_le_left
  have hPc : P ≤ cen c := (oTwoPrimeOf_le _).trans inf_le_right
  have hv2 : v ^ 2 = 1 := by
    rw [← hv]
    exact pow_orderOf_eq_one v
  have hvP : v ∈ P := mem_oTwoPrimeOf ⟨hvL, hvc⟩ 1 (by simpa using hv2)
  have hcN : c ∈ normalizer (L : Set X) := s2_sup_QOf_le_normalizer L hcL
  have hcO : c ∈ normalizer (pPrimeCoreOf 2 L : Set X) :=
    mem_normalizer_oddCoreOf_of_mem_normalizer hcN
  have hcv : c ∈ cen v :=
    Subgroup.mem_centralizer_singleton_iff.2 (Subgroup.mem_centralizer_singleton_iff.1 hvc).symm
  obtain ⟨J, hJ, hJcov⟩ := hLJ v hvL hv
  obtain ⟨hWJ, hJeq⟩ := s2_transfer hT hvL hv hc2' hcv hcN
    (fun y hy => s2_comm_mem hy.1 hvq (Subgroup.mem_centralizer_singleton_iff.1 hy.2)
      (mem_normalizer_pPrimeCoreOf_of_mem hvL)) hJ hJcov
  set W : Subgroup X := oTwoPrimeOf (L ⊓ cen v ⊓ cen c) with hW
  have hWP : W = oTwoPrimeOf (P ⊓ cen v) := by
    refine le_antisymm ?_ (oTwoPrimeOf_mono fun x hx => ⟨⟨hPL hx.1, hx.2⟩, hPc hx.1⟩)
    rw [oTwoPrimeOf_le_iff]
    intro x hx h2
    exact mem_oTwoPrimeOf_of_twoElt ⟨mem_oTwoPrimeOf_of_twoElt ⟨hx.1.1, hx.2⟩ h2, hx.1.2⟩ h2
  have hWcovJ : W.subgroupOf J ⊔ pPrimeCore 2 ↥J = ⊤ := by
    rw [covers_subgroupOf_iff hWJ, sup_comm]
    exact hJeq.symm
  obtain ⟨eWJ⟩ := nonempty_quot_mulEquiv_of_covers hWJ hWcovJ
  have hJn : IsDoubleCoverOfAlt (↥J ⧸ pPrimeCore 2 ↥J) n := s2_degree hT hvL hv hJ hJcov
  have hWPle : W ≤ P := by
    rw [hWP]
    exact (oTwoPrimeOf_le _).trans inf_le_left
  have hcv' : c⁻¹ * v ∈ QOf L := by
    have h1 : c⁻¹ * v = (v⁻¹ * c)⁻¹ := by group
    rw [h1]
    exact (QOf L).inv_mem hvq
  have hPcard : Nat.card (↥P ⧸ pPrimeCore 2 ↥P) ≤ n.factorial :=
    s2_card_quot_le_of_cen hT hvL hv hPL fun p hp =>
      s2_comm_mem (hPL hp) hcv' (Subgroup.mem_centralizer_singleton_iff.1 (hPc hp)) hcO
  have hWcard : Nat.card (↥W ⧸ pPrimeCore 2 ↥W) = n.factorial := by
    rw [Nat.card_congr eWJ.toEquiv]
    exact s2_card_of_dc (s2_two_le hT) hJn
  have hWcovP : W.subgroupOf P ⊔ pPrimeCore 2 ↥P = ⊤ :=
    covers_of_card_le hWPle (hPcard.trans hWcard.ge)
  obtain ⟨eWP⟩ := nonempty_quot_mulEquiv_of_covers hWPle hWcovP
  have hPn : IsDoubleCoverOfAlt (↥P ⧸ pPrimeCore 2 ↥P) n :=
    isDoubleCoverOfAlt_congr' (eWJ.symm.trans eWP) hJn
  have hPq : IsTwoGenQuasi ↥P := ⟨primeResidual_oTwoPrimeOf _, hPn.1⟩
  have hPpc : IsPCompIn 2 (cen c ⊓ H) P := s2_isPCompIn_piece hLpc hPq
  refine ⟨⟨v, hv, hvP, hPpc, ?_, J, hJ, ?_⟩, hPn⟩
  · rw [oPrimeResidualOf_two_eq_oTwoPrimeOf, ← hWP, sup_comm]
    exact ((covers_subgroupOf_iff hWPle).1 hWcovP).symm
  · rw [oPrimeResidualOf_two_eq_oTwoPrimeOf, ← hWP]
    exact hJeq

private theorem s2_piece_mem
    {n : ℕ} {N F : Subgroup X}
    {x : X} (hx2 : orderOf x = 2) (hF : Sec6MComp X n N F) (hxF : x ∈ F ⊔ QOf F) :
    Sec6KComp X n (cen x ⊓ N) (oTwoPrimeOf (F ⊓ cen x)) := by
  by_cases hxQ : x ∈ QOf F
  · have h := sec6MComp_restrict hF (sq_eq_one_of_orderOf hx2) hxQ
    rw [inf_comm] at h
    exact Or.inr h
  · exact Or.inl (s2_piece_inner hx2 hF hxF hxQ)

private theorem s2_land
    {n : ℕ} {t : X} (hS : Sec6Setting X n t) {N Y : Subgroup X} {x : X} (hx2 : orderOf x = 2)
    (hY : Sec6KComp X n (cen x ⊓ N) Y) : ∃ J : Subgroup X, Sec6KComp X n (cen x) J ∧ Y ≤ J := by
  have hc := hS.cex
  have := hc.simple
  have hH : cen x ≠ ⊤ := centralizer_ne_top_of_involution hc.nonabelian hx2
  have hn8 : 8 ≤ n := by rcases hS.deg with h | h <;> omega
  rcases hY with hYA | hYM
  · exact Sec6L51B.exists_sec6KComp_of_sec5Comp hc.toSolMinCEx hn8 hH inf_le_left hYA
  · obtain ⟨J, hJ, hYJ⟩ :=
      Sec6L51B.exists_sec6MComp_of_sec6MComp hc.toSolMinCEx hS.maxdeg hH inf_le_left hYM
    exact ⟨J, Or.inr hJ, hYJ⟩

private theorem s2_le_of_two {N J : Subgroup X} {a b : X}
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hJt : Nonempty (↥J ⧸ pPrimeCore 2 ↥J ≃* Blueprint.NativeSporadic.McL) ∨
      Nonempty (↥J ⧸ pPrimeCore 2 ↥J ≃* Blueprint.NativeSporadic.Ly))
    (haJ : a ∈ J) (hbJ : b ∈ J) (ha : orderOf a = 2) (hb : orderOf b = 2) (hne : a ≠ b)
    (hab : a * b = b * a) (haN : cen a ≤ N) (hbN : cen b ≤ N) (hO : pPrimeCoreOf 2 J ≤ N) :
    J ≤ N := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π : ↥J →* ↥J ⧸ pPrimeCore 2 ↥J := QuotientGroup.mk' (pPrimeCore 2 ↥J) with hπ
  set a' : ↥J := ⟨a, haJ⟩ with ha'
  set b' : ↥J := ⟨b, hbJ⟩ with hb'
  have ha2 : a' * a' = 1 := Subtype.ext (by
    show a * a = 1
    rw [← sq]
    exact sq_eq_one_of_orderOf ha)
  have hb2 : b' * b' = 1 := Subtype.ext (by
    show b * b = 1
    rw [← sq]
    exact sq_eq_one_of_orderOf hb)
  have hoa : orderOf (π a') = 2 := s2_orderOf_mk haJ ha
  have hob : orderOf (π b') = 2 := s2_orderOf_mk hbJ hb
  have hab' : a' * b' = b' * a' := Subtype.ext hab
  have hne' : π a' ≠ π b' := by
    intro h
    have h1 : a'⁻¹ * b' ∈ pPrimeCore 2 ↥J := by
      rw [← QuotientGroup.eq_one_iff]
      change π (a'⁻¹ * b') = 1
      rw [map_mul, map_inv, h, inv_mul_cancel]
    have hab2 : orderOf (a'⁻¹ * b') = 2 := by
      have hai : a'⁻¹ = a' := inv_eq_of_mul_eq_one_right ha2
      rw [hai]
      refine orderOf_eq_prime ?_ ?_
      · rw [sq, mul_assoc, ← mul_assoc b' a' b', ← hab', mul_assoc a' b' b', hb2, mul_one, ha2]
      · intro h2
        apply hne
        have h3 : b' = a' := by
          have := eq_inv_of_mul_eq_one_right h2
          rwa [inv_eq_of_mul_eq_one_right ha2] at this
        exact congrArg Subtype.val h3.symm
    have h3 := Subgroup.orderOf_dvd_natCard _ h1
    rw [hab2] at h3
    have hodd : Odd (Nat.card (pPrimeCore 2 ↥J)) :=
      Nat.coprime_two_left.1 pPrimeCore_coprime_card
    exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr h3)
  have hcomm : π a' * π b' = π b' * π a' := by rw [← map_mul, hab', map_mul]
  have hgen : centralizer ({π a'} : Set (↥J ⧸ pPrimeCore 2 ↥J)) ⊔
      centralizer ({π b'} : Set (↥J ⧸ pPrimeCore 2 ↥J)) = ⊤ := by
    rcases hJt with he | he
    · exact hgenM _ he _ _ hoa hob hne' hcomm
    · exact hgenL _ he _ _ hoa hob hne' hcomm
  have hCa := CFSG.ComponentClassification.GSThmB.OddQuot.centralizer_singleton_map_eq ha2
  have hCb := CFSG.ComponentClassification.GSThmB.OddQuot.centralizer_singleton_map_eq hb2
  rw [hCa, hCb, ← Subgroup.map_sup] at hgen
  have hCN : centralizer ({a'} : Set ↥J) ⊔ centralizer ({b'} : Set ↥J) ≤ N.comap J.subtype := by
    refine sup_le (fun c hc => haN ?_) (fun c hc => hbN ?_)
    · rw [Subgroup.mem_centralizer_singleton_iff] at hc ⊢
      exact congrArg Subtype.val hc
    · rw [Subgroup.mem_centralizer_singleton_iff] at hc ⊢
      exact congrArg Subtype.val hc
  intro j hj
  have hmem : π ⟨j, hj⟩ ∈ (centralizer ({a'} : Set ↥J) ⊔ centralizer ({b'} : Set ↥J)).map π := by
    rw [hgen]
    exact Subgroup.mem_top _
  obtain ⟨w, hw, hwj⟩ := Subgroup.mem_map.1 hmem
  have hk : w⁻¹ * ⟨j, hj⟩ ∈ pPrimeCore 2 ↥J := by
    rw [← QuotientGroup.eq_one_iff]
    change π (w⁻¹ * ⟨j, hj⟩) = 1
    rw [map_mul, map_inv, hwj, inv_mul_cancel]
  have hwN : (w : X) ∈ N := hCN hw
  have hkN : ((w⁻¹ * ⟨j, hj⟩ : ↥J) : X) ∈ N := hO ⟨_, hk, rfl⟩
  have hj' : j = (w : X) * ((w⁻¹ * ⟨j, hj⟩ : ↥J) : X) := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_cancel_left]
  rw [hj']
  exact N.mul_mem hwN hkN

private theorem s2_factorial_lt
    {n : ℕ} {Q : Type} [Group Q] (hT : IsSec6MType n Q) : n.factorial < Nat.card Q := by
  rcases hT with ⟨rfl, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩
  · rw [Nat.card_congr e.toEquiv, CFSG.Sporadic.McL.card_McL]
    have h8 : Nat.factorial 8 = 40320 := by norm_num [Nat.factorial]
    omega
  · rw [Nat.card_congr e.toEquiv, CFSG.Sporadic.Ly.card_Ly']
    have h11 : Nat.factorial 11 = 39916800 := by norm_num [Nat.factorial]
    omega

theorem sec6FusStep2_of_inner
    {n : ℕ} {t : X} (hS : Sec6Setting X n t) {N : Subgroup X}
    (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N)
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    {x : X} (hx2 : orderOf x = 2) {F : Subgroup X} (hF : Sec6MComp X n N F)
    (hxF : x ∈ F ⊔ QOf F) : Sec6K X n (cen x) ≤ N := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set Y : Subgroup X := oTwoPrimeOf (F ⊓ cen x) with hYdef
  have hY : Sec6KComp X n (cen x ⊓ N) Y := s2_piece_mem hx2 hF hxF
  have hYF : Y ≤ F := (oTwoPrimeOf_le _).trans inf_le_left
  have hYx : Y ≤ cen x := (oTwoPrimeOf_le _).trans inf_le_right
  have hFM : F ≤ Sec6M X n N := le_sSup hF
  have hFN : F ≤ N := hF.1.1.1
  have hMR : Sec6M X n N ≤ Sec6R X n N := le_sup_right
  obtain ⟨a, haY, b, hbY, ha, hb, hne, hab⟩ := s2_exists_four hY
  have hO : oddCoreOf (cen x) ≤ N :=
    sec6Step2a_of_four hI (hFM (hYF haY)) (hFM (hYF hbY)) ha hb hne hab (hYx haY) (hYx hbY)
  have haN : cen a ≤ N := hI a (hMR (hFM (hYF haY))) ha
  have hbN : cen b ≤ N := hI b (hMR (hFM (hYF hbY))) hb
  obtain ⟨J₀, hJ₀, hYJ₀⟩ := s2_land hS hx2 hY
  have hJ₀pc : IsPCompIn 2 (cen x) J₀ := isPCompIn_of_sec6KComp hJ₀
  refine sSup_le fun J hJ => ?_
  have hJpc : IsPCompIn 2 (cen x) J := isPCompIn_of_sec6KComp hJ
  have hOJ : pPrimeCoreOf 2 J ≤ N :=
    (pPrimeCoreOf_le_oddCoreOf hJpc.1 (isPComponent_two_iff.1 hJpc.2).1).trans hO
  by_cases hJJ₀ : J = J₀
  · subst hJJ₀
    rcases hJ with hJA | hJM
    ·
      have hn2 : 2 ≤ n := by rcases hS.deg with h | h <;> omega
      have hJcard : Nat.card (↥J ⧸ pPrimeCore 2 ↥J) = n.factorial := s2_card_of_dc hn2 hJA.2
      have hYle : modOddCard Y ≤ modOddCard J := modOddCard_le_of_le hYJ₀
      unfold modOddCard at hYle
      rcases hY with hYA | hYM
      · have hYcard : Nat.card (↥Y ⧸ pPrimeCore 2 ↥Y) = n.factorial := s2_card_of_dc hn2 hYA.2
        have hcov : Y.subgroupOf J ⊔ pPrimeCore 2 ↥J = ⊤ :=
          covers_of_card_le hYJ₀ (by rw [hJcard, hYcard])
        rw [covers_subgroupOf_iff hYJ₀] at hcov
        rw [← hcov]
        exact sup_le (hYF.trans hFN) hOJ
      · exfalso
        have hlt := s2_factorial_lt hYM.2
        omega
    ·
      exact s2_le_of_two hgenM hgenL hJM.1.2.1 (hYJ₀ haY) (hYJ₀ hbY) ha hb hne hab haN hbN hOJ
  ·
    have haQ : a ∈ QOf J := le_QOf_of_ne hJpc hJ₀pc hJJ₀ (hYJ₀ haY)
    exact s2_le_of_mem_QOf hJpc (sq_eq_one_of_orderOf ha) haQ haN hO

end Step2

section Swap

open CFSG.LocalCores CFSG.ComponentClassification.Sol76

variable {X : Type} [Group X] [Finite X]

private theorem s2_isSubnormal_trans {A B C : Subgroup X} (hAB : A ≤ B) (hBC : B ≤ C)
    (hA : (A.subgroupOf B).IsSubnormal) (hB : (B.subgroupOf C).IsSubnormal) :
    (A.subgroupOf C).IsSubnormal := by
  have hAC : A.subgroupOf C ≤ B.subgroupOf C := Subgroup.subgroupOf_mono C hAB
  refine Subgroup.IsSubnormal.trans hAC ?_ hB
  let e : ↥(B.subgroupOf C) ≃* ↥B := Subgroup.subgroupOfEquivOfLe hBC
  have : (A.subgroupOf C).subgroupOf (B.subgroupOf C) = (A.subgroupOf B).comap e.toMonoidHom := by
    ext x
    rfl
  rw [this]
  exact hA.comap _

private theorem s2_mem_oddCoreOf_iff {C : Subgroup X} (x : ↥C) :
    (x : X) ∈ oddCoreOf C ↔ x ∈ pPrimeCore 2 ↥C :=
  Subgroup.mem_map_iff_mem C.subtype_injective

private theorem s2_diag_core {C : Type} [Group C] [Finite C] {B : Subgroup C}
    (hB : IsPComponent 2 B) (hZ : center (↥B ⧸ pPrimeCore 2 ↥B) = ⊥) {t : C} (ht : t * t = 1)
    (hne : B.map (MulAut.conj t).toMonoidHom ≠ B) :
    ∃ Δ : Subgroup C, Δ ≤ centralizer ({t} : Set C) ∧
      IsPComponent 2 (Δ.subgroupOf (centralizer ({t} : Set C))) ∧
      (∀ d ∈ Δ, ∃ b ∈ B, d * (b * (t * b * t⁻¹))⁻¹ ∈ pPrimeCore 2 C) ∧
      Nonempty (↥Δ ⧸ pPrimeCore 2 ↥Δ ≃* ↥B ⧸ pPrimeCore 2 ↥B) := by
  classical
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π : C →* C ⧸ pPrimeCore 2 C := QuotientGroup.mk' (pPrimeCore 2 C) with hπ
  set B' : Subgroup C := B.map (MulAut.conj t).toMonoidHom with hB'
  have hB'pc : IsPComponent 2 B' :=
    LocalAnalysis.ComponentInitial.isPComponent_map_of_isPComponent 2 (MulAut.conj t) hB
  have hKc : IsComponent (B.map π) := by
    obtain ⟨K, hK, -, hKeq, -⟩ := hB
    exact hKeq ▸ hK
  set g : C ⧸ pPrimeCore 2 C := π t with hg
  have hg2 : g * g = 1 := by rw [hg, ← map_mul, ht, map_one]
  have hKK' : (B.map π).map (MulAut.conj g).toMonoidHom = B'.map π := by
    rw [Subgroup.map_map, hB', Subgroup.map_map]
    congr 1
  have hne' : (B.map π).map (MulAut.conj g).toMonoidHom ≠ B.map π := by
    rw [hKK']
    intro h
    exact hne (eq_of_map_pPrimeCore_eq hB'pc hB h)
  obtain ⟨D, δ, hDq, hDC, hDs, -, hδsur, hδv⟩ := diag_isComponent hKc hg2 hne'
  obtain ⟨Δ, hΔC, hΔpc, hΔmap, -⟩ := exists_isPComponent_lift ht hDq hDC hDs
  have hker : ∀ x : C, π x = 1 ↔ x ∈ pPrimeCore 2 C := fun x => QuotientGroup.eq_one_iff x
  refine ⟨Δ, hΔC, hΔpc, ?_, ?_⟩
  · intro d hd
    have hdD : π d ∈ D := hΔmap ▸ Subgroup.mem_map_of_mem π hd
    obtain ⟨v, hv⟩ := hδsur ⟨π d, hdD⟩
    obtain ⟨b, hb, hbv⟩ := Subgroup.mem_map.1 v.2
    refine ⟨b, hb, ?_⟩
    have h1 : (π d : C ⧸ pPrimeCore 2 C) = (v : C ⧸ pPrimeCore 2 C) * (g * v * g⁻¹) := by
      have := hδv v
      rw [hv] at this
      exact this
    have h2 : π d = π (b * (t * b * t⁻¹)) := by
      rw [h1, ← hbv]
      simp [map_mul, map_inv, hg]
    rw [← hker, map_mul, map_inv, h2, mul_inv_cancel]
  · obtain ⟨e₁⟩ := exists_mulEquiv_quot_image hB
    have hK'c : IsComponent ((B.map π).map (MulAut.conj g).toMonoidHom) :=
      isComponent_map_mulEquiv (MulAut.conj g) hKc
    have hZK : center ↥(B.map π) = ⊥ := by
      rw [← Subgroup.map_center_eq e₁, hZ, Subgroup.map_bot]
    have hδinj : Function.Injective δ := by
      rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro v hv
      have hvc : v ∈ center ↥(B.map π) := by
        rw [Subgroup.mem_center_iff]
        intro k
        have h1 : ((δ v : ↥D) : C ⧸ pPrimeCore 2 C) = 1 := by rw [hv]; rfl
        rw [hδv] at h1
        have hvK' : (v : C ⧸ pPrimeCore 2 C) ∈ (B.map π).map (MulAut.conj g).toMonoidHom := by
          have e : (v : C ⧸ pPrimeCore 2 C) = (g * v * g⁻¹)⁻¹ := eq_inv_of_mul_eq_one_left h1
          rw [e]
          exact inv_mem (conj_mem_map_conj v.2)
        exact Subtype.ext (commute_of_ne hKc hK'c (fun h => hne' h.symm) k.2 hvK').eq
      rw [hZK] at hvc
      exact hvc
    let e₂ : ↥(B.map π) ≃* ↥D := MulEquiv.ofBijective δ ⟨hδinj, hδsur⟩
    have hZD : center ↥D = ⊥ := by
      rw [← Subgroup.map_center_eq e₂, hZK, Subgroup.map_bot]
    have hZD' : IsPGroup 2 ↥(center ↥D) := by
      rw [hZD]
      exact IsPGroup.of_bot
    let ψ : ↥Δ →* ↥D := (π.comp Δ.subtype).codRestrict D (fun x => by
      rw [← hΔmap]
      exact Subgroup.mem_map_of_mem π x.2)
    have hψ : Function.Surjective ψ := by
      rintro ⟨d, hd⟩
      obtain ⟨x, hx, hxd⟩ := Subgroup.mem_map.1 (hΔmap ▸ hd)
      exact ⟨⟨x, hx⟩, Subtype.ext hxd⟩
    have hψker : ψ.ker = pPrimeCore 2 ↥Δ := by
      apply le_antisymm
      · have hle : ψ.ker.map Δ.subtype ≤ pPrimeCore 2 C := by
          rintro _ ⟨x, hx, rfl⟩
          have h1 : ψ x = 1 := hx
          have h2 : π (x : C) = 1 := by
            have := congrArg Subtype.val h1
            exact this
          exact (hker _).1 h2
        have hdvd : Nat.card ψ.ker ∣ Nat.card (pPrimeCore 2 C) := by
          rw [← Subgroup.card_map_of_injective (K := ψ.ker) Δ.subtype_injective]
          exact Subgroup.card_dvd_of_le hle
        exact le_sSup ⟨inferInstance, Nat.Coprime.of_dvd_right hdvd pPrimeCore_coprime_card⟩
      · intro x hx
        have hRn : (Subgroup.map ψ (pPrimeCore 2 ↥Δ)).Normal :=
          Subgroup.Normal.map pPrimeCore_normal ψ hψ
        have hodd : Odd (Nat.card (Subgroup.map ψ (pPrimeCore 2 ↥Δ))) :=
          Nat.coprime_two_left.1 (Nat.Coprime.of_dvd_right (Subgroup.card_map_dvd _ ψ)
            pPrimeCore_coprime_card)
        have hbot := normal_odd_eq_bot_of_quasisimple hDq hZD' hodd
        have : ψ x ∈ Subgroup.map ψ (pPrimeCore 2 ↥Δ) := Subgroup.mem_map_of_mem ψ hx
        rw [hbot, Subgroup.mem_bot] at this
        exact this
    let e₅ : ↥Δ ⧸ pPrimeCore 2 ↥Δ ≃* ↥D :=
      (QuotientGroup.quotientMulEquivOfEq hψker.symm).trans
        (QuotientGroup.quotientKerEquivOfSurjective ψ hψ)
    exact ⟨e₅.trans (e₂.symm.trans e₁.symm)⟩

private theorem s2_diag {H M : Subgroup X} (hM : IsPCompIn 2 H M)
    (hZ : center (↥M ⧸ pPrimeCore 2 ↥M) = ⊥) {t : X} (htH : t ∈ H) (ht : t * t = 1)
    (hne : M.map (MulAut.conj t).toMonoidHom ≠ M) :
    ∃ Δ : Subgroup X, Δ ≤ H ⊓ cen t ∧ IsPCompIn 2 (H ⊓ cen t) Δ ∧
      (∀ d ∈ Δ, ∃ m ∈ M, d * (m * (t * m * t⁻¹))⁻¹ ∈ oddCoreOf H) ∧
      Nonempty (↥Δ ⧸ pPrimeCore 2 ↥Δ ≃* ↥M ⧸ pPrimeCore 2 ↥M) := by
  classical
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hMC : M ≤ H := hM.1
  have hMtC : M.map (MulAut.conj t).toMonoidHom ≤ H := by
    rintro _ ⟨x, hx, rfl⟩
    exact H.mul_mem (H.mul_mem htH (hMC hx)) (H.inv_mem htH)
  set tc : ↥H := ⟨t, htH⟩ with htcdef
  have htc2 : tc * tc = 1 := Subtype.ext ht
  have hBne : (M.subgroupOf H).map (MulAut.conj tc).toMonoidHom ≠ M.subgroupOf H := by
    rw [map_conj_subgroupOf htH M]
    intro heq
    apply hne
    have h1 := heq
    rw [Subgroup.subgroupOf_inj, inf_of_le_left hMtC, inf_of_le_left hMC] at h1
    exact h1
  obtain ⟨f⟩ := nonempty_quotPPrimeCore_equiv (Subgroup.subgroupOfEquivOfLe hMC)
  have hZ' : center (↥(M.subgroupOf H) ⧸ pPrimeCore 2 ↥(M.subgroupOf H)) = ⊥ := by
    rw [← Subgroup.map_center_eq f.symm, hZ, Subgroup.map_bot]
  obtain ⟨Δ₀, hΔ₀C, hΔ₀pc, hc3, ⟨eq⟩⟩ := s2_diag_core hM.2 hZ' htc2 hBne
  have hΔC : Δ₀.map H.subtype ≤ H := Subgroup.map_subtype_le Δ₀
  have hΔt : Δ₀.map H.subtype ≤ cen t := by
    rintro _ ⟨x, hx, rfl⟩
    have := Subgroup.mem_centralizer_singleton_iff.1 (hΔ₀C hx)
    exact Subgroup.mem_centralizer_singleton_iff.2 (congrArg Subtype.val this)
  have hcenmap : (centralizer ({tc} : Set ↥H)).map H.subtype = H ⊓ cen t := by
    rw [centralizer_singleton_subgroup htH, Subgroup.subgroupOf_map_subtype, inf_comm]
  have hΔpc : IsPCompIn 2 (H ⊓ cen t) (Δ₀.map H.subtype) := by
    refine ⟨le_inf hΔC hΔt, ?_⟩
    have h1 := (isPComponent_subgroupOf_map_iff 2 H.subtype H.subtype_injective hΔ₀C).2 hΔ₀pc
    rwa [hcenmap] at h1
  refine ⟨Δ₀.map H.subtype, le_inf hΔC hΔt, hΔpc, ?_, ?_⟩
  · rintro _ ⟨d, hd, rfl⟩
    obtain ⟨b, hb, hbd⟩ := hc3 d hd
    exact ⟨(b : X), hb, (s2_mem_oddCoreOf_iff _).2 hbd⟩
  · obtain ⟨f'⟩ := nonempty_quotPPrimeCore_equiv
      (Δ₀.equivMapOfInjective H.subtype H.subtype_injective)
    exact ⟨f'.symm.trans (eq.trans f)⟩

private theorem s2_pump
    {n : ℕ} {H Δ : Subgroup X}
    (hΔ : IsPCompIn 2 H Δ) (hT : IsSec6MType n (↥Δ ⧸ pPrimeCore 2 ↥Δ)) {e : X} (heΔ : e ∈ Δ)
    (he : orderOf e = 2) :
    ∃ Λ : Subgroup X, Λ ≤ Δ ⊓ cen e ∧ IsPCompIn 2 (H ⊓ cen e) Λ ∧
      IsDoubleCoverOfAlt (↥Λ ⧸ pPrimeCore 2 ↥Λ) n := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set e' : ↥Δ := ⟨e, heΔ⟩ with he'
  have he2 : e' * e' = 1 := Subtype.ext (by
    show e * e = 1
    rw [← sq]
    exact sq_eq_one_of_orderOf he)
  set π : ↥Δ →* ↥Δ ⧸ pPrimeCore 2 ↥Δ := QuotientGroup.mk' (pPrimeCore 2 ↥Δ) with hπ
  have hoe : orderOf (π e') = 2 := s2_orderOf_mk heΔ he
  have hdc := s2_cent_dc hT hoe
  obtain ⟨Λ₀, hΛ₀C, hΛ₀pc, hΛ₀map, -⟩ := exists_isPComponent_lift he2 hdc.1 le_rfl
    (by
      change ((centralizer ({π e'} : Set (↥Δ ⧸ pPrimeCore 2 ↥Δ))).subgroupOf
        (centralizer ({π e'} : Set (↥Δ ⧸ pPrimeCore 2 ↥Δ)))).IsSubnormal
      rw [Subgroup.subgroupOf_self]
      exact Subgroup.IsSubnormal.top)
  have hcenmap : (centralizer ({e'} : Set ↥Δ)).map Δ.subtype = Δ ⊓ cen e := by
    rw [centralizer_singleton_subgroup heΔ, Subgroup.subgroupOf_map_subtype, inf_comm]
  set Λ : Subgroup X := Λ₀.map Δ.subtype with hΛ
  have hΛle : Λ ≤ Δ ⊓ cen e := by
    rw [← hcenmap]
    exact Subgroup.map_mono hΛ₀C
  have hΛpc : IsPCompIn 2 (Δ ⊓ cen e) Λ := by
    refine ⟨hΛle, ?_⟩
    have h1 := (isPComponent_subgroupOf_map_iff 2 Δ.subtype Δ.subtype_injective hΛ₀C).2 hΛ₀pc
    rwa [hcenmap] at h1
  have hsub1 : ((Δ ⊓ cen e).subgroupOf (H ⊓ cen e)).IsSubnormal :=
    s2_isSubnormal_inf inf_le_left inf_le_right (isPComponent_two_iff.1 hΔ.2).1
  have hΔeH : Δ ⊓ cen e ≤ H ⊓ cen e := inf_le_inf_right _ hΔ.1
  have hΛq : IsTwoGenQuasi ↥Λ :=
    (isTwoGenQuasi_subgroupOf_iff hΛpc.1).1 (isPComponent_two_iff.1 hΛpc.2).2
  refine ⟨Λ, hΛle, ⟨hΛle.trans hΔeH, isPComponent_two_iff.2 ⟨s2_isSubnormal_trans hΛle hΔeH
    (isPComponent_two_iff.1 hΛpc.2).1 hsub1, (isTwoGenQuasi_subgroupOf_iff (hΛle.trans hΔeH)).2
      hΛq⟩⟩, ?_⟩
  have hker : ¬ 2 ∣ Nat.card π.ker :=
    CFSG.ComponentClassification.GSThmB.OddQuot.not_two_dvd_card_ker
  obtain ⟨q₁⟩ :=
    CFSG.ComponentClassification.GSThmB.OddQuot.nonempty_quotient_pPrimeCore_equiv π hker Λ₀
  obtain ⟨q₂⟩ := nonempty_quotPPrimeCore_equiv (MulEquiv.subgroupCongr hΛ₀map)
  have hbot := Sec6L51B.pPrimeCore_eq_bot_of_isDoubleCoverOfAlt hdc
  let q₃ : ↥(centralizer ({π e'} : Set (↥Δ ⧸ pPrimeCore 2 ↥Δ))) ⧸
      pPrimeCore 2 ↥(centralizer ({π e'} : Set (↥Δ ⧸ pPrimeCore 2 ↥Δ))) ≃*
      ↥(centralizer ({π e'} : Set (↥Δ ⧸ pPrimeCore 2 ↥Δ))) :=
    (QuotientGroup.quotientMulEquivOfEq hbot).trans QuotientGroup.quotientBot
  obtain ⟨q₀⟩ := nonempty_quotPPrimeCore_equiv
    (Λ₀.equivMapOfInjective Δ.subtype Δ.subtype_injective)
  exact isDoubleCoverOfAlt_congr' (q₀.symm.trans (q₁.trans (q₂.trans q₃))).symm hdc

private theorem s2_four_of_dc {Λ : Subgroup X} {m : ℕ} (hm : 8 ≤ m)
    (hΛ : IsDoubleCoverOfAlt (↥Λ ⧸ pPrimeCore 2 ↥Λ) m) :
    ∃ a ∈ Λ, ∃ b ∈ Λ, orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π : ↥Λ →* ↥Λ ⧸ pPrimeCore 2 ↥Λ := QuotientGroup.mk' (pPrimeCore 2 ↥Λ) with hπ
  obtain ⟨-, y, -, hy2, hyZ, -⟩ := AhatData.exists_hub hm (AhatData.CoverSetup.ofCover hΛ)
  have hc : Nat.card (center (↥Λ ⧸ pPrimeCore 2 ↥Λ)) = 2 := hΛ.2.1
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := ↥(center (↥Λ ⧸ pPrimeCore 2 ↥Λ))) 2
    (by rw [hc])
  have hodd : Odd (Nat.card (pPrimeCore 2 ↥Λ)) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
  have hz2 : (z : ↥Λ ⧸ pPrimeCore 2 ↥Λ) ^ 2 = 1 := by
    have h := pow_orderOf_eq_one z
    rw [hz] at h
    simpa using congrArg Subtype.val h
  obtain ⟨z', hz'2, hz'⟩ := s2_exists_sq_eq_one_mk (pPrimeCore 2 ↥Λ) hodd _ hz2
  have hz'm : z' * z' = 1 := by rw [← sq]; exact hz'2
  have hπz : π z' = (z : ↥Λ ⧸ pPrimeCore 2 ↥Λ) := hz'
  have hC := CFSG.ComponentClassification.GSThmB.OddQuot.centralizer_singleton_map_eq hz'm
  have hyC : y ∈ centralizer ({π z'} : Set (↥Λ ⧸ pPrimeCore 2 ↥Λ)) := by
    rw [Subgroup.mem_centralizer_singleton_iff, hπz]
    exact (Subgroup.mem_center_iff.1 z.2) y
  rw [hC] at hyC
  obtain ⟨y₀, hy₀C, hy₀y⟩ := Subgroup.mem_map.1 hyC
  set k : ℕ := Nat.card (pPrimeCore 2 ↥Λ) with hk
  set y₁ : ↥Λ := y₀ ^ k with hy₁
  have hy₀2 : y₀ ^ 2 ∈ pPrimeCore 2 ↥Λ := by
    rw [← QuotientGroup.eq_one_iff]
    change π (y₀ ^ 2) = 1
    rw [map_pow, hy₀y, sq]
    exact hy2
  have hy₁2 : y₁ ^ 2 = 1 := by
    have h1 : (⟨y₀ ^ 2, hy₀2⟩ : ↥(pPrimeCore 2 ↥Λ)) ^ k = 1 := pow_card_eq_one'
    have h2 := congrArg Subtype.val h1
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at h2
    rw [hy₁, ← pow_mul, mul_comm, pow_mul]
    exact h2
  have hπy₁ : π y₁ = y := by
    obtain ⟨j, hj⟩ := hodd
    rw [hy₁, map_pow, hy₀y, hj, pow_succ, pow_mul, sq, hy2, one_pow, one_mul]
  have hy₁C : y₁ ∈ centralizer ({z'} : Set ↥Λ) := Subgroup.pow_mem _ hy₀C k
  have hz'1 : z' ≠ 1 := by
    intro h
    have h1 : (z : ↥Λ ⧸ pPrimeCore 2 ↥Λ) = 1 := by rw [← hπz, h, map_one]
    have h2 : z = 1 := Subtype.ext h1
    rw [h2, orderOf_one] at hz
    exact absurd hz (by norm_num)
  have hy₁1 : y₁ ≠ 1 := by
    intro h
    apply hyZ
    rw [← hπy₁, h, map_one]
    exact Subgroup.one_mem _
  have hne : z' ≠ y₁ := by
    intro h
    apply hyZ
    rw [← hπy₁, ← h, hπz]
    exact z.2
  refine ⟨(z' : X), z'.2, (y₁ : X), y₁.2, ?_, ?_, ?_, ?_⟩
  · rw [Subgroup.orderOf_coe]
    exact orderOf_eq_prime hz'2 hz'1
  · rw [Subgroup.orderOf_coe]
    exact orderOf_eq_prime hy₁2 hy₁1
  · exact fun h => hne (Subtype.ext h)
  · exact congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.1 hy₁C).symm

private theorem s2_cen_le_of_mem_sup_odd {N R₀ : Subgroup X} (hR₀N : R₀ ≤ N)
    (hR : ∀ w ∈ R₀, orderOf w = 2 → cen w ≤ N) {w : X} (hw : w ∈ R₀ ⊔ oddCoreOf N)
    (hw2 : orderOf w = 2) : cen w ≤ N := by
  obtain ⟨h, hh, hr⟩ := exists_conj_mem_of_sup_odd (R := R₀) (O := oddCoreOf N)
    (fun c hc => le_normalizer_oddCoreOf N (hR₀N hc)) (odd_card_oddCoreOf N) hw
    (sq_eq_one_of_orderOf hw2)
  have hhN : h ∈ N := (sup_le hR₀N (oddCoreOf_le N)) hh
  have hr2 : orderOf (h * w * h⁻¹) = 2 := by rw [orderOf_conj]; exact hw2
  have hcN := hR _ hr hr2
  intro c hc
  have hcy : c * w = w * c := Subgroup.mem_centralizer_singleton_iff.1 hc
  have hc' : h * c * h⁻¹ ∈ cen (h * w * h⁻¹) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc h * c * h⁻¹ * (h * w * h⁻¹) = h * (c * w) * h⁻¹ := by group
      _ = h * (w * c) * h⁻¹ := by rw [hcy]
      _ = h * w * h⁻¹ * (h * c * h⁻¹) := by group
  have := N.mul_mem (N.mul_mem (N.inv_mem hhN) (hcN hc')) hhN
  rwa [show h⁻¹ * (h * c * h⁻¹) * h = c by group] at this

private theorem s2_card_quot_le {Λ J : Subgroup X} (hΛ : Λ ≤ J ⊔ QOf J)
    (hΛQ : Λ ⊓ QOf J ≤ oddCoreOf Λ) :
    Nat.card (↥Λ ⧸ pPrimeCore 2 ↥Λ) ≤ (zStar J).relIndex J := by
  set Q : Subgroup X := QOf J with hQ
  have hJQ : J ≤ normalizer (Q : Set X) := fun j hj =>
    mem_normalizer_QOf (Subgroup.le_normalizer hj)
  have hJQQ : J ⊔ Q ≤ normalizer (Q : Set X) := sup_le hJQ Subgroup.le_normalizer
  have h1 := card_sup_mul_card_inf (A := Q) (B := Λ) (hΛ.trans hJQQ)
  have h2 := card_sup_mul_card_inf (A := Q) (B := J) hJQ
  have h3 : Nat.card ↥(Q ⊔ Λ) ≤ Nat.card ↥(Q ⊔ J) :=
    Subgroup.card_le_of_le (sup_le le_sup_left (hΛ.trans (by rw [sup_comm])))
  have h4 : Nat.card ↥(Q ⊓ Λ) ≤ Nat.card ↥(oddCoreOf Λ) :=
    Subgroup.card_le_of_le (by rw [inf_comm]; exact hΛQ)
  have h5 : Nat.card ↥Λ = Nat.card (↥Λ ⧸ pPrimeCore 2 ↥Λ) * Nat.card ↥(oddCoreOf Λ) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (pPrimeCore 2 ↥Λ)]
    congr 1
    exact (Subgroup.card_map_of_injective Λ.subtype_injective).symm
  have h6 : (zStar J).relIndex J * Nat.card ↥(zStar J ⊓ J) = Nat.card ↥J :=
    Subgroup.relIndex_mul_card (H := zStar J) (K := J)
  have h7 : zStar J ⊓ J = Q ⊓ J := by
    rw [hQ]
    unfold zStar QOf
    exact le_antisymm (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      (le_inf (le_inf inf_le_right inf_le_left) inf_le_right)
  rw [h7] at h6
  have hQpos : 0 < Nat.card ↥Q := Nat.card_pos
  have hOpos : 0 < Nat.card ↥(oddCoreOf Λ) := Nat.card_pos
  have hQJpos : 0 < Nat.card ↥(Q ⊓ J) := Nat.card_pos
  have key : Nat.card ↥Λ * Nat.card ↥(Q ⊓ J) ≤ Nat.card ↥J * Nat.card ↥(oddCoreOf Λ) := by
    have h8 : Nat.card ↥Q * (Nat.card ↥Λ * Nat.card ↥(Q ⊓ J)) ≤
        Nat.card ↥Q * (Nat.card ↥J * Nat.card ↥(oddCoreOf Λ)) := by
      calc Nat.card ↥Q * (Nat.card ↥Λ * Nat.card ↥(Q ⊓ J))
          = Nat.card ↥(Q ⊔ Λ) * Nat.card ↥(Q ⊓ Λ) * Nat.card ↥(Q ⊓ J) := by rw [h1]; ring
        _ ≤ Nat.card ↥(Q ⊔ J) * Nat.card ↥(oddCoreOf Λ) * Nat.card ↥(Q ⊓ J) := by
          gcongr
        _ = Nat.card ↥Q * (Nat.card ↥J * Nat.card ↥(oddCoreOf Λ)) := by
          rw [mul_assoc, mul_comm (Nat.card ↥(oddCoreOf Λ)), ← mul_assoc, h2]; ring
    exact Nat.le_of_mul_le_mul_left h8 hQpos
  rw [h5] at key
  have key2 : Nat.card (↥Λ ⧸ pPrimeCore 2 ↥Λ) * Nat.card ↥(Q ⊓ J) ≤ Nat.card ↥J := by
    have h9 : Nat.card ↥(oddCoreOf Λ) * (Nat.card (↥Λ ⧸ pPrimeCore 2 ↥Λ) * Nat.card ↥(Q ⊓ J)) ≤
        Nat.card ↥(oddCoreOf Λ) * Nat.card ↥J := by
      calc Nat.card ↥(oddCoreOf Λ) * (Nat.card (↥Λ ⧸ pPrimeCore 2 ↥Λ) * Nat.card ↥(Q ⊓ J))
          = Nat.card (↥Λ ⧸ pPrimeCore 2 ↥Λ) * Nat.card ↥(oddCoreOf Λ) * Nat.card ↥(Q ⊓ J) := by
            ring
        _ ≤ Nat.card ↥J * Nat.card ↥(oddCoreOf Λ) := key
        _ = Nat.card ↥(oddCoreOf Λ) * Nat.card ↥J := by ring
    exact Nat.le_of_mul_le_mul_left h9 hOpos
  rw [← h6] at key2
  exact Nat.le_of_mul_le_mul_right key2 hQJpos

private theorem s2_mem_of_comm_inner {N J : Subgroup X} {a v j : X} (ha2 : a * a = 1)
    (haM : a ∈ normalizer (J : Set X)) (hvJ : v ∈ J) (hvq : v⁻¹ * a ∈ QOf J) (hjJ : j ∈ J)
    (hjv : ⁅v, j⁆ ∈ pPrimeCoreOf 2 J) (haN : cen a ≤ N) (hO : pPrimeCoreOf 2 J ≤ N) : j ∈ N := by
  set O : Subgroup X := pPrimeCoreOf 2 J with hOdef
  set q : X := v⁻¹ * a with hq
  have haq : a = v * q := by rw [hq, mul_inv_cancel_left]
  have hjq : ⁅j, q⁆ ∈ O := (mem_QOf_iff.1 hvq).2 j hjJ
  have hvO : v ∈ normalizer (O : Set X) := mem_normalizer_pPrimeCoreOf_of_mem hvJ
  have hjO : j ∈ normalizer (O : Set X) := mem_normalizer_pPrimeCoreOf_of_mem hjJ
  have haO : a ∈ normalizer (O : Set X) := mem_normalizer_oddCoreOf_of_mem_normalizer haM
  have hc : j⁻¹ * (a * j * a⁻¹) ∈ O := by
    have h1 : a * j * a⁻¹ = (v * ⁅j, q⁆⁻¹ * v⁻¹) * (⁅v, j⁆ * j) := by
      rw [haq, commutatorElement_def, commutatorElement_def]
      group
    rw [h1]
    have h2 : v * ⁅j, q⁆⁻¹ * v⁻¹ ∈ O := (mem_normalizer_iff.1 hvO _).1 (O.inv_mem hjq)
    have h3 : j⁻¹ * ((v * ⁅j, q⁆⁻¹ * v⁻¹) * (⁅v, j⁆ * j)) =
        j⁻¹ * ((v * ⁅j, q⁆⁻¹ * v⁻¹) * ⁅v, j⁆) * j⁻¹⁻¹ := by group
    rw [h3]
    exact (mem_normalizer_iff.1 (Subgroup.inv_mem _ hjO) _).1 (O.mul_mem h2 hjv)
  have hOodd : Odd (Nat.card O) := odd_card_oddCoreOf J
  obtain ⟨o, ho, hjo⟩ := exists_mul_mem_cen_of_coset hOodd ha2 haO hc
  have h4 : j = (j * o) * o⁻¹ := by group
  rw [h4]
  exact N.mul_mem (haN hjo) (hO (O.inv_mem ho))

private theorem s2_le_of_inner_two
    {N J : Subgroup X} {a b : X}
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hJt : Nonempty (↥J ⧸ pPrimeCore 2 ↥J ≃* Blueprint.NativeSporadic.McL) ∨
      Nonempty (↥J ⧸ pPrimeCore 2 ↥J ≃* Blueprint.NativeSporadic.Ly))
    (haJ : a ∈ J ⊔ QOf J) (hbJ : b ∈ J ⊔ QOf J) (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (haQ : a ∉ QOf J) (hbQ : b ∉ QOf J) (habQ : a * b ∉ QOf J) (hab : a * b = b * a)
    (haN : cen a ≤ N) (hbN : cen b ≤ N) (hO : pPrimeCoreOf 2 J ≤ N) : J ≤ N := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hZ : center (↥J ⧸ pPrimeCore 2 ↥J) = ⊥ := mcLLyCenterFree _ hJt
  obtain ⟨v, ⟨hvJ, -⟩, hv, hvq⟩ := s2_exists_inv_inner hZ ha2 haJ haQ
  obtain ⟨w, ⟨hwJ, -⟩, hw, hwq⟩ := s2_exists_inv_inner hZ hb2 hbJ hbQ
  have ha2' : a * a = 1 := by rw [← sq]; exact ha2
  have hb2' : b * b = 1 := by rw [← sq]; exact hb2
  have haM : a ∈ normalizer (J : Set X) := s2_sup_QOf_le_normalizer J haJ
  have hbM : b ∈ normalizer (J : Set X) := s2_sup_QOf_le_normalizer J hbJ
  set M : Subgroup X := normalizer (J : Set X) with hMdef
  have hQM : QOf J ≤ M := fun q hq => (mem_QOf_iff.1 hq).1
  have hJM : J ≤ M := Subgroup.le_normalizer
  haveI hQn : ((QOf J).subgroupOf M).Normal :=
    (normal_subgroupOf_iff_le_normalizer hQM).2 fun m hm => mem_normalizer_QOf hm
  set ρ : ↥M →* ↥M ⧸ (QOf J).subgroupOf M := QuotientGroup.mk' _ with hρ
  have hρeq : ∀ g h : ↥M, ρ g = ρ h ↔ (g : X)⁻¹ * h ∈ QOf J := fun g h => by
    rw [hρ, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq,
      Subgroup.mem_subgroupOf]
    simp
  have hρ1 : ∀ g : ↥M, ρ g = 1 ↔ (g : X) ∈ QOf J := fun g => by
    rw [hρ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
  set v₁ : ↥M := ⟨v, hJM hvJ⟩
  set w₁ : ↥M := ⟨w, hJM hwJ⟩
  set a₁ : ↥M := ⟨a, haM⟩
  set b₁ : ↥M := ⟨b, hbM⟩
  have hva : ρ v₁ = ρ a₁ := (hρeq _ _).2 hvq
  have hwb : ρ w₁ = ρ b₁ := (hρeq _ _).2 hwq
  have hvw : ⁅v, w⁆ ∈ pPrimeCoreOf 2 J := by
    have h1 : ⁅v, w⁆ ∈ QOf J := by
      have h2 : ρ ⁅v₁, w₁⁆ = 1 := by
        rw [map_commutatorElement, hva, hwb, ← map_commutatorElement,
          commutatorElement_eq_one_iff_mul_comm.2 (Subtype.ext hab), map_one]
      exact (hρ1 _).1 h2
    have h3 : ⁅v, w⁆ ∈ J := by
      rw [commutatorElement_def]
      exact J.mul_mem (J.mul_mem (J.mul_mem hvJ hwJ) (J.inv_mem hvJ)) (J.inv_mem hwJ)
    exact zStar_le_oddCoreOf_of_center hZ ⟨h3, h1⟩
  have hvw' : v⁻¹ * w ∉ pPrimeCoreOf 2 J := by
    intro h
    apply habQ
    have h1 : ρ v₁ = ρ w₁ := (hρeq _ _).2 (oddCoreOf_le_QOf J h)
    rw [hva, hwb] at h1
    have h2 := (hρeq _ _).1 h1
    have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha2'
    rwa [hai] at h2
  set π : ↥J →* ↥J ⧸ pPrimeCore 2 ↥J := QuotientGroup.mk' (pPrimeCore 2 ↥J) with hπ
  set v' : ↥J := ⟨v, hvJ⟩
  set w' : ↥J := ⟨w, hwJ⟩
  have hov : orderOf (π v') = 2 := s2_orderOf_mk hvJ hv
  have how : orderOf (π w') = 2 := s2_orderOf_mk hwJ hw
  have hne : π v' ≠ π w' := by
    intro h
    apply hvw'
    have h1 : v'⁻¹ * w' ∈ pPrimeCore 2 ↥J := by
      rw [← QuotientGroup.eq_one_iff]
      change π (v'⁻¹ * w') = 1
      rw [map_mul, map_inv, h, inv_mul_cancel]
    exact ⟨_, h1, rfl⟩
  have hcomm : π v' * π w' = π w' * π v' := by
    obtain ⟨c, hc, hcvw⟩ := hvw
    have hc' : c = ⁅v', w'⁆ := Subtype.ext hcvw
    have h1 : π ⁅v', w'⁆ = 1 := by
      rw [← hc']
      exact (QuotientGroup.eq_one_iff c).2 hc
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm] at h1
    exact h1
  have hgen : centralizer ({π v'} : Set (↥J ⧸ pPrimeCore 2 ↥J)) ⊔
      centralizer ({π w'} : Set (↥J ⧸ pPrimeCore 2 ↥J)) = ⊤ := by
    rcases hJt with he | he
    · exact hgenM _ he _ _ hov how hne hcomm
    · exact hgenL _ he _ _ hov how hne hcomm
  have hpre : ∀ (u : X) (hu : u ∈ J) (c : X), u⁻¹ * c ∈ QOf J → c * c = 1 →
      c ∈ normalizer (J : Set X) → cen c ≤ N →
      (centralizer ({π ⟨u, hu⟩} : Set (↥J ⧸ pPrimeCore 2 ↥J))).comap π ≤ N.comap J.subtype := by
    intro u hu c huc hc2 hcM hcN g hg
    have hg' : π g * π ⟨u, hu⟩ = π ⟨u, hu⟩ * π g := Subgroup.mem_centralizer_singleton_iff.1 hg
    have hug : ⁅u, (g : X)⁆ ∈ pPrimeCoreOf 2 J := by
      have h1 : π ⁅(⟨u, hu⟩ : ↥J), g⁆ = 1 := by
        rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
        exact hg'.symm
      exact ⟨_, (QuotientGroup.eq_one_iff _).1 h1, rfl⟩
    exact Subgroup.mem_comap.2 (s2_mem_of_comm_inner (N := N) hc2 hcM hu huc g.2 hug hcN hO)
  have hle : (centralizer ({π v'} : Set (↥J ⧸ pPrimeCore 2 ↥J))).comap π ⊔
      (centralizer ({π w'} : Set (↥J ⧸ pPrimeCore 2 ↥J))).comap π ≤ N.comap J.subtype :=
    sup_le (hpre v hvJ a hvq ha2' haM haN) (hpre w hwJ b hwq hb2' hbM hbN)
  have hsurj : Function.Surjective π := QuotientGroup.mk'_surjective _
  rw [Subgroup.comap_sup_eq (f := π) _ _ hsurj, hgen, Subgroup.comap_top] at hle
  intro j hj
  exact hle (Subgroup.mem_top (⟨j, hj⟩ : ↥J))

end Swap

theorem sec6FusStep2_of_swap
    {X : Type} [Group X] [Finite X] {n : ℕ} {t : X} (hS : Sec6Setting X n t) {N : Subgroup X}
    (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N)
    (hgenM : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.McL) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    (hgenL : ∀ (G : Type) [Group G] [Finite G], Nonempty (G ≃* Blueprint.NativeSporadic.Ly) →
      ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x ≠ y → x * y = y * x →
        centralizer ({x} : Set G) ⊔ centralizer ({y} : Set G) = ⊤)
    {x : X} (hxN : x ∈ N) (hx2 : orderOf x = 2) {F : Subgroup X} (hF : Sec6MComp X n N F)
    (hne : F.map (MulAut.conj x).toMonoidHom ≠ F) : Sec6K X n (cen x) ≤ N := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hn2 : 2 ≤ n := by rcases hS.deg with h | h <;> omega
  have hn8 : 8 ≤ n := by rcases hS.deg with h | h <;> omega
  have hxx : x * x = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf hx2
  have hZ : center (↥F ⧸ pPrimeCore 2 ↥F) = ⊥ := mcLLyCenterFree _ hF.1.2.1
  obtain ⟨Δ, hΔle, hΔpc, hΔsub, ⟨eΔ⟩⟩ := s2_diag hF.1.1 hZ hxN hxx hne
  set F' : Subgroup X := F.map (MulAut.conj x).toMonoidHom with hF'
  have hFM : F ≤ Sec6M X n N := le_sSup hF
  have hF'M : F' ≤ Sec6M X n N := by
    rw [← map_conj_Sec6M n (Subgroup.le_normalizer hxN)]
    exact Subgroup.map_mono hFM
  have hFF'N : F ⊔ F' ≤ N := sup_le hFM hF'M |>.trans (sec6M_le n N)
  have hRF : ∀ w ∈ F ⊔ F', orderOf w = 2 → cen w ≤ N := fun w hw hw2 =>
    hI w ((le_sup_right : Sec6M X n N ≤ Sec6R X n N) (sup_le hFM hF'M hw)) hw2
  have hΔR : Δ ≤ (F ⊔ F') ⊔ oddCoreOf N := by
    intro d hd
    obtain ⟨m, hm, hmd⟩ := hΔsub d hd
    have h1 : d = (d * (m * (x * m * x⁻¹))⁻¹) * (m * (x * m * x⁻¹)) := by group
    rw [h1, sup_comm]
    exact Subgroup.mul_mem_sup hmd (Subgroup.mul_mem_sup hm ⟨m, hm, rfl⟩)
  have hcenΔ : ∀ w ∈ Δ, orderOf w = 2 → cen w ≤ N := fun w hw hw2 =>
    s2_cen_le_of_mem_sup_odd hFF'N hRF (hΔR hw) hw2
  have hΔq : IsTwoGenQuasi ↥Δ :=
    (isTwoGenQuasi_subgroupOf_iff hΔpc.1).1 (isPComponent_two_iff.1 hΔpc.2).2
  have hTΔ : IsSec6MType n (↥Δ ⧸ pPrimeCore 2 ↥Δ) := hF.2.congr eΔ.symm
  obtain ⟨e, heΔ, he2⟩ := Sec6L51B.exists_involution_of_isTwoGenQuasi hΔq
  have heN : cen e ≤ N := hcenΔ e heΔ he2
  obtain ⟨Λ, hΛle, hΛpc, hΛdc⟩ := s2_pump hΔpc hTΔ heΔ he2
  have hex : e ∈ cen x := (hΔle heΔ).2
  have hNxe : N ⊓ cen x ⊓ cen e = cen e ⊓ cen x :=
    le_antisymm (le_inf inf_le_right (inf_le_left.trans inf_le_right))
      (le_inf (le_inf (inf_le_left.trans heN) inf_le_right) inf_le_left)
  rw [hNxe] at hΛpc
  have hΛE : Λ ≤ pLayerOf 2 (cen x) :=
    GH74.GLS.Stage1.Thm2.Recip.le_pLayerOf_of_isPCompIn_inf he2 hex hΛpc
  have hΛΔ : Λ ≤ Δ := hΛle.trans inf_le_left
  have hΛx : Λ ≤ cen x := hΛpc.1.trans inf_le_right
  obtain ⟨a, haΛ, b, hbΛ, ha, hb, hab_ne, hab⟩ := s2_four_of_dc hn8 hΛdc
  have ha2 : a * a = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf ha
  have hb2 : b * b = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf hb
  have hab2 : orderOf (a * b) = 2 := by
    refine orderOf_eq_prime ?_ ?_
    · rw [sq, mul_assoc, ← mul_assoc b a b, ← hab, mul_assoc a b b, hb2, mul_one, ha2]
    · intro h
      apply hab_ne
      have h1 : b = a⁻¹ := (eq_inv_of_mul_eq_one_right h)
