variable {X : Type} [Group X] [Finite X]

private theorem s2_isQuasisimple_of_simple {J : Type*} [Group J] (hs : IsSimpleGroup J)
    (hn : ∃ a b : J, a * b ≠ b * a) : CFSG.IsQuasisimple J := by
  have hc : center J = ⊥ := by
    rcases (inferInstance : (center J).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · exfalso
      obtain ⟨a, b, hab⟩ := hn
      exact hab (Subgroup.mem_center_iff.1 (h ▸ Subgroup.mem_top b) a)
  let e : J ⧸ center J ≃* J :=
    (QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot
  refine ⟨?_, e.isSimpleGroup, ?_⟩
  · refine Group.isPerfect_def.mpr ?_
    rcases (inferInstance : (commutator J).Normal).eq_bot_or_eq_top with h | h
    · exfalso
      obtain ⟨a, b, hab⟩ := hn
      have hmem : ⁅a, b⁆ ∈ commutator J := Subgroup.commutator_mem_commutator
        (Subgroup.mem_top a) (Subgroup.mem_top b)
      rw [h, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at hmem
      exact hab hmem
    · exact h
  · obtain ⟨a, b, hab⟩ := hn
    exact ⟨e.symm a, e.symm b, fun h => hab (by simpa using congrArg e h)⟩

private theorem s2_W_quot {F : Subgroup X} {x : X} (hx2 : x ^ 2 = 1)
    (hxN : x ∈ normalizer (F : Set X))
    (hs : IsSimpleGroup ↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN)))
    (h2 : 2 ∣ Nat.card ↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN))) :
    Nonempty (↥(oTwoPrimeOf (F ⊓ cen x)) ⧸ pPrimeCore 2 ↥(oTwoPrimeOf (F ⊓ cen x)) ≃*
      ↥(CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN))) := by
  classical
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI := hs
  set Φ : Subgroup (↥F ⧸ pPrimeCore 2 ↥F) :=
    CFSG.Sporadic.Recognition.McLAS.fixedSubgroup (quotConj hxN) with hΦ
  set π : ↥F →* ↥F ⧸ pPrimeCore 2 ↥F := QuotientGroup.mk' (pPrimeCore 2 ↥F) with hπ
  set W : Subgroup X := oTwoPrimeOf (F ⊓ cen x) with hW
  have hWF : W ≤ F := (oTwoPrimeOf_le _).trans inf_le_left
  have hWx : W ≤ cen x := (oTwoPrimeOf_le _).trans inf_le_right
  have hxO : x ∈ normalizer (pPrimeCoreOf 2 F : Set X) :=
    mem_normalizer_oddCoreOf_of_mem_normalizer hxN
  have hmemΦ : ∀ f : ↥F, π f ∈ Φ ↔ ⁅(f : X), x⁆ ∈ pPrimeCoreOf 2 F := by
    intro f
    rw [hΦ, s2_mem_fixedSubgroup, hπ, QuotientGroup.mk'_apply, s2_quotConj_mk, QuotientGroup.eq]
    have key : (((conjAut hxN f)⁻¹ * f : ↥F) : X) = (f : X)⁻¹ * ⁅(f : X), x⁆ * (f : X) := by
      simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv, coe_conjAut]
      group
    have hfO : (f : X) ∈ normalizer (pPrimeCoreOf 2 F : Set X) :=
      mem_normalizer_pPrimeCoreOf_of_mem f.2
    constructor
    · intro h
      have h1 := (s2_mem_oddCoreOf_iff ((conjAut hxN f)⁻¹ * f)).2 h
      rw [key] at h1
      have h2 := (mem_normalizer_iff.1 hfO ((f : X)⁻¹ * ⁅(f : X), x⁆ * (f : X))).1 h1
      rwa [show (f : X) * ((f : X)⁻¹ * ⁅(f : X), x⁆ * (f : X)) * (f : X)⁻¹ = ⁅(f : X), x⁆ by
        group] at h2
    · intro h
      have h1 := (mem_normalizer_iff.1 (Subgroup.inv_mem _ hfO) ⁅(f : X), x⁆).1 h
      rw [inv_inv] at h1
      rw [← key] at h1
      exact (s2_mem_oddCoreOf_iff _).1 h1
  have hmap : (W.subgroupOf F).map π = Φ := by
    apply le_antisymm
    · rintro _ ⟨w, hw, rfl⟩
      rw [hmemΦ]
      have hwx : (w : X) * x = x * w :=
        Subgroup.mem_centralizer_singleton_iff.1 (hWx (Subgroup.mem_subgroupOf.1 hw))
      rw [commutatorElement_eq_one_iff_mul_comm.2 hwx]
      exact one_mem _
    · have htop : primeResidual 2 ↥Φ = ⊤ := by
        haveI := primeResidual_characteristic 2 ↥Φ
        rcases (inferInstance : (primeResidual 2 ↥Φ).Normal).eq_bot_or_eq_top with h | h
        · exfalso
          obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' (G := ↥Φ) 2 h2
          have hu' : u ∈ primeResidual 2 ↥Φ :=
            pSubgroup_le_residual 2 (zpowers u) (IsPGroup.of_card (n := 1) (by
              rw [Nat.card_zpowers, hu, pow_one])) (Subgroup.mem_zpowers u)
          rw [h, Subgroup.mem_bot] at hu'
          rw [hu', orderOf_one] at hu
          exact absurd hu (by norm_num)
        · exact h
      intro φ hφ
      have hφ' : (⟨φ, hφ⟩ : ↥Φ) ∈ primeResidual 2 ↥Φ := by rw [htop]; exact Subgroup.mem_top _
      rw [primeResidual_eq_closure] at hφ'
      have hgen : Subgroup.closure {u : ↥Φ | ∃ k : ℕ, orderOf u = 2 ^ k} ≤
          ((W.subgroupOf F).map π).subgroupOf Φ := by
        rw [Subgroup.closure_le]
        rintro ⟨u, huΦ⟩ ⟨k, hk⟩
        rw [SetLike.mem_coe, Subgroup.mem_subgroupOf]
        obtain ⟨y₀, rfl⟩ := QuotientGroup.mk'_surjective (pPrimeCore 2 ↥F) u
        have hk' : (π y₀) ^ (2 ^ k) = 1 := by
          have := pow_orderOf_eq_one (⟨π y₀, huΦ⟩ : ↥Φ)
          rw [hk] at this
          simpa using congrArg Subtype.val this
        have hy₀k : (y₀ : X) ^ (2 ^ k) ∈ pPrimeCoreOf 2 F := by
          have h1 : y₀ ^ (2 ^ k) ∈ pPrimeCore 2 ↥F := by
            rw [← QuotientGroup.eq_one_iff]
            change π (y₀ ^ (2 ^ k)) = 1
            rw [map_pow]
            exact hk'
          exact ⟨_, h1, by simp⟩
        obtain ⟨m, hm2, hmy⟩ := exists_zpow_twoElt_of_pow_mem
          (Nat.coprime_two_left.2 (odd_card_oddCoreOf F)) hy₀k
        set y : X := (y₀ : X) ^ m with hy
        have hyF : y ∈ F := F.zpow_mem y₀.2 m
        have hπy : π ⟨y, hyF⟩ = π y₀ := by
          rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, eq_comm, QuotientGroup.eq]
          obtain ⟨o, ho, hoy⟩ := hmy
          have : o = y₀⁻¹ * ⟨y, hyF⟩ := Subtype.ext hoy
          rw [← this]
          exact ho
        have hyx : ⁅y, x⁆ ∈ pPrimeCoreOf 2 F := by
          have := (hmemΦ ⟨y, hyF⟩).1 (by rw [hπy]; exact huΦ)
          exact this
        obtain ⟨c, hc, hc2, hcy⟩ := exists_twoElt_centralizer_of_comm_mem hx2 hxO hyF hyx hm2
        have hcW : c ∈ W := mem_oTwoPrimeOf hc k hc2
        have hcF : c ∈ F := (Subgroup.mem_inf.1 hc).1
        refine ⟨⟨c, hcF⟩, Subgroup.mem_subgroupOf.2 hcW, ?_⟩
        show π ⟨c, hcF⟩ = π y₀
        rw [← hπy, hπ, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
        obtain ⟨o, ho, hoc⟩ := hcy
        have : o = (⟨c, hcF⟩ : ↥F)⁻¹ * ⟨y, hyF⟩ := Subtype.ext hoc
        rw [← this]
        exact ho
      exact Subgroup.mem_subgroupOf.1 (hgen hφ')
  have hker : ¬ 2 ∣ Nat.card π.ker :=
    CFSG.ComponentClassification.GSThmB.OddQuot.not_two_dvd_card_ker
  obtain ⟨q₁⟩ := CFSG.ComponentClassification.GSThmB.OddQuot.nonempty_quotient_pPrimeCore_equiv π
    hker (W.subgroupOf F)
  obtain ⟨q₂⟩ := nonempty_quotPPrimeCore_equiv (MulEquiv.subgroupCongr hmap)
  have hOΦ : pPrimeCore 2 ↥Φ = ⊥ := by
    rcases (inferInstance : (pPrimeCore 2 ↥Φ).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · exfalso
      have hc : Nat.Coprime 2 (Nat.card (pPrimeCore 2 ↥Φ)) := pPrimeCore_coprime_card
      rw [h, Subgroup.card_top] at hc
      exact absurd h2 ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).1 hc)
  let q₃ : ↥Φ ⧸ pPrimeCore 2 ↥Φ ≃* ↥Φ :=
    (QuotientGroup.quotientMulEquivOfEq hOΦ).trans QuotientGroup.quotientBot
  obtain ⟨q₀⟩ := nonempty_quotPPrimeCore_equiv (Subgroup.subgroupOfEquivOfLe hWF)
  exact ⟨q₀.symm.trans (q₁.trans (q₂.trans q₃))⟩

