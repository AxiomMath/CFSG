variable {X : Type} [Group X] [Finite X]

private theorem s2_quotConj_mk {A : Subgroup X} {c : X} (hc : c ∈ normalizer (A : Set X))
    (a : ↥A) : quotConj hc (QuotientGroup.mk a) = QuotientGroup.mk (conjAut hc a) := rfl

private theorem s2_mem_sup_of_conj {F : Subgroup X} {t : X} (htN : t ∈ normalizer (F : Set X))
    {g : ↥F ⧸ pPrimeCore 2 ↥F} (hα : quotConj htN = MulAut.conj g) : t ∈ F ⊔ QOf F := by
  obtain ⟨g₀, rfl⟩ := QuotientGroup.mk_surjective g
  have hcm : CentModOdd F ((g₀ : X)⁻¹ * t) := by
    intro a ha
    set a' : ↥F := ⟨a⁻¹, F.inv_mem ha⟩ with ha'
    have h1 : (QuotientGroup.mk (g₀ * a' * g₀⁻¹) : ↥F ⧸ pPrimeCore 2 ↥F) =
        QuotientGroup.mk (conjAut htN a') := by
      rw [← s2_quotConj_mk, hα, MulAut.conj_apply]
      rfl
    rw [QuotientGroup.eq] at h1
    have h2 : (g₀ : X) * a * (g₀ : X)⁻¹ * (t * a⁻¹ * t⁻¹) ∈ pPrimeCoreOf 2 F := by
      refine ⟨_, h1, ?_⟩
      show (((g₀ * a' * g₀⁻¹)⁻¹ * conjAut htN a' : ↥F) : X) = _
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, coe_conjAut, ha']
      group
    have h3 : ⁅a, (g₀ : X)⁻¹ * t⁆ =
        (g₀ : X)⁻¹ * ((g₀ : X) * a * (g₀ : X)⁻¹ * (t * a⁻¹ * t⁻¹)) * (g₀ : X)⁻¹⁻¹ := by
      rw [commutatorElement_def]
      group
    rw [h3]
    exact (mem_normalizer_iff.1 (mem_normalizer_pPrimeCoreOf_of_mem (F.inv_mem g₀.2)) _).1 h2
  have hgN : (g₀ : X)⁻¹ * t ∈ normalizer (F : Set X) :=
    Subgroup.mul_mem _ (Subgroup.le_normalizer (F.inv_mem g₀.2)) htN
  have hq : (g₀ : X)⁻¹ * t ∈ QOf F := mem_QOf_iff.2 ⟨hgN, hcm⟩
  have h4 : t = (g₀ : X) * ((g₀ : X)⁻¹ * t) := by group
  rw [h4]
  exact Subgroup.mul_mem_sup g₀.2 hq

private theorem s2_mem_sup_of_ly
    {F : Subgroup X} {t : X} (htN : t ∈ normalizer (F : Set X))
    (he : Nonempty (↥F ⧸ pPrimeCore 2 ↥F ≃* Blueprint.NativeSporadic.Ly)) : t ∈ F ⊔ QOf F := by
