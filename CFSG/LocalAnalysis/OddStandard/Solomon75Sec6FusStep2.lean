private theorem s2_oddCoreOf_cen_le {N : Subgroup X} {x a b : X} (ha : a * a = 1)
    (hb : b * b = 1) (hab : a * b = b * a) (hax : a ∈ cen x) (hbx : b ∈ cen x)
    (hK : ∀ w ∈ ({a, b, a * b} : Set X), cen w ≤ N) : oddCoreOf (cen x) ≤ N :=
  Holt.StarLemma26.le_of_forall_commute_mem (odd_card_oddCoreOf _) ha hb hab
    (le_normalizer_oddCoreOf _ hax) (le_normalizer_oddCoreOf _ hbx)
    fun w hw _ _ hwn => hK w hw (mem_centralizer_singleton_iff.2 hwn.symm)

theorem sec6Step2a_of_four {n : ℕ} {N : Subgroup X}
    (hI : ∀ x ∈ Sec6R X n N, orderOf x = 2 → cen x ≤ N) {x a b : X}
    (haM : a ∈ Sec6M X n N) (hbM : b ∈ Sec6M X n N) (ha : orderOf a = 2) (hb : orderOf b = 2)
    (hne : a ≠ b) (hab : a * b = b * a) (hax : a ∈ cen x) (hbx : b ∈ cen x) :
    oddCoreOf (cen x) ≤ N := by
  have ha2 : a * a = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf ha
  have hb2 : b * b = 1 := by rw [← sq]; exact sq_eq_one_of_orderOf hb
  have hMR : Sec6M X n N ≤ Sec6R X n N := le_sup_right
  have hab2 : orderOf (a * b) = 2 := by
    refine orderOf_eq_prime ?_ ?_
    · rw [sq, mul_assoc, ← mul_assoc b a b, ← hab, mul_assoc a b b, hb2, mul_one, ha2]
    · intro h
      apply hne
      have h1 : b = a⁻¹ := (eq_inv_of_mul_eq_one_right h)
      rw [h1, inv_eq_of_mul_eq_one_right ha2]
  refine s2_oddCoreOf_cen_le ha2 hb2 hab hax hbx fun w hw => ?_
  rcases hw with rfl | rfl | rfl
  · exact hI _ (hMR haM) ha
  · exact hI _ (hMR hbM) hb
  · exact hI _ (hMR ((Sec6M X n N).mul_mem haM hbM)) hab2

private theorem s2_exists_sq_eq_one_mk {G : Type*} [Group G] [Finite G] (N : Subgroup G)
    [N.Normal] (hN : Odd (Nat.card N)) (u : G ⧸ N) (hu : u ^ 2 = 1) :
    ∃ s : G, s ^ 2 = 1 ∧ (s : G ⧸ N) = u := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective u
  have hg2 : g ^ 2 ∈ N := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow]
    exact hu
  refine ⟨g ^ Nat.card N, ?_, ?_⟩
  · have h1 : (⟨g ^ 2, hg2⟩ : N) ^ Nat.card N = 1 := pow_card_eq_one'
    have h2 := congrArg Subtype.val h1
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at h2
    rw [← pow_mul, mul_comm, pow_mul]
    exact h2
  · obtain ⟨k, hk⟩ := hN
    rw [QuotientGroup.mk_pow, hk, pow_succ, pow_mul, hu, one_pow, one_mul]

private theorem s2_exists_ne_of_isAhatIntr {J : Subgroup X} {s : X} (hJ : IsAhatIntr X s J) :
    ∃ r ∈ J, r ^ 2 = 1 ∧ r ≠ 1 ∧ r ≠ s := by
  obtain ⟨hJC, hsJ, -, m, hm, hdc⟩ := hJ
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨-, y, -, hy2, hyZ, -⟩ := AhatData.exists_hub hm (AhatData.CoverSetup.ofCover hdc)
  have hodd : Odd (Nat.card (pPrimeCore 2 ↥J)) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
  obtain ⟨r, hr2, hry⟩ :=
    s2_exists_sq_eq_one_mk (pPrimeCore 2 ↥J) hodd y (by rw [sq]; exact hy2)
  have hsZ : (⟨s, hsJ⟩ : ↥J) ∈ center ↥J := by
    rw [Subgroup.mem_center_iff]
    intro g
    exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.1 (hJC g.2))
  have hmkZ : ∀ z : ↥J, z ∈ center ↥J →
      (z : ↥J ⧸ pPrimeCore 2 ↥J) ∈ center (↥J ⧸ pPrimeCore 2 ↥J) := fun z hz =>
    Subgroup.map_center_le_center (f := QuotientGroup.mk' (pPrimeCore 2 ↥J))
      (QuotientGroup.mk'_surjective _) (Subgroup.mem_map_of_mem _ hz)
  refine ⟨r, r.2, ?_, ?_, ?_⟩
  · have h := congrArg Subtype.val hr2
    simpa using h
  · intro h
    have hr : r = 1 := Subtype.ext h
    apply hyZ
    rw [← hry, hr, QuotientGroup.mk_one]
    exact Subgroup.one_mem _
  · intro h
    have hr : r = ⟨s, hsJ⟩ := Subtype.ext h
    apply hyZ
    rw [← hry, hr]
    exact hmkZ _ hsZ

private theorem s2_exists_two_of_isAhatIntr {s : X} {D J : Subgroup X} (hs : orderOf s = 2)
    (hJ : IsAhatIntr X s J) (hJD : J ≤ (D ⊓ cen s) ⊔ oddCoreOf (cen s)) :
    ∃ a ∈ D, a * a = 1 ∧ a ≠ 1 ∧ a ≠ s ∧ s * a = a * s := by
  obtain ⟨r, hrJ, hr2, hr1, hrs⟩ := s2_exists_ne_of_isAhatIntr hJ
  have hr2' : r ^ 2 ^ 1 = 1 := by
    rw [pow_one]
    exact hr2
  obtain ⟨o, ho, a, ha, ha2, hra⟩ := exists_conj_twoElt_of_mem_sup_odd_X
    (A := D ⊓ cen s) (N := oddCoreOf (cen s))
    (fun c hc => le_normalizer_oddCoreOf (cen s) (Subgroup.mem_inf.1 hc).2)
    (odd_card_oddCoreOf _) (hJD hrJ) hr2'
  rw [pow_one] at ha2
  have hoC : o ∈ cen s := oddCoreOf_le _ ho
  refine ⟨a, (Subgroup.mem_inf.1 ha).1, by rw [← pow_two]; exact ha2, ?_, ?_,
    (Subgroup.mem_centralizer_singleton_iff.1 (Subgroup.mem_inf.1 ha).2).symm⟩
  · intro h
    apply hr1
    rw [hra, h, mul_one, mul_inv_cancel]
  · intro h
    apply hrs
    have hcomm : o * s = s * o := Subgroup.mem_centralizer_singleton_iff.1 hoC
    rw [hra, h, hcomm, mul_inv_cancel_right]

private theorem s2_exists_four {n : ℕ} {H F : Subgroup X} (hF : Sec6KComp X n H F) :
    ∃ a ∈ F, ∃ b ∈ F, orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a := by
  have hfact : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have key : ∀ s ∈ F, orderOf s = 2 → ∀ J : Subgroup X, IsAhatIntr X s J →
      J ≤ (F ⊓ cen s) ⊔ oddCoreOf (cen s) →
      ∃ a ∈ F, ∃ b ∈ F, orderOf a = 2 ∧ orderOf b = 2 ∧ a ≠ b ∧ a * b = b * a := by
    intro s hsF hs J hJ hJF
    obtain ⟨a, haF, ha2, ha1, has, hsa⟩ := s2_exists_two_of_isAhatIntr hs hJ hJF
    exact ⟨s, hsF, a, haF, hs, orderOf_eq_prime (by rw [sq]; exact ha2) ha1, has.symm, hsa⟩
  rcases hF with ⟨⟨u, hu⟩, -⟩ | ⟨⟨hpc, -, hJ⟩, -⟩
  · obtain ⟨hu2, huF, -, -, Lu, hLu, hLueq⟩ := hu
    refine key u huF hu2 Lu hLu (hLueq.le.trans (sup_le ?_ ?_))
    · exact (pPrimeCoreOf_le_oddCoreOf hLu.1 (isPComponent_two_iff.1 hLu.2.2.1).1).trans
        le_sup_right
    · rw [oPrimeResidualOf_two_eq_oTwoPrimeOf]
      exact (oTwoPrimeOf_le _).trans le_sup_left
  · have hq : IsTwoGenQuasi ↥F :=
      (isTwoGenQuasi_subgroupOf_iff hpc.1).1 (isPComponent_two_iff.1 hpc.2).2
    obtain ⟨s, hsF, hs⟩ := Sec6L51B.exists_involution_of_isTwoGenQuasi hq
    obtain ⟨J, hJs, hJle⟩ := hJ s hsF hs
    exact key s hsF hs J hJs hJle

private theorem s2_le_of_mem_QOf {N J : Subgroup X} {x r : X} (hJ : IsPCompIn 2 (cen x) J)
    (hr2 : r ^ 2 = 1) (hrJ : r ∈ QOf J) (hrN : cen r ≤ N) (hO : oddCoreOf (cen x) ≤ N) :
    J ≤ N := by
  have hJq : IsTwoGenQuasi ↥J :=
    (isTwoGenQuasi_subgroupOf_iff hJ.1).1 (isPComponent_two_iff.1 hJ.2).2
  have hcov := oTwoPrimeOf_inf_centralizer_covers hr2 hJq.1 hrJ
  have hPJ : oTwoPrimeOf (J ⊓ cen r) ≤ J := (oTwoPrimeOf_le _).trans inf_le_left
  rw [covers_subgroupOf_iff hPJ] at hcov
  rw [← hcov]
  exact sup_le ((oTwoPrimeOf_le _).trans (inf_le_right.trans hrN))
    ((pPrimeCoreOf_le_oddCoreOf hJ.1 (isPComponent_two_iff.1 hJ.2).1).trans hO)

private theorem s2_isSubnormal_inf {K D D' H : Subgroup X} (hHD : H ≤ D) (hHD' : H ≤ D')
    (hK : (K.subgroupOf D).IsSubnormal) : ((K ⊓ D').subgroupOf H).IsSubnormal := by
  have h1 : (K ⊓ D').subgroupOf H = (K.subgroupOf D).comap (Subgroup.inclusion hHD) := by
    ext x
    simp only [Subgroup.mem_subgroupOf, Subgroup.mem_comap, Subgroup.mem_inf]
    exact ⟨fun h => h.1, fun h => ⟨h, hHD' x.2⟩⟩
  rw [h1]
  exact hK.comap _

private theorem s2_isPCompIn_piece {H L : Subgroup X} {c : X} (hL : IsPCompIn 2 H L)
    (hq : IsTwoGenQuasi ↥(oTwoPrimeOf (L ⊓ cen c))) :
    IsPCompIn 2 (cen c ⊓ H) (oTwoPrimeOf (L ⊓ cen c)) := by
  have hAH : L ⊓ cen c ≤ cen c ⊓ H := le_inf inf_le_right (inf_le_left.trans hL.1)
  have hA : ((L ⊓ cen c).subgroupOf (cen c ⊓ H)).IsSubnormal :=
    s2_isSubnormal_inf inf_le_right inf_le_left (isPComponent_two_iff.1 hL.2).1
  have hEH : oTwoPrimeOf (L ⊓ cen c) ≤ cen c ⊓ H := (oTwoPrimeOf_le _).trans hAH
  refine ⟨hEH, isPComponent_two_iff.2 ⟨?_, (isTwoGenQuasi_subgroupOf_iff hEH).2 hq⟩⟩
  exact isSubnormal_subgroupOf_of_normal_of_subnormal hAH (oTwoPrimeOf_le _) hA
    (normal_subgroupOf_oTwoPrimeOf _)

private theorem s2_inf_le_oddCoreOf {L N : Subgroup X} (hLN : L ≤ normalizer (N : Set X))
    (hN : Odd (Nat.card N)) : L ⊓ N ≤ oddCoreOf L :=
  le_oddCoreOf_of_normalized inf_le_left
    (fun g hg => mem_normalizer_inf (Subgroup.le_normalizer hg) (hLN hg))
    (hN.of_dvd_nat (Subgroup.card_dvd_of_le inf_le_right))

private theorem s2_mem_normalizer_of_map_le {V : Subgroup X} {b : X}
    (h : V.map (MulAut.conj b).toMonoidHom ≤ V) : b ∈ normalizer (V : Set X) :=
  mem_normalizer_of_map_conj_eq (Subgroup.eq_of_le_of_card_ge h
    (by rw [Subgroup.card_map_of_injective (MulAut.conj b).injective]))

private theorem s2_mem_normalizer_oTwoPrimeOf {A : Subgroup X} {g : X}
    (hg : g ∈ normalizer (A : Set X)) : g ∈ normalizer (oTwoPrimeOf A : Set X) := by
  apply s2_mem_normalizer_of_map_le
  have := map_oTwoPrimeOf_le A (MulAut.conj g).toMonoidHom
  rwa [map_conj_eq_of_mem_normalizer hg] at this

private theorem s2_odd_card_sup {H N : Subgroup X}
    (hHN : H ≤ normalizer (N : Set X)) (hH : Odd (Nat.card H)) (hN : Odd (Nat.card N)) :
    Odd (Nat.card (H ⊔ N : Subgroup X)) := by
  have := Subgroup.normal_subgroupOf_of_le_normalizer hHN
  have := Subgroup.normal_subgroupOf_sup_of_le_normalizer hHN
  have e := QuotientGroup.quotientInfEquivProdNormalizerQuotient H N hHN
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (N.subgroupOf (H ⊔ N)),
    ← Nat.card_congr e.toEquiv,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (le_sup_right : N ≤ H ⊔ N)).toEquiv]
  exact (Odd.of_dvd_nat hH (Subgroup.card_quotient_dvd_card _)).mul hN

private theorem s2_mem_normalizer_sup_of_mem {A B C : Subgroup X} (hAC : A ≤ C)
    (hBn : C ≤ normalizer (B : Set X)) {o : X} (ho : o ∈ B) :
    o ∈ normalizer ((A ⊔ B : Subgroup X) : Set X) := by
  apply s2_mem_normalizer_of_map_le
  rw [Subgroup.map_sup]
  refine sup_le ?_ ?_
  · rintro _ ⟨a, ha, rfl⟩
    have h1 : a⁻¹ * o * a ∈ B := by
      have := (mem_normalizer_iff.1 (hBn (C.inv_mem (hAC ha))) o).1 ho
      rwa [inv_inv] at this
    have h2 : (MulAut.conj o).toMonoidHom a = a * ((a⁻¹ * o * a) * o⁻¹) := by
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group
    rw [h2]
    exact Subgroup.mul_mem_sup ha (B.mul_mem h1 (B.inv_mem ho))
  · rintro _ ⟨b, hb, rfl⟩
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact le_sup_right (a := A) (B.mul_mem (B.mul_mem ho hb) (B.inv_mem ho))

private theorem s2_card_of_dc {K : Type} [Group K] {m : ℕ} (hm : 2 ≤ m)
    (h : IsDoubleCoverOfAlt K m) : Nat.card K = m.factorial := by
  obtain ⟨-, hc, ⟨e⟩⟩ := h
  have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (center K)
  rw [Nat.card_congr e.toEquiv, hc] at h1
  have : Nontrivial (Fin m) := Fin.nontrivial_iff_two_le.2 hm
  rw [h1, Nat.card_eq_fintype_card, card_alternatingGroup, Fintype.card_fin]
  exact Nat.div_mul_cancel (Nat.dvd_factorial (by norm_num) hm)

