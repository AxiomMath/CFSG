  have haN : cen a ≤ N := hcenΔ a (hΛΔ haΛ) ha
  have hbN : cen b ≤ N := hcenΔ b (hΛΔ hbΛ) hb
  have habN : cen (a * b) ≤ N := hcenΔ _ (hΛΔ (Λ.mul_mem haΛ hbΛ)) hab2
  have hO : oddCoreOf (cen x) ≤ N := by
