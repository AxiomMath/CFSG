private theorem s2_quotConj_sq {F : Subgroup X} {t : X} (ht2 : t ^ 2 = 1)
    (htN : t ∈ normalizer (F : Set X)) (y : ↥F ⧸ pPrimeCore 2 ↥F) :
    quotConj htN (quotConj htN y) = y := by
