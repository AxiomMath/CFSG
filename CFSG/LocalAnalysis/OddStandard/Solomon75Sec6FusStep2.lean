      ((GH74.GLS.Stage1.Thm2.Recip.pLayerOf_le_innSub hJpc) (hΛE hy))
    obtain ⟨k, hk, hyk⟩ := hy'
    have h1 : y = (y * k⁻¹) * k := by group
    rw [h1, sup_comm]
    exact Subgroup.mul_mem_sup hyk hk
  by_cases hα : ∃ r ∈ Λ, orderOf r = 2 ∧ r ∈ QOf J
  ·
    obtain ⟨r, hrΛ, hr, hrQ⟩ := hα
    exact s2_le_of_mem_QOf hJpc (sq_eq_one_of_orderOf hr) hrQ (hcenΔ r (hΛΔ hrΛ) hr) hO
  · push Not at hα
    rcases hJ with hJA | hJM
    ·
      exfalso
      have hΛQ : Λ ⊓ QOf J ≤ oddCoreOf Λ := by
        refine le_oddCoreOf_of_normalized inf_le_left (fun l hl => mem_normalizer_inf
          (Subgroup.le_normalizer hl) (mem_normalizer_QOf (s2_sup_QOf_le_normalizer J
            (hΛJQ hl)))) ?_
        by_contra hev
        rw [Nat.not_odd_iff_even] at hev
        obtain ⟨r, hr⟩ := exists_prime_orderOf_dvd_card' (G := ↥(Λ ⊓ QOf J)) 2
          (even_iff_two_dvd.1 hev)
        exact hα r (r.2.1) (by rw [Subgroup.orderOf_coe]; exact hr) r.2.2
      have h1 := s2_card_quot_le hΛJQ hΛQ
      have h2 := relIndex_zStar_le J
      obtain ⟨-, -, ⟨eJ⟩⟩ := hJA.2
      haveI : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.2 hn2
      rw [Nat.card_congr eJ.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup,
        Fintype.card_fin] at h2
      rw [s2_card_of_dc hn2 hΛdc] at h1
      have hpos : 0 < n.factorial := Nat.factorial_pos n
      have h3 : n.factorial / 2 < n.factorial := Nat.div_lt_self hpos (by norm_num)
      omega
    ·
      exact s2_le_of_inner_two hgenM hgenL hJM.1.2.1 (hΛJQ haΛ) (hΛJQ hbΛ)
        (sq_eq_one_of_orderOf ha) (sq_eq_one_of_orderOf hb) (hα a haΛ ha) (hα b hbΛ hb)
        (hα _ (Λ.mul_mem haΛ hbΛ) hab2) hab haN hbN hOJ

