section CentralExt

variable {C X : Type*} [Group C] [Group X]

theorem commutatorElement_mul_center_left {c : C} (hc : c ∈ center C) (g h : C) :
    ⁅g * c, h⁆ = ⁅g, h⁆ := by
  have hch : h * c = c * h := mem_center_iff.1 hc h
  simp only [commutatorElement_def]
  calc g * c * h * (g * c)⁻¹ * h⁻¹ = g * (c * h) * c⁻¹ * g⁻¹ * h⁻¹ := by group
    _ = g * (h * c) * c⁻¹ * g⁻¹ * h⁻¹ := by rw [hch]
    _ = g * h * g⁻¹ * h⁻¹ := by group

theorem commutatorElement_mul_center_right {d : C} (hd : d ∈ center C) (g h : C) :
    ⁅g, h * d⁆ = ⁅g, h⁆ := by
  have hdg : g⁻¹ * d = d * g⁻¹ := mem_center_iff.1 hd g⁻¹
  simp only [commutatorElement_def]
  calc g * (h * d) * g⁻¹ * (h * d)⁻¹ = g * h * (d * g⁻¹) * d⁻¹ * h⁻¹ := by group
    _ = g * h * (g⁻¹ * d) * d⁻¹ * h⁻¹ := by rw [hdg]
    _ = g * h * g⁻¹ * h⁻¹ := by group

theorem commutatorElement_eq_of_ker_le_center (q : C →* X) (hk : q.ker ≤ center C)
    {a a' b b' : C} (ha : q a = q a') (hb : q b = q b') : ⁅a, b⁆ = ⁅a', b'⁆ := by
  have hc : a'⁻¹ * a ∈ q.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, ha, inv_mul_cancel]
  have hd : b'⁻¹ * b ∈ q.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hb, inv_mul_cancel]
  calc ⁅a, b⁆ = ⁅a' * (a'⁻¹ * a), b' * (b'⁻¹ * b)⁆ := by
        rw [mul_inv_cancel_left, mul_inv_cancel_left]
    _ = ⁅a', b'⁆ := by
      rw [commutatorElement_mul_center_left (hk hc), commutatorElement_mul_center_right (hk hd)]

theorem map_commutator_comap (q : C →* X) (hq : Function.Surjective q) {W : Subgroup X}
    (hW : ⁅W, W⁆ = W) : (⁅W.comap q, W.comap q⁆).map q = W := by
  rw [map_commutator, map_comap_eq_self_of_surjective hq, hW]

theorem commutator_commutator_comap (q : C →* X) (hq : Function.Surjective q)
    (hk : q.ker ≤ center C) {W : Subgroup X} (hW : ⁅W, W⁆ = W) :
    ⁅⁅W.comap q, W.comap q⁆, ⁅W.comap q, W.comap q⁆⁆ = ⁅W.comap q, W.comap q⁆ := by
  refine le_antisymm (Subgroup.commutator_le_self _) ?_
  have hmap := map_commutator_comap q hq hW
  rw [commutator_le]
  intro a ha b hb
  have ha' : q a ∈ (⁅W.comap q, W.comap q⁆).map q := by rw [hmap]; exact ha
  have hb' : q b ∈ (⁅W.comap q, W.comap q⁆).map q := by rw [hmap]; exact hb
  obtain ⟨a₀, ha₀, hqa⟩ := Subgroup.mem_map.1 ha'
  obtain ⟨b₀, hb₀, hqb⟩ := Subgroup.mem_map.1 hb'
  rw [commutatorElement_eq_of_ker_le_center q hk hqa.symm hqb.symm]
  exact commutator_mem_commutator ha₀ hb₀

theorem commutator_top_eq_top_and_center_eq_bot {W : Type*} [Group W] [Finite W]
    [IsSimpleGroup W] (hp : ¬ (Nat.card W).Prime) :
    ⁅(⊤ : Subgroup W), (⊤ : Subgroup W)⁆ = (⊤ : Subgroup W) ∧ center W = ⊥ := by
  have hcomm : ¬ ∀ a b : W, a * b = b * a := by
    intro hab
    let _ : CommGroup W := { (inferInstance : Group W) with mul_comm := hab }
    exact hp (IsSimpleGroup.prime_card (α := W))
  refine ⟨?_, ?_⟩
  · rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (⁅(⊤ : Subgroup W), (⊤ : Subgroup W)⁆) with
      h | h
    · exfalso
      refine hcomm fun a b => ?_
      have h1 : ⁅a, b⁆ ∈ ⁅(⊤ : Subgroup W), (⊤ : Subgroup W)⁆ :=
        commutator_mem_commutator (mem_top a) (mem_top b)
      rw [h, mem_bot] at h1
      exact commutatorElement_eq_one_iff_mul_comm.1 h1
    · exact h
  · rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (center W) with h | h
    · exact h
    · exfalso
      refine hcomm fun a b => ?_
      exact mem_center_iff.1 (h ▸ mem_top b) a

end CentralExt

section Std

variable {G : Type} [Group G] [Finite G] {L : Subgroup G} {n : ℕ}
  {ι : Perm (Fin 10) →* G} {ε : ℕ} {x : G}

theorem exists_stdHyp_of_twoSec_cent (h : Setting G L n) {x : G} (hx : orderOf x = 2)
    {W : Subgroup (TwoSec x)} [hWN : W.Normal] (hCW : centralizer (W : Set (TwoSec x)) = ⊥)
    (hWs : IsSimpleGroup W) (hWp : ¬ (Nat.card W).Prime) :
    ∃ K : Subgroup G, CFSG.EvenSporadicStandard.StdHyp G K ∧ Nonempty (K ⧸ center K ≃* W) ∧
      K ≤ centralizer ({x} : Set G) ∧
      centralizer (K : Set G) ⊓ centralizer ({x} : Set G) = zpowers x := by
  classical
  have hx2 : x * x = 1 := by rw [← pow_two, ← hx, pow_orderOf_eq_one]
  set C := centralizer ({x} : Set G) with hC
  set q : C →* TwoSec x := QuotientGroup.mk' (zpowers (selfC x)) with hq
  have hqs : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hker : q.ker ≤ center C := by
    rw [hq, QuotientGroup.ker_mk']
    exact zpowers_le.2 (selfC_mem_center x)
  have hkerx : ∀ c : C, q c = 1 → (c : G) = 1 ∨ (c : G) = x := by
    intro c hc
    have : c ∈ zpowers (selfC x) := by
      rw [← QuotientGroup.ker_mk' (zpowers (selfC x))]
      exact hc
    exact (mem_zpowers_selfC_iff hx2).1 this
  obtain ⟨hWperf, hWZ⟩ := commutator_top_eq_top_and_center_eq_bot (W := W) hWp
  have hWW : ⁅W, W⁆ = W := by
    rw [← W.map_subtype_commutator, _root_.commutator_def, hWperf, ← MonoidHom.range_eq_map,
      W.range_subtype]
  set K₀ : Subgroup C := ⁅W.comap q, W.comap q⁆ with hK₀
  have hK₀map : K₀.map q = W := map_commutator_comap q hqs hWW
  have hK₀perf : ⁅K₀, K₀⁆ = K₀ := commutator_commutator_comap q hqs hker hWW
  have : (W.comap q).Normal := hWN.comap q
  have hK₀N : K₀.Normal := Subgroup.commutator_normal _ _
  set K : Subgroup G := K₀.map C.subtype with hK
  have hKC : K ≤ C := map_subtype_le K₀
  have hKsub : K.subgroupOf C = K₀ := comap_map_eq_self_of_injective C.subtype_injective K₀
  have hKperf : ⁅K, K⁆ = K := by rw [hK, ← map_commutator, hK₀perf]
  set ψ₀ : K →* TwoSec x := q.comp (Subgroup.inclusion hKC) with hψ₀
  have hψ₀ : ∀ k : K, ψ₀ k = q ⟨k, hKC k.2⟩ := fun _ => rfl
  have hψ₀mem : ∀ k : K, ψ₀ k ∈ W := by
    intro k
    rw [← hK₀map, hψ₀]
    refine ⟨⟨k, hKC k.2⟩, ?_, rfl⟩
    rw [← hKsub]
    exact k.2
  set ψ : K →* W := ψ₀.codRestrict W hψ₀mem with hψ
  have hψs : Function.Surjective ψ := by
    rintro ⟨w, hw⟩
    rw [← hK₀map] at hw
    obtain ⟨k₀, hk₀, hqk⟩ := Subgroup.mem_map.1 hw
    refine ⟨⟨(k₀ : G), mem_map_of_mem C.subtype hk₀⟩, Subtype.ext ?_⟩
    show ψ₀ _ = w
    rw [hψ₀, ← hqk]
  have hkerψ : ψ.ker = center K := by
    apply le_antisymm
    · intro k hk
      rw [MonoidHom.mem_ker] at hk
      have hk1 : q ⟨k, hKC k.2⟩ = 1 := congrArg Subtype.val hk
      rw [mem_center_iff]
      intro k'
      apply Subtype.ext
      rcases hkerx _ hk1 with h1 | h1
      · show (k' : G) * k = k * k'
        rw [show (k : G) = 1 from h1, mul_one, one_mul]
      · show (k' : G) * k = k * k'
        rw [show (k : G) = x from h1]
        exact mem_centralizer_singleton_iff.1 (hKC k'.2)
    · intro k hk
      have h1 : ψ k ∈ center W := map_center_le_center hψs (mem_map_of_mem ψ hk)
      rw [hWZ, mem_bot] at h1
      exact h1
  have e : K ⧸ center K ≃* W :=
    (QuotientGroup.quotientMulEquivOfEq hkerψ.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective ψ hψs)
  have hKq : CFSG.Open.IsQuasisimple K := by
    refine ⟨?_, e.isSimpleGroup⟩
    apply Subgroup.map_injective K.subtype_injective
    rw [K.map_subtype_commutator, hKperf, ← MonoidHom.range_eq_map, K.range_subtype]
  have hKn : (K.subgroupOf C).Normal := by rw [hKsub]; exact hK₀N
  have hcent : centralizer ({x} : Set G) ⊓ centralizer (K : Set G) ≤ zpowers x := by
    intro u hu
    obtain ⟨huC, huK⟩ := mem_inf.1 hu
    have hq1 : q ⟨u, huC⟩ ∈ centralizer (W : Set (TwoSec x)) := by
      rw [mem_centralizer_iff]
      intro w hw
      have hw' : w ∈ K₀.map q := by rw [hK₀map]; exact hw
      obtain ⟨k₀, hk₀, rfl⟩ := Subgroup.mem_map.1 hw'
      rw [← map_mul, ← map_mul]
      congr 1
      apply Subtype.ext
      show (k₀ : G) * u = u * k₀
      exact mem_centralizer_iff.1 huK (k₀ : G) (mem_map_of_mem C.subtype hk₀)
    rw [hCW, mem_bot] at hq1
    rcases hkerx _ hq1 with h1 | h1
    · rw [show u = 1 from h1]; exact one_mem _
    · rw [show u = x from h1]; exact mem_zpowers x
  have hxK : x ∈ centralizer (K : Set G) :=
    mem_centralizer_iff.2 fun k hk => mem_centralizer_singleton_iff.1 (hKC hk)
  have hsyl : ∀ U : Subgroup G, IsPGroup 2 U →
      U ≤ centralizer ({x} : Set G) ⊓ centralizer (K : Set G) → Nat.card U ≤ 2 := by
    intro U _ hU
    calc Nat.card U ≤ Nat.card (zpowers x) := Subgroup.card_le_of_le (hU.trans hcent)
      _ = 2 := by rw [Nat.card_zpowers, hx]
  obtain ⟨hstd, hcyc⟩ :=
    CFSG.EvenSporadicStandard.M24Std.standardComponentIsStandard_of_normal hx hKq hKC hKn hsyl
  refine ⟨K, ⟨h.std.simple, h.std.nonab, h.std.kProper, hstd, fun t ht => h.bal t ht, hcyc, ?_⟩,
    ⟨e⟩, hKC, ?_⟩
  swap
  · refine le_antisymm (inf_comm (centralizer (K : Set G)) _ ▸ hcent) ?_
    exact zpowers_le.2 ⟨hxK, mem_centralizer_singleton_iff.2 rfl⟩
  intro g
  refine ⟨1, ?_⟩
  have hg : (g : K) ∈ ψ.ker := by rw [hkerψ]; exact g.2
  rw [MonoidHom.mem_ker] at hg
  have hg1 : q ⟨((g : K) : G), hKC (g : K).2⟩ = 1 := congrArg Subtype.val hg
  apply Subtype.ext
  apply Subtype.ext
  show (((g : K) : G)) ^ 2 ^ 1 = 1
  rcases hkerx _ hg1 with h1 | h1
  · rw [show ((g : K) : G) = 1 from h1, one_pow]
  · rw [show ((g : K) : G) = x from h1, pow_one, pow_two, hx2]

theorem exists_stdHyp_of_twoSec (h : Setting G L n) {x : G} (hx : orderOf x = 2)
    {W : Subgroup (TwoSec x)} [W.Normal] (hCW : centralizer (W : Set (TwoSec x)) = ⊥)
    (hWs : IsSimpleGroup W) (hWp : ¬ (Nat.card W).Prime) :
    ∃ K : Subgroup G, CFSG.EvenSporadicStandard.StdHyp G K ∧ Nonempty (K ⧸ center K ≃* W) := by
  obtain ⟨K, hK, he, -, -⟩ := exists_stdHyp_of_twoSec_cent h hx hCW hWs hWp
  exact ⟨K, hK, he⟩

theorem exists_stdHyp_of_hsOutcome (h : Setting G L n) {x : G}
    (hx : orderOf x = 2) {t : TwoSec x} (hHS : HSOutcome t) :
    ∃ K : Subgroup G, CFSG.EvenSporadicStandard.StdHyp G K ∧ IsSporadic (K ⧸ center K) .HS := by
  obtain ⟨W, hWN, hCW, -, ⟨φ⟩⟩ := hHS
  have hWs : IsSimpleGroup W :=
    @MulEquiv.isSimpleGroup W _ NativeSporadic.HS _ CFSG.Sporadic.HS.isSimpleGroup_HS φ
  have hW : Nat.card W = 44352000 := (Nat.card_congr φ.toEquiv).trans CFSG.Sporadic.HS.card_HS
  have hWp : ¬ (Nat.card W).Prime := by
    rw [hW]
    intro hp
    have := hp.eq_one_or_self_of_dvd 2 (by norm_num)
    omega
  obtain ⟨K, hK, ⟨e⟩⟩ := exists_stdHyp_of_twoSec h hx hCW hWs hWp
  let eC : NativeSporadic.HS ≃* Carrier .HS := MulEquiv.refl _
  exact ⟨K, hK, ⟨(e.trans φ).trans eC⟩⟩

