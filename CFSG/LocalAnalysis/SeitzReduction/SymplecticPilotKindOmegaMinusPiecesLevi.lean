section Plane

variable (r) in
@[expose] def kOmMPlaneEmb : Fin 2 → Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2 :=
  fun j => Sum.inr (Sum.inr j)

theorem kOmMPlaneEmb_injective : Function.Injective (kOmMPlaneEmb r) :=
  fun _ _ h => Sum.inr_injective (Sum.inr_injective h)

theorem kOmM_mem_range_emb_of_not_mem_plane {a : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2}
    (ha : a ∉ Set.range (kOmMPlaneEmb r)) : a ∈ Set.range (kOmMEmb r) := by
  rcases a with i | i | j
  · exact ⟨Sum.inl i, rfl⟩
  · exact ⟨Sum.inr i, rfl⟩
  · exact absurd ⟨j, rfl⟩ ha

variable (r) in
@[expose] def kOmMPlaneVec (w : Fin 2 → K) : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2 → K :=
  Sum.elim 0 (Sum.elim 0 w)

theorem kOmM_statedQuadMinus_planeVec (b c : K) (w : Fin 2 → K) :
    StatedQuadMinus (r + 1) K b c (kOmMPlaneVec r w) = anisoNorm b c w := by
  simp [StatedQuadMinus, kOmMPlaneVec, anisoNorm]

theorem kOmM_mulVec_planeVec {X : Matrix (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2)
      (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K}
    (hcol : ∀ a j, a ∉ Set.range (kOmMPlaneEmb r) → X a (kOmMPlaneEmb r j) = 0)
    (w : Fin 2 → K) :
    X *ᵥ kOmMPlaneVec r w =
      kOmMPlaneVec r (X.submatrix (kOmMPlaneEmb r) (kOmMPlaneEmb r) *ᵥ w) := by
  funext a
  simp only [mulVec, dotProduct]
  rw [F4Pilot.sum_eq_sum_comp_of_vanish kOmMPlaneEmb_injective _ (fun c hc => by
    rcases c with i | i | j
    · simp [kOmMPlaneVec]
    · simp [kOmMPlaneVec]
    · exact absurd ⟨j, rfl⟩ hc)]
  rcases a with i | i | j
  · simp only [kOmMPlaneVec, Sum.elim_inl, Pi.zero_apply]
    exact Finset.sum_eq_zero fun j _ => by
      rw [hcol _ j (by rintro ⟨l, hl⟩; exact Sum.inr_ne_inl hl), zero_mul]
  · simp only [kOmMPlaneVec, Sum.elim_inr, Sum.elim_inl, Pi.zero_apply]
    exact Finset.sum_eq_zero fun j _ => by
      rw [hcol _ j (by rintro ⟨l, hl⟩; exact Sum.inr_ne_inl (Sum.inr_injective hl)), zero_mul]
  · simp only [kOmMPlaneVec, Sum.elim_inr, mulVec, dotProduct, submatrix_apply]
    rfl

end Plane

section Centralizer

theorem kOmM_mat_eq_zero_of_mem_centralizer {Ts : Set (Fin r → Kˣ)}
    {x : GL (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K}
    (hx : x ∈ centralizer (kOmMDiag K r '' Ts)) {t : Fin r → Kˣ} (ht : t ∈ Ts)
    {a a' : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2}
    (h : kOmMWeight K r t a ≠ kOmMWeight K r t a') :
    (x : Matrix (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2)
      (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K) a a' = 0 :=
  (commute_of_diag_iff (fun a b hab => kOmMDiag_apply_ne t hab) x).1
    ((mem_centralizer_iff.1 hx) _ ⟨t, ht, rfl⟩).symm a a'
    (by rwa [kOmMDiag_apply_self, kOmMDiag_apply_self])

theorem kOmMWeight_const_ne_plane {κ : Kˣ} (hκ : κ * κ ≠ 1)
    {a : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2} (ha : a ∉ Set.range (kOmMPlaneEmb r))
    (j : Fin 2) :
    kOmMWeight K r (fun _ => κ) (kOmMPlaneEmb r j) ≠ kOmMWeight K r (fun _ => κ) a := by
  have hκ1 : κ ≠ 1 := units_ne_one_of_mul_self_ne_one hκ
  rcases a with i | i | j'
  · change (1 : K) ≠ ((κ : Kˣ) : K)
    exact fun h => hκ1 (Units.ext h.symm)
  · change (1 : K) ≠ ((κ⁻¹ : Kˣ) : K)
    exact fun h => hκ1 (inv_eq_one.1 (Units.ext h.symm))
  · exact absurd ⟨j', rfl⟩ ha

end Centralizer

section Tail

variable [Finite K] [CharP K 2]

theorem kOmM_perfectCore_le_suppGL_hyp {b c : K} (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    {κ : Kˣ} (hκ : κ * κ ≠ 1) {Ts : Set (Fin r → Kˣ)} (hTs : (fun _ => κ) ∈ Ts) :
    perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
      centralizer (kOmMDiag K r '' Ts)) ≤ suppGL K (Set.range (kOmMEmb r)) := by
  set B := StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓ centralizer (kOmMDiag K r '' Ts)
    with hBdef
  have hBC : ∀ x ∈ B, x ∈ centralizer (kOmMDiag K r '' Ts) := fun x hx => (mem_inf.1 hx).2
  have hsep : ∀ x ∈ B, ∀ (j : Fin 2) (a : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2),
      a ∉ Set.range (kOmMPlaneEmb r) →
      (x : Matrix (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2)
        (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K) (kOmMPlaneEmb r j) a = 0 ∧
      (x : Matrix (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2)
        (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K) a (kOmMPlaneEmb r j) = 0 :=
    fun x hx j a ha => ⟨kOmM_mat_eq_zero_of_mem_centralizer (hBC x hx) hTs
      (kOmMWeight_const_ne_plane hκ ha j),
      kOmM_mat_eq_zero_of_mem_centralizer (hBC x hx) hTs
        (kOmMWeight_const_ne_plane hκ ha j).symm⟩
  set φ := F4Pilot.blockHom B kOmMPlaneEmb_injective
    (fun x hx i c hc => (hsep x hx i c hc).1) with hφ
  have htype : ∀ x : B, ∃ n, AnisoType b c n ((φ x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) := by
    intro x
    have hiso : ∀ w, anisoNorm b c (((φ x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) *ᵥ w) =
        anisoNorm b c w := by
      intro w
      rw [hφ, F4Pilot.coe_blockHom, ← kOmM_statedQuadMinus_planeVec (r := r),
        ← kOmM_statedQuadMinus_planeVec (r := r),
        ← kOmM_mulVec_planeVec (fun a j ha => (hsep x x.2 j a ha).2)]
      exact kOmM_isometry_of_mem (mem_inf.1 x.2).1 _
    rcases F4Pilot.isAnisoRot_or_isAnisoRef hirr hiso with h | h
    · exact ⟨0, Or.inl ⟨rfl, h⟩⟩
    · exact ⟨1, Or.inr ⟨rfl, h⟩⟩
  set D := (anisoRotGL b c).comap φ with hD
  have h2 : ⁅B, B⁆ ≤ D.map B.subtype := by
    rw [Subgroup.commutator_le]
    intro g hg h hh
    refine ⟨⁅(⟨g, hg⟩ : B), ⟨h, hh⟩⁆, ?_, rfl⟩
    change φ ⁅(⟨g, hg⟩ : B), ⟨h, hh⟩⁆ ∈ anisoRotGL b c
    rw [map_commutatorElement, F4Pilot.mem_anisoRotGL, commutatorElement_def, Units.val_mul,
      Units.val_mul, Units.val_mul]
    obtain ⟨m, hm⟩ := htype ⟨g, hg⟩
    obtain ⟨m', hm'⟩ := htype (⟨g, hg⟩ : B)⁻¹
    obtain ⟨n, hn⟩ := htype ⟨h, hh⟩
    obtain ⟨n', hn'⟩ := htype (⟨h, hh⟩ : B)⁻¹
    rw [map_inv] at hm' hn'
    exact F4Pilot.isAnisoRot_mul_mul_mul (F4Pilot.ne_zero_of_irr hirr) hm hm' hn hn'
      (by rw [← Units.val_mul, mul_inv_cancel, Units.val_one])
      (by rw [← Units.val_mul, mul_inv_cancel, Units.val_one])
  have hDker : ⁅D, D⁆ ≤ φ.ker := by
    have hle : (⁅D, D⁆).map φ ≤ ⊥ := by
      rw [Subgroup.map_commutator, ← F4Pilot.commutator_anisoRotGL (b := b) (c := c)]
      exact Subgroup.commutator_mono (Subgroup.map_comap_le _ _) (Subgroup.map_comap_le _ _)
    intro x hx
    exact (Subgroup.mem_bot.1 (hle ⟨x, hx, rfl⟩))
  have h3 : ⁅⁅B, B⁆, ⁅B, B⁆⁆ ≤ φ.ker.map B.subtype :=
    calc ⁅⁅B, B⁆, ⁅B, B⁆⁆ ≤ ⁅D.map B.subtype, D.map B.subtype⁆ := Subgroup.commutator_mono h2 h2
      _ = (⁅D, D⁆).map B.subtype := (Subgroup.map_commutator _ _ _).symm
      _ ≤ φ.ker.map B.subtype := Subgroup.map_mono hDker
  have h4 : φ.ker.map B.subtype ≤ suppGL K (Set.range (kOmMEmb r)) := by
    rintro _ ⟨y, hyker, rfl⟩
    have hy1 : ((y : GL (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K) :
        Matrix (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2)
          (Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) K).submatrix (kOmMPlaneEmb r)
            (kOmMPlaneEmb r) = 1 := by
      have := congrArg Units.val (MonoidHom.mem_ker.1 hyker)
      rwa [hφ, F4Pilot.coe_blockHom, Units.val_one] at this
    intro a a' haa
    by_cases ha : a ∈ Set.range (kOmMPlaneEmb r)
    · obtain ⟨i, rfl⟩ := ha
      by_cases ha' : a' ∈ Set.range (kOmMPlaneEmb r)
      · obtain ⟨j, rfl⟩ := ha'
        have h := congrFun (congrFun hy1 i) j
        rw [submatrix_apply] at h
        rw [B.coe_subtype, h, Matrix.one_apply, Matrix.one_apply]
        exact if_congr kOmMPlaneEmb_injective.eq_iff.symm rfl rfl
      · rw [B.coe_subtype, (hsep _ y.2 i a' ha').1,
          Matrix.one_apply_ne (fun h => ha' ⟨i, h⟩)]
    · by_cases ha' : a' ∈ Set.range (kOmMPlaneEmb r)
      · obtain ⟨j, rfl⟩ := ha'
        rw [B.coe_subtype, (hsep _ y.2 j a ha).2, Matrix.one_apply_ne (fun h => ha ⟨j, h.symm⟩)]
      · exact absurd ⟨kOmM_mem_range_emb_of_not_mem_plane ha,
          kOmM_mem_range_emb_of_not_mem_plane ha'⟩ haa
  have hpc : perfectCore B ≤ ⁅B, B⁆ :=
    calc perfectCore B = ⁅perfectCore B, perfectCore B⁆ := (perfectCore_perfect B).symm
      _ ≤ ⁅B, B⁆ := Subgroup.commutator_mono (perfectCore_le B) (perfectCore_le B)
  calc perfectCore B = ⁅perfectCore B, perfectCore B⁆ := (perfectCore_perfect B).symm
    _ ≤ ⁅⁅B, B⁆, ⁅B, B⁆⁆ := Subgroup.commutator_mono hpc hpc
    _ ≤ φ.ker.map B.subtype := h3
    _ ≤ suppGL K (Set.range (kOmMEmb r)) := h4

theorem kOmM_perfectCore_eq_inf_suppGL_hyp {b c : K} (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    {κ : Kˣ} (hκ : κ * κ ≠ 1) {Ts : Set (Fin r → Kˣ)} (hTs : (fun _ => κ) ∈ Ts) :
    perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
      centralizer (kOmMDiag K r '' Ts)) =
      perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
        centralizer (kOmMDiag K r '' Ts) ⊓ suppGL K (Set.range (kOmMEmb r))) :=
  le_antisymm (le_perfectCore_of_perfect
      (le_inf (perfectCore_le _) (kOmM_perfectCore_le_suppGL_hyp hirr hκ hTs))
      (perfectCore_perfect _))
    (perfectCore_mono inf_le_left)

end Tail

section Hyp

variable (r) in
theorem kOmM_isCoordSplit_hyp (b c : K) :
    IsCoordSplit (StatedQuadMinus (r + 1) K b c) (StatedQuadPlus r K) (kOmMEmb r) := by
  refine ⟨fun v => v (Sum.inr (Sum.inr 0)) ^ 2 + b * v (Sum.inr (Sum.inr 0)) *
      v (Sum.inr (Sum.inr 1)) + c * v (Sum.inr (Sum.inr 1)) ^ 2, fun v => ?_, fun v w h => ?_⟩
  · have hsum : ∑ i : Fin (r + 1 - 1), v (Sum.inl i) * v (Sum.inr (Sum.inl i)) =
        ∑ i : Fin r, v (Sum.inl i) * v (Sum.inr (Sum.inl i)) := rfl
    simp only [StatedQuadMinus, StatedQuadPlus, Function.comp_apply, kOmMEmb_inl, kOmMEmb_inr]
    rw [hsum]
    ring
  · have hp : ∀ j : Fin 2, (Sum.inr (Sum.inr j) : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) ∉
        Set.range (kOmMEmb r) := fun j ⟨y, hy⟩ => kOmMEmb_ne_tail y j hy
    simp only [h _ (hp 0), h _ (hp 1)]

theorem kOmM_coordEmbedGL_diagOmega (t : Fin r → Kˣ) :
    coordEmbedGL (kOmMEmb r) kOmMEmb_injective (OmegaPilot.diagOmega K r t) = kOmMDiag K r t := by
  apply Units.ext
  rw [F4Pilot.coe_coordEmbedGL, kOmMDiag_coe]
  ext a a'
  by_cases h : a ∈ Set.range (kOmMEmb r) ∧ a' ∈ Set.range (kOmMEmb r)
  · obtain ⟨⟨x, rfl⟩, ⟨y, rfl⟩⟩ := h
    rw [F4Pilot.coordEmbedMat_apply_image kOmMEmb_injective, OmegaPilot.diagOmega_coe]
    by_cases hxy : x = y
    · subst hxy
      rw [diagonal_apply_eq, diagonal_apply_eq]
      rcases x with i | i <;> rfl
    · rw [diagonal_apply_ne _ hxy, diagonal_apply_ne _ (kOmMEmb_injective.ne hxy)]
  · rw [F4Pilot.coordEmbedMat_apply_of_not_mem _ h, diagonal_apply, Matrix.one_apply]
    split_ifs with haa
    · subst haa
      have ha : a ∉ Set.range (kOmMEmb r) := fun ha => h ⟨ha, ha⟩
      rcases a with i | i | j
      · exact absurd ⟨Sum.inl i, rfl⟩ ha
      · exact absurd ⟨Sum.inr i, rfl⟩ ha
      · rfl
    · rfl

theorem kOmM_coordEmbedGL_mem_centralizer_iff {Ts : Set (Fin r → Kˣ)} (y : GL (Fin r ⊕ Fin r) K) :
    coordEmbedGL (kOmMEmb r) kOmMEmb_injective y ∈ centralizer (kOmMDiag K r '' Ts) ↔
      y ∈ centralizer (OmegaPilot.diagOmega K r '' Ts) := by
  simp only [mem_centralizer_iff, Set.forall_mem_image]
  refine forall₂_congr fun t _ => ?_
  rw [← kOmM_coordEmbedGL_diagOmega, ← map_mul, ← map_mul]
  exact (F4Pilot.coordEmbedGL_injective kOmMEmb_injective).eq_iff

theorem kOmM_coordEmbedGL_mem_suppGL_image {ι ι' : Type} [Fintype ι] [DecidableEq ι]
    [Fintype ι'] [DecidableEq ι'] {e : ι' → ι} (he : Function.Injective e) {T : Set ι'}
    {y : GL ι' K} (hy : y ∈ suppGL K T) : coordEmbedGL e he y ∈ suppGL K (e '' T) := by
  intro a a' haa
  rw [F4Pilot.coe_coordEmbedGL]
  by_cases h : a ∈ Set.range e ∧ a' ∈ Set.range e
  · obtain ⟨⟨x, rfl⟩, ⟨x', rfl⟩⟩ := h
    rw [F4Pilot.coordEmbedMat_apply_image he,
      hy x x' (fun hx => haa ⟨⟨x, hx.1, rfl⟩, ⟨x', hx.2, rfl⟩⟩), Matrix.one_apply,
      Matrix.one_apply]
    exact if_congr he.eq_iff.symm rfl rfl
  · rw [F4Pilot.coordEmbedMat_apply_of_not_mem _ h]

end Hyp

section Short

variable [Finite K] [CharP K 2]

theorem kOmM_perfectCore_short (hK : 4 ≤ Nat.card K) {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {i j : Fin r} (hij : i ≠ j)
    {Ts : Set (Fin r → Kˣ)} (hTs : ∀ t, t ∈ Ts ↔ t i = t j) :
    perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
      centralizer (kOmMDiag K r '' Ts)) =
      (OmegaPilot.siegelBlockGL K {i, j}).map (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) := by
  obtain ⟨κ, hκ⟩ := exists_units_mul_self_ne_one_of_four_le hK
  have hTsκ : (fun _ => κ) ∈ Ts := (hTs _).2 rfl
  have hsplit := kOmM_isCoordSplit_hyp r (K := K) b c
  have hJc : ({i, j} : Finset (Fin r)).card = 2 := Finset.card_pair hij
  have hTseq : Ts = (OmegaPilot.levelParam (K := K) ({i, j} : Finset (Fin r)) : Set _) := by
    ext s
    rw [hTs, SetLike.mem_coe, OmegaPilot.mem_levelParam]
    constructor
    · intro h i' hi' j' hj'
      simp only [Finset.mem_insert, Finset.mem_singleton] at hi' hj'
      rcases hi' with rfl | rfl <;> rcases hj' with rfl | rfl
      · rfl
      · exact h
      · exact h.symm
      · rfl
    · intro h
      exact h _ (by simp) _ (by simp)
  have hconst : ∀ s ∈ Ts, ∀ i' ∈ ({i, j} : Finset (Fin r)), ∀ j' ∈ ({i, j} : Finset (Fin r)),
      s i' = s j' := fun s hs => by
    rw [hTseq] at hs
    exact OmegaPilot.mem_levelParam.1 hs
  have hLevi : perfectCore (StatedOmega (StatedQuadPlus r K) ⊓
      centralizer (OmegaPilot.diagOmega K r '' Ts)) = OmegaPilot.siegelBlockGL K {i, j} := by
    rw [OmegaPilot.perfectCore_statedOmega_inf_centralizer_eq_level hK (J := {i, j})
        (by rw [hJc]) Ts hconst (fun a a' haa hJ => by
          obtain ⟨t, ht, hne⟩ := OmegaPilot.exists_mem_levelParam_diagSpEntry_ne hκ haa hJ
          exact ⟨t, by rw [hTseq]; exact ht, hne⟩),
      OmegaPilot.siegelBlockGL_eq_map_omegaLeviSL hK (by rw [hJc])]
  rw [kOmM_perfectCore_eq_inf_suppGL_hyp hirr hκ hTsκ]
  apply le_antisymm
  · have hX : StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓ centralizer (kOmMDiag K r '' Ts) ⊓
        suppGL K (Set.range (kOmMEmb r)) ≤
        (isoClosure (StatedQuadPlus r K) ⊓ centralizer (OmegaPilot.diagOmega K r '' Ts)).map
          (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) := by
      rintro x ⟨⟨hxO, hxC⟩, hxS⟩
      obtain ⟨y, hy, rfl⟩ :=
        hsplit.statedOmega_inf_suppGL_le_map kOmMEmb_injective (mem_inf.2 ⟨hxO, hxS⟩)
      exact ⟨y, mem_inf.2 ⟨hy, (kOmM_coordEmbedGL_mem_centralizer_iff y).1 hxC⟩, rfl⟩
    calc _ ≤ perfectCore ((isoClosure (StatedQuadPlus r K) ⊓
          centralizer (OmegaPilot.diagOmega K r '' Ts)).map
            (coordEmbedGL (kOmMEmb r) kOmMEmb_injective)) := perfectCore_mono hX
      _ = (perfectCore (isoClosure (StatedQuadPlus r K) ⊓
          centralizer (OmegaPilot.diagOmega K r '' Ts))).map
            (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) :=
          (CFSG.Quasithin.map_perfectCore _ _).symm
      _ ≤ _ := by
          refine map_mono ?_
          rw [← hLevi]
          refine le_perfectCore_of_perfect ?_ (perfectCore_perfect _)
          calc perfectCore (isoClosure (StatedQuadPlus r K) ⊓
                centralizer (OmegaPilot.diagOmega K r '' Ts)) =
                ⁅perfectCore (isoClosure (StatedQuadPlus r K) ⊓
                  centralizer (OmegaPilot.diagOmega K r '' Ts)),
                perfectCore (isoClosure (StatedQuadPlus r K) ⊓
                  centralizer (OmegaPilot.diagOmega K r '' Ts))⁆ := (perfectCore_perfect _).symm
            _ ≤ ⁅isoClosure (StatedQuadPlus r K) ⊓ centralizer (OmegaPilot.diagOmega K r '' Ts),
                isoClosure (StatedQuadPlus r K) ⊓
                  centralizer (OmegaPilot.diagOmega K r '' Ts)⁆ :=
                Subgroup.commutator_mono (perfectCore_le _) (perfectCore_le _)
            _ ≤ StatedOmega (StatedQuadPlus r K) ⊓
                centralizer (OmegaPilot.diagOmega K r '' Ts) :=
                le_inf (Subgroup.commutator_mono inf_le_left inf_le_left)
                  ((Subgroup.commutator_le_self _).trans inf_le_right)
  · refine le_perfectCore_of_perfect ?_
      (by rw [← Subgroup.map_commutator, OmegaPilot.commutator_siegelBlockGL hK (by rw [hJc])])
    rintro _ ⟨y, hy, rfl⟩
    have hyO : y ∈ StatedOmega (StatedQuadPlus r K) :=
      OmegaPilot.siegelBlockGL_le_statedOmega hK (by rw [hJc]) hy
    have hyC : y ∈ centralizer (OmegaPilot.diagOmega K r '' Ts) :=
      OmegaPilot.siegelBlockGL_le_centralizer hconst hy
    exact mem_inf.2 ⟨mem_inf.2 ⟨hsplit.map_statedOmega_le kOmMEmb_injective ⟨y, hyO, rfl⟩,
      (kOmM_coordEmbedGL_mem_centralizer_iff y).2 hyC⟩,
      F4Pilot.coordEmbedGL_mem_suppGL kOmMEmb_injective y⟩

omit [Finite K] [CharP K 2] in
theorem kOmM_short_le_suppGL (i j : Fin r) :
    (OmegaPilot.siegelBlockGL K {i, j}).map (coordEmbedGL (kOmMEmb r) kOmMEmb_injective) ≤
      suppGL K (kOmMEmb r '' planeCoords {i, j}) := by
  rintro _ ⟨y, hy, rfl⟩
  exact kOmM_coordEmbedGL_mem_suppGL_image kOmMEmb_injective
    (OmegaPilot.siegelBlockGL_le_suppGL _ hy)

omit [Finite K] [CharP K 2] in
theorem kOmM_card_short {i j : Fin r} (hij : i ≠ j) :
    Nat.card ((OmegaPilot.siegelBlockGL K {i, j}).map
      (coordEmbedGL (kOmMEmb r) kOmMEmb_injective)) =
      Nat.card (Matrix.SpecialLinearGroup (Fin 2) K) := by
  rw [Subgroup.card_map_of_injective (F4Pilot.coordEmbedGL_injective kOmMEmb_injective),
    OmegaPilot.natCard_siegelBlockGL, Finset.card_pair hij]

end Short

section Long

variable (r) in
@[expose] def kOmMLongEmb (l : Fin r) :
    Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2 :=
  Sum.map (fun _ => l) (Sum.map (fun _ => l) id)

theorem kOmMLongEmb_injective (l : Fin r) : Function.Injective (kOmMLongEmb r l) :=
  Sum.map_injective.2 ⟨fun x y _ => Subsingleton.elim (α := Fin 1) x y, Sum.map_injective.2
    ⟨fun x y _ => Subsingleton.elim (α := Fin 1) x y, Function.injective_id⟩⟩

theorem kOmM_exists_of_not_mem_range_longEmb {l : Fin r}
    {a : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2} (ha : a ∉ Set.range (kOmMLongEmb r l)) :
    ∃ l' : Fin r, l' ≠ l ∧ (a = Sum.inl l' ∨ a = Sum.inr (Sum.inl l')) := by
  rcases a with i | i | j
  · refine ⟨i, fun hi => ha ⟨Sum.inl 0, ?_⟩, Or.inl rfl⟩
    rw [hi]
    rfl
  · refine ⟨i, fun hi => ha ⟨Sum.inr (Sum.inl 0), ?_⟩, Or.inr rfl⟩
    rw [hi]
    rfl
  · exact absurd ⟨Sum.inr (Sum.inr j), rfl⟩ ha

theorem kOmM_mem_range_longEmb_iff {l : Fin r} {a : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2} :
    a ∈ Set.range (kOmMLongEmb r l) ↔
      a = Sum.inl l ∨ a = Sum.inr (Sum.inl l) ∨ ∃ j, a = Sum.inr (Sum.inr j) := by
  constructor
  · rintro ⟨x | x | x, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr ⟨x, rfl⟩)
  · rintro (rfl | rfl | ⟨j, rfl⟩)
    · exact ⟨Sum.inl 0, rfl⟩
    · exact ⟨Sum.inr (Sum.inl 0), rfl⟩
    · exact ⟨Sum.inr (Sum.inr j), rfl⟩

theorem kOmM_isCoordSplit_long (b c : K) (l : Fin r) :
    IsCoordSplit (StatedQuadMinus (r + 1) K b c) (StatedQuadMinus 2 K b c) (kOmMLongEmb r l) := by
  refine ⟨fun v => ∑ i : Fin r, if i = l then 0 else v (Sum.inl i) * v (Sum.inr (Sum.inl i)),
    fun v => ?_, fun v w h => ?_⟩
  · have hsum : ∑ i : Fin (r + 1 - 1), v (Sum.inl i) * v (Sum.inr (Sum.inl i)) =
        ∑ i : Fin r, ((if i = l then v (Sum.inl i) * v (Sum.inr (Sum.inl i)) else 0) +
          if i = l then 0 else v (Sum.inl i) * v (Sum.inr (Sum.inl i))) :=
      Finset.sum_congr rfl fun i _ => by split_ifs <;> simp
    simp only [StatedQuadMinus, Function.comp_apply]
    rw [hsum, Finset.sum_add_distrib, Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ l),
      Fin.sum_univ_one]
    simp only [kOmMLongEmb, Sum.map_inl, Sum.map_inr, id]
    ring
  · refine Finset.sum_congr rfl fun i _ => ?_
    split_ifs with hil
    · rfl
    · have h1 : (Sum.inl i : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) ∉
          Set.range (kOmMLongEmb r l) := fun hm => by
        rcases kOmM_mem_range_longEmb_iff.1 hm with h' | h' | ⟨j, h'⟩
        · exact hil (Sum.inl_injective h')
        · exact Sum.inl_ne_inr h'
        · exact Sum.inl_ne_inr h'
      have h2 : (Sum.inr (Sum.inl i) : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2) ∉
          Set.range (kOmMLongEmb r l) := fun hm => by
        rcases kOmM_mem_range_longEmb_iff.1 hm with h' | h' | ⟨j, h'⟩
        · exact Sum.inr_ne_inl h'
        · exact hil (Sum.inl_injective (Sum.inr_injective h'))
        · exact Sum.inl_ne_inr (Sum.inr_injective h')
      rw [h _ h1, h _ h2]

theorem kOmMWeight_mulSingle_ne {κ : Kˣ} (hκ : κ * κ ≠ 1) (l' : Fin r)
    {a a' : Fin (r + 1 - 1) ⊕ Fin (r + 1 - 1) ⊕ Fin 2} (haa : a ≠ a')
    (ha : a = Sum.inl l' ∨ a = Sum.inr (Sum.inl l')) :
    kOmMWeight K r (Pi.mulSingle l' κ) a ≠ kOmMWeight K r (Pi.mulSingle l' κ) a' := by
  have hκ1 : (κ : K) ≠ 1 := fun h => units_ne_one_of_mul_self_ne_one hκ (Units.ext h)
  have hκi1 : ((κ⁻¹ : Kˣ) : K) ≠ 1 := fun h =>
    units_ne_one_of_mul_self_ne_one hκ (inv_eq_one.1 (Units.ext h))
  have hκi : (κ : K) ≠ ((κ⁻¹ : Kˣ) : K) := fun h =>
    units_ne_inv_of_mul_self_ne_one hκ (Units.ext h)
  have hw : ∀ i : Fin r, kOmMWeight K r (Pi.mulSingle l' κ) (Sum.inl i) =
      if i = l' then (κ : K) else 1 := fun i => by
    by_cases hi : i = l'
    · subst hi
      rw [ite_eq_left rfl, kOmMWeight_inl, Pi.mulSingle_eq_same]
    · rw [ite_eq_right hi, kOmMWeight_inl, Pi.mulSingle_eq_of_ne hi, Units.val_one]
  have hw' : ∀ i : Fin r, kOmMWeight K r (Pi.mulSingle l' κ) (Sum.inr (Sum.inl i)) =
      if i = l' then ((κ⁻¹ : Kˣ) : K) else 1 := fun i => by
    by_cases hi : i = l'
    · subst hi
      rw [ite_eq_left rfl, kOmMWeight_inr_inl, Pi.mulSingle_eq_same]
    · rw [ite_eq_right hi, kOmMWeight_inr_inl, Pi.mulSingle_eq_of_ne hi, inv_one, Units.val_one]
  rcases ha with rfl | rfl <;> rcases a' with i | i | j
  · have hi : (i : Fin r) ≠ l' := fun h => haa (by rw [h])
    rw [hw, hw i, ite_eq_left rfl, ite_eq_right hi]
    exact hκ1
  · rw [hw, hw' i, ite_eq_left rfl]
    split_ifs
    · exact hκi
    · exact hκ1
  · rw [hw, kOmMWeight_inr_inr, ite_eq_left rfl]
    exact hκ1
  · rw [hw', hw i, ite_eq_left rfl]
    split_ifs
    · exact hκi.symm
    · exact hκi1
  · have hi : (i : Fin r) ≠ l' := fun h => haa (by rw [h])
    rw [hw', hw' i, ite_eq_left rfl, ite_eq_right hi]
    exact hκi1
  · rw [hw', kOmMWeight_inr_inr, ite_eq_left rfl]
    exact hκi1

variable [Finite K] [CharP K 2]

theorem kOmM_perfectCore_long (hK : 4 ≤ Nat.card K) {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {l : Fin r} {Ts : Set (Fin r → Kˣ)}
    (hTs : ∀ t, t ∈ Ts ↔ t l = 1) :
    perfectCore (StatedOmega (StatedQuadMinus (r + 1) K b c) ⊓
      centralizer (kOmMDiag K r '' Ts)) =
      (StatedOmega (StatedQuadMinus 2 K b c)).map
        (coordEmbedGL (kOmMLongEmb r l) (kOmMLongEmb_injective l)) := by
  obtain ⟨κ, hκ⟩ := exists_units_mul_self_ne_one_of_four_le hK
  have hw1 : ∀ t ∈ Ts, ∀ a ∈ Set.range (kOmMLongEmb r l), kOmMWeight K r t a = 1 := by
    intro t ht a ha
    rcases kOmM_mem_range_longEmb_iff.1 ha with rfl | rfl | ⟨j, rfl⟩
    · rw [kOmMWeight_inl, (hTs t).1 ht, Units.val_one]
    · rw [kOmMWeight_inr_inl, (hTs t).1 ht, inv_one, Units.val_one]
    · rfl
  have hSC : suppGL K (Set.range (kOmMLongEmb r l)) ≤ centralizer (kOmMDiag K r '' Ts) := by
    intro x hx
    rw [mem_centralizer_iff]
    rintro _ ⟨t, ht, rfl⟩
    refine ((commute_of_diag_iff (fun a b hab => kOmMDiag_apply_ne t hab) x).2
      fun a a' haa => ?_).eq.symm
    rw [kOmMDiag_apply_self, kOmMDiag_apply_self] at haa
    by_cases h : a ∈ Set.range (kOmMLongEmb r l) ∧ a' ∈ Set.range (kOmMLongEmb r l)
    · exact absurd ((hw1 t ht a h.1).trans (hw1 t ht a' h.2).symm) haa
    · have hne : a ≠ a' := fun e => haa (e ▸ rfl)
      rw [hx a a' h, Matrix.one_apply_ne hne]
  rw [perfectCore_inf_centralizer_eq_perfectCore_inf_suppGL (T := Set.univ)
      (fun x _ a b hab => absurd ⟨Set.mem_univ a, Set.mem_univ b⟩ hab) (kOmMDiag K r '' Ts)
      (by rintro _ ⟨t, -, rfl⟩ a b hab; exact kOmMDiag_apply_ne t hab)
      (fun a _ a' _ haa hS => by
        rcases hS with ha | ha
        · obtain ⟨l', hl', hal⟩ := kOmM_exists_of_not_mem_range_longEmb ha
          exact ⟨kOmMDiag K r (Pi.mulSingle l' κ),
            ⟨_, (hTs _).2 (Pi.mulSingle_eq_of_ne (Ne.symm hl') κ), rfl⟩, by
              rw [kOmMDiag_apply_self, kOmMDiag_apply_self]
              exact kOmMWeight_mulSingle_ne hκ l' haa hal⟩
        · obtain ⟨l', hl', hal⟩ := kOmM_exists_of_not_mem_range_longEmb ha
          exact ⟨kOmMDiag K r (Pi.mulSingle l' κ),
            ⟨_, (hTs _).2 (Pi.mulSingle_eq_of_ne (Ne.symm hl') κ), rfl⟩, by
              rw [kOmMDiag_apply_self, kOmMDiag_apply_self]
              exact (kOmMWeight_mulSingle_ne hκ l' haa.symm hal).symm⟩),
    inf_of_le_left (inf_le_right.trans hSC)]
  exact (kOmM_isCoordSplit_long b c l).perfectCore_statedOmega_inf_suppGL
    (kOmMLongEmb_injective l) (F4Pilot.commutator_statedOmega_quadMinus_two hirr)

omit [Finite K] [CharP K 2] in
theorem kOmM_long_le_suppGL (b c : K) (l : Fin r) :
    (StatedOmega (StatedQuadMinus 2 K b c)).map
        (coordEmbedGL (kOmMLongEmb r l) (kOmMLongEmb_injective l)) ≤
      suppGL K (Set.range (kOmMLongEmb r l)) := by
  rintro _ ⟨y, -, rfl⟩
  exact F4Pilot.coordEmbedGL_mem_suppGL _ y

theorem kOmM_card_long {b c : K} (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (l : Fin r) :
    Nat.card ((StatedOmega (StatedQuadMinus 2 K b c)).map
      (coordEmbedGL (kOmMLongEmb r l) (kOmMLongEmb_injective l))) =
      F4Pilot.ordSL 2 (Nat.card K ^ 2) := by
  rw [Subgroup.card_map_of_injective (F4Pilot.coordEmbedGL_injective (kOmMLongEmb_injective l)),
    F4Pilot.natCard_statedOmega_quadMinus_two hirr]

end Long

