variable {G : Type} [Group G] {L : Subgroup G} {K : Type} [Field K]

@[expose] noncomputable def nsComplSpToCore {m : ℕ} (hK : Nat.card K = 2) (hm : 3 ≤ m)
    (e : L ≃* StatedSp (m + 1) K) (k : Fin (m + 1)) :
    StatedSp m K →* centralizerPerfectCore (modelToG e (nsTorusSp K k)) :=
  ((L.subtype.comp e.symm.toMonoidHom).comp
    ((complSp K k).subtype.comp (complSpEquiv k).toMonoidHom)).codRestrict _
    fun x => modelToG_complSp_le_centralizerPerfectCore_nsTorusSp hK hm e k
      ⟨e.symm ((complSpEquiv k x : complSp K k) : StatedSp (m + 1) K),
        ⟨_, (complSpEquiv k x).2, rfl⟩, rfl⟩

theorem coe_nsComplSpToCore {m : ℕ} (hK : Nat.card K = 2) (hm : 3 ≤ m)
    (e : L ≃* StatedSp (m + 1) K) (k : Fin (m + 1)) (x : StatedSp m K) :
    ((nsComplSpToCore hK hm e k x : centralizerPerfectCore (modelToG e (nsTorusSp K k))) : G) =
      ((e.symm ((complSpEquiv k x : complSp K k) : StatedSp (m + 1) K) : L) : G) :=
  rfl

theorem nsComplSpToCore_injective {m : ℕ} (hK : Nat.card K = 2) (hm : 3 ≤ m)
    (e : L ≃* StatedSp (m + 1) K) (k : Fin (m + 1)) :
    Function.Injective (nsComplSpToCore hK hm e k) := by
  intro x y hxy
  have h1 := congrArg (fun z : centralizerPerfectCore (modelToG e (nsTorusSp K k)) =>
    (z : G)) hxy
  simp only [coe_nsComplSpToCore] at h1
  exact (complSpEquiv k).injective (Subtype.ext (e.symm.injective (Subtype.ext h1)))

variable [Finite G] in
theorem exists_nsParam_of_proj {m r : ℕ} [Finite K] [CharP K 2] (e : L ≃* StatedSp (m + 1) K)
    (hK : Nat.card K = 2) (hm : 3 ≤ m) {t : G} (htC : t ∈ centralizer (L : Set G))
    (k : Fin (m + 1)) {K' : Type} [Field K'] (h : UnitaryFieldData 2 1 K') {C₀ : GL (Fin r) K'}
    (hC : IsPrimeFormGram C₀)
    (hsplit : ∀ (E' : Type) [Group E'] [Finite E']
      (π' : E' →* gramSU h (C₀ : Matrix (Fin r) (Fin r) K')),
      Function.Surjective π' → π'.ker ≤ center E' → Odd (Nat.card π'.ker) →
        ∃ s : gramSU h (C₀ : Matrix (Fin r) (Fin r) K') →* E', ∀ g, π' (s g) = g)
    (μ : StatedSp m h.fixedField →* gramSU h (C₀ : Matrix (Fin r) (Fin r) K'))
    (hμ : Function.Injective ((QuotientGroup.mk' (normOneScalars h
      (gramSU h (C₀ : Matrix (Fin r) (Fin r) K')) r)).comp μ))
    (hμr : ((QuotientGroup.mk' (normOneScalars h
      (gramSU h (C₀ : Matrix (Fin r) (Fin r) K')) r)).comp μ).range =
        fixedSubgroup (primeFormFieldHom h hC (UnitaryPilot.barRingEquiv h)))
    (hN : t ∈ normalizer (centralizerPerfectCore (modelToG e (nsTorusSp K k)) : Set G))
    (ρ' : centralizerPerfectCore (modelToG e (nsTorusSp K k)) →*
      primeFormP h (C₀ : Matrix (Fin r) (Fin r) K'))
    (hρs : Function.Surjective ρ')
    (hρker : ρ'.ker ≤ center (centralizerPerfectCore (modelToG e (nsTorusSp K k))))
    (hρodd : Odd (Nat.card ρ'.ker))
    (hρt : ∀ y, ρ' ((centralizerPerfectCore (modelToG e (nsTorusSp K k))).normalizerMonoidHom
      ⟨t, hN⟩ y) = primeFormFieldHom h hC (UnitaryPilot.barRingEquiv h) (ρ' y)) :
    ∃ (ι : K ≃+* h.fixedField) (Φ : gramSU h (C₀ : Matrix (Fin r) (Fin r) K') →* G),
      Φ.range = centralizerPerfectCore (modelToG e (nsTorusSp K k)) ∧
      Φ.ker ≤ center (gramSU h (C₀ : Matrix (Fin r) (Fin r) K')) ∧
      ∀ x : StatedSp m K, Φ (μ (statedSpMap (ι : K →+* h.fixedField) m x)) =
        ((e.symm ((complSpEquiv k x : complSp K k) : StatedSp (m + 1) K) : L) : G) := by
  have : Finite K' := h.finite
  have := CFSG.ComponentClassification.UnbalancedCatalog.UnitaryFieldTransfer.fixedField_finite h
  have := CFSG.ComponentClassification.UnbalancedCatalog.UnitaryFieldTransfer.fixedField_charP h
  set π := QuotientGroup.mk' (normOneScalars h (gramSU h (C₀ : Matrix (Fin r) (Fin r) K')) r)
    with hπdef
  set ε := nsComplSpToCore hK hm e k with hεdef
  have hεinj : Function.Injective ε := nsComplSpToCore_injective hK hm e k
  have hρεinj : Function.Injective (ρ'.comp ε) := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hc : ε x ∈ center (centralizerPerfectCore (modelToG e (nsTorusSp K k))) := hρker hx
    have hxc : x ∈ center (StatedSp m K) := by
      rw [mem_center_iff]
      intro y
      apply hεinj
      rw [map_mul, map_mul]
      exact mem_center_iff.mp hc (ε y)
    rw [center_statedSp_eq_bot m] at hxc
    exact hxc
  have hfix : ∀ x, primeFormFieldHom h hC (UnitaryPilot.barRingEquiv h) ((ρ'.comp ε) x) =
      (ρ'.comp ε) x := by
    intro x
    rw [MonoidHom.comp_apply, ← hρt]
    congr 1
    apply Subtype.ext
    rw [Subgroup.normalizerMonoidHom_apply_apply_coe]
    have hxL : ((ε x : centralizerPerfectCore (modelToG e (nsTorusSp K k))) : G) ∈ L := (e.symm _).2
    rw [← mem_centralizer_iff.1 htC _ hxL, mul_inv_cancel_right]
  have hcard : Nat.card K = Nat.card h.fixedField := by rw [hK, h.card_fixedField, pow_one]
  obtain ⟨y, ι, hy, hyε⟩ := exists_conj_eq_of_range_eq_fixedSubgroup hm hcard (π.comp μ) hμ hμr
    (ρ'.comp ε) hρεinj hfix
  set ρ₁ := (MulAut.conj y).toMonoidHom.comp ρ' with hρ₁def
  have hρ₁s : Function.Surjective ρ₁ := (MulAut.conj y).surjective.comp hρs
  have hker₁ : ρ₁.ker = ρ'.ker := by
    ext z
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker, hρ₁def, MonoidHom.comp_apply,
      MulEquiv.coe_toMonoidHom, MulEquiv.map_eq_one_iff]
  have hρ₁ker : ρ₁.ker ≤ center (centralizerPerfectCore (modelToG e (nsTorusSp K k))) :=
    hker₁ ▸ hρker
  have hρ₁odd : Odd (Nat.card ρ₁.ker) := hker₁ ▸ hρodd
  have hρ₁ε : ∀ x, ρ₁ (ε x) = π (μ (statedSpMap (ι : K →+* h.fixedField) m x)) := by
    intro x
    rw [← MonoidHom.comp_apply π μ, ← hyε x]
    rfl
  clear_value ρ₁
  have : Group.IsPerfect (centralizerPerfectCore (modelToG e (nsTorusSp K k))) :=
    isPerfect_iff.mpr (F4Pilot.commutator_centralizerPerfectCore _)
  obtain ⟨Φ₀, hΦ₀s, hΦ₀⟩ := exists_lift_of_central_odd π (QuotientGroup.mk'_surjective _)
    hsplit ρ₁ hρ₁s hρ₁ker hρ₁odd
  refine ⟨ι, (centralizerPerfectCore (modelToG e (nsTorusSp K k))).subtype.comp Φ₀, ?_, ?_, ?_⟩
  · rw [MonoidHom.range_comp, MonoidHom.range_eq_top.2 hΦ₀s, ← MonoidHom.range_eq_map,
      range_subtype]
  · intro g hg
    have hg₀ : Φ₀ g = 1 := (centralizerPerfectCore (modelToG e (nsTorusSp K k))).subtype_injective
      (by rw [map_one]; exact hg)
    have h1 := hΦ₀ g
    rw [hg₀, map_one, eq_comm, hπdef, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
    exact normOneScalars_le_center h _ _ h1
  · intro x
    have : Group.IsPerfect (StatedSp m K) := isPerfect_statedSp_of_charTwo hm
    have heq := LinearPilot.eq_of_comp_eq_of_ker_le_center (S := StatedSp m K) hρ₁ker
      (φ := Φ₀.comp (μ.comp (statedSpMap (ι : K →+* h.fixedField) m)))
      (ψ := ε) (fun x => by
        rw [MonoidHom.comp_apply, MonoidHom.comp_apply, hΦ₀, hρ₁ε])
    exact congrArg (fun F : StatedSp m K →* centralizerPerfectCore (modelToG e (nsTorusSp K k)) =>
      ((F x : centralizerPerfectCore (modelToG e (nsTorusSp K k))) : G)) heq

end Construct

