variable {m : ℕ} {K' : Type} [Field K'] (h : UnitaryFieldData 2 1 K')

theorem gramSU_exists_section_of_odd_two {C : GL (Fin (2 * m)) K'} (hC : IsPrimeFormGram C)
    (hm : 1 ≤ m) :
    ∀ (E' : Type) [Group E'] [Finite E']
      (π' : E' →* gramSU h (C : Matrix (Fin (2 * m)) (Fin (2 * m)) K')),
      Function.Surjective π' → π'.ker ≤ center E' → Odd (Nat.card π'.ker) →
        ∃ s : gramSU h (C : Matrix (Fin (2 * m)) (Fin (2 * m)) K') →* E', ∀ g, π' (s g) = g := by
  have : Finite K' := h.finite
  have : CharP K' 2 := h.charP
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hF : Nat.card K' = (2 ^ 1) ^ 2 := by rw [h.card]; norm_num
  obtain ⟨eS⟩ := nonempty_gramSU_mulEquiv_statedSU h hC
  refine forall_exists_section_odd_of_mulEquiv
    (eS.trans (CFSG.LieType.Universal.Unitary.equivStatedSU (p := 2) (f := 1) hF (2 * m + 0)).symm)
    fun E' _ _ π' hπ' hcen hodd => ?_
  exact CFSG.LieType.Steinberg.CentralExt.SUClosed.su_exists_section_of_coprime (p := 2) (f := 1)
    hF ⟨m, by ring⟩ (by omega) hπ' hcen (Nat.coprime_two_left.2 hodd)

theorem gramSU_one_exists_section_of_odd_two {N : ℕ} {C₀ : GL (Fin N) K'}
    (hC₀ : (C₀ : Matrix (Fin N) (Fin N) K') = 1) (hN : 5 ≤ N) (ho : ¬ Even N) :
    ∀ (E' : Type) [Group E'] [Finite E']
      (π' : E' →* gramSU h (C₀ : Matrix (Fin N) (Fin N) K')),
      Function.Surjective π' → π'.ker ≤ center E' → Odd (Nat.card π'.ker) →
        ∃ s : gramSU h (C₀ : Matrix (Fin N) (Fin N) K') →* E', ∀ g, π' (s g) = g := by
  have : Finite K' := h.finite
  have : CharP K' 2 := h.charP
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hF : Nat.card K' = (2 ^ 1) ^ 2 := by rw [h.card]; norm_num
  refine forall_exists_section_odd_of_mulEquiv (gramSUOneEquiv h hC₀)
    fun E' _ _ π' hπ' hcen _ => ?_
  exact CFSG.LieType.Steinberg.CentralExt.SUOdd.statedSU_odd_exists_section_of_central
    (p := 2) (f := 1) hF le_rfl (by omega) ho (fun h3 => by
      have := (Prod.mk.inj h3).1
      omega) hπ' hcen

end Split

