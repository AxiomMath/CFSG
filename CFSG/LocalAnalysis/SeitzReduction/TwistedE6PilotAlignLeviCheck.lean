abbrev RelCong (m : ℤ) (I : Finset (Fin Tag.F4.rank)) (b : Fin Tag.E6.rank → ℤ)
    (j : Fin Tag.E6.rank) : Prop :=
  ∀ a ∉ I, m ∣ e6ToF4 b a - e6ToF4 (Pi.single j 1 : Fin Tag.E6.rank → ℤ) a

abbrev RelExact (I : Finset (Fin Tag.F4.rank)) (b : Fin Tag.E6.rank → ℤ)
    (j : Fin Tag.E6.rank) : Prop :=
  ∀ a ∉ I, e6ToF4 b a = e6ToF4 (Pi.single j 1 : Fin Tag.E6.rank → ℤ) a

abbrev RelBad (I : Finset (Fin Tag.F4.rank)) : Prop :=
  I = {0, 1} ∨ I = {0, 2} ∨ I = {0, 3} ∨ I = {1, 3}

