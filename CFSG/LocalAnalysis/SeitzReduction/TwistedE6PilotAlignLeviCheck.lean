theorem badTuples01_complete :
    ∀ b3 ∈ rootFinset Tag.E6, RelCong 3 {0, 1} b3 3 →
    ∀ b1 ∈ rootFinset Tag.E6, RelCong 3 {0, 1} b1 1 → iform b3 b1 = -1 →
    ∀ b2 ∈ rootFinset Tag.E6, RelCong 3 {0, 1} b2 2 → iform b3 b2 = -1 → iform b1 b2 = 0 →
    ∀ b4 ∈ rootFinset Tag.E6, RelCong 3 {0, 1} b4 4 → iform b3 b4 = -1 → iform b1 b4 = 0 →
      iform b2 b4 = 0 →
    ∀ b0 ∈ rootFinset Tag.E6, RelCong 3 {0, 1} b0 0 → iform b3 b0 = 0 → iform b1 b0 = 0 →
      iform b2 b0 = -1 → iform b4 b0 = 0 →
    ∀ b5 ∈ rootFinset Tag.E6, RelCong 3 {0, 1} b5 5 → iform b3 b5 = 0 → iform b1 b5 = 0 →
      iform b2 b5 = 0 → iform b4 b5 = -1 → iform b0 b5 = 0 →
      (b0 0 - b2 0 + b4 0 - b5 0) % 3 = 1 →
      tuple6 b0 b1 b2 b3 b4 b5 ∈ badTuples01 := by
  decide +kernel

