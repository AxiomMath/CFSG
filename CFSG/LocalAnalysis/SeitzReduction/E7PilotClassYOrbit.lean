@[expose] def yOrbWord (v : Fin 10 → ZMod 2) : List (Fin 42) :=
  yOrbWordTable.getD (yOrbCode v) []

@[expose] def yOrbApply : List (Fin 42) → (Fin 10 → ZMod 2) → (Fin 10 → ZMod 2)
  | [], v => v
  | i :: word, v => yOrbApply word (yOrbStep i v)

theorem yOrbWord_check : ∀ v : Fin 10 → ZMod 2, yQ v = 1 →
    yOrbApply (yOrbWord v) v = yY := by
  decide +kernel

section Certs


theorem yOrbRoot_isRoot (i : Fin 42) : IsRoot .E7 (yOrbRoot i) :=
  yIsRoot_of_mem_yLevelZeroRoots (yOrbRoot_mem i)

theorem yOrbRoot_level (i : Fin 42) : yLevel (yOrbRoot i) = 0 :=
  yLevel_of_mem_yLevelZeroRoots (yOrbRoot_mem i)

variable {K : Type} [Field K]

@[expose] noncomputable def yOrbProd (word : List (Fin 42)) : ModGL .E7 K :=
  word.foldr (fun i m => m * pinnedX .E7 K (yOrbRoot i) 1) 1

theorem yOrbProd_nil : yOrbProd (K := K) [] = 1 := rfl

theorem yOrbProd_cons (i : Fin 42) (word : List (Fin 42)) :
    yOrbProd (K := K) (i :: word) =
      yOrbProd word * pinnedX .E7 K (yOrbRoot i) 1 := rfl

theorem yOrbProd_mem_adjointGroup (word : List (Fin 42)) :
    yOrbProd (K := K) word ∈ adjointGroup .E7 K := by
  induction word with
  | nil => exact one_mem _
  | cons i word ih =>
    rw [yOrbProd_cons]
    exact mul_mem ih (pinnedX_mem_adjointGroup _ _)

theorem yOrbProd_mem_linConjSubgroup [CharP K 2] (word : List (Fin 42)) :
    yOrbProd (K := K) word ∈ linConjSubgroup K yPsi := by
  induction word with
  | nil => exact one_mem _
  | cons i word ih =>
    rw [yOrbProd_cons]
    refine mul_mem ih (pinnedX_mem_linConjSubgroup yPsi_nodup
      (fun _ hβ => isRoot_of_mem_yPsi hβ) yPsi_comm (yOrbRoot_isRoot i) ?_ 1)
    intro β hβ
    exact conj_hyp_of_yLevel_nonneg (le_of_eq (yOrbRoot_level i).symm) β hβ

theorem yOrbProd_conj_rootProd (word : List (Fin 42)) :
    ∀ c : (Fin Tag.E7.rank → ℤ) → ZMod 2,
      ∃ c', yOrbProd (K := ZMod 2) word * rootProd .E7 (ZMod 2) yPsi c *
          (yOrbProd (K := ZMod 2) word)⁻¹ = rootProd .E7 (ZMod 2) yPsi c' ∧
        yRestrict c' = yOrbApply word (yRestrict c) := by
  induction word with
  | nil =>
    intro c
    exact ⟨c, by simp [yOrbProd_nil], rfl⟩
  | cons i word ih =>
    intro c
    obtain ⟨c', hconj, hres⟩ := ih (conjCoeff (yOrbRoot i) 1 yPsi c)
    refine ⟨c', ?_, ?_⟩
    · have hstep :
          yOrbProd (K := ZMod 2) word * pinnedX .E7 (ZMod 2) (yOrbRoot i) 1 *
              rootProd .E7 (ZMod 2) yPsi c *
              (yOrbProd (K := ZMod 2) word * pinnedX .E7 (ZMod 2) (yOrbRoot i) 1)⁻¹ =
            yOrbProd (K := ZMod 2) word *
              (pinnedX .E7 (ZMod 2) (yOrbRoot i) 1 * rootProd .E7 (ZMod 2) yPsi c *
                (pinnedX .E7 (ZMod 2) (yOrbRoot i) 1)⁻¹) *
              (yOrbProd (K := ZMod 2) word)⁻¹ := by group
      rw [yOrbProd_cons, hstep,
        conj_rootProd_yPsi (yOrbRoot_isRoot i) (le_of_eq (yOrbRoot_level i).symm) 1 c]
      exact hconj
    · calc yRestrict c' = yOrbApply word (yRestrict (conjCoeff (yOrbRoot i) 1 yPsi c)) :=
            hres
        _ = yOrbApply word (yOrbStep i (yRestrict c)) := by
            rw [yRestrict_conjCoeff, yOrbStep_eq_yRootStep]
        _ = yOrbApply (i :: word) (yRestrict c) := rfl

theorem exists_conj_yAS_of_yQc_eq_one
    {c : (Fin Tag.E7.rank → ℤ) → ZMod 2} (hc : yQc c = 1) :
    ∃ m ∈ adjointGroup .E7 (ZMod 2), m ∈ linConjSubgroup (ZMod 2) yPsi ∧
      m * rootProd .E7 (ZMod 2) yPsi c * m⁻¹ = yAS (ZMod 2) := by
  classical
  set v := yRestrict c with hvdef
  have hv : yQ v = 1 := by rw [hvdef, yOrb_yQ_yRestrict, hc]
  obtain ⟨c', hconj, hres⟩ := yOrbProd_conj_rootProd (yOrbWord v) c
  refine ⟨yOrbProd (K := ZMod 2) (yOrbWord v), yOrbProd_mem_adjointGroup _,
    yOrbProd_mem_linConjSubgroup _, ?_⟩
  have hresY : yRestrict c' = yY := by
    rw [hres]
    exact yOrbWord_check v hv
  have hcoeff : ∀ β ∈ yPsi, c' β = yCoeff (K := ZMod 2) β := by
    intro β hβ
    have h1 := congrFun hresY (yIdx β)
    have h2 := congrFun yOrb_yRestrict_yCoeff (yIdx β)
    simp only [yRestrict, yVec_yIdx hβ] at h1 h2
    exact h1.trans h2.symm
  calc yOrbProd (K := ZMod 2) (yOrbWord v) * rootProd .E7 (ZMod 2) yPsi c *
        (yOrbProd (K := ZMod 2) (yOrbWord v))⁻¹
      = rootProd .E7 (ZMod 2) yPsi c' := hconj
    _ = rootProd .E7 (ZMod 2) yPsi (yCoeff (K := ZMod 2)) := rootProd_congr hcoeff
    _ = yAS (ZMod 2) := rootProd_yPsi_yCoeff

end Certs

