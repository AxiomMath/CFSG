local instance yOrbNeZeroRank : NeZero Tag.E7.rank := ⟨by decide⟩

theorem yOrb_yQ_yRestrict (c : (Fin Tag.E7.rank → ℤ) → ZMod 2) :
    yQ (yRestrict c) = yQc c := by
  have h0 : yVec 0 = yFormR8 := rfl
  have h1 : yVec 1 = yFormR9 := rfl
  have h2 : yVec 2 = yFormR0 := rfl
  have h3 : yVec 3 = yFormR2 := rfl
  have h4 : yVec 4 = yFormR4 := rfl
  have h5 : yVec 5 = yFormR6 := rfl
  have h6 : yVec 6 = yFormR7 := rfl
  have h7 : yVec 7 = yFormR5 := rfl
  have h8 : yVec 8 = yFormR3 := rfl
  have h9 : yVec 9 = yFormR1 := rfl
  simp only [yQc, yForm_pair_eq, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  simp only [yQ, yRestrict, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9]
  ring

theorem yOrb_yRestrict_yCoeff : yRestrict (yCoeff (K := ZMod 2)) = yY := by
  decide +kernel

theorem yOrb_yLevelRootData_length : yLevelRootData.length = 42 := rfl

@[expose] def yOrbRoot (i : Fin 42) : Fin Tag.E7.rank → ℤ :=
  (yLevelRootData.get (Fin.cast yOrb_yLevelRootData_length.symm i)).root

@[expose] def yOrbStep (i : Fin 42) (v : Fin 10 → ZMod 2) : Fin 10 → ZMod 2 :=
  yStepFun (yLevelRootData.get (Fin.cast yOrb_yLevelRootData_length.symm i)).table 1 v

theorem yOrbRoot_mem (i : Fin 42) : yOrbRoot i ∈ yLevelZeroRoots :=
  List.mem_map.2 ⟨_, List.get_mem _ _, rfl⟩

theorem yOrbStep_eq_yRootStep (i : Fin 42) :
    yOrbStep i = yRootStep (yOrbRoot i) 1 := by
  funext v
  simp only [yOrbStep, yOrbRoot, yRootStep]
  rw [yTableOf_rootData (yLevelRootData.get (Fin.cast yOrb_yLevelRootData_length.symm i))
    (List.get_mem _ _)]

@[expose] def yOrbCode (v : Fin 10 → ZMod 2) : ℕ :=
  (List.finRange 10).foldl (fun acc k => acc + (v k).val * 2 ^ (k : ℕ)) 0

