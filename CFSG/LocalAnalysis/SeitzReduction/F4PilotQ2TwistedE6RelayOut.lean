section Perfect

variable {F : Type} [Field F] [Finite F] [CharP F 2] (h : UnitaryFieldData 2 1 F)

theorem isPerfect_gramSU_antidiag_four :
    Group.IsPerfect (gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F)) := by
  have hF : Nat.card F = (2 ^ 1) ^ 2 := by rw [h.card]; norm_num
  have := SymplecticPilot.isPerfect_SU_ctua (F := F) (f := 1) (r := 4) hF (by norm_num)
    (by norm_num)
  exact Group.IsPerfect.ofSurjective
    (f := (MulEquiv.subgroupCongr (SymplecticPilot.SU_eq_gramSU (r := 4) h)).toMonoidHom)
    (MulEquiv.subgroupCongr (SymplecticPilot.SU_eq_gramSU (r := 4) h)).surjective

theorem commutator_relayTwBlock {σ : Fin 4 ⊕ Fin 2 ≃ Fin 6} {J' : Matrix (Fin 2) (Fin 2) F}
    {I : Finset (Fin 6)}
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J'))
    (hl : ∀ i, σ (Sum.inl i) ∈ I) (hr : ∀ j, σ (Sum.inr j) ∉ I) :
    ⁅relayTwBlock h I, relayTwBlock h I⁆ = relayTwBlock h I := by
  have := isPerfect_gramSU_antidiag_four h
  have hP : Group.IsPerfect (relayTwBlock h I) := Group.IsPerfect.ofSurjective
    (f := (relayTwBlockEquiv h hJ hl hr).toMonoidHom) (relayTwBlockEquiv h hJ hl hr).surjective
  exact Subgroup.isPerfect_iff.1 hP

end Perfect

