section Ext

variable {F : Type} [Field F] (σ : Fin 4 ⊕ Fin 2 ≃ Fin 6)

@[expose] def relayTwExt (A : Matrix (Fin 4) (Fin 4) F) : Matrix (Fin 6) (Fin 6) F :=
  reindex σ σ (fromBlocks A 0 0 1)

theorem relayTwExt_apply (A : Matrix (Fin 4) (Fin 4) F) (p q : Fin 6) :
    relayTwExt σ A p q = fromBlocks A 0 0 1 (σ.symm p) (σ.symm q) :=
  rfl

theorem relayTwExt_one : relayTwExt σ (1 : Matrix (Fin 4) (Fin 4) F) = 1 := by
  rw [relayTwExt, fromBlocks_one, reindex_apply, submatrix_one_equiv]

theorem relayTwExt_mul (A B : Matrix (Fin 4) (Fin 4) F) :
    relayTwExt σ (A * B) = relayTwExt σ A * relayTwExt σ B := by
  have h := (reindexAlgEquiv F F σ).map_mul (fromBlocks A 0 0 1) (fromBlocks B 0 0 1)
  simp only [fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, Matrix.mul_one, add_zero,
    zero_add] at h
  exact h

theorem det_relayTwExt (A : Matrix (Fin 4) (Fin 4) F) : (relayTwExt σ A).det = A.det := by
  rw [relayTwExt, det_reindex_self, det_fromBlocks_zero₂₁, det_one, mul_one]

theorem relayTwExt_map (φ : F →+* F) (A : Matrix (Fin 4) (Fin 4) F) :
    (relayTwExt σ A).map φ = relayTwExt σ (A.map φ) := by
  rw [relayTwExt, relayTwExt, reindex_apply, reindex_apply, ← submatrix_map, fromBlocks_map,
    Matrix.map_zero _ (map_zero φ), Matrix.map_zero _ (map_zero φ),
    Matrix.map_one _ (map_zero φ) (map_one φ)]

theorem relayTwExt_transpose (A : Matrix (Fin 4) (Fin 4) F) :
    (relayTwExt σ A)ᵀ = relayTwExt σ Aᵀ := by
  rw [relayTwExt, relayTwExt, transpose_reindex, fromBlocks_transpose, transpose_zero,
    transpose_zero, transpose_one]

theorem relayTwExt_injective : Function.Injective (relayTwExt (F := F) σ) := by
  intro A B hAB
  have h1 := (reindex σ σ).injective hAB
  exact (fromBlocks_inj.1 h1).1

theorem reindex_fromBlocks_mul_mul (M₁ M₂ M₃ : Matrix (Fin 4) (Fin 4) F)
    (D₁ D₂ D₃ : Matrix (Fin 2) (Fin 2) F) :
    reindex σ σ (fromBlocks M₁ 0 0 D₁) * reindex σ σ (fromBlocks M₂ 0 0 D₂) *
        reindex σ σ (fromBlocks M₃ 0 0 D₃) =
      reindex σ σ (fromBlocks (M₁ * M₂ * M₃) 0 0 (D₁ * D₂ * D₃)) := by
  simp only [reindex_apply, submatrix_mul_equiv, fromBlocks_multiply, Matrix.mul_zero,
    Matrix.zero_mul, add_zero, zero_add]

variable (J' : Matrix (Fin 2) (Fin 2) F)

theorem relayTwExt_gram (C : Matrix (Fin 4) (Fin 4) F) (φ : F →+* F)
    (A : Matrix (Fin 4) (Fin 4) F) :
    ((relayTwExt σ A).map φ)ᵀ * reindex σ σ (fromBlocks C 0 0 J') * relayTwExt σ A =
      reindex σ σ (fromBlocks ((A.map φ)ᵀ * C * A) 0 0 J') := by
  rw [relayTwExt_map, relayTwExt_transpose, relayTwExt, relayTwExt, reindex_fromBlocks_mul_mul,
    Matrix.one_mul, Matrix.mul_one]

theorem relayTwExt_gram_eq_iff (C : Matrix (Fin 4) (Fin 4) F) (φ : F →+* F)
    (A : Matrix (Fin 4) (Fin 4) F) :
    ((relayTwExt σ A).map φ)ᵀ * reindex σ σ (fromBlocks C 0 0 J') * relayTwExt σ A =
        reindex σ σ (fromBlocks C 0 0 J') ↔ (A.map φ)ᵀ * C * A = C := by
  rw [relayTwExt_gram]
  constructor
  · intro h
    exact (fromBlocks_inj.1 ((reindex σ σ).injective h)).1
  · intro h
    rw [h]

end Ext

section Block

variable {F : Type} [Field F] {p f : ℕ} (h : UnitaryFieldData p f F)

@[expose] def relayTwExtHom (σ : Fin 4 ⊕ Fin 2 ≃ Fin 6) :
    Matrix (Fin 4) (Fin 4) F →* Matrix (Fin 6) (Fin 6) F where
  toFun := relayTwExt σ
  map_one' := relayTwExt_one σ
  map_mul' := relayTwExt_mul σ

@[expose] def relayTwExtGL (σ : Fin 4 ⊕ Fin 2 ≃ Fin 6) : GL (Fin 4) F →* GL (Fin 6) F :=
  Units.map (relayTwExtHom σ)

theorem coe_relayTwExtGL (σ : Fin 4 ⊕ Fin 2 ≃ Fin 6) (g : GL (Fin 4) F) :
    ((relayTwExtGL σ g : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) = relayTwExt σ g :=
  rfl

@[expose] def relayTwBlock (I : Finset (Fin 6)) : Subgroup (uGroup6 h) :=
  (blockSpecialLinear (K := F) I).comap (gramSUToSL h _)

theorem mem_relayTwBlock {I : Finset (Fin 6)} {g : uGroup6 h} :
    g ∈ relayTwBlock h I ↔ ∀ p q, (p ∉ I ∨ q ∉ I) →
      ((g : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) p q = (1 : Matrix (Fin 6) (Fin 6) F) p q :=
  Iff.rfl

variable {σ : Fin 4 ⊕ Fin 2 ≃ Fin 6} {J' : Matrix (Fin 2) (Fin 2) F}

theorem relayTwExtGL_mem
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J'))
    {g : GL (Fin 4) F} (hg : g ∈ gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F)) :
    relayTwExtGL σ g ∈ uGroup6 h := by
  rw [mem_gramSU] at hg ⊢
  rw [coe_relayTwExtGL, coe_graphGram6, hJ, relayTwExt_gram_eq_iff, det_relayTwExt]
  exact hg

@[expose] def relayTwSU
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J')) :
    gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F) →* uGroup6 h :=
  ((relayTwExtGL σ).comp (gramSU h _).subtype).codRestrict _ fun g => relayTwExtGL_mem h hJ g.2

theorem coe_relayTwSU
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J'))
    (g : gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F)) :
    (((relayTwSU h hJ g : uGroup6 h) : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) =
      relayTwExt σ ((g : GL (Fin 4) F) : Matrix (Fin 4) (Fin 4) F) :=
  rfl

theorem relayTwSU_injective
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J')) :
    Function.Injective (relayTwSU h hJ) := by
  intro g g' hgg'
  apply Subtype.ext
  apply Units.ext
  apply relayTwExt_injective σ
  rw [← coe_relayTwSU h hJ, ← coe_relayTwSU h hJ, hgg']

variable {I : Finset (Fin 6)}

theorem relayTwExt_apply_of_not_mem (hl : ∀ i, σ (Sum.inl i) ∈ I) (A : Matrix (Fin 4) (Fin 4) F)
    {p q : Fin 6} (hpq : p ∉ I ∨ q ∉ I) :
    relayTwExt σ A p q = (1 : Matrix (Fin 6) (Fin 6) F) p q := by
  obtain ⟨x, rfl⟩ := σ.surjective p
  obtain ⟨y, rfl⟩ := σ.surjective q
  rw [relayTwExt_apply, Equiv.symm_apply_apply, Equiv.symm_apply_apply]
  rcases x with i | i <;> rcases y with j | j
  · rcases hpq with h1 | h1
    · exact absurd (hl i) h1
    · exact absurd (hl j) h1
  · rw [fromBlocks_apply₁₂, Matrix.zero_apply,
      one_apply_ne (fun e => Sum.inl_ne_inr (σ.injective e))]
  · rw [fromBlocks_apply₂₁, Matrix.zero_apply,
      one_apply_ne (fun e => Sum.inr_ne_inl (σ.injective e))]
  · rw [fromBlocks_apply₂₂]
    by_cases hij : i = j
    · subst hij
      rw [one_apply_eq, one_apply_eq]
    · rw [one_apply_ne hij, one_apply_ne (fun e => hij (Sum.inr_injective (σ.injective e)))]

theorem range_relayTwSU
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J'))
    (hl : ∀ i, σ (Sum.inl i) ∈ I) (hr : ∀ j, σ (Sum.inr j) ∉ I) :
    (relayTwSU h hJ).range = relayTwBlock h I := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [mem_relayTwBlock]
    intro p q hpq
    rw [coe_relayTwSU]
    exact relayTwExt_apply_of_not_mem hl _ hpq
  · intro x hx
    rw [mem_relayTwBlock] at hx
    set M : Matrix (Fin 6) (Fin 6) F := ((x : GL (Fin 6) F) : Matrix (Fin 6) (Fin 6) F) with hM
    set A : Matrix (Fin 4) (Fin 4) F := M.submatrix (σ ∘ Sum.inl) (σ ∘ Sum.inl) with hA
    have hAM : relayTwExt σ A = M := by
      ext p q
      by_cases hpq : p ∉ I ∨ q ∉ I
      · rw [relayTwExt_apply_of_not_mem hl A hpq, hx p q hpq]
      · obtain ⟨hp, hq⟩ := not_or.1 hpq
        rw [not_not] at hp hq
        obtain ⟨x', rfl⟩ := σ.surjective p
        obtain ⟨y', rfl⟩ := σ.surjective q
        rcases x' with i | i
        · rcases y' with j | j
          · rw [relayTwExt_apply, Equiv.symm_apply_apply, Equiv.symm_apply_apply,
              fromBlocks_apply₁₁]
            rfl
          · exact absurd hq (hr j)
        · exact absurd hp (hr i)
    have hx2 := x.2
    rw [mem_gramSU, coe_graphGram6, ← hM, ← hAM, hJ, relayTwExt_gram_eq_iff,
      det_relayTwExt] at hx2
    have hdet : A.det ≠ 0 := by rw [hx2.2]; exact one_ne_zero
    refine ⟨⟨GeneralLinearGroup.mkOfDetNeZero A hdet, ?_⟩, ?_⟩
    · exact hx2
    · apply Subtype.ext
      apply Units.ext
      rw [coe_relayTwSU]
      exact hAM

@[expose] noncomputable def relayTwBlockEquiv
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J'))
    (hl : ∀ i, σ (Sum.inl i) ∈ I) (hr : ∀ j, σ (Sum.inr j) ∉ I) :
    gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F) ≃* relayTwBlock h I :=
  (MonoidHom.ofInjective (relayTwSU_injective h hJ)).trans
    (MulEquiv.subgroupCongr (range_relayTwSU h hJ hl hr))

end Block

section Out

variable {F : Type} [Field F]

theorem relayTw_mul_inv_mem_inner {E : Type*} [Group E] (h2 : Nat.card (Outer E) = 2)
    (α β : MulAut E) (hα : α ∉ (MulAut.conj : E →* MulAut E).range)
    (hβ : β ∉ (MulAut.conj : E →* MulAut E).range) :
    α * β⁻¹ ∈ (MulAut.conj : E →* MulAut E).range := by
  obtain ⟨y, -, hy⟩ := (Nat.card_eq_two_iff' (1 : Outer E)).1 h2
  have hα' : (α : Outer E) ≠ 1 := fun e => hα ((QuotientGroup.eq_one_iff (N := inner E) α).1 e)
  have hβ' : (β : Outer E) ≠ 1 := fun e => hβ ((QuotientGroup.eq_one_iff (N := inner E) β).1 e)
  have e : (α : Outer E) = β := (hy _ hα').trans (hy _ hβ').symm
  have e' : ((α * β⁻¹ : MulAut E) : Outer E) = 1 := by
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, e, mul_inv_cancel]
  exact (QuotientGroup.eq_one_iff (N := inner E) _).1 e'

variable (h : UnitaryFieldData 2 1 F)

theorem normOneScalars_relayTw_eq_bot :
    normOneScalars h (gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F)) 4 = ⊥ := by
  rw [eq_bot_iff]
  rintro g ⟨c, -, hc4, hg⟩
  have hF : Nat.card F = 4 := by rw [h.card]; norm_num
  have hc3 : c ^ 3 = 1 := by
    have h3 := pow_card_eq_one' (G := Fˣ) (x := c)
    rwa [Nat.card_units, hF] at h3
  have hc : c = 1 := by
    calc c = c ^ 4 * (c ^ 3)⁻¹ := by group
      _ = 1 := by rw [hc4, hc3, inv_one, mul_one]
  rw [Subgroup.mem_bot]
  apply Subtype.ext
  rw [hg, hc, map_one]
  rfl

@[expose] noncomputable def relayTwPEquiv :
    gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F) ≃*
      primeFormP h (antidiag 4 : Matrix (Fin 4) (Fin 4) F) :=
  QuotientGroup.quotientBot.symm.trans
    (QuotientGroup.quotientMulEquivOfEq (normOneScalars_relayTw_eq_bot h).symm)

theorem natCard_outer_relayTwSU :
    Nat.card (Outer (gramSU h (antidiag 4 : Matrix (Fin 4) (Fin 4) F))) = 2 := by
  obtain ⟨e⟩ := nonempty_primeFormP_mulEquiv h
    (SymplecticPilot.isPrimeFormGram_ctuaAntidiagGL (r := 4) (F := F))
  obtain ⟨-, -, -, -, h5, -⟩ := unitary_full_diagonal_outer_order h (n := 4) (by norm_num)
    (by norm_num)
  rw [Nat.card_congr (CFSG.ComponentClassification.OuterAutomorphisms.equivalence
    ((relayTwPEquiv h).trans e)).toEquiv, h5]
  norm_num

theorem natCard_outer_of_mulEquiv_relayTwBlock {σ : Fin 4 ⊕ Fin 2 ≃ Fin 6}
    {J' : Matrix (Fin 2) (Fin 2) F} {I : Finset (Fin 6)}
    (hJ : (blockSwapJ 6 3 : Matrix (Fin 6) (Fin 6) F) =
      reindex σ σ (fromBlocks (antidiag 4) 0 0 J'))
    (hl : ∀ i, σ (Sum.inl i) ∈ I) (hr : ∀ j, σ (Sum.inr j) ∉ I) {E : Type*} [Group E]
    (χ : E ≃* relayTwBlock h I) : Nat.card (Outer E) = 2 := by
  rw [Nat.card_congr (CFSG.ComponentClassification.OuterAutomorphisms.equivalence
    (χ.trans (relayTwBlockEquiv h hJ hl hr).symm)).toEquiv]
  exact natCard_outer_relayTwSU h

end Out

