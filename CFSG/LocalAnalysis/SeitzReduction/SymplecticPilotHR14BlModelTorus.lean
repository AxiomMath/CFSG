theorem le_map_ker_of_perfect {X : Type*} [Group X] {H P : Subgroup X} {A : Type*} [CommGroup A]
    (φ : H →* A) (hPH : P ≤ H) (hP : ⁅P, P⁆ = P) : P ≤ φ.ker.map H.subtype := by
  rw [← hP]
  refine (commutator_mono hPH hPH).trans ?_
  rw [Subgroup.commutator_le]
  intro g hg h hh
  refine ⟨⁅(⟨g, hg⟩ : H), ⟨h, hh⟩⁆, show ⁅(⟨g, hg⟩ : H), ⟨h, hh⟩⁆ ∈ φ.ker from ?_, rfl⟩
  rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm, mul_comm]

section Plane

variable {K : Type} [Field K] {r : ℕ}

local notation "ι" => Fin (r + 1) ⊕ Fin (r + 1)

theorem kOmega_entry_eq_zero_of_commute_diagonal {A : Matrix ι ι K} {w : ι → K}
    (h : A * Matrix.diagonal w = Matrix.diagonal w * A) {c c' : ι} (hc : w c = 1)
    (hc' : w c' ≠ 1) : A c c' = 0 ∧ A c' c = 0 := by
  have e1 := congrFun (congrFun h c) c'
  have e2 := congrFun (congrFun h c') c
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul, hc, one_mul] at e1
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul, hc, mul_one] at e2
  have hne : w c' - 1 ≠ 0 := sub_ne_zero.2 hc'
  refine ⟨?_, ?_⟩
  · have : A c c' * (w c' - 1) = 0 := by rw [mul_sub, mul_one, e1, sub_self]
    exact (mul_eq_zero.1 this).resolve_right hne
  · have : (w c' - 1) * A c' c = 0 := by rw [sub_mul, one_mul, ← e2, sub_self]
    exact (mul_eq_zero.1 this).resolve_left hne

abbrev kOmegaA (r : ℕ) : Fin (r + 1) ⊕ Fin (r + 1) := Sum.inl (Fin.last r)

abbrev kOmegaB (r : ℕ) : Fin (r + 1) ⊕ Fin (r + 1) := Sum.inr (Fin.last r)

@[expose] def KOmegaPlaneBlock (A : Matrix ι ι K) : Prop :=
  ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r →
    A (kOmegaA r) c = 0 ∧ A (kOmegaB r) c = 0 ∧ A c (kOmegaA r) = 0 ∧ A c (kOmegaB r) = 0

theorem kOmega_mul_apply_plane {A B : Matrix ι ι K} (hA : KOmegaPlaneBlock A) {x y : ι}
    (hx : x = kOmegaA r ∨ x = kOmegaB r) :
    (A * B) x y = A x (kOmegaA r) * B (kOmegaA r) y + A x (kOmegaB r) * B (kOmegaB r) y := by
  rw [Matrix.mul_apply, Fintype.sum_eq_add (kOmegaA r) (kOmegaB r) (by simp)]
  rintro c ⟨hca, hcb⟩
  rcases hx with rfl | rfl
  · rw [(hA c hca hcb).1, zero_mul]
  · rw [(hA c hca hcb).2.1, zero_mul]

theorem statedQuadPlus_of_plane {y : ι → K}
    (hy : ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → y c = 0) :
    StatedQuadPlus (r + 1) K y = y (kOmegaA r) * y (kOmegaB r) := by
  rw [StatedQuadPlus, Fin.sum_univ_castSucc]
  rw [Finset.sum_eq_zero, zero_add]
  intro i _
  rw [hy (Sum.inl (Fin.castSucc i)) (by simp [Fin.castSucc_ne_last]) (by simp), zero_mul]

theorem kOmega_plane_rel {A : Matrix ι ι K}
    (hA : ∀ x, StatedQuadPlus (r + 1) K (A *ᵥ x) = StatedQuadPlus (r + 1) K x)
    (hB : KOmegaPlaneBlock A) :
    A (kOmegaA r) (kOmegaA r) * A (kOmegaB r) (kOmegaA r) = 0 ∧
      A (kOmegaA r) (kOmegaB r) * A (kOmegaB r) (kOmegaB r) = 0 ∧
      (A (kOmegaA r) (kOmegaA r) + A (kOmegaA r) (kOmegaB r)) *
        (A (kOmegaB r) (kOmegaA r) + A (kOmegaB r) (kOmegaB r)) = 1 := by
  have hcol : ∀ x : ι → K, (∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → x c = 0) →
      ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → (A *ᵥ x) c = 0 := by
    intro x hx c hca hcb
    rw [Matrix.mulVec, dotProduct, Fintype.sum_eq_add (kOmegaA r) (kOmegaB r) (by simp)]
    · rw [(hB c hca hcb).2.2.1, (hB c hca hcb).2.2.2, zero_mul, zero_mul, add_zero]
    · rintro d ⟨hda, hdb⟩
      rw [hx d hda hdb, mul_zero]
  have hmv : ∀ x : ι → K, ∀ y, (A *ᵥ x) y =
      A y (kOmegaA r) * x (kOmegaA r) + A y (kOmegaB r) * x (kOmegaB r) +
        ∑ c ∈ (Finset.univ.erase (kOmegaA r)).erase (kOmegaB r), A y c * x c := by
    intro x y
    rw [Matrix.mulVec, dotProduct, ← Finset.add_sum_erase _ _ (Finset.mem_univ (kOmegaA r)),
      ← Finset.add_sum_erase _ _ (Finset.mem_erase.2 ⟨by simp, Finset.mem_univ (kOmegaB r)⟩),
      add_assoc]
  have hsupp : ∀ x : ι → K, (∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → x c = 0) →
      ∀ y, (A *ᵥ x) y = A y (kOmegaA r) * x (kOmegaA r) + A y (kOmegaB r) * x (kOmegaB r) := by
    intro x hx y
    rw [hmv, Finset.sum_eq_zero, add_zero]
    intro c hc
    rw [Finset.mem_erase, Finset.mem_erase] at hc
    rw [hx c hc.2.1 hc.1, mul_zero]
  have key : ∀ x : ι → K, (∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → x c = 0) →
      (A (kOmegaA r) (kOmegaA r) * x (kOmegaA r) + A (kOmegaA r) (kOmegaB r) * x (kOmegaB r)) *
        (A (kOmegaB r) (kOmegaA r) * x (kOmegaA r) + A (kOmegaB r) (kOmegaB r) * x (kOmegaB r)) =
        x (kOmegaA r) * x (kOmegaB r) := by
    intro x hx
    have h1 := hA x
    rw [statedQuadPlus_of_plane (hcol x hx), statedQuadPlus_of_plane hx, hsupp x hx,
      hsupp x hx] at h1
    exact h1
  have hab : kOmegaA r ≠ kOmegaB r := by simp
  refine ⟨?_, ?_, ?_⟩
  · have := key (Pi.single (kOmegaA r) 1) (fun c hca _ => Pi.single_eq_of_ne hca _)
    simpa [Pi.single_eq_of_ne hab.symm] using this
  · have := key (Pi.single (kOmegaB r) 1) (fun c _ hcb => Pi.single_eq_of_ne hcb _)
    simpa [Pi.single_eq_of_ne hab] using this
  · have := key (Pi.single (kOmegaA r) 1 + Pi.single (kOmegaB r) 1) (fun c hca hcb => by
      rw [Pi.add_apply, Pi.single_eq_of_ne hca, Pi.single_eq_of_ne hcb, add_zero])
    simpa [Pi.single_eq_of_ne hab, Pi.single_eq_of_ne hab.symm] using this

theorem kOmega_plane_of_ne_zero {α β γ δ : K} (h1 : α * γ = 0) (h2 : β * δ = 0)
    (h3 : (α + β) * (γ + δ) = 1) (hα : α ≠ 0) : γ = 0 ∧ β = 0 ∧ α * δ = 1 := by
  have hγ : γ = 0 := (mul_eq_zero.1 h1).resolve_left hα
  subst hγ
  have hαδ : α * δ + β * δ = 1 := by rw [← h3]; ring
  rw [h2, add_zero] at hαδ
  have hδ : δ ≠ 0 := fun h => by rw [h, mul_zero] at hαδ; exact zero_ne_one hαδ
  exact ⟨rfl, (mul_eq_zero.1 h2).resolve_right hδ, hαδ⟩

theorem kOmega_plane_of_eq_zero {α β γ δ : K} (h2 : β * δ = 0) (h3 : (α + β) * (γ + δ) = 1)
    (hα : α = 0) : δ = 0 ∧ β * γ = 1 := by
  subst hα
  have hβγ : β * γ + β * δ = 1 := by rw [← h3]; ring
  rw [h2, add_zero] at hβγ
  have hβ : β ≠ 0 := fun h => by rw [h, zero_mul] at hβγ; exact zero_ne_one hβγ
  exact ⟨(mul_eq_zero.1 h2).resolve_left hβ, hβγ⟩

variable (r) in
@[expose] def kOmegaTorusCent (W : Set (ι → K)) : Subgroup (GL ι K) where
  carrier := {x | x ∈ StatedOmega (StatedQuadPlus (r + 1) K) ∧
    ∀ w ∈ W, (x : Matrix ι ι K) * Matrix.diagonal w = Matrix.diagonal w * (x : Matrix ι ι K)}
  one_mem' := ⟨Subgroup.one_mem _, fun w _ => by rw [Units.val_one, Matrix.one_mul,
    Matrix.mul_one]⟩
  mul_mem' := by
    rintro x y ⟨hx, hxw⟩ ⟨hy, hyw⟩
    refine ⟨Subgroup.mul_mem _ hx hy, fun w hw => ?_⟩
    rw [Units.val_mul, Matrix.mul_assoc, hyw w hw, ← Matrix.mul_assoc, hxw w hw, Matrix.mul_assoc]
  inv_mem' := by
    rintro x ⟨hx, hxw⟩
    refine ⟨Subgroup.inv_mem _ hx, fun w hw => ?_⟩
    have h1 : ((x⁻¹ : GL ι K) : Matrix ι ι K) * (x : Matrix ι ι K) = 1 := by
      rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
    have h2 : (x : Matrix ι ι K) * ((x⁻¹ : GL ι K) : Matrix ι ι K) = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    calc ((x⁻¹ : GL ι K) : Matrix ι ι K) * Matrix.diagonal w
        = ((x⁻¹ : GL ι K) : Matrix ι ι K) * Matrix.diagonal w *
            ((x : Matrix ι ι K) * ((x⁻¹ : GL ι K) : Matrix ι ι K)) := by rw [h2, Matrix.mul_one]
      _ = ((x⁻¹ : GL ι K) : Matrix ι ι K) * ((x : Matrix ι ι K) * Matrix.diagonal w) *
            ((x⁻¹ : GL ι K) : Matrix ι ι K) := by rw [hxw w hw]; simp only [Matrix.mul_assoc]
      _ = Matrix.diagonal w * ((x⁻¹ : GL ι K) : Matrix ι ι K) := by
          rw [← Matrix.mul_assoc, h1, Matrix.one_mul]

theorem kOmega_planeBlock_of_mem {W : Set (ι → K)}
    (hW1 : ∀ w ∈ W, w (kOmegaA r) = 1 ∧ w (kOmegaB r) = 1)
    (hWsep : ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → ∃ w ∈ W, w c ≠ 1) {x : GL ι K}
    (hx : x ∈ kOmegaTorusCent r W) : KOmegaPlaneBlock (x : Matrix ι ι K) := by
  intro c hca hcb
  obtain ⟨w, hw, hwc⟩ := hWsep c hca hcb
  have ha := kOmega_entry_eq_zero_of_commute_diagonal (hx.2 w hw) (hW1 w hw).1 hwc
  have hb := kOmega_entry_eq_zero_of_commute_diagonal (hx.2 w hw) (hW1 w hw).2 hwc
  exact ⟨ha.1, hb.1, ha.2, hb.2⟩

theorem kOmega_plane_rel_of_mem {W : Set (ι → K)}
    (hW1 : ∀ w ∈ W, w (kOmegaA r) = 1 ∧ w (kOmegaB r) = 1)
    (hWsep : ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → ∃ w ∈ W, w c ≠ 1) {x : GL ι K}
    (hx : x ∈ kOmegaTorusCent r W) :
    (x : Matrix ι ι K) (kOmegaA r) (kOmegaA r) * (x : Matrix ι ι K) (kOmegaB r) (kOmegaA r) = 0 ∧
      (x : Matrix ι ι K) (kOmegaA r) (kOmegaB r) * (x : Matrix ι ι K) (kOmegaB r) (kOmegaB r) = 0 ∧
      ((x : Matrix ι ι K) (kOmegaA r) (kOmegaA r) + (x : Matrix ι ι K) (kOmegaA r) (kOmegaB r)) *
        ((x : Matrix ι ι K) (kOmegaB r) (kOmegaA r) +
          (x : Matrix ι ι K) (kOmegaB r) (kOmegaB r)) = 1 :=
  kOmega_plane_rel (fun v => kOmega_isometry_of_mem K ⟨x, hx.1⟩ v)
    (kOmega_planeBlock_of_mem hW1 hWsep hx)

theorem kOmegaVec_eq_zero_of_ne {c : ι} (hca : c ≠ kOmegaA r) (hcb : c ≠ kOmegaB r) :
    kOmegaVec K r c = 0 := by
  rcases c with i | i
  · rw [kOmegaVec_inl, ite_eq_right]
    intro h
    exact hca (by rw [h])
  · rw [kOmegaVec_inr, ite_eq_right]
    intro h
    exact hcb (by rw [h])

theorem kOmega_mulVec_vec_of_perfect {W : Set (ι → K)}
    (hW1 : ∀ w ∈ W, w (kOmegaA r) = 1 ∧ w (kOmegaB r) = 1)
    (hWsep : ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → ∃ w ∈ W, w c ≠ 1) {P : Subgroup (GL ι K)}
    (hPC : P ≤ kOmegaTorusCent r W) (hP : ⁅P, P⁆ = P) {x : GL ι K} (hx : x ∈ P) :
    (x : Matrix ι ι K) *ᵥ kOmegaVec K r = kOmegaVec K r := by
  classical
  set C := kOmegaTorusCent r W with hCdef
  set a := kOmegaA r
  set b := kOmegaB r
  have hab : a ≠ b := by simp [a, b]
  have hblk : ∀ y ∈ C, KOmegaPlaneBlock ((y : GL ι K) : Matrix ι ι K) :=
    fun y hy => kOmega_planeBlock_of_mem hW1 hWsep hy
  have hrel := fun (y : GL ι K) (hy : y ∈ C) => kOmega_plane_rel_of_mem hW1 hWsep hy
  have hmulA : ∀ y z : GL ι K, y ∈ C →
      ((y : Matrix ι ι K) * (z : Matrix ι ι K)) a a =
        ((y : GL ι K) : Matrix ι ι K) a a * ((z : GL ι K) : Matrix ι ι K) a a +
          ((y : GL ι K) : Matrix ι ι K) a b * ((z : GL ι K) : Matrix ι ι K) b a := by
    intro y z hy
    rw [kOmega_mul_apply_plane (hblk y hy) (Or.inl rfl)]
  set χ : C →* Multiplicative (ZMod 2) := MonoidHom.mk'
    (fun y => if ((y : GL ι K) : Matrix ι ι K) a a = 0 then Multiplicative.ofAdd 1 else 1)
    (by
      intro y z
      obtain ⟨y1, y2, y3⟩ := hrel y y.2
      obtain ⟨z1, z2, z3⟩ := hrel z z.2
      have e : (((y * z : C) : GL ι K) : Matrix ι ι K) a a =
          ((y : GL ι K) : Matrix ι ι K) a a * ((z : GL ι K) : Matrix ι ι K) a a +
            ((y : GL ι K) : Matrix ι ι K) a b * ((z : GL ι K) : Matrix ι ι K) b a := by
        rw [Subgroup.coe_mul, Units.val_mul]
        exact hmulA _ _ y.2
      by_cases hy : ((y : GL ι K) : Matrix ι ι K) a a = 0 <;>
        by_cases hz : ((z : GL ι K) : Matrix ι ι K) a a = 0
      · obtain ⟨-, hy'⟩ := kOmega_plane_of_eq_zero y2 y3 hy
        obtain ⟨-, hz'⟩ := kOmega_plane_of_eq_zero z2 z3 hz
        have hyab : ((y : GL ι K) : Matrix ι ι K) a b ≠ 0 :=
          fun h => by rw [h, zero_mul] at hy'; exact zero_ne_one hy'
        have hzba : ((z : GL ι K) : Matrix ι ι K) b a ≠ 0 :=
          fun h => by rw [h, mul_zero] at hz'; exact zero_ne_one hz'
        have hyz : (((y * z : C) : GL ι K) : Matrix ι ι K) a a ≠ 0 := by
          rw [e, hy, zero_mul, zero_add]
          exact mul_ne_zero hyab hzba
        rw [ite_eq_right hyz, ite_eq_left hy, ite_eq_left hz, ← ofAdd_add]
        rfl
      · obtain ⟨hzba, -, -⟩ := kOmega_plane_of_ne_zero z1 z2 z3 hz
        have hyz : (((y * z : C) : GL ι K) : Matrix ι ι K) a a = 0 := by
          rw [e, hy, zero_mul, zero_add, hzba, mul_zero]
        rw [ite_eq_left hyz, ite_eq_left hy, ite_eq_right hz, mul_one]
      · obtain ⟨-, hyab, -⟩ := kOmega_plane_of_ne_zero y1 y2 y3 hy
        have hyz : (((y * z : C) : GL ι K) : Matrix ι ι K) a a = 0 := by
          rw [e, hz, mul_zero, zero_add, hyab, zero_mul]
        rw [ite_eq_left hyz, ite_eq_right hy, ite_eq_left hz, one_mul]
      · obtain ⟨-, hyab, -⟩ := kOmega_plane_of_ne_zero y1 y2 y3 hy
        have hyz : (((y * z : C) : GL ι K) : Matrix ι ι K) a a ≠ 0 := by
          rw [e, hyab, zero_mul, add_zero]
          exact mul_ne_zero hy hz
        rw [ite_eq_right hyz, ite_eq_right hy, ite_eq_right hz, mul_one])
    with hχ
  have hP1 := le_map_ker_of_perfect χ hPC hP
  set C₁ := χ.ker.map C.subtype with hC₁
  have hC₁a : ∀ y ∈ C₁, ((y : GL ι K) : Matrix ι ι K) a a ≠ 0 := by
    rintro _ ⟨y, hy, rfl⟩ h
    have hy' : χ y = 1 := hy
    change (if ((y : GL ι K) : Matrix ι ι K) a a = 0 then Multiplicative.ofAdd (1 : ZMod 2)
      else 1) = 1 at hy'
    rw [ite_eq_left (show ((y : GL ι K) : Matrix ι ι K) a a = 0 from h)] at hy'
    exact absurd hy' (by decide)
  have hC₁C : C₁ ≤ C := by
    rintro _ ⟨y, -, rfl⟩
    exact y.2
  set ψ : C₁ →* Kˣ := MonoidHom.mk'
    (fun y => Units.mk0 (((y : GL ι K) : Matrix ι ι K) a a) (hC₁a y y.2))
    (by
      intro y z
      apply Units.ext
      simp only [Units.val_mk0, Units.val_mul, Subgroup.coe_mul]
      have hyC := hC₁C y.2
      obtain ⟨y1, y2, y3⟩ := hrel y hyC
      obtain ⟨-, hyab, -⟩ := kOmega_plane_of_ne_zero y1 y2 y3 (hC₁a y y.2)
      rw [hmulA _ _ hyC, hyab, zero_mul, add_zero])
    with hψ
  have hP2 := le_map_ker_of_perfect ψ hP1 hP
  obtain ⟨⟨y, hyC₁⟩, hyker, rfl⟩ := hP2 hx
  have hyker' : ψ ⟨y, hyC₁⟩ = 1 := hyker
  have h1 : ((y : GL ι K) : Matrix ι ι K) a a = 1 := by
    have := congrArg Units.val hyker'
    simpa [ψ] using this
  have hyC := hC₁C hyC₁
  obtain ⟨y1, y2, y3⟩ := hrel y hyC
  obtain ⟨hyba, hyab, hd⟩ := kOmega_plane_of_ne_zero y1 y2 y3 (by rw [h1]; exact one_ne_zero)
  rw [h1, one_mul] at hd
  have hB := hblk y hyC
  show (y : Matrix ι ι K) *ᵥ kOmegaVec K r = kOmegaVec K r
  have hva : kOmegaVec K r a = 1 := by simp [a, kOmegaVec_inl]
  have hvb : kOmegaVec K r b = 1 := by simp [b, kOmegaVec_inr]
  ext c
  rw [Matrix.mulVec, dotProduct, Fintype.sum_eq_add a b hab]
  · rw [hva, hvb, mul_one, mul_one]
    by_cases hca : c = a
    · rw [hca, h1, hyab, add_zero, hva]
    by_cases hcb : c = b
    · rw [hcb, hyba, hd, zero_add, hvb]
    obtain ⟨-, -, hc1, hc2⟩ := hB c hca hcb
    rw [hc1, hc2, add_zero, kOmegaVec_eq_zero_of_ne hca hcb]
  · rintro c' ⟨hca, hcb⟩
    rw [kOmegaVec_eq_zero_of_ne hca hcb, mul_zero]

end Plane

section Diag

variable {K : Type} [Field K]

theorem spEmbed_last_diagSp {m : ℕ} (t : Fin m → Kˣ) :
    spEmbed (Fin.succAbove (Fin.last m)) Fin.succAbove_right_injective (diagSp K m t) =
      diagSp K (m + 1) (Fin.snoc (α := fun _ => Kˣ) t 1) := by
  have hσ : Function.Injective (Fin.succAbove (Fin.last m)) := Fin.succAbove_right_injective
  have hinj :
      Function.Injective (Sum.map (Fin.succAbove (Fin.last m)) (Fin.succAbove (Fin.last m))) :=
    Sum.map_injective.2 ⟨hσ, hσ⟩
  apply mat_injective
  rw [CFSG.ClassicalInvolution.Models.SymplecticPairs.mat_spEmbed, mat_diagSp, mat_diagSp]
  ext a b
  by_cases h : a ∈ Set.range (Sum.map (Fin.succAbove (Fin.last m)) (Fin.succAbove (Fin.last m))) ∧
      b ∈ Set.range (Sum.map (Fin.succAbove (Fin.last m)) (Fin.succAbove (Fin.last m)))
  · obtain ⟨⟨x, rfl⟩, ⟨y, rfl⟩⟩ := h
    rw [CFSG.ClassicalInvolution.Models.SymplecticPairs.spEmbedMat_apply_image hσ]
    by_cases hxy : x = y
    · subst hxy
      rw [diagonal_apply_eq, diagonal_apply_eq]
      rcases x with i | i <;> simp [Fin.succAbove_last]
    · rw [diagonal_apply_ne _ hxy, diagonal_apply_ne _ (fun e => hxy (hinj e))]
  · rw [CFSG.ClassicalInvolution.Models.SymplecticPairs.spEmbedMat_apply_of_not_mem _ h]
    by_cases hab : a = b
    · subst hab
      have hlast : ∀ i : Fin (m + 1), (∀ i' : Fin m, Fin.castSucc i' ≠ i) → i = Fin.last m := by
        intro i hi
        by_contra hne
        obtain ⟨i', rfl⟩ := Fin.exists_castSucc_eq.2 hne
        exact hi i' rfl
      rw [Matrix.one_apply_eq, diagonal_apply_eq]
      rcases a with i | i
      · have hi : i = Fin.last m := hlast i fun i' hi' => h ⟨⟨Sum.inl i', by
          simp [Fin.succAbove_last, hi']⟩, ⟨Sum.inl i', by simp [Fin.succAbove_last, hi']⟩⟩
        subst hi
        simp
      · have hi : i = Fin.last m := hlast i fun i' hi' => h ⟨⟨Sum.inr i', by
          simp [Fin.succAbove_last, hi']⟩, ⟨Sum.inr i', by simp [Fin.succAbove_last, hi']⟩⟩
        subst hi
        simp
    · rw [Matrix.one_apply_ne hab, diagonal_apply_ne _ hab]

@[expose] def spASepParam {m : ℕ} (j : ℕ) (κ : Kˣ) : Fin m → Kˣ :=
  fun k => if k.val < 2 * j then (if k.val % 2 = 0 then κ else κ⁻¹) else κ

theorem spASepParam_mem {m j : ℕ} (κ : Kˣ) : spASepParam (m := m) j κ ∈ spATorusParam K m j := by
  intro a b h1 h2 h3 h4
  have h2' : a.val ≠ b.val := fun h => h2 (Fin.ext h)
  simp only [spASepParam, ite_eq_left h3, ite_eq_left h4]
  by_cases ha : a.val % 2 = 0
  · rw [ite_eq_left ha, ite_eq_right (by omega), mul_inv_cancel]
  · rw [ite_eq_right ha, ite_eq_left (by omega), inv_mul_cancel]

theorem spASepParam_ne_one {m j : ℕ} {κ : Kˣ} (hκ : κ ≠ 1) (k : Fin m) :
    spASepParam j κ k ≠ 1 := by
  unfold spASepParam
  split_ifs
  · exact hκ
  · exact fun h => hκ (inv_eq_one.1 h)
  · exact hκ

theorem snoc_mem_spATorusParam {m j : ℕ} (hjm : 2 * j ≤ m) {t : Fin m → Kˣ}
    (ht : t ∈ spATorusParam K m j) :
    (Fin.snoc (α := fun _ => Kˣ) t 1 : Fin (m + 1) → Kˣ) ∈ spATorusParam K (m + 1) j := by
  intro a b h1 h2 h3 h4
  have ha : a.val < m := by omega
  have hb : b.val < m := by omega
  have ea : a = Fin.castSucc ⟨a.val, ha⟩ := Fin.ext rfl
  have eb : b = Fin.castSucc ⟨b.val, hb⟩ := Fin.ext rfl
  rw [ea, eb, Fin.snoc_castSucc, Fin.snoc_castSucc]
  exact ht ⟨a.val, ha⟩ ⟨b.val, hb⟩ h1 (fun h => h2 (Fin.ext (by simpa using congrArg Fin.val h)))
    h3 h4

theorem rootTorusSp_last_le_spATorus {r j : ℕ} (hjr : 2 * j ≤ r) :
    rootTorusSp K (Fin.last r) ≤ spATorus K (r + 1) j := by
  rintro _ ⟨κ, rfl⟩
  refine ⟨Pi.mulSingle (Fin.last r) κ, fun a b _ _ h3 h4 => ?_, rfl⟩
  have ha : a ≠ Fin.last r := fun h => by rw [h, Fin.val_last] at h3; omega
  have hb : b ≠ Fin.last r := fun h => by rw [h, Fin.val_last] at h4; omega
  rw [Pi.mulSingle_eq_of_ne ha, Pi.mulSingle_eq_of_ne hb, mul_one]

theorem map_mem_spATorusParam {m j : ℕ} (σ : K ≃+* K) {s : Fin m → Kˣ}
    (hs : s ∈ spATorusParam K m j) :
    (fun i => Units.map (σ : K →* K) (s i)) ∈ spATorusParam K m j := by
  intro a b h1 h2 h3 h4
  simp only
  rw [← map_mul, hs a b h1 h2 h3 h4, map_one]

end Diag

section Global


variable {G : Type} [Group G] [Finite G] {L : Subgroup G} {K : Type} [Field K] [Finite K]
  [CharP K 2]

theorem centralizerPerfectCore_spATorus_le_omegaPlus (hset : SeitzSetting G L) {r f : ℕ}
    (hKc : Nat.card K = 2 ^ f) (hf : 2 ≤ f) (hr3 : 3 ≤ r) (e : L ≃* StatedSp (r + 1) K) {t : G}
    (htC : t ∈ centralizer (L : Set G)) (ht : orderOf t = 2)
    (h : RootKindSp e t f (Fin.last r) .omegaPlus) {j : ℕ} (hjr : 2 * j ≤ r) :
    centralizerPerfectCore (modelToG e (spATorus K (r + 1) j)) ≤ centralizer ({t} : Set G) := by
  have hr : 2 ≤ r := by omega
  obtain ⟨Φ, σ, hN3, hN1⟩ := exists_kOmegaParam hset hKc hf hr hr3 e htC ht (Fin.last r) h
  set T₀ := modelToG e (spATorus K (r + 1) j) with hT₀
  set H := centralizerPerfectCore T₀ with hHdef
  have hHE : H ≤ neighbourCore e (Fin.last r) :=
    centralizerPerfectCore_anti (modelToG_mono e (rootTorusSp_last_le_spATorus hjr))
  have hHperf : ⁅H, H⁆ = H := CFSG.Quasithin.perfectCore_perfect _
  have hHC : H ≤ centralizer (T₀ : Set G) := perfectCore_le _
  set H' : Subgroup (StatedOmega (StatedQuadPlus (r + 1) K)) :=
    (H.subgroupOf (neighbourCore e (Fin.last r))).map Φ.symm.toMonoidHom with hH'
  set P : Subgroup (GL (Fin (r + 1) ⊕ Fin (r + 1)) K) :=
    H'.map (StatedOmega (StatedQuadPlus (r + 1) K)).subtype with hP
  have hPperf : ⁅P, P⁆ = P := by
    rw [hP, ← Subgroup.map_commutator, hH', ← Subgroup.map_commutator,
      CFSG.SeitzReduction.commutator_subgroupOf_eq_self hHE hHperf]
  set W : Set (Fin (r + 1) ⊕ Fin (r + 1) → K) :=
    {w | ∃ s ∈ spATorusParam K r j, w = diagSpEntry (kOmegaSnoc K s)} with hW
  have hW1 : ∀ w ∈ W, w (kOmegaA r) = 1 ∧ w (kOmegaB r) = 1 := by
    rintro _ ⟨s, -, rfl⟩
    simp [kOmegaA, kOmegaB, diagSpEntry_inl, diagSpEntry_inr]
  have hK4 : 4 ≤ Nat.card K := (LinearPilot.four_le_card_iff_two_le hKc).2 hf
  obtain ⟨κ, hκ⟩ := exists_units_ne_one hK4
  have hWsep : ∀ c, c ≠ kOmegaA r → c ≠ kOmegaB r → ∃ w ∈ W, w c ≠ 1 := by
    intro c hca hcb
    refine ⟨_, ⟨spASepParam j κ, spASepParam_mem κ, rfl⟩, ?_⟩
    rcases c with i | i
    · have hi : i ≠ Fin.last r := fun h' => hca (by rw [h'])
      obtain ⟨i', rfl⟩ := Fin.exists_castSucc_eq.2 hi
      rw [diagSpEntry_inl, kOmegaSnoc_castSucc]
      exact fun h' => spASepParam_ne_one hκ i' (Units.val_eq_one.1 h')
    · have hi : i ≠ Fin.last r := fun h' => hcb (by rw [h'])
      obtain ⟨i', rfl⟩ := Fin.exists_castSucc_eq.2 hi
      rw [diagSpEntry_inr, kOmegaSnoc_castSucc]
      exact fun h' => spASepParam_ne_one hκ i' (inv_eq_one.1 (Units.val_eq_one.1 h'))
  have hΦT : ∀ s ∈ spATorusParam K r j,
      ((Φ (kOmegaIota hr hr3 hKc hf (diagSp K r s)) : neighbourCore e (Fin.last r)) : G) ∈ T₀ := by
    intro s hs
    rw [hN1, fieldSp_diagSp, coe_complSpEquiv_apply, spEmbed_last_diagSp]
    exact (mem_modelToG e).2 ⟨_, ⟨_, snoc_mem_spATorusParam hjr (map_mem_spATorusParam σ hs),
      rfl⟩, rfl⟩
  have hPC : P ≤ kOmegaTorusCent r W := by
    rintro _ ⟨_, ⟨z, hz, rfl⟩, rfl⟩
    refine ⟨(Φ.symm z).2, ?_⟩
    rintro _ ⟨s, hs, rfl⟩
    have hzT := mem_centralizer_iff.1 (hHC hz) _ (hΦT s hs)
    set d := kOmegaIota hr hr3 hKc hf (diagSp K r s) with hd
    have hcomm : Φ.symm z * d = d * Φ.symm z := by
      apply Φ.injective
      rw [map_mul, map_mul, MulEquiv.apply_symm_apply]
      exact Subtype.ext hzT.symm
    have hdM : (((d : StatedOmega (StatedQuadPlus (r + 1) K)) : GL (Fin (r + 1) ⊕ Fin (r + 1)) K) :
        Matrix (Fin (r + 1) ⊕ Fin (r + 1)) (Fin (r + 1) ⊕ Fin (r + 1)) K) =
        Matrix.diagonal (diagSpEntry (kOmegaSnoc K s)) := by
      rw [hd, coe_kOmegaIota_diagSp, diagOmega_coe]
    have e1 := congrArg (fun y : StatedOmega (StatedQuadPlus (r + 1) K) =>
      (((y : GL (Fin (r + 1) ⊕ Fin (r + 1)) K)) :
        Matrix (Fin (r + 1) ⊕ Fin (r + 1)) (Fin (r + 1) ⊕ Fin (r + 1)) K)) hcomm
    simp only [Subgroup.coe_mul, Units.val_mul] at e1
    rw [hdM] at e1
    exact e1
  intro x hx
  have hxE := hHE hx
  set g : StatedOmega (StatedQuadPlus (r + 1) K) := Φ.symm ⟨x, hxE⟩ with hg
  have hgP : (g : GL (Fin (r + 1) ⊕ Fin (r + 1)) K) ∈ P :=
    ⟨g, ⟨⟨x, hxE⟩, show x ∈ H from hx, rfl⟩, rfl⟩
  have hgv := kOmega_mulVec_vec_of_perfect hW1 hWsep hPC hPperf hgP
  have hgfix : g ∈ fixedSubgroup (kOmegaBetaC K r) :=
    (mem_fixedSubgroup_kOmegaBetaC_iff K hr g).2 hgv
  have hβ : kOmegaBetaC K r g = g := hgfix
  have h3 := hN3 g
  rw [hβ, hg, MulEquiv.apply_symm_apply] at h3
  rw [mem_centralizer_singleton_iff]
  calc x * t = t * x * t⁻¹ * t := by rw [h3]
    _ = t * x := by group

theorem spOmegaBTorusInput_omegaPlus : SpOmegaBTorusInput .omegaPlus := by
  intro G _ _ L hset n f K _ _ _ hn hKc hf e t ht hKt hroot _ j _ hjn
  obtain ⟨r, rfl⟩ : ∃ r, n = r + 1 := ⟨n - 1, by omega⟩
  have htC : t ∈ centralizer (L : Set G) := LinearPilot.mem_centralizer_of_inf_eq_zpowers hKt
  exact centralizerPerfectCore_spATorus_le_omegaPlus hset hKc hf (by omega) e htC ht
    (hroot (Fin.last r)) (by omega)

end Global

