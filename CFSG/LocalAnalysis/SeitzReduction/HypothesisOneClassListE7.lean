theorem classListE7_check :
    frameWalkCheck .E7 classListE7Casc classListE7Targets classListE7Walks = true := by
  decide +kernel

theorem classListE7Casc_map :
    classListE7Casc.map Tag.E7.rootCertificate.root = cascadeRoots .E7 := by
  apply List.map_injective_iff.2 List.ofFn_injective
  decide +kernel

theorem classListE7Targets_map :
    classListE7Targets.map (List.map Tag.E7.rootCertificate.root) = classListE7Reps := by
  apply List.map_injective_iff.2 (List.map_injective_iff.2 List.ofFn_injective)
  decide +kernel

variable {K : Type} [Field K]

theorem classListE7_walks [CharP K 2] (S : List (Fin Tag.E7.rank → ℤ))
    (hS : S.Sublist (cascadeRoots .E7)) (hne : S ≠ []) :
    ∃ T ∈ classListE7Reps, FrameProdConj .E7 K S T := by
  rw [← classListE7Casc_map] at hS
  obtain ⟨Sp, hSp, rfl⟩ := List.sublist_map_iff.1 hS
  have hne' : Sp ≠ [] := by
    rintro rfl
    exact hne rfl
  have horth : (classListE7Casc.map Tag.E7.rootCertificate.root).Pairwise
      fun σ σ' => iform σ σ' = 0 := by
    rw [classListE7Casc_map]
    exact frameWalkCascade_pairwise (Or.inr (Or.inr (Or.inl rfl)))
  obtain ⟨T, hT, hc⟩ :=
    frameWalkCheck_sound (K := K) (Or.inr (Or.inr (Or.inl rfl))) classListE7_check horth hSp hne'
  refine ⟨T.map Tag.E7.rootCertificate.root, ?_, hc⟩
  rw [← classListE7Targets_map]
  exact List.mem_map_of_mem hT

theorem classListE7Reps_mem (T : List (Fin Tag.E7.rank → ℤ)) (hT : T ∈ classListE7Reps) :
    (⟨(T.map fun σ => pinnedX .E7 K σ 1).prod, list_prod_map_pinnedX_mem_adjointGroup T⟩ :
      adjointGroup .E7 K) ∈ innerRepsE7 K := by
  simp only [classListE7Reps, List.mem_cons, List.not_mem_nil, or_false] at hT
  simp only [innerRepsE7, Set.mem_insert_iff, Set.mem_singleton_iff]
  rcases hT with rfl | rfl | rfl | rfl | rfl
  · exact Or.inl (Subtype.ext (by simp))
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))

theorem exists_conj_mem_innerRepsE7 [Finite K] [CharP K 2] {t : adjointGroup .E7 K}
    (ht2 : t ^ 2 = 1) (ht1 : t ≠ 1) : ∃ g : adjointGroup .E7 K, g * t * g⁻¹ ∈ innerRepsE7 K :=
  exists_conj_mem_of_frame_walks (Or.inr (Or.inr (Or.inl rfl))) classListE7_walks
    classListE7Reps_mem ht2 ht1

theorem classListE7_hrep [Finite K] [CharP K 2] :
    ∀ t : adjointGroup .E7 K, orderOf (MulAut.conj t) = 2 →
      ∃ ψ : MulAut (adjointGroup .E7 K), ∃ s ∈ innerRepsE7 K, ψ s = t :=
  exists_mulAut_eq_of_frame_walks (Or.inr (Or.inr (Or.inl rfl))) classListE7_walks
    classListE7Reps_mem

theorem innerInvolutionInput_E7 [Finite K] [CharP K 2] :
    InnerInvolutionInput (adjointGroup .E7 K) :=
  innerInvolutionInput_E7_of_classes classListE7_hrep

theorem innerInvolutionInput_E7' {f : ℕ} (hf : 1 ≤ f) (hK : Nat.card K = 2 ^ f) :
    InnerInvolutionInput (adjointGroup .E7 K) := by
  have : Finite K := Nat.finite_of_card_ne_zero (by rw [hK]; positivity)
  have : CharP K 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two hf hK
  exact innerInvolutionInput_E7

