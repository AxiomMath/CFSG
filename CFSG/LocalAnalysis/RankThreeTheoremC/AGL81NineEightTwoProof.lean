variable {Y : Type} [Group Y] [Finite Y] {p : ℕ}

theorem map_conj_map_subtype {K : Subgroup Y} [K.Normal] (B : Subgroup K) (g : Y) :
    (B.map K.subtype).map (MulAut.conj g).toMonoidHom =
      (B.map (MulAut.conjNormal (H := K) g).toMonoidHom).map K.subtype := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1

theorem le_centralizer_of_prod
    {K : Subgroup Y} [K.Normal] {A : Type} [Group A] (hA : IsCaseTwoGroup p A) (e : K ≃* A × A)
    (T : Sylow p K) {U : Subgroup Y} (hU : IsPGroup 2 U)
    (hTU : ∀ t ∈ (T : Subgroup K), (t : Y) ∈ Subgroup.normalizer (U : Set Y)) :
    U ≤ Subgroup.centralizer (K : Set Y) := by
  classical
  have hNo2 : KFactCaseTwoNoTwo := kFactCaseTwoNoTwo
  haveI : Finite A := Finite.of_injective (fun a => e.symm (a, 1)) fun a b h => by
    simpa using congrArg Prod.fst (e.symm.injective h)
  haveI hAs : IsSimpleGroup A := RankOneSylow.isSimpleGroup_of_isCaseTwoGroup hA
  have hp : p.Prime := by
    rcases RankOneSylow.eq_three_or_five_of_isCaseTwoGroup hA with rfl | rfl
    · exact Nat.prime_three
    · exact Nat.prime_five
  haveI : Fact p.Prime := ⟨hp⟩
  have hsq : ∀ (B : Type) [Group B] [Finite B], IsCaseTwoGroup p B → ∀ R : Sylow p B,
      p ^ 2 ∣ Nat.card R := by
    intro B _ _ hB R
    have hle := kFactCaseTwoSylow p B hB R
    obtain ⟨k, hk⟩ := (IsPGroup.iff_card.mp R.isPGroup')
    rw [hk] at hle ⊢
    exact pow_dvd_pow p (by
      by_contra h
      push Not at h
      have : p ^ k < p ^ 2 := Nat.pow_lt_pow_right hp.one_lt h
      omega)
  obtain ⟨RA⟩ : Nonempty (Sylow p A) := inferInstance
  have hnab : ∃ a b : A, a * b ≠ b * a :=
    nonabelian_of_simple_of_sq_dvd hp ((hsq A hA RA).trans (Subgroup.card_subgroup_dvd_card (RA : Subgroup A)))
  have hA1 : 1 < Nat.card A := by
    obtain ⟨a, b, hab⟩ := hnab
    haveI : Nontrivial A := ⟨⟨a * b, b * a, hab⟩⟩
    exact Finite.one_lt_card
  set B₁ : Subgroup K := ((⊤ : Subgroup A).prod ⊥).comap e.toMonoidHom with hB₁
  set B₂ : Subgroup K := ((⊥ : Subgroup A).prod ⊤).comap e.toMonoidHom with hB₂
  have mem₁ : ∀ x : K, x ∈ B₁ ↔ (e x).2 = 1 := fun x => by
    simp [hB₁, Subgroup.mem_prod]
  have mem₂ : ∀ x : K, x ∈ B₂ ↔ (e x).1 = 1 := fun x => by
    simp [hB₂, Subgroup.mem_prod]
  haveI : B₁.Normal := Subgroup.Normal.comap inferInstance _
  haveI : B₂.Normal := Subgroup.Normal.comap inferInstance _
  have equiv₁ : Nonempty (B₁ ≃* A) := by
    refine ⟨MulEquiv.ofBijective ((MonoidHom.fst A A).comp (e.toMonoidHom.comp B₁.subtype))
      ⟨fun x y hxy => ?_, fun a => ⟨⟨e.symm (a, 1), (mem₁ _).2 (by simp)⟩, by simp⟩⟩⟩
    have h1 : (e x).2 = (e y).2 := by rw [(mem₁ x).1 x.2, (mem₁ y).1 y.2]
    have h2 : (e x).1 = (e y).1 := by simpa using hxy
    exact Subtype.ext (e.injective (Prod.ext h2 h1))
  have equiv₂ : Nonempty (B₂ ≃* A) := by
    refine ⟨MulEquiv.ofBijective ((MonoidHom.snd A A).comp (e.toMonoidHom.comp B₂.subtype))
      ⟨fun x y hxy => ?_, fun a => ⟨⟨e.symm (1, a), (mem₂ _).2 (by simp)⟩, by simp⟩⟩⟩
    have h1 : (e x).1 = (e y).1 := by rw [(mem₂ x).1 x.2, (mem₂ y).1 y.2]
    have h2 : (e x).2 = (e y).2 := by simpa using hxy
    exact Subtype.ext (e.injective (Prod.ext h1 h2))
  have card₁ : Nat.card B₁ = Nat.card A := Nat.card_congr equiv₁.some.toEquiv
  have card₂ : Nat.card B₂ = Nat.card A := Nat.card_congr equiv₂.some.toEquiv
  have cardK : Nat.card K = Nat.card A * Nat.card A := by
    rw [Nat.card_congr e.toEquiv, Nat.card_prod]
  have normal_cases : ∀ N : Subgroup K, N.Normal → Nat.card N = Nat.card A → N = B₁ ∨ N = B₂ := by
    intro N hN hc
    haveI : (N.map e.toMonoidHom).Normal := hN.map _ e.surjective
    have hNe : N = (N.map e.toMonoidHom).comap e.toMonoidHom :=
      (Subgroup.comap_map_eq_self_of_injective e.injective N).symm
    rcases CFSG.EvenSporadicStandard.HSStd.Zassenhaus.PartA.normal_prod_cases hnab
        (N.map e.toMonoidHom) with h | h | h | h
    · exfalso
      rw [h, MonoidHom.comap_bot, (MonoidHom.ker_eq_bot_iff _).mpr e.injective] at hNe
      rw [hNe, Subgroup.card_bot] at hc
      omega
    · exfalso
      rw [h, Subgroup.comap_top] at hNe
      rw [hNe, Subgroup.card_top, cardK] at hc
      have : Nat.card A * 1 < Nat.card A * Nat.card A :=
        Nat.mul_lt_mul_of_pos_left hA1 (by omega)
      omega
    · left
      rw [hNe, h]
    · right
      rw [hNe, h]
  set L₁ : Subgroup Y := B₁.map K.subtype with hL₁
  set L₂ : Subgroup Y := B₂.map K.subtype with hL₂
  have eL₁ : Nonempty (L₁ ≃* A) :=
    ⟨(B₁.equivMapOfInjective K.subtype K.subtype_injective).symm.trans equiv₁.some⟩
  have eL₂ : Nonempty (L₂ ≃* A) :=
    ⟨(B₂.equivMapOfInjective K.subtype K.subtype_injective).symm.trans equiv₂.some⟩
  have hcase : ∀ L : Subgroup Y, Nonempty (L ≃* A) → IsCaseTwoGroup p L := by
    intro L ⟨f⟩
    obtain ⟨d, hd, ⟨g⟩⟩ := hA
    exact ⟨d, hd, ⟨f.trans g⟩⟩
  have hcenter : ∀ L : Subgroup Y, Nonempty (L ≃* A) → Subgroup.center L = ⊥ := by
    intro L ⟨f⟩
    haveI : IsSimpleGroup L := f.isSimpleGroup
    refine center_bot_of_simple_nonab ?_
    obtain ⟨a, b, hab⟩ := hnab
    exact ⟨f.symm a, f.symm b, fun h => hab (by simpa using congrArg f h)⟩
  have hconj : ∀ (B : Subgroup K), B.Normal → Nat.card B = Nat.card A → ∀ g : Y,
      (B.map K.subtype).map (MulAut.conj g).toMonoidHom = L₁ ∨
        (B.map K.subtype).map (MulAut.conj g).toMonoidHom = L₂ := by
    intro B hB hcB g
    rw [map_conj_map_subtype]
    have hN : (B.map (MulAut.conjNormal (H := K) g).toMonoidHom).Normal :=
      hB.map _ (MulAut.conjNormal (H := K) g).surjective
    have hc : Nat.card (B.map (MulAut.conjNormal (H := K) g).toMonoidHom) = Nat.card A := by
      rw [Subgroup.card_map_of_injective (f := (MulAut.conjNormal (H := K) g).toMonoidHom)
        (MulAut.conjNormal (H := K) g).injective, hcB]
    rcases normal_cases _ hN hc with h | h
    · left; rw [h]
    · right; rw [h]
  have hcomm : ∀ x ∈ B₁, ∀ y ∈ B₂, x * y = y * x := by
    intro x hx y hy
    apply e.injective
    rw [map_mul, map_mul]
    ext
    · simp [(mem₂ y).1 hy]
    · simp [(mem₁ x).1 hx]
  have comm₁₂ : L₂ ≤ Subgroup.centralizer (L₁ : Set Y) := by
    rintro _ ⟨y, hy, rfl⟩
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨x, hx, rfl⟩
    simp only [Subgroup.coe_subtype]
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, hcomm x hx y hy]
  have comm₂₁ : L₁ ≤ Subgroup.centralizer (L₂ : Set Y) := by
    rintro _ ⟨x, hx, rfl⟩
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨y, hy, rfl⟩
    simp only [Subgroup.coe_subtype]
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, hcomm x hx y hy]
  have hel : ∀ (B : Subgroup K), B.Normal → Nonempty (B ≃* A) →
      ∃ t : K, t ∈ (T : Subgroup K) ∧ t ∈ B ∧ orderOf t = p := by
    intro B hB hBA
    obtain ⟨R, hR⟩ := CFSG.HardMathSupport.Solomon.Coordinator.exists_sylow_inf_normal T B
    have hBc : IsCaseTwoGroup p B := by
      obtain ⟨f⟩ := hBA
      obtain ⟨d, hd, ⟨g⟩⟩ := hA
      exact ⟨d, hd, ⟨f.trans g⟩⟩
    have hdvd : p ∣ Nat.card R := (dvd_pow_self p two_ne_zero).trans (hsq B hBc R)
    obtain ⟨r, hr⟩ := exists_prime_orderOf_dvd_card' (G := R) p hdvd
    have hmem : ((r : B) : K) ∈ (R : Subgroup B).map B.subtype := ⟨r, r.2, rfl⟩
    rw [hR] at hmem
    refine ⟨((r : B) : K), hmem.1, hmem.2, ?_⟩
    rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe, hr]
  have key : ∀ (B B' : Subgroup K), B.Normal → Nonempty (B ≃* A) → Nat.card B = Nat.card A →
      ((B.map K.subtype = L₁ ∧ B'.map K.subtype = L₂) ∨
        (B.map K.subtype = L₂ ∧ B'.map K.subtype = L₁)) →
      B'.map K.subtype ≤ Subgroup.centralizer ((B.map K.subtype : Subgroup Y) : Set Y) →
      U ≤ Subgroup.centralizer ((B.map K.subtype : Subgroup Y) : Set Y) := by
    intro B B' hB hBA hcB hLL hcomm'
    obtain ⟨t, htT, htB, htp⟩ := hel B hB hBA
    have htL : (t : Y) ∈ B.map K.subtype := ⟨t, htB, rfl⟩
    have htp' : orderOf (t : Y) = p := by rw [Subgroup.orderOf_coe, htp]
    have hBA' : Nonempty (B.map K.subtype ≃* A) :=
      ⟨(B.equivMapOfInjective K.subtype K.subtype_injective).symm.trans hBA.some⟩
    have hconj' : ∀ g : Y, (B.map K.subtype).map (MulAut.conj g).toMonoidHom = B.map K.subtype ∨
        (B.map K.subtype).map (MulAut.conj g).toMonoidHom = B'.map K.subtype := by
      intro g
      rcases hLL with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · rw [h1, h2]
        simpa [h1] using hconj B hB hcB g
      · rw [h1, h2]
        simpa [h1, or_comm] using hconj B hB hcB g
    have hUN := le_normalizer_of_two hNo2 hp hconj' hcomm' (hcenter _ hBA') (hcase _ hBA') hU htL
      htp' (hTU t htT)
    exact le_centralizer_of_noTwo hNo2 (hcase _ hBA') hU hUN htL htp' (hTU t htT)
  have hU₁ : U ≤ Subgroup.centralizer (L₁ : Set Y) :=
    key B₁ B₂ inferInstance equiv₁ card₁ (Or.inl ⟨rfl, rfl⟩) comm₁₂
  have hU₂ : U ≤ Subgroup.centralizer (L₂ : Set Y) :=
    key B₂ B₁ inferInstance equiv₂ card₂ (Or.inr ⟨rfl, rfl⟩) comm₂₁
  have hsup : B₁ ⊔ B₂ = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    have hx : x = e.symm ((e x).1, 1) * e.symm (1, (e x).2) := by
      apply e.injective
      simp
    rw [hx]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left ((mem₁ _).2 (by simp)))
      (Subgroup.mem_sup_right ((mem₂ _).2 (by simp)))
  have hKL : K = L₁ ⊔ L₂ := by
    rw [hL₁, hL₂, ← Subgroup.map_sup, hsup, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [Subgroup.le_centralizer_iff, hKL]
  exact sup_le (Subgroup.le_centralizer_iff.mp hU₁) (Subgroup.le_centralizer_iff.mp hU₂)

end Product

@[expose] def KFactNineThreeNoTwo : Prop :=
  ∀ (p : ℕ) (X : Type) [Group X] [Finite X] (K : Subgroup X), K.Normal → p.Prime → p ≠ 2 →
    (∃ i : TauCeti.CFSGIndex, IsNineThreeIndex p i ∧ Nonempty (K ≃* i.Group)) →
    ¬ (p = 3 ∧ IsLinThreeFour K) → ∀ T : Sylow p K, ∀ S : Subgroup X, IsPGroup 2 S →
      (T : Subgroup K).map K.subtype ≤ Subgroup.normalizer (S : Set X) →
      S ≤ Subgroup.centralizer (K : Set X)

theorem le_centralizer_of_nineThreeList
    (hK : KFactNineThreeNoTwo) {X : Type} [Group X] [Finite X] {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) {K : Subgroup X} [K.Normal] (hlist : NineThreeListGroup p K)
    (hL34 : ¬ (p = 3 ∧ IsLinThreeFour K)) (T : Sylow p K) {S : Subgroup X} (hS : IsPGroup 2 S)
    (hTS : (T : Subgroup K).map K.subtype ≤ Subgroup.normalizer (S : Set X)) :
    S ≤ Subgroup.centralizer (K : Set X) := by
  rcases hlist with hsimple | ⟨d, hd, ⟨e⟩⟩
  · exact hK p X K inferInstance hp hp2 hsimple hL34 T S hS hTS
  · exact le_centralizer_of_prod (p := p) ⟨d, hd, ⟨MulEquiv.refl _⟩⟩ e T hS
      fun t ht => hTS ⟨t, ht, rfl⟩

variable {G : Type} [Group G] [Finite G]

theorem agl81NineEightTwo_of
    (h9 : AGL81NineCompetitorQ G) (hK : KFactNineThreeNoTwo) : AGL81NineEightTwo G := by
  intro hS p P M H₁ R₁ he H Q hQ hQH hH hHM hsyl
  by_cases hc : ∃ L : Subgroup (H ⧸ primeComplementCore (G := H) p), IsComponentOf L ⊤ ∧
      ¬ L ≤ d1X0 p M H
  swap
  ·
    left
    have hbot : d1KBar p M H = ⊥ := by
      by_contra h
      exact hc (exists_component_of_d1KBar_ne_bot h)
    rw [hbot]
    refine b3_of_img Q fun S _ _ _ x _ => ?_
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Subgroup.coe_bot, Set.mem_singleton_iff] at hy
    rw [hy, one_mul, mul_one]
