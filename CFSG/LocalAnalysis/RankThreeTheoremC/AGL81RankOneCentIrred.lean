section Basic

variable {K : Type*} [Group K]

@[expose] def IrredAt (p : ℕ) (S : Subgroup K) : Prop :=
  (∀ V : Subgroup K, V ≤ S → ¬ V ≤ (frattini ↥S).map S.subtype →
      normalizer (S : Set K) ≤ normalizer (V : Set K) → V = S) ∧
    (∀ V : Subgroup K, V ≠ ⊥ → (∀ v ∈ V, v ∈ S ∧ v ^ p = 1 ∧ ∀ s ∈ S, v * s = s * v) →
      normalizer (S : Set K) ≤ normalizer (V : Set K) →
        ∀ x ∈ S, x ^ p = 1 → (∀ s ∈ S, x * s = s * x) → x ∈ V)

@[expose] def zOf (S : Subgroup K) : Subgroup K := (center ↥S).map S.subtype

theorem mem_zOf_iff {S : Subgroup K} {x : K} :
    x ∈ zOf S ↔ x ∈ S ∧ ∀ s ∈ S, x * s = s * x := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.2, fun s hs => congrArg Subtype.val ((mem_center_iff.1 hy) ⟨s, hs⟩).symm⟩
  · rintro ⟨hx, h⟩
    exact ⟨⟨x, hx⟩, mem_center_iff.2 fun g => Subtype.ext (h g g.2).symm, rfl⟩

theorem zOf_eq_inf_centralizer (S : Subgroup K) : zOf S = S ⊓ centralizer (S : Set K) := by
  ext x
  rw [mem_zOf_iff, mem_inf, mem_centralizer_iff]
  exact and_congr_right fun _ => forall₂_congr fun s _ => eq_comm

theorem zOf_le (S : Subgroup K) : zOf S ≤ S := Subgroup.map_subtype_le _

theorem normalizer_le_normalizer_zOf (S : Subgroup K) :
    normalizer (S : Set K) ≤ normalizer (zOf S : Set K) := by
  intro n hn
  have key : ∀ m ∈ normalizer (S : Set K), ∀ x ∈ zOf S, m * x * m⁻¹ ∈ zOf S := by
    intro m hm x hx
    rw [mem_zOf_iff] at hx ⊢
    refine ⟨(mem_normalizer_iff.1 hm x).1 hx.1, fun s hs => ?_⟩
    have hs' : m⁻¹ * s * m ∈ S := by
      have := (mem_normalizer_iff.1 (inv_mem hm) s).1 hs
      simpa using this
    calc m * x * m⁻¹ * s = m * (x * (m⁻¹ * s * m)) * m⁻¹ := by group
      _ = m * ((m⁻¹ * s * m) * x) * m⁻¹ := by rw [hx.2 _ hs']
      _ = s * (m * x * m⁻¹) := by group
  rw [mem_normalizer_iff]
  intro x
  refine ⟨key n hn x, fun hx => ?_⟩
  have := key n⁻¹ (inv_mem hn) _ hx
  rwa [show n⁻¹ * (n * x * n⁻¹) * n⁻¹⁻¹ = x by group] at this

@[expose] def NormIrr (S : Subgroup K) : Prop :=
  ∀ V : Subgroup K, V ≤ S → V ≠ ⊥ → normalizer (S : Set K) ≤ normalizer (V : Set K) → V = S

theorem irredAt_of_normIrred {p : ℕ} {S : Subgroup K} (h : NormIrr S) : IrredAt p S := by
  refine ⟨fun V hVS hVΦ hN => h V hVS ?_ hN, fun V hV1 hV hN x hxS _ _ => ?_⟩
  · rintro rfl
    exact hVΦ bot_le
  · have hVS : V ≤ S := fun v hv => (hV v hv).1
    rw [h V hVS hV1 hN]
    exact hxS

theorem normIrr_of_transitive {S : Subgroup K}
    (h : ∀ a ∈ S, a ≠ 1 → ∀ b ∈ S, b ≠ 1 → ∃ n ∈ normalizer (S : Set K), n * a * n⁻¹ = b) :
    NormIrr S := by
  intro V hVS hV1 hN
  refine le_antisymm hVS fun x hx => ?_
  obtain ⟨⟨v, hvV⟩, hv1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hV1
  by_cases hx1 : x = 1
  · rw [hx1]
    exact V.one_mem
  · obtain ⟨n, hn, hnv⟩ := h v (hVS hvV) (fun h => hv1 (Subtype.ext h)) x hx hx1
    rw [← hnv]
    exact (mem_normalizer_iff.1 (hN hn) v).1 hvV

end Basic

section Transport

variable {K M : Type*} [Group K] [Group M]

theorem normIrr_of_equiv (φ : K ≃* M) {S : Subgroup K} (h : NormIrr (S.map φ.toMonoidHom)) :
    NormIrr S := by
  intro V hVS hV1 hVn
  have hV : V.map φ.toMonoidHom = S.map φ.toMonoidHom := by
    refine h _ (Subgroup.map_mono hVS) ?_ ?_
    · exact fun h0 =>
        hV1 ((Subgroup.map_eq_bot_iff_of_injective V (f := φ.toMonoidHom) φ.injective).mp h0)
    · rw [← Subgroup.map_equiv_normalizer_eq, ← Subgroup.map_equiv_normalizer_eq]
      exact Subgroup.map_mono hVn
  exact Subgroup.map_injective φ.injective hV

theorem normIrr_sylow_of_equiv {p : ℕ} [Fact p.Prime] [Finite K] (e : K ≃* M)
    (h : ∀ T : Sylow p M, NormIrr (T : Subgroup M)) (S : Sylow p K) :
    NormIrr (S : Subgroup K) :=
  normIrr_of_equiv e (h (S.mapSurjective (f := e.toMonoidHom) e.surjective))

end Transport

section Cyclic

variable {p : ℕ} [hp : Fact p.Prime]

theorem le_of_isCoatom_of_cyclic {G : Type*} [Group G] [Finite G] [IsCyclic G]
    (hG : Nat.card G = p ^ 2) {W M : Subgroup G} (hW : W ≠ ⊤) (hM : IsCoatom M) : W ≤ M := by
  have hP : IsPGroup p G := IsPGroup.of_card hG
  haveI := hP.isNilpotent
  have hidx : M.index = p := hP.isCoatom_iff_index_eq_prime.1 hM
  have hMcard : Nat.card M = p := by
    have h := M.card_mul_index
    rw [hidx, hG] at h
    exact Nat.eq_of_mul_eq_mul_right hp.out.pos (h.trans (by ring))
  have hdvd : Nat.card W ∣ p ^ 2 := hG ▸ W.card_subgroup_dvd_card
  obtain ⟨k, hk, hWk⟩ := (Nat.dvd_prime_pow hp.out).1 hdvd
  have hk2 : k ≠ 2 := by
    rintro rfl
    exact hW (W.eq_top_of_card_eq (hWk.trans hG.symm))
  interval_cases k
  · rw [W.eq_bot_of_card_eq (by simpa using hWk)]
    exact bot_le
  · exact (IsCyclic.subgroup_eq_iff_card_eq.2 (by rw [hMcard]; simpa using hWk)).le
  · exact absurd rfl hk2

theorem le_frattini_of_cyclic {G : Type*} [Group G] [Finite G] [IsCyclic G]
    (hG : Nat.card G = p ^ 2) {W : Subgroup G} (hW : W ≠ ⊤) : W ≤ frattini G := by
  unfold frattini Order.radical
  simp only [Set.mem_setOf_eq, le_iInf_iff]
  exact fun M hM => le_of_isCoatom_of_cyclic hG hW hM

variable {K : Type*} [Group K] [Finite K]

theorem irredAt_of_cyclic {S : Subgroup K} [IsCyclic S] (hS : Nat.card S = p ^ 2) :
    IrredAt p S := by
  refine ⟨fun V hVS hVΦ _ => ?_, fun V hV1 hV _ x hxS hxp _ => ?_⟩
  · by_contra hne
    apply hVΦ
    have hV' : V.subgroupOf S ≠ ⊤ := fun h => hne (le_antisymm hVS (subgroupOf_eq_top.1 h))
    have := Subgroup.map_mono (f := S.subtype) (le_frattini_of_cyclic hS hV')
    rwa [subgroupOf_map_subtype, inf_of_le_left hVS] at this
  · obtain ⟨⟨v, hvV⟩, hv1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hV1
    obtain ⟨hvS, hvp, -⟩ := hV v hvV
    by_cases hx1 : x = 1
    · rw [hx1]
      exact V.one_mem
    · let v' : S := ⟨v, hvS⟩
      let x' : S := ⟨x, hxS⟩
      have hv1' : v ≠ 1 := fun h => hv1 (Subtype.ext h)
      have hv'1 : v' ≠ 1 := fun h => hv1' (congrArg Subtype.val h)
      have hx'1 : x' ≠ 1 := fun h => hx1 (congrArg Subtype.val h)
      have hv'o : orderOf v' = p := orderOf_eq_prime (Subtype.ext hvp) hv'1
      have hx'o : orderOf x' = p := orderOf_eq_prime (Subtype.ext hxp) hx'1
      have hzp : zpowers x' = zpowers v' :=
        IsCyclic.subgroup_eq_iff_card_eq.2 (by rw [Nat.card_zpowers, Nat.card_zpowers, hv'o, hx'o])
      obtain ⟨k, hk⟩ := mem_zpowers_iff.1 (hzp ▸ mem_zpowers x' : x' ∈ zpowers v')
      have : x = v ^ k := by
        have := congrArg Subtype.val hk
        simpa [v', x'] using this.symm
      rw [this]
      exact V.zpow_mem hvV k

end Cyclic

section Heisenberg

variable {p : ℕ} [hp : Fact p.Prime] {K : Type*} [Group K] [Finite K]

theorem irredAt_of_heis {S : Subgroup K} (hS : Nat.card S = p ^ 3)
    (hnc : ∃ a ∈ S, ∃ b ∈ S, a * b ≠ b * a)
    (hirr : ∀ V : Subgroup K, V ≤ S → normalizer (S : Set K) ≤ normalizer (V : Set K) →
      V ≤ zOf S ∨ V ⊔ zOf S = S) : IrredAt p S := by
  have hnc' : ∃ a b : S, a * b ≠ b * a := by
    obtain ⟨a, ha, b, hb, hab⟩ := hnc
    exact ⟨⟨a, ha⟩, ⟨b, hb⟩, fun h => hab (congrArg Subtype.val h)⟩
  obtain ⟨hZ, hcf, -⟩ := CFSG.AGLEmbedding.center_structure_of_card_eq_pow_three (p := p) hS hnc'
  have hZΦ : zOf S ≤ (frattini ↥S).map S.subtype := Subgroup.map_mono hcf
  refine ⟨fun V hVS hVΦ hN => ?_, fun V hV1 hV hN x hxS hxp hxc => ?_⟩
  · rcases hirr V hVS hN with h | h
    · exact absurd (h.trans hZΦ) hVΦ
    · have h1 : V.subgroupOf S ⊔ center S = ⊤ := by
        apply Subgroup.map_injective S.subtype_injective
        rw [Subgroup.map_sup, subgroupOf_map_subtype, inf_of_le_left hVS, Subgroup.map_top,
          Subgroup.range_subtype]
        exact h
      have h2 : V.subgroupOf S ⊔ frattini ↥S = ⊤ :=
        top_le_iff.1 (h1 ▸ sup_le_sup_left hcf _)
      exact le_antisymm hVS (subgroupOf_eq_top.1 (frattini_nongenerating h2))
  · have hVZ : V ≤ zOf S := fun v hv => mem_zOf_iff.2 ⟨(hV v hv).1, (hV v hv).2.2⟩
    have hZcard : Nat.card (zOf S) = p := by
      rw [zOf, Subgroup.card_map_of_injective S.subtype_injective, hZ]
    have hVcard : Nat.card V = p := by
      have hd : Nat.card V ∣ p := hZcard ▸ Subgroup.card_dvd_of_le hVZ
      rcases (Nat.dvd_prime hp.out).1 hd with h | h
      · exact absurd (V.eq_bot_of_card_eq h) hV1
      · exact h
    have hVeq : V = zOf S := Subgroup.eq_of_le_of_card_ge hVZ (by rw [hZcard, hVcard])
    rw [hVeq]
    exact mem_zOf_iff.2 ⟨hxS, hxc⟩

theorem hirr_of_between {S : Subgroup K}
    (h : ∀ A : Subgroup K, zOf S ≤ A → A ≤ S →
      normalizer (S : Set K) ≤ normalizer (A : Set K) → A = zOf S ∨ A = S) :
    ∀ V : Subgroup K, V ≤ S → normalizer (S : Set K) ≤ normalizer (V : Set K) →
      V ≤ zOf S ∨ V ⊔ zOf S = S := by
  intro V hVS hN
  have hN' : normalizer (S : Set K) ≤ normalizer ((V ⊔ zOf S : Subgroup K) : Set K) :=
    fun n hn => Subgroup.inf_normalizer_le_normalizer_sup V (zOf S)
      ⟨hN hn, normalizer_le_normalizer_zOf S hn⟩
  rcases h (V ⊔ zOf S) le_sup_right (sup_le hVS (zOf_le S)) hN' with h1 | h1
  · exact Or.inl (le_sup_left.trans h1.le)
  · exact Or.inr h1

theorem hirr_of_invariant {S : Subgroup K}
    (h : ∀ V : Subgroup K, V ≤ S → V ≠ ⊥ →
      normalizer (S : Set K) ≤ normalizer (V : Set K) → V = S ∨ V = zOf S) :
    ∀ V : Subgroup K, V ≤ S → normalizer (S : Set K) ≤ normalizer (V : Set K) →
      V ≤ zOf S ∨ V ⊔ zOf S = S := by
  intro V hVS hN
  by_cases hV : V = ⊥
  · exact Or.inl (hV ▸ bot_le)
  · rcases h V hVS hV hN with h1 | h1
    · exact Or.inr (by rw [h1]; exact sup_eq_left.2 (zOf_le S))
    · exact Or.inl h1.le

end Heisenberg

section Groups

variable {K : Type} [Group K] [Finite K]

theorem irredAt_alt_six (e : K ≃* alternatingGroup (Fin 6)) (S : Sylow 3 K) :
    IrredAt 3 (S : Subgroup K) :=
  irredAt_of_normIrred (normIrr_sylow_of_equiv (p := 3) e
    (fun T V hVS hV1 hVn => Hyp111.eq_of_le_sylow_alt6 T hVS hV1 hVn) S)

theorem irredAt_psl_two {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    (e : K ≃* CFSG.AGLEmbedding.PSL2GF p 2) (S : Sylow p K) : IrredAt p (S : Subgroup K) :=
  irredAt_of_normIrred (normIrr_sylow_of_equiv (p := p) e
    (fun T => CFSG.AGLEmbedding.psl2GF_invariant hp2 T) S)

theorem irredAt_unitary {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {q : TauCeti.PrimePower}
    (hqp : q.p = p) (hq1 : q.exponent = 1) {d : TauCeti.ValidLieTypeIndex}
    (hd : d.1 = .twistedA 2 q) (e : K ≃* (TauCeti.CFSGIndex.lie d).Group) (S : Sylow p K) :
    IrredAt p (S : Subgroup K) := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hIS : CFSG.AGLEmbedding.IsSmallUnitary p K := ⟨d, ⟨q, hqp, hq1, hd⟩, ⟨e⟩⟩
  have D := CFSG.AGLEmbedding.smallRankOneData_of_isSmallUnitary hp hIS S
  have hdi : CFSG.AGLEmbedding.IsUnitaryIndex p d := ⟨q, hqp, hd⟩
  have hfe : d.1.fieldExponent = 1 := by rw [hd]; simpa using hq1
  obtain ⟨hcard, hcomm, -, -⟩ :=
    CFSG.AGLEmbedding.kFactUnitarySylowStructure K p d hp2 hdi ⟨e⟩ S
  rw [hfe, mul_one] at hcard
  refine irredAt_of_heis hcard ?_ (hirr_of_invariant fun V hVS hV1 hN => ?_)
  · by_contra hab
    push Not at hab
    have hbot : (S : Subgroup K) ⊓ centralizer ((S : Subgroup K) : Set K) = ⊥ := by
      rw [← hcomm, commutator_eq_bot_iff_le_centralizer]
      intro a ha b hb
      exact hab b hb a ha
    have hle : (S : Subgroup K) ≤ centralizer ((S : Subgroup K) : Set K) := fun a ha b hb =>
      hab b hb a ha
    rw [inf_of_le_left hle] at hbot
    have h1 : Nat.card (S : Subgroup K) = 1 := by rw [hbot]; exact Subgroup.card_bot
    rw [h1] at hcard
    have h2 : 1 < p ^ 3 := Nat.one_lt_pow (by norm_num) hp.one_lt
    omega
  · rcases D.invariant V hVS hV1 hN with h | ⟨h, -⟩
    · exact Or.inl h
    · exact Or.inr (h.trans (zOf_eq_inf_centralizer _).symm)

end Groups

end Irred

theorem kFactStepThreeIrred_holds :
    KFactStepThreeIrred := by
  intro p K _ _ hK S
  obtain ⟨i, hi, ⟨e⟩⟩ := hK
  show Irred.IrredAt p (S : Subgroup K)
  cases i with
  | cyclic _ _ => exact hi.elim
  | alternating n hn =>
    rcases hi with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Irred.irredAt_alt_six e S
    · exact Irred.irredAt_of_normIrred fun V hVS hV1 hN =>
        (Generic41Spor.a10_irred K ⟨rfl, ⟨e⟩⟩ S V hVS fun n hn a ha =>
          (Subgroup.mem_normalizer_iff.1 (hN hn) a).1 ha).resolve_left hV1
  | lie d =>
    obtain ⟨d1, hv⟩ := d
    rcases hi with ⟨rfl, ⟨q, hq1, hq2, hd⟩ | ⟨q, hq1, hq2, hd⟩ | ⟨q, hq1, hq2, hd⟩⟩ |
      ⟨rfl, ⟨q, hq1, hq2, hd⟩ | ⟨q, hq1, hq2, hd⟩ | hd | hd⟩
    ·
      exact Irred.irredAt_unitary Nat.prime_three (by norm_num) hq1 hq2 hd e S
    ·
      have hL : CFSG.AGLEmbedding.IsCaseTwoGroup 3 K :=
        ⟨⟨d1, hv⟩, Or.inl ⟨rfl, q, hq1, hq2, hd⟩, ⟨e⟩⟩
      haveI := CFSG.AGLEmbedding.l28_isCyclic_sylow_three hL S
      exact Irred.irredAt_of_cyclic (p := 3)
        (by rw [CFSG.AGLEmbedding.l28_card_sylow_three hL S]; norm_num)
    ·
      obtain rfl : d1 = .A 2 q := hd
