theorem statedClassicalModel_of_isLieOver {Y : Type} [Group Y]
    (h : IsLieOver Y (.twistedD 4) 2 1) : StatedClassicalModel Y .POmegaMinus 4 2 1 := by
  obtain ⟨d, ⟨q, hqp, hqe, hd⟩, ⟨e⟩⟩ := h
  refine TransvW.OmegaMinusEight.statedClassicalModel_omegaMinusEight d ⟨q, ?_, hd⟩ e
  rw [TauCeti.PrimePower.card_def, hqp, hqe, pow_one]

theorem exists_model {Y : Type} [Group Y] (h : IsLieOver Y (.twistedD 4) 2 1) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (_ : CharP K 2) (b c : K), Nat.card K = 2 ∧
      (∀ t : K, t ^ 2 + b * t + c ≠ 0) ∧
      Nonempty (Y ≃* ↥(orthElementaryGroup (quadTail 3 (minusTailForm K b c)))) := by
  obtain ⟨⟨-, hf, hn⟩, K, hKf, hKfin, hK, b, c, hirr, ⟨e'⟩⟩ := statedClassicalModel_of_isLieOver h
  have : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hK
  refine ⟨K, hKf, hKfin, inferInstance, b, c, by simpa using hK, hirr, ?_⟩
  exact ⟨e'.trans ((LeviBlock.orthMinusStatedProjEquiv (by norm_num)).trans
    (tailOmegaEquiv (minusTailIsometry 4 K b c) (coe_quadMinus 4 K b c)
      (commutator_orthogonalGroup_quadMinus hn hirr)))⟩

theorem center_eq_bot {Y : Type} [Group Y] (h : IsLieOver Y (.twistedD 4) 2 1) :
    Subgroup.center Y = ⊥ :=
  TwelveRanksLe.center_eq_bot_of_isLieOver_twistedD h

theorem inner_of_odd {Y : Type} [Group Y] (h : IsLieOver Y (.twistedD 4) 2 1) :
    ∀ α : MulAut Y, Odd (orderOf α) → ∃ g : Y, α = MulAut.conj g := by
  obtain ⟨d, ⟨q, hqp, hqe, hd⟩, ⟨e⟩⟩ := h
  intro α hα
  refine TransvW.OmegaMinusEight.exists_conj_of_odd_orderOf_omegaMinusEight d ⟨q, ?_, hd⟩ e α hα
  rw [TauCeti.PrimePower.card_def, hqp, hqe, pow_one]

theorem exists_isElemAbelian_card_27 {Y : Type} [Group Y] [Finite Y]
    (h : IsLieOver Y (.twistedD 4) 2 1) :
    ∃ F : Subgroup Y, IsElemAbelian 3 F ∧ Nat.card F = 27 := by
  obtain ⟨F, -, hF, hcard⟩ :=
    CFSG.GH74.Uniqueness.SU.SU1.exists_isElemAbelian_of_le_pRank Nat.prime_three
      (H := (⊤ : Subgroup Y)) (TwelveRanksLe.three_le_pRank_of_isLieOver_twistedD h)
  exact ⟨F, hF, by rw [hcard]; norm_num⟩

theorem false_of_E27 {A : Type} [Group A] [Finite A] {Y P E : Subgroup A}
    (h : IsLieOver ↥Y (.twistedD 4) 2 1) (hP : IsParabolicTwo Y P)
    (h9 : ∀ T : Subgroup A, T ≤ P → IsPGroup 3 T → Nat.card T ≤ 9)
    (hE : IsElemAbelian 3 E) (hE27 : Nat.card E = 27) (hEY : E ≤ normalizer (Y : Set A))
    (hEP : E ≤ normalizer (P : Set A)) (hrk : Open.pRank 3 (Y ⊔ E) ≤ 3) : False := by
  obtain ⟨F, hF, hF27⟩ := exists_isElemAbelian_card_27 h
  refine U42O8.false_of_card_le_nine (F := F.map Y.subtype) (center_eq_bot h) (inner_of_odd h)
    hP h9 hE hE27 hEY hEP (Subgroup.map_subtype_le F)
    (CFSG.SectionRank.isElemAbelian_map hF _) ?_ hrk
  rw [Subgroup.card_map_of_injective Y.subtype_injective, hF27]

