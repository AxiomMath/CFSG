theorem mem_e9 {x : Perm (Fin 7)} : x ∈ e9 ↔ ∃ i < 3, ∃ j < 3, x = c1 ^ i * c2 ^ j := by
  unfold e9
  rw [List.mem_flatMap]
  constructor
  · rintro ⟨i, hi, hx⟩
    obtain ⟨j, hj, hjx⟩ := List.mem_map.mp hx
    exact ⟨i, List.mem_range.mp hi, j, List.mem_range.mp hj, by rw [← hjx, tab_eq]⟩
  · rintro ⟨i, hi, j, hj, rfl⟩
    exact ⟨i, List.mem_range.mpr hi, List.mem_map.mpr ⟨j, List.mem_range.mpr hj, tab_eq _⟩⟩

theorem c1_mem_e9 : c1 ∈ e9 := mem_e9.mpr ⟨1, by norm_num, 0, by norm_num, by simp⟩

theorem c2_mem_e9 : c2 ∈ e9 := mem_e9.mpr ⟨0, by norm_num, 1, by norm_num, by simp⟩

theorem orderOf_c1 : orderOf c1 = 3 :=
  orderOf_eq_prime (by decide) (by decide)

theorem orderOf_c2 : orderOf c2 = 3 :=
  orderOf_eq_prime (by decide) (by decide)

theorem pow_sixteen_of_isPGroup {T : Subgroup (Perm (Fin 7))} (hT : IsPGroup 2 T) {x : Perm (Fin 7)}
    (hx : x ∈ T) : x ^ 16 = 1 := by
  obtain ⟨k, hk⟩ := hT ⟨x, hx⟩
  have h1 : x ^ 2 ^ k = 1 := by
    have := congrArg Subtype.val hk
    simpa using this
  obtain ⟨m, -, hmo⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 (orderOf_dvd_of_pow_eq_one h1)
  have hc : orderOf x ∣ 5040 := by
    have := orderOf_dvd_card (x := x)
    rw [Fintype.card_perm, Fintype.card_fin] at this
    exact this
  rw [hmo] at hc
  have hm4 : m ≤ 4 := by
    by_contra h
    have h5 : 2 ^ 5 ∣ 2 ^ m := pow_dvd_pow 2 (by omega)
    have := h5.trans hc
    norm_num at this
  have h16 : orderOf x ∣ 16 := by
    rw [hmo]
    exact (pow_dvd_pow 2 hm4).trans (by norm_num)
  exact orderOf_dvd_iff_pow_eq_one.mp h16

theorem badG_eq_false {T : Subgroup (Perm (Fin 7))}
    (hT : IsPGroup 2 T) (hT1 : T ≠ ⊥) (hE : ∀ x ∈ e9, ∀ t ∈ T, x * t * x⁻¹ ∈ T)
    {g : Perm (Fin 7)} (hg : ∀ t ∈ T, g * t * g⁻¹ ∈ T) : badG g = false := by
  have hc := Certificates.certificate5175
  simp only [a7aiCheck, Bool.and_eq_true, decide_eq_true_eq, tab_eq] at hc
  obtain ⟨hA, hB⟩ := hc
  have hinv : ∀ s ∈ T, s * s = 1 → s ≠ 1 → s ∈ vInv := fun s hs hss hs1 =>
    hA s hss hs1 fun x hx y hy =>
      pow_sixteen_of_isPGroup hT (T.mul_mem (hE x hx s hs) (hE y hy s hs))
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card).1 hT
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hT1 (Subgroup.eq_bot_of_card_eq T (by simpa using hn))
  obtain ⟨t, ht⟩ := exists_prime_orderOf_dvd_card' (G := T) 2
    (by rw [hn]; exact dvd_pow_self 2 hn0)
  have ht2 : (t : Perm (Fin 7)) * t = 1 := by
    rw [← Subgroup.orderOf_coe] at ht
    rw [← pow_two, ← ht, pow_orderOf_eq_one]
  have ht1 : (t : Perm (Fin 7)) ≠ 1 := by
    intro h
    rw [← Subgroup.orderOf_coe, h, orderOf_one] at ht
    omega
  have htV := hinv t t.2 ht2 ht1
  have huT := hg t t.2
  have hu2 : g * t * g⁻¹ * (g * t * g⁻¹) = 1 := by
    calc g * t * g⁻¹ * (g * t * g⁻¹) = g * ((t : Perm (Fin 7)) * t) * g⁻¹ := by group
      _ = 1 := by rw [ht2]; group
  have hu1 : g * t * g⁻¹ ≠ 1 := by
    intro h
    apply ht1
    calc (t : Perm (Fin 7)) = g⁻¹ * (g * t * g⁻¹) * g := by group
      _ = 1 := by rw [h]; group
  have huV := hinv _ huT hu2 hu1
  by_contra hbad
  have hbad' : badG g = true := by simpa using hbad
  exact hB g hbad' t htV huV (pow_sixteen_of_isPGroup hT (T.mul_mem t.2 huT))

section Abstract

variable {N : Type*} [Group N]

@[expose] def blockAi (σ : N →* Perm (Fin 7)) (A : Subgroup N) (c : Perm (Fin 7)) : Subgroup N :=
  A ⊓ (zpowers c).comap σ

variable [Finite N] {σ : N →* Perm (Fin 7)} {A : Subgroup N}

theorem exists_mem_of_mem_e9 (he : ∀ x ∈ e9, ∃ a ∈ A, σ a = x) {c : Perm (Fin 7)} (hc : c ∈ e9) :
    ∃ a ∈ blockAi σ A c, σ a = c := by
  obtain ⟨a, ha, hac⟩ := he c hc
  refine ⟨a, ⟨ha, ?_⟩, hac⟩
  show σ a ∈ zpowers c
  rw [hac]
  exact mem_zpowers c

theorem card_blockAi (hinj : ∀ a ∈ A, σ a = 1 → a = 1) (he : ∀ x ∈ e9, ∃ a ∈ A, σ a = x)
    {c : Perm (Fin 7)} (hc : c ∈ e9) : Nat.card (blockAi σ A c) = orderOf c := by
  obtain ⟨a₀, ha₀, ha₀c⟩ := exists_mem_of_mem_e9 he hc
  let f : blockAi σ A c → zpowers c := fun a => ⟨σ a, a.2.2⟩
  have hf : Function.Bijective f := by
    refine ⟨fun a b hab => ?_, fun z => ?_⟩
    · have h : σ ((a : N) * (b : N)⁻¹) = 1 := by
        have := congrArg Subtype.val hab
        simp only [f] at this
        rw [map_mul, map_inv, this, mul_inv_cancel]
      have := hinj _ (A.mul_mem a.2.1 (A.inv_mem b.2.1)) h
      exact Subtype.ext (mul_inv_eq_one.mp this)
    · obtain ⟨k, hk⟩ := mem_zpowers_iff.mp z.2
      refine ⟨⟨a₀ ^ k, A.zpow_mem ha₀.1 k, ?_⟩, Subtype.ext ?_⟩
      · show σ (a₀ ^ k) ∈ zpowers c
        rw [map_zpow, ha₀c]
        exact zpow_mem (mem_zpowers c) k
      · simp only [f, map_zpow, ha₀c, hk]
  rw [Nat.card_eq_of_bijective f hf, Nat.card_zpowers]

theorem map_conj_blockAi_eq {S : Subgroup N}
    (hinj : ∀ a ∈ A, σ a = 1 → a = 1) (hAe : ∀ a ∈ A, σ a ∈ e9)
    (he : ∀ x ∈ e9, ∃ a ∈ A, σ a = x) (hS : IsPGroup 2 S)
    (hSA : ∀ a ∈ A, ∀ s ∈ S, a * s * a⁻¹ ∈ S) (hS1 : S.map σ ≠ ⊥)
    {c : Perm (Fin 7)} (hc : c = c1 ∨ c = c2) {y : N} (hyS : ∀ s ∈ S, y * s * y⁻¹ ∈ S)
    (hy : (blockAi σ A c).map (MulAut.conj y).toMonoidHom ≤ A) :
    (blockAi σ A c).map (MulAut.conj y).toMonoidHom = blockAi σ A c := by
  have hce : c ∈ e9 := by rcases hc with rfl | rfl; exacts [c1_mem_e9, c2_mem_e9]
  have hbad : badG (σ y) = false := by
    refine badG_eq_false (T := S.map σ) (hS.map σ) hS1 ?_ ?_
    · rintro x hx _ ⟨s, hs, rfl⟩
      obtain ⟨a, ha, rfl⟩ := he x hx
      exact ⟨a * s * a⁻¹, hSA a ha s hs, by simp⟩
    · rintro _ ⟨s, hs, rfl⟩
      exact ⟨y * s * y⁻¹, hyS s hs, by simp⟩
  obtain ⟨a₀, ha₀, ha₀c⟩ := exists_mem_of_mem_e9 he hce
  have hya : y * a₀ * y⁻¹ ∈ A := hy ⟨a₀, ha₀, by simp [MulAut.conj_apply]⟩
  have hyc : σ y * c * (σ y)⁻¹ ∈ e9 := by
    have := hAe _ hya
    rwa [map_mul, map_mul, map_inv, ha₀c] at this
  have hcz : σ y * c * (σ y)⁻¹ ∈ zpowers c := by
    have hl : σ y * c * (σ y)⁻¹ ∈ [1, c, c ^ 2] := by
      rcases hc with rfl | rfl
      · simp only [badG, Bool.or_eq_false_iff, Bool.and_eq_false_iff, Bool.not_eq_false',
          decide_eq_false_iff_not, decide_eq_true_eq] at hbad
        rcases hbad.1 with h | h
        · exact absurd hyc h
        · exact h
      · simp only [badG, Bool.or_eq_false_iff, Bool.and_eq_false_iff, Bool.not_eq_false',
          decide_eq_false_iff_not, decide_eq_true_eq] at hbad
        rcases hbad.2 with h | h
        · exact absurd hyc h
        · exact h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hl
    rcases hl with h | h | h <;> rw [h]
    · exact one_mem _
    · exact mem_zpowers c
    · exact pow_mem (mem_zpowers c) 2
  have hle : (blockAi σ A c).map (MulAut.conj y).toMonoidHom ≤ blockAi σ A c := by
    rintro _ ⟨a, ha, rfl⟩
    refine ⟨hy ⟨a, ha, rfl⟩, ?_⟩
    obtain ⟨k, hk⟩ := mem_zpowers_iff.mp (show σ a ∈ zpowers c from ha.2)
    show σ ((MulAut.conj y).toMonoidHom a) ∈ zpowers c
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_mul, map_inv, ← hk]
    have : σ y * c ^ k * (σ y)⁻¹ = (σ y * c * (σ y)⁻¹) ^ k := by
      rw [conj_zpow]
    rw [this]
    exact zpow_mem hcz k
  refine Subgroup.eq_of_le_of_card_ge hle ?_
  rw [Subgroup.card_map_of_injective (MulAut.conj y).injective]

theorem blockAi_ne (he : ∀ x ∈ e9, ∃ a ∈ A, σ a = x) : blockAi σ A c1 ≠ blockAi σ A c2 := by
  intro h
  obtain ⟨a, ha, hac⟩ := exists_mem_of_mem_e9 he c1_mem_e9
  rw [h] at ha
  have h1 : c1 ∈ zpowers c2 := by
    have : σ a ∈ zpowers c2 := ha.2
    rwa [hac] at this
  rw [mem_zpowers_iff_mem_range_orderOf, orderOf_c2] at h1
  revert h1
  decide

end Abstract

section Action

variable {G : Type} [Group G] [Finite G] (M L : Subgroup G)

abbrev nML : Subgroup G := M ⊓ normalizer (L : Set G)

@[expose] noncomputable def barOf : ↥(nML M L) →* (↥M ⧸ CFSG.pCore 2 ↥M) :=
  (QuotientGroup.mk' (CFSG.pCore 2 ↥M)).comp (Subgroup.inclusion inf_le_left)

theorem barOf_mem_normalizer (y : nML M L) :
    barOf M L y ∈ normalizer (barM M L : Set (↥M ⧸ CFSG.pCore 2 ↥M)) := by
  apply TenNineOneThree.mem_normalizer_of_conj_mem
  rintro _ ⟨m, hm, rfl⟩
  refine ⟨Subgroup.inclusion inf_le_left y * m * (Subgroup.inclusion inf_le_left y)⁻¹, ?_, ?_⟩
  · show ((Subgroup.inclusion inf_le_left y * m * (Subgroup.inclusion inf_le_left y)⁻¹ : ↥M) : G) ∈ L
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_inclusion]
    exact (Subgroup.mem_normalizer_iff.mp y.2.2 m).mp (show (m : G) ∈ L from hm)
  · simp [barOf]

@[expose] noncomputable def barN : ↥(nML M L) →*
    ↥(normalizer (barM M L : Set (↥M ⧸ CFSG.pCore 2 ↥M))) :=
  (barOf M L).codRestrict _ (barOf_mem_normalizer M L)

@[expose] noncomputable def actL : ↥(nML M L) →* MulAut ↥(barM M L) :=
  (barM M L).normalizerMonoidHom.comp (barN M L)

theorem actL_apply_coe (y : nML M L) (x : barM M L) :
    ((actL M L y x : barM M L) : ↥M ⧸ CFSG.pCore 2 ↥M) = barOf M L y * x * (barOf M L y)⁻¹ := by
  simp [actL, barN]

@[expose] noncomputable def conjEq : Perm (Fin 7) ≃* MulAut (alternatingGroup (Fin 7)) :=
  MulEquiv.ofBijective MulAut.conjNormal
    (CFSG.GroupTheory.AutAlternating.aut_alternatingGroup_bijective_conj 7 (by norm_num)
      (by norm_num))

variable {M L}

@[expose] noncomputable def actS (e : ↥(barM M L) ≃* alternatingGroup (Fin 7)) :
    ↥(nML M L) →* Perm (Fin 7) :=
  conjEq.symm.toMonoidHom.comp ((MulAut.congr e).toMonoidHom.comp (actL M L))

theorem conjEq_actS (e : ↥(barM M L) ≃* alternatingGroup (Fin 7)) (y : nML M L) :
    conjEq (actS e y) = MulAut.congr e (actL M L y) := by
  simp [actS]

theorem actS_conj (e : ↥(barM M L) ≃* alternatingGroup (Fin 7)) (y : nML M L) (x : barM M L) :
    ((e (actL M L y x) : alternatingGroup (Fin 7)) : Perm (Fin 7)) =
      actS e y * (e x : Perm (Fin 7)) * (actS e y)⁻¹ := by
  have h := congrArg (fun φ : MulAut (alternatingGroup (Fin 7)) =>
    ((φ (e x) : alternatingGroup (Fin 7)) : Perm (Fin 7))) (conjEq_actS e y)
  simp only [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_apply_apply] at h
  rw [← h]
  rfl

@[expose] noncomputable def barL (hLM : L ≤ M) {l : G} (hl : l ∈ L) : barM M L :=
  ⟨QuotientGroup.mk' (CFSG.pCore 2 ↥M) ⟨l, hLM hl⟩, ⟨⟨l, hLM hl⟩, Subgroup.mem_subgroupOf.mpr hl, rfl⟩⟩

theorem barOf_eq_barL (hLM : L ≤ M) (a : nML M L) (ha : (a : G) ∈ L) :
    barOf M L a = (barL hLM ha : ↥M ⧸ CFSG.pCore 2 ↥M) := rfl

theorem actS_of_mem (hLM : L ≤ M) (e : ↥(barM M L) ≃* alternatingGroup (Fin 7)) (a : nML M L)
    (ha : (a : G) ∈ L) : actS e a = ((e (barL hLM ha) : alternatingGroup (Fin 7)) : Perm (Fin 7)) := by
  apply conjEq.injective
  rw [conjEq_actS]
  refine MulEquiv.ext fun x => Subtype.ext ?_
  have hx : actL M L a (e.symm x) = barL hLM ha * e.symm x * (barL hLM ha)⁻¹ := by
    apply Subtype.ext
    rw [actL_apply_coe, barOf_eq_barL hLM a ha]
    rfl
  simp only [MulAut.congr_apply, MulEquiv.trans_apply, hx, map_mul, map_inv,
    MulEquiv.apply_symm_apply, conjEq, MulEquiv.ofBijective_apply, MulAut.conjNormal_apply,
    Subgroup.coe_mul, Subgroup.coe_inv]

theorem barOf_conj_of_actS_eq_one (e : ↥(barM M L) ≃* alternatingGroup (Fin 7)) {s : nML M L}
    (hs : actS e s = 1) (x : barM M L) :
    barOf M L s * x * (barOf M L s)⁻¹ = x := by
  have h := actS_conj e s x
  rw [hs, one_mul, inv_one, mul_one] at h
  have h' : actL M L s x = x := e.injective (Subtype.ext h)
  rw [← actL_apply_coe, h']

end Action

