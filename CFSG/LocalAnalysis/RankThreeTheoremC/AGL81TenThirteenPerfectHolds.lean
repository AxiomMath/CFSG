variable {G : Type} [Group G] [Finite G]

theorem agl81TenThirteenPerfect_holds
    (h31 : KFactThreeOne) (h84 : Asc81bEightFour)
    (h85 : Asc81bEightFive) (h93 : Asc81bNineThree) (hD2 : CFSG.AGLEmbeddingD2.NoXBlockFor G)
    (h984 : AGL81NineEightFour G) (h94 : AGL81NineFourCfg G) (hSp62 : AGL81TenThirteenSp62 G)
    (hSp48 : AGL81TenThirteenSp48 G) (hA10 : AGL81TenThirteenA10 G) :
    AGL81TenThirteenPerfect G := by
  have hSch : KFactCatalogSchreier := kFactCatalogSchreier_holds
  have h86 : Asc81bEightSix :=
    asc81bEightSix_of_bhs RankThreeTheoremC.bhsLocalCStar_proved
  have hGAS : CFSG.Open.GriessAllModelsStatement :=
    CFSG.Milestones.cl_lit_griess_schur_multipliers_all_models_statement
  have hZr : CFSG.AGLEmbedding.OddCenterRest :=
    CFSG.AGLEmbedding.oddCenterRest_of_griess hGAS
  have hTPLT : CFSG.AGLEmbedding.CitedBlockTransvectionPLType :=
    CFSG.HardMathSupport.Curtis.UnitaryLevi.citedBlockTransvectionPLType_holds
  have hTPL : CFSG.AGLEmbedding.CitedBlockTransvectionPL :=
    CFSG.AGLEmbedding.citedBlockTransvectionPL_of_type hTPLT
  have hA7PL : CFSG.AGLEmbedding.CitedBlockAltSevenPL :=
    CFSG.AGLEmbedding.citedBlockAltSevenPL_holds
  have hSU : CFSG.AGLEmbedding.KFactBlockNoSU38 :=
    CFSG.AGLEmbedding.kFactBlockNoSU38_of hTPL hA7PL
      (CFSG.AGLEmbedding.kFactCompParabSU38_of_families
        (CFSG.AGLEmbedding.kFactCompParabSU38On_linear hGAS)
        CFSG.AGLEmbedding.kFactCompParabSU38On_twistedA
        (CFSG.AGLEmbedding.kFactCompParabSU38On_idxB hZr)
        (CFSG.AGLEmbedding.kFactCompParabSU38On_idxD hZr)
        (CFSG.AGLEmbedding.kFactCompParabSU38On_twistedD hZr)
        (CFSG.AGLEmbedding.kFactCompParabSU38On_g2 hGAS)
        CFSG.AGLEmbedding.kFactCompParabSU38_small)
  have hB : CFSG.AGLEmbedding.KFactBlockNoL33U35L37He :=
    CFSG.AGLEmbedding.kFactBlockNoL33U35L37He_of hTPL hA7PL
      (CFSG.AGLEmbedding.kFactCompParabNoL33U35L37He_of_families
        (CFSG.AGLEmbedding.kFactCompParabNoL33U35L37HeOn_linear hGAS)
        CFSG.AGLEmbedding.kFactCompParabNoL33U35L37HeOn_twistedA
        (CFSG.AGLEmbedding.kFactCompParabNoL33U35L37HeOn_idxB hZr)
        (CFSG.AGLEmbedding.kFactCompParabNoL33U35L37HeOn_idxD hZr)
        (CFSG.AGLEmbedding.kFactCompParabNoL33U35L37HeOn_twistedD hZr)
        (CFSG.AGLEmbedding.kFactCompParabNoL33U35L37HeOn_g2 hGAS)
        CFSG.AGLEmbedding.kFactCompParabNoL33U35L37He_small)
  refine agl81TenThirteenPerfect_of h31 hSch h84 h85 h86 h93 hD2 h984 h94 hSU
    kFactG28RankNotNineFour_holds kFactG28AutCard_holds hB kFactThreeFourPairOrders_holds
    hSp62 hSp48 hA10

end CFSG.LocalAnalysis.RankThreeTheoremC.TenThirteen
