theorem map_eq_one_of_commutator_eq_top {Γ A : Type*} [Group Γ] [Group A]
    [hA : Group.IsSolvable A] (hΓ : commutator Γ = ⊤) (f : Γ →* A) (γ : Γ) : f γ = 1 := by
  obtain ⟨n, hn⟩ := hA.solvable
  have hds : ∀ m : ℕ, derivedSeries Γ m = ⊤ := by
    intro m
    induction m with
    | zero => exact derivedSeries_zero Γ
    | succ m ih => rw [derivedSeries_succ, ih]; exact hΓ
  have h1 : f γ ∈ (derivedSeries Γ n).map f :=
    Subgroup.mem_map_of_mem f (by rw [hds n]; trivial)
  have h2 := map_derivedSeries_le_derivedSeries f n h1
  rw [hn, Subgroup.mem_bot] at h2
  exact h2

theorem not_le_d1X0_of_ne_bot {p : ℕ} {M C : Subgroup G} (hne : d1KBar p M C ≠ ⊥) :
    ¬ d1KBar p M C ≤ d1X0 p M C := by
  intro hle
  apply hne
  rw [eq_bot_iff]
  have hle' := hle
  unfold d1KBar at hle' ⊢
  refine iSup₂_le fun L hL => ?_
  exact absurd ((le_iSup₂ (f := fun (L : Subgroup (C ⧸ primeComplementCore (G := C) p))
    (_ : IsComponentOf L ⊤ ∧ ¬ L ≤ d1X0 p M C) => L) L hL).trans hle') hL.2

theorem not_hasNormalPComplement_d1KBar {p : ℕ} [Fact p.Prime] {M C : Subgroup G}
    (hK1 : 1 ≤ Open.pRank p (⊤ : Subgroup ↥(d1KBar p M C))) :
    ¬ HasNormalPComplement p ↥(d1KBar p M C) := by
  have hp : p.Prime := Fact.out
  rintro ⟨N, hN, hNc, hNq⟩
  haveI := hN
  haveI : Group.IsNilpotent (↥(d1KBar p M C) ⧸ N) := hNq.isNilpotent
  have hall : ∀ k : ↥(d1KBar p M C), k ∈ N := by
    have hle : d1KBar p M C ≤ N.map (d1KBar p M C).subtype := by
      conv_lhs => unfold d1KBar
      refine iSup₂_le fun L hL => ?_
      have hLK : L ≤ d1KBar p M C := by
        unfold d1KBar
        exact le_iSup₂ (f := fun (L : Subgroup (C ⧸ primeComplementCore (G := C) p))
          (_ : IsComponentOf L ⊤ ∧ ¬ L ≤ d1X0 p M C) => L) L hL
      intro l hl
      have h1 := map_eq_one_of_commutator_eq_top hL.1.2.2.1
        ((QuotientGroup.mk' N).comp (Subgroup.inclusion hLK)) ⟨l, hl⟩
      exact ⟨_, (QuotientGroup.eq_one_iff _).mp h1, rfl⟩
    intro k
    obtain ⟨k', hk', he⟩ := hle k.2
    rwa [Subtype.ext he] at hk'
  have htop : N = ⊤ := eq_top_iff.mpr fun k _ => hall k
  obtain ⟨x, -, hxo⟩ := exists_orderOf_of_one_le_pRank hK1
  have hdvd := orderOf_dvd_natCard x
  rw [hxo] at hdvd
  rw [htop, Subgroup.card_top] at hNc
  exact (Nat.Prime.coprime_iff_not_dvd hp).mp hNc hdvd

theorem commutator_zpowers_le {L : Subgroup G} {b : G} (hbL : b ∈ Subgroup.normalizer (L : Set G))
    (h : ∀ l ∈ L, b * l * b⁻¹ * l⁻¹ ∈ pCoreOf 2 L) :
    ⁅Subgroup.zpowers b, L⁆ ≤ pCoreOf 2 L := by
  have hnL : ∀ n : ℕ, ∀ g : G, g ∈ L ↔ b ^ n * g * (b ^ n)⁻¹ ∈ L := fun n =>
    Subgroup.mem_normalizer_iff.mp (Subgroup.pow_mem _ hbL n)
  have hpow : ∀ n : ℕ, ∀ l ∈ L, b ^ n * l * (b ^ n)⁻¹ * l⁻¹ ∈ pCoreOf 2 L := by
    intro n
    induction n with
    | zero => intro l _; simp [(pCoreOf 2 L).one_mem]
    | succ n ih =>
      intro l hl
      have h1 := CFSG.ASVolI.burnsideI22P5_pCoreOf_conj L (b ^ n) (hnL n) (h l hl)
      have e : b ^ (n + 1) * l * (b ^ (n + 1))⁻¹ * l⁻¹ =
          (b ^ n * (b * l * b⁻¹ * l⁻¹) * (b ^ n)⁻¹) * (b ^ n * l * (b ^ n)⁻¹ * l⁻¹) := by group
      rw [e]
      exact (pCoreOf 2 L).mul_mem h1 (ih l hl)
  rw [Subgroup.commutator_le]
  intro x hx l hl
  obtain ⟨n, rfl⟩ := (mem_powers_iff_mem_zpowers).mpr hx
  rw [commutatorElement_def]
  exact hpow n l hl

theorem hasNormalPComplement_of_barM {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {M J : Subgroup G}
    (hJM : J ≤ M) (h : HasNormalPComplement p ↥(barM M J)) : HasNormalPComplement p ↥J := by
  have hp : p.Prime := Fact.out
  set g : ↥J →* ↥M ⧸ CFSG.pCore 2 ↥M :=
    (QuotientGroup.mk' (CFSG.pCore 2 ↥M)).comp (Subgroup.inclusion hJM) with hg
  have hrange : g.range = barM M J := by
    rw [hg, MonoidHom.range_comp, Subgroup.inclusion_range]
    rfl
  have e : ↥J ⧸ g.ker ≃* ↥(barM M J) :=
    (QuotientGroup.quotientKerEquivRange g).trans (MulEquiv.subgroupCongr hrange)
  have hq : HasNormalPComplement p (↥J ⧸ g.ker) :=
    hasNormalPComplement_of_surjective' e.symm.toMonoidHom e.symm.surjective h
  refine CFSG.LocalAnalysis.GLTheoremB.MovingAround.InputsMisc7d.hasNormalPComplement_of_quotient
    (fun x hx hxp => ?_) hq
  have hx2 : Subgroup.inclusion hJM x ∈ CFSG.pCore 2 ↥M :=
    (QuotientGroup.eq_one_iff _).mp (MonoidHom.mem_ker.mp hx)
  obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥M)) ⟨_, hx2⟩
  have hk' : x ^ (2 ^ k) = 1 := by
    have := congrArg (fun z : ↥(CFSG.pCore 2 ↥M) => ((z : ↥M) : G)) hk
    exact Subtype.ext (by simpa using this)
  exact eq_one_of_pow_two_pow_eq_one hp hp2 hk' (by rw [pow_one]; exact hxp)

structure StepThreeAt (p : ℕ) (P : Sylow p G) (M H : Subgroup G)
    (K : Subgroup (H ⧸ primeComplementCore (G := H) p)) (B E : Subgroup G) (b y : G) :
    Prop where
  p35 : p = 3 ∨ p = 5
  ne : d1KBar p M (Subgroup.centralizer ({b} : Set G)) ≠ ⊥
  normal : (d1KBar p M (Subgroup.centralizer ({b} : Set G))).Normal
  center : Subgroup.center ↥(d1KBar p M (Subgroup.centralizer ({b} : Set G))) = ⊥
  stepThree : StepThreeGroup p ↥(d1KBar p M (Subgroup.centralizer ({b} : Set G)))
  one_le : 1 ≤ Open.pRank p (⊤ : Subgroup ↥(d1KBar p M (Subgroup.centralizer ({b} : Set G))))
  not_le : ¬ d1KBar p M (Subgroup.centralizer ({b} : Set G)) ≤
    d1X0 p M (Subgroup.centralizer ({b} : Set G))
  plusCore_le : d1PlusCore p (Subgroup.centralizer ({b} : Set G))
    (d1KBar p M (Subgroup.centralizer ({b} : Set G))) ≤ M
  rank : Open.pRank p (d1PlusCore p (Subgroup.centralizer ({b} : Set G))
    (d1KBar p M (Subgroup.centralizer ({b} : Set G)))) ≤ 1
  c_rank : Open.pRank p (Subgroup.centralizer ({b} : Set G)) = 3
  core : GLBWeakCore p (P : Subgroup G) ≤ M
  sylow : CFSG.ABGLocalTools.IsSylowOf p B (Subgroup.centralizer ({b} : Set G))
  B_le : B ≤ M
  b_mem : b ∈ B
  b_order : orderOf b = p
  elem : IsElemAbelian p E
  card : Nat.card E = p ^ 3
  E_le : E ≤ B
  yp_mem : y ^ p ∈ B
  agl : ∃ U : Subgroup G, U ≤ Subgroup.centralizer ({b} : Set G) ∧ IsAGLQ p M U
  b_H : b ∈ H
  b_M : b ∈ M
  b_out : b ∉ hyp111Pre p H K ⊔ d1PlusCore p H K
  yp_K : y ^ p ∈ hyp111Pre p H K
  y_M : y ∈ M
  yp_order : orderOf (y ^ p) = p
  b_yp : b * y ^ p = y ^ p * b

theorem stepThreeAt_of
    (hS : Setting G) (h1014 : AGL81TenFourteenCentCfg G)
    (h10143 : AGL81TenFourteenThreeCfgGen G) {p : ℕ} {P : Sylow p G} {M H Q : Subgroup G}
    {K : Subgroup (H ⧸ primeComplementCore (G := H) p)} (hd : AGL81CfgData p P M H Q K)
    (hKs : IsCaseTwoGroup p ↥K) (hKn : K.Normal) {L : Subgroup G}
    (hL : IsWeakSBlock M (pCoreOf 2 H) L) (hLn : (L.subgroupOf M).Normal)
    (hpJ : p ∣ Nat.card (jZero H L)) {W : Subgroup G} {y a z : G} (hWH : W ≤ H ⊓ M)
    (hzW : z ∈ W ⊓ d1PlusCore p H K) (hzo : orderOf z = p) (hzc : ∀ w ∈ W, w * z = z * w)
    (hyl : d1LiftX p H W K = Subgroup.zpowers y) (hyo : orderOf y = p ^ 2) (haW : a ∈ W)
    (hao : orderOf a = p) (haout : a ∉ hyp111Pre p H K ⊔ d1PlusCore p H K)
    (hnc : a * y ≠ y * a) (hZL : ⁅Subgroup.zpowers (y ^ p), L⁆ ≤ pCoreOf 2 L) {b : G}
    (hb : b ∈ Subgroup.zpowers (y ^ p) ⊔ Subgroup.zpowers a)
    (hbZ : b ∉ Subgroup.zpowers (y ^ p))
    (hC : ¬ Subgroup.centralizer ({b} : Set G) ≤ M) :
    ∃ B E : Subgroup G, StepThreeAt p P M H K B E b y := by
  obtain ⟨H₁, R₁, hesc⟩ := hd.escape
  have hp : p.Prime := hesc.prime
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : IsSimpleGroup ↥K := RankOneSylow.isSimpleGroup_of_isCaseTwoGroup hKs
  have hp35 := RankOneSylow.eq_three_or_five_of_isCaseTwoGroup hKs
  have hp2 : p ≠ 2 := by omega
  have hWH' : W ≤ H := hWH.trans inf_le_left
  have hWM : W ≤ M := hWH.trans inf_le_right
  obtain ⟨hbo, hEb, hE', hE'c, hE'W⟩ := elemAbelian_triple hKn hWH' hzW.1 hzW.2 hzo hzc hyl hyo
    haW hao haout hb hbZ
  set E' := Subgroup.zpowers (y ^ p) ⊔ Subgroup.zpowers b ⊔ Subgroup.zpowers z with hE'def
  set C := Subgroup.centralizer ({b} : Set G) with hCdef
  have hbE' : b ∈ E' := Subgroup.mem_sup_left (Subgroup.mem_sup_right (Subgroup.mem_zpowers b))
  have hZE' : Subgroup.zpowers (y ^ p) ≤ E' := le_sup_left.trans le_sup_left
  have hyE' : y ^ p ∈ E' := hZE' (Subgroup.mem_zpowers _)
  have hE'M : E' ≤ M := hE'W.trans hWM
  have hE'p : IsPGroup p E' := IsPGroup.of_card (n := 3) hE'c
  have hE'C : E' ≤ C := by
    intro e he
    rw [hCdef, Subgroup.mem_centralizer_singleton_iff]
    exact (congrArg Subtype.val (hE'.1.is_comm.comm ⟨b, hbE'⟩ ⟨e, he⟩)).symm
  have hQ : IsAGLQ p M E' :=
    ⟨hE'M, hE'p, Or.inl (by
      rw [CFSG.SectionRank.pRank_coe_eq_openPRank]
      exact CFSG.SectionRank.le_pRank hp.one_lt le_rfl hE' hE'c)⟩
  have hT := h1014 hS p P M H Q K hd b (hE'M hbE') hbo hC ⟨E', hE'C, hQ⟩
  have hne := kbar_ne_bot_of_not_le hS h1014 h10143 hd hKs hKn hL hLn hpJ hWH hzW hzo hzc hyl
    hyo haW hao haout hnc hZL hb hbZ hC
  obtain ⟨B, hE'B, hBCM, -, ⟨S, hSB⟩, -, hC3⟩ :=
    exists_sylow_of_elemAbelian hS hd (C := C) le_rfl (le_inf hE'C hE'M) hE'p hE' hE'c
  have hK1 := one_le_pRank_d1KBar hp2 hne
  have hyK : y ∈ hyp111Pre p H K := Subgroup.map_mono inf_le_right (hyl ▸ Subgroup.mem_zpowers y)
  have hypK : y ^ p ∈ hyp111Pre p H K := Subgroup.pow_mem _ hyK p
  have hbout : b ∉ hyp111Pre p H K ⊔ d1PlusCore p H K := by
    intro hbK
    apply haout
    have hle : Subgroup.zpowers (y ^ p) ⊔ Subgroup.zpowers b ≤
        hyp111Pre p H K ⊔ d1PlusCore p H K :=
      sup_le (Subgroup.zpowers_le.mpr (Subgroup.mem_sup_left hypK))
        (Subgroup.zpowers_le.mpr hbK)
    rw [hEb] at hle
    exact hle (Subgroup.mem_sup_right (Subgroup.mem_zpowers a))
  have hypo : orderOf (y ^ p) = p := by
    rw [orderOf_pow_of_dvd hp.ne_zero (hyo ▸ dvd_pow_self p two_ne_zero), hyo, pow_two,
      Nat.mul_div_cancel _ hp.pos]
  have hbyp : b * y ^ p = y ^ p * b :=
    congrArg Subtype.val (hE'.1.is_comm.comm ⟨b, hbE'⟩ ⟨y ^ p, hyE'⟩)
  exact ⟨B, E',
    { p35 := hp35
      ne := hne
      normal := (hT.nineThree hne).normal
      center := hT.center hne
      stepThree := stepThreeGroup_kbar hp35 hbo hT hne hC3.le
      one_le := hK1
      not_le := not_le_d1X0_of_ne_bot hne
      plusCore_le := (hT.nineThree hne).plusCore_le
      rank := hT.rank hne
      c_rank := hC3
      core := hesc.weakCore_le
      sylow := ⟨S, hSB⟩
      B_le := hBCM.trans inf_le_right
      b_mem := hE'B hbE'
      b_order := hbo
      elem := hE'
      card := hE'c
      E_le := hE'B
      yp_mem := hE'B hyE'
      agl := ⟨E', hE'C, hQ⟩
      b_H := hWH' (hE'W hbE')
      b_M := hE'M hbE'
      b_out := hbout
      yp_K := hypK
      y_M := hWM (d1LiftX_le p H W K (hyl ▸ Subgroup.mem_zpowers y))
      yp_order := hypo
      b_yp := hbyp }⟩

theorem center_eq_bot_of_d1LiftX {p : ℕ} [Fact p.Prime] {H : Subgroup G}
    {K : Subgroup (H ⧸ primeComplementCore (G := H) p)} (hKs : IsCaseTwoGroup p ↥K)
    {W : Subgroup G} {y : G} (hyl : d1LiftX p H W K = Subgroup.zpowers y)
    (hyo : orderOf y = p ^ 2) : Subgroup.center ↥K = ⊥ := by
  have hp : p.Prime := Fact.out
  haveI : IsSimpleGroup ↥K := RankOneSylow.isSimpleGroup_of_isCaseTwoGroup hKs
  have hyK : y ∈ hyp111Pre p H K :=
    Subgroup.map_mono inf_le_right (hyl ▸ Subgroup.mem_zpowers y)
  obtain ⟨h, hhK, hhy⟩ := hyK
  have hy2 : y ^ (p ^ 2) = 1 := by rw [← hyo, pow_orderOf_eq_one]
  have hh2 : h ^ (p ^ 2) = 1 := Subtype.ext (by simpa [← hhy] using hy2)
  set g : ↥K := ⟨QuotientGroup.mk' _ h, hhK⟩ with hg
  have hg2 : g ^ (p ^ 2) = 1 := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow, OneMemClass.coe_one]
    change (QuotientGroup.mk' _ h) ^ (p ^ 2) = 1
    rw [← map_pow, hh2, map_one]
  have hg1 : g ^ p ≠ 1 := by
    intro e
    have e' := congrArg Subtype.val e
    rw [SubmonoidClass.coe_pow, OneMemClass.coe_one] at e'
    change (QuotientGroup.mk' _ h) ^ p = 1 at e'
    rw [← map_pow, QuotientGroup.mk'_apply] at e'
    have hcore := (QuotientGroup.eq_one_iff _).mp e'
    have hp1 := eq_one_of_mem_core hcore (n := 1)
      (by rw [pow_one, ← pow_mul, ← pow_two]; exact hh2)
    have hyp : y ^ p = 1 := by rw [← hhy, ← map_pow, hp1, map_one]
    have hdv := orderOf_dvd_of_pow_eq_one hyp
    rw [hyo] at hdv
    have := Nat.le_of_dvd hp.pos hdv
    have := hp.two_le
    nlinarith
  rw [eq_bot_iff]
  intro k hk
  exact Subgroup.mem_bot.mpr (eq_one_of_central hp hg1 hg2
    (fun k' => (Subgroup.mem_center_iff.mp hk k').symm))

theorem yp_mem_of_le (hI5 : KFactStepThreeCentSylow) (hFld : KFactFieldAutInvert)
    {p : ℕ} [Fact p.Prime] {P : Sylow p G} {M H : Subgroup G}
    {K : Subgroup (H ⧸ primeComplementCore (G := H) p)} [K.Normal] (hKs : IsCaseTwoGroup p ↥K)
    {W : Subgroup G} {y : G} (hyl : d1LiftX p H W K = Subgroup.zpowers y)
    (hyo : orderOf y = p ^ 2) {B E L : Subgroup G} {b : G} (hT : StepThreeAt p P M H K B E b y)
    (hB₁L : B ⊓ hyp111Pre p (Subgroup.centralizer ({b} : Set G))
      (d1KBar p M (Subgroup.centralizer ({b} : Set G))) ≤ L)
    (hZL : ⁅Subgroup.zpowers (y ^ p), L⁆ ≤ pCoreOf 2 L) :
    y ^ p ∈ hyp111Pre p (Subgroup.centralizer ({b} : Set G))
      (d1KBar p M (Subgroup.centralizer ({b} : Set G))) := by
  haveI := hT.normal
  have hp2 : p ≠ 2 := by rcases hT.p35 with h | h <;> omega
  set C := Subgroup.centralizer ({b} : Set G) with hCdef
  have hbC : ∀ x : G, b * x = x * b → x ∈ C := fun x hx =>
    Subgroup.mem_centralizer_singleton_iff.mpr hx.symm
  have hbcent : ∀ c ∈ C, b * c = c * b := fun c hc =>
    (Subgroup.mem_centralizer_singleton_iff.mp hc).symm
  have hBp : IsPGroup p B := by
    obtain ⟨S, hS'⟩ := hT.sylow
    rw [← hS']
    exact S.isPGroup'.map _
  have hcp : (y ^ p) ^ p = 1 := by
    have h := pow_orderOf_eq_one (y ^ p)
    rwa [hT.yp_order] at h
  have hcB₁ := commute_of_commutator_le hp2 hBp inf_le_left hB₁L hT.yp_mem hZL
  have hZK := center_eq_bot_of_d1LiftX hKs hyl hyo
  obtain ⟨t, htH, hbt, hn⟩ := exists_inv_mod_core hFld hKs hZK hT.b_H hT.b_order hT.b_out hT.yp_K
    hT.yp_order hT.b_yp
  have hcop : Nat.Coprime (Nat.card ((primeComplementCore (G := H) p).map H.subtype)) p := by
    rw [Subgroup.card_map_of_injective H.subtype_injective]
    exact (primeComplementCore_coprime p).symm
  have hnm : (y ^ p * (t * y ^ p * t⁻¹)) ^
      Nat.card ((primeComplementCore (G := H) p).map H.subtype) = 1 :=
    congrArg Subtype.val (pow_card_eq_one' (x := (⟨_, hn⟩ :
      ↥((primeComplementCore (G := H) p).map H.subtype))))
  exact mem_hyp111Pre_of_conj_eq hI5 hp2 hT.center hT.stepThree hT.rank hT.sylow
    (hbC b rfl) hbcent hT.b_order hT.yp_mem hcp hcB₁ (hbC t hbt) hcop hnm (by group)

theorem false_of_not_altTen
    (hS : Setting G) (h1014 : AGL81TenFourteenCentCfg G)
    (h10143 : AGL81TenFourteenThreeCfgGen G) (h1033 : AGL81TenThreeThreeCasesCfg G)
    (hJ0 : AGL81ElevenElevenJZeroShape G) (hI1 : KFactStepThreeCentNilp)
    (hI2 : KFactStepThreeIrred) (hI4 : KFactStepThreeMaximal) (hI5 : KFactStepThreeCentSylow)
    (hI6 : KFactStepThreeNormSolv) (hFld : KFactFieldAutInvert)
    (hKC : KFactCentralThreeClassical) (hKA : KFactAltSixFixed)
    (hKL : KFactLinUnitThreeParabolic) {p : ℕ} {P : Sylow p G} {M H Q : Subgroup G}
    {K : Subgroup (H ⧸ primeComplementCore (G := H) p)} (hd : AGL81CfgData p P M H Q K)
    (hKs : IsCaseTwoGroup p ↥K) (hKn : K.Normal) {L : Subgroup G}
    (hL : IsWeakSBlock M (pCoreOf 2 H) L) (hLn : (L.subgroupOf M).Normal)
    (hJX : jZero H L ≤ d1PlusCore p H K) (hX1 : Open.pRank p (d1PlusCore p H K) = 1)
    (hpJ : p ∣ Nat.card (jZero H L)) {W : Subgroup G} {y a z : G} (hWH : W ≤ H ⊓ M)
    (hzW : z ∈ W ⊓ d1PlusCore p H K) (hzo : orderOf z = p) (hzc : ∀ w ∈ W, w * z = z * w)
    (hyl : d1LiftX p H W K = Subgroup.zpowers y) (hyo : orderOf y = p ^ 2) (haW : a ∈ W)
    (hao : orderOf a = p) (haout : a ∉ hyp111Pre p H K ⊔ d1PlusCore p H K)
    (hnc : a * y ≠ y * a)
    (hAJ : ∀ c ∈ Subgroup.zpowers y ⊔ Subgroup.zpowers a, ∀ x ∈ jZero H L,
      c * x * c⁻¹ * x⁻¹ ∈ pCoreOf 2 (jZero H L))
    (hZL : ⁅Subgroup.zpowers (y ^ p), L⁆ ≤ pCoreOf 2 L) {b : G}
    (hb : b ∈ Subgroup.zpowers (y ^ p) ⊔ Subgroup.zpowers a)
    (hbZ : b ∉ Subgroup.zpowers (y ^ p))
    (hC : ¬ Subgroup.centralizer ({b} : Set G) ≤ M)
    (hA : IsEmpty (↥(d1KBar p M (Subgroup.centralizer ({b} : Set G))) ≃*
      alternatingGroup (Fin 10))) : False := by
  obtain ⟨B, E, hT⟩ := stepThreeAt_of hS h1014 h10143 hd hKs hKn hL hLn hpJ hWH hzW hzo hzc hyl
    hyo haW hao haout hnc hZL hb hbZ hC
  haveI := hT.normal
  obtain ⟨H₁, R₁, hesc⟩ := hd.escape
  have hp : p.Prime := hesc.prime
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : IsSimpleGroup ↥K := RankOneSylow.isSimpleGroup_of_isCaseTwoGroup hKs
  have hp2 : p ≠ 2 := by rcases hT.p35 with h | h <;> omega
  set C := Subgroup.centralizer ({b} : Set G) with hCdef
  have hbC : ∀ x : G, b * x = x * b → x ∈ C := fun x hx =>
    Subgroup.mem_centralizer_singleton_iff.mpr hx.symm
  have hbcent : ∀ c ∈ C, b * c = c * b := fun c hc =>
    (Subgroup.mem_centralizer_singleton_iff.mp hc).symm
  have hbk : b ^ (p ^ 1) = 1 := by rw [pow_one, ← hT.b_order, pow_orderOf_eq_one]
  have hBp : IsPGroup p B := by
    obtain ⟨S, hS'⟩ := hT.sylow
    rw [← hS']
    exact S.isPGroup'.map _
  have hKnp := not_hasNormalPComplement_d1KBar hT.one_le
  obtain ⟨hJnp, hJsolv⟩ := hJ0 hS p P M H Q K hd hKs hKn L hL hLn hJX hX1 hpJ
  have hLM : L ≤ M := hL.le
  have hML : M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLM).mp hLn
  have hJL : jZero H L ≤ L := (jZero_le H L).trans inf_le_right
  have hbJ : b ∈ Subgroup.normalizer (jZero H L : Set G) :=
    le_normalizer_jZero H L (Subgroup.inf_normalizer_le_normalizer_inf
      ⟨Subgroup.le_normalizer hT.b_H, hML hT.b_M⟩)
  have hbJ2 := hAJ b (sup_le_sup_right (Subgroup.zpowers_le.mpr
    (Subgroup.pow_mem _ (Subgroup.mem_zpowers y) p)) _ hb)
  have hCL := not_hasNormalPComplement_inf hp2 hbk hbJ hbJ2 hbC hJL hJnp
  have hB₁L := inf_hyp111Pre_le_of hI1 hI2 hI4 hT.core hp2 hT.center hT.one_le hT.stepThree hA
    hT.not_le hKnp hT.plusCore_le hT.rank hT.sylow hT.B_le hT.b_mem hbcent hT.b_order hT.elem
    hT.card hT.E_le hLM hML hCL
  obtain ⟨hp3, I, hI, hIS⟩ := hJsolv (isPSolvable_quot_of hI4 hI6 hT.core hp2 hT.center hT.one_le
    hT.stepThree hA hT.not_le hT.plusCore_le hT.rank hT.sylow hT.B_le hT.b_mem hbcent hT.b_order
    hT.elem hT.card hT.E_le hbC (hJL.trans hLM) hbJ hbJ2)
  have hcp : (y ^ p) ^ p = 1 := by
    have h := pow_orderOf_eq_one (y ^ p)
    rwa [hT.yp_order] at h
  have hyKC := yp_mem_of_le hI5 hFld hKs hyl hyo hT hB₁L hZL
  have hyL : y ^ p ∈ L := hB₁L ⟨hT.yp_mem, hyKC⟩
  subst hp3
  have hpL : 3 ∣ Nat.card L := hpJ.trans (Subgroup.card_dvd_of_le hJL)
  have h3 := h10143 hS 3 P M H Q K hd L hL hpL b hT.b_M hT.b_order hC hT.agl
  have haL : ¬ ∀ l ∈ L, b * l * b⁻¹ * l⁻¹ ∈ pCoreOf 2 M := fun h => h3 (commutator_zpowers_le
    (hML hT.b_M) fun l hl => inf_pCoreOf_le hLM ⟨L.mul_mem
      ((Subgroup.mem_normalizer_iff.mp (hML hT.b_M) l).mp hl) (L.inv_mem hl), h l hl⟩)
  have hodd : Odd (orderOf b) := by rw [hT.b_order]; decide
  obtain ⟨hcl, hpar⟩ := (h1033 hS 3 P M H Q K hd L hL hLn b ⟨hT.b_H, hT.b_M⟩ hodd hbJ2).resolve_left
    haL
  have h3Z : 3 ∣ Nat.card (Subgroup.center ↥(barM M L)) := by
    set π := QuotientGroup.mk' (CFSG.pCore 2 ↥M) with hπ
    have hypM : y ^ 3 ∈ M := Subgroup.pow_mem _ hT.y_M 3
    set c : ↥M := ⟨y ^ 3, hypM⟩ with hc
    have hcL : π c ∈ barM M L := ⟨c, Subgroup.mem_subgroupOf.mpr hyL, rfl⟩
    have hpc : pCoreOf 2 L ≤ pCoreOf 2 M := pCoreOf_le_of_normal_subgroupOf 2 L M hLM hLn
    have hcZ : ∀ x : ↥(barM M L), (⟨π c, hcL⟩ : ↥(barM M L)) * x = x * ⟨π c, hcL⟩ := by
      rintro ⟨_, ⟨l, hl, rfl⟩⟩
      have hl' : (l : G) ∈ L := Subgroup.mem_subgroupOf.mp hl
      have hcomm : y ^ 3 * l * (y ^ 3)⁻¹ * (l : G)⁻¹ ∈ pCoreOf 2 M := by
        have := Subgroup.commutator_le.mp hZL _ (Subgroup.mem_zpowers _) _ hl'
        rw [commutatorElement_def] at this
        exact hpc this
      obtain ⟨m, hm, hme⟩ := hcomm
      have hcm : c * l * c⁻¹ * l⁻¹ = m := Subtype.ext (by
        simp only [Subgroup.coe_subtype] at hme
        rw [hme]
        simp [hc])
      have h1 : π (c * l * c⁻¹ * l⁻¹) = 1 := by
        rw [hcm]
        exact (QuotientGroup.eq_one_iff m).mpr hm
      apply Subtype.ext
      change π c * π l = π l * π c
      rw [map_mul, map_mul, map_mul, map_inv, map_inv] at h1
      calc π c * π l = (π c * π l * (π c)⁻¹ * (π l)⁻¹) * (π l * π c) := by group
        _ = π l * π c := by rw [h1, one_mul]
    set w : ↥(Subgroup.center ↥(barM M L)) :=
      ⟨⟨π c, hcL⟩, Subgroup.mem_center_iff.mpr fun x => (hcZ x).symm⟩ with hw
    have hwo : orderOf w = 3 := by
      refine orderOf_eq_prime ?_ ?_
      · apply Subtype.ext; apply Subtype.ext
        change π c ^ 3 = 1
        rw [← map_pow]
        have : c ^ 3 = 1 := Subtype.ext (by simp [hc, hcp])
        rw [this, map_one]
      · intro h1
        have h2 : π c = 1 := congrArg (fun x : ↥(Subgroup.center ↥(barM M L)) =>
          ((x : ↥(barM M L)) : ↥M ⧸ CFSG.pCore 2 ↥M)) h1
        have hcO := (QuotientGroup.eq_one_iff c).mp h2
        obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥M)) ⟨c, hcO⟩
        have hk' : (y ^ 3) ^ (2 ^ k) = 1 := by
          have := congrArg (fun z : ↥(CFSG.pCore 2 ↥M) => ((z : ↥M) : G)) hk
          simpa [hc] using this
        have h1' := eq_one_of_pow_two_pow_eq_one Nat.prime_three (by norm_num) hk'
          (e := 1) (by rw [pow_one]; exact hcp)
        have hyo3 := hT.yp_order
        rw [h1', orderOf_one] at hyo3
        exact absurd hyo3 (by norm_num)
    exact hwo ▸ orderOf_dvd_natCard w
  have hM3 : Open.pRank 3 M ≤ 3 := by
    have h1 := local_pRank_le_evenRank 3 Nat.prime_three (by norm_num) M hesc.maxTwoLocal_M.1
    rw [hS.rank] at h1
    exact h1
  have hCJ : ¬ HasNormalPComplement 3 ↥(C ⊓ jZero H L) := fun h =>
    hJnp (hasNormalPComplement_quot_of_inf hp2 hbk hbJ hbJ2 hbC h)
  have hCJb : ¬ HasNormalPComplement 3 ↥(barM M (C ⊓ jZero H L)) := fun h =>
    hCJ (hasNormalPComplement_of_barM hp2 (inf_le_right.trans (hJL.trans hLM)) h)
  exact false_of_stepSix hKC hKA hKL hL.component hLM hLn hcl hpar h3Z hM3 hT.b_M
    (by rw [← hT.b_order, pow_orderOf_eq_one]) haL (inf_le_right.trans hJL)
    (fun x hx => hbcent x hx.1) hCJb (hI.le) hI.subnormal hIS

