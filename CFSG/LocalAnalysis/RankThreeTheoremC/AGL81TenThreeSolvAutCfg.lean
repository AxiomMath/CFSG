private theorem card_dvd_24_of_subnormal_perm {m : ℕ} {X : Subgroup (Equiv.Perm (Fin m))}
    (hX : IsSubnormal X ⊤) (h216 : Nat.card X ∣ 216) : Nat.card X ∣ 24 := by
  rcases Nat.lt_or_ge m 5 with hm | hm
  · have h1 : Nat.card X ∣ Nat.card (Equiv.Perm (Fin m)) := Subgroup.card_subgroup_dvd_card X
    have h2 : Nat.card (Equiv.Perm (Fin m)) ∣ 24 := by
      rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]
      exact (Nat.factorial_dvd_factorial (by omega : m ≤ 4)).trans (by decide)
    exact h1.trans h2
  · haveI : IsSimpleGroup (alternatingGroup (Fin m)) :=
      alternatingGroup.isSimpleGroup (by rw [Nat.card_fin]; omega)
    haveI : Nontrivial (Fin m) := Fin.nontrivial_iff_two_le.mpr (by omega)
    have hXA : IsSubnormal (X ⊓ alternatingGroup (Fin m)) (alternatingGroup (Fin m)) :=
      hX.inf_of_le le_top
    rcases hXA.eq_bot_or_eq_of_isSimpleGroup inferInstance with h | h
    ·
      have hinj : Function.Injective ((Equiv.Perm.sign).comp X.subtype) := by
        rw [injective_iff_map_eq_one]
        intro x hx
        have hxA : (x : Equiv.Perm (Fin m)) ∈ X ⊓ alternatingGroup (Fin m) :=
          ⟨x.2, Equiv.Perm.mem_alternatingGroup.mpr hx⟩
        rw [h, Subgroup.mem_bot] at hxA
        exact Subtype.ext hxA
      have h2 := Subgroup.card_dvd_of_injective _ hinj
      rw [Nat.card_eq_fintype_card (α := ℤˣ), Fintype.card_units_int] at h2
      exact h2.trans (by norm_num)
    ·
      exfalso
      have hle : alternatingGroup (Fin m) ≤ X := by
        rw [← h]
        exact inf_le_left
      have hd := (Subgroup.card_dvd_of_le hle).trans h216
      rw [nat_card_alternatingGroup, Nat.card_fin] at hd
      rcases Nat.lt_or_ge m 6 with h6 | h6
      · obtain rfl : m = 5 := by omega
        norm_num [Nat.factorial] at hd
      · have h720 : (6 : ℕ).factorial ≤ m.factorial := Nat.factorial_le h6
        have : (360 : ℕ) ≤ m.factorial / 2 := by
          have : (720 : ℕ) ≤ m.factorial := by simpa [Nat.factorial] using h720
          omega
        have := Nat.le_of_dvd (by norm_num) hd
        omega

private theorem false_of_subnormal_perm_prod {r s : ℕ}
    {X : Subgroup (Equiv.Perm (Fin r) × Equiv.Perm (Fin s))} (hX : IsSubnormal X ⊤)
    (h216 : Nat.card X = 216) : False := by
  have hfst : Function.Surjective (MonoidHom.fst (Equiv.Perm (Fin r)) (Equiv.Perm (Fin s))) :=
    Prod.fst_surjective
  have hsnd : Function.Surjective (MonoidHom.snd (Equiv.Perm (Fin r)) (Equiv.Perm (Fin s))) :=
    Prod.snd_surjective
  have h1 : IsSubnormal (X.map (MonoidHom.fst _ _)) ⊤ := by
    have := hX.map (MonoidHom.fst (Equiv.Perm (Fin r)) (Equiv.Perm (Fin s)))
    rwa [Subgroup.map_top_of_surjective _ hfst] at this
  have h2 : IsSubnormal (X.map (MonoidHom.snd _ _)) ⊤ := by
    have := hX.map (MonoidHom.snd (Equiv.Perm (Fin r)) (Equiv.Perm (Fin s)))
    rwa [Subgroup.map_top_of_surjective _ hsnd] at this
  have hd1 := card_dvd_24_of_subnormal_perm h1 (h216 ▸ Subgroup.card_map_dvd _ _)
  have hd2 := card_dvd_24_of_subnormal_perm h2 (h216 ▸ Subgroup.card_map_dvd _ _)
  let f : X →* ↥(X.map (MonoidHom.fst _ _)) × ↥(X.map (MonoidHom.snd _ _)) :=
    MonoidHom.prod ((MonoidHom.fst _ _).subgroupMap X) ((MonoidHom.snd _ _).subgroupMap X)
  have hf : Function.Injective f := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have h1 := congrArg (fun z => ((z.1 : Equiv.Perm (Fin r)))) hx
    have h2 := congrArg (fun z => ((z.2 : Equiv.Perm (Fin s)))) hx
    exact Subtype.ext (Prod.ext h1 h2)
  have h := Subgroup.card_dvd_of_injective f hf
  rw [Nat.card_prod, h216] at h
  have := h.trans (Nat.mul_dvd_mul hd1 hd2)
  norm_num at this

private theorem false_of_four_le_pRank_barM {G : Type} [Group G] [Finite G] (hS : Setting G)
    {M : Subgroup G} (hM : IsTwoLocal M) {Y : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)}
    (h4 : 4 ≤ CFSG.Open.pRank 3 Y) : False := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h1 := CFSG.SectionRank.pRank_mono (p := 3) (by norm_num) (le_top : Y ≤ ⊤)
  have h3 : ¬ 3 ∣ Nat.card (CFSG.pCore 2 ↥M) := by
    obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥M)).exists_card_eq
    rw [hk]
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).1 (Nat.Coprime.pow_right k (by norm_num))
  rw [CFSG.SectionRank.pRank_quotient_eq (CFSG.pCore 2 ↥M) h3,
    ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup M] at h1
  have h3' := local_pRank_le_evenRank 3 Nat.prime_three (by norm_num) M hM
  rw [hS.rank] at h3'
  omega

