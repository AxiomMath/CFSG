theorem a10_centralizer_le {K : Type} [Group K] [Finite K] (hK : IsA10Type 5 K) (Q : Sylow 5 K) :
    centralizer ((Q : Subgroup K) : Set K) ≤ Q := by
  obtain ⟨A₁, A₂, hne, hA₁, hA₂, h5₁, h5₂, -, -, hdiag⟩ := a10_centFacts K hK Q
  have hn21 : ¬ A₁ ≤ A₂ := fun h => hne (Subgroup.eq_of_le_of_card_ge h (by rw [h5₁, h5₂]))
  have hn12 : ¬ A₂ ≤ A₁ := fun h =>
    hne (Subgroup.eq_of_le_of_card_ge h (by rw [h5₁, h5₂])).symm
  obtain ⟨a, ha₁, ha₂⟩ := SetLike.not_le_iff_exists.1 hn21
  obtain ⟨b, hb₂, hb₁⟩ := SetLike.not_le_iff_exists.1 hn12
  have hsQ : a * b ∈ (Q : Subgroup K) := Q.mul_mem (hA₁ ha₁) (hA₂ hb₂)
  have hs1 : a * b ∉ A₁ := fun h => hb₁ (by simpa using A₁.mul_mem (A₁.inv_mem ha₁) h)
  have hs2 : a * b ∉ A₂ := fun h => ha₂ (by simpa using A₂.mul_mem h (A₂.inv_mem hb₂))
  have hs3 : a * b ≠ 1 := fun h => hb₁ (by
    have : b = a⁻¹ := eq_inv_of_mul_eq_one_right h
    rw [this]
    exact A₁.inv_mem ha₁)
  have h25 := hdiag (a * b) hsQ hs1 hs2 hs3
  obtain ⟨hel, hQ25⟩ := a10_sylow K hK Q
  have hQC : (Q : Subgroup K) ≤ centralizer ({a * b} : Set K) := by
    intro q hq
    rw [mem_centralizer_singleton_iff]
    exact congrArg Subtype.val (hel.1.is_comm.comm ⟨q, hq⟩ ⟨a * b, hsQ⟩)
  have heq : (Q : Subgroup K) = centralizer ({a * b} : Set K) :=
    Subgroup.eq_of_le_of_card_ge hQC (by rw [h25, hQ25]; norm_num)
  intro x hx
  have : x ∈ centralizer ({a * b} : Set K) :=
    Subgroup.centralizer_le (Set.singleton_subset_iff.2 hsQ) hx
  rwa [← heq] at this

theorem a10_normalizer_solvable {K : Type} [Group K] [Finite K] (hK : IsA10Type 5 K)
    (Q : Sylow 5 K) : Group.IsSolvable ↥(normalizer ((Q : Subgroup K) : Set K)) := by
  have hsyl := a10_sylow K hK Q
  exact CFSG.HardMathSupport.Malle.Proving.isSolvable_normalizer_plane (T := (Q : Subgroup K))
    (k := 2) hsyl.1 hsyl.2 hsyl.2 Q.not_dvd_index Subgroup.le_normalizer
    (Subgroup.le_centralizer_iff_isMulCommutative.2 hsyl.1.1)
    (inf_le_right.trans (a10_centralizer_le hK Q))

