variable {A : Type} [Group A] [Finite A]

theorem isPGroup_zpowers {p : ℕ} [Fact p.Prime] {c : A} {n : ℕ} (hc : c ^ (p ^ n) = 1) :
    IsPGroup p (zpowers c) := by
  obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).1 (orderOf_dvd_of_pow_eq_one hc)
  exact IsPGroup.of_card (n := k) (by rw [Nat.card_zpowers, hk])

theorem le_normalizer_zpowers {S : Subgroup A} {c : A} (hc : c ∈ centralizer (S : Set A)) :
    S ≤ normalizer (zpowers c : Set A) := by
  intro s hs
  refine centralizer_le_normalizer _ (mem_centralizer_iff.2 fun h hh => ?_)
  obtain ⟨k, rfl⟩ := mem_zpowers_iff.1 hh
  exact (Commute.zpow_left (show Commute c s from (mem_centralizer_iff.1 hc s hs).symm) k).eq

theorem sup_comm_of_comm {S T : Subgroup A} (hS : ∀ x ∈ S, ∀ y ∈ S, x * y = y * x)
    (hT : ∀ x ∈ T, ∀ y ∈ T, x * y = y * x) (hST : ∀ x ∈ S, ∀ y ∈ T, x * y = y * x) :
    ∀ x ∈ S ⊔ T, ∀ y ∈ S ⊔ T, x * y = y * x := by
  have h1 : ∀ x ∈ S, S ⊔ T ≤ centralizer ({x} : Set A) := fun x hx =>
    sup_le (fun y hy => mem_centralizer_singleton_iff.2 (hS y hy x hx))
      (fun y hy => mem_centralizer_singleton_iff.2 (hST x hx y hy).symm)
  have h2 : ∀ x ∈ T, S ⊔ T ≤ centralizer ({x} : Set A) := fun x hx =>
    sup_le (fun y hy => mem_centralizer_singleton_iff.2 (hST y hy x hx))
      (fun y hy => mem_centralizer_singleton_iff.2 (hT y hy x hx))
  have h3 : S ⊔ T ≤ centralizer ((S ⊔ T : Subgroup A) : Set A) := by
    refine sup_le (fun x hx => mem_centralizer_iff.2 fun y hy => ?_)
      (fun x hx => mem_centralizer_iff.2 fun y hy => ?_)
    · exact mem_centralizer_singleton_iff.1 (h1 x hx hy)
    · exact mem_centralizer_singleton_iff.1 (h2 x hx hy)
  intro x hx y hy
  exact (mem_centralizer_iff.1 (h3 hx) y hy).symm

theorem mem_of_not_dvd_quotient {p : ℕ} [Fact p.Prime] {K S : Subgroup A} [K.Normal]
    (hS : IsSylowOf p S K) (hq : ¬ p ∣ Nat.card (A ⧸ K)) {c : A}
    (hc : c ∈ centralizer (S : Set A)) {n : ℕ} (hn : c ^ (p ^ n) = 1) : c ∈ S := by
  have hE : IsPGroup p (zpowers c) := isPGroup_zpowers hn
  have hcK : zpowers c ≤ K :=
    CFSG.RankThree.PartOne.CTP.le_of_isPGroup_of_not_dvd_card_quotient hE hq
  have hSN : S ≤ normalizer (zpowers c : Set A) := le_normalizer_zpowers hc
  have hQ : IsPGroup p (S ⊔ zpowers c : Subgroup A) := hS.isPGroup.to_sup_of_normal_right' hE hSN
  have hEq : S ⊔ zpowers c = S := hS.eq_of_le le_sup_left (sup_le hS.le hcK) hQ
  rw [← hEq]
  exact mem_sup_right (mem_zpowers c)

theorem exists_sylow_of_not_dvd_quotient {p : ℕ} [Fact p.Prime] {K S : Subgroup A}
    (hS : IsSylowOf p S K) (hq : ¬ p ∣ Nat.card (A ⧸ K)) :
    ∃ R : Sylow p A, (R : Subgroup A) = S := by
  refine ⟨Sylow.ofCard S ?_, Sylow.coe_ofCard _ _⟩
  have hq' : ¬ p ∣ K.index := hq
  have h2 : Nat.card A = Nat.card K * K.index := K.card_mul_index.symm
  have h3 : (Nat.card A).factorization p = (Nat.card K).factorization p := by
    rw [h2, Nat.factorization_mul Nat.card_pos.ne' (Subgroup.index_ne_zero_of_finite),
      Finsupp.add_apply, Nat.factorization_eq_zero_of_not_dvd hq', add_zero]
  rw [h3]
  exact hS.card_eq

theorem exists_sylow_aut {p : ℕ} [Fact p.Prime] {L : Type*} [Group L] {K S : Subgroup A}
    (hS : IsSylowOf p S K) (e : ↥K ≃* L) :
    ∃ U : Sylow p L, ∀ y, y ∈ (U : Subgroup L) ↔ ((e.symm y : K) : A) ∈ S := by
  obtain ⟨Q, hQ⟩ := hS.exists_sylow_eq_subgroupOf
  have hsurj : Function.Surjective e.toMonoidHom := e.surjective
  refine ⟨Q.mapSurjective hsurj, fun y => ?_⟩
  change y ∈ (Q : Subgroup K).map e.toMonoidHom ↔ _
  rw [Subgroup.mem_map_equiv, hQ]
  rfl

theorem mem_of_aut {L : Type*} [Group L] {K S : Subgroup A} [K.Normal]
    (hC : centralizer (K : Set A) = ⊥) (e : ↥K ≃* L) (U : Subgroup L)
    (hU : ∀ y, y ∈ U ↔ ((e.symm y : K) : A) ∈ S)
    (h : ∀ α : MulAut L, (∀ u ∈ U, α u = u) → ∃ u ∈ U, α = MulAut.conj u)
    {c : A} (hc : c ∈ centralizer (S : Set A)) : c ∈ S := by
  let α : MulAut L := (e.symm.trans (MulAut.conjNormal c)).trans e
  have hα : ∀ k : K, α (e k) = e (MulAut.conjNormal c k) := fun k => by simp [α]
  obtain ⟨u, hu, hαu⟩ := h α (by
    intro y hy
    have hyS := (hU y).1 hy
    have hy' : y = e (e.symm y) := (e.apply_symm_apply y).symm
    rw [hy', hα]
    congr 1
    apply Subtype.ext
    rw [MulAut.conjNormal_apply]
    have h1 := mem_centralizer_iff.1 hc _ hyS
    rw [← h1, mul_inv_cancel_right])
  have hx₀ := (hU u).1 hu
  have hu' : u = e (e.symm u) := (e.apply_symm_apply u).symm
  set x₀ : K := e.symm u with hx₀def
  have hcx : ∀ k : K, c * (k : A) * c⁻¹ = (x₀ : A) * k * (x₀ : A)⁻¹ := by
    intro k
    have h1 := congrArg (fun f : MulAut L => f (e k)) hαu
    simp only [hα, MulAut.conj_apply] at h1
    rw [hu'] at h1
    have h2 : MulAut.conjNormal c k = x₀ * k * x₀⁻¹ := e.injective (by simpa using h1)
    have h3 := congrArg (fun z : K => (z : A)) h2
    simpa [MulAut.conjNormal_apply] using h3
  have hz : (x₀ : A)⁻¹ * c ∈ centralizer (K : Set A) := by
    rw [mem_centralizer_iff]
    intro k hk
    have h1 := hcx ⟨k, hk⟩
    calc k * ((x₀ : A)⁻¹ * c) = (x₀ : A)⁻¹ * ((x₀ : A) * k * (x₀ : A)⁻¹) * c := by group
      _ = (x₀ : A)⁻¹ * (c * k * c⁻¹) * c := by rw [h1]
      _ = (x₀ : A)⁻¹ * c * k := by group
  rw [hC, mem_bot, inv_mul_eq_one] at hz
  rw [← hz]
  exact hx₀

theorem solvable_of_aut {L : Type*} [Group L] {K S : Subgroup A} [K.Normal]
    (hC : centralizer (K : Set A) = ⊥) (e : ↥K ≃* L) (U : Subgroup L)
    (hU : ∀ y, y ∈ U ↔ ((e.symm y : K) : A) ∈ S)
    (h : ∀ B : Subgroup (MulAut L), (∀ α ∈ B, U.map (α : L ≃* L).toMonoidHom = U) →
      Group.IsSolvable B) :
    Group.IsSolvable ↥(normalizer (S : Set A)) := by
  let ρ : ↥(normalizer (S : Set A)) →* MulAut L :=
    (MulAut.congr e).toMonoidHom.comp
      ((MulAut.conjNormal : A →* MulAut ↥K).comp (normalizer (S : Set A)).subtype)
  have hρ : Function.Injective ρ :=
    (MulAut.congr e).injective.comp
      ((CFSG.RankThree.PartOne.CTP.conjNormal_injective_of_centralizer K hC).comp
        (normalizer (S : Set A)).subtype_injective)
  have hstab : ∀ α ∈ ρ.range, U.map (α : L ≃* L).toMonoidHom = U := by
    rintro _ ⟨n, rfl⟩
    have hnα : ∀ y, ((ρ n : MulAut L) y) = e (MulAut.conjNormal (n : A) (e.symm y)) := by
      intro y
      simp [ρ, MulAut.congr_apply]
    have hiff : ∀ y, (ρ n : MulAut L) y ∈ U ↔ y ∈ U := by
      intro y
      rw [hU, hU, hnα, e.symm_apply_apply]
      change ((n : A) * ((e.symm y : K) : A) * (n : A)⁻¹) ∈ S ↔ _
      exact (mem_normalizer_iff.1 n.2 _).symm
    ext y
    rw [mem_map]
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact (hiff u).2 hu
    · intro hy
      refine ⟨(ρ n : MulAut L).symm y, ?_, (ρ n : MulAut L).apply_symm_apply y⟩
      exact (hiff _).1 (by simpa using hy)
  haveI := h ρ.range hstab
  exact Group.isSolvable_of_isSolvable_injective (MonoidHom.rangeRestrict_injective_iff.2 hρ)

theorem solvable_of_quotient {K S : Subgroup A} [K.Normal] (hSK : S ≤ K)
    (hK : Group.IsSolvable ↥(normalizer ((S.subgroupOf K : Subgroup K) : Set K)))
    (hQ : Group.IsSolvable (A ⧸ K)) : Group.IsSolvable ↥(normalizer (S : Set A)) := by
  set N := normalizer (S : Set A) with hN
  let f : ↥(N.subgroupOf K) →* ↥N :=
    (K.subtype.comp (N.subgroupOf K).subtype).codRestrict N
      (fun x => Subgroup.mem_subgroupOf.1 x.2)
  let g : ↥N →* A ⧸ K := (QuotientGroup.mk' K).comp N.subtype
  haveI : Group.IsSolvable ↥(N.subgroupOf K) := by
    rw [hN, subgroupOf_normalizer_eq hSK]
    exact hK
  refine Group.isSolvable_of_ker_le_range f g ?_
  intro n hn
  have hnK : (n : A) ∈ K := (QuotientGroup.eq_one_iff _).1 (MonoidHom.mem_ker.1 hn)
  exact ⟨⟨⟨n, hnK⟩, Subgroup.mem_subgroupOf.2 n.2⟩, rfl⟩

theorem isSolvable_of_card_dvd_prime {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h : Nat.card G ∣ p) : Group.IsSolvable G := by
  rcases (Nat.dvd_prime hp).1 h with h1 | h2
  · have : Subsingleton G := (Nat.card_eq_one_iff_unique.1 h1).1
    infer_instance
  · haveI : Fact p.Prime := ⟨hp⟩
    have : IsCyclic G := isCyclic_of_prime_card h2
    letI : CommGroup G := IsCyclic.commGroup
    exact Group.isSolvable_of_comm fun a b => mul_comm a b

theorem isSolvable_of_card_dvd_twelve {G : Type*} [Group G] [Finite G] (h : Nat.card G ∣ 12) :
    Group.IsSolvable G :=
  CFSG.HardMathSupport.Malle.Proving.isSolvable_of_card_dvd (h.trans (by norm_num))

theorem normalizer_le_glbCore {p : ℕ} (hp : p.Prime) {G : Type*} [Group G] [Finite G]
    (T : Subgroup G) (hdvd : p ∣ Nat.card T) :
    normalizer (T : Set G) ≤ CFSG.Open.GLBCore p 1 T :=
  le_sSup ⟨T, le_rfl, CFSG.AGLEmbedding.KFactProofs.GLBCoreNormalizer.one_le_pRank_of_dvd hp hdvd,
    rfl⟩

theorem index_dvd_outer {K : Subgroup A} [K.Normal] (hC : centralizer (K : Set A) = ⊥) :
    K.index ∣ Nat.card (Outer ↥K) :=
  Subgroup.card_dvd_of_injective _ (CFSG.RankThree.PartOne.CTP.quotientOuterHom_injective K hC)

