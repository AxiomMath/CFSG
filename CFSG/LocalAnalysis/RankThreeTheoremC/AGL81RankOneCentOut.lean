    (p = 5 ∧ ∃ d : TauCeti.ValidLieTypeIndex, IsUnitaryIndex 5 d ∧
      Nonempty (K ≃* (TauCeti.CFSGIndex.lie d).Group)) ∨
    (p = 5 ∧ ∃ d : TauCeti.ValidLieTypeIndex, d.1 = .suzuki 2 ∧
      Nonempty (K ≃* (TauCeti.CFSGIndex.lie d).Group)) ∨
    (p = 5 ∧ ∃ d : TauCeti.ValidLieTypeIndex, d.1 = .tits ∧
      Nonempty (K ≃* (TauCeti.CFSGIndex.lie d).Group)) ∨
    (p = 5 ∧ Nonempty (K ≃* alternatingGroup (Fin 10))) ∨
    (p = 5 ∧ Nonempty (K ≃* (TauCeti.CFSGIndex.sporadic TauCeti.SporadicName.McL).Group)) := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  cases i with
  | cyclic _ _ => exact hi.elim
  | alternating n hn =>
    rcases hi with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · left
      exact ⟨rfl, ⟨e⟩⟩
    · iterate 9 right
      left
      exact ⟨rfl, ⟨e⟩⟩
  | lie d =>
    rcases hi with ⟨rfl, ⟨q, hq1, hq2, hd⟩ | ⟨q, hq1, hq2, hd⟩ | ⟨q, hq1, hq2, hd⟩⟩ |
        ⟨rfl, ⟨q, hq1, hq2, hd⟩ | ⟨q, hq1, hq2, hd⟩ | hd | hd⟩
    · iterate 1 right
      left
      exact ⟨rfl, d, ⟨q, hq1, hd⟩, ⟨e⟩⟩
    · iterate 2 right
      left
      exact ⟨rfl, d, ⟨q, hq1, hq2, hd⟩, ⟨e⟩⟩
    · iterate 3 right
      left
      exact ⟨rfl, d, ⟨q, hq1, hq2, hd⟩, ⟨e⟩⟩
    · iterate 5 right
      left
      exact ⟨rfl, d, ⟨q, hd, hq1, hq2⟩, ⟨e⟩⟩
    · iterate 6 right
      left
      exact ⟨rfl, d, ⟨q, hq1, hd⟩, ⟨e⟩⟩
    · iterate 7 right
      left
      exact ⟨rfl, d, hd, ⟨e⟩⟩
    · iterate 8 right
      left
      exact ⟨rfl, d, hd, ⟨e⟩⟩
  | sporadic s =>
    rcases hi with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · iterate 4 right
      left
      exact ⟨rfl, ⟨e⟩⟩
    · iterate 10 right
      exact ⟨rfl, ⟨e⟩⟩

theorem cent_of_stepThree
    {p : ℕ} {A : Type} [Group A] [Finite A] {K S : Subgroup A} [K.Normal]
    (hC : centralizer (K : Set A) = ⊥) (hK : StepThreeGroup p ↥K) (hS : IsSylowOf p S K) :
    ∀ c ∈ centralizer (S : Set A), ∀ m : ℕ, c ^ (p ^ m) = 1 → c ∈ S := by
  rcases stepThree_cases hK with ⟨rfl, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ |
      ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ |
      ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩
  · exact (a6_both hC hS e).1
  · haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact (unitary_both hC hS hd e).1
  · exact (l28_both hC hS hd e).1
  · exact fun c hc _ hn => l34_cent hC hS hd e hc hn
  · exact (m11_both hC hS e).1
  · exact (l225_both hC hS hd e).1
  · haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
    exact (unitary_both hC hS hd e).1
  · exact (sz32_both hC hS hd e).1
  · exact (tits_both hC hS hd e).1
  · exact (a10_both hC hS e).1
  · exact (mcl_both hC hS e).1

theorem solv_of_stepThree
    {p : ℕ} {A : Type} [Group A] [Finite A] {K S : Subgroup A} [K.Normal]
    (hC : centralizer (K : Set A) = ⊥) (hK : StepThreeGroup p ↥K) (hS : IsSylowOf p S K) :
    Group.IsSolvable ↥(normalizer (S : Set A)) := by
  rcases stepThree_cases hK with ⟨rfl, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ |
      ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ |
      ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, d, hd, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩ | ⟨rfl, ⟨e⟩⟩
  · exact (a6_both hC hS e).2
  · haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact (unitary_both hC hS hd e).2
  · exact (l28_both hC hS hd e).2
  · exact l34_solv hC hS hd e
  · exact (m11_both hC hS e).2
  · exact (l225_both hC hS hd e).2
  · haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
    exact (unitary_both hC hS hd e).2
  · exact (sz32_both hC hS hd e).2
  · exact (tits_both hC hS hd e).2
  · exact (a10_both hC hS e).2
  · exact (mcl_both hC hS e).2

end Dispatch

end OutFacts

theorem kFactStepThreeCentSylow_holds :
    KFactStepThreeCentSylow := by
  intro p A _ _ K S hKn hC hK hS c hc n hcn
  haveI := hKn
  exact OutFacts.cent_of_stepThree hC hK hS c hc n hcn

theorem kFactStepThreeNormSolv_holds :
    KFactStepThreeNormSolv := by
  intro p A _ _ K S hKn hC hK hS
  haveI := hKn
  exact OutFacts.solv_of_stepThree hC hK hS

