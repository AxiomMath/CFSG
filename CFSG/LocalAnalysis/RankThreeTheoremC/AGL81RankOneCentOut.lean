theorem linTwo_both {p n : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) (hn : 1 ≤ n) {K S : Subgroup A}
    [K.Normal] (hC : centralizer (K : Set A) = ⊥) (hS : IsSylowOf p S K)
    (e : ↥K ≃* PSL2GF p n) :
    (∀ c ∈ centralizer (S : Set A), ∀ m : ℕ, c ^ (p ^ m) = 1 → c ∈ S) ∧
      Group.IsSolvable ↥(normalizer (S : Set A)) := by
  obtain ⟨U, hU⟩ := exists_sylow_aut hS e
  exact ⟨fun c hc _ _ => mem_of_aut hC e (U : Subgroup _) hU
      (fun α hα => kFactL2UnipotentCentralizer p n hp2 hn U α hα) hc,
    solvable_of_aut hC e (U : Subgroup _) hU
      (fun B hB => kFactL2SylowNormalizerSolvable p n hp2 hn U B hB)⟩

theorem a6_both {K S : Subgroup A} [K.Normal] (hC : centralizer (K : Set A) = ⊥)
    (hS : IsSylowOf 3 S K) (e : ↥K ≃* alternatingGroup (Fin 6)) :
    (∀ c ∈ centralizer (S : Set A), ∀ m : ℕ, c ^ (3 ^ m) = 1 → c ∈ S) ∧
      Group.IsSolvable ↥(normalizer (S : Set A)) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨φ⟩ := CFSG.LocalAnalysis.EvenBN.Tits.I21L.a6aut_nonempty_equiv_psl
  exact linTwo_both (p := 3) (n := 2) (by norm_num) (by norm_num) hC hS (e.trans φ)

theorem l225_both {K S : Subgroup A} [K.Normal] (hC : centralizer (K : Set A) = ⊥)
    (hS : IsSylowOf 5 S K) {d : TauCeti.ValidLieTypeIndex} (hd : IsLinTwoIndex 5 2 d)
    (e : ↥K ≃* (TauCeti.CFSGIndex.lie d).Group) :
    (∀ c ∈ centralizer (S : Set A), ∀ m : ℕ, c ^ (5 ^ m) = 1 → c ∈ S) ∧
      Group.IsSolvable ↥(normalizer (S : Set A)) := by
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨φ⟩ := nonempty_mulEquiv_psl2GF_of_isLinTwoIndex (p := 5) (n := 2) hd
  exact linTwo_both (p := 5) (n := 2) (by norm_num) (by norm_num) hC hS (e.trans φ)

theorem unitary_both {p : ℕ} [Fact p.Prime] {K S : Subgroup A} [K.Normal]
    (hC : centralizer (K : Set A) = ⊥) (hS : IsSylowOf p S K) {d : TauCeti.ValidLieTypeIndex}
    (hd : IsUnitaryIndex p d) (e : ↥K ≃* (TauCeti.CFSGIndex.lie d).Group) :
    (∀ c ∈ centralizer (S : Set A), ∀ m : ℕ, c ^ (p ^ m) = 1 → c ∈ S) ∧
      Group.IsSolvable ↥(normalizer (S : Set A)) := by
  obtain ⟨U, hU⟩ := exists_sylow_aut hS (MulEquiv.refl ↥K)
  exact ⟨fun c hc _ _ => mem_of_aut hC (MulEquiv.refl ↥K) (U : Subgroup _) hU
      (fun α hα => kFactUnitaryUnipotentCentralizer ↥K p d hd ⟨e⟩ U α hα) hc,
    solvable_of_aut hC (MulEquiv.refl ↥K) (U : Subgroup _) hU
      (fun B hB => kFactUnitarySylowNormalizerSolvable ↥K p d hd ⟨e⟩ U B hB)⟩

