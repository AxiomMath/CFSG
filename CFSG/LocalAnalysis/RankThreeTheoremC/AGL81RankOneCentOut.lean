theorem l34_cent
    {K S : Subgroup A} [K.Normal] (hC : centralizer (K : Set A) = ⊥) (hS : IsSylowOf 3 S K)
    {d : TauCeti.ValidLieTypeIndex} (hd : IsL34Index d)
    (e : ↥K ≃* (TauCeti.CFSGIndex.lie d).Group) {c : A} (hc : c ∈ centralizer (S : Set A))
    {n : ℕ} (hn : c ^ (3 ^ n) = 1) : c ∈ S := by
  by_contra hcS
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hL : IsRankThreeL34 ↥K := isRankThreeL34_of_index hd e
  obtain ⟨Q, hQ⟩ := hS.exists_sylow_eq_subgroupOf
  have hQmem : ∀ x : K, x ∈ (Q : Subgroup ↥K) ↔ (x : A) ∈ S := fun x => by rw [hQ]; rfl
  have hQ9 : Nat.card (Q : Subgroup ↥K) = 9 :=
    CFSG.LocalAnalysis.RankThreeTheoremC.l34SylowCard hL Q
  have hQe := CFSG.LocalAnalysis.RankThreeTheoremC.l34SylowElemAbelian hL Q
  have hS9 : Nat.card S = 9 := by
    have h1 : Nat.card ↥(S.subgroupOf K) = Nat.card ↥S :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS.le).toEquiv
    rw [← h1, ← hQ]
    exact hQ9
  have hScomm : ∀ x ∈ S, ∀ y ∈ S, x * y = y * x := fun x hx y hy =>
    congrArg (fun z : (Q : Subgroup ↥K) => (((z : ↥K)) : A))
      (hQe.1.is_comm.comm ⟨⟨x, hS.le hx⟩, (hQmem _).2 hx⟩ ⟨⟨y, hS.le hy⟩, (hQmem _).2 hy⟩)
  have hSab : CFSG.Open.IsElemAbelian 3 S := by
    refine ⟨⟨⟨fun x y => Subtype.ext (hScomm x x.2 y y.2)⟩⟩, fun x hx => ?_⟩
    have := hQe.2 ⟨x, hS.le hx⟩ ((hQmem _).2 hx)
    exact congrArg (fun z : K => (z : A)) this
  set E : Subgroup A := S ⊔ zpowers c with hE
  have hEp : IsPGroup 3 E :=
    hS.isPGroup.to_sup_of_normal_right' (isPGroup_zpowers hn) (le_normalizer_zpowers hc)
  have hcomm : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x := by
    refine sup_comm_of_comm hScomm (fun x hx y hy => ?_) (fun x hx y hy => ?_)
    · obtain ⟨i, rfl⟩ := mem_zpowers_iff.1 hx
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.1 hy
      exact (Commute.zpow_zpow_self c i j).eq
    · obtain ⟨j, rfl⟩ := mem_zpowers_iff.1 hy
      exact (Commute.zpow_right (show Commute x c from mem_centralizer_iff.1 hc x hx) j).eq
  have hE27 : 27 ≤ Nat.card E := by
    obtain ⟨k, hk⟩ := hEp.exists_card_eq
    have h9 : 9 ∣ 3 ^ k := hk ▸ hS9 ▸ Subgroup.card_dvd_of_le (le_sup_left : S ≤ E)
    have hk2 : 2 ≤ k := (Nat.pow_dvd_pow_iff_le_right (by norm_num : 1 < 3)).1
      (by simpa using h9)
    rcases Nat.lt_or_ge 2 k with h | h
    · rw [hk]
      calc 27 = 3 ^ 3 := by norm_num
        _ ≤ 3 ^ k := Nat.pow_le_pow_right (by norm_num) h
    · exfalso
      have hk2' : k = 2 := by omega
      have hSE : S = E :=
        Subgroup.eq_of_le_of_card_ge le_sup_left (by rw [hk, hk2', hS9]; norm_num)
      exact hcS (hSE ▸ (le_sup_right : zpowers c ≤ E) (mem_zpowers c))
  obtain ⟨R, hER⟩ := hEp.exists_le_sylow
  have hR27 : Nat.card (R : Subgroup A) ≤ 27 := by
    have h1 := CFSG.LocalAnalysis.RankThreeTheoremC.kFactL34OutThree A K inferInstance hC hL R
      R.isPGroup'
    have hRK : Nat.card ((R : Subgroup A) ⊓ K : Subgroup A) ≤ 9 := by
      have hp : IsPGroup 3 (((R : Subgroup A) ⊓ K).subgroupOf K) :=
        (R.isPGroup'.to_inf_left (K := K)).comap_subtype
      obtain ⟨Q', hQ'⟩ := hp.exists_le_sylow
      have h2 := Subgroup.card_le_of_le hQ'
      have h3 := CFSG.LocalAnalysis.RankThreeTheoremC.l34SylowCard hL Q'
      have h4 : Nat.card (((R : Subgroup A) ⊓ K).subgroupOf K) =
          Nat.card ((R : Subgroup A) ⊓ K : Subgroup A) :=
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_right).toEquiv
      omega
    omega
  have hRE : E = R := Subgroup.eq_of_le_of_card_ge hER (by omega)
  have hcommR : ∀ x ∈ (R : Subgroup A), ∀ y ∈ (R : Subgroup A), x * y = y * x := by
    rw [← hRE]
    exact hcomm
  have hSR : S ≤ (R : Subgroup A) := le_sup_left.trans hER
  obtain ⟨θ⟩ := nonempty_equiv_S_of_index hd e
  have key :=
    CFSG.LocalAnalysis.RankThreeTheoremC.BlockB.SylowThreeAbelian.kFactSylowThreeAbelian_l34
      hC θ R hcommR hSR hSab hS9
  have hR27' : 27 ≤ Nat.card (R : Subgroup A) := hRE ▸ hE27
  have := key.2
  omega

theorem l34_solv {K S : Subgroup A} [K.Normal] (hC : centralizer (K : Set A) = ⊥)
    (hS : IsSylowOf 3 S K) {d : TauCeti.ValidLieTypeIndex} (hd : IsL34Index d)
    (e : ↥K ≃* (TauCeti.CFSGIndex.lie d).Group) : Group.IsSolvable ↥(normalizer (S : Set A)) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hL : IsRankThreeL34 ↥K := isRankThreeL34_of_index hd e
  obtain ⟨Q, hQ⟩ := hS.exists_sylow_eq_subgroupOf
  have hQ9 : Nat.card (Q : Subgroup ↥K) = 9 :=
    CFSG.LocalAnalysis.RankThreeTheoremC.l34SylowCard hL Q
  have hCQ : centralizer ((Q : Subgroup ↥K) : Set ↥K) ≤ Q := by
    have hne : (Q : Subgroup ↥K) ≠ ⊥ := by
      intro h
      rw [h, Subgroup.card_bot] at hQ9
      omega
    obtain ⟨⟨u, hu⟩, hu1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hne
    have hu1' : u ≠ 1 := fun h => hu1 (Subtype.ext h)
    exact (Subgroup.centralizer_le (Set.singleton_subset_iff.2 hu)).trans
      (CFSG.LocalAnalysis.RankThreeTheoremC.kFactL34SylowCentralizer ↥K hL Q u hu hu1').le
  have hsolvK : Group.IsSolvable ↥(normalizer ((S.subgroupOf K : Subgroup K) : Set K)) := by
    rw [← hQ]
    exact isSolvable_normalizer_of_card_eq_nine_of_le (by rw [hQ9]; norm_num) hCQ
  exact solvable_of_quotient hS.le hsolvK
