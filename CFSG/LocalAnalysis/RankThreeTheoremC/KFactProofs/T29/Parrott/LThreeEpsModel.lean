structure LModel {X : Type} [Group X] (L : Subgroup X) (π : Bool) (p f : ℕ) (K : Type) [Field K]
    (ν : ↥(slPi π 3 (p ^ f) K) →* ↥L) : Prop where
  piField : PiField π p f K
  modThree : ModThree π (p ^ f)
  two_lt : 2 < p ^ f
  surj : Function.Surjective ν
  ker_scalar : ∀ s, ν s = 1 → (s : GL (Fin 3) K) ∈ StatedScalars (Fin 3) K
  cases : Function.Injective ν ∨
    (Subgroup.center ↥L = ⊥ ∧ ∀ s ∈ Subgroup.center ↥(slPi π 3 (p ^ f) K), ν s = 1)

section Exists

variable {X : Type} [Group X] [Finite X] {L : Subgroup X}

theorem exists_lModel_of_center_eq_bot (hq : CFSG.Open.IsQuasisimple ↥L)
    (hT : IsLThreeEps (↥L ⧸ Subgroup.center ↥L)) (hZ : Subgroup.center ↥L = ⊥) :
    ∃ (π : Bool) (p f : ℕ) (K : Type) (_ : Field K) (ν : ↥(slPi π 3 (p ^ f) K) →* ↥L),
      LModel L π p f K ν := by
  rcases hT with ⟨K, _, _, hK3, ⟨θ⟩⟩ | ⟨K, _, _, q, hKq, hq3, ⟨θ⟩⟩
  · obtain ⟨p, f, hK, hmod⟩ := l3b_exists_piField_true hK3
    have hc := center_slPi_eq hK hmod
    let θ' : (↥L ⧸ Subgroup.center ↥L) ≃* (↥(slPi true 3 (p ^ f) K) ⧸
        (StatedScalars (Fin 3) K).subgroupOf (slPi true 3 (p ^ f) K)) := θ
    let e : ↥L ≃* (↥(slPi true 3 (p ^ f) K) ⧸ Subgroup.center ↥(slPi true 3 (p ^ f) K)) :=
      ((barEquivBot hZ).symm.trans θ').trans (QuotientGroup.quotientMulEquivOfEq hc.symm)
    refine ⟨true, p, f, K, inferInstance,
      e.symm.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥(slPi true 3 (p ^ f) K))),
      ⟨hK, hmod, ?_, ?_, ?_, Or.inr ⟨hZ, fun s hs => ?_⟩⟩⟩
    · have hcard : Nat.card K = p ^ f := hK.card
      have h2 : 2 ≤ Nat.card K := Finite.one_lt_card
      omega
    · intro y
      obtain ⟨s, hs⟩ := QuotientGroup.mk_surjective (e y)
      exact ⟨s, by simp [hs]⟩
    · intro s hs
      have h1 : (QuotientGroup.mk s : ↥(slPi true 3 (p ^ f) K) ⧸
          Subgroup.center ↥(slPi true 3 (p ^ f) K)) = 1 := e.symm.injective (by simpa using hs)
      have h2 := (QuotientGroup.eq_one_iff s).1 h1
      rw [hc, Subgroup.mem_subgroupOf] at h2
      exact h2
    · simp [(QuotientGroup.eq_one_iff s).2 hs]
  · obtain ⟨p, f, rfl, hK, hmod⟩ := l3b_exists_piField_false hKq hq3
    have hc := center_slPi_eq hK hmod
    have h2 : 2 < p ^ f :=
      two_lt_pow_of_quasisimple_statedSU (isQuasisimple_quotient_center hq) hK.unitary θ
    let θ' : (↥L ⧸ Subgroup.center ↥L) ≃* (↥(slPi false 3 (p ^ f) K) ⧸
        (StatedScalars (Fin 3) K).subgroupOf (slPi false 3 (p ^ f) K)) := θ
    let e : ↥L ≃* (↥(slPi false 3 (p ^ f) K) ⧸ Subgroup.center ↥(slPi false 3 (p ^ f) K)) :=
      ((barEquivBot hZ).symm.trans θ').trans (QuotientGroup.quotientMulEquivOfEq hc.symm)
    refine ⟨false, p, f, K, inferInstance,
      e.symm.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥(slPi false 3 (p ^ f) K))),
      ⟨hK, hmod, h2, ?_, ?_, Or.inr ⟨hZ, fun s hs => ?_⟩⟩⟩
    · intro y
      obtain ⟨s, hs⟩ := QuotientGroup.mk_surjective (e y)
      exact ⟨s, by simp [hs]⟩
    · intro s hs
      have h1 : (QuotientGroup.mk s : ↥(slPi false 3 (p ^ f) K) ⧸
          Subgroup.center ↥(slPi false 3 (p ^ f) K)) = 1 := e.symm.injective (by simpa using hs)
      have h2 := (QuotientGroup.eq_one_iff s).1 h1
      rw [hc, Subgroup.mem_subgroupOf] at h2
      exact h2
    · simp [(QuotientGroup.eq_one_iff s).2 hs]

theorem ker_scalar_of_injective {π : Bool} {p f : ℕ} {K : Type} [Field K]
    {ν : ↥(slPi π 3 (p ^ f) K) →* ↥L} (hν : Function.Injective ν) (s : ↥(slPi π 3 (p ^ f) K))
    (hs : ν s = 1) : (s : GL (Fin 3) K) ∈ StatedScalars (Fin 3) K := by
  have : s = 1 := hν (by rw [hs, map_one])
  rw [this]
  exact one_mem _


theorem exists_lModel_of_card_center (hq : CFSG.Open.IsQuasisimple ↥L)
    (hT : IsLThreeEps (↥L ⧸ Subgroup.center ↥L)) (hZ : Nat.card (Subgroup.center ↥L) = 3) :
    ∃ (π : Bool) (p f : ℕ) (K : Type) (_ : Field K) (ν : ↥(slPi π 3 (p ^ f) K) →* ↥L),
      LModel L π p f K ν := by
  haveI : Group.IsPerfect ↥L := (Group.isPerfect_def).2 hq.1
  rcases hT with ⟨K, _, _, hK3, ⟨θ⟩⟩ | ⟨K, _, _, q, hKq, hq3, ⟨θ⟩⟩
  · obtain ⟨p, f, hK, hmod⟩ := l3b_exists_piField_true hK3
    have hcard : Nat.card K = p ^ f := hK.card
    haveI : Fact p.Prime := ⟨hK.prime⟩
    haveI : Fintype K := Fintype.ofFinite K
    haveI : CharP K p := charP_of_card_eq_prime_pow (f := f)
      (by rw [← Nat.card_eq_fintype_card, hcard])
    have hsplit : ∀ (E : Type) [Group E] [Finite E] (ρ : E →* ↥(StatedSL 3 K)),
        Function.Surjective ρ → ρ.ker ≤ Subgroup.center E → Odd (Nat.card ρ.ker) →
        ∃ s : ↥(StatedSL 3 K) →* E, ∀ g, ρ (s g) = g := by
      intro E _ _ ρ hρ hC hodd
      by_cases hp2 : p = 2
      · subst hp2
        obtain ⟨s, hs, -⟩ :=
          CFSG.SectionRank.EvenCover.even_linear_central_odd_extension_splitting_stated
            (n := 3) (by norm_num) hρ hC hodd
        exact ⟨s, hs⟩
      · have hp5 := CFSG.RankThree.PartTwo.Sec4.Census.five_le_of_pow_mod_three hK.prime hp2
          hK.one_le (by rw [← hcard]; omega)
        refine CFSG.RankThree.PartTwo.Sec4.Census.statedSL_three_exists_section ?_ hρ hC
        rw [hcard]
        exact hp5.trans (Nat.le_self_pow (by have := hK.one_le; omega) p)
    obtain ⟨-, ⟨e⟩⟩ := CFSG.QuasithinUnique.Ch1.triple_cover_linear hZ hcard θ hsplit
    have h2 : 2 < p ^ f := by
      have h2 : 2 ≤ Nat.card K := Finite.one_lt_card
      omega
    exact ⟨true, p, f, K, inferInstance, e.symm.toMonoidHom,
      ⟨hK, hmod, h2, e.symm.surjective, ker_scalar_of_injective e.symm.injective,
        Or.inl e.symm.injective⟩⟩
  · obtain ⟨p, f, rfl, hK, hmod⟩ := l3b_exists_piField_false hKq hq3
    have h2 : 2 < p ^ f :=
      two_lt_pow_of_quasisimple_statedSU (isQuasisimple_quotient_center hq) hK.unitary θ
    haveI : Fact p.Prime := ⟨hK.prime⟩
    haveI : CharP K p := hK.unitary.charP
    have hsplit : ∀ (E : Type) [Group E] [Finite E] (ρ : E →* ↥(StatedSU 3 (p ^ f) K)),
        Function.Surjective ρ → ρ.ker ≤ Subgroup.center E → Odd (Nat.card ρ.ker) →
        ∃ s : ↥(StatedSU 3 (p ^ f) K) →* E, ∀ g, ρ (s g) = g := by
      intro E _ _ ρ hρ hC _
      exact CFSG.LieType.Steinberg.CentralExt.SUOdd.statedSU_odd_exists_section_of_central hKq
        hK.one_le (n := 3) le_rfl (by decide)
        (fun h => by have := congrArg Prod.snd h; simp at this; omega) hρ hC
    obtain ⟨-, ⟨e⟩⟩ := CFSG.QuasithinUnique.Ch1.triple_cover_unitary hZ hKq θ hsplit
    exact ⟨false, p, f, K, inferInstance, e.symm.toMonoidHom,
      ⟨hK, hmod, h2, e.symm.surjective, ker_scalar_of_injective e.symm.injective,
        Or.inl e.symm.injective⟩⟩

theorem exists_lModel (hq : CFSG.Open.IsQuasisimple ↥L)
    (hT : IsLThreeEps (↥L ⧸ Subgroup.center ↥L)) (hZ : Nat.card (Subgroup.center ↥L) ∣ 3) :
    ∃ (π : Bool) (p f : ℕ) (K : Type) (_ : Field K) (ν : ↥(slPi π 3 (p ^ f) K) →* ↥L),
      LModel L π p f K ν := by
  rcases (Nat.dvd_prime Nat.prime_three).1 hZ with h1 | h3
  · exact exists_lModel_of_center_eq_bot hq hT (Subgroup.card_eq_one.1 h1)
  · exact exists_lModel_of_card_center hq hT h3

end Exists

namespace LModel

variable {X : Type} [Group X] {L : Subgroup X} {π : Bool} {p f : ℕ} {K : Type} [Field K]
  {ν : ↥(slPi π 3 (p ^ f) K) →* ↥L}

theorem isPerfect (M : LModel L π p f K ν) : Group.IsPerfect ↥(slPi π 3 (p ^ f) K) :=
  (Group.isPerfect_def).2 (isQuasisimple_slPi M.piField (fun _ h => by have := M.two_lt; omega)).1

theorem map_mem_center (M : LModel L π p f K ν) {s : ↥(slPi π 3 (p ^ f) K)}
    (hs : s ∈ Subgroup.center ↥(slPi π 3 (p ^ f) K)) : ν s ∈ Subgroup.center ↥L := by
  rw [Subgroup.mem_center_iff]
  intro l
  obtain ⟨t, rfl⟩ := M.surj l
  rw [← map_mul, ← map_mul, (Subgroup.mem_center_iff.1 hs t)]

theorem mem_center_of_eq_one (M : LModel L π p f K ν) {s : ↥(slPi π 3 (p ^ f) K)}
    (hs : ν s = 1) : s ∈ Subgroup.center ↥(slPi π 3 (p ^ f) K) := by
  rw [center_slPi_eq M.piField M.modThree, Subgroup.mem_subgroupOf]
  exact M.ker_scalar s hs

theorem mem_center_of_map_mem (M : LModel L π p f K ν) {s : ↥(slPi π 3 (p ^ f) K)}
    (hs : ν s ∈ Subgroup.center ↥L) : s ∈ Subgroup.center ↥(slPi π 3 (p ^ f) K) := by
  haveI := M.isPerfect
  have hc : ∀ t : ↥(slPi π 3 (p ^ f) K),
      s * t * s⁻¹ * t⁻¹ ∈ Subgroup.center ↥(slPi π 3 (p ^ f) K) := fun t =>
    M.mem_center_of_eq_one (by
      simp only [map_mul, map_inv]
      rw [← Subgroup.mem_center_iff.1 hs (ν t)]
      group)
  let φ : ↥(slPi π 3 (p ^ f) K) →* Subgroup.center ↥(slPi π 3 (p ^ f) K) :=
    { toFun := fun t => ⟨s * t * s⁻¹ * t⁻¹, hc t⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun a b => by
        apply Subtype.ext
        have hb : a * (s * b * s⁻¹ * b⁻¹) = (s * b * s⁻¹ * b⁻¹) * a :=
          Subgroup.mem_center_iff.1 (hc b) a
        show s * (a * b) * s⁻¹ * (a * b)⁻¹ = (s * a * s⁻¹ * a⁻¹) * (s * b * s⁻¹ * b⁻¹)
        calc s * (a * b) * s⁻¹ * (a * b)⁻¹
            = (s * a * s⁻¹ * a⁻¹) * ((a * (s * b * s⁻¹ * b⁻¹)) * a⁻¹) := by group
          _ = (s * a * s⁻¹ * a⁻¹) * (s * b * s⁻¹ * b⁻¹) := by rw [hb]; group }
  have hker : commutator ↥(slPi π 3 (p ^ f) K) ≤ φ.ker :=
    Abelianization.commutator_subset_ker φ
  rw [Group.IsPerfect.commutator_eq_top] at hker
  rw [Subgroup.mem_center_iff]
  intro t
  have h1 : φ t = 1 := hker (Subgroup.mem_top t)
  have h2 : s * t * s⁻¹ * t⁻¹ = 1 := congrArg Subtype.val h1
  calc t * s = (s * t * s⁻¹ * t⁻¹)⁻¹ * (s * t) := by group
    _ = s * t := by rw [h2, inv_one, one_mul]

@[expose] noncomputable def barEquiv (M : LModel L π p f K ν) :
    (↥(slPi π 3 (p ^ f) K) ⧸ Subgroup.center ↥(slPi π 3 (p ^ f) K)) ≃* (↥L ⧸ Subgroup.center ↥L) :=
  MulEquiv.ofBijective
    (QuotientGroup.map _ _ ν (fun _ hs => Subgroup.mem_comap.2 (M.map_mem_center hs)))
    ⟨by
      rw [injective_iff_map_eq_one]
      intro a ha
      obtain ⟨s, rfl⟩ := QuotientGroup.mk_surjective a
      rw [QuotientGroup.map_mk, QuotientGroup.eq_one_iff] at ha
      exact (QuotientGroup.eq_one_iff s).2 (M.mem_center_of_map_mem ha),
     by
      intro b
      obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective b
      obtain ⟨s, rfl⟩ := M.surj l
      exact ⟨QuotientGroup.mk s, rfl⟩⟩

theorem barEquiv_mk (M : LModel L π p f K ν) (s : ↥(slPi π 3 (p ^ f) K)) :
    M.barEquiv (QuotientGroup.mk s) = QuotientGroup.mk (ν s) :=
  rfl

end LModel

