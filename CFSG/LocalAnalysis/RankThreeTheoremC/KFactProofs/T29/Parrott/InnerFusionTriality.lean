theorem innerFusionE9At_trialityD4 (q : PrimePower) (hv : (LieTypeIndex.trialityD4 q).Valid)
    (hch : q.p ≠ 3) : InnerFusionE9At ⟨.trialityD4 q, hv⟩ := by
  obtain ⟨K, _, _, σ, hK, hσ, -, ⟨e⟩⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_catEquiv_trialityD4 q hv
  refine innerFusionE9At_of_model e fun α hα3 hαo => ?_
  have hσ3 : ∀ c, σ (σ (σ c)) = c := ringEquiv_cube_apply_eq hK hσ
  have hk : Nat.card (CFSG.LieType.Chevalley.fixSubfield σ) = q.p ^ q.exponent :=
    CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube q.prime_p q.exponent_pos hK σ hσ
  have : Finite (CFSG.LieType.Chevalley.fixSubfield σ) := Subtype.finite
  have hk3 : ringChar (CFSG.LieType.Chevalley.fixSubfield σ) ≠ 3 := by
    have : Fact q.p.Prime := ⟨q.prime_p⟩
    have : Fintype (CFSG.LieType.Chevalley.fixSubfield σ) := Fintype.ofFinite _
    have h : Fintype.card (CFSG.LieType.Chevalley.fixSubfield σ) = q.p ^ q.exponent := by
      rw [← Nat.card_eq_fintype_card, hk]
    have : CharP (CFSG.LieType.Chevalley.fixSubfield σ) q.p := charP_of_card_eq_prime_pow h
    rw [ringChar.eq (CFSG.LieType.Chevalley.fixSubfield σ) q.p]
    exact hch
  obtain ⟨Φ⟩ := nonempty_d4SubfieldJ_equiv σ
  have hfix : ∀ s : graphFixedRootGroup TwistTag.D4 K σ.toRingHom,
      fieldActor (t := TwistTag.D4) σ σ s = s → s ^ 3 = 1 →
      FusesIntoFixedE9 (MulAut.conj s * fieldActor (t := TwistTag.D4) σ σ) := fun s hs hs3 =>
    fusesIntoFixedE9_conj_mul_of_g2 hk3 _ (d4SubfieldJ σ) (fun x => mem_d4SubfieldJ hσ3) Φ
      (fun x hx => exists_conj_mem_d4SubfieldJ q.prime_p hch q.exponent_pos hK hσ hx)
      ((mem_d4SubfieldJ hσ3).2 hs) hs3
  have hZ := center_graphFixedRootGroup_eq_bot (t := TwistTag.D4) (σ := σ.toRingHom)
    σ.surjective
  have hδ3 := CFSG.GH74.GLS.Stage2.Bender.Thm1.d4_fieldActor_pow_three K hK σ hσ
  have key : ∀ g : graphFixedRootGroup TwistTag.D4 K σ.toRingHom,
      (MulAut.conj g * fieldActor (t := TwistTag.D4) σ σ) ^ 3 = 1 →
      FusesIntoFixedE9 (MulAut.conj g * fieldActor (t := TwistTag.D4) σ σ) := by
    intro g hg3
    by_cases h2 : q.p = 2
    · have hK2 : Nat.card K = (2 ^ q.exponent) ^ 3 := by rw [← h2]; exact hK
      have hσ2 : ∀ c, σ c = c ^ 2 ^ q.exponent := fun c => by rw [hσ c, h2]
      obtain ⟨β, y, hy, hy3, hβ⟩ :=
        CFSG.RankThree.PartTwo.Sec8.kF82D4LangCoset_holds q.exponent K σ hK2 hσ2 g hg3
      refine FusesIntoFixedE9.of_conj β⁻¹ ?_
      rw [hβ, show β⁻¹ * (β * (MulAut.conj y * fieldActor (t := TwistTag.D4) σ σ) * β⁻¹) *
        β⁻¹⁻¹ = MulAut.conj y * fieldActor (t := TwistTag.D4) σ σ by group]
      exact hfix y hy hy3
    · obtain ⟨y, s, hs, hs3, hys⟩ :=
        CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.ClassOdd.threeD4FixedNF_holds
          q.p q.exponent q.prime_p (q.prime_p.five_le_of_ne_two_of_ne_three h2 hch)
          q.exponent_pos K hK σ hσ g (normSeq_eq_one_of_pow_eq_one hZ hδ3 hg3)
      refine FusesIntoFixedE9.of_conj (MulAut.conj y) ?_
      rw [hys]
      exact hfix s hs hs3
  obtain ⟨g, hg | hg⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_eq_conj_mul_fieldActor_self_of_pow_three
      q.prime_p q.exponent_pos hK σ hσ α hα3 hαo
  · rw [hg] at hα3 ⊢
    exact key g hα3
  · have hα3' : α⁻¹ ^ 3 = 1 := by rw [inv_pow, hα3, inv_one]
    rw [hg] at hα3'
    refine FusesIntoFixedE9.of_inv ?_
    rw [hg]
    exact key g hα3'

