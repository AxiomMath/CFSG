variable [Fintype (WeylGroup .E6)]

theorem parabolicSum_E6_univ_eq (q : ℕ) :
    parabolicSum .E6 Set.univ q = (excE6Full.map fun f => geomSum f.1 f.2 q).prod := by
  rw [parabolicSum_univ, sum_length_E6]
  simp only [excE6Full, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil]
  ring

theorem parabolicSum_E6_coat_eq (i : Fin Tag.E6.rank) (q : ℕ) :
    parabolicSum .E6 (maskSet .E6 (excE6Mask i)) q =
      ((excE6Fac i).map fun f => geomSum f.1 f.2 q).prod := by
  fin_cases i
  · have h := parabolicSum_eq_of_chainCheck q _ _ excE6Coat0_check
    rw [chain_prod_eq, chainFactors_excE6Coat0] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ excE6Coat1_check
    rw [chain_prod_eq, chainFactors_excE6Coat1] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ excE6Coat2_check
    rw [chain_prod_eq, chainFactors_excE6Coat2] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ excE6Coat3_check
    rw [chain_prod_eq, chainFactors_excE6Coat3] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ excE6Coat4_check
    rw [chain_prod_eq, chainFactors_excE6Coat4] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ excE6Coat5_check
    rw [chain_prod_eq, chainFactors_excE6Coat5] at h
    exact h

