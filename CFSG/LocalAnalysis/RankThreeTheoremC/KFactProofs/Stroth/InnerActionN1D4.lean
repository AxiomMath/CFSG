theorem mem_normalizer_of_commute {G : Type*} [Group G] {K : Subgroup G} {g : G}
    (h : ∀ k ∈ K, g * k = k * g) : g ∈ Subgroup.normalizer (K : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  intro k
  have hconj : ∀ k ∈ K, g * k * g⁻¹ = k := fun k hk => by rw [h k hk, mul_inv_cancel_right]
  refine ⟨fun hk => by rw [hconj k hk]; exact hk, fun hk => ?_⟩
  have e1 : g * (g * k * g⁻¹) = (g * k * g⁻¹) * g := h _ hk
  have e2 : g * (g * k * g⁻¹) = g * k := by rw [e1]; group
  rwa [mul_left_cancel e2] at hk

theorem isPGroup_closure_heisenberg {G : Type*} [Group G] {x y : G} (hx : x ^ 3 = 1)
    (hy : y ^ 3 = 1) (hc : ⁅x, y⁆ ^ 3 = 1) (hcx : Commute ⁅x, y⁆ x) (hcy : Commute ⁅x, y⁆ y) :
    IsPGroup 3 (Subgroup.closure {x, y}) := by
  set c : G := ⁅x, y⁆ with hcdef
  have hzp : ∀ g : G, g ^ 3 = 1 → IsPGroup 3 (Subgroup.zpowers g) := fun g hg =>
    IsPGroup.of_card_dvd_pow (n := 1) (by
      rw [Nat.card_zpowers, pow_one]
      exact orderOf_dvd_of_pow_eq_one hg)
  set N : Subgroup G := Subgroup.closure {x, c} with hN
  have hxN : x ∈ N := Subgroup.subset_closure (by simp)
  have hcN : c ∈ N := Subgroup.subset_closure (by simp)
  have hNp : IsPGroup 3 N := by
    refine IsPGroup.to_le (K := Subgroup.zpowers x ⊔ Subgroup.zpowers c) ?_ ?_
    · refine IsPGroup.to_sup_of_normal_right' (hzp x hx) (hzp c hc) ?_
      refine (Subgroup.zpowers_le).2 (mem_normalizer_of_commute fun k hk => ?_)
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hk
      exact (hcx.symm.zpow_right m).eq
    · rw [hN, Subgroup.closure_le]
      rintro g (rfl | rfl)
      · exact Subgroup.mem_sup_left (Subgroup.mem_zpowers _)
      · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
  have hconj : ∀ h ∈ N, y * h * y⁻¹ ∈ N := by
    intro h hh
    induction hh using Subgroup.closure_induction with
    | mem g hg =>
      rcases hg with rfl | rfl
      · have : y * g * y⁻¹ = c⁻¹ * g := by
          rw [hcdef, commutatorElement_def]; group
        rw [this]; exact N.mul_mem (N.inv_mem hcN) hxN
      · rw [← hcy.eq]; simp [hcN]
    | one => simp
    | mul a b _ _ ha hb =>
      have : y * (a * b) * y⁻¹ = (y * a * y⁻¹) * (y * b * y⁻¹) := by group
      rw [this]; exact N.mul_mem ha hb
    | inv a _ ha =>
      have : y * a⁻¹ * y⁻¹ = (y * a * y⁻¹)⁻¹ := by group
      rw [this]; exact N.inv_mem ha
  have hnorm : Subgroup.zpowers y ≤ Subgroup.normalizer (N : Set G) := by
    refine (Subgroup.zpowers_le).2 ?_
    rw [Subgroup.mem_normalizer_iff]
    intro h
    refine ⟨hconj h, fun hh => ?_⟩
    have h3 := hconj _ (hconj _ hh)
    have : y * (y * (y * h * y⁻¹) * y⁻¹) * y⁻¹ = (y * y * y) * h * (y * y * y)⁻¹ := by group
    rwa [this, ← pow_three', hy, inv_one, one_mul, mul_one] at h3
  refine IsPGroup.to_le (IsPGroup.to_sup_of_normal_right' (hzp y hy) hNp hnorm) ?_
  rw [Subgroup.closure_le]
  rintro g (rfl | rfl)
  · exact Subgroup.mem_sup_right hxN
  · exact Subgroup.mem_sup_left (Subgroup.mem_zpowers _)

theorem mem_commutator_of_conj_inv {G : Type*} [Group G] (O : Subgroup G) {g x : G} (hg : g ∈ O)
    (hx : x ∈ O) (h : g * x * g⁻¹ = x⁻¹) (hx3 : x ^ 3 = 1) : x ∈ ⁅O, O⁆ := by
  have h3 : x * x * x = 1 := by rwa [← pow_three']
  have h2 : x * x = x⁻¹ := eq_inv_of_mul_eq_one_left h3
  have hc : ⁅g, x⁆ = x := by
    rw [commutatorElement_def, h, ← mul_inv_rev, h2, inv_inv]
  rw [← hc]
  exact Subgroup.commutator_mem_commutator hg hx

theorem exists_noncomm_pSubgroup_of_hom {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : (ι → F) → F) {G : Type*} [Group G] (φ : G →* GL ι F) {x y : G}
    (hx : φ x ∈ StatedOmega Q) (hy : φ y ∈ StatedOmega Q)
    (hp : IsPGroup 3 (Subgroup.closure {x, y} : Subgroup G))
    (hn : φ ⁅x, y⁆ ∉ StatedScalars ι F) :
    ∃ H : Subgroup (StatedProj (StatedOmega Q)), IsPGroup 3 H ∧
      ∃ a ∈ H, ∃ b ∈ H, a * b ≠ b * a := by
  set C : Subgroup G := Subgroup.closure {x, y} with hC
  have hxC : x ∈ C := Subgroup.subset_closure (by simp)
  have hyC : y ∈ C := Subgroup.subset_closure (by simp)
  have hmem : ∀ g : C, φ g ∈ StatedOmega Q := by
    intro g
    have : C ≤ (StatedOmega Q).comap φ := by
      rw [hC, Subgroup.closure_le]
      rintro g (rfl | rfl)
      · exact hx
      · exact hy
    exact this g.2
  let ψ : C →* StatedProj (StatedOmega Q) :=
    (QuotientGroup.mk' ((StatedScalars ι F).subgroupOf (StatedOmega Q))).comp
      ((φ.comp C.subtype).codRestrict (StatedOmega Q) hmem)
  refine ⟨ψ.range, hp.of_surjective ψ.rangeRestrict ψ.rangeRestrict_surjective,
    ψ ⟨x, hxC⟩, ⟨_, rfl⟩, ψ ⟨y, hyC⟩, ⟨_, rfl⟩, fun h => hn ?_⟩
  have h' : ψ (⟨x, hxC⟩ * ⟨y, hyC⟩) = ψ (⟨y, hyC⟩ * ⟨x, hxC⟩) := by
    rw [map_mul, map_mul]; exact h
  change (QuotientGroup.mk _ : StatedProj (StatedOmega Q)) = QuotientGroup.mk _ at h'
  rw [QuotientGroup.eq_iff_div_mem, Subgroup.mem_subgroupOf] at h'
  change φ (x * y) / φ (y * x) ∈ StatedScalars ι F at h'
  have e : φ ⁅x, y⁆ = φ (x * y) / φ (y * x) := by
    rw [commutatorElement_def, div_eq_mul_inv, ← map_inv, ← map_mul]
    congr 1
    group
  rw [e]; exact h'

section ToGL

variable {ι : Type} [Fintype ι] [DecidableEq ι] {F : Type} [Field F]

@[expose] noncomputable def toGL : ((ι → F) ≃ₗ[F] (ι → F)) ≃* GL ι F :=
  (LinearMap.GeneralLinearGroup.generalLinearEquiv F (ι → F)).symm.trans
    Matrix.GeneralLinearGroup.toLin.symm

theorem toGL_mulVec (g : (ι → F) ≃ₗ[F] (ι → F)) (v : ι → F) :
    ((toGL g : GL ι F) : Matrix ι ι F) *ᵥ v = g v := by
  have h1 := Matrix.GeneralLinearGroup.toLin_apply (toGL g) v
  have h2 : Matrix.GeneralLinearGroup.toLin (toGL g) =
      (LinearMap.GeneralLinearGroup.generalLinearEquiv F (ι → F)).symm g :=
    MulEquiv.apply_symm_apply _ _
  rw [h2] at h1
  simp only [Matrix.mulVecLin_apply] at h1
  rw [← h1]
  rfl

end ToGL

abbrev Plane (F : Type) := F × F

abbrev Planes (F : Type) := Fin 4 → Plane F

section Planar

variable {F : Type} [Field F]

@[expose] noncomputable def phiR (R : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F)) :
    (Planes F ≃ₗ[F] Planes F) →* GL (Fin 4 ⊕ Fin 4) F where
  toFun g := toGL (R.symm.trans (g.trans R))
  map_one' := by
    rw [← map_one (toGL (ι := Fin 4 ⊕ Fin 4) (F := F))]
    congr 1
    ext v
    simp
  map_mul' g h := by
    rw [← map_mul]
    congr 1
    ext v
    simp

theorem phiR_mulVec (R : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F)) (g : Planes F ≃ₗ[F] Planes F)
    (v : Fin 4 ⊕ Fin 4 → F) :
    ((phiR R g : GL (Fin 4 ⊕ Fin 4) F) : Matrix (Fin 4 ⊕ Fin 4) (Fin 4 ⊕ Fin 4) F) *ᵥ v =
      R (g (R.symm v)) :=
  toGL_mulVec (R.symm.trans (g.trans R)) v

theorem phiR_mem_isometryCore (R : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F)) (Q'' : Planes F → F)
    (hR : ∀ u, StatedQuadPlus 4 F (R u) = Q'' u) {g : Planes F ≃ₗ[F] Planes F}
    (hg : ∀ u, Q'' (g u) = Q'' u) : phiR R g ∈ isometryCore (StatedQuadPlus 4 F) := by
  refine Subgroup.subset_closure fun v => ?_
  change StatedQuadPlus 4 F ((phiR R g : Matrix _ _ F) *ᵥ v) = _
  rw [phiR_mulVec, hR, hg, ← hR, LinearEquiv.apply_symm_apply]

theorem phiR_not_scalar (R : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F)) {z : Planes F ≃ₗ[F] Planes F}
    (hz : ¬ ∃ c : F, ∀ u, z u = c • u) :
    phiR R z ∉ StatedScalars (Fin 4 ⊕ Fin 4) F := by
  rintro ⟨c, hc⟩
  apply hz
  refine ⟨(c : F), fun u => ?_⟩
  have h1 := phiR_mulVec R z (R u)
  rw [← hc] at h1
  simp only [LinearEquiv.symm_apply_apply, Matrix.GeneralLinearGroup.coe_scalar,
    Matrix.scalar_apply, Matrix.mulVec_diagonal] at h1
  have h2 : R (z u) = (c : F) • R u := by
    rw [← h1]; funext w; simp
  rw [← LinearEquiv.symm_apply_apply R (z u), h2, map_smul, LinearEquiv.symm_apply_apply]

theorem exists_noncomm_of_planar (R : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F)) (Q'' : Planes F → F)
    (hR : ∀ u, StatedQuadPlus 4 F (R u) = Q'' u)
    {x y g : Planes F ≃ₗ[F] Planes F}
    (hx : ∀ u, Q'' (x u) = Q'' u) (hy : ∀ u, Q'' (y u) = Q'' u) (hg : ∀ u, Q'' (g u) = Q'' u)
    (hgx : g * x * g⁻¹ = x⁻¹) (hgy : g * y * g⁻¹ = y⁻¹)
    (hx3 : x ^ 3 = 1) (hy3 : y ^ 3 = 1) (hz3 : ⁅x, y⁆ ^ 3 = 1)
    (hzx : Commute ⁅x, y⁆ x) (hzy : Commute ⁅x, y⁆ y)
    (hz : ¬ ∃ c : F, ∀ u, ⁅x, y⁆ u = c • u) :
    ∃ H : Subgroup (StatedProj (StatedOmega (StatedQuadPlus 4 F))), IsPGroup 3 H ∧
      ∃ a ∈ H, ∃ b ∈ H, a * b ≠ b * a := by
  have hmem : ∀ {w : Planes F ≃ₗ[F] Planes F}, (∀ u, Q'' (w u) = Q'' u) →
      g * w * g⁻¹ = w⁻¹ → w ^ 3 = 1 → phiR R w ∈ StatedOmega (StatedQuadPlus 4 F) :=
    fun hw hgw hw3 => mem_commutator_of_conj_inv _ (phiR_mem_isometryCore R Q'' hR hg)
      (phiR_mem_isometryCore R Q'' hR hw)
      (by rw [← map_mul, ← map_inv, ← map_mul, hgw, map_inv]) (by rw [← map_pow, hw3, map_one])
  exact exists_noncomm_pSubgroup_of_hom (StatedQuadPlus 4 F) (phiR R) (hmem hx hgx hx3)
    (hmem hy hgy hy3) (isPGroup_closure_heisenberg hx3 hy3 hz3 hzx hzy) (phiR_not_scalar R hz)

end Planar

section Aut

variable {F : Type} [Field F] {V : Type} [AddCommGroup V] [Module F V]

theorem aut_mul_apply (f g : V ≃ₗ[F] V) (v : V) : (f * g) v = f (g v) := rfl

theorem aut_one_apply (v : V) : (1 : V ≃ₗ[F] V) v = v := rfl

theorem aut_inv_apply (f : V ≃ₗ[F] V) (v : V) : f⁻¹ v = f.symm v := rfl

theorem aut_one_symm_apply (v : V) : (1 : V ≃ₗ[F] V).symm v = v := rfl

end Aut

attribute [local simp] aut_mul_apply aut_one_apply aut_inv_apply aut_one_symm_apply

section CharThree

variable {F : Type} [Field F]

@[expose] def splitQ (u : Planes F) : F := ∑ i, (u i).1 * (u i).2

@[expose] def planesEquivSplit (F : Type) [Field F] : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F) where
  toFun u := Sum.elim (fun i => (u i).1) (fun i => (u i).2)
  map_add' u v := by funext w; cases w <;> simp
  map_smul' c u := by funext w; cases w <;> simp
  invFun v := fun i => (v (Sum.inl i), v (Sum.inr i))
  left_inv u := by funext i; simp
  right_inv v := by funext w; cases w <;> simp

theorem planesEquivSplit_isometry (u : Planes F) :
    StatedQuadPlus 4 F (planesEquivSplit F u) = splitQ u := by
  simp [StatedQuadPlus, splitQ, planesEquivSplit]

@[expose] def trFun (i j : Fin 4) (t : F) (u : Planes F) : Planes F := fun k =>
  if k = i then ((u i).1 + t * (u j).1, (u i).2)
  else if k = j then ((u j).1, (u j).2 - t * (u i).2) else u k

theorem trFun_add (i j : Fin 4) (t : F) (u v : Planes F) :
    trFun i j t (u + v) = trFun i j t u + trFun i j t v := by
  funext k
  simp only [trFun, Pi.add_apply]
  split_ifs <;> simp [Prod.ext_iff] <;> ring

theorem trFun_smul (i j : Fin 4) (t c : F) (u : Planes F) :
    trFun i j t (c • u) = c • trFun i j t u := by
  funext k
  simp only [trFun, Pi.smul_apply]
  split_ifs <;> simp [Prod.ext_iff] <;> ring

theorem trFun_trFun {i j : Fin 4} (hij : i ≠ j) (t s : F) (u : Planes F) :
    trFun i j s (trFun i j t u) = trFun i j (s + t) u := by
  funext k
  by_cases hki : k = i
  · subst hki
    simp [trFun, hij, hij.symm]
    ring
  · by_cases hkj : k = j
    · subst hkj
      simp [trFun, hij, hij.symm]
      ring
    · simp [trFun, hki, hkj]

theorem trFun_zero (i j : Fin 4) (u : Planes F) : trFun i j 0 u = u := by
  funext k
  by_cases h1 : k = i
  · subst h1; simp [trFun]
  · by_cases h2 : k = j
    · subst h2; simp [trFun, h1]
    · simp [trFun, h1, h2]

@[expose] def trEquiv (i j : Fin 4) (hij : i ≠ j) (t : F) : Planes F ≃ₗ[F] Planes F where
  toFun := trFun i j t
  map_add' := trFun_add i j t
  map_smul' c u := trFun_smul i j t c u
  invFun := trFun i j (-t)
  left_inv u := by rw [trFun_trFun hij, neg_add_cancel, trFun_zero]
  right_inv u := by rw [trFun_trFun hij, add_neg_cancel, trFun_zero]

@[expose] def negEquiv (i : Fin 4) : Planes F ≃ₗ[F] Planes F where
  toFun u := fun k => if k = i then -u k else u k
  map_add' u v := by
    funext k
    simp only [Pi.add_apply]
    split_ifs
    · exact neg_add _ _
    · rfl
  map_smul' c u := by
    funext k
    simp only [Pi.smul_apply]
    split_ifs
    · exact (smul_neg _ _).symm
    · rfl
  invFun u := fun k => if k = i then -u k else u k
  left_inv u := by
    funext k
    dsimp only
    split_ifs <;> simp
  right_inv u := by
    funext k
    dsimp only
    split_ifs <;> simp

theorem negEquiv_apply (i : Fin 4) (u : Planes F) (k : Fin 4) :
    negEquiv i u k = if k = i then -u k else u k := rfl

theorem negEquiv_symm_apply (i : Fin 4) (u : Planes F) (k : Fin 4) :
    (negEquiv i).symm u k = if k = i then -u k else u k := rfl

@[expose] def leviX : Planes F ≃ₗ[F] Planes F := trEquiv 0 1 (by decide) 1

@[expose] def leviY : Planes F ≃ₗ[F] Planes F := trEquiv 1 2 (by decide) 1

@[expose] def leviZ : Planes F ≃ₗ[F] Planes F := trEquiv 0 2 (by decide) 1

theorem leviX_apply (u : Planes F) : leviX u = trFun 0 1 1 u := rfl

theorem leviY_apply (u : Planes F) : leviY u = trFun 1 2 1 u := rfl

theorem leviZ_apply (u : Planes F) : leviZ u = trFun 0 2 1 u := rfl

theorem leviX_symm_apply (u : Planes F) : leviX.symm u = trFun 0 1 (-1) u := rfl

theorem leviY_symm_apply (u : Planes F) : leviY.symm u = trFun 1 2 (-1) u := rfl

theorem splitQ_leviX (u : Planes F) : splitQ (leviX u) = splitQ u := by
  simp [splitQ, Fin.sum_univ_four, leviX_apply, trFun]; ring

theorem splitQ_leviY (u : Planes F) : splitQ (leviY u) = splitQ u := by
  simp [splitQ, Fin.sum_univ_four, leviY_apply, trFun]; ring

theorem splitQ_negEquiv (i : Fin 4) (u : Planes F) : splitQ (negEquiv i u) = splitQ u := by
  unfold splitQ
  refine Finset.sum_congr rfl fun k _ => ?_
  by_cases h : k = i <;> simp [h, negEquiv_apply]

theorem comm_leviX_leviY : ⁅leviX (F := F), leviY (F := F)⁆ = leviZ (F := F) := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [commutatorElement_def]
  fin_cases k <;> simp [leviX_apply, leviY_apply, leviZ_apply, leviX_symm_apply, leviY_symm_apply,
    trFun, Prod.ext_iff] <;> ring

theorem leviX_pow_three (h3 : (3 : F) = 0) : leviX (F := F) ^ 3 = 1 := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [pow_three']
  fin_cases k <;> simp [leviX_apply, trFun, Prod.ext_iff]
  all_goals first | linear_combination (u 1).1 * h3 | linear_combination (-(u 0).2) * h3

theorem leviY_pow_three (h3 : (3 : F) = 0) : leviY (F := F) ^ 3 = 1 := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [pow_three']
  fin_cases k <;> simp [leviY_apply, trFun, Prod.ext_iff]
  all_goals first | linear_combination (u 2).1 * h3 | linear_combination (-(u 1).2) * h3

theorem leviZ_pow_three (h3 : (3 : F) = 0) : leviZ (F := F) ^ 3 = 1 := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [pow_three']
  fin_cases k <;> simp [leviZ_apply, trFun, Prod.ext_iff]
  all_goals first | linear_combination (u 2).1 * h3 | linear_combination (-(u 0).2) * h3

theorem leviZ_commute_leviX : Commute (leviZ (F := F)) leviX := by
  show leviZ * leviX = leviX * leviZ
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [leviX_apply, leviZ_apply, trFun, Prod.ext_iff] <;> ring

theorem leviZ_commute_leviY : Commute (leviZ (F := F)) leviY := by
  show leviZ * leviY = leviY * leviZ
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [leviY_apply, leviZ_apply, trFun, Prod.ext_iff] <;> ring

theorem negEquiv_one_inv_leviX : negEquiv 1 * leviX (F := F) * (negEquiv 1)⁻¹ = leviX⁻¹ := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [leviX_apply, leviX_symm_apply, negEquiv_apply, negEquiv_symm_apply,
    trFun, Prod.ext_iff] <;> ring

theorem negEquiv_one_inv_leviY : negEquiv 1 * leviY (F := F) * (negEquiv 1)⁻¹ = leviY⁻¹ := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [leviY_apply, leviY_symm_apply, negEquiv_apply, negEquiv_symm_apply,
    trFun, Prod.ext_iff] <;> ring

theorem leviZ_not_scalar : ¬ ∃ c : F, ∀ u, leviZ (F := F) u = c • u := by
  rintro ⟨c, hc⟩
  have := congrFun (hc (Pi.single 2 (1, 0))) 0
  simp [leviZ_apply, trFun, Prod.ext_iff] at this

theorem exists_noncomm_of_charThree (h3 : (3 : F) = 0) :
    ∃ H : Subgroup (StatedProj (StatedOmega (StatedQuadPlus 4 F))), IsPGroup 3 H ∧
      ∃ a ∈ H, ∃ b ∈ H, a * b ≠ b * a := by
  have hz := comm_leviX_leviY (F := F)
  refine exists_noncomm_of_planar (planesEquivSplit F) splitQ planesEquivSplit_isometry
    (x := leviX) (y := leviY) (g := negEquiv 1) splitQ_leviX splitQ_leviY (splitQ_negEquiv 1)
    negEquiv_one_inv_leviX negEquiv_one_inv_leviY (leviX_pow_three h3) (leviY_pow_three h3)
    ?_ ?_ ?_ ?_
  · rw [hz]; exact leviZ_pow_three h3
  · rw [hz]; exact leviZ_commute_leviX
  · rw [hz]; exact leviZ_commute_leviY
  · rw [hz]; exact leviZ_not_scalar

end CharThree

section ThreeNeZero

variable {F : Type} [Field F]

@[expose] def Nf (p : Plane F) : F := p.1 ^ 2 - p.1 * p.2 + p.2 ^ 2

@[expose] def normQ (u : Planes F) : F := ∑ i, Nf (u i)

@[expose] def omegaE : Plane F ≃ₗ[F] Plane F where
  toFun p := (-p.2, p.1 - p.2)
  map_add' p q := by ext <;> simp <;> ring
  map_smul' c p := by ext <;> simp <;> ring
  invFun p := (p.2 - p.1, -p.1)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp

theorem omegaE_apply (p : Plane F) : omegaE p = (-p.2, p.1 - p.2) := rfl

theorem omegaE_symm_apply (p : Plane F) : omegaE.symm p = (p.2 - p.1, -p.1) := rfl

theorem Nf_omegaE (p : Plane F) : Nf (omegaE p) = Nf p := by
  simp [Nf, omegaE_apply]; ring

theorem Nf_omegaE_symm (p : Plane F) : Nf (omegaE.symm p) = Nf p := by
  simp [Nf, omegaE_symm_apply]; ring

theorem omegaE_pow_three (p : Plane F) : omegaE (omegaE (omegaE p)) = p := by
  ext <;> simp [omegaE_apply] <;> ring

theorem omegaE_symm_pow_three (p : Plane F) :
    omegaE.symm (omegaE.symm (omegaE.symm p)) = p := by
  ext <;> simp [omegaE_symm_apply] <;> ring

theorem omegaE_sq (p : Plane F) : omegaE (omegaE p) = omegaE.symm p := by
  ext <;> simp [omegaE_apply, omegaE_symm_apply] <;> ring

@[expose] def blk (A : Fin 4 → (Plane F ≃ₗ[F] Plane F)) : Planes F ≃ₗ[F] Planes F :=
  LinearEquiv.piCongrRight A

theorem blk_apply (A : Fin 4 → (Plane F ≃ₗ[F] Plane F)) (u : Planes F) (k : Fin 4) :
    blk A u k = A k (u k) := rfl

theorem blk_symm_apply (A : Fin 4 → (Plane F ≃ₗ[F] Plane F)) (u : Planes F) (k : Fin 4) :
    (blk A).symm u k = (A k).symm (u k) := rfl

@[expose] def pperm (σ : Equiv.Perm (Fin 4)) : Planes F ≃ₗ[F] Planes F :=
  LinearEquiv.funCongrLeft F (Plane F) σ

theorem pperm_apply (σ : Equiv.Perm (Fin 4)) (u : Planes F) (k : Fin 4) :
    pperm σ u k = u (σ k) := rfl

theorem pperm_symm_apply (σ : Equiv.Perm (Fin 4)) (u : Planes F) (k : Fin 4) :
    (pperm σ).symm u k = u (σ.symm k) := rfl

@[expose] def cyc : Equiv.Perm (Fin 4) :=
  ⟨![1, 2, 0, 3], ![2, 0, 1, 3], by decide, by decide⟩

@[expose] def omegaX : Planes F ≃ₗ[F] Planes F := blk ![omegaE, omegaE.symm, 1, 1]

@[expose] def cycY : Planes F ≃ₗ[F] Planes F := pperm cyc

@[expose] def omegaZ : Planes F ≃ₗ[F] Planes F :=
  blk ![omegaE.symm, omegaE.symm, omegaE.symm, 1]

@[expose] def swapG : Planes F ≃ₗ[F] Planes F := pperm (Equiv.swap 0 1)

theorem omegaX_pow_three : omegaX (F := F) ^ 3 = 1 := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [pow_three']
  fin_cases k <;> simp [omegaX, blk_apply, omegaE_pow_three, omegaE_symm_pow_three]

theorem cycY_pow_three : cycY (F := F) ^ 3 = 1 := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [pow_three']
  fin_cases k <;> simp [cycY, pperm_apply, cyc]

theorem omegaZ_pow_three : omegaZ (F := F) ^ 3 = 1 := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [pow_three']
  fin_cases k <;> simp [omegaZ, blk_apply, omegaE_pow_three, omegaE_symm_pow_three]

theorem comm_omegaX_cycY : ⁅omegaX (F := F), cycY (F := F)⁆ = omegaZ (F := F) := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  rw [commutatorElement_def]
  fin_cases k <;> simp [omegaX, cycY, omegaZ, blk_apply, blk_symm_apply, pperm_apply,
    pperm_symm_apply, cyc, omegaE_sq]

theorem omegaZ_commute_omegaX : Commute (omegaZ (F := F)) omegaX := by
  show omegaZ * omegaX = omegaX * omegaZ
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [omegaX, omegaZ, blk_apply]

theorem omegaZ_commute_cycY : Commute (omegaZ (F := F)) cycY := by
  show omegaZ * cycY = cycY * omegaZ
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [cycY, omegaZ, blk_apply, pperm_apply, cyc]

theorem swapG_inv_omegaX : swapG * omegaX * swapG⁻¹ = (omegaX (F := F))⁻¹ := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [omegaX, swapG, blk_apply, blk_symm_apply, pperm_apply, pperm_symm_apply,
    Equiv.swap_apply_def]

theorem swapG_inv_cycY : swapG * cycY * swapG⁻¹ = (cycY (F := F))⁻¹ := by
  refine LinearEquiv.ext fun u => funext fun k => ?_
  fin_cases k <;> simp [cycY, swapG, pperm_apply, pperm_symm_apply, cyc, Equiv.swap_apply_def]

theorem normQ_omegaX (u : Planes F) : normQ (omegaX u) = normQ u := by
  simp [normQ, Fin.sum_univ_four, omegaX, blk_apply, Nf_omegaE, Nf_omegaE_symm]

theorem normQ_pperm (σ : Equiv.Perm (Fin 4)) (u : Planes F) : normQ (pperm σ u) = normQ u := by
  unfold normQ
  simp only [pperm_apply]
  exact Equiv.sum_comp σ (fun i => Nf (u i))

theorem omegaZ_not_scalar : ¬ ∃ c : F, ∀ u, omegaZ (F := F) u = c • u := by
  rintro ⟨c, hc⟩
  have h3 := congrArg (fun p : Plane F => p.1) (congrFun (hc (Pi.single 3 (1, 0))) 3)
  have h0 := congrArg (fun p : Plane F => p.2) (congrFun (hc (Pi.single 0 (1, 0))) 0)
  simp [omegaZ, blk_apply, omegaE_symm_apply] at h3 h0

theorem normQ_add_single (u : Planes F) (i : Fin 4) (p : Plane F) :
    normQ (u + (Pi.single i p : Planes F)) = normQ u +
      (2 * (u i).1 * p.1 - (u i).1 * p.2 - p.1 * (u i).2 + 2 * (u i).2 * p.2 + Nf p) := by
  unfold normQ
  have h : ∀ k, Nf ((u + (Pi.single i p : Planes F)) k) = Nf (u k) +
      if k = i then (2 * (u i).1 * p.1 - (u i).1 * p.2 - p.1 * (u i).2 + 2 * (u i).2 * p.2 + Nf p)
        else 0 := by
    intro k
    by_cases hk : k = i
    · subst hk; simp [Nf]; ring
    · simp [hk, Pi.single_eq_of_ne hk]
  rw [Finset.sum_congr rfl fun k _ => h k, Finset.sum_add_distrib]
  simp

theorem normQ_single (i : Fin 4) (p : Plane F) : normQ (Pi.single i p : Planes F) = Nf p := by
  have := normQ_add_single (0 : Planes F) i p
  simp [normQ, Nf] at this ⊢
  simpa [Nf] using this

@[expose] def synthFun (s t : F) (u : Planes F) : Fin 4 ⊕ Fin 4 → F :=
  Sum.elim
    ![(u 0).1 + (u 1).1 * (s - t) - (u 1).2 * s,
      (u 0).2 + (u 1).1 * s - (u 1).2 * t,
      (u 2).1 + (u 3).1 * (s - t) - (u 3).2 * s,
      (u 2).2 + (u 3).1 * s - (u 3).2 * t]
    ![(u 0).1 - (u 0).2 - (u 1).1 * (s - t) + (u 1).2 * s,
      (u 0).2 - (u 1).1 * t + (u 1).2 * (t - s),
      (u 2).1 - (u 2).2 - (u 3).1 * (s - t) + (u 3).2 * s,
      (u 2).2 - (u 3).1 * t + (u 3).2 * (t - s)]

@[expose] def synthMap (s t : F) : Planes F →ₗ[F] (Fin 4 ⊕ Fin 4 → F) where
  toFun := synthFun s t
  map_add' u v := by
    funext w
    rcases w with i | i <;> fin_cases i <;> simp [synthFun] <;> ring
  map_smul' c u := by
    funext w
    rcases w with i | i <;> fin_cases i <;> simp [synthFun] <;> ring

theorem synthMap_apply (s t : F) (u : Planes F) : synthMap s t u = synthFun s t u := rfl

theorem synth_isometry (s t : F) (hst : s ^ 2 - s * t + t ^ 2 = -1) (u : Planes F) :
    StatedQuadPlus 4 F (synthMap s t u) = normQ u := by
  simp only [synthMap_apply]
  simp [StatedQuadPlus, normQ, Nf, Fin.sum_univ_four, synthFun]
  linear_combination (-((u 1).1 ^ 2 - (u 1).1 * (u 1).2 + (u 1).2 ^ 2 + (u 3).1 ^ 2 -
    (u 3).1 * (u 3).2 + (u 3).2 ^ 2)) * hst

theorem synthMap_injective (s t : F) (hst : s ^ 2 - s * t + t ^ 2 = -1) (h3 : (3 : F) ≠ 0) :
    Function.Injective (synthMap s t) := by
  rw [injective_iff_map_eq_zero]
  intro u hu
  have key : ∀ w, normQ (u + w) = normQ w := by
    intro w
    rw [← synth_isometry s t hst (u + w), ← synth_isometry s t hst w, map_add, hu, zero_add]
  have h0 : normQ u = 0 := by simpa [normQ, Nf] using key 0
  have hcoord : ∀ i : Fin 4, (u i).1 = 0 ∧ (u i).2 = 0 := by
    intro i
    have hA := key (Pi.single i (1, 0))
    have hB := key (Pi.single i (0, 1))
    rw [normQ_add_single, normQ_single, h0] at hA hB
    simp only [Nf] at hA hB
    have l1 : 2 * (u i).1 - (u i).2 = 0 := by linear_combination hA
    have l2 : 2 * (u i).2 - (u i).1 = 0 := by linear_combination hB
    have h31 : (3 : F) * (u i).1 = 0 := by linear_combination 2 * l1 + l2
    have h32 : (3 : F) * (u i).2 = 0 := by linear_combination l1 + 2 * l2
    exact ⟨(mul_eq_zero.1 h31).resolve_left h3, (mul_eq_zero.1 h32).resolve_left h3⟩
  funext i
  exact Prod.ext (hcoord i).1 (hcoord i).2

theorem finrank_planes : Module.finrank F (Planes F) = Module.finrank F (Fin 4 ⊕ Fin 4 → F) := by
  simp [Module.finrank_pi_fintype, Module.finrank_prod]

@[expose] noncomputable def synthEquiv (s t : F) (hst : s ^ 2 - s * t + t ^ 2 = -1)
    (h3 : (3 : F) ≠ 0) : Planes F ≃ₗ[F] (Fin 4 ⊕ Fin 4 → F) :=
  LinearEquiv.ofBijective (synthMap s t)
    ⟨synthMap_injective s t hst h3,
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank finrank_planes).1
        (synthMap_injective s t hst h3)⟩

open Polynomial in
theorem exists_norm_eq_neg_one [Finite F] (h3 : (3 : F) ≠ 0) :
    ∃ s t : F, s ^ 2 - s * t + t ^ 2 = -1 := by
  haveI := Fintype.ofFinite F
  by_cases h2 : (2 : F) = 0
  · exact ⟨1, 0, by linear_combination h2⟩
  · have hodd : Fintype.card F % 2 = 1 := by
      have hne : ringChar F ≠ 2 := fun h => h2 (by
        have := (ringChar.spec F 2).2 (h ▸ dvd_rfl)
        exact_mod_cast this)
      exact FiniteField.odd_card_of_char_ne_two hne
    have hf : (X ^ 2 : F[X]).degree = 2 := degree_X_pow 2
    have hg : (C 3 * X ^ 2 + 1 : F[X]).degree = 2 := by
      compute_degree!
    obtain ⟨a, b, hab⟩ := FiniteField.exists_root_sum_quadratic hf hg hodd
    refine ⟨a + b, 2 * b, ?_⟩
    simp at hab
    linear_combination hab

theorem exists_noncomm_of_three_ne [Finite F] (h3 : (3 : F) ≠ 0) :
    ∃ H : Subgroup (StatedProj (StatedOmega (StatedQuadPlus 4 F))), IsPGroup 3 H ∧
      ∃ a ∈ H, ∃ b ∈ H, a * b ≠ b * a := by
  obtain ⟨s, t, hst⟩ := exists_norm_eq_neg_one h3
  have hz := comm_omegaX_cycY (F := F)
  refine exists_noncomm_of_planar (synthEquiv s t hst h3) normQ
    (fun u => synth_isometry s t hst u) (x := omegaX) (y := cycY) (g := swapG) normQ_omegaX
    (normQ_pperm cyc) (normQ_pperm _) swapG_inv_omegaX swapG_inv_cycY omegaX_pow_three
    cycY_pow_three ?_ ?_ ?_ ?_
  · rw [hz]; exact omegaZ_pow_three
  · rw [hz]; exact omegaZ_commute_omegaX
  · rw [hz]; exact omegaZ_commute_cycY
  · rw [hz]; exact omegaZ_not_scalar

end ThreeNeZero

theorem exists_noncomm_threeSubgroup (F : Type) [Field F] [Finite F] :
    ∃ H : Subgroup (StatedProj (StatedOmega (StatedQuadPlus 4 F))), IsPGroup 3 H ∧
      ∃ a ∈ H, ∃ b ∈ H, a * b ≠ b * a := by
  by_cases h3 : (3 : F) = 0
  · exact exists_noncomm_of_charThree h3
  · exact exists_noncomm_of_three_ne h3

end N1D4Aux

theorem n1D4_holds : N1D4 := by
  intro K _ _ ℓ f hK S hS hSi
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨-, F, instF, instFin, -, ⟨e⟩⟩ := hK
  obtain ⟨H₀, hH₀, a, ha, b, hb, hab⟩ := N1D4Aux.exists_noncomm_threeSubgroup F
  refine not_isMulCommutative_of_noncomm_pSubgroup (H := H₀.comap e.toMonoidHom)
    (hH₀.comap_of_injective e.toMonoidHom e.injective) (a := e.symm a) (b := e.symm b)
    (by simpa using ha) (by simpa using hb) (fun h => hab ?_) hS hSi
  simpa using congrArg e h

end CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.Stroth.InnerAction
