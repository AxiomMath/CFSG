theorem j1_exists_involution_commuting {G : Type} [Group G] [Finite G]
    (hcard : Nat.card G = 175560)
    (hcent : ∀ t : G, orderOf t = 2 → Nat.card (Subgroup.centralizer ({t} : Set G)) = 120)
    (z : G) (hz : orderOf z = 3) :
    ∃ t : G, orderOf t = 2 ∧ z * t = t * z := by
  obtain ⟨t0, ht0⟩ : ∃ t0 : G, orderOf t0 = 2 := by
    have h2 : 2 ∣ Nat.card G := by rw [hcard]; norm_num
    exact exists_prime_orderOf_dvd_card' 2 h2
  obtain ⟨z0, hz0⟩ : ∃ z0 : Subgroup.centralizer ({t0} : Set G), orderOf z0 = 3 := by
    have h3 : 3 ∣ Nat.card (Subgroup.centralizer ({t0} : Set G)) := by
      rw [hcent t0 ht0]; norm_num
    exact exists_prime_orderOf_dvd_card' 3 h3
  have hz0G : orderOf (z0 : G) = 3 := by rw [Subgroup.orderOf_coe, hz0]
  have hcomm : Commute (z0 : G) t0 := Subgroup.mem_centralizer_singleton_iff.mp z0.2
  have hidx : ∀ H : Subgroup G, Nat.card H = 3 → ¬ 3 ∣ H.index := by
    intro H hH hdvd
    have h := Subgroup.card_mul_index (H := H)
    rw [hH, hcard] at h
    obtain ⟨c, hc⟩ := hdvd
    rw [hc] at h
    omega
  obtain ⟨P1, hP1⟩ : ∃ P : Sylow 3 G, (P : Subgroup G) = Subgroup.zpowers z := by
    have hH : IsPGroup 3 (Subgroup.zpowers z) :=
      IsPGroup.of_card (n := 1) (by simp [Nat.card_zpowers, hz])
    exact ⟨hH.toSylow (hidx _ (by simp [Nat.card_zpowers, hz])), rfl⟩
  obtain ⟨P2, hP2⟩ : ∃ P : Sylow 3 G, (P : Subgroup G) = Subgroup.zpowers (z0 : G) := by
    have hH : IsPGroup 3 (Subgroup.zpowers (z0 : G)) :=
      IsPGroup.of_card (n := 1) (by simp [Nat.card_zpowers, hz0G])
    exact ⟨hH.toSylow (hidx _ (by simp [Nat.card_zpowers, hz0G])), rfl⟩
  haveI : Finite (Sylow 3 G) :=
    Finite.of_injective (fun P : Sylow 3 G => (P : Set G)) SetLike.coe_injective
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P2 P1
