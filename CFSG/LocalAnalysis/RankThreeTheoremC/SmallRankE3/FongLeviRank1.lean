theorem a1_false {A : Type} [Group A] [Finite A] {K K₀ B : Subgroup A} {z : A} {p : ℕ}
    (S : E3Setting K K₀ B z p) {q : PrimePower} (hq2 : q.p = 2)
    (hv : (LieTypeIndex.A 1 q).Valid)
    (e : Nonempty (↥K ≃* ValidLieTypeIndex.Group ⟨.A 1 q, hv⟩)) : False := by
  obtain ⟨e⟩ := e
  have hL := CFSG.Models.lieModel_A 1 q hv e
  rw [hq2] at hL
  obtain ⟨-, h | ⟨h0, -⟩⟩ := hL
  · have hB : fusionIsBenderGroup ↥K :=
      CFSG.QuasithinUnique.A5.C25.fusionIsBenderGroup_of_isPSL (n := q.exponent) (X := ↥K) h
    exact CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KPCov.false_of_bender S.hp
      (by have := S.hp5; omega) hB S.hpar S.hne S.hcore
  · omega

theorem tA2_false {A : Type} [Group A] [Finite A] {K K₀ B : Subgroup A} {z : A} {p : ℕ}
    (S : E3Setting K K₀ B z p) {q : PrimePower} (hq2 : q.p = 2)
    (hv : (LieTypeIndex.twistedA 2 q).Valid)
    (e : Nonempty (↥K ≃* ValidLieTypeIndex.Group ⟨.twistedA 2 q, hv⟩)) : False := by
  obtain ⟨e⟩ := e
  have hL := CFSG.Models.lieModel_twistedA 2 q hv e
  have hc : ValidLieTypeIndex.characteristic ⟨.twistedA 2 q, hv⟩ = 2 :=
    (LieTypeIndex.characteristic_twistedA 2 q).trans hq2
  have hf : ValidLieTypeIndex.fieldExponent ⟨.twistedA 2 q, hv⟩ = q.exponent :=
    LieTypeIndex.fieldExponent_twistedA 2 q
  rw [hc, hf] at hL
  have h3 : 3 ≤ q.card := ((LieTypeIndex.inStandardRange_iff _).mp
    ((LieTypeIndex.valid_iff _).mp hv).1).2 rfl
  have hq : q.card = q.p ^ q.exponent := PrimePower.card_def q
  rw [hq2] at hq
  have hf2 : 2 ≤ q.exponent := by
    by_contra hlt
    have h1 : q.exponent = 1 := by have := q.exponent_pos; omega
    rw [h1, pow_one] at hq
    omega
  obtain ⟨-, h | ⟨h0, -⟩⟩ := hL
  · have hB : fusionIsBenderGroup ↥K :=
      CFSG.Quasithin.GoldMLA.fusionIsBenderGroup_of_isPSU3 (X := ↥K) hf2 h
    exact CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KPCov.false_of_bender S.hp
      (by have := S.hp5; omega) hB S.hpar S.hne S.hcore
  · omega

theorem suz_false {A : Type} [Group A] [Finite A] {K K₀ B : Subgroup A} {z : A} {p : ℕ}
    (S : E3Setting K K₀ B z p) {m : ℕ} (hv : (LieTypeIndex.suzuki m).Valid)
    (e : Nonempty (↥K ≃* ValidLieTypeIndex.Group ⟨.suzuki m, hv⟩)) : False := by
  obtain ⟨e⟩ := e
  have hm : 1 ≤ m := (LieTypeIndex.inStandardRange_iff _).mp
    ((LieTypeIndex.valid_iff _).mp hv).1
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hK : Nat.card (GaloisField 2 (2 * m + 1)) = 2 ^ (2 * m + 1) :=
    GaloisField.card 2 (2 * m + 1) (by omega)
  have hS : CFSG.Blueprint.SuzukiModel ↥K 2 (2 * m + 1) :=
    ⟨rfl, m, hm, GaloisField 2 (2 * m + 1), inferInstance, inferInstance, rfl, hK,
      ⟨(e.trans (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv)).trans
        (CFSG.ShultStronglyClosedTI.SuzukiModel.suzukiGroupEquivSuzukiMatrixGroup hK).symm⟩⟩
  have hB : fusionIsBenderGroup ↥K :=
    CFSG.QuasithinUnique.A5.C25.fusionIsBenderGroup_of_isSz (n := 2 * m + 1) (X := ↥K) hS
  exact CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KPCov.false_of_bender S.hp
    (by have := S.hp5; omega) hB S.hpar S.hne S.hcore

end CFSG.LocalAnalysis.RankThreeTheoremC.SmallRankE3.FongLevi
