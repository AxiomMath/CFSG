variable {p : ℕ} [Fact p.Prime] {C : Subgroup G}
  {K : Subgroup (C ⧸ primeComplementCore (G := C) p)} [hK : K.Normal]

local notation "φ" => RankOneSylow.act (primeComplementCore (G := C) p) K

theorem mem_of_mem_normalizer_inf {P : Sylow p G} {M : Subgroup G}
    (hcore : GLBWeakCore p (P : Subgroup G) ≤ M) (hp2 : p ≠ 2)
    (hZ : Subgroup.center ↥K = ⊥) (hK1 : 1 ≤ Open.pRank p (⊤ : Subgroup ↥K))
    (hXM : d1PlusCore p C K ≤ M) (hXr : Open.pRank p (d1PlusCore p C K) ≤ 1)
    {B E : Subgroup G} {b : G} (hBC : CFSG.ABGLocalTools.IsSylowOf p B C) (hBM : B ≤ M)
    (hbB : b ∈ B) (hb : ∀ c ∈ C, b * c = c * b) (hbo : orderOf b = p)
    (hE : IsElemAbelian p E) (hEc : Nat.card E = p ^ 3) (hEB : E ≤ B) :
    ∀ k ∈ hyp111Pre p C K,
      k ∈ Subgroup.normalizer ((B ⊓ hyp111Pre p C K : Subgroup G) : Set G) → k ∈ M := by
  intro k hkK hkN
  have hkC : k ∈ C := Subgroup.map_subtype_le _ hkK
  exact le_of_act_mem_normalizer hcore hp2 hZ hK1 hXM hXr hBC hBM hbB hb hbo hE hEc hEB
    (c := ⟨k, hkC⟩) (Subgroup.le_normalizer_map φ
      ⟨⟨k, hkC⟩, Subgroup.le_normalizer_comap C.subtype hkN, rfl⟩)

theorem exists_mem_inf_of_mem_elem (hI2 : KFactStepThreeIrred) (hI5 : KFactStepThreeCentSylow)
    {P : Sylow p G} {M : Subgroup G} (hcore : GLBWeakCore p (P : Subgroup G) ≤ M) (hp2 : p ≠ 2)
    (hZ : Subgroup.center ↥K = ⊥) (hK1 : 1 ≤ Open.pRank p (⊤ : Subgroup ↥K))
    (hSt : StepThreeGroup p ↥K)
    (hKe : ∀ T : Sylow p ↥K, ∀ x ∈ (T : Subgroup ↥K), x ^ p = 1 ∧
      ∀ y ∈ (T : Subgroup ↥K), x * y = y * x)
    (hXM : d1PlusCore p C K ≤ M) (hXr : Open.pRank p (d1PlusCore p C K) ≤ 1)
    {B E : Subgroup G} {b : G} (hBC : CFSG.ABGLocalTools.IsSylowOf p B C) (hBM : B ≤ M)
    (hbB : b ∈ B) (hb : ∀ c ∈ C, b * c = c * b) (hbo : orderOf b = p)
    (hE : IsElemAbelian p E) (hEc : Nat.card E = p ^ 3) (hEB : E ≤ B)
    {L : Subgroup G} (hML : M ≤ Subgroup.normalizer (L : Set G))
    (hCL : ¬ CFSG.HasNormalPComplement p ↥(C ⊓ L)) :
    ∀ u ∈ B ⊓ hyp111Pre p C K, ∃ w ∈ C ⊓ L, w⁻¹ * u ∈ d1PlusCore p C K := by
  have hBp : IsPGroup p B := hBC.isPGroup
  have hBC' : B ≤ C := hBC.le
  have hSe : ∀ x ∈ ((B ⊓ hyp111Pre p C K).subgroupOf C).map φ, x ^ p = 1 ∧
      ∀ y ∈ ((B ⊓ hyp111Pre p C K).subgroupOf C).map φ, x * y = y * x := by
    obtain ⟨T', hT'⟩ := exists_sylow_act hZ hBC
    rw [hT']
    rintro _ ⟨t, ht, rfl⟩
    obtain ⟨htp, htc⟩ := hKe T' t ht
    refine ⟨by rw [← map_pow, htp, map_one], ?_⟩
    rintro _ ⟨s, hs, rfl⟩
    rw [← map_mul, ← map_mul, htc s hs]
  set S : Subgroup (MulAut ↥K) := ((B ⊓ hyp111Pre p C K).subgroupOf C).map φ with hS
  set Ll : Subgroup (MulAut ↥K) := ((C ⊓ L).subgroupOf C).map φ with hLl
  set Bb : Subgroup (MulAut ↥K) := (B.subgroupOf C).map φ with hBbdef
  set T : Subgroup (MulAut ↥K) := ((B ⊓ L).subgroupOf C).map φ with hTdef
  have hnp : ¬ CFSG.HasNormalPComplement p ↥Ll := fun h =>
    hCL (hasNormalPComplement_of_act hp2 hXr (hBC.le hbB) hb hbo inf_le_left h)
  have hBbp : IsPGroup p Bb := (hBp.of_equiv (Subgroup.subgroupOfEquivOfLe hBC').symm).map φ
  have hSB : S ≤ Bb := Subgroup.map_mono fun x hx =>
    Subgroup.mem_subgroupOf.mpr (Subgroup.mem_subgroupOf.mp hx).1
  have hTB : T ≤ Bb := Subgroup.map_mono fun x hx =>
    Subgroup.mem_subgroupOf.mpr (Subgroup.mem_subgroupOf.mp hx).1
  have hTL : T ≤ Ll := Subgroup.map_mono fun x hx =>
    Subgroup.mem_subgroupOf.mpr ⟨x.2, (Subgroup.mem_subgroupOf.mp hx).2⟩
  have hBT : Bb ≤ Subgroup.normalizer (T : Set (MulAut ↥K)) := by
    rintro _ ⟨c, hc, rfl⟩
    have hcB : (c : G) ∈ B := Subgroup.mem_subgroupOf.mp hc
    refine Subgroup.le_normalizer_map φ ⟨c, ?_, rfl⟩
    exact Subgroup.le_normalizer_comap C.subtype (Subgroup.inf_normalizer_le_normalizer_inf
      ⟨Subgroup.le_normalizer hcB, hML (hBM hcB)⟩)
  have hIN : (MulAut.conj : ↥K →* MulAut ↥K).range ⊓ Subgroup.normalizer (S : Set (MulAut ↥K)) ≤
      Subgroup.normalizer (Ll : Set (MulAut ↥K)) := by
    rintro σ ⟨hσI, hσN⟩
    rw [← map_comap_act_eq] at hσI
    obtain ⟨c, -, rfl⟩ := hσI
    have hcM := le_of_act_mem_normalizer hcore hp2 hZ hK1 hXM hXr hBC hBM hbB hb hbo hE hEc hEB
      hσN
    refine Subgroup.le_normalizer_map φ ⟨c, ?_, rfl⟩
    exact Subgroup.le_normalizer_comap C.subtype (Subgroup.inf_normalizer_le_normalizer_inf
      ⟨Subgroup.le_normalizer c.2, hML hcM⟩)
  have hT : T ≠ ⊥ := by
    intro hT0
    apply hnp
    have hBn : B ≤ Subgroup.normalizer ((C ⊓ L : Subgroup G) : Set G) := fun g hg =>
      Subgroup.inf_normalizer_le_normalizer_inf ⟨Subgroup.le_normalizer (hBC' hg), hML (hBM hg)⟩
    have hBX := hBC.of_le (L := B ⊔ (C ⊓ L)) le_sup_left (sup_le hBC' inf_le_left)
    obtain ⟨Q, hQ⟩ := hBX.inf_of_le_normalizer (le_sup_right : C ⊓ L ≤ B ⊔ (C ⊓ L))
      (sup_le hBn Subgroup.le_normalizer)
    set g : ↥(C ⊓ L) →* MulAut ↥K := MonoidHom.comp φ (Subgroup.inclusion inf_le_left) with hg
    have hgr : g.range = Ll := by
      rw [hg, MonoidHom.range_comp, Subgroup.inclusion_range]
    rw [← hgr]
    refine
      CFSG.LocalAnalysis.GLTheoremB.MovingAround.InputsMisc7.hasNormalPComplement_of_not_dvd_card
      fun hdvd => ?_
    have hne := Sylow.ne_bot_of_dvd_card (Q.mapSurjective g.rangeRestrict_surjective) hdvd
    obtain ⟨⟨x, hx⟩, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
    rw [Sylow.coe_mapSurjective] at hx
    obtain ⟨q, hq, rfl⟩ := hx
    apply hx1
    have hqB : ((q : ↥(C ⊓ L)) : G) ∈ B := by
      have : ((q : ↥(C ⊓ L)) : G) ∈ (Q : Subgroup ↥(C ⊓ L)).map (C ⊓ L).subtype := ⟨q, hq, rfl⟩
      rw [hQ] at this
      exact this.1
    have hmT : g q ∈ T := ⟨Subgroup.inclusion inf_le_left q,
      Subgroup.mem_subgroupOf.mpr ⟨hqB, q.2.2⟩, rfl⟩
    rw [hT0, Subgroup.mem_bot] at hmT
    exact Subtype.ext (Subtype.ext hmT)
  have hle := le_of_ne_bot_of_elem hI2 hI5 conj_range_normal (centralizer_conj_range_eq_bot hZ)
    (stepThreeGroup_conj_range hZ hSt) (isSylowOf_act hZ hBC) hSe hBbp hSB hTB hBT hTL hT hIN
  intro u hu
  have huC : u ∈ C := hBC.le hu.1
  have hu' : (⟨u, huC⟩ : C) ∈ (B ⊓ hyp111Pre p C K).subgroupOf C := Subgroup.mem_subgroupOf.mpr hu
  obtain ⟨w, hw, he⟩ := hle ⟨_, hu', rfl⟩
  refine ⟨w, Subgroup.mem_subgroupOf.mp hw, ?_⟩
  have hk : w⁻¹ * ⟨u, huC⟩ ∈ MonoidHom.ker φ := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, he, inv_mul_cancel]
  exact (mem_d1PlusCore_iff_mem_ker _).mpr hk

theorem pow_eq_one_of_mem_inf_elem (hZ : Subgroup.center ↥K = ⊥)
    (hKe : ∀ T : Sylow p ↥K, ∀ x ∈ (T : Subgroup ↥K), x ^ p = 1 ∧
      ∀ y ∈ (T : Subgroup ↥K), x * y = y * x)
    {B : Subgroup G} (hBC : CFSG.ABGLocalTools.IsSylowOf p B C) :
    ∀ u ∈ B ⊓ hyp111Pre p C K, u ^ p = 1 := by
  intro u hu
  have huC : u ∈ C := hBC.le hu.1
  obtain ⟨T', hT'⟩ := exists_sylow_act hZ hBC
  have hφu : φ ⟨u, huC⟩ ∈ ((B ⊓ hyp111Pre p C K).subgroupOf C).map φ :=
    ⟨⟨u, huC⟩, Subgroup.mem_subgroupOf.mpr hu, rfl⟩
  rw [hT'] at hφu
  obtain ⟨t, ht, hte⟩ := hφu
  have hker : (⟨u, huC⟩ : C) ^ p ∈ MonoidHom.ker φ := by
    rw [MonoidHom.mem_ker, map_pow, ← hte, ← map_pow, (hKe T' t ht).1, map_one]
  have hX := (mem_d1PlusCore_iff_mem_ker _).mpr hker
  obtain ⟨n, hn⟩ := hBC.isPGroup ⟨u ^ p, B.pow_mem hu.1 p⟩
  exact eq_one_of_mem_inf hZ (Subgroup.pow_mem _ hu.2 p) (by simpa using hX)
    (n := n) (by simpa using congrArg Subtype.val hn)

theorem le_card_inf (hZ : Subgroup.center ↥K = ⊥)
    (hKc : ∀ T : Sylow p ↥K, p ^ 2 ≤ Nat.card T) {B : Subgroup G}
    (hBC : CFSG.ABGLocalTools.IsSylowOf p B C) : p ^ 2 ≤ Nat.card ↥(B ⊓ hyp111Pre p C K) := by
  obtain ⟨T', hT'⟩ := exists_sylow_act hZ hBC
  have h1 : Nat.card ↥(((B ⊓ hyp111Pre p C K).subgroupOf C).map φ) = Nat.card T' := by
    rw [hT', Subgroup.card_map_of_injective (conj_injective_of_center hZ)]
  have h2 := Nat.card_le_card_of_surjective _
    (MonoidHom.subgroupMap_surjective φ ((B ⊓ hyp111Pre p C K).subgroupOf C))
  rw [h1, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (inf_le_left.trans hBC.le)).toEquiv] at h2
  exact (hKc T').trans h2

theorem forall_comm_mem_of_irred (hI2 : KFactStepThreeIrred) (hSt : StepThreeGroup p ↥K)
    (hKe : ∀ T : Sylow p ↥K, ∀ x ∈ (T : Subgroup ↥K), x ^ p = 1 ∧
      ∀ y ∈ (T : Subgroup ↥K), x * y = y * x)
    {B L M : Subgroup G} (hBC : CFSG.ABGLocalTools.IsSylowOf p B C) (hBM : B ≤ M)
    (hML : M ≤ Subgroup.normalizer (L : Set G))
    (hN₀M : ∀ k ∈ hyp111Pre p C K,
      k ∈ Subgroup.normalizer ((B ⊓ hyp111Pre p C K : Subgroup G) : Set G) → k ∈ M)
    {z : G} (hzB : z ∈ B ⊓ hyp111Pre p C K) (hz1 : z ≠ 1)
    (hzL : ∀ l ∈ L, z * l * z⁻¹ * l⁻¹ ∈ pCoreOf 2 L) :
    ∀ u ∈ B ⊓ hyp111Pre p C K, ∀ l ∈ L, u * l * u⁻¹ * l⁻¹ ∈ pCoreOf 2 L := by
  set O := primeComplementCore (G := C) p with hO
  set Kp := hyp111Pre p C K with hKp
  set B₁ := B ⊓ Kp with hB₁
  set Kc : Subgroup C := K.comap (QuotientGroup.mk' O) with hKc
  have hKpC : Kp ≤ C := Subgroup.map_subtype_le _
  have hKpc : Kp.subgroupOf C = Kc :=
    Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
  set θ : ↥Kc →* ↥K := (QuotientGroup.mk' O).subgroupComap K with hθ
  have hθs : Function.Surjective θ :=
    MonoidHom.subgroupComap_surjective _ _ (QuotientGroup.mk'_surjective O)
  set ι : ↥Kc →* G := C.subtype.comp Kc.subtype with hι
  have hker : Nat.Coprime (Nat.card θ.ker) p := by
    let f : ↥θ.ker →* ↥O :=
      { toFun := fun y => ⟨((y : ↥Kc) : C), (QuotientGroup.eq_one_iff _).mp
          (congrArg Subtype.val (MonoidHom.mem_ker.mp y.2))⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    have hf : Function.Injective f := fun a b hab => by
      have h := congrArg (fun z : ↥O => (z : C)) hab
      exact Subtype.ext (Subtype.ext h)
    exact (primeComplementCore_coprime p).symm.coprime_dvd_left
      (Subgroup.card_dvd_of_injective f hf)
  have hB₁syl : CFSG.ABGLocalTools.IsSylowOf p B₁ Kp :=
    hBC.inf_of_le_normalizer hKpC (le_normalizer_hyp111Pre hK)
  have hB₁c : CFSG.ABGLocalTools.IsSylowOf p (B₁.subgroupOf C) Kc := by
    rw [← hKpc, ← CFSG.ABGLocalTools.isSylowOf_map_subtype_iff C, Subgroup.subgroupOf_map_subtype,
      Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr (inf_le_right.trans hKpC),
      inf_eq_left.mpr hKpC]
    exact hB₁syl
  obtain ⟨Q, hQ⟩ := hB₁c
  have hmemQ : ∀ y : ↥Kc, y ∈ (Q : Subgroup ↥Kc) ↔ ι y ∈ B₁ := by
    intro y
    constructor
    · intro hy
      have h : (y : C) ∈ (Q : Subgroup ↥Kc).map Kc.subtype := ⟨y, hy, rfl⟩
      rw [hQ] at h
      exact Subgroup.mem_subgroupOf.mp h
    · intro hy
      have h : (y : C) ∈ B₁.subgroupOf C := Subgroup.mem_subgroupOf.mpr hy
      rw [← hQ] at h
      obtain ⟨y', hy', he⟩ := h
      rwa [Subtype.ext he] at hy'
  have hpreK : ∀ h ∈ Kp, ∃ y : ↥Kc, ι y = h := by
    rintro _ ⟨h', hh', rfl⟩
    exact ⟨⟨h', hh'⟩, rfl⟩
  have hιK : ∀ y : ↥Kc, ι y ∈ Kp := fun y => ⟨(y : C), y.2, rfl⟩
  have hconj : ∀ g ∈ Subgroup.normalizer ((Q : Subgroup ↥Kc) : Set ↥Kc), ∀ h ∈ B₁,
      ι g * h * (ι g)⁻¹ ∈ B₁ := by
    intro g hg h hh
    obtain ⟨y, rfl⟩ := hpreK h hh.2
    have hyQ := (hmemQ y).mpr hh
    have := (hmemQ _).mp ((Subgroup.mem_normalizer_iff.mp hg y).mp hyQ)
    simpa using this
  have hgM : ∀ g ∈ Subgroup.normalizer ((Q : Subgroup ↥Kc) : Set ↥Kc), ι g ∈ M := by
    intro g hg
    refine hN₀M _ (hιK g) (Subgroup.mem_normalizer_iff.mpr fun h => ⟨hconj g hg h, fun hh => ?_⟩)
    have := hconj g⁻¹ (Subgroup.inv_mem _ hg) _ hh
    simpa [mul_assoc] using this
  have hker1 : ∀ x ∈ (Q : Subgroup ↥Kc), θ x = 1 → x = 1 := by
    intro x hx h1
    obtain ⟨n, hn⟩ := Q.2 ⟨x, hx⟩
    have hxn : x ^ (p ^ n) = 1 := by simpa using congrArg Subtype.val hn
    have hxk : x ^ Nat.card θ.ker = 1 := by
      have := pow_card_eq_one' (G := ↥θ.ker) (x := ⟨x, h1⟩)
      simpa using congrArg Subtype.val this
    have h := mem_of_pow_mem_of_coprime' (H := ⊥) (Nat.Coprime.pow_right n hker)
      (by rw [hxk]; exact Subgroup.one_mem _) (by rw [hxn]; exact Subgroup.one_mem _)
    exact Subgroup.mem_bot.mp h
  have hθQ : ∀ x ∈ (Q : Subgroup ↥Kc), θ x ∈ ((Q.mapSurjective hθs : Sylow p ↥K) : Subgroup ↥K) :=
    fun x hx => by
      rw [Sylow.coe_mapSurjective]
      exact ⟨x, hx, rfl⟩
  have hQe : ∀ x ∈ (Q : Subgroup ↥Kc), x ^ p = 1 ∧ ∀ y ∈ (Q : Subgroup ↥Kc), x * y = y * x := by
    intro x hx
    obtain ⟨hxp, hxc⟩ := hKe _ _ (hθQ x hx)
    refine ⟨hker1 _ (Subgroup.pow_mem _ hx p) (by rw [map_pow, hxp]), fun y hy => ?_⟩
    have h := hker1 (x * y * x⁻¹ * y⁻¹)
      (Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hx hy) (Subgroup.inv_mem _ hx))
        (Subgroup.inv_mem _ hy))
      (by rw [map_mul, map_mul, map_mul, map_inv, map_inv, hxc _ (hθQ y hy)]; group)
    calc x * y = (x * y * x⁻¹ * y⁻¹) * (y * x) := by group
      _ = y * x := by rw [h, one_mul]
  have hΦ : frattini ↥(Q : Subgroup ↥Kc) = ⊥ := by
    haveI : CFSG.IsElementaryAbelian p ↥(Q : Subgroup ↥Kc) :=
      { is_comm := ⟨fun a b => Subtype.ext ((hQe a a.2).2 b b.2)⟩
        exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one fun a =>
          Subtype.ext (by simpa using (hQe a a.2).1) }
    haveI : Fact (IsPGroup p ↥(Q : Subgroup ↥Kc)) := ⟨Q.2⟩
    exact CFSG.frattini_eq_bot_of_isElementaryAbelian (p := p)
  have hirr := irred_of_irred_map θ hker hθs Q (hI2 p ↥K hSt (Q.mapSurjective hθs)).1
  set V : Subgroup ↥Kc := (Q : Subgroup ↥Kc) ⊓ (centQuot L).comap ι with hV
  have hzC : z ∈ centQuot L := ⟨hML (hBM hzB.1), hzL⟩
  obtain ⟨yz, hyz⟩ := hpreK z hzB.2
  have hVΦ : ¬ V ≤ (frattini ↥(Q : Subgroup ↥Kc)).map (Q : Subgroup ↥Kc).subtype := by
    rw [hΦ, Subgroup.map_bot]
    intro h
    have hyzV : yz ∈ V := ⟨(hmemQ yz).mpr (hyz ▸ hzB), show ι yz ∈ centQuot L from hyz ▸ hzC⟩
    have := h hyzV
    rw [Subgroup.mem_bot] at this
    apply hz1
    rw [← hyz, this, map_one]
  have hNV : Subgroup.normalizer ((Q : Subgroup ↥Kc) : Set ↥Kc) ≤
      Subgroup.normalizer (V : Set ↥Kc) := fun g hg =>
    Subgroup.inf_normalizer_le_normalizer_inf
      ⟨hg, Subgroup.le_normalizer_comap ι (normalizer_centQuot (hML (hgM g hg)))⟩
  have heq := hirr V inf_le_left hVΦ hNV
  intro u hu l hl
  obtain ⟨y, rfl⟩ := hpreK u hu.2
  have hyV : y ∈ V := heq ▸ (hmemQ y).mpr hu
  exact hyV.2.2 l hl

end Generic

theorem false_of_le_center (hcc : CFSG.LocalAnalysis.RankFourTheoremC.KFactCenterCyclicGeFive)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) {M L D : Subgroup G} (hLM : L ≤ M)
    (hLn : (L.subgroupOf M).Normal) (hq : CFSG.Open.IsQuasisimple ↥(barM M L))
    (hcat : IsCatalogGroup (↥(barM M L) ⧸ Subgroup.center ↥(barM M L))) (hDL : D ≤ L)
    (hD : IsPGroup p D) (hDc : ∀ u ∈ D, ∀ l ∈ L, u * l * u⁻¹ * l⁻¹ ∈ pCoreOf 2 L)
    (hDe : ∀ u ∈ D, u ^ p = 1) (hDcard : p ^ 2 ≤ Nat.card D) : False := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hp2 : p ≠ 2 := by omega
  set π := QuotientGroup.mk' (CFSG.pCore 2 ↥M) with hπ
  have hpc : pCoreOf 2 L ≤ pCoreOf 2 M := pCoreOf_le_of_normal_subgroupOf 2 L M hLM hLn
  set ι : ↥D →* ↥M := Subgroup.inclusion (hDL.trans hLM) with hι
  have hmem : ∀ d : ↥D, π (ι d) ∈ barM M L := fun d =>
    ⟨ι d, Subgroup.mem_subgroupOf.mpr (by simpa [hι] using hDL d.2), rfl⟩
  set f : ↥D →* ↥(barM M L) := (π.comp ι).codRestrict _ hmem with hf
  have hPZ : f.range ≤ Subgroup.center ↥(barM M L) := by
    rintro _ ⟨d, rfl⟩
    rw [Subgroup.mem_center_iff]
    rintro ⟨_, ⟨l, hl, rfl⟩⟩
    have hl' : (l : G) ∈ L := Subgroup.mem_subgroupOf.mp hl
    obtain ⟨m, hm, hme⟩ := hpc (hDc d d.2 l hl')
    have hcm : l * ι d * l⁻¹ * (ι d)⁻¹ = m⁻¹ := by
      apply Subtype.ext
      simp only [Subgroup.coe_subtype] at hme
      rw [Subgroup.coe_inv, hme]
      simp [hι]
      group
    have h1 : π (l * ι d * l⁻¹ * (ι d)⁻¹) = 1 := by
      rw [hcm]
      exact (QuotientGroup.eq_one_iff _).mpr ((CFSG.pCore 2 ↥M).inv_mem hm)
    apply Subtype.ext
    change π l * π (ι d) = π (ι d) * π l
    rw [map_mul, map_mul, map_mul, map_inv, map_inv] at h1
    calc π l * π (ι d) = (π l * π (ι d) * (π l)⁻¹ * (π (ι d))⁻¹) * (π (ι d) * π l) := by group
      _ = π (ι d) * π l := by rw [h1, one_mul]
  have hfi : Function.Injective f := by
    rw [injective_iff_map_eq_one]
    intro d hd
    have hd' : π (ι d) = 1 := congrArg Subtype.val hd
    obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥M))
      ⟨_, (QuotientGroup.eq_one_iff _).mp hd'⟩
    have hk' : (d : G) ^ (2 ^ k) = 1 := by
      have := congrArg (fun z : ↥(CFSG.pCore 2 ↥M) => ((z : ↥M) : G)) hk
      simpa [hι] using this
    exact Subtype.ext (eq_one_of_pow_two_pow_eq_one hp hp2 hk' (e := 1)
      (by rw [pow_one]; exact hDe d d.2))
  have hPp : IsPGroup p f.range := hD.of_surjective f.rangeRestrict f.rangeRestrict_surjective
  haveI hcyc := hcc ↥(barM M L) hq hcat p hp hp5 f.range hPZ hPp
  have hexp : ∀ x : ↥f.range, x ^ p = 1 := by
    rintro ⟨_, ⟨d, rfl⟩⟩
    apply Subtype.ext
    change f d ^ p = 1
    rw [← map_pow, show d ^ p = 1 from Subtype.ext (by simpa using hDe d d.2), map_one]
  have hdvd : Nat.card f.range ∣ p := by
    rw [← IsCyclic.exponent_eq_card]
    exact Monoid.exponent_dvd_of_forall_pow_eq_one hexp
  have hcard : Nat.card D = Nat.card f.range := Nat.card_congr (MonoidHom.ofInjective hfi).toEquiv
  have := Nat.le_of_dvd hp.pos hdvd
  have := hp.two_le
  nlinarith

theorem false_of_altTen
    (hS : Setting G) (h1014 : AGL81TenFourteenCentCfg G)
    (h10143 : AGL81TenFourteenThreeCfgGen G) (hJ0 : AGL81ElevenElevenJZeroShape G)
