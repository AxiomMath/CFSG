theorem sylow_five_altTen {K : Type} [Group K] [Finite K] (e : K ≃* alternatingGroup (Fin 10))
    (T : Sylow 5 K) :
    ∀ x ∈ (T : Subgroup K), x ^ 5 = 1 ∧ ∀ y ∈ (T : Subgroup K), x * y = y * x := by
  obtain ⟨ψ, hψ⟩ := A10Perm.exists_iso_sylow e T
  intro x hx
  obtain ⟨i, j, hij⟩ := A10Perm.mem_S₀.mp ((hψ x).mp hx)
  refine ⟨ψ.injective ?_, fun y hy => ψ.injective ?_⟩
  · rw [map_pow, hij, map_one, (A10Perm.a₁₂_commute.pow_pow i j).mul_pow, ← pow_mul, ← pow_mul,
      mul_comm i, mul_comm j, pow_mul, pow_mul, A10Perm.a₁_pow, A10Perm.a₂_pow, one_pow, one_pow,
      one_mul]
  · obtain ⟨k, l, hkl⟩ := A10Perm.mem_S₀.mp ((hψ y).mp hy)
    rw [map_mul, map_mul, hij, hkl, A10Perm.mul_aux, A10Perm.mul_aux, add_comm i, add_comm j]

theorem card_sylow_five_altTen {K : Type} [Group K] [Finite K]
    (e : K ≃* alternatingGroup (Fin 10)) (T : Sylow 5 K) : Nat.card T = 5 ^ 2 := by
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  rw [T.card_eq_multiplicity, Nat.card_congr e.toEquiv]
  exact congrArg (5 ^ ·) A10Perm.factorization_A10

theorem three_le_pRank_altTen {K : Type} [Group K] [Finite K]
    (e : K ≃* alternatingGroup (Fin 10)) : 3 ≤ Open.pRank 3 (⊤ : Subgroup K) := by
  have h := CFSG.AGLEmbeddingD2.three_le_pRank_alternatingGroup (n := 10)
    Nat.prime_three (by norm_num) (by norm_num)
  rwa [← CFSG.PreuniquenessRankFour.Helpers.pRank_map_of_injective 3 Nat.prime_three
    e.symm.toMonoidHom e.symm.injective, Subgroup.map_top_of_surjective _ e.symm.surjective] at h

end AltTen

section Abstract

variable {A : Type} [Group A] [Finite A] {p : ℕ} [Fact p.Prime]

theorem inf_centralizer_ne_bot {S S₀ : Subgroup A} (hSp : IsPGroup p S) (hS₀S : S₀ ≤ S)
    (hn : S ≤ Subgroup.normalizer (S₀ : Set A)) (hS₀1 : S₀ ≠ ⊥) :
    S₀ ⊓ Subgroup.centralizer (S : Set A) ≠ ⊥ := by
  have : Group.IsNilpotent S := hSp.isNilpotent
  have hN : (S₀.subgroupOf S).Normal := by
    refine ⟨fun x hx g => ?_⟩
    have := (Subgroup.mem_normalizer_iff.mp (hn g.2) x).mp hx
    simpa [Subgroup.mem_subgroupOf] using this
  have hne : S₀.subgroupOf S ≠ ⊥ := by
    intro h
    apply hS₀1
    rw [eq_bot_iff]
    intro x hx
    have : (⟨x, hS₀S hx⟩ : S) ∈ S₀.subgroupOf S := hx
    rw [h, Subgroup.mem_bot] at this
    simpa using congrArg Subtype.val this
  obtain ⟨z, hz1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp
    (Group.IsNilpotent.inf_center_ne_bot_of_normal hne)
  intro hbot
  apply hz1
  have hzS₀ : ((z : S) : A) ∈ S₀ := (Subgroup.mem_inf.1 z.2).1
  have hzc : ((z : S) : A) ∈ Subgroup.centralizer (S : Set A) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have := Subgroup.mem_center_iff.mp (Subgroup.mem_inf.1 z.2).2 ⟨y, hy⟩
    exact congrArg Subtype.val this
  have : ((z : S) : A) ∈ S₀ ⊓ Subgroup.centralizer (S : Set A) := ⟨hzS₀, hzc⟩
  rw [hbot, Subgroup.mem_bot] at this
  exact Subtype.ext (Subtype.ext this)

theorem le_of_ne_bot_of_elem (hI2 : KFactStepThreeIrred) (hI5 : KFactStepThreeCentSylow)
    {Inn S Bb T L : Subgroup A} (hInn : Inn.Normal)
    (hCI : Subgroup.centralizer (Inn : Set A) = ⊥) (hSt : StepThreeGroup p ↥Inn)
    (hS : CFSG.ABGLocalTools.IsSylowOf p S Inn)
    (hSe : ∀ x ∈ S, x ^ p = 1 ∧ ∀ y ∈ S, x * y = y * x) (hBb : IsPGroup p Bb) (hSB : S ≤ Bb)
    (hTB : T ≤ Bb) (hBT : Bb ≤ Subgroup.normalizer (T : Set A)) (hTL : T ≤ L) (hT : T ≠ ⊥)
    (hIN : Inn ⊓ Subgroup.normalizer (S : Set A) ≤ Subgroup.normalizer (L : Set A)) :
    S ≤ L := by
  obtain ⟨⟨t, htT, htc⟩, ht1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp
    (inf_centralizer_ne_bot hBb hTB hBT hT)
  have ht1' : t ≠ 1 := fun h => ht1 (Subtype.ext h)
  have htS : t ∈ S := by
    obtain ⟨n, hn⟩ := hBb ⟨t, hTB htT⟩
    exact hI5 p A Inn S hInn hCI hSt hS t (Subgroup.mem_centralizer_iff.mpr fun s hs =>
      Subgroup.mem_centralizer_iff.mp htc s (hSB hs)) n (by simpa using congrArg Subtype.val hn)
  have hSI : S ≤ Inn := hS.le
  obtain ⟨S₀, hS₀⟩ := hS
  have hmem : ∀ x : ↥Inn, x ∈ (S₀ : Subgroup ↥Inn) ↔ (x : A) ∈ S := fun x => by
    rw [← hS₀]
    exact ⟨fun h => ⟨x, h, rfl⟩, fun ⟨y, hy, hyx⟩ => by rwa [Inn.subtype_injective hyx] at hy⟩
  set V₀ : Subgroup ↥Inn := (L ⊓ S).comap Inn.subtype with hV₀
  have hV₀1 : V₀ ≠ ⊥ := by
    intro h
    have : (⟨t, hSI htS⟩ : ↥Inn) ∈ V₀ := ⟨hTL htT, htS⟩
    rw [h, Subgroup.mem_bot] at this
    exact ht1' (congrArg Subtype.val this)
  have hV₀e : ∀ v ∈ V₀, v ∈ (S₀ : Subgroup ↥Inn) ∧ v ^ p = 1 ∧
      ∀ s ∈ (S₀ : Subgroup ↥Inn), v * s = s * v := by
    intro v hv
    have hvS : (v : A) ∈ S := hv.2
    exact ⟨(hmem v).mpr hvS, Subtype.ext (by simpa using (hSe _ hvS).1),
      fun s hs => Subtype.ext (by simpa using (hSe _ hvS).2 _ ((hmem s).mp hs))⟩
  have hN₀ : Subgroup.normalizer ((S₀ : Subgroup ↥Inn) : Set ↥Inn) ≤
      Subgroup.normalizer (V₀ : Set ↥Inn) := by
    intro k hk
    have hkS : (k : A) ∈ Subgroup.normalizer (S : Set A) := by
      rw [← hS₀]
      exact Subgroup.le_normalizer_map Inn.subtype ⟨k, hk, rfl⟩
    exact Subgroup.le_normalizer_comap Inn.subtype
      (Subgroup.inf_normalizer_le_normalizer_inf ⟨hIN ⟨k.2, hkS⟩, hkS⟩)
  have h2 := (hI2 p ↥Inn hSt S₀).2 V₀ hV₀1 hV₀e hN₀
  intro s hs
  exact (h2 ⟨s, hSI hs⟩ ((hmem ⟨s, hSI hs⟩).mpr hs) (Subtype.ext (by simpa using (hSe s hs).1))
    (fun s' hs' => Subtype.ext (by simpa using (hSe s hs).2 _ ((hmem s').mp hs')))).1

end Abstract

variable {G : Type} [Group G] [Finite G]

private def centQuot (L : Subgroup G) : Subgroup G where
  carrier := {g | g ∈ Subgroup.normalizer (L : Set G) ∧ ∀ l ∈ L, g * l * g⁻¹ * l⁻¹ ∈ pCoreOf 2 L}
  mul_mem' := by
    rintro g h ⟨hg, hgL⟩ ⟨hh, hhL⟩
    refine ⟨Subgroup.mul_mem _ hg hh, fun l hl => ?_⟩
    have e : g * h * l * (g * h)⁻¹ * l⁻¹ =
        (g * (h * l * h⁻¹ * l⁻¹) * g⁻¹) * (g * l * g⁻¹ * l⁻¹) := by group
    rw [e]
    exact (pCoreOf 2 L).mul_mem (CFSG.ASVolI.burnsideI22P5_pCoreOf_conj L g
      (Subgroup.mem_normalizer_iff.mp hg) (hhL l hl)) (hgL l hl)
  one_mem' := ⟨Subgroup.one_mem _, fun l _ => by simp [(pCoreOf 2 L).one_mem]⟩
  inv_mem' := by
    rintro g ⟨hg, hgL⟩
    refine ⟨Subgroup.inv_mem _ hg, fun l hl => ?_⟩
    have e : g⁻¹ * l * g⁻¹⁻¹ * l⁻¹ = g⁻¹ * (g * l * g⁻¹ * l⁻¹)⁻¹ * g⁻¹⁻¹ := by group
    rw [e]
    exact CFSG.ASVolI.burnsideI22P5_pCoreOf_conj L g⁻¹
      (Subgroup.mem_normalizer_iff.mp (Subgroup.inv_mem _ hg)) ((pCoreOf 2 L).inv_mem (hgL l hl))

private theorem conj_mem_centQuot {L : Subgroup G} {g x : G}
    (hg : g ∈ Subgroup.normalizer (L : Set G)) (hx : x ∈ centQuot L) :
    g * x * g⁻¹ ∈ centQuot L := by
  obtain ⟨hxN, hxL⟩ := hx
  refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hg hxN) (Subgroup.inv_mem _ hg), fun l hl => ?_⟩
  have hl' : g⁻¹ * l * g⁻¹⁻¹ ∈ L :=
    (Subgroup.mem_normalizer_iff.mp (Subgroup.inv_mem _ hg) l).mp hl
  have e : g * x * g⁻¹ * l * (g * x * g⁻¹)⁻¹ * l⁻¹ =
      g * (x * (g⁻¹ * l * g⁻¹⁻¹) * x⁻¹ * (g⁻¹ * l * g⁻¹⁻¹)⁻¹) * g⁻¹ := by group
  rw [e]
  exact CFSG.ASVolI.burnsideI22P5_pCoreOf_conj L g (Subgroup.mem_normalizer_iff.mp hg)
    (hxL _ hl')

private theorem normalizer_centQuot {L : Subgroup G} {g : G}
    (hg : g ∈ Subgroup.normalizer (L : Set G)) :
    g ∈ Subgroup.normalizer ((centQuot L : Subgroup G) : Set G) :=
  Subgroup.mem_normalizer_iff.mpr fun x => ⟨fun hx => conj_mem_centQuot hg hx, fun hx => by
    have := conj_mem_centQuot (Subgroup.inv_mem _ hg) hx
    simpa [mul_assoc] using this⟩

