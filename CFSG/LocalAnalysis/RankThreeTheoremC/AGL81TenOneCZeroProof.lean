@[expose] def HasWGen (Q : Type) [Group Q] : Prop :=
  ∃ T : Subgroup Q, IsSubnormal T ⊤ ∧ (IsComponentOf T ⊤ ∨ IsSymThreeOrSUThreeTwo ↥T)

@[expose] def KFactParabolicLeviMember : Prop :=
  ∀ (A : Type) [Group A] [Finite A] (Y P : Subgroup A), Open.IsQuasisimple ↥Y →
    pCoreOf 2 Y = ⊥ → IsClassicalTwoOrG2 (↥Y ⧸ Subgroup.center ↥Y) → IsParabolicTwo Y P →
    ¬ IsSylowTwoOf (pCoreOf 2 P) Y → HasWGen (↥P ⧸ CFSG.pCore 2 ↥P)

theorem HasWGen.of_mulEquiv {Q Q' : Type} [Group Q] [Group Q'] (e : Q ≃* Q') (h : HasWGen Q') :
    HasWGen Q := by
  obtain ⟨T, hTs, hT⟩ := h
  have hmap : ∀ K : Subgroup Q', K.comap e.toMonoidHom = K.map e.symm.toMonoidHom := fun K =>
    (Subgroup.map_equiv_eq_comap_symm e.symm K).symm
  have hs : IsSubnormal (T.comap e.toMonoidHom) ⊤ := by
    simpa using hTs.comap e.toMonoidHom
  let eT : ↥T ≃* ↥(T.comap e.toMonoidHom) :=
    (T.equivMapOfInjective e.symm.toMonoidHom e.symm.injective).trans
      (MulEquiv.subgroupCongr (hmap T).symm)
  refine ⟨T.comap e.toMonoidHom, hs, ?_⟩
  rcases hT with hc | hb
  · exact Or.inl ⟨le_top, hs, CFSG.Open.IsQuasisimple.of_mulEquiv eT.symm hc.2.2⟩
  · exact Or.inr (IsSymThreeOrSUThreeTwo.of_mulEquiv eT hb)

theorem isQuasisimple_of_isSimpleGroup_of_perfect {Q : Type} [Group Q] [IsSimpleGroup Q]
    (hp : commutator Q = ⊤) : Open.IsQuasisimple Q := by
  refine ⟨hp, ?_⟩
  have hZ : Subgroup.center Q = ⊥ := by
    rcases (Subgroup.center Q).normal_of_characteristic.eq_bot_or_eq_top with h | h
    · exact h
    · exfalso
      have hc : commutator Q = ⊥ := by
        rw [commutator_def, Subgroup.commutator_eq_bot_iff_le_centralizer]
        intro x _
        rw [Subgroup.mem_centralizer_iff]
        intro y _
        exact (Subgroup.mem_center_iff.mp (h ▸ Subgroup.mem_top y) x).symm
      rw [hp] at hc
      exact (top_ne_bot (α := Subgroup Q)) hc
  exact ((QuotientGroup.quotientMulEquivOfEq hZ).trans
    (QuotientGroup.quotientBot (G := Q))).isSimpleGroup

theorem hasWGen_of_isSimpleGroup {Q : Type} [Group Q] [IsSimpleGroup Q]
    (hp : commutator Q = ⊤) : HasWGen Q :=
  ⟨⊤, IsSubnormal.refl ⊤, Or.inl ⟨le_rfl, IsSubnormal.refl ⊤,
    CFSG.Open.IsQuasisimple.of_mulEquiv Subgroup.topEquiv
      (isQuasisimple_of_isSimpleGroup_of_perfect hp)⟩⟩

theorem hasWGen_perm_three : HasWGen (Equiv.Perm (Fin 3)) :=
  ⟨⊤, IsSubnormal.refl ⊤, Or.inr (Or.inl ⟨Subgroup.topEquiv⟩)⟩

theorem isSubnormal_top_of_normal {Q : Type} [Group Q] {T : Subgroup Q} (hT : T.Normal) :
    IsSubnormal T ⊤ :=
  IsSubnormal.step le_top (hT.subgroupOf ⊤) (IsSubnormal.refl ⊤)

theorem hasWGen_perm_of_five_le {n : ℕ} (hn : 5 ≤ n) : HasWGen (Equiv.Perm (Fin n)) := by
  have h5 : 5 ≤ Nat.card (Fin n) := by rw [Nat.card_eq_fintype_card, Fintype.card_fin]; exact hn
  have hs := isSubnormal_top_of_normal (alternatingGroup.normal (α := Fin n))
  exact ⟨alternatingGroup (Fin n), hs, Or.inl ⟨le_top, hs,
    CFSG.ComponentClassification.CatalogueBAlternating.alternating_quasisimple h5⟩⟩

theorem hasWGen_perm_prod_of_five_le {r m : ℕ} (hm : 5 ≤ m) :
    HasWGen (Equiv.Perm (Fin r) × Equiv.Perm (Fin m)) := by
  have h5 : 5 ≤ Nat.card (Fin m) := by rw [Nat.card_eq_fintype_card, Fintype.card_fin]; exact hm
  set T := (alternatingGroup (Fin m)).map (MonoidHom.inr (Equiv.Perm (Fin r)) (Equiv.Perm (Fin m)))
    with hT
  have hTn : T.Normal := by
    refine ⟨fun x hx g => ?_⟩
    obtain ⟨a, ha, rfl⟩ := hx
    refine ⟨g.2 * a * g.2⁻¹, (alternatingGroup.normal (α := Fin m)).conj_mem a ha g.2, ?_⟩
    ext <;> simp
  have hs := isSubnormal_top_of_normal hTn
  let e : ↥(alternatingGroup (Fin m)) ≃* ↥T :=
    (alternatingGroup (Fin m)).equivMapOfInjective _ (fun a b h => congrArg Prod.snd h)
  exact ⟨T, hs, Or.inl ⟨le_top, hs, CFSG.Open.IsQuasisimple.of_mulEquiv e.symm
    (CFSG.ComponentClassification.CatalogueBAlternating.alternating_quasisimple h5)⟩⟩

theorem false_of_pCore_eq_bot_perm_four {Q : Type} [Group Q] (e : Q ≃* Equiv.Perm (Fin 4))
    (hQ : CFSG.pCore 2 Q = ⊥) : False := by
  have h := CFSG.pCore_map_iso 2 e
  rw [hQ, Subgroup.map_bot, CFSG.RankThree.PartOne.Sec154Fin.pCore_s4] at h
  have hm : Equiv.swap (0 : Fin 4) 1 * Equiv.swap 2 3 ∈
      CFSG.RankThree.PartOne.Sec154Fin.klein4 := by
    show CFSG.RankThree.PartOne.Sec154Fin.isKlein _
    decide +kernel
  rw [← h, Subgroup.mem_bot] at hm
  exact absurd hm (by decide)

theorem false_of_pCore_eq_bot_perm_two {Q : Type} [Group Q] (e : Q ≃* Equiv.Perm (Fin 2))
    (hQ : CFSG.pCore 2 Q = ⊥) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h := CFSG.pCore_map_iso 2 e
  rw [hQ, Subgroup.map_bot] at h
  have h2 : IsPGroup 2 (⊤ : Subgroup (Equiv.Perm (Fin 2))) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Subgroup.card_top, Nat.card_perm, Nat.card_eq_fintype_card, Fintype.card_fin]
    rfl
  have hle : (⊤ : Subgroup (Equiv.Perm (Fin 2))) ≤ CFSG.pCore 2 (Equiv.Perm (Fin 2)) :=
    le_sSup ⟨inferInstance, h2⟩
  rw [← h] at hle
  have hm := hle (Subgroup.mem_top (Equiv.swap (0 : Fin 2) 1))
  rw [Subgroup.mem_bot] at hm
  exact absurd hm (by decide)

theorem hasWGen_of_mulEquiv_perm {Q : Type} [Group Q] {n : ℕ} (e : Q ≃* Equiv.Perm (Fin n))
    (hQ : CFSG.pCore 2 Q = ⊥) (hn : 2 ≤ n) : HasWGen Q := by
  rcases (show n = 2 ∨ n = 3 ∨ n = 4 ∨ 5 ≤ n by omega) with rfl | rfl | rfl | h5
  · exact (false_of_pCore_eq_bot_perm_two e hQ).elim
  · exact hasWGen_perm_three.of_mulEquiv e
  · exact (false_of_pCore_eq_bot_perm_four e hQ).elim
  · exact (hasWGen_perm_of_five_le h5).of_mulEquiv e

theorem hasWGen_lie_typeB_two {k : ℕ} {d : TauCeti.ValidLieTypeIndex} {q : TauCeti.PrimePower}
    (hq : q.card = 2) (hk : 3 ≤ k) (hd : d.1 = .B k q) :
    HasWGen (TauCeti.CFSGIndex.lie d).Group := by
  obtain ⟨d, hv⟩ := d
  simp only at hd
  subst hd
  obtain ⟨hp, he⟩ := CFSG.HardMathSupport.Curtis.Coordinator.PLType.primePower_card_two hq
  have hmod := CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeB_even k q hv hp hk
    (MulEquiv.refl _)
  have hs := CFSG.ClassicalGroups.Symplectic.isSimpleGroup_of_statedClassicalModel_PSp _ _ _ _ hmod
  obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := hmod
  rw [hp, he, pow_one] at hK
  have hperf : Group.IsPerfect (StatedProj (StatedSp k K)) :=
    CFSG.ClassicalGroups.Symplectic.symplectic_projective_perfect k K (Or.inr (Or.inr ⟨hK, hk⟩))
  change HasWGen (TauCeti.ValidLieTypeIndex.Group ⟨.B k q, hv⟩)
  have hperf' : Group.IsPerfect (TauCeti.ValidLieTypeIndex.Group ⟨.B k q, hv⟩) :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  exact hasWGen_of_isSimpleGroup hperf'.commutator_eq_top

variable {G : Type} [Group G] [Finite G]

theorem cZero_nonempty_of_hasWGen {M X : Subgroup G} (hX : X ≤ M)
    (h : HasWGen (↥(barM M X) ⧸ CFSG.pCore 2 ↥(barM M X))) : (cZero X).Nonempty := by
  obtain ⟨T, hTs, hc | hb⟩ := h
  · obtain ⟨I, hI, -⟩ := CZeroLift.exists_cZero_of_component _
      (TenThreeThree.hatHom_surjective M X hX) (TenThreeThree.isPGroup_ker_hatHom M X hX)
      (TenThreeThree.pCore_hat_eq_bot M X) hc
    exact ⟨I, hI⟩
  · obtain ⟨I, hI, -⟩ := CZeroLift.exists_cZero_of_symThree _
      (TenThreeThree.hatHom_surjective M X hX) (TenThreeThree.isPGroup_ker_hatHom M X hX)
      (TenThreeThree.pCore_hat_eq_bot M X) hTs hb
    exact ⟨I, hI⟩

theorem wSup_eq_bot_of_not_hasWGen {Q : Type} [Group Q] (h : ¬ HasWGen Q) :
    TenThreeThree.wSup Q = ⊥ :=
  le_bot_iff.mp (iSup₂_le fun T hT => (h ⟨T, hT.1, hT.2⟩).elim)

private theorem card_klein4 : Nat.card CFSG.RankThree.PartOne.Sec154Fin.klein4 = 4 := by
  show Nat.card {x : Equiv.Perm (Fin 4) // CFSG.RankThree.PartOne.Sec154Fin.isKlein x} = 4
  rw [Nat.card_eq_fintype_card]
  decide +kernel

theorem two_dvd_card_hat_of_threeASix {A : Type} [Group A] [Finite A] {Y P : Subgroup A}
    (hPY : P ≤ Y) (hZ : Nat.card (Subgroup.center ↥Y) = 3)
    (hS4 : Nonempty (↥((P.subgroupOf Y).map (QuotientGroup.mk' (Subgroup.center ↥Y))) ≃*
      Equiv.Perm (Fin 4))) :
    2 ∣ Nat.card (↥P ⧸ CFSG.pCore 2 ↥P) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨e4⟩ := hS4
  set Z := Subgroup.center ↥Y with hZdef
  set ρ₀ : ↥P →* ↥Y ⧸ Z := (QuotientGroup.mk' Z).comp (inclusion hPY) with hρ₀
  have hrange : ρ₀.range = (P.subgroupOf Y).map (QuotientGroup.mk' Z) := by
    rw [hρ₀, MonoidHom.range_comp, inclusion_range]
  set ρ : ↥P →* Equiv.Perm (Fin 4) :=
    (e4.toMonoidHom.comp (MulEquiv.subgroupCongr hrange).toMonoidHom).comp ρ₀.rangeRestrict
    with hρ
  have hρs : Function.Surjective ρ :=
    (e4.surjective.comp (MulEquiv.subgroupCongr hrange).surjective).comp
      ρ₀.rangeRestrict_surjective
  have hker : ∀ x : ↥P, x ∈ ρ.ker → inclusion hPY x ∈ Z := by
    intro x hx
    rw [MonoidHom.mem_ker, hρ, MonoidHom.comp_apply, MonoidHom.comp_apply] at hx
    simp only [MulEquiv.coe_toMonoidHom, map_eq_one_iff _ (MulEquiv.injective _)] at hx
    rw [Subtype.ext_iff, MonoidHom.coe_rangeRestrict, OneMemClass.coe_one, hρ₀,
      MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hx
    exact hx
  have hCdvd : Nat.card ρ.ker ∣ 3 := by
    have hle : ρ.ker.map (inclusion hPY) ≤ Z := by
      rintro _ ⟨c, hc, rfl⟩
      exact hker c hc
    rw [← hZ, ← card_map_of_injective (inclusion_injective hPY)]
    exact card_dvd_of_le hle
  have hP : Nat.card P = 24 * Nat.card ρ.ker := by
    rw [card_eq_card_quotient_mul_card_subgroup ρ.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective ρ hρs).toEquiv, Nat.card_perm,
      Nat.card_eq_fintype_card, Fintype.card_fin]
    rfl
  set V := CFSG.pCore 2 ↥P with hV
  have hVimg : V.map ρ ≤ CFSG.RankThree.PartOne.Sec154Fin.klein4 := by
    have h : V.map ρ ≤ CFSG.pCore 2 (Equiv.Perm (Fin 4)) :=
      le_sSup ⟨(CFSG.pCore_normal (p := 2) (G := ↥P)).map ρ hρs,
        (CFSG.pCore_isPGroup (p := 2) (G := ↥P)).map ρ⟩
    exact h.trans CFSG.RankThree.PartOne.Sec154Fin.pCore_le_klein4
  have hinj : Function.Injective (ρ.comp V.subtype) := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro x hx
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply] at hx
    obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥P)) x
    have hd2 : orderOf x ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hk
    have hd3 : orderOf x ∣ 3 := by
      have h1 : orderOf (Subtype.mk (V.subtype x) (MonoidHom.mem_ker.mpr hx) : ↥ρ.ker) ∣
          Nat.card ↥ρ.ker := orderOf_dvd_natCard _
      rw [Subgroup.orderOf_mk] at h1
      have h2 : orderOf (V.subtype x) = orderOf x := Subgroup.orderOf_coe x
      rw [h2] at h1
      exact h1.trans hCdvd
    have hc : Nat.Coprime (orderOf x) 3 :=
      Nat.Coprime.coprime_dvd_left hd2 (Nat.Coprime.pow_left k (by norm_num : Nat.Coprime 2 3))
    have h1 := Nat.Coprime.eq_one_of_dvd hc hd3
    rw [orderOf_eq_one_iff] at h1
    rw [h1, Subgroup.mem_bot]
  have hcardV : Nat.card V ∣ 4 := by
    have h1 : Nat.card V = Nat.card (ρ.comp V.subtype).range :=
      (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv)
    have h2 : (ρ.comp V.subtype).range = V.map ρ := by
      rw [MonoidHom.range_comp, Subgroup.range_subtype]
    have h3 := card_dvd_of_le hVimg
    rw [card_klein4] at h3
    rw [h1, h2]
    exact h3
  by_contra h2
  have hcop : Nat.Coprime (2 ^ 3) (Nat.card (↥P ⧸ V)) :=
    Nat.Coprime.pow_left 3 ((Nat.prime_two.coprime_iff_not_dvd).mpr h2)
  have h8 : 2 ^ 3 ∣ Nat.card (↥P ⧸ V) * Nat.card V := by
    rw [← card_eq_card_quotient_mul_card_subgroup V, hP]
    exact Dvd.intro (3 * Nat.card ρ.ker) (by ring)
  have h8' := hcop.dvd_of_dvd_mul_left h8
  have := Nat.le_of_dvd (by norm_num) (h8'.trans hcardV)
  norm_num at this

theorem not_nontrivial_alternatingGroup_of_le_two {m : ℕ} (hm : m ≤ 2) :
    ¬ Nontrivial (alternatingGroup (Fin m)) := by
  intro h
  have h1 := Finite.one_lt_card_iff_nontrivial.mpr h
  interval_cases m <;> revert h1 <;> rw [Nat.card_eq_fintype_card] <;> decide

end CFSG.LocalAnalysis.RankThreeTheoremC.TenOneCZero

