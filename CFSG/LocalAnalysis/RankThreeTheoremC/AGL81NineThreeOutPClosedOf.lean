theorem normal_sup_sup_centralizer_of_outer {Y : Type*} [Group Y] [Finite Y] {p : ℕ}
    [Fact p.Prime] (K : Subgroup Y) [K.Normal] (R : Sylow p Y)
    (hOut : ∀ S : Sylow p (Outer K), (S : Subgroup (Outer K)).Normal) :
    ((R : Subgroup Y) ⊔ (K ⊔ Subgroup.centralizer (K : Set Y))).Normal := by
  let ψ : Y →* Outer K := (QuotientGroup.mk' (inner K)).comp MulAut.conjNormal
  have hker : ψ.ker = K ⊔ Subgroup.centralizer (K : Set Y) := by
    apply le_antisymm
    · intro x hx
      have h1 : QuotientGroup.mk' (inner K) (MulAut.conjNormal x) = 1 := hx
      obtain ⟨k, hk⟩ := (QuotientGroup.eq_one_iff _).mp h1
      have hc : (k : Y)⁻¹ * x ∈ Subgroup.centralizer (K : Set Y) := by
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        have h := congrArg (fun f : MulAut K => ((f ⟨y, hy⟩ : K) : Y)) hk
        simp only [MulAut.conj_apply, MulAut.conjNormal_apply, Subgroup.coe_mul,
          Subgroup.coe_inv] at h
        calc y * ((k : Y)⁻¹ * x) = (k : Y)⁻¹ * (k * y * (k : Y)⁻¹) * x := by group
          _ = (k : Y)⁻¹ * (x * y * x⁻¹) * x := by rw [h]
          _ = (k : Y)⁻¹ * x * y := by group
      have e' : x = (k : Y) * ((k : Y)⁻¹ * x) := by group
      rw [e']
      exact Subgroup.mul_mem_sup k.2 hc
    · refine sup_le (fun k hk => ?_) (fun c hc => ?_)
      · have h1 : (MulAut.conjNormal k : MulAut K) ∈ inner K :=
          ⟨⟨k, hk⟩, MulEquiv.ext fun y => Subtype.ext (by simp [MulAut.conjNormal_apply])⟩
        exact (QuotientGroup.eq_one_iff _).mpr h1
      · have h1 : (MulAut.conjNormal c : MulAut K) = 1 := MulEquiv.ext fun y => Subtype.ext (by
          rw [MulAut.conjNormal_apply, MulAut.one_apply]
          rw [Subgroup.mem_centralizer_iff] at hc
          rw [← hc y y.2, mul_inv_cancel_right])
        show QuotientGroup.mk' (inner K) (MulAut.conjNormal c) = 1
        rw [h1, map_one]
  obtain ⟨S, hS⟩ := (R.isPGroup'.map ψ).exists_le_sylow
  have := hOut S
  rw [← hker]
  exact CFSG.AGLEmbedding.normal_sup_ker_of_le_normal ψ R S.isPGroup' hS

theorem kFactNineThreeOutPClosed_of
    (hsimple : ∀ (p : ℕ) (i : TauCeti.CFSGIndex), p.Prime → p ≠ 2 → IsNineThreeIndex p i →
      Finite i.Group → ∀ S : Sylow p (Outer i.Group), (S : Subgroup (Outer i.Group)).Normal)
    (hprod : ∀ (p : ℕ) (d : TauCeti.ValidLieTypeIndex), p.Prime → p ≠ 2 →
      IsNineThreeProductIndex p d → Finite (TauCeti.CFSGIndex.lie d).Group →
      ∀ S : Sylow p (Outer ((TauCeti.CFSGIndex.lie d).Group × (TauCeti.CFSGIndex.lie d).Group)),
        (S : Subgroup (Outer ((TauCeti.CFSGIndex.lie d).Group ×
          (TauCeti.CFSGIndex.lie d).Group))).Normal) :
    KFactNineThreeOutPClosed := by
  intro p Y _ _ K hp hp2 hKn hlist R
  haveI : Fact p.Prime := ⟨hp⟩
  refine normal_sup_sup_centralizer_of_outer K R ?_
  rcases hlist with ⟨i, hi, ⟨e⟩⟩ | ⟨d, hd, ⟨e⟩⟩
  · exact sylow_normal_outer_of_mulEquiv e (hsimple p i hp hp2 hi (Finite.of_equiv K e.toEquiv))
  · haveI := Finite.of_equiv K e.toEquiv
    exact sylow_normal_outer_of_mulEquiv e (hprod p d hp hp2 hd
      (Finite.of_surjective (Prod.fst (β := (TauCeti.CFSGIndex.lie d).Group))
        Prod.fst_surjective))

private theorem nonabelian_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B)
    (h : ∃ a b : B, a * b ≠ b * a) : ∃ a b : A, a * b ≠ b * a := by
  obtain ⟨a, b, hab⟩ := h
  exact ⟨e.symm a, e.symm b, fun hc => hab (by simpa using congrArg e hc)⟩

private theorem psl2_nonabelian' {F : Type} [Field F] [Finite F] (h4 : 4 ≤ Nat.card F) :
    ∃ a b : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F, a * b ≠ b * a := by
  have hF : ∃ a : F, a ≠ 0 ∧ a ^ 2 ≠ 1 := by
    obtain ⟨x, hx⟩ : IsCyclic Fˣ := by infer_instance
    refine ⟨x, Units.ne_zero x, fun h ↦ ?_⟩
    grw [Nat.card_eq_card_units_add_one F, ← orderOf_eq_card_of_forall_mem_zpowers hx,
      orderOf_le_of_pow_eq_one zero_lt_two (Units.ext <| by simpa using h)] at h4
    omega
  by_contra hcomm
  have hc : ∀ a b : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F, a * b = b * a :=
    fun a b => by_contra fun h => hcomm ⟨a, b, h⟩
  have htop := SL2Simple.PSL_commutator_eq_top hF
  have hbot : commutator (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) = ⊥ := by
    rw [commutator_def, Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro x _
    rw [Subgroup.mem_centralizer_iff]
    intro y _
    exact hc y x
  obtain ⟨a, ha⟩ := exists_ne (1 : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
  have hmem : a ∈ commutator (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) :=
    htop ▸ Subgroup.mem_top a
  rw [hbot, Subgroup.mem_bot] at hmem
  exact ha hmem

theorem nonabelian_of_isNineThreeProductIndex {p : ℕ} {d : TauCeti.ValidLieTypeIndex}
    (hd : IsNineThreeProductIndex p d) :
    ∃ a b : (TauCeti.CFSGIndex.lie d).Group, a * b ≠ b * a := by
  obtain ⟨d, hv⟩ := d
  rcases hd with ⟨-, q, hqp, hqe, hdq⟩ | ⟨-, hdq⟩
  · dsimp only at hdq
    subst hdq
    haveI : Fact q.p.Prime := ⟨q.prime_p⟩
    have h4 : 4 ≤ Nat.card (GaloisField q.p q.exponent) := by
      rw [GaloisField.card q.p q.exponent q.exponent_pos.ne', hqp, hqe]
      norm_num
    exact nonabelian_of_mulEquiv (CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 1 q hv)
      (psl2_nonabelian' h4)
  · dsimp only at hdq
    subst hdq
    exact nonabelian_of_mulEquiv (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv)
      (CFSG.SectionRank.suzukiMatrixGroup_nonabelian 2 (by norm_num))

theorem isNineThreeIndex_of_isNineThreeProductIndex {p : ℕ} {d : TauCeti.ValidLieTypeIndex}
    (hd : IsNineThreeProductIndex p d) : IsNineThreeIndex p (.lie d) := by
  show IsNineThreeLieIndex p d
  rcases hd with ⟨hp, q, hqp, hqe, hdq⟩ | ⟨hp, hdq⟩
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hp, Or.inl ⟨q, hqp, hqe,
      Or.inl hdq⟩⟩)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨hp, Or.inl hdq⟩)))))

theorem kFactNineThreeOutPClosed_of_simple
    (hsimple : ∀ (p : ℕ) (i : TauCeti.CFSGIndex), p.Prime → p ≠ 2 → IsNineThreeIndex p i →
      Finite i.Group → ∀ S : Sylow p (Outer i.Group), (S : Subgroup (Outer i.Group)).Normal) :
    KFactNineThreeOutPClosed := by
  refine kFactNineThreeOutPClosed_of hsimple fun p d hp hp2 hd hfin => ?_
  haveI : Fact p.Prime := ⟨hp⟩
  haveI := isSimpleGroup_of_isNineThreeProductIndex hd
  exact sylow_normal_outer_prod_of_simple (nonabelian_of_isNineThreeProductIndex hd) hp2
    (hsimple p _ hp hp2 (isNineThreeIndex_of_isNineThreeProductIndex hd) hfin)

