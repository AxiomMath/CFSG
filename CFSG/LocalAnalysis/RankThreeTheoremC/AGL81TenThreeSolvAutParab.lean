private theorem four_le_pRank_of_top (hGA : CFSG.Open.GriessAllModelsStatement)
    {Y : Type} [Group Y] [Finite Y] (hY : CFSG.Open.IsQuasisimple Y)
    (hcl : IsClassicalTwoOrG2 (Y ⧸ Subgroup.center Y)) {T P : Subgroup Y}
    (hT : IsSylowTwoOf T ⊤) (hNP : Subgroup.normalizer (T : Set Y) ≤ P)
    {C : Subgroup (↥P ⧸ CFSG.pCore 2 ↥P)} (hC : IsSubnormal C ⊤)
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 4) (e : ↥C ≃* ↥(StatedSU 3 2 K)) :
    4 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup Y) := by
  classical
  by_contra hr
  have hr3 : CFSG.Open.pRank 3 (⊤ : Subgroup Y) ≤ 3 := by omega
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hK' : Nat.card K = (2 ^ 1) ^ 2 := by rw [hK]; norm_num
  have := Fintype.ofFinite K
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (f := 2)
    (by rw [← Nat.card_eq_fintype_card, hK]; norm_num)
  let e' : ↥C ≃* ↥(StatedSU 3 (2 ^ 1) K) :=
    e.trans (MulEquiv.subgroupCongr (show StatedSU 3 2 K = StatedSU 3 (2 ^ 1) K by norm_num))
  obtain ⟨h216, x, y, hR, hxy, -, -⟩ := exists_su_three_two_heis hK' (e'.trans (equivStatedSU hK' 3).symm)
  have hR27 := CFSG.LieType.Steinberg.CentralExt.SUThreeFieldTwo.card_closure_eq_of_cubeRel hR hxy
  have hR3 : IsPGroup 3 (Subgroup.closure ({x, y} : Set ↥C)) :=
    IsPGroup.of_card (n := 3) (by rw [hR27]; norm_num)
  have hCs : Group.IsSolvable ↥C := by
    have := CFSG.Quasithin.isSolvable_statedSU_one (F := K) hK'
    exact Group.isSolvable_of_isSolvable_injective (f := e'.toMonoidHom) e'.injective
  set q : ↥P →* ↥P ⧸ CFSG.pCore 2 ↥P := QuotientGroup.mk' (CFSG.pCore 2 ↥P) with hq
  have hqs : Function.Surjective q := QuotientGroup.mk'_surjective _
  set Rd := CFSG.solvableRadical (↥P ⧸ CFSG.pCore 2 ↥P) with hRd
  have hCR : C ≤ Rd := CFSG.SignalizerFunctorTheorem.Nonsolvable.le_solvableRadical_of_isSubnormal
    (CFSG.Open.IsSubnormal.top_iff.mp hC) hCs
  haveI : Rd.Normal := CFSG.ABGLocalTools.solvableRadical_normal
  haveI : Group.IsSolvable Rd := CFSG.ABGLocalTools.solvableRadical_isSolvable
  set D₀ : Subgroup ↥P := Rd.comap q with hD₀
  haveI hD₀n : D₀.Normal := Subgroup.Normal.comap inferInstance q
  have hpD : CFSG.pCore 2 ↥P ≤ D₀ := fun z hz => by
    show q z ∈ Rd
    rw [hq, QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff z).mpr hz]
    exact one_mem _
  have hD₀s : Group.IsSolvable D₀ := by
    haveI : Group.IsSolvable (CFSG.pCore 2 ↥P) := by
      have hp : IsPGroup 2 (CFSG.pCore 2 ↥P) := CFSG.pCore_isPGroup
      haveI := hp.isNilpotent
      infer_instance
    let g : D₀ →* Rd := (q.comp D₀.subtype).codRestrict Rd (fun z => z.2)
    refine Group.isSolvable_of_ker_le_range (Subgroup.inclusion hpD) g ?_
    intro z hz
    have hz1 : q (z : ↥P) = 1 := congrArg Subtype.val hz
    have hzp : (z : ↥P) ∈ CFSG.pCore 2 ↥P := (QuotientGroup.eq_one_iff _).mp hz1
    exact ⟨⟨z, hzp⟩, rfl⟩
  set D : Subgroup Y := D₀.map P.subtype with hD
  have hDs : Group.IsSolvable D :=
    Group.isSolvable_of_surjective (f := P.subtype.subgroupMap D₀)
      (MonoidHom.subgroupMap_surjective _ _)
  have hDP : D ≤ P := Subgroup.map_subtype_le _
  have hPD : P ≤ Subgroup.normalizer (D : Set Y) := by
    have hsub : D.subgroupOf P = D₀ := CZeroLift.subgroupOf_map_subtype' D₀
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer hDP).mp (by rw [hsub]; exact hD₀n)
  set N := Subgroup.normalizer (T : Set Y) with hN
  have hNs : Group.IsSolvable N := by
    have := CFSG.HardMathSupport.Curtis.UnitaryLevi.isSolvable_borel hT
    rwa [top_inf_eq] at this
  set J := D ⊔ N with hJ
  have hJs : Group.IsSolvable J := isSolvable_sup_of_le_normalizer' (hNP.trans hPD) hDs hNs
  have hperf : ∀ U : Subgroup Y, U ≤ J → ⁅U, U⁆ = U → Nat.Coprime 3 (Nat.card U) := by
    intro U hUJ hUp
    have hUs : Group.IsSolvable U :=
      Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hUJ)
        (Subgroup.inclusion_injective hUJ)
    rw [eq_bot_of_perfect_solvable hUs hUp, Subgroup.card_bot]
    exact Nat.coprime_one_right 3
  obtain ⟨S, hS⟩ := exists_sylow_of_isSylowTwoOf_top hT
  have hTP : T ≤ P := Subgroup.le_normalizer.trans hNP
  have hJN : J ≠ N := by
    intro hJN
    have hDN : D ≤ N := hJN ▸ le_sup_left
    obtain ⟨c, hc⟩ := exists_prime_orderOf_dvd_card' (G := ↥C) 2 (by rw [h216]; norm_num)
    set Z : Subgroup (↥P ⧸ CFSG.pCore 2 ↥P) := Subgroup.zpowers (c : ↥P ⧸ CFSG.pCore 2 ↥P)
    have hZ2 : IsPGroup 2 Z :=
      IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, Subgroup.orderOf_coe, hc]; norm_num)
    have hZC : Z ≤ C := (Subgroup.zpowers_le).mpr c.2
    have hker2 : IsPGroup 2 q.ker := by rw [hq, QuotientGroup.ker_mk']; exact CFSG.pCore_isPGroup
    have hZq : IsPGroup 2 (Z.comap q) := hZ2.comap_of_ker_isPGroup q hker2
    have hZD : Z.comap q ≤ D₀ := Subgroup.comap_mono (hZC.trans hCR)
    have hZT : (Z.comap q).map P.subtype ≤ T := by
      have h1 : (Z.comap q).map P.subtype ≤ N := (Subgroup.map_mono hZD).trans hDN
      have hSN' : Subgroup.normalizer ((S : Subgroup Y) : Set Y) = N := by rw [hS]
      have h2 : (Z.comap q).map P.subtype ⊓ Subgroup.normalizer ((S : Subgroup Y) : Set Y) =
          (Z.comap q).map P.subtype ⊓ (S : Subgroup Y) :=
        IsPGroup.inf_normalizer_sylow (hZq.map P.subtype) S
      rw [hSN', inf_eq_left.mpr h1, hS] at h2
      exact inf_eq_left.mp h2.symm
    set T' : Subgroup ↥P := T.subgroupOf P with hT'
    have hcT : (c : ↥P ⧸ CFSG.pCore 2 ↥P) ∈ T'.map q := by
      obtain ⟨z, hz⟩ := hqs (c : ↥P ⧸ CFSG.pCore 2 ↥P)
      have hzZ : z ∈ Z.comap q := by
        show q z ∈ Z
        rw [hz]
        exact Subgroup.mem_zpowers _
      exact ⟨z, Subgroup.mem_subgroupOf.mpr (hZT ⟨z, hzZ, rfl⟩), hz⟩
    have hNT' : Subgroup.normalizer (T' : Set ↥P) = N.comap P.subtype := by
      have h := Subgroup.comap_normalizer_eq_of_le_range (f := P.subtype) (H := T)
        (by rw [Subgroup.range_subtype]; exact hTP)
      rw [Subgroup.comap_subtype] at h
      exact h.symm
    have hCnT : C ≤ Subgroup.normalizer ((T'.map q : Subgroup _) : Set _) := by
      intro w hw
      obtain ⟨d, rfl⟩ := hqs w
      have hdD : d ∈ D₀ := hCR hw
      have hdN : (d : Y) ∈ N := hDN ⟨d, hdD, rfl⟩
      have hdT : d ∈ Subgroup.normalizer (T' : Set ↥P) := by
        rw [hNT']
        exact hdN
      exact Subgroup.le_normalizer_map q (Subgroup.mem_map_of_mem q hdT)
    have hO2 : CFSG.pCore 2 ↥C = ⊥ :=
      CZeroLift.pCore_eq_bot_of_isSubnormal hC (pCore_quotient_pCore_eq_bot' 2)
    have hT'2 : IsPGroup 2 ((T'.map q).subgroupOf C) := by
      have h1 : IsPGroup 2 T' := hT.2.1.comap_of_injective P.subtype P.subtype_injective
      exact (h1.map q).comap_of_injective C.subtype C.subtype_injective
    have hle : (T'.map q).subgroupOf C ≤ CFSG.pCore 2 ↥C :=
      le_sSup ⟨Subgroup.normal_subgroupOf_of_le_normalizer hCnT, hT'2⟩
    have hcmem : c ∈ CFSG.pCore 2 ↥C := hle (Subgroup.mem_subgroupOf.mpr hcT)
    rw [hO2, Subgroup.mem_bot] at hcmem
    rw [hcmem, orderOf_one] at hc
    norm_num at hc
  obtain ⟨U₀, hU₀le, hU₀3, hU₀map⟩ := exists_isPGroup_three_map_eq hqs (hR3.map C.subtype)
  have hU₀D : U₀ ≤ D₀ :=
    hU₀le.trans (Subgroup.comap_mono ((Subgroup.map_subtype_le _).trans hCR))
  have hUJ : U₀.map P.subtype ≤ J := (Subgroup.map_mono hU₀D).trans le_sup_left
  have hUE := CFSG.LocalAnalysis.RankThreeTheoremC.BlockB.PLElem.parabolicThreeElemOfRank_of hGA
    Y hY hcl hr3 T J hT le_sup_right hJN hperf _ hUJ (hU₀3.map P.subtype)
  apply hxy
  have hx : (x : ↥P ⧸ CFSG.pCore 2 ↥P) ∈ U₀.map q := by
    rw [hU₀map]
    exact ⟨x, Subgroup.subset_closure (Set.mem_insert x {y}), rfl⟩
  have hy : (y : ↥P ⧸ CFSG.pCore 2 ↥P) ∈ U₀.map q := by
    rw [hU₀map]
    exact ⟨y, Subgroup.subset_closure (Set.mem_insert_of_mem x rfl), rfl⟩
  obtain ⟨a, ha, hax⟩ := hx
  obtain ⟨b, hb, hby⟩ := hy
  have hab : (a : Y) * b = b * a := by
    have := hUE.1.is_comm.comm ⟨(a : Y), a, ha, rfl⟩ ⟨(b : Y), b, hb, rfl⟩
    exact congrArg Subtype.val this
  have hab' : a * b = b * a := Subtype.ext hab
  apply Subtype.ext
  simp only [Subgroup.coe_mul]
  rw [← hax, ← hby, ← map_mul, ← map_mul, hab']

theorem four_le_pRank_of_parab_suThreeTwo (hGA : CFSG.Open.GriessAllModelsStatement)
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A} (hY : CFSG.Open.IsQuasisimple ↥Y)
    (hcl : IsClassicalTwoOrG2 (↥Y ⧸ Subgroup.center ↥Y)) (hP : IsParabolicTwo Y P)
    {C : Subgroup (↥P ⧸ CFSG.pCore 2 ↥P)} (hC : IsSubnormal C ⊤)
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 4) (e : ↥C ≃* ↥(StatedSU 3 2 K)) :
    4 ≤ CFSG.Open.pRank 3 Y := by
  obtain ⟨hPY, T, hT, hNT⟩ := hP
  set P' : Subgroup ↥Y := P.subgroupOf Y with hP'
  let e₁ : ↥P' ≃* ↥P := Subgroup.subgroupOfEquivOfLe hPY
  obtain ⟨e₂⟩ : Nonempty (↥P' ⧸ CFSG.pCore 2 ↥P' ≃* ↥P ⧸ CFSG.pCore 2 ↥P) :=
    ⟨QuotientGroup.congr _ _ e₁ (CFSG.pCore_map_iso 2 e₁)⟩
  have hC' : IsSubnormal (C.map e₂.symm.toMonoidHom) ⊤ := by
    have := hC.map e₂.symm.toMonoidHom
    rwa [Subgroup.map_top_of_surjective _ e₂.symm.surjective] at this
  let eC : ↥(C.map e₂.symm.toMonoidHom) ≃* ↥(StatedSU 3 2 K) :=
    (C.equivMapOfInjective e₂.symm.toMonoidHom e₂.symm.injective).symm.trans e
  have hT' : IsSylowTwoOf (T.subgroupOf Y) ⊤ := CFSG.Quasithin.isSylowTwoOf_top_subgroupOf hT
  have hNP' : Subgroup.normalizer ((T.subgroupOf Y : Subgroup ↥Y) : Set ↥Y) ≤ P' := by
    intro z hz
    have hN : Subgroup.normalizer (T.subgroupOf Y : Set ↥Y) =
        (Subgroup.normalizer (T : Set A)).comap Y.subtype := by
      have h := Subgroup.comap_normalizer_eq_of_le_range (f := Y.subtype) (H := T)
        (by rw [Subgroup.range_subtype]; exact hT.1)
      rw [Subgroup.comap_subtype] at h
      exact h.symm
    have hzT : (z : A) ∈ Subgroup.normalizer (T : Set A) := by
      have : z ∈ (Subgroup.normalizer (T : Set A)).comap Y.subtype := hN ▸ hz
      exact this
    exact Subgroup.mem_subgroupOf.mpr (hNT ⟨z.2, hzT⟩)
  rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup Y]
  exact four_le_pRank_of_top hGA hY hcl hT' hNP' hC' hK eC

end Certified

end CFSG.LocalAnalysis.RankThreeTheoremC.TenThirteen
