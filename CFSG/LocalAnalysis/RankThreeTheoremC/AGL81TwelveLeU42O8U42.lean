theorem lieModel_of_isLieOver {X : Type} [Group X] (h : IsLieOver X (.twistedA 3) 2 1) :
    CFSG.Blueprint.LieModel X .PSU 4 2 1 := by
  obtain ⟨d, ⟨q, hqp, hqe, hd⟩, ⟨e⟩⟩ := h
  refine TransvW.U42.lieModel_of_twistedA d ⟨q, ?_, hd⟩ e
  rw [TauCeti.PrimePower.card_def, hqp, hqe, pow_one]

theorem center_eq_bot
    {A : Type} [Group A] [Finite A] {Y : Subgroup A} (hY : Open.IsQuasisimple ↥Y)
    (hO : pCoreOf 2 Y = ⊥) (h : IsLieOver (↥Y ⧸ Subgroup.center ↥Y) (.twistedA 3) 2 1) :
    Subgroup.center ↥Y = ⊥ := by
  have hodd : Odd (Nat.card (Subgroup.center ↥Y)) :=
    CFSG.Quasithin.SteinbergCD.odd_card_center_of_pCore_eq_bot
      (ParabComm.pCore_eq_bot_of_pCoreOf hO)
  obtain ⟨-, ⟨eM⟩⟩ := CFSG.LieType.Multipliers.U42.multiplier_PSU_four_two _
    (lieModel_of_isLieOver h)
  have hdvd := card_center_dvd_card_griessHopfMultiplier (Q := ↥Y) ⟨hY.1⟩ (MulEquiv.refl _)
  rw [Nat.card_congr eM.toEquiv, Nat.card_congr Multiplicative.toAdd, Nat.card_zmod] at hdvd
  rcases (Nat.dvd_prime Nat.prime_two).1 hdvd with h1 | h2
  · exact Subgroup.eq_bot_of_card_eq _ h1
  · rw [h2] at hodd
    exact absurd hodd (by decide)

theorem lieModel {A : Type} [Group A] {Y : Subgroup A} (hcen : Subgroup.center ↥Y = ⊥)
    (h : IsLieOver (↥Y ⧸ Subgroup.center ↥Y) (.twistedA 3) 2 1) :
    CFSG.Blueprint.LieModel ↥Y .PSU 4 2 1 := by
  obtain ⟨d, ⟨q, hqp, hqe, hd⟩, ⟨e⟩⟩ := h
  refine TransvW.U42.lieModel_of_twistedA d ⟨q, ?_, hd⟩
    (((QuotientGroup.quotientMulEquivOfEq hcen).trans QuotientGroup.quotientBot).symm.trans e)
  rw [TauCeti.PrimePower.card_def, hqp, hqe, pow_one]

theorem isSylowTwoOf_top_subgroupOf {A : Type} [Group A] {Y T : Subgroup A}
    (hT : IsSylowTwoOf T Y) : IsSylowTwoOf (T.subgroupOf Y) (⊤ : Subgroup ↥Y) := by
  refine ⟨le_top, hT.2.1.comap_of_injective Y.subtype Y.subtype_injective, ?_⟩
  have h1 : ((T.subgroupOf Y).subgroupOf (⊤ : Subgroup ↥Y)).index = (T.subgroupOf Y).index :=
    Subgroup.relIndex_top_right _
  rw [h1]
  exact hT.2.2

theorem normalizer_subgroupOf_le {A : Type} [Group A] {Y T P : Subgroup A} (hTY : T ≤ Y)
    (hTN : Y ⊓ Subgroup.normalizer (T : Set A) ≤ P) :
    Subgroup.normalizer ((T.subgroupOf Y : Subgroup ↥Y) : Set ↥Y) ≤ P.subgroupOf Y := by
  intro x hx
  have hN : Subgroup.normalizer (T.subgroupOf Y : Set ↥Y) =
      (Subgroup.normalizer (T : Set A)).comap Y.subtype := by
    have h := Subgroup.comap_normalizer_eq_of_le_range (f := Y.subtype) (H := T)
      (by rw [Subgroup.range_subtype]; exact hTY)
    rw [Subgroup.comap_subtype] at h
    exact h.symm
  have hxT : (x : A) ∈ Subgroup.normalizer (T : Set A) := by
    have : x ∈ (Subgroup.normalizer (T : Set A)).comap Y.subtype := hN ▸ hx
    exact this
  exact Subgroup.mem_subgroupOf.mpr (hTN ⟨x.2, hxT⟩)

theorem exists_overgroup_borel
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A}
    (e : ↥Y ≃* CFSG.Quasithin.H13.F431.U42.Y) (hP : IsParabolicTwo Y P) :
    ∃ H : Subgroup CFSG.Quasithin.H13.F431.U42.Y,
      CFSG.Quasithin.H13.F431.U42.B0 ≤ H ∧ Nat.card H = Nat.card P := by
  obtain ⟨hPY, T, hT, hTN⟩ := hP
  have hT'' : IsSylowTwoOf ((T.subgroupOf Y).map e.toMonoidHom) ⊤ :=
    CFSG.Quasithin.H13.F431.U42.isSylowTwoOf_top_map' e (isSylowTwoOf_top_subgroupOf hT)
  obtain ⟨c, hc⟩ := CFSG.Quasithin.H13.F431.U42.exists_conj_isSylowTwoOf_top hT''
    CFSG.Quasithin.H13.F431.U42.isSylow_T
  let e' : ↥Y ≃* CFSG.Quasithin.H13.F431.U42.Y := e.trans (MulAut.conj c)
  have hT' : (T.subgroupOf Y).map e'.toMonoidHom = CFSG.Quasithin.H13.F431.U42.T := by
    rw [← hc, Subgroup.map_map]
    rfl
  refine ⟨(P.subgroupOf Y).map e'.toMonoidHom, fun x hx => ?_, ?_⟩
  · rw [← CFSG.Quasithin.H13.F431.U42.normalizer_T, ← hT',
      ← Subgroup.map_equiv_normalizer_eq] at hx
    obtain ⟨z, hz, rfl⟩ := hx
    exact ⟨z, normalizer_subgroupOf_le hT.1 hTN hz, rfl⟩
  · rw [Subgroup.card_map_of_injective e'.injective]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPY).toEquiv

theorem card_parabolic_cases
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A}
    (e : ↥Y ≃* CFSG.Quasithin.H13.F431.U42.Y) (hP : IsParabolicTwo Y P) (hne : P ≠ Y) :
    Nat.card P = 192 ∨ Nat.card P = 576 ∨ Nat.card P = 960 := by
  obtain ⟨H, hBH, hcard⟩ := exists_overgroup_borel e hP
  rcases CFSG.Quasithin.H13.F431.U42.lattice hBH with h | h | h | h
  · left
    rw [← hcard, h, CFSG.Quasithin.H13.F431.U42.card_B0]
  · right; left
    rw [← hcard, h, CFSG.Quasithin.H13.F431.U42.card_P1]
  · right; right
    rw [← hcard, h, CFSG.Quasithin.H13.F431.U42.card_P2]
  · exfalso
    apply hne
    have hcardY : Nat.card P = Nat.card Y := by
      rw [← hcard, h, Subgroup.card_top, Nat.card_congr e.toEquiv]
    exact Subgroup.eq_of_le_of_card_ge hP.1 hcardY.ge

theorem card_le_nine_of_parabolic
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A}
    (e : ↥Y ≃* CFSG.Quasithin.H13.F431.U42.Y) (hP : IsParabolicTwo Y P) (hne : P ≠ Y)
    {T : Subgroup A} (hTP : T ≤ P) (hT : IsPGroup 3 T) : Nat.card T ≤ 9 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card).1 hT
  rcases Nat.lt_or_ge n 3 with h | h
  · rw [hn]
    calc 3 ^ n ≤ 3 ^ 2 := Nat.pow_le_pow_right (by norm_num) (by omega)
      _ = 9 := by norm_num
  · exfalso
    have h27 : 27 ∣ Nat.card T := by
      rw [hn]
      exact (pow_dvd_pow 3 h : 3 ^ 3 ∣ 3 ^ n)
    have h' := h27.trans (Subgroup.card_dvd_of_le hTP)
    rcases card_parabolic_cases e hP hne with h1 | h1 | h1 <;> rw [h1] at h' <;> omega

theorem inner_of_odd {X : Type} [Group X]
    (h : CFSG.Blueprint.LieModel X .PSU 4 2 1) :
    ∀ α : MulAut X, Odd (orderOf α) → ∃ g : X, α = MulAut.conj g := fun α hα => by
  obtain ⟨g, hg, -⟩ := TransvW.U42.exists_conj_of_odd_u42 h hα
  exact ⟨g, hg.symm⟩

theorem exists_isElemAbelian_card_27 {X : Type} [Group X]
    (h : CFSG.Blueprint.LieModel X .PSU 4 2 1) :
    ∃ F : Subgroup X, IsElemAbelian 3 F ∧ Nat.card F = 27 := by
  obtain ⟨e⟩ := CFSG.LieType.Multipliers.U42.nonempty_mulEquiv_PSp43 h
  obtain ⟨E, hE, hcard⟩ := CFSG.LocalAnalysis.GLTheoremA.CatB.U42.psp43_exists_E27
  refine ⟨E.map e.symm.toMonoidHom, CFSG.SectionRank.isElemAbelian_map hE _, ?_⟩
  rw [Subgroup.card_map_of_injective e.symm.injective, hcard]
  norm_num

theorem false_of_E27
    {A : Type} [Group A] [Finite A] {Y P E : Subgroup A}
    (hY : Open.IsQuasisimple ↥Y) (hO : pCoreOf 2 Y = ⊥)
    (h : IsLieOver (↥Y ⧸ Subgroup.center ↥Y) (.twistedA 3) 2 1) (hP : IsParabolicTwo Y P)
    (h9 : ∀ T : Subgroup A, T ≤ P → IsPGroup 3 T → Nat.card T ≤ 9)
    (hE : IsElemAbelian 3 E) (hE27 : Nat.card E = 27) (hEY : E ≤ normalizer (Y : Set A))
    (hEP : E ≤ normalizer (P : Set A)) (hrk : Open.pRank 3 (Y ⊔ E) ≤ 3) : False := by
  have hcen := center_eq_bot hY hO h
  have hL := lieModel hcen h
  obtain ⟨F, hF, hF27⟩ := exists_isElemAbelian_card_27 hL
  refine U42O8.false_of_card_le_nine (F := F.map Y.subtype) hcen (inner_of_odd hL) hP h9 hE hE27
    hEY hEP (Subgroup.map_subtype_le F) (CFSG.SectionRank.isElemAbelian_map hF _) ?_ hrk
  rw [Subgroup.card_map_of_injective Y.subtype_injective, hF27]

theorem card_le_nine_of_parabolic_of_isLieOver
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A} (hY : Open.IsQuasisimple ↥Y)
    (hO : pCoreOf 2 Y = ⊥) (h : IsLieOver (↥Y ⧸ Subgroup.center ↥Y) (.twistedA 3) 2 1)
    (hP : IsParabolicTwo Y P) (hne : P ≠ Y) {T : Subgroup A} (hTP : T ≤ P)
    (hT : IsPGroup 3 T) : Nat.card T ≤ 9 := by
  obtain ⟨e⟩ := CFSG.Quasithin.H13.F431.U42.nonempty_mulEquiv_Y
    (lieModel (center_eq_bot hY hO h) h)
  exact card_le_nine_of_parabolic e hP hne hTP hT

