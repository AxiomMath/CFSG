theorem exists_order_three_normalizer
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A}
    (e : ↥Y ≃* CFSG.Quasithin.H13.F431.U42.Y) (hP : IsParabolicTwo Y P) :
    ∃ T : Subgroup A, IsSylowTwoOf T Y ∧ T ≤ P ∧
      ∃ c : A, c ∈ P ∧ c ^ 3 = 1 ∧ c ≠ 1 ∧ c ∈ Subgroup.normalizer (T : Set A) := by
  obtain ⟨hPY, T, hT, hTN⟩ := hP
  have hTP : T ≤ P := fun x hx => hTN ⟨hT.1 hx, Subgroup.le_normalizer hx⟩
  have hT'' : IsSylowTwoOf ((T.subgroupOf Y).map e.toMonoidHom) ⊤ :=
    CFSG.Quasithin.H13.F431.U42.isSylowTwoOf_top_map' e (UFourTwo.isSylowTwoOf_top_subgroupOf hT)
  obtain ⟨c, hc⟩ := CFSG.Quasithin.H13.F431.U42.exists_conj_isSylowTwoOf_top hT''
    CFSG.Quasithin.H13.F431.U42.isSylow_T
  let e' : ↥Y ≃* CFSG.Quasithin.H13.F431.U42.Y := e.trans (MulAut.conj c)
  have hT' : (T.subgroupOf Y).map e'.toMonoidHom = CFSG.Quasithin.H13.F431.U42.T := by
    rw [← hc, Subgroup.map_map]
    rfl
  have h1 := CFSG.Quasithin.H13.F431.U42.c3_mem_normalizer
  rw [← hT', ← Subgroup.map_equiv_normalizer_eq] at h1
  obtain ⟨z, hz, hzc⟩ := h1
  have hzc' : e' z = CFSG.Quasithin.H13.F431.U42.c3Y := hzc
  have hzN : (z : A) ∈ Subgroup.normalizer (T : Set A) := by
    rw [normalizer_subgroupOf_eq hT.1] at hz
    exact hz
  refine ⟨T, hT, hTP, (z : A), hTN ⟨z.2, hzN⟩, ?_, ?_, hzN⟩
  · have hz3 : z ^ 3 = 1 := by
      apply e'.injective
      rw [map_pow, hzc', map_one]
      exact CFSG.Quasithin.H13.F431.U42.c3_pow_three
    simpa using congrArg Subtype.val hz3
  · intro h
    have hz1 : z = 1 := Subtype.ext h
    rw [hz1, map_one] at hzc'
    exact CFSG.Quasithin.H13.F431.U42.c3_ne_one hzc'.symm

theorem card_le_nine_hat
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A} (hY : Open.IsQuasisimple ↥Y)
    (hO : pCoreOf 2 Y = ⊥) (h : IsLieOver (↥Y ⧸ Subgroup.center ↥Y) (.twistedA 3) 2 1)
    (hP : IsParabolicTwo Y P) (hne : P ≠ Y) :
    ∀ U : Subgroup (↥P ⧸ CFSG.pCore 2 ↥P), IsPGroup 3 U → Nat.card U ≤ 9 :=
  card_le_nine_hatOf fun _ hTP hT =>
    UFourTwo.card_le_nine_of_parabolic_of_isLieOver hY hO h hP hne hTP hT

theorem noTwoSymThree_of_u42
    {A : Type} [Group A] [Finite A] {Y P : Subgroup A} (hY : Open.IsQuasisimple ↥Y)
    (hO : pCoreOf 2 Y = ⊥) (h : IsLieOver (↥Y ⧸ Subgroup.center ↥Y) (.twistedA 3) 2 1)
    (hP : IsParabolicTwo Y P) : TwelveNotLe.NoTwoSymThree P := by
  by_cases hPY : P = Y
  · subst hPY
    exact noTwoSymThree_of_quasisimple hY hO
  intro X X' hX hX' hXs hXs'
  by_contra hne
  obtain ⟨e⟩ := CFSG.Quasithin.H13.F431.U42.nonempty_mulEquiv_Y
    (UFourTwo.lieModel (UFourTwo.center_eq_bot hY hO h) h)
  obtain ⟨T, hT, hTP, c, hcP, hc3, hc1, hcT⟩ := exists_order_three_normalizer e hP
  obtain ⟨S, c', hc'3, hc'1, hc'T⟩ := exists_hat_sylow_normalizing hP.1 hT hTP hcP hc3 hc1 hcT
  exact Sym.false_of_two_symThree (pCore_two_hat_eq_bot P) hX hX' hne hXs hXs'
    (card_le_nine_hat hY hO h hP hPY) S hc'3 hc'1 hc'T

