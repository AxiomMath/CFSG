theorem false_of_nineThreeThree (hTPL : CitedBlockTransvectionPLType) {M S L : Subgroup G}
    (hK : Open.IsKGroup ↥M) (hA : Asc81bHyp M S) (hL : IsWeakSBlock M S L)
    (hX : ¬ InClassXBlock L) (hS : ¬ IsSylowTwoOf (S ⊓ L) L) (h3 : NineThreeThree M S L)
    {T : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)} (hT : T ∈ cZero (blockParabolic M S L))
    (hT3 : Nonempty (↥T ⧸ CFSG.pCore 2 ↥T ≃* Equiv.Perm (Fin 3)))
    (h27 : 27 ∣ Nat.card (blockParabolic M S L)) : False := by
  obtain ⟨hOrth, hU4, hA5, hA6, hA8⟩ := hTPL G M S L hK hA hL hX hS h3
  obtain ⟨-, hortho, -⟩ := h3
  obtain ⟨U, hU, hU3⟩ := exists_subnormal_perm_three_of_mem_cZero hT hT3
  obtain ⟨eU⟩ := hU3
  have hSub := CFSG.Open.IsSubnormal.top_iff.mp hU
  rcases hortho with ⟨d, ⟨m, q, hq, hd⟩, ⟨e⟩⟩ | ⟨n, hn, ⟨e⟩⟩
  · rcases hd with hd | hd | ⟨rfl, hd⟩
    · obtain ⟨d', ⟨q', hq', hd'⟩, ⟨φ⟩⟩ := hOrth m d ⟨q, hq, Or.inl hd⟩ ⟨e⟩
      have hm4 : 4 ≤ m := by
        have h := d.2
        rw [hd] at h
        exact (TauCeti.LieTypeIndex.inStandardRange_iff _).1
          ((TauCeti.LieTypeIndex.valid_iff _).1 h).1
      haveI : IsSimpleGroup (TauCeti.CFSGIndex.lie d').Group :=
        SymThree.isSimpleGroup_of_mulEquiv_lie_B (by omega) hq' hd' (MulEquiv.refl _)
      haveI : IsSimpleGroup
          (↥(blockParabolic M S L) ⧸ CFSG.pCore 2 ↥(blockParabolic M S L)) := φ.isSimpleGroup
      exact SymThree.false_of_isSimpleGroup_of_isSubnormal hSub eU
    · obtain ⟨d', ⟨q', hq', hd'⟩, ⟨φ⟩⟩ := hOrth m d ⟨q, hq, Or.inr hd⟩ ⟨e⟩
      have hm4 : 4 ≤ m := by
        have h := d.2
        rw [hd] at h
        exact (TauCeti.LieTypeIndex.inStandardRange_iff _).1
          ((TauCeti.LieTypeIndex.valid_iff _).1 h).1
      haveI : IsSimpleGroup (TauCeti.CFSGIndex.lie d').Group :=
        SymThree.isSimpleGroup_of_mulEquiv_lie_B (by omega) hq' hd' (MulEquiv.refl _)
      haveI : IsSimpleGroup
          (↥(blockParabolic M S L) ⧸ CFSG.pCore 2 ↥(blockParabolic M S L)) := φ.isSimpleGroup
      exact SymThree.false_of_isSimpleGroup_of_isSubnormal hSub eU
    · obtain ⟨e6⟩ := hU4 d ⟨q, hq, hd⟩ ⟨e⟩
      have hcard : Nat.card (blockParabolic M S L) = 720 := by
        rw [Nat.card_congr e6.toEquiv, Nat.card_perm, Nat.card_fin]
        norm_num
      rw [hcard] at h27
      norm_num at h27
  · rcases hn with rfl | rfl | rfl
    · obtain ⟨ePL⟩ := hA5 ⟨e⟩
      have hcard : Nat.card (blockParabolic M S L) = 6 := by
        rw [Nat.card_congr ePL.toEquiv, Nat.card_perm, Nat.card_fin]
        norm_num
      rw [hcard] at h27
      norm_num at h27
    · obtain ⟨ePL⟩ := hA6 ⟨e⟩
      have hcard : Nat.card (blockParabolic M S L) = 24 := by
        rw [Nat.card_congr ePL.toEquiv, Nat.card_perm, Nat.card_fin]
        norm_num
      rw [hcard] at h27
      norm_num at h27
    · obtain ⟨ePL⟩ := hA8 ⟨e⟩
      have hcard : Nat.card (blockParabolic M S L) = 720 := by
        rw [Nat.card_congr ePL.toEquiv, Nat.card_perm, Nat.card_fin]
        norm_num
      rw [hcard] at h27
      norm_num at h27

theorem false_of_nineThreeFour {M S L : Subgroup G} (h4 : NineThreeFour M S L)
    (h27 : 27 ∣ Nat.card (blockParabolic M S L)) : False := by
  let Lb := barM M L
  let Z : Subgroup ↥Lb := Subgroup.center ↥Lb
  let P : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M) := blockParabolic M S L
  have hPL : P ≤ Lb := barM_mono inf_le_right
  have hcardZ : Nat.card Z = 3 := h4.2.1
  obtain ⟨e⟩ := h4.2.2.2.2
  have hcardMap : Nat.card ↥((P.subgroupOf Lb).map (QuotientGroup.mk' Z)) = 24 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_perm, Nat.card_fin]
    norm_num
  have hdiv : Nat.card ↥P ∣ 72 := by
    have h := CFSG.GroupTheory.CoprimeTransport.card_eq_card_map_mk_mul_card_inf
      (N := Z) (C := P.subgroupOf Lb)
    rw [hcardMap] at h
    have hdvd : Nat.card ↥((P.subgroupOf Lb) ⊓ Z) ∣ 3 := by
      simpa [hcardZ] using Subgroup.card_dvd_of_le (inf_le_right :
        (P.subgroupOf Lb) ⊓ Z ≤ Z)
    have h72 : Nat.card ↥(P.subgroupOf Lb) ∣ 72 := by
      rw [h]
      have := Nat.mul_dvd_mul_left 24 hdvd
      norm_num at this ⊢
      exact this
    have hcardP : Nat.card ↥P = Nat.card ↥(P.subgroupOf Lb) :=
      (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPL).toEquiv).symm
    rwa [hcardP]
  exact (by norm_num : ¬ 27 ∣ (72 : ℕ)) (dvd_trans h27 hdiv)

theorem false_of_nineThreeFive {M S L : Subgroup G} (h5 : NineThreeFive M L)
    (h27 : 27 ∣ Nat.card (blockParabolic M S L)) : False := by
  let Lb := barM M L
  have hPL : blockParabolic M S L ≤ Lb := barM_mono inf_le_right
  obtain ⟨e⟩ := h5.2.1
  have hdvd : Nat.card (blockParabolic M S L) ∣ 2520 := by
    refine (Subgroup.card_dvd_of_le hPL).trans ?_
    rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup, Nat.card_fin]
    norm_num
  exact (by norm_num : ¬ 27 ∣ (2520 : ℕ)) (dvd_trans h27 hdvd)

theorem not_dvd_card_of_quotient_perm_three {X : Type} [Group X] [Finite X] {N : Subgroup X}
    [N.Normal] (hN : IsPGroup 2 N) {n : ℕ} (e : X ⧸ N ≃* Equiv.Perm (Fin n))
    (hU : ∃ U : Subgroup (X ⧸ N), CFSG.Open.IsSubnormal U ⊤ ∧
      Nonempty (↥U ≃* Equiv.Perm (Fin 3))) : ¬ 27 ∣ Nat.card X := by
  obtain ⟨U, hUsub, hU3⟩ := hU
  have hn : n = 3 := eq_three_of_subnormal_perm_of_mulEquiv e hUsub hU3
  have hquot : Nat.card (X ⧸ N) = 6 := by
    rw [Nat.card_congr e.toEquiv, hn, Nat.card_perm, Nat.card_fin]
    norm_num
  obtain ⟨k, hk⟩ := hN.exists_card_eq
  have hcard : Nat.card X = 6 * 2 ^ k := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup N, hquot, hk]
  intro h27
  rw [hcard] at h27
  have hcop : Nat.Coprime 27 (2 ^ k) := by
    simpa using (show Nat.Coprime 27 2 by norm_num).pow_right k
  have hdvd : 27 ∣ 6 := hcop.dvd_of_dvd_mul_right h27
  norm_num at hdvd

theorem false_of_nineThreeSix {M S L : Subgroup G} (h6 : NineThreeSix M S L)
    {T : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)} (hT : T ∈ cZero (blockParabolic M S L))
    (hT3 : Nonempty (↥T ⧸ CFSG.pCore 2 ↥T ≃* Equiv.Perm (Fin 3)))
    (h27 : 27 ∣ Nat.card (blockParabolic M S L)) : False := by
  obtain ⟨-, n, -, hP⟩ := h6
  obtain ⟨U, hU, hU3⟩ := exists_subnormal_perm_three_of_mem_cZero hT hT3
  let P : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M) := blockParabolic M S L
  obtain ⟨φ⟩ := hP
  have hφ : ↥P ⧸ CFSG.pCore 2 ↥P ≃* Equiv.Perm (Fin n) := by simpa [P] using φ
  have hU' : CFSG.Open.IsSubnormal U ⊤ := by simpa [P] using hU
  exact not_dvd_card_of_quotient_perm_three (CFSG.pCore_isPGroup (p := 2) (G := ↥P)) hφ
    ⟨U, hU', hU3⟩ h27

