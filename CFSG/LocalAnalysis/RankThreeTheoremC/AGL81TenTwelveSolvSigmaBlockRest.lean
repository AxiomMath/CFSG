theorem false_of_nineThreeEight {M S L : Subgroup G} (h8 : NineThreeEight M S L)
    (hr : Open.pRank 3 (barM M L) ≤ 3)
    {T : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)} (hT : T ∈ cZero (blockParabolic M S L))
    (hT3 : Nonempty (↥T ⧸ CFSG.pCore 2 ↥T ≃* Equiv.Perm (Fin 3))) : False := by
  obtain ⟨-, N, r, hNeven, h2rN, hN0, hN2, hN4, ⟨eN⟩, ⟨φ, -, -⟩⟩ := h8
  obtain ⟨U, hU, hU3⟩ := exists_subnormal_perm_three_of_mem_cZero hT hT3
  let P : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M) := blockParabolic M S L
  have hφ : ↥P ⧸ CFSG.pCore 2 ↥P ≃*
      (Equiv.Perm (Fin r) × Equiv.Perm (Fin (N - 2 * r))) := by simpa [P] using φ
  have hU' : CFSG.Open.IsSubnormal U ⊤ := by simpa [P] using hU
  have hrm : r = 3 ∨ N - 2 * r = 3 :=
    eq_three_or_eq_three_of_subnormal_perm_prod_of_mulEquiv hφ hU' hU3
  have hEven2 : Even (2 * r) := ⟨r, by ring⟩
  have hEven : Even (N - 2 * r) :=
    (Nat.even_sub h2rN).mpr ⟨fun _ => hEven2, fun _ => hNeven⟩
  have hnot3 : N - 2 * r ≠ 3 := by
    intro h
    rw [h] at hEven
    norm_num at hEven
  have hr3 : r = 3 := by
    rcases hrm with h | h
    · exact h
    · exact absurd h hnot3
  subst r
  norm_num at h2rN
  norm_num at hEven
  have hN12 : 12 ≤ N := by
    have h6N : 6 ≤ N := by omega
    obtain ⟨k, hk⟩ := hEven
    have hk2 : N - 6 = 2 * k := by omega
    have hge : 6 ≤ N - 6 := by
      by_contra h
      push Not at h
      have hklt : k < 3 := by omega
      interval_cases k <;> omega
    omega
  have h4 := CFSG.RankThree.PartTwo.Sec19.Item19Res3Proof.four_le_pRank_alternatingGroup hN12
  have htransport := CFSG.RankThree.PartTwo.Sec19.Item19Res3Proof.pRank_top_eq_of_mulEquiv_barM
    (X := M) (K := L) Nat.prime_three eN.symm
  rw [htransport] at h4
  omega

theorem false_of_nineThreeRest (hTPL : CitedBlockTransvectionPLType) {M S L : Subgroup G}
    (hK : Open.IsKGroup ↥M) (hA : Asc81bHyp M S) (hL : IsWeakSBlock M S L)
    (hX : ¬ InClassXBlock L) (hS : ¬ IsSylowTwoOf (S ⊓ L) L)
    (hc : NineThreeThree M S L ∨ NineThreeFour M S L ∨ NineThreeFive M L ∨
      NineThreeSix M S L ∨ NineThreeSeven M S L ∨ NineThreeEight M S L)
    (hr : Open.pRank 3 (barM M L) ≤ 3) {T : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)}
    (hT : T ∈ cZero (blockParabolic M S L))
    (hT3 : Nonempty (↥T ⧸ CFSG.pCore 2 ↥T ≃* Equiv.Perm (Fin 3)))
    (h27 : 27 ∣ Nat.card (blockParabolic M S L)) : False := by
  rcases hc with h3 | h4 | h5 | h6 | h7 | h8
  · exact false_of_nineThreeThree hTPL hK hA hL hX hS h3 hT hT3 h27
  · exact false_of_nineThreeFour h4 h27
  · exact false_of_nineThreeFive (S := S) h5 h27
  · exact false_of_nineThreeSix h6 hT hT3 h27
  · exact false_of_nineThreeSeven h7 hT hT3 h27
  · exact false_of_nineThreeEight h8 hr hT hT3

