theorem pCore_eq_bot_of_not_dvd_card {H : Type*} [Group H] [Finite H] {p : ℕ} [Fact p.Prime]
    (hp : ¬ p ∣ Nat.card H) : CFSG.pCore p H = ⊥ := by
  obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := p) (G := H)).exists_card_eq
  have hk0 : k = 0 := by
    rcases Nat.eq_zero_or_pos k with h | h
    · exact h
    · exfalso
      have hdiv : p ^ k ∣ Nat.card H := by
        rw [← hk]
        exact Subgroup.card_subgroup_dvd_card (CFSG.pCore p H)
      exact hp (Nat.dvd_trans (dvd_pow_self p (Nat.pos_iff_ne_zero.1 h)) hdiv)
  rw [hk0, pow_zero] at hk
  exact Subgroup.card_eq_one.1 hk

theorem not_isPerfect_perm_fin_three : ¬ Group.IsPerfect (Equiv.Perm (Fin 3)) := by
  intro h
  have htop : commutator (Equiv.Perm (Fin 3)) = ⊤ := Group.IsPerfect.commutator_eq_top
  have hle := alternatingGroup.commutator_perm_le (α := Fin 3)
  rw [htop] at hle
  have hmem : Equiv.swap (0 : Fin 3) 1 ∈ alternatingGroup (Fin 3) := hle (Subgroup.mem_top _)
  rw [Equiv.Perm.mem_alternatingGroup, Equiv.Perm.sign_swap (by decide)] at hmem
  exact absurd hmem (by decide)

theorem pCore_three_perm_eq_bot_of_ne_three {n : ℕ} (hn : n ≠ 3) :
    CFSG.pCore 3 (Equiv.Perm (Fin n)) = ⊥ := by
  rcases Nat.lt_or_ge n 4 with h | h
  · have hn2 : n ≤ 2 := by omega
    refine pCore_eq_bot_of_not_dvd_card (p := 3) ?_
    rw [Nat.card_perm, Nat.card_fin]
    intro hdvd
    have hle : n.factorial ≤ 2 := by
      have := Nat.factorial_le hn2
      simpa using this
    have h3 : 3 ≤ n.factorial := Nat.le_of_dvd (Nat.factorial_pos n) hdvd
    omega
  · exact SymThree.pCore_three_perm_eq_bot h

theorem exists_subnormal_perm_three_of_mem_cZero {X : Type} [Group X] [Finite X]
    {P T : Subgroup X} (hT : T ∈ cZero P)
    (hT3 : Nonempty (↥T ⧸ CFSG.pCore 2 ↥T ≃* Equiv.Perm (Fin 3))) :
    ∃ U : Subgroup (↥P ⧸ CFSG.pCore 2 ↥P), IsSubnormal U ⊤ ∧
      Nonempty (↥U ≃* Equiv.Perm (Fin 3)) := by
  classical
  have hle : T ≤ P := hT.le
  have hpc : pCoreOf 2 T = pCoreOf 2 P := by
    rcases hT.shape with hcomp | hshape
    · exfalso
      haveI : Group.IsPerfect ↥T := Subgroup.isPerfect_iff.mpr hcomp.perfect
      have hperfQ : Group.IsPerfect (↥T ⧸ CFSG.pCore 2 ↥T) :=
        Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' (CFSG.pCore 2 ↥T))
          (QuotientGroup.mk'_surjective _)
      obtain ⟨e⟩ := hT3
      exact not_isPerfect_perm_fin_three
        (Group.IsPerfect.ofSurjective (f := e.toMonoidHom) e.surjective)
    · exact hshape.1
  let π := QuotientGroup.mk' (CFSG.pCore 2 ↥P)
  let U : Subgroup (↥P ⧸ CFSG.pCore 2 ↥P) := (T.subgroupOf P).map π
  have hUsub : CFSG.Open.IsSubnormal (T.subgroupOf P) ⊤ :=
    CFSG.Open.IsSubnormal.of_mathlib hT.subnormal.subgroupOf
  have hU : IsSubnormal U ⊤ := by
    have h := CFSG.Open.IsSubnormal.map π hUsub
    rw [Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at h
    simpa [U] using h
  refine ⟨U, hU, ?_⟩
  let f : ↥T →* ↥P ⧸ CFSG.pCore 2 ↥P :=
    { toFun := fun t => π ⟨(t : X), hle t.2⟩
      map_one' := (congrArg π (Subtype.ext (by rfl))).trans (map_one π)
      map_mul' := fun a b =>
        (congrArg π (Subtype.ext (by rfl))).trans
          (map_mul π ⟨(a : X), hle a.2⟩ ⟨(b : X), hle b.2⟩) }
  have hker : f.ker = CFSG.pCore 2 ↥T := by
    ext t
    rw [MonoidHom.mem_ker]
    constructor
    · intro ht
      have h1 : π (⟨(t : X), hle t.2⟩ : ↥P) = 1 := by simpa [f] using ht
      have h2 : (⟨(t : X), hle t.2⟩ : ↥P) ∈ CFSG.pCore 2 ↥P :=
        (QuotientGroup.eq_one_iff _).mp h1
      have h3 : (t : X) ∈ pCoreOf 2 P :=
        (CFSG.mem_openPCoreOf_iff (G := X) (p := 2) (H := P)
          (⟨(t : X), hle t.2⟩ : ↥P)).mpr h2
      rw [← hpc] at h3
      exact (CFSG.mem_openPCoreOf_iff (G := X) (p := 2) (H := T) t).mp h3
    · intro ht
      have h1 : (t : X) ∈ pCoreOf 2 T :=
        (CFSG.mem_openPCoreOf_iff (G := X) (p := 2) (H := T) t).mpr ht
      rw [hpc] at h1
      have h2 : (⟨(t : X), hle t.2⟩ : ↥P) ∈ CFSG.pCore 2 ↥P :=
        (CFSG.mem_openPCoreOf_iff (G := X) (p := 2) (H := P)
          (⟨(t : X), hle t.2⟩ : ↥P)).mp h1
      have h3 : π (⟨(t : X), hle t.2⟩ : ↥P) = 1 :=
        (QuotientGroup.eq_one_iff _).mpr h2
      simpa [f] using h3
  have hrange : f.range = U := by
    ext y
    constructor
    · rintro ⟨t, rfl⟩
      exact Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr t.2)
    · rintro ⟨p, hp, rfl⟩
      exact ⟨⟨(p : X), hp⟩, by simp [f, π]⟩
  have eU : ↥T ⧸ CFSG.pCore 2 ↥T ≃* ↥U :=
    (QuotientGroup.quotientMulEquivOfEq hker).symm.trans
      ((QuotientGroup.quotientKerEquivRange f).trans (MulEquiv.subgroupCongr hrange))
  obtain ⟨eT⟩ := hT3
  exact ⟨eU.symm.trans eT⟩

theorem eq_three_of_subnormal_perm {n : ℕ} {U : Subgroup (Equiv.Perm (Fin n))}
    (hU : IsSubnormal U ⊤) (e : Nonempty (↥U ≃* Equiv.Perm (Fin 3))) : n = 3 := by
  by_contra hn
  obtain ⟨e⟩ := e
  exact SymThree.false_of_isSubnormal_symThree (pCore_three_perm_eq_bot_of_ne_three hn)
    (CFSG.Open.IsSubnormal.top_iff.mp hU) e

theorem eq_three_of_subnormal_perm_of_mulEquiv {X : Type} [Group X] {n : ℕ}
    (e : X ≃* Equiv.Perm (Fin n)) {U : Subgroup X} (hU : CFSG.Open.IsSubnormal U ⊤)
    (hU3 : Nonempty (↥U ≃* Equiv.Perm (Fin 3))) : n = 3 := by
  obtain ⟨eU⟩ := hU3
  have hU' : CFSG.Open.IsSubnormal (U.map e.toMonoidHom) ⊤ := by
    have h := CFSG.Open.IsSubnormal.map e.toMonoidHom hU
    rwa [Subgroup.map_top_of_surjective _ e.surjective] at h
  exact eq_three_of_subnormal_perm hU'
    ⟨(Subgroup.equivMapOfInjective U e.toMonoidHom e.injective).symm.trans eU⟩

theorem eq_three_or_eq_three_of_subnormal_perm_prod {r m : ℕ}
    {U : Subgroup (Equiv.Perm (Fin r) × Equiv.Perm (Fin m))} (hU : IsSubnormal U ⊤)
    (e : Nonempty (↥U ≃* Equiv.Perm (Fin 3))) : r = 3 ∨ m = 3 := by
  by_contra h
  push Not at h
  obtain ⟨hr, hm⟩ := h
  obtain ⟨e⟩ := e
  exact SymThree.false_of_isSubnormal_symThree
    (CFSG.Monster.B.TwoA.pCore_prod_eq_bot (pCore_three_perm_eq_bot_of_ne_three hr)
      (pCore_three_perm_eq_bot_of_ne_three hm))
    (CFSG.Open.IsSubnormal.top_iff.mp hU) e

theorem eq_three_or_eq_three_of_subnormal_perm_prod_of_mulEquiv {X : Type} [Group X]
    {r m : ℕ} (e : X ≃* (Equiv.Perm (Fin r) × Equiv.Perm (Fin m))) {U : Subgroup X}
    (hU : CFSG.Open.IsSubnormal U ⊤) (hU3 : Nonempty (↥U ≃* Equiv.Perm (Fin 3))) :
    r = 3 ∨ m = 3 := by
  obtain ⟨eU⟩ := hU3
  have hU' : CFSG.Open.IsSubnormal (U.map e.toMonoidHom) ⊤ := by
    have h := CFSG.Open.IsSubnormal.map e.toMonoidHom hU
    rwa [Subgroup.map_top_of_surjective _ e.surjective] at h
  exact eq_three_or_eq_three_of_subnormal_perm_prod hU'
    ⟨(Subgroup.equivMapOfInjective U e.toMonoidHom e.injective).symm.trans eU⟩

