@[expose] def fi24kExtra (_ : Unit := ()) : Array (List Int) := parseIntLists fi24kExtraStr

@[expose] def secOK (Ws : Array (List Int)) (gs : List Nat) (lo hi : Nat) : Bool :=
  (List.range (hi - lo)).all fun r => (Ws[lo + r]!).all fun z =>
    decide (3 ≤ z.natAbs) && (gs.contains (z.natAbs - 3) ||
      (decide (lo ≤ z.natAbs - 3) && decide (z.natAbs - 3 < lo + r)))

structure MixedSec where
  gs : List Nat
  lo : Nat
  hi : Nat
  ia : Nat
  ib : Nat

structure PureSec where
  lam : Nat
  lo : Nat
  hi : Nat
  ix : Nat
  iy : Nat
  hi2 : Nat
  oX : Nat
  oY : Nat
  oh : Nat

@[expose] def mixedSecs : List MixedSec :=
  [⟨[1085, 1086, 64, 66, 1087, 1082, 1083, 1084], 1110, 1657, 1655, 1656⟩,
    ⟨[1085, 1086, 64, 66, 1087, 1107, 1108, 1109], 1657, 2208, 2206, 2207⟩]

@[expose] def pureGens (lam : Nat) : List Nat :=
  [1085, 1086, 64, 66, 1087, 1093 + 2 * lam, 1094 + 2 * lam]

@[expose] def pureSecs : List PureSec :=
  [⟨1, 2208, 2216, 2211, 2215, 2543, 2540, 2541, 2542⟩,
    ⟨2, 2543, 2551, 2546, 2550, 2809, 2806, 2807, 2808⟩,
    ⟨3, 2809, 2817, 2812, 2816, 3081, 3078, 3079, 3080⟩,
    ⟨4, 3081, 3089, 3084, 3088, 3321, 3318, 3319, 3320⟩,
    ⟨5, 3321, 3329, 3324, 3328, 3576, 3573, 3574, 3575⟩,
    ⟨6, 3576, 3584, 3579, 3583, 3820, 3817, 3818, 3819⟩]

@[expose] def heLetter (x y : Nat) (l : Nat × Bool) : Int :=
  if l.2 then (((if l.1 = 0 then x else y) + 3 : Nat) : Int)
  else -(((if l.1 = 0 then x else y) + 3 : Nat) : Int)

@[expose] def headerOK (E : Array (List Int)) : Bool :=
  let D := fi24SevenData
  ((D.conj[3]!).1 == 1) && (E[0]! == (D.conj[3]!).2.map lt2w) &&
    ((D.conj[49]!).1 == 0) && (E[1]! == (D.conj[49]!).2.map lt2w) &&
    ((List.range 6).all fun i => ((D.conj[56 + 7 * i]!).1 == 1) &&
      (E[2 + i]! == (D.conj[56 + 7 * i]!).2.map lt2w)) &&
    ((List.range 6).all fun i =>
      (E[8 + 2 * i]! == [-((1092 + i : Nat) : Int), 1088, ((1092 + i : Nat) : Int)]) &&
      (E[9 + 2 * i]! == [-((1092 + i : Nat) : Int), 1089, ((1092 + i : Nat) : Int)])) &&
    (E[20]! == [-1091, 1085, 1091]) && (E[21]! == [-1091, 1086, 1091]) &&
    (E[22]! == [-1091, 1087, 1091])

@[expose] def mixedOK (Ws : Array (List Int)) (L : Array (Array W)) (m : MixedSec) : Bool :=
  secOK Ws m.gs m.lo m.hi && decide (m.lo ≤ m.ia) && decide (m.ia < m.hi) &&
    decide (m.lo ≤ m.ib) && decide (m.ib < m.hi) &&
    eqRows 781 L[2 * m.ia]! L[0]! && eqRows 781 L[2 * m.ib]! L[2]!

@[expose] def pureOK (Ws : Array (List Int)) (L : Array (Array W))
    (rels : List (List (Nat × Bool))) (p : PureSec) : Bool :=
  secOK Ws (pureGens p.lam) p.lo p.hi && secOK Ws [p.ix, p.iy] p.hi p.hi2 &&
    decide (p.lo ≤ p.ix) && decide (p.ix < p.hi) && decide (p.lo ≤ p.iy) && decide (p.iy < p.hi) &&
    decide (p.hi ≤ p.oX) && decide (p.oX < p.hi2) && decide (p.hi ≤ p.oY) &&
    decide (p.oY < p.hi2) && decide (p.hi ≤ p.oh) && decide (p.oh < p.hi2) &&
    (rels.all fun v => eqRows 781 (mWord L (v.map (heLetter p.ix p.iy))) (idW 781)) &&
    !eqRows 781 L[2 * p.ix]! (idW 781) &&
    eqRows 781 L[2 * p.oX]! L[2 * 64]! && eqRows 781 L[2 * p.oY]! L[2 * 66]! &&
    eqRows 781 (mulW L[2 * p.oh]! (mulW L[2 * 64]! (powW 781 L[2 * 66]! p.lam)))
      (mulW L[2 * 67]! L[2 * p.oh]!)

@[expose] def fi24kOK (_ : Unit := ()) : Bool :=
  let D := fi24SevenData
  let E := fi24kExtra ()
  let Ws := D.words ++ E
  let L := mLetters Ws
  slpOK Ws && decide (D.words.size = 1087) && decide (E.size = 2733) &&
    (D.words[0]! == [1]) && (D.words[1]! == [2]) && headerOK E &&
    eqRows 781 (mulW L[2 * 1085]! L[2 * 67]!) (mulW L[2 * 67]! L[2 * 1085]!) &&
    eqRows 781 (mulW L[2 * 1086]! L[2 * 67]!) (mulW L[2 * 67]! L[2 * 1086]!) &&
    eqRows 781 (mulW L[2 * 1082]! L[2 * 66]!) (mulW L[2 * 66]! L[2 * 1082]!) &&
    eqRows 781 (mulW L[2 * 1083]! L[2 * 66]!) (mulW L[2 * 66]! L[2 * 1083]!) &&
    eqRows 781 (mulW L[2 * 1084]! L[2 * 66]!) (mulW L[2 * 66]! L[2 * 1084]!) &&
    mixedSecs.all (mixedOK Ws L) &&
    pureSecs.all (pureOK Ws L TauCeti.Sporadic.hePresentation.relatorLetters)

end CFSG.LocalAnalysis.RankThreeTheoremC.Fi24K
