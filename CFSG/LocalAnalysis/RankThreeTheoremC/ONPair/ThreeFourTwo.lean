theorem G2_eq_map :
    G2 = M1.map ((MulAut.conj (pvEval u2Word)).trans alphaP.symm).toMonoidHom := by
  rw [G2, Subgroup.comap_equiv_eq_map_symm, lineTwo, lineStab_smul, ← M1]
  exact map_map_equiv M1 (MulAut.conj (pvEval u2Word)) alphaP.symm

theorem exists_eq_map_Q0 (hK : OnanNQOvergroups) {E W J : Subgroup Pv} (hEF : E ≤ on7F 0)
    (hE : Nat.card E = 49) (hcore : GLBCore 7 1 E ≤ W) (hW : W ≠ ⊤) (hJW : J ≤ W)
    (hJ1 : J ≠ ⊥) (hperf : ⁅J, J⁆ = J) (hsub : IsSubnormal J W) :
    ∃ φ : Pv ≃* Pv, J = Q0.map φ.toMonoidHom := by
  obtain ⟨h0, j, hj1, hj57, hjE⟩ := exists_line_mem_plane hEF hE
  have hmax : ∀ φ : Pv ≃* Pv, M1.map φ.toMonoidHom ≤ W →
      ∃ φ' : Pv ≃* Pv, J = Q0.map φ'.toMonoidHom := by
    intro φ hle
    have hco : IsCoatom (M1.map φ.toMonoidHom) := isCoatom_map_equiv φ (isCoatom_lineStab 0)
    have hWeq : W = M1.map φ.toMonoidHom := (hco.le_iff.1 hle).resolve_left hW
    refine ⟨φ, eq_map_Q0_of_perfect φ (hWeq ▸ hJW) hJ1 hperf (hWeq ▸ hsub)⟩
  by_cases hj14 : j ≤ 14
  ·
    have hi : j - 1 < 28 := by omega
    have hi14 : j - 1 < 14 := by omega
    have hsub' : Subgroup.closure {planeY0 (j - 1), planeYj (j - 1)} ≤ E := by
      rw [Subgroup.closure_le]
      rintro _ (rfl | rfl)
      · rw [planeY0, if_pos hi14]
        exact h0
      · rw [planeYj, if_pos hi14, show j - 1 + 1 = j by omega]
        exact hjE
    exact hmax (MulAut.conj (planeC (j - 1)))
      ((le_GLBCore_planeY hi).trans ((GLBCore_mono' hsub').trans hcore))
  by_cases hj28 : j ≤ 28
  ·
    have hi : j - 1 < 28 := by omega
    have hi14 : ¬ j - 1 < 14 := by omega
    have hsub' : Subgroup.closure {planeY0 (j - 1), planeYj (j - 1)} ≤
        E.map alphaP.toMonoidHom := by
      rw [Subgroup.closure_le]
      rintro _ (rfl | rfl)
      · rw [planeY0, if_neg hi14]
        exact Subgroup.mem_map_of_mem _ h0
      · rw [planeYj, if_neg hi14, show j - 1 + 1 = j by omega]
        exact Subgroup.mem_map_of_mem _ hjE
    have h1 := (le_GLBCore_planeY hi).trans (GLBCore_mono' hsub')
    rw [GLBCore_map_equiv] at h1
    have h2 := Subgroup.map_mono (f := alphaP.symm.toMonoidHom) h1
    rw [map_map_equiv, map_map_equiv, MulEquiv.self_trans_symm] at h2
    rw [show (GLBCore 7 1 E).map (MulEquiv.refl Pv).toMonoidHom = GLBCore 7 1 E from
      Subgroup.map_id _] at h2
    exact hmax _ (h2.trans hcore)
  ·
    have hN : Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) ≤ W := by
      rw [normalizer_on7F0_eq]
      refine le_trans (b := GLBCore 7 1 E) ?_ hcore
      refine le_sSup ⟨Subgroup.zpowers (on7W 0), ?_, ?_, rfl⟩
      · rw [Subgroup.zpowers_le, ← onLine_zero]
        exact h0
      · exact one_le_pRank_of_mem Nat.prime_seven (Subgroup.mem_zpowers _) (on7W_ne_one 0)
          (on7W_pow_seven 0)
    rcases hK W hN hW with hW1 | hW2
    · rw [onanM_one_eq] at hW1
      rcases eq_normalizer_or_eq card_on7F0 card_M1 card_normalizer_on7F0
          normalizer_on7F0_le_M1 noInvariantPlane_on7F0 hN hW1 with h | h
      · exact absurd (eq_bot_of_perfect_le_normalizer (h ▸ hJW) hperf) hJ1
      · refine hmax (MulEquiv.refl Pv) ?_
        rw [show M1.map (MulEquiv.refl Pv).toMonoidHom = M1 from Subgroup.map_id _, h]
    · rw [onanM_two_eq] at hW2
      rcases eq_normalizer_or_eq card_on7F0 card_G2 card_normalizer_on7F0
          normalizer_on7F0_le_G2 noInvariantPlane_on7F0 hN hW2 with h | h
      · exact absurd (eq_bot_of_perfect_le_normalizer (h ▸ hJW) hperf) hJ1
      · exact hmax ((MulAut.conj (pvEval u2Word)).trans alphaP.symm) (by rw [h, G2_eq_map])

