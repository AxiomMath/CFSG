section JIdent

theorem isSimpleGroup_Q0 : IsSimpleGroup Q0 := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  haveI := CFSG.RankThree.PartOne.KCLinearSubfield.isSimpleGroup_projectiveSL (n := 3)
    (K := ZMod 7) le_rfl
  exact Q0_equiv.symm.isSimpleGroup

theorem commutator_M1_le : ⁅M1, M1⁆ ≤ Q0 := by
  set Q' := Q0.subgroupOf M1 with hQ'
  have hcard : Nat.card (M1 ⧸ Q') = 2 := index_Q0_M1
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : IsCyclic (M1 ⧸ Q') := isCyclic_of_prime_card hcard
  rw [Subgroup.commutator_le]
  intro a ha b hb
  have h : (QuotientGroup.mk' Q' ⁅(⟨a, ha⟩ : M1), ⟨b, hb⟩⁆) = 1 := by
    rw [commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv,
      (IsCyclic.commGroup.mul_comm (QuotientGroup.mk' Q' ⟨a, ha⟩) (QuotientGroup.mk' Q' ⟨b, hb⟩))]
    group
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hQ', Subgroup.mem_subgroupOf] at h
  exact h

theorem eq_map_Q0_of_perfect (φ : Pv ≃* Pv) {J : Subgroup Pv}
    (hJW : J ≤ M1.map φ.toMonoidHom) (hJ1 : J ≠ ⊥) (hperf : ⁅J, J⁆ = J)
    (hsub : IsSubnormal J (M1.map φ.toMonoidHom)) : J = Q0.map φ.toMonoidHom := by
  have hJS : J ≤ Q0.map φ.toMonoidHom := by
    rw [← hperf]
    refine (Subgroup.commutator_mono hJW hJW).trans ?_
    rw [← Subgroup.map_commutator]
    exact Subgroup.map_mono commutator_M1_le
  have hS : IsSimpleGroup (Q0.map φ.toMonoidHom) := by
    haveI := isSimpleGroup_Q0
    exact (Q0.equivMapOfInjective φ.toMonoidHom φ.injective).symm.isSimpleGroup
  rcases isSubnormal_inf_eq_bot_or_le hsub (Subgroup.map_mono Q0_le_M1) hS with h | h
  · exact absurd (by rwa [inf_of_le_left hJS] at h) hJ1
  · exact le_antisymm hJS h

theorem nonempty_map_Q0_mulEquiv (φ : Pv ≃* Pv) :
    Nonempty (↥(Q0.map φ.toMonoidHom) ≃* projectiveSL 3 (ZMod 7)) :=
  ⟨(Q0.equivMapOfInjective φ.toMonoidHom φ.injective).symm.trans Q0_equiv.symm⟩

end JIdent

section PlaneLines

theorem onLine_zero : onLine 0 = on7W 0 := Subtype.ext (by
  show onSevenLine ⟨0 % 57, _⟩ = onSevenLine (onSevenRep (on7R 0))
  congr 1)

theorem exists_line_mem_plane {E : Subgroup Pv} (hEF : E ≤ on7F 0) (hE : Nat.card E = 49) :
    onLine 0 ∈ E ∧ ∃ j : ℕ, 1 ≤ j ∧ j < 57 ∧ onLine j ∈ E := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  have hL := on7_sevenLine 0
  have hE2 : Nat.card E = 7 ^ 2 := by rw [hE]; norm_num
  have hEc : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := by
    intro a ha b hb
    have hc := (IsPGroup.isMulCommutative_of_card_eq_prime_sq hE2).is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩
    exact congrArg Subtype.val hc
  refine ⟨onLine_zero ▸ (hL.mem_plane hEF hE2 hEc).1, ?_⟩
  obtain ⟨e, heE, hex⟩ := exists_not_mem_zpowers_of_card hL.orderOf_w hE2
  have hQF : onSevenQ = onSevenF 0 := Subgroup.eq_of_le_of_card_ge onSevenQ_le_F0
    (by rw [(onSevenF_facts 0).2.2.1, card_onSevenQ])
  have heQ : (e : Equiv.Perm (Fin N)) ∈ onSevenQ := by
    rw [hQF]
    exact Subgroup.mem_subgroupOf.1 (hEF heE)
  have he1 : (e : Equiv.Perm (Fin N)) ≠ 1 := by
    intro h
    apply hex
    rw [show e = 1 from Subtype.ext h]
    exact one_mem _
  have he7 : orderOf (e : Equiv.Perm (Fin N)) = 7 := orderOf_eq_prime (onSevenQ_pow_seven heQ) he1
  have hmem : Subgroup.zpowers (e : Equiv.Perm (Fin N)) ∈
      {H : Subgroup (Equiv.Perm (Fin N)) | H ≤ onSevenQ ∧ Nat.card H = 7} :=
    ⟨Subgroup.zpowers_le.2 heQ, by rw [Nat.card_zpowers, he7]⟩
  rw [onSevenQ_lines.1] at hmem
  obtain ⟨j, hj⟩ := hmem
  have hj' : Subgroup.zpowers (onSevenLine j) = Subgroup.zpowers (e : Equiv.Perm (Fin N)) := hj
  have hjE : onSevenLine j ∈ Subgroup.zpowers (e : Equiv.Perm (Fin N)) := by
    rw [← hj']
    exact Subgroup.mem_zpowers _
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hjE
  have hyE : onLine j ∈ E := by
    have : e ^ k = onLine j := Subtype.ext (by simpa [onLine, Nat.mod_eq_of_lt j.isLt] using hk)
    rw [← this]
    exact Subgroup.zpow_mem _ heE k
  have hj0 : (j : ℕ) ≠ 0 := by
    intro h0
    have hj00 : j = 0 := Fin.ext h0
    subst hj00
    apply hex
    have : (e : Equiv.Perm (Fin N)) ∈ Subgroup.zpowers (onSevenLine 0) := by
      rw [hj']
      exact Subgroup.mem_zpowers _
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.1 this
    refine Subgroup.mem_zpowers_iff.2 ⟨m, Subtype.ext ?_⟩
    rw [← onLine_zero]
    exact hm
  exact ⟨j, by omega, j.isLt, hyE⟩

end PlaneLines

theorem GLBCore_mono' {G : Type*} [Group G] [Finite G] {p k : ℕ} {P P' : Subgroup G}
    (h : P ≤ P') : GLBCore p k P ≤ GLBCore p k P' := by
  unfold GLBCore
  apply sSup_le_sSup
  rintro N ⟨Q, hQP, hk, hN⟩
  exact ⟨Q, hQP.trans h, hk, hN⟩

theorem isCoatom_map_equiv {G : Type*} [Group G] (φ : G ≃* G) {K : Subgroup G}
    (hK : IsCoatom K) : IsCoatom (K.map φ.toMonoidHom) := by
  rw [Subgroup.map_equiv_eq_comap_symm', MulEquiv.toMonoidHom_eq_coe, Subgroup.isCoatom_comap]
  exact hK

theorem map_map_equiv {G : Type*} [Group G] (H : Subgroup G) (φ ψ : G ≃* G) :
    (H.map φ.toMonoidHom).map ψ.toMonoidHom = H.map (φ.trans ψ).toMonoidHom := by
  rw [Subgroup.map_map]
  rfl

