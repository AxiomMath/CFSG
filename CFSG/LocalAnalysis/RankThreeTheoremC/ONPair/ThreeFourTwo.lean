section PvFacts

theorem isSimpleGroup_Pv : IsSimpleGroup Pv :=
  @MulEquiv.isSimpleGroup _ _ _ _ CFSG.Sporadic.ON.isSimpleGroup_ON onEquivPv.symm

theorem exists_noncomm_Pv : ∃ a b : Pv, a * b ≠ b * a := by
  refine Classical.byContradiction fun h => ?_
  have h' : ∀ a b : Pv, a * b = b * a := fun a b =>
    Classical.byContradiction fun hab => h ⟨a, b, hab⟩
  haveI : IsMulCommutative Pv := ⟨⟨h'⟩⟩
  have hp := Group.is_simple_iff_prime_card.1 isSimpleGroup_Pv
  rw [CFSG.ONSchreier.card_Pv] at hp
  rcases hp.eq_one_or_self_of_dvd 2 (by norm_num) with h2 | h2 <;> omega

end PvFacts

section PvSeven

theorem on7F0_not_comm : ¬ ∀ a ∈ on7F 0, ∀ b ∈ on7F 0, a * b = b * a := by
  intro h
  have hL := on7_sevenLine 0
  have hle : on7F 0 ≤ Subgroup.zpowers (on7W 0) := fun f hf =>
    hL.center_le hf fun q hq => h f hf q hq
  have := Subgroup.card_le_of_le hle
  rw [card_on7F0, Nat.card_zpowers, orderOf_on7W] at this
  norm_num at this

theorem on7F0_pow_seven {f : Pv} (hf : f ∈ on7F 0) : f ^ 7 = 1 := by
  have hQF : onSevenQ = onSevenF 0 := Subgroup.eq_of_le_of_card_ge onSevenQ_le_F0
    (by rw [(onSevenF_facts 0).2.2.1, card_onSevenQ])
  have hfQ : (f : Equiv.Perm (Fin N)) ∈ onSevenQ := by
    rw [hQF]
    exact Subgroup.mem_subgroupOf.1 hf
  exact Subtype.ext (by simpa using onSevenQ_pow_seven hfQ)

theorem sylow_eq_map_on7F (S : Sylow 7 Pv) :
    ∃ g : Pv, (S : Subgroup Pv) = (on7F 0).map (MulAut.conj g : Pv ≃* Pv).toMonoidHom := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  obtain ⟨S0, hS0⟩ := on7F0_sylow
  obtain ⟨g, hg⟩ := CFSG.AGLEmbedding.Norton.OrdinaryProofs.sylow_eq_map_conj S0 S
  exact ⟨g, hS0 ▸ hg⟩

theorem card_elemAbelian_le_Pv (B : Subgroup Pv) (hB : IsElemAbelian 7 B) :
    Nat.card B ≤ 7 ^ 2 := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  obtain ⟨S, hBS⟩ := hB.isPGroup.exists_le_sylow
  obtain ⟨g, hg⟩ := sylow_eq_map_on7F S
  have hS : Nat.card (S : Subgroup Pv) = 7 ^ 3 := by
    rw [hg, Subgroup.card_map_of_injective (MulAut.conj g).injective, card_on7F0]
    norm_num
  obtain ⟨m, hm⟩ := IsPGroup.iff_card.1 hB.isPGroup
  have hdvd : 7 ^ m ∣ 7 ^ 3 := hm ▸ hS ▸ Subgroup.card_dvd_of_le hBS
  have hm3 : m ≤ 3 := (Nat.pow_dvd_pow_iff_le_right (by norm_num)).1 hdvd
  rw [hm]
  by_contra hlt
  push Not at hlt
  have hm3' : m = 3 := by
    rcases Nat.lt_or_ge m 3 with h' | h'
    · exfalso
      have : 7 ^ m ≤ 7 ^ 2 := Nat.pow_le_pow_right (by norm_num) (by omega)
      omega
    · omega
  have hBS' : B = S := Subgroup.eq_of_le_of_card_ge hBS (by rw [hS, hm, hm3'])
  apply on7F0_not_comm
  intro a ha b hb
  have ha' : MulAut.conj g a ∈ B := by
    rw [hBS', hg]
    exact Subgroup.mem_map_of_mem _ ha
  have hb' : MulAut.conj g b ∈ B := by
    rw [hBS', hg]
    exact Subgroup.mem_map_of_mem _ hb
  have hc := congrArg Subtype.val (hB.1.is_comm.comm ⟨_, ha'⟩ ⟨_, hb'⟩)
  simp only [Subgroup.coe_mul] at hc
  rw [← map_mul, ← map_mul] at hc
  exact (MulAut.conj g).injective hc

theorem exists_plane_Pv (S : Sylow 7 Pv) :
    ∃ B : Subgroup Pv, B ≤ S ∧ IsElemAbelian 7 B ∧ Nat.card B = 7 ^ 2 := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  have hL := on7_sevenLine 0
  set E0 : Subgroup Pv := on7F 0 ⊓ Subgroup.centralizer ({on7W 1} : Set Pv) with hE0
  have h1F : on7W 1 ∈ on7F 0 := on7W_mem_F0 1
  have hnz : on7W 1 ∉ Subgroup.zpowers (on7W 0) := on7W_not_mem_zpowers 1 (by decide)
  have hle49 : Nat.card E0 ≤ 7 ^ 2 := hL.card_cent_le h1F hnz
  have hz : Subgroup.zpowers (on7W 0) ≤ E0 :=
    Subgroup.zpowers_le.2 ⟨hL.mem, Subgroup.mem_centralizer_singleton_iff.2 (hL.comm_w h1F)⟩
  have h1E : on7W 1 ∈ E0 := ⟨h1F, Subgroup.mem_centralizer_singleton_iff.2 rfl⟩
  have hlt : Subgroup.zpowers (on7W 0) < E0 :=
    lt_of_le_of_ne hz fun h => hnz (h ▸ h1E)
  have h7 : 7 < Nat.card E0 := by
    have := Subgroup.card_lt_of_lt hlt
    rwa [Nat.card_zpowers, orderOf_on7W] at this
  have hdvd : Nat.card E0 ∣ 7 ^ 3 := by
    have := Subgroup.card_dvd_of_le (inf_le_left : E0 ≤ on7F 0)
    rwa [card_on7F0] at this
  obtain ⟨k, hk3, hk⟩ := (Nat.dvd_prime_pow Nat.prime_seven).1 hdvd
  have hE49 : Nat.card E0 = 7 ^ 2 := by
    rw [hk] at h7 hle49 ⊢
    have : k = 2 := by
      rcases Nat.lt_or_ge k 2 with h' | h'
      · interval_cases k <;> norm_num at h7
      · rcases Nat.lt_or_ge k 3 with h'' | h''
        · omega
        · have : 7 ^ 3 ≤ 7 ^ k := Nat.pow_le_pow_right (by norm_num) h''
          omega
    rw [this]
  have hEl : IsElemAbelian 7 E0 :=
    ⟨IsPGroup.isMulCommutative_of_card_eq_prime_sq hE49, fun x hx => on7F0_pow_seven hx.1⟩
  obtain ⟨g, hg⟩ := sylow_eq_map_on7F S
  refine ⟨E0.map (MulAut.conj g : Pv ≃* Pv).toMonoidHom, ?_, hEl.map _, ?_⟩
  · rw [hg]
    exact Subgroup.map_mono inf_le_left
  · rw [Subgroup.card_map_of_injective (MulAut.conj g).injective, hE49]

theorem glbCore_Pv (S : Sylow 7 Pv) :
    GLBCore 7 2 (S : Subgroup Pv) = ⊤ := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  haveI hfin : Finite (CFSG.Blueprint.NativeSporadic.Carrier .ONan) :=
    Finite.of_equiv _ onEquivPv.symm.toEquiv
  have e : CFSG.Blueprint.NativeSporadic.Carrier .ONan ≃* Pv := onEquivPv
  have h : ∀ T : Sylow 7 (CFSG.Blueprint.NativeSporadic.Carrier .ONan),
      GLBCore 7 2 (T : Subgroup (CFSG.Blueprint.NativeSporadic.Carrier .ONan)) = ⊤ :=
    CFSG.AGLEmbeddingD2.glbCore_ON_seven
  exact CFSG.AGLEmbedding.Norton.OrdinaryProofs.GLBCore_top_forall_sylow_map e h S

end PvSeven

section PvOut

theorem mem_inner_of_pow_seven (x : MulAut Pv) (hx : ∃ n : ℕ, x ^ 7 ^ n = 1) :
    x ∈ inner Pv := by
  obtain ⟨n, hn⟩ := hx
  have hdvd := CFSG.Sporadic.SteinbergBI.card_outer_Pv_dvd_two
  haveI : Finite (Outer Pv) := Nat.finite_of_card_ne_zero (by
    intro h0
    rw [h0] at hdvd
    exact absurd (Nat.eq_zero_of_zero_dvd hdvd) (by norm_num))
  set q : Outer Pv := (QuotientGroup.mk x : Outer Pv) with hq
  have h1 : q ^ 7 ^ n = 1 := by
    rw [hq, ← QuotientGroup.mk_pow, hn, QuotientGroup.mk_one]
  have h2 : orderOf q ∣ Nat.gcd (7 ^ n) 2 :=
    Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one h1) ((orderOf_dvd_natCard q).trans hdvd)
  have h3 : Nat.gcd (7 ^ n) 2 = 1 := Nat.Coprime.pow_left n (by norm_num)
  rw [h3, Nat.dvd_one, orderOf_eq_one_iff] at h2
  exact (QuotientGroup.eq_one_iff x).1 h2

end PvOut

@[expose] def q7 : TauCeti.PrimePower := ⟨7, 1, Nat.prime_seven, Nat.one_pos⟩

theorem q7_card : q7.card = 7 := by
  rw [q7, TauCeti.PrimePower.card_def]
  norm_num

theorem q7_valid : (TauCeti.LieTypeIndex.A 2 q7).Valid := by
  rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
    TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
  simp only [q7_card]
  decide

theorem card_zmod_seven_q7 : Nat.card (ZMod 7) = q7.card := by
  rw [Nat.card_eq_fintype_card, ZMod.card, q7_card]

section Final

theorem threeFourTwoAt_Pv (hK : OnanNQOvergroups) : TenThirteen.ThreeFourTwoAt 7 Pv := by
  refine TenThirteen.threeFourTwoAt_of_planeCore isSimpleGroup_Pv exists_noncomm_Pv
    CFSG.ONSchreier.onP_outer_solvable mem_inner_of_pow_seven card_elemAbelian_le_Pv
    exists_plane_Pv glbCore_Pv ?_
  intro E W J hE hEc hcore hW hJW hJ1 hJp hJs _
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  obtain ⟨S, hES⟩ := hE.isPGroup.exists_le_sylow
  obtain ⟨g, hg⟩ := sylow_eq_map_on7F S
  set ψ : Pv ≃* Pv := MulAut.conj g⁻¹ with hψ
  have hEF : E.map ψ.toMonoidHom ≤ on7F 0 := by
    rintro _ ⟨x, hx, rfl⟩
    have hxS := hES hx
    rw [hg] at hxS
    obtain ⟨y, hy, rfl⟩ := hxS
    have : ψ.toMonoidHom ((MulAut.conj g : Pv ≃* Pv).toMonoidHom y) = y := by
      simp [hψ, MulAut.conj_apply, mul_assoc]
    rw [this]
    exact hy
  have hEc' : Nat.card (E.map ψ.toMonoidHom) = 49 := by
    rw [Subgroup.card_map_of_injective ψ.injective, hEc]
    norm_num
  have hcore' : GLBCore 7 1 (E.map ψ.toMonoidHom) ≤ W.map ψ.toMonoidHom := by
    rw [GLBCore_map_equiv]
    exact Subgroup.map_mono hcore
  have hW' : W.map ψ.toMonoidHom ≠ ⊤ := by
    intro h
    apply hW
    have h2 := congrArg (Subgroup.map ψ.symm.toMonoidHom) h
    rw [map_map_equiv, MulEquiv.self_trans_symm,
      Subgroup.map_top_of_surjective _ ψ.symm.surjective] at h2
    rwa [show W.map (MulEquiv.refl Pv).toMonoidHom = W from Subgroup.map_id _] at h2
  have hJ1' : J.map ψ.toMonoidHom ≠ ⊥ := by
    rwa [Ne, Subgroup.map_eq_bot_iff_of_injective _ ψ.injective]
  have hJp' : ⁅J.map ψ.toMonoidHom, J.map ψ.toMonoidHom⁆ = J.map ψ.toMonoidHom := by
    rw [← Subgroup.map_commutator, hJp]
  obtain ⟨φ, hφ⟩ := exists_eq_map_Q0 hK hEF hEc' hcore' hW' (Subgroup.map_mono hJW) hJ1' hJp'
    (CFSG.Open.IsSubnormal.map ψ.toMonoidHom hJs)
  obtain ⟨eL⟩ := CFSG.Adapters.CatalogueFieldBridges.nonempty_projectiveSL_mulEquiv_lie
    (n := 2) (k := ZMod 7) q7 q7_valid card_zmod_seven_q7
  obtain ⟨eQ⟩ := nonempty_map_Q0_mulEquiv φ
  obtain ⟨eB⟩ := CFSG.Sporadic.Bridge.ON.nonempty_mulEquiv
  let eJ : J ≃* projectiveSL 3 (ZMod 7) :=
    (J.equivMapOfInjective ψ.toMonoidHom ψ.injective).trans
      ((MulEquiv.subgroupCongr hφ).trans eQ)
  refine ⟨.sporadic .ONan, .lie ⟨.A 2 q7, q7_valid⟩, ?_, ⟨onEquivPv.symm.trans eB⟩,
    (eJ.trans eL).toMonoidHom, (eJ.trans eL).surjective⟩
  exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
    (Or.inl ⟨rfl, q7, rfl, rfl, ⟨_, q7_valid⟩, rfl, rfl, rfl⟩))))))

end Final

