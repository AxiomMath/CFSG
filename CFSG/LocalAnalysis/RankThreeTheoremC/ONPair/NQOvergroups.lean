theorem induction_closure_evalList {ws : Array (List ℤ)} {P : Pv → Prop} (h1 : P 1)
    (hmul : ∀ x y, P x → P y → P (x * y)) (hinv : ∀ x, P x → P x⁻¹)
    (hgen : ∀ k < ws.size, P (pvEval ws[k]!)) :
    ∀ g : Pv, (g : Equiv.Perm (Fin N)) ∈ Subgroup.closure {x | x ∈ evalList ws} → P g := by
  suffices key : ∀ x ∈ Subgroup.closure {x | x ∈ evalList ws}, ∀ hx : x ∈ Pv, P ⟨x, hx⟩ from
    fun g hg => key g hg g.2
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    intro hyP
    obtain ⟨k, hk, rfl⟩ := mem_evalList_iff.1 hy
    exact hgen k hk
  | one => intro _; exact h1
  | mul y z hy hz ihy ihz =>
    intro _
    exact hmul _ _ (ihy (closure_evalList_le ws hy)) (ihz (closure_evalList_le ws hz))
  | inv y hy ih =>
    intro _
    exact hinv _ (ih (closure_evalList_le ws hy))

end Gen

theorem mem_normalizer_of_conj_mem {G : Type*} [Group G] {H : Subgroup G} [Finite H] {g : G}
    (h : ∀ x ∈ H, g * x * g⁻¹ ∈ H) : g ∈ Subgroup.normalizer (H : Set G) := by
  have hle : H.map (MulAut.conj g).toMonoidHom ≤ H := by
    rintro _ ⟨x, hx, rfl⟩
    exact h x hx
  have heq : H.map (MulAut.conj g).toMonoidHom = H :=
    Subgroup.eq_of_le_of_card_ge hle
      (by rw [Subgroup.card_map_of_injective (MulAut.conj g).injective])
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨h x, fun hx => ?_⟩
  rw [← heq] at hx
  obtain ⟨y, hy, hyx⟩ := hx
  have : y = x := by simpa [MulAut.conj_apply] using hyx
  exact this ▸ hy

theorem mulAut_comm_of_isCyclic {H : Type*} [Group H] [IsCyclic H] (σ τ : MulAut H) :
    σ * τ = τ * σ :=
  (IsCyclic.mulAutMulEquiv H).injective (by rw [map_mul, map_mul, mul_comm])

theorem eq_bot_of_perfect_of_isPGroup_seven {G : Type*} [Group G] {R : Subgroup G} [Finite R]
    (hR : IsPGroup 7 R) (hperf : ⁅R, R⁆ = R) : R = ⊥ := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  haveI : Group.IsPerfect R := Subgroup.isPerfect_iff.2 hperf
  haveI : Group.IsNilpotent R := hR.isNilpotent
  by_contra hne
  haveI : Nontrivial R := (Subgroup.nontrivial_iff_ne_bot R).2 hne
  exact (Group.IsPerfect.not_isNilpotent (G := ↥R)) ‹_›

