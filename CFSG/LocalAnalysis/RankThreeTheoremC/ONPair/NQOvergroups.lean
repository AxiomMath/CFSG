theorem card_on7F0 : Nat.card (on7F 0) = 343 := by
  rw [(on7_sevenLine 0).card_eq]
  norm_num

theorem centralizer_zpowers_on7W (r : Fin 3) :
    Subgroup.centralizer ((Subgroup.zpowers (on7W r) : Subgroup Pv) : Set Pv) =
      Subgroup.centralizer ({on7W r} : Set Pv) := by
  rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]

theorem normalizer_on7F0_le_zpowers :
    Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) ≤
      Subgroup.normalizer ((Subgroup.zpowers (on7W 0) : Subgroup Pv) : Set Pv) := by
  have hL := on7_sevenLine 0
  intro n hn
  have hc : n * on7W 0 * n⁻¹ ∈ Subgroup.zpowers (on7W 0) := by
    refine hL.cent _ (hL.le_cent ((Subgroup.mem_normalizer_iff.1 hn _).1 hL.mem)) ?_
    intro f hf
    have hf' : n⁻¹ * f * n ∈ on7F 0 := (Subgroup.mem_normalizer_iff''.1 hn f).1 hf
    have hcomm := hL.comm_w hf'
    calc n * on7W 0 * n⁻¹ * f = n * (on7W 0 * (n⁻¹ * f * n)) * n⁻¹ := by group
      _ = n * ((n⁻¹ * f * n) * on7W 0) * n⁻¹ := by rw [hcomm]
      _ = f * (n * on7W 0 * n⁻¹) := by group
  refine mem_normalizer_of_conj_mem fun x hx => ?_
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
  have : n * on7W 0 ^ k * n⁻¹ = (n * on7W 0 * n⁻¹) ^ k := by
    rw [← MulAut.conj_apply, map_zpow, MulAut.conj_apply]
  rw [this]
  exact Subgroup.zpow_mem _ hc k

theorem normalizer_zpowers_le_on7F0 :
    Subgroup.normalizer ((Subgroup.zpowers (on7W 0) : Subgroup Pv) : Set Pv) ≤
      Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) := by
  have hL := on7_sevenLine 0
  intro n hn
  refine mem_normalizer_of_conj_mem fun f hf => ?_
  have hx' : n⁻¹ * on7W 0 * n ∈ Subgroup.zpowers (on7W 0) :=
    (Subgroup.mem_normalizer_iff''.1 hn _).1 (Subgroup.mem_zpowers _)
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hx'
  have hfk : f * on7W 0 ^ k = on7W 0 ^ k * f :=
    ((Commute.zpow_left (hL.comm_w hf) k)).eq.symm
  apply hL.syl
  · rw [Subgroup.mem_centralizer_singleton_iff]
    calc n * f * n⁻¹ * on7W 0 = n * (f * (n⁻¹ * on7W 0 * n)) * n⁻¹ := by group
      _ = n * (f * on7W 0 ^ k) * n⁻¹ := by rw [hk]
      _ = n * (on7W 0 ^ k * f) * n⁻¹ := by rw [hfk]
      _ = n * (n⁻¹ * on7W 0 * n) * f * n⁻¹ := by rw [hk]; group
      _ = on7W 0 * (n * f * n⁻¹) := by group
  · refine ⟨3, ?_⟩
    have h343 : f ^ (7 ^ 3) = 1 := by
      have h := pow_card_eq_one' (x := (⟨f, hf⟩ : on7F 0))
      rw [card_on7F0] at h
      exact congrArg Subtype.val h
    rw [conj_pow, h343, mul_one, mul_inv_cancel]

theorem normalizer_on7F0_eq :
    Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) =
      Subgroup.normalizer ((Subgroup.zpowers (on7W 0) : Subgroup Pv) : Set Pv) :=
  le_antisymm normalizer_on7F0_le_zpowers normalizer_zpowers_le_on7F0

