@[expose] def OnanNQOvergroups :
    Prop :=
  ∀ W : Subgroup Pv, Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) ≤ W → W ≠ ⊤ →
    W ≤ Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) ⊔
        Subgroup.centralizer ({on7W 1} : Set Pv) ∨
      W ≤ Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) ⊔
        Subgroup.centralizer ({on7W 2} : Set Pv)

