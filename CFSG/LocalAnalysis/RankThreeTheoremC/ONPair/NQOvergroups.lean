  have h1 : φ ⁅(⟨a, ha⟩ : Subgroup.normalizer _), ⟨b, hb⟩⁆ = 1 := by
    rw [commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv,
      mulAut_comm_of_isCyclic (φ ⟨a, ha⟩) (φ ⟨b, hb⟩)]
    group
  have h2 : ⁅(⟨a, ha⟩ : Subgroup.normalizer _), ⟨b, hb⟩⁆ ∈ φ.ker := h1
  rw [normalizerMonoidHom_ker_on7W, Subgroup.mem_subgroupOf] at h2
  exact h2

theorem commutator_centralizer_le :
    ⁅Subgroup.centralizer ({on7W 0} : Set Pv), Subgroup.centralizer ({on7W 0} : Set Pv)⁆ ≤
      on7F 0 := by
  have hL := on7_sevenLine 0
  set C := Subgroup.centralizer ({on7W 0} : Set Pv) with hC
  set F' := (on7F 0).subgroupOf C with hF'
  haveI hFn : F'.Normal := ⟨fun f hf c => by
    rw [hF', Subgroup.mem_subgroupOf] at hf ⊢
    simpa using hL.norm c c.2 f hf⟩
  have hcardQ : Nat.card (C ⧸ F') = 2 ^ 2 := by
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup F'
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hL.le_cent).toEquiv, card_on7F0,
      card_centralizer_on7W] at h
    norm_num at h
    omega
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcomm := (IsPGroup.isMulCommutative_of_card_eq_prime_sq hcardQ).is_comm
  rw [Subgroup.commutator_le]
  intro a ha b hb
  have h : (QuotientGroup.mk' F' ⁅(⟨a, ha⟩ : C), ⟨b, hb⟩⁆) = 1 := by
    rw [commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv,
      hcomm.comm (QuotientGroup.mk' F' ⟨a, ha⟩)]
    group
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hF', Subgroup.mem_subgroupOf] at h
  exact h

theorem eq_bot_of_perfect_le_normalizer {J : Subgroup Pv}
    (hJ : J ≤ Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv)) (hperf : ⁅J, J⁆ = J) :
    J = ⊥ := by
  rw [normalizer_on7F0_eq] at hJ
  have hJC : J ≤ Subgroup.centralizer ({on7W 0} : Set Pv) :=
    hperf ▸ (Subgroup.commutator_mono hJ hJ).trans commutator_normalizer_le
  have hJF : J ≤ on7F 0 :=
    hperf ▸ (Subgroup.commutator_mono hJC hJC).trans commutator_centralizer_le
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  have hF7 : IsPGroup 7 (on7F 0) := IsPGroup.of_card (by rw [card_on7F0]; norm_num : Nat.card
    (on7F 0) = 7 ^ 3)
  exact eq_bot_of_perfect_of_isPGroup_seven (hF7.to_le hJF) hperf

