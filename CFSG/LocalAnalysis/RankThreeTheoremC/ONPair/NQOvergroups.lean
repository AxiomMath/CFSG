theorem card_mulAut_zpowers_on7W (r : Fin 3) :
    Nat.card (MulAut (Subgroup.zpowers (on7W r))) = 6 := by
  rw [IsCyclic.card_mulAut, Nat.card_zpowers, orderOf_on7W]
  decide

theorem mem_centralizer_of_pow {r : Fin 3} {g : Pv}
    (hg : g ∈ Subgroup.normalizer ((Subgroup.zpowers (on7W r) : Subgroup Pv) : Set Pv))
    (h7 : g ^ (7 ^ 3) = 1) : g ∈ Subgroup.centralizer ({on7W r} : Set Pv) := by
  set φ := (Subgroup.zpowers (on7W r)).normalizerMonoidHom
  have h1 : φ ⟨g, hg⟩ ^ (7 ^ 3) = 1 := by
    rw [← map_pow]
    have : (⟨g, hg⟩ : Subgroup.normalizer _) ^ (7 ^ 3) = 1 := Subtype.ext (by simpa using h7)
    rw [this, map_one]
  have h2 : orderOf (φ ⟨g, hg⟩) ∣ Nat.gcd (7 ^ 3) 6 :=
    Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one h1)
      (card_mulAut_zpowers_on7W r ▸ orderOf_dvd_natCard _)
  have h3 : φ ⟨g, hg⟩ = 1 := by
    rw [show Nat.gcd (7 ^ 3) 6 = 1 by norm_num, Nat.dvd_one, orderOf_eq_one_iff] at h2
    exact h2
  have h4 : (⟨g, hg⟩ : Subgroup.normalizer _) ∈ φ.ker := h3
  rw [normalizerMonoidHom_ker_on7W, Subgroup.mem_subgroupOf] at h4
  exact h4

theorem centralizer_on7W_not_le (r : Fin 3) (hr : r ≠ 0) :
    ¬ Subgroup.centralizer ({on7W r} : Set Pv) ≤
      Subgroup.normalizer ((on7F 0 : Subgroup Pv) : Set Pv) := by
  intro hle
  have hL0 := on7_sevenLine 0
  have hLr := on7_sevenLine r
  have hFr : on7F r ≤ on7F 0 := by
    intro f hf
    have hfN := (hle (hLr.le_cent hf))
    rw [normalizer_on7F0_eq] at hfN
    have h343 : f ^ (7 ^ 3) = 1 := by
      have h := pow_card_eq_one' (x := (⟨f, hf⟩ : on7F r))
      rw [hLr.card_eq] at h
      exact congrArg Subtype.val h
    exact hL0.syl _ (mem_centralizer_of_pow hfN h343) ⟨3, h343⟩
  have hFeq : on7F r = on7F 0 :=
    Subgroup.eq_of_le_of_card_ge hFr (by rw [hLr.card_eq, card_on7F0]; norm_num)
  apply on7W_not_mem_zpowers r hr
  have hxr : on7W r ∈ on7F 0 := hFeq ▸ hLr.mem
  refine hL0.cent _ (hL0.le_cent hxr) fun f hf => ?_
  have hf' : f ∈ on7F r := hFeq ▸ hf
  exact (hLr.comm_w hf')

