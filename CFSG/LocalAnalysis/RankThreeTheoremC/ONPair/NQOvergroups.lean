theorem commutator_normalizer_le :
    ⁅Subgroup.normalizer ((Subgroup.zpowers (on7W 0) : Subgroup Pv) : Set Pv),
      Subgroup.normalizer ((Subgroup.zpowers (on7W 0) : Subgroup Pv) : Set Pv)⁆ ≤
