private theorem tits_simple {d : TauCeti.ValidLieTypeIndex} (hd : d.1 = .tits) {A : Type}
    [Group A] (e : A ≃* (TauCeti.CFSGIndex.lie d).Group) :
    Finite A ∧ IsSimpleGroup A ∧ (∃ a b : A, a * b ≠ b * a) ∧ Group.IsSolvable (Outer A) := by
  obtain ⟨eD⟩ : Nonempty (A ≃* CFSG.Sporadic.Schreier.Tits.titsD) := by
    obtain ⟨⟨d, hv⟩, rfl⟩ : ∃ d' : {d : TauCeti.LieTypeIndex // d.Valid}, d' = d := ⟨d, rfl⟩
    simp only at hd
    subst hd
    exact CFSG.Sporadic.Schreier.Tits.titsModelEquiv A 2 1
      (CFSG.RankThree.PartOne.CTP.reeTitsModel_tits ⟨hv, ⟨e⟩⟩)
  haveI : Finite A := Finite.of_equiv _ eD.symm.toEquiv
  haveI : IsSimpleGroup CFSG.Sporadic.Schreier.Tits.titsD :=
    CFSG.Sporadic.Schreier.Tits.titsD_simple
  haveI hs : IsSimpleGroup A := eD.isSimpleGroup
  have h25 : 5 ^ 2 ∣ Nat.card A := by
    rw [Nat.card_congr eD.toEquiv, CFSG.Sporadic.Schreier.Tits.card_titsD]
    norm_num
  refine ⟨inferInstance, hs, CFSG.AGLEmbedding.nonabelian_of_simple_of_sq_dvd Nat.prime_five h25,
    ?_⟩
  have hO : Nat.card (Outer A) = 2 := CFSG.AGLEmbeddingD2.card_outer_tits_of_mulEquiv d hd e
  haveI : Finite (Outer A) := Nat.finite_of_card_ne_zero (by rw [hO]; norm_num)
  haveI : Group.IsNilpotent (Outer A) :=
    (IsPGroup.of_card (p := 2) (n := 1) (by rw [hO]; norm_num)).isNilpotent
  infer_instance

theorem threeFourTwoNoneAt_tits {d : TauCeti.ValidLieTypeIndex} (hd : d.1 = .tits) :
    ThreeFourTwoNoneAt 5 (TauCeti.CFSGIndex.lie d).Group := by
  obtain ⟨-, hX1, hX2, hX3⟩ := tits_simple hd (MulEquiv.refl _)
  refine threeFourTwoNoneAt_of_inf hX1 hX2 hX3 ?_
  intro Y _ _ K Y₀ E R _ _ hKn hKX _ _ _ hER hE hEc hcore _ hKY
  haveI := hKn
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨e⟩ := hKX
  obtain ⟨-, hKs, hKnab, -⟩ := tits_simple hd e
  have hZK : center K = ⊥ := CFSG.ComponentClassification.Helpers.center_eq_bot K hKnab
  obtain ⟨T', hT'⟩ := CFSG.QuasithinUnique.exists_sylow_map_eq_inf_of_normal R K
  set T : Subgroup Y := (R : Subgroup Y) ⊓ K with hTdef
  set C : Subgroup Y := centralizer (K : Set Y) with hCdef
  have hKC : K ⊓ C = ⊥ := inf_centralizer_self_eq_bot_of_center hZK
  have hTR : T ≤ R := inf_le_left
  have hTK : T ≤ K := inf_le_right
  have hKc : centralizer (((⊤ : Subgroup K) : Subgroup K) : Set K) = ⊥ := by
    rw [Subgroup.coe_top, Subgroup.centralizer_univ, hZK]
  obtain ⟨-, hcard, hmax, -, hsolv, t, htN, m, -, -, hm, -, -, -, -, hline⟩ :=
    CFSG.AGLEmbeddingD2.d2TorusLocalAt_tits d hd K ⊤ inferInstance hKc
      ⟨Subgroup.topEquiv.trans e⟩ 5 rfl T'
  have hexp : ∀ x ∈ (T' : Subgroup K), x ^ 5 = 1 :=
    CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.Stroth.SignalizerTrivial.pow_eq_one_of_torus
      Nat.prime_five hcard htN fun Y₁ hY₁ hY₁c => by
        simpa using hline 1 one_pos (by omega) Y₁ hY₁ hY₁c
  have hTcard : Nat.card T = 5 ^ 2 := by
    rw [← hT', Subgroup.card_map_of_injective K.subtype_injective]
    exact hcard
  have hTe : CFSG.Open.IsElemAbelian 5 T := by
    haveI : IsMulCommutative (T' : Subgroup K) :=
      IsPGroup.isMulCommutative_of_card_eq_prime_sq hcard
    rw [← hT']
    exact CFSG.SectionRank.isElemAbelian_map ⟨inferInstance, hexp⟩ K.subtype
  have hNY : normalizer (T : Set Y) ≤ Y₀ := by
    by_cases hRC : (R : Subgroup Y) ⊓ C = ⊥
    ·
      have hY'C := centralizer_subgroupOf_sup_sylow_eq_bot R hKC hRC
      obtain ⟨-, hRcard, -⟩ := CFSG.AGLEmbeddingD2.d2TorusLocalAt_tits d hd
        ↥(K ⊔ (R : Subgroup Y)) (K.subgroupOf (K ⊔ (R : Subgroup Y))) inferInstance hY'C
        ⟨(Subgroup.subgroupOfEquivOfLe le_sup_left).trans e⟩ 5 rfl (R.subtype le_sup_right)
      have hR25 : Nat.card (R : Subgroup Y) = 5 ^ 2 := by
        rw [Sylow.coe_subtype,
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe le_sup_right).toEquiv] at hRcard
        exact hRcard
      have hRT : T = R := Subgroup.eq_of_le_of_card_ge hTR (by rw [hR25, hTcard])
      have h3 : ¬ 3 ≤ CFSG.pRank 5 (R : Subgroup Y) := by
        rw [CFSG.SectionRank.pRank_coe_eq_openPRank]
        intro h3
        obtain ⟨F, hFR, -, hFc⟩ :=
          CFSG.SectionRank.exists_pRank (by norm_num : 1 < 5) (R : Subgroup Y)
        have h1 := Subgroup.card_le_of_le hFR
        rw [hFc, hR25] at h1
        have h2 : 5 ^ 3 ≤ 5 ^ CFSG.Open.pRank 5 (R : Subgroup Y) :=
          Nat.pow_le_pow_right (by norm_num) h3
        omega
      rw [if_neg h3] at hcore
      have hET : E = T :=
        Subgroup.eq_of_le_of_card_ge (hER.trans hRT.ge) (by rw [hTcard, hEc])
      have h1 : 1 ≤ CFSG.Open.pRank 5 E :=
        (CFSG.SectionRank.le_pRank (by norm_num) le_rfl hE hEc).trans' (by norm_num)
      rw [← hET]
      exact (le_sSup ⟨E, le_rfl, h1, rfl⟩ :
        normalizer (E : Set Y) ≤ CFSG.Open.GLBCore 5 1 E).trans hcore
    ·
      obtain ⟨c, hcRC, hc5, -⟩ := exists_orderOf_eq_mem_center_of_le_sylow R.isPGroup'
        inf_le_left (self_le_normalizer_inf_normal (N := C)) hRC
      have hcC : c ∈ C := (Subgroup.mem_inf.mp hcRC).2
      have hcR : c ∈ (R : Subgroup Y) := (Subgroup.mem_inf.mp hcRC).1
      have hTc : ∀ a ∈ T, ∀ b ∈ zpowers c, a * b = b * a := fun a ha b hb =>
        Subgroup.mem_centralizer_iff.mp ((zpowers_le.mpr hcC) hb) a (hTK ha)
      have hTcbot : T ⊓ zpowers c = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        have hx' : x ∈ K ⊓ C := ⟨hTK hx.1, (zpowers_le.mpr hcC) hx.2⟩
        rwa [hKC] at hx'
      have hcE : CFSG.Open.IsElemAbelian 5 (zpowers c) :=
        CFSG.Open.isElemAbelian_zpowers (hc5 ▸ pow_orderOf_eq_one c)
      have hcc : Nat.card (zpowers c) = 5 ^ 1 := by rw [Nat.card_zpowers, hc5, pow_one]
      have hcT : c ∈ centralizer (T : Set Y) :=
        Subgroup.mem_centralizer_iff.mpr fun h hh =>
          Subgroup.mem_centralizer_iff.mp hcC h (hTK hh)
      have h3' : 2 + 1 ≤ CFSG.Open.pRank 5 (R : Subgroup Y) :=
        le_openPRank_sup_of_commute (by norm_num) hTe hcE hTc hTcbot hTcard hcc
          (sup_le hTR (zpowers_le.mpr hcR))
      have h3 : 3 ≤ CFSG.pRank 5 (R : Subgroup Y) := by
        rw [CFSG.SectionRank.pRank_coe_eq_openPRank]
        exact h3'
      rw [if_pos h3] at hcore
      have h2T : 2 ≤ CFSG.Open.pRank 5 T :=
        CFSG.SectionRank.le_pRank (by norm_num) le_rfl hTe hTcard
      have h3T : 2 + 1 ≤ CFSG.Open.pRank 5 (T ⊔ ((R : Subgroup Y) ⊓ centralizer (T : Set Y))) :=
        le_openPRank_sup_of_commute (by norm_num) hTe hcE hTc hTcbot hTcard hcc
          (sup_le_sup_left (zpowers_le.mpr (Subgroup.mem_inf.mpr ⟨hcR, hcT⟩)) T)
      exact (CFSG.PreuniquenessRankFour.Helpers.normalizer_le_weakCore 5 hTR h2T h3T).trans hcore
  have hN : normalizer ((T' : Subgroup K) : Set K) ≤ Y₀.subgroupOf K := by
    intro n hn
    rw [Subgroup.mem_subgroupOf]
    have h := Subgroup.le_normalizer_map K.subtype (Subgroup.mem_map_of_mem K.subtype hn)
    rw [hT'] at h
    exact hNY h
  left
  rcases hmax _ hN with h | h
  · have hs : Group.IsSolvable (Y₀.subgroupOf K) := by
      rw [h]
      exact hsolv
    exact isSolvable_inf_of_isSolvable_subgroupOf le_rfl hs
  · exact absurd (Subgroup.subgroupOf_eq_top.mp h) hKY

end CFSG.LocalAnalysis.RankThreeTheoremC.TenThirteen
