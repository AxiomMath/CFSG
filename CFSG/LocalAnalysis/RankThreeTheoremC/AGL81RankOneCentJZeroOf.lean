variable {X : Type} [Group X] [Finite X] {p : ℕ} [Fact p.Prime]

theorem not_hasNormalPComplement_of_perm_three (e : X ≃* Equiv.Perm (Fin 3)) :
    ¬ CFSG.HasNormalPComplement 3 X := by
  rintro ⟨N, hN, hc, hq⟩
  haveI := hN
  haveI : (N.map e.toMonoidHom).Normal := hN.map _ e.surjective
  have hb := SevenFourL34.perm_three_normal_eq_bot (N.map e.toMonoidHom) (by
    rw [Subgroup.card_map_of_injective e.injective]
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp hc)
  have hN1 : N = ⊥ := by rwa [Subgroup.map_eq_bot_iff_of_injective _ e.injective] at hb
  subst hN1
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨k, hk⟩ := hq.exists_card_eq
  rw [Nat.card_congr (QuotientGroup.quotientBot (G := X)).toEquiv, Nat.card_congr e.toEquiv,
    Nat.card_perm, Nat.card_eq_fintype_card, Fintype.card_fin] at hk
  have h2 : 2 ∣ 3 ^ k := hk ▸ (by decide : 2 ∣ Nat.factorial 3)
  have := Nat.Prime.dvd_of_dvd_pow Nat.prime_two h2
  omega

end Abstract

variable {G : Type} [Group G] [Finite G]

theorem exists_mem_cZero_dvd {H L : Subgroup G} {p : ℕ} [Fact p.Prime]
    (hd : p ∣ Nat.card (jZero H L)) : ∃ I ∈ cZero (H ⊓ L), p ∣ Nat.card I := by
  by_contra hne
  push Not at hne
  have hp : p.Prime := Fact.out
  have hJ : jZero H L ≤ (CFSG.pPrimeCore p ↥(H ⊓ L)).map (H ⊓ L).subtype := by
    refine iSup₂_le fun I hI => ?_
    have hle : I ≤ H ⊓ L := hI.le
    have hsn : (I.subgroupOf (H ⊓ L)).IsSubnormal :=
      (CFSG.Open.IsSubnormal.iff_subgroupOf hle).1 hI.subnormal
    have hcop : Nat.Coprime p (Nat.card (I.subgroupOf (H ⊓ L))) := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]
      exact hp.coprime_iff_not_dvd.2 (hne I hI)
    have hcore := CFSG.GH74.GLS.le_pPrimeCore_of_subnormal p hsn hcop
    intro x hx
    exact ⟨⟨x, hle hx⟩, hcore (by simpa [Subgroup.mem_subgroupOf] using hx), rfl⟩
  have hdvd := hd.trans (Subgroup.card_dvd_of_le hJ)
  rw [Subgroup.card_map_of_injective (H ⊓ L).subtype_injective] at hdvd
  exact hp.coprime_iff_not_dvd.1 CFSG.pPrimeCore_coprime_card hdvd

theorem exists_surjective_of_le {I J : Subgroup G} (hIJ : I ≤ J) :
    ∃ (T : Subgroup (↥J ⧸ CFSG.pCore 2 ↥J)) (g : ↥T →* ↥I ⧸ CFSG.pCore 2 ↥I),
      Function.Surjective g := by
  set f : ↥I →* ↥J ⧸ CFSG.pCore 2 ↥J :=
    (QuotientGroup.mk' (CFSG.pCore 2 ↥J)).comp (Subgroup.inclusion hIJ) with hf
  have hk : f.ker = (CFSG.pCore 2 ↥J).comap (Subgroup.inclusion hIJ) := by
    ext x
    simp [hf, QuotientGroup.eq_one_iff]
  have hker : f.ker ≤ CFSG.pCore 2 ↥I := by
    refine CFSG.BaerSuzuki.Helpers.le_pCore_of_normal_isPGroup (MonoidHom.normal_ker f) ?_
    rw [hk]
    exact CFSG.pCore_isPGroup.comap_of_injective _ (Subgroup.inclusion_injective hIJ)
  refine ⟨f.range, (QuotientGroup.map f.ker (CFSG.pCore 2 ↥I) (MonoidHom.id _)
    fun x hx => hker hx).comp (QuotientGroup.quotientKerEquivRange f).symm.toMonoidHom, ?_⟩
  intro q
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
  refine ⟨QuotientGroup.quotientKerEquivRange f (QuotientGroup.mk x), ?_⟩
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply]
  rfl

theorem two_le_pRank_of_su {I : Subgroup G} {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 4) (e : ↥I ⧸ CFSG.pCore 2 ↥I ≃* ↥(StatedSU 3 2 K)) :
    2 ≤ Open.pRank 3 I := by
  obtain ⟨E, hE, hE9⟩ := CFSG.RankThree.PartTwo.Sec8.Hering418.exists_elemAbelian_nine_statedSU
    (q := 2) (by rw [hK]; norm_num) (by norm_num)
  have h1 : 2 ≤ Open.pRank 3 (⊤ : Subgroup (↥I ⧸ CFSG.pCore 2 ↥I)) :=
    CFSG.SectionRank.le_pRank_of_injective (by norm_num) (A := ↥E)
      (fun a b => hE.1.is_comm.comm a b) (fun a => Subtype.ext (by simpa using hE.2 a a.2))
      (by rw [hE9]; norm_num) (e.symm.toMonoidHom.comp E.subtype)
      (e.symm.injective.comp E.subtype_injective) le_top
  rw [CFSG.SectionRank.pRank_quotient_two_group (CFSG.pCore 2 ↥I) CFSG.pCore_isPGroup
    Nat.prime_three (by norm_num)] at h1
  obtain ⟨F, -, hF, hFc⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num)
    (⊤ : Subgroup ↥I)
  have h2 : Open.pRank 3 (⊤ : Subgroup ↥I) ≤ Open.pRank 3 I :=
    CFSG.SectionRank.le_pRank_of_injective (by norm_num) (A := ↥F)
      (fun a b => hF.1.is_comm.comm a b) (fun a => Subtype.ext (by simpa using hF.2 a a.2)) hFc
      (I.subtype.comp F.subtype) (I.subtype_injective.comp F.subtype_injective)
      (by rintro _ ⟨x, rfl⟩; exact (x : ↥I).2)
  omega

theorem agl81ElevenElevenJZeroShape_holds : AGL81ElevenElevenJZeroShape G := by
  intro _ p P M H Q K _ hKs _ L _ _ hJX hX1 hpJ
  have hp35 : p = 3 ∨ p = 5 := by
    obtain ⟨d, hd, -⟩ := hKs
    rcases hd with ⟨h3, -⟩ | ⟨h5, -⟩
    exacts [Or.inl h3, Or.inr h5]
  have hp : p.Prime := by rcases hp35 with rfl | rfl <;> norm_num
  haveI : Fact p.Prime := ⟨hp⟩
  have hp2 : p ≠ 2 := by omega
  obtain ⟨I, hI, hdI⟩ := exists_mem_cZero_dvd hpJ
  have hIJ : I ≤ jZero H L := le_iSup₂_of_le I hI le_rfl
  have hr : Open.pRank p I ≤ 1 := by
    have := CFSG.SectionRank.pRank_mono hp.one_lt (hIJ.trans hJX)
    omega
  have hdQ : p ∣ Nat.card (↥I ⧸ CFSG.pCore 2 ↥I) := by
    have hdI' := hdI
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (CFSG.pCore 2 ↥I)] at hdI'
    rcases (Nat.Prime.dvd_mul hp).1 hdI' with h | h
    · exact h
    · haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥I)).exists_card_eq
      rw [hk] at h
      exact absurd ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 (hp.dvd_of_dvd_pow h)) hp2
  have h3 : IsSymThreeOrSUThreeTwo (↥I ⧸ CFSG.pCore 2 ↥I) → p = 3 := fun hb =>
    (prime_eq_of_dvd_card_of_symThree hb hp hdI).resolve_left hp2
  have hnSU : ¬ ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = 4 ∧
      Nonempty (↥I ⧸ CFSG.pCore 2 ↥I ≃* ↥(StatedSU 3 2 K)) := by
    rintro hSU
    have hp3 := h3 (Or.inr hSU)
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hSU
    have := two_le_pRank_of_su hK e
    subst hp3
    omega
  obtain ⟨T, g, hg⟩ := exists_surjective_of_le hIJ
  refine ⟨fun hN => ?_, fun hs => ?_⟩
  ·
    have hQ : CFSG.HasNormalPComplement p (↥I ⧸ CFSG.pCore 2 ↥I) :=
      hasNormalPComplement_of_surjective' g hg
        (CFSG.LocalAnalysis.GLTheoremB.MovingAround.InputsMisc5.hasNormalPComplement_of_injective
          T.subtype T.subtype_injective hN)
    rcases hI.shape with hc | ⟨-, hb⟩
    · haveI : Group.IsPerfect ↥I := Subgroup.isPerfect_iff.mpr hc.perfect
      exact hp.coprime_iff_not_dvd.mp (coprime_card_of_perfect hQ) hdQ
    · have hp3 := h3 hb
      rcases hb with ⟨⟨e⟩⟩ | hSU
      · subst hp3
        exact not_hasNormalPComplement_of_perm_three e hQ
      · exact hnSU hSU
  ·
    have hQ : CFSG.HallHigman.IsPSolvable p (↥I ⧸ CFSG.pCore 2 ↥I) :=
      isPSolvable_of_surjective g hg (InnerQ.HallHigman.IsPSolvable.subgroup' hs T)
    rcases hI.shape with hc | ⟨-, hb⟩
    · have hB : barM I I = ⊤ := by
        refine (Subgroup.eq_top_iff' _).mpr fun q => ?_
        obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥I) q
        exact ⟨x, Subgroup.mem_subgroupOf.mpr x.2, rfl⟩
      refine absurd (InnerQ.HallHigman.IsPSolvable.subgroup' hQ (barM I I))
        (not_isPSolvable_of_isQuasisimple hc.component.2.2 ?_)
      rw [hB, Subgroup.card_top]
      exact hdQ
    · have hp3 := h3 hb
      rcases hb with hS | hSU
      · exact ⟨hp3, I, hI, hS⟩
      · exact absurd hSU hnSU

