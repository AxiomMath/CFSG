theorem clauseO_nineThreeTwo (hLF : LargeFieldParabolic) (hU : OutU33)
    (hGA : GriessAllModelsStatement) {M S L : Subgroup G} (hL : IsWeakSBlock M S L)
    (h2 : NineThreeTwo M S L) (hSyl : ¬ IsSylowTwoOf (barM M (S ⊓ L)) (barM M L))
    (hsolv : BlockPLThreeSolv M S L) (hr : Open.pRank 3 L ≤ 3) : ClauseO M L := by
  have hrb : Open.pRank 3 (⊤ : Subgroup ↥(barM M L)) = Open.pRank 3 L := by
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup,
      pRank_barM_eq Nat.prime_three (by norm_num) M L hL.le]
  have hperf : Group.IsPerfect ↥(barM M L) :=
    Subgroup.isPerfect_iff.mpr (barM_perfect hL.le hL.perfect)
  rcases h2.1 with ⟨d, hd, ⟨e⟩⟩ | ⟨n, hn, ⟨e⟩⟩ | ⟨d, hd, ⟨e⟩⟩
  · have h4 := lieField_lt_four_of_nineThreeTwo hLF hL h2 hSyl hsolv d hd e
    exact clauseO_of_cover hL.le hL.perfect (autThreePowInner_of_lie_two hGA hperf (by omega) d
      hd (lieField_eq_two_of_lt_four d hd h4) e) (MulEquiv.refl _)
  · exact clauseO_of_cover hL.le hL.perfect (autThreePowInner_alt_of_five_le (by omega)) e
  · rcases hd with ⟨q, hq, hd⟩ | ⟨q, hq, hd⟩
    · exact clauseO_of_cover hL.le hL.perfect (outL27_proved _ ⟨d, ⟨q, hq, hd⟩, ⟨e⟩⟩)
        (MulEquiv.refl _)
    · exact clauseO_of_cover hL.le hL.perfect (hU _ ⟨d, ⟨q, hq, hd⟩, ⟨e⟩⟩) (MulEquiv.refl _)

theorem exists_alt_of_nineThreeThree (hT : CitedBlockTransvectionPLType)
    {M S L : Subgroup G} (hK : Open.IsKGroup ↥M) (hA : Asc81bHyp M S) (hL : IsWeakSBlock M S L)
    (hX : ¬ InClassXBlock L) (hS : ¬ IsSylowTwoOf (S ⊓ L) L) (h3 : NineThreeThree M S L)
    (hsolv : BlockPLThreeSolv M S L) :
    ∃ n : ℕ, (n = 5 ∨ n = 6 ∨ n = 8) ∧ Nonempty (↥(barM M L) ≃* alternatingGroup (Fin n)) := by
  obtain ⟨hOrth, hU4, -⟩ := hT G M S L hK hA hL hX hS h3
  have hperf : ∀ V : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M), V ≤ blockPL M S L → ⁅V, V⁆ = V →
      Nat.Coprime 3 (Nat.card V) := fun V hV hVp =>
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr (hsolv V hV hVp)
  have hm4 : ∀ (m : ℕ) (q : TauCeti.PrimePower) (d : TauCeti.ValidLieTypeIndex),
      (d.1 = .D m q ∨ d.1 = .twistedD m q) → 4 ≤ m := by
    intro m q d hd
    have h := d.2
    rcases hd with hd | hd <;> rw [hd] at h <;>
      exact (TauCeti.LieTypeIndex.inStandardRange_iff _).1
        ((TauCeti.LieTypeIndex.valid_iff _).1 h).1
  rcases h3.2.1 with ⟨d, ⟨m, q, hq, hd⟩, ⟨e⟩⟩ | h
  · exfalso
    rcases hd with hd | hd | ⟨rfl, hd⟩
    · obtain ⟨d', ⟨q', hq', hd'⟩, ⟨φ⟩⟩ := hOrth m d ⟨q, hq, Or.inl hd⟩ ⟨e⟩
      exact false_of_quotient_sp_of_three (k := m - 1)
        (by have := hm4 m q d (Or.inl hd); omega) ⟨q', hq', hd'⟩ hperf φ
    · obtain ⟨d', ⟨q', hq', hd'⟩, ⟨φ⟩⟩ := hOrth m d ⟨q, hq, Or.inr hd⟩ ⟨e⟩
      exact false_of_quotient_sp_of_three (k := m - 1)
        (by have := hm4 m q d (Or.inr hd); omega) ⟨q', hq', hd'⟩ hperf φ
    · obtain ⟨e6⟩ := hU4 d ⟨q, hq, hd⟩ ⟨e⟩
      obtain ⟨Y, hYP, hY, h3Y⟩ := exists_perfect_three_dvd_of_surjective_perm
        (by norm_num : 5 ≤ 6) e6.toMonoidHom e6.surjective
      exact hsolv Y hYP hY h3Y
  · exact h

theorem clauseO_nineThreeThree (hT : CitedBlockTransvectionPLType)
    {M S L : Subgroup G} (hK : Open.IsKGroup ↥M) (hA : Asc81bHyp M S) (hL : IsWeakSBlock M S L)
    (hX : ¬ InClassXBlock L) (hS : ¬ IsSylowTwoOf (S ⊓ L) L) (h3 : NineThreeThree M S L)
    (hsolv : BlockPLThreeSolv M S L) : ClauseO M L := by
  obtain ⟨n, hn, ⟨e⟩⟩ := exists_alt_of_nineThreeThree hT hK hA hL hX hS h3 hsolv
  obtain ⟨e'⟩ := quotCenterEquivAlt (by omega) e
  exact clauseO_of_cover hL.le hL.perfect (autThreePowInner_alt_of_five_le (by omega)) e'

theorem clauseO_of_nineThreeConclusion (hLF : LargeFieldParabolic) (hU : OutU33)
    (hGA : GriessAllModelsStatement) (hT : CitedBlockTransvectionPLType)
    {M S L : Subgroup G} (hK : Open.IsKGroup ↥M) (hA : Asc81bHyp M S) (hL : IsWeakSBlock M S L)
    (hX : ¬ InClassXBlock L) (hS : ¬ IsSylowTwoOf (S ⊓ L) L)
    (hconc : NineThreeConclusion M S L) (hsolv : BlockPLThreeSolv M S L)
    (hr : Open.pRank 3 L ≤ 3) : ClauseO M L := by
  rcases hconc with h1 | h2 | h3 | h4 | h5 | h6 | h7 | h8
  · exact absurd h1 hX
  · exact clauseO_nineThreeTwo hLF hU hGA hL h2
      (CFSG.HardMathSupport.Curtis.Coordinator.not_isSylowTwoOf_barM hA hL hS) hsolv hr
  · exact clauseO_nineThreeThree hT hK hA hL hX hS h3 hsolv
  · exact clauseO_nineThreeFour hL.le hL.perfect h4
  · exact clauseO_nineThreeFive h5
  · exact clauseO_nineThreeSix hL h6
  · exact clauseO_nineThreeSeven hL h7
  · exact (CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.not_nineThreeEight h8 hsolv).elim

end CFSG.LocalAnalysis.RankThreeTheoremC.BlockB.OuterThree
