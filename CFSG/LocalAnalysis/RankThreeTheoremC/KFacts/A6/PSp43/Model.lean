instance (σ : Equiv.Perm (Fin 45)) (t : Tab) : Decidable (Rep σ t) :=
  inferInstanceAs (Decidable (t.length = 45 ∧ ∀ i (hi : i < 45), (σ ⟨i, hi⟩ : ℕ) = t.getD i 0))

theorem rep_tauPerm_all : ∀ j (hj : j < 45), Rep (tauPerm ⟨j, hj⟩) (tauTab.getD j []) := by
  decide +kernel

theorem rep_tauPerm (j : Fin 45) : Rep (tauPerm j) (tauTab.getD j []) :=
  rep_tauPerm_all j.1 j.2

@[expose, irreducible] def wperm (w : List (Fin 45)) : Equiv.Perm (Fin 45) := (w.map tauPerm).prod

@[expose] def wtab (w : List (Fin 45)) : Tab :=
  w.foldr (fun i acc => tmul (tauTab.getD i []) acc) tid

theorem rep_wperm : ∀ w : List (Fin 45), Rep (wperm w) (wtab w)
  | [] => by simpa [wperm, wtab] using rep_one
  | i :: w => by
    have h := rep_mul (rep_tauPerm i) (rep_wperm w)
    simpa [wperm, wtab] using h

theorem wperm_append (v w : List (Fin 45)) : wperm (v ++ w) = wperm v * wperm w := by
  simp [wperm]

theorem psi_injective' : Function.Injective psi :=
  rho43_injective.comp psp43EquivU2.injective

theorem psi_s43' (i : Fin 45) : psi (s43 i) = tauPerm i :=
  Equiv.ext fun j => psi_s43 i j

abbrev P : Subgroup (Equiv.Perm (Fin 45)) := Subgroup.closure (Set.range tauPerm)

theorem tauPerm_mem (j : Fin 45) : tauPerm j ∈ P := Subgroup.subset_closure ⟨j, rfl⟩

theorem wperm_mem : ∀ w : List (Fin 45), wperm w ∈ P
  | [] => by simp [wperm]
  | i :: w => by
    have h := Subgroup.mul_mem _ (tauPerm_mem i) (wperm_mem w)
    simpa [wperm] using h

theorem range_psi_eq : psi.range = P := by
  rw [MonoidHom.range_eq_map, ← Y43_eq_top, MonoidHom.map_closure, ← Set.range_comp]
  congr 1
  ext g
  simp [psi_s43']

@[expose] noncomputable def psiEquiv : PSp43 ≃* P :=
  (MonoidHom.ofInjective psi_injective').trans (MulEquiv.subgroupCongr range_psi_eq)

theorem card_PSp43_eq : Nat.card PSp43 = 25920 := by
  have h1 : Nat.card Y43 = Nat.card sigma43.range :=
    Nat.card_eq_of_bijective _ sigma43_rangeRestrict_bijective
  rw [card_range_sigma43, Y43_eq_top, Subgroup.card_top] at h1
  exact h1

theorem card_P : Nat.card P = 25920 := by
  rw [← Nat.card_congr psiEquiv.toEquiv, card_PSp43_eq]

theorem tauPerm_injective : Function.Injective tauPerm := by
  intro i j h
  rw [← psi_s43', ← psi_s43'] at h
  exact s43_injective (psi_injective' h)

theorem conj_tauPerm {g : Equiv.Perm (Fin 45)} (hg : g ∈ P) (j : Fin 45) :
    g * tauPerm j * g⁻¹ = tauPerm (g j) := by
  rw [← range_psi_eq] at hg
  obtain ⟨h, rfl⟩ := hg
  have hY : h ∈ Y43 := Y43_eq_top ▸ Subgroup.mem_top h
  have hc := s43_s43Idx (conj_mem_range hY j).1
  rw [← psi_s43', ← map_inv, ← map_mul, ← map_mul, ← hc, psi_s43']
  congr 1
  exact Fin.ext (by rw [psi_apply])

theorem mem_centralizer_tauPerm_iff {g : Equiv.Perm (Fin 45)} (hg : g ∈ P) (j : Fin 45) :
    g ∈ Subgroup.centralizer ({tauPerm j} : Set (Equiv.Perm (Fin 45))) ↔ g j = j := by
  rw [Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro h
    apply tauPerm_injective
    rw [← conj_tauPerm hg j, h, mul_inv_cancel_right]
  · intro h
    have e := conj_tauPerm hg j
    rw [h] at e
    calc g * tauPerm j = g * tauPerm j * g⁻¹ * g := by group
      _ = tauPerm j * g := by rw [e]

@[expose] def transW : List (List (Fin 45)) :=
  [[], [2], [1], [6], [7], [8], [3], [4], [5], [12], [13], [14], [9], [10], [11], [12, 3], [21, 1],
   [19], [22], [17], [22, 1], [23], [18], [21], [17, 1], [13, 3], [31, 1], [29], [32], [27],
   [32, 1], [33], [28], [31], [27, 1], [14, 3], [41, 1], [39], [42], [37], [42, 1], [43], [38],
   [41], [37, 1]]

theorem transW_spec : ∀ j (hj : j < 45), (wtab (transW.getD j [])).getD 0 0 = j := by
  decide +kernel

theorem exists_mem_P_apply_zero (j : Fin 45) : ∃ g ∈ P, g 0 = j := by
  refine ⟨wperm (transW.getD j []), wperm_mem _, Fin.ext ?_⟩
  exact ((rep_wperm (transW.getD j [])).2 0 (by norm_num)).trans (transW_spec j.1 j.2)

theorem card_centralizer_tau_zero :
    Nat.card ↥(P ⊓ Subgroup.centralizer ({tauPerm 0} : Set (Equiv.Perm (Fin 45)))) = 576 := by
  have horb : MulAction.orbit P (0 : Fin 45) = Set.univ := by
    ext j
    simp only [Set.mem_univ, iff_true]
    obtain ⟨g, hg, hgj⟩ := exists_mem_P_apply_zero j
    exact ⟨⟨g, hg⟩, hgj⟩
  have hidx : (MulAction.stabilizer P (0 : Fin 45)).index = 45 := by
    rw [MulAction.index_stabilizer, horb, Set.ncard_univ, Nat.card_eq_fintype_card,
      Fintype.card_fin]
  have h := (MulAction.stabilizer P (0 : Fin 45)).card_mul_index
  rw [hidx, card_P] at h
  have hst : Nat.card (MulAction.stabilizer P (0 : Fin 45)) = 576 := by omega
  rw [← hst]
  symm
  refine Nat.card_congr
    { toFun := fun g => ⟨g.1.1, g.1.2, (mem_centralizer_tauPerm_iff g.1.2 0).2 g.2⟩
      invFun := fun g => ⟨⟨g.1, g.2.1⟩, (mem_centralizer_tauPerm_iff g.2.1 0).1 g.2.2⟩
      left_inv := fun g => rfl
      right_inv := fun g => rfl }

