private theorem not_isCyclic_of_forall_not_mem_normalizer {X : Type*} [Group X] [Finite X]
    {p : ℕ} [Fact p.Prime] {R : Subgroup X} {t : X} (htR : t ∈ normalizer (R : Set X))
    (ht : ∀ Y₀ : Subgroup X, Y₀ ≤ R → Nat.card Y₀ = p → t ∉ normalizer (Y₀ : Set X))
    (hR : p ∣ Nat.card R) : ¬ IsCyclic R := by
  intro hc
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' p hR
  have hY₀R : zpowers (g : X) ≤ R := (zpowers_le (H := R)).2 g.2
  have hY₀c : Nat.card (zpowers (g : X)) = p := by
    rw [Nat.card_zpowers, Subgroup.orderOf_coe, hg]
  refine ht _ hY₀R hY₀c (RankOneCent.mem_normalizer_of_forall_conj_mem fun y hy => ?_)
  set Y₁ := (zpowers (g : X)).map (MulAut.conj t).toMonoidHom
  have hY₁R : Y₁ ≤ R := by
    rintro _ ⟨y, hy, rfl⟩
    exact (mem_normalizer_iff.1 htR y).1 (hY₀R hy)
  have hcard : ∀ {Y : Subgroup X}, Y ≤ R → Nat.card (Y.subgroupOf R) = Nat.card Y := by
    intro Y hY
    rw [← card_subtype R (Y.subgroupOf R), subgroupOf_map_subtype, inf_eq_left.2 hY]
  have heq : (zpowers (g : X)).subgroupOf R = Y₁.subgroupOf R :=
    IsCyclic.subgroup_eq_iff_card_eq.2 (by
      rw [hcard hY₀R, hcard hY₁R, Subgroup.card_map_of_injective (MulAut.conj t).injective])
  rw [subgroupOf_inj, inf_eq_left.2 hY₀R, inf_eq_left.2 hY₁R] at heq
  rw [heq]
  exact ⟨y, hy, rfl⟩

private theorem isElemAbelian_of_not_isCyclic {X : Type*} [Group X] [Finite X] {p : ℕ}
    [Fact p.Prime] (hp2 : p ≠ 2) {R : Subgroup X} (hR : Nat.card R = p ^ 2)
    (hnc : ¬ IsCyclic R) : IsElemAbelian p R := by
  obtain ⟨D, hDR, hD, hDc⟩ :=
    GL83.I243.Inner.exists_isElemAbelian_card_sq_of_not_isCyclic hp2 (IsPGroup.of_card hR) hnc
  rwa [eq_of_le_of_card_ge hDR (by rw [hR, hDc])] at hD

private theorem isElemAbelian_sylow_of_le {X : Type} [Group X] [Finite X] {p : ℕ}
    [Fact p.Prime] (T : Sylow p X) {E : Subgroup X} (hE : IsElemAbelian p E)
    {k : ℕ} (hEc : Nat.card E = p ^ k) (hT : Nat.card (T : Subgroup X) = p ^ k) :
    IsElemAbelian p (T : Subgroup X) := by
  obtain ⟨S, hES⟩ := (IsPGroup.of_card hEc).exists_le_sylow
  have hSc : Nat.card (S : Subgroup X) = p ^ k := by
    rw [Sylow.card_eq_multiplicity, ← Sylow.card_eq_multiplicity T, hT]
  have hES' : E = S := eq_of_le_of_card_ge hES (by rw [hSc, hEc])
  obtain ⟨c, hc⟩ := MulAction.exists_smul_eq X S T
  have hTc : (T : Subgroup X) = (S : Subgroup X).map (MulAut.conj c).toMonoidHom := by
    rw [← hc, Sylow.coe_subgroup_smul]
    rfl
  rw [hTc, ← hES']
  exact RankOneCent.isElemAbelian_map _ hE

private theorem isElemAbelian_of_torus {X : Type*} [Group X] [Finite X] {p : ℕ}
    [Fact p.Prime] (hp2 : p ≠ 2) {R : Subgroup X} (hR : Nat.card R = p ^ 2) {t : X}
    (htR : t ∈ normalizer (R : Set X)) {m : ℕ} (hm : 2 ≤ m)
    (ht : ∀ k : ℕ, 0 < k → k < m → ∀ Y₀ : Subgroup X, Y₀ ≤ R → Nat.card Y₀ = p →
      t ^ k ∉ normalizer (Y₀ : Set X)) : IsElemAbelian p R :=
  isElemAbelian_of_not_isCyclic hp2 hR (not_isCyclic_of_forall_not_mem_normalizer htR
    (fun Y₀ hY₀ hc => by simpa using ht 1 one_pos (by omega) Y₀ hY₀ hc)
    (by rw [hR]; exact dvd_pow_self p two_ne_zero))

private theorem card_alt_ten : Nat.card (alternatingGroup (Fin 10)) = 1814400 := by
  rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
  rfl

theorem kFactTenFourteenTwoA5GammaExcluded_holds :
    KFactTenFourteenTwoA5GammaExcluded := by
  intro p K _ _ T K₁ J hp hp2 hL hZ hC2 hL2 hS3 hrank hΓ hK₁ hJs hJp hJ1 hJirr
  haveI : Fact p.Prime := ⟨hp⟩
  exfalso
  obtain ⟨i, hi, hi10, hRee, hMcL, hU, hJ4, ⟨e⟩⟩ := hL
  have hS3' : ∀ n : ℕ, Nat.card K = n → n ≠ 1814400 → RankOneCent.IsStepThreeIndex p i →
      IsElemAbelian p (T : Subgroup K) → Nat.card (T : Subgroup K) = p ^ 2 → False :=
    fun n hn hn10 hi3 hTe hTc => hS3 ⟨i, hi3, ⟨e⟩⟩
      ⟨fun f => hn10 (by rw [← hn, Nat.card_congr f.toEquiv, card_alt_ten])⟩ ⟨hTe, hTc⟩
  cases i with
  | cyclic _ _ => exact hi
  | alternating n hn =>
    rcases hi with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    ·
      obtain ⟨φ⟩ := CFSG.LocalAnalysis.EvenBN.Tits.I21L.a6aut_nonempty_equiv_psl
      let f : K ≃* PSL2GF 3 2 := e.trans φ
      have hes : Function.Surjective f.toMonoidHom := f.surjective
      have hP := psl2GF_sylow 3 2 (by norm_num) (T.mapSurjective hes)
      have hTc : Nat.card (T : Subgroup K) = 3 ^ 2 := by
        rw [← hP.2]
        exact (Subgroup.card_map_of_injective (f := f.toMonoidHom) f.injective).symm
      have hTe : IsElemAbelian 3 (T : Subgroup K) := by
        have h := RankOneCent.isElemAbelian_map f.symm.toMonoidHom hP.1
        have hmap : ((T.mapSurjective hes : Sylow 3 _) : Subgroup _).map f.symm.toMonoidHom =
            (T : Subgroup K) := by
          ext x
          simp [Sylow.coe_mapSurjective, Subgroup.mem_map_equiv]
        rwa [hmap] at h
      refine hS3' 360 ?_ (by norm_num) (Or.inl ⟨rfl, rfl⟩) hTe hTc
      rw [Nat.card_congr e.toEquiv]
      show Nat.card (alternatingGroup (Fin 6)) = 360
      rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
      rfl
    · exact hi10 hn rfl
  | lie d =>
    rcases hi with ⟨q, hqp, hq2, hd⟩ | ⟨q, hqp, hd⟩ | ⟨rfl, ⟨m, hd⟩ | ⟨q, hq2, hq3, hd⟩ |
        ⟨q, hq2, hq3, hd⟩⟩ | ⟨rfl, hd | hd⟩
    ·
      obtain ⟨φ⟩ := nonempty_mulEquiv_psl2GF_of_isLinTwoIndex (p := p) (n := q.exponent)
        ⟨q, hd, hqp, rfl⟩
      exact (hL2 q.exponent hq2).false (e.trans φ)
    · exact hU d rfl ⟨q, hqp, hd⟩
    · exact hRee d m rfl hd
    ·
      exact hC2 ⟨d, Or.inl ⟨rfl, q, hq2, hq3, hd⟩, ⟨e⟩⟩
    ·
      have hL34 : IsLinThreeFour (⊤ : Subgroup K) := ⟨d, ⟨q, hq2, hq3, hd⟩, ⟨topEquiv.trans e⟩⟩
      have hr := CFSG.LocalAnalysis.RankThreeTheoremC.kFactL34ThreeRankTwo K ⊤ hL34
      obtain ⟨E, -, hE, hEc⟩ := CFSG.SectionRank.exists_isElemAbelian_card_of_le_pRank hr
      have hcard : Nat.card K = 20160 := by
        rw [← CFSG.AGLEmbedding.card_of_isLinThreeFour hL34, Nat.card_congr topEquiv.toEquiv]
      have hTc : Nat.card (T : Subgroup K) = 3 ^ 2 := by
        rw [Sylow.card_eq_multiplicity, hcard,
          CFSG.AGLEmbeddingD2.factorization_eq_of_pow_dvd Nat.prime_three (k := 2) (by norm_num)
            (by norm_num) (by norm_num)]
      exact hS3' 20160 hcard (by norm_num)
        (Or.inl ⟨rfl, Or.inr (Or.inr ⟨q, hq2, hq3, hd⟩)⟩)
        (isElemAbelian_sylow_of_le T hE hEc hTc) hTc
    ·
      exact hC2 ⟨d, Or.inr ⟨rfl, hd⟩, ⟨e⟩⟩
    ·
      have hKc : centralizer (((⊤ : Subgroup K) : Subgroup K) : Set K) = ⊥ := by
        rw [coe_top, centralizer_univ, hZ]
      obtain ⟨-, hTc, -, -, -, t, ht, m, -, -, hm, -, -, -, -, hline⟩ :=
        CFSG.AGLEmbeddingD2.d2TorusLocalAt_tits d hd K ⊤ inferInstance hKc
          ⟨topEquiv.trans e⟩ 5 rfl T
      have hcard : Nat.card K = 17971200 :=
        CFSG.AGLEmbedding.KFactProofs.SmallIdent.card_of_isTitsGroup ⟨d, hd, ⟨e⟩⟩
      exact hS3' 17971200 hcard (by norm_num) (Or.inr ⟨rfl, Or.inr (Or.inr (Or.inr hd))⟩)
        (isElemAbelian_of_torus (by norm_num) hTc ht hm hline) hTc
  | sporadic s =>
    rcases hi with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    ·
      obtain ⟨eC⟩ := CFSG.Sporadic.Bridge.M11.nonempty_mulEquiv
      let e' : K ≃* CFSG.Blueprint.NativeSporadic.M11 := e.trans eC.symm
      obtain ⟨R₀, hR₀⟩ := CFSG.AGLEmbeddingD2.m11_three_localData
      have hT := CFSG.AGLEmbeddingD2.torusLocal_of_localData hR₀ (by norm_num)
        CFSG.AGLEmbeddingD2.orderOf_two_zmod_three (by norm_num)
      have h := CFSG.AGLEmbeddingD2.torusLocal_sylow e' hT (by
        rw [hT.1, CFSG.Sporadic.Mathieu.card_M11,
          CFSG.AGLEmbeddingD2.factorization_eq_of_pow_dvd Nat.prime_three (k := 2)
            (by norm_num) (by norm_num) (by norm_num)]) T
      obtain ⟨hTc, -, -, -, t, ht, m, -, -, hm, -, -, -, -, hline⟩ := h
      have hcard : Nat.card K = 7920 := by
        rw [Nat.card_congr e'.toEquiv, CFSG.Sporadic.Mathieu.card_M11]
      exact hS3' 7920 hcard (by norm_num) (Or.inl ⟨rfl, rfl⟩)
        (isElemAbelian_of_torus (by norm_num) hTc ht hm hline) hTc
    · exact hMcL rfl
    · exact hJ4 rfl

