variable {Y : Type} [Group Y] [Finite Y]

theorem le_of_three_dvd_card_centralizer {K Y₀ E : Subgroup Y} [K.Normal] (R : Sylow 3 Y)
    (hZ : center K = ⊥) (hΓ : ∀ T : Sylow 3 K, GLBCore 3 2 (T : Subgroup K) = ⊤)
    (hER : E ≤ R) (hE : IsElemAbelian 3 E) (hEc : Nat.card E = 3 ^ 2)
    (hcore : (if 3 ≤ CFSG.pRank 3 (R : Subgroup Y) then GLBWeakCore 3 (R : Subgroup Y)
      else GLBCore 3 1 E) ≤ Y₀)
    (h3 : 3 ∣ Nat.card (centralizer (K : Set Y))) : K ≤ Y₀ := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set C := centralizer (K : Set Y) with hCdef
  haveI : C.Normal := by rw [hCdef]; infer_instance
  have hKC : K ⊓ C = ⊥ :=
    CFSG.QuasithinUnique.RankOneRecog.inf_centralizer_eq_bot_of_center_eq_bot hZ
  have hRC : (R : Subgroup Y) ⊓ C ≠ ⊥ := by
    obtain ⟨P, hP⟩ := CFSG.QuasithinUnique.exists_sylow_map_eq_inf_of_normal R C
    rw [← hP]
    intro h
    have hP1 : (P : Subgroup C) = ⊥ :=
      (Subgroup.map_eq_bot_iff_of_injective _ C.subtype_injective).mp h
    exact P.ne_bot_of_dvd_card h3 hP1
  obtain ⟨z, hzR, hzC, hz1, hz3, hzc⟩ : ∃ z ∈ (R : Subgroup Y), z ∈ C ∧ z ≠ 1 ∧ z ^ 3 = 1 ∧
      ∀ g ∈ (R : Subgroup Y), g * z = z * g := by
    haveI : Group.IsNilpotent (R : Subgroup Y) := R.isPGroup'.isNilpotent
    set H : Subgroup (R : Subgroup Y) := C.subgroupOf R with hH
    haveI : H.Normal := Subgroup.normal_subgroupOf
    have hH1 : H ≠ ⊥ := by
      intro h
      apply hRC
      rw [eq_bot_iff]
      rintro x ⟨hxR, hxC⟩
      have : (⟨x, hxR⟩ : (R : Subgroup Y)) ∈ H := hxC
      rw [h, Subgroup.mem_bot] at this
      simpa using congrArg Subtype.val this
    have hHZ := Group.IsNilpotent.inf_center_ne_bot_of_normal hH1
    have hp : IsPGroup 3 ↥(H ⊓ center (R : Subgroup Y)) :=
      R.isPGroup'.to_subgroup _
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' 3
      ((hp.card_eq_or_dvd).resolve_left fun h =>
        hHZ (Subgroup.eq_bot_of_card_eq _ h))
    have hxH : ((x : (R : Subgroup Y)) : Y) ∈ C := (mem_inf.mp x.2).1
    have hxZ := (mem_inf.mp x.2).2
    have hxo : orderOf (((x : (R : Subgroup Y)) : Y)) = 3 := by
      rw [orderOf_coe, orderOf_coe, hx]
    have hx3 : ((x : (R : Subgroup Y)) : Y) ^ 3 = 1 := by
      have := pow_orderOf_eq_one ((x : (R : Subgroup Y)) : Y)
      rwa [hxo] at this
    refine ⟨_, (x : (R : Subgroup Y)).2, hxH, fun h => ?_, hx3, ?_⟩
    · rw [h, orderOf_one] at hxo
      omega
    · intro g hg
      exact congrArg Subtype.val (mem_center_iff.mp hxZ ⟨g, hg⟩)
  have hzK : ∀ k ∈ K, k * z = z * k := fun k hk => mem_centralizer_iff.mp hzC k hk
  split_ifs at hcore with h3R
  ·
    obtain ⟨T, hT⟩ := CFSG.QuasithinUnique.exists_sylow_map_eq_inf_of_normal R K
    have hTR : ((T : Subgroup K)).map K.subtype ≤ R := by rw [hT]; exact inf_le_left
    have hstep : GLBCore 3 2 (T : Subgroup K) ≤ Y₀.comap K.subtype := by
      apply sSup_le
      rintro N ⟨Q, hQT, hQr, rfl⟩
      set QY : Subgroup Y := Q.map K.subtype with hQY
      set B : Subgroup Y := QY ⊔ zpowers z with hB
      have hQYR : QY ≤ R := (Subgroup.map_mono hQT).trans hTR
      have hBR : B ≤ R := sup_le hQYR (zpowers_le.mpr hzR)
      have hQYr : 2 ≤ CFSG.Open.pRank 3 QY := by
        rw [hQY, CFSG.PreuniquenessRankFour.Helpers.pRank_map_of_injective 3 Nat.prime_three
          K.subtype K.subtype_injective]
        exact hQr
      obtain ⟨F, hFQ, hF, hFc⟩ := CFSG.SectionRank.exists_pRank (by norm_num : 1 < 3) QY
      have hQYK : QY ≤ K := by
        rintro _ ⟨q, -, rfl⟩
        exact q.2
      have hFK : F ≤ K := hFQ.trans hQYK
      have hFz : ∀ a ∈ F, ∀ b ∈ zpowers z, a * b = b * a := by
        intro a ha b hb
        obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hb
        exact (Commute.zpow_right (show Commute a z from hzK a (hFK ha)) k).eq
      have hFZ := CFSG.GH74.Uniqueness.SU.SU1.IsElemAbelian.sup hF
        (CFSG.GH74.Uniqueness.SU.SU1.isElemAbelian_zpowers hz3)
        hFz
      have hzF : z ∉ F := fun h => hz1 (by
        have : z ∈ K ⊓ C := ⟨hFK h, hzC⟩
        rwa [hKC, Subgroup.mem_bot] at this)
      have hlt : F < F ⊔ zpowers z := by
        refine lt_of_le_of_ne le_sup_left fun h => hzF ?_
        rw [h]
        exact mem_sup_right (mem_zpowers z)
      obtain ⟨k, hk⟩ := CFSG.GH74.Uniqueness.SU.SU1.IsElemAbelian.exists_card Nat.prime_three hFZ
      have hcard := CFSG.GH74.Uniqueness.SU.SU1.card_lt_of_lt hlt
      rw [hFc, hk] at hcard
      have hk3 : 3 ≤ k := by
        have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 3)).mp hcard
        omega
      have hFZB : F ⊔ zpowers z ≤ B := sup_le_sup_right hFQ _
      have hBr3 : 3 ≤ CFSG.Open.pRank 3 B :=
        hk3.trans (CFSG.SectionRank.le_pRank (by norm_num : 1 < 3) hFZB hFZ hk)
      have hNB : normalizer (B : Set Y) ≤ GLBWeakCore 3 (R : Subgroup Y) :=
        CFSG.PreuniquenessRankFour.Helpers.normalizer_le_weakCore 3 hBR
          (le_trans (by norm_num) hBr3)
          (hBr3.trans (CFSG.PreuniquenessRankFour.Helpers.pRank_mono 3 Nat.prime_three
            le_sup_left))
      intro n hn
      rw [Subgroup.mem_comap]
      refine hcore (hNB ?_)
      have hnQY : (n : Y) ∈ normalizer (QY : Set Y) :=
        Subgroup.le_normalizer_map K.subtype ⟨n, hn, rfl⟩
      have hnz : (n : Y) ∈ normalizer ((zpowers z : Subgroup Y) : Set Y) :=
        centralizer_le_normalizer _ (mem_centralizer_iff.mpr (by
          rintro _ ⟨i, rfl⟩
          exact (Commute.zpow_left (hzK n n.2).symm i).eq))
      change (n : Y) ∈ normalizer (B : Set Y)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hnQY hnz ⊢
      rw [hB, Subgroup.map_sup, hnQY, hnz]
    intro k hk
    have : (⟨k, hk⟩ : K) ∈ Y₀.comap K.subtype := hstep (by rw [hΓ T]; exact mem_top _)
    exact this
  ·
    have h2 : CFSG.Open.pRank 3 (R : Subgroup Y) ≤ 2 := by
      rw [CFSG.SectionRank.pRank_coe_eq_openPRank] at h3R
      omega
    have hzE : z ∈ E :=
      CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.P64Free.mem_of_central_of_pRank_le_two
        Nat.prime_three h2 hER hE hEc hzR hz3 hzc
    have hzo : orderOf z = 3 := orderOf_eq_prime hz3 hz1
    have hrank : 1 ≤ CFSG.Open.pRank 3 (zpowers z) :=
      CFSG.SectionRank.le_pRank (by norm_num : 1 < 3) le_rfl
        (CFSG.GH74.Uniqueness.SU.SU1.isElemAbelian_zpowers hz3)
        (by rw [Nat.card_zpowers, hzo, pow_one])
    have hN : normalizer ((zpowers z : Subgroup Y) : Set Y) ≤ GLBCore 3 1 E :=
      le_sSup ⟨zpowers z, zpowers_le.mpr hzE, hrank, rfl⟩
    intro k hk
    refine hcore (hN (centralizer_le_normalizer _ (mem_centralizer_iff.mpr ?_)))
    rintro _ ⟨i, rfl⟩
    exact (Commute.zpow_left (hzK k hk).symm i).eq

theorem coprime_three_card_centralizer {K Y₀ E : Subgroup Y} [K.Normal] (R : Sylow 3 Y)
    (hZ : center K = ⊥) (hΓ : ∀ T : Sylow 3 K, GLBCore 3 2 (T : Subgroup K) = ⊤)
    (hKc : IsComponentOf K ⊤) (hcomp : ∀ L : Subgroup Y, IsComponentOf L ⊤ → L ≤ K → ¬ L ≤ Y₀)
    (hER : E ≤ R) (hE : IsElemAbelian 3 E) (hEc : Nat.card E = 3 ^ 2)
    (hcore : (if 3 ≤ CFSG.pRank 3 (R : Subgroup Y) then GLBWeakCore 3 (R : Subgroup Y)
      else GLBCore 3 1 E) ≤ Y₀) :
    Nat.Coprime 3 (Nat.card (centralizer (K : Set Y))) :=
  (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr fun h3 =>
    hcomp K hKc le_rfl (le_of_three_dvd_card_centralizer R hZ hΓ hER hE hEc hcore h3)

