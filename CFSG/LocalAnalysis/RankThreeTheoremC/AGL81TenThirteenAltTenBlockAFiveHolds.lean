theorem kFactBlockAFive_two_of (h93 : Asc81bNineThree)
    (h85 : Asc81bEightFive) (hPLT : CitedBlockTransvectionPLType) (hSp : KFactSpTwoSimple)
    (h7 : CitedBlockAltSevenPL) (hOF : KFactCompParabOneFive) :
    ∀ (G : Type) [Group G] [Finite G] (X S L I₀ : Subgroup G),
      Open.IsKGroup ↥X → Asc81bHyp X S → IsWeakSBlock X S L → ¬ InClassXBlock L →
      I₀ ∈ cZero (Subgroup.normalizer (S : Set G) ⊓ L) → IsTwoPrimeComponent I₀ I₀ →
      (∃ f : ↥I₀ →* alternatingGroup (Fin 5), Function.Surjective f) →
      Open.pRank 3 X ≤ 3 → ∀ t ∈ X, t ∈ Subgroup.normalizer (S : Set G) →
        (∃ k : ℕ, t ^ 2 ^ k = 1) → L.map (MulAut.conj t).toMonoidHom ≠ L →
          t ^ 2 ∈ Subgroup.normalizer (I₀ : Set G) ∧
            ∃ j ∈ I₀, ∀ x ∈ I₀, t ^ 2 * x * (t ^ 2)⁻¹ * (j * x * j⁻¹)⁻¹ ∈ pCoreOf 2 I₀ := by
  intro G _ _ X S L I₀ hK hA hL hX hI₀ hI₀c ⟨f, hf⟩ h3 t htX htS ht2 htL
  rcases AltTen.nineThree_cases_of_alt5 h93 h85 hPLT hSp h7 hK hA hL hX hI₀ hI₀c f hf with
    h2 | halt
  · exact AltTen.kFactBlockAFive_two_nineThreeTwo hOF hA hL hI₀ hI₀c f hf h2 h3 htX htS ht2 htL
  · exact (AltTen.false_of_alt_two_blocks hL.toIsTwoPrimeComponent htX htL h3 halt).elim

theorem kFactBlockAFive_of (h93 : Asc81bNineThree)
    (h85 : Asc81bEightFive) (hPLT : CitedBlockTransvectionPLType) (hSp : KFactSpTwoSimple)
    (h7 : CitedBlockAltSevenPL) (hOF : KFactCompParabOneFive) : KFactBlockAFive :=
  fun G _ _ X S L I₀ hK hA hL hX hI₀ hI₀c hf =>
    ⟨kFactBlockAFive_one_of h93 h85 hPLT hSp h7 G X S L I₀ hK hA hL hX hI₀ hI₀c hf,
      kFactBlockAFive_two_of h93 h85 hPLT hSp h7 hOF G X S L I₀ hK hA hL hX hI₀ hI₀c hf⟩

theorem kFactBlockAFive_holds
    (h93 : Asc81bNineThree) (hGA : GriessAllModelsStatement) :
    KFactBlockAFive :=
  kFactBlockAFive_of h93 (asc81bEightFive_of_factorization aschbacherLocalFactorization_proved)
    CFSG.HardMathSupport.Curtis.UnitaryLevi.citedBlockTransvectionPLType_holds
    kFactSpTwoSimple_holds citedBlockAltSevenPL_holds (kFactCompParabOneFive_of_griess hGA)

