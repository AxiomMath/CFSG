theorem threeFourSolvThreeNoneAt_l28 (q : TauCeti.PrimePower) (d : TauCeti.ValidLieTypeIndex)
    (hq2 : q.p = 2) (hq3 : q.exponent = 3) (hd : d.1 = .A 1 q) :
    ThreeFourSolvThreeNoneAt (TauCeti.CFSGIndex.lie d).Group := by
  intro Y _ _ K Y₀ E R I₀ _ _ σ hKn hKX hZ _ _ _ _ hER hE hEc hcore hO2 _ hσY hσs hb _ _
  classical
  haveI := hKn
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨eK⟩ := hKX
  have hKc : IsCaseTwoGroup 3 ↥K := ⟨d, Or.inl ⟨rfl, q, hq2, hq3, hd⟩, ⟨eK⟩⟩
  obtain ⟨ε₀⟩ := nonempty_equiv_G8 hKc
  have hdata : ∀ T : Sylow 3 ↥K, L28Data ↥K (T : Subgroup ↥K) := fun T => l28Data_of_equiv ε₀ T
  have hcardA : Nat.card (MulAut ↥K) = 1512 := card_mulAut_of_isCaseTwoGroup_three hKc
  haveI : Finite (MulAut ↥K) := Nat.finite_of_card_ne_zero (by rw [hcardA]; norm_num)
  set θ : Y →* (MulAut ↥K) := MulAut.conjNormal with hθ
  set C := centralizer (K : Set Y) with hC
  set ι : ↥K →* (MulAut ↥K) := MulAut.conj with hι
  set Inn : Subgroup (MulAut ↥K) := ι.range with hInn
  have hθker : ∀ y : Y, θ y = 1 ↔ y ∈ C := by
    intro y
    refine ⟨fun h => mem_centralizer_iff.mpr fun m hm => ?_, fun h => ?_⟩
    · have := congrArg Subtype.val (DFunLike.congr_fun h ⟨m, hm⟩)
      simp only [hθ, MulAut.conjNormal_apply, MulAut.one_apply] at this
      exact (mul_inv_eq_iff_eq_mul.mp this).symm
    · refine MulEquiv.ext fun m => Subtype.ext ?_
      simp only [hθ, MulAut.conjNormal_apply, MulAut.one_apply]
      rw [(mem_centralizer_iff.mp h m m.2).symm, mul_inv_cancel_right]
  have hθι : ∀ k : ↥K, θ k = ι k := fun k => MulAut.conjNormal_val
  obtain ⟨T, hT⟩ := CFSG.QuasithinUnique.exists_sylow_map_eq_inf_of_normal R K
  have hdT := hdata T
  have hιinj : Function.Injective ι := hdT.conj_injective
  have hRY₀ : (R : Subgroup Y) ≤ Y₀ := (sylow_le_threeFourCore Nat.prime_three R hER hE hEc).trans
    hcore
  have hTY₀ : ∀ t ∈ (T : Subgroup ↥K), ι t ∈ Y₀.map θ := by
    intro t ht
    have h1 : (t : Y) ∈ (R : Subgroup Y) ⊓ K := by
      rw [← hT]
      exact Subgroup.mem_map_of_mem _ ht
    exact ⟨t, hRY₀ h1.1, hθι t⟩
  set J := (CFSG.ComponentClassification.AS76b.oUpperTwo (⊤ : Subgroup I₀)).map σ with hJ
  set D := σ.range with hD
  by_contra hJC
  have hθJ1 : J.map θ ≠ ⊥ := by
    intro h
    refine hJC fun x hx => (hθker x).mp ?_
    have : θ x ∈ J.map θ := Subgroup.mem_map_of_mem θ hx
    rwa [h, Subgroup.mem_bot] at this
  have hcube : ∀ x ∈ J, x ^ 3 ∈ C := cube_mem_of_pCoreOf_le σ hσs hO2 hb
  have hθJ3 : ∀ y ∈ J.map θ, y ^ 3 = 1 := by
    rintro _ ⟨x, hx, rfl⟩
    rw [← map_pow]
    exact (hθker _).mpr (hcube x hx)
  have hθJp : IsPGroup 3 (J.map θ) := fun y => ⟨1, Subtype.ext (by simpa using hθJ3 y y.2)⟩
  set W := pCoreOf 3 (Y₀.map θ) with hW
  have hJsub : IsSubnormal (J.map θ) (Y₀.map θ) := (isSubnormal_oUpperTwo_map σ hσs).map θ
  have hJW : J.map θ ≤ W := CFSG.AGLEmbedding.SubnormalCommute.le_pCoreOf_of_isSubnormal hJsub hθJp
  have hWnorm : Y₀.map θ ≤ normalizer (W : Set (MulAut ↥K)) :=
    CFSG.RankThreeCoreUniqueness.Helpers.localGroup_le_normalizer_pCoreOf 3 _
  have hDcl : D.map θ = Subgroup.closure ((θ.comp σ) '' {x : I₀ | ∃ k : ℕ, x ^ 2 ^ k = 1}) := by
    rw [hD, MonoidHom.range_eq_map, ← closure_twoElements_eq_top hb, Subgroup.map_map,
      MonoidHom.map_closure]
  have hD2 : D.map θ ≤ Subgroup.closure {x | x ∈ D.map θ ∧ ∃ k : ℕ, x ^ 2 ^ k = 1} := by
    rw [hDcl]
    refine Subgroup.closure_mono ?_
    rintro _ ⟨i, ⟨k, hk⟩, rfl⟩
    refine ⟨?_, k, ?_⟩
    · rw [← hDcl]
      exact Subgroup.mem_map_of_mem θ (MonoidHom.mem_range.mpr ⟨i, rfl⟩)
    · rw [MonoidHom.comp_apply, ← map_pow, ← map_pow, hk, map_one, map_one]
  have hInnIdx : Inn.index = 3 := by
    have h1 : Nat.card Inn = 504 := by
      rw [hInn, ← Nat.card_congr (MonoidHom.ofInjective hιinj).toEquiv, hdT.card_group]
    have h2 := Inn.card_mul_index
    rw [h1, hcardA] at h2
    omega
  haveI : Inn.Normal := L28Data.normal_range_conj ↥K
  have hInn2 : ∀ x : (MulAut ↥K), (∃ k : ℕ, x ^ 2 ^ k = 1) → x ∈ Inn := by
    rintro x ⟨k, hk⟩
    rw [← QuotientGroup.eq_one_iff]
    have h3 : orderOf (x : (MulAut ↥K) ⧸ Inn) ∣ 3 := by
      rw [← hInnIdx, Subgroup.index]
      exact orderOf_dvd_natCard _
    have h2 : orderOf (x : (MulAut ↥K) ⧸ Inn) ∣ 2 ^ k :=
      orderOf_dvd_of_pow_eq_one (by rw [← QuotientGroup.mk_pow, hk, QuotientGroup.mk_one])
    have hcop : Nat.Coprime 3 (2 ^ k) := Nat.Coprime.pow_right _ (by norm_num)
    exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hcop h3 h2)
  have hDInn : D.map θ ≤ Inn :=
    hD2.trans ((Subgroup.closure_le _).mpr fun x hx => hInn2 x hx.2)
  have hJD : J ≤ D := Subgroup.map_le_range σ _
  set W₀ : Subgroup ↥K := W.comap ι with hW₀
  have hW₀p : IsPGroup 3 W₀ :=
    (CFSG.RankThreeCoreUniqueness.Helpers.pCoreOf_isPGroup 3 _).comap_of_injective ι hιinj
  have hTW₀ : (T : Subgroup ↥K) ≤ normalizer (W₀ : Set ↥K) := by
    intro t ht
    rw [mem_normalizer_iff]
    intro w
    have hn := mem_normalizer_iff.mp (hWnorm (hTY₀ t ht)) (ι w)
    simp only [hW₀, Subgroup.mem_comap, map_mul, map_inv]
    exact hn
  have hW₀T : W₀ ≤ (T : Subgroup ↥K) := by
    have hp : IsPGroup 3 (W₀ ⊔ (T : Subgroup ↥K) : Subgroup ↥K) :=
      hW₀p.to_sup_of_normal_left' T.isPGroup' hTW₀
    exact le_sup_left.trans (T.is_maximal' hp le_sup_right).le
  obtain ⟨w, hwJ, hw1⟩ : ∃ w ∈ J.map θ, w ≠ 1 := by
    by_contra h
    push Not at h
    exact hθJ1 (eq_bot_iff.mpr fun w hw => (Subgroup.mem_bot).mpr (h w hw))
  obtain ⟨k, hk⟩ := hDInn (Subgroup.map_mono hJD hwJ)
  have hkW₀ : k ∈ W₀ := by
    show ι k ∈ W
    rw [hk]
    exact hJW hwJ
  have hk1 : k ≠ 1 := by
    rintro rfl
    exact hw1 (by rw [← hk, map_one])
  have hkT : k ∈ (T : Subgroup ↥K) := hW₀T hkW₀
  have hYT : ∀ y ∈ Y₀.map θ, ∀ t ∈ (T : Subgroup ↥K), y t ∈ (T : Subgroup ↥K) := by
    intro y hy t ht
    have hyk : y k ∈ W₀ := by
      show ι (y k) ∈ W
      rw [← mul_conj_mul_inv]
      exact (mem_normalizer_iff.mp (hWnorm hy) (ι k)).mp hkW₀
    have hykT : y k ∈ (T : Subgroup ↥K) := hW₀T hyk
    have hyk1 : y k ≠ 1 := fun h => hk1 (by simpa using congrArg y.symm h)
    have hcomm : y t * y k = y k * y t := by
      rw [← map_mul, ← map_mul, hdT.commute t ht k hkT]
    exact hdT.centralizer_le _ hykT hyk1 _ hcomm
  set Tb : Subgroup (MulAut ↥K) := (T : Subgroup ↥K).map ι with hTb
  have hTbY₀ : Tb ≤ Y₀.map θ := by
    rintro _ ⟨t, ht, rfl⟩
    exact hTY₀ t ht
  have hTbnorm : Y₀.map θ ≤ normalizer (Tb : Set (MulAut ↥K)) := by
    intro y hy
    rw [mem_normalizer_iff]
    intro z
    constructor
    · rintro ⟨t, ht, rfl⟩
      refine ⟨y t, hYT y hy t ht, ?_⟩
      rw [mul_conj_mul_inv]
    · rintro ⟨t, ht, hzt⟩
      have hy' : y⁻¹ ∈ Y₀.map θ := Subgroup.inv_mem _ hy
      refine ⟨y⁻¹ t, hYT y⁻¹ hy' t ht, ?_⟩
      have h1 := mul_conj_mul_inv y⁻¹ t
      rw [hzt, inv_inv] at h1
      rw [← h1]
      group
  have hTbp : IsPGroup 3 Tb := T.isPGroup'.map ι
  have hTbW : Tb ≤ W := CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 3 hTbY₀ hTbnorm hTbp
  have hpow : ∀ z ∈ D.map θ, ∃ a : ℕ, z ^ 2 ^ a ∈ J.map θ := by
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    obtain ⟨a, ha⟩ := CFSG.AGLEmbedding.SUPair.exists_two_pow_mem (T := (⊤ : Subgroup I₀))
      (Subgroup.mem_top i)
    refine ⟨a, ?_⟩
    rw [← map_pow, ← map_pow]
    exact Subgroup.mem_map_of_mem θ (Subgroup.mem_map_of_mem σ ha)
  obtain ⟨x, hxD, hx2, hxC⟩ : ∃ x ∈ D.map θ, (∃ k : ℕ, x ^ 2 ^ k = 1) ∧
      x ∉ centralizer ((J.map θ : Subgroup (MulAut ↥K)) : Set (MulAut ↥K)) := by
    by_contra h
    push Not at h
    exact hθJ1 (eq_bot_of_twoElements_le_centralizer hD2 (Subgroup.map_mono hJD) hθJp hpow h)
  have hx1 : x ≠ 1 := by
    rintro rfl
    exact hxC (Subgroup.one_mem _)
  have hfix : ∀ z ∈ Tb, x * z * x⁻¹ = z → z = 1 := by
    rintro _ ⟨t, ht, rfl⟩ hxt
    by_contra ht1
    have ht1' : t ≠ 1 := by rintro rfl; exact ht1 (map_one ι)
    have hxt' : x t = t := by
      apply hιinj
      rw [← mul_conj_mul_inv]
      exact hxt
    obtain ⟨n, hn3, -⟩ := exists_pow_orderOf_three (hdT.pow_nine_eq_one ht) ht1'
    have hstab : x ∈ MulAction.stabilizer (MulAut ↥K) (t ^ n) := by
      rw [MulAction.mem_stabilizer_iff]
      show x (t ^ n) = t ^ n
      rw [map_pow, hxt']
    obtain ⟨m, hm⟩ := L28Data.isPGroup_stabilizer hdata hcardA hn3 ⟨x, hstab⟩
    have hm' : x ^ 3 ^ m = 1 := by simpa using congrArg Subtype.val hm
    obtain ⟨k, hk⟩ := hx2
    have hcop : Nat.Coprime (3 ^ m) (2 ^ k) := Nat.Coprime.pow _ _ (by norm_num)
    exact hx1 (orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hcop
      (orderOf_dvd_of_pow_eq_one hm') (orderOf_dvd_of_pow_eq_one hk)))
  have hTbD : Tb ≤ D.map θ :=
    le_of_isSubnormal_of_fixedPointFree (hσs.map θ) hTbY₀ hTbnorm hxD hfix
  have hTbJ : Tb ≤ J.map θ := by
    intro z hz
    obtain ⟨a, ha⟩ := hpow z (hTbD hz)
    obtain ⟨t, ht, rfl⟩ := hz
    have h9 : (ι t) ^ 9 = 1 := by rw [← map_pow, hdT.pow_nine_eq_one ht, map_one]
    have hcop : Nat.Coprime (2 ^ a) (orderOf (ι t)) :=
      Nat.Coprime.coprime_dvd_right (orderOf_dvd_of_pow_eq_one h9)
        (Nat.Coprime.pow_left _ (by norm_num))
    obtain ⟨c, hc⟩ := exists_pow_eq_self_of_coprime hcop
    rw [← hc]
    exact Subgroup.pow_mem _ ha c
  obtain ⟨t, ht, ht9⟩ := exists_orderOf_nine ε₀ T
  have h3 : ι (t ^ 3) = 1 := by
    rw [map_pow]
    exact hθJ3 _ (hTbJ ⟨t, ht, rfl⟩)
  have h3' : t ^ 3 = 1 := hιinj (by rw [h3, map_one])
  have := orderOf_dvd_of_pow_eq_one h3'
  rw [ht9] at this
  norm_num at this

end CFSG.LocalAnalysis.RankThreeTheoremC.TenThirteen
