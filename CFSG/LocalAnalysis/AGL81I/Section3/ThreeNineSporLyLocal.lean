theorem exists_inverted_thirtyOne_Ly
    {L : Type} [Group L] [Finite L]
    (e : L ≃* Carrier .Ly) :
    ∃ a t : L, orderOf a = 31 ∧ t ^ 2 = 1 ∧ t * a * t⁻¹ = a⁻¹ := by
  let eJ : L ≃* J := e.trans lyEquivJ
  let cJ : J := ly31CJ
  let aL : L := eJ.symm (a * (cJ * a * cJ⁻¹))
  let tL : L := eJ.symm a
  have ha2 : a * a = 1 := by simpa only [a_inv'] using mul_inv_cancel a
  have ht2 : tL ^ 2 = 1 := by
    rw [show tL = eJ.symm a from rfl, ← map_pow, pow_two, ha2, map_one]
  have hinv : tL * aL * tL⁻¹ = aL⁻¹ := by
    have hJ : a * (a * (cJ * a * cJ⁻¹)) * a⁻¹ = (a * (cJ * a * cJ⁻¹))⁻¹ := by
      rw [a_inv']
      rw [show (a * (cJ * a * cJ⁻¹))⁻¹ = cJ * a * cJ⁻¹ * a by
        simp only [mul_inv_rev, inv_inv, a_inv']
        group]
      calc a * (a * (cJ * a * cJ⁻¹)) * a = (a * a) * (cJ * a * cJ⁻¹) * a := by group
        _ = (cJ * a * cJ⁻¹) * a := by rw [ha2, one_mul]
    calc tL * aL * tL⁻¹ = eJ.symm (a * (a * (cJ * a * cJ⁻¹)) * a⁻¹) := by
          simp [tL, aL, map_mul, map_inv]
      _ = eJ.symm ((a * (cJ * a * cJ⁻¹))⁻¹) := by rw [hJ]
      _ = aL⁻¹ := by simp [aL, map_inv]
  refine ⟨aL, tL, ?_, ht2, hinv⟩
  rw [show aL = eJ.symm (a * (cJ * a * cJ⁻¹)) from rfl, MulEquiv.orderOf_eq,
    show cJ = ly31CJ from rfl, orderOf_ly31]

