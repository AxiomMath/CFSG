private theorem orderOf_ly31 :
    orderOf (a * (ly31CJ * a * ly31CJ⁻¹)) = 31 := by
  have : Fact (Nat.Prime 31) := ⟨by norm_num⟩
  have hpow : RepM (powM 5 111 (ly31P ()) 31) ((a * (ly31CJ * a * ly31CJ⁻¹)) ^ 31) := by
    have h := repM_ly31P
    unfold RepM at h ⊢
    rw [toMat_powM, h, mat_pow']
  rw [beq_iff_eq.1 ly31_parts.2.1] at hpow
  refine orderOf_eq_prime (hpow.unique repM_id) fun h1 => ?_
  apply toMat_ne_of_diffMod5 ly31_parts.2.2
  rw [show toMat 5 111 (ly31P ()) = mat _ from repM_ly31P, h1,
    show toMat 5 111 (idM 111) = mat 1 from repM_id]

private theorem centralizer_fiveQ_J :
    Subgroup.centralizer (fiveQ lyFiveXJ lyFiveVJ : Set J) = Subgroup.zpowers lyFiveXJ := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, h11, -, h13, -, -, h16, -, -, h19⟩ :=
    lyFiveMRelJ.local_structure lyFiveCertJ
  have hsubU : fiveU lyFiveAJ lyFiveBJ ≤ Subgroup.centralizer ({lyFiveXJ} : Set J) := by
    rw [h13]
    exact inf_le_left
  have hcardM : Nat.card (Subgroup.closure ({lyFiveAJ, lyFiveBJ} : Set J)) = 9000000 := by
    have := h11
    norm_num at this
    exact this
  have hcardU : Nat.card (fiveU lyFiveAJ lyFiveBJ) = 2250000 := by omega
  have hCxU : Subgroup.centralizer ({lyFiveXJ} : Set J) = fiveU lyFiveAJ lyFiveBJ :=
    (Subgroup.eq_of_le_of_card_ge hsubU (by rw [lyFive_card_x, hcardU])).symm
  refine le_antisymm ?_ ?_
  · intro g hg
    have hgx : g ∈ Subgroup.centralizer ({lyFiveXJ} : Set J) :=
      Subgroup.centralizer_le (by
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy
        exact FiveQRel.x_mem) hg
    rw [hCxU] at hgx
    have hmem : g ∈ Subgroup.centralizer (fiveQ lyFiveXJ lyFiveVJ : Set J) ⊓
        fiveU lyFiveAJ lyFiveBJ := ⟨hg, hgx⟩
    rwa [h19] at hmem
  · intro g hg
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    exact ((lyFiveQRelJ.x_comm hq).zpow_left k).eq.symm

private theorem card_centralizer_fiveQ_map
    {L : Type} [Group L] [Finite L] (eJ : L ≃* J) :
    Nat.card (Subgroup.centralizer (((fiveQ lyFiveXJ lyFiveVJ).map (eJ.symm : J →* L) :
      Subgroup L) : Set L)) = 5 := by
  let Q0 : Subgroup J := fiveQ lyFiveXJ lyFiveVJ
  let Q0L : Subgroup L := Q0.map (eJ.symm : J →* L)
  have hcardQ : Nat.card (Subgroup.centralizer (Q0 : Set J)) = 5 := by
    rw [show Q0 = fiveQ lyFiveXJ lyFiveVJ from rfl, centralizer_fiveQ_J,
      Nat.card_zpowers, lyFiveQRelJ.orderOf_x]
  have hcard : Nat.card (Subgroup.centralizer (Q0L : Set L)) =
      Nat.card (Subgroup.centralizer (Q0 : Set J)) := by
    refine Nat.card_congr (Equiv.subtypeEquiv eJ.toEquiv fun u => ?_)
    rw [Subgroup.mem_centralizer_iff, Subgroup.mem_centralizer_iff]
    constructor
    · intro h q hq
      have hq' : eJ.symm q ∈ Q0L := by
        rw [show Q0L = Q0.map (eJ.symm : J →* L) from rfl]
        exact Subgroup.mem_map.mpr ⟨q, hq, rfl⟩
      have := congrArg eJ (h (eJ.symm q) hq')
      simpa using this
    · intro h q hq
      have hqJ : eJ q ∈ Q0 := by
        have hq' : q ∈ Q0L := hq
        rw [show Q0L = Q0.map (eJ.symm : J →* L) from rfl] at hq'
        obtain ⟨q0, hq0, hqeq⟩ := Subgroup.mem_map.mp hq'
        have : eJ q = q0 := by
          rw [← hqeq]
          exact MulEquiv.apply_symm_apply eJ q0
        rwa [this]
      apply eJ.injective
      simpa using h (eJ q) hqJ
  rw [hcard, hcardQ]

private theorem centralizer_fiveQ_map
    {L : Type} [Group L] [Finite L] (eJ : L ≃* J) :
    Subgroup.centralizer (((fiveQ lyFiveXJ lyFiveVJ).map (eJ.symm : J →* L) :
      Subgroup L) : Set L) = Subgroup.zpowers (eJ.symm lyFiveXJ) := by
  let Q0 : Subgroup J := fiveQ lyFiveXJ lyFiveVJ
  let Q0L : Subgroup L := Q0.map (eJ.symm : J →* L)
  have hxord : orderOf (eJ.symm lyFiveXJ) = 5 := by
    rw [MulEquiv.orderOf_eq, lyFiveQRelJ.orderOf_x]
  have hle : Subgroup.zpowers (eJ.symm lyFiveXJ) ≤
      Subgroup.centralizer (Q0L : Set L) := by
    intro z hz
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    have hq0 : eJ q ∈ Q0 := by
      have hq' : q ∈ Q0L := hq
      rw [show Q0L = Q0.map (eJ.symm : J →* L) from rfl] at hq'
      obtain ⟨q0, hq0, hqeq⟩ := Subgroup.mem_map.mp hq'
      have : eJ q = q0 := by
        rw [← hqeq]
        exact MulEquiv.apply_symm_apply eJ q0
      rwa [this]
    have hcomm : Commute (eJ.symm lyFiveXJ) q := by
      apply eJ.injective
      rw [map_mul, map_mul, MulEquiv.apply_symm_apply]
      exact (lyFiveQRelJ.x_comm hq0).eq
    exact (hcomm.zpow_left k).eq.symm
  exact (Subgroup.eq_of_le_of_card_ge hle (by
    rw [show Nat.card (Subgroup.centralizer (Q0L : Set L)) = 5 from
      card_centralizer_fiveQ_map eJ, Nat.card_zpowers, hxord])).symm

private theorem center_sylow_card_conj [Fact (Nat.Prime 5)] {L : Type} [Group L] [Finite L]
    (Q S : Sylow 5 L) (g : L)
    (hg : (Q : Subgroup L).map (MulAut.conj g).toMonoidHom = (S : Subgroup L)) :
    Nat.card (Subgroup.center ↥(Q : Subgroup L)) =
      Nat.card (Subgroup.center ↥(S : Subgroup L)) := by
  let eQ : ↥(Q : Subgroup L) ≃* ↥(S : Subgroup L) :=
    (MulEquiv.subgroupMap (MulAut.conj g) (Q : Subgroup L)).trans
      (MulEquiv.subgroupCongr hg)
  rw [← Subgroup.map_center_eq eQ, Subgroup.card_map_of_injective eQ.injective]

private theorem center_sylow_containing
    [Fact (Nat.Prime 5)]
    {L : Type} [Group L] [Finite L] (eJ : L ≃* J) (S : Sylow 5 L)
    (hQ0LS : ((fiveQ lyFiveXJ lyFiveVJ).map (eJ.symm : J →* L) :
      Subgroup L) ≤ (S : Subgroup L)) :
    Nat.card (Subgroup.center ↥(S : Subgroup L)) = 5 := by
  let Q0 : Subgroup J := fiveQ lyFiveXJ lyFiveVJ
  let Q0L : Subgroup L := Q0.map (eJ.symm : J →* L)
  let xL : L := eJ.symm lyFiveXJ
  have hxQ0L : xL ∈ Q0L := by
    rw [show Q0L = Q0.map (eJ.symm : J →* L) from rfl]
    exact Subgroup.mem_map.mpr ⟨lyFiveXJ, FiveQRel.x_mem, rfl⟩
  have hxS : xL ∈ (S : Subgroup L) := hQ0LS hxQ0L
  have hx1 : xL ≠ 1 := by
    intro h1
    have h2 : lyFiveXJ = 1 := eJ.symm.injective (by simpa [xL] using h1)
    have h3 := lyFiveQRelJ.orderOf_x
    rw [h2, orderOf_one] at h3
    omega
  have : Nontrivial ↥(S : Subgroup L) :=
    ⟨⟨xL, hxS⟩, ⟨1, (S : Subgroup L).one_mem⟩, fun h => hx1 (congrArg Subtype.val h)⟩
  have hcentne : Nontrivial (Subgroup.center ↥(S : Subgroup L)) :=
    S.isPGroup'.center_nontrivial
  have hgt : 1 < Nat.card (Subgroup.center ↥(S : Subgroup L)) :=
    Finite.one_lt_card_iff_nontrivial.mpr hcentne
  have hxord : orderOf xL = 5 := by
    rw [show xL = eJ.symm lyFiveXJ from rfl, MulEquiv.orderOf_eq, lyFiveQRelJ.orderOf_x]
  have hZleC : (Subgroup.center ↥(S : Subgroup L)).map (S : Subgroup L).subtype ≤
      Subgroup.centralizer (((fiveQ lyFiveXJ lyFiveVJ).map (eJ.symm : J →* L) :
        Subgroup L) : Set L) := by
    intro z hz
    obtain ⟨zS, hzS, rfl⟩ := Subgroup.mem_map.mp hz
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    have hqS : q ∈ (S : Subgroup L) := hQ0LS hq
    have hcomm := Subgroup.mem_center_iff.mp hzS ⟨q, hqS⟩
    simpa using congrArg Subtype.val hcomm
  rw [centralizer_fiveQ_map eJ] at hZleC
  have hdvd : Nat.card ((Subgroup.center ↥(S : Subgroup L)).map
      (S : Subgroup L).subtype) ∣ 5 := by
    have h := Subgroup.card_dvd_of_le hZleC
    rwa [Nat.card_zpowers, hxord] at h
  rw [Subgroup.card_map_of_injective (S : Subgroup L).subtype_injective] at hdvd
  rcases (Nat.dvd_prime (by norm_num : Nat.Prime 5)).1 hdvd with h | h
  · omega
  · exact h

private theorem center_sylow_card
    {L : Type} [Group L] [Finite L] (eJ : L ≃* J) (Q : Sylow 5 L) :
    Nat.card (Subgroup.center ↥(Q : Subgroup L)) = 5 := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  let Q0 : Subgroup J := fiveQ lyFiveXJ lyFiveVJ
  let Q0L : Subgroup L := Q0.map (eJ.symm : J →* L)
  have hQ0Lp : IsPGroup 5 Q0L := by
    refine IsPGroup.of_card (n := 5) ?_
    rw [show Nat.card Q0L = Nat.card Q0 from
      Subgroup.card_map_of_injective eJ.symm.injective, lyFiveQRelJ.card_fiveQ]
    norm_num
  obtain ⟨S, hQ0LS⟩ := hQ0Lp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq L Q S
  have hSmap : (Q : Subgroup L).map (MulAut.conj g).toMonoidHom = (S : Subgroup L) := by
    have h := congrArg (fun P : Sylow 5 L => (P : Subgroup L)) hg
    rwa [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at h
  rw [center_sylow_card_conj Q S g hSmap]
  exact center_sylow_containing eJ S (by simpa [Q0L] using hQ0LS)

