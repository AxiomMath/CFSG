      (powM 5 111 (ly31P ()) 31 == idM 111) = true ∧
        diffMod5 (ly31P ()) (idM 111) = true := by
  have h := Certificates.certificate1322151
  unfold ly31Check at h
  simp only [Bool.and_eq_true] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

