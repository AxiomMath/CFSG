    CFSG.GH74.Generic.S1.kl5_card_centralizer_ly ⟨e⟩ hy
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  obtain ⟨x', hx'⟩ := exists_prime_orderOf_dvd_card'
    (G := ↥(Subgroup.centralizer ({y} : Set L))) 7 (by rw [hCy]; norm_num)
  have hx'L : orderOf (x' : L) = 7 := (Subgroup.orderOf_coe x').trans hx'
  have hx'comm : (x' : L) * y = y * (x' : L) :=
    Subgroup.mem_centralizer_singleton_iff.mp x'.2
  have hsq : ¬ 7 ^ 2 ∣ Nat.card ↥(⊤ : Subgroup L) := by
    rw [Subgroup.card_top]; rw [hcardL]; norm_num
  obtain ⟨k, hk⟩ := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.isConj_pow_of_mem
    (K := ⊤) hsq (x := x) (f := (x' : L)) (by simp) (by simp) hx hx'L
  obtain ⟨h, hh⟩ := hk.symm
  let u : L := (h : L)
  have hhh : u * (x' : L) ^ k * u⁻¹ = x := by
    calc u * (x' : L) ^ k * u⁻¹ = (x * u) * u⁻¹ := by
          rw [show u * (x' : L) ^ k = x * u from hh.eq]
      _ = x := by group
  refine ⟨u * y * u⁻¹, ?_, ?_⟩
  · rw [show u * y * u⁻¹ = MulAut.conj u y by rw [MulAut.conj_apply],
      MulEquiv.orderOf_eq, hy]
  · have hcomm : (u * y * u⁻¹) * (u * (x' : L) * u⁻¹) =
        (u * (x' : L) * u⁻¹) * (u * y * u⁻¹) := by
      calc (u * y * u⁻¹) * (u * (x' : L) * u⁻¹) = u * (y * (x' : L)) * u⁻¹ := by group
        _ = u * ((x' : L) * y) * u⁻¹ := by rw [hx'comm]
        _ = (u * (x' : L) * u⁻¹) * (u * y * u⁻¹) := by group
    have hxpow : x = (u * (x' : L) * u⁻¹) ^ k := by
      rw [← hhh, conj_pow]
    rw [hxpow]
    exact (show Commute (u * y * u⁻¹) (u * (x' : L) * u⁻¹) from hcomm).pow_right k |>.eq

theorem mem_inner_of_chevalleyExceptionalModel_G2
    {J : Type} [Group J] [Finite J] {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (h : ChevalleyExceptionalModel J .G2 p 1) (α : MulAut J) : α ∈ inner J := by
  have hL : CFSG.Blueprint.LieModel J .G2 0 p 1 :=
    Or.inr (Or.inl ⟨rfl, by decide, h⟩)
  have hcard := CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8.card_outer_of_lieModel_G2_prime
    hp (by omega) (by omega) hL
  have : Subsingleton (CFSG.ComponentClassification.OuterAutomorphisms.Outer J) :=
    (Nat.card_eq_one_iff_unique.mp hcard).1
  exact (QuotientGroup.eq_one_iff (N := inner J) α).mp (Subsingleton.elim _ _)

end CFSG.LocalAnalysis.AGL81I.Section3.SporBig
