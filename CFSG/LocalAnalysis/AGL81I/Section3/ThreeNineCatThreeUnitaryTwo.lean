variable {F : Type} [Field F] {n : ℕ}

@[expose] noncomputable def tPair (ω : Fˣ) (a b : Fin n) : Fin n → Fˣ :=
  fun k => if k = a then ω else if k = b then ω⁻¹ else 1

theorem tPair_comp_perm (ω : Fˣ) (a b : Fin n) (σ : Equiv.Perm (Fin n)) :
    (fun k => tPair ω a b (σ⁻¹ k)) = tPair ω (σ a) (σ b) := by
  funext k
  simp only [tPair, Equiv.Perm.inv_eq_iff_eq]

theorem tPair_pow_three {ω : Fˣ} (hω : ω ^ 3 = 1) (a b : Fin n) (k : Fin n) :
    tPair ω a b k ^ 3 = 1 := by
  unfold tPair
  split_ifs <;> simp [hω, inv_pow]

theorem tPair_swap {ω : Fˣ} (hω : ω ^ 3 = 1) {a b : Fin n} (hab : a ≠ b) :
    tPair ω b a = tPair ω a b * tPair ω a b := by
  have h1 : ω * ω = ω⁻¹ := by
    rw [eq_inv_iff_mul_eq_one, ← hω, pow_three, mul_assoc]
  funext k
  simp only [tPair, Pi.mul_apply]
  by_cases hka : k = a
  · subst hka
    simp [hab, h1]
  · by_cases hkb : k = b
    · subst hkb
      simp only [hka, if_true, if_false]
      rw [← mul_inv, h1, inv_inv]
    · simp [hka, hkb]

theorem tPair_eq_mul {ω : Fˣ} {a b : Fin n} (hab : a ≠ b) :
    tPair ω a b = Pi.mulSingle a ω * Pi.mulSingle b ω⁻¹ := by
  funext k
  simp only [tPair, Pi.mul_apply, Pi.mulSingle_apply]
  by_cases hka : k = a
  · subst hka
    simp [hab]
  · by_cases hkb : k = b
    · subst hkb
      simp [hka]
    · simp [hka, hkb]

theorem prod_tPair {ω : Fˣ} {a b : Fin n} (hab : a ≠ b) : ∏ k, tPair ω a b k = 1 := by
  rw [tPair_eq_mul hab]
  simp only [Pi.mul_apply]
  rw [Finset.prod_mul_distrib, Finset.prod_pi_mulSingle', Finset.prod_pi_mulSingle']
  simp

theorem diagGL_tPair_mem {ω : Fˣ} (hω : ω ^ 3 = 1) {a b : Fin n} (hab : a ≠ b) :
    diagGL (tPair ω a b) ∈ StatedSU n 2 F := by
  refine Subgroup.subset_closure ⟨?_, ?_⟩
  · rw [diagGL_coe, Matrix.det_diagonal, ← Units.coe_prod, prod_tPair hab, Units.val_one]
  · rw [diagGL_coe, Matrix.diagonal_map (by simp), Matrix.diagonal_transpose,
      Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext k
    rw [← pow_succ, ← Units.val_pow_eq_pow_val, tPair_pow_three hω, Units.val_one]

theorem permMatrix_map_sq (σ : Equiv.Perm (Fin n)) :
    (σ.permMatrix F).map (· ^ 2) = σ.permMatrix F := by
  ext i j
  simp only [Matrix.map_apply, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply,
    Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq]
  split_ifs <;> simp

theorem permutationGL_mem [CharP F 2] (σ : Equiv.Perm (Fin n)) :
    permutationGL (k := F) σ ∈ StatedSU n 2 F := by
  refine Subgroup.subset_closure ⟨?_, ?_⟩
  · rw [permutationGL_coe, Matrix.det_permutation]
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ⁻¹) with h | h <;> rw [h] <;>
      simp [CharTwo.neg_eq]
  · rw [permutationGL_coe, permMatrix_map_sq, Matrix.transpose_permMatrix, inv_inv,
      ← Matrix.permMatrix_mul, inv_mul_cancel, Matrix.permMatrix_one]

@[expose] noncomputable def yE {ω : Fˣ} (hω : ω ^ 3 = 1) {a b : Fin n} (hab : a ≠ b) :
    StatedSU n 2 F :=
  ⟨diagGL (tPair ω a b), diagGL_tPair_mem hω hab⟩

@[expose] noncomputable def pE [CharP F 2] (σ : Equiv.Perm (Fin n)) : StatedSU n 2 F :=
  ⟨permutationGL σ, permutationGL_mem σ⟩

theorem pE_mul_yE [CharP F 2] {ω : Fˣ} (hω : ω ^ 3 = 1) {a b c d : Fin n} (hab : a ≠ b)
    (hcd : c ≠ d) (σ : Equiv.Perm (Fin n)) (ha : σ a = c) (hb : σ b = d) :
    pE σ * yE hω hab = yE hω hcd * pE σ := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, yE, pE]
  have h := permutationGL_mul_diagGL_mul_inv (k := F) σ (tPair ω a b)
  rw [tPair_comp_perm, ha, hb] at h
  exact mul_inv_eq_iff_eq_mul.mp h

theorem yE_swap {ω : Fˣ} (hω : ω ^ 3 = 1) {a b : Fin n} (hab : a ≠ b) :
    yE hω hab.symm = yE hω hab * yE hω hab := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, yE, ← map_mul]
  rw [tPair_swap hω hab]

theorem yE_cube {ω : Fˣ} (hω : ω ^ 3 = 1) {a b : Fin n} (hab : a ≠ b) :
    yE hω hab * yE hω hab * yE hω hab = 1 := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, Subgroup.coe_one, yE, ← map_mul]
  convert map_one (diagGL (k := F) (ι := Fin n)) using 2
  funext k
  simp only [Pi.mul_apply, Pi.one_apply]
  rw [← pow_three', tPair_pow_three hω]

theorem yE_comm {ω : Fˣ} (hω : ω ^ 3 = 1) {a b c d : Fin n} (hab : a ≠ b) (hcd : c ≠ d) :
    yE hω hab * yE hω hcd = yE hω hcd * yE hω hab := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, yE, ← map_mul, mul_comm (tPair ω a b)]

@[expose] def aI (hn : 6 ≤ n) (i : Fin 3) : Fin n := ⟨2 * i.val, by omega⟩

@[expose] def bI (hn : 6 ≤ n) (i : Fin 3) : Fin n := ⟨2 * i.val + 1, by omega⟩

theorem aI_ne_bI (hn : 6 ≤ n) (i j : Fin 3) : aI hn i ≠ bI hn j := by
  simp only [aI, bI, ne_eq, Fin.mk.injEq]
  omega

theorem eq_zero_of_pow_eq_inv_pow {ω : Fˣ} (hω3 : orderOf ω = 3) {k : ℕ} (hk : k < 3)
    (h : ω ^ k = ω⁻¹ ^ k) : k = 0 := by
  have h2 : ω ^ (k + k) = 1 := by
    rw [pow_add]
    nth_rewrite 2 [h]
    rw [inv_pow, mul_inv_cancel]
  have := orderOf_dvd_of_pow_eq_one h2
  rw [hω3] at this
  omega

theorem hasLiftableTriple_statedSU_two [CharP F 2] {ω : Fˣ} (hω : ω ^ 3 = 1) (hω1 : ω ≠ 1)
    (hn : 6 ≤ n) : HasLiftableTriple (StatedProj (StatedSU n 2 F)) := by
  classical
  have hω3 : orderOf ω = 3 := orderOf_eq_prime hω hω1
  let mk : StatedSU n 2 F →* StatedProj (StatedSU n 2 F) := QuotientGroup.mk' _
  let Y : Fin 3 → StatedSU n 2 F := fun i => yE hω (aI_ne_bI hn i i)
  refine HasLiftableTriple.of_relations (fun i => mk (Y i)) (fun i => ?_) (fun i j => ?_) ?_
    (fun i => mk (pE (Equiv.swap (aI hn i) (bI hn i)))) (fun i => ?_)
    (fun i j => mk (pE (Equiv.swap (aI hn i) (aI hn j) * Equiv.swap (bI hn i) (bI hn j))))
    (fun i j hij => ?_)
  · rw [← map_mul, ← map_mul, yE_cube hω, map_one]
  · rw [← map_mul, ← map_mul, yE_comm hω]
  · intro a b c h
    rw [← map_pow, ← map_pow, ← map_pow, ← map_mul, ← map_mul, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf, StatedScalars, MonoidHom.mem_range] at h
    obtain ⟨u, hu⟩ := h
    have hT : ∀ k : Fin n, ((tPair ω (aI hn 0) (bI hn 0) ^ a.val *
        tPair ω (aI hn 1) (bI hn 1) ^ b.val * tPair ω (aI hn 2) (bI hn 2) ^ c.val) k : F) = u := by
      intro k
      have h1 := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F) k k) hu
      simp only [Subgroup.coe_mul, Subgroup.coe_pow, Y, yE, ← map_pow, ← map_mul,
        Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, Matrix.diagonal_apply_eq,
        diagGL_apply, if_true] at h1
      exact h1.symm
    have key : ∀ i : Fin 3,
        ((tPair ω (aI hn 0) (bI hn 0) ^ a.val * tPair ω (aI hn 1) (bI hn 1) ^ b.val *
          tPair ω (aI hn 2) (bI hn 2) ^ c.val) (aI hn i) : F) =
        ((tPair ω (aI hn 0) (bI hn 0) ^ a.val * tPair ω (aI hn 1) (bI hn 1) ^ b.val *
          tPair ω (aI hn 2) (bI hn 2) ^ c.val) (bI hn i) : F) := fun i => by
      rw [hT, hT]
    have k0 := key 0
    have k1 := key 1
    have k2 := key 2
    simp only [Pi.mul_apply, Pi.pow_apply, tPair, aI, bI, Fin.mk.injEq] at k0 k1 k2
    norm_num at k0 k1 k2
    refine ⟨?_, ?_, ?_⟩
    · exact (ZMod.val_eq_zero a).mp
        (eq_zero_of_pow_eq_inv_pow hω3 (ZMod.val_lt a) (Units.ext (by simpa using k0)))
    · exact (ZMod.val_eq_zero b).mp
        (eq_zero_of_pow_eq_inv_pow hω3 (ZMod.val_lt b) (Units.ext (by simpa using k1)))
    · exact (ZMod.val_eq_zero c).mp
        (eq_zero_of_pow_eq_inv_pow hω3 (ZMod.val_lt c) (Units.ext (by simpa using k2)))
  · have h := pE_mul_yE hω (aI_ne_bI hn i i) (aI_ne_bI hn i i).symm
      (Equiv.swap (aI hn i) (bI hn i)) (Equiv.swap_apply_left _ _) (Equiv.swap_apply_right _ _)
    rw [yE_swap hω (aI_ne_bI hn i i)] at h
    rw [← map_mul, ← map_mul, ← map_mul]
    exact congrArg mk h
  · have hij' : i ≠ j := ne_of_lt hij
    have hσa : (Equiv.swap (aI hn i) (aI hn j) * Equiv.swap (bI hn i) (bI hn j)) (aI hn i) =
        aI hn j := by
      rw [Equiv.Perm.mul_apply, Equiv.swap_apply_of_ne_of_ne (aI_ne_bI hn i i) (aI_ne_bI hn i j),
        Equiv.swap_apply_left]
    have hσb : (Equiv.swap (aI hn i) (aI hn j) * Equiv.swap (bI hn i) (bI hn j)) (bI hn i) =
        bI hn j := by
      rw [Equiv.Perm.mul_apply, Equiv.swap_apply_left,
        Equiv.swap_apply_of_ne_of_ne (aI_ne_bI hn i j).symm (aI_ne_bI hn j j).symm]
    have hσa' : (Equiv.swap (aI hn i) (aI hn j) * Equiv.swap (bI hn i) (bI hn j)) (aI hn j) =
        aI hn i := by
      rw [Equiv.Perm.mul_apply, Equiv.swap_apply_of_ne_of_ne (aI_ne_bI hn j i) (aI_ne_bI hn j j),
        Equiv.swap_apply_right]
    have hσb' : (Equiv.swap (aI hn i) (aI hn j) * Equiv.swap (bI hn i) (bI hn j)) (bI hn j) =
        bI hn i := by
      rw [Equiv.Perm.mul_apply, Equiv.swap_apply_right,
        Equiv.swap_apply_of_ne_of_ne (aI_ne_bI hn i i).symm (aI_ne_bI hn j i).symm]
    refine ⟨?_, ?_⟩
    · rw [← map_mul, ← map_mul]
      exact congrArg mk (pE_mul_yE hω _ _ _ hσa hσb)
    · rw [← map_mul, ← map_mul]
      exact congrArg mk (pE_mul_yE hω _ _ _ hσa' hσb')

theorem exists_units_pow_three [Finite F] (hF : Nat.card F = 4) :
    ∃ ω : Fˣ, ω ^ 3 = 1 ∧ ω ≠ 1 := by
  classical
  have := Fintype.ofFinite F
  have hU : Fintype.card Fˣ = 3 := by
    rw [Fintype.card_units, ← Nat.card_eq_fintype_card, hF]
  have : Nontrivial Fˣ := Fintype.one_lt_card_iff_nontrivial.mp (by rw [hU]; norm_num)
  obtain ⟨ω, hω⟩ := exists_ne (1 : Fˣ)
  exact ⟨ω, hU ▸ pow_card_eq_one, hω⟩

theorem hasLiftableTriple_statedSU_of_eq_two [CharP F 2] {Q : ℕ} (hQ : Q = 2) {ω : Fˣ}
    (hω : ω ^ 3 = 1) (hω1 : ω ≠ 1) (hn : 6 ≤ n) :
    HasLiftableTriple (StatedProj (StatedSU n Q F)) := by
  subst hQ
  exact hasLiftableTriple_statedSU_two hω hω1 hn

theorem hasLiftableTriple_twistedA_two {r : ℕ} {q : PrimePower}
    (hv : (LieTypeIndex.twistedA r q).Valid) (hq2 : q.p = 2) (hq1 : q.exponent = 1)
    (hr : 5 ≤ r) : HasLiftableTriple (CFSGIndex.lie ⟨.twistedA r q, hv⟩).Group := by
  obtain ⟨-, F, _, _, hF, ⟨e⟩⟩ :=
    CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA r q hv (MulEquiv.refl _)
  have h2 : q.p ^ q.exponent = 2 := by rw [hq2, hq1]; norm_num
  rw [h2] at hF
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP F 2 := CFSG.SectionRank.ClassicalOdd.charP_of_card (f := 2) hF
  obtain ⟨ω, hω, hω1⟩ := exists_units_pow_three (F := F) (hF.trans (by norm_num))
  exact HasLiftableTriple.of_mulEquiv e.symm
    (hasLiftableTriple_statedSU_of_eq_two h2 hω hω1 (by omega))

end CFSG.LocalAnalysis.AGL81I.Section3.UnitaryTwo

namespace CFSG.LocalAnalysis.AGL81I.Section3

open CFSG.Open TauCeti
open CFSG.LocalAnalysis.AGL81TheoremCD.Section12 (gammaOver)

@[expose] def IsCrossCoverResidualE6Index : LieTypeIndex → Prop
  | .twistedE6 q => q.p = 2 ∧ (q.exponent = 1 ∨ q.exponent = 3)
  | _ => False

@[expose] def CrossCoverResidualE6Three : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (K E : Subgroup X) (d : ValidLieTypeIndex),
    K.Normal → CFSG.IsQuasisimple ↥K → 3 ∣ Nat.card (Subgroup.center ↥K) →
    Nonempty (↥K ⧸ Subgroup.center ↥K ≃* (CFSGIndex.lie d).Group) →
    IsCrossCoverResidualE6Index d.1 → IsElemAbelian 3 E → Nat.card E = 3 ^ 2 →
    CFSG.Open.pRank 3 (K ⊔ E) ≤ 3 → K ≤ gammaOver 1 3 E K

theorem crossCoverResidual24_12Three_of_e6 (h : CrossCoverResidualE6Three) :
    CrossCoverResidual24_12Three := by
  intro X _ _ K E d hKn hKq h3 ⟨e⟩ hres hE hEc hrk
  obtain ⟨d, hv⟩ := d
  cases d
  case twistedA r q =>
    exfalso
    obtain ⟨hq2, hq1, -, hr⟩ := hres
    have h4 := (UnitaryTwo.hasLiftableTriple_twistedA_two hv hq2 hq1 hr).four_le_pRank_of_cover e h3
    have hle : CFSG.Open.pRank 3 (⊤ : Subgroup ↥K) ≤ 3 := by
      rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup K]
      exact (CFSG.SectionRank.pRank_mono (by norm_num) le_sup_left).trans hrk
    omega
  case twistedE6 q => exact h X K E _ hKn hKq h3 ⟨e⟩ hres hE hEc hrk
  all_goals exact hres.elim

end CFSG.LocalAnalysis.AGL81I.Section3
