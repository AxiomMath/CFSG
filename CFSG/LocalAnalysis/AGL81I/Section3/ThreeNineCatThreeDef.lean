  | A r q =>
    have hq3 : q.p = 3 := by simpa using hpd.symm
    have hrk' : CFSG.Open.pRank q.p (⊤ : Subgroup K) ≤ 3 := by rw [hq3]; exact hrk
    have hm := CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv_typeA hv e
