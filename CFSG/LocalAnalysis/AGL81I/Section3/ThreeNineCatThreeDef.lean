    rcases hcases with ⟨ht, -⟩ | ⟨-, ⟨hn, hr⟩ | hr⟩ | ⟨ht, -⟩ | hr
    · cases ht
    · obtain rfl : r = 2 := by omega
      have h1 : q.exponent = 1 := by omega
      rw [h1, hq3] at hm
      exact Or.inr (Or.inr (Or.inr (Or.inl hm)))
    · omega
    · cases ht
    · omega
  | B r q =>
    have hq3 : q.p = 3 := by simpa using hpd.symm
    have hrk' : CFSG.Open.pRank q.p (⊤ : Subgroup K) ≤ 3 := by rw [hq3]; exact hrk
    have hr2 : 2 ≤ r := hrange.1
    rcases (show r = 2 ∨ 3 ≤ r by omega) with rfl | hr3
    · have hm := CFSG.QuasithinUnique.SQTK.statedClassicalModel_typeB2 q hv e
      obtain ⟨-, hf, hcases⟩ := CFSG.SectionRank.classical_model_rank (by rw [hq3]; norm_num) hm
      rcases hcases with ⟨ht, -⟩ | ⟨ht, -⟩ | ⟨-, ⟨hn, hr⟩ | hr⟩ | hr
      · cases ht
      · cases ht
      · have h1 : q.exponent = 1 := by omega
        rw [h1, hq3] at hm
        exact Or.inr (Or.inr (Or.inr (Or.inr hm)))
      · omega
      · omega
    · exfalso
      have hm := CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeB_odd r q hv
        (by rw [hq3]; norm_num) hr3 e
      obtain ⟨-, hf, hcases⟩ := CFSG.SectionRank.classical_model_rank (by rw [hq3]; norm_num) hm
      rcases hcases with ⟨ht, -⟩ | ⟨ht, -⟩ | ⟨ht, -⟩ | hr
      · cases ht
      · cases ht
      · cases ht
      · omega
  | C r q =>
    exfalso
    have hq3 : q.p = 3 := by simpa using hpd.symm
    have hrk' : CFSG.Open.pRank q.p (⊤ : Subgroup K) ≤ 3 := by rw [hq3]; exact hrk
    have hr3 : 3 ≤ r := hrange.1
    have hm := CFSG.QuasithinUnique.SQTK.statedClassicalModel_typeC r q hv e
    obtain ⟨-, hf, hcases⟩ := CFSG.SectionRank.classical_model_rank (by rw [hq3]; norm_num) hm
    rcases hcases with ⟨ht, -⟩ | ⟨ht, -⟩ | ⟨-, ⟨hn, hr⟩ | hr⟩ | hr
