    {K : Type} [Group K] [Finite K] (hKq : CFSG.IsQuasisimple K)
    (hOp : CFSG.pPrimeCore 3 K = ⊥) (hKcat : CFSG.SectionRank.IsKGroupCat K)
    (hrk : CFSG.Open.pRank 3 (⊤ : Subgroup K) ≤ 3) {d : ValidLieTypeIndex}
    (hpd : 3 = d.1.characteristic) (e : (K ⧸ Subgroup.center K) ≃* (CFSGIndex.lie d).Group) :
    KGroupLowRank24_12 3 K := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hZp : IsPGroup 3 (Subgroup.center K) :=
    CFSG.isPGroup_of_nilpotent_normal (Subgroup.center K) inferInstance inferInstance hOp
  refine ⟨Nat.prime_three, by norm_num, hKq, hKcat, ?_⟩
  by_cases hZ : Subgroup.center K = ⊥
  ·
    let eK : K ≃* (CFSGIndex.lie d).Group :=
      ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans e
    left
    rcases lieDefThree_rank_three_cases hexc hG2 hpd eK hrk with h | h | h | h | h
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h)))))))
  have hdvd : 3 ∣ Nat.card (Subgroup.center K) :=
    hZp.card_eq_or_dvd.resolve_left fun h => hZ (Subgroup.card_eq_one.mp h)
  have hKq' : CFSG.Open.IsQuasisimple K := ⟨Group.isPerfect_def.mp hKq.1, hKq.2.1⟩
  rcases hPC K hKq' 3 Nat.prime_three (by norm_num) hdvd (CFSGIndex.lie d) ⟨e⟩ with
    ⟨d', hd', hne', -, -⟩ | ⟨-, hcov | ⟨hsmall, -⟩⟩
  · exfalso
    obtain rfl := CFSGIndex.lie.inj hd'
    exact hne' hpd
  · rcases hcov with h | h | h | h | h | h | ⟨q, hv, hq, h⟩ | ⟨q, hv, hq, h⟩ | ⟨q, hv, hq, h⟩
    · cases h
    · cases h
    · cases h
    · cases h
    · cases h
    · cases h
    ·
      obtain rfl := CFSGIndex.lie.inj h
      obtain ⟨p, f, hpp, hfpos⟩ := q
      have hpf : p ^ f = 3 := by simpa [PrimePower.card_def] using hq
      obtain ⟨rfl, rfl⟩ := (Nat.Prime.pow_eq_iff Nat.prime_three).1 hpf
      have hm : StatedClassicalModel (K ⧸ Subgroup.center K) .PSU 4 3 1 :=
        CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 3 _ hv e
      have hU : Nonempty (K ⧸ Subgroup.center K ≃* CFSG.Assembly.RankThreeEven.projSU 4 3 1) :=
        ⟨e.trans (CFSG.RankThree.PartTwo.Census.typeTwistedAGroupEquivProjSU 3 _ hv)⟩
      have h9 := CFSG.RankThree.PartTwo.Sec4.Census.coverU43Center K hKq hZp hU
      obtain ⟨k, hk⟩ := hZp.exists_card_eq
      rw [hk] at hdvd h9
      rcases k with _ | _ | _ | k
      · norm_num at hdvd
      · refine Or.inr (Or.inr (Or.inl ⟨rfl, ?_⟩))
        iterate 14 right
        left
        exact ⟨K ⧸ Subgroup.center K, inferInstance, hm, by rw [hk]; norm_num, ⟨MulEquiv.refl _⟩⟩
      · exfalso
        have h4 := CFSG.RankThree.PartTwo.Sec4.Census.nineCoverU43RankFour K hKq
          (by rw [hk]; norm_num) hU
        have := CFSG.RankThreeEvenClassification.Helpers.twoLocalRank_le_pRank 3 Nat.prime_three K
        change CFSG.Assembly.RankThreeEven.localRank 3 K ≤ _ at this
        omega
      · exfalso
        have : 3 ^ 3 ∣ 9 := (pow_dvd_pow 3 (by omega)).trans h9
