    obtain ⟨-, hf, hcases⟩ := CFSG.SectionRank.classical_model_rank (by rw [hq3]; norm_num) hm
    rcases hcases with ⟨ht, -⟩ | ⟨ht, -⟩ | ⟨ht, -⟩ | hr
    · cases ht
    · cases ht
    · cases ht
    · omega
