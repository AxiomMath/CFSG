theorem card_center_eq_three_of_dvd {K : Type} [Group K] [Finite K]
    (hZp : IsPGroup 3 (Subgroup.center K)) (hdvd : 3 ∣ Nat.card (Subgroup.center K)) {m : ℕ}
    (hm : Nat.card (Subgroup.center K) ∣ 3 * m) (h3m : ¬ 3 ∣ m) :
    Nat.card (Subgroup.center K) = 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨k, hk⟩ := hZp.exists_card_eq
  rw [hk] at hdvd hm ⊢
  rcases k with _ | _ | k
  · norm_num at hdvd
  · rfl
  · exfalso
    have h9 : 3 ^ 2 ∣ 3 * m := (pow_dvd_pow 3 (by omega)).trans hm
    rw [pow_two] at h9
    exact h3m (Nat.dvd_of_mul_dvd_mul_left (by norm_num) h9)

