  | G2 q =>
    exfalso
    have hq3 : q.p = 3 := by simpa using hpd.symm
    rcases (show q.exponent = 1 ∨ 2 ≤ q.exponent by have := q.exponent_pos; omega) with h1 | h2
    · have := four_le_pRank_of_G2_three hG2 hv hq3 h1 e
