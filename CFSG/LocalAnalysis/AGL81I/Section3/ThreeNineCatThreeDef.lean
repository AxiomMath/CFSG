    · obtain rfl : r = 1 := by omega
      rcases (show q.exponent = 1 ∨ q.exponent = 2 ∨ q.exponent = 3 by omega) with h1 | h2 | h3
      · exfalso
        have h4 := hrange.2 rfl
        rw [PrimePower.card_def, hq3, h1] at h4
        norm_num at h4
      · rw [h2, hq3] at hm
        exact Or.inl hm
      · rw [h3, hq3] at hm
        exact Or.inr (Or.inl hm)
    · obtain rfl : r = 2 := by omega
      have h1 : q.exponent = 1 := by omega
      rw [h1, hq3] at hm
      have hcard : Nat.card (ZMod 3) = 3 ^ 1 := by rw [pow_one, Nat.card_zmod]
      obtain ⟨φ⟩ := CFSG.GH74.KGroups.PSLN.psl_equiv_of_stated (F := ZMod 3) 3 3 1 one_pos hcard hm
      exact Or.inr (Or.inr (Or.inl ⟨φ⟩))
    · omega
    · cases ht
    · cases ht
    · omega
  | twistedA r q =>
    have hq3 : q.p = 3 := by simpa using hpd.symm
    have hrk' : CFSG.Open.pRank q.p (⊤ : Subgroup K) ≤ 3 := by rw [hq3]; exact hrk
