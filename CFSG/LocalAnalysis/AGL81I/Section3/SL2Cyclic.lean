namespace CFSG.LocalAnalysis.AGL81I.Section3

open Matrix
open scoped MatrixGroups

section Tori

variable {F : Type} [Field F] [Finite F]

theorem isCyclic_nonsplitSL {ν : F} (hν : ¬ IsSquare ν) :
    IsCyclic (CFSG.PSL2Table.nonsplitSL ν) := by
  classical
  have : Fact (¬ IsSquare ν) := ⟨hν⟩
  let f : CFSG.PSL2Table.nonsplitSL ν →* QuadraticAlgebra F ν 0 :=
    { toFun := fun A =>
        ⟨(A.1 : Matrix (Fin 2) (Fin 2) F) 0 0, (A.1 : Matrix (Fin 2) (Fin 2) F) 1 0⟩
      map_one' := by
        ext <;> simp [QuadraticAlgebra.re_one, QuadraticAlgebra.im_one]
      map_mul' := by
        intro A B
        ext
        · simp only [Subgroup.coe_mul, CFSG.PSL2Table.mul_apply_SL, QuadraticAlgebra.re_mul,
            A.2.2, mul_zero, zero_mul, add_zero]
        · simp only [Subgroup.coe_mul, CFSG.PSL2Table.mul_apply_SL, QuadraticAlgebra.im_mul,
            A.2.1, B.2.1]
          ring }
  apply isCyclic_of_injective_ringHom f
  intro A B h
  have h0 := congrArg QuadraticAlgebra.re h
  have h1 := congrArg QuadraticAlgebra.im h
  change (A.1 : Matrix (Fin 2) (Fin 2) F) 0 0 = (B.1 : Matrix (Fin 2) (Fin 2) F) 0 0 at h0
  change (A.1 : Matrix (Fin 2) (Fin 2) F) 1 0 = (B.1 : Matrix (Fin 2) (Fin 2) F) 1 0 at h1
  apply Subtype.ext
  exact CFSG.PSL2Table.SL_ext h0 (by rw [A.2.2, B.2.2, h1]) h1 (by rw [A.2.1, B.2.1, h0])

end Tori

end CFSG.LocalAnalysis.AGL81I.Section3
