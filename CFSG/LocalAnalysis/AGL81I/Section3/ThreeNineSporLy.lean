  have hFle : Subgroup.zpowers (x : L) ≤ D := Subgroup.zpowers_le.mpr x.2
  have hFne : Subgroup.zpowers (x : L) ≠ ⊥ := by
    intro hbot
    have hxbot : (x : L) ∈ (⊥ : Subgroup L) := by
      rw [← hbot]
