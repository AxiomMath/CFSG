    exact hxne (Subgroup.mem_bot.mp hxbot)
  have hCx : Subgroup.centralizer ({(x : L)} : Set L) ≤ Y := by
    have h1 : Subgroup.centralizer (Subgroup.zpowers (x : L) : Set L) =
        Subgroup.centralizer ({(x : L)} : Set L) := by
