theorem e6Four_langSetup (K : Type) [Field K] [Finite K] (hK : Nat.card K = 4)
    (hperf : Group.IsPerfect ↥(adjointGroup Tag.E6 K)) :
    ∃ (L : Type) (_ : Field L) (_ : IsAlgClosed L) (S : LangSetup Tag.E6 L 5),
      S.D.q = 4 ∧ S.IsAlgebraic ∧
      (∀ γ, IsRoot Tag.E6 γ → S.ρ γ = (wordMat Tag.E6 e6TwoWord) *ᵥ γ) ∧
      (∃ S₀ : Sylow 5 S.Γ, (S₀ : Subgroup S.Γ) ≤ S.D.torus.subgroupOf S.Γ) ∧
      Nonempty (adjointGroup Tag.E6 K ≃* S.Γ) ∧
      (∃ Fr : L →+* L, (∀ c, Fr c = c ^ S.D.q) ∧ S.D.Φ = Units.map (entrywiseHom Fr)) := by
  have h5 : ¬ 5 ∣ Nat.card K := by rw [hK]; decide
  have he : orderOf ((Nat.card K : ℕ) : ZMod 5) = 2 := by
    rw [hK]
    exact orderOf_eq_prime_pow (p := 2) (n := 0) (by decide) (by decide)
  obtain ⟨L, i1, i2, S, hq, hAlg, hρ, hsyl, hequiv, hΦ⟩ :=
    E6FourPhi.exists_lang_untw_of_blocks_alg_rho_phi frobeniusOnRoots_proved 3 (Or.inl ⟨rfl, rfl⟩) K
      Nat.prime_five (by norm_num) h5 (IsWeylMatrix.of_word Tag.E6 e6TwoWord) [1, 1, 2, 2, 2, 2]
      e6Two_charpoly e6Two_pow he (by decide) (by decide) (by decide) hperf
  exact ⟨L, i1, i2, S, hq.trans hK, hAlg, hρ, hsyl, hequiv, hΦ⟩

theorem e6FourCent_setup {J : Type} [Group J] [Finite J] (hJ : E6FourMark J)
    (hZ : center J = ⊥) :
    ∃ (L : Type) (_ : Field L) (_ : IsAlgClosed L) (S : LangSetup Tag.E6 L 5)
      (ι : J →* ModGL Tag.E6 L),
      S.D.q = 4 ∧ (∀ γ, IsRoot Tag.E6 γ → S.ρ γ = (wordMat Tag.E6 e6TwoWord) *ᵥ γ) ∧
      Function.Injective ι ∧ ι.range = S.Γ ∧
      (∃ S₀ : Sylow 5 S.Γ, (S₀ : Subgroup S.Γ) ≤ S.D.torus.subgroupOf S.Γ) ∧
      (∃ Fr : L →+* L, (∀ c, Fr c = c ^ S.D.q) ∧ S.D.Φ = Units.map (entrywiseHom Fr)) := by
  obtain ⟨K, iF, iFin, iChar, hK, ⟨e⟩⟩ := e6FourMark_exists_adjointGroup hJ hZ
  have hK4 : Nat.card K = 4 := by rw [hK]; norm_num
  haveI : Group.IsPerfect J := Group.IsPerfect.mk hJ.1
  have hperf : Group.IsPerfect ↥(adjointGroup Tag.E6 K) :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  obtain ⟨L, iL, iAlg, S, hq, -, hρ, hsyl, ⟨f⟩, hΦ⟩ := e6Four_langSetup K hK4 hperf
  let g : J ≃* ↥S.Γ := e.symm.trans f
  refine ⟨L, iL, iAlg, S, S.Γ.subtype.comp g.toMonoidHom, hq, hρ, ?_, ?_, hsyl, hΦ⟩
  · intro a b hab
    exact g.injective (Subtype.ext hab)
  · rw [MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective g.toMonoidHom g.surjective,
      Subgroup.map_top, Subgroup.subtype_range]

