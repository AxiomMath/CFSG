module

public import Mathlib.LinearAlgebra.Matrix.Transvection
public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup

/-!
# Isaacs, Finite Group Theory — Ch. 8: `SL(n,q)` is generated by transvections (Thm 8.31)

Formalizes **Isaacs Thm 8.31** (p. 240): the special linear group over a
field is generated by the transvections `tᵢⱼ(α) = 1 + α Eᵢⱼ`
(`closure_transvections_eq_top`), stated for `SpecialLinearGroup n 𝕜` over
any finite index type and any field.

Proof: mathlib's Gaussian elimination
(`Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec`) writes any
matrix as `L * D * L'` with `L, L'` products of transvections and `D`
diagonal; a determinant-one matrix forces `∏ D = 1`, and such diagonal
matrices are products of transvections by the Whitehead-lemma identity
`diag(a, a⁻¹) w(1) = w(a)` with `w(a) = tᵢⱼ(a) tⱼᵢ(-a⁻¹) tᵢⱼ(a)`, peeling
off one non-unit diagonal entry at a time.
-/

public section

namespace CFSG

namespace FiveTransitive.OddOrder.Isaacs.Ch08

open Matrix

open scoped commutatorElement

variable {n : Type*} [DecidableEq n] [Fintype n] {𝕜 : Type*} [Field 𝕜]

/-- The transvections inside the special linear group. -/
@[expose] def transvections (n 𝕜 : Type*) [DecidableEq n] [Fintype n] [Field 𝕜] :
    Set (Matrix.SpecialLinearGroup n 𝕜) :=
  {t | ∃ (i j : n) (_ : i ≠ j) (c : 𝕜),
    (t : Matrix n n 𝕜) = Matrix.transvection i j c}

/-- A transvection, as an element of the special linear group. -/
private def transvectionSL (i j : n) (hij : i ≠ j) (c : 𝕜) :
    Matrix.SpecialLinearGroup n 𝕜 :=
  ⟨Matrix.transvection i j c, det_transvection_of_ne i j hij c⟩

private lemma transvectionSL_mem (i j : n) (hij : i ≠ j) (c : 𝕜) :
    transvectionSL i j hij c ∈ Subgroup.closure (transvections n 𝕜) :=
  Subgroup.subset_closure ⟨i, j, hij, c, rfl⟩

section Whitehead

variable {i j : n}

set_option linter.unusedSimpArgs false in
/-- Entries of the Weyl-like element `w(c) = tᵢⱼ(c) tⱼᵢ(-c⁻¹) tᵢⱼ(c)`. -/
private lemma w_apply (hij : i ≠ j) {c : 𝕜} (hc : c ≠ 0) (r s : n) :
    (transvection i j c * transvection j i (-c⁻¹) * transvection i j c) r s =
      if r = i then (if s = j then c else 0)
      else if r = j then (if s = i then -c⁻¹ else 0)
      else (if r = s then (1 : 𝕜) else 0) := by
  have hji : j ≠ i := hij.symm
  by_cases hri : r = i <;> by_cases hrj : r = j <;>
    by_cases hsi : s = i <;> by_cases hsj : s = j <;>
    simp_all [transvection, Matrix.mul_apply, Matrix.single_apply,
      Matrix.one_apply, Matrix.add_apply, mul_inv_cancel₀ hc,
      inv_mul_cancel₀ hc, Finset.sum_add_distrib, Finset.sum_ite_eq,
      Finset.sum_ite_eq', add_mul, mul_add, ite_and, mul_comm, eq_comm]

set_option linter.unusedSimpArgs false in
/-- The Whitehead-lemma identity: multiplying the diagonal matrix with `a`
at `i`, `a⁻¹` at `j` and `1` elsewhere by `w(1)` yields `w(a)`. -/
private lemma diagonal_pair_mul_w_one (hij : i ≠ j) {a : 𝕜} (ha : a ≠ 0) :
    diagonal (Function.update (Function.update (1 : n → 𝕜) i a) j a⁻¹) *
        (transvection i j 1 * transvection j i (-1⁻¹) * transvection i j 1) =
      transvection i j a * transvection j i (-a⁻¹) * transvection i j a := by
  have hji : j ≠ i := hij.symm
  ext r s
  rw [diagonal_mul, w_apply hij one_ne_zero, w_apply hij ha]
  by_cases hri : r = i <;> by_cases hrj : r = j <;>
    simp_all [Function.update_apply, inv_inv, mul_ite, ite_mul, eq_comm]

end Whitehead

/-- The special linear group element given by a diagonal matrix of
determinant one. -/
private def diagonalSL (D : n → 𝕜) (hD : ∏ k, D k = 1) :
    Matrix.SpecialLinearGroup n 𝕜 :=
  ⟨diagonal D, by rw [det_diagonal, hD]⟩

/-- **Isaacs Thm 8.31, diagonal step** — a diagonal matrix of determinant
one lies in the subgroup generated by the transvections. -/
private lemma diagonalSL_mem_closure (D : n → 𝕜) (hD : ∏ k, D k = 1) :
    diagonalSL D hD ∈ Subgroup.closure (transvections n 𝕜) := by
  classical
  suffices H : ∀ (N : ℕ) (D : n → 𝕜) (hD : ∏ k, D k = 1),
      (Finset.univ.filter fun k => D k ≠ 1).card ≤ N →
      diagonalSL D hD ∈ Subgroup.closure (transvections n 𝕜) by
    exact H _ D hD le_rfl
  intro N
  induction N with
  | zero =>
    intro D hD hcard
    have hall : ∀ k, D k = 1 := by
      intro k
      by_contra hk
      have hmem : k ∈ Finset.univ.filter fun k => D k ≠ 1 :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hk⟩
      rw [Finset.card_eq_zero.mp (Nat.le_zero.mp hcard)] at hmem
      exact absurd hmem (Finset.notMem_empty k)
    have h1 : diagonalSL D hD = 1 := by
      apply Subtype.ext
      change diagonal D = (1 : Matrix n n 𝕜)
      rw [show D = fun _ => (1 : 𝕜) from funext hall, diagonal_one]
    rw [h1]
    exact Subgroup.one_mem _
  | succ N ih =>
    intro D hD hcard
    by_cases hzero : ∀ k, D k = 1
    · have h1 : diagonalSL D hD = 1 := by
        apply Subtype.ext
        change diagonal D = (1 : Matrix n n 𝕜)
        rw [show D = fun _ => (1 : 𝕜) from funext hzero, diagonal_one]
      rw [h1]
      exact Subgroup.one_mem _
    · obtain ⟨i, hi⟩ := not_forall.mp hzero
      obtain ⟨j, hj, hij⟩ : ∃ j, D j ≠ 1 ∧ i ≠ j := by
        by_contra hc
        have hother : ∀ k, k ≠ i → D k = 1 := by
          intro k hk
          by_contra hk1
          exact hc ⟨k, hk1, Ne.symm hk⟩
        have hprod : ∏ k, D k = D i := by
          rw [← Finset.mul_prod_erase Finset.univ D (Finset.mem_univ i)]
          rw [Finset.prod_congr rfl fun k hk =>
            hother k (Finset.mem_erase.mp hk).1]
          simp
        rw [hD] at hprod
        exact hi hprod.symm
      have hDi0 : D i ≠ 0 := by
        intro h0
        rw [Finset.prod_eq_zero (Finset.mem_univ i) h0] at hD
        exact zero_ne_one hD
      -- split `D` into the `(i,j)`-pair and a remainder with fewer non-units
      set P : n → 𝕜 :=
        Function.update (Function.update (1 : n → 𝕜) i (D i)) j (D i)⁻¹
        with hPdef
      set D' : n → 𝕜 :=
        Function.update (Function.update D i 1) j (D i * D j) with hD'def
      have hiP : P i = D i := by
        rw [hPdef, Function.update_of_ne hij, Function.update_self]
      have hjP : P j = (D i)⁻¹ := by
        rw [hPdef, Function.update_self]
      have hkP : ∀ k, k ≠ i → k ≠ j → P k = 1 := by
        intro k hki hkj
        rw [hPdef, Function.update_of_ne hkj, Function.update_of_ne hki]
        rfl
      have hiD' : D' i = 1 := by
        rw [hD'def, Function.update_of_ne hij, Function.update_self]
      have hjD' : D' j = D i * D j := by
        rw [hD'def, Function.update_self]
      have hkD' : ∀ k, k ≠ i → k ≠ j → D' k = D k := by
        intro k hki hkj
        rw [hD'def, Function.update_of_ne hkj, Function.update_of_ne hki]
      have hD' : ∏ k, D' k = 1 := by
        have hstep : ∀ (E : n → 𝕜), ∏ k, E k =
            E j * (E i * ∏ k ∈ (Finset.univ.erase j).erase i, E k) := by
          intro E
          rw [← Finset.mul_prod_erase Finset.univ E (Finset.mem_univ j),
            ← Finset.mul_prod_erase _ E
              (Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩)]
        have htail : ∏ k ∈ (Finset.univ.erase j).erase i, D' k =
            ∏ k ∈ (Finset.univ.erase j).erase i, D k := by
          refine Finset.prod_congr rfl fun k hk => ?_
          obtain ⟨hki, hk2⟩ := Finset.mem_erase.mp hk
          exact hkD' k hki (Finset.mem_erase.mp hk2).1
        have hDval := hstep D
        rw [hD] at hDval
        rw [hstep D', htail, hjD', hiD', one_mul]
        calc D i * D j * ∏ k ∈ (Finset.univ.erase j).erase i, D k
            = D j * (D i * ∏ k ∈ (Finset.univ.erase j).erase i, D k) := by
              ring
          _ = 1 := hDval.symm
      -- the pair matrix is a product of transvections (Whitehead)
      have hPprod : ∏ k, P k = 1 := by
        have hstep : ∏ k, P k =
            P j * (P i * ∏ k ∈ (Finset.univ.erase j).erase i, P k) := by
          rw [← Finset.mul_prod_erase Finset.univ P (Finset.mem_univ j),
            ← Finset.mul_prod_erase _ P
              (Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩)]
        have htail : ∏ k ∈ (Finset.univ.erase j).erase i, P k = 1 := by
          refine Finset.prod_eq_one fun k hk => ?_
          obtain ⟨hki, hk2⟩ := Finset.mem_erase.mp hk
          exact hkP k hki (Finset.mem_erase.mp hk2).1
        rw [hstep, htail, hiP, hjP]
        field_simp
      have hpair : diagonalSL P hPprod ∈
          Subgroup.closure (transvections n 𝕜) := by
        have hw : diagonalSL P hPprod *
            (transvectionSL i j hij 1 * transvectionSL j i hij.symm (-1⁻¹) *
              transvectionSL i j hij 1) =
            transvectionSL i j hij (D i) *
              transvectionSL j i hij.symm (-(D i)⁻¹) *
              transvectionSL i j hij (D i) := by
          apply Subtype.ext
          simp only [Matrix.SpecialLinearGroup.coe_mul]
          exact diagonal_pair_mul_w_one hij hDi0
        have hmemw : transvectionSL i j hij (D i) *
            transvectionSL j i hij.symm (-(D i)⁻¹) *
            transvectionSL i j hij (D i) ∈
            Subgroup.closure (transvections n 𝕜) :=
          Subgroup.mul_mem _ (Subgroup.mul_mem _ (transvectionSL_mem _ _ _ _)
            (transvectionSL_mem _ _ _ _)) (transvectionSL_mem _ _ _ _)
        have hmem1 : transvectionSL i j hij 1 *
            transvectionSL j i hij.symm (-1⁻¹) * transvectionSL i j hij 1 ∈
            Subgroup.closure (transvections n 𝕜) :=
          Subgroup.mul_mem _ (Subgroup.mul_mem _ (transvectionSL_mem _ _ _ _)
            (transvectionSL_mem _ _ _ _)) (transvectionSL_mem _ _ _ _)
        have heq : diagonalSL P hPprod =
            (transvectionSL i j hij (D i) *
              transvectionSL j i hij.symm (-(D i)⁻¹) *
              transvectionSL i j hij (D i)) *
            (transvectionSL i j hij 1 * transvectionSL j i hij.symm (-1⁻¹) *
              transvectionSL i j hij 1)⁻¹ :=
          eq_mul_inv_of_mul_eq hw
        rw [heq]
        exact Subgroup.mul_mem _ hmemw (Subgroup.inv_mem _ hmem1)
      -- the remainder has strictly fewer non-unit entries
      have hcount' : (Finset.univ.filter fun k => D' k ≠ 1).card ≤ N := by
        have hsub : (Finset.univ.filter fun k => D' k ≠ 1) ⊆
            (Finset.univ.filter fun k => D k ≠ 1).erase i := by
          intro k hk
          obtain ⟨-, hk1⟩ := Finset.mem_filter.mp hk
          rcases eq_or_ne k i with rfl | hki
          · exact absurd hiD' hk1
          · refine Finset.mem_erase.mpr
              ⟨hki, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩⟩
            rcases eq_or_ne k j with rfl | hkj
            · exact hj
            · rwa [hkD' k hki hkj] at hk1
        have h2 : ((Finset.univ.filter fun k => D k ≠ 1).erase i).card ≤ N := by
          have h3 := Finset.card_erase_lt_of_mem
            (show i ∈ Finset.univ.filter (fun k => D k ≠ 1) by simp [hi])
          omega
        exact le_trans (Finset.card_le_card hsub) h2
      -- assemble
      have hfactor : diagonalSL D hD = diagonalSL P hPprod * diagonalSL D' hD' := by
        apply Subtype.ext
        simp only [Matrix.SpecialLinearGroup.coe_mul]
        change diagonal D = diagonal P * diagonal D'
        rw [diagonal_mul_diagonal]
        congr 1
        funext k
        rcases eq_or_ne k i with rfl | hki
        · rw [hiP, hiD', mul_one]
        · rcases eq_or_ne k j with rfl | hkj
          · rw [hjP, hjD', inv_mul_cancel_left₀ hDi0]
          · rw [hkP k hki hkj, hkD' k hki hkj, one_mul]
      rw [hfactor]
      exact Subgroup.mul_mem _ hpair (ih D' hD' hcount')

/-- The determinant of a product of transvections is `1`. -/
private lemma det_listTransvec_prod (L : List (TransvectionStruct n 𝕜)) :
    det (L.map TransvectionStruct.toMatrix).prod = 1 := by
  induction L with
  | nil => simp
  | cons t L ih => simp [det_mul, ih, t.det]

/-- A transvection structure, as a special linear group element. -/
private def tsSL (t : TransvectionStruct n 𝕜) : Matrix.SpecialLinearGroup n 𝕜 :=
  ⟨t.toMatrix, t.det⟩

set_option backward.isDefEq.respectTransparency false in
/-- The special-linear lift of a list of transvection structures. -/
private lemma coe_listTransvecSL_prod (L : List (TransvectionStruct n 𝕜)) :
    (((L.map tsSL).prod : Matrix.SpecialLinearGroup n 𝕜) : Matrix n n 𝕜) =
      (L.map TransvectionStruct.toMatrix).prod := by
  induction L with
  | nil => simp
  | cons t L ih => simp [tsSL, ih]

/-- **Isaacs Thm 8.31** — `SL(n, 𝕜)` is generated by the transvections
`tᵢⱼ(α) = 1 + α Eᵢⱼ` (`i ≠ j`), over any field and finite index type. -/
theorem closure_transvections_eq_top :
    Subgroup.closure (transvections n 𝕜) = ⊤ := by
  classical
  rw [eq_top_iff]
  intro M _
  obtain ⟨L, L', D, hMD⟩ :=
    Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec
      (M : Matrix n n 𝕜)
  have hdet : ∏ k, D k = 1 := by
    have h1 : det (M : Matrix n n 𝕜) = 1 := M.2
    rw [hMD, det_mul, det_mul, det_listTransvec_prod, det_listTransvec_prod,
      det_diagonal, one_mul, mul_one] at h1
    exact h1
  have hmemL : ∀ (L₀ : List (TransvectionStruct n 𝕜)),
      (L₀.map tsSL).prod ∈ Subgroup.closure (transvections n 𝕜) := by
    intro L₀
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨t, -, rfl⟩ := List.mem_map.mp hx
    exact Subgroup.subset_closure ⟨t.i, t.j, t.hij, t.c, rfl⟩
  have hMeq : M =
      (L.map tsSL).prod * diagonalSL D hdet * (L'.map tsSL).prod := by
    apply Subtype.ext
    simp only [Matrix.SpecialLinearGroup.coe_mul]
    rw [coe_listTransvecSL_prod, coe_listTransvecSL_prod]
    exact hMD
  rw [hMeq]
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (hmemL L) (diagonalSL_mem_closure D hdet)) (hmemL L')

/-! ### Isaacs Thm 8.32 — `SL(n, 𝕜)` is perfect -/

section Perfect

variable {i j k : n}

set_option linter.unusedSimpArgs false in
/-- For distinct `i, k, j`: `tᵢₖ(α) tₖⱼ(1) = tᵢⱼ(α) (tₖⱼ(1) tᵢₖ(α))`, the
inverse-free form of the commutator identity `⁅tᵢₖ(α), tₖⱼ(1)⁆ = tᵢⱼ(α)`. -/
private lemma transvection_mul_transvection_comm_identity
    (hij : i ≠ j) (hik : i ≠ k) (hkj : k ≠ j) (α : 𝕜) :
    transvection i k α * transvection k j 1 =
      transvection i j α * (transvection k j 1 * transvection i k α) := by
  have hji : j ≠ i := hij.symm
  have hki : k ≠ i := hik.symm
  have hjk : j ≠ k := hkj.symm
  ext r s
  by_cases hri : r = i <;> by_cases hrj : r = j <;> by_cases hrk : r = k <;>
    by_cases hsi : s = i <;> by_cases hsj : s = j <;> by_cases hsk : s = k <;>
    simp_all [transvection, Matrix.mul_apply, Matrix.single_apply,
      Matrix.one_apply, Matrix.add_apply, Finset.sum_add_distrib,
      Finset.sum_ite_eq, Finset.sum_ite_eq', add_mul, mul_add, ite_and,
      mul_comm, eq_comm]

set_option linter.unusedSimpArgs false in
set_option linter.unnecessarySeqFocus false in
/-- Conjugating `tᵢⱼ(γ)` by `diag(β⁻¹ at i, β at j)` scales the parameter by
`β⁻²`, in inverse-free form. -/
private lemma diagonal_pair_mul_transvection (hij : i ≠ j) {β : 𝕜}
    (hβ : β ≠ 0) (γ : 𝕜) :
    diagonal (Function.update (Function.update (1 : n → 𝕜) i β⁻¹) j β) *
        transvection i j γ =
      transvection i j (β⁻¹ * β⁻¹ * γ) *
        diagonal (Function.update (Function.update (1 : n → 𝕜) i β⁻¹) j β) := by
  have hji : j ≠ i := hij.symm
  ext r s
  rw [diagonal_mul, mul_diagonal]
  by_cases hri : r = i <;> by_cases hrj : r = j <;>
    by_cases hsi : s = i <;> by_cases hsj : s = j <;>
    simp_all [transvection, Matrix.single_apply, Matrix.one_apply,
      Matrix.add_apply, Function.update_apply, mul_ite, ite_mul, mul_comm,
      mul_assoc, eq_comm] <;>
    field_simp

/-- The inverse of a transvection is the opposite transvection. -/
private lemma transvectionSL_inv (hij : i ≠ j) (c : 𝕜) :
    (transvectionSL i j hij c)⁻¹ = transvectionSL i j hij (-c) := by
  apply inv_eq_of_mul_eq_one_left
  apply Subtype.ext
  simp only [Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.coe_one]
  change transvection i j (-c) * transvection i j c = 1
  rw [transvection_mul_transvection_same _ _ hij, neg_add_cancel,
    transvection_zero]

/-- The product of the pair vector `(β⁻¹ at i, β at j, 1 elsewhere)` is 1. -/
private lemma prod_pairVec (hij : i ≠ j) {a b : 𝕜} (hab : b * a = 1) :
    ∏ x, Function.update (Function.update (1 : n → 𝕜) i a) j b x = 1 := by
  classical
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j),
    ← Finset.mul_prod_erase _ _
      (Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩)]
  rw [Function.update_self, Function.update_of_ne hij, Function.update_self]
  rw [Finset.prod_eq_one fun x hx => by
    obtain ⟨hxi, hx2⟩ := Finset.mem_erase.mp hx
    rw [Function.update_of_ne (Finset.mem_erase.mp hx2).1,
      Function.update_of_ne hxi]
    rfl]
  rw [mul_one, hab]

/-- **Isaacs Thm 8.32** — `SL(n, 𝕜)` is perfect when the index type has at
least three elements, or when the field contains a unit `β` with `β² ≠ 1`
(for a finite field of order `q`, the latter is exactly `q > 3`; the book
states the result for `n ≥ 3` or `n = 2, q > 3`). -/
theorem commutator_specialLinearGroup_eq_top
    (h : 3 ≤ Nat.card n ∨ ∃ β : 𝕜, β ≠ 0 ∧ β ^ 2 ≠ 1) :
    commutator (Matrix.SpecialLinearGroup n 𝕜) = ⊤ := by
  classical
  rw [eq_top_iff, ← closure_transvections_eq_top (n := n) (𝕜 := 𝕜),
    Subgroup.closure_le]
  rintro t ⟨i, j, hij, c, hc⟩
  have ht : t = transvectionSL i j hij c := Subtype.ext hc
  rw [ht]
  rcases h with h3 | ⟨β, hβ0, hβ1⟩
  · -- a third index exists: the `⁅tᵢₖ(c), tₖⱼ(1)⁆` identity
    obtain ⟨k, hik, hkj⟩ : ∃ k : n, i ≠ k ∧ k ≠ j := by
      by_contra hcon
      have hall : (Finset.univ : Finset n) ⊆ {i, j} := by
        intro x _
        by_contra hx
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hx
        exact hcon ⟨x, Ne.symm hx.1, hx.2⟩
      have h1 := Finset.card_le_card hall
      have h2 : ({i, j} : Finset n).card ≤ 2 := by
        have := Finset.card_insert_le i ({j} : Finset n)
        simp only [Finset.card_singleton] at this
        omega
      rw [Finset.card_univ, ← Nat.card_eq_fintype_card] at h1
      omega
    have hXY : transvectionSL i k hik c * transvectionSL k j hkj 1 =
        transvectionSL i j hij c *
          (transvectionSL k j hkj 1 * transvectionSL i k hik c) := by
      apply Subtype.ext
      simp only [Matrix.SpecialLinearGroup.coe_mul]
      exact transvection_mul_transvection_comm_identity hij hik hkj c
    have hT : transvectionSL i j hij c =
        ⁅transvectionSL i k hik c, transvectionSL k j hkj 1⁆ := by
      rw [commutatorElement_def]
      have h2 : transvectionSL i j hij c =
          (transvectionSL i k hik c * transvectionSL k j hkj 1) *
            (transvectionSL k j hkj 1 * transvectionSL i k hik c)⁻¹ :=
        eq_mul_inv_of_mul_eq hXY.symm
      rw [h2, mul_inv_rev]
      group
    rw [hT]
    exact SetLike.mem_coe.mpr (Subgroup.commutator_mem_commutator
      (Subgroup.mem_top _) (Subgroup.mem_top _))
  · -- diagonal conjugation: `⁅diag(β⁻¹, β), tᵢⱼ(γ)⁆ = tᵢⱼ((β⁻² - 1) γ)`
    have hden : β⁻¹ * β⁻¹ - 1 ≠ 0 := by
      intro h0
      apply hβ1
      have h1 : β⁻¹ * β⁻¹ = 1 := sub_eq_zero.mp h0
      have h2 : (β⁻¹ * β⁻¹)⁻¹ = 1 := by rw [h1, inv_one]
      rw [mul_inv, inv_inv] at h2
      rw [pow_two]
      exact h2
    set γ : 𝕜 := c / (β⁻¹ * β⁻¹ - 1) with hγ
    set B : Matrix.SpecialLinearGroup n 𝕜 :=
      diagonalSL (Function.update (Function.update (1 : n → 𝕜) i β⁻¹) j β)
        (prod_pairVec hij (mul_inv_cancel₀ hβ0)) with hB
    set C : Matrix.SpecialLinearGroup n 𝕜 := transvectionSL i j hij γ with hC
    have hbc : B * C = transvectionSL i j hij (β⁻¹ * β⁻¹ * γ) * B := by
      apply Subtype.ext
      simp only [Matrix.SpecialLinearGroup.coe_mul]
      exact diagonal_pair_mul_transvection hij hβ0 γ
    have hcommBC : ⁅B, C⁆ = transvectionSL i j hij (β⁻¹ * β⁻¹ * γ) * C⁻¹ := by
      rw [commutatorElement_def]
      have h2 : B * C * B⁻¹ = transvectionSL i j hij (β⁻¹ * β⁻¹ * γ) := by
        rw [hbc]
        group
      rw [← h2]
    have hfin : ⁅B, C⁆ = transvectionSL i j hij c := by
      rw [hcommBC, hC, transvectionSL_inv]
      apply Subtype.ext
      simp only [Matrix.SpecialLinearGroup.coe_mul]
      change transvection i j (β⁻¹ * β⁻¹ * γ) * transvection i j (-γ) =
        transvection i j c
      rw [transvection_mul_transvection_same _ _ hij]
      congr 1
      rw [hγ]
      field_simp
      ring
    rw [← hfin]
    exact SetLike.mem_coe.mpr (Subgroup.commutator_mem_commutator
      (Subgroup.mem_top _) (Subgroup.mem_top _))

end Perfect

