module

public import CFSG.ThirdParty.BrauerInduction.Bernstein.Projection
public import CFSG.ThirdParty.BrauerInduction.LinearSpan

public section

set_option autoImplicit true
set_option maxSynthPendingDepth 3

namespace CFSG
end CFSG
open CFSG

/-!
# Brauer induction theorem

This file states the principal consequences of Bernstein's proof of Brauer
induction.

The Bernstein construction proves that the unit belongs to `BrauerIdeal`.
Consequently, multiplying the unit by a representation character places every
representation character in `BrauerSpanChar`. The inclusion
`BrauerSpanChar.le_BrauerSpanLin` then expresses it as an integral linear
combination of characters induced from linear characters of Brauer-elementary
subgroups.

The final theorem gives the equivalent virtual-character formulation.
-/

universe u

open BigOperators

namespace CFSG.BrauerInduction

/--
Brauer induction as an equality of class functions.

The character of any finite-dimensional representation is an integral linear
combination of characters induced from linear characters of Brauer-elementary
subgroups.
-/
theorem character_eq_sum_induced_linear_classFun
    {G k : Type u}
    [Group G] [Finite G]
    [Field k] [CharZero k] [IsAlgClosed k]
    (V : FDRep k G) :
    ∃ (ι : Type) (_ : Fintype ι)
      (ns : ι → ℤ) (Hs : ι → Subgroup G)
      (ψs : ∀ i, Hs i →* kˣ),
      (∀ i, IsBrauerElementary (Hs i)) ∧
      ClassFun.character V =
        ∑ i, ns i •
          ClassFun.character (FDRep.indLin (Hs i) (ψs i)) := by
  have h1 :
      (1 : ClassFun k G) ∈ BrauerSpanChar := by
    simpa using
      (Bernstein.one_mem_BrauerIdeal (k := k) (G := G))
  have hV :
      ClassFun.character V ∈ BrauerSpanChar := by
    simpa [mul_one] using
      BrauerSpanChar.character_mul_mem V h1
  exact
    BrauerSpanLin.exists_decomposition
      (BrauerSpanChar.le_BrauerSpanLin hV)

/--
Brauer induction in representation-character notation.

This is the same decomposition as
`character_eq_sum_induced_linear_classFun`, written using `FDRep.character`.
-/
theorem character_eq_sum_induced_linear
    {G k : Type u} [Group G] [Finite G]
    [Field k] [CharZero k] [IsAlgClosed k]
    (V : FDRep k G) :
    ∃ (ι : Type) (_ : Fintype ι)
      (ns : ι → ℤ) (Hs : ι → Subgroup G)
      (ψs : ∀ i, Hs i →* kˣ),
      (∀ i, IsBrauerElementary (Hs i)) ∧
      V.character =
        ∑ i, ns i •
          (FDRep.indLin (Hs i) (ψs i)).character := by
  obtain ⟨ι, hι, ns, Hs, ψs, hElem, hsum⟩ :=
    character_eq_sum_induced_linear_classFun V
  refine ⟨ι, hι, ns, Hs, ψs, hElem, ?_⟩
  ext g
  simpa [ClassFun.char_apply, ClassFun.sum_apply, ClassFun.smul_apply] using
    congrArg (fun F : ClassFun k G => F g) hsum

open ClassFun in
/--
Brauer's induction theorem in virtual-character form.

The virtual character group of `G`, defined as the `ℤ`-span of irreducible
characters, is generated by characters induced from linear characters of
Brauer-elementary subgroups.
-/
theorem virtualCharacterSubmodule_eq_BrauerSpanLin
    {G k : Type u}
    [Group G] [Finite G]
    [Field k] [CharZero k] [IsAlgClosed k] :
    ClassFun.virtualCharacterSubmodule k G =
      BrauerSpanLin (k := k) (G := G) := by
  apply le_antisymm
  · rw [ClassFun.virtualCharacterSubmodule, Submodule.span_le]
    rintro χ ⟨S, _, rfl⟩
    obtain ⟨ι, hι, ns, Hs, ψs, hElem, hsum⟩ :=
      character_eq_sum_induced_linear_classFun S
    rw [hsum]
    exact Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ (ns i)
        (Submodule.subset_span
          ⟨{ H := Hs i, hElem := hElem i, ψ := ψs i }, rfl⟩)
  · haveI : NeZero (Nat.card G : k) :=
      ⟨One.natCast_natCard_ne_zero_of_finite G k⟩
    rw [BrauerSpanLin, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    rw [ClassFun.virtualCharacterSubmodule]
    simpa [BrauerLinGen.inducedCharacter] using
      (ClassFun.character_mem_span_irreducibles
        (FDRep.indLin i.H i.ψ))

end CFSG.BrauerInduction
