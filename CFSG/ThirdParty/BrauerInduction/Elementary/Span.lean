module

public import CFSG.ThirdParty.BrauerInduction.Span
public import CFSG.ThirdParty.BrauerInduction.Cyclotomic.CharacterAlgebra

public section

set_option autoImplicit true
set_option maxSynthPendingDepth 3

namespace CFSG
end CFSG
open CFSG

/-!
# Fixed-prime character spans and ideals

For a prime parameter `p`, this file packages characters induced from
`p`-elementary subgroups at both integral and cyclotomic coefficient levels.

* `PElementarySpanChar p` is the integral induced-character span;
* `PElementaryIdeal p` is the corresponding ideal of the character ring;
* `PElementarySpanLambda p` is the span over the cyclotomic coefficient ring
  `ClassFun.Lambda k G`;
* `PElementaryCyclotomicIdeal p` is the corresponding ideal of
  `ClassFun.CyclotomicCharacterAlgebra`.

These objects are shared infrastructure for the Bernstein proof of Brauer
induction. The integral fixed-prime ideal maps into `BrauerIdeal`, while the
cyclotomic span is stable under multiplication by the global cyclotomic
character algebra.
-/

universe u

open BigOperators ClassFun

namespace CFSG.BrauerInduction

variable {k : Type u} [Field k]
variable {G : Type u} [Group G] [Finite G]
variable (p : ℕ)

/--
Characters induced from representations of `p`-elementary subgroups.
-/
abbrev PElementaryCharGen : Set (ClassFun k G) :=
  InducedCharacterGen (fun H => IsPElementary p H)

/--
The integral span of characters induced from representations of
`p`-elementary subgroups.
-/
@[expose] def PElementarySpanChar :
    Submodule ℤ (ClassFun k G) :=
  InducedCharacterSpan (fun H => IsPElementary p H)

/--
The ideal of the character ring generated by characters induced from
representations of `p`-elementary subgroups.
-/
@[expose] def PElementaryIdeal :
    Ideal (ClassFun.CharacterRing k G) :=
  InducedCharacterIdeal (fun H => IsPElementary p H)

namespace PElementaryIdeal

@[simp]
lemma mem_iff
    (φ : ClassFun.CharacterRing k G) :
    φ ∈ PElementaryIdeal p ↔
      (φ : ClassFun k G) ∈ PElementarySpanChar p :=
  Iff.rfl

/--
For prime `p`, the fixed-prime ideal is contained in the global Brauer ideal.
-/
lemma le_BrauerIdeal [Fact p.Prime] :
    PElementaryIdeal p ≤ BrauerIdeal (k := k) (G := G) := by
  exact InducedCharacterIdeal.mono
    (P := fun H => IsPElementary p H)
    (Q := fun H => IsBrauerElementary H)
    (fun H hH => IsBrauerElementary.ofIsPElementary p hH)

end PElementaryIdeal

namespace PElementarySpanChar

/--
A character induced from a representation of a `p`-elementary subgroup
belongs to the fixed-`p` integral span.
-/
lemma inducedCharacter_mem
    (H : Subgroup G)
    (hH : IsPElementary p H)
    (V : FDRep k H) :
    ClassFun.ind H
      (ClassFun.character V) ∈ PElementarySpanChar p := by
  exact InducedCharacterSpan.inducedCharacter_mem
      (P := fun K => IsPElementary p K) H hH V

/--
The fixed-`p` span is contained in the global Brauer-elementary span.
-/
lemma le_BrauerSpanChar [Fact p.Prime] :
    PElementarySpanChar p ≤ BrauerSpanChar (k := k) (G := G) := by
  apply InducedCharacterSpan.mono
  intro H hH
  exact IsBrauerElementary.ofIsPElementary p hH

/--
Multiplication on the left by a representation character preserves the
fixed-`p` integral span.
-/
lemma character_mul_mem
    (V : FDRep k G)
    {φ : ClassFun k G}
    (hφ : φ ∈ PElementarySpanChar p) :
    ClassFun.character V * φ ∈
      PElementarySpanChar p := by
  exact InducedCharacterSpan.character_mul_mem
    (fun H => IsPElementary p H) V hφ

/--
The fixed-`p` integral span is closed under pointwise multiplication.
-/
lemma mul_mem
    {φ ψ : ClassFun k G}
    (hφ : φ ∈ PElementarySpanChar p)
    (hψ : ψ ∈ PElementarySpanChar p) :
    φ * ψ ∈ PElementarySpanChar p := by
  exact InducedCharacterSpan.mul_mem
     (fun H => IsPElementary p H) hφ hψ

/--
Induction from a subgroup preserves the fixed-`p` integral span.
-/
lemma induction_mem
    {H : Subgroup G}
    {φ : ClassFun k H}
    (hφ : φ ∈ PElementarySpanChar p) :
    ClassFun.ind H φ ∈ PElementarySpanChar p := by
  apply InducedCharacterSpan.induction_mem
    (P := fun K : Subgroup H => IsPElementary p K)
    (Q := fun K : Subgroup G => IsPElementary p K)
    ?_ hφ
  intro K hK
  exact IsPElementary.ofMulEquiv
    p hK (K.equivMapOfInjective H.subtype Subtype.coe_injective)

end PElementarySpanChar

section Cyclotomic

/--
The span over the ambient cyclotomic coefficient ring of characters induced
from representations of `p`-elementary subgroups.
-/
@[expose] def PElementarySpanLambda :
    Submodule (ClassFun.Lambda k G) (ClassFun k G) :=
  Submodule.span (ClassFun.Lambda k G) (PElementaryCharGen p)

namespace PElementarySpanLambda

/--
A character induced from a representation of a `p`-elementary subgroup
belongs to the fixed-`p` cyclotomic span.
-/
lemma inducedCharacter_mem
    (H : Subgroup G)
    (hH : IsPElementary p H)
    (V : FDRep k H) :
    ClassFun.ind H (ClassFun.character V) ∈
      PElementarySpanLambda p := by
  apply Submodule.subset_span
  exact ⟨H, hH, V, rfl⟩

lemma ind_mem
    (H : Subgroup G)
    (hH : IsPElementary p H)
    {q : ClassFun k H}
    (hq : q ∈ ClassFun.R_Lambda k G H) :
    ClassFun.ind H q ∈ PElementarySpanLambda p := by
  refine Submodule.span_induction
    (p := fun q _ => ClassFun.ind H q ∈ PElementarySpanLambda p)
    ?gen ?zero ?add ?smul hq
  · rintro χ ⟨V, rfl⟩
    exact inducedCharacter_mem p H hH V
  · simp
  · intro x y _ _ hx hy
    rw [ClassFun.ind_add]
    exact Submodule.add_mem _ hx hy
  · intro a x _ hx
    change
      ClassFun.ind H
        (((a : ClassFun.Lambda k G) : k) • x) ∈ PElementarySpanLambda p
    rw [ClassFun.ind_smul]
    exact Submodule.smul_mem _ a hx

lemma le_R_Lambda_top :
    PElementarySpanLambda p ≤
      ClassFun.R_Lambda.top k G := by
  rw [PElementarySpanLambda, Submodule.span_le]
  rintro χ ⟨H, hH, V, rfl⟩
  rw [← ClassFun.char_ind]
  exact Submodule.subset_span ⟨FDRep.ind H V, rfl⟩

/--
Multiplication on the left by an element of the full cyclotomic character
span preserves the fixed-`p` elementary span.
-/
lemma mul_mem_left_R_Lambda_top
    {f g : ClassFun k G}
    (hf : f ∈ ClassFun.R_Lambda.top k G)
    (hg : g ∈ PElementarySpanLambda p) :
    f * g ∈ PElementarySpanLambda p := by
  refine Submodule.span_induction
    (p := fun g _ =>
      f * g ∈ PElementarySpanLambda p)
    ?gen ?zero ?add ?smul hg
  · rintro _ ⟨H, hH, V, rfl⟩
    rw [ClassFun.projection_formula]
    apply ind_mem p H hH
    apply ClassFun.R_Lambda.mul_mem
    · exact ClassFun.R_Lambda.top_res_to_subgroup H hf
    · exact ClassFun.R_Lambda.char_mem H V
  · simp
  · intro x y _ _ hx hy
    rw [mul_add]
    exact Submodule.add_mem _ hx hy
  · intro a x _ hx
    rw [mul_smul_comm]
    exact Submodule.smul_mem _ a hx

/--
The fixed-`p` cyclotomic elementary span is closed under pointwise
multiplication.
-/
lemma mul_mem
    {f g : ClassFun k G}
    (hf : f ∈ PElementarySpanLambda p)
    (hg : g ∈ PElementarySpanLambda p) :
    f * g ∈ PElementarySpanLambda p := by
  exact mul_mem_left_R_Lambda_top p (le_R_Lambda_top p hf)  hg

/--
Every positive power of an element of the fixed-`p` cyclotomic elementary
span remains in that span.
-/
lemma pow_succ_mem
    {f : ClassFun k G}
    (hf : f ∈ PElementarySpanLambda p)
    (n : ℕ) : f ^ (n + 1) ∈ PElementarySpanLambda p := by
  induction n with
  | zero =>
      simpa using hf
  | succ n ih =>
      simpa [pow_succ, Nat.succ_eq_add_one] using
        mul_mem p ih hf

lemma pow_mem
    {f : ClassFun k G}
    (hf : f ∈ PElementarySpanLambda p)
    {n : ℕ}
    (hn : n ≠ 0) :
    f ^ n ∈ PElementarySpanLambda p := by
  cases n with
  | zero =>
      exact (hn rfl).elim
  | succ n =>
      simpa [Nat.succ_eq_add_one] using
        pow_succ_mem p hf n

end PElementarySpanLambda
/--
The ideal of the cyclotomic character algebra generated by characters induced
from representations of `p`-elementary subgroups.
-/
@[expose] def PElementaryCyclotomicIdeal :
    Ideal (ClassFun.CyclotomicCharacterAlgebra
      (k := k) (G := G)) where
  carrier :=
    {f |
      (f : ClassFun k G) ∈
        PElementarySpanLambda p}
  zero_mem' := by
    change
      (0 : ClassFun k G) ∈
        PElementarySpanLambda p
    exact Submodule.zero_mem _
  add_mem' := by
    intro f g hf hg
    change
      (f : ClassFun k G) + (g : ClassFun k G) ∈ PElementarySpanLambda p
    exact Submodule.add_mem _ hf hg
  smul_mem' := by
    intro f g hg
    change
      (f : ClassFun k G) * g ∈ PElementarySpanLambda  p
    exact PElementarySpanLambda.mul_mem_left_R_Lambda_top
      p f.property hg

namespace PElementaryCyclotomicIdeal

@[simp]
lemma mem_iff
    (f : ClassFun.CyclotomicCharacterAlgebra) :
    f ∈ PElementaryCyclotomicIdeal (k := k) (G := G) p ↔
      (f : ClassFun k G) ∈ PElementarySpanLambda p :=
  Iff.rfl

end PElementaryCyclotomicIdeal

end Cyclotomic
end CFSG.BrauerInduction
