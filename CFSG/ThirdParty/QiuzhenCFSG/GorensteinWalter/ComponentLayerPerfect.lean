module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Defs
public import Mathlib.GroupTheory.IsPerfect

namespace CFSG
end CFSG
open CFSG

/-!
# Perfectness of the component layer
-/

namespace CFSG.GorensteinWalter

universe u

/-- The component layer is perfect because it is generated by perfect
components. -/
public theorem componentLayerOf_isPerfect
    {G : Type u} [Group G] (N : Subgroup G) :
    Group.IsPerfect (componentLayerOf N) := by
  apply Subgroup.isPerfect_iff.mpr
  let L : Subgroup G := componentLayerOf N
  apply le_antisymm
  · exact (Subgroup.commutator_le_sup L L).trans (sup_idem L).le
  · rw [componentLayerOf]
    refine sSup_le ?_
    intro E hE
    have hEperfect : Group.IsPerfect E :=
      (Group.isPerfect_def).2 hE.2.2.2.1
    have hEE : ⁅E, E⁆ = E := Subgroup.isPerfect_iff.mp hEperfect
    rw [← hEE]
    exact Subgroup.commutator_mono (le_sSup hE) (le_sSup hE)

end CFSG.GorensteinWalter
