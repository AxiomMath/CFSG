namespace CFSG
end CFSG
open CFSG

noncomputable section

open scoped Pointwise

namespace CFSG.GorensteinWalter

universe u

/-!
# The inverted order-three subgroup of a `J₃`-element

For `y ∈ J₃` the inverted set `I_Ĥ(y)` has cardinality three, so by the
small-inverted-set structure it is the cyclic subgroup of order three
generated by any non-identity element.  This module packages that subgroup:
it is nontrivial, lies in `Ĥ`, is inverted by `y`, meets `VU` trivially
(restriction (5)), and is not centralized by `y`.
-/

public theorem firstCase_klein_J3_inverted_subgroup
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G)
    (hfirst : FirstCase c)
    (hklein : IsKleinFour (pCore 2 c.Hhat))
    {y : G} (hyJ : y ∈ firstCaseJ c 3) :
    ∃ X : Subgroup G,
      X ≠ ⊥ ∧ X ≤ c.Hhat ∧ Nat.card X = 3 ∧
      (∀ x : G, x ∈ X → x ∈ invertedElements c.Hhat y) ∧
      X ⊓ (twoCoreOf c.Hhat ⊔ c.U) = ⊥ ∧
      ¬ (∀ x : G, x ∈ X → y * x = x * y) := by
  classical
  have hyJ' : IsInvolution y ∧ y ∉ c.Hhat ∧
      firstCaseCosetInvolutions c y = 3 := by
    change y ∈ firstCaseJ c 3
    exact hyJ
  have hy : IsInvolution y := hyJ'.1
  have hyH : y ∉ c.Hhat := hyJ'.2.1
  have hcoset : firstCaseCosetInvolutions c y = 3 := hyJ'.2.2
  have hI3 : Nat.card {x : G // x ∈ invertedElements c.Hhat y} = 3 := by
    rw [← firstCase_klein_coset_involution_card_eq c hy hyH, hcoset]
  let I : Type u := {x : G // x ∈ invertedElements c.Hhat y}
  let : Fintype I := Fintype.ofFinite _
  have hIcard : Fintype.card I = 3 := by
    rw [← Nat.card_eq_fintype_card]
    exact hI3
  have honeI : (1 : G) ∈ invertedElements c.Hhat y := ⟨c.Hhat.one_mem, by simp⟩
  let a0 : I := ⟨1, honeI⟩
  obtain ⟨t0, ht0⟩ := Fintype.exists_ne_of_one_lt_card
    (by omega : 1 < Fintype.card I) a0
  let t : G := t0.1
  have htI : t ∈ invertedElements c.Hhat y := t0.2
  have htne : t ≠ 1 := by
    intro h
    apply ht0
    apply Subtype.ext
    exact h
  have hord : orderOf t = 3 :=
    inverted_card_three_orderOf_eq_three c.Hhat hy htI htne hI3
  let X : Subgroup G := Subgroup.zpowers t
  have hXne : X ≠ ⊥ := by
    intro hbot
    apply htne
    have : t ∈ (⊥ : Subgroup G) := by
      rw [← hbot]
      exact Subgroup.mem_zpowers t
    exact Subgroup.mem_bot.mp this
  have hXle : X ≤ c.Hhat := Subgroup.zpowers_le.mpr htI.1
  have hXcard : Nat.card X = 3 := by
    rw [Nat.card_zpowers, hord]
  have hXinv : ∀ x : G, x ∈ X → x ∈ invertedElements c.Hhat y := by
    intro x hx
    rcases Subgroup.mem_zpowers_iff.mp hx with ⟨m, rfl⟩
    refine ⟨c.Hhat.zpow_mem htI.1 m, ?_⟩
    calc
      y * t ^ m * y⁻¹ = (y * t * y⁻¹) ^ m := by exact conj_zpow.symm
      _ = (t⁻¹) ^ m := by rw [htI.2]
      _ = (t ^ m)⁻¹ := by simp
  have hXinf : X ⊓ (twoCoreOf c.Hhat ⊔ c.U) = ⊥ :=
    firstCase_klein_inverted_subgroup_inf_VU_eq_bot
      hmin c hfirst hklein hy hyH hXle hXinv
  have hnotCent : ¬ (∀ x : G, x ∈ X → y * x = x * y) := by
    intro hall
    have hc : y * t = t * y := hall t (Subgroup.mem_zpowers t)
    have hyt : y * t * y⁻¹ = t := by
      calc
        y * t * y⁻¹ = t * y * y⁻¹ := by rw [hc]
        _ = t := by simp
    have htin : y * t * y⁻¹ = t⁻¹ := htI.2
    have htinv : t⁻¹ = t := by rw [← htin, hyt]
    have htSq : t * t = 1 := by
      calc
        t * t = t * t⁻¹ := by rw [htinv]
        _ = 1 := by simp
    have hord2 : orderOf t ∣ 2 :=
      orderOf_dvd_of_pow_eq_one (by simpa [pow_two] using htSq)
    rw [hord] at hord2
    norm_num at hord2
  exact ⟨X, hXne, hXle, hXcard, hXinv, hXinf, hnotCent⟩

end CFSG.GorensteinWalter
