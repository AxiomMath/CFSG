module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section3.FirstCaseKleinCommutator
public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section3.CyclicTwoCoreKleinFour
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-!
# The odd-core decomposition in the Klein-four branch
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

/-- In the Klein-four first case, the odd core is generated by its Fitting
subgroup and the subgroup fixed by the Sylow `2`-subgroup. -/
public theorem firstCase_klein_U_eq_FU_sup_B
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G)
    (hfirst : FirstCase c)
    (hklein : IsKleinFour (pCore 2 c.Hhat)) :
    ∃ bg : BenderGlauberman.Hyp11 G,
      (bg.S : Subgroup G) = (c.S : Subgroup G) ∧ bg.S0 = c.S0 ∧ bg.U = c.U ∧
        bg.U = fittingSubgroupOf bg.U ⊔ bg.B := by
  classical
  obtain ⟨d⟩ := exists_firstCaseBGData hmin c hfirst
  let bg := d.bg
  have hinverted : ∀ s : G, c.IsReflection s →
      ∃ I : Subgroup G, IsInvertedSubgroup I c.U s := by
    intro s hs
    obtain ⟨I, hI, _hHall⟩ := hfirst.1 s hs
    exact ⟨I, hI⟩
  have hcomm : ⁅(c.S : Subgroup G), c.U⁆ ≤ c.FU :=
    lemma_2_8_commutator_le_FU c hinverted
  have hcomm' : ⁅(bg.S : Subgroup G), bg.U⁆ ≤ fittingSubgroupOf bg.U := by
    have hU : bg.U = c.U := by
      change oddCoreOf bg.H = c.U
      rw [d.H_eq]
      rfl
    rw [hU]
    rw [d.S_eq]
    exact hcomm
  have hdecomp := firstCase_U_eq_FU_sup_B bg hcomm'
  refine ⟨bg, ?_, ?_, ?_, hdecomp⟩
  · simpa [bg] using d.S_eq
  · simpa [bg] using d.S0_eq
  · change oddCoreOf bg.H = c.U
    rw [d.H_eq]
    rfl

end CFSG.GorensteinWalter
