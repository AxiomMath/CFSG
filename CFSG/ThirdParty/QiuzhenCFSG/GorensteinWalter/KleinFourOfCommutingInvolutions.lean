module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Defs
public import Mathlib.GroupTheory.SpecificGroups.KleinFour
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-!
# Klein four generated by two commuting involutions

Two distinct commuting involutions generate a Klein four group.  This is the
standard `{1, a, b, a*b}` construction used to obtain a Klein-four subgroup
inside a dihedral Sylow subgroup containing the distinguished involution.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

@[expose] public def kleinFourOfCommutingInvolutions
    {G : Type u} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1) (hab : Commute a b) :
    Subgroup G where
  carrier := {a * b, a, b, 1}
  one_mem' := by simp
  mul_mem' := by
    have hba : b * a = a * b := hab.eq.symm
    have ha_ab : a * (a * b) = b := by
      rw [← mul_assoc, ha, one_mul]
    have hb_ab : b * (a * b) = a := by
      rw [← mul_assoc, hba, mul_assoc, hb, mul_one]
    have hab_a : (a * b) * a = b := by
      rw [mul_assoc, hba, ha_ab]
    have hab_b : (a * b) * b = a := by
      rw [mul_assoc, hb, mul_one]
    have hab_sq : (a * b) * (a * b) = 1 := by
      rw [← mul_assoc, hab_a, hb]
    intro x y hx hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy ⊢
    rcases hx with (rfl | rfl | rfl | rfl) <;>
      rcases hy with (rfl | rfl | rfl | rfl) <;>
      simp [ha, hb, hba, ha_ab, hb_ab, hab_a, hab_b, hab_sq]
  inv_mem' := by
    have ha_inv : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
    have hb_inv : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
    have hab_sq : (a * b) * (a * b) = 1 := by
      calc
        (a * b) * (a * b) = a * (b * a) * b := by group
        _ = a * (a * b) * b := by rw [hab.eq.symm]
        _ = 1 := by rw [← mul_assoc, ha, one_mul, hb]
    have hab_inv : (a * b)⁻¹ = a * b :=
      inv_eq_of_mul_eq_one_right hab_sq
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with (rfl | rfl | rfl | rfl) <;>
      simp [ha_inv, hb_inv, hab_inv]

public theorem isKleinFour_kleinFourOfCommutingInvolutions
    {G : Type u} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1)
    (ha1 : a ≠ 1) (hb1 : b ≠ 1) (habne : a ≠ b) (hab : Commute a b) :
    IsKleinFour (kleinFourOfCommutingInvolutions a b ha hb hab) := by
  let V := kleinFourOfCommutingInvolutions a b ha hb hab
  have hoa : orderOf a = 2 :=
    orderOf_eq_prime (by simpa [pow_two] using ha) ha1
  have hob : orderOf b = 2 :=
    orderOf_eq_prime (by simpa [pow_two] using hb) hb1
  have habnot : a * b ∉ ({a, b, 1} : Set G) :=
    mul_notMem_of_orderOf_eq_two hoa hob habne
  constructor
  · change Nat.card V = 4
    rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq]
    change ({a * b, a, b, 1} : Set G).ncard = 4
    simp [habnot, ha1, hb1, habne]
  · apply Nat.dvd_antisymm
    · apply Monoid.exponent_dvd_of_forall_pow_eq_one
      intro x
      rcases x with ⟨x, hx⟩
      apply Subtype.ext
      change x ^ 2 = 1
      change x ∈ ({a * b, a, b, 1} : Set G) at hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with (rfl | rfl | rfl | rfl)
      · calc
          (a * b) ^ 2 = a * (b * a) * b := by rw [pow_two]; group
          _ = a * (a * b) * b := by rw [hab.eq.symm]
          _ = 1 := by rw [← mul_assoc, ha, one_mul, hb]
      · simpa [pow_two] using ha
      · simpa [pow_two] using hb
      · simp
    · have haV : a ∈ V := by
        change a ∈ ({a * b, a, b, 1} : Set G)
        simp
      have hordV : orderOf (⟨a, haV⟩ : V) = 2 := by
        simpa [Subgroup.orderOf_mk] using hoa
      simpa [hordV] using
        (Monoid.order_dvd_exponent (⟨a, haV⟩ : V))

/-- Two distinct commuting involutions generate a Klein-four subgroup. -/
public theorem exists_kleinFour_of_commuting_involutions
    {G : Type u} [Group G]
    (a b : G) (ha : IsInvolution a) (hb : IsInvolution b)
    (habne : a ≠ b) (hab : Commute a b) :
    ∃ V : Subgroup G, IsKleinFour V ∧ a ∈ V ∧ b ∈ V := by
  refine ⟨kleinFourOfCommutingInvolutions a b
    (by simpa [pow_two] using ha.2) (by simpa [pow_two] using hb.2) hab,
    isKleinFour_kleinFourOfCommutingInvolutions a b
      (by simpa [pow_two] using ha.2) (by simpa [pow_two] using hb.2)
      ha.1 hb.1 habne hab, ?_, ?_⟩
  · change a ∈ ({a * b, a, b, 1} : Set G)
    simp
  · change b ∈ ({a * b, a, b, 1} : Set G)
    simp

/-- The Klein-four generated by two commuting involutions is contained in
any subgroup containing both generators. -/
public theorem exists_kleinFour_of_commuting_involutions_le
    {G : Type u} [Group G]
    (P : Subgroup G) (a b : G)
    (ha : IsInvolution a) (hb : IsInvolution b)
    (habne : a ≠ b) (hab : Commute a b)
    (haP : a ∈ P) (hbP : b ∈ P) :
    ∃ V : Subgroup G, V ≤ P ∧ IsKleinFour V ∧ a ∈ V ∧ b ∈ V := by
  let V : Subgroup G := kleinFourOfCommutingInvolutions a b
    (by simpa [pow_two] using ha.2) (by simpa [pow_two] using hb.2) hab
  have hV : IsKleinFour V := isKleinFour_kleinFourOfCommutingInvolutions a b
    (by simpa [pow_two] using ha.2) (by simpa [pow_two] using hb.2)
    ha.1 hb.1 habne hab
  have hVP : V ≤ P := by
    intro x hx
    change x ∈ ({a * b, a, b, 1} : Set G) at hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact P.mul_mem haP hbP
    · exact haP
    · exact hbP
    · exact P.one_mem
  have haV : a ∈ V := by
    change a ∈ ({a * b, a, b, 1} : Set G)
    simp
  have hbV : b ∈ V := by
    change b ∈ ({a * b, a, b, 1} : Set G)
    simp
  exact ⟨V, hVP, hV, haV, hbV⟩

end CFSG.GorensteinWalter
