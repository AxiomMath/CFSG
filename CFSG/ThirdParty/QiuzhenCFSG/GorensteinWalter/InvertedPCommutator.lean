module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderGlauberman.Defs
public import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

open scoped commutatorElement

namespace CFSG.GorensteinWalter

universe u

/-- If `t` inverts a subgroup `P`, then the square of `p ∈ P` lies in
`[P, ⟨t⟩]`. -/
public theorem square_mem_commutator_of_inverted
    {G : Type u} [Group G] (t : G) (ht : IsInvolution t)
    (P : Subgroup G) (hinv : BenderGlauberman.IsInvertedBy t P)
    (p : G) (hp : p ∈ P) :
    p * p ∈ ⁅P, Subgroup.zpowers t⁆ := by
  have htp : t * (p : G)⁻¹ * t = (p : G) := by
    have ht_inv : t⁻¹ = t := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using ht.2)
    have h := hinv (p : G) hp
    rw [ht_inv] at h
    have h' : (p : G)⁻¹ = t * (p : G) * t := h.symm
    have htt : t * t = 1 := by simpa [pow_two] using ht.2
    calc
      t * (p : G)⁻¹ * t = t * (t * (p : G) * t) * t := by rw [h']
      _ = (t * t) * (p : G) * (t * t) := by group
      _ = (p : G) := by rw [htt]; simp
  have hcomm : ⁅(p : G), t⁆ = (p : G) * (p : G) := by
    have ht_inv : t⁻¹ = t := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using ht.2)
    calc
      ⁅(p : G), t⁆ = (p : G) * t * (p : G)⁻¹ * t⁻¹ := rfl
      _ = (p : G) * t * (p : G)⁻¹ * t := by rw [ht_inv]
      _ = (p : G) * (t * (p : G)⁻¹ * t) := by group
      _ = (p : G) * (p : G) := by rw [htp]
  have hm := Subgroup.commutator_mem_commutator (H₁ := P)
    (H₂ := Subgroup.zpowers t) (g₁ := (p : G)) (g₂ := t)
    hp (Subgroup.mem_zpowers t)
  rw [hcomm] at hm
  exact hm

/-- If `t` inverts `P`, then the cyclic subgroup generated by `(p⁻¹)²`
lies in `[P, ⟨t⟩]`. -/
public theorem zpowers_inverse_square_le_commutator_of_inverted
    {G : Type u} [Group G] (t : G) (ht : IsInvolution t)
    (P : Subgroup G) (hinv : BenderGlauberman.IsInvertedBy t P)
    (p : G) (hp : p ∈ P) :
    Subgroup.zpowers ((p : G)⁻¹ * (p : G)⁻¹) ≤
      ⁅P, Subgroup.zpowers t⁆ := by
  have hsq := square_mem_commutator_of_inverted t ht P hinv (p : G) hp
  have hinvmem : ((p : G) * (p : G))⁻¹ ∈ ⁅P, Subgroup.zpowers t⁆ :=
    (⁅P, Subgroup.zpowers t⁆).inv_mem hsq
  have hgen : (p : G)⁻¹ * (p : G)⁻¹ = ((p : G) * (p : G))⁻¹ := by group
  have hgmem : (p : G)⁻¹ * (p : G)⁻¹ ∈ ⁅P, Subgroup.zpowers t⁆ := by
    rw [hgen]
    exact hinvmem
  exact Subgroup.zpowers_le.mpr hgmem

end CFSG.GorensteinWalter
