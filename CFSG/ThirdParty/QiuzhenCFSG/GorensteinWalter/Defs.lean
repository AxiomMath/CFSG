module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Classification
public import Mathlib.GroupTheory.IsSubnormal
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.Fitting.Core

namespace CFSG
end CFSG
open CFSG

/-!
# Common subgroup and involution-centralizer definitions
-/

noncomputable section

open Matrix

namespace CFSG.GorensteinWalter

universe u

/-! ## Subgroup notation used by the paper -/

/-- The odd core of a subgroup, regarded as an ambient subgroup. -/
@[expose] public def oddCoreOf {G : Type*} [Group G]
    (H : Subgroup G) : Subgroup G :=
  (pPrimeCore 2 H).map H.subtype

/-- The `2`-core of a subgroup, regarded as an ambient subgroup. -/
@[expose] public def twoCoreOf {G : Type*} [Group G]
    (H : Subgroup G) : Subgroup G :=
  (pCore 2 H).map H.subtype

/-- The `2`-residual `O²(H)`, the intersection of the normal subgroups of
`2`-power index, regarded as an ambient subgroup. -/
@[expose] public def twoResidualOf {G : Type*} [Group G]
    (H : Subgroup G) : Subgroup G :=
  (sInf {N : Subgroup H | N.Normal ∧ ∃ n : ℕ, N.index = 2 ^ n}).map H.subtype

/-- The Fitting subgroup of a subgroup, regarded as an ambient subgroup. -/
@[expose] public def fittingSubgroupOf {G : Type*} [Group G]
    (H : Subgroup G) : Subgroup G :=
  (fittingSubgroup H).map H.subtype

/-- Normality of `K` inside `H`, written without changing ambient types. -/
@[expose] public def IsNormalIn {G : Type*} [Group G]
    (K H : Subgroup G) : Prop :=
  K ≤ H ∧ ∀ h ∈ H, ∀ k ∈ K, h * k * h⁻¹ ∈ K

/-- `A` centralizes `B`. -/
@[expose] public def Centralizes {G : Type*} [Group G]
    (A B : Subgroup G) : Prop :=
  A ≤ Subgroup.centralizer (B : Set G)

/-- The elements of `H` inverted by `s`, denoted `I_H(s)` in the paper. -/
@[expose] public def invertedElements {G : Type*} [Group G]
    (H : Subgroup G) (s : G) : Set G :=
  {x : G | x ∈ H ∧ s * x * s⁻¹ = x⁻¹}

/-- A subgroup whose carrier is exactly `I_H(s)`. -/
@[expose] public def IsInvertedSubgroup {G : Type*} [Group G]
    (I H : Subgroup G) (s : G) : Prop :=
  (I : Set G) = invertedElements H s

/-- A Hall subgroup, expressed by coprimality of its order and index. -/
@[expose] public def IsHallIn {G : Type*} [Group G]
    (K H : Subgroup G) : Prop :=
  K ≤ H ∧ Nat.Coprime (Nat.card K) (K.subgroupOf H).index

/-- The maximal-subgroup arrow used in Section 2: `A ↝ B` means that the
normalizer of a nontrivial subgroup of `F(A)` lies in `B`. -/
@[expose] public def NormalizerControlledBy {G : Type*} [Group G]
    (A B : Subgroup G) : Prop :=
  ∃ X : Subgroup G,
    X ≠ ⊥ ∧ X ≤ fittingSubgroupOf A ∧
      Subgroup.normalizer (X : Set G) ≤ B

/-- Conjugation of a subgroup by an ambient element. -/
@[expose] public def conjugateSubgroup {G : Type*} [Group G]
    (H : Subgroup G) (g : G) : Subgroup G :=
  H.map (MulAut.conj g).toMonoidHom

/-- A quasisimple group: nontrivial, perfect, and simple modulo its center. -/
@[expose] public def IsQuasisimple (Q : Type*) [Group Q] : Prop :=
  Nontrivial Q ∧
    commutator Q = ⊤ ∧
      IsSimpleGroup (Q ⧸ Subgroup.center Q)

/-- `E` is a component of `H`. -/
@[expose] public def IsComponentOf {G : Type*} [Group G]
    (E H : Subgroup G) : Prop :=
  E ≤ H ∧ (E.subgroupOf H).IsSubnormal ∧ IsQuasisimple E

/-- The layer `E(H)`, generated by the components of `H`. -/
@[expose] public def componentLayerOf {G : Type*} [Group G]
    (H : Subgroup G) : Subgroup G :=
  sSup {E : Subgroup G | IsComponentOf E H}

/-- The generalized Fitting subgroup `F*(H)`. -/
@[expose] public def generalizedFittingSubgroupOf {G : Type*} [Group G]
    (H : Subgroup G) : Subgroup G :=
  fittingSubgroupOf H ⊔ componentLayerOf H

/-- The control-core relation between two subgroups `A` and `B`, the
hypothesis shape of Bender [1, Satz 1.7] (see
the proof review, §§3--§4): there is a nontrivial
subgroup `S` of `F*(A)` which is subnormal in `F*(A)`, self-centralizing in
`F*(A)`, and contained in `B`.  This is the bridge from
`NormalizerControlledBy` to the [1, 1.6/1.7] interface: for a witness `X` of
`NormalizerControlledBy A B`, the subgroup `S := F*(A) ⊓ N_G(X)` satisfies
all four conditions. -/
@[expose] public def ControlCore {G : Type u} [Group G] [Finite G]
    (A B : Subgroup G) : Prop :=
  ∃ S : Subgroup G,
    S ≠ ⊥ ∧
    S ≤ generalizedFittingSubgroupOf A ∧
    S ≤ B ∧
    (S.subgroupOf (generalizedFittingSubgroupOf A)).IsSubnormal ∧
    generalizedFittingSubgroupOf A ⊓ Subgroup.centralizer (S : Set G) ≤ S

/-- Two involutions of `H` represent distinct conjugacy classes. -/
@[expose] public def HasAtLeastTwoInvolutionClasses
    (H : Type*) [Group H] : Prop :=
  ∃ x y : H,
    IsInvolution x ∧ IsInvolution y ∧
      ¬ ∃ g : H, g * x * g⁻¹ = y

/-! ## The fixed involution-centralizer setup -/

/-- The notation fixed at the start of Section 2.

* `S` is a dihedral Sylow `2`-subgroup;
* `S0` is its cyclic subgroup of index two;
* `t` is the involution in `S0`;
* `H = C_G(t)`;
* `Hhat` is a maximal subgroup containing `H`.
-/
public structure CentralizerSetup (G : Type u) [Group G] [Finite G] where
  S : Sylow 2 G
  m : ℕ
  one_le_m : 1 ≤ m
  dihedralEquiv : Nonempty (S ≃* DihedralGroup (2 ^ m))
  S0 : Subgroup G
  S0_le_S : S0 ≤ (S : Subgroup G)
  S0_cyclic : IsCyclic S0
  S_index_two : Nat.card S = 2 * Nat.card S0
  t : G
  t_mem_S0 : t ∈ S0
  t_involution : IsInvolution t
  H : Subgroup G
  H_eq_centralizer : H = Subgroup.centralizer ({t} : Set G)
  Hhat : Subgroup G
  H_le_Hhat : H ≤ Hhat
  Hhat_maximal : IsCoatom Hhat

namespace CentralizerSetup

variable {G : Type u} [Group G] [Finite G]

/-- `U = O(H)`. -/
@[expose] public def U (c : CentralizerSetup G) : Subgroup G :=
  oddCoreOf c.H

/-- `F(U)`, regarded as a subgroup of `G`. -/
@[expose] public def FU (c : CentralizerSetup G) : Subgroup G :=
  fittingSubgroupOf c.U

/-- The reflections `S \ S0`. -/
@[expose] public def IsReflection (c : CentralizerSetup G) (s : G) : Prop :=
  s ∈ (c.S : Subgroup G) ∧ s ∉ c.S0

end CentralizerSetup

/-!
The existence theorem for `CentralizerSetup` lives in
`GorensteinWalter.MinimalCounterexample`, above the Proposition-9
centerlessness interface.  Keeping only the structure here avoids the
`GW1965 → Defs` import cycle.
-/

/-! ## Section 2 configuration predicates

These definitions were moved here from `GorensteinWalter.Section2.Basic` so
that per-theorem Section-2 modules can state their theorems without importing
the (future) wrapper, avoiding import cycles.
-/

/-- The configuration ruled out in Lemma 2.2. -/
@[expose] public def ForbiddenConfiguration
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) : Prop :=
  Centralizes c.S0 c.U ∧
    ∀ s : G, c.IsReflection s →
      ∃ I : Subgroup G,
            IsInvertedSubgroup I c.U s ∧
          IsNormalIn I c.U ∧
            ∀ X : Subgroup G,
              X ≠ ⊥ → X ≤ I → Subgroup.normalizer (X : Set G) ≤ c.H

/-- The conclusion of Theorem 2.6. -/
@[expose] public def CentralizerStructure
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) : Prop :=
  c.U = oddCoreOf c.Hhat ∧
    (c.S : Subgroup G) ⊓ Subgroup.centralizer (c.U : Set G) =
        twoCoreOf c.Hhat ∧
      ((twoCoreOf c.Hhat ≤ c.S0 ∧ c.Hhat = c.H) ∨
        (IsKleinFour (pCore 2 c.Hhat) ∧
          Nonempty
            ((c.Hhat ⧸ (pCore 2 c.Hhat ⊔ pPrimeCore 2 c.Hhat)) ≃*
              DihedralGroup 3)))

/-- Case (1) of Theorem 2.10. -/
@[expose] public def FirstCase
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) : Prop :=
  (∀ s : G, c.IsReflection s →
      ∃ I : Subgroup G,
        IsInvertedSubgroup I c.U s ∧ IsHallIn I c.FU) ∧
    ∀ X : Subgroup G,
      X ≠ ⊥ → X ≤ c.FU → Subgroup.normalizer (X : Set G) ≤ c.Hhat

/-- A witness for case (2) of Theorem 2.10. -/
public structure SecondCaseWitness
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) where
  M : Subgroup G
  M_maximal : IsCoatom M
  M_not_le_Hhat : ¬ M ≤ c.Hhat
  t_mem_componentLayer : c.t ∈ componentLayerOf M
  X : Subgroup G
  X_ne_bot : X ≠ ⊥
  X_le_FU : X ≤ c.FU
  normalizer_X_le_M : Subgroup.normalizer (X : Set G) ≤ M

/-- Case (2) of Theorem 2.10. -/
@[expose] public def SecondCase
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) : Prop :=
  Nonempty (SecondCaseWitness c)

/-- The hypotheses isolated from Lemma 2.7.  Bender's arrow `Ĥ ↝ M` has a
proper (not necessarily maximal) target, and the source assumes
`M ⊄ Ĥ`.  The first numerical alternative is `8 ≤ |S ∩ M|`. -/
@[expose] public def Lemma27Hypothesis
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) (M : Subgroup G) : Prop :=
  M ≠ ⊤ ∧
    NormalizerControlledBy c.Hhat M ∧
      ¬ M ≤ c.Hhat ∧
        c.t ∉ componentLayerOf M ∧
          (∀ P : Sylow 2 M, ¬ IsCyclic P) ∧
            (8 ≤ Nat.card ↥((c.S : Subgroup G) ⊓ M) ∨
              Nat.card c.S = 4 ∨ c.t ∈ twoResidualOf M)

/-- The local hypothesis in Lemma 2.9. -/
@[expose] public def Lemma29Hypothesis
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) : Prop :=
  ∀ (s : G) (X : Subgroup G),
    s ∈ (c.S : Subgroup G) →
      X ≠ ⊥ → X ≤ c.U →
        ⁅Subgroup.zpowers s, X⁆ = X →
          c.t ∈ twoCoreOf (Subgroup.normalizer (X : Set G))

end CFSG.GorensteinWalter
