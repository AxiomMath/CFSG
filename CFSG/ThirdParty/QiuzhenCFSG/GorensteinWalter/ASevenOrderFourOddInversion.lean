module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.ASevenInvariantOddPSubgroupCertificateDefs
public import CFSG.ThirdParty.QiuzhenCFSG.BenderGlauberman.Defs
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

namespace CFSG.GorensteinWalter

private abbrev A7 := ASevenCertificateGroup

/-- The 3-cycle on the two elements moved by `a7v` plus its unique fixed
point. -/
private def a7w : A7 :=
  ⟨Equiv.swap (4 : Fin 7) 5 * Equiv.swap 5 6, by
    simp [Equiv.Perm.sign_mul]⟩

private theorem a7v_order_four : orderOf a7v = 4 := by
  change orderOf a7v = 2 ^ 2
  apply orderOf_eq_prime_pow (p := 2) (n := 1)
  · decide
  · decide

private theorem a7w_order_three : orderOf a7w = 3 := by
  apply orderOf_eq_prime
  · decide
  · decide

private theorem a7v_inverts_a7w : a7v * a7w * a7v⁻¹ = a7w⁻¹ := by
  decide

private theorem a7w_ne_one : a7w ≠ 1 := by
  intro h
  have hord : orderOf a7w = 1 := by rw [h]; simp
  rw [a7w_order_three] at hord
  norm_num at hord

private theorem a7w_zpowers_ne_bot : Subgroup.zpowers a7w ≠ ⊥ := by
  intro hbot
  have hmem : a7w ∈ (⊥ : Subgroup A7) := by
    simpa [hbot] using Subgroup.mem_zpowers a7w
  exact a7w_ne_one (Subgroup.mem_bot.mp hmem)

private theorem a7w_zpowers_card_odd : Odd (Nat.card (Subgroup.zpowers a7w)) := by
  rw [Nat.card_zpowers, a7w_order_three]
  norm_num

private theorem a7v_inverts_a7w_zpowers :
    BenderGlauberman.IsInvertedBy a7v (Subgroup.zpowers a7w) := by
  intro x hx
  rcases Subgroup.mem_zpowers_iff.mp hx with ⟨k, rfl⟩
  calc
    a7v * a7w ^ k * a7v⁻¹ = (a7v * a7w * a7v⁻¹) ^ k := by
      simpa using (map_zpow (MulAut.conj a7v) a7w k)
    _ = (a7w⁻¹) ^ k := by
      rw [a7v_inverts_a7w]
    _ = (a7w ^ k)⁻¹ := by
      simp [zpow_neg]

/-- The requested endpoint `aSeven_no_odd_inverted_by_order_four` is false:
`a7v` is an order-four `(4,2)`-element of `A₇`, and it inverts the odd
nontrivial subgroup generated by the 3-cycle `(4 5 6)`. -/
public theorem aSeven_order_four_inverts_odd_nontrivial_subgroup :
    ∃ r : ASevenCertificateGroup, orderOf r = 4 ∧
      ∃ X : Subgroup ASevenCertificateGroup,
        Odd (Nat.card X) ∧ X ≠ ⊥ ∧
        BenderGlauberman.IsInvertedBy r X := by
  refine ⟨a7v, a7v_order_four, Subgroup.zpowers a7w,
    a7w_zpowers_card_odd, a7w_zpowers_ne_bot, a7v_inverts_a7w_zpowers⟩

end CFSG.GorensteinWalter
