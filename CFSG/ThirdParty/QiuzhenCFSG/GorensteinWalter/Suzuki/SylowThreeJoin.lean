/-!
# The index-seven core of the Suzuki recognition step

Suzuki §8 finishes the first case by constructing a subgroup of index seven
in the simple group `G` of order `2520`; the mechanical tail
(index seven forces `G ≃ A₇`) lives in `Suzuki/IndexSevenToA7.lean`.  This
module owns the missing core:

* the numerical shell around it: the Sylow 3-subgroup normalizer has index
  `70`, and a simple group of order `2520` has no subgroups of index `2` or
  `5`;
* the pinned recognition core `firstCase_exists_indexSeven_subgroup`.

## Route `R5-sylow2-normalizer-join`

In the `A₇` model the index-seven subgroup is the point stabilizer `A₆`; it
is generated by a Sylow 3-subgroup `P` containing `U` together with a Sylow
2-subgroup `S'` of `G` that contains the Sylow 2-subgroup `T₂` of
`N_G(P)`:

```text
P = ⟨(1 2 3), (4 5 6)⟩,  T₂ = Sylow₂(N_A₇(P)) = C₄,
S' = the unique Sylow₂ A₇ with T₂ ≤ S',
⟨P, S'⟩ = A₆,  |⟨P, S'⟩| = 360,  [A₇ : ⟨P, S'⟩] = 7
```

The join contains `N_G(P) = ⟨P, T₂⟩` (order 36), so `[G : H]` divides
`[G : N_G(P)] = 70`.  Since `n₃(H) = [H : N_G(P)] ≡ 1 [MOD 3]`, the order of
`H` is not `72` or `504` (`R5-B`, landed), and the shell below excludes the
index-`2`/`5` cases; the remaining route is to exclude `H = G` (`R5-A`).

## Dead routes (GAP-verified in the model, do not revisit)

* Joining with the *setup* Sylow 2 `S = c.S`: `S ≤ Ĥ = N_G(U)` (in fact
  `S ∩ C_G(U) = O₂(Ĥ)` is the Klein four), and `⟨P, S⟩ = Ĥ` has order 72 —
  not an index-seven subgroup.  This invalidated the earlier `R4` route:
  its gap `|⟨P, S⟩| ≠ 72` is false in the model.
* `⟨N_G(V), N_G(W)⟩ = A₇` for the two `U`-conjugates `V, W ≤ P` (order
  `2520`, not `360`);
* `⟨N_G(P), Q⟩ = G` for any Sylow 3-subgroup `Q ≠ P` sharing a conjugate of
  `U` with `P`;
* `⟨N_G(P), C_G(W)⟩ = G`, `⟨N_G(P), Ĥ⟩ = G`, `⟨N_G(P), S₀⟩ = G` for the
  setup `S₀`, and `⟨N_G(P), z⟩ = N_G(P)` for `z` of order two in the Sylow
  2-subgroup of `N_G(P)`.

The viable construction is the join with a Sylow 2-subgroup containing
`Sylow₂(N_G(P))` (Suzuki's §8 `S'`, characterized there by `S' ∩ C_G(U) = 1`).

Modified for CFSG: `firstCase_exists_indexSeven_subgroup` and its step `join_h_ne_top` are
removed. The step's proof was `sorry` upstream and nothing here uses either.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

private lemma d8_indexTwo_sq_one (j : ZMod 4) (x : DihedralGroup 4)
    (hx : x ∈ dihedralIndexTwoSubgroup 2 j) : x ^ 2 = 1 := by
  rw [mem_dihedralIndexTwoSubgroup_iff (by norm_num : 1 ≤ 2) j x] at hx
  rcases hx with ⟨k, hk⟩ | ⟨k, hk⟩
  · rw [hk, pow_two, DihedralGroup.r_mul_r]
    have hmod : (2 * (k : ZMod 4) + 2 * (k : ZMod 4) : ZMod 4) = 0 := by
      have h4 : ((4 : ℕ) : ZMod 4) = 0 :=
        (ZMod.natCast_eq_zero_iff (4 : ℕ) (4 : ℕ)).mpr (by norm_num)
      calc
        2 * (k : ZMod 4) + 2 * (k : ZMod 4) = (k : ZMod 4) * (4 : ℕ) := by ring
        _ = (k : ZMod 4) * 0 := by rw [h4]
        _ = 0 := by simp
    rw [hmod, DihedralGroup.r_zero]
  · rw [hk, pow_two, DihedralGroup.sr_mul_sr]
    have hmod : (j + (2 : ZMod 4) * (k : ZMod 4)) -
        (j + (2 : ZMod 4) * (k : ZMod 4)) = 0 := by abel
    rw [hmod, DihedralGroup.r_zero]

private lemma d8_indexTwo_isKleinFour (j : ZMod 4) :
    IsKleinFour ↥(dihedralIndexTwoSubgroup 2 j) := by
  let D : Subgroup (DihedralGroup 4) := dihedralIndexTwoSubgroup 2 j
  have hindex : D.index = 2 := by
    simpa [D] using dihedralIndexTwoSubgroup_index_eq_two (by norm_num : 1 ≤ 2) j
  have hDcard : Nat.card ↥D = 4 := by
    have hm := D.index_mul_card
    change D.index * Nat.card ↥D = Nat.card (DihedralGroup 4) at hm
    rw [hindex, DihedralGroup.nat_card] at hm
    omega
  have hsq : ∀ x : ↥D, x ^ 2 = 1 := by
    intro x
    apply Subtype.ext
    exact d8_indexTwo_sq_one j (x : DihedralGroup 4) x.2
  have hExpDvd : Monoid.exponent ↥D ∣ 2 := by
    rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
    intro x
    simpa [pow_two] using hsq x
  have h2Dvd : 2 ∣ Monoid.exponent ↥D := by
    have hnon : Nontrivial ↥D := by
      rw [← Finite.one_lt_card_iff_nontrivial]
      rw [hDcard]
      norm_num
    rcases exists_ne (1 : ↥D) with ⟨x, hx⟩
    have hx2 : x ^ 2 = 1 := hsq x
    have hxord2 : orderOf x = 2 := by
      apply orderOf_eq_prime
      · simpa [pow_two] using hx2
      · exact hx
    rw [← hxord2]
    exact Monoid.order_dvd_exponent x
  have hExp : Monoid.exponent ↥D = 2 := by
    apply Nat.dvd_antisymm hExpDvd h2Dvd
  exact { card_four := hDcard, exponent_two := hExp }

private lemma isKleinFour_of_card_four_no_order_four {G : Type*} [Group G] [Finite G]
    (K : Subgroup G) (hKcard : Nat.card ↥K = 4)
    (hno4 : ∀ x : ↥K, orderOf x ≠ 4) : IsKleinFour ↥K := by
  have hKnc : ¬ IsCyclic ↥K := by
    intro hcyc
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥K)
    have hzg : Subgroup.zpowers g = ⊤ := by
      apply le_antisymm
      · intro x hx
        trivial
      · intro x hx
        exact hg x
    have hord : orderOf g = 4 := by
      have hcard : Nat.card (Subgroup.zpowers g : Subgroup (↥K)) = 4 := by
        rw [hzg]
        simpa using hKcard
      let : Fintype (↥K) := Fintype.ofFinite _
      have hfc : Fintype.card ↥(Subgroup.zpowers g : Subgroup (↥K)) = orderOf g :=
        Fintype.card_zpowers (x := g)
      rw [← Nat.card_eq_fintype_card, hcard] at hfc
      exact hfc.symm
    exact hno4 g hord
  have hExp : Monoid.exponent ↥K = 2 :=
    (not_isCyclic_iff_exponent_eq_prime (α := ↥K) Nat.prime_two hKcard).mp hKnc
  exact { card_four := hKcard, exponent_two := hExp }

private lemma isKleinFour_of_mulEquiv {G H : Type*} [Group G] [Group H]
    [Finite G] [Finite H] (e : G ≃* H) (hH : IsKleinFour H) : IsKleinFour G := by
  refine { card_four := ?_, exponent_two := ?_ }
  · rw [Nat.card_congr e.toEquiv]
    exact hH.card_four
  · rw [Monoid.exponent_eq_of_mulEquiv e]
    exact hH.exponent_two

private lemma order_four_sq_eq_unique_involution {G : Type*} [Group G] [Finite G]
    (K : Subgroup G) (hKcard : Nat.card ↥K = 4)
    {t : ↥K} (ht : t ≠ 1) (ht2 : t ^ 2 = 1)
    {x : ↥K} (hx4 : orderOf x = 4) : x ^ 2 = t := by
  let : Fintype (↥K) := Fintype.ofFinite _
  have hgen : Subgroup.zpowers x = ⊤ := by
    apply Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers x) (K := ⊤) le_top
    rw [Nat.card_zpowers, hx4]
    exact le_of_eq ((Nat.card_congr (Subgroup.topEquiv (G := ↥K)).toEquiv).trans hKcard)
  have htm : t ∈ Subgroup.zpowers x := by
    rw [hgen]
    trivial
  rcases (Subgroup.mem_zpowers_iff).mp htm with ⟨k, htk⟩
  have hres : k % 4 = 0 ∨ k % 4 = 1 ∨ k % 4 = 2 ∨ k % 4 = 3 := by omega
  rcases hres with hk0 | hk1 | hk2 | hk3
  · exfalso
    apply ht
    calc
      t = x ^ k := htk.symm
      _ = x ^ (0 : ℤ) := by
        have hk0' : k % (4 : ℤ) = 0 := by exact_mod_cast hk0
        rw [← zpow_mod_orderOf x k, hx4]
        change x ^ (k % (4 : ℤ)) = x ^ (0 : ℤ)
        rw [hk0']
      _ = 1 := by simp
  · exfalso
    have hz1 : x ^ (1 : ℤ) = x ^ k := by
      apply (zpow_eq_zpow_iff_modEq (x := x) (m := 1) (n := k)).2
      have hk1' : k % (4 : ℤ) = 1 := by exact_mod_cast hk1
      have hm1 : 1 ≡ k [ZMOD 4] := by
        simpa [hk1'] using Int.mod_modEq k 4
      simpa [hx4] using hm1
    have hord : orderOf (x ^ k) = 4 := by
      rw [← hz1]
      have hconv : x ^ (1 : ℤ) = x := by simp
      rw [hconv, hx4]
    have hord2 : orderOf (x ^ k) = 2 := by
      apply orderOf_eq_prime
      · simpa [htk, pow_two] using ht2
      · intro h1
        apply ht
        simpa [htk] using h1
    omega
  · have hz2 : x ^ (2 : ℤ) = t := by
      calc
        x ^ (2 : ℤ) = x ^ k := by
          apply (zpow_eq_zpow_iff_modEq (x := x) (m := 2) (n := k)).2
          have hk2' : k % (4 : ℤ) = 2 := by exact_mod_cast hk2
          have hm2 : 2 ≡ k [ZMOD 4] := by
            simpa [hk2'] using Int.mod_modEq k 4
          simpa [hx4] using hm2
      _ = t := htk
    have hz2nat : (x : ↥K) ^ (2 : ℕ) = t := by
      rw [← zpow_natCast]
      exact hz2
    exact hz2nat
  · exfalso
    have hz3 : x ^ (3 : ℤ) = x ^ k := by
      apply (zpow_eq_zpow_iff_modEq (x := x) (m := 3) (n := k)).2
      have hk3' : k % (4 : ℤ) = 3 := by exact_mod_cast hk3
      have hm3 : 3 ≡ k [ZMOD 4] := by
        simpa [hk3'] using Int.mod_modEq k 4
      simpa [hx4] using hm3
    have hord : orderOf (x ^ k) = 4 := by
      have hz3nat : (x : ↥K) ^ (3 : ℕ) = x ^ k := by
        rw [← zpow_natCast]
        exact hz3
      have hord' : orderOf ((x : ↥K) ^ (3 : ℕ)) = 4 := by
        rw [orderOf_pow (x := (x : ↥K)) (n := 3), hx4]
        norm_num
      rw [← hz3nat]
      exact hord'
    have hord2 : orderOf (x ^ k) = 2 := by
      apply orderOf_eq_prime
      · simpa [htk, pow_two] using ht2
      · intro h1
        apply ht
        simpa [htk] using h1
    omega

/-- In a subgroup of order two, every nonidentity element is the same. -/
private lemma eq_of_mem_card_two {G : Type*} [Group G] [Finite G]
    (A : Subgroup G) (hA : Nat.card ↥A = 2)
    {a b : G} (ha : a ∈ A) (hb : b ∈ A) (hane : a ≠ 1) (hbne : b ≠ 1) :
    a = b := by
  classical
  have hle : Subgroup.zpowers a ≤ A := by
    intro x hx
    rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
    exact A.zpow_mem ha n
  have hord2 : orderOf a = 2 := by
    have hdvd := Subgroup.orderOf_dvd_natCard A ha
    rw [hA] at hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
    · exfalso
      exact hane (orderOf_eq_one_iff.mp h1)
    · exact h2
  have hgen : Subgroup.zpowers a = A := by
    apply Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers a) (K := A) hle
    rw [Nat.card_zpowers, hord2, hA]
  have hbzp : b ∈ Subgroup.zpowers a := by
    rw [hgen]
    exact hb
  rcases (Subgroup.mem_zpowers_iff).mp hbzp with ⟨n, hbn⟩
  have hnmod : n % (2 : ℤ) = 1 := by
    by_contra hn0
    have hn0' : n % (2 : ℤ) = 0 := by
      have hlt : n % (2 : ℤ) < 2 :=
        Int.emod_lt_of_pos n (by norm_num : 0 < (2 : ℤ))
      have hge : 0 ≤ n % (2 : ℤ) :=
        Int.emod_nonneg n (by norm_num : (2 : ℤ) ≠ 0)
      omega
    have h1 : a ^ n = 1 := by
      rw [← zpow_mod_orderOf a n, hord2]
      change a ^ (n % (2 : ℤ)) = 1
      rw [hn0']
      simp
    apply hbne
    calc
      b = a ^ n := hbn.symm
      _ = 1 := h1
  calc
    a = a ^ n := by
      rw [← zpow_mod_orderOf a n]
      norm_num [hord2, hnmod]
    _ = b := hbn

private lemma exists_ne_of_card_gt_two {α : Type*} [Fintype α]
    (h : 2 < Fintype.card α) (a b : α) (hab : a ≠ b) :
    ∃ x, x ≠ a ∧ x ≠ b := by
  classical
  by_contra hx
  push_neg at hx
  have hsubset : (Finset.univ : Finset α) ⊆ ({a, b} : Finset α) := by
    intro x hxuniv
    simp
    by_cases hxa : x = a
    · exact Or.inl hxa
    · exact Or.inr (hx x hxa)
  have hpair : ({a, b} : Finset α).card = 2 := by
    rw [Finset.card_insert_of_notMem]
    · simp
    · intro hb
      exact hab (Finset.mem_singleton.mp hb)
  have hcard : Fintype.card α ≤ 2 := by
    simpa [hpair] using Finset.card_le_card hsubset
  omega

private lemma eq_or_inv_of_order_three {G : Type*} [Group G] [Finite G]
    (U : Subgroup G) (hU : Nat.card ↥U = 3)
    {u y : G} (hu : u ∈ U) (hune : u ≠ 1) (hy : y ∈ U) (hyne : y ≠ 1) :
    y = u ∨ y = u⁻¹ := by
  classical
  by_cases hyu : y = u
  · exact Or.inl hyu
  · right
    have hpow3 : u ^ 3 = 1 := by
      have hdvd : orderOf u ∣ 3 := by
        have h := Subgroup.orderOf_dvd_natCard U hu
        rwa [hU] at h
      rw [orderOf_dvd_iff_pow_eq_one] at hdvd
      exact hdvd
    have hord3 : orderOf u = 3 := orderOf_eq_prime hpow3 hune
    have hu2ne : u ^ 2 ≠ 1 := by
      intro h2
      have hord2 : orderOf u ∣ 2 := by
        rw [orderOf_dvd_iff_pow_eq_one]
        simpa [pow_two] using h2
      have hord1 : orderOf u = 1 := by
        have hg : Nat.gcd 2 3 = 1 := by norm_num
        have hd : orderOf u ∣ Nat.gcd 2 3 := Nat.dvd_gcd hord2 (by
            rw [hord3])
        rw [hg] at hd
        exact Nat.dvd_one.mp hd
      exact hune (orderOf_eq_one_iff.mp hord1)
    have hu2u : u ^ 2 ≠ u := by
      intro h
      apply hune
      calc
        u = u ^ 2 * u⁻¹ := by group
        _ = u * u⁻¹ := by rw [h]
        _ = 1 := by simp
    let s : Finset G := {1, u, y}
    have hs_card : s.card = 3 := by
      have h1_not : (1 : G) ∉ ({u, y} : Finset G) := by
        intro h
        rcases Finset.mem_insert.mp h with h1 | h1
        · exact hune h1.symm
        · exact hyne (Finset.mem_singleton.mp h1).symm
      have hu_not : u ∉ ({y} : Finset G) := by
        intro h
        exact hyu (Finset.mem_singleton.mp h).symm
      rw [show s = ({1, u, y} : Finset G) by rfl]
      rw [Finset.card_insert_of_notMem h1_not,
        Finset.card_insert_of_notMem hu_not, Finset.card_singleton]
    have hs_subset : (s : Set G) ⊆ (U : Set G) := by
      intro z hz
      simp [s] at hz
      rcases hz with rfl | rfl | rfl
      · exact U.one_mem
      · exact hu
      · exact hy
    have hs_ncard : (s : Set G).ncard = 3 := by
      simpa using hs_card
    have hUncard : ((U : Set G)).ncard = 3 := by
      rw [← Nat.card_coe_set_eq]
      exact hU
    have hs_eq : (s : Set G) = (U : Set G) := by
      refine Set.eq_of_subset_of_ncard_le hs_subset ?_
      rw [hs_ncard, hUncard]
    have hu2U : u ^ 2 ∈ (U : Set G) := U.pow_mem hu 2
    have hu2s : u ^ 2 ∈ (s : Set G) := by
      rw [hs_eq]
      exact hu2U
    simp [s] at hu2s
    rcases hu2s with h1 | hu | hyu2
    · exact False.elim (hu2ne h1)
    · exact False.elim (hu2u hu)
    · rw [← hyu2]
      have hmul : u ^ 2 * u = 1 := by
        simpa [pow_succ] using hpow3
      exact eq_inv_of_mul_eq_one_left hmul

private lemma d8_rotation_reflection_conj (i j : ZMod 4) (hi : i = 1 ∨ i = 3) :
    DihedralGroup.r i * DihedralGroup.sr j * (DihedralGroup.r i)⁻¹ =
      DihedralGroup.r 2 * DihedralGroup.sr j := by
  decide +revert

private lemma d8_reflection_reflection_conj (i j : ZMod 4)
    (h : i - j = 1 ∨ i - j = 3) :
    DihedralGroup.sr i * DihedralGroup.sr j * (DihedralGroup.sr i)⁻¹ =
      DihedralGroup.r 2 * DihedralGroup.sr j := by
  decide +revert

/-- In `ZMod 4`, avoiding `0` and `2` forces the odd representatives. -/
private lemma zmod4_eq_one_or_three_of_ne_zero_two {a : ZMod 4}
    (h0 : a ≠ 0) (h2 : a ≠ 2) : a = 1 ∨ a = 3 := by
  have hvals : a.val = 0 ∨ a.val = 1 ∨ a.val = 2 ∨ a.val = 3 := by
    have hlt : a.val < 4 := ZMod.val_lt a
    omega
  rcases hvals with h0v | h1v | h2v | h3v
  · exfalso
    apply h0
    rw [← ZMod.natCast_zmod_val a, h0v]
    norm_num
  · left
    rw [← ZMod.natCast_zmod_val a, h1v]
    norm_num
  · exfalso
    apply h2
    rw [← ZMod.natCast_zmod_val a, h2v]
    norm_num
  · right
    rw [← ZMod.natCast_zmod_val a, h3v]
    norm_num

private lemma d8_r2_central (x : DihedralGroup 4) :
    DihedralGroup.r 2 * x = x * DihedralGroup.r 2 := by
  decide +revert

private lemma d8_involution_ne_one_ne_r2_is_sr (x : DihedralGroup 4)
    (hx2 : x ^ 2 = 1) (hxne : x ≠ 1)
    (hxne2 : x ≠ DihedralGroup.r 2) :
    ∃ j : ZMod 4, x = DihedralGroup.sr j := by
  rcases dihedralGroup_cases x with ⟨i, hi⟩ | ⟨j, hj⟩
  · exfalso
    have hord : orderOf (DihedralGroup.r i) = 2 := by
      rw [hi] at hx2
      exact orderOf_eq_prime (by simpa [pow_two] using hx2) (by
        intro h
        apply hxne
        rw [hi, h])
    have hival : i.val = 0 ∨ i.val = 1 ∨ i.val = 2 ∨ i.val = 3 := by
      have hlt : i.val < 4 := ZMod.val_lt i
      omega
    rcases hival with h0 | h1 | h2 | h3
    · have hord1 : orderOf (DihedralGroup.r i) = 1 := by
        rw [← ZMod.natCast_zmod_val i, h0]
        norm_num
      omega
    · have hord4 : orderOf (DihedralGroup.r i) = 4 := by
        rw [← ZMod.natCast_zmod_val i, h1, DihedralGroup.orderOf_r]
        have hval : ZMod.val ((1 : ℕ) : ZMod 4) = 1 := by decide
        rw [hval]
        norm_num
      omega
    · have hR : DihedralGroup.r i = DihedralGroup.r 2 := by
        rw [← ZMod.natCast_zmod_val i, h2]
        norm_num
      exact hxne2 (hi ▸ hR)
    · have hord4 : orderOf (DihedralGroup.r i) = 4 := by
        rw [← ZMod.natCast_zmod_val i, h3, DihedralGroup.orderOf_r]
        have hval : ZMod.val ((3 : ℕ) : ZMod 4) = 3 := by decide
        rw [hval]
        norm_num
      omega
  · exact ⟨j, hj⟩

/-- In the dihedral group of order eight, conjugating a reflection of a
Klein-four subgroup by any element outside that subgroup multiplies it by
the central involution. -/
private lemma d8_conj_v4_reflection (j0 : ZMod 4)
    {r v : DihedralGroup 4}
    (hrA : r ∉ dihedralIndexTwoSubgroup 2 j0)
    (hvA : v ∈ dihedralIndexTwoSubgroup 2 j0)
    (hv2 : v ^ 2 = 1) (hvne : v ≠ 1)
    (hvneR2 : v ≠ DihedralGroup.r 2) :
    r * v * r⁻¹ = DihedralGroup.r 2 * v := by
  rcases d8_involution_ne_one_ne_r2_is_sr v hv2 hvne hvneR2 with ⟨j, hvj⟩
  rcases dihedralGroup_cases r with ⟨i, hi⟩ | ⟨i, hi⟩
  · have hrA' : DihedralGroup.r i ∉ dihedralIndexTwoSubgroup 2 j0 := by
      simpa [hi] using hrA
    have hival : i.val = 0 ∨ i.val = 1 ∨ i.val = 2 ∨ i.val = 3 := by
      have hlt : i.val < 4 := ZMod.val_lt i
      omega
    rcases hival with h0 | h1 | h2 | h3
    · exfalso
      apply hrA'
      rw [mem_dihedralIndexTwoSubgroup_iff (by norm_num : 1 ≤ 2) j0
        (DihedralGroup.r i)]
      left
      refine ⟨0, ?_⟩
      rw [← ZMod.natCast_zmod_val i, h0]
      norm_num
    · rw [hi, hvj]
      apply d8_rotation_reflection_conj i j
      left
      rw [← ZMod.natCast_zmod_val i, h1]
      norm_num
    · exfalso
      apply hrA'
      rw [mem_dihedralIndexTwoSubgroup_iff (by norm_num : 1 ≤ 2) j0
        (DihedralGroup.r i)]
      left
      refine ⟨1, ?_⟩
      rw [← ZMod.natCast_zmod_val i, h2]
      norm_num
    · rw [hi, hvj]
      apply d8_rotation_reflection_conj i j
      right
      rw [← ZMod.natCast_zmod_val i, h3]
      norm_num
  · have hvA' : DihedralGroup.sr j ∈ dihedralIndexTwoSubgroup 2 j0 := by
      simpa [hvj] using hvA
    rw [mem_dihedralIndexTwoSubgroup_iff (by norm_num : 1 ≤ 2) j0
      (DihedralGroup.sr j)] at hvA'
    rcases hvA' with ⟨k, hk⟩ | ⟨k, hk⟩
    · exfalso
      cases hk
    · have hjk : j = j0 + (2 : ZMod 4) * k := by
        exact DihedralGroup.sr.inj hk
      have hrA' : DihedralGroup.sr i ∉ dihedralIndexTwoSubgroup 2 j0 := by
        simpa [hi] using hrA
      rw [mem_dihedralIndexTwoSubgroup_iff (by norm_num : 1 ≤ 2) j0
        (DihedralGroup.sr i)] at hrA'
      let b : ZMod 4 := j0 + (2 : ZMod 4) * k
      have hd0 : i - b ≠ 0 := by
        intro hd
        apply hrA'
        right
        refine ⟨k, ?_⟩
        have hib : i = b := sub_eq_zero.mp hd
        rw [hib]
      have hd2 : i - b ≠ 2 := by
        intro hd
        apply hrA'
        right
        refine ⟨k + 1, ?_⟩
        have hib : i = (2 : ZMod 4) + b := sub_eq_iff_eq_add.mp hd
        rw [hib]
        simp [b]
        ring
      have hdiff := zmod4_eq_one_or_three_of_ne_zero_two (a := i - b) hd0 hd2
      rw [hi, hvj]
      apply d8_reflection_reflection_conj i j
      simpa [b, hjk] using hdiff

private lemma d8_v4_contains_r2 (K : Subgroup (DihedralGroup 4))
    (hK : IsKleinFour ↥K) : DihedralGroup.r 2 ∈ K := by
  have hKcard : Nat.card ↥K = 4 := hK.card_four
  have hindex : K.index = 2 := by
    have hm := K.index_mul_card
    change K.index * Nat.card ↥K = Nat.card (DihedralGroup 4) at hm
    rw [hKcard, DihedralGroup.nat_card] at hm
    omega
  have hnormal : K.Normal := Subgroup.normal_of_index_eq_two hindex
  rcases normal_subgroup_dihedral_two_pow (m := 2) (by norm_num : 1 ≤ 2) K hnormal with
    hrot | htop | hind
  · exfalso
    rcases hrot with ⟨k, hk, hKrot⟩
    have hKcyc : IsCyclic ↥K := by
      rw [hKrot, dihedralRotationSubgroup_def]
      exact Subgroup.isCyclic_zpowers (DihedralGroup.r (2 ^ k : ZMod (2 ^ 2)))
    let : IsKleinFour ↥K := hK
    exact IsKleinFour.not_isCyclic hKcyc
  · exfalso
    rw [htop] at hKcard
    have h8 : Fintype.card (DihedralGroup 4) = 8 := by
      rw [← Nat.card_eq_fintype_card]
      exact DihedralGroup.nat_card
    norm_num at hKcard h8
    omega
  · rcases hind with ⟨j, hKj⟩
    rw [hKj]
    rw [mem_dihedralIndexTwoSubgroup_iff (by norm_num : 1 ≤ 2) j (DihedralGroup.r 2)]
    left
    refine ⟨1, ?_⟩
    norm_num

private lemma d8_card4_subgroup_contains_sr (A : Subgroup (DihedralGroup 4))
    (hAcard : Nat.card ↥A = 4) (j : ZMod 4)
    (hsr : DihedralGroup.sr j ∈ A) : IsKleinFour ↥A := by
  have hindex : A.index = 2 := by
    have hm := A.index_mul_card
    change A.index * Nat.card ↥A = Nat.card (DihedralGroup 4) at hm
    rw [hAcard, DihedralGroup.nat_card] at hm
    omega
  have hnormal : A.Normal := Subgroup.normal_of_index_eq_two hindex
  rcases normal_subgroup_dihedral_two_pow (m := 2) (by norm_num : 1 ≤ 2) A hnormal with
    hrot | htop | hind
  · exfalso
    rcases hrot with ⟨k, hk, hArot⟩
    have hmem : DihedralGroup.sr j ∈ Subgroup.zpowers (DihedralGroup.r 1) := by
      have hle : Subgroup.zpowers (DihedralGroup.r (2 ^ k : ZMod 4)) ≤
          Subgroup.zpowers (DihedralGroup.r 1) := by
        apply Subgroup.zpowers_le.mpr
        exact r_mem_zpowers_r_one (2 ^ k : ZMod 4)
      have hsrR : DihedralGroup.sr j ∈
          Subgroup.zpowers (DihedralGroup.r (2 ^ k : ZMod 4)) := by
        change DihedralGroup.sr j ∈
          Subgroup.zpowers (DihedralGroup.r (2 ^ k : ZMod (2 ^ 2)))
        rw [← dihedralRotationSubgroup_def 2 k]
        rw [← hArot]
        exact hsr
      exact hle hsrR
    exact sr_not_mem_zpowers_r_one j hmem
  · exfalso
    rw [htop] at hAcard
    have h8 : Fintype.card (DihedralGroup 4) = 8 := by
      rw [← Nat.card_eq_fintype_card]
      exact DihedralGroup.nat_card
    norm_num at hAcard h8
    omega
  · rcases hind with ⟨j', hAj⟩
    rw [hAj]
    exact d8_indexTwo_isKleinFour j'

/-- Every subgroup of order four in `D₈` misses an involution. -/
private lemma d8_exists_involution_not_mem_card_four
    (A : Subgroup (DihedralGroup 4)) (hA : Nat.card A = 4) :
    ∃ r : DihedralGroup 4, IsInvolution r ∧ r ∉ A := by
  classical
  by_contra h
  push Not at h
  have hsr : ∀ j : ZMod 4, DihedralGroup.sr j ∈ A := by
    intro j
    apply h
    constructor
    · decide +revert
    · rw [pow_two, DihedralGroup.sr_mul_sr]
      simp
  let f : Fin 5 → A
    | ⟨0, _⟩ => ⟨1, A.one_mem⟩
    | ⟨1, _⟩ => ⟨DihedralGroup.sr 0, hsr 0⟩
    | ⟨2, _⟩ => ⟨DihedralGroup.sr 1, hsr 1⟩
    | ⟨3, _⟩ => ⟨DihedralGroup.sr 2, hsr 2⟩
    | ⟨4, _⟩ => ⟨DihedralGroup.sr 3, hsr 3⟩
  have hf : Function.Injective f := by
    intro i j hij
    have hij' := congrArg Subtype.val hij
    fin_cases i <;> fin_cases j <;> simp only [f] at hij' ⊢
    all_goals first | exact Fin.ext (by omega) | (exfalso; revert hij'; decide)
  have h5 : 5 ≤ Nat.card A := by
    simpa using Nat.card_le_card_of_injective f hf
  omega

private lemma sylow2_equiv_dihedral4
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (S2 : Sylow 2 G) :
    Nonempty ((S2 : Subgroup G) ≃* DihedralGroup 4) := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have hS8 : Nat.card (c.S : Subgroup G) = 8 := firstCase_klein_S_card hmin c hfirst hklein
  have hm2 : c.m = 2 := by
    have hScard : Nat.card (c.S : Subgroup G) = 2 * 2 ^ c.m := by
      obtain ⟨e⟩ := c.dihedralEquiv
      simpa using (Nat.card_congr e.toEquiv).trans DihedralGroup.nat_card
    have h8 := firstCase_klein_S_card hmin c hfirst hklein
    have hmul : 2 * 2 ^ c.m = 2 * 4 := by
      calc
        2 * 2 ^ c.m = Nat.card (c.S : Subgroup G) := hScard.symm
        _ = 8 := h8
        _ = 2 * 4 := by norm_num
    have hmPow : 2 ^ c.m = 4 := Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 2) hmul
    apply (Nat.pow_right_injective (a := 2) (by norm_num : 2 ≤ 2))
    simpa using hmPow
  obtain ⟨eS⟩ := c.dihedralEquiv
  have eS' : c.S ≃* DihedralGroup 4 := by
    rw [hm2] at eS
    norm_num at eS
    exact eS
  exact ⟨(Sylow.equiv S2 c.S).trans eS'⟩

/-- In the first case, the normalizer of a Sylow 3-subgroup has index `70`
(the number of Sylow 3-subgroups). -/
public theorem firstCase_sylow3_normalizer_index
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) :
    (Subgroup.normalizer (P : Set G)).index = 70 := by
  classical
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact P.card_eq_index_normalizer.symm.trans (firstCase_sylow3_count hmin c hfirst d)

/-- A simple group of order `2520` has no subgroup of index two. -/
private theorem index_ne_two_of_simple_of_card
    {G : Type u} [Group G] [Finite G]
    (hsimple : IsSimpleGroup G)
    (hGcard : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7)
    {H : Subgroup G} (hHindex : H.index = 2) : False := by
  classical
  have hn : H.Normal := Subgroup.normal_of_index_eq_two hHindex
  rcases hn.eq_bot_or_eq_top with hbot | htop
  · have hmul := H.index_mul_card
    rw [hHindex, hbot, hGcard] at hmul
    simp at hmul
  · rw [htop] at hHindex
    simp at hHindex

/-- A simple group of order `2520` has no subgroup of index five: the coset
action would embed it into `S₅`, whose order is too small. -/
private theorem index_ne_five_of_simple_of_card
    {G : Type u} [Group G] [Finite G]
    (hsimple : IsSimpleGroup G)
    (hGcard : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7)
    {H : Subgroup G} (hHindex : H.index = 5) : False := by
  classical
  have hHne : H ≠ ⊤ := by
    intro htop
    rw [htop] at hHindex
    simp at hHindex
  have hcore : H.normalCore = ⊥ := by
    have hle : H.normalCore ≤ H := H.normalCore_le
    rcases H.normalCore_normal.eq_bot_or_eq_top with hbot | htop
    · exact hbot
    · exfalso
      apply hHne
      exact le_antisymm le_top (htop.symm ▸ hle)
  let act : G →* Equiv.Perm (G ⧸ H) := MulAction.toPermHom G (G ⧸ H)
  have hactInj : Function.Injective act := by
    rw [← MonoidHom.ker_eq_bot_iff]
    rw [← H.normalCore_eq_ker]
    exact hcore
  have hperm : Nat.card (Equiv.Perm (G ⧸ H)) = 120 := by
    rw [Nat.card_perm]
    have hq : Nat.card (G ⧸ H) = 5 := by
      rw [← Subgroup.index_eq_card]
      exact hHindex
    rw [hq]
    norm_num
  have hle : Nat.card G ≤ 120 := by
    simpa [hperm] using (Nat.card_le_card_of_injective act hactInj)
  omega

/-- In the first case, `G` has no subgroup of index two. -/
public theorem firstCase_index_ne_two
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (d : FirstCaseCountData c)
    {H : Subgroup G} (hHindex : H.index = 2) : False := by
  exact index_ne_two_of_simple_of_card (minimalCounterexample_isSimple hmin)
    (firstCase_index_card_of_countData c d).2 hHindex

/-- In the first case, `G` has no subgroup of index five. -/
public theorem firstCase_index_ne_five
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (d : FirstCaseCountData c)
    {H : Subgroup G} (hHindex : H.index = 5) : False := by
  exact index_ne_five_of_simple_of_card (minimalCounterexample_isSimple hmin)
    (firstCase_index_card_of_countData c d).2 hHindex

/-- A divisor of `35` is one of `1, 5, 7, 35`. -/
private lemma divisor_of_35 {k : ℕ} (hk : k ∣ 35) (hk0 : k ≠ 0) :
    k = 1 ∨ k = 5 ∨ k = 7 ∨ k = 35 := by
  have hkpos : 0 < k := Nat.pos_of_dvd_of_pos hk (by norm_num)
  have hkle : k ≤ 35 := Nat.le_of_dvd (by norm_num) hk
  interval_cases k <;> omega

/-- The join of a Sylow 3-subgroup of order nine with a Sylow 2-subgroup of
order eight has index seven, provided it is a proper subgroup not of order
`72`: its order is a common multiple of `9` and `8` dividing `|G|`, so it
is one of `72, 360, 504, 2520`; indices `2` and `5` are impossible for a
simple group of order `2520`, and the two hypotheses exclude `72` and
`2520`. -/
private theorem index_seven_of_join
    {G : Type u} [Group G] [Finite G]
    (hGcard : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7)
    (hsimple : IsSimpleGroup G)
    (P : Sylow 3 G)
    (hP9 : Nat.card P = 9)
    (S2 : Sylow 2 G)
    (hS8 : Nat.card S2 = 8)
    (H : Subgroup G)
    (hPleH : (P : Subgroup G) ≤ H) (hSleH : (S2 : Subgroup G) ≤ H)
    (hHne : H ≠ ⊤) (hH72 : Nat.card ↥H ≠ 72) :
    H.index = 7 := by
  classical
  have h9dvd : 9 ∣ Nat.card ↥H := by
    simpa [hP9] using (Subgroup.card_dvd_of_le hPleH)
  have h8dvd : 8 ∣ Nat.card ↥H := by
    simpa [hS8] using (Subgroup.card_dvd_of_le hSleH)
  have h72dvd : 72 ∣ Nat.card ↥H := by
    have hcop : Nat.Coprime 9 8 := by norm_num
    convert hcop.mul_dvd_of_dvd_of_dvd h9dvd h8dvd using 1
  have hGdvd : Nat.card ↥H ∣ Nat.card G := by
    simpa using (Subgroup.card_dvd_of_le (le_top : H ≤ ⊤))
  obtain ⟨k, hk⟩ := h72dvd
  have hk35 : k ∣ 35 := by
    have hd : 72 * k ∣ 2 ^ 3 * 3 ^ 2 * 5 * 7 := by
      simpa [hk] using hGdvd.trans (by rw [hGcard]; rfl)
    rw [show (2 ^ 3 * 3 ^ 2 * 5 * 7 : ℕ) = 72 * 35 by norm_num] at hd
    exact (Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 72)).mp hd
  have hposH : 0 < Nat.card ↥H := Nat.card_pos
  have hk0 : k ≠ 0 := by
    intro hk0
    omega
  have hHidx1 : H.index ≠ 1 := (Subgroup.index_eq_one.not).mpr hHne
  rcases divisor_of_35 hk35 hk0 with rfl | rfl | rfl | rfl
  · -- k = 1: `|H| = 72`
    have hk1 : Nat.card ↥H = 72 := by simpa using hk
    exfalso
    exact hH72 hk1
  · -- k = 5: `|H| = 360`, index seven
    have hm := H.index_mul_card
    rw [hk, hGcard] at hm
    norm_num at hm
    exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 360) (by
      rw [mul_comm 360 H.index, mul_comm 360 7]
      simpa using hm)
  · -- k = 7: `|H| = 504`, index five
    exfalso
    have hm := H.index_mul_card
    rw [hk, hGcard] at hm
    norm_num at hm
    have hind : H.index = 5 :=
      Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 504) (by
        rw [mul_comm 504 H.index, mul_comm 504 5]
        simpa using hm)
    exact index_ne_five_of_simple_of_card hsimple hGcard hind
  · -- k = 35: `H = G`
    have hm := H.index_mul_card
    rw [hk, hGcard] at hm
    norm_num at hm
    have hind : H.index = 1 :=
      Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 2520) (by
        rw [mul_comm 2520 H.index, mul_comm 2520 1]
        simpa using hm)
    exfalso
    exact hHidx1 hind

/-- In the first case every Sylow 2-subgroup has order eight. -/
private lemma factorization_2520_two : (2 ^ 3 * 3 ^ 2 * 5 * 7 : ℕ).factorization 2 = 3 := by
  rw [show (2 ^ 3 * 3 ^ 2 * 5 * 7 : ℕ) = 2 ^ 3 * (3 ^ 2 * 5 * 7) by ring]
  rw [Nat.factorization_mul (by norm_num) (by norm_num)]
  rw [Nat.factorization_pow]
  simp [Nat.prime_two.factorization_self]
  exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (3 ^ 2 * 5 * 7 : ℕ))

/-- In the first case every Sylow 2-subgroup has order eight. -/
public theorem firstCase_sylow2_card_eight
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) (d : FirstCaseCountData c) :
    ∀ S : Sylow 2 G, Nat.card S = 8 := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro S
  rcases firstCase_index_card_of_countData c d with ⟨_, hGcard⟩
  have hS := S.card_eq_multiplicity
  rw [hGcard] at hS
  rw [factorization_2520_two] at hS
  norm_num at hS
  exact hS

/-- The normalizer of a Sylow 3-subgroup has order `36 = [G : N_G(P)]⁻¹ · |G|`. -/
public theorem firstCase_normalizer_sylow3_card
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) :
    Nat.card ↥(Subgroup.normalizer (P : Set G)) = 36 := by
  classical
  have hind := firstCase_sylow3_normalizer_index hmin c hfirst d P
  have hm := (Subgroup.normalizer (P : Set G)).index_mul_card
  rw [hind, (firstCase_index_card_of_countData c d).2] at hm
  norm_num at hm
  have hm' : 70 * Nat.card ↥(Subgroup.normalizer (P : Set G)) = 70 * 36 := by
    rw [hm]
  exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 70) hm'

/-- `N_G(P)` is generated by `P` together with any Sylow 2-subgroup of
`N_G(P)`. -/
public theorem firstCase_normalizer_sylow3_sup_sylow2
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      NP = (P : Subgroup G) ⊔ ((T2 : Subgroup (↥NP)).map NP.subtype) := by
  classical
  intro NP T2
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hNPcard : Nat.card ↥NP = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
  have hfac : (36 : ℕ).factorization 2 = 2 := by
    rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
    rw [Nat.factorization_mul (by norm_num) (by norm_num)]
    rw [Nat.factorization_pow]
    simp [Nat.prime_two.factorization_self]
    exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
  have hT2card : Nat.card T2 = 4 := by
    have hT := T2.card_eq_multiplicity
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    exact hT
  have hTgcard : Nat.card Tg = 4 := by
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT2card
  have hTgN : Tg ≤ NP := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    exact y.2
  have hTgNorm : Tg ≤ Subgroup.normalizer (P : Set G) := by
    simpa [NP] using hTgN
  have hdisj : Disjoint (P : Subgroup G) Tg := by
    have hcop : Nat.Coprime 9 4 := by norm_num
    exact Subgroup.disjoint_of_coprime_natCard (by simpa [hP9, hTgcard] using hcop)
  have hsupcard : Nat.card ((P : Subgroup G) ⊔ Tg : Subgroup G) = 36 := by
    rw [card_sup_eq_mul_of_disjoint_of_le_normalizer (P : Subgroup G) Tg hTgNorm hdisj]
    rw [hP9, hTgcard]
  exact (Subgroup.eq_of_le_of_card_ge (H := (P : Subgroup G) ⊔ Tg) (K := NP)
    (sup_le (P : Subgroup G).le_normalizer hTgN)
    (by rw [hNPcard]; exact hsupcard.ge)).symm

/-- If a subgroup `H` contains a Sylow 3-subgroup `P` and its normalizer
`N_G(P)`, then the number of Sylow 3-subgroups of `H` is the relative index
`[N_G(P) : N_G(P) ∩ H] = N_G(P).relIndex H`. -/
private lemma sylow3_count_eq_relIndex
    {G : Type u} [Group G] [Finite G]
    (H : Subgroup G)
    (P : Sylow 3 G) (hPleH : (P : Subgroup G) ≤ H) :
    Nat.card (Sylow 3 (↥H)) =
      (Subgroup.normalizer (((P : Subgroup G) : Set G))).relIndex H := by
  classical
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let Q : Sylow 3 (↥H) := P.subtype hPleH
  have hQ : (Q : Subgroup (↥H)) = (P : Subgroup G).subgroupOf H := by
    exact Sylow.coe_subtype P hPleH
  have hQset : (Q : Set (↥H)) = (((P : Subgroup G).subgroupOf H) : Set (↥H)) := by
    exact congrArg (fun S : Subgroup (↥H) => (S : Set (↥H))) hQ
  have hnorm : Subgroup.normalizer (Q : Set (↥H)) =
      (Subgroup.normalizer (((P : Subgroup G) : Set G))).subgroupOf H := by
    ext x
    rw [Subgroup.mem_subgroupOf]
    rw [hQset]
    rw [Subgroup.mem_normalizer_iff]
    have hmemP : (x : G) ∈ Subgroup.normalizer (((P : Subgroup G) : Set G)) ↔
        ∀ g : G, g ∈ (P : Subgroup G) ↔ (x : G) * g * (x : G)⁻¹ ∈ (P : Subgroup G) :=
      Subgroup.mem_normalizer_iff
    rw [hmemP]
    constructor
    · intro hx g
      constructor
      · intro hgP
        have hx' := hx (⟨g, hPleH hgP⟩ : ↥H)
        have hleft : (⟨g, hPleH hgP⟩ : ↥H) ∈ (P : Subgroup G).subgroupOf H := by
          rw [Subgroup.mem_subgroupOf]
          exact hgP
        have hz : x * (⟨g, hPleH hgP⟩ : ↥H) * x⁻¹ ∈ (P : Subgroup G).subgroupOf H :=
          hx'.mp hleft
        rw [Subgroup.mem_subgroupOf] at hz
        change (x : G) * g * (x : G)⁻¹ ∈ P
        exact hz
      · intro hg'
        have hgH : g ∈ H := by
          have hxmem : (x : G) ∈ H := x.2
          have hxg : (x : G) * g * (x : G)⁻¹ ∈ H := hPleH hg'
          have hg_eq : g = (x : G)⁻¹ * ((x : G) * g * (x : G)⁻¹) * (x : G) := by
            group
          rw [hg_eq]
          exact H.mul_mem (H.mul_mem (H.inv_mem hxmem) hxg) x.2
        have hx' := hx (⟨g, hgH⟩ : ↥H)
        have hright : x * (⟨g, hgH⟩ : ↥H) * x⁻¹ ∈ (P : Subgroup G).subgroupOf H := by
          rw [Subgroup.mem_subgroupOf]
          change (x : G) * g * (x : G)⁻¹ ∈ P
          exact hg'
        have hz : (⟨g, hgH⟩ : ↥H) ∈ (P : Subgroup G).subgroupOf H := hx'.mpr hright
        rw [Subgroup.mem_subgroupOf] at hz
        exact hz
    · intro hxR h
      constructor
      · intro hh
        rw [Subgroup.mem_subgroupOf] at hh ⊢
        simpa using ((hxR (h : G)).mp hh)
      · intro hh
        rw [Subgroup.mem_subgroupOf] at hh ⊢
        simpa using ((hxR (h : G)).mpr hh)
  have hcard := Q.card_eq_index_normalizer
  rw [hnorm] at hcard
  change Nat.card (Sylow 3 (↥H)) =
    (Subgroup.normalizer (((P : Subgroup G) : Set G))).relIndex H
  exact hcard

/-- If `H` contains `P` and `N_G(P)`, then `|H| ≠ 72`: otherwise
`[H : N_G(P)] = 2`, so `n₃(H) = 2`, contradicting `n₃(H) ≡ 1 [MOD 3]`. -/
private theorem card_ne_seventy_two_of_normalizer_le
    {G : Type u} [Group G] [Finite G]
    (hGcard : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7)
    (P : Sylow 3 G)
    (H : Subgroup G) (hPleH : (P : Subgroup G) ≤ H)
    (hNleH : Subgroup.normalizer (((P : Subgroup G) : Set G)) ≤ H)
    (hNindex : (Subgroup.normalizer (((P : Subgroup G) : Set G))).index = 70) :
    Nat.card ↥H ≠ 72 := by
  classical
  intro hH72
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hn3 := sylow3_count_eq_relIndex H P hPleH
  have hm := H.index_mul_card
  rw [hH72, hGcard] at hm
  norm_num at hm
  have hH35 : H.index = 35 :=
    Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 72) (by
      rw [mul_comm 72 H.index, mul_comm 72 35]
      simpa using hm)
  have hrel := Subgroup.relIndex_mul_index hNleH
  rw [hH35, hNindex] at hrel
  have hrel2 : (Subgroup.normalizer (((P : Subgroup G) : Set G))).relIndex H = 2 :=
    Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 35) (by
      rw [mul_comm 35 ((Subgroup.normalizer (((P : Subgroup G) : Set G))).relIndex H),
        mul_comm 35 2]
      simpa using hrel)
  have hmod := (card_sylow_modEq_one 3 (↥H) : Nat.card (Sylow 3 (↥H)) ≡ 1 [MOD 3])
  rw [hn3, hrel2] at hmod
  norm_num at hmod

/-- `T₂` normalizes the conjugate `Q = r P r⁻¹` for `r ∈ S₂ ∖ T₂`: the
dihedral structure of `S₂` gives `r T₂ r⁻¹ = T₂`, and then
`t (r p r⁻¹) t⁻¹ = r (t' p t'⁻¹) r⁻¹ ∈ Q` for `t' = r⁻¹ t r ∈ T₂`. -/

private lemma sylow2_mem_normalizer_conjugate
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤
      Subgroup.normalizer ((r • P : Sylow 3 G) : Set G) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hTg_le_S2 : Tg ≤ (S2 : Subgroup G) := hTgS2
  have hTg_index2 : ((Tg.subgroupOf (S2 : Subgroup G)).index = 2) := by
    have hm := (Tg.subgroupOf (S2 : Subgroup G)).index_mul_card
    change (Tg.subgroupOf (S2 : Subgroup G)).index *
        Nat.card {x : ↥(S2 : Subgroup G) // x ∈ Tg.subgroupOf (S2 : Subgroup G)} =
      Nat.card (↥(S2 : Subgroup G)) at hm
    have hsub : Nat.card ↥(Tg.subgroupOf (S2 : Subgroup G)) = Nat.card Tg := by
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hTg_le_S2).toEquiv
    rw [hsub, hTgcard, hS2card] at hm
    exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 4) (by
      rw [mul_comm 4 ((Tg.subgroupOf (S2 : Subgroup G)).index), mul_comm 4 2]
      simpa using hm)
  let S2Tg : Subgroup (↥(S2 : Subgroup G)) := Tg.subgroupOf (S2 : Subgroup G)
  have hS2Tg_normal : S2Tg.Normal := Subgroup.normal_of_index_eq_two hTg_index2
  have hr2Tg : r ^ 2 ∈ (Tg : Set G) := by
    have hmem : (⟨r, hrS2⟩ : ↥(S2 : Subgroup G)) ^ 2 ∈ S2Tg :=
      Subgroup.sq_mem_of_index_two hTg_index2 ⟨r, hrS2⟩
    exact Subgroup.mem_subgroupOf.mp hmem
  have hTg_conj_r : ∀ t : G, t ∈ (Tg : Set G) → r * t * r⁻¹ ∈ (Tg : Set G) := by
    intro t ht
    have hx : (⟨r, hrS2⟩ * ⟨t, hTg_le_S2 ht⟩ * ⟨r, hrS2⟩⁻¹ : ↥(S2 : Subgroup G)) ∈ S2Tg :=
      hS2Tg_normal.conj_mem ⟨t, hTg_le_S2 ht⟩ (Subgroup.mem_subgroupOf.mpr ht) ⟨r, hrS2⟩
    simpa using (Subgroup.mem_subgroupOf.mp hx)
  have hTg_conj_r_inv : ∀ t : G, t ∈ (Tg : Set G) → r⁻¹ * t * r ∈ (Tg : Set G) := by
    intro t ht
    have hmap_le : Tg.map (MulAut.conj r) ≤ Tg := by
      intro x hx
      rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
      change r * y * r⁻¹ ∈ (Tg : Set G)
      exact hTg_conj_r y hy
    have hmap_card : Nat.card (Tg.map (MulAut.conj r) : Subgroup G) = Nat.card Tg := by
      exact (Nat.card_congr (Subgroup.equivMapOfInjective Tg (MulAut.conj r).toMonoidHom
        (MulAut.conj r).injective).toEquiv).symm
    have hmap_eq : Tg.map (MulAut.conj r) = Tg := by
      apply Subgroup.eq_of_le_of_card_ge hmap_le
      rw [hmap_card]
    have ht' : t ∈ Tg.map (MulAut.conj r) := by
      rw [hmap_eq]
      exact ht
    rcases Subgroup.mem_map.mp ht' with ⟨s, hs, hseq⟩
    change MulAut.conj r s = t at hseq
    simp [MulAut.conj_apply] at hseq
    rw [← hseq]
    have hred : r⁻¹ * (r * s * r⁻¹) * r = s := by group
    rwa [hred]
  let Q : Sylow 3 G := r • P
  have hQ : (Q : Subgroup G) = conjugateSubgroup (P : Subgroup G) r := by
    rw [Sylow.coe_subgroup_smul]
    rfl
  have hTgNP : Tg ≤ Subgroup.normalizer (P : Set G) := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  intro t ht
  rw [Subgroup.mem_set_normalizer_iff]
  intro q
  constructor
  · intro hq
    change q ∈ ((Q : Subgroup G) : Set G) at hq
    rw [hQ] at hq
    rcases (Subgroup.mem_map.mp hq) with ⟨p, hp, hqeq⟩
    simp [MulAut.conj_apply] at hqeq
    have ht' : ∃ t' : G, t' ∈ Tg ∧ t * r = r * t' := by
      have htr : r⁻¹ * t * r ∈ Tg := hTg_conj_r_inv t ht
      refine ⟨r⁻¹ * t * r, htr, ?_⟩
      group
    rcases ht' with ⟨t', ht', hteq⟩
    change t * q * t⁻¹ ∈ ((Q : Subgroup G) : Set G)
    rw [hQ]
    rw [conjugateSubgroup]
    refine Subgroup.mem_map.mpr ⟨t' * p * t'⁻¹, ?_, ?_⟩
    · exact (Subgroup.mem_set_normalizer_iff.mp (hTgNP ht') p).1 hp
    · change MulAut.conj r (t' * p * t'⁻¹) = t * q * t⁻¹
      simp [MulAut.conj_apply]
      rw [← hqeq]
      have htr' : t = r * t' * r⁻¹ := by
        calc
          t = t * r * r⁻¹ := by group
          _ = r * t' * r⁻¹ := by rw [hteq]
      rw [htr']
      group
  · intro hq
    change t * q * t⁻¹ ∈ ((Q : Subgroup G) : Set G) at hq
    rw [hQ] at hq
    rcases (Subgroup.mem_map.mp hq) with ⟨p, hp, hqeq⟩
    simp [MulAut.conj_apply] at hqeq
    have ht' : ∃ t' : G, t' ∈ Tg ∧ t * r = r * t' := by
      have htr : r⁻¹ * t * r ∈ Tg := hTg_conj_r_inv t ht
      refine ⟨r⁻¹ * t * r, htr, ?_⟩
      group
    rcases ht' with ⟨t', ht', hteq⟩
    have hq' : q = t⁻¹ * (r * p * r⁻¹) * t := by
      calc
        q = t⁻¹ * (t * q * t⁻¹) * t := by group
        _ = t⁻¹ * (r * p * r⁻¹) * t := by rw [hqeq]
    change q ∈ ((Q : Subgroup G) : Set G)
    rw [hQ]
    rw [conjugateSubgroup]
    refine Subgroup.mem_map.mpr ⟨t'⁻¹ * p * t', ?_, ?_⟩
    · have ht'i : t'⁻¹ ∈ (Tg : Set G) := Tg.inv_mem ht'
      have hmem : t'⁻¹ * p * (t'⁻¹)⁻¹ ∈ (P : Set G) :=
        (Subgroup.mem_set_normalizer_iff.mp (hTgNP ht'i) p).1 hp
      have hred : t'⁻¹ * p * (t'⁻¹)⁻¹ = t'⁻¹ * p * t' := by group
      rw [← hred]
      exact hmem
    · change MulAut.conj r (t'⁻¹ * p * t') = q
      simp [MulAut.conj_apply]
      rw [hq']
      have htr' : t = r * t' * r⁻¹ := by
        calc
          t = t * r * r⁻¹ := by group
          _ = r * t' * r⁻¹ := by rw [hteq]
      rw [htr']
      group

/-- The normalizer of the conjugate `Q = r P r⁻¹` is the join `Q · T₂`:
by `sylow2_mem_normalizer_conjugate` the join lies in the normalizer, and
both have order `36`. -/
private lemma normalizer_conjugate_eq_join
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    Subgroup.normalizer ((r • P : Sylow 3 G) : Set G) =
      ((r • P : Sylow 3 G) : Subgroup G) ⊔
        ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
          (Subgroup.normalizer (P : Set G)).subtype) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  let Q : Sylow 3 G := r • P
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTgQ : Tg ≤ Subgroup.normalizer (Q : Set G) := by
    simpa [NP, Tg, Q] using sylow2_mem_normalizer_conjugate hmin c hfirst d P T2 S2 r
      hrS2 hrTg hTgS2
  have hP9 : Nat.card (Q : Subgroup G) = 9 := by
    have h := firstCase_sylow3_card_nine c d Q
    simpa using h
  have hdisj : Disjoint (Q : Subgroup G) Tg := by
    have hcop : Nat.Coprime 9 4 := by norm_num
    exact Subgroup.disjoint_of_coprime_natCard (by simpa [hP9, hTgcard] using hcop)
  have hQTg_card : Nat.card ((Q : Subgroup G) ⊔ Tg : Subgroup G) = 36 := by
    rw [card_sup_eq_mul_of_disjoint_of_le_normalizer (Q : Subgroup G) Tg hTgQ hdisj]
    rw [hP9, hTgcard]
  have hNGQcard : Nat.card ↥(Subgroup.normalizer (Q : Set G)) = 36 := by
    exact firstCase_normalizer_sylow3_card hmin c hfirst d Q
  exact (Subgroup.eq_of_le_of_card_ge (H := (Q : Subgroup G) ⊔ Tg)
    (K := Subgroup.normalizer (Q : Set G))
    (sup_le (Subgroup.le_normalizer (H := (Q : Subgroup G))) hTgQ)
    (by rw [hNGQcard]; exact hQTg_card.ge)).symm

/-- The order-three word identity behind the double-coset core: if
`(r · p)³ = 1`, then `r p r⁻¹ = p⁻¹ · r · ((r²)⁻¹ · p⁻¹ · (r²)⁻¹)`, so the
nonidentity `q = r p r⁻¹` lies in `P · r · N_G(P)` once `r²` lies in the
normalizer of `P`. -/
private lemma doubleCoset_word_identity_order3
    {G : Type u} [Group G] (r p : G) (hrp3 : (r * p) ^ 3 = 1) :
    r * p * r⁻¹ = p⁻¹ * r * ((r ^ 2)⁻¹ * p⁻¹ * (r ^ 2)⁻¹) := by
  have hrpr : r * p * r = p⁻¹ * r⁻¹ * p⁻¹ := by
    have hsq : (r * p) ^ 2 = (r * p)⁻¹ := by
      calc
        (r * p) ^ 2 = (r * p) * (r * p) := by rw [pow_two]
        _ = (r * p) ^ 3 * (r * p)⁻¹ := by
          rw [pow_three]
          group
        _ = (r * p)⁻¹ := by rw [hrp3]; simp
    calc
      r * p * r = (r * p) * (r * p) * p⁻¹ := by group
      _ = (r * p) ^ 2 * p⁻¹ := by rw [pow_two]
      _ = (r * p)⁻¹ * p⁻¹ := by rw [hsq]
      _ = p⁻¹ * r⁻¹ * p⁻¹ := by group
  calc
    r * p * r⁻¹ = (r * p * r) * (r ^ 2)⁻¹ := by group
    _ = (p⁻¹ * r⁻¹ * p⁻¹) * (r ^ 2)⁻¹ := by rw [hrpr]
    _ = p⁻¹ * r * ((r ^ 2)⁻¹ * p⁻¹ * (r ^ 2)⁻¹) := by group

/-- The order-four word identity behind the double-coset core: if
`r² = 1`, `p³ = 1` and `(r p)⁴ = 1`, then `r p r⁻¹ = p r p⁻¹ w` for
`w = r p (r p⁻¹)² p⁻¹`.  In the A₇ model `w` is the involution `t₂` of
`T₂` (the model word is `x1⁻¹ x2 (x1⁻¹ x2⁻¹)² x2⁻¹`, verified in
`/tmp/ident7.gap`); the remaining obligation is to prove `w ∈ N_G(P)`,
which then gives the order-four case of `q_mem_join_doubleCoset`. -/
private lemma doubleCoset_word_identity_order4
    {G : Type u} [Group G] (r p : G)
    (hr2 : r ^ 2 = 1) (hp3 : p ^ 3 = 1) (hrp4 : (r * p) ^ 4 = 1) :
    let w : G := r * p * (r * p⁻¹) ^ 2 * p⁻¹
    r * p * r⁻¹ = p * r * p⁻¹ * w := by
  intro w
  have hrinv : r⁻¹ = r := (inv_eq_iff_mul_eq_one.mpr (by simpa [pow_two] using hr2))
  have hrr : r * r = 1 := by simpa [pow_two] using hr2
  have hpp : p * p = p⁻¹ := by
    have h : p * (p * p) = 1 := by
      rw [← mul_assoc]
      rw [show p * p * p = p ^ 3 by rw [pow_succ, pow_two]]
      exact hp3
    exact (inv_eq_iff_mul_eq_one (a := p) (b := p * p)).mpr h |>.symm
  have hrp2 : (r * p) ^ 2 = p⁻¹ * r * p⁻¹ * r := by
    have hsq : (r * p) ^ 2 = ((r * p) ^ 2)⁻¹ :=
      (eq_inv_iff_mul_eq_one (a := (r * p) ^ 2) (b := (r * p) ^ 2)).mpr (by
        rw [← pow_add]
        rw [hrp4])
    calc
      (r * p) ^ 2 = ((r * p) ^ 2)⁻¹ := hsq
      _ = ((r * p)⁻¹) ^ 2 := by rw [← inv_pow]
      _ = (p⁻¹ * r) ^ 2 := by
        congr 1
        rw [mul_inv_rev, hrinv]
      _ = p⁻¹ * r * p⁻¹ * r := by rw [pow_two]; group
  have hq : r * p * r⁻¹ = p⁻¹ * r * p⁻¹ * r * p⁻¹ := by
    calc
      r * p * r⁻¹ = r * p * r := by rw [hrinv]
      _ = (r * p) ^ 2 * p⁻¹ := by rw [pow_two]; group
      _ = (p⁻¹ * r * p⁻¹ * r) * p⁻¹ := by rw [hrp2]
      _ = p⁻¹ * r * p⁻¹ * r * p⁻¹ := by group
  have hpr2 : p * r * p * r = r * p⁻¹ * r * p⁻¹ := by
    have h4 : (p * r) ^ 4 = 1 := by
      calc
        (p * r) ^ 4 = p * ((r * p) ^ 4) * p⁻¹ := by
          rw [pow_succ, pow_succ, pow_succ, pow_one]
          rw [pow_succ, pow_succ, pow_succ, pow_one]
          group
        _ = p * 1 * p⁻¹ := by rw [hrp4]
        _ = 1 := by group
    have hsq : (p * r) ^ 2 = ((p * r) ^ 2)⁻¹ :=
      (eq_inv_iff_mul_eq_one (a := (p * r) ^ 2) (b := (p * r) ^ 2)).mpr (by
        rw [← pow_add]
        rw [h4])
    calc
      p * r * p * r = (p * r) ^ 2 := by rw [pow_two]; group
      _ = ((p * r) ^ 2)⁻¹ := hsq
      _ = ((p * r)⁻¹) ^ 2 := by rw [← inv_pow]
      _ = (r * p⁻¹) ^ 2 := by
        congr 1
        rw [mul_inv_rev, hrinv]
      _ = r * p⁻¹ * r * p⁻¹ := by rw [pow_two]; group
  rw [hq]
  dsimp [w]
  rw [pow_two]
  have hpr2' : (r * p⁻¹) * (r * p⁻¹) = p * r * p * r := by
    simpa [mul_assoc] using hpr2.symm
  rw [hpr2']
  symm
  calc
    p * r * p⁻¹ * (r * p * (p * r * p * r) * p⁻¹) =
        p * r * p⁻¹ * (r * (p * p) * (r * p * r)) * p⁻¹ := by
      have hinner : r * p * (p * r * p * r) = r * (p * p) * (r * p * r) := by group
      rw [hinner]
      group
    _ = p * r * p⁻¹ * (r * p⁻¹ * (r * p * r)) * p⁻¹ := by
      rw [hpp]
    _ = p * (r * p⁻¹ * r * p⁻¹) * (r * p * r) * p⁻¹ := by group
    _ = p * (p * r * p * r) * (r * p * r) * p⁻¹ := by
      rw [hpr2.symm]
    _ = (p * p) * (r * p) * (r * r) * (p * r) * p⁻¹ := by group
    _ = p⁻¹ * (r * p) * (r * r) * (p * r) * p⁻¹ := by rw [hpp]
    _ = p⁻¹ * (r * p) * (p * r) * p⁻¹ := by
      rw [hrr]
      simp
    _ = (p⁻¹ * r) * (p * p) * (r * p⁻¹) := by group
    _ = (p⁻¹ * r) * p⁻¹ * (r * p⁻¹) := by rw [hpp]
    _ = p⁻¹ * r * p⁻¹ * r * p⁻¹ := by group

/-- The order-five word identity behind the double-coset core: in the
`(2,3,5)`-generated subgroup (`A₅` when `p³ = 1`), `(r p)⁵ = 1` and
`r² = 1` give `r p r⁻¹ = (p⁻¹ r)³ p⁻¹`.  The remaining step for the
order-five case of `q_mem_join_doubleCoset` is to rewrite this word into
`N·r·N` using the `T₂`-action (`a p a⁻¹` / `a⁻¹ p a` factorizations,
GAP-verified in `/tmp/model_o5.gap`). -/
private lemma doubleCoset_word_identity_order5
    {G : Type u} [Group G] (r p : G)
    (hr2 : r ^ 2 = 1) (hrp5 : (r * p) ^ 5 = 1) :
    r * p * r⁻¹ = (p⁻¹ * r) ^ 3 * p⁻¹ := by
  have hrinv : r⁻¹ = r := (inv_eq_iff_mul_eq_one.mpr (by simpa [pow_two] using hr2))
  have hrp_inv : (r * p)⁻¹ = p⁻¹ * r := by
    rw [mul_inv_rev, hrinv]
  have hrp2 : (r * p) ^ 2 = (p⁻¹ * r) ^ 3 := by
    have h23 : (r * p) ^ 2 * (r * p) ^ 3 = 1 := by
      calc
        (r * p) ^ 2 * (r * p) ^ 3 = (r * p) ^ (2 + 3) := by rw [← pow_add]
        _ = (r * p) ^ 5 := by norm_num
        _ = 1 := hrp5
    have h : (r * p) ^ 2 = ((r * p) ^ 3)⁻¹ :=
      (eq_inv_iff_mul_eq_one.mpr h23)
    calc
      (r * p) ^ 2 = ((r * p) ^ 3)⁻¹ := h
      _ = ((r * p)⁻¹) ^ 3 := by rw [← inv_pow]
      _ = (p⁻¹ * r) ^ 3 := by rw [hrp_inv]
  calc
    r * p * r⁻¹ = r * p * r := by rw [hrinv]
    _ = (r * p) ^ 2 * p⁻¹ := by
      rw [pow_two]
      group
    _ = (p⁻¹ * r) ^ 3 * p⁻¹ := by rw [hrp2]

/-- An involution in `S₂ ∖ T₂`: after transporting to `D₈`, an
order-four subgroup cannot contain all four reflections. -/
private lemma exists_sylow2_not_mem_sylow2_normalizer
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    ∃ r : G, IsInvolution r ∧ r ∈ (S2 : Subgroup G) ∧
      r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
        (Subgroup.normalizer (P : Set G)).subtype) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  rcases sylow2_equiv_dihedral4 hmin c hfirst d S2 with ⟨e⟩
  let TgS : Subgroup ↥(S2 : Subgroup G) := Tg.subgroupOf (S2 : Subgroup G)
  let A : Subgroup (DihedralGroup 4) := TgS.map e.toMonoidHom
  have hTgScard : Nat.card TgS = 4 := by
    exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hTgS2).toEquiv).trans hTgcard
  have hAcard : Nat.card A = 4 := by
    exact (Nat.card_congr
      (Subgroup.equivMapOfInjective TgS e.toMonoidHom e.injective).toEquiv).symm.trans
      hTgScard
  rcases d8_exists_involution_not_mem_card_four A hAcard with ⟨x, hxI, hxA⟩
  let rS : ↥(S2 : Subgroup G) := e.symm x
  let r : G := rS
  refine ⟨r, ?_, rS.2, ?_⟩
  · constructor
    · intro hr1
      apply hxI.1
      have hrS1 : rS = 1 := by
        apply Subtype.ext
        simpa [r] using hr1
      calc
        x = e rS := by simp [rS]
        _ = e 1 := congrArg e hrS1
        _ = 1 := map_one e
    · have hrS2 : rS ^ 2 = 1 := by
        apply e.injective
        simpa [rS] using hxI.2
      exact congrArg Subtype.val hrS2
  · intro hrTg
    apply hxA
    change x ∈ TgS.map e.toMonoidHom
    refine Subgroup.mem_map.mpr ⟨rS, ?_, ?_⟩
    · exact Subgroup.mem_subgroupOf.mpr hrTg
    · simp [rS]

/-- `r ∈ S₂ ∖ T₂` does not normalize `P`: otherwise `S₂ = ⟨T₂, r⟩ ≤ N_G(P)`
forces `8 ∣ 36`. -/
private lemma sylow2_reflection_not_mem_normalizer
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (r : G) (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype)) :
    r ∉ (Subgroup.normalizer (P : Set G) : Set G) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  intro hrN
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hjoin_le_S2 : (Tg : Subgroup G) ⊔ Subgroup.zpowers r ≤ (S2 : Subgroup G) := by
    exact sup_le hTgS2 (Subgroup.zpowers_le.mpr (by simpa using hrS2))
  have hjoin_card : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) = 8 := by
    have hdiv : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) ∣ 8 := by
      exact (Subgroup.card_dvd_of_le hjoin_le_S2).trans (by rw [hS2card])
    have hge : 4 ≤ Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := by
      let f : Tg → ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := fun y =>
        ⟨(y : G), Subgroup.mem_sup_left y.2⟩
      have hf_inj : Function.Injective f := by
        intro a b h
        apply Subtype.ext
        simpa [f] using congrArg Subtype.val h
      have hle := Nat.card_le_card_of_injective f hf_inj
      rwa [hTgcard] at hle
    have hgt : 4 < Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := by
      by_contra hle
      have hcard : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) = 4 := by
        have hle' : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) ≤ 4 := Nat.le_of_not_gt hle
        omega
      have hEq : (Tg : Subgroup G) ⊔ Subgroup.zpowers r = Tg := by
        exact (Subgroup.eq_of_le_of_card_ge (H := Tg)
          (K := (Tg : Subgroup G) ⊔ Subgroup.zpowers r) le_sup_left (by
            rw [hcard, hTgcard])).symm
      have hrTg' : r ∈ (Tg : Set G) := by
        have hrjoin : r ∈ (Tg : Subgroup G) ⊔ Subgroup.zpowers r :=
          Subgroup.mem_sup_right (Subgroup.mem_zpowers r)
        rwa [hEq] at hrjoin
      exact hrTg hrTg'
    rcases hdiv with ⟨m, hm⟩
    have hmle : m ≤ 8 := by
      have hd : m ∣ 8 := by
        rw [mul_comm] at hm
        exact ⟨Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r), hm⟩
      exact Nat.le_of_dvd (by norm_num : 0 < 8) hd
    interval_cases m <;> omega
  have hjoin_eq_S2 : (Tg : Subgroup G) ⊔ Subgroup.zpowers r = (S2 : Subgroup G) := by
    apply Subgroup.eq_of_le_of_card_ge (H := (Tg : Subgroup G) ⊔ Subgroup.zpowers r)
      (K := (S2 : Subgroup G)) hjoin_le_S2
    rw [hS2card]
    exact hjoin_card.ge
  have hS2leNP : (S2 : Subgroup G) ≤ NP := by
    have hle : (Tg : Subgroup G) ⊔ Subgroup.zpowers r ≤ NP :=
      sup_le hTgNP (Subgroup.zpowers_le.mpr (by simpa [NP] using hrN))
    rw [← hjoin_eq_S2]
    exact hle
  have h8dvd36 : 8 ∣ 36 := by
    have hd := Subgroup.card_dvd_of_le hS2leNP
    rw [hS2card, firstCase_normalizer_sylow3_card hmin c hfirst d P] at hd
    exact hd
  norm_num at h8dvd36

/-- `r² ∈ T₂` for `r ∈ S₂ ∖ T₂`: `T₂` has index two in `S₂`. -/
private lemma sylow2_reflection_sq_mem
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    r ^ 2 ∈ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hTg_index2 : ((Tg.subgroupOf (S2 : Subgroup G)).index = 2) := by
    have hm := (Tg.subgroupOf (S2 : Subgroup G)).index_mul_card
    change (Tg.subgroupOf (S2 : Subgroup G)).index *
        Nat.card {x : ↥(S2 : Subgroup G) // x ∈ Tg.subgroupOf (S2 : Subgroup G)} =
      Nat.card (↥(S2 : Subgroup G)) at hm
    have hsub : Nat.card ↥(Tg.subgroupOf (S2 : Subgroup G)) = Nat.card Tg := by
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hTgS2).toEquiv
    rw [hsub, hTgcard, hS2card] at hm
    exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 4) (by
      rw [mul_comm 4 ((Tg.subgroupOf (S2 : Subgroup G)).index), mul_comm 4 2]
      simpa using hm)
  have hmem : (⟨r, hrS2⟩ : ↥(S2 : Subgroup G)) ^ 2 ∈ Tg.subgroupOf (S2 : Subgroup G) :=
    Subgroup.sq_mem_of_index_two hTg_index2 ⟨r, hrS2⟩
  exact Subgroup.mem_subgroupOf.mp hmem

/-- The intersection of a Sylow 2-subgroup `S₂` containing `T₂` with the
normalizer of `P` is exactly `T₂`: it contains `T₂`, and a strictly larger
intersection would force `8 ∣ |N_G(P)| = 36`. -/
private lemma sylow2_inter_normalizer_eq_Tg
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    (S2 : Subgroup G) ⊓ Subgroup.normalizer (P : Set G) =
      (T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
        (Subgroup.normalizer (P : Set G)).subtype := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  let K : Subgroup G := (S2 : Subgroup G) ⊓ NP
  have hTg_le_K : Tg ≤ K := by
    intro x hx
    exact ⟨hTgS2 hx, hTgNP hx⟩
  have hKcard_dvd8 : Nat.card ↥K ∣ 8 := by
    exact (Subgroup.card_dvd_of_le (inf_le_left : K ≤ (S2 : Subgroup G))).trans
      (by rw [hS2card])
  have hKcard_ne8 : Nat.card ↥K ≠ 8 := by
    intro h8
    have hS2leNP : (S2 : Subgroup G) ≤ NP := by
      have hEq : K = (S2 : Subgroup G) := by
        apply Subgroup.eq_of_le_of_card_ge (H := K) (K := (S2 : Subgroup G))
          (inf_le_left : K ≤ (S2 : Subgroup G))
        rw [h8, hS2card]
      intro x hx
      rw [← hEq] at hx
      exact hx.2
    have h8dvd36 : 8 ∣ 36 := by
      have hd := Subgroup.card_dvd_of_le hS2leNP
      rw [hS2card, firstCase_normalizer_sylow3_card hmin c hfirst d P] at hd
      exact hd
    norm_num at h8dvd36
  have hKcard : Nat.card ↥K = 4 := by
    have hge : 4 ≤ Nat.card ↥K := by
      let f : Tg → ↥K := fun y => ⟨(y : G), hTg_le_K y.2⟩
      have hf_inj : Function.Injective f := by
        intro a b h
        apply Subtype.ext
        simpa [f] using congrArg Subtype.val h
      have hle := Nat.card_le_card_of_injective f hf_inj
      rwa [hTgcard] at hle
    rcases hKcard_dvd8 with ⟨m, hm⟩
    have hmle : m ≤ 8 := by
      rw [mul_comm] at hm
      exact Nat.le_of_dvd (by norm_num : 0 < 8) ⟨Nat.card ↥K, hm⟩
    interval_cases m <;> omega
  exact (Subgroup.eq_of_le_of_card_ge (H := Tg) (K := K) hTg_le_K (by
    rw [hKcard, hTgcard])).symm

/-- For `r ∈ S₂ ∖ T₂`, the fourth power of `r` is trivial: `S₂ ≃ D₈`, whose
elements all have order dividing four. -/
private lemma sylow2_reflection_pow_four
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (S2 : Sylow 2 G) (r : G) (hrS2 : r ∈ (S2 : Subgroup G)) :
    r ^ 4 = 1 := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rcases sylow2_equiv_dihedral4 hmin c hfirst d S2 with ⟨e⟩
  have hord : orderOf (e ⟨r, hrS2⟩) ∣ 4 := by
    rcases dihedralGroup_cases (e ⟨r, hrS2⟩) with ⟨i, hi⟩ | ⟨j, hj⟩
    · rw [hi]
      have hvals : i.val = 0 ∨ i.val = 1 ∨ i.val = 2 ∨ i.val = 3 := by
        have hlt : i.val < 4 := ZMod.val_lt i
        omega
      rcases hvals with h0 | h1 | h2 | h3
      · rw [← ZMod.natCast_zmod_val i, h0]
        rw [DihedralGroup.orderOf_r]
        norm_num
      · rw [← ZMod.natCast_zmod_val i, h1, DihedralGroup.orderOf_r]
        have hval : ZMod.val ((1 : ℕ) : ZMod 4) = 1 := by decide
        rw [hval]
        norm_num
      · rw [← ZMod.natCast_zmod_val i, h2, DihedralGroup.orderOf_r]
        have hval : ZMod.val ((2 : ℕ) : ZMod 4) = 2 := by decide
        rw [hval]
        norm_num
      · rw [← ZMod.natCast_zmod_val i, h3, DihedralGroup.orderOf_r]
        have hval : ZMod.val ((3 : ℕ) : ZMod 4) = 3 := by decide
        rw [hval]
        norm_num
    · rw [hj, DihedralGroup.orderOf_sr]
      norm_num
  have hord' : orderOf r ∣ 4 := by
    have h1 : orderOf (e ⟨r, hrS2⟩) = orderOf (⟨r, hrS2⟩ : ↥(S2 : Subgroup G)) :=
      orderOf_injective e.toMonoidHom e.injective (⟨r, hrS2⟩ : (S2 : Subgroup G))
    have h2 : orderOf r = orderOf (⟨r, hrS2⟩ : (S2 : Subgroup G)) :=
      orderOf_injective (S2 : Subgroup G).subtype (S2 : Subgroup G).subtype_injective
        (⟨r, hrS2⟩ : (S2 : Subgroup G))
    calc
      orderOf r = orderOf (⟨r, hrS2⟩ : (S2 : Subgroup G)) := h2
      _ = orderOf (e ⟨r, hrS2⟩) := h1.symm
      _ ∣ 4 := hord
  rw [orderOf_dvd_iff_pow_eq_one] at hord'
  exact hord'

/-- For two Sylow 3-subgroups with `|P| = 9` and `|N_G(Q)| = 36`, an element
of `P` normalizing `Q` lies in `Q` (any 3-subgroup of `N_G(Q)` lies in its
unique Sylow 3-subgroup `Q`). -/
private lemma sylow3_inter_normalizer_inter_eq_inter
    {G : Type u} [Group G] [Finite G]
    (P Q : Sylow 3 G)
    (hP9 : Nat.card (P : Subgroup G) = 9)
    (hQcard : Nat.card ↥(Subgroup.normalizer (Q : Set G)) = 36) :
    (P : Subgroup G) ⊓ Subgroup.normalizer (Q : Set G) = (P : Subgroup G) ⊓ (Q : Subgroup G) := by
  classical
  apply le_antisymm
  · intro x hx
    constructor
    · exact hx.1
    · by_cases hx1 : x = 1
      · simpa [hx1] using hx.1
      · let NQ : Subgroup G := Subgroup.normalizer (Q : Set G)
        have hQleNQ : (Q : Subgroup G) ≤ NQ := Subgroup.le_normalizer (H := (Q : Subgroup G))
        have hzle : Subgroup.zpowers x ≤ NQ := Subgroup.zpowers_le.mpr hx.2
        have hord : orderOf x = 3 ∨ orderOf x = 9 := by
          have hdvd := Subgroup.orderOf_dvd_natCard (P : Subgroup G) hx.1
          rw [hP9] at hdvd
          rcases hdvd with ⟨m, hm⟩
          have hne1 : orderOf x ≠ 1 := by
            intro h1
            exact hx1 (orderOf_eq_one_iff.mp h1)
          have hmle : m ≤ 9 := by
            rw [mul_comm] at hm
            exact Nat.le_of_dvd (by norm_num : 0 < 9) ⟨orderOf x, hm⟩
          interval_cases m <;> omega
        have hxp : IsPGroup 3 (Subgroup.zpowers x) := by
          rcases hord with h3 | h9
          · refine IsPGroup.of_card (n := 1) ?_
            rw [Nat.card_zpowers, h3]
            norm_num
          · refine IsPGroup.of_card (n := 2) ?_
            rw [Nat.card_zpowers, h9]
            norm_num
        let zxNQ : Subgroup (↥NQ) := (Subgroup.zpowers x).subgroupOf NQ
        have hzxNQp : IsPGroup 3 zxNQ := by
          exact hxp.of_equiv (Subgroup.subgroupOfEquivOfLe hzle).symm
        let Q' : Sylow 3 (↥NQ) := Q.subtype hQleNQ
        obtain ⟨R, hzxleR⟩ := IsPGroup.exists_le_sylow (P := zxNQ) hzxNQp
        have hRnormal : (R : Subgroup (↥NQ)) = (Q' : Subgroup (↥NQ)) := by
          let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
          obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (↥NQ) Q' R
          have hQ'normal : (Q' : Subgroup (↥NQ)).Normal := by
            have hsub : (Q' : Subgroup (↥NQ)) = (Q : Subgroup G).subgroupOf NQ := by
              exact Sylow.coe_subtype Q hQleNQ
            rw [hsub]
            exact (Subgroup.normal_subgroupOf_iff_le_normalizer hQleNQ).mpr (by
              simpa [NQ])
          let : (Q' : Subgroup (↥NQ)).Normal := hQ'normal
          have hgfix : g • Q' = Q' := Sylow.smul_eq_of_normal
          calc
            (R : Subgroup (↥NQ)) = (g • Q' : Sylow 3 (↥NQ)) := by rw [← hg]
            _ = (Q' : Subgroup (↥NQ)) := by rw [hgfix]
        have hxmem : (⟨x, hzle (Subgroup.mem_zpowers x)⟩ : ↥NQ) ∈ (R : Subgroup (↥NQ)) := by
          exact hzxleR (by
            rw [Subgroup.mem_subgroupOf]
            exact Subgroup.mem_zpowers x)
        have hxQ' : (⟨x, hzle (Subgroup.mem_zpowers x)⟩ : ↥NQ) ∈ (Q' : Subgroup (↥NQ)) := by
          simpa [hRnormal] using hxmem
        exact Subgroup.mem_subgroupOf.mp hxQ'
  · intro x hx
    exact ⟨hx.1, (Subgroup.le_normalizer (H := (Q : Subgroup G)) hx.2)⟩

/-- Every element of the join `H ⊔ K` is a product `h · k` when `K`
normalizes `H`: words in `H ∪ K` collapse using `k h = (k h k⁻¹) k`. -/
private lemma mem_sup_product
    {G : Type u} [Group G]
    (H K : Subgroup G) (hKnorm : K ≤ Subgroup.normalizer (H : Set G)) :
    ∀ x : G, x ∈ (H ⊔ K : Subgroup G) →
      ∃ h : G, h ∈ (H : Set G) ∧ ∃ k : G, k ∈ (K : Set G) ∧ x = h * k := by
  intro x hx
  have hxcl : x ∈ Subgroup.closure ((H : Set G) ∪ (K : Set G)) := by
    rwa [← Subgroup.sup_eq_closure H K]
  refine Subgroup.closure_induction (k := (H : Set G) ∪ (K : Set G))
    (p := fun y _ => ∃ h : G, h ∈ (H : Set G) ∧ ∃ k : G, k ∈ (K : Set G) ∧ y = h * k)
    ?mem ?one ?mul ?inv hxcl
  · intro y hy
    rcases hy with hyH | hyK
    · exact ⟨y, hyH, 1, K.one_mem, by simp⟩
    · exact ⟨1, H.one_mem, y, hyK, by simp⟩
  · exact ⟨1, H.one_mem, 1, K.one_mem, by simp⟩
  · intro a b ha hb pa pb
    rcases pa with ⟨h1, hh1, k1, hk1, rfl⟩
    rcases pb with ⟨h2, hh2, k2, hk2, rfl⟩
    refine ⟨h1 * (k1 * h2 * k1⁻¹), ?_, k1 * k2, K.mul_mem hk1 hk2, ?_⟩
    · exact H.mul_mem hh1 ((Subgroup.mem_set_normalizer_iff.mp (hKnorm hk1) h2).1 hh2)
    · group
  · intro a ha pa
    rcases pa with ⟨h, hh, k, hk, rfl⟩
    refine ⟨k⁻¹ * h⁻¹ * k, ?_, k⁻¹, K.inv_mem hk, ?_⟩
    · simpa using (Subgroup.mem_set_normalizer_iff.mp (hKnorm (K.inv_mem hk)) h⁻¹).1
        (H.inv_mem hh)
    · group

/-- A Sylow 3-subgroup containing `U` centralizes `U` (groups of order
`p²` are commutative). -/
private lemma sylow3_le_centralizer_U
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    (P : Subgroup G) ≤ Subgroup.centralizer (c.U : Set G) := by
  intro p hp
  rw [Subgroup.mem_centralizer_iff]
  intro u hu
  have hP9' : Nat.card P = 3 ^ 2 := by
    simpa using firstCase_sylow3_card_nine c d P
  have : IsMulCommutative P :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9'
  exact (congrArg Subtype.val
    (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9').is_comm).comm
      ⟨p, hp⟩ ⟨u, hPU hu⟩)).symm

/-- A Sylow 3-subgroup containing `U` lies in `Ĥ = N_G(U)`. -/
private lemma sylow3_le_hhat
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    (P : Subgroup G) ≤ c.Hhat := by
  have hPleC := sylow3_le_centralizer_U c d P hPU
  have hCleN : Subgroup.centralizer (c.U : Set G) ≤ Subgroup.normalizer (c.U : Set G) := by
    intro x hx
    rw [Subgroup.mem_normalizer_iff]
    intro u
    rw [Subgroup.mem_centralizer_iff] at hx
    constructor
    · intro hu
      have hxu : x * u * x⁻¹ = u := by
        have hc := hx u hu
        calc
          x * u * x⁻¹ = u * x * x⁻¹ := by rw [hc]
          _ = u := by group
      simpa [hxu] using hu
    · intro hu
      have hxuv : x * (x * u * x⁻¹) = (x * u * x⁻¹) * x := (hx (x * u * x⁻¹) hu).symm
      have hxv' : (x * u * x⁻¹) * x⁻¹ = x⁻¹ * (x * u * x⁻¹) := by
        calc
          (x * u * x⁻¹) * x⁻¹ = x⁻¹ * (x * (x * u * x⁻¹)) * x⁻¹ := by group
          _ = x⁻¹ * ((x * u * x⁻¹) * x) * x⁻¹ := by rw [hxuv]
          _ = x⁻¹ * (x * u * x⁻¹) := by group
      have hxv : x⁻¹ * (x * u * x⁻¹) = (x * u * x⁻¹) * x⁻¹ := hxv'.symm
      have h_eq : u = x * u * x⁻¹ := by
        calc
          u = x⁻¹ * (x * u * x⁻¹) * x := by group
          _ = (x * u * x⁻¹) * x⁻¹ * x := by rw [hxv]
          _ = x * u * x⁻¹ := by group
      rw [h_eq]
      exact hu
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have hVK : IsKleinFour (twoCoreOf c.Hhat) := firstCase_klein_V_klein c hklein
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    intro hbot
    have hcard : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have hfour : Nat.card (twoCoreOf c.Hhat) = 4 := hVK.card_four
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNorm : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
  exact hPleC.trans (hCleN.trans (le_of_eq hNorm))

/-- `|Ĥ| = 72` from `[G : Ĥ] = 35` and `|G| = 2520`. -/
private lemma hhat_card
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) (d : FirstCaseCountData c) :
    Nat.card (↥c.Hhat) = 72 := by
  rcases firstCase_index_card_of_countData c d with ⟨hHidx, hGcard⟩
  have hm := c.Hhat.index_mul_card
  rw [hHidx, hGcard] at hm
  have hm' : 35 * Nat.card (↥c.Hhat) = 35 * 72 := by
    rw [hm]
    norm_num
  exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 35) (by
    exact hm')

/-- Every coset of `Ĥ` outside `Ĥ` contains at most four involutions.
This is the finite-support half of the Section-3 count: the restriction-(7)
data (`firstCase_klein_restriction_seven_data`) force the high coset fibers
to vanish, so a coset with `n ≥ 5` involutions would give
`|Jₙ| = n · bₙ ≠ 0`, contradicting `bₙ = 0`. -/
private theorem firstCase_coset_involution_le_four
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c)
    {y : G} (hy : IsInvolution y) (hyH : y ∉ c.Hhat) :
    firstCaseCosetInvolutions c y ≤ 4 := by
  classical
  have hklein : IsKleinFour (pCore 2 c.Hhat) :=
    firstCase_twoCore_isKleinFour hmin c hfirst
  have h7 := firstCase_klein_restriction_seven_data hmin c hfirst hklein
  have hvanish : ∀ n : ℕ, 5 ≤ n → cosetInvolution_b c.Hhat n = 0 :=
    firstCase_klein_high_fiber_vanish_of_n_eq_four hmin c hfirst hklein h7
  by_contra hgt
  have hn5 : 5 ≤ firstCaseCosetInvolutions c y := by omega
  have hcard : Nat.card (cosetInvolution_fiber c.Hhat
      (cosetInvolution_proj c.Hhat y)) = firstCaseCosetInvolutions c y := by
    exact (firstCase_coset_fiber_card_eq c hy).symm
  have hne : cosetInvolution_b c.Hhat (firstCaseCosetInvolutions c y) ≠ 0 := by
    intro hb0
    have hyJ : y ∈ firstCaseJ c (firstCaseCosetInvolutions c y) := by
      unfold firstCaseJ
      exact ⟨hy, ⟨hyH, by
        rw [firstCase_coset_fiber_card_eq c hy]⟩⟩
    have hJne : Nat.card {x : G // x ∈ firstCaseJ c (firstCaseCosetInvolutions c y)} ≠ 0 := by
      have : Nonempty {x : G // x ∈ firstCaseJ c (firstCaseCosetInvolutions c y)} :=
        ⟨⟨y, hyJ⟩⟩
      have hpos : 0 < Nat.card {x : G // x ∈
          firstCaseJ c (firstCaseCosetInvolutions c y)} := Nat.card_pos
      omega
    have hJcard : Nat.card {x : G // x ∈
        firstCaseJ c (firstCaseCosetInvolutions c y)} =
        firstCaseCosetInvolutions c y * cosetInvolution_b c.Hhat
          (firstCaseCosetInvolutions c y) :=
      firstCase_J_n_card c (firstCaseCosetInvolutions c y)
    rw [hJcard, hb0] at hJne
    norm_num at hJne
  exact hne (hvanish (firstCaseCosetInvolutions c y) hn5)

/-- The Sylow 2-subgroup of `N_G(P)` meets `Ĥ` in a subgroup of order two
(`|N_G(P) ∩ Ĥ| = 18` has a trivial 2-part beyond the involution, and a
trivial intersection would embed `T₂` into the quotient of order two). -/
public theorem firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      Nat.card ↥(((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat) = 2 := by
  classical
  intro NP T2
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgN : Tg ≤ NP := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    exact y.2
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hintercard : Nat.card ↥(Tg ⊓ c.Hhat) ∣ 18 := by
    have hle : Tg ⊓ c.Hhat ≤ NP ⊓ c.Hhat := inf_le_inf hTgN le_rfl
    exact (Subgroup.card_dvd_of_le hle).trans
      (by
        have hcard18' : Nat.card ↥(NP ⊓ c.Hhat) = 18 := by
          simpa [NP] using firstCase_normalizer_sylow3_inter_hhat_card hmin c hfirst d P hPU
        exact ⟨1, by rw [hcard18']; norm_num⟩)
  have hne_one : Nat.card ↥(Tg ⊓ c.Hhat) ≠ 1 := by
    intro hone
    have hdisj : Disjoint Tg (NP ⊓ c.Hhat) := by
      rw [disjoint_iff_inf_le]
      intro x hx
      have hx' : x ∈ Tg ⊓ c.Hhat := ⟨hx.1, hx.2.2⟩
      have hx1 : x = 1 := by
        -- subgroup of cardinal 1 is trivial
        have hbot : Tg ⊓ c.Hhat = ⊥ := Subgroup.eq_bot_of_card_eq (Tg ⊓ c.Hhat) hone
        rw [hbot] at hx'
        simpa using hx'
      simp [hx1]
    have hcard18' : Nat.card ↥(NP ⊓ c.Hhat) = 18 := by
      simpa [NP] using firstCase_normalizer_sylow3_inter_hhat_card hmin c hfirst d P hPU
    let f : (↥Tg) × ↥(NP ⊓ c.Hhat) → ↥NP := fun z =>
      ⟨(z.1 : G) * (z.2 : G), NP.mul_mem (hTgN z.1.2) z.2.2.1⟩
    have hf_inj : Function.Injective f := by
      intro a b h
      apply Subgroup.mul_injective_of_disjoint hdisj
      exact congrArg Subtype.val h
    have hle72 : 4 * 18 ≤ Nat.card (↥NP) := by
      have hle := Nat.card_le_card_of_injective f hf_inj
      rw [Nat.card_prod, hTg4, hcard18'] at hle
      norm_num at hle
      exact hle
    have hNP : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    omega
  have hdivides : Nat.card ↥(Tg ⊓ c.Hhat) ∣ 4 := by
    exact (Subgroup.card_dvd_of_le (inf_le_left : Tg ⊓ c.Hhat ≤ Tg)).trans (by
      rw [hTg4])
  have h2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    -- divides 18 and 4, not 1 → 2
    rcases hdivides with ⟨m, hm⟩
    have hmle : m ≤ 4 := by
      rw [mul_comm] at hm
      exact Nat.le_of_dvd (by norm_num : 0 < 4) ⟨Nat.card ↥(Tg ⊓ c.Hhat), hm⟩
    interval_cases m
    · norm_num at hm
    · norm_num at hm
      have hbad : 4 ∣ 18 := by simpa [hm.symm] using hintercard
      norm_num at hbad
    · omega
    · omega
    · omega
  simpa [Tg] using h2

/-- The nonidentity element of `T₂ ∩ Ĥ` lies outside the two-core
`V = O₂(Ĥ)`: otherwise `T₂` (abelian of order four) would centralize it, and
the centralizer of every nonidentity element of `V` is contained in `Ĥ`,
forcing `T₂ ≤ Ĥ`, contradicting `|T₂ ∩ Ĥ| = 2`. -/
public theorem firstCase_t2_inter_hhat_not_mem_twoCore
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      ∀ t' : G, t' ∈ ((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat →
        t' ≠ 1 → t' ∉ twoCoreOf c.Hhat := by
  classical
  intro NP T2 t' ht' ht'ne
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg4sq : Nat.card Tg = 2 ^ 2 := by
    rw [hTg4]
    norm_num
  have : IsMulCommutative Tg :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq
  intro htV
  have ht'central : ∀ x : G, x ∈ Tg → x * t' = t' * x := by
    intro x hx
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq).is_comm).comm
        ⟨x, hx⟩ ⟨t', ht'.1⟩)
  have hTg_le_C : Tg ≤ Subgroup.centralizer ({t'} : Set G) := by
    intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact ht'central x hx
  have hC_le_Hhat : Subgroup.centralizer ({t'} : Set G) ≤ c.Hhat :=
    firstCase_klein_centralizer_twoCore_le_Hhat hmin c hklein t' htV ht'ne
  have hTg_le_Hhat : Tg ≤ c.Hhat := hTg_le_C.trans hC_le_Hhat
  have hcard2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hcard4 : Nat.card ↥(Tg ⊓ c.Hhat) = 4 := by
    have hEq : Tg ⊓ c.Hhat = Tg := by
      apply le_antisymm
      · exact inf_le_left
      · intro x hx
        exact ⟨hx, hTg_le_Hhat hx⟩
    rw [hEq]
    exact hTg4
  omega

/-- In the Klein-four branch, every involution of `Ĥ` outside `V=O₂(Ĥ)`
inverts every element of `U`.  This is the uniform-Hall part of
`firstCase_klein_data_complete`, specialized from `t'` to an arbitrary
involution. -/
private lemma firstCase_hhat_involution_not_twoCore_inverts_U
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    {s : G} (hsH : s ∈ c.Hhat) (hsInv : IsInvolution s)
    (hsV : s ∉ twoCoreOf c.Hhat) :
    ∀ u : G, u ∈ c.U → s * u * s⁻¹ = u⁻¹ := by
  classical
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  obtain ⟨d0, K, hKHall, hKne, hKall⟩ :=
    firstCase_klein_data_complete hmin c hfirst hklein
  have hKleU : K ≤ c.U := hKHall.1.trans (fittingSubgroupOf_le c.U)
  have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
  have hKne1 : Nat.card ↥K ≠ 1 := by
    intro h1
    apply hKne
    exact Subgroup.eq_bot_of_card_eq K h1
  have hK3 : Nat.card ↥K = 3 := by
    have hKdvd : Nat.card ↥K ∣ Nat.card c.U := Subgroup.card_dvd_of_le hKleU
    rw [hU3] at hKdvd
    rcases hKdvd with ⟨m, hm⟩
    have hm3 : 3 = Nat.card ↥K * m := by simpa [hU3] using hm
    have hmle : m ≤ 3 := by
      rw [mul_comm] at hm3
      exact Nat.le_of_dvd (by norm_num : 0 < 3) ⟨Nat.card ↥K, hm3⟩
    interval_cases m
    · norm_num at hm3
    · norm_num at hm3
      exact hm3.symm
    · omega
    · omega
  have hKeq : K = c.U := by
    apply Subgroup.eq_of_le_of_card_ge (H := K) (K := c.U) hKleU
    rw [hU3, hK3]
  have hKinv := (hKall s hsH hsInv hsV).1
  intro u hu
  have huK : u ∈ (K : Set G) := by
    rw [hKeq]
    exact hu
  have huinv : u ∈ invertedElements c.U s := by
    simpa [hKinv] using huK
  exact huinv.2

/-- The nonidentity element `t'` of `T₂ ∩ Ĥ` inverts every element of `U`:
by the preceding lemma `t' ∉ V = O₂(Ĥ)`, and the Klein-branch package
`firstCase_klein_data_complete` gives a uniform nonidentity Hall subgroup
`K` of `F(U)` inverted by every involution of `Ĥ ∖ V`; since `|U| = 3` and
`K ≤ F(U) ≤ U`, we have `K = U`. -/
public theorem firstCase_t2_inter_hhat_inverts_U
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      ∀ t' : G, t' ∈ ((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat →
        t' ≠ 1 → ∀ u : G, u ∈ c.U → t' * u * t'⁻¹ = u⁻¹ := by
  classical
  intro NP T2 t' ht' ht'ne u hu
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have ht'V : t' ∉ twoCoreOf c.Hhat :=
    firstCase_t2_inter_hhat_not_mem_twoCore hmin c hfirst d P hPU T2 t' ht' ht'ne
  have ht'Inv : IsInvolution t' := by
    refine ⟨ht'ne, ?_⟩
    have hord : orderOf t' = 2 := by
      have hzle : Subgroup.zpowers t' ≤ Tg ⊓ c.Hhat := by
        intro x hx
        rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
        exact ⟨Tg.zpow_mem ht'.1 n, c.Hhat.zpow_mem ht'.2 n⟩
      have hzcard : Nat.card ↥(Subgroup.zpowers t') ≤ 2 := by
        have hdvd := Subgroup.card_dvd_of_le hzle
        have hc2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
          simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
            hmin c hfirst d P hPU T2
        rw [hc2] at hdvd
        exact Nat.le_of_dvd (by norm_num : 0 < 2) hdvd
      rw [Nat.card_zpowers] at hzcard
      have hne1 : orderOf t' ≠ 1 := by
        intro h1
        apply ht'ne
        rwa [← orderOf_eq_one_iff]
      have hpos : 0 < orderOf t' := orderOf_pos t'
      omega
    rw [← hord]
    exact pow_orderOf_eq_one t'
  exact firstCase_hhat_involution_not_twoCore_inverts_U hmin c hfirst d
    ht'.2 ht'Inv ht'V u hu

/-- The nonidentity element `t'` of `T₂ ∩ Ĥ` inverts every element of `P`:
it inverts `U` (the preceding lemma), and since `T₂` is abelian it also
inverts the second line `W` (conjugate `W = a U a⁻¹` with `a ∈ T₂`
commuting with `t'`); `P = U ⊔ W` is abelian, so every `p = u w` is
inverted.  Consequently `t' · p` is an involution for every `p ∈ P`. -/
public theorem firstCase_t2_inter_hhat_inverts_P
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    ∀ T2 : Sylow 2 (↥NP),
      ∀ t' : G, t' ∈ ((T2 : Subgroup (↥NP)).map NP.subtype) ⊓ c.Hhat →
        t' ≠ 1 → ∀ p : G, p ∈ (P : Subgroup G) → t' * p * t'⁻¹ = p⁻¹ := by
  classical
  intro NP T2 t' ht' ht'ne p hp
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 :=
      firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg4sq : Nat.card Tg = 2 ^ 2 := by
    rw [hTg4]
    norm_num
  have : IsMulCommutative Tg :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq
  have hcommTg : ∀ a b : G, a ∈ Tg → b ∈ Tg → a * b = b * a := by
    intro a b ha hb
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hTg4sq).is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
  obtain ⟨U1, U2, _hUne, hU1le, hU2le, hU1conj, hU2conj, honly⟩ :=
    firstCase_sylow3_UConjugates_inside_eq hmin c hfirst d P
  have hU1eq : U1 = c.U ∨ U2 = c.U := by
    have hUconj : ∃ g : G, c.U = conjugateSubgroup c.U g := by
      refine ⟨1, ?_⟩
      rw [conjugateSubgroup]
      have h1 : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by
        ext x
        simp
      rw [h1]
      exact (Subgroup.map_id c.U).symm
    exact honly c.U hUconj hPU |>.elim (fun h => Or.inl h.symm) (fun h => Or.inr h.symm)
  -- name the line equal to `c.U` as `U` and the other as `W`
  let U : Subgroup G := if hU1eq' : U1 = c.U then U1 else U2
  let W : Subgroup G := if hU1eq' : U1 = c.U then U2 else U1
  have hUeq : U = c.U := by
    by_cases h : U1 = c.U
    · simpa [U, h]
    · rcases hU1eq with h1 | h2
      · exact False.elim (h h1)
      · simpa [U, h]
  have hUle : U ≤ (P : Subgroup G) := by
    by_cases h : U1 = c.U
    · simpa [U, h]
    · simpa [U, h]
  have hWle : W ≤ (P : Subgroup G) := by
    by_cases h : U1 = c.U
    · simpa [W, h]
    · simpa [W, h]
  have hUconj : ∃ g : G, U = conjugateSubgroup c.U g := by
    by_cases h : U1 = c.U
    · simpa [U, h] using hU1conj
    · simpa [U, h] using hU2conj
  have hWconj : ∃ g : G, W = conjugateSubgroup c.U g := by
    by_cases h : U1 = c.U
    · simpa [W, h] using hU2conj
    · simpa [W, h] using hU1conj
  have hUneW : U ≠ W := by
    by_cases h : U1 = c.U
    · rw [show U = U1 by simp [U, h], show W = U2 by simp [W, h]]
      exact _hUne
    · rw [show U = U2 by simp [U, h], show W = U1 by simp [W, h]]
      exact _hUne.symm
  have hinvU : ∀ u : G, u ∈ U → t' * u * t'⁻¹ = u⁻¹ := by
    intro u hu
    rw [hUeq] at hu
    exact firstCase_t2_inter_hhat_inverts_U hmin c hfirst d P hPU T2 t' ht' ht'ne u hu
  -- an element of `T₂ ∖ Ĥ` swaps `U` and `W`
  have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have haEx : ∃ a : G, a ∈ Tg ∧ a ∉ (c.Hhat : Set G) := by
    classical
    let : Fintype G := Fintype.ofFinite G
    let F : Finset G := {x : G | x ∈ Tg}.toFinset
    let E : Finset G := {x : G | x ∈ Tg ∧ x ∈ c.Hhat}.toFinset
    have hFcard : F.card = 4 := by
      have hset : ({x : G | x ∈ Tg} : Set G).ncard = 4 := by
        rw [← Nat.card_coe_set_eq]
        exact hTg4
      rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg} : Set G)]
      simpa [F] using hset
    have hEcard : E.card = 2 := by
      have hset : ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G).ncard = 2 := by
        rw [← Nat.card_coe_set_eq]
        exact hTg2
      rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G)]
      simpa [E] using hset
    have hlt : E.card < F.card := by omega
    rcases Finset.exists_mem_notMem_of_card_lt_card hlt with ⟨a, haF, haE⟩
    refine ⟨a, ?_, ?_⟩
    · simpa [F] using haF
    · intro h
      apply haE
      have haTg : a ∈ Tg := by simpa [F] using haF
      simpa [E] using ⟨haTg, h⟩
  rcases haEx with ⟨a, haTg, haHhat⟩
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) :=
      firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 :=
      (firstCase_klein_V_klein c hklein).card_four
    omega
  have haU : conjugateSubgroup U a = W := by
    have hconj : ∃ g : G, conjugateSubgroup U a = conjugateSubgroup c.U g := by
      rcases hUconj with ⟨g, hg⟩
      rw [hg]
      refine ⟨a * g, ?_⟩
      unfold conjugateSubgroup
      rw [Subgroup.map_map]
      congr 1
      ext x
      simp [MulAut.conj_apply]
    have hle : conjugateSubgroup U a ≤ (P : Subgroup G) := by
      have hN : a ∈ NP := hTgNP haTg
      have hmap : (U.map (MulAut.conj a) : Subgroup G) ≤ P := by
        intro x hx
        rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
        change a * u * a⁻¹ ∈ (P : Subgroup G)
        exact (Subgroup.mem_normalizer_iff.mp hN u).mp (hUle hu)
      simpa [conjugateSubgroup] using hmap
    have hne : conjugateSubgroup U a ≠ U := by
      rw [hUeq]
      intro hEq
      apply haHhat
      rw [← theorem26_normalizer_U_eq_Hhat hmin c hO2 (lemma_2_2 hmin c).2]
      change a ∈ Subgroup.normalizer (c.U : Set G)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      change c.U.map (MulAut.conj a) = c.U
      simpa [conjugateSubgroup] using hEq
    have hV : conjugateSubgroup U a = U ∨ conjugateSubgroup U a = W := by
      rcases honly (conjugateSubgroup U a) hconj hle with h | h
      · by_cases hc : U1 = c.U
        · left
          simpa [U, hc] using h
        · right
          simpa [W, hc] using h
      · by_cases hc : U1 = c.U
        · right
          simpa [W, hc] using h
        · left
          simpa [U, hc] using h
    rcases hV with h | h
    · exact False.elim (hne h)
    · exact h
  have hcomm_t_a : t' * a = a * t' := hcommTg t' a ht'.1 haTg
  have hcomm_ainv_tinv : a⁻¹ * t'⁻¹ = t'⁻¹ * a⁻¹ :=
    hcommTg a⁻¹ t'⁻¹ (Tg.inv_mem haTg) (Tg.inv_mem ht'.1)
  have hinvW : ∀ w : G, w ∈ W → t' * w * t'⁻¹ = w⁻¹ := by
    intro w hw
    have hwW : w ∈ conjugateSubgroup U a := by
      rwa [haU]
    rcases Subgroup.mem_map.mp hwW with ⟨u, hu, hw'⟩
    change MulAut.conj a u = w at hw'
    simp [MulAut.conj_apply] at hw'
    have huInv : t' * u * t'⁻¹ = u⁻¹ := hinvU u hu
    calc
      t' * w * t'⁻¹ = t' * (a * u * a⁻¹) * t'⁻¹ := by rw [hw']
      _ = a * (t' * u * t'⁻¹) * a⁻¹ := by
        calc
          t' * (a * u * a⁻¹) * t'⁻¹ = t' * a * u * a⁻¹ * t'⁻¹ := by group
          _ = a * t' * u * a⁻¹ * t'⁻¹ := by rw [hcomm_t_a]
          _ = a * t' * u * t'⁻¹ * a⁻¹ := by
            rw [mul_assoc (a * t' * u) a⁻¹ t'⁻¹]
            rw [hcomm_ainv_tinv]
            rw [← mul_assoc (a * t' * u) t'⁻¹ a⁻¹]
          _ = a * (t' * u * t'⁻¹) * a⁻¹ := by group
      _ = a * u⁻¹ * a⁻¹ := by rw [huInv]
      _ = (a * u * a⁻¹)⁻¹ := by group
      _ = w⁻¹ := by rw [hw']
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hU_3 : Nat.card U = 3 := by
    rcases hUconj with ⟨g, hg⟩
    rw [hg, conjugateSubgroup]
    have hc := Nat.card_congr (Subgroup.equivMapOfInjective c.U (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).toEquiv
    simpa using hc.symm.trans hU3
  have hW_3 : Nat.card W = 3 := by
    rcases hWconj with ⟨g, hg⟩
    rw [hg, conjugateSubgroup]
    have hc := Nat.card_congr (Subgroup.equivMapOfInjective c.U (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).toEquiv
    simpa using hc.symm.trans hU3
  have hcommP : ∀ a b : G, a ∈ (P : Subgroup G) → b ∈ (P : Subgroup G) →
      a * b = b * a := by
    intro a b ha hb
    have hP9' : Nat.card (P : Subgroup G) = 3 ^ 2 := by simpa using hP9
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9').is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hdecomp : ∃ u w : G, u ∈ U ∧ w ∈ W ∧ p = u * w := by
    have hdisj : Disjoint U W := by
      rw [disjoint_iff_inf_le]
      intro x hx
      by_contra hxne
      have hUz : U = Subgroup.zpowers x := by
        have hordx : orderOf x = 3 := by
          have hdvd : orderOf x ∣ 3 := by
            have hd := Subgroup.orderOf_dvd_natCard U hx.1
            rwa [hU_3] at hd
          have hne1 : orderOf x ≠ 1 := by
            intro h1
            exact hxne (orderOf_eq_one_iff.mp h1)
          rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
          · exact False.elim (hne1 h1)
          · exact h3
        have hzle : Subgroup.zpowers x ≤ U := by
          intro y hy
          rcases Subgroup.mem_zpowers_iff.mp hy with ⟨n, rfl⟩
          exact U.zpow_mem hx.1 n
        have hzcard : Nat.card (Subgroup.zpowers x : Subgroup G) = 3 := by
          rw [Nat.card_zpowers, hordx]
        apply (Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers x) (K := U)
          hzle (by rw [hU_3]; exact hzcard.ge)).symm
      have hWz : W = Subgroup.zpowers x := by
        have hordx : orderOf x = 3 := by
          have hdvd : orderOf x ∣ 3 := by
            have hd := Subgroup.orderOf_dvd_natCard W hx.2
            rwa [hW_3] at hd
          have hne1 : orderOf x ≠ 1 := by
            intro h1
            exact hxne (orderOf_eq_one_iff.mp h1)
          rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
          · exact False.elim (hne1 h1)
          · exact h3
        have hzle : Subgroup.zpowers x ≤ W := by
          intro y hy
          rcases Subgroup.mem_zpowers_iff.mp hy with ⟨n, rfl⟩
          exact W.zpow_mem hx.2 n
        have hzcard : Nat.card (Subgroup.zpowers x : Subgroup G) = 3 := by
          rw [Nat.card_zpowers, hordx]
        apply (Subgroup.eq_of_le_of_card_ge (H := Subgroup.zpowers x) (K := W)
          hzle (by rw [hW_3]; exact hzcard.ge)).symm
      exact hUneW (hUz.trans hWz.symm)
    have hnorm : W ≤ Subgroup.normalizer (U : Set G) := by
      intro w hw
      rw [Subgroup.mem_normalizer_iff]
      intro u
      constructor
      · intro hu
        have hcomm : u * w = w * u := hcommP u w (hUle hu) (hWle hw)
        have hcalc : w * u * w⁻¹ = u := by
          calc
            w * u * w⁻¹ = u * w * w⁻¹ := by rw [hcomm]
            _ = u := by group
        rwa [hcalc]
      · intro huW
        have hcomm : w⁻¹ * (w * u * w⁻¹) = (w * u * w⁻¹) * w⁻¹ :=
          hcommP w⁻¹ (w * u * w⁻¹) (hWle (W.inv_mem hw)) (hUle huW)
        have hu : u = w⁻¹ * (w * u * w⁻¹) * w := by group
        have hcalc : w⁻¹ * (w * u * w⁻¹) * w = w * u * w⁻¹ := by
          calc
            w⁻¹ * (w * u * w⁻¹) * w = (w * u * w⁻¹) * w⁻¹ * w := by rw [hcomm]
            _ = w * u * w⁻¹ := by group
        rwa [hu, hcalc]
    have hcard : Nat.card (U ⊔ W : Subgroup G) = 9 := by
      rw [card_sup_eq_mul_of_disjoint_of_le_normalizer U W hnorm hdisj]
      rw [hU_3, hW_3]
    have hEq : U ⊔ W = (P : Subgroup G) := by
      apply Subgroup.eq_of_le_of_card_ge (H := U ⊔ W) (K := (P : Subgroup G))
        (sup_le hUle hWle)
      rw [hP9]
      exact hcard.ge
    have hpSup : p ∈ (U ⊔ W : Subgroup G) := by
      change p ∈ (((U ⊔ W : Subgroup G) : Set G))
      rw [hEq]
      exact hp
    have hset : (((U ⊔ W : Subgroup G) : Set G)) = (U : Set G) * (W : Set G) := by
      simpa using (Subgroup.coe_mul_of_right_le_normalizer_left U W hnorm)
    have hmem : p ∈ (U : Set G) * (W : Set G) := by
      change p ∈ (((U ⊔ W : Subgroup G) : Set G)) at hpSup
      rwa [hset] at hpSup
    rcases Set.mem_mul.mp hmem with ⟨u, hu⟩
    rcases hu with ⟨huU, hmem'⟩
    rcases hmem' with ⟨w, hw⟩
    rcases hw with ⟨hwW, hp'⟩
    exact ⟨u, ⟨w, ⟨huU, ⟨hwW, hp'.symm⟩⟩⟩⟩
  rcases hdecomp with ⟨u, hu⟩
  rcases hu with ⟨w, hw⟩
  rcases hw with ⟨huU, hw'⟩
  rcases hw' with ⟨hwW, hp'⟩
  calc
    t' * p * t'⁻¹ = t' * (u * w) * t'⁻¹ := by rw [hp']
    _ = (t' * u * t'⁻¹) * (t' * w * t'⁻¹) := by group
    _ = u⁻¹ * w⁻¹ := by rw [hinvU u huU, hinvW w hwW]
    _ = (u * w)⁻¹ := by
      rw [mul_inv_rev]
      simpa [mul_inv_rev] using
        congrArg (fun x : G => x⁻¹) (hcommP w u (hWle hwW) (hUle huU))
    _ = p⁻¹ := by rw [hp']

/-- The centralizer of `U` has order `36` (Suzuki's `W`): it contains the
product `P·V` of a Sylow 3-subgroup `P` (order 9) with the Klein two-core
`V = O₂(Ĥ)` (order 4), so `36 ≤ |C_G(U)|`; it lies in `Ĥ` (order 72), so
`|C_G(U)| ∈ {36, 72}`; and `|C_G(U)| = 72` is impossible because the
nonidentity element of `T₂ ∩ Ĥ` lies in `Ĥ` but inverts `U`. -/
public theorem firstCase_centralizer_U_card
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    Nat.card ↥(Subgroup.centralizer (c.U : Set G)) = 36 := by
  classical
  let C : Subgroup G := Subgroup.centralizer (c.U : Set G)
  have hPleC : (P : Subgroup G) ≤ C := sylow3_le_centralizer_U c d P hPU
  have h26 := theorem_2_6 hmin c
  have hVleC : twoCoreOf c.Hhat ≤ C := by
    change twoCoreOf c.Hhat ≤ Subgroup.centralizer (c.U : Set G)
    rw [h26.1]
    exact twoCoreOf_centralizes_oddCoreOf c.Hhat
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have hV4 : Nat.card (twoCoreOf c.Hhat) = 4 := by
    exact (firstCase_klein_V_klein c hklein).card_four
  have hdisj : Disjoint (P : Subgroup G) (twoCoreOf c.Hhat) := by
    have hcop : Nat.Coprime 9 4 := by norm_num
    exact Subgroup.disjoint_of_coprime_natCard (by simpa [hP9, hV4] using hcop)
  have h36le : 36 ≤ Nat.card ↥C := by
    let f : ↥(P : Subgroup G) × ↥(twoCoreOf c.Hhat) → ↥C := fun z =>
      ⟨(z.1 : G) * (z.2 : G), C.mul_mem (hPleC z.1.2) (hVleC z.2.2)⟩
    have hf_inj : Function.Injective f := by
      intro a b h
      apply Subgroup.mul_injective_of_disjoint hdisj
      exact congrArg Subtype.val h
    have hle := Nat.card_le_card_of_injective f hf_inj
    rw [Nat.card_prod, hP9, hV4] at hle
    norm_num at hle
    exact hle
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    intro hbot
    have hcard : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hC_le_Hhat : C ≤ c.Hhat := by
    exact (Subgroup.centralizer_le_normalizer (c.U : Set G)).trans
      (le_of_eq (theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne))
  have hCdvd72 : Nat.card ↥C ∣ 72 := by
    have hdvd := Subgroup.card_dvd_of_le hC_le_Hhat
    have hh : Nat.card (↥c.Hhat) = 72 := hhat_card c d
    simpa [C] using hdvd.trans (by rw [hh])
  have hC36or72 : Nat.card ↥C = 36 ∨ Nat.card ↥C = 72 := by
    rcases hCdvd72 with ⟨m, hm⟩
    have hmul : 36 * m ≤ 72 := by
      have hmul' : 36 * m ≤ Nat.card ↥C * m := Nat.mul_le_mul_right m h36le
      rwa [← hm] at hmul'
    have hmle : m ≤ 2 := by omega
    interval_cases m
    · norm_num at hm
    · norm_num at hm
      right
      exact hm.symm
    · norm_num at hm
      left
      omega
  rcases hC36or72 with hC36 | hC72
  · exact hC36
  · exfalso
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    obtain ⟨T2⟩ := (Sylow.nonempty (p := 2) (G := ↥NP))
    let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
    have hTgcard2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
      simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
        hmin c hfirst d P hPU T2
    have hx : ∃ x : G, x ∈ Tg ⊓ c.Hhat ∧ x ≠ 1 := by
      classical
      let α := {x : G // x ∈ Tg ⊓ c.Hhat}
      have hgt : 1 < Nat.card α := by
        rw [hTgcard2]
        norm_num
      have hnt : Nontrivial α := (Finite.one_lt_card_iff_nontrivial).mp hgt
      rcases exists_ne (⟨1, by simp⟩ : α) with ⟨b, hb⟩
      exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
    let t' : G := Classical.choose hx
    have ht' : t' ∈ Tg ⊓ c.Hhat := (Classical.choose_spec hx).1
    have ht'ne : t' ≠ 1 := (Classical.choose_spec hx).2
    have hCeq : C = c.Hhat := by
      apply Subgroup.eq_of_le_of_card_ge (H := C) (K := c.Hhat) hC_le_Hhat
      rw [hC72, hhat_card c d]
    have ht'C : t' ∈ C := by
      rw [hCeq]
      exact ht'.2
    have ht'Inv : ∀ u : G, u ∈ c.U → t' * u * t'⁻¹ = u⁻¹ := by
      intro u hu
      exact firstCase_t2_inter_hhat_inverts_U hmin c hfirst d P hPU T2 t' ht' ht'ne u hu
    have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
    have hxU : ∃ u : G, u ∈ c.U ∧ u ≠ 1 := by
      classical
      have hgt : 1 < Nat.card c.U := by
        rw [hU3]
        norm_num
      have hnt : Nontrivial c.U := (Finite.one_lt_card_iff_nontrivial).mp hgt
      rcases exists_ne (⟨1, by simp⟩ : c.U) with ⟨b, hb⟩
      exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
    obtain ⟨u, hu, hune⟩ := hxU
    have hc := Subgroup.mem_centralizer_iff.mp ht'C u hu
    have hmu : t' * u * t'⁻¹ = u := by
      calc
        t' * u * t'⁻¹ = (u * t') * t'⁻¹ := by rw [hc]
        _ = u := by group
    have hmuinv : t' * u * t'⁻¹ = u⁻¹ := ht'Inv u hu
    have hu2 : u = u⁻¹ := by
      rw [← hmuinv]
      exact hmu.symm
    have huu : u * u = 1 := by
      nth_rewrite 2 [hu2]
      group
    have hu2eq : u ^ 2 = 1 := by
      simpa [pow_two] using huu
    have hord2 : orderOf u ∣ 2 := by
      rw [orderOf_dvd_iff_pow_eq_one]
      simpa [pow_two] using hu2eq
    have hord3 : orderOf u ∣ 3 := by
      rw [orderOf_dvd_iff_pow_eq_one]
      have hdvd : orderOf u ∣ Nat.card c.U := Subgroup.orderOf_dvd_natCard c.U hu
      rw [hU3] at hdvd
      have hne1 : orderOf u ≠ 1 := by
        intro h1
        exact hune (orderOf_eq_one_iff.mp h1)
      rcases hdvd with ⟨m, hm⟩
      have hm3 : 3 = orderOf u * m := hm
      have hmle : m ≤ 3 := by
        rw [mul_comm] at hm3
        exact Nat.le_of_dvd (by norm_num : 0 < 3) ⟨orderOf u, hm3⟩
      interval_cases m
      · norm_num at hm3
      · norm_num at hm3
        rw [hm3]
        exact pow_orderOf_eq_one u
      · omega
      · omega
    have hord1 : orderOf u = 1 := by
      have h12 : orderOf u ∣ Nat.gcd 2 3 := Nat.dvd_gcd hord2 hord3
      have hg : Nat.gcd 2 3 = 1 := by norm_num
      rw [hg] at h12
      exact Nat.dvd_one.mp h12
    exact hune (orderOf_eq_one_iff.mp hord1)

/-- The setup Sylow 2-subgroup lies in `Ĥ`: `S ≤ H = C_G(t) ≤ Ĥ`. -/
public theorem firstCase_setup_sylow2_le_Hhat
    {G : Type u} [Group G] [Finite G]
    (c : CentralizerSetup G) :
    (c.S : Subgroup G) ≤ c.Hhat :=
  (centralizerSetup_S_le_H c).trans c.H_le_Hhat

/-- The join of a Sylow 3-subgroup `P` containing `U` with the setup Sylow 2
`S` is exactly `Ĥ`: both lie in `Ĥ`, they intersect trivially, and their
product has `9 · 8 = 72` elements, the order of `Ĥ`. -/
public theorem firstCase_join_P_setupSylow2_eq_Hhat
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    (P : Subgroup G) ⊔ (c.S : Subgroup G) = c.Hhat := by
  classical
  have hPleHhat : (P : Subgroup G) ≤ c.Hhat := sylow3_le_hhat hmin c hfirst d P hPU
  have hSleHhat : (c.S : Subgroup G) ≤ c.Hhat := firstCase_setup_sylow2_le_Hhat c
  have hle : (P : Subgroup G) ⊔ (c.S : Subgroup G) ≤ c.Hhat := sup_le hPleHhat hSleHhat
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hS8 : Nat.card (c.S : Subgroup G) = 8 := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    exact firstCase_klein_S_card hmin c hfirst hklein
  have hdisj : Disjoint (P : Subgroup G) (c.S : Subgroup G) := by
    have hcop : Nat.Coprime 9 8 := by norm_num
    exact Subgroup.disjoint_of_coprime_natCard (by simpa [hP9, hS8] using hcop)
  have h72le : 72 ≤ Nat.card ↥((P : Subgroup G) ⊔ (c.S : Subgroup G)) := by
    let f : ↥(P : Subgroup G) × ↥(c.S : Subgroup G) →
        ↥((P : Subgroup G) ⊔ (c.S : Subgroup G)) := fun z =>
      ⟨(z.1 : G) * (z.2 : G), Subgroup.mul_mem_sup z.1.2 z.2.2⟩
    have hf_inj : Function.Injective f := by
      intro a b h
      apply Subgroup.mul_injective_of_disjoint hdisj
      exact congrArg Subtype.val h
    have hle' := Nat.card_le_card_of_injective f hf_inj
    rw [Nat.card_prod, hP9, hS8] at hle'
    norm_num at hle'
    exact hle'
  apply Subgroup.eq_of_le_of_card_ge (H := (P : Subgroup G) ⊔ (c.S : Subgroup G))
    (K := c.Hhat) hle
  rw [hhat_card c d]
  exact h72le

/-- The centralizer of `U` is generated by a Sylow 3-subgroup `P` containing
`U` together with the Klein two-core `V = O₂(Ĥ)`: both lie in `C_G(U)`,
they intersect trivially, and their product has `9 · 4 = 36` elements, the
order of `C_G(U)`. -/
public theorem firstCase_centralizer_U_eq_P_sup_twoCore
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G)) :
    Subgroup.centralizer (c.U : Set G) =
      (P : Subgroup G) ⊔ twoCoreOf c.Hhat := by
  classical
  let C : Subgroup G := Subgroup.centralizer (c.U : Set G)
  have hPleC : (P : Subgroup G) ≤ C := sylow3_le_centralizer_U c d P hPU
  have h26 := theorem_2_6 hmin c
  have hVleC : twoCoreOf c.Hhat ≤ C := by
    change twoCoreOf c.Hhat ≤ Subgroup.centralizer (c.U : Set G)
    rw [h26.1]
    exact twoCoreOf_centralizes_oddCoreOf c.Hhat
  have hle : (P : Subgroup G) ⊔ twoCoreOf c.Hhat ≤ C := sup_le hPleC hVleC
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
  have hV4 : Nat.card (twoCoreOf c.Hhat) = 4 := by
    exact (firstCase_klein_V_klein c hklein).card_four
  have hdisj : Disjoint (P : Subgroup G) (twoCoreOf c.Hhat) := by
    have hcop : Nat.Coprime 9 4 := by norm_num
    exact Subgroup.disjoint_of_coprime_natCard (by simpa [hP9, hV4] using hcop)
  have h36le : 36 ≤ Nat.card ↥((P : Subgroup G) ⊔ twoCoreOf c.Hhat) := by
    let f : ↥(P : Subgroup G) × ↥(twoCoreOf c.Hhat) →
        ↥((P : Subgroup G) ⊔ twoCoreOf c.Hhat) := fun z =>
      ⟨(z.1 : G) * (z.2 : G), Subgroup.mul_mem_sup z.1.2 z.2.2⟩
    have hf_inj : Function.Injective f := by
      intro a b h
      apply Subgroup.mul_injective_of_disjoint hdisj
      exact congrArg Subtype.val h
    have hle' := Nat.card_le_card_of_injective f hf_inj
    rw [Nat.card_prod, hP9, hV4] at hle'
    norm_num at hle'
    exact hle'
  symm
  apply Subgroup.eq_of_le_of_card_ge (H := (P : Subgroup G) ⊔ twoCoreOf c.Hhat)
    (K := C) hle
  rw [firstCase_centralizer_U_card hmin c hfirst d P hPU]
  exact h36le

private lemma inter_hhat_card_four_is_klein
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (hK4 : Nat.card ↥((S2 : Subgroup G) ⊓ c.Hhat) = 4) :
    IsKleinFour ↥((S2 : Subgroup G) ⊓ c.Hhat) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  let K : Subgroup G := (S2 : Subgroup G) ⊓ c.Hhat
  have hTgcard2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hx : ∃ t' : G, t' ∈ Tg ⊓ c.Hhat ∧ t' ≠ 1 := by
    classical
    let α := {x : G // x ∈ Tg ⊓ c.Hhat}
    have hgt : 1 < Nat.card α := by
      rw [hTgcard2]
      norm_num
    have hnt : Nontrivial α := (Finite.one_lt_card_iff_nontrivial).mp hgt
    rcases exists_ne (⟨1, by simp⟩ : α) with ⟨b, hb⟩
    exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
  let t' : G := Classical.choose hx
  have ht' : t' ∈ Tg ⊓ c.Hhat := (Classical.choose_spec hx).1
  have ht'ne : t' ≠ 1 := (Classical.choose_spec hx).2
  have ht'K : t' ∈ K := by
    dsimp [K]
    exact ⟨hTgS2 ht'.1, ht'.2⟩
  have ht'2 : t' ^ 2 = 1 := by
    have hord : orderOf t' = 2 := by
      have hzle : Subgroup.zpowers t' ≤ Tg ⊓ c.Hhat := by
        intro x hx
        rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
        exact ⟨Tg.zpow_mem ht'.1 n, c.Hhat.zpow_mem ht'.2 n⟩
      have hzcard : Nat.card ↥(Subgroup.zpowers t') ≤ 2 := by
        have hdvd := Subgroup.card_dvd_of_le hzle
        rw [hTgcard2] at hdvd
        exact Nat.le_of_dvd (by norm_num : 0 < 2) hdvd
      rw [Nat.card_zpowers] at hzcard
      have hne1 : orderOf t' ≠ 1 := by
        intro h1
        apply ht'ne
        rwa [← orderOf_eq_one_iff]
      have hpos : 0 < orderOf t' := orderOf_pos t'
      omega
    rw [← hord]
    exact pow_orderOf_eq_one t'
  have hno4 : ∀ x : ↥K, orderOf x ≠ 4 := by
    intro x hx4
    have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
    have hxU : ∃ u : G, u ∈ c.U ∧ u ≠ 1 := by
      classical
      have hgt : 1 < Nat.card c.U := by
        rw [hU3]
        norm_num
      have hnt : Nontrivial c.U := (Finite.one_lt_card_iff_nontrivial).mp hgt
      rcases exists_ne (⟨1, by simp⟩ : c.U) with ⟨b, hb⟩
      exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
    obtain ⟨u, hu, hune⟩ := hxU
    let tK : ↥K := ⟨t', ht'K⟩
    have htKne : tK ≠ 1 := by
      intro h
      apply ht'ne
      exact congrArg Subtype.val h
    have htK2 : tK ^ 2 = 1 := by
      apply Subtype.ext
      exact ht'2
    have hx2t : (x : ↥K) ^ 2 = tK :=
      order_four_sq_eq_unique_involution K hK4 htKne htK2 hx4
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
      intro hbot
      have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
      have h4 : Nat.card (twoCoreOf c.Hhat) = 4 :=
        (firstCase_klein_V_klein c hklein).card_four
      omega
    have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
    have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
      theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
    have hxHhat : (x : G) ∈ c.Hhat := (Subgroup.mem_inf.mp x.2).2
    have hxN : (x : G) ∈ Subgroup.normalizer (c.U : Set G) := by
      rw [hNormU]
      exact hxHhat
    let u1 : G := (x : G) * u * (x : G)⁻¹
    have hu1U : u1 ∈ c.U := (Subgroup.mem_normalizer_iff.mp hxN u).1 hu
    have hu1ne : u1 ≠ 1 := by
      intro h
      apply hune
      calc
        u = (x : G)⁻¹ * u1 * (x : G) := by dsimp [u1]; group
        _ = 1 := by rw [h]; simp
    have hcase := eq_or_inv_of_order_three c.U hU3 hu hune hu1U hu1ne
    have ht'central : t' * u * t'⁻¹ = u := by
      have hxux : (x : G) * u * (x : G)⁻¹ = u ∨
          (x : G) * u * (x : G)⁻¹ = u⁻¹ := by
        rcases hcase with hu1 | hu1
        · left
          simpa [u1] using hu1
        · right
          simpa [u1] using hu1
      have hx2u : (x : G) ^ 2 * u * ((x : G) ^ 2)⁻¹ = u := by
        rcases hxux with hcent | hinv
        · calc
            (x : G) ^ 2 * u * ((x : G) ^ 2)⁻¹ =
                (x : G) * ((x : G) * u * (x : G)⁻¹) * (x : G)⁻¹ := by
                  rw [pow_two]
                  group
            _ = (x : G) * u * (x : G)⁻¹ := by simp [hcent]
            _ = u := by exact hcent
        · calc
            (x : G) ^ 2 * u * ((x : G) ^ 2)⁻¹ =
                (x : G) * ((x : G) * u * (x : G)⁻¹) * (x : G)⁻¹ := by
                  rw [pow_two]
                  group
            _ = (x : G) * u⁻¹ * (x : G)⁻¹ := by rw [hinv]
            _ = ((x : G) * u * (x : G)⁻¹)⁻¹ := by group
            _ = (u⁻¹)⁻¹ := by rw [hinv]
            _ = u := by simp
      have hx2G : (x : G) ^ 2 = t' := congrArg Subtype.val hx2t
      rw [← hx2G]
      exact hx2u
    have hinv := firstCase_t2_inter_hhat_inverts_U hmin c hfirst d P hPU T2 t' ht' ht'ne u hu
    have hmu : t' * u * t'⁻¹ = u⁻¹ := hinv
    have hu2 : u = u⁻¹ := by
      rw [← hmu]
      exact ht'central.symm
    have huu : u * u = 1 := by
      nth_rewrite 2 [hu2]
      group
    have hu2eq : u ^ 2 = 1 := by
      simpa [pow_two] using huu
    have hord2 : orderOf u ∣ 2 := by
      rw [orderOf_dvd_iff_pow_eq_one]
      simpa [pow_two] using hu2eq
    have hord3 : orderOf u ∣ 3 := by
      have hdvd := Subgroup.orderOf_dvd_natCard c.U hu
      rwa [hU3] at hdvd
    have hord1 : orderOf u = 1 := by
      have hg : Nat.gcd 2 3 = 1 := by norm_num
      have hd : orderOf u ∣ Nat.gcd 2 3 := Nat.dvd_gcd hord2 hord3
      rw [hg] at hd
      exact Nat.dvd_one.mp hd
    exact hune (orderOf_eq_one_iff.mp hord1)
  exact isKleinFour_of_card_four_no_order_four K hK4 hno4

private lemma sylow2_join_inter_hhat_ne_four
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    Nat.card ↥((S2 : Subgroup G) ⊓ c.Hhat) ≠ 4 := by
  classical
  intro hK4
  let K : Subgroup G := (S2 : Subgroup G) ⊓ c.Hhat
  have hKlein : IsKleinFour ↥K :=
    inter_hhat_card_four_is_klein hmin c hfirst d P hPU T2 S2 hTgS2 hK4
  let eS2 := Classical.choice (sylow2_equiv_dihedral4 hmin c hfirst d S2)
  let K' : Subgroup (↥(S2 : Subgroup G)) := K.subgroupOf (S2 : Subgroup G)
  let eK : Subgroup (DihedralGroup 4) := K'.map eS2.toMonoidHom
  have hKleinE : IsKleinFour ↥eK := by
    let eK' : K' ≃* eK :=
      Subgroup.equivMapOfInjective K' eS2.toMonoidHom eS2.injective
    have eKK' : K ≃* K' :=
      (Subgroup.subgroupOfEquivOfLe (inf_le_left : K ≤ (S2 : Subgroup G))).symm
    exact isKleinFour_of_mulEquiv (eKK'.trans eK').symm hKlein
  have hzD : DihedralGroup.r 2 ∈ eK := d8_v4_contains_r2 eK hKleinE
  rcases Subgroup.mem_map.mp hzD with ⟨zS, hzK', hzEq⟩
  have hzEq' : eS2 zS = DihedralGroup.r 2 := by
    simpa using hzEq
  let z : G := zS
  have hzK : z ∈ K := Subgroup.mem_subgroupOf.mp hzK'
  have hzS : z ∈ (S2 : Subgroup G) := zS.2
  have hzCenter : (⟨z, hzS⟩ : ↥(S2 : Subgroup G)) ∈
      Subgroup.center (↥(S2 : Subgroup G)) := by
    rw [Subgroup.mem_center_iff]
    intro a
    apply eS2.injective
    calc
      eS2 (a * zS) = eS2 a * eS2 zS := eS2.map_mul a zS
      _ = eS2 a * DihedralGroup.r 2 := by rw [hzEq']
      _ = DihedralGroup.r 2 * eS2 a := by rw [d8_r2_central (eS2 a)]
      _ = eS2 zS * eS2 a := by rw [hzEq']
      _ = eS2 (zS * a) := (eS2.map_mul zS a).symm
  have hzCentral : ∀ y : G, y ∈ (S2 : Subgroup G) → z * y = y * z := by
    intro y hy
    exact (congrArg Subtype.val ((Subgroup.mem_center_iff.mp hzCenter) ⟨y, hy⟩)).symm
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgcard2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hx : ∃ t' : G, t' ∈ Tg ⊓ c.Hhat ∧ t' ≠ 1 := by
    classical
    let α := {x : G // x ∈ Tg ⊓ c.Hhat}
    have hgt : 1 < Nat.card α := by
      rw [hTgcard2]
      norm_num
    have hnt : Nontrivial α := (Finite.one_lt_card_iff_nontrivial).mp hgt
    rcases exists_ne (⟨1, by simp⟩ : α) with ⟨b, hb⟩
    exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
  let t' : G := Classical.choose hx
  have ht' : t' ∈ Tg ⊓ c.Hhat := (Classical.choose_spec hx).1
  have ht'ne : t' ≠ 1 := (Classical.choose_spec hx).2
  have ht'2 : t' ^ 2 = 1 := by
    have hord : orderOf t' = 2 := by
      have hzle : Subgroup.zpowers t' ≤ Tg ⊓ c.Hhat := by
        intro x hx
        rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
        exact ⟨Tg.zpow_mem ht'.1 n, c.Hhat.zpow_mem ht'.2 n⟩
      have hzcard : Nat.card ↥(Subgroup.zpowers t') ≤ 2 := by
