      rw [Subgroup.mem_normalizer_iff_conj_image_eq]
      ext y
      constructor
      · rintro ⟨g, hg, rfl⟩
        rcases hg with hgU | hgW
        · left
          exact (Subgroup.mem_normalizer_iff.mp hxNormU g).mp hgU
        · right
          change x * g * x⁻¹ ∈ W
          rw [hxCentW g hgW]
          exact hgW
      · intro hy
        rcases hy with hgU | hgW
        · have hxinvN : x⁻¹ ∈ Subgroup.normalizer (c.U : Set G) :=
            (Subgroup.normalizer (c.U : Set G)).inv_mem hxNormU
          have hR : x⁻¹ * y * (x⁻¹)⁻¹ ∈ c.U :=
            ((Subgroup.mem_normalizer_iff.mp hxinvN) y).mp hgU
          refine ⟨x⁻¹ * y * (x⁻¹)⁻¹, Or.inl hR, ?_⟩
          change x * (x⁻¹ * y * (x⁻¹)⁻¹) * x⁻¹ = y
          group
        · refine ⟨y, Or.inr hgW, ?_⟩
          change x * y * x⁻¹ = y
          rw [hxCentW y hgW]
    have hxN : x ∈ Subgroup.normalizer ((P : Subgroup G) : Set G) := by
      have h := Subgroup.normalizer_le_normalizer_closure
        ((c.U : Set G) ∪ (W : Set G)) hxNs
      rw [← hPclosure] at h
      exact h
    have hxS2 : x ∈ (S2 : Subgroup G) := by
      exact (S2 : Subgroup G).mul_mem
        ((S2 : Subgroup G).mul_mem (hTgS2 hrTg) (Subgroup.mem_inf.mp hvK).1)
        ((S2 : Subgroup G).inv_mem (hTgS2 hrTg))
    let A0 : Subgroup G := NP ⊓ (S2 : Subgroup G)
    have hTg_le_A0 : Tg ≤ A0 := by
      intro y hy
      exact ⟨hTgNP hy, hTgS2 hy⟩
    have hS2_not_le_NP : ¬ (S2 : Subgroup G) ≤ NP := by
      intro hS2le
      let Q : Subgroup (↥NP) := (S2 : Subgroup G).subgroupOf NP
      have hQp : IsPGroup 2 Q := by
        exact S2.isPGroup'.of_equiv (Subgroup.subgroupOfEquivOfLe hS2le).symm
      have hT2leQ : (T2 : Subgroup (↥NP)) ≤ Q := by
        intro y hy
        rw [Subgroup.mem_subgroupOf]
        change (y : G) ∈ (S2 : Subgroup G)
        exact hTgS2 (Subgroup.mem_map.mpr ⟨y, hy, rfl⟩)
      have hQeq : Q = (T2 : Subgroup (↥NP)) := T2.is_maximal' hQp hT2leQ
      have hQcard : Nat.card ↥Q = 8 := by
        have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
        exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS2le).toEquiv).trans hS2card
      rw [hQeq] at hQcard
      have : (4 : ℕ) ≠ 8 := by norm_num
      exact this (hT2card.symm.trans hQcard)
    have hA0_ne_S2 : A0 ≠ (S2 : Subgroup G) := by
      intro hEq
      apply hS2_not_le_NP
      intro y hy
      have hyA : y ∈ A0 := by rw [hEq]; exact hy
      exact hyA.1
    have hA0card4 : Nat.card ↥A0 = 4 := by
      have hdiv : Nat.card ↥A0 ∣ 8 := by
        exact (Subgroup.card_dvd_of_le (inf_le_right : A0 ≤ (S2 : Subgroup G))).trans
          (by rw [firstCase_sylow2_card_eight c d S2])
      have h4le : 4 ≤ Nat.card ↥A0 := by
        let f : Tg → A0 := fun y => ⟨(y : G), hTg_le_A0 y.2⟩
        have hf_inj : Function.Injective f := by
          intro a b h
          apply Subtype.ext
          have hG : (f a : G) = (f b : G) :=
            congrArg (fun z : A0 => (z : G)) h
          simpa [f] using hG
        have hle := Nat.card_le_card_of_injective f hf_inj
        rwa [hTg4] at hle
      have hne8 : Nat.card ↥A0 ≠ 8 := by
        intro h8
        apply hA0_ne_S2
        apply Subgroup.eq_of_le_of_card_ge (H := A0) (K := (S2 : Subgroup G))
          (inf_le_right : A0 ≤ (S2 : Subgroup G))
        rw [h8, firstCase_sylow2_card_eight c d S2]
      rcases hdiv with ⟨m, hm⟩
      have hmle : m ≤ 8 := by
        have hd : m ∣ 8 := by
          rw [mul_comm] at hm
          exact ⟨Nat.card ↥A0, hm⟩
        exact Nat.le_of_dvd (by norm_num : 0 < 8) hd
      interval_cases m <;> omega
    have hA0eqTg : A0 = Tg := by
      symm
      apply Subgroup.eq_of_le_of_card_ge (H := Tg) (K := A0) hTg_le_A0
      rw [hA0card4]
      exact hTg4.ge
    have hxA0 : x ∈ A0 := ⟨hxN, hxS2⟩
    have hxTg : x ∈ Tg := by
      rw [hA0eqTg] at hxA0
      exact hxA0
    have hxTgH : x ∈ Tg ⊓ c.Hhat := ⟨hxTg, hxHhat⟩
    have hx_ne1 : x ≠ 1 := by
      intro hx1
      apply ht'notV
      have htv : t' * v = 1 := by
        rw [← hxalt]
        exact hx1
      have hvt' : v = t' := by
        calc
          v = t' * (t' * v) := by
            rw [← mul_assoc, ← pow_two, ht'2]
            simp
          _ = t' * 1 := by rw [htv]
          _ = t' := by simp
      rw [← hvt']
      exact hvV
    have hxeqt' : x = t' :=
      (eq_of_mem_card_two (Tg ⊓ c.Hhat) hTgcard2 ht' hxTgH ht'ne hx_ne1).symm
    have htv : t' * v = t' := by
      rw [← hxalt]
      exact hxeqt'
    have hv1 : v = 1 := by
      apply mul_left_cancel (a := t') (b := v) (c := 1)
      simpa using htv
    exact hvne hv1

/-- The intersection of the index-seven join `H = P ⊔ S'` with `Ĥ` has
order `18` or `72`.  It is a multiple of `18` because it contains both `P`
and the order-two intersection `T₂ ∩ Ĥ`; it divides `72` because it lies in
`Ĥ`.  The middle value `36` is excluded by the Sylow-3 congruence:
`n₃(D) = [D : N_G(P) ∩ D] = 2` would contradict `n₃(D) ≡ 1 [MOD 3]`. -/
private lemma join_inter_hhat_card_eq_18_or_72
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (H : Subgroup G)
    (hPleH : (P : Subgroup G) ≤ H)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (hSleH : (S2 : Subgroup G) ≤ H) :
    Nat.card ↥(H ⊓ c.Hhat) = 18 ∨ Nat.card ↥(H ⊓ c.Hhat) = 72 := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  let K : Subgroup G := Tg ⊓ c.Hhat
  let D : Subgroup G := H ⊓ c.Hhat
  have hPleHhat : (P : Subgroup G) ≤ c.Hhat := sylow3_le_hhat hmin c hfirst d P hPU
  have hKcard : Nat.card ↥K = 2 := by
    simpa [K, NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hKleH : K ≤ H := by
    change Tg ⊓ c.Hhat ≤ H
    exact (inf_le_left : Tg ⊓ c.Hhat ≤ Tg).trans (hTgS2.trans hSleH)
  have hPKle : (P : Subgroup G) ⊔ K ≤ D := by
    change (P : Subgroup G) ⊔ K ≤ H ⊓ c.Hhat
    exact sup_le (fun x hx => ⟨hPleH hx, hPleHhat hx⟩)
      (fun x hx => ⟨hKleH hx, hx.2⟩)
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hKnorm : K ≤ Subgroup.normalizer (((P : Subgroup G) : Set G)) := by
    intro x hx
    have hTgN : Tg ≤ NP := by
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
      exact z.2
    simpa [NP] using hTgN hx.1
  have h18dvd : 18 ∣ Nat.card ↥D := by
    have hdisj : Disjoint (P : Subgroup G) K := by
      have hcop : Nat.Coprime 9 2 := by norm_num
      exact Subgroup.disjoint_of_coprime_natCard (by simpa [hP9, hKcard] using hcop)
    have hcard : Nat.card ((P : Subgroup G) ⊔ K : Subgroup G) = 18 := by
      rw [card_sup_eq_mul_of_disjoint_of_le_normalizer (P : Subgroup G) K hKnorm hdisj]
      rw [hP9, hKcard]
    have hdvd := Subgroup.card_dvd_of_le hPKle
    simpa [D, hcard] using hdvd
  have h72dvd : Nat.card ↥D ∣ 72 := by
    have hdvd : Nat.card ↥D ∣ Nat.card (↥c.Hhat) := by
      exact Subgroup.card_dvd_of_le (inf_le_right : D ≤ c.Hhat)
    have hh : Nat.card (↥c.Hhat) = 72 := hhat_card c d
    simpa [D] using hdvd.trans (by rw [hh])
  have hNleH : NP ≤ H := by
    have hNsup : NP = (P : Subgroup G) ⊔ Tg :=
      firstCase_normalizer_sylow3_sup_sylow2 hmin c hfirst d P T2
    rw [hNsup]
    exact sup_le hPleH (hTgS2.trans hSleH)
  have hne36 : Nat.card ↥D ≠ 36 := by
    intro hD36
    let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    have hPleD : (P : Subgroup G) ≤ D := by
      intro x hx
      exact ⟨hPleH hx, hPleHhat hx⟩
    have hn3 := sylow3_count_eq_relIndex D P hPleD
    have hDinterN : Nat.card ↥(D ⊓ NP) = 18 := by
      have hDNeq : D ⊓ NP = c.Hhat ⊓ NP := by
        apply le_antisymm
        · intro x hx
          exact ⟨hx.1.2, hx.2⟩
        · intro x hx
          exact ⟨⟨hNleH hx.2, hx.1⟩, hx.2⟩
      have hc : Nat.card ↥(NP ⊓ c.Hhat) = 18 := by
        simpa [NP] using firstCase_normalizer_sylow3_inter_hhat_card
          hmin c hfirst d P hPU
      rw [hDNeq]
      simpa [inf_comm] using hc
    have hrel2 : NP.relIndex D = 2 := by
      let Nsub : Subgroup (↥D) := NP.subgroupOf D
      have hNsubcard : Nat.card ↥Nsub = Nat.card ↥(NP ⊓ D) := by
        apply Nat.card_congr
        exact {
          toFun := fun x => ⟨(x.1 : G), ⟨x.2, x.1.2⟩⟩
          invFun := fun y => ⟨⟨(y : G), y.2.2⟩, y.2.1⟩
          left_inv := by
            intro x
            apply Subtype.ext
            rfl
          right_inv := by
            intro y
            apply Subtype.ext
            rfl }
      have hm := Nsub.index_mul_card
      change NP.relIndex D * Nat.card ↥Nsub = Nat.card (↥D) at hm
      have hDinterN' : Nat.card ↥(NP ⊓ D) = 18 := by
        simpa [inf_comm] using hDinterN
      rw [hNsubcard, hDinterN', hD36] at hm
      omega
    have hmod := (card_sylow_modEq_one 3 (↥D) : Nat.card (Sylow 3 (↥D)) ≡ 1 [MOD 3])
    change Nat.card (Sylow 3 (↥D)) = NP.relIndex D at hn3
    rw [hn3, hrel2] at hmod
    norm_num at hmod
  rcases h18dvd with ⟨m, hm⟩
  have hDpos : 0 < Nat.card ↥D := Nat.card_pos
  have hm4 : m ∣ 4 := by
    have hd : 18 * m ∣ 72 := by
      have hd' : Nat.card ↥D ∣ 72 := h72dvd
      rw [hm] at hd'
      exact hd'
    rw [show (72 : ℕ) = 18 * 4 by norm_num] at hd
    exact (Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 18)).mp hd
  have hmle : m ≤ 4 := Nat.le_of_dvd (by norm_num : 0 < 4) hm4
  interval_cases m
  · norm_num at hm
    exfalso
    omega
  · norm_num at hm
    left
    exact hm
  · norm_num at hm
    exfalso
    exact hne36 hm
  · norm_num at hm4
  · norm_num at hm
    right
    exact hm


/-- The intersection of a Sylow 2-subgroup `S₂` containing `T₂` with `Ĥ`
has order two: it contains the order-two intersection `T₂ ∩ Ĥ`, its order
divides eight, and the values four and eight are impossible (`8` would put
`T₂` inside `Ĥ`, contradicting `|T₂ ∩ Ĥ| = 2`). -/
private lemma sylow2_inter_hhat_card_eq_two
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    Nat.card ↥((S2 : Subgroup G) ⊓ c.Hhat) = 2 := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  let K : Subgroup G := (S2 : Subgroup G) ⊓ c.Hhat
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hK_dvd : Nat.card ↥K ∣ 8 := by
    exact (Subgroup.card_dvd_of_le (inf_le_left : K ≤ (S2 : Subgroup G))).trans
      (by rw [firstCase_sylow2_card_eight c d S2])
  have hK_ge : 2 ≤ Nat.card ↥K := by
    have hTgK : Tg ⊓ c.Hhat ≤ K := by
      intro x hx
      exact ⟨hTgS2 hx.1, hx.2⟩
    let f : ↥(Tg ⊓ c.Hhat) → ↥K := fun y => ⟨(y : G), hTgK y.2⟩
    have hf_inj : Function.Injective f := by
      intro a b h
      apply Subtype.ext
      have hG : (f a : G) = (f b : G) := congrArg (fun z : ↥K => (z : G)) h
      simpa [f] using hG
    have hle := Nat.card_le_card_of_injective f hf_inj
    rw [hTg2] at hle
    omega
  have hK_ne4 : Nat.card ↥K ≠ 4 := by
    simpa [K] using sylow2_join_inter_hhat_ne_four hmin c hfirst d P hPU T2 S2 hTgS2
  have hK_ne8 : Nat.card ↥K ≠ 8 := by
    intro h8
    have hS2leHhat : (S2 : Subgroup G) ≤ c.Hhat := by
      have hEq : K = (S2 : Subgroup G) := by
        apply Subgroup.eq_of_le_of_card_ge (H := K) (K := (S2 : Subgroup G))
          (inf_le_left : K ≤ (S2 : Subgroup G))
        rw [h8, firstCase_sylow2_card_eight c d S2]
      intro x hx
      rw [← hEq] at hx
      exact hx.2
    have hTgleHhat : Tg ≤ c.Hhat := hTgS2.trans hS2leHhat
    have hEq : Tg ⊓ c.Hhat = Tg := by
      apply le_antisymm
      · exact inf_le_left
      · intro x hx
        exact ⟨hx, hTgleHhat hx⟩
    have h4 : Nat.card ↥(Tg ⊓ c.Hhat) = 4 := by rw [hEq]; exact hTg4
    omega
  change Nat.card ↥K = 2
  rcases hK_dvd with ⟨m, hm⟩
  have hm_le : m ≤ 8 := by
    have hd : m ∣ 8 := by
      rw [mul_comm] at hm
      exact ⟨Nat.card ↥K, hm⟩
    exact Nat.le_of_dvd (by norm_num : 0 < 8) hd
  interval_cases m <;> omega

private lemma conjugateSubgroup_mul {G : Type u} [Group G] (H : Subgroup G) (g h : G) :
    conjugateSubgroup (conjugateSubgroup H h) g = conjugateSubgroup H (g * h) := by
  unfold conjugateSubgroup
  rw [Subgroup.map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply]

-- local copy of the private lemma for probing
private lemma sylow2_t2_inter_hhat_eq_s2_inter_hhat
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ⊓ c.Hhat =
    (S2 : Subgroup G) ⊓ c.Hhat := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hS2 : Nat.card ↥((S2 : Subgroup G) ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using sylow2_inter_hhat_card_eq_two hmin c hfirst d P hPU T2 S2 hTgS2
  have hle : Tg ⊓ c.Hhat ≤ (S2 : Subgroup G) ⊓ c.Hhat := by
    intro x hx
    exact ⟨hTgS2 hx.1, hx.2⟩
  change Tg ⊓ c.Hhat = (S2 : Subgroup G) ⊓ c.Hhat
  apply Subgroup.eq_of_le_of_card_ge (H := Tg ⊓ c.Hhat) (K := (S2 : Subgroup G) ⊓ c.Hhat)
    hle
  rw [hS2]
  exact hTg2.ge

private lemma sylow2_reflection_not_mem_hhat
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    r ∉ (c.Hhat : Set G) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  intro hrH
  have hEq := sylow2_t2_inter_hhat_eq_s2_inter_hhat hmin c hfirst d P hPU T2 S2 hTgS2
  have hr : r ∈ Tg := by
    have hmem : r ∈ (S2 : Subgroup G) ⊓ c.Hhat := ⟨hrS2, hrH⟩
    have hmem' : r ∈ Tg ⊓ c.Hhat := by
      rw [hEq]
      exact hmem
    exact hmem'.1
  exact hrTg hr


/-- An element of `T₂ ∖ (T₂ ∩ Ĥ)` swaps the two `U`-lines `U, W` of `P`:
it normalizes `P`, so it permutes the two conjugates of `U` inside `P`, and
it does not fix `U` (it lies outside `Ĥ = N_G(U)`). -/
private lemma sylow2_exists_t2_swap_U_W
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (U W : Subgroup G)
    (hUeq : U = c.U)
    (hUle : U ≤ (P : Subgroup G)) (hWle : W ≤ (P : Subgroup G))
    (hUconj : ∃ g : G, U = conjugateSubgroup c.U g)
    (honly : ∀ V : Subgroup G, (∃ g : G, V = conjugateSubgroup c.U g) →
      V ≤ (P : Subgroup G) → V = U ∨ V = W) :
    ∃ a : G, a ∈ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ∧
      a ∉ (c.Hhat : Set G) ∧ conjugateSubgroup U a = W := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 := (firstCase_klein_V_klein c hklein).card_four
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
  let : Fintype G := Fintype.ofFinite G
  let F : Finset G := {x : G | x ∈ Tg}.toFinset
  let E : Finset G := {x : G | x ∈ Tg ∧ x ∈ c.Hhat}.toFinset
  have hFcard : F.card = 4 := by
    have hset : ({x : G | x ∈ Tg} : Set G).ncard = 4 := by
      rw [← Nat.card_coe_set_eq]
      exact hTg4
    rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg} : Set G)]
    simpa [F] using hset
  have hEcard : E.card = 2 := by
    have hset : ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G).ncard = 2 := by
      rw [← Nat.card_coe_set_eq]
      exact hTg2
    rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G)]
    simpa [E] using hset
  have hlt : E.card < F.card := by omega
  rcases Finset.exists_mem_notMem_of_card_lt_card hlt with ⟨a, haF, haE⟩
  have haTg : a ∈ Tg := by simpa [F] using haF
  have haHhat : ¬ a ∈ (c.Hhat : Set G) := by
    intro h
    apply haE
    simpa [E] using ⟨haTg, h⟩
  have hconj_a : conjugateSubgroup U a = W := by
    have hUconj_a : ∃ g : G, conjugateSubgroup U a = conjugateSubgroup c.U g := by
      rcases hUconj with ⟨g, rfl⟩
      exact ⟨a * g, conjugateSubgroup_mul c.U a g⟩
    have hUa_le : conjugateSubgroup U a ≤ (P : Subgroup G) := by
      have hN : a ∈ NP := hTgNP haTg
      have hmap : (U.map (MulAut.conj a) : Subgroup G) ≤ P := by
        intro x hx
        rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
        change a * u * a⁻¹ ∈ (P : Subgroup G)
        exact (Subgroup.mem_normalizer_iff.mp hN u).mp (hUle hu)
      simpa [conjugateSubgroup] using hmap
    have hUa_ne_U : conjugateSubgroup U a ≠ U := by
      rw [hUeq]
      intro hEq
      apply haHhat
      rw [← hNormU]
      change a ∈ Subgroup.normalizer (c.U : Set G)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      change c.U.map (MulAut.conj a) = c.U
      simpa [conjugateSubgroup] using hEq
    rcases honly (conjugateSubgroup U a) hUconj_a hUa_le with h1 | h2
    · exact False.elim (hUa_ne_U h1)
    · exact h2
  exact ⟨a, haTg, haHhat, hconj_a⟩

/-- The reflection `r ∈ S₂ ∖ T₂` does not map the `U`-line `U = c.U` of `P`
to the other `U`-line `W` of `P`.  If it did, then `r² ∈ T₂` maps `U`
either to itself or to `W`; in the first case `r · a` lies in
`Ĥ ∩ S₂ = T₂ ∩ Ĥ` for the transposition `a ∈ T₂ ∖ (T₂ ∩ Ĥ)` and hence
`r ∈ T₂`, and in the second case `r` fixes both `U` and `W`,
contradicting injectivity of conjugation. -/
private lemma sylow2_reflection_not_swap_U
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (U W : Subgroup G)
    (hUeq : U = c.U)
    (hUle : U ≤ (P : Subgroup G)) (hWle : W ≤ (P : Subgroup G))
    (hUneW : U ≠ W)
    (hUconj : ∃ g : G, U = conjugateSubgroup c.U g)
    (hWconj : ∃ g : G, W = conjugateSubgroup c.U g)
    (honly : ∀ V : Subgroup G, (∃ g : G, V = conjugateSubgroup c.U g) →
      V ≤ (P : Subgroup G) → V = U ∨ V = W) :
    ¬ (conjugateSubgroup U r = W) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 := (firstCase_klein_V_klein c hklein).card_four
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
  rcases sylow2_exists_t2_swap_U_W hmin c hfirst d P hPU T2 U W hUeq hUle hWle hUconj honly with
    ⟨a, haTg, haHhat, hconj_a⟩
  have hr2 : r ^ 2 ∈ Tg :=
    sylow2_reflection_sq_mem hmin c hfirst d P T2 S2 r hrS2 hrTg hTgS2
  have hr2_normalizes : (r ^ 2) ∈ NP := hTgNP hr2
  have hr2U_conj : ∃ g : G, conjugateSubgroup U (r ^ 2) = conjugateSubgroup c.U g := by
    rcases hUconj with ⟨g, rfl⟩
    exact ⟨(r ^ 2) * g, conjugateSubgroup_mul c.U (r ^ 2) g⟩
  have hr2U_le : conjugateSubgroup U (r ^ 2) ≤ (P : Subgroup G) := by
    have hmap : (U.map (MulAut.conj (r ^ 2)) : Subgroup G) ≤ P := by
      intro x hx
      rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
      change (r ^ 2) * u * (r ^ 2)⁻¹ ∈ (P : Subgroup G)
      exact (Subgroup.mem_normalizer_iff.mp hr2_normalizes u).mp (hUle hu)
    simpa [conjugateSubgroup] using hmap
  have hr2U : conjugateSubgroup U (r ^ 2) = U ∨ conjugateSubgroup U (r ^ 2) = W :=
    honly (conjugateSubgroup U (r ^ 2)) hr2U_conj hr2U_le
  intro hswap
  rcases hr2U with hr2U_eq | hr2U_eq
  · have hrWU : conjugateSubgroup W r = U := by
      calc
        conjugateSubgroup W r = conjugateSubgroup (conjugateSubgroup U r) r := by rw [hswap]
        _ = conjugateSubgroup U (r * r) := conjugateSubgroup_mul U r r
        _ = conjugateSubgroup U (r ^ 2) := by rw [pow_two]
        _ = U := hr2U_eq
    have hra : conjugateSubgroup U (r * a) = U := by
      rw [← conjugateSubgroup_mul U r a, hconj_a, hrWU]
    have hraHhat : r * a ∈ (c.Hhat : Set G) := by
      have hN : r * a ∈ Subgroup.normalizer (c.U : Set G) := by
        rw [Subgroup.mem_normalizer_iff_map_conj_eq]
        change c.U.map (MulAut.conj (r * a)) = c.U
        have hra' : conjugateSubgroup c.U (r * a) = c.U := by
          rwa [hUeq] at hra
        simpa [conjugateSubgroup] using hra'
      rw [← hNormU]
      change r * a ∈ Subgroup.normalizer (c.U : Set G)
      exact hN
    have hraS2 : r * a ∈ (S2 : Subgroup G) :=
      (S2 : Subgroup G).mul_mem hrS2 (hTgS2 haTg)
    have hEq := sylow2_t2_inter_hhat_eq_s2_inter_hhat hmin c hfirst d P hPU T2 S2 hTgS2
    have hraTg : r * a ∈ Tg := by
      have hmem : r * a ∈ (S2 : Subgroup G) ⊓ c.Hhat := ⟨hraS2, hraHhat⟩
      have hmem' : r * a ∈ Tg ⊓ c.Hhat := by
        rw [hEq]
        exact hmem
      exact hmem'.1
    have hrane : r * a ≠ 1 := by
      intro h1
      apply hrTg
      have hr : r = a⁻¹ := by
        calc
          r = (r * a) * a⁻¹ := by group
          _ = 1 * a⁻¹ := by rw [h1]
          _ = a⁻¹ := by simp
      rw [hr]
      exact Tg.inv_mem haTg
    have hrTg' : r ∈ Tg := by
      have h : r = (r * a) * a⁻¹ := by group
      rw [h]
      exact Tg.mul_mem hraTg (Tg.inv_mem haTg)
    exact hrTg hrTg'
  · have hrWW : conjugateSubgroup W r = W := by
      calc
        conjugateSubgroup W r = conjugateSubgroup (conjugateSubgroup U r) r := by rw [hswap]
        _ = conjugateSubgroup U (r * r) := conjugateSubgroup_mul U r r
        _ = conjugateSubgroup U (r ^ 2) := by rw [pow_two]
        _ = W := hr2U_eq
    have hUU : U = W := by
      have hEq : conjugateSubgroup U r = conjugateSubgroup W r := by rw [hswap, hrWW]
      have hinj : Function.Injective (fun H : Subgroup G => conjugateSubgroup H r) := by
        intro H1 H2 h
        unfold conjugateSubgroup at h
        exact Subgroup.map_injective (MulAut.conj r).injective h
      exact hinj hEq
    exact hUneW hUU


/-- The reflection `r ∈ S₂ ∖ T₂` does not map the `U`-line `W` of `P` to
`U`: otherwise `r⁻¹` would map `U` to `W`, contradicting
`sylow2_reflection_not_swap_U`. -/
private lemma sylow2_reflection_not_swap_U_sym
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (U W : Subgroup G)
    (hUeq : U = c.U)
    (hUle : U ≤ (P : Subgroup G)) (hWle : W ≤ (P : Subgroup G))
    (hUneW : U ≠ W)
    (hUconj : ∃ g : G, U = conjugateSubgroup c.U g)
    (hWconj : ∃ g : G, W = conjugateSubgroup c.U g)
    (honly : ∀ V : Subgroup G, (∃ g : G, V = conjugateSubgroup c.U g) →
      V ≤ (P : Subgroup G) → V = U ∨ V = W) :
    ¬ (conjugateSubgroup W r = U) := by
  have hriS2 : r⁻¹ ∈ (S2 : Subgroup G) := (S2 : Subgroup G).inv_mem hrS2
  have hriTg : r⁻¹ ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) := by
    intro h
    apply hrTg
    have hmem : (r⁻¹)⁻¹ ∈ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) :=
      ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
        (Subgroup.normalizer (P : Set G)).subtype).inv_mem h
    simpa using hmem
  have hswap := sylow2_reflection_not_swap_U hmin c hfirst d P hPU T2 S2 r⁻¹ hriS2 hriTg hTgS2
    U W hUeq hUle hWle hUneW hUconj hWconj honly
  intro h
  apply hswap
  calc
    conjugateSubgroup U r⁻¹ = conjugateSubgroup (conjugateSubgroup W r) r⁻¹ := by rw [h]
    _ = conjugateSubgroup W (r⁻¹ * r) := by
      exact conjugateSubgroup_mul W r⁻¹ r
    _ = conjugateSubgroup W 1 := by rw [inv_mul_cancel]
    _ = W := by
      ext x
      simp [conjugateSubgroup]

-- r • W ≠ W : otherwise r a ∈ Ĥ ∩ S₂ = T₂ ∩ Ĥ forces r ∈ T₂
/-- The reflection `r ∈ S₂ ∖ T₂` does not fix the `U`-line `W` of `P`:
with `a ∈ T₂ ∖ (T₂ ∩ Ĥ)` swapping `U` and `W`, fixing `W` would put
`a⁻¹ r a ∈ Ĥ ∩ S₂ = T₂ ∩ Ĥ`, forcing `r ∈ T₂`. -/
private lemma sylow2_reflection_not_fix_W
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (U W : Subgroup G)
    (hUeq : U = c.U)
    (hUle : U ≤ (P : Subgroup G)) (hWle : W ≤ (P : Subgroup G))
    (hUneW : U ≠ W)
    (hUconj : ∃ g : G, U = conjugateSubgroup c.U g)
    (hWconj : ∃ g : G, W = conjugateSubgroup c.U g)
    (honly : ∀ V : Subgroup G, (∃ g : G, V = conjugateSubgroup c.U g) →
      V ≤ (P : Subgroup G) → V = U ∨ V = W) :
    ¬ (conjugateSubgroup W r = W) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hTg4 : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
    simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
      hmin c hfirst d P hPU T2
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 := (firstCase_klein_V_klein c hklein).card_four
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
  let : Fintype G := Fintype.ofFinite G
  let F : Finset G := {x : G | x ∈ Tg}.toFinset
  let E : Finset G := {x : G | x ∈ Tg ∧ x ∈ c.Hhat}.toFinset
  have hFcard : F.card = 4 := by
    have hset : ({x : G | x ∈ Tg} : Set G).ncard = 4 := by
      rw [← Nat.card_coe_set_eq]
      exact hTg4
    rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg} : Set G)]
    simpa [F] using hset
  have hEcard : E.card = 2 := by
    have hset : ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G).ncard = 2 := by
      rw [← Nat.card_coe_set_eq]
      exact hTg2
    rw [← Set.ncard_eq_toFinset_card' ({x : G | x ∈ Tg ∧ x ∈ c.Hhat} : Set G)]
    simpa [E] using hset
  have hlt : E.card < F.card := by omega
  rcases Finset.exists_mem_notMem_of_card_lt_card hlt with ⟨a, haF, haE⟩
  have haTg : a ∈ Tg := by simpa [F] using haF
  have haHhat : ¬ a ∈ (c.Hhat : Set G) := by
    intro h
    apply haE
    simpa [E] using ⟨haTg, h⟩
  -- a swaps U and W: a•U = W
  have haU : conjugateSubgroup U a = W := by
    have hUconj_a : ∃ g : G, conjugateSubgroup U a = conjugateSubgroup c.U g := by
      rcases hUconj with ⟨g, rfl⟩
      exact ⟨a * g, by
        unfold conjugateSubgroup
        rw [Subgroup.map_map]
        congr 1
        ext x
        simp [MulAut.conj_apply]⟩
    have hUa_le : conjugateSubgroup U a ≤ (P : Subgroup G) := by
      have hTgNP : Tg ≤ NP := by
        intro y hy
        rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
        exact z.2
      have hN : a ∈ NP := hTgNP haTg
      have hmap : (U.map (MulAut.conj a) : Subgroup G) ≤ P := by
        intro x hx
        rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
        change a * u * a⁻¹ ∈ (P : Subgroup G)
        exact (Subgroup.mem_normalizer_iff.mp hN u).mp (hUle hu)
      simpa [conjugateSubgroup] using hmap
    have hUa_ne_U : conjugateSubgroup U a ≠ U := by
      rw [hUeq]
      intro hEq
      apply haHhat
      rw [← hNormU]
      · change a ∈ Subgroup.normalizer (c.U : Set G)
        rw [Subgroup.mem_normalizer_iff_map_conj_eq]
        change c.U.map (MulAut.conj a) = c.U
        simpa [conjugateSubgroup] using hEq
    rcases honly (conjugateSubgroup U a) hUconj_a hUa_le with h1 | h2
    · exact False.elim (hUa_ne_U h1)
    · exact h2
  -- a⁻¹ r a fixes U: (a⁻¹ r a)•U = a⁻¹•(r•(a•U)) = a⁻¹•(r•W) = a⁻¹•W = U,
  -- so a⁻¹ r a ∈ Ĥ ∩ S₂ = Tg ∩ Ĥ, forcing r ∈ Tg
  intro hfix
  have hWa : conjugateSubgroup W a⁻¹ = U := by
    calc
      conjugateSubgroup W a⁻¹ = conjugateSubgroup (conjugateSubgroup U a) a⁻¹ := by rw [haU]
      _ = conjugateSubgroup U (a⁻¹ * a) := conjugateSubgroup_mul U a⁻¹ a
      _ = conjugateSubgroup U 1 := by rw [inv_mul_cancel]
      _ = U := by
        ext x
        simp [conjugateSubgroup]
  have haraU : conjugateSubgroup U (a⁻¹ * r * a) = U := by
    calc
      conjugateSubgroup U (a⁻¹ * r * a) = conjugateSubgroup (conjugateSubgroup U a) (a⁻¹ * r) := by
        rw [conjugateSubgroup_mul U (a⁻¹ * r) a]
      _ = conjugateSubgroup (conjugateSubgroup (conjugateSubgroup U a) r) a⁻¹ := by
        rw [← conjugateSubgroup_mul (conjugateSubgroup U a) a⁻¹ r]
      _ = conjugateSubgroup (conjugateSubgroup W r) a⁻¹ := by rw [haU]
      _ = conjugateSubgroup W a⁻¹ := by rw [hfix]
      _ = U := hWa
  have haraHhat : a⁻¹ * r * a ∈ (c.Hhat : Set G) := by
    have hN : a⁻¹ * r * a ∈ Subgroup.normalizer (c.U : Set G) := by
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      change c.U.map (MulAut.conj (a⁻¹ * r * a)) = c.U
      have haraU' : conjugateSubgroup c.U (a⁻¹ * r * a) = c.U := by
        rwa [hUeq] at haraU
      simpa [conjugateSubgroup] using haraU'
    rw [← hNormU]
    · exact hN
  have haraS2 : a⁻¹ * r * a ∈ (S2 : Subgroup G) :=
    (S2 : Subgroup G).mul_mem
      ((S2 : Subgroup G).mul_mem ((S2 : Subgroup G).inv_mem (hTgS2 haTg)) hrS2)
      (hTgS2 haTg)
  have hEq := sylow2_t2_inter_hhat_eq_s2_inter_hhat hmin c hfirst d P hPU T2 S2 hTgS2
  have haraTg : a⁻¹ * r * a ∈ Tg := by
    have hmem : a⁻¹ * r * a ∈ (S2 : Subgroup G) ⊓ c.Hhat := ⟨haraS2, haraHhat⟩
    have hmem' : a⁻¹ * r * a ∈ Tg ⊓ c.Hhat := by
      rw [hEq]
      exact hmem
    exact hmem'.1
  have hrTg' : r ∈ Tg := by
    have h : r = a * (a⁻¹ * r * a) * a⁻¹ := by group
    rw [h]
    exact Tg.mul_mem (Tg.mul_mem haTg haraTg) (Tg.inv_mem haTg)
  exact hrTg hrTg'


/-- `S₂` centralizes no nontrivial element of `U` (Suzuki's
`S' ∩ C_G(U) = e`): the only candidate would be the nonidentity element of
`S₂ ∩ Ĥ`, which inverts `U`. -/
private lemma sylow2_centralizer_U_eq_one
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    Nat.card ↥((S2 : Subgroup G) ⊓ Subgroup.centralizer (c.U : Set G)) = 1 := by
  classical
  let C : Subgroup G := (S2 : Subgroup G) ⊓ Subgroup.centralizer (c.U : Set G)
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 := (firstCase_klein_V_klein c hklein).card_four
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
  have hCle : C ≤ (S2 : Subgroup G) ⊓ c.Hhat := by
    intro x hx
    exact ⟨hx.1, by
      have hxN : x ∈ Subgroup.normalizer (c.U : Set G) :=
        (Subgroup.centralizer_le_normalizer (c.U : Set G)) hx.2
      rwa [hNormU] at hxN⟩
  have hS2H2 : Nat.card ↥((S2 : Subgroup G) ⊓ c.Hhat) = 2 :=
    sylow2_inter_hhat_card_eq_two hmin c hfirst d P hPU T2 S2 hTgS2
  have hCdvd : Nat.card ↥C ∣ 2 := by
    exact (Subgroup.card_dvd_of_le hCle).trans (by rw [hS2H2])
  have hCne2 : Nat.card ↥C ≠ 2 := by
    intro hC2
    have hx : ∃ x : G, x ∈ C ∧ x ≠ 1 := by
      classical
      let α := {x : G // x ∈ C}
      have hgt : 1 < Nat.card α := by
        rw [hC2]
        norm_num
      have hnt : Nontrivial α := (Finite.one_lt_card_iff_nontrivial).mp hgt
      rcases exists_ne (⟨1, by simp [C]⟩ : α) with ⟨b, hb⟩
      exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
    rcases hx with ⟨x, hxC, hxne⟩
    have hxSH : x ∈ (S2 : Subgroup G) ⊓ c.Hhat := hCle hxC
    let NP : Subgroup G := Subgroup.normalizer (P : Set G)
    let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
    have hTg2 : Nat.card ↥(Tg ⊓ c.Hhat) = 2 := by
      simpa [NP, Tg] using firstCase_normalizer_sylow3_sylow2_inter_hhat_card_two
        hmin c hfirst d P hPU T2
    have hxT : ∃ t' : G, t' ∈ Tg ⊓ c.Hhat ∧ t' ≠ 1 := by
      classical
      let α := {x : G // x ∈ Tg ⊓ c.Hhat}
      have hgt : 1 < Nat.card α := by
        rw [hTg2]
        norm_num
      have hnt : Nontrivial α := (Finite.one_lt_card_iff_nontrivial).mp hgt
      rcases exists_ne (⟨1, by simp⟩ : α) with ⟨b, hb⟩
      exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
    rcases hxT with ⟨t', ht', ht'ne⟩
    have ht'SH : t' ∈ (S2 : Subgroup G) ⊓ c.Hhat := ⟨hTgS2 ht'.1, ht'.2⟩
    have hxeq : x = t' :=
      eq_of_mem_card_two ((S2 : Subgroup G) ⊓ c.Hhat) hS2H2 hxSH ht'SH hxne ht'ne
    have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
    have hu : ∃ u : G, u ∈ c.U ∧ u ≠ 1 := by
      classical
      have hgt : 1 < Nat.card c.U := by
        rw [hU3]
        norm_num
      have hnt : Nontrivial c.U := (Finite.one_lt_card_iff_nontrivial).mp hgt
      rcases exists_ne (⟨1, by simp⟩ : c.U) with ⟨b, hb⟩
      exact ⟨(b : G), b.2, fun hb1 => hb (Subtype.ext hb1)⟩
    rcases hu with ⟨u, huU, hune⟩
    have hcent : t' * u * t'⁻¹ = u := by
      have hxC' : x ∈ Subgroup.centralizer (c.U : Set G) := hxC.2
      have hcomm : u * x = x * u := Subgroup.mem_centralizer_iff.mp hxC' u huU
      rw [hxeq] at hcomm
      rw [← hcomm]
      group
    have hinv : t' * u * t'⁻¹ = u⁻¹ :=
      firstCase_t2_inter_hhat_inverts_U hmin c hfirst d P hPU T2 t' ht' ht'ne u huU
    have hu2 : u = u⁻¹ := by
      rw [← hinv]
      exact hcent.symm
    have huu : u * u = 1 := by
      nth_rewrite 2 [hu2]
      group
    have hu2eq : u ^ 2 = 1 := by
      simpa [pow_two] using huu
    have hord2 : orderOf u ∣ 2 := by
      rw [orderOf_dvd_iff_pow_eq_one]
      simpa [pow_two] using hu2eq
    have hord3 : orderOf u ∣ 3 := by
      have hdvd := Subgroup.orderOf_dvd_natCard c.U huU
      rwa [hU3] at hdvd
    have hord1 : orderOf u = 1 := by
      have hg : Nat.gcd 2 3 = 1 := by norm_num
      have hd : orderOf u ∣ Nat.gcd 2 3 := Nat.dvd_gcd hord2 hord3
      rw [hg] at hd
      exact Nat.dvd_one.mp hd
    exact hune (orderOf_eq_one_iff.mp hord1)
  rcases (Nat.dvd_prime Nat.prime_two).mp hCdvd with h1 | h2
  · exact h1
  · exfalso
    exact hCne2 h2

/-- The stabilizer of `U` in the conjugation action of `S₂` is
`S₂ ∩ N_G(U) = S₂ ∩ Ĥ`. -/
private lemma sylow2_stabilizer_U_eq_inter_hhat
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    MulAction.stabilizer (↥(S2 : Subgroup G)) (UConjugates.base c) =
      ((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G) := by
  classical
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 := (firstCase_klein_V_klein c hklein).card_four
    omega
  have hUne : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUne
  have hstabG : MulAction.stabilizer G (UConjugates.base c) =
      Subgroup.normalizer (c.U : Set G) := by
    ext g
    constructor
    · intro hg
      rw [MulAction.mem_stabilizer_iff] at hg
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      have hv := congrArg Subtype.val hg
      rw [UConjugates.smul_def] at hv
      simpa [UConjugates.base, conjugateSubgroup] using hv
    · intro hg
      rw [MulAction.mem_stabilizer_iff]
      apply Subtype.ext
      rw [UConjugates.smul_def]
      change conjugateSubgroup (↑(UConjugates.base c)) g = ↑(UConjugates.base c)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hg
      simpa [UConjugates.base, conjugateSubgroup] using hg
  ext x
  constructor
  · intro hx
    rw [MulAction.mem_stabilizer_iff] at hx
    rw [Subgroup.mem_subgroupOf]
    constructor
    · exact x.2
    · have hxG : (x : G) ∈ MulAction.stabilizer G (UConjugates.base c) := by
        rw [MulAction.mem_stabilizer_iff]
        change (x : G) • UConjugates.base c = UConjugates.base c at hx
        exact hx
      have hxN : (x : G) ∈ Subgroup.normalizer (c.U : Set G) := by
        rw [hstabG] at hxG
        exact hxG
      rwa [hNormU] at hxN
  · intro hx
    rw [MulAction.mem_stabilizer_iff]
    have hxS : (x : G) ∈ (S2 : Subgroup G) := (Subgroup.mem_subgroupOf.mp hx).1
    have hxH : (x : G) ∈ c.Hhat := (Subgroup.mem_subgroupOf.mp hx).2
    have hxN : (x : G) ∈ Subgroup.normalizer (c.U : Set G) := by
      rw [hNormU]
      exact hxH
    have hxG : (x : G) ∈ MulAction.stabilizer G (UConjugates.base c) := by
      rw [hstabG]
      exact hxN
    change (x : G) • UConjugates.base c = UConjugates.base c
    exact (MulAction.mem_stabilizer_iff.mp hxG)

/-- The `S₂`-orbit of the `U`-line has four elements: the orbit-stabilizer
theorem with `|S₂| = 8` and `|S₂ ∩ Ĥ| = 2`. -/
private lemma sylow2_orbit_U_card_eq_four
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G)) :
    Nat.card (MulAction.orbit (↥(S2 : Subgroup G)) (UConjugates.base c)) = 4 := by
  classical
  let G' : Type u := ↥(S2 : Subgroup G)
  have hstab : MulAction.stabilizer G' (UConjugates.base c) =
      ((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G) :=
    sylow2_stabilizer_U_eq_inter_hhat hmin c hfirst d P hPU T2 S2 hTgS2
  have hcardOrbit : Nat.card (MulAction.orbit G' (UConjugates.base c)) =
      (MulAction.stabilizer G' (UConjugates.base c)).index := by
    calc
      Nat.card (MulAction.orbit G' (UConjugates.base c)) =
          Nat.card (G' ⧸ MulAction.stabilizer G' (UConjugates.base c)) :=
            Nat.card_congr (MulAction.orbitEquivQuotientStabilizer G' (UConjugates.base c))
      _ = (MulAction.stabilizer G' (UConjugates.base c)).index :=
            (MulAction.stabilizer G' (UConjugates.base c)).index_eq_card.symm
  rw [hcardOrbit, hstab]
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hS2H2 : Nat.card ↥((S2 : Subgroup G) ⊓ c.Hhat) = 2 :=
    sylow2_inter_hhat_card_eq_two hmin c hfirst d P hPU T2 S2 hTgS2
  have hcardSub : Nat.card ↥(((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G)) = 2 := by
    exact (Nat.card_congr
      (Subgroup.subgroupOfEquivOfLe (inf_le_left : (S2 : Subgroup G) ⊓ c.Hhat ≤ (S2 : Subgroup G))).toEquiv).trans
      hS2H2
  have hindex := (((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G)).index_mul_card
  have hmul : (((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G)).index * 2 = 8 := by
    calc
      (((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G)).index * 2 =
          (((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G)).index *
            Nat.card ↥(((S2 : Subgroup G) ⊓ c.Hhat).subgroupOf (S2 : Subgroup G)) := by
            rw [hcardSub]
      _ = 8 := by
        rw [hindex, hS2card]
  omega

/-- Four elements of a finset are pairwise distinct iff the finset has
cardinality four. -/
private lemma finset_card_four {α : Type*} [DecidableEq α]
    {a b c d : α} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ({a, b, c, d} : Finset α).card = 4 := by
  simp [hab, hac, had, hbc, hbd, hcd]

/-- The four `U`-lines `U, W, r·U, r·W` are distinct, and each lies in the
`S₂`-orbit of `U`. -/
private lemma sylow2_orbit_U_eq_four_lines
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (r : G)
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (U W : Subgroup G)
    (hUeq : U = c.U)
    (hUle : U ≤ (P : Subgroup G)) (hWle : W ≤ (P : Subgroup G))
    (hUneW : U ≠ W)
    (hUconj : ∃ g : G, U = conjugateSubgroup c.U g)
    (hWconj : ∃ g : G, W = conjugateSubgroup c.U g)
    (honly : ∀ V : Subgroup G, (∃ g : G, V = conjugateSubgroup c.U g) →
      V ≤ (P : Subgroup G) → V = U ∨ V = W) :
    (U ≠ conjugateSubgroup U r ∧ U ≠ conjugateSubgroup W r ∧
      W ≠ conjugateSubgroup U r ∧ W ≠ conjugateSubgroup W r ∧
      conjugateSubgroup U r ≠ conjugateSubgroup W r) ∧
      ∀ H : Subgroup G,
        H = U ∨ H = W ∨ H = conjugateSubgroup U r ∨ H = conjugateSubgroup W r →
          ∃ V : UConjugates c,
        V ∈ MulAction.orbit (↥(S2 : Subgroup G)) (UConjugates.base c) ∧ V.1 = H := by
  classical
  have hO2 : twoCoreOf c.Hhat ≠ ⊥ := by
    have hklein : IsKleinFour (pCore 2 c.Hhat) := firstCase_twoCore_isKleinFour hmin c hfirst
    intro hbot
    have hc : Nat.card (twoCoreOf c.Hhat) = 1 := by rw [hbot]; simp
    have h4 : Nat.card (twoCoreOf c.Hhat) = 4 := (firstCase_klein_V_klein c hklein).card_four
    omega
  have hUneC : c.U ≠ ⊥ := (lemma_2_2 hmin c).2
  have hNormU : Subgroup.normalizer (c.U : Set G) = c.Hhat :=
    theorem26_normalizer_U_eq_Hhat hmin c hO2 hUneC
  have hUneqUr : U ≠ conjugateSubgroup U r := by
    intro hEq
    have hrH : r ∈ (c.Hhat : Set G) := by
      rw [← hNormU]
      change r ∈ Subgroup.normalizer (c.U : Set G)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      change c.U.map (MulAut.conj r) = c.U
      have hEq' : conjugateSubgroup c.U r = c.U := by
        rw [hUeq] at hEq
        exact hEq.symm
      change conjugateSubgroup c.U r = c.U
      exact hEq'
    exact sylow2_reflection_not_mem_hhat hmin c hfirst d P hPU T2 S2 r hrS2 hrTg hTgS2 hrH
  have hUrneWr : conjugateSubgroup U r ≠ conjugateSubgroup W r := by
    intro h
    apply hUneW
    have hinj : Function.Injective (fun H : Subgroup G => conjugateSubgroup H r) := by
      intro A B hAB
      unfold conjugateSubgroup at hAB
      exact Subgroup.map_injective (MulAut.conj r).injective hAB
    exact hinj h
  constructor
  · exact ⟨hUneqUr, ⟨
      (fun h => sylow2_reflection_not_swap_U_sym hmin c hfirst d P hPU T2 S2 r hrS2 hrTg hTgS2
        U W hUeq hUle hWle hUneW hUconj hWconj honly (h.symm)), ⟨
      (fun h => sylow2_reflection_not_swap_U hmin c hfirst d P hPU T2 S2 r hrS2 hrTg hTgS2
        U W hUeq hUle hWle hUneW hUconj hWconj honly (h.symm)), ⟨
      (fun h => sylow2_reflection_not_fix_W hmin c hfirst d P hPU T2 S2 r hrS2 hrTg hTgS2
        U W hUeq hUle hWle hUneW hUconj hWconj honly (h.symm)), hUrneWr⟩⟩⟩⟩
  · rcases sylow2_exists_t2_swap_U_W hmin c hfirst d P hPU T2 U W hUeq hUle hWle hUconj honly with
      ⟨a, haTg, _haHhat, haU⟩
    intro H hH
    rcases hH with hH | hH | hH | hH
    · refine ⟨UConjugates.base c, ?_⟩
      constructor
      · exact ⟨1, by simp⟩
      · simpa [UConjugates.base] using (hUeq.symm.trans hH.symm)
    · let V : UConjugates c := (⟨a, hTgS2 haTg⟩ : ↥(S2 : Subgroup G)) • UConjugates.base c
      refine ⟨V, ?_⟩
      constructor
      · exact ⟨⟨a, hTgS2 haTg⟩, rfl⟩
      · show ((⟨a, hTgS2 haTg⟩ : ↥(S2 : Subgroup G)) • UConjugates.base c).1 = H
        change ((a : G) • UConjugates.base c).1 = H
        rw [UConjugates.smul_def]
        change conjugateSubgroup (↑(UConjugates.base c)) a = H
        rw [UConjugates.base_val]
        change conjugateSubgroup c.U a = H
        have haU' : conjugateSubgroup c.U a = W := by
          rwa [hUeq] at haU
        exact haU'.trans hH.symm
    · let V : UConjugates c := (⟨r, hrS2⟩ : ↥(S2 : Subgroup G)) • UConjugates.base c
      refine ⟨V, ?_⟩
      constructor
      · exact ⟨⟨r, hrS2⟩, rfl⟩
      · show ((⟨r, hrS2⟩ : ↥(S2 : Subgroup G)) • UConjugates.base c).1 = H
        change ((r : G) • UConjugates.base c).1 = H
        rw [UConjugates.smul_def]
        change conjugateSubgroup (↑(UConjugates.base c)) r = H
        rw [UConjugates.base_val]
        change conjugateSubgroup c.U r = H
        rw [← hUeq]
        exact hH.symm
    · let V : UConjugates c :=
        (⟨r * a, (S2 : Subgroup G).mul_mem hrS2 (hTgS2 haTg)⟩ : ↥(S2 : Subgroup G)) •
          UConjugates.base c
      refine ⟨V, ?_⟩
      constructor
      · exact ⟨⟨r * a, (S2 : Subgroup G).mul_mem hrS2 (hTgS2 haTg)⟩, rfl⟩
      · show ((⟨r * a, (S2 : Subgroup G).mul_mem hrS2 (hTgS2 haTg)⟩ : ↥(S2 : Subgroup G)) •
          UConjugates.base c).1 = H
        change ((r * a : G) • UConjugates.base c).1 = H
        rw [UConjugates.smul_def]
        change conjugateSubgroup (↑(UConjugates.base c)) (r * a) = H
        rw [UConjugates.base_val]
        change conjugateSubgroup c.U (r * a) = H
        rw [← hUeq, ← conjugateSubgroup_mul U r a, haU, ← hH]


/-- A Sylow 3-subgroup of the first case is elementary abelian: every
element has order dividing three.  `P` is a group of order `3²`, hence
commutative; it contains two distinct conjugates `U₁, U₂` of `U`
(`firstCase_sylow3_two_UConjugates_inside`), each of order three with
trivial intersection, and `P = U₁ ⊔ U₂`, so every element is a product
`u₁ · u₂` of order-three elements and has cube equal to one. -/

private lemma sylow3_order_three
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (p : G) (hp : p ∈ (P : Subgroup G)) :
    p ^ 3 = 1 := by
  classical
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hP9' : Nat.card (P : Subgroup G) = 3 ^ 2 := by simpa using hP9
  have : IsMulCommutative (P : Subgroup G) :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9'
  have hcommP : ∀ a b : G, a ∈ (P : Subgroup G) → b ∈ (P : Subgroup G) →
      a * b = b * a := by
    intro a b ha hb
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9').is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hU3 : Nat.card c.U = 3 := firstCase_U_card_three hmin c hfirst d
  rcases firstCase_sylow3_two_UConjugates_inside hmin c hfirst d P with
    ⟨U1, U2, hU1neU2, hU1le, hU2le, hU1conj, hU2conj⟩
  have hU13 : Nat.card U1 = 3 := by
    rcases hU1conj with ⟨g, rfl⟩
    have hcard : Nat.card (conjugateSubgroup c.U g) = Nat.card c.U := by
      exact (Nat.card_congr (Subgroup.equivMapOfInjective c.U
        (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).toEquiv).symm
    rw [hcard]
    exact hU3
  have hU23 : Nat.card U2 = 3 := by
    rcases hU2conj with ⟨g, rfl⟩
    have hcard : Nat.card (conjugateSubgroup c.U g) = Nat.card c.U := by
      exact (Nat.card_congr (Subgroup.equivMapOfInjective c.U
        (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).toEquiv).symm
    rw [hcard]
    exact hU3
  have hdisj : Disjoint U1 U2 := by
    rw [disjoint_iff_inf_le]
    intro x hx
    by_contra hxne
    have hord : orderOf x = 3 := by
      have hdvd := Subgroup.orderOf_dvd_natCard U1 hx.1
      rw [hU13] at hdvd
      rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
      · exfalso
        exact hxne (orderOf_eq_one_iff.mp h1)
      · exact h3
    have hzU1 : Subgroup.zpowers x = U1 := by
      apply Subgroup.eq_of_le_of_card_ge
      · intro y hy
        rcases Subgroup.mem_zpowers_iff.mp hy with ⟨n, rfl⟩
        exact U1.zpow_mem hx.1 n
      · rw [Nat.card_zpowers, hord, hU13]
    have hzU2 : Subgroup.zpowers x = U2 := by
      apply Subgroup.eq_of_le_of_card_ge
      · intro y hy
        rcases Subgroup.mem_zpowers_iff.mp hy with ⟨n, rfl⟩
        exact U2.zpow_mem hx.2 n
      · rw [Nat.card_zpowers, hord, hU23]
    exact hU1neU2 (hzU1.symm.trans hzU2)
  have hsup_le_P : U1 ⊔ U2 ≤ (P : Subgroup G) := sup_le hU1le hU2le
  have hsup_card : Nat.card ↥(U1 ⊔ U2 : Subgroup G) = 9 := by
    have hnorm : U2 ≤ Subgroup.normalizer (U1 : Set G) := by
      rw [Subgroup.le_normalizer_iff]
      intro x hx u hu
      have hxy : x * u * x⁻¹ = u := by
        calc
          x * u * x⁻¹ = u * x * x⁻¹ := by rw [hcommP x u (hU2le hx) (hU1le hu)]
          _ = u := by group
      rw [hxy]
      exact hu
    rw [card_sup_eq_mul_of_disjoint_of_le_normalizer U1 U2 hnorm hdisj]
    rw [hU13, hU23]
  have hP_eq_sup : (P : Subgroup G) = U1 ⊔ U2 := by
    symm
    apply Subgroup.eq_of_le_of_card_ge (H := U1 ⊔ U2) (K := (P : Subgroup G))
      hsup_le_P
    rw [hP9]
    exact hsup_card.ge
  have hp_sup : p ∈ (U1 ⊔ U2 : Subgroup G) := by
    rw [← hP_eq_sup]
    exact hp
  rcases (mem_sup_product U1 U2 (by
    rw [Subgroup.le_normalizer_iff]
    intro x hx u hu
    have hxy : x * u * x⁻¹ = u := by
      calc
        x * u * x⁻¹ = u * x * x⁻¹ := by rw [hcommP x u (hU2le hx) (hU1le hu)]
        _ = u := by group
    rw [hxy]
    exact hu) p hp_sup) with ⟨u1, hu1, u2, hu2, hp_eq⟩
  have hcomm : u1 * u2 = u2 * u1 := hcommP u1 u2 (hU1le hu1) (hU2le hu2)
  have hu1pow : u1 ^ 3 = 1 := by
    have hpow : (⟨u1, hu1⟩ : ↥U1) ^ Nat.card ↥U1 = 1 :=
      pow_card_eq_one' (x := (⟨u1, hu1⟩ : ↥U1))
    have hpowG : u1 ^ Nat.card ↥U1 = 1 := congrArg Subtype.val hpow
    rwa [hU13] at hpowG
  have hu2pow : u2 ^ 3 = 1 := by
    have hpow : (⟨u2, hu2⟩ : ↥U2) ^ Nat.card ↥U2 = 1 :=
      pow_card_eq_one' (x := (⟨u2, hu2⟩ : ↥U2))
    have hpowG : u2 ^ Nat.card ↥U2 = 1 := congrArg Subtype.val hpow
    rwa [hU23] at hpowG
  calc
    p ^ 3 = (u1 * u2) ^ 3 := by rw [hp_eq]
    _ = u1 ^ 3 * u2 ^ 3 := (Commute.mul_pow hcomm 3)
    _ = 1 := by rw [hu1pow, hu2pow]; simp

/-- The union of `N` with the double coset `N r N` is a subgroup, provided
`r⁻¹ ∈ N r N` and `r N r ⊆ N ∪ N r N`. -/
private lemma doubleCoset_union_subgroup
    {G : Type u} [Group G] (N : Subgroup G) (r : G)
    (hrinv : r⁻¹ ∈ (N : Set G) * ({r} : Set G) * (N : Set G))
    (hrNrN : ∀ m : G, m ∈ (N : Set G) →
      r * m * r ∈ (N : Set G) ∪ ((N : Set G) * ({r} : Set G) * (N : Set G))) :
    ∃ Y : Subgroup G, (Y : Set G) =
      (N : Set G) ∪ ((N : Set G) * ({r} : Set G) * (N : Set G)) := by
  classical
  let D : Set G := (N : Set G) * ({r} : Set G) * (N : Set G)
  have hD : (N : Set G) * ({r} : Set G) * (N : Set G) = D := rfl
  have hD_mem : ∀ {a : G}, a ∈ D →
      ∃ n1 : G, n1 ∈ (N : Set G) ∧ ∃ n2 : G, n2 ∈ (N : Set G) ∧ a = n1 * r * n2 := by
    intro a ha
    rw [← hD] at ha
    rcases Set.mem_mul.mp ha with ⟨u, hu, n2, hn2, hun2⟩
    rcases Set.mem_mul.mp hu with ⟨n1, hn1, r', hr', hn1r⟩
    simp at hr'
    subst r'
    refine ⟨n1, hn1, n2, hn2, ?_⟩
    rw [← hun2, ← hn1r]
  let Y : Subgroup G :=
    { carrier := (N : Set G) ∪ D
      one_mem' := Or.inl N.one_mem
      mul_mem' := by
        intro a b ha hb
        rcases ha with haN | haD
        · rcases hb with hbN | hbD
          · exact Or.inl (N.mul_mem haN hbN)
          · rcases hD_mem hbD with ⟨m, hm, n, hn, hb'⟩
            right
            rw [← hD]
            refine Set.mem_mul.mpr ⟨(a * m) * r, ?_, n, hn, ?_⟩
            · refine Set.mem_mul.mpr ⟨a * m, N.mul_mem haN hm, r, by simp, rfl⟩
            · rw [hb']
              group
        · rcases hb with hbN | hbD
          · rcases hD_mem haD with ⟨m, hm, n, hn, ha'⟩
            right
            rw [← hD]
            refine Set.mem_mul.mpr ⟨m * r, ?_, n * b, N.mul_mem hn hbN, ?_⟩
            · refine Set.mem_mul.mpr ⟨m, hm, r, by simp, rfl⟩
            · rw [ha']
              group
          · rcases hD_mem haD with ⟨m1, hm1, n1, hn1, ha'⟩
            rcases hD_mem hbD with ⟨m2, hm2, n2, hn2, hb'⟩
            let m3 : G := n1 * m2
            have hm3 : m3 ∈ (N : Set G) := N.mul_mem hn1 hm2
            rcases hrNrN m3 hm3 with hm3N | hm3D
            · left
              have hEq : (m1 * r * n1) * (m2 * r * n2) = m1 * (r * (n1 * m2) * r) * n2 := by
                group
              have hab : a * b = m1 * (r * (n1 * m2) * r) * n2 := by
                calc
                  a * b = (m1 * r * n1) * (m2 * r * n2) := by rw [ha', hb']
                  _ = m1 * (r * (n1 * m2) * r) * n2 := hEq
              rw [hab]
              exact N.mul_mem (N.mul_mem hm1 hm3N) hn2
            · right
              rcases hD_mem hm3D with ⟨m5, hm5, n5, hn5, hm3'⟩
              have hEq : (m1 * r * n1) * (m2 * r * n2) = (m1 * m5) * r * (n5 * n2) := by
                calc
                  (m1 * r * n1) * (m2 * r * n2) = m1 * (r * (n1 * m2) * r) * n2 := by group
                  _ = m1 * (m5 * r * n5) * n2 := by
                    rw [show r * (n1 * m2) * r = m5 * r * n5 by
                      simpa [m3] using hm3']
                  _ = (m1 * m5) * r * (n5 * n2) := by group
              rw [← hD]
              have hab : a * b = (m1 * m5) * r * (n5 * n2) := by
                calc
                  a * b = (m1 * r * n1) * (m2 * r * n2) := by rw [ha', hb']
                  _ = (m1 * m5) * r * (n5 * n2) := hEq
              rw [hab]
              refine Set.mem_mul.mpr ⟨(m1 * m5) * r, ?_, n5 * n2,
                N.mul_mem hn5 hn2, rfl⟩
              refine Set.mem_mul.mpr ⟨m1 * m5, N.mul_mem hm1 hm5, r, by simp, rfl⟩
      inv_mem' := by
        intro a ha
        rcases ha with haN | haD
        · exact Or.inl (N.inv_mem haN)
        · rcases hD_mem haD with ⟨m, hm, n, hn, ha'⟩
          rcases hD_mem hrinv with ⟨m7, hm7, n7, hn7, hrinv'⟩
          right
          rw [← hD]
          have hEq : (m * r * n)⁻¹ = (n⁻¹ * m7) * r * (n7 * m⁻¹) := by
            calc
              (m * r * n)⁻¹ = n⁻¹ * (r⁻¹) * m⁻¹ := by group
              _ = n⁻¹ * (m7 * r * n7) * m⁻¹ := by rw [← hrinv']
              _ = (n⁻¹ * m7) * r * (n7 * m⁻¹) := by group
          have hainv : a⁻¹ = (n⁻¹ * m7) * r * (n7 * m⁻¹) := by
            calc
              a⁻¹ = (m * r * n)⁻¹ := by rw [ha']
              _ = (n⁻¹ * m7) * r * (n7 * m⁻¹) := hEq
          rw [hainv]
          refine Set.mem_mul.mpr ⟨(n⁻¹ * m7) * r, ?_, n7 * m⁻¹,
            N.mul_mem hn7 (N.inv_mem hm), rfl⟩
          refine Set.mem_mul.mpr ⟨n⁻¹ * m7, N.mul_mem (N.inv_mem hn) hm7, r, by simp, rfl⟩ }
  exact ⟨Y, rfl⟩


private lemma join_h_ne_top_of_nondisjoint
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (H : Subgroup G) (r : G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (hH : H = (P : Subgroup G) ⊔ (S2 : Subgroup G))
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (hPinterQ : (P : Subgroup G) ⊓ (conjugateSubgroup (P : Subgroup G) r) ≠ ⊥) :
    H ≠ ⊤ := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  let Q : Sylow 3 G := r • P
  let Z : Subgroup G := (P : Subgroup G) ⊓ (Q : Subgroup G)
  have hQ : (Q : Subgroup G) = conjugateSubgroup (P : Subgroup G) r := by
    rw [Sylow.coe_subgroup_smul]
    rfl
  have hZne : Z ≠ ⊥ := by
    intro hz
    apply hPinterQ
    rw [← hQ]
    exact hz
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hr2 : r ^ 2 ∈ (Tg : Set G) :=
    sylow2_reflection_sq_mem hmin c hfirst d P T2 S2 r hrS2 hrTg hTgS2
  have hTgQ : Tg ≤ Subgroup.normalizer (Q : Set G) := by
    simpa [NP, Tg, Q] using sylow2_mem_normalizer_conjugate hmin c hfirst d P T2 S2 r
      hrS2 hrTg hTgS2
  have hP9 : Nat.card (P : Subgroup G) = 9 := firstCase_sylow3_card_nine c d P
  have hP9' : Nat.card (P : Subgroup G) = 3 ^ 2 := by simpa using hP9
  have : IsMulCommutative (P : Subgroup G) :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9'
  have hcommP : ∀ a b : G, a ∈ (P : Subgroup G) → b ∈ (P : Subgroup G) →
      a * b = b * a := by
    intro a b ha hb
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hP9').is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hQ9 : Nat.card (Q : Subgroup G) = 9 := by
    have hcard : Nat.card (conjugateSubgroup (P : Subgroup G) r) = Nat.card (P : Subgroup G) := by
      exact (Nat.card_congr (Subgroup.equivMapOfInjective (P : Subgroup G)
        (MulAut.conj r).toMonoidHom (MulAut.conj r).injective).toEquiv).symm
    calc
      Nat.card (Q : Subgroup G) = Nat.card (conjugateSubgroup (P : Subgroup G) r) := by rw [hQ]
      _ = Nat.card (P : Subgroup G) := hcard
      _ = 9 := hP9
  have hQ9' : Nat.card (Q : Subgroup G) = 3 ^ 2 := by simpa using hQ9
  have : IsMulCommutative (Q : Subgroup G) :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hQ9'
  have hcommQ : ∀ a b : G, a ∈ (Q : Subgroup G) → b ∈ (Q : Subgroup G) →
      a * b = b * a := by
    intro a b ha hb
    exact congrArg Subtype.val
      (((IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) hQ9').is_comm).comm
        ⟨a, ha⟩ ⟨b, hb⟩)
  have hforwardP : ∀ p : G, p ∈ (P : Subgroup G) → ∀ z : G, z ∈ Z → p * z * p⁻¹ ∈ Z := by
    intro p hp z hz
    have hzp : p * (z : G) * p⁻¹ = (z : G) := by
      calc
        p * (z : G) * p⁻¹ = (z : G) * p * p⁻¹ := by rw [hcommP p (z : G) hp hz.1]
        _ = (z : G) := by group
    rw [hzp]
    exact hz
  have hPleNZ : (P : Subgroup G) ≤ Subgroup.normalizer (Z : Set G) := by
    intro p hp
    rw [Subgroup.mem_normalizer_iff]
    intro z
    constructor
    · exact hforwardP p hp z
    · intro hz
      have hz' : p⁻¹ * (p * (z : G) * p⁻¹) * p ∈ Z := by
        simpa using
          (hforwardP p⁻¹ ((P : Subgroup G).inv_mem hp) (p * (z : G) * p⁻¹) hz)
      have hsimp : p⁻¹ * (p * (z : G) * p⁻¹) * p = (z : G) := by group
      rwa [hsimp] at hz'
  have hforwardQ : ∀ q : G, q ∈ (Q : Subgroup G) → ∀ z : G, z ∈ Z → q * z * q⁻¹ ∈ Z := by
    intro q hq z hz
    have hzp : q * (z : G) * q⁻¹ = (z : G) := by
      calc
        q * (z : G) * q⁻¹ = (z : G) * q * q⁻¹ := by rw [hcommQ q (z : G) hq hz.2]
        _ = (z : G) := by group
    rw [hzp]
    exact hz
  have hQleNZ : (Q : Subgroup G) ≤ Subgroup.normalizer (Z : Set G) := by
    intro q hq
    rw [Subgroup.mem_normalizer_iff]
    intro z
    constructor
    · exact hforwardQ q hq z
    · intro hz
      have hz' : q⁻¹ * (q * (z : G) * q⁻¹) * q ∈ Z := by
        simpa using
          (hforwardQ q⁻¹ ((Q : Subgroup G).inv_mem hq) (q * (z : G) * q⁻¹) hz)
      have hsimp : q⁻¹ * (q * (z : G) * q⁻¹) * q = (z : G) := by group
      rwa [hsimp] at hz'
  have hrZ : r ∈ Subgroup.normalizer (Z : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    change Z.map (MulAut.conj r) = Z
    have hinj : Function.Injective (MulAut.conj r).toMonoidHom := (MulAut.conj r).injective
    have hmapP : (P : Subgroup G).map (MulAut.conj r) = (Q : Subgroup G) := by
      simpa [conjugateSubgroup] using hQ.symm
    have hrQ' : (r • Q : Sylow 3 G) = P := by
      change (r : G) • ((r : G) • P) = P
      rw [← mul_smul, ← pow_two]
      exact (Sylow.smul_eq_iff_mem_normalizer (g := r ^ 2) (P := P)).mpr (hTgNP hr2)
    have hmapQ : (Q : Subgroup G).map (MulAut.conj r) = (P : Subgroup G) := by
      change ((r • Q : Sylow 3 G) : Subgroup G) = (P : Subgroup G)
      exact congrArg (fun S : Sylow 3 G => (S : Subgroup G)) hrQ'
    have hmap : Z.map (MulAut.conj r) = (Q : Subgroup G) ⊓ (P : Subgroup G) := by
      calc
        Z.map (MulAut.conj r) = ((P : Subgroup G) ⊓ (Q : Subgroup G)).map (MulAut.conj r) := rfl
        _ = (P : Subgroup G).map (MulAut.conj r) ⊓ (Q : Subgroup G).map (MulAut.conj r) := by
          exact Subgroup.map_inf (P : Subgroup G) (Q : Subgroup G) (MulAut.conj r).toMonoidHom hinj
        _ = (Q : Subgroup G) ⊓ (P : Subgroup G) := by rw [hmapP, hmapQ]
    rw [hmap]
    exact (inf_comm (Q : Subgroup G) (P : Subgroup G))
  have hTgNZ : Tg ≤ Subgroup.normalizer (Z : Set G) := by
    intro t ht
    rw [Subgroup.mem_normalizer_iff]
    intro z
    constructor
    · intro hz
      have htztP : t * (z : G) * t⁻¹ ∈ (P : Subgroup G) :=
        (Subgroup.mem_normalizer_iff.mp (hTgNP ht) (z : G)).1 hz.1
      have htztQ : t * (z : G) * t⁻¹ ∈ (Q : Subgroup G) :=
        (Subgroup.mem_normalizer_iff.mp (hTgQ ht) (z : G)).1 hz.2
      exact ⟨htztP, htztQ⟩
    · intro hz
      have htNPi : t⁻¹ ∈ NP := NP.inv_mem (hTgNP ht)
      have htNQi : t⁻¹ ∈ Subgroup.normalizer (Q : Set G) :=
        (Subgroup.normalizer (Q : Set G)).inv_mem (hTgQ ht)
      have hz' : t⁻¹ * (t * (z : G) * t⁻¹) * t ∈ Z := by
        have hP' : t⁻¹ * (t * (z : G) * t⁻¹) * t ∈ (P : Subgroup G) := by
          simpa using (Subgroup.mem_normalizer_iff.mp htNPi (t * (z : G) * t⁻¹)).1 hz.1
        have hQ' : t⁻¹ * (t * (z : G) * t⁻¹) * t ∈ (Q : Subgroup G) := by
          simpa using (Subgroup.mem_normalizer_iff.mp htNQi (t * (z : G) * t⁻¹)).1 hz.2
        exact ⟨hP', hQ'⟩
      have hsimp : t⁻¹ * (t * (z : G) * t⁻¹) * t = (z : G) := by group
      rwa [hsimp] at hz'
  -- S₂ = Tg ⊔ ⟨r⟩
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hjoin_le_S2 : (Tg : Subgroup G) ⊔ Subgroup.zpowers r ≤ (S2 : Subgroup G) := by
    exact sup_le hTgS2 (Subgroup.zpowers_le.mpr (by simpa using hrS2))
  have hjoin_card : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) = 8 := by
    have hdiv : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) ∣ 8 := by
      exact (Subgroup.card_dvd_of_le hjoin_le_S2).trans (by rw [hS2card])
    have hge : 4 ≤ Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := by
      let f : Tg → ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := fun y =>
        ⟨(y : G), Subgroup.mem_sup_left y.2⟩
      have hf_inj : Function.Injective f := by
        intro a b h
        apply Subtype.ext
        simpa [f] using congrArg Subtype.val h
      have hle := Nat.card_le_card_of_injective f hf_inj
      rwa [hTgcard] at hle
    have hgt : 4 < Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := by
      by_contra hle
      have hcard : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) = 4 := by
        have hle' : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) ≤ 4 :=
          Nat.le_of_not_gt hle
        omega
      have hEq : (Tg : Subgroup G) ⊔ Subgroup.zpowers r = Tg := by
        exact (Subgroup.eq_of_le_of_card_ge (H := Tg)
          (K := (Tg : Subgroup G) ⊔ Subgroup.zpowers r) le_sup_left (by
            rw [hcard, hTgcard])).symm
      have hrTg' : r ∈ (Tg : Set G) := by
        have hrjoin : r ∈ (Tg : Subgroup G) ⊔ Subgroup.zpowers r :=
          Subgroup.mem_sup_right (Subgroup.mem_zpowers r)
        rwa [hEq] at hrjoin
      exact hrTg hrTg'
    rcases hdiv with ⟨m, hm⟩
    have hmle : m ≤ 8 := by
      have hd : m ∣ 8 := by
        rw [mul_comm] at hm
        exact ⟨Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r), hm⟩
      exact Nat.le_of_dvd (by norm_num : 0 < 8) hd
    interval_cases m <;> omega
  have hjoin_eq_S2 : (Tg : Subgroup G) ⊔ Subgroup.zpowers r = (S2 : Subgroup G) := by
    apply Subgroup.eq_of_le_of_card_ge (H := (Tg : Subgroup G) ⊔ Subgroup.zpowers r)
      (K := (S2 : Subgroup G)) hjoin_le_S2
    rw [hS2card]
    exact hjoin_card.ge
  have hS2leNZ : (S2 : Subgroup G) ≤ Subgroup.normalizer (Z : Set G) := by
    rw [← hjoin_eq_S2]
    exact sup_le hTgNZ (Subgroup.zpowers_le.mpr hrZ)
  have hHleNZ : H ≤ Subgroup.normalizer (Z : Set G) := by
    rw [hH]
    exact sup_le hPleNZ hS2leNZ
  intro hHtop
  have hZnormal : Z.Normal := by
    refine ⟨?conj_mem⟩
    intro z hz g
    have hgH : g ∈ H := by
      rw [hHtop]
      trivial
    exact (Subgroup.mem_normalizer_iff.mp (hHleNZ hgH) (z : G)).1 hz
  have hsimple : IsSimpleGroup G := minimalCounterexample_isSimple hmin
  rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal _ _ hsimple Z hZnormal with hZbot | hZtop
  · exact hZne hZbot
  · have hcardDvd : Nat.card ↥Z ∣ 9 := by
      exact (Subgroup.card_dvd_of_le (inf_le_left : Z ≤ (P : Subgroup G))).trans
        (by rw [hP9])
    have hcard : Nat.card ↥Z ≤ 9 := Nat.le_of_dvd (by norm_num : 0 < 9) hcardDvd
    have hcardTop : Nat.card ↥Z = 2520 := by
      rw [hZtop]
      have hG : Nat.card G = 2520 := (firstCase_index_card_of_countData c d).2
      calc
        Nat.card ↥(⊤ : Subgroup G) = Nat.card G := by
          exact Nat.card_congr (Subgroup.topEquiv (G := G)).toEquiv
        _ = 2520 := by
          norm_num at hG ⊢
          exact hG
    omega

/-- `R5-A`: if the join `H = P ⊔ S₂` meets `Ĥ` in a subgroup of order
`18`, then `H ≠ G` (and hence `H ≠ ⊤`): if `H = G`, the intersection would
be all of `Ĥ`, whose order is `72`. -/
private lemma join_h_ne_top_of_inter_hhat_18
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (H : Subgroup G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (_hH : H = (P : Subgroup G) ⊔ (S2 : Subgroup G))
    (hcard : Nat.card ↥(H ⊓ c.Hhat) = 18) :
    H ≠ ⊤ := by
  classical
  intro hHtop
  have hHhat_le_H : c.Hhat ≤ H := by
    intro x hx
    rw [hHtop]
    trivial
  have hEq : H ⊓ c.Hhat = c.Hhat := by
    apply le_antisymm
    · exact inf_le_right
    · intro x hx
      exact ⟨hHhat_le_H hx, hx⟩
  have h72 : Nat.card ↥(H ⊓ c.Hhat) = 72 := by
    rw [hEq]
    exact hhat_card c d
  omega


/-- `R5-A`, disjoint case: with `P ∩ Q = 1` for `Q = P^r`
(`r ∈ S₂ ∖ T₂`), if every `q ∈ Q` lies in the double coset `N·r·N`
(`N = N_G(P)`), then `H = ⟨P, S₂⟩` is proper.  The set
`Y = N ∪ N·r·N` is a subgroup (`doubleCoset_union_subgroup`); `P ≤ N ≤ Y`
and `S₂ = ⟨T₂, r⟩ ≤ Y` give `H ≤ Y`, and the crude bound
`|Y| ≤ |N| + |N|² = 36 + 1296 < 2520` rules out `Y = ⊤`, hence `H ≠ ⊤`.

The closure condition `r·m·r ∈ N ∪ N·r·N` for `m ∈ N` uses
`r m r = (r m r⁻¹)·r²` with `r m r⁻¹ ∈ N_G(Q) = Q·T₂`
(`normalizer_conjugate_eq_join` + `mem_sup_product`), `r² ∈ T₂`, and the
double-coset crux `Q ⊆ N·r·N` — the single remaining input. -/
private lemma join_h_ne_top_of_disjoint
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) (hPU : c.U ≤ (P : Subgroup G))
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (H : Subgroup G) (r : G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (hH : H = (P : Subgroup G) ⊔ (S2 : Subgroup G))
    (hrS2 : r ∈ (S2 : Subgroup G))
    (hrTg : r ∉ ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype))
    (_hdisj : (P : Subgroup G) ⊓
      (conjugateSubgroup (P : Subgroup G) r) = ⊥)
    (hcrux : ∀ q : G, q ∈ (r • P : Sylow 3 G) →
      q ∈ (Subgroup.normalizer (P : Set G) : Set G) ∪
        ((Subgroup.normalizer (P : Set G) : Set G) * ({r} : Set G) *
          (Subgroup.normalizer (P : Set G) : Set G))) :
    H ≠ ⊤ := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  let Q : Sylow 3 G := r • P
  let D : Set G := (NP : Set G) * ({r} : Set G) * (NP : Set G)
  have hTgNP : Tg ≤ NP := by
    intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨z, hz, rfl⟩
    exact z.2
  have hTgQ : Tg ≤ Subgroup.normalizer (Q : Set G) := by
    simpa [NP, Tg, Q] using sylow2_mem_normalizer_conjugate hmin c hfirst d P T2 S2 r
      hrS2 hrTg hTgS2
  have hNGQ : Subgroup.normalizer (Q : Set G) = (Q : Subgroup G) ⊔ Tg := by
    simpa [NP, Tg, Q] using normalizer_conjugate_eq_join hmin c hfirst d P T2 S2 r
      hrS2 hrTg hTgS2
  have hNGQ_prod : ∀ x : G, x ∈ Subgroup.normalizer (Q : Set G) →
      ∃ q : G, q ∈ (Q : Subgroup G) ∧ ∃ t : G, t ∈ (Tg : Set G) ∧ x = q * t := by
    intro x hx
    have hx' : x ∈ (Q : Subgroup G) ⊔ Tg := by
      rw [← hNGQ]
      exact hx
    exact mem_sup_product (Q : Subgroup G) Tg hTgQ x hx'
  have hr2 : r ^ 2 ∈ (Tg : Set G) :=
    sylow2_reflection_sq_mem hmin c hfirst d P T2 S2 r hrS2 hrTg hTgS2
  have hrinv : r⁻¹ ∈ D := by
    have hri2 : (r ^ 2)⁻¹ ∈ (NP : Set G) := NP.inv_mem (hTgNP hr2)
    change r⁻¹ ∈ (NP : Set G) * ({r} : Set G) * (NP : Set G)
    refine Set.mem_mul.mpr ⟨(1 : G) * r, ?_, (r ^ 2)⁻¹, hri2, ?_⟩
    · refine Set.mem_mul.mpr ⟨(1 : G), NP.one_mem, r, by simp, by simp⟩
    · group
  have hQ : (Q : Subgroup G) = conjugateSubgroup (P : Subgroup G) r := by
    rw [Sylow.coe_subgroup_smul]
    rfl
  have hNGQ_map : Subgroup.normalizer (Q : Set G) =
      (Subgroup.normalizer (P : Set G)).map (MulAut.conj r) := by
    have hmap : Subgroup.normalizer (conjugateSubgroup (P : Subgroup G) r : Set G) =
        (Subgroup.normalizer (P : Set G)).map (MulAut.conj r) := by
      unfold conjugateSubgroup
      exact (Subgroup.map_normalizer_eq_of_bijective (P : Subgroup G)
        (f := (MulAut.conj r).toMonoidHom) (MulAut.conj r).bijective).symm
    rwa [← hQ] at hmap
  have hrNrN : ∀ m : G, m ∈ (NP : Set G) →
      r * m * r ∈ (NP : Set G) ∪ D := by
    intro m hm
    have hrmrNQ : r * m * r⁻¹ ∈ Subgroup.normalizer (Q : Set G) := by
      rw [hNGQ_map]
      refine Subgroup.mem_map.mpr ⟨m, hm, ?_⟩
      change MulAut.conj r m = r * m * r⁻¹
      simp [MulAut.conj_apply]
    rcases hNGQ_prod (r * m * r⁻¹) hrmrNQ with ⟨q, hq, t, ht, hqt⟩
    have htr2 : t * r ^ 2 ∈ (NP : Set G) := NP.mul_mem (hTgNP ht) (hTgNP hr2)
    have hrmr : r * m * r = q * (t * r ^ 2) := by
      calc
        r * m * r = (r * m * r⁻¹) * r ^ 2 := by group
        _ = (q * t) * r ^ 2 := by rw [hqt]
        _ = q * (t * r ^ 2) := by group
    have hqYD : q ∈ (NP : Set G) ∪ D := hcrux q hq
    rcases hqYD with hqN | hqD
    · left
      rw [hrmr]
      exact NP.mul_mem hqN htr2
    · right
      have hqtrD : q * (t * r ^ 2) ∈ D := by
        dsimp [D] at hqD ⊢
        rcases Set.mem_mul.mp hqD with ⟨x, hxAB, y, hyN, hxy⟩
        rcases Set.mem_mul.mp hxAB with ⟨n1, hn1, r', hr', hn1r⟩
        simp at hr'
        subst r'
        refine Set.mem_mul.mpr ⟨n1 * r, ?_, y * (t * r ^ 2), NP.mul_mem hyN htr2, ?_⟩
        · refine Set.mem_mul.mpr ⟨n1, hn1, r, by simp, rfl⟩
        · calc
            (n1 * r) * (y * (t * r ^ 2)) = ((n1 * r) * y) * (t * r ^ 2) := by
              rw [← mul_assoc (n1 * r) y (t * r ^ 2)]
            _ = (x * y) * (t * r ^ 2) := by rw [hn1r]
            _ = q * (t * r ^ 2) := by rw [hxy]
      rwa [hrmr]
  rcases doubleCoset_union_subgroup NP r hrinv hrNrN with ⟨Y, hYset⟩
  have hNPleY : (NP : Set G) ⊆ (Y : Set G) := by
    intro x hx
    rw [hYset]
    exact Or.inl hx
  have hDleY : D ⊆ (Y : Set G) := by
    intro x hx
    rw [hYset]
    exact Or.inr hx
  have hPleY : (P : Subgroup G) ≤ Y := by
    intro p hp
    exact hNPleY (Subgroup.le_normalizer hp)
  have hTgcard : Nat.card Tg = 4 := by
    have hfac : (36 : ℕ).factorization 2 = 2 := by
      rw [show (36 : ℕ) = 2 ^ 2 * 9 by norm_num]
      rw [Nat.factorization_mul (by norm_num) (by norm_num)]
      rw [Nat.factorization_pow]
      simp [Nat.prime_two.factorization_self]
      exact Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (9 : ℕ))
    have hT := T2.card_eq_multiplicity
    have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hT
    rw [hfac] at hT
    norm_num at hT
    calc
      Nat.card Tg = Nat.card (T2 : Subgroup (↥NP)) := by
        exact (Nat.card_congr
          (Subgroup.equivMapOfInjective (T2 : Subgroup (↥NP)) NP.subtype
            NP.subtype_injective).toEquiv).symm
      _ = 4 := hT
  have hS2card : Nat.card (S2 : Subgroup G) = 8 := firstCase_sylow2_card_eight c d S2
  have hjoin_le_S2 : (Tg : Subgroup G) ⊔ Subgroup.zpowers r ≤ (S2 : Subgroup G) := by
    exact sup_le hTgS2 (Subgroup.zpowers_le.mpr (by simpa using hrS2))
  have hjoin_card : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) = 8 := by
    have hdiv : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) ∣ 8 := by
      exact (Subgroup.card_dvd_of_le hjoin_le_S2).trans (by rw [hS2card])
    have hge : 4 ≤ Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := by
      let f : Tg → ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := fun y =>
        ⟨(y : G), Subgroup.mem_sup_left y.2⟩
      have hf_inj : Function.Injective f := by
        intro a b h
        apply Subtype.ext
        simpa [f] using congrArg Subtype.val h
      have hle := Nat.card_le_card_of_injective f hf_inj
      rwa [hTgcard] at hle
    have hgt : 4 < Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) := by
      by_contra hle
      have hcard : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) = 4 := by
        have hle' : Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r) ≤ 4 :=
          Nat.le_of_not_gt hle
        omega
      have hEq : (Tg : Subgroup G) ⊔ Subgroup.zpowers r = Tg := by
        exact (Subgroup.eq_of_le_of_card_ge (H := Tg)
          (K := (Tg : Subgroup G) ⊔ Subgroup.zpowers r) le_sup_left (by
            rw [hcard, hTgcard])).symm
      have hrTg' : r ∈ (Tg : Set G) := by
        have hrjoin : r ∈ (Tg : Subgroup G) ⊔ Subgroup.zpowers r :=
          Subgroup.mem_sup_right (Subgroup.mem_zpowers r)
        rwa [hEq] at hrjoin
      exact hrTg hrTg'
    rcases hdiv with ⟨m, hm⟩
    have hmle : m ≤ 8 := by
      have hd : m ∣ 8 := by
        rw [mul_comm] at hm
        exact ⟨Nat.card ↥((Tg : Subgroup G) ⊔ Subgroup.zpowers r), hm⟩
      exact Nat.le_of_dvd (by norm_num : 0 < 8) hd
    interval_cases m <;> omega
  have hjoin_eq_S2 : (Tg : Subgroup G) ⊔ Subgroup.zpowers r = (S2 : Subgroup G) := by
    apply Subgroup.eq_of_le_of_card_ge (H := (Tg : Subgroup G) ⊔ Subgroup.zpowers r)
      (K := (S2 : Subgroup G)) hjoin_le_S2
    rw [hS2card]
    exact hjoin_card.ge
  have hrD : r ∈ D := by
    dsimp [D]
    refine Set.mem_mul.mpr ⟨r, ?_, 1, NP.one_mem, by group⟩
    refine Set.mem_mul.mpr ⟨1, NP.one_mem, r, by simp, by simp⟩
  have hS2leY : (S2 : Subgroup G) ≤ Y := by
    rw [← hjoin_eq_S2]
    exact sup_le (fun t ht => hNPleY (hTgNP ht)) (Subgroup.zpowers_le.mpr (hDleY hrD))
  have hHleY : H ≤ Y := by
    rw [hH]
    exact sup_le hPleY hS2leY
  have hNPcard : Nat.card ↥NP = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
  have hDcard_le : Nat.card {x : G // x ∈ D} ≤ 36 * 36 := by
    let f : (↥NP × ↥NP) → {x : G // x ∈ D} := fun p =>
      ⟨(p.1 : G) * r * (p.2 : G), by
        dsimp [D]
        refine Set.mem_mul.mpr ⟨(p.1 : G) * r, ?_, (p.2 : G), p.2.2, by group⟩
        refine Set.mem_mul.mpr ⟨(p.1 : G), p.1.2, r, by simp, rfl⟩⟩
    have hsurj : Function.Surjective f := by
      intro x
      rcases Set.mem_mul.mp x.2 with ⟨u, hu, n2, hn2, hun2⟩
      rcases Set.mem_mul.mp hu with ⟨n1, hn1, r', hr', hn1r⟩
      simp at hr'
      subst r'
      refine ⟨(⟨n1, hn1⟩, ⟨n2, hn2⟩), ?_⟩
      apply Subtype.ext
      calc
        (f (⟨n1, hn1⟩, ⟨n2, hn2⟩) : G) = n1 * r * n2 := rfl
        _ = (n1 * r) * n2 := rfl
        _ = u * n2 := by rw [hn1r]
        _ = (x : G) := hun2
    have hle : Nat.card {x : G // x ∈ D} ≤ Nat.card (↥NP × ↥NP) :=
      Nat.card_le_card_of_surjective f hsurj
    rwa [show Nat.card (↥NP × ↥NP) = 36 * 36 by simp [hNPcard]] at hle
  have hYcard_le : Nat.card ↥Y ≤ 36 + 36 * 36 := by
    have hYcard : Nat.card ↥Y = ((NP : Set G) ∪ D).ncard := by
      change Nat.card (Y : Set G) = ((NP : Set G) ∪ D).ncard
      rw [hYset, Nat.card_coe_set_eq]
    have hNcard : (NP : Set G).ncard = 36 := by
      rw [← Nat.card_coe_set_eq]
      exact hNPcard
    have hDcard' : D.ncard = Nat.card {x : G // x ∈ D} :=
      (Nat.card_coe_set_eq D).symm
    rw [hYcard]
    calc
      ((NP : Set G) ∪ D).ncard ≤ (NP : Set G).ncard + D.ncard :=
        Set.ncard_union_le (NP : Set G) D
      _ = 36 + D.ncard := by rw [hNcard]
      _ = 36 + Nat.card {x : G // x ∈ D} := by rw [hDcard']
      _ ≤ 36 + 36 * 36 := by omega
  have hGcard : Nat.card G = 2520 := by
    have hG : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7 := (firstCase_index_card_of_countData c d).2
    norm_num at hG ⊢
    exact hG
  have hYne : Y ≠ ⊤ := by
    intro hYtop
    have hYtopcard : Nat.card ↥Y = 2520 := by
      rw [hYtop]
      calc
        Nat.card ↥(⊤ : Subgroup G) = Nat.card G := by
          exact Nat.card_congr (Subgroup.topEquiv (G := G)).toEquiv
        _ = 2520 := hGcard
    omega
  intro hHtop
  have hYtop' : Y = ⊤ := by
    apply le_antisymm
    · exact le_top
    · intro x hx
      have hxH : x ∈ H := by
        rw [hHtop]
        trivial
      exact hHleY hxH
  exact hYne hYtop'

/-- Elements of `N_G(P)` of order three lie in `P`: the quotient
`N_G(P)/P` has order four, so an element of order three maps to the
identity. -/
private lemma sylow3_normalizer_order_three_mem
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G) {x : G}
    (hxN : x ∈ (Subgroup.normalizer (P : Set G) : Set G))
    (hx3 : orderOf x = 3) :
    x ∈ (P : Subgroup G) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let PP : Subgroup (↥NP) := (P : Subgroup G).subgroupOf NP
  have : PP.Normal := by
    change ((P : Subgroup G).subgroupOf NP).Normal
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer (P : Subgroup G).le_normalizer).mpr (by
      intro x hx
      simpa [NP] using hx)
  let xN : ↥NP := ⟨x, hxN⟩
  let q : ↥NP ⧸ PP := QuotientGroup.mk xN
  have hxN3 : orderOf xN = 3 := by
    have hco : orderOf (xN : G) = orderOf xN :=
      orderOf_submonoid (H := NP.toSubmonoid) xN
    rw [← hco]
    simpa [xN] using hx3
  have hq3 : orderOf q ∣ 3 := by
    exact (orderOf_map_dvd (QuotientGroup.mk' PP) xN).trans (by rw [hxN3])
  have hq4 : orderOf q ∣ 4 := by
    have hqcard : orderOf q ∣ Nat.card (↥NP ⧸ PP) := orderOf_dvd_natCard q
    have hQcard : Nat.card (↥NP ⧸ PP) = 4 := by
      have hPcard : Nat.card ↥PP = 9 := by
        exact (Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe (P : Subgroup G).le_normalizer).toEquiv).trans
          (firstCase_sylow3_card_nine c d P)
      have hm := PP.index_mul_card
      have hNPcard : Nat.card (↥NP) = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
      rw [hPcard, hNPcard] at hm
      have hindex : PP.index = 4 := Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 9) (by
        rw [mul_comm 9 PP.index, mul_comm 9 4]
        simpa using hm)
      change Nat.card (↥NP ⧸ PP) = 4
      rw [← Subgroup.index_eq_card]
      exact hindex
    rwa [hQcard] at hqcard
  have hq1 : orderOf q = 1 := by
    have hg : Nat.gcd 3 4 = 1 := by norm_num
    have hd : orderOf q ∣ 1 := by
      rw [← hg]
      exact Nat.dvd_gcd hq3 hq4
    have hpos : 0 < orderOf q := orderOf_pos q
    rcases hd with ⟨k, hk⟩
    have hkpos : 0 < k := by
      by_contra hk0
      have hkzero : k = 0 := Nat.eq_zero_of_not_pos hk0
      rw [hkzero, mul_zero] at hk
      omega
    nlinarith [hk, hkpos, hpos]
  have hqeq1 : q = 1 := orderOf_eq_one_iff.mp hq1
  have hxPP : xN ∈ PP := (QuotientGroup.eq_one_iff (N := PP) xN).mp (by simpa [q] using hqeq1)
  exact Subgroup.mem_subgroupOf.mp hxPP

/-- For two Sylow 3-subgroups `P, R` with trivial intersection, the
intersection `N_G(P) ∩ N_G(R)` has 2-power order dividing four: it divides
`|N_G(P)| = 36`, and an order-three element of the intersection would lie in
`P` (order-three elements of `N_G(P)` lie in `P`) and normalize `R`, so
`⟨x, R⟩ = R · ⟨x⟩` would have order `27`, impossible in order `2520`. -/
private lemma sylow3_normalizer_inter_card_dvd_four_of_disjoint
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P R : Sylow 3 G)
    (hdisj : (P : Subgroup G) ⊓ (R : Subgroup G) = ⊥) :
    Nat.card ↥((Subgroup.normalizer (P : Set G)) ⊓
      (Subgroup.normalizer (R : Set G))) ∣ 4 := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let NR : Subgroup G := Subgroup.normalizer (R : Set G)
  let D : Subgroup G := NP ⊓ NR
  have hDdvd36 : Nat.card ↥D ∣ 36 := by
    have hDle : D ≤ NP := inf_le_left
    have hNPcard : Nat.card ↥NP = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    exact (Subgroup.card_dvd_of_le hDle).trans (by rw [hNPcard])
  by_contra hnot
  have h3 : 3 ∣ Nat.card ↥D := by
    by_contra hnot3
    have hdvd4' : Nat.card ↥D ∣ 4 := by
      have hnot3g : ¬ 3 ∣ Nat.gcd (Nat.card ↥D) 9 := by
        intro h
        exact hnot3 (h.trans (Nat.gcd_dvd_left _ _))
      have hg : Nat.gcd (Nat.card ↥D) 9 ∣ 9 := Nat.gcd_dvd_right _ _
      have hgcd : Nat.gcd (Nat.card ↥D) 9 = 1 := by
        rcases (Nat.dvd_prime_pow (p := 3) (m := 2)
          (i := Nat.gcd (Nat.card ↥D) 9) Nat.prime_three).1
          (by simpa using hg) with ⟨k, hkle, hk⟩
        have hk0 : k = 0 := by
          by_contra hkne
          have hkpos : 0 < k := Nat.pos_of_ne_zero hkne
          have h3g : 3 ∣ 3 ^ k := dvd_pow_self 3 (Nat.ne_of_gt hkpos)
          have h3gcd : 3 ∣ Nat.gcd (Nat.card ↥D) 9 := by rwa [hk]
          exact hnot3g h3gcd
        rw [hk, hk0, pow_zero]
      have hcop : Nat.Coprime (Nat.card ↥D) 9 := Nat.coprime_iff_gcd_eq_one.mpr hgcd
      exact hcop.dvd_of_dvd_mul_left (by
        simpa [show 36 = 9 * 4 by norm_num] using hDdvd36)
    exact hnot hdvd4'
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  rcases exists_prime_orderOf_dvd_card' 3 h3 with ⟨x, hx3⟩
  have hx3G : orderOf (x : G) = 3 := by
    rw [orderOf_submonoid (H := D.toSubmonoid) x]
    exact hx3
  have hxN : (x : G) ∈ NP := (Subgroup.mem_inf.mp x.2).1
  have hxP : (x : G) ∈ (P : Subgroup G) :=
    sylow3_normalizer_order_three_mem hmin c hfirst d P hxN hx3G
  have hxNR : (x : G) ∈ NR := (Subgroup.mem_inf.mp x.2).2
  have hxnotR : (x : G) ∉ (R : Subgroup G) := by
    intro hxR
    have hx1 : (x : G) = 1 := by
      have hmem : (x : G) ∈ (⊥ : Subgroup G) := by
        rw [← hdisj]
        exact ⟨hxP, hxR⟩
      exact Subgroup.mem_bot.mp hmem
    have hxne : (x : G) ≠ 1 := by
      intro h
      have hord : orderOf (x : G) = 3 := hx3G
      rw [h] at hord
      norm_num at hord
    exact hxne hx1
  let X : Subgroup G := Subgroup.zpowers (x : G)
  have hX3 : Nat.card ↥X = 3 := by
    rw [Nat.card_zpowers, hx3G]
  have hXleR_contra : ¬ X ≤ (R : Subgroup G) := by
    intro hXleR
    exact hxnotR (hXleR (Subgroup.mem_zpowers (x : G)))
  have hdisjXR : Disjoint X (R : Subgroup G) := by
    rw [disjoint_iff]
    by_contra hne
    have hnotbot : ¬ (X ⊓ (R : Subgroup G)) = ⊥ := hne
    have hex : ∃ y : G, y ∈ X ⊓ (R : Subgroup G) ∧ y ≠ 1 := by
      rw [Subgroup.eq_bot_iff_forall] at hnotbot
      push_neg at hnotbot
      exact hnotbot
    rcases hex with ⟨y, hy, hyne⟩
    have hyX : y ∈ X := (Subgroup.mem_inf.mp hy).1
    have hyR : y ∈ (R : Subgroup G) := (Subgroup.mem_inf.mp hy).2
    have hyord : orderOf y = 3 := by
      have hd : orderOf y ∣ 3 := by
        have hd' := Subgroup.orderOf_dvd_natCard (X : Subgroup G) hyX
        rwa [hX3] at hd'
      have hne1 : orderOf y ≠ 1 := by
        intro h
        apply hyne
        exact orderOf_eq_one_iff.mp h
      rcases hd with ⟨k, hk⟩
      have hpos : 0 < orderOf y := orderOf_pos y
      have hkpos : 0 < k := by
        by_contra hk0
        have hkzero : k = 0 := Nat.eq_zero_of_not_pos hk0
        rw [hkzero, mul_zero] at hk
        omega
      have hle3 : orderOf y ≤ 3 := by nlinarith [hk, hkpos, hpos]
      interval_cases orderOf y <;> omega
    have hzyX : Subgroup.zpowers y ≤ X := by
      intro z hz
      rcases Subgroup.mem_zpowers_iff.mp hz with ⟨m, rfl⟩
      exact X.zpow_mem hyX m
    have hzycard : Nat.card ↥(Subgroup.zpowers y : Subgroup G) = 3 := by
      rw [Nat.card_zpowers, hyord]
    have hzeq : Subgroup.zpowers y = X := by
      apply Subgroup.eq_of_le_of_card_ge hzyX (K := X)
      rw [hzycard, hX3]
    have hXleR : X ≤ (R : Subgroup G) := by
      intro z hz
      have hzY : z ∈ Subgroup.zpowers y := by
        rw [hzeq]
        exact hz
      rcases Subgroup.mem_zpowers_iff.mp hzY with ⟨m, rfl⟩
      exact (R : Subgroup G).zpow_mem hyR m
    exact hXleR_contra hXleR
  have hXnormR : X ≤ NR := by
    intro z hz
    rcases Subgroup.mem_zpowers_iff.mp hz with ⟨n, rfl⟩
    exact NR.zpow_mem hxNR n
  have h27 : Nat.card ↥(X ⊔ (R : Subgroup G)) = 27 := by
    have h27' : Nat.card ↥((R : Subgroup G) ⊔ X) = 27 := by
      rw [card_sup_eq_mul_of_disjoint_of_le_normalizer (R : Subgroup G) X hXnormR hdisjXR.symm]
      rw [firstCase_sylow3_card_nine c d R, hX3]
    rw [← sup_comm (R : Subgroup G) X]
    exact h27'
  have h27dvd : 27 ∣ Nat.card G := by
    have htop : Nat.card ↥(X ⊔ (R : Subgroup G)) ∣ Nat.card ↥(⊤ : Subgroup G) :=
      Subgroup.card_dvd_of_le (le_top : X ⊔ (R : Subgroup G) ≤ ⊤)
    have htopcard : Nat.card ↥(⊤ : Subgroup G) = Nat.card G :=
      Nat.card_congr (Subgroup.topEquiv (G := G)).toEquiv
    rwa [h27, htopcard] at htop
  have hGcard : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7 := (firstCase_index_card_of_countData c d).2
  have hnot27 : ¬ 27 ∣ 2 ^ 3 * 3 ^ 2 * 5 * 7 := by norm_num
  exact hnot27 (by rwa [hGcard] at h27dvd)

/-- For `R` disjoint from `P`, the `N_G(P)`-orbit of `R` on the Sylow
3-subgroups has cardinality dividing `36` and divisible by `9` (it is
`36 / k` for `k = |N_G(P) ∩ N_G(R)| ∈ {1,2,4}`). -/
private lemma sylow3_orbit_N_card_of_disjoint
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P R : Sylow 3 G)
    (hdisj : (P : Subgroup G) ⊓ (R : Subgroup G) = ⊥) :
    Nat.card (MulAction.orbit (↥(Subgroup.normalizer (P : Set G))) R) ∣ 36 ∧
    9 ∣ Nat.card (MulAction.orbit (↥(Subgroup.normalizer (P : Set G))) R) := by
  classical
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let D : Subgroup G := NP ⊓ Subgroup.normalizer (R : Set G)
  have horb : Nat.card (MulAction.orbit (↥NP) R) = (D.subgroupOf NP).index := by
    simpa [NP, D] using sylow3_orbit_card NP R
  have hDcard : Nat.card ↥D ∣ 4 := by
    simpa [D] using sylow3_normalizer_inter_card_dvd_four_of_disjoint
      hmin c hfirst d P R hdisj
  have hDcard' : Nat.card ↥(D.subgroupOf NP) ∣ 4 := by
    have hcard : Nat.card ↥(D.subgroupOf NP) = Nat.card ↥D := by
      exact Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe (inf_le_left : D ≤ NP)).toEquiv
    rwa [hcard]
  constructor
  · rw [horb]
    have hm := (D.subgroupOf NP).index_mul_card
    have hNPcard : Nat.card ↥NP = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hm
    exact ⟨Nat.card ↥(D.subgroupOf NP), hm.symm⟩
  · rw [horb]
    rcases hDcard' with ⟨m, hm⟩
    have hdiv := (D.subgroupOf NP).index_mul_card
    have hNPcard : Nat.card ↥NP = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    rw [hNPcard] at hdiv
    have h : (D.subgroupOf NP).index * Nat.card ↥(D.subgroupOf NP) =
        (9 * m) * Nat.card ↥(D.subgroupOf NP) := by
      calc
        (D.subgroupOf NP).index * Nat.card ↥(D.subgroupOf NP) = 36 := hdiv
        _ = 9 * 4 := by norm_num
        _ = 9 * (Nat.card ↥(D.subgroupOf NP) * m) := by rw [hm]
        _ = (9 * m) * Nat.card ↥(D.subgroupOf NP) := by ring
    have hpos : 0 < Nat.card ↥(D.subgroupOf NP) := Nat.card_pos
    have hindex : (D.subgroupOf NP).index = 9 * m :=
      Nat.eq_of_mul_eq_mul_right hpos h
    exact ⟨m, hindex⟩

/-- `R5-A` via the disjointness crux: if every `H`-conjugate of `P` other
than `P` is disjoint from `P`, then `|Orbit_H(P)| = 10`, hence `|H| = 360`
and `H ≠ ⊤`.  The counting: `|Orbit_H(P)| = [H : N_G(P)] ∈ {2,10,14,70}`;
every member of `Orbit_H(P) ∖ {P}` is disjoint from `P`, so its
`N_G(P)`-orbit has size divisible by nine
(`sylow3_orbit_N_card_of_disjoint`); these orbits partition
`Orbit_H(P) ∖ {P}`, so its cardinality is a multiple of nine, forcing
`|Orbit_H(P)| = 10`. -/
private lemma join_h_ne_top_of_disjointness
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (hfirst : FirstCase c) (d : FirstCaseCountData c)
    (P : Sylow 3 G)
    (T2 : Sylow 2 (↥(Subgroup.normalizer (P : Set G))))
    (S2 : Sylow 2 G) (H : Subgroup G)
    (hTgS2 : ((T2 : Subgroup (↥(Subgroup.normalizer (P : Set G)))).map
      (Subgroup.normalizer (P : Set G)).subtype) ≤ (S2 : Subgroup G))
    (hH : H = (P : Subgroup G) ⊔ (S2 : Subgroup G))
    (hD : ∀ h : G, h ∈ H → h • P ≠ P → (P : Subgroup G) ⊓ (h • P : Sylow 3 G) = ⊥) :
    H ≠ ⊤ := by
  classical
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let NP : Subgroup G := Subgroup.normalizer (P : Set G)
  let Tg : Subgroup G := (T2 : Subgroup (↥NP)).map NP.subtype
  have hNleH : NP ≤ H := by
    have hNsup : NP = (P : Subgroup G) ⊔ Tg :=
      firstCase_normalizer_sylow3_sup_sylow2 hmin c hfirst d P T2
    change NP ≤ H
    rw [hNsup, hH]
    exact sup_le le_sup_left (hTgS2.trans le_sup_right)
  let O : Set (Sylow 3 G) := MulAction.orbit (↥H) P
  let O' : Set (Sylow 3 G) := O \ {P}
  let D0 : Subgroup G := H ⊓ NP
  have hOcard : Nat.card O = (D0.subgroupOf H).index := by
    simpa [O, D0, NP] using sylow3_orbit_card H P
  have hD0card : Nat.card ↥D0 = 36 := by
    have hNPcard : Nat.card ↥NP = 36 := firstCase_normalizer_sylow3_card hmin c hfirst d P
    have hD0eq : D0 = NP := by
      apply le_antisymm
      · exact inf_le_right
      · intro x hx
        exact ⟨hNleH hx, hx⟩
    rw [hD0eq, hNPcard]
  have hHcard : Nat.card ↥H = (D0.subgroupOf H).index * 36 := by
    have hm := (D0.subgroupOf H).index_mul_card
    have hstab : Nat.card ↥(D0.subgroupOf H) = 36 := by
      exact (Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe (inf_le_left : D0 ≤ H)).toEquiv).trans hD0card
    rw [hstab] at hm
    exact hm.symm
  have hPleH : (P : Subgroup G) ≤ H := by
    rw [hH]
    exact le_sup_left
  have hSleH : (S2 : Subgroup G) ≤ H := by
    rw [hH]
    exact le_sup_right
  have h9dvd : 9 ∣ Nat.card ↥H := by
    have hd := Subgroup.card_dvd_of_le hPleH
    rw [firstCase_sylow3_card_nine c d P] at hd
    exact hd
  have h8dvd : 8 ∣ Nat.card ↥H := by
    have hd := Subgroup.card_dvd_of_le hSleH
    rw [firstCase_sylow2_card_eight c d S2] at hd
    exact hd
  have h72dvd : 72 ∣ Nat.card ↥H := by
    rcases h9dvd with ⟨k, hk⟩
    have hcop : Nat.Coprime 8 9 := by norm_num
    have h8k : 8 ∣ k := by
      rw [hk] at h8dvd
      exact hcop.dvd_of_dvd_mul_left h8dvd
    rcases h8k with ⟨l, hl⟩
    refine ⟨l, ?_⟩
    calc
      Nat.card ↥H = 9 * k := hk
      _ = 9 * (8 * l) := by rw [hl]
      _ = 72 * l := by ring
  have hHdvdG : Nat.card ↥H ∣ Nat.card G :=
    by
      have h := Subgroup.card_dvd_of_le (le_top : H ≤ ⊤)
      rwa [Nat.card_congr (Subgroup.topEquiv (G := G)).toEquiv] at h
  have hGcard : Nat.card G = 2 ^ 3 * 3 ^ 2 * 5 * 7 := (firstCase_index_card_of_countData c d).2
  rw [hGcard] at hHdvdG
  have hHcard_mem : Nat.card ↥H ∈ ({72, 360, 504, 2520} : Finset ℕ) := by
    rcases h72dvd with ⟨m, hm⟩
    have hm35 : m ∣ 35 := by
      have hd' : 72 * m ∣ 72 * 35 := by
        rw [← hm]
        simpa using hHdvdG
      exact (Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 72)).mp hd'
    rcases hm35 with ⟨l, hl⟩
    have hle : m ≤ 35 := by
      have hlpos : 0 < l := by
        by_contra hl0
        have hlzero : l = 0 := Nat.eq_zero_of_not_pos hl0
        rw [hlzero, mul_zero] at hl
        omega
      nlinarith [hl, hlpos]
    interval_cases m
    all_goals
      first
      | omega
      | (rw [hm]; norm_num)
  have hO_mem : Nat.card O ∈ ({2, 10, 14, 70} : Finset ℕ) := by
    rw [hOcard]
    simp at hHcard_mem
    rcases hHcard_mem with h72 | h360 | h504 | h2520
    · have hmul : (D0.subgroupOf H).index * 36 = 72 := by
        rw [← hHcard]
        exact h72
      have hindex : (D0.subgroupOf H).index = 2 := by omega
      rw [hindex]
      norm_num
    · have hmul : (D0.subgroupOf H).index * 36 = 360 := by
        rw [← hHcard]
        exact h360
      have hindex : (D0.subgroupOf H).index = 10 := by omega
      rw [hindex]
      norm_num
    · have hmul : (D0.subgroupOf H).index * 36 = 504 := by
        rw [← hHcard]
        exact h504
      have hindex : (D0.subgroupOf H).index = 14 := by omega
      rw [hindex]
      norm_num
    · have hmul : (D0.subgroupOf H).index * 36 = 2520 := by
        rw [← hHcard]
        exact h2520
      have hindex : (D0.subgroupOf H).index = 70 := by omega
      rw [hindex]
      norm_num
  have hPinO : P ∈ O := by
    dsimp [O]
    exact ⟨(1 : ↥H), by simp⟩
  have hPnotO' : P ∉ O' := by
    dsimp [O']
    intro h
    exact h.2 rfl
  have hO_eq_insert : O = insert P O' := by
    ext R
    constructor
    · intro hR
      by_cases hRP : R = P
      · simp [hRP]
      · right
        exact ⟨hR, hRP⟩
    · intro hR
      rcases hR with hRP | hRO'
      · simpa [hRP] using hPinO
      · exact hRO'.1
  have hO'card : O'.ncard + 1 = O.ncard := by
    have hins : (insert P O').ncard = O'.ncard + 1 := Set.ncard_insert_of_notMem hPnotO'
    rw [hO_eq_insert]
    exact hins.symm
  have hO_ncard : O.ncard = Nat.card O := by
    simpa using (Nat.card_coe_set_eq O).symm
  have hdisjR : ∀ R : Sylow 3 G, R ∈ O' → (P : Subgroup G) ⊓ (R : Subgroup G) = ⊥ := by
    intro R hR
    rcases hR with ⟨hRO, hRneP⟩
    rcases hRO with ⟨h, rfl⟩
    exact hD (h : G) h.2 (by
      intro hEq
      exact hRneP (by change h • P = P; exact hEq))
  have hOrbR : ∀ R : Sylow 3 G, R ∈ O' →
      Nat.card (MulAction.orbit (↥NP) R) ∣ 36 ∧
      9 ∣ Nat.card (MulAction.orbit (↥NP) R) := by
    intro R hR
    exact sylow3_orbit_N_card_of_disjoint hmin c hfirst d P R (hdisjR R hR)
  have hOrbRle : ∀ R : Sylow 3 G, R ∈ O' →
      MulAction.orbit (↥NP) R ⊆ O' := by
    intro R hR x hx
    rcases hR with ⟨hRO, hRneP⟩
    rcases hRO with ⟨h, rfl⟩
    rcases hx with ⟨n, rfl⟩
    constructor
    · dsimp [O]
      refine ⟨⟨(n : G) * (h : G), ?_⟩, ?_⟩
      · exact H.mul_mem (hNleH n.2) h.2
      · change ((n : G) * (h : G)) • P = (n : G) • ((h : G) • P)
        exact mul_smul (n : G) (h : G) P
    · intro hEq
      apply hRneP
      change (h : G) • P = P
      exact (calc
        (h : G) • P = (1 : G) • ((h : G) • P) := by rw [one_smul]
        _ = ((n : G)⁻¹ * (n : G)) • ((h : G) • P) := by rw [inv_mul_cancel]
        _ = (n : G)⁻¹ • ((n : G) • ((h : G) • P)) := mul_smul (n : G)⁻¹ (n : G) ((h : G) • P)
        _ = (n : G)⁻¹ • P := congrArg (fun x : Sylow 3 G => (n : G)⁻¹ • x) hEq
        _ = P := Sylow.smul_eq_iff_mem_normalizer.mpr (NP.inv_mem n.2))
  let Ω : Type u := {R : Sylow 3 G // R ∈ O'}
  let : MulAction (↥NP) Ω :=
    { smul := fun n R => ⟨n • R.1, hOrbRle R.1 R.2 ⟨n, rfl⟩⟩
      one_smul := by
        intro R
        apply Subtype.ext
        exact one_smul (M := ↥NP) (α := Sylow 3 G) R.1
      mul_smul := by
        intro a b R
        apply Subtype.ext
        exact mul_smul a b R.1 }
  have hfib_eq : ∀ x : Ω,
      {y : Ω // Quotient.mk (MulAction.orbitRel (↥NP) Ω) y =
        Quotient.mk (MulAction.orbitRel (↥NP) Ω) x} ≃
        MulAction.orbit (↥NP) x.1 := by
    intro x
    refine ⟨fun y => ⟨y.1.1, ?_⟩, fun z => ⟨⟨z.1, ?_⟩, ?_⟩, ?_, ?_⟩
    · have hrel : (MulAction.orbitRel (↥NP) Ω).r y.1 x := Quotient.eq.mp y.2
      rcases (MulAction.orbitRel_apply.mp hrel) with ⟨n, hn⟩
      refine ⟨n, ?_⟩
      exact congrArg Subtype.val hn
    · exact hOrbRle x.1 x.2 z.2
    · apply Quotient.eq.mpr
      rw [MulAction.orbitRel_apply]
      rcases z.2 with ⟨n, hn⟩
      refine ⟨n, ?_⟩
      apply Subtype.ext
      exact hn
    · intro y
      apply Subtype.ext
      rfl
    · intro z
      apply Subtype.ext
      rfl
  have hfib9 : ∀ x : Ω,
      9 ∣ Nat.card {y : Ω // Quotient.mk (MulAction.orbitRel (↥NP) Ω) y =
        Quotient.mk (MulAction.orbitRel (↥NP) Ω) x} := by
    intro x
    have hcard : Nat.card {y : Ω // Quotient.mk (MulAction.orbitRel (↥NP) Ω) y =
        Quotient.mk (MulAction.orbitRel (↥NP) Ω) x} =
        Nat.card (MulAction.orbit (↥NP) x.1) :=
      Nat.card_congr (hfib_eq x)
    rw [hcard]
    exact (hOrbR x.1 x.2).2
  let : Fintype Ω := Fintype.ofFinite _
  have hsum : Nat.card Ω =
      ∑ q : Quotient (MulAction.orbitRel (↥NP) Ω),
        Nat.card {x : Ω // Quotient.mk (MulAction.orbitRel (↥NP) Ω) x = q} := by
    rw [Nat.card_eq_fintype_card]
    have hL : Fintype.card Ω = ∑ x : Ω, (1 : ℕ) := Fintype.card_eq_sum_ones
    have hR : (∑ q : Quotient (MulAction.orbitRel (↥NP) Ω),
        Nat.card {x : Ω // Quotient.mk (MulAction.orbitRel (↥NP) Ω) x = q}) =
        ∑ q : Quotient (MulAction.orbitRel (↥NP) Ω),
          Fintype.card {x : Ω // Quotient.mk (MulAction.orbitRel (↥NP) Ω) x = q} := by
      apply Finset.sum_congr rfl
      intro q hq
      rw [Nat.card_eq_fintype_card]
    have hfw := Fintype.sum_fiberwise
      (g := fun x : Ω => Quotient.mk (MulAction.orbitRel (↥NP) Ω) x)
      (f := fun _ : Ω => (1 : ℕ))
    rw [hL, hR]
    simp_rw [Fintype.card_eq_sum_ones]
    exact hfw.symm
  have h9Ω : 9 ∣ Nat.card Ω := by
    rw [hsum]
    apply Finset.dvd_sum
    intro q hq
    have hout : Quotient.mk (MulAction.orbitRel (↥NP) Ω) (Quotient.out q) = q :=
      Quotient.out_eq _
    rw [← hout]
    exact hfib9 (Quotient.out q)
  have h9O' : 9 ∣ O'.ncard := by
    have hΩ : Nat.card Ω = O'.ncard := by
      simpa [Ω] using (Nat.card_coe_set_eq O')
    rwa [hΩ] at h9Ω
  have hO'card_mem : O'.ncard ∈ ({1, 9, 13, 69} : Finset ℕ) := by
    have hO_mem' : O.ncard ∈ ({2, 10, 14, 70} : Finset ℕ) := by
      rwa [← hO_ncard] at hO_mem
    simp at hO_mem'
    rcases hO_mem' with h2 | h10 | h14 | h70
    · have h : O'.ncard = 1 := by omega
      rw [h]
      norm_num
    · have h : O'.ncard = 9 := by omega
      rw [h]
      norm_num
    · have h : O'.ncard = 13 := by omega
      rw [h]
      norm_num
    · have h : O'.ncard = 69 := by omega
      rw [h]
      norm_num
  have hO'9 : O'.ncard = 9 := by
    simp only [Finset.mem_insert, Finset.mem_singleton] at hO'card_mem
    rcases hO'card_mem with h1 | h9 | h13 | h69
    · exfalso
      rw [h1] at h9O'
      norm_num at h9O'
    · exact h9
    · exfalso
      rw [h13] at h9O'
      norm_num at h9O'
    · exfalso
      rw [h69] at h9O'
      norm_num at h9O'
  have hO10 : Nat.card O = 10 := by
    rw [← hO_ncard]
    omega
  have hH360 : Nat.card ↥H = 360 := by
    have hindex10 : (D0.subgroupOf H).index = 10 := by
      rw [← hOcard]
      exact hO10
    calc
      Nat.card ↥H = (D0.subgroupOf H).index * 36 := hHcard
      _ = 10 * 36 := by rw [hindex10]
      _ = 360 := by norm_num
  intro hHtop
  have hTopcard : Nat.card ↥H = 2520 := by
    rw [hHtop]
    calc
      Nat.card ↥(⊤ : Subgroup G) = Nat.card G :=
        Nat.card_congr (Subgroup.topEquiv (G := G)).toEquiv
      _ = 2 ^ 3 * 3 ^ 2 * 5 * 7 := (firstCase_index_card_of_countData c d).2
  omega

end CFSG.GorensteinWalter
