module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section4.Defs

namespace CFSG
end CFSG
open CFSG

/-!
# Section 4: the nontrivial fixed part in equation (5)

Equation (3) gives `F(U) ∩ M = K₀ ⊔ F`, with `K₀` a subgroup of the cyclic
inverted subgroup `K`.  Therefore a noncyclic `F(U) ∩ M` forces
`F = C_{F(U) ∩ M}(s)` to be nontrivial.  This module isolates that exact
group-theoretic implication for reuse by both Section-4 model branches.
-/

namespace CFSG.GorensteinWalter

universe u

/-- If a subgroup is generated by a cyclic part and `F`, and the whole
subgroup is noncyclic, then `F` is nontrivial. -/
public theorem secondCase_fitting_centralizer_ne_bot_of_inter_not_cyclic
    {G : Type u} [Group G]
    (K K0 F Y : Subgroup G)
    (hKcyc : IsCyclic K)
    (hK0le : K0 ≤ K)
    (hjoin : K0 ⊔ F = Y)
    (hYnotcyc : ¬ IsCyclic Y) :
    F ≠ ⊥ := by
  intro hFbot
  have hK0eq : K0 = Y := by
    rw [← hjoin, hFbot, sup_bot_eq]
  have hK0cyc : IsCyclic K0 := by
    let : IsCyclic K := hKcyc
    exact Subgroup.isCyclic_of_le hK0le
  apply hYnotcyc
  rw [← hK0eq]
  exact hK0cyc

end CFSG.GorensteinWalter
