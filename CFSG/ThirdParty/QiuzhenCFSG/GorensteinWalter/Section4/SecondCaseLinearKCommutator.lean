module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section1
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-!
# The inverted factor as a cyclic-involution commutator

This is the generic part of the source equation (1).  For a finite odd
subgroup `X`, Fact 1.5(i) identifies the elements inverted by an involution
`s` with the commutators against the cyclic subgroup generated by `s`.
The comparison of that cyclic subgroup with a full component Sylow is a
separate PSL₂ action statement.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

open scoped commutatorElement

/-- Fact 1.5(i) gives the inverted factor as the commutator with an
involutory cyclic subgroup. -/
public theorem secondCase_linear_K_eq_zpowers_commutator
    {G : Type u} [Group G] [Finite G]
    {X : Subgroup G} {s : G}
    (hs : IsInvolution s)
    (hcop : Nat.Coprime 2 (Nat.card (↥X)))
    (hsX : ∀ x : G, x ∈ X → s * x * s⁻¹ ∈ X)
    {K : Subgroup G}
    (hK : (K : Set G) = invertedElements X s) :
    K = ⁅Subgroup.zpowers s, X⁆ := by
  classical
  have hs_sq : s * s = 1 := by simpa [pow_two] using hs.2
  have hs_inv : s⁻¹ = s := inv_eq_of_mul_eq_one_right hs_sq
  have himage := fact_1_5_i_invertedElements_eq_image
    (X := X) (s := s) hs hcop hsX
  have hKle : K ≤ ⁅X, Subgroup.zpowers s⁆ := by
    intro y hy
    have hyI : y ∈ invertedElements X s := by
      rw [← hK]
      exact hy
    rw [himage] at hyI
    rcases hyI with ⟨a, rfl⟩
    have ha' : (a : G)⁻¹ ∈ X := X.inv_mem a.2
    have hcomm : ⁅(a : G)⁻¹, s⁆ =
        (a : G)⁻¹ * (s * (a : G) * s⁻¹) := by
      simp [commutatorElement_def, hs_inv, mul_assoc]
    rw [← hcomm]
    exact Subgroup.commutator_mem_commutator ha'
      (Subgroup.mem_zpowers s)
  have hzp_le : ⁅Subgroup.zpowers s, X⁆ ≤ K := by
    apply Subgroup.commutator_le.mpr
    intro z hz x hx
    have hz_cases : z = 1 ∨ z = s := by
      rcases Subgroup.mem_zpowers_iff.mp hz with ⟨n, hn⟩
      rw [← hn, zpow_eq_zpow_emod' n hs.2]
      rcases Int.emod_two_eq_zero_or_one n with hn0 | hn1
      · left
        simpa [hn0]
      · right
        simpa [hn1]
    rcases hz_cases with hz1 | hzs
    · rw [hz1]
      simpa [commutatorElement_def] using K.one_mem
    · subst z
      have hxsK : ⁅x, s⁆ ∈ K := by
        change ⁅x, s⁆ ∈ (K : Set G)
        rw [hK, himage]
        refine ⟨⟨x⁻¹, X.inv_mem hx⟩, ?_⟩
        simp [commutatorElement_def, hs_inv, mul_assoc]
      have hsinv : ⁅s, x⁆ = ⁅x, s⁆⁻¹ := by
        exact (commutatorElement_inv x s).symm
      rw [hsinv]
      exact K.inv_mem hxsK
  apply le_antisymm
  · rw [Subgroup.commutator_comm]
    exact hKle
  · exact hzp_le

end CFSG.GorensteinWalter
