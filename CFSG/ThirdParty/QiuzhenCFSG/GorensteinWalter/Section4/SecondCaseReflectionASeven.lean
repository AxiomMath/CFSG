module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.ASevenInvolutionCentralizerThreeCycle
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-!
# Section 4: the A₇ reflected-torus model node

The A₇ half of the reflected-torus node.  For every involution `t` in `A₇`
there is a cyclic torus `T` and an involution `s ∉ T` inverting `T`, and
every odd-order subgroup centralizing `t` lies in `T`.

The base case uses the explicit involution `(0 1)(2 3)`, the cyclic
3-torus generated by `(4 5 6)`, and the inverting involution `(0 1)(4 5)`.
The named permutation identities are kernel checked directly.  Odd
centralizer containment follows structurally from the normal order-three
subgroup of the involution centralizer, and the general case is transported
by A₇ involution fusion.
-/

noncomputable section

namespace CFSG.GorensteinWalter

private def a7reflection : A7 :=
  ⟨Equiv.swap (0 : Fin 7) 1 * Equiv.swap 4 5, by
    simp [Equiv.Perm.sign_mul]⟩

private theorem a7t_involution : IsInvolution a7t := by
  unfold IsInvolution
  constructor <;> decide

private theorem a7three_pow : a7a ^ 3 = 1 := by
  decide

private theorem a7reflection_involution : IsInvolution a7reflection := by
  unfold IsInvolution
  constructor <;> decide

private theorem a7reflection_inverts_generator :
    a7reflection * a7a * a7reflection⁻¹ = a7a⁻¹ := by
  decide

private theorem a7reflection_inverts_three
    (x : A7) (hx : x ∈ Subgroup.zpowers a7a) :
    a7reflection * x * a7reflection⁻¹ = x⁻¹ := by
  rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
  have hsgen : a7reflection * a7a * a7reflection⁻¹ = a7a⁻¹ :=
    a7reflection_inverts_generator
  have h := map_zpow (MulAut.conj a7reflection) a7a n
  simpa [hsgen, MulAut.conj_apply, inv_zpow] using h

private theorem mem_zpowers_a7a_iff (x : A7) :
    x ∈ Subgroup.zpowers a7a ↔ x = 1 ∨ x = a7a ∨ x = a7a ^ 2 := by
  constructor
  · intro hx
    rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
    have hmod : a7a ^ n = a7a ^ (n % (3 : ℤ)) :=
      zpow_eq_zpow_emod' n (by simpa using a7three_pow)
    rw [hmod]
    have hnonneg : 0 ≤ n % (3 : ℤ) :=
      Int.emod_nonneg _ (by norm_num : (3 : ℤ) ≠ 0)
    have hlt : n % (3 : ℤ) < (3 : ℤ) := Int.emod_lt_of_pos _ (by norm_num)
    have hm : n % (3 : ℤ) = (Int.toNat (n % (3 : ℤ)) : ℤ) :=
      (Int.toNat_of_nonneg hnonneg).symm
    rw [hm, zpow_natCast]
    have hm3 : Int.toNat (n % (3 : ℤ)) < 3 := by
      rw [Int.toNat_lt hnonneg]
      exact hlt
    interval_cases m : Int.toNat (n % (3 : ℤ)) <;> simp
  · intro hx
    rcases hx with h1 | ha | ha2
    · simp [h1]
    · simp [ha]
    · rw [ha2]
      exact Subgroup.pow_mem (Subgroup.zpowers a7a) (Subgroup.mem_zpowers a7a) 2

private theorem a7reflection_not_mem_three :
    a7reflection ∉ Subgroup.zpowers a7a := by
  intro h
  rw [mem_zpowers_a7a_iff] at h
  rcases h with h1 | ha | ha2
  · exact (by decide : a7reflection ≠ 1) h1
  · exact (by decide : a7reflection ≠ a7a) ha
  · exact (by decide : a7reflection ≠ a7a ^ 2) ha2

private theorem a7_base_odd_centralizer_le_three
    {X : Subgroup A7}
    (hXodd : ∀ x : A7, x ∈ X → Odd (orderOf x))
    (hXcent : X ≤ Subgroup.centralizer ({a7t} : Set A7)) :
    X ≤ Subgroup.zpowers a7a := by
  exact aSeven_odd_subgroup_centralizing_a7t_le_zpowers hXodd hXcent

private theorem centralizer_conj_mem
    {G : Type*} [Group G] (g t x : G)
    (hx : x ∈ Subgroup.centralizer ({t} : Set G)) :
    g * x * g⁻¹ ∈ Subgroup.centralizer ({g * t * g⁻¹} : Set G) := by
  rw [Subgroup.mem_centralizer_singleton_iff] at hx ⊢
  calc
    (g * x * g⁻¹) * (g * t * g⁻¹) = g * (x * t) * g⁻¹ := by group
    _ = g * (t * x) * g⁻¹ := by rw [hx]
    _ = (g * t * g⁻¹) * (g * x * g⁻¹) := by group

/-- In the A₇ model, every involution has a cyclic odd torus inverted by an
outside involution, and the odd part of its centralizer lies in the torus. -/
public theorem secondCase_reflection_a7_torus
    {t : alternatingGroup (Fin 7)} (ht : IsInvolution t) :
    ∃ T : Subgroup (alternatingGroup (Fin 7)),
      ∃ s : alternatingGroup (Fin 7),
        IsCyclic T ∧ s ∉ T ∧ IsInvolution s ∧
          (∀ x : alternatingGroup (Fin 7), x ∈ T →
            s * x * s⁻¹ = x⁻¹) ∧
            ∀ X : Subgroup (alternatingGroup (Fin 7)),
              (∀ x : alternatingGroup (Fin 7), x ∈ X →
                Odd (orderOf x)) →
                X ≤ Subgroup.centralizer ({t} : Set (alternatingGroup (Fin 7))) →
                  X ≤ T := by
  classical
  obtain ⟨g, hgt⟩ := aSeven_involutions_conjugate t a7t ht a7t_involution
  let T : Subgroup A7 :=
    (Subgroup.zpowers a7a).map (MulAut.conj g⁻¹).toMonoidHom
  let s : A7 := g⁻¹ * a7reflection * g
  have hTcyc : IsCyclic T := by
    let e : Subgroup.zpowers a7a ≃* T :=
      Subgroup.equivMapOfInjective (Subgroup.zpowers a7a)
        (MulAut.conj g⁻¹).toMonoidHom (MulAut.conj g⁻¹).injective
    exact (MulEquiv.isCyclic e).mp (Subgroup.isCyclic_zpowers a7a)
  have hsI : IsInvolution s := by
    constructor
    · intro hs1
      apply a7reflection_involution.1
      have hrefl1 : a7reflection = 1 := by
        calc
          a7reflection = g * s * g⁻¹ := by
            simp [s, mul_assoc]
          _ = g * 1 * g⁻¹ := by
            rw [hs1]
          _ = 1 := by simp
      exact hrefl1
    · calc
        s ^ 2 = g⁻¹ * (a7reflection ^ 2) * g := by
          simp [s, pow_two, mul_assoc]
        _ = 1 := by
          rw [a7reflection_involution.2]
          simp
  have hs_not_T : s ∉ T := by
    intro hsT
    rcases Subgroup.mem_map.mp hsT with ⟨u, hu, hgu⟩
    have hu0 : u = a7reflection := by
      apply (MulAut.conj g⁻¹).injective
      simpa [s, MulAut.conj_apply] using hgu
    exact a7reflection_not_mem_three (by simpa [hu0] using hu)
  have hinvT : ∀ x : A7, x ∈ T → s * x * s⁻¹ = x⁻¹ := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
    have hsu : a7reflection * u * a7reflection⁻¹ = u⁻¹ :=
      a7reflection_inverts_three u hu
    calc
      (g⁻¹ * a7reflection * g) * (g⁻¹ * u * g) * (g⁻¹ * a7reflection * g)⁻¹ =
          g⁻¹ * (a7reflection * u * a7reflection⁻¹) * g := by group
      _ = g⁻¹ * u⁻¹ * g := by rw [hsu]
      _ = (g⁻¹ * u * g)⁻¹ := by group
  have hcontain :
      ∀ X : Subgroup A7,
        (∀ x : A7, x ∈ X → Odd (orderOf x)) →
          X ≤ Subgroup.centralizer ({t} : Set A7) → X ≤ T := by
    intro X hXodd hXcent x hx
    let X0 : Subgroup A7 := X.map (MulAut.conj g).toMonoidHom
    have hX0odd : ∀ y : A7, y ∈ X0 → Odd (orderOf y) := by
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨x0, hx0, rfl⟩
      have hord : orderOf ((MulAut.conj g) x0) = orderOf x0 :=
        (MulAut.conj g).orderOf_eq x0
      change Odd (orderOf ((MulAut.conj g) x0))
      rw [hord]
      exact hXodd x0 hx0
    have hX0cent : X0 ≤ Subgroup.centralizer ({a7t} : Set A7) := by
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨x0, hx0, rfl⟩
      have hxcent : x0 ∈ Subgroup.centralizer ({t} : Set A7) := hXcent hx0
      have hycent : g * x0 * g⁻¹ ∈
          Subgroup.centralizer ({g * t * g⁻¹} : Set A7) :=
        centralizer_conj_mem g t x0 hxcent
      simpa [hgt, MulAut.conj_apply] using hycent
    have hX0T0 : X0 ≤ Subgroup.zpowers a7a :=
      a7_base_odd_centralizer_le_three hX0odd hX0cent
    have hy0 : g * x * g⁻¹ ∈ X0 :=
      Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
    have hy0T0 : g * x * g⁻¹ ∈ Subgroup.zpowers a7a := hX0T0 hy0
    exact Subgroup.mem_map.mpr ⟨g * x * g⁻¹, hy0T0, by
      simp [mul_assoc]⟩
  exact ⟨T, s, hTcyc, hs_not_T, hsI, hinvT, hcontain⟩

end CFSG.GorensteinWalter
