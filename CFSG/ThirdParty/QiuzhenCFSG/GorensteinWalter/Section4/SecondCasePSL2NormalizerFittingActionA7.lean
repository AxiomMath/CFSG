open CFSG

/-!
# The `A₇`-quotient model case of the Fact 1.10(ii) normalizer centralization

For `N = N_G(X)` with `N/O₂'(N) ≅ A₇`, every element of `N_F(X)` maps to
the identity in the quotient: it induces an odd-order automorphism of the
image of the component, centralizing the distinguished involution; an
order-three image would centralize the whole component image, whose
cardinality is at least `|PSL₂(K)| ≥ 60`, while the Klein four generated by
`t` and the reflection `s` forces the `A₇` centralizer of an order-three
element to have order `36` — a contradiction.  Hence `N_F(X) ≤ O₂'(N)`, and
the layer-centralizes-`O₂'(N)` fact gives `E(N_G(X)) ≤ C_G(N_F(X))`.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

private local instance fact_prime_two : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

open scoped Pointwise

/-- An involution does not lie in an odd-order subgroup. -/
private theorem involution_not_mem_of_odd_card
    {G : Type u} [Group G] [Finite G]
    (H : Subgroup G) (hHodd : Odd (Nat.card H)) {t : G}
    (ht : IsInvolution t) : t ∉ H := by
  intro htH
  have hdvd : orderOf t ∣ Nat.card H := Subgroup.orderOf_dvd_natCard H htH
  have hord2 : orderOf t = 2 := orderOf_eq_prime ht.2 ht.1
  exact hHodd.not_two_dvd_nat (by simpa [hord2] using hdvd)

/-- The `A₇`-quotient case of the Fact 1.10(ii) normalizer centralization:
with `N = N_G(X)` a D-group whose quotient by `O₂'(N)` is `A₇`, the elements
of `F` that normalize `X` lie in `O₂'(N)`, so the layer of `N` centralizes
them. -/
public theorem secondCase_psl2_normalizer_fitting_action_of_a7_quotient
    {G : Type u} [Group G] [Finite G]
    (hmin : IsMinimalCounterexample G)
    (c : CentralizerSetup G) (w : SecondCaseWitness c)
    (d : SecondCaseComponentData w)
    (K : Type u) [Field K] [Finite K]
    (hK : IsOddPrimePower (Nat.card K))
    (e : Nonempty ((d.E ⧸ Subgroup.center d.E) ≃* PSL2 K))
    (F X : Subgroup G)
    (s : d.E)
    (hF_eq : F = centralizerIn (c.FU ⊓ w.M) (s : G))
    (hrefl : c.IsReflection (s : G))
    (hFleFU : F ≤ c.FU) (hFleM : F ≤ w.M)
    (hFcentE : F ≤ Subgroup.centralizer (d.E : Set G))
    (hXne : X ≠ ⊥) (hXleF : X ≤ F)
    (hA7 : Nonempty ((Subgroup.normalizer (X : Set G) ⧸
      pPrimeCore 2 (Subgroup.normalizer (X : Set G))) ≃* alternatingGroup (Fin 7))) :
    secondCase_psl2_fact_1_10_ii_centralization c w d F X
      hFleFU hFleM hFcentE hXne hXleF := by
  classical
  let N : Subgroup G := Subgroup.normalizer (X : Set G)
  let O : Subgroup N := pPrimeCore 2 N
  let : O.Normal := by dsimp [O]; infer_instance
  let q : N →* N ⧸ O := QuotientGroup.mk' O
  let L : Subgroup G := componentLayerOf N
  let eA7 : N ⧸ O ≃* alternatingGroup (Fin 7) := hA7.some
  have hOodd : Odd (Nat.card O) := by
    dsimp [O]
    exact Nat.coprime_two_left.mp (pPrimeCore_coprime_card (p := 2) (G := N))
  -- `E ≤ N = N_G(X)`: `X ≤ F` centralizes `E`, so `E` centralizes `X`.
  have hXcentE : X ≤ Subgroup.centralizer (d.E : Set G) := hXleF.trans hFcentE
  have hEcentX : d.E ≤ Subgroup.centralizer (X : Set G) := by
    intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    exact (Subgroup.mem_centralizer_iff.mp (hXcentE hx) z hz).symm
  have hEleN : d.E ≤ N :=
    hEcentX.trans (Subgroup.centralizer_le_normalizer (X : Set G))
  let tN : N := ⟨c.t, hEleN d.t_mem_E⟩
  let sN : N := ⟨(s : G), hEleN s.2⟩
  -- the layer of `N` centralizes the odd core of `N`
  have hLcentO : L ≤ Subgroup.centralizer
      (((pPrimeCore 2 N).map N.subtype) : Set G) :=
    layer_centralizes_oddCore N
  intro l hlL
  rw [Subgroup.mem_centralizer_iff]
  intro p hp
  have hpF : p ∈ F := hp.1
  let pN : N := ⟨p, hp.2⟩
  let f7 : alternatingGroup (Fin 7) := eA7 (q pN)
  have hpOdd : Odd (orderOf p) := orderOf_mem_normalizerInF_odd c F X hFleFU hp
  -- `p` centralizes the distinguished involution: `F ≤ F(U) ≤ U ≤ H = C_G(t)`
  have hpU : p ∈ c.U := fittingSubgroupOf_le c.U (hFleFU hpF)
  have hpcentT : p ∈ Subgroup.centralizer ({c.t} : Set G) := by
    have hpUleH : c.U ≤ c.H := by
      change oddCoreOf c.H ≤ c.H
      exact Subgroup.map_subtype_le (pPrimeCore 2 c.H)
    have : p ∈ c.H := hpUleH hpU
    rwa [c.H_eq_centralizer] at this
  have hpcommT : p * c.t = c.t * p :=
    Subgroup.mem_centralizer_singleton_iff.mp hpcentT
  -- the image of `p` in `A₇` has odd order
  have hf7odd : Odd (orderOf f7) := by
    have hqodd : Odd (orderOf (q pN)) := by
      have hdvd : orderOf (q pN) ∣ orderOf p := (orderOf_dvd_iff_pow_eq_one).2 (by
        rw [← map_pow]
        have hpNpow : pN ^ orderOf p = 1 := by
          apply Subtype.ext
          exact pow_orderOf_eq_one p
        rw [hpNpow]
        simp)
      exact Odd.of_dvd_nat hpOdd hdvd
    have hord : orderOf (eA7 (q pN)) = orderOf (q pN) := by
      change orderOf (eA7.toMonoidHom (q pN)) = orderOf (q pN)
      exact orderOf_injective eA7.toMonoidHom eA7.injective (q pN)
    simpa [f7] using (hord ▸ hqodd)
  -- `t7`, the image of `t`, is an involution
  let t7 : alternatingGroup (Fin 7) := eA7 (q tN)
  have htN2 : tN ^ 2 = 1 := by
    apply Subtype.ext
    change c.t ^ 2 = 1
    simpa [pow_two] using c.t_involution.2
  have ht7sq : t7 ^ 2 = 1 := by
    change eA7 (q tN) ^ 2 = 1
    rw [← map_pow, ← map_pow]
    rw [htN2]
    simp
  have ht7ne : t7 ≠ 1 := by
    intro h
    have hq : q tN = 1 := eA7.injective (by simpa [t7] using h)
    have htO : tN ∈ O := (QuotientGroup.eq_one_iff (N := O) tN).mp hq
    have htOamb : (c.t : G) ∈ O.map N.subtype :=
      Subgroup.mem_map.mpr ⟨tN, htO, rfl⟩
    have hoddOamb : Odd (Nat.card (O.map N.subtype)) := by
      have hcard : Nat.card (O.map N.subtype) = Nat.card O :=
        Subgroup.card_map_of_injective N.subtype_injective
      exact hcard ▸ hOodd
    exact involution_not_mem_of_odd_card (O.map N.subtype) hoddOamb
      c.t_involution htOamb
  have ht7I : IsInvolution t7 := ⟨ht7ne, ht7sq⟩
  -- `f7` centralizes `t7`
  have hf7centT : f7 ∈ Subgroup.centralizer
      ({t7} : Set (alternatingGroup (Fin 7))) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    change eA7 (q pN) * eA7 (q tN) = eA7 (q tN) * eA7 (q pN)
    rw [← map_mul, ← map_mul, ← map_mul, ← map_mul]
    congr 1
    apply congrArg q
    apply Subtype.ext
    exact hpcommT
  have hPodd : Odd (Nat.card (Subgroup.zpowers f7)) := by
    rw [Nat.card_zpowers]
    exact hf7odd
  have hPcent : Subgroup.zpowers f7 ≤
      Subgroup.centralizer ({t7} : Set (alternatingGroup (Fin 7))) := by
    exact Subgroup.zpowers_le.mpr hf7centT
  have hforderle : orderOf f7 ≤ 3 := by
    have hP : Nat.card (Subgroup.zpowers f7) ≤ 3 :=
      aSeven_odd_subgroup_centralizing_involution_card_le_three
        (P := Subgroup.zpowers f7) hPodd ht7I hPcent
    rwa [Nat.card_zpowers] at hP
  -- the component image in the quotient, and its cardinality bound
  let Ei : Subgroup N := d.E.subgroupOf N
  let E7N : Subgroup (N ⧸ O) := Ei.map q
  let E7 : Subgroup (alternatingGroup (Fin 7)) := E7N.map eA7.toMonoidHom
  have : Finite (N ⧸ O) :=
    Finite.of_equiv (alternatingGroup (Fin 7)) hA7.some.toEquiv.symm
  let f : Ei →* E7N :=
    (q.comp Ei.subtype).codRestrict E7N (fun x =>
      Subgroup.mem_map.mpr ⟨x, x.2, rfl⟩)
  have hfsurj : Function.Surjective f := by
    intro y
    rcases Subgroup.mem_map.mp y.2 with ⟨x, hx, hxy⟩
    refine ⟨⟨x, hx⟩, ?_⟩
    apply Subtype.ext
    exact hxy
  have hkerE_le_O : f.ker ≤ O.comap Ei.subtype := by
    intro z hz
    rw [Subgroup.mem_comap]
    have hqz : q (Ei.subtype z) = 1 := by
      exact congrArg Subtype.val (MonoidHom.mem_ker.mp hz)
    exact (QuotientGroup.eq_one_iff (N := O) (Ei.subtype z)).mp hqz
  have hkerEodd : Odd (Nat.card f.ker) := by
    exact Odd.of_dvd_nat hOodd
      ((Subgroup.card_dvd_of_le hkerE_le_O).trans
        (Subgroup.card_comap_dvd_of_injective O Ei.subtype Ei.subtype_injective))
  have hkerCenter : f.ker ≤ Subgroup.center (↥Ei) := by
    have hkerCop : Nat.Coprime 2 (Nat.card f.ker) := Nat.coprime_two_left.mpr hkerEodd
    have hkerCore : f.ker ≤ pPrimeCore 2 (↥Ei) := le_sSup ⟨inferInstance, hkerCop⟩
    exact hkerCore.trans (pPrimeCore_le_center_of_isQuasisimple
      (isQuasisimple_mulEquiv_local (Subgroup.subgroupOfEquivOfLe hEleN).symm
        d.E_component.2.2))
  have hcardQ : Nat.card (PSL2 K) ≤ Nat.card E7N := by
    have hle := card_central_quotient_le_card_image_of_central_kernel
      (G := Ei) (H := E7N) f hkerCenter
    have hrange : Nat.card f.range = Nat.card E7N := by
      have htop : f.range = ⊤ := MonoidHom.range_eq_top.mpr hfsurj
      rw [htop]
      exact Nat.card_congr (Subgroup.topEquiv).toEquiv
    have hmapC := map_center_eq_center_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hEleN)
    have hqPSL : Nonempty ((Ei ⧸ Subgroup.center Ei) ≃* PSL2 K) :=
      ⟨(QuotientGroup.congr (Subgroup.center Ei) (Subgroup.center d.E)
          (Subgroup.subgroupOfEquivOfLe hEleN) hmapC).trans e.some⟩
    have hqcard : Nat.card (PSL2 K) = Nat.card (Ei ⧸ Subgroup.center Ei) :=
      (Nat.card_congr hqPSL.some.toEquiv).symm
    calc
      Nat.card (PSL2 K) = Nat.card (Ei ⧸ Subgroup.center Ei) := hqcard
      _ ≤ Nat.card f.range := hle
      _ = Nat.card E7N := hrange
  have hcardE7 : Nat.card E7N = Nat.card E7 := by
    change Nat.card E7N = Nat.card (E7N.map eA7.toMonoidHom)
    exact (Subgroup.card_map_of_injective (K := E7N) (f := eA7.toMonoidHom)
      eA7.injective).symm
  have hKgt3 : 3 < Nat.card K := secondCase_psl2_field_card_gt_three d K hK e
  have hKodd : Odd (Nat.card K) := by
    rcases hK with ⟨p, n, hp, hpOdd, hn, hcard⟩
    rw [hcard]
    exact hpOdd.pow
  have hKge5 : 5 ≤ Nat.card K := by
    have hKge4 : 4 ≤ Nat.card K := hKgt3
    have hKne4 : Nat.card K ≠ 4 := by
      intro h4
      apply hKodd.not_two_dvd_nat
      rw [h4]
      exact dvd_mul_right 2 2
    omega
  have h60 : 60 ≤ Nat.card (PSL2 K) := by
    rw [psl2_card_formula K hK]
    have h25 : 25 ≤ Nat.card K ^ 2 := by
      have h : 5 * 5 ≤ Nat.card K * Nat.card K := Nat.mul_le_mul hKge5 hKge5
      simpa [pow_two] using h
    have hq2 : 24 ≤ Nat.card K ^ 2 - 1 := by omega
    have hprod : 120 ≤ Nat.card K * (Nat.card K ^ 2 - 1) := by
      simpa using
        (Nat.mul_le_mul hKge5 hq2 : 5 * 24 ≤ Nat.card K * (Nat.card K ^ 2 - 1))
    exact (Nat.le_div_iff_mul_le (by norm_num : 0 < 2)).2 (by simpa using hprod)
  have h60E7 : 60 ≤ Nat.card E7 := by
    have hcard : Nat.card (PSL2 K) ≤ Nat.card E7 := by
      calc
        Nat.card (PSL2 K) ≤ Nat.card E7N := hcardQ
        _ = Nat.card E7 := hcardE7
    exact h60.trans hcard
  -- `s7`, the image of the reflection `s`, is an involution distinct from `t7`
  have hsI : IsInvolution (s : G) := centralizerSetup_reflection_isInvolution c hrefl
  have hsN2 : sN ^ 2 = 1 := by
    apply Subtype.ext
    change (s : G) ^ 2 = 1
    simpa [pow_two] using hsI.2
  let s7 : alternatingGroup (Fin 7) := eA7 (q sN)
  have hs7sq : s7 ^ 2 = 1 := by
    change eA7 (q sN) ^ 2 = 1
    rw [← map_pow, ← map_pow]
    rw [hsN2]
    simp
  have hs7ne : s7 ≠ 1 := by
    intro h
    have hq : q sN = 1 := eA7.injective (by simpa [s7] using h)
    have hsO : sN ∈ O := (QuotientGroup.eq_one_iff (N := O) sN).mp hq
    have hsOamb : (s : G) ∈ O.map N.subtype :=
      Subgroup.mem_map.mpr ⟨sN, hsO, rfl⟩
    have hoddOamb : Odd (Nat.card (O.map N.subtype)) := by
      have hcard : Nat.card (O.map N.subtype) = Nat.card O :=
        Subgroup.card_map_of_injective N.subtype_injective
      exact hcard ▸ hOodd
    exact involution_not_mem_of_odd_card (O.map N.subtype) hoddOamb
      hsI hsOamb
  have hs7I : IsInvolution s7 := ⟨hs7ne, hs7sq⟩
  have htsCommG : Commute (c.t : G) (s : G) := by
    have hsH : (s : G) ∈ c.H := centralizerSetup_S_le_H c hrefl.1
    rw [c.H_eq_centralizer, Subgroup.mem_centralizer_singleton_iff] at hsH
    exact hsH.symm
  have htsGne : c.t ≠ (s : G) := by
    intro h
    apply hrefl.2
    simpa [h] using c.t_mem_S0
  have hsinv : (s : G)⁻¹ = (s : G) := by
    exact inv_eq_of_mul_eq_one_left (by simpa [pow_two] using hsI.2)
  have ht7neS7 : t7 ≠ s7 := by
    intro h
    have hq : q tN = q sN := eA7.injective (by simpa [t7, s7] using h)
    have htsO : tN * sN⁻¹ ∈ O := by
      have hd := (QuotientGroup.eq_iff_div_mem.mp hq)
      rwa [div_eq_mul_inv] at hd
    have htsOamb : c.t * (s : G) ∈ O.map N.subtype := by
      refine Subgroup.mem_map.mpr ⟨tN * sN⁻¹, htsO, ?_⟩
      change (c.t : G) * (s : G)⁻¹ = c.t * (s : G)
      rw [hsinv]
    have hts2 : (c.t * (s : G)) ^ 2 = 1 := by
      rw [pow_two]
      calc
        c.t * (s : G) * (c.t * (s : G)) =
            c.t * ((s : G) * c.t) * (s : G) := by group
        _ = c.t * (c.t * (s : G)) * (s : G) := by rw [htsCommG.eq.symm]
        _ = (c.t * c.t) * ((s : G) * (s : G)) := by group
        _ = 1 := by
          have ht2 : c.t * c.t = 1 := by simpa [pow_two] using c.t_involution.2
          have hs2 : (s : G) * (s : G) = 1 := by simpa [pow_two] using hsI.2
          rw [ht2, hs2, one_mul]
    have htsne : c.t * (s : G) ≠ 1 := by
      intro h1
      apply htsGne
      calc
        c.t = c.t * (s : G) * (s : G)⁻¹ := by group
        _ = (s : G)⁻¹ := by rw [h1]; simp
        _ = (s : G) := hsinv
    have hordts : orderOf (c.t * (s : G)) = 2 := orderOf_eq_prime hts2 htsne
    have h2dvd : 2 ∣ Nat.card (O.map N.subtype) := by
      have hdvd := Subgroup.orderOf_dvd_natCard (O.map N.subtype) htsOamb
      simpa [hordts] using hdvd
    have hoddOamb : Odd (Nat.card (O.map N.subtype)) := by
      have hcard : Nat.card (O.map N.subtype) = Nat.card O :=
        Subgroup.card_map_of_injective N.subtype_injective
      exact hcard ▸ hOodd
    exact hoddOamb.not_two_dvd_nat h2dvd
  -- the image of the component lies in the centralizer of `f7`
  have hE7cent : E7 ≤
      Subgroup.centralizer ({f7} : Set (alternatingGroup (Fin 7))) := by
    intro y hy
    rw [Subgroup.mem_centralizer_singleton_iff]
    rcases Subgroup.mem_map.mp hy with ⟨y0, hy0, rfl⟩
    rcases Subgroup.mem_map.mp hy0 with ⟨x, hx, rfl⟩
    change eA7 (q x) * eA7 (q pN) = eA7 (q pN) * eA7 (q x)
    rw [← map_mul, ← map_mul, ← map_mul, ← map_mul]
    congr 1
    apply congrArg q
    apply Subtype.ext
    have hpc : p ∈ Subgroup.centralizer (d.E : Set G) := hFcentE hpF
    exact Subgroup.mem_centralizer_iff.mp hpc (x : G) (Subgroup.mem_subgroupOf.mp hx)
  -- the Klein four generated by `t7` and `s7`
  let T7 : Subgroup (alternatingGroup (Fin 7)) := Subgroup.zpowers t7
  let S7 : Subgroup (alternatingGroup (Fin 7)) := Subgroup.zpowers s7
  let V7 : Subgroup (alternatingGroup (Fin 7)) := T7 ⊔ S7
  have ht7Order : orderOf t7 = 2 := orderOf_eq_prime ht7sq ht7ne
  have hs7Order : orderOf s7 = 2 := orderOf_eq_prime hs7sq hs7ne
  have hT7card : Nat.card T7 = 2 := by
    change Nat.card (Subgroup.zpowers t7) = 2
    rw [Nat.card_zpowers, ht7Order]
  have hS7card : Nat.card S7 = 2 := by
    change Nat.card (Subgroup.zpowers s7) = 2
    rw [Nat.card_zpowers, hs7Order]
  have ht7T : t7 ∈ T7 := Subgroup.mem_zpowers t7
  have hs7S : s7 ∈ S7 := Subgroup.mem_zpowers s7
  have ht7Tne : (⟨t7, ht7T⟩ : T7) ≠ 1 := by
    intro ht1
    exact ht7ne (congrArg Subtype.val ht1)
  have hs7Sne : (⟨s7, hs7S⟩ : S7) ≠ 1 := by
    intro hs1
    exact hs7ne (congrArg Subtype.val hs1)
  have hTeq7 : ∀ z : T7, z = 1 ∨ z = ⟨t7, ht7T⟩ := by
    intro z
    by_cases hz : z = 1
    · exact Or.inl hz
    · rcases (Nat.card_eq_two_iff' (1 : T7)).mp hT7card with ⟨z0, _hz0ne, hz0uniq⟩
      exact Or.inr ((hz0uniq z hz).trans (hz0uniq ⟨t7, ht7T⟩ ht7Tne).symm)
  have hSeq7 : ∀ z : S7, z = 1 ∨ z = ⟨s7, hs7S⟩ := by
    intro z
    by_cases hz : z = 1
    · exact Or.inl hz
    · rcases (Nat.card_eq_two_iff' (1 : S7)).mp hS7card with ⟨z0, _hz0ne, hz0uniq⟩
      exact Or.inr ((hz0uniq z hz).trans (hz0uniq ⟨s7, hs7S⟩ hs7Sne).symm)
  have hdisjoint : Disjoint T7 S7 := by
    rw [Subgroup.disjoint_def]
    intro x hxT hxS
    rcases hTeq7 ⟨x, hxT⟩ with hx1 | hxt
    · exact congrArg Subtype.val hx1
    · rcases hSeq7 ⟨x, hxS⟩ with hx1 | hxs
      · exact congrArg Subtype.val hx1
      · exfalso
        apply ht7neS7
        exact (congrArg Subtype.val hxt).symm.trans (congrArg Subtype.val hxs)
  have hcomm7 : Commute t7 s7 := by
    change eA7 (q tN) * eA7 (q sN) = eA7 (q sN) * eA7 (q tN)
    rw [← map_mul, ← map_mul, ← map_mul, ← map_mul]
    congr 1
    apply congrArg q
    apply Subtype.ext
    exact htsCommG.eq
  have hs7CentT : s7 ∈ Subgroup.centralizer
      (T7 : Set (alternatingGroup (Fin 7))) := by
    rw [Subgroup.mem_centralizer_iff]
    intro x hxT
    rcases hxT with ⟨n, rfl⟩
    exact hcomm7.zpow_left n
  have hSNormT : S7 ≤ Subgroup.normalizer
      (T7 : Set (alternatingGroup (Fin 7))) := by
    apply Subgroup.zpowers_le.mpr
    exact Subgroup.centralizer_le_normalizer
      (T7 : Set (alternatingGroup (Fin 7))) hs7CentT
  have hV7card : Nat.card V7 = 4 := by
    dsimp [V7]
    rw [card_sup_eq_mul_of_disjoint_of_le_normalizer T7 S7 hSNormT hdisjoint,
      hT7card, hS7card]
  have hAllSq7 : ∀ x : V7, x ^ 2 = 1 := by
    intro x
    have hx : (x : alternatingGroup (Fin 7)) ∈
        (T7 : Set (alternatingGroup (Fin 7))) * (S7 : Set (alternatingGroup (Fin 7))) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left T7 S7 hSNormT]
      exact x.property
    rcases hx with ⟨a, haT, b, hbS, hab⟩
    rcases hTeq7 ⟨a, haT⟩ with ha1 | hat
    · rcases hSeq7 ⟨b, hbS⟩ with hb1 | hbs
      · have ha1G : a = 1 := congrArg Subtype.val ha1
        have hb1G : b = 1 := congrArg Subtype.val hb1
        apply Subtype.ext
        change (x : alternatingGroup (Fin 7)) ^ 2 = 1
        rw [← hab, ha1G, hb1G]
        simp
      · have ha1G : a = 1 := congrArg Subtype.val ha1
        have hbsG : b = s7 := congrArg Subtype.val hbs
        apply Subtype.ext
        change (x : alternatingGroup (Fin 7)) ^ 2 = 1
        rw [← hab, ha1G, hbsG]
        simpa [pow_two] using hs7sq
    · rcases hSeq7 ⟨b, hbS⟩ with hb1 | hbs
      · have hatG : a = t7 := congrArg Subtype.val hat
        have hb1G : b = 1 := congrArg Subtype.val hb1
        apply Subtype.ext
        change (x : alternatingGroup (Fin 7)) ^ 2 = 1
        rw [← hab, hatG, hb1G]
        simpa [pow_two] using ht7sq
      · have hatG : a = t7 := congrArg Subtype.val hat
        have hbsG : b = s7 := congrArg Subtype.val hbs
        apply Subtype.ext
        have ht2 : t7 * t7 = 1 := by simpa [pow_two] using ht7sq
        have hs2 : s7 * s7 = 1 := by simpa [pow_two] using hs7sq
        change (x : alternatingGroup (Fin 7)) ^ 2 = 1
        rw [← hab, hatG, hbsG, pow_two]
        calc
          t7 * s7 * (t7 * s7) = t7 * (s7 * t7) * s7 := by group
          _ = t7 * (t7 * s7) * s7 := by rw [hcomm7.eq.symm]
          _ = (t7 * t7) * (s7 * s7) := by group
          _ = 1 := by rw [ht2, hs2, one_mul]
  have hVnc : ¬ IsCyclic V7 := by
    intro hcyc
    obtain ⟨g, hg⟩ := isCyclic_iff_exists_orderOf_eq_natCard.mp hcyc
    have hg4 : orderOf g = 4 := hg.trans hV7card
    have hdvd : orderOf g ∣ 2 := orderOf_dvd_of_pow_eq_one (hAllSq7 g)
    rw [hg4] at hdvd
    norm_num at hdvd
  have hV7K : IsKleinFour V7 := {
    card_four := hV7card
    exponent_two :=
      (not_isCyclic_iff_exponent_eq_prime Nat.prime_two
        (by simpa using hV7card)).mp hVnc
  }
  have ht7E7 : t7 ∈ E7 := by
    dsimp [E7, E7N, t7]
    refine Subgroup.mem_map.mpr ⟨q tN, ?_, rfl⟩
    refine Subgroup.mem_map.mpr ⟨tN, ?_, rfl⟩
    exact Subgroup.mem_subgroupOf.mpr d.t_mem_E
  have hs7E7 : s7 ∈ E7 := by
    dsimp [E7, E7N, s7]
    refine Subgroup.mem_map.mpr ⟨q sN, ?_, rfl⟩
    refine Subgroup.mem_map.mpr ⟨sN, ?_, rfl⟩
    exact Subgroup.mem_subgroupOf.mpr s.2
  have hV7leE7 : V7 ≤ E7 := by
    dsimp [V7, T7, S7]
    exact sup_le (Subgroup.zpowers_le.mpr ht7E7) (Subgroup.zpowers_le.mpr hs7E7)
  have hV7cent : V7 ≤
      Subgroup.centralizer ({f7} : Set (alternatingGroup (Fin 7))) :=
    hV7leE7.trans hE7cent
  -- `orderOf f7` is `1` or `3`, and `3` is impossible
  have hforder13 : orderOf f7 = 1 ∨ orderOf f7 = 3 := by
    rcases hf7odd with ⟨k, hk⟩
    by_cases h1 : orderOf f7 = 1
    · exact Or.inl h1
    · right
      omega
  have hf7one : f7 = 1 := by
    rcases hforder13 with h1 | h3
    · exact (orderOf_eq_one_iff (x := f7)).1 h1
    · exfalso
      have hCcard : Nat.card
          (Subgroup.centralizer ({f7} : Set (alternatingGroup (Fin 7)))) = 36 :=
        aSeven_order_three_centralizer_card_eq_thirty_six_of_kleinFour
          f7 h3 V7 hV7K hV7cent
      have hE7leC : Nat.card E7 ≤ Nat.card
          (Subgroup.centralizer ({f7} : Set (alternatingGroup (Fin 7)))) :=
        Nat.le_of_dvd Nat.card_pos (Subgroup.card_dvd_of_le hE7cent)
      have hbad : 60 ≤ Nat.card
          (Subgroup.centralizer ({f7} : Set (alternatingGroup (Fin 7)))) :=
        h60E7.trans hE7leC
      rw [hCcard] at hbad
      omega
  -- `p ∈ O₂'(N)`, so `p` centralizes the layer
  have hq1 : q pN = 1 := eA7.injective (by simpa [f7] using hf7one)
  have hpO : pN ∈ O := (QuotientGroup.eq_one_iff (N := O) pN).mp hq1
  have hpOamb : p ∈ O.map N.subtype := Subgroup.mem_map.mpr ⟨pN, hpO, rfl⟩
  have hlC := (Subgroup.mem_centralizer_iff.mp (hLcentO hlL)) p hpOamb
  exact hlC

end CFSG.GorensteinWalter
