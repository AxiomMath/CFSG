module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.ASevenInvolutionCentralizerThreeCycle
public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.DihedralGenerators
public import Mathlib.Data.Nat.Factorization.Basic
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-!
# Section 4: the fixed-Sylow A₇ reflected-torus endpoint

This node refines `secondCase_reflection_a7_torus`: the inverting involution
is required to lie in the given Sylow `2`-subgroup `P`, which is assumed to
centralize the fixed involution `t`.  The proof conjugates `P` to the
concrete D₈ Sylow generated by `a7v` and `a7s` inside the centralizer of
`a7t`, transports the base reflected torus `⟨a7a⟩`, and reuses the
structural uniqueness of the normal order-three subgroup in that
centralizer.
-/

noncomputable section

open scoped Pointwise

namespace CFSG.GorensteinWalter

private theorem a7t_involution : IsInvolution a7t := by
  unfold IsInvolution
  constructor <;> decide

private theorem a7s_involution : IsInvolution a7s := by
  unfold IsInvolution
  constructor <;> decide

private theorem a7v_order : orderOf a7v = 4 := by
  apply (orderOf_eq_iff (n := 4) (by norm_num)).mpr
  constructor
  · decide
  · intro m hm0 hm4
    interval_cases m <;> decide

private theorem a7s_inverts_generator :
    a7s * a7a * a7s⁻¹ = a7a⁻¹ := by
  decide

private theorem a7s_inverts_three
    (x : A7) (hx : x ∈ Subgroup.zpowers a7a) :
    a7s * x * a7s⁻¹ = x⁻¹ := by
  rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, rfl⟩
  have hsgen : a7s * a7a * a7s⁻¹ = a7a⁻¹ :=
    a7s_inverts_generator
  have h := map_zpow (MulAut.conj a7s) a7a n
  simpa [hsgen, MulAut.conj_apply, inv_zpow] using h

private theorem a7s_not_mem_three :
    a7s ∉ Subgroup.zpowers a7a := by
  intro h
  have hdvd : orderOf a7s ∣ Nat.card (Subgroup.zpowers a7a) :=
    Subgroup.orderOf_dvd_natCard (Subgroup.zpowers a7a) h
  have hordS : orderOf a7s = 2 :=
    orderOf_eq_prime a7s_involution.2 a7s_involution.1
  have hordA : orderOf a7a = 3 := by
    apply orderOf_eq_prime
    · decide
    · decide
  rw [hordS, Nat.card_zpowers, hordA] at hdvd
  norm_num at hdvd

private theorem card_aSeven : Nat.card A7 = 2520 := by
  rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card]
  decide

private theorem factorization_two_2520 :
    (2520 : ℕ).factorization 2 = 3 := by
  rw [show 2520 = 2 ^ 3 * 315 by norm_num]
  rw [Nat.factorization_mul (by norm_num) (by norm_num)]
  rw [Nat.factorization_pow]
  simp [Nat.prime_two.factorization_self,
    Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 315)]

private theorem centralizer_conj_mem
    {G : Type*} [Group G] (g t x : G)
    (hx : x ∈ Subgroup.centralizer ({t} : Set G)) :
    g * x * g⁻¹ ∈ Subgroup.centralizer ({g * t * g⁻¹} : Set G) := by
  rw [Subgroup.mem_centralizer_singleton_iff] at hx ⊢
  calc
    (g * x * g⁻¹) * (g * t * g⁻¹) = g * (x * t) * g⁻¹ := by group
    _ = g * (t * x) * g⁻¹ := by rw [hx]
    _ = (g * t * g⁻¹) * (g * x * g⁻¹) := by group

private def a7BaseSubgroup : Subgroup A7 :=
  Subgroup.zpowers a7v ⊔ Subgroup.zpowers a7s

private lemma a7Base_is_dihedral4 :
    Nonempty (a7BaseSubgroup ≃* DihedralGroup 4) := by
  let ρ' : a7BaseSubgroup := ⟨a7v, by
    exact Subgroup.mem_sup_left (Subgroup.mem_zpowers a7v)⟩
  let σ' : a7BaseSubgroup := ⟨a7s, by
    exact Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s)⟩
  have hgen : ⊤ = Subgroup.zpowers ρ' ⊔ Subgroup.zpowers σ' := by
    have hmap : Subgroup.map a7BaseSubgroup.subtype ⊤ =
        Subgroup.map a7BaseSubgroup.subtype
          (Subgroup.zpowers ρ' ⊔ Subgroup.zpowers σ') := by
      rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
      rw [Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
      dsimp [ρ', σ']
      rfl
    exact (Subgroup.map_injective (f := a7BaseSubgroup.subtype)
      Subtype.coe_injective) hmap
  have hσ2 : σ' ^ 2 = 1 := by
    apply Subtype.ext
    simpa [σ', pow_two, Subgroup.coe_mul] using a7s_involution.2
  have hrel : σ' * ρ' * σ'⁻¹ = ρ'⁻¹ := by
    apply Subtype.ext
    dsimp [σ', ρ']
    change (a7s : A7) * (a7v : A7) * (a7s : A7)⁻¹ =
      (a7v : A7)⁻¹
    decide
  rcases (isCyclic_or_dihedral_of_generators ρ' σ' hgen hσ2 hrel) with hcyc | hdih
  · have : IsCyclic a7BaseSubgroup := hcyc
    have hcomm : ρ' * σ' = σ' * ρ' :=
      IsMulCommutative.is_comm.comm ρ' σ'
    have hc : ((ρ' * σ' : a7BaseSubgroup) : A7) =
        ((σ' * ρ' : a7BaseSubgroup) : A7) :=
      congrArg (fun x : a7BaseSubgroup => (x : A7)) hcomm
    have hdiff : a7v * a7s ≠ a7s * a7v := by decide
    have hamb : a7v * a7s = a7s * a7v := by
      simpa [ρ', σ', Subgroup.coe_mul] using hc
    exact False.elim (hdiff hamb)
  · rcases hdih with ⟨e⟩
    have hord : orderOf ρ' = 4 := by
      rw [← Subgroup.orderOf_coe ρ']
      dsimp [ρ']
      exact a7v_order
    rw [hord] at e
    exact ⟨e⟩

private theorem card_a7BaseSubgroup : Nat.card a7BaseSubgroup = 8 := by
  rw [Nat.card_congr (a7Base_is_dihedral4.some.toEquiv),
    DihedralGroup.nat_card]

private def a7BaseSylow : Sylow 2 A7 := by
  refine Sylow.ofCard a7BaseSubgroup ?_
  rw [card_a7BaseSubgroup, card_aSeven]
  rw [factorization_two_2520]
  norm_num

private theorem a7s_mem_base :
    a7s ∈ (a7BaseSylow : Subgroup A7) := by
  simpa [a7BaseSylow, a7BaseSubgroup] using
    Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s)

private theorem a7v_mem_base :
    a7v ∈ (a7BaseSylow : Subgroup A7) := by
  simpa [a7BaseSylow, a7BaseSubgroup] using
    Subgroup.mem_sup_left (Subgroup.mem_zpowers a7v)

private theorem a7Base_le_centralizer :
    (a7BaseSylow : Subgroup A7) ≤
      Subgroup.centralizer ({a7t} : Set A7) := by
  change a7BaseSubgroup ≤ Subgroup.centralizer ({a7t} : Set A7)
  apply sup_le
  · rw [Subgroup.zpowers_le]
    rw [Subgroup.mem_centralizer_singleton_iff]
    decide
  · rw [Subgroup.zpowers_le]
    rw [Subgroup.mem_centralizer_singleton_iff]
    decide

/-- In the fixed-Sylow A₇ model, the reflection can be chosen inside the
given Sylow `2`-subgroup while the odd centralizer containment is retained. -/
public theorem secondCase_reflection_a7_torus_fixedSylow
    (P : Sylow 2 (alternatingGroup (Fin 7)))
    {t : alternatingGroup (Fin 7)} (ht : IsInvolution t)
    (hPcent : (P : Subgroup (alternatingGroup (Fin 7))) ≤
      Subgroup.centralizer ({t} : Set (alternatingGroup (Fin 7)))) :
    ∃ T : Subgroup (alternatingGroup (Fin 7)),
      ∃ s : alternatingGroup (Fin 7),
        IsCyclic T ∧ s ∈ (P : Subgroup (alternatingGroup (Fin 7))) ∧
        s ∉ T ∧ IsInvolution s ∧
          (∀ x : alternatingGroup (Fin 7), x ∈ T → s * x * s⁻¹ = x⁻¹) ∧
            ∀ X : Subgroup (alternatingGroup (Fin 7)),
              (∀ x : alternatingGroup (Fin 7), x ∈ X → Odd (orderOf x)) →
                X ≤ Subgroup.centralizer ({t} : Set (alternatingGroup (Fin 7))) → X ≤ T := by
  classical
  let C0 : Subgroup A7 := Subgroup.centralizer ({a7t} : Set A7)
  obtain ⟨g, hgt⟩ := aSeven_involutions_conjugate t a7t ht a7t_involution
  let P1 : Sylow 2 A7 := g • P
  have hP1leC0 : (P1 : Subgroup A7) ≤ C0 := by
    intro y hy
    change y ∈ ((g • P : Sylow 2 A7) : Subgroup A7) at hy
    rw [Sylow.coe_subgroup_smul] at hy
    rcases Set.mem_smul_set.mp hy with ⟨p, hpP, hpeq⟩
    have hpC : p ∈ Subgroup.centralizer ({t} : Set A7) := hPcent hpP
    have hyC : g * p * g⁻¹ ∈
        Subgroup.centralizer ({g * t * g⁻¹} : Set A7) :=
      centralizer_conj_mem g t p hpC
    have hyC0 : MulAut.conj g p ∈ C0 := by
      simpa [hgt, MulAut.conj_apply] using hyC
    rwa [← hpeq]
  have hP0leC0 : (a7BaseSylow : Subgroup A7) ≤ C0 :=
    a7Base_le_centralizer
  let P1c : Sylow 2 C0 := P1.subtype hP1leC0
  let P0c : Sylow 2 C0 := a7BaseSylow.subtype hP0leC0
  obtain ⟨c0, hc0⟩ := MulAction.exists_smul_eq (C0) P0c P1c
  let c : A7 := c0
  have hcC : c ∈ C0 := c0.2
  have hcbase : c • a7BaseSylow = P1 := by
    apply Sylow.subtype_injective
    calc
      (c • a7BaseSylow).subtype (Sylow.smul_le hP0leC0 c0) =
          c0 • a7BaseSylow.subtype hP0leC0 :=
        (Sylow.smul_subtype hP0leC0 c0).symm
      _ = P1c := hc0
  have hgP : g • P = c • a7BaseSylow := by
    simpa [P1] using hcbase.symm
  let g0 : A7 := c⁻¹ * g
  have hg0t : g0 * t * g0⁻¹ = a7t := by
    have hcCent : c * a7t = a7t * c :=
      Subgroup.mem_centralizer_singleton_iff.mp hcC
    calc
      g0 * t * g0⁻¹ = c⁻¹ * (g * t * g⁻¹) * c := by
        dsimp [g0]
        group
      _ = c⁻¹ * a7t * c := by rw [hgt]
      _ = a7t := by
        have hEq : c⁻¹ * (a7t * c) = a7t := by
          calc
            c⁻¹ * (a7t * c) = c⁻¹ * (c * a7t) := by rw [hcCent]
            _ = a7t := by simp
        simpa [mul_assoc] using hEq
  have hg0base : g0 • P = a7BaseSylow := by
    calc
      g0 • P = c⁻¹ • (g • P) := by
        dsimp [g0]
        rw [← mul_smul]
      _ = c⁻¹ • (c • a7BaseSylow) := by rw [hgP]
      _ = a7BaseSylow := by
        rw [← mul_smul]
        simp
  let T : Subgroup A7 :=
    (Subgroup.zpowers a7a).map (MulAut.conj g0⁻¹).toMonoidHom
  let s : A7 := g0⁻¹ * a7s * g0
  have hTcyc : IsCyclic T := by
    let e : Subgroup.zpowers a7a ≃* T :=
      Subgroup.equivMapOfInjective (Subgroup.zpowers a7a)
        (MulAut.conj g0⁻¹).toMonoidHom (MulAut.conj g0⁻¹).injective
    exact (MulEquiv.isCyclic e).mp (Subgroup.isCyclic_zpowers a7a)
  have hsP : s ∈ (P : Subgroup A7) := by
    have ha : a7s ∈ (a7BaseSylow : Subgroup A7) := a7s_mem_base
    have ha' : a7s ∈ ((g0 • P : Sylow 2 A7) : Subgroup A7) := by
      simpa [← hg0base] using ha
    rw [Sylow.coe_subgroup_smul] at ha'
    rcases Set.mem_smul_set.mp ha' with ⟨p, hpP, hpeq⟩
    have hp_eq : p = s := by
      dsimp [s]
      calc
        p = g0⁻¹ * (g0 * p * g0⁻¹) * g0 := by group
        _ = g0⁻¹ * a7s * g0 := by
          change g0 * p * g0⁻¹ = a7s at hpeq
          rw [hpeq]
    have hpP' : p ∈ (P : Subgroup A7) := hpP
    simpa [hp_eq] using hpP'
  have hsI : IsInvolution s := by
    constructor
    · intro hs1
      apply a7s_involution.1
      have hrefl1 : a7s = 1 := by
        calc
          a7s = g0 * s * g0⁻¹ := by
            simp [s, mul_assoc]
          _ = g0 * 1 * g0⁻¹ := by
            rw [hs1]
          _ = 1 := by simp
      exact hrefl1
    · calc
        s ^ 2 = g0⁻¹ * (a7s ^ 2) * g0 := by
          simp [s, pow_two, mul_assoc]
        _ = 1 := by
          rw [a7s_involution.2]
          simp
  have hs_not_T : s ∉ T := by
    intro hsT
    rcases Subgroup.mem_map.mp hsT with ⟨u, hu, hgu⟩
    have hu0 : u = a7s := by
      apply (MulAut.conj g0⁻¹).injective
      simpa [s, MulAut.conj_apply] using hgu
    exact a7s_not_mem_three (by simpa [hu0] using hu)
  have hinvT : ∀ x : A7, x ∈ T → s * x * s⁻¹ = x⁻¹ := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨u, hu, rfl⟩
    have hsu : a7s * u * a7s⁻¹ = u⁻¹ :=
      a7s_inverts_three u hu
    calc
      (g0⁻¹ * a7s * g0) * (g0⁻¹ * u * g0) *
          (g0⁻¹ * a7s * g0)⁻¹ =
          g0⁻¹ * (a7s * u * a7s⁻¹) * g0 := by group
      _ = g0⁻¹ * u⁻¹ * g0 := by rw [hsu]
      _ = (g0⁻¹ * u * g0)⁻¹ := by group
  have hcontain :
      ∀ X : Subgroup A7,
        (∀ x : A7, x ∈ X → Odd (orderOf x)) →
          X ≤ Subgroup.centralizer ({t} : Set A7) → X ≤ T := by
    intro X hXodd hXcent x hx
    let X0 : Subgroup A7 := X.map (MulAut.conj g0).toMonoidHom
    have hX0odd : ∀ y : A7, y ∈ X0 → Odd (orderOf y) := by
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨x0, hx0, rfl⟩
      have hord : orderOf ((MulAut.conj g0) x0) = orderOf x0 :=
        (MulAut.conj g0).orderOf_eq x0
      change Odd (orderOf ((MulAut.conj g0) x0))
      rw [hord]
      exact hXodd x0 hx0
    have hX0cent : X0 ≤ Subgroup.centralizer ({a7t} : Set A7) := by
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨x0, hx0, rfl⟩
      have hxcent : x0 ∈ Subgroup.centralizer ({t} : Set A7) := hXcent hx0
      have hycent : g0 * x0 * g0⁻¹ ∈
          Subgroup.centralizer ({g0 * t * g0⁻¹} : Set A7) :=
        centralizer_conj_mem g0 t x0 hxcent
      simpa [hg0t, MulAut.conj_apply] using hycent
    have hX0T0 : X0 ≤ Subgroup.zpowers a7a :=
      aSeven_odd_subgroup_centralizing_a7t_le_zpowers hX0odd hX0cent
    have hy0 : g0 * x * g0⁻¹ ∈ X0 :=
      Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
    have hy0T0 : g0 * x * g0⁻¹ ∈ Subgroup.zpowers a7a := hX0T0 hy0
    exact Subgroup.mem_map.mpr ⟨g0 * x * g0⁻¹, hy0T0, by
      simp [mul_assoc]⟩
  exact ⟨T, s, hTcyc, hsP, hs_not_T, hsI, hinvT, hcontain⟩

end CFSG.GorensteinWalter
