module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section4.SecondCaseComponentData
public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section2.ComponentA7InvolutionFusion
public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Section2.ComponentPSL2InvolutionFusion
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-!
# Section 4: `M = E C_M(t)` for the selected second-case component

The selected component `E` is normal in the maximal subgroup `M`.  Its odd
center and central-quotient model (`A₇` or `PSL₂(K)`) fuse every involution
of `E` to the distinguished involution `t`.  Conjugating `t` by an arbitrary
`m ∈ M` therefore produces an element of `E` conjugate to `t` inside `E`, and
the conjugating factor absorbs `m` into `C_M(t)`.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

/-- The component fusion endpoints, dispatched over the two quotient models. -/
public theorem secondCase_involutions_fused
    {G : Type u} [Group G] [Finite G]
    {c : CentralizerSetup G}
    (w : SecondCaseWitness c)
    (d : SecondCaseComponentData w) :
    ∀ z : G, z ∈ d.E → IsInvolution z →
      ∃ g : G, g ∈ d.E ∧ g * z * g⁻¹ = c.t := by
  cases d.model with
  | alternating e =>
      exact component_involutions_fused_of_central_quotient_aSeven
        d.E d.center_odd e d.t_mem_E c.t_involution
  | projectiveSpecialLinear K hKprimePower e =>
      exact component_involutions_fused_of_central_quotient_psl2
        d.E K hKprimePower d.center_odd e d.t_mem_E c.t_involution

/-- In the second case, the maximal subgroup is generated by its selected
component and the `M`-part of the centralizer of the distinguished
involution: the source line `M = E C_M(t)`. -/
public theorem secondCase_M_eq_component_sup_centralizer
    {G : Type u} [Group G] [Finite G]
    {c : CentralizerSetup G}
    (w : SecondCaseWitness c)
    (d : SecondCaseComponentData w) :
    w.M = d.E ⊔ (Subgroup.centralizer ({c.t} : Set G) ⊓ w.M) := by
  apply le_antisymm
  · intro m hmM
    have hz : m * c.t * m⁻¹ ∈ d.E :=
      d.E_normal.2 m hmM c.t d.t_mem_E
    have hzI : IsInvolution (m * c.t * m⁻¹) := by
      constructor
      · intro hone
        apply c.t_involution.1
        have hc := congrArg (fun z : G => m⁻¹ * z * m) hone
        simpa [mul_assoc] using hc
      · calc
          (m * c.t * m⁻¹) ^ 2 = m * (c.t ^ 2) * m⁻¹ := by
            simp only [pow_two]
            group
          _ = 1 := by rw [c.t_involution.2]; simp
    obtain ⟨g, hgE, hgzt⟩ :=
      secondCase_involutions_fused w d (m * c.t * m⁻¹) hz hzI
    have hgM : g ∈ w.M := d.E_component.1 hgE
    have hgmM : g * m ∈ w.M := Subgroup.mul_mem w.M hgM hmM
    have hgmCent : g * m ∈ Subgroup.centralizer ({c.t} : Set G) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      have hconj : (g * m) * c.t * (g * m)⁻¹ = c.t := by
        calc
          (g * m) * c.t * (g * m)⁻¹ = g * (m * c.t * m⁻¹) * g⁻¹ := by
            group
          _ = c.t := hgzt
      calc
        (g * m) * c.t = (g * m) * c.t * (g * m)⁻¹ * (g * m) := by
          group
        _ = c.t * (g * m) := by rw [hconj]
    have hgmInf : g * m ∈ Subgroup.centralizer ({c.t} : Set G) ⊓ w.M :=
      Subgroup.mem_inf.mpr ⟨hgmCent, hgmM⟩
    simpa using (Subgroup.mul_mem_sup (d.E.inv_mem hgE) hgmInf)
  · exact sup_le d.E_component.1 inf_le_right

end CFSG.GorensteinWalter
