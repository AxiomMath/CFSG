module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Classification
import Mathlib.GroupTheory.GroupAction.ConjAct
import Mathlib.GroupTheory.SpecificGroups.Dihedral

namespace CFSG
end CFSG
open CFSG

/-!
# Odd-index normal subgroups of minimal normal groups with dihedral Sylow 2-subgroups

The subgroup generated by all Sylow `2`-subgroups is characteristic.  Inside
an ambient minimal normal subgroup it is therefore either trivial or the whole
subgroup; dihedral Sylow structure excludes triviality.  A normal subgroup of
odd index contains every Sylow `2`-subgroup, so it must contain this
characteristic residual and hence be the whole group.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

/-- The subgroup generated by all Sylow `2`-subgroups. -/
private def sylowTwoResidual (Q : Type u) [Group Q] : Subgroup Q :=
  ⨆ S : Sylow 2 Q, (S : Subgroup Q)

/-- Automorphisms permute the Sylow `2`-subgroups, so their join is
characteristic. -/
private theorem sylowTwoResidual_characteristic
    {Q : Type u} [Group Q] [Finite Q] :
    (sylowTwoResidual Q).Characteristic := by
  rw [Subgroup.characteristic_iff_map_le]
  intro e
  rw [sylowTwoResidual, Subgroup.map_iSup]
  apply iSup_le
  intro P
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Pe : Sylow 2 Q :=
    Sylow.mapSurjective (f := e.toMonoidHom) e.surjective P
  change (Pe : Subgroup Q) ≤ ⨆ S : Sylow 2 Q, (S : Subgroup Q)
  exact le_iSup (fun S : Sylow 2 Q => (S : Subgroup Q)) Pe

/-- A normal subgroup of odd index contains every Sylow `2`-subgroup. -/
private theorem sylow_le_of_normal_odd_index
    {Q : Type u} [Group Q] [Finite Q]
    (L : Subgroup Q) (hLnormal : L.Normal) (hLindex : Odd L.index)
    (P : Sylow 2 Q) :
    (P : Subgroup Q) ≤ L := by
  let : L.Normal := hLnormal
  let pi : Q →* Q ⧸ L := QuotientGroup.mk' L
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hmapP : IsPGroup 2 ((P : Subgroup Q).map pi) :=
    P.isPGroup'.map pi
  rcases IsPGroup.iff_card.mp hmapP with ⟨n, hn⟩
  have hcard_dvd :
      Nat.card ((P : Subgroup Q).map pi) ∣ Nat.card (Q ⧸ L) :=
    Subgroup.card_subgroup_dvd_card ((P : Subgroup Q).map pi)
  have hquot_odd : Odd (Nat.card (Q ⧸ L)) := by
    simpa only [Subgroup.index_eq_card] using hLindex
  cases n with
  | zero =>
      have hmap_bot : (P : Subgroup Q).map pi = ⊥ := by
        exact Subgroup.eq_bot_of_card_eq
          ((P : Subgroup Q).map pi) (by simpa using hn)
      have hle_ker : (P : Subgroup Q) ≤ pi.ker :=
        (Subgroup.map_eq_bot_iff (H := (P : Subgroup Q)) (f := pi)).mp hmap_bot
      simpa [pi, QuotientGroup.ker_mk'] using hle_ker
  | succ n =>
      have htwo_dvd_map : 2 ∣ Nat.card ((P : Subgroup Q).map pi) := by
        rw [hn]
        exact dvd_pow_self 2 (Nat.succ_ne_zero n)
      exact False.elim
        (hquot_odd.not_two_dvd_nat (htwo_dvd_map.trans hcard_dvd))

/-- Let `H` be a minimal normal subgroup of an ambient finite group.  If `H`
has dihedral Sylow `2`-subgroups, then every normal odd-index subgroup of `H`
is all of `H`. -/
public theorem normal_odd_index_eq_top_of_minimalNormal_dihedral
    {G : Type u} [Group G] [Finite G]
    (H : Subgroup G) (hHnormal : H.Normal)
    (hHmin : ∀ M : Subgroup G, M.Normal → M ≤ H → M = ⊥ ∨ M = H)
    (hHd : HasDihedralSylowTwo (↥H))
    (L : Subgroup (↥H)) (hLnormal : L.Normal) (hLindex : Odd L.index) :
    L = ⊤ := by
  classical
  let R : Subgroup (↥H) := sylowTwoResidual (↥H)
  have hRchar : R.Characteristic := by
    simpa [R] using (sylowTwoResidual_characteristic (Q := ↥H))
  have hRne : R ≠ ⊥ := by
    let P : Sylow 2 (↥H) := Classical.choice Sylow.nonempty
    rcases hHd P with ⟨m, _hm, ⟨e⟩⟩
    have hPcard : Nat.card (↥(P : Subgroup (↥H))) = 2 * 2 ^ m := by
      calc
        Nat.card (↥(P : Subgroup (↥H))) = Nat.card (DihedralGroup (2 ^ m)) :=
          Nat.card_congr e.toEquiv
        _ = 2 * 2 ^ m := DihedralGroup.nat_card
    have hPne : (P : Subgroup (↥H)) ≠ ⊥ := by
      intro hPbot
      have hcard_one : Nat.card (↥(P : Subgroup (↥H))) = 1 := by
        rw [hPbot]
        exact Subgroup.card_bot
      rw [hPcard] at hcard_one
      have hpow_pos : 0 < 2 ^ m := pow_pos (by norm_num) m
      omega
    intro hRbot
    apply hPne
    apply le_bot_iff.mp
    rw [← hRbot]
    exact le_iSup (fun S : Sylow 2 (↥H) => (S : Subgroup (↥H))) P
  let : H.Normal := hHnormal
  let : R.Characteristic := hRchar
  have hRmap_normal : (R.map H.subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hRmap_ne : R.map H.subtype ≠ ⊥ := by
    intro hbot
    apply hRne
    exact (Subgroup.map_eq_bot_iff_of_injective R H.subtype_injective).mp hbot
  have hRmap_eq_H : R.map H.subtype = H :=
    (hHmin (R.map H.subtype) hRmap_normal (Subgroup.map_subtype_le R)).resolve_left
      hRmap_ne
  have hRleL : R ≤ L := by
    dsimp [R, sylowTwoResidual]
    exact iSup_le fun P => sylow_le_of_normal_odd_index L hLnormal hLindex P
  apply top_unique
  intro x _hx
  have hxmap : (x : G) ∈ R.map H.subtype := by
    rw [hRmap_eq_H]
    exact x.property
  rcases Subgroup.mem_map.mp hxmap with ⟨r, hrR, hrx⟩
  have hxr : x = r := Subtype.ext hrx.symm
  rw [hxr]
  exact hRleL hrR

end CFSG.GorensteinWalter
