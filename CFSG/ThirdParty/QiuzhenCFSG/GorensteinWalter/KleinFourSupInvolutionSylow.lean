module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.CardSupOfDisjointNormalizer
public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.Defs
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.SpecificGroups.KleinFour
import Mathlib.Tactic

namespace CFSG
end CFSG
open CFSG

/-! # A Sylow subgroup generated by a Klein four and an outside involution -/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

/-- If all ambient Sylow `2`-subgroups have order eight, then a normalized
Klein four joined with a normalized outside involution is a Sylow subgroup
of the corresponding doubled subgroup. -/
public theorem exists_sylow_sup_zpowers_of_normalized_kleinFour
    {G : Type u} [Group G] [Finite G]
    (S : Sylow 2 G) (hScard : Nat.card (S : Subgroup G) = 8)
    (D V : Subgroup G) (hVleD : V ≤ D) (hVK : IsKleinFour V)
    {y : G} (hy : IsInvolution y) (hyD : y ∉ D)
    (hyND : y ∈ Subgroup.normalizer (D : Set G))
    (hyNV : y ∈ Subgroup.normalizer (V : Set G)) :
    ∃ Q : Sylow 2 ↥(D ⊔ Subgroup.zpowers y : Subgroup G),
      (V ⊔ Subgroup.zpowers y).subgroupOf
          (D ⊔ Subgroup.zpowers y) =
        (Q : Subgroup ↥(D ⊔ Subgroup.zpowers y : Subgroup G)) ∧
      Nat.card (D ⊔ Subgroup.zpowers y : Subgroup G) = Nat.card D * 2 ∧
      Nat.card ((V ⊔ Subgroup.zpowers y).subgroupOf
        (D ⊔ Subgroup.zpowers y)) = 8 := by
  classical
  let Z : Subgroup G := Subgroup.zpowers y
  have hyOrder : orderOf y = 2 := orderOf_eq_prime hy.2 hy.1
  have hZcard : Nat.card Z = 2 := by
    simp [Z, Nat.card_zpowers, hyOrder]
  have hZleND : Z ≤ Subgroup.normalizer (D : Set G) :=
    Subgroup.zpowers_le.mpr hyND
  have hZleNV : Z ≤ Subgroup.normalizer (V : Set G) :=
    Subgroup.zpowers_le.mpr hyNV
  have disjoint_zpowers_of_not_mem (K : Subgroup G) (hyK : y ∉ K) :
      Disjoint K Z := by
    rw [Subgroup.disjoint_def]
    intro x hxK hxZ
    by_contra hx1
    have hxOrder : orderOf x = 2 := by
      have hdiv : orderOf x ∣ 2 := by
        rw [← hZcard]
        exact Subgroup.orderOf_dvd_natCard Z hxZ
      exact ((Nat.dvd_prime Nat.prime_two).mp hdiv).resolve_left
        (fun h => hx1 (orderOf_eq_one_iff.mp h))
    have hzxle : Subgroup.zpowers x ≤ Z := Subgroup.zpowers_le.mpr hxZ
    have hzxcard : Nat.card (Subgroup.zpowers x) = 2 := by
      rw [Nat.card_zpowers, hxOrder]
    have hzxEq : Subgroup.zpowers x = Z :=
      Subgroup.eq_of_le_of_card_ge hzxle (by rw [hZcard, hzxcard])
    have hyzx : y ∈ Subgroup.zpowers x := by
      rw [hzxEq]
      exact Subgroup.mem_zpowers y
    exact hyK ((Subgroup.zpowers_le.mpr hxK) hyzx)
  have hDdisj : Disjoint D Z := disjoint_zpowers_of_not_mem D hyD
  have hyV : y ∉ V := fun hyV => hyD (hVleD hyV)
  have hVdisj : Disjoint V Z := disjoint_zpowers_of_not_mem V hyV
  let R : Subgroup G := D ⊔ Z
  let P : Subgroup G := V ⊔ Z
  have hRcard : Nat.card R = Nat.card D * 2 := by
    rw [show R = D ⊔ Z by rfl,
      card_sup_eq_mul_of_disjoint_of_le_normalizer D Z hZleND hDdisj,
      hZcard]
  have hPcard : Nat.card P = 8 := by
    rw [show P = V ⊔ Z by rfl,
      card_sup_eq_mul_of_disjoint_of_le_normalizer V Z hZleNV hVdisj,
      hVK.card_four, hZcard]
  have hPleR : P ≤ R := sup_le (hVleD.trans le_sup_left) le_sup_right
  let PR : Subgroup R := P.subgroupOf R
  have hPRcard : Nat.card PR = 8 := by
    calc
      Nat.card PR = Nat.card P :=
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPleR).toEquiv
      _ = 8 := hPcard
  have hPp : IsPGroup 2 P := IsPGroup.of_card (n := 3) (by
    rw [hPcard]
    norm_num)
  have hPRp : IsPGroup 2 PR :=
    hPp.of_equiv (Subgroup.subgroupOfEquivOfLe hPleR).symm
  obtain ⟨Q, hPRleQ⟩ := hPRp.exists_le_sylow
  let QG : Subgroup G := (Q : Subgroup R).map R.subtype
  have hQGcard : Nat.card QG = Nat.card (Q : Subgroup R) :=
    Subgroup.card_map_of_injective R.subtype_injective
  have hQGp : IsPGroup 2 QG := Q.isPGroup'.map R.subtype
  obtain ⟨T, hQGleT⟩ := hQGp.exists_le_sylow
  have hTcard : Nat.card (T : Subgroup G) = 8 := by
    calc
      Nat.card (T : Subgroup G) = Nat.card (S : Subgroup G) :=
        Nat.card_congr (Sylow.equiv T S).toEquiv
      _ = 8 := hScard
  have hQcardLe : Nat.card (Q : Subgroup R) ≤ 8 := by
    rw [← hQGcard, ← hTcard]
    exact Nat.le_of_dvd Nat.card_pos (Subgroup.card_dvd_of_le hQGleT)
  have hQcardGe : 8 ≤ Nat.card (Q : Subgroup R) := by
    rw [← hPRcard]
    exact Nat.le_of_dvd Nat.card_pos (Subgroup.card_dvd_of_le hPRleQ)
  have hQcard : Nat.card (Q : Subgroup R) = 8 :=
    le_antisymm hQcardLe hQcardGe
  have hPReqQ : PR = (Q : Subgroup R) :=
    Subgroup.eq_of_le_of_card_ge hPRleQ (by rw [hPRcard, hQcard])
  exact ⟨Q, by simpa [R, P, PR, Z] using hPReqQ,
    by simpa [R, Z] using hRcard,
    by simpa [R, P, PR, Z] using hPRcard⟩

end CFSG.GorensteinWalter
