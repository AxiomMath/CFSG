module

public import CFSG.ThirdParty.QiuzhenCFSG.GorensteinWalter.CyclicOrderThreeAutomorphism

import Mathlib.Tactic.Group

namespace CFSG
end CFSG
open CFSG

/-!
# Normalizers of order-three subgroups
-/

namespace CFSG.GorensteinWalter

universe u

/-- If an element of square one normalizes and inverts a subgroup of order
three, then the subgroup normalizer is generated by its centralizer and that
element. -/
public theorem normalizer_eq_centralizer_sup_zpowers_of_card_eq_three
    {G : Type u} [Group G] [Finite G]
    (X : Subgroup G) (hXcard : Nat.card X = 3)
    {u : G} (huSq : u ^ 2 = 1)
    (huNorm : u ∈ Subgroup.normalizer (X : Set G))
    (huInv : ∀ x : G, x ∈ X → u * x * u⁻¹ = x⁻¹) :
    Subgroup.normalizer (X : Set G) =
      Subgroup.centralizer (X : Set G) ⊔ Subgroup.zpowers u := by
  classical
  apply le_antisymm
  · intro g hg
    let gN : Subgroup.normalizer (X : Set G) := ⟨g, hg⟩
    let alpha : MulAut X := X.normalizerMonoidHom gN
    rcases mulAut_eq_one_or_apply_eq_inv_of_card_eq_three hXcard alpha with
      halpha | halpha
    · have hgker : gN ∈ X.normalizerMonoidHom.ker := by
        rw [MonoidHom.mem_ker]
        exact halpha
      rw [Subgroup.normalizerMonoidHom_ker] at hgker
      exact Subgroup.mem_sup_left hgker
    · have hguCent : g * u ∈ Subgroup.centralizer (X : Set G) := by
        rw [Subgroup.mem_centralizer_iff]
        intro z hz
        have hgInv : g * z * g⁻¹ = z⁻¹ := by
          have hz' := halpha ⟨z, hz⟩
          exact congrArg Subtype.val hz'
        have huInvZ : u * z * u⁻¹ = z⁻¹ := huInv z hz
        have hgInvInv : g * z⁻¹ * g⁻¹ = z := by
          calc
            g * z⁻¹ * g⁻¹ = (g * z * g⁻¹)⁻¹ := by group
            _ = z := by rw [hgInv]; simp
        have hconj : (g * u) * z * (g * u)⁻¹ = z := by
          rw [mul_inv_rev]
          calc
            (g * u) * z * (u⁻¹ * g⁻¹) =
                g * (u * z * u⁻¹) * g⁻¹ := by group
            _ = g * z⁻¹ * g⁻¹ := by rw [huInvZ]
            _ = z := hgInvInv
        have hmul := congrArg (fun w : G => w * (g * u)) hconj
        have hcomm : (g * u) * z = z * (g * u) := by
          simpa [mul_assoc] using hmul
        exact hcomm.symm
      have huZ : u ∈ Subgroup.zpowers u := Subgroup.mem_zpowers u
      have hprod : (g * u) * u ∈
          Subgroup.centralizer (X : Set G) ⊔ Subgroup.zpowers u :=
        (Subgroup.centralizer (X : Set G) ⊔ Subgroup.zpowers u).mul_mem
          (Subgroup.mem_sup_left hguCent) (Subgroup.mem_sup_right huZ)
      have huu : u * u = 1 := by simpa [pow_two] using huSq
      simpa [mul_assoc, huu] using hprod
  · exact sup_le (Subgroup.centralizer_le_normalizer (X : Set G))
      (Subgroup.zpowers_le.mpr huNorm)

end CFSG.GorensteinWalter
