module

public import Mathlib.GroupTheory.SpecificGroups.Dihedral

namespace CFSG
end CFSG
open CFSG

/-!
# Groups generated by a rotation and a reflection

This module isolates the presentation argument used throughout the
Gorenstein--Walter development: two generators satisfying the dihedral
relations generate either a cyclic group or the corresponding finite
dihedral group.
-/

noncomputable section

namespace CFSG.GorensteinWalter

universe u

-- (R1) σ·ρ^t = ρ^(−t)·σ, from the dihedral relation, nat t / zpow RHS
private lemma rel_zpow_mul {D : Type u} [Group D] {ρ σ : D}
    (hrel : σ * ρ * σ⁻¹ = ρ⁻¹) (t : ℕ) :
    σ * ρ ^ t = ρ ^ (-(t : ℤ)) * σ := by
  induction t with
  | zero => simp
  | succ t ih =>
      have h' : σ * ρ = ρ⁻¹ * σ := by
        simpa [mul_assoc] using congrArg (fun x : D => x * σ) hrel
      calc
        σ * ρ ^ (t + 1) = σ * (ρ ^ t * ρ) := by rw [pow_succ]
        _ = (σ * ρ ^ t) * ρ := by rw [mul_assoc]
        _ = (ρ ^ (-(t : ℤ)) * σ) * ρ := by rw [ih]
        _ = ρ ^ (-(t : ℤ)) * (σ * ρ) := by rw [mul_assoc]
        _ = ρ ^ (-(t : ℤ)) * (ρ⁻¹ * σ) := by rw [h']
        _ = (ρ ^ (-(t : ℤ)) * ρ⁻¹) * σ := by rw [mul_assoc]
        _ = ρ ^ (-((t + 1 : ℕ) : ℤ)) * σ := by
              rw [← zpow_neg_one ρ, ← zpow_add]
              exact congrArg (fun e : ℤ => ρ ^ e * σ) (by omega)

-- (R2) ρ^t·σ = σ·ρ^(−t)
private lemma zpow_mul_rel {D : Type u} [Group D] {ρ σ : D}
    (hσ2 : σ ^ 2 = 1) (hrel : σ * ρ * σ⁻¹ = ρ⁻¹) (t : ℕ) :
    ρ ^ t * σ = σ * ρ ^ (-(t : ℤ)) := by
  have h1 := rel_zpow_mul (ρ := ρ) (σ := σ) hrel t
  have hstep : ρ ^ t = σ * ρ ^ (-(t : ℤ)) * σ := by
    calc
      ρ ^ t = (σ * σ) * ρ ^ t := by rw [← pow_two, hσ2, one_mul]
      _ = σ * (σ * ρ ^ t) := by rw [mul_assoc]
      _ = σ * (ρ ^ (-(t : ℤ)) * σ) := by rw [h1]
      _ = σ * ρ ^ (-(t : ℤ)) * σ := by rw [mul_assoc]
  calc
    ρ ^ t * σ = (σ * ρ ^ (-(t : ℤ)) * σ) * σ := by rw [hstep]
    _ = σ * ρ ^ (-(t : ℤ)) := by
          calc
            (σ * ρ ^ (-(t : ℤ)) * σ) * σ = σ * ρ ^ (-(t : ℤ)) * (σ * σ) := by group
            _ = σ * ρ ^ (-(t : ℤ)) * (σ ^ 2) := by rw [← pow_two]
            _ = σ * ρ ^ (-(t : ℤ)) := by rw [hσ2, mul_one]

-- (I1) ρ^((i+j).val) = ρ^(i.val)·ρ^(j.val)
private lemma pow_val_add_eq {D : Type u} [Group D] [Finite D] {ρ : D} {n : ℕ} (hn : orderOf ρ = n)
    (i j : ZMod n) : ρ ^ ((i + j).val) = ρ ^ i.val * ρ ^ j.val := by
  have : NeZero n := ⟨by rw [← hn]; exact (orderOf_pos ρ).ne'⟩
  have hcong : (i.val + j.val) % n ≡ i.val + j.val [MOD n] := Nat.mod_modEq (i.val + j.val) n
  have hx : ρ ^ n = 1 := by rw [← hn]; exact pow_orderOf_eq_one ρ
  calc
    ρ ^ ((i + j).val) = ρ ^ ((i.val + j.val) % n) := by rw [ZMod.val_add (n := n) i j]
    _ = ρ ^ (i.val + j.val) := pow_eq_pow_of_modEq hcong hx
    _ = ρ ^ i.val * ρ ^ j.val := by rw [pow_add]

-- (I2) ρ^((j−i).val) = ρ^((j.val : ℤ) − (i.val : ℤ))
private lemma pow_val_sub_zpow {D : Type u} [Group D] [Finite D] {ρ : D} {n : ℕ} (hn : orderOf ρ = n)
    (i j : ZMod n) : ρ ^ ((j - i).val) = ρ ^ ((j.val : ℤ) - (i.val : ℤ)) := by
  have : NeZero n := ⟨by rw [← hn]; exact (orderOf_pos ρ).ne'⟩
  have hji : (i + (j - i) : ZMod n) = j := by simp [sub_eq_add_neg, add_assoc]
  have hval : j.val = (i.val + (j - i).val) % n := by
    calc
      j.val = (i + (j - i) : ZMod n).val := by rw [hji]
      _ = (i.val + (j - i).val) % n := ZMod.val_add (n := n) i (j - i)
  have hcong : j.val ≡ i.val + (j - i).val [MOD n] := by
    rw [hval]
    exact Nat.mod_modEq _ _
  have hx : ρ ^ n = 1 := by rw [← hn]; exact pow_orderOf_eq_one ρ
  have hp : ρ ^ j.val = ρ ^ i.val * ρ ^ ((j - i).val) := by
    calc
      ρ ^ j.val = ρ ^ (i.val + (j - i).val) := pow_eq_pow_of_modEq hcong hx
      _ = ρ ^ i.val * ρ ^ ((j - i).val) := by rw [pow_add]
  calc
    ρ ^ ((j - i).val) = (ρ ^ i.val)⁻¹ * ρ ^ j.val := by rw [hp]; group
    _ = ρ ^ (-(i.val : ℤ)) * ρ ^ (j.val : ℤ) := by
          rw [← zpow_natCast (a := ρ) (n := i.val), ← zpow_neg (a := ρ) (n := (i.val : ℤ)),
            ← zpow_natCast (a := ρ) (n := j.val)]
    _ = ρ ^ ((j.val : ℤ) - (i.val : ℤ)) := by
          rw [← zpow_add]
          exact congrArg (fun e : ℤ => ρ ^ e) (by ring)

-- (B) r-form times sr-form
private lemma map_mul_rs {D : Type u} [Group D] [Finite D] {ρ σ : D} {n : ℕ} (hn : orderOf ρ = n)
    (hσ2 : σ ^ 2 = 1) (hrel : σ * ρ * σ⁻¹ = ρ⁻¹) (i j : ZMod n) :
    ρ ^ i.val * (σ * ρ ^ j.val) = σ * ρ ^ (j - i).val := by
  calc
    ρ ^ i.val * (σ * ρ ^ j.val) = (ρ ^ i.val * σ) * ρ ^ j.val := by rw [mul_assoc]
    _ = (σ * ρ ^ (-(i.val : ℤ))) * ρ ^ j.val := by rw [zpow_mul_rel hσ2 hrel i.val]
    _ = σ * (ρ ^ (-(i.val : ℤ)) * ρ ^ j.val) := by rw [mul_assoc]
    _ = σ * ρ ^ ((j.val : ℤ) - (i.val : ℤ)) := by
          rw [← zpow_natCast (a := ρ) (n := j.val), ← zpow_add]
          exact congrArg (fun e : ℤ => σ * ρ ^ e) (by ring)
    _ = σ * ρ ^ (j - i).val := by rw [pow_val_sub_zpow hn i j]

-- (D) sr-form times sr-form
private lemma map_mul_ss {D : Type u} [Group D] [Finite D] {ρ σ : D} {n : ℕ} (hn : orderOf ρ = n)
    (hσ2 : σ ^ 2 = 1) (hrel : σ * ρ * σ⁻¹ = ρ⁻¹) (i j : ZMod n) :
    (σ * ρ ^ i.val) * (σ * ρ ^ j.val) = ρ ^ (j - i).val := by
  calc
    (σ * ρ ^ i.val) * (σ * ρ ^ j.val) = σ * (ρ ^ i.val * σ) * ρ ^ j.val := by group
    _ = σ * (σ * ρ ^ (-(i.val : ℤ))) * ρ ^ j.val := by rw [zpow_mul_rel hσ2 hrel i.val]
    _ = (σ * σ) * (ρ ^ (-(i.val : ℤ)) * ρ ^ j.val) := by group
    _ = ρ ^ (-(i.val : ℤ)) * ρ ^ j.val := by rw [← pow_two, hσ2, one_mul]
    _ = ρ ^ ((j.val : ℤ) - (i.val : ℤ)) := by
          rw [← zpow_natCast (a := ρ) (n := j.val), ← zpow_add]
          exact congrArg (fun e : ℤ => ρ ^ e) (by ring)
    _ = ρ ^ (j - i).val := by rw [pow_val_sub_zpow hn i j]

-- (C) sr-form times r-form
private lemma map_mul_sr {D : Type u} [Group D] [Finite D] {ρ σ : D} {n : ℕ} (hn : orderOf ρ = n)
    (i j : ZMod n) : σ * ρ ^ (i + j).val = (σ * ρ ^ i.val) * ρ ^ j.val := by
  calc
    σ * ρ ^ (i + j).val = σ * (ρ ^ i.val * ρ ^ j.val) := by rw [pow_val_add_eq hn i j]
    _ = (σ * ρ ^ i.val) * ρ ^ j.val := by rw [mul_assoc]

-- orderOf σ = 2 from σ² = 1 and σ ≠ 1
private lemma orderOf_eq_two_of_pow_two {D : Type u} [Group D] {σ : D}
    (hσ2 : σ ^ 2 = 1) (hne : σ ≠ 1) : orderOf σ = 2 := by
  have hdvd : orderOf σ ∣ 2 := (orderOf_dvd_iff_pow_eq_one).mpr hσ2
  have hne1 : orderOf σ ≠ 1 := by
    intro h1
    exact hne (orderOf_eq_one_iff.mp h1)
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
  · exact False.elim (hne1 h)
  · exact h

-- the universal hom
private def dihedralMap {D : Type u} [Group D] [Finite D] {ρ σ : D} {n : ℕ} (hn : orderOf ρ = n)
    (hσ2 : σ ^ 2 = 1) (hrel : σ * ρ * σ⁻¹ = ρ⁻¹) : DihedralGroup n →* D where
  toFun x := match x with
    | DihedralGroup.r i => ρ ^ i.val
    | DihedralGroup.sr i => σ * ρ ^ i.val
  map_one' := by
    rw [DihedralGroup.one_def]
    simp
  map_mul' := by
    intro x y
    match x with
    | DihedralGroup.r i =>
        match y with
        | DihedralGroup.r j => simpa [DihedralGroup.r_mul_r] using pow_val_add_eq hn i j
        | DihedralGroup.sr j => simpa [DihedralGroup.r_mul_sr] using (map_mul_rs hn hσ2 hrel i j).symm
    | DihedralGroup.sr i =>
        match y with
        | DihedralGroup.r j => simpa [DihedralGroup.sr_mul_r] using map_mul_sr hn i j
        | DihedralGroup.sr j => simpa [DihedralGroup.sr_mul_sr] using (map_mul_ss hn hσ2 hrel i j).symm

/-- Two generators satisfying the dihedral relations generate the expected
dihedral group when the reflection does not lie in the rotation subgroup. -/
public theorem dihedral_of_generators_of_not_mem
    {D : Type u} [Group D] [Finite D]
    (ρ σ : D) (hgen : ⊤ = Subgroup.zpowers ρ ⊔ Subgroup.zpowers σ)
    (hσ2 : σ ^ 2 = 1) (hrel : σ * ρ * σ⁻¹ = ρ⁻¹)
    (hσρ : σ ∉ Subgroup.zpowers ρ) :
    Nonempty (D ≃* DihedralGroup (orderOf ρ)) := by
  let : Fintype D := Fintype.ofFinite D
  let φ := dihedralMap (ρ := ρ) (σ := σ) (hn := rfl) hσ2 hrel
  have hord : orderOf σ = 2 := by
    exact orderOf_eq_two_of_pow_two hσ2 (by
      intro hσ1
      exact hσρ (hσ1 ▸ Subgroup.one_mem (Subgroup.zpowers ρ)))
  -- disjointness ⟨ρ⟩ ⊓ ⟨σ⟩ = ⊥
  have hdisj : Subgroup.zpowers ρ ⊓ Subgroup.zpowers σ = ⊥ := by
    refine le_antisymm ?_ bot_le
    intro x hx
    have hxσ : x ∈ Subgroup.zpowers σ := hx.2
    rcases (Subgroup.mem_zpowers_iff).mp hxσ with ⟨k, hk⟩
    have hk2 : σ ^ k = σ ^ (k % 2 : ℤ) := by
      rw [zpow_eq_zpow_iff_modEq, hord]
      exact (Int.mod_modEq k 2).symm
    rcases Int.emod_two_eq_zero_or_one k with hk0 | hk1
    · have hx1 : x = 1 := by
        rw [← hk, hk2, hk0, zpow_zero]
      exact hx1 ▸ Subgroup.one_mem ⊥
    · have hxσ' : x = σ := by
        rw [← hk, hk2, hk1, zpow_one]
      exact False.elim (hσρ (hxσ' ▸ hx.1))
  -- |⟨ρ⟩| = n, |⟨σ⟩| = 2
  have hnρ : Nat.card (↥(Subgroup.zpowers ρ)) = orderOf ρ := by
    rw [Nat.card_eq_fintype_card, Fintype.card_zpowers]
  have hnσ : Nat.card (↥(Subgroup.zpowers σ)) = orderOf σ := by
    rw [Nat.card_eq_fintype_card, Fintype.card_zpowers]
  -- injection ⟨ρ⟩ × ⟨σ⟩ → D
  let f : ↥(Subgroup.zpowers ρ) × ↥(Subgroup.zpowers σ) → D := fun p => p.1.1 * p.2.1
  have hinj : Function.Injective f := by
    intro a b h
    dsimp [f] at h
    have hx : b.1.1⁻¹ * a.1.1 = b.2.1 * a.2.1⁻¹ := by
      simpa [mul_assoc] using congrArg (fun z : D => b.1.1⁻¹ * z * a.2.1⁻¹) h
    have hxρ : b.1.1⁻¹ * a.1.1 ∈ Subgroup.zpowers ρ := by
      exact Subgroup.mul_mem (Subgroup.zpowers ρ)
        (Subgroup.inv_mem (Subgroup.zpowers ρ) b.1.prop) a.1.prop
    have hxσ : b.1.1⁻¹ * a.1.1 ∈ Subgroup.zpowers σ := by
      rw [hx]
      exact Subgroup.mul_mem (Subgroup.zpowers σ) b.2.prop
        (Subgroup.inv_mem (Subgroup.zpowers σ) a.2.prop)
    have hx1 : b.1.1⁻¹ * a.1.1 = 1 := by
      have hb : b.1.1⁻¹ * a.1.1 ∈ (⊥ : Subgroup D) := by
        rw [← hdisj]
        exact Subgroup.mem_inf.mpr ⟨hxρ, hxσ⟩
      exact Subgroup.mem_bot.mp hb
    have ha : (a.1 : D) = (b.1 : D) := by
      calc
        (a.1 : D) = b.1.1 * (b.1.1⁻¹ * a.1.1) := by group
        _ = b.1.1 := by rw [hx1, mul_one]
    have hb2 : (a.2.1 : D) = (b.2.1 : D) := by
      have hb' : b.2.1 * a.2.1⁻¹ = 1 := by rw [← hx, hx1]
      calc
        (a.2.1 : D) = 1 * a.2.1 := by rw [one_mul]
        _ = (b.2.1 * a.2.1⁻¹) * a.2.1 := by rw [← hb']
        _ = b.2.1 * (a.2.1⁻¹ * a.2.1) := by rw [mul_assoc]
        _ = b.2.1 := by rw [inv_mul_cancel, mul_one]
    exact Prod.ext (Subtype.ext ha) (Subtype.ext hb2)
  have hlow : Nat.card (↥(Subgroup.zpowers ρ) × ↥(Subgroup.zpowers σ)) ≤ Nat.card D :=
    Nat.card_le_card_of_injective f hinj
  have hlow' : orderOf ρ * orderOf σ ≤ Nat.card D := by
    rw [← hnρ, ← hnσ, ← Nat.card_prod]
    exact hlow
  -- surjectivity of φ
  have hρ_range : ρ ∈ φ.range := by
    refine ⟨DihedralGroup.r 1, ?_⟩
    dsimp [φ, dihedralMap]
    rw [show ZMod.val (1 : ZMod (orderOf ρ)) = 1 % orderOf ρ by
      simpa using (ZMod.val_natCast (n := orderOf ρ) (a := 1))]
    by_cases hn : orderOf ρ = 1
    · rw [hn]
      simp [orderOf_eq_one_iff.mp hn]
    · have hpos : 0 < orderOf ρ := orderOf_pos ρ
      have hnlt : 1 < orderOf ρ := by omega
      rw [Nat.mod_eq_of_lt hnlt, pow_one]
  have hσ_range : σ ∈ φ.range := by
    refine ⟨DihedralGroup.sr 0, ?_⟩
    dsimp [φ, dihedralMap]
    rw [show ZMod.val (0 : ZMod (orderOf ρ)) = 0 % orderOf ρ by
      simpa using (ZMod.val_natCast (n := orderOf ρ) (a := 0))]
    simp
  have hle : ⊤ ≤ φ.range := by
    rw [hgen]
    exact sup_le ((Subgroup.zpowers_le).mpr hρ_range) ((Subgroup.zpowers_le).mpr hσ_range)
  have hsurj : Function.Surjective φ := by
    intro x
    rcases hle (by trivial : x ∈ (⊤ : Subgroup D)) with ⟨y, hy⟩
    exact ⟨y, hy⟩
  let : NeZero (orderOf ρ) := ⟨(orderOf_pos ρ).ne'⟩
  have hup : Nat.card D ≤ Nat.card (DihedralGroup (orderOf ρ)) :=
    Nat.card_le_card_of_surjective (fun x => φ x) hsurj
  have hcard2 : Nat.card D = 2 * orderOf ρ := by
    have hlow2 : orderOf ρ * 2 ≤ Nat.card D := by simpa [hord] using hlow'
    have hup2 : Nat.card D ≤ orderOf ρ * 2 := by
      calc
        Nat.card D ≤ Nat.card (DihedralGroup (orderOf ρ)) := hup
        _ = 2 * orderOf ρ := DihedralGroup.nat_card
        _ = orderOf ρ * 2 := by rw [mul_comm]
    omega
  have hcard : Fintype.card (DihedralGroup (orderOf ρ)) = Fintype.card D := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, DihedralGroup.nat_card]
    exact hcard2.symm
  let ψ : DihedralGroup (orderOf ρ) → D := fun x => φ x
  have hsurjψ : Function.Surjective ψ := by simpa [ψ] using hsurj
  have hbij : Function.Bijective ψ :=
    (Fintype.bijective_iff_surjective_and_card ψ).mpr ⟨hsurjψ, hcard⟩
  exact ⟨(MulEquiv.ofBijective φ (by simpa [ψ] using hbij)).symm⟩


/-- Two generators with the dihedral relations generate a cyclic group or the
dihedral group of order `2 * orderOf ρ`. -/
public theorem isCyclic_or_dihedral_of_generators {D : Type u} [Group D] [Finite D]
    (ρ σ : D) (hgen : ⊤ = Subgroup.zpowers ρ ⊔ Subgroup.zpowers σ)
    (hσ2 : σ ^ 2 = 1) (hrel : σ * ρ * σ⁻¹ = ρ⁻¹) :
    IsCyclic D ∨ Nonempty (D ≃* DihedralGroup (orderOf ρ)) := by
  by_cases hσρ : σ ∈ Subgroup.zpowers ρ
  · left
    have hσle : Subgroup.zpowers σ ≤ Subgroup.zpowers ρ := (Subgroup.zpowers_le).mpr hσρ
    have htop : Subgroup.zpowers ρ = ⊤ := by
      rw [hgen]
      exact (sup_eq_left.mpr hσle).symm
    exact isCyclic_iff_exists_zpowers_eq_top.mpr ⟨ρ, htop⟩
  · right
    exact dihedral_of_generators_of_not_mem ρ σ hgen hσ2 hrel hσρ

end CFSG.GorensteinWalter
