/-!
# Structure facts for `A₇`

This module formalizes Fact 1.8(i)--(iii) of Bender's dihedral-Sylow paper
for the concrete group `alternatingGroup (Fin 7)`, together with the bound
that every `2'`-subgroup of `A₇` has order at most `21`.

The concrete Sylow `2`-subgroup is generated by the order-four element
`a7v` and the reflection `a7s`, so its centre is the double transposition
`a7t`.  The normal subgroup `U` of order three is generated by the 3-cycle
`a7a`, and `V = O₂(C_G(Z(S)))` is the Klein four subgroup generated by
`a7t` and `a7u`.
-/

noncomputable section

namespace CFSG.GorensteinWalter

public abbrev A7 := alternatingGroup (Fin 7)

/-- The reflection `(0 1)(4 5)` used with `a7v` to generate a concrete
dihedral Sylow `2`-subgroup. -/
@[expose] public def a7s : A7 :=
  ⟨Equiv.swap (0 : Fin 7) 1 * Equiv.swap 4 5, by
    simp [Equiv.Perm.sign_mul]⟩

private theorem a7t_involution : IsInvolution a7t := by
  unfold IsInvolution
  constructor <;> decide

private theorem a7s_involution : IsInvolution a7s := by
  unfold IsInvolution
  constructor <;> decide

private theorem a7v_order : orderOf a7v = 4 := by
  apply (orderOf_eq_iff (n := 4) (by norm_num)).mpr
  constructor
  · decide
  · intro m hm0 hm4
    interval_cases m <;> decide

private theorem a7a_order : orderOf a7a = 3 := by
  apply (orderOf_eq_iff (n := 3) (by norm_num)).mpr
  constructor
  · decide
  · intro m hm0 hm3
    interval_cases m <;> decide

private theorem a7v_sq_eq_t : a7v ^ 2 = a7t := by
  decide

private theorem a7s_inverts_generator :
    a7s * a7a * a7s⁻¹ = a7a⁻¹ := by
  decide

private theorem a7v_inverts_generator :
    a7v * a7a * a7v⁻¹ = a7a⁻¹ := by
  decide

/-- The concrete Sylow `2`-subgroup of `A₇`, written with an explicit
carrier so that membership computations are decidable. -/
@[expose] public def a7S : Subgroup A7 where
  carrier := {x : A7 |
    x = 1 ∨ x = a7v ∨ x = a7v ^ 2 ∨ x = a7v ^ 3 ∨
      x = a7s ∨ x = a7s * a7v ∨ x = a7s * a7v ^ 2 ∨
        x = a7s * a7v ^ 3}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases hy with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        decide
  inv_mem' := by
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      decide

instance : DecidablePred (fun x : A7 => x ∈ (a7S : Set A7)) := fun x => by
  change Decidable
    (x = 1 ∨ x = a7v ∨ x = a7v ^ 2 ∨ x = a7v ^ 3 ∨
      x = a7s ∨ x = a7s * a7v ∨ x = a7s * a7v ^ 2 ∨
        x = a7s * a7v ^ 3)
  infer_instance

/-- The explicit eight elements of `a7S`. -/
private def a7SList : List A7 :=
  [1, a7v, a7v ^ 2, a7v ^ 3, a7s, a7s * a7v, a7s * a7v ^ 2,
    a7s * a7v ^ 3]

private theorem a7S_mem_iff (x : A7) :
    x ∈ (a7S : Set A7) ↔ x ∈ a7SList.toFinset := by
  simp [a7S, a7SList]

private theorem a7SList_card : a7SList.toFinset.card = 8 := by
  decide

private theorem card_aSeven : Nat.card A7 = 2520 := by
  rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card]
  decide

private theorem factorization_two_2520 :
    (2520 : ℕ).factorization 2 = 3 := by
  rw [show 2520 = 2 ^ 3 * 315 by norm_num]
  rw [Nat.factorization_mul (by norm_num) (by norm_num)]
  rw [Nat.factorization_pow]
  simp [Nat.prime_two.factorization_self,
    Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 315)]

private theorem a7S_card : Nat.card a7S = 8 := by
  let : Fintype a7S := Subtype.fintype (fun x : A7 => x ∈ (a7S : Set A7))
  rw [Nat.card_eq_fintype_card]
  have h : Fintype.card a7S =
      Fintype.card {x : A7 // x ∈ a7SList.toFinset} := by
    refine Fintype.card_congr ?_
    refine Equiv.ofBijective (fun x : a7S => ⟨(x : A7), (a7S_mem_iff x.1).1 x.2⟩) ?_
    constructor
    · intro x y h
      apply Subtype.ext
      exact congrArg (fun z : {x : A7 // x ∈ a7SList.toFinset} => (z : A7)) h
    · intro y
      refine ⟨⟨y.1, (a7S_mem_iff y.1).2 y.2⟩, ?_⟩
      apply Subtype.ext
      rfl
  rw [h]
  change a7SList.toFinset.card = 8
  exact a7SList_card

private theorem a7S_mem_v : (a7v : A7) ∈ (a7S : Set A7) := by
  rw [a7S_mem_iff]
  simp [a7SList]

private theorem a7S_mem_s : a7s ∈ (a7S : Set A7) := by
  rw [a7S_mem_iff]
  simp [a7SList]

/-- The subgroup generated by `a7v` and `a7s`, equal to the explicit
carrier `a7S`. -/
private def a7GenSubgroup : Subgroup A7 :=
  Subgroup.zpowers (a7v : A7) ⊔ Subgroup.zpowers a7s

private theorem a7S_eq_gen : a7S = a7GenSubgroup := by
  apply le_antisymm
  · intro x hx
    change x ∈ (a7S : Set A7) at hx
    rw [a7S_mem_iff] at hx
    simp [a7SList] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact Subgroup.one_mem a7GenSubgroup
    · exact Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7))
    · exact Subgroup.pow_mem a7GenSubgroup
        (Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7))) 2
    · exact Subgroup.pow_mem a7GenSubgroup
        (Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7))) 3
    · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s)
    · exact a7GenSubgroup.mul_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s))
        (Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7)))
    · exact a7GenSubgroup.mul_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s))
        (Subgroup.pow_mem a7GenSubgroup
          (Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7))) 2)
    · exact a7GenSubgroup.mul_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s))
        (Subgroup.pow_mem a7GenSubgroup
          (Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7))) 3)
  · refine sup_le ?_ ?_
    · rw [Subgroup.zpowers_le]
      exact a7S_mem_v
    · rw [Subgroup.zpowers_le]
      exact a7S_mem_s

private lemma a7Gen_is_dihedral4 :
    Nonempty (a7GenSubgroup ≃* DihedralGroup 4) := by
  let ρ' : a7GenSubgroup := ⟨a7v, by
    exact Subgroup.mem_sup_left (Subgroup.mem_zpowers (a7v : A7))⟩
  let σ' : a7GenSubgroup := ⟨a7s, by
    exact Subgroup.mem_sup_right (Subgroup.mem_zpowers a7s)⟩
  have hgen : ⊤ = Subgroup.zpowers ρ' ⊔ Subgroup.zpowers σ' := by
    have hmap : Subgroup.map a7GenSubgroup.subtype ⊤ =
        Subgroup.map a7GenSubgroup.subtype
          (Subgroup.zpowers ρ' ⊔ Subgroup.zpowers σ') := by
      rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
      rw [Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
      dsimp [ρ', σ']
      rfl
    exact (Subgroup.map_injective (f := a7GenSubgroup.subtype)
      Subtype.coe_injective) hmap
  have hσ2 : σ' ^ 2 = 1 := by
    apply Subtype.ext
    simpa [σ', pow_two, Subgroup.coe_mul] using a7s_involution.2
  have hrel : σ' * ρ' * σ'⁻¹ = ρ'⁻¹ := by
    apply Subtype.ext
    dsimp [σ', ρ']
    change (a7s : A7) * (a7v : A7) * (a7s : A7)⁻¹ =
      (a7v : A7)⁻¹
    decide
  rcases (isCyclic_or_dihedral_of_generators ρ' σ' hgen hσ2 hrel) with hcyc | hdih
  · have : IsCyclic a7GenSubgroup := hcyc
    have hcomm : ρ' * σ' = σ' * ρ' :=
      IsMulCommutative.is_comm.comm ρ' σ'
    have hc : ((ρ' * σ' : a7GenSubgroup) : A7) =
        ((σ' * ρ' : a7GenSubgroup) : A7) :=
      congrArg (fun x : a7GenSubgroup => (x : A7)) hcomm
    have hdiff : a7v * a7s ≠ a7s * a7v := by decide
    have hamb : a7v * a7s = a7s * a7v := by
      simpa [ρ', σ', Subgroup.coe_mul] using hc
    exact False.elim (hdiff hamb)
  · rcases hdih with ⟨e⟩
    have hord : orderOf ρ' = 4 := by
      rw [← Subgroup.orderOf_coe ρ']
      dsimp [ρ']
      exact a7v_order
    rw [hord] at e
    exact ⟨e⟩

private theorem a7S_is_dihedral4 : Nonempty (a7S ≃* DihedralGroup 4) := by
  have e : a7S ≃* a7GenSubgroup :=
    MulEquiv.subgroupCongr a7S_eq_gen
  exact ⟨e.trans a7Gen_is_dihedral4.some⟩

/-- A concrete Sylow `2`-subgroup of `A₇`. -/
public def a7Sylow : Sylow 2 A7 := by
  refine Sylow.ofCard a7S ?_
  rw [a7S_card, card_aSeven]
  rw [factorization_two_2520]
  norm_num

/-- The order-three subgroup `U = ⟨a7a⟩` used in Fact 1.8(ii). -/
@[expose] public def a7U : Subgroup A7 where
  carrier := {x : A7 | x = 1 ∨ x = a7a ∨ x = a7a ^ 2}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl <;> decide
  inv_mem' := by
    intro x hx
    rcases hx with rfl | rfl | rfl <;> decide

instance : DecidablePred (fun x : A7 => x ∈ (a7U : Set A7)) := fun x => by
  change Decidable (x = 1 ∨ x = a7a ∨ x = a7a ^ 2)
  infer_instance

private def a7UList : List A7 := [1, a7a, a7a ^ 2]

private theorem a7U_mem_iff (x : A7) :
    x ∈ (a7U : Set A7) ↔ x ∈ a7UList.toFinset := by
  simp [a7U, a7UList]

private theorem a7UList_card : a7UList.toFinset.card = 3 := by
  decide

private theorem a7U_card : Nat.card a7U = 3 := by
  let : Fintype a7U := Subtype.fintype (fun x : A7 => x ∈ (a7U : Set A7))
  rw [Nat.card_eq_fintype_card]
  have h : Fintype.card a7U =
      Fintype.card {x : A7 // x ∈ a7UList.toFinset} := by
    refine Fintype.card_congr ?_
    refine Equiv.ofBijective (fun x : a7U => ⟨(x : A7), (a7U_mem_iff x.1).1 x.2⟩) ?_
    constructor
    · intro x y h
      apply Subtype.ext
      exact congrArg (fun z : {x : A7 // x ∈ a7UList.toFinset} => (z : A7)) h
    · intro y
      refine ⟨⟨y.1, (a7U_mem_iff y.1).2 y.2⟩, ?_⟩
      apply Subtype.ext
      rfl
  rw [h]
  change a7UList.toFinset.card = 3
  exact a7UList_card

/-- The Klein four subgroup `V = ⟨a7t, a7u⟩` used in Fact 1.8(ii)--(iii). -/
@[expose] public def a7V : Subgroup A7 where
  carrier := {x : A7 |
    x = 1 ∨ x = a7t ∨ x = a7u ∨ x = a7t * a7u}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    rcases hx with rfl | rfl | rfl | rfl <;>
      rcases hy with rfl | rfl | rfl | rfl <;> decide
  inv_mem' := by
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl <;> decide

instance : DecidablePred (fun x : A7 => x ∈ (a7V : Set A7)) := fun x => by
  change Decidable (x = 1 ∨ x = a7t ∨ x = a7u ∨ x = a7t * a7u)
  infer_instance

instance : DecidablePred (fun x : A7 => x ∈ a7V) := fun x => by
  change Decidable (x ∈ (a7V : Set A7))
  infer_instance

private def a7VList : List A7 := [1, a7t, a7u, a7t * a7u]

private theorem a7V_mem_iff (x : A7) :
    x ∈ (a7V : Set A7) ↔ x ∈ a7VList.toFinset := by
  simp [a7V, a7VList]

private theorem a7VList_card : a7VList.toFinset.card = 4 := by
  decide

private theorem a7V_card : Nat.card a7V = 4 := by
  let : Fintype a7V := Subtype.fintype (fun x : A7 => x ∈ (a7V : Set A7))
  rw [Nat.card_eq_fintype_card]
  have h : Fintype.card a7V =
      Fintype.card {x : A7 // x ∈ a7VList.toFinset} := by
    refine Fintype.card_congr ?_
    refine Equiv.ofBijective (fun x : a7V => ⟨(x : A7), (a7V_mem_iff x.1).1 x.2⟩) ?_
    constructor
    · intro x y h
      apply Subtype.ext
      exact congrArg (fun z : {x : A7 // x ∈ a7VList.toFinset} => (z : A7)) h
    · intro y
      refine ⟨⟨y.1, (a7V_mem_iff y.1).2 y.2⟩, ?_⟩
      apply Subtype.ext
      rfl
  rw [h]
  change a7VList.toFinset.card = 4
  exact a7VList_card

private theorem a7V_isKleinFour : IsKleinFour a7V := by
  refine ⟨?_, ?_⟩
  · exact a7V_card
  · apply Nat.dvd_antisymm
    · rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
      intro x
      let hx := x.2
      change x.1 = 1 ∨ x.1 = a7t ∨ x.1 = a7u ∨ x.1 = a7t * a7u at hx
      rcases hx with hx1 | hxt | hxu | hxtu
      · apply Subtype.ext
        simpa [hx1] using (by decide : (1 : A7) ^ 2 = 1)
      · apply Subtype.ext
        simpa [hxt] using (by decide : (a7t : A7) ^ 2 = 1)
      · apply Subtype.ext
        simpa [hxu] using (by decide : (a7u : A7) ^ 2 = 1)
      · apply Subtype.ext
        simpa [hxtu] using (by decide : (a7t * a7u : A7) ^ 2 = 1)
    · have hord : orderOf (⟨a7t, by
          change a7t ∈ (a7V : Set A7)
          rw [a7V_mem_iff]
          simp [a7VList]⟩ : a7V) = 2 := by
        apply orderOf_eq_prime
        · apply Subtype.ext
          change (a7t : A7) ^ 2 = 1
          exact a7t_involution.2
        · intro h
          apply a7t_involution.1
          exact congrArg Subtype.val h
      rw [← hord]
      let tV : a7V := ⟨a7t, by
        change a7t ∈ (a7V : Set A7)
        rw [a7V_mem_iff]
        simp [a7VList]⟩
      exact Monoid.order_dvd_exponent tV

/-- The subgroup `U S = C_G(Z(S))` from Fact 1.8(ii). -/
public def a7US : Subgroup A7 := a7U ⊔ a7S

private theorem a7U_le_centralizer_t :
    a7U ≤ Subgroup.centralizer ({a7t} : Set A7) := by
  intro x hx
  change x ∈ (a7U : Set A7) at hx
  rw [a7U_mem_iff] at hx
  simp [a7UList] at hx
  rcases hx with rfl | rfl | rfl
  · rw [Subgroup.mem_centralizer_singleton_iff]
    simp
  · rw [Subgroup.mem_centralizer_singleton_iff]
    decide
  · rw [Subgroup.mem_centralizer_singleton_iff]
    decide

private theorem a7S_le_centralizer_t :
    a7S ≤ Subgroup.centralizer ({a7t} : Set A7) := by
  intro x hx
  change x ∈ (a7S : Set A7) at hx
  rw [a7S_mem_iff] at hx
  simp [a7SList] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals rw [Subgroup.mem_centralizer_singleton_iff] <;> decide

private theorem a7US_le_centralizer_t :
    a7US ≤ Subgroup.centralizer ({a7t} : Set A7) := by
  dsimp [a7US]
  exact sup_le a7U_le_centralizer_t a7S_le_centralizer_t

private theorem a7v_normalizes_U :
    (a7v : A7) ∈ Subgroup.normalizer (a7U : Set A7) := by
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    have hy' : y = 1 ∨ y = a7a ∨ y = a7a ^ 2 := by
      change y ∈ (a7U : Set A7) at hy
      rw [a7U_mem_iff] at hy
      simpa [a7UList] using hy
    rcases hy' with rfl | rfl | rfl
    · change ((a7v : A7) * 1 * (a7v : A7)⁻¹) ∈ (a7U : Set A7)
      decide
    · change ((a7v : A7) * a7a * (a7v : A7)⁻¹) ∈ (a7U : Set A7)
      decide
    · change ((a7v : A7) * a7a ^ 2 * (a7v : A7)⁻¹) ∈ (a7U : Set A7)
      decide
  · intro hy
    have hy' : (a7v : A7) * y * (a7v : A7)⁻¹ = 1 ∨
        (a7v : A7) * y * (a7v : A7)⁻¹ = a7a ∨
          (a7v : A7) * y * (a7v : A7)⁻¹ = a7a ^ 2 := by
      change ((a7v : A7) * y * (a7v : A7)⁻¹) ∈ (a7U : Set A7) at hy
      rw [a7U_mem_iff] at hy
      simpa [a7UList] using hy
    rcases hy' with h1 | ha | ha2
    · change y ∈ (a7U : Set A7)
      have hy1 : y = 1 := by
        calc
          y = (a7v : A7)⁻¹ * ((a7v : A7) * y * (a7v : A7)⁻¹) * (a7v : A7) := by group
          _ = (a7v : A7)⁻¹ * 1 * (a7v : A7) := by rw [h1]
          _ = 1 := by simp
      rw [hy1]
      decide
    · change y ∈ (a7U : Set A7)
      have hya : y = a7a ^ 2 := by
        calc
          y = (a7v : A7)⁻¹ * ((a7v : A7) * y * (a7v : A7)⁻¹) * (a7v : A7) := by group
          _ = (a7v : A7)⁻¹ * a7a * (a7v : A7) := by rw [ha]
          _ = a7a ^ 2 := by decide
      rw [hya]
      decide
    · change y ∈ (a7U : Set A7)
      have hya : y = a7a := by
        calc
          y = (a7v : A7)⁻¹ * ((a7v : A7) * y * (a7v : A7)⁻¹) * (a7v : A7) := by group
          _ = (a7v : A7)⁻¹ * a7a ^ 2 * (a7v : A7) := by rw [ha2]
          _ = a7a := by decide
      rw [hya]
      decide

private theorem a7s_normalizes_U :
    a7s ∈ Subgroup.normalizer (a7U : Set A7) := by
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    have hy' : y = 1 ∨ y = a7a ∨ y = a7a ^ 2 := by
      change y ∈ (a7U : Set A7) at hy
      rw [a7U_mem_iff] at hy
      simpa [a7UList] using hy
    rcases hy' with rfl | rfl | rfl
    · change (a7s * 1 * a7s⁻¹) ∈ (a7U : Set A7)
      decide
    · change (a7s * a7a * a7s⁻¹) ∈ (a7U : Set A7)
      decide
    · change (a7s * a7a ^ 2 * a7s⁻¹) ∈ (a7U : Set A7)
      decide
  · intro hy
    have hy' : a7s * y * a7s⁻¹ = 1 ∨ a7s * y * a7s⁻¹ = a7a ∨
        a7s * y * a7s⁻¹ = a7a ^ 2 := by
      change (a7s * y * a7s⁻¹) ∈ (a7U : Set A7) at hy
      rw [a7U_mem_iff] at hy
      simpa [a7UList] using hy
    rcases hy' with h1 | ha | ha2
    · change y ∈ (a7U : Set A7)
      have hy1 : y = 1 := by
        calc
          y = a7s⁻¹ * (a7s * y * a7s⁻¹) * a7s := by group
          _ = a7s⁻¹ * 1 * a7s := by rw [h1]
          _ = 1 := by simp
      rw [hy1]
      decide
    · change y ∈ (a7U : Set A7)
      have hya : y = a7a ^ 2 := by
        calc
          y = a7s⁻¹ * (a7s * y * a7s⁻¹) * a7s := by group
          _ = a7s⁻¹ * a7a * a7s := by rw [ha]
          _ = a7a ^ 2 := by decide
      rw [hya]
      decide
    · change y ∈ (a7U : Set A7)
      have hya : y = a7a := by
        calc
          y = a7s⁻¹ * (a7s * y * a7s⁻¹) * a7s := by group
          _ = a7s⁻¹ * a7a ^ 2 * a7s := by rw [ha2]
          _ = a7a := by decide
      rw [hya]
      decide

private theorem a7S_le_normalizer_U :
    a7S ≤ Subgroup.normalizer (a7U : Set A7) := by
  intro x hx
  change x ∈ (a7S : Set A7) at hx
  rw [a7S_mem_iff] at hx
  simp [a7SList] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Subgroup.one_mem (Subgroup.normalizer (a7U : Set A7))
  · exact a7v_normalizes_U
  · exact Subgroup.pow_mem (Subgroup.normalizer (a7U : Set A7))
      a7v_normalizes_U 2
  · exact Subgroup.pow_mem (Subgroup.normalizer (a7U : Set A7))
      a7v_normalizes_U 3
  · exact a7s_normalizes_U
  · exact Subgroup.mul_mem (Subgroup.normalizer (a7U : Set A7))
      a7s_normalizes_U a7v_normalizes_U
  · exact Subgroup.mul_mem (Subgroup.normalizer (a7U : Set A7))
      a7s_normalizes_U (Subgroup.pow_mem (Subgroup.normalizer (a7U : Set A7))
        a7v_normalizes_U 2)
  · exact Subgroup.mul_mem (Subgroup.normalizer (a7U : Set A7))
      a7s_normalizes_U (Subgroup.pow_mem (Subgroup.normalizer (a7U : Set A7))
        a7v_normalizes_U 3)

private theorem a7U_disjoint_a7S : Disjoint a7U a7S := by
  rw [disjoint_iff_inf_le]
  intro x hx
  rw [Subgroup.mem_bot]
  have hxU : x ∈ (a7U : Set A7) := hx.1
  have hxS : x ∈ (a7S : Set A7) := hx.2
  have hxU' : x = 1 ∨ x = a7a ∨ x = a7a ^ 2 := by
    simpa [a7UList] using (a7U_mem_iff x).1 hxU
  rcases hxU' with hx1 | hxa | hxa2
  · exact hx1
  · exfalso
    have hnot : a7a ∉ (a7S : Set A7) := by
      rw [a7S_mem_iff]
      decide
    exact hnot (by simpa [hxa] using hxS)
  · exfalso
    have hnot : a7a ^ 2 ∉ (a7S : Set A7) := by
      rw [a7S_mem_iff]
      decide
    exact hnot (by simpa [hxa2] using hxS)

private theorem card_sup_eq_mul_of_disjoint_of_le_normalizer
    {G : Type*} [Group G] (A B : Subgroup G)
    (hnormal : B ≤ Subgroup.normalizer (A : Set G))
    (hdisjoint : Disjoint A B) :
    Nat.card (A ⊔ B : Subgroup G) = Nat.card A * Nat.card B := by
  let toSup : A × B → ↥(A ⊔ B) := fun z =>
    ⟨(z.1 : G) * (z.2 : G), Subgroup.mul_mem_sup z.1.2 z.2.2⟩
  have hinjective : Function.Injective toSup := by
    intro x y hxy
    apply Subgroup.mul_injective_of_disjoint hdisjoint
    exact congrArg Subtype.val hxy
  have hsurjective : Function.Surjective toSup := by
    intro z
    have hz : (z : G) ∈ (A : Set G) * (B : Set G) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left A B hnormal]
      exact z.2
    rcases hz with ⟨a, ha, b, hb, hab⟩
    exact ⟨(⟨a, ha⟩, ⟨b, hb⟩), Subtype.ext hab⟩
  calc
    Nat.card (A ⊔ B : Subgroup G) = Nat.card (A × B) :=
      Nat.card_congr (Equiv.ofBijective toSup ⟨hinjective, hsurjective⟩).symm
    _ = Nat.card A * Nat.card B := Nat.card_prod A B

private theorem a7US_card : Nat.card a7US = 24 := by
  change Nat.card (a7U ⊔ a7S : Subgroup A7) = 24
  rw [card_sup_eq_mul_of_disjoint_of_le_normalizer a7U a7S
    a7S_le_normalizer_U a7U_disjoint_a7S, a7U_card, a7S_card]

/-- The centre of the concrete Sylow subgroup, written as an explicit
two-element subgroup. -/
private def a7Center : Subgroup A7 where
  carrier := {x : A7 | x = 1 ∨ x = a7t}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> decide
  inv_mem' := by
    intro x hx
    rcases hx with rfl | rfl <;> decide

instance : DecidablePred (fun x : A7 => x ∈ (a7Center : Set A7)) := fun x => by
  change Decidable (x = 1 ∨ x = a7t)
  infer_instance

private theorem a7Center_mem_iff (x : A7) :
    x ∈ (a7Center : Set A7) ↔ x = 1 ∨ x = a7t := by
  rfl

private theorem a7S_mem_t : (a7t : A7) ∈ (a7S : Set A7) := by
  rw [a7S_mem_iff]
  rw [← a7v_sq_eq_t]
  simp [a7SList]

private theorem a7Center_eq_centerIn :
    a7Center = centerIn (G := A7) (a7S : Subgroup A7) := by
  ext x
  constructor
  · intro hx
    rcases hx with rfl | rfl
    · constructor
      · exact Subgroup.one_mem a7S
      · change 1 ∈ Subgroup.centralizer ((a7S : Set A7))
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        simp
    · constructor
      · exact a7S_mem_t
      · change a7t ∈ Subgroup.centralizer ((a7S : Set A7))
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        change y ∈ (a7S : Set A7) at hy
        rw [a7S_mem_iff] at hy
        simp [a7SList] at hy
        rcases hy with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide
  · intro hx
    have hxS : x ∈ (a7S : Set A7) := hx.1
    rw [a7S_mem_iff] at hxS
    simp [a7SList] at hxS
    rcases hxS with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · left; rfl
    · right
      -- a7v is not central in the dihedral group: it fails to commute with a7s
      exfalso
      have h := (Subgroup.mem_centralizer_iff.mp hx.2) a7s (a7S_mem_s)
      have hbad : a7v * a7s ≠ a7s * a7v := by decide
      exact hbad h.symm
    · right
      -- a7v² = a7t
      exact a7v_sq_eq_t
    · exfalso
      have h := (Subgroup.mem_centralizer_iff.mp hx.2) a7s (a7S_mem_s)
      have hbad : a7v ^ 3 * a7s ≠ a7s * a7v ^ 3 := by decide
      exact hbad h.symm
    · exfalso
      have h := (Subgroup.mem_centralizer_iff.mp hx.2) (a7v : A7) (a7S_mem_v)
      have hbad : a7s * a7v ≠ a7v * a7s := by decide
      exact hbad h.symm
    · exfalso
      have h := (Subgroup.mem_centralizer_iff.mp hx.2) (a7v : A7) (a7S_mem_v)
      have hbad : (a7s * a7v) * a7v ≠ a7v * (a7s * a7v) := by decide
      exact hbad h.symm
    · exfalso
      have h := (Subgroup.mem_centralizer_iff.mp hx.2) (a7v : A7) (a7S_mem_v)
      have hbad : (a7s * a7v ^ 2) * a7v ≠ a7v * (a7s * a7v ^ 2) := by decide
      exact hbad h.symm
    · exfalso
      have h := (Subgroup.mem_centralizer_iff.mp hx.2) (a7v : A7) (a7S_mem_v)
      have hbad : (a7s * a7v ^ 3) * a7v ≠ a7v * (a7s * a7v ^ 3) := by decide
      exact hbad h.symm

private theorem centralizer_center_eq_centralizer_t :
    Subgroup.centralizer ((centerIn (G := A7) (a7S : Subgroup A7)) : Set A7) =
      Subgroup.centralizer ({a7t} : Set A7) := by
  rw [← a7Center_eq_centerIn]
  ext x
  constructor
  · intro hx
    have hx' := (Subgroup.mem_centralizer_iff.mp hx) a7t
    have ht : a7t ∈ (a7Center : Set A7) := by
      rw [a7Center_mem_iff]
      right
      rfl
    have hcomm : a7t * x = x * a7t := hx' ht
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hcomm.symm
  · intro hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    change y ∈ (a7Center : Set A7) at hy
    rw [a7Center_mem_iff] at hy
    rcases hy with rfl | rfl
    · simp
    · exact (Subgroup.mem_centralizer_singleton_iff.mp hx).symm

private theorem a7t_perm_cycleType :
    (a7t : Equiv.Perm (Fin 7)).cycleType = {2, 2} := by
  decide +kernel

private theorem a7t_perm_centralizer_card :
    Nat.card (Subgroup.centralizer
      ({(a7t : Equiv.Perm (Fin 7))} : Set (Equiv.Perm (Fin 7)))) = 48 := by
  rw [Equiv.Perm.nat_card_centralizer, a7t_perm_cycleType]
  norm_num

private theorem a7t_centralizer_card :
    Nat.card (Subgroup.centralizer ({a7t} : Set GorensteinWalter.ASevenCertificateGroup)) = 24 := by
  let C : Subgroup (Equiv.Perm (Fin 7)) :=
    Subgroup.centralizer ({(a7t : Equiv.Perm (Fin 7))} : Set (Equiv.Perm (Fin 7)))
  let A : Subgroup (Equiv.Perm (Fin 7)) := alternatingGroup (Fin 7)
  have hAindex : A.index = 2 := alternatingGroup.index_eq_two
  have hcC : (Equiv.swap (4 : Fin 7) 5) ∈ C := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have hyP : y = (a7t : Equiv.Perm (Fin 7)) := by simpa using hy
    subst y
    decide +kernel
  have hcA : (Equiv.swap (4 : Fin 7) 5) ∉ A := by
    intro h
    change Equiv.Perm.sign (Equiv.swap (4 : Fin 7) 5) = 1 at h
    norm_num [Equiv.Perm.sign_swap] at h
    all_goals exact (by decide : (4 : Fin 7) ≠ 5) h
  let D : Subgroup (Equiv.Perm (Fin 7)) := Lattice.inf C A
  have hrel : D.relIndex C = 2 := by
    rw [Subgroup.relIndex_eq_two_iff]
    refine ⟨Equiv.swap (4 : Fin 7) 5, hcC, ?_⟩
    intro b hbC
    have hbcC : b * Equiv.swap (4 : Fin 7) 5 ∈ C := C.mul_mem hbC hcC
    by_cases hbA : b ∈ A
    · right
      constructor
      · exact Subgroup.mem_inf.mpr ⟨hbC, hbA⟩
      · intro hbc
        have hbcA : b * Equiv.swap (4 : Fin 7) 5 ∈ A :=
          (Subgroup.mem_inf.mp hbc).2
        have hiff : b * Equiv.swap (4 : Fin 7) 5 ∈ A ↔
            (b ∈ A ↔ Equiv.swap (4 : Fin 7) 5 ∈ A) :=
          Subgroup.mul_mem_iff_of_index_two hAindex
        have hbnot : ¬ b ∈ A := by
          intro hbA'
          exact hcA ((hiff.mp hbcA).1 hbA')
        exact hbnot hbA
    · left
      constructor
      · exact Subgroup.mem_inf.mpr ⟨hbcC, by
          exact (Subgroup.mul_mem_iff_of_index_two hAindex).2
            (iff_of_false hbA hcA)⟩
      · intro hbD
        exact hbA ((Subgroup.mem_inf.mp hbD).2)
  have hrel' : (D.subgroupOf C).index = 2 := hrel
  have hperm : Nat.card C = 48 := a7t_perm_centralizer_card
  have hDleC : D ≤ C := inf_le_left
  have hcardSub : Nat.card (D.subgroupOf C) = Nat.card D :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDleC).toEquiv
  have hcardC : Nat.card D * 2 = Nat.card C := by
    have h := Subgroup.card_mul_index (D.subgroupOf C)
    rw [hcardSub, hrel'] at h
    exact h
  have hcard24 : Nat.card D = 24 := by omega
  have hmap : (Subgroup.centralizer ({a7t} : Set GorensteinWalter.ASevenCertificateGroup)).map GorensteinWalter.ASevenCertificateGroup.subtype = D := by
    ext p
    constructor
    · rintro ⟨x, hxC, rfl⟩
      constructor
      · change (x : Equiv.Perm (Fin 7)) ∈ C
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        have hyP : y = (a7t : Equiv.Perm (Fin 7)) := by simpa using hy
        subst y
        have hcomm := (Subgroup.mem_centralizer_iff.mp hxC) a7t (by simp)
        exact congrArg Subtype.val hcomm
      · exact x.2
    · rintro ⟨hpC, hpA⟩
      refine ⟨⟨p, hpA⟩, ?_, rfl⟩
      have hx : (⟨p, hpA⟩ : GorensteinWalter.ASevenCertificateGroup) ∈ Subgroup.centralizer ({a7t} : Set GorensteinWalter.ASevenCertificateGroup) := by
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        have hyA : y = a7t := by simpa using hy
        subst y
        have hcomm := (Subgroup.mem_centralizer_iff.mp hpC)
          (a7t : Equiv.Perm (Fin 7)) (by simp)
        exact Subtype.ext hcomm
      exact hx
  have hcardMap : Nat.card (Subgroup.centralizer ({a7t} : Set GorensteinWalter.ASevenCertificateGroup)) =
      Nat.card ((Subgroup.centralizer ({a7t} : Set GorensteinWalter.ASevenCertificateGroup)).map GorensteinWalter.ASevenCertificateGroup.subtype) := by
    exact Nat.card_congr (Subgroup.equivMapOfInjective
      (Subgroup.centralizer ({a7t} : Set GorensteinWalter.ASevenCertificateGroup)) GorensteinWalter.ASevenCertificateGroup.subtype
        GorensteinWalter.ASevenCertificateGroup.subtype_injective).toEquiv
  rw [hcardMap, hmap, hcard24]

instance : DecidablePred (fun x : A7 =>
    x ∈ Subgroup.centralizer ({a7t} : Set A7)) := fun x =>
  decidable_of_iff (x * a7t = a7t * x)
    (Subgroup.mem_centralizer_singleton_iff).symm

private theorem a7US_eq_centralizer_center :
    a7US = Subgroup.centralizer ((centerIn (G := A7) (a7S : Subgroup A7)) : Set A7) := by
  have hle : a7US ≤ Subgroup.centralizer ((centerIn (G := A7) (a7S : Subgroup A7)) : Set A7) := by
    rw [centralizer_center_eq_centralizer_t]
    exact a7US_le_centralizer_t
  apply Subgroup.eq_of_le_of_card_ge hle
  rw [a7US_card, centralizer_center_eq_centralizer_t, a7t_centralizer_card]

/-- The 24 elements of `C_G(a7t)`, listed explicitly. -/
private def a7CList : List A7 :=
  [1, a7a, a7a ^ 2, a7v, a7v * a7a, a7v * a7a ^ 2, a7v ^ 2,
    a7v ^ 2 * a7a, a7v ^ 2 * a7a ^ 2, a7v ^ 3, a7v ^ 3 * a7a,
    a7v ^ 3 * a7a ^ 2, a7s, a7s * a7a, a7s * a7a ^ 2, a7s * a7v,
    a7s * a7v * a7a, a7s * a7v * a7a ^ 2, a7s * a7v ^ 2,
    a7s * a7v ^ 2 * a7a, a7s * a7v ^ 2 * a7a ^ 2, a7s * a7v ^ 3,
    a7s * a7v ^ 3 * a7a, a7s * a7v ^ 3 * a7a ^ 2]

private theorem a7CList_card : a7CList.toFinset.card = 24 := by
  decide

private theorem a7CList_mem_centralizer :
    List.Forall (fun x : A7 => x ∈ Subgroup.centralizer ({a7t} : Set A7))
      a7CList := by
  decide

private theorem a7CList_mem_US :
    List.Forall (fun x : A7 => x ∈ a7US) a7CList := by
  rw [a7US_eq_centralizer_center, centralizer_center_eq_centralizer_t]
  exact a7CList_mem_centralizer

private theorem a7CList_subset_centralizer : a7CList.toFinset ⊆
    Finset.univ.filter (fun y : A7 =>
      y ∈ Subgroup.centralizer ({a7t} : Set A7)) := by
  intro y hy
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact (List.forall_iff_forall_mem.mp a7CList_mem_centralizer) y
    (by simpa using hy)

private theorem mem_US_iff_mem_list (x : A7) :
    x ∈ a7US ↔ x ∈ a7CList.toFinset := by
  classical
  constructor
  · intro hx
    have hxC : x ∈ Subgroup.centralizer ({a7t} : Set A7) := by
      rw [← centralizer_center_eq_centralizer_t, ← a7US_eq_centralizer_center]
      exact hx
    let t : Finset A7 := Finset.univ.filter (fun y : A7 =>
      y ∈ Subgroup.centralizer ({a7t} : Set A7))
    have hst : a7CList.toFinset ⊆ t := a7CList_subset_centralizer
    have ht_card : t.card = 24 := by
      have ht_card' : t.card = Fintype.card {y : A7 //
          y ∈ Subgroup.centralizer ({a7t} : Set A7)} := by
        rw [Fintype.card_subtype]
      have ht_card'' : Fintype.card {y : A7 //
          y ∈ Subgroup.centralizer ({a7t} : Set A7)} = 24 := by
        rw [← Nat.card_eq_fintype_card]
        exact a7t_centralizer_card
      rw [ht_card', ht_card'']
    have hcard_eq : t.card = a7CList.toFinset.card := by
      rw [ht_card, a7CList_card]
    have hteq : t = a7CList.toFinset :=
      (Finset.eq_of_subset_of_card_le (s := a7CList.toFinset) (t := t)
        hst (by omega)).symm
    have hxt : x ∈ t := by
      simp [t, hxC]
    simpa [hteq] using hxt
  · intro hx
    exact (List.forall_iff_forall_mem.mp a7CList_mem_US) x
      (by simpa using hx)

private theorem a7U_normal_in_US : (a7U.subgroupOf a7US).Normal := by
  have hnorm : (a7U.subgroupOf (a7S ⊔ a7U)).Normal :=
    Subgroup.normal_subgroupOf_sup_of_le_normalizer a7S_le_normalizer_U
  have hEq : a7S ⊔ a7U = a7U ⊔ a7S := sup_comm a7S a7U
  rw [hEq] at hnorm
  change (a7U.subgroupOf (a7U ⊔ a7S)).Normal
  exact hnorm

public theorem aSeven_structure_fact_1_8_i :
    IsSimpleGroup A7 ∧ Nat.card A7 = 2520 ∧
      HasDihedralSylowTwo A7 := by
  constructor
  · exact alternatingGroup.isSimpleGroup (by norm_num)
  · constructor
    · exact card_aSeven
    · exact hasDihedralSylowTwo_alternatingGroupSeven

public theorem aSeven_structure_fact_1_8_ii_centralizer :
    Nat.card a7U = 3 ∧ (a7U.subgroupOf a7US).Normal ∧
      Subgroup.centralizer ((centerIn (G := A7) (a7S : Subgroup A7)) : Set A7) = a7US ∧
        IsKleinFour a7V := by
  exact ⟨a7U_card, a7U_normal_in_US,
    a7US_eq_centralizer_center.symm, a7V_isKleinFour⟩

private theorem mem_a7CList_iff (x : A7) :
    x ∈ a7CList.toFinset ↔
      x = 1 ∨ x = a7a ∨ x = a7a ^ 2 ∨ x = a7v ∨ x = a7v * a7a ∨
        x = a7v * a7a ^ 2 ∨ x = a7v ^ 2 ∨ x = a7v ^ 2 * a7a ∨
          x = a7v ^ 2 * a7a ^ 2 ∨ x = a7v ^ 3 ∨ x = a7v ^ 3 * a7a ∨
            x = a7v ^ 3 * a7a ^ 2 ∨ x = a7s ∨ x = a7s * a7a ∨
              x = a7s * a7a ^ 2 ∨ x = a7s * a7v ∨ x = a7s * a7v * a7a ∨
                x = a7s * a7v * a7a ^ 2 ∨ x = a7s * a7v ^ 2 ∨
                  x = a7s * a7v ^ 2 * a7a ∨ x = a7s * a7v ^ 2 * a7a ^ 2 ∨
                    x = a7s * a7v ^ 3 ∨ x = a7s * a7v ^ 3 * a7a ∨
                      x = a7s * a7v ^ 3 * a7a ^ 2 := by
  simp [a7CList]

private theorem a7V_le_a7US : a7V ≤ a7US := by
  intro x hx
  have hx' : x = 1 ∨ x = a7t ∨ x = a7u ∨ x = a7t * a7u := by
    change x ∈ (a7V : Set A7) at hx
    rw [a7V_mem_iff] at hx
    simpa [a7VList] using hx
  rcases hx' with rfl | rfl | rfl | rfl
  · exact Subgroup.one_mem a7US
  · rw [mem_US_iff_mem_list]
    decide
  · rw [mem_US_iff_mem_list]
    decide
  · rw [mem_US_iff_mem_list]
    decide

end CFSG.GorensteinWalter
