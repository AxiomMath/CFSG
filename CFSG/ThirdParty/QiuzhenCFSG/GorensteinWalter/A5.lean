  | 1, 0, 2, 4 => repMat44
  | 2, 0, 3, 4 => repMat45
  | 0, 4, 3, 2 => repMat46
  | 1, 0, 4, 3 => repMat47
  | 2, 1, 0, 4 => repMat48
  | 2, 4, 0, 3 => repMat49
  | 4, 0, 2, 3 => repMat50
  | 0, 1, 3, 4 => repMat51
  | 1, 2, 4, 0 => repMat52
  | 4, 2, 3, 0 => repMat53
  | 3, 0, 1, 4 => repMat54
  | 3, 4, 1, 2 => repMat55
  | 0, 3, 4, 1 => repMat56
  | 4, 3, 2, 1 => repMat57
  | 3, 2, 1, 0 => repMat58
  | 2, 3, 0, 1 => repMat59
  | _, _, _, _ => 1



/-- The two generators of `A₅`: `a5x = (0 1)(2 3)` and `a5y = (0 2 4)`. -/
private def a5x : alternatingGroup (Fin 5) := ⟨sigma1, by decide⟩
private def a5y : alternatingGroup (Fin 5) := ⟨sigma2, by decide⟩

/-- The transvections used to identify the center of `SL₂(ZMod 5)`. -/
private def a5E : A5SL2 := ⟨!![1, 1; 0, 1], by decide⟩
private def a5F : A5SL2 := ⟨!![1, 0; 1, 1], by decide⟩

/-- Equality up to the center of `SL₂(ZMod 5)`, i.e. up to `±1`. -/
private abbrev CenterEq (M : A5SL2) : Prop := M = 1 ∨ M = -1

/-- The center of `SL₂(ZMod 5)` consists exactly of `±1`: the identity and
`-1` commute with everything, and a matrix commuting with the two transvections
`E = [[1,1],[0,1]]` and `F = [[1,0],[1,1]]` is scalar with square `1`. -/
theorem mem_center_SL2_zmod5_iff {M : A5SL2} :
    M ∈ Subgroup.center A5SL2 ↔ M = 1 ∨ M = -1 := by
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  constructor
  · intro hM
    have hE : M.1 * a5E.1 = a5E.1 * M.1 := by
      simpa using (congrArg (fun q : A5SL2 => q.1) ((Subgroup.mem_center_iff.mp hM) a5E)).symm
    have hF : M.1 * a5F.1 = a5F.1 * M.1 := by
      simpa using (congrArg (fun q : A5SL2 => q.1) ((Subgroup.mem_center_iff.mp hM) a5F)).symm
    have hc : M.1 1 0 = 0 := by
      have hh := congrArg (fun q : Matrix (Fin 2) (Fin 2) (ZMod 5) => q 0 0) hE
      simp [a5E, Matrix.mul_apply, Fin.sum_univ_two] at hh
      exact hh
    have hd : M.1 0 0 = M.1 1 1 := by
      have hh := congrArg (fun q : Matrix (Fin 2) (Fin 2) (ZMod 5) => q 0 1) hE
      simp [a5E, Matrix.mul_apply, Fin.sum_univ_two] at hh
      exact add_right_cancel (a := M.1 0 0) (b := M.1 0 1) (c := M.1 1 1)
        (by simpa [add_comm] using hh)
    have hb : M.1 0 1 = 0 := by
      have hh := congrArg (fun q : Matrix (Fin 2) (Fin 2) (ZMod 5) => q 0 0) hF
      simp [a5F, Matrix.mul_apply, Fin.sum_univ_two] at hh
      exact hh
    let a : ZMod 5 := M.1 0 0
    have hMdiag : M.1 = a • (1 : Matrix (Fin 2) (Fin 2) (ZMod 5)) := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [a, hc, hd, hb]
    have ha2 : a * a = 1 := by
      have h := (M.2 : M.1.det = 1)
      rw [hMdiag] at h
      simpa [Matrix.det_fin_two, pow_two] using h
    have ha : a = 1 ∨ a = -1 := by
      have h : (a - 1) * (a + 1) = 0 := by
        calc
          (a - 1) * (a + 1) = a * a - 1 := by ring
          _ = 0 := by rw [ha2]; ring
      rcases mul_eq_zero.mp h with h1 | h2
      · left
        exact sub_eq_zero.mp h1
      · right
        exact eq_neg_of_add_eq_zero_right (by simpa [add_comm] using h2)
    rcases ha with h1 | h2
    · left
      apply Subtype.ext
      simp [hMdiag, h1]
    · right
      apply Subtype.ext
      simp [hMdiag, h2]
  · intro h
    rcases h with rfl | rfl
    · exact Subgroup.one_mem _
    · apply Subgroup.mem_center_iff.mpr
      intro g
      apply Subtype.ext
      simp

/-- `mk`-equality of two matrices from equality up to the center. -/
theorem mk_eq_of_centerEq {a b : A5SL2} (h : CenterEq (a⁻¹ * b)) :
    (QuotientGroup.mk a : PSL2 (ZMod 5)) = QuotientGroup.mk b := by
  apply QuotientGroup.eq.mpr
  rw [mem_center_SL2_zmod5_iff]
  exact h

/-- The class map respects the two generators and their inverses, verified on
all `60 · 4` pairs by computation. -/
theorem repPerm_gen_cond : ∀ p : alternatingGroup (Fin 5),
    CenterEq ((repPerm (p.1 * a5x.1))⁻¹ * (repPerm p.1 * repPerm a5x.1)) ∧
    CenterEq ((repPerm (p.1 * a5y.1))⁻¹ * (repPerm p.1 * repPerm a5y.1)) ∧
    CenterEq ((repPerm (p.1 * a5x.1⁻¹))⁻¹ * (repPerm p.1 * repPerm a5x.1⁻¹)) ∧
    CenterEq ((repPerm (p.1 * a5y.1⁻¹))⁻¹ * (repPerm p.1 * repPerm a5y.1⁻¹)) := by
  decide

/-- No non-identity element of `A₅` is mapped to the center of
`SL₂(ZMod 5)`, i.e. the class map is injective; verified on all 60 elements. -/
theorem repPerm_notCenter : ∀ x : alternatingGroup (Fin 5), x ≠ 1 →
    repPerm x.1 ≠ 1 ∧ repPerm x.1 ≠ -1 := by
  decide

/-- The orders of the two generators and their product. -/
theorem a5x_order : orderOf (a5x : alternatingGroup (Fin 5)) = 2 := by
  have : Fact (Nat.Prime 2) := ⟨by decide⟩
  apply orderOf_eq_prime (p := 2)
  · decide
  · decide
theorem a5y_order : orderOf (a5y : alternatingGroup (Fin 5)) = 3 := by
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  apply orderOf_eq_prime (p := 3)
  · decide
  · decide
theorem a5x_mul_a5y_order : orderOf (a5x.1 * a5y.1 : Equiv.Perm (Fin 5)) = 5 := by
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  apply orderOf_eq_prime (p := 5)
  · decide
  · decide

/-- The class map is a homomorphism: `mk (rep (p.1 * f)) = mk (rep p.1) * mk (rep f)`
for every `f` in the subgroup generated by `a5x` and `a5y`. -/
def P (f : Equiv.Perm (Fin 5)) : Prop :=
  ∀ p : alternatingGroup (Fin 5),
    (QuotientGroup.mk (repPerm (p.1 * f)) : PSL2 (ZMod 5)) =
      QuotientGroup.mk (repPerm p.1) * QuotientGroup.mk (repPerm f)

theorem P_a5x : P a5x.1 := by
  intro p
  exact mk_eq_of_centerEq (repPerm_gen_cond p).1
theorem P_a5y : P a5y.1 := by
  intro p
  exact mk_eq_of_centerEq (repPerm_gen_cond p).2.1
theorem P_a5x_inv : P a5x.1⁻¹ := by
  intro p
  exact mk_eq_of_centerEq (repPerm_gen_cond p).2.2.1
theorem P_a5y_inv : P a5y.1⁻¹ := by
  intro p
  exact mk_eq_of_centerEq (repPerm_gen_cond p).2.2.2

/-- `A₅` is generated by `a5x` and `a5y`.  The generated subgroup has order
divisible by `2 · 3 · 5 = 30` and dividing `120`; it is contained in `A₅`,
so its order is at most `60`; it is not `30` because an index-`2` subgroup of
the simple group `A₅` would be normal.  Hence it has order `60` and index `2`
in `Perm (Fin 5)`, so it is the alternating group. -/
theorem closure_a5x_a5y :
    Subgroup.closure ({a5x.1, a5y.1} : Set (Equiv.Perm (Fin 5))) = alternatingGroup (Fin 5) := by
  let C := Subgroup.closure ({a5x.1, a5y.1} : Set (Equiv.Perm (Fin 5)))
  apply Equiv.Perm.eq_alternatingGroup_of_index_eq_two
  -- `C.index = 2`
  have hle : C ≤ alternatingGroup (Fin 5) := by
    rw [Subgroup.closure_le]
    intro f hf
    simp at hf
    rcases hf with rfl | rfl
    · exact a5x.2
    · exact a5y.2
  -- 30 ∣ |C|
  have hx : a5x.1 ∈ C := Subgroup.subset_closure (by simp)
  have hy : a5y.1 ∈ C := Subgroup.subset_closure (by simp)
  have hxy : a5x.1 * a5y.1 ∈ C := Subgroup.mul_mem C hx hy
  have h2 : 2 ∣ Nat.card ↥C := by
    have hord : orderOf (⟨a5x.1, hx⟩ : ↥C) = 2 := by
      rw [← Subgroup.orderOf_coe]
      simpa using a5x_order
    simpa [hord] using orderOf_dvd_natCard (⟨a5x.1, hx⟩ : ↥C)
  have h3 : 3 ∣ Nat.card ↥C := by
    have hord : orderOf (⟨a5y.1, hy⟩ : ↥C) = 3 := by
      rw [← Subgroup.orderOf_coe]
      simpa using a5y_order
    simpa [hord] using orderOf_dvd_natCard (⟨a5y.1, hy⟩ : ↥C)
  have h5 : 5 ∣ Nat.card ↥C := by
    have hord : orderOf (⟨a5x.1 * a5y.1, hxy⟩ : ↥C) = 5 := by
      rw [← Subgroup.orderOf_coe]
      simpa using a5x_mul_a5y_order
    simpa [hord] using orderOf_dvd_natCard (⟨a5x.1 * a5y.1, hxy⟩ : ↥C)
  have h15 : 15 ∣ Nat.card ↥C := by
    rcases h3 with ⟨k, hk⟩
    rw [hk]
    have h5' : 5 ∣ 3 * k := by
      rw [← hk]
      exact h5
    have h5k : 5 ∣ k := Nat.Coprime.dvd_of_dvd_mul_right (by norm_num : (5 : ℕ).Coprime 3) (by simpa [mul_comm] using h5')
    rcases h5k with ⟨k', rfl⟩
    use k'
    ring
  have h30 : 30 ∣ Nat.card ↥C := by
    rcases h2 with ⟨k, hk⟩
    rw [hk]
    have h15' : 15 ∣ 2 * k := by
      rw [← hk]
      exact h15
    have h15k : 15 ∣ k := Nat.Coprime.dvd_of_dvd_mul_right (by norm_num : (15 : ℕ).Coprime 2) (by simpa [mul_comm] using h15')
    rcases h15k with ⟨k', rfl⟩
    use k'
    ring
  -- |C| ≤ 60
  have hle60 : Nat.card ↥C ≤ 60 := by
    have : Fintype ↥C := Fintype.ofFinite _
    have : Fintype ↥(alternatingGroup (Fin 5)) := Fintype.ofFinite _
    have hinj : Function.Injective (fun x : ↥C => (⟨x.1, hle x.2⟩ : alternatingGroup (Fin 5))) := by
      intro x y h
      exact Subtype.ext (congrArg (fun q : alternatingGroup (Fin 5) => q.1) h)
    have hle' : Fintype.card ↥C ≤ Fintype.card ↥(alternatingGroup (Fin 5)) :=
      Fintype.card_le_of_injective _ hinj
    have h60 : Fintype.card ↥(alternatingGroup (Fin 5)) = 60 := by
      rw [← Nat.card_eq_fintype_card]
      have h60' : Nat.card (alternatingGroup (Fin 5)) = 60 := by
        rw [nat_card_alternatingGroup]
        norm_num <;> decide
      exact h60'
    have hle'' : Fintype.card ↥C ≤ 60 := by
      rw [← h60]
      exact hle'
    rw [Nat.card_eq_fintype_card]
    exact hle''
  -- |C| ≠ 30
  have hne30 : Nat.card ↥C ≠ 30 := by
    intro h30card
    let K := C.subgroupOf (alternatingGroup (Fin 5))
    have hKcard : Nat.card ↥K = Nat.card ↥C := by
      apply Nat.card_congr
      refine { toFun := fun x : ↥K => ⟨x.1.1, Subgroup.mem_subgroupOf.mp x.2⟩,
               invFun := fun y : ↥C => ⟨⟨y.1, hle y.2⟩, Subgroup.mem_subgroupOf.mpr y.2⟩,
               left_inv := fun x => Subtype.ext rfl,
               right_inv := fun y => Subtype.ext rfl }
    have hKindex : K.index = 2 := by
      have h := Subgroup.index_mul_card K
      have h60 : Nat.card ↥(alternatingGroup (Fin 5)) = 60 := by
        rw [nat_card_alternatingGroup]
        norm_num <;> decide
      rw [hKcard, h30card, h60] at h
      omega
    have : K.Normal := Subgroup.normal_of_index_eq_two hKindex
    rcases (alternatingGroup.isSimpleGroup (by norm_num : 5 ≤ Nat.card (Fin 5))).eq_bot_or_eq_top_of_normal K with hKbot | hKtop
    · have : Nat.card ↥K = 1 := by rw [hKbot]; exact Subgroup.card_bot
      omega
    · have : Nat.card ↥K = 60 := by
        rw [hKtop]
        have h60 : Nat.card ↥(alternatingGroup (Fin 5)) = 60 := by
          rw [nat_card_alternatingGroup]
          norm_num <;> decide
        exact (Nat.card_congr (Subgroup.topEquiv (G := alternatingGroup (Fin 5))).toEquiv).trans h60
      omega
  -- |C| = 60
  have h60card : Nat.card ↥C = 60 := by
    rcases h30 with ⟨k, hk⟩
    have hk2 : k ≤ 2 := by
      rw [hk] at hle60
      omega
    have hkne1 : k ≠ 1 := by
      intro hk1
      apply hne30
      simp [hk, hk1]
    have hkne0 : k ≠ 0 := by
      intro hk0
      have hne0 : Nat.card ↥C ≠ 0 := by
        exact (Nat.card_ne_zero.mpr ⟨⟨1, Subgroup.one_mem _⟩, by infer_instance⟩)
      apply hne0
      simp [hk, hk0]
    have hk2' : k = 2 := by omega
    simp [hk, hk2']
  -- C.index = 2
  have h := Subgroup.index_mul_card C
  have h120 : Nat.card (Equiv.Perm (Fin 5)) = 120 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm]
    decide
  rw [h60card, h120] at h
  nlinarith

/-- The class map is a homomorphism on all of `A₅`. -/
theorem repPerm_mul_mk : ∀ x y : alternatingGroup (Fin 5),
    (QuotientGroup.mk (repPerm (x.1 * y.1)) : PSL2 (ZMod 5)) =
      QuotientGroup.mk (repPerm x.1) * QuotientGroup.mk (repPerm y.1) := by
  intro x y
  have hy : y.1 ∈ Subgroup.closure ({a5x.1, a5y.1} : Set (Equiv.Perm (Fin 5))) := by
    simpa [closure_a5x_a5y] using y.2
  have hPy : P y.1 := Subgroup.closure_induction_left
    (s := ({a5x.1, a5y.1} : Set (Equiv.Perm (Fin 5))))
    (p := fun f _ => P f)
    (one := by
      intro p
      have hrep1 : repPerm (1 : Equiv.Perm (Fin 5)) = 1 := by decide
      simp [P, hrep1, QuotientGroup.mk_one])
    (mul_left := by
      intro x0 hx0 y0 hy0 hPy0 p
      rcases (by simpa using hx0 : x0 = a5x.1 ∨ x0 = a5y.1) with rfl | rfl
      · -- x0 = a5x.1
        have h1 : (QuotientGroup.mk (repPerm (p.1 * (a5x.1 * y0))) : PSL2 (ZMod 5)) =
            QuotientGroup.mk (repPerm (p.1 * a5x.1)) * QuotientGroup.mk (repPerm y0) := by
          simpa [mul_assoc] using hPy0 (p * a5x)
        calc
          (QuotientGroup.mk (repPerm (p.1 * (a5x.1 * y0))) : PSL2 (ZMod 5))
              = QuotientGroup.mk (repPerm (p.1 * a5x.1)) * QuotientGroup.mk (repPerm y0) := h1
          _ = (QuotientGroup.mk (repPerm p.1) * QuotientGroup.mk (repPerm a5x.1)) *
              QuotientGroup.mk (repPerm y0) := by rw [P_a5x p]
          _ = QuotientGroup.mk (repPerm p.1) *
              (QuotientGroup.mk (repPerm a5x.1) * QuotientGroup.mk (repPerm y0)) := by
                rw [mul_assoc]
          _ = QuotientGroup.mk (repPerm p.1) *
              QuotientGroup.mk (repPerm (a5x.1 * y0)) := by rw [← hPy0 a5x]
      · -- x0 = a5y.1
        have h1 : (QuotientGroup.mk (repPerm (p.1 * (a5y.1 * y0))) : PSL2 (ZMod 5)) =
            QuotientGroup.mk (repPerm (p.1 * a5y.1)) * QuotientGroup.mk (repPerm y0) := by
          simpa [mul_assoc] using hPy0 (p * a5y)
        calc
          (QuotientGroup.mk (repPerm (p.1 * (a5y.1 * y0))) : PSL2 (ZMod 5))
              = QuotientGroup.mk (repPerm (p.1 * a5y.1)) * QuotientGroup.mk (repPerm y0) := h1
          _ = (QuotientGroup.mk (repPerm p.1) * QuotientGroup.mk (repPerm a5y.1)) *
              QuotientGroup.mk (repPerm y0) := by rw [P_a5y p]
          _ = QuotientGroup.mk (repPerm p.1) *
              (QuotientGroup.mk (repPerm a5y.1) * QuotientGroup.mk (repPerm y0)) := by
                rw [mul_assoc]
          _ = QuotientGroup.mk (repPerm p.1) *
              QuotientGroup.mk (repPerm (a5y.1 * y0)) := by rw [← hPy0 a5y])
    (inv_mul_cancel := by
      intro x0 hx0 y0 hy0 hPy0 p
      rcases (by simpa using hx0 : x0 = a5x.1 ∨ x0 = a5y.1) with rfl | rfl
      · -- x0 = a5x.1
        have hPx : P (a5x.1⁻¹) := by simpa using P_a5x_inv
        have h1 : (QuotientGroup.mk (repPerm (p.1 * (a5x.1⁻¹ * y0))) : PSL2 (ZMod 5)) =
            QuotientGroup.mk (repPerm (p.1 * a5x.1⁻¹)) * QuotientGroup.mk (repPerm y0) := by
          simpa [mul_assoc] using hPy0 (p * ⟨a5x.1⁻¹, by simpa using a5x.2.inv_mem⟩)
        calc
          (QuotientGroup.mk (repPerm (p.1 * (a5x.1⁻¹ * y0))) : PSL2 (ZMod 5))
              = QuotientGroup.mk (repPerm (p.1 * a5x.1⁻¹)) * QuotientGroup.mk (repPerm y0) := h1
          _ = (QuotientGroup.mk (repPerm p.1) * QuotientGroup.mk (repPerm a5x.1⁻¹)) *
              QuotientGroup.mk (repPerm y0) := by rw [hPx p]
          _ = QuotientGroup.mk (repPerm p.1) *
              (QuotientGroup.mk (repPerm a5x.1⁻¹) * QuotientGroup.mk (repPerm y0)) := by
                rw [mul_assoc]
          _ = QuotientGroup.mk (repPerm p.1) *
              QuotientGroup.mk (repPerm (a5x.1⁻¹ * y0)) := by rw [← hPy0 ⟨a5x.1⁻¹, by simpa using a5x.2.inv_mem⟩]
      · -- x0 = a5y.1
        have hPy : P (a5y.1⁻¹) := by simpa using P_a5y_inv
        have h1 : (QuotientGroup.mk (repPerm (p.1 * (a5y.1⁻¹ * y0))) : PSL2 (ZMod 5)) =
            QuotientGroup.mk (repPerm (p.1 * a5y.1⁻¹)) * QuotientGroup.mk (repPerm y0) := by
          simpa [mul_assoc] using hPy0 (p * ⟨a5y.1⁻¹, by simpa using a5y.2.inv_mem⟩)
        calc
          (QuotientGroup.mk (repPerm (p.1 * (a5y.1⁻¹ * y0))) : PSL2 (ZMod 5))
              = QuotientGroup.mk (repPerm (p.1 * a5y.1⁻¹)) * QuotientGroup.mk (repPerm y0) := h1
          _ = (QuotientGroup.mk (repPerm p.1) * QuotientGroup.mk (repPerm a5y.1⁻¹)) *
              QuotientGroup.mk (repPerm y0) := by rw [hPy p]
          _ = QuotientGroup.mk (repPerm p.1) *
              (QuotientGroup.mk (repPerm a5y.1⁻¹) * QuotientGroup.mk (repPerm y0)) := by
                rw [mul_assoc]
          _ = QuotientGroup.mk (repPerm p.1) *
              QuotientGroup.mk (repPerm (a5y.1⁻¹ * y0)) := by rw [← hPy0 ⟨a5y.1⁻¹, by simpa using a5y.2.inv_mem⟩])
    hy
  exact hPy x

/-- The quotient map `A₅ → PSL₂(ZMod 5)`. -/
def a5ToPSL2 : alternatingGroup (Fin 5) →* PSL2 (ZMod 5) where
  toFun := fun x => QuotientGroup.mk (repPerm x.1)
  map_one' := by
    change QuotientGroup.mk (repPerm (1 : alternatingGroup (Fin 5)).1) =
      (1 : PSL2 (ZMod 5))
    rw [← QuotientGroup.mk_one]
    congr 1
    decide
  map_mul' := by
    intro x y
    rw [← QuotientGroup.mk_mul]
    exact repPerm_mul_mk x y

/-- The map `A₅ → PSL₂(ZMod 5)` is injective. -/
theorem a5ToPSL2_injective :
    Function.Injective (a5ToPSL2 : alternatingGroup (Fin 5) → PSL2 (ZMod 5)) := by
  intro x y h
  by_contra hne
  have hz : (x.1 * y.1⁻¹) ≠ 1 := by
    -- from x ≠ y
    intro hz
    apply hne
    -- x = y from x * y⁻¹ = 1
    apply Subtype.ext
    -- hmm -- x.1 * y.1⁻¹ = 1 → x.1 = y.1
    -- group: mul_inv_eq_one.mp? -- hmm --
    simpa [mul_inv_eq_one] using hz
  have hf : (a5ToPSL2 (x * y⁻¹) : PSL2 (ZMod 5)) = 1 := by
    -- f(x·y⁻¹) = f x · f y⁻¹ = f x · f y⁻¹ -- and f x = f y -- hmm -- f y⁻¹ = f y⁻¹ -- hmm --
    -- f is a hom: f (x·y⁻¹) = f x · f y⁻¹ — and f y⁻¹ = (f y)⁻¹ — hmm — f y⁻¹ — hmm —
    -- simpler: from h : f x = f y — f (x·y⁻¹) = f x · f y⁻¹ = f y · f y⁻¹ = 1
    rw [map_mul, map_inv]
    rw [h]
    simp
  have hcenter : (repPerm (x * y⁻¹).1) ∈ Subgroup.center A5SL2 := by
    -- f (x·y⁻¹) = 1 -- mk (rep (x·y⁻¹).1) = 1 -- QuotientGroup.eq.mp -- hmm -- mk a = mk 1 -- (a⁻¹ * 1) ∈ center -- hmm -- a⁻¹ ∈ center -- inv_mem_iff -- a ∈ center
    have hq : (QuotientGroup.mk (repPerm (x * y⁻¹).1) : PSL2 (ZMod 5)) = QuotientGroup.mk (1 : A5SL2) := by
      simpa [a5ToPSL2] using hf
    have hm : (repPerm (x * y⁻¹).1)⁻¹ * (1 : A5SL2) ∈ Subgroup.center A5SL2 :=
      QuotientGroup.eq.mp hq
    simpa using (Subgroup.inv_mem_iff (Subgroup.center A5SL2)).mp (by simpa using hm)
  have hne2 : (repPerm (x * y⁻¹).1 ≠ 1 ∧ repPerm (x * y⁻¹).1 ≠ -1) :=
    repPerm_notCenter (x * y⁻¹) (by
      intro hne'
      apply hz
      simpa using congrArg (fun q : alternatingGroup (Fin 5) => q.1) hne')
  have hc : repPerm (x * y⁻¹).1 = 1 ∨ repPerm (x * y⁻¹).1 = -1 := by
    rwa [mem_center_SL2_zmod5_iff] at hcenter
  rcases hc with hc1 | hc2
  · exact hne2.1 hc1
  · exact hne2.2 hc2

/-- The exceptional isomorphism `A₅ ≅ PSL₂(ZMod 5)`. -/
public theorem alternatingGroupFive_equiv_PSL2 :
    Nonempty (alternatingGroup (Fin 5) ≃* PSL2 (ZMod 5)) := by
  refine ⟨MulEquiv.ofBijective a5ToPSL2 ?_⟩
  rw [Fintype.bijective_iff_injective_and_card]
  constructor
  · exact a5ToPSL2_injective
  · -- the two cardinalities are both 60
    have hG : Fintype.card (alternatingGroup (Fin 5)) = 60 := by
      rw [← Nat.card_eq_fintype_card]
      rw [nat_card_alternatingGroup]
      norm_num
      decide
    have hSL2 : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (ZMod 5)) = 120 := by
      rw [Nat.card_eq_fintype_card]
      decide
    have hcenter : Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (ZMod 5))) = 2 := by
      rw [Nat.card_eq_fintype_card]
      decide
    have hindex : (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (ZMod 5))).index = 60 := by
      have h := Subgroup.index_mul_card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (ZMod 5)))
      rw [hcenter, hSL2] at h
      omega
    have hH : Nat.card (PSL2 (ZMod 5)) = 60 := by
      rw [Subgroup.index_eq_card] at hindex
      simpa using hindex
    rw [hG]
    rw [← Nat.card_eq_fintype_card]
    exact hH.symm

/-! ## The `2'`-core of `A₅` is trivial -/

/-- The `2'`-core of `A₅` is trivial: `A₅` is simple and not a `2`-group, so no
nontrivial normal subgroup has odd order. -/
public theorem pPrimeCore_two_alternatingGroupFive :
    pPrimeCore 2 (alternatingGroup (Fin 5)) = ⊥ := by
  rw [pPrimeCore_eq_bot_iff]
  intro K hKnorm hKcop
  have hsimple : IsSimpleGroup (alternatingGroup (Fin 5)) :=
    alternatingGroup.isSimpleGroup (by norm_num)
  rcases (haveI := hKnorm; hsimple.eq_bot_or_eq_top_of_normal K) with hKbot | hKtop
  · exact hKbot
  · exfalso
    have h60 : Nat.card (alternatingGroup (Fin 5)) = 60 := by
      rw [nat_card_alternatingGroup]
      norm_num <;> decide
    have hcard : Nat.card K = 60 := by
      rw [hKtop]
      exact (Nat.card_congr (Subgroup.topEquiv (G := alternatingGroup (Fin 5))).toEquiv).trans h60
    have hnot : ¬ Nat.Coprime 2 (Nat.card K) := by
      rw [hcard]
      norm_num
    exact hnot hKcop

/-! ## The Sylow `2`-subgroups of `A₅` -/

/-- Every Sylow `2`-subgroup of `A₅` is a Klein four group: it has order `4`
and, since `A₅` has no element of order `4`, all its elements have order at
most `2`. -/
public theorem sylowTwo_alternatingGroupFive_isKleinFour
    (S : Sylow 2 (alternatingGroup (Fin 5))) :
    IsKleinFour ↥(S : Subgroup (alternatingGroup (Fin 5))) := by
  have h60 : Nat.card (alternatingGroup (Fin 5)) = 60 := by
    rw [nat_card_alternatingGroup]
    norm_num
    decide
  have hfac : (60 : ℕ).factorization 2 = 2 := by
    rw [show (60 : ℕ) = 2 ^ 2 * 15 by norm_num]
    rw [Nat.factorization_mul (by norm_num : (2 ^ 2 : ℕ) ≠ 0) (by norm_num : (15 : ℕ) ≠ 0)]
    rw [Finsupp.add_apply]
    rw [Nat.factorization_pow_self (by decide : (2 : ℕ).Prime)]
    rw [Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ (15 : ℕ))]
  have hcard4 : Nat.card ↥(S : Subgroup (alternatingGroup (Fin 5))) = 4 := by
    have hcardS : Nat.card ↥(S : Subgroup (alternatingGroup (Fin 5))) =
        2 ^ (Nat.card (alternatingGroup (Fin 5))).factorization 2 :=
      Sylow.card_eq_multiplicity S
    rw [h60, hfac] at hcardS
    simpa using hcardS
  have : Fact (Nat.Prime 2) := ⟨by decide⟩
  constructor
  · exact hcard4
  · apply Nat.dvd_antisymm
    · -- `Monoid.exponent ↥S ∣ 2`
      rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
      intro x
      have hno4 : ∀ σ : Equiv.Perm (Fin 5), σ ∈ alternatingGroup (Fin 5) → σ ^ 4 = 1 → σ ^ 2 = 1 := by
        decide
      have hdvd4 : orderOf x ∣ 4 := by
        exact dvd_trans (orderOf_dvd_natCard x) (by simpa [hcard4])
      have hne4 : orderOf x ≠ 4 := by
        intro hord
        have hp : orderOf (x : Equiv.Perm (Fin 5)) = 4 := by
          simpa [Subgroup.orderOf_coe] using hord
        have hp4 : (x : Equiv.Perm (Fin 5)) ^ 4 = 1 :=
          orderOf_dvd_iff_pow_eq_one.mp (by simpa [hp])
        have hp2 : (x : Equiv.Perm (Fin 5)) ^ 2 = 1 :=
          hno4 (x : Equiv.Perm (Fin 5)) (by simpa using x.1.2) hp4
        have hdiv : orderOf (x : Equiv.Perm (Fin 5)) ∣ 2 := orderOf_dvd_iff_pow_eq_one.mpr hp2
        have hdiv' : ¬ (4 : ℕ) ∣ 2 := by norm_num
        apply hdiv'
        rw [← hp]
        exact hdiv
      apply orderOf_dvd_iff_pow_eq_one.mp
      rcases ((Nat.dvd_prime_pow (by decide : (2 : ℕ).Prime) (m := 2) (i := orderOf x)).mp hdvd4) with ⟨k, hk, hk'⟩
      have hkne2 : k ≠ 2 := by
        intro hk2'
        apply hne4
        rw [hk', hk2']
        norm_num
      interval_cases k
      · simp [hk']
      · simp [hk']
      · exfalso
        exact hkne2 rfl
    · -- `2 ∣ Monoid.exponent ↥S`
      let : Fintype ↥(S : Subgroup (alternatingGroup (Fin 5))) := Fintype.ofFinite _
      have hcardF : Fintype.card ↥(S : Subgroup (alternatingGroup (Fin 5))) = 4 := by
        rw [← Nat.card_eq_fintype_card]
        exact hcard4
      obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card (G := ↥(S : Subgroup (alternatingGroup (Fin 5))))
        2 (by norm_num [hcardF])
      simpa [hx] using (Monoid.order_dvd_exponent x :
        orderOf x ∣ Monoid.exponent ↥(S : Subgroup (alternatingGroup (Fin 5))))

/-- Every Sylow `2`-subgroup of `A₅` is `DihedralGroup 2`, the Klein four
group. -/
public theorem hasDihedralSylowTwo_alternatingGroupFive :
    HasDihedralSylowTwo (alternatingGroup (Fin 5)) := by
  intro S
  refine ⟨1, by norm_num, ?_⟩
  have : IsKleinFour ↥(S : Subgroup (alternatingGroup (Fin 5))) :=
    sylowTwo_alternatingGroupFive_isKleinFour S
  simpa using (IsKleinFour.nonempty_mulEquiv
    (G₁ := ↥(S : Subgroup (alternatingGroup (Fin 5)))) (G₂ := DihedralGroup 2))

/-- `A₅` has cyclic or dihedral Sylow `2`-subgroups (in fact they are all
`DihedralGroup 2`, the Klein four group). -/
public theorem hasCyclicOrDihedralSylowTwo_alternatingGroupFive :
    HasCyclicOrDihedralSylowTwo (alternatingGroup (Fin 5)) := by
  intro S
  exact Or.inr (hasDihedralSylowTwo_alternatingGroupFive S)

/-! ## `A₅` is a D-group -/

/-- The alternating group on five points is a D-group, realized through
`A₅ ≅ PSL₂(ZMod 5)` with `q = 5` an odd prime power. -/
public theorem alternatingGroupFive_isDGroup : IsDGroup (alternatingGroup (Fin 5)) := by
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  refine IsDGroup.quotientHasLinearNormalSubgroup (G := alternatingGroup (Fin 5))
    (K := ZMod 5) hasCyclicOrDihedralSylowTwo_alternatingGroupFive ?_ ⊤ ?_ ?_ ?_
  · -- `IsOddPrimePower (Nat.card (ZMod 5))`
    rw [show Nat.card (ZMod 5) = 5 by
      rw [Nat.card_eq_fintype_card]
      simp [ZMod.card]]
    exact ⟨5, 1, by decide, by decide, by norm_num, rfl⟩
  · -- `(⊤ : Subgroup _).Normal`
    infer_instance
  · -- `Odd (⊤ : Subgroup _).index`
    simp
  · -- the model: `⊤ ≃* PSL₂(ZMod 5)`
    left
    rcases alternatingGroupFive_equiv_PSL2 with ⟨eA5⟩
    exact ⟨Subgroup.topEquiv.trans (by
      exact (QuotientGroup.quotientMulEquivOfEq (M := pPrimeCore 2 (alternatingGroup (Fin 5)))
        (N := ⊥) pPrimeCore_two_alternatingGroupFive).trans
        ((QuotientGroup.quotientBot (G := alternatingGroup (Fin 5))).trans eA5))⟩

/-! ## Universe-polymorphic transport -/

/-- A group isomorphic to `A₅` is a `D`-group, with no universe restriction on
the source group.  This is the `A₅` analogue of the universe-polymorphic
`isDGroup_of_mulEquiv_aSeven` helper in the classification layer. -/
public theorem isDGroup_of_mulEquiv_aFive
    {G : Type u} [Group G] [Finite G]
    (e : Nonempty (G ≃* alternatingGroup (Fin 5))) :
    IsDGroup G := by
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  rcases e with ⟨e⟩
  have hcoreA : pPrimeCore 2 (alternatingGroup (Fin 5)) = ⊥ :=
    pPrimeCore_two_alternatingGroupFive
  have hcoreG : pPrimeCore 2 G = ⊥ := by
    have hmap := pPrimeCore_map_iso 2 e
    have hmap' : (pPrimeCore 2 G).map e.toMonoidHom = ⊥ := by
      simpa [hcoreA] using hmap
    apply (Subgroup.map_injective (f := e.toMonoidHom) e.injective)
    simpa using hmap'
  have hdihedral : HasDihedralSylowTwo G :=
    hasDihedralSylowTwo_of_mulEquiv e
      hasDihedralSylowTwo_alternatingGroupFive
  have hSylow : HasCyclicOrDihedralSylowTwo G := by
    intro S
    exact Or.inr (hdihedral S)
  have qG : G ⧸ pPrimeCore 2 G ≃* G := by
    exact (QuotientGroup.quotientMulEquivOfEq (G := G) hcoreG).trans
      (QuotientGroup.quotientBot (G := G))
  refine IsDGroup.quotientHasLinearNormalSubgroup hSylow
    (K := ULift.{u} (ZMod 5)) ?_ ⊤ ?_ ?_ ?_
  · rw [Nat.card_congr (Equiv.ulift : ULift.{u} (ZMod 5) ≃ ZMod 5)]
    rw [show Nat.card (ZMod 5) = 5 by
      rw [Nat.card_eq_fintype_card]
      simp [ZMod.card]]
    exact ⟨5, 1, by decide, by decide, by norm_num, rfl⟩
  · infer_instance
  · simp
  · left
    rcases alternatingGroupFive_equiv_PSL2 with ⟨eA5⟩
    refine ⟨Subgroup.topEquiv.trans ?_⟩
    exact ((qG.trans e).trans eA5).trans
      (psl2ULiftEquiv (ZMod 5)).symm

end CFSG.GorensteinWalter
