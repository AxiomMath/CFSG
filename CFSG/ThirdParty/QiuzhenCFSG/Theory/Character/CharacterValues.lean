public import CFSG.ThirdParty.QiuzhenCFSG.Theory.Character.Cyclotomic
public import CFSG.ThirdParty.QiuzhenCFSG.Theory.Representation.Induction

namespace CFSG
end CFSG
open CFSG

/-!
# Cyclotomic integrality of character values

This file supplies the cyclotomic-order value statement used in Peterfalvi
(1.10): if `η` is a primitive `|G|`-th root of unity, then every value of a
finite-dimensional complex representation character of `G` lies in `ℤ[η]`.

The proof is purely `Representation`-level.  It diagonalizes a finite-order
linear map, writes the trace as a sum of eigenvalues, and observes that each
eigenvalue is a power of the chosen primitive root.
-/

noncomputable section

open scoped BigOperators

namespace CFSG.Theory.Character

open _root_.Representation
open Theory.Representation

attribute [local instance] Fintype.ofFinite

/--
If the eigenvalues of a finite-order endomorphism have orders dividing `M`,
and `η` is a primitive `M`-th root of unity, then the trace belongs to `ℤ[η]`.
-/
public lemma finite_order_end_trace_mem_cyclotomicOrder
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {η : ℂ} {N M : ℕ} (hη : IsPrimitiveRoot η M) (hM : M ≠ 0)
    (hNM : N ∣ M) {f : Module.End ℂ V} (hN : N ≠ 0) (hf : f ^ N = 1) :
    LinearMap.trace ℂ V f ∈ cyclotomicOrder η := by
  classical
  let A := cyclotomicOrder η
  change LinearMap.trace ℂ V (f ^ 1) ∈ A
  rw [trace_pow_eq_sum_eigenvalues (f := f) (n := N) (k := 1) hN hf]
  refine A.sum_mem fun μ _ => ?_
  have hμN : (μ : ℂ) ^ N = 1 := eigenvalue_pow_eq_one_of_pow_eq_one hf μ.property
  have horder : orderOf (μ : ℂ) ∣ M :=
    Nat.dvd_trans (orderOf_dvd_of_pow_eq_one hμN) hNM
  have hμM : (μ : ℂ) ^ M = 1 := (orderOf_dvd_iff_pow_eq_one).mp horder
  have : NeZero M := ⟨hM⟩
  obtain ⟨i, _hi_lt, hi⟩ := hη.eq_pow_of_pow_eq_one hμM
  have hμ_mem : (μ : ℂ) ∈ A := by
    rw [← hi]
    exact A.pow_mem (eta_mem_cyclotomicOrder η) i
  exact A.mul_mem (A.pow_mem hμ_mem 1)
    (natCast_mem_cyclotomicOrder η (Module.finrank ℂ (f.eigenspace (μ : ℂ))))

/--
Character values of finite-dimensional complex representations of a finite
group lie in the cyclotomic order generated by a primitive `|G|`-th root.
-/
public lemma representation_character_mem_cyclotomicOrder
    {G V : Type*} [Group G] [Finite G]
    [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {η : ℂ} (hη : IsPrimitiveRoot η (Nat.card G))
    (ρ : Representation ℂ G V) (g : G) :
    ρ.character g ∈ cyclotomicOrder η := by
  classical
  have hcard_ne : Nat.card G ≠ 0 := (Nat.card_pos (α := G)).ne'
  let N := orderOf g
  have hN : N ≠ 0 := Nat.ne_of_gt (orderOf_pos g)
  have hNcard : N ∣ Nat.card G := by
    simpa [N] using orderOf_dvd_natCard g
  have hpow : (ρ g) ^ N = 1 := by
    subst N
    rw [← MonoidHom.map_pow, pow_orderOf_eq_one, MonoidHom.map_one]
  simpa [Representation.character] using
    finite_order_end_trace_mem_cyclotomicOrder (η := η) (N := N) (M := Nat.card G)
      hη hcard_ne hNcard (f := ρ g) hN hpow


/-- A map commuting with `f` preserves each eigenspace of `f`. -/
public lemma eigenspace_mapsTo_of_commute
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {f T : Module.End ℂ V} (hcomm : f * T = T * f) (μ : f.Eigenvalues) :
    Set.MapsTo T (f.eigenspace (μ : ℂ)) (f.eigenspace (μ : ℂ)) := by
  intro v hv
  apply (Module.End.mem_eigenspace_iff).2
  have hv' : f v = (μ : ℂ) • v := (Module.End.mem_eigenspace_iff).1 hv
  calc
    f (T v) = (f * T) v := rfl
    _ = (T * f) v := by rw [hcomm]
    _ = T (f v) := rfl
    _ = T ((μ : ℂ) • v) := by rw [hv']
    _ = (μ : ℂ) • T v := by simp

/-- If `T` commutes with `f`, then `f * T` also preserves each eigenspace of `f`. -/
public lemma mul_mapsTo_eigenspace_of_commute
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {f T : Module.End ℂ V} (hcomm : f * T = T * f) (μ : f.Eigenvalues) :
    Set.MapsTo (f * T) (f.eigenspace (μ : ℂ)) (f.eigenspace (μ : ℂ)) := by
  intro v hv
  let hmapT := eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ
  have hTv : T v ∈ f.eigenspace (μ : ℂ) := hmapT hv
  have hmul : (f * T) v = (μ : ℂ) • T v := by
    calc
      (f * T) v = f (T v) := rfl
      _ = (μ : ℂ) • T v := (Module.End.mem_eigenspace_iff).1 hTv
  rw [hmul]
  exact (f.eigenspace (μ : ℂ)).smul_mem (μ : ℂ) hTv

/-- Restricting a finite-order endomorphism to an invariant eigenspace preserves its order. -/
public lemma restrict_pow_eq_one
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {f T : Module.End ℂ V} {μ : f.Eigenvalues}
    (hmapT : Set.MapsTo T (f.eigenspace (μ : ℂ)) (f.eigenspace (μ : ℂ)))
    {N : ℕ} (hTpow : T ^ N = 1) :
    (T.restrict hmapT) ^ N = (1 : Module.End ℂ (f.eigenspace (μ : ℂ))) := by
  calc
    (T.restrict hmapT) ^ N =
        (T ^ N).restrict (Module.End.pow_apply_mem_of_forall_mem N hmapT) := by
      exact Module.End.pow_restrict N hmapT
    _ = 1 := by
      ext v
      simp [hTpow]

/-- Trace decomposition of a commuting map along the eigenspaces of a finite-order map. -/
public lemma trace_eq_sum_trace_restrict_eigenspaces_of_commute
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {f T : Module.End ℂ V} {p : ℕ} (hp : p ≠ 0) (hf : f ^ p = 1)
    (hcomm : f * T = T * f) :
    LinearMap.trace ℂ V T =
      ∑ μ : f.Eigenvalues,
        LinearMap.trace ℂ (f.eigenspace (μ : ℂ))
          (T.restrict (eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ)) := by
  classical
  let Nsub : f.Eigenvalues → Submodule ℂ V := fun μ => f.eigenspace (μ : ℂ)
  have hsemi : f.IsSemisimple := end_isSemisimple_of_pow_eq_one f hp hf
  have hindep : iSupIndep Nsub := by
    change iSupIndep (f.eigenspace ∘ (fun μ : f.Eigenvalues => (μ : ℂ)))
    exact f.eigenspaces_iSupIndep.comp Subtype.coe_injective
  have htop : iSup Nsub = ⊤ := by
    simpa [Nsub] using eigenspace_iSup_eq_top_over_eigenvalues (f := f) hsemi
  have hds : DirectSum.IsInternal Nsub :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hindep htop
  have hmapT : ∀ μ : f.Eigenvalues, Set.MapsTo T (Nsub μ) (Nsub μ) := by
    intro μ
    exact eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ
  simpa [Nsub] using LinearMap.trace_eq_sum_trace_restrict hds hmapT

/--
Trace decomposition of `f * T` along the eigenspaces of `f`, when `T`
commutes with the finite-order map `f`.
-/
public lemma trace_mul_eq_sum_eigen_mul_trace_restrict
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {f T : Module.End ℂ V} {p : ℕ} (hp : p ≠ 0) (hf : f ^ p = 1)
    (hcomm : f * T = T * f) :
    LinearMap.trace ℂ V (f * T) =
      ∑ μ : f.Eigenvalues, (μ : ℂ) *
        LinearMap.trace ℂ (f.eigenspace (μ : ℂ))
          (T.restrict (eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ)) := by
  classical
  let Nsub : f.Eigenvalues → Submodule ℂ V := fun μ => f.eigenspace (μ : ℂ)
  have hsemi : f.IsSemisimple := end_isSemisimple_of_pow_eq_one f hp hf
  have hindep : iSupIndep Nsub := by
    change iSupIndep (f.eigenspace ∘ (fun μ : f.Eigenvalues => (μ : ℂ)))
    exact f.eigenspaces_iSupIndep.comp Subtype.coe_injective
  have htop : iSup Nsub = ⊤ := by
    simpa [Nsub] using eigenspace_iSup_eq_top_over_eigenvalues (f := f) hsemi
  have hds : DirectSum.IsInternal Nsub :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hindep htop
  have hmapT : ∀ μ : f.Eigenvalues, Set.MapsTo T (Nsub μ) (Nsub μ) := by
    intro μ
    exact eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ
  have hmapfT : ∀ μ : f.Eigenvalues, Set.MapsTo (f * T) (Nsub μ) (Nsub μ) := by
    intro μ
    exact mul_mapsTo_eigenspace_of_commute (f := f) (T := T) hcomm μ
  calc
    LinearMap.trace ℂ V (f * T)
        = ∑ μ : f.Eigenvalues,
            LinearMap.trace ℂ (Nsub μ) ((f * T).restrict (hmapfT μ)) := by
          simpa [Nsub] using LinearMap.trace_eq_sum_trace_restrict hds hmapfT
    _ = ∑ μ : f.Eigenvalues, (μ : ℂ) *
        LinearMap.trace ℂ (f.eigenspace (μ : ℂ))
          (T.restrict (eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ)) := by
      refine Finset.sum_congr rfl ?_
      intro μ _
      have hrestrict :
          ((f * T).restrict (hmapfT μ)) =
            ((μ : ℂ) • (T.restrict (hmapT μ)) : Module.End ℂ (Nsub μ)) := by
        ext v
        simp only [LinearMap.smul_apply]
        have hTv : T v ∈ f.eigenspace (μ : ℂ) := hmapT μ v.2
        exact (Module.End.mem_eigenspace_iff).1 hTv
      rw [hrestrict]
      simp [Nsub, smul_eq_mul]

/--
For commuting finite-order endomorphisms, the trace of `f * T` belongs to the
same cyclotomic order as the trace of `T`, provided the eigenvalues of `f` are
powers of `ξ` and the traces on the eigenspaces of `f` lie in `ℤ[η]`.
-/
public lemma finite_order_commuting_trace_mul_mem_cyclotomicOrder
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {η ξ : ℂ} {p N M : ℕ}
    (hξ : IsPrimitiveRoot ξ p) (hp : p ≠ 0)
    (hη : IsPrimitiveRoot η M) (hM : M ≠ 0) (hNM : N ∣ M)
    (hξη : ξ ∈ cyclotomicOrder η)
    {f T : Module.End ℂ V} (hN : N ≠ 0)
    (hf : f ^ p = 1) (hTpow : T ^ N = 1) (hcomm : f * T = T * f) :
    LinearMap.trace ℂ V (f * T) ∈ cyclotomicOrder η := by
  classical
  let A := cyclotomicOrder η
  rw [trace_mul_eq_sum_eigen_mul_trace_restrict (f := f) (T := T) hp hf hcomm]
  refine A.sum_mem fun μ _ => ?_
  have hμp : (μ : ℂ) ^ p = 1 := eigenvalue_pow_eq_one_of_pow_eq_one hf μ.property
  have : NeZero p := ⟨hp⟩
  obtain ⟨i, _hi_lt, hi⟩ := hξ.eq_pow_of_pow_eq_one hμp
  have hμ_mem : (μ : ℂ) ∈ A := by
    rw [← hi]
    exact A.pow_mem hξη i
  let hmapT := eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ
  have hTμpow : (T.restrict hmapT) ^ N =
      (1 : Module.End ℂ (f.eigenspace (μ : ℂ))) :=
    restrict_pow_eq_one (f := f) (T := T) (μ := μ) hmapT hTpow
  have ht_mem : LinearMap.trace ℂ (f.eigenspace (μ : ℂ)) (T.restrict hmapT) ∈ A :=
    finite_order_end_trace_mem_cyclotomicOrder (η := η) (N := N) (M := M)
      hη hM hNM (f := T.restrict hmapT) hN hTμpow
  exact A.mul_mem hμ_mem ht_mem

/--
Linear-algebra core of Peterfalvi (1.10)(a): if `f` and `T` commute, `f^p=1`,
`T^N=1`, and `ξ` is a primitive `p`-th root in `ℤ[η]`, then
`tr(fT) ≡ tr(T) (mod 1 - ξ)` in `ℤ[η]`.
-/
public theorem finite_order_commuting_trace_mul_congruent
    {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {η ξ : ℂ} {p N M : ℕ}
    (hξ : IsPrimitiveRoot ξ p) (hp : p ≠ 0)
    (hη : IsPrimitiveRoot η M) (hM : M ≠ 0) (hNM : N ∣ M)
    (hξη : ξ ∈ cyclotomicOrder η)
    {f T : Module.End ℂ V} (hN : N ≠ 0)
    (hf : f ^ p = 1) (hTpow : T ^ N = 1) (hcomm : f * T = T * f) :
    ∃ hmul : LinearMap.trace ℂ V (f * T) ∈ cyclotomicOrder η,
      ∃ hTmem : LinearMap.trace ℂ V T ∈ cyclotomicOrder η,
        CongruentModOneSub η ξ
          (LinearMap.trace ℂ V (f * T)) (LinearMap.trace ℂ V T)
          hξη hmul hTmem := by
  classical
  let A := cyclotomicOrder η
  let hmul : LinearMap.trace ℂ V (f * T) ∈ A :=
    finite_order_commuting_trace_mul_mem_cyclotomicOrder
      (η := η) (ξ := ξ) (p := p) (N := N) (M := M)
      hξ hp hη hM hNM hξη (f := f) (T := T) hN hf hTpow hcomm
  let hTmem : LinearMap.trace ℂ V T ∈ A :=
    finite_order_end_trace_mem_cyclotomicOrder (η := η) (N := N) (M := M)
      hη hM hNM (f := T) hN hTpow
  refine ⟨hmul, hTmem, ?_⟩
  let oneSub : A := ⟨1 - ξ, A.sub_mem A.one_mem hξη⟩
  change congruentModIn A oneSub
    (⟨LinearMap.trace ℂ V (f * T), hmul⟩ : A)
    (⟨LinearMap.trace ℂ V T, hTmem⟩ : A)
  let hmapT : ∀ μ : f.Eigenvalues,
      Set.MapsTo T (f.eigenspace (μ : ℂ)) (f.eigenspace (μ : ℂ)) :=
    fun μ => eigenspace_mapsTo_of_commute (f := f) (T := T) hcomm μ
  let t : f.Eigenvalues → ℂ := fun μ =>
    LinearMap.trace ℂ (f.eigenspace (μ : ℂ)) (T.restrict (hmapT μ))
  have ht_mem : ∀ μ, t μ ∈ A := by
    intro μ
    have hTμpow : (T.restrict (hmapT μ)) ^ N =
        (1 : Module.End ℂ (f.eigenspace (μ : ℂ))) :=
      restrict_pow_eq_one (f := f) (T := T) (μ := μ) (hmapT μ) hTpow
    exact finite_order_end_trace_mem_cyclotomicOrder (η := η) (N := N) (M := M)
      hη hM hNM (f := T.restrict (hmapT μ)) hN hTμpow
  let zterm : f.Eigenvalues → A := fun μ =>
    ⟨(μ : ℂ) * t μ, by
      have hμp : (μ : ℂ) ^ p = 1 := eigenvalue_pow_eq_one_of_pow_eq_one hf μ.property
      have : NeZero p := ⟨hp⟩
      obtain ⟨i, _hi_lt, hi⟩ := hξ.eq_pow_of_pow_eq_one hμp
      have hμ_mem : (μ : ℂ) ∈ A := by
        rw [← hi]
        exact A.pow_mem hξη i
      exact A.mul_mem hμ_mem (ht_mem μ)⟩
  let wterm : f.Eigenvalues → A := fun μ => ⟨t μ, ht_mem μ⟩
  unfold congruentModIn
  have hdiff :
      (⟨LinearMap.trace ℂ V (f * T), hmul⟩ : A) - ⟨LinearMap.trace ℂ V T, hTmem⟩ =
        ∑ μ : f.Eigenvalues, (zterm μ - wterm μ) := by
    ext
    change LinearMap.trace ℂ V (f * T) - LinearMap.trace ℂ V T =
      ((∑ μ : f.Eigenvalues, (zterm μ - wterm μ) : A) : ℂ)
    calc
      LinearMap.trace ℂ V (f * T) - LinearMap.trace ℂ V T =
          (∑ μ : f.Eigenvalues, (μ : ℂ) * t μ) - ∑ μ : f.Eigenvalues, t μ := by
            rw [trace_mul_eq_sum_eigen_mul_trace_restrict
              (f := f) (T := T) hp hf hcomm,
              trace_eq_sum_trace_restrict_eigenspaces_of_commute
              (f := f) (T := T) hp hf hcomm]
      _ = ∑ μ : f.Eigenvalues, ((μ : ℂ) * t μ - t μ) := by
            rw [Finset.sum_sub_distrib]
      _ = ((∑ μ : f.Eigenvalues, (zterm μ - wterm μ) : A) : ℂ) := by
            simp [zterm, wterm]
  rw [hdiff]
  refine Ideal.sum_mem _ fun μ _ => ?_
  have hμp : (μ : ℂ) ^ p = 1 := eigenvalue_pow_eq_one_of_pow_eq_one hf μ.property
  have : NeZero p := ⟨hp⟩
  obtain ⟨i, _hi_lt, hi⟩ := hξ.eq_pow_of_pow_eq_one hμp
  have hbase := pow_mul_congruent_right_mod_one_sub
    (η := η) (ξ := ξ) (y := t μ) hξη (ht_mem μ) i
  change congruentModIn A
    (⟨1 - ξ, A.sub_mem A.one_mem hξη⟩ : A)
    (⟨ξ ^ i * t μ, A.mul_mem (A.pow_mem hξη i) (ht_mem μ)⟩ : A)
    (⟨t μ, ht_mem μ⟩ : A) at hbase
  change congruentModIn A oneSub (zterm μ) (wterm μ)
  simpa [zterm, wterm, t, hi] using hbase

/-! ## Virtual characters as integer combinations of representation characters -/

/--
A finite integer linear combination of finite-dimensional representation
characters, with all representation spaces encoded as standard spaces
`Fin n → ℂ`.
-/
@[expose] public noncomputable def virtualCharacterOfRepresentations
    {G : Type*} [Group G] (r : ℕ) (m : Fin r → ℤ) (n : Fin r → ℕ)
    (ρ : (i : Fin r) → Representation ℂ G (Fin (n i) → ℂ)) : G → ℂ :=
  fun g => ∑ i : Fin r, (m i : ℂ) * (ρ i).character g

/--
An unbundled virtual character: an integer linear combination of ordinary
finite-dimensional representation characters.  Over `ℂ` this is equivalent to
the usual integer span of irreducible characters, but this form avoids any
category-theoretic representation API.
-/
@[expose] public def IsVirtualCharacter {G : Type*} [Group G] (χ : G → ℂ) : Prop :=
  ∃ r : ℕ, ∃ m : Fin r → ℤ, ∃ n : Fin r → ℕ,
    ∃ ρ : (i : Fin r) → Representation ℂ G (Fin (n i) → ℂ),
      χ = virtualCharacterOfRepresentations r m n ρ

/--
Values of a virtual character of a finite group lie in the cyclotomic order
generated by a primitive `|G|`-th root.
-/
public lemma virtualCharacter_mem_cyclotomicOrder
    {G : Type*} [Group G] [Finite G]
    {χ : G → ℂ} (hχ : IsVirtualCharacter χ)
    {η : ℂ} (hη : IsPrimitiveRoot η (Nat.card G)) (g : G) :
    χ g ∈ cyclotomicOrder η := by
  classical
  rcases hχ with ⟨r, m, n, ρ, hχeq⟩
  rw [hχeq]
  exact (cyclotomicOrder η).sum_mem fun i _ =>
    (cyclotomicOrder η).mul_mem
      (intCast_mem_cyclotomicOrder η (m i))
      (representation_character_mem_cyclotomicOrder hη (ρ i) g)

/--
Representation-character form of Peterfalvi (1.10)(a): for a commuting pair
`x,y`, with `x` of order `p`, the character value at `xy` is congruent to the
value at `y` modulo `1 - ξ`.
-/
public theorem representation_character_congruent_at_mul
    {G V : Type*} [Group G] [Finite G]
    [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {p : ℕ} {η ξ : ℂ} (hξ : IsPrimitiveRoot ξ p) (hp : p ≠ 0)
    (hη : IsPrimitiveRoot η (Nat.card G)) (hξη : ξ ∈ cyclotomicOrder η)
    (ρ : Representation ℂ G V) {x y : G}
    (hx_order : orderOf x = p) (hcomm : x * y = y * x) :
    ∃ hxy : ρ.character (x * y) ∈ cyclotomicOrder η,
      ∃ hy : ρ.character y ∈ cyclotomicOrder η,
        CongruentModOneSub η ξ (ρ.character (x * y)) (ρ.character y) hξη hxy hy := by
  classical
  let N := orderOf y
  have hN : N ≠ 0 := Nat.ne_of_gt (orderOf_pos y)
  have hNcard : N ∣ Nat.card G := by
    simpa [N] using orderOf_dvd_natCard y
  have hxpow : x ^ p = 1 := by
    rw [← hx_order]
    exact pow_orderOf_eq_one x
  have hf : (ρ x) ^ p = 1 := by
    rw [← MonoidHom.map_pow, hxpow, MonoidHom.map_one]
  have hTpow : (ρ y) ^ N = 1 := by
    subst N
    rw [← MonoidHom.map_pow, pow_orderOf_eq_one, MonoidHom.map_one]
  have hcommEnd : ρ x * ρ y = ρ y * ρ x := by
    calc
      ρ x * ρ y = ρ (x * y) := (map_mul ρ x y).symm
      _ = ρ (y * x) := by rw [hcomm]
      _ = ρ y * ρ x := map_mul ρ y x
  rcases finite_order_commuting_trace_mul_congruent
      (η := η) (ξ := ξ) (p := p) (N := N) (M := Nat.card G)
      hξ hp hη (Nat.card_pos (α := G)).ne' hNcard hξη
      (f := ρ x) (T := ρ y) hN hf hTpow hcommEnd with
    ⟨hmul, hy, hcong⟩
  have hxy : ρ.character (x * y) ∈ cyclotomicOrder η := by
    simpa [Representation.character, map_mul] using hmul
  refine ⟨hxy, hy, ?_⟩
  simpa [CongruentModOneSub, Representation.character, map_mul] using hcong

/--
Virtual-character form of Peterfalvi (1.10)(a): integer linearity extends the
representation-character congruence to every virtual character.
-/
public theorem virtualCharacter_congruent_at_mul
    {G : Type*} [Group G] [Finite G]
    {p : ℕ} {η ξ : ℂ} (hξ : IsPrimitiveRoot ξ p) (hp : p ≠ 0)
    (hη : IsPrimitiveRoot η (Nat.card G)) (hξη : ξ ∈ cyclotomicOrder η)
    {χ : G → ℂ} (hχ : IsVirtualCharacter χ) {x y : G}
    (hx_order : orderOf x = p) (hcomm : x * y = y * x) :
    ∃ hxy : χ (x * y) ∈ cyclotomicOrder η,
      ∃ hy : χ y ∈ cyclotomicOrder η,
        CongruentModOneSub η ξ (χ (x * y)) (χ y) hξη hxy hy := by
  classical
  rcases hχ with ⟨r, m, n, ρ, hχeq⟩
  let A := cyclotomicOrder η
  have hrep : ∀ i : Fin r,
      ∃ hxy : (ρ i).character (x * y) ∈ A,
        ∃ hy : (ρ i).character y ∈ A,
          CongruentModOneSub η ξ ((ρ i).character (x * y)) ((ρ i).character y)
            hξη hxy hy := by
    intro i
    exact representation_character_congruent_at_mul
      (η := η) (ξ := ξ) hξ hp hη hξη (ρ i) hx_order hcomm
  choose hxyi hyi hcongi using hrep
  have hxy_mem : χ (x * y) ∈ A := by
    rw [hχeq]
    exact A.sum_mem fun i _ => A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hxyi i)
  have hy_mem : χ y ∈ A := by
    rw [hχeq]
    exact A.sum_mem fun i _ => A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hyi i)
  refine ⟨hxy_mem, hy_mem, ?_⟩
  let oneSub : A := ⟨1 - ξ, A.sub_mem A.one_mem hξη⟩
  change congruentModIn A oneSub ⟨χ (x * y), hxy_mem⟩ ⟨χ y, hy_mem⟩
  let zterm : Fin r → A := fun i =>
    ⟨(m i : ℂ) * (ρ i).character (x * y),
      A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hxyi i)⟩
  let wterm : Fin r → A := fun i =>
    ⟨(m i : ℂ) * (ρ i).character y,
      A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hyi i)⟩
  unfold congruentModIn
  have hdiff :
      (⟨χ (x * y), hxy_mem⟩ : A) - ⟨χ y, hy_mem⟩ =
        ∑ i : Fin r, (zterm i - wterm i) := by
    ext
    change χ (x * y) - χ y = ((∑ i : Fin r, (zterm i - wterm i) : A) : ℂ)
    rw [hχeq]
    simp [virtualCharacterOfRepresentations, zterm, wterm, Finset.sum_sub_distrib]
  rw [hdiff]
  refine Ideal.sum_mem _ fun i _ => ?_
  have hci : congruentModIn A oneSub
      (⟨(ρ i).character (x * y), hxyi i⟩ : A)
      (⟨(ρ i).character y, hyi i⟩ : A) := by
    simpa [CongruentModOneSub, oneSub] using hcongi i
  change congruentModIn A oneSub (zterm i) (wterm i)
  have hmul := congruentModIn_mul_left hci
    (⟨(m i : ℂ), intCast_mem_cyclotomicOrder η (m i)⟩ : A)
  simpa [zterm, wterm] using hmul

end CFSG.Theory.Character
