module

public import Mathlib.Data.Set.Card.Arithmetic
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.BGsection13.lemma_13_13
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.BGsection3.Remaining

namespace CFSG
end CFSG
open CFSG

open scoped Pointwise

/-!
# Definitions from BG Section 14

This file records a statement-only scaffold for Section 14 of
`Local Analysis for the Odd Order Theorem`.
-/

section Notation

variable {G : Type*} [Group G] [Finite G]

/-- The set `κ(M)` from Section 14. -/
@[expose] public def CFSG.section14KappaPrimes (M : Subgroup G) : Set Nat.Primes :=
  {p | p ∈ section12Tau1Primes M ∪ section12Tau3Primes M ∧
      ∃ P : Subgroup G, P ∈ section10PrimeOrderSubgroupsIn p M ∧
        subgroupCentralizerIn (section10Msigma M) P ≠ ⊥}

/-- The family `𝓜_F` of maximal subgroups with empty `κ(M)`. -/
@[expose] public def CFSG.section14MFamilyF (G : Type*) [Group G] [Finite G] :
    Set (Subgroup G) :=
  {M | M ∈ section9MaximalSubgroups G ∧ section14KappaPrimes M = ∅}

/-- The family `𝓜_P` of maximal subgroups with nonempty `κ(M)`. -/
@[expose] public def CFSG.section14MFamilyP (G : Type*) [Group G] [Finite G] :
    Set (Subgroup G) :=
  {M | M ∈ section9MaximalSubgroups G ∧ (section14KappaPrimes M).Nonempty}

/-- The family `𝓜_{P₁}`. -/
@[expose] public def CFSG.section14MFamilyP1 (G : Type*) [Group G] [Finite G] :
    Set (Subgroup G) :=
  {M | M ∈ section14MFamilyP G ∧
      section14KappaPrimes M = subgroupPrimeSet M \ section10SigmaPrimes M}

/-- The family `𝓜_{P₂}`. -/
@[expose] public def CFSG.section14MFamilyP2 (G : Type*) [Group G] [Finite G] :
    Set (Subgroup G) :=
  {M | M ∈ section14MFamilyP G ∧
      section14KappaPrimes M ≠ subgroupPrimeSet M \ section10SigmaPrimes M}

/-- The family `𝓜_σ(X) = {M ∈ 𝓜 | X ⊆ M_σ}` for a subset `X` of `G`. -/
@[expose] public def CFSG.section14MsigmaFamily (X : Set G) :
    Set (Subgroup G) :=
  {M | M ∈ section9MaximalSubgroups G ∧ X ⊆ (section10Msigma M : Set G)}

/-- The family `𝓜_σ(g) = 𝓜_σ({g})`. -/
@[expose] public def CFSG.section14MsigmaElement (g : G) :
    Set (Subgroup G) :=
  section14MsigmaFamily ({g} : Set G)

/-- The prime support of the cyclic subgroup generated by an element. -/
@[expose] public def CFSG.section14ElementPrimeSupport (g : G) : Set Nat.Primes :=
  subgroupPrimeSet (Subgroup.zpowers g)

/-- The `σ`-blocks `σ(M)` attached to conjugacy-class representatives of `𝓜`. -/
@[expose] public def CFSG.section14SigmaBlocks (G : Type*) [Group G] [Finite G] :
    Set (Set Nat.Primes) :=
  {π | ∃ M : Subgroup G, M ∈ section9MaximalSubgroups G ∧ π = section10SigmaPrimes M}

/-- The `σ`-blocks meeting the prime support of an element. -/
@[expose] public def CFSG.section14SigmaSupport (g : G) : Set (Set Nat.Primes) :=
  {π | π ∈ section14SigmaBlocks G ∧ (section14ElementPrimeSupport g ∩ π).Nonempty}

/-- The `σ`-length used in Section 14: the number of `σ`-blocks in the
prime support of `g`. -/
@[expose] public noncomputable def CFSG.section14SigmaLength (g : G) : ℕ :=
  Nat.card (section14SigmaSupport g)

/-- An element is a `π`-element if its cyclic subgroup has prime support contained in `π`. -/
@[expose] public def CFSG.section14IsPiElement (π : Set Nat.Primes) (g : G) : Prop :=
  section14ElementPrimeSupport g ⊆ π

/-- `X` acts in a prime manner on `R`, in the Section 13 sense. -/
@[expose] public def CFSG.section14ActsInPrimeManner
    (X R : Subgroup G) : Prop :=
  X ≤ Subgroup.normalizer (R : Set G) ∧
    ∀ P : Subgroup G, P ∈ section12PrimeOrderSubgroups X →
      subgroupCentralizerIn R P ≤ subgroupCentralizerIn R X

/-- `X` acts regularly on `R`. -/
@[expose] public def CFSG.section14ActsRegularlyOn
    (X R : Subgroup G) : Prop :=
  X ≤ Subgroup.normalizer (R : Set G) ∧
    ∀ x : G, x ∈ X → x ≠ 1 → elementCentralizerIn R x = ⊥

/-- `N` is a normal complement of `K` in `H`. -/
@[expose] public def CFSG.section14NormalComplementIn
    (H K N : Subgroup G) : Prop :=
  section12ComplementIn H K N ∧ section10NormalIn N H

/-- `R` is a normal Hall subgroup of `H`. -/
@[expose] public def CFSG.section14NormalHallIn
    (R H : Subgroup G) : Prop :=
  ∃ _hRH : R ≤ H, section10NormalIn R H ∧
    ∃ π : Set Nat.Primes, IsHallSubgroup π (R.subgroupOf H)

/-- Conjugation by `K` acts sharply transitively on a family of subgroups. -/
@[expose] public def CFSG.section14SharpTransitiveOn
    (K : Subgroup G) (Ω : Set (Subgroup G)) : Prop :=
  ∀ Q₁ : Subgroup G, Q₁ ∈ Ω → ∀ Q₂ : Subgroup G, Q₂ ∈ Ω →
    ∃! k : K, Q₂ = Q₁.conjBy (k : G)

/-- Conjugation of a set by an element. -/
@[expose] public def CFSG.section14SetConjBy (X : Set G) (g : G) : Set G :=
  {x | ∃ y ∈ X, x = g⁻¹ * y * g}

/-- A `TI`-subset of `G`. -/
@[expose] public def CFSG.section14TISet (X : Set G) : Prop :=
  X.Nonempty ∧
    ∀ g : G, g ∉ Subgroup.normalizer X →
      X ∩ section14SetConjBy X g ⊆ ({1} : Set G)

/-- A `TI`-subgroup of `G`. -/
@[expose] public def CFSG.section14TISubgroup (H : Subgroup G) : Prop :=
  H ≠ ⊥ ∧ H ≠ ⊤ ∧ section14TISet (H : Set G)

/-- The conjugacy closure `𝓒_G(T) = {t^g | t ∈ T, g ∈ G}`. -/
@[expose] public def CFSG.section14ConjugacyClosure (T : Set G) : Set G :=
  {x | ∃ t ∈ T, ∃ g : G, x = g⁻¹ * t * g}

/-- The right coset `xR` as a set. -/
@[expose] public def CFSG.section14ElementCoset (x : G) (R : Subgroup G) : Set G :=
  {g | ∃ r ∈ R, g = x * r}

/-- Two ambient subgroups are conjugate in `G`. -/
@[expose] public def CFSG.section14ConjugateSubgroups
    (H K : Subgroup G) : Prop :=
  ∃ g : G, H = K.conjBy g

/-- A finite list of representatives of the conjugacy classes in `𝓜`. -/
@[expose] public def CFSG.section14ConjugacyClassRepresentatives
    {n : ℕ} (Ms : Fin n → Subgroup G) : Prop :=
  (∀ i : Fin n, Ms i ∈ section9MaximalSubgroups G) ∧
    ∀ H : Subgroup G, H ∈ section9MaximalSubgroups G →
      ∃! i : Fin n, section14ConjugateSubgroups H (Ms i)

/-- `K* = C_{M_σ}(K)`. -/
@[expose] public def CFSG.section14KStar (M K : Subgroup G) : Subgroup G :=
  subgroupCentralizerIn (section10Msigma M) K

/-- The underlying subgroup denoted `Z = K × K*` in Theorem 14.7.  The
direct-product assertion itself is recorded separately in the theorem statements. -/
@[expose] public def CFSG.section14Z (M K : Subgroup G) : Subgroup G :=
  K ⊔ section14KStar M K

/-- The assertion that `Z = K × K*` as an internal direct product. -/
@[expose] public def CFSG.section14ZInternalDirectProduct (M K : Subgroup G) : Prop :=
  section12InternalDirectProduct K (section14KStar M K) (section14Z M K)

/-- The set `Ẑ = Z - (K ∪ K*)`. -/
@[expose] public def CFSG.section14WidehatZ (M K : Subgroup G) : Set G :=
  (section14Z M K : Set G) \
    ((K : Set G) ∪ (section14KStar M K : Set G))

/-- `M` is a Frobenius group with kernel `K`. -/
@[expose] public def CFSG.section14FrobeniusWithKernel
    (M K : Subgroup G) : Prop :=
  ∃ _hKM : K ≤ M, ∃ E : Subgroup M,
    IsFrobeniusGroupWithKernelComplement (K.subgroupOf M) E

/-- The data asserted in Proposition 14.2(a) for the subgroup `U`. -/
@[expose] public def CFSG.section14Proposition14_2AData
    (M K U : Subgroup G) : Prop :=
  section14ActsInPrimeManner K (section10Msigma M) ∧
    IsMulCommutative U ∧
    section12HallSubgroupIn
      ((section14KappaPrimes M ∪ section10SigmaPrimes M)ᶜ) U M ∧
    section14ActsRegularlyOn K U ∧
    section14NormalComplementIn M K (U ⊔ section10Msigma M)

/-- The parts (a)-(f) of Theorem 14.4 for fixed `x`, `R`, `N`, and `M`. -/
@[expose] public def CFSG.section14Theorem14_4NData
    (x : G) (R N M : Subgroup G) : Prop :=
  R = elementCentralizerIn (section10Msigma N) x ∧
    R ≠ ⊥ ∧
    ((Subgroup.centralizer ({x} : Set G) : Subgroup G) : Set G) =
      (elementCentralizerIn (M ⊓ N) x : Set G) * (R : Set G) ∧
    section14ElementPrimeSupport x ⊆ section12Tau2Primes N ∧
    section12Tau2Primes N ⊆ section10SigmaPrimes M ∧
    subgroupPrimeSet M ∩ section10SigmaPrimes N ⊆ section10BetaPrimes N ∧
    section12ComplementIn N (section10Msigma N) (M ⊓ N) ∧
    N ∈ section14MFamilyF G ∪ section14MFamilyP2 G

/-- The common `M*` data asserted in Theorem 14.7. -/
@[expose] public def CFSG.section14Theorem14_7Data
    (M K Mstar : Subgroup G) : Prop :=
  Mstar ∈ section14MFamilyP G ∧
    ¬ section14ConjugateSubgroups Mstar M ∧
    (∀ X : Subgroup G, X ∈ section12PrimeOrderSubgroups K →
      section9MaximalSubgroupsContaining (Subgroup.centralizer (X : Set G)) = {Mstar}) ∧
    section12HallSubgroupIn (section14KappaPrimes Mstar) (section14KStar M K) Mstar ∧
    section12HallSubgroupIn (section10SigmaPrimes M) (section14KStar M K) Mstar ∧
    K = section14KStar Mstar (section14KStar M K) ∧
    section14KappaPrimes M = section12Tau1Primes M ∧
    section14ZInternalDirectProduct M K ∧
    IsCyclic (section14Z M K) ∧
    (∀ x y : G, x ∈ K → x ≠ 1 → y ∈ section14KStar M K → y ≠ 1 →
      M ⊓ Mstar = section14Z M K ∧
        elementCentralizerIn M x = section14Z M K ∧
        elementCentralizerIn Mstar y = section14Z M K ∧
        Subgroup.centralizer ({x * y} : Set G) = section14Z M K) ∧
    section14TISet (section14WidehatZ M K) ∧
    Subgroup.normalizer (section14WidehatZ M K) = section14Z M K ∧
    (∀ g : G, g ∉ M →
      section14WidehatZ M K ∩ (M.conjBy g : Set G) = ∅) ∧
    ((Nat.card (section14ConjugacyClosure (section14WidehatZ M K)) : ℚ) =
      (1 - (1 : ℚ) / (Nat.card K : ℚ) -
          (1 : ℚ) / (Nat.card (section14KStar M K) : ℚ) +
          (1 : ℚ) / ((Nat.card K : ℚ) *
            (Nat.card (section14KStar M K) : ℚ))) * (Nat.card G : ℚ)) ∧
    ((Nat.card G : ℚ) / 2 <
      (Nat.card (section14ConjugacyClosure (section14WidehatZ M K)) : ℚ)) ∧
    ((M ∈ section14MFamilyP2 G ∧ Nat.Prime (Nat.card K)) ∨
      (Mstar ∈ section14MFamilyP2 G ∧
        Nat.Prime (Nat.card (section14KStar M K)))) ∧
    (∀ H : Subgroup G, H ∈ section14MFamilyP G →
      section14ConjugateSubgroups H M ∨ section14ConjugateSubgroups H Mstar) ∧
    section12ComplementIn M K (ambientDerivedSubgroup M)

/-- The additional data in the last sentence of Lemma 14.11. -/
@[expose] public def CFSG.section14Theorem12_7Corollary12_9Situation
    (M E Q Mstar : Subgroup G) (q : Nat.Primes) : Prop :=
  ∃ p : Nat.Primes, ∃ A A₀ A₁ : Subgroup G,
    p ∈ section12Tau2Primes M ∧
      A ∈ section12RankTwoElementaryAbelianIn p E ∧
      q ∈ section12Tau1Primes M ∧
      Q ∈ section10PrimeOrderSubgroupsIn q E ∧
      subgroupCentralizerIn (section10Msigma M) Q = ⊥ ∧
      q ∈ section12QuotientPrimeSet (subgroupCentralizerIn E A) E ∧
      A₀ = ⁅A, Q⁆ ∧
      A₀ = subgroupCentralizerIn A (section10Msigma M) ∧
      A₀ ∈ section10PrimeOrderSubgroupsIn p A ∧
      section10NormalIn A₀ M ∧
      ¬ section14ConjugateSubgroups A₀ A₁ ∧
      A₁ = subgroupCentralizerIn A Q ∧
      A₁ ∈ section10PrimeOrderSubgroupsIn p A ∧
      ¬ Subgroup.centralizer (A₁ : Set G) ≤ M ∧
      Mstar ∈ section9MaximalSubgroupsContaining (Subgroup.normalizer (A : Set G))

end Notation
