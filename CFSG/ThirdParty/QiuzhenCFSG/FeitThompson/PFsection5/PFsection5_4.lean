/-!
# Peterfalvi, Section 5, Theorem (5.4)

This file isolates PF `(5.4)` as its own proof target.
-/

noncomputable section

open scoped BigOperators

attribute [local instance] Fintype.ofFinite

namespace CFSG.Section5

universe v
universe u

/-! ## (5.4) -/

/--
Peterfalvi `(5.4)`: under Hypothesis `(5.2)`, if `T₁` is an isometry on the
lattice generated by `X - ψ` and `X - X̄` which agrees with `T` on the latter,
and if `(X - ψ)^{T₁}` splits as `Xbig - Y` with `Xbig ∈ Z[R(X)]` and `Y`
orthogonal to `R(X)`, then `‖Xbig‖² ≥ ‖X‖²`; if also `‖Y‖² ≥ ‖ψ‖²`, then
equality holds and `Xbig` is a subset-sum of `R(X)`.
-/
@[expose] public def theorem_5_4_statement
    {L : Type u} [Group L] [Finite L]
    {G : Type u} [Group G] [Finite G]
    (S : Finset (Section1.ClassFunction L))
    (T : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G)
    (R : S → Finset (Section1.ClassFunction G)) : Prop :=
  hypothesis_5_2_setup_statement S →
    hypothesis_5_2_a_statement S →
      hypothesis_5_2_b_statement S T →
        hypothesis_5_2_c_statement S →
          hypothesis_5_2_d_statement S T R →
            hypothesis_5_2_e_statement S R →
              ∀ X : S, ∀ ψ : Section1.ClassFunction L,
                integerSpan S ψ →
                  Section1.scalarProduct L (X : Section1.ClassFunction L) ψ = 0 →
                    Section1.scalarProduct L
                        (Section1.conjugateCharacter (X : Section1.ClassFunction L)) ψ = 0 →
                      ∀ T1 : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G,
                        isCFLinearIsometryOnSpan
                            ({(X : Section1.ClassFunction L) - ψ,
                              (X : Section1.ClassFunction L) -
                                Section1.conjugateCharacter
                                  (X : Section1.ClassFunction L)} :
                              Finset (Section1.ClassFunction L)) T1 →
                          mapsIntegerSpanToVirtualCharacters
                              ({(X : Section1.ClassFunction L) - ψ,
                                (X : Section1.ClassFunction L) -
                                  Section1.conjugateCharacter
                                    (X : Section1.ClassFunction L)} :
                                Finset (Section1.ClassFunction L)) T1 →
                            T1 ((X : Section1.ClassFunction L) -
                                  Section1.conjugateCharacter
                                    (X : Section1.ClassFunction L)) =
                              T ((X : Section1.ClassFunction L) -
                                  Section1.conjugateCharacter
                                    (X : Section1.ClassFunction L)) →
                              ∀ Xbig Y : Section1.ClassFunction G,
                                integerSpan (R X) Xbig →
                                  orthogonalToFinset (R X) Y →
                                    T1 ((X : Section1.ClassFunction L) - ψ) = Xbig - Y →
                                      cfNormSq Xbig ≥ cfNormSq (X : Section1.ClassFunction L) ∧
                                        (cfNormSq Y ≥ cfNormSq ψ →
                                          cfNormSq Xbig =
                                              cfNormSq (X : Section1.ClassFunction L) ∧
                                            cfNormSq Y = cfNormSq ψ ∧
                                              isSubsetSumOf (R X) Xbig)


private theorem scalarProduct_zero_swap_pf54
    {H : Type*} [Finite H]
    {φ ψ : Section1.ClassFunction H}
    (h : Section1.scalarProduct H φ ψ = 0) :
    Section1.scalarProduct H ψ φ = 0 := by
  simpa [Section1.scalarProduct_star_swap] using congrArg star h

private theorem scalarProduct_add_right_pf54
    {H : Type*} [Finite H]
    (φ ψ1 ψ2 : Section1.ClassFunction H) :
    Section1.scalarProduct H φ (ψ1 + ψ2) =
      Section1.scalarProduct H φ ψ1 + Section1.scalarProduct H φ ψ2 := by
  simp [Section1.scalarProduct, mul_add, Finset.sum_add_distrib]

private theorem scalarProduct_sub_right_pf54
    {H : Type*} [Finite H]
    (φ ψ1 ψ2 : Section1.ClassFunction H) :
    Section1.scalarProduct H φ (ψ1 - ψ2) =
      Section1.scalarProduct H φ ψ1 - Section1.scalarProduct H φ ψ2 := by
  calc
    Section1.scalarProduct H φ (ψ1 - ψ2)
        = Section1.scalarProduct H φ (ψ1 + (-1 : ℂ) • ψ2) := by
            congr 1
            ext g
            simp [sub_eq_add_neg]
    _ = Section1.scalarProduct H φ ψ1 +
          Section1.scalarProduct H φ ((-1 : ℂ) • ψ2) := by
            rw [scalarProduct_add_right_pf54]
    _ = Section1.scalarProduct H φ ψ1 - Section1.scalarProduct H φ ψ2 := by
          rw [Section1.scalarProduct_smul_right]
          simp [sub_eq_add_neg]

private theorem scalarProduct_sub_left_pf54
    {H : Type*} [Finite H]
    (φ1 φ2 ψ : Section1.ClassFunction H) :
    Section1.scalarProduct H (φ1 - φ2) ψ =
      Section1.scalarProduct H φ1 ψ - Section1.scalarProduct H φ2 ψ := by
  calc
    Section1.scalarProduct H (φ1 - φ2) ψ
        = Section1.scalarProduct H (φ1 + (-1 : ℂ) • φ2) ψ := by
            congr 1
            ext g
            simp [sub_eq_add_neg]
    _ = Section1.scalarProduct H φ1 ψ +
          Section1.scalarProduct H ((-1 : ℂ) • φ2) ψ := by
            rw [Section1.scalarProduct_add_left]
    _ = Section1.scalarProduct H φ1 ψ - Section1.scalarProduct H φ2 ψ := by
          rw [Section1.scalarProduct_smul_left]
          simp [sub_eq_add_neg]

private theorem scalarProduct_self_of_irreducibleCharacterOnGroup_pf54
    {G : Type*} [Group G] [Finite G]
    {χ : Section1.ClassFunction G}
    (hχ : Section1.IsIrreducibleCharacterOnGroup χ) :
    Section1.scalarProduct G χ χ = 1 := by
  rcases hχ with ⟨n, ρ, hρ, rfl⟩
  simpa using Section1.scalarProduct_representation_char_self ρ hρ

private theorem scalarProduct_self_of_signedIrreducible_pf54
    {G : Type*} [Group G] [Finite G]
    {χ : Section1.ClassFunction G}
    (hχ : Section3.IsSignedIrreducibleCharacter χ) :
    Section1.scalarProduct G χ χ = 1 := by
  rcases hχ with ⟨ε, hε, μ, hμ, rfl⟩
  have hμself : Section1.scalarProduct G μ μ = 1 :=
    scalarProduct_self_of_irreducibleCharacterOnGroup_pf54 hμ
  rcases hε with rfl | rfl
  · simp [hμself]
  · calc
      Section1.scalarProduct G ((-1 : ℂ) • μ) ((-1 : ℂ) • μ)
          = (-1 : ℂ) * (star (-1 : ℂ)) * Section1.scalarProduct G μ μ := by
              rw [Section1.scalarProduct_smul_left, Section1.scalarProduct_smul_right]
              ring
      _ = 1 := by simp [hμself]

private theorem scalarProduct_eq_ite_of_signedOrthonormalFinset_pf54
    {G : Type*} [Group G] [Finite G]
    {R : Finset (Section1.ClassFunction G)}
    (hR : signedOrthonormalFinset R) :
    ∀ a b : R, Section1.scalarProduct G (a : Section1.ClassFunction G) b =
      if a = b then 1 else 0 := by
  intro a b
  by_cases hab : a = b
  · subst hab
    simpa using scalarProduct_self_of_signedIrreducible_pf54 (hR.1 _ a.2)
  · simpa [hab] using hR.2 a.2 b.2 (fun hEq => hab (Subtype.ext hEq))

private theorem scalarProduct_evalCoeff_eq_coeffDot_of_orthonormal_pf54
    {G : Type*} [Group G] [Finite G]
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (μ : ι → Section1.ClassFunction G)
    (horth : ∀ i j, Section1.scalarProduct G (μ i) (μ j) = if i = j then 1 else 0)
    (v w : Section1.CoeffVector ι) :
    Section1.scalarProduct G (Section1.evalCoeff μ v) (Section1.evalCoeff μ w) =
      (Section1.coeffDot v w : ℂ) := by
  classical
  have hleft :
      (∑ j : ι, (v j : ℂ) • μ j) =
        (fun g : G => ∑ j : ι, ((v j : ℂ) • μ j) g) := by
    ext g
    simp
  have hright :
      (∑ j : ι, (w j : ℂ) • μ j) =
        (fun g : G => ∑ j : ι, ((w j : ℂ) • μ j) g) := by
    ext g
    simp
  simp only [Section1.evalCoeff]
  rw [hleft, hright]
  rw [Section1.scalarProduct_fintype_sum_left]
  simp_rw [Section1.scalarProduct_smul_left]
  change ∑ i : ι, (v i : ℂ) *
      Section1.scalarProduct G (μ i) (fun g : G => ∑ j : ι, ((w j : ℂ) • μ j) g) =
    ((∑ i : ι, v i * w i : ℤ) : ℂ)
  rw [show ((∑ i : ι, v i * w i : ℤ) : ℂ) =
      ∑ i : ι, ((v i * w i : ℤ) : ℂ) by simp]
  refine Finset.sum_congr rfl ?_
  intro i _hi
  rw [Section1.scalarProduct_fintype_sum_right]
  simp_rw [Section1.scalarProduct_smul_right]
  calc
    (v i : ℂ) * (∑ x : ι, star (w x : ℂ) * Section1.scalarProduct G (μ i) (μ x)) =
        (v i : ℂ) * (w i : ℂ) := by
          simp [horth]
    _ = (v i * w i : ℤ) := by
          simp [Int.cast_mul]

private theorem integerSpan_of_mem_pf54
    {H : Type*} [Group H] [Finite H]
    (S : Finset (Section1.ClassFunction H))
    {χ : Section1.ClassFunction H}
    (hχ : χ ∈ S) :
    integerSpan S χ := by
  classical
  refine ⟨Section1.basisVector ⟨χ, hχ⟩, ?_⟩
  ext g
  rw [Section1.evalCoeff, Finset.sum_eq_single ⟨χ, hχ⟩]
  · simp [Section1.basisVector]
  · intro x _hx hxne
    simp [Section1.basisVector, hxne]
  · intro hmem
    exact (hmem (Finset.mem_univ _)).elim

private theorem orthogonalToFinset_scalarProduct_evalCoeff_zero_pf54
    {G : Type*} [Group G] [Finite G]
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (μ : ι → Section1.ClassFunction G)
    {Y : Section1.ClassFunction G}
    (hY : ∀ i, Section1.scalarProduct G Y (μ i) = 0)
    (v : Section1.CoeffVector ι) :
    Section1.scalarProduct G Y (Section1.evalCoeff μ v) = 0 := by
  have hright :
      (∑ j : ι, (v j : ℂ) • μ j) =
        (fun g : G => ∑ j : ι, ((v j : ℂ) • μ j) g) := by
    ext g
    simp
  rw [Section1.evalCoeff, hright, Section1.scalarProduct_fintype_sum_right]
  simp_rw [Section1.scalarProduct_smul_right, hY]
  simp

private theorem cfNormSq_sub_eq_add_of_orthogonal_pf54
    {H : Type*} [Group H] [Finite H]
    {φ ψ : Section1.ClassFunction H}
    (hφψ : Section1.scalarProduct H φ ψ = 0)
    (hψφ : Section1.scalarProduct H ψ φ = 0) :
    cfNormSq (φ - ψ) = cfNormSq φ + cfNormSq ψ := by
  unfold cfNormSq
  rw [scalarProduct_sub_left_pf54, scalarProduct_sub_right_pf54, scalarProduct_sub_right_pf54]
  simp [hφψ, hψφ]

private theorem int_mul_pred_nonneg_pf54 (n : Int) :
    0 ≤ n * (n - 1) := by
  rcases le_or_gt n 0 with hn | hn
  · have hpred : n - 1 ≤ 0 := by omega
    exact mul_nonneg_of_nonpos_of_nonpos hn hpred
  · have hnonneg : 0 ≤ n := le_of_lt hn
    have hpred : 0 ≤ n - 1 := by omega
    exact mul_nonneg hnonneg hpred

private theorem int_cast_le_sq_pf54 (n : Int) :
    (n : ℝ) ≤ (n : ℝ) * (n : ℝ) := by
  have hnonneg : 0 ≤ (n : ℝ) * ((n : ℝ) - 1) := by
    exact_mod_cast int_mul_pred_nonneg_pf54 n
  nlinarith

private theorem int_cast_sq_sub_self_nonneg_pf54 (n : Int) :
    0 ≤ (n : ℝ) * (n : ℝ) - (n : ℝ) := by
  have hnonneg : 0 ≤ (n : ℝ) * ((n : ℝ) - 1) := by
    exact_mod_cast int_mul_pred_nonneg_pf54 n
  nlinarith

public theorem theorem_5_4
    {L : Type u} [Group L] [Finite L]
    {G : Type u} [Group G] [Finite G]
    (S : Finset (Section1.ClassFunction L))
    (T : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G)
    (R : S → Finset (Section1.ClassFunction G)) :
    theorem_5_4_statement S T R := by
  intro hsetup h52a _h52b h52c h52d _h52e X ψ _hψspan hXψ hXbarψ T1 hIso _hT1virt hagree Xbig Y
    hXbigspan hYorth hEq
  let Xbar : S := ⟨Section1.conjugateCharacter (X : Section1.ClassFunction L), (h52a X).1⟩
  let pair :
      Finset (Section1.ClassFunction L) :=
    {(X : Section1.ClassFunction L) - ψ,
      (X : Section1.ClassFunction L) - Section1.conjugateCharacter (X : Section1.ClassFunction L)}
  have hpair_left :
      integerSpan pair ((X : Section1.ClassFunction L) - ψ) := by
    apply integerSpan_of_mem_pf54
    simp [pair]
  have hpair_right :
      integerSpan pair
        ((X : Section1.ClassFunction L) - Section1.conjugateCharacter (X : Section1.ClassFunction L)) := by
    apply integerSpan_of_mem_pf54
    simp [pair]
  rcases h52d X with ⟨hR, hTdiff⟩
  rcases hXbigspan with ⟨v, hXbigEval⟩
  let μ : R X → Section1.ClassFunction G := fun a => (a : Section1.ClassFunction G)
  let oneVec : Section1.CoeffVector (R X) := fun _ => 1
  have hμorth :
      ∀ a b : R X,
        Section1.scalarProduct G (μ a) (μ b) = if a = b then 1 else 0 :=
    scalarProduct_eq_ite_of_signedOrthonormalFinset_pf54 hR
  have hYsumZero :
      Section1.scalarProduct G Y (Section1.evalCoeff μ oneVec) = 0 := by
    apply orthogonalToFinset_scalarProduct_evalCoeff_zero_pf54 μ
    intro a
    exact hYorth a.2
  have hYXbigZero :
      Section1.scalarProduct G Y Xbig = 0 := by
    rw [hXbigEval]
    exact orthogonalToFinset_scalarProduct_evalCoeff_zero_pf54 μ (fun a => hYorth a.2) v
  have hXbigYZero :
      Section1.scalarProduct G Xbig Y = 0 :=
    scalarProduct_zero_swap_pf54 hYXbigZero
  have hXXbarZero :
      Section1.scalarProduct L
          (X : Section1.ClassFunction L)
          (Section1.conjugateCharacter (X : Section1.ClassFunction L)) = 0 := by
    exact h52c (χ := (X : Section1.ClassFunction L))
      (ψ := (Xbar : Section1.ClassFunction L)) X.2 Xbar.2
      (by simpa [Xbar] using (h52a X).2)
  have hψXZero :
      Section1.scalarProduct L ψ (X : Section1.ClassFunction L) = 0 :=
    scalarProduct_zero_swap_pf54 hXψ
  have hψXbarZero :
      Section1.scalarProduct L ψ (Section1.conjugateCharacter (X : Section1.ClassFunction L)) = 0 :=
    scalarProduct_zero_swap_pf54 hXbarψ
  have hsourcePair :
      Section1.scalarProduct L
          ((X : Section1.ClassFunction L) - ψ)
          ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L)) =
        Section1.scalarProduct L (X : Section1.ClassFunction L) (X : Section1.ClassFunction L) := by
    rw [scalarProduct_sub_left_pf54, scalarProduct_sub_right_pf54]
    have hψdiffZero :
        Section1.scalarProduct L ψ
          ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L)) = 0 := by
      rw [scalarProduct_sub_right_pf54]
      simp [hψXZero, hψXbarZero]
    simp [hXXbarZero, hψdiffZero]
  have htargetPair :
      Section1.scalarProduct G
          (Xbig - Y)
          (Section1.evalCoeff μ oneVec) =
        (Section1.coeffDot v oneVec : ℂ) := by
    rw [hXbigEval, scalarProduct_sub_left_pf54]
    simp [hYsumZero,
      scalarProduct_evalCoeff_eq_coeffDot_of_orthonormal_pf54, hμorth, μ, oneVec]
  have hsumEval :
      Section1.evalCoeff μ oneVec = Finset.sum (R X) fun φ => φ := by
    ext g
    simp [Section1.evalCoeff, μ, oneVec]
    simpa using
      (Finset.sum_attach (R X) fun c : Section1.ClassFunction G => c g)
  have hpairEval :
      Section1.scalarProduct L
          ((X : Section1.ClassFunction L) - ψ)
          ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L)) =
        (Section1.coeffDot v oneVec : ℂ) := by
    calc
      Section1.scalarProduct L
          ((X : Section1.ClassFunction L) - ψ)
          ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L)) =
        Section1.scalarProduct G
          (T1 ((X : Section1.ClassFunction L) - ψ))
          (T1 ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L))) := by
          symm
          exact hIso _ _ hpair_left hpair_right
      _ = Section1.scalarProduct G
            (Xbig - Y)
            (Section1.evalCoeff μ oneVec) := by
          rw [hEq, hagree, hTdiff, ← hsumEval]
      _ = (Section1.coeffDot v oneVec : ℂ) := htargetPair
  have hcfX :
      cfNormSq (X : Section1.ClassFunction L) = (Section1.coeffDot v oneVec : ℝ) := by
    unfold cfNormSq
    rw [← hsourcePair, hpairEval]
    simp
  have hcfXbig :
      cfNormSq Xbig = (Section1.coeffDot v v : ℝ) := by
    unfold cfNormSq
    rw [hXbigEval, scalarProduct_evalCoeff_eq_coeffDot_of_orthonormal_pf54 μ hμorth]
    simp
  have hcoeff_le :
      ((Section1.coeffDot v oneVec : ℤ) : ℝ) ≤ ((Section1.coeffDot v v : ℤ) : ℝ) := by
    have hsum :
        (∑ a : R X, (v a : ℝ)) ≤ ∑ a : R X, (v a : ℝ) * (v a : ℝ) := by
      refine Finset.sum_le_sum ?_
      intro a _ha
      exact int_cast_le_sq_pf54 (v a)
    simpa [Section1.coeffDot, oneVec, Int.cast_sum, Int.cast_mul] using hsum
  refine ⟨by
    linarith [hcfX, hcfXbig, hcoeff_le], ?_⟩
  intro hYge
  have hsourceNorm :
      cfNormSq ((X : Section1.ClassFunction L) - ψ) =
        cfNormSq (X : Section1.ClassFunction L) + cfNormSq ψ := by
    exact cfNormSq_sub_eq_add_of_orthogonal_pf54 hXψ hψXZero
  have htargetNorm :
      cfNormSq (Xbig - Y) = cfNormSq Xbig + cfNormSq Y := by
    exact cfNormSq_sub_eq_add_of_orthogonal_pf54 hXbigYZero hYXbigZero
  have hnormEq :
      cfNormSq (Xbig - Y) = cfNormSq ((X : Section1.ClassFunction L) - ψ) := by
    have hIsoNorm :=
      hIso ((X : Section1.ClassFunction L) - ψ) ((X : Section1.ClassFunction L) - ψ)
        hpair_left hpair_left
    have hnormEq' :
        cfNormSq (T1 ((X : Section1.ClassFunction L) - ψ)) =
          cfNormSq ((X : Section1.ClassFunction L) - ψ) := by
      simpa [cfNormSq] using congrArg Complex.re hIsoNorm
    rw [hEq] at hnormEq'
    exact hnormEq'
  have hsumNorm :
      cfNormSq (X : Section1.ClassFunction L) + cfNormSq ψ =
        cfNormSq Xbig + cfNormSq Y := by
    calc
      cfNormSq (X : Section1.ClassFunction L) + cfNormSq ψ =
          cfNormSq ((X : Section1.ClassFunction L) - ψ) := by
            symm
            exact hsourceNorm
      _ = cfNormSq (Xbig - Y) := hnormEq.symm
      _ = cfNormSq Xbig + cfNormSq Y := htargetNorm
  have hXbigEq : cfNormSq Xbig = cfNormSq (X : Section1.ClassFunction L) := by
    have hmain : cfNormSq Xbig ≥ cfNormSq (X : Section1.ClassFunction L) := by
      linarith [hcfX, hcfXbig, hcoeff_le]
    linarith [hsumNorm, hYge, hmain]
  have hYEq : cfNormSq Y = cfNormSq ψ := by
    linarith [hsumNorm, hXbigEq]
  have hcoeffEq :
      ((Section1.coeffDot v v : ℤ) : ℝ) = ((Section1.coeffDot v oneVec : ℤ) : ℝ) := by
    linarith [hcfX, hcfXbig, hXbigEq]
  let Esub : Finset (R X) := Finset.univ.filter fun a => v a = 1
  have hcoeff01 : ∀ a : R X, v a = 0 ∨ v a = 1 := by
    intro a
    have hcoeffEq' :
        (∑ b : R X, (v b : ℝ) * (v b : ℝ)) = ∑ b : R X, (v b : ℝ) := by
      simpa [Section1.coeffDot, oneVec, Int.cast_sum, Int.cast_mul] using hcoeffEq
    have hsumZero :
        ∑ b : R X, ((v b : ℝ) * (v b : ℝ) - (v b : ℝ)) = 0 := by
      rw [Finset.sum_sub_distrib, hcoeffEq']
      ring
    have hnonneg :
        ∀ b ∈ (Finset.univ : Finset (R X)),
          0 ≤ (v b : ℝ) * (v b : ℝ) - (v b : ℝ) := by
      intro b _hb
      exact int_cast_sq_sub_self_nonneg_pf54 (v b)
    have hzeroAll :
        ∀ b ∈ (Finset.univ : Finset (R X)),
          (v b : ℝ) * (v b : ℝ) - (v b : ℝ) = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg hnonneg).1 hsumZero
    have hz : (v a : ℝ) * (v a : ℝ) - (v a : ℝ) = 0 := hzeroAll a (by simp)
    have hfac : (v a : ℝ) * ((v a : ℝ) - 1) = 0 := by
      nlinarith
    rcases mul_eq_zero.mp hfac with hv0 | hv1
    · left
      exact_mod_cast hv0
    · right
      have hv1' : (v a : ℝ) = 1 := by
        linarith
      exact_mod_cast hv1'
  have hXbigSubset :
      Xbig = Finset.sum Esub fun a => (a : Section1.ClassFunction G) := by
    have hv_indicator :
        v = fun a => if a ∈ Esub then 1 else 0 := by
      funext a
      by_cases ha : a ∈ Esub
      · have hva : v a = 1 := by
          simpa [Esub] using ha
        simp [ha, hva]
      · have hvanot : v a ≠ 1 := by
          simpa [Esub] using ha
        rcases hcoeff01 a with h0 | h1
        · simp [ha, h0]
        · exact False.elim (hvanot h1)
    rw [hXbigEval, hv_indicator]
    ext g
    simp [Section1.evalCoeff, Esub, Finset.sum_filter]
    refine Finset.sum_congr rfl ?_
    intro a _ha
    by_cases h : v a = 1 <;> simp [h]
  refine ⟨hXbigEq, hYEq, ?_⟩
  refine ⟨Esub.image (fun a : R X => (a : Section1.ClassFunction G)), ?_, ?_⟩
  · intro φ hφ
    rcases Finset.mem_image.mp hφ with ⟨a, _ha, rfl⟩
    exact a.2
  · calc
      Xbig = Finset.sum Esub fun a => (a : Section1.ClassFunction G) := hXbigSubset
      _ = Finset.sum (Esub.image (fun a : R X => (a : Section1.ClassFunction G))) fun φ => φ := by
            symm
            exact Finset.sum_image
              (s := Esub)
              (g := fun a : R X => (a : Section1.ClassFunction G))
              (f := fun φ => φ)
              (by
                intro a _ha b _hb hab
