/-!

Translation of the cited source; review against the original text.

# Fitting Subgroups

The Fitting subgroup is the (unique) largest normal nilpotent subgroup.

- The Fitting subgroup is characteristic.
- The Fitting subgroup of a nilpotent group is the whole group.
- For a solvable group, its Fitting subgroup is trivial if and only if it is trivial.
- If the `p'`-core is trivial, then the Fitting subgroup is equal to the `p`-core.

-/

/-- The set of normal nilpotent subgroups of `G`. -/
def CFSG.normalNilpotentSubgroups (G : Type*) [Group G] : Set (Subgroup G) :=
  {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}

/-- The Fitting subgroup of `G`. It's the maximal normal nilpotent subgroup of `G`. -/
-- TODO(tianjiao): Duplicate definition.
@[expose]
public def CFSG.fittingSubgroup (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}

/-- The subgroup generated by a family of normal subgroups is normal. -/
public theorem Subgroup.normal_sSup {G : Type*} [Group G] (S : Set (Subgroup G))
    (h : ∀ H ∈ S, H.Normal) : Subgroup.Normal (sSup S) := by
  have : sSup S = (sSup S).normalCore := by
    rw [sSup_eq_iSup', normalCore_eq_iSup]
    refine le_antisymm ?_ (by simp_all only [iSup_le_iff, implies_true])
    apply sSup_le
    rintro H ⟨a, rfl⟩
    exact le_iSup_of_le a (le_iSup_of_le (h a a.2) (le_iSup_of_le (le_iSup _ a) le_rfl))
  exact this ▸ inferInstance

/-- The Fitting subgroup is normal. -/
public instance CFSG.fittingSubgroup_normal {G : Type*} [Group G] :
    Subgroup.Normal (fittingSubgroup G) := by
  refine Subgroup.normal_sSup _ ?_
  intro _ hN
  exact hN.out.1

-- TODO(tianjiao): Split into two lemmas.
lemma CFSG.normal_nilpotent_comap {G : Type*} [Group G] {N : Subgroup G}
    (hN : N.Normal) (hnil : Group.IsNilpotent N) (φ : G ≃* G) :
    (N.comap φ.toMonoidHom).Normal ∧ Group.IsNilpotent (N.comap φ.toMonoidHom) := by
  refine ⟨hN.comap φ.toMonoidHom, ?_⟩
  have hmap_eq : (N.comap φ.toMonoidHom).map φ.toMonoidHom = N :=
    Subgroup.map_comap_eq_self_of_surjective (f := φ.toMonoidHom) φ.surjective N
  -- `φ` induces an isomorphism between `N.comap φ` and `N`.
  let e : (N.comap φ.toMonoidHom) ≃* N :=
    (MulEquiv.subgroupMap φ (N.comap φ.toMonoidHom)).trans
      (MulEquiv.subgroupCongr hmap_eq)
  exact Group.nilpotent_of_mulEquiv (G := N) (G' := N.comap φ.toMonoidHom) (_h := hnil) e.symm

/-- The preimage map `comap φ` for an automorphism `φ` preserves suprema. -/
lemma CFSG.comap_sSup {G : Type*} [Group G] (φ : G ≃* G) (S : Set (Subgroup G)) :
    (sSup S).comap φ.toMonoidHom = sSup ((fun H : Subgroup G => H.comap φ.toMonoidHom) '' S) := by
  calc
    (sSup S).comap φ.toMonoidHom
      = φ.comapSubgroup (sSup S) := rfl
    _ = ⨆ a ∈ S, φ.comapSubgroup a := φ.comapSubgroup.map_sSup S
    _ = sSup (φ.comapSubgroup '' S) := sSup_image.symm
    _ = sSup ((fun H => H.comap φ.toMonoidHom) '' S) := rfl

/-- Composing `comap φ` and `comap φ.symm` returns the original subgroup. -/
lemma CFSG.comap_comap_eq_id {G : Type*} [Group G] (φ : G ≃* G) (N : Subgroup G) :
    (N.comap φ.toMonoidHom).comap φ.symm.toMonoidHom = N := by
  ext x
  simp only [MulEquiv.toMonoidHom_eq_coe, Subgroup.mem_comap, MonoidHom.coe_coe,
    MulEquiv.apply_symm_apply]

lemma CFSG.comap_mem_normalNilpotentSubgroups {G : Type*} [Group G] {N : Subgroup G}
    (hN : N ∈ normalNilpotentSubgroups G) (φ : G ≃* G) :
    N.comap φ.toMonoidHom ∈ normalNilpotentSubgroups G := by
  rcases hN with ⟨hN_normal, hN_nilp⟩
  exact normal_nilpotent_comap hN_normal hN_nilp φ


lemma CFSG.comap_image_normalNilpotentSubgroups {G : Type*} [Group G] (φ : G ≃* G) :
    (fun N : Subgroup G => N.comap φ.toMonoidHom) '' (normalNilpotentSubgroups G) =
      normalNilpotentSubgroups G := by
  ext N
  constructor
  · intro h
    rcases h with ⟨K, hK, rfl⟩
    exact comap_mem_normalNilpotentSubgroups hK φ
  · intro hN
    refine ⟨N.comap φ.symm.toMonoidHom, comap_mem_normalNilpotentSubgroups hN φ.symm, ?_⟩
    simpa using comap_comap_eq_id φ.symm N

/-- The Fitting subgroup is characteristic. -/
public instance CFSG.fittingSubgroup_characteristic {G : Type*} [Group G] :
    (fittingSubgroup G).Characteristic := by
  rw [Subgroup.characteristic_iff_comap_eq]
  intro φ
  calc
    (fittingSubgroup G).comap φ.toMonoidHom
      = (sSup (normalNilpotentSubgroups G)).comap φ.toMonoidHom := rfl
    _ = fittingSubgroup G := by
        rw [comap_sSup, comap_image_normalNilpotentSubgroups φ]
        rfl

public lemma CFSG.fitting_eq_sup_pCore (G : Type*) [Group G] [Finite G] :
    fittingSubgroup G = ⨆ p : (Nat.card G).primeFactors.attach, pCore p.1.1 G := by
  apply le_antisymm
  · refine sSup_le (fun N hN => ?_)
    rcases hN with ⟨hN_normal, hN_nil⟩
    exact normal_nilpotent_le_sup_pCore hN_normal hN_nil
  · refine iSup_le (fun p => le_sSup ⟨pCore_normal, pCore_isNilpotent⟩)

public instance CFSG.fittingSubgroup_nilpotent {G : Type*} [Group G] [Finite G] :
    Group.IsNilpotent (fittingSubgroup G) :=
  fitting_eq_sup_pCore G ▸ isNilpotent_iSup_pCore

public theorem CFSG.fitting_eq_top_of_nilpotent (G : Type*) [Group G] [Group.IsNilpotent G] :
    fittingSubgroup G = ⊤ :=
  le_antisymm le_top (le_sSup ⟨inferInstance, inferInstance⟩)

private lemma CFSG.exists_nontrivial_abelian_normal (G : Type*) [Group G] [Finite G] [hs : Group.IsSolvable G]
    (h : Nontrivial G) : ∃ (H : Subgroup G), H.Normal ∧ IsMulCommutative H ∧ H ≠ ⊥ := by
  classical
  let p : Nat -> Prop := fun n => derivedSeries G n = ⊥
  have h : ∃ n, p n := hs.solvable
  let i := Nat.find h
  have hi : i ≠ 0 := by
    have : ¬ p 0 := by
      simp [p, derivedSeries_zero]
    exact (Nat.find_eq_zero h).not.mpr this
  use derivedSeries G (i - 1)
  refine ⟨derivedSeries_normal _ _, ?_, Nat.find_min h (Nat.sub_one_lt hi)⟩
  refine Subgroup.le_centralizer_iff_isMulCommutative.mp ?_
  apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
  rw [← derivedSeries_succ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hi)]
  exact Nat.find_spec h

public theorem CFSG.fitting_eq_bot_iff_card_eq_one_of_solvable (G : Type*) [Group G] [Finite G] [Group.IsSolvable G] :
    fittingSubgroup G = ⊥ ↔ Nat.card G = 1 := by
  constructor
  · intro hF
    by_contra!
    have hnt : Nontrivial G := by
      apply Finite.one_lt_card_iff_nontrivial.mp
      have := (Nat.card_pos (α := G)).ne'
      omega
    obtain ⟨H, hH_normal, hH_abelian, hH_ne_bot⟩ := exists_nontrivial_abelian_normal G hnt
    have hH_le : H ≤ fittingSubgroup G := by
      have : IsMulCommutative H := hH_abelian
      exact le_sSup ⟨hH_normal, (inferInstance : Group.IsNilpotent (↥H))⟩
    exact hH_ne_bot (le_bot_iff.mp (hH_le.trans (le_of_eq hF)))
  · intro hcard
    rw [← Subgroup.card_le_one_iff_eq_bot, ← hcard]
    exact (Subgroup.card_le_card_group (H := fittingSubgroup G))

public theorem CFSG.pCore_le_fitting (G : Type*) [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    pCore p G ≤ fittingSubgroup G := by
  have h :
      {K : Subgroup G | K.Normal ∧ IsPGroup p K} ⊆
        {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N} := by
    intro K ⟨hKN, hK⟩
    exact ⟨hKN, hK.isNilpotent⟩
  exact sSup_le_sSup h

lemma CFSG.fitting_le_pCore (G : Type*) [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (hcore : pPrimeCore p G = ⊥) : fittingSubgroup G ≤ pCore p G := by
  refine sSup_le_sSup ?_
  intro N ⟨hN_normal, hN_nilpotent⟩
  exact ⟨hN_normal, isPGroup_of_nilpotent_normal N hN_normal hN_nilpotent hcore⟩

public theorem CFSG.Fitting_eq_pcore (G : Type*) [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (h : pPrimeCore p G = ⊥) : fittingSubgroup G = pCore p G :=
  le_antisymm (fitting_le_pCore G p h) (pCore_le_fitting G p)
