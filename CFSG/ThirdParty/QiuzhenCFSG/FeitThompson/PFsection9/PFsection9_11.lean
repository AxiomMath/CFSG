        (a + 1 : ℚ) + (((q - 1) * a ^ 2 : ℕ) : ℚ) / (u : ℚ) :=
    theorem_9_11_case_a_9115_fractional_bound_of_card_norm_sec9
      p q a u (p ^ q - 1) s hqpos hupos hcount hnorm_le
  have hupper_raw :
