private theorem conjBy_mem_reindex_sec9
    {G : Type u} [Group G]
    (U1 W1 : Subgroup G) (w1 b : W1) (x : G) :
    (w1 : G) * x * (w1 : G)⁻¹ ∈
        U1.conjBy (((w1 * b⁻¹ : W1) : G)) ↔
      (b : G) * x * (b : G)⁻¹ ∈ U1 := by
    constructor
    · intro h
      rcases Subgroup.mem_map.mp h with ⟨y, hy, hy_eq⟩
      have hcalc : (b : G) * x * (b : G)⁻¹ = y := by
        have hcong :=
          congrArg
            (fun z : G =>
              (((w1 : G) * (b : G)⁻¹)⁻¹) * z *
                ((w1 : G) * (b : G)⁻¹))
            hy_eq
        simpa [MulAut.conj_apply, mul_assoc] using hcong.symm
      simpa [hcalc] using hy
    · intro hb
      refine Subgroup.mem_map.mpr ?_
      refine ⟨(b : G) * x * (b : G)⁻¹, hb, ?_⟩
      simp [MulAut.conj_apply, mul_assoc]

private theorem pair_sum_conj_mem_eq_inf_conjBy_indicator_sec9
    {G : Type u} [Group G]
    (U1 W1 : Subgroup G) [Fintype W1]
    (x : G)
    [∀ w1 : W1, ∀ b : W1,
      Decidable ((w1 : G) * x * (w1 : G)⁻¹ ∈ U1 ∧
        (b : G) * x * (b : G)⁻¹ ∈ U1)]
    [∀ w1 : W1, ∀ w2 : W1,
      Decidable ((w1 : G) * x * (w1 : G)⁻¹ ∈
        U1 ⊓ U1.conjBy (w2 : G))] :
    (∑ w1 : W1, ∑ b : W1,
        if (w1 : G) * x * (w1 : G)⁻¹ ∈ U1 ∧
            (b : G) * x * (b : G)⁻¹ ∈ U1 then
          (1 : ℝ)
        else
          0) =
      (∑ w1 : W1, ∑ w2 : W1,
        if (w1 : G) * x * (w1 : G)⁻¹ ∈
            U1 ⊓ U1.conjBy (w2 : G) then
          (1 : ℝ)
        else
          0) := by
    classical
    refine Finset.sum_congr rfl ?_
    intro w1 _hw1
    let e : W1 ≃ W1 := (Equiv.inv W1).trans (Equiv.mulLeft w1)
    calc
      (∑ b : W1,
          if (w1 : G) * x * (w1 : G)⁻¹ ∈ U1 ∧
              (b : G) * x * (b : G)⁻¹ ∈ U1 then
            (1 : ℝ)
          else
            0) =
          ∑ b : W1,
            if (w1 : G) * x * (w1 : G)⁻¹ ∈
                U1 ⊓ U1.conjBy ((e b : W1) : G) then
              (1 : ℝ)
            else
              0 := by
            refine Finset.sum_congr rfl ?_
            intro b _hb
            have hiff := conjBy_mem_reindex_sec9 U1 W1 w1 b x
            by_cases h1 : (w1 : G) * x * (w1 : G)⁻¹ ∈ U1
            · by_cases hb : (b : G) * x * (b : G)⁻¹ ∈ U1
              · rw [if_pos ⟨h1, hb⟩, if_pos]
                exact ⟨h1, hiff.2 hb⟩
              · rw [if_neg, if_neg]
                · intro hmem
                  exact hb (hiff.1 hmem.2)
                · intro h
                  exact hb h.2
            · rw [if_neg, if_neg]
              · intro hmem
                exact h1 hmem.1
              · intro h
                exact h1 h.1
      _ =
          ∑ w2 : W1,
            if (w1 : G) * x * (w1 : G)⁻¹ ∈
                U1 ⊓ U1.conjBy (w2 : G) then
              (1 : ℝ)
            else
              0 := by
            exact Equiv.sum_comp e fun w2 : W1 =>
              if (w1 : G) * x * (w1 : G)⁻¹ ∈
                  U1 ⊓ U1.conjBy (w2 : G) then
                (1 : ℝ)
              else
                0

private theorem semidirect_conj_filter_card_div_eq_relIndex_mul_sum_indicator_sec9
    {G : Type u} [Group G] [Finite G]
    (U U1 W1 : Subgroup G) [Fintype U] [Fintype W1]
    [Fintype (U ⊔ W1 : Subgroup G)]
    (hcomp :
      (U.subgroupOf (U ⊔ W1 : Subgroup G)).IsComplement'
        (W1.subgroupOf (U ⊔ W1 : Subgroup G)))
    (hU1_le_U : U1 ≤ U)
    (hU1_normal_U : (U1.subgroupOf U).Normal)
    (g : (U ⊔ W1 : Subgroup G))
    [DecidablePred (fun y : (U ⊔ W1 : Subgroup G) =>
      y * g * y⁻¹ ∈ U1.subgroupOf (U ⊔ W1 : Subgroup G))]
    [∀ w : W1,
      Decidable ((w : G) * (g : G) * (w : G)⁻¹ ∈ U1)] :
    (((Finset.univ : Finset (U ⊔ W1 : Subgroup G)).filter
        (fun y => y * g * y⁻¹ ∈
          U1.subgroupOf (U ⊔ W1 : Subgroup G))).card : ℝ) /
        (Nat.card (U1.subgroupOf (U ⊔ W1 : Subgroup G)) : ℝ) =
      (U1.relIndex U : ℝ) *
        (∑ w : W1,
          if (w : G) * (g : G) * (w : G)⁻¹ ∈ U1 then
            (1 : ℝ)
          else
            0) := by
    classical
    let K : Subgroup G := U ⊔ W1
    let Usub : Subgroup K := U.subgroupOf K
    let Wsub : Subgroup K := W1.subgroupOf K
    let P : K → Prop := fun y => y * g * y⁻¹ ∈ U1.subgroupOf K
    let Q : W1 → Prop := fun w => (w : G) * (g : G) * (w : G)⁻¹ ∈ U1
    let Qsub : Wsub → Prop := fun w => (w : G) * (g : G) * (w : G)⁻¹ ∈ U1
    have hfilter_sum :
        (((Finset.univ : Finset K).filter P).card : ℝ) =
          ∑ y : K, if P y then (1 : ℝ) else 0 := by
      dsimp [P]
      rw [← Finset.sum_filter]
      simp
    have hmem : ∀ u : Usub, ∀ w : Wsub,
        P ((u : K) * (w : K)) ↔ Qsub w := by
      intro u w
      let uU : U := (Subgroup.subgroupOfEquivOfLe
        (H := U) (K := K) le_sup_left) u
      have hiff :=
        normal_subgroupOf_conj_mem_iff_sec9 U U1 hU1_le_U
          hU1_normal_U uU ((w : G) * (g : G) * (w : G)⁻¹)
      simpa [P, Qsub, K, uU, Subgroup.subgroupOfEquivOfLe,
        Subgroup.mem_subgroupOf, mul_assoc] using hiff
    have hdecomp :
        (∑ y : K, if P y then (1 : ℝ) else 0) =
          ∑ u : Usub, ∑ w : Wsub, if Qsub w then (1 : ℝ) else 0 := by
      have hsum :=
        sum_eq_sum_mul_of_isComplement'_sec9 Usub Wsub hcomp
          (fun y : K => if P y then (1 : ℝ) else 0)
      calc
        (∑ y : K, if P y then (1 : ℝ) else 0) =
            ∑ u : Usub, ∑ w : Wsub,
              if P ((u : K) * (w : K)) then (1 : ℝ) else 0 := hsum
        _ = ∑ u : Usub, ∑ w : Wsub,
              if Qsub w then (1 : ℝ) else 0 := by
            refine Finset.sum_congr rfl ?_
            intro u _hu
            refine Finset.sum_congr rfl ?_
            intro w _hw
            by_cases hp : P ((u : K) * (w : K))
            · rw [if_pos hp, if_pos ((hmem u w).1 hp)]
            · rw [if_neg hp, if_neg]
              intro hq
              exact hp ((hmem u w).2 hq)
    have hWsum :
        (∑ w : Wsub, if Qsub w then (1 : ℝ) else 0) =
          ∑ w : W1, if Q w then (1 : ℝ) else 0 := by
      let e : Wsub ≃ W1 :=
        (Subgroup.subgroupOfEquivOfLe (H := W1) (K := K) le_sup_right).toEquiv
      let f : W1 → ℝ := fun w => if Q w then (1 : ℝ) else 0
      calc
        (∑ w : Wsub, if Qsub w then (1 : ℝ) else 0) =
            ∑ w : Wsub, f (e w) := by
              refine Finset.sum_congr rfl ?_
              intro w _hw
              simp [Qsub, Q, f, e, Subgroup.subgroupOfEquivOfLe]
        _ = ∑ w : W1, f w := Equiv.sum_comp e f
        _ = ∑ w : W1, if Q w then (1 : ℝ) else 0 := rfl
    have hcount :
        (((Finset.univ : Finset K).filter P).card : ℝ) =
          (Nat.card U : ℝ) * ∑ w : W1, if Q w then (1 : ℝ) else 0 := by
      calc
        (((Finset.univ : Finset K).filter P).card : ℝ) =
            ∑ y : K, if P y then (1 : ℝ) else 0 := hfilter_sum
        _ = ∑ u : Usub, ∑ w : Wsub, if Qsub w then (1 : ℝ) else 0 := hdecomp
        _ = ∑ _u : Usub, ∑ w : W1, if Q w then (1 : ℝ) else 0 := by
            refine Finset.sum_congr rfl ?_
            intro u _hu
            exact hWsum
        _ = (Nat.card Usub : ℝ) *
            ∑ w : W1, if Q w then (1 : ℝ) else 0 := by
            simp [Finset.card_univ, Nat.card_eq_fintype_card]
        _ = (Nat.card U : ℝ) *
            ∑ w : W1, if Q w then (1 : ℝ) else 0 := by
            rw [natCard_subgroupOf_eq U K le_sup_left]
    have hden :
        Nat.card (U1.subgroupOf K) = Nat.card U1 :=
      natCard_subgroupOf_eq U1 K (hU1_le_U.trans le_sup_left)
    have hrel_card :
        (Nat.card U : ℝ) =
          (U1.relIndex U : ℝ) * (Nat.card U1 : ℝ) := by
      exact_mod_cast
        (relIndex_mul_natCard_eq_natCard_of_le_sec9 U1 U hU1_le_U).symm
    have hU1card_ne : (Nat.card U1 : ℝ) ≠ 0 := by
      exact_mod_cast (Nat.card_pos (α := U1)).ne'
    rw [hcount, hden, hrel_card]
    field_simp [hU1card_ne]
    ring

private theorem semidirect_filter_count_sq_eq_relIndex_sq_pair_indicator_sec9
    {G : Type u} [Group G] [Finite G]
    (U U1 W1 : Subgroup G) [Fintype U] [Fintype W1]
    [Fintype (U ⊔ W1 : Subgroup G)]
    [∀ g : (U ⊔ W1 : Subgroup G),
      DecidablePred (fun y : (U ⊔ W1 : Subgroup G) =>
        y * g * y⁻¹ ∈ U1.subgroupOf (U ⊔ W1 : Subgroup G))]
    [∀ x : (U ⊔ W1 : Subgroup G), ∀ w1 : W1, ∀ w2 : W1,
      Decidable ((w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
        U1 ⊓ U1.conjBy (w2 : G))]
    (hcomp :
      (U.subgroupOf (U ⊔ W1 : Subgroup G)).IsComplement'
        (W1.subgroupOf (U ⊔ W1 : Subgroup G)))
    (hU1_le_U : U1 ≤ U)
    (hU1_normal_U : (U1.subgroupOf U).Normal) :
    (∑ g : (U ⊔ W1 : Subgroup G),
        ((((Finset.univ : Finset (U ⊔ W1 : Subgroup G)).filter
          (fun y => y * g * y⁻¹ ∈
            U1.subgroupOf (U ⊔ W1 : Subgroup G))).card : ℝ) /
            (Nat.card (U1.subgroupOf (U ⊔ W1 : Subgroup G)) : ℝ)) ^ 2) =
      (U1.relIndex U : ℝ) ^ 2 *
        (∑ x : (U ⊔ W1 : Subgroup G), ∑ w1 : W1, ∑ w2 : W1,
          if (w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
            U1 ⊓ U1.conjBy (w2 : G) then
            (1 : ℝ)
          else
            0) := by
    classical
    let K : Subgroup G := U ⊔ W1
    let coeff : ℝ := (U1.relIndex U : ℝ)
    let F : K → ℝ := fun g =>
      ∑ w : W1,
        if (w : G) * (g : G) * (w : G)⁻¹ ∈ U1 then (1 : ℝ) else 0
    have hratio : ∀ g : K,
        (((Finset.univ : Finset K).filter
          (fun y => y * g * y⁻¹ ∈ U1.subgroupOf K)).card : ℝ) /
            (Nat.card (U1.subgroupOf K) : ℝ) =
          coeff * F g := by
      intro g
      simpa [K, coeff, F] using
        semidirect_conj_filter_card_div_eq_relIndex_mul_sum_indicator_sec9
          U U1 W1 hcomp hU1_le_U hU1_normal_U g
    have hF_sq : ∀ g : K,
        F g ^ 2 =
          ∑ w1 : W1, ∑ w2 : W1,
            if (w1 : G) * (g : G) * (w1 : G)⁻¹ ∈
              U1 ⊓ U1.conjBy (w2 : G) then
              (1 : ℝ)
            else
              0 := by
      intro g
      let P : W1 → Prop := fun w => (w : G) * (g : G) * (w : G)⁻¹ ∈ U1
      have hF_card :
          F g = (((Finset.univ : Finset W1).filter P).card : ℝ) := by
        dsimp [F, P]
        rw [← Finset.sum_filter]
        simp
      calc
        F g ^ 2 =
            (((Finset.univ : Finset W1).filter P).card : ℝ) ^ 2 := by
              rw [hF_card]
        _ = ∑ w1 : W1, ∑ w2 : W1,
              if P w1 ∧ P w2 then (1 : ℝ) else 0 :=
              filter_card_sq_eq_sum_pair_indicator_sec9 P
        _ = ∑ w1 : W1, ∑ w2 : W1,
              if (w1 : G) * (g : G) * (w1 : G)⁻¹ ∈
                U1 ⊓ U1.conjBy (w2 : G) then
                (1 : ℝ)
              else
                0 := by
              simpa [P] using
                pair_sum_conj_mem_eq_inf_conjBy_indicator_sec9
                  U1 W1 (g : G)
    calc
      (∑ g : K,
          ((((Finset.univ : Finset K).filter
            (fun y => y * g * y⁻¹ ∈ U1.subgroupOf K)).card : ℝ) /
              (Nat.card (U1.subgroupOf K) : ℝ)) ^ 2) =
          ∑ g : K, (coeff * F g) ^ 2 := by
            refine Finset.sum_congr rfl ?_
            intro g _hg
            rw [hratio g]
      _ = ∑ g : K, coeff ^ 2 * F g ^ 2 := by
            refine Finset.sum_congr rfl ?_
            intro g _hg
            ring
      _ = coeff ^ 2 * ∑ g : K, F g ^ 2 := by
            rw [Finset.mul_sum]
      _ = coeff ^ 2 *
          (∑ x : K, ∑ w1 : W1, ∑ w2 : W1,
            if (w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
              U1 ⊓ U1.conjBy (w2 : G) then
              (1 : ℝ)
            else
              0) := by
            congr 1
            refine Finset.sum_congr rfl ?_
            intro g _hg
            exact hF_sq g


