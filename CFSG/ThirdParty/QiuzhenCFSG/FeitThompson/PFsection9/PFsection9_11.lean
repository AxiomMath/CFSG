private theorem theorem_9_11_case_a_9116_RGammaNonzeroToTau3Image_source_sec9
    {G : Type u} [Group G] [Finite G] [DecidableEq (Section1.ClassFunction G)]
    (M : Subgroup G)
    (S S2 S4source S3source : Finset (Section1.ClassFunction M))
    (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (q u : ℕ)
    (lam1 α : Section1.ClassFunction M)
    (RΓ : Finset (Section1.ClassFunction G))
    (hRΓ : Section5.signedOrthonormalFinset RΓ)
    (hRΓsum :
