  have hmain :
      2 ^ q * a ^ q + 2 * q * (q - 1) * a ^ 2 + 2 * q * a + 1 ≤
        p ^ q := by
    simpa [hp, mul_pow] using hbase
  omega

private theorem theorem_9_11_case_a_9115_card_gt_norm_of_count_sec9
  (p q a u s : ℕ) :
  0 < q →
    0 < u →
      0 < a →
        3 ≤ q →
          p = 2 * a + 1 →
            u ≤ a ^ 2 →
              q * u * s + (p - 1) * (q + u) = p ^ q - 1 →
                (a + 1 : ℚ) +
                    (((q - 1) * a ^ 2 : ℕ) : ℚ) / (u : ℚ) <
