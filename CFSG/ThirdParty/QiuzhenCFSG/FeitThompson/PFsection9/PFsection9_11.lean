                SH0 SH0C SH0U →
                theorem_9_11_case_a_sourceData M MF U W1 W2 H0 C Cprime
                  SH0Cprime := by
  intro hcase hSH0Cprime hUprime hSH0 hSH0C hSH0U hchar
  exact ⟨p, a, u, Uprime, SH0, SH0C, SH0U, hcase, hSH0Cprime, hUprime,
