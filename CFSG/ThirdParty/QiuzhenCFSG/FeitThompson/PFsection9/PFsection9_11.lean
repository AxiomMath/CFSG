    Nat.ne_of_gt (Nat.mul_pos ha_pos (Nat.card_pos (α := Uprime)))
  have hfactor_eq :
      Nat.card U / (a * Nat.card Uprime) = Usub.relIndex K :=
    (Nat.eq_div_of_mul_eq_right hden_ne hfactor_mul).symm
  have hUsub_eq_Csub : Usub = C.subgroupOf U := by
    ext x
    constructor
    · intro hx
      have hxUprime : (x : G) ∈ Uprime := by
        simpa [Usub, Subgroup.mem_subgroupOf] using hx
      have hxC : (x : G) ∈ C := by
        simpa [hC_eq_Uprime] using hxUprime
      simpa [Subgroup.mem_subgroupOf] using hxC
    · intro hx
      have hxC : (x : G) ∈ C := by
        simpa [Subgroup.mem_subgroupOf] using hx
      have hxUprime : (x : G) ∈ Uprime := by
        simpa [hC_eq_Uprime] using hxC
      simpa [Usub, Subgroup.mem_subgroupOf] using hxUprime
  have hfactor_eq_C :
      Nat.card U / (a * Nat.card Uprime) = (C.subgroupOf U).relIndex K := by
    simpa [hUsub_eq_Csub] using hfactor_eq
  have hbarU_relIndex : C.relIndex U = u :=
    quotientBarUCardinality_relIndex_sec9 U C u hBarU
  have hCsub_index_eq : (C.subgroupOf U).index = u := by
    simpa [Subgroup.relIndex] using hbarU_relIndex
  have hu_eq : (C.subgroupOf U).relIndex K * a = u := by
    calc
      (C.subgroupOf U).relIndex K * a =
          (C.subgroupOf U).relIndex K * K.index := by rw [hKindex]
      _ = (C.subgroupOf U).index := Subgroup.relIndex_mul_index hCsub_le_K
      _ = u := hCsub_index_eq
  have hquot_two : (p - 1) / a = 2 := by
    have hdiv_cancel : ((p - 1) / a) * a = p - 1 :=
      Nat.div_mul_cancel ha_dvd
    have htwo_a : 2 * a = p - 1 := by
      have hpOdd : Odd p := hp.odd_of_ne_two hp_ne_two
      rcases hpOdd with ⟨b, hb⟩
      rw [ha_eq_half, hb, Nat.add_sub_cancel]
      omega
    exact Nat.eq_of_mul_eq_mul_right ha_pos (by
      simpa [mul_comm] using hdiv_cancel.trans htwo_a.symm)
  calc
    (((p - 1) / a) * (Nat.card U / (a * Nat.card Uprime))) * a =
        2 * ((C.subgroupOf U).relIndex K * a) := by
          rw [hquot_two, hfactor_eq_C]
          ring
    _ = 2 * u := by rw [hu_eq]


private theorem coherentFamilyForT_of_no_closed_maximal_obstruction_sec9
  {G : Type u} [Group G] [Finite G]
  (M : Subgroup G)
  (S0 S : Finset (Section1.ClassFunction M))
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G) :
  S0 ⊆ S →
    conjugationClosedSubfamily_sec9 S0 →
      conjugationClosedSubfamily_sec9 S →
        coherentFamilyForT M S0 T →
          (∀ S2 : Finset (Section1.ClassFunction M),
            S0 ⊆ S2 →
              S2 ⊆ S →
                conjugationClosedSubfamily_sec9 S2 →
                  coherentFamilyForT M S2 T →
                    S2 ≠ S →
                      (¬ ∃ S3 : Finset (Section1.ClassFunction M),
                        S2 ⊂ S3 ∧
                          S3 ⊆ S ∧
                            coherentFamilyForT M S3 T ∧
                              conjugationClosedSubfamily_sec9 S3) →
                        False) →
            coherentFamilyForT M S T := by
  classical
  intro hS0S hS0closed hSclosed hS0coherent hnoObstruction
  by_contra hnotS
  let candidates : Finset (Finset (Section1.ClassFunction M)) :=
    S.powerset.filter fun S2 =>
      S0 ⊆ S2 ∧
        conjugationClosedSubfamily_sec9 S2 ∧
          coherentFamilyForT M S2 T
  have hS0mem : S0 ∈ candidates := by
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_powerset.mpr hS0S, subset_rfl, hS0closed, hS0coherent⟩
  have hnonempty : candidates.Nonempty := ⟨S0, hS0mem⟩
  rcases Finset.exists_max_image candidates Finset.card hnonempty with
    ⟨S2, hS2mem, hmax⟩
  have hS2data :
      S2 ⊆ S ∧
        S0 ⊆ S2 ∧
          conjugationClosedSubfamily_sec9 S2 ∧
            coherentFamilyForT M S2 T := by
    simpa [candidates] using hS2mem
  rcases hS2data with ⟨hS2S, hS0S2, hS2closed, hS2coherent⟩
  have hS2ne : S2 ≠ S := by
    intro hEq
    exact hnotS (by simpa [hEq] using hS2coherent)
  have hmaximal :
      ¬ ∃ S3 : Finset (Section1.ClassFunction M),
        S2 ⊂ S3 ∧
          S3 ⊆ S ∧
            coherentFamilyForT M S3 T ∧
              conjugationClosedSubfamily_sec9 S3 := by
    rintro ⟨S3, hS2S3, hS3S, hS3coherent, hS3closed⟩
    have hS2S3sub : S2 ⊆ S3 := hS2S3.1
    have hS0S3 : S0 ⊆ S3 := fun χ hχ => hS2S3sub (hS0S2 hχ)
    have hS3mem : S3 ∈ candidates := by
      rw [Finset.mem_filter]
      exact ⟨Finset.mem_powerset.mpr hS3S, hS0S3, hS3closed, hS3coherent⟩
    have hlt : S2.card < S3.card := Finset.card_lt_card hS2S3
    have hle : S3.card ≤ S2.card := hmax S3 hS3mem
    exact not_lt_of_ge hle hlt
  exact hnoObstruction S2 hS0S2 hS2S hS2closed hS2coherent hS2ne hmaximal

