    Section6.coherentExtension S1 T τ := by
    rcases hτ with ⟨hiso, hvirt, hagree⟩
    exact ⟨Section5.isCFLinearIsometryOnSpan_mono hsub hiso,
      Section5.mapsIntegerSpanToVirtualCharacters_mono hsub hvirt,
      Section5.agreesOnIntegerSpanOn_mono hsub hagree⟩


