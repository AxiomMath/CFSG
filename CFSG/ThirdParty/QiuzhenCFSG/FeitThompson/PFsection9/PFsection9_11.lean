private theorem theorem_9_11_case_a_9116_alpha_orthogonal_tau3OutsideFamily_sec9
    {G : Type u} [Group G] [Finite G]
    (M : Subgroup G)
    (S S2 S4source S3source : Finset (Section1.ClassFunction M))
    (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (q u : ℕ)
    (ψ1 γ α : Section1.ClassFunction M)
    (h52 : Section5.hypothesis_5_2_statement S T)
    (hS2S : S2 ⊆ S)
    (hψ1S2 : ψ1 ∈ S2)
    (hα_def : α = γ - ψ1)
    (hγOrthS : ∀ lam : Section1.ClassFunction M, lam ∈ S →
      Section1.scalarProduct M γ lam = 0)
    (hS3sourceData :
      theorem_9_11_case_a_9116_tau3OutsideFamilyData_sec9
        M S S2 S4source S3source q u) :
    ∀ lam, lam ∈ S3source →
      Section1.scalarProduct M α lam = 0 := by
    intro lam hlamS3
    rcases hS3sourceData with
      ⟨_hS4S3, hS3S, hS3notS2, _hS3closed, _hS3degree⟩
    rcases h52 with
      ⟨_hsetup, _R, _h52a, _h52b, h52c, _h52d, _h52e⟩
    have hψ_ne_lam : ψ1 ≠ lam := by
      intro hψeq
      exact hS3notS2 lam hlamS3 (by simpa [hψeq] using hψ1S2)
    have hψlam : Section1.scalarProduct M ψ1 lam = 0 :=
      h52c (hS2S hψ1S2) (hS3S hlamS3) hψ_ne_lam
    calc
      Section1.scalarProduct M α lam =
          Section1.scalarProduct M (γ - ψ1) lam := by rw [hα_def]
      _ = Section1.scalarProduct M γ lam -
          Section1.scalarProduct M ψ1 lam := by
            rw [Section5.scalarProduct_sub_left]
