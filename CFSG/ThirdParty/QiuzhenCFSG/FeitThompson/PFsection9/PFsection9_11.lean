private theorem finset_sum_sq_eq_of_two_degree_fibers_sec9
  {ι : Type*} [Fintype ι] [DecidableEq ι]
  (deg : ι → ℕ) (a u countA countU : ℕ)
  (hau : a ≠ u)
  (hcover : ∀ i, deg i = a ∨ deg i = u)
  (hcardA : (Finset.univ.filter fun i => deg i = a).card = countA)
  (hcardU : (Finset.univ.filter fun i => deg i = u).card = countU) :
  (∑ i, deg i ^ (2 : ℕ)) =
    countA * a ^ (2 : ℕ) + countU * u ^ (2 : ℕ) := by
  classical
  let A : Finset ι := Finset.univ.filter fun i => deg i = a
  let B : Finset ι := Finset.univ.filter fun i => deg i = u
  have hUniv : (Finset.univ : Finset ι) = A ∪ B := by
    ext i
    constructor
    · intro _hi
      rcases hcover i with hi | hi
      · exact Finset.mem_union.mpr (Or.inl (by simp [A, hi]))
      · exact Finset.mem_union.mpr (Or.inr (by simp [B, hi]))
    · intro _hi
      exact Finset.mem_univ i
  have hdisj : Disjoint A B := by
    rw [Finset.disjoint_left]
    intro i hiA hiB
    have hia : deg i = a := (Finset.mem_filter.mp hiA).2
    have hiu : deg i = u := (Finset.mem_filter.mp hiB).2
    exact hau (hia.symm.trans hiu)
  have hsumA : A.sum (fun i => deg i ^ (2 : ℕ)) = A.card * a ^ (2 : ℕ) := by
    calc
      A.sum (fun i => deg i ^ (2 : ℕ)) =
          A.sum (fun _i => a ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            rw [(Finset.mem_filter.mp hi).2]
      _ = A.card * a ^ (2 : ℕ) := by simp [mul_comm]
  have hsumB : B.sum (fun i => deg i ^ (2 : ℕ)) = B.card * u ^ (2 : ℕ) := by
    calc
      B.sum (fun i => deg i ^ (2 : ℕ)) =
          B.sum (fun _i => u ^ (2 : ℕ)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            rw [(Finset.mem_filter.mp hi).2]
      _ = B.card * u ^ (2 : ℕ) := by simp [mul_comm]
  calc
    (∑ i, deg i ^ (2 : ℕ)) =
        (A ∪ B).sum (fun i => deg i ^ (2 : ℕ)) := by rw [← hUniv]
    _ = A.sum (fun i => deg i ^ (2 : ℕ)) +
        B.sum (fun i => deg i ^ (2 : ℕ)) := by
          exact Finset.sum_union hdisj
    _ = A.card * a ^ (2 : ℕ) + B.card * u ^ (2 : ℕ) := by
          rw [hsumA, hsumB]
    _ = countA * a ^ (2 : ℕ) + countU * u ^ (2 : ℕ) := by
          rw [← hcardA, ← hcardU]


