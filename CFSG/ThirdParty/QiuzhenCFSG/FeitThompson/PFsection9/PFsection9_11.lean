        hτ hχY (hYirr χ hχY)
    · rcases h52 with ⟨_hsetup, _R, _h52a, _h52b, h52c, _h52d, _h52e⟩
      intro φ ψ hφ hψ hne
      rcases Finset.mem_image.mp hφ with ⟨χ, hχY, rfl⟩
      rcases Finset.mem_image.mp hψ with ⟨η, hηY, rfl⟩
      rw [Section5.isCFLinearIsometryOnSpan_apply_of_mem hτ.1 hχY hηY]
      exact h52c (hYS hχY) (hYS hηY) (by
        intro hχη
        exact hne (by simp [hχη]))

/-- A coherent extension is injective on an irreducible subfamily, hence the
image has the same cardinality. -/
private theorem card_image_coherentExtension_eq_sec9
    {G L : Type u} [Group G] [Finite G] [DecidableEq (Section1.ClassFunction G)]
    [Group L] [Finite L]
    {S Y : Finset (Section1.ClassFunction L)}
    {T τ : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G}
    (h52 : Section5.hypothesis_5_2_statement S T)
    (hYS : Y ⊆ S)
    (hYirr : ∀ χ : Section1.ClassFunction L, χ ∈ Y →
      Section1.IsIrreducibleCharacterOnGroup χ)
    (hτ : Section6.coherentExtension Y T τ) :
    (Y.image τ).card = Y.card := by
    classical
    rcases h52 with ⟨_hsetup, _R, _h52a, _h52b, h52c, _h52d, _h52e⟩
    have hinj :
        ∀ ⦃χ η : Section1.ClassFunction L⦄,
          χ ∈ Y → η ∈ Y → τ χ = τ η → χ = η := by
      intro χ η hχY hηY hτη
      by_contra hχne
      have hχη_zero : Section1.scalarProduct L χ η = 0 :=
        h52c (hYS hχY) (hYS hηY) hχne
      have hχself : Section1.scalarProduct L χ χ = 1 := by
        rcases hYirr χ hχY with ⟨_n, ρ, hρirr, hχeq⟩
        rw [hχeq]
        exact Section1.scalarProduct_representation_char_self ρ hρirr
      have hτχη : Section1.scalarProduct G (τ χ) (τ η) = 0 := by
        rw [Section5.isCFLinearIsometryOnSpan_apply_of_mem hτ.1 hχY hηY,
          hχη_zero]
      have hτχself : Section1.scalarProduct G (τ χ) (τ χ) = 1 := by
        rw [Section5.isCFLinearIsometryOnSpan_apply_of_mem hτ.1 hχY hχY,
          hχself]
      have hzero_one : (0 : ℂ) = 1 := by
        calc
          (0 : ℂ) = Section1.scalarProduct G (τ χ) (τ η) := hτχη.symm
          _ = Section1.scalarProduct G (τ χ) (τ χ) := by rw [hτη]
          _ = 1 := hτχself
      exact zero_ne_one hzero_one
    exact Finset.card_image_of_injOn (by
      intro χ hχY η hηY hτη
      exact hinj hχY hηY hτη)

/-- A coherent extension on a larger family restricts to a coherent extension
on a subfamily. -/
private theorem coherentExtension_mono_sec9
    {G L : Type u} [Group G] [Finite G] [Group L] [Finite L]
    {S1 S2 : Finset (Section1.ClassFunction L)}
