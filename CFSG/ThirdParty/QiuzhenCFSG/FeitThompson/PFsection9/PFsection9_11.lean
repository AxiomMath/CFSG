private theorem subgroup_inv_smul_mem_of_smul_mem_finite_sec9
  {A X : Type u} [Group A] [Group X] [Finite X] [MulDistribMulAction A X]
  (K : Subgroup X) (a : A)
  (haK : ∀ x : X, x ∈ K → a • x ∈ K) :
  ∀ x : X, x ∈ K → a⁻¹ • x ∈ K := by
  classical
  letI : Fintype K := Fintype.ofFinite K
  let f : K → K := fun x => ⟨a • (x : X), haK (x : X) x.property⟩
  have hf_inj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    have hval := congrArg Subtype.val hxy
    dsimp [f] at hval
    calc
      (x : X) = a⁻¹ • (a • (x : X)) := by simp [smul_smul]
      _ = a⁻¹ • (a • (y : X)) := by rw [hval]
      _ = (y : X) := by simp [smul_smul]
  have hf_surj : Function.Surjective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hf_inj, rfl⟩ |>.2
  intro x hx
  rcases hf_surj ⟨x, hx⟩ with ⟨y, hy⟩
  have hval := congrArg Subtype.val hy
  dsimp [f] at hval
  have hyx : a⁻¹ • x = (y : X) := by
    calc
      a⁻¹ • x = a⁻¹ • (a • (y : X)) := by rw [hval]
      _ = (y : X) := by simp [smul_smul]
  simp [hyx]

private theorem subgroup_smul_mem_of_generator_smul_mem_finite_sec9
  {A X : Type u} [Group A] [Group X] [Finite X] [MulDistribMulAction A X]
  (K : Subgroup X) (a : A)
  (hagen : Subgroup.zpowers a = ⊤)
  (haK : ∀ x : X, x ∈ K → a • x ∈ K) :
  ∀ b : A, ∀ x : X, x ∈ K → b • x ∈ K := by
  classical
  let N : Subgroup A :=
    { carrier := {b | ∀ x : X, x ∈ K → b • x ∈ K}
      one_mem' := by
        intro x hx
        simpa using hx
      mul_mem' := by
        intro b c hb hc x hx
        simpa [smul_smul] using hb (c • x) (hc x hx)
      inv_mem' := by
        intro b hb x hx
        exact subgroup_inv_smul_mem_of_smul_mem_finite_sec9 K b hb x hx }
  have haN : a ∈ N := by
    exact haK
  intro b x hx
  have hb_zpowers : b ∈ Subgroup.zpowers a := by
    rw [hagen]
    exact Subgroup.mem_top b
  have hbN : b ∈ N := (Subgroup.zpowers_le_of_mem haN) hb_zpowers
  exact hbN x hx

