private theorem theorem_9_11_case_a_irreducible_subfamily_weighted_sum_lower_sec9
  {G : Type u} [Group G] [Finite G]
  (M W1 : Subgroup G)
  (I S2 : Finset (Section1.ClassFunction M))
  (a lower : ℕ)
  (dS2 : S2 → ℕ) :
  lower ≤ I.card →
    I ⊆ S2 →
      (∀ χ : Section1.ClassFunction M, χ ∈ I →
        Section1.IsIrreducibleCharacterOnGroup χ ∧
          Section1.degree χ = ((Nat.card W1 * a) : ℂ)) →
        (∀ Y : S2,
          Section1.degree (Y : Section1.ClassFunction M) = (dS2 Y : ℂ)) →
          (lower : ℝ) * (((Nat.card W1 * a : ℝ) ^ (2 : ℕ))) ≤
            ∑ Y : S2,
              (((dS2 Y : ℝ) ^ (2 : ℕ)) /
                Section5.cfNormSq (Y : Section1.ClassFunction M)) := by
  classical
  intro hcard hIS2 hIchar hdegS2
  let term : S2 → ℝ := fun Y =>
    (((dS2 Y : ℝ) ^ (2 : ℕ)) /
      Section5.cfNormSq (Y : Section1.ClassFunction M))
  let emb : I → S2 := fun χ => ⟨(χ : Section1.ClassFunction M), hIS2 χ.property⟩
  have hterm_nonneg : ∀ Y : S2, 0 ≤ term Y := by
    intro Y
    exact div_nonneg (sq_nonneg (dS2 Y : ℝ))
      (Section5.cfNormSq_nonneg (Y : Section1.ClassFunction M))
  have hterm_emb :
      ∀ χ : I, term (emb χ) = ((Nat.card W1 * a : ℝ) ^ (2 : ℕ)) := by
    intro χ
    have hdegree := (hIchar (χ : Section1.ClassFunction M) χ.property).2
    have hdeg_eq : dS2 (emb χ) = Nat.card W1 * a := by
      have hcast : (dS2 (emb χ) : ℂ) = ((Nat.card W1 * a) : ℂ) := by
        rw [← hdegS2 (emb χ), hdegree]
      exact_mod_cast hcast
    have hcf :
        Section5.cfNormSq (χ : Section1.ClassFunction M) = 1 :=
      cfNormSq_eq_one_of_isIrreducibleCharacterOnGroup_sec9
        (hIchar (χ : Section1.ClassFunction M) χ.property).1
    simp [term, emb, hdeg_eq, hcf]
  have himage_sum :
      (∑ η ∈ ((Finset.univ : Finset I).image emb), term η) =
        ∑ χ : I, term (emb χ) := by
    rw [Finset.sum_image]
    intro x _hx y _hy hxy
    exact Subtype.ext (by simpa [emb] using congrArg Subtype.val hxy)
  have hsubset :
      ((Finset.univ : Finset I).image emb) ⊆
        (Finset.univ : Finset S2) := by
    intro η _hη
    simp
  have hsum_image_le :
      (∑ η ∈ ((Finset.univ : Finset I).image emb), term η) ≤
        ∑ η : S2, term η := by
    simpa using Finset.sum_le_sum_of_subset_of_nonneg hsubset
      (by intro η _hηuniv _hηnot; exact hterm_nonneg η)
  have hsum_const :
      (∑ χ : I, term (emb χ)) =
        (I.card : ℝ) * (((Nat.card W1 * a : ℝ) ^ (2 : ℕ))) := by
    simp [hterm_emb]
  have hcard_real : (lower : ℝ) ≤ (I.card : ℝ) := by
    exact_mod_cast hcard
  have hsq_nonneg : 0 ≤ ((Nat.card W1 * a : ℝ) ^ (2 : ℕ)) :=
    sq_nonneg (Nat.card W1 * a : ℝ)
  calc
    (lower : ℝ) * (((Nat.card W1 * a : ℝ) ^ (2 : ℕ))) ≤
        (I.card : ℝ) * (((Nat.card W1 * a : ℝ) ^ (2 : ℕ))) :=
      mul_le_mul_of_nonneg_right hcard_real hsq_nonneg
    _ = ∑ χ : I, term (emb χ) := hsum_const.symm
    _ = ∑ η ∈ ((Finset.univ : Finset I).image emb), term η := himage_sum.symm
    _ ≤ ∑ η : S2, term η := hsum_image_le

private theorem theorem_9_11_case_a_cancel_initial_weighted_bound_sec9
  (q a count dX v : ℕ) :
  0 < q →
    0 < a →
      dX = q * v →
