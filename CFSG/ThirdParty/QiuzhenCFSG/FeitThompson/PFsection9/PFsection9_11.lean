private theorem finset_univ_eq_image_of_sum_eq_card_mul_of_pos_sec9
  {α β : Type*} [Fintype α] [Fintype β]
  (emb : β → α) (term : α → ℝ) (c : ℝ) (lower : ℕ) :
  Function.Injective emb →
    (∀ x : α, 0 < term x) →
      (∀ y : β, term (emb y) = c) →
        0 < c →
          lower ≤ Fintype.card β →
            (∑ x : α, term x) = (lower : ℝ) * c →
              Function.Surjective emb ∧ Fintype.card β = lower := by
  classical
  intro hinj hterm_pos hterm_emb hc hlower hsum
  let image : Finset α := (Finset.univ : Finset β).image emb
  have hterm_nonneg : ∀ x : α, 0 ≤ term x := fun x => (hterm_pos x).le
  have hsum_image :
      image.sum term = (Fintype.card β : ℝ) * c := by
    dsimp [image]
    rw [Finset.sum_image]
    · simp [hterm_emb]
    · intro x _hx y _hy hxy
      exact hinj hxy
  have hsum_image_le_total : image.sum term ≤ ∑ x : α, term x := by
    simpa using
      Finset.sum_le_sum_of_subset_of_nonneg
        (by intro x _hx; simp)
        (by intro x _hxuniv _hximage; exact hterm_nonneg x)
  have hcard_le_lower : Fintype.card β ≤ lower := by
    have hmul_le :
        (Fintype.card β : ℝ) * c ≤ (lower : ℝ) * c := by
      simpa [hsum_image, hsum] using hsum_image_le_total
    have hcard_le_lower_real : (Fintype.card β : ℝ) ≤ (lower : ℝ) :=
      le_of_mul_le_mul_right hmul_le hc
    exact_mod_cast hcard_le_lower_real
  have hcard_eq : Fintype.card β = lower := le_antisymm hcard_le_lower hlower
  refine ⟨?_, hcard_eq⟩
  by_contra hnot_surj
  rw [Function.Surjective] at hnot_surj
  push Not at hnot_surj
  rcases hnot_surj with ⟨x, hxnot⟩
  have hx_not_image : x ∉ image := by
    intro hx
    rcases Finset.mem_image.mp hx with ⟨y, _hy, hyx⟩
    exact hxnot y hyx
  have hsum_insert_le_total : (insert x image).sum term ≤ ∑ y : α, term y := by
    simpa using
      Finset.sum_le_sum_of_subset_of_nonneg
        (by intro y _hy; simp)
        (by intro y _hyuniv _hyinsert; exact hterm_nonneg y)
  have hsum_insert :
      (insert x image).sum term = term x + image.sum term := by
    rw [Finset.sum_insert hx_not_image]
  have hle : term x + (lower : ℝ) * c ≤ (lower : ℝ) * c := by
    simpa [hsum_insert, hsum_image, hsum, hcard_eq] using hsum_insert_le_total
  nlinarith [hterm_pos x]

private theorem finset_sdiff_nonempty_of_subset_ne_sec9
