private theorem factor_kernel_conjBy_inv_eq_of_conjugate_centralizers_sec9
    {G : Type u} [Group G] [Finite G]
    {MF H0 U C : Subgroup G}
    [hnormalH0 : (H0.subgroupOf MF).Normal]
    [(C.subgroupOf U).Normal]
    {Q R : Subgroup (MF ⧸ H0.subgroupOf MF)} {w : G}
    (hQR : quotientSubgroupConjugateByElement MF H0 Q R w)
    (hw_normU : w ∈ Subgroup.normalizer (U : Set G))
    {ρQ : (U ⧸ C.subgroupOf U) →* MulAut Q}
    {ρR : (U ⧸ C.subgroupOf U) →* MulAut R}
    {UQ UR : Subgroup G}
    (hUQ_le_U : UQ ≤ U)
    (hUR_le_U : UR ≤ U)
    (hC_le_UQ : C ≤ UQ)
    (hC_le_UR : C ≤ UR)
    (hUQ_centralizes :
      ∀ x : G, x ∈ UQ → quotientSubgroupCentralizedByElement MF H0 Q x)
    (hUR_centralizes :
      ∀ x : G, x ∈ UR → quotientSubgroupCentralizedByElement MF H0 R x)
    (hUQ_kernel_iff :
      ∀ x : U, ((x : G) ∈ UQ ↔
        ρQ (QuotientGroup.mk' (C.subgroupOf U) x) = 1))
    (hUR_kernel_iff :
      ∀ x : U, ((x : G) ∈ UR ↔
        ρR (QuotientGroup.mk' (C.subgroupOf U) x) = 1))
    (hρQker :
      ∀ x : U ⧸ C.subgroupOf U,
        ρQ x = 1 ↔
          ∀ u : U, QuotientGroup.mk' (C.subgroupOf U) u = x →
            quotientSubgroupCentralizedByElement MF H0 Q (u : G))
    (hρRker :
      ∀ x : U ⧸ C.subgroupOf U,
        ρR x = 1 ↔
          ∀ u : U, QuotientGroup.mk' (C.subgroupOf U) u = x →
            quotientSubgroupCentralizedByElement MF H0 R (u : G)) :
    UR = UQ.conjBy w⁻¹ := by
    classical
    apply le_antisymm
    · intro x hxUR
      have hxU : x ∈ U := hUR_le_U hxUR
      have hconjU : w * x * w⁻¹ ∈ U :=
        (Subgroup.mem_normalizer_iff.mp hw_normU x).1 hxU
      let y : U := ⟨w * x * w⁻¹, hconjU⟩
      have hcentR : quotientSubgroupCentralizedByElement MF H0 R x :=
        hUR_centralizes x hxUR
      have hcentQ : quotientSubgroupCentralizedByElement MF H0 Q (w * x * w⁻¹) :=
        quotientSubgroupCentralizedByElement_conjugate_source_of_target_sec9
          hQR hcentR
      have hyUQ : (y : G) ∈ UQ :=
        factor_kernel_mem_of_quotientSubgroupCentralizedByElement_sec9
          hC_le_UQ hUQ_centralizes hUQ_kernel_iff hρQker y hcentQ
      rw [Subgroup.conjBy]
      refine ⟨w * x * w⁻¹, hyUQ, ?_⟩
      simp
      group
    · intro x hxConj
      have hxConj_mem : w * x * w⁻¹ ∈ UQ := by
        rw [Subgroup.conjBy] at hxConj
        rcases hxConj with ⟨y, hy, hyx⟩
        simp at hyx
        have hy_eq : y = w * x * w⁻¹ := by
          calc
            y = w * (w⁻¹ * y * w) * w⁻¹ := by group
            _ = w * x * w⁻¹ := by rw [hyx]
        simpa [hy_eq] using hy
      have hconjU : w * x * w⁻¹ ∈ U := hUQ_le_U hxConj_mem
      have hxU : x ∈ U := (Subgroup.mem_normalizer_iff.mp hw_normU x).2 hconjU
      let xu : U := ⟨x, hxU⟩
      have hcentQ : quotientSubgroupCentralizedByElement MF H0 Q (w * x * w⁻¹) :=
        hUQ_centralizes (w * x * w⁻¹) hxConj_mem
      have hcentR : quotientSubgroupCentralizedByElement MF H0 R (x : G) :=
        quotientSubgroupCentralizedByElement_of_conjugate_source_sec9 hQR hcentQ
      exact
        factor_kernel_mem_of_quotientSubgroupCentralizedByElement_sec9
          hC_le_UR hUR_centralizes hUR_kernel_iff hρRker xu hcentR

