private theorem theorem_9_11_case_a_odd_dvd_prime_sub_one_le_half_sec9
  {p a : ℕ} :
  Nat.Prime p →
    p ≠ 2 →
      Odd a →
        a ∣ p - 1 →
          a ≤ (p - 1) / 2 := by
  intro hp hp_ne_two haOdd haDiv
  rcases haDiv with ⟨m, hm⟩
  have hp_gt_one : 1 < p := hp.one_lt
  have hp_pred_pos : 0 < p - 1 := Nat.sub_pos_of_lt hp_gt_one
  have hpOdd : Odd p := hp.odd_of_ne_two hp_ne_two
  have hp_pred_even : Even (p - 1) := by
    rcases hpOdd with ⟨b, hb⟩
    rw [hb, Nat.add_sub_cancel]
    exact even_two_mul b
  have hm_even : Even m := by
    rw [← Nat.not_odd_iff_even]
    intro hmOdd
    have hprod_odd : Odd (a * m) := haOdd.mul hmOdd
    exact (Nat.not_odd_iff_even.mpr hp_pred_even) (by
      simpa [hm] using hprod_odd)
  rcases hm_even with ⟨r, hr⟩
  subst m
  have hr_pos : 0 < r := by
    by_contra hrpos
    have hr0 : r = 0 := by omega
    have : p - 1 = 0 := by simpa [hr0] using hm
    omega
  have hm_ge_two : 2 ≤ r + r := by omega
  have htwo_a_le_pred : 2 * a ≤ p - 1 := by
    calc
      2 * a = a * 2 := by omega
      _ ≤ a * (r + r) := Nat.mul_le_mul_left a hm_ge_two
      _ = p - 1 := hm.symm
  omega

