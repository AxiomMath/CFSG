private theorem product_subgroup_nonidentity_fiber_card_sec9
    {L W : Type*} [Group L] [Fintype L] [Fintype W]
    [DecidableEq L] [DecidableEq W]
    (H : Subgroup L) [DecidablePred (fun x : L => x ∈ H)] (w : W) :
    ((Finset.univ : Finset (L × W)).filter
      (fun x => x.1 ∈ H ∧ x.1 ≠ 1 ∧ x.2 = w)).card =
      Nat.card H - 1 := by
    classical
    let e : H ↪ L × W :=
      { toFun := fun h => ((h : L), w)
        inj' := by
          intro x y hxy
          exact Subtype.ext (congrArg Prod.fst hxy) }
    have hpiece_eq :
        (Finset.univ : Finset (L × W)).filter
          (fun x => x.1 ∈ H ∧ x.1 ≠ 1 ∧ x.2 = w) =
        ((Finset.univ : Finset H).erase 1).map e := by
      ext x
      constructor
      · intro hx
        rw [Finset.mem_filter] at hx
        rcases hx with ⟨_hxuniv, hxH, hxne, hxw⟩
        rw [Finset.mem_map]
        refine ⟨⟨x.1, hxH⟩, ?_, ?_⟩
        · rw [Finset.mem_erase]
          constructor
          · intro h
            apply hxne
            exact congrArg Subtype.val h
          · simp
        · apply Prod.ext
          · rfl
          · exact hxw.symm
      · intro hx
        rw [Finset.mem_map] at hx
        rcases hx with ⟨h, hh, h_eq⟩
        rw [Finset.mem_erase] at hh
        rcases hh with ⟨hhne, _hhuniv⟩
        rw [Finset.mem_filter]
        refine ⟨by simp, ?_, ?_, ?_⟩
        · have hx_eq : x = ((h : L), w) := h_eq.symm
          simp [hx_eq, h.property]
        · have hx_eq : x = ((h : L), w) := h_eq.symm
          intro hx1
          apply hhne
          apply Subtype.ext
          simpa [hx_eq] using hx1
        · have hx_eq : x = ((h : L), w) := h_eq.symm
          simp [hx_eq]
    rw [hpiece_eq, Finset.card_map]
    rw [Finset.card_erase_of_mem]
    · change Fintype.card H - 1 = Nat.card H - 1
      rw [Fintype.card_eq_nat_card]
    · simp

private theorem product_subgroup_nonidentity_fiber_pairwiseDisjoint_sec9
    {L W : Type*} [Group L] [Fintype L] [Fintype W]
    [DecidableEq L] [DecidableEq W]
    (H : Subgroup L) [DecidablePred (fun x : L => x ∈ H)] :
    ((Finset.univ : Finset W) : Set W).PairwiseDisjoint
      (fun w => (Finset.univ : Finset (L × W)).filter
        (fun x => x.1 ∈ H ∧ x.1 ≠ 1 ∧ x.2 = w)) := by
    classical
    intro w _hw z _hz hwz
    dsimp [Function.onFun]
    exact (Finset.disjoint_left).2 (by
      intro x hxw hxz
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hxw hxz
      exact hwz (hxw.2.2.symm.trans hxz.2.2))

private theorem one_not_mem_biUnion_product_subgroup_nonidentity_fiber_sec9
    {L W : Type*} [Group L] [Group W] [Fintype L] [Fintype W]
    [DecidableEq L] [DecidableEq W]
    (H : Subgroup L) [DecidablePred (fun x : L => x ∈ H)] :
