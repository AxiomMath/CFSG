private theorem sum_natCard_inf_conjBy_eq_of_ti_sec9
    {G : Type u} [Group G] [Finite G]
    (U1 C W1 : Subgroup G) [Fintype W1]
    (hti : ∀ w : W1, w ≠ 1 → U1 ⊓ U1.conjBy (w : G) = C) :
    (∑ w : W1, Nat.card ↥(U1 ⊓ U1.conjBy (w : G))) =
      Nat.card U1 + (Nat.card W1 - 1) * Nat.card C := by
    classical
    let f : W1 → ℕ := fun w => Nat.card ↥(U1 ⊓ U1.conjBy (w : G))
    have hone : (1 : W1) ∈ (Finset.univ : Finset W1) := Finset.mem_univ _
    have hsplit := Finset.sum_erase_add (s := (Finset.univ : Finset W1))
      (f := f) hone
    have hfirst : f 1 = Nat.card U1 := by
      dsimp [f]
      simp [Subgroup.conjBy_one]
    have herase : (Finset.univ.erase (1 : W1)).card = Nat.card W1 - 1 := by
      rw [Finset.card_erase_of_mem hone]
      simp [Nat.card_eq_fintype_card]
    have hsum_erase :
        (Finset.univ.erase (1 : W1)).sum f =
          (Nat.card W1 - 1) * Nat.card C := by
      calc
        (Finset.univ.erase (1 : W1)).sum f =
            (Finset.univ.erase (1 : W1)).sum
              (fun _ : W1 => Nat.card C) := by
              refine Finset.sum_congr rfl ?_
              intro w hw
              dsimp [f]
              have hw_ne : w ≠ 1 := Finset.ne_of_mem_erase hw
              rw [hti w hw_ne]
        _ = (Nat.card W1 - 1) * Nat.card C := by
          rw [Finset.sum_const, herase]
          simp
    calc
      (∑ w : W1, Nat.card ↥(U1 ⊓ U1.conjBy (w : G))) =
          (Finset.univ : Finset W1).sum f := rfl
      _ = (Finset.univ.erase (1 : W1)).sum f + f 1 := hsplit.symm
      _ = Nat.card U1 + (Nat.card W1 - 1) * Nat.card C := by
        rw [hsum_erase, hfirst]
        omega


private theorem sum_natCard_inf_conjBy_eq_card_mul_div_add_of_ti_sec9
    {G : Type u} [Group G] [Finite G]
    (C U U1 W1 : Subgroup G) [Fintype W1] (a u : ℕ) :
    C ≤ U1 →
      U1 ≤ U →
        C.relIndex U = u →
          U1.relIndex U = a →
            0 < a →
              (∀ w : W1, w ≠ 1 → U1 ⊓ U1.conjBy (w : G) = C) →
                (∑ w : W1, Nat.card ↥(U1 ⊓ U1.conjBy (w : G))) =
                  (u / a + (Nat.card W1 - 1)) * Nat.card C := by
    intro hC_le_U1 hU1_le_U hCindex hU1index ha_pos hti
    have hsum := sum_natCard_inf_conjBy_eq_of_ti_sec9 U1 C W1 hti
    have hrel_mul :
        C.relIndex U1 * U1.relIndex U = C.relIndex U :=
