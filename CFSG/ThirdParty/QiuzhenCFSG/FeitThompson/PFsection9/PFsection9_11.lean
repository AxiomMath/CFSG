private theorem scalarProduct_sum_signedOrthonormal_member_sec9
    {G : Type u} [Group G] [Finite G]
    {R : Finset (Section1.ClassFunction G)}
    (hR : Section5.signedOrthonormalFinset R)
    {φ : Section1.ClassFunction G}
