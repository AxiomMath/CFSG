private theorem cfNormSq_eq_of_card_sum_normSq_scale_sec9
    {G L : Type*} [Group G] [Finite G] [Group L] [Finite L]
    (φ : Section1.ClassFunction G) (ψ : Section1.ClassFunction L)
    (c : ℕ)
    (hcard : Nat.card G = c * Nat.card L)
    (hsum :
      ((@Finset.univ G (Fintype.ofFinite G)).sum
          (fun g => Complex.normSq (φ g))) =
        (c : ℝ) *
          ((@Finset.univ L (Fintype.ofFinite L)).sum
            (fun x => Complex.normSq (ψ x)))) :
    Section5.cfNormSq φ = Section5.cfNormSq ψ := by
    rw [Section5.cfNormSq_eq_inv_card_mul_sum_normSq,
      Section5.cfNormSq_eq_inv_card_mul_sum_normSq]
    change
      (Nat.card G : ℝ)⁻¹ *
          ((@Finset.univ G (Fintype.ofFinite G)).sum
            (fun g => Complex.normSq (φ g))) =
        (Nat.card L : ℝ)⁻¹ *
          ((@Finset.univ L (Fintype.ofFinite L)).sum
            (fun x => Complex.normSq (ψ x)))
    rw [hcard, hsum]
    rw [Nat.cast_mul]
    have hc : (c : ℝ) ≠ 0 := by
      have hG_ne : Nat.card G ≠ 0 := (Nat.card_pos (α := G)).ne'
      have hc_ne : c ≠ 0 := by
        intro hc0
        apply hG_ne
        rw [hcard, hc0, zero_mul]
      exact_mod_cast hc_ne
    have hL : (Nat.card L : ℝ) ≠ 0 := by
      exact_mod_cast (Nat.card_pos (α := L)).ne'
    field_simp [hc, hL]

private theorem sum_normSq_eq_card_mul_sum_of_fiberwise_const_sec9
    {A B : Type*} [Fintype A] [Fintype B] [DecidableEq B]
    (π : A → B) (φ : A → ℂ) (ψ : B → ℂ) (c : ℕ)
    (hfiber :
      ∀ b : B,
        ((Finset.univ : Finset A).filter (fun a => π a = b)).card = c)
    (hpoint :
      ∀ a : A, Complex.normSq (φ a) = Complex.normSq (ψ (π a))) :
    (∑ a : A, Complex.normSq (φ a)) =
      (c : ℝ) * ∑ b : B, Complex.normSq (ψ b) := by
    classical
    rw [← Finset.sum_fiberwise (s := (Finset.univ : Finset A))
      (g := π) (f := fun a => Complex.normSq (φ a))]
    calc
      (∑ b : B,
          ∑ a ∈ (Finset.univ : Finset A) with π a = b,
            Complex.normSq (φ a)) =
          ∑ b : B, (c : ℝ) * Complex.normSq (ψ b) := by
            refine Finset.sum_congr rfl ?_
            intro b _hb
            have hfiber_const :
                (∑ a ∈ (Finset.univ : Finset A) with π a = b,
                    Complex.normSq (φ a)) =
                  (((Finset.univ : Finset A).filter
                      (fun a => π a = b)).card : ℝ) *
                    Complex.normSq (ψ b) := by
              rw [Finset.sum_filter]
              calc
                (∑ a ∈ (Finset.univ : Finset A),
                    if π a = b then Complex.normSq (φ a) else 0) =
                    ∑ a ∈ (Finset.univ : Finset A),
                      if π a = b then Complex.normSq (ψ b) else 0 := by
                      refine Finset.sum_congr rfl ?_
                      intro a _ha
                      by_cases haπ : π a = b
                      · simp [haπ, hpoint a]
                      · simp [haπ]
                _ =
                    (∑ a ∈ (Finset.univ : Finset A) with π a = b,
                      Complex.normSq (ψ b)) := by
                      rw [Finset.sum_filter]
                _ =
                    (((Finset.univ : Finset A).filter
                        (fun a => π a = b)).card : ℝ) *
                      Complex.normSq (ψ b) := by
                      simp
            rw [hfiber_const, hfiber b]
      _ = (c : ℝ) * ∑ b : B, Complex.normSq (ψ b) := by
          rw [Finset.mul_sum]

private theorem quotient_mk_fiber_card_eq_sec9
    {G : Type*} [Group G] [Fintype G]
    (H : Subgroup G) [H.Normal] [DecidableEq (G ⧸ H)]
    (q : G ⧸ H) :
    ((Finset.univ : Finset G).filter
      (fun x => QuotientGroup.mk' H x = q)).card = Nat.card H := by
    classical
    rcases QuotientGroup.mk'_surjective H q with ⟨g, hg⟩
    let e : H ≃ {x : G // QuotientGroup.mk' H x = q} :=
      { toFun := fun h => by
          refine ⟨g * (h : G), ?_⟩
          have hh : QuotientGroup.mk' H (h : G) = 1 :=
            (QuotientGroup.eq_one_iff (N := H) (h : G)).2 h.property
          calc
            QuotientGroup.mk' H (g * (h : G)) =
                QuotientGroup.mk' H g * QuotientGroup.mk' H (h : G) := by simp
            _ = q * 1 := by rw [hg, hh]
            _ = q := by simp
        invFun := fun x => by
          refine ⟨g⁻¹ * (x : G), ?_⟩
          have hq : QuotientGroup.mk' H (g⁻¹ * (x : G)) = 1 := by
            calc
              QuotientGroup.mk' H (g⁻¹ * (x : G)) =
                  (QuotientGroup.mk' H g)⁻¹ * QuotientGroup.mk' H (x : G) := by
                    simp
              _ = q⁻¹ * q := by rw [hg, x.property]
              _ = 1 := by simp
          exact (QuotientGroup.eq_one_iff (N := H) (g⁻¹ * (x : G))).1 hq
        left_inv := fun h => by
          ext
          simp
        right_inv := fun x => by
          ext
          simp }
    let p : G → Prop := fun x => QuotientGroup.mk' H x = q
    have hsub :
        Fintype.card {x : G // p x} =
          ((Finset.univ : Finset G).filter p).card :=
      Fintype.card_subtype p
    calc
      ((Finset.univ : Finset G).filter
          (fun x => QuotientGroup.mk' H x = q)).card =
          Fintype.card {x : G // p x} := hsub.symm
      _ = Fintype.card H := Fintype.card_congr e.symm
      _ = Nat.card H := by rw [Nat.card_eq_fintype_card]

private theorem card_filter_eq_card_mul_card_filter_of_fiberwise_iff_sec9
    {A B : Type*} [Fintype A] [Fintype B] [DecidableEq B]
    (π : A → B) (p : A → Prop) (q : B → Prop)
    [DecidablePred p] [DecidablePred q] (c : ℕ)
    (hfiber :
      ∀ b : B,
        ((Finset.univ : Finset A).filter (fun a => π a = b)).card = c)
    (hpq : ∀ a : A, p a ↔ q (π a)) :
    ((Finset.univ : Finset A).filter p).card =
      c * ((Finset.univ : Finset B).filter q).card := by
    classical
    have hcard_sum :
        ((Finset.univ : Finset A).filter p).card =
          ∑ a : A, if p a then 1 else 0 := by
      simp
    rw [hcard_sum]
    rw [← Finset.sum_fiberwise (s := (Finset.univ : Finset A))
      (g := π) (f := fun a => if p a then (1 : ℕ) else 0)]
    calc
      (∑ b : B,
          ∑ a ∈ (Finset.univ : Finset A) with π a = b,
            if p a then (1 : ℕ) else 0) =
          ∑ b : B, if q b then c else 0 := by
            refine Finset.sum_congr rfl ?_
            intro b _hb
            by_cases hbq : q b
            · have hinner :
                  (∑ a ∈ (Finset.univ : Finset A) with π a = b,
                    if p a then (1 : ℕ) else 0) =
                  ((Finset.univ : Finset A).filter (fun a => π a = b)).card := by
                rw [Finset.sum_filter]
                calc
                  (∑ a ∈ (Finset.univ : Finset A),
                      if π a = b then if p a then (1 : ℕ) else 0 else 0) =
                      ∑ a ∈ (Finset.univ : Finset A),
                        if π a = b then (1 : ℕ) else 0 := by
                        refine Finset.sum_congr rfl ?_
                        intro a _ha
                        by_cases haπ : π a = b
                        · have hpa : p a := (hpq a).2 (by simpa [haπ] using hbq)
                          rw [if_pos haπ, if_pos hpa, if_pos haπ]
                        · rw [if_neg haπ, if_neg haπ]
                  _ = ((Finset.univ : Finset A).filter (fun a => π a = b)).card := by
                        simp
              rw [hinner, hfiber b, if_pos hbq]
            · have hinner :
                  (∑ a ∈ (Finset.univ : Finset A) with π a = b,
                    if p a then (1 : ℕ) else 0) = 0 := by
                rw [Finset.sum_filter]
                refine Finset.sum_eq_zero ?_
                intro a _ha
                by_cases haπ : π a = b
                · have hpa : ¬ p a := by
                    intro hpa
                    exact hbq (by simpa [haπ] using (hpq a).1 hpa)
                  rw [if_pos haπ, if_neg hpa]
                · rw [if_neg haπ]
              rw [hinner, if_neg hbq]
      _ = ((Finset.univ : Finset B).filter q).sum (fun _ => c) := by
          rw [← Finset.sum_filter]
      _ = c * ((Finset.univ : Finset B).filter q).card := by
          rw [Finset.sum_const, nsmul_eq_mul]
          exact Nat.mul_comm _ _

private theorem card_filter_univ_equiv_symm_sec9
    {A B : Type*} [Fintype A] [Fintype B]
    (e : A ≃ B) (p : A → Prop)
    [DecidablePred p] [DecidablePred (fun b : B => p (e.symm b))] :
    ((Finset.univ : Finset A).filter p).card =
      ((Finset.univ : Finset B).filter (fun b => p (e.symm b))).card := by
    classical
    let φ : {a : A // p a} ≃ {b : B // p (e.symm b)} :=
      { toFun := fun a => ⟨e a, by simpa using a.property⟩
        invFun := fun b => ⟨e.symm b, b.property⟩
        left_inv := fun a => by ext; simp
        right_inv := fun b => by ext; simp }
    have hA :
        Fintype.card {a : A // p a} =
          ((Finset.univ : Finset A).filter p).card :=
      Fintype.card_subtype p
    have hB :
        Fintype.card {b : B // p (e.symm b)} =
          ((Finset.univ : Finset B).filter (fun b => p (e.symm b))).card :=
      Fintype.card_subtype (fun b : B => p (e.symm b))
    calc
      ((Finset.univ : Finset A).filter p).card =
          Fintype.card {a : A // p a} := hA.symm
      _ = Fintype.card {b : B // p (e.symm b)} := Fintype.card_congr φ
      _ = ((Finset.univ : Finset B).filter (fun b => p (e.symm b))).card := hB

private theorem conj_mem_subgroup_iff_quotient_conj_mem_map_sec9
    {G : Type*} [Group G] {N H : Subgroup G} [N.Normal]
    (hN_le_H : N ≤ H) (x g : G) :
    x * g * x⁻¹ ∈ H ↔
