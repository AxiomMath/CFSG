    · rintro ⟨h, hhH, hhq⟩
      have hq : QuotientGroup.mk' N h = QuotientGroup.mk' N (x * g * x⁻¹) := by
        simpa using hhq
      have hn : h⁻¹ * (x * g * x⁻¹) ∈ N :=
        (QuotientGroup.eq (s := N)).1 hq
      have hx_eq : x * g * x⁻¹ = h * (h⁻¹ * (x * g * x⁻¹)) := by
        group
      rw [hx_eq]
      exact H.mul_mem hhH (hN_le_H hn)

private theorem card_filter_conj_mem_eq_card_normal_mul_quotient_filter_conj_mem_sec9
    {G : Type*} [Group G] [Fintype G]
    (N H : Subgroup G) [N.Normal] [Fintype (G ⧸ N)]
    [DecidableEq (G ⧸ N)] (g : G)
    [DecidablePred (fun x : G => x * g * x⁻¹ ∈ H)]
