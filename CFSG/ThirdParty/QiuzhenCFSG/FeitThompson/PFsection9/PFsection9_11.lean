            q * (q - 1) * a ^ 2 :=
    theorem_9_11_case_a_9115_upper_bound_of_fractional_sec9
      p q a u (p ^ q - 1) hqpos hupos hfractional
  have hupper :
      p ^ q - 1 ≤
          (q * a + 2 * a + q) * u + q * (q - 1) * a ^ 2 + 2 * q * a :=
    theorem_9_11_case_a_9115_upper_bound_of_count_norm_sec9
      p q a u hp_eq hupper_raw
  have hlower :
      2 ^ q * a ^ q + 2 * q * (q - 1) * a ^ 2 + 2 * q * a ≤ p ^ q - 1 :=
    theorem_9_11_case_a_9115_binomial_lower_bound_sec9
      p q a hp_eq hapos hq_ge_three
