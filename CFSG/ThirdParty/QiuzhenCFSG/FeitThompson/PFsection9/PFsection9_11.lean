        Section3.IsSignedIrreducibleCharacter
          (τ3 (Section1.conjugateCharacter lam1)) :=
      Section6.theorem_6_8_coherentExtension_mem_signedIrreducible
        hτ3 hbarS3
        (Section1.isIrreducibleCharacterOnGroup_conjugateCharacter
          (hS4source_irreducible lam1 hlam1S4source))
    have hτ3sum :
        τ3 lam1 - τ3 (Section1.conjugateCharacter lam1) =
