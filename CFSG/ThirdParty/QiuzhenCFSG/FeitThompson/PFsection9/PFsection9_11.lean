public theorem integerSpan_mono_sec9
  {H : Type*} [Group H]
  {S1 S2 : Finset (Section1.ClassFunction H)}
  (hsub : S1 ⊆ S2)
  {χ : Section1.ClassFunction H} :
  Section5.integerSpan S1 χ → Section5.integerSpan S2 χ := by
  classical
  rintro ⟨v, rfl⟩
  let w : Section1.CoeffVector S2 := fun y =>
    if hy : (y : Section1.ClassFunction H) ∈ S1 then v ⟨y, hy⟩ else 0
  refine ⟨w, ?_⟩
  ext g
  have hsum := Finset.sum_subset
      (s₁ := S1) (s₂ := S2)
      (f := fun y : Section1.ClassFunction H =>
        (((if hy : y ∈ S1 then v ⟨y, hy⟩ else 0 : Int) : ℂ) * y g))
      hsub
      (by
        intro y _hyS2 hyS1
        simp [hyS1])
  simpa +contextual [Section1.evalCoeff, w, smul_eq_mul, ← S1.sum_attach,
    ← S2.sum_attach] using hsum

public theorem hypothesis_5_2_b_subset_sec9
  {L : Type u} [Group L] [Finite L]
  {G : Type u} [Group G] [Finite G]
  {S1 S : Finset (Section1.ClassFunction L)}
  (hsub : S1 ⊆ S)
  {T : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G}
  (h52b : Section5.hypothesis_5_2_b_statement S T) :
  Section5.hypothesis_5_2_b_statement S1 T := by
  constructor
  · intro φ ψ hφ hψ
    exact h52b.1 φ ψ
      ⟨integerSpan_mono_sec9 hsub hφ.1, hφ.2⟩
      ⟨integerSpan_mono_sec9 hsub hψ.1, hψ.2⟩
  · intro χ hχ
    exact h52b.2 χ ⟨integerSpan_mono_sec9 hsub hχ.1, hχ.2⟩

public theorem hypothesis_5_2_statement_subset_sec9
  {L : Type u} [Group L] [Finite L]
  {G : Type u} [Group G] [Finite G]
  {S1 S : Finset (Section1.ClassFunction L)}
  {T : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G}
  (hsub : S1 ⊆ S)
  (hne : S1.Nonempty)
  (hclosed : ∀ χ : Section1.ClassFunction L,
    χ ∈ S1 → Section1.conjugateCharacter χ ∈ S1) :
  Section5.hypothesis_5_2_statement S T →
    Section5.hypothesis_5_2_statement S1 T := by
  intro h52
  rcases h52 with ⟨hsetup, R, h52a, h52b, h52c, h52d, h52e⟩
  let R1 : S1 → Finset (Section1.ClassFunction G) := fun X =>
    R ⟨(X : Section1.ClassFunction L), hsub X.property⟩
  refine ⟨?_, R1, ?_, ?_, ?_, ?_, ?_⟩
  · exact ⟨hne, fun X => hsetup.2 ⟨(X : Section1.ClassFunction L), hsub X.property⟩⟩
  · intro X
    exact ⟨hclosed (X : Section1.ClassFunction L) X.property,
      (h52a ⟨(X : Section1.ClassFunction L), hsub X.property⟩).2⟩
  · exact hypothesis_5_2_b_subset_sec9 hsub h52b
  · intro χ ψ hχ hψ hneχψ
    exact h52c (hsub hχ) (hsub hψ) hneχψ
  · intro X
    exact h52d ⟨(X : Section1.ClassFunction L), hsub X.property⟩
  · intro X Y hYX hYXbar
    exact h52e ⟨(X : Section1.ClassFunction L), hsub X.property⟩
      ⟨(Y : Section1.ClassFunction L), hsub Y.property⟩ hYX hYXbar


public theorem hypothesis_5_2_statement_of_same_difference_transforms_sec9
  {L : Type u} [Group L] [Finite L]
  {G : Type u} [Group G] [Finite G]
  {S : Finset (Section1.ClassFunction L)}
  {T T0 : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G} :
  Section5.hypothesis_5_2_statement S T0 →
    Section5.hypothesis_5_2_b_statement S T →
      (∀ X : S,
        T ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L)) =
          T0 ((X : Section1.ClassFunction L) -
            Section1.conjugateCharacter (X : Section1.ClassFunction L))) →
        Section5.hypothesis_5_2_statement S T := by
  intro h52T0 h52bT hagree
  rcases h52T0 with ⟨hsetup, R, h52a, _h52bT0, h52c, h52dT0, h52e⟩
  refine ⟨hsetup, R, h52a, h52bT, h52c, ?_, h52e⟩
  intro X
  rw [hagree X]
  exact h52dT0 X

public theorem coherentFamilyForT_of_equal_degree_subfamily_sec9
  {G : Type u} [Group G] [Finite G]
  (M : Subgroup G)
  (S1 S : Finset (Section1.ClassFunction M))
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G) :
  S1 ⊆ S →
    S1.Nonempty →
      (∀ χ : Section1.ClassFunction M,
        χ ∈ S1 → Section1.conjugateCharacter χ ∈ S1) →
        Section5.hypothesis_5_2_statement S T →
          (∀ X Y : S1,
            Section1.degree (X : Section1.ClassFunction M) =
              Section1.degree (Y : Section1.ClassFunction M)) →
            coherentFamilyForT M S1 T := by
  intro hsub hne hclosed h52 hdeg
  rcases hypothesis_5_2_statement_subset_sec9 hsub hne hclosed h52 with
    ⟨hsetup, R, h52a, h52b, h52c, h52d, h52e⟩
  refine coherentFamilyForT_of_section5_equal_degree M S1 T ?_
  exact ⟨R, hsetup, h52a, h52b, h52c, h52d, h52e, hdeg⟩

