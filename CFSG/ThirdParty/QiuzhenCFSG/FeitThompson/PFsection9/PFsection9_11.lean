private theorem scalarProduct_eq_zero_of_orthogonalToFinset_integerSpan_sec9
  {G : Type u} [Group G] [Finite G]
  {R : Finset (Section1.ClassFunction G)}
  {φ ψ : Section1.ClassFunction G}
  (hφ : Section5.orthogonalToFinset R φ)
  (hψ : Section5.integerSpan R ψ) :
  Section1.scalarProduct G φ ψ = 0 := by
    classical
    rcases hψ with ⟨v, rfl⟩
    unfold Section1.evalCoeff
    have hsum :
        (∑ X : R, (v X : ℂ) • (X : Section1.ClassFunction G)) =
          (fun g : G => ∑ X : R,
            ((v X : ℂ) • (X : Section1.ClassFunction G)) g) := by
      ext g
      simp
    rw [hsum, Section1.scalarProduct_fintype_sum_right]
    refine Finset.sum_eq_zero ?_
    intro X _hX
    rw [Section1.scalarProduct_smul_right]
    simp [hφ X.property]

private theorem integerSpan_eq_zero_of_orthogonal_sec9
  {G : Type u} [Group G] [Finite G]
  {R : Finset (Section1.ClassFunction G)}
  (hR : Section5.signedOrthonormalFinset R)
  {φ : Section1.ClassFunction G}
  (hφspan : Section5.integerSpan R φ)
  (hφorth : Section5.orthogonalToFinset R φ) :
  φ = 0 := by
    classical
    letI := Classical.decEq R
    rcases hφspan with ⟨v, rfl⟩
    let μ : R → Section1.ClassFunction G := fun r => (r : Section1.ClassFunction G)
    have hμorth :
        ∀ a b : R,
          Section1.scalarProduct G (μ a) (μ b) = if a = b then 1 else 0 :=
      scalarProduct_eq_ite_of_signedOrthonormalFinset_sec9 hR
    have hvzero : ∀ r : R, v r = 0 := by
      intro r
      have hμbasis :
          Section1.evalCoeff μ (Section1.basisVector r) = μ r := by
        ext g
        rw [Section1.evalCoeff, Finset.sum_eq_single r]
        · simp [Section1.basisVector]
        · intro s _hs hsr
          simp [Section1.basisVector, hsr]
        · intro hrFalse
          exact (hrFalse (Finset.mem_univ _)).elim
      have hzero :
          Section1.scalarProduct G (Section1.evalCoeff μ v) (μ r) = 0 :=
        hφorth r.2
      rw [← hμbasis] at hzero
      have hcoeff :
          Section1.scalarProduct G (Section1.evalCoeff μ v)
              (Section1.evalCoeff μ (Section1.basisVector r)) =
            (Section1.coeffDot v (Section1.basisVector r) : ℂ) := by
        simpa using
          scalarProduct_evalCoeff_eq_coeffDot_of_orthonormal_sec9
            μ hμorth v (Section1.basisVector r)
      rw [hcoeff, Section1.coeffDot, Finset.sum_eq_single r] at hzero
      · simpa [Section1.basisVector] using hzero
      · intro s _hs hsr
        simp [Section1.basisVector, hsr]
      · intro hrFalse
        exact (hrFalse (Finset.mem_univ _)).elim
    ext g
    simp [Section1.evalCoeff, hvzero]

private theorem int_eq_zero_or_one_of_two_mul_nat_mul_sq_sub_le_one_sec9
    (z : ℤ) (c : ℕ) (hc : 0 < c)
    (h : (2 : ℝ) * (c : ℝ) * ((z : ℝ) ^ 2 - (z : ℝ)) ≤ 1) :
    z = 0 ∨ z = 1 := by
    have hprod_nonpos : z * (z - 1) ≤ 0 := by
      by_contra hnot
      have hpos : 0 < z * (z - 1) := lt_of_not_ge hnot
      have hzge : (1 : ℝ) ≤ (z * (z - 1) : ℤ) := by
        exact_mod_cast hpos
      have hc_real : (1 : ℝ) ≤ (c : ℝ) := by
        exact_mod_cast hc
      have hterm : ((z : ℝ) ^ 2 - (z : ℝ)) = (z * (z - 1) : ℤ) := by
        norm_num
        ring
      have hge :
          (2 : ℝ) ≤ (2 : ℝ) * (c : ℝ) * ((z : ℝ) ^ 2 - (z : ℝ)) := by
        rw [hterm]
        nlinarith [hc_real, hzge]
      nlinarith [h, hge]
    have hprod_nonneg : 0 ≤ z * (z - 1) := by
      by_cases hz0 : 0 ≤ z
      · by_cases hz1 : 1 ≤ z
        · exact mul_nonneg hz0 (by omega)
        · have hz : z = 0 := by omega
          simp [hz]
      · have hz_nonpos : z ≤ 0 := by omega
        have hz1_nonpos : z - 1 ≤ 0 := by omega
        exact mul_nonneg_of_nonpos_of_nonpos hz_nonpos hz1_nonpos
    have hzprod : z * (z - 1) = 0 := le_antisymm hprod_nonpos hprod_nonneg
    have hcases : z = 0 ∨ z - 1 = 0 :=
      Int.eq_zero_or_eq_zero_of_mul_eq_zero hzprod
    rcases hcases with hz | hz1
    · exact Or.inl hz
    · exact Or.inr (by omega)

