public theorem degreeSubfamily_equal_degree_sec9
  {G : Type u} [Group G]
  (M : Subgroup G)
  (S : Finset (Section1.ClassFunction M))
  (d : ℕ) :
  ∀ X Y : degreeSubfamily_sec9 M S d,
    Section1.degree (X : Section1.ClassFunction M) =
      Section1.degree (Y : Section1.ClassFunction M) := by
  classical
  intro X Y
  have hX := (Finset.mem_filter.mp X.property).2
  have hY := (Finset.mem_filter.mp Y.property).2
  exact hX.trans hY.symm

public theorem degreeSubfamily_closed_under_conjugate_sec9
  {G : Type u} [Group G] [Finite G]
  (M : Subgroup G)
  (S : Finset (Section1.ClassFunction M))
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
  (d : ℕ) :
  Section5.hypothesis_5_2_statement S T →
    ∀ χ : Section1.ClassFunction M,
      χ ∈ degreeSubfamily_sec9 M S d →
        Section1.conjugateCharacter χ ∈ degreeSubfamily_sec9 M S d := by
  classical
  intro h52 χ hχ
  rcases h52 with ⟨_hsetup, _R, h52a, _h52b, _h52c, _h52d, _h52e⟩
  rw [degreeSubfamily_sec9, Finset.mem_filter] at hχ ⊢
  rcases hχ with ⟨hχS, hχdeg⟩
  refine ⟨(h52a ⟨χ, hχS⟩).1, ?_⟩
  calc
    Section1.degree (Section1.conjugateCharacter χ) = star (Section1.degree χ) := by
      simp [Section1.degree, Section1.conjugateCharacter]
    _ = (d : ℂ) := by
      rw [hχdeg]
      simp

public theorem theorem_9_11_case_a_initial_degree_subfamily_coherent
  {G : Type u} [Group G] [Finite G]
  (M W1 : Subgroup G)
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
  (SH0Cprime : Finset (Section1.ClassFunction M))
  (a : ℕ) :
  Section5.hypothesis_5_2_statement SH0Cprime T →
    (degreeSubfamily_sec9 M SH0Cprime (Nat.card W1 * a)).Nonempty →
      coherentFamilyForT M (degreeSubfamily_sec9 M SH0Cprime (Nat.card W1 * a)) T := by
  intro h52 hne
  refine coherentFamilyForT_of_equal_degree_subfamily_sec9 M
    (degreeSubfamily_sec9 M SH0Cprime (Nat.card W1 * a)) SH0Cprime T
    (degreeSubfamily_subset_sec9 M SH0Cprime (Nat.card W1 * a)) hne ?_ h52
    (degreeSubfamily_equal_degree_sec9 M SH0Cprime (Nat.card W1 * a))
  exact degreeSubfamily_closed_under_conjugate_sec9 M SH0Cprime T
    (Nat.card W1 * a) h52

