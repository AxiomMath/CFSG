public theorem theorem_9_11_case_a_sourceData_intro
  {G : Type u} [Group G] [Finite G]
  (M MF U W1 W2 H0 C Cprime Uprime : Subgroup G)
  (SH0Cprime SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
  (p a u : ℕ) :
  case_9_7_a_data M MF U W1 W2 H0 C p (Nat.card W1) a →
    kernelInducedFamily M (ambientDerivedSubgroup M) MF (H0 ⊔ Cprime) SH0Cprime →
