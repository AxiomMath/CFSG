    Section5.cfNormSq α =
      (a + 1 : ℝ) + ((((q - 1) * a ^ 2 : ℕ) : ℝ) / (u : ℝ)) := by
    rw [hα, Section5.cfNormSq_sub_eq_add_of_orthogonal hγψ hψγ,
