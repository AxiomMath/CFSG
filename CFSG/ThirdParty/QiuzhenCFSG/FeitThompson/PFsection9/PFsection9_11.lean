  {G : Type u} [Group G]
  (M : Subgroup G)
  (S : Finset (Section1.ClassFunction M))
  (d : ℕ)
  (χ : Section1.ClassFunction M) :
  χ ∈ degreeSubfamily_sec9 M S d ↔ χ ∈ S ∧ Section1.degree χ = (d : ℂ) := by
