  have haR : 0 < (a : ℝ) := by exact_mod_cast ha
  have hbound' :
      (count : ℝ) * (((q : ℝ) * (a : ℝ)) ^ (2 : ℕ)) ≤
        2 * (((q : ℝ) * (v : ℝ)) * ((q : ℝ) * (a : ℝ))) := by
    simpa [hdX, Nat.cast_mul, mul_assoc, mul_left_comm, mul_comm] using hbound
  have hq_sq_pos : 0 < (q : ℝ) ^ (2 : ℕ) :=
    sq_pos_of_ne_zero (ne_of_gt hqR)
  have hfactor_pos : 0 < (q : ℝ) ^ (2 : ℕ) * (a : ℝ) := by
    nlinarith
  have hscaled :
      ((q : ℝ) ^ (2 : ℕ) * (a : ℝ)) * ((count : ℝ) * (a : ℝ)) ≤
        ((q : ℝ) ^ (2 : ℕ) * (a : ℝ)) * (2 * (v : ℝ)) := by
    nlinarith [hbound']
  exact le_of_mul_le_mul_left hscaled hfactor_pos

