/--
Explicit proof data for the hard case-a maximal-obstruction step in PF
`(9.11)`.  This is the formal output of the source proof's steps
`(9.11.1)` through `(9.11.8)`: every proper maximal coherent closed
subfamily admits the witness package whose final congruence contradicts
maximality.
-/
@[expose] public def theorem_9_11_case_a_obstructionData
  {G : Type u} [Group G] [Finite G]
  (M MF U W1 W2 H0 C _Cprime : Subgroup G)
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
  (SH0Cprime : Finset (Section1.ClassFunction M)) : Prop :=
∀ (p a u : ℕ) (Uprime : Subgroup G)
  (SH0 SH0C SH0U : Finset (Section1.ClassFunction M)),
  case_9_7_a_data M MF U W1 W2 H0 C p (Nat.card W1) a →
    Uprime = (_root_.commutator U).map U.subtype →
      kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 →
        kernelInducedFamily M (ambientDerivedSubgroup M) MF (H0 ⊔ C) SH0C →
          kernelInducedFamily M (ambientDerivedSubgroup M) MF (H0 ⊔ Uprime) SH0U →
            case_9_7_a_characterData M MF U H0 C Uprime p (Nat.card W1) a u
              SH0 SH0C SH0U →
              ∀ S2 : Finset (Section1.ClassFunction M),
                degreeSubfamily_sec9 M SH0Cprime (Nat.card W1 * a) ⊆ S2 →
                  S2 ⊆ SH0Cprime →
                    conjugationClosedSubfamily_sec9 S2 →
                      coherentFamilyForT M S2 T →
                        S2 ≠ SH0Cprime →
                          (¬ ∃ S3 : Finset (Section1.ClassFunction M),
                            S2 ⊂ S3 ∧
                              S3 ⊆ SH0Cprime ∧
                                coherentFamilyForT M S3 T ∧
                                  conjugationClosedSubfamily_sec9 S3) →
                            ∃ (S3 S4 : Finset (Section1.ClassFunction M))
                              (τ1 : Section1.ClassFunction M →ₗ[ℂ]
                                Section1.ClassFunction G)
                              (ψ1 lam1 β α : Section1.ClassFunction M)
                              (Δ : Section1.ClassFunction G)
                              (b : ℕ) (x : ℤ),
                                theorem_9_11_8_data M S2 S2 S3 S4 SH0Cprime
                                  T τ1 ψ1 lam1 β α Δ a u b x

/--
Explicit proof data for the PF `(9.11)` appeal to `(8.15)`: the Section 8
map that satisfies Hypothesis `(5.2)` must agree with the PF `(9.5)` Dade map
on all character differences, and the PF map must satisfy `(5.2)(b)` on the
target subfamily.
-/
@[expose] public def theorem_9_11_hypothesis52BridgeData
  {G : Type u} [Group G] [Finite G]
  (M MF _U _W1 _W2 _H0 _C _Cprime : Subgroup G)
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
  (SH0Cprime : Finset (Section1.ClassFunction M)) : Prop :=
Section5.hypothesis_5_2_b_statement SH0Cprime T ∧
  ∀ K U8 Ms : Subgroup G, ∀ A : Set G, ∀ R8 : G → Subgroup G,
    Section8.theorem_8_15_data M MF K U8 Ms A R8 SH0Cprime →
      Section8.section8InducedNonkernelFamily M Ms SH0Cprime →
        ∃ T0 : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G,
          Section5.hypothesis_5_2_statement SH0Cprime T0 ∧
            ∀ X : SH0Cprime,
              T ((X : Section1.ClassFunction M) -
                  Section1.conjugateCharacter (X : Section1.ClassFunction M)) =
                T0 ((X : Section1.ClassFunction M) -
                  Section1.conjugateCharacter (X : Section1.ClassFunction M))

public def theorem_5_6_degreeData_sec9
  {G : Type u} [Group G] [Finite G]
  (S1 : Finset (Section1.ClassFunction G))
  (X1 : S1)
  (X : Section1.ClassFunction G) : Prop :=
∃ d1 dX : ℕ,
  Section1.degree (X1 : Section1.ClassFunction G) = (d1 : ℂ) ∧
    Section1.degree X = (dX : ℂ) ∧
      d1 ∣ dX ∧
        ∃ dS1 : S1 → ℕ,
          (∀ Y : S1,
            Section1.degree (Y : Section1.ClassFunction G) = (dS1 Y : ℂ)) ∧
            2 * (dX : ℝ) * (d1 : ℝ) <
              ∑ Y : S1,
                (((dS1 Y : ℝ) ^ (2 : ℕ)) /
                  Section5.cfNormSq (Y : Section1.ClassFunction G))

public theorem degree_eq_nat_of_isCharacter_sec9
  {G : Type u} [Group G] [Finite G]
  (χ : Section1.ClassFunction G) :
  Section1.IsCharacter χ →
    ∃ d : ℕ, Section1.degree χ = (d : ℂ) := by
  rintro ⟨V, _hadd, _hmod, _hfd, ρ, rfl⟩
  exact ⟨Module.finrank ℂ V, Section1.degree_representation_character ρ⟩

public theorem character_eq_zero_of_isCharacter_degree_zero_sec9
  {G : Type u} [Group G] [Finite G]
  {χ : Section1.ClassFunction G} :
  Section1.IsCharacter χ →
    Section1.degree χ = 0 →
      χ = 0 := by
  rintro ⟨V, _hadd, _hmod, _hfd, ρ, rfl⟩ hdegree
  have hfinC : (Module.finrank ℂ V : ℂ) = 0 := by
    simpa [Section1.degree_representation_character ρ] using hdegree
  have hfin : Module.finrank ℂ V = 0 := by
    exact_mod_cast hfinC
  have hsub : Subsingleton V := Module.finrank_zero_iff.mp hfin
  ext g
  have hzero : (ρ g : V →ₗ[ℂ] V) = 0 := by
    ext v
    exact hsub.elim _ _
  simp [Representation.character, hzero]

public theorem degree_nat_of_hypothesis_5_2_mem_sec9
  {G : Type u} [Group G] [Finite G]
  (M : Subgroup G)
  (S : Finset (Section1.ClassFunction M))
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
  (χ : Section1.ClassFunction M) :
  Section5.hypothesis_5_2_statement S T →
    χ ∈ S →
      ∃ d : ℕ, Section1.degree χ = (d : ℂ) := by
  intro h52 hχ
