public theorem coherentFamilyForT_of_section5_equal_degree
  {G : Type u} [Group G] [Finite G]
  (M : Subgroup G)
  (S : Finset (Section1.ClassFunction M))
  (T : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G) :
  (∃ R : S → Finset (Section1.ClassFunction G),
    Section5.hypothesis_5_2_setup_statement S ∧
      Section5.hypothesis_5_2_a_statement S ∧
      Section5.hypothesis_5_2_b_statement S T ∧
      Section5.hypothesis_5_2_c_statement S ∧
      Section5.hypothesis_5_2_d_statement S T R ∧
      Section5.hypothesis_5_2_e_statement S R ∧
      ∀ X Y : S,
        Section1.degree (X : Section1.ClassFunction M) =
          Section1.degree (Y : Section1.ClassFunction M)) →
    coherentFamilyForT M S T := by
  rintro ⟨R, hsetup, h52a, h52b, h52c, h52d, h52e, hdeg⟩
  exact Section5.theorem_5_7 S T R hsetup h52a h52b h52c h52d h52e hdeg

/--
The branch-and-family part of the case `(9.7.a)` source split, before PF
`(9.8)` is applied to get the character-counting step.
-/
public def theorem_9_11_case_a_branchData
  {G : Type u} [Group G] [Finite G]
  (M MF U W1 W2 H0 C : Subgroup G) : Prop :=
∃ p a u : ℕ, ∃ Uprime : Subgroup G,
  ∃ SH0C SH0U : Finset (Section1.ClassFunction M),
    case_9_7_a_data M MF U W1 W2 H0 C p (Nat.card W1) a ∧
      quotientBarUCardinality U C u ∧
      Uprime = (_root_.commutator U).map U.subtype ∧
      kernelInducedFamily M (ambientDerivedSubgroup M) MF (H0 ⊔ C) SH0C ∧
      kernelInducedFamily M (ambientDerivedSubgroup M) MF (H0 ⊔ Uprime) SH0U

/--
The branch-and-family part of the case `(9.7.b)` source split, before PF
