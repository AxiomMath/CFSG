  exact le_antisymm hCK ((Subgroup.relIndex_eq_one).mp hrel_eq_one)

private theorem explicit_nonprincipal_index_action_fixed_eq_one_sec9
  {A Q : Type u} [Group A] [Group Q] [Finite Q] [IsMulCommutative Q]
  (p : ℕ) (hp : Nat.Prime p)
  (hcard : Nat.card Q = p)
  (ρ : A →* MulAut Q) :
  ∃ action : MulAction A (Fin (p - 1)),
    ∀ a : A, ∀ i : Fin (p - 1),
      @SMul.smul A (Fin (p - 1)) action.toSMul a i = i → ρ a = 1 := by
  classical
  rcases nonprincipalIndexAction_fixed_eq_one_data_sec9 p hp hcard ρ with
    ⟨action, hfixed⟩
  refine ⟨action, ?_⟩
  intro a i hfix
  letI : MulAction A (Fin (p - 1)) := action
  exact hfixed a i hfix

private theorem quotient_action_fixed_of_quotientSubgroupCentralizedByElement_sec9
  {G : Type u} [Group G] [Finite G]
  {MF H0 U : Subgroup G}
  (hnormalH0 : (H0.subgroupOf MF).Normal)
  (hUnormMF : U ≤ Subgroup.normalizer (MF : Set G))
  (hH0invU :
    letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
    IsInvariant U MF (H0.subgroupOf MF))
  {Q : Subgroup (MF ⧸ H0.subgroupOf MF)}
  (x : U)
  (hcent : quotientSubgroupCentralizedByElement MF H0 Q (x : G)) :
  letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
  letI : (H0.subgroupOf MF).Normal := hnormalH0
  letI : MulDistribMulAction U (MF ⧸ H0.subgroupOf MF) :=
    quotientMulDistribMulAction (A := U) (G := MF)
      (H0.subgroupOf MF) hH0invU
  ∀ y : MF ⧸ H0.subgroupOf MF, y ∈ Q → x⁻¹ • y = y := by
  classical
  let H0MF : Subgroup MF := H0.subgroupOf MF
  haveI : H0MF.Normal := hnormalH0
  letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
  have hH0invU' : IsInvariant U MF H0MF := by
    simpa [H0MF] using hH0invU
  letI : MulDistribMulAction U (MF ⧸ H0MF) :=
    quotientMulDistribMulAction (A := U) (G := MF) H0MF hH0invU'
  rcases hcent with ⟨hconjMF, action, haction, hfix⟩
  intro y
  refine QuotientGroup.induction_on y ?_
  intro h hy
  let xinv : U := x⁻¹
  have hleft :
      action (QuotientGroup.mk' H0MF h) =
        xinv • QuotientGroup.mk' H0MF h := by
    rw [haction h]
    change
      QuotientGroup.mk' H0MF
          ⟨(x : G)⁻¹ * (h : G) * (x : G), hconjMF h⟩ =
        QuotientGroup.mk' H0MF (xinv • h)
    apply congrArg (QuotientGroup.mk' H0MF)
    apply Subtype.ext
    simp [xinv, Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe,
      mul_assoc]
  change xinv • QuotientGroup.mk' H0MF h = QuotientGroup.mk' H0MF h
  rw [← hleft]
  exact hfix (QuotientGroup.mk' H0MF h) hy

private theorem quotient_conj_inv_mem_of_conj_mem_finite_sec9
  {G : Type u} [Group G] [Finite G]
  {MF : Subgroup G} {g : G}
  (hconjMF : ∀ h : MF, g⁻¹ * (h : G) * g ∈ MF) :
  ∀ h : MF, g * (h : G) * g⁻¹ ∈ MF := by
  classical
  letI : Fintype MF := Fintype.ofFinite MF
  let f : MF → MF := fun h => ⟨g⁻¹ * (h : G) * g, hconjMF h⟩
  have hf_inj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    have hval := congrArg Subtype.val hxy
    dsimp [f] at hval
    calc
      (x : G) = g * (g⁻¹ * (x : G) * g) * g⁻¹ := by group
      _ = g * (g⁻¹ * (y : G) * g) * g⁻¹ := by rw [hval]
      _ = (y : G) := by group
  have hf_surj : Function.Surjective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hf_inj, rfl⟩ |>.2
  intro h
  rcases hf_surj h with ⟨k, hk⟩
  have hkval := congrArg Subtype.val hk
  dsimp [f] at hkval
  have hk_eq : (k : G) = g * (h : G) * g⁻¹ := by
    calc
      (k : G) = g * (g⁻¹ * (k : G) * g) * g⁻¹ := by group
      _ = g * (h : G) * g⁻¹ := by rw [hkval]
  simp [← hk_eq, k.property]

private theorem quotientSubgroupConjugateByElement_one_eq_sec9
  {G : Type u} [Group G] [Finite G]
  {MF H0 : Subgroup G}
  [hnormal : (H0.subgroupOf MF).Normal]
  {Q R : Subgroup (MF ⧸ H0.subgroupOf MF)}
  (hQR : quotientSubgroupConjugateByElement MF H0 Q R (1 : G)) :
  Q = R := by
  classical
  rcases hQR with ⟨_hconjMF, action, haction, hR⟩
  have haction_one : action = 1 := by
    ext x
    rcases QuotientGroup.mk'_surjective (H0.subgroupOf MF) x with ⟨h, rfl⟩
    simpa using haction h
  rw [hR, haction_one]
  ext x
  constructor
  · intro hx
    exact ⟨x, hx, by simp⟩
  · rintro ⟨y, hy, hyx⟩
    simpa using hyx ▸ hy

private theorem quotientSubgroupCentralizedByElement_of_conjugate_source_sec9
  {G : Type u} [Group G] [Finite G]
  {MF H0 : Subgroup G}
  [hnormal : (H0.subgroupOf MF).Normal]
  {Q R : Subgroup (MF ⧸ H0.subgroupOf MF)} {w x : G}
  (hQR : quotientSubgroupConjugateByElement MF H0 Q R w)
  (hcent :
    quotientSubgroupCentralizedByElement MF H0 Q (w * x * w⁻¹)) :
  quotientSubgroupCentralizedByElement MF H0 R x := by
  classical
  rcases hQR with ⟨hconjW, actionW, hactionW, hR⟩
  rcases hcent with ⟨hconjY, actionY, hactionY, hfixY⟩
  have hconjWinv : ∀ h : MF, w * (h : G) * w⁻¹ ∈ MF :=
    quotient_conj_inv_mem_of_conj_mem_finite_sec9 hconjW
  let actionX : MulAut (MF ⧸ H0.subgroupOf MF) :=
    actionW.symm.trans (actionY.trans actionW)
  have hconjX : ∀ h : MF, x⁻¹ * (h : G) * x ∈ MF := by
    intro h
    let hW : MF := ⟨w * (h : G) * w⁻¹, hconjWinv h⟩
    let k : MF :=
      ⟨(w * x * w⁻¹)⁻¹ * (hW : G) * (w * x * w⁻¹), hconjY hW⟩
    have hmem := hconjW k
    convert hmem using 1
    dsimp [k, hW]
    group
  refine ⟨hconjX, actionX, ?_, ?_⟩
  · intro h
    let hW : MF := ⟨w * (h : G) * w⁻¹, hconjWinv h⟩
    have hsymmW :
        actionW.symm (QuotientGroup.mk' (H0.subgroupOf MF) h) =
          QuotientGroup.mk' (H0.subgroupOf MF) hW := by
      apply actionW.injective
      simp only [MulEquiv.apply_symm_apply]
      symm
      calc
        actionW (QuotientGroup.mk' (H0.subgroupOf MF) hW) =
            QuotientGroup.mk' (H0.subgroupOf MF)
              ⟨w⁻¹ * (hW : G) * w, hconjW hW⟩ := hactionW hW
        _ = QuotientGroup.mk' (H0.subgroupOf MF) h := by
          apply congrArg (QuotientGroup.mk' (H0.subgroupOf MF))
          apply Subtype.ext
          dsimp [hW]
          group
    let k : MF :=
      ⟨(w * x * w⁻¹)⁻¹ * (hW : G) * (w * x * w⁻¹), hconjY hW⟩
    calc
      actionX (QuotientGroup.mk' (H0.subgroupOf MF) h) =
          actionW (actionY (actionW.symm (QuotientGroup.mk' (H0.subgroupOf MF) h))) := rfl
      _ = actionW (actionY (QuotientGroup.mk' (H0.subgroupOf MF) hW)) := by
        rw [hsymmW]
      _ = actionW (QuotientGroup.mk' (H0.subgroupOf MF) k) := by
        rw [hactionY hW]
      _ = QuotientGroup.mk' (H0.subgroupOf MF)
            ⟨w⁻¹ * (k : G) * w, hconjW k⟩ := hactionW k
      _ = QuotientGroup.mk' (H0.subgroupOf MF)
            ⟨x⁻¹ * (h : G) * x, hconjX h⟩ := by
        apply congrArg (QuotientGroup.mk' (H0.subgroupOf MF))
        apply Subtype.ext
        dsimp [k, hW]
        group
  · intro y hyR
    rw [hR] at hyR
    rcases hyR with ⟨z, hzQ, hzy⟩
    rw [← hzy]
    change actionW (actionY (actionW.symm (actionW z))) = actionW z
    rw [MulEquiv.symm_apply_apply, hfixY z hzQ]

private theorem quotientSubgroupCentralizedByElement_conjugate_source_of_target_sec9
  {G : Type u} [Group G] [Finite G]
  {MF H0 : Subgroup G}
  [hnormal : (H0.subgroupOf MF).Normal]
  {Q R : Subgroup (MF ⧸ H0.subgroupOf MF)} {w x : G}
  (hQR : quotientSubgroupConjugateByElement MF H0 Q R w)
  (hcent : quotientSubgroupCentralizedByElement MF H0 R x) :
  quotientSubgroupCentralizedByElement MF H0 Q (w * x * w⁻¹) := by
  have hRQ : quotientSubgroupConjugateByElement MF H0 R Q w⁻¹ :=
    quotientSubgroupConjugateByElement_symm_sec9 hQR
  have hsource :
      quotientSubgroupCentralizedByElement MF H0 R
        (w⁻¹ * (w * x * w⁻¹) * (w⁻¹)⁻¹) := by
    simpa [mul_assoc] using hcent
  exact quotientSubgroupCentralizedByElement_of_conjugate_source_sec9 hRQ hsource

private theorem quotientSubgroupCentralizedByElement_mul_sec9
  {G : Type u} [Group G] [Finite G]
  {MF H0 : Subgroup G}
  [hnormal : (H0.subgroupOf MF).Normal]
  {Q : Subgroup (MF ⧸ H0.subgroupOf MF)} {a b : G}
  (ha : quotientSubgroupCentralizedByElement MF H0 Q a)
  (hb : quotientSubgroupCentralizedByElement MF H0 Q b) :
  quotientSubgroupCentralizedByElement MF H0 Q (a * b) := by
  rcases ha with ⟨hconjA, actionA, hactionA, hfixA⟩
  rcases hb with ⟨hconjB, actionB, hactionB, hfixB⟩
  let hconjAB : ∀ h : MF, (a * b)⁻¹ * (h : G) * (a * b) ∈ MF := by
    intro h
    have hA : a⁻¹ * (h : G) * a ∈ MF := hconjA h
    have hB := hconjB ⟨a⁻¹ * (h : G) * a, hA⟩
    simpa [mul_assoc] using hB
  refine ⟨hconjAB, actionA.trans actionB, ?_, ?_⟩
  · intro h
    calc
      (actionA.trans actionB) (QuotientGroup.mk' (H0.subgroupOf MF) h) =
          actionB (actionA (QuotientGroup.mk' (H0.subgroupOf MF) h)) := rfl
      _ = actionB (QuotientGroup.mk' (H0.subgroupOf MF)
            ⟨a⁻¹ * (h : G) * a, hconjA h⟩) := by
          rw [hactionA h]
      _ = QuotientGroup.mk' (H0.subgroupOf MF)
            ⟨b⁻¹ * (a⁻¹ * (h : G) * a) * b,
              hconjB ⟨a⁻¹ * (h : G) * a, hconjA h⟩⟩ := by
          exact hactionB ⟨a⁻¹ * (h : G) * a, hconjA h⟩
      _ = QuotientGroup.mk' (H0.subgroupOf MF)
            ⟨(a * b)⁻¹ * (h : G) * (a * b), hconjAB h⟩ := by
          apply congrArg (QuotientGroup.mk' (H0.subgroupOf MF))
          apply Subtype.ext
          group
  · intro x hxQ
    change actionB (actionA x) = x
    rw [hfixA x hxQ]
    exact hfixB x hxQ

private theorem mf_element_quotientSubgroupCentralizedByElement_sec9
  {G : Type u} [Group G] [Finite G]
  {MF H0 : Subgroup G}
  [hnormal : (H0.subgroupOf MF).Normal]
  [IsMulCommutative (MF ⧸ H0.subgroupOf MF)]
  {Q : Subgroup (MF ⧸ H0.subgroupOf MF)}
  {m : G} (hm : m ∈ MF) :
  quotientSubgroupCentralizedByElement MF H0 Q m := by
    let H0MF : Subgroup MF := H0.subgroupOf MF
    haveI : H0MF.Normal := hnormal
    let mMF : MF := ⟨m, hm⟩
    have hconj : ∀ h : MF, m⁻¹ * (h : G) * m ∈ MF := by
      intro h
      change ((mMF⁻¹ * h * mMF : MF) : G) ∈ MF
      exact (mMF⁻¹ * h * mMF).property
    refine ⟨hconj, 1, ?_, ?_⟩
    · intro h
      let qm : MF ⧸ H0MF := QuotientGroup.mk' H0MF mMF
      let qh : MF ⧸ H0MF := QuotientGroup.mk' H0MF h
      have hquot_conj : qm⁻¹ * qh * qm = qh := by
        calc
          qm⁻¹ * qh * qm = (qh * qm⁻¹) * qm := by
            rw [mul_comm qm⁻¹ qh]
          _ = qh * (qm⁻¹ * qm) := by rw [mul_assoc]
          _ = qh := by simp
      have hmap_conj :
          QuotientGroup.mk' H0MF (mMF⁻¹ * h * mMF) =
            qm⁻¹ * qh * qm := by
        change
          QuotientGroup.mk' H0MF (mMF⁻¹ * h * mMF) =
            (QuotientGroup.mk' H0MF mMF)⁻¹ *
              QuotientGroup.mk' H0MF h * QuotientGroup.mk' H0MF mMF
        rw [map_mul, map_mul, map_inv]
      calc
        (1 : MulAut (MF ⧸ H0MF)) (QuotientGroup.mk' H0MF h) =
            QuotientGroup.mk' H0MF h := rfl
        _ = QuotientGroup.mk' H0MF (mMF⁻¹ * h * mMF) := by
          rw [hmap_conj, hquot_conj]
        _ = QuotientGroup.mk' H0MF
              ⟨m⁻¹ * (h : G) * m, hconj h⟩ := by
          apply congrArg (QuotientGroup.mk' H0MF)
          ext
          simp [mMF, mul_assoc]
    · intro x hx
      simp

private theorem exists_mul_eq_of_mem_sup_of_left_le_normalizer_sec9
    {G : Type u} [Group G]
    {H K : Subgroup G}
  (hK_norm_H : K ≤ Subgroup.normalizer (H : Set G))
  {x : G} (hx : x ∈ H ⊔ K) :
  ∃ h : G, h ∈ H ∧ ∃ k : G, k ∈ K ∧ h * k = x := by
    let L : Subgroup G := K ⊔ H
    letI : (H.subgroupOf L).Normal := by
      simpa [L] using
        (Subgroup.normal_subgroupOf_sup_of_le_normalizer
          (H := K) (N := H) hK_norm_H)
    let xL : L := ⟨x, by simpa [L, sup_comm] using hx⟩
    have htop : H.subgroupOf L ⊔ K.subgroupOf L = ⊤ := by
      calc
        H.subgroupOf L ⊔ K.subgroupOf L = (H ⊔ K).subgroupOf L := by
          symm
          exact Subgroup.subgroupOf_sup
            (A := H) (A' := K) (B := L)
            (by simp [L, sup_comm])
            (by simp [L, sup_comm])
        _ = ⊤ := by simp [L, sup_comm]
    have hxTop : xL ∈ H.subgroupOf L ⊔ K.subgroupOf L := by
      simp [htop]
    rcases (Subgroup.mem_sup_of_normal_left
        (s := H.subgroupOf L) (t := K.subgroupOf L) (x := xL)).1 hxTop with
      ⟨hL, hhHsub, kL, hkKsub, hmulL⟩
    refine ⟨hL, ?_, kL, ?_, ?_⟩
    · simpa [Subgroup.mem_subgroupOf] using hhHsub
    · simpa [Subgroup.mem_subgroupOf] using hkKsub
    · simpa using congrArg (fun z : L => (z : G)) hmulL


private theorem section2_mem_elementCentralizer_commute_sec9
    {G : Type u} [Group G] {g c : G}
    (hc : c ∈ Section2.elementCentralizer g) :
    g * c = c * g := by
    unfold Section2.elementCentralizer at hc
    rw [Subgroup.mem_centralizer_iff] at hc
    exact hc g (by simp)

private theorem exists_centralizer_coset_conj_of_coprime_sec9
    {G : Type u} [Group G] [Finite G]
    (K : Subgroup G) (g : G)
    (hnorm : Section2.normalizesSet (K : Set G) g)
    (hcop : Nat.Coprime (orderOf g) (Nat.card K))
    (y : K) :
    ∃ r u : K,
      (u : G) ∈ Section2.centralizerIn K g ∧
        (u : G) * g = (r : G)⁻¹ * ((y : G) * g) * (r : G) := by
    classical
    rcases Section2.proposition_2_1 g K hnorm hcop with
      ⟨reps, _hcard, hreps, _hdisj, hcover⟩
    have hygCoset : (y : G) * g ∈ Section2.subgroupCosetByElement K g := by
      exact ⟨(y : G), y.2, rfl⟩
    have hygPiece :
        (y : G) * g ∈ {z | ∃ r ∈ reps, z ∈ Section2.conjugateCosetPiece K g r} := by
      simpa [hcover] using hygCoset
    rcases hygPiece with ⟨r, hr, hpiece⟩
    have hrK : r ∈ K := hreps r hr
    rcases hpiece with ⟨s, hs, hsEq⟩
    rcases hs with ⟨u, huCent, rfl⟩
    have huK : u ∈ K := (Subgroup.mem_inf.mp huCent).1
    refine ⟨⟨r, hrK⟩, ⟨u, huK⟩, huCent, ?_⟩
    simpa [Section2.conjBy, mul_assoc] using
      congrArg (fun t : G => r⁻¹ * t * r) hsEq.symm

private theorem elementCentralizerIn_mul_right_ne_bot_of_coprime_sec9
    {G : Type u} [Group G] [Finite G]
    (K S : Subgroup G) (g : G)
    (hKS : K ≤ S)
    (hnorm : Section2.normalizesSet (K : Set G) g)
    (hcop : Nat.Coprime (orderOf g) (Nat.card K))
    (hcent_g : elementCentralizerIn K g ≠ ⊥)
    {m : G} (hm : m ∈ K) :
    elementCentralizerIn S (m * g) ≠ ⊥ := by
    classical
    rcases exists_centralizer_coset_conj_of_coprime_sec9 K g hnorm hcop
        ⟨m, hm⟩ with
      ⟨r, u, huCent, hug_eq⟩
    have centralizer_of_conjugate
        {c : G} (hcK : c ∈ K) (hc_ne : c ≠ 1)
        (hcComm : c * ((u : G) * g) = ((u : G) * g) * c) :
        elementCentralizerIn S (m * g) ≠ ⊥ := by
      let zG : G := (r : G) * c * (r : G)⁻¹
      have ha_eq : m * g = (r : G) * ((u : G) * g) * (r : G)⁻¹ := by
        have h := congrArg (fun t : G => (r : G) * t * (r : G)⁻¹) hug_eq
        simpa [mul_assoc] using h.symm
      have hzK : zG ∈ K := by
        exact K.mul_mem (K.mul_mem r.property hcK) (K.inv_mem r.property)
      have hzCent :
          zG ∈ Subgroup.centralizer ({m * g} : Set G) := by
        apply Subgroup.mem_centralizer_singleton_iff.mpr
        dsimp [zG]
        calc
          ((r : G) * c * (r : G)⁻¹) * (m * g)
              = ((r : G) * c * (r : G)⁻¹) *
                  ((r : G) * ((u : G) * g) * (r : G)⁻¹) := by rw [ha_eq]
          _ = (r : G) * (c * ((u : G) * g)) * (r : G)⁻¹ := by group
          _ = (r : G) * (((u : G) * g) * c) * (r : G)⁻¹ := by rw [hcComm]
          _ = ((r : G) * ((u : G) * g) * (r : G)⁻¹) *
                ((r : G) * c * (r : G)⁻¹) := by group
          _ = (m * g) * ((r : G) * c * (r : G)⁻¹) := by rw [← ha_eq]
      let zC : elementCentralizerIn S (m * g) :=
        ⟨zG, by
          exact ⟨hKS hzK, hzCent⟩⟩
      refine Subgroup.ne_bot_iff_exists_ne_one.mpr ⟨zC, ?_⟩
      intro hzC_one
      apply hc_ne
      have hzG_one : zG = 1 := by
        simpa [zC] using congrArg Subtype.val hzC_one
      calc
        c = (r : G)⁻¹ * zG * (r : G) := by
          dsimp [zG]
          group
        _ = 1 := by rw [hzG_one]; group
    by_cases hu_ne : (u : G) ≠ 1
    · have huElem : (u : G) ∈ Section2.elementCentralizer g :=
        (Subgroup.mem_inf.mp huCent).2
      have hgu : g * (u : G) = (u : G) * g :=
        section2_mem_elementCentralizer_commute_sec9 huElem
      have huCommUg : (u : G) * ((u : G) * g) = ((u : G) * g) * (u : G) := by
        calc
          (u : G) * ((u : G) * g) = (u : G) * (u : G) * g := by group
          _ = (u : G) * (g * (u : G)) := by rw [hgu]; group
          _ = ((u : G) * g) * (u : G) := by group
      exact centralizer_of_conjugate u.property hu_ne huCommUg
    · rcases Subgroup.ne_bot_iff_exists_ne_one.mp hcent_g with ⟨c, hc_ne⟩
      have hcK : (c : G) ∈ K := by
        simpa [elementCentralizerIn] using c.property.1
      have hcCent : (c : G) ∈ Subgroup.centralizer ({g} : Set G) := by
        simpa [elementCentralizerIn] using c.property.2
      have hcg : g * (c : G) = (c : G) * g :=
        Subgroup.mem_centralizer_iff.mp hcCent g (by simp)
      have hcCommUg : (c : G) * ((u : G) * g) = ((u : G) * g) * (c : G) := by
        have hu_eq : (u : G) = 1 := by exact not_not.mp hu_ne
        calc
          (c : G) * ((u : G) * g) = (c : G) * g := by simp [hu_eq]
          _ = g * (c : G) := hcg.symm
          _ = ((u : G) * g) * (c : G) := by simp [hu_eq]
      exact centralizer_of_conjugate hcK (by
        intro hcG_one
        exact hc_ne (Subtype.ext hcG_one)) hcCommUg

private theorem elementCentralizerIn_of_nontrivial_quotient_fixed_sec9
    {G : Type u} [Group G] [Finite G]
    {MF H0 U : Subgroup G}
    (hnormalH0 : (H0.subgroupOf MF).Normal)
    (hUnormMF : U ≤ Subgroup.normalizer (MF : Set G))
    (hH0invU :
      letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
      IsInvariant U MF (H0.subgroupOf MF))
    (hsolvMF : IsSolvable MF)
    (hcopU : Nat.Coprime (Nat.card U) (Nat.card MF))
    {Q : Subgroup (MF ⧸ H0.subgroupOf MF)}
    (hQne : Q ≠ ⊥)
    (x : U)
    (hcent : quotientSubgroupCentralizedByElement MF H0 Q (x : G)) :
    elementCentralizerIn MF (x : G) ≠ ⊥ := by
    classical
