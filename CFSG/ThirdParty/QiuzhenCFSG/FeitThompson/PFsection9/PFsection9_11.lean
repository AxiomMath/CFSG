private theorem induced_principalCharacter_eq_card_filter_conj_mem_sec9
    {G : Type*} [Group G] [Finite G]
    (H : Subgroup G) [Finite H] (g : G) :
    Section1.inducedCF H (Section1.principalCharacter H) g =
      (Nat.card H : ℂ)⁻¹ *
        ((@Finset.filter G (fun x => x * g * x⁻¹ ∈ H)
          (Classical.decPred _) (@Finset.univ G (Fintype.ofFinite G))).card :
            ℂ) := by
    classical
    unfold Section1.inducedCF Section1.inducedClassFunction
    congr 1
    calc
      Finset.sum (@Finset.univ G (Fintype.ofFinite G))
        (fun x =>
          if hx : x * g * x⁻¹ ∈ H then
            Section1.principalCharacter H ⟨x * g * x⁻¹, hx⟩
          else 0) =
          Finset.sum (@Finset.univ G (Fintype.ofFinite G))
            (fun x => if x * g * x⁻¹ ∈ H then (1 : ℂ) else 0) := by
        refine Finset.sum_congr rfl ?_
        intro x _hx
        by_cases hx : x * g * x⁻¹ ∈ H
        · simp [hx, Section1.principalCharacter]
        · simp [hx]
      _ =
          Finset.sum
            (@Finset.filter G (fun x => x * g * x⁻¹ ∈ H)
              (Classical.decPred _) (@Finset.univ G (Fintype.ofFinite G)))
            (fun _x => (1 : ℂ)) := by
        rw [← Finset.sum_filter]
      _ =
          ((@Finset.filter G (fun x => x * g * x⁻¹ ∈ H)
            (Classical.decPred _) (@Finset.univ G (Fintype.ofFinite G))).card :
              ℂ) := by
        simp

private theorem cfNormSq_induced_principal_eq_filter_count_sq_sec9
    {G : Type*} [Group G] [Finite G]
    (H : Subgroup G) [Finite H] :
    Section5.cfNormSq
        (Section1.inducedCF H (Section1.principalCharacter H)) =
      (Nat.card G : ℝ)⁻¹ *
        Finset.sum (@Finset.univ G (Fintype.ofFinite G)) (fun g =>
          ((((@Finset.filter G (fun x => x * g * x⁻¹ ∈ H)
            (Classical.decPred _) (@Finset.univ G (Fintype.ofFinite G))).card :
              ℝ) /
              (Nat.card H : ℝ)) ^ 2)) := by
    classical
    letI : Fintype G := Fintype.ofFinite G
    rw [Section5.cfNormSq_eq_inv_card_mul_sum_normSq]
    congr 1
    refine Finset.sum_congr rfl ?_
    intro g _hg
    rw [induced_principalCharacter_eq_card_filter_conj_mem_sec9 H g]
    let c : ℕ :=
      ((Finset.univ : Finset G).filter (fun x => x * g * x⁻¹ ∈ H)).card
    change Complex.normSq ((Nat.card H : ℂ)⁻¹ * (c : ℂ)) =
      ((c : ℝ) / (Nat.card H : ℝ)) ^ 2
    rw [Complex.normSq_mul, Complex.normSq_inv, Complex.normSq_natCast,
      Complex.normSq_natCast]
    have hH : (Nat.card H : ℝ) ≠ 0 := by
      exact_mod_cast (Nat.card_pos (α := H)).ne'
    field_simp [hH]

private theorem filter_card_sq_eq_sum_pair_indicator_sec9
    {α : Type*} [Fintype α]
    (P : α → Prop) [DecidablePred P] :
    ((((Finset.univ : Finset α).filter P).card : ℝ) ^ 2) =
      ∑ a : α, ∑ b : α, if P a ∧ P b then (1 : ℝ) else 0 := by
    classical
    let f : α → ℝ := fun a => if P a then 1 else 0
    have hcard :
        (((Finset.univ : Finset α).filter P).card : ℝ) =
          ∑ a : α, f a := by
      dsimp [f]
      rw [← Finset.sum_filter]
      simp
    rw [hcard, pow_two, Finset.sum_mul]
    refine Finset.sum_congr rfl ?_
    intro a _ha
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro b _hb
    by_cases haP : P a <;> by_cases hbP : P b <;>
      simp [f, haP, hbP]

private theorem sum_filter_count_sq_div_eq_pair_indicator_sec9
    {ι α : Type*} [Fintype ι] [Fintype α]
    (P : ι → α → Prop) [∀ i a, Decidable (P i a)] (c : ℝ) :
    (∑ i : ι,
        (((((Finset.univ : Finset α).filter
          (fun a => P i a)).card : ℝ) / c) ^ 2)) =
      (1 / c ^ 2) *
        ∑ i : ι, ∑ a : α, ∑ b : α,
          if P i a ∧ P i b then (1 : ℝ) else 0 := by
    classical
    calc
      (∑ i : ι,
          (((((Finset.univ : Finset α).filter
            (fun a => P i a)).card : ℝ) / c) ^ 2)) =
          ∑ i : ι,
            (1 / c ^ 2) *
              ((((Finset.univ : Finset α).filter
                (fun a => P i a)).card : ℝ) ^ 2) := by
            refine Finset.sum_congr rfl ?_
            intro i _hi
            ring
      _ =
          (1 / c ^ 2) *
            ∑ i : ι,
              ((((Finset.univ : Finset α).filter
                (fun a => P i a)).card : ℝ) ^ 2) := by
            rw [Finset.mul_sum]
      _ =
          (1 / c ^ 2) *
            ∑ i : ι, ∑ a : α, ∑ b : α,
              if P i a ∧ P i b then (1 : ℝ) else 0 := by
            congr 1
            refine Finset.sum_congr rfl ?_
            intro i _hi
            exact filter_card_sq_eq_sum_pair_indicator_sec9 (fun a => P i a)

private theorem sum_eq_sum_mul_of_isComplement'_sec9
    {G β : Type*} [Group G] [Fintype G] [AddCommMonoid β]
    (H K : Subgroup G) [Fintype H] [Fintype K]
    (hcomp : H.IsComplement' K) (f : G → β) :
    (∑ g : G, f g) = ∑ h : H, ∑ k : K, f ((h : G) * (k : G)) := by
    classical
    have hbij :
        Function.Bijective (fun x : H × K => (x.1 : G) * (x.2 : G)) := by
      exact (Subgroup.isComplement_iff_bijective H K).mp
        (Subgroup.isComplement'_def.mp hcomp)
    let e : H × K ≃ G :=
      Equiv.ofBijective (fun x : H × K => (x.1 : G) * (x.2 : G)) hbij
    calc
      (∑ g : G, f g) = ∑ x : H × K, f ((x.1 : G) * (x.2 : G)) := by
        exact (Equiv.sum_comp e f).symm
      _ = ∑ h : H, ∑ k : K, f ((h : G) * (k : G)) := by
        simpa [Finset.univ_product_univ] using
          (Finset.sum_product (s := (Finset.univ : Finset H))
            (t := (Finset.univ : Finset K))
            (f := fun x : H × K => f ((x.1 : G) * (x.2 : G))))

private theorem right_eq_one_of_left_mul_mem_left_of_disjoint_sec9
    {G : Type*} [Group G] (H K : Subgroup G) (hdisj : Disjoint H K)
    {h k : G} (hh : h ∈ H) (hk : k ∈ K) (hmul : h * k ∈ H) :
    k = 1 := by
    have hkH : k ∈ H := by
      have hleft : h⁻¹ * (h * k) ∈ H := H.mul_mem (H.inv_mem hh) hmul
      simpa [mul_assoc] using hleft
    have hkbot : k ∈ (⊥ : Subgroup G) :=
      (Subgroup.disjoint_def.mp hdisj) hkH hk
    simpa using hkbot

private theorem left_mul_right_component_not_mem_left_of_disjoint_sec9
    {G : Type*} [Group G] (H K : Subgroup G) (hdisj : Disjoint H K)
    (hKnormH : K ≤ Subgroup.normalizer (H : Set G))
    {h k t : G} (hh : h ∈ H) (hk : k ∈ K) (ht : t ∈ K)
    (hk_ne : k ≠ 1) :
    t * (h * k) * t⁻¹ ∉ H := by
    intro hmem
    have htH : t * h * t⁻¹ ∈ H :=
      ((Subgroup.mem_normalizer_iff.mp (hKnormH ht)) h).1 hh
    have htK : t * k * t⁻¹ ∈ K :=
      K.mul_mem (K.mul_mem ht hk) (K.inv_mem ht)
    have hprod : (t * h * t⁻¹) * (t * k * t⁻¹) ∈ H := by
      simpa [mul_assoc] using hmem
    have ht_one :
        t * k * t⁻¹ = 1 :=
      right_eq_one_of_left_mul_mem_left_of_disjoint_sec9
        H K hdisj htH htK hprod
    apply hk_ne
    have hconj := congrArg (fun z => t⁻¹ * z * t) ht_one
    simpa [mul_assoc] using hconj

private theorem left_mul_right_component_not_mem_inf_conjBy_sec9
    {G : Type*} [Group G] (U U1 W1 : Subgroup G)
    (hdisj : Disjoint U W1)
    (hW1normU : W1 ≤ Subgroup.normalizer (U : Set G))
    (hU1_le_U : U1 ≤ U)
    {u w t r : G} (hu : u ∈ U) (hw : w ∈ W1) (ht : t ∈ W1)
    (hw_ne : w ≠ 1) :
    t * (u * w) * t⁻¹ ∉ U1 ⊓ U1.conjBy r := by
    intro hmem
    exact left_mul_right_component_not_mem_left_of_disjoint_sec9
      U W1 hdisj hW1normU hu hw ht hw_ne (hU1_le_U hmem.1)

private theorem join_sum_indicator_eq_left_sum_of_isComplement'_sec9
    {G : Type u} [Group G] [Finite G]
    (U U1 W1 : Subgroup G) [Fintype U] [Fintype W1]
    [Fintype (U ⊔ W1 : Subgroup G)]
    [∀ x : (U ⊔ W1 : Subgroup G), ∀ w1 : W1, ∀ w2 : W1,
      Decidable ((w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
        U1 ⊓ U1.conjBy (w2 : G))]
    [∀ x : U, ∀ w1 : W1, ∀ w2 : W1,
      Decidable ((w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
        U1 ⊓ U1.conjBy (w2 : G))]
    (hcomp :
      (U.subgroupOf (U ⊔ W1 : Subgroup G)).IsComplement'
        (W1.subgroupOf (U ⊔ W1 : Subgroup G)))
    (hdisj : Disjoint U W1)
    (hW1normU : W1 ≤ Subgroup.normalizer (U : Set G))
    (hU1_le_U : U1 ≤ U) :
    (∑ x : (U ⊔ W1 : Subgroup G), ∑ w1 : W1, ∑ w2 : W1,
        if (w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
          U1 ⊓ U1.conjBy (w2 : G) then (1 : ℝ) else 0) =
      (∑ x : U, ∑ w1 : W1, ∑ w2 : W1,
        if (w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
          U1 ⊓ U1.conjBy (w2 : G) then (1 : ℝ) else 0) := by
    classical
    let K : Subgroup G := U ⊔ W1
    letI : Fintype (U.subgroupOf K) := Fintype.ofFinite (U.subgroupOf K)
    letI : Fintype (W1.subgroupOf K) := Fintype.ofFinite (W1.subgroupOf K)
    let F : K → ℝ := fun x =>
      ∑ w1 : W1, ∑ w2 : W1,
        if (w1 : G) * (x : G) * (w1 : G)⁻¹ ∈
          U1 ⊓ U1.conjBy (w2 : G) then (1 : ℝ) else 0
    have hdecomp :
        (∑ x : K, F x) =
          ∑ u : U.subgroupOf K, ∑ w : W1.subgroupOf K,
            F ((u : K) * (w : K)) :=
      sum_eq_sum_mul_of_isComplement'_sec9
        (U.subgroupOf K) (W1.subgroupOf K) hcomp F
    have hcollapse :
        (∑ u : U.subgroupOf K, ∑ w : W1.subgroupOf K,
            F ((u : K) * (w : K))) =
          ∑ u : U.subgroupOf K, F (u : K) := by
      refine Finset.sum_congr rfl ?_
      intro u _hu
      rw [Finset.sum_eq_single (1 : W1.subgroupOf K)]
      · simp [F]
      · intro w _hw hw_ne
        dsimp [F]
        refine Finset.sum_eq_zero ?_
        intro w1 _hw1
        refine Finset.sum_eq_zero ?_
        intro w2 _hw2
        rw [if_neg]
        have hw_ne_G : ((w : K) : G) ≠ 1 := by
          intro h
          apply hw_ne
          ext
          exact h
        have hnot :=
          left_mul_right_component_not_mem_inf_conjBy_sec9
            U U1 W1 hdisj hW1normU hU1_le_U
            (u := ((u : K) : G)) (w := ((w : K) : G))
            (t := (w1 : G)) (r := (w2 : G))
            u.property
            w.property
            w1.property hw_ne_G
        simpa [mul_assoc] using hnot
      · intro hnot
        exact False.elim (hnot (Finset.mem_univ _))
    have htoU :
        (∑ u : U.subgroupOf K, F (u : K)) =
          (∑ u : U, ∑ w1 : W1, ∑ w2 : W1,
            if (w1 : G) * (u : G) * (w1 : G)⁻¹ ∈
              U1 ⊓ U1.conjBy (w2 : G) then (1 : ℝ) else 0) := by
      let e : U.subgroupOf K ≃ U :=
        (Subgroup.subgroupOfEquivOfLe (H := U) (K := K) le_sup_left).toEquiv
      let f : U → ℝ := fun u =>
        ∑ w1 : W1, ∑ w2 : W1,
          if (w1 : G) * (u : G) * (w1 : G)⁻¹ ∈
            U1 ⊓ U1.conjBy (w2 : G) then (1 : ℝ) else 0
      calc
        (∑ u : U.subgroupOf K, F (u : K)) =
            ∑ u : U.subgroupOf K, f (e u) := by
              refine Finset.sum_congr rfl ?_
              intro u _hu
              simp [F, f, e, Subgroup.subgroupOfEquivOfLe]
        _ = ∑ u : U, f u := by
              exact Equiv.sum_comp e f
        _ = ∑ u : U, ∑ w1 : W1, ∑ w2 : W1,
              if (w1 : G) * (u : G) * (w1 : G)⁻¹ ∈
                U1 ⊓ U1.conjBy (w2 : G) then (1 : ℝ) else 0 := rfl
    simpa [K, F] using hdecomp.trans (hcollapse.trans htoU)

private theorem relIndex_mul_natCard_eq_natCard_of_le_sec9
    {G : Type u} [Group G] [Finite G]
    (H K : Subgroup G) (hHK : H ≤ K) :
    H.relIndex K * Nat.card H = Nat.card K := by
    have hidx := Subgroup.index_mul_card (H := H.subgroupOf K)
    have hcard_sub : Nat.card (H.subgroupOf K) = Nat.card H :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hHK).toEquiv
    simpa [Subgroup.relIndex, hcard_sub] using hidx

private theorem normal_subgroupOf_conj_mem_iff_sec9
    {G : Type u} [Group G]
    (U U1 : Subgroup G) (hU1_le_U : U1 ≤ U)
    (hU1_normal_U : (U1.subgroupOf U).Normal)
    (u : U) (z : G) :
    (u : G) * z * (u : G)⁻¹ ∈ U1 ↔ z ∈ U1 := by
    have hUnormU1 : U ≤ Subgroup.normalizer (U1 : Set G) := by
