private theorem theorem_9_11_case_a_9113_degree_count_of_square_sum_sec9
  (p q a u s : ℕ) :
  p = 2 * a + 1 →
    a ∣ u →
      0 < a →
        0 < u →
          p ^ q * u =
              u + q * (2 * (u / a)) * a ^ 2 +
                (q * s + (p - 1)) * u ^ 2 →
            (q * s + (p - 1)) * u + (p - 1) * q = p ^ q - 1 := by
  intro hp hadiv ha hu_pos hsquare
  have hu_eq : (u / a) * a = u := Nat.div_mul_cancel hadiv
  have hp_pred : p - 1 = 2 * a := by omega
  have hmiddle :
      q * (2 * (u / a)) * a ^ 2 = (p - 1) * q * u := by
    rw [hp_pred]
    calc
      q * (2 * (u / a)) * a ^ 2 = (2 * q * a) * ((u / a) * a) := by
        ring
      _ = (2 * q * a) * u := by rw [hu_eq]
      _ = 2 * a * q * u := by ring
  have hsquare' :
      p ^ q * u = u + (p - 1) * q * u + (q * s + (p - 1)) * u ^ 2 := by
    simpa [hmiddle] using hsquare
  have hfactored :
      p ^ q * u = (1 + (p - 1) * q + (q * s + (p - 1)) * u) * u := by
    rw [hsquare']
    ring
  have hlinear :
      p ^ q = 1 + (p - 1) * q + (q * s + (p - 1)) * u :=
    Nat.mul_right_cancel hu_pos hfactored
  have hpq_pos : 0 < p ^ q := by
    have hp_pos : 0 < p := by omega
    exact pow_pos hp_pos q
  omega

private theorem theorem_9_11_case_a_9115_binomial_lower_aux_sec9
  (q a : ℕ) :
  0 < a →
    3 ≤ q →
      (2 * a) ^ q + 2 * q * (q - 1) * a ^ 2 + 2 * q * a + 1 ≤
        (2 * a + 1) ^ q := by
  intro ha hq
  induction q, hq using Nat.le_induction with
  | base =>
      norm_num
      nlinarith [sq_nonneg (a : ℤ),
        show (0 : ℤ) ≤ a by exact_mod_cast Nat.zero_le a]
  | succ n hn ih =>
      rw [pow_succ, pow_succ]
      have hmul := Nat.mul_le_mul_left (2 * a + 1) ih
      have hmul' :
          (2 * a + 1) *
              ((2 * a) ^ n + 2 * n * (n - 1) * a ^ 2 + 2 * n * a + 1) ≤
            (2 * a + 1) ^ n * (2 * a + 1) := by
        simpa [mul_comm, mul_left_comm, mul_assoc] using hmul
      have hstep :
          (2 * a) ^ n * (2 * a) +
                2 * (n + 1) * (n + 1 - 1) * a ^ 2 +
              2 * (n + 1) * a + 1 ≤
            (2 * a + 1) *
              ((2 * a) ^ n + 2 * n * (n - 1) * a ^ 2 + 2 * n * a + 1) := by
        let B : ℕ := (2 * a) ^ n
        change
          B * (2 * a) + 2 * (n + 1) * (n + 1 - 1) * a ^ 2 +
              2 * (n + 1) * a + 1 ≤
            (2 * a + 1) *
              (B + 2 * n * (n - 1) * a ^ 2 + 2 * n * a + 1)
        have hZ :
            ((B * (2 * a) + 2 * (n + 1) * (n + 1 - 1) * a ^ 2 +
              2 * (n + 1) * a + 1 : ℕ) : ℤ) ≤
            (((2 * a + 1) *
              (B + 2 * n * (n - 1) * a ^ 2 + 2 * n * a + 1) : ℕ) : ℤ) := by
          obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hn
          norm_num
          ring_nf
          have hextra :
              (0 : ℤ) < 1 + (B : ℤ) +
                (a : ℤ) ^ 3 * 24 + (a : ℤ) ^ 3 * (k : ℤ) * 20 +
                (a : ℤ) ^ 3 * (k : ℤ) ^ 2 * 4 := by
            positivity
          nlinarith
        exact_mod_cast hZ
      exact hstep.trans hmul'

private theorem theorem_9_11_case_a_9115_binomial_lower_bound_sec9
  (p q a : ℕ) :
  p = 2 * a + 1 →
    0 < a →
      3 ≤ q →
        2 ^ q * a ^ q + 2 * q * (q - 1) * a ^ 2 + 2 * q * a ≤ p ^ q - 1 := by
  intro hp ha hq
