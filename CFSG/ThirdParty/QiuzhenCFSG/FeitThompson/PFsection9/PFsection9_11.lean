    · rcases signedIrreducible_eq_or_eq_neg_of_scalarProduct_ne_zero_sec9
          hbarSigned hφSigned hbar_ne with hφeq | hφeq
      · refine ⟨Section1.conjugateCharacter lam1, hbarS3, ?_⟩
