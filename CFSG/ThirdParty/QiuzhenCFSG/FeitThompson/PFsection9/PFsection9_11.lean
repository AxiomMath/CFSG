private theorem theorem_9_11_case_a_9113_quotientDegreeFiberData_of_equivData_sec9
  {ι α β γ : Type*} [Fintype ι] [Fintype α] [Fintype β] [Fintype γ]
  (deg : ι → ℕ) (q a u : ℕ) :
