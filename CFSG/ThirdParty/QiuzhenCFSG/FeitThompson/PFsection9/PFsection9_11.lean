private theorem natCard_subgroup_eq_card_normal_mul_card_quotient_map_sec9
    {G : Type*} [Group G] [Finite G]
    (N H : Subgroup G) [N.Normal] (hN_le_H : N ≤ H) :
    Nat.card H = Nat.card N * Nat.card (H.map (QuotientGroup.mk' N)) := by
    have hNsub_card : Nat.card (N.subgroupOf H) = Nat.card N := by
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hN_le_H).toEquiv
    calc
      Nat.card H = Nat.card (H ⧸ N.subgroupOf H) * Nat.card (N.subgroupOf H) := by
        exact Subgroup.card_eq_card_quotient_mul_card_subgroup (N.subgroupOf H)
      _ = Nat.card (H.map (QuotientGroup.mk' N)) * Nat.card N := by
        rw [← natCard_map_mk'_eq H N, hNsub_card]
      _ = Nat.card N * Nat.card (H.map (QuotientGroup.mk' N)) := by
        rw [Nat.mul_comm]


private theorem sum_normSq_eq_card_mul_sum_of_quotient_equiv_sec9
    {A B : Type*} [Group A] [Fintype A] [Fintype B] [DecidableEq B]
    (H : Subgroup A) [H.Normal] [DecidableEq (A ⧸ H)]
    (e : A ⧸ H ≃ B) (φ : A → ℂ) (ψ : B → ℂ)
    (hpoint :
      ∀ a : A,
        Complex.normSq (φ a) =
          Complex.normSq (ψ (e (QuotientGroup.mk' H a)))) :
    (∑ a : A, Complex.normSq (φ a)) =
      (Nat.card H : ℝ) * ∑ b : B, Complex.normSq (ψ b) := by
    classical
    let π : A → B := fun a => e (QuotientGroup.mk' H a)
    have hfiber :
        ∀ b : B,
          ((Finset.univ : Finset A).filter (fun a => π a = b)).card =
            Nat.card H := by
      intro b
      have hfilter :
          (Finset.univ : Finset A).filter (fun a => π a = b) =
            (Finset.univ : Finset A).filter
              (fun a => QuotientGroup.mk' H a = e.symm b) := by
        refine Finset.filter_congr ?_
        intro a _ha
        dsimp [π]
        constructor
        · intro ha
          exact e.injective (by simpa using ha)
        · intro ha
          rw [ha]
          simp
      rw [hfilter]
      exact quotient_mk_fiber_card_eq_sec9 H (e.symm b)
    exact sum_normSq_eq_card_mul_sum_of_fiberwise_const_sec9
      π φ ψ (Nat.card H) hfiber hpoint


public theorem normal_subgroupOf_subgroupOf_of_normal_subgroupOf_sec9
    {G : Type u} [Group G] {L H K : Subgroup G}
    (hHK : H ≤ K) [(L.subgroupOf H).Normal] :
    ((L.subgroupOf K).subgroupOf (H.subgroupOf K)).Normal := by
    constructor
    intro n hn g
    change ((g * n * g⁻¹ : H.subgroupOf K) : K) ∈ L.subgroupOf K
    change (((g * n * g⁻¹ : H.subgroupOf K) : K) : G) ∈ L
    have hnL : (((n : H.subgroupOf K) : K) : G) ∈ L := by
      simpa [Subgroup.mem_subgroupOf] using
        (show ((n : H.subgroupOf K) : K) ∈ L.subgroupOf K from hn)
    let nH : H := (Subgroup.subgroupOfEquivOfLe hHK) n
    let gH : H := (Subgroup.subgroupOfEquivOfLe hHK) g
    have hnH : nH ∈ L.subgroupOf H := by
      change (nH : G) ∈ L
      simpa [nH, Subgroup.subgroupOfEquivOfLe] using hnL
    have hconjH : gH * nH * gH⁻¹ ∈ L.subgroupOf H :=
      (inferInstance : (L.subgroupOf H).Normal).conj_mem nH hnH gH
    change ((g : H.subgroupOf K) : G) * ((n : H.subgroupOf K) : G) *
        ((g : H.subgroupOf K) : G)⁻¹ ∈ L
    exact Subgroup.mem_subgroupOf.mp hconjH

private theorem normal_subgroupOf_of_normal_subgroupOf_of_le_sec9
    {G : Type u} [Group G] {L H K : Subgroup G}
    (hKH : K ≤ H) [(L.subgroupOf H).Normal] :
    (L.subgroupOf K).Normal := by
    constructor
    intro n hn g
    change ((g * n * g⁻¹ : K) : G) ∈ L
    have hnL : ((n : K) : G) ∈ L := by
      simpa [Subgroup.mem_subgroupOf] using hn
    let nH : H := ⟨(n : K), hKH n.2⟩
    let gH : H := ⟨(g : K), hKH g.2⟩
    have hnH : nH ∈ L.subgroupOf H := by
      change (nH : G) ∈ L
      simpa [nH] using hnL
    have hconjH : gH * nH * gH⁻¹ ∈ L.subgroupOf H :=
      (inferInstance : (L.subgroupOf H).Normal).conj_mem nH hnH gH
    change ((g : K) : G) * ((n : K) : G) * ((g : K) : G)⁻¹ ∈ L
    exact Subgroup.mem_subgroupOf.mp hconjH

public theorem exists_quotient_subgroupOf_subgroupOf_equiv_sec9
    {G : Type u} [Group G] {L H K : Subgroup G}
    (hHK : H ≤ K)
    [((L.subgroupOf K).subgroupOf (H.subgroupOf K)).Normal]
    [(L.subgroupOf H).Normal] :
    ∃ e :
        (H.subgroupOf K) ⧸
            ((L.subgroupOf K).subgroupOf (H.subgroupOf K)) ≃*
          H ⧸ L.subgroupOf H,
      ∀ h : H.subgroupOf K,
        e (QuotientGroup.mk'
              ((L.subgroupOf K).subgroupOf (H.subgroupOf K)) h) =
          QuotientGroup.mk' (L.subgroupOf H)
            ((Subgroup.subgroupOfEquivOfLe hHK) h) := by
    classical
    let eHK : H.subgroupOf K ≃* H := Subgroup.subgroupOfEquivOfLe hHK
    have hmap :
        Subgroup.map (eHK : H.subgroupOf K →* H)
            ((L.subgroupOf K).subgroupOf (H.subgroupOf K)) =
          L.subgroupOf H := by
      ext x
      constructor
      · intro hx
        rcases hx with ⟨y, hyL, hyx⟩
        have hyLG : (((y : H.subgroupOf K) : K) : G) ∈ L := by
          exact Subgroup.mem_subgroupOf.mp (Subgroup.mem_subgroupOf.mp hyL)
        have hxy : (x : G) = (((y : H.subgroupOf K) : K) : G) := by
          simpa [eHK, Subgroup.subgroupOfEquivOfLe] using
            congrArg (fun z : H => (z : G)) hyx.symm
        change (x : G) ∈ L
        simpa [hxy] using hyLG
      · intro hx
        let yK : K := ⟨(x : G), hHK x.property⟩
        have hyKH : yK ∈ H.subgroupOf K := by
          change ((yK : K) : G) ∈ H
          exact x.property
        let y : H.subgroupOf K := ⟨yK, hyKH⟩
        refine ⟨y, ?_, ?_⟩
        · change ((y : K) : G) ∈ L
          simpa [y, yK] using (Subgroup.mem_subgroupOf.mp hx)
        · ext
          rfl
    refine ⟨QuotientGroup.congr _ _ eHK hmap, ?_⟩
    intro h
    simp [eHK]

private theorem inf_sup_eq_of_disjoint_of_le_of_normalizes_left_sec9
    {G : Type u} [Group G] {P Q P0 : Subgroup G}
    (hP0P : P0 ≤ P)
    (hP0Q : P0 ≤ Subgroup.normalizer (Q : Set G))
    (hPQ : Disjoint P Q) :
    P ⊓ (Q ⊔ P0) = P0 := by
    apply le_antisymm
    · intro x hx
      have hxProd : x ∈ (Q : Set G) * (P0 : Set G) := by
        have hsup := Subgroup.coe_mul_of_right_le_normalizer_left Q P0 hP0Q
        rw [← hsup]
        exact hx.2
      rcases hxProd with ⟨q, hq, p0, hp0, hqpx⟩
      have hx_eq : x = q * p0 := hqpx.symm
      have hqP : q ∈ P := by
        have hp0P : p0 ∈ P := hP0P hp0
        have hqpP : q * p0 ∈ P := by
          simpa [← hx_eq] using hx.1
        have hcalc : q = (q * p0) * p0⁻¹ := by
          group
        rw [hcalc]
        exact P.mul_mem hqpP (P.inv_mem hp0P)
      have hqbot : q ∈ (⊥ : Subgroup G) := by
        have hqinf : q ∈ P ⊓ Q := ⟨hqP, hq⟩
        have hPQeq : P ⊓ Q = ⊥ := disjoint_iff.mp hPQ
        simpa [hPQeq] using hqinf
      have hq1 : q = 1 := by
        simpa using hqbot
      simpa [hx_eq, hq1] using hp0
    · intro x hx
      exact ⟨hP0P hx, Subgroup.mem_sup_right hx⟩


private theorem theorem_9_11_case_a_alpha_norm_formula_of_gamma_norm_sec9
    {L : Type*} [Group L] [Finite L]
    (γ ψ α : Section1.ClassFunction L) (q a u : ℕ)
