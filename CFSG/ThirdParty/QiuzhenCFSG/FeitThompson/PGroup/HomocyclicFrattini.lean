module

public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.Frattini.Core
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.PGroup.Homocyclic

namespace CFSG
end CFSG
open CFSG

/-!
# Frattini facts for standard homocyclic coordinate covers

This file keeps Frattini-specific facts about `StandardHomocyclicCover` separate
from the basic coordinate-cover API.
-/

noncomputable section

universe u

private theorem CFSG.zmod_cast_p_mul_eq_zero
    (p e : ℕ) (he : 1 ≤ e) (z : ZMod (p ^ e)) :
    ZMod.castHom (dvd_pow_self p (Nat.ne_of_gt he)) (ZMod p)
      ((p : ZMod (p ^ e)) * z) = 0 := by
  rw [map_mul]
  simp

private theorem CFSG.exists_zmod_p_mul_of_cast_eq_zero
    (p e : ℕ) [Fact p.Prime] (he : 1 ≤ e) (z : ZMod (p ^ e))
    (hz : ZMod.castHom (dvd_pow_self p (Nat.ne_of_gt he)) (ZMod p) z = 0) :
    ∃ y : ZMod (p ^ e), (p : ZMod (p ^ e)) * y = z := by
  haveI : NeZero (p ^ e) := ⟨pow_ne_zero e (Fact.out : Nat.Prime p).ne_zero⟩
  rw [ZMod.castHom_apply] at hz
  have hzval : (z.val : ZMod p) = 0 := by
    rw [ZMod.cast_eq_val] at hz
    exact hz
  have hp_dvd_val : p ∣ z.val := (ZMod.natCast_eq_zero_iff z.val p).1 hzval
  obtain ⟨y, hy⟩ := hp_dvd_val
  refine ⟨(y : ZMod (p ^ e)), ?_⟩
  rw [← ZMod.natCast_zmod_val z]
  rw [hy]
  simp [Nat.cast_mul]

/-- The standard homocyclic coordinate cover is abelian, so its commutator subgroup is trivial. -/
public theorem CFSG.standardHomocyclicCover_commutator_eq_bot
    (κ : Type u) (q : ℕ) :
    _root_.commutator (StandardHomocyclicCover κ q) = ⊥ := by
  rw [commutator_eq_bot_iff_center_eq_top]
  apply eq_top_iff.mpr
  intro x _hx
  exact Subgroup.mem_center_iff.mpr (fun y => by
    exact ((standardHomocyclicCover_commutative κ q).1.1 x y).symm)

/-- Every `p`-th power in the standard `p ^ e` cover dies under coordinatewise mod-`p`
reduction. -/
public theorem CFSG.standardHomocyclicCover_pthPower_mem_reduction_ker
    (κ : Type u) (p e : ℕ) (he : 1 ≤ e)
    (x : StandardHomocyclicCover κ (p ^ e)) :
    x ^ p ∈ (standardHomocyclicCoverReduction κ p e he).ker := by
  rw [standardHomocyclicCoverReduction_ker]
  change Multiplicative.toAdd (x ^ p) ∈ (standardHomocyclicCoverAddReduction κ p e he).ker
  rw [AddMonoidHom.mem_ker]
  ext i
  dsimp [standardHomocyclicCoverAddReduction]
  rw [nsmul_eq_mul]
  exact zmod_cast_p_mul_eq_zero p e he (Multiplicative.toAdd x i)

/-- The Frattini subgroup of the standard `p ^ e` coordinate cover is contained in the
kernel of coordinatewise mod-`p` reduction. -/
public theorem CFSG.standardHomocyclicCover_frattini_le_reduction_ker
    (κ : Type u) [Fintype κ] (p e : ℕ) [Fact p.Prime] (he : 1 ≤ e) :
    frattini (StandardHomocyclicCover κ (p ^ e)) ≤
      (standardHomocyclicCoverReduction κ p e he).ker := by
  haveI : Fact (IsPGroup p (StandardHomocyclicCover κ (p ^ e))) :=
    ⟨standardHomocyclicCover_isPGroup κ p e⟩
  rw [frattini_eq_closure_commutator_union_powers
    (R := StandardHomocyclicCover κ (p ^ e)) (p := p)]
  refine (Subgroup.closure_le ((standardHomocyclicCoverReduction κ p e he).ker)).2 ?_
  intro x hx
  rcases hx with hxcomm | ⟨y, rfl⟩
  · have hxbot : x ∈ (⊥ : Subgroup (StandardHomocyclicCover κ (p ^ e))) := by
      simpa [standardHomocyclicCover_commutator_eq_bot κ (p ^ e)] using hxcomm
    have hx1 : x = 1 := by
      simp at hxbot
      exact hxbot
    simp [hx1]
  · exact standardHomocyclicCover_pthPower_mem_reduction_ker κ p e he y

/-- The kernel of coordinatewise mod-`p` reduction is contained in the subgroup generated by
`p`-th powers. -/
public theorem CFSG.standardHomocyclicCover_reduction_ker_le_powers_closure
    (κ : Type u) (p e : ℕ) [Fact p.Prime] (he : 1 ≤ e) :
    (standardHomocyclicCoverReduction κ p e he).ker ≤
      Subgroup.closure (Set.range (fun x : StandardHomocyclicCover κ (p ^ e) => x ^ p)) := by
  intro x hx
  rw [standardHomocyclicCoverReduction_ker] at hx
  change Multiplicative.toAdd x ∈ (standardHomocyclicCoverAddReduction κ p e he).ker at hx
  rw [AddMonoidHom.mem_ker] at hx
  have hcoord : ∀ i : κ, ∃ y : ZMod (p ^ e),
      (p : ZMod (p ^ e)) * y = Multiplicative.toAdd x i := by
    intro i
    exact exists_zmod_p_mul_of_cast_eq_zero p e he (Multiplicative.toAdd x i) (by
      exact congrFun hx i)
  choose y hy using hcoord
  have hpow : Multiplicative.ofAdd y ^ p = x := by
    apply Multiplicative.toAdd.injective
    ext i
    rw [show Multiplicative.toAdd (Multiplicative.ofAdd y ^ p) i =
        (p : ZMod (p ^ e)) * y i by
      simp [nsmul_eq_mul]]
    exact hy i
  rw [← hpow]
  exact Subgroup.subset_closure ⟨Multiplicative.ofAdd y, rfl⟩

/-- The Frattini subgroup of the standard `p ^ e` coordinate cover is exactly the kernel of
coordinatewise mod-`p` reduction. -/
public theorem CFSG.standardHomocyclicCover_frattini_eq_reduction_ker
    (κ : Type u) [Fintype κ] (p e : ℕ) [Fact p.Prime] (he : 1 ≤ e) :
    frattini (StandardHomocyclicCover κ (p ^ e)) =
      (standardHomocyclicCoverReduction κ p e he).ker := by
  refine le_antisymm
    (standardHomocyclicCover_frattini_le_reduction_ker κ p e he) ?_
  intro x hx
  have hxpow :
      x ∈ Subgroup.closure
        (Set.range (fun y : StandardHomocyclicCover κ (p ^ e) => y ^ p)) :=
    standardHomocyclicCover_reduction_ker_le_powers_closure κ p e he hx
  haveI : Fact (IsPGroup p (StandardHomocyclicCover κ (p ^ e))) :=
    ⟨standardHomocyclicCover_isPGroup κ p e⟩
  rw [frattini_eq_closure_commutator_union_powers
    (R := StandardHomocyclicCover κ (p ^ e)) (p := p)]
  exact Subgroup.closure_mono (fun y hy => Or.inr hy) hxpow

/-- The Frattini quotient of the standard `p ^ e` cover is the standard mod-`p`
coordinate cover. -/
@[expose] public noncomputable def CFSG.standardHomocyclicCoverFrattiniQuotientEquiv
    (κ : Type u) [Fintype κ] (p e : ℕ) [Fact p.Prime] (he : 1 ≤ e) :
    StandardHomocyclicCover κ (p ^ e) ⧸
        frattini (StandardHomocyclicCover κ (p ^ e)) ≃*
      StandardHomocyclicCover κ p :=
  (QuotientGroup.quotientMulEquivOfEq
    (standardHomocyclicCover_frattini_eq_reduction_ker κ p e he)).trans
    (QuotientGroup.quotientKerEquivOfSurjective
      (φ := standardHomocyclicCoverReduction κ p e he)
      (standardHomocyclicCoverReduction_surjective κ p e he))

