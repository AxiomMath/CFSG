/-!
# Statements from BG Section 7

This file records the statement scaffold for the results in `docs/section7.tex`.
-/

section

variable {G : Type*} [Group G] [Finite G]

/-- The prime support `π(H)` of a finite subgroup `H`. -/
@[expose] public def CFSG.subgroupPrimeSet (H : Subgroup G) : Set Nat.Primes :=
  {p | p.val ∣ Nat.card H}

/-- The `π`-core of `H`, viewed as a subgroup of the ambient group. -/
@[expose] public def CFSG.piCoreIn (π : Set Nat.Primes) (H : Subgroup G) : Subgroup G :=
  (piCore π ↥H).map H.subtype

/-- The subgroup `K = O_{π'}(C_G(A))` from Hypothesis 7.1. -/
@[expose] public def CFSG.section7K (A : Subgroup G) : Subgroup G :=
  piCoreIn (subgroupPrimeSet A)ᶜ (Subgroup.centralizer (A : Set G))

/-- The family `𝓗_H(A;π)` of `π`-subgroups of `H` normalized by `A`. -/
@[expose] public def CFSG.section7HFamily
    (H A : Subgroup G) (π : Set Nat.Primes) : Set (Subgroup G) :=
  {Q | Q ≤ H ∧ IsPiSubgroup π Q ∧ A ≤ Subgroup.normalizer (Q : Set G)}

/-- The family `𝓗_H^*(A;π)` of maximal members of `𝓗_H(A;π)`. -/
@[expose] public def CFSG.section7HStarFamily
    (H A : Subgroup G) (π : Set Nat.Primes) : Set (Subgroup G) :=
  {Q | Q ∈ section7HFamily H A π ∧
      ∀ R : Subgroup G, Q ≤ R → R ∈ section7HFamily H A π → R = Q}

/-- The subgroup generated by the family `𝓗_H(A;π)`. -/
@[expose] public def CFSG.section7Generated
    (H A : Subgroup G) (π : Set Nat.Primes) : Subgroup G :=
  sSup (section7HFamily H A π)

/-- The derived subgroup of `H`, transported back to the ambient group. -/
@[expose] public def CFSG.ambientDerivedSubgroup (H : Subgroup G) : Subgroup G :=
  (derivedSubgroup ↥H).map H.subtype

/-- `A` is subnormal in `P`: there is a finite chain from `A` to `P`
with each term normal in the next. -/
@[expose] public def CFSG.IsSubnormalIn (A P : Subgroup G) : Prop :=
  ∃ n : ℕ, ∃ chain : Fin (n + 1) → Subgroup G,
    chain 0 = A ∧ chain (Fin.last n) = P ∧
      (∀ i : Fin n, chain i.castSucc ≤ chain i.succ) ∧
      ∀ i : Fin n, ((chain i.castSucc).subgroupOf (chain i.succ)).Normal

/-- Conjugation by `K` acts transitively on the family `Ω`. -/
@[expose] public def CFSG.ConjugationActionTransitiveOn
    (K : Subgroup G) (Ω : Set (Subgroup G)) : Prop :=
  ∀ Q₁ ∈ Ω, ∀ Q₂ ∈ Ω, ∃ k : K, Q₂ = Q₁.conjBy (k : G)

/-- The local `SCN_n(p)` family: members of `SCN_n(P)` for some Sylow `p`-subgroup `P` of `G`. -/
@[expose] public def CFSG.scnPrimeSubgroups
    (n p : ℕ) [Fact p.Prime] (G : Type*) [Group G] [Finite G] : Set (Subgroup G) :=
  {A | ∃ P : Sylow p G, A ≤ (P : Subgroup G) ∧
      A.subgroupOf (P : Subgroup G) ∈ scnSubgroups n ↥(P : Subgroup G)}

/-- Hypothesis 7.1 from the blueprint. -/
@[expose] public def CFSG.Hypothesis7_1 (A : Subgroup G) : Prop :=
  A ≠ ⊥ ∧ A ≠ ⊤ ∧
    ∀ X : Subgroup G, A ≤ X → X ≠ ⊤ →
      section7Generated X A (subgroupPrimeSet A)ᶜ = piCoreIn (subgroupPrimeSet A)ᶜ X

omit [Finite G] in
public lemma CFSG.IsPiSubgroup.map {G' : Type*} [Group G'] {π : Set Nat.Primes}
    {H : Subgroup G} (hH : IsPiSubgroup (G := G) π H) (f : G →* G') :
    IsPiSubgroup (G := G') π (H.map f) := by
  intro p hp
  exact hH p (hp.trans (Subgroup.card_map_dvd (H := H) f))

omit [Finite G] in
public lemma CFSG.IsPiSubgroup.sup_of_normal_right {π : Set Nat.Primes}
    {H K : Subgroup G} (hH : IsPiSubgroup (G := G) π H)
    (hK : IsPiSubgroup (G := G) π K) [K.Normal] :
    IsPiSubgroup (G := G) π (H ⊔ K) := by
  intro p hpSup
  have hmul : (↑(H ⊔ K) : Set G) = (H : Set G) * (K : Set G) := by
    simpa using (Subgroup.mul_normal H K)
  have hcard_sup_set :
      Nat.card (↑(H ⊔ K) : Set G) = Nat.card ((H : Set G) * (K : Set G) : Set G) :=
    Nat.card_congr (Set.equivOfEq hmul)
  have hcard_sup :
      Nat.card (↥(H ⊔ K)) = Nat.card ((H : Set G) * (K : Set G) : Set G) := by
    simpa using hcard_sup_set
  have hcard_mul :
      Nat.card ((H : Set G) * (K : Set G) : Set G) =
        Nat.card K * Nat.card ((H : Set G).image (↑) : Set (G ⧸ K)) := by
    simpa using
      (Subgroup.card_mul_eq_card_subgroup_mul_card_quotient (s := K) (t := (H : Set G)))
  have hset_image :
      ((H : Set G).image (↑) : Set (G ⧸ K)) =
        (H.map (QuotientGroup.mk' K) : Set (G ⧸ K)) := by
    simp [Subgroup.coe_map]
  have hcard_image_set :
      Nat.card ((H : Set G).image (↑) : Set (G ⧸ K)) =
        Nat.card (H.map (QuotientGroup.mk' K) : Set (G ⧸ K)) :=
    Nat.card_congr (Set.equivOfEq hset_image)
  have hcard_image_subgroup :
      Nat.card ((H : Set G).image (↑) : Set (G ⧸ K)) = Nat.card (H.map (QuotientGroup.mk' K)) := by
    exact hcard_image_set
  have hp_mul :
      p.val ∣ Nat.card K * Nat.card ((H : Set G).image (↑) : Set (G ⧸ K)) := by
    rw [← hcard_mul, ← hcard_sup]
    exact hpSup
  rcases p.2.dvd_mul.mp hp_mul with hpK | hpImg
  · exact hK p hpK
  · have hpMap : p.val ∣ Nat.card (H.map (QuotientGroup.mk' K)) := by
      rwa [hcard_image_subgroup] at hpImg
    exact (hH.map (QuotientGroup.mk' K)) p hpMap

omit [Finite G] in
public lemma CFSG.normalPiSubgroups_nonempty (π : Set Nat.Primes) :
    ({K : Subgroup G | K.Normal ∧ IsPiSubgroup (G := G) π K} : Set (Subgroup G)).Nonempty := by
  refine ⟨⊥, ?_⟩
  constructor
  · infer_instance
  · intro p hp
    exfalso
    exact p.2.not_dvd_one (by simpa using hp)

omit [Finite G] in
public lemma CFSG.directedOn_normal_piSubgroups (π : Set Nat.Primes) :
    DirectedOn (· ≤ ·) ({K : Subgroup G | K.Normal ∧ IsPiSubgroup (G := G) π K} : Set (Subgroup G)) := by
  intro H hH K hK
  rcases hH with ⟨hHnorm, hHπ⟩
  rcases hK with ⟨hKnorm, hKπ⟩
  refine ⟨H ⊔ K, ⟨?_, ?_⟩, le_sup_left, le_sup_right⟩
  · haveI : H.Normal := hHnorm
    haveI : K.Normal := hKnorm
    exact Subgroup.sup_normal H K
  · haveI : K.Normal := hKnorm
    exact hHπ.sup_of_normal_right hKπ

omit [Finite G] in
public lemma CFSG.piCore_map_iso {π : Set Nat.Primes} {G' : Type*} [Group G']
    (f : G ≃* G') :
    (piCore π G).map f.toMonoidHom = piCore π G' := by
  let S : Set (Subgroup G) := {K | K.Normal ∧ IsPiSubgroup (G := G) π K}
  let S' : Set (Subgroup G') := {K' | K'.Normal ∧ IsPiSubgroup (G := G') π K'}
  let F : Subgroup G ≃o Subgroup G' := MulEquiv.mapSubgroup f
  have hImage : F '' S = S' := by
    ext K'
    constructor
    · rintro ⟨K, ⟨hKnorm, hKπ⟩, rfl⟩
      constructor
      · exact Subgroup.Normal.map hKnorm f.toMonoidHom f.surjective
      · change IsPiSubgroup (G := G') π (K.map f.toMonoidHom)
        exact hKπ.map f.toMonoidHom
    · intro hK'
      refine ⟨F.symm K', ?_, ?_⟩
      constructor
      · exact Subgroup.Normal.map hK'.1 f.symm.toMonoidHom f.symm.surjective
      · simpa [F] using hK'.2.map f.symm.toMonoidHom
      · ext x
        simp [F]
  calc
    (piCore π G).map f.toMonoidHom = (sSup S).map f.toMonoidHom := rfl
    _ = F (sSup S) := rfl
    _ = ⨆ K ∈ S, F K := OrderIso.map_sSup F S
    _ = sSup (F '' S) := by simp [sSup_image]
    _ = sSup S' := by rw [hImage]
    _ = piCore π G' := rfl

public instance CFSG.piCore_characteristic (π : Set Nat.Primes) : (piCore π G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro φ
  simpa using (piCore_map_iso (G := G) (G' := G) (π := π) φ)

public instance CFSG.piCore_normal (π : Set Nat.Primes) : (piCore π G).Normal := by
  refine ⟨?_⟩
  intro n hn g
  have hdir := directedOn_normal_piSubgroups (G := G) π
  have hne := normalPiSubgroups_nonempty (G := G) π
  rcases ((Subgroup.mem_sSup_of_directedOn hne hdir).mp hn) with ⟨K, hK, hnK⟩
  exact Subgroup.mem_sSup_of_mem hK (hK.1.conj_mem n hnK g)

public lemma CFSG.piCore_isPiSubgroup (π : Set Nat.Primes) :
    IsPiSubgroup (G := G) π (piCore π G) := by
  let S : Set (Subgroup G) := {K | K.Normal ∧ IsPiSubgroup (G := G) π K}
  have hne : S.Nonempty := normalPiSubgroups_nonempty (G := G) π
  have hImageFinite : ((fun L : Subgroup G => Nat.card L) '' S).Finite := by
    refine (Set.finite_Iic (Nat.card G)).subset ?_
    rintro n ⟨K, hK, rfl⟩
    simpa [Set.mem_Iic] using
      (Subgroup.card_le_of_le (show K ≤ (⊤ : Subgroup G) by exact le_top))
  obtain ⟨K, hKmax⟩ :=
    hImageFinite.exists_maximalFor' (f := fun L : Subgroup G => Nat.card L) S hne
  have hKmem : K ∈ S := hKmax.1
  have hpiCore_le : piCore π G ≤ K := by
    intro x hx
    have hdir := directedOn_normal_piSubgroups (G := G) π
    have hne' := normalPiSubgroups_nonempty (G := G) π
    rcases (Subgroup.mem_sSup_of_directedOn hne' hdir).mp hx with ⟨L, hLmem, hxL⟩
    have hsup_mem : L ⊔ K ∈ S := by
      rcases hLmem with ⟨hLnorm, hLπ⟩
      rcases hKmem with ⟨hKnorm, hKπ⟩
      refine ⟨?_, ?_⟩
      · haveI : L.Normal := hLnorm
        haveI : K.Normal := hKnorm
        exact Subgroup.sup_normal L K
      · haveI : K.Normal := hKnorm
        exact hLπ.sup_of_normal_right hKπ
    have hcard_sup_le : Nat.card ↥(L ⊔ K) ≤ Nat.card ↥K := hKmax.le hsup_mem
    have hcard_K_le : Nat.card ↥K ≤ Nat.card ↥(L ⊔ K) :=
      Subgroup.card_le_of_le le_sup_right
    have hcard_eq : Nat.card ↥(L ⊔ K) = Nat.card ↥K :=
      Nat.le_antisymm hcard_sup_le hcard_K_le
    have hsup_eq : L ⊔ K = K := by
      symm
      exact Subgroup.eq_of_le_of_card_ge le_sup_right (by simpa using hcard_sup_le)
    have hL_le_K : L ≤ K := by
      intro y hy
      have hy_sup : y ∈ L ⊔ K := Subgroup.mem_sup_left hy
      simpa [hsup_eq] using hy_sup
    exact hL_le_K hxL
  have hK_le_piCore : K ≤ piCore π G := le_sSup hKmem
  have hEq : piCore π G = K := le_antisymm hpiCore_le hK_le_piCore
  simpa [hEq] using hKmem.2

public lemma CFSG.piCoreIn_isPiSubgroup (π : Set Nat.Primes) (H : Subgroup G) :
    IsPiSubgroup (G := G) π (piCoreIn π H) := by
  simpa [piCoreIn] using
    (piCore_isPiSubgroup (G := ↥H) π).map H.subtype

omit [Finite G] in
public lemma CFSG.piCoreIn_le (π : Set Nat.Primes) (H : Subgroup G) :
    piCoreIn π H ≤ H := by
  intro x hx
  rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
  exact y.property

omit [Finite G] in
public lemma CFSG.piCore_map_subtype_subgroupOf (π : Set Nat.Primes) (H : Subgroup G) :
    (piCoreIn π H).subgroupOf H = piCore π ↥H := by
  change ((piCore π ↥H).map H.subtype).comap H.subtype = piCore π ↥H
  exact
    Subgroup.comap_map_eq_self_of_injective
      (H := piCore π ↥H) (f := H.subtype) H.subtype_injective

omit [Finite G] in
public lemma CFSG.le_centralizer_of_le_centralizer {A S : Subgroup G}
    (hSC : S ≤ Subgroup.centralizer (A : Set G)) :
    A ≤ Subgroup.centralizer (S : Set G) := by
  intro a ha
  rw [Subgroup.mem_centralizer_iff]
  intro s hs
  exact (Subgroup.mem_centralizer_iff.mp (hSC hs) a ha).symm

omit [Finite G] in
public lemma CFSG.eq_bot_of_isPiSubgroup_map_of_isPiGroup
    {π : Set Nat.Primes} {G' : Type*} [Group G'] [Finite G']
    {K : Subgroup G} (hK : IsPiSubgroup (G := G) πᶜ K)
    (hG' : IsPiGroup π G') (f : G →* G') :
    K.map f = ⊥ := by
  by_contra hmap_ne_bot
  have hcard_ne_one : Nat.card (K.map f) ≠ 1 := by
    intro hcard
    exact hmap_ne_bot ((Subgroup.card_eq_one (H := K.map f)).1 hcard)
  obtain ⟨p, hp⟩ := Nat.exists_prime_and_dvd hcard_ne_one
  rcases hp with ⟨hpPrime, hpMap⟩
  let p' : Nat.Primes := ⟨p, hpPrime⟩
  have hpMem : p' ∈ π := by
    exact (IsPiGroup_iff π G').1 hG' p' (dvd_trans hpMap (Subgroup.card_subgroup_dvd_card (K.map f)))
  have hpNotMem : p' ∉ π := by
    simpa using (hK.map f) p' hpMap
  exact hpNotMem hpMem

public lemma CFSG.coprime_card_of_piCoreIn_compl (A H : Subgroup G) :
    Nat.Coprime (Nat.card A) (Nat.card (piCoreIn (subgroupPrimeSet A)ᶜ H)) := by
  have hπ' : IsPiSubgroup (G := G) (subgroupPrimeSet A)ᶜ (piCoreIn (subgroupPrimeSet A)ᶜ H) :=
    piCoreIn_isPiSubgroup (G := G) (subgroupPrimeSet A)ᶜ H
  refine Nat.coprime_of_dvd ?_
  intro p hpPrime hpA hpCore
  let p' : Nat.Primes := ⟨p, hpPrime⟩
  have hpMem : p' ∈ subgroupPrimeSet A := hpA
  have hpNotMem : p' ∉ subgroupPrimeSet A := by
    simpa using hπ' p' hpCore
  exact hpNotMem hpMem

public lemma CFSG.le_section7K_of_le_centralizer_isPiSubgroup [IsMinCE G]
    {A S : Subgroup G} (hA : Hypothesis7_1 A)
    (hSC : S ≤ Subgroup.centralizer (A : Set G))
    (hSπ : IsPiSubgroup (G := G) (subgroupPrimeSet A)ᶜ S) :
    S ≤ section7K A := by
  classical
  let C : Subgroup G := Subgroup.centralizer (A : Set G)
  let Ssub : Subgroup C := S.subgroupOf C
  let L : Subgroup C := Subgroup.normalClosure (↑Ssub : Set C)
  let Lmap : Subgroup G := L.map C.subtype
  let Y : Subgroup G := A ⊔ Lmap
  let M : Subgroup G := piCoreIn (subgroupPrimeSet A)ᶜ Y
  let Lsub : Subgroup Y := Lmap.subgroupOf Y
  let : IsSimpleGroup G := IsMinCE.simple
  have hLmap_le_C : Lmap ≤ C := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    exact y.property
  have hY_le_normA : Y ≤ Subgroup.normalizer (A : Set G) := by
    refine sup_le A.le_normalizer ?_
    exact hLmap_le_C.trans (centralizer_le_normalizer A)
  have hYproper : Y ≠ ⊤ := by
    intro hYtop
    have hnormA_top : Subgroup.normalizer (A : Set G) = ⊤ := by
      apply top_unique
      simpa [Y, hYtop] using hY_le_normA
    have hAnorm : A.Normal := (Subgroup.normalizer_eq_top_iff).mp hnormA_top
    rcases (haveI := hAnorm; IsSimpleGroup.eq_bot_or_eq_top_of_normal A) with hAbot | hAtop
    · exact hA.1 hAbot
    · exact hA.2.1 hAtop
  have hS_le_Lmap : S ≤ Lmap := by
    intro x hx
    refine Subgroup.mem_map.mpr ?_
    refine ⟨⟨x, hSC hx⟩, ?_, rfl⟩
    exact Subgroup.le_normalClosure (H := Ssub) hx
  have hA_le_centS : A ≤ Subgroup.centralizer (S : Set G) :=
    le_centralizer_of_le_centralizer hSC
  have hA_le_normS : A ≤ Subgroup.normalizer (S : Set G) :=
    hA_le_centS.trans (centralizer_le_normalizer S)
  have hA_le_centLmap : A ≤ Subgroup.centralizer (Lmap : Set G) :=
    le_centralizer_of_le_centralizer hLmap_le_C
  have hA_le_normLmap : A ≤ Subgroup.normalizer (Lmap : Set G) :=
    hA_le_centLmap.trans (centralizer_le_normalizer Lmap)
  have hA_le_Y : A ≤ Y := le_sup_left
  have hSfam : S ∈ section7HFamily Y A (subgroupPrimeSet A)ᶜ := by
    exact ⟨hS_le_Lmap.trans le_sup_right, hSπ, hA_le_normS⟩
  have hM_eq : section7Generated Y A (subgroupPrimeSet A)ᶜ = M :=
    hA.2.2 Y hA_le_Y hYproper
  have hS_le_M : S ≤ M := by
    have hS_le_gen : S ≤ section7Generated Y A (subgroupPrimeSet A)ᶜ := le_sSup hSfam
    simpa [hM_eq] using hS_le_gen
  have hC_le_normLmap : C ≤ Subgroup.normalizer (Lmap : Set G) := by
    refine subgroup_le_normalizer_of_conj_mem Lmap C ?_
    intro c x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    have hxyL : ((c : C) * y * (c : C)⁻¹) ∈ L :=
      (inferInstance : L.Normal).conj_mem y hy c
    have hxyC : ((c : G) * (y : G) * (c : G)⁻¹) ∈ C := by
      exact C.mul_mem (C.mul_mem c.property y.property) (C.inv_mem c.property)
    exact Subgroup.mem_map.mpr ⟨⟨(c : G) * (y : G) * (c : G)⁻¹, hxyC⟩, hxyL, rfl⟩
  have hY_le_normLmap : Y ≤ Subgroup.normalizer (Lmap : Set G) := by
    exact sup_le hA_le_normLmap Lmap.le_normalizer
  have hLsub_norm : (Lmap.subgroupOf Y).Normal := by
    exact Subgroup.normal_subgroupOf_of_le_normalizer (H := Y) (N := Lmap) hY_le_normLmap
  let : Lsub.Normal := by
    simpa [Lsub] using hLsub_norm
  let q : Y →* (Y ⧸ Lsub) := QuotientGroup.mk' Lsub
  have hAY_norm : (A.subgroupOf Y).Normal := by
    exact Subgroup.normal_subgroupOf_of_le_normalizer (H := Y) (N := A) hY_le_normA
  let : (A.subgroupOf Y).Normal := hAY_norm
  have hsub_sup : A.subgroupOf Y ⊔ Lmap.subgroupOf Y = ⊤ := by
    calc
      A.subgroupOf Y ⊔ Lmap.subgroupOf Y = (A ⊔ Lmap).subgroupOf Y := by
        symm
        exact
          Subgroup.subgroupOf_sup
            (A := A) (A' := Lmap) (B := Y) le_sup_left le_sup_right
      _ = ⊤ := by simp [Y]
  have hC_le_normY : C ≤ Subgroup.normalizer (Y : Set G) := by
    refine subgroup_le_normalizer_of_conj_mem Y C ?_
    intro c y hy
    let yY : Y := ⟨y, hy⟩
    have hy_sup : yY ∈ A.subgroupOf Y ⊔ Lmap.subgroupOf Y := by
      simp [hsub_sup]
    rcases
        (Subgroup.mem_sup_of_normal_left
          (s := A.subgroupOf Y) (t := Lmap.subgroupOf Y) (x := yY)).1 hy_sup with
      ⟨a, ha, l, hl, hmul⟩
    have haA : (a : G) ∈ A := by
      simpa [Subgroup.mem_subgroupOf] using ha
    have hlLmap : (l : G) ∈ Lmap := by
      simpa [Subgroup.mem_subgroupOf] using hl
    have hcomm : (a : G) * (c : G) = (c : G) * (a : G) :=
      (Subgroup.mem_centralizer_iff.mp c.property) _ haA
    have hclY : (c : G) * (l : G) * (c : G)⁻¹ ∈ Lmap :=
      (Subgroup.mem_normalizer_iff.mp (hC_le_normLmap c.property) _).1 hlLmap
    have hmul' :
        (c : G) * y * (c : G)⁻¹ =
          (a : G) * ((c : G) * (l : G) * (c : G)⁻¹) := by
      calc
        (c : G) * y * (c : G)⁻¹
            = (c : G) * (((a : G) * (l : G)) : G) *
                (c : G)⁻¹ := by
                  simpa using congrArg Subtype.val hmul.symm
        _ = ((c : G) * (a : G)) * (l : G) * (c : G)⁻¹ := by
                simp [mul_assoc]
        _ = ((a : G) * (c : G)) * (l : G) * (c : G)⁻¹ := by
                rw [hcomm]
        _ = (a : G) * ((c : G) * (l : G) * (c : G)⁻¹) := by
                simp [mul_assoc]
    have hcyY : (c : G) * y * (c : G)⁻¹ ∈ Y :=
      hmul' ▸ Y.mul_mem (Subgroup.mem_sup_left haA) (Subgroup.mem_sup_right hclY)
    exact hcyY
  have hLsub_map_bot : Lsub.map q = ⊥ := by
    refine (Subgroup.map_eq_bot_iff (H := Lsub) (f := q)).2 ?_
    simp [q, QuotientGroup.ker_mk']
  have hA_pi : IsPiGroup (subgroupPrimeSet A) ↥(A.subgroupOf Y) := by
    let e : A.subgroupOf Y ≃* A := Subgroup.subgroupOfEquivOfLe hA_le_Y
    have hA_pi0 : IsPiGroup (subgroupPrimeSet A) ↥A := by
      rw [IsPiGroup_iff (subgroupPrimeSet A) ↥A]
      intro p hp
      simpa [subgroupPrimeSet] using hp
    exact IsPiGroup.of_equiv (π := subgroupPrimeSet A) (G := ↥(A.subgroupOf Y)) hA_pi0 e
  have hAmap_top : (A.subgroupOf Y).map q = ⊤ := by
    calc
      (A.subgroupOf Y).map q = (A.subgroupOf Y).map q ⊔ ⊥ := by simp
      _ = (A.subgroupOf Y).map q ⊔ Lsub.map q := by rw [hLsub_map_bot]
      _ = (A.subgroupOf Y ⊔ Lsub).map q := by
            symm
            exact Subgroup.map_sup (A.subgroupOf Y) Lsub q
      _ = ⊤ := by
            rw [hsub_sup]
            exact Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective Lsub)
  let φ : A.subgroupOf Y →* (Y ⧸ Lsub) := q.comp (A.subgroupOf Y).subtype
  have hφ_surj : Function.Surjective φ := by
    intro z
    have hz : z ∈ (A.subgroupOf Y).map q := by simp [hAmap_top]
    rcases hz with ⟨a, ha, hza⟩
    refine ⟨⟨a, ha⟩, ?_⟩
    simpa [φ] using hza
  have hquot_pi : IsPiGroup (subgroupPrimeSet A) (Y ⧸ Lsub) :=
    IsPiGroup.of_surjective (π := subgroupPrimeSet A) (G := ↥(A.subgroupOf Y))
      (H := Y ⧸ Lsub) hA_pi φ hφ_surj
  have hM_le_Y : M ≤ Y := piCoreIn_le _ Y
  have hMsub_eq : M.subgroupOf Y = piCore (subgroupPrimeSet A)ᶜ ↥Y := by
    simpa [M] using piCore_map_subtype_subgroupOf (G := G) (subgroupPrimeSet A)ᶜ Y
  have hMsub_pi : IsPiSubgroup (G := Y) (subgroupPrimeSet A)ᶜ (M.subgroupOf Y) := by
    simpa [hMsub_eq] using
      (piCore_isPiSubgroup (G := ↥Y) (subgroupPrimeSet A)ᶜ)
  have hMsub_map_bot : (M.subgroupOf Y).map q = ⊥ :=
    eq_bot_of_isPiSubgroup_map_of_isPiGroup hMsub_pi hquot_pi q
  have hMsub_le_Lsub : M.subgroupOf Y ≤ Lsub := by
    have hMsub_le_ker : M.subgroupOf Y ≤ q.ker :=
      (Subgroup.map_eq_bot_iff (H := M.subgroupOf Y) (f := q)).1 hMsub_map_bot
    simpa [q, QuotientGroup.ker_mk'] using hMsub_le_ker
  have hM_le_Lmap : M ≤ Lmap := by
    intro x hx
    exact hMsub_le_Lsub (show (⟨x, hM_le_Y hx⟩ : Y) ∈ M.subgroupOf Y by simpa)
  have hM_le_C : M ≤ C := hM_le_Lmap.trans hLmap_le_C
  have hMsub_char : (M.subgroupOf Y).Characteristic := by
    rw [hMsub_eq]
    exact piCore_characteristic (G := ↥Y) (subgroupPrimeSet A)ᶜ
  have hC_le_normM : C ≤ Subgroup.normalizer (M : Set G) := by
    refine subgroup_le_normalizer_of_conj_mem M C ?_
    intro c y hy
    let cY : Subgroup.normalizer (Y : Set G) := ⟨c, hC_le_normY c.property⟩
    let yY : Y := ⟨y, hM_le_Y hy⟩
    have hyY : yY ∈ M.subgroupOf Y := by
      exact Subgroup.mem_subgroupOf.mpr hy
    have hfix :
        Subgroup.comap (Subgroup.normalizerMonoidHom Y cY).toMonoidHom (M.subgroupOf Y) =
          M.subgroupOf Y :=
      hMsub_char.fixed (Subgroup.normalizerMonoidHom Y cY)
    have hyComap :
        yY ∈ Subgroup.comap (Subgroup.normalizerMonoidHom Y cY).toMonoidHom (M.subgroupOf Y) := by
      rw [hfix]
      exact hyY
    have hyImage : (Subgroup.normalizerMonoidHom Y cY) yY ∈ M.subgroupOf Y := hyComap
    change (((Subgroup.normalizerMonoidHom Y cY) yY : Y) : G) ∈ M at hyImage
    simpa [cY, yY, mul_assoc, Subgroup.normalizerMonoidHom_apply_apply_coe] using hyImage
  have hMsub_normC : (M.subgroupOf C).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer (H := C) (N := M) hC_le_normM
  have hM_pi : IsPiSubgroup (G := G) (subgroupPrimeSet A)ᶜ M :=
    piCoreIn_isPiSubgroup (G := G) (subgroupPrimeSet A)ᶜ Y
  have hMsub_piC : IsPiSubgroup (G := C) (subgroupPrimeSet A)ᶜ (M.subgroupOf C) := by
    intro p hp
    have hcard :
        Nat.card (M.subgroupOf C) = Nat.card M :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hM_le_C).toEquiv
    exact hM_pi p (by rwa [hcard] at hp)
  have hMsub_le_core : M.subgroupOf C ≤ piCore (subgroupPrimeSet A)ᶜ ↥C :=
    le_sSup ⟨hMsub_normC, hMsub_piC⟩
  have hM_le_K : M ≤ section7K A := by
    have hmap_le := Subgroup.map_mono (f := C.subtype) hMsub_le_core
    rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hM_le_C] at hmap_le
    change M ≤ (piCore (subgroupPrimeSet A)ᶜ ↥C).map C.subtype
    exact hmap_le
  exact hS_le_M.trans hM_le_K

omit [Finite G] in
public lemma CFSG.IsPiSubgroup.subgroupOf {π : Set Nat.Primes}
    {H K : Subgroup G} (hKπ : IsPiSubgroup (G := G) π K) (hKH : K ≤ H) :
    IsPiSubgroup (G := H) π (K.subgroupOf H) := by
  intro p hp
  have hcard : Nat.card (K.subgroupOf H) = Nat.card K :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKH).toEquiv
  exact hKπ p (by rwa [hcard] at hp)

omit [Finite G] in
public lemma CFSG.isInvariant_subgroupOf_of_le_normalizer
    {A H K : Subgroup G}
    (hAH : A ≤ Subgroup.normalizer (H : Set G))
    (hAK : A ≤ Subgroup.normalizer (K : Set G))
    (_hKH : K ≤ H) :
    haveI : Subgroup.Normalizes A H := ⟨hAH⟩
    IsInvariant (↥A) (↥H) (K.subgroupOf H) := by
  haveI : Subgroup.Normalizes A H := ⟨hAH⟩
  refine ⟨?_⟩
  intro a x
  change ((x : H) : G) ∈ K ↔ ((a : G) * ((x : H) : G) * (a : G)⁻¹) ∈ K
  exact (Subgroup.mem_normalizer_iff.mp (hAK a.property) ((x : H) : G))

omit [Finite G] in
public lemma CFSG.IsHallSubgroup.isPiSubgroup {π : Set Nat.Primes} {H : Subgroup G}
    (hH : IsHallSubgroup π H) :
    IsPiSubgroup (G := G) π H :=
  hH.p_in_pi_of_p_dvd_card

public lemma CFSG.isPGroup_of_isPiSubgroup_singleton {H : Subgroup G} {q : Nat.Primes}
    (hH : IsPiSubgroup (G := G) ({q} : Set Nat.Primes) H) :
    IsPGroup q.val H := by
  letI : Fact q.val.Prime := ⟨q.2⟩
  rw [IsPGroup.iff_card]
  have hcard_ne_zero : Nat.card H ≠ 0 := Nat.card_pos.ne'
  refine ⟨(Nat.card H).primeFactorsList.length, ?_⟩
  rw [← List.prod_replicate, ← List.eq_replicate_of_mem ?_, Nat.prod_primeFactorsList hcard_ne_zero]
  intro p hp
  obtain ⟨hp_prime, hp_dvd⟩ := (Nat.mem_primeFactorsList hcard_ne_zero).mp hp
  let p' : Nat.Primes := ⟨p, hp_prime⟩
  have hp_mem : p' ∈ ({q} : Set Nat.Primes) := hH p' hp_dvd
  simpa [p'] using congrArg Subtype.val hp_mem

public lemma CFSG.normalizerCondition_of_isPiSubgroup_singleton {H : Subgroup G} {q : Nat.Primes}
    (hH : IsPiSubgroup (G := G) ({q} : Set Nat.Primes) H) :
    NormalizerCondition ↥H := by
  letI : Fact (Nat.Prime q.val) := ⟨q.2⟩
  haveI : Group.IsNilpotent ↥H := by
    exact IsPGroup.isNilpotent (p := q.val) (G := ↥H)
      (h := isPGroup_of_isPiSubgroup_singleton hH)
  exact Group.normalizerCondition_of_isNilpotent (G := ↥H)

public lemma CFSG.isPiSubgroup_singleton_of_isPGroup {H : Subgroup G} {q : Nat.Primes}
    (hH : IsPGroup q.val H) :
    IsPiSubgroup (G := G) ({q} : Set Nat.Primes) H := by
  letI : Fact q.val.Prime := ⟨q.2⟩
  intro p hp
  obtain ⟨n, hncard⟩ := hH.exists_card_eq
  have hpdvdq : p.val ∣ q.val := p.2.dvd_of_dvd_pow (by simpa [hncard] using hp)
  have hpq : p = q := Subtype.ext ((Nat.prime_dvd_prime_iff_eq p.2 q.2).mp hpdvdq)
  simp [hpq]

omit [Finite G] in
public lemma CFSG.mem_section7HFamily_top_conjBy_of_mem_centralizer
    {A Q : Subgroup G} {π : Set Nat.Primes} {g : G}
    (hg : g ∈ Subgroup.centralizer (A : Set G))
    (hQ : Q ∈ section7HFamily (⊤ : Subgroup G) A π) :
    Q.conjBy g ∈ section7HFamily (⊤ : Subgroup G) A π := by
  rcases hQ with ⟨_, hQπ, hAnormQ⟩
  refine ⟨le_top, ?_, ?_⟩
  · simpa [Subgroup.conjBy] using hQπ.map (MulAut.conj g).toMonoidHom
  · refine subgroup_le_normalizer_of_conj_mem (Q.conjBy g) A ?_
    intro a x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    have hy' : (a : G) * y * (a : G)⁻¹ ∈ Q :=
      (Subgroup.mem_normalizer_iff.mp (hAnormQ a.property) y).1 hy
    have hcomm : (a : G) * g = g * (a : G) :=
      Subgroup.mem_centralizer_iff.mp hg _ a.property
    have hcomm_inv : (a : G)⁻¹ * g⁻¹ = g⁻¹ * (a : G)⁻¹ := by
      simpa using (congrArg Inv.inv hcomm).symm
    exact Subgroup.mem_map.mpr ⟨(a : G) * y * (a : G)⁻¹, hy', by
      calc
        g * ((a : G) * y * (a : G)⁻¹) * g⁻¹
            = ((g * (a : G)) * y) * ((a : G)⁻¹ * g⁻¹) := by
                simp [mul_assoc]
        _ = (((a : G) * g) * y) * ((a : G)⁻¹ * g⁻¹) := by
                rw [hcomm]
        _ = (a : G) * (g * y * g⁻¹) * (a : G)⁻¹ := by
                rw [hcomm_inv]
                simp [mul_assoc]⟩

omit [Finite G] in
public lemma CFSG.mem_section7HStarFamily_top_conjBy_of_mem_centralizer
    {A Q : Subgroup G} {π : Set Nat.Primes} {g : G}
    (hg : g ∈ Subgroup.centralizer (A : Set G))
    (hQ : Q ∈ section7HStarFamily (⊤ : Subgroup G) A π) :
    Q.conjBy g ∈ section7HStarFamily (⊤ : Subgroup G) A π := by
  refine ⟨mem_section7HFamily_top_conjBy_of_mem_centralizer hg hQ.1, ?_⟩
  intro R hQR hR
  have hg_inv : g⁻¹ ∈ Subgroup.centralizer (A : Set G) :=
    (Subgroup.centralizer (A : Set G)).inv_mem hg
  have hR_back :
      R.conjBy g⁻¹ ∈ section7HFamily (⊤ : Subgroup G) A π :=
    mem_section7HFamily_top_conjBy_of_mem_centralizer hg_inv hR
  have hQ_le_back : Q ≤ R.conjBy g⁻¹ := by
    intro x hx
    have hxR : g * x * g⁻¹ ∈ R := by
      exact hQR (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
    exact Subgroup.mem_map.mpr ⟨g * x * g⁻¹, hxR, by
      simp [mul_assoc]⟩
  have hEq_back : R.conjBy g⁻¹ = Q := hQ.2 _ hQ_le_back hR_back
  calc
    R = (R.conjBy g⁻¹).conjBy g := by
      rw [Subgroup.conjBy_conjBy]
      rw [mul_inv_cancel]
      exact (Subgroup.conjBy_one R).symm
    _ = Q.conjBy g := by simp [hEq_back]

omit [Finite G] in
public lemma CFSG.mem_section7HFamily_top_conjBy_of_mem_normalizer
    {A Q : Subgroup G} {π : Set Nat.Primes} {g : G}
    (hg : g ∈ Subgroup.normalizer (A : Set G))
    (hQ : Q ∈ section7HFamily (⊤ : Subgroup G) A π) :
    Q.conjBy g ∈ section7HFamily (⊤ : Subgroup G) A π := by
  rcases hQ with ⟨_, hQπ, hAnormQ⟩
  have hg_inv : g⁻¹ ∈ Subgroup.normalizer (A : Set G) :=
    (Subgroup.normalizer (A : Set G)).inv_mem hg
  refine ⟨le_top, ?_, ?_⟩
  · simpa [Subgroup.conjBy] using hQπ.map (MulAut.conj g).toMonoidHom
  · refine subgroup_le_normalizer_of_conj_mem (Q.conjBy g) A ?_
    intro a x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    have hgaA : g⁻¹ * a * g ∈ A := by
      simpa using (Subgroup.mem_normalizer_iff.mp hg_inv (a : G)).1 a.property
    have hy' : (g⁻¹ * a * g) * y * (g⁻¹ * a * g)⁻¹ ∈ Q :=
      (Subgroup.mem_normalizer_iff.mp (hAnormQ hgaA) y).1 hy
    exact Subgroup.mem_map.mpr ⟨_, hy', by
      simp [mul_assoc]⟩

omit [Finite G] in
public lemma CFSG.mem_section7HStarFamily_top_conjBy_of_mem_normalizer
    {A Q : Subgroup G} {π : Set Nat.Primes} {g : G}
    (hg : g ∈ Subgroup.normalizer (A : Set G))
    (hQ : Q ∈ section7HStarFamily (⊤ : Subgroup G) A π) :
    Q.conjBy g ∈ section7HStarFamily (⊤ : Subgroup G) A π := by
  refine ⟨mem_section7HFamily_top_conjBy_of_mem_normalizer hg hQ.1, ?_⟩
  intro R hQR hR
  have hg_inv : g⁻¹ ∈ Subgroup.normalizer (A : Set G) :=
    (Subgroup.normalizer (A : Set G)).inv_mem hg
  have hR_back :
      R.conjBy g⁻¹ ∈ section7HFamily (⊤ : Subgroup G) A π :=
    mem_section7HFamily_top_conjBy_of_mem_normalizer hg_inv hR
  have hQ_le_back : Q ≤ R.conjBy g⁻¹ := by
    intro x hx
    have hxR : g * x * g⁻¹ ∈ R := hQR (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
    exact Subgroup.mem_map.mpr ⟨g * x * g⁻¹, hxR, by simp [mul_assoc]⟩
  have hEq_back : R.conjBy g⁻¹ = Q := hQ.2 _ hQ_le_back hR_back
  calc
    R = (R.conjBy g⁻¹).conjBy g := by
      rw [Subgroup.conjBy_conjBy]
      rw [mul_inv_cancel]
      exact (Subgroup.conjBy_one R).symm
    _ = Q.conjBy g := by simp [hEq_back]

public lemma CFSG.exists_mem_section7HStarFamily_of_mem_family
    {H A R : Subgroup G} {π : Set Nat.Primes}
    (hR : R ∈ section7HFamily H A π) :
    ∃ Q ∈ section7HStarFamily H A π, R ≤ Q := by
  let s : Set (Subgroup G) := {Q | R ≤ Q ∧ Q ∈ section7HFamily H A π}
  have hsfin : s.Finite := Set.toFinite s
  have hsne : s.Nonempty := ⟨R, le_rfl, hR⟩
  obtain ⟨Q, hQ, hQmax⟩ := hsfin.exists_maximal hsne
  refine ⟨Q, ?_, hQ.1⟩
  refine ⟨hQ.2, ?_⟩
  intro S hQS hS
  exact le_antisymm (hQmax ⟨hQ.1.trans hQS, hS⟩ hQS) hQS

omit [Finite G] in
public lemma CFSG.section7HStarFamily.mem_family
    {H A Q : Subgroup G} {π : Set Nat.Primes}
    (hQ : Q ∈ section7HStarFamily H A π) :
    Q ∈ section7HFamily H A π :=
  hQ.1

omit [Finite G] in
public lemma CFSG.section7K_le_centralizer (A : Subgroup G) :
    section7K A ≤ Subgroup.centralizer (A : Set G) := by
  intro x hx
  rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
  exact y.property

omit [Finite G] in
public lemma CFSG.inf_mem_section7HFamily_compl_of_mem_star
    {A H Q : Subgroup G} {q : Nat.Primes}
    (hq : q ∉ subgroupPrimeSet A)
    (hQ : Q ∈ section7HStarFamily (⊤ : Subgroup G) A ({q} : Set Nat.Primes))
    (hAH : A ≤ H) :
    H ⊓ Q ∈ section7HFamily H A (subgroupPrimeSet A)ᶜ := by
  rcases section7HStarFamily.mem_family hQ with ⟨_, hQπ, hAnormQ⟩
  refine ⟨inf_le_left, ?_, ?_⟩
  · refine IsPiSubgroup.of_le inf_le_right ?_
    intro p hp
    have hpq : p = q := by
      simpa using hQπ p hp
    simpa [hpq] using hq
  · have hAnormH : A ≤ Subgroup.normalizer (H : Set G) :=
      hAH.trans Subgroup.le_normalizer
    have hAnormHQ : A ≤ Subgroup.normalizer (H : Set G) ⊓ Subgroup.normalizer (Q : Set G) := by
      intro a ha
      exact ⟨hAnormH ha, hAnormQ ha⟩
    exact hAnormHQ.trans Subgroup.inf_normalizer_le_normalizer_inf

omit [Finite G] in
public lemma CFSG.inf_le_piCoreIn_of_hypothesis
    {A H Q : Subgroup G} (hA : Hypothesis7_1 A)
    {q : Nat.Primes} (hq : q ∉ subgroupPrimeSet A)
    (hQ : Q ∈ section7HStarFamily (⊤ : Subgroup G) A ({q} : Set Nat.Primes))
    (hAH : A ≤ H) (hHproper : H ≠ ⊤) :
    H ⊓ Q ≤ piCoreIn (subgroupPrimeSet A)ᶜ H := by
  have hHQfam :
      H ⊓ Q ∈ section7HFamily H A (subgroupPrimeSet A)ᶜ :=
    inf_mem_section7HFamily_compl_of_mem_star hq hQ hAH
  have hHQgen :
      H ⊓ Q ≤ section7Generated H A (subgroupPrimeSet A)ᶜ :=
    le_sSup hHQfam
  have hgen_eq : section7Generated H A (subgroupPrimeSet A)ᶜ = piCoreIn (subgroupPrimeSet A)ᶜ H :=
    hA.2.2 H hAH hHproper
  simpa [hgen_eq] using hHQgen

public lemma CFSG.solvable_of_proper_subgroup [IsMinCE G] {H : Subgroup G} (hHproper : H ≠ ⊤) :
    IsSolvable H :=
  IsMinCE.proper_subgroups_solvable H (lt_top_iff_ne_top.mpr hHproper)

