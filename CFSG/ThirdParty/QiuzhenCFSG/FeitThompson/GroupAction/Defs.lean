module

public import Mathlib.Algebra.Group.Defs
public import Mathlib.Algebra.Group.Subgroup.Defs
public import Mathlib.Data.Bracket
public import Mathlib.GroupTheory.Commutator.Basic

public import Mathlib.GroupTheory.GroupAction.FixingSubgroup
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.Tactic.Basic

import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.Commutator.Core

namespace CFSG
end CFSG
open CFSG

open scoped FixedPoints

section GroupActionDefs

variable {G A : Type*} [Group G] [Group A]

/-- `C_G(A)`: the subgroup of elements of `G` fixed by the `A`-action. -/
public abbrev CFSG.fixedPointSubgroup (A : Type*) (G : Type*) [Group A] [Group G] [MulDistribMulAction A G] :
    Subgroup G :=
  FixedPoints.subgroup A G

/-- `C_A(S)`: the subgroup of `A` fixing every element of `S` pointwise. -/
public abbrev CFSG.fixingSubgroupOf (A : Type*) (G : Type*) [Group A] [MulAction A G]
    (S : Set G) :
    Subgroup A :=
  fixingSubgroup (M := A) (α := G) S

/-- A subgroup `H ≤ G` is `A`-invariant if it is fixed under the pointwise action. -/
public class CFSG.IsInvariant (A : Type*) (G : Type*) [Group G] [SMul A G] (H : Subgroup G) : Prop where
  invariant : ∀ a : A, ∀ g : G, g ∈ H ↔ a • g ∈ H

/-- Restrict an `A`-action on `G` to an `A`-invariant subgroup `H`. -/
public instance CFSG.instMulDistribMulAction_subtype
    {G A : Type*} [Group G] [Group A] [MulDistribMulAction A G]
    {H : Subgroup G} [IsInvariant A G H] :
    MulDistribMulAction A H where
  smul a x := ⟨a • x.1, (IsInvariant.invariant (A := A) (G := G) (H := H) a x.1).1 x.2⟩
  one_smul x := by
    ext
    change ((1 : A) • (x : G)) = x
    simp
  mul_smul a b x := by
    ext
    change ((a * b) • (x : G)) = a • (b • (x : G))
    simpa using (mul_smul a b (x : G))
  smul_mul a x y := by
    ext
    change a • ((x : G) * (y : G)) = a • (x : G) * a • (y : G)
    simp
  smul_one a := by
    ext
    change a • (1 : G) = (1 : G)
    simp

/-- The action of `A` on `G` is trivial. -/
@[expose] public def CFSG.ActsTrivially (A : Type*) (G : Type*) [SMul A G] : Prop :=
  ∀ a : A, ∀ g : G, a • g = g

/-- `A` acts trivially on a subgroup `H ≤ G` (as a set), i.e. fixes all its elements. -/
@[expose] public def CFSG.ActsTriviallyOnSubgroup (A : Type*) (G : Type*) [Group G] [SMul A G]
    (H : Subgroup G) : Prop :=
  ∀ a : A, ∀ g : G, g ∈ H → a • g = g

/-- The "commutator subgroup" of a subgroup `H ≤ G` with the `A`-action: generated by elements
`h⁻¹ * (a • h)` with `h ∈ H`. -/
@[expose]
public def CFSG.commutatorSubgroup (A : Type*) (G : Type*) [Group A] [Group G]
    [MulDistribMulAction A G]
    (H : Subgroup G := ⊤) : Subgroup G :=
  Subgroup.closure {x : G | ∃ a : A, ∃ h : G, h ∈ H ∧ x = h⁻¹ * (a • h)}

/-- The commutator subgroup `⁅G, A⁆` of the whole group `G` with the `A`-action. -/
public abbrev CFSG.commutatorAction (A : Type*) (G : Type*) [Group A] [Group G]
    [MulDistribMulAction A G] :
    Subgroup G :=
  commutatorSubgroup (A := A) (G := G) (H := ⊤)

/-- The iterated commutator subgroup `⁅⁅G, A⁆, A⁆` for the `A`-action on `G`. -/
public abbrev CFSG.commutatorAction₂ (A : Type*) (G : Type*) [Group A] [Group G]
    [MulDistribMulAction A G] :
    Subgroup G :=
  commutatorSubgroup (A := A) (G := G) (H := commutatorAction (A := A) (G := G))

end GroupActionDefs

/-- `A` stabilizes a normal series if:
- the series has explicit top and bottom endpoints,
- each step moves downward (`Gi (next i) ≤ Gi i`),
- every term is normal in `G`,
- repeatedly applying `next` from the top eventually reaches the bottom,
- every term is `A`-invariant,
- and the action on each factor is trivial (`(a • g) * g⁻¹ ∈ Gi (next i)` for `g ∈ Gi i`).
-/
@[expose]
public def CFSG.StabilizesNormalSeries {G A : Type*} [Group G] [Group A] [MulDistribMulAction A G]
    {ι : Type*} (Gi : ι → Subgroup G) (next : ι → ι) : Prop :=
  (∃ top bottom : ι,
      Gi top = ⊤ ∧
      Gi bottom = ⊥ ∧
      (∃ n : ℕ, Nat.iterate next n top = bottom)) ∧
    (∀ i, Gi (next i) ≤ Gi i) ∧
    (∀ i, (Gi i).Normal) ∧
    (∀ i, IsInvariant A G (Gi i)) ∧
      ∀ i (a : A) (g : G), g ∈ Gi i → (a • g) * g⁻¹ ∈ Gi (next i)
