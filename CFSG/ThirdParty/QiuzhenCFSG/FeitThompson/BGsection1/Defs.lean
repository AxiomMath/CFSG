/- # Elementary Properties of Solvable Groups -/

/-- A `π`-group (all prime divisors of its order lie in `π`). -/
public def CFSG.IsPiGroup (π : Set Nat.Primes) (G : Type*) [Group G] : Prop :=
  IsPiSubgroup π (⊤ : Subgroup G)

public lemma CFSG.IsPiGroup_iff (π : Set Nat.Primes) (G : Type*) [Group G] [Finite G] :
    IsPiGroup π G ↔ ∀ p : Nat.Primes, p.val ∣ Nat.card G → p ∈ π := by
  let _ := (inferInstance : Finite G)
  unfold IsPiGroup IsPiSubgroup
  simp

/-- The `π`-core `𝒪_π(G)`: the supremum of all normal `π`-subgroups of `G`. -/
@[expose]
public def CFSG.piCore (π : Set Nat.Primes) (G : Type*) [Group G] : Subgroup G :=
  sSup {K : Subgroup G | K.Normal ∧ IsPiSubgroup (G := G) π K}


section BackgroundDefs

variable {G : Type*} [Group G]

/-- An element whose order is a power of `p`. -/
@[expose]
public def CFSG.IsPElement (p : ℕ) {G : Type*} [Group G] (g : G) : Prop :=
  ∃ n : ℕ, orderOf g = p ^ n

/-- The subgroup generated by all `p`-elements of `G`. -/
@[expose]
public def CFSG.pElementsSubgroup (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {g : G | IsPElement (p := p) g}



/-- The (first) derived subgroup of `G`. -/
public abbrev CFSG.derivedSubgroup (G : Type*) [Group G] : Subgroup G :=
  derivedSeries G 1

/-! ### Placeholder definitions used in this file -/

instance {p : ℕ} {G : Type*} [Group G] : (pPrimeCore p G).Normal := by
  classical
  simpa [pPrimeCore] using
    (Subgroup.normal_sSup (G := G)
      (S := {K : Subgroup G | K.Normal ∧ Nat.Coprime p (Nat.card K)})
      (by
        intro K hK
        exact hK.1))

/-- `𝒪_{p',p}(G)`: the preimage of the `p`-core of `G/𝒪_{p'}(G)`. -/
@[expose]
public def CFSG.Op_p'p (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  (pCore p (G ⧸ pPrimeCore p G)).comap (QuotientGroup.mk' (pPrimeCore p G))

public instance CFSG.Op_p'p_normal (p : ℕ) (G : Type*) [Group G] : (Op_p'p p G).Normal := by
  classical
  dsimp [Op_p'p]
  infer_instance

/-- `𝒪_{p',p,p'}(G)`: the preimage of the `p'`-core of `G/𝒪_{p',p}(G)`. -/
@[expose]
public def CFSG.Op_p'pp' (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  (pPrimeCore p (G ⧸ Op_p'p p G)).comap (QuotientGroup.mk' (Op_p'p p G))

public instance CFSG.Op_p'pp'_normal (p : ℕ) (G : Type*) [Group G] : (Op_p'pp' p G).Normal := by
  classical
  dsimp [Op_p'pp']
  infer_instance

/-- `G` has a normal `p`-complement: a normal subgroup of `p'`-order with `p`-group quotient. -/
@[expose]
public def CFSG.HasNormalPComplement (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ (N : Subgroup G) (_ : N.Normal), Nat.Coprime p (Nat.card N) ∧ IsPGroup p (G ⧸ N)

/-- Nilpotency class at most `n`, phrased via the upper central series. -/
@[expose]
public def CFSG.NilpotencyClassLe (n : ℕ) (X : Type*) [Group X] : Prop :=
  Subgroup.upperCentralSeries X n = ⊤

end BackgroundDefs

/-
**Kind**: Definition
**Stmt**:
We say that a group $G$ has $p$-length one if $G = \mathcal{O}_{p',p,p'}(G)$.
-/

/-- A group has `p`-length one if `Op_p'pp' p G = ⊤`. -/
@[expose]
public def CFSG.HasPLengthOne (p : ℕ) (G : Type*) [Group G] : Prop :=
  Op_p'pp' p G = ⊤
