/-
**Kind**: Theorem
**Note**: Lemma 1.21
**Stmt**:
Let $G$ be a finite group.
(a) If $G$ has $p$-length one and $H$ is a subgroup of $G$, then $H$ has $p$-length one.
(b) If $H$ is a normal $p'$-subgroup of $G$ and $G/H$ has $p$-length one, then $G$ has $p$-length one.
(c) If $H$ is a normal $p$-subgroup of $G$ such that $\mathcal{O}_{p'}(G/H) = 1$ and if $G/H$ has $p$-length one, then $G$ has $p$-length one.
(d) $G$ has $p$-length one if and only if the subgroup of $G$ generated by all $p$-elements of $G$ has a normal $p$-complement.
(e) If $H$ and $N$ are normal subgroups of $G$ such that $H \cap N = 1$ and $G/H$ and $G/N$ both have $p$-length one, then $G$ has $p$-length one.
-/


/-- Core equivalence for Lemma 1.21(d). -/
public theorem CFSG.hasPLengthOne_iff_hasNormalPComplement_pElements
    {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    HasPLengthOne (p := p) G ↔ HasNormalPComplement p (↥(pElementsSubgroup p G)) := by
  constructor
  · intro hplen
    have hPle : pElementsSubgroup p G ≤ Op_p'p p G :=
      pElementsSubgroup_le_Op_p'p_of_hasPLengthOne (G := G) (p := p) hplen
    have hOpComp : HasNormalPComplement p (↥(Op_p'p p G)) :=
      hasNormalPComplement_Op_p'p (G := G) (p := p)
    exact hasNormalPComplement_of_le (G := G) (p := p) hPle hOpComp
  · intro hcomp
    have hPle : pElementsSubgroup p G ≤ Op_p'p p G :=
      pElementsSubgroup_le_Op_p'p_of_hasNormalPComplement (G := G) (p := p) hcomp
    classical
    let S : Sylow p G := Classical.choice (inferInstance : Nonempty (Sylow p G))
    have hS_le_pElems : (S : Subgroup G) ≤ pElementsSubgroup p G := by
      intro x hxS
      refine Subgroup.subset_closure ?_
      rcases
          (IsPGroup.iff_orderOf (p := p) (G := ↥(S : Subgroup G))).1 S.isPGroup' ⟨x, hxS⟩ with
        ⟨n, hn⟩
      exact ⟨n, by simpa [Subgroup.orderOf_coe] using hn⟩
    have hS_le_Op : (S : Subgroup G) ≤ Op_p'p p G := hS_le_pElems.trans hPle
    have hnot_dvd_index_Op : ¬ p ∣ (Op_p'p p G).index := by
      intro hpdiv
      exact S.not_dvd_index (hpdiv.trans (Subgroup.index_dvd_of_le hS_le_Op))
    have hnot_dvd_cardQ : ¬ p ∣ Nat.card (G ⧸ Op_p'p p G) := by
      simpa [Subgroup.index_eq_card] using hnot_dvd_index_Op
    have hcopQ : Nat.Coprime p (Nat.card (G ⧸ Op_p'p p G)) :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime p)).2 hnot_dvd_cardQ
    have htop_le_core :
        (⊤ : Subgroup (G ⧸ Op_p'p p G)) ≤ pPrimeCore p (G ⧸ Op_p'p p G) := by
      exact le_sSup ⟨(inferInstance : (⊤ : Subgroup (G ⧸ Op_p'p p G)).Normal), by simpa using hcopQ⟩
    have hcore_top : pPrimeCore p (G ⧸ Op_p'p p G) = ⊤ := top_unique htop_le_core
    simp [HasPLengthOne, Op_p'pp', hcore_top]

-- Lemma 1.21(a)
public theorem CFSG.lemma_1_21_a {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    ∀ H : Subgroup G, HasPLengthOne (p := p) G → HasPLengthOne (p := p) (↥H) := by
  intro H hplenG
  have hcompG : HasNormalPComplement p (↥(pElementsSubgroup p G)) :=
    (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G) (p := p)).1 hplenG
  let K : Subgroup H := pElementsSubgroup p H
  let Kmap : Subgroup G := K.map H.subtype
  have hKmap_le : Kmap ≤ pElementsSubgroup p G := by
    simpa [Kmap, K] using pElementsSubgroup_map_subtype_le (G := G) (p := p) H
  have hcompKmap : HasNormalPComplement p (↥Kmap) :=
    hasNormalPComplement_of_le (G := G) (p := p) hKmap_le hcompG
  have hcompK : HasNormalPComplement p (↥K) :=
    hasNormalPComplement_of_map_subtype (G := G) (p := p) (H := H) (K := K)
      (by simpa [Kmap] using hcompKmap)
  exact (hasPLengthOne_iff_hasNormalPComplement_pElements (G := ↥H) (p := p)).2 hcompK

-- Lemma 1.21(b)
public theorem CFSG.lemma_1_21_b {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    ∀ (H : Subgroup G) [H.Normal],
      Nat.Coprime p (Nat.card H) →
        HasPLengthOne (p := p) (G ⧸ H) → HasPLengthOne (p := p) G := by
  intro H _ hcop hplenQuot
  let q : G →* G ⧸ H := QuotientGroup.mk' H
  let P : Subgroup G := pElementsSubgroup p G
  let Pbar : Subgroup (G ⧸ H) := P.map q
  have hcompQuotAll : HasNormalPComplement p (↥(pElementsSubgroup p (G ⧸ H))) :=
    (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G ⧸ H) (p := p)).1 hplenQuot
  have hPbar_le : Pbar ≤ pElementsSubgroup p (G ⧸ H) := by
    unfold Pbar P pElementsSubgroup
    calc
      (Subgroup.closure {x : G | IsPElement (p := p) x}).map q
          = Subgroup.closure (q '' {x : G | IsPElement (p := p) x}) := by
            simpa using (MonoidHom.map_closure (f := q) {x : G | IsPElement (p := p) x})
      _ ≤ Subgroup.closure {x : G ⧸ H | IsPElement (p := p) x} := by
            refine Subgroup.closure_mono ?_
            intro x hx
            rcases hx with ⟨y, hy, rfl⟩
            rcases hy with ⟨n, hn⟩
            have hdiv : orderOf (q y) ∣ p ^ n :=
              (orderOf_map_dvd (ψ := q) y).trans (by simp [hn])
            rcases (Nat.dvd_prime_pow (Fact.out : Nat.Prime p)).1 hdiv with ⟨m, _hmle, hm⟩
            exact ⟨m, hm⟩
  have hcompPbar : HasNormalPComplement p (↥Pbar) :=
    hasNormalPComplement_of_le (G := G ⧸ H) (p := p) hPbar_le hcompQuotAll
  let qP : P →* Pbar :=
    (q.comp P.subtype).codRestrict Pbar (by
      intro x
      exact Subgroup.mem_map.mpr ⟨x, x.property, rfl⟩)
  have hqP_surj : Function.Surjective qP := by
    intro y
    rcases y.property with ⟨x, hx, hxy⟩
    refine ⟨⟨x, hx⟩, ?_⟩
    apply Subtype.ext
    simpa [qP] using hxy
  have hker_map_le_H : (qP.ker.map P.subtype) ≤ H := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    have hy1 : q ((y : P) : G) = 1 := congrArg Subtype.val hy
    exact (QuotientGroup.eq_one_iff (N := H) (x := ((y : P) : G))).1 hy1
  have hker_dvd_H : Nat.card qP.ker ∣ Nat.card H := by
    have hcard_map : Nat.card (qP.ker.map P.subtype) = Nat.card qP.ker := by
      simpa using (Subgroup.card_map_of_injective (K := qP.ker) (f := P.subtype) P.subtype_injective)
    rw [← hcard_map]
    exact Subgroup.card_dvd_of_le hker_map_le_H
  have hkerCop : Nat.Coprime p (Nat.card qP.ker) := Nat.Coprime.of_dvd_right hker_dvd_H hcop
  have hcompP : HasNormalPComplement p (↥P) :=
    hasNormalPComplement_of_surjective (G := P) (G' := Pbar) (p := p) qP hqP_surj hkerCop hcompPbar
  exact (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G) (p := p)).2 hcompP

-- Lemma 1.21(c)
public theorem CFSG.lemma_1_21_c {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    ∀ (H : Subgroup G) [H.Normal],
      IsPGroup p (↥H) →
        pPrimeCore p (G ⧸ H) = ⊥ →
          HasPLengthOne (p := p) (G ⧸ H) → HasPLengthOne (p := p) G := by
  intro H _ hHp hbot hplenQuot
  let q : G →* (G ⧸ H) := QuotientGroup.mk' H
  have hcore_le_H : pPrimeCore p G ≤ H :=
    pPrimeCore_le_of_quotient_eq_bot (G := G) (p := p) (N := H) hbot
  have hcore_p : IsPGroup p (↥(pPrimeCore p G)) := by
    have hsub_p : IsPGroup p (↥((pPrimeCore p G).subgroupOf H)) :=
      IsPGroup.to_subgroup (H := (pPrimeCore p G).subgroupOf H) hHp
    exact hsub_p.of_equiv
      (Subgroup.subgroupOfEquivOfLe (H := pPrimeCore p G) (K := H) hcore_le_H)
  have hcore_card_one : Nat.card (pPrimeCore p G) = 1 := by
    refine (hcore_p.card_eq_or_dvd).resolve_right ?_
    exact (Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime p)).1
      (pPrimeCore_coprime_card (p := p) (G := G))
  have hcore_bot : pPrimeCore p G = ⊥ :=
    (Subgroup.card_eq_one (H := pPrimeCore p G)).1 hcore_card_one
  have hOpQ_eq : Op_p'p p (G ⧸ H) = pCore p (G ⧸ H) :=
    Op_p'p_eq_pCore_of_pPrimeCore_eq_bot (G := G ⧸ H) (p := p) hbot
  have hplenQuot' : Op_p'pp' p (G ⧸ H) = ⊤ := by
    simpa [HasPLengthOne] using hplenQuot
  have hcoreTopOp :
      pPrimeCore p ((G ⧸ H) ⧸ Op_p'p p (G ⧸ H)) = ⊤ := by
    have htmp :
        (pPrimeCore p ((G ⧸ H) ⧸ Op_p'p p (G ⧸ H))).comap
          (QuotientGroup.mk' (Op_p'p p (G ⧸ H))) = ⊤ := by
      simpa [Op_p'pp'] using hplenQuot'
    apply (Subgroup.comap_injective
      (QuotientGroup.mk'_surjective (Op_p'p p (G ⧸ H))))
    simpa using htmp
  let eOp : (G ⧸ H) ⧸ Op_p'p p (G ⧸ H) ≃* (G ⧸ H) ⧸ pCore p (G ⧸ H) :=
    QuotientGroup.quotientMulEquivOfEq hOpQ_eq
  have hcoreTopQuot :
      pPrimeCore p ((G ⧸ H) ⧸ pCore p (G ⧸ H)) = ⊤ := by
    have hmap_op :
        (pPrimeCore p ((G ⧸ H) ⧸ Op_p'p p (G ⧸ H))).map eOp.toMonoidHom =
          pPrimeCore p ((G ⧸ H) ⧸ pCore p (G ⧸ H)) := by
      simpa [eOp] using
        (pPrimeCore_map_iso (G := ((G ⧸ H) ⧸ Op_p'p p (G ⧸ H)))
          (G' := ((G ⧸ H) ⧸ pCore p (G ⧸ H))) (p := p) eOp)
    simpa [hcoreTopOp] using hmap_op.symm
  have hH_le_pCore : H ≤ pCore p G := by
    exact le_sSup ⟨(inferInstance : H.Normal), hHp⟩
  have hmap_pCore :
      (pCore p G).map q = pCore p (G ⧸ H) :=
    pCore_map_mk'_eq_of_normal_isPGroup (G := G) (p := p) H hHp
  let e1 : (G ⧸ H) ⧸ (pCore p G).map q ≃* G ⧸ pCore p G :=
    QuotientGroup.quotientQuotientEquivQuotient (N := H) (M := pCore p G) hH_le_pCore
  let e2 : (G ⧸ H) ⧸ pCore p (G ⧸ H) ≃* (G ⧸ H) ⧸ (pCore p G).map q :=
    QuotientGroup.quotientMulEquivOfEq hmap_pCore.symm
  let e : (G ⧸ H) ⧸ pCore p (G ⧸ H) ≃* G ⧸ pCore p G := e2.trans e1
  have hcoreTopG :
      pPrimeCore p (G ⧸ pCore p G) = ⊤ := by
    have hmap_core :
        (pPrimeCore p ((G ⧸ H) ⧸ pCore p (G ⧸ H))).map e.toMonoidHom =
          pPrimeCore p (G ⧸ pCore p G) := by
      simpa [e] using
        (pPrimeCore_map_iso (G := ((G ⧸ H) ⧸ pCore p (G ⧸ H)))
          (G' := (G ⧸ pCore p G)) (p := p) e)
    simpa [hcoreTopQuot] using hmap_core.symm
  have hOpG_eq : Op_p'p p G = pCore p G :=
    Op_p'p_eq_pCore_of_pPrimeCore_eq_bot (G := G) (p := p) hcore_bot
  let eG : G ⧸ Op_p'p p G ≃* G ⧸ pCore p G :=
    QuotientGroup.quotientMulEquivOfEq hOpG_eq
  have hcoreTopOpG : pPrimeCore p (G ⧸ Op_p'p p G) = ⊤ := by
    have hmap_g :
        (pPrimeCore p (G ⧸ pCore p G)).map eG.symm.toMonoidHom =
          pPrimeCore p (G ⧸ Op_p'p p G) := by
      simpa [eG] using
        (pPrimeCore_map_iso (G := (G ⧸ pCore p G))
          (G' := (G ⧸ Op_p'p p G)) (p := p) eG.symm)
    simpa [hcoreTopG] using hmap_g.symm
  simp [HasPLengthOne, Op_p'pp', hcoreTopOpG]

-- Lemma 1.21(d)

/-- Direct products preserve `p`-length one. -/
public theorem CFSG.hasPLengthOne_prod {G G' : Type*} [Group G] [Finite G] [Group G'] [Finite G']
    (p : ℕ) [Fact p.Prime] :
    HasPLengthOne (p := p) G → HasPLengthOne (p := p) G' → HasPLengthOne (p := p) (G × G') := by
  intro hplenG hplenG'
  have hcompG : HasNormalPComplement p (↥(pElementsSubgroup p G)) :=
    (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G) (p := p)).1 hplenG
  have hcompG' : HasNormalPComplement p (↥(pElementsSubgroup p G')) :=
    (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G') (p := p)).1 hplenG'
  have hcompProdType :
      HasNormalPComplement p ((↥(pElementsSubgroup p G)) × (↥(pElementsSubgroup p G'))) :=
    hasNormalPComplement_prod (G := ↥(pElementsSubgroup p G))
      (G' := ↥(pElementsSubgroup p G')) (p := p) hcompG hcompG'
  let eProd :
      ((↥(pElementsSubgroup p G)) × (↥(pElementsSubgroup p G'))) ≃*
        ↥((pElementsSubgroup p G).prod (pElementsSubgroup p G')) :=
    (Subgroup.prodEquiv (pElementsSubgroup p G) (pElementsSubgroup p G')).symm
  have hcompProd :
      HasNormalPComplement p (↥((pElementsSubgroup p G).prod (pElementsSubgroup p G'))) :=
    hasNormalPComplement_of_equiv (G := (↥(pElementsSubgroup p G)) × (↥(pElementsSubgroup p G')))
      (p := p) eProd hcompProdType
  have hle :
      pElementsSubgroup p (G × G') ≤ (pElementsSubgroup p G).prod (pElementsSubgroup p G') :=
    pElementsSubgroup_le_prod (G := G) (G' := G') (p := p)
  have hcompProdElems : HasNormalPComplement p (↥(pElementsSubgroup p (G × G'))) :=
    hasNormalPComplement_of_le (G := G × G') (p := p) hle hcompProd
  exact (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G × G') (p := p)).2 hcompProdElems

-- Lemma 1.21(e)
public theorem CFSG.lemma_1_21_e {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    ∀ (H N : Subgroup G) [H.Normal] [N.Normal],
      H ⊓ N = ⊥ →
        HasPLengthOne (p := p) (G ⧸ H) →
          HasPLengthOne (p := p) (G ⧸ N) → HasPLengthOne (p := p) G := by
  intro H N _ _ hHNbot hplenH hplenN
  let f : G →* (G ⧸ H) × (G ⧸ N) := (QuotientGroup.mk' H).prod (QuotientGroup.mk' N)
  let P : Subgroup G := pElementsSubgroup p G
  let L : Subgroup ((G ⧸ H) × (G ⧸ N)) := pElementsSubgroup p ((G ⧸ H) × (G ⧸ N))
  let R : Subgroup ((G ⧸ H) × (G ⧸ N)) := P.map f
  have hplenProd : HasPLengthOne (p := p) ((G ⧸ H) × (G ⧸ N)) :=
    hasPLengthOne_prod (G := G ⧸ H) (G' := G ⧸ N) (p := p) hplenH hplenN
  have hcompL : HasNormalPComplement p (↥L) :=
    (hasPLengthOne_iff_hasNormalPComplement_pElements (G := (G ⧸ H) × (G ⧸ N)) (p := p)).1
      hplenProd
  have hR_le_L : R ≤ L := by
    simpa [R, P, L] using
      (pElementsSubgroup_map_le (G := G) (G' := (G ⧸ H) × (G ⧸ N)) (p := p) f)
  have hcompR : HasNormalPComplement p (↥R) :=
    hasNormalPComplement_of_le (G := (G ⧸ H) × (G ⧸ N)) (p := p) hR_le_L hcompL
  let ψ : P →* R :=
    (f.comp P.subtype).codRestrict R (by
      intro x
      exact Subgroup.mem_map.mpr ⟨x, x.property, rfl⟩)
  have hψ_surj : Function.Surjective ψ := by
    intro y
    rcases y.property with ⟨x, hx, hxy⟩
    refine ⟨⟨x, hx⟩, ?_⟩
    apply Subtype.ext
    simpa [ψ] using hxy
  have hf_ker : f.ker = H ⊓ N := by
    calc
      f.ker = (QuotientGroup.mk' H).ker ⊓ (QuotientGroup.mk' N).ker := by
                simpa [f] using
                  (MonoidHom.ker_prod (QuotientGroup.mk' H) (QuotientGroup.mk' N))
      _ = H ⊓ N := by simp [QuotientGroup.ker_mk']
  have hf_inj : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff f).1
    simpa [hf_ker] using hHNbot
  have hψ_inj : Function.Injective ψ := by
    intro x y hxy
    apply Subtype.ext
    exact hf_inj (by simpa [ψ] using congrArg Subtype.val hxy)
  have hψ_ker_bot : ψ.ker = ⊥ := (MonoidHom.ker_eq_bot_iff ψ).2 hψ_inj
  have hkerCop : Nat.Coprime p (Nat.card ψ.ker) := by
    have hcard : Nat.card ψ.ker = 1 := (Subgroup.card_eq_one (H := ψ.ker)).2 hψ_ker_bot
    rw [hcard]
    exact Nat.coprime_one_right p
  have hcompP : HasNormalPComplement p (↥P) :=
    hasNormalPComplement_of_surjective (G := P) (G' := R) (p := p) ψ hψ_surj hkerCop hcompR
  exact (hasPLengthOne_iff_hasNormalPComplement_pElements (G := G) (p := p)).2 hcompP


end
