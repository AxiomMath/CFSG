module

public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.BGsection1.Defs
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.PCore.PPrimeCore

namespace CFSG
end CFSG
open CFSG

open scoped Pointwise

section PLengthLemmas

variable {G : Type*} [Group G]

/-- `p`-elements are preserved by automorphisms. -/
public theorem CFSG.isPElement_aut_iff (p : ℕ) (φ : MulAut G) (x : G) :
    IsPElement (p := p) (φ x) ↔ IsPElement (p := p) x := by
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    simpa using hn
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    simpa using hn

/-- The subgroup generated by `p`-elements is characteristic. -/
public theorem CFSG.pElementsSubgroup_characteristic (p : ℕ) (G : Type*) [Group G] :
    (pElementsSubgroup p G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro φ
  let S : Set G := {x : G | IsPElement (p := p) x}
  have hS : (fun x : G => φ x) '' S = S := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact (isPElement_aut_iff (p := p) φ y).2 hy
    · intro hx
      refine ⟨φ⁻¹ x, ?_, by simp⟩
      change IsPElement (p := p) (φ⁻¹ x)
      apply (isPElement_aut_iff (p := p) φ (φ⁻¹ x)).1
      change IsPElement (p := p) x at hx
      simpa using hx
  calc
    (pElementsSubgroup p G).map φ.toMonoidHom
        = (Subgroup.closure S).map φ.toMonoidHom := by rfl
    _ = Subgroup.closure ((fun x : G => φ x) '' S) := by
          simpa using (MonoidHom.map_closure (f := φ.toMonoidHom) S)
    _ = Subgroup.closure S := by simp [hS]
    _ = pElementsSubgroup p G := by rfl


/-- The subgroup generated by `p`-elements in a subgroup maps into the subgroup generated by
`p`-elements of the ambient group. -/
public theorem CFSG.pElementsSubgroup_map_subtype_le (p : ℕ) (H : Subgroup G) :
    (pElementsSubgroup p (↥H)).map H.subtype ≤ pElementsSubgroup p G := by
  unfold pElementsSubgroup
  calc
    (Subgroup.closure {x : H | IsPElement (p := p) x}).map H.subtype
        = Subgroup.closure (H.subtype '' {x : H | IsPElement (p := p) x}) := by
          simpa using (MonoidHom.map_closure (f := H.subtype) {x : H | IsPElement (p := p) x})
    _ ≤ Subgroup.closure {x : G | IsPElement (p := p) x} := by
      refine Subgroup.closure_mono ?_
      intro x hx
      rcases hx with ⟨y, hy, rfl⟩
      rcases hy with ⟨n, hn⟩
      refine ⟨n, ?_⟩
      simpa [Subgroup.orderOf_coe] using hn

/-- The image of the subgroup generated by `p`-elements lies in the subgroup generated by
`p`-elements of the codomain. -/
public theorem CFSG.pElementsSubgroup_map_le (p : ℕ) [Fact p.Prime] {G' : Type*} [Group G']
    (f : G →* G') :
    (pElementsSubgroup p G).map f ≤ pElementsSubgroup p G' := by
  unfold pElementsSubgroup
  calc
    (Subgroup.closure {x : G | IsPElement (p := p) x}).map f
        = Subgroup.closure (f '' {x : G | IsPElement (p := p) x}) := by
          simpa using (MonoidHom.map_closure (f := f) {x : G | IsPElement (p := p) x})
    _ ≤ Subgroup.closure {x : G' | IsPElement (p := p) x} := by
      refine Subgroup.closure_mono ?_
      intro x hx
      rcases hx with ⟨y, hy, rfl⟩
      rcases hy with ⟨n, hn⟩
      have hdiv : orderOf (f y) ∣ p ^ n :=
        (orderOf_map_dvd (ψ := f) y).trans (by simp [hn])
      rcases (Nat.dvd_prime_pow (Fact.out : Nat.Prime p)).1 hdiv with ⟨m, _hmle, hm⟩
      exact ⟨m, hm⟩

/-- A normal `p`-complement descends to subgroups. -/
public theorem CFSG.hasNormalPComplement_of_le (p : ℕ) {K L : Subgroup G} (hKL : K ≤ L) :
    HasNormalPComplement p (↥L) → HasNormalPComplement p (↥K) := by
  intro hL
  rcases hL with ⟨N, hNnorm, hNcop, hQp⟩
  let φ : K →* L :=
    { toFun := fun x => ⟨x.1, hKL x.2⟩
      map_one' := rfl
      map_mul' := by intro a b; rfl }
  have hφinj : Function.Injective φ := by
    intro x y hxy
    apply Subtype.ext
    exact congrArg (fun t : L => (t : G)) hxy
  let ψ0 : K →* (L ⧸ N) := (QuotientGroup.mk' N).comp φ
  let N' : Subgroup K := ψ0.ker
  have hN'_eq_comap : N' = N.comap φ := by
    ext x
    change ψ0 x = 1 ↔ φ x ∈ N
    simp [ψ0]
  have hN'cop : Nat.Coprime p (Nat.card N') := by
    have hdvd : Nat.card N' ∣ Nat.card N := by
      rw [hN'_eq_comap]
      exact Subgroup.card_comap_dvd_of_injective N φ hφinj
    exact Nat.Coprime.of_dvd_right hdvd hNcop
  let ψ : K ⧸ N' →* (L ⧸ N) := QuotientGroup.kerLift ψ0
  have hψinj : Function.Injective ψ := QuotientGroup.kerLift_injective ψ0
  have hQK : IsPGroup p (K ⧸ N') :=
    IsPGroup.of_injective (hG := hQp) (ϕ := ψ) hψinj
  exact ⟨N', inferInstance, hN'cop, hQK⟩

/-- Pull a normal `p`-complement back across `Subgroup.map` along a subgroup inclusion. -/
public theorem CFSG.hasNormalPComplement_of_map_subtype (p : ℕ) (H : Subgroup G) (K : Subgroup H) :
    HasNormalPComplement p (↥(K.map H.subtype)) → HasNormalPComplement p (↥K) := by
  intro hmap
  rcases hmap with ⟨Nbar, hNbarNorm, hNbarCop, hQbarP⟩
  let e : K ≃* K.map H.subtype := Subgroup.equivMapOfInjective (f := H.subtype) K H.subtype_injective
  let N : Subgroup K := Nbar.map e.symm.toMonoidHom
  have hNnorm : N.Normal := by
    simpa [N] using Subgroup.Normal.map hNbarNorm e.symm.toMonoidHom e.symm.surjective
  have hNcop : Nat.Coprime p (Nat.card N) := by
    have hcardN : Nat.card N = Nat.card Nbar := by
      simpa [N] using
        (Subgroup.card_map_of_injective (K := Nbar) (f := e.symm.toMonoidHom) e.symm.injective)
    simpa [hcardN] using hNbarCop
  have hmap_id : Nbar.map e.symm.toMonoidHom = N := by rfl
  let eQ : (K.map H.subtype) ⧸ Nbar ≃* K ⧸ N :=
    QuotientGroup.congr (G' := Nbar) (H' := N) (e := e.symm) hmap_id
  have hQp : IsPGroup p (K ⧸ N) := hQbarP.of_equiv eQ
  exact ⟨N, hNnorm, hNcop, hQp⟩

/-- Transport a normal `p`-complement across a group isomorphism. -/
public theorem CFSG.hasNormalPComplement_of_equiv (p : ℕ) {G' : Type*} [Group G']
    (e : G ≃* G') : HasNormalPComplement p G → HasNormalPComplement p G' := by
  intro hG
  rcases hG with ⟨N, hNnorm, hNcop, hQp⟩
  let N' : Subgroup G' := N.map e.toMonoidHom
  have hN'norm : N'.Normal := Subgroup.Normal.map hNnorm e.toMonoidHom e.surjective
  have hN'cop : Nat.Coprime p (Nat.card N') := by
    have hcardN' : Nat.card N' = Nat.card N := by
      simpa [N'] using (Subgroup.card_map_of_injective (K := N) (f := e.toMonoidHom) e.injective)
    simpa [hcardN'] using hNcop
  have hmap_id : N.map e.toMonoidHom = N' := by rfl
  let eQ : G ⧸ N ≃* G' ⧸ N' := QuotientGroup.congr (G' := N) (H' := N') (e := e) hmap_id
  have hQp' : IsPGroup p (G' ⧸ N') := hQp.of_equiv eQ
  exact ⟨N', hN'norm, hN'cop, hQp'⟩

/-- Lift a normal `p`-complement from a quotient by a normal subgroup of coprime order. -/
public theorem CFSG.hasNormalPComplement_of_quotient [Finite G] (p : ℕ) (N : Subgroup G) [N.Normal]
    (hNcop : Nat.Coprime p (Nat.card N))
    (hquot : HasNormalPComplement p (G ⧸ N)) :
    HasNormalPComplement p G := by
  let _ := (inferInstance : Finite G)
  rcases hquot with ⟨Mbar, hMbarNorm, hMbarCop, hQbarP⟩
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  let M : Subgroup G := Mbar.comap q
  have hN_le_M : N ≤ M := by
    simpa [M, q] using (QuotientGroup.le_comap_mk' N Mbar)
  have hMnorm : M.Normal := hMbarNorm.comap q
  have hcardQuot : Nat.card (M ⧸ N.subgroupOf M) = Nat.card Mbar := by
    simpa [M, q] using
      (card_quotient_subgroupOf_comap_eq (f := q) (hf := QuotientGroup.mk'_surjective N) (H := Mbar))
  have hcardNsub : Nat.card (N.subgroupOf M) = Nat.card N := by
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (H := N) (K := M) hN_le_M).toEquiv
  have hcardM : Nat.card M = Nat.card Mbar * Nat.card N := by
    have hcardM' :
        Nat.card M = Nat.card (M ⧸ N.subgroupOf M) * Nat.card (N.subgroupOf M) := by
      simpa using (Subgroup.card_eq_card_quotient_mul_card_subgroup (s := N.subgroupOf M))
    calc
      Nat.card M = Nat.card (M ⧸ N.subgroupOf M) * Nat.card (N.subgroupOf M) := hcardM'
      _ = Nat.card Mbar * Nat.card N := by rw [hcardQuot, hcardNsub]
  have hMcop : Nat.Coprime p (Nat.card M) := by
    rw [hcardM]
    exact Nat.Coprime.mul_right hMbarCop hNcop
  have hMmap : M.map q = Mbar := by
    simpa [M, q] using (Subgroup.map_comap_eq_self_of_surjective (f := q) (h := QuotientGroup.mk'_surjective N) Mbar)
  have hQmid : IsPGroup p ((G ⧸ N) ⧸ M.map q) := by
    let e1 : (G ⧸ N) ⧸ Mbar ≃* (G ⧸ N) ⧸ M.map q :=
      QuotientGroup.quotientMulEquivOfEq hMmap.symm
    exact hQbarP.of_equiv e1
  letI : M.Normal := hMnorm
  let e2 : (G ⧸ N) ⧸ M.map q ≃* G ⧸ M :=
    QuotientGroup.quotientQuotientEquivQuotient (N := N) (M := M) hN_le_M
  have hQp : IsPGroup p (G ⧸ M) := hQmid.of_equiv e2
  exact ⟨M, hMnorm, hMcop, hQp⟩

/-- Lift a normal `p`-complement along a surjective homomorphism with coprime kernel. -/
public theorem CFSG.hasNormalPComplement_of_surjective {G' : Type*} [Group G'] [Finite G] (p : ℕ)
    (f : G →* G') (hf : Function.Surjective f)
    (hkerCop : Nat.Coprime p (Nat.card f.ker))
    (hG' : HasNormalPComplement p G') :
    HasNormalPComplement p G := by
  let e : G ⧸ f.ker ≃* G' := QuotientGroup.quotientKerEquivOfSurjective f hf
  have hquot : HasNormalPComplement p (G ⧸ f.ker) :=
    hasNormalPComplement_of_equiv (G := G') (p := p) e.symm hG'
  exact hasNormalPComplement_of_quotient (G := G) (p := p) (N := f.ker) hkerCop hquot

/-- `p`-elementhood is preserved by a multiplicative equivalence. -/
public theorem CFSG.isPElement_equiv_iff (p : ℕ) {G' : Type*} [Group G']
    (e : G ≃* G') (x : G) :
    IsPElement (p := p) (e x) ↔ IsPElement (p := p) x := by
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    calc
      orderOf x = orderOf (e x) := (e.orderOf_eq x).symm
      _ = p ^ n := hn
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    calc
      orderOf (e x) = orderOf x := e.orderOf_eq x
      _ = p ^ n := hn

/-- The subgroup generated by `p`-elements commutes with group isomorphisms. -/
public theorem CFSG.pElementsSubgroup_map_equiv (p : ℕ) {G' : Type*} [Group G']
    (e : G ≃* G') :
    (pElementsSubgroup p G).map e.toMonoidHom = pElementsSubgroup p G' := by
  let S : Set G := {x : G | IsPElement (p := p) x}
  let S' : Set G' := {x : G' | IsPElement (p := p) x}
  have hS : (fun x : G => e x) '' S = S' := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact (isPElement_equiv_iff (p := p) (e := e) y).2 hy
    · intro hx
      refine ⟨e.symm x, ?_, by simp⟩
      change IsPElement (p := p) (e.symm x)
      apply (isPElement_equiv_iff (p := p) (e := e) (e.symm x)).1
      change IsPElement (p := p) x at hx
      simpa using hx
  calc
    (pElementsSubgroup p G).map e.toMonoidHom
        = (Subgroup.closure S).map e.toMonoidHom := by rfl
    _ = Subgroup.closure ((fun x : G => e x) '' S) := by
          simpa using (MonoidHom.map_closure (f := e.toMonoidHom) S)
    _ = Subgroup.closure S' := by simp [hS]
    _ = pElementsSubgroup p G' := by rfl

/-- A direct product has a normal `p`-complement if each factor does. -/
public theorem CFSG.hasNormalPComplement_prod {G' : Type*} [Group G'] [Finite G] [Finite G'] (p : ℕ) :
    HasNormalPComplement p G → HasNormalPComplement p G' → HasNormalPComplement p (G × G') := by
  let _ := (inferInstance : Finite G)
  let _ := (inferInstance : Finite G')
  intro hG hG'
  rcases hG with ⟨N₁, hN₁norm, hN₁cop, hQ₁p⟩
  rcases hG' with ⟨N₂, hN₂norm, hN₂cop, hQ₂p⟩
  let N : Subgroup (G × G') := N₁.prod N₂
  let q₁ : G →* G ⧸ N₁ := QuotientGroup.mk' N₁
  let q₂ : G' →* G' ⧸ N₂ := QuotientGroup.mk' N₂
  let f : G × G' →* (G ⧸ N₁) × (G' ⧸ N₂) := q₁.prodMap q₂
  have hf_surj : Function.Surjective f := by
    rintro ⟨a, b⟩
    rcases (QuotientGroup.mk'_surjective N₁ a) with ⟨x, rfl⟩
    rcases (QuotientGroup.mk'_surjective N₂ b) with ⟨y, rfl⟩
    exact ⟨(x, y), rfl⟩
  have hker : f.ker = N := by
    ext x
    rcases x with ⟨x, y⟩
    simp [f, N, q₁, q₂, Subgroup.mem_prod, QuotientGroup.eq_one_iff]
  have hNcop : Nat.Coprime p (Nat.card N) := by
    have hcardN : Nat.card N = Nat.card N₁ * Nat.card N₂ := by
      calc
        Nat.card N = Nat.card (N₁ × N₂) := Nat.card_congr (Subgroup.prodEquiv N₁ N₂).toEquiv
        _ = Nat.card N₁ * Nat.card N₂ := Nat.card_prod N₁ N₂
    rw [hcardN]
    exact Nat.Coprime.mul_right hN₁cop hN₂cop
  have hQprod : IsPGroup p ((G ⧸ N₁) × (G' ⧸ N₂)) := by
    intro z
    rcases hQ₁p z.1 with ⟨n₁, hn₁⟩
    rcases hQ₂p z.2 with ⟨n₂, hn₂⟩
    refine ⟨n₁ + n₂, ?_⟩
    apply Prod.ext
    · calc
        z.1 ^ p ^ (n₁ + n₂) = (z.1 ^ p ^ n₁) ^ (p ^ n₂) := by
          rw [Nat.pow_add, pow_mul]
        _ = 1 := by simp [hn₁]
    · calc
        z.2 ^ p ^ (n₁ + n₂) = z.2 ^ p ^ (n₂ + n₁) := by rw [Nat.add_comm]
        _ = (z.2 ^ p ^ n₂) ^ (p ^ n₁) := by rw [Nat.pow_add, pow_mul]
        _ = 1 := by simp [hn₂]
  let e₁ : (G × G') ⧸ N ≃* (G × G') ⧸ f.ker := QuotientGroup.quotientMulEquivOfEq hker.symm
  let e₂ : (G × G') ⧸ f.ker ≃* (G ⧸ N₁) × (G' ⧸ N₂) :=
    QuotientGroup.quotientKerEquivOfSurjective f hf_surj
  have hQp : IsPGroup p ((G × G') ⧸ N) := hQprod.of_equiv (e₁.trans e₂).symm
  exact ⟨N, inferInstance, hNcop, hQp⟩

/-- Every `p`-element of a direct product has `p`-elements as coordinates. -/
public theorem CFSG.pElementsSubgroup_le_prod {G' : Type*} [Group G'] (p : ℕ) [Fact p.Prime] :
    pElementsSubgroup p (G × G') ≤ (pElementsSubgroup p G).prod (pElementsSubgroup p G') := by
  unfold pElementsSubgroup
  refine (Subgroup.closure_le (K := (Subgroup.closure {x : G | IsPElement (p := p) x}).prod
    (Subgroup.closure {x : G' | IsPElement (p := p) x}))).2 ?_
  intro x hx
  rcases x with ⟨a, b⟩
  rcases hx with ⟨n, hn⟩
  have hdivA : orderOf a ∣ p ^ n := by
    exact (orderOf_map_dvd (ψ := MonoidHom.fst G G') (a, b)).trans (by simp [hn])
  have hdivB : orderOf b ∣ p ^ n := by
    exact (orderOf_map_dvd (ψ := MonoidHom.snd G G') (a, b)).trans (by simp [hn])
  rcases (Nat.dvd_prime_pow (Fact.out : Nat.Prime p)).1 hdivA with ⟨m, _hmle, hm⟩
  rcases (Nat.dvd_prime_pow (Fact.out : Nat.Prime p)).1 hdivB with ⟨k, _hkle, hk⟩
  have ha_mem : a ∈ Subgroup.closure {x : G | IsPElement (p := p) x} :=
    Subgroup.subset_closure ⟨m, hm⟩
  have hb_mem : b ∈ Subgroup.closure {x : G' | IsPElement (p := p) x} :=
    Subgroup.subset_closure ⟨k, hk⟩
  exact ⟨ha_mem, hb_mem⟩

end PLengthLemmas

section PPrimeCoreQuotient

variable {G : Type*} [Group G] [Finite G]
variable (p : ℕ) [Fact p.Prime]

/-- If `H ◃ G`, then the image of `𝒪_{p'}(H)` in `G` lies in `𝒪_{p'}(G)`. -/
public theorem CFSG.pPrimeCore_map_subtype_le_pPrimeCore_of_normal (H : Subgroup G) [H.Normal] :
    (pPrimeCore p (↥H)).map H.subtype ≤ pPrimeCore p G := by
  have hmap_normal : ((pPrimeCore p (↥H)).map H.subtype).Normal := by
    letI : (pPrimeCore p (↥H)).Characteristic := pPrimeCore_characteristic (p := p) (G := ↥H)
    infer_instance
  have hmap_coprime : Nat.Coprime p (Nat.card ((pPrimeCore p (↥H)).map H.subtype)) := by
    have hcard_map :
        Nat.card ((pPrimeCore p (↥H)).map H.subtype) = Nat.card (pPrimeCore p (↥H)) := by
      simpa using
        (Subgroup.card_map_of_injective (K := pPrimeCore p (↥H))
          (f := H.subtype) H.subtype_injective)
    rw [hcard_map]
    exact pPrimeCore_coprime_card (p := p) (G := ↥H)
  exact le_sSup ⟨hmap_normal, hmap_coprime⟩

omit [Fact p.Prime] in
/-- If a finite group has a normal `p`-complement, then quotienting by `𝒪_{p'}(G)` is a `p`-group. -/
public theorem CFSG.isPGroup_quotient_pPrimeCore_of_hasNormalPComplement
    (H : Type*) [Group H] [Finite H] (hcomp : HasNormalPComplement p H) :
    IsPGroup p (H ⧸ pPrimeCore p H) := by
  let _ := (inferInstance : Finite H)
  rcases hcomp with ⟨N, hNnorm, hNcop, hQp⟩
  letI : N.Normal := hNnorm
  have hN_le_core : N ≤ pPrimeCore p H := by
    exact le_sSup ⟨hNnorm, hNcop⟩
  have hN_le_core' : N ≤ (pPrimeCore p H).comap (MonoidHom.id H) := by
    simpa [Subgroup.comap_id] using hN_le_core
  let f : H ⧸ N →* H ⧸ pPrimeCore p H :=
    QuotientGroup.map N (pPrimeCore p H) (MonoidHom.id H) hN_le_core'
  have hf_surj : Function.Surjective f := by
    intro q
    refine QuotientGroup.induction_on q ?_
    intro x
    refine ⟨(x : H ⧸ N), ?_⟩
    simp [f]
  exact IsPGroup.of_surjective (hG := hQp) f hf_surj

/-- If the subgroup generated by `p`-elements has a normal `p`-complement, then it lies in
`𝒪_{p',p}(G)`. -/
public theorem CFSG.pElementsSubgroup_le_Op_p'p_of_hasNormalPComplement
    (hcomp : HasNormalPComplement p (↥(pElementsSubgroup p G))) :
    pElementsSubgroup p G ≤ Op_p'p p G := by
  let P : Subgroup G := pElementsSubgroup p G
  letI : P.Characteristic := pElementsSubgroup_characteristic (p := p) G
  letI : P.Normal := by infer_instance
  let q : G →* (G ⧸ pPrimeCore p G) := QuotientGroup.mk' (pPrimeCore p G)
  let Pbar : Subgroup (G ⧸ pPrimeCore p G) := P.map q
  have hPquot : IsPGroup p (P ⧸ pPrimeCore p P) :=
    isPGroup_quotient_pPrimeCore_of_hasNormalPComplement (p := p) (H := ↥P) hcomp
  have hcoreP_le_coreG : (pPrimeCore p P).map P.subtype ≤ pPrimeCore p G :=
    pPrimeCore_map_subtype_le_pPrimeCore_of_normal (p := p) P
  let ψ0 : P →* Pbar :=
    (q.comp P.subtype).codRestrict Pbar (by
      intro x
      exact Subgroup.mem_map.mpr ⟨x, x.property, rfl⟩)
  have hcoreP_le_ker : pPrimeCore p P ≤ ψ0.ker := by
    intro x hx
    apply Subtype.ext
    change q (x : G) = 1
    apply (QuotientGroup.eq_one_iff (N := pPrimeCore p G) (x := (x : G))).2
    exact hcoreP_le_coreG (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
  let ψ : P ⧸ pPrimeCore p P →* Pbar := QuotientGroup.lift (pPrimeCore p P) ψ0 hcoreP_le_ker
  have hψ0_surj : Function.Surjective ψ0 := by
    intro y
    rcases y.property with ⟨x, hx, hxy⟩
    refine ⟨⟨x, hx⟩, ?_⟩
    apply Subtype.ext
    simpa [ψ0] using hxy
  have hψ_surj : Function.Surjective ψ :=
    QuotientGroup.lift_surjective_of_surjective (N := pPrimeCore p P) (φ := ψ0) hψ0_surj hcoreP_le_ker
  have hPbar_p : IsPGroup p Pbar := IsPGroup.of_surjective (hG := hPquot) ψ hψ_surj
  have hPbar_le_pcore : Pbar ≤ pCore p (G ⧸ pPrimeCore p G) :=
    le_sSup ⟨inferInstance, hPbar_p⟩
  intro x hx
  change q x ∈ pCore p (G ⧸ pPrimeCore p G)
  exact hPbar_le_pcore (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)

/-- `𝒪_{p',p}(G)` has a normal `p`-complement. -/
public theorem CFSG.hasNormalPComplement_Op_p'p :
    HasNormalPComplement p (↥(Op_p'p p G)) := by
  let M : Subgroup G := pPrimeCore p G
  let L : Subgroup G := Op_p'p p G
  let q : G →* (G ⧸ M) := QuotientGroup.mk' M
  have hM_le_L : M ≤ L := by
    intro x hx
    change q x ∈ pCore p (G ⧸ M)
    have hx1 : q x = 1 := (QuotientGroup.eq_one_iff (N := M) (x := x)).2 hx
    simp [hx1]
  let N : Subgroup L := M.subgroupOf L
  have hN_coprime : Nat.Coprime p (Nat.card N) := by
    have hcardN : Nat.card N = Nat.card M := by
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (H := M) (K := L) hM_le_L).toEquiv
    rw [hcardN]
    exact pPrimeCore_coprime_card (p := p) (G := G)
  let ψ0 : L →* pCore p (G ⧸ M) :=
    (q.comp L.subtype).codRestrict (pCore p (G ⧸ M)) (by
      intro x
      exact x.property)
  have hN_eq_ker : N = ψ0.ker := by
    ext x
    change (x : G) ∈ M ↔ ψ0 x = 1
    constructor
    · intro hx
      apply Subtype.ext
      exact (QuotientGroup.eq_one_iff (N := M) (x := (x : G))).2 hx
    · intro hx
      have hx' : (q (x : G)) = 1 := congrArg Subtype.val hx
      exact (QuotientGroup.eq_one_iff (N := M) (x := (x : G))).1 hx'
  have hQker : IsPGroup p (L ⧸ ψ0.ker) := by
    let ψ : L ⧸ ψ0.ker →* pCore p (G ⧸ M) := QuotientGroup.kerLift ψ0
    have hψinj : Function.Injective ψ := QuotientGroup.kerLift_injective ψ0
    exact IsPGroup.of_injective (hG := pCore_isPGroup (p := p) (G := G ⧸ M)) (ϕ := ψ) hψinj
  have hmap_id : N.map (MulEquiv.refl L : L →* L) = ψ0.ker := by
    simpa using hN_eq_ker
  let eQ : L ⧸ N ≃* L ⧸ ψ0.ker :=
    QuotientGroup.congr (G' := N) (H' := ψ0.ker) (e := MulEquiv.refl L) hmap_id
  have hQN : IsPGroup p (L ⧸ N) := by
    exact hQker.of_equiv eQ.symm
  exact ⟨N, inferInstance, hN_coprime, hQN⟩

/-- If `G` has `p`-length one, then every `p`-element lies in `𝒪_{p',p}(G)`. -/
public theorem CFSG.pElementsSubgroup_le_Op_p'p_of_hasPLengthOne
    (hplen : HasPLengthOne (p := p) G) :
    pElementsSubgroup p G ≤ Op_p'p p G := by
  let q : G →* (G ⧸ Op_p'p p G) := QuotientGroup.mk' (Op_p'p p G)
  have hcore_top : pPrimeCore p (G ⧸ Op_p'p p G) = ⊤ := by
    let K : Subgroup (G ⧸ Op_p'p p G) := pPrimeCore p (G ⧸ Op_p'p p G)
    have hcomap_top : K.comap q = ⊤ := by
      have hplen' : Op_p'pp' p G = ⊤ := by simpa [HasPLengthOne] using hplen
      simpa [Op_p'pp', q, K] using hplen'
    calc
      K = (K.comap q).map q := by
            exact (Subgroup.map_comap_eq_self_of_surjective (f := q)
              (h := QuotientGroup.mk'_surjective (Op_p'p p G)) K).symm
      _ = (⊤ : Subgroup G).map q := by simp [hcomap_top]
      _ = ⊤ := by
            simpa using (Subgroup.map_top_of_surjective (f := q)
              (QuotientGroup.mk'_surjective (Op_p'p p G)))
  have hcopQ : Nat.Coprime p (Nat.card (G ⧸ Op_p'p p G)) := by
    have hcopK : Nat.Coprime p (Nat.card (pPrimeCore p (G ⧸ Op_p'p p G))) :=
      pPrimeCore_coprime_card (p := p) (G := G ⧸ Op_p'p p G)
    simpa [hcore_top] using hcopK
  have hEqOne_of_isPElement {y : G ⧸ Op_p'p p G} (hy : IsPElement (p := p) y) : y = 1 := by
    rcases hy with ⟨n, hn⟩
    have hcopOrd : Nat.Coprime p (orderOf y) :=
      Nat.Coprime.of_dvd_right (orderOf_dvd_natCard y) hcopQ
    rw [hn] at hcopOrd
    have hnzero : n = 0 := by
      by_contra hn0
      have hdvd : p ∣ p ^ n := dvd_pow_self p (Nat.pos_iff_ne_zero.mpr hn0).ne'
      exact ((Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime p)).1 hcopOrd) hdvd
    have horder_one : orderOf y = 1 := by simpa [hnzero] using hn
    exact orderOf_eq_one_iff.mp horder_one
  have hgen_ker : {x : G | IsPElement (p := p) x} ⊆ q.ker := by
    intro x hx
    have hxQ : IsPElement (p := p) (q x) := by
      rcases hx with ⟨n, hn⟩
      have hdiv : orderOf (q x) ∣ p ^ n := by
        exact dvd_trans (orderOf_map_dvd (ψ := q) x) (by simp [hn])
      rcases (Nat.dvd_prime_pow (Fact.out : Nat.Prime p)).1 hdiv with ⟨m, _hmle, hm⟩
      exact ⟨m, hm⟩
    exact (MonoidHom.mem_ker (f := q) (x := x)).2 (hEqOne_of_isPElement hxQ)
  have hP_le_ker : pElementsSubgroup p G ≤ q.ker := by
    unfold pElementsSubgroup
    exact (Subgroup.closure_le (K := q.ker)).2 hgen_ker
  simpa [q, QuotientGroup.ker_mk'] using hP_le_ker

/-- If `𝒪_{p'}(G/N) = 1`, then `𝒪_{p'}(G) ≤ N`. -/
public theorem CFSG.pPrimeCore_le_of_quotient_eq_bot (N : Subgroup G) [N.Normal]
    (hbot : pPrimeCore p (G ⧸ N) = ⊥) :
    pPrimeCore p G ≤ N := by
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  let Kbar : Subgroup (G ⧸ N) := (pPrimeCore p G).map q
  have hKbar_norm : Kbar.Normal := by
    exact Subgroup.Normal.map (inferInstance : (pPrimeCore p G).Normal) q (QuotientGroup.mk'_surjective N)
  have hKbar_cop : Nat.Coprime p (Nat.card Kbar) := by
    exact Nat.Coprime.of_dvd_right (Subgroup.card_map_dvd (H := pPrimeCore p G) q)
      (pPrimeCore_coprime_card (G := G) (p := p))
  have hKbar_bot : Kbar = ⊥ :=
    (pPrimeCore_eq_bot_iff (p := p) (G := G ⧸ N)).1 hbot Kbar hKbar_norm hKbar_cop
  have hle_ker : pPrimeCore p G ≤ q.ker := by
    exact (Subgroup.map_eq_bot_iff (f := q) (H := pPrimeCore p G)).1 (by simpa [Kbar] using hKbar_bot)
  simpa [q, QuotientGroup.ker_mk'] using hle_ker

omit [Finite G] [Fact p.Prime] in
/-- If `H ◃ G` is a `p`-subgroup, then `pCore` maps onto the `pCore` of the quotient. -/
public theorem CFSG.pCore_map_mk'_eq_of_normal_isPGroup (H : Subgroup G) [H.Normal]
    (hHp : IsPGroup p (↥H)) :
    (pCore p G).map (QuotientGroup.mk' H) = pCore p (G ⧸ H) := by
  let q : G →* G ⧸ H := QuotientGroup.mk' H
  let Kbar : Subgroup (G ⧸ H) := pCore p (G ⧸ H)
  have hmap_le : (pCore p G).map q ≤ Kbar := by
    have hmap_norm : ((pCore p G).map q).Normal := by
      exact Subgroup.Normal.map (inferInstance : (pCore p G).Normal) q (QuotientGroup.mk'_surjective H)
    have hmap_p : IsPGroup p ((pCore p G).map q) := by
      exact IsPGroup.map (p := p) (H := pCore p G) (pCore_isPGroup (p := p) (G := G)) q
    exact le_sSup ⟨hmap_norm, hmap_p⟩
  have hKbar_le : Kbar ≤ (pCore p G).map q := by
    let Kpre : Subgroup G := Kbar.comap q
    have hKpre_norm : Kpre.Normal := (inferInstance : Kbar.Normal).comap q
    have hker_eq : q.ker = H := by
      simp [q]
    have hqker_p : IsPGroup p q.ker := by
      exact hker_eq.symm ▸ hHp
    have hKpre_p : IsPGroup p Kpre := by
      exact (pCore_isPGroup (p := p) (G := G ⧸ H)).comap_of_ker_isPGroup q hqker_p
    have hKpre_le : Kpre ≤ pCore p G := le_sSup ⟨hKpre_norm, hKpre_p⟩
    have hKbar_eq : Kbar = Kpre.map q := by
      symm
      simpa [Kpre] using
        (Subgroup.map_comap_eq_self_of_surjective (f := q) (h := QuotientGroup.mk'_surjective H) Kbar)
    calc
      Kbar = Kpre.map q := hKbar_eq
      _ ≤ (pCore p G).map q := Subgroup.map_mono hKpre_le
  exact le_antisymm hmap_le hKbar_le

omit [Finite G] [Fact (Nat.Prime p)] in
/-- If `𝒪_{p'}(G) = 1`, then `𝒪_{p',p}(G) = 𝒪_p(G)`. -/
public theorem CFSG.Op_p'p_eq_pCore_of_pPrimeCore_eq_bot (hbot : pPrimeCore p G = ⊥) :
    Op_p'p p G = pCore p G := by
  let q : G →* G ⧸ pPrimeCore p G := QuotientGroup.mk' (pPrimeCore p G)
  have hN_p : IsPGroup p (↥(pPrimeCore p G)) := by
    exact hbot.symm ▸ (IsPGroup.of_bot : IsPGroup p (↥(⊥ : Subgroup G)))
  have hmap : (pCore p G).map q = pCore p (G ⧸ pPrimeCore p G) :=
    pCore_map_mk'_eq_of_normal_isPGroup (G := G) (p := p) (pPrimeCore p G) hN_p
  have hker_le : q.ker ≤ pCore p G := by
    simp [q, QuotientGroup.ker_mk', hbot]
  calc
    Op_p'p p G = (pCore p (G ⧸ pPrimeCore p G)).comap q := by simp [Op_p'p, q]
    _ = ((pCore p G).map q).comap q := by rw [← hmap]
    _ = pCore p G := by
          simpa using (Subgroup.comap_map_eq_self (f := q) (H := pCore p G) hker_le)

end PPrimeCoreQuotient
