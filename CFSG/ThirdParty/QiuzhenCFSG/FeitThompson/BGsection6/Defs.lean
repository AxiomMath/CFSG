/-- The two-dimensional odd-order replacement for the last step of
Gorenstein, Chapter 3, Theorem 8.1.  Once the 3.8.1 proof has reduced to a
faithful two-dimensional representation generated by two `p`-elements, any
non-`p`-group case has an even quotient, namely the group itself. -/
private theorem CFSG.gorenstein_3_8_1_two_dimensional_even_quotient
    {F H V : Type*} [Field F] [Group H] [Finite H] [CharP F p]
    [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : Representation F H V) (hρ_faithful : Function.Injective ρ)
    (hdim : Module.finrank F V = 2)
    (x y : H) (hgen : Subgroup.closure ({x, y} : Set H) = ⊤)
    (hpodd : Odd p)
    (hx_p : IsPElement (p := p) x) (hy_p : IsPElement (p := p) y)
    (hnot_pgroup : ¬ IsPGroup p H) :
    ∃ (N : Subgroup H), N.Normal ∧ Even (Nat.card (H ⧸ N)) := by
  classical
  by_cases hoddH : Odd (Nat.card H)
  · have hH_p : IsPGroup p H :=
      gorenstein_3_8_1_two_dimensional_odd_order_forces_pgroup
        (p := p) ρ hρ_faithful hdim x y hgen hpodd hx_p hy_p hoddH
    exact False.elim (hnot_pgroup hH_p)
  · refine ⟨⊥, inferInstance, ?_⟩
    have hbot : Nat.card (H ⧸ (⊥ : Subgroup H)) = Nat.card H := by
      exact Nat.card_congr (QuotientGroup.quotientBot : H ⧸ (⊥ : Subgroup H) ≃* H)
    rw [hbot]
    exact Nat.not_odd_iff_even.mp hoddH

