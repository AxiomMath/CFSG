omit [Fact p.Prime] in
/-- Odd-order replacement for the two-dimensional endpoint of Gorenstein,
Chapter 3, Theorem 8.1: after the proof has reduced to a faithful
two-dimensional representation, the generated group cannot have odd order
unless it is already a `p`-group. -/
private theorem CFSG.gorenstein_3_8_1_two_dimensional_odd_order_forces_pgroup
    {F H V : Type*} [Field F] [Group H] [Finite H] [CharP F p]
    [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : Representation F H V) (hρ_faithful : Function.Injective ρ)
    (hdim : Module.finrank F V = 2)
    (x y : H) (hgen : Subgroup.closure ({x, y} : Set H) = ⊤)
    (hpodd : Odd p)
    (hx_p : IsPElement (p := p) x) (hy_p : IsPElement (p := p) y)
    (hoddH : Odd (Nat.card H)) :
    IsPGroup p H := by
  classical
  have hchar : ringChar F = p := by
    exact CharP.eq (R := F) (ringChar.charP F) (inferInstance : CharP F p)
  rcases theorem_2_6_b (F := F) (G := H) hoddH hdim hρ_faithful with
    ⟨P, _hP_comm, hcomm_le_P⟩
  have hP_normal : (P : Subgroup H).Normal := by
    refine ⟨?_⟩
    intro n hn g
    have hcomm_gn : ⁅g, n⁆ ∈ (P : Subgroup H) := by
      exact hcomm_le_P (by
        rw [commutator_eq_closure]
        exact Subgroup.subset_closure (commutator_mem_commutatorSet g n))
    have hmul : ⁅g, n⁆ * n ∈ (P : Subgroup H) :=
      (P : Subgroup H).mul_mem hcomm_gn hn
    simpa [commutatorElement_def, mul_assoc] using hmul
  have : (P : Subgroup H).Normal := hP_normal
  have hring_prime : Nat.Prime (ringChar F) := by
    rw [hchar]
    rcases CharP.char_is_prime_or_zero (R := F) p with hp | hp0
    · exact hp
    · exact False.elim (Nat.not_odd_zero (by simp [hp0] at hpodd))
  let : Fact (Nat.Prime (ringChar F)) := ⟨hring_prime⟩
  have hxP : x ∈ (P : Subgroup H) := by
    have hx_closure_p : IsPGroup (ringChar F) (Subgroup.closure ({x} : Set H)) := by
      intro z
      rcases hx_p with ⟨n, hn⟩
      have hgen_powers :
          ∀ g ∈ Subgroup.closure ({x} : Set H), ∃ k : ℕ, g ^ ((ringChar F) ^ k) = 1 := by
        intro g hg
        refine Subgroup.closure_induction (k := ({x} : Set H)) ?_ ?_ ?_ ?_ hg
        · intro g hg
          simp only [Set.mem_singleton_iff] at hg
          subst hg
          exact ⟨n, by rw [hchar, ← hn, pow_orderOf_eq_one]⟩
        · exact ⟨0, by simp⟩
        · intro a b ha_mem hb_mem ha hb
          rcases ha with ⟨ka, hka⟩
          rcases hb with ⟨kb, hkb⟩
          have hcomm_ab : Commute a b := by
            rw [← Subgroup.zpowers_eq_closure] at ha_mem hb_mem
            exact
              setLike_mul_comm
                (s := Subgroup.zpowers x) ha_mem hb_mem
          refine ⟨ka + kb, ?_⟩
          calc
            (a * b) ^ ((ringChar F) ^ (ka + kb)) =
                a ^ ((ringChar F) ^ (ka + kb)) *
                  b ^ ((ringChar F) ^ (ka + kb)) := by
              simpa [hcomm_ab.eq] using hcomm_ab.mul_pow ((ringChar F) ^ (ka + kb))
            _ =
                ((a ^ ((ringChar F) ^ ka)) ^ ((ringChar F) ^ kb)) *
                  ((b ^ ((ringChar F) ^ kb)) ^ ((ringChar F) ^ ka)) := by
              rw [Nat.pow_add, pow_mul,
                Nat.mul_comm ((ringChar F) ^ ka) ((ringChar F) ^ kb), pow_mul]
            _ = 1 := by simp [hka, hkb]
        · intro a ha_mem ha
          rcases ha with ⟨ka, hka⟩
          refine ⟨ka, ?_⟩
          have := congrArg Inv.inv hka
          simpa [inv_pow] using this
      rcases hgen_powers z z.2 with ⟨k, hk⟩
      exact ⟨k, Subtype.ext (by simpa using hk)⟩
    rcases IsPGroup.exists_le_sylow (p := ringChar F)
        (P := Subgroup.closure ({x} : Set H))
        hx_closure_p with
      ⟨Q, hQle⟩
    have hQ_eq_P : Q = P := by
      have : Unique (Sylow (ringChar F) H) := Sylow.unique_of_normal P hP_normal
      exact Subsingleton.elim Q P
    have hxQ : x ∈ (Q : Subgroup H) :=
      hQle (Subgroup.subset_closure (by simp))
    simpa [hQ_eq_P] using hxQ
  have hyP : y ∈ (P : Subgroup H) := by
    have hy_closure_p : IsPGroup (ringChar F) (Subgroup.closure ({y} : Set H)) := by
      intro z
      rcases hy_p with ⟨n, hn⟩
      have hgen_powers :
          ∀ g ∈ Subgroup.closure ({y} : Set H), ∃ k : ℕ, g ^ ((ringChar F) ^ k) = 1 := by
        intro g hg
        refine Subgroup.closure_induction (k := ({y} : Set H)) ?_ ?_ ?_ ?_ hg
        · intro g hg
          simp only [Set.mem_singleton_iff] at hg
          subst hg
          exact ⟨n, by rw [hchar, ← hn, pow_orderOf_eq_one]⟩
        · exact ⟨0, by simp⟩
        · intro a b ha_mem hb_mem ha hb
          rcases ha with ⟨ka, hka⟩
          rcases hb with ⟨kb, hkb⟩
          have hcomm_ab : Commute a b := by
            rw [← Subgroup.zpowers_eq_closure] at ha_mem hb_mem
            exact
              setLike_mul_comm
                (s := Subgroup.zpowers y) ha_mem hb_mem
          refine ⟨ka + kb, ?_⟩
          calc
            (a * b) ^ ((ringChar F) ^ (ka + kb)) =
                a ^ ((ringChar F) ^ (ka + kb)) *
                  b ^ ((ringChar F) ^ (ka + kb)) := by
              simpa [hcomm_ab.eq] using hcomm_ab.mul_pow ((ringChar F) ^ (ka + kb))
            _ =
                ((a ^ ((ringChar F) ^ ka)) ^ ((ringChar F) ^ kb)) *
                  ((b ^ ((ringChar F) ^ kb)) ^ ((ringChar F) ^ ka)) := by
              rw [Nat.pow_add, pow_mul,
                Nat.mul_comm ((ringChar F) ^ ka) ((ringChar F) ^ kb), pow_mul]
            _ = 1 := by simp [hka, hkb]
        · intro a ha_mem ha
          rcases ha with ⟨ka, hka⟩
          refine ⟨ka, ?_⟩
          have := congrArg Inv.inv hka
          simpa [inv_pow] using this
      rcases hgen_powers z z.2 with ⟨k, hk⟩
      exact ⟨k, Subtype.ext (by simpa using hk)⟩
    rcases IsPGroup.exists_le_sylow (p := ringChar F)
        (P := Subgroup.closure ({y} : Set H))
        hy_closure_p with
      ⟨Q, hQle⟩
    have hQ_eq_P : Q = P := by
      have : Unique (Sylow (ringChar F) H) := Sylow.unique_of_normal P hP_normal
      exact Subsingleton.elim Q P
    have hyQ : y ∈ (Q : Subgroup H) :=
      hQle (Subgroup.subset_closure (by simp))
    simpa [hQ_eq_P] using hyQ
  have hclosure_le_P : Subgroup.closure ({x, y} : Set H) ≤ (P : Subgroup H) := by
    exact (Subgroup.closure_le (K := (P : Subgroup H))).2 (by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hxP
      · exact hyP)
  have htop_le_P : (⊤ : Subgroup H) ≤ (P : Subgroup H) := by
    simpa [hgen] using hclosure_le_P
  have hP_top : (P : Subgroup H) = ⊤ := top_le_iff.mp htop_le_P
  have hH_ringChar : IsPGroup (ringChar F) H := by
    let e : (P : Subgroup H) ≃* H :=
      (MulEquiv.subgroupCongr hP_top).trans Subgroup.topEquiv
    exact P.isPGroup'.of_equiv e
  simpa [hchar] using hH_ringChar

