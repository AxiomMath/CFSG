private theorem theorem_10_8_counting_ratio_bound_of_support_estimate
    {m w1 w2 u sf s : ℕ}
    (hw1 : 0 < w1)
    (hw2 : 0 < w2)
    (hu : 0 < u)
    (hsf : 0 < sf)
    (hs : s = sf * u * w2)
    (hpre :
      ((w1 : ℚ) / (m : ℚ)) >
        1 - ((sf : ℚ) / (s : ℚ) +
          (1 - 1 / (w2 : ℚ) - 1 / (w1 : ℚ) +
            1 / ((w1 * w2 : ℕ) : ℚ))) -
          1 / (w1 : ℚ)) :
    ((w1 : ℚ) / (m : ℚ)) >
      (1 / (w2 : ℚ)) -
        (1 / ((w1 * w2 : ℕ) : ℚ)) -
          (1 / ((w2 * u : ℕ) : ℚ)) := by
  have hw1Q : (0 : ℚ) < (w1 : ℚ) := by exact_mod_cast hw1
  have hw2Q : (0 : ℚ) < (w2 : ℚ) := by exact_mod_cast hw2
  have huQ : (0 : ℚ) < (u : ℚ) := by exact_mod_cast hu
  have hsfQ : (0 : ℚ) < (sf : ℚ) := by exact_mod_cast hsf
  have hsQ : (s : ℚ) = (sf : ℚ) * (u : ℚ) * (w2 : ℚ) := by
    exact_mod_cast hs
  have hSF :
      (sf : ℚ) / (s : ℚ) = 1 / ((w2 * u : ℕ) : ℚ) := by
    rw [hsQ]
    have hwu : ((w2 * u : ℕ) : ℚ) = (u : ℚ) * (w2 : ℚ) := by
      norm_num [Nat.cast_mul, Nat.mul_comm]
      ring
    rw [hwu]
    field_simp [hsfQ.ne', huQ.ne', hw2Q.ne']
  have halg :
      1 - (1 / ((w2 * u : ℕ) : ℚ) +
          (1 - 1 / (w2 : ℚ) - 1 / (w1 : ℚ) +
            1 / ((w1 * w2 : ℕ) : ℚ))) -
          1 / (w1 : ℚ) =
        (1 / (w2 : ℚ)) -
          (1 / ((w1 * w2 : ℕ) : ℚ)) -
            (1 / ((w2 * u : ℕ) : ℚ)) := by
    norm_num [Nat.cast_mul]
    field_simp [hw1Q.ne', hw2Q.ne', huQ.ne']
    ring
  rw [hSF] at hpre
  rw [halg] at hpre
  exact hpre

private theorem theorem_10_8_counting_ratio_support_estimate_of_g1_bounds
    {m w1 w2 sf s g1 g : ℕ}
    (hgap :
