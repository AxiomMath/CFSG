  · intro i hi
    exact hinv i (Finset.mem_erase.mp hi).1
  · intro i hi
    exact hneq i (Finset.mem_erase.mp hi).1
  · intro i hi
    have hi0 : i ≠ i0 := (Finset.mem_erase.mp hi).1
