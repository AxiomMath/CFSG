  have hmul' :
      (1 : ℚ) - 1 / (w1 : ℚ) - 1 / (u : ℚ) <
        ((w1 * w2 : ℕ) : ℚ) / (m : ℚ) := by
    norm_num [Nat.cast_mul]
    field_simp [hmQ.ne', hw1Q.ne', hw2Q.ne', huQ.ne'] at hmul ⊢
