  rcases hUniform with
    ⟨_hI, _hJ, _hPrime, _hd, _hSign, _hn, hDegree, hδSign, hdn⟩
  have hδj : (δSign j : ℂ) = 1 := by
    rw [hδSign j hj, hδ]
