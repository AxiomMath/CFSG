    (1 / 2 : ℚ) < ((w1 * w2 : ℕ) : ℚ) / (m : ℚ) := by
  have hmQ : (0 : ℚ) < (m : ℚ) := by
    exact_mod_cast hm
  have hw1Q : (0 : ℚ) < (w1 : ℚ) := by
    exact_mod_cast (by omega : 0 < w1)
  have hw2Q : (0 : ℚ) < (w2 : ℚ) := by
