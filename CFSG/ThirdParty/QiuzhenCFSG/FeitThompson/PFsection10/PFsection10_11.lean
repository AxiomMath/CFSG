private theorem theorem_10_10_secondDerived_eq_center_and_card_of_noncomm_p3
    {G : Type u}
    [Group G]
    [Finite G]
    {H : Subgroup G}
    {p : Nat.Primes}
    (hpgroup : IsPGroup p.val H)
