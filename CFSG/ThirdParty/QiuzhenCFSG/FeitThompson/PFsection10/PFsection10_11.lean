    ⟨a0, ha0order⟩
  let a : G := a0
  have haZ : a ∈ Subgroup.zpowers x := a0.property
  have haOrder : orderOf a = p := by
    simpa [a, Subgroup.orderOf_coe] using ha0order
  have hane : a ≠ 1 := by
    intro ha1
    have horder_one : orderOf a = 1 := orderOf_eq_one_iff.mpr ha1
