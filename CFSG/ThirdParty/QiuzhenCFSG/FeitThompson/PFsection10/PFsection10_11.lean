    Finset.card_le_card hsubset
  have hcard_union : (suppA ∪ extra).card ≤ suppA.card + extra.card :=
    Finset.card_union_le suppA extra
  have hextra : extra.card ≤ 2 := by
    dsimp [extra]
    by_cases h : (i0, j1) = (i0, j2)
    · simp [h]
    · simp [h]
