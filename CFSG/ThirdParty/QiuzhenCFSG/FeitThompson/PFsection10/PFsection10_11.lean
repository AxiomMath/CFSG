private theorem theorem_10_7_dadeTransform_eq_zero_of_supportedOn_of_not_mem_dadeSupport
    {G : Type u}
    [Group G]
    {L : Subgroup G}
    {A A0 : Set G}
    {H : G → Subgroup G}
    (hA0L : ∀ a ∈ A0, a ∈ L)
