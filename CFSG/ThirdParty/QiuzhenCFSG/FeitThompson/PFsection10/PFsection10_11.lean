private theorem theorem_10_8_typeP_prime_support_mem_AZeroSet
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {M MF U W1 W2 : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G)
    (hP : Section8.typePDefinitionData M MF U W1 W2)
    {x : G}
    {p : ℕ}
    (hpPrime : p.Prime)
