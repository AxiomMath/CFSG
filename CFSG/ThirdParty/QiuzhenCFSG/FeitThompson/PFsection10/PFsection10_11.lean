  · have hdnNat : d = n * w + 1 := by omega
    have hprodOdd : Odd (n * w) := hnodd.mul hwodd
    have heven : Even (n * w + 1) := hprodOdd.add_one
    rw [← hdnNat] at heven
    exact (Nat.not_odd_iff_even.mpr heven) hdodd
