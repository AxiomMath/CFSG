    {δSign : J → ℤ}
    {ω : I → J → Section1.ClassFunction W}
    {σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G}
    (h10 : hypothesis_10_1_supported_data M MF W1 W2 V S τ)
    (hdata :
      section10FourSixNotationSupportedData M W1 W2 W A A0 i0 j0
        μ δSign ω σ τ)
