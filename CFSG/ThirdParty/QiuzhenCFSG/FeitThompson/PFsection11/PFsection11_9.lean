    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      section11Subfamily H1 S S1 →
        ∀ χ : Section1.ClassFunction M,
          χ ∈ S1 → Section1.conjugateCharacter χ ∈ S1 := by
  intro h11 hsub χ hχ
  rcases h11 with
    ⟨h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
      _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef⟩
  rcases h10 with
    ⟨_hMmax, _htype10, _hderived, _hW1M, _hW2M, _hW12M, _hDade, _h46,
      _hNotation10, h52⟩
  rcases h52 with ⟨_hsetup, _R, h52a, _h52b, _h52c, _h52d, _h52e⟩
  have hχS : χ ∈ S := ((hsub.2 χ).mp hχ).1
  have hχker : Section1.subgroupInKernel' χ (H1.subgroupOf M) :=
    ((hsub.2 χ).mp hχ).2
  have hconjS : Section1.conjugateCharacter χ ∈ S :=
    (h52a ⟨χ, hχS⟩).1
  have hconjKer :
      Section1.subgroupInKernel' (Section1.conjugateCharacter χ)
