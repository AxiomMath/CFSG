    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      1 < Nat.card U / Nat.card C := by
  intro h11
  have hCUlt : C < U :=
    theorem_11_5_C_lt_U_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hC_le_U : C ≤ U := hCUlt.le
  have hrel_gt : 1 < C.relIndex U := by
    have hpos : 0 < C.relIndex U := by
      dsimp [Subgroup.relIndex]
      exact Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite
    have hne : C.relIndex U ≠ 1 := by
      intro hrel
      have hUC : U ≤ C := (Subgroup.relIndex_eq_one).1 hrel
      exact hCUlt.not_ge hUC
    omega
  have hcardCsub : Nat.card (C.subgroupOf U) = Nat.card C :=
    natCard_subgroupOf_eq C U hC_le_U
  have hcardCIndex : Nat.card C * C.relIndex U = Nat.card U := by
    rw [Subgroup.relIndex, ← hcardCsub]
    exact (C.subgroupOf U).card_mul_index
  have hrelC_div : C.relIndex U = Nat.card U / Nat.card C :=
    Nat.eq_div_of_mul_eq_right (Nat.ne_of_gt Nat.card_pos) hcardCIndex
  rwa [← hrelC_div]

/-- Final arithmetic squeeze used in `(11.5)`: if a nontrivial index is at
least `2q + 1`, then the factor bound with a second factor greater than one
forces the index to be one. -/
private theorem theorem_11_5_arithmetic_index_eq_one
    {a b q : ℕ}
    (hb : 1 < b)
    (hbound : a * b ≤ 2 * q * b + 1)
    (hlower : a ≠ 1 → 2 * q + 1 ≤ a) :
    a = 1 := by
  by_contra hne
  have hge : 2 * q + 1 ≤ a := hlower hne
  have hle : (2 * q + 1) * b ≤ a * b := Nat.mul_le_mul_right b hge
  have hlt : 2 * q * b + 1 < (2 * q + 1) * b := by
    nlinarith
  omega

/-- If an odd divisor `d` divides `n - 1` and `n` is an odd nontrivial
integer, then `n` is at least `2d + 1`. -/
private theorem theorem_11_5_odd_divisor_sub_one_lower_bound
    {d n : ℕ}
    (hdodd : Odd d)
    (hnodd : Odd n)
    (hngt : 1 < n)
    (hdvd : d ∣ n - 1) :
    2 * d + 1 ≤ n := by
  rcases hdvd with ⟨c, hc⟩
  have hn_eq : n = d * c + 1 := by
    have hsucc : n - 1 + 1 = n := Nat.sub_add_cancel (by omega)
    omega
  have hc_ne_zero : c ≠ 0 := by
    intro hc0
    have : n = 1 := by simpa [hc0] using hn_eq
    omega
  have hc_ne_one : c ≠ 1 := by
    intro hc1
    have hn_even : Even n := by
      rw [hn_eq, hc1]
      simpa [mul_one] using hdodd.add_one
    exact (Nat.not_odd_iff_even.mpr hn_even) hnodd
  have hcge : 2 ≤ c := by omega
  have hmul : d * 2 ≤ d * c := Nat.mul_le_mul_left d hcge
  omega

/-- If an ambient subgroup normalizes both `H` and `K`, then it preserves
`H.subgroupOf K` for the conjugation action on `K`. -/
private theorem theorem_11_5_isInvariant_subgroupOf_of_le_normalizer
    {G : Type u}
    [Group G]
    (R H K : Subgroup G)
    (hRnormK : R ≤ Subgroup.normalizer (K : Set G))
    (hRnormH : R ≤ Subgroup.normalizer (H : Set G)) :
    letI : Subgroup.Normalizes R K := ⟨hRnormK⟩
    IsInvariant R K (H.subgroupOf K) := by
  letI : Subgroup.Normalizes R K := ⟨hRnormK⟩
  refine ⟨?_⟩
  intro r x
  constructor
  · intro hx
    have hxH : (x : G) ∈ H := hx
    have hmemH : (r : G) * (x : G) * (r : G)⁻¹ ∈ H :=
      ((Subgroup.mem_normalizer_iff.mp (hRnormH r.2) (x : G)).1 hxH)
    simpa [Subgroup.mem_subgroupOf, Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe,
      hRnormK] using hmemH
  · intro hx
    have hxH : ((r : G) * (x : G) * (r : G)⁻¹) ∈ H := by
      simpa [Subgroup.mem_subgroupOf, Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe,
        hRnormK] using hx
    exact ((Subgroup.mem_normalizer_iff.mp (hRnormH r.2) (x : G)).2 hxH)

/-- In the `(11.5)` context, `W₁` normalizes `HC`. -/
private theorem theorem_11_5_W1_le_normalizer_HC_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      W1 ≤ Subgroup.normalizer ((H ⊔ C : Subgroup G) : Set G) := by
  intro h11
  have hW1M : W1 ≤ M :=
    theorem_11_3_W1_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hCM : C ≤ M :=
    theorem_11_3_C_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHCM : H ⊔ C ≤ M := sup_le hHM hCM
  have hHCnorm : ((H ⊔ C).subgroupOf M).Normal :=
    (theorem_11_3_core_normalities_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11).2
  haveI : ((H ⊔ C).subgroupOf M).Normal := hHCnorm
  have hMnormHC : M ≤ Subgroup.normalizer ((H ⊔ C : Subgroup G) : Set G) :=
    Subgroup.le_normalizer_of_normal_subgroupOf hHCM
  exact hW1M.trans hMnormHC

/-- In the `(11.5)` context, `W₁` normalizes the ambient second derived
subgroup `M''`. -/
private theorem theorem_11_5_W1_le_normalizer_secondDerived_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
