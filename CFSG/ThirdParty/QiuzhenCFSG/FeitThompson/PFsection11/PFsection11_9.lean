      (Section9.kernelInducedSubfamily_subset_sec9
        M (ambientDerivedSubgroup M) MF (H0 ⊔ C) SH0 hχ)
  have hSH0CsubSC : SH0C ⊆ SC :=
    theorem_11_8_6_kernel_family_subset_SC_of_hypothesis
      M MF H U C H0 W1 W2 S SH0C SC τ p q h11 hSH0C hSH0CsubS hSC
  rcases theorem_11_quotientBarUCardinality_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11 with
