private theorem theorem_11_9_coefficients_eq_base_row_of_shape
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (a : I → J → ℂ)
    (i0 : I)
    (j0 : J) :
    a i0 j0 = 1 →
      (∃ i : I, i ≠ i0) →
        (∀ i i' j j', a i j + a i' j' = a i j' + a i' j) →
          (∀ i, i ≠ i0 → a i j0 = 0) →
            (∀ i j, i ≠ i0 → j ≠ j0 → a i j = 0) →
              ∀ i j, a i j = if i0 = i then 1 else 0 := by
  intro hbase hrow hrect hrowzero hintzero
  rcases hrow with ⟨i1, hi1⟩
  have hbase_ne : a i0 j0 ≠ 0 := by
    rw [hbase]
    norm_num
  have hshape :
      ∀ i j, a i j = if i = i0 then a i0 j0 else 0 :=
    Section3.coefficients_eq_single_row_indicator a i0 j0 hrect hbase_ne i1 hi1
      hrowzero hintzero
  intro i j
  by_cases hi : i0 = i
  · subst i
    simpa [hbase] using hshape i0 j
  · have hi' : i ≠ i0 := fun h => hi h.symm
    simpa [hi, hi'] using hshape i j

