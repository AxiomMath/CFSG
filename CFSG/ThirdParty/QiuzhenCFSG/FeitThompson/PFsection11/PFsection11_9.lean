      (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) *
          (Nat.card U / Nat.card C) ≤
        2 * q * (Nat.card U / Nat.card C) + 1 →
        (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) = 1 := by
  intro h11 hbound
  exact theorem_11_5_arithmetic_index_eq_one
    (a := (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C))
    (b := Nat.card U / Nat.card C)
    (q := q)
    (theorem_11_5_card_U_div_card_C_gt_one M MF H U C H0 W1 W2 S τ p q h11)
    hbound
    (theorem_11_5_fixedPointFree_index_lower_bound M MF H U C H0 W1 W2 S τ p q h11)

/-- Proof of `theorem_11_5_statement`, reduced to the fixed-point-free
