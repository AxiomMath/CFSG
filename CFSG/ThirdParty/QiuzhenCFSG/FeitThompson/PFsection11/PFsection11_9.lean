  letI : Fintype M := Fintype.ofFinite M
  classical
  let SC : Finset (Section1.ClassFunction M) :=
    S.filter fun χ => Section1.subgroupInKernel' χ (C.subgroupOf M)
  let S2 : Finset (Section1.ClassFunction M) :=
    SC.filter fun χ => χ ∉ SHC
  have hC_le_M : C ≤ M := le_sup_right.trans hSHC.1
  have hSC : section11Subfamily C S SC := by
    refine ⟨hC_le_M, ?_⟩
    intro χ
    simp [SC]
  have hS2 : ∀ χ : Section1.ClassFunction M, χ ∈ S2 ↔ χ ∈ SC ∧ χ ∉ SHC := by
    intro χ
    simp [S2]
  have hSHC_subset_SC : SHC ⊆ SC := by
    intro χ hχ
    rcases (hSHC.2 χ).mp hχ with ⟨hχS, hχkerHC⟩
    have hCsub_le_HCsub : C.subgroupOf M ≤ (H ⊔ C).subgroupOf M := by
      intro x hx
      exact Subgroup.mem_subgroupOf.mpr
        (Subgroup.mem_sup_right (Subgroup.mem_subgroupOf.mp hx))
    have hχkerC : Section1.subgroupInKernel' χ (C.subgroupOf M) :=
      Section9.subgroupInKernel'_mono_sec9 hCsub_le_HCsub hχkerHC
    simp [SC, hχS, hχkerC]
  have hSC_eq : SC = SHC ∪ S2 := by
    apply Finset.ext
    intro χ
    constructor
    · intro hχSC
      by_cases hχSHC : χ ∈ SHC
      · exact Finset.mem_union.mpr (Or.inl hχSHC)
      · exact Finset.mem_union.mpr (Or.inr (by simp [S2, hχSC, hχSHC]))
    · intro hχ
      rcases Finset.mem_union.mp hχ with hχSHC | hχS2
      · exact hSHC_subset_SC hχSHC
      · exact (hS2 χ).mp hχS2 |>.1
  exact ⟨SC, S2, hSC, hS2, hSC_eq⟩

