/-- Section 10 form of the PF `(3.7)` rectangle relation for the ambient
coefficients of `τ ψ`, assuming the local source function `ψ` vanishes on the
cyclic TI set. -/
private theorem theorem_11_9_tau_coefficients_rectangle_of_local_vanishesOn
    {G : Type u}
    [Group G]
    [Finite G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    {M W1 W2 : Subgroup G}
    {W : Subgroup M}
    {A A0 : Set M}
    {i0 : I}
    {j0 : J}
    {μ : I → J → Section1.ClassFunction M}
    {δSign : J → ℤ}
    {ω : I → J → Section1.ClassFunction W}
    {σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G}
    {τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G}
    {ψ : Section1.ClassFunction M}
    (hNotation :
      Section10.section10FourSixNotationSupportedData M W1 W2 W A A0 i0 j0 μ δSign ω σ τ)
    (hψsupport :
      Section1.supportedOn ψ
        (Section4Scratch.primeDadeA0Set
          (W1.subgroupOf M) (W2.subgroupOf M) W A))
    (hψclass : Section1.IsClassFunction ψ)
    (hψvanish :
      Section3.VanishesOn ψ
        (Section3.cyclicTISet (W1.subgroupOf M) (W2.subgroupOf M) W))
    (a : I → J → ℂ)
    (ha : ∀ i j, a i j = Section1.scalarProduct G (τ ψ) (σ (ω i j))) :
    ∀ i i' j j', a i j + a i' j' = a i j' + a i' j := by
  intro i i' j j'
  have hzero :=
    theorem_11_9_tau_omegaRectangle_scalarProduct_zero_of_local_vanishesOn
      hNotation hψsupport hψclass hψvanish i i' j j'
  have hcoeff :
      Section1.scalarProduct G (τ ψ) (σ (Section3.omegaRectangle W ω i i' j j')) =
        a i j + a i' j' - a i j' - a i' j := by
    rw [Section3.omegaRectangle]
    rw [map_sub, map_sub, map_add]
    rw [theorem_11_9_scalarProduct_sub_right,
      theorem_11_9_scalarProduct_sub_right,
      theorem_11_9_scalarProduct_add_right]
    rw [← ha i j, ← ha i' j', ← ha i j', ← ha i' j]
  have hsum : a i j + a i' j' - a i j' - a i' j = 0 :=
    hcoeff.symm.trans hzero
  have h := congrArg (fun z => z + a i j' + a i' j) hsum
  ring_nf at h ⊢
  exact h

/-- In the Section 10 `(4.6)` notation, a point of the local cyclic TI set is
outside `M'`. The direct-product decomposition inside `W` would otherwise put
the point in `W₂`, contradicting the cyclic-TI condition. -/
private theorem theorem_11_9_not_mem_derived_of_mem_cyclicTISet
    {G : Type u}
    [Group G]
    [Finite G]
    {M W1 W2 : Subgroup G}
    {W : Subgroup M}
    {A : Set M}
    (h46 :
      Section4Scratch.hypothesis_4_6_statement
        (derivedSubgroup M) (W1.subgroupOf M) (W2.subgroupOf M) W
        (derivedSubgroup M) A)
    {x : M}
    (hx :
      x ∈ Section3.cyclicTISet (W1.subgroupOf M) (W2.subgroupOf M) W) :
    x ∉ (derivedSubgroup M : Subgroup M) := by
  intro hxD
  have hxW : x ∈ W :=
    Section3.cyclicTISet_subset (W1.subgroupOf M) (W2.subgroupOf M) W hx
  have hxW2 : x ∈ W2.subgroupOf M := by
    rcases h46 with ⟨h42, _hDnormal, hW2D, _hDD, _hcentA, _hAinD⟩
    rcases h42 with
      ⟨hsemi, _hHall, _hcyc1, _hcard1, _hcyc2, _hcard2, _hcent,
        _hW1W, _hW2W, hDirect, _hodd⟩
    rcases hDirect.mul_surjective x hxW with ⟨w1, hw1, w2, hw2, hw12⟩
    have hw2D : (w2 : M) ∈ (derivedSubgroup M : Subgroup M) :=
      hW2D hw2
    have hw1D : (w1 : M) ∈ (derivedSubgroup M : Subgroup M) := by
      have hw1eq : (w1 : M) = x * (w2 : M)⁻¹ := by
        calc
          (w1 : M) = (w1 : M) * ((w2 : M) * (w2 : M)⁻¹) := by
            simp
          _ = ((w1 : M) * (w2 : M)) * (w2 : M)⁻¹ := by
            simp [mul_assoc]
          _ = x * (w2 : M)⁻¹ := by
            rw [hw12]
      rw [hw1eq]
      exact (derivedSubgroup M).mul_mem hxD ((derivedSubgroup M).inv_mem hw2D)
    have hw1bot : (w1 : M) ∈ (⊥ : Subgroup M) := by
      have hinf :
          (w1 : M) ∈ (derivedSubgroup M : Subgroup M) ⊓ W1.subgroupOf M :=
        Subgroup.mem_inf.mpr ⟨hw1D, hw1⟩
      rw [hsemi.inf_eq_bot] at hinf
      exact hinf
    have hw1one : (w1 : M) = 1 := by
      simpa using hw1bot
    have hxeq : x = (w2 : M) := by
      calc
        x = (w1 : M) * (w2 : M) := hw12
        _ = (w2 : M) := by simp [hw1one]
    simpa [hxeq] using hw2
  exact (Section3.cyclicTISet_not_mem_right
    (W1.subgroupOf M) (W2.subgroupOf M) W hx) hxW2

