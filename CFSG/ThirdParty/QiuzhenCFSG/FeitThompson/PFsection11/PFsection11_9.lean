        (Finset.sum Finset.univ (fun j : J => σ (ω i0 j))) (σ (ω i k)) =
      if i0 = i then 1 else 0 := by
  classical
  calc
    Section1.scalarProduct G
        (Finset.sum Finset.univ (fun j : J => σ (ω i0 j))) (σ (ω i k)) =
        Section1.scalarProduct G
          (fun g => ∑ j : J, (σ (ω i0 j)) g) (σ (ω i k)) := by
      congr 1
      ext g
      simp
    _ = ∑ j : J, Section1.scalarProduct G (σ (ω i0 j)) (σ (ω i k)) := by
      rw [Section1.scalarProduct_fintype_sum_left]
    _ = ∑ j : J, if (i0, j) = (i, k) then (1 : ℂ) else 0 := by
      refine Finset.sum_congr rfl ?_
      intro j _hj
      exact
        Section10.scalarProduct_sigma_omega_eq_pair_ite_of_section10FourSixNotationSupportedData
          hNotation i0 i j k
    _ = if i0 = i then (1 : ℂ) else 0 := by
      by_cases hi : i0 = i
