      Section9.Hypothesis_9_5 M MF U W1 W2 H0 C Cprime τ SH0 := by
    have h92q : Section9.hypothesis_9_2_statement M MF U W1 W2 q :=
      theorem_11_hypothesis_9_2_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q h11Full
    have h92 :
        Section9.hypothesis_9_2_statement
          M MF U W1 W2 (Nat.card W1) := by
      simpa [hqW1] using h92q
    let hp' : Nat.Primes := ⟨p, hp⟩
    have h94 : Section9.hoReductionData M MF U W2 H0 hp' :=
      theorem_11_hoReductionData_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q hp h11Full
    have hCent : Section9.quotientCentralizerIn MF H0 U C :=
      theorem_11_quotientCentralizerIn_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q h11Full
    have hBar : ∃ v : ℕ, Section9.quotientBarUCardinality U C v :=
      theorem_11_quotientBarUCardinality_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q h11Full
    have h52b : Section5.hypothesis_5_2_b_statement SH0 τ :=
      Section5.hypothesis_5_2_b_subset hSH0sub
        (theorem_11_hypothesis_5_2_b_of_hypothesis
          M MF H U C H0 W1 W2 S τ p q h11Full)
    exact ⟨h92, ⟨hp', h94⟩, hCent, hBar, hCprimeleC, rfl, hDade,
      hSH0, h52b⟩
  have hPrimeCoherent : Section6.coherentFamily SH0Cprime τ := by
    simpa [Section9.coherentFamilyForT] using
      (Section9.theorem_9_11 M MF U W1 W2 H0 C Cprime τ SH0 SH0Cprime
        h52prime h95 hSH0Cprime)
  have hSCClosed : ∀ χ : Section1.ClassFunction M, χ ∈ SC →
      Section1.conjugateCharacter χ ∈ SC := by
    intro χ hχ
    exact theorem_11_5_subfamily_conjugate_closed_of_hypothesis
      M MF H U C H0 W1 W2 C S SC τ p q h11Full hSC χ hχ
  have hSHCClosed : ∀ χ : Section1.ClassFunction M, χ ∈ SHC →
      Section1.conjugateCharacter χ ∈ SHC := by
    intro χ hχ
    exact theorem_11_5_subfamily_conjugate_closed_of_hypothesis
      M MF H U C H0 W1 W2 (H ⊔ C) S SHC τ p q h11Full hSHC χ hχ
  have hS2Closed : ∀ χ : Section1.ClassFunction M, χ ∈ S2 →
      Section1.conjugateCharacter χ ∈ S2 := by
    intro χ hχ
    rcases (hS2 χ).mp hχ with ⟨hχSC, hχnotSHC⟩
    apply (hS2 (Section1.conjugateCharacter χ)).mpr
    refine ⟨hSCClosed χ hχSC, ?_⟩
    intro hbarSHC
    apply hχnotSHC
    have hback := hSHCClosed (Section1.conjugateCharacter χ) hbarSHC
    simpa [Section9.conjugateCharacter_involutive_sec9] using hback
  have hS2Nonempty : S2.Nonempty := ⟨Section10.muColumn μ j, hmuS2⟩
  have h52S2 : Section5.hypothesis_5_2_statement S2 τ :=
    Section5.hypothesis_5_2_statement_subset hS2subPrime hS2Nonempty
      hS2Closed h52prime
  rcases h52S2 with
    ⟨hsetup, _R, h52a, _h52b, _h52c, _h52d, _h52e⟩
  have hmuBar := h52a ⟨Section10.muColumn μ j, hmuS2⟩
  have hSpanNonempty :
      Section5.integerSpanOnNonempty S2 Section5.puncturedSet :=
    Section5.integerSpanOnNonempty_of_conjugate_pair hmuS2 hmuBar.1
      hmuBar.2 (hsetup.2 ⟨Section10.muColumn μ j, hmuS2⟩)
  exact Section6.coherentFamily_mono hS2subPrime hSpanNonempty hPrimeCoherent

/-- Coherent extensions on disjoint conjugation-stable subfamilies of a
common PF `(5.2)` family have orthogonal images. -/
private theorem theorem_11_8_6_orthogonal_images_of_disjoint_subfamilies
    {L : Type u}
    [Group L]
    [Finite L]
    {G : Type u}
    [Group G]
    [Finite G]
    (S S1 S2 : Finset (Section1.ClassFunction L))
    (T T1 T2 :
      Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G)
    (h52 : Section5.hypothesis_5_2_statement S T)
    (hS1sub : S1 ⊆ S)
    (hS2sub : S2 ⊆ S)
    (hS1closed : ∀ χ : Section1.ClassFunction L, χ ∈ S1 →
      Section1.conjugateCharacter χ ∈ S1)
    (hS2closed : ∀ χ : Section1.ClassFunction L, χ ∈ S2 →
      Section1.conjugateCharacter χ ∈ S2)
    (hdisjoint : Disjoint S1 S2)
    (hExt1 : Section7.isCoherentExtension S1 T T1)
    (hExt2 : Section7.isCoherentExtension S2 T T2) :
    Section5.orthogonalFinsets (S1.image T1) (S2.image T2) := by
  classical
  rcases h52 with ⟨hsetup, R, h52a, h52b, h52c, h52d, h52e⟩
  intro φ ψ hφ hψ
  rcases Finset.mem_image.mp hφ with ⟨χ, hχS1, rfl⟩
  rcases Finset.mem_image.mp hψ with ⟨ξ, hξS2, rfl⟩
  let X : S := ⟨χ, hS1sub hχS1⟩
  let Y : S := ⟨ξ, hS2sub hξS2⟩
  have hχbarS1 : Section1.conjugateCharacter χ ∈ S1 :=
    hS1closed χ hχS1
  have hξbarS2 : Section1.conjugateCharacter ξ ∈ S2 :=
    hS2closed ξ hξS2
  have hpairXsub :
      ({(X : Section1.ClassFunction L),
        Section1.conjugateCharacter (X : Section1.ClassFunction L)} :
        Finset (Section1.ClassFunction L)) ⊆ S1 := by
    intro η hη
    simp [X] at hη
    rcases hη with rfl | rfl
    · exact hχS1
    · exact hχbarS1
  have hpairYsub :
      ({(Y : Section1.ClassFunction L),
        Section1.conjugateCharacter (Y : Section1.ClassFunction L)} :
        Finset (Section1.ClassFunction L)) ⊆ S2 := by
    intro η hη
    simp [Y] at hη
    rcases hη with rfl | rfl
    · exact hξS2
    · exact hξbarS2
  have hXiso :=
    Section5.isCFLinearIsometryOnSpan_mono hpairXsub hExt1.1
  have hXvirt :=
    Section5.mapsIntegerSpanToVirtualCharacters_mono hpairXsub hExt1.2.1
  have hYiso :=
    Section5.isCFLinearIsometryOnSpan_mono hpairYsub hExt2.1
  have hYvirt :=
    Section5.mapsIntegerSpanToVirtualCharacters_mono hpairYsub hExt2.2.1
  have hXagree :
      T1 ((X : Section1.ClassFunction L) -
          Section1.conjugateCharacter (X : Section1.ClassFunction L)) =
        T ((X : Section1.ClassFunction L) -
          Section1.conjugateCharacter (X : Section1.ClassFunction L)) := by
    simpa [X] using
      Section10.coherentExtension_agreesOn_sub_of_mem_of_degree_eq
        hExt1 hχS1 hχbarS1
          (Section5.degree_conjugateCharacter_eq_of_isCharacter
            (hsetup.2 X)).symm
  have hYagree :
      T2 ((Y : Section1.ClassFunction L) -
          Section1.conjugateCharacter (Y : Section1.ClassFunction L)) =
        T ((Y : Section1.ClassFunction L) -
          Section1.conjugateCharacter (Y : Section1.ClassFunction L)) := by
    simpa [Y] using
      Section10.coherentExtension_agreesOn_sub_of_mem_of_degree_eq
        hExt2 hξS2 hξbarS2
          (Section5.degree_conjugateCharacter_eq_of_isCharacter
            (hsetup.2 Y)).symm
  have hXsubset :
      Section5.isSubsetSumOf (R X) (T1 χ) := by
    simpa [X] using
      Section5.theorem_5_5 S T R hsetup h52a h52b h52c h52d h52e
        X T1 hXiso hXvirt hXagree
  have hYsubset :
      Section5.isSubsetSumOf (R Y) (T2 ξ) := by
    simpa [Y] using
      Section5.theorem_5_5 S T R hsetup h52a h52b h52c h52d h52e
        Y T2 hYiso hYvirt hYagree
  have hχneξ : χ ≠ ξ := by
    intro hEq
    exact Finset.disjoint_left.mp hdisjoint hχS1 (hEq ▸ hξS2)
  have hXneY : (X : Section1.ClassFunction L) ≠ Y := by
    simpa [X, Y] using hχneξ
  have hχneξbar : χ ≠ Section1.conjugateCharacter ξ := by
    intro hEq
    exact Finset.disjoint_left.mp hdisjoint hχS1 (hEq ▸ hξbarS2)
  have hXneYbar :
      (X : Section1.ClassFunction L) ≠
        Section1.conjugateCharacter (Y : Section1.ClassFunction L) := by
    simpa [X, Y] using hχneξbar
  have hRorth : Section5.orthogonalFinsets (R X) (R Y) :=
    h52e Y X
      (h52c X.2 Y.2 hXneY)
      (h52c X.2 (h52a Y).1 hXneYbar)
  rcases hXsubset with ⟨EX, hEX, hT1⟩
  rcases hYsubset with ⟨EY, hEY, hT2⟩
  have hsumRight : ∀ (E : Finset (Section1.ClassFunction G))
      (f : Section1.ClassFunction G → Section1.ClassFunction G)
      (η : Section1.ClassFunction G),
      Section1.scalarProduct G η (Finset.sum E f) =
        Finset.sum E (fun θ => Section1.scalarProduct G η (f θ)) := by
    intro E
    induction E using Finset.induction_on with
    | empty => simp [Section1.scalarProduct]
    | @insert θ E hθE ih =>
        intro f η
        simp [Finset.sum_insert hθE, Section5.scalarProduct_add_right, ih]
  rw [hT1, hT2, Section10.scalarProduct_sum_left]
  exact Finset.sum_eq_zero (by
    intro η hη
    rw [hsumRight]
    exact Finset.sum_eq_zero (by
      intro θ hθ
      exact hRorth (hEX hη) (hEY hθ)))


private theorem theorem_11_8_6_coherent_union_of_anchor
    {G : Type u}
    [Group G]
    [Finite G]
    {I J : Type*}
    [Fintype I]
    (M : Subgroup G)
    (S SHC SC S2 : Finset (Section1.ClassFunction M))
    (mu : I → J → Section1.ClassFunction M)
    (tau tau1 tau2 :
      Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (zeta : Section1.ClassFunction M)
    (j : J)
    (d : ℕ)
    (h52 : Section5.hypothesis_5_2_statement S tau)
    (hS2sub : S2 ⊆ S)
    (hSHCsub : SHC ⊆ S)
    (hS2closed : ∀ chi : Section1.ClassFunction M, chi ∈ S2 →
      Section1.conjugateCharacter chi ∈ S2)
    (hSHCclosed : ∀ chi : Section1.ClassFunction M, chi ∈ SHC →
      Section1.conjugateCharacter chi ∈ SHC)
    (hDisjoint : Disjoint S2 SHC)
    (hExt2 : Section7.isCoherentExtension S2 tau tau2)
    (hExt1 : Section7.isCoherentExtension SHC tau tau1)
    (hCross : Section5.orthogonalFinsets (S2.image tau2) (SHC.image tau1))
    (hmu : Section10.muColumn mu j ∈ S2)
    (hPhiSpan : Section5.integerSpan SHC ((d : ℂ) • zeta))
    (hThetaOn : Section1.supportedOn
      (Section10.muColumn mu j - (d : ℂ) • zeta) Section5.puncturedSet)
    (hAnchor :
      tau (Section10.muColumn mu j - (d : ℂ) • zeta) =
        tau2 (Section10.muColumn mu j) - tau1 ((d : ℂ) • zeta))
    (hSCeq : SC = SHC ∪ S2) :
    Section6.coherentFamily SC tau := by
  rw [hSCeq, Finset.union_comm SHC S2]
  exact Section5.bridgeCoherentExtensions
    S S2 SHC tau tau2 tau1 h52 hS2sub hSHCsub hS2closed hSHCclosed
      hDisjoint hExt2 hExt1 hCross hmu hPhiSpan hThetaOn hAnchor

/-- Evaluating a family at a coefficient basis vector selects that family
member. -/
private theorem theorem_11_8_6_evalCoeff_basisVector
    {L : Type u}
    [Group L]
    {K : Type*}
    [Fintype K]
    [DecidableEq K]
    (f : K → Section1.ClassFunction L)
    (k : K) :
    Section1.evalCoeff f (Section1.basisVector k) = f k := by
  ext g
  rw [Section1.evalCoeff, Finset.sum_eq_single k]
  · simp [Section1.basisVector]
  · intro l _hl hlk
    simp [Section1.basisVector, hlk]
  · intro hk
    exact (hk (Finset.mem_univ k)).elim

/-- If every member of `S2` is reducible, PF `(4.9)` gives a simultaneous
coherent extension sending every non-base source column to the corresponding
unsigned omega column. -/
private theorem theorem_11_8_6_all_reducible_extension_with_columns_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (W : Subgroup M)
    (A A0 : Set M)
    (S SHC SC S2 : Finset (Section1.ClassFunction M))
    (i0 : I)
    (j0 : J)
    (mu : I → J → Section1.ClassFunction M)
    (deltaSign : J → ℤ)
    (omega : I → J → Section1.ClassFunction W)
    (sigma : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G)
    (tau : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q u d n : ℕ)
    (delta : ℤ)
    (h11 : hypothesis_11_2_data M MF H U C H0 W1 W2 S tau p q)
    (hNotation :
      Section10.section10FourSixNotationSupportedData
        M W1 W2 W A A0 i0 j0 mu deltaSign omega sigma tau)
    (hSHC : section11Subfamily (H ⊔ C) S SHC)
    (hSC : section11Subfamily C S SC)
    (hS2 : ∀ chi : Section1.ClassFunction M,
      chi ∈ S2 ↔ chi ∈ SC ∧ chi ∉ SHC)
    (hu : u = Nat.card U / Nat.card C)
    (hUniform :
      Section10.uniformMuData W1 W2 j0 mu deltaSign d n delta)
    (hdelta : delta = 1)
    (hAllReducible : ∀ chi : Section1.ClassFunction M, chi ∈ S2 →
      ¬ Section1.IsIrreducibleCharacterOnGroup chi) :
    ∃ tau2 : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G,
      Section7.isCoherentExtension S2 tau tau2 ∧
        ∀ j, j ≠ j0 →
          tau2 (Section10.muColumn mu j) =
            Finset.sum Finset.univ (fun i : I => sigma (omega i j)) := by
  classical
  letI : Fintype M := Fintype.ofFinite M
  have hJgt : 1 < Fintype.card J := by
    rw [← Nat.card_eq_fintype_card, hUniform.2.1]
    exact hUniform.2.2.1.one_lt
  rcases Fintype.exists_ne_of_one_lt_card hJgt j0 with ⟨k, hk⟩
  rcases Section10.supportedFourSixData_of_section10FourSixNotationSupportedData
      hNotation with ⟨sigmaM, xChar, H_A, _H_A0, hSupported⟩
  have hSupportedCopy := hSupported
  rcases hSupportedCopy with
    ⟨_h46, _hW2K, _h31, _hSigmaIso, hSigmaVirt, _hSigmaClass,
      _hSigmaPrincipal, _h22A, hSupportedTail⟩
  rcases hSupportedTail with
    ⟨hOmega, h43b, _h43c, _h43d, h45a, h45b, _hTauCyclic,
      _hTauA0, _hTauIso, _hTauPunct, _hTauVirt, _hPF39Column,
      _hPF39Row, _hPF39Conjugate⟩
  have hContext :=
    Section5.theorem_5_3_b_core_context_of_supported_pf53 M hSupported
  rcases hContext with
    ⟨_h46', _hTauCyclic', _hTauA0', _hTauIso', _hTauPunct',
      _hTauVirt', _h52b, _hOmega', _chi, _hChiOrth, _hChiSigned,
      _hChiSigma, _h43b', _h43c', _h43d', _h45a', _h45b', _h47,
      _h48, h49a, h49b, _h410⟩
  have hSign : ∀ j, j ≠ j0 → (deltaSign j : ℂ) = 1 := by
    intro j hj
    rw [hUniform.2.2.2.2.2.2.2.1 j hj, hdelta]
    norm_num
  have hColumnMem : ∀ j, j ≠ j0 → Section10.muColumn mu j ∈ S2 := by
    intro j hj
    exact theorem_11_8_6_all_nonbase_muColumn_mem_S2_of_hypothesis
      M MF H U C H0 W1 W2 W A A0 S SHC SC S2 i0 j0 mu deltaSign
      omega sigma tau p q u h11 hNotation hSHC hSC hS2 hu j hj
  have hColumnDegree : ∀ j, j ≠ j0 →
      Section1.degree (Section10.muColumn mu j) =
        Section1.degree (Section10.muColumn mu k) := by
    intro j hj
    rw [theorem_11_8_1_degree_muColumn_of_uniform hUniform hj,
      theorem_11_8_1_degree_muColumn_of_uniform hUniform hk]
  let T := Section4Scratch.equalDegreeColumnIndex mu j0 k
  let sourceColumn : T → Section1.ClassFunction M :=
    fun t => Section10.muColumn mu t.1
  let targetColumn : T → Section1.ClassFunction G :=
    fun t => Section4Scratch.omegaColumnSigma sigma omega t.1
  have hS2subS : S2 ⊆ S := by
    intro chi hchi
    exact (hSC.2 chi).mp ((hS2 chi).mp hchi).1 |>.1
  have hIndS2 :
      Section5.inducedFromNonkernelFamily_statement
        (derivedSubgroup M) (derivedSubgroup M) S2 := by
    intro chi hchi
    exact Section10.inducedFromNonkernelFamily_of_hypothesis_10_1_supported_data
      h11.1 chi (hS2subS hchi)
  have hClassify : ∀ X : S2, ∃ j : J, j ≠ j0 ∧
      (X : Section1.ClassFunction M) = Section10.muColumn mu j := by
    intro X
    simpa [Section10.muColumn, Section4Scratch.piColumn] using
      (Section5.theorem_5_3_b_nonbase_piColumn_pf53
        hOmega h43b h45a h45b hIndS2 X
          (hAllReducible (X : Section1.ClassFunction M) X.2))
  let columnToS2 : T → S2 := fun t =>
    ⟨sourceColumn t, hColumnMem t.1 t.2.1⟩
  have hColumnToS2Injective : Function.Injective columnToS2 := by
    intro t1 t2 ht
    apply Subtype.ext
    apply Section5.piColumn_injective_pf58 hOmega h43b
    exact congrArg (fun X : S2 => (X : Section1.ClassFunction M)) ht
  have hColumnToS2Surjective : Function.Surjective columnToS2 := by
    intro X
    rcases hClassify X with ⟨j, hj, hX⟩
    let t : T := ⟨j, hj, hColumnDegree j hj⟩
    refine ⟨t, ?_⟩
    apply Subtype.ext
    exact hX.symm
  let e : T ≃ S2 := Equiv.ofBijective columnToS2
    ⟨hColumnToS2Injective, hColumnToS2Surjective⟩
  have he : ∀ t : T,
      ((e t : S2) : Section1.ClassFunction M) = sourceColumn t := by
    intro t
    rfl
  let P := I × T
  let sourceEntry : P → Section1.ClassFunction M :=
    fun z => mu z.1 z.2.1
  let targetEntry : P → Section1.ClassFunction G :=
    fun z => sigma (omega z.1 z.2.1)
  have hSourceEntryOrth : ∀ z w : P,
      Section1.scalarProduct M (sourceEntry z) (sourceEntry w) =
        if z = w then 1 else 0 := by
    intro z w
    by_cases hzw : z = w
    · subst w
      simp [sourceEntry,
        Section10.scalarProduct_irreducible_self (h43b.2.2.1 z.1 z.2.1)]
    · have hpair : (z.1, z.2.1) ≠ (w.1, w.2.1) := by
        intro hEq
        apply hzw
        apply Prod.ext
        · exact congrArg (fun x : I × J => x.1) hEq
        · apply Subtype.ext
          exact congrArg (fun x : I × J => x.2) hEq
      have hne : sourceEntry z ≠ sourceEntry w := by
        exact h43b.2.2.2.1 (z.1, z.2.1) (w.1, w.2.1) hpair
      simp [hzw, sourceEntry, Section10.scalarProduct_irreducible_ne
        (h43b.2.2.1 z.1 z.2.1) (h43b.2.2.1 w.1 w.2.1) hne]
  have hSourceEntryLI : LinearIndependent ℂ sourceEntry := by
    rw [Fintype.linearIndependent_iff]
    intro a ha z
    have hsumFun :
        (∑ w : P, a w • sourceEntry w) =
          (fun g => ∑ w : P, (a w • sourceEntry w) g) := by
      ext g
      simp
    have hinner :
        Section1.scalarProduct M (∑ w : P, a w • sourceEntry w)
            (sourceEntry z) = 0 := by
      rw [ha]
      simp [Section1.scalarProduct]
    have hcoeff :
        Section1.scalarProduct M (∑ w : P, a w • sourceEntry w)
            (sourceEntry z) = a z := by
      rw [hsumFun, Section1.scalarProduct_fintype_sum_left]
      simp_rw [Section1.scalarProduct_smul_left, hSourceEntryOrth]
      simpa [mul_ite] using (Fintype.sum_ite_eq' z a)
    exact hcoeff ▸ hinner
  let basis := Module.Basis.sumExtend hSourceEntryLI
  have hBasisInl : ∀ z : P, basis (Sum.inl z) = sourceEntry z := by
    intro z
    unfold basis Module.Basis.sumExtend
    rw [Module.Basis.reindex_apply, Module.Basis.extend_apply_self]
    rfl
  let basisImage :
      P ⊕ Module.Basis.sumExtendIndex hSourceEntryLI →
        Section1.ClassFunction G :=
    fun z => Sum.elim targetEntry (fun _ => 0) z
  let tau2 : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G :=
    basis.constr ℂ basisImage
  have hTau2Entry : ∀ z : P, tau2 (sourceEntry z) = targetEntry z := by
    intro z
    calc
      tau2 (sourceEntry z) = tau2 (basis (Sum.inl z)) := by rw [hBasisInl]
      _ = basisImage (Sum.inl z) := basis.constr_basis ℂ basisImage (Sum.inl z)
      _ = targetEntry z := rfl
  have hTau2Column : ∀ t : T, tau2 (sourceColumn t) = targetColumn t := by
    intro t
    rw [show sourceColumn t = ∑ i : I, sourceEntry (i, t) by
      rfl, map_sum]
    change (∑ i : I, tau2 (sourceEntry (i, t))) =
      ∑ i : I, targetEntry (i, t)
    exact Finset.sum_congr rfl (fun i _hi => hTau2Entry (i, t))
  have h49bData := h49b k hk hk
  have hColumnGram : ∀ t s : T,
      Section1.scalarProduct G (targetColumn t) (targetColumn s) =
        Section1.scalarProduct M (sourceColumn t) (sourceColumn s) := by
    intro t s
    have hgram := h49bData.1
      (Section1.basisVector t) (Section1.basisVector s)
    simpa [sourceColumn, targetColumn, hSign k hk,
      theorem_11_8_6_evalCoeff_basisVector, Section10.muColumn,
      Section4Scratch.piColumn] using hgram
  have hLands :=
    Section4Scratch.theorem_4_9_b_lands_in_zIrr
      (derivedSubgroup M) (W1.subgroupOf M) (W2.subgroupOf M) W
      i0 j0 k omega sigmaM sigma mu (fun j => (deltaSign j : ℂ))
      hSigmaVirt hOmega h43b
  have hColumnVirt : ∀ t : T,
      Theory.Character.IsVirtualCharacter (targetColumn t) := by
    intro t
    have hvirt := hLands hk (Section1.basisVector t)
    simpa [targetColumn, hSign k hk,
      theorem_11_8_6_evalCoeff_basisVector] using hvirt
  have hBasisGram : ∀ X Y : S2,
      Section1.scalarProduct G (tau2 X) (tau2 Y) =
        Section1.scalarProduct M X Y := by
    intro X Y
    have hX : (X : Section1.ClassFunction M) = sourceColumn (e.symm X) := by
      simpa using he (e.symm X)
    have hY : (Y : Section1.ClassFunction M) = sourceColumn (e.symm Y) := by
      simpa using he (e.symm Y)
    rw [hX, hY, hTau2Column, hTau2Column]
    exact hColumnGram (e.symm X) (e.symm Y)
