public theorem theorem_11_9_isCyclic_of_nilpotent_cyclic_abelianization
    {U : Type*}
    [Group U]
    [Finite U] :
    Group.IsNilpotent U →
      IsCyclic (U ⧸ commutator U) →
        IsCyclic U := by
  intro hNil hcyc
  classical
  obtain ⟨xbar, hxbar⟩ := IsCyclic.exists_generator (α := U ⧸ commutator U)
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (commutator U) xbar
  let H : Subgroup U := Subgroup.zpowers x
  have hHmap_top : H.map (QuotientGroup.mk' (commutator U)) = ⊤ := by
    apply top_unique
    intro y _hy
    rw [show H.map (QuotientGroup.mk' (commutator U)) =
        Subgroup.zpowers (QuotientGroup.mk' (commutator U) x) by
      simp [H]]
    exact hxbar y
  have hHsup_comm : H ⊔ commutator U = ⊤ := by
    apply top_unique
    intro y _hy
    have hybar : QuotientGroup.mk' (commutator U) y ∈
        H.map (QuotientGroup.mk' (commutator U)) := by
      simp [hHmap_top]
    rcases Subgroup.mem_map.mp hybar with ⟨h, hhH, hhq⟩
    have hzcomm : h⁻¹ * y ∈ commutator U := by
      apply (QuotientGroup.eq_one_iff (N := commutator U) (x := h⁻¹ * y)).1
      calc
        QuotientGroup.mk' (commutator U) (h⁻¹ * y)
            = (QuotientGroup.mk' (commutator U) h)⁻¹ *
                QuotientGroup.mk' (commutator U) y := by simp
        _ = 1 := by simp [hhq]
    exact (Subgroup.mem_sup_of_normal_right (s := H) (t := commutator U) (x := y)).2
      ⟨h, hhH, h⁻¹ * y, hzcomm, by simp⟩
  have hHtop : H = ⊤ := by
    by_contra hHne
    rcases eq_top_or_exists_le_coatom H with htop | ⟨K, hKcoatom, hHK⟩
    · exact hHne htop
    · have hKnorm : K.Normal := by
        haveI : Group.IsNilpotent U := hNil
        exact Subgroup.NormalizerCondition.normal_of_coatom K
          (Group.normalizerCondition_of_isNilpotent (G := U)) hKcoatom
      letI : K.Normal := hKnorm
      have hsimple : IsSimpleGroup (U ⧸ K) := by
        let e : Subgroup (U ⧸ K) ≃o Set.Ici K := QuotientGroup.comapMk'OrderIso K
        have hsimpleOrder : IsSimpleOrder (Set.Ici K) :=
          (Set.isSimpleOrder_Ici_iff_isCoatom (a := K)).2 hKcoatom
        letI : IsSimpleOrder (Set.Ici K) := hsimpleOrder
        letI : IsSimpleOrder (Subgroup (U ⧸ K)) := e.isSimpleOrder
        refine {
          toNontrivial := ?_
          eq_bot_or_eq_top_of_normal := ?_
        }
        · rw [QuotientGroup.nontrivial_iff]
          exact hKcoatom.1
        · intro L _
          simpa using (show L = ⊥ ∨ L = ⊤ from eq_bot_or_eq_top L)
      have hNilQuot : Group.IsNilpotent (U ⧸ K) := by
        haveI : Group.IsNilpotent U := hNil
        infer_instance
      letI : IsSimpleGroup (U ⧸ K) := hsimple
      letI : Group.IsNilpotent (U ⧸ K) := hNilQuot
      have hcommQuot : Std.Commutative (· * · : U ⧸ K → U ⧸ K → U ⧸ K) := by
        infer_instance
      have hcommQuot' : IsMulCommutative (U ⧸ K) := { is_comm := hcommQuot }
      have hcomm_le_K : commutator U ≤ K := by
        rw [← Subgroup.Normal.quotient_commutative_iff_commutator_le (N := K)]
        exact hcommQuot'
      have htop_le_K : (⊤ : Subgroup U) ≤ K := by
        rw [← hHsup_comm]
        exact sup_le hHK hcomm_le_K
      exact hKcoatom.1 (eq_top_iff.mpr htop_le_K)
  rw [isCyclic_iff_exists_zpowers_eq_top]
  exact ⟨x, hHtop⟩


/-- In case `(9.7.b)`, PF `(11.6)` identifies the kernel `C` with `U'`.
The cyclic quotient supplied by `(9.7.b)` is therefore the abelianization of
the nilpotent Type-P complement, which is cyclic only when the complement
itself is cyclic. -/
public theorem theorem_11_9_complement_isCyclic_of_case_b
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q u : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.case_9_7_b_data M MF U W1 W2 H0 C p q u →
        IsCyclic U := by
  intro h11 hcaseB
  have h11Full := h11
  rcases theorem_11_6 M MF H U C H0 W1 W2 S τ p q h11 with
    ⟨_hHp, _hUcentH0, _hH0eq, hCeqDerU⟩
  rcases hcaseB with
    ⟨_h92, _hH0MF, _hCentIn, _hpprime, _hqprime, _hpdata, _hcard,
      _hcentBy, hcyclicQuot, _hirr, _hfield, _hcop, _hdiv⟩
  rcases hcyclicQuot with ⟨_hCU, _hCnormal, hcycQuot, _hcardQuot⟩
  have hCsub_eq : C.subgroupOf U = commutator U := by
    subst C
    simpa [derivedSubgroup, derivedSeries_one, _root_.commutator] using
      (section12_ambientDerivedSubgroup_subgroupOf_eq (G := G) (E := U))
  let e : U ⧸ C.subgroupOf U ≃* U ⧸ commutator U :=
    QuotientGroup.quotientMulEquivOfEq hCsub_eq
  have hcycAb : IsCyclic (U ⧸ commutator U) := e.isCyclic.mp hcycQuot
  have hPDef : Section8.typePDefinitionData M MF U W1 W2 :=
    theorem_11_typePDefinitionData_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11Full
  rcases hPDef with
    ⟨_hMF, _hW1cyc, _hW1ne, _hW1Hall, _hMcomp, _hUleDer, hUnil,
      _hW1norm, _hDerComp, _hMFnoncyc, _hSecond, _hFit, _hFitLe,
      _hW2le, _hW2cyc, _hW2ne, _hCent, _hNorm⟩
  exact theorem_11_9_isCyclic_of_nilpotent_cyclic_abelianization
    hUnil hcycAb

