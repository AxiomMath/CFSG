/-- The source factor `|HU:HC|` is `|U/C|`. -/
private theorem theorem_11_5_relIndex_HC_ambientDerived_eq_card_U_div_card_C
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      (H ⊔ C).relIndex (ambientDerivedSubgroup M) =
        Nat.card U / Nat.card C := by
  intro h11
  let D : Subgroup G := ambientDerivedSubgroup M
  have hDleM : D ≤ M := by
    dsimp [D]
    exact section12_ambientDerivedSubgroup_le (E := M)
  have hsub :
      ((H ⊔ C).subgroupOf M).relIndex (D.subgroupOf M) =
        (H ⊔ C).relIndex D := by
    exact Subgroup.relIndex_subgroupOf (H := H ⊔ C) (K := D) (L := M) hDleM
  have hinternal :
      ((H ⊔ C).subgroupOf M).relIndex (derivedSubgroup M) =
        Nat.card U / Nat.card C :=
    theorem_11_4_relIndex_HC_derived_eq_card_U_div_card_C
      M MF H U C H0 W1 W2 S τ p q h11
  calc
    (H ⊔ C).relIndex (ambientDerivedSubgroup M)
        = ((H ⊔ C).subgroupOf M).relIndex (D.subgroupOf M) := by
          dsimp [D]
          exact hsub.symm
    _ = ((H ⊔ C).subgroupOf M).relIndex (derivedSubgroup M) := by
          dsimp [D]
          rw [section12_ambientDerivedSubgroup_subgroupOf_eq]
          rfl
    _ = Nat.card U / Nat.card C := hinternal

/-- With `M'' ≤ HC ≤ M'`, the source index splits as
`|M':M''| = |HC:M''| * |M':HC|`. -/
private theorem theorem_11_5_relIndex_secondDerived_ambientDerived_eq_mul
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex
          (ambientDerivedSubgroup M) =
        (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) *
          (Nat.card U / Nat.card C) := by
  intro h11
  let D : Subgroup G := ambientDerivedSubgroup M
  let DD : Subgroup G := ambientDerivedSubgroup D
  let HC : Subgroup G := H ⊔ C
  have hDDHC : DD ≤ HC := by
    dsimp [DD, D, HC]
    exact theorem_11_5_secondDerived_le_HC_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hHCD : HC ≤ D := by
    dsimp [HC, D]
    exact theorem_11_5_HC_le_ambientDerived_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hHCindex : HC.relIndex D = Nat.card U / Nat.card C := by
    dsimp [HC, D]
    exact theorem_11_5_relIndex_HC_ambientDerived_eq_card_U_div_card_C
      M MF H U C H0 W1 W2 S τ p q h11
  calc
    (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex
        (ambientDerivedSubgroup M)
        = DD.relIndex D := rfl
    _ = DD.relIndex HC * HC.relIndex D := by
          exact (Subgroup.relIndex_mul_relIndex DD HC D hDDHC hHCD).symm
    _ = DD.relIndex HC * (Nat.card U / Nat.card C) := by
          rw [hHCindex]

