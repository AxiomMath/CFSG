/-- The exact PF `(2.7)` transfer needed when a source-supported Dade
transform is paired with the principal character. -/
private theorem theorem_11_9_scalarProduct_dade_principal_eq_source
    {G : Type u}
    [Group G]
    [Finite G]
    (A : Set G)
    (L : Subgroup G)
    [Finite L]
    (H : G → Subgroup G)
    (τ : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G)
    (α : Section1.ClassFunction L) :
    (hA : Section2.Hypothesis2 A L H) →
      (∀ α : Section1.ClassFunction L,
        Section2.CFOn L A α →
          τ α = Section2.dadeTransform H hA.subset_L α) →
        Section2.CFOn L A α →
          Section1.scalarProduct G (τ α) (Section1.principalCharacter G) =
            Section1.scalarProduct L α (Section1.principalCharacter L) := by
  intro hA hτ hα
  classical
  have hclassG : Section1.IsClassFunction (Section1.principalCharacter G) := by
    intro x g
    simp [Section1.principalCharacter]
  have hconstant :
      Section2.constantOnDadeCosets A H (Section1.principalCharacter G) := by
    intro a h ha hh
    simp [Section1.principalCharacter]
  have h27 := Section2.proposition_2_7 A L H hA hA.subset_L α
    (Section1.principalCharacter G) hα hclassG
  have htransfer :=
    (h27 (Section1.principalCharacter L)
      (by
        intro x g
        simp [Section1.principalCharacter])
      (by
        intro a ha
        simp [Section2.dadeAveragingFunction, Section1.principalCharacter]
        have hcard_ne : ((Fintype.card (H a) : ℕ) : ℂ) ≠ 0 := by
          exact_mod_cast Fintype.card_ne_zero
        field_simp [hcard_ne]
        rw [← Nat.card_eq_fintype_card (α := H a)]
        exact_mod_cast
          (@Nat.card_eq_fintype_card
            (H (↑(⟨a, hA.subset_L a ha⟩ : L)))
            (Fintype.ofFinite (H (↑(⟨a, hA.subset_L a ha⟩ : L))))))).2
      hconstant
  rw [hτ α hα]
  have h_restrict : subgroupRestriction L (principalCharacter G) = principalCharacter (↥L) := by
    ext x; simp [subgroupRestriction, principalCharacter]
  simpa [h_restrict] using htransfer

