/-- A subgroup strictly below the ambient derived subgroup remains strictly
below the internal derived subgroup after transporting to `M`. -/
private theorem theorem_11_4_subgroupOf_lt_derivedSubgroup_of_lt_ambientDerived
    {G : Type u}
    [Group G]
    (M A : Subgroup G) :
    A < ambientDerivedSubgroup M →
      A.subgroupOf M < derivedSubgroup M := by
  intro hA_lt_D
  have hA_le_D : A ≤ ambientDerivedSubgroup M := hA_lt_D.le
  have hA_le_K : A.subgroupOf M ≤ derivedSubgroup M :=
    theorem_11_3_subgroupOf_le_derivedSubgroup_of_le_ambientDerived M A hA_le_D
  refine lt_of_le_of_ne hA_le_K ?_
  intro hEq
  have hD_le_A : ambientDerivedSubgroup M ≤ A := by
    intro x hxD
    have hxM : x ∈ M := section12_ambientDerivedSubgroup_le (E := M) hxD
    have hxK : (⟨x, hxM⟩ : M) ∈ derivedSubgroup M := by
      rw [← section12_ambientDerivedSubgroup_subgroupOf_eq]
      exact hxD
    have hxA_sub : (⟨x, hxM⟩ : M) ∈ A.subgroupOf M := by
      simpa [hEq] using hxK
    exact Subgroup.mem_subgroupOf.mp hxA_sub
  exact hA_lt_D.not_ge hD_le_A

/-- In the `(11.4)` substitution, `H₀C` is strictly contained in `HC`.

The strictness is the nontriviality of the chief quotient `H/H₀`, transported
through the disjoint product with `C`. -/
private theorem theorem_11_4_H0C_subgroupOf_lt_HC_subgroupOf_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      (H0 ⊔ C).subgroupOf M < (H ⊔ C).subgroupOf M := by
  intro h11
  have hH0H : H0 ≤ H :=
    theorem_11_3_H0_le_H_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hBD : (H0 ⊔ C).subgroupOf M ≤ (H ⊔ C).subgroupOf M :=
    theorem_11_3_H0C_subgroupOf_le_HC_subgroupOf M H C H0 hH0H
  refine lt_of_le_of_ne hBD ?_
  intro hEq
  rcases h11 with
    ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
      _hp, hquot, _hchief, _hcomm, _hpW2, _hqW1⟩
  rcases hquot with ⟨hH0normH, hquotNontrivial, _hquotElementary⟩
  letI : (H0.subgroupOf H).Normal := hH0normH
  have hleft :
      ((H0 ⊔ C).subgroupOf M).relIndex ((H ⊔ C).subgroupOf M) =
        Nat.card (H ⧸ H0.subgroupOf H) :=
    theorem_11_3_relIndex_subgroupOf_eq_quotient_card_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q
      (by
        exact ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
          _hp, ⟨hH0normH, hquotNontrivial, _hquotElementary⟩,
          _hchief, _hcomm, _hpW2, _hqW1⟩)
  have hDleB : (H ⊔ C).subgroupOf M ≤ (H0 ⊔ C).subgroupOf M := by
    simp [hEq]
  have hrel_one :
      ((H0 ⊔ C).subgroupOf M).relIndex ((H ⊔ C).subgroupOf M) = 1 :=
