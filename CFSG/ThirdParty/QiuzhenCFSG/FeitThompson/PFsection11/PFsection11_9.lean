  have hu_eq : u = Nat.card U / Nat.card C :=
    theorem_11_quotientBarUCardinality_eq_card_div U C u hBarU
  exact ⟨u, hu_gt, hq_dvd, (hparameter_eq a hcaseA hpairing).trans hu_eq.symm⟩

