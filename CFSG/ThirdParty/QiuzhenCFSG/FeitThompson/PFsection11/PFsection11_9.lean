      M MF H U C H0 W1 W2 S SHC τ p q h11 hSHCdd
  have hAnorm : A.Normal := by
    dsimp [A]
    exact (theorem_11_5_secondDerived_normalIn_M M).2
  letI : A.Normal := hAnorm
  haveI : K.Normal := by
    dsimp [K]
    infer_instance
  have hDDnorm :
