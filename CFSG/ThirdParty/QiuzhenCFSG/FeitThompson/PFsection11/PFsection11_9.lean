  rcases h52active with ⟨hsetup, _R, h52a, _h52b, _h52c, _h52d, _h52e⟩
  have hmuQuBar := h52a ⟨muQu, hmuQu⟩
  have hSpanNonempty :
      Section5.integerSpanOnNonempty SH0C Section5.puncturedSet :=
    Section5.integerSpanOnNonempty_of_conjugate_pair
      hmuQu hmuQuBar.1 hmuQuBar.2 (hsetup.2 ⟨muQu, hmuQu⟩)
  exact Section6.coherentFamily_mono hActiveSub hSpanNonempty hPrimeCoherent


private theorem theorem_11_9_case_a_exists_nonbase_muColumn_mem_reducible_family
    {G : Type u}
    [Group G]
    [Finite G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (W : Subgroup M)
    (A A0 : Set M)
    (S SH0 R : Finset (Section1.ClassFunction M))
    (i0 : I)
    (j0 : J)
    (μ : I → J → Section1.ClassFunction M)
    (δSign : J → ℤ)
    (ω : I → J → Section1.ClassFunction W)
    (σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G)
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q u : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section10.section10FourSixNotationSupportedData M W1 W2 W A A0 i0 j0 μ δSign ω σ τ →
        Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 →
          R.card = p - 1 →
            Section9.reducibleCharacterSubfamilyData M SH0 R (q * u) →
              ∃ j : J, j ≠ j0 ∧ Section10.muColumn μ j ∈ R := by
  classical
  intro h11 hNotation hSH0 hRcard hRdata
  have h10 := h11.1
  have hp : Nat.Prime p := h11.2.2.2.2.2.2.2.2.1
  have hpW2 : p = Nat.card W2 := h11.2.2.2.2.2.2.2.2.2.2.2.2.1
  have hJcard : Nat.card J = Nat.card W2 :=
    Section10.uniformMu_card_J_eq_card_W2_of_hypothesis_10_1_supported_data h10 hNotation
  rcases Section10.supportedFourSixData_of_section10FourSixNotationSupportedData hNotation with
    ⟨σM, xChar, _H_A, _H_A0, hFull⟩
  rcases hFull with
    ⟨h46, _hW2K, _h31, _hIso, _hVirt, _hClass, _hPrin, _h22A,
      hFullRest⟩
  rcases hFullRest with
    ⟨hω, h43b, _h43c, _h43d, h45a, h45b, _hTauCyc, _hTauA0,
      _hTauIso, _hTauPunct, _hTauVirt, _hAmbientColumn⟩
  have hInd :
      Section5.inducedFromNonkernelFamily_statement
        (derivedSubgroup M) (derivedSubgroup M) S :=
    Section10.inducedFromNonkernelFamily_of_hypothesis_10_1_supported_data h10
  let RedS : Finset (Section1.ClassFunction M) :=
    S.filter fun χ => ¬ Section1.IsIrreducibleCharacterOnGroup χ
  let Columns : Finset (Section1.ClassFunction M) :=
    (Finset.univ.erase j0).image (Section10.muColumn μ)
  have hRedSsubColumns : RedS ⊆ Columns := by
    intro χ hχ
    have hχpair :
