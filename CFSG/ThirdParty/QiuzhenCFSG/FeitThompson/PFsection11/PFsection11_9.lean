    intro x hx
    exact hMFleD hx
  refine isHallSubgroup_of (G := D) (π := subgroupPrimeSet MF)
    (H := MF.subgroupOf D) ?_ ?_
  · intro p hp
    have hpMF : p.val ∣ Nat.card MF := by
      rw [hMFcardD] at hp
      exact hp
    have hpM : p.val ∣ Nat.card (MF.subgroupOf M) := by
      rw [hMFcardM]
      exact hpMF
    exact hMFHallM.p_in_pi_of_p_dvd_card p
