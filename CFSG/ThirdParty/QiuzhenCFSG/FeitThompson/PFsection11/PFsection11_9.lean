/-- Finite-sum algebra for the displayed PF `(11.9)(a)` norm expression.

If the base coefficient is `1`, the coefficient matrix satisfies the PF `(3.7)`
rectangle relation, and both non-base axes are constant, then the displayed
four-term norm expression is bounded by the total coefficient norm. -/
private theorem theorem_11_9_axis_displayed_norm_bound_of_total_coeff_bound
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (a : I → J → ℂ)
    (i0 i1 : I)
    (j0 j1 : J)
    (p q : ℕ) :
    i1 ≠ i0 →
      j1 ≠ j0 →
        Fintype.card I = q →
          Fintype.card J = p →
            a i0 j0 = 1 →
              (∀ i i' j j', a i j + a i' j' = a i j' + a i' j) →
                (∀ i, i ≠ i0 → a i j0 = a i1 j0) →
                  (∀ j, j ≠ j0 → a i0 j = a i0 j1) →
                    (∑ x : I × J, Complex.normSq (a x.1 x.2)) ≤ (q : ℝ) →
                      1 + ((q - 1 : ℕ) : ℝ) * Complex.normSq (a i1 j0) +
                          ((p - 1 : ℕ) : ℝ) * Complex.normSq (a i0 j1) +
                          (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) *
                            Complex.normSq (a i1 j1) ≤
                        (q : ℝ) := by
  intro _hi1 _hj1 hIcard hJcard hbase hrect hcolConst hrowConst htotal
  classical
  let f : I → J → ℝ := fun i j => Complex.normSq (a i j)
  have hcellConst : ∀ i j, i ≠ i0 → j ≠ j0 → a i j = a i1 j1 := by
    intro i j hi hj
    have hseed : a i1 j1 + 1 = a i1 j0 + a i0 j1 := by
      simpa [hbase] using hrect i1 i0 j1 j0
    have hcell : a i j + 1 = a i1 j0 + a i0 j1 := by
      simpa [hbase, hcolConst i hi, hrowConst j hj] using hrect i i0 j j0
    have h := hcell.trans hseed.symm
    have h' := congrArg (fun z : ℂ => z - 1) h
    ring_nf at h'
    exact h'
  have hpair_sum :
      (∑ x : I × J, Complex.normSq (a x.1 x.2)) = ∑ i : I, ∑ j : J, f i j := by
    dsimp [f]
    rw [← Finset.univ_product_univ]
    rw [Finset.sum_product]
  have hsplit_inner : ∀ i : I,
      (∑ j : J, f i j) = (Finset.univ.erase j0).sum (fun j => f i j) + f i j0 := by
    intro i
    have h := Finset.sum_erase_add (s := (Finset.univ : Finset J))
      (f := fun j => f i j) (a := j0) (by simp)
    exact h.symm
  have hsplit_outer :
      (∑ i : I, ∑ j : J, f i j) =
        (∑ j : J, f i0 j) +
          (Finset.univ.erase i0).sum (fun i => ∑ j : J, f i j) := by
    have h := Finset.sum_erase_add (s := (Finset.univ : Finset I))
      (f := fun i => ∑ j : J, f i j) (a := i0) (by simp)
    rw [← h]
    abel
  have hsum_expand :
      (∑ i : I, ∑ j : J, f i j) =
        f i0 j0 +
          (Finset.univ.erase j0).sum (fun j => f i0 j) +
          (Finset.univ.erase i0).sum (fun i => f i j0) +
          (Finset.univ.erase i0).sum (fun i =>
            (Finset.univ.erase j0).sum (fun j => f i j)) := by
    rw [hsplit_outer]
    rw [hsplit_inner i0]
    simp_rw [hsplit_inner]
    rw [Finset.sum_add_distrib]
    abel
  have hcardIerase : (Finset.univ.erase i0).card = q - 1 := by
    rw [Finset.card_erase_of_mem (by simp : i0 ∈ (Finset.univ : Finset I))]
    simp [hIcard]
  have hcardJerase : (Finset.univ.erase j0).card = p - 1 := by
    rw [Finset.card_erase_of_mem (by simp : j0 ∈ (Finset.univ : Finset J))]
    simp [hJcard]
  have hcolSum :
      (Finset.univ.erase i0).sum (fun i => f i j0) =
        ((q - 1 : ℕ) : ℝ) * Complex.normSq (a i1 j0) := by
    calc
      (Finset.univ.erase i0).sum (fun i => f i j0) =
          (Finset.univ.erase i0).sum (fun _i => Complex.normSq (a i1 j0)) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            have hine : i ≠ i0 := (Finset.mem_erase.mp hi).1
            simp [f, hcolConst i hine]
      _ = ((Finset.univ.erase i0).card : ℝ) * Complex.normSq (a i1 j0) := by
            simp [Finset.sum_const, nsmul_eq_mul]
      _ = ((q - 1 : ℕ) : ℝ) * Complex.normSq (a i1 j0) := by
            rw [hcardIerase]
  have hrowSum :
      (Finset.univ.erase j0).sum (fun j => f i0 j) =
        ((p - 1 : ℕ) : ℝ) * Complex.normSq (a i0 j1) := by
    calc
      (Finset.univ.erase j0).sum (fun j => f i0 j) =
          (Finset.univ.erase j0).sum (fun _j => Complex.normSq (a i0 j1)) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            have hjne : j ≠ j0 := (Finset.mem_erase.mp hj).1
            simp [f, hrowConst j hjne]
      _ = ((Finset.univ.erase j0).card : ℝ) * Complex.normSq (a i0 j1) := by
            simp [Finset.sum_const, nsmul_eq_mul]
      _ = ((p - 1 : ℕ) : ℝ) * Complex.normSq (a i0 j1) := by
            rw [hcardJerase]
  have hblockSum :
      (Finset.univ.erase i0).sum (fun i =>
            (Finset.univ.erase j0).sum (fun j => f i j)) =
        (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) * Complex.normSq (a i1 j1) := by
    calc
      (Finset.univ.erase i0).sum (fun i =>
            (Finset.univ.erase j0).sum (fun j => f i j)) =
          (Finset.univ.erase i0).sum (fun i =>
            (Finset.univ.erase j0).sum (fun _j => Complex.normSq (a i1 j1))) := by
            refine Finset.sum_congr rfl ?_
            intro i hi
            refine Finset.sum_congr rfl ?_
            intro j hj
            have hine : i ≠ i0 := (Finset.mem_erase.mp hi).1
            have hjne : j ≠ j0 := (Finset.mem_erase.mp hj).1
            simp [f, hcellConst i j hine hjne]
      _ = ((Finset.univ.erase i0).card : ℝ) *
            (((Finset.univ.erase j0).card : ℝ) * Complex.normSq (a i1 j1)) := by
            simp [Finset.sum_const, nsmul_eq_mul]
      _ = (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) *
            Complex.normSq (a i1 j1) := by
            rw [hcardIerase, hcardJerase, Nat.cast_mul]
            ring
  have hdisplay_le_total :
      1 + ((q - 1 : ℕ) : ℝ) * Complex.normSq (a i1 j0) +
          ((p - 1 : ℕ) : ℝ) * Complex.normSq (a i0 j1) +
          (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) *
            Complex.normSq (a i1 j1) ≤
        ∑ x : I × J, Complex.normSq (a x.1 x.2) := by
    rw [hpair_sum, hsum_expand, hrowSum, hcolSum, hblockSum]
    dsimp [f]
    rw [hbase]
    norm_num [Complex.normSq]
    ring_nf
    exact le_rfl
  exact le_trans hdisplay_le_total htotal

/-- Orthonormal weighted sums have norm-square equal to the sum of coefficient
norm-squares. This is the finite Hilbert-space calculation used to read the PF
`(11.9)(a)` projected norm as a coefficient sum. -/
private theorem theorem_11_9_cfNormSq_weightedFamilySum_orthonormal_eq_sum_normSq
    {G ι : Type*}
    [Group G]
    [Finite G]
    [Fintype ι]
    [DecidableEq ι]
    (w : ι → ℂ)
    (χ : ι → Section1.ClassFunction G)
    (horth : ∀ i j : ι,
      Section1.scalarProduct G (χ i) (χ j) = if i = j then 1 else 0) :
    Section5.cfNormSq (Section1.weightedFamilySum w χ) =
      ∑ i : ι, Complex.normSq (w i) := by
  classical
  have hself :
      Section1.scalarProduct G (Section1.weightedFamilySum w χ)
          (Section1.weightedFamilySum w χ) =
        ∑ i : ι, star (w i) * w i := by
    calc
      Section1.scalarProduct G (Section1.weightedFamilySum w χ)
          (Section1.weightedFamilySum w χ)
          = ∑ i : ι, star (w i) *
              Section1.scalarProduct G (Section1.weightedFamilySum w χ) (χ i) := by
            have huniv :
                @Finset.univ ι (Fintype.ofFinite ι) = (Finset.univ : Finset ι) := by
              ext i
              simp
            simpa [huniv] using
              Section1.scalarProduct_weightedFamilySum_right
                (Section1.weightedFamilySum w χ) w χ
      _ = ∑ i : ι, star (w i) * w i := by
            refine Finset.sum_congr rfl ?_
            intro i _hi
            rw [Section1.scalarProduct_weightedFamilySum_left_orthonormal w χ horth i]
  unfold Section5.cfNormSq
  rw [hself, Complex.re_sum]
  refine Finset.sum_congr rfl ?_
  intro i _hi
  have hnorm : star (w i) * w i = ((Complex.normSq (w i) : ℝ) : ℂ) := by
    simp [Complex.normSq_eq_conj_mul_self]
  rw [hnorm]
  simp

/-- Equality of two finite orthonormal expansions identifies their
coefficients. This is the formal extraction step needed after the PF
`(11.9)(a)` Galois argument gives equality of projected sums. -/
private theorem theorem_11_9_weightedFamilySum_coeff_eq_of_orthonormal
    {G ι : Type*}
    [Group G]
    [Finite G]
    [Fintype ι]
    [DecidableEq ι]
    (w v : ι → ℂ)
    (χ : ι → Section1.ClassFunction G)
