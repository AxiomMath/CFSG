    {σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G}
    {τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G}
    (hNotation :
      Section10.section10FourSixNotationSupportedData M W1 W2 W A A0 i0 j0 μ δSign ω σ τ)
    (Y : Section1.ClassFunction G)
    (q : ℕ) :
    Section5.cfNormSq Y = (q : ℝ) + 1 →
      1 ≤
        Section5.cfNormSq
          (Y -
            Section1.weightedFamilySum
              (fun x : I × J => Section1.scalarProduct G Y (σ (ω x.1 x.2)))
              (fun x : I × J => σ (ω x.1 x.2))) →
        Section5.cfNormSq
            (Section1.weightedFamilySum
              (fun x : I × J => Section1.scalarProduct G Y (σ (ω x.1 x.2)))
              (fun x : I × J => σ (ω x.1 x.2))) ≤
          (q : ℝ) := by
  classical
  let χ : I × J → Section1.ClassFunction G := fun x => σ (ω x.1 x.2)
  have horth : ∀ x y : I × J,
      Section1.scalarProduct G (χ x) (χ y) = if x = y then 1 else 0 := by
    intro x y
    rcases x with ⟨i, j⟩
    rcases y with ⟨i', j'⟩
    dsimp [χ]
