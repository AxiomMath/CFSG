          have hne : (i0, j) ≠ (i0, k) := by
            intro hpair
            exact hjk (Prod.ext_iff.mp hpair).2
          simp [hne]
        · intro hk
          exact False.elim (hk (Finset.mem_univ k))
      · have hne : ∀ j : J, (i0, j) ≠ (i, k) := by
          intro j hpair
          exact hi (Prod.ext_iff.mp hpair).1
