/-- Any two source Type-P complements for the same maximal subgroup are
conjugate inside its derived subgroup. -/
public theorem theorem_11_exists_conj_eq_of_typeP_complements
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {M MF U W1 W2 V W1' W2' : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G)
    (hU : Section8.typePDefinitionData M MF U W1 W2)
    (hV : Section8.typePDefinitionData M MF V W1' W2') :
    ∃ d : ambientDerivedSubgroup M, U = V.conjBy (d : G) := by
  classical
  let D : Subgroup G := ambientDerivedSubgroup M
  have hall_complement :
      ∀ {X X1 X2 : Subgroup G},
        Section8.typePDefinitionData M MF X X1 X2 →
          IsHallSubgroup (subgroupPrimeSet MF)ᶜ (X.subgroupOf D) := by
    intro X X1 X2 hX
    rcases hX with
      ⟨hMF, _hX1cyc, _hX1ne, _hX1Hall, _hMcomp, _hXleD, _hXnil,
        _hX1norm, hCompX, _hMFnoncyc, _hSecond, _hFit, _hFitLe,
        _hX2le, _hX2cyc, _hX2ne, _hCent, _hNorm⟩
    have hDleM : D ≤ M := by
      simpa [D] using
        (section12_ambientDerivedSubgroup_le (G := G) (E := M))
    have hMFHallD :
        IsHallSubgroup (subgroupPrimeSet MF) (MF.subgroupOf D) :=
      theorem_11_6_mf_hallSubgroup_in_intermediate hMF
        (by simpa [D] using hCompX.1) hDleM
    have hMFnormD : section10NormalIn MF D := by
      rcases hMF with
        ⟨⟨hMFM, hMFnormM, _hMFnil, _hMFHallM⟩, _hMFmax⟩
      have hMFleD : MF ≤ D := by simpa [D] using hCompX.1
      refine ⟨hMFleD, ?_⟩
      have hMleNorm : M ≤ Subgroup.normalizer (MF : Set G) :=
        (Subgroup.normal_subgroupOf_iff_le_normalizer hMFM).1 hMFnormM
      exact (Subgroup.normal_subgroupOf_iff_le_normalizer hMFleD).2
        (hDleM.trans hMleNorm)
    have hCompLocal :
        (MF.subgroupOf D).IsComplement' (X.subgroupOf D) :=
      theorem_11_3_complementIn_left_normal_isComplement'
        (by simpa [D] using hCompX) hMFnormD
    exact section16_complement_isHall_compl_of_isHall hMFHallD hCompLocal
  have hUHallD :
      IsHallSubgroup (subgroupPrimeSet MF)ᶜ (U.subgroupOf D) :=
    hall_complement hU
  have hVHallD :
      IsHallSubgroup (subgroupPrimeSet MF)ᶜ (V.subgroupOf D) :=
    hall_complement hV
  have hDleM : D ≤ M := by
    simpa [D] using
      (section12_ambientDerivedSubgroup_le (G := G) (E := M))
  have hDneTop : D ≠ ⊤ := by
    intro hDtop
    apply hM.1
    apply top_unique
    intro x _hx
    exact hDleM (by simp [hDtop])
  have hDsolv : Group.IsSolvable D :=
    IsMinCE.proper_subgroups_solvable D (lt_top_iff_ne_top.2 hDneTop)
  rcases exists_conj_eq_of_isHallSubgroup_of_solvable
      (G := D) hDsolv
      (π := (subgroupPrimeSet MF)ᶜ)
      (H₁ := V.subgroupOf D) (H₂ := U.subgroupOf D)
      hVHallD hUHallD with
    ⟨d, hd⟩
  have hUD : U ≤ D := by
    rcases hU with
      ⟨_hMF, _hW1cyc, _hW1ne, _hW1Hall, _hMcomp, _hUleD, _hUnil,
        _hW1norm, hCompU, _hMFnoncyc, _hSecond, _hFit, _hFitLe,
        _hW2le, _hW2cyc, _hW2ne, _hCent, _hNorm⟩
    simpa [D] using hCompU.2.1
  have hVD : V ≤ D := by
    rcases hV with
      ⟨_hMF, _hW1cyc, _hW1ne, _hW1Hall, _hMcomp, _hVleD, _hVnil,
        _hW1norm, hCompV, _hMFnoncyc, _hSecond, _hFit, _hFitLe,
        _hW2le, _hW2cyc, _hW2ne, _hCent, _hNorm⟩
    simpa [D] using hCompV.2.1
  refine ⟨d, ?_⟩
  ext x
  constructor
  · intro hxU
    have hxloc : (⟨x, hUD hxU⟩ : D) ∈ U.subgroupOf D := by
      simpa [Subgroup.mem_subgroupOf] using hxU
    rw [hd] at hxloc
    rcases Subgroup.mem_map.mp hxloc with ⟨y, hyVloc, hyx⟩
    have hyV : (y : G) ∈ V := by
      simpa [Subgroup.mem_subgroupOf] using hyVloc
    exact Subgroup.mem_map.mpr ⟨(y : G), hyV, by
      have hyxG := congrArg Subtype.val hyx
      simpa [MulAut.conj_apply] using hyxG⟩
  · intro hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hyV, hyx⟩
    have hyD : y ∈ D := hVD hyV
    have hxD : x ∈ D := by
      rw [← hyx]
      exact D.mul_mem (D.mul_mem d.property hyD) (D.inv_mem d.property)
    have hxloc : (⟨x, hxD⟩ : D) ∈ U.subgroupOf D := by
      rw [hd]
      refine Subgroup.mem_map.mpr ⟨(⟨y, hyD⟩ : D), ?_, ?_⟩
      · simpa [Subgroup.mem_subgroupOf] using hyV
      · apply Subtype.ext
        simpa [MulAut.conj_apply] using hyx
    simpa [Subgroup.mem_subgroupOf] using hxloc

/-- The source Type-P data selected in Types III and IV satisfies PF
Hypothesis `(9.2)`. The branch conclusions are transported from the canonical
PF `(8.8)` complements by Hall conjugacy inside `M'`. -/
public theorem theorem_11_hypothesis_9_2_of_typeP_typeIIIIV
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {M MF U W1 W2 : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G)
    (hMF : section16MFSubgroup M MF)
    (hP : Section8.typePDefinitionData M MF U W1 W2)
    (hCond : Section8.typeIIToIVSourceCondition M U W1)
    (hLate : section16TypeIII M MF ∨ section16TypeIV M MF) :
    Section9.hypothesis_9_2_statement M MF U W1 W2 (Nat.card W1) := by
  classical
  have hTypeP : Section8.typePData M MF U W1 W2 :=
    ⟨hMF, Section8.section16TypeCommon_of_source_typeP_with_T6 hP
      (Section8.sourceTypeP_T6_of_source_typeP hM hMF hP)⟩
  have comm_of_eq_conjBy :
      ∀ {A B : Subgroup G} {d : G},
        A = B.conjBy d → IsMulCommutative B → IsMulCommutative A := by
    intro A B d hEq hcomm
    subst A
    apply Subgroup.map_isMulCommutative
  have not_comm_of_eq_conjBy :
      ∀ {A B : Subgroup G} {d : G},
        A = B.conjBy d → ¬ IsMulCommutative B → ¬ IsMulCommutative A := by
    intro A B d hEq hncomm hcommA
    have hBeq : B = A.conjBy d⁻¹ := by
      rw [hEq]
      exact (Subgroup.conjBy_inv B d).symm
    exact hncomm (comm_of_eq_conjBy hBeq hcommA)
  have normalizer_le_of_conjBy_eq :
      ∀ {A B : Subgroup G} {d : G},
        d ∈ M → B = A.conjBy d →
          Subgroup.normalizer (B : Set G) ≤ M →
            Subgroup.normalizer (A : Set G) ≤ M := by
    intro A B d hdM hEq hNormB n hn
    let a : G := d * n * d⁻¹
    have hAn : A.conjBy n = A :=
      section11_conjBy_eq_of_mem_normalizer (G := G) hn
    have haNormB : a ∈ Subgroup.normalizer (B : Set G) := by
      apply section10_mem_normalizer_of_conjBy_eq (G := G)
      calc
        B.conjBy a = (A.conjBy d).conjBy a := by rw [hEq]
        _ = A.conjBy (a * d) := Subgroup.conjBy_conjBy A d a
        _ = A.conjBy (d * n) := by
          congr 1
          simp [a, mul_assoc]
        _ = (A.conjBy n).conjBy d :=
          (Subgroup.conjBy_conjBy A n d).symm
        _ = A.conjBy d := by rw [hAn]
        _ = B := hEq.symm
    have haM : a ∈ M := hNormB haNormB
    have hn_eq : n = d⁻¹ * a * d := by simp [a, mul_assoc]
    rw [hn_eq]
    exact M.mul_mem (M.mul_mem (M.inv_mem hdM) haM) hdM
  refine
    { maximal := hM
      mf := hMF
      typeP := hTypeP
      typePDefinitionData := hP
      typeIIToIVSourceCondition := hCond
      typeIISource := ?_
      typeIIISource := ?_
      typeIVSource := ?_
      typeCases := Or.inr hLate
      q_eq := rfl }
  · intro hII
    exact False.elim
      (Section8.section16_not_typeIII_or_typeIV_of_typeII hM hMF hII hLate)
  · intro hIII
    rcases Section8.theorem_8_8_typeIII_to_source_public
        (G := G) (M := M) (MF := MF) hM hMF hIII with
      ⟨U', W1', W2', hP', _hCond', hcomm', hnorm'⟩
    rcases theorem_11_exists_conj_eq_of_typeP_complements
        (G := G) (M := M) (MF := MF)
        (U := U) (W1 := W1) (W2 := W2)
        (V := U') (W1' := W1') (W2' := W2') hM hP hP' with
      ⟨d, hUconj⟩
    have hdM : (d : G) ∈ M :=
      (section12_ambientDerivedSubgroup_le (G := G) (E := M)) d.property
    have hU'conj : U' = U.conjBy (d : G)⁻¹ := by
      rw [hUconj]
      exact (Subgroup.conjBy_inv U' (d : G)).symm
    exact ⟨comm_of_eq_conjBy hUconj hcomm',
      normalizer_le_of_conjBy_eq (M.inv_mem hdM) hU'conj hnorm'⟩
  · intro hIV
    rcases Section8.theorem_8_8_typeIV_to_source_public
        (G := G) (M := M) (MF := MF) hM hMF hIV with
      ⟨U', W1', W2', hP', _hCond', hncomm', hnorm'⟩
    rcases theorem_11_exists_conj_eq_of_typeP_complements
        (G := G) (M := M) (MF := MF)
        (U := U) (W1 := W1) (W2 := W2)
        (V := U') (W1' := W1') (W2' := W2') hM hP hP' with
      ⟨d, hUconj⟩
    have hdM : (d : G) ∈ M :=
      (section12_ambientDerivedSubgroup_le (G := G) (E := M)) d.property
    have hU'conj : U' = U.conjBy (d : G)⁻¹ := by
      rw [hUconj]
      exact (Subgroup.conjBy_inv U' (d : G)).symm
    exact ⟨not_comm_of_eq_conjBy hUconj hncomm',
      normalizer_le_of_conjBy_eq (M.inv_mem hdM) hU'conj hnorm'⟩

/-- In the Type-III/IV branch, the selected source Type-P witness determines
the late-case PF `(8.10)` notation with `M_s = M'`. -/
public theorem theorem_11_exists_notation_8_10_source_data_of_typeP_typeIIIIV
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {M MF U W1 W2 : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G)
    (hMF : section16MFSubgroup M MF)
    (hP : Section8.typePDefinitionData M MF U W1 W2)
    (hCond : Section8.typeIIToIVSourceCondition M U W1)
    (hLate : section16TypeIII M MF ∨ section16TypeIV M MF) :
    ∃ A A0 A1 : Set G,
      Section8.notation_8_10_source_data M MF (ambientDerivedSubgroup M)
        A A0 A1 ∧
      Section8.notation_8_10_source_typeP_witness M MF
        (ambientDerivedSubgroup M) A A0 A1 U W1 W2 := by
  classical
  have h92 := theorem_11_hypothesis_9_2_of_typeP_typeIIIIV
    (G := G) hM hMF hP hCond hLate
  have comm_of_eq_conjBy :
      ∀ {A B : Subgroup G} {d : G},
        A = B.conjBy d → IsMulCommutative B → IsMulCommutative A := by
    intro A B d hEq hcomm
    subst A
    apply Subgroup.map_isMulCommutative
  have normalizer_le_of_conjBy_eq :
      ∀ {A B : Subgroup G} {d : G},
        d ∈ M → B = A.conjBy d →
          Subgroup.normalizer (B : Set G) ≤ M →
            Subgroup.normalizer (A : Set G) ≤ M := by
    intro A B d hdM hEq hNormB n hn
    let a : G := d * n * d⁻¹
    have hAn : A.conjBy n = A :=
      section11_conjBy_eq_of_mem_normalizer (G := G) hn
    have haNormB : a ∈ Subgroup.normalizer (B : Set G) := by
      apply section10_mem_normalizer_of_conjBy_eq (G := G)
      calc
        B.conjBy a = (A.conjBy d).conjBy a := by rw [hEq]
        _ = A.conjBy (a * d) := Subgroup.conjBy_conjBy A d a
        _ = A.conjBy (d * n) := by
          congr 1
          simp [a, mul_assoc]
        _ = (A.conjBy n).conjBy d :=
          (Subgroup.conjBy_conjBy A n d).symm
        _ = A.conjBy d := by rw [hAn]
        _ = B := hEq.symm
    have haM : a ∈ M := hNormB haNormB
    have hn_eq : n = d⁻¹ * a * d := by simp [a, mul_assoc]
    rw [hn_eq]
    exact M.mul_mem (M.mul_mem (M.inv_mem hdM) haM) hdM
  have hSelected :
      (Section8.typeIIIDefinitionData M MF ∧
          IsMulCommutative U ∧ Subgroup.normalizer (U : Set G) ≤ M) ∨
        (Section8.typeIVDefinitionData M MF ∧
          ¬ IsMulCommutative U ∧ Subgroup.normalizer (U : Set G) ≤ M) := by
    rcases hLate with hIII | hIV
    · rcases h92.typeIIISource hIII with ⟨hcomm, hnorm⟩
      exact Or.inl ⟨⟨U, W1, W2, hP, hCond, hcomm, hnorm⟩, hcomm, hnorm⟩
    · rcases h92.typeIVSource hIV with ⟨hncomm, hnorm⟩
      exact Or.inr ⟨⟨U, W1, W2, hP, hCond, hncomm, hnorm⟩, hncomm, hnorm⟩
  have hNormU : Subgroup.normalizer (U : Set G) ≤ M :=
    hSelected.elim (fun h => h.2.2) (fun h => h.2.2)
  have hnotI : ¬ Section8.typeIDefinitionData M MF :=
    Section8.not_typeIDefinitionData_of_typeP_source_data hP
  have hnotII : ¬ Section8.typeIIDefinitionData M MF := by
    rintro ⟨V, V1, V2, _U1, _U0, hPV, _hVCond, _hVcomm, hVnotNorm, _hF⟩
    rcases theorem_11_exists_conj_eq_of_typeP_complements
        (G := G) (M := M) (MF := MF)
        (U := V) (W1 := V1) (W2 := V2)
