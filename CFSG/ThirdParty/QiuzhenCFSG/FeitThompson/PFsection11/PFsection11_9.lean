  have hH0leD : H0 ≤ ambientDerivedSubgroup M := hSH0.1
  let SH0C : Finset (Section1.ClassFunction M) :=
    Section9.kernelInducedSubfamily_sec9
      M (ambientDerivedSubgroup M) MF (H0 ⊔ C) SH0
