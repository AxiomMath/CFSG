  let Dsub : Subgroup M := D.subgroupOf M
  have hMFcardM : Nat.card (MF.subgroupOf M) = Nat.card MF :=
    natCard_subgroupOf_eq MF M hMFM
  have hMFcardD : Nat.card (MF.subgroupOf D) = Nat.card MF :=
    natCard_subgroupOf_eq MF D hMFleD
