  · intro φ ψ hφ hψ
    exact h52b.1 φ ψ
      ⟨theorem_11_5_integerSpan_mono hsub hφ.1, hφ.2⟩
      ⟨theorem_11_5_integerSpan_mono hsub hψ.1, hψ.2⟩
  · intro χ hχ
    exact h52b.2 χ ⟨theorem_11_5_integerSpan_mono hsub hχ.1, hχ.2⟩

/-- PF `(5.2)` descends to a nonempty conjugation-closed subfamily. -/
private theorem theorem_11_5_hypothesis_5_2_statement_subset
    {L : Type u} [Group L] [Finite L]
    {G : Type u} [Group G] [Finite G]
    {S1 S : Finset (Section1.ClassFunction L)}
    {T : Section1.ClassFunction L →ₗ[ℂ] Section1.ClassFunction G}
    (hsub : S1 ⊆ S)
    (hne : S1.Nonempty)
    (hclosed : ∀ χ : Section1.ClassFunction L,
      χ ∈ S1 → Section1.conjugateCharacter χ ∈ S1) :
    Section5.hypothesis_5_2_statement S T →
      Section5.hypothesis_5_2_statement S1 T := by
  intro h52
  rcases h52 with ⟨hsetup, R, h52a, h52b, h52c, h52d, h52e⟩
  let R1 : S1 → Finset (Section1.ClassFunction G) := fun X =>
    R ⟨(X : Section1.ClassFunction L), hsub X.property⟩
  refine ⟨?_, R1, ?_, ?_, ?_, ?_, ?_⟩
  · exact ⟨hne, fun X => hsetup.2 ⟨(X : Section1.ClassFunction L), hsub X.property⟩⟩
  · intro X
    exact ⟨hclosed (X : Section1.ClassFunction L) X.property,
      (h52a ⟨(X : Section1.ClassFunction L), hsub X.property⟩).2⟩
  · exact theorem_11_5_hypothesis_5_2_b_subset hsub h52b
  · intro χ ψ hχ hψ hneχψ
    exact h52c (hsub hχ) (hsub hψ) hneχψ
  · intro X
    exact h52d ⟨(X : Section1.ClassFunction L), hsub X.property⟩
  · intro X Y hYX hYXbar
    exact h52e ⟨(X : Section1.ClassFunction L), hsub X.property⟩
      ⟨(Y : Section1.ClassFunction L), hsub Y.property⟩ hYX hYXbar

