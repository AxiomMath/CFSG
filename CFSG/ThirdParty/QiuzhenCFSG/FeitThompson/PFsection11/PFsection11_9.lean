      ∃ SC : Finset (Section1.ClassFunction M),
        ∃ S2 : Finset (Section1.ClassFunction M),
          section11Subfamily C S SC ∧
            (∀ χ : Section1.ClassFunction M, χ ∈ S2 ↔ χ ∈ SC ∧ χ ∉ SHC) ∧
              SC = SHC ∪ S2 := by
