private theorem theorem_11_8_6_all_nonbase_muColumn_mem_S2_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (W : Subgroup M)
    (A A0 : Set M)
    (S SHC SC S2 : Finset (Section1.ClassFunction M))
