                  lam ∈ SH0U →
                    Section1.IsIrreducibleCharacterOnGroup lam →
                      Section1.degree lam = ((q * a : ℕ) : ℂ) →
                        Section1.degree (Section10.muColumn μ j) =
                          ((q * u : ℕ) : ℂ) →
                          a ∣ u →
