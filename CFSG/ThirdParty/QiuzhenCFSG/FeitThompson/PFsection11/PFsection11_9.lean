private theorem theorem_11_exists_transformedIrreducibleFamily
    {G : Type u} [Group G] [Finite G]
    {M : Subgroup G}
    (W : Subgroup M)
    (σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G) :
    ∃ R : Finset (Section1.ClassFunction G),
      transformedIrreducibleFamily R σ := by
  classical
  rcases Theory.Character.exists_completeIrreducibleCharacterFamily_sum_degree_normSq
      (G := W) with
    ⟨ι, hι, χrep, hχrep, _hsum⟩
  letI : Fintype ι := hι
  letI : DecidableEq ι := Classical.decEq ι
  let χ : ι → Section1.ClassFunction W :=
    fun i => Section1.ofConjClassFunction (χrep i)
  have hχirr : ∀ i, Section1.IsIrreducibleCharacterOnGroup (χ i) := by
    intro i
    exact Section10.ofConjClassFunction_isIrreducibleCharacterOnGroup_sec10
      (hχrep.1 i)
  have hχcomplete : ∀ θ : Section1.ClassFunction W,
      Section1.IsIrreducibleCharacterOnGroup θ → ∃ i, χ i = θ := by
    intro θ hθirr
    let θrep : Theory.Character.ConjClassFunction W :=
      Section1.toConjClassFunction θ
        (Section10.isClassFunction_of_irreducibleCharacterOnGroup_sec10 hθirr)
    have hθrepirr : Theory.Character.IsIrreducibleConjCharacter θrep :=
      Section10.toConjClassFunction_isIrreducibleCharacter_of_onGroup_sec10 hθirr
    rcases hχrep.2.1 θrep hθrepirr with ⟨i, hi⟩
    refine ⟨i, ?_⟩
    ext w
    change χrep i (ConjClasses.mk w) = θ w
    rw [hi]
    rfl
  refine ⟨Finset.univ.image (fun i => σ (χ i)), ?_⟩
  intro ψ
  constructor
  · intro hψ
    rcases Finset.mem_image.mp hψ with ⟨i, _hi, rfl⟩
    exact ⟨χ i, hχirr i, rfl⟩
  · rintro ⟨ω, hωirr, rfl⟩
    rcases hχcomplete ω hωirr with ⟨i, hi⟩
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, by rw [hi]⟩

/-- Hypothesis `(11.2)` forces its selected Type-P complement to be cyclic.
This is the cyclic-complement consequence of PF `(11.9)`, case `(9.7.b)`,
and PF `(11.6)` used in the Type-III/IV branch of PF `(12.10)`. -/
public theorem theorem_11_complement_isCyclic_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      IsCyclic U := by
  classical
  intro h11
  have h10 :
      Section10.hypothesis_10_1_supported_data M MF W1 W2 (section16HatW W1 W2) S τ :=
    h11.1
  rcases Section10.exists_section10FourSixNotationSupportedData_of_hypothesis_10_1_supported_data h10 with
    ⟨I, instI, decI, J, instJ, decJ, W, A, A0, i0, j0, μ, δSign,
      ω, σ, hNotation⟩
  letI : Fintype I := instI
  letI : DecidableEq I := decI
  letI : Fintype J := instJ
  letI : DecidableEq J := decJ
  let SHC : Finset (Section1.ClassFunction M) :=
    S.filter fun χ =>
      Section1.subgroupInKernel' χ ((H ⊔ C).subgroupOf M)
  have hHCle : H ⊔ C ≤ M :=
    sup_le
      (theorem_11_3_H_le_M_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q h11)
      (theorem_11_3_C_le_M_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q h11)
  have hSHC : section11Subfamily (H ⊔ C) S SHC := by
    refine ⟨hHCle, ?_⟩
    intro χ
    simp [SHC]
  rcases section11Subfamily_H_sup_C_nonempty_of_hypothesis
      M MF H U C H0 W1 W2 S SHC τ p q h11 hSHC with
    ⟨ζ, hζ⟩
  rcases theorem_11_exists_transformedIrreducibleFamily W σ with
    ⟨R, hR⟩
  rcases theorem_11_9
      M MF H U C H0 W1 W2 W A A0 S SHC R i0 j0 μ δSign ω σ τ ζ p q
      h11 hNotation hSHC hζ hR with
    ⟨_hOrth, _hqgt, ⟨u, _hu, hcaseB⟩, _hTypeIII⟩
  exact theorem_11_9_complement_isCyclic_of_case_b
    M MF H U C H0 W1 W2 S τ p q u h11 hcaseB

/-- The Type-III/IV complement selected by Definition (8.4) is cyclic.

This packages the source route used in PF (12.10): PF (9.4) selects
H0 and its prime, PF (10.1) supplies the supported Dade package, and
PF (11.9) gives the cyclic-complement conclusion. -/
public theorem theorem_11_complement_isCyclic_of_typeP_typeIIIIV
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {M MF U W1 W2 : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G)
    (hMF : section16MFSubgroup M MF)
    (hP : Section8.typePDefinitionData M MF U W1 W2)
    (hCond : Section8.typeIIToIVSourceCondition M U W1)
    (hLate : section16TypeIII M MF ∨ section16TypeIV M MF) :
    IsCyclic U := by
  classical
  have h92 :
      Section9.hypothesis_9_2_statement
        M MF U W1 W2 (Nat.card W1) :=
    theorem_11_hypothesis_9_2_of_typeP_typeIIIIV
      (G := G) hM hMF hP hCond hLate
  rcases Section9.theorem_9_4 M MF U W1 W2 (Nat.card W1) h92 with
    ⟨H0, hp, hho⟩
  rcases hho with
    ⟨hH0MF, hMFM, hH0NormalM, _hH0NormalMF, hH0LtMF, hElem, hTypeData⟩
  rcases hTypeData hLate with ⟨hW2card, hChief, hNotCent⟩
  have hW2prime : Nat.Prime (Nat.card W2) := by
    rw [hW2card]
    exact hp.property
  rcases theorem_11_exists_hypothesis_10_1_supported_of_typeP_typeIIIIV
      (G := G) hM hMF hP hCond hLate hW2prime with
    ⟨S, τ, h10⟩
  have hP' := hP
  rcases hP' with
    ⟨_hMF, _hW1cyc, _hW1ne, _hW1Hall, _hMcomp, hUleD, _hUnil,
      _hW1norm, hDerComp, _hMFnoncyc, _hSecond, _hFit, _hFitLe,
      _hW2le, _hW2cyc, _hW2ne, _hCent, _hNorm⟩
  have hMFleD : MF ≤ ambientDerivedSubgroup M := hDerComp.1
  have hH0M : H0 ≤ M := hH0MF.trans hMFM
  have hNormalIn : section10NormalIn H0 M :=
    ⟨hH0M, hH0NormalM⟩
  rcases hElem with ⟨hH0NormalMF, hElemAbelian⟩
  have hQuot :
      ∃ hH0H : (H0.subgroupOf MF).Normal,
        letI : (H0.subgroupOf MF).Normal := hH0H
        Nontrivial (MF ⧸ H0.subgroupOf MF) ∧
          IsElementaryAbelian hp.val (MF ⧸ H0.subgroupOf MF) := by
    refine ⟨hH0NormalMF, ?_⟩
    letI : (H0.subgroupOf MF).Normal := hH0NormalMF
    constructor
    · have hH0neTop : H0.subgroupOf MF ≠ ⊤ := by
        intro htop
        have hMFleH0 : MF ≤ H0 := (Subgroup.subgroupOf_eq_top).1 htop
        exact hH0LtMF.not_ge hMFleH0
      exact (QuotientGroup.nontrivial_iff
        (N := H0.subgroupOf MF)).2 hH0neTop
    · exact hElemAbelian
  have hComm : ¬ ⁅U, MF⁆ ≤ H0 := by
    intro hle
    exact hNotCent
      ((Section9.quotientCentralizedBy_iff_commutator_le_sec9).2 hle)
  have hOddM : Odd (Nat.card M) :=
    odd_of_card_dvd IsMinCE.odd_order
      (Subgroup.card_subgroup_dvd_card M)
  let C : Subgroup G := subgroupCentralizerIn U MF
  have h11 :
      hypothesis_11_2_data
        M MF MF U C H0 W1 W2 S τ hp.val (Nat.card W1) :=
    ⟨h10, rfl, hLate, hMFleD, hUleD, rfl, hH0MF, hNormalIn,
      hp.property, hQuot, hChief, hComm, hW2card.symm, rfl, hP, hOddM, h92⟩
  exact theorem_11_complement_isCyclic_of_hypothesis
    M MF MF U C H0 W1 W2 S τ hp.val (Nat.card W1) h11


