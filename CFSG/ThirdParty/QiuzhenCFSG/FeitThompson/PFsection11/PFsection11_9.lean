/-- Arithmetic tail of the PF `(11.9)(c)` scalar-product computation: once the
source calculation shows that the quotient ratio `u / a` is `1`, divisibility
turns this into `a = u`. -/
private theorem theorem_11_9_case_a_parameter_eq_quotient_of_div_eq_one
    (a u : ℕ) :
    a ∣ u →
      u / a = 1 →
        a = u := by
  intro hdiv hratio
  have hmul : u / a * a = u := Nat.div_mul_cancel hdiv
  rw [hratio] at hmul
  simpa using hmul

/-- Arithmetic form of the scalar-product unit equation in PF `(11.9)(c)`.

If the integer ratio `u / a` times another integer is `±1`, then the ratio is
`1`. -/
private theorem theorem_11_9_case_a_ratio_eq_one_of_scalar_unit_equation
    (a u : ℕ) :
    a ∣ u →
      (∃ ε z : ℤ,
        (ε = 1 ∨ ε = -1) ∧ (((u / a : ℕ) : ℤ) * z = ε)) →
        u / a = 1 := by
  intro _hdiv hunit
  rcases hunit with ⟨ε, z, hε, hmul⟩
  have hprod : (u / a) * z.natAbs = 1 := by
    have habs := congrArg Int.natAbs hmul
    rcases hε with rfl | rfl
    · have htemp : (u / a : ℕ) * z.natAbs = 1 := by
        have htemp1 : ((Nat.cast (u / a : ℕ) : ℤ) * z).natAbs = 1 := by
          simpa using habs
        rw [Int.natAbs_mul] at htemp1
        have htemp2 : (Nat.cast (u / a : ℕ) : ℤ).natAbs = (u / a : ℕ) :=
          Int.natAbs_natCast (u / a)
        rw [htemp2] at htemp1
        exact htemp1
      exact htemp
    · have htemp : (u / a : ℕ) * z.natAbs = 1 := by
        have htemp1 : ((Nat.cast (u / a : ℕ) : ℤ) * z).natAbs = 1 := by
          simpa using habs
        rw [Int.natAbs_mul] at htemp1
        have htemp2 : (Nat.cast (u / a : ℕ) : ℤ).natAbs = (u / a : ℕ) :=
          Int.natAbs_natCast (u / a)
        rw [htemp2] at htemp1
        exact htemp1
      exact htemp
  exact Nat.eq_one_of_mul_eq_one_right hprod

/-- Arithmetic extraction of `a ∣ u` from the PF `(9.8)` degree-divisibility
form `a ∣ q * u`.

In case `(9.7.a)`, the parameter `a` divides `p - 1`, hence `a < p`; part
`(11.9)(b)` gives `q > p`, so `a` is coprime to the prime `q`. -/
private theorem theorem_11_9_case_a_parameter_dvd_quotient_of_degree_dvd
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF U C H0 W1 W2 : Subgroup G)
    (p q a u : ℕ) :
    Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
      q > p →
        a ∣ q * u →
          a ∣ u := by
  intro hcaseA hqgt hdegree
  have halt : a < p :=
    theorem_11_9_case_a_parameter_lt_p M MF U C H0 W1 W2 p q a hcaseA
  have ha_pos : 0 < a := by
    rcases hcaseA with
      ⟨_h92, _hH0MF, _hCentIn, _hp, hq, _hpdata, hdecomp, _hcard,
        _hadiv, _hembed⟩
    rcases hdecomp with
      ⟨_hnormal, _H, _hHcard, _hHnorm, _hInd, _hSup, hfactor, _hconj⟩
    have hqpos : 0 < q := hq.pos
    rcases hfactor ⟨0, hqpos⟩ with
      ⟨_hnormalC, ρ, _hcyc, hcardρ, _haction, _hker⟩
    rw [← hcardρ]
    exact Nat.card_pos (α := ρ.range)
  have hqprime : Nat.Prime q := by
    rcases hcaseA with
      ⟨_h92, _hH0MF, _hCentIn, _hp, hq, _hpdata, _hdecomp, _hcard,
        _hadiv, _hembed⟩
    exact hq
  have hqcop_a : q.Coprime a :=
    Nat.coprime_of_lt_prime (Nat.ne_of_gt ha_pos) (lt_trans halt hqgt) hqprime
  exact (Nat.Coprime.dvd_mul_left hqcop_a.symm).mp hdegree

/-- Convert the displayed complex scalar-product equation in PF `(11.9)(c)` to
the integer unit equation used by the arithmetic tail. -/
private theorem theorem_11_9_case_a_scalar_unit_equation_of_complex_source
    (a u : ℕ) :
    (∃ ε z : ℤ,
      (ε = 1 ∨ ε = -1) ∧
        ((0 : ℂ) = (ε : ℂ) - (((u / a : ℕ) : ℂ) * (z : ℂ)))) →
      ∃ ε z : ℤ,
        (ε = 1 ∨ ε = -1) ∧ (((u / a : ℕ) : ℤ) * z = ε) := by
  intro hsource
  rcases hsource with ⟨ε, z, hε, hcomplex⟩
  refine ⟨ε, z, hε, ?_⟩
  have hcomplex' : (((u / a : ℕ) : ℂ) * (z : ℂ)) = (ε : ℂ) := by
    have hsub : (ε : ℂ) - (((u / a : ℕ) : ℂ) * (z : ℂ)) = 0 := by
      simpa using hcomplex.symm
    exact (sub_eq_zero.mp hsub).symm
  have hcast : ((((u / a : ℕ) : ℤ) * z : ℤ) : ℂ) = (ε : ℂ) := by
    norm_num [Int.cast_mul] at hcomplex' ⊢
    exact hcomplex'
  exact_mod_cast hcast

/-- PF `(9.8)` divisibility extraction used in `(11.9)(c)`: the reducible
subfamily in the case-a character data contains a character of degree `q * u`,
and the first field of the same data says every such `S(H0)` character has
degree divisible by `a`. -/
private theorem theorem_11_9_case_a_degree_dvd_of_characterData
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF U C H0 Uprime W1 W2 : Subgroup G)
    (SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
    (p q a u : ℕ) :
    Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
      Section9.case_9_7_a_characterData M MF U H0 C Uprime p q a u
        SH0 SH0C SH0U →
        a ∣ q * u := by
  intro hcaseA hchar
  have hp : Nat.Prime p := by
    rcases hcaseA with
      ⟨_h92, _hH0MF, _hC, hp, _hq, _hpdata, _hdecomp, _hcard, _hadiv,
        _hembed⟩
    exact hp
  rcases hchar with
    ⟨hdegreeDiv, _hunderlyingDiv, _hbarU, hreducible, _hlinHC, _hSH0U⟩
  rcases hreducible with ⟨R, hRcard, hred, _hRsubSH0C, _hlinear⟩
  rcases hred with ⟨hRsubSH0, hRdegree, _hRcomplete⟩
  have hRnonempty : R.Nonempty := by
    rw [← Finset.card_pos, hRcard]
    exact Nat.sub_pos_of_lt hp.one_lt
  rcases hRnonempty with ⟨χ, hχR⟩
  have hχSH0 : χ ∈ SH0 := hRsubSH0 hχR
  rcases hdegreeDiv χ hχSH0 with ⟨d, hd, had⟩
  have hχdegree : Section1.degree χ = ((q * u : ℕ) : ℂ) := (hRdegree χ hχR).2
  have hd_eq : d = q * u := by
    have hcast : (d : ℂ) = ((q * u : ℕ) : ℂ) := hd.symm.trans hχdegree
    exact_mod_cast hcast
  simpa [hd_eq] using had

/-- PF `(9.8.d)` extraction used in `(11.9)(c)`: the final field of the
case-a character data contains a positive lower-bound family of irreducibles
of degree `q * a`. -/
private theorem theorem_11_9_case_a_degree_qa_character_of_characterData
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF U C H0 Uprime W1 W2 : Subgroup G)
    (SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
    (p q a u : ℕ) :
    Uprime = (_root_.commutator U).map U.subtype →
      Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
        Section9.case_9_7_a_characterData M MF U H0 C Uprime p q a u
          SH0 SH0C SH0U →
          ∃ lam : Section1.ClassFunction M,
            lam ∈ SH0U ∧
              Section1.IsIrreducibleCharacterOnGroup lam ∧
                Section1.degree lam = ((q * a : ℕ) : ℂ) := by
  intro hUprimeEq hcaseA hchar
  have hcount_pos :
      0 < ((p - 1) / a) * (Nat.card U / (a * Nat.card Uprime)) :=
    Section9.case_9_7_a_count_lower_bound_pos_sec9
      M MF U W1 W2 H0 C Uprime p q a hcaseA hUprimeEq
  rcases hchar with
    ⟨_hdegreeDiv, _hunderlyingDiv, _hbarU, _hreducible, _hlinHC, hI⟩
  rcases hI with ⟨Iset, hI_subset, hI_card_ge, hI_degree⟩
  have hI_card_pos : 0 < Iset.card := lt_of_lt_of_le hcount_pos hI_card_ge
  rcases Finset.card_pos.mp hI_card_pos with ⟨lam, hlamI⟩
  rcases hI_degree lam hlamI with ⟨hlamIrr, hlamDegree⟩
  exact ⟨lam, hI_subset hlamI, hlamIrr, by simpa [Nat.cast_mul] using hlamDegree⟩


/-- PF9 kernel-induced subfamilies under Hypothesis `(11.2)` are subfamilies
of the original Section 10 family `S`. -/
private theorem theorem_11_kernel_family_subset_S_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 Y : Subgroup G)
    (S SY : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF Y SY →
        SY ⊆ S := by
  intro h11 hSY χ hχ
  have hderived : Section10.derivedInducedFamily M S := by
    rcases h11 with
      ⟨h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    rcases h10 with
      ⟨_hMmax, _htype10, hderived, _hW1M, _hW2M, _hW12M, _hDade, _h46,
        _h52⟩
    exact hderived
  have hderivedAmbient : ∀ χ : Section1.ClassFunction M,
      χ ∈ S ↔
        ∃ θ : Section1.ClassFunction ((ambientDerivedSubgroup M).subgroupOf M),
          Section1.IsIrreducibleCharacterOnGroup θ ∧
            θ ≠ Section1.principalCharacter ((ambientDerivedSubgroup M).subgroupOf M) ∧
            χ = Section1.inducedCF ((ambientDerivedSubgroup M).subgroupOf M) θ := by
    intro χ
    rw [section12_ambientDerivedSubgroup_subgroupOf_eq]
    exact hderived χ
  rcases hSY with ⟨_hYN, _hMFN, hmem⟩
  rcases (hmem χ).mp hχ with ⟨θ, hθirr, hθnotMF, _hθkerY, hχeq⟩
  have hθne :
      θ ≠ Section1.principalCharacter ((ambientDerivedSubgroup M).subgroupOf M) := by
    intro hθprincipal
    apply hθnotMF
    rw [hθprincipal]
    intro a
    rfl
  exact (hderivedAmbient χ).mpr ⟨θ, hθirr, hθne, hχeq⟩

/-- PF9 kernel-induced subfamilies under Hypothesis `(11.2)` inherit the
Section 5 nonkernel-family interface from the original Section 10 family. -/
private theorem theorem_11_inducedFromNonkernelFamily_of_kernel_family_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 Y : Subgroup G)
    (S SY : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF Y SY →
        Section5.inducedFromNonkernelFamily_statement
          (derivedSubgroup M) (derivedSubgroup M) SY := by
  intro h11 hSY χ hχ
  have hsub : SY ⊆ S :=
    theorem_11_kernel_family_subset_S_of_hypothesis
      M MF H U C H0 W1 W2 Y S SY τ p q h11 hSY
  rcases h11 with
    ⟨h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
      _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
  exact Section10.inducedFromNonkernelFamily_of_hypothesis_10_1_supported_data h10 χ (hsub hχ)

/-- Kernel-induced PF9 subfamilies under Hypothesis `(11.2)` inherit the
Section 5.2(b) isometry package from the original Section 10 family. -/
private theorem theorem_11_hypothesis_5_2_b_of_kernel_family_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 Y : Subgroup G)
    (S SY : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF Y SY →
        Section5.hypothesis_5_2_b_statement SY τ := by
  intro h11 hSY
  have hsub : SY ⊆ S := by
    exact theorem_11_kernel_family_subset_S_of_hypothesis
      M MF H U C H0 W1 W2 Y S SY τ p q h11 hSY
  exact Section5.hypothesis_5_2_b_subset hsub
    (theorem_11_hypothesis_5_2_b_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11)

/-- Nonempty PF9 kernel-induced subfamilies under Hypothesis `(11.2)` inherit
the full PF `(5.2)` package from the original Section 10 family. -/
private theorem theorem_11_hypothesis_5_2_of_kernel_family_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 Y : Subgroup G)
    (S SY : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF Y SY →
        SY.Nonempty →
          Section5.hypothesis_5_2_statement SY τ := by
  intro h11 hSY hne
  have hsub : SY ⊆ S :=
    theorem_11_kernel_family_subset_S_of_hypothesis
      M MF H U C H0 W1 W2 Y S SY τ p q h11 hSY
  have hclosed : ∀ χ : Section1.ClassFunction M,
      χ ∈ SY → Section1.conjugateCharacter χ ∈ SY :=
    Section9.kernelInducedFamily_conjugationClosed_sec9
      M (ambientDerivedSubgroup M) MF Y SY hSY
  have h52 : Section5.hypothesis_5_2_statement S τ := by
    rcases h11 with
      ⟨h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    rcases h10 with
      ⟨_hMmax, _htype10, _hderived, _hW1M, _hW2M, _hW12M, _hDade, _h46,
        _hNotation10, h52⟩
    exact h52
  exact Section5.hypothesis_5_2_statement_subset hsub hne hclosed h52

/-- Assemble PF `(9.5)` for any PF9 kernel-induced subfamily under Hypothesis
`(11.2)`, once the Dade `A(M)` isometry is supplied.  The Section 5.2(b)
field is inherited from the original Section 10 family by the kernel-family
subfamily bridge above. -/
private theorem theorem_11_hypothesis_9_5_of_dade_kernel_family_bridge
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S SY : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.dadeIsometryRelativeToASet M U τ →
        Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SY →
          Section9.Hypothesis_9_5
            M MF U W1 W2 H0 C ((_root_.commutator C).map C.subtype) τ SY := by
  intro h11 hDade hKernel
  have h92q : Section9.hypothesis_9_2_statement M MF U W1 W2 q :=
    theorem_11_hypothesis_9_2_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hqW1 : q = Nat.card W1 := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, hqW1, _hPDef, _hOddAnd92⟩
    exact hqW1
  have h92 : Section9.hypothesis_9_2_statement M MF U W1 W2 (Nat.card W1) := by
    simpa [hqW1] using h92q
  have hp : Nat.Prime p := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    exact hp
  let hp' : Nat.Primes := ⟨p, hp⟩
  have h94 : Section9.hoReductionData M MF U W2 H0 hp' :=
    theorem_11_hoReductionData_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q hp h11
  have hCent : Section9.quotientCentralizerIn MF H0 U C :=
    theorem_11_quotientCentralizerIn_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hBar : ∃ u : ℕ, Section9.quotientBarUCardinality U C u :=
    theorem_11_quotientBarUCardinality_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have h52b : Section5.hypothesis_5_2_b_statement SY τ :=
    theorem_11_hypothesis_5_2_b_of_kernel_family_of_hypothesis
      M MF H U C H0 W1 W2 H0 S SY τ p q h11 hKernel
  exact ⟨h92, ⟨hp', h94⟩, hCent, hBar,
    theorem_11_commutator_map_le C, rfl, hDade, hKernel, h52b⟩


/-- In the PF `(11.9)(c)` case-a branch, the subgroup `U'` supplied to PF
`(9.8)` is the Section 11 subgroup `C`, by public `(11.6)`. -/
private theorem theorem_11_9_case_a_Uprime_eq_C_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 Uprime : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Uprime = (_root_.commutator U).map U.subtype →
        Uprime = C := by
  intro h11 hUprime
  have hCeq : C = ambientDerivedSubgroup U :=
    (theorem_11_6 M MF H U C H0 W1 W2 S τ p q h11).2.2.2
  calc
    Uprime = (_root_.commutator U).map U.subtype := hUprime
    _ = ambientDerivedSubgroup U := by
      rw [Subgroup.map_subtype_commutator, ← section12_ambientDerivedSubgroup_eq_commutator]
    _ = C := hCeq.symm

/-- Normalize the PF `(11.9)(c)` case-a data to the PF9 convention
`q = |W₁|`, which is the parameter shape used by `(9.11)`. -/
private theorem theorem_11_9_case_a_natCardW1_data_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 Uprime : Subgroup G)
    (S SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q a u : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
        Section9.case_9_7_a_characterData M MF U H0 C Uprime p q a u
          SH0 SH0C SH0U →
          Section9.case_9_7_a_data M MF U W1 W2 H0 C p (Nat.card W1) a ∧
            Section9.case_9_7_a_characterData M MF U H0 C Uprime
              p (Nat.card W1) a u SH0 SH0C SH0U := by
  intro h11 hcaseA hchar
  have hqW1 : q = Nat.card W1 := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, hqW1, _hPDef, _hOddAnd92⟩
    exact hqW1
  exact ⟨by simpa [hqW1] using hcaseA, by simpa [hqW1] using hchar⟩

/-- Package the active PF `(11.9)(c)` case-a data into the source-data shape
used by PF `(9.11)` for the family `S(C)`. -/
private theorem theorem_11_9_case_a_pf911_sourceData_of_characterData
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 Uprime : Subgroup G)
    (S SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q a u : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
        Uprime = (_root_.commutator U).map U.subtype →
          Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 →
            Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
              (H0 ⊔ C) SH0C →
              Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                (H0 ⊔ Uprime) SH0U →
                Section9.case_9_7_a_characterData M MF U H0 C Uprime p q a u
                  SH0 SH0C SH0U →
                  Section9.theorem_9_11_case_a_sourceData
                    M MF U W1 W2 H0 C C SH0C := by
  intro h11 hcaseA hUprime hSH0 hSH0C hSH0U hchar
  rcases theorem_11_9_case_a_natCardW1_data_of_hypothesis
      M MF H U C H0 W1 W2 Uprime S SH0 SH0C SH0U τ p q a u h11 hcaseA hchar with
    ⟨hcaseA_W1, hchar_W1⟩
  exact Section9.theorem_9_11_case_a_sourceData_intro
    M MF U W1 W2 H0 C C Uprime SH0C SH0 SH0C SH0U p a u hcaseA_W1 hSH0C
    hUprime hSH0 hSH0C hSH0U hchar_W1

/-- Apply PF `(9.8)` once the three kernel-family inputs for case `(9.7.a)`
have been supplied. The quotient-cardinality parameter is normalized to the
Section 11 abbreviation `|U/C|`. -/
private theorem theorem_11_9_case_a_characterData_of_kernel_bridges
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (Uprime : Subgroup G)
    (SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
    (p q a : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
        Uprime = (_root_.commutator U).map U.subtype →
          Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 →
            Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
              (H0 ⊔ C) SH0C →
              Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                (H0 ⊔ Uprime) SH0U →
                ∃ u : ℕ,
                  u = Nat.card U / Nat.card C ∧
                    Section9.case_9_7_a_characterData M MF U H0 C Uprime p q a u
                      SH0 SH0C SH0U := by
  intro h11 hcaseA hUprime hSH0 hSH0C hSH0U
  rcases theorem_11_quotientBarUCardinality_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11 with
    ⟨u, hBarU⟩
  have h98 := Section9.theorem_9_8
    M MF U W1 W2 H0 C Uprime p q a u SH0 SH0C SH0U
    hcaseA hBarU hUprime hSH0 hSH0C hSH0U
  have hu : u = Nat.card U / Nat.card C :=
    theorem_11_quotientBarUCardinality_eq_card_div U C u hBarU
  exact ⟨u, hu, h98.2⟩

/-- Once the base PF `(9.5)` kernel family `S(H₀)` is available, the two
larger kernel families used in PF `(9.8)` are just the canonical filtered
subfamilies. -/
private theorem theorem_11_9_case_a_kernel_subfamilies_of_base
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ)
    (SH0 : Finset (Section1.ClassFunction M)) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 →
        ∃ Uprime : Subgroup G,
          ∃ SH0C SH0U : Finset (Section1.ClassFunction M),
            Uprime = (_root_.commutator U).map U.subtype ∧
              Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                (H0 ⊔ C) SH0C ∧
              Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                (H0 ⊔ Uprime) SH0U := by
  intro h11 hSH0
  have hUleN : U ≤ ambientDerivedSubgroup M := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    exact hUleD
  have hCU : C ≤ U := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    rw [hCeq]
    exact inf_le_left
  have hCN : C ≤ ambientDerivedSubgroup M := hCU.trans hUleN
  have hH0N : H0 ≤ ambientDerivedSubgroup M := hSH0.1
  have hH0C_N : H0 ⊔ C ≤ ambientDerivedSubgroup M := sup_le hH0N hCN
  let SH0C : Finset (Section1.ClassFunction M) :=
    Section9.kernelInducedSubfamily_sec9 M (ambientDerivedSubgroup M) MF (H0 ⊔ C)
      SH0
  have hSH0C :
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF (H0 ⊔ C)
        SH0C := by
    exact Section9.kernelInducedFamily_subfamily_of_le_sec9
      M (ambientDerivedSubgroup M) MF H0 (H0 ⊔ C) SH0 hH0C_N le_sup_left hSH0
  let Uprime : Subgroup G := (_root_.commutator U).map U.subtype
  have hUprimeU : Uprime ≤ U := by
    intro x hx
    rcases hx with ⟨y, _hy, rfl⟩
    exact y.property
  have hUprimeN : Uprime ≤ ambientDerivedSubgroup M := hUprimeU.trans hUleN
  have hH0Uprime_N : H0 ⊔ Uprime ≤ ambientDerivedSubgroup M :=
    sup_le hH0N hUprimeN
  let SH0U : Finset (Section1.ClassFunction M) :=
    Section9.kernelInducedSubfamily_sec9 M (ambientDerivedSubgroup M) MF
      (H0 ⊔ Uprime) SH0
  have hSH0U :
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
        (H0 ⊔ Uprime) SH0U := by
    exact Section9.kernelInducedFamily_subfamily_of_le_sec9
      M (ambientDerivedSubgroup M) MF H0 (H0 ⊔ Uprime) SH0
      hH0Uprime_N le_sup_left hSH0
  exact ⟨Uprime, SH0C, SH0U, rfl, hSH0C, hSH0U⟩

/-- The base PF `(9.5)` kernel family `S(H₀)` needed in `(11.9)(c)` is the
subfamily of the Section 10 family induced from irreducibles of `M'` whose
source character is nontrivial on `MF`; `(11.7)` rewrites `H₀` to `1`. -/
private theorem theorem_11_9_case_a_base_kernel_family_of_hypothesis
    {G : Type u}
    [Group G]
