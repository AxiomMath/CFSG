        M (ambientDerivedSubgroup M) MF H0 (H0 ⊔ Uprime) SH0
        (sup_le hH0leD (hUprimeleU.trans hUleD)) le_sup_left hSH0
    have h98 := Section9.theorem_9_8
      M MF U W1 W2 H0 C Uprime p q a u SH0 SH0C SH0U
