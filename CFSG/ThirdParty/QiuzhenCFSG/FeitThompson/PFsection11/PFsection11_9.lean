              τ (Section10.muColumn μ j0 - ζ)
            let a : I → J → ℂ :=
              fun i j => Section1.scalarProduct G ψ (σ (ω i j))
            let projection : Section1.ClassFunction G :=
              Section1.weightedFamilySum
                (fun x : I × J => a x.1 x.2)
                (fun x : I × J => σ (ω x.1 x.2))
            Section1.scalarProduct G projection
              (τ (ζ - Section1.conjugateCharacter ζ)) = 0 := by
  intro h11 hNotation hSHC hζ
  classical
  let ψ : Section1.ClassFunction G :=
    τ (Section10.muColumn μ j0 - ζ)
  let a : I → J → ℂ :=
    fun i j => Section1.scalarProduct G ψ (σ (ω i j))
  let projection : Section1.ClassFunction G :=
    Section1.weightedFamilySum
      (fun x : I × J => a x.1 x.2)
      (fun x : I × J => σ (ω x.1 x.2))
  have hleft :
      Section1.scalarProduct G (τ (ζ - Section1.conjugateCharacter ζ)) projection = 0 := by
    have hzero : ∀ x : I × J,
