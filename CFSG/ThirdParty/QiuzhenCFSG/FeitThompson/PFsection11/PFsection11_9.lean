      hUprimeC hH0bot hSH0U hlamSH0U).symm
  have hInd :
      Section5.inducedFromNonkernelFamily_statement
        (derivedSubgroup M) (derivedSubgroup M) S :=
    Section10.inducedFromNonkernelFamily_of_hypothesis_10_1_supported_data h11.1
  have hmu0mu :
      Section1.scalarProduct M (Section10.muColumn μ j0)
        (Section10.muColumn μ j) = 0 := by
    rw [Section10.muColumn]
    have hsum :
        ((∑ i : I, μ i j0 : Section1.ClassFunction M)) =
