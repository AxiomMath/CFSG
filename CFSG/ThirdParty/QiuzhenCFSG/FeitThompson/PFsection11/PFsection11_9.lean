    · intro hχ
      rcases hχ with ⟨θ, hθirr, hθnotMF, hθkerH0, hχeq⟩
      rw [Finset.mem_filter]
      refine ⟨?_, ⟨θ, hθirr, hθnotMF, hθkerH0, hχeq⟩⟩
      have hθne :
