  rcases hFullRest with
    ⟨hω, h43b, _h43c, _h43d, h45a, h45b, _hTauCyc, _hTauA0,
      hTauIso, _hTauPunctured, _hTauVirt, _hPF39⟩
  have hζIrr : Section1.IsIrreducibleCharacterOnGroup ζ := by
    exact theorem_11_9_SHC_irreducible_of_hypothesis
      M MF H U C H0 W1 W2 W A A0 S SHC i0 j0 μ δSign ω σ τ ζ p q
      h11 hNotation' hSHC hζ
  have hζS : ζ ∈ S := theorem_11_8_SHC_subset_S hSHC hζ
  have hlamS : lam ∈ S :=
    theorem_11_kernel_family_subset_S_of_hypothesis
