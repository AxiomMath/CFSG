/-- Proof placeholder for `theorem_11_1_statement`. -/
public theorem theorem_11_1
    (p q : ℕ)
    : p.Prime → q.Prime → Odd p → Odd q → p ≠ q → p ^ q > 4 * q ^ 2 + 1 := by
  intro hp hq hpodd hqodd hpq
  have pow3_bound : ∀ n : ℕ, 5 ≤ n → 4 * n ^ 2 + 1 < 3 ^ n := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => norm_num
    | succ n hn ih =>
        have hineq : 4 * (n + 1) ^ 2 + 1 ≤ 3 * (4 * n ^ 2 + 1) := by
          nlinarith
        calc
          4 * (n + 1) ^ 2 + 1 ≤ 3 * (4 * n ^ 2 + 1) := hineq
          _ < 3 * 3 ^ n := Nat.mul_lt_mul_of_pos_left ih (by norm_num)
          _ = 3 ^ (n + 1) := by ring
  have hp_ne_two : p ≠ 2 := by
    intro h
    subst p
    have hmod := Nat.odd_iff.mp hpodd
    norm_num at hmod
  have hp_ge_three : 3 ≤ p := by
    have hp_two : 2 ≤ p := hp.two_le
    omega
  by_cases hq3 : q = 3
  · subst q
    have hp_ne_three : p ≠ 3 := by
      intro hp3
      exact hpq hp3
    have hp_ne_four : p ≠ 4 := by
      intro h
      subst p
      have hmod := Nat.odd_iff.mp hpodd
      norm_num at hmod
    have hp_ge_five : 5 ≤ p := by
      omega
    have hpow : 5 ^ 3 ≤ p ^ 3 := Nat.pow_le_pow_left hp_ge_five 3
    norm_num at hpow ⊢
    omega
  · have hq_ne_two : q ≠ 2 := by
      intro h
      subst q
      have hmod := Nat.odd_iff.mp hqodd
      norm_num at hmod
    have hq_ne_four : q ≠ 4 := by
      intro h
      subst q
      have hmod := Nat.odd_iff.mp hqodd
      norm_num at hmod
    have hq_ge_five : 5 ≤ q := by
      have hq_two : 2 ≤ q := hq.two_le
      omega
    have hbase : 4 * q ^ 2 + 1 < 3 ^ q := pow3_bound q hq_ge_five
    have hpq_ge : 3 ^ q ≤ p ^ q := Nat.pow_le_pow_left hp_ge_three q
    exact lt_of_lt_of_le hbase hpq_ge

/-- Hypothesis `(11.2)` already contradicts coherence of the full family by `(10.8)`. -/
private theorem theorem_11_3_not_coherent_S_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ¬ Section6.coherentFamily S τ := by
  intro h11
  exact (Section10.theorem_10_8_supported M MF W1 W2 (section16HatW W1 W2) S τ) h11.1

/-- The explicit PF `(6.3)` package needed in the proof of `(11.3)`.

In the source this is obtained by replacing the `(6.3)` symbols
`L, K, M, H, H₁` by `M, M', 1, HC, H₀C`. -/
private def theorem_11_3_sixThreeData
    {G : Type u}
    [Group G]
    [Finite G]
    (M : Subgroup G)
    (S SH0C : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G) : Prop :=
  ∃ K M0 H0C HC : Subgroup M,
    Section6.hypothesis_6_1_statement K S τ ∧
    M0.Normal ∧
    H0C.Normal ∧
      HC.Normal ∧
      Section6.inducedKernelFamily K M0 S ∧
      M0 ≤ H0C ∧
      H0C ≤ HC ∧
      HC ≤ K ∧
      Section6.nilpotentQuotient M0 HC ∧
      Section6.inducedKernelFamily K H0C SH0C ∧
      H0C.relIndex HC > 4 * (K.relIndex (⊤ : Subgroup M)) ^ 2 + 1

/-- The concrete `(6.3)` hypotheses after the source substitution
`K = M'`, `M0 = 1`, `H₁ = H₀C`, and `H = HC`. -/
private def theorem_11_3_sixThreeComponents
    {G : Type u}
    [Group G]
    [Finite G]
    (M H C H0 : Subgroup G)
    (S SH0C : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G) : Prop :=
  let K : Subgroup M := derivedSubgroup M
  let M0 : Subgroup M := ⊥
  let H0C : Subgroup M := (H0 ⊔ C).subgroupOf M
  let HC : Subgroup M := (H ⊔ C).subgroupOf M
  Section6.hypothesis_6_1_statement K S τ ∧
    M0.Normal ∧
    H0C.Normal ∧
    HC.Normal ∧
    Section6.inducedKernelFamily K M0 S ∧
    M0 ≤ H0C ∧
      H0C ≤ HC ∧
      HC ≤ K ∧
      Section6.nilpotentQuotient M0 HC ∧
      Section6.inducedKernelFamily K H0C SH0C ∧
      H0C.relIndex HC > 4 * (K.relIndex (⊤ : Subgroup M)) ^ 2 + 1

/-- Turn an ambient disjoint product decomposition into a local complement. -/
private theorem theorem_11_3_isComplement'_subgroupOf_of_disjoint_mul_eq_univ
    {G : Type u}
    [Group G]
    {K H R : Subgroup G}
    (hHK : H ≤ K)
    (hRK : R ≤ K)
    (hdisj : Disjoint H R)
    (hmul : ((K : Set G) = (H : Set G) * (R : Set G))) :
    (H.subgroupOf K).IsComplement' (R.subgroupOf K) := by
  refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
  · rw [Subgroup.disjoint_def]
    intro x hxH hxR
    apply Subtype.ext
    exact Subgroup.disjoint_def.mp hdisj
      (by simpa [Subgroup.mem_subgroupOf] using hxH)
      (by simpa [Subgroup.mem_subgroupOf] using hxR)
  · rw [Set.eq_univ_iff_forall]
    intro x
    have hxprod : (x : G) ∈ (H : Set G) * (R : Set G) := by
      rw [← hmul]
      exact x.property
    rcases hxprod with ⟨h, hhH, r, hrR, hhr⟩
    refine ⟨⟨h, hHK hhH⟩, ?_, ⟨r, hRK hrR⟩, ?_, ?_⟩
    · simpa [Subgroup.mem_subgroupOf] using hhH
    · simpa [Subgroup.mem_subgroupOf] using hrR
    · apply Subtype.ext
      exact hhr

/-- A normal factor in a Section 12 complement gives the expected quotient-complement
equivalence. -/
private theorem theorem_11_3_complementIn_normal_isComplement'
    {G : Type u}
    [Group G]
    {D K L : Subgroup G}
    (hcomp : section12ComplementIn D K L)
    (hLnorm : section10NormalIn L D) :
    (K.subgroupOf D).IsComplement' (L.subgroupOf D) := by
  have hK_norm_L : K ≤ Subgroup.normalizer (L : Set G) :=
    hcomp.1.trans ((Subgroup.normal_subgroupOf_iff_le_normalizer hLnorm.1).1 hLnorm.2)
  have hmul_sup :
      (((K ⊔ L : Subgroup G) : Set G)) = (K : Set G) * (L : Set G) :=
    Subgroup.coe_mul_of_left_le_normalizer_right K L hK_norm_L
  have hmul :
      ((D : Set G) = (K : Set G) * (L : Set G)) := by
    rw [hcomp.2.2.1, hmul_sup]
  exact theorem_11_3_isComplement'_subgroupOf_of_disjoint_mul_eq_univ
    hcomp.1 hcomp.2.1 hcomp.2.2.2 hmul

/-- A Section 12 complement whose left factor is normal gives a local
`IsComplement'` in the source order. -/
private theorem theorem_11_3_complementIn_left_normal_isComplement'
    {G : Type u}
    [Group G]
    {D K L : Subgroup G}
    (hcomp : section12ComplementIn D K L)
    (hKnorm : section10NormalIn K D) :
    (K.subgroupOf D).IsComplement' (L.subgroupOf D) := by
  exact (theorem_11_3_complementIn_normal_isComplement'
    (G := G) (D := D) (K := L) (L := K)
    ⟨hcomp.2.1, hcomp.1, by
      rw [sup_comm]
      exact hcomp.2.2.1, hcomp.2.2.2.symm⟩
    hKnorm).symm

/-- If a right complement is Hall in the overgroup, then the normal left
factor is Hall in the overgroup as well. -/
private theorem theorem_11_3_complementIn_left_isHall_of_right_hall
    {G : Type u}
    [Group G]
    [Finite G]
    {D K L : Subgroup G}
    (hcomp : section12ComplementIn D K L)
    (hKnorm : section10NormalIn K D)
    (hLHall : section16HallSubgroupOf L D) :
    IsHallSubgroup (subgroupPrimeSet K) (K.subgroupOf D) := by
  classical
  letI : (K.subgroupOf D).Normal := hKnorm.2
  have hcomp' : (L.subgroupOf D).IsComplement' (K.subgroupOf D) :=
    theorem_11_3_complementIn_normal_isComplement'
      (G := G) (D := D) (K := L) (L := K)
      ⟨hcomp.2.1, hcomp.1, by
        rw [sup_comm]
        exact hcomp.2.2.1, hcomp.2.2.2.symm⟩
      hKnorm
  rcases hcomp with ⟨hKD, _hLD, _hsup, _hdisj⟩
  rcases hLHall with ⟨hLD, hLHallSub⟩
  refine isHallSubgroup_of (G := D) (π := subgroupPrimeSet K)
    (H := K.subgroupOf D) ?_ ?_
  · intro p hpK
    have hcardK : Nat.card (K.subgroupOf D) = Nat.card K :=
      natCard_subgroupOf_eq K D hKD
    rw [hcardK] at hpK
    exact hpK
  · intro p hpK hpidxK
    have hpLcard : p.val ∣ Nat.card (L.subgroupOf D) := by
      simpa [hcomp'.index_eq_card] using hpidxK
    have hpLπ : p ∈ subgroupPrimeSet L :=
      hLHallSub.p_in_pi_of_p_dvd_card p hpLcard
    have hpKcard : p.val ∣ Nat.card (K.subgroupOf D) := by
      have hcardK : Nat.card (K.subgroupOf D) = Nat.card K :=
        natCard_subgroupOf_eq K D hKD
      rw [hcardK]
      exact hpK
    have hpLidx : p.val ∣ (L.subgroupOf D).index := by
      simpa [hcomp'.symm.index_eq_card] using hpKcard
    exact (hLHallSub.p_in_pi_of_p_dvd_index p hpLidx) hpLπ

/-- If `A` normalizes `C` and intersects it trivially, then the two factors
complement each other inside `A ⊔ C`. -/
private theorem theorem_11_3_sup_isComplement'_of_disjoint_le_normalizer
    {G : Type u}
    [Group G]
    (A C : Subgroup G) :
    Disjoint A C →
      A ≤ Subgroup.normalizer (C : Set G) →
        (A.subgroupOf (A ⊔ C)).IsComplement' (C.subgroupOf (A ⊔ C)) := by
  intro hdisj hAnormC
  have hmul_sup :
      (((A ⊔ C : Subgroup G) : Set G)) = (A : Set G) * (C : Set G) :=
    Subgroup.coe_mul_of_left_le_normalizer_right A C hAnormC
  exact theorem_11_3_isComplement'_subgroupOf_of_disjoint_mul_eq_univ
    (le_sup_left : A ≤ A ⊔ C) (le_sup_right : C ≤ A ⊔ C) hdisj hmul_sup

/-- The source subgroup index `|HC : H₀C|` agrees with `|H/H₀|` once `C`
is a disjoint normalized factor. -/
private theorem theorem_11_3_relIndex_sup_eq_quotient_card
    {G : Type u}
    [Group G]
    [Finite G]
    (H C H0 : Subgroup G)
    (hH0H : H0 ≤ H)
    [(H0.subgroupOf H).Normal] :
    Disjoint H C →
      H ≤ Subgroup.normalizer (C : Set G) →
        (H0 ⊔ C).relIndex (H ⊔ C) =
          Nat.card (H ⧸ H0.subgroupOf H) := by
  intro hdisj hHnormC
  let HC : Subgroup G := H ⊔ C
  let H0C : Subgroup G := H0 ⊔ C
  have hH0C_le_HC : H0C ≤ HC := by
    dsimp [H0C, HC]
    exact sup_le_sup hH0H le_rfl
  have hdisjH0C : Disjoint H0 C := by
    rw [Subgroup.disjoint_def]
    intro x hxH0 hxC
    exact Subgroup.disjoint_def.mp hdisj (hH0H hxH0) hxC
  have hH0normC : H0 ≤ Subgroup.normalizer (C : Set G) := hH0H.trans hHnormC
  have hcompHC : (H.subgroupOf HC).IsComplement' (C.subgroupOf HC) := by
    dsimp [HC]
    exact theorem_11_3_sup_isComplement'_of_disjoint_le_normalizer H C hdisj hHnormC
  have hcompH0C : (H0.subgroupOf H0C).IsComplement' (C.subgroupOf H0C) := by
    dsimp [H0C]
    exact theorem_11_3_sup_isComplement'_of_disjoint_le_normalizer H0 C hdisjH0C hH0normC
  have hcardHC : Nat.card HC = Nat.card H * Nat.card C := by
    have h := hcompHC.card_mul
    dsimp [HC] at h ⊢
    rw [natCard_subgroupOf_eq H (H ⊔ C) le_sup_left,
      natCard_subgroupOf_eq C (H ⊔ C) le_sup_right] at h
    exact h.symm
  have hcardH0C : Nat.card H0C = Nat.card H0 * Nat.card C := by
    have h := hcompH0C.card_mul
    dsimp [H0C] at h ⊢
    rw [natCard_subgroupOf_eq H0 (H0 ⊔ C) le_sup_left,
      natCard_subgroupOf_eq C (H0 ⊔ C) le_sup_right] at h
    exact h.symm
  have hcardH0Csub : Nat.card (H0C.subgroupOf HC) = Nat.card H0C :=
    natCard_subgroupOf_eq H0C HC hH0C_le_HC
  have hmulIndex : Nat.card H0C * H0C.relIndex HC = Nat.card HC := by
    rw [Subgroup.relIndex, ← hcardH0Csub]
    exact (H0C.subgroupOf HC).card_mul_index
  have hcardH0sub : Nat.card (H0.subgroupOf H) = Nat.card H0 :=
    natCard_subgroupOf_eq H0 H hH0H
  have hcardH : Nat.card H = Nat.card (H ⧸ H0.subgroupOf H) * Nat.card H0 := by
    rw [← hcardH0sub]
    exact Subgroup.card_eq_card_quotient_mul_card_subgroup (H0.subgroupOf H)
  have hmain : (Nat.card H0 * Nat.card C) * H0C.relIndex HC =
      (Nat.card H0 * Nat.card C) * Nat.card (H ⧸ H0.subgroupOf H) := by
    calc
      (Nat.card H0 * Nat.card C) * H0C.relIndex HC
          = Nat.card H0C * H0C.relIndex HC := by rw [hcardH0C]
      _ = Nat.card HC := hmulIndex
      _ = Nat.card H * Nat.card C := hcardHC
      _ = (Nat.card (H ⧸ H0.subgroupOf H) * Nat.card H0) * Nat.card C := by
        rw [hcardH]
      _ = (Nat.card H0 * Nat.card C) * Nat.card (H ⧸ H0.subgroupOf H) := by
        ac_rfl
  exact Nat.mul_left_cancel (Nat.mul_pos Nat.card_pos Nat.card_pos) hmain

/-- A group is solvable when it has a solvable normal subgroup and solvable quotient. -/
private theorem theorem_11_3_solvable_of_normal_and_quotient
    {L : Type u}
    [Group L]
    (N : Subgroup L)
    [N.Normal] :
    Group.IsSolvable N →
      Group.IsSolvable (L ⧸ N) →
        Group.IsSolvable L := by
  intro hN hQ
  let _ : Group.IsSolvable N := hN
  let _ : Group.IsSolvable (L ⧸ N) := hQ
  exact
    Group.isSolvable_of_ker_le_range
      N.subtype
      (QuotientGroup.mk' N)
      (by
        intro x hx
        refine ⟨⟨x, ?_⟩, rfl⟩
        exact (QuotientGroup.eq_one_iff (N := N) (x := x)).1 hx)

/-- The Type `P` definition data makes the ambient derived subgroup solvable:
`M' = M_F U` with nilpotent normal kernel `M_F` and nilpotent complement `U`. -/
private theorem theorem_11_3_ambientDerived_solvable_of_typePDefinitionData
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF U W1 W2 : Subgroup G) :
    Section8.typePDefinitionData M MF U W1 W2 →
      Group.IsSolvable (ambientDerivedSubgroup M) := by
  intro hPDef
  let D : Subgroup G := ambientDerivedSubgroup M
  rcases hPDef with
    ⟨hMF, _hW1cyc, _hW1ne, _hW1hall, _hcompMW1, _hUleD, hUnil, _hW1normU,
      hcomp, _hMFnotCyc, _hSecond, _hfit_eq, _hfit_leD, _hW2le, _hW2cyc,
      _hW2ne, _hcentW1, _hW0norm⟩
  rcases hMF with ⟨hMFhall, _hMFmax⟩
  rcases hMFhall with ⟨hMFleM, hMFnormM, hMFnil, _hMFhall⟩
  have hDleM : D ≤ M := by
    simpa [D] using (section12_ambientDerivedSubgroup_le (G := G) (E := M))
  have hM_norm_MF : M ≤ Subgroup.normalizer (MF : Set G) := by
    haveI : (MF.subgroupOf M).Normal := hMFnormM
    exact Subgroup.le_normalizer_of_normal_subgroupOf hMFleM
  have hD_norm_MF : D ≤ Subgroup.normalizer (MF : Set G) :=
    hDleM.trans hM_norm_MF
  have hMFnormD : (MF.subgroupOf D).Normal := by
    simpa [D] using
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hcomp.1).2 hD_norm_MF)
  have hMFnormalInD : section10NormalIn MF D := ⟨by simpa [D] using hcomp.1, hMFnormD⟩
  have hcomp_symm : section12ComplementIn D U MF := by
    refine ⟨hcomp.2.1, hcomp.1, ?_, ?_⟩
    · change ambientDerivedSubgroup M = U ⊔ MF
      rw [hcomp.2.2.1, sup_comm]
    · exact hcomp.2.2.2.symm
  have hcompl : (U.subgroupOf D).IsComplement' (MF.subgroupOf D) :=
    theorem_11_3_complementIn_normal_isComplement' hcomp_symm hMFnormalInD
  have hMFsub_solv : Group.IsSolvable (MF.subgroupOf D) := by
    have hMFsub_nil : Group.IsNilpotent (MF.subgroupOf D) := by
      haveI : Group.IsNilpotent MF := hMFnil
      exact Group.nilpotent_of_mulEquiv (Subgroup.subgroupOfEquivOfLe (by simpa [D] using hcomp.1)).symm
    haveI : Group.IsNilpotent (MF.subgroupOf D) := hMFsub_nil
    infer_instance
  have hquot_solv : Group.IsSolvable (D ⧸ MF.subgroupOf D) := by
    have hUsub_nil : Group.IsNilpotent (U.subgroupOf D) := by
      haveI : Group.IsNilpotent U := hUnil
      exact Group.nilpotent_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hcomp.2.1).symm
    haveI : Group.IsNilpotent (U.subgroupOf D) := hUsub_nil
    have _ : Group.IsSolvable (U.subgroupOf D) := by infer_instance
    exact Group.isSolvable_of_isSolvable_injective (f := hcompl.QuotientMulEquiv.toMonoidHom)
      hcompl.QuotientMulEquiv.injective
  haveI : (MF.subgroupOf D).Normal := hMFnormD
  exact theorem_11_3_solvable_of_normal_and_quotient (MF.subgroupOf D)
    hMFsub_solv hquot_solv

