    rw [← hcard]
    exact Nat.card_pos
  have hindex_gt : 1 < DD.relIndex HC := by
    have hne0 : DD.relIndex HC ≠ 0 := Nat.ne_of_gt hindex_pos
    have hne1 : DD.relIndex HC ≠ 1 := by
      simpa [DD, HC] using hne
    omega
  have hqodd : Odd q :=
    (theorem_11_3_arithmetic_data_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11).2.2.2.1
  exact theorem_11_5_odd_divisor_sub_one_lower_bound
    hqodd hodd_dvd.1 hindex_gt hodd_dvd.2

/-- The remaining fixed-point-free quotient action step in PF `(11.5)`.

The source uses PF `(8.4.d)` to make the action of `W₁` on `HC/M''`
