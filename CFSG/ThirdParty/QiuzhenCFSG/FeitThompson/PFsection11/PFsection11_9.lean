/-- The part of the concrete `(6.3)` package that is not just order,
monotonicity, or the already-extracted PF `(6.1)` data after the source
substitution in `(11.3)`. -/
private def theorem_11_3_sixThreeCoreData
    {G : Type u}
    [Group G]
    [Finite G]
    (M H C H0 : Subgroup G) : Prop :=
  let K : Subgroup M := derivedSubgroup M
  let H0C : Subgroup M := (H0 ⊔ C).subgroupOf M
  let HC : Subgroup M := (H ⊔ C).subgroupOf M
  H0C.Normal ∧
    HC.Normal ∧
    H0C.relIndex HC > 4 * (K.relIndex (⊤ : Subgroup M)) ^ 2 + 1

/-- A subgroup of the ambient derived subgroup becomes a subgroup of the
