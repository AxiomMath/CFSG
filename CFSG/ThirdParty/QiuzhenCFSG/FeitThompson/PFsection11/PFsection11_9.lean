        Subgroup.relIndex_dvd_index_of_le hMFsub_le_Dsub
      simpa [hrel_eq] using hrel_dvd
    exact (hMFHallM.p_in_pi_of_p_dvd_index p (hpidx.trans hidx_dvd)) hpπ

/-- If the action commutator subgroup is all of `H`, then the induced action
on the abelianization `H/H'` is also generated by action commutators. -/
private theorem theorem_11_6_commutatorAction_quotient_commutator_eq_top
    {H A : Type u}
    [Group H]
    [Finite H]
    [Group A]
    [MulDistribMulAction A H]
    (hcommTop : commutatorAction (A := A) (G := H) = ⊤)
    (hcommInv : IsInvariant A H (commutator H)) :
    letI : MulDistribMulAction A (H ⧸ commutator H) :=
      quotientMulDistribMulAction (A := A) (G := H) (commutator H) hcommInv
    commutatorAction (A := A) (G := H ⧸ commutator H) = ⊤ := by
  classical
  letI : MulAction.QuotientAction A (commutator H) :=
    quotientAction_of_isInvariant (A := A) (commutator H) hcommInv
  letI : MulDistribMulAction A (H ⧸ commutator H) :=
    quotientMulDistribMulAction (A := A) (G := H) (commutator H) hcommInv
  let qcomm : H →* (H ⧸ commutator H) := QuotientGroup.mk' (commutator H)
  have hmap_top :
      (commutatorAction (A := A) (G := H)).map qcomm = ⊤ := by
    rw [hcommTop]
    simpa [qcomm] using
      (Subgroup.map_top_of_surjective (f := QuotientGroup.mk' (commutator H))
        (QuotientGroup.mk'_surjective (N := commutator H)))
  have hmap_le :
      (commutatorAction (A := A) (G := H)).map qcomm ≤
        commutatorAction (A := A) (G := H ⧸ commutator H) := by
    let S : Set H := {x : H | ∃ a : A, ∃ h : H, x = h⁻¹ * (a • h)}
    let T : Set (H ⧸ commutator H) :=
      {x : H ⧸ commutator H | ∃ a : A, ∃ h : H ⧸ commutator H,
        x = h⁻¹ * (a • h)}
    have hS : commutatorAction (A := A) (G := H) = Subgroup.closure S := by
      simpa [S] using (commutatorAction_eq_closure (G := H) (A := A))
    have hT :
        commutatorAction (A := A) (G := H ⧸ commutator H) = Subgroup.closure T := by
      simpa [T] using
        (commutatorAction_eq_closure (G := H ⧸ commutator H) (A := A))
    rw [hS, hT]
    have hmap :
        (Subgroup.closure S).map qcomm = Subgroup.closure (qcomm '' S) := by
      simpa [qcomm] using (MonoidHom.map_closure (f := qcomm) S)
    rw [hmap]
    refine (Subgroup.closure_le (K := Subgroup.closure T)).2 ?_
    intro x hx
    rcases hx with ⟨y, hyS, rfl⟩
    rcases hyS with ⟨a, h, rfl⟩
    refine Subgroup.subset_closure ?_
    refine ⟨a, qcomm h, ?_⟩
    simp [qcomm]
  apply top_unique
  simpa [hmap_top] using hmap_le

