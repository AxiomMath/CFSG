      W1 ≤ Subgroup.normalizer
        ((ambientDerivedSubgroup (ambientDerivedSubgroup M) : Subgroup G) : Set G) := by
  intro h11
  let DD : Subgroup G := ambientDerivedSubgroup (ambientDerivedSubgroup M)
  have hW1M : W1 ≤ M :=
