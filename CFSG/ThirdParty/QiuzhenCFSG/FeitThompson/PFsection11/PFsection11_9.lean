/-- The kernel of the quotient map `W2 → MF/H0` is `H0 ∩ W2`, so the
quotient `W2/(H0 ∩ W2)` has the cardinality of the image of `W2` in `MF/H0`. -/
private theorem theorem_11_pf96_W2_quotient_card_eq_of_image_card
    {G : Type u}
    [Group G]
    [Finite G]
    (H0 W2 MF : Subgroup G)
    (p : ℕ)
    (hW2MF : W2 ≤ MF)
    [((H0 ⊓ W2 : Subgroup G).subgroupOf W2).Normal]
    [(H0.subgroupOf MF).Normal] :
    Nat.card ((W2.subgroupOf MF).map (QuotientGroup.mk' (H0.subgroupOf MF))) = p →
      Nat.card (W2 ⧸ (H0 ⊓ W2 : Subgroup G).subgroupOf W2) = p := by
  intro hmap
  let φ : W2 →* MF ⧸ H0.subgroupOf MF :=
    (QuotientGroup.mk' (H0.subgroupOf MF)).comp (Subgroup.inclusion hW2MF)
  have hker : φ.ker = (H0 ⊓ W2 : Subgroup G).subgroupOf W2 := by
    ext x
    simp [φ, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
  have hrange :
      φ.range = (W2.subgroupOf MF).map (QuotientGroup.mk' (H0.subgroupOf MF)) := by
    ext x
    constructor
    · rintro ⟨y, _hy, rfl⟩
      refine ⟨Subgroup.inclusion hW2MF y, ?_, rfl⟩
      change ((Subgroup.inclusion hW2MF y : MF) : G) ∈ W2
      exact y.property
    · rintro ⟨y, hyW2, rfl⟩
      exact ⟨⟨(y : G), hyW2⟩, by rfl⟩
  have hcard : Nat.card (W2 ⧸ φ.ker) = Nat.card φ.range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
  rw [hker, hrange, hmap] at hcard
  exact hcard


/-- If `W2/(H0 ∩ W2)` has the same order as `W2`, then the kernel
`H0 ∩ W2` is trivial. -/
private theorem theorem_11_pf96_H0_inf_W2_eq_bot_of_quotient_card_eq
    {G : Type u}
    [Group G]
    [Finite G]
    (H0 W2 : Subgroup G)
    [(((H0 ⊓ W2 : Subgroup G).subgroupOf W2)).Normal] :
    Nat.card (W2 ⧸ (H0 ⊓ W2 : Subgroup G).subgroupOf W2) = Nat.card W2 →
      H0 ⊓ W2 = ⊥ := by
  intro hcard
  let N : Subgroup W2 := (H0 ⊓ W2 : Subgroup G).subgroupOf W2
  have hNbot : N = ⊥ := by
    have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup (s := N)
    have hNcard : Nat.card N = 1 := by
      have hpos : 0 < Nat.card W2 := Nat.card_pos
      change Nat.card (W2 ⧸ (H0 ⊓ W2 : Subgroup G).subgroupOf W2) =
        Nat.card W2 at hcard
      rw [hcard] at hmul
      symm
      exact Nat.eq_of_mul_eq_mul_left hpos (by simpa using hmul)
    exact (Subgroup.eq_bot_iff_card (H := N)).2 hNcard
  have hdisj : Disjoint (H0 ⊓ W2 : Subgroup G) W2 :=
    Subgroup.subgroupOf_eq_bot.mp hNbot
  exact hdisj.eq_bot_of_le inf_le_right

