      _hW, _hA0, _h46, hω, _hIso, _hVirt, _hPrin, _hσAgreeCyc, _h45, _h48, _hTauA0,
        _hFull⟩
  rcases (hR φ).mp hφ with ⟨η, hη, rfl⟩
  rcases hω.all_irreducibles η hη with ⟨p, k, rfl⟩
  have hsum :
      Section1.scalarProduct G
          (Finset.sum Finset.univ (fun i : I => σ (ω i j0))) (σ (ω p k)) =
        if k = j0 then 1 else 0 := by
    have hsumfun :
        ((∑ i : I, σ (ω i j0) : Section1.ClassFunction G)) =
          fun g => ∑ i : I, σ (ω i j0) g := by
      ext g
      simp
    rw [hsumfun, Section1.scalarProduct_fintype_sum_left]
    simp_rw [Section10.scalarProduct_sigma_omega_eq_pair_ite_of_section10FourSixNotationSupportedData
      ⟨_MF, _Ms, _Abook, _A0book, _A1book, _hSource, _hW, _hA0, _h46, hω,
        _hIso, _hVirt, _hPrin, _hσAgreeCyc, _h45, _h48, _hTauA0, _hFull⟩]
    by_cases hk : k = j0
    · rw [if_pos hk]
      calc
        (∑ i : I, if (i, j0) = (p, k) then (1 : ℂ) else 0) =
            if (p, j0) = (p, k) then (1 : ℂ) else 0 := by
          refine Finset.sum_eq_single (s := Finset.univ) (a := p)
            (f := fun i : I => if (i, j0) = (p, k) then (1 : ℂ) else 0) ?_ ?_
          · intro i _hi hip
            have hp : (i, j0) ≠ (p, k) := by
              intro hpair
              exact hip (congrArg Prod.fst hpair)
            simp [hp]
          · intro hp
            exact (hp (Finset.mem_univ p)).elim
        _ = 1 := by simp [hk]
    · rw [if_neg hk]
      refine Finset.sum_eq_zero ?_
      intro i _hi
      have hp : (i, j0) ≠ (p, k) := by
        intro hpair
        exact hk ((congrArg Prod.snd hpair).symm)
      simp [hp]
  have ha_indicator : a p k = if k = j0 then 1 else 0 := by
    by_cases hk : k = j0
    · simp [hk, hcol p]
    · simp [hk, hzero p k hk]
  rw [Section5.scalarProduct_sub_left, ← ha p k, hsum, ha_indicator]
  by_cases hk : k = j0 <;> simp [hk]

/-- Axis/rectangle algebra for the temporary `a₁₀ ≠ 0` branch in PF `(11.9)(a)`.

Once the source norm inequality has identified `a₁₁ = 0` and `a₀₁ = 0` in the
temporary branch, the base coefficient and rectangle relation first force
`a₁₀ = 1`; then the Galois axis constancy and rectangle relation force the whole
coefficient matrix to be the base-column indicator. -/
private theorem theorem_11_9_base_column_indicator_of_axis_seed_nonzero
    {I J : Type*}
    [DecidableEq I]
    [DecidableEq J]
    (a : I → J → ℂ)
    (i0 i1 : I)
    (j0 j1 : J) :
    i1 ≠ i0 →
      j1 ≠ j0 →
        a i0 j0 = 1 →
          (∀ i i' j j', a i j + a i' j' = a i j' + a i' j) →
            (∀ i, i ≠ i0 → a i j0 = a i1 j0) →
              (∀ j, j ≠ j0 → a i0 j = a i0 j1) →
                a i1 j1 = 0 →
                  (a i1 j0 ≠ 0 → a i0 j1 = 0) →
                  a i1 j0 ≠ 0 →
                    (∀ i, a i j0 = 1) ∧
                      ∀ i j, j ≠ j0 → a i j = 0 := by
  intro hi1 _hj1 hbase hrect hcolConst hrowConst hdiagSeed hrowSeedOfNonzero hne
  have hrowSeedZero : a i0 j1 = 0 := hrowSeedOfNonzero hne
  have hcolSeedOne : a i1 j0 = 1 := by
    have h := hrect i1 i0 j1 j0
    rw [hdiagSeed, hbase, hrowSeedZero] at h
    simpa using h.symm
  have hcol : ∀ i, a i j0 = 1 := by
    intro i
    by_cases hi : i = i0
    · simpa [hi] using hbase
    · exact (hcolConst i hi).trans hcolSeedOne
  have hrow : ∀ j, j ≠ j0 → a i0 j = 0 := by
    intro j hj
    exact (hrowConst j hj).trans hrowSeedZero
  refine ⟨hcol, ?_⟩
  intro i j hj
  by_cases hi : i = i0
  · simpa [hi] using hrow j hj
  · have h := hrect i i0 j j0
    rw [hcol i, hcol i0, hrow j hj] at h
    have h' := congrArg (fun z : ℂ => z - 1) h
    ring_nf at h'
    exact h'

/-- A nonzero integer, viewed as a complex number, has norm-square at least
`1`. -/
private theorem theorem_11_9_one_le_normSq_intCast_of_ne_zero
    (z : ℤ) (hz : (z : ℂ) ≠ 0) :
    (1 : ℝ) ≤ Complex.normSq (z : ℂ) := by
  have hz0 : z ≠ 0 := by
    intro hz0
    apply hz
    simp [hz0]
  have hzz : (1 : ℤ) ≤ z * z := by
    have hpos : 0 < z * z := (mul_self_pos).2 hz0
    omega
  have hreal : (1 : ℝ) ≤ (z : ℝ) * (z : ℝ) := by
    exact_mod_cast hzz
  simpa [Complex.normSq, pow_two] using hreal

/-- Norm arithmetic in PF `(11.9)(a)`.

Once the source proof supplies integer witnesses for the three seed
coefficients and the displayed norm bound, the non-base/non-base seed vanishes;
under the temporary `a10 != 0` branch the base-row seed also vanishes. -/
private theorem theorem_11_9_axis_norm_seed_of_integer_bound
    (p q : ℕ) (a10 a01 a11 : ℂ) :
    Nat.Prime p → Odd p → Nat.Prime q →
      (∃ z : ℤ, a10 = (z : ℂ)) →
      (∃ z : ℤ, a01 = (z : ℂ)) →
      (∃ z : ℤ, a11 = (z : ℂ)) →
      (1 + ((q - 1 : ℕ) : ℝ) * Complex.normSq a10 +
          ((p - 1 : ℕ) : ℝ) * Complex.normSq a01 +
          (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) * Complex.normSq a11 ≤
        (q : ℝ)) →
      a11 = 0 ∧ (a10 ≠ 0 → a01 = 0) := by
  intro hp hoddp hq h10int h01int h11int hbound
  have hpne2 : p ≠ 2 := by
    intro hp2
    subst p
    rcases hoddp with ⟨k, hk⟩
    omega
  have hp_sub2_nat : 2 ≤ p - 1 := by
    have hp2le : 2 ≤ p := hp.two_le
    omega
  have hq1 : 1 ≤ q := by
    have hq2 : 2 ≤ q := hq.two_le
    omega
  have hq_sub_pos_nat : 0 < q - 1 :=
    Nat.sub_pos_of_lt hq.one_lt
  have hq_base : (1 : ℝ) + ((q - 1 : ℕ) : ℝ) = (q : ℝ) := by
    rw [Nat.cast_sub hq1]
    norm_num
  have hp_sub2 : (2 : ℝ) ≤ ((p - 1 : ℕ) : ℝ) := by
    exact_mod_cast hp_sub2_nat
  have hp_sub_nonneg : (0 : ℝ) ≤ ((p - 1 : ℕ) : ℝ) := by
    exact_mod_cast (Nat.zero_le (p - 1))
  have hq_sub_nonneg : (0 : ℝ) ≤ ((q - 1 : ℕ) : ℝ) := by
    exact_mod_cast (Nat.zero_le (q - 1))
  have hq_sub_pos : (0 : ℝ) < ((q - 1 : ℕ) : ℝ) := by
    exact_mod_cast hq_sub_pos_nat
  have hpq_sub_lower :
      (q : ℝ) < 1 + (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) := by
    rw [Nat.cast_mul]
    rw [← hq_base]
    nlinarith
  have h10_nonneg : (0 : ℝ) ≤ ((q - 1 : ℕ) : ℝ) * Complex.normSq a10 :=
    mul_nonneg hq_sub_nonneg (Complex.normSq_nonneg a10)
  have h01_nonneg : (0 : ℝ) ≤ ((p - 1 : ℕ) : ℝ) * Complex.normSq a01 :=
    mul_nonneg hp_sub_nonneg (Complex.normSq_nonneg a01)
  have h11zero : a11 = 0 := by
    rcases h11int with ⟨z11, hz11⟩
    by_contra hne
    have hz11ne : (z11 : ℂ) ≠ 0 := by
      intro hz
      exact hne (by simpa [hz11] using hz)
    have hnorm11 : (1 : ℝ) ≤ Complex.normSq (z11 : ℂ) :=
      theorem_11_9_one_le_normSq_intCast_of_ne_zero z11 hz11ne
    have h11term_lower :
        (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) ≤
          (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) *
            Complex.normSq (z11 : ℂ) := by
      have hcoef_nonneg :
          (0 : ℝ) ≤ (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) := by
        exact_mod_cast (Nat.zero_le ((p - 1) * (q - 1)))
      nlinarith
    have hbound' :
        1 + ((q - 1 : ℕ) : ℝ) * Complex.normSq a10 +
            ((p - 1 : ℕ) : ℝ) * Complex.normSq a01 +
            (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) *
              Complex.normSq (z11 : ℂ) ≤
          (q : ℝ) := by
      simpa [hz11] using hbound
    nlinarith [h10_nonneg, h01_nonneg, h11term_lower, hpq_sub_lower, hbound']
  refine ⟨h11zero, ?_⟩
  intro h10ne
  rcases h10int with ⟨z10, hz10⟩
  rcases h01int with ⟨z01, hz01⟩
  by_contra h01ne
  have hz10ne : (z10 : ℂ) ≠ 0 := by
    intro hz
    exact h10ne (by simpa [hz10] using hz)
  have hz01ne : (z01 : ℂ) ≠ 0 := by
    intro hz
    exact h01ne (by simpa [hz01] using hz)
  have hnorm10 : (1 : ℝ) ≤ Complex.normSq (z10 : ℂ) :=
    theorem_11_9_one_le_normSq_intCast_of_ne_zero z10 hz10ne
  have hnorm01 : (1 : ℝ) ≤ Complex.normSq (z01 : ℂ) :=
    theorem_11_9_one_le_normSq_intCast_of_ne_zero z01 hz01ne
  have h10term_lower :
      ((q - 1 : ℕ) : ℝ) ≤ ((q - 1 : ℕ) : ℝ) *
        Complex.normSq (z10 : ℂ) := by
    nlinarith [hq_sub_nonneg, hnorm10]
  have h01term_lower :
      ((p - 1 : ℕ) : ℝ) ≤ ((p - 1 : ℕ) : ℝ) *
        Complex.normSq (z01 : ℂ) := by
    nlinarith [hp_sub_nonneg, hnorm01]
  have h11term_nonneg :
      (0 : ℝ) ≤ (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) *
        Complex.normSq a11 := by
    exact mul_nonneg
      (by exact_mod_cast (Nat.zero_le ((p - 1) * (q - 1))))
      (Complex.normSq_nonneg a11)
  have hbound' :
      1 + ((q - 1 : ℕ) : ℝ) * Complex.normSq (z10 : ℂ) +
          ((p - 1 : ℕ) : ℝ) * Complex.normSq (z01 : ℂ) +
          (((p - 1 : ℕ) * (q - 1 : ℕ) : ℕ) : ℝ) * Complex.normSq a11 ≤
        (q : ℝ) := by
    simpa [hz10, hz01] using hbound
  nlinarith [h10term_lower, h01term_lower, h11term_nonneg, hp_sub2, hq_base, hbound']

private theorem theorem_11_9_isVirtualCharacter_finset_sum
    {G : Type u}
    [Group G]
    [Finite G]
    {ι : Type*}
    (s : Finset ι)
    (Φ : ι → Section1.ClassFunction G)
    (hΦ : ∀ i ∈ s, Theory.Character.IsVirtualCharacter (Φ i)) :
    Theory.Character.IsVirtualCharacter (Finset.sum s Φ) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      have hzero : Theory.Character.IsVirtualCharacter (0 : Section1.ClassFunction G) := by
        simpa using
          Section3.isVirtualCharacter_sub
            (χ := Section1.principalCharacter G)
            (ψ := Section1.principalCharacter G)
            Section3.isVirtualCharacter_principalCharacter
            Section3.isVirtualCharacter_principalCharacter
      simpa using hzero
  | @insert a s ha ih =>
      have ha' : Theory.Character.IsVirtualCharacter (Φ a) :=
        hΦ a (Finset.mem_insert_self a s)
      have hs' : Theory.Character.IsVirtualCharacter (Finset.sum s Φ) := by
        exact ih (by
          intro i hi
          exact hΦ i (Finset.mem_insert_of_mem hi))
      simpa [Finset.sum_insert ha] using Section3.isVirtualCharacter_add ha' hs'

private theorem theorem_11_9_isVirtualCharacter_intCast_smul
    {G : Type u}
