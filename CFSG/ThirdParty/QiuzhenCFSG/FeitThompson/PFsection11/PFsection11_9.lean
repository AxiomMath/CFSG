/-- The `p - 1` reducible characters supplied by PF `(9.8)` or `(9.9)`
are exactly the non-base Section 10 columns. -/
private theorem theorem_11_8_all_nonbase_muColumn_mem_reducible_family
    {G : Type u}
    [Group G]
    [Finite G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (W : Subgroup M)
    (A A0 : Set M)
    (S SH0 R : Finset (Section1.ClassFunction M))
    (i0 : I)
    (j0 : J)
    (μ : I → J → Section1.ClassFunction M)
    (δSign : J → ℤ)
    (ω : I → J → Section1.ClassFunction W)
    (σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G)
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q degree : ℕ)
    (h11 : hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q)
    (hNotation :
      Section10.section10FourSixNotationSupportedData
        M W1 W2 W A A0 i0 j0 μ δSign ω σ τ)
    (hSH0sub : SH0 ⊆ S)
    (hRcard : R.card = p - 1)
    (hRdata : Section9.reducibleCharacterSubfamilyData M SH0 R degree) :
    ∀ j : J, j ≠ j0 → Section10.muColumn μ j ∈ R := by
  classical
  have h10 := h11.1
  have hpW2 : p = Nat.card W2 := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, hpW2, _hqW1, _hPDef, _hOdd, _h92⟩
    exact hpW2
  have hJcard : Nat.card J = Nat.card W2 :=
    Section10.uniformMu_card_J_eq_card_W2_of_hypothesis_10_1_supported_data
      h10 hNotation
  rcases
      Section10.supportedFourSixData_of_section10FourSixNotationSupportedData
        hNotation with
    ⟨_σM, _xChar, _H_A, _H_A0, hFull⟩
  rcases hFull with
    ⟨h46, _hW2K, _h31, _hIso, _hVirt, _hClass, _hPrin, _h22A, hFullRest⟩
  rcases hFullRest with
    ⟨hω, h43b, _h43c, _h43d, h45a, h45b, _hTauCyc, _hTauA0,
      _hTauIso, _hTauPunct, _hTauVirt, _hAmbientColumn⟩
  have hInd :
      Section5.inducedFromNonkernelFamily_statement
        (derivedSubgroup M) (derivedSubgroup M) S :=
    Section10.inducedFromNonkernelFamily_of_hypothesis_10_1_supported_data h10
  let RedS : Finset (Section1.ClassFunction M) :=
    S.filter fun χ => ¬ Section1.IsIrreducibleCharacterOnGroup χ
  let Columns : Finset (Section1.ClassFunction M) :=
    (Finset.univ.erase j0).image (Section10.muColumn μ)
  have hRedSsubColumns : RedS ⊆ Columns := by
    intro χ hχ
    have hχpair :
        χ ∈ S ∧ ¬ Section1.IsIrreducibleCharacterOnGroup χ := by
      simpa [RedS] using hχ
    rcases Section5.theorem_5_3_b_nonbase_piColumn_pf53
        hω h43b h45a h45b hInd ⟨χ, hχpair.1⟩ hχpair.2 with
      ⟨j, hj, hχeq⟩
    exact Finset.mem_image.mpr ⟨j, by simp [hj], by
      simpa [Section10.muColumn, Section4Scratch.piColumn] using hχeq.symm⟩
  have hColumnInj : Function.Injective (Section10.muColumn μ) := by
    intro x y h
    apply (Section5.piColumn_injective_pf58 hω h43b)
    simpa [Section10.muColumn, Section4Scratch.piColumn] using h
  have hColumnsCard : Columns.card = p - 1 := by
    calc
      Columns.card = (Finset.univ.erase j0).card :=
        Finset.card_image_of_injective _ hColumnInj
      _ = Fintype.card J - 1 := by simp
      _ = Nat.card J - 1 := by rw [Nat.card_eq_fintype_card]
      _ = Nat.card W2 - 1 := by rw [hJcard]
      _ = p - 1 := by rw [hpW2]
  have hRsubRedS : R ⊆ RedS := by
    intro χ hχR
    have hχSH0 := hRdata.1 hχR
    have hχred := (hRdata.2.1 χ hχR).1
    simp [RedS, hSH0sub hχSH0, hχred]
  have hRedSCard : RedS.card = p - 1 := by
    have hupper : RedS.card ≤ p - 1 := by
      rw [← hColumnsCard]
      exact Finset.card_le_card hRedSsubColumns
    have hlower : p - 1 ≤ RedS.card := by
      rw [← hRcard]
      exact Finset.card_le_card hRsubRedS
    omega
  have hReqRedS : R = RedS :=
    Finset.eq_of_subset_of_card_le hRsubRedS (by rw [hRcard, hRedSCard])
  intro j hj
  have hmuS : Section10.muColumn μ j ∈ S :=
    Section10.muColumn_mem_of_hypothesis_10_1_supported_and_section10FourSixNotationSupportedData
      h10 hNotation hj
  have hmuRed :
      ¬ Section1.IsIrreducibleCharacterOnGroup (Section10.muColumn μ j) := by
    simpa [Section10.muColumn, Section4Scratch.piColumn] using
      (Section5.piColumn_not_irreducible_pf53 h46 hω h43b j)
  have hmuRedS : Section10.muColumn μ j ∈ RedS := by
    simp [RedS, hmuS, hmuRed]
  simpa [hReqRedS] using hmuRedS

