    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      C = ambientDerivedSubgroup U := by
  intro h11
  exact le_antisymm
    (theorem_11_6_C_le_ambientDerived_U_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11)
    (theorem_11_6_ambientDerived_U_le_C_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11)

/-- Source bridge for the PF `(9.6)` plus `(9.1)` step in `(11.6)`.

The intended route is: PF `(9.6)` gives `C_{H0}(W1) = 1`, and PF `(9.1)`,
applied to the Frobenius action of `U W1` on `H0`, then gives
`C_{H0}(U) = H0`. -/
private theorem theorem_11_6_le_centralizer_right_of_left_eq
    {G : Type u}
    [Group G]
    (U H : Subgroup G) :
    subgroupCentralizerIn H U = H →
      U ≤ subgroupCentralizerIn U H := by
  intro hcentral x hxU
  refine ⟨hxU, ?_⟩
  change x ∈ Subgroup.centralizer (H : Set G)
  rw [Subgroup.mem_centralizer_iff]
  intro y hyH
  have hyCU : y ∈ subgroupCentralizerIn H U := by
    simpa [hcentral] using hyH
  have hyCentU : y ∈ Subgroup.centralizer (U : Set G) := by
    simpa [subgroupCentralizerIn] using hyCU.2
  exact (hyCentU x hxU).symm

/-- If a subgroup centralizer has full cardinality, it is the full subgroup. -/
private theorem theorem_11_6_subgroupCentralizerIn_eq_left_of_card_eq
    {G : Type u}
    [Group G]
    [Finite G]
    (H S : Subgroup G) :
    Nat.card (subgroupCentralizerIn H S) = Nat.card H →
      subgroupCentralizerIn H S = H := by
  intro hcard
  let Csub : Subgroup H := (subgroupCentralizerIn H S).subgroupOf H
  have hCsub_card : Nat.card Csub = Nat.card H := by
    simpa [Csub] using
      (natCard_subgroupOf_eq (subgroupCentralizerIn H S) H inf_le_left).trans hcard
  have hCsub_top : Csub = ⊤ :=
    (Subgroup.card_eq_iff_eq_top (H := Csub)).1 hCsub_card
  apply le_antisymm
  · exact inf_le_left
  · intro x hxH
    have hxCsub : (⟨x, hxH⟩ : H) ∈ Csub := by
      simp [hCsub_top]
    simpa [Csub, Subgroup.mem_subgroupOf] using hxCsub

/-- The algebraic consequence of PF `(9.1)` used in `(11.6)`: if the
`W1`-fixed subgroup in `H0` is trivial, the PF `(9.1)` cardinal identity
forces `U` to centralize all of `H0`. -/
private theorem theorem_11_6_centralizer_eq_of_nineOne_card
    {G : Type u}
    [Group G]
    [Finite G]
    (U E H : Subgroup G)
    (hcard :
      Nat.card (subgroupCentralizerIn H (U ⊔ E)) ^ Nat.card E * Nat.card H =
        Nat.card (subgroupCentralizerIn H E) ^ Nat.card E *
          Nat.card (subgroupCentralizerIn H U)) :
    subgroupCentralizerIn H E = ⊥ →
      subgroupCentralizerIn H U = H := by
  intro hCE_bot
  have hCUE_bot : subgroupCentralizerIn H (U ⊔ E) = ⊥ := by
    apply le_antisymm
    · intro x hx
      have hx' : x ∈ H ∧ x ∈ Subgroup.centralizer ((U ⊔ E : Subgroup G) : Set G) := by
        simpa [subgroupCentralizerIn] using hx
      have hxE : x ∈ Subgroup.centralizer (E : Set G) := by
        rw [Subgroup.mem_centralizer_iff] at hx' ⊢
        intro e he
        exact hx'.2 e ((show E ≤ U ⊔ E from le_sup_right) he)
      have hxCE : x ∈ subgroupCentralizerIn H E := by
        simpa [subgroupCentralizerIn] using And.intro hx'.1 hxE
      simpa [hCE_bot] using hxCE
    · exact bot_le
  have hCU_card : Nat.card (subgroupCentralizerIn H U) = Nat.card H := by
    have h := hcard.symm
    simpa [hCUE_bot, hCE_bot] using h
  exact theorem_11_6_subgroupCentralizerIn_eq_left_of_card_eq H U hCU_card

/-- Source bridge for the PF `(9.1)` cardinal identity used in `(11.6)`. -/
private theorem theorem_11_6_frobeniusActionData_H0_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.frobeniusActionData (U ⊔ W1) U W1 H0 := by
  intro h11
  have h92 : Section9.hypothesis_9_2_statement M MF U W1 W2 q :=
    theorem_11_hypothesis_9_2_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  rcases Section9.theorem_9_3_source_action_and_branch_facts_sec9
      M MF U W1 W2 q h92 with
    ⟨hFrobMF, _hII, _hIIIIV⟩
  rcases hFrobMF with ⟨hcomp, hfrob, _hMFnorm, _hMFsolv, hcopMF⟩
  refine ⟨hcomp, hfrob, ?_, ?_, ?_⟩
  · have hUEleM : U ⊔ W1 ≤ M := by
      exact sup_le
        (theorem_11_3_U_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11)
        (theorem_11_3_W1_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11)
    have hH0normM : section10NormalIn H0 M := by
      rcases h11 with
        ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, hH0normM,
          _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
      exact hH0normM
    exact hUEleM.trans
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hH0normM.1).1 hH0normM.2)
  · have hH0H : H0 ≤ H :=
      theorem_11_3_H0_le_H_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
    have hHnil : Group.IsNilpotent H :=
      theorem_11_3_H_nilpotent_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
    have hH0sub_nil : Group.IsNilpotent (H0.subgroupOf H) := by
      haveI : Group.IsNilpotent H := hHnil
      infer_instance
    have hH0nil : Group.IsNilpotent H0 :=
      Group.nilpotent_of_mulEquiv (G := H0.subgroupOf H) (G' := H0)
        (Subgroup.subgroupOfEquivOfLe hH0H)
    haveI : Group.IsNilpotent H0 := hH0nil
    exact (inferInstance : Group.IsSolvable H0)
  · have hH0MF : H0 ≤ MF := by
      have hH0H : H0 ≤ H :=
        theorem_11_3_H0_le_H_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
      rcases h11 with ⟨_h10, hHMF, _rest⟩
      simpa [hHMF] using hH0H
    exact Nat.Coprime.coprime_dvd_left (Subgroup.card_dvd_of_le hH0MF) hcopMF

private theorem theorem_11_6_nineOne_card_H0_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
