      Section1.scalarProduct G (χ i) (χ j) = if i = j then 1 else 0)
    (h : Section1.weightedFamilySum w χ = Section1.weightedFamilySum v χ)
    (i : ι) :
    w i = v i := by
  have hsp := congrArg (fun φ => Section1.scalarProduct G φ (χ i)) h
  simpa [
    Section1.scalarProduct_weightedFamilySum_left_orthonormal w χ horth i,
    Section1.scalarProduct_weightedFamilySum_left_orthonormal v χ horth i] using hsp

