      M MF H U C H0 W1 W2 S τ p q h11Full with
    ⟨_hp, hqprime, _hpodd, hqodd, _hpq⟩
  rcases h11 with
    ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
      _hp, _hquot, _hchief, _hcomm, _hpW2, hqW1, _hPDef, _hOddAnd92⟩
  rcases hCount with ⟨⟨j, hj, hcolSource⟩, hcount, hS1card⟩
  have hcolUniform :
