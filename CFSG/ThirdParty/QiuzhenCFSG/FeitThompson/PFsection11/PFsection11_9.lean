      M MF H U C H0 W1 W2 S τ p q h11 with
    ⟨SH0, hSH0, hSH0sub⟩
  have hUleD : U ≤ ambientDerivedSubgroup M := by
    rcases h11 with ⟨_h10, _hHMF, _htype, _hHleD, hUleD, _hrest⟩
    exact hUleD
  have hCleU : C ≤ U := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, hCeq, _hrest⟩
