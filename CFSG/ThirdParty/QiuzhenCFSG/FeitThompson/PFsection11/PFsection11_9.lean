      have hsub :=
        Subgroup.relIndex_subgroupOf (H := MF) (K := D) (L := M) hDleM
      simpa [Dsub, Subgroup.relIndex] using hsub.symm
    have hidx_dvd :
        (MF.subgroupOf D).index ∣ (MF.subgroupOf M).index := by
      have hrel_dvd :
