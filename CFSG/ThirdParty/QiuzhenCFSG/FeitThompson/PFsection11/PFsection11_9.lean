  have hSH0subS : SH0 ⊆ S :=
    theorem_11_kernel_family_subset_S_of_hypothesis
      M MF H U C H0 W1 W2 H0 S SH0 τ p q h11 hSH0
  have hRsubRedS : R ⊆ RedS := by
    intro χ hχR
