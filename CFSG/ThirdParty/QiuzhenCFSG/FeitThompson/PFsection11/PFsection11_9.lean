      exact Subgroup.subgroupOf_mono M le_sup_right
    have hW1oddSub : Odd (Nat.card (W1.subgroupOf M)) :=
      Odd.of_dvd_nat hoddW (Subgroup.card_dvd_of_le hW1sub_le_W)
    have hW2oddSub : Odd (Nat.card (W2.subgroupOf M)) :=
      Odd.of_dvd_nat hoddW (Subgroup.card_dvd_of_le hW2sub_le_W)
    have hW1cardSub : Nat.card (W1.subgroupOf M) = Nat.card W1 :=
      natCard_subgroupOf_eq W1 M hW1M
    have hW2cardSub : Nat.card (W2.subgroupOf M) = Nat.card W2 :=
      natCard_subgroupOf_eq W2 M hW2M
    rw [hW1cardSub] at hW1oddSub
    rw [hW2cardSub] at hW2oddSub
    exact ⟨hW1oddSub, hW2oddSub⟩
  have hpodd : Odd p := by
    simpa [hpW2] using hoddCards.2
  have hqodd : Odd q := by
    simpa [hqW1] using hoddCards.1
  have hpne : p ≠ q := by
    intro hpq
    have hDcardSub : Nat.card (D.subgroupOf M) = Nat.card D :=
      natCard_subgroupOf_eq D M hDleM
    have hp_dvd_D : p ∣ Nat.card (D.subgroupOf M) := by
      have hW2leD : W2 ≤ D := by
        intro x hx
        have hxSecond : x ∈ section16SecondDerivedSubgroup M := (hW2leInf hx).2
        dsimp [D, section16SecondDerivedSubgroup] at hxSecond ⊢
        exact section12_ambientDerivedSubgroup_le hxSecond
      have hW2dvdD : Nat.card W2 ∣ Nat.card D :=
        Subgroup.card_dvd_of_le hW2leD
      rw [hDcardSub, hpW2]
      exact hW2dvdD
    have hidx : (D.subgroupOf M).index = Nat.card W1 := by
      change ((ambientDerivedSubgroup M).subgroupOf M).index = Nat.card W1
      simpa [Subgroup.relIndex, section12_ambientDerivedSubgroup_subgroupOf_eq]
        using hW1card
    have hp_dvd_index : p ∣ (D.subgroupOf M).index := by
      rw [hidx, ← hqW1, ← hpq]
    have hp_one : p = 1 :=
      Nat.eq_one_of_dvd_coprimes hDhall.card_coprime_index hp_dvd_D hp_dvd_index
    exact hp.ne_one hp_one
  exact ⟨hp, hqprime, hpodd, hqodd, hpne⟩

/-- Hypothesis `(11.2)` identifies `C = C_U(H)`, so every element of `C`
centralizes the quotient `MF/H0` after rewriting `H = MF`. This is only the
weak centralization half of the PF `(9.5)` quotient-centralizer setup. -/
private theorem theorem_11_quotientCentralizedBy_C_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.quotientCentralizedBy MF H0 C := by
  intro h11 x hxC h hhMF
  rcases h11 with
    ⟨_h10, hHMF, _htype, _hHleD, _hUleD, hCeq, _hH0H, _hH0normM,
      _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
  have hxC' : x ∈ subgroupCentralizerIn U H := by
    simpa [hCeq] using hxC
  have hxCentH : x ∈ Subgroup.centralizer (H : Set G) := by
    have hxParts : x ∈ U ∧ x ∈ Subgroup.centralizer (H : Set G) := by
      simpa [subgroupCentralizerIn] using hxC'
    exact hxParts.2
  have hhH : h ∈ H := by
    simpa [hHMF] using hhMF
  have hcomm : ⁅x, h⁆ = 1 :=
    (commutatorElement_eq_one_iff_mul_comm (g₁ := x) (g₂ := h)).mpr
      (Subgroup.mem_centralizer_iff.mp hxCentH h hhH).symm
  rw [hcomm]
  exact H0.one_mem

/-- Hypothesis `(11.2)` supplies the normal quotient `U/C` and hence the
cardinality package used in PF `(9.5)`. -/
private theorem theorem_11_quotientBarUCardinality_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ∃ u : ℕ, Section9.quotientBarUCardinality U C u := by
  intro h11
  rcases h11 with
    ⟨h10, hHMF, htype, hHleD, hUleD, hCeq, hH0H, hH0normM,
      hp, hquot, hchief, hcomm, hpW2, hqW1, hPDef, hOddAnd92⟩
  have h11' : hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q := by
    exact ⟨h10, hHMF, htype, hHleD, hUleD, hCeq, hH0H, hH0normM,
      hp, hquot, hchief, hcomm, hpW2, hqW1, hPDef, hOddAnd92⟩
  have hC_le_U : C ≤ U := by
    rw [hCeq]
    exact inf_le_left
  have hU_le_M : U ≤ M :=
    theorem_11_3_U_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hC_norm_M : (C.subgroupOf M).Normal :=
    theorem_11_3_C_normal_subgroupOf_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hM_le_norm_C : M ≤ Subgroup.normalizer (C : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer
      (theorem_11_3_C_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11')).1
      hC_norm_M
  have hC_norm_U : (C.subgroupOf U).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hC_le_U).2
      (hU_le_M.trans hM_le_norm_C)
  refine ⟨Nat.card (U ⧸ C.subgroupOf U), hC_le_U, ?_⟩
  exact ⟨hC_norm_U, rfl⟩

private theorem theorem_11_quotientBarUCardinality_eq_card_div
    {G : Type u}
    [Group G]
    [Finite G]
    (U C : Subgroup G)
    (u : ℕ) :
    Section9.quotientBarUCardinality U C u →
      u = Nat.card U / Nat.card C := by
  intro hBarU
  rcases hBarU with ⟨hCU, hnormal, hcard⟩
  letI : (C.subgroupOf U).Normal := hnormal
  have hCsub_card : Nat.card (C.subgroupOf U) = Nat.card C :=
    natCard_subgroupOf_eq C U hCU
  have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup (s := C.subgroupOf U)
  rw [hcard, hCsub_card] at hmul
  rw [hmul, Nat.mul_comm u (Nat.card C), Nat.mul_div_right _ Nat.card_pos]

/-- An alternating multiplicative pairing vanishes on a cyclic subgroup. -/
private theorem theorem_11_7_pairing_eq_one_on_cyclic_subgroup
    {A B : Type*}
    [Group A]
    [Group B]
    (pairing : A → A → B)
    (hmulLeft : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (hmulRight : ∀ a b c : A, pairing a (b * c) = pairing a b * pairing a c)
    (hself : ∀ a : A, pairing a a = 1)
    (Q : Subgroup A)
    (hQcyc : IsCyclic Q)
    {x y : A}
    (hx : x ∈ Q)
    (hy : y ∈ Q) :
    pairing x y = 1 := by
  have honeLeft : ∀ y : A, pairing 1 y = 1 := by
    intro y
    have h := hmulLeft 1 1 y
    simpa using (congrArg (fun z => (pairing 1 y)⁻¹ * z) h).symm
  have honeRight : ∀ x : A, pairing x 1 = 1 := by
    intro x
    have h := hmulRight x 1 1
    simpa using (congrArg (fun z => (pairing x 1)⁻¹ * z) h).symm
  let leftHom (z : A) : A →* B :=
    { toFun := fun t => pairing t z
      map_one' := honeLeft z
      map_mul' := fun a b => hmulLeft a b z }
  let rightHom (z : A) : A →* B :=
    { toFun := fun t => pairing z t
      map_one' := honeRight z
      map_mul' := hmulRight z }
  letI : IsCyclic Q := hQcyc
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Q)
  rcases Subgroup.mem_zpowers_iff.mp (hg ⟨x, hx⟩) with ⟨m, hm⟩
  rcases Subgroup.mem_zpowers_iff.mp (hg ⟨y, hy⟩) with ⟨n, hn⟩
  have hxpow : x = (g : A) ^ m := by
    simpa using congrArg Subtype.val hm.symm
  have hypow : y = (g : A) ^ n := by
    simpa using congrArg Subtype.val hn.symm
  rw [hxpow, hypow]
  change leftHom ((g : A) ^ n) ((g : A) ^ m) = 1
  rw [map_zpow]
  change (rightHom (g : A) ((g : A) ^ n)) ^ m = 1
  rw [map_zpow]
  simp [rightHom, hself]

/-- Once pairings between distinct cyclic components vanish, multiplicativity
and generation by the components give pointwise vanishing. -/
private theorem theorem_11_7_pairing_component_vanish_of_cross
    {A B ι : Type*}
    [Group A]
    [Group B]
    (pairing : A → A → B)
    (hmulLeft : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (hmulRight : ∀ a b c : A, pairing a (b * c) = pairing a b * pairing a c)
    (hself : ∀ a : A, pairing a a = 1)
    (components : ι → Subgroup A)
    (hcomponentsTop : iSup components = ⊤)
    (hcyclic : ∀ i, IsCyclic (components i))
    (hcross : ∀ i j, i ≠ j → ∀ x, x ∈ components i →
      ∀ y, y ∈ components j → pairing x y = 1) :
    ∀ i, ∀ x, x ∈ components i → ∀ y, pairing x y = 1 := by
  intro i x hx
  let K : Subgroup A :=
    { carrier := {y | pairing x y = 1}
      one_mem' := by
        have h := hmulRight x 1 1
        simpa using (congrArg (fun z => (pairing x 1)⁻¹ * z) h).symm
      mul_mem' := by
        intro y z hy hz
        change pairing x y = 1 at hy
        change pairing x z = 1 at hz
        change pairing x (y * z) = 1
        rw [hmulRight, hy, hz, mul_one]
      inv_mem' := by
        intro y hy
        change pairing x y = 1 at hy
        change pairing x y⁻¹ = 1
        have hone : pairing x 1 = 1 := by
          have h := hmulRight x 1 1
          simpa using (congrArg (fun z => (pairing x 1)⁻¹ * z) h).symm
        have h := hmulRight x y⁻¹ y
        have hprod : pairing x y⁻¹ * pairing x y = 1 := by
          simpa [hone] using h.symm
        simpa [hy] using hprod }
  have hcomponentLe : ∀ j, components j ≤ K := by
    intro j y hy
    change pairing x y = 1
    by_cases hij : i = j
    · subst j
      exact theorem_11_7_pairing_eq_one_on_cyclic_subgroup
        pairing hmulLeft hmulRight hself (components i) (hcyclic i) hx hy
    · exact hcross i j hij x hx y hy
  have htopLe : (⊤ : Subgroup A) ≤ K := by
    rw [← hcomponentsTop]
    exact iSup_le hcomponentLe
  intro y
  exact htopLe (Subgroup.mem_top y)


private theorem theorem_11_7_hom_eq_one_of_odd_action_inversion
    {W X A : Type*}
    [Group W]
    [Finite W]
    [Group X]
    [Finite X]
    [Group A]
    [MulAction W X]
    (hWodd : Odd (Nat.card W))
    (hXodd : Odd (Nat.card X))
    (φ : X →* A)
    (w : W)
    (hinv : ∀ x : X, φ (w • x) = (φ x)⁻¹) :
    ∀ x : X, φ x = 1 := by
  have horderWodd : Odd (orderOf w) :=
    Odd.of_dvd_nat hWodd (orderOf_dvd_natCard w)
  have hselfInv : ∀ x : X, φ x = (φ x)⁻¹ := by
    intro x
    by_cases hwone : orderOf w = 1
    · have hw : w = 1 := orderOf_eq_one_iff.mp hwone
      simpa [hw] using hinv x
    · have horderWgt : 1 < orderOf w := by
        exact lt_of_le_of_ne (Nat.succ_le_of_lt (orderOf_pos w)) (Ne.symm hwone)
      have hcop : Nat.Coprime 2 (orderOf w) :=
        horderWodd.coprime_two_right.symm
      obtain ⟨m, _hmLt, hm⟩ :=
        Nat.exists_mul_mod_eq_one_of_coprime hcop horderWgt
      have hwPow : (w ^ 2) ^ m = w := by
        rw [← pow_mul, ← pow_mod_orderOf, hm, pow_one]
      have hevenInvariant : ∀ n : ℕ, φ ((w ^ 2) ^ n • x) = φ x := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
            rw [pow_succ', mul_smul]
            calc
              φ (w ^ 2 • ((w ^ 2) ^ n • x)) =
                  φ ((w ^ 2) ^ n • x) := by
                rw [pow_two, mul_smul, hinv, hinv, inv_inv]
              _ = φ x := ih
      calc
        φ x = φ ((w ^ 2) ^ m • x) := (hevenInvariant m).symm
        _ = φ (w • x) := by rw [hwPow]
        _ = (φ x)⁻¹ := hinv x
  intro x
  have hsquare : (φ x) ^ 2 = 1 := by
    rw [pow_two]
    calc
      φ x * φ x = (φ x)⁻¹ * φ x :=
        congrArg (fun t => t * φ x) (hselfInv x)
      _ = 1 := inv_mul_cancel (φ x)
  have horderDvdTwo : orderOf (φ x) ∣ 2 :=
    orderOf_dvd_of_pow_eq_one hsquare
  have horderDvdX : orderOf (φ x) ∣ Nat.card X :=
    dvd_trans (orderOf_map_dvd φ x) (orderOf_dvd_natCard x)
  have horderOdd : Odd (orderOf (φ x)) :=
    Odd.of_dvd_nat hXodd horderDvdX
  have horderLeTwo : orderOf (φ x) ≤ 2 :=
    Nat.le_of_dvd (by decide) horderDvdTwo
  have horderOne : orderOf (φ x) = 1 := by
    rcases horderOdd with ⟨k, hk⟩
    omega
  exact orderOf_eq_one_iff.mp horderOne

/-- On a cyclic group, an automorphism can be moved from one argument of a
multiplicative bilinear pairing to the other. -/
private theorem theorem_11_7_pairing_cyclic_aut_move
    {Q B : Type*}
    [Group Q]
    [Group B]
    [IsCyclic Q]
    (D : Q → Q → B)
    (hmulLeft : ∀ a b c, D (a * b) c = D a c * D b c)
    (hmulRight : ∀ a b c, D a (b * c) = D a b * D a c)
    (f : MulAut Q)
    (a b : Q) :
    D (f a) b = D a (f b) := by
  have honeLeft : ∀ y : Q, D 1 y = 1 := by
    intro y
    have h := hmulLeft 1 1 y
    simpa using (congrArg (fun z => (D 1 y)⁻¹ * z) h).symm
  have honeRight : ∀ x : Q, D x 1 = 1 := by
    intro x
    have h := hmulRight x 1 1
    simpa using (congrArg (fun z => (D x 1)⁻¹ * z) h).symm
  let leftHom (z : Q) : Q →* B :=
    { toFun := fun t => D t z
      map_one' := honeLeft z
      map_mul' := fun x y => hmulLeft x y z }
  let rightHom (z : Q) : Q →* B :=
    { toFun := fun t => D z t
      map_one' := honeRight z
      map_mul' := hmulRight z }
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Q)
  have hDpow (r s : ℤ) : D (g ^ r) (g ^ s) = (D g g) ^ (r * s) := by
    change leftHom (g ^ s) (g ^ r) = (D g g) ^ (r * s)
    rw [map_zpow]
    change ((rightHom g) (g ^ s)) ^ r = (D g g) ^ (r * s)
    rw [map_zpow, ← zpow_mul]
    change (D g g) ^ (s * r) = (D g g) ^ (r * s)
    rw [mul_comm]
  rcases Subgroup.mem_zpowers_iff.mp (hg a) with ⟨m, hm⟩
  rcases Subgroup.mem_zpowers_iff.mp (hg b) with ⟨n, hn⟩
  rcases Subgroup.mem_zpowers_iff.mp (hg (f g)) with ⟨k, hk⟩
  rw [← hm, ← hn, map_zpow, map_zpow, ← hk, ← zpow_mul, ← zpow_mul,
    hDpow, hDpow]
  congr 1
  ring

/-- A nonzero multiplicative bilinear pairing between two copies of a cyclic
prime-order group identifies pairing-preserving automorphisms as inverses. -/
private theorem theorem_11_7_pairing_invariant_cyclic_aut_mul_eq_one
    {Q B : Type*}
    [Group Q]
    [Finite Q]
    [Group B]
    [IsCyclic Q]
    (hQprime : Nat.Prime (Nat.card Q))
    (D : Q → Q → B)
    (hmulLeft : ∀ a b c, D (a * b) c = D a c * D b c)
    (hmulRight : ∀ a b c, D a (b * c) = D a b * D a c)
    (hnontriv : ∃ a b, D a b ≠ 1)
    (f g : MulAut Q)
    (hinv : ∀ a b, D (f a) (g b) = D a b) :
    f * g = 1 := by
  letI : Fact (Nat.Prime (Nat.card Q)) := ⟨hQprime⟩
  rcases hnontriv with ⟨x0, y0, hxy⟩
  have honeRight : D x0 1 = 1 := by
    have h := hmulRight x0 1 1
    simpa using (congrArg (fun z => (D x0 1)⁻¹ * z) h).symm
  let r : Q →* B :=
    { toFun := fun y => D x0 y
      map_one' := honeRight
      map_mul' := hmulRight x0 }
  have hrker : r.ker = ⊥ := by
    rcases Subgroup.eq_bot_or_eq_top_of_prime_card r.ker with hbot | htop
    · exact hbot
    · exfalso
      apply hxy
      have hyker : y0 ∈ r.ker := by
        rw [htop]
        trivial
      exact MonoidHom.mem_ker.mp hyker
  have hrinj : Function.Injective r := r.ker_eq_bot_iff.mp hrker
  ext b
  apply hrinj
  change D x0 ((f * g) b) = D x0 b
  calc
    D x0 ((f * g) b) = D x0 (f (g b)) := rfl
    _ = D (f x0) (g b) :=
      (theorem_11_7_pairing_cyclic_aut_move
        D hmulLeft hmulRight f x0 (g b)).symm
    _ = D x0 b := hinv x0 b

/-- The factor action stored by PF `(9.7.a)` is right conjugation, hence it is
the inverse of the canonical left quotient action used in PF `(11.7)`. -/
private theorem theorem_11_7_factorAction_apply_eq_inv_smul
    {G : Type*}
    [Group G]
    [Finite G]
    (MF H0 U C : Subgroup G)
    [hnormalH0 : (H0.subgroupOf MF).Normal]
    (hUnormMF : U ≤ Subgroup.normalizer (MF : Set G))
    (hH0inv :
      letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
      IsInvariant U MF (H0.subgroupOf MF))
    (hnormalC : (C.subgroupOf U).Normal)
    (Q : Subgroup (MF ⧸ H0.subgroupOf MF))
    (ρ : (U ⧸ C.subgroupOf U) →* MulAut Q)
    (haction :
      ∀ z : U ⧸ C.subgroupOf U,
        ∀ u : U, QuotientGroup.mk' (C.subgroupOf U) u = z →
          ∃ hconjMF : ∀ h : MF, (u : G)⁻¹ * (h : G) * (u : G) ∈ MF,
            ∀ h : MF, ∀ hhQ : QuotientGroup.mk' (H0.subgroupOf MF) h ∈ Q,
              (ρ z ⟨QuotientGroup.mk' (H0.subgroupOf MF) h, hhQ⟩ :
                  MF ⧸ H0.subgroupOf MF) =
                QuotientGroup.mk' (H0.subgroupOf MF)
                  ⟨(u : G)⁻¹ * (h : G) * (u : G), hconjMF h⟩)
    (z : U ⧸ C.subgroupOf U)
    (u : U)
    (hu : QuotientGroup.mk' (C.subgroupOf U) u = z)
    (a : Q) :
    letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
    letI : MulAction.QuotientAction U (H0.subgroupOf MF) :=
      quotientAction_of_isInvariant (A := U) (G := MF)
        (H0.subgroupOf MF) hH0inv
    letI : MulDistribMulAction U (MF ⧸ H0.subgroupOf MF) :=
      quotientMulDistribMulAction (A := U) (G := MF)
        (H0.subgroupOf MF) hH0inv
    (ρ z a : MF ⧸ H0.subgroupOf MF) =
      (u⁻¹ : U) • (a : MF ⧸ H0.subgroupOf MF) := by
  letI : (C.subgroupOf U).Normal := hnormalC
  letI : Subgroup.Normalizes U MF := ⟨hUnormMF⟩
  letI : MulAction.QuotientAction U (H0.subgroupOf MF) :=
    quotientAction_of_isInvariant (A := U) (G := MF)
      (H0.subgroupOf MF) hH0inv
  letI : MulDistribMulAction U (MF ⧸ H0.subgroupOf MF) :=
    quotientMulDistribMulAction (A := U) (G := MF)
      (H0.subgroupOf MF) hH0inv
  obtain ⟨h, hh⟩ :=
    QuotientGroup.mk'_surjective (H0.subgroupOf MF)
      (a : MF ⧸ H0.subgroupOf MF)
  have hhQ : QuotientGroup.mk' (H0.subgroupOf MF) h ∈ Q := by
    rw [hh]
    exact a.property
  let ah : Q := ⟨QuotientGroup.mk' (H0.subgroupOf MF) h, hhQ⟩
  have hah : ah = a := Subtype.ext hh
  rw [← hah]
  rcases haction z u hu with ⟨hconjMF, hρ⟩
  rw [hρ h hhQ]
  have hsmul_mk :
      (u⁻¹ : U) • QuotientGroup.mk' (H0.subgroupOf MF) h =
        QuotientGroup.mk' (H0.subgroupOf MF) ((u⁻¹ : U) • h) := by
    simpa only [QuotientGroup.mk'_apply] using
      (MulAction.Quotient.smul_mk
        (H := H0.subgroupOf MF) (u⁻¹ : U) h)
  rw [hsmul_mk]
  apply congrArg (QuotientGroup.mk' (H0.subgroupOf MF))
  apply Subtype.ext
  simp [Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe]

/-- PF11 case-a pairing-vanishing source input for the early PF `(9.7)` split.
The checked wrapper below gets the numbered case split from PF9; the remaining
book-specific work is only the pairing argument used in PF `(11.7)`. -/
private theorem theorem_11_case_9_7_a_pairingVanishing_source_bridge
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C C9 H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q u a : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section9.hypothesis_9_2_statement M MF U W1 W2 q →
        (∃ hp : Nat.Primes,
          hp.val = p ∧
            Section9.hoReductionData M MF U W2 H0 hp ∧
            Section9.quotientChiefFactorData_9_6 M MF H0 W1 hp) →
          Section9.quotientBarUCardinality U C9 u →
