    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      (∀ a : ℕ,
        Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
          Section9.case_9_7_a_pairingVanishingData MF U H0 q →
            a = Nat.card U / Nat.card C) →
        ∀ a : ℕ,
          Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
            Section9.case_9_7_a_pairingVanishingData MF U H0 q →
              ∃ u : ℕ, 1 < u ∧ q ∣ u - 1 ∧ a = u := by
