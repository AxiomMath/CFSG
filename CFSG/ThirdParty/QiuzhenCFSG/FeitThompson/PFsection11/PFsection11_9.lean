/-- If the orthogonal complement to the projection has norm at least `1` and
the whole vector has norm `q + 1`, the projected part has norm at most `q`. -/
private theorem theorem_11_9_cfNormSq_weighted_projection_le_of_norm_gap
    {G ι : Type*}
    [Group G]
    [Finite G]
    [Fintype ι]
    [DecidableEq ι]
    (Y : Section1.ClassFunction G)
    (χ : ι → Section1.ClassFunction G)
    (q : ℕ)
    (horth : ∀ i j : ι,
      Section1.scalarProduct G (χ i) (χ j) = if i = j then 1 else 0) :
    Section5.cfNormSq Y = (q : ℝ) + 1 →
      1 ≤
        Section5.cfNormSq
          (Y -
            Section1.weightedFamilySum
              (fun x : ι => Section1.scalarProduct G Y (χ x)) χ) →
        Section5.cfNormSq
            (Section1.weightedFamilySum
              (fun x : ι => Section1.scalarProduct G Y (χ x)) χ) ≤
          (q : ℝ) := by
  intro hYnorm hgap
  classical
  let P : Section1.ClassFunction G :=
    Section1.weightedFamilySum
      (fun x : ι => Section1.scalarProduct G Y (χ x)) χ
  let C : Section1.ClassFunction G := Y - P
  have hCorth : ∀ i : ι, Section1.scalarProduct G C (χ i) = 0 := by
    intro i
    dsimp [C, P]
    exact theorem_11_9_weighted_projection_residual_orthogonal Y χ horth i
  have hCP : Section1.scalarProduct G C P = 0 := by
    dsimp [P]
    rw [Section1.scalarProduct_weightedFamilySum_right]
    simp [hCorth]
  have hPC : Section1.scalarProduct G P C = 0 := by
    simpa [Section1.scalarProduct_star_swap] using congrArg star hCP
  have hYeq : Y = P + C := by
    ext g
    simp [C, P, sub_eq_add_neg]
  have hnorm :
      Section5.cfNormSq Y = Section5.cfNormSq P + Section5.cfNormSq C := by
    rw [hYeq]
    exact Section5.cfNormSq_add_eq_add_of_orthogonal hPC hCP
  have hsum :
      Section5.cfNormSq P + Section5.cfNormSq C = (q : ℝ) + 1 := by
    rw [← hnorm, hYnorm]
  nlinarith

/-- Section 10 specialization of the projection norm bound used in PF
`(11.9)(a)`. -/
private theorem theorem_11_9_tau_projection_cfNormSq_le_of_norm_gap_of_section10FourSixNotationData
    {G : Type u}
    [Group G]
    [Finite G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
