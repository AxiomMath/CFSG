/-- In the active `(11.2)` context, `C = C_U(H)` is a proper subgroup of `U`.
If equality held, then `U` would centralize `H`, contradicting the source
condition `¬[U,H] ≤ H₀`. -/
private theorem theorem_11_5_C_lt_U_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      C < U := by
  intro h11
  rcases h11 with
    ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, hCeq, _hH0H, _hH0normM,
      _hp, _hquot, _hchief, hcomm, _hpW2, _hqW1, _hPDef⟩
  have hC_le_U : C ≤ U := by
    rw [hCeq]
    exact inf_le_left
  refine lt_of_le_of_ne hC_le_U ?_
  intro hCU
  have hC_le_cent : C ≤ Subgroup.centralizer (H : Set G) := by
    rw [hCeq]
    exact inf_le_right
  have hU_le_cent : U ≤ Subgroup.centralizer (H : Set G) := by
    simpa [hCU] using hC_le_cent
  have hcomm_bot : ⁅U, H⁆ = ⊥ :=
    (Subgroup.commutator_eq_bot_iff_le_centralizer (H₁ := U) (H₂ := H)).2 hU_le_cent
  exact hcomm (by
    rw [hcomm_bot]
    exact bot_le)

