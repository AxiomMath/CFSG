        Odd ((ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C)) ∧
          q ∣ (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) - 1 := by
  intro h11 hne
  exact ⟨theorem_11_5_fixedPointFree_index_odd
      M MF H U C H0 W1 W2 S τ p q h11 hne,
    theorem_11_5_fixedPointFree_index_dvd
      M MF H U C H0 W1 W2 S τ p q h11⟩

/-- The remaining fixed-point-free quotient-cardinality lower bound in PF
`(11.5)`: if `HC/M''` is nontrivial, then its order is at least `2q + 1`.

This is now a pure arithmetic consequence of the fixed-point-free quotient
output isolated in `theorem_11_5_fixedPointFree_index_odd_and_dvd`. -/
private theorem theorem_11_5_fixedPointFree_index_lower_bound
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) ≠ 1 →
        2 * q + 1 ≤
          (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) := by
  intro h11 hne
  let DD : Subgroup G := ambientDerivedSubgroup (ambientDerivedSubgroup M)
  let HC : Subgroup G := H ⊔ C
  have hodd_dvd :
      Odd (DD.relIndex HC) ∧ q ∣ DD.relIndex HC - 1 := by
    dsimp [DD, HC]
    exact theorem_11_5_fixedPointFree_index_odd_and_dvd
      M MF H U C H0 W1 W2 S τ p q h11 hne
  have hindex_pos : 0 < DD.relIndex HC := by
    have hcard :
