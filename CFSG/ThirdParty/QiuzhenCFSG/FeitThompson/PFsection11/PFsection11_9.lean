  exact (not_subsingleton_iff_nontrivial.mpr hquotNontrivial) hsubsingleton

/-- In the `(11.4)` substitution, the quotient `HC/H₀C` is central in
itself, expressed as the commutator containment used by PF `(6.2)`. -/
private theorem theorem_11_4_commutator_HC_subgroupOf_le_H0C_subgroupOf_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ⁅(H ⊔ C).subgroupOf M, (H ⊔ C).subgroupOf M⁆ ≤
        (H0 ⊔ C).subgroupOf M := by
  intro h11
  rcases h11 with
    ⟨h10, hHMF, htype, hHleD, hUleD, hCeq, hH0H, hH0normM,
      hp, hquot, hchief, hcomm, hpW2, hqW1⟩
  have h11' :
      hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q := by
    exact ⟨h10, hHMF, htype, hHleD, hUleD, hCeq, hH0H, hH0normM,
      hp, hquot, hchief, hcomm, hpW2, hqW1⟩
  rcases hquot with ⟨hH0normH, _hquotNontrivial, hquotElementary⟩
  letI : (H0.subgroupOf H).Normal := hH0normH
  haveI : IsElementaryAbelian p (H ⧸ H0.subgroupOf H) := hquotElementary
  have hHquotComm : Std.Commutative (· * · : H ⧸ H0.subgroupOf H → _ → _) := by
    infer_instance
  have hHquotComm' : IsMulCommutative (H ⧸ H0.subgroupOf H) := ⟨hHquotComm⟩
  have hHcomm_le_H0 : _root_.commutator H ≤ H0.subgroupOf H :=
    (Subgroup.Normal.quotient_commutative_iff_commutator_le
      (G := H) (N := H0.subgroupOf H)).1 hHquotComm'
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hCM : C ≤ M :=
    theorem_11_3_C_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hH0M : H0 ≤ M := hH0H.trans hHM
  have hHnormM : (H.subgroupOf M).Normal :=
    theorem_11_3_H_normal_subgroupOf_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hNnorm : ((H0 ⊔ C).subgroupOf M).Normal :=
    (theorem_11_3_core_normalities_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11').1
  let N : Subgroup M := (H0 ⊔ C).subgroupOf M
  have hNnorm' : N.Normal := by
    simpa [N] using hNnorm
  let qN : M →* M ⧸ N := QuotientGroup.mk' N
  rw [Subgroup.commutator_le]
  intro x hx y hy
  rw [← QuotientGroup.eq_one_iff (N := N) (x := ⁅x, y⁆)]
  have hHC_eq :
      (H ⊔ C).subgroupOf M = H.subgroupOf M ⊔ C.subgroupOf M := by
    exact Subgroup.subgroupOf_sup hHM hCM
  have hx_sup : x ∈ H.subgroupOf M ⊔ C.subgroupOf M := by
    simpa [hHC_eq] using hx
  have hy_sup : y ∈ H.subgroupOf M ⊔ C.subgroupOf M := by
    simpa [hHC_eq] using hy
  rcases (Subgroup.mem_sup_of_normal_left
      (s := H.subgroupOf M) (t := C.subgroupOf M) (x := x)).1 hx_sup with
    ⟨xh, hxhH, xc, hxcC, hx_eq⟩
  rcases (Subgroup.mem_sup_of_normal_left
      (s := H.subgroupOf M) (t := C.subgroupOf M) (x := y)).1 hy_sup with
    ⟨yh, hyhH, yc, hycC, hy_eq⟩
  have hxcN : xc ∈ N := by
    exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_right (show (xc : G) ∈ C from
      Subgroup.mem_subgroupOf.mp hxcC))
  have hycN : yc ∈ N := by
    exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_right (show (yc : G) ∈ C from
      Subgroup.mem_subgroupOf.mp hycC))
  have hx_q : qN x = qN xh := by
    rw [← hx_eq]
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (xh * xc) / xh ∈ N
    have hconj : xh * xc * xh⁻¹ ∈ N := hNnorm'.conj_mem _ hxcN xh
    simpa [div_eq_mul_inv, mul_assoc] using hconj
  have hy_q : qN y = qN yh := by
    rw [← hy_eq]
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (yh * yc) / yh ∈ N
    have hconj : yh * yc * yh⁻¹ ∈ N := hNnorm'.conj_mem _ hycN yh
    simpa [div_eq_mul_inv, mul_assoc] using hconj
  have hxh_comm_yh_mem : ⁅xh, yh⁆ ∈ N := by
    have hxhH_G : (xh : G) ∈ H := Subgroup.mem_subgroupOf.mp hxhH
    have hyhH_G : (yh : G) ∈ H := Subgroup.mem_subgroupOf.mp hyhH
    let xH : H := ⟨(xh : G), hxhH_G⟩
    let yH : H := ⟨(yh : G), hyhH_G⟩
    have hcommH : ⁅xH, yH⁆ ∈ H0.subgroupOf H := by
      exact hHcomm_le_H0 (Subgroup.commutator_mem_commutator
        (H₁ := (⊤ : Subgroup H)) (H₂ := (⊤ : Subgroup H)) trivial trivial)
    have hcommH0G : (⁅(xh : G), (yh : G)⁆ : G) ∈ H0 :=
      Subgroup.mem_subgroupOf.mp hcommH
    exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_left hcommH0G)
  have hcomm_xh_yh_q_one : qN ⁅xh, yh⁆ = 1 :=
    (QuotientGroup.eq_one_iff (N := N) (x := ⁅xh, yh⁆)).2 hxh_comm_yh_mem
  have hcommute_xh_yh : qN xh * qN yh = qN yh * qN xh := by
    have hcomm_q : ⁅qN xh, qN yh⁆ = 1 := by
      simpa [qN, map_commutatorElement] using hcomm_xh_yh_q_one
    exact commutatorElement_eq_one_iff_mul_comm.mp hcomm_q
  have hcommute_xy : qN x * qN y = qN y * qN x := by
    simpa [hx_q, hy_q] using hcommute_xh_yh
  have hcomm_q : ⁅qN x, qN y⁆ = 1 :=
    commutatorElement_eq_one_iff_mul_comm.mpr hcommute_xy
  change qN ⁅x, y⁆ = 1
  simpa [map_commutatorElement] using hcomm_q

/-- The concrete central quotient package used by PF `(6.2)` in the proof of
`(11.4)`, with `B = H₀C` and `C = D = HC`. -/
private theorem theorem_11_4_centralQuotientHypothesis_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Section6.centralQuotientHypothesis (derivedSubgroup M)
        ((H0 ⊔ C).subgroupOf M)
        ((H ⊔ C).subgroupOf M)
        ((H ⊔ C).subgroupOf M) := by
  intro h11
  have hlt :
      (H0 ⊔ C).subgroupOf M < (H ⊔ C).subgroupOf M :=
    theorem_11_4_H0C_subgroupOf_lt_HC_subgroupOf_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hleK :
      (H ⊔ C).subgroupOf M ≤ derivedSubgroup M :=
    theorem_11_3_HC_subgroupOf_le_derivedSubgroup_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hnorms :
      ((H0 ⊔ C).subgroupOf M).Normal ∧
        ((H ⊔ C).subgroupOf M).Normal :=
    theorem_11_3_core_normalities_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  exact
    ⟨hlt.le, le_rfl, hleK, hnorms.1, hnorms.2, hnorms.2,
      theorem_11_4_commutator_HC_subgroupOf_le_H0C_subgroupOf_of_hypothesis
        M MF H U C H0 W1 W2 S τ p q h11⟩

/-- Inside the derived subgroup `M' = H U`, the index of `HC` is the index of
`C` in `U`, hence `|U| / |C|`. -/
private theorem theorem_11_4_relIndex_HC_derived_eq_card_U_div_card_C
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ((H ⊔ C).subgroupOf M).relIndex (derivedSubgroup M) =
        Nat.card U / Nat.card C := by
  intro h11
  let D : Subgroup G := ambientDerivedSubgroup M
  have h11' :
      hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q := h11
  rcases h11 with
    ⟨_h10, hHMF, _htype, hHleD, hUleD, hCeq, _hH0H, _hH0normM,
      _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, hPDef, _hModd⟩
  rcases hPDef with
    ⟨_hMF, _hW1cyc, _hW1ne, _hW1hall, _hcompMW1, _hUleD, _hUnil, _hW1normU,
      hcomp, _hMFnotCyc, _hSecond, _hfit_eq, _hfit_leD, _hW2le, _hW2cyc,
      _hW2ne, _hcentW1, _hW0norm⟩
  have hC_le_U : C ≤ U := by
    rw [hCeq]
    exact inf_le_left
  have hHC_le_D : H ⊔ C ≤ D := by
    dsimp [D]
    exact sup_le hHleD (hC_le_U.trans hUleD)
  have hDleM : D ≤ M := by
    dsimp [D]
    exact section12_ambientDerivedSubgroup_le (E := M)
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hHnormM : (H.subgroupOf M).Normal :=
    theorem_11_3_H_normal_subgroupOf_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hMnormH : M ≤ Subgroup.normalizer (H : Set G) :=
    Subgroup.le_normalizer_of_normal_subgroupOf hHM
  have hDnormH : D ≤ Subgroup.normalizer (H : Set G) := hDleM.trans hMnormH
  have hHnormD : (H.subgroupOf D).Normal := by
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer hHleD).2 hDnormH
  have hHnormalInD : section10NormalIn H D := ⟨hHleD, hHnormD⟩
  have hcompH : section12ComplementIn D H U := by
    dsimp [D]
    simpa [hHMF] using hcomp
  have hcomp_symm : section12ComplementIn D U H := by
    refine ⟨hcompH.2.1, hcompH.1, ?_, hcompH.2.2.2.symm⟩
    rw [hcompH.2.2.1, sup_comm]
  have hcompUH : (U.subgroupOf D).IsComplement' (H.subgroupOf D) :=
    theorem_11_3_complementIn_normal_isComplement' hcomp_symm hHnormalInD
  have hcardD : Nat.card D = Nat.card H * Nat.card U := by
    have h := hcompUH.card_mul
    rw [natCard_subgroupOf_eq U D hUleD, natCard_subgroupOf_eq H D hHleD] at h
    simpa [Nat.mul_comm] using h.symm
  have hdisjHC : Disjoint H C :=
    theorem_11_3_H_disjoint_C_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11'
  have hHnormC : H ≤ Subgroup.normalizer (C : Set G) :=
    theorem_11_3_H_le_normalizer_C_of_eq H U C hCeq
  let HC : Subgroup G := H ⊔ C
  have hcompHC : (H.subgroupOf HC).IsComplement' (C.subgroupOf HC) := by
    dsimp [HC]
    exact theorem_11_3_sup_isComplement'_of_disjoint_le_normalizer H C hdisjHC hHnormC
  have hcardHC : Nat.card HC = Nat.card H * Nat.card C := by
    have h := hcompHC.card_mul
    dsimp [HC] at h ⊢
    rw [natCard_subgroupOf_eq H (H ⊔ C) le_sup_left,
      natCard_subgroupOf_eq C (H ⊔ C) le_sup_right] at h
    exact h.symm
  have hcardHCsub : Nat.card (HC.subgroupOf D) = Nat.card HC :=
    natCard_subgroupOf_eq HC D hHC_le_D
  have hmulIndex : Nat.card HC * HC.relIndex D = Nat.card D := by
    rw [Subgroup.relIndex, ← hcardHCsub]
    exact (HC.subgroupOf D).card_mul_index
  have hcardCsub : Nat.card (C.subgroupOf U) = Nat.card C :=
    natCard_subgroupOf_eq C U hC_le_U
  have hcardCIndex : Nat.card C * C.relIndex U = Nat.card U := by
    rw [Subgroup.relIndex, ← hcardCsub]
    exact (C.subgroupOf U).card_mul_index
  have hrelHC : HC.relIndex D = C.relIndex U := by
    have hmain : (Nat.card H * Nat.card C) * HC.relIndex D =
        (Nat.card H * Nat.card C) * C.relIndex U := by
      calc
        (Nat.card H * Nat.card C) * HC.relIndex D
            = Nat.card HC * HC.relIndex D := by rw [hcardHC]
        _ = Nat.card D := hmulIndex
        _ = Nat.card H * Nat.card U := hcardD
        _ = Nat.card H * (Nat.card C * C.relIndex U) := by rw [hcardCIndex]
        _ = (Nat.card H * Nat.card C) * C.relIndex U := by ac_rfl
    exact Nat.mul_left_cancel (Nat.mul_pos Nat.card_pos Nat.card_pos) hmain
  have hrelC_div : C.relIndex U = Nat.card U / Nat.card C :=
    Nat.eq_div_of_mul_eq_right (Nat.ne_of_gt Nat.card_pos) hcardCIndex
  calc
    ((H ⊔ C).subgroupOf M).relIndex (derivedSubgroup M)
        = ((H ⊔ C).subgroupOf M).relIndex (D.subgroupOf M) := by
          dsimp [D]
          rw [section12_ambientDerivedSubgroup_subgroupOf_eq]
          rfl
    _ = HC.relIndex D := by
          dsimp [HC]
          exact Subgroup.relIndex_subgroupOf (H := H ⊔ C) (K := D) (L := M) hDleM
    _ = Nat.card U / Nat.card C := hrelHC.trans hrelC_div

/-- The source equality `|M : HC| = q * |U/C|` used to convert the PF `(6.2)`
real inequality in `(11.4)`. -/
private theorem theorem_11_4_relIndex_HC_top_eq_q_mul_card_U_div_card_C
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ((H ⊔ C).subgroupOf M).relIndex (⊤ : Subgroup M) =
        q * (Nat.card U / Nat.card C) := by
  intro h11
  have hHC_le_K :
      (H ⊔ C).subgroupOf M ≤ derivedSubgroup M :=
    theorem_11_3_HC_subgroupOf_le_derivedSubgroup_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hHC_K :
      ((H ⊔ C).subgroupOf M).relIndex (derivedSubgroup M) =
        Nat.card U / Nat.card C :=
    theorem_11_4_relIndex_HC_derived_eq_card_U_div_card_C
      M MF H U C H0 W1 W2 S τ p q h11
  have hK_top :
      (derivedSubgroup M).relIndex (⊤ : Subgroup M) = q :=
    theorem_11_3_derived_relIndex_top_eq_q_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  calc
    ((H ⊔ C).subgroupOf M).relIndex (⊤ : Subgroup M)
        = ((H ⊔ C).subgroupOf M).relIndex (derivedSubgroup M) *
            (derivedSubgroup M).relIndex (⊤ : Subgroup M) := by
          exact (Subgroup.relIndex_mul_relIndex
            ((H ⊔ C).subgroupOf M) (derivedSubgroup M) (⊤ : Subgroup M)
            hHC_le_K le_top).symm
    _ = (Nat.card U / Nat.card C) * q := by rw [hHC_K, hK_top]
    _ = q * (Nat.card U / Nat.card C) := Nat.mul_comm _ _

/-- Proof placeholder for `theorem_11_4_statement`. -/
