/-- If `U` centralizes `H0` and fixes no nontrivial element of the
abelianization `H/H'`, then `H0 ≤ H'`. -/
private theorem theorem_11_6_H0_le_ambientDerived_H_of_fixedPointSubgroup_bot
    {G : Type u}
    [Group G]
    [Finite G]
    (H U H0 : Subgroup G)
    (hH0H : H0 ≤ H)
    (hUcent : U ≤ subgroupCentralizerIn U H0)
    (hUnormH : U ≤ Subgroup.normalizer (H : Set G))
    (hfixBot :
      letI : Subgroup.Normalizes U H := ⟨hUnormH⟩
      let hcommInv : IsInvariant U H (commutator H) :=
        isInvariant_of_characteristic (A := U) (G := H) (commutator H)
      letI : MulDistribMulAction U (H ⧸ commutator H) :=
        quotientMulDistribMulAction (A := U) (G := H) (commutator H) hcommInv
      fixedPointSubgroup U (H ⧸ commutator H) = ⊥) :
    H0 ≤ ambientDerivedSubgroup H := by
  classical
  letI : Subgroup.Normalizes U H := ⟨hUnormH⟩
  let hcommInv : IsInvariant U H (commutator H) :=
    isInvariant_of_characteristic (A := U) (G := H) (commutator H)
  letI : MulDistribMulAction U (H ⧸ commutator H) :=
    quotientMulDistribMulAction (A := U) (G := H) (commutator H) hcommInv
  letI : MulAction.QuotientAction U (commutator H) :=
    quotientAction_of_isInvariant (A := U) (G := H) (commutator H) hcommInv
  intro x hxH0
  have hxH : x ∈ H := hH0H hxH0
  let xH : H := ⟨x, hxH⟩
  have hxfix :
      QuotientGroup.mk' (commutator H) xH ∈
        fixedPointSubgroup U (H ⧸ commutator H) := by
    rw [FixedPoints.mem_subgroup]
    intro u
    have huCent : (u : G) ∈ Subgroup.centralizer (H0 : Set G) :=
      (hUcent u.property).2
    have hcommute : (u : G) * x = x * (u : G) :=
      (Subgroup.mem_centralizer_iff.mp huCent x hxH0).symm
    have hsmulG :
        ((u • xH : H) : G) = (u : G) * (xH : G) * (u : G)⁻¹ := by
      simp [Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe]
    have hsmul_eq : u • xH = xH := by
      apply Subtype.ext
      rw [hsmulG]
      change (u : G) * x * (u : G)⁻¹ = x
      calc
        (u : G) * x * (u : G)⁻¹ = x * (u : G) * (u : G)⁻¹ := by
          rw [hcommute]
        _ = x := by simp [mul_assoc]
    calc
      u • QuotientGroup.mk' (commutator H) xH =
          QuotientGroup.mk' (commutator H) (u • xH) := by
            simp
      _ = QuotientGroup.mk' (commutator H) xH := by rw [hsmul_eq]
  have hxbot :
      QuotientGroup.mk' (commutator H) xH ∈
        (⊥ : Subgroup (H ⧸ commutator H)) := by
    simpa [hfixBot] using hxfix
  have hxqone : QuotientGroup.mk' (commutator H) xH = 1 :=
    Subgroup.mem_bot.mp hxbot
  have hxcomm : xH ∈ commutator H := by
    have hmem : xH / 1 ∈ commutator H :=
      (QuotientGroup.eq_iff_div_mem).1 (by simpa using hxqone)
    simpa using hmem
  have hxsub : xH ∈ (ambientDerivedSubgroup H).subgroupOf H := by
    simpa [section12_ambientDerivedSubgroup_subgroupOf_eq, derivedSubgroup,
      derivedSeries_one, _root_.commutator] using hxcomm
  exact hxsub

/-- Source bridge for the hard direction `H0 ≤ H'` in PF `(11.6)`.

The text applies BG Proposition 1.6(d) to the action on `H/H'` and uses
PF `(11.5)` to rule out a nontrivial fixed-point factor. -/
private theorem theorem_11_6_H0_le_ambientDerived_H_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      H0 ≤ ambientDerivedSubgroup H := by
  intro h11
  have hH0H : H0 ≤ H := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    exact hH0H
  have hUcent : U ≤ subgroupCentralizerIn U H0 :=
    theorem_11_6_U_le_centralizer_H0_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hUnormH : U ≤ Subgroup.normalizer (H : Set G) :=
    theorem_11_6_U_le_normalizer_H_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hfixBot :
      letI : Subgroup.Normalizes U H := ⟨hUnormH⟩
      let hcommInv : IsInvariant U H (commutator H) :=
        isInvariant_of_characteristic (A := U) (G := H) (commutator H)
      letI : MulDistribMulAction U (H ⧸ commutator H) :=
        quotientMulDistribMulAction (A := U) (G := H) (commutator H) hcommInv
      fixedPointSubgroup U (H ⧸ commutator H) = ⊥ :=
    theorem_11_6_fixedPointSubgroup_quotient_commutator_eq_bot_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q hUnormH h11
  exact theorem_11_6_H0_le_ambientDerived_H_of_fixedPointSubgroup_bot
    H U H0 hH0H hUcent hUnormH hfixBot

/-- The equality `H0 = H'` in PF `(11.6)`, after isolating the source bridge
for the hard containment. -/
private theorem theorem_11_6_H0_eq_ambientDerived_H_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      H0 = ambientDerivedSubgroup H := by
  intro h11
  exact le_antisymm
    (theorem_11_6_H0_le_ambientDerived_H_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11)
    (theorem_11_6_ambientDerived_H_le_H0_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11)

/-- The first assertion in PF `(11.6)`, after the hard source bridge
`H0 = H'` has been isolated.

The elementary-abelian quotient `H/H0` becomes the abelianization quotient
`H/H'`; since `H` is nilpotent, the PF `(6.5.b)` p-core argument then makes
`H` a `p`-group. -/
private theorem theorem_11_6_isPGroup_H_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      IsPGroup p H := by
  intro h11
  have h11Full := h11
  have hH0eq : H0 = ambientDerivedSubgroup H :=
    theorem_11_6_H0_eq_ambientDerived_H_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  rcases h11 with
    ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
      hp, hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
  rcases hquot with ⟨hH0normH, _hne, hElem⟩
  letI : Fact p.Prime := ⟨hp⟩
  letI : (H0.subgroupOf H).Normal := hH0normH
  have hHnil : Group.IsNilpotent H :=
    theorem_11_3_H_nilpotent_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11Full
  have hH0sub_eq : H0.subgroupOf H = commutator H := by
    simpa [hH0eq, derivedSubgroup, derivedSeries_one, _root_.commutator] using
      (section12_ambientDerivedSubgroup_subgroupOf_eq (G := G) (E := H))
  have hQp0 : IsPGroup p (H ⧸ H0.subgroupOf H) := by
    exact IsElementaryAbelian.isPGroup p (H ⧸ H0.subgroupOf H)
  let e : H ⧸ H0.subgroupOf H ≃* H ⧸ commutator H :=
    QuotientGroup.quotientMulEquivOfEq hH0sub_eq
  have hQp : IsPGroup p (H ⧸ commutator H) := hQp0.of_equiv e
  exact Section6.isPGroup_of_nilpotent_quotient_commutator_isPGroup hHnil hQp

/-- Proof of `theorem_11_6_statement`, reduced to the remaining source
bridges for the first three assertions. -/
public theorem theorem_11_6
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ)
    : hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      IsPGroup p H ∧
        U ≤ subgroupCentralizerIn U H0 ∧
        H0 = ambientDerivedSubgroup H ∧
        C = ambientDerivedSubgroup U := by
  intro h11
  exact ⟨theorem_11_6_isPGroup_H_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11,
    theorem_11_6_U_le_centralizer_H0_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11,
    theorem_11_6_H0_eq_ambientDerived_H_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11,
    theorem_11_6_C_eq_ambientDerived_U_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11⟩

/-- Elementary-abelian structure transports across a multiplicative equivalence. -/
private theorem theorem_11_7_isElementaryAbelian_of_equiv
    {A : Type u} {B : Type u} [Group A] [Group B]
    (p : ℕ)
    (e : A ≃* B) :
    IsElementaryAbelian p A →
      IsElementaryAbelian p B := by
  intro hElem
  letI : IsElementaryAbelian p A := hElem
  refine
    { toIsMulCommutative := { is_comm := Std.Commutative.mk ?_ }
      exponent_dvd_p := ?_ }
  · intro a b
    have hcomm : e.symm a * e.symm b = e.symm b * e.symm a :=
      IsMulCommutative.is_comm.comm (e.symm a) (e.symm b)
    apply_fun e at hcomm
    simpa [e.map_mul] using hcomm
  · refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 ?_
    intro x
    have hxsrc : (e.symm x) ^ p = 1 :=
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p p A) (e.symm x)
    apply_fun e at hxsrc
    simpa [map_pow] using hxsrc

/-- Translating `H0 = 1` between the ambient subgroup and the internal
subgroup of `H`. -/
private theorem theorem_11_7_subgroupOf_H0_eq_bot_iff
    {G : Type u}
    [Group G]
    (H H0 : Subgroup G)
    (hH0H : H0 ≤ H) :
    H0.subgroupOf H = (⊥ : Subgroup H) ↔ H0 = ⊥ := by
  constructor
  · intro hsub
    ext x
    constructor
    · intro hx
      have hxsub : (⟨x, hH0H hx⟩ : H) ∈ H0.subgroupOf H := by
        exact hx
      have hxbot : (⟨x, hH0H hx⟩ : H) ∈ (⊥ : Subgroup H) := by
        simpa [hsub] using hxsub
      have hxone : (⟨x, hH0H hx⟩ : H) = 1 :=
        Subgroup.mem_bot.mp hxbot
      exact Subgroup.mem_bot.mpr (by simpa using congrArg Subtype.val hxone)
    · intro hxbot
      exact (bot_le : (⊥ : Subgroup G) ≤ H0) hxbot
  · intro hbot
    ext x
    constructor
    · intro hx
      have hxG : (x : G) ∈ H0 := hx
      have hxGbot : (x : G) ∈ (⊥ : Subgroup G) := by
        simpa [hbot] using hxG
      have hxone : (x : G) = 1 :=
        Subgroup.mem_bot.mp hxGbot
      exact Subgroup.mem_bot.mpr (Subtype.ext hxone)
    · intro hxbot
      exact (bot_le : (⊥ : Subgroup H) ≤ H0.subgroupOf H) hxbot

/-- A nontrivial ambient `H0` remains nontrivial after viewing it as a
subgroup of `H`. -/
private theorem theorem_11_7_H0_subgroupOf_card_ne_one
    {G : Type u}
    [Group G]
    [Finite G]
    (H H0 : Subgroup G)
    (hH0H : H0 ≤ H) :
    H0 ≠ ⊥ → Nat.card (H0.subgroupOf H) ≠ 1 := by
  intro hne hcard1
  have hcardF : Fintype.card (H0.subgroupOf H) = 1 := by
    simpa [Nat.card_eq_fintype_card] using hcard1
  have hsubsingle : Subsingleton (H0.subgroupOf H) :=
    Fintype.card_le_one_iff_subsingleton.mp (by omega)
  have hsubbot : H0.subgroupOf H = (⊥ : Subgroup H) := by
    ext x
    constructor
    · intro hx
      let y : H0.subgroupOf H := ⟨x, hx⟩
      have hy : y = 1 := Subsingleton.elim y 1
      have hxone : x = 1 := by
        simpa [y] using congrArg Subtype.val hy
      exact Subgroup.mem_bot.mpr hxone
    · intro hxbot
      exact (bot_le : (⊥ : Subgroup H) ≤ H0.subgroupOf H) hxbot
  exact hne ((theorem_11_7_subgroupOf_H0_eq_bot_iff H H0 hH0H).mp hsubbot)

/-- The BG Lemma 1.22 step in PF `(11.7)`: if `H0` is nontrivial, then
inside the `p`-group `H` there is a normal subgroup of `H`, contained in
`H0`, whose cardinality has index `p` in `H0`. -/
private theorem theorem_11_7_exists_normal_subgroup_H0_card_factor
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      H0 ≠ ⊥ →
        ∃ Q : Subgroup H,
          Q.Normal ∧ Q ≤ H0.subgroupOf H ∧
            Nat.card (H0.subgroupOf H) = p * Nat.card Q := by
  intro h11 hH0ne
  have h11Full := h11
  have hHp : IsPGroup p H :=
    (theorem_11_6 M MF H U C H0 W1 W2 S τ p q h11Full).1
  rcases h11 with
    ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, hH0H, _hH0normM,
      hp, hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
  rcases hquot with ⟨hH0normH, _hne, _hElem⟩
  letI : Fact p.Prime := ⟨hp⟩
  letI : Fact (IsPGroup p H) := ⟨hHp⟩
  have hH0p : IsPGroup p (H0.subgroupOf H) :=
    hHp.to_subgroup (H0.subgroupOf H)
  rcases hH0p.exists_card_eq with ⟨k, hkcard⟩
  have hkpos : 0 < k := by
    by_contra hknot
    have hk0 : k = 0 := Nat.eq_zero_of_not_pos hknot
    have hcard1 : Nat.card (H0.subgroupOf H) = 1 := by
      simpa [hk0] using hkcard
    exact theorem_11_7_H0_subgroupOf_card_ne_one H H0 hH0H hH0ne hcard1
  rcases lemma_1_22 (G := H) p (H0.subgroupOf H) hH0normH k hkcard
      (k - 1) (Nat.pred_le _) with
    ⟨Q, hQnorm, hQle, hQcard⟩
  refine ⟨Q, hQnorm, hQle, ?_⟩
  have hpow : p ^ k = p * p ^ (k - 1) := by
    have hk_succ : k = (k - 1) + 1 := by omega
    nth_rewrite 1 [hk_succ]
    rw [pow_succ, Nat.mul_comm]
  calc
    Nat.card (H0.subgroupOf H) = p ^ k := hkcard
    _ = p * p ^ (k - 1) := hpow
    _ = p * Nat.card Q := by rw [hQcard]

/-- If `Q ≤ N` and `|N| = p |Q|`, then the image of `N` in `G/Q` has
cardinality `p`. -/
private theorem theorem_11_7_quotient_image_card_eq_prime_of_card_factor
    {G : Type u}
    [Group G]
    [Finite G]
    (p : ℕ)
    (N Q : Subgroup G)
    [Q.Normal]
    (hQle : Q ≤ N)
    (hcard : Nat.card N = p * Nat.card Q) :
    Nat.card (N.map (QuotientGroup.mk' Q)) = p := by
  have hQsub_card : Nat.card (Q.subgroupOf N) = Nat.card Q := by
    simpa using
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe (G := G) (H := Q) (K := N) hQle).toEquiv
  have hquot_card : Nat.card (N ⧸ Q.subgroupOf N) = p := by
    have hmul :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (α := N) (s := Q.subgroupOf N)
    have hmul' : Nat.card (N ⧸ Q.subgroupOf N) * Nat.card Q = p * Nat.card Q := by
      calc
        Nat.card (N ⧸ Q.subgroupOf N) * Nat.card Q
            = Nat.card (N ⧸ Q.subgroupOf N) * Nat.card (Q.subgroupOf N) := by
                rw [hQsub_card]
        _ = Nat.card N := hmul.symm
        _ = p * Nat.card Q := hcard
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos hmul'
  calc
    Nat.card (N.map (QuotientGroup.mk' Q)) =
        Nat.card (N ⧸ Q.subgroupOf N) := natCard_map_mk'_eq N Q
    _ = p := hquot_card

/-- If `Q` is a normal subgroup of index `p` in a normal subgroup `N` of a
finite `p`-group, then `N/Q` is central in `G/Q`. -/
private theorem theorem_11_7_quotient_image_le_center_of_normal_card_factor
    {G : Type u}
    [Group G]
    [Finite G]
    {p : ℕ}
    [Fact p.Prime]
    [Fact (IsPGroup p G)]
    (N Q : Subgroup G)
    [N.Normal]
    (hQnorm : Q.Normal)
    (hQle : Q ≤ N)
    (hcard : Nat.card N = p * Nat.card Q) :
    N.map (QuotientGroup.mk' Q) ≤ Subgroup.center (G ⧸ Q) := by
  classical
  letI : Q.Normal := hQnorm
  let qG : G →* G ⧸ Q := QuotientGroup.mk' Q
  let Nbar : Subgroup (G ⧸ Q) := N.map qG
  have hNbar_norm : Nbar.Normal := by
    simpa [Nbar, qG] using (QuotientGroup.map_normal Q N)
  letI : Nbar.Normal := hNbar_norm
  let φ : N →* G ⧸ Q := qG.comp N.subtype
  have hkerφ : φ.ker = Q.subgroupOf N := by
    ext x
    simp [φ, qG, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
  have hrangeφ : φ.range = Nbar := by
    ext x
    constructor
    · rintro ⟨n, rfl⟩
      exact ⟨(n : G), n.property, rfl⟩
    · rintro ⟨g, hgN, rfl⟩
      exact ⟨⟨g, hgN⟩, rfl⟩
  have hQsub_card : Nat.card (Q.subgroupOf N) = Nat.card Q := by
    simpa using
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe (G := G) (H := Q) (K := N) hQle).toEquiv
  have hquot_card : Nat.card (N ⧸ Q.subgroupOf N) = p := by
    have hmul :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (α := N) (s := Q.subgroupOf N)
    have hmul' : Nat.card (N ⧸ Q.subgroupOf N) * Nat.card Q = p * Nat.card Q := by
      calc
        Nat.card (N ⧸ Q.subgroupOf N) * Nat.card Q
            = Nat.card (N ⧸ Q.subgroupOf N) * Nat.card (Q.subgroupOf N) := by
                rw [hQsub_card]
        _ = Nat.card N := hmul.symm
        _ = p * Nat.card Q := hcard
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos hmul'
  have hNbar_card : Nat.card Nbar = p := by
    calc
      Nat.card Nbar = Nat.card φ.range := by rw [hrangeφ]
      _ = Nat.card (N ⧸ φ.ker) := by
        exact (Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv).symm
      _ = Nat.card (N ⧸ Q.subgroupOf N) := by rw [hkerφ]
      _ = p := hquot_card
  letI : Fact (IsPGroup p (G ⧸ Q)) := ⟨(Fact.out : IsPGroup p G).to_quotient Q⟩
  simpa [Nbar, qG] using
    normal_subgroup_card_eq_prime_le_center (G := G ⧸ Q) (p := p) (N := Nbar) hNbar_card

/-- If `Q` has index `p` in a normal subgroup `N` of a finite `p`-group,
then the ambient commutator `[G,N]` lies in `Q`. -/
private theorem theorem_11_7_commutator_le_of_normal_card_factor
    {G : Type u}
    [Group G]
    [Finite G]
    {p : ℕ}
    [Fact p.Prime]
    [Fact (IsPGroup p G)]
    (N Q : Subgroup G)
    [N.Normal]
    (hQnorm : Q.Normal)
    (hQle : Q ≤ N)
    (hcard : Nat.card N = p * Nat.card Q) :
    ⁅(⊤ : Subgroup G), N⁆ ≤ Q := by
  classical
  letI : Q.Normal := hQnorm
  let qG : G →* G ⧸ Q := QuotientGroup.mk' Q
  let Nbar : Subgroup (G ⧸ Q) := N.map qG
  have hNbar_center : Nbar ≤ Subgroup.center (G ⧸ Q) := by
    simpa [Nbar, qG] using
      theorem_11_7_quotient_image_le_center_of_normal_card_factor
        (G := G) (p := p) N Q hQnorm hQle hcard
  rw [Subgroup.commutator_le]
  intro x _ y hy
  have hybar : qG y ∈ Nbar := by
    exact ⟨y, hy, rfl⟩
  have hycent : qG y ∈ Subgroup.center (G ⧸ Q) := hNbar_center hybar
  have hqcomm : qG ⁅x, y⁆ = 1 := by
    have hcomm_yx := Subgroup.mem_center_iff.mp hycent (qG x)
    calc
      qG ⁅x, y⁆ = ⁅qG x, qG y⁆ := by
        simp [qG, commutatorElement_def, MonoidHom.map_mul]
      _ = 1 := by
        simp [commutatorElement_def, hcomm_yx, mul_assoc]
  exact (QuotientGroup.eq_one_iff (N := Q) (x := ⁅x, y⁆)).1 hqcomm

/-- The PF `(11.7)` choice of `Q`, strengthened to include the source
commutator condition `[H,H0] ≤ Q`. -/
private theorem theorem_11_7_exists_normal_subgroup_H0_commutator_card_factor
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      H0 ≠ ⊥ →
        ∃ Q : Subgroup H,
          Q.Normal ∧ ⁅(⊤ : Subgroup H), H0.subgroupOf H⁆ ≤ Q ∧
            Q ≤ H0.subgroupOf H ∧
              Nat.card (H0.subgroupOf H) = p * Nat.card Q := by
  intro h11 hH0ne
  have h11Full := h11
  have hHp : IsPGroup p H :=
    (theorem_11_6 M MF H U C H0 W1 W2 S τ p q h11Full).1
  rcases h11 with
    ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
      hp, hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
  rcases hquot with ⟨hH0normH, _hne, _hElem⟩
  rcases theorem_11_7_exists_normal_subgroup_H0_card_factor
      M MF H U C H0 W1 W2 S τ p q h11Full hH0ne with
    ⟨Q, hQnorm, hQle, hQcard⟩
  letI : Fact p.Prime := ⟨hp⟩
  letI : Fact (IsPGroup p H) := ⟨hHp⟩
  letI : (H0.subgroupOf H).Normal := hH0normH
  have hcomm_le_Q :
      ⁅(⊤ : Subgroup H), H0.subgroupOf H⁆ ≤ Q :=
    theorem_11_7_commutator_le_of_normal_card_factor
      (G := H) (p := p) (N := H0.subgroupOf H) (Q := Q) hQnorm hQle hQcard
  exact ⟨Q, hQnorm, hcomm_le_Q, hQle, hQcard⟩

/-- A local linear-algebra fact for PF `(11.7)`: a nondegenerate alternating
bilinear form has even finite dimension. -/
private theorem theorem_11_7_even_finrank_of_isAlt_nondegenerate
    {K : Type*}
    [Field K]
    [Invertible (2 : K)]
    {V : Type*}
    [AddCommGroup V]
    [Module K V]
    [FiniteDimensional K V]
    (B : LinearMap.BilinForm K V)
    (hAlt : B.IsAlt)
    (hNondeg : B.Nondegenerate) :
    Even (Module.finrank K V) := by
  by_contra hEven
  have hOdd : Odd (Module.finrank K V) := Nat.not_even_iff_odd.mp hEven
  let b := Module.finBasis K V
  let A := LinearMap.BilinForm.toMatrix b B
  have hA_transpose : A.transpose = -A := by
    ext i j
    simp [A, hAlt.neg_eq (b i) (b j)]
  have hdet_ne_zero : Matrix.det A ≠ 0 :=
    Matrix.Nondegenerate.det_ne_zero
      (LinearMap.BilinForm.Nondegenerate.toMatrix hNondeg b)
  have hdet_eq : Matrix.det A = -Matrix.det A := by
    calc
      Matrix.det A = Matrix.det A.transpose := by rw [Matrix.det_transpose]
      _ = Matrix.det (-A) := by rw [hA_transpose]
      _ = (-1 : K) ^ Fintype.card (Fin (Module.finrank K V)) * Matrix.det A := by
        rw [Matrix.det_neg]
      _ = -Matrix.det A := by
        simp [hOdd.neg_one_pow]
  have htwo_det_zero : (2 : K) * Matrix.det A = 0 := by
    linear_combination hdet_eq
  have htwo_ne_zero : (2 : K) ≠ 0 :=
    Invertible.ne_zero (2 : K)
  exact hdet_ne_zero (mul_eq_zero.mp htwo_det_zero |>.resolve_left htwo_ne_zero)

/-- The cardinality of a finite elementary abelian group determines its
dimension as a `ZMod p` vector space. -/
private theorem theorem_11_7_finrank_eq_of_elementaryAbelian_card
    {A : Type*}
    [Group A]
    [Finite A]
    {p q : ℕ}
    [Fact p.Prime]
    [IsElementaryAbelian p A]
    (hcard : Nat.card A = p ^ q) :
    Module.finrank (ZMod p) (Additive A) = q := by
  let Q := Additive A
  letI : AddCommGroup Q := Additive.addCommGroup
  letI : Module (ZMod p) Q := inferInstance
  letI : Finite Q := inferInstance
  letI : FiniteDimensional (ZMod p) Q := Module.Finite.of_finite
  have hcardQ : Nat.card A = p ^ Module.finrank (ZMod p) Q := by
    simpa [Q, Nat.card_eq_fintype_card, ZMod.card] using
      (Module.natCard_eq_pow_finrank (K := ZMod p) (V := Q))
  have hpow : p ^ Module.finrank (ZMod p) Q = p ^ q := by
    rw [← hcardQ, hcard]
  have hfinQ : Module.finrank (ZMod p) Q = q :=
    Nat.pow_right_injective (Fact.out : Nat.Prime p).two_le hpow
  simpa [Q] using hfinQ

/-- On an odd-dimensional elementary abelian `p`-group with `p` odd, an
alternating bilinear form over `ZMod p` cannot be nondegenerate. -/
private theorem theorem_11_7_not_nondegenerate_alt_form_of_odd_card_exponent
    {A : Type*}
    [Group A]
    [Finite A]
    {p q : ℕ}
    [Fact p.Prime]
    [IsElementaryAbelian p A]
    (hpodd : Odd p)
    (hqodd : Odd q)
    (hcard : Nat.card A = p ^ q)
    (B : LinearMap.BilinForm (ZMod p) (Additive A))
    (hAlt : B.IsAlt) :
    ¬ B.Nondegenerate := by
  intro hNondeg
  letI : FiniteDimensional (ZMod p) (Additive A) := Module.Finite.of_finite
  letI : Invertible (2 : ZMod p) :=
    invertibleOfCharPNotDvd (K := ZMod p) (p := p) (t := 2) (by
      intro hp_dvd_two
      have hp_le_two := Nat.le_of_dvd (by decide : 0 < 2) hp_dvd_two
      have hp_ge_two := (Fact.out : Nat.Prime p).two_le
      have hp_ne_two : p ≠ 2 := by
        intro hp_two
        have : ¬ Odd 2 := by decide
        exact this (hp_two ▸ hpodd)
      omega)
  have hEven : Even (Module.finrank (ZMod p) (Additive A)) :=
    theorem_11_7_even_finrank_of_isAlt_nondegenerate
      (K := ZMod p) (V := Additive A) B hAlt hNondeg
  have hdim : Module.finrank (ZMod p) (Additive A) = q :=
    theorem_11_7_finrank_eq_of_elementaryAbelian_card
      (A := A) (p := p) (q := q) hcard
  rw [hdim] at hEven
  exact (Nat.not_even_iff_odd.mpr hqodd) hEven

/-- If `H0` is the ambient derived subgroup of `H`, then internally it is the
usual derived subgroup of the group `H`. -/
private theorem theorem_11_7_H0_subgroupOf_eq_derivedSubgroup_of_ambient_eq
    {G : Type u}
    [Group G]
    (H H0 : Subgroup G)
    (hH0H : H0 ≤ H)
    (hH0eq : H0 = ambientDerivedSubgroup H) :
    H0.subgroupOf H = derivedSubgroup H := by
  subst H0
  simpa using (section12_ambientDerivedSubgroup_subgroupOf_eq (G := G) (E := H))

/-- If `H0 = H'`, then every commutator of elements of `H` belongs to `H0`
as an ambient subgroup. -/
private theorem theorem_11_7_commutator_mem_H0_of_ambientDerived_eq
    {G : Type u}
    [Group G]
    (H H0 : Subgroup G)
    (hH0H : H0 ≤ H)
    (hH0eq : H0 = ambientDerivedSubgroup H) :
    ∀ x y : H, ((⁅x, y⁆ : H) : G) ∈ H0 := by
  intro x y
  have hH0sub_eq : H0.subgroupOf H = derivedSubgroup H :=
    theorem_11_7_H0_subgroupOf_eq_derivedSubgroup_of_ambient_eq H H0 hH0H hH0eq
  have hmem : ⁅x, y⁆ ∈ H0.subgroupOf H := by
    rw [hH0sub_eq, derivedSubgroup, derivedSeries_one, commutator]
    exact Subgroup.commutator_mem_commutator (by trivial) (by trivial)
  exact Subgroup.mem_subgroupOf.mp hmem

/-- Endpoint contradiction for the PF `(11.7)` bilinear route: after the
source argument forces all commutators of `H` into `Q`, the facts
`H0 = H'`, `Q ≤ H0`, and `|H0| = p |Q|` are incompatible. -/
private theorem theorem_11_7_false_of_commutator_le_Q_card_factor
    {G : Type u}
    [Group G]
    [Finite G]
    (H H0 : Subgroup G)
    {p : ℕ}
    (Q : Subgroup H)
    (hp : Nat.Prime p)
    (hH0H : H0 ≤ H)
    (hH0eq : H0 = ambientDerivedSubgroup H)
    (hcommH_le_Q : ⁅(⊤ : Subgroup H), (⊤ : Subgroup H)⁆ ≤ Q)
    (hQle : Q ≤ H0.subgroupOf H)
    (hcard : Nat.card (H0.subgroupOf H) = p * Nat.card Q) :
    False := by
  have hH0sub_eq : H0.subgroupOf H = derivedSubgroup H :=
    theorem_11_7_H0_subgroupOf_eq_derivedSubgroup_of_ambient_eq H H0 hH0H hH0eq
  have hH0leQ : H0.subgroupOf H ≤ Q := by
    rw [hH0sub_eq]
    simpa [derivedSubgroup, derivedSeries_one, commutator] using hcommH_le_Q
  have hH0sub_eq_Q : H0.subgroupOf H = Q := le_antisymm hH0leQ hQle
  have hp1 : p = 1 := by
    have hmul : p * Nat.card Q = 1 * Nat.card Q := by
      simpa [hH0sub_eq_Q] using hcard.symm
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos hmul
  exact hp.ne_one hp1

/-- A pointwise zero commutator pairing gives the subgroup commutator
containment needed at the end of PF `(11.7)`. -/
private theorem theorem_11_7_commutator_le_Q_of_pairing_zero
    {H : Type u}
    [Group H]
    (Q : Subgroup H) :
    (∀ x y : H, ⁅x, y⁆ ∈ Q) →
      ⁅(⊤ : Subgroup H), (⊤ : Subgroup H)⁆ ≤ Q := by
  intro hzero
  rw [Subgroup.commutator_le]
  intro x _ y _
  exact hzero x y

/-- The quotient form being zero is exactly membership of each commutator in
`Q`. -/
private theorem theorem_11_7_pairing_zero_of_quotient_commutator_eq_one
    {H : Type u}
    [Group H]
    (Q : Subgroup H)
    [Q.Normal] :
    (∀ x y : H, QuotientGroup.mk' Q ⁅x, y⁆ = 1) →
      ∀ x y : H, ⁅x, y⁆ ∈ Q := by
  intro hzero x y
  exact (QuotientGroup.eq_one_iff (N := Q) (x := ⁅x, y⁆)).1 (hzero x y)

/-- If `N/Q` is central in `H/Q`, multiplying the left commutator argument by
an element of `N` does not change the quotient commutator. -/
private theorem theorem_11_7_quotient_commutator_mul_left_of_center
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [Q.Normal]
    (hNcenter : N.map (QuotientGroup.mk' Q) ≤ Subgroup.center (H ⧸ Q))
    {x y z : H}
    (hz : z ∈ N) :
    QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆ := by
  let qH : H →* H ⧸ Q := QuotientGroup.mk' Q
  have hzcent : qH z ∈ Subgroup.center (H ⧸ Q) := hNcenter ⟨z, hz, rfl⟩
  have hzcomm : ⁅qH z, qH y⁆ = 1 := by
    exact commutatorElement_eq_one_iff_mul_comm.mpr
      ((Subgroup.mem_center_iff.mp hzcent (qH y)).symm)
  calc
    qH ⁅x * z, y⁆ = ⁅qH (x * z), qH y⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]
    _ = ⁅qH x * qH z, qH y⁆ := by simp [qH]
    _ = qH x * ⁅qH z, qH y⁆ * (qH x)⁻¹ * ⁅qH x, qH y⁆ := by
      rw [commutator_mul_left]
    _ = ⁅qH x, qH y⁆ := by simp [hzcomm]
    _ = qH ⁅x, y⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]

/-- If `N/Q` is central in `H/Q`, multiplying the right commutator argument by
an element of `N` does not change the quotient commutator. -/
private theorem theorem_11_7_quotient_commutator_mul_right_of_center
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [Q.Normal]
    (hNcenter : N.map (QuotientGroup.mk' Q) ≤ Subgroup.center (H ⧸ Q))
    {x y z : H}
    (hz : z ∈ N) :
    QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆ := by
  let qH : H →* H ⧸ Q := QuotientGroup.mk' Q
  have hzcent : qH z ∈ Subgroup.center (H ⧸ Q) := hNcenter ⟨z, hz, rfl⟩
  have hxzcomm : ⁅qH x, qH z⁆ = 1 := by
    exact commutatorElement_eq_one_iff_mul_comm.mpr
      (Subgroup.mem_center_iff.mp hzcent (qH x))
  calc
    qH ⁅x, y * z⁆ = ⁅qH x, qH (y * z)⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]
    _ = ⁅qH x, qH y * qH z⁆ := by simp [qH]
    _ = ⁅qH x, qH y⁆ * qH y * ⁅qH x, qH z⁆ * (qH y)⁻¹ := by
      rw [commutator_mul_right]
    _ = ⁅qH x, qH y⁆ := by simp [hxzcomm]
    _ = qH ⁅x, y⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]

/-- Conjugating a central element by any element leaves it fixed. -/
private theorem theorem_11_7_conj_eq_self_of_mem_center
    {K : Type u}
    [Group K]
    {a c : K}
    (hc : c ∈ Subgroup.center K) :
    a * c * a⁻¹ = c := by
  have hcomm : a * c = c * a := Subgroup.mem_center_iff.mp hc a
  simp [mul_assoc, hcomm]

/-- Multiplicativity of the quotient commutator in the left argument, under
the centrality condition used to define the PF `(11.7)` pairing. -/
private theorem theorem_11_7_quotient_commutator_mul_left
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [Q.Normal]
    (hNcenter : N.map (QuotientGroup.mk' Q) ≤ Subgroup.center (H ⧸ Q))
    (hcommN : ∀ x y : H, ⁅x, y⁆ ∈ N)
    (x₁ x₂ y : H) :
    QuotientGroup.mk' Q ⁅x₁ * x₂, y⁆ =
      QuotientGroup.mk' Q ⁅x₁, y⁆ * QuotientGroup.mk' Q ⁅x₂, y⁆ := by
  let qH : H →* H ⧸ Q := QuotientGroup.mk' Q
  have hc2cent : qH ⁅x₂, y⁆ ∈ Subgroup.center (H ⧸ Q) :=
    hNcenter ⟨⁅x₂, y⁆, hcommN x₂ y, rfl⟩
  have hc2_conj : qH x₁ * qH ⁅x₂, y⁆ * (qH x₁)⁻¹ = qH ⁅x₂, y⁆ :=
    theorem_11_7_conj_eq_self_of_mem_center hc2cent
  have hc2c1 : qH ⁅x₂, y⁆ * qH ⁅x₁, y⁆ = qH ⁅x₁, y⁆ * qH ⁅x₂, y⁆ := by
    exact (Subgroup.mem_center_iff.mp hc2cent (qH ⁅x₁, y⁆)).symm
  calc
    qH ⁅x₁ * x₂, y⁆ = ⁅qH (x₁ * x₂), qH y⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]
    _ = ⁅qH x₁ * qH x₂, qH y⁆ := by simp [qH]
    _ = qH x₁ * ⁅qH x₂, qH y⁆ * (qH x₁)⁻¹ * ⁅qH x₁, qH y⁆ := by
      rw [commutator_mul_left]
    _ = qH x₁ * qH ⁅x₂, y⁆ * (qH x₁)⁻¹ * qH ⁅x₁, y⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]
    _ = qH ⁅x₂, y⁆ * qH ⁅x₁, y⁆ := by rw [hc2_conj]
    _ = qH ⁅x₁, y⁆ * qH ⁅x₂, y⁆ := hc2c1

/-- Multiplicativity of the quotient commutator in the right argument, under
the centrality condition used to define the PF `(11.7)` pairing. -/
private theorem theorem_11_7_quotient_commutator_mul_right
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [Q.Normal]
    (hNcenter : N.map (QuotientGroup.mk' Q) ≤ Subgroup.center (H ⧸ Q))
    (hcommN : ∀ x y : H, ⁅x, y⁆ ∈ N)
    (x y₁ y₂ : H) :
    QuotientGroup.mk' Q ⁅x, y₁ * y₂⁆ =
      QuotientGroup.mk' Q ⁅x, y₁⁆ * QuotientGroup.mk' Q ⁅x, y₂⁆ := by
  let qH : H →* H ⧸ Q := QuotientGroup.mk' Q
  have hc2cent : qH ⁅x, y₂⁆ ∈ Subgroup.center (H ⧸ Q) :=
    hNcenter ⟨⁅x, y₂⁆, hcommN x y₂, rfl⟩
  have hc2_conj : qH y₁ * qH ⁅x, y₂⁆ * (qH y₁)⁻¹ = qH ⁅x, y₂⁆ :=
    theorem_11_7_conj_eq_self_of_mem_center hc2cent
  calc
    qH ⁅x, y₁ * y₂⁆ = ⁅qH x, qH (y₁ * y₂)⁆ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]
    _ = ⁅qH x, qH y₁ * qH y₂⁆ := by simp [qH]
    _ = ⁅qH x, qH y₁⁆ * qH y₁ * ⁅qH x, qH y₂⁆ * (qH y₁)⁻¹ := by
      rw [commutator_mul_right]
    _ = qH ⁅x, y₁⁆ * qH y₁ * qH ⁅x, y₂⁆ * (qH y₁)⁻¹ := by
      simp [qH, commutatorElement_def, MonoidHom.map_mul]
    _ = qH ⁅x, y₁⁆ * (qH y₁ * qH ⁅x, y₂⁆ * (qH y₁)⁻¹) := by group
    _ = qH ⁅x, y₁⁆ * qH ⁅x, y₂⁆ := by rw [hc2_conj]

/-- The quotient commutator is alternating on the diagonal. -/
private theorem theorem_11_7_quotient_commutator_self
    {H : Type u}
    [Group H]
    (Q : Subgroup H)
    [Q.Normal]
    (x : H) :
    QuotientGroup.mk' Q ⁅x, x⁆ = 1 := by
  rw [commutatorElement_self]
  simp

/-- Swapping the commutator arguments inverts the quotient commutator. -/
private theorem theorem_11_7_quotient_commutator_swap
    {H : Type u}
    [Group H]
    (Q : Subgroup H)
    [Q.Normal]
    (x y : H) :
    QuotientGroup.mk' Q ⁅y, x⁆ = (QuotientGroup.mk' Q ⁅x, y⁆)⁻¹ := by
  rw [← commutatorElement_inv x y, map_inv]

/-- The commutator pairing induced on `H/N`, with values in `H/Q`, once the
quotient commutator is invariant under changing either argument by `N`. -/
private noncomputable def theorem_11_7_quotientCommutatorPairing
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (hleft : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hright : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆) :
    H ⧸ N → H ⧸ N → H ⧸ Q :=
  fun a b =>
    Quotient.liftOn₂ a b
      (fun x y => QuotientGroup.mk' Q ⁅x, y⁆)
      (by
        intro x₁ y₁ x₂ y₂ hx hy
        have hxq :
            (QuotientGroup.mk' N x₁ : H ⧸ N) = QuotientGroup.mk' N x₂ :=
          Quotient.sound hx
        have hyq :
            (QuotientGroup.mk' N y₁ : H ⧸ N) = QuotientGroup.mk' N y₂ :=
          Quotient.sound hy
        have hxmem : x₁⁻¹ * x₂ ∈ N := QuotientGroup.eq.mp hxq
        have hymem : y₁⁻¹ * y₂ ∈ N := QuotientGroup.eq.mp hyq
        calc
          QuotientGroup.mk' Q ⁅x₁, y₁⁆ =
              QuotientGroup.mk' Q ⁅x₁ * (x₁⁻¹ * x₂), y₁⁆ := by
            symm
            exact hleft x₁ y₁ (x₁⁻¹ * x₂) hxmem
          _ = QuotientGroup.mk' Q ⁅x₂, y₁⁆ := by simp
          _ = QuotientGroup.mk' Q ⁅x₂, y₁ * (y₁⁻¹ * y₂)⁆ := by
            symm
            exact hright x₂ y₁ (y₁⁻¹ * y₂) hymem
          _ = QuotientGroup.mk' Q ⁅x₂, y₂⁆ := by simp)

/-- Evaluation of the induced quotient-commutator pairing on quotient
representatives. -/
private theorem theorem_11_7_quotientCommutatorPairing_mk
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (hleft : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hright : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (x y : H) :
    theorem_11_7_quotientCommutatorPairing N Q hleft hright
        (QuotientGroup.mk' N x) (QuotientGroup.mk' N y) =
      QuotientGroup.mk' Q ⁅x, y⁆ := by
  rfl

/-- Multiplicativity of the induced quotient-commutator pairing in the left
argument. -/
private theorem theorem_11_7_quotientCommutatorPairing_mul_left
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (hleft : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hright : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hmul_left : ∀ x₁ x₂ y : H,
      QuotientGroup.mk' Q ⁅x₁ * x₂, y⁆ =
        QuotientGroup.mk' Q ⁅x₁, y⁆ * QuotientGroup.mk' Q ⁅x₂, y⁆)
    (a b c : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairing N Q hleft hright (a * b) c =
      theorem_11_7_quotientCommutatorPairing N Q hleft hright a c *
        theorem_11_7_quotientCommutatorPairing N Q hleft hright b c := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N b
  obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective N c
  change theorem_11_7_quotientCommutatorPairing N Q hleft hright
      (QuotientGroup.mk' N (x * y)) (QuotientGroup.mk' N z) =
    theorem_11_7_quotientCommutatorPairing N Q hleft hright
        (QuotientGroup.mk' N x) (QuotientGroup.mk' N z) *
      theorem_11_7_quotientCommutatorPairing N Q hleft hright
        (QuotientGroup.mk' N y) (QuotientGroup.mk' N z)
  exact hmul_left x y z

/-- Multiplicativity of the induced quotient-commutator pairing in the right
argument. -/
private theorem theorem_11_7_quotientCommutatorPairing_mul_right
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (hleft : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hright : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hmul_right : ∀ x y₁ y₂ : H,
      QuotientGroup.mk' Q ⁅x, y₁ * y₂⁆ =
        QuotientGroup.mk' Q ⁅x, y₁⁆ * QuotientGroup.mk' Q ⁅x, y₂⁆)
    (a b c : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairing N Q hleft hright a (b * c) =
      theorem_11_7_quotientCommutatorPairing N Q hleft hright a b *
        theorem_11_7_quotientCommutatorPairing N Q hleft hright a c := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N b
  obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective N c
  change theorem_11_7_quotientCommutatorPairing N Q hleft hright
      (QuotientGroup.mk' N x) (QuotientGroup.mk' N (y * z)) =
    theorem_11_7_quotientCommutatorPairing N Q hleft hright
        (QuotientGroup.mk' N x) (QuotientGroup.mk' N y) *
      theorem_11_7_quotientCommutatorPairing N Q hleft hright
        (QuotientGroup.mk' N x) (QuotientGroup.mk' N z)
  exact hmul_right x y z

/-- The induced quotient-commutator pairing vanishes on the diagonal. -/
private theorem theorem_11_7_quotientCommutatorPairing_self
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (hleft : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hright : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hself : ∀ x : H, QuotientGroup.mk' Q ⁅x, x⁆ = 1)
    (a : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairing N Q hleft hright a a = 1 := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N a
  exact hself x

/-- Swapping arguments in the induced quotient-commutator pairing inverts the
value. -/
private theorem theorem_11_7_quotientCommutatorPairing_swap
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (hleft : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x * z, y⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hright : ∀ x y z : H, z ∈ N →
      QuotientGroup.mk' Q ⁅x, y * z⁆ = QuotientGroup.mk' Q ⁅x, y⁆)
    (hswap : ∀ x y : H,
      QuotientGroup.mk' Q ⁅y, x⁆ = (QuotientGroup.mk' Q ⁅x, y⁆)⁻¹)
    (a b : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairing N Q hleft hright b a =
      (theorem_11_7_quotientCommutatorPairing N Q hleft hright a b)⁻¹ := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N b
  exact hswap x y

/-- If the induced quotient pairing is everywhere trivial, then every original
commutator is trivial in the quotient by `Q`. -/
private theorem theorem_11_7_quotient_commutator_eq_one_of_pairing_trivial
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmk : ∀ x y : H,
      pairing (QuotientGroup.mk' N x) (QuotientGroup.mk' N y) =
        QuotientGroup.mk' Q ⁅x, y⁆)
    (htrivial : ∀ a b : H ⧸ N, pairing a b = 1) :
    ∀ x y : H, QuotientGroup.mk' Q ⁅x, y⁆ = 1 := by
  intro x y
  rw [← hmk x y]
  exact htrivial (QuotientGroup.mk' N x) (QuotientGroup.mk' N y)

/-- The induced quotient-commutator pairing takes values in the image of the
commutator-containing subgroup. -/
private theorem theorem_11_7_quotientCommutatorPairing_mem_map
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmk : ∀ x y : H,
      pairing (QuotientGroup.mk' N x) (QuotientGroup.mk' N y) =
        QuotientGroup.mk' Q ⁅x, y⁆)
    (hcommN : ∀ x y : H, ⁅x, y⁆ ∈ N) :
    ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q) := by
  intro a b
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N b
  rw [hmk x y]
  exact ⟨⁅x, y⁆, hcommN x y, rfl⟩

/-- View a quotient-commutator pairing whose values lie in an image subgroup as
a pairing with that image subgroup as codomain. -/
private def theorem_11_7_quotientCommutatorPairingToImage
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmem : ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q)) :
    H ⧸ N → H ⧸ N → N.map (QuotientGroup.mk' Q) :=
  fun a b => ⟨pairing a b, hmem a b⟩

/-- Coercion back to `H/Q` evaluates the image-valued pairing as the original
quotient pairing. -/
private theorem theorem_11_7_quotientCommutatorPairingToImage_coe
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmem : ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q))
    (a b : H ⧸ N) :
    (theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a b :
        H ⧸ Q) =
      pairing a b := rfl

/-- Multiplicativity in the left variable for the image-valued induced pairing. -/
private theorem theorem_11_7_quotientCommutatorPairingToImage_mul_left
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmem : ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q))
    (hmul_left : ∀ a b c : H ⧸ N, pairing (a * b) c = pairing a c * pairing b c)
    (a b c : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem (a * b) c =
      theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a c *
        theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem b c := by
  ext
  exact hmul_left a b c

/-- Multiplicativity in the right variable for the image-valued induced pairing. -/
private theorem theorem_11_7_quotientCommutatorPairingToImage_mul_right
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmem : ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q))
    (hmul_right : ∀ a b c : H ⧸ N, pairing a (b * c) = pairing a b * pairing a c)
    (a b c : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a (b * c) =
      theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a b *
        theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a c := by
  ext
  exact hmul_right a b c

/-- Diagonal vanishing for the image-valued induced pairing. -/
private theorem theorem_11_7_quotientCommutatorPairingToImage_self
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmem : ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q))
    (hself : ∀ a : H ⧸ N, pairing a a = 1)
    (a : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a a = 1 := by
  ext
  exact hself a

/-- Swap-inverse symmetry for the image-valued induced pairing. -/
private theorem theorem_11_7_quotientCommutatorPairingToImage_swap
    {H : Type u}
    [Group H]
    (N Q : Subgroup H)
    [N.Normal]
    [Q.Normal]
    (pairing : H ⧸ N → H ⧸ N → H ⧸ Q)
    (hmem : ∀ a b : H ⧸ N, pairing a b ∈ N.map (QuotientGroup.mk' Q))
    (hswap : ∀ a b : H ⧸ N, pairing b a = (pairing a b)⁻¹)
    (a b : H ⧸ N) :
    theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem b a =
      (theorem_11_7_quotientCommutatorPairingToImage N Q pairing hmem a b)⁻¹ := by
  ext
  exact hswap a b

/-- A multiplicative pairing between elementary abelian `p`-groups is a
`ZMod p`-bilinear map after passing to additive notation. -/
private def theorem_11_7_additiveBilinMap_of_multiplicativePairing
    {p : ℕ}
    [Fact p.Prime]
    {A B : Type u}
    [Group A]
    [Group B]
    [IsElementaryAbelian p A]
    [IsElementaryAbelian p B]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (hmul_right : ∀ a b c : A, pairing a (b * c) = pairing a b * pairing a c) :
    LinearMap.BilinMap (ZMod p) (Additive A) (Additive B) := by
  have hone_left : ∀ y : A, pairing 1 y = 1 := by
    intro y
    have h := hmul_left 1 1 y
    simpa using (congrArg (fun z => (pairing 1 y)⁻¹ * z) h).symm
  have hone_right : ∀ x : A, pairing x 1 = 1 := by
    intro x
    have h := hmul_right x 1 1
    simpa using (congrArg (fun z => (pairing x 1)⁻¹ * z) h).symm
  let pairingAdd : Additive A →+ AddMonoidHom (Additive A) (Additive B) :=
    { toFun := fun x =>
        { toFun := fun y => Additive.ofMul (pairing (Additive.toMul x) (Additive.toMul y))
          map_zero' := by
            change Additive.ofMul (pairing (Additive.toMul x) 1) = 0
            simp [hone_right]
          map_add' := by
            intro y₁ y₂
            simpa using congrArg Additive.ofMul
              (hmul_right (Additive.toMul x) (Additive.toMul y₁) (Additive.toMul y₂)) }
      map_zero' := by
        apply AddMonoidHom.ext
        intro y
        change Additive.ofMul (pairing 1 (Additive.toMul y)) = 0
        simp [hone_left]
      map_add' := by
        intro x₁ x₂
        apply AddMonoidHom.ext
        intro y
        simpa using congrArg Additive.ofMul
          (hmul_left (Additive.toMul x₁) (Additive.toMul x₂) (Additive.toMul y)) }
  exact
    { toFun := fun x => (pairingAdd x).toZModLinearMap p
      map_add' := by
        intro x₁ x₂
        ext y
        simp
      map_smul' := by
        intro c x
        ext y
        exact DFunLike.congr_fun (ZMod.map_smul pairingAdd c x) y }

/-- The additive bilinear map attached to a multiplicative pairing evaluates to
the same value in additive notation. -/
private theorem theorem_11_7_additiveBilinMap_of_multiplicativePairing_apply
    {p : ℕ}
    [Fact p.Prime]
    {A B : Type u}
    [Group A]
    [Group B]
    [IsElementaryAbelian p A]
    [IsElementaryAbelian p B]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (hmul_right : ∀ a b c : A, pairing a (b * c) = pairing a b * pairing a c)
    (a b : A) :
    theorem_11_7_additiveBilinMap_of_multiplicativePairing
        (p := p) pairing hmul_left hmul_right (Additive.ofMul a) (Additive.ofMul b) =
      Additive.ofMul (pairing a b) := rfl

/-- The left radical of a multiplicative pairing. -/
private def theorem_11_7_pairingLeftRadical
    {A B : Type u}
    [Group A]
    [Group B]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c) :
    Subgroup A where
  carrier := {a | ∀ b : A, pairing a b = 1}
  one_mem' := by
    intro b
    have h := hmul_left 1 1 b
    simpa using (congrArg (fun z => (pairing 1 b)⁻¹ * z) h).symm
  mul_mem' := by
    intro a c ha hc b
    have h := hmul_left a c b
    simpa [ha b, hc b] using h
  inv_mem' := by
    intro a ha b
    have hone : pairing 1 b = 1 := by
      have h := hmul_left 1 1 b
      simpa using (congrArg (fun z => (pairing 1 b)⁻¹ * z) h).symm
    have h := hmul_left a⁻¹ a b
    simpa [ha b, hone] using h.symm

/-- Membership in the left radical is pointwise triviality in the left
argument. -/
private theorem theorem_11_7_pairingLeftRadical_mem
    {A B : Type u}
    [Group A]
    [Group B]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (a : A) :
    a ∈ theorem_11_7_pairingLeftRadical pairing hmul_left ↔
      ∀ b : A, pairing a b = 1 := Iff.rfl

/-- The left radical is all of the source group iff the pairing is pointwise
trivial. -/
private theorem theorem_11_7_pairingLeftRadical_eq_top_iff
    {A B : Type u}
    [Group A]
    [Group B]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c) :
    theorem_11_7_pairingLeftRadical pairing hmul_left = ⊤ ↔
      ∀ a b : A, pairing a b = 1 := by
  constructor
  · intro htop a b
    have ha : a ∈ theorem_11_7_pairingLeftRadical pairing hmul_left := by
      rw [htop]
      trivial
    exact (theorem_11_7_pairingLeftRadical_mem pairing hmul_left a).mp ha b
  · intro htrivial
    ext a
    constructor
    · intro _ha
      trivial
    · intro _ha
      exact (theorem_11_7_pairingLeftRadical_mem pairing hmul_left a).mpr
        (htrivial a)


/-- A pairing invariant under a group action has an invariant left radical. -/
private theorem theorem_11_7_pairingLeftRadical_isInvariant
    {A B Γ : Type u}
    [Group A]
    [Group B]
    [Group Γ]
    [MulDistribMulAction Γ A]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (hinv : ∀ γ : Γ, ∀ a b : A, pairing (γ • a) (γ • b) = pairing a b) :
    IsInvariant Γ A (theorem_11_7_pairingLeftRadical pairing hmul_left) := by
  refine ⟨?_⟩
  intro γ a
  constructor
  · intro ha
    rw [theorem_11_7_pairingLeftRadical_mem pairing hmul_left] at ha ⊢
    intro b
    have hb : γ • (γ⁻¹ • b) = b := by simp [smul_smul]
    calc
      pairing (γ • a) b = pairing (γ • a) (γ • (γ⁻¹ • b)) := by rw [hb]
      _ = pairing a (γ⁻¹ • b) := hinv γ a (γ⁻¹ • b)
      _ = 1 := ha _
  · intro hγa
    rw [theorem_11_7_pairingLeftRadical_mem pairing hmul_left] at hγa ⊢
    intro b
    have hval : pairing (γ • a) (γ • b) = 1 := hγa (γ • b)
    rw [hinv γ a b] at hval
    exact hval

/-- Translate invariance for the concrete quotient action into the PF `(9.7)`
normalization predicate. PF9 records normalization using right conjugation
`g⁻¹ * h * g`, while the local quotient action uses left conjugation; applying
the action of `a⁻¹` bridges the two conventions. -/
private theorem theorem_11_7_quotientSubgroupNormalizedBy_of_isInvariant
    {G : Type u}
    [Group G]
    [Finite G]
    (MF H0 U : Subgroup G)
    [Subgroup.Normalizes U MF]
    [hnormal : (H0.subgroupOf MF).Normal]
    (hH0inv : IsInvariant U MF (H0.subgroupOf MF))
    (Q : Subgroup (MF ⧸ H0.subgroupOf MF))
    (hQ :
      letI : MulAction.QuotientAction U (H0.subgroupOf MF) :=
        quotientAction_of_isInvariant (A := U) (G := MF) (H0.subgroupOf MF) hH0inv
      letI : MulDistribMulAction U (MF ⧸ H0.subgroupOf MF) :=
        quotientMulDistribMulAction (A := U) (G := MF) (H0.subgroupOf MF) hH0inv
      IsInvariant U (MF ⧸ H0.subgroupOf MF) Q) :
    Section9.quotientSubgroupNormalizedBy MF H0 U Q := by
  letI : MulAction.QuotientAction U (H0.subgroupOf MF) :=
    quotientAction_of_isInvariant (A := U) (G := MF) (H0.subgroupOf MF) hH0inv
  letI : MulDistribMulAction U (MF ⧸ H0.subgroupOf MF) :=
    quotientMulDistribMulAction (A := U) (G := MF) (H0.subgroupOf MF) hH0inv
  intro a
  let hconjMF : ∀ h : MF, (a : G)⁻¹ * (h : G) * (a : G) ∈ MF := by
    intro h
    have hsmulG :
        (((a⁻¹ : U) • h : MF) : G) = (a : G)⁻¹ * (h : G) * (a : G) := by
      simp
    exact hsmulG ▸ (((a⁻¹ : U) • h : MF).property)
  refine ⟨hconjMF, ?_⟩
  let action : MulAut (MF ⧸ H0.subgroupOf MF) :=
    MulDistribMulAction.toMulAut U (MF ⧸ H0.subgroupOf MF) (a⁻¹ : U)
  refine ⟨action, ?_, ?_⟩
  · intro h
    have hsmul_eq :
        ((a⁻¹ : U) • h : MF) =
          ⟨(a : G)⁻¹ * (h : G) * (a : G), hconjMF h⟩ := by
      apply Subtype.ext
      simp
    change action (QuotientGroup.mk' (H0.subgroupOf MF) h) =
      QuotientGroup.mk' (H0.subgroupOf MF)
        ⟨(a : G)⁻¹ * (h : G) * (a : G), hconjMF h⟩
    change (a⁻¹ : U) • QuotientGroup.mk' (H0.subgroupOf MF) h =
      QuotientGroup.mk' (H0.subgroupOf MF)
        ⟨(a : G)⁻¹ * (h : G) * (a : G), hconjMF h⟩
    have hsmul_mk :
        (a⁻¹ : U) • QuotientGroup.mk' (H0.subgroupOf MF) h =
          QuotientGroup.mk' (H0.subgroupOf MF) ((a⁻¹ : U) • h) := by
      simpa only [QuotientGroup.mk'_apply] using
        (MulAction.Quotient.smul_mk (H := H0.subgroupOf MF) (a⁻¹ : U) h)
    rw [hsmul_mk, hsmul_eq]
  · ext x
    constructor
    · intro hx
      refine ⟨action.symm x, ?_, ?_⟩
      · have hx' : (a⁻¹ : U) • (action.symm x) ∈ Q := by
          change action (action.symm x) ∈ Q
          simpa using hx
        exact (IsInvariant.invariant (A := U) (G := MF ⧸ H0.subgroupOf MF)
          (H := Q) (a⁻¹ : U) (action.symm x)).2 hx'
      · exact action.apply_symm_apply x
    · intro hx
      rcases hx with ⟨y, hy, rfl⟩
      change action y ∈ Q
      change (a⁻¹ : U) • y ∈ Q
      exact (IsInvariant.invariant (A := U) (G := MF ⧸ H0.subgroupOf MF)
        (H := Q) (a⁻¹ : U) y).1 hy

/-- A vector-valued bilinear map can be scalarized by a linear equivalence from
the codomain to the scalar field. -/
private def theorem_11_7_scalarBilinForm_of_linearEquiv
    {K V W : Type*}
    [CommSemiring K]
    [AddCommMonoid V]
    [Module K V]
    [AddCommMonoid W]
    [Module K W]
    (B : LinearMap.BilinMap K V W)
    (e : W ≃ₗ[K] K) :
    LinearMap.BilinForm K V where
  toFun := fun x => e.toLinearMap.comp (B x)
  map_add' := by
    intro x y
    ext z
    simp
  map_smul' := by
    intro c x
    ext z
    simp

/-- Evaluation of the scalarized bilinear form. -/
private theorem theorem_11_7_scalarBilinForm_of_linearEquiv_apply
    {K V W : Type*}
    [CommSemiring K]
    [AddCommMonoid V]
    [Module K V]
    [AddCommMonoid W]
    [Module K W]
    (B : LinearMap.BilinMap K V W)
    (e : W ≃ₗ[K] K)
    (x y : V) :
    theorem_11_7_scalarBilinForm_of_linearEquiv B e x y = e (B x y) := rfl

/-- If the multiplicative left radical is trivial, then the scalarized
bilinear form is nondegenerate. This keeps the radical-to-linear-algebra
transport out of the large PF `(11.7)` source context. -/
private theorem theorem_11_7_scalarBilinForm_nondegenerate_of_pairingLeftRadical_eq_bot
    {p : ℕ}
    [Fact p.Prime]
    {A B : Type u}
    [Group A]
    [Finite A]
    [Group B]
    [IsElementaryAbelian p A]
    [IsElementaryAbelian p B]
    (pairing : A → A → B)
    (hmul_left : ∀ a b c : A, pairing (a * b) c = pairing a c * pairing b c)
    (hmul_right : ∀ a b c : A, pairing a (b * c) = pairing a b * pairing a c)
    (e : Additive B ≃ₗ[ZMod p] ZMod p)
    (hbot : theorem_11_7_pairingLeftRadical pairing hmul_left = ⊥) :
    (theorem_11_7_scalarBilinForm_of_linearEquiv
      (theorem_11_7_additiveBilinMap_of_multiplicativePairing
        (p := p) pairing hmul_left hmul_right)
      e).Nondegenerate := by
  classical
  letI : Module.Finite (ZMod p) (Additive A) := Module.Finite.of_finite
  let bilin : LinearMap.BilinMap (ZMod p) (Additive A) (Additive B) :=
    theorem_11_7_additiveBilinMap_of_multiplicativePairing
      (p := p) pairing hmul_left hmul_right
  let form : LinearMap.BilinForm (ZMod p) (Additive A) :=
    theorem_11_7_scalarBilinForm_of_linearEquiv bilin e
  have hker : LinearMap.ker form = ⊥ := by
    ext x
    constructor
    · intro hx
      have hxrad : Additive.toMul x ∈
          theorem_11_7_pairingLeftRadical pairing hmul_left := by
        rw [theorem_11_7_pairingLeftRadical_mem pairing hmul_left]
        intro y
        have hxlin : form x = 0 := LinearMap.mem_ker.mp hx
        have hxzero : form x (Additive.ofMul y) = 0 := by
          simpa using
            congrArg (fun f : Additive A →ₗ[ZMod p] ZMod p => f (Additive.ofMul y))
              hxlin
        have hbilin_zero : bilin x (Additive.ofMul y) = 0 := by
          apply e.injective
          simpa [form, theorem_11_7_scalarBilinForm_of_linearEquiv_apply] using hxzero
        have htemp := hbilin_zero
        rw [← ofMul_toMul x] at htemp
        rw [theorem_11_7_additiveBilinMap_of_multiplicativePairing_apply
          (p := p) pairing hmul_left hmul_right (Additive.toMul x) y] at htemp
        have hzero_eq : (0 : Additive B) = Additive.ofMul (1 : B) := by simp
        rw [hzero_eq] at htemp
        exact (Equiv.injective Additive.ofMul) htemp
      have hxbot : Additive.toMul x ∈ (⊥ : Subgroup A) := by
        simpa [hbot] using hxrad
      have hmul : Additive.toMul x = 1 := by
        simpa using hxbot
      exact Additive.toMul.injective (by simpa using hmul)
    · intro hxbot
      have hx0 : x = 0 := by
        simpa using hxbot
      subst x
      simp
  change form.Nondegenerate
  rw [LinearMap.BilinForm.nondegenerate_iff_ker_eq_bot]
  exact hker

/-- A group action by automorphisms preserves commutators. -/
private theorem theorem_11_7_smul_commutatorElement
    {A B : Type u}
    [Group A]
    [Group B]
    [MulDistribMulAction A B]
    (a : A) (x y : B) :
    a • ⁅x, y⁆ = ⁅a • x, a • y⁆ := by
  simp [commutatorElement_def]

set_option maxHeartbeats 800000

/-- The source-hard bilinear-form step in PF `(11.7)`: after choosing `Q`,
the alternating commutator pairing and the irreducible/reducible `U`-action
split force the induced pairing to be zero. -/
private theorem theorem_11_7_quotient_commutator_eq_one_of_bilinear_source
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ)
    (Q : Subgroup H)
