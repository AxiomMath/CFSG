      ∀ {j : J}, j ≠ j0 →
        Section1.degree (Section10.muColumn μ j) =
          (d : ℂ) * (Nat.card W1 : ℂ) := by
  intro hUniform j hj
  rcases hUniform with
    ⟨hI, _hJ, _hPrime, _hdpos, _hδ, _hnpos, hdeg, _hsign, _hdn⟩
  calc
    Section1.degree (Section10.muColumn μ j) = ∑ i : I, μ i j 1 := by
      simp [Section1.degree, Section10.muColumn]
    _ = ∑ _i : I, (d : ℂ) := by
      refine Finset.sum_congr rfl ?_
      intro i _hi
      simpa [Section1.degree] using hdeg i j hj
    _ = (Fintype.card I : ℂ) * (d : ℂ) := by simp
    _ = (Nat.card W1 : ℂ) * (d : ℂ) := by
      rw [← Nat.card_eq_fintype_card, hI]
    _ = (d : ℂ) * (Nat.card W1 : ℂ) := by ring

/-- Arithmetic part of PF `(11.8.1)`: the Frobenius count forces the sign. -/
private theorem theorem_11_8_1_sign_count_of_uniform_arithmetic
    (q u n s : ℕ)
    (δ : ℤ) :
    Nat.Prime q →
      Odd q →
        (δ = 1 ∨ δ = -1) →
          (u : ℤ) = (n : ℤ) * (q : ℤ) + δ →
            u = s * q + 1 →
              δ = 1 ∧ n = s := by
  intro hqprime hqodd hδ hdn hcount
  subst u
  norm_num at hdn
  rcases hδ with rfl | hδneg
  · constructor
    · rfl
    · have h' : (n : ℤ) * (q : ℤ) = (s : ℤ) * (q : ℤ) := by
        nlinarith [hdn]
      have hnat : n * q = s * q := by
        exact_mod_cast h'
      exact Nat.eq_of_mul_eq_mul_right hqprime.pos hnat
  · subst δ
    exfalso
    have htwo : (2 : ℤ) = ((n : ℤ) - (s : ℤ)) * (q : ℤ) := by
      nlinarith [hdn]
    have hdiv2 : (q : ℤ) ∣ (2 : ℤ) := by
      exact ⟨(n : ℤ) - (s : ℤ), by simpa [mul_comm] using htwo⟩
    have hq2dvd : q ∣ 2 := by
      exact_mod_cast hdiv2
    have hqeq2 : q = 2 := by
      have h2prime : Nat.Prime 2 := by decide
      simpa using (Nat.prime_eq_prime_of_dvd_pow (m := 1) hqprime h2prime hq2dvd)
    subst q
    rcases hqodd with ⟨k, hk⟩
    omega

