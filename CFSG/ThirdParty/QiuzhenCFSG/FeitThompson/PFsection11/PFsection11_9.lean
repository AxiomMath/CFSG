/-- If a subgroup normalizes both ambient factors, it normalizes the centralizer
inside one factor. This is the local normalizer calculation needed for
`C = C_U(H)`. -/
private theorem theorem_11_3_subgroupCentralizerIn_le_normalizer_of_le_normalizers
    {G : Type u}
    [Group G]
    (N E A : Subgroup G) :
    N ≤ Subgroup.normalizer (E : Set G) →
      N ≤ Subgroup.normalizer (A : Set G) →
        N ≤ Subgroup.normalizer ((subgroupCentralizerIn E A : Subgroup G) : Set G) := by
  intro hNE hNA n hn
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    rcases hx with ⟨hxE, hxCent⟩
    refine ⟨?_, ?_⟩
    · exact ((Subgroup.mem_normalizer_iff.mp (hNE hn) x).1 hxE)
    · change n * x * n⁻¹ ∈ Subgroup.centralizer (A : Set G)
      rw [Subgroup.mem_centralizer_iff]
      intro a haA
      have hnA : n ∈ Subgroup.normalizer (A : Set G) := hNA hn
      have hninvA : n⁻¹ ∈ Subgroup.normalizer (A : Set G) :=
        (Subgroup.normalizer (A : Set G)).inv_mem hnA
      have ha' : n⁻¹ * a * n ∈ A := by
        simpa using ((Subgroup.mem_normalizer_iff.mp hninvA a).1 haA)
      have hxCent' : x ∈ Subgroup.centralizer (A : Set G) := hxCent
      have hcomm := (Subgroup.mem_centralizer_iff.mp hxCent') _ ha'
      calc
        a * (n * x * n⁻¹) = n * ((n⁻¹ * a * n) * x) * n⁻¹ := by group
        _ = n * (x * (n⁻¹ * a * n)) * n⁻¹ := by rw [hcomm]
        _ = (n * x * n⁻¹) * a := by group
  · intro hx
    rcases hx with ⟨hxE, hxCent⟩
    refine ⟨?_, ?_⟩
    · exact ((Subgroup.mem_normalizer_iff.mp (hNE hn) x).2 hxE)
    · change x ∈ Subgroup.centralizer (A : Set G)
      rw [Subgroup.mem_centralizer_iff]
      intro a haA
      have hnA : n ∈ Subgroup.normalizer (A : Set G) := hNA hn
      have ha' : n * a * n⁻¹ ∈ A :=
        ((Subgroup.mem_normalizer_iff.mp hnA a).1 haA)
      have hxCent' : n * x * n⁻¹ ∈ Subgroup.centralizer (A : Set G) := hxCent
      have hcomm := (Subgroup.mem_centralizer_iff.mp hxCent') _ ha'
      calc
        a * x = n⁻¹ * ((n * a * n⁻¹) * (n * x * n⁻¹)) * n := by group
        _ = n⁻¹ * ((n * x * n⁻¹) * (n * a * n⁻¹)) * n := by rw [hcomm]
        _ = x * a := by group

/-- In the source situation `C = C_U(H)`, the subgroup `H` normalizes `C`
because `C` centralizes `H`. -/
private theorem theorem_11_3_H_le_normalizer_C_of_eq
    {G : Type u}
    [Group G]
    (H U C : Subgroup G) :
    C = subgroupCentralizerIn U H →
      H ≤ Subgroup.normalizer (C : Set G) := by
  intro hCeq
  subst C
  have hC_le_centH : subgroupCentralizerIn U H ≤ Subgroup.centralizer (H : Set G) :=
    inf_le_right
  have hH_le_centC : H ≤ Subgroup.centralizer ((subgroupCentralizerIn U H : Subgroup G) : Set G) :=
    Subgroup.le_centralizer_iff.mpr hC_le_centH
  exact hH_le_centC.trans (centralizer_le_normalizer (subgroupCentralizerIn U H))

/-- If `H` is normal in `M` and `U ≤ M`, then `U` normalizes
`C = C_U(H)`. -/
private theorem theorem_11_3_U_le_normalizer_C_of_eq
    {G : Type u}
    [Group G]
    (M H U C : Subgroup G) :
    H ≤ M →
      U ≤ M →
        (H.subgroupOf M).Normal →
          C = subgroupCentralizerIn U H →
            U ≤ Subgroup.normalizer (C : Set G) := by
  intro hHM hUM hHnorm hCeq
  have hM_norm_H : M ≤ Subgroup.normalizer (H : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hHM).mp hHnorm
  have hU_norm_H : U ≤ Subgroup.normalizer (H : Set G) := hUM.trans hM_norm_H
  have hU_norm_C :
      U ≤ Subgroup.normalizer ((subgroupCentralizerIn U H : Subgroup G) : Set G) :=
    theorem_11_3_subgroupCentralizerIn_le_normalizer_of_le_normalizers
      U U H Subgroup.le_normalizer hU_norm_H
  simpa [hCeq] using hU_norm_C

/-- If `W1` normalizes `U` and lies in `M`, then it normalizes
`C = C_U(H)` because `H` is normal in `M`. -/
private theorem theorem_11_3_W1_le_normalizer_C_of_eq
    {G : Type u}
    [Group G]
    (M H U C W1 : Subgroup G) :
    H ≤ M →
      W1 ≤ M →
        W1 ≤ subgroupNormalizerIn M (U : Set G) →
          (H.subgroupOf M).Normal →
            C = subgroupCentralizerIn U H →
              W1 ≤ Subgroup.normalizer (C : Set G) := by
  intro hHM hW1M hW1normU hHnorm hCeq
  have hM_norm_H : M ≤ Subgroup.normalizer (H : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hHM).mp hHnorm
  have hW1_norm_H : W1 ≤ Subgroup.normalizer (H : Set G) := hW1M.trans hM_norm_H
  have hW1_norm_U : W1 ≤ Subgroup.normalizer (U : Set G) :=
    hW1normU.trans (section10_subgroupNormalizerIn_le_normalizer M (U : Set G))
  have hW1_norm_C :
      W1 ≤ Subgroup.normalizer ((subgroupCentralizerIn U H : Subgroup G) : Set G) :=
    theorem_11_3_subgroupCentralizerIn_le_normalizer_of_le_normalizers
      W1 U H hW1_norm_U hW1_norm_H
  simpa [hCeq] using hW1_norm_C

/-- If the source decomposition writes `M` as generated by the three factors
that normalize `C`, then `C` is normal in `M`. -/
private theorem theorem_11_3_C_normal_subgroupOf_of_sup_eq
    {G : Type u}
    [Group G]
    (M H U C W1 : Subgroup G) :
    C ≤ M →
      M = (H ⊔ U) ⊔ W1 →
        H ≤ Subgroup.normalizer (C : Set G) →
          U ≤ Subgroup.normalizer (C : Set G) →
            W1 ≤ Subgroup.normalizer (C : Set G) →
              (C.subgroupOf M).Normal := by
  intro hCM hM_eq hHnormC hUnormC hW1normC
  have hM_norm_C : M ≤ Subgroup.normalizer (C : Set G) := by
    rw [hM_eq]
    exact sup_le (sup_le hHnormC hUnormC) hW1normC
  exact (Subgroup.normal_subgroupOf_iff_le_normalizer hCM).mpr hM_norm_C

/-- Once the source setup proves `C ⊲ M`, the two normality fields needed for
the substituted PF `(6.3)` package follow formally from the normality of `H0`
and `H` in `M`. -/
private theorem theorem_11_3_core_normalities_of_C_normal
    {G : Type u}
    [Group G]
    (M H C H0 : Subgroup G) :
    H0 ≤ M →
      H ≤ M →
        C ≤ M →
