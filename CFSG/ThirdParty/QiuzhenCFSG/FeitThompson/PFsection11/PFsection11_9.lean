/-- The subgroup `HC` is solvable in the `(11.5)` context, because its
transport into `M` is nilpotent. -/
private theorem theorem_11_5_HC_solvable_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Group.IsSolvable ↥(H ⊔ C) := by
  intro h11
  have hHCnilM : Group.IsNilpotent ((H ⊔ C).subgroupOf M) :=
    theorem_11_3_HC_nilpotent_subgroupOf_M_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hCM : C ≤ M :=
    theorem_11_3_C_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHCM : H ⊔ C ≤ M := sup_le hHM hCM
  let eM : ((H ⊔ C).subgroupOf M) ≃* ↥(H ⊔ C) :=
    Subgroup.subgroupOfEquivOfLe hHCM
  haveI : Group.IsNilpotent ((H ⊔ C).subgroupOf M) := hHCnilM
  have hHCnil : Group.IsNilpotent ↥(H ⊔ C) := Group.nilpotent_of_mulEquiv eM
  haveI : Group.IsNilpotent ↥(H ⊔ C) := hHCnil
  exact inferInstance

/-- In the `(11.5)` context, the acting group `W₁` has order coprime to
`HC`. -/
private theorem theorem_11_5_W1_card_coprime_HC_card_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Nat.Coprime (Nat.card W1) (Nat.card ↥(H ⊔ C)) := by
  intro h11
  let D : Subgroup G := ambientDerivedSubgroup M
  have hPDef : Section8.typePDefinitionData M MF U W1 W2 :=
    theorem_11_5_typePDefinitionData_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  rcases hPDef with
    ⟨_hMF, _hW1cyc, _hW1ne, hW1hall, hcompMW1, _hUleD, _hUnil,
      _hW1normU, _hcompDU, _hMFnotCyc, _hSecond, _hfitMF, _hfitD,
      _hW2le, _hW2cyc, _hW2ne, _hcentW1, _hW0norm⟩
  rcases hW1hall with ⟨hW1M_hall, hHallW1M⟩
  have hDleM : D ≤ M := by
    dsimp [D]
    exact section12_ambientDerivedSubgroup_le
  have hDnormalM : (D.subgroupOf M).Normal := by
    dsimp [D]
    exact (section12_normalIn_ambientDerivedSubgroup (E := M)).2
  have hDnormalInM : section10NormalIn D M := ⟨hDleM, hDnormalM⟩
  have hDcompW1 : (D.subgroupOf M).IsComplement' (W1.subgroupOf M) :=
    theorem_11_3_complementIn_left_normal_isComplement'
      (D := M) (K := D) (L := W1)
      (by simpa [D] using hcompMW1) hDnormalInM
  have hW1index : (W1.subgroupOf M).index = Nat.card D := by
    have hidx := hDcompW1.index_eq_card
    rw [natCard_subgroupOf_eq D M hDleM] at hidx
    exact hidx
  have hW1cardSub : Nat.card (W1.subgroupOf M) = Nat.card W1 :=
    natCard_subgroupOf_eq W1 M hW1M_hall
  have hcopD : Nat.Coprime (Nat.card W1) (Nat.card D) := by
    have hcopSub : Nat.Coprime (Nat.card (W1.subgroupOf M)) (Nat.card D) := by
      simpa [Nat.card_eq_fintype_card, hW1index] using hHallW1M.card_coprime_index
    rw [hW1cardSub] at hcopSub
    exact hcopSub
  have hHCD : H ⊔ C ≤ D := by
    dsimp [D]
    exact theorem_11_5_HC_le_ambientDerived_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hHCcardDvdD : Nat.card ↥(H ⊔ C) ∣ Nat.card D := by
    have hsub_dvd : Nat.card (((H ⊔ C).subgroupOf D)) ∣ Nat.card D :=
      Subgroup.card_subgroup_dvd_card ((H ⊔ C).subgroupOf D)
    rwa [natCard_subgroupOf_eq (H ⊔ C) D hHCD] at hsub_dvd
  exact Nat.Coprime.of_dvd_right hHCcardDvdD hcopD

/-- If a finite group acts fixed-point-freely on a finite group, then the actor
order divides one less than the target order. -/
private theorem theorem_11_5_natCard_actor_dvd_group_card_sub_one
    {A Q : Type*} [Group A] [Finite A] [Group Q] [Finite Q]
    [MulDistribMulAction A Q]
    (hfree : ∀ a : A, a ≠ 1 → ∀ q : Q, a • q = q → q = 1) :
    Nat.card A ∣ Nat.card Q - 1 := by
  classical
  let α := {q : Q // q ≠ 1}
  letI : MulAction A α :=
    { smul := fun a x => ⟨a • (x : Q), by
        intro h
        apply x.2
        have h' := congrArg (fun y : Q => a⁻¹ • y) h
        simpa using h'⟩
      one_smul := by
        intro x
        apply Subtype.ext
        change (1 : A) • (x : Q) = (x : Q)
        simp
      mul_smul := by
        intro a b x
        apply Subtype.ext
        change (a * b) • (x : Q) = a • (b • (x : Q))
        rw [mul_smul] }
  have hstab : ∀ x : α, MulAction.stabilizer A x = ⊥ := by
    intro x
    rw [eq_bot_iff]
    intro a ha
    have hax : a • x = x := by
      simpa [MulAction.mem_stabilizer_iff] using ha
    by_contra ha_not_bot
    have ha_ne : a ≠ 1 := by
      intro ha1
      apply ha_not_bot
      simp [ha1]
    have hfix : a • (x : Q) = (x : Q) := congrArg Subtype.val hax
    exact x.2 (hfree a ha_ne (x : Q) hfix)
  have hcard_equiv := Nat.card_congr (MulAction.selfEquivOrbitsQuotientProd hstab)
  have hcardα : Nat.card α = Nat.card Q - 1 := by
    letI : Fintype Q := Fintype.ofFinite Q
    letI : Fintype α := Fintype.ofFinite α
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    change Fintype.card {q : Q // q ≠ 1} = Fintype.card Q - 1
    simp
  rw [hcardα, Nat.card_prod] at hcard_equiv
  exact ⟨Nat.card (Quotient (MulAction.orbitRel A α)), by
    rw [mul_comm]
    exact hcard_equiv⟩

/-- In the `(11.5)` context, all `W₁`-fixed points in `HC` already lie in
`M''`. -/
private theorem theorem_11_5_fixedPointSubgroup_HC_le_secondDerived
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    (h11 : hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q) →
      let HC : Subgroup G := H ⊔ C
      let DD : Subgroup G := ambientDerivedSubgroup (ambientDerivedSubgroup M)
      letI : Subgroup.Normalizes W1 HC :=
        ⟨by
          dsimp [HC]
          exact theorem_11_5_W1_le_normalizer_HC_of_hypothesis
            M MF H U C H0 W1 W2 S τ p q h11⟩
      fixedPointSubgroup W1 HC ≤ DD.subgroupOf HC := by
  intro h11
  let HC : Subgroup G := H ⊔ C
  let DD : Subgroup G := ambientDerivedSubgroup (ambientDerivedSubgroup M)
  have hW1normHC : W1 ≤ Subgroup.normalizer ((HC : Subgroup G) : Set G) := by
    dsimp [HC]
    exact theorem_11_5_W1_le_normalizer_HC_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  letI : Subgroup.Normalizes W1 HC := ⟨hW1normHC⟩
  dsimp
  intro x hxfix
  have hPDef : Section8.typePDefinitionData M MF U W1 W2 :=
    theorem_11_5_typePDefinitionData_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  rcases hPDef with
    ⟨_hMF, _hW1cyc, hW1ne, _hW1hall, _hcompMW1, _hUleD, _hUnil,
      _hW1normU, _hcompDU, _hMFnotCyc, _hSecond, _hfitMF, _hfitD,
      _hW2leInf, _hW2cyc, _hW2ne, hcentW1, _hhatNorm⟩
  rcases Subgroup.ne_bot_iff_exists_ne_one.mp hW1ne with ⟨w, hw_ne⟩
  let wG : G := (w : G)
  have hwW1 : wG ∈ W1 := w.property
  have hwG_ne : wG ≠ 1 := by
    intro hw
    apply hw_ne
    exact Subtype.ext hw
  have hxHC : (x : G) ∈ HC := x.property
  have hxD : (x : G) ∈ ambientDerivedSubgroup M :=
    theorem_11_5_HC_le_ambientDerived_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11 hxHC
  have hxfix_w : w • x = x := by
    simpa using hxfix w
  have hxconj : wG * (x : G) * wG⁻¹ = (x : G) := by
    simpa [wG, Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe] using
      congrArg Subtype.val hxfix_w
  have hxcomm : (x : G) * wG = wG * (x : G) := by
    have hmul := congrArg (fun t : G => t * wG) hxconj
    simpa [wG, mul_assoc] using hmul.symm
  have hxcent : (x : G) ∈ elementCentralizerIn (ambientDerivedSubgroup M) wG := by
    refine ⟨hxD, ?_⟩
    exact Subgroup.mem_centralizer_singleton_iff.mpr hxcomm
  have hxW2 : (x : G) ∈ W2 := by
    simpa [hcentW1 wG hwW1 hwG_ne] using hxcent
  have hW2DD : W2 ≤ DD := by
    dsimp [DD]
    exact theorem_11_5_W2_le_secondDerived_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  simpa [Subgroup.mem_subgroupOf] using hW2DD hxW2

/-- The fixed-point-free quotient action gives the divisibility
`q ∣ |HC:M''| - 1`. -/
private theorem theorem_11_5_fixedPointFree_index_dvd
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      q ∣ (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) - 1 := by
  intro h11
  classical
  let HC : Subgroup G := H ⊔ C
  let DD : Subgroup G := ambientDerivedSubgroup (ambientDerivedSubgroup M)
  have hW1normHC : W1 ≤ Subgroup.normalizer ((HC : Subgroup G) : Set G) := by
    dsimp [HC]
    exact theorem_11_5_W1_le_normalizer_HC_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  letI : Subgroup.Normalizes W1 HC := ⟨hW1normHC⟩
  have hDDnorm : (DD.subgroupOf HC).Normal := by
    dsimp [DD, HC]
    exact theorem_11_5_secondDerived_subgroupOf_HC_normal
      M MF H U C H0 W1 W2 S τ p q h11
  letI : (DD.subgroupOf HC).Normal := hDDnorm
  have hInv : IsInvariant W1 HC (DD.subgroupOf HC) := by
    dsimp [DD, HC]
    exact theorem_11_5_isInvariant_secondDerived_subgroupOf_HC
      M MF H U C H0 W1 W2 S τ p q h11
  letI : MulDistribMulAction W1 (HC ⧸ DD.subgroupOf HC) :=
