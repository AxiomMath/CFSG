            have hright : (derivedSubgroup M).relIndex (⊤ : Subgroup M) = q :=
              theorem_11_3_derived_relIndex_top_eq_q_of_hypothesis
                M MF H U C H0 W1 W2 S τ p q h11
            rw [hleft]
            change Nat.card (H ⧸ H0.subgroupOf H) >
