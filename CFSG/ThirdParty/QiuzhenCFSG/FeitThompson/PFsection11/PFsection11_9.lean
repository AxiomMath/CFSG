/-- The base PF `(9.5)` family `S(H0)`, retained together with its
containment in the Section 10 family. -/
private theorem theorem_11_8_1_exists_base_kernel_family_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ)
    (h11 : hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q) :
    ∃ SH0 : Finset (Section1.ClassFunction M),
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 ∧
        SH0 ⊆ S := by
  classical
  have hH0bot : H0 = ⊥ :=
    (theorem_11_7 M MF H U C H0 W1 W2 S τ p q h11).2.2
  have hMFleD : MF ≤ ambientDerivedSubgroup M := by
    rcases h11 with
      ⟨_h10, hHMF, _htype, hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOdd, _h92⟩
    simpa [hHMF] using hHleD
  have hH0leD : H0 ≤ ambientDerivedSubgroup M := by
    rw [hH0bot]
