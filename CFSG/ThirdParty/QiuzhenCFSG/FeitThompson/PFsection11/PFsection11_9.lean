/-- The Section 1 kernel condition is invariant under complex conjugation of
class functions. -/
private theorem theorem_11_5_subgroupInKernel_conjugateCharacter_iff
    {G : Type*}
    [Group G]
    (χ : Section1.ClassFunction G)
    (A : Subgroup G) :
    Section1.subgroupInKernel' (Section1.conjugateCharacter χ) A ↔
      Section1.subgroupInKernel' χ A := by
  constructor
  · intro h a
    have ha := h a
    have hstar := congrArg star ha
    simpa [Section1.subgroupInKernel', Section1.conjugateCharacter,
      Section1.degree] using hstar
  · intro h a
    have ha := h a
    have hstar := congrArg star ha
    simpa [Section1.subgroupInKernel', Section1.conjugateCharacter,
      Section1.degree] using hstar

/-- Any Section 11 subfamily `S(H₁)` is closed under complex conjugation once
the ambient family satisfies PF `(5.2.a)`, as provided by Hypothesis `(11.2)`. -/
private theorem theorem_11_5_subfamily_conjugate_closed_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 H1 : Subgroup G)
    (S S1 : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
