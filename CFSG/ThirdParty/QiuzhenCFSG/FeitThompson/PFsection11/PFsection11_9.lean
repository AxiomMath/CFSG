/-- A character in the PF `(9.8.d)` family `S(H0 U')` cannot belong to
`S(HC)` in the PF `(11.9.c)` specialization `H0 = 1`, `U' = C`.  Otherwise
its `HC` kernel transfers through induction from `M'` and contradicts the
defining nonkernel condition on the inducing irreducible character. -/
private theorem theorem_11_9_case_a_lambda_ne_SHC_of_kernel_family
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 Uprime : Subgroup G)
    (S SHC SH0U : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (ζ lam : Section1.ClassFunction M)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      section11Subfamily (H ⊔ C) S SHC →
        ζ ∈ SHC →
          Uprime = C →
            H0 = ⊥ →
              Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                (H0 ⊔ Uprime) SH0U →
                lam ∈ SH0U →
                  lam ≠ ζ := by
  intro h11 hSHC hζ hUprimeC hH0bot hSH0U hlam hEq
  have hlamSHC : lam ∈ SHC := by simpa [hEq] using hζ
  have hlamKerHC :
      Section1.subgroupInKernel' lam ((H ⊔ C).subgroupOf M) :=
    ((hSHC.2 lam).mp hlamSHC).2
  have hKernelC :
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF C SH0U := by
    simpa [hH0bot, hUprimeC] using hSH0U
  rcases hKernelC with ⟨_hCD, _hMFD, hmem⟩
  rcases (hmem lam).mp hlam with
    ⟨θ, hθirr, hθnotMF, _hθkerC, hlamInd⟩
  have hHCleD : H ⊔ C ≤ ambientDerivedSubgroup M := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, hHD, hUD, hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, _hOddAnd92⟩
    have hCU : C ≤ U := by
      rw [hCeq]
      exact inf_le_left
    exact sup_le hHD (hCU.trans hUD)
  have hHCsubD :
      (H ⊔ C).subgroupOf M ≤ (ambientDerivedSubgroup M).subgroupOf M := by
    intro x hx
    exact Subgroup.mem_subgroupOf.mpr (hHCleD (Subgroup.mem_subgroupOf.mp hx))
  have hHCnormal : ((H ⊔ C).subgroupOf M).Normal :=
    (theorem_11_3_core_normalities_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11).2
  have hDnormal : ((ambientDerivedSubgroup M).subgroupOf M).Normal := by
    simpa using (section12_normalIn_ambientDerivedSubgroup (G := G) (E := M)).2
  letI : ((H ⊔ C).subgroupOf M).Normal := hHCnormal
  letI : ((ambientDerivedSubgroup M).subgroupOf M).Normal := hDnormal
  rcases hθirr with ⟨n, ρ, _hρirr, hθeq⟩
  subst θ
  have hIndKer :
      Section1.subgroupInKernel'
        (Section1.inducedCF ((ambientDerivedSubgroup M).subgroupOf M) ρ.character)
        ((H ⊔ C).subgroupOf M) := by
    exact Section1.subgroupInKernel'_of_eq hlamInd hlamKerHC
  have hSourceKer :
      Section1.subgroupInKernel' ρ.character
        (((H ⊔ C).subgroupOf M).subgroupOf
          ((ambientDerivedSubgroup M).subgroupOf M)) :=
    (Section1.proposition_1_6_a
      ((ambientDerivedSubgroup M).subgroupOf M) ((H ⊔ C).subgroupOf M)
      hHCsubD ρ).mpr hIndKer
  apply hθnotMF
  apply Section9.subgroupInKernel'_mono_sec9 _ hSourceKer
  intro x hx
  rcases h11 with ⟨_h10, hHMF, _hrest⟩
  apply Subgroup.mem_subgroupOf.mpr
  apply Subgroup.mem_sup_left
  rw [hHMF]
  exact Subgroup.mem_subgroupOf.mp hx


private theorem theorem_11_9_case_a_selected_muColumn_orthogonality
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    [DecidableEq I]
    [DecidableEq J]
    (M MF H U C H0 W1 W2 Uprime : Subgroup G)
    (W : Subgroup M)
    (A A0 : Set M)
    (S SHC SH0U : Finset (Section1.ClassFunction M))
    (i0 : I)
    (j0 j : J)
    (μ : I → J → Section1.ClassFunction M)
    (δSign : J → ℤ)
    (ω : I → J → Section1.ClassFunction W)
    (σ : Section1.ClassFunction W →ₗ[ℂ] Section1.ClassFunction G)
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (ζ lam : Section1.ClassFunction M)
    (p q a u : ℕ) :
