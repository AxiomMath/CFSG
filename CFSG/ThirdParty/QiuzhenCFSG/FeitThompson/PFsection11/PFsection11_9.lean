/-- A local Hall-subgroup transfer for the `M_F ≤ D ≤ M` interval used to
apply BG Lemma 6.3(a.1) inside `M'`. -/
private theorem theorem_11_6_mf_hallSubgroup_in_intermediate
    {G : Type u}
