  classical
  let α : Section1.ClassFunction M := Section10.muColumn μ j0 - ζ
  let β : Section1.ClassFunction M :=
    Section10.muColumn μ j - (((u / a : ℕ) : ℂ) • lam)
  have hNotation' := hNotation
  rcases Section10.derivedSupportedFourSixData_of_hypothesis_10_1_supported_data
      h11.1 hNotation with
    ⟨_σM, _xChar, _H_A, _H_A0, hFull⟩
  rcases hFull with
    ⟨h46, _hW2K, _h31, _hIso, _hVirt, _hClass, _hPrin, _h22A,
