    (G := G) (E := ambientDerivedSubgroup M)).trans
      (section12_ambientDerivedSubgroup_le (G := G) (E := M))

/-- The ambient second derived subgroup is normal in `M`.

This is the formal version of the source fact that `M''` is characteristic in
`M'` and `M'` is normal in `M`. -/
private theorem theorem_11_5_secondDerived_normalIn_M
    {G : Type u}
    [Group G]
    [Finite G]
    (M : Subgroup G) :
    section10NormalIn (ambientDerivedSubgroup (ambientDerivedSubgroup M)) M := by
  let D : Subgroup G := ambientDerivedSubgroup M
  let DD : Subgroup G := ambientDerivedSubgroup D
  have hDDleM : DD ≤ M := by
    dsimp [DD, D]
    exact theorem_11_5_secondDerived_le_M M
  refine ⟨by simpa [DD, D] using hDDleM, ?_⟩
  have hDnormInM : section10NormalIn D M := by
    dsimp [D]
    exact section12_normalIn_ambientDerivedSubgroup (E := M)
  have hMnormD : M ≤ Subgroup.normalizer (D : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hDnormInM.1).1 hDnormInM.2
  have hNormDnormDD :
      Subgroup.normalizer (D : Set G) ≤ Subgroup.normalizer (DD : Set G) := by
    dsimp [DD]
    simpa [ambientDerivedSubgroup] using
      (section10_normalizer_le_normalizer_map_subtype_of_characteristic D
        (derivedSubgroup D))
  exact (Subgroup.normal_subgroupOf_iff_le_normalizer hDDleM).2
    (hMnormD.trans hNormDnormDD)

/-- A finite solvable nontrivial subgroup has proper ambient derived subgroup. -/
private theorem theorem_11_5_ambientDerived_lt_of_solvable_ne_bot
    {G : Type u}
    [Group G]
    [Finite G]
    (E : Subgroup G) :
    Group.IsSolvable E →
      E ≠ ⊥ →
        ambientDerivedSubgroup E < E := by
  intro hsolv hne
  classical
  have _ : Group.IsSolvable E := hsolv
  haveI : Nontrivial E := (Subgroup.nontrivial_iff_ne_bot (H := E)).2 hne
  have hDlt : derivedSubgroup E < (⊤ : Subgroup E) := by
    simpa [derivedSubgroup, derivedSeries_one, _root_.commutator] using
      Group.IsSolvable.commutator_lt_top_of_nontrivial (G := E)
  refine lt_of_le_of_ne section12_ambientDerivedSubgroup_le ?_
  intro hEq
  have hDtop : derivedSubgroup E = (⊤ : Subgroup E) := by
    have hsubtop : (ambientDerivedSubgroup E).subgroupOf E = ⊤ := by
      rw [hEq]
      exact Subgroup.subgroupOf_eq_top.2 le_rfl
    simpa [section12_ambientDerivedSubgroup_subgroupOf_eq] using hsubtop
  exact hDlt.ne hDtop

/-- In the active Type `P` context, the second derived subgroup is strictly
below the first derived subgroup. -/
private theorem theorem_11_5_secondDerived_lt_ambientDerived_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ambientDerivedSubgroup (ambientDerivedSubgroup M) < ambientDerivedSubgroup M := by
  intro h11
  let D : Subgroup G := ambientDerivedSubgroup M
  have hPDef : Section8.typePDefinitionData M MF U W1 W2 :=
    theorem_11_5_typePDefinitionData_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hDsolv : Group.IsSolvable D := by
    dsimp [D]
    exact theorem_11_3_ambientDerived_solvable_of_typePDefinitionData M MF U W1 W2 hPDef
  have hDne : D ≠ ⊥ := by
    rcases hPDef with
      ⟨_hMF, _hW1cyc, _hW1ne, _hW1hall, _hcompMD, _hUleD, _hUnil,
        _hW1normU, _hcompDU, _hMFnotCyc, _hSecond, _hfitMF, _hfitD,
        hW2le, _hW2cyc, hW2ne, _hcentW1, _hW0norm⟩
    intro hDbot
    have hW2leD : W2 ≤ D := by
      dsimp [D]
      exact (le_inf_iff.mp hW2le).2.trans section12_ambientDerivedSubgroup_le
    have hW2bot : W2 = ⊥ :=
      le_bot_iff.mp (by simpa [hDbot] using hW2leD)
    exact hW2ne hW2bot
  exact theorem_11_5_ambientDerived_lt_of_solvable_ne_bot D hDsolv hDne

/-- Transporting `M''` into `M` agrees with taking the ambient derived subgroup
of the internal subgroup `M'`. -/
private theorem theorem_11_5_secondDerived_subgroupOf_eq_ambientDerived_derived
    {G : Type u}
    [Group G]
    [Finite G]
    (M : Subgroup G) :
    ((ambientDerivedSubgroup (ambientDerivedSubgroup M)).subgroupOf M) =
      ambientDerivedSubgroup (derivedSubgroup M) := by
  let D : Subgroup G := ambientDerivedSubgroup M
  have hDleM : D ≤ M := by
    dsimp [D]
    exact section12_ambientDerivedSubgroup_le
  have hDDleM : ambientDerivedSubgroup D ≤ M :=
    section12_ambientDerivedSubgroup_le.trans hDleM
  apply Subgroup.map_injective M.subtype_injective
  calc
    (((ambientDerivedSubgroup (ambientDerivedSubgroup M)).subgroupOf M).map M.subtype)
        = ambientDerivedSubgroup D := by
          dsimp [D]
          exact Subgroup.map_subgroupOf_eq_of_le hDDleM
    _ = ⁅D, D⁆ := section12_ambientDerivedSubgroup_eq_commutator
    _ = (⁅D.subgroupOf M, D.subgroupOf M⁆).map M.subtype := by
          exact (commutator_subgroupOf_map_eq M D D hDleM hDleM).symm
    _ = (⁅derivedSubgroup M, derivedSubgroup M⁆).map M.subtype := by
          rw [show D.subgroupOf M = derivedSubgroup M by
            dsimp [D]
            exact section12_ambientDerivedSubgroup_subgroupOf_eq]
    _ = (ambientDerivedSubgroup (derivedSubgroup M)).map M.subtype := by
          rw [section12_ambientDerivedSubgroup_eq_commutator]

/-- The quotient `M'/M''` is abelian. -/
private theorem theorem_11_5_secondDerived_quotient_commutative
    {G : Type u}
    [Group G]
    [Finite G]
    (M : Subgroup G)
    (hnorm : ((ambientDerivedSubgroup (ambientDerivedSubgroup M)).subgroupOf M).Normal) :
    IsMulCommutative
      (derivedSubgroup M ⧸
        ((ambientDerivedSubgroup (ambientDerivedSubgroup M)).subgroupOf M).subgroupOf
          (derivedSubgroup M)) := by
  let A : Subgroup M := (ambientDerivedSubgroup (ambientDerivedSubgroup M)).subgroupOf M
  let K : Subgroup M := derivedSubgroup M
  have hA_norm : A.Normal := by simpa [A] using hnorm
  have hA_eq : A = ambientDerivedSubgroup K := by
    dsimp [A, K]
    exact theorem_11_5_secondDerived_subgroupOf_eq_ambientDerived_derived M
  haveI : (A.subgroupOf K).Normal := hA_norm.subgroupOf K
  refine { is_comm := (Subgroup.Normal.quotient_commutative_iff_commutator_le
    (N := A.subgroupOf K)).2 ?_ |>.is_comm }
  rw [hA_eq]
  rw [section12_ambientDerivedSubgroup_subgroupOf_eq]
  exact le_rfl

/-- The canonical book subfamily `S(M'')`, expressed by filtering by the
subgroup-kernel condition. -/
private theorem theorem_11_5_secondDerived_filter_subfamily
    {G : Type u}
