/-- The derived-subgroup algebra in the source line
`M'' ∩ U ≤ (H U') ∩ U`: first, `M''` lies in `H U'`. -/
private theorem theorem_11_6_secondDerived_le_H_sup_ambientDerived_U_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      ambientDerivedSubgroup (ambientDerivedSubgroup M) ≤ H ⊔ ambientDerivedSubgroup U := by
  intro h11
  classical
  let D : Subgroup G := ambientDerivedSubgroup M
  have hHleD : H ≤ D := by
    dsimp [D]
    rcases h11 with
      ⟨_h10, _hHMF, _htype, hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef⟩
    exact hHleD
  have hUleD : U ≤ D := by
    dsimp [D]
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef⟩
    exact hUleD
  have hDleM : D ≤ M := by
    dsimp [D]
    exact section12_ambientDerivedSubgroup_le (E := M)
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHnormM : (H.subgroupOf M).Normal :=
    theorem_11_3_H_normal_subgroupOf_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hMnormH : M ≤ Subgroup.normalizer (H : Set G) :=
    Subgroup.le_normalizer_of_normal_subgroupOf hHM
  have hDnormH : D ≤ Subgroup.normalizer (H : Set G) := hDleM.trans hMnormH
  have hHnormD : (H.subgroupOf D).Normal := by
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer hHleD).2 hDnormH
  have hD_eq_HU : D = H ⊔ U := by
    dsimp [D]
    exact theorem_11_3_ambientDerived_eq_H_sup_U_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have hsup_local : H.subgroupOf D ⊔ U.subgroupOf D = ⊤ := by
    calc
      H.subgroupOf D ⊔ U.subgroupOf D = (H ⊔ U).subgroupOf D := by
        symm
        exact Subgroup.subgroupOf_sup (A := H) (A' := U) (B := D) hHleD hUleD
      _ = D.subgroupOf D := by rw [← hD_eq_HU]
      _ = ⊤ := by simp
  have hderD :
      derivedSubgroup D ≤ H.subgroupOf D ⊔ ⁅U.subgroupOf D, U.subgroupOf D⁆ := by
    letI : (H.subgroupOf D).Normal := hHnormD
    exact lemma_6_5_derived_le_sup_commutator hsup_local
  have hmap_le :
      (H.subgroupOf D ⊔ ⁅U.subgroupOf D, U.subgroupOf D⁆).map D.subtype ≤
        H ⊔ ambientDerivedSubgroup U := by
    rw [Subgroup.map_sup]
    refine sup_le ?_ ?_
    · rw [Subgroup.map_subgroupOf_eq_of_le hHleD]
      exact le_sup_left
    · have hcomm_map :
          (⁅U.subgroupOf D, U.subgroupOf D⁆).map D.subtype = ⁅U, U⁆ := by
        exact commutator_subgroupOf_map_eq D U U hUleD hUleD
      rw [hcomm_map, ← section12_ambientDerivedSubgroup_eq_commutator]
      exact le_sup_right
  intro x hx
  have hxD : x ∈ D := section12_ambientDerivedSubgroup_le hx
  let xD : D := ⟨x, hxD⟩
  have hxsub : xD ∈ (ambientDerivedSubgroup D).subgroupOf D := by
    exact hx
  have hxder : xD ∈ derivedSubgroup D := by
    simpa [section12_ambientDerivedSubgroup_subgroupOf_eq, derivedSubgroup, derivedSeries_one]
      using hxsub
  have hxjoin : xD ∈ H.subgroupOf D ⊔ ⁅U.subgroupOf D, U.subgroupOf D⁆ :=
    hderD hxder
  have hxmap :
      (xD : G) ∈
        (H.subgroupOf D ⊔ ⁅U.subgroupOf D, U.subgroupOf D⁆).map D.subtype :=
    Subgroup.mem_map_of_mem D.subtype hxjoin
  exact hmap_le hxmap

/-- The reverse endpoint containment in `(11.6)`: from `C ≤ M'' ∩ U` and
`M'' ≤ H U'`, the Type `P` disjointness of `H` and `U` gives `C ≤ U'`. -/
private theorem theorem_11_6_C_le_ambientDerived_U_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      C ≤ ambientDerivedSubgroup U := by
  intro h11
  classical
  let D : Subgroup G := ambientDerivedSubgroup M
  let K : Subgroup G := ambientDerivedSubgroup U
  have hHleD : H ≤ D := by
    dsimp [D]
    rcases h11 with
      ⟨_h10, _hHMF, _htype, hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef⟩
    exact hHleD
  have hUleD : U ≤ D := by
    dsimp [D]
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef⟩
    exact hUleD
  have hKleU : K ≤ U := by
    dsimp [K]
    exact section12_ambientDerivedSubgroup_le (E := U)
  have hKleD : K ≤ D := hKleU.trans hUleD
  have hDleM : D ≤ M := by
    dsimp [D]
    exact section12_ambientDerivedSubgroup_le (E := M)
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHnormM : (H.subgroupOf M).Normal :=
    theorem_11_3_H_normal_subgroupOf_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hMnormH : M ≤ Subgroup.normalizer (H : Set G) :=
    Subgroup.le_normalizer_of_normal_subgroupOf hHM
  have hDnormH : D ≤ Subgroup.normalizer (H : Set G) := hDleM.trans hMnormH
  have hHnormD : (H.subgroupOf D).Normal := by
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer hHleD).2 hDnormH
  have hdisjD : Disjoint (H.subgroupOf D) (U.subgroupOf D) := by
    rcases h11 with
      ⟨_h10, hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, hPDef, _hModd⟩
    rcases hPDef with
      ⟨_hMF, _hW1cyc, _hW1ne, _hW1hall, _hcompMW1, _hUleD, _hUnil, _hW1normU,
        hcomp, _hMFnotCyc, _hSecond, _hfit_eq, _hfit_leD, _hW2le, _hW2cyc,
        _hW2ne, _hcentW1, _hW0norm⟩
    have hcompH : section12ComplementIn D H U := by
      dsimp [D]
      simpa [hHMF] using hcomp
    rw [Subgroup.disjoint_def]
    intro y hyH hyU
    apply Subtype.ext
    have hyInf : (y : G) ∈ H ⊓ U :=
      ⟨by simpa [Subgroup.mem_subgroupOf] using hyH,
        by simpa [Subgroup.mem_subgroupOf] using hyU⟩
    simpa using hcompH.2.2.2.le_bot hyInf
  intro x hxC
  have hxDD : x ∈ ambientDerivedSubgroup D := by
    dsimp [D]
    exact theorem_11_6_C_le_secondDerived_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11 hxC
  have hxD : x ∈ D := section12_ambientDerivedSubgroup_le hxDD
  have hxU : x ∈ U :=
    theorem_11_6_C_le_U_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11 hxC
  have hxHUprime : x ∈ H ⊔ K := by
    dsimp [K]
    exact theorem_11_6_secondDerived_le_H_sup_ambientDerived_U_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11 hxDD
  let xD : D := ⟨x, hxD⟩
  have hxHUprimeD : xD ∈ H.subgroupOf D ⊔ K.subgroupOf D := by
    rw [show H.subgroupOf D ⊔ K.subgroupOf D = (H ⊔ K).subgroupOf D by
      symm
      exact Subgroup.subgroupOf_sup (A := H) (A' := K) (B := D) hHleD hKleD]
    exact hxHUprime
  letI : (H.subgroupOf D).Normal := hHnormD
  rcases (Subgroup.mem_sup_of_normal_left
      (s := H.subgroupOf D) (t := K.subgroupOf D) (x := xD)).1 hxHUprimeD with
    ⟨hD, hhH, kD, hkK, hmul⟩
  have hxUsubD : xD ∈ U.subgroupOf D := by
    exact hxU
  have hkUsubD : kD ∈ U.subgroupOf D := by
    exact hKleU (Subgroup.mem_subgroupOf.mp hkK)
  have hhUsubD : hD ∈ U.subgroupOf D := by
    have h_eq : hD = xD * kD⁻¹ := by
      rw [← hmul]
      group
    rw [h_eq]
    exact (U.subgroupOf D).mul_mem hxUsubD ((U.subgroupOf D).inv_mem hkUsubD)
  have hhbot : hD ∈ (⊥ : Subgroup D) := by
    have hhInf : hD ∈ H.subgroupOf D ⊓ U.subgroupOf D := ⟨hhH, hhUsubD⟩
    simpa [hdisjD.eq_bot] using hhInf
  have hh_one : hD = 1 := by
    simpa using hhbot
  have hxD_eq_kD : xD = kD := by
    rw [← hmul, hh_one, one_mul]
  have hxKsub : xD ∈ K.subgroupOf D := by
    simpa [hxD_eq_kD] using hkK
  exact Subgroup.mem_subgroupOf.mp hxKsub

/-- The final endpoint equality in `(11.6)`, combining `C ≤ U'` with the
PF `(8.5.b)` containment `U' ≤ C`. -/
private theorem theorem_11_6_C_eq_ambientDerived_U_of_hypothesis
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
