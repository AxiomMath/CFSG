    simpa [Section1.scalarProduct_star_swap] using congrArg star horth
  have hζmu :
      Section1.scalarProduct M ζ (Section10.muColumn μ j) = 0 := by
    rw [Section10.muColumn]
    have hsum :
        ((∑ i : I, μ i j : Section1.ClassFunction M)) =
          fun x => ∑ i : I, μ i j x := by
      ext x
      simp
    rw [hsum, Section1.scalarProduct_fintype_sum_right]
    apply Finset.sum_eq_zero
    intro i _hi
    exact Section5.scalarProduct_irreducible_piChar_eq_zero_pf53
      h46 hω h43b h45a h45b hInd ⟨ζ, hζS⟩ hζIrr i j
  have hζlam : Section1.scalarProduct M ζ lam = 0 := by
    rcases Section10.hypothesis_5_2_of_hypothesis_10_1_supported_data h11.1 with
