it, so coherence restricts to the active family.  This is the source's
`apply: subset_coherent (Ptype_core_coherence ...)` step. -/
private theorem theorem_11_9_case_a_active_pf911_coherence
    {G : Type u}
    [Group G]
    [Finite G]
    [IsMinCE G]
    (M MF H U C H0 W1 W2 Uprime : Subgroup G)
    (S SH0 SH0C SH0U : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (muQu : Section1.ClassFunction M)
    (p q a u : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      Uprime = C →
        q = Nat.card W1 →
          Section9.case_9_7_a_data M MF U W1 W2 H0 C p q a →
            Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF H0 SH0 →
              Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                (H0 ⊔ C) SH0C →
                Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
                  (H0 ⊔ Uprime) SH0U →
                  Section9.case_9_7_a_characterData M MF U H0 C Uprime p q a u
                    SH0 SH0C SH0U →
                    muQu ∈ SH0C →
                      Section6.coherentFamily SH0C τ := by
  intro h11 hUprimeC hqW1 hcase hSH0 hSH0C hSH0U hchar hmuQu
  let Cprime : Subgroup G := (_root_.commutator C).map C.subtype
  let SH0Cprime : Finset (Section1.ClassFunction M) :=
    Section9.kernelInducedSubfamily_sec9 M (ambientDerivedSubgroup M) MF
      (H0 ⊔ Cprime) SH0
  have hCprimeC : Cprime ≤ C := by
    simpa [Cprime] using theorem_11_commutator_map_le C
  have hCU : C ≤ U :=
    (theorem_11_quotientCentralizerIn_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11).1
  have hUderived : U ≤ ambientDerivedSubgroup M :=
    h11.2.2.2.2.1
  have hH0CprimeDerived : H0 ⊔ Cprime ≤ ambientDerivedSubgroup M :=
    sup_le hSH0.1 (hCprimeC.trans (hCU.trans hUderived))
  have hSH0Cprime :
      Section9.kernelInducedFamily M (ambientDerivedSubgroup M) MF
        (H0 ⊔ Cprime) SH0Cprime :=
    Section9.kernelInducedFamily_subfamily_of_le_sec9
      M (ambientDerivedSubgroup M) MF H0 (H0 ⊔ Cprime) SH0
      hH0CprimeDerived le_sup_left hSH0
  have hJoin : H0 ⊔ Cprime ≤ H0 ⊔ C :=
    sup_le_sup_left hCprimeC H0
  have hActiveSub : SH0C ⊆ SH0Cprime :=
    Section9.kernelInducedFamily_subset_of_le_sec9
      M (ambientDerivedSubgroup M) MF (H0 ⊔ Cprime) (H0 ⊔ C)
      SH0Cprime SH0C hJoin hSH0Cprime hSH0C
  have hPrimeNonempty : SH0Cprime.Nonempty :=
    ⟨muQu, hActiveSub hmuQu⟩
  have hDade : Section9.dadeIsometryRelativeToASet M U τ :=
    theorem_11_dade_ASet_of_hypothesis
      M MF H U C H0 W1 W2 S τ p q h11
  have h95 :
      Section9.Hypothesis_9_5 M MF U W1 W2 H0 C Cprime τ SH0 :=
    theorem_11_hypothesis_9_5_of_dade_kernel_family_bridge
      M MF H U C H0 W1 W2 S SH0 τ p q h11 hDade hSH0
  have h52prime : Section5.hypothesis_5_2_statement SH0Cprime τ :=
    theorem_11_hypothesis_5_2_of_kernel_family_of_hypothesis
      M MF H U C H0 W1 W2 (H0 ⊔ Cprime) S SH0Cprime τ p q
      h11 hSH0Cprime hPrimeNonempty
  have hcaseW1 :
      Section9.case_9_7_a_data M MF U W1 W2 H0 C p (Nat.card W1) a := by
    simpa [hqW1] using hcase
  have hcharW1 :
      Section9.case_9_7_a_characterData M MF U H0 C Uprime p
        (Nat.card W1) a u SH0 SH0C SH0U := by
    simpa [hqW1] using hchar
  have hUprimeComm : Uprime = (_root_.commutator U).map U.subtype := by
    have hCeq : C = ambientDerivedSubgroup U :=
      (theorem_11_6 M MF H U C H0 W1 W2 S τ p q h11).2.2.2
    calc
      Uprime = C := hUprimeC
      _ = ambientDerivedSubgroup U := hCeq
      _ = (_root_.commutator U).map U.subtype := by
        rw [Subgroup.map_subtype_commutator,
          ← section12_ambientDerivedSubgroup_eq_commutator]
  have hPrimeCoherent : Section6.coherentFamily SH0Cprime τ := by
    simpa [Section9.coherentFamilyForT] using
      (Section9.theorem_9_11_case_a_coherence_source_core
        M MF U W1 W2 H0 C Cprime τ SH0 SH0Cprime SH0 SH0C SH0U
        p a u Uprime h95 hSH0Cprime h52prime hcaseW1 hUprimeComm
        hSH0 hSH0C hSH0U hcharW1)
  have h52active : Section5.hypothesis_5_2_statement SH0C τ :=
    theorem_11_hypothesis_5_2_of_kernel_family_of_hypothesis
      M MF H U C H0 W1 W2 (H0 ⊔ C) S SH0C τ p q
