/-- The non-base column sum has degree `d |W₁|` from the uniform `(10.3)` data. -/
private theorem theorem_11_8_1_degree_muColumn_of_uniform
    {G : Type u}
    [Group G]
    [Finite G]
    {I J : Type*}
    [Fintype I]
    [Fintype J]
    {M W1 W2 : Subgroup G}
