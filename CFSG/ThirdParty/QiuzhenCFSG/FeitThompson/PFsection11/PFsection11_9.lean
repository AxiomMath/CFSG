/-- Source oddness input for the quotient `HC/M''`, inherited from oddness of
the ambient subgroup `M` in the PF `(11.2)` data. -/
private theorem theorem_11_5_fixedPointFree_index_odd
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
    (S : Finset (Section1.ClassFunction M))
    (τ : Section1.ClassFunction M →ₗ[ℂ] Section1.ClassFunction G)
    (p q : ℕ) :
    hypothesis_11_2_data M MF H U C H0 W1 W2 S τ p q →
      (ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C) ≠ 1 →
        Odd ((ambientDerivedSubgroup (ambientDerivedSubgroup M)).relIndex (H ⊔ C)) := by
  intro h11 _hne
  let DD : Subgroup G := ambientDerivedSubgroup (ambientDerivedSubgroup M)
  let HC : Subgroup G := H ⊔ C
  have hModd : Odd (Nat.card M) := by
    rcases h11 with
      ⟨_h10, _hHMF, _htype, _hHleD, _hUleD, _hCeq, _hH0H, _hH0normM,
        _hp, _hquot, _hchief, _hcomm, _hpW2, _hqW1, _hPDef, hOddAnd92⟩
    exact hOddAnd92.1
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hCM : C ≤ M :=
    theorem_11_3_C_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHCM : HC ≤ M := by
    dsimp [HC]
    exact sup_le hHM hCM
  have hHCodd : Odd (Nat.card HC) :=
    odd_of_card_dvd hModd (Subgroup.card_dvd_of_le hHCM)
  have hquotOdd : Odd (Nat.card (HC ⧸ DD.subgroupOf HC)) :=
    odd_of_card_dvd hHCodd (Subgroup.card_quotient_dvd_card (s := DD.subgroupOf HC))
  have hcard : Nat.card (HC ⧸ DD.subgroupOf HC) = DD.relIndex HC := by
    dsimp [DD, HC]
    exact theorem_11_5_secondDerived_HC_quotient_card_eq_relIndex M H C
  rw [hcard] at hquotOdd
  exact hquotOdd

/-- The remaining group-action output needed for the lower-bound step: when
`HC/M''` is nontrivial, its order is odd and congruent to `1` modulo `q`.

The proof must use the fixed-point-free action of `W₁` on `HC/M''` coming from
PF `(8.4.d)`, together with the odd-order source data for this quotient. -/
private theorem theorem_11_5_fixedPointFree_index_odd_and_dvd
    {G : Type u}
    [Group G]
    [Finite G]
    (M MF H U C H0 W1 W2 : Subgroup G)
