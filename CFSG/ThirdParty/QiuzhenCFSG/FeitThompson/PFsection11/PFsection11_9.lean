  let SH0C : Finset (Section1.ClassFunction M) :=
    S.filter fun χ => Section1.subgroupInKernel' χ ((H0 ⊔ C).subgroupOf M)
  have hH0H : H0 ≤ H :=
    theorem_11_3_H0_le_H_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hHM : H ≤ M :=
    theorem_11_3_H_le_M_of_hypothesis M MF H U C H0 W1 W2 S τ p q h11
  have hCM : C ≤ M :=
