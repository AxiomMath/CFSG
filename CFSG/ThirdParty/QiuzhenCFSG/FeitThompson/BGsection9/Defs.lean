open scoped Pointwise

/-!
# Statements from BG Section 9

This file formalizes the Section 9 results from `docs/section9.tex`, with the
remaining endpoint proofs decomposed into named helper lemmas.
-/

section Notation

variable {G : Type*} [Group G]

/-- The set `M` of all maximal proper subgroups of `G`. -/
@[expose] public def CFSG.section9MaximalSubgroups (G : Type*) [Group G] :
    Set (Subgroup G) :=
  {M | IsCoatom M}

/-- The set `M(H)` of maximal subgroups of `G` containing `H`. -/
@[expose] public def CFSG.section9MaximalSubgroupsContaining (H : Subgroup G) :
    Set (Subgroup G) :=
  {M | M ∈ section9MaximalSubgroups G ∧ H ≤ M}

/-- A subgroup has a unique maximal overgroup in `G`. -/
@[expose] public def CFSG.section9HasUniqueMaximalOver (H : Subgroup G) : Prop :=
  ∃ M : Subgroup G, section9MaximalSubgroupsContaining H = {M}

/-- The set `U` of proper subgroups having a unique maximal overgroup. -/
@[expose] public def CFSG.section9UniqueSubgroups (G : Type*) [Group G] :
    Set (Subgroup G) :=
  {H | H ≠ ⊤ ∧ section9HasUniqueMaximalOver H}

/-- Elementary abelian `p`-subgroups of the subgroup `H`. -/
@[expose] public def CFSG.section9ElementaryAbelianPSubgroupsIn
    (p : ℕ) (H : Subgroup G) : Set (Subgroup G) :=
  {A | A ≤ H ∧ IsElementaryAbelian p A}


/-- The set of primes other than `p`. -/
@[expose] public def CFSG.section9PPrimeSet (p : ℕ) [Fact p.Prime] :
    Set Nat.Primes :=
  ({⟨p, Fact.out⟩} : Set Nat.Primes)ᶜ

/-- The family `H_H(A;p')` of `p'`-subgroups of `H` normalized by `A`. -/
@[expose] public def CFSG.section9PPrimeFamily
    (H A : Subgroup G) (p : ℕ) [Fact p.Prime] : Set (Subgroup G) :=
  section7HFamily H A (section9PPrimeSet p)


/-- The subgroup generated by `H_H(A;p')`. -/
@[expose] public def CFSG.section9GeneratedPPrimeFamily
    (H A : Subgroup G) (p : ℕ) [Fact p.Prime] : Subgroup G :=
  section7Generated H A (section9PPrimeSet p)

/-- Rank-two elementary abelian subgroups that are not maximal elementary abelian subgroups. -/
@[expose] public def CFSG.section9RankTwoNonmaximalElementaryAbelian
    (A : Subgroup G) : Prop :=
  ∃ p : ℕ, p.Prime ∧
    A ∈ elementaryAbelianSubgroupsOfRank p 2 G ∧
      A ∉ maximalElementaryAbelianSubgroups p G

end Notation

section Section9

variable {G : Type*} [Group G] [Finite G] [IsMinCE G]

public theorem CFSG.section9_solvable_of_proper_subgroup {H : Subgroup G} (hHproper : H ≠ ⊤) :
    IsSolvable H :=
  IsMinCE.proper_subgroups_solvable H (lt_top_iff_ne_top.2 hHproper)

omit [IsMinCE G] in
/-- If `Y <= X < G` and `Y` lies in `U`, then `X` lies in `U`. -/
public theorem CFSG.section9_unique_of_le
    {Y X : Subgroup G} (hYX : Y ≤ X) (hXproper : X ≠ ⊤)
    (hY : Y ∈ section9UniqueSubgroups G) :
    X ∈ section9UniqueSubgroups G := by
  classical
  rcases hY with ⟨_hYproper, M, hMuniq⟩
  rcases (eq_top_or_exists_le_coatom X) with hXtop | ⟨N, hNcoatom, hXN⟩
  · exact False.elim (hXproper hXtop)
  have hNmax : N ∈ section9MaximalSubgroups G := hNcoatom
  have hNcontY : N ∈ section9MaximalSubgroupsContaining Y := ⟨hNmax, hYX.trans hXN⟩
  have hN_eq_M : N = M := by
    have hNsingle : N ∈ ({M} : Set (Subgroup G)) := by
      simpa [hMuniq] using hNcontY
    simpa using hNsingle
  have hMcontY : M ∈ section9MaximalSubgroupsContaining Y := by
    rw [hMuniq]
    simp
  have hXM : X ≤ M := by
    simpa [hN_eq_M] using hXN
  refine ⟨hXproper, M, ?_⟩
  ext N'
  constructor
  · intro hN'
    have hN'Y : N' ∈ section9MaximalSubgroupsContaining Y := ⟨hN'.1, hYX.trans hN'.2⟩
    have hN'M : N' = M := by
      have hN'single : N' ∈ ({M} : Set (Subgroup G)) := by
        simpa [hMuniq] using hN'Y
      simpa using hN'single
    simp [hN'M]
  · intro hN'
    have hN'M : N' = M := by
      simpa using hN'
    subst N'
    exact ⟨hMcontY.1, hXM⟩

omit [IsMinCE G] in
public theorem CFSG.section9_not_unique_of_le
    {Y X : Subgroup G} (hYX : Y ≤ X) (hXproper : X ≠ ⊤)
    (hXnot : X ∉ section9UniqueSubgroups G) :
    Y ∉ section9UniqueSubgroups G := by
  intro hY
  exact hXnot (section9_unique_of_le hYX hXproper hY)

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_proper_of_le_maximal
    {H M : Subgroup G} (hHM : H ≤ M) (hM : M ∈ section9MaximalSubgroups G) :
    H ≠ ⊤ := by
  intro hHtop
  have htop_le_M : (⊤ : Subgroup G) ≤ M := by
    simpa [hHtop] using hHM
  exact hM.ne_top (top_le_iff.mp htop_le_M)

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_unique_of_forall_maximal_overgroup_eq
    {H M : Subgroup G} (hM : M ∈ section9MaximalSubgroups G) (hHM : H ≤ M)
    (huniq : ∀ N : Subgroup G, N ∈ section9MaximalSubgroupsContaining H → N = M) :
    H ∈ section9UniqueSubgroups G := by
  classical
  refine ⟨section9_proper_of_le_maximal hHM hM, M, ?_⟩
  ext N
  constructor
  · intro hN
    have hNM : N = M := huniq N hN
    simp [hNM]
  · intro hN
    have hNM : N = M := by
      simpa using hN
    subst N
    exact ⟨hM, hHM⟩

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_unique_overgroups_eq_of_contains_maximal
    {H M : Subgroup G} (hH : H ∈ section9UniqueSubgroups G)
    (hM : M ∈ section9MaximalSubgroups G) (hHM : H ≤ M) :
    section9MaximalSubgroupsContaining H = {M} := by
  classical
  rcases hH with ⟨_hHproper, N, hNuniq⟩
  have hMcont : M ∈ section9MaximalSubgroupsContaining H := ⟨hM, hHM⟩
  have hMN : M = N := by
    have hsingle : M ∈ ({N} : Set (Subgroup G)) := by
      simpa [hNuniq] using hMcont
    simpa using hsingle
  simpa [hMN] using hNuniq

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_not_unique_of_le_two_distinct_maximal
    {L M N : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G) (hN : N ∈ section9MaximalSubgroups G)
    (hLM : L ≤ M) (hLN : L ≤ N) (hNM : N ≠ M) :
    L ∉ section9UniqueSubgroups G := by
  classical
  intro hL
  rcases hL with ⟨_hLproper, U, hUuniq⟩
  have hMcont : M ∈ section9MaximalSubgroupsContaining L := ⟨hM, hLM⟩
  have hNcont : N ∈ section9MaximalSubgroupsContaining L := ⟨hN, hLN⟩
  have hMU : M = U := by
    have hsingle : M ∈ ({U} : Set (Subgroup G)) := by
      simpa [hUuniq] using hMcont
    simpa using hsingle
  have hNU : N = U := by
    have hsingle : N ∈ ({U} : Set (Subgroup G)) := by
      simpa [hUuniq] using hNcont
    simpa using hsingle
  exact hNM (hNU.trans hMU.symm)

omit [IsMinCE G] in
public theorem CFSG.section9_exists_maximalSubgroupsContaining_of_ne_top
    {H : Subgroup G} (hHproper : H ≠ ⊤) :
    ∃ M : Subgroup G, M ∈ section9MaximalSubgroupsContaining H := by
  rcases eq_top_or_exists_le_coatom H with hHtop | ⟨M, hMcoatom, hHM⟩
  · exact False.elim (hHproper hHtop)
  · refine ⟨M, ?_⟩
    exact ⟨hMcoatom, hHM⟩

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_exists_maximal_overgroup_ne_of_not_unique
    {H M : Subgroup G} (hM : M ∈ section9MaximalSubgroups G) (hHM : H ≤ M)
    (hHnot : H ∉ section9UniqueSubgroups G) :
    ∃ N : Subgroup G, N ∈ section9MaximalSubgroupsContaining H ∧ N ≠ M := by
  classical
  by_contra hno
  apply hHnot
  exact
    section9_unique_of_forall_maximal_overgroup_eq hM hHM <| by
      intro N hN
      by_contra hNM
      exact hno ⟨N, hN, hNM⟩


omit [IsMinCE G] in
public noncomputable def CFSG.section9SylowCardInf
    (p : ℕ) [Fact p.Prime] (H M : Subgroup G) : ℕ :=
  Nat.card
    (((Classical.choice (inferInstance : Nonempty (Sylow p ↥(H ⊓ M)))) :
      Sylow p ↥(H ⊓ M)) : Subgroup ↥(H ⊓ M))

omit [IsMinCE G] in
public theorem CFSG.section9SylowCardInf_eq_card_sylow
    {p : ℕ} [Fact p.Prime] (H M : Subgroup G) (S : Sylow p ↥(H ⊓ M)) :
    section9SylowCardInf p H M = Nat.card (S : Subgroup ↥(H ⊓ M)) := by
  rw [section9SylowCardInf]
  rw [Sylow.card_eq_multiplicity, Sylow.card_eq_multiplicity]

omit [IsMinCE G] in
public theorem CFSG.section9_factorization_le_of_sylowCardInf_le
    {p : ℕ} [Fact p.Prime] {K H M : Subgroup G}
    (hle : section9SylowCardInf p K M ≤ section9SylowCardInf p H M) :
    Nat.factorization (Nat.card (K ⊓ M : Subgroup G)) p ≤
      Nat.factorization (Nat.card (H ⊓ M : Subgroup G)) p := by
  rw [section9SylowCardInf, section9SylowCardInf] at hle
  rw [Sylow.card_eq_multiplicity, Sylow.card_eq_multiplicity] at hle
  exact (Nat.pow_le_pow_iff_right (Nat.Prime.one_lt (Fact.out : Nat.Prime p))).1 hle

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_card_map_subtype_eq
    (H : Subgroup G) (K : Subgroup H) :
    Nat.card (K.map H.subtype) = Nat.card K :=
  Subgroup.card_map_of_injective (K := K) (f := H.subtype) H.subtype_injective

omit [IsMinCE G] in
public theorem CFSG.section9SylowCardInf_eq_card_sylow_map
    {p : ℕ} [Fact p.Prime] (H M : Subgroup G) (S : Sylow p ↥(H ⊓ M)) :
    section9SylowCardInf p H M =
      Nat.card ((S : Subgroup ↥(H ⊓ M)).map (H ⊓ M).subtype) := by
  rw [section9SylowCardInf_eq_card_sylow H M S]
  rw [section9_card_map_subtype_eq]

omit [IsMinCE G] in
public theorem CFSG.section9_exists_maximal_pSylowCard_inf_overgroup_ne_of_not_unique
    {p : ℕ} [Fact p.Prime] {H M : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G) (hHM : H ≤ M)
    (hHnot : H ∉ section9UniqueSubgroups G) :
    ∃ N : Subgroup G,
      N ∈ section9MaximalSubgroupsContaining H ∧ N ≠ M ∧
        ∀ K : Subgroup G, K ∈ section9MaximalSubgroupsContaining H → K ≠ M →
          section9SylowCardInf p K M ≤ section9SylowCardInf p N M := by
  classical
  let s : Set (Subgroup G) :=
    {N | N ∈ section9MaximalSubgroupsContaining H ∧ N ≠ M}
  have hsne : s.Nonempty := by
    rcases section9_exists_maximal_overgroup_ne_of_not_unique hM hHM hHnot with ⟨N, hN, hNM⟩
    exact ⟨N, hN, hNM⟩
  have hsfin : s.Finite := Set.toFinite s
  obtain ⟨N, hNmax⟩ :=
    hsfin.exists_maximalFor (fun K : Subgroup G => section9SylowCardInf p K M) s hsne
  refine ⟨N, hNmax.1.1, hNmax.1.2, ?_⟩
  intro K hK hKM
  exact hNmax.le ⟨hK, hKM⟩

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_maximal_of_section8_maximal {M : Subgroup G}
    (hM : M ∈ section8MaximalSubgroups G) :
    M ∈ section9MaximalSubgroups G := hM

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section8_maximal_of_section9_maximal {M : Subgroup G}
    (hM : M ∈ section9MaximalSubgroups G) :
    M ∈ section8MaximalSubgroups G := hM

omit [Finite G] [IsMinCE G] in
public theorem CFSG.section9_unique_of_section8_unique {H : Subgroup G}
    (hH : H ∈ section8UniqueSubgroups G) :
    H ∈ section9UniqueSubgroups G := by
  classical
  rcases hH with ⟨hHproper, M, hMuniq⟩
  refine ⟨hHproper, M, ?_⟩
  ext N
  constructor
  · intro hN
    have hN8 : N ∈ section8MaximalSubgroupsContaining H :=
      ⟨section8_maximal_of_section9_maximal hN.1, hN.2⟩
    have hNsingle : N ∈ ({M} : Set (Subgroup G)) := by
      simpa [hMuniq] using hN8
    simpa using hNsingle
  · intro hN
    have hNM : N = M := by
      simpa using hN
    subst N
    have hM8 : M ∈ section8MaximalSubgroupsContaining H := by
      rw [hMuniq]
      simp
    exact ⟨section9_maximal_of_section8_maximal hM8.1, hM8.2⟩

end Section9
