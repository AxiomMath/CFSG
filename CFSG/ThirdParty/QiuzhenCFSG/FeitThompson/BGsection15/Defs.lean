module

public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.BGsection14.lemma_14_13
import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.PCore.CentralizerControl
import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.HallSubgroups.Conjugacy
import Mathlib.Algebra.Group.Subgroup.Order
import Mathlib.GroupTheory.Schreier

namespace CFSG
end CFSG
open CFSG

open scoped Pointwise

/-!
# Definitions from BG Section 15

This file records a statement-only scaffold for Section 15 of
`Local Analysis for the Odd Order Theorem`.
-/

section Notation

variable {G : Type*} [Group G] [Finite G]

/-- `H` is a Hall subgroup of `K`, with the set of primes inferred from `H`. -/
@[expose] public def CFSG.section15HallSubgroupOf
    (H K : Subgroup G) : Prop :=
  ∃ _hHK : H ≤ K, IsHallSubgroup (subgroupPrimeSet H) (H.subgroupOf K)

/-- A nilpotent normal Hall subgroup of `M`, viewed in the ambient group. -/
@[expose] public def CFSG.section15NilpotentNormalHallIn
    (H M : Subgroup G) : Prop :=
  ∃ _hHM : H ≤ M, (H.subgroupOf M).Normal ∧ Group.IsNilpotent H ∧
    IsHallSubgroup (subgroupPrimeSet H) (H.subgroupOf M)

/-- `MF` is the subgroup `M_F`: the largest nilpotent normal Hall subgroup of `M`. -/
@[expose] public def CFSG.section15MFSubgroup
    (M MF : Subgroup G) : Prop :=
  section15NilpotentNormalHallIn MF M ∧
    ∀ H : Subgroup G, section15NilpotentNormalHallIn H M → H ≤ MF

/-- The fixed Section 15 notation for `K` and `U`:
`K` is a Hall `κ(M)`-subgroup of `M`, `K` is complemented by `U M_σ`,
`K U` complements `M_σ` in `M`, and the fixed complement satisfies the
context used by Lemma 15.1.  The source statement that `U` complements
`K M_σ` is derived from these fixed-product facts when needed.  This is
deliberately weaker than the full
Proposition 14.2(a) package, which is only available when `κ(M)` is nonempty. -/
@[expose] public def CFSG.section15KUData
    (M K U : Subgroup G) : Prop :=
  section12HallSubgroupIn (section14KappaPrimes M) K M ∧
    section12ComplementIn M K (U ⊔ section10Msigma M) ∧
      section12ComplementIn M (section10Msigma M) (K ⊔ U) ∧
        section12HallSubgroupIn
          ((section14KappaPrimes M ∪ section10SigmaPrimes M)ᶜ) U M ∧
          section14ActsRegularlyOn K U ∧
            section10NormalIn (U ⊔ section10Msigma M) M ∧
              section10NormalIn U (K ⊔ U)

/-- The second derived subgroup `M''`, viewed in the ambient group. -/
@[expose] public def CFSG.section15SecondDerivedSubgroup
    (M : Subgroup G) : Subgroup G :=
  ambientDerivedSubgroup (ambientDerivedSubgroup M)

/-- The subgroup generated by all `C_U(x)` with `x ∈ M_σ#`. -/
@[expose] public def CFSG.section15GeneratedMsigmaCentralizers
    (M U : Subgroup G) : Subgroup G :=
  Subgroup.closure
    {u : G | ∃ x : G, x ∈ section10Msigma M ∧ x ≠ 1 ∧
      u ∈ elementCentralizerIn U x}

/-- The `σ(M)'`-core of the Fitting subgroup, `O_{σ(M)'}(F(M))`. -/
@[expose] public def CFSG.section15SigmaComplementFittingCore
    (M : Subgroup G) : Subgroup G :=
  piCoreIn (section10SigmaPrimes M)ᶜ (section8FittingSubgroup M)

/-- The ambient `p`-core of a subgroup. -/
@[expose] public def CFSG.section15PCoreIn
    (p : Nat.Primes) (H : Subgroup G) : Subgroup G := by
  letI : Fact p.val.Prime := ⟨p.property⟩
  exact (pCore p.val H).map H.subtype

/-- Two elements are conjugate by an element of a specified subgroup. -/
@[expose] public def CFSG.section15ConjugateInSubgroup
    (H : Subgroup G) (x y : G) : Prop :=
  ∃ h : G, h ∈ H ∧ y = h * x * h⁻¹

/-- The quotient `H/K` is abelian. -/
@[expose] public def CFSG.section15QuotientAbelian
    (H K : Subgroup G) : Prop :=
  ∃ _hKH : K ≤ H, ∃ _hNorm : (K.subgroupOf H).Normal,
    IsMulCommutative (H ⧸ K.subgroupOf H)

/-- The quotient `H/K` is isomorphic to the ambient subgroup `L`. -/
@[expose] public def CFSG.section15QuotientMulEquiv
    (H K L : Subgroup G) : Prop :=
  ∃ _hKH : K ≤ H, ∃ _hNorm : (K.subgroupOf H).Normal,
    Nonempty (H ⧸ K.subgroupOf H ≃* L)

/-- The exponent of `M/H` divides a specified natural number. -/
@[expose] public def CFSG.section15QuotientExponentDvd
    (H M : Subgroup G) (n : ℕ) : Prop :=
  ∃ _hHM : H ≤ M, ∃ _hNorm : (H.subgroupOf M).Normal,
    Monoid.exponent (M ⧸ H.subgroupOf M) ∣ n

/-- The order of `M/H` divides a specified natural number. -/
@[expose] public def CFSG.section15QuotientCardDvd
    (H M : Subgroup G) (n : ℕ) : Prop :=
  ∃ _hHM : H ≤ M, ∃ _hNorm : (H.subgroupOf M).Normal,
    Nat.card (M ⧸ H.subgroupOf M) ∣ n


/-- `C` is the pullback to `H` of the centralizer of the image of `A` in
`H/N`, viewed as an ambient subgroup of `G`. -/
@[expose] public def CFSG.section15QuotientCentralizerEquals
    (C H A N : Subgroup G) : Prop :=
  ∃ _hNH : N ≤ H, ∃ _hAH : A ≤ H, ∃ _hNorm : (N.subgroupOf H).Normal,
    C =
      ((Subgroup.centralizer
        (((A.subgroupOf H).map (QuotientGroup.mk' (N.subgroupOf H))) :
          Set (H ⧸ N.subgroupOf H))).comap
            (QuotientGroup.mk' (N.subgroupOf H))).map H.subtype

/-- The full chain of equalities and containments in Theorem 15.2(g). -/
@[expose] public def CFSG.section15Theorem15_2GConclusions
    (M K Q D : Subgroup G) : Prop :=
  let Q₀ := subgroupCentralizerIn Q D
  section15SecondDerivedSubgroup M =
      ambientDerivedSubgroup (section10Msigma M) ∧
    section15SecondDerivedSubgroup M ≤ section8FittingSubgroup M ∧
      section8FittingSubgroup M = Q ⊔ subgroupCentralizerIn M Q ∧
        section15QuotientCentralizerEquals
          (section8FittingSubgroup M) M Q Q₀ ∧
          section15QuotientCentralizerEquals
            (section8FittingSubgroup M) (section10Msigma M)
              (section14KStar M K) Q₀ ∧
            section8FittingSubgroup M < section10Msigma M ∧
              section10Msigma M = ambientDerivedSubgroup M

/-- The complement `D` of `Q` chosen in the proof of Theorem 15.2. -/
@[expose] public def CFSG.section15Theorem15_2ComplementData
    (M K Q D : Subgroup G) : Prop :=
  section10Msigma M = ambientDerivedSubgroup M ∧
    section12ComplementIn (section10Msigma M) Q D ∧
      Group.IsNilpotent D ∧ K ≤ Subgroup.normalizer (D : Set G)

/-- The three alternatives in Theorem 15.7(e). -/
@[expose] public def CFSG.section15Theorem15_7Alternatives
    (M H X : Subgroup G) : Prop :=
  (M ∈ section14MFamilyF G ∧ IsMulCommutative H ∧ groupRank H = 2) ∨
    (∃ p : Nat.Primes,
      p.val = Nat.card X ∧ p ∈ section10SigmaPrimes M \ section10BetaPrimes M ∧
        ¬ IsMulCommutative (section15PCoreIn p H) ∧
          IsCyclic (section10PPrimeCore p H) ∧
            ∀ q : Nat.Primes, q ∈ subgroupPrimeSet H →
              section15QuotientExponentDvd H M (q.val - 1)) ∨
      ∃ p : Nat.Primes,
        p.val = Nat.card X ∧ p ∈ section10SigmaPrimes M \ section10BetaPrimes M ∧
          IsCyclic (section10PPrimeCore p H) ∧
            Nat.card (section15PCoreIn p H) = p.val ^ 3 ∧
              ¬ IsMulCommutative (section15PCoreIn p H) ∧
                M ∈ section14MFamilyP1 G ∧
                  section15QuotientCardDvd H M (p.val + 1)

/-- The hypotheses denoted by "the situation of Corollary 14.12" in
Theorem 15.8. -/
@[expose] public def CFSG.section15Corollary14_12Situation
    (M H K Mstar U : Subgroup G) : Prop :=
  M ∈ section14MFamilyP2 G ∧
    section12HallSubgroupIn (section14KappaPrimes M) K M ∧
      section14Theorem14_7Data M K Mstar ∧
        section14Proposition14_2AData M K U ∧
          ∃ r : Nat.Primes, ∃ R : Sylow r.val U,
            r ∈ subgroupPrimeSet U ∧
              H ∈ section9MaximalSubgroupsContaining
                (Subgroup.normalizer (section10AmbientSylowSubgroup U R : Set G))

/-- The bundled conclusions of Corollary 15.9 for the suitable complement `E`. -/
@[expose] public def CFSG.section15Corollary15_9Conclusions
    (M N E : Subgroup G) (r : Nat.Primes) (xᵣ : G) : Prop :=
  section12ComplementToMsigma M E ∧
    M ∈ section14MFamilyF G ∧
      N ∈ section14MFamilyP2 G ∧
        IsCyclic E ∧
          (∃ K : Subgroup G, section14FrobeniusWithKernel M K) ∧
            r ∈ section12Tau2Primes N ∧
              subgroupNormalizerIn E (Subgroup.zpowers xᵣ : Set G) ≤ E ⊓ N ∧
                Nat.card (E ⊓ N : Subgroup G) = (ambientDerivedSubgroup N).relIndex N

end Notation
