module

public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.Gorenstein.Chapter8_2
public import Mathlib.GroupTheory.PGroup
public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.GroupAction.ConjAct
public import Mathlib.Data.Set.Finite.Lemmas

namespace CFSG
end CFSG
open CFSG

/-!
# Glauberman, "A Characteristic Subgroup of a p-Stable Group" — §3, Theorem 3.1 and Corollary 3.1

Statements and proofs of Theorem 3.1 (the Thompson Replacement Theorem) and Corollary 3.1 of
George Glauberman, *A Characteristic Subgroup of a p-Stable Group*, Canadian Journal of
Mathematics 20 (1968), 1101–1135 — reference [6] of the dihedral-Sylow project — following
the validated transcription in `refs/glauberman-p-stable.tex` (Theorem 3.1 at L421–L436 and
its proof at L452–L528; Corollary 3.1 at L440–L451).

The statement uses Gorenstein's `A(S)` (`thompsonAbelianSubgroups S`: the Abelian subgroups
of `S` of maximal order) from `FeitThompson/Gorenstein/Chapter8_2.lean`.  That module keeps
its replacement machinery (`thompsonReplacement_base`, `thompsonAbelianSubgroups_centralizer_eq`,
`subgroupCentralizerIn'`) private, so this file carries verbatim local copies of those three
declarations (marked `public` for reuse by later files in the Glauberman dependency DAG) and
proves the paper's Lemmas 3.1 and 3.3 locally.

The paper's commutator convention is `[x,y] = x⁻¹y⁻¹xy`; Mathlib's `⁅x,y⁆` is
`x·y·x⁻¹·y⁻¹`.  The two conventions generate the same commutator *subgroups*, so all
subgroup-level statements here are convention-independent.
-/

open scoped Pointwise commutatorElement

namespace CFSG.Glauberman

variable {G : Type*} [Group G]

/-- The centralizer of `H` inside the ambient subgroup `U`, the paper's `C_U(H)`.
Verbatim local copy of the (private) `subgroupCentralizerIn'` of
`FeitThompson/Gorenstein/Chapter8_2.lean`. -/
@[expose]
public def subgroupCentralizerIn' (U H : Subgroup G) : Subgroup G :=
  Subgroup.centralizer (H : Set G) ⊓ U

/-- `C_S(A) = A` whenever `A ∈ A(S)`.  Verbatim local copy of the (private)
`thompsonAbelianSubgroups_centralizer_eq` of `FeitThompson/Gorenstein/Chapter8_2.lean`
(which is proved under the ambient `[Finite G]`). -/
public theorem thompsonAbelianSubgroups_centralizer_eq
    {P A : Subgroup G} [Finite G] (hA : A ∈ thompsonAbelianSubgroups (G := G) P) :
    subgroupCentralizerIn' P A = A := by
  apply le_antisymm
  · intro x hx
    let B : Subgroup G := Subgroup.closure ((A : Set G) ∪ {x})
    have hB_le_P : B ≤ P := by
      refine (Subgroup.closure_le (K := P)).2 ?_
      intro y hy
      rcases hy with hyA | rfl
      · exact hA.1 hyA
      · exact hx.2
    have hB_comm : IsMulCommutative B := by
      change IsMulCommutative (Subgroup.closure ((A : Set G) ∪ {x}))
      let : IsMulCommutative A := hA.2.1
      exact Subgroup.isMulCommutative_closure (k := ((A : Set G) ∪ {x})) <| Set.Pairwise.of_forall₂ <| by
        intro y hy z hz
        show y * z = z * y
        rcases hy with hyA | rfl
        · rcases hz with hzA | rfl
          · exact setLike_mul_comm (s := A) hyA hzA
          · exact Subgroup.mem_centralizer_iff.mp hx.1 _ hyA
        · rcases hz with hzA | rfl
          · exact (Subgroup.mem_centralizer_iff.mp hx.1 _ hzA).symm
          · simp
    have hB_card_le : Nat.card B ≤ Nat.card A := hA.2.2 B hB_le_P hB_comm
    have hA_le_B : A ≤ B := by
      intro y hy
      exact Subgroup.subset_closure (Or.inl hy)
    have hB_eq_A : A = B := Subgroup.eq_of_le_of_card_ge hA_le_B hB_card_le
    have hxB : x ∈ B := Subgroup.subset_closure (Or.inr (by simp))
    rw [← hB_eq_A] at hxB
    exact hxB
  · intro x hx
    refine ⟨?_, hA.1 hx⟩
    exact ((Subgroup.le_centralizer_iff_isMulCommutative (K := A)).2 hA.2.1) hx

/-- Lemma 3.1 ([6], §3, p. 1106; `refs/glauberman-p-stable.tex` L384–L389): for `x ∈ G`
and a subgroup `H ≤ G`, `x ∈ N_G(H)` iff `[x,H] ⊆ H`, where `[x,H]` is the subgroup
generated by the commutators `⁅x,h⁆` for `h ∈ H`.  The reverse direction needs `H` finite
(the paper considers only finite groups). -/
public lemma lemma3_1 {x : G} {H : Subgroup G} [Finite ↥H] :
    x ∈ Subgroup.normalizer (H : Set G) ↔
      (Subgroup.closure {g : G | ∃ h : G, h ∈ H ∧ ⁅x, h⁆ = g} : Subgroup G) ≤ H := by
  constructor
  · intro hx
    rw [Subgroup.closure_le]
    intro g hg
    rcases hg with ⟨h, hh, rfl⟩
    have h1 : x * h * x⁻¹ ∈ H := (Subgroup.mem_normalizer_iff.mp hx h).1 hh
    exact H.mul_mem h1 (H.inv_mem hh)
  · intro hM
    have hxsub : ∀ h : G, h ∈ H → x * h * x⁻¹ ∈ H := by
      intro h hh
      have hxh : ⁅x, h⁆ ∈ H := hM (Subgroup.subset_closure ⟨h, hh, rfl⟩)
      have h_eq : x * h * x⁻¹ = ⁅x, h⁆ * h := by
        simp [commutatorElement_def, mul_assoc]
      rw [h_eq]
      exact H.mul_mem hxh hh
    have hmap_le : H.map (MulAut.conj x : G →* G) ≤ H := by
      intro y hy
      rcases hy with ⟨h, hh, rfl⟩
      simpa [MulAut.conj_apply] using hxsub h hh
    have hcard : Nat.card (H.map (MulAut.conj x : G →* G)) = Nat.card H :=
      Subgroup.card_map_of_injective (f := (MulAut.conj x : G →* G)) (MulAut.conj x).injective
    have hmap : H.map (MulAut.conj x : G →* G) = H :=
      Subgroup.eq_of_le_of_card_ge (H := H.map (MulAut.conj x : G →* G)) (K := H)
        hmap_le hcard.symm.le
    exact (Subgroup.mem_normalizer_iff_map_conj_eq (g := x)).2 hmap

/-- Lemma 3.3 ([6], §3, p. 1106; `refs/glauberman-p-stable.tex` L400–L405): a non-identity
normal subgroup of a finite `p`-group meets the centre. -/
public lemma lemma3_3 {p : ℕ} [Fact p.Prime] [Finite G] (hGp : IsPGroup p G)
    {H : Subgroup G} [hH : H.Normal] (hHne : H ≠ ⊥) :
    ∃ z : G, z ∈ H ∧ z ∈ Subgroup.center G ∧ z ≠ 1 := by
  classical
  have hHp : IsPGroup p H := hGp.to_subgroup H
  have hHnt : Nontrivial H := (H.nontrivial_iff_ne_bot).2 hHne
  have hcard : p ∣ Nat.card H := by
    obtain ⟨n, hn0, hn⟩ := (hHp.nontrivial_iff_card).mp hHnt
    exact hn.symm ▸ dvd_pow_self p (ne_of_gt hn0)
  let : MulAction (ConjAct G) H := inferInstance
  have h1fp : (1 : H) ∈ MulAction.fixedPoints (ConjAct G) H := by
    intro g
    exact MulDistribMulAction.smul_one g
  have hG' : IsPGroup p (ConjAct G) := hGp.of_equiv ConjAct.toConjAct
  obtain ⟨b, hb, hbne⟩ :=
    hG'.exists_fixed_point_of_prime_dvd_card_of_fixed_point (α := H) hcard h1fp
  refine ⟨(b : G), b.2, ?_, ?_⟩
  · rw [Subgroup.mem_center_iff]
    intro g
    have hg : (ConjAct.toConjAct g) • b = b :=
      (MulAction.mem_fixedPoints.mp hb) (ConjAct.toConjAct g)
    have hg' : g * (b : G) * g⁻¹ = (b : G) := by
      have hg1 : (ConjAct.toConjAct g) • (b : G) = (b : G) := by
        change ((ConjAct.toConjAct g) • b : H).1 = (b : H).1
        exact congrArg Subtype.val hg
      simpa [ConjAct.toConjAct_smul] using hg1
    exact (mul_inv_eq_iff_eq_mul.mp hg')
  · intro hz1
    exact hbne (Subtype.ext hz1.symm)
/-- Theorem 3.1(a) ([6], §3, Theorem 3.1(a), p. 1106; `refs/glauberman-p-stable.tex`
L421–L436): let `S` be a finite `p`-group and `A ∈ A(S)`.  If `x ∈ S` and `[x,A]` is
Abelian, then, with `M = [x,A]` and `C = C_A(M)`, one has `M ⊔ C_A(M) ∈ A(S)`.

This is the (private) `thompsonReplacement_base` of
`FeitThompson/Gorenstein/Chapter8_2.lean`, copied verbatim (that module does not export
it, and it is proved under the ambient `[Finite G]`); its `C` is exactly
`subgroupCentralizerIn' A M = C_A(M)`, so the statement already has the paper's
`MC_A(M)` shape. -/
public theorem theorem3_1a {P A : Subgroup G} [Finite G]
    (hA : A ∈ thompsonAbelianSubgroups (G := G) P)
    {x : G} (hxP : x ∈ P)
    (hM_comm :
      IsMulCommutative
        ((Subgroup.closure {g : G | ∃ u ∈ A, ⁅x, u⁆ = g} : Subgroup G))) :
    let M : Subgroup G := Subgroup.closure {g : G | ∃ u ∈ A, ⁅x, u⁆ = g}
    let C : Subgroup G := subgroupCentralizerIn' A M
    M ⊔ C ∈ thompsonAbelianSubgroups (G := G) P := by
  classical
  let M : Subgroup G := Subgroup.closure {g : G | ∃ u ∈ A, ⁅x, u⁆ = g}
  let C : Subgroup G := subgroupCentralizerIn' A M
  refine ⟨?_, ?_, ?_⟩
  · have hM_le_P : M ≤ P := by
      rw [Subgroup.closure_le]
      intro y hy
      rcases hy with ⟨u, hu, rfl⟩
      exact
        (Subgroup.commutator_le_self P)
          (Subgroup.commutator_mem_commutator hxP (hA.1 hu))
    exact sup_le hM_le_P (fun y hy => hA.1 hy.2)
  · rw [Subgroup.sup_eq_closure]
    let : IsMulCommutative A := hA.2.1
    exact Subgroup.isMulCommutative_closure
      (k := (((M : Subgroup G) : Set G) ∪ ((C : Subgroup G) : Set G))) <| Set.Pairwise.of_forall₂ <| by
        intro y hy z hz
        show y * z = z * y
        rcases hy with hyM | hyC
        · rcases hz with hzM | hzC
          · exact
              setLike_mul_comm
                (s := M) hyM hzM
          · exact Subgroup.mem_centralizer_iff.mp hzC.1 _ hyM
        · rcases hz with hzM | hzC
          · exact (Subgroup.mem_centralizer_iff.mp hyC.1 _ hzM).symm
          · exact
              setLike_mul_comm
                (s := A) hyC.2 hzC.2
  · intro B hB_le_P hB_comm
    have hB_card_le_A : Nat.card B ≤ Nat.card A := hA.2.2 B hB_le_P hB_comm
    have hA_card_le :
        Nat.card A ≤
          Nat.card ↥(M ⊔ C) := by
      let M0 : Subgroup G := M
      let C0 : Subgroup G := subgroupCentralizerIn' A M0
      have hM0_comm : IsMulCommutative ↥M0 := by
        simpa [M0] using hM_comm
      change Nat.card A ≤ Nat.card ↥(M0 ⊔ C0)
      have hC0_le_A : C0 ≤ A := by
        intro y hy
        exact hy.2
      let D0 : Subgroup G := subgroupCentralizerIn' M0 A
      have hM0_le_P : M0 ≤ P := by
        rw [Subgroup.closure_le]
        intro y hy
        rcases hy with ⟨u, hu, rfl⟩
        exact
          (Subgroup.commutator_le_self P)
            (Subgroup.commutator_mem_commutator hxP (hA.1 hu))
      have hD0_le_M0 : D0 ≤ M0 := by
        intro y hy
        exact hy.2
      have hcentP_eq_A : subgroupCentralizerIn' P A = A :=
        thompsonAbelianSubgroups_centralizer_eq (G := G) hA
      have hA_le_centA : A ≤ Subgroup.centralizer (A : Set G) :=
        (Subgroup.le_centralizer_iff_isMulCommutative (K := A)).2 hA.2.1
      have hD0_le_A : D0 ≤ A := by
        intro y hy
        have hyPA : y ∈ subgroupCentralizerIn' P A := by
          exact ⟨hy.1, hM0_le_P hy.2⟩
        simpa [hcentP_eq_A] using hyPA
      have hD0_eq_inf : D0 = M0 ⊓ C0 := by
        ext y
        constructor
        · intro hy
          refine ⟨hy.2, ⟨?_, hD0_le_A hy⟩⟩
          exact ((Subgroup.le_centralizer_iff_isMulCommutative (K := M0)).2 hM0_comm) hy.2
        · rintro ⟨hyM, hyC0⟩
          exact ⟨hA_le_centA hyC0.2, hyM⟩
      have hquot_le :
          Nat.card (A ⧸ C0.subgroupOf A) ≤ Nat.card (M0 ⧸ D0.subgroupOf M0) := by
        classical
        let : IsMulCommutative A := hA.2.1
        have hcomm_swap {a c : G} (ha : a ∈ A) (hc : c ∈ A)
            (haxc : ⁅⁅x, a⁆, c⁆ = 1) :
            ⁅⁅x, c⁆, a⁆ = 1 := by
          have hxaM0 : ⁅x, a⁆ ∈ M0 := by
            exact Subgroup.subset_closure ⟨a, ha, rfl⟩
          have hxcM0 : ⁅x, c⁆ ∈ M0 := by
            exact Subgroup.subset_closure ⟨c, hc, rfl⟩
          have hac : Commute a c := by
            exact setLike_mul_comm (s := A) ha hc
          let s : G := x * a * x⁻¹
          let t : G := x * c * x⁻¹
          let β : G := ⁅x, a⁆
          let δ : G := ⁅x, c⁆
          have hs_eq : s = β * a := by
            dsimp [s, β]
            simp [commutatorElement_def, mul_assoc]
          have hβ_eq : β = s * a⁻¹ := by
            dsimp [s, β]
            simp [commutatorElement_def, mul_assoc]
          have hδ_eq : δ = t * c⁻¹ := by
            dsimp [t, δ]
            simp [commutatorElement_def, mul_assoc]
          have hβc : Commute β c := commutatorElement_eq_one_iff_commute.mp haxc
          have hs_c : Commute s c := by
            change s * c = c * s
            calc
              s * c = (β * a) * c := by rw [hs_eq]
              _ = β * (a * c) := by simp [mul_assoc]
              _ = β * (c * a) := by rw [hac.eq]
              _ = (β * c) * a := by simp [mul_assoc]
              _ = (c * β) * a := by rw [hβc.eq]
              _ = c * (β * a) := by simp [mul_assoc]
              _ = c * s := by rw [hs_eq]
          have hst : Commute s t := by
            change s * t = t * s
            calc
              s * t = (x * a * x⁻¹) * (x * c * x⁻¹) := by rfl
              _ = x * a * c * x⁻¹ := by simp [mul_assoc]
              _ = x * (a * c) * x⁻¹ := by simp [mul_assoc]
              _ = x * (c * a) * x⁻¹ := by rw [hac.eq]
              _ = x * c * a * x⁻¹ := by simp [mul_assoc]
              _ = (x * c * x⁻¹) * (x * a * x⁻¹) := by simp [mul_assoc]
              _ = t * s := by rfl
          have hβδ : Commute β δ := by
            dsimp [β, δ]
            exact setLike_mul_comm (s := M0) hxaM0 hxcM0
          have hAinvCinv : Commute a⁻¹ c⁻¹ := (hac.inv_left).inv_right
          have hAinv_t_cinv : a⁻¹ * t * c⁻¹ = t * a⁻¹ * c⁻¹ := by
            have hs_eq' :
                s * (a⁻¹ * t * c⁻¹) = s * (t * a⁻¹ * c⁻¹) := by
              calc
                s * (a⁻¹ * t * c⁻¹) = (s * a⁻¹) * (t * c⁻¹) := by simp [mul_assoc]
                _ = β * δ := by rw [hβ_eq, hδ_eq]
                _ = δ * β := by rw [hβδ.eq]
                _ = (t * c⁻¹) * (s * a⁻¹) := by rw [hδ_eq, hβ_eq]
                _ = t * (c⁻¹ * s) * a⁻¹ := by simp [mul_assoc]
                _ = t * (s * c⁻¹) * a⁻¹ := by rw [(hs_c.inv_right).eq]
                _ = (t * s) * c⁻¹ * a⁻¹ := by simp [mul_assoc]
                _ = (s * t) * c⁻¹ * a⁻¹ := by rw [hst.eq]
                _ = s * (t * c⁻¹ * a⁻¹) := by simp [mul_assoc]
                _ = s * (t * (c⁻¹ * a⁻¹)) := by simp [mul_assoc]
                _ = s * (t * (a⁻¹ * c⁻¹)) := by rw [← hAinvCinv.eq]
                _ = s * (t * a⁻¹ * c⁻¹) := by simp [mul_assoc]
            exact mul_left_cancel hs_eq'
          have hAinv_t : a⁻¹ * t = t * a⁻¹ := by
            have hmul := congrArg (fun z => z * c) hAinv_t_cinv
            simpa [mul_assoc] using hmul
          have ht_a : Commute t a := by
            have htaInv : Commute a⁻¹ t := by
              change a⁻¹ * t = t * a⁻¹
              rw [hAinv_t]
            simpa using htaInv.inv_left.symm
          have hcInv_a : c⁻¹ * a = a * c⁻¹ := by
            simpa using (hac.inv_right.symm.eq)
          have hδa : Commute δ a := by
            change δ * a = a * δ
            calc
              δ * a = (t * c⁻¹) * a := by rw [hδ_eq]
              _ = t * (c⁻¹ * a) := by simp [mul_assoc]
              _ = t * (a * c⁻¹) := by rw [hcInv_a]
              _ = (t * a) * c⁻¹ := by simp [mul_assoc]
              _ = (a * t) * c⁻¹ := by rw [ht_a.eq]
              _ = a * (t * c⁻¹) := by simp [mul_assoc]
              _ = a * δ := by rw [hδ_eq]
          exact commutatorElement_eq_one_iff_commute.mpr hδa
        have hcommImage_mem (a : A) : ⁅x, (a : G)⁆ ∈ M0 := by
          exact Subgroup.subset_closure ⟨(a : G), a.2, rfl⟩
        let commImage : A → M0 := fun a => ⟨⁅x, (a : G)⁆, hcommImage_mem a⟩
        have hcommImage_calc {u v : A} :
            (((commImage u : M0)⁻¹ * commImage v : M0) : G) =
              (u : G) * ⁅x, ((u : G)⁻¹ * (v : G))⁆ * (u : G)⁻¹ := by
          simp [commImage, commutatorElement_def, mul_assoc]
        have hxc_centA_of_mem {c : G} (hcC0 : c ∈ C0) :
            ⁅x, c⁆ ∈ Subgroup.centralizer (A : Set G) := by
          rw [Subgroup.mem_centralizer_iff]
          intro a ha
          have hcA : c ∈ A := hC0_le_A hcC0
          have hxaM0 : ⁅x, a⁆ ∈ M0 := by
            exact Subgroup.subset_closure ⟨a, ha, rfl⟩
          have haxc : ⁅⁅x, a⁆, c⁆ = 1 := by
            exact
              commutatorElement_eq_one_iff_commute.mpr
                (Subgroup.mem_centralizer_iff.mp hcC0.1 _ hxaM0)
          have hxca : ⁅⁅x, c⁆, a⁆ = 1 := hcomm_swap ha hcA haxc
          exact (commutatorElement_eq_one_iff_commute.mp hxca).symm.eq
        have hc_cent_M0_of_mem {c : G} (hcA : c ∈ A)
            (hxc_centA : ⁅x, c⁆ ∈ Subgroup.centralizer (A : Set G)) :
            c ∈ Subgroup.centralizer (M0 : Set G) := by
          rw [Subgroup.mem_centralizer_iff]
          intro y hy
          have hyc : Commute y c := by
            refine
              Subgroup.closure_induction
                (p := fun z _ => Commute z c) ?_ ?_ ?_ ?_ hy
            · intro g hg
              rcases hg with ⟨a, ha, rfl⟩
              have hxca : ⁅⁅x, c⁆, a⁆ = 1 := by
                have hcomm : Commute ⁅x, c⁆ a := by
                  show ⁅x, c⁆ * a = a * ⁅x, c⁆
                  exact ((Subgroup.mem_centralizer_iff.mp hxc_centA) _ ha).symm
                exact commutatorElement_eq_one_iff_commute.mpr hcomm
              have haxc : ⁅⁅x, a⁆, c⁆ = 1 := by
                exact hcomm_swap hcA ha hxca
              exact commutatorElement_eq_one_iff_commute.mp haxc
            · exact Commute.one_left c
            · intro g₁ g₂ _ _ h₁ h₂
              show Commute (g₁ * g₂) c
              calc
                (g₁ * g₂) * c = g₁ * (g₂ * c) := by simp [mul_assoc]
                _ = g₁ * (c * g₂) := by rw [h₂.eq]
                _ = (g₁ * c) * g₂ := by simp [mul_assoc]
                _ = (c * g₁) * g₂ := by rw [h₁.eq]
                _ = c * (g₁ * g₂) := by simp [mul_assoc]
            · intro g _ h
              exact h.inv_left
          exact hyc.eq
        let f : A ⧸ C0.subgroupOf A → M0 ⧸ D0.subgroupOf M0 :=
          Quotient.map'
            commImage
            (by
              intro u v huv
              apply QuotientGroup.leftRel_apply.mpr
              change
                (((commImage u : M0)⁻¹ * commImage v : M0) ∈
                  D0.subgroupOf M0)
              have huv' : ((u : G)⁻¹ * (v : G)) ∈ C0 := by
                simpa [QuotientGroup.leftRel_apply, Subgroup.mem_subgroupOf] using huv
              have hxc_centA : ⁅x, ((u : G)⁻¹ * (v : G))⁆ ∈ Subgroup.centralizer (A : Set G) := by
                exact hxc_centA_of_mem huv'
              have hmemD0 :
                  (((commImage u : M0)⁻¹ * commImage v : M0) : G) ∈ D0 := by
                refine ⟨?_, ?_⟩
                · let c : G := (u : G)⁻¹ * (v : G)
                  have hcalc :
                      (((commImage u : M0)⁻¹ * commImage v : M0) : G) =
                        (u : G) * ⁅x, c⁆ * (u : G)⁻¹ := by
                    simpa [commImage, c] using (hcommImage_calc (u := u) (v := v))
                  have hu_centA : (u : G) ∈ Subgroup.centralizer (A : Set G) := hA_le_centA u.2
                  have hconj_cent :
                      (u : G) * ⁅x, c⁆ * (u : G)⁻¹ ∈ Subgroup.centralizer (A : Set G) := by
                    exact (Subgroup.centralizer (A : Set G)).mul_mem
                      ((Subgroup.centralizer (A : Set G)).mul_mem hu_centA hxc_centA)
                      ((Subgroup.centralizer (A : Set G)).inv_mem hu_centA)
                  exact hcalc ▸ hconj_cent
                · simpa using (((commImage u : M0)⁻¹ * commImage v : M0).2)
              simpa [Subgroup.mem_subgroupOf] using hmemD0)
        have hf_inj : Function.Injective f := by
          intro q1 q2 hq
          refine Quotient.inductionOn₂' q1 q2 ?_ hq
          intro u v huv
          apply Quotient.sound
          apply QuotientGroup.leftRel_apply.mpr
          change (u⁻¹ * v : A) ∈ C0.subgroupOf A
          have huv' :
              ((commImage u : M0)⁻¹ * commImage v : M0) ∈
                D0.subgroupOf M0 := by
            simpa [QuotientGroup.leftRel_apply] using (Quotient.exact' huv)
          let c : G := (u : G)⁻¹ * (v : G)
          have hcA : c ∈ A := A.mul_mem (A.inv_mem u.2) v.2
          have hmemD0 :
              ((((commImage u : M0)⁻¹ * commImage v : M0) : M0) : G) ∈ D0 := by
            simpa [Subgroup.mem_subgroupOf] using huv'
          have hd_centA :
              ((((commImage u : M0)⁻¹ * commImage v : M0) : M0) : G) ∈
                Subgroup.centralizer (A : Set G) := hmemD0.1
          have hcalc :
              (((commImage u : M0)⁻¹ * commImage v : M0) : G) =
                (u : G) * ⁅x, c⁆ * (u : G)⁻¹ := by
            simpa [commImage, c] using (hcommImage_calc (u := u) (v := v))
          have hu_centA : (u : G) ∈ Subgroup.centralizer (A : Set G) := hA_le_centA u.2
          have hxc_cent : ⁅x, c⁆ ∈ Subgroup.centralizer (A : Set G) := by
            have : (u : G)⁻¹ *
                ((((commImage u : M0)⁻¹ * commImage v : M0) : M0) : G) *
                (u : G) ∈ Subgroup.centralizer (A : Set G) := by
              exact (Subgroup.centralizer (A : Set G)).mul_mem
                ((Subgroup.centralizer (A : Set G)).mul_mem
                  ((Subgroup.centralizer (A : Set G)).inv_mem hu_centA) hd_centA)
                hu_centA
            simpa [hcalc, mul_assoc] using this
          have hc_cent_M0 : c ∈ Subgroup.centralizer (M0 : Set G) := by
            exact hc_cent_M0_of_mem hcA hxc_cent
          exact ⟨hc_cent_M0, hcA⟩
        exact Nat.card_le_card_of_injective f hf_inj
      have hcardA :
          Nat.card A = Nat.card (A ⧸ C0.subgroupOf A) * Nat.card C0 := by
        have hcardA' :
            Nat.card A = Nat.card (A ⧸ C0.subgroupOf A) * Nat.card (C0.subgroupOf A) := by
          simpa using
            (Subgroup.card_eq_card_quotient_mul_card_subgroup (s := C0.subgroupOf A))
        have hcardC0 : Nat.card (C0.subgroupOf A) = Nat.card C0 := by
          exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (H := C0) (K := A) hC0_le_A).toEquiv
        rw [hcardA', hcardC0]
      have hcardMC :
          Nat.card ↥(M0 ⊔ C0) =
            Nat.card (M0 ⧸ D0.subgroupOf M0) * Nat.card C0 := by
        let H : Subgroup G := M0 ⊔ C0
        let K : Subgroup H := C0.subgroupOf H
        have hC0_le_centM0 : C0 ≤ Subgroup.centralizer (M0 : Set G) := by
          intro y hy
          exact hy.1
        have hM0_le_normC0 : M0 ≤ Subgroup.normalizer (C0 : Set G) := by
          intro y hy
          rw [Subgroup.mem_normalizer_iff]
          intro z
          constructor
          · intro hz
            have hyz : z * y = y * z :=
              (Subgroup.le_centralizer_iff).1 hC0_le_centM0 hy z hz
            have hconj : y * z * y⁻¹ = z := by
              calc
                y * z * y⁻¹ = z * y * y⁻¹ := by rw [hyz, mul_assoc]
                _ = z := by simp
            simpa [hconj] using hz
          · intro hz
            have hyz : (y * z * y⁻¹) * y = y * (y * z * y⁻¹) :=
              (Subgroup.le_centralizer_iff).1 hC0_le_centM0 hy (y * z * y⁻¹) hz
            have hz_eq : z = y * z * y⁻¹ := by
              simpa [mul_assoc] using congrArg (fun t => y⁻¹ * t) hyz
            rw [hz_eq]
            exact hz
        have hK_normal : K.Normal := by
          change (C0.subgroupOf (M0 ⊔ C0)).Normal
          exact
            (Subgroup.normal_subgroupOf_sup_of_le_normalizer (H := M0) (N := C0) hM0_le_normC0)
        let : K.Normal := hK_normal
        have hcardH :
            Nat.card H = Nat.card (H ⧸ K) * Nat.card K := by
          simpa [H, K] using (Subgroup.card_eq_card_quotient_mul_card_subgroup (s := K))
        have hcardK : Nat.card K = Nat.card C0 := by
          exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (H := C0) (K := H) le_sup_right).toEquiv
        have hD0_eq_subgroupOf : D0.subgroupOf M0 = C0.subgroupOf M0 := by
          ext y
          simp [D0, hD0_eq_inf, Subgroup.mem_subgroupOf]
        let e : M0 ⧸ D0.subgroupOf M0 ↪ H ⧸ K :=
          (Subgroup.quotientEquivOfEq hD0_eq_subgroupOf).toEmbedding.trans
            (Subgroup.quotientSubgroupOfEmbeddingOfLE (H := C0) (s := M0) (t := H) le_sup_left)
        have he_surj : Function.Surjective e := by
          intro q
          refine Quotient.inductionOn' q ?_
          intro h
          have hh_sup : h ∈ (M0.subgroupOf H) ⊔ K := by
            have hsup_top : (M0.subgroupOf H) ⊔ K = ⊤ := by
              change (M0.subgroupOf (M0 ⊔ C0)) ⊔ C0.subgroupOf (M0 ⊔ C0) = ⊤
              rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right]
              simp
            rw [hsup_top]
            simp
          rcases (Subgroup.mem_sup_of_normal_right (s := M0.subgroupOf H) (t := K) (x := h)).1 hh_sup with
            ⟨m, hmM, c, hcK, hmc⟩
          have hmM0 : (m : G) ∈ M0 := by
            simpa [Subgroup.mem_subgroupOf] using hmM
          refine ⟨QuotientGroup.mk (⟨(m : G), hmM0⟩ : M0), ?_⟩
          change
            ((Subgroup.quotientSubgroupOfEmbeddingOfLE (H := C0) (s := M0) (t := H) le_sup_left)
              ((Subgroup.quotientEquivOfEq hD0_eq_subgroupOf)
                (QuotientGroup.mk (⟨(m : G), hmM0⟩ : M0))) = QuotientGroup.mk h)
          rw [Subgroup.quotientEquivOfEq_mk,
            Subgroup.quotientSubgroupOfEmbeddingOfLE_apply_mk (H := C0) (h := le_sup_left)
            (g := (⟨(m : G), hmM0⟩ : M0))]
          apply Quotient.sound
          apply (QuotientGroup.leftRel_apply).mpr
          have hm_eq : (Subgroup.inclusion le_sup_left (⟨(m : G), hmM0⟩ : M0) : H) = m := by
            ext
            rfl
          rw [hm_eq, ← hmc]
          simpa [K, Subgroup.mem_subgroupOf]
        have hcardQ : Nat.card (H ⧸ K) = Nat.card (M0 ⧸ D0.subgroupOf M0) := by
          exact Nat.card_congr
            (Equiv.ofBijective e.toFun (show Function.Bijective e.toFun from ⟨e.injective, he_surj⟩)).symm
        calc
          Nat.card ↥(M0 ⊔ C0) = Nat.card (H ⧸ K) * Nat.card K := hcardH
          _ = Nat.card (M0 ⧸ D0.subgroupOf M0) * Nat.card C0 := by
            rw [hcardQ, hcardK]
      calc
        Nat.card A = Nat.card (A ⧸ C0.subgroupOf A) * Nat.card C0 := hcardA
        _ ≤ Nat.card (M0 ⧸ D0.subgroupOf M0) * Nat.card C0 := by
          exact Nat.mul_le_mul_right _ hquot_le
        _ = Nat.card ↥(M0 ⊔ C0) := hcardMC.symm
    exact hB_card_le_A.trans hA_card_le

/-- Theorem 3.1(b) ([6], §3, Theorem 3.1(b), p. 1106; `refs/glauberman-p-stable.tex`
L437–L452, proof at L452–L528): let `S` be a finite `p`-group and `A ∈ A(S)`.  If `B` is
an Abelian subgroup of `S` normalised by `A` and `[B,A,A] ≠ 1`, then there exists
`A* ∈ A(S)` with `A ∩ B < A* ∩ B` and `[A*,A,A] = 1`.

Route of the paper: from `[B,A,A] ≠ 1` and `C_S(A) = A` one gets `B ≰ N_S(A)`, so
`B/N_B(A)` is a non-trivial normal subgroup of the `p`-group `AB/N_B(A)`; by Lemma 3.3 it
meets the centre, giving `b ∈ B` with `[b,A] ⊆ N_B(A)` and `b ∉ N(A)`.  Then `M = [b,A]`
is Abelian (it lies in `B`), and `A* = M·C_A(M)` is in `A(S)` by part (a); `A* ⊆ N_S(A)`
gives `[A*,A,A] = 1`, and `A ∩ B ⊆ C_A(M) ⊆ A*` together with `M ⊄ A` gives the strict
inclusion `A ∩ B < A* ∩ B`. -/
public theorem theorem3_1b {P : Subgroup G} [Finite G] {p : ℕ} [Fact p.Prime]
    (hSp : IsPGroup p P) {A B : Subgroup G}
    (hA : A ∈ thompsonAbelianSubgroups (G := G) P) (hB_le_P : B ≤ P)
    (hB_comm : IsMulCommutative B) (hA_norm_B : A ≤ Subgroup.normalizer (B : Set G))
    (hBAA_ne : ⁅⁅B, A⁆, A⁆ ≠ ⊥) :
    ∃ Astar : Subgroup G,
      Astar ∈ thompsonAbelianSubgroups (G := G) P ∧ A ⊓ B < Astar ⊓ B ∧ ⁅⁅Astar, A⁆, A⁆ = ⊥ := by
  classical
  let : IsMulCommutative B := hB_comm
  have hAA_bot : ⁅A, A⁆ = ⊥ :=
    (Subgroup.commutator_eq_bot_iff_le_centralizer).2
      ((Subgroup.le_centralizer_iff_isMulCommutative (K := A)).2 hA.2.1)
  -- `B ≤ N_S(A)` would force `[B,A,A] = 1`
  have hBAA_of_norm : B ≤ Subgroup.normalizer (A : Set G) → ⁅⁅B, A⁆, A⁆ = ⊥ := by
    intro hB_norm
    have hBA_le_A : ⁅B, A⁆ ≤ A :=
      (Subgroup.le_normalizer_iff_commutator_le_right (H := B) (K := A)).1 hB_norm
    apply le_bot_iff.mp
    calc
      ⁅⁅B, A⁆, A⁆ ≤ ⁅A, A⁆ := Subgroup.commutator_mono hBA_le_A le_rfl
      _ = ⊥ := hAA_bot
  have hB_not_norm : ¬ B ≤ Subgroup.normalizer (A : Set G) := fun hB_norm =>
    hBAA_ne (hBAA_of_norm hB_norm)
  let U : Subgroup G := B ⊔ A
  let N : Subgroup G := B ⊓ Subgroup.normalizer (A : Set G)
  have hN_le_B : N ≤ B := inf_le_left
  have hN_le_U : N ≤ U := hN_le_B.trans le_sup_left
  -- `N = N_B(A)` is normal in `U = AB`
  have hnorm_conj {a' : G} (ha' : a' ∈ A) {n' : G}
      (hn' : n' ∈ Subgroup.normalizer (A : Set G)) :
      a' * n' * a'⁻¹ ∈ Subgroup.normalizer (A : Set G) := by
    rw [Subgroup.mem_normalizer_iff'']
    intro x
    constructor
    · intro hx
      have hax : a'⁻¹ * x * a' ∈ A :=
        (Subgroup.mem_normalizer_iff''.mp (A.le_normalizer ha') x).1 hx
      have hnx : n'⁻¹ * (a'⁻¹ * x * a') * n' ∈ A :=
        (Subgroup.mem_normalizer_iff''.mp hn' (a'⁻¹ * x * a')).1 hax
      have hconj : a' * (n'⁻¹ * (a'⁻¹ * x * a') * n') * a'⁻¹ ∈ A :=
        (Subgroup.mem_normalizer_iff.mp (A.le_normalizer ha') (n'⁻¹ * (a'⁻¹ * x * a') * n')).1 hnx
      have hcalc : (a' * n' * a'⁻¹)⁻¹ * x * (a' * n' * a'⁻¹) =
          a' * (n'⁻¹ * (a'⁻¹ * x * a') * n') * a'⁻¹ := by
        simp [mul_assoc]
      rwa [hcalc]
    · intro hx
      let w : G := n'⁻¹ * (a'⁻¹ * x * a') * n'
      have hwA' : a' * w * a'⁻¹ ∈ A := by
        simpa [w, mul_assoc, inv_inv] using hx
      have hwA : w ∈ A := by
        have hainv : a'⁻¹ ∈ A := A.inv_mem ha'
        have hconj : a'⁻¹ * (a' * w * a'⁻¹) * a' ∈ A := by
          simpa [inv_inv, mul_assoc] using
            (Subgroup.mem_normalizer_iff.mp (A.le_normalizer hainv) (a' * w * a'⁻¹)).1 hwA'
        simpa [mul_assoc] using hconj
      have ha'xa : a'⁻¹ * x * a' ∈ A := by
        have hw' : n' * w * n'⁻¹ ∈ A := (Subgroup.mem_normalizer_iff.mp hn' w).1 hwA
        have hcalc : a'⁻¹ * x * a' = n' * w * n'⁻¹ := by
          dsimp [w]
          simp [mul_assoc]
        rwa [hcalc]
      have hx' : a' * (a'⁻¹ * x * a') * a'⁻¹ ∈ A :=
        (Subgroup.mem_normalizer_iff.mp (A.le_normalizer ha') (a'⁻¹ * x * a')).1 ha'xa
      simpa [mul_assoc] using hx'
  have hB_le_normN : B ≤ Subgroup.normalizer (N : Set G) := by
    intro b hb
    rw [Subgroup.mem_normalizer_iff]
    intro n
    constructor
    · intro hn
      have hnb : n ∈ B := hN_le_B hn
      have hbn : b * n * b⁻¹ = n := by
        calc
          b * n * b⁻¹ = n * b * b⁻¹ := by rw [setLike_mul_comm (s := B) hb hnb, mul_assoc]
          _ = n := by simp
      rwa [hbn]
    · intro hbn
      have hbnB : b * n * b⁻¹ ∈ B := hN_le_B hbn
      have hbinv : b⁻¹ ∈ B := B.inv_mem hb
      have h_eq : b⁻¹ * (b * n * b⁻¹) * b = b * n * b⁻¹ := by
        calc
          b⁻¹ * (b * n * b⁻¹) * b = (b * n * b⁻¹) * b⁻¹ * b := by
            rw [setLike_mul_comm (s := B) hbinv hbnB, mul_assoc]
          _ = b * n * b⁻¹ := by simp [mul_assoc]
      have h_n : n = b⁻¹ * (b * n * b⁻¹) * b := by
        simp [mul_assoc]
      rw [h_n, h_eq]
      exact hbn
  have hA_le_normN : A ≤ Subgroup.normalizer (N : Set G) := by
    intro a ha
    rw [Subgroup.mem_normalizer_iff]
    intro n
    constructor
    · intro hn
      refine ⟨?_, ?_⟩
      · exact (Subgroup.mem_normalizer_iff.mp (hA_norm_B ha) n).1 (hN_le_B hn)
      · exact hnorm_conj ha ((inf_le_right : N ≤ Subgroup.normalizer (A : Set G)) hn)
    · intro han
      refine ⟨?_, ?_⟩
      · simpa [mul_assoc] using
          (Subgroup.mem_normalizer_iff.mp (hA_norm_B (A.inv_mem ha)) (a * n * a⁻¹)).1
            (hN_le_B han)
      · simpa [mul_assoc] using hnorm_conj (A.inv_mem ha)
          ((inf_le_right : N ≤ Subgroup.normalizer (A : Set G)) han)
  have hU_le_normN : U ≤ Subgroup.normalizer (N : Set G) := sup_le hB_le_normN hA_le_normN
  let N' : Subgroup U := N.subgroupOf U
  let : N'.Normal := Subgroup.normal_subgroupOf_of_le_normalizer hU_le_normN
  let q : U →* U ⧸ N' := QuotientGroup.mk' N'
  have hU_le_P : U ≤ P := sup_le hB_le_P hA.1
  have hUp : IsPGroup p U := hSp.to_le (H := U) hU_le_P
  have hUq_p : IsPGroup p (U ⧸ N') := hUp.to_quotient N'
  have : Finite (U ⧸ N') := inferInstance
  let H' : Subgroup (U ⧸ N') := (B.subgroupOf U).map q
  have hU_le_normB : U ≤ Subgroup.normalizer (B : Set G) := sup_le B.le_normalizer hA_norm_B
  let : (B.subgroupOf U).Normal := Subgroup.normal_subgroupOf_of_le_normalizer hU_le_normB
  have : H'.Normal := inferInstance
  have hH'_ne_bot : H' ≠ ⊥ := by
    intro hbot
    have hle : B.subgroupOf U ≤ (q.ker : Subgroup U) :=
      (Subgroup.map_eq_bot_iff (H := B.subgroupOf U)).1 hbot
    have hB_le_N : B ≤ N := by
      intro b hb
      have hb' : (⟨b, (le_sup_left : B ≤ U) hb⟩ : U) ∈ B.subgroupOf U :=
        Subgroup.mem_subgroupOf.mpr hb
      have hb'' : (⟨b, (le_sup_left : B ≤ U) hb⟩ : U) ∈ N' := by
        simpa [q, QuotientGroup.ker_mk'] using hle hb'
      exact Subgroup.mem_subgroupOf.mp hb''
    exact hB_not_norm (hB_le_N.trans inf_le_right)
  obtain ⟨z, hzH', hz_center, hz_ne_one⟩ := lemma3_3 (G := U ⧸ N') hUq_p (H := H') hH'_ne_bot
  rcases hzH' with ⟨b', hb'B, hb'_eq⟩
  let b : G := (b' : U).1
  have hbB : b ∈ B := by
    simpa [b] using (Subgroup.mem_subgroupOf.mp hb'B)
  have hbP : b ∈ P := hB_le_P hbB
  have hb_notin_N : b ∉ N := by
    intro hbN
    have hb'N : b' ∈ N' := by
      simpa [b] using (Subgroup.mem_subgroupOf.mpr hbN)
    have hz1 : z = 1 := by
      have hq : q b' = 1 := by
        simpa [q, QuotientGroup.mk'_apply] using
          (QuotientGroup.eq_one_iff (N := N') b').2 hb'N
      simpa [hb'_eq] using hq
    exact hz_ne_one hz1
  have hb_notin_normA : b ∉ Subgroup.normalizer (A : Set G) := by
    intro hbA
    exact hb_notin_N (Subgroup.mem_inf.mpr ⟨hbB, hbA⟩)
  -- the coset `bN'` is central in `U/N'`: `[g,b] ∈ N` for all `g`
  have hcentral (g : U) : q (g * b') = q (b' * g) := by
    have hc : (q g) * z = z * (q g) := (Subgroup.mem_center_iff.mp hz_center) (q g)
    calc
      q (g * b') = (q g) * (q b') := by rw [MonoidHom.map_mul]
      _ = (q b') * (q g) := by simpa [hb'_eq] using hc
      _ = q (b' * g) := by rw [MonoidHom.map_mul]
  have hbA_comm (a : G) (ha : a ∈ A) : ⁅a, b⁆ ∈ N := by
    let a' : U := ⟨a, (le_sup_right : A ≤ B ⊔ A) ha⟩
    have hc : q (a' * b') = q (b' * a') := hcentral a'
    have hqcomm : q ⁅b', a'⁆ = 1 := by
      rw [map_commutatorElement, hb'_eq]
      exact commutatorElement_eq_one_iff_commute.2 ((Subgroup.mem_center_iff.mp hz_center (q a')).symm)
    have hb'comm : ⁅b', a'⁆ ∈ N' := by
      have hker : ⁅b', a'⁆ ∈ q.ker := (MonoidHom.mem_ker).2 (by simpa [q] using hqcomm)
      simpa [q, QuotientGroup.ker_mk'] using hker
    have ha'comm : ⁅a', b'⁆ ∈ N' := by
      simpa [commutatorElement_inv] using N'.inv_mem hb'comm
    have hval : ((⁅a', b'⁆ : U) : G) ∈ N := Subgroup.mem_subgroupOf.mp ha'comm
    change ((⁅a', b'⁆ : U) : G) ∈ N
    exact hval
  let M : Subgroup G := Subgroup.closure {g : G | ∃ u ∈ A, ⁅b, u⁆ = g}
  have hM_le_N : M ≤ N := by
    rw [Subgroup.closure_le]
    intro g hg
    rcases hg with ⟨u, hu, rfl⟩
    simpa [commutatorElement_inv] using N.inv_mem (hbA_comm u hu)
  have hM_le_B : M ≤ B := hM_le_N.trans hN_le_B
  have hM_comm : IsMulCommutative M := by
    refine IsMulCommutative.of_setLike_mul_comm ?_
    intro y hy z hz
    exact setLike_mul_comm (s := B) (hM_le_B hy) (hM_le_B hz)
  let C : Subgroup G := subgroupCentralizerIn' A M
  have hAstar_AS : M ⊔ C ∈ thompsonAbelianSubgroups (G := G) P := theorem3_1a hA hbP hM_comm
  have hM_not_le_A : ¬ M ≤ A := by
    intro hM_le_A
    exact hb_notin_normA ((lemma3_1 (x := b) (H := A)).2 hM_le_A)
  have hAstar_le_normA : M ⊔ C ≤ Subgroup.normalizer (A : Set G) := by
    refine sup_le ?_ ?_
    · exact hM_le_N.trans (inf_le_right : N ≤ Subgroup.normalizer (A : Set G))
    · exact (inf_le_right : C ≤ A).trans A.le_normalizer
  have hNA_le_A : ⁅Subgroup.normalizer (A : Set G), A⁆ ≤ A :=
    (Subgroup.le_normalizer_iff_commutator_le_right
      (H := Subgroup.normalizer (A : Set G)) (K := A)).1 le_rfl
  have hNAA_bot : ⁅⁅Subgroup.normalizer (A : Set G), A⁆, A⁆ = ⊥ := by
    apply le_antisymm
    · calc
        ⁅⁅Subgroup.normalizer (A : Set G), A⁆, A⁆ ≤ ⁅A, A⁆ :=
          Subgroup.commutator_mono hNA_le_A le_rfl
        _ = ⊥ := hAA_bot
    · exact bot_le
  have hAstarAA_bot : ⁅⁅M ⊔ C, A⁆, A⁆ = ⊥ := by
    apply le_antisymm
    · calc
        ⁅⁅M ⊔ C, A⁆, A⁆ ≤ ⁅⁅Subgroup.normalizer (A : Set G), A⁆, A⁆ :=
          Subgroup.commutator_mono (Subgroup.commutator_mono hAstar_le_normA le_rfl) le_rfl
        _ = ⊥ := hNAA_bot
    · exact bot_le
  have hAB_le_C : A ⊓ B ≤ C := by
    intro x hx
    refine ⟨?_, hx.1⟩
    have hxB : x ∈ B := hx.2
    have hB_le_cenB : B ≤ Subgroup.centralizer (B : Set G) :=
      (Subgroup.le_centralizer_iff_isMulCommutative (K := B)).2 hB_comm
    have hcenB_le_cenM : Subgroup.centralizer (B : Set G) ≤ Subgroup.centralizer (M : Set G) :=
      Subgroup.centralizer_le hM_le_B
    exact hcenB_le_cenM (hB_le_cenB hxB)
  have hAB_le_Astar : A ⊓ B ≤ M ⊔ C := hAB_le_C.trans le_sup_right
  have hAB_le_inter : A ⊓ B ≤ (M ⊔ C) ⊓ B := le_inf hAB_le_Astar inf_le_right
  have hM_le_inter : M ≤ (M ⊔ C) ⊓ B := le_inf le_sup_left hM_le_B
  have hlt : A ⊓ B < (M ⊔ C) ⊓ B := by
    refine lt_of_le_of_ne hAB_le_inter ?_
    intro hEq
    have hM_le_A : M ≤ A := (hM_le_inter.trans (le_of_eq hEq.symm)).trans inf_le_left
    exact hM_not_le_A hM_le_A
  exact ⟨M ⊔ C, hAstar_AS, hlt, hAstarAA_bot⟩

/-- Corollary 3.1 ([6], §3, Corollary 3.1, p. 1107; `refs/glauberman-p-stable.tex`
L440–L451): if `S` is a finite `p`-group and `B` is an Abelian normal subgroup of `S`,
then there exists `A ∈ A(S)` such that `B` normalises `A` and `[B,A,A] = 1`.

Route of the paper: choose `A ∈ A(S)` with `A ∩ B` of maximal size; part (b) of
Theorem 3.1 then forces `[B,A,A] = 1`; hence `[B,A] ⊆ C_S(A) = A` (by
`thompsonAbelianSubgroups_centralizer_eq`), so `B ≤ N_S(A)` by Lemma 3.1. -/
public theorem corollary3_1 {P : Subgroup G} [Finite G] {p : ℕ} [Fact p.Prime]
    (hSp : IsPGroup p P) {B : Subgroup G}
    (hB_le_P : B ≤ P) (hB_comm : IsMulCommutative B)
    (hB_normal : (B.subgroupOf P).Normal) :
    ∃ A : Subgroup G,
      A ∈ thompsonAbelianSubgroups (G := G) P ∧
        B ≤ Subgroup.normalizer (A : Set G) ∧ ⁅⁅B, A⁆, A⁆ = ⊥ := by
  classical
  -- an element of `A(S)` exists: an Abelian subgroup of `P` of maximal order
  let s : Set (Subgroup G) := {C : Subgroup G | C ≤ P ∧ IsMulCommutative C}
  have hs_fin : s.Finite := Set.toFinite s
  have hs_ne : s.Nonempty := by
    refine ⟨⊥, ?_⟩
    refine ⟨bot_le, ?_⟩
    exact (Subgroup.le_centralizer_iff_isMulCommutative (K := ⊥)).1 bot_le
  obtain ⟨A0, hA0_s, hA0_max⟩ :=
    Set.exists_max_image s (fun C : Subgroup G => Nat.card C) hs_fin hs_ne
  have hA0_AS : A0 ∈ thompsonAbelianSubgroups (G := G) P :=
    ⟨hA0_s.1, hA0_s.2, fun B hB_le_P hB_comm => hA0_max B ⟨hB_le_P, hB_comm⟩⟩
  -- choose `A ∈ A(S)` maximising `|A ⊓ B|`
  let t : Set (Subgroup G) := thompsonAbelianSubgroups (G := G) P
  have ht_fin : t.Finite := Set.toFinite t
  have ht_ne : t.Nonempty := ⟨A0, hA0_AS⟩
  obtain ⟨A, hA_t, hA_max⟩ :=
    Set.exists_max_image t (fun C : Subgroup G => Nat.card ↥(C ⊓ B)) ht_fin ht_ne
  have hA : A ∈ thompsonAbelianSubgroups (G := G) P := hA_t
  have hA_norm_B : A ≤ Subgroup.normalizer (B : Set G) := by
    have hP_le_normB : P ≤ Subgroup.normalizer (B : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hB_le_P).1 hB_normal
    exact hA.1.trans hP_le_normB
  have hBAA : ⁅⁅B, A⁆, A⁆ = ⊥ := by
    by_contra hne
    obtain ⟨Astar, hAstar_AS, hlt, _⟩ := theorem3_1b hSp hA hB_le_P hB_comm hA_norm_B hne
    have hle_card : Nat.card ↥(A ⊓ B) ≤ Nat.card ↥(Astar ⊓ B) := Subgroup.card_le_of_le hlt.le
    have hlt_card : Nat.card ↥(A ⊓ B) < Nat.card ↥(Astar ⊓ B) := by
      refine lt_of_le_of_ne hle_card ?_
      intro hEq
      have hEq' : A ⊓ B = Astar ⊓ B := Subgroup.eq_of_le_of_card_ge hlt.le (Nat.le_of_eq hEq.symm)
      exact hlt.ne hEq'
    exact (not_lt_of_ge (hA_max Astar hAstar_AS)) hlt_card
  have hBA_le_A : ⁅B, A⁆ ≤ A := by
    have hBA_le_cenA : ⁅B, A⁆ ≤ Subgroup.centralizer (A : Set G) :=
      (Subgroup.commutator_eq_bot_iff_le_centralizer).1 hBAA
    have hBA_le_P : ⁅B, A⁆ ≤ P := (Subgroup.commutator_le_sup B A).trans (sup_le hB_le_P hA.1)
    have hBA_le_C : ⁅B, A⁆ ≤ subgroupCentralizerIn' P A := by
      intro x hx
      exact ⟨hBA_le_cenA hx, hBA_le_P hx⟩
    simpa [thompsonAbelianSubgroups_centralizer_eq (G := G) hA] using hBA_le_C
  have hB_norm_A : B ≤ Subgroup.normalizer (A : Set G) :=
    (Subgroup.le_normalizer_iff_commutator_le_left (H := B) (K := A)).2 (by
      simpa [Subgroup.commutator_comm] using hBA_le_A)
  exact ⟨A, hA, hB_norm_A, hBAA⟩

end CFSG.Glauberman
