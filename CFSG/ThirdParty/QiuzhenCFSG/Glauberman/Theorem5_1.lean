universe u

/-!
# Glauberman, "A Characteristic Subgroup of a p-Stable Group" — §5, the conjugacy condition

Formalization of paper §5 (`refs/glauberman-p-stable.tex` L1133–L1415; original
[6, §5, pp. 1116–1121]): the *characteristic functor* definition (paper properties
(a)–(c)), the conditions `(C_p)` and `(C_p*)`, Lemma 5.1 (their equivalence), and
Theorem 5.1 (the ZJ functor satisfies `(C_p)` under hypothesis (a) or (b)).

This file is the shared home of the `(C_p)`/`(C_p*)` definitions for later files
(Theorems B and C of the wrapper `Glauberman/ZJTheorem.lean`); the definitions are
public.  The functor `K` of the paper is packaged as `CharacteristicFunctor p`, which
is instantiable at every ambient group (needed later for subquotients): its field `K`
is a dependent family `{H : Type u} → [Group H] → Subgroup H → Subgroup H`, and the
ZJ functor `K(P) = Z(J(P))` is realized as `zjCharacteristicFunctor p`.

Conventions follow the wrapper: `ZJ S` is `thompsonCenter S` (= `Z(J(S))`), `J S` is
`thompsonSubgroup S`, `conjSubset g W = {g⁻¹wg | w ∈ W}` is the paper's `W^g`, `MpSet`
is `M_p(G)`, `centerIn` (from `FeitThompson.ChiefFactors.Core`) is the center of a
subgroup viewed in the ambient group.

The infrastructure lemmas of `FeitThompson/Gorenstein/Chapter8_2.lean` that are used
here (`thompsonCenter_le`, `thompsonCenter_top_map_subtype`, the `mulEquiv` map lemmas,
...) are `module`-private there; they are reproduced locally at the top of this file.

**Steps (I)–(IV).**  The proof of Theorem 5.1 in the paper is its longest argument
(steps (I)–(IV), requiring the methods of Burnside and Thompson).  Step (I), the
Burnside–Thompson maximality argument, is proved in `theorem5_1_step_I`.  Step (II)
(`(C_p)` for `W = Z(S)`) is proved in full (`theorem5_1_step_II`, including the hidden
lemma `thompsonSubgroup_eq_of_sylow_le` behind the paper's "clearly, `J^n = J`").
Steps (III) and (IV) are proved in full as well (`theorem5_1_step_III`, the
`M = N(Z)`/`M ∈ M_p(G)` construction and the `(C_p*)`-in-`M` argument, and
`theorem5_1_step_IV`, the reduction of an arbitrary `p`-subgroup to the case
`C_S(W) ∈ Syl_p(C_G(W))` via `N_S(V) ∈ Syl_p(N_G(V))`); their proofs use the local
helpers `sylow_inf_normal` (a Sylow subgroup intersected with a normal subgroup is
Sylow in it), `thompsonCenter_subgroupOf`, `mem_normalizer_map_subtype_iff`,
`exists_MpSet_of_core_ne_bot` (any subgroup with non-trivial `p`-core lies in an
element of `M_p(G)`), and `step_III_M_part`.
The final theorem `theorem5_1` assembles the steps and passes from the subgroup form
of `(C_p)` to the set form via the subgroup generated by `W`.  See the section
"Theorem 5.1" for details.
-/

namespace CFSG.Glauberman

/-! ## Local infrastructure

The following lemmas are `module`-private in `FeitThompson/Gorenstein/Chapter8_2.lean`
(and, for the last few, in `FeitThompson/BGsection9/theorem_9_1.lean`); they are
reproved here so that the definitions below can use them.
-/

variable {G : Type u} [Group G]

/-- `centerIn H` is the image of the center of `H` in the ambient group. -/
theorem centerIn_eq_map_center_local (H : Subgroup G) :
    centerIn (G := G) H = (Subgroup.center H).map H.subtype := by
  ext x
  constructor
  · intro hx
    rcases hx with ⟨hxH, hx_centralizer⟩
    exact Subgroup.mem_map.mpr ⟨⟨x, hxH⟩,
      Subgroup.mem_center_iff.mpr (fun h =>
        Subtype.ext (Subgroup.mem_centralizer_iff.mp hx_centralizer (h : G) h.property)), rfl⟩
  · intro hx
    rcases Subgroup.mem_map.mp hx with ⟨h, hh, rfl⟩
    refine ⟨h.property, ?_⟩
    exact Subgroup.mem_centralizer_iff.mpr (fun y hy =>
      congrArg Subtype.val (Subgroup.mem_center_iff.mp hh ⟨y, hy⟩))

/-- `J(P) ≤ P`. -/
theorem thompsonSubgroup_le_local (P : Subgroup G) :
    thompsonSubgroup (G := G) P ≤ P := by
  refine sSup_le ?_
  intro A hA
  exact hA.1

/-- `Z(J(P)) ≤ P`. -/
theorem thompsonCenter_le_local (P : Subgroup G) :
    thompsonCenter (G := G) P ≤ P := by
  calc
    thompsonCenter (G := G) P ≤ thompsonSubgroup (G := G) P := by
      exact inf_le_left
    _ ≤ P := thompsonSubgroup_le_local (G := G) P

/-- `Z(J(P))` is abelian. -/
theorem thompsonCenter_isMulCommutative_local (P : Subgroup G) :
    IsMulCommutative (thompsonCenter (G := G) P) := by
  refine (Subgroup.le_centralizer_iff_isMulCommutative (K := thompsonCenter (G := G) P)).1 ?_
  have hle_left : thompsonCenter (G := G) P ≤ thompsonSubgroup (G := G) P := by
    exact inf_le_left
  have hle_right :
      thompsonCenter (G := G) P ≤
        Subgroup.centralizer (thompsonSubgroup (G := G) P : Set G) := by
    exact inf_le_right
  exact hle_right.trans <|
    Subgroup.centralizer_le
      (show (thompsonCenter (G := G) P : Set G) ⊆ (thompsonSubgroup (G := G) P : Set G) from
        hle_left)

/-- The abelian subgroups of `S` of maximal order form a non-empty set (finite `S`). -/
theorem exists_mem_thompsonAbelianSubgroups (S : Subgroup G) [Finite ↥S] :
    ∃ A : Subgroup G, A ∈ thompsonAbelianSubgroups S := by
  classical
  let s : Set (Subgroup G) := {A | A ≤ S ∧ IsMulCommutative A}
  have hsfin : s.Finite := by
    have hinj :
        Function.Injective (fun A : ↥s => ((A : Subgroup G).subgroupOf S : Subgroup ↥S)) := by
      intro A B h
      apply Subtype.ext
      have h' := congrArg (fun X : Subgroup ↥S => X.map S.subtype) h
      calc
        A.1 = (A.1.subgroupOf S).map S.subtype := by
          exact (Subgroup.map_subgroupOf_eq_of_le (H := A.1) (K := S) A.2.1).symm
        _ = (B.1.subgroupOf S).map S.subtype := h'
        _ = B.1 := by
          exact Subgroup.map_subgroupOf_eq_of_le (H := B.1) (K := S) B.2.1
    have : Finite ↥s :=
      Finite.of_injective (fun A : ↥s => ((A : Subgroup G).subgroupOf S : Subgroup ↥S)) hinj
    exact Set.toFinite s
  have hsne : s.Nonempty := by
    refine ⟨⊥, ?_⟩
    exact ⟨bot_le, inferInstance⟩
  obtain ⟨A, hAmax⟩ := hsfin.exists_maximalFor (fun A : Subgroup G => Nat.card A) s hsne
  refine ⟨A, ?_⟩
  refine ⟨hAmax.1.1, hAmax.1.2, ?_⟩
  intro B hBS hBcomm
  exact hAmax.le ⟨hBS, hBcomm⟩

/-- The center `Z(S)` of a subgroup, viewed in the ambient group, is abelian. -/
theorem centerIn_isMulCommutative_local (S : Subgroup G) :
    IsMulCommutative (centerIn (G := G) S) := by
  refine ⟨⟨fun x y => ?_⟩⟩
  apply Subtype.ext
  exact ((Subgroup.mem_centralizer_iff.mp x.2.2 (y : G) y.2.1)).symm

/-- `Z(S) ≤ J(S)` for every subgroup `S` of `G`. -/
theorem centerIn_le_thompsonSubgroup (S : Subgroup G) [Finite ↥S] :
    centerIn (G := G) S ≤ thompsonSubgroup S := by
  classical
  intro z hz
  obtain ⟨A, hA⟩ := exists_mem_thompsonAbelianSubgroups (G := G) S
  let Z : Subgroup G := A ⊔ centerIn (G := G) S
  have hZ_le_S : Z ≤ S := by
    exact sup_le hA.1 inf_le_left
  have hcenter_comm : IsMulCommutative (centerIn (G := G) S) := by
    exact centerIn_isMulCommutative_local (G := G) S
  have hA_center : A ≤ Subgroup.centralizer ((centerIn (G := G) S : Subgroup G) : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact ((Subgroup.mem_centralizer_iff.mp hy.2) a (hA.1 ha)).symm
  have hZcomm : IsMulCommutative Z := by
    change IsMulCommutative ↥(A ⊔ centerIn (G := G) S)
    rw [Subgroup.sup_eq_closure]
    refine Subgroup.isMulCommutative_closure (Set.Pairwise.of_forall₂ ?_)
    intro x hx y hy
    show x * y = y * x
    rcases hx with hxA | hxZ <;> rcases hy with hyA | hyZ
    · let : IsMulCommutative A := hA.2.1
      exact setLike_mul_comm (s := A) hxA hyA
    · exact ((Subgroup.mem_centralizer_iff.mp (hA_center hxA)) y hyZ).symm
    · exact (Subgroup.mem_centralizer_iff.mp (hA_center hyA)) x hxZ
    · let : IsMulCommutative (centerIn (G := G) S) := hcenter_comm
      exact setLike_mul_comm (s := centerIn (G := G) S) hxZ hyZ
  have hZcard_le_A : Nat.card Z ≤ Nat.card A :=
    hA.2.2 Z hZ_le_S hZcomm
  have hA_le_Z : A ≤ Z := le_sup_left
  have : Finite ↥Z := Finite.of_equiv (↥(Z.subgroupOf S))
    (Subgroup.subgroupOfEquivOfLe hZ_le_S).toEquiv
  have hA_eq_Z : A = Z := Subgroup.eq_of_le_of_card_ge hA_le_Z hZcard_le_A
  have hzA : z ∈ A := by
    have hzZ : z ∈ Z := (show centerIn (G := G) S ≤ Z from le_sup_right) hz
    simpa [hA_eq_Z] using hzZ
  exact (le_sSup hA) hzA

/-- If `S` is a non-trivial finite `p`-group, then `Z(S) ≠ 1`. -/
theorem centerIn_ne_bot_of_isPGroup_ne_bot {p : ℕ} [Fact p.Prime]
    {S : Subgroup G} [Finite ↥S] (hSp : IsPGroup p S) (hSne : S ≠ ⊥) :
    centerIn (G := G) S ≠ ⊥ := by
  classical
  have : Nontrivial ↥S := (Subgroup.nontrivial_iff_ne_bot S).2 hSne
  have hcenter_ne_bot : Subgroup.center ↥S ≠ ⊥ :=
    (ne_of_gt (IsPGroup.bot_lt_center (p := p) (G := ↥S) hSp))
  intro hcenterIn_bot
  apply hcenter_ne_bot
  ext z
  constructor
  · intro hz
    have hzMap : ((z : ↥S) : G) ∈ (Subgroup.center ↥S).map S.subtype := ⟨z, hz, rfl⟩
    have hzCenterIn : ((z : ↥S) : G) ∈ centerIn (G := G) S := by
      simpa [centerIn_eq_map_center_local] using hzMap
    have hzBot : ((z : ↥S) : G) ∈ (⊥ : Subgroup G) := by
      simpa [hcenterIn_bot] using hzCenterIn
    have hz_one : ((z : ↥S) : G) = 1 := by simpa using hzBot
    exact Subtype.ext hz_one
  · intro hz
    rw [Subgroup.mem_bot] at hz
    simp [hz]

/-- If `S` is a non-trivial finite `p`-group, then `Z(J(S)) ≠ 1`. -/
theorem centerIn_thompsonSubgroup_ne_bot_of_isPGroup_ne_bot {p : ℕ} [Fact p.Prime]
    {S : Subgroup G} [Finite ↥S] (hSp : IsPGroup p S) (hSne : S ≠ ⊥) :
    centerIn (G := G) (thompsonSubgroup S) ≠ ⊥ := by
  classical
  have hcenterS_ne_bot : centerIn (G := G) S ≠ ⊥ :=
    centerIn_ne_bot_of_isPGroup_ne_bot (G := G) (p := p) hSp hSne
  have hJ_le_S : thompsonSubgroup S ≤ S :=
    thompsonSubgroup_le_local (G := G) S
  have hcenterS_le_centerJ :
      centerIn (G := G) S ≤ centerIn (G := G) (thompsonSubgroup S) := by
    intro z hz
    refine ⟨centerIn_le_thompsonSubgroup (G := G) S hz, ?_⟩
    exact (Subgroup.mem_centralizer_iff
      (g := z) (s := ((thompsonSubgroup S : Subgroup G) : Set G))).2 <| by
      intro y hy
      exact (Subgroup.mem_centralizer_iff.mp hz.2) y (hJ_le_S hy)
  intro hcenterJ_bot
  exact hcenterS_ne_bot
    (le_bot_iff.mp (hcenterS_le_centerJ.trans (le_of_eq hcenterJ_bot)))

/-- The Thompson subgroup commutes with the subgroup map. -/
private theorem thompsonSubgroup_top_map_subtype (S : Subgroup G) :
    (thompsonSubgroup (G := S) (⊤ : Subgroup S)).map S.subtype = thompsonSubgroup (G := G) S := by
  classical
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    refine sSup_le ?_
    intro A hA
    exact (Subgroup.map_le_iff_le_comap).mp <| le_sSup <| by
      refine ⟨?_, ?_, ?_⟩
      · simpa using (Subgroup.map_subtype_le (H := S) (K := A))
      · let : IsMulCommutative A := hA.2.1
        exact Subgroup.map_isMulCommutative (H := A) S.subtype
      · intro B hB hBcomm
        let B' : Subgroup S := B.subgroupOf S
        have hAmax := hA.2.2 B' (by simp) (by
          let : IsMulCommutative B := hBcomm
          infer_instance)
        calc
          Nat.card B = Nat.card B' := by
            simpa [B', Subgroup.map_subgroupOf_eq_of_le hB] using
              (Subgroup.card_subtype S B')
          _ ≤ Nat.card A := hAmax
          _ = Nat.card (A.map S.subtype) := by
            symm
            exact Subgroup.card_map_of_injective (K := A) S.subtype_injective
  · refine sSup_le ?_
    intro A hA
    have hAin :
        A.subgroupOf S ∈ thompsonAbelianSubgroups (G := S) (⊤ : Subgroup S) := by
      refine ⟨by simp, ?_, ?_⟩
      · let : IsMulCommutative A := hA.2.1
        infer_instance
      · intro B hB hBcomm
        have hAmax := hA.2.2 (B.map S.subtype) (by
          simpa using (Subgroup.map_subtype_le (H := S) (K := B))) (by
            exact Subgroup.map_isMulCommutative (H := B) S.subtype)
        calc
          Nat.card B = Nat.card (B.map S.subtype) := by
            symm
            exact Subgroup.card_subtype S B
      _ ≤ Nat.card A := hAmax
      _ = Nat.card (A.subgroupOf S) := by
            simpa [Subgroup.map_subgroupOf_eq_of_le hA.1] using
              (Subgroup.card_subtype S (A.subgroupOf S))
    calc
      A = (A.subgroupOf S).map S.subtype := by
        rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.2 hA.1]
      _ ≤ (thompsonSubgroup (G := S) (⊤ : Subgroup S)).map S.subtype := by
        exact Subgroup.map_mono (le_sSup hAin)

/-- `centerIn` commutes with the subgroup map. -/
private theorem centerIn_top_map_subtype (S : Subgroup G) (H : Subgroup S) :
    (centerIn (G := S) H).map S.subtype = centerIn (G := G) (H.map S.subtype) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hyH : y ∈ H := hy.1
    have hyC : y ∈ Subgroup.centralizer (H : Set S) := hy.2
    refine ⟨Subgroup.mem_map_of_mem S.subtype hyH, ?_⟩
    show ∀ h ∈ (H.map S.subtype : Set G), h * S.subtype y = S.subtype y * h
    intro z hz
    rcases Subgroup.mem_map.mp hz with ⟨w, hw, rfl⟩
    exact congrArg S.subtype ((Subgroup.mem_centralizer_iff.mp hyC) _ hw)
  · intro hx
    rcases Subgroup.mem_map.mp hx.1 with ⟨y, hy, rfl⟩
    refine Subgroup.mem_map.mpr ⟨y, ⟨hy, ?_⟩, rfl⟩
    have hxC : S.subtype y ∈ Subgroup.centralizer (H.map S.subtype : Set G) := hx.2
    show ∀ h ∈ (H : Set S), h * y = y * h
    intro z hz
    have hzmap : S.subtype z ∈ H.map S.subtype := Subgroup.mem_map_of_mem S.subtype hz
    exact S.subtype_injective <| by
      simpa using (Subgroup.mem_centralizer_iff.mp hxC) _ hzmap

/-- `Z(J(⊤))` inside a subgroup maps to `Z(J(S))` in the ambient group. -/
private theorem thompsonCenter_top_map_subtype (S : Subgroup G) :
    (thompsonCenter (G := S) (⊤ : Subgroup S)).map S.subtype = thompsonCenter (G := G) S := by
  calc
    (thompsonCenter (G := S) (⊤ : Subgroup S)).map S.subtype
        = (centerIn (G := S) (thompsonSubgroup (G := S) (⊤ : Subgroup S))).map S.subtype := rfl
    _ = centerIn (G := G) ((thompsonSubgroup (G := S) (⊤ : Subgroup S)).map S.subtype) :=
      centerIn_top_map_subtype S (thompsonSubgroup (G := S) (⊤ : Subgroup S))
    _ = thompsonCenter (G := G) S := by
      rw [thompsonSubgroup_top_map_subtype]
      rfl

/-- `centerIn` commutes with an isomorphism between groups. -/
private theorem centerIn_map_mulEquiv {H : Type u} [Group H] (e : G ≃* H) (J : Subgroup G) :
    (centerIn (G := G) J).map e.toMonoidHom = centerIn (G := H) (J.map e.toMonoidHom) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨Subgroup.mem_map_of_mem e.toMonoidHom hy.1, ?_⟩
    show ∀ h ∈ (J.map e.toMonoidHom : Set H), h * e y = e y * h
    intro z hz
    rcases Subgroup.mem_map.mp hz with ⟨w, hw, rfl⟩
    simpa [map_mul] using congrArg e ((Subgroup.mem_centralizer_iff.mp hy.2) _ hw)
  · intro hx
    rcases Subgroup.mem_map.mp hx.1 with ⟨y, hy, rfl⟩
    refine Subgroup.mem_map.mpr ⟨y, ⟨hy, ?_⟩, rfl⟩
    show ∀ h ∈ (J : Set G), h * y = y * h
    intro z hz
    have hzmap : e z ∈ J.map e.toMonoidHom := Subgroup.mem_map_of_mem e.toMonoidHom hz
    exact e.injective <| by
      simpa [map_mul] using (Subgroup.mem_centralizer_iff.mp hx.2) _ hzmap

/-- The Thompson subgroup commutes with an isomorphism between groups. -/
private theorem thompsonSubgroup_top_map_mulEquiv {H : Type u} [Group H] (e : G ≃* H) :
    (thompsonSubgroup (G := G) (⊤ : Subgroup G)).map e.toMonoidHom =
      thompsonSubgroup (G := H) (⊤ : Subgroup H) := by
  classical
  have himage :
      (MulEquiv.mapSubgroup e) '' thompsonAbelianSubgroups (G := G) (⊤ : Subgroup G) =
        thompsonAbelianSubgroups (G := H) (⊤ : Subgroup H) := by
    ext A
    constructor
    · rintro ⟨B, hB, rfl⟩
      refine ⟨by simp, ?_, ?_⟩
      · let : IsMulCommutative B := hB.2.1
        exact Subgroup.map_isMulCommutative (H := B) e.toMonoidHom
      · intro C _ hCcomm
        have hBmax := hB.2.2 (C.map e.symm.toMonoidHom) (by simp) (by
          let : IsMulCommutative C := hCcomm
          exact Subgroup.map_isMulCommutative (H := C) e.symm.toMonoidHom)
        calc
          Nat.card C = Nat.card (C.map e.symm.toMonoidHom) := by
            symm
            exact Subgroup.card_map_of_injective (K := C) e.symm.injective
          _ ≤ Nat.card B := hBmax
          _ = Nat.card (B.map e.toMonoidHom) := by
            symm
            exact Subgroup.card_map_of_injective (K := B) e.injective
    · intro hA
      refine ⟨A.map e.symm.toMonoidHom, ?_, ?_⟩
      · refine ⟨by simp, ?_, ?_⟩
        · let : IsMulCommutative A := hA.2.1
          exact Subgroup.map_isMulCommutative (H := A) e.symm.toMonoidHom
        · intro C _ hCcomm
          have hAmax := hA.2.2 (C.map e.toMonoidHom) (by simp) (by
            let : IsMulCommutative C := hCcomm
            exact Subgroup.map_isMulCommutative (H := C) e.toMonoidHom)
          calc
            Nat.card C = Nat.card (C.map e.toMonoidHom) := by
              symm
              exact Subgroup.card_map_of_injective (K := C) e.injective
            _ ≤ Nat.card A := hAmax
            _ = Nat.card (A.map e.symm.toMonoidHom) := by
              symm
              exact Subgroup.card_map_of_injective (K := A) e.symm.injective
      · ext x
        simp
  calc
    (thompsonSubgroup (G := G) (⊤ : Subgroup G)).map e.toMonoidHom
        = (MulEquiv.mapSubgroup e) (sSup (thompsonAbelianSubgroups (G := G) (⊤ : Subgroup G))) := rfl
    _ = sSup ((MulEquiv.mapSubgroup e) '' thompsonAbelianSubgroups (G := G) (⊤ : Subgroup G)) := by
      simp
    _ = thompsonSubgroup (G := H) (⊤ : Subgroup H) := by
      simpa [thompsonSubgroup] using congrArg sSup himage

/-- `Z(J(⊤))` commutes with an isomorphism between groups. -/
private theorem thompsonCenter_top_map_mulEquiv {H : Type u} [Group H] (e : G ≃* H) :
    (thompsonCenter (G := G) (⊤ : Subgroup G)).map e.toMonoidHom =
      thompsonCenter (G := H) (⊤ : Subgroup H) := by
  calc
    (thompsonCenter (G := G) (⊤ : Subgroup G)).map e.toMonoidHom
        = centerIn (G := H) ((thompsonSubgroup (G := G) (⊤ : Subgroup G)).map e.toMonoidHom) := by
          exact centerIn_map_mulEquiv e (thompsonSubgroup (G := G) (⊤ : Subgroup G))
    _ = thompsonCenter (G := H) (⊤ : Subgroup H) := by
          rw [thompsonSubgroup_top_map_mulEquiv]
          rfl

/-- The Thompson subgroup of the image of a subgroup under an automorphism. -/
private theorem thompsonSubgroup_map_mulEquiv (e : G ≃* G) (P : Subgroup G) :
    thompsonSubgroup (P.map e.toMonoidHom) = (thompsonSubgroup P).map e.toMonoidHom := by
  classical
  let φ : ↥P ≃* ↥(P.map e.toMonoidHom) :=
    Subgroup.equivMapOfInjective P e.toMonoidHom e.injective
  have h1 : thompsonSubgroup (P.map e.toMonoidHom) =
      Subgroup.map (P.map e.toMonoidHom).subtype
        (thompsonSubgroup (⊤ : Subgroup ↥(P.map e.toMonoidHom))) := by
    simpa using (thompsonSubgroup_top_map_subtype (G := G) (S := P.map e.toMonoidHom)).symm
  have h2 : thompsonSubgroup (⊤ : Subgroup ↥(P.map e.toMonoidHom)) =
      (thompsonSubgroup (⊤ : Subgroup ↥P)).map φ.toMonoidHom := by
    exact (thompsonSubgroup_top_map_mulEquiv (G := ↥P) (H := ↥(P.map e.toMonoidHom)) φ).symm
  have h3 : Subgroup.map (P.map e.toMonoidHom).subtype
        ((thompsonSubgroup (⊤ : Subgroup ↥P)).map φ.toMonoidHom) =
      (thompsonSubgroup (⊤ : Subgroup ↥P)).map
        ((P.map e.toMonoidHom).subtype.comp φ.toMonoidHom) := by
    rw [Subgroup.map_map]
  have h4 : (thompsonSubgroup (⊤ : Subgroup ↥P)).map
        ((P.map e.toMonoidHom).subtype.comp φ.toMonoidHom) =
      (thompsonSubgroup (⊤ : Subgroup ↥P)).map (e.toMonoidHom.comp P.subtype) := by
    rfl
  rw [h1, h2, h3, h4]
  rw [← Subgroup.map_map]
  rw [thompsonSubgroup_top_map_subtype]

/-- `Z(J(P))` commutes with an automorphism of the ambient group. -/
private theorem thompsonCenter_map_mulEquiv (e : G ≃* G) (P : Subgroup G) :
    thompsonCenter (P.map e.toMonoidHom) = (thompsonCenter P).map e.toMonoidHom := by
  classical
  let φ : ↥P ≃* ↥(P.map e.toMonoidHom) :=
    Subgroup.equivMapOfInjective P e.toMonoidHom e.injective
  have h1 : thompsonCenter (P.map e.toMonoidHom) =
      Subgroup.map (P.map e.toMonoidHom).subtype
        (thompsonCenter (⊤ : Subgroup ↥(P.map e.toMonoidHom))) := by
    simpa using (thompsonCenter_top_map_subtype (G := G) (S := P.map e.toMonoidHom)).symm
  have h2 : thompsonCenter (⊤ : Subgroup ↥(P.map e.toMonoidHom)) =
      (thompsonCenter (⊤ : Subgroup ↥P)).map φ.toMonoidHom := by
    exact (thompsonCenter_top_map_mulEquiv (G := ↥P) (H := ↥(P.map e.toMonoidHom)) φ).symm
  have h3 : Subgroup.map (P.map e.toMonoidHom).subtype
        ((thompsonCenter (⊤ : Subgroup ↥P)).map φ.toMonoidHom) =
      (thompsonCenter (⊤ : Subgroup ↥P)).map
        ((P.map e.toMonoidHom).subtype.comp φ.toMonoidHom) := by
    rw [Subgroup.map_map]
  have h4 : (thompsonCenter (⊤ : Subgroup ↥P)).map
        ((P.map e.toMonoidHom).subtype.comp φ.toMonoidHom) =
      (thompsonCenter (⊤ : Subgroup ↥P)).map (e.toMonoidHom.comp P.subtype) := by
    rfl
  rw [h1, h2, h3, h4]
  rw [← Subgroup.map_map]
  rw [thompsonCenter_top_map_subtype]

/-- `Z(J(P))` commutes with a homomorphism that is injective on `P`. -/
theorem thompsonCenter_map_of_injective_on {H : Type u} [Group H]
    (f : G →* H) (P : Subgroup G) (hf : Function.Injective (f.comp P.subtype)) :
    thompsonCenter (P.map f) = (thompsonCenter P).map f := by
  classical
  let fP : ↑P →* ↑(P.map f) :=
    (f.comp P.subtype).codRestrict (P.map f) (fun x =>
      Subgroup.mem_map.mpr ⟨x, x.property, rfl⟩)
  have hfP : Function.Injective fP := by
    intro x y hxy
    exact hf (congrArg Subtype.val hxy)
  have hfP_surjective : Function.Surjective fP := by
    intro y
    rcases y.property with ⟨x, hxP, hxy⟩
    exact ⟨⟨x, hxP⟩, Subtype.ext hxy⟩
  let φ : ↑P ≃* ↑(P.map f) := MulEquiv.ofBijective fP ⟨hfP, hfP_surjective⟩
  have h1 : thompsonCenter (P.map f) =
      Subgroup.map (P.map f).subtype
        (thompsonCenter (⊤ : Subgroup ↑(P.map f))) := by
    simpa using (thompsonCenter_top_map_subtype (G := H) (S := P.map f)).symm
  have h2 : thompsonCenter (⊤ : Subgroup ↑(P.map f)) =
      (thompsonCenter (⊤ : Subgroup ↑P)).map φ.toMonoidHom := by
    exact (thompsonCenter_top_map_mulEquiv (G := ↑P) (H := ↑(P.map f)) φ).symm
  have h3 : Subgroup.map (P.map f).subtype
        ((thompsonCenter (⊤ : Subgroup ↑P)).map φ.toMonoidHom) =
      (thompsonCenter (⊤ : Subgroup ↑P)).map
        ((P.map f).subtype.comp φ.toMonoidHom) := by
    rw [Subgroup.map_map]
  have h4 : (P.map f).subtype.comp φ.toMonoidHom = f.comp P.subtype := by
    ext x
    rfl
  rw [h1, h2, h3, h4]
  rw [← Subgroup.map_map]
  rw [thompsonCenter_top_map_subtype]

/-! ## Characteristic functors (paper §5, properties (a)–(c)) -/

/-- A *characteristic functor* on the class of (finite) `p`-groups, in the sense of
[6, §5, p. 1116]: a family `K` assigning to every subgroup `P` of every ambient group
`H` a subgroup `K P` such that

  (a) `K P ≤ P` for all `P`;
  (b) if `P` is a finite `p`-group with `|P| > 1`, then `|K P| > 1` (stated here as
      `P ≠ ⊥ → K P ≠ ⊥`, equivalent for finite `P`);
  (c) `K` commutes with isomorphisms: if a homomorphism `f` is injective on `P`,
      then `K (P.map f) = (K P).map f`.  Conjugation invariance is retained as a
      dedicated field for the common ambient-automorphism use case.

The functor is defined on *all* subgroups of any ambient group (not only finite
`p`-groups), which is needed to instantiate it on subquotients later; the axioms are
only ever applied to finite `p`-subgroups.  The ZJ functor `K(P) = Z(J(P))` is an
instance: see `zjCharacteristicFunctor`. -/
public structure CharacteristicFunctor (p : ℕ) : Type (u + 1) where
  K : {H : Type u} → [Group H] → Subgroup H → Subgroup H
  K_le : ∀ {H : Type u} [Group H] (P : Subgroup H), K P ≤ P
  K_nontrivial : ∀ {H : Type u} [Group H] (P : Subgroup H),
    [Finite ↥P] → IsPGroup p P → P ≠ ⊥ → K P ≠ ⊥
  K_map : ∀ {H H' : Type u} [Group H] [Group H'] (f : H →* H') (P : Subgroup H),
    Function.Injective (f.comp P.subtype) → K (P.map f) = (K P).map f
  K_conj : ∀ {H : Type u} [Group H] (P : Subgroup H) (g : H),
    K (P.map (MulAut.conj g).toMonoidHom) = (K P).map (MulAut.conj g).toMonoidHom

/-- The ZJ functor `K(P) = Z(J(P))` ([6], §5: "Let `K` be the characteristic functor
given by `K(P) = Z(J(P))`"), as a family on all ambient groups. -/
@[expose]
public def zjFunctor {H : Type u} [Group H] (P : Subgroup H) : Subgroup H :=
  thompsonCenter (G := H) P

/-- The ZJ functor is a characteristic functor: (a) `Z(J(P)) ≤ P`; (b) for a
non-trivial finite `p`-group `P`, `Z(J(P)) ≠ 1` (the center of the Thompson subgroup
is non-trivial, as `J(P)` is a non-trivial `p`-group); (c) `Z(J(P^g)) = Z(J(P))^g`. -/
@[expose]
public def zjCharacteristicFunctor (p : ℕ) [Fact p.Prime] : CharacteristicFunctor p where
  K := zjFunctor
  K_le := by
    intro H _ P
    exact thompsonCenter_le_local (G := H) P
  K_nontrivial := by
    intro H _ P hfinite hPp hPne
    let : Finite ↥P := hfinite
    exact centerIn_thompsonSubgroup_ne_bot_of_isPGroup_ne_bot (G := H) (p := p) hPp hPne
  K_map := by
    intro H H' _ _ f P hf
    exact thompsonCenter_map_of_injective_on (G := H) (H := H') f P hf
  K_conj := by
    intro H _ P g
    exact thompsonCenter_map_mulEquiv (G := H) (MulAut.conj g) P

/-! ## The conditions `(C_p)` and `(C_p*)` (paper §5) -/

variable {G : Type u} [Group G]

/-- The conjugate `W^g = {g⁻¹wg | w ∈ W}` of a subgroup `W` of `G`
([6], §2, p. 1102: "For every `x ∈ G` and every element or subset `y` of `G`, let
`y^x = x⁻¹yx`"). -/
@[expose]
public def conjSubgroup (g : G) (W : Subgroup G) : Subgroup G :=
  W.map (MulAut.conj g⁻¹).toMonoidHom

/-- `Z(S)`, the centre of the subgroup `S`, viewed in the ambient group `G`
(paper's `Z(S)`; equal to `(Subgroup.center S).map S.subtype`). -/
@[expose]
public def Zsub (S : Subgroup G) : Subgroup G :=
  centerIn (G := G) S

/-- The set-conjugate `conjSubset g W` and the subgroup-conjugate `conjSubgroup g W`
coincide as sets. -/
public theorem conjSubset_eq_conjSubgroup (g : G) (W : Subgroup G) :
    conjSubset g (W : Set G) = (conjSubgroup g W : Set G) := by
  ext x
  constructor
  · rintro ⟨w, hw, rfl⟩
    exact Subgroup.mem_map.mpr ⟨w, hw, by simp⟩
  · rintro ⟨w, hw, rfl⟩
    exact ⟨w, hw, by simp⟩

/-- Composition of conjugation: `(W^a)^b = W^(a·b)`. -/
public theorem conjSubset_comp (a b : G) (W : Set G) :
    conjSubset b (conjSubset a W) = conjSubset (a * b) W := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    rcases hy with ⟨w, hw, rfl⟩
    refine ⟨w, hw, ?_⟩
    group
  · rintro ⟨w, hw, rfl⟩
    refine ⟨a⁻¹ * w * a, ⟨w, hw, rfl⟩, ?_⟩
    group

/-- Composition of conjugation for subgroups: `(W^a)^b = W^(a·b)`. -/
public theorem conjSubgroup_comp (a b : G) (W : Subgroup G) :
    conjSubgroup b (conjSubgroup a W) = conjSubgroup (a * b) W := by
  rw [conjSubgroup, conjSubgroup, conjSubgroup, Subgroup.map_map]
  congr 1
  ext x
  simp [mul_assoc]

/-- Membership in the centralizer of a conjugate:
`x ∈ C(W^m) ↔ m·x·m⁻¹ ∈ C(W)` ([6], §5, Lemma 5.1 proof:
"`mcm⁻¹ = c^{m⁻¹} ∈ C(W^m)^{m⁻¹} = C(W)`"). -/
public theorem mem_centralizer_conj_iff (m x : G) (W : Set G) :
    x ∈ Subgroup.centralizer (conjSubset m W) ↔ m * x * m⁻¹ ∈ Subgroup.centralizer W := by
  constructor
  · intro hx
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    have hcomm := (Subgroup.mem_centralizer_iff.mp hx) (m⁻¹ * w * m) (by
      refine ⟨w, hw, ?_⟩
      group)
    calc
      w * (m * x * m⁻¹) = m * ((m⁻¹ * w * m) * x) * m⁻¹ := by group
      _ = m * (x * (m⁻¹ * w * m)) * m⁻¹ := by rw [← hcomm]
      _ = (m * x * m⁻¹) * w := by group
  · intro hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rcases hy with ⟨w, hw, rfl⟩
    have hcomm := (Subgroup.mem_centralizer_iff.mp hx) w hw
    calc
      (m⁻¹ * w * m) * x = m⁻¹ * (w * (m * x * m⁻¹)) * m := by group
      _ = m⁻¹ * ((m * x * m⁻¹) * w) * m := by rw [hcomm]
      _ = x * (m⁻¹ * w * m) := by group

variable [Finite G] {p : ℕ} [Fact p.Prime]

omit [Finite G] [Fact (Nat.Prime p)] in
/-- `S ≤ N_G(K(S))` for a Sylow `p`-subgroup `S` of a finite group and a
characteristic functor `K`: `K(S)` is characteristic in `S` by axiom (c), so `S`
normalizes it. -/
public theorem sylow_le_normalizer_K (K : CharacteristicFunctor p) (S : Sylow p G) :
    (S : Subgroup G) ≤ Subgroup.normalizer ((K.K (S : Subgroup G) : Subgroup G) : Set G) := by
  intro s hs
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  have hmap : (S : Subgroup G).map (MulAut.conj s).toMonoidHom = (S : Subgroup G) :=
    (Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (Subgroup.le_normalizer (H := (S : Subgroup G)) hs))
  calc
    (K.K (S : Subgroup G)).map (MulAut.conj s).toMonoidHom
        = K.K ((S : Subgroup G).map (MulAut.conj s).toMonoidHom) := by
          exact (K.K_conj (P := (S : Subgroup G)) (g := s)).symm
    _ = K.K (S : Subgroup G) := by rw [hmap]

/-- Condition `(C_p)` of [6, §5, p. 1116] for the ambient group `G` with respect to a
Sylow `p`-subgroup `S` and a characteristic functor `K`: for every non-empty subset
`W` of `S` and every `g ∈ G` with `W^g ⊆ S`, there exist `c ∈ C_G(W)` and
`n ∈ N_G(K(S))` with `g = cn`.  This is the set form, matching the shape of the
wrapper's `theoremB`. -/
@[expose]
public def Cp (K : CharacteristicFunctor p) (S : Sylow p G) : Prop :=
  ∀ W : Set G, W.Nonempty → W ⊆ (S : Subgroup G) →
    ∀ g : G, conjSubset g W ⊆ (S : Subgroup G) →
      ∃ c n : G,
        c ∈ Subgroup.centralizer W ∧
          n ∈ Subgroup.normalizer ((K.K (S : Subgroup G) : Subgroup G) : Set G) ∧
            g = c * n

/-- The subgroup form of `(C_p)`: `W` ranges over the `p`-subgroups of `S`. -/
@[expose]
public def CpSubgroup (K : CharacteristicFunctor p) (S : Sylow p G) : Prop :=
  ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
    ∀ g : G, conjSubgroup g W ≤ (S : Subgroup G) →
      ∃ c n : G,
        c ∈ Subgroup.centralizer (W : Set G) ∧
          n ∈ Subgroup.normalizer ((K.K (S : Subgroup G) : Subgroup G) : Set G) ∧
            g = c * n

/-- Condition `(C_p*)` of [6, §5, p. 1116]: `W` is a `p`-subgroup of
`N = N_G(K(S))`, `g ∈ G`, and `W^g ⊆ N`; then `g = cn` with `c ∈ C_G(W)` and
`n ∈ N`. -/
@[expose]
public def CpStar (K : CharacteristicFunctor p) (S : Sylow p G) : Prop :=
  let N : Subgroup G := Subgroup.normalizer ((K.K (S : Subgroup G) : Subgroup G) : Set G)
  ∀ W : Subgroup G, IsPGroup p W → W ≤ N →
    ∀ g : G, conjSubgroup g W ≤ N →
      ∃ c n : G,
        c ∈ Subgroup.centralizer (W : Set G) ∧ n ∈ N ∧ g = c * n

/-- The group `H` satisfies `(C_p)` (for every Sylow `p`-subgroup of `H`).  This is
the meaning of "`N(H)` satisfies `(C_p)`" in Theorem 5.1 (a); since `(C_p)` is
invariant under conjugating the Sylow subgroup, this is equivalent to "some Sylow
`p`-subgroup of `H` satisfies `(C_p)`". -/
@[expose]
public def SatisfiesCp (K : CharacteristicFunctor p) (H : Type u) [Group H] [Finite H] : Prop :=
  ∀ S : Sylow p H, Cp (G := H) K S

omit [Finite G] [Fact (Nat.Prime p)] in
/-- From `(C_p)` (set form) the subgroup form follows by viewing `W` as a set. -/
public theorem cpSubgroup_of_cp (K : CharacteristicFunctor p) (S : Sylow p G) :
    Cp K S → CpSubgroup K S := by
  intro hS W hWp hWleS g hWg
  rcases hS (W : Set G) ⟨1, W.one_mem⟩ hWleS g (by
    intro x hx
    exact hWg (by simpa [conjSubset_eq_conjSubgroup] using hx)) with ⟨c, n, hc, hn, hg⟩
  exact ⟨c, n, hc, hn, hg⟩

omit [Finite G] [Fact (Nat.Prime p)] in
/-- From `(C_p*)` we get `(C_p)` by replacing a non-empty subset `W` of `S` with the
subgroup `⟨W⟩ ≤ S` that it generates (a `p`-subgroup), using `C_G(W) = C_G(⟨W⟩)`
([6], §5, p. 1116: "Suppose that `V` is a non-empty subset of `S` and `W` is the
subgroup of `S` generated by `V` ... Since `C(V) = C(W)`"). -/
public theorem cp_of_cpStar (K : CharacteristicFunctor p) (S : Sylow p G) :
    CpStar K S → Cp K S := by
  intro hStar W hWne hWleS g hWg
  let W' : Subgroup G := Subgroup.closure W
  have hW'_le_S : W' ≤ (S : Subgroup G) := (Subgroup.closure_le (K := (S : Subgroup G))).mpr hWleS
  have hW'p : IsPGroup p W' := IsPGroup.to_le S.isPGroup' hW'_le_S
  have hW'g_le_S : conjSubgroup g W' ≤ (S : Subgroup G) := by
    rw [conjSubgroup, MonoidHom.map_closure]
    refine (Subgroup.closure_le (K := (S : Subgroup G))).mpr ?_
    intro x hx
    rcases hx with ⟨w, hw, rfl⟩
    exact hWg ⟨w, hw, by simp⟩
  let N : Subgroup G := Subgroup.normalizer ((K.K (S : Subgroup G) : Subgroup G) : Set G)
  have hS_le_N : (S : Subgroup G) ≤ N := sylow_le_normalizer_K K S
  rcases hStar W' hW'p (hW'_le_S.trans hS_le_N) g (hW'g_le_S.trans hS_le_N)
    with ⟨c, n, hc, hn, hg⟩
  refine ⟨c, n, ?_, hn, hg⟩
  exact (Subgroup.centralizer_le (show W ⊆ (W' : Set G) from Subgroup.subset_closure)) hc

omit [Finite G] [Fact (Nat.Prime p)] in
/-- The conjugation action of an element `m` on a Sylow subgroup, viewed as a
subgroup, is conjugation by the element `m`:
`(m • P) = P.map (MulAut.conj m)`. -/
public theorem sylow_smul_subgroup_eq_map_conj (m : G) (P : Sylow p G) :
    ((m • P : Sylow p G) : Subgroup G) = (P : Subgroup G).map (MulAut.conj (m : G)).toMonoidHom := by
  ext x
  rw [Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, MulAut.smul_def]
  rw [Subgroup.mem_map]
  constructor
  · intro hx
    refine ⟨(MulAut.conj m)⁻¹ x, hx, ?_⟩
    simp
    group
  · rintro ⟨y, hy, rfl⟩
    convert hy using 1
    simp
    group

omit [Finite G] in
/-- The conjugate inside a subgroup `N` of a subgroup `W ≤ N`, pushed back to `G`,
is the conjugate in `G`. -/
public theorem map_subtype_map_conj (N : Subgroup G) (W : Subgroup G) (hW_le_N : W ≤ N) (m : ↥N) :
    ((W.subgroupOf N).map (MulAut.conj (m : ↥N)).toMonoidHom).map N.subtype =
      W.map (MulAut.conj (m : G)).toMonoidHom := by
  apply le_antisymm
  · intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    rcases Subgroup.mem_map.mp hy with ⟨w, hw, rfl⟩
    refine Subgroup.mem_map.mpr ⟨(w : G), (Subgroup.mem_subgroupOf.mp hw), ?_⟩
    change (MulAut.conj (m : G)) (w : G) = N.subtype ((MulAut.conj (m : ↥N)) w)
    simp
  · intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨w, hw, rfl⟩
    refine Subgroup.mem_map.mpr ⟨
      (MulAut.conj (m : ↥N)) (⟨w, hW_le_N hw⟩ : ↥N), ?_, ?_⟩
    · refine Subgroup.mem_map.mpr ⟨⟨w, hW_le_N hw⟩, (Subgroup.mem_subgroupOf.mpr hw), rfl⟩
    · change N.subtype ((MulAut.conj (m : ↥N)) (⟨w, hW_le_N hw⟩ : ↥N)) =
        (MulAut.conj (m : G)) w
      simp

/-! ## Lemma 5.1: `(C_p)` and `(C_p*)` are equivalent -/

/-- Lemma 5.1 ([6], §5, Lemma 5.1, p. 1117): for a finite group `G`, a prime `p`,
and a characteristic functor `K`, the conditions `(C_p)` and `(C_p*)` are equivalent.
The proof follows the paper: `(C_p*) ⟹ (C_p)` is immediate (take `W' = ⟨W⟩ ≤ S`);
conversely, if `W` is a `p`-subgroup of `N = N_G(K(S))` with `W^g ⊆ N`, extend `W`
and `W^g` to Sylow `p`-subgroups of `N` and conjugate them into `S` by elements
`m, k ∈ N` (possible since `S` is a Sylow `p`-subgroup of `N`); then `(C_p)` applied
to the subset `W^m ⊆ S` and the element `m⁻¹gk` gives `c ∈ C(W^m)`, `n ∈ N` with
`m⁻¹gk = cn`, and `g = (mcm⁻¹)(mnk⁻¹)` with `mcm⁻¹ ∈ C(W)`. -/
public theorem lemma5_1 (K : CharacteristicFunctor p) (S : Sylow p G) :
    Cp K S ↔ CpStar K S := by
  constructor
  · intro hS
    let N : Subgroup G := Subgroup.normalizer ((K.K (S : Subgroup G) : Subgroup G) : Set G)
    have hS_le_N : (S : Subgroup G) ≤ N := sylow_le_normalizer_K K S
    let S' : Sylow p ↥N := S.subtype hS_le_N
    intro W hWp hW_le_N g hWg_le_N
    -- `W` is a `p`-subgroup of `N`; extend it to a Sylow `p`-subgroup of `N`.
    let W' : Subgroup ↥N := W.subgroupOf N
    have hW'p : IsPGroup p W' := hWp.of_equiv (Subgroup.subgroupOfEquivOfLe hW_le_N).symm
    obtain ⟨P, hW'_le_P⟩ := IsPGroup.exists_le_sylow (G := ↥N) (p := p) hW'p
    -- conjugate `P` onto `S'` by an element `m ∈ N`
    obtain ⟨m, hm⟩ := MulAction.exists_smul_eq (↥N) P S'
    have hW'm_le_S' : (W' : Subgroup ↥N).map (MulAut.conj (m : ↥N)).toMonoidHom ≤ S' := by
      calc
        (W' : Subgroup ↥N).map (MulAut.conj (m : ↥N)).toMonoidHom
            ≤ (P : Subgroup ↥N).map (MulAut.conj (m : ↥N)).toMonoidHom := by
              exact Subgroup.map_mono hW'_le_P
        _ = ((m • P : Sylow p ↥N) : Subgroup ↥N) := by
              exact (sylow_smul_subgroup_eq_map_conj (m : ↥N) P).symm
        _ = (S' : Subgroup ↥N) := by
              exact congrArg (fun Q : Sylow p ↥N => (Q : Subgroup ↥N)) hm
    -- in `G`: `W^{m⁻¹} ⊆ S` (paper's `W^m ⊆ S` with `m` replaced by `m⁻¹`)
    have hS'map : (S' : Subgroup ↥N).map N.subtype = (S : Subgroup G) := by
      rw [Sylow.coe_subtype]
      exact Subgroup.map_subgroupOf_eq_of_le hS_le_N
    have hWm_le_S : W.map (MulAut.conj (m : G)).toMonoidHom ≤ (S : Subgroup G) := by
      have h := Subgroup.map_mono (f := N.subtype) hW'm_le_S'
      rw [map_subtype_map_conj (N := N) (W := W) hW_le_N m, hS'map] at h
      exact h
    -- `W^g` is a `p`-subgroup of `N`; extend it to a Sylow `p`-subgroup of `N`
    let Wg' : Subgroup ↥N := (conjSubgroup g W).subgroupOf N
    have hWgp : IsPGroup p (conjSubgroup g W) := by
      exact IsPGroup.map (H := W) hWp (MulAut.conj (g⁻¹)).toMonoidHom
    have hWg'p : IsPGroup p Wg' := hWgp.of_equiv (Subgroup.subgroupOfEquivOfLe hWg_le_N).symm
    obtain ⟨Q, hWg'_le_Q⟩ := IsPGroup.exists_le_sylow (G := ↥N) (p := p) hWg'p
    obtain ⟨k, hk⟩ := MulAction.exists_smul_eq (↥N) Q S'
    have hWgk_le_S :
        (conjSubgroup g W).map (MulAut.conj (k : G)).toMonoidHom ≤ (S : Subgroup G) := by
      have h1 : (Wg' : Subgroup ↥N).map (MulAut.conj (k : ↥N)).toMonoidHom ≤ S' := by
        calc
          (Wg' : Subgroup ↥N).map (MulAut.conj (k : ↥N)).toMonoidHom
              ≤ (Q : Subgroup ↥N).map (MulAut.conj (k : ↥N)).toMonoidHom := by
                exact Subgroup.map_mono hWg'_le_Q
          _ = ((k • Q : Sylow p ↥N) : Subgroup ↥N) := by
                exact (sylow_smul_subgroup_eq_map_conj (k : ↥N) Q).symm
          _ = (S' : Subgroup ↥N) := by
                exact congrArg (fun Q : Sylow p ↥N => (Q : Subgroup ↥N)) hk
      have h2 := Subgroup.map_mono (f := N.subtype) h1
      rw [map_subtype_map_conj (N := N) (W := conjSubgroup g W) hWg_le_N k, hS'map] at h2
      exact h2
    -- now apply `(C_p)` to the subset `W^{m⁻¹} ⊆ S` and the element `(m⁻¹)⁻¹ g k⁻¹`
    let m0 : G := (m : G)⁻¹
    let k0 : G := (k : G)⁻¹
    have hm0_mem_N : m0 ∈ N := N.inv_mem (by exact (m : ↥N).2)
    have hk0_mem_N : k0 ∈ N := N.inv_mem (by exact (k : ↥N).2)
    -- `W^{m₀} ⊆ S` as a set
    have hWm0_le_S : conjSubset m0 (W : Set G) ⊆ (S : Subgroup G) := by
      intro x hx
      -- conjSubset m0 W = W.map (MulAut.conj m) [m0⁻¹ = m]
      have hx' : x ∈ (conjSubgroup m0 W : Set G) := by
        simpa [conjSubset_eq_conjSubgroup] using hx
      have hx'' : x ∈ W.map (MulAut.conj (m : G)).toMonoidHom := by
        simpa [conjSubgroup, m0] using hx'
      exact hWm_le_S hx''
    -- `(W^{m₀})^{m₀⁻¹gk₀} = W^{gk₀} ⊆ S`
    have hWgk0_le_S : conjSubset (g * k0) (W : Set G) ⊆ (S : Subgroup G) := by
      intro x hx
      have hx' : x ∈ (conjSubgroup (g * k0) W : Set G) := by
        simpa [conjSubset_eq_conjSubgroup] using hx
      -- conjSubgroup (g·k₀) W = (conjSubgroup g W).map (MulAut.conj k) [k₀⁻¹ = k]
      have hx'' : x ∈ (conjSubgroup g W).map (MulAut.conj (k : G)).toMonoidHom := by
        -- conjSubgroup (g * k0) W = W.map (conj ((g*k0)⁻¹)) — and (g*k0)⁻¹ = k0⁻¹ g⁻¹ = k g⁻¹ — hmm — conj k ∘ conj g⁻¹ = conj (g⁻¹·k)
        -- hmm — wait — (g·k₀)⁻¹ = k₀⁻¹·g⁻¹ = k·g⁻¹ — and conjSubgroup (g·k₀) W = W.map (conj (k·g⁻¹)) = W.map (conj k ∘ conj g⁻¹) = (W.map (conj g⁻¹)).map (conj k) = (conjSubgroup g W).map (conj k) ✓
        simpa [conjSubgroup, m0, k0, mul_assoc] using hx'
      exact hWgk_le_S hx''
    have hWgk0' : conjSubset (m0⁻¹ * g * k0) (conjSubset m0 (W : Set G)) ⊆ (S : Subgroup G) := by
      rw [conjSubset_comp]
      -- conjSubset (m0·(m0⁻¹·g·k0)) W = conjSubset (g·k0) W
      simpa [mul_assoc] using hWgk0_le_S
    have hnonempty : (conjSubset m0 (W : Set G)).Nonempty := by
      refine ⟨m0⁻¹ * 1 * m0, ⟨1, W.one_mem, ?_⟩⟩
      group
    rcases hS (conjSubset m0 (W : Set G)) hnonempty hWm0_le_S (m0⁻¹ * g * k0) hWgk0'
      with ⟨c, n, hc, hn, hg⟩
    -- `g = (m0·c·m0⁻¹)·(m0·n·k0⁻¹)` with `m0·c·m0⁻¹ ∈ C(W)` and `m0·n·k0⁻¹ ∈ N`
    refine ⟨m0 * c * m0⁻¹, m0 * n * k0⁻¹, ?_, ?_, ?_⟩
    · exact (mem_centralizer_conj_iff m0 c (W : Set G)).mp hc
    · exact N.mul_mem (N.mul_mem hm0_mem_N hn) (N.inv_mem hk0_mem_N)
    · calc
        g = m0 * (m0⁻¹ * g * k0) * k0⁻¹ := by group
        _ = m0 * (c * n) * k0⁻¹ := by rw [← hg]
        _ = (m0 * c * m0⁻¹) * (m0 * n * k0⁻¹) := by group
  · exact cp_of_cpStar K S

/-! ## Theorem 5.1 -/

/-- Hypothesis (a) of Theorem 5.1 ([6], §5, Theorem 5.1(a)): whenever
`Z(S₂) ≤ H ≤ S₂` for a Sylow `p`-subgroup `S₂` of `G`, the normalizer `N_G(H)`
satisfies `(C_p)`.  The paper states this for the fixed Sylow subgroup `S` and notes
("if `S` satisfies (a), then every Sylow `p`-subgroup of `G` satisfies (a)") that it
propagates to all Sylow `p`-subgroups; the statement below is the propagated form. -/
@[expose]
public def Theorem51HypA (p : ℕ) [Fact p.Prime] (G : Type u) [Group G] [Finite G] : Prop :=
  ∀ S₂ : Sylow p G, ∀ H : Subgroup G,
    Zsub (S₂ : Subgroup G) ≤ H → H ≤ (S₂ : Subgroup G) →
      SatisfiesCp (zjCharacteristicFunctor p) (↥(Subgroup.normalizer (H : Set G)))

/-- Hypothesis (b) of Theorem 5.1 ([6], §5, Theorem 5.1(b)): every element of
`M_p(G)` satisfies `(C_p)`. -/
@[expose]
public def Theorem51HypB (p : ℕ) [Fact p.Prime] (G : Type u) [Group G] [Finite G] : Prop :=
  ∀ M : Subgroup G, M ∈ MpSet p G → SatisfiesCp (zjCharacteristicFunctor p) ↥M

omit [Finite G] in
public theorem le_pCore_of_normal_isPGroup {p : ℕ} {N : Subgroup G} (hN : N.Normal)
    (hNp : IsPGroup p N) : N ≤ pCore p G := by
  unfold pCore
  exact le_sSup ⟨hN, hNp⟩

omit [Finite G] in
/-- The normal `p`-core is contained in every Sylow `p`-subgroup. -/
public theorem pCore_le_sylow {p : ℕ} [Fact p.Prime] (S : Sylow p G) :
    pCore p G ≤ (S : Subgroup G) := by
  have hsup : IsPGroup p (((S : Subgroup G) ⊔ pCore p G : Subgroup G)) :=
    IsPGroup.to_sup_of_normal_right S.isPGroup' (pCore_isPGroup (G := G) (p := p))
  have heq : (S : Subgroup G) ⊔ pCore p G = (S : Subgroup G) :=
    S.is_maximal' hsup le_sup_left
  exact sup_eq_left.mp heq

/-- If `S` is a Sylow `p`-subgroup of `G` and `N` is a normal subgroup of `G`, then
`S ∩ N` is a Sylow `p`-subgroup of `N`. -/


public theorem sylow_inf_normal (S : Sylow p G) {N : Subgroup G} [N.Normal] :
    ∃ P : Sylow p ↥N, (P : Subgroup ↥N) = ((S : Subgroup G) ⊓ N).subgroupOf N := by
  classical
  let P : Subgroup ↥N := ((S : Subgroup G) ⊓ N).subgroupOf N
  have hP1 : IsPGroup p P := by
    have hSn : IsPGroup p (↥((S : Subgroup G) ⊓ N)) := S.isPGroup'.to_inf_left
    exact hSn.of_equiv (Subgroup.subgroupOfEquivOfLe (H := (S : Subgroup G) ⊓ N) (K := N) inf_le_right).symm
  have hrel1 :
      ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) *
          (S : Subgroup G).relIndex ((S : Subgroup G) ⊔ N) =
        ((S : Subgroup G) ⊓ N).relIndex ((S : Subgroup G) ⊔ N) := by
    exact Subgroup.relIndex_mul_relIndex (H := (S : Subgroup G) ⊓ N)
      (K := (S : Subgroup G)) (L := (S : Subgroup G) ⊔ N) inf_le_left le_sup_left
  have hrel2 :
      ((S : Subgroup G) ⊓ N).relIndex N * N.relIndex ((S : Subgroup G) ⊔ N) =
        ((S : Subgroup G) ⊓ N).relIndex ((S : Subgroup G) ⊔ N) := by
    exact Subgroup.relIndex_mul_relIndex (H := (S : Subgroup G) ⊓ N) (K := N)
      (L := (S : Subgroup G) ⊔ N) inf_le_right le_sup_right
  have h2a : N.relIndex ((S : Subgroup G) ⊔ N) = N.relIndex (S : Subgroup G) :=
    Subgroup.relIndex_sup_right (H := (S : Subgroup G)) (K := N)
  have h2a' : N.relIndex (S : Subgroup G) = ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) := by
    exact (Subgroup.inf_relIndex_left (H := (S : Subgroup G)) (K := N)).symm
  have hrel2' :
      ((S : Subgroup G) ⊓ N).relIndex N * ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) =
        ((S : Subgroup G) ⊓ N).relIndex ((S : Subgroup G) ⊔ N) := by
    simpa [h2a, h2a'] using hrel2
  have hcanc : ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) ≠ 0 := by
    intro hz
    have hdvd : ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) ∣
        ((S : Subgroup G) ⊓ N).index :=
      Subgroup.relIndex_dvd_index_of_le (H := (S : Subgroup G) ⊓ N)
        (K := (S : Subgroup G)) inf_le_left
    have hSne : ((S : Subgroup G) ⊓ N).index ≠ 0 :=
      (Subgroup.finiteIndex_of_finite (H := (S : Subgroup G) ⊓ N)).index_ne_zero
    exact hSne (eq_zero_of_zero_dvd (by simpa [hz] using hdvd))
  have hrel : ((S : Subgroup G) ⊓ N).relIndex N =
      (S : Subgroup G).relIndex ((S : Subgroup G) ⊔ N) := by
    have h' : ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) *
          (S : Subgroup G).relIndex ((S : Subgroup G) ⊔ N) =
        ((S : Subgroup G) ⊓ N).relIndex N *
          ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) :=
      hrel1.trans hrel2'.symm
    have h'' : (S : Subgroup G).relIndex ((S : Subgroup G) ⊔ N) *
          ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) =
        ((S : Subgroup G) ⊓ N).relIndex N *
          ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G) := by
      simpa [mul_comm] using h'
    exact (Nat.mul_right_cancel (m := ((S : Subgroup G) ⊓ N).relIndex (S : Subgroup G))
      (mp := Nat.pos_of_ne_zero hcanc) h'').symm
  have hP2 : ¬ p ∣ P.index := by
    intro hp
    have hp' : p ∣ (S : Subgroup G).relIndex ((S : Subgroup G) ⊔ N) := by
      change p ∣ ((S : Subgroup G) ⊓ N).relIndex N at hp
      rwa [hrel] at hp
    have hdvd : (S : Subgroup G).relIndex ((S : Subgroup G) ⊔ N) ∣
        (S : Subgroup G).index :=
      Subgroup.relIndex_dvd_index_of_le (H := (S : Subgroup G))
        (K := (S : Subgroup G) ⊔ N) le_sup_left
    exact S.not_dvd_index (hp'.trans hdvd)
  exact ⟨hP1.toSylow hP2, rfl⟩

omit [Finite G] in
/-- Normalizer of a conjugate: `N(W^g) = (N(W))^{g⁻¹}` (in `conjSubgroup` terms:
`normalizer (conjSubgroup g W) = conjSubgroup g (normalizer W)`). -/

public theorem normalizer_conjSubgroup (g : G) (W : Subgroup G) :
    Subgroup.normalizer (conjSubgroup g W : Set G) =
      conjSubgroup g (Subgroup.normalizer (W : Set G)) := by
  unfold conjSubgroup
  rw [Subgroup.map_normalizer_eq_of_bijective (H := W) (f := (MulAut.conj g⁻¹).toMonoidHom)
    (hf := (MulAut.conj g⁻¹).bijective)]

omit [Finite G] in
/-- The subgroup of `N` equal to `H.subgroupOf N` maps to `H` under `N.subtype`. -/


public theorem map_subgroupOf_eq_of_le' {N : Subgroup G} {H : Subgroup G} (h : H ≤ N) :
    (H.subgroupOf N).map N.subtype = H := by
  exact Subgroup.map_subgroupOf_eq_of_le (H := H) (K := N) h

omit [Finite G] in
/-- Step IV of Theorem 5.1, given step (III): `G` satisfies `(C_p)` for every
`p`-subgroup `W ≤ S`. -/

theorem thompsonCenter_subgroupOf (N : Subgroup G) (T : Subgroup G) (hT_le_N : T ≤ N) :
    (thompsonCenter (G := ↥N) (T.subgroupOf N)).map N.subtype = thompsonCenter (G := G) T := by
  classical
  let φ : ↥(T.subgroupOf N) ≃* ↥T :=
    Subgroup.subgroupOfEquivOfLe (H := T) (K := N) hT_le_N
  have hcomp : N.subtype.comp (T.subgroupOf N).subtype = T.subtype.comp φ.toMonoidHom := by
    ext x
    rfl
  calc
    (thompsonCenter (G := ↥N) (T.subgroupOf N)).map N.subtype
        = ((thompsonCenter (G := ↥(T.subgroupOf N)) (⊤ : Subgroup ↥(T.subgroupOf N))).map
            (T.subgroupOf N).subtype).map N.subtype := by
            rw [thompsonCenter_top_map_subtype (G := ↥N) (S := T.subgroupOf N)]
    _ = (thompsonCenter (G := ↥(T.subgroupOf N)) (⊤)).map
          (N.subtype.comp (T.subgroupOf N).subtype) := by rw [Subgroup.map_map]
    _ = (thompsonCenter (G := ↥(T.subgroupOf N)) (⊤)).map
          (T.subtype.comp φ.toMonoidHom) := by rw [hcomp]
    _ = ((thompsonCenter (G := ↥(T.subgroupOf N)) (⊤)).map φ.toMonoidHom).map T.subtype := by
          rw [Subgroup.map_map]
    _ = (thompsonCenter (G := ↥T) (⊤ : Subgroup ↥T)).map T.subtype := by
          rw [thompsonCenter_top_map_mulEquiv (G := ↥(T.subgroupOf N)) (H := ↥T) φ]
    _ = thompsonCenter (G := G) T := by
          rw [thompsonCenter_top_map_subtype (G := G) (S := T)]

omit [Finite G] in
/-- Normalizer membership transfers across the inclusion of a subgroup `M`. -/


public theorem mem_normalizer_map_subtype_iff {M : Subgroup G} (H : Subgroup ↥M) (x : ↥M) :
    x ∈ Subgroup.normalizer (H : Set ↥M) ↔
      (x : G) ∈ Subgroup.normalizer ((H.map M.subtype : Subgroup G) : Set G) := by
  constructor
  · intro hx
    rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hx ⊢
    have h1 : (H.map M.subtype).map (MulAut.conj (x : G)).toMonoidHom =
        (H.map (MulAut.conj x).toMonoidHom).map M.subtype := by
      rw [Subgroup.map_map, Subgroup.map_map]
      congr 1
    calc
      (H.map M.subtype).map (MulAut.conj (x : G)).toMonoidHom
          = (H.map (MulAut.conj x).toMonoidHom).map M.subtype := h1
      _ = H.map M.subtype := by simp [hx]
  · intro hx
    rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hx ⊢
    have h1 : (H.map M.subtype).map (MulAut.conj (x : G)).toMonoidHom =
        (H.map (MulAut.conj x).toMonoidHom).map M.subtype := by
      rw [Subgroup.map_map, Subgroup.map_map]
      congr 1
    apply Subgroup.map_injective (f := M.subtype) M.subtype_injective
    exact h1.symm.trans hx

/-- The `M`-part of step (III): given a subgroup `M` of `G` containing `S` that satisfies
`(C_p)`, with `c ∈ M`, the conclusion of step (III) follows. -/


theorem step_III_M_part (S : Sylow p G) (W M : Subgroup G) (g : G)
    (a c n : G)
    (hW_le_S : W ≤ (S : Subgroup G))
    (ha_mem_CW : a ∈ Subgroup.centralizer (W : Set G))
    (hc_mem_M : c ∈ M)
    (hn_mem : n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G))
    (hcn : g⁻¹ * a = c * n)
    (hWp : IsPGroup p W)
    (hWg_le_S : conjSubgroup g W ≤ (S : Subgroup G))
    (hWg_le_M : conjSubgroup g W ≤ M)
    (hS_le_M : (S : Subgroup G) ≤ M)
    (hSleNZJ : (S : Subgroup G) ≤ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G))
    (hCpM : Cp (G := ↥M) (zjCharacteristicFunctor p) (S.subtype hS_le_M)) :
    ∃ c₀ n₀ : G, c₀ ∈ Subgroup.centralizer (W : Set G) ∧
      n₀ ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧ g = c₀ * n₀ := by
  classical
  let S_M : Sylow p ↥M := S.subtype hS_le_M
  have hmap : (ZJ (S_M : Subgroup ↥M) : Subgroup ↥M).map M.subtype = ZJ (S : Subgroup G) := by
    simpa [S_M, ZJ] using (thompsonCenter_subgroupOf (G := G) (N := M) (T := (S : Subgroup G)) hS_le_M)
  have hNM_eq : Subgroup.normalizer (ZJ (S_M : Subgroup ↥M) : Set ↥M) =
      (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).comap M.subtype := by
    ext x
    rw [mem_normalizer_map_subtype_iff (M := M) (H := ZJ (S_M : Subgroup ↥M)) (x := x)]
    rw [hmap]
    rfl
  have hW_le_NZJ : W ≤ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := hW_le_S.trans hSleNZJ
  have hWg_le_NZJ : conjSubgroup g W ≤ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) :=
    hWg_le_S.trans hSleNZJ
  let W_M : Subgroup ↥M := (conjSubgroup g W).subgroupOf M
  have hW_Mp : IsPGroup p W_M := by
    have hWgp : IsPGroup p (↥(conjSubgroup g W)) := by
      rw [conjSubgroup]
      exact IsPGroup.map (H := W) hWp (MulAut.conj g⁻¹).toMonoidHom
    exact hWgp.of_equiv (Subgroup.subgroupOfEquivOfLe (H := conjSubgroup g W) (K := M) hWg_le_M).symm
  have hW_M_le_NM : W_M ≤ Subgroup.normalizer (ZJ (S_M : Subgroup ↥M) : Set ↥M) := by
    rw [hNM_eq]
    rw [← Subgroup.map_le_iff_le_comap]
    rw [map_subgroupOf_eq_of_le' hWg_le_M]
    exact hWg_le_NZJ
  let g_M : ↥M := ⟨c, hc_mem_M⟩
  have hconjWg_M_le_NM : conjSubgroup g_M W_M ≤ Subgroup.normalizer (ZJ (S_M : Subgroup ↥M) : Set ↥M) := by
    rw [hNM_eq]
    rw [← Subgroup.map_le_iff_le_comap]
    have hmap' : (conjSubgroup g_M W_M).map M.subtype =
        conjSubgroup (c : G) (conjSubgroup g W) := by
      simpa [W_M, g_M, conjSubgroup] using
        (map_subtype_map_conj (N := M) (W := conjSubgroup g W) hWg_le_M (m := (g_M⁻¹ : ↥M)))
    rw [hmap']
    have hn_eq : n = c⁻¹ * (g⁻¹ * a) := by
      calc
        n = c⁻¹ * (c * n) := by group
        _ = c⁻¹ * (g⁻¹ * a) := by rw [hcn]
    have hn_inv : n⁻¹ = a⁻¹ * g * c := by
      rw [hn_eq]
      group
    have ha_inv_mem : a⁻¹ ∈ Subgroup.centralizer (W : Set G) :=
      (Subgroup.centralizer (W : Set G)).inv_mem ha_mem_CW
    have haconj : conjSubgroup a⁻¹ W = W := by
      apply le_antisymm
      · intro x hx
        rcases Subgroup.mem_map.mp hx with ⟨w, hw, rfl⟩
        have hcomm : a * w = w * a := (Subgroup.mem_centralizer_iff.mp ha_mem_CW w hw).symm
        have hw' : a * w * a⁻¹ = w := by
          calc
            a * w * a⁻¹ = (w * a) * a⁻¹ := by rw [hcomm]
            _ = w := by group
        simpa [hw', mul_assoc] using hw
      · intro w hw
        have hcomm : a * w = w * a := (Subgroup.mem_centralizer_iff.mp ha_mem_CW w hw).symm
        refine Subgroup.mem_map.mpr ⟨w, hw, ?_⟩
        simp [MulAut.conj_apply, hcomm, mul_assoc]
    have hconj : conjSubgroup (c : G) (conjSubgroup g W) = conjSubgroup n⁻¹ W := by
      rw [conjSubgroup_comp]
      conv_rhs =>
        rw [hn_inv]
        rw [show a⁻¹ * g * c = a⁻¹ * (g * c) by rw [mul_assoc]]
        rw [← conjSubgroup_comp]
        rw [haconj]
    rw [hconj]
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨w, hw, rfl⟩
    simp [MulAut.conj_apply]
    exact (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).mul_mem
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).mul_mem hn_mem (hW_le_NZJ hw))
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).inv_mem hn_mem)
  have hStar : CpStar (G := ↥M) (zjCharacteristicFunctor p) S_M :=
    (lemma5_1 (G := ↥M) (zjCharacteristicFunctor p) S_M).mp hCpM
  rcases hStar W_M hW_Mp hW_M_le_NM g_M hconjWg_M_le_NM with ⟨d_M, m_M, hd_M, hm_M, hc_eq_M⟩
  let d : G := (d_M : G)
  let m : G := (m_M : G)
  have hc_eq : c = d * m := by
    have := congrArg (fun x : ↥M => (x : G)) hc_eq_M
    simpa [d, m, g_M] using this
  have hd_CWg : d ∈ Subgroup.centralizer (conjSubgroup g W : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    have hxM : x ∈ M := hWg_le_M hx
    have hxWM : ⟨x, hxM⟩ ∈ (W_M : Set ↥M) := Subgroup.mem_subgroupOf.mpr hx
    have hcomm := (Subgroup.mem_centralizer_iff.mp hd_M) ⟨x, hxM⟩ hxWM
    have hdM : (d_M : G) * x = x * (d_M : G) := congrArg Subtype.val hcomm.symm
    simpa [d] using hdM.symm
  have hm_mem' : m ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := by
    have hmm := (mem_normalizer_map_subtype_iff (M := M) (H := ZJ (S_M : Subgroup ↥M)) (x := m_M)).mp hm_M
    simpa [m, hmap] using hmm
  have hn_eq : n = c⁻¹ * (g⁻¹ * a) := by
    calc
      n = c⁻¹ * (c * n) := by group
      _ = c⁻¹ * (g⁻¹ * a) := by rw [hcn]
  have hn_inv : n⁻¹ = a⁻¹ * g * c := by
    rw [hn_eq]
    group
  have hmain : ∀ w : G, w ∈ W → n * w * n⁻¹ = m⁻¹ * (g⁻¹ * w * g) * m := by
    intro w hw
    have hcomm_a : a * w = w * a := (Subgroup.mem_centralizer_iff.mp ha_mem_CW w hw).symm
    have hdw : d * (g⁻¹ * w * g) = (g⁻¹ * w * g) * d :=
      ((Subgroup.mem_centralizer_iff.mp hd_CWg) (g⁻¹ * w * g)
        (Subgroup.mem_map.mpr ⟨w, hw, by simp⟩)).symm
    calc
      n * w * n⁻¹ = (c⁻¹ * g⁻¹ * a) * w * (a⁻¹ * g * c) := by
            rw [hn_inv, hn_eq]
            group
      _ = c⁻¹ * (g⁻¹ * w * g) * c := by
            calc
              (c⁻¹ * g⁻¹ * a) * w * (a⁻¹ * g * c) = c⁻¹ * (g⁻¹ * (a * w * a⁻¹) * g) * c := by group
              _ = c⁻¹ * (g⁻¹ * w * g) * c := by
                    rw [hcomm_a]
                    group
      _ = m⁻¹ * (g⁻¹ * w * g) * m := by
            calc
              c⁻¹ * (g⁻¹ * w * g) * c = (d * m)⁻¹ * (g⁻¹ * w * g) * (d * m) := by rw [hc_eq]
              _ = m⁻¹ * (d⁻¹ * (g⁻¹ * w * g) * d) * m := by group
              _ = m⁻¹ * (g⁻¹ * w * g) * m := by
                    have hdw' : d⁻¹ * (g⁻¹ * w * g) * d = g⁻¹ * w * g := by
                      calc
                        d⁻¹ * (g⁻¹ * w * g) * d = d⁻¹ * ((g⁻¹ * w * g) * d) := by rw [mul_assoc]
                        _ = d⁻¹ * (d * (g⁻¹ * w * g)) := by rw [hdw.symm]
                        _ = g⁻¹ * w * g := by group
                    rw [hdw']
  have hgmn_comm : ∀ w : G, w ∈ W → (g * m * n) * w = w * (g * m * n) := by
    intro w hw
    calc
      (g * m * n) * w = (g * m) * (n * w * n⁻¹) * n := by group
      _ = (g * m) * (m⁻¹ * (g⁻¹ * w * g) * m) * n := by rw [hmain w hw]
      _ = w * (g * m * n) := by group
  have hgmn_CW : g * m * n ∈ Subgroup.centralizer (W : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    exact (hgmn_comm w hw).symm
  refine ⟨g * m * n, (m * n)⁻¹, hgmn_CW, ?_, ?_⟩
  · exact (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).inv_mem
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).mul_mem hm_mem' hn_mem)
  · calc
      g = (g * m * n) * (m * n)⁻¹ := by group

omit [Finite G] in
/-- Centralizer elements normalize. -/


theorem mem_normalizer_of_centralizer {K : Subgroup G} {x : G}
    (hx : x ∈ Subgroup.centralizer (K : Set G)) : x ∈ Subgroup.normalizer (K : Set G) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  apply le_antisymm
  · intro y hy
    rcases Subgroup.mem_map.mp hy with ⟨k, hk, rfl⟩
    have hcomm : x * k = k * x := (Subgroup.mem_centralizer_iff.mp hx k hk).symm
    simpa [hcomm, MulAut.conj_apply, mul_assoc] using hk
  · intro k hk
    refine Subgroup.mem_map.mpr ⟨k, hk, ?_⟩
    have hcomm : x * k = k * x := (Subgroup.mem_centralizer_iff.mp hx k hk).symm
    simp [MulAut.conj_apply, hcomm, mul_assoc]

/-- Any subgroup with non-trivial `p`-core is contained in an element of `M_p(G)`. -/


theorem exists_MpSet_of_core_ne_bot {X : Subgroup G} (hX : pCore p ↥X ≠ ⊥) :
    ∃ M : Subgroup G, M ∈ MpSet p G ∧ X ≤ M := by
  classical
  let s : Set (Subgroup G) := {K : Subgroup G | X ≤ K ∧ pCore p ↥K ≠ ⊥}
  have hsne : s.Nonempty := ⟨X, le_rfl, hX⟩
  have hsfin : s.Finite := Set.toFinite s
  obtain ⟨M, hM⟩ := hsfin.exists_maximalFor (fun K : Subgroup G => Nat.card K) s hsne
  refine ⟨M, ?_, hM.1.1⟩
  refine ⟨hM.1.2, ?_⟩
  intro K hKcore hM_le_K
  have hKs : K ∈ s := ⟨hM.1.1.trans hM_le_K, hKcore⟩
  have hcard : Nat.card K ≤ Nat.card M := hM.le hKs
  exact (Subgroup.eq_of_le_of_card_ge (H := M) (K := K) hM_le_K hcard).symm

/-- Step (III) of Theorem 5.1, given step (II). -/


theorem step_III_scratch (S : Sylow p G) (h : Theorem51HypA p G ∨ Theorem51HypB p G)
    (hII : ∀ g : G, conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (S : Subgroup G) →
      ∃ c n : G,
        c ∈ Subgroup.centralizer (Zsub (S : Subgroup G) : Set G) ∧
          n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
            g = c * n) :
    ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
      (∃ P : Sylow p ↥(Subgroup.centralizer (W : Set G)),
        (P : Subgroup ↥(Subgroup.centralizer (W : Set G))).map
          (Subgroup.centralizer (W : Set G)).subtype =
            Subgroup.centralizer (W : Set G) ⊓ (S : Subgroup G)) →
      ∀ g : G, conjSubset g (W : Set G) ⊆ (S : Subgroup G) →
        ∃ c n : G,
          c ∈ Subgroup.centralizer (W : Set G) ∧
            n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
              g = c * n := by
  classical
  intro W hWp hWleS hWcond g hWg
  by_cases hSbot : (S : Subgroup G) = ⊥
  · have hWbot : W = ⊥ := by
      apply le_bot_iff.mp
      simpa [hSbot] using hWleS
    refine ⟨g, 1, ?_, ?_, ?_⟩
    · rw [hWbot]
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rw [hy]
      simp
    · exact (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).one_mem
    · group
  · let Z : Subgroup G := Zsub (S : Subgroup G)
    let C : Subgroup G := Subgroup.centralizer (W : Set G)
    have hZ_le_S : Z ≤ (S : Subgroup G) := by
      intro z hz
      exact hz.1
    have hZp : IsPGroup p (↥Z) := IsPGroup.to_le (hK := S.isPGroup') hZ_le_S
    have hZ_le_CWg : Z ≤ Subgroup.centralizer (conjSubset g (W : Set G)) := by
      intro z hz
      rw [Subgroup.mem_centralizer_iff]
      intro x hx
      rcases hx with ⟨w, hw, rfl⟩
      have hxS : g⁻¹ * w * g ∈ (S : Subgroup G) := hWg ⟨w, hw, rfl⟩
      exact (Subgroup.mem_centralizer_iff.mp hz.2) (g⁻¹ * w * g) hxS
    have hZg_le_CW : conjSubset (g⁻¹) (Z : Set G) ⊆ (C : Set G) := by
      intro x hx
      rcases hx with ⟨z, hz, rfl⟩
      change (g⁻¹)⁻¹ * z * g⁻¹ ∈ Subgroup.centralizer (W : Set G)
      rw [inv_inv]
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      have hzC : z ∈ Subgroup.centralizer (conjSubset g (W : Set G)) := hZ_le_CWg hz
      have hcomm := (Subgroup.mem_centralizer_iff.mp hzC) (g⁻¹ * w * g) ⟨w, hw, rfl⟩
      calc
        w * (g * z * g⁻¹) = g * ((g⁻¹ * w * g) * z) * g⁻¹ := by group
        _ = g * (z * (g⁻¹ * w * g)) * g⁻¹ := by rw [hcomm]
        _ = (g * z * g⁻¹) * w := by group
    let Z₁ : Subgroup G := conjSubgroup g⁻¹ Z
    have hZ1_le_C : Z₁ ≤ C := by
      intro x hx
      exact hZg_le_CW (by simpa [conjSubset_eq_conjSubgroup] using hx)
    have hZ1p : IsPGroup p (↥Z₁) := by
      rw [show Z₁ = Z.map (MulAut.conj g).toMonoidHom by simp [Z₁, conjSubgroup]]
      exact IsPGroup.map (H := Z) hZp (MulAut.conj g).toMonoidHom
    rcases hWcond with ⟨P, hP⟩
    let Z₁' : Subgroup ↥C := Z₁.subgroupOf C
    have hZ1'p : IsPGroup p Z₁' :=
      hZ1p.of_equiv (Subgroup.subgroupOfEquivOfLe (H := Z₁) (K := C) hZ1_le_C).symm
    obtain ⟨Q, hZ1'_le_Q⟩ := IsPGroup.exists_le_sylow (G := ↥C) (p := p) hZ1'p
    obtain ⟨a₀, ha₀⟩ := MulAction.exists_smul_eq (↥C) P Q
    have hQ_eq : Q = a₀ • P := ha₀.symm
    have hZ1'a_le_P : conjSubgroup (a₀ : ↥C) Z₁' ≤ P := by
      intro x hx
      rcases Subgroup.mem_map.mp hx with ⟨y, hy, hxy⟩
      have hyQ : y ∈ (Q : Subgroup ↥C) := hZ1'_le_Q hy
      rw [hQ_eq, sylow_smul_subgroup_eq_map_conj] at hyQ
      rcases Subgroup.mem_map.mp hyQ with ⟨p, hp, hyp⟩
      have hyp' : (MulAut.conj (a₀ : ↥C)) p = y := by simpa using hyp
      have hxp : x = p := by
        calc
          x = (MulAut.conj (a₀⁻¹ : ↥C)) y := hxy.symm
          _ = (MulAut.conj (a₀⁻¹ : ↥C)) ((MulAut.conj (a₀ : ↥C)) p) := by
                rw [← hyp']
          _ = p := by
                rw [MulAut.conj_apply, MulAut.conj_apply, inv_inv]
                group
      simpa [hxp] using hp
    have hZ1a_le_CcapS : conjSubgroup (a₀ : G) Z₁ ≤ (C ⊓ (S : Subgroup G)) := by
      have heq : conjSubgroup (a₀ : G) Z₁ = (conjSubgroup (a₀ : ↥C) Z₁').map C.subtype := by
        calc
          conjSubgroup (a₀ : G) Z₁ = Z₁.map (MulAut.conj (a₀ : G)⁻¹).toMonoidHom := rfl
          _ = ((Z₁.subgroupOf C).map C.subtype).map (MulAut.conj (a₀ : G)⁻¹).toMonoidHom := by
                rw [map_subgroupOf_eq_of_le' hZ1_le_C]
          _ = (Z₁.subgroupOf C).map ((MulAut.conj (a₀ : G)⁻¹).toMonoidHom.comp C.subtype) := by
                rw [Subgroup.map_map]
          _ = (Z₁.subgroupOf C).map (C.subtype.comp (MulAut.conj (a₀⁻¹ : ↥C)).toMonoidHom) := by
                congr 1
          _ = ((Z₁.subgroupOf C).map (MulAut.conj (a₀⁻¹ : ↥C)).toMonoidHom).map C.subtype := by
                rw [Subgroup.map_map]
          _ = (conjSubgroup (a₀ : ↥C) Z₁').map C.subtype := rfl
      calc
        conjSubgroup (a₀ : G) Z₁
            = (conjSubgroup (a₀ : ↥C) Z₁').map C.subtype := heq
        _ ≤ P.map C.subtype := Subgroup.map_mono (f := C.subtype) hZ1'a_le_P
        _ = C ⊓ (S : Subgroup G) := by rw [hP]
    let a : G := (a₀ : G)
    have ha_mem_CW : a ∈ C := a₀.2
    have hZa_le_CcapS : conjSubgroup (g⁻¹ * a) Z ≤ (C ⊓ (S : Subgroup G)) := by
      change conjSubgroup (g⁻¹ * (a₀ : G)) Z ≤ (C ⊓ (S : Subgroup G))
      rw [← conjSubgroup_comp]
      simpa [Z₁] using hZ1a_le_CcapS
    have hgZa_le_S : conjSubset (g⁻¹ * a) (Z : Set G) ⊆ (S : Subgroup G) := by
      intro x hx
      have hx' : x ∈ (conjSubgroup (g⁻¹ * a) Z : Set G) := by
        simpa [conjSubset_eq_conjSubgroup] using hx
      exact (hZa_le_CcapS hx').2
    rcases hII (g⁻¹ * a) hgZa_le_S with ⟨c, n, hc_mem_CZ, hn_mem_NZJ, hcn⟩
    let X : Subgroup G := Subgroup.normalizer (Z : Set G)
    have hS_le_CZ : (S : Subgroup G) ≤ Subgroup.centralizer (Z : Set G) := by
      intro s hs z hz
      exact ((Subgroup.mem_centralizer_iff.mp hz.2) s hs).symm
    have hS_le_X : (S : Subgroup G) ≤ X :=
      hS_le_CZ.trans (Subgroup.centralizer_le_normalizer (Z : Set G))
    have hc_mem_X : c ∈ X := mem_normalizer_of_centralizer hc_mem_CZ
    have hSleNZJ : (S : Subgroup G) ≤ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) :=
      sylow_le_normalizer_K (zjCharacteristicFunctor p) S
    have hWg_sub : conjSubgroup g W ≤ (S : Subgroup G) := by
      intro x hx
      exact hWg (by simpa [conjSubset_eq_conjSubgroup] using hx)
    rcases h with hA | hB
    · let M : Subgroup G := X
      have hS_le_M : (S : Subgroup G) ≤ M := hS_le_X
      have hc_mem_M : c ∈ M := hc_mem_X
      have hCpM : Cp (G := ↥M) (zjCharacteristicFunctor p) (S.subtype hS_le_M) := by
        have hSat := hA S Z (by rfl) hZ_le_S
        exact hSat (S.subtype hS_le_M)
      exact step_III_M_part S W M g a c n hWleS ha_mem_CW hc_mem_M hn_mem_NZJ hcn hWp
        hWg_sub (hWg_sub.trans hS_le_M) hS_le_M hSleNZJ hCpM
    · have hZ_ne_bot : Z ≠ ⊥ := by
        simpa [Z, Zsub] using
          (centerIn_ne_bot_of_isPGroup_ne_bot (G := G) (p := p) S.isPGroup' hSbot)
      have hZ_le_X : Z ≤ X := by
        have : IsMulCommutative ↥Z := centerIn_isMulCommutative_local (G := G) (S : Subgroup G)
        exact (Subgroup.le_centralizer (H := Z)).trans (Subgroup.centralizer_le_normalizer (Z : Set G))
      have hZnormal : (Z.subgroupOf X).Normal := Subgroup.normal_in_normalizer
      have hZ'p : IsPGroup p (Z.subgroupOf X) :=
        hZp.of_equiv (Subgroup.subgroupOfEquivOfLe (H := Z) (K := X) hZ_le_X).symm
      have hXcore : pCore p ↥X ≠ ⊥ := by
        intro hcore
        have hZ'_le_core : Z.subgroupOf X ≤ pCore p ↥X :=
          le_pCore_of_normal_isPGroup (G := ↥X) (N := Z.subgroupOf X) hZnormal hZ'p
        have hZ'_ne_bot : Z.subgroupOf X ≠ ⊥ := by
          intro hb
          apply hZ_ne_bot
          have hmap : (Z.subgroupOf X).map X.subtype = Z := map_subgroupOf_eq_of_le' hZ_le_X
          simpa [hb] using hmap.symm
        exact hZ'_ne_bot (le_bot_iff.mp (hZ'_le_core.trans (le_of_eq hcore)))
      obtain ⟨M, hM_mpset, hX_le_M⟩ := exists_MpSet_of_core_ne_bot (G := G) (p := p) hXcore
      have hS_le_M : (S : Subgroup G) ≤ M := hS_le_X.trans hX_le_M
      have hc_mem_M : c ∈ M := hX_le_M hc_mem_X
      have hCpM : Cp (G := ↥M) (zjCharacteristicFunctor p) (S.subtype hS_le_M) := by
        have hSat := hB M hM_mpset
        exact hSat (S.subtype hS_le_M)
      exact step_III_M_part S W M g a c n hWleS ha_mem_CW hc_mem_M hn_mem_NZJ hcn hWp
        hWg_sub (hWg_sub.trans hS_le_M) hS_le_M hSleNZJ hCpM


set_option backward.isDefEq.respectTransparency false in
theorem step_IV_scratch (S : Sylow p G) (_h : Theorem51HypA p G ∨ Theorem51HypB p G)
    (hIII : ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
      (∃ P : Sylow p ↥(Subgroup.centralizer (W : Set G)),
        (P : Subgroup ↥(Subgroup.centralizer (W : Set G))).map
          (Subgroup.centralizer (W : Set G)).subtype =
            Subgroup.centralizer (W : Set G) ⊓ (S : Subgroup G)) →
      ∀ g : G, conjSubset g (W : Set G) ⊆ (S : Subgroup G) →
        ∃ c n : G,
          c ∈ Subgroup.centralizer (W : Set G) ∧
            n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
              g = c * n) :
    ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
      ∀ g : G, conjSubset g (W : Set G) ⊆ (S : Subgroup G) →
        ∃ c n : G,
          c ∈ Subgroup.centralizer (W : Set G) ∧
            n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
              g = c * n := by
  classical
  intro W hWp hWleS g hWg
  let N : Subgroup G := Subgroup.normalizer (W : Set G)
  have hW_le_N : W ≤ N := Subgroup.le_normalizer
  let W' : Subgroup ↥N := W.subgroupOf N
  have hW'p : IsPGroup p W' :=
    hWp.of_equiv (Subgroup.subgroupOfEquivOfLe (H := W) (K := N) hW_le_N).symm
  obtain ⟨T, hW'_le_T⟩ := IsPGroup.exists_le_sylow (G := ↥N) (p := p) hW'p
  let T₁ : Subgroup G := T.map N.subtype
  have hT₁p : IsPGroup p (↥T₁) := IsPGroup.map (H := T) T.isPGroup' N.subtype
  obtain ⟨S₁, hT₁_le_S₁⟩ := IsPGroup.exists_le_sylow (G := G) (p := p) hT₁p
  obtain ⟨y, hy⟩ := MulAction.exists_smul_eq G S S₁
  let x : G := (y : G)⁻¹
  have hS1 : conjSubgroup x (S : Subgroup G) = (S₁ : Subgroup G) := by
    have hy' : (S : Subgroup G).map (MulAut.conj y).toMonoidHom = (S₁ : Subgroup G) := by
      simpa [sylow_smul_subgroup_eq_map_conj] using congrArg (fun Q : Sylow p G => (Q : Subgroup G)) hy
    simpa [x, conjSubgroup] using hy'
  let V : Subgroup G := conjSubgroup x⁻¹ W
  have hV : V = W.map (MulAut.conj x).toMonoidHom := by
    simp [V, conjSubgroup]
  have hV_le_S : V ≤ (S : Subgroup G) := by
    intro v hv
    rw [hV] at hv
    rcases Subgroup.mem_map.mp hv with ⟨w, hw, rfl⟩
    -- v = x w x⁻¹; need x w x⁻¹ ∈ S ⟺ w ∈ conjSubgroup x S = S₁
    have hw' : w ∈ (conjSubgroup x (S : Subgroup G) : Set G) := by
      -- w ∈ S₁: from hT₁_le_S₁ and W ≤ T₁
      have hwT : w ∈ T₁ := by
        -- w ∈ W ≤ T₁ (via W' ≤ T)
        exact Subgroup.mem_map.mpr ⟨⟨w, hW_le_N hw⟩,
          hW'_le_T (Subgroup.mem_subgroupOf.mpr hw), rfl⟩
      rw [hS1]
      exact hT₁_le_S₁ hwT
    rcases Subgroup.mem_map.mp hw' with ⟨s, hs, rfl⟩
    -- w = x⁻¹ s x, so x w x⁻¹ = s
    simpa [MulAut.conj_apply, mul_assoc] using hs
  have hVp : IsPGroup p (↥V) := by
    rw [hV]
    exact IsPGroup.map (H := W) hWp (MulAut.conj x).toMonoidHom
  have hVx : conjSubgroup x V = W := by
    change conjSubgroup x (conjSubgroup x⁻¹ W) = W
    rw [conjSubgroup_comp]
    rw [inv_mul_cancel]
    ext w
    simp [conjSubgroup]
  have hVxg : conjSubgroup (x * g) V = conjSubgroup g W := by
    change conjSubgroup (x * g) (conjSubgroup x⁻¹ W) = conjSubgroup g W
    rw [conjSubgroup_comp]
    apply congrArg (fun f : G ≃* G => W.map f.toMonoidHom)
    ext w
    group
  have hVcond : ∃ P : Sylow p ↥(Subgroup.centralizer (V : Set G)),
      (P : Subgroup ↥(Subgroup.centralizer (V : Set G))).map
        (Subgroup.centralizer (V : Set G)).subtype =
          Subgroup.centralizer (V : Set G) ⊓ (S : Subgroup G) := by
    let NV : Subgroup G := Subgroup.normalizer (V : Set G)
    have hNV : N.map (MulAut.conj x).toMonoidHom = NV := by
      change N.map (MulAut.conj x).toMonoidHom = Subgroup.normalizer (conjSubgroup x⁻¹ W : Set G)
      rw [normalizer_conjSubgroup]
      simp [conjSubgroup, N]
    have hN_S1 : ((S₁ : Subgroup G) ⊓ N) = T₁ := by
      have hT1_le : T₁ ≤ (S₁ : Subgroup G) ⊓ N := by
        refine le_inf hT₁_le_S₁ ?_
        intro t ht
        rcases Subgroup.mem_map.mp ht with ⟨n, hn, rfl⟩
        exact n.2
      have hQp : IsPGroup p (↥(((S₁ : Subgroup G) ⊓ N).subgroupOf N)) := by
        have hS1p : IsPGroup p (↥((S₁ : Subgroup G) ⊓ N)) :=
          S₁.isPGroup'.to_inf_left
        exact hS1p.of_equiv (Subgroup.subgroupOfEquivOfLe
          (H := (S₁ : Subgroup G) ⊓ N) (K := N) inf_le_right).symm
      have hT_subgroupOf : T ≤ ((S₁ : Subgroup G) ⊓ N).subgroupOf N := by
        intro t ht
        exact Subgroup.mem_subgroupOf.mpr (hT1_le (Subgroup.mem_map.mpr ⟨t, ht, rfl⟩))
      have hQ_eq_T : ((S₁ : Subgroup G) ⊓ N).subgroupOf N = T :=
        T.is_maximal' hQp hT_subgroupOf
      have h := congrArg (fun Q : Subgroup ↥N => Q.map N.subtype) hQ_eq_T
      simpa [T₁] using h
    let e : ↥N ≃* ↥NV :=
      (MulEquiv.subgroupMap (MulAut.conj x) N).trans (MulEquiv.subgroupCongr hNV)
    let NSV : Sylow p ↥NV := Sylow.mapSurjective (f := e.toMonoidHom) (hf := e.surjective) T
    have hNSV_map : (NSV : Subgroup ↥NV).map NV.subtype = (S : Subgroup G) ⊓ NV := by
      have h1 : (NSV : Subgroup ↥NV).map NV.subtype = T₁.map (MulAut.conj x).toMonoidHom := by
        simp [NSV, T₁, Sylow.coe_mapSurjective, Subgroup.map_map]
        apply congrArg (fun f : ↥N →* G => T.map f)
        ext t
        simp [e, MulAut.conj_apply]
      have h2 : (S : Subgroup G) ⊓ NV = T₁.map (MulAut.conj x).toMonoidHom := by
        rw [← hNV]
        have h3 : ((S₁ : Subgroup G) ⊓ N).map (MulAut.conj x).toMonoidHom =
            (S : Subgroup G) ⊓ N.map (MulAut.conj x).toMonoidHom := by
          rw [Subgroup.map_inf (H := (S₁ : Subgroup G)) (K := N)
            (f := (MulAut.conj x).toMonoidHom) (MulAut.conj x).injective]
          congr 1
          -- S₁.map (conj x) = S
          rw [← hS1]
          simp [conjSubgroup]
          rw [Subgroup.map_map]
          ext u
          simp [MulAut.conj_apply, mul_assoc]
        rw [← h3, hN_S1]
      exact h1.trans h2.symm
    let C : Subgroup G := Subgroup.centralizer (V : Set G)
    let C' : Subgroup ↥NV := C.subgroupOf NV
    have hC_le_NV : C ≤ NV := Subgroup.centralizer_le_normalizer (V : Set G)
    have : C'.Normal := Subgroup.normal_subgroupOf_centralizer_normalizer (V : Set G)
    obtain ⟨P₀, hP₀⟩ := sylow_inf_normal (G := ↥NV) (p := p) (S := NSV) (N := C')
    let e₁ : ↥C ≃* ↥C' := (Subgroup.subgroupOfEquivOfLe (H := C) (K := NV) hC_le_NV).symm
    let P : Sylow p ↥C := Sylow.mapSurjective (f := e₁.symm.toMonoidHom) (hf := e₁.symm.surjective) P₀
    refine ⟨P, ?_⟩
    have hP_coe : (P : Subgroup ↥C) = P₀.map e₁.symm.toMonoidHom := by
      simp [P]
    calc
      (P : Subgroup ↥C).map C.subtype
          = (P₀.map e₁.symm.toMonoidHom).map C.subtype := by rw [hP_coe]
      _ = P₀.map (C.subtype.comp e₁.symm.toMonoidHom) := by rw [Subgroup.map_map]
      _ = P₀.map (NV.subtype.comp C'.subtype) := by
            apply congrArg (fun f : ↥C' →* G => P₀.map f)
            rfl
      _ = (P₀.map C'.subtype).map NV.subtype := by rw [Subgroup.map_map]
      _ = (NSV : Subgroup ↥NV).map NV.subtype ⊓ C'.map NV.subtype := by
            rw [hP₀]
            rw [Subgroup.map_subgroupOf_eq_of_le (H := (NSV : Subgroup ↥NV) ⊓ C')
              (K := C') inf_le_right]
            rw [Subgroup.map_inf (H := (NSV : Subgroup ↥NV)) (K := C')
              (f := NV.subtype) NV.subtype_injective]
      _ = (S : Subgroup G) ⊓ NV ⊓ C := by
            rw [hNSV_map, map_subgroupOf_eq_of_le' hC_le_NV]
      _ = C ⊓ (S : Subgroup G) := by
            rw [inf_assoc, inf_eq_right.2 hC_le_NV, inf_comm]
  -- apply (III) to V with element x
  have hx₁ : conjSubset x (V : Set G) ⊆ (S : Subgroup G) := by
    rw [conjSubset_eq_conjSubgroup, hVx]
    exact hWleS
  rcases hIII V hVp hV_le_S hVcond x hx₁ with ⟨c₀, m₀, hc₀, hm₀, hx⟩
  let c : G := c₀⁻¹
  let m : G := m₀
  have hx' : c⁻¹ * m = x := by
    simp [c, m, hx]
  have hc_mem : c ∈ Subgroup.centralizer (V : Set G) :=
    (Subgroup.centralizer (V : Set G)).inv_mem hc₀
  have hm_mem : m ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := hm₀
  -- apply (III) to V with element x·g
  have hx₂ : conjSubset (x * g) (V : Set G) ⊆ (S : Subgroup G) := by
    rw [conjSubset_eq_conjSubgroup, hVxg]
    simpa [conjSubset_eq_conjSubgroup] using hWg
  rcases hIII V hVp hV_le_S hVcond (x * g) hx₂ with ⟨d, n, hd, hn, hxg⟩
  refine ⟨m⁻¹ * c * d * m, m⁻¹ * n, ?_, ?_, ?_⟩
  · -- m⁻¹·c·d·m ∈ C(W)
    have hW_eq : W = conjSubgroup m V := by
      have hm_eq : m = c * x := by
        calc
          m = c * (c⁻¹ * m) := by group
          _ = c * x := by rw [hx']
      rw [hm_eq]
      rw [← conjSubgroup_comp]
      have hcV : conjSubgroup c V = V := by
        apply le_antisymm
        · intro v hv
          rcases Subgroup.mem_map.mp hv with ⟨u, hu, rfl⟩
          have hcomm : c * u = u * c := (Subgroup.mem_centralizer_iff.mp hc_mem u hu).symm
          have h' : c⁻¹ * u * c = u := by
            calc
              c⁻¹ * u * c = c⁻¹ * (u * c) := by rw [mul_assoc]
              _ = c⁻¹ * (c * u) := by rw [← hcomm]
              _ = u := by group
          simpa [h'] using hu
        · intro u hu
          have hcomm : c * u = u * c := (Subgroup.mem_centralizer_iff.mp hc_mem u hu).symm
          refine Subgroup.mem_map.mpr ⟨c * u * c⁻¹, ?_, ?_⟩
          · simpa [hcomm, mul_assoc] using hu
          · change (MulAut.conj c⁻¹) (c * u * c⁻¹) = u
            rw [MulAut.conj_apply]
            group
      rw [hcV]
      exact hVx.symm
    have hcm_mem : m⁻¹ * c * m ∈ Subgroup.centralizer (W : Set G) := by
      rw [hW_eq]
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨v, hv, rfl⟩
      change (MulAut.conj m⁻¹) v * (m⁻¹ * c * m) = (m⁻¹ * c * m) * (MulAut.conj m⁻¹) v
      rw [MulAut.conj_apply, inv_inv]
      calc
        (m⁻¹ * v * m) * (m⁻¹ * c * m) = m⁻¹ * (v * c) * m := by group
        _ = m⁻¹ * (c * v) * m := by rw [(Subgroup.mem_centralizer_iff.mp hc_mem v hv).symm]
        _ = (m⁻¹ * c * m) * (m⁻¹ * v * m) := by group
    have hdm_mem : m⁻¹ * d * m ∈ Subgroup.centralizer (W : Set G) := by
      rw [hW_eq]
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨v, hv, rfl⟩
      change (MulAut.conj m⁻¹) v * (m⁻¹ * d * m) = (m⁻¹ * d * m) * (MulAut.conj m⁻¹) v
      rw [MulAut.conj_apply, inv_inv]
      calc
        (m⁻¹ * v * m) * (m⁻¹ * d * m) = m⁻¹ * (v * d) * m := by group
        _ = m⁻¹ * (d * v) * m := by rw [(Subgroup.mem_centralizer_iff.mp hd v hv).symm]
        _ = (m⁻¹ * d * m) * (m⁻¹ * v * m) := by group
    convert (Subgroup.centralizer (W : Set G)).mul_mem hcm_mem hdm_mem using 1
    group
  · -- m⁻¹·n ∈ N(ZJ S)
    exact (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).mul_mem
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).inv_mem hm_mem) hn
  · -- g = (m⁻¹·c·d·m)·(m⁻¹·n)
    calc
      g = x⁻¹ * (x * g) := by group
      _ = x⁻¹ * (d * n) := by rw [hxg]
      _ = (c⁻¹ * m)⁻¹ * (d * n) := by rw [hx']
      _ = m⁻¹ * c * d * n := by group
      _ = (m⁻¹ * c * d * m) * (m⁻¹ * n) := by group

/-! ## Local infrastructure for step (I): the `p`-part and normalizer growth

The following lemmas are `private` in `Glauberman/Theorem7_1.lean`; they are
reproduced here so that step (I) can use them.
-/

/-- The `p`-part `p ^ padicValNat p n` of a natural number `n`. -/
private def pPart (p n : ℕ) : ℕ := p ^ padicValNat p n

/-- The `p`-part is monotone under divisibility (for non-zero `b`). -/
private lemma pPart_mono {p : ℕ} [Fact p.Prime] {a b : ℕ} (hb : b ≠ 0) (hab : a ∣ b) :
    pPart p a ≤ pPart p b := by
  have ha : a ≠ 0 := by
    intro ha
    exact hb (by simpa [ha] using hab)
  unfold pPart
  have hv : padicValNat p a ≤ padicValNat p b := by
    rw [← padicValNat_dvd_iff_le (a := b) hb]
    exact dvd_trans (pow_padicValNat_dvd (p := p) (n := a)) hab
  exact pow_le_pow_right₀ (by exact (Nat.Prime.one_le (Fact.out : Nat.Prime p))) hv

/-- The `p`-part of the order of a finite group equals the order of any Sylow `p`-subgroup. -/
private lemma pPart_card_eq_card_of_sylow {p : ℕ} [Fact p.Prime] {G : Type*} [Group G]
    [Finite G] (T : Sylow p G) : pPart p (Nat.card G) = Nat.card T := by
  classical
  have hTp : IsPGroup p (T : Subgroup G) := T.isPGroup'
  obtain ⟨n, hn⟩ := hTp.exists_card_eq
  have hnot : ¬ p ∣ (T : Subgroup G).index := Sylow.not_dvd_index (P := T)
  have hTcard_ne : Nat.card (↥(T : Subgroup G)) ≠ 0 :=
    ne_of_gt (Nat.card_pos (α := ↥(T : Subgroup G)))
  have hTindex_ne : (T : Subgroup G).index ≠ 0 :=
    Subgroup.index_ne_zero_of_finite (H := (T : Subgroup G))
  have hcard : Nat.card (↥(T : Subgroup G)) * (T : Subgroup G).index = Nat.card G := by
    simp
  have hv : padicValNat p (Nat.card G) = n := by
    rw [← hcard]
    rw [padicValNat.mul hTcard_ne hTindex_ne]
    rw [hn]
    rw [padicValNat.prime_pow]
    rw [padicValNat.eq_zero_of_not_dvd hnot]
    rw [add_zero]
  unfold pPart
  rw [hv]
  exact hn.symm

/-- A proper subgroup of a finite `p`-group is properly contained in its normalizer
(Gorenstein, *Finite Groups*, Theorem 2.7; [6], §5, proof of step (I): "We require
the methods of Burnside"). -/
private lemma normalizer_lt_of_lt_of_isPGroup {P : Type*} [Group P] [Finite P] {p : ℕ}
    [Fact p.Prime] (hP : IsPGroup p P) {H : Subgroup P} (hH : H < ⊤) :
    H < Subgroup.normalizer (H : Set P) := by
  classical
  have htop : IsPGroup p (⊤ : Subgroup P) :=
    IsPGroup.of_equiv (hG := hP) (Subgroup.topEquiv (G := P)).symm
  have hHp : IsPGroup p H := htop.to_le hH.le
  have hmod : Nat.card (P ⧸ H) ≡ Nat.card (MulAction.fixedPoints (↥H) (P ⧸ H)) [MOD p] :=
    hHp.card_modEq_card_fixedPoints (α := P ⧸ H)
  have htotal : p ∣ Nat.card (P ⧸ H) := by
    rw [← Subgroup.index_eq_card]
    have hindex_ne_one : H.index ≠ 1 := by
      intro h1
      exact hH.ne' (Subgroup.index_eq_one.mp h1).symm
    rcases (hP.index H) with ⟨k, hk⟩
    have hk0 : k ≠ 0 := by
      intro hk0
      apply hindex_ne_one
      simp [hk, hk0]
    rw [hk]
    exact dvd_pow_self p hk0
  have hfixed : p ∣ Nat.card (MulAction.fixedPoints (↥H) (P ⧸ H)) :=
    Nat.modEq_zero_iff_dvd.mp ((hmod.symm).trans htotal.modEq_zero_nat)
  have hfixed_card : Nat.card (MulAction.fixedPoints (↥H) (P ⧸ H)) =
      (H.comap (Subgroup.normalizer (H : Set P)).subtype).index := by
    calc
      Nat.card (MulAction.fixedPoints (↥H) (P ⧸ H)) =
          Nat.card (Subgroup.normalizer (H : Set P) ⧸
            H.comap (Subgroup.normalizer (H : Set P)).subtype) := by
            exact Nat.card_congr
              (Sylow.fixedPointsMulLeftCosetsEquivQuotient (H := H))
      _ = (H.comap (Subgroup.normalizer (H : Set P)).subtype).index := by
            rw [Subgroup.index_eq_card]
  have hfixed' : p ∣ (H.subgroupOf (Subgroup.normalizer (H : Set P))).index := by
    simpa [hfixed_card, Subgroup.comap_subtype] using hfixed
  have hindex_ne_one : (H.subgroupOf (Subgroup.normalizer (H : Set P))).index ≠ 1 := by
    intro h1
    have : p ∣ (1 : ℕ) := by
      simpa [h1] using hfixed'
    exact (Nat.Prime.not_dvd_one (Fact.out : Nat.Prime p)) this
  refine lt_of_le_of_ne H.le_normalizer ?_
  intro heq
  apply hindex_ne_one
  rw [← heq]
  rw [Subgroup.subgroupOf_self]
  exact Subgroup.index_top

/-- A Sylow `p`-subgroup of its own normalizer is a Sylow `p`-subgroup of `G`
(Sylow's theorem; cf. [6, §5, proof of step (I)]). -/
private lemma isSylow_of_sylow_normalizer {p : ℕ} [Fact p.Prime] {G : Type*} [Group G]
    [Finite G] {T : Subgroup G} (hTp : IsPGroup p T)
    (TN : Sylow p ↥(Subgroup.normalizer (T : Set G)))
    (hTN_eq : (TN : Subgroup ↥(Subgroup.normalizer (T : Set G))) =
      T.subgroupOf (Subgroup.normalizer (T : Set G))) :
    ∃ S : Sylow p G, (S : Subgroup G) = T := by
  classical
  obtain ⟨S, hTS⟩ := hTp.exists_le_sylow
  refine ⟨S, ?_⟩
  apply le_antisymm
  · by_contra hnot
    have hlt : T < (S : Subgroup G) := lt_of_le_of_ne hTS (by
      intro heq
      apply hnot
      rw [heq])
    let H : Subgroup ↥(S : Subgroup G) := T.subgroupOf (S : Subgroup G)
    have hHlt : H < ⊤ := by
      rw [lt_top_iff_ne_top]
      intro htop
      exact hlt.ne' (by
        calc
          (S : Subgroup G) = (⊤ : Subgroup ↥(S : Subgroup G)).map (S : Subgroup G).subtype := by
            simpa using (Subgroup.subgroupOf_map_subtype (H := (S : Subgroup G)) (K := (S : Subgroup G))).symm
          _ = (T.subgroupOf (S : Subgroup G)).map (S : Subgroup G).subtype := by
            simpa [H] using congrArg
              (fun X : Subgroup ↥(S : Subgroup G) => X.map (S : Subgroup G).subtype) htop.symm
          _ = T := by
            exact (Subgroup.map_subgroupOf_eq_of_le hTS))
    have hHp : IsPGroup p (↥(S : Subgroup G)) := S.isPGroup'
    have hgrowth := normalizer_lt_of_lt_of_isPGroup (P := ↥(S : Subgroup G)) (p := p) hHp hHlt
    have hnorm : Subgroup.normalizer (H : Set ↥(S : Subgroup G)) =
        ((Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G)).subgroupOf (S : Subgroup G) := by
      have h : (Subgroup.normalizer (T : Set G)).subgroupOf (S : Subgroup G) =
          Subgroup.normalizer (T.subgroupOf (S : Subgroup G)) :=
        Subgroup.subgroupOf_normalizer_eq (H := T) (N := (S : Subgroup G)) hTS
      simpa [H, Subgroup.inf_subgroupOf_right] using h.symm
    let Q : Subgroup ↥(Subgroup.normalizer (T : Set G)) :=
      ((Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G)).subgroupOf (Subgroup.normalizer (T : Set G))
    have hQp : IsPGroup p Q := by
      have hXp : IsPGroup p (((Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G)) : Subgroup G) := by
        apply IsPGroup.to_le (hK := S.isPGroup')
        exact inf_le_right
      exact IsPGroup.of_equiv (hG := hXp)
        (Subgroup.subgroupOfEquivOfLe (show (Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G) ≤
          Subgroup.normalizer (T : Set G) from inf_le_left)).symm
    have hQleT : (T.subgroupOf (Subgroup.normalizer (T : Set G)) : Subgroup ↥(Subgroup.normalizer (T : Set G))) ≤ Q := by
      intro x hx
      dsimp [Q]
      rw [Subgroup.mem_subgroupOf] at hx ⊢
      exact ⟨Subgroup.le_normalizer hx, hTS hx⟩
    have hQeq := (TN.is_maximal' hQp (by simpa [hTN_eq] using hQleT))
    have hXeq : (Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G) = T := by
      calc
        (Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G) =
            (((Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G)).subgroupOf
              (Subgroup.normalizer (T : Set G))).map (Subgroup.normalizer (T : Set G)).subtype := by
          rw [Subgroup.subgroupOf_map_subtype]
          exact (inf_eq_left.mpr (show (Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G) ≤
            Subgroup.normalizer (T : Set G) from inf_le_left)).symm
        _ = Q.map (Subgroup.normalizer (T : Set G)).subtype := by
          rfl
        _ = (T.subgroupOf (Subgroup.normalizer (T : Set G))).map
            (Subgroup.normalizer (T : Set G)).subtype := by
              rw [hQeq, hTN_eq]
        _ = T := by
              exact (Subgroup.map_subgroupOf_eq_of_le Subgroup.le_normalizer)
    have hne : H ≠ Subgroup.normalizer (H : Set ↥(S : Subgroup G)) := ne_of_lt hgrowth
    apply hne
    rw [hnorm]
    change (T.subgroupOf (S : Subgroup G)) =
      ((Subgroup.normalizer (T : Set G)) ⊓ (S : Subgroup G)).subgroupOf (S : Subgroup G)
    rw [hXeq]
  · exact hTS

/-- Core form of the Sylow containment lemma, placed before step (I) because the
Burnside--Thompson maximality argument uses it.  The public wrapper remains below. -/
private theorem thompsonSubgroup_eq_of_sylow_le_core (S₁ S₂ : Sylow p G)
    (hJ : thompsonSubgroup (S₂ : Subgroup G) ≤ (S₁ : Subgroup G)) :
    thompsonSubgroup (S₂ : Subgroup G) = thompsonSubgroup (S₁ : Subgroup G) := by
  classical
  obtain ⟨x, hx⟩ := MulAction.exists_smul_eq G S₁ S₂
  have hS₂ : (S₂ : Subgroup G) =
      (S₁ : Subgroup G).map (MulAut.conj (x : G)).toMonoidHom := by
    have h' := congrArg (fun Q : Sylow p G => (Q : Subgroup G)) hx
    rw [sylow_smul_subgroup_eq_map_conj (m := x) (P := S₁)] at h'
    exact h'.symm
  have hA : ∀ A : Subgroup G, A ∈ thompsonAbelianSubgroups (S₂ : Subgroup G) →
      A ∈ thompsonAbelianSubgroups (S₁ : Subgroup G) := by
    intro A hA
    refine ⟨(le_sSup hA).trans hJ, hA.2.1, ?_⟩
    intro B hB hBcomm
    have hBx : B.map (MulAut.conj x).toMonoidHom ≤ (S₂ : Subgroup G) := by
      rw [hS₂]
      exact Subgroup.map_mono hB
    have hBxcomm : IsMulCommutative (B.map (MulAut.conj x).toMonoidHom) := by
      let : IsMulCommutative B := hBcomm
      exact Subgroup.map_isMulCommutative (H := B) (MulAut.conj x).toMonoidHom
    have hBxmax := hA.2.2 (B.map (MulAut.conj x).toMonoidHom) hBx hBxcomm
    calc
      Nat.card B = Nat.card (B.map (MulAut.conj x).toMonoidHom) := by
        symm
        exact Subgroup.card_map_of_injective (K := B)
          (f := (MulAut.conj x).toMonoidHom) (MulAut.conj x).injective
      _ ≤ Nat.card A := hBxmax
  have hJ2 : thompsonSubgroup (S₂ : Subgroup G) ≤
      thompsonSubgroup (S₁ : Subgroup G) := by
    refine sSup_le ?_
    intro B hB
    exact le_sSup (hA B hB)
  have hJ2map : thompsonSubgroup (S₂ : Subgroup G) =
      (thompsonSubgroup (S₁ : Subgroup G)).map
        (MulAut.conj (x : G)).toMonoidHom := by
    rw [hS₂, thompsonSubgroup_map_mulEquiv]
  have hcard : Nat.card (thompsonSubgroup (S₁ : Subgroup G)) ≤
      Nat.card (thompsonSubgroup (S₂ : Subgroup G)) := by
    rw [hJ2map]
    exact (Nat.card_congr (Subgroup.equivMapOfInjective (G := G) (N := G)
      (H := thompsonSubgroup (S₁ : Subgroup G))
      (f := (MulAut.conj x).toMonoidHom)
      (hf := (MulAut.conj x).injective))).le
  exact Subgroup.eq_of_le_of_card_ge hJ2 hcard

omit [Finite G] in
/-- The subgroup generated by the `A`-conjugates of `Z` can be realized as the
image of the normal closure of `Z` inside `A`.  This packages the normality and
containment facts used in the Burnside--Thompson `A`-argument. -/
private lemma exists_normalClosure_image_le_of_conjugates_le
    (A Z K : Subgroup G) (hZ_le_A : Z ≤ A)
    (hconj : ∀ a : G, a ∈ A → conjSubgroup a Z ≤ K) :
    ∃ V : Subgroup G, Z ≤ V ∧ V ≤ K ∧ A ≤ Subgroup.normalizer (V : Set G) := by
  let Z_A : Subgroup A := Z.subgroupOf A
  let V_A : Subgroup A := Subgroup.normalClosure (Z_A : Set A)
  let V : Subgroup G := V_A.map A.subtype
  have hZ_le_V : Z ≤ V := by
    intro z hz
    refine Subgroup.mem_map.mpr ⟨⟨z, hZ_le_A hz⟩, ?_, rfl⟩
    exact Subgroup.le_normalClosure (Subgroup.mem_subgroupOf.mpr hz)
  have hV_le_K : V ≤ K := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    change y ∈ Subgroup.closure (Group.conjugatesOfSet (Z_A : Set A)) at hy
    refine Subgroup.closure_induction (G := A) (p := fun y _ => (y : G) ∈ K)
      ?_ ?_ ?_ ?_ hy
    · intro y hy
      rcases Group.mem_conjugatesOfSet_iff.mp hy with ⟨z, hz, hzy⟩
      rcases isConj_iff.mp hzy with ⟨a, hay⟩
      have hzZ : (z : G) ∈ Z := Subgroup.mem_subgroupOf.mp hz
      have haA : (a : G)⁻¹ ∈ A := A.inv_mem a.property
      have hmem : (a : G) * (z : G) * (a : G)⁻¹ ∈ conjSubgroup ((a : G)⁻¹) Z := by
        refine Subgroup.mem_map.mpr ⟨(z : G), hzZ, ?_⟩
        simp [MulAut.conj_apply]
      have hK := hconj ((a : G)⁻¹) haA hmem
      simpa [← hay] using hK
    · exact K.one_mem
    · intro x y _ _ hx hy
      exact K.mul_mem hx hy
    · intro x _ hx
      exact K.inv_mem hx
  have hA_le_NV : A ≤ Subgroup.normalizer (V : Set G) := by
    intro a ha
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      rcases Subgroup.mem_map.mp hx with ⟨v, hv, rfl⟩
      let aA : A := ⟨a, ha⟩
      have hv' : aA * v * aA⁻¹ ∈ V_A :=
        (inferInstance : V_A.Normal).conj_mem v hv aA
      refine Subgroup.mem_map.mpr ⟨aA * v * aA⁻¹, hv', ?_⟩
      rfl
    · intro hx
      let aA : A := ⟨a, ha⟩
      rcases Subgroup.mem_map.mp hx with ⟨v, hv, hv_eq⟩
      have hv' : aA⁻¹ * v * (aA⁻¹)⁻¹ ∈ V_A :=
        (inferInstance : V_A.Normal).conj_mem v hv aA⁻¹
      refine Subgroup.mem_map.mpr ⟨aA⁻¹ * v * (aA⁻¹)⁻¹, hv', ?_⟩
      have hv_eq' : (v : G) = a * x * a⁻¹ := hv_eq
      have heq : a⁻¹ * (v : G) * a = x := by
        rw [hv_eq']
        group
      simpa [aA] using heq
  exact ⟨V, hZ_le_V, hV_le_K, hA_le_NV⟩

/-- If `A` is a `p`-subgroup of `N_G(V)` and `J` is a `p`-subgroup of
`C_G(V)`, choose a Sylow subgroup `Sstar` of `N_G(V)` containing `A` and
conjugate the Sylow intersection `Sstar ∩ C_G(V)` inside the centralizer so
that it contains `J`. -/
private lemma exists_sylow_normalizer_conjugate_contains
    (V A J : Subgroup G) (hAp : IsPGroup p A)
    (hA_le_NV : A ≤ Subgroup.normalizer (V : Set G)) (hJp : IsPGroup p J)
    (hJ_le_CV : J ≤ Subgroup.centralizer (V : Set G)) :
    ∃ Sstar : Sylow p ↥(Subgroup.normalizer (V : Set G)), ∃ c : G,
      c ∈ Subgroup.centralizer (V : Set G) ∧
        A ≤ (Sstar : Subgroup ↥(Subgroup.normalizer (V : Set G))).map
          (Subgroup.normalizer (V : Set G)).subtype ∧
        J ≤ conjSubgroup c
          ((Sstar : Subgroup ↥(Subgroup.normalizer (V : Set G))).map
            (Subgroup.normalizer (V : Set G)).subtype) := by
  let NV : Subgroup G := Subgroup.normalizer (V : Set G)
  let A_NV : Subgroup ↥NV := A.subgroupOf NV
  have hA_NVp : IsPGroup p A_NV :=
    hAp.of_equiv (Subgroup.subgroupOfEquivOfLe hA_le_NV).symm
  obtain ⟨Sstar, hA_NV_le_Sstar⟩ := hA_NVp.exists_le_sylow
  let SstarG : Subgroup G := (Sstar : Subgroup ↥NV).map NV.subtype
  have hA_le_SstarG : A ≤ SstarG := by
    intro a ha
    refine Subgroup.mem_map.mpr ⟨⟨a, hA_le_NV ha⟩, ?_, rfl⟩
    exact hA_NV_le_Sstar (Subgroup.mem_subgroupOf.mpr ha)
  let C : Subgroup G := Subgroup.centralizer (V : Set G)
  have hC_le_NV : C ≤ NV := Subgroup.centralizer_le_normalizer (V : Set G)
  let C_NV : Subgroup ↥NV := C.subgroupOf NV
  have : C_NV.Normal :=
    Subgroup.normal_subgroupOf_centralizer_normalizer (V : Set G)
  obtain ⟨P₀, hP₀⟩ := sylow_inf_normal (G := ↥NV) (p := p) (S := Sstar) (N := C_NV)
  let eC : ↥C ≃* ↥C_NV :=
    (Subgroup.subgroupOfEquivOfLe (H := C) (K := NV) hC_le_NV).symm
  let PC : Sylow p ↥C :=
    Sylow.mapSurjective (f := eC.symm.toMonoidHom) (hf := eC.symm.surjective) P₀
  have hPC_map : (PC : Subgroup ↥C).map C.subtype = C ⊓ SstarG := by
    have hPC_coe : (PC : Subgroup ↥C) = P₀.map eC.symm.toMonoidHom := by
      simp [PC]
    calc
      (PC : Subgroup ↥C).map C.subtype =
          (P₀.map eC.symm.toMonoidHom).map C.subtype := by rw [hPC_coe]
      _ = P₀.map (C.subtype.comp eC.symm.toMonoidHom) := by rw [Subgroup.map_map]
      _ = P₀.map (NV.subtype.comp C_NV.subtype) := by
        apply congrArg (fun f : ↥C_NV →* G => P₀.map f)
        rfl
      _ = (P₀.map C_NV.subtype).map NV.subtype := by rw [Subgroup.map_map]
      _ = (Sstar : Subgroup ↥NV).map NV.subtype ⊓ C_NV.map NV.subtype := by
        rw [hP₀]
        rw [Subgroup.map_subgroupOf_eq_of_le
          (H := (Sstar : Subgroup ↥NV) ⊓ C_NV) (K := C_NV) inf_le_right]
        rw [Subgroup.map_inf (H := (Sstar : Subgroup ↥NV)) (K := C_NV)
          (f := NV.subtype) NV.subtype_injective]
      _ = SstarG ⊓ C := by
        rw [map_subgroupOf_eq_of_le' hC_le_NV]
      _ = C ⊓ SstarG := inf_comm _ _
  let J_C : Subgroup ↥C := J.subgroupOf C
  have hJ_Cp : IsPGroup p J_C :=
    hJp.of_equiv (Subgroup.subgroupOfEquivOfLe hJ_le_CV).symm
  obtain ⟨Q, hJ_C_le_Q⟩ := hJ_Cp.exists_le_sylow
  obtain ⟨d, hd⟩ := MulAction.exists_smul_eq (↥C) PC Q
  let c : G := (d : G)⁻¹
  have hQ_eq : (Q : Subgroup ↥C) =
      (PC : Subgroup ↥C).map (MulAut.conj d).toMonoidHom := by
    have hd_coe := congrArg (fun R : Sylow p ↥C => (R : Subgroup ↥C)) hd
    rw [sylow_smul_subgroup_eq_map_conj] at hd_coe
    exact hd_coe.symm
  have hQ_map : (Q : Subgroup ↥C).map C.subtype =
      conjSubgroup c ((PC : Subgroup ↥C).map C.subtype) := by
    rw [hQ_eq]
    rw [Subgroup.map_map]
    rw [conjSubgroup, Subgroup.map_map]
    apply congrArg (fun f : ↥C →* G => (PC : Subgroup ↥C).map f)
    ext x
    simp [c, MulAut.conj_apply]
  refine ⟨Sstar, c, ?_, hA_le_SstarG, ?_⟩
  · exact C.inv_mem d.property
  · intro j hj
    have hjQ : (⟨j, hJ_le_CV hj⟩ : ↥C) ∈ (Q : Subgroup ↥C) :=
      hJ_C_le_Q (Subgroup.mem_subgroupOf.mpr hj)
    have hjQmap : j ∈ (Q : Subgroup ↥C).map C.subtype :=
      Subgroup.mem_map.mpr ⟨⟨j, hJ_le_CV hj⟩, hjQ, rfl⟩
    rw [hQ_map, hPC_map] at hjQmap
    exact Subgroup.map_mono inf_le_right hjQmap

/-- Step (I) of the proof of Theorem 5.1 ([6], §5, pp. 1117–1119):
if `g ∈ G` and `Z(S)^g ⊆ S`, then `Z(S)^g ⊆ Z(J(S))`.

This is the paper's most difficult step, requiring the methods of Burnside and
Thompson.  The formal proof is decomposed as follows:

1. **Normalizer growth** (for (5.1)): a proper subgroup `P < S` of a finite `p`-group
   satisfies `|N_S(P)| > |P|` — via `IsPGroup.card_modEq_card_fixedPoints` applied to
   the action of `P` on the cosets `S ⧸ P`, with the fixed points identified with
   `N_S(P) ⧸ P` by `Sylow.fixedPointsMulLeftCosetsEquivQuotient`.
2. **`D < S₁`**: among the Sylow `p`-subgroups `S₁` of `G` with `Z(S) ⊆ S₁` but
   `Z(S) ⊄ Z(J(S₁))` choose `S₁` maximizing `|N_G(J) ∩ S₁|`, `J = J(S)`,
   `D = N_G(J) ∩ S₁`; if `S₁ ≤ N_G(J)` then `J(S) ≤ S₁` (a `p`-subgroup normalized
   by a Sylow subgroup lies in it), so `J(S₁) = J(S)` by
   `thompsonSubgroup_eq_of_sylow_le`, and `Z(S) ⊆ Z(J(S)) = Z(J(S₁))`,
   contradicting the choice of `S₁` — hence `D < S₁`.
3. **(5.1)**: `|N_G(D) ∩ S₁| > |D|` (normalizer growth in the `p`-group `S₁`) and,
   for `T₀ ∈ Syl_p(N_G(J) ∩ N_G(D))`, `|T₀| > |D|` (as `D` is not a Sylow
   `p`-subgroup of `N_G(J)`).
4. **The `A`-argument** ((5.2), `A = D`): for `D ≤ A ≤ N_G(D) ∩ S₁` with
   `Z(S)^a ⊆ Z(J)` for all `a ∈ A`, the subgroup `V = ⟨Z(S)^a | a ∈ A⟩` has
   `J ⊆ C_G(V)`, `A ⊆ N_G(V)`; with `S* ∈ Syl_p(N_G(V))` containing `A` and
   `c ∈ C_G(V)` such that `J ⊆ (S* ∩ C_G(V))^c ⊆ S*^c`, one gets `J = J(S*^c)`,
   `A^c ⊆ S*^c ⊆ N_G(J)` and `|S₁^c ∩ N_G(J)| ≥ |A|`; maximality of
   `|N_G(J) ∩ S₁|` forces `A = D`; hence `Z(S₁) ⊆ D` and there is
   `a ∈ N_G(D) ∩ S₁` with `Z(S)^a ⊄ Z(J)`.
5. **The partially ordered set `H`** of non-identity `p`-subgroups `H` with (i) a
   Sylow `p`-subgroup `T` of `N_G(H)` and `g ∈ N_G(H)` with `Z(S) ⊆ T`,
   `Z(S)^g = Z(S)^a ⊆ T`, `|N_T(J)| > |D|`, and (ii) (under hypothesis (a))
   `Z(S₂) ⊆ H ⊆ S₂` for some Sylow `S₂` of `G`; `D ∈ H`; the lexicographic order on
   `(|N_G(H)|_p, |N_G(H)|)`; a maximal `H` has `N = N_G(H)` satisfying `(C_p)`
   (by (a) with `H`, or by (b) since maximality forces `N ∈ M_p(G)`).
6. **`T` is Sylow in `G`**: with `n ∈ N_N(Z(J(T)))` sending `Z(S)` to `Z(S)^a`,
   `T* ∈ Syl_p(N_G(Z(J(T))))` containing `T`, and `S₃ ∈ Syl_p(G)` containing `T*`,
   one has `Z(J(T)) ∈ H`, so maximality of `H` gives
   `|N_G(T)|_p ≤ |T*| ≤ |N_G(H)|_p = |T|`, hence `T ∈ Syl_p(G)` and (choice of `S₁`)
   `Z(S) ⊆ Z(J(T))`.
7. **Final conjugation**: with `S = T^b`, `c ∈ C_G(Z(S))` such that `J(T) ⊆ S^c`,
   `h = cb ∈ N_G(J)`, `k = n^b ∈ N_G(J)`, `Y = Z(S)^{hkh⁻¹} ⊆ Z(J)`, one has
   `Z(S)^a = Y^c ⊆ D ⊆ N_G(Z(J))`; taking `M = N_G(Z(S))` (case (a)) or
   `M ∈ M_p(G)` containing `N_G(Z(S))` (case (b), existence via
   `exists_MpSet_of_core_ne_bot`), `(C_p*)` in `M` (Lemma 5.1) applied to the
   conjugate pair `(Y, Y^c)` gives `m ∈ N_M(Z(J))` with `Y^c = Y^m ⊆ Z(J)`,
   contradicting the choice of `a`. -/
public theorem theorem5_1_step_I (S : Sylow p G) (h : Theorem51HypA p G ∨ Theorem51HypB p G) :
    ∀ g : G, conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (S : Subgroup G) →
      conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (ZJ (S : Subgroup G) : Set G) := by
  classical
  intro g hgS
  by_contra hbad
  let Z : Subgroup G := Zsub (S : Subgroup G)
  let J : Subgroup G := thompsonSubgroup (S : Subgroup G)
  let Sbad : Sylow p G := g • S
  have hSbad_coe : (Sbad : Subgroup G) =
      (S : Subgroup G).map (MulAut.conj g).toMonoidHom := by
    exact sylow_smul_subgroup_eq_map_conj g S
  have hZ_le_Sbad : Z ≤ (Sbad : Subgroup G) := by
    intro z hz
    rw [hSbad_coe]
    refine Subgroup.mem_map.mpr ⟨g⁻¹ * z * g, ?_, ?_⟩
    · exact hgS ⟨z, hz, rfl⟩
    · simp [MulAut.conj_apply]
      group
  have hZJ_Sbad : ZJ (Sbad : Subgroup G) =
      (ZJ (S : Subgroup G)).map (MulAut.conj g).toMonoidHom := by
    change thompsonCenter (Sbad : Subgroup G) =
      (thompsonCenter (S : Subgroup G)).map (MulAut.conj g).toMonoidHom
    rw [hSbad_coe, thompsonCenter_map_mulEquiv]
  have hZ_not_le_ZJ_Sbad : ¬ Z ≤ ZJ (Sbad : Subgroup G) := by
    intro hZ
    apply hbad
    intro y hy
    rcases hy with ⟨z, hz, rfl⟩
    have hz' : z ∈ (ZJ (S : Subgroup G)).map (MulAut.conj g).toMonoidHom := by
      rw [← hZJ_Sbad]
      exact hZ hz
    rcases Subgroup.mem_map.mp hz' with ⟨t, ht, rfl⟩
    simpa [MulAut.conj_apply, mul_assoc] using ht
  let Bad : Set (Sylow p G) :=
    {Q | Z ≤ (Q : Subgroup G) ∧ ¬ Z ≤ ZJ (Q : Subgroup G)}
  have hBad_ne : Bad.Nonempty := ⟨Sbad, hZ_le_Sbad, hZ_not_le_ZJ_Sbad⟩
  have hBad_fin : Bad.Finite := Set.toFinite Bad
  obtain ⟨S₁, hS₁max⟩ := hBad_fin.exists_maximalFor
    (fun Q : Sylow p G =>
      Nat.card (↥(Subgroup.normalizer (J : Set G) ⊓ (Q : Subgroup G))))
    Bad hBad_ne
  have hS₁Bad : S₁ ∈ Bad := hS₁max.1
  have hS₁max_card : ∀ Q : Sylow p G, Q ∈ Bad →
      Nat.card (↥(Subgroup.normalizer (J : Set G) ⊓ (Q : Subgroup G))) ≤
        Nat.card (↥(Subgroup.normalizer (J : Set G) ⊓ (S₁ : Subgroup G))) :=
    by
      intro Q hQ
      rcases le_total
          (Nat.card (↥(Subgroup.normalizer (J : Set G) ⊓ (Q : Subgroup G))))
          (Nat.card (↥(Subgroup.normalizer (J : Set G) ⊓ (S₁ : Subgroup G)))) with
        hle | hle
      · exact hle
      · exact hS₁max.2 hQ hle
  let D : Subgroup G := Subgroup.normalizer (J : Set G) ⊓ (S₁ : Subgroup G)
  have hJp : IsPGroup p J := by
    apply IsPGroup.to_le S.isPGroup'
    exact thompsonSubgroup_le_local (S : Subgroup G)
  have hZ_le_ZJ : Z ≤ ZJ (S : Subgroup G) := by
    intro z hz
    change z ∈ centerIn J
    change z ∈ centerIn (S : Subgroup G) at hz
    refine ⟨centerIn_le_thompsonSubgroup (S : Subgroup G) hz, ?_⟩
    exact Subgroup.mem_centralizer_iff.mpr (fun y hy =>
      (Subgroup.mem_centralizer_iff.mp hz.2) y
        (thompsonSubgroup_le_local (S : Subgroup G) hy))
  have hJ_not_le_S₁ : ¬ J ≤ (S₁ : Subgroup G) := by
    intro hJ_le_S₁
    have hJ_eq : thompsonSubgroup (S : Subgroup G) =
        thompsonSubgroup (S₁ : Subgroup G) := by
      exact thompsonSubgroup_eq_of_sylow_le_core S₁ S hJ_le_S₁
    apply hS₁Bad.2
    intro z hz
    change z ∈ centerIn (thompsonSubgroup (S₁ : Subgroup G))
    change z ∈ centerIn (S : Subgroup G) at hz
    refine ⟨?_, ?_⟩
    · rw [← hJ_eq]
      exact centerIn_le_thompsonSubgroup (S : Subgroup G) hz
    · show ∀ y ∈ (thompsonSubgroup (S₁ : Subgroup G) : Set G), y * z = z * y
      intro y hy
      rw [← hJ_eq] at hy
      exact (Subgroup.mem_centralizer_iff.mp hz.2) y
        (thompsonSubgroup_le_local (S : Subgroup G) hy)
  have hD_lt_S₁ : D < (S₁ : Subgroup G) := by
    refine lt_of_le_of_ne inf_le_right ?_
    intro hD_eq
    have hS₁_le_NJ : (S₁ : Subgroup G) ≤ Subgroup.normalizer (J : Set G) := by
      apply (inf_eq_right.mp :
        Subgroup.normalizer (J : Set G) ⊓ (S₁ : Subgroup G) = (S₁ : Subgroup G) → _)
      simpa [D] using hD_eq
    have hsup_p : IsPGroup p (J ⊔ (S₁ : Subgroup G) : Subgroup G) :=
      hJp.to_sup_of_normal_left' S₁.isPGroup' hS₁_le_NJ
    have hsup_eq : J ⊔ (S₁ : Subgroup G) = (S₁ : Subgroup G) :=
      S₁.is_maximal' hsup_p le_sup_right
    exact hJ_not_le_S₁ (sup_eq_right.mp hsup_eq)
  let D₁ : Subgroup ↥(S₁ : Subgroup G) := D.subgroupOf (S₁ : Subgroup G)
  have hD₁_lt_top : D₁ < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro htop
    have hS₁_le_D : (S₁ : Subgroup G) ≤ D :=
      Subgroup.subgroupOf_eq_top.mp (by simpa [D₁] using htop)
    exact hD_lt_S₁.2 hS₁_le_D
  have hD₁_lt_normalizer : D₁ < Subgroup.normalizer (D₁ : Set ↥(S₁ : Subgroup G)) :=
    normalizer_lt_of_lt_of_isPGroup (P := ↥(S₁ : Subgroup G)) (p := p)
      S₁.isPGroup' hD₁_lt_top
  have hnormalizer_D₁ :
      Subgroup.normalizer (D₁ : Set ↥(S₁ : Subgroup G)) =
        ((Subgroup.normalizer (D : Set G)) ⊓ (S₁ : Subgroup G)).subgroupOf
          (S₁ : Subgroup G) := by
    have hsubgroupOf :
        (Subgroup.normalizer (D : Set G)).subgroupOf (S₁ : Subgroup G) =
          Subgroup.normalizer (D.subgroupOf (S₁ : Subgroup G)) :=
      Subgroup.subgroupOf_normalizer_eq (H := D) (N := (S₁ : Subgroup G)) hD_lt_S₁.le
    simpa [D₁, Subgroup.inf_subgroupOf_right] using hsubgroupOf.symm
  have hnormalizer_card_gt :
      Nat.card D <
        Nat.card (↥(Subgroup.normalizer (D : Set G) ⊓ (S₁ : Subgroup G))) := by
    calc
      Nat.card D = Nat.card D₁ := by
        exact (Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe (H := D) (K := (S₁ : Subgroup G))
            hD_lt_S₁.le).toEquiv).symm
      _ < Nat.card (↥(Subgroup.normalizer (D₁ : Set ↥(S₁ : Subgroup G)))) :=
        natCard_lt_of_subgroup_lt hD₁_lt_normalizer
      _ = Nat.card (↥(Subgroup.normalizer (D : Set G) ⊓ (S₁ : Subgroup G))) := by
        rw [hnormalizer_D₁]
        exact Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe
            (H := Subgroup.normalizer (D : Set G) ⊓ (S₁ : Subgroup G))
            (K := (S₁ : Subgroup G)) inf_le_right).toEquiv
  let NJ : Subgroup G := Subgroup.normalizer (J : Set G)
  have hD_le_NJ : D ≤ NJ := by
    exact inf_le_left
  let D_J : Subgroup ↥NJ := D.subgroupOf NJ
  have hDp : IsPGroup p D := S₁.isPGroup'.to_le hD_lt_S₁.le
  have hD_Jp : IsPGroup p D_J :=
    hDp.of_equiv (Subgroup.subgroupOfEquivOfLe hD_le_NJ).symm
  obtain ⟨P, hD_J_le_P⟩ := hD_Jp.exists_le_sylow
  have hJ_le_NJ : J ≤ NJ := by
    exact Subgroup.le_normalizer
  let J_J : Subgroup ↥NJ := J.subgroupOf NJ
  have hJ_Jp : IsPGroup p J_J :=
    hJp.of_equiv (Subgroup.subgroupOfEquivOfLe hJ_le_NJ).symm
  have hJ_J_le_P : J_J ≤ (P : Subgroup ↥NJ) := by
    exact (le_pCore_of_normal_isPGroup (G := ↥NJ) (p := p)
      (N := J_J) (inferInstance : J_J.Normal) hJ_Jp).trans
        (pCore_le_sylow (G := ↥NJ) P)
  have hD_J_lt_P : D_J < (P : Subgroup ↥NJ) := by
    refine lt_of_le_of_ne hD_J_le_P ?_
    intro hD_J_eq
    apply hJ_not_le_S₁
    intro x hxJ
    have hxNJ : x ∈ NJ := hJ_le_NJ hxJ
    have hxJ_J : (⟨x, hxNJ⟩ : ↥NJ) ∈ J_J := by
      exact Subgroup.mem_subgroupOf.mpr hxJ
    have hxP : (⟨x, hxNJ⟩ : ↥NJ) ∈ (P : Subgroup ↥NJ) := hJ_J_le_P hxJ_J
    have hxD_J : (⟨x, hxNJ⟩ : ↥NJ) ∈ D_J := by
      rw [hD_J_eq]
      exact hxP
    exact hD_lt_S₁.le (Subgroup.mem_subgroupOf.mp hxD_J)
  let D_P : Subgroup ↥(P : Subgroup ↥NJ) := D_J.subgroupOf (P : Subgroup ↥NJ)
  have hD_P_lt_top : D_P < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro htop
    have hP_le_D_J : (P : Subgroup ↥NJ) ≤ D_J :=
      Subgroup.subgroupOf_eq_top.mp (by simpa [D_P] using htop)
    exact hD_J_lt_P.2 hP_le_D_J
  have hD_P_lt_normalizer :
      D_P < Subgroup.normalizer (D_P : Set ↥(P : Subgroup ↥NJ)) :=
    normalizer_lt_of_lt_of_isPGroup (P := ↥(P : Subgroup ↥NJ)) (p := p)
      P.isPGroup' hD_P_lt_top
  let ιP : ↥(P : Subgroup ↥NJ) →* G :=
    NJ.subtype.comp (P : Subgroup ↥NJ).subtype
  have hιP_injective : Function.Injective ιP := by
    intro x y hxy
    apply Subtype.ext
    apply Subtype.ext
    simpa [ιP] using hxy
  let E : Subgroup G :=
