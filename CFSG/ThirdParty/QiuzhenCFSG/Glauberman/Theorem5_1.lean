    exact ((Subgroup.mem_centralizer_iff.mp hz.2) s hs).symm
  have hS_le_NZ : (S : Subgroup G) ≤ Subgroup.normalizer (Z : Set G) :=
    hS_le_CZ.trans (Subgroup.centralizer_le_normalizer (Z : Set G))
  let JT : Subgroup G := thompsonSubgroup TG
  have hJTp : IsPGroup p JT :=
    hTGp.to_le (thompsonSubgroup_le_local (G := G) TG)
  have hJT_le_CZ : JT ≤ Subgroup.centralizer (Z : Set G) := by
    intro j hj
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    exact (Subgroup.mem_centralizer_iff.mp (hZ_le_L hz).2) j hj |>.symm
  obtain ⟨S_Z, c, hc_CZ, hS_le_S_ZG, hJT_le_cS_ZG⟩ :=
    exists_sylow_normalizer_conjugate_contains
      Z (S : Subgroup G) JT S.isPGroup' hS_le_NZ hJTp hJT_le_CZ
  let S_ZG : Subgroup G :=
    (S_Z : Subgroup ↥(Subgroup.normalizer (Z : Set G))).map
      (Subgroup.normalizer (Z : Set G)).subtype
  change (S : Subgroup G) ≤ S_ZG at hS_le_S_ZG
  change JT ≤ conjSubgroup c S_ZG at hJT_le_cS_ZG
  have hS_ZGp : IsPGroup p S_ZG :=
    IsPGroup.map S_Z.isPGroup' (Subgroup.normalizer (Z : Set G)).subtype
  have hS_ZG_eq_S : S_ZG = (S : Subgroup G) :=
    S.is_maximal' hS_ZGp hS_le_S_ZG
  have hJT_le_Sc : JT ≤ conjSubgroup c (S : Subgroup G) := by
    simpa [hS_ZG_eq_S] using hJT_le_cS_ZG
  let Sc : Sylow p G := c⁻¹ • S
  have hSc_coe : (Sc : Subgroup G) = conjSubgroup c (S : Subgroup G) := by
    dsimp [Sc]
    rw [sylow_smul_subgroup_eq_map_conj]
    rfl
  have hJT_eq_JSc : JT = thompsonSubgroup (Sc : Subgroup G) := by
    simpa [JT, hS_T_eq, hSc_coe] using
      (thompsonSubgroup_eq_of_sylow_le_core Sc S_T (by
        simpa [JT, hS_T_eq, hSc_coe] using hJT_le_Sc))
  have hJSc_eq_Jc : thompsonSubgroup (Sc : Subgroup G) = conjSubgroup c J := by
    rw [hSc_coe]
    change thompsonSubgroup
        ((S : Subgroup G).map (MulAut.conj c⁻¹).toMonoidHom) =
      J.map (MulAut.conj c⁻¹).toMonoidHom
    rw [thompsonSubgroup_map_mulEquiv]
  have hJT_eq_Jc : JT = conjSubgroup c J := hJT_eq_JSc.trans hJSc_eq_Jc
  obtain ⟨b₀, hb₀⟩ := MulAction.exists_smul_eq G S_T S
  let b : G := b₀⁻¹
  have hS_eq_TGb : (S : Subgroup G) = conjSubgroup b TG := by
    have hbcoe := congrArg (fun Q : Sylow p G => (Q : Subgroup G)) hb₀
    rw [sylow_smul_subgroup_eq_map_conj] at hbcoe
    simpa [b, conjSubgroup, hS_T_eq] using hbcoe.symm
  have hJTG_b_eq_J : conjSubgroup b JT = J := by
    calc
      conjSubgroup b JT = thompsonSubgroup (conjSubgroup b TG) := by
        change JT.map (MulAut.conj b⁻¹).toMonoidHom =
          thompsonSubgroup (TG.map (MulAut.conj b⁻¹).toMonoidHom)
        exact (thompsonSubgroup_map_mulEquiv (G := G) (MulAut.conj b⁻¹) TG).symm
      _ = thompsonSubgroup (S : Subgroup G) := by rw [← hS_eq_TGb]
      _ = J := rfl
  let hh : G := c * b
  have hJhh_eq : conjSubgroup hh J = J := by
    calc
      conjSubgroup hh J = conjSubgroup b (conjSubgroup c J) := by
        exact (conjSubgroup_comp c b J).symm
      _ = conjSubgroup b JT := by rw [hJT_eq_Jc]
      _ = J := hJTG_b_eq_J
  have hhh_mem_NJ : hh ∈ NJ := by
    have hhinv : hh⁻¹ ∈ NJ := by
      change hh⁻¹ ∈ Subgroup.normalizer (J : Set G)
      rw [Subgroup.mem_normalizer_iff_map_conj_eq]
      simpa [conjSubgroup] using hJhh_eq
    simpa using NJ.inv_mem hhinv
  have hhh_mem_NZJ : hh ∈
      Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    have hJmap : J.map (MulAut.conj hh).toMonoidHom = J :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp hhh_mem_NJ
    change (centerIn J).map (MulAut.conj hh).toMonoidHom = centerIn J
    rw [centerIn_map_mulEquiv, hJmap]
  have hLb_eq_ZJ : conjSubgroup b L = ZJ (S : Subgroup G) := by
    calc
      conjSubgroup b L =
          (thompsonCenter TG).map (MulAut.conj b⁻¹).toMonoidHom := rfl
      _ = thompsonCenter (TG.map (MulAut.conj b⁻¹).toMonoidHom) :=
        (thompsonCenter_map_mulEquiv (G := G) (MulAut.conj b⁻¹) TG).symm
      _ = thompsonCenter (conjSubgroup b TG) := rfl
      _ = thompsonCenter (S : Subgroup G) :=
        congrArg (fun P : Subgroup G => thompsonCenter P) hS_eq_TGb.symm
  let k : G := b⁻¹ * (n_N : G) * b
  have hk_mem_conj_NL : k ∈ conjSubgroup b NL := by
    refine Subgroup.mem_map.mpr ⟨(n_N : G), hn_normalizes_L, ?_⟩
    simp [k]
  have hk_mem_NZJ : k ∈
      Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := by
    rw [← hLb_eq_ZJ, normalizer_conjSubgroup]
    exact hk_mem_conj_NL
  let r : G := hh * k * hh⁻¹
  have hr_mem_NZJ : r ∈
      Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := by
    exact (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).mul_mem
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).mul_mem
        hhh_mem_NZJ hk_mem_NZJ)
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).inv_mem
        hhh_mem_NZJ)
  let Y : Subgroup G := conjSubgroup r Z
  have hZJr_eq : conjSubgroup r (ZJ (S : Subgroup G) : Subgroup G) =
      ZJ (S : Subgroup G) :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp
      ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).inv_mem
        hr_mem_NZJ)
  have hY_le_ZJ : Y ≤ ZJ (S : Subgroup G) := by
    rw [← hZJr_eq]
    exact Subgroup.map_mono hZ_le_ZJ
  have hn_decomp : (n_N : G) = c⁻¹ * r * c := by
    dsimp [r, hh, k]
    group
  have hZc_inv : conjSubgroup c⁻¹ Z = Z := by
    have hcNZ : c ∈ Subgroup.normalizer (Z : Set G) :=
      mem_normalizer_of_centralizer hc_CZ
    simpa [conjSubgroup] using
      (Subgroup.mem_normalizer_iff_map_conj_eq.mp hcNZ)
  have hYc_eq_Za : conjSubgroup c Y = conjSubgroup a Z := by
    calc
      conjSubgroup c Y = conjSubgroup (r * c) Z := conjSubgroup_comp r c Z
      _ = conjSubgroup (c⁻¹ * (r * c)) Z := by
        rw [← conjSubgroup_comp c⁻¹ (r * c) Z, hZc_inv]
      _ = conjSubgroup (c⁻¹ * r * c) Z := by
        congr 1
        group
      _ = conjSubgroup (n_N : G) Z := by rw [← hn_decomp]
      _ = conjSubgroup a Z := hZn_eq_Za
  have hNJ_le_NZJ : NJ ≤
      Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := by
    intro x hx
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    have hJmap : J.map (MulAut.conj x).toMonoidHom = J :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp hx
    change (centerIn J).map (MulAut.conj x).toMonoidHom = centerIn J
    rw [centerIn_map_mulEquiv, hJmap]
  have hYc_le_NZJ : conjSubgroup c Y ≤
      Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) :=
    hYc_eq_Za.le.trans (hZa_le_D.trans (hD_le_NJ.trans hNJ_le_NZJ))
  have hfinal : ∀ (M : Subgroup G) (hS_le_M : (S : Subgroup G) ≤ M), c ∈ M →
      Cp (G := ↥M) (zjCharacteristicFunctor p) (S.subtype hS_le_M) → False := by
    intro M hS_le_M hc_M hCpM
    let S_M : Sylow p ↥M := S.subtype hS_le_M
    have hZJ_map : (ZJ (S_M : Subgroup ↥M) : Subgroup ↥M).map M.subtype =
        ZJ (S : Subgroup G) := by
      simpa [S_M, ZJ] using
        (thompsonCenter_subgroupOf (G := G) M (S : Subgroup G) hS_le_M)
    have hNM_eq : Subgroup.normalizer (ZJ (S_M : Subgroup ↥M) : Set ↥M) =
        (Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).comap
          M.subtype := by
      ext x
      rw [mem_normalizer_map_subtype_iff
        (M := M) (H := ZJ (S_M : Subgroup ↥M)) (x := x)]
      rw [hZJ_map]
      rfl
    have hZJ_le_S : ZJ (S : Subgroup G) ≤ (S : Subgroup G) := by
      intro x hx
      exact thompsonSubgroup_le_local (G := G) (S : Subgroup G) hx.1
    have hY_le_M : Y ≤ M := hY_le_ZJ.trans (hZJ_le_S.trans hS_le_M)
    have hYp : IsPGroup p Y := S.isPGroup'.to_le (hY_le_ZJ.trans hZJ_le_S)
    let Y_M : Subgroup ↥M := Y.subgroupOf M
    have hY_Mp : IsPGroup p Y_M :=
      hYp.of_equiv (Subgroup.subgroupOfEquivOfLe hY_le_M).symm
    have hY_le_NZJ : Y ≤
        Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) :=
      hY_le_ZJ.trans Subgroup.le_normalizer
    have hY_M_le_NM : Y_M ≤
        Subgroup.normalizer (ZJ (S_M : Subgroup ↥M) : Set ↥M) := by
      rw [hNM_eq, ← Subgroup.map_le_iff_le_comap]
      rw [Subgroup.map_subgroupOf_eq_of_le hY_le_M]
      exact hY_le_NZJ
    let c_M : ↥M := ⟨c, hc_M⟩
    have hYc_M_map : (conjSubgroup c_M Y_M).map M.subtype = conjSubgroup c Y := by
      simpa [conjSubgroup, c_M, Y_M] using
        (map_subtype_map_conj (N := M) (W := Y) hY_le_M (m := c_M⁻¹))
    have hYc_M_le_NM : conjSubgroup c_M Y_M ≤
        Subgroup.normalizer (ZJ (S_M : Subgroup ↥M) : Set ↥M) := by
      rw [hNM_eq, ← Subgroup.map_le_iff_le_comap, hYc_M_map]
      exact hYc_le_NZJ
    have hCpStarM : CpStar (G := ↥M) (zjCharacteristicFunctor p) S_M :=
      (lemma5_1 (G := ↥M) (zjCharacteristicFunctor p) S_M).mp hCpM
    rcases hCpStarM Y_M hY_Mp hY_M_le_NM c_M hYc_M_le_NM with
      ⟨d_M, m_M, hd_M, hm_M, hc_M_eq⟩
    have hd_M_normalizes : d_M ∈ Subgroup.normalizer (Y_M : Set ↥M) :=
      Subgroup.centralizer_le_normalizer (Y_M : Set ↥M) hd_M
    have hYd_M : conjSubgroup d_M Y_M = Y_M :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp
        ((Subgroup.normalizer (Y_M : Set ↥M)).inv_mem hd_M_normalizes)
    have hYc_eq_Ym_M : conjSubgroup c_M Y_M = conjSubgroup m_M Y_M := by
      calc
        conjSubgroup c_M Y_M = conjSubgroup (d_M * m_M) Y_M := by rw [hc_M_eq]
        _ = conjSubgroup m_M (conjSubgroup d_M Y_M) :=
          (conjSubgroup_comp d_M m_M Y_M).symm
        _ = conjSubgroup m_M Y_M := by rw [hYd_M]
    have hYm_M_map : (conjSubgroup m_M Y_M).map M.subtype =
        conjSubgroup (m_M : G) Y := by
      simpa [conjSubgroup, Y_M] using
        (map_subtype_map_conj (N := M) (W := Y) hY_le_M (m := m_M⁻¹))
    have hYc_eq_Ym : conjSubgroup c Y = conjSubgroup (m_M : G) Y := by
      calc
        conjSubgroup c Y = (conjSubgroup c_M Y_M).map M.subtype := hYc_M_map.symm
        _ = (conjSubgroup m_M Y_M).map M.subtype := by rw [hYc_eq_Ym_M]
        _ = conjSubgroup (m_M : G) Y := hYm_M_map
    have hm_G : (m_M : G) ∈
        Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) := by
      have hm_map := (mem_normalizer_map_subtype_iff
        (M := M) (H := ZJ (S_M : Subgroup ↥M)) m_M).mp hm_M
      simpa [hZJ_map] using hm_map
    have hZJm_eq : conjSubgroup (m_M : G) (ZJ (S : Subgroup G) : Subgroup G) =
        ZJ (S : Subgroup G) :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp
        ((Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G)).inv_mem hm_G)
    have hYm_le_ZJ : conjSubgroup (m_M : G) Y ≤ ZJ (S : Subgroup G) := by
      rw [← hZJm_eq]
      exact Subgroup.map_mono hY_le_ZJ
    apply ha_bad
    rw [← hYc_eq_Za, hYc_eq_Ym]
    exact hYm_le_ZJ
  let XZ : Subgroup G := Subgroup.normalizer (Z : Set G)
  have hS_le_XZ : (S : Subgroup G) ≤ XZ := hS_le_NZ
  have hc_XZ : c ∈ XZ := mem_normalizer_of_centralizer hc_CZ
  rcases h with hA | hB
  · apply hfinal XZ hS_le_XZ hc_XZ
    have hSat := hA S Z (by rfl) hZ_le_S
    exact hSat (S.subtype hS_le_XZ)
  · have hZ_ne : Z ≠ ⊥ := by
      intro hZbot
      apply ha_bad
      rw [hZbot]
      simp [conjSubgroup]
    have hZp : IsPGroup p Z := S.isPGroup'.to_le hZ_le_S
    have hZ_le_XZ : Z ≤ XZ := hZ_le_S.trans hS_le_XZ
    have hZnormal : (Z.subgroupOf XZ).Normal := Subgroup.normal_in_normalizer
    have hZ_XZp : IsPGroup p (Z.subgroupOf XZ) :=
      hZp.of_equiv (Subgroup.subgroupOfEquivOfLe hZ_le_XZ).symm
    have hXZcore : pCore p ↥XZ ≠ ⊥ := by
      intro hcore
      have hZsub_le_core : Z.subgroupOf XZ ≤ pCore p ↥XZ :=
        le_pCore_of_normal_isPGroup hZnormal hZ_XZp
      have hZsub_ne : Z.subgroupOf XZ ≠ ⊥ := by
        intro hbot
        apply hZ_ne
        have hmap : (Z.subgroupOf XZ).map XZ.subtype = Z :=
          Subgroup.map_subgroupOf_eq_of_le hZ_le_XZ
        simpa [hbot] using hmap.symm
      exact hZsub_ne (le_bot_iff.mp (hZsub_le_core.trans (le_of_eq hcore)))
    obtain ⟨M, hM_mp, hXZ_le_M⟩ :=
      exists_MpSet_of_core_ne_bot (G := G) (p := p) hXZcore
    apply hfinal M (hS_le_XZ.trans hXZ_le_M) (hXZ_le_M hc_XZ)
    exact (hB M hM_mp) (S.subtype (hS_le_XZ.trans hXZ_le_M))

/-- If `S₁` and `S₂` are Sylow `p`-subgroups of `G` and `J(S₂) ≤ S₁`, then
`J(S₂) = J(S₁)`.  This is the hidden content of the line "Clearly, `J^n = J(S) = J`"
in step (II) of the proof of Theorem 5.1 ([6], §5, p. 1119): `J(S₂)` is generated by
the abelian subgroups of `S₂` of maximal order, which are also the abelian subgroups
of `S₁` of maximal order (orders are preserved under conjugation of Sylow subgroups),
and `J(S₂)` and `J(S₁)` have the same cardinality. -/
public theorem thompsonSubgroup_eq_of_sylow_le (S₁ S₂ : Sylow p G)
    (hJ : thompsonSubgroup (S₂ : Subgroup G) ≤ (S₁ : Subgroup G)) :
    thompsonSubgroup (S₂ : Subgroup G) = thompsonSubgroup (S₁ : Subgroup G) := by
  exact thompsonSubgroup_eq_of_sylow_le_core S₁ S₂ hJ

/-- Step (II) of Theorem 5.1: `G` satisfies `(C_p)` for `W = Z(S)`
([6], §5, p. 1119).  Proof: by (I), `Z(S)^g ⊆ Z(J)`; hence `J^{g⁻¹}` and `S` are
`p`-subgroups of `C(Z(S))`, and since `S` is a Sylow `p`-subgroup of `C(Z(S))` there
is `c ∈ C(Z(S))` with `(J^{g⁻¹})^c ⊆ S`; for `n = g⁻¹c` we get `J^n = J(S^n) ≤ S`,
hence `J^n = J` by `thompsonSubgroup_eq_of_sylow_le`, so `n ∈ N(J) ⊆ N(Z(J))` and
`g = cn⁻¹`. -/
public theorem theorem5_1_step_II (S : Sylow p G)
    (hI : ∀ g : G, conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (S : Subgroup G) →
      conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (ZJ (S : Subgroup G) : Set G)) :
    ∀ g : G, conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (S : Subgroup G) →
      ∃ c n : G,
        c ∈ Subgroup.centralizer (Zsub (S : Subgroup G) : Set G) ∧
          n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
            g = c * n := by
  intro g hg
  let Z : Subgroup G := Zsub (S : Subgroup G)
  let ZJ' : Subgroup G := ZJ (S : Subgroup G)
  have hgZJ : conjSubset g (Z : Set G) ⊆ (ZJ' : Set G) := hI g hg
  -- `Z(S) ⊆ Z(J)^{g⁻¹}`, so `J(S^g)` centralizes `Z(S)`
  let J' : Subgroup G := thompsonSubgroup ((S : Subgroup G).map (MulAut.conj g).toMonoidHom)
  have hZ_le_CJ' : Z ≤ Subgroup.centralizer (J' : Set G) := by
    have h1 : (Z : Set G) ⊆ (conjSubset (g⁻¹) (ZJ' : Set G)) := by
      intro z hz
      have hz' : z ∈ conjSubset (g⁻¹) (conjSubset g (Z : Set G)) := by
        rw [conjSubset_comp (a := g) (b := g⁻¹)]
        simpa [conjSubset] using hz
      rcases hz' with ⟨w, hw, rfl⟩
      exact ⟨w, hgZJ hw, by group⟩
    have h2 : (conjSubset (g⁻¹) (ZJ' : Set G)) =
        ((ZJ').map (MulAut.conj g).toMonoidHom : Set G) := by
      rw [conjSubset_eq_conjSubgroup]
      congr 1
      rw [conjSubgroup]
      congr 1
      simp
    have h4 : ZJ (S.map (MulAut.conj g).toMonoidHom) ≤ Subgroup.centralizer (J' : Set G) := by
      -- ZJ (S.map conj g) = centerIn (thompsonSubgroup (S.map conj g)) ≤ centralizer J'
      exact inf_le_right
    intro z hz
    have hz1' : z ∈ ((ZJ').map (MulAut.conj g).toMonoidHom : Set G) := by
      rw [← h2]
      exact h1 hz
    have hz1 : z ∈ (ZJ (S.map (MulAut.conj g).toMonoidHom) : Set G) := by
      change z ∈ (thompsonCenter (S.map (MulAut.conj g).toMonoidHom) : Set G)
      rw [thompsonCenter_map_mulEquiv (G := G) (MulAut.conj g) (S : Subgroup G)]
      simpa [ZJ, ZJ'] using hz1'
    exact h4 hz1
  have hJ'_le_CZ : J' ≤ Subgroup.centralizer (Z : Set G) := by
    intro j hj z hz
    exact (Subgroup.mem_centralizer_iff.mp (hZ_le_CJ' hz) j hj).symm
  -- `S` is a Sylow `p`-subgroup of `C(Z(S))`
  have hS_le_CZ : (S : Subgroup G) ≤ Subgroup.centralizer (Z : Set G) := by
    intro s hs z hz
    exact ((Subgroup.mem_centralizer_iff.mp hz.2) s hs).symm
  let C : Subgroup G := Subgroup.centralizer (Z : Set G)
  let S₀ : Sylow p ↥C := S.subtype hS_le_CZ
  -- `J'` is a `p`-subgroup of `C`
  have hJ'p : IsPGroup p J' := by
    apply IsPGroup.to_le (hK := IsPGroup.map (H := (S : Subgroup G)) S.isPGroup'
      (MulAut.conj g).toMonoidHom)
    exact thompsonSubgroup_le_local (G := G) ((S : Subgroup G).map (MulAut.conj g).toMonoidHom)
  let J₀ : Subgroup ↥C := J'.subgroupOf C
  have hJ₀p : IsPGroup p J₀ := hJ'p.of_equiv (Subgroup.subgroupOfEquivOfLe hJ'_le_CZ).symm
  obtain ⟨P, hJ₀_le_P⟩ := IsPGroup.exists_le_sylow (G := ↥C) (p := p) hJ₀p
  obtain ⟨c', hc'⟩ := MulAction.exists_smul_eq (↥C) P S₀
  have hJ₀c_le_S₀ : (J₀ : Subgroup ↥C).map (MulAut.conj (c' : ↥C)).toMonoidHom ≤ S₀ := by
    calc
      (J₀ : Subgroup ↥C).map (MulAut.conj (c' : ↥C)).toMonoidHom
          ≤ (P : Subgroup ↥C).map (MulAut.conj (c' : ↥C)).toMonoidHom := by
            exact Subgroup.map_mono hJ₀_le_P
      _ = ((c' • P : Sylow p ↥C) : Subgroup ↥C) := by
            exact (sylow_smul_subgroup_eq_map_conj (m := c') (P := P)).symm
      _ = (S₀ : Subgroup ↥C) := by
            exact congrArg (fun Q : Sylow p ↥C => (Q : Subgroup ↥C)) hc'
  have hS₀map : (S₀ : Subgroup ↥C).map C.subtype = (S : Subgroup G) := by
    rw [Sylow.coe_subtype]
    exact Subgroup.map_subgroupOf_eq_of_le hS_le_CZ
  have hJ'c_le_S : J'.map (MulAut.conj (c' : G)).toMonoidHom ≤ (S : Subgroup G) := by
    have h := Subgroup.map_mono (f := C.subtype) hJ₀c_le_S₀
    rw [map_subtype_map_conj (N := C) (W := J') hJ'_le_CZ c', hS₀map] at h
    exact h
  -- `c := (c' : G)⁻¹ ∈ C(Z(S))` and `n := g⁻¹c`; then `J^n = J(S^n) ≤ S`
  let c : G := (c' : G)⁻¹
  let n : G := g⁻¹ * c
  have hc_mem : c ∈ C := C.inv_mem (by exact (c' : ↥C).2)
  have hJc_le_S : conjSubgroup c J' ≤ (S : Subgroup G) := by
    simpa [conjSubgroup, c] using hJ'c_le_S
  have hJn_le_S : (J S).map (MulAut.conj (n⁻¹)).toMonoidHom ≤ (S : Subgroup G) := by
    calc
      (J S).map (MulAut.conj (n⁻¹)).toMonoidHom
          = (J S).map ((MulAut.conj (c⁻¹ : G)).toMonoidHom.comp (MulAut.conj g).toMonoidHom) := by
            congr 1
            ext x
            simp [n, c, MulAut.conj_apply, mul_assoc]
      _ = ((J S).map (MulAut.conj g).toMonoidHom).map (MulAut.conj (c⁻¹ : G)).toMonoidHom := by
            rw [Subgroup.map_map]
      _ = (J').map (MulAut.conj (c⁻¹ : G)).toMonoidHom := by
            change ((thompsonSubgroup (S : Subgroup G)).map (MulAut.conj g).toMonoidHom).map
              (MulAut.conj (c⁻¹ : G)).toMonoidHom = (J').map (MulAut.conj (c⁻¹ : G)).toMonoidHom
            rw [← thompsonSubgroup_map_mulEquiv (G := G) (MulAut.conj g) (S : Subgroup G)]
      _ ≤ (S : Subgroup G) := by
            simpa [conjSubgroup] using hJc_le_S
  -- `S^n` is a Sylow `p`-subgroup of `G` with `J(S^n) = J^n ≤ S`, hence `J^n = J`
  let Sn : Sylow p G := n⁻¹ • S
  have hJSn : thompsonSubgroup (Sn : Subgroup G) = (J S).map (MulAut.conj (n⁻¹)).toMonoidHom := by
    calc
      thompsonSubgroup (Sn : Subgroup G)
          = thompsonSubgroup ((S : Subgroup G).map (MulAut.conj (n⁻¹)).toMonoidHom) := by
            rw [sylow_smul_subgroup_eq_map_conj (m := n⁻¹) (P := S)]
      _ = (thompsonSubgroup (S : Subgroup G)).map (MulAut.conj (n⁻¹)).toMonoidHom := by
            exact thompsonSubgroup_map_mulEquiv (G := G) (MulAut.conj (n⁻¹)) (S : Subgroup G)
  have hJn_eq_J : (J S).map (MulAut.conj (n⁻¹)).toMonoidHom = (J S) := by
    have h := thompsonSubgroup_eq_of_sylow_le S Sn (by
      simpa [hJSn] using hJn_le_S)
    simpa [J] using hJSn.symm.trans h
  have hn_mem_NJ : n ∈ Subgroup.normalizer ((J S : Subgroup G) : Set G) := by
    simpa using (Subgroup.normalizer ((J S : Subgroup G) : Set G)).inv_mem
      (Subgroup.mem_normalizer_iff_map_conj_eq.mpr hJn_eq_J)
  have hn_mem_NZJ : n ∈ Subgroup.normalizer ((ZJ' : Subgroup G) : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    have hJmap : (J S : Subgroup G).map (MulAut.conj n).toMonoidHom = (J S : Subgroup G) :=
      (Subgroup.mem_normalizer_iff_map_conj_eq.mp hn_mem_NJ)
    calc
      (ZJ' : Subgroup G).map (MulAut.conj n).toMonoidHom
          = centerIn (G := G) ((J S : Subgroup G).map (MulAut.conj n).toMonoidHom) := by
            change (thompsonCenter (S : Subgroup G)).map (MulAut.conj n).toMonoidHom =
              centerIn (G := G) ((J S : Subgroup G).map (MulAut.conj n).toMonoidHom)
            rw [← centerIn_map_mulEquiv (G := G) (MulAut.conj n) (J S : Subgroup G)]
            congr 1
      _ = centerIn (G := G) (J S : Subgroup G) := by rw [hJmap]
      _ = ZJ' := by
            change centerIn (G := G) (J S : Subgroup G) = ZJ (S : Subgroup G)
            rfl
  refine ⟨c, n⁻¹, hc_mem, ?_, ?_⟩
  · exact (Subgroup.normalizer ((ZJ' : Subgroup G) : Set G)).inv_mem hn_mem_NZJ
  · calc
      g = c * (g⁻¹ * c)⁻¹ := by group
      _ = c * n⁻¹ := by simp [n]

/-- Step (III) of the proof of Theorem 5.1 ([6], §5, p. 1119):
if `C_S(W)` is a Sylow `p`-subgroup of `C_G(W)` for a `p`-subgroup `W ≤ S`, then `G`
satisfies `(C_p)` for `W`, assuming hypothesis (a) or (b) of Theorem 5.1 and that
`G` satisfies `(C_p)` for `W = Z(S)` (step (II)).

The paper's argument: in case (a) take `M = N_G(Z)`, in case (b) an element
`M ∈ M_p(G)` containing `X = N_G(Z)` (existence requires a maximality argument);
`S` is a Sylow `p`-subgroup of `M`, and by step (II) applied inside `M`, `M`
satisfies `(C_p)` for `Z(S)`; `W^g` and `W^{n⁻¹}` are `p`-subgroups of `N_M(Z)`, so
`(C_p*)` in `M` (via Lemma 5.1) applies and the conclusion follows.

*Formalization:* `Z(S)^{g⁻¹}` is a `p`-subgroup of `C_G(W)`; since
`C_S(W) ∈ Syl_p(C_G(W))` there is `a ∈ C_G(W)` with `Z(S)^{g⁻¹a} ⊆ C_S(W)`; step
(II) yields `g⁻¹a = cn` with `c ∈ C(Z(S))`, `n ∈ N(Z(J(S)))`; in case (a) take
`M = N_G(Z(S))`, in case (b) an element `M ∈ M_p(G)` containing `N_G(Z(S))`
(existence via a finite maximality argument, using `O_p(N_G(Z(S))) ⊇ Z(S) ≠ 1`);
`S` is a Sylow `p`-subgroup of `M`, and `M` satisfies `(C_p)` by hypothesis
(a)/(b); `(C_p*)` in `M` (via Lemma 5.1) applied to the pair `(W^g, c)` yields
`d ∈ C_M(W^g)`, `m ∈ N_M(Z(J(S)))` with `c = dm`, and the chain
`w^{n⁻¹} = w^{gc} = w^{gdm} = w^{gm}` gives `gmn ∈ C(W)`, `mn ∈ N(Z)`,
`g = (gmn)(mn)⁻¹`. -/
public theorem theorem5_1_step_III (S : Sylow p G) (h : Theorem51HypA p G ∨ Theorem51HypB p G)
    (hII : ∀ g : G, conjSubset g (Zsub (S : Subgroup G) : Set G) ⊆ (S : Subgroup G) →
      ∃ c n : G,
        c ∈ Subgroup.centralizer (Zsub (S : Subgroup G) : Set G) ∧
          n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
            g = c * n) :
    ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
      (∃ P : Sylow p ↥(Subgroup.centralizer (W : Set G)),
        (P : Subgroup ↥(Subgroup.centralizer (W : Set G))).map
          (Subgroup.centralizer (W : Set G)).subtype =
            Subgroup.centralizer (W : Set G) ⊓ (S : Subgroup G)) →
      ∀ g : G, conjSubset g (W : Set G) ⊆ (S : Subgroup G) →
        ∃ c n : G,
          c ∈ Subgroup.centralizer (W : Set G) ∧
            n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
              g = c * n := by
  exact step_III_scratch S h hII

/-- Step (IV) of the proof of Theorem 5.1 ([6], §5, pp. 1119–1121):
every `p`-subgroup `W ≤ S` satisfies `(C_p)`, given step (III).

The paper's argument: choose a Sylow `p`-subgroup `S₁` of `N_G(W)` containing `W` and
`x ∈ G` with `S^x = S₁`; put `V = W^{x⁻¹} ⊆ S`; then `N_S(V) ∈ Syl_p(N_G(V))` and
`C_S(V) = N_S(V) ∩ C_G(V) ∈ Syl_p(C_G(V))`, so step (III) applies to `V` (twice, for
`x` and `xg`), and assembling `g = (m⁻¹cdm)(m⁻¹n)` yields the conclusion.

*Formalization:* choose a Sylow `p`-subgroup `S₁` of `G` containing a Sylow
`p`-subgroup of `N_G(W)` (hence containing `W`), take `x ∈ G` with `S^{x⁻¹} = S₁`
and put `V = W^{x⁻¹} ⊆ S`; then `N_S(V) = S ∩ N(V)` is a Sylow `p`-subgroup of
`N(V)` (conjugation of `N_{S₁}(W) ∈ Syl_p(N(W))`), and since `C(V) ⊴ N(V)` the
intersection lemma gives `C_S(V) = C(V) ∩ S ∈ Syl_p(C(V))`, so step (III) applies
to `V` (twice, for `x` and `xg`); assembling `g = x⁻¹(xg) = m⁻¹cdn =
(m⁻¹cdm)(m⁻¹n)` with `m⁻¹cdm ∈ C(W)` (as `W = V^m`) and `m⁻¹n ∈ N(Z(J(S)))`
yields the conclusion. -/
public theorem theorem5_1_step_IV (S : Sylow p G) (h : Theorem51HypA p G ∨ Theorem51HypB p G)
    (hIII : ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
      (∃ P : Sylow p ↥(Subgroup.centralizer (W : Set G)),
        (P : Subgroup ↥(Subgroup.centralizer (W : Set G))).map
          (Subgroup.centralizer (W : Set G)).subtype =
            Subgroup.centralizer (W : Set G) ⊓ (S : Subgroup G)) →
      ∀ g : G, conjSubset g (W : Set G) ⊆ (S : Subgroup G) →
        ∃ c n : G,
          c ∈ Subgroup.centralizer (W : Set G) ∧
            n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
              g = c * n) :
    ∀ W : Subgroup G, IsPGroup p W → W ≤ (S : Subgroup G) →
      ∀ g : G, conjSubset g (W : Set G) ⊆ (S : Subgroup G) →
        ∃ c n : G,
          c ∈ Subgroup.centralizer (W : Set G) ∧
            n ∈ Subgroup.normalizer ((ZJ (S : Subgroup G) : Subgroup G) : Set G) ∧
              g = c * n := by
  exact step_IV_scratch S h hIII

omit [Finite G] [Fact (Nat.Prime p)] in
/-- The set form of `(C_p)` follows from the subgroup form: for a nonempty subset
`W ⊆ S` with `W^g ⊆ S`, apply the subgroup form to the subgroup `⟨W⟩` generated by
`W` (a `p`-subgroup of `S` with `⟨W⟩^g ≤ S`), noting `C_G(⟨W⟩) ≤ C_G(W)`. -/
public theorem cp_of_cpSubgroup (K : CharacteristicFunctor p) (S : Sylow p G) :
    CpSubgroup K S → Cp K S := by
  intro hS W hWnonempty hWle g hWg
  have hWgen : Subgroup.closure W ≤ (S : Subgroup G) :=
    (Subgroup.closure_le (K := (S : Subgroup G))).mpr hWle
  have hWgp : IsPGroup p (Subgroup.closure W) := by
    apply IsPGroup.to_le (hK := S.isPGroup')
    exact hWgen
  have hWg_le : conjSubgroup g (Subgroup.closure W) ≤ (S : Subgroup G) := by
    have hmap : conjSubgroup g (Subgroup.closure W) =
        Subgroup.closure (conjSubset g (W : Set G)) := by
      rw [conjSubgroup, MonoidHom.map_closure]
      congr 1
      ext x
      constructor <;> rintro ⟨w, hw, hx⟩ <;> refine ⟨w, hw, ?_⟩
      · calc x = (MulAut.conj (g⁻¹)).toMonoidHom w := hx.symm
             _ = g⁻¹ * w * g := by simp
      · calc (MulAut.conj (g⁻¹)).toMonoidHom w = g⁻¹ * w * g := by simp
             _ = x := hx.symm
    rw [hmap]
    exact (Subgroup.closure_le (K := (S : Subgroup G))).mpr hWg
  rcases hS (Subgroup.closure W) hWgp hWgen g hWg_le with ⟨c, n, hc, hn, hg⟩
  refine ⟨c, n, ?_, hn, hg⟩
  intro w hw
  exact (Subgroup.mem_centralizer_iff.mp hc) w (Subgroup.subset_closure hw)

/-- Theorem 5.1 of Glauberman, "A Characteristic Subgroup of a p-Stable Group"
([6], §5, pp. 1116–1121): under hypothesis (a) or (b), `G` satisfies `(C_p)` for the
Sylow `p`-subgroup `S` with respect to the ZJ functor `K(P) = Z(J(P))`.

Proof following the paper: (I) `Z(S)^g ⊆ S` implies `Z(S)^g ⊆ Z(J(S))`
(`theorem5_1_step_I`); (II) from (I), `G` satisfies `(C_p)` for `W = Z(S)`
(`theorem5_1_step_II`, proved in full); (III) from (II), `G` satisfies `(C_p)` for
every `p`-subgroup `W ≤ S` with `C_S(W)` a Sylow `p`-subgroup of `C_G(W)`
(`theorem5_1_step_III`); (IV) from (III), `G` satisfies `(C_p)` for every
`p`-subgroup `W ≤ S` (`theorem5_1_step_IV`); finally the set form
of `(C_p)` follows from the subgroup form via the subgroup generated by `W`
(`cp_of_cpSubgroup`). -/
public theorem theorem5_1 (S : Sylow p G) (h : Theorem51HypA p G ∨ Theorem51HypB p G) :
    Cp (zjCharacteristicFunctor p) S := by
  have hI := theorem5_1_step_I S h
  have hII := theorem5_1_step_II S hI
  have hIII := theorem5_1_step_III S h hII
  have hIV := theorem5_1_step_IV S h hIII
  apply cp_of_cpSubgroup (zjCharacteristicFunctor p) S
  intro W hWp hWle g hWg
  have hWg' : conjSubset g (W : Set G) ⊆ (S : Subgroup G) := by
    rw [conjSubset_eq_conjSubgroup]
    intro x hx
    exact hWg hx
  rcases hIV W hWp hWle g hWg' with ⟨c, n, hc, hn, hg⟩
  refine ⟨c, n, hc, ?_, hg⟩
  simpa [zjCharacteristicFunctor, zjFunctor, ZJ] using hn
