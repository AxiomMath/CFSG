module

public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.Gorenstein.Chapter8_2
public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
public import Mathlib.Algebra.Group.Equiv.TypeTags

namespace CFSG
end CFSG
open CFSG

/-!
# Glauberman, "A Characteristic Subgroup of a p-Stable Group" — Definitions 2.1–2.3

The definitions used by the main statements of Glauberman's paper ([6], §2), transcribed
from George Glauberman, *A Characteristic Subgroup of a p-Stable Group*, Canadian Journal
of Mathematics 20 (1968), 1101–1135 — reference [6] of the dihedral-Sylow project —
following the validated transcription in `refs/glauberman-p-stable.tex`.

Definitions of §2 (`pStableLocal`/`pConstrainedLocal`, the `M_p(G)`-wrapped global forms
`pStable`/`pConstrained`, `MpSet`, `J`, `ZJ`, `Qd`, `Involved`, `conjSubset`,
`NormalPComplement`) follow the paper's text exactly.  The in-house infrastructure of
`FeitThompson/Gorenstein/Chapter8_2.lean` is reused:
* `J S` is `thompsonSubgroup S` (Gorenstein's `J(P)`, the subgroup generated by the abelian
  subgroups of `S` of maximal order);
* `ZJ S` is `thompsonCenter S` (Gorenstein's `Z(J(P))`).

This lower module exists so that the proof modules can import the definitions without
creating a cycle through the wrapper `Glauberman/ZJTheorem.lean`, which imports the proof
modules back in order to assemble the final theorem statements.
-/

open scoped Pointwise commutatorElement

namespace CFSG.Glauberman

/-! ## The Thompson subgroup `J(S)` and its center `Z(J(S))` -/

variable {G : Type*} [Group G]

/-- Glauberman's Thompson subgroup `J(S)`: the subgroup of the `p`-group `S` generated by
the Abelian subgroups of `S` of maximal order ([6], §2, p. 1104: "let `d_o(G)` be the
maximum of the orders of the Abelian subgroups of `G` ... Then `J_R(G)` and `J_o(G)` are
the subgroups of `G` generated by the elements of `A_R(G)` and `A_o(G)`, respectively ...
we let `d(G) = d_o(G)`, `A(G) = A_o(G)`, `J(G) = J_o(G)` throughout this paper").
Reuses Gorenstein's `thompsonSubgroup` from `FeitThompson/Gorenstein/Chapter8_2.lean`,
whose type `(P : Subgroup G) : Subgroup G` fits `J(S)` as used here. -/
@[expose]
public def J (S : Subgroup G) : Subgroup G :=
  thompsonSubgroup S

/-- Glauberman's `Z(J(S))`: the centre of the Thompson subgroup of the `p`-group `S`
([6], Theorem A; cf. §2, p. 1104).  Reuses `thompsonCenter` from
`FeitThompson/Gorenstein/Chapter8_2.lean` (Gorenstein's `Z(J(P))`). -/
@[expose]
public def ZJ (S : Subgroup G) : Subgroup G :=
  thompsonCenter S

/-- The conjugate `W^g = {g⁻¹wg | w ∈ W}` of a subset `W` of `G`
([6], §2, p. 1102: "For every `x ∈ G` and every element or subset `y` of `G`, let
`y^x = x⁻¹yx`"). -/
@[expose]
public def conjSubset (g : G) (W : Set G) : Set G :=
  {x : G | ∃ w : G, w ∈ W ∧ x = g⁻¹ * w * g}

/-- Membership in `conjSubset g W`. -/
public theorem mem_conjSubset {g : G} {W : Set G} {x : G} :
    x ∈ conjSubset g W ↔ ∃ w : G, w ∈ W ∧ x = g⁻¹ * w * g := by
  rfl

/-- A finite group `H` is *involved* in `G` if `H` is isomorphic to a subquotient of `G`
([6], §2, p. 1103: "We say that a finite group `G₀` is *involved* in `G` if `G₀` is
isomorphic to a subquotient of `G`"; a subquotient is a factor group `H/K` with
`K ⊴ H ⊆ G`). -/
@[expose]
public def Involved (H G : Type*) [Group H] [Group G] : Prop :=
  ∃ K : Subgroup G, ∃ N : Subgroup K, ∃ hN : N.Normal,
    letI : N.Normal := hN
    Nonempty (K ⧸ N ≃* H)

/-! ## `p`-stability and `p`-constraint (paper §2, Definitions 2.1–2.3) -/

/-- The condition of Definition 2.1: `G` is *`p`-stable* in the sense of Definition 2.1 (the paper applies it to
groups with `O_p(G) ≠ 1`) if, for every `p`-subgroup `P` of `G` such that `O_{p'}(G)P` is
a normal subgroup of `G`, every `x ∈ N_G(P)` with `[P,x,x] = 1` has its coset modulo
`C_G(P)` in `O_p(N_G(P)/C_G(P))` ([6], §2, Definition 2.1, p. 1104: "Let `P` be an
arbitrary `p`-subgroup of `G` such that `O_{p'}(G)P` is a normal subgroup of `G`. Suppose
that `x ∈ N(P)` and `x̄` is the coset of `C(P)` containing `x`. If `[P,x,x] = 1`, then
`x̄ ∈ O_p(N(P)/C(P))`").

Here `O_{p'}(G)` is `pPrimeCore p G`, `O_p(-)` is `pCore p`, `N_G(P)` is
`Subgroup.normalizer (P : Set G)`, `C_G(P)` is `Subgroup.centralizer (P : Set G)`, and
`[P,x,x] = 1` is transcribed as `⁅⁅P, Subgroup.zpowers x⁆, Subgroup.zpowers x⁆ = ⊥`
(commutator with the cyclic subgroup generated by `x`).

The repo already contains a shape-variant of this condition, `PStableGroup'` in
`FeitThompson/Gorenstein/Chapter8_2.lean`, stated with a `p`-subgroup `A` in place of the
element `x`; the two formulations agree once `x` is required to be a `p`-element
(`IsPGroup p (Subgroup.zpowers x)` — the forward direction needs that hypothesis;
the paper's Definition 2.1 carries no `p`-element restriction on `x`), but
`pStableLocal` follows the paper's element form. -/
@[expose]
public def pStableLocal (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] : Prop :=
  ∀ P : Subgroup G,
    IsPGroup p P →
      (pPrimeCore p G ⊔ P).Normal →
        ∀ x : G,
          (hx : x ∈ Subgroup.normalizer (P : Set G)) →
            ⁅⁅P, Subgroup.zpowers x⁆, Subgroup.zpowers x⁆ = ⊥ →
              let N : Subgroup G := Subgroup.normalizer (P : Set G)
              let C : Subgroup G := Subgroup.centralizer (P : Set G)
              QuotientGroup.mk' (C.subgroupOf N) ⟨x, hx⟩ ∈ pCore p (N ⧸ C.subgroupOf N)

/-- `M_p(G)`: the set of all subgroups `M` of `G` that are maximal with respect to the
property that `O_p(M) ≠ 1` ([6], §2, p. 1104: "For an arbitrary prime `p`, let
`M_p(G)` be the set of all subgroups `M` of `G` that are maximal with respect to the
property that `O_p(M) ≠ 1`"). -/
@[expose]
public def MpSet (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] : Set (Subgroup G) :=
  {M : Subgroup G | pCore p (↥M) ≠ ⊥ ∧ ∀ K : Subgroup G, pCore p (↥K) ≠ ⊥ → M ≤ K → K = M}

/-- Definition 2.3: `G` is *`p`-stable* if every element of `M_p(G)` is `p`-stable in the
sense of Definition 2.1 ([6], §2, p. 1104: "We say that `G` is `p`-stable (`p`-constrained)
if every element of `M_p(G)` is `p`-stable (`p`-constrained) according to Definition 2.1
(Definition 2.2)").  This is the notion used in the hypothesis "`G` is `p`-stable" of
Theorems A and C. -/
@[expose]
public def pStable (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] : Prop :=
  ∀ M : Subgroup G, M ∈ MpSet p G → pStableLocal p (G := ↥M)

/-- The condition of Definition 2.2: `G` is *locally `p`-constrained* (the paper applies
it to groups with `O_p(G) ≠ 1`) if, for every Sylow `p`-subgroup `P` of `O_{p',p}(G)`,
one has `C_G(P) ⊆ O_{p',p}(G)` ([6], §2, Definition 2.2, p. 1104: "Let `p` be an odd
prime. Let `G` be a finite group such that `O_p(G) ≠ 1`, and let `P` be a Sylow
`p`-subgroup of `O_{p',p}(G)`. Then `G` is *`p`-constrained* if `C_G(P) ⊆ O_{p',p}(G)`").

Here `O_{p',p}(G)` is `Op_p'p p G`.  The repo's `PConstrainedGroup` in
`FeitThompson/Gorenstein/Chapter8_2.lean` is a shape-variant of this condition: it
quantifies over every `p`-subgroup `Q` with `O_{p'}(G) ⊔ Q = O_{p',p}(G)` (equivalently,
`Q` a Sylow `p`-subgroup of `O_{p',p}(G)`); `pConstrainedLocal` follows the paper's
Sylow-subgroup form. -/
@[expose]
public def pConstrainedLocal (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] : Prop :=
  ∀ T : Sylow p (↥(Op_p'p p G)),
    Subgroup.centralizer
        (((T : Subgroup (↥(Op_p'p p G))).map (Op_p'p p G).subtype : Subgroup G) : Set G) ≤
      Op_p'p p G

/-- Definition 2.3: `G` is *`p`-constrained* if every element of `M_p(G)` is
`p`-constrained in the sense of Definition 2.2 ([6], §2, p. 1104).  This is the notion
used in the hypothesis "`G` is `p`-constrained" of Theorem C. -/
@[expose]
public def pConstrained (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] : Prop :=
  ∀ M : Subgroup G, M ∈ MpSet p G → pConstrainedLocal p (G := ↥M)

/-- `G` has a *normal `p`-complement* if `G = O_{p',p}(G)` ([6], §2, p. 1103: "We say that
`G` has a *normal `p`-complement* (namely, `O_{p'}(G)`) if `G = O_{p',p}(G)`"). -/
@[expose]
public def NormalPComplement (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] : Prop :=
  Op_p'p p G = ⊤

/-- The defining equality supplied by a normal `p`-complement.  This theorem is the
public elimination interface for `NormalPComplement`; module importers should use it
instead of unfolding the definition. -/
public theorem normalPComplement_eq_top {p : ℕ} [Fact p.Prime]
    {G : Type*} [Group G] (h : NormalPComplement p G) :
    Op_p'p p G = ⊤ :=
  h

/-- Introduction interface for `NormalPComplement`; use this theorem in
importing modules instead of unfolding the module-private definition. -/
public theorem normalPComplement_of_eq_top {p : ℕ} [Fact p.Prime]
    {G : Type*} [Group G] (h : Op_p'p p G = ⊤) :
    NormalPComplement p G :=
  h

/-! ## The quadratic group `Qd(p)` (paper §2, p. 1104) -/

/-- The two-dimensional vector space `V₂` over `GF(p)` used to define `Qd(p)`
([6], §2, p. 1104: "let `V₂` be a two-dimensional vector space over `GF(p)`"). -/
public abbrev qdSpace (p : ℕ) : Type :=
  Fin 2 → ZMod p

/-- The special linear group `SL₂(p)` on `V₂` used to define `Qd(p)`
([6], §2, p. 1104: "let `SL(V₂)` be the *special linear group* on `V₂`, i.e., the group
of all linear transformations of determinant one on `V₂`"). -/
public abbrev qdSL (p : ℕ) : Type :=
  Matrix.SpecialLinearGroup (Fin 2) (ZMod p)

/-- The natural linear action of `SL₂(p)` on `V₂` (as automorphisms of the underlying
additive group), used to form the semidirect product `Qd(p)`. -/
@[expose]
public def qdAction (p : ℕ) [Fact p.Prime] :
    qdSL p →* MulAut (Multiplicative (qdSpace p)) where
  toFun A := AddEquiv.toMultiplicative (Matrix.SpecialLinearGroup.toLin' A).toAddEquiv
  map_one' := by
    ext v
    simp [MonoidHom.map_one]
  map_mul' := by
    intro A B
    ext v
    simp [MonoidHom.map_mul]

/-- The *quadratic group* `Qd(p)`: the semidirect product of the two-dimensional vector
space `V₂` over `GF(p)` by `SL₂(p)` ([6], §2, p. 1104: "We define the *quadratic group*
`Qd(p)` for the prime `p` to be the semi-direct product of `V₂` by `SL(V₂)`"). -/
public abbrev Qd (p : ℕ) [Fact p.Prime] : Type :=
  Multiplicative (qdSpace p) ⋊[qdAction p] qdSL p

end CFSG.Glauberman
