/--
The right-conjugate `H^g = g⁻¹ H g`, matching the exponent convention in the
Peterfalvi text. The project-level `Subgroup.conjBy g` is left conjugation
`g H g⁻¹`, so right conjugation is `conjBy g⁻¹`.
-/
@[expose] public def rightConjugate {G : Type u} [Group G] (H : Subgroup G) (g : G) : Subgroup G :=
  H.conjBy g⁻¹


public theorem rightConjugate_stabilizer {G : Type u} [Group G] {Ω : Type*} [MulAction G Ω]
    (ω : Ω) (g : G) :
    rightConjugate (MulAction.stabilizer G ω) g =
      MulAction.stabilizer G (g⁻¹ • ω) := by
  ext x
  constructor
  · intro hx
    rcases hx with ⟨y, hy, rfl⟩
    change y • ω = ω at hy
    change ((MulAut.conj g⁻¹) y) • (g⁻¹ • ω) = g⁻¹ • ω
    calc
      ((MulAut.conj g⁻¹) y) • (g⁻¹ • ω) = g⁻¹ • (y • ω) := by
        simp [mul_assoc, smul_smul]
      _ = g⁻¹ • ω := by rw [hy]
  · intro hx
    refine ⟨g * x * g⁻¹, ?_, ?_⟩
    · change (g * x * g⁻¹) • ω = ω
      simpa [mul_assoc, smul_smul] using congrArg (fun z => g • z) hx
    · calc
        (MulAut.conj g⁻¹) (g * x * g⁻¹) =
            g⁻¹ * (g * x * g⁻¹) * (g⁻¹)⁻¹ := rfl
        _ = x := by group

/-- The statement-level `O^{2'}(G)`: the subgroup generated by the Sylow `2`-subgroups. -/
@[expose] public def twoPrimeResidual (G : Type*) [Group G] : Subgroup G :=
  ⨆ S : Sylow 2 G, (S : Subgroup G)

/-- The pointwise kernel of the action on `Ω`, written as an intersection of point stabilizers. -/
@[expose] public def pointStabilizerCore (G Ω : Type*) [Group G] [MulAction G Ω] :
    Subgroup G :=
  ⨅ ω : Ω, MulAction.stabilizer G ω

public theorem le_pointStabilizerCore_iff {G Ω : Type*} [Group G] [MulAction G Ω] {K : Subgroup G} :
    K ≤ pointStabilizerCore G Ω ↔ ∀ ω : Ω, K ≤ MulAction.stabilizer G ω := by
  simp [pointStabilizerCore]

/--
The minimal form of "2-rank at least 2" needed in Chapter I, Section 1:
there is an elementary abelian subgroup of order four.
-/
@[expose] public def TwoRankAtLeastTwo (G : Type*) [Group G] : Prop :=
  ∃ E : Subgroup G, Nat.card E = 4 ∧ ∀ x : E, (x : E) ^ 2 = 1

public theorem TwoRankAtLeastTwo.exists_subgroup {G : Type*} [Group G]
    (hG : TwoRankAtLeastTwo G) :
    ∃ E : Subgroup G, Nat.card E = 4 ∧ ∀ x : E, (x : E) ^ 2 = 1 :=
  hG

/-! ## Shared Part II statement-level interfaces -/

/-- The right-conjugate of a set, matching the Peterfalvi convention `X^g = g⁻¹ X g`. -/
@[expose] public def rightConjugateSet {G : Type u} [Group G] (X : Set G) (g : G) : Set G :=
  {y : G | ∃ x : G, x ∈ X ∧ y = rightConjugateElem x g}

/-- Fixed points of a subgroup on a `G`-set. -/
public abbrev fixedPointsOfSubgroup (G Ω : Type*) [Group G] [MulAction G Ω]
    (X : Subgroup G) : Set Ω :=
  {ω : Ω | ∀ x : G, x ∈ (X : Set G) → x • ω = ω}

/-- The actual restricted action of `C_G(X)` on the fixed-point set `Ω_X`. -/
@[reducible, expose] public def fixedPointCentralizerAction
    (G Ω : Type*) [Group G] [MulAction G Ω] (X : Subgroup G) :
    MulAction (Subgroup.centralizer (X : Set G))
      {ω : Ω // ω ∈ fixedPointsOfSubgroup G Ω X} where
  smul l ω :=
    ⟨(l : G) • (ω : Ω), by
      intro x hx
      have hcomm : x * (l : G) = (l : G) * x :=
        (Subgroup.mem_centralizer_iff.mp l.2) x hx
      calc
        x • ((l : G) • (ω : Ω)) = (x * (l : G)) • (ω : Ω) := by
          rw [smul_smul]
        _ = ((l : G) * x) • (ω : Ω) := by
          rw [hcomm]
        _ = (l : G) • (x • (ω : Ω)) := by
          rw [smul_smul]
        _ = (l : G) • (ω : Ω) := by
          rw [ω.2 x hx]⟩
  one_smul ω := by
    apply Subtype.ext
    exact one_smul G (ω : Ω)
  mul_smul l m ω := by
    apply Subtype.ext
    exact mul_smul (l : G) (m : G) (ω : Ω)

/-- The local set `K = {x ∈ D | x^t = x⁻¹}`. -/
@[expose] public def peterfalviKSet {G : Type u} [Group G] (D : Subgroup G) (t : G) : Set G :=
  {x : G | x ∈ D ∧ rightConjugateElem x t = x⁻¹}

/-- The local subgroup `V = C_D(t)`, viewed inside the ambient group. -/
@[expose] public def peterfalviV {G : Type u} [Group G] (D : Subgroup G) (t : G) : Subgroup G :=
  D ⊓ Subgroup.centralizer ({t} : Set G)

/-- The local subgroup `W = C_V(K)`, viewed inside the ambient group. -/
@[expose] public def peterfalviW {G : Type u} [Group G] (V : Subgroup G) (K : Set G) : Subgroup G :=
  V ⊓ Subgroup.centralizer K

/-! Appendix III Suzuki two-group coordinate interfaces have moved to
`BenderSuzuki.PFAppendixIII`.  Concrete Suzuki/PSL/PSU recognition-family
interfaces live in `BenderSuzuki.MatrixGroups.Suzuki`. -/
/--
Hypothesis (A1) from Peterfalvi, Part II.

The subgroup `H` is the stabilizer of a point in a doubly transitive action,
`t` is an involution outside `H`, `D = H ∩ H^t`, and `H = Q ⋊ D` with
`|Q|` even and `|D|` odd.
-/
public structure HypothesisA1
    (G Ω : Type*) [Group G] [Finite G] [MulAction G Ω] [Finite Ω]
    (H D Q : Subgroup G) (t : G) : Prop where
  two_transitive : MulAction.IsMultiplyPretransitive G Ω 2
  point_stabilizer : ∃ point : Ω, H = MulAction.stabilizer G point
  involution_t : IsInvolution t
  t_not_mem_H : t ∉ H
  D_eq : D = H ⊓ rightConjugate H t
  Q_le_H : Q ≤ H
  D_le_H : D ≤ H
  Q_normal_in_H : (Q.subgroupOf H).Normal
  Q_disjoint_D : Disjoint Q D
  Q_sup_D : Q ⊔ D = H
  Q_even : Even (Nat.card (↥Q))
  D_odd : Odd (Nat.card (↥D))

/-- The combined standing hypotheses (A1), (A2), and (A3). -/
public structure HypothesisA
    (G Ω : Type*) [Group G] [Finite G] [MulAction G Ω] [Finite Ω]
    (H D Q : Subgroup G) (t : G) : Prop where
  A1 : HypothesisA1 G Ω H D Q t
  A2 : FaithfulSMul G Ω
  A3 : TwoRankAtLeastTwo G

end PFchapter1section1
end CFSG.BenderSuzuki

