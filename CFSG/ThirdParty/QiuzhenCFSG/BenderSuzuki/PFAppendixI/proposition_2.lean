/-- Peterfalvi Appendix I, Proposition 2(a). The algebra generated by the
cyclic irreducible normal subgroup is a field of the same cardinality as `E`,
and `E` is one-dimensional over it. -/
public theorem peterfalvi_appendixI_proposition_2_a
    {p n : ℕ} [Fact p.Prime]
    {U E : Type*} [Group U] [Finite U] [Group E] [Finite E]
    [IsElementaryAbelian p E] [MulDistribMulAction U E] [FaithfulSMul U E]
    (T : Subgroup U) [T.Normal] [IsCyclic T]
    [IsIrreducible (AppendixIRepresentationOfT (p := p) (E := E) T)]
    (hcardE : Nat.card E = p ^ n) :
    let F := AppendixIFpT (p := p) (E := E) T
    ∃ fieldInst : Field F,
      letI : Field F := fieldInst
      ∃ moduleInst : Module F (Additive E),
        letI : Module F (Additive E) := moduleInst
        Nat.card F = p ^ n ∧
          Module.finrank F (Additive E) = 1 ∧
          ∀ (k : F) (x : Additive E), k • x = k.1 x := by
  classical
  let rho := AppendixIRepresentationOfT (p := p) (E := E) T
  letI : FiniteDimensional (ZMod p) (Additive E) := Module.Finite.of_finite
  letI : Field (AppendixIEndT (p := p) (E := E) T) := endField_field rho
  letI : Finite (AppendixIEndT (p := p) (E := E) T) := endField_finite rho
  letI : Module (AppendixIEndT (p := p) (E := E) T) (Additive E) :=
    endFieldModule rho
  let F := AppendixIFpT (p := p) (E := E) T
  have hFfield : IsField F := Finite.isField_of_domain F
  let fieldInst : Field F := hFfield.toField
  refine ⟨fieldInst, ?_⟩
  letI : Field F := fieldInst
  let moduleInst : Module F (Additive E) :=
    Module.compHom (Additive E) F.val.toRingHom
  refine ⟨moduleInst, ?_⟩
  letI : Module F (Additive E) := moduleInst
  have hsimple : IsSimpleModule F (Additive E) := by
    rw [isSimpleModule_iff]
    refine { toNontrivial := ?_, eq_bot_or_eq_top := ?_ }
    · letI : Nontrivial (Additive E) :=
        Subrepresentation.irreducible_module_nontrivial rho
      exact inferInstance
    · intro W
      let W' : Subrepresentation rho :=
        { toSubmodule := W.restrictScalars (ZMod p)
          apply_mem_toSubmodule := by
            intro tau x hx
            rw [Submodule.restrictScalars_mem]
            have haction :
                rho tau x = AppendixITActionEnd (p := p) (E := E) T tau x := by
              rw [AppendixITActionEnd_apply]
              exact Theory.Representation.ofElementaryAbelianAction_apply_ofMul
                (A := T) (G := E) (p := p) tau x
            rw [haction]
            exact W.smul_mem
              (⟨AppendixITActionEnd (p := p) (E := E) T tau,
                Algebra.subset_adjoin (Set.mem_range_self tau)⟩ : F) hx }
      rcases (inferInstance : IsIrreducible rho).eq_bot_or_eq_top W' with hW | hW
      · left
        exact
          (Submodule.restrictScalars_eq_bot_iff
            (R := F) (M := Additive E) (ZMod p)).mp (by
              change W'.toSubmodule = ⊥
              rw [hW]
              rfl)
      · right
        exact
          (Submodule.restrictScalars_eq_top_iff
            (R := F) (M := Additive E) (ZMod p)).mp (by
              change W'.toSubmodule = ⊤
              rw [hW]
              rfl)
  have hfinrank : Module.finrank F (Additive E) = 1 :=
    isSimpleModule_iff_finrank_eq_one.mp hsimple
  have hcard := Module.natCard_eq_pow_finrank (K := F) (V := Additive E)
  rw [hfinrank, pow_one] at hcard
  exact ⟨hcard.symm.trans hcardE, hfinrank, fun _ _ => rfl⟩

/-- Appendix I, Proposition 2(b), second proof sentence, translated literally:
for fixed `u` and `s ∈ E#`, define `a(lambda)` by the equation
`u(lambda s) = a(lambda)u(s)`. -/
public theorem peterfalvi_appendixI_proposition_2_b_define_a
    {G F : Type*} [Group G] [Field F] (Q0 : Subgroup G) :
    ∀ (q0_add : Q0 ≃* Multiplicative F) (u_add : Q0 ≃* Q0) (s : Q0),
      (s : G) ≠ 1 →
        ∃ a : F → F, ∀ lambda : F,
          q0_add (u_add
              (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
              Multiplicative.ofAdd
                (a lambda * Multiplicative.toAdd (q0_add (u_add s))) ∧
            ∀ b : F,
              q0_add (u_add
                  (q0_add.symm
                    (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
                  Multiplicative.ofAdd
                    (b * Multiplicative.toAdd (q0_add (u_add s))) →
                b = a lambda := by
  intro q0_add u_add s hsne
  let us : F := Multiplicative.toAdd (q0_add (u_add s))
  have hs_ne_q0 : s ≠ 1 := by
    intro hs
    exact hsne (congrArg Subtype.val hs)
  have hus_ne_q0 : u_add s ≠ 1 := by
    intro hus
    exact hs_ne_q0 (u_add.injective (by simpa using hus))
  have hus_ne_zero : us ≠ 0 := by
    intro hus_zero
    have hus_coord_one : q0_add (u_add s) = 1 :=
      toAdd_eq_zero.mp hus_zero
    have hus_one : u_add s = 1 := q0_add.injective (by simpa using hus_coord_one)
    exact hus_ne_q0 hus_one
  let a : F → F := fun lambda =>
    Multiplicative.toAdd
        (q0_add (u_add
          (q0_add.symm
            (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s)))))) / us
  refine ⟨a, ?_⟩
  intro lambda
  constructor
  · dsimp [a]
    rw [div_mul_cancel₀ _ hus_ne_zero]
    exact (ofAdd_toAdd
      (q0_add (u_add
        (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))))).symm
  · intro b hb
    dsimp [a]
    have hb_toAdd :
        Multiplicative.toAdd
            (q0_add (u_add
              (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s)))))) =
          b * us := by
      simpa [us] using congrArg Multiplicative.toAdd hb
    have hcancel :
        b * us =
          (Multiplicative.toAdd
              (q0_add (u_add
                (q0_add.symm
                  (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s)))))) / us) * us := by
      rw [← hb_toAdd, div_mul_cancel₀ _ hus_ne_zero]
    exact mul_right_cancel₀ hus_ne_zero hcancel

/-- Appendix I, Proposition 2(b), third proof sentence, translated literally:
from `u(lambda s) = a(lambda)u(s)`, additivity of `u` gives
`a(lambda + mu) = a(lambda) + a(mu)`. -/
public theorem peterfalvi_appendixI_proposition_2_b_additive_a
    {G F : Type*} [Group G] [Field F] (Q0 : Subgroup G) :
    ∀ (q0_add : Q0 ≃* Multiplicative F) (u_add : Q0 ≃* Q0) (s : Q0)
      (a : F → F),
      (s : G) ≠ 1 →
        (∀ lambda : F,
          q0_add (u_add
              (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
              Multiplicative.ofAdd
                (a lambda * Multiplicative.toAdd (q0_add (u_add s))) ∧
            ∀ b : F,
              q0_add (u_add
                  (q0_add.symm
                    (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
                  Multiplicative.ofAdd
                    (b * Multiplicative.toAdd (q0_add (u_add s))) →
                b = a lambda) →
          ∀ lambda mu : F, a (lambda + mu) = a lambda + a mu := by
  intro q0_add u_add s a _hsne hdef lambda mu
  let us : F := Multiplicative.toAdd (q0_add (u_add s))
  have hscalar_add :
      q0_add.symm
          (Multiplicative.ofAdd ((lambda + mu) * Multiplicative.toAdd (q0_add s))) =
        q0_add.symm (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))) *
          q0_add.symm (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))) := by
    apply q0_add.injective
    simp [add_mul]
  have hu_add :
      u_add (q0_add.symm
          (Multiplicative.ofAdd ((lambda + mu) * Multiplicative.toAdd (q0_add s)))) =
        u_add (q0_add.symm
            (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s)))) *
          u_add (q0_add.symm
            (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s)))) := by
    rw [hscalar_add]
    exact map_mul u_add _ _
  have hcoord :
      q0_add (u_add (q0_add.symm
          (Multiplicative.ofAdd ((lambda + mu) * Multiplicative.toAdd (q0_add s))))) =
        Multiplicative.ofAdd ((a lambda + a mu) * us) := by
    rw [hu_add, map_mul, (hdef lambda).1, (hdef mu).1]
    simp [us, add_mul]
  exact ((hdef (lambda + mu)).2 (a lambda + a mu) (by
    simpa [us] using hcoord)).symm


/-- Appendix I, Proposition 2(b), source sentence proving multiplicativity of
`a` when the first factor is one of the scalar generators coming from `T`. -/
public theorem peterfalvi_appendixI_proposition_2_b_multiplicative_a_on_T
    {G F : Type*} [Group G] [Field F] (Q0 : Subgroup G) (S : Set F) :
    ∀ (q0_add : Q0 ≃* Multiplicative F) (u_add : Q0 ≃* Q0) (s : Q0)
      (a : F → F),
        (∀ lambda : F,
          q0_add (u_add
              (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
              Multiplicative.ofAdd
                (a lambda * Multiplicative.toAdd (q0_add (u_add s))) ∧
            ∀ b : F,
              q0_add (u_add
                  (q0_add.symm
                    (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
                  Multiplicative.ofAdd
                    (b * Multiplicative.toAdd (q0_add (u_add s))) →
                b = a lambda) →
          (∀ lambda ∈ S, ∃ c : F, ∀ x : Q0,
            u_add (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
              q0_add.symm
                (Multiplicative.ofAdd (c * Multiplicative.toAdd (q0_add (u_add x))))) →
            ∀ lambda ∈ S, ∀ mu : F,
              a (lambda * mu) = a lambda * a mu := by
  intro q0_add u_add s a hdef hconjT lambda hlambda mu
  rcases hconjT lambda hlambda with ⟨c, hc⟩
  let us : F := Multiplicative.toAdd (q0_add (u_add s))
  have hc_eq_a : c = a lambda := by
    have hcoord_c :
        q0_add (u_add (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
          Multiplicative.ofAdd (c * us) := by
      calc
        q0_add (u_add (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
            q0_add (q0_add.symm
              (Multiplicative.ofAdd (c * Multiplicative.toAdd (q0_add (u_add s))))) := by
              rw [hc s]
        _ = Multiplicative.ofAdd (c * us) := by
              simp [us]
    exact (hdef lambda).2 c (by simpa [us] using hcoord_c)
  have hscalar_mul :
      q0_add.symm
          (Multiplicative.ofAdd ((lambda * mu) * Multiplicative.toAdd (q0_add s))) =
        q0_add.symm (Multiplicative.ofAdd
          (lambda * Multiplicative.toAdd (q0_add
            (q0_add.symm
              (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))))))) := by
    apply q0_add.injective
    simp [mul_assoc]
  have hact :
      u_add (q0_add.symm
          (Multiplicative.ofAdd ((lambda * mu) * Multiplicative.toAdd (q0_add s)))) =
        q0_add.symm (Multiplicative.ofAdd
          (c * Multiplicative.toAdd (q0_add
            (u_add (q0_add.symm
              (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s)))))))) := by
    simpa [hscalar_mul] using
      hc (q0_add.symm (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))))
  have hmu_toAdd :
      Multiplicative.toAdd
          (q0_add (u_add (q0_add.symm
            (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s)))))) =
        a mu * us := by
    simpa [us] using congrArg Multiplicative.toAdd (hdef mu).1
  have hcoord :
      q0_add (u_add (q0_add.symm
          (Multiplicative.ofAdd ((lambda * mu) * Multiplicative.toAdd (q0_add s))))) =
        Multiplicative.ofAdd ((a lambda * a mu) * us) := by
    calc
      q0_add (u_add (q0_add.symm
          (Multiplicative.ofAdd ((lambda * mu) * Multiplicative.toAdd (q0_add s))))) =
          q0_add (q0_add.symm (Multiplicative.ofAdd
            (c * Multiplicative.toAdd (q0_add
              (u_add (q0_add.symm
                (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))))))))) := by
            rw [hact]
      _ = Multiplicative.ofAdd
          (c * Multiplicative.toAdd
              (q0_add (u_add (q0_add.symm
                (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))))))) := by
            simp
      _ = Multiplicative.ofAdd (c * (a mu * us)) := by
            rw [hmu_toAdd]
      _ = Multiplicative.ofAdd ((c * a mu) * us) := by
            rw [mul_assoc]
      _ = Multiplicative.ofAdd ((a lambda * a mu) * us) := by
            rw [hc_eq_a]
  exact ((hdef (lambda * mu)).2 (a lambda * a mu) (by
    simpa [us] using hcoord)).symm

/-- Appendix I, Proposition 2(b), source sentence extending multiplicativity
from the scalar generators coming from `T` to all of `F = F_p[T]`. -/
public theorem peterfalvi_appendixI_proposition_2_b_multiplicative_a_all
    {F : Type*} [Field F] (a : F → F) (S : Set F)
    (ha_zero : a 0 = 0) (ha_one : a 1 = 1)
    (hadd : ∀ x y : F, a (x + y) = a x + a y)
    (hclosure : Subring.closure S = ⊤)
    (hmulS : ∀ x ∈ S, ∀ y : F, a (x * y) = a x * a y) :
    ∀ x y : F, a (x * y) = a x * a y := by
  have hneg : ∀ x : F, a (-x) = -a x := by
    intro x
    apply eq_neg_of_add_eq_zero_right
    simpa [ha_zero] using (hadd x (-x)).symm
  let good : Subring F :=
    { carrier := {x | ∀ y : F, a (x * y) = a x * a y}
      zero_mem' := by simp [ha_zero]
      one_mem' := by simp [ha_one]
      add_mem' := by
        intro x y hx hy z
        rw [add_mul, hadd, hx z, hy z, hadd x y, add_mul]
      neg_mem' := by
        intro x hx y
        rw [neg_mul, hneg, hx y, hneg, neg_mul]
      mul_mem' := by
        intro x y hx hy z
        calc
          a ((x * y) * z) = a (x * (y * z)) := by rw [mul_assoc]
          _ = a x * a (y * z) := hx (y * z)
          _ = a x * (a y * a z) := by rw [hy z]
          _ = (a x * a y) * a z := by rw [mul_assoc]
          _ = a (x * y) * a z := by rw [hx y] }
  have hle : Subring.closure S ≤ good :=
    Subring.closure_le.mpr (by
      intro x hx
      exact hmulS x hx)
  rw [hclosure] at hle
  intro x y
  exact hle (Set.mem_univ x) y
/-- Appendix I, Proposition 2(b), source sentence: therefore `a` is a field
automorphism. -/
public theorem peterfalvi_appendixI_proposition_2_b_field_automorphism
    {G F : Type*} [Group G] [Field F] [Finite F] (Q0 : Subgroup G) :
    ∀ (q0_add : Q0 ≃* Multiplicative F) (u_add : Q0 ≃* Q0) (s : Q0)
      (a : F → F),
        (s : G) ≠ 1 →
          (∀ lambda : F,
            q0_add (u_add
                (q0_add.symm
                  (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
                Multiplicative.ofAdd
                  (a lambda * Multiplicative.toAdd (q0_add (u_add s))) ∧
              ∀ b : F,
                q0_add (u_add
                    (q0_add.symm
                      (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
                    Multiplicative.ofAdd
                      (b * Multiplicative.toAdd (q0_add (u_add s))) →
                  b = a lambda) →
            (∀ lambda mu : F, a (lambda + mu) = a lambda + a mu) →
              (∀ lambda mu : F, a (lambda * mu) = a lambda * a mu) →
                ∃ σ : F ≃+* F, ∀ lambda : F, σ lambda = a lambda := by
  intro q0_add u_add s a hsne hdef hadd hmul
  let us : F := Multiplicative.toAdd (q0_add (u_add s))
  have hs_ne_q0 : s ≠ 1 := by
    intro hs
    exact hsne (congrArg Subtype.val hs)
  have hus_ne_q0 : u_add s ≠ 1 := by
    intro hus
    exact hs_ne_q0 (u_add.injective (by simpa using hus))
  have hus_ne_zero : us ≠ 0 := by
    intro hus_zero
    have hus_coord_one : q0_add (u_add s) = 1 := toAdd_eq_zero.mp hus_zero
    have hus_one : u_add s = 1 := q0_add.injective (by simpa using hus_coord_one)
    exact hus_ne_q0 hus_one
  have ha_one : a 1 = 1 := by
    have hcoord_one :
        q0_add (u_add
            (q0_add.symm
              (Multiplicative.ofAdd (1 * Multiplicative.toAdd (q0_add s))))) =
          Multiplicative.ofAdd (1 * Multiplicative.toAdd (q0_add (u_add s))) := by
      simp
    exact ((hdef 1).2 1 hcoord_one).symm
  have ha_zero : a 0 = 0 := by
    have h := hadd 0 0
    have hcancel : a 0 + 0 = a 0 + a 0 := by
      simpa using h
    exact add_left_cancel hcancel.symm
  have ha_injective : Function.Injective a := by
    intro x y hxy
    have hdiff : a (x - y) = 0 := by
      have hsub : a (x - y) = a x - a y := by
        have hneg : a (-y) = -a y := by
          apply eq_neg_of_add_eq_zero_right
          simpa [ha_zero] using (hadd y (-y)).symm
        simpa [sub_eq_add_neg, hneg] using hadd x (-y)
      rw [hsub, hxy, sub_self]
    by_contra hne
    have hxmy_ne : x - y ≠ 0 := by
      intro hzero
      exact hne (sub_eq_zero.mp hzero)
    have hunit : IsUnit (x - y) := isUnit_iff_ne_zero.mpr hxmy_ne
    rcases hunit with ⟨u, hu⟩
    have hone_zero : (1 : F) = 0 := by
      have hprod : (x - y) * ↑u⁻¹ = 1 := by
        rw [← hu, Units.mul_inv]
      calc
        (1 : F) = a 1 := ha_one.symm
        _ = a ((x - y) * ↑u⁻¹) := by rw [hprod]
        _ = a (x - y) * a (↑u⁻¹ : F) := hmul (x - y) (↑u⁻¹ : F)
        _ = 0 := by rw [hdiff, zero_mul]
    exact one_ne_zero hone_zero
  let φ : F →+* F :=
    { toFun := a
      map_one' := ha_one
      map_mul' := hmul
      map_zero' := ha_zero
      map_add' := hadd }
  have hφbij : Function.Bijective φ :=
    ⟨ha_injective, Finite.surjective_of_injective ha_injective⟩
  let σ : F ≃+* F := RingEquiv.ofBijective φ hφbij
  exact ⟨σ, fun lambda => rfl⟩

/-- Appendix I, Proposition 2(b), source sentence: as every `x` is of the form
`mu s`, `u(lambda x) = a(lambda)u(x)`, so `u` is semilinear. -/
public theorem peterfalvi_appendixI_proposition_2_b_semilinear
    {G F : Type*} [Group G] [Field F] (Q0 : Subgroup G) :
    ∀ (q0_add : Q0 ≃* Multiplicative F) (u_add : Q0 ≃* Q0) (s : Q0)
      (a : F → F),
        (s : G) ≠ 1 →
        (∀ lambda : F,
          q0_add (u_add
              (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
              Multiplicative.ofAdd
                (a lambda * Multiplicative.toAdd (q0_add (u_add s))) ∧
            ∀ b : F,
              q0_add (u_add
                  (q0_add.symm
                    (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add s))))) =
                  Multiplicative.ofAdd
                    (b * Multiplicative.toAdd (q0_add (u_add s))) →
                b = a lambda) →
          (∀ lambda mu : F, a (lambda * mu) = a lambda * a mu) →
            ∀ lambda : F, ∀ x : Q0,
              u_add (q0_add.symm
                (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
                q0_add.symm
                  (Multiplicative.ofAdd (a lambda * Multiplicative.toAdd (q0_add (u_add x)))) := by
  intro q0_add u_add s a hsne hdef hmul lambda x
  let mu : F := Multiplicative.toAdd (q0_add x) / Multiplicative.toAdd (q0_add s)
  have hs_zero : Multiplicative.toAdd (q0_add s) ≠ 0 := by
    intro hs_zero
    have hs_one : s = 1 := by
      apply q0_add.injective
      simpa using toAdd_eq_zero.mp hs_zero
    exact hsne (congrArg Subtype.val hs_one)
  have hx_eq_mu_s :
      x = q0_add.symm (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))) := by
    apply q0_add.injective
    simp [mu, div_mul_cancel₀ _ hs_zero]
  have hleft_scalar :
      q0_add.symm (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x))) =
        q0_add.symm (Multiplicative.ofAdd ((lambda * mu) * Multiplicative.toAdd (q0_add s))) := by
    apply q0_add.injective
    simp [hx_eq_mu_s, mul_assoc]
  have hcoord_left :
      q0_add (u_add
          (q0_add.symm (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x))))) =
        Multiplicative.ofAdd ((a lambda * a mu) * Multiplicative.toAdd (q0_add (u_add s))) := by
    rw [hleft_scalar, (hdef (lambda * mu)).1, hmul lambda mu]
  have hmu_toAdd :
      Multiplicative.toAdd
          (q0_add (u_add
            (q0_add.symm (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s)))))) =
        a mu * Multiplicative.toAdd (q0_add (u_add s)) := by
    simpa using congrArg Multiplicative.toAdd (hdef mu).1
  have hcoord_rhs :
      q0_add (q0_add.symm
          (Multiplicative.ofAdd (a lambda * Multiplicative.toAdd (q0_add (u_add x))))) =
        Multiplicative.ofAdd ((a lambda * a mu) * Multiplicative.toAdd (q0_add (u_add s))) := by
    calc
      q0_add (q0_add.symm
          (Multiplicative.ofAdd (a lambda * Multiplicative.toAdd (q0_add (u_add x))))) =
          q0_add (q0_add.symm
            (Multiplicative.ofAdd (a lambda * Multiplicative.toAdd
              (q0_add (u_add
                (q0_add.symm (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))))))))) := by
            rw [hx_eq_mu_s]
      _ = Multiplicative.ofAdd
          (a lambda * Multiplicative.toAdd
            (q0_add (u_add
              (q0_add.symm (Multiplicative.ofAdd (mu * Multiplicative.toAdd (q0_add s))))))) := by
            simp
      _ = Multiplicative.ofAdd (a lambda * (a mu * Multiplicative.toAdd (q0_add (u_add s)))) := by
            rw [hmu_toAdd]
      _ = Multiplicative.ofAdd ((a lambda * a mu) * Multiplicative.toAdd (q0_add (u_add s))) := by
            rw [mul_assoc]
  apply q0_add.injective
  rw [hcoord_left, hcoord_rhs]

private theorem appendixI_prop2_b_semilinear_unique
    {G F U : Type*} [Group G] [Field F] [Group U]
    (Q0 : Subgroup G) (q0_add : Q0 ≃* Multiplicative F)
    (u_add : U →* (Q0 ≃* Q0)) (s : Q0) (hs : (s : G) ≠ 1)
    (u : U) (σ τ : F ≃+* F)
    (hσ : ∀ lambda : F, ∀ x : Q0,
      u_add u (q0_add.symm
        (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
      q0_add.symm
        (Multiplicative.ofAdd (σ lambda * Multiplicative.toAdd (q0_add (u_add u x)))))
    (hτ : ∀ lambda : F, ∀ x : Q0,
      u_add u (q0_add.symm
        (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
      q0_add.symm
        (Multiplicative.ofAdd (τ lambda * Multiplicative.toAdd (q0_add (u_add u x))))) :
    σ = τ := by
  ext lambda
  have hs_ne_q0 : s ≠ 1 := by
    intro hsone
    exact hs (congrArg Subtype.val hsone)
  have hus_ne_q0 : u_add u s ≠ 1 := by
    intro husone
    apply hs_ne_q0
    apply (u_add u).injective
    simpa using husone
  have hus_ne_zero : Multiplicative.toAdd (q0_add (u_add u s)) ≠ 0 := by
    intro huszero
    have husone : u_add u s = 1 := by
      apply q0_add.injective
      simpa using toAdd_eq_zero.mp huszero
    exact hus_ne_q0 husone
  have hcoordQ0 := (hσ lambda s).symm.trans (hτ lambda s)
  have hcoordMul := congrArg q0_add hcoordQ0
  have hcoord := congrArg Multiplicative.toAdd hcoordMul
  have hprod :
      σ lambda * Multiplicative.toAdd (q0_add (u_add u s)) =
        τ lambda * Multiplicative.toAdd (q0_add (u_add u s)) := by
    simpa using hcoord
  exact mul_right_cancel₀ hus_ne_zero hprod

public theorem peterfalvi_appendixI_proposition_2_b_per_element
    {G F U : Type*} [Group G] [Field F] [Finite F] [Group U]
    (Q0 : Subgroup G) (q0_add : Q0 ≃* Multiplicative F)
    (u_add : U →* (Q0 ≃* Q0)) (s : Q0) (hs : (s : G) ≠ 1)
    (S : Set F) (hclosure : Subring.closure S = ⊤)
    (hconjT : ∀ (u : U) (lambda : F), lambda ∈ S → ∃ c : F, ∀ x : Q0,
      u_add u (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
        q0_add.symm
          (Multiplicative.ofAdd (c * Multiplicative.toAdd (q0_add (u_add u x))))) :
    ∀ u : U, ∃ σ : F ≃+* F, ∀ lambda : F, ∀ x : Q0,
      u_add u (q0_add.symm
        (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
      q0_add.symm
        (Multiplicative.ofAdd (σ lambda * Multiplicative.toAdd (q0_add (u_add u x)))) := by
  intro u
  rcases peterfalvi_appendixI_proposition_2_b_define_a Q0 q0_add (u_add u) s hs with
    ⟨a, hdef⟩
  have hadd := peterfalvi_appendixI_proposition_2_b_additive_a
    Q0 q0_add (u_add u) s a hs hdef
  have ha_zero : a 0 = 0 := by
    have h := hadd 0 0
    have hcancel : a 0 + 0 = a 0 + a 0 := by
      simpa using h
    exact add_left_cancel hcancel.symm
  have ha_one : a 1 = 1 := by
    have hcoord_one :
        q0_add (u_add u
            (q0_add.symm
              (Multiplicative.ofAdd (1 * Multiplicative.toAdd (q0_add s))))) =
          Multiplicative.ofAdd (1 * Multiplicative.toAdd (q0_add (u_add u s))) := by
      simp
    exact ((hdef 1).2 1 hcoord_one).symm
  have hmulT := peterfalvi_appendixI_proposition_2_b_multiplicative_a_on_T
    Q0 S q0_add (u_add u) s a hdef (hconjT u)
  have hmul := peterfalvi_appendixI_proposition_2_b_multiplicative_a_all
    a S ha_zero ha_one hadd hclosure hmulT
  rcases peterfalvi_appendixI_proposition_2_b_field_automorphism
      Q0 q0_add (u_add u) s a hs hdef hadd hmul with ⟨σ, hσ⟩
  refine ⟨σ, ?_⟩
  intro lambda x
  rw [hσ]
  exact peterfalvi_appendixI_proposition_2_b_semilinear
    Q0 q0_add (u_add u) s a hs hdef hmul lambda x

/-- The homomorphism-valued part of Appendix I, Proposition 2(b) does not
require faithfulness of the `U`-action.  Faithfulness is needed only for the
subsequent identification of a stabilizer with a subgroup of the field
automorphism group. -/
public theorem peterfalvi_appendixI_proposition_2_b_semilinear_hom
    {G F U : Type*} [Group G] [Field F] [Finite F] [Group U]
    (Q0 : Subgroup G) (q0_add : Q0 ≃* Multiplicative F)
    (u_add : U →* (Q0 ≃* Q0)) (s : Q0) (hs : (s : G) ≠ 1)
    (S : Set F) (hclosure : Subring.closure S = ⊤)
    (hconjT : ∀ (u : U) (lambda : F), lambda ∈ S → ∃ c : F, ∀ x : Q0,
      u_add u (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
        q0_add.symm
          (Multiplicative.ofAdd
            (c * Multiplicative.toAdd (q0_add (u_add u x))))) :
    ∃ σHom : U →* (F ≃+* F),
      ∀ (u : U) (lambda : F) (x : Q0),
        u_add u (q0_add.symm
            (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
          q0_add.symm
            (Multiplicative.ofAdd
              (σHom u lambda * Multiplicative.toAdd (q0_add (u_add u x)))) := by
  classical
  have hsemilinear := peterfalvi_appendixI_proposition_2_b_per_element
    Q0 q0_add u_add s hs S hclosure hconjT
  let σ : U → (F ≃+* F) := fun u => Classical.choose (hsemilinear u)
  have hσ (u : U) : ∀ lambda : F, ∀ x : Q0,
      u_add u (q0_add.symm
        (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
      q0_add.symm
        (Multiplicative.ofAdd
          (σ u lambda * Multiplicative.toAdd (q0_add (u_add u x)))) :=
    Classical.choose_spec (hsemilinear u)
  have hσ_one : σ 1 = 1 := by
    apply appendixI_prop2_b_semilinear_unique Q0 q0_add u_add s hs 1
    · exact hσ 1
    · intro lambda x
      simp
  have hσ_mul (u v : U) : σ (u * v) = σ u * σ v := by
    apply appendixI_prop2_b_semilinear_unique Q0 q0_add u_add s hs (u * v)
    · exact hσ (u * v)
    · intro lambda x
      calc
        u_add (u * v) (q0_add.symm
            (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
            u_add u (u_add v (q0_add.symm
              (Multiplicative.ofAdd
                (lambda * Multiplicative.toAdd (q0_add x))))) := by
              rw [map_mul]
              rfl
        _ = u_add u (q0_add.symm
              (Multiplicative.ofAdd
                (σ v lambda * Multiplicative.toAdd (q0_add (u_add v x))))) := by
              rw [hσ v lambda x]
        _ = q0_add.symm
              (Multiplicative.ofAdd
                (σ u (σ v lambda) *
                  Multiplicative.toAdd (q0_add (u_add u (u_add v x))))) :=
              hσ u (σ v lambda) (u_add v x)
        _ = q0_add.symm
              (Multiplicative.ofAdd
                ((σ u * σ v) lambda *
                  Multiplicative.toAdd (q0_add (u_add (u * v) x)))) := by
              have huv_apply : u_add (u * v) x = u_add u (u_add v x) := by
                rw [map_mul]
                rfl
              rw [huv_apply]
              rfl
  let σHom : U →* (F ≃+* F) :=
    { toFun := σ
      map_one' := hσ_one
      map_mul' := hσ_mul }
  exact ⟨σHom, hσ⟩

public theorem peterfalvi_appendixI_proposition_2_b_stabilizer_range_isomorphism
    {G F U : Type*} [Group G] [Field F] [Group U]
    (Q0 : Subgroup G) (q0_add : Q0 ≃* Multiplicative F)
    (u_add : U →* (Q0 ≃* Q0)) (hu_add_injective : Function.Injective u_add)
    (s : Q0) (hs : (s : G) ≠ 1)
    (hsemilinear : ∀ u : U, ∃ σ : F ≃+* F, ∀ lambda : F, ∀ x : Q0,
      u_add u (q0_add.symm
        (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
      q0_add.symm
        (Multiplicative.ofAdd (σ lambda * Multiplicative.toAdd (q0_add (u_add u x))))) :
    ∃ σHom : U →* (F ≃+* F),
      (∀ (u : U) (lambda : F) (x : Q0),
        u_add u (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
        q0_add.symm
          (Multiplicative.ofAdd
            (σHom u lambda * Multiplicative.toAdd (q0_add (u_add u x))))) ∧
      let C : Subgroup U :=
        { carrier := {u | u_add u s = s}
          one_mem' := by simp
          mul_mem' := by
            intro u v hu hv
            change u_add (u * v) s = s
            rw [map_mul]
            change u_add u (u_add v s) = s
            rw [hv, hu]
          inv_mem' := by
            intro u hu
            change u_add u⁻¹ s = s
            rw [map_inv]
            change (u_add u)⁻¹ s = s
            apply (u_add u).injective
            simpa using hu.symm }
      ∃ (A : Subgroup (F ≃+* F)) (e : C ≃* A),
        ∀ u : C, (e u : F ≃+* F) = σHom u := by
  classical
  let σ : U → (F ≃+* F) := fun u => Classical.choose (hsemilinear u)
  have hσ (u : U) : ∀ lambda : F, ∀ x : Q0,
      u_add u (q0_add.symm
        (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
      q0_add.symm
        (Multiplicative.ofAdd (σ u lambda * Multiplicative.toAdd (q0_add (u_add u x)))) :=
    Classical.choose_spec (hsemilinear u)
  have hσ_one : σ 1 = 1 := by
    apply appendixI_prop2_b_semilinear_unique Q0 q0_add u_add s hs 1
    · exact hσ 1
    · intro lambda x
      simp
  have hσ_mul (u v : U) : σ (u * v) = σ u * σ v := by
    apply appendixI_prop2_b_semilinear_unique Q0 q0_add u_add s hs (u * v)
    · exact hσ (u * v)
    · intro lambda x
      calc
        u_add (u * v) (q0_add.symm
            (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
            u_add u (u_add v (q0_add.symm
              (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x))))) := by
                rw [map_mul]
                rfl
        _ = u_add u (q0_add.symm
              (Multiplicative.ofAdd
                (σ v lambda * Multiplicative.toAdd (q0_add (u_add v x))))) := by
              rw [hσ v lambda x]
        _ = q0_add.symm
              (Multiplicative.ofAdd
                (σ u (σ v lambda) *
                  Multiplicative.toAdd (q0_add (u_add u (u_add v x))))) :=
              hσ u (σ v lambda) (u_add v x)
        _ = q0_add.symm
              (Multiplicative.ofAdd
                ((σ u * σ v) lambda *
                  Multiplicative.toAdd (q0_add (u_add (u * v) x)))) := by
              have huv_apply : u_add (u * v) x = u_add u (u_add v x) := by
                rw [map_mul]
                rfl
              rw [huv_apply]
              rfl
  let σHom : U →* (F ≃+* F) :=
    { toFun := σ
      map_one' := hσ_one
      map_mul' := hσ_mul }
  refine ⟨σHom, ?_, ?_⟩
  · intro u lambda x
    exact hσ u lambda x
  let C : Subgroup U :=
    { carrier := {u | u_add u s = s}
      one_mem' := by simp
      mul_mem' := by
        intro u v hu hv
        change u_add (u * v) s = s
        rw [map_mul]
        change u_add u (u_add v s) = s
        rw [hv, hu]
      inv_mem' := by
        intro u hu
        change u_add u⁻¹ s = s
        rw [map_inv]
        change (u_add u)⁻¹ s = s
        apply (u_add u).injective
        simpa using hu.symm }
  let stabilizerAut : C →* (F ≃+* F) := σHom.comp C.subtype
  have hs_ne_q0 : s ≠ 1 := by
    intro hsone
    exact hs (congrArg Subtype.val hsone)
  have hs_ne_zero : Multiplicative.toAdd (q0_add s) ≠ 0 := by
    intro hszero
    have hsone : s = 1 := by
      apply q0_add.injective
      simpa using toAdd_eq_zero.mp hszero
    exact hs_ne_q0 hsone
  have hstabilizerAut_injective : Function.Injective stabilizerAut := by
    intro u v huv
    apply Subtype.ext
    apply hu_add_injective
    apply MulEquiv.ext
    intro x
    let lambda : F :=
      Multiplicative.toAdd (q0_add x) / Multiplicative.toAdd (q0_add s)
    have hx :
        q0_add.symm
            (Multiplicative.ofAdd
              (lambda * Multiplicative.toAdd (q0_add s))) = x := by
      apply q0_add.injective
      simp [lambda, div_mul_cancel₀ _ hs_ne_zero]
    have hσuv : σHom (u : U) = σHom (v : U) := by
      simpa [stabilizerAut] using huv
    calc
      u_add (u : U) x =
          u_add (u : U) (q0_add.symm
            (Multiplicative.ofAdd
              (lambda * Multiplicative.toAdd (q0_add s)))) := by rw [hx]
      _ = q0_add.symm
          (Multiplicative.ofAdd
            (σHom (u : U) lambda *
              Multiplicative.toAdd (q0_add (u_add (u : U) s)))) := hσ (u : U) lambda s
      _ = q0_add.symm
          (Multiplicative.ofAdd
            (σHom (v : U) lambda *
              Multiplicative.toAdd (q0_add (u_add (v : U) s)))) := by
            rw [hσuv, u.property, v.property]
      _ = u_add (v : U) (q0_add.symm
            (Multiplicative.ofAdd
              (lambda * Multiplicative.toAdd (q0_add s)))) := (hσ (v : U) lambda s).symm
      _ = u_add (v : U) x := by rw [hx]
  let e : C ≃* stabilizerAut.range :=
    MonoidHom.ofInjective hstabilizerAut_injective
  refine ⟨stabilizerAut.range, e, ?_⟩
  intro u
  rfl

/-- Peterfalvi Appendix I, Proposition 2(b), in field coordinates. The set `S`
is the image of the scalar operators coming from `T`; `Subring.closure S = ⊤`
expresses exactly that `F = F_p[T]`. Every element of `U` acts semilinearly,
and the stabilizer of the nonzero vector `s` is isomorphic to a subgroup of
`F ≃+* F`. -/
public theorem peterfalvi_appendixI_proposition_2_b
    {G F U : Type*} [Group G] [Field F] [Finite F] [Group U]
    (Q0 : Subgroup G) (q0_add : Q0 ≃* Multiplicative F)
    (u_add : U →* (Q0 ≃* Q0)) (hu_add_injective : Function.Injective u_add)
    (s : Q0) (hs : (s : G) ≠ 1)
    (S : Set F) (hclosure : Subring.closure S = ⊤)
    (hconjT : ∀ (u : U) (lambda : F), lambda ∈ S → ∃ c : F, ∀ x : Q0,
      u_add u (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
        q0_add.symm
          (Multiplicative.ofAdd (c * Multiplicative.toAdd (q0_add (u_add u x))))) :
    ∃ σHom : U →* (F ≃+* F),
      (∀ (u : U) (lambda : F) (x : Q0),
        u_add u (q0_add.symm
          (Multiplicative.ofAdd (lambda * Multiplicative.toAdd (q0_add x)))) =
        q0_add.symm
          (Multiplicative.ofAdd
            (σHom u lambda * Multiplicative.toAdd (q0_add (u_add u x))))) ∧
      let C : Subgroup U :=
        { carrier := {u | u_add u s = s}
          one_mem' := by simp
          mul_mem' := by
            intro u v hu hv
            change u_add (u * v) s = s
            rw [map_mul]
            change u_add u (u_add v s) = s
            rw [hv, hu]
          inv_mem' := by
            intro u hu
            change u_add u⁻¹ s = s
            rw [map_inv]
            change (u_add u)⁻¹ s = s
            apply (u_add u).injective
            simpa using hu.symm }
      ∃ (A : Subgroup (F ≃+* F)) (e : C ≃* A),
        ∀ u : C, (e u : F ≃+* F) = σHom u := by
  exact peterfalvi_appendixI_proposition_2_b_stabilizer_range_isomorphism
    Q0 q0_add u_add hu_add_injective s hs
      (peterfalvi_appendixI_proposition_2_b_per_element
        Q0 q0_add u_add s hs S hclosure hconjT)
end PFAppendixI
