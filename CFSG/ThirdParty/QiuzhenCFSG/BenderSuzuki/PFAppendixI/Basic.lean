/-- The Section 1/2 elementary-abelian-two assumptions as the library
`IsElementaryAbelian 2` class, for the Appendix I sentence "E is elementary
abelian of order p^n". -/
public theorem isElementaryAbelian_two_of_forall_sq_one
    {G : Type*} [Group G] {E : Subgroup G}
    (hE_comm : IsMulCommutative E) (hE_sq : ∀ x : E, x ^ 2 = 1) :
    IsElementaryAbelian 2 E := by
  refine
    { toIsMulCommutative := hE_comm
      exponent_dvd_p := ?_ }
  refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 ?_
  intro x
  exact hE_sq x


/-!
# Peterfalvi Appendix interface for Chapter I, Section 2

The normalized `docs/PFpart2/chapter1.tex` source cites Appendix I, Proposition 2
after proving that `KW/W` is cyclic normal in `D/W` and transitive on `Q₀#`.
In Peterfalvi's original OCR TeX, the same semilinear field-model paragraph is
numbered as Appendix V; the local file name follows the normalized Chapter I
citation to avoid changing downstream module names.  The cited result has two
mathematical parts: (a) the field/scalar model for the cyclic normal irreducible
subgroup, and (b) the semilinear action plus the stabilizer embedding into field
automorphisms.  We keep the proof interface local to this PF chapter file and
expose only the Section 2 specialization consumed by Proposition 3.
-/
/-!
Appendix I, Proposition 2(a), literal algebra objects.

The source sentence is:
`By Schur's Lemma, F_1 = End_T(E) is a finite field and, as T is commutative,
F = F_p[T] <= F_1. Since F is a subring of a finite field, F is a field.`

These declarations name the two objects in that sentence before the Section 2
coordinate package specializes the conclusion to `Q0`, `KW/W`, and
`GaloisField 2 n`.
-/

/-- The `F_p[T]`-module representation of the action of `T` on an elementary
abelian group `E`, using Peterfalvi's additive notation for `E`. -/
public noncomputable abbrev AppendixIRepresentationOfT
    {p : ℕ} [Fact p.Prime]
    {E U : Type*} [Group E] [Finite E] [Group U]
    [IsElementaryAbelian p E] [MulDistribMulAction U E]
    (T : Subgroup U) :
    Representation (ZMod p) T (Additive E) :=
  Theory.Representation.ofElementaryAbelianAction (A := T) (G := E) (p := p)

/-- Peterfalvi's `End_T(E)`: endomorphisms of the `F_p[T]`-module `E`. -/
public abbrev AppendixIEndT
    {p : ℕ} [Fact p.Prime]
    {E U : Type*} [Group E] [Finite E] [Group U]
    [IsElementaryAbelian p E] [MulDistribMulAction U E]
    (T : Subgroup U) : Type _ :=
  Module.End (MonoidAlgebra (ZMod p) T)
    (AppendixIRepresentationOfT (p := p) (E := E) T).asModule

/-- The operator on `E` induced by an element of the commutative group `T`,
viewed inside `End_T(E)`. -/
public noncomputable def AppendixITActionEnd
    {p : ℕ} [Fact p.Prime]
    {E U : Type*} [Group E] [Finite E] [Group U]
    [IsElementaryAbelian p E] [MulDistribMulAction U E]
    (T : Subgroup U) [IsMulCommutative T] (τ : T) :
    AppendixIEndT (p := p) (E := E) T :=
  let ρ := AppendixIRepresentationOfT (p := p) (E := E) T
  (Theory.Representation.RepMap.equivLinearMapAsModule (ρ := ρ) (σ := ρ))
    (Theory.Representation.RepMap.centralMul (ρ := ρ) τ
      (Submonoid.mem_center_iff.mpr (by
        intro σ
        exact (mul_comm τ σ).symm)))

@[simp]
public theorem AppendixITActionEnd_apply
    {p : ℕ} [Fact p.Prime]
    {E U : Type*} [Group E] [Finite E] [Group U]
    [IsElementaryAbelian p E] [MulDistribMulAction U E]
    (T : Subgroup U) [IsMulCommutative T] (τ : T) (x : Additive E) :
    AppendixITActionEnd (p := p) (E := E) T τ x =
      Additive.ofMul ((τ : U) • Additive.toMul x) := by
  unfold AppendixITActionEnd Theory.Representation.RepMap.equivLinearMapAsModule
    Theory.Representation.RepMap.centralMul
    Representation.IntertwiningMap.equivLinearMapAsModule
    Representation.IntertwiningMap.centralMul
  change
    (AppendixIRepresentationOfT (p := p) (E := E) T) τ x =
      Additive.ofMul ((τ : U) • Additive.toMul x)
  exact Theory.Representation.ofElementaryAbelianAction_apply_ofMul
    (A := T) (G := E) (p := p) τ x
/-- Peterfalvi's `F_p[T]` as the subalgebra of `End_T(E)` generated by the
operators coming from the elements of the commutative group `T`. -/
@[expose]
public noncomputable def AppendixIFpT
    {p : ℕ} [Fact p.Prime]
    {E U : Type*} [Group E] [Finite E] [Group U]
    [IsElementaryAbelian p E] [MulDistribMulAction U E]
    (T : Subgroup U) [IsMulCommutative T] :
    Subalgebra (ZMod p) (AppendixIEndT (p := p) (E := E) T) :=
  Algebra.adjoin (ZMod p) (Set.range (AppendixITActionEnd (p := p) (E := E) T))

end PFAppendixI
