/-!
# Hall §14.4 basic definitions

Book-order support definitions for Hall, *The Theory of Groups*, §14.4.
These declarations keep Hall's notation (`u_p(G)`, Engel commutators, weak
closure, and the subgroup `H_0 = H^p (H,H_1) u_p(H)`) in the Hall directory.
-/

namespace CFSG.BenderSuzuki
namespace External

open PFchapter1section1 PFAppendixIII
open PFchapter2
open scoped BigOperators Pointwise

attribute [local instance] Fintype.ofFinite

universe u

/--
Hall's subgroup `u_p(G)`: the subgroup generated by the elements whose orders
are prime to `p`. This is the object appearing in Hall, Section 14.4; it is not
the largest normal `p'`-subgroup `O_{p'}(G)`.
-/
@[expose] public def hallPResidual
    (p : ℕ) (G : Type u) [Group G] : Subgroup G :=
  Subgroup.closure {g : G | Nat.Coprime p (orderOf g)}

/-- Hall's residual subgroup is normal, since its generating set is closed
under conjugation. -/
public theorem hallPResidual_normal
    (p : ℕ) (G : Type u) [Group G] : (hallPResidual p G).Normal where
  conj_mem n hn g := by
    refine Subgroup.closure_induction (fun x hx => ?_) ?_
      (fun x y _ _ hx' hy' => ?_) (fun x _ hx' => ?_) hn
    · exact Subgroup.subset_closure <| by
        have hconj : SemiconjBy g x (g * x * g⁻¹) := by
          simp [SemiconjBy, mul_assoc]
        have horder := SemiconjBy.orderOf_eq g hconj
        simpa [horder] using hx
    · simp
    · rw [← conj_mul]
      exact (hallPResidual p G).mul_mem hx' hy'
    · rw [← conj_inv]
      exact (hallPResidual p G).inv_mem hx'

/-- Hall's `p`-residual is characteristic: automorphisms preserve element
orders and hence preserve its canonical generating set. -/
public instance hallPResidual_characteristic
    (p : ℕ) (G : Type u) [Group G] : (hallPResidual p G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_le]
  intro φ
  intro x hx
  rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
  refine Subgroup.closure_induction (p := fun y _hy => φ y ∈ hallPResidual p G)
    ?_ ?_ ?_ ?_ hy
  · intro y hy
    apply Subgroup.subset_closure
    change Nat.Coprime p (orderOf (φ y))
    simpa using hy
  · simpa using (Subgroup.one_mem (hallPResidual p G))
  · intro a b _ha _hb ha hb
    simpa using (Subgroup.mul_mem (hallPResidual p G) ha hb)
  · intro a _ha ha
    simpa using (Subgroup.inv_mem (hallPResidual p G) ha)

/-- Universal property of Hall's residual: every homomorphism into a
`p`-group kills the `p'`-order generators. -/
public theorem hallPResidual_le_ker_of_isPGroup
    {p : ℕ} [Fact p.Prime] {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hH : IsPGroup p H) :
    hallPResidual p G ≤ f.ker := by
  rw [hallPResidual, Subgroup.closure_le]
  intro x hx
  change f x = 1
  obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp hH) (f x)
  have hcop : Nat.Coprime (orderOf (f x)) (orderOf x) := by
    rw [hk]
    exact hx.pow_left k
  have hone : orderOf (f x) = 1 :=
    Nat.eq_one_of_dvd_coprimes hcop (dvd_refl _) (orderOf_map_dvd f x)
  exact orderOf_eq_one_iff.mp hone


/-- The intersection of a fixed Sylow subgroup with a normal subgroup,
viewed in that normal subgroup. -/
@[expose] public noncomputable def hallSylowSubgroupOfNormal
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (S : Sylow p G) (K : Subgroup G) [K.Normal] :
    Sylow p K := by
  classical
  let I : Subgroup K := (S : Subgroup G).comap K.subtype
  have hIp : IsPGroup p I := S.isPGroup'.comap_subtype
  apply hIp.toSylow
  let R : Sylow p K := Classical.choice inferInstance
  obtain ⟨Q, hQcomap⟩ := R.exists_comap_subtype_eq
  obtain ⟨g, hQconj⟩ := MulAction.exists_smul_eq G Q S
  have hQconjSub :
      MulAut.conj g • (Q : Subgroup G) = (S : Subgroup G) :=
    congrArg (fun T : Sylow p G => (T : Subgroup G)) hQconj
  have hsmul :
      (MulAut.conjNormal g : MulAut K) •
          ((Q : Subgroup G).comap K.subtype) = I := by
    ext x
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
    change
      (((MulAut.conjNormal g : MulAut K)⁻¹ x : K) : G) ∈ (Q : Subgroup G) ↔
        (x : G) ∈ (S : Subgroup G)
    rw [← hQconjSub]
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem]
    simp
  have hcardQI :
      Nat.card ((Q : Subgroup G).comap K.subtype) = Nat.card I := by
    let e :
        ((Q : Subgroup G).comap K.subtype) ≃*
          ↥((MulAut.conjNormal g : MulAut K) •
            ((Q : Subgroup G).comap K.subtype)) :=
      Subgroup.equivSMul (MulAut.conjNormal g : MulAut K)
        ((Q : Subgroup G).comap K.subtype)
    exact Nat.card_congr (e.trans (MulEquiv.subgroupCongr hsmul)).toEquiv
  have hcardQR :
      Nat.card ((Q : Subgroup G).comap K.subtype) = Nat.card R := by
    rw [hQcomap]
  have hcardIR : Nat.card I = Nat.card R := hcardQI.symm.trans hcardQR
  have hindex : I.index = R.index := by
    apply Nat.mul_left_cancel (Nat.card_pos (α := I))
    calc
      Nat.card I * I.index = Nat.card K := Subgroup.card_mul_index I
      _ = Nat.card R * R.index :=
        (Subgroup.card_mul_index (R : Subgroup K)).symm
      _ = Nat.card I * R.index := by rw [hcardIR]
  simpa [hindex] using R.not_dvd_index

/-- The subgroup underlying `hallSylowSubgroupOfNormal` is the expected
comap, hence the intersection with the normal subgroup. -/
public theorem hallSylowSubgroupOfNormal_coe
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (S : Sylow p G) (K : Subgroup G) [K.Normal] :
    (hallSylowSubgroupOfNormal S K : Subgroup K) =
      (S : Subgroup G).comap K.subtype := rfl
/-- Hall's fixed Sylow subgroup intersects `u_p(G)` in a Sylow subgroup of
`u_p(G)`. -/
public theorem hall_residual_inf_sylow
    {G : Type u} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (P₁ : Sylow p G) (G₀ : Subgroup G)
    (hG₀ : G₀ = hallPResidual p G) :
    ∃ P₀ : Sylow p G₀,
      ((P₀ : Subgroup G₀).map G₀.subtype : Subgroup G) =
        G₀ ⊓ (P₁ : Subgroup G) := by
  letI : G₀.Normal := by
    subst G₀
    exact hallPResidual_normal p G
  let P₀ : Sylow p G₀ := hallSylowSubgroupOfNormal P₁ G₀
  refine ⟨P₀, ?_⟩
  rw [hallSylowSubgroupOfNormal_coe]
  rw [Subgroup.comap_subtype, Subgroup.subgroupOf_map_subtype]
  exact inf_comm _ _
/-- The quotient by Hall's `p`-residual `u_p(G)` is a `p`-group.  This is the
formal version of Hall's observation that `G/u_p(G)` is the maximal `p`-factor
of `G`. -/
public theorem hallPResidual_quotient_isPGroup
    {G : Type u} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    letI : (hallPResidual p G).Normal := hallPResidual_normal p G
    IsPGroup p (G ⧸ hallPResidual p G) := by
  classical
  letI : (hallPResidual p G).Normal := hallPResidual_normal p G
  refine (IsPGroup.iff_orderOf (p := p) (G := G ⧸ hallPResidual p G)).2 ?_
  intro q
  refine exists_orderOf_eq_prime_pow_iff.mpr ?_
  refine QuotientGroup.induction_on q ?_
  intro g
  let k : ℕ := (orderOf g).factorization p
  refine ⟨k, ?_⟩
  rw [← QuotientGroup.mk_pow]
  apply (QuotientGroup.eq_one_iff _).mpr
  apply Subgroup.subset_closure
  have horder_ne : orderOf g ≠ 0 := (orderOf_pos g).ne'
  have hpow_dvd : p ^ k ∣ orderOf g := by
    exact ((Fact.out : Nat.Prime p).pow_dvd_iff_le_factorization horder_ne).2 le_rfl
  have hpow_ne : p ^ k ≠ 0 := pow_ne_zero _ (Fact.out : Nat.Prime p).ne_zero
  have horder_pow : orderOf (g ^ p ^ k) = orderOf g / p ^ k := by
    exact orderOf_pow_of_dvd hpow_ne hpow_dvd
  change Nat.Coprime p (orderOf (g ^ p ^ k))
  rw [horder_pow]
  apply (Fact.out : Nat.Prime p).coprime_iff_not_dvd.2
  intro hdiv
  have hpow_succ_dvd : p ^ (k + 1) ∣ orderOf g := by
    rw [pow_succ]
    exact Nat.mul_dvd_of_dvd_div hpow_dvd hdiv
  have hle : k + 1 ≤ k := by
    exact ((Fact.out : Nat.Prime p).pow_dvd_iff_le_factorization horder_ne).1 hpow_succ_dvd
  omega
/-- Every quotient whose kernel contains Hall's `p`-residual is a `p`-group. -/
public theorem hallPResidual_le_quotient_isPGroup
    {G : Type u} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (N : Subgroup G) [N.Normal] (hres : hallPResidual p G ≤ N) :
    IsPGroup p (G ⧸ N) := by
  classical
  refine (IsPGroup.iff_orderOf (p := p) (G := G ⧸ N)).2 ?_
  intro q
  refine exists_orderOf_eq_prime_pow_iff.mpr ?_
  refine QuotientGroup.induction_on q ?_
  intro g
  let k : ℕ := (orderOf g).factorization p
  refine ⟨k, ?_⟩
  rw [← QuotientGroup.mk_pow]
  apply (QuotientGroup.eq_one_iff _).mpr
  apply hres
  apply Subgroup.subset_closure
  have horder_ne : orderOf g ≠ 0 := (orderOf_pos g).ne'
  have hpow_dvd : p ^ k ∣ orderOf g := by
    exact ((Fact.out : Nat.Prime p).pow_dvd_iff_le_factorization horder_ne).2 le_rfl
  have hpow_ne : p ^ k ≠ 0 := pow_ne_zero _ (Fact.out : Nat.Prime p).ne_zero
  have horder_pow : orderOf (g ^ p ^ k) = orderOf g / p ^ k := by
    exact orderOf_pow_of_dvd hpow_ne hpow_dvd
  change Nat.Coprime p (orderOf (g ^ p ^ k))
  rw [horder_pow]
  apply (Fact.out : Nat.Prime p).coprime_iff_not_dvd.2
  intro hdiv
  have hpow_succ_dvd : p ^ (k + 1) ∣ orderOf g := by
    rw [pow_succ]
    exact Nat.mul_dvd_of_dvd_div hpow_dvd hdiv
  have hle : k + 1 ≤ k := by
    exact ((Fact.out : Nat.Prime p).pow_dvd_iff_le_factorization horder_ne).1 hpow_succ_dvd
  omega
/-- The quotient of the top subgroup by an induced normal subgroup is the
ambient quotient. -/
public noncomputable def topQuotientSubgroupOfEquivQuotient
    {G : Type u} [Group G] (K : Subgroup G) [K.Normal] :
    ((⊤ : Subgroup G) ⧸ K.subgroupOf (⊤ : Subgroup G)) ≃* G ⧸ K := by
  let q : G →* G ⧸ K := QuotientGroup.mk' K
  have htop_map : (⊤ : Subgroup G).map q = ⊤ := by
    exact Subgroup.map_top_of_surjective (f := q) (QuotientGroup.mk'_surjective K)
  exact (quotientSubgroupRangeEquiv (⊤ : Subgroup G) K).trans
    ((MulEquiv.subgroupCongr htop_map).trans Subgroup.topEquiv)

/-- If `H` maps onto `G/K` and the residual subgroup of `H` maps to
`K ∩ H`, then the two quotients are isomorphic. -/
public theorem hallQuotientIsoOfMapResidualEq
    {G : Type u} [Group G] (K H : Subgroup G) (L : Subgroup H)
    [K.Normal] [L.Normal]
    (hLmap : L.map H.subtype = K ⊓ H)
    (hHK : H ⊔ K = ⊤) :
    Nonempty ((G ⧸ K) ≃* (H ⧸ L)) := by
  classical
  have hKsub_normal : (K.subgroupOf H).Normal := by
    exact Subgroup.normal_subgroupOf_of_le_normalizer (H := H) (N := K)
      Subgroup.le_normalizer_of_normal
  have hL_eq : L = K.subgroupOf H := by
    ext x
    constructor
    · intro hx
      have hxmap : (x : G) ∈ L.map H.subtype := Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
      have hxKH : (x : G) ∈ K ⊓ H := by simpa [hLmap] using hxmap
      exact hxKH.1
    · intro hx
      have hxmap : (x : G) ∈ L.map H.subtype := by
        rw [hLmap]
        exact ⟨hx, x.2⟩
      rcases Subgroup.mem_map.mp hxmap with ⟨y, hy, hyx⟩
      have hxy : y = x := by
        ext
        exact hyx
      simpa [← hxy] using hy
  let eHK : H ⧸ K.subgroupOf H ≃* (H ⊔ K : Subgroup G) ⧸ K.subgroupOf (H ⊔ K) :=
    QuotientGroup.quotientInfEquivProdNormalQuotient H K
  let eTop : (H ⊔ K : Subgroup G) ⧸ K.subgroupOf (H ⊔ K) ≃*
      (⊤ : Subgroup G) ⧸ K.subgroupOf (⊤ : Subgroup G) :=
    QuotientGroup.equivQuotientSubgroupOfOfEq
      (A' := K) (A := H ⊔ K) (B' := K) (B := ⊤) rfl hHK
  let eGTop : (⊤ : Subgroup G) ⧸ K.subgroupOf (⊤ : Subgroup G) ≃* G ⧸ K :=
    topQuotientSubgroupOfEquivQuotient K
  let eL : H ⧸ L ≃* H ⧸ K.subgroupOf H := QuotientGroup.quotientMulEquivOfEq hL_eq
  exact ⟨eGTop.symm.trans (eTop.symm.trans (eHK.symm.trans eL.symm))⟩
/-- If a subgroup contains a Sylow `p`-subgroup, then it maps onto the Hall
`p`-residual quotient. -/
public theorem hall_sup_hallPResidual_eq_top_of_sylow_le
    {G : Type u} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (P : Sylow p G) (H : Subgroup G) (hP_le_H : (P : Subgroup G) ≤ H) :
    H ⊔ hallPResidual p G = ⊤ := by
  classical
  let K : Subgroup G := hallPResidual p G
  letI : K.Normal := hallPResidual_normal p G
  let q : G →* G ⧸ K := QuotientGroup.mk' K
  have hquot_p : IsPGroup p (G ⧸ K) := by
    simpa [K] using hallPResidual_quotient_isPGroup (G := G) p
  have htop_p : IsPGroup p (⊤ : Subgroup (G ⧸ K)) := hquot_p.to_subgroup ⊤
  have hPmap_top : (P : Subgroup G).map q = ⊤ := by
    let Pq : Sylow p (G ⧸ K) := P.mapSurjective (QuotientGroup.mk'_surjective K)
    simpa [Pq] using (Pq.3 htop_p le_top).symm
  have hHmap_top : H.map q = ⊤ := by
    apply top_le_iff.mp
    rw [← hPmap_top]
    exact Subgroup.map_mono hP_le_H
  have hcomap : H ⊔ K = ⊤ := by
    calc
      H ⊔ K = H ⊔ q.ker := by simp [q, K, QuotientGroup.ker_mk']
      _ = (H.map q).comap q := (Subgroup.comap_map_eq (f := q) (H := H)).symm
      _ = ⊤ := by rw [hHmap_top, Subgroup.comap_top]
  simpa [K] using hcomap

/-- If `H = u_p(G) ∩ H₁`, then the `p`-residuals of `H₁` and `H` have the
same image in the ambient group. -/
public theorem hallPResidual_map_inf_eq
    {G : Type u} [Group G] (p : ℕ) (H₁ G₀ H : Subgroup G)
    (hG₀ : G₀ = hallPResidual p G)
    (hH : H = G₀ ⊓ H₁) :
    (hallPResidual p H₁).map H₁.subtype = (hallPResidual p H).map H.subtype := by
  subst G₀
  subst H
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    exact (Subgroup.closure_le _).2 (by
      intro x hx
      change (x : G) ∈
        (hallPResidual p (↥(hallPResidual p G ⊓ H₁))).map (hallPResidual p G ⊓ H₁).subtype
      let y : ↥(hallPResidual p G ⊓ H₁) :=
        ⟨(x : G), ⟨Subgroup.subset_closure (show Nat.Coprime p (orderOf (x : G)) by
            simpa [Subgroup.orderOf_coe] using hx), x.2⟩⟩
      refine Subgroup.mem_map.mpr ⟨y, ?_, rfl⟩
      have hy_order : orderOf y = orderOf x := by
        rw [← Subgroup.orderOf_coe y, ← Subgroup.orderOf_coe x]
      exact Subgroup.subset_closure (show Nat.Coprime p (orderOf y) by
        simpa [hy_order] using hx))
  · rw [Subgroup.map_le_iff_le_comap]
    exact (Subgroup.closure_le _).2 (by
      intro x hx
      change (x : G) ∈ (hallPResidual p H₁).map H₁.subtype
      let y : H₁ := ⟨(x : G), x.2.2⟩
      refine Subgroup.mem_map.mpr ⟨y, ?_, rfl⟩
      have hy_order : orderOf y = orderOf x := by
        rw [← Subgroup.orderOf_coe y, ← Subgroup.orderOf_coe x]
      exact Subgroup.subset_closure (show Nat.Coprime p (orderOf y) by
        simpa [hy_order] using hx))
/-- The subgroup generated by all `p`th powers of elements of `H`, Hall's
notation `H^p`. -/
@[expose] public noncomputable def hallPPowerSubgroup
    {G : Type u} [Group G] (p : ℕ) (H : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | ∃ h : H, (h : G) ^ p = x}

/-- Hall's subgroup `H_0 = H^p (H,H_1) u_p(H)`, viewed in the ambient group. -/
@[expose] public noncomputable def hallTransferModulus
    {G : Type u} [Group G] (p : ℕ) (H H₁ : Subgroup G) : Subgroup G :=
  hallPPowerSubgroup p H ⊔ ⁅H, H₁⁆ ⊔ (hallPResidual p H).map H.subtype
/-- In Hall's setup `H = u_p(G) ∩ H₁`, the subgroup
`H₀ = H^p (H,H₁) u_p(H)` lies in `H`. -/
public theorem hallTransferModulus_le_of_inf
    {G : Type u} [Group G] (p : ℕ) (H₁ G₀ H : Subgroup G)
    (hG₀ : G₀ = hallPResidual p G)
    (hH : H = G₀ ⊓ H₁) :
    hallTransferModulus p H H₁ ≤ H := by
  have hG₀_normal : G₀.Normal := by
    subst G₀
    exact hallPResidual_normal p G
  unfold hallTransferModulus
  refine sup_le ?_ ?_
  · refine sup_le ?_ ?_
    · unfold hallPPowerSubgroup
      exact (Subgroup.closure_le _).2 (by
        rintro x ⟨h, rfl⟩
        exact H.pow_mem h.2 p)
    · rw [Subgroup.commutator_le]
      intro a ha b hb
      rw [hH] at ha ⊢
      constructor
      · simpa [commutatorElement_def, mul_assoc] using
          G₀.mul_mem ha.1 (hG₀_normal.conj_mem _ (G₀.inv_mem ha.1) b)
      · simpa [commutatorElement_def, mul_assoc] using
          H₁.mul_mem (H₁.mul_mem ha.2 hb) (H₁.mul_mem (H₁.inv_mem ha.2) (H₁.inv_mem hb))
  · exact Subgroup.map_subtype_le (hallPResidual p H)

/-- Hall's transfer modulus is normal in `H` whenever `H ≤ H₁` and all three
of its defining factors lie in `H`. -/
public theorem hallTransferModulus_subgroupOf_normal
    {G : Type u} [Group G] (p : ℕ) (H H₁ : Subgroup G)
    (hH_le_H₁ : H ≤ H₁)
    (hmod : hallTransferModulus p H H₁ ≤ H) :
    ((hallTransferModulus p H H₁).subgroupOf H).Normal := by
  have hA : hallPPowerSubgroup p H ≤ H :=
    (le_sup_left.trans le_sup_left).trans hmod
  have hC : ⁅H, H₁⁆ ≤ H :=
    (le_sup_right.trans le_sup_left).trans hmod
  have hR : (hallPResidual p H).map H.subtype ≤ H :=
    le_sup_right.trans hmod
  have hA_normal : ((hallPPowerSubgroup p H).subgroupOf H).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hA]
    intro x h hx hh
    unfold hallPPowerSubgroup at hx ⊢
    refine Subgroup.closure_induction (fun y hy => ?_) ?_
      (fun y z _ _ hy' hz' => ?_) (fun y _ hy' => ?_) hx
    · exact Subgroup.subset_closure <| by
        rcases hy with ⟨a, rfl⟩
        refine ⟨⟨h * (a : G) * h⁻¹, H.mul_mem (H.mul_mem hh a.2) (H.inv_mem hh)⟩, ?_⟩
        exact conj_pow
    · simp
    · rw [← conj_mul]
      exact (hallPPowerSubgroup p H).mul_mem hy' hz'
    · rw [← conj_inv]
      exact (hallPPowerSubgroup p H).inv_mem hy'
  have hC_normal : (⁅H, H₁⁆.subgroupOf H).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hC]
    intro x h hx hh
    rw [Subgroup.commutator_def] at hx ⊢
    refine Subgroup.closure_induction (fun y hy => ?_) ?_
      (fun y z _ _ hy' hz' => ?_) (fun y _ hy' => ?_) hx
    · exact Subgroup.subset_closure <| by
        rcases hy with ⟨a, ha, b, hb, rfl⟩
        refine ⟨h * a * h⁻¹, H.mul_mem (H.mul_mem hh ha) (H.inv_mem hh),
          h * b * h⁻¹, ?_, ?_⟩
        · have hh₁ : h ∈ H₁ := hH_le_H₁ hh
          exact H₁.mul_mem (H₁.mul_mem hh₁ hb) (H₁.inv_mem hh₁)
        · exact (conjugate_commutatorElement a b h).symm
    · simp
    · rw [← conj_mul]
      exact ⁅H, H₁⁆.mul_mem hy' hz'
    · rw [← conj_inv]
      exact ⁅H, H₁⁆.inv_mem hy'
  have hR_normal : (((hallPResidual p H).map H.subtype).subgroupOf H).Normal := by
    rw [show ((hallPResidual p H).map H.subtype).subgroupOf H =
        hallPResidual p H from
      Subgroup.comap_map_eq_self_of_injective Subtype.val_injective _]
    exact hallPResidual_normal p H
  rw [show (hallTransferModulus p H H₁).subgroupOf H =
      (hallPPowerSubgroup p H).subgroupOf H ⊔ ⁅H, H₁⁆.subgroupOf H ⊔
        ((hallPResidual p H).map H.subtype).subgroupOf H by
    unfold hallTransferModulus
    rw [Subgroup.subgroupOf_sup (sup_le hA hC) hR,
      Subgroup.subgroupOf_sup hA hC]]
  letI : ((hallPPowerSubgroup p H).subgroupOf H).Normal := hA_normal
  letI : (⁅H, H₁⁆.subgroupOf H).Normal := hC_normal
  letI : (((hallPResidual p H).map H.subtype).subgroupOf H).Normal := hR_normal
  infer_instance

/--
The diagonal contribution `d(g)` in Hall §14.4, expressed in the target of a
transfer homomorphism. It is the product of the fixed length-one coset-cycle
terms in the transfer formula.
-/
@[expose] public noncomputable def hallDiagonalContribution
    {G A : Type u} [Group G] [Finite G] {H : Subgroup G} [H.FiniteIndex]
    [CommGroup A] (φ : H →* A) (g : G) : A :=
  ∏ q : {q : G ⧸ H // Function.minimalPeriod (g • ·) q = 1},
    φ ⟨q.1.out⁻¹ * g * q.1.out, by
      have hmem :=
        QuotientGroup.out_conj_pow_minimalPeriod_mem (H := H) g q.1
      simpa [q.2] using hmem⟩

/-- Hall's diagonal defect `d*(h)=h⁻¹d(h)`, in the transfer target. -/
@[expose] public noncomputable def hallDiagonalDefect
    {G A : Type u} [Group G] [Finite G] {H : Subgroup G} [H.FiniteIndex]
    [CommGroup A] (φ : H →* A) (h : H) : A :=
  (φ h)⁻¹ * hallDiagonalContribution (H := H) φ (h : G)

/-- The inverse-first commutator convention `(x,y)=x⁻¹ y⁻¹ x y`. -/
@[expose] public def inverseFirstCommutator
    {G : Type u} [Group G] (x y : G) : G :=
  x⁻¹ * y⁻¹ * x * y

/-- Left-normed iterated inverse-first commutator, with `z` repeated `n` times. -/
@[expose] public def iteratedInverseFirstCommutator
    {G : Type u} [Group G] : ℕ → G → G → G
  | 0, u, _ => u
  | n + 1, u, z => inverseFirstCommutator (iteratedInverseFirstCommutator n u z) z

/-- The Engel symbol `e_n(u,z)=(u,z,...,z)` has total commutator weight `n`,
so `z` is repeated `n-1` times. -/
@[expose] public def engelSymbol
    {G : Type u} [Group G] (n : ℕ) (u z : G) : G :=
  iteratedInverseFirstCommutator (n - 1) u z


/--
Weak closure of `Q` in `P` with respect to the ambient group `G`: every right
conjugate of `Q` contained in `P` is equal to `Q`.
-/
@[expose] public def WeaklyClosedIn
    {G : Type u} [Group G] (P Q : Subgroup G) : Prop :=
  Q ≤ P ∧ ∀ g : G, rightConjugate Q g ≤ P → rightConjugate Q g = Q


/-- A weakly closed subgroup of `P` is normal in `P`, as noted at the start of
Hall §14.4. -/
public theorem weaklyClosedIn_subgroupOf_normal
    {G : Type u} [Group G] {P Q : Subgroup G}
    (hweak : WeaklyClosedIn P Q) : (Q.subgroupOf P).Normal := by
  have hconj_eq_of_mem : ∀ r : G, r ∈ P → rightConjugate Q r = Q := by
    intro r hr
    apply hweak.2 r
    intro x hx
    change x ∈ Q.conjBy r⁻¹ at hx
    rcases Subgroup.mem_map.mp hx with ⟨q, hq, hxq⟩
    rw [← hxq]
    simp
    exact P.mul_mem (P.mul_mem (P.inv_mem hr) (hweak.1 hq)) hr
  refine (Subgroup.normal_subgroupOf_iff_le_normalizer hweak.1).2 ?_
  intro p hp
  have hconj_eq_p : rightConjugate Q p = Q := hconj_eq_of_mem p hp
  have hconj_eq_inv : rightConjugate Q p⁻¹ = Q := hconj_eq_of_mem p⁻¹ (P.inv_mem hp)
  rw [Subgroup.mem_normalizer_iff]
  intro q
  constructor
  · intro hq
    have hx : p * q * p⁻¹ ∈ rightConjugate Q p⁻¹ := by
      change p * q * p⁻¹ ∈ Q.conjBy (p⁻¹)⁻¹
      exact Subgroup.mem_map.mpr ⟨q, hq, by simp⟩
    simpa [hconj_eq_inv] using hx
  · intro hq
    have hx : q ∈ rightConjugate Q p := by
      change q ∈ Q.conjBy p⁻¹
      exact Subgroup.mem_map.mpr ⟨p * q * p⁻¹, hq, by simp [mul_assoc]⟩
    simpa [hconj_eq_p] using hx


/-- If Q is weakly closed in P, every element normalizing P also normalizes Q. -/
public theorem weaklyClosedIn_normalizer_le_normalizer
    {G : Type u} [Group G] {P Q : Subgroup G}
    (hweak : WeaklyClosedIn P Q) :
    Subgroup.normalizer (P : Set G) ≤ Subgroup.normalizer (Q : Set G) := by
  intro n hn
  have hninv : n⁻¹ ∈ Subgroup.normalizer (P : Set G) :=
    (Subgroup.normalizer (P : Set G)).inv_mem hn
  have hmapP :
      P.map (MulAut.conj n⁻¹).toMonoidHom = P := by
    rw [← Subgroup.conjAct_pointwise_smul_iff] at hninv
    change P.map (MulAut.conj n⁻¹).toMonoidHom = P at hninv
    exact hninv
  have hrightQ_le : rightConjugate Q n ≤ P := by
    change Q.map (MulAut.conj n⁻¹).toMonoidHom ≤ P
    rw [← hmapP]
    exact Subgroup.map_mono hweak.1
  have hrightQ : rightConjugate Q n = Q := hweak.2 n hrightQ_le
  have hninvQ : n⁻¹ ∈ Subgroup.normalizer (Q : Set G) := by
    rw [← Subgroup.conjAct_pointwise_smul_iff]
    change Q.map (MulAut.conj n⁻¹).toMonoidHom = Q
    simpa [rightConjugate, Subgroup.conjBy] using hrightQ
  simpa using (Subgroup.normalizer (Q : Set G)).inv_mem hninvQ
end External
end CFSG.BenderSuzuki

