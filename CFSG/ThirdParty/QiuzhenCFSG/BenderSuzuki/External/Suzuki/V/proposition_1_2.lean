module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.PFAppendixIII.Basic
public import Mathlib.GroupTheory.OrderOfElement

namespace CFSG
end CFSG
open CFSG

/-!
# Suzuki, Group Theory II, Chapter 5, Proposition 1.2(iii)

The half-power of a product of two distinct involutions of even order is the
involution in the cyclic subgroup generated by that product, and it commutes
with both factors.
-/

namespace CFSG.BenderSuzuki
namespace External
namespace Suzuki
namespace V

open PFAppendixIII

universe u

/-- Suzuki, *Group Theory II*, Chapter 5, Proposition 1.2(iii). -/
public theorem suzuki_ch5_proposition_1_2_iii
    {G : Type u} [Group G] [Finite G]
    {u v : G} (hu : IsInvolution u) (hv : IsInvolution v) (huv : u ≠ v)
    {m : ℕ} (horder : orderOf (u * v) = 2 * m) :
    IsInvolution ((u * v) ^ m) ∧
      Commute ((u * v) ^ m) u ∧ Commute ((u * v) ^ m) v := by
  let w : G := u * v
  let t : G := w ^ m
  have hw_ne_one : w ≠ 1 := by
    intro hw
    apply huv
    calc
      u = u * 1 := by simp
      _ = u * (u * v) := by rw [show u * v = 1 from hw]
      _ = v := by
        have huu : u * u = 1 := by
          simpa [pow_two] using hu.sq_eq_one
        rw [← mul_assoc, huu, one_mul]
  have hm : m ≠ 0 := by
    intro hm
    have hw_order_pos : 0 < orderOf w := orderOf_pos w
    have hw_order_zero : orderOf w = 0 := by
      simpa [w, hm] using horder
    exact (Nat.ne_of_gt hw_order_pos) hw_order_zero
  have hm_dvd : m ∣ orderOf w := by
    refine ⟨2, ?_⟩
    simpa [w, Nat.mul_comm] using horder
  have ht_order : orderOf t = 2 := by
    rw [show t = w ^ m from rfl, orderOf_pow_of_dvd hm hm_dvd]
    have hm_pos : 0 < m := Nat.pos_of_ne_zero hm
    rw [show orderOf w = 2 * m by simpa [w] using horder]
    simpa [Nat.mul_comm] using Nat.mul_div_right 2 hm_pos
  have ht : IsInvolution t := by
    constructor
    · intro ht_one
      have ht_order_one : orderOf t = 1 := orderOf_eq_one_iff.mpr ht_one
      have : (2 : ℕ) = 1 := ht_order.symm.trans ht_order_one
      omega
    · rw [← orderOf_dvd_iff_pow_eq_one, ht_order]
  have conjugate_pow (a x : G) (n : ℕ) :
      a * x ^ n * a⁻¹ = (a * x * a⁻¹) ^ n := by
    induction n with
    | zero => simp
    | succ n ih =>
        rw [pow_succ, pow_succ, ← ih]
        group
  have huu : u * u = 1 := by
    simpa [pow_two] using hu.sq_eq_one
  have hvv : v * v = 1 := by
    simpa [pow_two] using hv.sq_eq_one
  have hu_conj_w : u * w * u⁻¹ = w⁻¹ := by
    calc
      u * w * u⁻¹ = (u * u) * v * u := by
        rw [show w = u * v from rfl, hu.inv_eq_self]
        group
      _ = v * u := by rw [huu, one_mul]
      _ = w⁻¹ := by simp [w, mul_inv_rev, hu.inv_eq_self, hv.inv_eq_self]
  have hv_conj_w : v * w * v⁻¹ = w⁻¹ := by
    calc
      v * w * v⁻¹ = v * u * (v * v) := by
        rw [show w = u * v from rfl, hv.inv_eq_self]
        group
      _ = v * u := by rw [hvv, mul_one]
      _ = w⁻¹ := by simp [w, mul_inv_rev, hu.inv_eq_self, hv.inv_eq_self]
  have hu_conj_t : u * t * u⁻¹ = t⁻¹ := by
    calc
      u * t * u⁻¹ = (u * w * u⁻¹) ^ m := by
        change u * w ^ m * u⁻¹ = (u * w * u⁻¹) ^ m
        exact conjugate_pow u w m
      _ = (w⁻¹) ^ m := by rw [hu_conj_w]
      _ = t⁻¹ := by simp [t]
  have hv_conj_t : v * t * v⁻¹ = t⁻¹ := by
    calc
      v * t * v⁻¹ = (v * w * v⁻¹) ^ m := by
        change v * w ^ m * v⁻¹ = (v * w * v⁻¹) ^ m
        exact conjugate_pow v w m
      _ = (w⁻¹) ^ m := by rw [hv_conj_w]
      _ = t⁻¹ := by simp [t]
  have hu_fix_t : u * t * u⁻¹ = t := hu_conj_t.trans ht.inv_eq_self
  have hv_fix_t : v * t * v⁻¹ = t := hv_conj_t.trans ht.inv_eq_self
  refine ⟨by simpa [t, w] using ht, ?_, ?_⟩
  · show t * u = u * t
    calc
      t * u = (u * t * u⁻¹) * u := by rw [hu_fix_t]
      _ = u * t := by group
  · show t * v = v * t
    calc
      t * v = (v * t * v⁻¹) * v := by rw [hv_fix_t]
      _ = v * t := by group

end V
end Suzuki
end External
end CFSG.BenderSuzuki
