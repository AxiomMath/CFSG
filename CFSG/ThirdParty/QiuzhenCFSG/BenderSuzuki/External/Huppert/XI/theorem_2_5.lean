/-- The automorphism group of a finite field is generated by Frobenius. -/
private theorem finiteField_ringAut_isCyclic
    {p : ℕ} [Fact (Nat.Prime p)]
    {F : Type u} [Field F] [Finite F] [Algebra (ZMod p) F] :
    IsCyclic (F ≃+* F) := by
  let e : (F ≃+* F) ≃* (F ≃ₐ[ZMod p] F) := {
    toFun := fun σ =>
      AlgEquiv.ofRingEquiv (f := σ) (by
        intro x
        have h :
            (σ.toRingHom.comp (algebraMap (ZMod p) F) : ZMod p →+* F) =
              algebraMap (ZMod p) F :=
          RingHom.ext_zmod _ _
        exact DFunLike.congr_fun h x)
    invFun := fun σ => σ.toRingEquiv
    left_inv := by intro σ; ext x; rfl
    right_inv := by intro σ; ext x; rfl
    map_mul' := by intro σ τ; ext x; rfl }
  exact e.isCyclic.mpr inferInstance

/-- XI.2.5(e): the characteristic cyclic subgroup cannot act irreducibly on
the additive prime-field module. -/
private theorem huppert_XI_2_5_restriction_reducible
    {K : Type u} [PFAppendixII.RightNearField K] [Finite K]
    {p f : ℕ} (hp : Nat.Prime p) (hp2 : p ≠ 2)
    (hKcard : Nat.card K = p ^ f)
    (hNFchar : addOrderOf (1 : K) = p)
    (hres : hktPResidual 2 Kˣ = (⊤ : Subgroup Kˣ))
    (hsylowTwo :
      ∀ P : Sylow 2 Kˣ, IsCyclic P ∨
        ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
          Nonempty (P ≃* QuaternionGroup k))
    (Z : Subgroup Kˣ) (hZchar : Z.Characteristic)
    (hZcyclic : IsCyclic Z) :
    ¬ (letI : Fact (Nat.Prime p) := ⟨hp⟩
       letI : Module (ZMod p) K := hNFchar ▸ PFAppendixII.rightNearFieldZModModule K
       letI : IsElementaryAbelian p (Multiplicative K) :=
         hNFchar ▸ PFAppendixII.rightNearFieldMultiplicativeIsElementaryAbelian
       letI : IsMulCommutative Z := hZcyclic.isMulCommutative
       letI : MulDistribMulAction Z (Multiplicative K) :=
         PFAppendixII.rightNearFieldUnitsMulDistribMulAction Z
       let T : Subgroup Z := ⊤
       Representation.IsIrreducible
         (PFAppendixI.AppendixIRepresentationOfT
           (p := p) (E := Multiplicative K) T)) := by
  intro hIrr
  subst p
  letI : Fact (Nat.Prime (addOrderOf (1 : K))) := ⟨hp⟩
  letI moduleK : Module (ZMod (addOrderOf (1 : K))) K :=
    PFAppendixII.rightNearFieldZModModule K
  letI : IsElementaryAbelian (addOrderOf (1 : K)) (Multiplicative K) :=
    PFAppendixII.rightNearFieldMultiplicativeIsElementaryAbelian
  letI : IsMulCommutative Z := hZcyclic.isMulCommutative
  letI : MulDistribMulAction Z (Multiplicative K) :=
    PFAppendixII.rightNearFieldUnitsMulDistribMulAction Z
  letI : Z.Characteristic := hZchar
  have hZnormal : Z.Normal := inferInstance
  letI : Z.Normal := hZnormal
  obtain ⟨q, n, F, ringInst, finiteInst, algebraInst, e,
      hFfield, hqprime, hFcard, he1, hscalar, hclosure⟩ :=
    PFAppendixII.rightNearField_irreducible_cyclic_field_coordinates
      Z hZcyclic hIrr
  letI : CommRing F := ringInst
  letI : Finite F := finiteInst
  letI : Algebra (ZMod q) F := algebraInst
  letI : Field F := hFfield.toField
  letI : Fact (Nat.Prime q) := ⟨hqprime⟩
  letI : Finite (F ≃+* F) :=
    Finite.of_injective (fun s : F ≃+* F => (s : F → F)) (by
      intro s t h
      ext x
      exact congrFun h x)
  obtain ⟨sigmaOp, hsemi⟩ :=
    PFAppendixII.rightNearField_semilinear_coordinates
      Z hZnormal e he1 hscalar hclosure
  let invOp : Kˣ ≃* (Kˣ)ᵐᵒᵖ := MulEquiv.inv' Kˣ
  let sigma : Kˣ →* (F ≃+* F) := sigmaOp.comp invOp.toMonoidHom
  have hAutCyclic : IsCyclic (F ≃+* F) :=
    finiteField_ringAut_isCyclic (p := q) (F := F)
  letI : IsCyclic (F ≃+* F) := hAutCyclic
  have hRangeCyclic : IsCyclic sigma.range :=
    Subgroup.isCyclic_of_le (H := sigma.range) le_top
  have hKerCommutative : IsMulCommutative sigma.ker := by
    refine ⟨⟨fun a b => ?_⟩⟩
    apply Subtype.ext
    apply Units.ext
    apply e.injective
    have ha : sigmaOp (MulOpposite.op (a : Kˣ)) = 1 := by
      have haInv : sigma (a : Kˣ)⁻¹ = 1 := by
        rw [map_inv, a.property, inv_one]
      simpa [sigma, invOp] using haInv
    have hb : sigmaOp (MulOpposite.op (b : Kˣ)) = 1 := by
      have hbInv : sigma (b : Kˣ)⁻¹ = 1 := by
        rw [map_inv, b.property, inv_one]
      simpa [sigma, invOp] using hbInv
    have hab := hsemi (((a : sigma.ker) : Kˣ) : K) (b : Kˣ)
    have hba := hsemi (((b : sigma.ker) : Kˣ) : K) (a : Kˣ)
    calc
      e ((((a : sigma.ker) : Kˣ) : K) * (b : Kˣ)) =
          e (((a : sigma.ker) : Kˣ) : K) * e ((b : Kˣ) : K) := by
        simpa [ha, hb] using hab
      _ = e (((b : sigma.ker) : Kˣ) : K) * e ((a : Kˣ) : K) := mul_comm _ _
      _ = e ((((b : sigma.ker) : Kˣ) : K) * (a : Kˣ)) := by
        simpa [ha, hb] using hba.symm
  have hKodd : Odd (Nat.card K) := by
    rw [hKcard]
    exact (hp.odd_of_ne_two hp2).pow
  have hEven : 2 ∣ Nat.card Kˣ := by
    apply even_iff_two_dvd.mp
    rw [Nat.card_units]
    exact Nat.Odd.sub_odd hKodd odd_one
  by_cases hRangeEven : 2 ∣ Nat.card sigma.range
  · let Q := Kˣ ⧸ sigma.ker
    have hQres : hktPResidual 2 Q = (⊤ : Subgroup Q) := by
      simpa [Q] using
        hktPResidual_quotient_eq_top_of_eq_top sigma.ker hres
    let eQ : Q ≃* sigma.range := QuotientGroup.quotientKerEquivRange sigma
    have hQeven : 2 ∣ Nat.card Q := by
      rw [Nat.card_congr eQ.toEquiv]
      exact hRangeEven
    have hQcyclic : IsCyclic Q := eQ.isCyclic.mpr hRangeCyclic
    letI : IsCyclic Q := hQcyclic
    let P : Sylow 2 Q := default
    exact (huppert_XI_2_5_pResidual_ne_top_of_cyclic_sylow_two
      hQeven P inferInstance) hQres
  · have hRangeOdd : Odd (Nat.card sigma.range) := by
      exact Nat.not_even_iff_odd.mp (fun he => hRangeEven (even_iff_two_dvd.mp he))
    let P : Sylow 2 Kˣ := default
    let Pimage : Subgroup (F ≃+* F) := (P : Subgroup Kˣ).map sigma
    have hPimageTwo : IsPGroup 2 Pimage := P.isPGroup'.map sigma
    have hPimageOdd : Odd (Nat.card Pimage) :=
      hRangeOdd.of_dvd_nat (Subgroup.card_dvd_of_le (by
        rintro x ⟨y, hy, rfl⟩
        exact ⟨y, rfl⟩))
    have hPimageBot : Pimage = ⊥ := by
      obtain ⟨m, hm⟩ := hPimageTwo.exists_card_eq
      have hm0 : m = 0 := by
        by_contra hm0
        exact hPimageOdd.not_two_dvd_nat (by
          rw [hm]
          exact dvd_pow_self 2 hm0)
      apply Subgroup.card_eq_one.mp
      simpa [hm0] using hm
    have hP_le_ker : (P : Subgroup Kˣ) ≤ sigma.ker := by
      intro x hx
      rw [MonoidHom.mem_ker]
      have hximage : sigma x ∈ Pimage := ⟨x, hx, rfl⟩
      rw [hPimageBot] at hximage
      exact Subgroup.mem_bot.mp hximage
    have hPcomm : IsMulCommutative P := by
      refine ⟨⟨fun a b => ?_⟩⟩
      apply Subtype.ext
      let ak : sigma.ker := ⟨(a : Kˣ), hP_le_ker a.property⟩
      let bk : sigma.ker := ⟨(b : Kˣ), hP_le_ker b.property⟩
      simpa [ak, bk] using congrArg Subtype.val (hKerCommutative.is_comm.comm ak bk)
    rcases hsylowTwo P with hPcyclic | ⟨k, hk, _hkP, ⟨eP⟩⟩
    · exact (huppert_XI_2_5_pResidual_ne_top_of_cyclic_sylow_two
        hEven P hPcyclic) hres
    · apply quaternionGroup_not_commutative_of_two_le k hk
      refine ⟨⟨fun x y => ?_⟩⟩
      apply eP.symm.injective
      simpa using hPcomm.is_comm.comm (eP.symm x) (eP.symm y)

/-- The full opposite-unit right-multiplication representation is irreducible:
any nonzero vector can be carried to any other nonzero vector. -/
private theorem rightNearFieldRightMulRepresentation_irreducible
    {K : Type u} [PFAppendixII.RightNearField K] [Finite K] :
    letI : Fact (Nat.Prime (addOrderOf (1 : K))) :=
      ⟨PFAppendixII.rightNearField_addOrderOf_one_prime⟩
    letI : Module (ZMod (addOrderOf (1 : K))) K :=
      PFAppendixII.rightNearFieldZModModule K
    Representation.IsIrreducible
      (PFAppendixII.rightNearFieldRightMulRepresentation (F := K)) := by
  letI : Fact (Nat.Prime (addOrderOf (1 : K))) :=
    ⟨PFAppendixII.rightNearField_addOrderOf_one_prime⟩
  letI : Module (ZMod (addOrderOf (1 : K))) K :=
    PFAppendixII.rightNearFieldZModModule K
  apply IsSimpleOrder.of_forall_eq_top
  intro S hS
  apply top_unique
  intro y _
  rcases eq_or_ne y 0 with rfl | hy
  · exact S.toSubmodule.zero_mem
  obtain ⟨x, hxS, hx0⟩ :=
    Submodule.exists_mem_ne_zero_of_ne_bot (p := S.toSubmodule) (by
      intro h
      apply hS
      apply Subrepresentation.toSubmodule_injective
      exact h)
  let xu : Kˣ := Units.mk0 x hx0
  let yu : Kˣ := Units.mk0 y hy
  have hact :=
    S.apply_mem_toSubmodule (MulOpposite.op (xu⁻¹ * yu)) hxS
  change x * (((xu⁻¹ * yu : Kˣ) : K)) ∈ S at hact
  have hxy : x * (x⁻¹ * y) = y := by
    rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
  simpa [xu, yu, hxy] using hact

set_option maxHeartbeats 800000 in
set_option synthInstance.maxHeartbeats 500000 in
set_option backward.isDefEq.respectTransparency false in
/-- XI.2.5(f): Clifford decomposition and fixed-point-free orbit counting
force a two-block decomposition with a constituent of size below twelve. -/
private theorem huppert_XI_2_5_clifford_small_constituent
    {K : Type u} [PFAppendixII.RightNearField K] [Finite K]
    {p f : ℕ} (hp : Nat.Prime p) (hp2 : p ≠ 2) (_hf : 0 < f)
    (hKcard : Nat.card K = p ^ f)
    (hNFchar : addOrderOf (1 : K) = p)
    (Z : Subgroup Kˣ) (hZchar : Z.Characteristic)
    (hZindex : Z.index = 12) (hZcyclic : IsCyclic Z)
    (hred :
      ¬ (letI : Fact (Nat.Prime p) := ⟨hp⟩
         letI : Module (ZMod p) K :=
           hNFchar ▸ PFAppendixII.rightNearFieldZModModule K
         letI : IsElementaryAbelian p (Multiplicative K) :=
           hNFchar ▸ PFAppendixII.rightNearFieldMultiplicativeIsElementaryAbelian
         letI : IsMulCommutative Z := hZcyclic.isMulCommutative
         letI : MulDistribMulAction Z (Multiplicative K) :=
           PFAppendixII.rightNearFieldUnitsMulDistribMulAction Z
         let T : Subgroup Z := ⊤
         Representation.IsIrreducible
           (PFAppendixI.AppendixIRepresentationOfT
             (p := p) (E := Multiplicative K) T))) :
    ∃ r : ℕ, 0 < r ∧ p ^ r < 12 ∧ f = 2 * r := by
  subst p
  letI : Fact (Nat.Prime (addOrderOf (1 : K))) := ⟨hp⟩
  letI moduleK : Module (ZMod (addOrderOf (1 : K))) K :=
    PFAppendixII.rightNearFieldZModModule K
  let invOp : Kˣ ≃* (Kˣ)ᵐᵒᵖ := MulEquiv.inv' Kˣ
  let H : Subgroup (Kˣ)ᵐᵒᵖ := Z.map invOp.toMonoidHom
  let rho : Representation (ZMod (addOrderOf (1 : K))) (Kˣ)ᵐᵒᵖ K :=
    PFAppendixII.rightNearFieldRightMulRepresentation
  let rhoH : Representation (ZMod (addOrderOf (1 : K))) H K :=
    PFAppendixII.rightNearFieldRightMulSubgroupRepresentation H
  letI subrepSetLike : SetLike (Subrepresentation rhoH) K :=
    @Subrepresentation.instSetLike (ZMod (addOrderOf (1 : K))) H K
      inferInstance inferInstance inferInstance moduleK rhoH
  letI : Membership K (Subrepresentation rhoH) :=
    @SetLike.instMembership (Subrepresentation rhoH) K subrepSetLike
  letI : CoeTC (Subrepresentation rhoH) (Set K) :=
    @SetLike.instCoeTCSet (Subrepresentation rhoH) K subrepSetLike
  letI : CoeSort (Subrepresentation rhoH) (Type u) :=
    @SetLike.instCoeSortType (Subrepresentation rhoH) K subrepSetLike
  letI subrepPartialOrder : PartialOrder (Subrepresentation rhoH) :=
    @Subrepresentation.instPartialOrder (ZMod (addOrderOf (1 : K))) H K
      inferInstance inferInstance inferInstance moduleK rhoH
  letI : LE (Subrepresentation rhoH) := subrepPartialOrder.toLE
  letI : Preorder (Subrepresentation rhoH) := subrepPartialOrder.toPreorder
  letI subrepBoundedOrder : BoundedOrder (Subrepresentation rhoH) :=
    @Subrepresentation.instBoundedOrder (ZMod (addOrderOf (1 : K))) H K
      inferInstance inferInstance inferInstance moduleK rhoH
  letI : OrderBot (Subrepresentation rhoH) := subrepBoundedOrder.toOrderBot
  letI : OrderTop (Subrepresentation rhoH) := subrepBoundedOrder.toOrderTop
  have hRhoIrr : Representation.IsIrreducible rho := by
    exact rightNearFieldRightMulRepresentation_irreducible (K := K)
  have hHnormal : H.Normal := by
    letI : Z.Characteristic := hZchar
    have hZnormal : Z.Normal := inferInstance
    exact hZnormal.map invOp.toMonoidHom invOp.surjective
  letI : H.Normal := hHnormal
  have hRhoHred : ¬ Representation.IsIrreducible rhoH := by
    intro hIrrH
    apply hred
    letI : IsElementaryAbelian (addOrderOf (1 : K)) (Multiplicative K) :=
      PFAppendixII.rightNearFieldMultiplicativeIsElementaryAbelian
    letI : IsMulCommutative Z := hZcyclic.isMulCommutative
    letI : MulDistribMulAction Z (Multiplicative K) :=
      PFAppendixII.rightNearFieldUnitsMulDistribMulAction Z
    let T : Subgroup Z := ⊤
    let rhoZ := PFAppendixI.AppendixIRepresentationOfT
      (p := addOrderOf (1 : K)) (E := Multiplicative K) T
    let eAdd : Additive (Multiplicative K) ≃+ K :=
      AddEquiv.additiveMultiplicative K
    let eLin : Additive (Multiplicative K) ≃ₗ[ZMod (addOrderOf (1 : K))] K :=
      LinearEquiv.ofBijective
        (eAdd.toAddMonoidHom.toZModLinearMap (addOrderOf (1 : K)))
        eAdd.bijective
    let eGhom : T →* H := {
      toFun := fun z => ⟨MulOpposite.op (((z : Z) : Kˣ)), by
        refine ⟨((z : Z) : Kˣ)⁻¹, Z.inv_mem z.1.property, ?_⟩
        simp [invOp]⟩
      map_one' := by ext; simp
      map_mul' := by
        intro x y
        apply Subtype.ext
        apply MulOpposite.unop_injective
        simp only [Subgroup.coe_mul, MulOpposite.unop_op,
          MulOpposite.unop_mul]
        exact congrArg Subtype.val
          (hZcyclic.isMulCommutative.is_comm.comm (x : Z) (y : Z)) }
    have heGbij : Function.Bijective eGhom := by
      constructor
      · intro x y hxy
        have hop : MulOpposite.op (((x : Z) : Kˣ)) =
            MulOpposite.op (((y : Z) : Kˣ)) := by
          simpa [eGhom] using congrArg Subtype.val hxy
        have hxy' : ((x : Z) : Kˣ) = ((y : Z) : Kˣ) :=
          MulOpposite.op_injective hop
        apply Subtype.ext
        apply Subtype.ext
        exact hxy'
      · intro h
        rcases h.property with ⟨z, hz, hzEq⟩
        let t : T := ⟨⟨z⁻¹, Z.inv_mem hz⟩, by simp [T]⟩
        refine ⟨t, ?_⟩
        apply Subtype.ext
        simpa [eGhom, t, invOp] using hzEq
    let eG : T ≃* H := MulEquiv.ofBijective eGhom heGbij
    have hintertwine (z : T) (x : Additive (Multiplicative K)) :
        eLin.toLinearMap.toFun (rhoZ z x) =
          (rhoH (eG z)).toFun (eLin.toLinearMap.toFun x) := by
      have hzact : rhoZ z x =
          Additive.ofMul ((z : T) • Additive.toMul x) := by
        exact Theory.Representation.ofElementaryAbelianAction_apply z x
      have hHact : (rhoH (eG z)).toFun (eLin.toLinearMap.toFun x) =
          eLin.toLinearMap.toFun x * (((z : Z) : Kˣ) : K) := by
        change eLin.toLinearMap.toFun x *
            (((((eG z : H) : (Kˣ)ᵐᵒᵖ).unop : Kˣ) : K)) = _
        congr 1
      rw [hzact, hHact]
      rfl
    apply IsSimpleOrder.of_forall_eq_top
    intro S hSne
    let SH : Subrepresentation rhoH := {
      toSubmodule := S.toSubmodule.map eLin.toLinearMap
      apply_mem_toSubmodule h y hy := by
        rcases hy with ⟨x, hx, rfl⟩
        obtain ⟨z, rfl⟩ := eG.surjective h
        change (rhoH (eG z)).toFun (eLin.toLinearMap.toFun x) ∈
          S.toSubmodule.map eLin.toLinearMap
        rw [← hintertwine]
        exact ⟨rhoZ z x, S.apply_mem_toSubmodule z hx, rfl⟩ }
    have hSHne : SH ≠ ⊥ := by
      intro hSH
      apply hSne
      apply Subrepresentation.toSubmodule_injective
      apply bot_unique
      intro x hx
      have hxmap : eLin.toLinearMap.toFun x ∈ SH := ⟨x, hx, rfl⟩
      rw [hSH] at hxmap
      change x = 0
      apply eLin.injective
      have h0 : eLin.toLinearMap.toFun x = 0 :=
        (Submodule.mem_bot (R := ZMod (addOrderOf (1 : K))) (M := K) (x := eLin.toLinearMap.toFun x)).mp hxmap
      apply eAdd.injective
      calc
        eAdd x = eLin.toLinearMap.toFun x := by
          simp [eLin]
        _ = 0 := h0
        _ = eAdd 0 := by simp
    have hSHtop := (hIrrH.eq_bot_or_eq_top SH).resolve_left hSHne
    apply Subrepresentation.toSubmodule_injective
    apply top_unique
    intro x _
    have hxmap : eLin.toLinearMap.toFun x ∈ SH := by
      rw [hSHtop]
      exact Submodule.mem_top
    rcases hxmap with ⟨y, hy, hyx⟩
    have : y = x := eLin.injective hyx
    simpa [this] using hy
  obtain ⟨U, hUbot, hUtop⟩ :
      ∃ U : Subrepresentation rhoH,
        (∃ x : K, x ∈ U ∧ x ≠ 0) ∧ ∃ y : K, y ∉ U := by
    have hnotSimple :
        ¬ ∀ S : Subrepresentation rhoH, S = ⊥ ∨ S = ⊤ := by
      intro h
      apply hRhoHred
      change IsSimpleOrder (Subrepresentation rhoH)
      rw [isSimpleOrder_iff]
      exact ⟨inferInstance, h⟩
    push Not at hnotSimple
    obtain ⟨U, hUneBot, hUneTop⟩ := hnotSimple
    have hUneBot' : U.toSubmodule ≠ ⊥ := by
      intro h
      apply hUneBot
      apply Subrepresentation.toSubmodule_injective
      exact h
    obtain ⟨x, hxU, hx0⟩ :=
      Submodule.exists_mem_ne_zero_of_ne_bot hUneBot'
    have hy : ∃ y : K, y ∉ U := by
      by_contra h
      push Not at h
      apply hUneTop
      apply Subrepresentation.toSubmodule_injective
      apply top_unique
      intro y _
      exact h y
    exact ⟨U, ⟨x, hxU, hx0⟩, hy⟩
  have hWexists :
      ∃ W : Subrepresentation rhoH,
        IsAtom W ∧
          ∀ x : K, x ∈ W → x ∈ U := by
    have hUneBot : U ≠ ⊥ := by
      intro h
      obtain ⟨x, hxU, hx0⟩ := hUbot
      rw [h] at hxU
      exact hx0 ((Submodule.mem_bot (R := ZMod (addOrderOf (1 : K))) (M := K) (x := x)).mp hxU)
    letI : Finite (Subrepresentation rhoH) :=
      Finite.of_injective
        (fun S : Subrepresentation rhoH => (S : Set K))
        (by
          intro A B hAB
          apply Subrepresentation.toSubmodule_injective
          ext x
          exact Set.ext_iff.mp hAB x)
    obtain ⟨W, hWleU, hWmin⟩ :=
      Finite.exists_le_minimal (p := fun S : Subrepresentation rhoH => S ≠ ⊥)
        hUneBot
    have hWatom : IsAtom W := by
      rw [isAtom_iff_le_of_ge]
      exact ⟨hWmin.1, fun V hV hVW => hWmin.2 hV hVW⟩
    exact ⟨W, hWatom, fun x hx => hWleU hx⟩
  rcases hWexists with ⟨W, hWatom, hWleU⟩
  have hwExists : ∃ w : K, w ∈ W ∧ w ≠ 0 := by
    by_contra h
    push Not at h
    apply hWatom.ne_bot
    apply Subrepresentation.toSubmodule_injective
    ext x
    constructor
    · intro hx
      have hx0 := h x hx
      subst x
      exact Submodule.zero_mem _
    · intro hx
      have hx0 : x = 0 := (Submodule.mem_bot (R := ZMod (addOrderOf (1 : K))) (M := K) (x := x)).mp hx
      subst x
      exact W.toSubmodule.zero_mem
  obtain ⟨w, hwW, hw0⟩ := hwExists
  have hWirr := (Subrepresentation.irreducible_iff_isAtom W).mpr hWatom
  letI : Finite (Kˣ)ᵐᵒᵖ := Finite.of_equiv Kˣ MulOpposite.opEquiv
  obtain ⟨n, g, hInternal, hConjIrr, hConjEquiv, _hMultiplicity⟩ :=
    Theory.Representation.isaacs_theorem_6_5.{0, u, u, u} rho H hRhoIrr W hWirr
  let VW : Type u := {x : K // W.toSubmodule.carrier x}
  letI : AddCommGroup VW := W.toSubmodule.addCommGroup
  letI : Module (ZMod (addOrderOf (1 : K))) VW := W.toSubmodule.module
  let r := Module.finrank (ZMod (addOrderOf (1 : K))) VW
  have hrpos : 0 < r := by
    apply Module.finrank_pos_iff_exists_ne_zero.mpr
    exact ⟨⟨w, hwW⟩, fun h => hw0 (congrArg Subtype.val h)⟩
  have hfinrankK :
      Module.finrank (ZMod (addOrderOf (1 : K))) K = f := by
    letI : Fintype K := Fintype.ofFinite K
    have hcard := Module.card_eq_pow_finrank
      (K := ZMod (addOrderOf (1 : K))) (V := K)
    have hpows : addOrderOf (1 : K) ^
          Module.finrank (ZMod (addOrderOf (1 : K))) K =
        addOrderOf (1 : K) ^ f := by
      rw [← hKcard]
      simpa [Nat.card_eq_fintype_card] using hcard.symm
    exact (Nat.pow_right_injective hp.two_le) hpows
  have hfinrankEq : f = n * r := by
    let Ui (i : Fin n) : Type u :=
      {x : K //
        (Theory.Representation.conjugateSubrepresentation rho H W (g i)).toSubmodule.carrier x}
    let eInternal := Equiv.ofBijective _ hInternal
    let eTotal := (DFinsupp.equivFunOnFintype).symm.trans eInternal
    have hcardVW : Nat.card VW = addOrderOf (1 : K) ^ r := by
      letI : Fintype VW := Fintype.ofFinite VW
      have hcard := Module.card_eq_pow_finrank
        (K := ZMod (addOrderOf (1 : K))) (V := VW)
      simpa [r, Nat.card_eq_fintype_card] using hcard
    have hcardUi (i : Fin n) : Nat.card (Ui i) = Nat.card VW := by
      let eUi : VW ≃ Ui i := {
        toFun := fun x => ⟨(rho (g i)⁻¹).toFun x.1, by
          change (rho (g i)⁻¹).toFun x.1 ∈
            Submodule.map (rho (g i)⁻¹) W.toSubmodule
          exact ⟨x.1, x.2, rfl⟩⟩
        invFun := fun y => ⟨(rho (g i)).toFun y.1, by
          have hy := y.2
          change y.1 ∈ Submodule.map (rho (g i)⁻¹) W.toSubmodule at hy
          rcases hy with ⟨x, hxW, hxy⟩
          have hback : (rho (g i)).toFun y.1 = x := by
            rw [← hxy]
            simp
          have hgoal : (rho (g i)).toFun y.1 ∈ W.toSubmodule := by
            rw [hback]
            exact hxW
          exact hgoal⟩
        left_inv := by
          intro x
          apply Subtype.ext
          simp
        right_inv := by
          intro y
          apply Subtype.ext
          simp }
      exact Nat.card_congr eUi.symm
    have hcardKprod : Nat.card K = ∏ i : Fin n, Nat.card (Ui i) := by
      calc
        Nat.card K = Nat.card ((i : Fin n) → Ui i) :=
          Nat.card_congr eTotal.symm
        _ = ∏ i : Fin n, Nat.card (Ui i) := Nat.card_pi
    have hpows : addOrderOf (1 : K) ^ f =
        addOrderOf (1 : K) ^ (n * r) := by
      calc
        addOrderOf (1 : K) ^ f = Nat.card K := hKcard.symm
        _ = ∏ i : Fin n, Nat.card (Ui i) := hcardKprod
        _ = ∏ _i : Fin n, addOrderOf (1 : K) ^ r := by
          apply Finset.prod_congr rfl
          intro i _
          rw [hcardUi i, hcardVW]
        _ = (addOrderOf (1 : K) ^ r) ^ n := by simp
        _ = addOrderOf (1 : K) ^ (r * n) := by rw [pow_mul]
        _ = addOrderOf (1 : K) ^ (n * r) := by rw [Nat.mul_comm]
    exact (Nat.pow_right_injective hp.two_le) hpows
  have hrlt : r < f := by
    obtain ⟨y, hyU⟩ := hUtop
    have hyW : ¬ W.toSubmodule.carrier y := fun hy => hyU (hWleU y hy)
    have hcardlt : Nat.card VW < Nat.card K := by
      simpa [VW] using (Finite.card_subtype_lt hyW)
    have hcardVW : Nat.card VW = addOrderOf (1 : K) ^ r := by
      letI : Fintype VW := Fintype.ofFinite VW
      have hcard := Module.card_eq_pow_finrank
        (K := ZMod (addOrderOf (1 : K))) (V := VW)
      simpa [r, Nat.card_eq_fintype_card] using hcard
    apply (Nat.pow_lt_pow_iff_right hp.one_lt).mp
    simpa [hcardVW, hKcard] using hcardlt
  have hZle : Nat.card Z ≤ addOrderOf (1 : K) ^ r - 1 := by
    let VW0 : Type u := {x : VW // x ≠ 0}
    let emb : Z → VW0 := fun z =>
      ⟨⟨w * (((z : Z) : Kˣ) : K), by
        have hzH : MulOpposite.op (((z : Z) : Kˣ)) ∈ H := by
          refine ⟨((z : Z) : Kˣ)⁻¹, Z.inv_mem z.property, ?_⟩
          simp [invOp]
        have hact := W.apply_mem_toSubmodule
          (⟨MulOpposite.op (((z : Z) : Kˣ)), hzH⟩ : H) hwW
        change w * (((z : Z) : Kˣ) : K) ∈ W at hact
        exact hact⟩, by
        intro hzero
        exact (mul_ne_zero hw0 (Units.ne_zero ((z : Z) : Kˣ)))
          (congrArg Subtype.val hzero)⟩
    have hemb : Function.Injective emb := by
      intro a b hab
      have hval :
          w * (((a : Z) : Kˣ) : K) =
            w * (((b : Z) : Kˣ) : K) :=
        congrArg (fun x : VW0 => ((x.1 : VW) : K)) hab
      have habK : (((a : Z) : Kˣ) : K) = (((b : Z) : Kˣ) : K) :=
        mul_left_cancel₀ hw0 hval
      apply Subtype.ext
      apply Units.ext
      exact habK
    have hle : Nat.card Z ≤ Nat.card VW0 :=
      Nat.card_le_card_of_injective emb hemb
    have hcardVW0 : Nat.card VW0 = Nat.card VW - 1 := by
      classical
      letI : Fintype VW := Fintype.ofFinite VW
      letI : Fintype VW0 := Fintype.ofFinite VW0
      simp [VW0, Nat.card_eq_fintype_card]
    have hcardVW : Nat.card VW = addOrderOf (1 : K) ^ r := by
      letI : Fintype VW := Fintype.ofFinite VW
      have hcard := Module.card_eq_pow_finrank
        (K := ZMod (addOrderOf (1 : K))) (V := VW)
      simpa [r, Nat.card_eq_fintype_card] using hcard
    rw [hcardVW0, hcardVW] at hle
    exact hle
  have hcardEq :
      addOrderOf (1 : K) ^ f - 1 = 12 * Nat.card Z := by
    have hmul := Z.card_mul_index
    rw [hZindex, Nat.card_units, hKcard] at hmul
    simpa [Nat.mul_comm] using hmul.symm
  have hineq :
      addOrderOf (1 : K) ^ f - 1 ≤
        12 * (addOrderOf (1 : K) ^ r - 1) := by
    nlinarith
  have hn2 : n = 2 := by
    have hn_gt_one : 1 < n := by
      nlinarith [hfinrankEq, hrlt, hrpos]
    by_contra hn_ne
    have hn3 : 3 ≤ n := by omega
    let x := addOrderOf (1 : K) ^ r
    have hq3 : 3 ≤ addOrderOf (1 : K) := by
      have hq2 := hp.two_le
      omega
    have hx3 : 3 ≤ x := hq3.trans (Nat.le_pow hrpos)
    have hpow3le : x ^ 3 ≤ addOrderOf (1 : K) ^ f := by
      have hpowle : x ^ 3 ≤ x ^ n :=
        Nat.pow_le_pow_right (by omega : 0 < x) hn3
      calc
        x ^ 3 ≤ x ^ n := hpowle
        _ = addOrderOf (1 : K) ^ f := by
          simp [x, ← pow_mul, Nat.mul_comm, hfinrankEq]
