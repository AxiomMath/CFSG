      simpa [x] using hineq
    have hsubLe : x ^ 3 - 1 ≤ 12 * (x - 1) :=
      (Nat.sub_le_sub_right hpow3le 1).trans hineqX
    have hfac : (1 + x + x ^ 2) * (x - 1) = x ^ 3 - 1 := by
      simpa [Finset.sum_range_succ, add_assoc] using
        (geom_sum_mul_of_one_le (by omega : 1 ≤ x) 3)
    have hx2 : 9 ≤ x ^ 2 := Nat.pow_le_pow_left hx3 2
    have hsum13 : 13 ≤ 1 + x + x ^ 2 := by omega
    have hlower : 13 * (x - 1) ≤ (1 + x + x ^ 2) * (x - 1) :=
      Nat.mul_le_mul_right (x - 1) hsum13
    have hstrict : 12 * (x - 1) < 13 * (x - 1) :=
      Nat.mul_lt_mul_of_pos_right (by omega) (by omega)
    rw [hfac] at hlower
    omega
  have hsmall : addOrderOf (1 : K) ^ r < 12 := by
    let x := addOrderOf (1 : K) ^ r
    have hxpos : 1 ≤ x :=
      Nat.one_le_pow r (addOrderOf (1 : K)) hp.pos
    have hpowEq : addOrderOf (1 : K) ^ f = x ^ 2 := by
      calc
        addOrderOf (1 : K) ^ f =
            addOrderOf (1 : K) ^ (r * 2) := by
              rw [hfinrankEq, hn2, Nat.mul_comm]
        _ = (addOrderOf (1 : K) ^ r) ^ 2 := by rw [pow_mul]
        _ = x ^ 2 := rfl
    rw [hpowEq] at hineq
    by_contra hnot
    have hx12 : 12 ≤ x := by omega
    have hfac : (1 + x) * (x - 1) = x ^ 2 - 1 := by
      simpa [Finset.sum_range_succ] using
        (geom_sum_mul_of_one_le hxpos 2)
    have hsum13 : 13 ≤ 1 + x := by omega
    have hlower : 13 * (x - 1) ≤ (1 + x) * (x - 1) :=
      Nat.mul_le_mul_right (x - 1) hsum13
    have hstrict : 12 * (x - 1) < 13 * (x - 1) :=
      Nat.mul_lt_mul_of_pos_right (by omega) (by omega)
    rw [hfac] at hlower
    omega
  exact ⟨r, hrpos, hsmall, by simpa [hn2] using hfinrankEq⟩

/-- Huppert--Blackburn XI.2.5(c)--(f), with the omitted near-field module
restored.  In the top-residual branch the source hypotheses are contradictory. -/
public theorem huppert_XI_2_5_topResidual_false
    {K : Type u} [PFAppendixII.RightNearField K] [Finite K]
    {p f : ℕ} (hp : Nat.Prime p) (hp2 : p ≠ 2)
    (hf : 0 < f)
    (hKcard : Nat.card K = p ^ f)
    (hNFchar : addOrderOf (1 : K) = p)
    (hres : hktPResidual 2 Kˣ = (⊤ : Subgroup Kˣ))
    (_hsylowOdd :
      ∀ (q : ℕ) [Fact (Nat.Prime q)], q ≠ 2 →
        ∀ Q : Sylow q Kˣ, IsCyclic Q)
    (hsylowTwo :
      ∀ P : Sylow 2 Kˣ, IsCyclic P ∨
        ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
          Nonempty (P ≃* QuaternionGroup k))
    (huniqueThree :
      ∀ U V : Subgroup Kˣ, Nat.card U = 3 → Nat.card V = 3 → U = V)
    (Z : Subgroup Kˣ) (hZchar : Z.Characteristic)
    (hZindex : Z.index = 12) (hZcyclic : IsCyclic Z) : False := by
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  letI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hKodd : Odd (Nat.card K) := by
    rw [hKcard]
    exact (hp.odd_of_ne_two hp2).pow
  have hEven : 2 ∣ Nat.card Kˣ := by
    apply even_iff_two_dvd.mp
    rw [Nat.card_units]
    exact Nat.Odd.sub_odd hKodd odd_one
  let P : Sylow 2 Kˣ := default
  rcases hsylowTwo P with hPcyclic | hPquaternion
  · exact (huppert_XI_2_5_pResidual_ne_top_of_cyclic_sylow_two
      hEven P hPcyclic) hres
  · have hthree : 3 ∣ Nat.card Kˣ :=
      huppert_XI_2_5_three_dvd_card_of_quaternion_sylow
        hEven hres P hPquaternion
    have hred := huppert_XI_2_5_restriction_reducible
      hp hp2 hKcard hNFchar hres hsylowTwo Z hZchar hZcyclic
    obtain ⟨r, hrpos, hsmall, hfTwo⟩ :=
      huppert_XI_2_5_clifford_small_constituent
        hp hp2 hf hKcard hNFchar Z hZchar hZindex hZcyclic hred
    have hthreePow : 3 ∣ p ^ f - 1 := by
      simpa [Nat.card_units, hKcard] using hthree
    have hp3 : p ≠ 3 := by
      intro hpEq
      rw [hpEq] at hthreePow
      have hthreeBase : 3 ∣ 3 ^ f := dvd_pow_self 3 hf.ne'
      have hbad := Nat.dvd_sub hthreeBase hthreePow
      have hone : 3 ^ f - (3 ^ f - 1) = 1 := by
        have := Nat.one_le_pow f 3 (by norm_num)
        omega
      rw [hone] at hbad
      norm_num at hbad
    have hpodd : Odd p := hp.odd_of_ne_two hp2
    have hp5 : 5 ≤ p := by
      rcases hpodd with ⟨k, hk⟩
      have hpgt := hp.one_lt
      omega
    have hpLePow : p ≤ p ^ r := Nat.le_pow hrpos
    have hpLt12 : p < 12 := hpLePow.trans_lt hsmall
    have hrOne : r = 1 := by
      by_contra hrne
      have hrTwo : 2 ≤ r := by omega
      have hpSqLe : p ^ 2 ≤ p ^ r :=
        Nat.pow_le_pow_right hp.pos hrTwo
      have h25 : 25 ≤ p ^ 2 := Nat.pow_le_pow_left hp5 2
      omega
    have hfEq : f = 2 := by omega
    have hnotNine : ¬ 9 ∣ Nat.card Kˣ := by
      intro hnine
      rw [Nat.card_units, hKcard, hfEq] at hnine
      rw [hfEq] at hthreePow
      have hpCases : p = 5 ∨ p = 7 ∨ p = 9 ∨ p = 11 := by
        rcases hpodd with ⟨k, hk⟩
        omega
      rcases hpCases with hpEq | hpEq | hpEq | hpEq
      · rw [hpEq] at hnine
        norm_num at hnine
      · rw [hpEq] at hnine
        norm_num at hnine
      · rw [hpEq] at hthreePow
        norm_num at hthreePow
      · rw [hpEq] at hnine
        norm_num at hnine
    let Q : Sylow 3 Kˣ := default
    have hQcard : Nat.card Q = 3 := by
      obtain ⟨a, ha⟩ := Q.isPGroup'.exists_card_eq
      have hthreeQ : 3 ∣ Nat.card Q := by
        have hmul : Nat.card Q * (Q : Subgroup Kˣ).index = Nat.card Kˣ :=
          Q.card_mul_index
        have hthreeMul : 3 ∣ Nat.card Q * (Q : Subgroup Kˣ).index := by
          rw [hmul]
          exact hthree
        exact (Nat.prime_three.dvd_mul.mp hthreeMul).resolve_right Q.not_dvd_index
      have haPos : 0 < a := by
        by_contra ha0
        have : a = 0 := by omega
        subst a
        simp [ha] at hthreeQ
      have haLe : a ≤ 1 := by
        by_contra haNot
        have haTwo : 2 ≤ a := by omega
        have hnineQ : 9 ∣ Nat.card Q := by
          rw [ha]
          exact Nat.pow_dvd_pow 3 haTwo
        exact hnotNine (hnineQ.trans (Subgroup.card_subgroup_dvd_card (Q : Subgroup Kˣ)))
      have : a = 1 := by omega
      simp [ha, this]
    have hQnormal : (Q : Subgroup Kˣ).Normal := by
      refine ⟨fun x hx g => ?_⟩
      let Qg : Subgroup Kˣ := (Q : Subgroup Kˣ).map (MulAut.conj g).toMonoidHom
      have hQgcard : Nat.card Qg = 3 := by
        calc
          Nat.card Qg = Nat.card Q := by
            exact Subgroup.card_map_of_injective
              (K := (Q : Subgroup Kˣ))
              (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective
          _ = 3 := hQcard
      have hQgEq : Qg = (Q : Subgroup Kˣ) :=
        huniqueThree Qg (Q : Subgroup Kˣ) hQgcard hQcard
      have hmem : g * x * g⁻¹ ∈ Qg := by
        refine ⟨x, hx, ?_⟩
        simp [MulAut.conj_apply]
      simpa [hQgEq] using hmem
    letI : (Q : Subgroup Kˣ).Normal := hQnormal
    let q : Kˣ →* Kˣ ⧸ (Q : Subgroup Kˣ) :=
      QuotientGroup.mk' (Q : Subgroup Kˣ)
    let Pbar : Sylow 2 (Kˣ ⧸ (Q : Subgroup Kˣ)) :=
      P.mapSurjective (f := q)
        (QuotientGroup.mk'_surjective (Q : Subgroup Kˣ))
    have hPQcop : Nat.Coprime (Nat.card P) (Nat.card Q) := by
      obtain ⟨a, ha⟩ := P.isPGroup'.exists_card_eq
      rw [ha, hQcard]
      exact Nat.Coprime.pow_left a (by norm_num)
    have hPQbot : (P : Subgroup Kˣ) ⊓ (Q : Subgroup Kˣ) = ⊥ :=
      (Subgroup.disjoint_of_coprime_natCard hPQcop).eq_bot
    have hqPInjective : Function.Injective (fun x : P => q (x : Kˣ)) := by
      intro x y hxy
      apply Subtype.ext
      change q (x : Kˣ) = q (y : Kˣ) at hxy
      have hqone : q ((x : Kˣ) * (y : Kˣ)⁻¹) = 1 := by
        calc
          q ((x : Kˣ) * (y : Kˣ)⁻¹) =
              q (x : Kˣ) * (q (y : Kˣ))⁻¹ := by simp
          _ = q (y : Kˣ) * (q (y : Kˣ))⁻¹ := by rw [hxy]
          _ = 1 := mul_inv_cancel _
      have hQmem : (x : Kˣ) * (y : Kˣ)⁻¹ ∈ (Q : Subgroup Kˣ) :=
        (QuotientGroup.eq_one_iff
          (N := (Q : Subgroup Kˣ))
          (x := (x : Kˣ) * (y : Kˣ)⁻¹)).mp hqone
      have hPQmem : (x : Kˣ) * (y : Kˣ)⁻¹ ∈
          (P : Subgroup Kˣ) ⊓ (Q : Subgroup Kˣ) :=
        ⟨(P : Subgroup Kˣ).mul_mem x.property
          ((P : Subgroup Kˣ).inv_mem y.property), hQmem⟩
      rw [hPQbot] at hPQmem
      exact mul_inv_eq_one.mp (Subgroup.mem_bot.mp hPQmem)
    let qP : P →* (P : Subgroup Kˣ).map q :=
      q.subgroupMap (P : Subgroup Kˣ)
    have hqPInjective' : Function.Injective qP := by
      intro x y hxy
      apply hqPInjective
      exact congrArg Subtype.val hxy
    let ePmap : P ≃* (P : Subgroup Kˣ).map q :=
      MulEquiv.ofBijective qP
        ⟨hqPInjective', MonoidHom.subgroupMap_surjective q (P : Subgroup Kˣ)⟩
    have hPbarSubgroup : (Pbar : Subgroup (Kˣ ⧸ (Q : Subgroup Kˣ))) = Subgroup.map q (P : Subgroup Kˣ) := rfl
    let ePbar : Pbar ≃* P :=
      (MulEquiv.subgroupCongr hPbarSubgroup).trans ePmap.symm
    have hPbarQuaternion :
        ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
          Nonempty (Pbar ≃* QuaternionGroup k) := by
      rcases hPquaternion with ⟨k, hk, hkP, ⟨eP⟩⟩
      exact ⟨k, hk, hkP, ⟨ePbar.trans eP⟩⟩
    have hthreeNotQuot : ¬ 3 ∣ Nat.card (Kˣ ⧸ (Q : Subgroup Kˣ)) := by
      rw [← (Q : Subgroup Kˣ).index_eq_card]
      exact Q.not_dvd_index
    have hcompQuot : HasNormalPComplement 2 (Kˣ ⧸ (Q : Subgroup Kˣ)) :=
      huppert_IV_5_11_hasNormalPComplement_of_quaternion_sylow_two
        Pbar hPbarQuaternion hthreeNotQuot
    rcases hcompQuot with ⟨Nbar, hNbarNormal, hNbarCop, hquotTwo⟩
    let N : Subgroup Kˣ := Nbar.comap q
    have hNnormal : N.Normal := Subgroup.Normal.comap hNbarNormal q
    letI : N.Normal := hNnormal
    have hQleN : (Q : Subgroup Kˣ) ≤ N := by
      intro x hx
      change q x ∈ Nbar
      have hxq : q x = 1 :=
        (QuotientGroup.eq_one_iff (N := (Q : Subgroup Kˣ)) (x := x)).2 hx
      simp [hxq]
    have hNmap : N.map q = Nbar := by
      simpa [N] using
        (Subgroup.map_comap_eq_self_of_surjective
          (f := q) (QuotientGroup.mk'_surjective (Q : Subgroup Kˣ)) Nbar)
    have hQsubNormal : ((Q : Subgroup Kˣ).subgroupOf N).Normal :=
      Subgroup.Normal.subgroupOf hQnormal N
    letI : ((Q : Subgroup Kˣ).subgroupOf N).Normal := hQsubNormal
    let eNbar : N ⧸ (Q : Subgroup Kˣ).subgroupOf N ≃* Nbar :=
      (quotientSubgroupRangeEquiv N (Q : Subgroup Kˣ)).trans
        (MulEquiv.subgroupCongr hNmap)
    have hQsubCard : Nat.card ((Q : Subgroup Kˣ).subgroupOf N) = 3 := by
      let eQ : (Q : Subgroup Kˣ).subgroupOf N ≃* Q :=
        Subgroup.subgroupOfEquivOfLe hQleN
      calc
        Nat.card ((Q : Subgroup Kˣ).subgroupOf N) = Nat.card Q :=
          Nat.card_congr eQ.toEquiv
        _ = 3 := hQcard
    have hNcard : Nat.card N = Nat.card Nbar * 3 := by
      calc
        Nat.card N =
            Nat.card (N ⧸ (Q : Subgroup Kˣ).subgroupOf N) *
              Nat.card ((Q : Subgroup Kˣ).subgroupOf N) :=
          Subgroup.card_eq_card_quotient_mul_card_subgroup
            (α := N) (s := (Q : Subgroup Kˣ).subgroupOf N)
        _ = Nat.card Nbar * 3 := by
          rw [Nat.card_congr eNbar.toEquiv, hQsubCard]
    have hNcop : Nat.Coprime 2 (Nat.card N) := by
      rw [hNcard]
      exact Nat.Coprime.mul_right hNbarCop (by norm_num)
    let eQuot0 :
        (Kˣ ⧸ (Q : Subgroup Kˣ)) ⧸ N.map q ≃* Kˣ ⧸ N := by
      simpa [q] using
        (QuotientGroup.quotientQuotientEquivQuotient
          (N := (Q : Subgroup Kˣ)) (M := N) hQleN)
    let eQuot :
        (Kˣ ⧸ (Q : Subgroup Kˣ)) ⧸ Nbar ≃* Kˣ ⧸ N :=
      (QuotientGroup.quotientMulEquivOfEq hNmap.symm).trans eQuot0
    have hGNtwo : IsPGroup 2 (Kˣ ⧸ N) := hquotTwo.of_equiv eQuot
    have hcompTwo : HasNormalPComplement 2 Kˣ :=
      ⟨N, hNnormal, hNcop, hGNtwo⟩
    exact (hktPResidual_ne_top_of_hasNormalPComplement_of_dvd_card
      hcompTwo hEven) hres

