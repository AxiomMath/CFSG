/-- Huppert IV.5.10, the elementary generator bound used for a cyclic normal
subgroup of index two. -/
public theorem huppert_IV_5_10_generatorRank_le_two_of_cyclic_index_two
    {G : Type u} [Group G] [Finite G]
    (A : Subgroup G) [A.Normal] (a b : G)
    (hA : Subgroup.zpowers a = A) (hindex : A.index = 2)
    (hb : b ∉ A) :
    generatorRank G ≤ 2 := by
  classical
  unfold generatorRank
  apply Nat.sInf_le
  let s : Fin 2 → G := fun i => if i = 0 then a else b
  refine ⟨s, ?_⟩
  apply top_unique
  intro g _
  have ha : a ∈ Subgroup.closure (Set.range s) := by
    apply Subgroup.subset_closure
    exact ⟨0, by simp [s]⟩
  have hb' : b ∈ Subgroup.closure (Set.range s) := by
    apply Subgroup.subset_closure
    exact ⟨1, by simp [s]⟩
  have hcover : g ∈ A ∨ b⁻¹ * g ∈ A := by
    by_cases hg : g ∈ A
    · exact Or.inl hg
    · right
      have hiff := A.mul_mem_iff_of_index_two (by simpa using hindex)
        (a := b⁻¹) (b := g)
      have hbinv : b⁻¹ ∉ A := by
        intro h
        exact hb (by simpa using A.inv_mem h)
      exact hiff.mpr ⟨fun h => False.elim (hbinv h), fun h => False.elim (hg h)⟩
  rcases hcover with hgA | hbgA
  · rw [← hA] at hgA
    rcases Subgroup.mem_zpowers_iff.mp hgA with ⟨z, rfl⟩
    exact (Subgroup.closure (Set.range s)).zpow_mem ha z
  · rw [← hA] at hbgA
    rcases Subgroup.mem_zpowers_iff.mp hbgA with ⟨z, hz⟩
    have hzmem : a ^ z ∈ Subgroup.closure (Set.range s) :=
      (Subgroup.closure (Set.range s)).zpow_mem ha z
    have heq : g = b * a ^ z := by
      calc
        g = b * (b⁻¹ * g) := by group
        _ = b * a ^ z := by rw [hz]
    rw [heq]
    exact (Subgroup.closure (Set.range s)).mul_mem hb' hzmem

/-- Huppert IV.5.10, specialized to the two-generator conclusion for a finite
2-group with a unique involution. -/
public theorem huppert_IV_5_10_generatorRank_le_two_of_unique_order_two
    {G : Type u} [Group G] [Finite G]
    (hGp : IsPGroup 2 G)
    (hunique : ∀ x y : G, orderOf x = 2 → orderOf y = 2 → x = y) :
    generatorRank G ≤ 2 := by
  by_cases hcyc : IsCyclic G
  · exact (generatorRank_le_one_of_isCyclic hcyc).trans (by omega)
  · obtain ⟨A, a, hAnormal, haA, hAindex⟩ :=
      huppert_III_7_6b_cyclic_normal_index_two_of_unique_order_two
        hGp hcyc hunique
    let : A.Normal := hAnormal
    have hAne : A ≠ ⊤ := by
      intro htop
      have : A.index = 1 := by simp [htop]
      omega
    obtain ⟨b, _, hb⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hAne)
    exact huppert_IV_5_10_generatorRank_le_two_of_cyclic_index_two
      A a b haA hAindex hb

/-- A metacyclic finite group is generated by at most two elements. -/
public theorem huppert_IV_5_10_generatorRank_le_two_of_isMetacyclic
    {G : Type u} [Group G] [Finite G] (hmeta : IsMetacyclic G) :
    generatorRank G ≤ 2 := by
  classical
  obtain ⟨N, hNnormal, hNcyclic, hquotcyclic⟩ := hmeta
  let : N.Normal := hNnormal
  obtain ⟨a, ha⟩ := (N.isCyclic_iff_exists_zpowers_eq_top).1 hNcyclic
  obtain ⟨b, hb⟩ :=
    hkt_exists_zpowers_sup_top_of_cyclic_quotient N hquotcyclic
  let s : Fin 2 → G := fun i => if i = 0 then a else b
  unfold generatorRank
  apply Nat.sInf_le
  refine ⟨s, ?_⟩
  apply top_unique
  rw [← hb, ← ha]
  apply sup_le
  · apply Subgroup.zpowers_le.2
    apply Subgroup.subset_closure
    exact ⟨0, by simp [s]⟩
  · apply Subgroup.zpowers_le.2
    apply Subgroup.subset_closure
    exact ⟨1, by simp [s]⟩

/-- Every subgroup of a metacyclic finite group is metacyclic. -/
public theorem huppert_IV_5_10_isMetacyclic_subgroup
    {G : Type u} [Group G] [Finite G]
    (H : Subgroup G) (hmeta : IsMetacyclic G) :
    IsMetacyclic H := by
  classical
  obtain ⟨N, hNnormal, hNcyclic, hquotcyclic⟩ := hmeta
  let : N.Normal := hNnormal
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  let f : H →* G ⧸ N := q.comp H.subtype
  let A : Subgroup H := f.ker
  have hAnormal : A.Normal := by
    dsimp [A]
    infer_instance
  have hmap_le : A.map H.subtype ≤ N := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨a, ha, rfl⟩
    have hfa : f a = 1 := by
      apply MonoidHom.mem_ker.mp
      simpa [A] using ha
    exact (QuotientGroup.eq_one_iff (N := N) (x := ((a : H) : G))).1
      (by simpa [f, q] using hfa)
  have hAcyclic : IsCyclic A := by
    let : IsCyclic N := hNcyclic
    have hmapcyclic : IsCyclic (A.map H.subtype) :=
      Subgroup.isCyclic_of_le hmap_le
    exact (Subgroup.equivMapOfInjective
      (f := H.subtype) A H.subtype_injective).isCyclic.mpr hmapcyclic
  let : A.Normal := hAnormal
  have hrangeCyclic : IsCyclic f.range := by
    let : IsCyclic (G ⧸ N) := hquotcyclic
    exact Subgroup.isCyclic_of_le le_top
  have hquotCyclic : IsCyclic (H ⧸ A) := by
    exact (QuotientGroup.quotientKerEquivRange f).isCyclic.mpr hrangeCyclic
  exact ⟨A, hAnormal, hAcyclic, hquotCyclic⟩
/-- The standard generalized quaternion group is metacyclic. -/
public theorem huppert_IV_5_10_quaternionGroup_isMetacyclic
    (m : ℕ) [NeZero m] : IsMetacyclic (QuaternionGroup m) := by
  let X : Subgroup (QuaternionGroup m) :=
    Subgroup.zpowers (QuaternionGroup.a 1)
  have hXcyclic : IsCyclic X := Subgroup.isCyclic_zpowers _
  have hXcard : Nat.card X = 2 * m := by
    change Nat.card
      (Subgroup.zpowers (QuaternionGroup.a 1 : QuaternionGroup m)) = 2 * m
    rw [Nat.card_zpowers, QuaternionGroup.orderOf_a_one]
  have hGcard : Nat.card (QuaternionGroup m) = 4 * m := by
    rw [Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hXindex : X.index = 2 := by
    apply Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := X))
    rw [X.card_mul_index, hGcard, hXcard]
    omega
  have hXnormal : X.Normal := Subgroup.normal_of_index_eq_two hXindex
  let : X.Normal := hXnormal
  have hquotcard : Nat.card (QuaternionGroup m ⧸ X) = 2 := by
    rw [← X.index_eq_card]
    exact hXindex
  have hquotcyclic : IsCyclic (QuaternionGroup m ⧸ X) := by
    let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact isCyclic_of_prime_card hquotcard
  exact ⟨X, hXnormal, hXcyclic, hquotcyclic⟩

private theorem hkt_generatorRank_le_of_surjective_local
    {G : Type u} {H : Type v} [Group G] [Finite G] [Group H] [Finite H]
    (f : G →* H) (hf : Function.Surjective f) :
    generatorRank H ≤ generatorRank G := by
  rw [generatorRank_eq_group_rank, generatorRank_eq_group_rank]
  exact Group.rank_le_of_surjective f hf

private theorem hkt_generatorRank_eq_of_mulEquiv
    {G : Type u} {H : Type v} [Group G] [Finite G] [Group H] [Finite H]
    (e : G ≃* H) :
    generatorRank G = generatorRank H := by
  exact le_antisymm
    (hkt_generatorRank_le_of_surjective_local
      e.symm.toMonoidHom e.symm.surjective)
    (hkt_generatorRank_le_of_surjective_local
      e.toMonoidHom e.surjective)

/-- A generalized quaternion group with parameter at least two is noncommutative. -/
public theorem quaternionGroup_not_commutative_of_two_le
    (k : ℕ) (hk : 2 ≤ k) :
    ¬ IsMulCommutative (QuaternionGroup k) := by
  intro h
  let : IsMulCommutative (QuaternionGroup k) := h
  have hcomm := (IsMulCommutative.is_comm (M := QuaternionGroup k)).comm
      (QuaternionGroup.a 1 : QuaternionGroup k)
      (QuaternionGroup.xa 0 : QuaternionGroup k)
  simp only [QuaternionGroup.a_mul_xa, QuaternionGroup.xa_mul_a] at hcomm
  have hbad : (-(1 : ZMod (2 * k))) = 1 := by
    simpa using QuaternionGroup.xa.inj hcomm
  have hzeroTwo : (2 : ZMod (2 * k)) = 0 := by
    calc
      (2 : ZMod (2 * k)) = 1 + 1 := by norm_num
      _ = -1 + 1 := congrArg (fun z : ZMod (2 * k) => z + 1) hbad.symm
      _ = 0 := neg_add_cancel 1
  have hdvd : 2 * k ∣ 2 :=
    (ZMod.natCast_eq_zero_iff 2 (2 * k)).mp hzeroTwo
  have hle : 2 * k ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
  omega

/-- The Frattini quotient of a finite generalized quaternion `2`-group has
order four. -/
public theorem quaternionGroup_frattiniQuotient_card_eq_four
    {Q : Type u} [Group Q] [Finite Q]
    (hQquaternion :
      ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
        Nonempty (Q ≃* QuaternionGroup k)) :
    Nat.card (Q ⧸ frattini Q) = 4 := by
  rcases hQquaternion with ⟨k, hk, hkP, ⟨e⟩⟩
  let : NeZero k := ⟨by omega⟩
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hQp : IsPGroup 2 Q := hkP.of_equiv e.symm
  let : Fact (IsPGroup 2 Q) := ⟨hQp⟩
  have hQnoncyclic : ¬ IsCyclic Q := by
    intro hQcyclic
    apply quaternionGroup_not_commutative_of_two_le k hk
    let : IsCyclic Q := hQcyclic
    refine ⟨⟨fun x y => ?_⟩⟩
    apply e.symm.injective
    rw [map_mul, map_mul]
    exact (IsCyclic.isMulCommutative (α := Q)).is_comm.comm _ _
  have hQrank_le : generatorRank Q ≤ 2 := by
    rw [hkt_generatorRank_eq_of_mulEquiv e]
    exact huppert_IV_5_10_generatorRank_le_two_of_isMetacyclic
      (huppert_IV_5_10_quaternionGroup_isMetacyclic k)
  have hQrank_ge : 2 ≤ generatorRank Q := by
    by_contra h
    have hle : generatorRank Q ≤ 1 := by omega
    exact hQnoncyclic (isCyclic_of_generatorRank_le_one (G := Q) hle)
  have hQrank : generatorRank Q = 2 := le_antisymm hQrank_le hQrank_ge
  have hquotRank_le : generatorRank (Q ⧸ frattini Q) ≤ generatorRank Q := by
    rw [generatorRank_eq_group_rank, generatorRank_eq_group_rank]
    exact Group.rank_le_of_surjective
      (QuotientGroup.mk' (frattini Q)) (QuotientGroup.mk'_surjective _)
  have hquotRank_ge : generatorRank Q ≤ generatorRank (Q ⧸ frattini Q) :=
    generatorRank_le_generatorRank_quotient_frattini (p := 2) Q
  have hquotRank : generatorRank (Q ⧸ frattini Q) = 2 := by omega
  let : IsElementaryAbelian 2 (Q ⧸ frattini Q) :=
    isElementaryAbelian_quotient_frattini (R := Q) (p := 2)
  rw [elementaryAbelian_card_eq_pow_generatorRank (p := 2) (Q ⧸ frattini Q),
    hquotRank]
  norm_num

private theorem hkt_actsTrivially_of_coprime_card_factorial
    {A X : Type u} [Group A] [Finite A] [Finite X] [MulAction A X]
    (hcop : Nat.Coprime (Nat.card A) (Nat.factorial (Nat.card X))) :
    ActsTrivially (A := A) (G := X) := by
  classical
  let phi : A →* Equiv.Perm X := MulAction.toPermHom A X
  have hdivA : Nat.card phi.range ∣ Nat.card A :=
    Subgroup.card_range_dvd phi
  have hdivFact : Nat.card phi.range ∣ Nat.factorial (Nat.card X) := by
    simpa [Nat.card_perm] using
      Subgroup.card_subgroup_dvd_card phi.range
  have hcard : Nat.card phi.range = 1 :=
    Nat.eq_one_of_dvd_coprimes hcop hdivA hdivFact
  have hrange : phi.range = ⊥ :=
    (Subgroup.card_eq_one (H := phi.range)).1 hcard
  intro a x
  have ha : phi a ∈ phi.range := ⟨a, rfl⟩
  have hphi : phi a = 1 := by
    rw [hrange] at ha
    exact Subgroup.mem_bot.mp ha
  have hx := congrArg (fun f : Equiv.Perm X => f x) hphi
  simpa [phi] using hx

private theorem hkt_coprime_factorial_of_card_le_four
    {A X : Type u} [Finite A] [Finite X]
    (hodd : Odd (Nat.card A))
    (hthree : ¬ 3 ∣ Nat.card A)
    (hX : Nat.card X ≤ 4) :
    Nat.Coprime (Nat.card A) (Nat.factorial (Nat.card X)) := by
  have h2 : Nat.Coprime (Nat.card A) 2 := hodd.coprime_two_right
  have h3 : Nat.Coprime (Nat.card A) 3 :=
    (Nat.prime_three.coprime_iff_not_dvd.mpr hthree).symm
  have h8 : Nat.Coprime (Nat.card A) (2 ^ 3) := h2.pow_right 3
  have h24 : Nat.Coprime (Nat.card A) 24 :=
    Nat.Coprime.mul_right h3 h8
  exact Nat.Coprime.of_dvd_right
    (Nat.factorial_dvd_factorial hX) h24

private theorem hkt_normal_of_complement_centralizes_local
    {K : Type u} [Group K]
    {H R : Subgroup K} [H.Normal]
    (hcomp : H.IsComplement' R)
    (hcent : R ≤ Subgroup.centralizer (H : Set K)) :
    R.Normal := by
  classical
  have hH_le_normR : H ≤ Subgroup.normalizer (R : Set K) := by
    intro h hh
    rw [Subgroup.mem_normalizer_iff]
    intro r
    constructor
    · intro hr
      have hr_cent : r ∈ Subgroup.centralizer (H : Set K) := hcent hr
      have hcomm : h * r = r * h :=
        (Subgroup.mem_centralizer_iff.mp hr_cent) h hh
      have hconj : h * r * h⁻¹ = r := by
        calc
          h * r * h⁻¹ = (r * h) * h⁻¹ := by rw [hcomm]
          _ = r := by simp [mul_assoc]
      simpa [hconj] using hr
    · intro hconj_mem
      let s : K := h * r * h⁻¹
      have hs_cent : s ∈ Subgroup.centralizer (H : Set K) := hcent hconj_mem
      have hs_comm_h : h * s = s * h :=
        (Subgroup.mem_centralizer_iff.mp hs_cent) h hh
      have hback : h⁻¹ * s * h = s := by
        calc
          h⁻¹ * s * h = h⁻¹ * (s * h) := by rw [mul_assoc]
          _ = h⁻¹ * (h * s) := by rw [← hs_comm_h]
          _ = s := by simp
      have hr_eq : r = s := by
        calc
          r = h⁻¹ * (h * r * h⁻¹) * h := by simp [mul_assoc]
          _ = h⁻¹ * s * h := by rfl
          _ = s := hback
      rw [hr_eq]
      exact hconj_mem
  have htop_le_norm : (⊤ : Subgroup K) ≤ Subgroup.normalizer (R : Set K) := by
    rw [← hcomp.sup_eq_top]
    exact sup_le hH_le_normR Subgroup.le_normalizer
  exact Subgroup.normalizer_eq_top_iff.mp (top_le_iff.mp htop_le_norm)

private theorem hkt_hasNormalPComplement_of_normal_complement_local
    {K : Type u} [Group K] [Finite K]
    {q : ℕ} [Fact q.Prime]
    {H R : Subgroup K} [R.Normal]
    (hcomp : H.IsComplement' R)
    (hRcop : Nat.Coprime q (Nat.card R))
    (hHp : IsPGroup q H) :
    HasNormalPComplement q K := by
  classical
  refine ⟨R, inferInstance, hRcop, ?_⟩
  exact hHp.of_equiv hcomp.QuotientMulEquiv.symm

/-- Huppert IV.5.11 in the rank-two form used for generalized quaternion
Sylow 2-subgroups. -/
public theorem huppert_IV_5_11_hasNormalPComplement_of_rankTwo_twoSubgroups
    {G : Type u} [Group G] [Finite G]
    (hthree : ¬ 3 ∣ Nat.card G)
    (hrank : ∀ U : Subgroup G,
      IsPGroup 2 U → generatorRank U ≤ 2) :
    HasNormalPComplement 2 G := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  induction hcard : Nat.card G using Nat.strong_induction_on generalizing G with
  | h n ih =>
      by_cases htwo : 2 ∣ Nat.card G
      · by_contra hnot
        let P : Sylow 2 G := default
        have hproper :
            ∀ H : Subgroup G, H ≠ ⊥ → H ≠ ⊤ →
              2 ∣ Nat.card H → HasNormalPComplement 2 H := by
          intro H _hHbot hHtop _h2H
          have hHthree : ¬ 3 ∣ Nat.card H := by
            intro h3H
            exact hthree (h3H.trans H.card_subgroup_dvd_card)
          have hHrank :
              ∀ U : Subgroup H, IsPGroup 2 U →
                generatorRank U ≤ 2 := by
            intro U hUp
            let Umap : Subgroup G := U.map H.subtype
            have hUmapP : IsPGroup 2 Umap := hUp.map H.subtype
            have hUmapRank : generatorRank Umap ≤ 2 :=
              hrank Umap hUmapP
            let e : U ≃* Umap :=
              Subgroup.equivMapOfInjective
                (f := H.subtype) U H.subtype_injective
            rw [hkt_generatorRank_eq_of_mulEquiv e]
            exact hUmapRank
          have hHlt : Nat.card H < n := by
            rw [← hcard]
            simpa using natCard_lt_of_subgroup_lt (G := G)
              (lt_top_iff_ne_top.mpr hHtop)
          exact ih (Nat.card H) hHlt
            (G := H) hHthree hHrank rfl
        have hPnormal : (P : Subgroup G).Normal :=
          huppert_IV_5_4_a hproper hnot P htwo
        let : (P : Subgroup G).Normal := hPnormal
        obtain ⟨H, hcomp⟩ :=
          Subgroup.exists_right_complement'_of_coprime
            (N := (P : Subgroup G)) P.card_coprime_index
        have hHnot2 : ¬ 2 ∣ Nat.card H := by
          rw [← (Subgroup.IsComplement'.symm hcomp).index_eq_card]
          exact P.not_dvd_index
        have hHodd : Odd (Nat.card H) := by
          exact Nat.not_even_iff_odd.mp (by simpa [even_iff_two_dvd] using hHnot2)
        have hHthree : ¬ 3 ∣ Nat.card H := by
          intro h3H
          exact hthree (h3H.trans H.card_subgroup_dvd_card)
        let : Fact (IsPGroup 2 P) := ⟨P.isPGroup'⟩
        let : MulDistribMulAction H P := inferInstance
        have hPhiInv : IsInvariant H P (frattini P) :=
          isInvariant_of_characteristic
            (A := H) (G := P) (frattini P)
        let : MulDistribMulAction H (P ⧸ frattini P) :=
          quotientMulDistribMulAction
            (A := H) (G := P) (frattini P) hPhiInv
        let : IsElementaryAbelian 2 (P ⧸ frattini P) :=
          isElementaryAbelian_quotient_frattini (R := P) (p := 2)
        have hquotRank : generatorRank (P ⧸ frattini P) ≤ 2 := by
          apply le_trans ?_ (hrank P P.isPGroup')
          rw [generatorRank_eq_group_rank, generatorRank_eq_group_rank]
          exact Group.rank_le_of_surjective
            (QuotientGroup.mk' (frattini P))
            (QuotientGroup.mk'_surjective _)
        have hquotCard : Nat.card (P ⧸ frattini P) ≤ 4 := by
          rw [elementaryAbelian_card_eq_pow_generatorRank
            (p := 2) (P ⧸ frattini P)]
          exact Nat.pow_le_pow_right (by decide : 0 < 2) hquotRank
        have hquotTriv :
            ActsTrivially (A := H) (G := P ⧸ frattini P) :=
          hkt_actsTrivially_of_coprime_card_factorial
            (hkt_coprime_factorial_of_card_le_four
              hHodd hHthree hquotCard)
        have hHPcop : Nat.Coprime (Nat.card H) (Nat.card P) := by
          rw [← (Subgroup.IsComplement'.symm hcomp).index_eq_card]
          exact P.card_coprime_index.symm
        have htrivP : ActsTrivially (A := H) (G := P) :=
          theorem_1_8
            (R := P) (A := H) (p := 2) hHPcop hquotTriv
        have hHcent : H ≤ Subgroup.centralizer ((P : Subgroup G) : Set G) := by
          intro h hh
          rw [Subgroup.mem_centralizer_iff]
          intro p hp
          have hfix := htrivP ⟨h, hh⟩ ⟨p, hp⟩
          have hconj : h * p * h⁻¹ = p := by
            simpa [Subgroup.conjMulDistribMulActionOfNormal_smul_coe] using
              congrArg Subtype.val hfix
          calc
            p * h = (h * p * h⁻¹) * h := by rw [hconj]
            _ = h * p := by group
        let : H.Normal :=
          hkt_normal_of_complement_centralizes_local hcomp hHcent
        have hHcop2 : Nat.Coprime 2 (Nat.card H) :=
          Nat.prime_two.coprime_iff_not_dvd.mpr hHnot2
        exact hnot
          (hkt_hasNormalPComplement_of_normal_complement_local
            hcomp hHcop2 P.isPGroup')
      · exact hkt_hasNormalPComplement_of_not_dvd_card
          (Q := G) (p := 2) htwo

/-- Huppert IV.5.11 for a generalized-quaternion Sylow 2-subgroup. -/
public theorem huppert_IV_5_11_hasNormalPComplement_of_quaternion_sylow_two
    {G : Type u} [Group G] [Finite G]
    (P : Sylow 2 G)
    (hPquaternion :
      ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
        Nonempty (P ≃* QuaternionGroup k))
    (hthree : ¬ 3 ∣ Nat.card G) :
    HasNormalPComplement 2 G := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rcases hPquaternion with ⟨k, hk, _hQp, ⟨eP⟩⟩
  let : NeZero k := ⟨by omega⟩
  apply huppert_IV_5_11_hasNormalPComplement_of_rankTwo_twoSubgroups hthree
  intro U hU2
  obtain ⟨Q, hU_le_Q⟩ := hU2.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G Q P
  let c : G ≃* G := MulAut.conj g
  let Uc : Subgroup G := U.map c.toMonoidHom
  have hQmap : (Q : Subgroup G).map c.toMonoidHom = (P : Subgroup G) := by
    calc
      (Q : Subgroup G).map c.toMonoidHom =
          (MulAut.conj g • (Q : Subgroup G) : Subgroup G) := by rfl
      _ = ((g • Q : Sylow 2 G) : Subgroup G) := by
        rw [← Sylow.coe_subgroup_smul (g := g) (P := Q)]
      _ = (P : Subgroup G) := by simp [hg]
  have hUc_le_P : Uc ≤ (P : Subgroup G) := by
    rw [← hQmap]
    exact Subgroup.map_mono hU_le_Q
  let UP : Subgroup P := Uc.subgroupOf P
  let V : Subgroup (QuaternionGroup k) := UP.map eP.toMonoidHom
  have hVmeta : IsMetacyclic V :=
    huppert_IV_5_10_isMetacyclic_subgroup V
      (huppert_IV_5_10_quaternionGroup_isMetacyclic k)
  have hVrank : generatorRank V ≤ 2 :=
    huppert_IV_5_10_generatorRank_le_two_of_isMetacyclic hVmeta
  let eU : U ≃* Uc :=
    Subgroup.equivMapOfInjective
      (f := c.toMonoidHom) U c.injective
  let eUP : UP ≃* Uc := Subgroup.subgroupOfEquivOfLe hUc_le_P
  let eV : UP ≃* V :=
    Subgroup.equivMapOfInjective
      (f := eP.toMonoidHom) UP eP.injective
  calc
    generatorRank U = generatorRank Uc :=
      hkt_generatorRank_eq_of_mulEquiv eU
    _ = generatorRank UP :=
      (hkt_generatorRank_eq_of_mulEquiv eUP).symm
    _ = generatorRank V :=
      hkt_generatorRank_eq_of_mulEquiv eV
    _ ≤ 2 := hVrank

/-- A finite subgroup which is simultaneously a `2`-group and a `3`-group is
trivial. -/
public theorem hkt_eq_bot_of_isPGroup_two_and_three
    {G : Type*} [Group G] [Finite G] (H : Subgroup G)
    (h2 : IsPGroup 2 H) (h3 : IsPGroup 3 H) :
    H = ⊥ := by
  rcases h2.exists_card_eq with ⟨a, ha⟩
  rcases h3.exists_card_eq with ⟨b, hb⟩
  have hab : 2 ^ a = 3 ^ b := ha.symm.trans hb
  have ha0 : a = 0 := by
    by_contra ha0
    have h2dvd : 2 ∣ 3 ^ b := by
      rw [← hab]
      exact dvd_pow_self 2 ha0
    have h23 : 2 ∣ 3 := Nat.Prime.dvd_of_dvd_pow Nat.prime_two h2dvd
    norm_num at h23
  apply Subgroup.card_eq_one.mp
  rw [ha, ha0]
  simp

/-- Under a normal `p`-complement, a Sylow `p`-subgroup maps onto the
canonical `p`-core quotient. -/
public theorem sylow_map_quotient_pPrimeCore_eq_top_of_hasNormalPComplement
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hcomp : HasNormalPComplement p G) (S : Sylow p G) :
    (S : Subgroup G).map (QuotientGroup.mk' (pPrimeCore p G)) = ⊤ := by
  classical
  let N : Subgroup G := pPrimeCore p G
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  let Q := G ⧸ N
  have hQp : IsPGroup p Q :=
    isPGroup_quotient_pPrimeCore_of_hasNormalPComplement
      (p := p) (H := G) hcomp
  let Tmap : Sylow p Q :=
    S.mapSurjective (f := q) (QuotientGroup.mk'_surjective N)
  have htop_p : IsPGroup p (⊤ : Subgroup Q) := by
    simpa using hQp.to_subgroup (⊤ : Subgroup Q)
  let Ttop : Sylow p Q :=
    IsPGroup.toSylow (G := Q) (p := p) htop_p (by
      simpa using (Fact.out : Nat.Prime p).not_dvd_one)
  have hTtop_normal : (Ttop : Subgroup Q).Normal := by
    have hTtop_eq : (Ttop : Subgroup Q) = ⊤ := by
      dsimp [Ttop]
    rw [hTtop_eq]
    infer_instance
  have : Unique (Sylow p Q) := Sylow.unique_of_normal Ttop hTtop_normal
  have hSylow_eq : Tmap = Ttop := Subsingleton.elim _ _
  change (Tmap : Subgroup Q) = ⊤
  simpa [Tmap, Ttop, IsPGroup.toSylow_coe, q, N, Q] using
    congrArg (fun P : Sylow p Q => (P : Subgroup Q)) hSylow_eq

/-- The canonical `p`-core quotient is equivalent to any Sylow `p`-subgroup
when a normal `p`-complement exists. -/
public noncomputable def quotientPPrimeCoreEquivSylowOfHasNormalPComplement
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hcomp : HasNormalPComplement p G) (S : Sylow p G) :
    (G ⧸ pPrimeCore p G) ≃* (S : Subgroup G) := by
  classical
  let N : Subgroup G := pPrimeCore p G
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have hSmap_top : (S : Subgroup G).map q = ⊤ := by
    simpa [q, N] using
      sylow_map_quotient_pPrimeCore_eq_top_of_hasNormalPComplement hcomp S
  let qS : (S : Subgroup G) →* (S : Subgroup G).map q :=
    q.subgroupMap (S : Subgroup G)
  have hqS_surj : Function.Surjective qS :=
    MonoidHom.subgroupMap_surjective q (S : Subgroup G)
  have hqS_range_top : qS.range = ⊤ := by
    rw [MonoidHom.range_eq_top]
    exact hqS_surj
  have hN_cop : Nat.Coprime p (Nat.card N) := by
    simpa [N] using pPrimeCore_coprime_card (p := p) (G := G)
  have hS_inf_N : (S : Subgroup G) ⊓ N = ⊥ := by
    rcases S.isPGroup'.exists_card_eq with ⟨n, hn⟩
    have hcop : Nat.Coprime (Nat.card (S : Subgroup G)) (Nat.card N) := by
      rw [hn]
      exact Nat.Coprime.pow_left n hN_cop
    rw [← disjoint_iff]
    exact Subgroup.disjoint_of_coprime_natCard hcop
  have hqS_ker : qS.ker = ⊥ := by
    have hker : qS.ker = N.subgroupOf (S : Subgroup G) := by
      simpa [qS, q, N, QuotientGroup.ker_mk'] using
        (Subgroup.ker_subgroupMap (f := q) (H := (S : Subgroup G)))
    rw [hker, Subgroup.subgroupOf_eq_bot, disjoint_iff]
    simpa [inf_comm] using hS_inf_N
  let eKer : (S : Subgroup G) ⧸ qS.ker ≃* (S : Subgroup G) :=
    (QuotientGroup.quotientMulEquivOfEq hqS_ker).trans
      QuotientGroup.quotientBot
  let eImage : (S : Subgroup G) ⧸ qS.ker ≃* (S : Subgroup G).map q :=
    (QuotientGroup.quotientKerEquivRange qS).trans
      ((MulEquiv.subgroupCongr hqS_range_top).trans Subgroup.topEquiv)
  let eTop : (S : Subgroup G).map q ≃* G ⧸ N :=
    (MulEquiv.subgroupCongr hSmap_top).trans Subgroup.topEquiv
  exact eTop.symm.trans (eImage.symm.trans eKer)

/-- The kernel of conjugation on a normal subgroup is its ambient
centralizer. -/
public theorem conjNormal_ker_eq_centralizer
    {G : Type*} [Group G] {H : Subgroup G} [H.Normal] :
    (MulAut.conjNormal (H := H)).ker = Subgroup.centralizer (H : Set G) := by
  let phi : G →* MulAut H := MulAut.conjNormal (H := H)
  ext x
  rw [Subgroup.mem_centralizer_iff, MonoidHom.mem_ker]
  constructor
  · intro hx h hh
    have hx_apply : phi x ⟨h, hh⟩ = ⟨h, hh⟩ := by
      change (MulAut.conjNormal (H := H) x) ⟨h, hh⟩ = ⟨h, hh⟩
      rw [hx]
      rfl
    have hconj : x * h * x⁻¹ = h := by
      simpa [phi, MulAut.conjNormal_apply, MulAut.conj_apply] using
        congrArg Subtype.val hx_apply
    have heq := congrArg (fun y : G => y * x) hconj
    simpa [mul_assoc] using heq.symm
  · intro hx
    ext h
    have hcomm : (h : G) * x = x * h := hx h h.2
    have hconj : x * (h : G) * x⁻¹ = h := by
      calc
        x * (h : G) * x⁻¹ = ((h : G) * x) * x⁻¹ := by rw [hcomm]
        _ = h := by simp [mul_assoc]
    simpa [phi, MulAut.conjNormal_apply, MulAut.conj_apply] using hconj

/-- A normal `3`-complement contains every Sylow `2`-subgroup; this is stated
for the canonical `3'`-core so that it is stable under automorphisms. -/
public theorem sylow_two_le_pPrimeCore_three_of_hasNormalPComplement
    {G : Type*} [Group G] [Finite G]
    (hcomp : HasNormalPComplement 3 G) (P : Sylow 2 G) :
    (P : Subgroup G) ≤ pPrimeCore 3 G := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let R : Subgroup G := pPrimeCore 3 G
  let q : G →* G ⧸ R := QuotientGroup.mk' R
  have hquot3 : IsPGroup 3 (G ⧸ R) := by
    simpa [R] using
      (isPGroup_quotient_pPrimeCore_of_hasNormalPComplement
        (p := 3) (H := G) hcomp)
  let H : Subgroup (G ⧸ R) := (P : Subgroup G).map q
  have hH2 : IsPGroup 2 H := P.isPGroup'.map q
  have hH3 : IsPGroup 3 H := hquot3.to_subgroup H
  have hHbot : H = ⊥ := hkt_eq_bot_of_isPGroup_two_and_three H hH2 hH3
  intro x hx
  apply (QuotientGroup.eq_one_iff (N := R) (x := x)).mp
  have hqx : q x ∈ H := ⟨x, hx, rfl⟩
  rw [hHbot] at hqx
  exact Subgroup.mem_bot.mp hqx
/-- In XI.2.5(d), the canonical normal `3`-complement is itself
`2`-nilpotent when a Sylow `2`-subgroup of the ambient group is generalized
quaternion. -/
public theorem huppert_XI_2_5_hasNormalPComplement_two_pPrimeCore_three
    {G : Type*} [Group G] [Finite G]
    (P : Sylow 2 G)
    (hPquaternion :
      ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
        Nonempty (P ≃* QuaternionGroup k))
    (hcompThree : HasNormalPComplement 3 G) :
    HasNormalPComplement 2 (pPrimeCore 3 G) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let R : Subgroup G := pPrimeCore 3 G
  have hP_le_R : (P : Subgroup G) ≤ R := by
    simpa [R] using
      sylow_two_le_pPrimeCore_three_of_hasNormalPComplement hcompThree P
  let PR : Sylow 2 R := P.subtype hP_le_R
  have hPRquaternion :
      ∃ k : ℕ, 2 ≤ k ∧ IsPGroup 2 (QuaternionGroup k) ∧
        Nonempty (PR ≃* QuaternionGroup k) := by
    rcases hPquaternion with ⟨k, hk, hkP, ⟨eP⟩⟩
    let ePR : PR ≃* P :=
      (MulEquiv.subgroupCongr (by rfl)).trans
        (Subgroup.subgroupOfEquivOfLe hP_le_R)
    exact ⟨k, hk, hkP, ⟨ePR.trans eP⟩⟩
  have hRthree : ¬ 3 ∣ Nat.card R := by
    exact Nat.prime_three.coprime_iff_not_dvd.mp
      (by simpa [R] using pPrimeCore_coprime_card (G := G) (p := 3))
  simpa [R] using
    huppert_IV_5_11_hasNormalPComplement_of_quaternion_sylow_two
      PR hPRquaternion hRthree
/-- Huppert XI.2.5(c): uniqueness of the subgroup of order three and a top
two-residual force a normal 3-complement when Sylow 3-subgroups are cyclic. -/
public theorem huppert_XI_2_5_hasNormalPComplement_three_of_top_twoResidual
    {G : Type u} [Group G] [Finite G]
    (hres : hktPResidual 2 G = ⊤)
    (hthree : 3 ∣ Nat.card G)
    (hunique :
      ∀ U V : Subgroup G, Nat.card U = 3 → Nat.card V = 3 → U = V)
    (hcyclic : ∀ Q : Sylow 3 G, IsCyclic Q) :
    HasNormalPComplement 3 G := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := G) 3 hthree
  let T : Subgroup G := Subgroup.zpowers x
  have hTcard : Nat.card T = 3 := by
    change Nat.card (Subgroup.zpowers x) = 3
    rw [Nat.card_zpowers, hx]
  have hTcyclic : IsCyclic T := Subgroup.isCyclic_zpowers x
  have hTnormal : T.Normal := by
    refine ⟨fun t ht g => ?_⟩
    let Tg : Subgroup G := T.map (MulAut.conj g).toMonoidHom
    have hTgcard : Nat.card Tg = 3 := by
      calc
        Nat.card Tg = Nat.card T := by
          exact Subgroup.card_map_of_injective
            (K := T) (f := (MulAut.conj g).toMonoidHom)
              (MulAut.conj g).injective
        _ = 3 := hTcard
    have hTg : Tg = T := hunique Tg T hTgcard hTcard
    have hmem : g * t * g⁻¹ ∈ Tg := by
      refine ⟨t, ht, ?_⟩
      simp [MulAut.conj_apply]
    simpa [hTg] using hmem
  let : T.Normal := hTnormal
  let ψ : G →* MulAut T := MulAut.conjNormal (H := T)
  have hAutTcard : Nat.card (MulAut T) = 2 := by
    let : IsCyclic T := hTcyclic
    rw [IsCyclic.card_mulAut, hTcard, Nat.totient_prime Nat.prime_three]
  have hAutTP : IsPGroup 2 (MulAut T) := by
    apply IsPGroup.of_card (p := 2) (G := MulAut T) (n := 1)
    simpa using hAutTcard
  have hRangeP : IsPGroup 2 ψ.range := hAutTP.to_subgroup ψ.range
  have hQuotP : IsPGroup 2 (G ⧸ ψ.ker) := by
    exact hRangeP.of_equiv (QuotientGroup.quotientKerEquivRange ψ).symm
  have hResidualLe : hktPResidual 2 G ≤ ψ.ker :=
    hktPResidual_le ψ.ker inferInstance hQuotP
  have hKerTop : ψ.ker = ⊤ := by
    apply top_unique
    rw [← hres]
    exact hResidualLe
  have hψone : ψ = 1 := MonoidHom.ker_eq_top_iff.mp hKerTop
  let Q : Sylow 3 G := default
  let N : Subgroup G := Subgroup.normalizer ((Q : Subgroup G) : Set G)
  have hQleN : (Q : Subgroup G) ≤ N := by
    simpa [N] using
      (Subgroup.le_normalizer :
        (Q : Subgroup G) ≤ Subgroup.normalizer ((Q : Subgroup G) : Set G))
  let QN : Sylow 3 N := Q.subtype hQleN
  let : IsCyclic Q := hcyclic Q
  let : Fact (IsPGroup 3 Q) := ⟨Q.isPGroup'⟩
  have hNleNormalizer :
      N ≤ Subgroup.normalizer ((Q : Subgroup G) : Set G) := by
    simp [N]
  let : Subgroup.Normalizes N (Q : Subgroup G) := ⟨hNleNormalizer⟩
  let : MulDistribMulAction N Q :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer
      (G := G) N (Q : Subgroup G) hNleNormalizer
  let φ : N →* MulAut Q := MulDistribMulAction.toMulAut N Q
  have hQNleKer : (QN : Subgroup N) ≤ φ.ker := by
    intro q hq
    rw [MonoidHom.mem_ker]
    apply MulEquiv.ext
    intro y
    apply Subtype.ext
    have hq_mem : (q : G) ∈ (Q : Subgroup G) := by
      have hQN_eq : (QN : Subgroup N) = (Q : Subgroup G).subgroupOf N := by
        rfl
      have hq_sub : q ∈ (Q : Subgroup G).subgroupOf N := by
        simpa [hQN_eq] using hq
      exact (Subgroup.mem_subgroupOf.mp hq_sub)
    let qQ : Q := ⟨(q : G), hq_mem⟩
    have hcommQ : qQ * y = y * qQ := (IsCyclic.isMulCommutative (α := Q)).is_comm.comm qQ y
    have hcomm : (qQ : G) * (y : G) = (y : G) * (qQ : G) :=
      congrArg Subtype.val hcommQ
    have hconj : (qQ : G) * (y : G) * (qQ : G)⁻¹ = (y : G) := by
      rw [hcomm]
      simp [mul_assoc]
    simpa [φ, qQ,
      Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe, hNleNormalizer] using hconj
  have hRangeDvdIndex : Nat.card φ.range ∣ (QN : Subgroup N).index := by
    rw [← Subgroup.index_ker]
    exact Subgroup.index_dvd_of_le hQNleKer
  have hQNcard : Nat.card QN = Nat.card Q := by
    change Nat.card ↥((Q : Subgroup G).subgroupOf N) = Nat.card ↥Q
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQleN).toEquiv
  have hRangeCoprimeQ : Nat.Coprime (Nat.card φ.range) (Nat.card Q) := by
    have hcop : Nat.Coprime (Nat.card φ.range) (Nat.card QN) :=
      Nat.Coprime.of_dvd_left hRangeDvdIndex QN.card_coprime_index.symm
    simpa [hQNcard] using hcop
  have hfixOrderThree :
      ∀ y : Q, orderOf y = 3 → ∀ a : φ.range, a • y = y := by
    intro y hy a
    obtain ⟨n, hn⟩ := a.property
    have hyGorder : orderOf (y : G) = 3 := by
      simpa only [Subgroup.orderOf_coe] using hy
    have hzycard : Nat.card (Subgroup.zpowers (y : G)) = 3 := by
      rw [Nat.card_zpowers, hyGorder]
    have hzyT : Subgroup.zpowers (y : G) = T :=
      hunique (Subgroup.zpowers (y : G)) T hzycard hTcard
    have hyT : (y : G) ∈ T := by
      rw [← hzyT]
      exact Subgroup.mem_zpowers (y : G)
    have hfixT :
        MulAut.conjNormal (H := T) ((n : N) : G) ⟨(y : G), hyT⟩ =
          ⟨(y : G), hyT⟩ := by
      change ψ (((n : N) : G)) ⟨(y : G), hyT⟩ = ⟨(y : G), hyT⟩
      rw [hψone]
      rfl
    have hconj : ((n : N) : G) * (y : G) * ((n : N) : G)⁻¹ = (y : G) := by
      simpa [MulAut.conjNormal_apply, MulAut.conj_apply] using
        congrArg Subtype.val hfixT
    change (a : MulAut Q) y = y
    rw [← hn]
    apply Subtype.ext
    simpa [φ,
      Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe, hNleNormalizer] using hconj
  have hOmegaTrivial :
      ActsTriviallyOnSubgroup
        (A := φ.range) (G := Q) (omega₁ (G := Q) (p := 3)) :=
    PGroup.actsTriviallyOnSubgroup_omega₁_of_fix_order_p hfixOrderThree
  have hRangeTrivial : ActsTrivially (A := φ.range) (G := Q) :=
    theorem_1_11 (G := Q) (A := φ.range) (p := 3)
      (by norm_num) hRangeCoprimeQ hOmegaTrivial
  have hQcenter : (Q : Subgroup G) ≤ centerIn (G := G) N := by
    intro y hy
    refine ⟨hQleN hy, ?_⟩
    change y ∈ Subgroup.centralizer (N : Set G)
    rw [Subgroup.mem_centralizer_iff]
    intro n hn
    let nN : N := ⟨n, hn⟩
    let a : φ.range := ⟨φ nN, ⟨nN, rfl⟩⟩
    let yQ : Q := ⟨y, hy⟩
    have hfix : a • yQ = yQ := hRangeTrivial a yQ
    have hconj : n * y * n⁻¹ = y := by
      have hsmul : nN • (yQ : Q) = yQ := by
        calc
          nN • (yQ : Q) = (MulDistribMulAction.toMulAut N Q nN) (yQ : Q) := rfl
          _ = (φ nN) (yQ : Q) := rfl
          _ = ((a : φ.range) : MulAut Q) (yQ : Q) := by simp [a]
          _ = a • (yQ : Q) := rfl
          _ = yQ := hfix
      calc
        n * y * n⁻¹ = (nN : G) * (yQ : G) * (nN : G)⁻¹ := by
          simp [nN, yQ]
        _ = ((nN • (yQ : Q) : Q) : G) := by
          symm
          exact Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe N (Q : Subgroup G) nN yQ
        _ = (yQ : G) := by
          simp [hsmul]
        _ = y := rfl
    have hmul := congrArg (fun z : G => z * n) hconj
    simpa [mul_assoc] using hmul
  exact hkt_hasNormalPComplement_of_sylow_le_center_normalizer Q hQcenter
public theorem normalPComplement_eq_pPrimeCore
    {G : Type u} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime]
    (N : Subgroup G) [N.Normal]
    (hNcop : Nat.Coprime p (Nat.card N))
    (hquot : IsPGroup p (G ⧸ N)) :
    N = pPrimeCore p G := by
  apply le_antisymm
  · change N ≤ sSup (normalPPrimeSubgroups p G)
    exact le_sSup ⟨inferInstance, hNcop⟩
  · apply pPrimeCore_le_of_quotient_eq_bot (G := G) (p := p) N
    apply (pPrimeCore_eq_bot_iff (p := p) (G := G ⧸ N)).2
    intro K hKnormal hKcop
    have hKp : IsPGroup p K := hquot.to_subgroup K
    rcases hKp.card_eq_or_dvd with hKcard | hpdvd
    · exact (Subgroup.card_eq_one (H := K)).1 hKcard
    · exact False.elim
        (((Fact.out : Nat.Prime p).coprime_iff_not_dvd).1 hKcop hpdvd)

public theorem mulAut_card_dvd_six_of_card_eq_four
    {E : Type u} [Group E] [Finite E]
    (hEcard : Nat.card E = 4) :
    Nat.card (MulAut E) ∣ 6 := by
  classical
  let : Fintype E := Fintype.ofFinite E
  let X := {x : E // x ≠ 1}
  let psiFun : MulAut E → Equiv.Perm X := fun a =>
    Equiv.Perm.subtypePerm a.toEquiv (by
      intro x
      constructor
      · intro hax hx
        subst x
        exact hax (map_one a)
      · intro hx hax
        apply hx
        apply a.injective
        simpa using hax)
  let psi : MulAut E →* Equiv.Perm X := {
    toFun := psiFun
    map_one' := by
      ext x
      rfl
    map_mul' := by
      intro a b
      ext x
      rfl
  }
  have hpsi : Function.Injective psi := by
    intro a b hab
    ext x
    by_cases hx : x = 1
    · simp [hx]
    · have h := congrArg (fun f : Equiv.Perm X => f ⟨x, hx⟩) hab
      exact congrArg Subtype.val h
  let : Fintype X := Fintype.ofFinite X
  have hXcard : Nat.card X = 3 := by
    rw [Nat.card_eq_fintype_card]
    change Fintype.card {x : E // x ≠ 1} = 3
    rw [Fintype.card_subtype_compl (fun x : E => x = 1)]
    simp [← Nat.card_eq_fintype_card, hEcard]
  have hdiv : Nat.card (MulAut E) ∣ Nat.card (Equiv.Perm X) :=
    Subgroup.card_dvd_of_injective psi hpsi
  rw [Nat.card_perm, hXcard] at hdiv
  norm_num at hdiv ⊢
  exact hdiv
set_option maxHeartbeats 800000 in
/-- XI.2.5(d): a four-element characteristic quotient layer inside the
canonical normal 3-complement yields a characteristic subgroup of index
twelve when the 2-residual is the whole group. -/
public theorem huppert_XI_2_5_exists_characteristic_index_twelve_of_top_two_residual
    {G : Type u} [Group G] [Finite G]
    (hres : hktPResidual 2 G = ⊤)
    (hcompThree : HasNormalPComplement 3 G)
    (M_L : Subgroup (pPrimeCore 3 G)) [M_L.Characteristic]
    (hLquotCard : Nat.card ((pPrimeCore 3 G) ⧸ M_L) = 4) :
    ∃ Z : Subgroup G, Z.Characteristic ∧ Z.index = 12 := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let L : Subgroup G := pPrimeCore 3 G
  have hLchar : L.Characteristic := by
    simpa [L] using pPrimeCore_characteristic (p := 3) (G := G)
  let : L.Characteristic := hLchar
  let M : Subgroup G := M_L.map L.subtype
  have hMchar : M.Characteristic := by
    simpa [M, L] using
      characteristic_map_subtype_of_characteristic (G := G) L M_L
  let : M.Characteristic := hMchar
  have hM_le_L : M ≤ L := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, _hy, rfl⟩
    exact y.property
  have hMsub : M.subgroupOf L = M_L := by
    simpa [M] using (subgroupOf_map_subtype_eq (K := L) M_L)
  let Q := G ⧸ M
  let qM : G →* Q := QuotientGroup.mk' M
  let E : Subgroup Q := L.map qM
  have hEnormal : E.Normal := by
    dsimp [E, qM]
    exact Subgroup.Normal.map (inferInstance : L.Normal)
      (QuotientGroup.mk' M) (QuotientGroup.mk'_surjective M)
  let : E.Normal := hEnormal
  let eE : (L ⧸ M_L) ≃* E :=
    (QuotientGroup.quotientMulEquivOfEq hMsub.symm).trans
      (quotientSubgroupRangeEquiv L M)
  have hEcard : Nat.card E = 4 := by
    rw [← hLquotCard]
    exact Nat.card_congr eE.symm.toEquiv
  have hEcop : Nat.Coprime 3 (Nat.card E) := by
    rw [hEcard]
    norm_num
  have hQquotE3 : IsPGroup 3 (Q ⧸ E) := by
    let eQE : Q ⧸ E ≃* G ⧸ L := by
      simpa [Q, E, qM] using
        (QuotientGroup.quotientQuotientEquivQuotient
          (N := M) (M := L) hM_le_L)
    exact
      (isPGroup_quotient_pPrimeCore_of_hasNormalPComplement
        (p := 3) (H := G) hcompThree).of_equiv eQE.symm
  have hEeqCore : E = pPrimeCore 3 Q :=
    normalPComplement_eq_pPrimeCore E hEcop hQquotE3
  have hEchar : E.Characteristic := by
    rw [hEeqCore]
    infer_instance
  let : E.Characteristic := hEchar
  have hEcomm : IsMulCommutative E := by
    apply IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) (G := E)
    simp [hEcard]
  let C : Subgroup Q := Subgroup.centralizer (E : Set Q)
  have hCchar : C.Characteristic := by
    dsimp [C]
    infer_instance
  let : C.Characteristic := hCchar
  have hE_le_C : E ≤ C := by
    intro x hx
    rw [show C = Subgroup.centralizer (E : Set Q) by rfl,
      Subgroup.mem_centralizer_iff]
    intro y hy
    let xE : E := ⟨x, hx⟩
    let yE : E := ⟨y, hy⟩
    let : IsMulCommutative E := hEcomm
    exact congrArg Subtype.val
      ((IsMulCommutative.is_comm (M := E)).comm yE xE)
  let qE : Q →* Q ⧸ E := QuotientGroup.mk' E
  let Cbar : Subgroup (Q ⧸ E) := C.map qE
  have hCbar3 : IsPGroup 3 Cbar := hQquotE3.to_subgroup Cbar
  have hCnil : Group.IsNilpotent C := by
    let f : C →* Cbar :=
      (qE.comp C.subtype).codRestrict Cbar (by
        intro x
        exact Subgroup.mem_map_of_mem qE x.property)
    have hfker : f.ker ≤ Subgroup.center C := by
      intro x hx
      have hxq : qE ((x : C) : Q) = 1 := by
        have hfx : f x = 1 := MonoidHom.mem_ker.mp hx
        simpa [f] using congrArg Subtype.val hfx
      have hxE : ((x : C) : Q) ∈ E := by
        exact (QuotientGroup.eq_one_iff (N := E) (x := ((x : C) : Q))).1 hxq
      refine Subgroup.mem_center_iff.2 ?_
      intro y
      apply Subtype.ext
      have hycent := (Subgroup.mem_centralizer_iff.mp y.property)
        ((x : C) : Q) hxE
      exact hycent.symm
    let : Group.IsNilpotent Cbar := hCbar3.isNilpotent
    exact Subgroup.isNilpotent_of_ker_le_center f hfker
  let phi : Q →* MulAut E := MulAut.conjNormal (H := E)
  have hphiKer : phi.ker = C := by
    simpa [phi, C] using conjNormal_ker_eq_centralizer (H := E)
  have hQquotC3 : IsPGroup 3 (Q ⧸ C) := by
    let CbarE : Subgroup (Q ⧸ E) := C.map qE
    have hquotbar : IsPGroup 3 ((Q ⧸ E) ⧸ CbarE) :=
      hQquotE3.to_quotient CbarE
    let eQC : (Q ⧸ E) ⧸ CbarE ≃* Q ⧸ C := by
      simpa [qE, CbarE] using
        (QuotientGroup.quotientQuotientEquivQuotient
          (N := E) (M := C) hE_le_C)
    exact hquotbar.of_equiv eQC
  have hRange3 : IsPGroup 3 phi.range := by
    let eKer : Q ⧸ C ≃* Q ⧸ phi.ker :=
      QuotientGroup.quotientMulEquivOfEq hphiKer.symm
    let eRange : Q ⧸ phi.ker ≃* phi.range :=
      QuotientGroup.quotientKerEquivRange phi
    exact hQquotC3.of_equiv (eKer.trans eRange)
  have hC_ne_top : C ≠ ⊤ := by
    intro hCtop
    have hEcenter : E ≤ Subgroup.center Q := by
      intro x hx
      refine Subgroup.mem_center_iff.2 ?_
      intro y
      have hyC : y ∈ C := by rw [hCtop]; simp
      have hycent := (Subgroup.mem_centralizer_iff.mp hyC) x hx
      exact hycent.symm
    have hQnil : Group.IsNilpotent Q := by
      let : Group.IsNilpotent (Q ⧸ E) := hQquotE3.isNilpotent
      apply Subgroup.isNilpotent_of_ker_le_center qE
      rw [show qE.ker = E by
        simp [qE, QuotientGroup.ker_mk' E]]
      exact hEcenter
    have hcompTwoQ : HasNormalPComplement 2 Q :=
      hkt_hasNormalPComplement_of_nilpotent (p := 2) hQnil
    rcases hcompTwoQ with ⟨Nbar, hNbarNormal, hNbarCop, hQNbar2⟩
    let N : Subgroup G := Nbar.comap qM
    have hNnormal : N.Normal := by
      dsimp [N]
      exact Subgroup.Normal.comap hNbarNormal qM
    have hM_le_N : M ≤ N := by
      intro x hx
      change qM x ∈ Nbar
      have hxq : qM x = 1 :=
        (QuotientGroup.eq_one_iff (N := M) (x := x)).2 hx
      simp [hxq]
    have hNmap : N.map qM = Nbar := by
      simpa [N] using
        (Subgroup.map_comap_eq_self_of_surjective
          (f := qM) (QuotientGroup.mk'_surjective M) Nbar)
    let eN0 : Q ⧸ N.map qM ≃* G ⧸ N := by
      simpa [Q, qM] using
        (QuotientGroup.quotientQuotientEquivQuotient
          (N := M) (M := N) hM_le_N)
    let eN : Q ⧸ Nbar ≃* G ⧸ N :=
      (QuotientGroup.quotientMulEquivOfEq hNmap.symm).trans eN0
    have hGN2 : IsPGroup 2 (G ⧸ N) :=
      hQNbar2.of_equiv eN
    have hres_le : hktPResidual 2 G ≤ N :=
      hktPResidual_le N hNnormal hGN2
    have hNtop : N = ⊤ :=
      le_antisymm le_top (by
        rw [hres.symm]
        exact hres_le)
    have hNbarTop : Nbar = ⊤ := by
      apply Subgroup.comap_injective (QuotientGroup.mk'_surjective M)
      simp [N, qM, hNtop]
    have htwoQ : 2 ∣ Nat.card Q := by
      have htwoE : 2 ∣ Nat.card E := by rw [hEcard]; norm_num
      exact htwoE.trans (Subgroup.card_subgroup_dvd_card E)
    have hnotTwoQ : ¬ 2 ∣ Nat.card Q := by
      have hcopTop : Nat.Coprime 2 (Nat.card Q) := by
        simpa [hNbarTop] using hNbarCop
      exact (Nat.prime_two.coprime_iff_not_dvd).1 hcopTop
    exact hnotTwoQ htwoQ
  have hRangeNeBot : phi.range ≠ ⊥ := by
    intro hRangeBot
    apply hC_ne_top
    rw [← hphiKer]
    apply top_unique
    intro x _
    rw [MonoidHom.mem_ker]
    have hxrange : phi x ∈ phi.range := ⟨x, rfl⟩
    rw [hRangeBot] at hxrange
    exact hxrange
  have hRangeCard : Nat.card phi.range = 3 := by
    obtain ⟨a, ha⟩ := hRange3.exists_card_eq
    have ha_pos : 0 < a := by
      by_contra ha0
      have : a = 0 := by omega
      subst a
      have hcardOne : Nat.card phi.range = 1 := by simpa using ha
      exact hRangeNeBot ((Subgroup.card_eq_one (H := phi.range)).1 hcardOne)
    have hdiv6 : Nat.card phi.range ∣ 6 :=
      (Subgroup.card_subgroup_dvd_card phi.range).trans
        (mulAut_card_dvd_six_of_card_eq_four hEcard)
    rw [ha] at hdiv6
    have ha_le_one : a ≤ 1 := by
      by_contra h
      have htwo_le : 2 ≤ a := by omega
      have h9div : 3 ^ 2 ∣ 3 ^ a := Nat.pow_dvd_pow 3 htwo_le
      have hbad : 9 ∣ 6 := h9div.trans hdiv6
      norm_num at hbad
    have ha_eq : a = 1 := by omega
    simpa [ha_eq] using ha
  have hCindex : C.index = 3 := by
    rw [← hphiKer]
    exact (Subgroup.index_ker phi).trans hRangeCard
  let : Group.IsNilpotent C := hCnil
  let S : Sylow 3 C := default
  have hSnormal : ((S : Sylow 3 C) : Subgroup C).Normal :=
    Group.IsNilpotent.sylow_normal hCnil 3 S
  have hSchar : ((S : Sylow 3 C) : Subgroup C).Characteristic :=
    Sylow.characteristic_of_normal S hSnormal
  let : ((S : Sylow 3 C) : Subgroup C).Characteristic := hSchar
  let EC : Subgroup C := E.subgroupOf C
  have hECnormal : EC.Normal := by
    dsimp [EC]
    exact Subgroup.Normal.subgroupOf (inferInstance : E.Normal) C
  let : EC.Normal := hECnormal
  have hECcard : Nat.card EC = 4 := by
    let eEC : EC ≃* E := Subgroup.subgroupOfEquivOfLe hE_le_C
    calc
      Nat.card EC = Nat.card E := Nat.card_congr eEC.toEquiv
      _ = 4 := hEcard
  have hCquotEC3 : IsPGroup 3 (C ⧸ EC) := by
    let eCE : C ⧸ EC ≃* Cbar := by
      simpa [EC, Cbar, qE] using quotientSubgroupRangeEquiv C E
    exact hCbar3.of_equiv eCE.symm
  have hECcop : Nat.Coprime 3 (Nat.card EC) := by rw [hECcard]; norm_num
  have hcompC : HasNormalPComplement 3 C :=
    ⟨EC, hECnormal, hECcop, hCquotEC3⟩
  have hECeqCore : EC = pPrimeCore 3 C :=
    normalPComplement_eq_pPrimeCore EC hECcop hCquotEC3
  have hquotCardS : Nat.card (C ⧸ EC) = Nat.card S := by
    let eCS : C ⧸ pPrimeCore 3 C ≃* S :=
      quotientPPrimeCoreEquivSylowOfHasNormalPComplement hcompC S
    let eECcore : C ⧸ EC ≃* C ⧸ pPrimeCore 3 C :=
      QuotientGroup.quotientMulEquivOfEq hECeqCore
    exact Nat.card_congr (eECcore.trans eCS).toEquiv
  have hSindex : (S : Subgroup C).index = 4 := by
    apply Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := S))
    calc
      Nat.card S * (S : Subgroup C).index = Nat.card C := S.card_mul_index
      _ = Nat.card (C ⧸ EC) * Nat.card EC :=
        (Subgroup.card_eq_card_quotient_mul_card_subgroup (α := C) (s := EC))
      _ = Nat.card S * 4 := by rw [hquotCardS, hECcard]
  let S_Q : Subgroup Q := (S : Subgroup C).map C.subtype
  have hSQchar : S_Q.Characteristic := by
    simpa [S_Q] using
      characteristic_map_subtype_of_characteristic (G := Q) C (S : Subgroup C)
  let : S_Q.Characteristic := hSQchar
  have hSQindex : S_Q.index = 12 := by
    rw [show S_Q.index = (S : Subgroup C).index * C.index by
      simpa [S_Q] using Subgroup.index_map_subtype (K := (S : Subgroup C))]
    rw [hSindex, hCindex]
  let Z : Subgroup G := S_Q.comap qM
  have hZchar : Z.Characteristic := by
    simpa [Z, qM, Q] using
      (Subgroup.Characteristic.comap_quotient_mk
        (H := M) (K := S_Q) hSQchar)
  have hZindex : Z.index = 12 := by
    rw [show Z.index = S_Q.index by
      simpa [Z, qM] using
        (Subgroup.index_comap_of_surjective
          (H := S_Q) (f := qM) (QuotientGroup.mk'_surjective M))]
    exact hSQindex
  exact ⟨Z, hZchar, hZindex⟩

