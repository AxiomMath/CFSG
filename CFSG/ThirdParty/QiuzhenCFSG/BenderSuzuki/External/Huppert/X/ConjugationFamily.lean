/-!
# Huppert X.4: conjugation families

This file formalizes the part of Huppert X.4.1--4.8 needed by the
Alperin--Goldschmidt application in `[II1; 4.4]`.  We use the source's right
conjugation convention `A^g = g⁻¹ A g` and record an exact product of
normalizer steps.
-/

noncomputable section

namespace CFSG.BenderSuzuki
namespace External

open PFchapter1section1 PFAppendixIII
open scoped Pointwise

universe u

/-- A subgroup `U ≤ P` is extremal in the Sylow subgroup `P` when
`N_P(U)` has the full `p`-part of `N_G(U)`. -/
@[expose] public def HuppertExtremal
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) (U : Subgroup G) : Prop :=
  U ≤ (P : Subgroup G) ∧
    (Nat.card ↥((P : Subgroup G) ⊓
      Subgroup.normalizer (U : Set G))).factorization p =
      (Nat.card (Subgroup.normalizer (U : Set G))).factorization p

/-- An exact conjugation-family decomposition.  If the current conjugate of
`A` lies in `U`, one may append an element of `N_G(U)`. -/
public inductive HuppertConjugationDecomposition
    {G : Type u} [Group G]
    (P : Subgroup G) (family : Subgroup G → Prop)
    (A : Subgroup G) : G → Prop
  | one : HuppertConjugationDecomposition P family A 1
  | tail {g h : G} {U : Subgroup G} :
      HuppertConjugationDecomposition P family A g →
      family U → U ≤ P → rightConjugate A g ≤ U →
      h ∈ Subgroup.normalizer (U : Set G) →
      HuppertConjugationDecomposition P family A (g * h)

/-- The refined conjugation-family decomposition from Huppert X.4.7.  Each
normalizer step either occurs at a self-centralizing subgroup of the fixed
Sylow subgroup, or its conjugator centralizes the subgroup. -/
public inductive HuppertCentricConjugationDecomposition
    {G : Type u} [Group G]
    (P : Subgroup G) (family : Subgroup G → Prop)
    (A : Subgroup G) : G → Prop
  | one : HuppertCentricConjugationDecomposition P family A 1
  | tail {g h : G} {U : Subgroup G} :
      HuppertCentricConjugationDecomposition P family A g →
      family U → U ≤ P → rightConjugate A g ≤ U →
      h ∈ Subgroup.normalizer (U : Set G) →
      (subgroupCentralizerIn P U ≤ U ∨
        h ∈ Subgroup.centralizer (U : Set G)) →
      HuppertCentricConjugationDecomposition P family A (g * h)

/-- Huppert's adjacency relation on `S(A)`: after pulling the fixed Sylow
subgroup back by two conjugators, their intersection is strictly larger than
`A`. -/
@[expose] public def HuppertAdjacent
    {G : Type u} [Group G] (P A : Subgroup G) (a b : G) : Prop :=
  rightConjugate A a ≤ P ∧ rightConjugate A b ≤ P ∧
    A < P.conjBy a ⊓ P.conjBy b

/-- The equivalence relation generated by Huppert adjacency. -/
@[expose] public def HuppertRelated
    {G : Type u} [Group G] (P A : Subgroup G) (a b : G) : Prop :=
  Relation.ReflTransGen (HuppertAdjacent P A) a b

private theorem rightConjugate_rightConjugate
    {G : Type u} [Group G] (H : Subgroup G) (a b : G) :
    rightConjugate (rightConjugate H a) b =
      rightConjugate H (a * b) := by
  simp [rightConjugate, Subgroup.conjBy_conjBy, mul_inv_rev]

private theorem rightConjugate_one
    {G : Type u} [Group G] (H : Subgroup G) :
    rightConjugate H 1 = H := by
  simp [rightConjugate, Subgroup.conjBy_one]

private theorem rightConjugate_le_iff
    {G : Type u} [Group G] {H K : Subgroup G} {g : G} :
    rightConjugate H g ≤ K ↔ H ≤ K.conjBy g := by
  constructor
  · intro h x hx
    refine Subgroup.mem_map.mpr ⟨g⁻¹ * x * g, h ?_, by simp [mul_assoc]⟩
    exact Subgroup.mem_map.mpr ⟨x, hx, by simp⟩
  · intro h x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    rcases Subgroup.mem_map.mp (h hy) with ⟨z, hz, hzy⟩
    have hyEq : g * z * g⁻¹ = y := by
      simpa [MulAut.conj_apply] using hzy
    simpa [MulAut.conj_apply, ← hyEq, mul_assoc] using hz

private theorem conjBy_eq_self_of_mem_normalizer
    {G : Type u} [Group G] {H : Subgroup G} {g : G}
    (hg : g ∈ Subgroup.normalizer (H : Set G)) :
    H.conjBy g = H := by
  apply le_antisymm
  · intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    exact (Subgroup.mem_normalizer_iff.mp hg y).1 hy
  · intro x hx
    have hginv : g⁻¹ ∈ Subgroup.normalizer (H : Set G) :=
      (Subgroup.normalizer (H : Set G)).inv_mem hg
    refine Subgroup.mem_map.mpr ⟨g⁻¹ * x * g, ?_, by simp [mul_assoc]⟩
    simpa only [inv_inv] using
      (Subgroup.mem_normalizer_iff.mp hginv x).1 hx

private theorem rightConjugate_eq_self_of_mem_normalizer
    {G : Type u} [Group G] {H : Subgroup G} {g : G}
    (hg : g ∈ Subgroup.normalizer (H : Set G)) :
    rightConjugate H g = H := by
  exact conjBy_eq_self_of_mem_normalizer
    ((Subgroup.normalizer (H : Set G)).inv_mem hg)

private theorem normalizer_conjBy
    {G : Type u} [Group G] (H : Subgroup G) (g : G) :
    Subgroup.normalizer (H.conjBy g : Set G) =
      (Subgroup.normalizer (H : Set G)).conjBy g := by
  simpa [Subgroup.conjBy] using
    (Subgroup.map_normalizer_eq_of_bijective H
      (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).bijective).symm

private theorem centralizer_conjBy
    {G : Type u} [Group G] (H : Subgroup G) (g : G) :
    (Subgroup.centralizer (H : Set G)).conjBy g =
      Subgroup.centralizer (H.conjBy g : Set G) := by
  ext x
  constructor
  · intro hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    rw [Subgroup.mem_centralizer_iff] at hy ⊢
    intro z hz
    rcases Subgroup.mem_map.mp hz with ⟨w, hw, rfl⟩
    have hcomm := hy w hw
    have := congrArg (fun t : G ↦ g * t * g⁻¹) hcomm
    simpa [mul_assoc] using this
  · intro hx
    refine Subgroup.mem_map.mpr ⟨g⁻¹ * x * g, ?_, by
      simp [MulAut.conj_apply, mul_assoc]⟩
    rw [Subgroup.mem_centralizer_iff] at hx ⊢
    intro y hy
    have hyg : g * y * g⁻¹ ∈ H.conjBy g :=
      Subgroup.mem_map.mpr ⟨y, hy, by simp [MulAut.conj_apply, mul_assoc]⟩
    have hcomm := hx (g * y * g⁻¹) hyg
    have := congrArg (fun t : G ↦ g⁻¹ * t * g) hcomm
    simpa [mul_assoc] using this

private theorem mem_normalizer_of_conjBy_eq
    {G : Type u} [Group G] {H : Subgroup G} {g : G}
    (hg : H.conjBy g = H) :
    g ∈ Subgroup.normalizer (H : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    have hx' : g * x * g⁻¹ ∈ H.conjBy g := by
      exact Subgroup.mem_map.mpr ⟨x, hx, by simp [MulAut.conj_apply, mul_assoc]⟩
    simpa [hg] using hx'
  · intro hx
    have hx' : g * x * g⁻¹ ∈ H.conjBy g := by simpa [hg] using hx
    rcases Subgroup.mem_map.mp hx' with ⟨y, hy, hyx⟩
    have hxy : x = y := by
      calc
        x = g⁻¹ * (g * x * g⁻¹) * g := by group
        _ = g⁻¹ * (g * y * g⁻¹) * g := by
          rw [show g * y * g⁻¹ = g * x * g⁻¹ by
            simpa [MulAut.conj_apply] using hyx]
        _ = y := by simp [mul_assoc]
    simpa [hxy] using hy

private theorem normalizer_le_normalizer_sup_centralizer
    {G : Type u} [Group G] (U : Subgroup G) :
    Subgroup.normalizer (U : Set G) ≤
      Subgroup.normalizer
        ((U ⊔ Subgroup.centralizer (U : Set G) : Subgroup G) : Set G) := by
  intro n hn
  have hnU : U.conjBy n = U := conjBy_eq_self_of_mem_normalizer hn
  have hnC : (Subgroup.centralizer (U : Set G)).conjBy n =
      Subgroup.centralizer (U : Set G) := by
    rw [centralizer_conjBy, hnU]
  apply mem_normalizer_of_conjBy_eq
  rw [Subgroup.conjBy,
    Subgroup.map_sup U (Subgroup.centralizer (U : Set G))
      (MulAut.conj n).toMonoidHom]
  change U.conjBy n ⊔ (Subgroup.centralizer (U : Set G)).conjBy n =
    U ⊔ Subgroup.centralizer (U : Set G)
  rw [hnU, hnC]

private theorem huppertExtremal_sylow
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) : HuppertExtremal P (P : Subgroup G) := by
  refine ⟨le_rfl, ?_⟩
  rw [inf_eq_left.mpr Subgroup.le_normalizer]
  have hPfac : (Nat.card (P : Subgroup G)).factorization p =
      (Nat.card G).factorization p := by
    rw [P.card_eq_multiplicity, Nat.factorization_pow_self Fact.out]
  have hfacLe :
      (Nat.card (Subgroup.normalizer ((P : Subgroup G) : Set G))).factorization p ≤
        (Nat.card G).factorization p :=
    by
      have hdvd : Nat.card (Subgroup.normalizer ((P : Subgroup G) : Set G)) ∣
          Nat.card G := by
        simpa using (Subgroup.card_dvd_of_le
          (H := Subgroup.normalizer ((P : Subgroup G) : Set G))
          (K := (⊤ : Subgroup G)) (α := G) le_top)
      exact Nat.factorization_le_factorization_of_dvd_right
        hdvd Nat.card_pos.ne' Nat.card_pos.ne'
  have hfacGe : (Nat.card G).factorization p ≤
      (Nat.card (Subgroup.normalizer ((P : Subgroup G) : Set G))).factorization p := by
    rw [← hPfac]
    exact Nat.factorization_le_factorization_of_dvd_right
      (Subgroup.card_dvd_of_le (Subgroup.le_normalizer :
        (P : Subgroup G) ≤ Subgroup.normalizer ((P : Subgroup G) : Set G)))
      Nat.card_pos.ne' Nat.card_pos.ne'
  rw [hPfac]
  exact le_antisymm hfacGe hfacLe

private theorem HuppertExtremal.exists_sylow_normalizer
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {P : Sylow p G} {U : Subgroup G} (hU : HuppertExtremal P U) :
    ∃ Q : Sylow p (Subgroup.normalizer (U : Set G)),
      (Q : Subgroup (Subgroup.normalizer (U : Set G))).map
          (Subgroup.normalizer (U : Set G)).subtype =
        (P : Subgroup G) ⊓ Subgroup.normalizer (U : Set G) := by
  let N : Subgroup G := Subgroup.normalizer (U : Set G)
  let NP : Subgroup G := (P : Subgroup G) ⊓ N
  let NPN : Subgroup N := NP.subgroupOf N
  have hNPp : IsPGroup p NP := IsPGroup.to_le P.isPGroup' inf_le_left
  have hNPNp : IsPGroup p NPN :=
    hNPp.of_equiv (Subgroup.subgroupOfEquivOfLe
      (by simp [NP, N])).symm
  have hNPNcard : Nat.card NPN = p ^ (Nat.card N).factorization p := by
    calc
      Nat.card NPN = Nat.card NP := by
        dsimp [NPN]
        rw [natCard_subgroupOf_eq NP N (by simp [NP, N])]
      _ = p ^ (Nat.card NP).factorization p :=
        section8_card_eq_prime_pow_factorization_of_isPGroup hNPp
      _ = p ^ (Nat.card N).factorization p := by
        rw [show (Nat.card NP).factorization p =
            (Nat.card N).factorization p by simpa [NP, N] using hU.2]
  let Q : Sylow p N := Sylow.ofCard NPN hNPNcard
  refine ⟨Q, ?_⟩
  change NPN.map N.subtype = NP
  exact Subgroup.map_subgroupOf_eq_of_le (by
    simp [NP, N])

/-- The Sylow subgroup of `U C_G(U)` cut out by the fixed Sylow subgroup
`P`.  This is the Sylow-intersection step in Huppert X.4.7. -/
private theorem HuppertExtremal.exists_sylow_sup_centralizer
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {P : Sylow p G} {U : Subgroup G} (hU : HuppertExtremal P U) :
    ∃ S : Sylow p ↥(U ⊔ Subgroup.centralizer (U : Set G) : Subgroup G),
      (S : Subgroup ↥(U ⊔ Subgroup.centralizer (U : Set G) : Subgroup G)).map
          (U ⊔ Subgroup.centralizer (U : Set G)).subtype =
        U ⊔ subgroupCentralizerIn (P : Subgroup G) U := by
  classical
  let C : Subgroup G := Subgroup.centralizer (U : Set G)
  let N : Subgroup G := Subgroup.normalizer (U : Set G)
  let K : Subgroup G := U ⊔ C
  let L : Subgroup G := U ⊔ subgroupCentralizerIn (P : Subgroup G) U
  have hKN : K ≤ N := by
    exact sup_le Subgroup.le_normalizer (by
      simpa [C, N] using (centralizer_le_normalizer U))
  have hNKnorm : N ≤ Subgroup.normalizer (K : Set G) := by
    simpa [K, C, N] using normalizer_le_normalizer_sup_centralizer U
  let KN : Subgroup N := K.subgroupOf N
  let : KN.Normal := by
    simpa [KN] using Subgroup.normal_subgroupOf_of_le_normalizer hNKnorm
  obtain ⟨PN, hPN⟩ := hU.exists_sylow_normalizer
  let Q : Sylow p KN := hallSylowSubgroupOfNormal PN KN
  let e : KN ≃* K := Subgroup.subgroupOfEquivOfLe hKN
  let S : Sylow p K := Q.mapSurjective (f := e.toMonoidHom) e.surjective
  have hL : L = (P : Subgroup G) ⊓ K := by
    apply le_antisymm
    · exact sup_le (le_inf hU.1 le_sup_left)
        (le_inf inf_le_left (inf_le_right.trans le_sup_right))
    · intro x hx
      have hUcentC : U ≤ Subgroup.centralizer (C : Set G) := by
        intro y hy
        rw [Subgroup.mem_centralizer_iff]
        intro z hz
        exact (Subgroup.mem_centralizer_iff.mp hz y hy).symm
      have hUnormC : U ≤ Subgroup.normalizer (C : Set G) :=
        hUcentC.trans (centralizer_le_normalizer C)
      have hxprod : x ∈ (U : Set G) * (C : Set G) := by
        rw [← Subgroup.coe_mul_of_left_le_normalizer_right U C hUnormC]
        exact hx.2
      rcases hxprod with ⟨y, hyU, z, hzC, rfl⟩
      refine (U ⊔ subgroupCentralizerIn (P : Subgroup G) U).mul_mem
        (Subgroup.mem_sup_left hyU) (Subgroup.mem_sup_right ?_)
      refine ⟨?_, hzC⟩
      have hyP : y ∈ (P : Subgroup G) := hU.1 hyU
      change z ∈ (P : Subgroup G)
      simpa [mul_assoc] using
        ((P : Subgroup G).mul_mem ((P : Subgroup G).inv_mem hyP) hx.1)
  have hQmapN :
      (Q : Subgroup KN).map KN.subtype =
        KN ⊓ (PN : Subgroup N) := by
    rw [show (Q : Subgroup KN) =
        (PN : Subgroup N).comap KN.subtype by
      exact hallSylowSubgroupOfNormal_coe PN KN]
    rw [Subgroup.comap_subtype, Subgroup.subgroupOf_map_subtype]
    exact inf_comm _ _
  refine ⟨S, ?_⟩
  change (S : Subgroup K).map K.subtype = L
  rw [hL]
  change ((Q : Subgroup KN).map e.toMonoidHom).map K.subtype =
    (P : Subgroup G) ⊓ K
  rw [Subgroup.map_map]
  change (Q : Subgroup KN).map (N.subtype.comp KN.subtype) =
    (P : Subgroup G) ⊓ K
  rw [← Subgroup.map_map, hQmapN]
  rw [Subgroup.map_inf_eq KN (PN : Subgroup N) N.subtype
    N.subtype_injective]
  rw [Subgroup.map_subgroupOf_eq_of_le hKN, hPN]
  simp only [inf_left_comm]
  rw [inf_eq_left.mpr hKN]

set_option backward.isDefEq.respectTransparency false in
/-- A normalizer element of an extremal subgroup can be corrected by an
ambient centralizer element so that it normalizes `U C_P(U)`.  This is the
local Sylow-conjugacy calculation in Huppert X.4.7. -/
private theorem HuppertExtremal.exists_centralizer_adjustment
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {P : Sylow p G} {U : Subgroup G} (hU : HuppertExtremal P U)
    {h : G} (hh : h ∈ Subgroup.normalizer (U : Set G)) :
    ∃ z : G, z ∈ Subgroup.centralizer (U : Set G) ∧
      rightConjugate
          (U ⊔ subgroupCentralizerIn (P : Subgroup G) U) (h * z⁻¹) =
        U ⊔ subgroupCentralizerIn (P : Subgroup G) U := by
  classical
  let C : Subgroup G := Subgroup.centralizer (U : Set G)
  let K : Subgroup G := U ⊔ C
  let L : Subgroup G := U ⊔ subgroupCentralizerIn (P : Subgroup G) U
  have hKnorm : h ∈ Subgroup.normalizer (K : Set G) := by
    exact normalizer_le_normalizer_sup_centralizer U hh
  have hLK : L ≤ K := by
    exact sup_le le_sup_left (inf_le_right.trans le_sup_right)
  obtain ⟨S, hSmap⟩ := hU.exists_sylow_sup_centralizer
  change (S : Subgroup K).map K.subtype = L at hSmap
  have hLhK : rightConjugate L h ≤ K := by
    exact (Subgroup.map_mono hLK).trans_eq
      (rightConjugate_eq_self_of_mem_normalizer hKnorm)
  let LhK : Subgroup K := (rightConjugate L h).subgroupOf K
  have hcardLS : Nat.card L = Nat.card (S : Subgroup K) := by
    rw [← hSmap]
    exact Subgroup.card_map_of_injective (K := (S : Subgroup K))
      (f := K.subtype) K.subtype_injective
  have hcardLhK : Nat.card LhK = p ^ (Nat.card K).factorization p := by
    calc
      Nat.card LhK = Nat.card (rightConjugate L h) := by
        simpa [LhK] using natCard_subgroupOf_eq
          (rightConjugate L h) K hLhK
      _ = Nat.card L := by
        simpa [rightConjugate, Subgroup.conjBy] using
          (Subgroup.card_map_of_injective (K := L)
            (f := (MulAut.conj h⁻¹).toMonoidHom)
            (MulAut.conj h⁻¹).injective)
      _ = Nat.card (S : Subgroup K) := hcardLS
      _ = p ^ (Nat.card K).factorization p := S.card_eq_multiplicity
  let Sh : Sylow p K := Sylow.ofCard LhK hcardLhK
  obtain ⟨x, hx⟩ := MulAction.exists_smul_eq K S Sh
  have hxSub : MulAut.conj x • (S : Subgroup K) = LhK := by
    have hx' := congrArg (fun T : Sylow p K ↦ (T : Subgroup K)) hx
    rw [Sylow.coe_subgroup_smul] at hx'
    exact hx'
  have hxConj : L.conjBy (x : G) = rightConjugate L h := by
    calc
      L.conjBy (x : G) =
          (MulAut.conj x • (S : Subgroup K)).map K.subtype := by
        rw [Subgroup.conjBy, ← hSmap, Subgroup.pointwise_smul_def,
          Subgroup.map_map, Subgroup.map_map]
        rfl
      _ = LhK.map K.subtype := by rw [hxSub]
      _ = rightConjugate L h :=
        Subgroup.map_subgroupOf_eq_of_le hLhK
  let w : G := (x : G)⁻¹
  have hwK : w ∈ K := K.inv_mem x.property
  have hLhW : rightConjugate L h = rightConjugate L w := by
    simpa [w, rightConjugate] using hxConj.symm
  have hUcentC : U ≤ Subgroup.centralizer (C : Set G) := by
    intro y hy
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    exact (Subgroup.mem_centralizer_iff.mp hz y hy).symm
  have hUnormC : U ≤ Subgroup.normalizer (C : Set G) :=
    hUcentC.trans (centralizer_le_normalizer C)
  have hwprod : w ∈ (U : Set G) * (C : Set G) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right U C hUnormC]
    exact hwK
  rcases hwprod with ⟨y, hyU, z, hzC, hyz⟩
  have hyL : y ∈ L := Subgroup.mem_sup_left hyU
  have hyNorm : y ∈ Subgroup.normalizer (L : Set G) :=
    Subgroup.le_normalizer hyL
  have hLwz : rightConjugate L w = rightConjugate L z := by
    rw [← hyz, ← rightConjugate_rightConjugate,
      rightConjugate_eq_self_of_mem_normalizer hyNorm]
  refine ⟨z, hzC, ?_⟩
  rw [← rightConjugate_rightConjugate, hLhW, hLwz,
    rightConjugate_rightConjugate]
  rw [mul_inv_cancel, rightConjugate_one]

private theorem natCard_conjBy_eq
    {G : Type u} [Group G] [Finite G] (H : Subgroup G) (g : G) :
    Nat.card (H.conjBy g) = Nat.card H := by
  simpa [Subgroup.conjBy] using
    Subgroup.card_map_of_injective (K := H)
      (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective

private theorem exists_larger_normalizer_pSubgroup
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {P R : Subgroup G} (hRp : IsPGroup p R) (hPR : P < R) :
    ∃ R₁ : Subgroup G,
      IsPGroup p R₁ ∧ P < R₁ ∧ R₁ ≤ R ∧
        R₁ ≤ Subgroup.normalizer (P : Set G) := by
  classical
  let PR : Subgroup R := P.subgroupOf R
  have hPRtop : PR < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro htop
    apply (not_le_of_gt hPR)
    intro x hxR
    let xR : R := ⟨x, hxR⟩
    have hxPR : xR ∈ PR := by rw [htop]; trivial
    exact hxPR
  let : Group.IsNilpotent R := hRp.isNilpotent
  have hPRnorm : PR < Subgroup.normalizer (PR : Set R) :=
    Group.normalizerCondition_of_isNilpotent PR hPRtop
  let NR : Subgroup R := Subgroup.normalizer (PR : Set R)
  let R₁ : Subgroup G := NR.map R.subtype
  have hPR₁ : P ≤ R₁ := by
    intro x hxP
    let xR : R := ⟨x, hPR.le hxP⟩
    apply Subgroup.mem_map.mpr
    refine ⟨xR, ?_, rfl⟩
    exact Subgroup.le_normalizer (show xR ∈ PR from hxP)
  have hR₁R : R₁ ≤ R := by
    simpa [R₁] using Subgroup.map_le_range R.subtype NR
  have hR₁norm : R₁ ≤ Subgroup.normalizer (P : Set G) := by
    have hmap := Subgroup.le_normalizer_map (H := PR) R.subtype
    simpa [R₁, NR, PR, Subgroup.subgroupOf_map_subtype,
      inf_eq_left.mpr hPR.le] using hmap
  have hR₁p : IsPGroup p R₁ := (hRp.to_subgroup NR).map R.subtype
  have hPR₁lt : P < R₁ := by
    apply lt_of_le_of_ne hPR₁
    intro hPR₁eq
    obtain ⟨y, hyNR, hyPR⟩ := SetLike.exists_of_lt hPRnorm
    apply hyPR
    have hyR₁ : (y : G) ∈ R₁ :=
      Subgroup.mem_map.mpr ⟨y, hyNR, rfl⟩
    rw [← hPR₁eq] at hyR₁
    exact hyR₁
  exact ⟨R₁, hR₁p, hPR₁lt, hR₁R, hR₁norm⟩

public theorem HuppertAdjacent.symmetric
    {G : Type u} [Group G] {P A : Subgroup G} :
    ∀ a b : G, HuppertAdjacent P A a b → HuppertAdjacent P A b a := by
  intro a b h
  exact ⟨h.2.1, h.1, by simpa [inf_comm] using h.2.2⟩

public theorem HuppertRelated.symmetric
    {G : Type u} [Group G] {P A : Subgroup G} :
    ∀ a b : G, HuppertRelated P A a b → HuppertRelated P A b a := by
  let : Std.Symm (HuppertAdjacent P A) := ⟨HuppertAdjacent.symmetric⟩
  let : Std.Symm (HuppertRelated P A) := Relation.ReflTransGen.stdSymm
  exact fun a b h ↦ Std.Symm.symm a b h

private theorem HuppertAdjacent.mul_left_of_mem_normalizer
    {G : Type u} [Group G] {P A : Subgroup G} {a b c : G}
    (hc : c ∈ Subgroup.normalizer (A : Set G))
    (hab : HuppertAdjacent P A a b) :
    HuppertAdjacent P A (c * a) (c * b) := by
  have hAc : rightConjugate A c = A :=
    rightConjugate_eq_self_of_mem_normalizer hc
  have hAconj : A.conjBy c = A :=
    conjBy_eq_self_of_mem_normalizer hc
  refine ⟨?_, ?_, ?_⟩
  · rw [← rightConjugate_rightConjugate, hAc]
    exact hab.1
  · rw [← rightConjugate_rightConjugate, hAc]
    exact hab.2.1
  · have hlt :=
      (Subgroup.map_lt_map_iff_of_injective
        (f := (MulAut.conj c).toMonoidHom)
        (MulAut.conj c).injective).2 hab.2.2
    have hinf := Subgroup.map_inf_eq
      (P.conjBy a) (P.conjBy b)
      (MulAut.conj c).toMonoidHom (MulAut.conj c).injective
    change (P.conjBy a ⊓ P.conjBy b).conjBy c =
      (P.conjBy a).conjBy c ⊓ (P.conjBy b).conjBy c at hinf
    change A.conjBy c < (P.conjBy a ⊓ P.conjBy b).conjBy c at hlt
    rw [hAconj, hinf] at hlt
    simpa only [Subgroup.conjBy_mul] using hlt

public theorem HuppertRelated.mul_left_of_mem_normalizer
    {G : Type u} [Group G] {P A : Subgroup G} {a b c : G}
    (hc : c ∈ Subgroup.normalizer (A : Set G))
    (hab : HuppertRelated P A a b) :
    HuppertRelated P A (c * a) (c * b) :=
  hab.lift (fun x => c * x)
    (fun _ _ h => HuppertAdjacent.mul_left_of_mem_normalizer hc h)

private theorem exists_extremal_representative
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) {A : Subgroup G} (hAP : A < (P : Subgroup G))
    {a : G} (ha : rightConjugate A a ≤ (P : Subgroup G)) :
    ∃ b c : G,
      HuppertExtremal P (rightConjugate A b) ∧
      HuppertRelated (P : Subgroup G) A a b ∧
      HuppertRelated (P : Subgroup G) A b c ∧
      c ∈ Subgroup.normalizer (A : Set G) := by
  classical
  let B : Subgroup G := P.toSubgroup.conjBy a
  have hAB : A ≤ B := by
    exact rightConjugate_le_iff.mp ha
  have hABlt : A < B := by
    apply lt_of_le_of_ne hAB
    intro hEq
    have hcardA : Nat.card A = Nat.card (P : Subgroup G) := by
      calc
        Nat.card A = Nat.card B := by rw [hEq]
        _ = Nat.card (P : Subgroup G) := natCard_conjBy_eq P.toSubgroup a
    exact (ne_of_lt (natCard_lt_of_subgroup_lt hAP)) hcardA
  have hBp : IsPGroup p B := by
    change IsPGroup p
      ((P : Subgroup G).map (MulAut.conj a).toMonoidHom)
    exact IsPGroup.map (p := p) (H := (P : Subgroup G)) P.isPGroup'
      (MulAut.conj a).toMonoidHom
  obtain ⟨R, hRp, hAR, hRB, hRN⟩ :=
    exists_larger_normalizer_pSubgroup (G := G) (p := p) hBp hABlt
  let N : Subgroup G := Subgroup.normalizer (A : Set G)
  have hRN' : R ≤ N := by simpa [N] using hRN
  let RN : Subgroup N := R.subgroupOf N
  have hRNp : IsPGroup p RN :=
    hRp.of_equiv (Subgroup.subgroupOfEquivOfLe hRN').symm
  obtain ⟨S, hRNS⟩ := hRNp.exists_le_sylow
  let SG : Subgroup G := (S : Subgroup N).map N.subtype
  have hSGN : SG ≤ N := by
    simpa [SG] using Subgroup.map_le_range N.subtype (S : Subgroup N)
  have hSGp : IsPGroup p SG := by
    simpa [SG] using S.isPGroup'.map N.subtype
  obtain ⟨T, hSGT⟩ := hSGp.exists_le_sylow
  obtain ⟨b, hb⟩ := MulAction.exists_smul_eq G P T
  have hPb : P.toSubgroup.conjBy b = (T : Subgroup G) := by
    have hb' : MulAut.conj b • (P : Subgroup G) = (T : Subgroup G) := by
      have hb'' := congrArg (fun Q : Sylow p G => (Q : Subgroup G)) hb
      rw [Sylow.coe_subgroup_smul] at hb''
      exact hb''
    have haction : P.toSubgroup.conjBy b =
        MulAut.conj b • (P : Subgroup G) := by
      change (P : Subgroup G).map _ = (P : Subgroup G).map _
      congr 1
    exact haction.trans hb'
  have hAb : rightConjugate A b ≤ (P : Subgroup G) := by
    have hRSG : R ≤ SG := by
      intro x hx
      refine Subgroup.mem_map.mpr ⟨⟨x, hRN' hx⟩, ?_, rfl⟩
      exact hRNS (show (⟨x, hRN' hx⟩ : N) ∈ RN by exact hx)
    apply rightConjugate_le_iff.mpr
    rw [hPb]
    exact hAR.le.trans (hRSG.trans hSGT)
  have hab : HuppertRelated (P : Subgroup G) A a b := by
    apply Relation.ReflTransGen.single
    refine ⟨ha, hAb, ?_⟩
    have hRSG : R ≤ SG := by
      intro x hx
      refine Subgroup.mem_map.mpr ⟨⟨x, hRN' hx⟩, ?_, rfl⟩
      exact hRNS (show (⟨x, hRN' hx⟩ : N) ∈ RN by exact hx)
    exact lt_of_lt_of_le hAR (le_inf hRB (by
      rw [hPb]
      exact hRSG.trans hSGT))
  let VP : Subgroup G := (P : Subgroup G) ⊓ N
  have hVPp : IsPGroup p VP := IsPGroup.to_le P.isPGroup' inf_le_left
  let VPN : Subgroup N := VP.subgroupOf N
  have hVPNp : IsPGroup p VPN :=
    hVPp.of_equiv (Subgroup.subgroupOfEquivOfLe (by simp [VP, N])).symm
  obtain ⟨R0, hVPNR0⟩ := hVPNp.exists_le_sylow
  obtain ⟨cN, hcN⟩ := MulAction.exists_smul_eq N R0 S
  let c : G := cN
  have hcNmem : (cN : G) ∈ N := cN.property
  have hcA : c ∈ Subgroup.normalizer (A : Set G) := hcNmem
  have hVPc : VP.conjBy c ≤ SG := by
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨v, hv, rfl⟩
    let vN : N := ⟨v, by simpa [VP, N] using hv.2⟩
    have hvVPN : vN ∈ VPN := by
      change v ∈ VP
      exact hv
    have hvR0 : vN ∈ (R0 : Subgroup N) := hVPNR0 hvVPN
    have hcvS : cN * vN * cN⁻¹ ∈ (S : Subgroup N) := by
      rw [← hcN]
      exact Subgroup.mem_map.mpr ⟨vN, hvR0, by simp [MulAut.conj_apply]⟩
    refine Subgroup.mem_map.mpr ⟨cN * vN * cN⁻¹, hcvS, ?_⟩
    rfl
  have hAVP : A < VP := by
    obtain ⟨R2, _hR2p, hAR2, hR2P, hR2N⟩ :=
      exists_larger_normalizer_pSubgroup (G := G) (p := p)
        (P := A) (R := (P : Subgroup G)) P.isPGroup' hAP
    exact hAR2.trans_le (le_inf hR2P (by simpa [N] using hR2N))
  have hAVPc : A < VP.conjBy c := by
    have hlt := (Subgroup.map_lt_map_iff_of_injective
      (f := (MulAut.conj c).toMonoidHom) (MulAut.conj c).injective).2 hAVP
    change A.conjBy c < VP.conjBy c at hlt
    rw [conjBy_eq_self_of_mem_normalizer hcA] at hlt
    exact hlt
  have hbc : HuppertRelated (P : Subgroup G) A b c := by
    apply Relation.ReflTransGen.single
    refine ⟨hAb, ?_, ?_⟩
    · rw [rightConjugate_eq_self_of_mem_normalizer hcA]
      exact hAP.le
    · exact lt_of_lt_of_le hAVPc (le_inf (by
        rw [hPb]
        exact hVPc.trans hSGT) (Subgroup.map_mono inf_le_left))
  let U : Subgroup G := rightConjugate A b
  let NU : Subgroup G := Subgroup.normalizer (U : Set G)
  let L : Subgroup G := rightConjugate SG b
  have hLleP : L ≤ (P : Subgroup G) := by
    have h := Subgroup.map_mono
      (f := (MulAut.conj b⁻¹).toMonoidHom) hSGT
    change SG.conjBy b⁻¹ ≤ (T : Subgroup G).conjBy b⁻¹ at h
    rw [← hPb] at h
    change L ≤ (P : Subgroup G)
    simpa [L, rightConjugate] using
      h.trans_eq (Subgroup.conjBy_inv P.toSubgroup b)
  have hNUeq : NU = rightConjugate N b := by
    dsimp [NU, U]
    exact normalizer_conjBy A b⁻¹
  have hLleNU : L ≤ NU := by
    rw [hNUeq]
    change SG.conjBy b⁻¹ ≤ N.conjBy b⁻¹
    exact Subgroup.map_mono hSGN
  have hcardSG : Nat.card SG = Nat.card (S : Subgroup N) := by
    simpa [SG] using
      Subgroup.card_map_of_injective (K := (S : Subgroup N))
        (f := N.subtype) N.subtype_injective
  have hcardL : Nat.card L = Nat.card (S : Subgroup N) := by
    calc
      Nat.card L = Nat.card SG := by
        simpa [L, rightConjugate] using natCard_conjBy_eq SG b⁻¹
      _ = Nat.card (S : Subgroup N) := hcardSG
  have hcardNU : Nat.card NU = Nat.card N := by
    rw [hNUeq]
    simpa [rightConjugate] using natCard_conjBy_eq N b⁻¹
  have hfacL : (Nat.card L).factorization p =
      (Nat.card NU).factorization p := by
    calc
      (Nat.card L).factorization p =
          (Nat.card (S : Subgroup N)).factorization p := by rw [hcardL]
      _ = (Nat.card N).factorization p := by
        rw [S.card_eq_multiplicity, Nat.factorization_pow_self Fact.out]
      _ = (Nat.card NU).factorization p := by rw [hcardNU]
  have hfacInfLe :
      (Nat.card (((P : Subgroup G) ⊓ NU : Subgroup G))).factorization p ≤
        (Nat.card NU).factorization p :=
    Nat.factorization_le_factorization_of_dvd_right
      (Subgroup.card_dvd_of_le inf_le_right) Nat.card_pos.ne' Nat.card_pos.ne'
  have hfacLeInf : (Nat.card NU).factorization p ≤
      (Nat.card (((P : Subgroup G) ⊓ NU : Subgroup G))).factorization p := by
    rw [← hfacL]
    exact Nat.factorization_le_factorization_of_dvd_right
      (Subgroup.card_dvd_of_le (le_inf hLleP hLleNU))
      Nat.card_pos.ne' Nat.card_pos.ne'
  have hfacInf :
      (Nat.card (((P : Subgroup G) ⊓ NU : Subgroup G))).factorization p =
        (Nat.card NU).factorization p :=
    le_antisymm hfacInfLe hfacLeInf
  refine ⟨b, c, ?_, hab, hbc, hcA⟩
  refine ⟨hAb, ?_⟩
  simpa [U, NU] using hfacInf

public theorem HuppertConjugationDecomposition.result_le
    {G : Type u} [Group G]
    {P A : Subgroup G} {family : Subgroup G → Prop} {g : G}
    (hAP : A ≤ P)
    (h : HuppertConjugationDecomposition P family A g) :
    rightConjugate A g ≤ P := by
  induction h with
  | one => simpa [rightConjugate_one] using hAP
  | @tail g0 h0 U hprev _ hUP hcur hn ih =>
      rw [← rightConjugate_rightConjugate]
      have hle := Subgroup.map_mono
        (f := (MulAut.conj h0⁻¹).toMonoidHom) hcur
      change rightConjugate (rightConjugate A g0) h0 ≤
        rightConjugate U h0 at hle
      rw [rightConjugate_eq_self_of_mem_normalizer hn] at hle
      exact hle.trans hUP

public theorem HuppertConjugationDecomposition.mono
    {G : Type u} [Group G]
    {P A B : Subgroup G} {family : Subgroup G → Prop} {g : G}
    (hBA : B ≤ A)
    (h : HuppertConjugationDecomposition P family A g) :
    HuppertConjugationDecomposition P family B g := by
  induction h with
  | one => exact .one
  | tail hprev hU hUP hcur hn ih =>
      exact .tail ih hU hUP
        ((Subgroup.map_mono hBA).trans hcur) hn

public theorem HuppertConjugationDecomposition.trans
    {G : Type u} [Group G]
    {P A : Subgroup G} {family : Subgroup G → Prop} {g h : G}
    (hg : HuppertConjugationDecomposition P family A g)
    (hh : HuppertConjugationDecomposition P family
      (rightConjugate A g) h) :
    HuppertConjugationDecomposition P family A (g * h) := by
  induction hh with
  | one => simpa using hg
  | @tail k t U hprev hU hUP hcur hn ih =>
      have hcur' : rightConjugate A (g * k) ≤ U := by
        simpa [rightConjugate_rightConjugate] using hcur
      simpa [mul_assoc] using
        (HuppertConjugationDecomposition.tail ih hU hUP hcur' hn)

public theorem HuppertCentricConjugationDecomposition.result_le
    {G : Type u} [Group G]
    {P A : Subgroup G} {family : Subgroup G → Prop} {g : G}
    (hAP : A ≤ P)
    (h : HuppertCentricConjugationDecomposition P family A g) :
    rightConjugate A g ≤ P := by
  induction h with
  | one => simpa [rightConjugate_one] using hAP
  | @tail g0 h0 U hprev _ hUP hcur hn _ ih =>
      rw [← rightConjugate_rightConjugate]
      have hle := Subgroup.map_mono
        (f := (MulAut.conj h0⁻¹).toMonoidHom) hcur
      change rightConjugate (rightConjugate A g0) h0 ≤
        rightConjugate U h0 at hle
      rw [rightConjugate_eq_self_of_mem_normalizer hn] at hle
      exact hle.trans hUP

public theorem HuppertCentricConjugationDecomposition.mono
    {G : Type u} [Group G]
    {P A B : Subgroup G} {family : Subgroup G → Prop} {g : G}
    (hBA : B ≤ A)
    (h : HuppertCentricConjugationDecomposition P family A g) :
    HuppertCentricConjugationDecomposition P family B g := by
  induction h with
  | one => exact .one
  | tail hprev hU hUP hcur hn hcent ih =>
      exact .tail ih hU hUP
        ((Subgroup.map_mono hBA).trans hcur) hn hcent

public theorem HuppertCentricConjugationDecomposition.trans
    {G : Type u} [Group G]
    {P A : Subgroup G} {family : Subgroup G → Prop} {g h : G}
    (hg : HuppertCentricConjugationDecomposition P family A g)
    (hh : HuppertCentricConjugationDecomposition P family
      (rightConjugate A g) h) :
    HuppertCentricConjugationDecomposition P family A (g * h) := by
  induction hh with
  | one => simpa using hg
  | @tail k t U hprev hU hUP hcur hn hcent ih =>
      have hcur' : rightConjugate A (g * k) ≤ U := by
        simpa [rightConjugate_rightConjugate] using hcur
      simpa [mul_assoc] using
        (HuppertCentricConjugationDecomposition.tail
          ih hU hUP hcur' hn hcent)

private theorem HuppertConjugationDecomposition.centric_of_larger
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {P : Sylow p G} {A : Subgroup G} {g : G}
    (_hAP : A ≤ (P : Subgroup G))
    (hdec : HuppertConjugationDecomposition (P : Subgroup G)
      (HuppertExtremal P) A g)
    (hlarger : ∀ B : Subgroup G, Nat.card A < Nat.card B →
      B ≤ (P : Subgroup G) → ∀ z : G,
        rightConjugate B z ≤ (P : Subgroup G) →
          HuppertCentricConjugationDecomposition (P : Subgroup G)
            (HuppertExtremal P) B z) :
    HuppertCentricConjugationDecomposition (P : Subgroup G)
      (HuppertExtremal P) A g := by
  induction hdec with
  | one => exact .one
  | @tail g₀ h U hprev hUext hUP hcur hn ih =>
      by_cases hcent : subgroupCentralizerIn (P : Subgroup G) U ≤ U
      · exact .tail ih hUext hUP hcur hn (Or.inl hcent)
      · let L : Subgroup G := U ⊔ subgroupCentralizerIn (P : Subgroup G) U
        have hUL : U < L := by
          apply lt_of_le_of_ne le_sup_left
          intro hLU
          exact hcent (sup_eq_left.mp hLU.symm)
        have hcardA : Nat.card A =
            Nat.card (rightConjugate A g₀) := by
          simpa [rightConjugate] using (natCard_conjBy_eq A g₀⁻¹).symm
        have hcardL : Nat.card A < Nat.card L := by
          calc
            Nat.card A = Nat.card (rightConjugate A g₀) := hcardA
            _ ≤ Nat.card U := Subgroup.card_le_of_le hcur
            _ < Nat.card L := natCard_lt_of_subgroup_lt hUL
        have hLP : L ≤ (P : Subgroup G) := by
          exact sup_le hUext.1 inf_le_left
        obtain ⟨z, hzC, hLhz⟩ :=
          HuppertExtremal.exists_centralizer_adjustment hUext hn
        have hLhzP : rightConjugate L (h * z⁻¹) ≤
            (P : Subgroup G) := by
          rw [hLhz]
          exact hLP
        have hlarge := hlarger L hcardL hLP (h * z⁻¹) hLhzP
        have hB0L : rightConjugate A g₀ ≤ L := hcur.trans le_sup_left
        have hB0large := hlarge.mono hB0L
        have hzNorm : z ∈ Subgroup.normalizer (U : Set G) :=
          centralizer_le_normalizer U hzC
        have hcurh : rightConjugate (rightConjugate A g₀) h ≤ U := by
          have hmap := Subgroup.map_mono
            (f := (MulAut.conj h⁻¹).toMonoidHom) hcur
          change rightConjugate (rightConjugate A g₀) h ≤
            rightConjugate U h at hmap
          rw [rightConjugate_eq_self_of_mem_normalizer hn] at hmap
          exact hmap
        have hcurhz : rightConjugate
            (rightConjugate (rightConjugate A g₀) h) z⁻¹ ≤ U := by
          have hmap := Subgroup.map_mono
            (f := (MulAut.conj z).toMonoidHom) hcurh
          have hmap' : rightConjugate
              (rightConjugate (rightConjugate A g₀) h) z⁻¹ ≤
            rightConjugate U z⁻¹ := by
            simpa [rightConjugate, Subgroup.conjBy] using hmap
          rw [rightConjugate_eq_self_of_mem_normalizer
            ((Subgroup.normalizer (U : Set G)).inv_mem hzNorm)] at hmap'
          exact hmap'
        have hcur' : rightConjugate A (g₀ * (h * z⁻¹)) ≤ U := by
          simpa [rightConjugate_rightConjugate, mul_assoc] using hcurhz
        have hmid := HuppertCentricConjugationDecomposition.trans ih hB0large
        have htail := HuppertCentricConjugationDecomposition.tail hmid
          hUext hUP hcur' hzNorm (Or.inr hzC)
        simpa [mul_assoc] using htail

private theorem HuppertAdjacent.decomposition_of_larger
    {G : Type u} [Group G] [Finite G]
    {P A : Subgroup G} {family : Subgroup G → Prop} {x y : G}
    (hxy : HuppertAdjacent P A x y)
    (hlarger : ∀ B : Subgroup G, Nat.card A < Nat.card B → B ≤ P →
      ∀ z : G, rightConjugate B z ≤ P →
        HuppertConjugationDecomposition P family B z) :
    HuppertConjugationDecomposition P family
      (rightConjugate A x) (x⁻¹ * y) := by
  let I : Subgroup G := P.conjBy x ⊓ P.conjBy y
  let B : Subgroup G := rightConjugate I x
  have hAI : A ≤ I := by
    apply le_inf
    · exact rightConjugate_le_iff.mp hxy.1
    · exact rightConjugate_le_iff.mp hxy.2.1
  have hAB : rightConjugate A x ≤ B := by
    change rightConjugate A x ≤ rightConjugate I x
    exact Subgroup.map_mono
      (f := (MulAut.conj x⁻¹).toMonoidHom) hAI
  have hBP : B ≤ P := by
    change I.conjBy x⁻¹ ≤ P
    have hIleft : I ≤ P.conjBy x := by
      exact inf_le_left
    have h := Subgroup.map_mono
      (f := (MulAut.conj x⁻¹).toMonoidHom) hIleft
    change I.conjBy x⁻¹ ≤ (P.conjBy x).conjBy x⁻¹ at h
    exact h.trans_eq (Subgroup.conjBy_inv P x)
  have hBconj : rightConjugate B (x⁻¹ * y) ≤ P := by
    change rightConjugate (rightConjugate I x) (x⁻¹ * y) ≤ P
    rw [rightConjugate_rightConjugate]
    simp only [mul_inv_cancel_left]
    change I.conjBy y⁻¹ ≤ P
    have hIright : I ≤ P.conjBy y := by
      exact inf_le_right
    have h := Subgroup.map_mono
      (f := (MulAut.conj y⁻¹).toMonoidHom) hIright
    change I.conjBy y⁻¹ ≤ (P.conjBy y).conjBy y⁻¹ at h
    exact h.trans_eq (Subgroup.conjBy_inv P y)
  have hlt : rightConjugate A x < B := by
    change rightConjugate A x < rightConjugate I x
    exact (Subgroup.map_lt_map_iff_of_injective
      (f := (MulAut.conj x⁻¹).toMonoidHom) (MulAut.conj x⁻¹).injective).2 hxy.2.2
  have hcard : Nat.card A < Nat.card B := by
    calc
      Nat.card A = Nat.card (rightConjugate A x) := by
        simpa [rightConjugate] using (natCard_conjBy_eq A x⁻¹).symm
      _ < Nat.card B := natCard_lt_of_subgroup_lt hlt
  exact (hlarger B hcard hBP (x⁻¹ * y) hBconj).mono hAB

private theorem HuppertRelated.decomposition_of_larger
    {G : Type u} [Group G] [Finite G]
    {P A : Subgroup G} {family : Subgroup G → Prop} {x y : G}
    (hrel : HuppertRelated P A x y)
    (hlarger : ∀ B : Subgroup G, Nat.card A < Nat.card B → B ≤ P →
      ∀ z : G, rightConjugate B z ≤ P →
        HuppertConjugationDecomposition P family B z) :
    HuppertConjugationDecomposition P family
      (rightConjugate A x) (x⁻¹ * y) := by
  induction hrel with
  | refl => simpa using (HuppertConjugationDecomposition.one (P := P)
      (family := family) (A := rightConjugate A x))
  | @tail z y hrel hzy ih =>
      have hstep := HuppertAdjacent.decomposition_of_larger hzy hlarger
      have hstep' : HuppertConjugationDecomposition P family
          (rightConjugate (rightConjugate A x) (x⁻¹ * z)) (z⁻¹ * y) := by
        rw [rightConjugate_rightConjugate]
        simp only [mul_inv_cancel_left]
        exact hstep
      have hcomp := HuppertConjugationDecomposition.trans ih hstep'
      simpa [mul_assoc] using hcomp

/-- Huppert X.4.6: the extremal subgroups of a Sylow subgroup form a
conjugation family.  The decomposition records the exact conjugating product,
not only its action on the initial subgroup. -/
public theorem HuppertExtremal.conjugation_decomposition
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) {A : Subgroup G} (hAP : A ≤ (P : Subgroup G))
    {g : G} (hg : rightConjugate A g ≤ (P : Subgroup G)) :
    HuppertConjugationDecomposition (P : Subgroup G)
      (HuppertExtremal P) A g := by
  classical
  let motive : ℕ → Prop := fun n ↦
    ∀ (A : Subgroup G), A ≤ (P : Subgroup G) →
      Nat.card (P : Subgroup G) - Nat.card A = n →
      ∀ g : G, rightConjugate A g ≤ (P : Subgroup G) →
        HuppertConjugationDecomposition (P : Subgroup G)
          (HuppertExtremal P) A g
  refine Nat.strong_induction_on (p := motive)
    (Nat.card (P : Subgroup G) - Nat.card A) ?_
      A hAP rfl g hg
  intro n ih A hAP hn g hg
  by_cases hAeq : A = (P : Subgroup G)
  · subst A
    have hfix : rightConjugate (P : Subgroup G) g = (P : Subgroup G) := by
      apply Subgroup.eq_of_le_of_card_ge hg
      simpa [rightConjugate] using
        le_of_eq (natCard_conjBy_eq (P : Subgroup G) g⁻¹).symm
    have hginv : g⁻¹ ∈
        Subgroup.normalizer (((P : Subgroup G) : Set G)) := by
      apply mem_normalizer_of_conjBy_eq
      exact hfix
    have hgnorm : g ∈
        Subgroup.normalizer (((P : Subgroup G) : Set G)) := by
      simpa using
        (Subgroup.normalizer (((P : Subgroup G) : Set G))).inv_mem hginv
    have htail := HuppertConjugationDecomposition.tail
      (HuppertConjugationDecomposition.one
        (P := (P : Subgroup G)) (family := HuppertExtremal P)
        (A := (P : Subgroup G)))
      (huppertExtremal_sylow P) le_rfl
      (by simp [rightConjugate_one]) hgnorm
    simpa using htail
  · have hAlt : A < (P : Subgroup G) := lt_of_le_of_ne hAP hAeq
    have hlarger : ∀ B : Subgroup G, Nat.card A < Nat.card B →
        B ≤ (P : Subgroup G) → ∀ z : G,
          rightConjugate B z ≤ (P : Subgroup G) →
            HuppertConjugationDecomposition (P : Subgroup G)
              (HuppertExtremal P) B z := by
      intro B hAB hBP z hz
      have hBPcard : Nat.card B ≤ Nat.card (P : Subgroup G) :=
        Subgroup.card_le_of_le hBP
      exact ih (Nat.card (P : Subgroup G) - Nat.card B) (by omega)
        B hBP rfl z hz
    obtain ⟨b, c, hUext, hgb, hbc, hc⟩ :=
      exists_extremal_representative P hAlt hg
    let d : G := c⁻¹ * b
    let U : Subgroup G := rightConjugate A b
    have hcd : HuppertRelated (P : Subgroup G) A 1 d := by
      have hcb : HuppertRelated (P : Subgroup G) A c b :=
        HuppertRelated.symmetric b c hbc
      have hcinv : c⁻¹ ∈ Subgroup.normalizer (A : Set G) :=
        (Subgroup.normalizer (A : Set G)).inv_mem hc
      simpa [d] using hcb.mul_left_of_mem_normalizer hcinv
    have hd : HuppertConjugationDecomposition (P : Subgroup G)
        (HuppertExtremal P) A d := by
      simpa [rightConjugate_one] using
        (HuppertRelated.decomposition_of_larger hcd hlarger)
    have hcinv : c⁻¹ ∈ Subgroup.normalizer (A : Set G) :=
      (Subgroup.normalizer (A : Set G)).inv_mem hc
    have hAd : rightConjugate A d = U := by
      change rightConjugate A (c⁻¹ * b) = rightConjugate A b
      rw [← rightConjugate_rightConjugate,
        rightConjugate_eq_self_of_mem_normalizer hcinv]
    let f : G := d⁻¹ * c * d
    have hfnorm : f ∈ Subgroup.normalizer (U : Set G) := by
      apply mem_normalizer_of_conjBy_eq
      have hcfix : A.conjBy c = A :=
        conjBy_eq_self_of_mem_normalizer hc
      change (rightConjugate A b).conjBy (d⁻¹ * c * d) =
        rightConjugate A b
      have hdb : rightConjugate A d = rightConjugate A b := by
        simpa [U] using hAd
      rw [← hdb]
      change (A.conjBy d⁻¹).conjBy (d⁻¹ * c * d) = A.conjBy d⁻¹
      rw [Subgroup.conjBy_conjBy]
      calc
        A.conjBy ((d⁻¹ * c * d) * d⁻¹) =
            A.conjBy (d⁻¹ * c) := by
          rw [show (d⁻¹ * c * d) * d⁻¹ = d⁻¹ * c by group]
        _ = (A.conjBy c).conjBy d⁻¹ := Subgroup.conjBy_mul A d⁻¹ c
        _ = A.conjBy d⁻¹ := by rw [hcfix]
    have hUleP : U ≤ (P : Subgroup G) := hUext.1
    have hdf := HuppertConjugationDecomposition.tail hd hUext hUleP
      hAd.le hfnorm
    have hdfEq : d * f = b := by
      dsimp [d, f]
      group
    have hbdec : HuppertConjugationDecomposition (P : Subgroup G)
        (HuppertExtremal P) A b := by
      simpa [hdfEq] using hdf
    have hbg : HuppertRelated (P : Subgroup G) A b g :=
      HuppertRelated.symmetric g b hgb
    have hlast := HuppertRelated.decomposition_of_larger hbg hlarger
    have hfinal := HuppertConjugationDecomposition.trans hbdec hlast
    simpa [mul_assoc] using hfinal

/-- Huppert X.4.7 specialized to the extremal conjugation family.  Every
normalizer step is either taken at a self-centralizing subgroup of `P`, or is
itself an ambient-centralizer step. -/
public theorem HuppertExtremal.centric_conjugation_decomposition
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) {A : Subgroup G} (hAP : A ≤ (P : Subgroup G))
    {g : G} (hg : rightConjugate A g ≤ (P : Subgroup G)) :
    HuppertCentricConjugationDecomposition (P : Subgroup G)
      (HuppertExtremal P) A g := by
  classical
  let motive : ℕ → Prop := fun n ↦
    ∀ (A : Subgroup G), A ≤ (P : Subgroup G) →
      Nat.card (P : Subgroup G) - Nat.card A = n →
      ∀ g : G, rightConjugate A g ≤ (P : Subgroup G) →
        HuppertCentricConjugationDecomposition (P : Subgroup G)
          (HuppertExtremal P) A g
  refine Nat.strong_induction_on (p := motive)
    (Nat.card (P : Subgroup G) - Nat.card A) ?_
      A hAP rfl g hg
  intro n ih A hAP hn g hg
  have hlarger : ∀ B : Subgroup G, Nat.card A < Nat.card B →
      B ≤ (P : Subgroup G) → ∀ z : G,
        rightConjugate B z ≤ (P : Subgroup G) →
          HuppertCentricConjugationDecomposition (P : Subgroup G)
            (HuppertExtremal P) B z := by
    intro B hAB hBP z hz
    have hBPcard : Nat.card B ≤ Nat.card (P : Subgroup G) :=
      Subgroup.card_le_of_le hBP
    exact ih (Nat.card (P : Subgroup G) - Nat.card B) (by omega)
      B hBP rfl z hz
  exact (HuppertExtremal.conjugation_decomposition P hAP hg).centric_of_larger
    hAP hlarger

