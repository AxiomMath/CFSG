          ∀ ω : blockCycles,
            (((bookPi ω : Q) * g)⁻¹ * U₀ ^ cycleLength ω.1 * ((bookPi ω : Q) * g)) ∈ P := by
        intro ω
        let k : Q := (cycleRep ω.1)⁻¹ * ((bookPi ω : Q) * g)
        have hkP : k ∈ P := by
          simpa [k] using hbookPi_spec ω
        have hrawP : (cycleRep ω.1)⁻¹ * U₀ ^ cycleLength ω.1 * cycleRep ω.1 ∈ P :=
          hcycle_raw_power_mem_P ω
        have hconjP : k⁻¹ * ((cycleRep ω.1)⁻¹ * U₀ ^ cycleLength ω.1 * cycleRep ω.1) * k ∈ P :=
          P.mul_mem (P.mul_mem (P.inv_mem hkP) hrawP) hkP
        have hconj_eq :
            k⁻¹ * ((cycleRep ω.1)⁻¹ * U₀ ^ cycleLength ω.1 * cycleRep ω.1) * k =
              ((bookPi ω : Q) * g)⁻¹ * U₀ ^ cycleLength ω.1 * ((bookPi ω : Q) * g) := by
          simp [k, mul_assoc]
        have htarget :
            ((bookPi ω : Q) * g)⁻¹ * U₀ ^ cycleLength ω.1 * ((bookPi ω : Q) * g) ∈ P := by
          exact (congrArg (fun z : Q => z ∈ P) hconj_eq).mp hconjP
        simpa [mul_assoc] using htarget
      let bookTi : blockCycles → P := fun ω =>
        ⟨((bookPi ω : Q) * g)⁻¹ * U₀ ^ cycleLength ω.1 * ((bookPi ω : Q) * g),
          hbook_Ti_mem_P ω⟩
      let bookTiContribution : blockCycles → P ⧸ Dsub := fun ω =>
        πD (bookTi ω)
      have hcycleContribution_eq_bookTi_of_repChange :
          ∀ ω : blockCycles, cycleContribution ω.1 = bookTiContribution ω := by
        classical
        intro ω
        let k : Q := (cycleRep ω.1)⁻¹ * ((bookPi ω : Q) * g)
        have hkP : k ∈ P := by
          simpa [k] using hbookPi_spec ω
        have hk_inv_norm : k⁻¹ ∈ Subgroup.normalizer ((P : Subgroup Q) : Set Q) := by
          exact (Subgroup.normalizer ((P : Subgroup Q) : Set Q)).inv_mem
            (Subgroup.le_normalizer hkP)
        let aQ : Q := (cycleRep ω.1)⁻¹ * U₀ ^ cycleLength ω.1 * cycleRep ω.1
        have haP : aQ ∈ P := by
          simpa [aQ] using hcycle_raw_power_mem_P ω
        have hgrun :=
          huppert_IV_3_4_normalizer_conj_eq_mod_grunKernelSubgroup
            (Q := Q) (q := q) S (a := aQ) (b := k⁻¹)
            (by simpa [P] using haP) (by simpa [P] using hk_inv_norm)
        simpa [P, D, Dsub, πD, cycleContribution, cycleElement,
          bookTiContribution, bookTi, aQ, k, mul_assoc] using hgrun.symm
      have hbook_correction_mem_localGenerator :
          ∀ ω : blockCycles,
            let m : ℕ := cycleLength ω.1
            let raw : Q := g⁻¹ * U₀ ^ m * g
            let Ti : Q := (bookTi ω : Q)
            raw⁻¹ * Ti ∈ P ∧
              raw⁻¹ * Ti ∈ rightConjugate ((commutator P).map P.subtype) g := by
        classical
        -- Huppert IV.3.4, lines 21565-21583: the displayed correction
        -- `(g⁻¹ U^m g)⁻¹ T_i` is, under the OCR-corrected statement,
        -- one of the generators in the family `P ∩ (P')^g`.
        intro ω
        dsimp only
        constructor
        · let m : ℕ := cycleLength ω.1
          let raw : Q := g⁻¹ * U₀ ^ m * g
          let Ti : Q := (bookTi ω : Q)
          have hrawP : raw ∈ P := by
            simpa [raw, m] using hbase_conj_power_mem_P (hbaseCycle_dvd_cycleLength ω)
          have hTiP : Ti ∈ P := by
            change (bookTi ω : Q) ∈ P
            exact (bookTi ω).property
          exact P.mul_mem (P.inv_mem hrawP) hTiP
        · let m : ℕ := cycleLength ω.1
          let raw : Q := g⁻¹ * U₀ ^ m * g
          let Ti : Q := (bookTi ω : Q)
          let Pder : Subgroup Q := (commutator P).map P.subtype
          have hinnerPder :
              ((U₀ ^ m)⁻¹ * (bookPi ω : Q)⁻¹ * U₀ ^ m * (bookPi ω : Q)) ∈ Pder := by
            rw [Subgroup.mem_map]
            let uP : P := ⟨U₀ ^ m, P.pow_mem hU₀_P m⟩
            let pP : P := bookPi ω
            refine ⟨⁅uP⁻¹, pP⁻¹⁆, ?_, ?_⟩
            · rw [commutator]
              apply Subgroup.subset_closure
              exact ⟨uP⁻¹, trivial, pP⁻¹, trivial, rfl⟩
            · simp [uP, pP, commutatorElement_def, mul_assoc]
          change raw⁻¹ * Ti ∈ rightConjugate Pder g
          rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map]
          refine ⟨(U₀ ^ m)⁻¹ * (bookPi ω : Q)⁻¹ * U₀ ^ m * (bookPi ω : Q),
            hinnerPder, ?_⟩
          simp [raw, Ti, bookTi, m, mul_assoc]
      have hbook_correction_mem_D :
          ∀ ω : blockCycles,
            ((g⁻¹ * U₀ ^ cycleLength ω.1 * g)⁻¹ * (bookTi ω : Q)) ∈ D := by
        intro ω
        change ((g⁻¹ * U₀ ^ cycleLength ω.1 * g)⁻¹ * (bookTi ω : Q)) ∈
          huppertIV34GrunKernelSubgroup (Q := Q) P
        rw [huppertIV34GrunKernelSubgroup]
        apply Subgroup.subset_closure
        exact Or.inr ⟨g, (hbook_correction_mem_localGenerator ω).1,
          (hbook_correction_mem_localGenerator ω).2⟩
      have hcycle_block_raw_mem_P :
          ∀ ω : blockCycles, g⁻¹ * U₀ ^ cycleLength ω.1 * g ∈ P := by
        intro ω
        have hcorrP : ((g⁻¹ * U₀ ^ cycleLength ω.1 * g)⁻¹ * (bookTi ω : Q)) ∈ P := by
          exact (huppert_IV_3_4_grunKernelSubgroup_le_sylow_inf_commutator (Q := Q) (P := P)
            (by simpa [D] using hbook_correction_mem_D ω)).1
        have hbookPmem : (bookTi ω : Q) ∈ P := (bookTi ω).property
        have hinv_rawP : (g⁻¹ * U₀ ^ cycleLength ω.1 * g)⁻¹ ∈ P := by
          have hmul : ((g⁻¹ * U₀ ^ cycleLength ω.1 * g)⁻¹ * (bookTi ω : Q)) *
              (bookTi ω : Q)⁻¹ ∈ P :=
            P.mul_mem hcorrP (P.inv_mem hbookPmem)
          simpa [mul_assoc] using hmul
        exact P.inv_mem_iff.mp hinv_rawP
      let blockRawFactor : blockCycles → P := fun ω =>
        ⟨g⁻¹ * U₀ ^ cycleLength ω.1 * g, hcycle_block_raw_mem_P ω⟩
      have hcycle_bookContribution_eq_raw :
          ∀ ω : blockCycles, bookTiContribution ω = πD (blockRawFactor ω) := by
        intro ω
        apply QuotientGroup.eq.2
        exact Subgroup.mem_subgroupOf.2 (by
          simpa [blockRawFactor, mul_inv_rev, mul_assoc] using D.inv_mem (hbook_correction_mem_D ω))
      have hblock_product_eq_power :
          blockContribution δ =
            πD ⟨g⁻¹ * U₀ ^ blockPower * g, hblockPower_conj_mem_P⟩ := by
        classical
        -- Huppert IV.3.4, lines 21584-21587: multiply the `T_i` terms,
        -- remove the correction factors modulo `D`, and combine the remaining
        -- common conjugates into `G U^s G^{-1}` with `s = sum p^{alpha_i}`.
        have hlist_raw_prod_val :
            (((Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω)).prod : P) : Q) =
              g⁻¹ * U₀ ^ blockPower * g := by
          have hlist_conj : ∀ l : List blockCycles,
              (l.map (fun ω : blockCycles => g⁻¹ * U₀ ^ cycleLength ω.1 * g)).prod =
                g⁻¹ * U₀ ^ (l.map (fun ω : blockCycles => cycleLength ω.1)).sum * g := by
            intro l
            simpa using
              (huppert_IV_3_4_list_raw_conj_prod (Q := Q) g U₀ l
                (fun ω : blockCycles => cycleLength ω.1))
          have hsum_toList :
              (Finset.univ.toList.map (fun ω : blockCycles => cycleLength ω.1)).sum =
                blockPower := by
            unfold blockPower
            exact Finset.sum_map_toList Finset.univ (fun ω : blockCycles => cycleLength ω.1)
          calc
            (((Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω)).prod : P) : Q) =
                (List.map Subtype.val
                  (Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω))).prod := by
              exact
                (Subgroup.val_list_prod (G := Q) (H := P)
                  (Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω)))
            _ = (Finset.univ.toList.map
                  (fun ω : blockCycles => ((blockRawFactor ω : P) : Q))).prod := by
              simp [List.map_map, Function.comp_def]
            _ = (Finset.univ.toList.map
                  (fun ω : blockCycles => g⁻¹ * U₀ ^ cycleLength ω.1 * g)).prod := by
              rfl
            _ = g⁻¹ * U₀ ^
                  (Finset.univ.toList.map (fun ω : blockCycles => cycleLength ω.1)).sum * g :=
              hlist_conj Finset.univ.toList
            _ = g⁻¹ * U₀ ^ blockPower * g := by
              rw [hsum_toList]
        have hlist_raw_prod :
            (Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω)).prod =
              ⟨g⁻¹ * U₀ ^ blockPower * g, hblockPower_conj_mem_P⟩ := by
          ext
          exact hlist_raw_prod_val
        calc
          blockContribution δ = ∏ ω : blockCycles, cycleContribution ω.1 := rfl
          _ = ∏ ω : blockCycles, bookTiContribution ω := by
            exact Fintype.prod_congr _ _ hcycleContribution_eq_bookTi_of_repChange
          _ = ∏ ω : blockCycles, πD (blockRawFactor ω) := by
            exact Fintype.prod_congr _ _ hcycle_bookContribution_eq_raw
          _ = (Finset.univ.toList.map (fun ω : blockCycles => πD (blockRawFactor ω))).prod := by
            exact (Finset.prod_map_toList Finset.univ (fun ω : blockCycles => πD (blockRawFactor ω))).symm
          _ = πD ((Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω)).prod) := by
            calc
              (Finset.univ.toList.map (fun ω : blockCycles => πD (blockRawFactor ω))).prod
                  = (List.map (⇑πD ∘ (fun ω : blockCycles => blockRawFactor ω)) Finset.univ.toList).prod := rfl
              _ = (List.map πD (Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω))).prod := by
                simp [List.map_map]
              _ = πD ((Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω)).prod) :=
                (map_list_prod πD (Finset.univ.toList.map (fun ω : blockCycles => blockRawFactor ω))).symm
          _ = πD ⟨g⁻¹ * U₀ ^ blockPower * g, hblockPower_conj_mem_P⟩ := by
            rw [hlist_raw_prod]
      calc
        blockContribution δ =
            πD ⟨g⁻¹ * U₀ ^ blockPower * g, hblockPower_conj_mem_P⟩ :=
          hblock_product_eq_power
        _ = 1 := by
          exact (QuotientGroup.eq_one_iff (N := Dsub)
            ⟨g⁻¹ * U₀ ^ blockPower * g, hblockPower_conj_mem_P⟩).2 (by
              simpa [Dsub, Subgroup.mem_subgroupOf] using hblockPower_conj_mem_D)
  have hfixedBlock_card :
      Fintype.card {δ : Δ // δ ∈ fixedBlock} = fixedIndex := by
    -- Huppert IV.3.4, lines 21590-21596: the singleton `P`-double cosets
    -- are exactly the fixed points of `P` on `Q/P`, hence correspond to
    -- `N_Q(P)/P`.
    let eFixed : {δ : Δ // δ ∈ fixedBlock} ≃ MulAction.fixedPoints P (Q ⧸ P) := {
      toFun δ := ⟨δ.1.out, by
        exact δ.2 δ.1.out (Quotient.out_eq' δ.1)⟩
      invFun a := ⟨(Quotient.mk'' (a : Q ⧸ P) : Δ), by
        intro b hb
        rw [MulAction.mem_fixedPoints]
        intro p
        have hb_orbit : b ∈ MulAction.orbit P (a : Q ⧸ P) := by
          have hrel :
              (MulAction.orbitRel P (Q ⧸ P)) b (a : Q ⧸ P) :=
            Quotient.exact hb
          simpa [MulAction.orbitRel_apply] using hrel
        rcases MulAction.mem_orbit_iff.mp hb_orbit with ⟨p0, hp0⟩
        have hb_eq_a : b = (a : Q ⧸ P) :=
          hp0.symm.trans ((MulAction.mem_fixedPoints.mp a.property) p0)
        rw [hb_eq_a]
        exact (MulAction.mem_fixedPoints.mp a.property) p
        ⟩
      left_inv δ := by
        ext
        exact Quotient.out_eq' δ.1
      right_inv a := by
        ext
        have hq : (Quotient.mk'' ((Quotient.mk'' (a : Q ⧸ P) : Δ).out) : Δ) =
            Quotient.mk'' (a : Q ⧸ P) := Quotient.out_eq' _
        have hout_orbit : ((Quotient.mk'' (a : Q ⧸ P) : Δ).out) ∈
            MulAction.orbit P (a : Q ⧸ P) := by
          have hrel :
              (MulAction.orbitRel P (Q ⧸ P))
                ((Quotient.mk'' (a : Q ⧸ P) : Δ).out) (a : Q ⧸ P) :=
            Quotient.exact hq
          simpa [MulAction.orbitRel_apply] using hrel
        rcases MulAction.mem_orbit_iff.mp hout_orbit with ⟨p0, hp0⟩
        exact hp0.symm.trans ((MulAction.mem_fixedPoints.mp a.property) p0) }
    calc
      Fintype.card {δ : Δ // δ ∈ fixedBlock} =
          Nat.card {δ : Δ // δ ∈ fixedBlock} := by
        rw [← Nat.card_eq_fintype_card]
      _ = Nat.card (MulAction.fixedPoints P (Q ⧸ P)) :=
        Nat.card_congr eFixed
      _ = Nat.card (Subgroup.normalizer ((P : Subgroup Q) : Set Q) ⧸
            P.comap (Subgroup.normalizer ((P : Subgroup Q) : Set Q)).subtype) := by
        exact Nat.card_congr (Sylow.fixedPointsMulLeftCosetsEquivQuotient P)
      _ = fixedIndex := by
        change Nat.card (N ⧸ P.subgroupOf N) = fixedIndex
        rfl
  have htransfer_power :
      V U₀ = πD U₀P ^ fixedIndex := by
    -- Huppert IV.3.4, lines 21542-21596.  The transfer product above is
    -- regrouped by `P`-double cosets.  In a double coset with outer length
    -- `q ^ a > 1`, the cycle product is killed by the minimality argument;
    -- in a double coset with outer length `1`, the representative normalizes
    -- `P`, so the fixed-cycle contribution is `U₀` modulo `D`.  The number
    -- of length-one double cosets is `[N_Q(P):P] = fixedIndex`.
    rw [htransfer_product, hregroup_transfer_product]
    calc
      (∏ δ : Δ, blockContribution δ) =
          ∏ δ : Δ, if δ ∈ fixedBlock then πD U₀P else 1 := by
        exact Fintype.prod_congr _ _ hblock_contribution
      _ = πD U₀P ^ Fintype.card {δ : Δ // δ ∈ fixedBlock} := by
        classical
        rw [← Finset.prod_filter]
        rw [Finset.prod_const]
        rw [Fintype.card_subtype]
      _ = πD U₀P ^ fixedIndex := by
        rw [hfixedBlock_card]
  have hquot_p : IsPGroup q (P ⧸ Dsub) := by
    simpa [P, Dsub] using S.2.to_quotient Dsub
  have hU₀_pow_one : πD U₀P ^ fixedIndex = 1 := by
    rw [← htransfer_power]
    simpa [MonoidHom.mem_ker] using hU₀_ker
  have hU₀_image_one : πD U₀P = 1 := by
    exact ((hquot_p.powEquiv' hfixedIndex_not_dvd).apply_eq_iff_eq
      (x := πD U₀P) (y := 1)).mp (by simpa using hU₀_pow_one)
  have hU₀_Dsub : U₀P ∈ Dsub := by
    exact (QuotientGroup.eq_one_iff (N := Dsub) U₀P).1 hU₀_image_one
  have hU₀_D : U₀ ∈ D := by
    simpa [Dsub, Subgroup.mem_subgroupOf, U₀P] using hU₀_Dsub
  exact False.elim (hU₀_notD hU₀_D)

private theorem huppert_IV_3_4_transfer_to_grun_quotient_kernel_inf_sylow
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
    let πD : (S : Subgroup Q) →*
        (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
      QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
    (MonoidHom.transfer (G := Q) (H := (S : Subgroup Q)) πD).ker ⊓
        (S : Subgroup Q) = D := by
  classical
  apply le_antisymm
  · simpa using
      huppert_IV_3_4_transfer_to_grun_quotient_kernel_inf_sylow_le_grunKernelSubgroup
        (Q := Q) (q := q) S
  · simpa using
      huppert_IV_3_4_grunKernelSubgroup_le_transfer_to_grun_quotient_kernel_inf_sylow
        (Q := Q) (q := q) S

/-- Huppert IV.3.4, sentence 2.

The transfer/double-coset calculation proves the reverse containment
`P ∩ G' ≤ D`, where `D` is the Grün subgroup generated by the local
normalizer-derived subgroups. -/
private theorem huppert_IV_3_4_sylow_inf_commutator_le_grunKernelSubgroup
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    (S : Subgroup Q) ⊓ commutator Q ≤
      huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q) := by
  classical
  let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
  let πD : (S : Subgroup Q) →*
      (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
    QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
  let V : Q →* (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
    MonoidHom.transfer (G := Q) (H := (S : Subgroup Q)) πD
  have hker : V.ker ⊓ (S : Subgroup Q) = D := by
    simpa [D, πD, V] using
      huppert_IV_3_4_transfer_to_grun_quotient_kernel_inf_sylow
        (Q := Q) (q := q) S
  intro x hx
  have hxV : x ∈ V.ker :=
    Abelianization.commutator_subset_ker (f := V) hx.2
  have hxker : x ∈ V.ker ⊓ (S : Subgroup Q) := ⟨hxV, hx.1⟩
  simpa [D, hker] using hxker

/-- The transfer homomorphism to the quotient of a Sylow subgroup by the
Grün kernel.  This is the maximal abelian `q`-factor map constructed in the
proof of the first theorem of Grün. -/
@[expose] public noncomputable def huppertIV34GrunTransfer
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    Q →* (S : Subgroup Q) ⧸
      (huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)).subgroupOf
        (S : Subgroup Q) :=
  MonoidHom.transfer (G := Q) (H := (S : Subgroup Q))
    (QuotientGroup.mk'
      ((huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)).subgroupOf
        (S : Subgroup Q)))

/-- The kernel of the Grün transfer meets the chosen Sylow subgroup exactly
in the Grün kernel. -/
public theorem huppertIV34GrunTransfer_ker_inf_sylow
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    (huppertIV34GrunTransfer (Q := Q) S).ker ⊓ (S : Subgroup Q) =
      huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q) := by
  simpa [huppertIV34GrunTransfer] using
    huppert_IV_3_4_transfer_to_grun_quotient_kernel_inf_sylow
      (Q := Q) (q := q) S

/-- The Grün transfer is onto the quotient of the Sylow subgroup by the Grün
kernel. -/
public theorem huppertIV34GrunTransfer_surjective
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    Function.Surjective (huppertIV34GrunTransfer (Q := Q) S) := by
  let D : Subgroup Q :=
    huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
  let V := huppertIV34GrunTransfer (Q := Q) S
  let VS : (S : Subgroup Q) →*
      (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
    V.comp (S : Subgroup Q).subtype
  have hker : VS.ker = D.subgroupOf (S : Subgroup Q) := by
    ext x
    change V (x : Q) = 1 ↔ (x : Q) ∈ D
    have hinter := huppertIV34GrunTransfer_ker_inf_sylow (Q := Q) S
    constructor
    · intro hx
      have hx' : (x : Q) ∈ V.ker ⊓ (S : Subgroup Q) := ⟨hx, x.property⟩
      simpa [D, V] using hinter ▸ hx'
    · intro hx
      have hx' : (x : Q) ∈ V.ker ⊓ (S : Subgroup Q) := by
        rw [hinter]
        simpa [D] using hx
      exact hx'.1
  have hcard : Nat.card VS.range =
      Nat.card ((S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q)) := by
    rw [← Subgroup.index_ker, hker, Subgroup.index_eq_card]
  have hrange : VS.range = ⊤ := VS.range.eq_top_of_card_eq hcard
  have hVS : Function.Surjective VS := MonoidHom.range_eq_top.mp hrange
  intro y
  obtain ⟨s, hs⟩ := hVS y
  exact ⟨s, hs⟩

/-- The index of the Grün transfer kernel is the relative index of the Grün
kernel in the chosen Sylow subgroup. -/
public theorem huppertIV34GrunTransfer_ker_index
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    (huppertIV34GrunTransfer (Q := Q) S).ker.index =
      (huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)).relIndex
        (S : Subgroup Q) := by
  let D : Subgroup Q :=
    huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
  let V := huppertIV34GrunTransfer (Q := Q) S
  have hsurj : Function.Surjective V := by
    simpa [V] using huppertIV34GrunTransfer_surjective S
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj,
    Subgroup.card_top, ← Subgroup.index_eq_card]
  rfl

/-- Huppert IV.3.4, first theorem of Grun. -/
public theorem huppert_IV_3_4_first_grun
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    (S : Subgroup Q) ⊓ commutator Q =
      huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q) := by
  classical
  apply le_antisymm
  · exact huppert_IV_3_4_sylow_inf_commutator_le_grunKernelSubgroup
      (Q := Q) (q := q) S
  · exact huppert_IV_3_4_grunKernelSubgroup_le_sylow_inf_commutator
      (Q := Q) (S : Subgroup Q)


