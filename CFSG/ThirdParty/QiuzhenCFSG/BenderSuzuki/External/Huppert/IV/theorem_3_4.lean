/-!
# Huppert IV.3.4

Book-order entry file for the first theorem of Grun, the transfer-kernel
comparison used in the second theorem of Grun.

Implementation declarations are in `BenderSuzuki.External.Huppert.IV.GrunCore`:
* `hkt_grun_iv34_hasNormalPComplement_core_source`
* `hkt_grun_iv34_kernel_control_center_normalizer`
Those are downstream normal-complement consequence wrappers.  The declarations
below record the source statement itself for review before proof work.
-/

namespace CFSG.BenderSuzuki
namespace External

open PFchapter1section1 PFAppendixIII
open scoped Pointwise
open scoped commutatorElement
open scoped IsMulCommutative
set_option maxHeartbeats 0

universe u

/-- The subgroup generated by the local subgroups appearing in Huppert IV.3.4:
`< P ∩ N_G(P)', P ∩ (P')^g | g in G >`.

Here `rightConjugate P g` is the project convention for `P^g = g^-1 P g`;
thus `(P')^g` is represented by the right-conjugate of the ambient image of
the derived subgroup of `P`. -/
@[expose] public noncomputable def huppertIV34GrunKernelSubgroup
    {Q : Type u} [Group Q] (P : Subgroup Q) : Subgroup Q :=
  let N : Subgroup Q := Subgroup.normalizer ((P : Subgroup Q) : Set Q)
  let Pder : Subgroup Q := (commutator P).map P.subtype
  Subgroup.closure
    ({x : Q | x ∈ P ∧ x ∈ (commutator N).map N.subtype} ∪
      {x : Q | ∃ g : Q, x ∈ P ∧ x ∈ rightConjugate Pder g})

/-- Definitional expansion of the Grün subgroup, exported for downstream files
that cannot unfold the private-by-default module body directly. -/
public theorem huppertIV34GrunKernelSubgroup_def
    {Q : Type u} [Group Q] (P : Subgroup Q) :
    huppertIV34GrunKernelSubgroup (Q := Q) P =
      (let N : Subgroup Q := Subgroup.normalizer ((P : Subgroup Q) : Set Q)
       let Pder : Subgroup Q := (commutator P).map P.subtype
       Subgroup.closure
        ({x : Q | x ∈ P ∧ x ∈ (commutator N).map N.subtype} ∪
          {x : Q | ∃ g : Q, x ∈ P ∧ x ∈ rightConjugate Pder g})) := by
  rfl

/-- Huppert IV.3.4, sentence 1.

If D = < P ∩ N_G(P)', P ∩ (P')^g | g ∈ G >, then the obvious containment
`D ≤ P ∩ G'` holds. -/
private theorem huppert_IV_3_4_grunKernelSubgroup_le_sylow_inf_commutator
    {Q : Type u} [Group Q] (P : Subgroup Q) :
    huppertIV34GrunKernelSubgroup (Q := Q) P ≤ P ⊓ commutator Q := by
  classical
  rw [huppertIV34GrunKernelSubgroup, Subgroup.closure_le]
  intro x hx
  rcases hx with hxN | hxC
  · let N : Subgroup Q := Subgroup.normalizer ((P : Subgroup Q) : Set Q)
    change x ∈ P ∧ x ∈ (commutator N).map N.subtype at hxN
    refine ⟨hxN.1, ?_⟩
    have hmap : (commutator N).map N.subtype ≤ commutator Q := by
      rw [Subgroup.map_subtype_commutator]
      exact Subgroup.commutator_mono le_top le_top
    exact hmap hxN.2
  · rcases hxC with ⟨g, hxP, hxPg⟩
    refine ⟨hxP, ?_⟩
    let Pder : Subgroup Q := (commutator P).map P.subtype
    have hPder_le : Pder ≤ commutator Q := by
      intro y hy
      have hmap : (commutator P).map P.subtype ≤ commutator Q := by
        rw [Subgroup.map_subtype_commutator]
        exact Subgroup.commutator_mono le_top le_top
      exact hmap hy
    change x ∈ rightConjugate Pder g at hxPg
    rw [rightConjugate, Subgroup.conjBy] at hxPg
    rw [Subgroup.mem_map] at hxPg
    rcases hxPg with ⟨y, hyPder, rfl⟩
    exact (inferInstance : (commutator Q).Normal).conj_mem y (hPder_le hyPder) g⁻¹

/-- The Grün subgroup contains each ordinary commutator from the Sylow subgroup.
This is the `g = 1` generator in Huppert IV.3.4. -/
private theorem huppert_IV_3_4_commutatorElement_mem_grunKernelSubgroup
    {Q : Type u} [Group Q] (P : Subgroup Q) {a b : Q}
    (ha : a ∈ P) (hb : b ∈ P) :
    ⁅a, b⁆ ∈ huppertIV34GrunKernelSubgroup (Q := Q) P := by
  classical
  rw [huppertIV34GrunKernelSubgroup]
  apply Subgroup.subset_closure
  right
  refine ⟨1, ?_, ?_⟩
  · exact P.mul_mem (P.mul_mem (P.mul_mem ha hb) (P.inv_mem ha)) (P.inv_mem hb)
  · let Pder : Subgroup Q := (commutator P).map P.subtype
    have hcommPder : ⁅a, b⁆ ∈ Pder := by
      rw [Subgroup.mem_map]
      let aP : P := ⟨a, ha⟩
      let bP : P := ⟨b, hb⟩
      refine ⟨⁅aP, bP⁆, ?_, ?_⟩
      · rw [commutator]
        apply Subgroup.subset_closure
        exact ⟨aP, trivial, bP, trivial, rfl⟩
      · rfl
    simpa [Pder, rightConjugate, rightConjugateElem, Subgroup.conjBy] using hcommPder

/-- The Grün subgroup contains the ordinary commutator subgroup of the Sylow
subgroup. -/
private theorem huppert_IV_3_4_sylow_commutator_le_grunKernelSubgroup
    {Q : Type u} [Group Q] (P : Subgroup Q) :
    commutator P ≤
      (huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P := by
  classical
  rw [commutator, Subgroup.commutator_le]
  intro a _ b _
  exact Subgroup.mem_subgroupOf.mpr
    (huppert_IV_3_4_commutatorElement_mem_grunKernelSubgroup
      (Q := Q) P a.property b.property)

public instance huppert_IV_3_4_grunKernelSubgroup_subgroupOf_normal
    {Q : Type u} [Group Q] (P : Subgroup Q) :
    ((huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P).Normal := by
  classical
  constructor
  intro n hn g
  have hcomm : commutator P ≤
      (huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P :=
    huppert_IV_3_4_sylow_commutator_le_grunKernelSubgroup (Q := Q) P
  have hcg : ⁅g, n⁆ ∈
      (huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P :=
    hcomm (Subgroup.commutator_mem_commutator (G := P) (H₁ := ⊤) (H₂ := ⊤)
      (Subgroup.mem_top g) (Subgroup.mem_top n))
  have hmul : ⁅g, n⁆ * n ∈
      (huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P :=
    ((huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P).mul_mem hcg hn
  have heq : ⁅g, n⁆ * n = g * n * g⁻¹ := by
    rw [commutatorElement_def]
    group
  simpa [heq] using hmul

public instance huppert_IV_3_4_grunKernelSubgroup_quotient_commutative
    {Q : Type u} [Group Q] (P : Subgroup Q) :
    IsMulCommutative
      (P ⧸ (huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P) := by
  classical
  exact ⟨(Subgroup.Normal.quotient_commutative_iff_commutator_le
    (N := (huppertIV34GrunKernelSubgroup (Q := Q) P).subgroupOf P)).2
      (huppert_IV_3_4_sylow_commutator_le_grunKernelSubgroup (Q := Q) P) |>.is_comm⟩

/-- IV.3.4 transfer-core, easy direction: the transfer to `S/D` kills the
local normalizer-derived generators defining `D`. -/
private theorem huppert_IV_3_4_grunKernelSubgroup_le_transfer_to_grun_quotient_kernel_inf_sylow
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
    let πD : (S : Subgroup Q) →*
        (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
      QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
    D ≤ (MonoidHom.transfer (G := Q) (H := (S : Subgroup Q)) πD).ker ⊓
        (S : Subgroup Q) := by
  classical
  let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
  let πD : (S : Subgroup Q) →*
      (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
    QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
  let V : Q →* (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
    MonoidHom.transfer (G := Q) (H := (S : Subgroup Q)) πD
  have hD_le_sylow_comm :
      D ≤ (S : Subgroup Q) ⊓ commutator Q := by
    simpa [D] using
      huppert_IV_3_4_grunKernelSubgroup_le_sylow_inf_commutator
        (Q := Q) (P := (S : Subgroup Q))
  have hcomm_le_ker : commutator Q ≤ V.ker := by
    change ⁅(⊤ : Subgroup Q), (⊤ : Subgroup Q)⁆ ≤ V.ker
    rw [Subgroup.commutator_le]
    intro a _ha b _hb
    change V ⁅a, b⁆ = 1
    rw [map_commutatorElement]
    exact commutatorElement_eq_one_iff_commute.mpr (mul_comm (V a) (V b))
  change D ≤ V.ker ⊓ (S : Subgroup Q)
  intro x hxD
  exact ⟨hcomm_le_ker (hD_le_sylow_comm hxD).2, (hD_le_sylow_comm hxD).1⟩


/-- The `q^a = 1` cycle case used in Huppert IV.3.4: a commutator of
an element of the Sylow subgroup with an element normalizing that Sylow subgroup
is one of the local normalizer-derived generators defining the Grün subgroup. -/
private theorem huppert_IV_3_4_normalizer_commutator_mem_grunKernelSubgroup
    {Q : Type u} [Group Q] (P : Subgroup Q) {a b : Q}
    (ha : a ∈ P) (hb : b ∈ Subgroup.normalizer ((P : Subgroup Q) : Set Q)) :
    ⁅b, a⁆ ∈ huppertIV34GrunKernelSubgroup (Q := Q) P := by
  classical
  rw [huppertIV34GrunKernelSubgroup]
  apply Subgroup.subset_closure
  left
  let N : Subgroup Q := Subgroup.normalizer ((P : Subgroup Q) : Set Q)
  have haN : a ∈ N := by
    exact Subgroup.le_normalizer ha
  constructor
  · have hconj : b * a * b⁻¹ ∈ P :=
      (Subgroup.mem_normalizer_iff.mp hb a).1 ha
    simpa [commutatorElement_def, mul_assoc] using P.mul_mem hconj (P.inv_mem ha)
  · rw [Subgroup.mem_map]
    let bN : N := ⟨b, hb⟩
    let aN : N := ⟨a, haN⟩
    refine ⟨⁅bN, aN⁆, ?_, ?_⟩
    · rw [commutator]
      apply Subgroup.subset_closure
      exact ⟨bN, trivial, aN, trivial, rfl⟩
    · rfl

/-- Fixed-cycle quotient form of the previous lemma: conjugating a Sylow element
by a normalizer element does not change its image in `S/D`. -/
private theorem huppert_IV_3_4_normalizer_conj_eq_mod_grunKernelSubgroup
    {Q : Type u} [Group Q] {q : ℕ} [Fact q.Prime] (S : Sylow q Q)
    {a b : Q} (ha : a ∈ (S : Subgroup Q))
    (hb : b ∈ Subgroup.normalizer (((S : Subgroup Q) : Subgroup Q) : Set Q)) :
    let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
    let πD : (S : Subgroup Q) →*
        (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
      QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
    πD ⟨b * a * b⁻¹, (Subgroup.mem_normalizer_iff.mp hb a).1 ha⟩ =
      πD ⟨a, ha⟩ := by
  classical
  let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
  let πD : (S : Subgroup Q) →*
      (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
    QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
  change πD ⟨b * a * b⁻¹, (Subgroup.mem_normalizer_iff.mp hb a).1 ha⟩ = πD ⟨a, ha⟩
  let c : Q := ⁅b, a⁆
  have hcD : c ∈ D := by
    simpa [c] using
      (huppert_IV_3_4_normalizer_commutator_mem_grunKernelSubgroup
        (Q := Q) (P := (S : Subgroup Q)) ha hb)
  have hcS : c ∈ (S : Subgroup Q) := by
    have hD_le : D ≤ (S : Subgroup Q) ⊓ commutator Q := by
      simpa [D] using
        huppert_IV_3_4_grunKernelSubgroup_le_sylow_inf_commutator
          (Q := Q) (P := (S : Subgroup Q))
    exact (hD_le hcD).1
  let cS : (S : Subgroup Q) := ⟨c, hcS⟩
  let aS : (S : Subgroup Q) := ⟨a, ha⟩
  have hc_one : πD cS = 1 := by
    simpa [πD, cS, D, Subgroup.mem_subgroupOf] using
      (QuotientGroup.eq_one_iff (N := D.subgroupOf (S : Subgroup Q)) cS).2 hcD
  calc
    πD ⟨b * a * b⁻¹, (Subgroup.mem_normalizer_iff.mp hb a).1 ha⟩
        = πD (cS * aS) := by
          congr 1
          ext
          dsimp [cS, aS, c]
          rw [commutatorElement_def]
          group
    _ = πD cS * πD aS := by rw [map_mul]
    _ = πD ⟨a, ha⟩ := by simp [aS, hc_one]


/-- Multiplying a list of common conjugates of powers keeps the common
conjugator and adds the exponents. This is the mechanical product calculation
behind Huppert IV.3.4, Case 1, lines 21584-21587. -/
private theorem huppert_IV_3_4_list_raw_conj_prod
    {Q : Type u} [Group Q] (g U : Q) {ι : Type u} (l : List ι) (n : ι → ℕ) :
    (l.map (fun i : ι => g⁻¹ * U ^ n i * g)).prod =
      g⁻¹ * U ^ (l.map n).sum * g := by
  induction l with
  | nil => simp
  | cons i l ih =>
      calc
        (List.map (fun i : ι => g⁻¹ * U ^ n i * g) (i :: l)).prod =
            (g⁻¹ * U ^ n i * g) *
              (List.map (fun i : ι => g⁻¹ * U ^ n i * g) l).prod := by
          rfl
        _ = (g⁻¹ * U ^ n i * g) * (g⁻¹ * U ^ (l.map n).sum * g) := by
          rw [ih]
        _ = g⁻¹ * U ^ (n i + (l.map n).sum) * g := by
          rw [pow_add]
          group
        _ = g⁻¹ * U ^ (List.map n (i :: l)).sum * g := by
          rfl

set_option maxHeartbeats 800000

/-- IV.3.4 transfer-core, hard direction: if a Sylow element maps trivially
under the transfer to `S/D`, then the minimal-order/double-coset argument in
Huppert IV.3.4 forces it to lie in `D`. -/
private theorem huppert_IV_3_4_transfer_to_grun_quotient_kernel_inf_sylow_le_grunKernelSubgroup
    {Q : Type u} [Group Q] [Finite Q] {q : ℕ} [Fact q.Prime]
    (S : Sylow q Q) :
    let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) (S : Subgroup Q)
    let πD : (S : Subgroup Q) →*
        (S : Subgroup Q) ⧸ D.subgroupOf (S : Subgroup Q) :=
      QuotientGroup.mk' (D.subgroupOf (S : Subgroup Q))
    (MonoidHom.transfer (G := Q) (H := (S : Subgroup Q)) πD).ker ⊓
        (S : Subgroup Q) ≤ D := by
  classical
  -- Source: Huppert IV.3.4, reverse containment. Choose a smallest-order
  -- element `U` of `(ker V ∩ S) \ D`, decompose `Q` into `S`-double
  -- cosets, and split the right-multiplication cycles into the printed cases
  -- `q^a > 1` and `q^a = 1`.  In Case 1 only the whole nonfixed
  -- double-coset block is killed after multiplying the printed correction
  -- factors; in Case 2 a fixed block contributes `U` modulo `D`.
  let P : Subgroup Q := S
  let D : Subgroup Q := huppertIV34GrunKernelSubgroup (Q := Q) P
  let Dsub : Subgroup P := D.subgroupOf P
  let πD : P →* P ⧸ Dsub := QuotientGroup.mk' Dsub
  let V : Q →* P ⧸ Dsub := MonoidHom.transfer (G := Q) (H := P) πD
  change V.ker ⊓ P ≤ D
  intro x hx
  let U : Q := x
  have hU_ker : U ∈ V.ker := hx.1
  have hU_P : U ∈ P := hx.2
  by_contra hU_notD
  let bad : Set Q := {y | y ∈ V.ker ∧ y ∈ P ∧ y ∉ D}
  have hbad_nonempty : bad.Nonempty := by
    exact ⟨U, hU_ker, hU_P, hU_notD⟩
  have hchoose_min :
      ∃ U₀ : Q, U₀ ∈ bad ∧
        ∀ y : Q, y ∈ bad → orderOf U₀ ≤ orderOf y := by
    -- Huppert IV.3.4, lines 21538-21541: choose a counterexample of
    -- smallest possible order.
    classical
    letI : Nonempty {y : Q // y ∈ bad} := hbad_nonempty.to_subtype
    obtain ⟨u, hu⟩ :=
      Finite.exists_min (fun y : {y : Q // y ∈ bad} => orderOf (y : Q))
    exact ⟨u, u.property, fun y hy => hu ⟨y, hy⟩⟩
  rcases hchoose_min with ⟨U₀, hU₀_bad, hU₀_min⟩
  have hU₀_ker : U₀ ∈ V.ker := hU₀_bad.1
  have hU₀_P : U₀ ∈ P := hU₀_bad.2.1
  have hU₀_notD : U₀ ∉ D := hU₀_bad.2.2
  let U₀P : P := ⟨U₀, hU₀_P⟩
  let N : Subgroup Q := Subgroup.normalizer ((P : Subgroup Q) : Set Q)
  let fixedIndex : ℕ := P.relIndex N
  have hP_le_N : P ≤ N := by
    simpa [N] using
      (Subgroup.le_normalizer : P ≤ Subgroup.normalizer ((P : Subgroup Q) : Set Q))
  have hfixedIndex_not_dvd : ¬ q ∣ fixedIndex := by
    have hP_index_not_dvd : ¬ q ∣ P.index := by
      simpa [P] using S.not_dvd_index
    have hfixedIndex_dvd_index : fixedIndex ∣ P.index := by
      simpa [fixedIndex] using Subgroup.relIndex_dvd_index_of_le hP_le_N
    intro hqfixed
    exact hP_index_not_dvd (hqfixed.trans hfixedIndex_dvd_index)
  have hproper_power_conj_mem_D :
      ∀ {m : ℕ} {g : Q}, 0 < m → orderOf (U₀ ^ m) < orderOf U₀ →
        g⁻¹ * U₀ ^ m * g ∈ P → g⁻¹ * U₀ ^ m * g ∈ D := by
    -- Huppert IV.3.4, lines 21538-21541: every smaller power of the
    -- selected counterexample, after conjugating back into the Sylow subgroup,
    -- lies in `D` by minimality.
    intro m g _hm hlt hyP
    let y : Q := g⁻¹ * U₀ ^ m * g
    by_contra hyD
    have hpow_ker : U₀ ^ m ∈ V.ker := V.ker.pow_mem hU₀_ker m
    have hy_ker : y ∈ V.ker := by
      have hconj := (show V.ker.Normal from inferInstance).conj_mem (U₀ ^ m) hpow_ker g⁻¹
      simpa [y] using hconj
    have hy_bad : y ∈ bad := ⟨hy_ker, hyP, hyD⟩
    have hy_order : orderOf y = orderOf (U₀ ^ m) := by
      simpa [y, MulAut.conj_apply] using (MulAut.conj g⁻¹).orderOf_eq (U₀ ^ m)
    have hle : orderOf U₀ ≤ orderOf (U₀ ^ m) := by
      simpa [hy_order] using hU₀_min y hy_bad
    exact (not_lt_of_ge hle) hlt
  let Ω : Type u := Quotient (MulAction.orbitRel (Subgroup.zpowers U₀) (Q ⧸ P))
  haveI : Fintype Ω := by
    exact Fintype.ofFinite Ω
  let cycleRep : Ω → Q := fun ω => ω.out.out
  let cycleLength : Ω → ℕ := fun ω =>
    Function.minimalPeriod (U₀ • ·) ω.out
  let cycleElement : Ω → P := fun ω =>
    ⟨(cycleRep ω)⁻¹ * U₀ ^ cycleLength ω * cycleRep ω, by
      dsimp [cycleRep, cycleLength]
      exact QuotientGroup.out_conj_pow_minimalPeriod_mem P U₀ ω.out⟩
  let cycleContribution : Ω → P ⧸ Dsub := fun ω => πD (cycleElement ω)
  have htransfer_product :
      V U₀ = ∏ ω : Ω, cycleContribution ω := by
    -- Huppert IV.3.4, lines 21542-21559, via
    -- `MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot`.
    simpa [V, cycleContribution, cycleElement, cycleLength, cycleRep, Ω] using
      (MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot
        (ϕ := πD) (H := P) (g := U₀))
  let Δ : Type u := Quotient (MulAction.orbitRel P (Q ⧸ P))
  haveI : Fintype Δ := Fintype.ofFinite Δ
  have hzpowers_le_P : Subgroup.zpowers U₀ ≤ P := by
    intro z hz
    rcases Subgroup.mem_zpowers_iff.mp hz with ⟨n, rfl⟩
    exact P.zpow_mem hU₀_P n
  let orbitBlock : Ω → Δ := fun ω =>
    Quotient.liftOn' ω (fun a : Q ⧸ P => (Quotient.mk'' a : Δ)) (by
      intro a b hab
      apply Quotient.sound'
      rw [MulAction.orbitRel_apply] at hab ⊢
      rcases MulAction.mem_orbit_iff.mp hab with ⟨z, hz⟩
      refine ⟨⟨(z : Q), hzpowers_le_P (show (z : Q) ∈ Subgroup.zpowers U₀ from z.2)⟩, ?_⟩
      exact hz)
  let blockContribution : Δ → P ⧸ Dsub := fun δ =>
    ∏ ω : {ω : Ω // orbitBlock ω = δ}, cycleContribution ω.1
  have hregroup_transfer_product :
      (∏ ω : Ω, cycleContribution ω) =
        ∏ δ : Δ, blockContribution δ := by
    -- Huppert IV.3.4, lines 21544-21560: regroup the transfer cycles by
    -- the coarser `P`-orbit on `Q/P`, equivalently by `P`-double cosets.
    let e : (Σ δ : Δ, {ω : Ω // orbitBlock ω = δ}) ≃ Ω :=
      Equiv.sigmaFiberEquiv orbitBlock
    calc
      (∏ ω : Ω, cycleContribution ω) =
          ∏ x : (Σ δ : Δ, {ω : Ω // orbitBlock ω = δ}),
            cycleContribution (e x) := by
        simpa using (e.prod_comp cycleContribution).symm
      _ = ∏ δ : Δ, blockContribution δ := by
        simp [blockContribution, e, Fintype.prod_sigma]
  let fixedBlock : Set Δ :=
    {δ | ∀ a : Q ⧸ P, (Quotient.mk'' a : Δ) = δ →
      a ∈ MulAction.fixedPoints P (Q ⧸ P)}
  have hblock_contribution :
      ∀ δ : Δ, blockContribution δ =
        if δ ∈ fixedBlock then πD U₀P else 1 := by
    intro δ
    by_cases hδ : δ ∈ fixedBlock
    · -- Huppert IV.3.4, lines 21590-21596, Case 2 (`q^a = 1`):
      -- a singleton `P`-double-coset block is represented by an element of
      -- `N_Q(P)`, and its contribution is `U₀ [U₀,G⁻¹]`, hence `U₀`
      -- modulo the Grün subgroup.
      rw [if_pos hδ]
      let ω0 : Ω := Quotient.mk'' δ.out
      have hω0_block : orbitBlock ω0 = δ := by
        change (Quotient.mk'' δ.out : Δ) = δ
        exact Quotient.out_eq' δ
      let ω0f : {ω : Ω // orbitBlock ω = δ} := ⟨ω0, hω0_block⟩
