public abbrev higmanLowerCentralSeries (H : Type*) [Group H] : ℕ → Subgroup H :=
  (⊤ : Subgroup H).lowerCentralSeries

universe u
/-- Higman's type-C groups, with the coordinates and multiplication law from
the classification table. -/
@[expose] public def IsSuzukiTwoTypeC {G : Type u} [Group G] (S : Subgroup G) : Prop :=
  ∃ (n : ℕ) (_ : n ≠ 0)
      (theta : BinaryGaloisField n ≃+* BinaryGaloisField n)
      (epsilon : BinaryGaloisField n)
      (tripleLift :
        BinaryGaloisField n → BinaryGaloisField n → BinaryGaloisField n → G),
    epsilon ≠ 0 ∧
    (∃ r : ℕ, Odd r ∧ 0 < r ∧
      ∀ x : BinaryGaloisField n, theta^[r] x = x) ∧
    (∀ x : BinaryGaloisField n, theta (theta (x ^ 2)) = x) ∧
    (∀ rho : BinaryGaloisField n,
      epsilon ≠ rho⁻¹ + theta (rho ^ 2) * rho) ∧
    (∀ z a b : BinaryGaloisField n, tripleLift z a b ∈ S) ∧
    tripleLift 0 0 0 = 1 ∧
    (∀ x : G, x ∈ S → ∃ z a b : BinaryGaloisField n, x = tripleLift z a b) ∧
    (∀ z a b w c d : BinaryGaloisField n,
      tripleLift z a b = tripleLift w c d → z = w ∧ a = c ∧ b = d) ∧
    ∀ z a b w c d : BinaryGaloisField n,
      tripleLift z a b * tripleLift w c d =
        tripleLift
          (z + w + a * theta c +
            epsilon * a ^ (2 ^ (n - 1)) * theta (d ^ 2) + b * d)
          (a + c) (b + d)

/-- Higman's type-D groups, with the coordinates and multiplication law from
the classification table. -/
@[expose] public def IsSuzukiTwoTypeD {G : Type u} [Group G] (S : Subgroup G) : Prop :=
  ∃ (n : ℕ) (_ : n ≠ 0)
      (theta : BinaryGaloisField n ≃+* BinaryGaloisField n)
      (epsilon : BinaryGaloisField n)
      (tripleLift :
        BinaryGaloisField n → BinaryGaloisField n → BinaryGaloisField n → G),
    epsilon ≠ 0 ∧
    (∀ x : BinaryGaloisField n, theta^[5] x = x) ∧
    (∃ x : BinaryGaloisField n, theta x ≠ x) ∧
    (∀ rho : BinaryGaloisField n,
      epsilon ≠ rho⁻¹ + (theta^[4]) rho * theta rho * rho⁻¹) ∧
    (∀ z a b : BinaryGaloisField n, tripleLift z a b ∈ S) ∧
    tripleLift 0 0 0 = 1 ∧
    (∀ x : G, x ∈ S → ∃ z a b : BinaryGaloisField n, x = tripleLift z a b) ∧
    (∀ z a b w c d : BinaryGaloisField n,
      tripleLift z a b = tripleLift w c d → z = w ∧ a = c ∧ b = d) ∧
    ∀ z a b w c d : BinaryGaloisField n,
      tripleLift z a b * tripleLift w c d =
        tripleLift
          (z + w + a * theta c +
            epsilon * (theta^[3]) a * theta d + b * (theta^[2]) d)
          (a + c) (b + d)
/-- The subgroup generated by the squares of a group. This is the source
notation J² used in Higman's definition of the lower-central factors. -/
@[expose] public def squaresSubgroup (J : Type*) [Group J] : Subgroup J :=
  Subgroup.closure {x | ∃ y : J, y ^ 2 = x}

public instance squaresSubgroupCharacteristic (J : Type*) [Group J] :
    (squaresSubgroup J).Characteristic := by
  rw [Subgroup.characteristic_iff_map_le]
  intro phi
  rw [squaresSubgroup, MonoidHom.map_closure, Subgroup.closure_le]
  rintro _ ⟨x, ⟨y, rfl⟩, rfl⟩
  exact Subgroup.subset_closure ⟨phi y, by simp⟩

/-- The source denominator H_i² H_{i+1}. Lean index i represents Higman's
source index i + 1, since higmanLowerCentralSeries H 0 = H. -/
@[expose] public def lowerCentralFactorKernel (H : Type*) [Group H] (i : ℕ) :
    Subgroup (higmanLowerCentralSeries H i) :=
  squaresSubgroup (higmanLowerCentralSeries H i) ⊔
    (higmanLowerCentralSeries H (i + 1)).subgroupOf (higmanLowerCentralSeries H i)

public instance lowerCentralFactorKernelNormal (H : Type*) [Group H] (i : ℕ) :
    (lowerCentralFactorKernel H i).Normal := by
  unfold lowerCentralFactorKernel
  infer_instance

/-- Higman's L_{i+1} = H_{i+1} / (H_{i+1}² H_{i+2}), with Lean's
zero-based lower-central indexing. -/
public abbrev LowerCentralFactor (H : Type*) [Group H] (i : ℕ) :=
  (higmanLowerCentralSeries H i) ⧸ lowerCentralFactorKernel H i

/-- The restriction of an automorphism to a characteristic lower-central term. -/
@[expose] public def lowerCentralSeriesMulAut {H : Type*} [Group H]
    (theta : MulAut H) (i : ℕ) : MulAut (higmanLowerCentralSeries H i) where
  toFun x :=
    ⟨theta x, (Subgroup.characteristic_iff_le_comap.mp inferInstance theta) x.property⟩
  invFun x :=
    ⟨theta.symm x,
      (Subgroup.characteristic_iff_le_comap.mp inferInstance theta.symm) x.property⟩
  left_inv x := Subtype.ext (theta.symm_apply_apply x.val)
  right_inv x := Subtype.ext (theta.apply_symm_apply x.val)
  map_mul' x y := Subtype.ext (map_mul theta x.val y.val)

public theorem lowerCentralSeriesMulAut_apply
    {H : Type*} [Group H] (theta : MulAut H) (i : ℕ)
    (x : higmanLowerCentralSeries H i) :
    ((lowerCentralSeriesMulAut theta i x : higmanLowerCentralSeries H i) : H) =
      theta (x : H) := rfl
public theorem lowerCentralSeries_map_eq_of_surjective
    {G : Type u} {Q : Type*} [Group G] [Group Q]
    (f : G →* Q) (hf : Function.Surjective f) :
    ∀ i : ℕ, (higmanLowerCentralSeries G i).map f = higmanLowerCentralSeries Q i := by
  intro i
  induction i with
  | zero =>
      change (⊤ : Subgroup G).map f = ⊤
      exact Subgroup.map_top_of_surjective f hf
  | succ i ih =>
      change (Subgroup.map f ((⊤ : Subgroup G).lowerCentralSeries (i + 1))) =
        (⊤ : Subgroup Q).lowerCentralSeries (i + 1)
      rw [Subgroup.map_lowerCentralSeries,
        Subgroup.map_top_of_surjective f hf]

public theorem lowerCentralSeries_map_mulAut
    {H : Type u} [Group H] (theta : MulAut H) (i : ℕ) :
    (higmanLowerCentralSeries H i).map theta.toMonoidHom =
      higmanLowerCentralSeries H i := by
  apply le_antisymm
  · rintro y ⟨x, hx, rfl⟩
    exact (Subgroup.characteristic_iff_le_comap.mp inferInstance theta) hx
  · intro y hy
    refine ⟨theta.symm y, ?_, by simp⟩
    exact (Subgroup.characteristic_iff_le_comap.mp inferInstance theta.symm) hy

/-- The automorphism induced on the quotient by a lower-central term. -/
@[expose] public def lowerCentralQuotientMulAut
    {H : Type u} [Group H] (theta : MulAut H) (i : ℕ) :
    MulAut (H ⧸ higmanLowerCentralSeries H i) :=
  QuotientGroup.congr
    (G' := higmanLowerCentralSeries H i) (H' := higmanLowerCentralSeries H i)
    (e := theta) (lowerCentralSeries_map_mulAut theta i)

public theorem lowerCentralQuotientMulAut_mk
    {H : Type u} [Group H] (theta : MulAut H) (i : ℕ) (x : H) :
    lowerCentralQuotientMulAut theta i
        (QuotientGroup.mk' (higmanLowerCentralSeries H i) x) =
      QuotientGroup.mk' (higmanLowerCentralSeries H i) (theta x) := by
  rfl

/-- Inducing an automorphism on a fixed lower-central quotient is a group
homomorphism. -/
@[expose] public def lowerCentralQuotientMulAutHom
    {H : Type u} [Group H] (i : ℕ) :
    MulAut H →* MulAut (H ⧸ higmanLowerCentralSeries H i) where
  toFun theta := lowerCentralQuotientMulAut theta i
  map_one' := by
    apply MulEquiv.ext
    intro q
    obtain ⟨x, rfl⟩ :=
      QuotientGroup.mk'_surjective (higmanLowerCentralSeries H i) q
    rfl
  map_mul' a b := by
    apply MulEquiv.ext
    intro q
    obtain ⟨x, rfl⟩ :=
      QuotientGroup.mk'_surjective (higmanLowerCentralSeries H i) q
    rfl

public theorem lowerCentralQuotientMulAut_pow
    {H : Type u} [Group H] (theta : MulAut H) (i k : ℕ) :
    lowerCentralQuotientMulAut (theta ^ k) i =
      (lowerCentralQuotientMulAut theta i) ^ k := by
  exact map_pow (lowerCentralQuotientMulAutHom i) theta k

public theorem lowerCentralFactorKernel_le_comap {H : Type*} [Group H]
    (theta : MulAut H) (i : ℕ) :
    lowerCentralFactorKernel H i ≤
      (lowerCentralFactorKernel H i).comap
        (lowerCentralSeriesMulAut theta i).toMonoidHom := by
  apply sup_le
  · refine le_trans (Subgroup.characteristic_iff_le_comap.mp inferInstance
      (lowerCentralSeriesMulAut theta i)) ?_
    exact Subgroup.comap_mono le_sup_left
  · intro x hx
    change lowerCentralSeriesMulAut theta i x ∈ lowerCentralFactorKernel H i
    rw [lowerCentralFactorKernel]
    have hnext : lowerCentralSeriesMulAut theta i x ∈
        (higmanLowerCentralSeries H (i + 1)).subgroupOf (higmanLowerCentralSeries H i) := by
      change theta (x : H) ∈ higmanLowerCentralSeries H (i + 1)
      exact (Subgroup.characteristic_iff_le_comap.mp inferInstance theta)
        (show (x : H) ∈ higmanLowerCentralSeries H (i + 1) from hx)
    exact (show (higmanLowerCentralSeries H (i + 1)).subgroupOf (higmanLowerCentralSeries H i) ≤
        squaresSubgroup (higmanLowerCentralSeries H i) ⊔
          (higmanLowerCentralSeries H (i + 1)).subgroupOf (higmanLowerCentralSeries H i)
      from le_sup_right) hnext

@[expose] public def lowerCentralFactorEnd {H : Type*} [Group H]
    (theta : MulAut H) (i : ℕ) : LowerCentralFactor H i →* LowerCentralFactor H i :=
  QuotientGroup.map (lowerCentralFactorKernel H i) (lowerCentralFactorKernel H i)
    (lowerCentralSeriesMulAut theta i).toMonoidHom
    (lowerCentralFactorKernel_le_comap theta i)

/-- The automorphism induced by theta on Higman's lower-central factor
L_{i+1}. -/
@[expose] public def lowerCentralFactorMulAut {H : Type*} [Group H]
    (theta : MulAut H) (i : ℕ) : MulAut (LowerCentralFactor H i) :=
  (lowerCentralFactorEnd theta i).toMulEquiv (lowerCentralFactorEnd theta.symm i)
    (by
      apply MonoidHom.ext
      intro x
      refine Quotient.inductionOn' x ?_
      intro y
      simp [lowerCentralFactorEnd, lowerCentralSeriesMulAut])
    (by
      apply MonoidHom.ext
      intro x
      refine Quotient.inductionOn' x ?_
      intro y
      simp [lowerCentralFactorEnd, lowerCentralSeriesMulAut])

public theorem lowerCentralFactorMulAut_mk
    {H : Type*} [Group H] (theta : MulAut H) (i : ℕ)
    (x : higmanLowerCentralSeries H i) :
    lowerCentralFactorMulAut theta i
        (QuotientGroup.mk' (lowerCentralFactorKernel H i) x) =
      QuotientGroup.mk' (lowerCentralFactorKernel H i)
        (lowerCentralSeriesMulAut theta i x) :=
  rfl

/-- Higman's lower-central factors are elementary abelian: commutators of
H_{i+1} lie in H_{i+2}. -/
public instance lowerCentralFactorCommGroup {H : Type*} [Group H] (i : ℕ) :
    CommGroup (LowerCentralFactor H i) := by
  have hcomm : IsMulCommutative (LowerCentralFactor H i) := by
    rw [Subgroup.Normal.quotient_commutative_iff_commutator_le]
    intro x hx
    rw [lowerCentralFactorKernel]
    apply (show (higmanLowerCentralSeries H (i + 1)).subgroupOf
        (higmanLowerCentralSeries H i) ≤
      squaresSubgroup (higmanLowerCentralSeries H i) ⊔
        (higmanLowerCentralSeries H (i + 1)).subgroupOf (higmanLowerCentralSeries H i)
      from le_sup_right)
    change (x : H) ∈ higmanLowerCentralSeries H (i + 1)
    have hmap : (x : H) ∈
        ⁅higmanLowerCentralSeries H i, higmanLowerCentralSeries H i⁆ := by
      rw [← (higmanLowerCentralSeries H i).map_subtype_commutator]
      exact ⟨x, hx, rfl⟩
    exact (Subgroup.commutator_mono le_rfl le_top) hmap
  exact { mul_comm := hcomm.is_comm.comm }

public theorem lowerCentralFactor_sq_eq_one {H : Type*} [Group H] (i : ℕ)
    (x : LowerCentralFactor H i) : x ^ 2 = 1 := by
  refine Quotient.inductionOn' x ?_
  intro y
  change QuotientGroup.mk' (lowerCentralFactorKernel H i) (y ^ 2) = 1
  apply (QuotientGroup.eq_one_iff (N := lowerCentralFactorKernel H i) (y ^ 2)).2
  apply (show squaresSubgroup (higmanLowerCentralSeries H i) ≤ lowerCentralFactorKernel H i by
    rw [lowerCentralFactorKernel]
    exact le_sup_left)
  exact Subgroup.subset_closure ⟨y, rfl⟩

/-- The canonical F₂-vector-space structure on Higman's factor L_{i+1}. -/
public noncomputable instance lowerCentralFactorModule {H : Type*} [Group H] (i : ℕ) :
    Module (ZMod 2) (Additive (LowerCentralFactor H i)) :=
  AddCommGroup.zmodModule <| by
    intro x
    apply Additive.toMul.injective
    simp only [toMul_nsmul, toMul_zero]
    exact lowerCentralFactor_sq_eq_one i x.toMul

/-- The F₂-linear automorphism induced by theta on Higman's factor L_{i+1}. -/
@[expose] public def lowerCentralFactorLinearAut {H : Type*} [Group H]
    (theta : MulAut H) (i : ℕ) :
    Additive (LowerCentralFactor H i) ≃ₗ[ZMod 2]
      Additive (LowerCentralFactor H i) :=
  { (lowerCentralFactorMulAut theta i).toAdditive with
    map_smul' := fun c x => ZMod.map_smul
      (lowerCentralFactorMulAut theta i).toAdditive.toAddMonoidHom c x }

public theorem lowerCentralFactorLinearAut_toMul
    {H : Type*} [Group H] (theta : MulAut H) (i : ℕ)
    (x : Additive (LowerCentralFactor H i)) :
    (lowerCentralFactorLinearAut theta i x).toMul =
      lowerCentralFactorMulAut theta i x.toMul :=
  rfl

public theorem lowerCentralFactorLinearAut_ofMul_mk
    {H : Type*} [Group H] (theta : MulAut H) (i : ℕ)
    (x : higmanLowerCentralSeries H i) :
    lowerCentralFactorLinearAut theta i
        (Additive.ofMul
          (QuotientGroup.mk' (lowerCentralFactorKernel H i) x)) =
      Additive.ofMul
        (QuotientGroup.mk' (lowerCentralFactorKernel H i)
          (lowerCentralSeriesMulAut theta i x)) := by
  apply Additive.toMul.injective
  rw [lowerCentralFactorLinearAut_toMul]
  exact lowerCentralFactorMulAut_mk theta i x

/-- The induced linear actions on a fixed Higman factor form a group
homomorphism in the ambient automorphism. -/
@[expose] public def lowerCentralFactorLinearAutHom
    {H : Type u} [Group H] (i : ℕ) :
    MulAut H →* (Additive (LowerCentralFactor H i) ≃ₗ[ZMod 2]
      Additive (LowerCentralFactor H i)) where
  toFun theta := lowerCentralFactorLinearAut theta i
  map_one' := by
    apply LinearEquiv.ext
    intro v
    obtain ⟨x, hx⟩ :=
      QuotientGroup.mk'_surjective (lowerCentralFactorKernel H i) v.toMul
    have hv : v = Additive.ofMul
        (QuotientGroup.mk' (lowerCentralFactorKernel H i) x) := by
      apply Additive.toMul.injective
      exact hx.symm
    rw [hv]
    apply Additive.toMul.injective
    simp only [lowerCentralFactorLinearAut_toMul]
    apply congrArg (QuotientGroup.mk' (lowerCentralFactorKernel H i))
    apply Subtype.ext
    rfl
  map_mul' a b := by
    apply LinearEquiv.ext
    intro v
    obtain ⟨x, hx⟩ :=
      QuotientGroup.mk'_surjective (lowerCentralFactorKernel H i) v.toMul
    have hv : v = Additive.ofMul
        (QuotientGroup.mk' (lowerCentralFactorKernel H i) x) := by
      apply Additive.toMul.injective
      exact hx.symm
    rw [hv, LinearEquiv.mul_apply]
    apply Additive.toMul.injective
    simp only [lowerCentralFactorLinearAut_toMul]
    apply congrArg (QuotientGroup.mk' (lowerCentralFactorKernel H i))
    apply Subtype.ext
    rfl

public theorem lowerCentralFactorLinearAut_pow
    {H : Type u} [Group H] (theta : MulAut H) (i k : ℕ) :
    lowerCentralFactorLinearAut (theta ^ k) i =
      (lowerCentralFactorLinearAut theta i) ^ k := by
  exact map_pow (lowerCentralFactorLinearAutHom i) theta k

/-- The Higman source `2`-group field gives the cardinality of the group itself. -/
public theorem card_eq_of_isSuzukiTwoGroup {P : Type u} [Group P]
    (hP : IsSuzukiTwoGroup P) : ∃ n : ℕ, Nat.card P = 2 ^ n := by
  rcases hP.1 with ⟨n, hn⟩
  rw [Subgroup.card_top] at hn
  exact ⟨n, hn⟩

/-- A Higman Suzuki `2`-group is finite. -/
public theorem finite_of_isSuzukiTwoGroup {P : Type u} [Group P]
    (hP : IsSuzukiTwoGroup P) : Finite P := by
  rcases card_eq_of_isSuzukiTwoGroup hP with ⟨n, hn⟩
  exact Nat.finite_of_card_ne_zero (by
    rw [hn]
    exact pow_ne_zero n (by norm_num))

/-- A Higman Suzuki `2`-group is a `2`-group in Mathlib's element-order sense. -/
public theorem isPGroup_of_isSuzukiTwoGroup {P : Type u} [Group P]
    (hP : IsSuzukiTwoGroup P) : IsPGroup 2 P := by
  rcases card_eq_of_isSuzukiTwoGroup hP with ⟨n, hn⟩
  exact IsPGroup.of_card hn


/-- Invariance under Higman's chosen automorphism group `X`. -/
@[expose] public def IsXInvariantSubgroup
    (X : Type u) {P : Type u} [Group X] [Group P] [MulDistribMulAction X P]
    (A : Subgroup P) : Prop :=
  ∀ x : X, ∀ a : P, a ∈ A ↔ x • a ∈ A

/-- The center is invariant under any multiplicative automorphism action. -/
public theorem isXInvariantSubgroup_center
    (X P : Type u) [Group X] [Group P] [MulDistribMulAction X P] :
    IsXInvariantSubgroup X (Subgroup.center P) := by
  intro x a
  constructor
  · intro ha
    rw [Subgroup.mem_center_iff] at ha ⊢
    intro g
    have h := congrArg (fun t : P => x • t) (ha (x⁻¹ • g))
    simpa [smul_mul', smul_smul] using h
  · intro ha
    rw [Subgroup.mem_center_iff] at ha ⊢
    intro g
    have h := congrArg (fun t : P => x⁻¹ • t) (ha (x • g))
    simpa [smul_mul', smul_smul] using h


/-- `P` has Higman Omega-length `ell` with respect to the chosen automorphism
 group `X`. -/
@[expose] public def OmegaLength
    (X : Type u) (P : Type u) [Group X] [Group P] [MulDistribMulAction X P]
    (ell : ℕ) : Prop :=
  ∃ subgroups : Fin (ell + 1) → Subgroup P,
    subgroups 0 = ⊤ ∧
      subgroups ⟨ell, Nat.lt_succ_self ell⟩ = ⊥ ∧
        (∀ i : Fin ell, subgroups i.succ ≤ subgroups i.castSucc) ∧
          ∀ i : Fin ell,
            subgroups i.succ < subgroups i.castSucc ∧
              (subgroups i.castSucc).Normal ∧ (subgroups i.succ).Normal ∧
              IsXInvariantSubgroup X (subgroups i.castSucc) ∧
              IsXInvariantSubgroup X (subgroups i.succ) ∧
              ∀ L : Subgroup P, L.Normal → IsXInvariantSubgroup X L →
                subgroups i.succ ≤ L → L ≤ subgroups i.castSucc →
                  L = subgroups i.succ ∨ L = subgroups i.castSucc

private abbrev NormalXSubgroup
    (X : Type u) (P : Type u) [Group X] [Group P] [MulDistribMulAction X P] :=
  {A : Subgroup P // A.Normal ∧ IsXInvariantSubgroup X A}

private theorem isXInvariantSubgroup_top
    (X P : Type u) [Group X] [Group P] [MulDistribMulAction X P] :
    IsXInvariantSubgroup X (⊤ : Subgroup P) := by
  intro x a
  constructor <;> intro _ <;> exact Subgroup.mem_top a

private theorem isXInvariantSubgroup_bot
    (X P : Type u) [Group X] [Group P] [MulDistribMulAction X P] :
    IsXInvariantSubgroup X (⊥ : Subgroup P) := by
  intro x a
  constructor
  · intro ha
    simp [Subgroup.mem_bot.mp ha]
  · intro ha
    have h := congrArg (fun t : P => x⁻¹ • t) (Subgroup.mem_bot.mp ha)
    simpa [smul_smul] using h

private instance normalXSubgroupBoundedOrder
    {X P : Type u} [Group X] [Group P] [MulDistribMulAction X P] :
    BoundedOrder (NormalXSubgroup X P) where
  top := ⟨⊤, inferInstance, isXInvariantSubgroup_top X P⟩
  le_top := by
    intro A x hx
    exact Subgroup.mem_top x
  bot := ⟨⊥, inferInstance, isXInvariantSubgroup_bot X P⟩
  bot_le := by
    intro A x hx
    exact (Subgroup.mem_bot.mp hx).symm ▸ A.1.one_mem

private instance normalXSubgroupFinite
    {X P : Type u} [Group X] [Group P] [MulDistribMulAction X P] [Finite P] :
    Finite (NormalXSubgroup X P) := by
  let f : NormalXSubgroup X P → Set P := fun A => (A.1 : Set P)
  have hf : Function.Injective f := by
    intro A B h
    apply Subtype.ext
    ext x
    exact iff_of_eq (congr_fun h x)
  exact Finite.of_injective f hf

/-- A finite Higman Suzuki `2`-group has a maximal normal `X`-invariant series,
so its Omega-length exists. -/
public theorem exists_omegaLength_of_isSuzukiTwoGroup
    {X P : Type u} [Group X] [Group P] [MulDistribMulAction X P]
    (hP : IsSuzukiTwoGroup P) : ∃ ell : ℕ, OmegaLength X P ell := by
  classical
  haveI : Finite P := finite_of_isSuzukiTwoGroup hP
  let α := NormalXSubgroup X P
  have hbot_ne_top : (⊥ : α) ≠ ⊤ := by
    intro h
    have hsub : (⊥ : Subgroup P) = ⊤ := congrArg Subtype.val h
    rcases hP.2.2.1 with ⟨x, y, _hx, _hy, hxy⟩
    have hxbot : x ∈ (⊥ : Subgroup P) := by
      rw [hsub]
      exact Subgroup.mem_top x
    have hybot : y ∈ (⊥ : Subgroup P) := by
      rw [hsub]
      exact Subgroup.mem_top y
    have hx1 : x = 1 := Subgroup.mem_bot.mp hxbot
    have hy1 : y = 1 := Subgroup.mem_bot.mp hybot
    exact hxy (hx1.trans hy1.symm)
  have hbot_lt_top : (⊥ : α) < ⊤ := lt_of_le_of_ne bot_le hbot_ne_top
  let s : LTSeries α := (RelSeries.singleton _ (⊤ : α)).cons (⊥ : α) hbot_lt_top
  obtain ⟨t, _i, _hit, hhead, hlast⟩ :=
    LTSeries.exists_relSeries_covBy_and_head_eq_bot_and_last_eq_bot s
  refine ⟨t.length, fun i => ((t.reverse i).1 : Subgroup P), ?_, ?_, ?_, ?_⟩
  · have hTop : t.reverse.head = (⊤ : α) := by
      rw [RelSeries.head_reverse]
      exact hlast
    change ((t.reverse.head).1 : Subgroup P) = ⊤
    exact congrArg Subtype.val hTop
  · have hBot : t.reverse.last = (⊥ : α) := by
      rw [RelSeries.last_reverse]
      exact hhead
    change ((t.reverse.last).1 : Subgroup P) = ⊥
    exact congrArg Subtype.val hBot
  · intro i
    have hcov := t.reverse.step i
    exact hcov.le
  · intro i
    have hcov := t.reverse.step i
    refine ⟨hcov.lt, (t.reverse i.castSucc).2.1, (t.reverse i.succ).2.1,
      (t.reverse i.castSucc).2.2, (t.reverse i.succ).2.2, ?_⟩
    intro L hLnormal hLX hML hLN
    let Lx : α := ⟨L, hLnormal, hLX⟩
    have hMLx : t.reverse i.succ ≤ Lx := hML
    have hLNx : Lx ≤ t.reverse i.castSucc := hLN
    have hcase := hcov.wcovBy.eq_or_eq hMLx hLNx
    rcases hcase with hcase | hcase
    · left
      exact congrArg Subtype.val hcase
    · right
      exact congrArg Subtype.val hcase

/-- A Higman Suzuki `2`-group cannot have Omega-length zero. -/
public theorem not_omegaLength_zero_of_isSuzukiTwoGroup
    {X P : Type u} [Group X] [Group P] [MulDistribMulAction X P]
    (hP : IsSuzukiTwoGroup P) : ¬ OmegaLength X P 0 := by
  rintro ⟨subgroups, htop, hbot, _hle, _hatoms⟩
  have htopbot : (⊤ : Subgroup P) = ⊥ := by
    rw [← htop]
    exact hbot
  rcases hP.2.2.1 with ⟨x, y, _hx, _hy, hxy⟩
  have hxbot : x ∈ (⊥ : Subgroup P) := by
    rw [← htopbot]
    exact Subgroup.mem_top x
  have hybot : y ∈ (⊥ : Subgroup P) := by
    rw [← htopbot]
    exact Subgroup.mem_top y
  have hx1 : x = 1 := Subgroup.mem_bot.mp hxbot
  have hy1 : y = 1 := Subgroup.mem_bot.mp hybot
  exact hxy (hx1.trans hy1.symm)

/-- A Higman Suzuki `2`-group cannot have Omega-length one: the center is a
proper nontrivial normal `X`-invariant subgroup between `⊥` and `⊤`. -/
public theorem not_omegaLength_one_of_isSuzukiTwoGroup
    {X P : Type u} [Group X] [Group P] [MulDistribMulAction X P]
    (hP : IsSuzukiTwoGroup P) : ¬ OmegaLength X P 1 := by
  rintro ⟨subgroups, htop, hbot, _hle, hatoms⟩
  have hs0 : subgroups ⟨0, by decide⟩ = (⊤ : Subgroup P) := by
    simpa using htop
  have hs1 : subgroups ⟨1, by decide⟩ = (⊥ : Subgroup P) := by
    simpa using hbot
  have hatom := hatoms ⟨0, by decide⟩
  change
    subgroups ⟨1, by decide⟩ < subgroups ⟨0, by decide⟩ ∧
      (subgroups ⟨0, by decide⟩).Normal ∧ (subgroups ⟨1, by decide⟩).Normal ∧
      IsXInvariantSubgroup X (subgroups ⟨0, by decide⟩) ∧
      IsXInvariantSubgroup X (subgroups ⟨1, by decide⟩) ∧
      ∀ L : Subgroup P, L.Normal → IsXInvariantSubgroup X L →
        subgroups ⟨1, by decide⟩ ≤ L → L ≤ subgroups ⟨0, by decide⟩ →
          L = subgroups ⟨1, by decide⟩ ∨ L = subgroups ⟨0, by decide⟩ at hatom
  rw [hs0, hs1] at hatom
  rcases hatom with ⟨_hlt, _htop_normal, _hbot_normal, _htop_X, _hbot_X, hminimal⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Finite P := finite_of_isSuzukiTwoGroup hP
  rcases hP.2.2.1 with ⟨x, y, _hx, _hy, hxy⟩
  haveI : Nontrivial P := ⟨⟨x, y, hxy⟩⟩
  have hcenter_ne_bot : Subgroup.center P ≠ ⊥ :=
    ne_of_gt (isPGroup_of_isSuzukiTwoGroup hP).bot_lt_center
  have hcenter_case := hminimal (Subgroup.center P) inferInstance
    (isXInvariantSubgroup_center X P) bot_le le_top
  rcases hcenter_case with hcenter_bot | hcenter_top
  · exact hcenter_ne_bot hcenter_bot
  · letI : CommGroup P := Group.commGroupOfCenterEqTop hcenter_top
    have hcomm : IsMulCommutative P := by
      refine IsMulCommutative.mk <| Std.Commutative.mk ?_
      intro a b
      exact mul_comm a b
    exact hP.2.1 hcomm

/-- Once an Omega-length exists, excluding lengths zero and one gives Higman's
initial length trichotomy: length two, length three, or length greater than
three. -/
public theorem omegaLength_trichotomy_of_exists_omegaLength
    {X P : Type u} [Group X] [Group P] [MulDistribMulAction X P]
    (hP : IsSuzukiTwoGroup P)
    (hLengthExists : ∃ ell : ℕ, OmegaLength X P ell) :
    OmegaLength X P 2 ∨ OmegaLength X P 3 ∨
      (∃ m : ℕ, 3 < m ∧ OmegaLength X P m) := by
  rcases hLengthExists with ⟨ell, hLen⟩
  cases ell with
  | zero => exact False.elim ((not_omegaLength_zero_of_isSuzukiTwoGroup hP) hLen)
  | succ ell =>
      cases ell with
      | zero => exact False.elim ((not_omegaLength_one_of_isSuzukiTwoGroup hP) hLen)
      | succ ell =>
          cases ell with
          | zero => exact Or.inl hLen
          | succ ell =>
              cases ell with
              | zero => exact Or.inr (Or.inl hLen)
              | succ ell =>
                  have hgt : 3 < Nat.succ (Nat.succ (Nat.succ (Nat.succ ell))) :=
                    Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.succ_lt_succ (Nat.zero_lt_succ ell)))
                  exact Or.inr (Or.inr
                    ⟨Nat.succ (Nat.succ (Nat.succ (Nat.succ ell))), hgt, hLen⟩)

end Higman
