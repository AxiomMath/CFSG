module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.StrongEmbeddingFusion
public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.StrongEmbeddingIntersections
import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.PFchapter1section1.proposition_2_a

namespace CFSG
end CFSG
open CFSG

/-!
# Conjugacy of involutions under strong embedding

This file proves `[IG; 17.8(i)]`: the involutions of a strongly embedded
subgroup form one conjugacy class inside that subgroup, and all ambient
involutions form one conjugacy class in the ambient group.

The key local step is that the product of an involution in `M` with an
involution outside `M` has odd order.  Otherwise an involution in the cyclic
subgroup generated by that product commutes with both factors.  Uniqueness of
its fixed coset then forces the outside involution back into `M`.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1

universe u

private theorem exists_involution_mem_zpowers_of_even_order
    {X : Type u} [Group X] [Finite X] {r : X}
    (hrEven : Even (orderOf r)) :
    ∃ w : X, w ∈ Subgroup.zpowers r ∧ IsInvolution w := by
  classical
  let C : Subgroup X := Subgroup.zpowers r
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have htwo : 2 ∣ Nat.card C := by
    simpa [C, Nat.card_zpowers] using hrEven.two_dvd
  obtain ⟨w, hwOrder⟩ :=
    exists_prime_orderOf_dvd_card' (G := C) 2 htwo
  refine ⟨(w : X), w.property, ?_⟩
  have hwOrderX : orderOf (w : X) = 2 := by
    rw [Subgroup.orderOf_coe, hwOrder]
  have hw := (orderOf_eq_prime_iff (x := (w : X)) (p := 2)).mp hwOrderX
  exact ⟨hw.2, hw.1⟩

private theorem commute_with_zpowers_involution_of_product
    {X : Type u} [Group X] {s t w : X}
    (hs : IsInvolution s) (ht : IsInvolution t) (hw : IsInvolution w)
    (hwMem : w ∈ Subgroup.zpowers (s * t)) :
    Commute s w ∧ Commute t w := by
  rcases Subgroup.mem_zpowers_iff.mp hwMem with ⟨n, hn⟩
  have hsInv : s⁻¹ = s := hs.inv_eq_self
  have htInv : t⁻¹ = t := ht.inv_eq_self
  have hwInv : w⁻¹ = w := hw.inv_eq_self
  have hss : s * s = 1 := by
    simpa [pow_two] using hs.sq_eq_one
  have hsSemi : SemiconjBy s (s * t) (s * t)⁻¹ := by
    change s * (s * t) = (s * t)⁻¹ * s
    rw [mul_inv_rev, hsInv, htInv, ← mul_assoc, hss, one_mul,
      mul_assoc, hss, mul_one]
  have htSemi : SemiconjBy t (s * t) (s * t)⁻¹ := by
    change t * (s * t) = (s * t)⁻¹ * t
    simp [hsInv, htInv, mul_assoc]
  constructor
  · change s * w = w * s
    have h := hsSemi.zpow_right n
    have hright : ((s * t)⁻¹) ^ n = w := by
      rw [inv_zpow, hn, hwInv]
    simpa only [hn, hright] using h.eq
  · change t * w = w * t
    have h := htSemi.zpow_right n
    have hright : ((s * t)⁻¹) ^ n = w := by
      rw [inv_zpow, hn, hwInv]
    simpa only [hn, hright] using h.eq

namespace IsStronglyEmbedded

/-- If `s` is an involution in a strongly embedded subgroup `M` and `t` is
an involution outside `M`, then `s * t` has odd order. -/
public theorem orderOf_mul_odd_of_mem_not_mem
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {s t : X}
    (hsM : s ∈ M) (hs : IsInvolution s)
    (htM : t ∉ M) (ht : IsInvolution t) :
    Odd (orderOf (s * t)) := by
  let alpha : conjugateCosetSpace M := QuotientGroup.mk 1
  have hsFix : s • alpha = alpha := by
    apply MulAction.mem_stabilizer_iff.mp
    rw [baseCoset_stabilizer M]
    exact hsM
  have htNotFix : t • alpha ≠ alpha := by
    intro htFix
    apply htM
    have htStab : t ∈ MulAction.stabilizer X alpha :=
      MulAction.mem_stabilizer_iff.mpr htFix
    rwa [baseCoset_stabilizer M] at htStab
  apply Nat.not_even_iff_odd.mp
  intro hEven
  obtain ⟨w, hwMem, hw⟩ :=
    exists_involution_mem_zpowers_of_even_order hEven
  obtain ⟨hsw, htw⟩ :=
    commute_with_zpowers_involution_of_product hs ht hw hwMem
  obtain ⟨gamma, hwGamma, hwUnique⟩ :=
    hM.involution_fixed_coset_unique hw
  have hsGamma : s • gamma = gamma := by
    apply hwUnique
    calc
      w • (s • gamma) = (w * s) • gamma := by rw [mul_smul]
      _ = (s * w) • gamma := by rw [hsw.eq]
      _ = s • (w • gamma) := by rw [mul_smul]
      _ = s • gamma := by rw [hwGamma]
  have htGamma : t • gamma = gamma := by
    apply hwUnique
    calc
      w • (t • gamma) = (w * t) • gamma := by rw [mul_smul]
      _ = (t * w) • gamma := by rw [htw.eq]
      _ = t • (w • gamma) := by rw [mul_smul]
      _ = t • gamma := by rw [hwGamma]
  have hGammaAlpha : gamma = alpha :=
    (hM.involution_fixed_coset_unique hs).unique hsGamma hsFix
  apply htNotFix
  rw [← hGammaAlpha]
  exact htGamma

/-- The involutions of a strongly embedded subgroup form one conjugacy class
inside that subgroup.  This is the subgroup half of `[IG; 17.8(i)]`. -/
public theorem involutions_conjugate_in
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {a b : X}
    (haM : a ∈ M) (ha : IsInvolution a)
    (hbM : b ∈ M) (hb : IsInvolution b) :
    ∃ g : X, g ∈ M ∧ rightConjugateElem a g = b := by
  obtain ⟨t, ht, htM⟩ := hM.exists_involution_not_mem
  have hat : a ≠ t := fun h => htM (h ▸ haM)
  have hbt : b ≠ t := fun h => htM (h ▸ hbM)
  obtain ⟨u, _, hau⟩ := exists_involution_conjugator_of_odd_product
    ha ht hat (hM.orderOf_mul_odd_of_mem_not_mem haM ha htM ht)
  obtain ⟨v, _, hbv⟩ := exists_involution_conjugator_of_odd_product
    hb ht hbt (hM.orderOf_mul_odd_of_mem_not_mem hbM hb htM ht)
  have hab : rightConjugateElem a (u * v⁻¹) = b := by
    calc
      rightConjugateElem a (u * v⁻¹) =
          rightConjugateElem (rightConjugateElem a u) v⁻¹ := by
            rw [rightConjugateElem_comp]
      _ = rightConjugateElem t v⁻¹ := by rw [hau]
      _ = rightConjugateElem (rightConjugateElem b v) v⁻¹ := by rw [hbv]
      _ = b := by
        rw [rightConjugateElem_comp]
        simp [rightConjugateElem]
  exact hM.involution_fusion_control.exists_conjugator haM hbM ha hab

/-- All involutions of a finite group with a strongly embedded subgroup form
one ambient conjugacy class.  Together with `involutions_conjugate_in`, this
is `[IG; 17.8(i)]`. -/
public theorem involutions_conjugate
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x y : X}
    (hx : IsInvolution x) (hy : IsInvolution y) :
    ∃ g : X, rightConjugateElem x g = y := by
  obtain ⟨gx, hxg⟩ := hM.involution_mem_conjugate hx
  obtain ⟨gy, hyg⟩ := hM.involution_mem_conjugate hy
  let a : X := rightConjugateElem x gx⁻¹
  let b : X := rightConjugateElem y gy⁻¹
  have haM : a ∈ M := by
    apply rightConjugateElem_mem_of_mem_rightConjugate (g := gx⁻¹)
    simpa only [inv_inv] using hxg
  have hbM : b ∈ M := by
    apply rightConjugateElem_mem_of_mem_rightConjugate (g := gy⁻¹)
    simpa only [inv_inv] using hyg
  have ha : IsInvolution a := isInvolution_rightConjugateElem hx
  have hb : IsInvolution b := isInvolution_rightConjugateElem hy
  obtain ⟨m, _, hm⟩ := hM.involutions_conjugate_in haM ha hbM hb
  refine ⟨gx⁻¹ * m * gy, ?_⟩
  calc
    rightConjugateElem x (gx⁻¹ * m * gy) =
        rightConjugateElem
          (rightConjugateElem (rightConjugateElem x gx⁻¹) m) gy := by
            simp [rightConjugateElem, mul_assoc]
    _ = rightConjugateElem b gy := by rw [hm]
    _ = y := by
      dsimp [b]
      rw [rightConjugateElem_comp]
      simp [rightConjugateElem]

/-- If the odd core centralizes one involution, then it is central whenever a
strongly embedded subgroup makes all involutions conjugate and the ambient
group is generated by its involutions. -/
public theorem twoPrimeCore_le_center_of_involutionCore_eq_top
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {u : X} (hu : IsInvolution u)
    (huCentral : twoPrimeCore X ≤ Subgroup.centralizer ({u} : Set X))
    (hgen : involutionCore X = ⊤) :
    twoPrimeCore X ≤ Subgroup.center X := by
  intro q hq
  rw [Subgroup.mem_center_iff]
  intro x
  have hIcentral :
      involutionsSet X ⊆ Subgroup.centralizer ({q} : Set X) := by
    intro t ht
    have htInv : IsInvolution t := ht
    obtain ⟨g, hgt⟩ := hM.involutions_conjugate hu htInv
    have hqgCore : g * q * g⁻¹ ∈ twoPrimeCore X :=
      (inferInstance : (twoPrimeCore X).Normal).conj_mem q hq g
    have hqgCommuteU : Commute (g * q * g⁻¹) u :=
      Subgroup.mem_centralizer_singleton_iff.mp (huCentral hqgCore)
    have hqCommuteT : Commute q t := by
      have hconj := hqgCommuteU.conj g⁻¹
      have huConj : g⁻¹ * (u * g) = t := by
        simpa [rightConjugateElem, mul_assoc] using hgt
      simpa [huConj, mul_assoc] using hconj
    exact Subgroup.mem_centralizer_singleton_iff.mpr hqCommuteT.eq.symm
  have hcore_le :
      involutionCore X ≤ Subgroup.centralizer ({q} : Set X) := by
    rw [involutionCore_eq_closure, Subgroup.closure_le]
    exact hIcentral
  have hxCentral : x ∈ Subgroup.centralizer ({q} : Set X) := by
    apply hcore_le
    rw [hgen]
    exact Subgroup.mem_top x
  exact Subgroup.mem_centralizer_singleton_iff.mp hxCentral

end IsStronglyEmbedded
end CFSG.BenderSuzuki
