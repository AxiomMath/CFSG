module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.Basic

namespace CFSG
end CFSG
open CFSG

/-!
# Normality of the involution core

The set of involutions is invariant under conjugation, so the subgroup it
generates is normal.  In a simple group containing an involution, that normal
subgroup is the whole group.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII

universe u

/-- The subgroup generated by all involutions is normal. -/
public instance involutionCore_normal {X : Type u} [Group X] :
    (involutionCore X).Normal := by
  rw [involutionCore_eq_closure]
  refine ⟨?_⟩
  intro a ha g
  refine Subgroup.closure_induction
    (p := fun a : X => fun _ha =>
      g * a * g⁻¹ ∈ Subgroup.closure (involutionsSet X))
    ?_ ?_ ?_ ?_ ha
  · intro x hx
    apply Subgroup.subset_closure
    change IsInvolution (g * x * g⁻¹)
    have hx' : IsInvolution x := hx
    simpa [rightConjugateElem, mul_assoc] using
      (isInvolution_rightConjugateElem (g := g⁻¹) hx')
  · simp
  · intro x y _hx _hy hx hy
    simpa [mul_assoc] using
      (Subgroup.closure (involutionsSet X)).mul_mem hx hy
  · intro x _hx hx
    have hconj_inv : g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ := by
      simp [mul_assoc]
    simpa [hconj_inv] using
      (Subgroup.closure (involutionsSet X)).inv_mem hx

/-- The involution core, regarded as a group in its own right, is generated by
its involutions. -/
public theorem involutionCore_involutionCore_eq_top
    (X : Type u) [Group X] :
    involutionCore (involutionCore X) = ⊤ := by
  apply top_unique
  intro x _hx
  change x ∈ Subgroup.closure (involutionsSet (involutionCore X))
  refine Subgroup.closure_induction
    (p := fun y hy =>
      (⟨y, hy⟩ : involutionCore X) ∈
        Subgroup.closure (involutionsSet (involutionCore X)))
    ?_ ?_ ?_ ?_ x.property
  · intro y hy
    apply Subgroup.subset_closure
    exact IsInvolution.subtype hy (Subgroup.subset_closure hy)
  · exact Subgroup.one_mem
      (Subgroup.closure (involutionsSet (involutionCore X)))
  · intro a b _ha _hb hca hcb
    convert
      (Subgroup.mul_mem (Subgroup.closure
        (involutionsSet (involutionCore X))) hca hcb) using 1
    all_goals (apply Subtype.ext; rfl)
  · intro a _ha hca
    exact Subgroup.inv_mem
      (Subgroup.closure (involutionsSet (involutionCore X))) hca

/-- A group equivalence transports the subgroup generated by involutions. -/
public theorem involutionCore_map_mulEquiv
    {G H : Type*} [Group G] [Group H] (e : G ≃* H) :
    (involutionCore G).map e.toMonoidHom = involutionCore H := by
  rw [involutionCore_eq_closure, involutionCore_eq_closure,
    MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact IsInvolution.map_of_injective hx e.toMonoidHom e.injective
  · intro hy
    refine ⟨e.symm y, ?_, by simp⟩
    exact IsInvolution.map_of_injective hy e.symm.toMonoidHom e.symm.injective

/-- The involution core is fixed by every automorphism. -/
public instance involutionCore_characteristic {X : Type*} [Group X] :
    (involutionCore X).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  exact involutionCore_map_mulEquiv

set_option backward.isDefEq.respectTransparency false in
/-- A group equivalence induces an equivalence between the quotient by a
normal subgroup and the quotient by its image. -/
public noncomputable def quotientMulEquivOfMulEquiv
    {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (N : Subgroup G) [N.Normal]
    [(N.map e.toMonoidHom).Normal] :
    (G ⧸ N) ≃* (H ⧸ (N.map e.toMonoidHom)) := by
  let f : (G ⧸ N) →* (H ⧸ (N.map e.toMonoidHom)) :=
    QuotientGroup.map N (N.map e.toMonoidHom) e.toMonoidHom (by
      intro x hx
      exact Subgroup.mem_map_of_mem e.toMonoidHom hx)
  let g : (H ⧸ (N.map e.toMonoidHom)) →* (G ⧸ N) :=
    QuotientGroup.map (N.map e.toMonoidHom) N e.symm.toMonoidHom (by
      intro y hy
      rcases Subgroup.mem_map.mp hy with ⟨x, hx, rfl⟩
      simpa using hx)
  exact MonoidHom.toMulEquiv f g
    (by
      apply MonoidHom.ext
      intro x
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N x
      change g (f (QuotientGroup.mk x)) = QuotientGroup.mk x
      rw [QuotientGroup.map_mk, QuotientGroup.map_mk]
      simp)
    (by
      apply MonoidHom.ext
      intro y
      obtain ⟨y, rfl⟩ :=
        QuotientGroup.mk'_surjective (N.map e.toMonoidHom) y
      change f (g (QuotientGroup.mk y)) = QuotientGroup.mk y
      rw [QuotientGroup.map_mk, QuotientGroup.map_mk]
      simp)

@[simp] public theorem quotientMulEquivOfMulEquiv_mk
    {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (N : Subgroup G) [N.Normal]
    [(N.map e.toMonoidHom).Normal] (x : G) :
    quotientMulEquivOfMulEquiv e N (QuotientGroup.mk x) =
      QuotientGroup.mk (e x) := by
  rfl

/-- The ambient image of an involution core is again generated by its own
involutions. -/
public theorem involutionCore_map_subtype_eq_top
    {X : Type*} [Group X] (F : Subgroup X) :
    involutionCore ((involutionCore F).map F.subtype) = ⊤ := by
  let C : Subgroup F := involutionCore F
  let L : Subgroup X := C.map F.subtype
  let e : C ≃* L := by
    simpa [L] using
      (Subgroup.equivMapOfInjective C F.subtype Subtype.val_injective)
  have hmap := involutionCore_map_mulEquiv e
  have hCtop : involutionCore C = ⊤ := by
    simpa [C] using involutionCore_involutionCore_eq_top F
  rw [hCtop, Subgroup.map_top_of_surjective e.toMonoidHom e.surjective] at hmap
  simpa [L, C] using hmap.symm

namespace IsStronglyEmbedded

/-- In a simple group with a strongly embedded subgroup, the involutions
generate the whole ambient group. -/
public theorem involutionCore_eq_top_of_isSimple
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) (hX : IsSimpleGroup X) :
    involutionCore X = ⊤ := by
  rcases (hX.eq_bot_or_eq_top_of_normal (involutionCore X)) with
    hcore | hcore
  · obtain ⟨x, _hxM, hx⟩ := hM.exists_involution
    have hxcore : x ∈ involutionCore X := by
      rw [involutionCore_eq_closure]
      exact Subgroup.subset_closure hx
    rw [hcore] at hxcore
    exact (hx.ne_one (Subgroup.mem_bot.mp hxcore)).elim
  · exact hcore

end IsStronglyEmbedded
end CFSG.BenderSuzuki
