module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.Basic
public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.PFchapter1section1.Basic

namespace CFSG
end CFSG
open CFSG

/-!
# First consequences of strong embedding

The initial reduction for Theorem SE repeatedly uses that every involution of
the ambient group occurs in a conjugate of the strongly embedded subgroup.
This file proves that fact directly from Sylow conjugacy and records the
corresponding containment for the involution core.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1

universe u

public theorem isPGroup_zpowers_of_involution
    {X : Type u} [Group X] [Finite X] {x : X} (hx : IsInvolution x) :
    IsPGroup 2 (Subgroup.zpowers x) := by
  have horder : orderOf x = 2 :=
    (orderOf_eq_prime_iff).2 ⟨hx.sq_eq_one, hx.ne_one⟩
  apply IsPGroup.of_card (p := 2) (G := Subgroup.zpowers x) (n := 1)
  simp [Nat.card_zpowers, horder]

namespace IsStronglyEmbedded

/-- Every involution of `X` belongs to a right conjugate of a strongly
embedded subgroup `M`. -/
public theorem involution_mem_conjugate
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x : X} (hx : IsInvolution x) :
    ∃ g : X, x ∈ rightConjugate M g := by
  obtain ⟨Q, hQM⟩ := hM.containsSylowTwo
  have hxp : IsPGroup 2 (Subgroup.zpowers x) :=
    isPGroup_zpowers_of_involution hx
  obtain ⟨P, hxP⟩ := hxp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq X P Q
  have hxQ : g * x * g⁻¹ ∈ (Q : Subgroup X) := by
    rw [← hg]
    change g * x * g⁻¹ ∈
      (P : Subgroup X).map (MulAut.conj g).toMonoidHom
    exact Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom
      (hxP (Subgroup.mem_zpowers x))
  refine ⟨g, ?_⟩
  rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map]
  refine ⟨g * x * g⁻¹, hQM hxQ, ?_⟩
  simp [mul_assoc]

/-- The involution core is contained in the subgroup generated by all
conjugates of a strongly embedded subgroup. -/
public theorem involutionCore_le_iSup_conjugates
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) :
    involutionCore X ≤ ⨆ g : X, rightConjugate M g := by
  rw [involutionCore_eq_closure]
  rw [Subgroup.closure_le]
  intro x hx
  have hx' : IsInvolution x := hx
  rcases hM.involution_mem_conjugate hx' with ⟨g, hxg⟩
  exact (le_iSup (fun a : X => rightConjugate M a) g) hxg

end IsStronglyEmbedded
end CFSG.BenderSuzuki
