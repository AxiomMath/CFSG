module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.StrongEmbeddingConjugacy
public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.PFAppendixII.proposition_1
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.FinalTheorem

namespace CFSG
end CFSG
open CFSG

/-!
# The rank-one solvability exclusion

The source invokes the rank-one/Brauer--Suzuki alternative before Bender
recognition.  This module isolates that order of reasoning: a strongly
embedded subgroup of a group generated by its involutions cannot have
2-rank one unless the ambient group is solvable.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1
open scoped IsMulCommutative

universe u

public theorem twoRankAtLeastTwo_of_contains_sylow
    {G : Type u} [Group G] [Finite G]
    {M : Subgroup G} (P : Sylow 2 G) (hPM : (P : Subgroup G) ≤ M)
    (hG : TwoRankAtLeastTwo G) : TwoRankAtLeastTwo M := by
  rcases hG with ⟨E, hEcard, hEsq⟩
  have hEp : IsPGroup 2 E := by
    apply IsPGroup.of_card (p := 2) (G := E) (n := 2)
    simpa [hEcard]
  obtain ⟨S, hES⟩ := hEp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G S P
  let fG : E →* G := (MulAut.conj g).toMonoidHom.comp E.subtype
  have hfG_inj : Function.Injective fG := by
    intro a b hab
    apply Subtype.ext
    apply (MulAut.conj g).injective
    simpa [fG] using hab
  have hfG_mem_P : ∀ e : E, fG e ∈ (P : Subgroup G) := by
    intro e
    rw [show (P : Subgroup G) = ((g • S : Sylow 2 G) : Subgroup G) from
      congrArg (fun Q : Sylow 2 G => (Q : Subgroup G)) hg.symm]
    rw [Sylow.coe_subgroup_smul]
    exact Set.mem_smul_set.mpr ⟨e, hES e.property, rfl⟩
  let fM : E →* M := fG.codRestrict M (fun e => hPM (hfG_mem_P e))
  have hfM_inj : Function.Injective fM := by
    intro a b hab
    exact hfG_inj (by simpa [fM] using congrArg Subtype.val hab)
  let EM : Subgroup M := (⊤ : Subgroup E).map fM
  have hEMcard : Nat.card EM = 4 := by
    rw [Subgroup.card_map_of_injective hfM_inj]
    calc
      Nat.card (⊤ : Subgroup E) = Nat.card E :=
        Nat.card_congr (Subgroup.topEquiv : (⊤ : Subgroup E) ≃* E).toEquiv
      _ = 4 := hEcard
  refine ⟨EM, hEMcard, ?_⟩
  rintro ⟨x, hx⟩
  rcases hx with ⟨e, _he, rfl⟩
  apply Subtype.ext
  simpa using congrArg fM (hEsq e)

/-- If the involution core is the whole group, nonsolvability forces the
strongly embedded subgroup to have a four-subgroup.  The proof uses the
independent rank-one odd-core/centralizer factorization, so it does not call
the later Bender recognition theorem. -/
public theorem IsStronglyEmbedded.twoRankAtLeastTwo_of_not_solvable_of_involutionCore_eq_top
    {G : Type u} [Group G] [Finite G]
    {M : Subgroup G} (hM : IsStronglyEmbedded M)
    (hcore : involutionCore G = ⊤)
    (hnsolv : ¬ Group.IsSolvable G) :
    TwoRankAtLeastTwo M := by
  by_contra hMrank
  obtain ⟨P, hPM⟩ := hM.containsSylowTwo
  have hGrank : ¬ TwoRankAtLeastTwo G := by
    intro hG
    exact hMrank (twoRankAtLeastTwo_of_contains_sylow P hPM hG)
  obtain ⟨u, huM, hu⟩ := hM.exists_involution
  have hfactor :=
    PFAppendixII.pPrimeCore_sup_centralizer_eq_top_of_not_twoRank hGrank hu
  let N : Subgroup G := pPrimeCore 2 G
  let Q := G ⧸ N
  let q : G →* Q := QuotientGroup.mk' N
  have hNnormal : N.Normal := by
    dsimp [N]
    exact pPrimeCore_normal
  letI : N.Normal := hNnormal
  have hqcenter : q u ∈ Subgroup.center Q := by
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N y
    have hgSup : g ∈ N ⊔ Subgroup.centralizer ({u} : Set G) := by
      have htop : N ⊔ Subgroup.centralizer ({u} : Set G) = ⊤ := by
        simpa [N] using hfactor
      rw [htop]
      exact Subgroup.mem_top g
    rcases Subgroup.mem_sup_of_normal_left.mp hgSup with
      ⟨n, hn, c, hc, hnc⟩
    have hcomm : c * u = u * c :=
      Subgroup.mem_centralizer_singleton_iff.mp hc
    have hqn : q n = 1 := (QuotientGroup.eq_one_iff n).2 hn
    have hqg : q g = q c := by
      calc
        q g = q (n * c) := by rw [hnc]
        _ = q n * q c := map_mul q n c
        _ = q c := by rw [hqn, one_mul]
    calc
      q g * q u = q c * q u := by rw [hqg]
      _ = q u * q c := by simpa using congrArg q hcomm
      _ = q u * q g := by rw [hqg]
  have hq_involutions : ∀ x : G, IsInvolution x → q x = q u := by
    intro x hx
    obtain ⟨g, hg⟩ := hM.involutions_conjugate hu hx
    have hcomm : q u * q g = q g * q u :=
      (Subgroup.mem_center_iff.mp hqcenter (q g)).symm
    calc
      q x = q (rightConjugateElem u g) := by rw [hg]
      _ = (q g)⁻¹ * q u * q g := by simp [q, rightConjugateElem]
      _ = (q g)⁻¹ * (q u * q g) := by rw [mul_assoc]
      _ = (q g)⁻¹ * (q g * q u) := by rw [hcomm]
      _ = (q g)⁻¹ * q g * q u := by rw [← mul_assoc]
      _ = q u := by simp
  let K : Subgroup G := (Subgroup.zpowers (q u)).comap q
  have hcoreK : involutionCore G ≤ K := by
    rw [involutionCore_eq_closure, Subgroup.closure_le]
    intro x hx
    change q x ∈ Subgroup.zpowers (q u)
    rw [hq_involutions x hx]
    exact Subgroup.mem_zpowers _
  have hKtop : K = ⊤ := by
    apply top_unique
    intro g _hg
    apply hcoreK
    rw [hcore]
    exact Subgroup.mem_top g
  have hqtop : Subgroup.zpowers (q u) = ⊤ := by
    apply top_unique
    intro y _hy
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N y
    have hgK : g ∈ K := by
      rw [hKtop]
      exact Subgroup.mem_top g
    exact hgK
  letI : IsCyclic Q :=
    (isCyclic_iff_exists_zpowers_eq_top (α := Q)).2 ⟨q u, hqtop⟩
  letI : IsMulCommutative Q := IsCyclic.isMulCommutative
  have hQsolv : Group.IsSolvable Q :=
    Group.isSolvable_of_comm (fun a b : Q => mul_comm a b)
  have hNodd : Odd (Nat.card N) := by
    exact Nat.coprime_two_left.mp (by
      simpa [N] using (pPrimeCore_coprime_card (G := G) (p := 2)))
  have hNsolv : Group.IsSolvable N := odd_order_theorem N hNodd
  letI : Group.IsSolvable N := hNsolv
  letI : Group.IsSolvable Q := hQsolv
  exact hnsolv (isSolvable_of_normal_subgroup_and_quotient N)

end CFSG.BenderSuzuki
