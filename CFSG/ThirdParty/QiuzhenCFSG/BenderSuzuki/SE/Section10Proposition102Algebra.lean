module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.Section10Lemma106Final
public import CFSG.ThirdParty.QiuzhenCFSG.FeitThompson.Commutator.Core
import Mathlib.GroupTheory.IsPerfect

namespace CFSG
end CFSG
open CFSG

/-!
# Section 10, Proposition 10.2: commutator algebra

This module proves the generic solvable-group calculation used to identify
the derived subgroup in Proposition 10.2(a).
-/

noncomputable section

set_option maxHeartbeats 800000

namespace CFSG.BenderSuzuki

open scoped Pointwise IsMulCommutative commutatorElement

universe u

/-- If a finite solvable group is generated by its derived subgroup and a
commutative subgroup `P`, then its derived subgroup is generated by its
commutators with `P`. -/
public theorem derived_eq_commutator_of_solvable_sup
    {G : Type u} [Group G] [Finite G] [Group.IsSolvable G]
    {P : Subgroup G} (hPcomm : IsMulCommutative P)
    (hGP : derivedSubgroup G ⊔ P = ⊤) :
    derivedSubgroup G = ⁅derivedSubgroup G, P⁆ := by
  let H : Subgroup G := derivedSubgroup G
  let C : Subgroup G := ⁅H, P⁆
  let HH : Subgroup G := ⁅H, H⁆
  let K : Subgroup G := HH ⊔ C
  have hHnormal : H.Normal := by
    dsimp [H]
    infer_instance
  have hC_le_H : C ≤ H := by
    dsimp [C]
    exact Subgroup.commutator_le_left (H₁ := H) (H₂ := P)
  have hHH_le_H : HH ≤ H := by
    dsimp [HH]
    exact Subgroup.commutator_le_left (H₁ := H) (H₂ := H)
  have hCnormal : C.Normal := by
    apply Subgroup.normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hGP]
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer
      (commutator_le_sup H P)).mp (commutator_normal_in_sup H P)
  have hHHnormal : HH.Normal := by
    dsimp [HH]
    infer_instance
  have hKnormal : K.Normal := by
    dsimp [K]
    infer_instance
  have hHHmem : ∀ {a b : G}, a ∈ H → b ∈ H → ⁅a, b⁆ ∈ K := by
    intro a b ha hb
    apply Subgroup.mem_sup_left
    exact Subgroup.commutator_mem_commutator ha hb
  have hCmem : ∀ {a : G} {b : G}, a ∈ H → b ∈ P → ⁅a, b⁆ ∈ K := by
    intro a b ha hb
    apply Subgroup.mem_sup_right
    exact Subgroup.commutator_mem_commutator ha hb
  have hPHmem : ∀ {a : G} {b : G}, a ∈ P → b ∈ H → ⁅a, b⁆ ∈ K := by
    intro a b ha hb
    have hc : ⁅a, b⁆ ∈ C := by
      simpa [C, Subgroup.commutator_comm] using
        Subgroup.commutator_mem_commutator ha hb
    exact Subgroup.mem_sup_right hc
  have hquot_comm : Std.Commutative (· * · : (G ⧸ K) → _ → _) := by
    apply Std.Commutative.mk
    intro x y
    obtain ⟨gx, rfl⟩ := QuotientGroup.mk'_surjective K x
    obtain ⟨gy, rfl⟩ := QuotientGroup.mk'_surjective K y
    have hHP : H ⊔ P = ⊤ := by simpa [H] using hGP
    have hgx : gx ∈ (H ⊔ P : Subgroup G) := by rw [hHP]; trivial
    have hgy : gy ∈ (H ⊔ P : Subgroup G) := by rw [hHP]; trivial
    rcases (Subgroup.mem_sup_of_normal_left (s := H) (t := P) (x := gx)).1
      hgx with ⟨hx, hxH, px, pxP, hxp⟩
    rcases (Subgroup.mem_sup_of_normal_left (s := H) (t := P) (x := gy)).1
      hgy with ⟨hy, hyH, py, pyP, hyp⟩
    let q : G →* G ⧸ K := QuotientGroup.mk' K
    have hxx : Commute (q hx) (q hy) := by
      apply commutatorElement_eq_one_iff_commute.mp
      rw [← map_commutatorElement q]
      exact (QuotientGroup.eq_one_iff (N := K) (x := ⁅hx, hy⁆)).2
        (hHHmem hxH hyH)
    have hxpyp : Commute (q hx) (q py) := by
      apply commutatorElement_eq_one_iff_commute.mp
      rw [← map_commutatorElement q]
      exact (QuotientGroup.eq_one_iff (N := K) (x := ⁅hx, py⁆)).2
        (hCmem hxH pyP)
    have hpxy : Commute (q px) (q hy) := by
      apply commutatorElement_eq_one_iff_commute.mp
      rw [← map_commutatorElement q]
      exact (QuotientGroup.eq_one_iff (N := K) (x := ⁅px, hy⁆)).2
        (hPHmem pxP hyH)
    have hpxpy : Commute (q px) (q py) := by
      have hxy : px * py = py * px := by
        exact congrArg Subtype.val
          ((@IsMulCommutative.is_comm P _ hPcomm).comm
            (⟨px, pxP⟩ : P) (⟨py, pyP⟩ : P))
      rw [commute_iff_eq]
      simpa [map_mul] using congrArg q hxy
    have hprod : Commute (q hx * q px) (q hy * q py) := by
      exact (hxx.mul_right hxpyp).mul_left (hpxy.mul_right hpxpy)
    change q gx * q gy = q gy * q gx
    rw [← hxp, ← hyp, map_mul, map_mul]
    exact hprod.eq
  have hH_le_K : H ≤ K := by
    change commutator G ≤ K
    exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp
      (⟨hquot_comm⟩ : IsMulCommutative (G ⧸ K))
  have hH_eq_K : H = K := by
    apply le_antisymm hH_le_K
    exact sup_le hHH_le_H hC_le_H
  have hH_eq : H = HH ⊔ C := hH_eq_K
  have hCsub_normal : (C.subgroupOf H).Normal := hCnormal.subgroupOf H
  let qH : H →* (H ⧸ C.subgroupOf H) := QuotientGroup.mk' (C.subgroupOf H)
  have hsurj : Function.Surjective
      (qH.comp (derivedSubgroup H).subtype) := by
    intro z
    obtain ⟨h, rfl⟩ := QuotientGroup.mk'_surjective (C.subgroupOf H) z
    have hC_norm_HH : C ≤ Subgroup.normalizer (HH : Set G) :=
      Subgroup.le_normalizer_of_normal
    have hprod : (h : G) ∈ (HH : Set G) * (C : Set G) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left HH C hC_norm_HH]
      have : h ∈ ((HH ⊔ C).subgroupOf H : Subgroup H) := by
        rw [← hH_eq]
        exact h.property
      change (h : G) ∈ HH ⊔ C at this
      exact this
    rcases Set.mem_mul.mp hprod with ⟨hh, hhh, c, hc, hmul⟩
    have hmapHH : (derivedSubgroup H).map H.subtype = HH := by
      simpa [derivedSubgroup, HH] using Subgroup.map_subtype_commutator H
    have hhh' : hh ∈ (derivedSubgroup H).map H.subtype := by
      rw [hmapHH]
      exact hhh
    rcases Subgroup.mem_map.mp hhh' with ⟨dh, hdh, hdhval⟩
    refine ⟨(⟨dh, hdh⟩ : derivedSubgroup H), ?_⟩
    let cH : H := ⟨c, hC_le_H hc⟩
    have hdhc : (dh : H) * cH = h := by
      apply Subtype.ext
      change (dh : G) * c = (h : G)
      have hdhval' : (dh : G) = hh := hdhval
      rw [hdhval']
      exact hmul
    have hqc : qH cH = 1 := by
      exact (QuotientGroup.eq_one_iff (N := C.subgroupOf H) (x := cH)).2 hc
    change qH (dh : H) = qH h
    calc
      qH (dh : H) = qH (dh : H) * 1 := (mul_one _).symm
      _ = qH (dh : H) * qH cH := by rw [hqc]
      _ = qH ((dh : H) * cH) := (map_mul qH _ _).symm
      _ = qH h := by rw [hdhc]
  have hmap_top : (derivedSubgroup H).map qH = ⊤ := by
    apply top_unique
    intro z hz
    obtain ⟨d, rfl⟩ := hsurj z
    exact Subgroup.mem_map_of_mem qH d.property
  have hderQ : derivedSubgroup (H ⧸ C.subgroupOf H) = ⊤ := by
    calc
      derivedSubgroup (H ⧸ C.subgroupOf H) =
          (derivedSubgroup H).map qH := by
        symm
        simpa [derivedSubgroup] using
          (map_derivedSeries_eq (f := qH)
            (QuotientGroup.mk'_surjective (C.subgroupOf H)) 1)
      _ = ⊤ := hmap_top
  have hperfect : Group.IsPerfect (H ⧸ C.subgroupOf H) := by
    refine ⟨?_⟩
    simpa [derivedSubgroup] using hderQ
  letI : Group.IsPerfect (H ⧸ C.subgroupOf H) := hperfect
  have hsubsingle : Subsingleton (H ⧸ C.subgroupOf H) := by
    apply not_nontrivial_iff_subsingleton.mp
    intro hnon
    letI : Nontrivial (H ⧸ C.subgroupOf H) := hnon
    exact Group.IsPerfect.not_isSolvable (H ⧸ C.subgroupOf H) inferInstance
  have hCsub_top : C.subgroupOf H = ⊤ := by
    apply top_unique
    intro x hx
    exact (QuotientGroup.eq_one_iff (N := C.subgroupOf H) (x := x)).1
      (Subsingleton.elim (qH x) 1)
  have hC_eq_H : C = H := by
    have hmap := congrArg (fun S : Subgroup H => S.map H.subtype) hCsub_top
    have hleft : (C.subgroupOf H).map H.subtype = C := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hC_le_H]
    have hright : (⊤ : Subgroup H).map H.subtype = H := by
      ext x
      simp
    calc
      C = (C.subgroupOf H).map H.subtype := hleft.symm
      _ = (⊤ : Subgroup H).map H.subtype := hmap
      _ = H := hright
  simpa [H, C] using hC_eq_H.symm

/-! ### Ambient transport

The quotient calculation above lives in the subgroup `E`.  The next helper
transports it through the subtype map and then uses the Lemma 10.6
factorization of the ambient subgroup.  Keeping this transport separate makes
the Proposition 10.2 assembly independent of any Proposition 10.2 package.
-/

/-- If `E` is generated by its derived subgroup and a commutative subgroup
`P`, then the ambient image of `E'` is the commutator subgroup `[E,P]`.

The only ambient input is the displayed set factorization of `E`; no
Proposition 10.2 conclusion is used. -/
public theorem map_derivedSubgroup_eq_commutator_of_solvable_mul
    {X : Type u} [Group X] [Finite X]
    {E P : Subgroup X}
    (hPE : P ≤ E)
    (hEsolv : Group.IsSolvable E)
    (hPcomm : IsMulCommutative P)
    (hEset : (E : Set X) =
      ((derivedSubgroup E).map E.subtype : Set X) * (P : Set X)) :
    (derivedSubgroup E).map E.subtype = ⁅E, P⁆ := by
  let Psub : Subgroup E := P.subgroupOf E
  letI : Group.IsSolvable E := hEsolv
  have hPsubcomm : IsMulCommutative Psub := by
    refine ⟨⟨?_⟩⟩
    intro x y
    apply Subtype.ext
    apply Subtype.ext
    change (x : X) * (y : X) = (y : X) * (x : X)
    exact congrArg Subtype.val
      ((@IsMulCommutative.is_comm P _ hPcomm).comm
        (⟨(x : X), x.property⟩ : P) (⟨(y : X), y.property⟩ : P))
  have hEder_sup_Psub : derivedSubgroup E ⊔ Psub = ⊤ := by
    apply top_unique
    intro x _hx
    have hxprod : (x : X) ∈
        ((derivedSubgroup E).map E.subtype : Set X) * (P : Set X) := by
      rw [← hEset]
      exact x.property
    rcases Set.mem_mul.mp hxprod with ⟨a, ha, p, hp, hap⟩
    rcases Subgroup.mem_map.mp ha with ⟨aE, haE, haEval⟩
    have hpE : p ∈ E := hPE hp
    have haSup : aE ∈ derivedSubgroup E ⊔ Psub :=
      Subgroup.mem_sup_left haE
    have hpSup : (⟨p, hpE⟩ : E) ∈ derivedSubgroup E ⊔ Psub :=
      Subgroup.mem_sup_right (by
        change p ∈ P
        exact hp)
    have hmul : (aE * (⟨p, hpE⟩ : E)) = x := by
      apply Subtype.ext
      change (aE : X) * p = (x : X)
      have haEval' : (aE : X) = a := haEval
      rw [haEval']
      exact hap
    rw [← hmul]
    exact (derivedSubgroup E ⊔ Psub).mul_mem
      (by simpa [haEval] using haSup) hpSup
  have hder_sub : derivedSubgroup E = ⁅derivedSubgroup E, Psub⁆ :=
    derived_eq_commutator_of_solvable_sup hPsubcomm hEder_sup_Psub
  have hmap : ((⁅derivedSubgroup E, Psub⁆).map E.subtype : Subgroup X) =
      ⁅(derivedSubgroup E).map E.subtype, P⁆ := by
    rw [Subgroup.map_commutator]
    rw [Subgroup.map_subgroupOf_eq_of_le hPE]
  have hder_comm : (derivedSubgroup E).map E.subtype =
      ⁅(derivedSubgroup E).map E.subtype, P⁆ := by
    calc
      (derivedSubgroup E).map E.subtype =
          (⁅derivedSubgroup E, Psub⁆).map E.subtype :=
        congrArg (fun S : Subgroup E => S.map E.subtype) hder_sub
      _ = ⁅(derivedSubgroup E).map E.subtype, P⁆ := hmap
  apply le_antisymm
  · rw [hder_comm]
    exact Subgroup.commutator_mono
      (Subgroup.map_subtype_le (derivedSubgroup E)) le_rfl
  · calc
      ⁅E, P⁆ ≤ ⁅(derivedSubgroup E).map E.subtype, P⁆ :=
        lemma106_commutator_le_of_mul_right_commutative hEset
      _ = (derivedSubgroup E).map E.subtype := hder_comm.symm

end CFSG.BenderSuzuki
