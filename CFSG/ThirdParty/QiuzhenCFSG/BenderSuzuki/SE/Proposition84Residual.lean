module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.Interfaces

namespace CFSG
end CFSG
open CFSG

/-!
# Residual and Sylow infrastructure for Proposition 8.4

This file contains the functorial `2`-residual facts used in the proper
predecessor step of Proposition 8.4.  They are independent of the action
argument and of the odd-order normalizer calculation.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1

universe u

/-- The subgroup generated by all Sylow `2`-subgroups is characteristic.
Every automorphism permutes the Sylow `2`-subgroups, so it preserves their
supremum. -/
public theorem twoPrimeResidual_characteristic
    {G : Type u} [Group G] [Finite G] :
    (twoPrimeResidual G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_le]
  intro e
  rw [twoPrimeResidual, Subgroup.map_iSup]
  apply iSup_le
  intro P
  let Pe : Sylow 2 G :=
    Sylow.mapSurjective (f := e.toMonoidHom) e.surjective P
  change (Pe : Subgroup G) ≤
    ⨆ Q : Sylow 2 G, (Q : Subgroup G)
  exact le_iSup (fun Q : Sylow 2 G => (Q : Subgroup G)) Pe

/-- The cyclic subgroup generated by an involution is a `2`-group. -/
public theorem isPGroup_two_zpowers_of_isInvolution
    {G : Type u} [Group G] [Finite G] {t : G}
    (ht : IsInvolution t) : IsPGroup 2 (Subgroup.zpowers t) := by
  have horder : orderOf t = 2 :=
    (orderOf_eq_prime_iff).2 ⟨ht.sq_eq_one, ht.ne_one⟩
  apply IsPGroup.of_card (p := 2) (G := Subgroup.zpowers t) (n := 1)
  simp [Nat.card_zpowers, horder]

/-- Every `2`-subgroup lies in the subgroup generated by the Sylow
`2`-subgroups. -/
public theorem isPGroup_le_twoPrimeResidual
    {G : Type u} [Group G] [Finite G] {P : Subgroup G}
    (hP : IsPGroup 2 P) : P ≤ twoPrimeResidual G := by
  obtain ⟨S, hPS⟩ := hP.exists_le_sylow
  exact hPS.trans (le_iSup (fun Q : Sylow 2 G => (Q : Subgroup G)) S)

/-- A homomorphic image of the `2`-residual lies in the `2`-residual. -/
public theorem twoPrimeResidual_map_le
    {G H : Type u} [Group G] [Group H] [Finite G] [Finite H]
    (f : G →* H) :
    (twoPrimeResidual G).map f ≤ twoPrimeResidual H := by
  rw [twoPrimeResidual, Subgroup.map_iSup]
  apply iSup_le
  intro P
  exact isPGroup_le_twoPrimeResidual (P.isPGroup'.map f)

/-- The subgroup generated by all Sylow `2`-subgroups is itself generated by
its Sylow `2`-subgroups. -/
public theorem twoPrimeResidual_self_eq_top
    {G : Type u} [Group G] [Finite G] :
    twoPrimeResidual (twoPrimeResidual G) = ⊤ := by
  let R : Subgroup G := twoPrimeResidual G
  have hRle : R ≤ (twoPrimeResidual R).map R.subtype := by
    change twoPrimeResidual G ≤ (twoPrimeResidual R).map R.subtype
    rw [twoPrimeResidual]
    apply iSup_le
    intro S
    have hSR : (S : Subgroup G) ≤ R :=
      le_iSup (fun T : Sylow 2 G => (T : Subgroup G)) S
    have hSp : IsPGroup 2 (S.subgroupOf R) :=
      S.isPGroup'.of_equiv (Subgroup.subgroupOfEquivOfLe hSR).symm
    have hSres : S.subgroupOf R ≤ twoPrimeResidual R :=
      isPGroup_le_twoPrimeResidual hSp
    intro x hx
    let xR : R := ⟨x, hSR hx⟩
    exact ⟨xR, hSres hx, rfl⟩
  apply top_unique
  intro x _hx
  have hxmap : (x : G) ∈ (twoPrimeResidual R).map R.subtype :=
    hRle x.property
  rcases hxmap with ⟨y, hy, hxy⟩
  have hyx : y = x := Subtype.ext hxy
  simpa [hyx] using hy

/-- The embedded `2`-residual of a centralizer is contained in that
centralizer. -/
public theorem centralizerTwoPrimeResidual_le_ambientCentralizer
    {X : Type u} [Group X] (Y : Subgroup X) :
    centralizerTwoPrimeResidual Y ≤ Subgroup.centralizer (Y : Set X) := by
  dsimp [centralizerTwoPrimeResidual]
  exact Subgroup.map_subtype_le _

/-- Normalizing a subgroup also normalizes its centralizer. -/
public theorem normalizer_le_normalizer_centralizer
    {X : Type u} [Group X] (Y : Subgroup X) :
    Subgroup.normalizer (Y : Set X) ≤
      Subgroup.normalizer
        (Subgroup.centralizer (Y : Set X) : Set X) := by
  intro n hn
  rw [Subgroup.mem_normalizer_iff] at hn ⊢
  intro c
  constructor
  · intro hc
    rw [Subgroup.mem_centralizer_iff] at hc ⊢
    intro y hy
    have hy' : n⁻¹ * y * n ∈ Y := by
      simpa using
        (hn (n⁻¹ * y * n)).mpr (by simpa [mul_assoc] using hy)
    have hcomm := hc (n⁻¹ * y * n) hy'
    have h := congrArg (fun z : X => n * z * n⁻¹) hcomm
    simpa [mul_assoc] using h
  · intro hc
    rw [Subgroup.mem_centralizer_iff] at hc ⊢
    intro y hy
    have hy' : n * y * n⁻¹ ∈ Y := (hn y).mp hy
    have hcomm := hc (n * y * n⁻¹) hy'
    have h := congrArg (fun z : X => n⁻¹ * z * n) hcomm
    simpa [mul_assoc] using h

/-- The embedded `2`-residual of `C_X(Y)` is normal in `N_X(Y)`.
The proof uses characteristicity inside the centralizer and the conjugation
automorphism induced by each element of the normalizer. -/
public theorem centralizerTwoPrimeResidual_normal_in_normalizer
    {X : Type u} [Group X] [Finite X] (Y : Subgroup X) :
    ((centralizerTwoPrimeResidual Y).subgroupOf
      (Subgroup.normalizer (Y : Set X))).Normal := by
  let C : Subgroup X := Subgroup.centralizer (Y : Set X)
  let N : Subgroup X := Subgroup.normalizer (Y : Set X)
  let F : Subgroup X := centralizerTwoPrimeResidual Y
  have hC_le_N : C ≤ N := centralizer_le_normalizer Y
  have hF_le_N : F ≤ N :=
    (centralizerTwoPrimeResidual_le_ambientCentralizer Y).trans hC_le_N
  rw [Subgroup.normal_subgroupOf_iff hF_le_N]
  intro f n hf hn
  change n * f * n⁻¹ ∈ F
  have hnC : n ∈ Subgroup.normalizer (C : Set X) := by
    exact normalizer_le_normalizer_centralizer Y hn
  rcases hf with ⟨c, hc, rfl⟩
  let nc : Subgroup.normalizer (C : Set X) := ⟨n, hnC⟩
  let e : C ≃* C := C.normalizerMonoidHom nc
  have hfixed :
      Subgroup.comap e.toMonoidHom (twoPrimeResidual C) =
        twoPrimeResidual C :=
    twoPrimeResidual_characteristic.fixed e
  have hc' : c ∈ Subgroup.comap e.toMonoidHom (twoPrimeResidual C) := by
    rw [hfixed]
    exact hc
  change n * (c : X) * n⁻¹ ∈
    (twoPrimeResidual C).map C.subtype
  refine ⟨e c, hc', ?_⟩
  simp [e, nc, Subgroup.normalizerMonoidHom_apply_apply_coe]

/-- Enlarging the centralized subgroup shrinks its embedded
`2`-residual. -/
public theorem centralizerTwoPrimeResidual_mono
    {X : Type u} [Group X] [Finite X]
    {Y₀ Y : Subgroup X} (hY : Y₀ ≤ Y) :
    centralizerTwoPrimeResidual Y ≤ centralizerTwoPrimeResidual Y₀ := by
  let C : Subgroup X := Subgroup.centralizer (Y : Set X)
  let C₀ : Subgroup X := Subgroup.centralizer (Y₀ : Set X)
  have hC : C ≤ C₀ := Subgroup.centralizer_le hY
  let i : C →* C₀ := Subgroup.inclusion hC
  have hres : (twoPrimeResidual C).map i ≤ twoPrimeResidual C₀ :=
    twoPrimeResidual_map_le i
  dsimp [centralizerTwoPrimeResidual]
  intro x hx
  rw [Subgroup.mem_map] at hx ⊢
  rcases hx with ⟨z, hz, rfl⟩
  refine ⟨i z, hres ?_, rfl⟩
  exact ⟨z, hz, rfl⟩

/-- The part of a `2`-subgroup centralizing `Y` lies in
`O^{2'}(C_X(Y))`. -/
public theorem inf_centralizer_le_centralizerTwoPrimeResidual
    {X : Type u} [Group X] [Finite X]
    {P Y : Subgroup X} (hP : IsPGroup 2 P) :
    P ⊓ Subgroup.centralizer (Y : Set X) ≤
      centralizerTwoPrimeResidual Y := by
  let C : Subgroup X := Subgroup.centralizer (Y : Set X)
  let Q : Subgroup C := (P ⊓ C).subgroupOf C
  have hQp : IsPGroup 2 Q := by
    let f : Q →* P :=
      { toFun := fun q => ⟨(q : X), q.property.1⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    exact hP.of_injective f (by
      intro a b hab
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun z : P => (z : X)) hab)
  have hQres : Q ≤ twoPrimeResidual C :=
    isPGroup_le_twoPrimeResidual hQp
  intro x hx
  change x ∈ (twoPrimeResidual C).map C.subtype
  rw [Subgroup.mem_map]
  let xc : C := ⟨x, hx.2⟩
  refine ⟨xc, hQres ?_, rfl⟩
  exact hx

/-- An involution centralizing `Y`, together with all of its powers, lies in
the embedded `2`-residual of `C_X(Y)`. -/
public theorem zpowers_le_centralizerTwoPrimeResidual_of_isInvolution
    {X : Type u} [Group X] [Finite X] (Y : Subgroup X) {t : X}
    (ht : IsInvolution t)
    (htC : t ∈ Subgroup.centralizer (Y : Set X)) :
    Subgroup.zpowers t ≤ centralizerTwoPrimeResidual Y := by
  have hP : IsPGroup 2 (Subgroup.zpowers t) :=
    isPGroup_two_zpowers_of_isInvolution ht
  have hA_le_C : Subgroup.zpowers t ≤
      Subgroup.centralizer (Y : Set X) := by
    rw [Subgroup.zpowers_le]
    exact htC
  intro x hx
  exact inf_centralizer_le_centralizerTwoPrimeResidual hP ⟨hx, hA_le_C hx⟩

/-- For a `2`-subgroup `P`, intersecting with the centralizer or with its
embedded `2`-residual gives the same subgroup. -/
public theorem inf_centralizer_eq_inf_centralizerTwoPrimeResidual
    {X : Type u} [Group X] [Finite X]
    {P Y : Subgroup X} (hP : IsPGroup 2 P) :
    P ⊓ Subgroup.centralizer (Y : Set X) =
      P ⊓ centralizerTwoPrimeResidual Y := by
  apply le_antisymm
  · intro x hx
    exact ⟨hx.1, inf_centralizer_le_centralizerTwoPrimeResidual hP hx⟩
  · intro x hx
    exact ⟨hx.1, centralizerTwoPrimeResidual_le_ambientCentralizer Y hx.2⟩

end CFSG.BenderSuzuki
