        rw [@inv_mul_cancel_left (PSL2MatrixGroup K) _]
        rw [@inv_mul_cancel_left (PSL2MatrixGroup K) _]
      rw [hg, ha, Subgroup.map_map, heq]
    have hTnormcard :
        Nat.card (Subgroup.normalizer (T : Set (PSL2BinaryMatrixGroup n))) =
          2 * Nat.card T := by
      calc
        Nat.card (Subgroup.normalizer (T : Set (PSL2BinaryMatrixGroup n))) =
            Nat.card ((Subgroup.normalizer (U0 : Set (PSL2MatrixGroup K))).map
