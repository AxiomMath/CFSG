/-!
# Section 11, Lemma 11.4: recognized-model boundary

The source uses two different subgroups attached to `V`.  Proposition 8.4
acts through

* `Fhat = O^{2'}(C_X(V))`, while
* Section 11 writes `F = C_X(V)^°`, the subgroup generated by the
  involutions of the centralizer.

They agree in the PSL fixed-field case, but need not agree in the degenerate
Suzuki fixed-field case: `Fhat` is the order-`20` Suzuki group over `GF(2)`,
whereas its involution core is dihedral of order `10`.  Keeping the two
objects separate removes the apparent conflict between Proposition 8.4's
double transitivity and the order-`10` conclusion of Lemma 11.4.

This module proves the source-independent comparison between the two objects
and the `[II4; 3.2(e), 2.8(a)]` recognition step.  The small action data used
at the start of Lemma 11.5 is then proved from Proposition 8.4 and the explicit
small models; no conclusion of Lemma 11.4, Proposition 11.1, Theorem 6, or
Theorem SE is assumed.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open MatrixGroups PFAppendixIII PFchapter1section1
open scoped LinearAlgebra.Projectivization Pointwise IsMulCommutative

universe u v

/-! ## The three source subgroups -/

/-- Source `F₀ = O^{2'}(C_X(A))`.  In the present application this is also
the involution-generated subgroup occurring in the source, after the
`[II4; 2.8(a)]` central-kernel step. -/
@[expose] public def lemma114FZero
    {X : Type u} [Group X] (A : Subgroup X) : Subgroup X :=
  centralizerTwoPrimeResidual A

/-- The Lemma 11.4 residual `F₀` is itself generated by its Sylow
`2`-subgroups. -/
public theorem lemma114FZero_twoPrimeResidual_eq_top
    {X : Type u} [Group X] [Finite X] (A : Subgroup X) :
    twoPrimeResidual (lemma114FZero A) = ⊤ := by
  let C : Subgroup X := Subgroup.centralizer (A : Set X)
  let R : Subgroup C := twoPrimeResidual C
  let e : R ≃* lemma114FZero A := by
    change R ≃* Subgroup.map C.subtype R
    exact Subgroup.equivMapOfInjective R C.subtype C.subtype_injective
  have hmap := twoPrimeResidual_map_le e.toMonoidHom
  rw [twoPrimeResidual_self_eq_top,
    Subgroup.map_top_of_surjective e.toMonoidHom e.surjective] at hmap
  exact top_unique hmap

/-- A group equal to its `2`-residual is perfect once its quotient by the
`2'`-core is a nonabelian simple Bender model. -/
private theorem perfect_of_twoPrimeResidual_eq_top_of_model_quotient
    {F : Type u} [Group F] [Finite F] {n : ℕ}
    (hres : twoPrimeResidual F = ⊤)
    (hn : 2 ≤ n)
    (hmodel : IsSimpleBenderGroupAtExponent n
      (F ⧸ twoPrimeCore F)) :
    commutator F = ⊤ := by
  let K : Subgroup F := commutator F
  let Z : Subgroup F := twoPrimeCore F
  let q : F →* F ⧸ Z := QuotientGroup.mk' Z
  letI : K.Normal := inferInstance
  letI : Z.Normal := inferInstance
  have hquotPerfect : commutator (F ⧸ Z) = ⊤ := by
    simpa [Z] using hmodel.isPerfect hn
  have hmapK : K.map q = ⊤ := by
    calc
      K.map q = commutator (F ⧸ Z) := by
        rw [show K = commutator F by rfl, commutator_def,
          Subgroup.map_commutator,
          Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective Z),
          ← commutator_def]
      _ = ⊤ := hquotPerfect
  have hsup : K ⊔ Z = ⊤ := by
    apply top_unique
    intro x _hx
    have hqx : q x ∈ K.map q := by
      rw [hmapK]
      exact Subgroup.mem_top (q x)
    rcases hqx with ⟨k, hk, hkx⟩
    have hxk : x / k ∈ Z :=
      QuotientGroup.eq_iff_div_mem.mp hkx.symm
    have hxEq : x = (x / k) * k := by simp [div_eq_mul_inv]
    rw [hxEq]
    exact (K ⊔ Z).mul_mem (Subgroup.mem_sup_right hxk)
      (Subgroup.mem_sup_left hk)
  have hfactor : (Set.univ : Set F) = (Z : Set F) * (K : Set F) := by
    rw [← Subgroup.mul_normal Z K, sup_comm, hsup]
    rfl
  have hZodd : Odd (Nat.card Z) := by
    apply Nat.coprime_two_left.mp
    simpa [Z, twoPrimeCore] using
      (pPrimeCore_coprime_card (G := F) (p := 2))
  let qZ : Z →* F ⧸ K :=
    (QuotientGroup.mk' K).comp Z.subtype
  have hqZsurj : Function.Surjective qZ := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective K y
    have hx : x ∈ (Z : Set F) * (K : Set F) := by
      rw [← hfactor]
      exact Set.mem_univ x
    rcases Set.mem_mul.mp hx with ⟨z, hz, k, hk, hzk⟩
    refine ⟨⟨z, hz⟩, ?_⟩
    change QuotientGroup.mk' K z = QuotientGroup.mk' K x
    rw [← hzk, map_mul]
    have hkq : QuotientGroup.mk' K k = 1 :=
      (QuotientGroup.eq_one_iff k).2 hk
    rw [hkq, mul_one]
  have hquotOdd : Odd (Nat.card (F ⧸ K)) :=
    hZodd.of_dvd_nat (Subgroup.card_dvd_of_surjective hqZsurj)
  have hle : twoPrimeResidual F ≤ K :=
    PFchapter1section3.twoPrimeResidual_le_of_odd_quotient hquotOdd
  rw [hres] at hle
  exact top_unique hle

/-! ## The odd central-cover step -/

/-- A perfect finite central extension with odd central kernel is trivial when
every odd Sylow subgroup of the quotient is cyclic.  This is the transfer
core of the source step `[II4; 2.8(a)]`.

The proof is deliberately independent of the concrete model family.  A
nontrivial odd central element is embedded in a Sylow subgroup, whose image in
the quotient is cyclic.  The kernel of the restricted quotient map is then
central, so the Sylow subgroup is abelian.  Transfer to that Sylow subgroup is
trivial because the covering group is perfect, while the central element's
transfer is a power with exponent the Sylow index.  The resulting divisibility
contradicts the Sylow index formula. -/
public theorem lemma114_oddCentralCover_eq_bot
    {E : Type u} [Group E] [Finite E]
    (hperfect : commutator E = ⊤)
    (Z : Subgroup E) [Z.Normal]
    (hZcenter : Z = Subgroup.center E)
    (hZodd : Odd (Nat.card Z))
    (hquot : ∀ r [Fact r.Prime], r ≠ 2 →
      ∀ S : Sylow r (E ⧸ Z), IsCyclic S) :
    Z = ⊥ := by
  classical
  apply le_antisymm
  · intro z hz
    by_contra hz1
    have hZcard_ne_one : Nat.card Z ≠ 1 := by
      intro hcard
      letI : Subsingleton Z := (Nat.card_eq_one_iff_unique.mp hcard).1
      have huniq : ∀ x y : Z, x = y := fun x y => Subsingleton.elim _ _
      apply hz1
      rw [Subgroup.mem_bot]
      exact congrArg Subtype.val (huniq ⟨z, hz⟩ 1)
    obtain ⟨r, hrprime, hrdiv⟩ := Nat.exists_prime_and_dvd hZcard_ne_one
    letI : Fact r.Prime := ⟨hrprime⟩
    have hrne2 : r ≠ 2 := by
      intro hr
      subst r
      exact hZodd.not_two_dvd_nat hrdiv
    obtain ⟨zZ, hzZorder⟩ :=
      exists_prime_orderOf_dvd_card' (G := Z) r hrdiv
    let zE : E := zZ
    have hzEorder : orderOf zE = r := by
      simpa [zE] using hzZorder
    have hzEcenter : zE ∈ Subgroup.center E := by
      rw [← hZcenter]
      exact zZ.property
    have hzp : IsPGroup r (Subgroup.zpowers zE) := by
      apply IsPGroup.of_card (n := 1)
      rw [Nat.card_zpowers, hzEorder]
      simp
    obtain ⟨S, hzS⟩ := hzp.exists_le_sylow
    let q : E →* E ⧸ Z := QuotientGroup.mk' Z
    let SbarSylow : Sylow r (E ⧸ Z) :=
      Sylow.mapSurjective (QuotientGroup.mk'_surjective Z) S
    let Sbar : Subgroup (E ⧸ Z) := SbarSylow
    have hSbarCyclic : IsCyclic Sbar := hquot r hrne2 SbarSylow
    letI : IsCyclic Sbar := hSbarCyclic
    let qS : S →* Sbar :=
      ((q.comp (S : Subgroup E).subtype).codRestrict Sbar (by
        intro x
        change q (x : E) ∈ Sbar
        rw [show Sbar = (SbarSylow : Subgroup (E ⧸ Z)) by rfl,
          Sylow.coe_mapSurjective]
        exact Subgroup.mem_map_of_mem q
          (show (x : E) ∈ (S : Subgroup E) from x.property)))
    have hqSker : qS.ker ≤ Subgroup.center S := by
      intro x hx
      apply Subgroup.mem_center_iff.mpr
      intro y
      have hxZ : (x : E) ∈ Z := by
        apply (QuotientGroup.eq_one_iff (x : E)).mp
        exact congrArg Subtype.val hx
      have hxcent : (x : E) ∈ Subgroup.center E := by
        rw [← hZcenter]
        exact hxZ
      have hxy : (x : E) * (y : E) = (y : E) * (x : E) :=
        (Subgroup.mem_center_iff.mp hxcent (y : E)).symm
      apply Subtype.ext
      exact hxy.symm
    have hcommS : ∀ a b : S, a * b = b * a := by
      intro a b
      exact commutative_of_cyclic_center_quotient qS hqSker a b
    letI : IsMulCommutative S := ⟨⟨hcommS⟩⟩
    letI : CommGroup S := IsMulCommutative.instCommGroup
    let tr : E →* S := MonoidHom.transfer (MonoidHom.id S)
    have htrivial : ∀ x : E, tr x = 1 := by
      intro x
      have hxcomm : x ∈ commutator E := by
        rw [hperfect]
        trivial
      have hxker : x ∈ tr.ker :=
        Abelianization.commutator_subset_ker tr hxcomm
      exact hxker
    have hkey : ∀ (k : ℕ) (g₀ : E),
        g₀⁻¹ * zE ^ k * g₀ ∈ (S : Subgroup E) →
          g₀⁻¹ * zE ^ k * g₀ = zE ^ k := by
      intro k g₀ _
      have hzpowcent : zE ^ k ∈ Subgroup.center E :=
        (Subgroup.center E).pow_mem hzEcenter k
      have h := Subgroup.mem_center_iff.mp hzpowcent g₀
      calc
        g₀⁻¹ * zE ^ k * g₀ = g₀⁻¹ * (g₀ * zE ^ k) := by
          rw [mul_assoc, h.symm]
        _ = zE ^ k := by group
    have htransfer_pow :=
      MonoidHom.transfer_eq_pow (MonoidHom.id S) zE hkey
    have hpow_one : zE ^ (S : Subgroup E).index = 1 := by
      have htr := htrivial zE
      rw [htransfer_pow] at htr
      exact congrArg Subtype.val htr
    have hord_dvd_index : r ∣ (S : Subgroup E).index := by
      have h : orderOf zE ∣ (S : Subgroup E).index :=
        (orderOf_dvd_iff_pow_eq_one).2 hpow_one
      simpa [hzEorder] using h
    exact S.not_dvd_index hord_dvd_index
  · exact bot_le

/-! ## Prime-order irreducibility in dimension four -/

private theorem lemma114_coprime_qsq_add_one_factors
    (q : ℕ) (hq : 2 ≤ q) (hqeven : Even q) :
    Nat.Coprime (q ^ 2 + 1) q ∧
      Nat.Coprime (q ^ 2 + 1) (q - 1) ∧
      Nat.Coprime (q ^ 2 + 1) (q ^ 2 - 1) ∧
      Nat.Coprime (q ^ 2 + 1) (q ^ 3 - 1) := by
  have hcop_qsq : Nat.Coprime (q ^ 2 + 1) (q ^ 2) := by
    have h := (Nat.coprime_add_self_left (m := 1) (n := q ^ 2)).2
      (Nat.coprime_one_left (q ^ 2))
    simpa [add_comm] using h
  have hcop_q : Nat.Coprime (q ^ 2 + 1) q :=
    hcop_qsq.coprime_dvd_right (dvd_pow_self q (by norm_num))
  have hq_sq_even : Even (q ^ 2) :=
    Nat.even_pow.mpr ⟨hqeven, by norm_num⟩
  have hq_sq_pos : 0 < q ^ 2 := by positivity
  have hq_sq_sub_one_odd : Odd (q ^ 2 - 1) :=
    Nat.Even.sub_odd hq_sq_pos hq_sq_even odd_one
  have hcop_qsq_sub : Nat.Coprime (q ^ 2 + 1) (q ^ 2 - 1) := by
    have h := (Nat.coprime_self_add_right
      (m := q ^ 2 - 1) (n := 2)).2 hq_sq_sub_one_odd.coprime_two_right
    have heq : q ^ 2 - 1 + 2 = q ^ 2 + 1 := by omega
    rw [heq] at h
    exact h.symm
  have hcop_q_sub : Nat.Coprime (q ^ 2 + 1) (q - 1) :=
    hcop_qsq_sub.coprime_dvd_right (by
      simpa using Nat.sub_dvd_pow_sub_pow q 1 2)
  have hcop_qsq_add_q :
      Nat.Coprime (q ^ 2 + 1) (q ^ 2 + q + 1) := by
    have h := (Nat.coprime_self_add_right
      (m := q ^ 2 + 1) (n := q)).2 hcop_q
    convert h using 1 <;> ring
  have hfactor : q ^ 3 - 1 = (q - 1) * (q ^ 2 + q + 1) := by
    rw [Nat.sub_mul]
    have hqmul : q * (q ^ 2 + q + 1) = q ^ 3 + q ^ 2 + q := by ring
    rw [hqmul, one_mul]
    omega
  have hcop_qcube_sub : Nat.Coprime (q ^ 2 + 1) (q ^ 3 - 1) := by
    rw [hfactor]
    exact hcop_q_sub.mul_right hcop_qsq_add_q
  exact ⟨hcop_q, hcop_q_sub, hcop_qsq_sub, hcop_qcube_sub⟩

private theorem lemma114_coprime_qsq_add_one_gl_card
    {K : Type*} [Field K] [Fintype K]
    (hq : 2 ≤ Fintype.card K) (hqeven : Even (Fintype.card K))
    (d : ℕ) (hdpos : 1 ≤ d) (hdle : d ≤ 3) :
    Nat.Coprime (Fintype.card K ^ 2 + 1)
      (Nat.card (GL (Fin d) K)) := by
  let q := Fintype.card K
  obtain ⟨hcopq, hcop1, hcop2, hcop3⟩ :=
    lemma114_coprime_qsq_add_one_factors q hq hqeven
  interval_cases d
  · rw [Matrix.card_GL_field]
    simpa [q] using hcop1
  · rw [Matrix.card_GL_field]
    have hq2q : q ^ 2 - q = q * (q - 1) := by
      rw [Nat.mul_sub_left_distrib]
      ring
    simpa [Fin.prod_univ_two, q, hq2q] using
      hcop2.mul_right (hcopq.mul_right hcop1)
  · rw [Matrix.card_GL_field]
    have hq3q : q ^ 3 - q = q * (q ^ 2 - 1) := by
      rw [Nat.mul_sub_left_distrib]
      ring
    have hq3q2 : q ^ 3 - q ^ 2 = q ^ 2 * (q - 1) := by
      rw [Nat.mul_sub_left_distrib]
      ring
    simpa [Fin.prod_univ_three, q, hq3q, hq3q2] using
      hcop3.mul_right
        (hcopq.mul_right hcop2) |>.mul_right
          (by simpa [pow_two] using
            (hcopq.mul_right hcopq).mul_right hcop1)

private theorem lemma114_exists_isCompl_invariant_of_odd_group
    {A K V : Type*} [Group A] [Fintype A]
    [Field K] [CharP K 2]
    [AddCommGroup V] [Module K V]
    (hAodd : Odd (Fintype.card A))
    (rho : Representation K A V)
    (U : Submodule K V)
    (hU : ∀ a : A, ∀ v ∈ U, rho a v ∈ U) :
    ∃ W, IsCompl U W ∧ ∀ a : A, ∀ v ∈ W, rho a v ∈ W := by
  classical
  have hUinv : U ∈ rho.invtSubmodule := by
    rw [Representation.mem_invtSubmodule]
    intro a
    rw [Module.End.mem_invtSubmodule_iff_forall_mem_of_mem]
    exact hU a
  let Upack : rho.invtSubmodule := ⟨U, hUinv⟩
  let instAdd : AddCommGroup rho.asModule :=
    Representation.instAddCommGroupAsModule rho
  letI : AddCommGroup rho.asModule := instAdd
  let instMod : Module (MonoidAlgebra K A) rho.asModule :=
    Representation.instModuleMonoidAlgebraAsModule rho
  letI : Module (MonoidAlgebra K A) rho.asModule := instMod
  haveI : NeZero (Fintype.card A : K) := by
    constructor
    intro hzero
    have hdiv : 2 ∣ Fintype.card A :=
      (CharP.cast_eq_zero_iff K 2 (Fintype.card A)).1 hzero
    exact hAodd.not_two_dvd_nat hdiv
  let Umod : @Submodule (MonoidAlgebra K A) rho.asModule _
      instAdd.toAddCommMonoid instMod :=
    rho.mapSubmodule Upack
  obtain ⟨Wmod, hUWmod⟩ := @MonoidAlgebra.Submodule.exists_isCompl'
    K inferInstance A inferInstance inferInstance rho.asModule
      instAdd instMod inferInstance Umod
  let Wpack : rho.invtSubmodule := rho.mapSubmodule.symm Wmod
  let W : Submodule K V := Wpack
  refine ⟨W, ?_, ?_⟩
  · have hcompl_pack : IsCompl Upack Wpack := by
      exact (rho.mapSubmodule.isCompl_iff).2
        (by simpa [Umod, Wpack] using hUWmod)
    rw [isCompl_iff, disjoint_iff, codisjoint_iff] at hcompl_pack ⊢
    constructor
    · simpa [Upack, W] using congrArg Subtype.val hcompl_pack.1
    · simpa [Upack, W] using congrArg Subtype.val hcompl_pack.2
  · intro a v hv
    have hmem := (Representation.mem_invtSubmodule (ρ := rho)).1 Wpack.2 a
    exact
      (Module.End.mem_invtSubmodule_iff_forall_mem_of_mem (rho a)).1 hmem v
        (by simpa [W] using hv)

private theorem lemma114_card_dvd_gl_finrank_of_representation_injective
    {A K V : Type*} [Group A] [Finite A]
    [Field K] [Fintype K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (rho : Representation K A V) (hrho : Function.Injective rho) :
    Nat.card A ∣ Nat.card (GL (Fin (Module.finrank K V)) K) := by
  let basis : Module.Basis (Fin (Module.finrank K V)) K V :=
    Module.finBasis K V
  let glEquiv : GL (Fin (Module.finrank K V)) K ≃*
      LinearMap.GeneralLinearGroup K V :=
    Matrix.GeneralLinearGroup.toLin' basis
  have hcard : Nat.card (LinearMap.GeneralLinearGroup K V) =
      Nat.card (GL (Fin (Module.finrank K V)) K) :=
    Nat.card_congr glEquiv.symm.toEquiv
  rw [← hcard]
  have hrhoUnits : Function.Injective rho.toHomUnits := by
    intro a b hab
    apply hrho
    exact congrArg Units.val hab
  exact Subgroup.card_dvd_of_injective rho.toHomUnits hrhoUnits

/-- A faithful prime-order representation in characteristic two and dimension
four is irreducible when the prime divides q squared plus one. -/
private theorem lemma114_primeOrder_representation_irreducible_of_gl_card
    {A K V : Type*} [Group A] [Fintype A]
    [Field K] [Fintype K] [CharP K 2]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (r : ℕ) (hr : r.Prime) (hrne2 : r ≠ 2)
    (hAcard : Nat.card A = r)
    (rho : Representation K A V) (hrho : Function.Injective rho)
    (hfinrank : Module.finrank K V = 4)
    (hrdiv : r ∣ Fintype.card K ^ 2 + 1)
    (hq : 2 ≤ Fintype.card K) (hqeven : Even (Fintype.card K))
    (U : Submodule K V)
    (hUinv : ∀ a : A, ∀ v ∈ U, rho a v ∈ U) :
    U = ⊥ ∨ U = ⊤ := by
  classical
  by_cases hUbot : U = ⊥
  · exact Or.inl hUbot
  by_cases hUtop : U = ⊤
  · exact Or.inr hUtop
  exfalso
  have hAodd : Odd (Fintype.card A) := by
    rw [← Nat.card_eq_fintype_card, hAcard]
    exact hr.odd_of_ne_two hrne2
  obtain ⟨W, hUW, hWinv⟩ :=
    lemma114_exists_isCompl_invariant_of_odd_group hAodd rho U hUinv
  have hWbot : W ≠ ⊥ := by
    intro hbot
    apply hUtop
    have hsup : U ⊔ W = ⊤ := codisjoint_iff.mp hUW.2
    simpa [hbot] using hsup
  have hUpos : 1 ≤ Module.finrank K U :=
    Submodule.one_le_finrank_iff.mpr hUbot
  have hWpos : 1 ≤ Module.finrank K W :=
    Submodule.one_le_finrank_iff.mpr hWbot
  have hsum : Module.finrank K U + Module.finrank K W = 4 := by
    simpa [hfinrank] using Submodule.finrank_add_eq_of_isCompl hUW
  have hUle : Module.finrank K U ≤ 3 := by omega
  have hWle : Module.finrank K W ≤ 3 := by omega
  let rhoU : Representation K A U :=
    rho.subrepresentation U (by
      intro a v hv
      exact hUinv a v hv)
  let rhoW : Representation K A W :=
    rho.subrepresentation W (by
      intro a v hv
      exact hWinv a v hv)
  letI : Fact (Nat.Prime (Nat.card A)) := ⟨by rw [hAcard]; exact hr⟩
  rcases rhoU.ker.eq_bot_or_eq_top_of_prime_card with hkerU | hkerU
  · have hinjU : Function.Injective rhoU :=
      (MonoidHom.ker_eq_bot_iff rhoU).mp hkerU
    have hdvd :=
      lemma114_card_dvd_gl_finrank_of_representation_injective rhoU hinjU
    rw [hAcard] at hdvd
    have hcop := lemma114_coprime_qsq_add_one_gl_card hq hqeven
      (Module.finrank K U) hUpos hUle
    exact hr.ne_one (Nat.eq_one_of_dvd_coprimes hcop hrdiv hdvd)
  · have hUfix (a : A) (u : U) : rho a (u : V) = (u : V) := by
      have ha : a ∈ rhoU.ker := by
        rw [hkerU]
        trivial
      have ha' : rhoU a = (1 : Module.End K U) := ha
      have hau := congrArg (fun f : Module.End K U => f u) ha'
      exact congrArg Subtype.val (by simpa [rhoU] using hau)
    have hinjW : Function.Injective rhoW := by
      intro a b hab
      apply hrho
      apply LinearMap.ext
      intro v
      have hv : v ∈ U ⊔ W := by
        rw [codisjoint_iff.mp hUW.2]
        trivial
      rcases Submodule.mem_sup.mp hv with ⟨u, hu, w, hw, huw⟩
      rw [← huw]
      have hu_a := hUfix a ⟨u, hu⟩
      have hu_b := hUfix b ⟨u, hu⟩
      have hw_ab : rho a w = rho b w := by
        have habw := congrArg
          (fun f : Module.End K W => f ⟨w, hw⟩) hab
        exact congrArg Subtype.val (by simpa [rhoW] using habw)
      calc
        rho a (u + w) = rho a u + rho a w := map_add _ _ _
        _ = u + rho a w := by rw [hu_a]
        _ = u + rho b w := by rw [hw_ab]
        _ = rho b u + rho b w := by rw [hu_b]
        _ = rho b (u + w) := (map_add _ _ _).symm
    have hdvd :=
      lemma114_card_dvd_gl_finrank_of_representation_injective rhoW hinjW
    rw [hAcard] at hdvd
    have hcop := lemma114_coprime_qsq_add_one_gl_card hq hqeven
      (Module.finrank K W) hWpos hWle
    exact hr.ne_one (Nat.eq_one_of_dvd_coprimes hcop hrdiv hdvd)

private theorem lemma114_suzuki_zpowers_irreducible
    (m r : ℕ) (hr : r.Prime) (hrne2 : r ≠ 2)
    (z : SuzukiMatrixGroup m) (hzorder : orderOf z = r)
    (hrdiv : r ∣ (2 ^ (2 * m + 1)) ^ 2 + 1)
    (U : Submodule (BinaryGaloisField (2 * m + 1))
      (Fin 4 → BinaryGaloisField (2 * m + 1)))
    (hUinv : ∀ a : Subgroup.zpowers z, ∀ v ∈ U,
      (Matrix.GeneralLinearGroup.toLin
        (((a : SuzukiMatrixGroup m) :
          GL (Fin 4) (BinaryGaloisField (2 * m + 1))))).toLinearEquiv v ∈ U) :
    U = ⊥ ∨ U = ⊤ := by
  let K := BinaryGaloisField (2 * m + 1)
  let V := Fin 4 → K
  let A := Subgroup.zpowers z
  letI : Fintype K := Fintype.ofFinite K
  letI : Fintype A := Fintype.ofFinite A
  let rhoGL : A →* GL (Fin 4) K :=
    (SuzukiMatrixGroup m).subtype.comp A.subtype
  let rho : Representation K A V :=
    (Units.coeHom (Module.End K V)).comp
      (Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp rhoGL)
  have hAcard : Nat.card A = r := by
    dsimp [A]
    rw [Nat.card_zpowers, hzorder]
  have hrho : Function.Injective rho := by
    intro a b hab
    apply A.subtype_injective
    apply (SuzukiMatrixGroup m).subtype_injective
    apply Matrix.GeneralLinearGroup.toLin.injective
    apply Units.ext
    exact hab
  have hfinrank : Module.finrank K V = 4 := by
    simp [V]
  have hKcardNat : Nat.card K = 2 ^ (2 * m + 1) := by
    simpa [K, BinaryGaloisField] using
      GaloisField.card 2 (2 * m + 1) (by omega : 2 * m + 1 ≠ 0)
  have hKcard : Fintype.card K = 2 ^ (2 * m + 1) := by
    rw [Fintype.card_eq_nat_card, hKcardNat]
  have hrdivK : r ∣ Fintype.card K ^ 2 + 1 := by
    rwa [hKcard]
  have hq : 2 ≤ Fintype.card K := by
    rw [hKcard]
    exact Nat.one_lt_pow (by omega : 2 * m + 1 ≠ 0) (by norm_num)
  have hqeven : Even (Fintype.card K) := by
    rw [hKcard]
    exact even_two.pow_of_ne_zero (by omega : 2 * m + 1 ≠ 0)
  apply lemma114_primeOrder_representation_irreducible_of_gl_card
    r hr hrne2 hAcard rho hrho hfinrank hrdivK hq hqeven U
  intro a v hv
  simpa [rho, rhoGL, A, K, V] using hUinv a v hv

private theorem lemma114_suzuki_eq_one_of_fix_ne_zero
    (m r : ℕ) (hr : r.Prime) (hrne2 : r ≠ 2)
    (R : Subgroup (SuzukiMatrixGroup m))
    (z : Subgroup.center R)
    (hzorder : orderOf ((z : R) : SuzukiMatrixGroup m) = r)
    (hrdiv : r ∣ (2 ^ (2 * m + 1)) ^ 2 + 1)
    (y : R)
    (v : Fin 4 → BinaryGaloisField (2 * m + 1)) (hv : v ≠ 0)
    (hyfix :
      (Matrix.GeneralLinearGroup.toLin
        (((y : SuzukiMatrixGroup m) :
          GL (Fin 4) (BinaryGaloisField (2 * m + 1))))).toLinearEquiv v = v) :
    y = 1 := by
  let K := BinaryGaloisField (2 * m + 1)
  let V := Fin 4 → K
  let G := SuzukiMatrixGroup m
  let zG : G := z
  let act (g : G) : V ≃ₗ[K] V :=
    (Matrix.GeneralLinearGroup.toLin
      ((g : G) : GL (Fin 4) K)).toLinearEquiv
  let A := Subgroup.zpowers zG
  let U : Submodule K V :=
    Submodule.span K (Set.range fun a : A => act (a : G) v)
  have hUinv : ∀ a : A, ∀ x ∈ U, act (a : G) x ∈ U := by
    intro a x hx
    refine Submodule.span_induction
      (p := fun x _ => act (a : G) x ∈ U) ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨b, rfl⟩
      apply Submodule.subset_span
      refine ⟨a * b, ?_⟩
      simp [act, map_mul]
    · simp [act]
    · intro x₁ x₂ _hx₁ _hx₂ hx₁ hx₂
      simpa using U.add_mem hx₁ hx₂
    · intro c x _hx hx
      simpa using U.smul_mem c hx
  have hvU : v ∈ U := by
    apply Submodule.subset_span
    refine ⟨1, ?_⟩
    simp [act]
  have hUne : U ≠ ⊥ := by
    intro hUbot
    have hvbot : v ∈ (⊥ : Submodule K V) := by
      simpa [hUbot] using hvU
    have hvzero : v = 0 := by simpa using hvbot
    exact hv hvzero
  have hUtop : U = ⊤ := by
    rcases lemma114_suzuki_zpowers_irreducible
      m r hr hrne2 zG hzorder hrdiv U hUinv with hbot | htop
    · exact False.elim (hUne hbot)
    · exact htop
  have hzy : Commute zG (y : G) := by
    change zG * (y : G) = (y : G) * zG
    exact congrArg Subtype.val
      (Subgroup.mem_center_iff.mp z.property y).symm
  have hay (a : A) : Commute (a : G) (y : G) := by
    rcases Subgroup.mem_zpowers_iff.mp a.property with ⟨n, hn⟩
    rw [← hn]
    exact hzy.zpow_left n
  have hyfixAct : act (y : G) v = v := by
    simpa [act, G, V, K] using hyfix
  have hyOrbit (a : A) : act (y : G) (act (a : G) v) = act (a : G) v := by
    calc
      act (y : G) (act (a : G) v) =
          act ((y : G) * (a : G)) v := by simp [act, map_mul]
      _ = act ((a : G) * (y : G)) v :=
        congrArg (fun g : G => act g v) (hay a).eq.symm
      _ = act (a : G) (act (y : G) v) := by simp [act, map_mul]
      _ = act (a : G) v := by rw [hyfixAct]
  have hyU : ∀ x ∈ U, act (y : G) x = x := by
    intro x hx
    refine Submodule.span_induction
      (p := fun x _ => act (y : G) x = x) ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨a, rfl⟩
      exact hyOrbit a
    · simp [act]
    · intro x₁ x₂ _hx₁ _hx₂ hx₁ hx₂
      simpa [hx₁, hx₂] using map_add (act (y : G)) x₁ x₂
    · intro c x _hx hx
      simpa [hx] using map_smul (act (y : G)) c x
  have hyall (x : V) : act (y : G) x = x := by
    apply hyU x
    rw [hUtop]
    trivial
  apply R.subtype_injective
  apply (SuzukiMatrixGroup m).subtype_injective
  apply Matrix.GeneralLinearGroup.toLin.injective
  apply Units.ext
  apply LinearMap.ext
  intro x
  simpa [act, G, V, K] using hyall x

private noncomputable def lemma114_generalLinearToMulAut
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V] :
    LinearMap.GeneralLinearGroup K V →* MulAut (Multiplicative V) where
  toFun g := AddEquiv.toMultiplicative g.toLinearEquiv.toAddEquiv
  map_one' := by
    ext x
    rfl
  map_mul' g h := by
    ext x
    rfl

@[reducible] private noncomputable def lemma114_suzukiNaturalMulAction
    (m : ℕ) (R : Subgroup (SuzukiMatrixGroup m)) :
    MulDistribMulAction R
      (Multiplicative (Fin 4 → BinaryGaloisField (2 * m + 1))) :=
  let K := BinaryGaloisField (2 * m + 1)
  let V := Fin 4 → K
  let rhoGL : R →* GL (Fin 4) K :=
    (SuzukiMatrixGroup m).subtype.comp R.subtype
  let rhoMul : R →* MulAut (Multiplicative V) :=
    lemma114_generalLinearToMulAut.comp
      (Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp rhoGL)
  MulDistribMulAction.compHom (Multiplicative V) rhoMul

private theorem lemma114_suzuki_actsRegularly_of_central_element
    (m r : ℕ) (hr : r.Prime) (hrne2 : r ≠ 2)
    (R : Subgroup (SuzukiMatrixGroup m))
    (z : Subgroup.center R)
    (hzorder : orderOf ((z : R) : SuzukiMatrixGroup m) = r)
    (hrdiv : r ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) :
    letI : MulDistribMulAction R
      (Multiplicative (Fin 4 → BinaryGaloisField (2 * m + 1))) :=
        lemma114_suzukiNaturalMulAction m R
    ActsRegularly R
      (Multiplicative (Fin 4 → BinaryGaloisField (2 * m + 1))) := by
  let K := BinaryGaloisField (2 * m + 1)
  let V := Fin 4 → K
  letI : MulDistribMulAction R (Multiplicative V) :=
    lemma114_suzukiNaturalMulAction m R
  intro y hy
  rw [Subgroup.eq_bot_iff_forall]
  intro v hv
  have hyfixMul := hv ⟨y, Subgroup.mem_zpowers y⟩
  by_cases hvzero : Multiplicative.toAdd v = (0 : V)
  · change Multiplicative.toAdd v = (0 : V)
    exact hvzero
  · exfalso
    apply hy
    apply lemma114_suzuki_eq_one_of_fix_ne_zero
      m r hr hrne2 R z hzorder hrdiv y (Multiplicative.toAdd v) hvzero
    have hyfixAdd := congrArg Multiplicative.toAdd hyfixMul
    simpa [lemma114_suzukiNaturalMulAction, lemma114_generalLinearToMulAut,
      MulAction.compHom_smul_def, K, V] using hyfixAdd

private theorem lemma114_suzuki_nonsplit_oddSylow_isCyclic
    (m r : ℕ) (hr : r.Prime) (hrne2 : r ≠ 2)
    (R : Sylow r (SuzukiMatrixGroup m))
    (hrdiv : r ∣ (2 ^ (2 * m + 1)) ^ 2 + 1)
    (hrG : r ∣ Nat.card (SuzukiMatrixGroup m)) :
    IsCyclic R := by
  letI : Fact r.Prime := ⟨hr⟩
  have hrdivR : r ∣ Nat.card (R : Subgroup (SuzukiMatrixGroup m)) :=
    Sylow.dvd_card_of_dvd_card R hrG
  have hRcard_gt : 1 < Nat.card (R : Subgroup (SuzukiMatrixGroup m)) :=
    lt_of_lt_of_le hr.one_lt (Nat.le_of_dvd (Nat.card_pos) hrdivR)
  letI : Nontrivial (R : Type _) :=
    Finite.one_lt_card_iff_nontrivial.mp hRcard_gt
  have hcenterNontrivial :
      Nontrivial (Subgroup.center (R : Subgroup (SuzukiMatrixGroup m))) :=
    IsPGroup.center_nontrivial
      (G := (R : Subgroup (SuzukiMatrixGroup m))) R.isPGroup'
  have hcenterCard_gt : 1 < Nat.card
      (Subgroup.center (R : Subgroup (SuzukiMatrixGroup m))) :=
    Finite.one_lt_card_iff_nontrivial.mpr hcenterNontrivial
  have hrdivCenter : r ∣ Nat.card
      (Subgroup.center (R : Subgroup (SuzukiMatrixGroup m))) := by
    obtain ⟨k, hk⟩ :=
      (IsPGroup.iff_card.mp (R.isPGroup'.to_subgroup
        (Subgroup.center (R : Subgroup (SuzukiMatrixGroup m)))))
    have hkpos : 0 < k := by
      by_contra hk0
      have hkz : k = 0 := Nat.eq_zero_of_not_pos hk0
      rw [hkz, pow_zero] at hk
      omega
    rw [hk]
    exact dvd_pow_self r (Nat.ne_of_gt hkpos)
  obtain ⟨z, hzorder⟩ :=
    exists_prime_orderOf_dvd_card'
      (G := Subgroup.center (R : Subgroup (SuzukiMatrixGroup m)))
      r hrdivCenter
  have hzorderG :
      orderOf ((z : R) : SuzukiMatrixGroup m) = r := by
    calc
      orderOf ((z : R) : SuzukiMatrixGroup m) = orderOf (z : R) :=
        Subgroup.orderOf_coe (z : R)
      _ = orderOf z := Subgroup.orderOf_coe z
      _ = r := hzorder
  let K := BinaryGaloisField (2 * m + 1)
  let V := Fin 4 → K
  letI : MulDistribMulAction R (Multiplicative V) :=
    lemma114_suzukiNaturalMulAction m R
  have hregular : ActsRegularly R (Multiplicative V) :=
    lemma114_suzuki_actsRegularly_of_central_element
      m r hr hrne2 R z hzorderG hrdiv
  haveI : Nontrivial (Multiplicative V) := inferInstance
  have hRodd : Odd (Nat.card R) := by
    obtain ⟨k, hk⟩ := R.isPGroup'.exists_card_eq
    rw [hk]
    exact (hr.odd_of_ne_two hrne2).pow
  have htopP : IsPGroup r (⊤ : Subgroup R) :=
    R.isPGroup'.to_subgroup ⊤
  have htopCyclic : IsCyclic (⊤ : Subgroup R) :=
    isCyclic_of_odd_regular_pSubgroup hr hRodd hregular htopP
  exact (Subgroup.topEquiv : (⊤ : Subgroup R) ≃* R).isCyclic.mp htopCyclic

/-! ## Odd Sylow cyclicity in the PSL model -/

public theorem lemma114_odd_subgroup_le_of_quotient_isPGroup_two
    {G : Type*} [Group G] [Finite G] {T O B : Subgroup G}
    [(O.subgroupOf B).Normal]
    (hTB : T ≤ B)
    (hTodd : Odd (Nat.card T))
    (hquot2 : IsPGroup 2 (B ⧸ O.subgroupOf B)) :
    T ≤ O := by
  classical
  let OB : Subgroup B := O.subgroupOf B
  letI : OB.Normal := by
    change (O.subgroupOf B).Normal
    infer_instance
  let TB : Subgroup B := T.subgroupOf B
  let qB : B →* B ⧸ OB := QuotientGroup.mk' OB
  let Tbar : Subgroup (B ⧸ OB) := TB.map qB
  have hTbar2 : IsPGroup 2 Tbar := hquot2.to_subgroup Tbar
  have hTbarOdd : Odd (Nat.card Tbar) := by
    apply hTodd.of_dvd_nat
    have hdiv : Nat.card Tbar ∣ Nat.card TB :=
      Subgroup.card_map_dvd (H := TB) qB
    simpa [TB, natCard_subgroupOf_eq T B hTB] using hdiv
  have hTbarCard : Nat.card Tbar = 1 := by
    rcases hTbar2.card_eq_or_dvd with hcard | hdiv
    · exact hcard
    · exact False.elim (hTbarOdd.not_two_dvd_nat hdiv)
  have hTbarBot : Tbar = ⊥ := Subgroup.card_eq_one.mp hTbarCard
  intro t ht
  let tB : B := ⟨t, hTB ht⟩
  have htbar : qB tB ∈ Tbar :=
    Subgroup.mem_map_of_mem qB (show tB ∈ TB from ht)
  have htone : qB tB = 1 := by simpa [hTbarBot] using htbar
  exact (QuotientGroup.eq_one_iff (N := OB) (x := tB)).1 htone

public theorem lemma114_odd_subgroup_le_of_normalizer_card_two
    {G : Type*} [Group G] [Finite G]
    {R T : Subgroup G}
    (hRleN : R ≤ Subgroup.normalizer (T : Set G))
    (hTodd : Odd (Nat.card R))
    (hNcard : Nat.card (Subgroup.normalizer (T : Set G)) =
      2 * Nat.card T) :
    R ≤ T := by
  let N : Subgroup G := Subgroup.normalizer (T : Set G)
  let TN : Subgroup N := T.subgroupOf N
  letI : TN.Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer (by
      simpa [N] : N ≤ Subgroup.normalizer (T : Set G))
  have hTNcard : Nat.card TN = Nat.card T :=
    natCard_subgroupOf_eq T N (Subgroup.le_normalizer (H := T))
  have hquotcard : Nat.card (N ⧸ TN) = 2 := by
    apply Nat.mul_right_cancel (Nat.card_pos (α := T))
    calc
      Nat.card (N ⧸ TN) * Nat.card T =
          Nat.card (N ⧸ TN) * Nat.card TN := by rw [hTNcard]
      _ = Nat.card N :=
        (Subgroup.card_eq_card_quotient_mul_card_subgroup (s := TN)).symm
      _ = 2 * Nat.card T := hNcard
  have hquot2 : IsPGroup 2 (N ⧸ TN) := by
    apply IsPGroup.iff_card.mpr
    exact ⟨1, by simpa [hquotcard]⟩
  exact lemma114_odd_subgroup_le_of_quotient_isPGroup_two
    (T := R) (O := T) (B := N) hRleN hTodd hquot2

public theorem lemma114_mem_eq_one_of_coprime_card
    {G : Type*} [Group G] [Finite G]
    (A B : Subgroup G) (hcoprime : Nat.Coprime (Nat.card A) (Nat.card B))
    {x : G} (hxA : x ∈ A) (hxB : x ∈ B) :
    x = 1 := by
  have horder_A : orderOf x ∣ Nat.card A := by
    simpa [Subgroup.orderOf_coe] using
      (orderOf_dvd_natCard (⟨x, hxA⟩ : A))
  have horder_B : orderOf x ∣ Nat.card B := by
    simpa [Subgroup.orderOf_coe] using
      (orderOf_dvd_natCard (⟨x, hxB⟩ : B))
  exact orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hcoprime horder_A horder_B)

/-! ## Split odd Sylows in the Suzuki model -/

private noncomputable def lemma114_suzukiBorel (m : ℕ) :
    Subgroup (GL (Fin 4) (BinaryGaloisField (2 * m + 1))) :=
  Subgroup.closure {A | ∃ a b, A = SuzukiRootGL m a b} ⊔
    Subgroup.closure {A | ∃ x, A = SuzukiTorusGL m x}

private theorem lemma114_suzuki_standardBorel_oddSubgroup_isCyclic
    (m : ℕ) (hm : 0 < m)
    (T0 : Subgroup (lemma114_suzukiBorel m))
    (hT0odd : Odd (Nat.card T0)) :
    IsCyclic T0 := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) := by
    intro x
    exact iterateFrobeniusEquiv_def K 2 (m + 1) x
  have hpi_sq : ∀ x : K, pi (pi x) = x ^ 2 :=
    External.binaryGaloisField_tits_formula_sq m pi hpi
  let F : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ a b : K, A = SuzukiRootGL m a b}
  let H : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ x : Kˣ, A = SuzukiTorusGL m x}
  let B : Subgroup (GL (Fin 4) K) := lemma114_suzukiBorel m
  change IsCyclic (show Subgroup B from T0)
  rcases External.huppert_blackburn_XI_3_1 m hm pi hpi_sq with
    ⟨_hunique, hpi_formula, _hFp, _hFpow, _hForder, _hclass, hFcard,
      _hFtype, _hrootmul, _hcomm, _hcommcoord, htorus_equiv,
      _htorusconj, _hdisjoint, _hfixed⟩
  rcases htorus_equiv with ⟨eH, _heH⟩
  have hB : B = F ⊔ H := rfl
  have hFleB : F ≤ B := by
    rw [hB]
    exact le_sup_left
  have hHleB : H ≤ B := by
    rw [hB]
    exact le_sup_right
  let FB : Subgroup B := F.subgroupOf B
  let HB : Subgroup B := H.subgroupOf B
  have hHnorm : H ≤ Subgroup.normalizer (F : Set (GL (Fin 4) K)) :=
    External.suzukiTorusClosure_le_normalizer_rootClosure
      m pi hpi_sq hpi_formula
  letI : FB.Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer
      (sup_le Subgroup.le_normalizer hHnorm)
  have hsup : FB ⊔ HB = ⊤ := by
    calc
      FB ⊔ HB = (F ⊔ H).subgroupOf B :=
        (Subgroup.subgroupOf_sup hFleB hHleB).symm
      _ = ⊤ := by rw [← hB, Subgroup.subgroupOf_self]
  let eHB : HB ≃* H := Subgroup.subgroupOfEquivOfLe hHleB
  have hHcyclic : IsCyclic H :=
    eH.isCyclic.mp (inferInstance : IsCyclic Kˣ)
  have hHBcyclic : IsCyclic HB := eHB.isCyclic.mpr hHcyclic
  let qB : B →* B ⧸ FB := QuotientGroup.mk' FB
  have hmapFB : FB.map qB = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    exact le_of_eq (QuotientGroup.ker_mk' FB).symm
  have hmapHB : HB.map qB = ⊤ := by
    calc
      HB.map qB = ⊥ ⊔ HB.map qB := (bot_sup_eq _).symm
      _ = (FB ⊔ HB).map qB := by rw [Subgroup.map_sup, hmapFB]
      _ = ⊤ := by
        rw [hsup]
        exact Subgroup.map_top_of_surjective qB
          (QuotientGroup.mk'_surjective FB)
  let qHB : HB →* B ⧸ FB := qB.comp HB.subtype
  have hqHBsurj : Function.Surjective qHB := by
    intro x
    have hx : x ∈ HB.map qB := by rw [hmapHB]; trivial
    rcases hx with ⟨h, hh, rfl⟩
    exact ⟨⟨h, hh⟩, rfl⟩
  have hquotCyclic : IsCyclic (B ⧸ FB) := by
    letI : IsCyclic HB := hHBcyclic
    exact isCyclic_of_surjective qHB hqHBsurj
  let qT : T0 →* B ⧸ FB := qB.comp T0.subtype
  have hFBcard : Nat.card FB = Nat.card F :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hFleB).toEquiv
  have hcop : Nat.Coprime (Nat.card T0) (Nat.card FB) := by
    rw [hFBcard, hFcard]
    simpa [pow_mul] using
      hT0odd.coprime_two_right.pow_right ((2 * m + 1) * 2)
  have hqTinj : Function.Injective qT := by
    intro x y hxy
    apply T0.subtype_injective
    have hdivFB : (x : B) / (y : B) ∈ FB :=
      QuotientGroup.eq_iff_div_mem.mp hxy
    have hdivT : (x : B) / (y : B) ∈ T0 :=
      T0.div_mem x.property y.property
    have hdivone : (x : B) / (y : B) = 1 :=
      lemma114_mem_eq_one_of_coprime_card T0 FB hcop hdivT hdivFB
    exact div_eq_one.mp hdivone
  letI : IsCyclic (B ⧸ FB) := hquotCyclic
  exact isCyclic_of_injective qT hqTinj

private theorem lemma114_suzuki_split_oddSylow_isCyclic
    (m r : ℕ) (hm : 0 < m) (hr : r.Prime) (hrne2 : r ≠ 2)
    (R : Sylow r (SuzukiMatrixGroup m))
    (hrdiv : r ∣ 2 ^ (2 * m + 1) - 1) :
    IsCyclic R := by
  letI : Fact r.Prime := ⟨hr⟩
  let K := BinaryGaloisField (2 * m + 1)
  let q := 2 ^ (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) := by
    intro x
    exact iterateFrobeniusEquiv_def K 2 (m + 1) x
  let pinf : ℙ K (Fin 4 → K) :=
    Projectivization.mk K ![1, 0, 0, 0] (by simp)
  let p : K → K → ℙ K (Fin 4 → K) := fun x y =>
    Projectivization.mk K
      ![x * y + pi x * x ^ 2 + pi y, y, x, 1] (by simp)
  let O : Set (ℙ K (Fin 4 → K)) :=
    {pinf} ∪ Set.range fun z : K × K => p z.1 z.2
  let Omega := {z : ℙ K (Fin 4 → K) // z ∈ O}
  let G := SuzukiMatrixGroup m
  let F : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ a b : K, A = SuzukiRootGL m a b}
  let H : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ x : Kˣ, A = SuzukiTorusGL m x}
  let B : Subgroup (GL (Fin 4) K) := F ⊔ H
  rcases External.huppert_blackburn_XI_3_3 m hm pi hpi with
    ⟨hpres, _hrecognition, _hfaithful, htwo_raw, _hthree,
      hOcard, _hGcard, hstabilizer_raw⟩
  let linRep : G →* LinearMap.GeneralLinearGroup K (Fin 4 → K) :=
    Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp G.subtype
  letI : MulAction G (ℙ K (Fin 4 → K)) :=
    MulAction.compHom (ℙ K (Fin 4 → K)) linRep
  let ovoid : SubMulAction G (ℙ K (Fin 4 → K)) :=
    { carrier := O
      smul_mem' := by
        intro g z hz
        change (Matrix.GeneralLinearGroup.toLin
          (g : GL (Fin 4) K)).toLinearEquiv • z ∈ O
        exact hpres g z hz }
  letI : MulAction G Omega := ovoid.mulAction
  letI : MulAction R Omega :=
    MulAction.compHom Omega (R : Subgroup G).subtype
  have hOmegaCard : Nat.card Omega = q ^ 2 + 1 := by
    simpa [Omega, O, p, pinf, q] using hOcard
  have hrnotOmega : ¬ r ∣ Nat.card Omega := by
    rw [hOmegaCard]
    intro hrOmega
    have hrsub : r ∣ q ^ 2 - 1 := by
      apply dvd_trans hrdiv
      simpa [q] using Nat.sub_dvd_pow_sub_pow q 1 2
    have hqpos : 0 < q := by
      dsimp [q]
      positivity
    have hqsqpos : 0 < q ^ 2 := pow_pos hqpos _
    have hdiff : q ^ 2 + 1 - (q ^ 2 - 1) = 2 := by omega
    have hr2 := Nat.dvd_sub hrOmega hrsub
    rw [hdiff] at hr2
    rcases (Nat.dvd_prime Nat.prime_two).mp hr2 with hr1 | hr2eq
    · exact hr.ne_one hr1
    · exact hrne2 hr2eq
  obtain ⟨alpha, halpha⟩ :=
    R.isPGroup'.nonempty_fixed_point_of_prime_not_dvd_card Omega hrnotOmega
  have hOmega_gt : 1 < Nat.card Omega := by
    rw [hOmegaCard]
    have hqpos : 0 < q := by
      dsimp [q]
      positivity
    have hqsqpos : 0 < q ^ 2 := pow_pos hqpos _
    omega
  letI : Nontrivial Omega :=
    Finite.one_lt_card_iff_nontrivial.mp hOmega_gt
  let pinfO : Omega := ⟨pinf, Or.inl rfl⟩
  obtain ⟨beta, hab⟩ := exists_ne alpha
  obtain ⟨delta, hcd⟩ := exists_ne pinfO
  have habRaw : (alpha : ℙ K (Fin 4 → K)) ≠ beta := by
    intro h
    exact hab (Subtype.ext h.symm)
  have hcdRaw : (pinfO : ℙ K (Fin 4 → K)) ≠ delta := by
    intro h
    exact hcd (Subtype.ext h.symm)
  obtain ⟨g, hgalphaRaw, _hgbetaRaw⟩ :=
    htwo_raw (alpha : ℙ K (Fin 4 → K)) beta pinfO delta
      alpha.property beta.property pinfO.property delta.property habRaw hcdRaw
  have hgalpha : g • alpha = pinfO := Subtype.ext hgalphaRaw
  let Rc : Subgroup G :=
    (R : Subgroup G).map (MulAut.conj g).toMonoidHom
  have hRcStab : Rc ≤ MulAction.stabilizer G pinfO := by
    rintro x ⟨a, haR, rfl⟩
    rw [MulAction.mem_stabilizer_iff]
    let aR : R := ⟨a, haR⟩
    have hafix : (a : G) • alpha = alpha := halpha aR
    change (g * a * g⁻¹) • pinfO = pinfO
    rw [← hgalpha]
    simp [mul_smul, hafix]
  have hRcB : ∀ x : Rc, ((x : G) : GL (Fin 4) K) ∈ B := by
    intro x
    have hxfix := MulAction.mem_stabilizer_iff.mp (hRcStab x.property)
    have hxfixRaw := congrArg Subtype.val hxfix
    change (Matrix.GeneralLinearGroup.toLin
      ((x : G) : GL (Fin 4) K)).toLinearEquiv • pinf = pinf at hxfixRaw
    exact (hstabilizer_raw (x : G)).mp hxfixRaw
  let toB : Rc →* B :=
    (G.subtype.comp Rc.subtype).codRestrict B hRcB
  have htoB : Function.Injective toB := by
    intro x y hxy
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : B => (z : GL (Fin 4) K)) hxy
  let Tc : Subgroup B := toB.range
  let eTc : Rc ≃* Tc := MonoidHom.ofInjective htoB
  let eConj : (R : Subgroup G) ≃* Rc :=
    MulEquiv.subgroupMap (MulAut.conj g) (R : Subgroup G)
