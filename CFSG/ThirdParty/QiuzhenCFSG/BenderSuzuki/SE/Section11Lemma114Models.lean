      have hgcd : Nat.gcd (Nat.card K - 1) 2 = 1 :=
        Nat.coprime_iff_gcd_eq_one.mp hq_sub_one_odd.coprime_two_right
      rw [hS0card, hgcd]
      omega
    have hS0ne : S0 ≠ ⊥ := by
      rw [← Subgroup.one_lt_card_iff_ne_bot]
      exact hS0card_gt
    have hS0align : ∃ a : PSL2MatrixGroup K,
        S0 = S.map (MulAut.conj a).toMonoidHom := by
      obtain ⟨u, hu_ne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hS0ne
      have huG : (u : PSL2MatrixGroup K) ≠ 1 := by
        intro hu
        apply hu_ne
        apply Subtype.ext
        exact hu
      obtain ⟨T0, huT0, hT0uniq⟩ := hpart (u : PSL2MatrixGroup K) huG
      have hS0leT0 : S0 ≤ T0 :=
          lemma114_cyclic_le_unique_partition_family Family
          hpartitionFamily huG huT0.1 (by simpa [Family] using huT0.2)
          u.property hS0cyclic
      rcases huT0.2 with hT0P | hT0U | hT0S
      · exfalso
        rcases hT0P with ⟨g, hg⟩
        have hcop : Nat.Coprime (Nat.card S0) (Nat.card T0) := by
          rw [hg, Subgroup.card_map_of_injective
            (MulAut.conj g).injective]
          rw [hS0card, hP0card]
          exact (lemma114_q_coprime_nonsplit_order
            (Nat.card K) Nat.card_pos).symm
        exact huG (lemma114_mem_eq_one_of_coprime_card S0 T0 hcop
          u.property (hS0leT0 u.property))
      · exfalso
        rcases hT0U with ⟨g, hg⟩
        have hcop : Nat.Coprime (Nat.card S0) (Nat.card T0) := by
          rw [hg, Subgroup.card_map_of_injective
            (MulAut.conj g).injective]
          rw [hS0card, hUcard]
          exact (lemma114_split_nonsplit_order_coprime
            (Nat.card K) (Finite.one_lt_card (α := K))).symm
        exact huG (lemma114_mem_eq_one_of_coprime_card S0 T0 hcop
          u.property (hS0leT0 u.property))
      · rcases hT0S with ⟨a, ha⟩
        refine ⟨a, ?_⟩
        calc
          S0 = T0 := Subgroup.eq_of_le_of_card_ge hS0leT0 (by
            rw [ha, Subgroup.card_map_of_injective
              (MulAut.conj a).injective, hS0card, hScard])
          _ = S.map (MulAut.conj a).toMonoidHom := ha
    obtain ⟨a, ha⟩ := hS0align
    let b : PSL2MatrixGroup K := g * a⁻¹
    have hTmap : T = S0.map (MulAut.conj b).toMonoidHom := by
      have heq :
          (MulEquiv.toMonoidHom (MulAut.conj b)).comp
              (MulEquiv.toMonoidHom (MulAut.conj a)) =
            MulEquiv.toMonoidHom (MulAut.conj g) := by
        apply MonoidHom.ext
        intro x
        change b * (a * x * a⁻¹) * b⁻¹ = g * x * g⁻¹
        have hb_inv : b⁻¹ = a * g⁻¹ := by
          dsimp [b]
          rw [mul_inv_rev, inv_inv]
        rw [hb_inv]
        rw [show b = g * a⁻¹ by rfl]
        simp only [mul_assoc]
        rw [@inv_mul_cancel_left (PSL2MatrixGroup K) _]
        rw [@inv_mul_cancel_left (PSL2MatrixGroup K) _]
      rw [hg, ha, Subgroup.map_map, heq]
    have hTnormcard :
        Nat.card (Subgroup.normalizer (T : Set (PSL2BinaryMatrixGroup n))) =
          2 * Nat.card T := by
      calc
        Nat.card (Subgroup.normalizer (T : Set (PSL2BinaryMatrixGroup n))) =
            Nat.card ((Subgroup.normalizer (S0 : Set (PSL2MatrixGroup K))).map
              (MulAut.conj b).toMonoidHom) := by
          rw [hTmap, Subgroup.map_equiv_normalizer_eq]
        _ = Nat.card (Subgroup.normalizer (S0 : Set (PSL2MatrixGroup K))) := by
          rw [Subgroup.card_map_of_injective (K :=
            Subgroup.normalizer (S0 : Set (PSL2MatrixGroup K)))
            (f := (MulAut.conj b).toMonoidHom) (MulAut.conj b).injective]
        _ = 2 * Nat.card S0 := hS0normalizer
        _ = 2 * Nat.card T := by
          rw [hg, Subgroup.card_map_of_injective (K := S)
            (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective]
          rw [hS0card, hScard]
    have hRodd : Odd (Nat.card (R : Subgroup (PSL2BinaryMatrixGroup n))) := by
      rw [hk]
      exact (hrFact.out.odd_of_ne_two hrne).pow
    have hTcyclic : IsCyclic T := by
      rw [hg]
      exact (MulEquiv.subgroupMap (MulAut.conj g) S).isCyclic.mp hSc
    letI : IsCyclic T := hTcyclic
    exact Subgroup.isCyclic_of_le
      (lemma114_odd_subgroup_le_of_normalizer_card_two hRnorm hRodd hTnormcard)

public theorem lemma114_psl2_oddSylow_isCyclic_of_equiv
    {E : Type*} [Group E] [Finite E] {n : ℕ} (hn : 2 ≤ n)
    (e : E ≃* PSL2BinaryMatrixGroup n) :
    ∀ r [Fact r.Prime], r ≠ 2 →
      ∀ R : Sylow r E, IsCyclic R := by
  intro r hrFact hrne R
  let Rbar : Sylow r (PSL2BinaryMatrixGroup n) :=
    Sylow.mapSurjective (f := e.toMonoidHom) e.surjective R
  have hbar : IsCyclic Rbar :=
    lemma114_psl2_oddSylow_isCyclic n hn r hrne Rbar
  have hmap : (Rbar : Subgroup (PSL2BinaryMatrixGroup n)) =
      (R : Subgroup E).map e.toMonoidHom := by
    exact Sylow.coe_mapSurjective (f := e.toMonoidHom) e.surjective R
  have hmapcyc : IsCyclic ((R : Subgroup E).map e.toMonoidHom) := by
    change IsCyclic (Rbar : Subgroup (PSL2BinaryMatrixGroup n)) at hbar
    rw [hmap] at hbar
    exact hbar
  exact (e.subgroupMap (R : Subgroup E)).isCyclic.mpr hmapcyc

/-- Corollary 8.5 makes the Lemma 11.4 residual `F₀` perfect. -/
public theorem lemma114FZero_isPerfect
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {A P : Subgroup X}
    (c85 : Corollary85Conclusion M t u0 A P) :
    commutator (lemma114FZero A) = ⊤ := by
  exact perfect_of_twoPrimeResidual_eq_top_of_model_quotient
    (lemma114FZero_twoPrimeResidual_eq_top A)
    c85.card_P_prime.two_le c85.model

/-- The odd central kernel of the Lemma 11.4 residual vanishes once its
quotient is known to be a PSL or Suzuki model. -/
public theorem lemma114_twoPrimeCore_eq_bot_of_model
    {E : Type u} [Group E] [Finite E] {n : ℕ}
    (hprime : 2 ≤ n)
    (hmodel :
      Nonempty ((E ⧸ twoPrimeCore E) ≃* PSL2BinaryMatrixGroup n) ∨
        ∃ m : ℕ,
          n = 2 * m + 1 ∧
            Nonempty ((E ⧸ twoPrimeCore E) ≃* SuzukiMatrixGroup m))
    (hres : twoPrimeResidual E = ⊤)
    (hcore : twoPrimeCore E = Subgroup.center E) :
    twoPrimeCore E = ⊥ := by
  let Z : Subgroup E := twoPrimeCore E
  letI : Z.Normal := by dsimp [Z]; infer_instance
  have hperfect : commutator E = ⊤ := by
    exact perfect_of_twoPrimeResidual_eq_top_of_model_quotient
      hres hprime (by
        rcases hmodel with ⟨⟨e⟩⟩ | ⟨m, hm, ⟨e⟩⟩
        · exact IsSimpleBenderGroupAtExponent.isPSL2 ⟨e⟩
        · exact IsSimpleBenderGroupAtExponent.isSuzuki ⟨m, hm, ⟨e⟩⟩)
  have hZcenter : Z = Subgroup.center E := by
    simpa [Z] using hcore
  have hZodd : Odd (Nat.card Z) := by
    apply Nat.coprime_two_left.mp
    simpa [Z, twoPrimeCore] using
      (pPrimeCore_coprime_card (G := E) (p := 2))
  change Z = ⊥
  apply lemma114_oddCentralCover_eq_bot hperfect Z hZcenter hZodd
  intro r hrFact hrne R
  rcases hmodel with ⟨⟨e⟩⟩ | ⟨m, _hm, ⟨e⟩⟩
  · exact lemma114_psl2_oddSylow_isCyclic_of_equiv
      hprime e r hrne R
  · exact lemma114_suzuki_oddSylow_isCyclic_of_equiv e r hrne R

public theorem lemma114_twoPrimeCore_eq_bot_of_quotient_model
    {X : Type u} [Group X] [Finite X]
    {M A P : Subgroup X} {t u0 : X}
    (c85 : Corollary85Conclusion M t u0 A P)
    (hmodel :
      Nonempty
          ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
            PSL2BinaryMatrixGroup (Nat.card P)) ∨
        ∃ m : ℕ,
          Nat.card P = 2 * m + 1 ∧
            Nonempty
              ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
                SuzukiMatrixGroup m)) :
    twoPrimeCore (lemma114FZero A) = ⊥ := by
  exact lemma114_twoPrimeCore_eq_bot_of_model
    c85.card_P_prime.two_le hmodel
    (lemma114FZero_twoPrimeResidual_eq_top A)
    c85.oddCore_eq_center

/-- Lift the recognized PSL/Suzuki quotient model across the now-trivial odd
central kernel. -/
public theorem lemma114_model_psl_or_suzuki_of_model
    {E : Type u} [Group E] [Finite E] {n : ℕ}
    (hprime : 2 ≤ n)
    (hmodel :
      Nonempty ((E ⧸ twoPrimeCore E) ≃* PSL2BinaryMatrixGroup n) ∨
        ∃ m : ℕ,
          n = 2 * m + 1 ∧
            Nonempty ((E ⧸ twoPrimeCore E) ≃* SuzukiMatrixGroup m))
    (hres : twoPrimeResidual E = ⊤)
    (hcore : twoPrimeCore E = Subgroup.center E) :
    Nonempty (E ≃* PSL2BinaryMatrixGroup n) ∨
      ∃ m : ℕ,
        n = 2 * m + 1 ∧ Nonempty (E ≃* SuzukiMatrixGroup m) := by
  let Z : Subgroup E := twoPrimeCore E
  letI : Z.Normal := by dsimp [Z]; infer_instance
  have hZbot : Z = ⊥ := by
    simpa [Z] using
      lemma114_twoPrimeCore_eq_bot_of_model hprime hmodel hres hcore
  let qToE : E ⧸ Z ≃* E :=
    (QuotientGroup.quotientMulEquivOfEq hZbot).trans QuotientGroup.quotientBot
  rcases hmodel with ⟨⟨e⟩⟩ | ⟨m, hm, ⟨e⟩⟩
  · exact Or.inl ⟨qToE.symm.trans e⟩
  · exact Or.inr ⟨m, hm, ⟨qToE.symm.trans e⟩⟩

public theorem lemma114_model_psl_or_suzuki_of_quotient
    {X : Type u} [Group X] [Finite X]
    {M A P : Subgroup X} {t u0 : X}
    (c85 : Corollary85Conclusion M t u0 A P)
    (hmodel :
      Nonempty
          ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
            PSL2BinaryMatrixGroup (Nat.card P)) ∨
        ∃ m : ℕ,
          Nat.card P = 2 * m + 1 ∧
            Nonempty
              ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
                SuzukiMatrixGroup m)) :
    Nonempty (lemma114FZero A ≃* PSL2BinaryMatrixGroup (Nat.card P)) ∨
      ∃ m : ℕ,
        Nat.card P = 2 * m + 1 ∧
          Nonempty (lemma114FZero A ≃* SuzukiMatrixGroup m) := by
  exact lemma114_model_psl_or_suzuki_of_model
    c85.card_P_prime.two_le hmodel
    (lemma114FZero_twoPrimeResidual_eq_top A)
    c85.oddCore_eq_center

/-- The unitary quotient model is incompatible with the Lemma 11.4
fixed-centralizer configuration.  A PSU Borel contains a nontrivial element
centralizing an outside involution in its intersection with the conjugate
Borel.  Lifting that element through the odd central kernel puts it in the
fixed subgroup on the left below, hence back in the kernel, a contradiction. -/
public theorem lemma114_quotient_model_psl_or_suzuki_of_model
    {X : Type u} [Group X] [Finite X]
    {M A P : Subgroup X} {t : X}
    (ht : IsInvolution t) (htM : t ∉ M)
    (hprime : 2 ≤ Nat.card P)
    (hmodel : IsSimpleBenderGroupAtExponent (Nat.card P)
      (lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)))
    (hcore : twoPrimeCore (lemma114FZero A) =
      Subgroup.center (lemma114FZero A))
    (hsupport : Proposition84ModelSupport M A)
    (htF : t ∈ lemma114FZero A)
    (hfixed :
      (((M ⊓ rightConjugate M t) ⊓ lemma114FZero A) ⊓
          Subgroup.centralizer ({t} : Set X)) ≤
        (Subgroup.center (lemma114FZero A)).map
          (lemma114FZero A).subtype) :
    Nonempty
        ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
          PSL2BinaryMatrixGroup (Nat.card P)) ∨
      ∃ m : ℕ,
        Nat.card P = 2 * m + 1 ∧
          Nonempty
            ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
              SuzukiMatrixGroup m) := by
  rcases hmodel with hPSL | hSuzuki | hPSU
  · exact Or.inl hPSL
  · exact Or.inr hSuzuki
  · exfalso
    rcases hPSU with
      ⟨E, hEfield, hEfinite, J, hJ, hEcard, hfixedCard, ⟨e⟩⟩
    letI : Field E := hEfield
    letI : Finite E := hEfinite
    letI : Fintype E := Fintype.ofFinite E
    letI : Finite (Matrix.ProjGenLinGroup (Fin 3) E) :=
      Finite.of_surjective Matrix.ProjGenLinGroup.mk
        Matrix.ProjGenLinGroup.mk_surjective
    letI : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
      Finite.of_injective
        (fun x : ProjectiveSpecialUnitaryMatrixGroup J =>
          (x : Matrix.ProjGenLinGroup (Fin 3) E)) Subtype.coe_injective
    let F0 : Subgroup X := lemma114FZero A
    let Z : Subgroup F0 := twoPrimeCore F0
    letI : Z.Normal := by dsimp [Z]; infer_instance
    let q : F0 →* F0 ⧸ Z := QuotientGroup.mk' Z
    let Y : Subgroup F0 := (F0 ⊓ M).subgroupOf F0
    let B0 : Subgroup (F0 ⧸ Z) := Y.map q
    let tF : F0 := ⟨t, htF⟩
    have htFInv : IsInvolution tF := IsInvolution.subtype ht htF
    have hZodd : Odd (Nat.card Z) := by
      apply Nat.coprime_two_left.mp
      simpa [Z, twoPrimeCore] using
        (pPrimeCore_coprime_card (G := F0) (p := 2))
    have hZcenter : Z = Subgroup.center F0 := by
      simpa [Z, F0] using hcore
    have hZmapM : Z.map F0.subtype ≤ M := by
      have h := hsupport.oddCore_map_le_M
      change Z.map F0.subtype ≤ M at h
      exact h
    have hZY : Z ≤ Y := by
      intro z hz
      exact ⟨z.property,
        hZmapM (Subgroup.mem_map_of_mem F0.subtype hz)⟩
    have hBorel0 : IsBorelSubgroup B0 := by
      have h := hsupport.quotient_borel
      change IsBorelSubgroup B0 at h
      exact h
    have hqt : IsInvolution (q tF) :=
      BenderSuzuki.IsInvolution.quotient_mk_of_odd_kernel
        Z hZodd htFInv
    have hqB_iff (x : F0) : q x ∈ B0 ↔ (x : X) ∈ M := by
      change q x ∈ Y.map q ↔ (x : X) ∈ M
      rw [quotient_mk_mem_map_iff_of_le Z Y hZY]
      constructor
      · exact fun hx ↦ hx.2
      · exact fun hx ↦ ⟨x.property, hx⟩
    have hqtB : q tF ∉ B0 := by
      intro hmem
      exact htM ((hqB_iff tF).mp hmem)
    let BQ : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J) :=
      B0.map e.toMonoidHom
    have hBorelQ : IsBorelSubgroup BQ := by
      exact hBorel0.map_mulEquiv e
    have het : IsInvolution (e (q tF)) :=
      IsInvolution.map_of_injective hqt e.toMonoidHom e.injective
    have hetB : e (q tF) ∉ BQ := by
      intro hmem
      apply hqtB
      simpa [BQ] using hmem
    obtain ⟨zQ, hzQne, hzQB, hzQright, hzQcent⟩ :=
      psu_exists_nontrivial_borel_inter_rightConjugate_centralizer
        J (Nat.card P) hprime
          hEcard hfixedCard hJ hBorelQ (e (q tF)) het hetB
    obtain ⟨zbar, rfl⟩ := e.surjective zQ
    have hzbarne : zbar ≠ 1 := by
      intro hz
      apply hzQne
      rw [hz, map_one]
    have hzbarB : zbar ∈ B0 := by
      simpa [BQ] using hzQB
    have hzbarRight : zbar ∈ rightConjugate B0 (q tF) := by
      change e zbar ∈
        rightConjugate (B0.map e.toMonoidHom) (e (q tF)) at hzQright
      have hmap :
          (rightConjugate B0 (q tF)).map e.toMonoidHom =
            rightConjugate (B0.map e.toMonoidHom) (e (q tF)) := by
        simpa using rightConjugate_map B0 e.toMonoidHom (q tF)
      rw [← hmap] at hzQright
      rcases hzQright with ⟨y, hy, hey⟩
      have hyz : y = zbar := e.injective hey
      simpa [hyz] using hy
    have hzbarCent :
        zbar ∈ Subgroup.centralizer ({q tF} : Set (F0 ⧸ Z)) := by
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      apply e.injective
      simpa using Subgroup.mem_centralizer_singleton_iff.mp hzQcent
    obtain ⟨x, hxq⟩ := QuotientGroup.mk'_surjective Z zbar
    have hxB : q x ∈ B0 := by rw [hxq]; exact hzbarB
    have hxM : (x : X) ∈ M := (hqB_iff x).mp hxB
    have hxRightQ : q x ∈ rightConjugate B0 (q tF) := by
      rw [hxq]
      exact hzbarRight
    have hxRightY : x ∈ rightConjugate Y tF := by
      have hx : x ∈
          (rightConjugate (Y.map q) (q tF)).comap q := by
        exact hxRightQ
      rw [rightConjugate_map_quotient_comap_eq Z Y hZY tF] at hx
      exact hx
    have hxRightM : (x : X) ∈ rightConjugate M t := by
      rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map] at hxRightY ⊢
      rcases hxRightY with ⟨y, hy, hyx⟩
      refine ⟨(y : X), hy.2, ?_⟩
      exact congrArg Subtype.val hyx
    have hZcent : Z ≤ Subgroup.centralizer ({tF} : Set F0) := by
      intro z hz
      rw [hZcenter] at hz
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact (Subgroup.mem_center_iff.mp hz tF).symm
    have hxCentF : x ∈ Subgroup.centralizer ({tF} : Set F0) := by
      have hx : x ∈
          (Subgroup.centralizer ({q tF} : Set (F0 ⧸ Z))).comap q := by
        change q x ∈ Subgroup.centralizer ({q tF} : Set (F0 ⧸ Z))
        rw [hxq]
        exact hzbarCent
      rw [centralizer_comap_quotient_eq_of_odd_kernel
        Z hZodd htFInv hZcent] at hx
      exact hx
    have hxCent : (x : X) ∈ Subgroup.centralizer ({t} : Set X) := by
      rw [Subgroup.mem_centralizer_singleton_iff] at hxCentF ⊢
      exact congrArg Subtype.val hxCentF
    have hxCenterMap : (x : X) ∈ (Subgroup.center F0).map F0.subtype :=
      hfixed ⟨⟨⟨hxM, hxRightM⟩, x.property⟩, hxCent⟩
    have hxZ : x ∈ Z := by
      rcases hxCenterMap with ⟨z, hz, hzx⟩
      rw [hZcenter]
      have hzx' : z = x := Subtype.ext hzx
      simpa [hzx'] using hz
    apply hzbarne
    calc
      zbar = q x := hxq.symm
      _ = 1 := (QuotientGroup.eq_one_iff x).2 hxZ

/-! The source-facing specialization keeps the original Corollary 8.5
interface available to downstream modules. -/
public theorem lemma114_quotient_model_psl_or_suzuki
    {X : Type u} [Group X] [Finite X]
    {M A P : Subgroup X} {t u0 : X}
    (ht : IsInvolution t) (htM : t ∉ M)
    (c85 : Corollary85Conclusion M t u0 A P)
    (hsupport : Proposition84ModelSupport M A)
    (htF : t ∈ lemma114FZero A)
    (hfixed :
      (((M ⊓ rightConjugate M t) ⊓ lemma114FZero A) ⊓
          Subgroup.centralizer ({t} : Set X)) ≤
        (Subgroup.center (lemma114FZero A)).map
          (lemma114FZero A).subtype) :
    Nonempty
        ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
          PSL2BinaryMatrixGroup (Nat.card P)) ∨
      ∃ m : ℕ,
        Nat.card P = 2 * m + 1 ∧
          Nonempty
            ((lemma114FZero A ⧸ twoPrimeCore (lemma114FZero A)) ≃*
              SuzukiMatrixGroup m) := by
  exact lemma114_quotient_model_psl_or_suzuki_of_model
    ht htM c85.card_P_prime.two_le c85.model
    c85.oddCore_eq_center hsupport htF hfixed

/-! ## Fixed-point cardinality bridge -/

/- The cardinality of a finite regular action is the cardinality of the
acted-on set.  The action in Lemma 11.4 is written on a subtype of fixed
cosets, so we keep the transporter proof explicit here. -/
private theorem lemma114_card_eq_of_isRegularOn
    {X : Type u} {Omega : Type v} [Group X] [Finite X]
    [MulAction X Omega] [Finite Omega]
    (S : Subgroup X) (A : Set Omega) (alpha : Omega)
    (halpha : alpha ∈ A)
    (hstable : ∀ s : S, ∀ omega : Omega, omega ∈ A →
      (s : X) • omega ∈ A)
    (hreg : IsRegularOn S A) :
    Nat.card S = Nat.card {omega : Omega // omega ∈ A} := by
  classical
  let Fixed := {omega : Omega // omega ∈ A}
  let orbitMap : S → Fixed := fun s ↦
    ⟨(s : X) • alpha, hstable s alpha halpha⟩
  have horbitSurj : Function.Surjective orbitMap := by
    intro beta
    obtain ⟨s, hs, _⟩ := hreg halpha beta.property
    exact ⟨s, Subtype.ext hs⟩
  have horbitInj : Function.Injective orbitMap := by
    intro s r hsr
    obtain ⟨f, hf, huniq⟩ := hreg halpha
      (hstable s alpha halpha)
    have hsEq : s = f := huniq s (by simpa using hf)
    have hrEq : r = f := by
      apply huniq r
      change (r : X) • alpha = (s : X) • alpha
      exact (congrArg Subtype.val hsr).symm
    exact hsEq.trans hrEq.symm
  exact Nat.card_congr (Equiv.ofBijective orbitMap
    ⟨horbitInj, horbitSurj⟩)

/-- The Proposition 8.4 group `O^{2'}(C_X(V))`.  This is the group whose
action on `Omega_V` is doubly transitive. -/
@[expose] public def lemma114FHat
    {X : Type u} [Group X] (V : Subgroup X) : Subgroup X :=
  centralizerTwoPrimeResidual V

/-- The Section 11 group `C_X(V)^°`, generated by the involutions in the
centralizer.  This is the group that becomes dihedral of order `6` or `10`.
-/
@[expose] public def lemma114FCore
    {X : Type u} [Group X] (V : Subgroup X) : Subgroup X :=
  involutionCoreIn (Subgroup.centralizer (V : Set X))

/-- If `V = AP`, then its centralizer is the intersection of the
centralizers of the two factors. -/
public theorem lemma114_centralizer_eq_inf_of_eq_mul
    {X : Type u} [Group X]
    {V A P : Subgroup X}
    (hV : (V : Set X) = (A : Set X) * (P : Set X)) :
    Subgroup.centralizer (V : Set X) =
      Subgroup.centralizer (A : Set X) ⊓
        Subgroup.centralizer (P : Set X) := by
  have hAleV : A ≤ V := by
    intro x hx
    change x ∈ (V : Set X)
    rw [hV]
    exact Set.mem_mul.mpr ⟨x, hx, 1, P.one_mem, by simp⟩
  have hPleV : P ≤ V := by
    intro x hx
    change x ∈ (V : Set X)
    rw [hV]
    exact Set.mem_mul.mpr ⟨1, A.one_mem, x, hx, by simp⟩
  have hsup : A ⊔ P = V := by
    apply le_antisymm
    · exact sup_le hAleV hPleV
    · intro x hx
      change x ∈ (V : Set X) at hx
      rw [hV] at hx
      rcases Set.mem_mul.mp hx with ⟨a, ha, p, hp, hap⟩
      rw [← hap]
      exact Subgroup.mul_mem_sup ha hp
  rw [← hsup, Subgroup.sup_eq_closure, Subgroup.centralizer_closure]
  ext x
  simp only [Subgroup.mem_inf, Subgroup.mem_centralizer_iff,
    Set.mem_union]
  constructor
  · intro hx
    exact ⟨fun a ha => hx a (Or.inl ha),
      fun p hp => hx p (Or.inr hp)⟩
  · rintro ⟨hxA, hxP⟩ y (hyA | hyP)
    · exact hxA y hyA
    · exact hxP y hyP

/- The retained Corollary 8.5 Sylow subgroup acts regularly on the punctured
V-fixed set after intersecting with the `P`-centralizer. -/
public theorem lemma114_fixedPoints_punctured_card_of_root
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P V : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (ht : IsInvolution t) (htM : t ∉ M)
    (hYV : Y ≤ V)
    (hVnormS : V ≤ Subgroup.normalizer (root.S : Set X))
    (hVmul : (V : Set X) = (Y : Set X) * (P : Set X))
    (hVM : V ≤ M)
    (hVright : V ≤ rightConjugate M t) :
    Nat.card (root.S ⊓ Subgroup.centralizer (P : Set X) : Subgroup X) =
      Nat.card {omega : conjugateCosetSpace M //
        omega ∈ fixedPointsOfSubgroup X (conjugateCosetSpace M) V ∧
          omega ≠ QuotientGroup.mk 1} := by
  let base : conjugateCosetSpace M := QuotientGroup.mk 1
  let punct : Set (conjugateCosetSpace M) :=
    {omega | omega ∈ fixedPointsOfSubgroup X (conjugateCosetSpace M) V ∧
      omega ≠ base}
  have hreg := isRegularOn_inf_centralizer_fixedPoints_of_le
    root.S Y V base hYV root.S_regular hVnormS
  have hreg' : IsRegularOn (root.S ⊓ Subgroup.centralizer (V : Set X)) punct := by
    simpa [punct, base, and_comm, and_left_comm, and_assoc] using hreg
  have hbeta : (QuotientGroup.mk t : conjugateCosetSpace M) ∈ punct := by
    refine ⟨?_, ?_⟩
    · intro v hv
      apply MulAction.mem_stabilizer_iff.mp
      rw [conjugateCoset_stabilizer M t, ht.inv_eq_self]
      exact hVright hv
    · intro h
      apply htM
      simpa [base] using QuotientGroup.eq.mp h
  have hcardLocal : Nat.card (root.S ⊓
      Subgroup.centralizer (V : Set X) : Subgroup X) =
      Nat.card {omega : conjugateCosetSpace M // omega ∈ punct} := by
    simpa [punct] using lemma114_card_eq_of_isRegularOn
      (root.S ⊓ Subgroup.centralizer (V : Set X)) punct
      (QuotientGroup.mk t) hbeta
      (by
        intro s omega hω
        refine ⟨smul_mem_fixedPointsOfSubgroup_of_mem_centralizer
          s.property.2 hω.1, ?_⟩
        have hsbase : (s : X) • base = base := by
          apply MulAction.mem_stabilizer_iff.mp
          rw [baseCoset_stabilizer M]
          exact root.S_le_M s.property.1
        intro hsbase'
        apply hω.2
        apply MulAction.injective (s : X)
        change (s : X) • omega = (s : X) • base
        rw [hsbase, hsbase'])
      hreg'
  have hcentEq := lemma114_centralizer_eq_inf_of_eq_mul hVmul
  have hSleCA : root.S ≤ Subgroup.centralizer (Y : Set X) := by
    intro s hs
    exact centralizerTwoPrimeResidual_le_ambientCentralizer Y
      (root.S_le_residual hs)
  have hSCeq : root.S ⊓ Subgroup.centralizer (V : Set X) =
      root.S ⊓ Subgroup.centralizer (P : Set X) := by
    calc
      root.S ⊓ Subgroup.centralizer (V : Set X) =
          root.S ⊓ (Subgroup.centralizer (Y : Set X) ⊓
            Subgroup.centralizer (P : Set X)) := by rw [hcentEq]
      _ = (root.S ⊓ Subgroup.centralizer (Y : Set X)) ⊓
          Subgroup.centralizer (P : Set X) := by rw [inf_assoc]
      _ = root.S ⊓ Subgroup.centralizer (P : Set X) := by
        rw [inf_eq_left.mpr hSleCA]
  rw [← hSCeq]
  exact hcardLocal

/-- Every involution of `C_X(V)` lies in its `2`-residual.  Consequently the
involution core of the full centralizer is exactly the involution core of
`Fhat = O^{2'}(C_X(V))`. -/
public theorem lemma114_FCore_eq_involutionCoreIn_FHat
    {X : Type u} [Group X] [Finite X] (V : Subgroup X) :
    lemma114FCore V = involutionCoreIn (lemma114FHat V) := by
  let C : Subgroup X := Subgroup.centralizer (V : Set X)
  let Fhat : Subgroup X := lemma114FHat V
  have hFleC : Fhat ≤ C := by
    exact centralizerTwoPrimeResidual_le_ambientCentralizer V
  have hleft : involutionCoreIn C ≤ involutionCoreIn Fhat := by
    intro x hx
    change x ∈ involutionCoreIn C at hx
    rw [involutionCoreIn, Subgroup.mem_map] at hx
    rcases hx with ⟨c, hc, rfl⟩
    rw [involutionCore_eq_closure] at hc
    change (c : X) ∈ involutionCoreIn Fhat
    refine Subgroup.closure_induction (G := C)
      (p := fun y _hy =>
        (y : X) ∈ involutionCoreIn Fhat) ?_ ?_ ?_ ?_ hc
    · intro y hy
      have hyInv : IsInvolution (y : X) :=
        IsInvolution.map_of_injective hy C.subtype C.subtype_injective
      have hyCent : (y : X) ∈ Subgroup.centralizer (V : Set X) :=
        y.property
      have hzp : Subgroup.zpowers (y : X) ≤ Fhat := by
        simpa [Fhat, lemma114FHat] using
          zpowers_le_centralizerTwoPrimeResidual_of_isInvolution
            V hyInv hyCent
      have hyF : (y : X) ∈ Fhat :=
        hzp (Subgroup.mem_zpowers (y : X))
      exact involution_mem_involutionCoreIn hyF hyInv
    · exact (involutionCoreIn Fhat).one_mem
    · intro a b _ha _hb ha hb
      exact (involutionCoreIn Fhat).mul_mem ha hb
    · intro a _ha ha
      exact (involutionCoreIn Fhat).inv_mem ha
  have hright : involutionCoreIn Fhat ≤ involutionCoreIn C :=
    involutionCoreIn_mono hFleC
  simpa [lemma114FCore, C, Fhat] using
    (le_antisymm hleft hright)

/-- Two involutions centralizing `V` belong to the Section 11 involution
core. -/
public theorem lemma114_involutions_mem_FCore
    {X : Type u} [Group X]
    {V : Subgroup X} {t u0 : X}
    (ht : IsInvolution t) (hu : IsInvolution u0)
    (hVt : V ≤ Subgroup.centralizer ({t} : Set X))
    (hVu : V ≤ Subgroup.centralizer ({u0} : Set X)) :
    t ∈ lemma114FCore V ∧ u0 ∈ lemma114FCore V := by
  have htC : t ∈ Subgroup.centralizer (V : Set X) := by
    rw [Subgroup.mem_centralizer_iff]
    intro v hv
    exact Subgroup.mem_centralizer_singleton_iff.mp (hVt hv)
  have huC : u0 ∈ Subgroup.centralizer (V : Set X) := by
    rw [Subgroup.mem_centralizer_iff]
    intro v hv
    exact Subgroup.mem_centralizer_singleton_iff.mp (hVu hv)
  exact ⟨involution_mem_involutionCoreIn htC ht,
    involution_mem_involutionCoreIn huC hu⟩

/-! ## The small PSL fixed-field model -/

private instance lemma114PermFinThreeDecidableEq :
    DecidableEq (Equiv.Perm (Fin 3)) :=
  Fintype.decidableEqEquivFintype

private theorem lemma114_permFinThree_involution_product_pow_ne :
    ∀ s t : Equiv.Perm (Fin 3),
      (s ≠ 1 ∧ s ^ 2 = 1) → (t ≠ 1 ∧ t ^ 2 = 1) → s ≠ t →
        (s * t) ^ 3 = 1 ∧ s * t ≠ 1 := by
  decide

private theorem lemma114_permFinThree_involution_product_order
    (s t : Equiv.Perm (Fin 3))
    (hs : IsInvolution s) (ht : IsInvolution t) (hst : s ≠ t) :
    orderOf (s * t) = 3 := by
  apply orderOf_eq_prime_iff.mpr
  exact lemma114_permFinThree_involution_product_pow_ne s t
    (by simpa only [IsInvolution] using hs)
    (by simpa only [IsInvolution] using ht) hst

/-- Distinct involutions in the prime-field model `PSL₂(2)` have product
order three. -/
public theorem lemma114_psl2BinaryOne_involution_product_order
    {s t : PSL2BinaryMatrixGroup 1}
    (hs : IsInvolution s) (ht : IsInvolution t) (hst : s ≠ t) :
    orderOf (s * t) = 3 := by
  let K := BinaryGaloisField 1
  have hKcard : Nat.card K = 2 := by
    simpa [K, BinaryGaloisField] using
      (GaloisField.card 2 1 (by norm_num))
  let e : PSL2BinaryMatrixGroup 1 ≃* Equiv.Perm (Fin 3) :=
    (External.huppert_II_6_14_a_psl2_card_two hKcard).some
  have hes : IsInvolution (e s) :=
    IsInvolution.map_of_injective hs e.toMonoidHom e.injective
  have het : IsInvolution (e t) :=
    IsInvolution.map_of_injective ht e.toMonoidHom e.injective
  have hest : e s ≠ e t := fun h ↦ hst (e.injective h)
  have horder : orderOf (e s * e t) = 3 :=
    lemma114_permFinThree_involution_product_order
      (e s) (e t) hes het hest
  calc
    orderOf (s * t) = orderOf (e (s * t)) :=
      (orderOf_injective e.toMonoidHom e.injective (s * t)).symm
    _ = orderOf (e s * e t) := by rw [map_mul]
    _ = 3 := horder

/-- Every `2`-subgroup of `PSL₂(2^n)` has exponent two.  Embed it in a
Sylow subgroup and use Huppert II.8.2(a), which identifies that Sylow subgroup
with the additive group of the defining characteristic-two field. -/
public theorem lemma114_psl2Binary_twoSubgroup_sq
    (n : ℕ) (hn : n ≠ 0) (S : Subgroup (PSL2BinaryMatrixGroup n))
    (hS : IsPGroup 2 S) (s : S) : s ^ 2 = 1 := by
  let K := BinaryGaloisField n
  have hKcard : Nat.card K = 2 ^ n := by
    simpa [K, BinaryGaloisField] using
      (GaloisField.card 2 n hn)
  obtain ⟨Q, hSQ⟩ := hS.exists_le_sylow
  let e : Multiplicative K ≃* Q :=
    (External.huppert_II_8_2_a_sylow_equiv_additive hKcard Q).some
  let sQ : Q := ⟨s, hSQ s.property⟩
  let a : Multiplicative K := e.symm sQ
  have ha : a ^ 2 = 1 := by
    apply Multiplicative.toAdd.injective
    rw [pow_two]
    change Multiplicative.toAdd a + Multiplicative.toAdd a = 0
    rw [← two_smul K (Multiplicative.toAdd a)]
    simp only [CharTwo.two_eq_zero, zero_smul]
  have hsQ : sQ ^ 2 = 1 := by
    have hea : e a = sQ := e.apply_symm_apply sQ
    calc
      sQ ^ 2 = (e a) ^ 2 := by rw [hea]
      _ = e (a ^ 2) := (map_pow e a 2).symm
      _ = e 1 := by rw [ha]
      _ = 1 := map_one e
  apply Subtype.ext
  exact congrArg (fun z : Q =>
    (z : PSL2BinaryMatrixGroup n)) hsQ

/-- In a PSL model, the retained Proposition 8.4 root subgroup `Q0` is the
whole retained Sylow `2`-subgroup. -/
private theorem lemma114_psl_Q0_eq_rootS
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (n : ℕ) (hn : n ≠ 0)
    (e : centralizerTwoPrimeResidual Y ≃* PSL2BinaryMatrixGroup n) :
    root.Q0 =
      root.S.subgroupOf (Subgroup.normalizer (Y : Set X)) := by
  let F0 : Subgroup X := centralizerTwoPrimeResidual Y
  let S0 : Subgroup F0 := root.S.subgroupOf F0
  have hS0p : IsPGroup 2 S0 := by
    exact root.S_isPGroup.of_equiv
      (Subgroup.subgroupOfEquivOfLe root.S_le_residual).symm
  let Smodel : Subgroup (PSL2BinaryMatrixGroup n) :=
    S0.map e.toMonoidHom
  have hSmodelp : IsPGroup 2 Smodel := hS0p.map e.toMonoidHom
  have hSsq : ∀ s : root.S, s ^ 2 = 1 := by
    intro s
    let s0 : S0 :=
      ⟨⟨(s : X), root.S_le_residual s.property⟩, s.property⟩
    let smodel : Smodel :=
      ⟨e s0, Subgroup.mem_map_of_mem e.toMonoidHom s0.property⟩
    have hsmodel : smodel ^ 2 = 1 :=
      lemma114_psl2Binary_twoSubgroup_sq n hn Smodel hSmodelp smodel
    have hs0 : s0 ^ 2 = 1 := by
      apply Subtype.ext
      apply e.injective
      change e ((s0 : F0) ^ 2) = e 1
      rw [map_pow, map_one]
      exact congrArg Subtype.val hsmodel
    apply Subtype.ext
    exact congrArg (fun z : S0 => ((z : F0) : X)) hs0
  apply le_antisymm root.Q0_le_S
  intro s hsS
  apply (root.Q0_def s).mpr
  by_cases hsOne : s = 1
  · exact Or.inl hsOne
  · right
    refine ⟨root.S_le_normalizer hsS, ⟨hsOne, ?_⟩⟩
    let sS : root.S := ⟨(s : X), hsS⟩
    have hsSq := hSsq sS
    apply Subtype.ext
    exact congrArg (fun z : root.S => (z : X)) hsSq

/-- The retained Sylow `2`-subgroup in the PSL branch has the field order. -/
private theorem lemma114_psl_root_card
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (n : ℕ) (hn : n ≠ 0)
    (e : centralizerTwoPrimeResidual Y ≃* PSL2BinaryMatrixGroup n) :
    Nat.card root.S = 2 ^ Nat.card P := by
  let N : Subgroup X := Subgroup.normalizer (Y : Set X)
  have hSleN : root.S ≤ N := root.S_le_normalizer.trans inf_le_right
  calc
    Nat.card root.S = Nat.card (root.S.subgroupOf N) :=
      (natCard_subgroupOf_eq root.S N hSleN).symm
    _ = Nat.card root.Q0 := by
      rw [← lemma114_psl_Q0_eq_rootS root n hn e]
    _ = 2 ^ Nat.card P := root.Q0_card

/-- Order formula for `PSL₂` over the binary field of degree `n`. -/
public theorem lemma114_psl2Binary_card_formula (n : ℕ) (hn : n ≠ 0) :
    Nat.card (PSL2BinaryMatrixGroup n) =
      2 ^ n * ((2 ^ n) ^ 2 - 1) := by
  let K := BinaryGaloisField n
  have hKcard : Nat.card K = 2 ^ n := by
    simpa [K, BinaryGaloisField] using
      (GaloisField.card 2 n hn)
  have hneg : (-1 : K) = 1 := by
    apply (neg_eq_iff_add_eq_zero).2
    have hone_add_one : (1 : K) + 1 = 0 := by
      rw [show (1 : K) + 1 = 2 by norm_num]
      exact CharP.cast_eq_zero K 2
    exact hone_add_one
  have hcenter :=
    External.huppert614_card_center_of_neg_one_eq_one hneg
  have hpsl := External.huppert614_card_psl_mul_center (K := K)
  rw [hcenter, hKcard] at hpsl
  simpa [K] using hpsl

/-- The PSL model order, expressed in the retained root and odd-factor
cardinalities used by the Borel factorization. -/
private theorem lemma114_psl_expected_borel_card
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hPtwo : 2 ≤ Nat.card P)
    (e : centralizerTwoPrimeResidual Y ≃*
      PSL2BinaryMatrixGroup (Nat.card P)) :
    Nat.card (centralizerTwoPrimeResidual Y) =
      Nat.card root.S * Nat.card root.J * (Nat.card root.S + 1) := by
  let q := 2 ^ Nat.card P
  have hroot : Nat.card root.S = q := by
    simpa [q] using
      lemma114_psl_root_card root (Nat.card P) (by omega) e
  calc
    Nat.card (centralizerTwoPrimeResidual Y) =
        Nat.card (PSL2BinaryMatrixGroup (Nat.card P)) :=
      Nat.card_congr e.toEquiv
    _ = q * (q ^ 2 - 1) := by
      simpa [q] using
        lemma114_psl2Binary_card_formula (Nat.card P) (by omega)
    _ = q * (q - 1) * (q + 1) := by
      rw [Nat.sq_sub_sq q 1]
      ac_rfl
    _ = Nat.card root.S * Nat.card root.J *
        (Nat.card root.S + 1) := by
      rw [hroot, root.J_card]

/-- In the PSL branch of Lemma 11.4, Corollary 8.5's retained root subgroup
is the whole local Sylow `2`-subgroup.  Consequently its `P`-fixed subgroup
has cardinality two. -/
public theorem lemma114_psl_fixedSylow_card
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (n : ℕ) (hn : n ≠ 0)
    (e : centralizerTwoPrimeResidual Y ≃* PSL2BinaryMatrixGroup n) :
    Nat.card
      ((root.S.subgroupOf (Subgroup.normalizer (Y : Set X))) ⊓
        Subgroup.centralizer
          ((P.subgroupOf (Subgroup.normalizer (Y : Set X))) :
            Set (Subgroup.normalizer (Y : Set X))) :
        Subgroup (Subgroup.normalizer (Y : Set X))) = 2 := by
  rw [← lemma114_psl_Q0_eq_rootS root n hn e]
  exact root.fixed_Q0_card

/-- Ambient version of `lemma114_psl_fixedSylow_card`; the local subgroup
calculation is transported across `Subgroup.subgroupOfEquivOfLe`. -/
public theorem lemma114_psl_fixedSylow_card_ambient
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (n : ℕ) (hn : n ≠ 0)
    (e : centralizerTwoPrimeResidual Y ≃* PSL2BinaryMatrixGroup n) :
    Nat.card (root.S ⊓ Subgroup.centralizer (P : Set X) : Subgroup X) = 2 := by
  let N : Subgroup X := Subgroup.normalizer (Y : Set X)
  let C : Subgroup X := root.S ⊓ Subgroup.centralizer (P : Set X)
  let Clocal : Subgroup N := C.subgroupOf N
  let Sfixed : Subgroup N :=
    root.S.subgroupOf N ⊓
      Subgroup.centralizer ((P.subgroupOf N) : Set N)
  have hCleN : C ≤ N := by
    exact inf_le_left.trans (root.S_le_normalizer.trans inf_le_right)
  have hlocalEq : Clocal = Sfixed := by
    ext x
    constructor
    · intro hx
      refine ⟨hx.1, ?_⟩
      change x ∈ Subgroup.centralizer ((P.subgroupOf N) : Set N)
      rw [Subgroup.mem_centralizer_iff]
      intro p hp
      apply Subtype.ext
      exact (Subgroup.mem_centralizer_iff.mp hx.2) (p : X) hp
    · rintro ⟨hxS, hxC⟩
      refine ⟨hxS, ?_⟩
      change (x : X) ∈ Subgroup.centralizer (P : Set X)
      rw [Subgroup.mem_centralizer_iff]
      intro p hpP
      let pN : N := ⟨p, root.P_le_normalizer hpP⟩
      have hpLocal : pN ∈ P.subgroupOf N := hpP
      exact congrArg Subtype.val
        ((Subgroup.mem_centralizer_iff.mp hxC) pN hpLocal)
  have hlocalCard : Nat.card Sfixed = 2 := by
    simpa [N, Sfixed] using
      lemma114_psl_fixedSylow_card root n hn e
  calc
    Nat.card C = Nat.card Clocal :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hCleN).symm.toEquiv
    _ = Nat.card Sfixed :=
      congrArg (fun H : Subgroup N => Nat.card H) hlocalEq
    _ = 2 := hlocalCard

/-! ## The Suzuki fixed Sylow calculation -/

/-- When Proposition 8.4's odd core is trivial, its quotient Borel support is
already a Borel subgroup of the residual itself. -/
private theorem lemma114_borel_of_core_eq_bot
    {X : Type u} [Group X] [Finite X]
    {M Y : Subgroup X}
    (hsupport : Proposition84ModelSupport M Y)
    (hcore : twoPrimeCore (centralizerTwoPrimeResidual Y) = ⊥) :
    IsBorelSubgroup
      (((centralizerTwoPrimeResidual Y ⊓ M).subgroupOf
        (centralizerTwoPrimeResidual Y))) := by
  let F := centralizerTwoPrimeResidual Y
  let Z := twoPrimeCore F
  let B : Subgroup F := ((centralizerTwoPrimeResidual Y ⊓ M).subgroupOf F)
  let q : F →* F ⧸ Z := QuotientGroup.mk' Z
  let qToF : F ⧸ Z ≃* F :=
    (QuotientGroup.quotientMulEquivOfEq (by simpa [F, Z] using hcore)).trans
      QuotientGroup.quotientBot
  have hBbar : IsBorelSubgroup (B.map q) := by
    simpa [F, Z, B, q] using hsupport.quotient_borel
  have hqToF_q (x : F) : qToF (q x) = x := by
    change qToF (QuotientGroup.mk x) = x
    simp [qToF, Z]
    change (QuotientGroup.kerLift (MonoidHom.id F))
      (QuotientGroup.mk x) = x
    rw [QuotientGroup.kerLift_mk]
    rfl
  have hmap : (B.map q).map qToF.toMonoidHom = B := by
    ext x
    constructor
    · rintro ⟨y, ⟨b, hb, rfl⟩, rfl⟩
      change qToF (q b) ∈ B
      rw [hqToF_q]
      exact hb
    · intro hx
      refine ⟨q x, Subgroup.mem_map_of_mem q hx, ?_⟩
      exact hqToF_q x
  change IsBorelSubgroup B
  rw [← hmap]
  exact hBbar.map_mulEquiv qToF

/-- The index of a Borel subgroup in a perfect simple Bender model is one
more than the order of any of its Sylow `2`-subgroups. -/
private theorem lemma114_borel_index_eq_sylow_card_add_one
    {G : Type u} [Group G] [Finite G]
    {B : Subgroup G}
    (hBorel : IsBorelSubgroup B)
    (hmodel : IsSimpleBenderGroup G)
    (hperfect : commutator G = ⊤)
    (P : Sylow 2 B) :
    B.index = Nat.card P + 1 := by
  classical
  have hBne : B ≠ ⊤ := by
    intro hBtop
    letI : Group.IsSolvable B := hBorel.1
    have hsurj : Function.Surjective B.subtype := by
      intro g
      refine ⟨⟨g, ?_⟩, rfl⟩
      rw [hBtop]
      exact Subgroup.mem_top g
    letI : Group.IsSolvable G :=
      Group.isSolvable_of_surjective (f := B.subtype) hsurj
    letI : IsSimpleGroup G := hmodel.isSimple
    exact (Group.IsSolvable.commutator_lt_top_of_nontrivial G).ne hperfect
  obtain ⟨Q, _hQnormal, hQregular⟩ :=
    simpleBender_borel_normalSylow_regular hBorel hmodel
  let QG : Subgroup G := (Q : Subgroup B).map B.subtype
  let base : G ⧸ B := QuotientGroup.mk 1
  let punct : Set (G ⧸ B) := {omega | omega ≠ base}
  obtain ⟨g, hg⟩ : ∃ g : G, g ∉ B := by
    by_contra h
    push Not at h
    exact hBne (top_unique (fun g _hg => h g))
  have halpha : (QuotientGroup.mk g : G ⧸ B) ∈ punct := by
    intro h
    apply hg
    simpa [base] using QuotientGroup.eq.mp h.symm
  have hstable : ∀ s : QG, ∀ omega : G ⧸ B, omega ∈ punct →
      (s : G) • omega ∈ punct := by
    intro s omega homega hsbase
    apply homega
    calc
      omega = (s : G)⁻¹ • ((s : G) • omega) := by simp
      _ = (s : G)⁻¹ • base := by rw [hsbase]
      _ = base := by
        apply MulAction.mem_stabilizer_iff.mp
        rw [baseCoset_stabilizer B]
        apply B.inv_mem
        rcases s.property with ⟨q, _hq, hq⟩
        rw [← hq]
        exact q.property
  have hQGcard : Nat.card QG =
      Nat.card {omega : G ⧸ B // omega ∈ punct} :=
    lemma114_card_eq_of_isRegularOn QG punct (QuotientGroup.mk g)
      halpha hstable (by simpa [QG, punct] using hQregular)
  have hPpunct : Nat.card P =
      Nat.card {omega : G ⧸ B // omega ∈ punct} := by
    calc
      Nat.card P = Nat.card Q :=
        Nat.card_congr (Sylow.equiv P Q).toEquiv
      _ = Nat.card QG := by
        symm
        exact Subgroup.card_map_of_injective B.subtype_injective
      _ = Nat.card {omega : G ⧸ B // omega ∈ punct} := hQGcard
  have hpunct : Nat.card {omega : G ⧸ B // omega ∈ punct} =
      Nat.card (G ⧸ B) - 1 := by
    letI : Fintype (G ⧸ B) := Fintype.ofFinite (G ⧸ B)
    letI : Fintype {omega : G ⧸ B // omega ∈ punct} :=
      Fintype.ofFinite {omega : G ⧸ B // omega ∈ punct}
    simpa [punct, base, Nat.card_eq_fintype_card] using
      (Fintype.card_subtype_compl
        (fun omega : G ⧸ B => omega = base))
  rw [B.index_eq_card]
  have hquotPos : 0 < Nat.card (G ⧸ B) := Nat.card_pos
  omega

private theorem lemma114_natCard_sup_eq_mul_of_disjoint_of_le_normalizer
    {G : Type u} [Group G] (A C : Subgroup G)
    (hnorm : C ≤ Subgroup.normalizer (A : Set G))
    (hdisj : Disjoint A C) :
    Nat.card (A ⊔ C : Subgroup G) = Nat.card A * Nat.card C := by
  let toSup : A × C → ↥(A ⊔ C) := fun z =>
    ⟨(z.1 : G) * (z.2 : G),
      Subgroup.mul_mem_sup z.1.property z.2.property⟩
  have hinj : Function.Injective toSup := by
    intro x y hxy
    apply Subgroup.mul_injective_of_disjoint hdisj
    exact congrArg Subtype.val hxy
  have hsurj : Function.Surjective toSup := by
    intro x
    have hx : (x : G) ∈ (A : Set G) * (C : Set G) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left A C hnorm]
      exact x.property
    rcases hx with ⟨a, ha, c, hc, hac⟩
    exact ⟨(⟨a, ha⟩, ⟨c, hc⟩), Subtype.ext hac⟩
  calc
    Nat.card (A ⊔ C : Subgroup G) = Nat.card (A × C) :=
      Nat.card_congr (Equiv.ofBijective toSup ⟨hinj, hsurj⟩).symm
    _ = Nat.card A * Nat.card C := Nat.card_prod A C

/-- The retained `2`-root and odd Borel factor intersect trivially. -/
private theorem lemma114_root_S_J_disjoint
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hPpos : 0 < Nat.card P) :
    Disjoint root.S root.J := by
  obtain ⟨f, hScard⟩ := root.S_isPGroup.exists_card_eq
  have hJodd : Odd (Nat.card root.J) := by
    rw [root.J_card]
    have hpowEven : Even (2 ^ Nat.card P) :=
      Nat.even_pow.mpr ⟨even_two, hPpos.ne'⟩
    exact Nat.Even.sub_odd Nat.one_le_two_pow hpowEven odd_one
  have hcoprime : Nat.Coprime (Nat.card root.S) (Nat.card root.J) := by
    rw [hScard]
    exact Nat.Coprime.pow_left f hJodd.coprime_two_left
  rw [disjoint_iff]
  exact Subgroup.inf_eq_bot_of_coprime hcoprime

/-- If the ambient model order has the expected Borel factorization, the
retained Corollary 8.5 subgroups `S` and `J` fill the whole Borel. -/
private theorem lemma114_borel_factorization_of_card
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hPpos : 0 < Nat.card P)
    (hBorel : IsBorelSubgroup
      (((centralizerTwoPrimeResidual Y ⊓ M).subgroupOf
        (centralizerTwoPrimeResidual Y))))
    (hmodel : IsSimpleBenderGroup (centralizerTwoPrimeResidual Y))
    (hperfect : commutator (centralizerTwoPrimeResidual Y) = ⊤)
    (hFcard : Nat.card (centralizerTwoPrimeResidual Y) =
      Nat.card root.S * Nat.card root.J * (Nat.card root.S + 1)) :
    ((centralizerTwoPrimeResidual Y ⊓ M : Subgroup X) : Set X) =
      (root.S : Set X) * (root.J : Set X) := by
  classical
  let F : Subgroup X := centralizerTwoPrimeResidual Y
  let H : Subgroup X := F ⊓ M
  let B : Subgroup F := H.subgroupOf F
  obtain ⟨PSyl, hSdef⟩ := root.S_sylow
  let eH : H ≃* B :=
    (Subgroup.subgroupOfEquivOfLe (H := H) (K := F) inf_le_left).symm
  let PB : Sylow 2 B :=
    PSyl.mapSurjective (f := eH.toMonoidHom) eH.surjective
  have hPBcard : Nat.card PB = Nat.card root.S := by
    calc
      Nat.card PB = Nat.card PSyl := by
        rw [show (PB : Subgroup B) =
            (PSyl : Subgroup H).map eH.toMonoidHom by
          exact Sylow.coe_mapSurjective (f := eH.toMonoidHom)
            eH.surjective PSyl]
        exact Subgroup.card_map_of_injective eH.injective
      _ = Nat.card
          ((PSyl : Subgroup H).map H.subtype) := by
        symm
        exact Subgroup.card_map_of_injective H.subtype_injective
      _ = Nat.card root.S := by rw [← hSdef]
  have hindex : B.index = Nat.card root.S + 1 := by
    have h := lemma114_borel_index_eq_sylow_card_add_one
      (B := B) (by simpa [F, H, B] using hBorel)
      (by simpa [F] using hmodel) (by simpa [F] using hperfect) PB
    simpa [hPBcard] using h
  have hJleH : root.J ≤ H := by
    intro j hj
    refine ⟨root.J_le_residual hj, ?_⟩
    have hj' : j ∈ {x : X |
        x ∈ peterfalviKSet (M ⊓ rightConjugate M t) t ∧
          x ∈ Subgroup.normalizer (Y : Set X)} := by
      rw [← root.J_eq_normalizer]
      exact hj
    exact hj'.1.1.1
  have hSleH : root.S ≤ H := fun s hs =>
    ⟨root.S_le_residual hs, root.S_le_M hs⟩
  have hJleNormalizerIn : root.J ≤ normalizerIn M Y := by
    intro j hj
    have hj' : j ∈ {x : X |
        x ∈ peterfalviKSet (M ⊓ rightConjugate M t) t ∧
          x ∈ Subgroup.normalizer (Y : Set X)} := by
      rw [← root.J_eq_normalizer]
      exact hj
    exact ⟨hj'.1.1.1, hj'.2⟩
  have hJnormS : root.J ≤ Subgroup.normalizer (root.S : Set X) := by
    letI : (root.S.subgroupOf (normalizerIn M Y)).Normal := root.S_normal
    exact hJleNormalizerIn.trans
      (Subgroup.le_normalizer_of_normal_subgroupOf root.S_le_normalizer)
  have hdisj : Disjoint root.S root.J :=
    lemma114_root_S_J_disjoint root hPpos
  have hsupCard : Nat.card (root.S ⊔ root.J : Subgroup X) =
      Nat.card root.S * Nat.card root.J :=
    lemma114_natCard_sup_eq_mul_of_disjoint_of_le_normalizer
      root.S root.J hJnormS hdisj
  have hBcard : Nat.card B = Nat.card root.S * Nat.card root.J := by
    apply Nat.mul_right_cancel (by omega : 0 < Nat.card root.S + 1)
    calc
      Nat.card B * (Nat.card root.S + 1) = Nat.card F := by
        rw [← hindex]
        exact B.card_mul_index
      _ = (Nat.card root.S * Nat.card root.J) *
          (Nat.card root.S + 1) := by simpa [F] using hFcard
  have hHcard : Nat.card H = Nat.card B := Nat.card_congr eH.toEquiv
  have hsupEq : root.S ⊔ root.J = H := by
    apply Subgroup.eq_of_le_of_card_ge (sup_le hSleH hJleH)
    rw [hHcard, hBcard, hsupCard]
  calc
    ((centralizerTwoPrimeResidual Y ⊓ M : Subgroup X) : Set X) =
        ((root.S ⊔ root.J : Subgroup X) : Set X) := by
      simpa [F, H] using
        congrArg (fun K : Subgroup X => (K : Set X)) hsupEq.symm
    _ = (root.S : Set X) * (root.J : Set X) :=
      Subgroup.coe_mul_of_right_le_normalizer_left root.S root.J hJnormS

/-- The local field-automorphism subgroup normalizes the retained odd Borel
factor. -/
private theorem lemma114_P_le_normalizer_root_J
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hPlocal : P ≤ peterfalviV (M ⊓ rightConjugate M t) t) :
    P ≤ Subgroup.normalizer (root.J : Set X) := by
  intro p hp
  rw [Subgroup.mem_normalizer_iff]
  intro j
  constructor
  · intro hj
    have hj' : j ∈ {x : X |
        x ∈ peterfalviKSet (M ⊓ rightConjugate M t) t ∧
          x ∈ Subgroup.normalizer (Y : Set X)} := by
      rw [← root.J_eq_normalizer]
      exact hj
    change p * j * p⁻¹ ∈ (root.J : Set X)
    rw [root.J_eq_normalizer]
    exact ⟨peterfalviKSet_conj_mem_of_mem_V (hPlocal hp) hj'.1,
      (Subgroup.normalizer (Y : Set X)).mul_mem
        ((Subgroup.normalizer (Y : Set X)).mul_mem
          (root.P_le_normalizer hp) hj'.2)
        ((Subgroup.normalizer (Y : Set X)).inv_mem
          (root.P_le_normalizer hp))⟩
  · intro hj
    have hj' : p * j * p⁻¹ ∈ {x : X |
        x ∈ peterfalviKSet (M ⊓ rightConjugate M t) t ∧
          x ∈ Subgroup.normalizer (Y : Set X)} := by
      rw [← root.J_eq_normalizer]
      exact hj
    change j ∈ (root.J : Set X)
    rw [root.J_eq_normalizer]
    have hpInvLocal : p⁻¹ ∈ peterfalviV
        (M ⊓ rightConjugate M t) t :=
      (peterfalviV (M ⊓ rightConjugate M t) t).inv_mem (hPlocal hp)
    constructor
    · have hconj :=
        peterfalviKSet_conj_mem_of_mem_V hpInvLocal hj'.1
      simpa [mul_assoc] using hconj
    · have hnorm :=
        (Subgroup.normalizer (Y : Set X)).mul_mem
          ((Subgroup.normalizer (Y : Set X)).mul_mem
            ((Subgroup.normalizer (Y : Set X)).inv_mem
              (root.P_le_normalizer hp)) hj'.2)
          (root.P_le_normalizer hp)
      simpa [mul_assoc] using hnorm

/-- Once the retained Borel factors fill `F₀ ∩ M`, the base stabilizer in
`F̂ = O^{2'}(C_X(V))` is precisely the `P`-fixed part of the retained root. -/
private theorem lemma114_FHat_inf_M_eq_root_fixed
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P V : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hPtwo : 2 ≤ Nat.card P)
    (hYV : Y ≤ V) (hPV : P ≤ V)
    (hPlocal : P ≤ peterfalviV (M ⊓ rightConjugate M t) t)
    (hPnormS : P ≤ Subgroup.normalizer (root.S : Set X))
    (hVmul : (V : Set X) = (Y : Set X) * (P : Set X))
    (hfactor :
      ((centralizerTwoPrimeResidual Y ⊓ M : Subgroup X) : Set X) =
        (root.S : Set X) * (root.J : Set X))
    (hfixed : PeterfalviCentralizersTrivial
      (M ⊓ rightConjugate M t) t P) :
    lemma114FHat V ⊓ M =
      root.S ⊓ Subgroup.centralizer (P : Set X) := by
  classical
  have hFhatLeF0 : lemma114FHat V ≤ centralizerTwoPrimeResidual Y := by
    simpa [lemma114FHat] using centralizerTwoPrimeResidual_mono hYV
  have hPnormJ : P ≤ Subgroup.normalizer (root.J : Set X) :=
    lemma114_P_le_normalizer_root_J root hPlocal
  have hdisj : Disjoint root.S root.J :=
    lemma114_root_S_J_disjoint root (by omega)
  have hSleCY : root.S ≤ Subgroup.centralizer (Y : Set X) :=
    root.S_le_residual.trans
      (centralizerTwoPrimeResidual_le_ambientCentralizer Y)
  have hcentV := lemma114_centralizer_eq_inf_of_eq_mul hVmul
  ext x
  constructor
  · intro hx
    have hxF0M : x ∈ centralizerTwoPrimeResidual Y ⊓ M :=
      ⟨hFhatLeF0 hx.1, hx.2⟩
    have hxProduct : x ∈ (root.S : Set X) * (root.J : Set X) := by
      rw [← hfactor]
      exact hxF0M
    rcases Set.mem_mul.mp hxProduct with ⟨s, hs, j, hj, hsj⟩
    have hxCV : x ∈ Subgroup.centralizer (V : Set X) :=
      centralizerTwoPrimeResidual_le_ambientCentralizer V hx.1
    have hxCP : x ∈ Subgroup.centralizer (P : Set X) := by
      rw [Subgroup.mem_centralizer_iff]
      intro p hp
      exact (Subgroup.mem_centralizer_iff.mp hxCV) p (hPV hp)
    have hparts : ∀ p : X, p ∈ P →
        p * s * p⁻¹ = s ∧ p * j * p⁻¹ = j := by
      intro p hp
      have hsp : p * s * p⁻¹ ∈ root.S :=
        (Subgroup.mem_normalizer_iff.mp (hPnormS hp) s).mp hs
      have hjp : p * j * p⁻¹ ∈ root.J :=
        (Subgroup.mem_normalizer_iff.mp (hPnormJ hp) j).mp hj
      have hpx : p * x * p⁻¹ = x := by
        have hcomm := (Subgroup.mem_centralizer_iff.mp hxCP) p hp
        rw [hcomm]
        simp
      have heq : (p * s * p⁻¹) * (p * j * p⁻¹) = s * j := by
        calc
          (p * s * p⁻¹) * (p * j * p⁻¹) =
              p * (s * j) * p⁻¹ := by group
          _ = p * x * p⁻¹ := by rw [hsj]
          _ = x := hpx
          _ = s * j := hsj.symm
      have hpair :
          ((⟨p * s * p⁻¹, hsp⟩ : root.S),
              (⟨p * j * p⁻¹, hjp⟩ : root.J)) =
            ((⟨s, hs⟩ : root.S), (⟨j, hj⟩ : root.J)) :=
        Subgroup.mul_injective_of_disjoint hdisj heq
      exact ⟨congrArg (fun z => (z.1 : X)) hpair,
        congrArg (fun z => (z.2 : X)) hpair⟩
    have hPne : P ≠ ⊥ := by
      intro hPbot
      have hcard : Nat.card P = 1 := by simpa [hPbot]
      omega
    obtain ⟨p, hpne⟩ :=
      Subgroup.ne_bot_iff_exists_ne_one.mp hPne
    have hjI : j ∈ peterfalviKSet
        (M ⊓ rightConjugate M t) t := by
      have hj' : j ∈ {x : X |
          x ∈ peterfalviKSet (M ⊓ rightConjugate M t) t ∧
            x ∈ Subgroup.normalizer (Y : Set X)} := by
        rw [← root.J_eq_normalizer]
        exact hj
      exact hj'.1
    have hjcomm : j * (p : X) = (p : X) * j := by
      have hjconj := (hparts (p : X) p.property).2
      calc
        j * (p : X) = ((p : X) * j * (p : X)⁻¹) * (p : X) := by
          rw [hjconj]
        _ = (p : X) * j := by group
    have hjone : j = 1 :=
      hfixed (p : X) p.property (by simpa using hpne) j hjI hjcomm
    refine ⟨?_, hxCP⟩
    rw [← hsj, hjone, mul_one]
    exact hs
  · rintro ⟨hxS, hxCP⟩
    refine ⟨?_, root.S_le_M hxS⟩
    apply inf_centralizer_le_centralizerTwoPrimeResidual root.S_isPGroup
    refine ⟨hxS, ?_⟩
    rw [hcentV]
    exact ⟨hSleCY hxS, hxCP⟩

/-- Order formula for a positive-parameter Suzuki matrix group. -/
public theorem lemma114_suzukiMatrixGroup_card_formula
    (m : ℕ) (hm : 0 < m) :
    Nat.card (SuzukiMatrixGroup m) =
      ((2 ^ (2 * m + 1)) ^ 2 + 1) *
        (2 ^ (2 * m + 1)) ^ 2 *
          (2 ^ (2 * m + 1) - 1) := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) := by
    intro x
    exact iterateFrobeniusEquiv_def K 2 (m + 1) x
  rcases External.huppert_blackburn_XI_3_3 m hm pi hpi with
    ⟨_, _, _, _, _, _, hcard, _⟩
  exact hcard

/-- Every Sylow `2`-subgroup of a positive-parameter Suzuki group has order
the square of the field order. -/
private theorem lemma114_suzuki_sylow_card
    (m : ℕ) (hm : 0 < m) (S : Sylow 2 (SuzukiMatrixGroup m)) :
    Nat.card S = (2 ^ (2 * m + 1)) ^ 2 := by
  let q := 2 ^ (2 * m + 1)
  have hGcard : Nat.card (SuzukiMatrixGroup m) =
      (q ^ 2 + 1) * q ^ 2 * (q - 1) := by
    simpa [q] using lemma114_suzukiMatrixGroup_card_formula m hm
  have hqPos : 0 < q := by
    dsimp [q]
    positivity
  have hqEven : Even q := by
    dsimp [q]
    exact Nat.even_pow.mpr ⟨even_two, by omega⟩
  have hqSqEven : Even (q ^ 2) :=
    hqEven.pow_of_ne_zero (by norm_num)
  have houterOdd : Odd ((q ^ 2 + 1) * (q - 1)) :=
    hqSqEven.add_one.mul (Nat.Even.sub_odd hqPos hqEven odd_one)
  obtain ⟨f, hScard⟩ := S.isPGroup'.exists_card_eq
  have hScoprime : Nat.Coprime (Nat.card S)
      ((q ^ 2 + 1) * (q - 1)) := by
    rw [hScard]
    exact Nat.Coprime.pow_left f houterOdd.coprime_two_left
  have hSdvdProduct : Nat.card S ∣
      q ^ 2 * ((q ^ 2 + 1) * (q - 1)) := by
    have hdiv := Subgroup.card_subgroup_dvd_card
      (S : Subgroup (SuzukiMatrixGroup m))
    rw [hGcard] at hdiv
    simpa [mul_assoc, mul_left_comm, mul_comm] using hdiv
  have hSdvdQ : Nat.card S ∣ q ^ 2 :=
    hScoprime.dvd_of_dvd_mul_right hSdvdProduct
  have hqSqPow : q ^ 2 = 2 ^ (2 * (2 * m + 1)) := by
    dsimp [q]
    rw [← pow_mul]
    congr 1
    omega
  have hqDvdG : q ^ 2 ∣ Nat.card (SuzukiMatrixGroup m) := by
    rw [hGcard]
    refine ⟨(q ^ 2 + 1) * (q - 1), ?_⟩
    ring
  have hpowDvdG : 2 ^ (2 * (2 * m + 1)) ∣
      Nat.card (SuzukiMatrixGroup m) := by
    rwa [← hqSqPow]
  have hpowDvdS := S.pow_dvd_card_of_pow_dvd_card hpowDvdG
  have hqDvdS : q ^ 2 ∣ Nat.card S := by
    rw [hqSqPow]
    exact hpowDvdS
  simpa [q] using Nat.dvd_antisymm hSdvdQ hqDvdS

/-- A Sylow `2`-subgroup of any Suzuki Borel has the same order as a Sylow
`2`-subgroup of the ambient Suzuki group. -/
private theorem lemma114_suzuki_borel_sylow_card
    (m : ℕ) (hm : 0 < m)
    {B : Subgroup (SuzukiMatrixGroup m)} (hB : IsBorelSubgroup B)
    (S : Sylow 2 B) :
    Nat.card S = (2 ^ (2 * m + 1)) ^ 2 := by
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rcases hB with ⟨_hsolvable, Q, hBQ⟩
  have hQleB : (Q : Subgroup (SuzukiMatrixGroup m)) ≤ B := by
    rw [hBQ]
    exact Subgroup.le_normalizer
  letI : Nonempty
      ((Q : Subgroup (SuzukiMatrixGroup m)).subgroupOf B) := ⟨1⟩
  let QB : Sylow 2 B := Q.subtype hQleB
  calc
    Nat.card S = Nat.card QB := Nat.card_congr (Sylow.equiv S QB).toEquiv
    _ = Nat.card Q := by
      simpa [QB] using
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQleB).toEquiv
    _ = (2 ^ (2 * m + 1)) ^ 2 := lemma114_suzuki_sylow_card m hm Q

/-- In the Suzuki branch, Corollary 8.5's retained root subgroup has the
standard Suzuki Sylow-`2` cardinality. -/
private theorem lemma114_suzuki_root_card
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hsupport : Proposition84ModelSupport M Y)
    (hcore : twoPrimeCore (centralizerTwoPrimeResidual Y) = ⊥)
    (m : ℕ) (hm : 0 < m)
    (e : centralizerTwoPrimeResidual Y ≃* SuzukiMatrixGroup m) :
    Nat.card root.S = (2 ^ (2 * m + 1)) ^ 2 := by
  let F := centralizerTwoPrimeResidual Y
  let B0 : Subgroup X := F ⊓ M
  let B : Subgroup F := B0.subgroupOf F
  have hBorel : IsBorelSubgroup B := by
    simpa [F, B0, B] using lemma114_borel_of_core_eq_bot hsupport hcore
  let Bmodel : Subgroup (SuzukiMatrixGroup m) := B.map e.toMonoidHom
  have hBmodel : IsBorelSubgroup Bmodel := by
    simpa [Bmodel] using hBorel.map_mulEquiv e
  obtain ⟨PSyl, hSdef⟩ := root.S_sylow
  let eB0 : B0 ≃* B :=
    (Subgroup.subgroupOfEquivOfLe (H := B0) (K := F) inf_le_left).symm
  let eB : B0 ≃* Bmodel := eB0.trans
    (Subgroup.equivMapOfInjective B e.toMonoidHom e.injective)
  let Pmodel : Sylow 2 Bmodel :=
    PSyl.mapSurjective (f := eB.toMonoidHom) eB.surjective
  have hPmodelCard : Nat.card Pmodel = (2 ^ (2 * m + 1)) ^ 2 :=
    lemma114_suzuki_borel_sylow_card m hm hBmodel Pmodel
  calc
    Nat.card root.S = Nat.card
        ((PSyl : Subgroup B0).map B0.subtype) := by rw [hSdef]
    _ = Nat.card PSyl :=
      Subgroup.card_map_of_injective B0.subtype_injective
    _ = Nat.card Pmodel := by
      symm
      rw [show (Pmodel : Subgroup Bmodel) =
          (PSyl : Subgroup B0).map eB.toMonoidHom by
        exact Sylow.coe_mapSurjective (f := eB.toMonoidHom)
          eB.surjective PSyl]
      exact Subgroup.card_map_of_injective eB.injective
    _ = (2 ^ (2 * m + 1)) ^ 2 := hPmodelCard

/-- The positive Suzuki model order, expressed in the retained root and
odd-factor cardinalities used by the Borel factorization. -/
private theorem lemma114_suzuki_expected_borel_card
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hsupport : Proposition84ModelSupport M Y)
    (hcore : twoPrimeCore (centralizerTwoPrimeResidual Y) = ⊥)
    (m : ℕ) (hm : 0 < m)
    (e : centralizerTwoPrimeResidual Y ≃* SuzukiMatrixGroup m)
    (hPcard : Nat.card P = 2 * m + 1) :
    Nat.card (centralizerTwoPrimeResidual Y) =
      Nat.card root.S * Nat.card root.J * (Nat.card root.S + 1) := by
  let q := 2 ^ (2 * m + 1)
  have hroot : Nat.card root.S = q ^ 2 := by
    simpa [q] using
      lemma114_suzuki_root_card root hsupport hcore m hm e
  have hJcard : Nat.card root.J = q - 1 := by
    rw [root.J_card, hPcard]
  calc
    Nat.card (centralizerTwoPrimeResidual Y) =
        Nat.card (SuzukiMatrixGroup m) := Nat.card_congr e.toEquiv
    _ = (q ^ 2 + 1) * q ^ 2 * (q - 1) := by
      simpa [q] using lemma114_suzukiMatrixGroup_card_formula m hm
    _ = q ^ 2 * (q - 1) * (q ^ 2 + 1) := by ac_rfl
    _ = Nat.card root.S * Nat.card root.J *
        (Nat.card root.S + 1) := by rw [hroot, hJcard]

/-- The explicit root subgroup in a positive-parameter Suzuki group is a
Sylow `2`-subgroup of exponent four. -/
private theorem lemma114_suzuki_exists_sylow_pow_four
    (m : ℕ) (hm : 0 < m) :
    ∃ S : Sylow 2 (SuzukiMatrixGroup m), ∀ x : S, x ^ 4 = 1 := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) := by
    intro x
    exact iterateFrobeniusEquiv_def K 2 (m + 1) x
  have hpiSq : ∀ x : K, pi (pi x) = x ^ 2 :=
    External.binaryGaloisField_tits_formula_sq m pi hpi
  let Froot : Subgroup (GL (Fin 4) K) :=
    Subgroup.closure {A | ∃ a b : K, A = SuzukiRootGL m a b}
  rcases External.huppert_blackburn_XI_3_1 m hm pi hpiSq with
    ⟨_, _, hFp, hFpow, _, _, hFcard, _, _, _, _, _, _, _, _⟩
  have hFrootLe : Froot ≤ SuzukiMatrixGroup m := by
    dsimp [Froot, SuzukiMatrixGroup, SuzukiMatrixSubgroup]
    apply Subgroup.closure_mono
    intro A hA
    exact Or.inl hA
  let FS : Subgroup (SuzukiMatrixGroup m) :=
    Froot.comap (SuzukiMatrixGroup m).subtype
  have hFSmap : FS.map (SuzukiMatrixGroup m).subtype = Froot := by
    apply le_antisymm
    · rintro x ⟨y, hy, rfl⟩
      exact hy
    · intro x hx
      exact ⟨⟨x, hFrootLe hx⟩, hx, rfl⟩
  let eFS : FS ≃* Froot :=
    (Subgroup.equivMapOfInjective FS
      (SuzukiMatrixGroup m).subtype
      (SuzukiMatrixGroup m).subtype_injective).trans
        (MulEquiv.subgroupCongr hFSmap)
  have hFSp : IsPGroup 2 FS := hFp.of_equiv eFS.symm
  obtain ⟨S, hFSleS⟩ := hFSp.exists_le_sylow
  have hFScard : Nat.card FS = (2 ^ (2 * m + 1)) ^ 2 := by
    calc
      Nat.card FS = Nat.card Froot := Nat.card_congr eFS.toEquiv
      _ = (2 ^ (2 * m + 1)) ^ 2 := by
        simpa [Froot, K] using hFcard
  have hScard : Nat.card S = (2 ^ (2 * m + 1)) ^ 2 :=
    lemma114_suzuki_sylow_card m hm S
  have hFSeq : FS = (S : Subgroup (SuzukiMatrixGroup m)) := by
    apply Subgroup.eq_of_le_of_card_ge hFSleS
    rw [hFScard, hScard]
  refine ⟨S, ?_⟩
  intro x
  let xFS : FS := ⟨(x : SuzukiMatrixGroup m), by
    rw [hFSeq]
    exact x.property⟩
  have hxF : eFS xFS ^ 4 = 1 := hFpow (eFS xFS)
  have hxFS : xFS ^ 4 = 1 := by
    apply eFS.injective
    simpa using hxF
  apply Subtype.ext
  exact congrArg (fun z : FS => (z : SuzukiMatrixGroup m)) hxFS

/-- Every `2`-subgroup of a positive-parameter Suzuki group has exponent at
most four. -/
private theorem lemma114_suzuki_twoSubgroup_pow_four
    (m : ℕ) (hm : 0 < m)
    (R : Subgroup (SuzukiMatrixGroup m)) (hR : IsPGroup 2 R)
    (x : R) : x ^ 4 = 1 := by
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨S, hRS⟩ := hR.exists_le_sylow
  obtain ⟨S0, hS0pow⟩ := lemma114_suzuki_exists_sylow_pow_four m hm
  let e : S ≃* S0 := Sylow.equiv S S0
  let xS : S := ⟨(x : SuzukiMatrixGroup m), hRS x.property⟩
  have hx0 : e xS ^ 4 = 1 := hS0pow (e xS)
  have hxS : xS ^ 4 = 1 := by
    apply e.injective
    simpa using hx0
  apply Subtype.ext
  exact congrArg (fun z : S => (z : SuzukiMatrixGroup m)) hxS

/-- Corollary 8.5's retained root subgroup has exponent four in the Suzuki
branch. -/
private theorem lemma114_suzuki_root_pow_four
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (m : ℕ) (hm : 0 < m)
    (e : centralizerTwoPrimeResidual Y ≃* SuzukiMatrixGroup m)
    (s : root.S) : s ^ 4 = 1 := by
  let F := centralizerTwoPrimeResidual Y
  let S0 : Subgroup F := root.S.subgroupOf F
  have hS0p : IsPGroup 2 S0 := by
    exact root.S_isPGroup.of_equiv
      (Subgroup.subgroupOfEquivOfLe root.S_le_residual).symm
  let Smodel : Subgroup (SuzukiMatrixGroup m) := S0.map e.toMonoidHom
  have hSmodelp : IsPGroup 2 Smodel := hS0p.map e.toMonoidHom
  let s0 : S0 :=
    ⟨⟨(s : X), root.S_le_residual s.property⟩, s.property⟩
  let smodel : Smodel :=
    ⟨e s0, Subgroup.mem_map_of_mem e.toMonoidHom s0.property⟩
  have hsmodel : smodel ^ 4 = 1 :=
    lemma114_suzuki_twoSubgroup_pow_four m hm Smodel hSmodelp smodel
  have hs0 : s0 ^ 4 = 1 := by
    apply Subtype.ext
    apply e.injective
    change e ((s0 : F) ^ 4) = e 1
    rw [map_pow, map_one]
    exact congrArg Subtype.val hsmodel
  apply Subtype.ext
  exact congrArg (fun z : S0 => ((z : F) : X)) hs0

/-- A nontrivial rank-one finite `2`-group of exponent four has order at most
eight. -/
private theorem lemma114_twoGroup_card_le_eight_of_not_twoRank_pow_four
    {G : Type u} [Group G] [Finite G] [Nontrivial G]
    (hGp : IsPGroup 2 G) (h2rank : ¬ TwoRankAtLeastTwo G)
    (hpow : ∀ x : G, x ^ 4 = 1) :
    Nat.card G ≤ 8 := by
  obtain ⟨U, hUcard, hUunique⟩ :=
    PFAppendixII.unique_order_two_subgroup_of_not_twoRank hGp h2rank
  have hclass :=
    (External.huppert_III_8_2_pgroup_unique_order_prime_subgroup
      Nat.prime_two hGp ⟨U, hUcard, hUunique⟩).2 rfl
  rcases hclass with hcyclic | ⟨n, hn, ⟨e⟩⟩
  · obtain ⟨g, hg⟩ := (isCyclic_iff_exists_zpowers_eq_top).mp hcyclic
    have hcard : Nat.card G = orderOf g := by
      calc
        Nat.card G = Nat.card (Subgroup.zpowers g) := by
          rw [hg, Subgroup.card_top]
        _ = orderOf g := Nat.card_zpowers g
    have hdvd : orderOf g ∣ 4 := orderOf_dvd_of_pow_eq_one (hpow g)
    rw [hcard]
    exact (Nat.le_of_dvd (by norm_num) hdvd).trans (by norm_num)
  · let k := 2 ^ (n - 2)
    letI : NeZero k := ⟨pow_ne_zero _ (by norm_num)⟩
    letI : Fact (1 < 2 * k) := ⟨by
      have hk : 0 < k := Nat.pos_of_ne_zero (NeZero.ne k)
      omega⟩
    let a : QuaternionGroup k :=
      QuaternionGroup.a (1 : ZMod (2 * k))
    have haOrder : orderOf a = 2 * k := by
      rw [QuaternionGroup.orderOf_a, ZMod.val_one,
        Nat.gcd_one_right, Nat.div_one]
    let x : G := e.symm a
    have hxOrder : orderOf x = 2 * k := by
      calc
        orderOf x = orderOf (e x) :=
          (orderOf_injective e.toMonoidHom e.injective x).symm
        _ = orderOf a := by simp [x]
        _ = 2 * k := haOrder
    have hkBound : 2 * k ≤ 4 := by
      rw [← hxOrder]
      exact Nat.le_of_dvd (by norm_num)
        (orderOf_dvd_of_pow_eq_one (hpow x))
    have hcard : Nat.card G = 4 * k := by
      calc
        Nat.card G = Nat.card (QuaternionGroup k) := Nat.card_congr e.toEquiv
        _ = 4 * k := by
          rw [Nat.card_eq_fintype_card, QuaternionGroup.card]
    rw [hcard]
    omega

/-- In the positive Suzuki branch, the subgroup of Corollary 8.5's root Sylow
fixed by `P` has order four. -/
public theorem lemma114_suzuki_fixedSylow_card_ambient
    {X : Type u} [Group X] [Finite X]
    {M : Subgroup X} {t u0 : X} {Y P : Subgroup X}
    (root : Corollary85FixedRootData M t u0 Y P)
    (hsupport : Proposition84ModelSupport M Y)
    (hcore : twoPrimeCore (centralizerTwoPrimeResidual Y) = ⊥)
    (m : ℕ) (hm : 0 < m)
    (e : centralizerTwoPrimeResidual Y ≃* SuzukiMatrixGroup m)
    (hPcard : Nat.card P = 2 * m + 1)
    (hPprime : Nat.Prime (Nat.card P))
    (hPnormS : P ≤ Subgroup.normalizer (root.S : Set X))
    (hcentralizerRank :
      ¬ TwoRankAtLeastTwo (Subgroup.centralizer (P : Set X))) :
    Nat.card (root.S ⊓ Subgroup.centralizer (P : Set X) : Subgroup X) = 4 := by
  classical
  let C : Subgroup X := root.S ⊓ Subgroup.centralizer (P : Set X)
  have hCleS : C ≤ root.S := inf_le_left
  have hCleCP : C ≤ Subgroup.centralizer (P : Set X) := inf_le_right
  have hCp : IsPGroup 2 C := by
    exact (root.S_isPGroup.to_subgroup (C.subgroupOf root.S)).of_equiv
      (Subgroup.subgroupOfEquivOfLe hCleS)
  let N : Subgroup X := Subgroup.normalizer (Y : Set X)
  let Qfixed : Subgroup N :=
    root.Q0 ⊓ Subgroup.centralizer ((P.subgroupOf N) : Set N)
  have hQfixedCard : Nat.card Qfixed = 2 := by
    simpa [N, Qfixed] using root.fixed_Q0_card
  letI : Nontrivial Qfixed :=
    Finite.one_lt_card_iff_nontrivial.mp (by rw [hQfixedCard]; norm_num)
  obtain ⟨q, hq⟩ := exists_ne (1 : Qfixed)
  have hqS : (q : X) ∈ root.S := root.Q0_le_S q.property.1
  have hqC : (q : X) ∈ Subgroup.centralizer (P : Set X) := by
    rw [Subgroup.mem_centralizer_iff]
    intro p hpP
    let pN : N := ⟨p, root.P_le_normalizer hpP⟩
    have hpLocal : pN ∈ P.subgroupOf N := hpP
    exact congrArg Subtype.val
      ((Subgroup.mem_centralizer_iff.mp q.property.2) pN hpLocal)
  let qC : C := ⟨q, hqS, hqC⟩
  have hqCne : qC ≠ 1 := by
    intro hqCOne
    have hqX : (q : X) = 1 := congrArg Subtype.val hqCOne
    apply hq
    apply Subtype.ext
    apply Subtype.ext
    exact hqX
  letI : Nontrivial C := ⟨⟨qC, 1, hqCne⟩⟩
  have hCrank : ¬ TwoRankAtLeastTwo C := by
    intro hCtwoRank
    exact hcentralizerRank
      (hCtwoRank.map_of_injective (Subgroup.inclusion hCleCP)
        (Subgroup.inclusion_injective hCleCP))
  have hCpow : ∀ x : C, x ^ 4 = 1 := by
    intro x
    let xS : root.S := ⟨x, x.property.1⟩
    have hxS := lemma114_suzuki_root_pow_four root m hm e xS
    apply Subtype.ext
    exact congrArg (fun z : root.S => (z : X)) hxS
  have hCcardLe : Nat.card C ≤ 8 :=
    lemma114_twoGroup_card_le_eight_of_not_twoRank_pow_four hCp hCrank hCpow
  letI : Fact (Nat.Prime (Nat.card P)) := ⟨hPprime⟩
  letI : Subgroup.Normalizes P root.S := ⟨hPnormS⟩
  have hPgroup : IsPGroup (Nat.card P) P := by
    apply IsPGroup.of_card (n := 1)
    simp
  have hfix :
      fixedPointSubgroup (↥P) (↥root.S) =
        (subgroupCentralizerIn root.S P).subgroupOf root.S := by
    simpa using
      fixedPointSubgroup_subgroup_conj_eq_subgroupCentralizerIn
        root.S P hPnormS
  have hfixCard :
      Nat.card (MulAction.fixedPoints (↥P) (↥root.S)) = Nat.card C := by
    calc
      Nat.card (MulAction.fixedPoints (↥P) (↥root.S)) =
          Nat.card (fixedPointSubgroup (↥P) (↥root.S)) := rfl
      _ = Nat.card ((subgroupCentralizerIn root.S P).subgroupOf root.S) := by
        rw [hfix]
      _ = Nat.card (subgroupCentralizerIn root.S P) :=
        natCard_subgroupOf_eq (subgroupCentralizerIn root.S P) root.S inf_le_left
      _ = Nat.card C := by rfl
  have hmod : Nat.card root.S ≡ Nat.card C [MOD Nat.card P] := by
    rw [← hfixCard]
    exact hPgroup.card_modEq_card_fixedPoints (↥root.S)
  have hrootCard : Nat.card root.S = (2 ^ Nat.card P) ^ 2 := by
    simpa [hPcard] using
      lemma114_suzuki_root_card root hsupport hcore m hm e
  have hfermat : 2 ^ Nat.card P ≡ 2 [MOD Nat.card P] := by
    have htwoLe : 2 ≤ 2 ^ Nat.card P := Nat.one_lt_two_pow hPprime.ne_zero
    symm
    apply (Nat.modEq_iff_dvd' htwoLe).2
    have hfermatZ := Int.prime_dvd_pow_self_sub hPprime 2
    have hcast : ((2 ^ Nat.card P - 2 : ℕ) : ℤ) =
        (2 : ℤ) ^ Nat.card P - 2 := by
      rw [Nat.cast_sub htwoLe, Nat.cast_pow, Nat.cast_ofNat]
    have hfermatCast : (Nat.card P : ℤ) ∣
        ((2 ^ Nat.card P - 2 : ℕ) : ℤ) := by
      rwa [hcast]
    exact_mod_cast hfermatCast
  have hrootModFour : Nat.card root.S ≡ 4 [MOD Nat.card P] := by
    rw [hrootCard]
    simpa using hfermat.pow 2
  have hCModFour : Nat.card C ≡ 4 [MOD Nat.card P] :=
    hmod.symm.trans hrootModFour
  obtain ⟨f, hCcard⟩ := hCp.exists_card_eq
  have hfpos : 0 < f := by
    by_contra hf
    have hfzero : f = 0 := by omega
    rw [hfzero, pow_zero] at hCcard
    exact (Finite.one_lt_card_iff_nontrivial.mpr
      (inferInstance : Nontrivial C)).ne' hCcard
  have hfle : f ≤ 3 := by
    apply (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp
    simpa [hCcard] using hCcardLe
  interval_cases f <;> norm_num at hCcard
  · exfalso
    rw [hCcard] at hCModFour
    have hdvd : Nat.card P ∣ 2 :=
      (Nat.modEq_iff_dvd' (by norm_num : 2 ≤ 4)).mp hCModFour
    have hPle : Nat.card P ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
    rw [hPcard] at hPle
    omega
  · exact hCcard
  · exfalso
    rw [hCcard] at hCModFour
    have hdvd : Nat.card P ∣ 4 :=
      (Nat.modEq_iff_dvd' (by norm_num : 4 ≤ 8)).mp hCModFour.symm
    have hPle : Nat.card P ≤ 4 := Nat.le_of_dvd (by norm_num) hdvd
    have hpOdd : Odd (Nat.card P) := by
      rw [hPcard]
      exact (even_two.mul_right m).add_one
    rcases hpOdd with ⟨r, hr⟩
    have hpEqThree : Nat.card P = 3 := by
      have hpOneLt := hPprime.one_lt
      omega
    rw [hpEqThree] at hdvd
    norm_num at hdvd

/-! ## The five-point fixed-field recognition -/

/-- The ambient symmetric group on five points has six Sylow `5`-subgroups.
The alternative value `1` is excluded by simplicity of `A₅`. -/
private theorem lemma114_perm5_sylow_count :
    Nat.card (Sylow 5 (Equiv.Perm (Fin 5))) = 6 := by
  let G := Equiv.Perm (Fin 5)
  letI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let P : Sylow 5 G := default
  have hGcard : Nat.card G = 120 := by
    change Nat.card (Equiv.Perm (Fin 5)) = 120
    rw [Nat.card_perm, Nat.card_fin]
    norm_num [Nat.factorial]
  have hPcard : Nat.card P = 5 := by
    rw [Sylow.card_eq_multiplicity, hGcard]
    rw [Nat.factorization_def _ Nat.prime_five]
    rw [show 120 = 24 * 5 by norm_num,
      padicValNat.mul (by norm_num) (by norm_num),
      padicValNat.eq_zero_of_not_dvd (by norm_num), padicValNat.self] <;>
      norm_num
  have hPindex : P.index = 24 := by
    apply Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 5)
    calc
      5 * P.index = Nat.card P * P.index := by rw [hPcard]
      _ = Nat.card G := P.card_mul_index
      _ = 120 := hGcard
      _ = 5 * 24 := by norm_num
  let n := Nat.card (Sylow 5 G)
  have hdiv : n ∣ 24 := by
    simpa [n, hPindex] using P.card_dvd_index
  have hnpos : 0 < n := by
    simpa [n] using Nat.card_pos (α := Sylow 5 G)
  have hnle : n ≤ 24 := Nat.le_of_dvd (by norm_num) hdiv
  have hmod : n ≡ 1 [MOD 5] := by
    simpa [n] using card_sylow_modEq_one 5 G
  have hn : n = 1 ∨ n = 6 := by
    interval_cases n <;> simp_all [Nat.ModEq]
  rcases hn with hn | hn
  · exfalso
    haveI : Subsingleton (Sylow 5 G) :=
      (Nat.card_eq_one_iff_unique.mp (by simpa [n] using hn)).1
    have hPnormal : (P : Subgroup G).Normal :=
      Sylow.normal_of_subsingleton P
    have hPleAlt : (P : Subgroup G) ≤ alternatingGroup (Fin 5) := by
      intro x hx
      rw [Equiv.Perm.mem_alternatingGroup]
      let xp : P := ⟨x, hx⟩
      have hxpow : x ^ 5 = 1 := by
        have hxp := pow_card_eq_one' (x := xp)
        have hxp' := congrArg Subtype.val hxp
        change x ^ Nat.card P = 1 at hxp'
        simpa only [hPcard] using hxp'
      have hsignpow : Equiv.Perm.sign x ^ 5 = 1 := by
        rw [← map_pow, hxpow, map_one]
      calc
        Equiv.Perm.sign x = Equiv.Perm.sign x ^ 5 := by
          have hpowmod := Int.units_pow_eq_pow_mod_two
            (Equiv.Perm.sign x) 5
          simpa using hpowmod.symm
        _ = 1 := hsignpow
    let PA : Subgroup (alternatingGroup (Fin 5)) :=
      (P : Subgroup G).subgroupOf (alternatingGroup (Fin 5))
    have hPAnormal : PA.Normal := hPnormal.subgroupOf _
    have hPAcard : Nat.card PA = 5 := by
      calc
        Nat.card PA = Nat.card P :=
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPleAlt).toEquiv
        _ = 5 := hPcard
    have hAltcard : Nat.card (alternatingGroup (Fin 5)) = 60 := by
      rw [nat_card_alternatingGroup, Nat.card_fin]
      norm_num [Nat.factorial]
    rcases hPAnormal.eq_bot_or_eq_top with hbot | htop
    · have : Nat.card PA = 1 := by simp [hbot]
      omega
    · have : Nat.card PA = 60 := by
        rw [htop, Subgroup.card_top, hAltcard]
      omega
  · simpa [n] using hn

/-- An order-`20` subgroup of `S₅` is the normalizer of its unique Sylow
`5`-subgroup, viewed as an ambient Sylow subgroup. -/
private theorem lemma114_order20_subgroup_eq_normalizer
    (A : Subgroup (Equiv.Perm (Fin 5)))
    (hAcard : Nat.card A = 20) :
    ∃ P : Sylow 5 (Equiv.Perm (Fin 5)),
      A = Subgroup.normalizer (P : Subgroup (Equiv.Perm (Fin 5))) := by
  let G := Equiv.Perm (Fin 5)
  letI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let PA : Sylow 5 A := default
  have hPAcard : Nat.card PA = 5 := by
    rw [Sylow.card_eq_multiplicity, hAcard]
    rw [Nat.factorization_def _ Nat.prime_five]
    rw [show 20 = 2 ^ 2 * 5 ^ 1 by norm_num,
      padicValNat_mul_pow_right (p := 2) (q := 5) 2 1 (by norm_num)]
    norm_num
  have hPAindex : PA.index = 4 := by
    apply Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 5)
    calc
      5 * PA.index = Nat.card PA * PA.index := by rw [hPAcard]
      _ = Nat.card A := PA.card_mul_index
      _ = 20 := hAcard
      _ = 5 * 4 := by norm_num
  let nA := Nat.card (Sylow 5 A)
  have hdivA : nA ∣ 4 := by
    simpa [nA, hPAindex] using PA.card_dvd_index
  have hnApos : 0 < nA := by
    simpa [nA] using Nat.card_pos (α := Sylow 5 A)
  have hnAle : nA ≤ 4 := Nat.le_of_dvd (by norm_num) hdivA
  have hmodA : nA ≡ 1 [MOD 5] := by
    simpa [nA] using card_sylow_modEq_one 5 A
  have hnA : nA = 1 := by
    interval_cases nA <;> simp_all [Nat.ModEq]
  letI : Subsingleton (Sylow 5 A) :=
    (Nat.card_eq_one_iff_unique.mp (by simpa [nA] using hnA)).1
  have hPAnormal : (PA : Subgroup A).Normal :=
    Sylow.normal_of_subsingleton PA
  let PAmap : Subgroup G := (PA : Subgroup A).map A.subtype
  have hPAmapcard : Nat.card PAmap = 5 := by
    calc
      Nat.card PAmap = Nat.card PA := by
        simpa [PAmap] using
          (Subgroup.card_map_of_injective
            (K := (PA : Subgroup A)) A.subtype_injective)
      _ = 5 := hPAcard
  have hGcard : Nat.card G = 120 := by
    change Nat.card (Equiv.Perm (Fin 5)) = 120
    rw [Nat.card_perm, Nat.card_fin]
    norm_num [Nat.factorial]
  have hfactor : 5 ^ (Nat.card G).factorization 5 = 5 := by
    rw [hGcard]
    rw [Nat.factorization_def _ Nat.prime_five]
    rw [show 120 = 24 * 5 by norm_num,
      padicValNat.mul (by norm_num) (by norm_num),
      padicValNat.eq_zero_of_not_dvd (by norm_num), padicValNat.self] <;>
      norm_num
  let PAG : Sylow 5 G :=
    Sylow.ofCard PAmap (hPAmapcard.trans hfactor.symm)
  have hPAmapLeA : PAmap ≤ A := by
    simpa [G, PAmap] using Subgroup.map_subtype_le (PA : Subgroup A)
  have hsubeq : PAmap.subgroupOf A = (PA : Subgroup A) := by
    ext a
    change (a : G) ∈ PAmap ↔ a ∈ (PA : Subgroup A)
    simpa [PAmap] using
      (Subgroup.mem_map_iff_mem A.subtype_injective
        (K := (PA : Subgroup A)) (x := a))
  have hPAmapNormal : (PAmap.subgroupOf A).Normal := by
    rw [hsubeq]
    exact hPAnormal
  have hAleNmap : A ≤ Subgroup.normalizer (PAmap : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hPAmapLeA).mp
      hPAmapNormal
  have hAleN : A ≤ Subgroup.normalizer ((PAG : Subgroup G) : Set G) := by
    simpa [PAG] using hAleNmap
  let N : Subgroup G := Subgroup.normalizer ((PAG : Subgroup G) : Set G)
  have hNindex : N.index = 6 := by
    have h := PAG.card_eq_index_normalizer
    change Nat.card (Sylow 5 (Equiv.Perm (Fin 5))) = N.index at h
    exact h.symm.trans lemma114_perm5_sylow_count
  have hNcard : Nat.card N = 20 := by
    apply Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 6)
    calc
      6 * Nat.card N = N.index * Nat.card N := by rw [hNindex]
      _ = Nat.card G := N.index_mul_card
      _ = 120 := hGcard
      _ = 6 * 20 := by norm_num
  refine ⟨PAG, ?_⟩
  apply Subgroup.eq_of_le_of_card_ge hAleN
  change Nat.card N ≤ Nat.card A
  omega

/-- All order-`20` subgroups of `S₅` are conjugate. -/
private theorem lemma114_order20_subgroups_perm5_conjugate
    (A B : Subgroup (Equiv.Perm (Fin 5)))
    (hAcard : Nat.card A = 20) (hBcard : Nat.card B = 20) :
    ∃ g : Equiv.Perm (Fin 5),
      A.map (MulAut.conj g).toMonoidHom = B := by
  letI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨P, hA⟩ :=
    lemma114_order20_subgroup_eq_normalizer A hAcard
  obtain ⟨Q, hB⟩ :=
    lemma114_order20_subgroup_eq_normalizer B hBcard
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq
    (Equiv.Perm (Fin 5)) P Q
  have hmapP :
      (P : Subgroup (Equiv.Perm (Fin 5))).map
          (MulAut.conj g).toMonoidHom =
        (Q : Subgroup (Equiv.Perm (Fin 5))) := by
    change MulAut.conj g • (P : Subgroup (Equiv.Perm (Fin 5))) =
      (Q : Subgroup (Equiv.Perm (Fin 5)))
    rw [← Sylow.coe_subgroup_smul, hg]
  refine ⟨g, ?_⟩
  rw [hA, hB, Subgroup.map_equiv_normalizer_eq, hmapP]

/-! ## The exact recognized-model output -/

/-- The PSL/Suzuki model alternatives produced by the structural
`[II4; 3.2(e), 2.8(a)]` steps.  The small fixed-set action consequences are
proved from this package below. -/
@[expose] public def Lemma114RecognizedModels
    {X : Type u} [Group X] [Finite X]
    (V A P : Subgroup X) : Prop :=
  (Nonempty (lemma114FZero A ≃* PSL2BinaryMatrixGroup (Nat.card P)) ∧
      Nonempty (lemma114FHat V ≃* PSL2BinaryMatrixGroup 1) ∧
      Nonempty (lemma114FCore V ≃* PSL2BinaryMatrixGroup 1)) ∨
    (∃ m : ℕ,
      Nat.card P = 2 * m + 1 ∧
        Nonempty (lemma114FZero A ≃* SuzukiMatrixGroup m) ∧
        Nonempty (lemma114FHat V ≃* SuzukiMatrixGroup 0) ∧
        Nonempty (lemma114FCore V ≃*
          involutionCore (SuzukiMatrixGroup 0)))

/-- The source-level output of `[II4; 3.2(e), 2.8(a)]` used in Lemma 11.4.

In the PSL branch, both the fixed-field residual and its involution core are
`L₂(2)`.  In the Suzuki branch the fixed-field residual is the degenerate
Suzuki group over `GF(2)`, while the Section 11 group is its involution core.
The common fields record precisely the initial action facts consumed by
Lemma 11.5. -/
public structure Lemma114ModelTransport
    {X : Type u} [Group X] [Finite X]
    (M V A P : Subgroup X) (t u0 : X) : Prop where
  model : Lemma114RecognizedModels V A P
  order_tu : orderOf (t * u0) = 3 ∨ orderOf (t * u0) = 5
  fixedPoints_card :
    Nat.card (theorem4bFixedPoints M V) = orderOf (t * u0)
  tu_regular :
    IsRegularOn (Subgroup.zpowers (t * u0))
      (fixedPointsOfSubgroup X (conjugateCosetSpace M) V)

private theorem lemma114_card_mul_pred_le_of_twoTransitiveOn
    {X : Type u} {Omega : Type v} [Group X] [Finite X]
    [MulAction X Omega] [Finite Omega]
    (F : Subgroup X) (A : Set Omega)
    (htwo : IsTwoTransitiveOn F A)
    (hstable : ∀ (f : F) (omega : Omega),
      omega ∈ A → (f : X) • omega ∈ A)
    (alpha beta : Omega) (halpha : alpha ∈ A) (hbeta : beta ∈ A)
    (hab : alpha ≠ beta) :
    Nat.card {omega : Omega // omega ∈ A} *
        (Nat.card {omega : Omega // omega ∈ A} - 1) ≤ Nat.card F := by
  classical
  let Fixed := {omega : Omega // omega ∈ A}
  let Pair := {p : Fixed × Fixed // p.2 ≠ p.1}
  let pairMap : F → Pair := fun f ↦
    ⟨(⟨(f : X) • alpha, hstable f alpha halpha⟩,
      ⟨(f : X) • beta, hstable f beta hbeta⟩), by
        intro h
        apply hab
        exact MulAction.injective (f : X) (congrArg Subtype.val h).symm⟩
  have hsurj : Function.Surjective pairMap := by
    rintro ⟨⟨x, y⟩, hyx⟩
    have hxy : (x : Omega) ≠ (y : Omega) := by
      intro h
      exact hyx (Subtype.ext h.symm)
    obtain ⟨f, hfx, hfy⟩ :=
      htwo halpha hbeta x.property y.property hab hxy
    refine ⟨f, ?_⟩
    apply Subtype.ext
    exact Prod.ext (Subtype.ext hfx) (Subtype.ext hfy)
  let pairEquiv : Pair ≃
      (Sigma fun x : Fixed ↦ {y : Fixed // y ≠ x}) :=
    { toFun := fun p ↦ ⟨p.1.1, ⟨p.1.2, p.2⟩⟩
      invFun := fun p ↦ ⟨(p.1, p.2.1), p.2.2⟩
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl }
  have hcardPairs : Nat.card Pair =
        Nat.card Fixed * (Nat.card Fixed - 1) := by
    letI : Fintype Fixed := Fintype.ofFinite Fixed
    have hfiber (x : Fixed) :
        Nat.card {y : Fixed // y ≠ x} = Nat.card Fixed - 1 := by
      change ({y : Fixed | y ≠ x} : Set Fixed).ncard = Nat.card Fixed - 1
      rw [show {y : Fixed | y ≠ x} = Set.univ \ {x} by ext y; simp]
      simp
    rw [Nat.card_congr pairEquiv, Nat.card_sigma]
    simp_rw [hfiber]
    rw [Finset.sum_const, Nat.nsmul_eq_mul, Finset.card_univ,
      Nat.card_eq_fintype_card]
  rw [← hcardPairs]
  exact Nat.card_le_card_of_surjective pairMap hsurj

/-- A doubly transitive finite action is faithful when its group has the
cardinality of the ordered pairs of distinct points. -/
private theorem lemma114_toPermHom_injective_of_sharp_twoTransitive
    {G : Type u} {Omega : Type v}
    [Group G] [Finite G] [MulAction G Omega] [Finite Omega]
    (htwo : MulAction.IsMultiplyPretransitive G Omega 2)
    (alpha beta : Omega) (hab : alpha ≠ beta)
    (hcard : Nat.card G =
      Nat.card Omega * (Nat.card Omega - 1)) :
    Function.Injective (MulAction.toPermHom G Omega) := by
  classical
  let Pair := {p : Omega × Omega // p.2 ≠ p.1}
  let pairMap : G → Pair := fun g =>
    ⟨(g • alpha, g • beta), by
      intro h
      apply hab
      exact MulAction.injective g h.symm⟩
  have hsurj : Function.Surjective pairMap := by
    rw [MulAction.is_two_pretransitive_iff] at htwo
    rintro ⟨⟨x, y⟩, hyx⟩
    obtain ⟨g, hgx, hgy⟩ := htwo hab (fun h => hyx h.symm)
    refine ⟨g, ?_⟩
    apply Subtype.ext
    exact Prod.ext hgx hgy
  let pairEquiv : Pair ≃
      (Sigma fun x : Omega => {y : Omega // y ≠ x}) :=
    { toFun := fun p => ⟨p.1.1, ⟨p.1.2, p.2⟩⟩
      invFun := fun p => ⟨(p.1, p.2.1), p.2.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hcardPairs : Nat.card Pair =
      Nat.card Omega * (Nat.card Omega - 1) := by
    letI : Fintype Omega := Fintype.ofFinite Omega
    have hfiber (x : Omega) :
        Nat.card {y : Omega // y ≠ x} = Nat.card Omega - 1 := by
      change ({y : Omega | y ≠ x} : Set Omega).ncard = Nat.card Omega - 1
      rw [show {y : Omega | y ≠ x} = Set.univ \ {x} by ext y; simp]
      simp
    rw [Nat.card_congr pairEquiv, Nat.card_sigma]
    simp_rw [hfiber]
    rw [Finset.sum_const, Nat.nsmul_eq_mul, Finset.card_univ,
      Nat.card_eq_fintype_card]
  have hpairBij : Function.Bijective pairMap :=
    (Nat.bijective_iff_surjective_and_card pairMap).mpr
      ⟨hsurj, hcard.trans hcardPairs.symm⟩
  intro g h hgh
  apply hpairBij.injective
  apply Subtype.ext
  apply Prod.ext
  · change (MulAction.toPermHom G Omega g) alpha =
      (MulAction.toPermHom G Omega h) alpha
    rw [hgh]
  · change (MulAction.toPermHom G Omega g) beta =
      (MulAction.toPermHom G Omega h) beta
    rw [hgh]

/-- Orbit--stabilizer for a doubly transitive invariant subset, with the base
stabilizer expressed as an ambient subgroup intersection. -/
private theorem lemma114_card_eq_fixed_mul_inf_stabilizer
    {X : Type u} {Omega : Type v}
    [Group X] [Finite X] [MulAction X Omega] [Finite Omega]
    (F H : Subgroup X) (A : Set Omega)
    (htwo : IsTwoTransitiveOn F A)
    (hstable : ∀ (f : F) (omega : Omega),
      omega ∈ A → (f : X) • omega ∈ A)
    (alpha beta : Omega) (halpha : alpha ∈ A) (hbeta : beta ∈ A)
    (hab : alpha ≠ beta)
    (hstab : MulAction.stabilizer X alpha = H) :
    Nat.card F =
      Nat.card {omega : Omega // omega ∈ A} *
        Nat.card (F ⊓ H : Subgroup X) := by
  classical
  have horbitEq : MulAction.orbit F alpha = A := by
    ext omega
    constructor
    · intro homega
      rcases MulAction.mem_orbit_iff.mp homega with ⟨f, rfl⟩
      exact hstable f alpha halpha
    · intro homega
      by_cases hne : omega = alpha
      · rw [hne]
        exact MulAction.mem_orbit_self alpha
      · obtain ⟨f, hfa, _hfb⟩ :=
          htwo halpha hbeta homega halpha hab hne
        exact MulAction.mem_orbit_iff.mpr ⟨f, hfa⟩
  have hstabEq : MulAction.stabilizer F alpha =
      (F ⊓ H).subgroupOf F := by
    ext f
    rw [MulAction.mem_stabilizer_iff]
    constructor
    · intro hf
      exact ⟨f.property, by
        rw [← hstab]
        apply MulAction.mem_stabilizer_iff.mpr
        exact hf⟩
    · rintro ⟨_hfF, hfH⟩
      have hf : (f : X) ∈ MulAction.stabilizer X alpha := by
        rw [hstab]
        exact hfH
      exact MulAction.mem_stabilizer_iff.mp hf
  letI : Fintype F := Fintype.ofFinite F
  letI : Fintype (MulAction.orbit F alpha) := Fintype.ofFinite _
  letI : Fintype (MulAction.stabilizer F alpha) := Fintype.ofFinite _
  have horbitStabilizer :
      Nat.card (MulAction.orbit F alpha) *
          Nat.card (MulAction.stabilizer F alpha) = Nat.card F := by
    simpa [Nat.card_eq_fintype_card] using
      (MulAction.card_orbit_mul_card_stabilizer_eq_card_group
        (G := F) (X := Omega) alpha)
  calc
    Nat.card F = Nat.card (MulAction.orbit F alpha) *
        Nat.card (MulAction.stabilizer F alpha) := horbitStabilizer.symm
    _ = Nat.card {omega : Omega // omega ∈ A} *
        Nat.card ((F ⊓ H).subgroupOf F) := by rw [horbitEq, hstabEq]
    _ = Nat.card {omega : Omega // omega ∈ A} *
        Nat.card (F ⊓ H : Subgroup X) := by
      congr 1
      exact Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe
          (H := F ⊓ H) (K := F) inf_le_left).toEquiv

/-- Removing one specified point from a finite invariant set lowers its
cardinality by exactly one. -/
private theorem lemma114_card_fixed_eq_punct_add_one
    {Omega : Type v} [Finite Omega] (A : Set Omega) (alpha : Omega)
    (halpha : alpha ∈ A) :
    Nat.card {omega : Omega // omega ∈ A} =
      Nat.card {omega : Omega // omega ∈ A ∧ omega ≠ alpha} + 1 := by
  classical
  let Fixed := {omega : Omega // omega ∈ A}
  let alphaFixed : Fixed := ⟨alpha, halpha⟩
  let punctEquiv :
      {omega : Omega // omega ∈ A ∧ omega ≠ alpha} ≃
        {omega : Fixed // omega ≠ alphaFixed} :=
    { toFun := fun omega =>
        ⟨⟨omega, omega.property.1⟩, by
          intro h
          exact omega.property.2
            (congrArg (fun z : Fixed ↦ (z : Omega)) h)⟩
      invFun := fun omega =>
        ⟨omega, omega.1.property, by
          intro h
          apply omega.property
          apply Subtype.ext
          exact h⟩
      left_inv := by
        intro omega
        apply Subtype.ext
        rfl
      right_inv := by
        intro omega
        apply Subtype.ext
        apply Subtype.ext
        rfl }
  have hpunctFixed :
      Nat.card {omega : Fixed // omega ≠ alphaFixed} =
        Nat.card Fixed - 1 := by
    change ({omega : Fixed | omega ≠ alphaFixed} : Set Fixed).ncard =
      Nat.card Fixed - 1
    rw [show {omega : Fixed | omega ≠ alphaFixed} = Set.univ \ {alphaFixed} by
      ext omega
      simp]
    simp
  have hFixedPos : 0 < Nat.card Fixed := by
    letI : Nonempty Fixed := ⟨alphaFixed⟩
    exact Nat.card_pos
  calc
    Nat.card {omega : Omega // omega ∈ A} = Nat.card Fixed := rfl
    _ = (Nat.card Fixed - 1) + 1 := by
      symm
      exact Nat.sub_add_cancel (by omega)
    _ = Nat.card {omega : Fixed // omega ≠ alphaFixed} + 1 := by
      rw [hpunctFixed]
    _ = Nat.card {omega : Omega // omega ∈ A ∧ omega ≠ alpha} + 1 :=
      congrArg (fun n ↦ n + 1) (Nat.card_congr punctEquiv).symm

/-- A group equivalence restricts to an equivalence of involution cores. -/
private noncomputable def lemma114_involutionCoreMulEquiv
    {G H : Type*} [Group G] [Group H] (e : G ≃* H) :
    involutionCore G ≃* involutionCore H :=
  (MulEquiv.subgroupMap e (involutionCore G)).trans
    (MulEquiv.subgroupCongr (involutionCore_map_mulEquiv e))

/-- The ambient Section 11 core is naturally equivalent to the abstract
involution core of `Fhat`. -/
private noncomputable def lemma114_FCore_equiv_involutionCore_FHat
    {X : Type u} [Group X] [Finite X] (V : Subgroup X) :
    lemma114FCore V ≃* involutionCore (lemma114FHat V) := by
  let Fhat : Subgroup X := lemma114FHat V
  let eAmbient : lemma114FCore V ≃* involutionCoreIn Fhat :=
    MulEquiv.subgroupCongr (by
      simpa [Fhat] using lemma114_FCore_eq_involutionCoreIn_FHat V)
  let eLocal : involutionCoreIn Fhat ≃*
      (involutionCoreIn Fhat).subgroupOf Fhat :=
    (Subgroup.subgroupOfEquivOfLe (involutionCoreIn_le Fhat)).symm
  let eCore : (involutionCoreIn Fhat).subgroupOf Fhat ≃*
      involutionCore Fhat :=
    MulEquiv.subgroupCongr (by
      simpa [involutionCoreIn] using
        subgroupOf_map_subtype_eq (involutionCore Fhat))
  exact eAmbient.trans (eLocal.trans eCore)

/-- Transport the Section 11 core through a recognized model for `Fhat`. -/
private noncomputable def lemma114_FCore_equiv_involutionCore_of_equiv
    {X : Type u} [Group X] [Finite X] (V : Subgroup X)
    {H : Type*} [Group H] (e : lemma114FHat V ≃* H) :
    lemma114FCore V ≃* involutionCore H :=
  (lemma114_FCore_equiv_involutionCore_FHat V).trans
    (lemma114_involutionCoreMulEquiv e)

/-- Transpositions generate `S₃`, hence its involution core is the whole
group. -/
private theorem lemma114_permFinThree_involutionCore_eq_top :
    involutionCore (Equiv.Perm (Fin 3)) = ⊤ := by
  rw [involutionCore_eq_closure]
  apply top_unique
  rw [← Equiv.Perm.closure_isSwap]
  apply Subgroup.closure_mono
  rintro sigma ⟨x, y, hxy, rfl⟩
  constructor
  · intro h
    exact hxy (Equiv.swap_eq_one_iff.mp h)
  · change Equiv.swap x y * Equiv.swap x y = 1
    exact Equiv.swap_mul_self x y

/-- The prime-field PSL model is generated by its involutions. -/
private theorem lemma114_psl2BinaryOne_involutionCore_eq_top :
    involutionCore (PSL2BinaryMatrixGroup 1) = ⊤ := by
  let K := BinaryGaloisField 1
  have hKcard : Nat.card K = 2 := by
    simpa [K, BinaryGaloisField] using
      (GaloisField.card 2 1 (by norm_num))
  let e : PSL2BinaryMatrixGroup 1 ≃* Equiv.Perm (Fin 3) :=
    (External.huppert_II_6_14_a_psl2_card_two hKcard).some
  have hmap := involutionCore_map_mulEquiv e.symm
  rw [lemma114_permFinThree_involutionCore_eq_top,
    Subgroup.map_top_of_surjective e.symm.toMonoidHom e.symm.surjective] at hmap
  exact hmap.symm

/-- Relabel a faithful sharp two-transitive action by `Fin n`. -/
private theorem lemma114_exists_faithful_permHom_fin
    {G : Type u} {Omega : Type v}
    [Group G] [Finite G] [MulAction G Omega] [Finite Omega]
    (htwo : MulAction.IsMultiplyPretransitive G Omega 2)
    (alpha beta : Omega) (hab : alpha ≠ beta)
    {n : ℕ} (hOmega : Nat.card Omega = n)
    (hsharp : Nat.card G =
      Nat.card Omega * (Nat.card Omega - 1)) :
    ∃ rho : G →* Equiv.Perm (Fin n), Function.Injective rho := by
  let eOmega : Omega ≃ Fin n := Finite.equivFinOfCardEq hOmega
  let rho : G →* Equiv.Perm (Fin n) :=
    (Equiv.permCongrHom eOmega).toMonoidHom.comp
      (MulAction.toPermHom G Omega)
  refine ⟨rho, ?_⟩
  exact (Equiv.permCongrHom eOmega).injective.comp
    (lemma114_toPermHom_injective_of_sharp_twoTransitive
      htwo alpha beta hab hsharp)

/-- A sharp two-transitive group of order six on three points is the
prime-field PSL model. -/
private theorem lemma114_equiv_psl2BinaryOne_of_sharp_action
    {G : Type u} {Omega : Type v}
    [Group G] [Finite G] [MulAction G Omega] [Finite Omega]
    (htwo : MulAction.IsMultiplyPretransitive G Omega 2)
    (alpha beta : Omega) (hab : alpha ≠ beta)
    (hOmega : Nat.card Omega = 3)
    (hG : Nat.card G = 6) :
    Nonempty (G ≃* PSL2BinaryMatrixGroup 1) := by
  have hsharp : Nat.card G =
      Nat.card Omega * (Nat.card Omega - 1) := by
    rw [hG, hOmega]
  obtain ⟨rho, hrho⟩ := lemma114_exists_faithful_permHom_fin
    htwo alpha beta hab hOmega hsharp
  have hPermCard : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
    rw [Nat.card_perm, Nat.card_fin]
    norm_num [Nat.factorial]
  have hrhoBij : Function.Bijective rho :=
    (Nat.bijective_iff_injective_and_card rho).mpr
      ⟨hrho, hG.trans hPermCard.symm⟩
  let eGPerm : G ≃* Equiv.Perm (Fin 3) :=
    MulEquiv.ofBijective rho hrhoBij
  let K := BinaryGaloisField 1
  have hKcard : Nat.card K = 2 := by
    simpa [K, BinaryGaloisField] using
      (GaloisField.card 2 1 (by norm_num))
  let eModelPerm : PSL2BinaryMatrixGroup 1 ≃* Equiv.Perm (Fin 3) :=
    (External.huppert_II_6_14_a_psl2_card_two hKcard).some
  exact ⟨eGPerm.trans eModelPerm.symm⟩

/-- The natural five-point ovoid action embeds the degenerate Suzuki group
faithfully in `S₅`. -/
private theorem lemma114_suzukiZero_exists_faithful_permHom_finFive :
    ∃ rho : SuzukiMatrixGroup 0 →* Equiv.Perm (Fin 5),
      Function.Injective rho := by
  let K := BinaryGaloisField 1
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 1
  have hpi : ∀ x : K, pi x = x ^ 2 := by
    intro x
    simpa [pi] using iterateFrobeniusEquiv_def K 2 1 x
  let pinf : ℙ K (Fin 4 → K) :=
    Projectivization.mk K ![1, 0, 0, 0] (by simp)
  let p : K → K → ℙ K (Fin 4 → K) := fun x y =>
    Projectivization.mk K
      ![x * y + pi x * x ^ 2 + pi y, y, x, 1] (by simp)
  let O : Set (ℙ K (Fin 4 → K)) :=
    {pinf} ∪ Set.range fun z : K × K => p z.1 z.2
  rcases External.suzukiMatrixGroup_ovoid_action_data 0 pi
      (by simpa using hpi) with
    ⟨hpres, hfaithful, _htwo, hOcard⟩
  let linRep : SuzukiMatrixGroup 0 →*
      LinearMap.GeneralLinearGroup K (Fin 4 → K) :=
    Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp
      (SuzukiMatrixGroup 0).subtype
  letI : MulAction (SuzukiMatrixGroup 0) (ℙ K (Fin 4 → K)) :=
    MulAction.compHom (ℙ K (Fin 4 → K)) linRep
  let Omega : SubMulAction (SuzukiMatrixGroup 0)
      (ℙ K (Fin 4 → K)) :=
    { carrier := O
      smul_mem' := by
        intro g z hz
        exact hpres g z hz }
  letI : MulAction (SuzukiMatrixGroup 0) Omega := Omega.mulAction
  let rho0 : SuzukiMatrixGroup 0 →* Equiv.Perm Omega :=
    MulAction.toPermHom (SuzukiMatrixGroup 0) Omega
  have hrho0 : Function.Injective rho0 := by
    intro g h hgh
    have hsmul : ∀ z : Omega, rho0 g z = rho0 h z := by
      intro z
      rw [hgh]
    have hinv : h⁻¹ * g = 1 := by
      apply hfaithful
      intro z hz
      let zO : Omega := ⟨z, hz⟩
      have hzO : rho0 (h⁻¹ * g) zO = zO := by
        rw [map_mul, map_inv]
        change (rho0 h)⁻¹ (rho0 g zO) = zO
        rw [hsmul zO]
        exact (rho0 h).symm_apply_apply zO
      exact congrArg Subtype.val hzO
    exact (inv_mul_eq_one.mp hinv).symm
  have hOmega : Nat.card Omega = 5 := by
    change Nat.card {z // z ∈ O} = 5
    simpa [O] using hOcard
  let eOmega : Omega ≃ Fin 5 := Finite.equivFinOfCardEq hOmega
  let rho : SuzukiMatrixGroup 0 →* Equiv.Perm (Fin 5) :=
    (Equiv.permCongrHom eOmega).toMonoidHom.comp rho0
  refine ⟨rho, ?_⟩
  exact (Equiv.permCongrHom eOmega).injective.comp hrho0

/-- Conjugate faithful permutation images yield an equivalence of their
source groups. -/
private theorem lemma114_mulEquiv_of_conjugate_perm_ranges
    {G H : Type*} [Group G] [Group H] {n : ℕ}
    (rhoG : G →* Equiv.Perm (Fin n))
    (rhoH : H →* Equiv.Perm (Fin n))
    (hinjG : Function.Injective rhoG)
    (hinjH : Function.Injective rhoH)
    (hconj : ∃ g : Equiv.Perm (Fin n),
      rhoG.range.map (MulAut.conj g).toMonoidHom = rhoH.range) :
    Nonempty (G ≃* H) := by
  obtain ⟨g, hg⟩ := hconj
  let eG : G ≃* rhoG.range := MonoidHom.ofInjective hinjG
  let eConj : rhoG.range ≃*
      rhoG.range.map (MulAut.conj g).toMonoidHom :=
    MulEquiv.subgroupMap (MulAut.conj g) rhoG.range
  let eRanges : rhoG.range.map (MulAut.conj g).toMonoidHom ≃*
      rhoH.range := MulEquiv.subgroupCongr hg
  let eH : H ≃* rhoH.range := MonoidHom.ofInjective hinjH
  exact ⟨eG.trans (eConj.trans (eRanges.trans eH.symm))⟩

/-- A sharp two-transitive group of order twenty on five points is the
degenerate Suzuki model. -/
private theorem lemma114_equiv_suzukiZero_of_sharp_action
    {G : Type u} {Omega : Type v}
    [Group G] [Finite G] [MulAction G Omega] [Finite Omega]
    (htwo : MulAction.IsMultiplyPretransitive G Omega 2)
    (alpha beta : Omega) (hab : alpha ≠ beta)
    (hOmega : Nat.card Omega = 5)
    (hG : Nat.card G = 20) :
    Nonempty (G ≃* SuzukiMatrixGroup 0) := by
  have hsharp : Nat.card G =
      Nat.card Omega * (Nat.card Omega - 1) := by
    rw [hG, hOmega]
  obtain ⟨rhoG, hinjG⟩ := lemma114_exists_faithful_permHom_fin
    htwo alpha beta hab hOmega hsharp
  obtain ⟨rhoS, hinjS⟩ :=
    lemma114_suzukiZero_exists_faithful_permHom_finFive
  have hRangeG : Nat.card rhoG.range = 20 := by
    calc
      Nat.card rhoG.range = Nat.card G :=
        Nat.card_congr (MonoidHom.ofInjective hinjG).symm.toEquiv
      _ = 20 := hG
  have hRangeS : Nat.card rhoS.range = 20 := by
    calc
      Nat.card rhoS.range = Nat.card (SuzukiMatrixGroup 0) :=
        Nat.card_congr (MonoidHom.ofInjective hinjS).symm.toEquiv
      _ = 20 := lemma114_suzukiZero_card
  exact lemma114_mulEquiv_of_conjugate_perm_ranges rhoG rhoS hinjG hinjS
    (lemma114_order20_subgroups_perm5_conjugate
      rhoG.range rhoS.range hRangeG hRangeS)

private theorem lemma114_zpowers_orbitMap_injective_of_prime_card
    {X : Type u} {Omega : Type v} [Group X]
    [MulAction X Omega]
    (g : X) (alpha : Omega)
    (hprime : (Nat.card (Subgroup.zpowers g)).Prime)
    (hmove : g • alpha ≠ alpha) :
    Function.Injective
      (fun z : Subgroup.zpowers g ↦ (z : X) • alpha) := by
  let Z := Subgroup.zpowers g
  letI : Fact (Nat.card Z).Prime := ⟨by simpa [Z] using hprime⟩
  have hstab : MulAction.stabilizer Z alpha = ⊥ := by
    rcases (MulAction.stabilizer Z alpha).eq_bot_or_eq_top_of_prime_card with
      hbot | htop
    · exact hbot
    · exfalso
      let gz : Z := ⟨g, Subgroup.mem_zpowers g⟩
      have hgstab : gz ∈ MulAction.stabilizer Z alpha := by
        rw [htop]
        exact Subgroup.mem_top gz
      exact hmove (MulAction.mem_stabilizer_iff.mp hgstab)
  intro z w hzw
  have hstabMem : w⁻¹ * z ∈ MulAction.stabilizer Z alpha := by
    change ((w⁻¹ * z : Z) : X) • alpha = alpha
    rw [Subgroup.coe_mul, Subgroup.coe_inv, mul_smul,
      inv_smul_eq_iff]
    exact hzw
  rw [hstab] at hstabMem
  have hone : w⁻¹ * z = 1 := Subgroup.mem_bot.mp hstabMem
  exact (inv_mul_eq_one.mp hone).symm

private theorem lemma114_isRegularOn_zpowers_of_prime_card_eq
    {X : Type u} {Omega : Type v} [Group X] [Finite X]
    [MulAction X Omega] [Finite Omega]
    (g : X) (A : Set Omega) (alpha : Omega) (halpha : alpha ∈ A)
    (hstable : ∀ (z : Subgroup.zpowers g) (omega : Omega),
      omega ∈ A → (z : X) • omega ∈ A)
    (hprime : (Nat.card (Subgroup.zpowers g)).Prime)
    (hmove : g • alpha ≠ alpha)
    (hcard : Nat.card (Subgroup.zpowers g) =
      Nat.card {omega : Omega // omega ∈ A}) :
    IsRegularOn (Subgroup.zpowers g) A := by
  classical
  let Z := Subgroup.zpowers g
  let Fixed := {omega : Omega // omega ∈ A}
  let orbitMap : Z → Fixed := fun z ↦
    ⟨(z : X) • alpha, hstable z alpha halpha⟩
  have horbitInj : Function.Injective orbitMap := by
    intro z w hzw
    exact lemma114_zpowers_orbitMap_injective_of_prime_card
      g alpha hprime hmove (congrArg Subtype.val hzw)
  have horbitBij : Function.Bijective orbitMap :=
    (Nat.bijective_iff_injective_and_card orbitMap).mpr ⟨horbitInj, hcard⟩
  intro a b ha hb
  obtain ⟨za, hza⟩ := horbitBij.2 ⟨a, ha⟩
  obtain ⟨zb, hzb⟩ := horbitBij.2 ⟨b, hb⟩
  let zba : Z := zb * za⁻¹
  refine ⟨zba, ?_, ?_⟩
  · have hzaVal : (za : X) • alpha = a := congrArg Subtype.val hza
    have hzbVal : (zb : X) • alpha = b := congrArg Subtype.val hzb
    change (zba : X) • a = b
    rw [← hzaVal, ← hzbVal]
    simp [zba, mul_smul]
  · intro w hw
    have hzaVal : (za : X) • alpha = a := congrArg Subtype.val hza
    have hzbVal : (zb : X) • alpha = b := congrArg Subtype.val hzb
    have hwza : (w * za : Z) = zb := by
      apply horbitInj
      apply Subtype.ext
      change ((w * za : Z) : X) • alpha = (zb : X) • alpha
      rw [Subgroup.coe_mul, mul_smul, hzaVal, hw, hzbVal]
    calc
      w = (w * za) * za⁻¹ := by simp
      _ = zb * za⁻¹ := by rw [hwza]
      _ = zba := rfl

private theorem lemma114_model_order_and_card
    {X : Type u} [Group X] [Finite X]
    {V A P : Subgroup X} {t u0 : X}
    (ht : IsInvolution t) (hu : IsInvolution u0) (htu : t ≠ u0)
    (htF : t ∈ lemma114FCore V) (huF : u0 ∈ lemma114FCore V)
    (hmodel : Lemma114RecognizedModels V A P) :
    (orderOf (t * u0) = 3 ∧ Nat.card (lemma114FHat V) = 6) ∨
      (orderOf (t * u0) = 5 ∧ Nat.card (lemma114FHat V) = 20) := by
  let tF : lemma114FCore V := ⟨t, htF⟩
  let uF : lemma114FCore V := ⟨u0, huF⟩
  have htFInv : IsInvolution tF := IsInvolution.subtype ht htF
  have huFInv : IsInvolution uF := IsInvolution.subtype hu huF
  have htuF : tF ≠ uF := fun h ↦ htu (congrArg Subtype.val h)
  rcases hmodel with ⟨_hF0, ⟨eHat⟩, ⟨eCore⟩⟩ |
    ⟨m, _hm, _hF0, ⟨eHat⟩, ⟨eCore⟩⟩
  · left
    have het : IsInvolution (eCore tF) :=
      IsInvolution.map_of_injective htFInv eCore.toMonoidHom eCore.injective
    have heu : IsInvolution (eCore uF) :=
      IsInvolution.map_of_injective huFInv eCore.toMonoidHom eCore.injective
    have hene : eCore tF ≠ eCore uF := fun h ↦ htuF (eCore.injective h)
    have horderSmall :=
      lemma114_psl2BinaryOne_involution_product_order het heu hene
    have horder : orderOf (t * u0) = 3 := by
      calc
        orderOf (t * u0) = orderOf (tF * uF) :=
          Subgroup.orderOf_coe (tF * uF)
        _ = orderOf (eCore (tF * uF)) :=
          (orderOf_injective eCore.toMonoidHom eCore.injective _).symm
        _ = orderOf (eCore tF * eCore uF) :=
          congrArg orderOf (eCore.map_mul tF uF)
        _ = 3 := horderSmall
    let K := BinaryGaloisField 1
    have hKcard : Nat.card K = 2 := by
      simpa [K, BinaryGaloisField] using
        (GaloisField.card 2 1 (by norm_num))
    let ePerm : PSL2BinaryMatrixGroup 1 ≃* Equiv.Perm (Fin 3) :=
      (External.huppert_II_6_14_a_psl2_card_two hKcard).some
    have hpslCard : Nat.card (PSL2BinaryMatrixGroup 1) = 6 := by
      calc
        Nat.card (PSL2BinaryMatrixGroup 1) =
            Nat.card (Equiv.Perm (Fin 3)) := Nat.card_congr ePerm.toEquiv
        _ = 6 := by
          rw [Nat.card_perm, Nat.card_fin]
          norm_num [Nat.factorial]
    exact ⟨horder, (Nat.card_congr eHat.toEquiv).trans hpslCard⟩
  · right
    have het : IsInvolution (eCore tF) :=
      IsInvolution.map_of_injective htFInv eCore.toMonoidHom eCore.injective
    have heu : IsInvolution (eCore uF) :=
      IsInvolution.map_of_injective huFInv eCore.toMonoidHom eCore.injective
    have hene : eCore tF ≠ eCore uF := fun h ↦ htuF (eCore.injective h)
    have horderSmall :=
      lemma114_suzukiZeroCore_involution_product_order het heu hene
    have horder : orderOf (t * u0) = 5 := by
      calc
        orderOf (t * u0) = orderOf (tF * uF) :=
          Subgroup.orderOf_coe (tF * uF)
        _ = orderOf (eCore (tF * uF)) :=
          (orderOf_injective eCore.toMonoidHom eCore.injective _).symm
        _ = orderOf (eCore tF * eCore uF) :=
          congrArg orderOf (eCore.map_mul tF uF)
        _ = 5 := horderSmall
    exact ⟨horder,
      (Nat.card_congr eHat.toEquiv).trans lemma114_suzukiZero_card⟩

/-- The small fixed-field action consequences are checked consequences of the
recognized models, Lemma 8.3, and Proposition 8.4. -/
public theorem lemma114_small_action_of_model
    {X : Type u} [Group X] [Finite X]
    {M W : Subgroup X} {t : X}
    (hM : IsStronglyEmbedded M)
    (ht : IsInvolution t) (htM : t ∉ M)
    (d83 : Lemma83Data M t)
    (h84 : Proposition84Statement M t d83.u)
    (d : Lemma101Conclusion M W
      (M ⊓ rightConjugate M t)
      (W ⊓ (M ⊓ rightConjugate M t))
      (peterfalviV (M ⊓ rightConjugate M t) t) t)
    (hmodel : Lemma114RecognizedModels
      (peterfalviV (M ⊓ rightConjugate M t) t)
      d.choice.initial.A1 d.choice.P) :
    let V := peterfalviV (M ⊓ rightConjugate M t) t
    (orderOf (t * d83.u) = 3 ∨ orderOf (t * d83.u) = 5) ∧
      Nat.card (theorem4bFixedPoints M V) = orderOf (t * d83.u) ∧
      IsRegularOn (Subgroup.zpowers (t * d83.u))
        (fixedPointsOfSubgroup X (conjugateCosetSpace M) V) := by
  classical
  let D : Subgroup X := M ⊓ rightConjugate M t
  let V : Subgroup X := peterfalviV D t
  let A : Subgroup X := d.choice.initial.A1
  let P : Subgroup X := d.choice.P
  let Fhat : Subgroup X := lemma114FHat V
  let FixedSet : Set (conjugateCosetSpace M) :=
    fixedPointsOfSubgroup X (conjugateCosetSpace M) V
  let alpha : conjugateCosetSpace M := QuotientGroup.mk 1
  let beta : conjugateCosetSpace M := QuotientGroup.mk t
  let g : X := t * d83.u
  let Z : Subgroup X := Subgroup.zpowers g
  have hVeq :
      V = D ⊓ Subgroup.centralizer ({d83.u} : Set X) := by
    simpa [V, D, peterfalviV] using d83.centralizer_eq
  have hVM : V ≤ M := by
    dsimp [V, D, peterfalviV]
    exact inf_le_left.trans inf_le_left
  have hVright : V ≤ rightConjugate M t := by
    dsimp [V, D, peterfalviV]
    exact inf_le_left.trans inf_le_right
  have hVt : V ≤ Subgroup.centralizer ({t} : Set X) := by
    dsimp [V, peterfalviV]
    exact inf_le_right
  have hVu : V ≤ Subgroup.centralizer ({d83.u} : Set X) := by
    rw [hVeq]
    exact inf_le_right
  have hAV : A ≤ V := by
    dsimp [A, V, D]
    rw [d.choice.initial.A1_eq]
    exact inf_le_left
  have hAne : A ≠ ⊥ := by
    simpa [A] using d.choice.initial.A1_ne_bot
  have hAnormal : (A.subgroupOf V).Normal := by
    simpa [A, V, D] using d.choice.initial.A1_normal_V
  have hI : HasNontrivialPeterfalviNormalizer D t A := by
    obtain ⟨j, hjI, hjCY, hjne⟩ := d.choice.Y_nontrivial_centralizer
    have hjJ : j ∈ d.choice.initial.J := by
      change j ∈ (d.choice.initial.J : Set X)
      rw [d.choice.initial.J_eq_centralizer]
      exact ⟨hjI, hjCY⟩
    have hjCA : j ∈ Subgroup.centralizer (A : Set X) := by
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      dsimp [A] at ha
      rw [d.choice.initial.A1_eq] at ha
      exact (Subgroup.mem_centralizer_iff.mp ha.2 j hjJ).symm
    exact ⟨j, by simpa [D] using hjI,
      centralizer_le_normalizer A hjCA, hjne⟩
  have h84V : Proposition84Conclusion M t d83.u V := by
    exact h84 V A
      (by simpa [D] using le_of_eq hVeq)
      hAne hAV hAnormal.isSubnormal hI
  have htwo : IsTwoTransitiveOn Fhat FixedSet := by
    simpa [Fhat, FixedSet, V, lemma114FHat] using h84V.1.1
  have halpha : alpha ∈ FixedSet := by
    simpa [alpha, FixedSet] using theorem4b_baseCoset_mem_fixedPoints hVM
  have hbeta : beta ∈ FixedSet := by
    intro v hv
    apply MulAction.mem_stabilizer_iff.mp
    rw [conjugateCoset_stabilizer M t, ht.inv_eq_self]
    exact hVright hv
  have hab : alpha ≠ beta := by
    intro h
    apply htM
    simpa [alpha, beta] using QuotientGroup.eq.mp h
  have hthree : 3 ≤ Nat.card (theorem4bFixedPoints M V) := by
    apply hM.three_le_fixedPoints_of_le_lemma83V ht htM d83
    simpa [D] using le_of_eq hVeq
  obtain ⟨htF, huF⟩ :=
    lemma114_involutions_mem_FCore ht d83.u_involution hVt hVu
  have htu : t ≠ d83.u := by
    intro h
    exact htM (h.symm ▸ d83.u_mem_M)
  have hmodel' := lemma114_model_order_and_card ht d83.u_involution htu
    htF huF (by simpa [V, A, P, D] using hmodel)
  have hFhatC : Fhat ≤ Subgroup.centralizer (V : Set X) := by
    simpa [Fhat, lemma114FHat] using
      centralizerTwoPrimeResidual_le_ambientCentralizer V
  have hFcoreHat : lemma114FCore V ≤ Fhat := by
    rw [lemma114_FCore_eq_involutionCoreIn_FHat]
    exact (involutionCoreIn_le (lemma114FHat V)).trans_eq (by rfl)
  have hgFhat : g ∈ Fhat := by
    exact Fhat.mul_mem (hFcoreHat htF) (hFcoreHat huF)
  have hZFhat : Z ≤ Fhat := by
    exact Subgroup.zpowers_le_of_mem hgFhat
  have hstableF : ∀ (f : Fhat) (omega : conjugateCosetSpace M),
      omega ∈ FixedSet → (f : X) • omega ∈ FixedSet := by
    intro f omega homega
    exact smul_mem_fixedPointsOfSubgroup_of_mem_centralizer
      (hFhatC f.property) homega
  have hstableZ : ∀ (z : Z) (omega : conjugateCosetSpace M),
      omega ∈ FixedSet → (z : X) • omega ∈ FixedSet := by
    intro z omega homega
    exact smul_mem_fixedPointsOfSubgroup_of_mem_centralizer
      (hFhatC (hZFhat z.property)) homega
  have hgM : g ∉ M := by
    intro hg
    apply htM
    have hgu : g * d83.u ∈ M := M.mul_mem hg d83.u_mem_M
    have huu : d83.u * d83.u = 1 := by
      simpa [pow_two] using d83.u_involution.sq_eq_one
    simpa [g, mul_assoc, huu] using hgu
  have hmove : g • alpha ≠ alpha := by
    intro hfix
    apply hgM
    have hgstab : g ∈ MulAction.stabilizer X alpha :=
      MulAction.mem_stabilizer_iff.mpr hfix
    simpa [alpha, baseCoset_stabilizer M] using hgstab
  have hbound :
      Nat.card (theorem4bFixedPoints M V) *
          (Nat.card (theorem4bFixedPoints M V) - 1) ≤ Nat.card Fhat := by
    exact lemma114_card_mul_pred_le_of_twoTransitiveOn Fhat FixedSet htwo
      hstableF alpha beta halpha hbeta hab
  rcases hmodel' with ⟨horder, hFhatCard⟩ | ⟨horder, hFhatCard⟩
  · have hbound6 :
        Nat.card (theorem4bFixedPoints M V) *
            (Nat.card (theorem4bFixedPoints M V) - 1) ≤ 6 := by
      exact hbound.trans_eq (by simpa [Fhat] using hFhatCard)
    have hcardFixed : Nat.card (theorem4bFixedPoints M V) = 3 := by
      have hpred : Nat.card (theorem4bFixedPoints M V) - 1 + 1 =
          Nat.card (theorem4bFixedPoints M V) :=
        Nat.sub_add_cancel (by omega)
      nlinarith
    have hZprime : (Nat.card Z).Prime := by
      simpa [Z, g, Nat.card_zpowers, horder] using Nat.prime_three
    have hZcardFixed : Nat.card Z =
        Nat.card (theorem4bFixedPoints M V) := by
      rw [hcardFixed]
      simpa [Z, g, Nat.card_zpowers] using horder
    have hregular : IsRegularOn Z FixedSet :=
      lemma114_isRegularOn_zpowers_of_prime_card_eq g FixedSet alpha halpha
        hstableZ hZprime hmove hZcardFixed
    exact ⟨Or.inl horder,
      hcardFixed.trans horder.symm, by simpa [Z, g] using hregular⟩
  · have horbitInj : Function.Injective
        (fun z : Z ↦ (z : X) • alpha) := by
      apply lemma114_zpowers_orbitMap_injective_of_prime_card g alpha
      · simpa [Z, g, Nat.card_zpowers, horder] using Nat.prime_five
      · exact hmove
    let orbitMap : Z → theorem4bFixedPoints M V := fun z ↦
      ⟨(z : X) • alpha, hstableZ z alpha halpha⟩
    have horbitFixedInj : Function.Injective orbitMap := by
      intro z w hzw
      exact horbitInj (congrArg Subtype.val hzw)
    have hfive : 5 ≤ Nat.card (theorem4bFixedPoints M V) := by
      have hle := Nat.card_le_card_of_injective orbitMap horbitFixedInj
      simpa [Z, g, Nat.card_zpowers, horder] using hle
    have hbound20 :
        Nat.card (theorem4bFixedPoints M V) *
            (Nat.card (theorem4bFixedPoints M V) - 1) ≤ 20 := by
      exact hbound.trans_eq (by simpa [Fhat] using hFhatCard)
    have hcardFixed : Nat.card (theorem4bFixedPoints M V) = 5 := by
      have hpred : Nat.card (theorem4bFixedPoints M V) - 1 + 1 =
          Nat.card (theorem4bFixedPoints M V) :=
        Nat.sub_add_cancel (by omega)
      nlinarith
    have hZprime : (Nat.card Z).Prime := by
      simpa [Z, g, Nat.card_zpowers, horder] using Nat.prime_five
    have hZcardFixed : Nat.card Z =
        Nat.card (theorem4bFixedPoints M V) := by
      rw [hcardFixed]
      simpa [Z, g, Nat.card_zpowers] using horder
    have hregular : IsRegularOn Z FixedSet :=
      lemma114_isRegularOn_zpowers_of_prime_card_eq g FixedSet alpha halpha
        hstableZ hZprime hmove hZcardFixed
    exact ⟨Or.inr horder,
      hcardFixed.trans horder.symm, by simpa [Z, g] using hregular⟩

/-- The structural recognized-model proof specialized to the Lemma 10.1 and
Proposition 10.2 packages.  The product order, fixed-set cardinality, and
regularity fields are proved internally. -/
public theorem lemma114_modelTransport_of_endpoint
    {X : Type u} [Group X] [Finite X]
    {M W : Subgroup X} {t : X}
    (hM : IsStronglyEmbedded M)
    (ht : IsInvolution t) (htM : t ∉ M)
    (d83 : Lemma83Data M t)
    (h84 : Proposition84Statement M t d83.u)
    (d : Lemma101Conclusion M W
      (M ⊓ rightConjugate M t)
      (W ⊓ (M ⊓ rightConjugate M t))
      (peterfalviV (M ⊓ rightConjugate M t) t) t)
    (h84support : Proposition84ModelSupportStatement M t d83.u)
    (h102 : Proposition102Conclusion M W
      (M ⊓ rightConjugate M t)
      (W ⊓ (M ⊓ rightConjugate M t)) t d)
    (c85 : Corollary85Conclusion M t d83.u
      d.choice.initial.A1 d.choice.P) :
    Lemma114ModelTransport M
      (peterfalviV (M ⊓ rightConjugate M t) t)
      d.choice.initial.A1 d.choice.P t d83.u := by
  let D : Subgroup X := M ⊓ rightConjugate M t
  let V : Subgroup X := peterfalviV D t
  obtain ⟨supported⟩ := lemma114_corollary85Supported_A1
    hM ht htM d83
    h84
    d
  let root := supported.fixedRoot
  have hAV : d.choice.initial.A1 ≤ V := by
    dsimp [V, D]
    rw [d.choice.initial.A1_eq]
    exact inf_le_left
  have hVu : V ≤ Subgroup.centralizer ({d83.u} : Set X) := by
    have hVeq : V = D ⊓ Subgroup.centralizer ({d83.u} : Set X) := by
      simpa [V, D, peterfalviV] using d83.centralizer_eq
    rw [hVeq]
    exact inf_le_right
  have hfixed := lemma114_fixed_D_inf_residual_A1_le_center d h102
  have hVleN : V ≤ normalizerIn M d.choice.initial.A1 := by
    have hA1V : d.choice.initial.A1 ≤ V := hAV
    have hVnormA : V ≤ Subgroup.normalizer
        (d.choice.initial.A1 : Set X) := by
      letI : (d.choice.initial.A1.subgroupOf V).Normal :=
        d.choice.initial.A1_normal_V
      exact Subgroup.le_normalizer_of_normal_subgroupOf hA1V
    exact fun x hx => ⟨
      (show V ≤ M from by
        dsimp [V, D, peterfalviV]
        exact inf_le_left.trans inf_le_left) hx,
      hVnormA hx⟩
  have hVnormS : V ≤ Subgroup.normalizer (root.S : Set X) := by
    letI : (root.S.subgroupOf (normalizerIn M d.choice.initial.A1)).Normal :=
      root.S_normal
    exact hVleN.trans
      (Subgroup.le_normalizer_of_normal_subgroupOf root.S_le_normalizer)
  have hfixedRootCard := lemma114_fixedPoints_punctured_card_of_root
    (Y := d.choice.initial.A1) (P := d.choice.P) (V := V)
    root ht htM hAV
    hVnormS
    d.V_eq_mul
    (by
      dsimp [V, D, peterfalviV]
      exact inf_le_left.trans inf_le_left)
    (by
      dsimp [V, D, peterfalviV]
      exact inf_le_left.trans inf_le_right)
  have hsupport := lemma114_modelSupport_A1 d83 h84support d
  have htF : t ∈ lemma114FZero d.choice.initial.A1 :=
    lemma114_t_mem_residual_A1 ht hAV
  have hquotient :=
    lemma114_quotient_model_psl_or_suzuki
      ht htM c85 hsupport htF hfixed
  have hmodel0 :=
    lemma114_model_psl_or_suzuki_of_quotient c85 hquotient
  let A : Subgroup X := d.choice.initial.A1
  let P : Subgroup X := d.choice.P
  let Fhat : Subgroup X := lemma114FHat V
  let FixedSet : Set (conjugateCosetSpace M) :=
    fixedPointsOfSubgroup X (conjugateCosetSpace M) V
  let alpha : conjugateCosetSpace M := QuotientGroup.mk 1
  let beta : conjugateCosetSpace M := QuotientGroup.mk t
  have hVmul : (V : Set X) = (A : Set X) * (P : Set X) := by
    simpa [A, P, V, D] using d.V_eq_mul
  have hPV : P ≤ V := by
    intro p hp
    change p ∈ (V : Set X)
    rw [hVmul]
    exact Set.mem_mul.mpr ⟨1, A.one_mem, p, hp, by simp⟩
  have hPnormS : P ≤ Subgroup.normalizer (root.S : Set X) :=
    hPV.trans hVnormS
  have hcoreZero : twoPrimeCore (lemma114FZero d.choice.initial.A1) = ⊥ :=
    lemma114_twoPrimeCore_eq_bot_of_quotient_model c85
      (by simpa [A, P] using hquotient)
  have hcore : twoPrimeCore
      (centralizerTwoPrimeResidual d.choice.initial.A1) = ⊥ := by
    change twoPrimeCore (centralizerTwoPrimeResidual d.choice.initial.A1) = ⊥ at hcoreZero
    exact hcoreZero
  have hBorel := lemma114_borel_of_core_eq_bot hsupport hcore
  have hVeq :
      V = D ⊓ Subgroup.centralizer ({d83.u} : Set X) := by
    simpa [V, D, peterfalviV] using d83.centralizer_eq
  have hVM : V ≤ M := by
    dsimp [V, D, peterfalviV]
    exact inf_le_left.trans inf_le_left
  have hVright : V ≤ rightConjugate M t := by
    dsimp [V, D, peterfalviV]
    exact inf_le_left.trans inf_le_right
  have hAVA : A ≤ V := by
    simpa [A] using hAV
  have hAne : A ≠ ⊥ := by
    simpa [A] using d.choice.initial.A1_ne_bot
  have hAnormal : (A.subgroupOf V).Normal := by
    simpa [A, V, D] using d.choice.initial.A1_normal_V
  have hI : HasNontrivialPeterfalviNormalizer D t A := by
    obtain ⟨j, hjI, hjCY, hjne⟩ := d.choice.Y_nontrivial_centralizer
    have hjJ : j ∈ d.choice.initial.J := by
      change j ∈ (d.choice.initial.J : Set X)
      rw [d.choice.initial.J_eq_centralizer]
      exact ⟨hjI, hjCY⟩
    have hjCA : j ∈ Subgroup.centralizer (A : Set X) := by
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      dsimp [A] at ha
      rw [d.choice.initial.A1_eq] at ha
      exact (Subgroup.mem_centralizer_iff.mp ha.2 j hjJ).symm
    exact ⟨j, by simpa [D] using hjI,
      centralizer_le_normalizer A hjCA, hjne⟩
  have h84V : Proposition84Conclusion M t d83.u V := by
    exact h84 V A
      (by simpa [D] using le_of_eq hVeq)
      hAne hAVA hAnormal.isSubnormal hI
  have htwo : IsTwoTransitiveOn Fhat FixedSet := by
    simpa [Fhat, FixedSet, V, lemma114FHat] using h84V.1.1
  have halpha : alpha ∈ FixedSet := by
    simpa [alpha, FixedSet] using theorem4b_baseCoset_mem_fixedPoints hVM
  have hbeta : beta ∈ FixedSet := by
    intro v hv
    apply MulAction.mem_stabilizer_iff.mp
    rw [conjugateCoset_stabilizer M t, ht.inv_eq_self]
    exact hVright hv
  have hab : alpha ≠ beta := by
    intro h
    apply htM
    simpa [alpha, beta] using QuotientGroup.eq.mp h
  have hFhatC : Fhat ≤ Subgroup.centralizer (V : Set X) := by
    simpa [Fhat, lemma114FHat] using
      centralizerTwoPrimeResidual_le_ambientCentralizer V
  have hstable : ∀ (f : Fhat) (omega : conjugateCosetSpace M),
      omega ∈ FixedSet → (f : X) • omega ∈ FixedSet := by
    intro f omega homega
    exact smul_mem_fixedPointsOfSubgroup_of_mem_centralizer
      (hFhatC f.property) homega
  let Fixed := theorem4bFixedPoints M V
  let fixedAction : MulAction Fhat Fixed :=
    { smul := fun f omega =>
      ⟨(f : X) • (omega : conjugateCosetSpace M),
        hstable f omega omega.property⟩
      one_smul := by
        intro omega
        apply Subtype.ext
        change (1 : X) • (omega : conjugateCosetSpace M) =
          (omega : conjugateCosetSpace M)
        simp
      mul_smul := by
        intro f g omega
        apply Subtype.ext
        change ((f : X) * (g : X)) •
            (omega : conjugateCosetSpace M) =
          (f : X) • ((g : X) • (omega : conjugateCosetSpace M))
        rw [mul_smul] }
  letI : MulAction Fhat Fixed := fixedAction
  have htwoFixed :
      MulAction.IsMultiplyPretransitive Fhat Fixed 2 := by
    rw [MulAction.is_two_pretransitive_iff]
    intro a b c d hab hcd
    obtain ⟨f, hfac, hfbd⟩ :=
      htwo a.property b.property c.property d.property
        (fun h ↦ hab (Subtype.ext h))
        (fun h ↦ hcd (Subtype.ext h))
    exact ⟨f, Subtype.ext hfac, Subtype.ext hfbd⟩
  let alphaFixed : Fixed := ⟨alpha, halpha⟩
  let betaFixed : Fixed := ⟨beta, hbeta⟩
  have habFixed : alphaFixed ≠ betaFixed :=
    fun h ↦ hab (congrArg Subtype.val h)
  have halphaStab : MulAction.stabilizer X alpha = M := by
    dsimp [alpha]
    exact baseCoset_stabilizer M
  have hmodel : Lemma114RecognizedModels V
      d.choice.initial.A1 d.choice.P := by
    rcases hmodel0 with ⟨⟨e0⟩⟩ | ⟨m, hPcard, ⟨e0⟩⟩
    · let hm :=
        IsSimpleBenderGroupAtExponent.isPSL2
          (G := lemma114FZero A) ⟨e0⟩
      have hfactor := lemma114_borel_factorization_of_card root
        c85.card_P_prime.pos
        hBorel
        (hm.toIsSimpleBenderGroup c85.card_P_prime.two_le)
        (hm.isPerfect c85.card_P_prime.two_le)
        (lemma114_psl_expected_borel_card root
          c85.card_P_prime.two_le e0)
      have hFhatInf := lemma114_FHat_inf_M_eq_root_fixed root
        c85.card_P_prime.two_le hAVA hPV hPV hPnormS hVmul
        hfactor
        (by simpa [D, P] using d.choice.P_fixedPointFree)
      have hrootFixed := lemma114_psl_fixedSylow_card_ambient
        root (Nat.card P)
        (by simpa [P] using c85.card_P_prime.ne_zero) e0
      have hFhatInfCard :
          Nat.card (Fhat ⊓ M : Subgroup X) = 2 := by
        rw [show Fhat ⊓ M =
            root.S ⊓ Subgroup.centralizer (P : Set X) by
          simpa [Fhat] using hFhatInf]
        exact hrootFixed
      have hPunctCard :
          Nat.card {omega : conjugateCosetSpace M //
            omega ∈ FixedSet ∧ omega ≠ alpha} = 2 := by
        calc
          Nat.card {omega : conjugateCosetSpace M //
              omega ∈ FixedSet ∧ omega ≠ alpha} =
              Nat.card
                (root.S ⊓ Subgroup.centralizer (P : Set X) :
                  Subgroup X) := by
            symm
            simpa [P, FixedSet, alpha] using hfixedRootCard
          _ = 2 := hrootFixed
      have hFixedSetCard :
          Nat.card {omega : conjugateCosetSpace M //
            omega ∈ FixedSet} = 3 := by
        have hcard :=
          lemma114_card_fixed_eq_punct_add_one FixedSet alpha halpha
        rw [hPunctCard] at hcard
        norm_num at hcard ⊢
        exact hcard
      have hFixedCard : Nat.card Fixed = 3 := by
        change Nat.card {omega : conjugateCosetSpace M // omega ∈ FixedSet} = 3
        exact hFixedSetCard
      have hFhatCard : Nat.card Fhat = 6 := by
        have hcard := lemma114_card_eq_fixed_mul_inf_stabilizer
          Fhat M FixedSet htwo hstable alpha beta halpha hbeta hab
          halphaStab
        rw [hFixedSetCard, hFhatInfCard] at hcard
        norm_num at hcard ⊢
        exact hcard
      obtain ⟨eHat⟩ := lemma114_equiv_psl2BinaryOne_of_sharp_action
        htwoFixed alphaFixed betaFixed habFixed hFixedCard hFhatCard
      let eCore0 :=
        lemma114_FCore_equiv_involutionCore_of_equiv V eHat
      let eCore : lemma114FCore V ≃* PSL2BinaryMatrixGroup 1 :=
        eCore0.trans
          ((MulEquiv.subgroupCongr
            lemma114_psl2BinaryOne_involutionCore_eq_top).trans
            Subgroup.topEquiv)
      exact Or.inl ⟨⟨e0⟩, ⟨eHat⟩, ⟨eCore⟩⟩
    · have hmpos : 0 < m := by
        have htwo := c85.card_P_prime.two_le
        rw [hPcard] at htwo
        omega
      let hm :=
        IsSimpleBenderGroupAtExponent.isSuzuki
          (G := lemma114FZero A) (n := Nat.card P)
          ⟨m, by simpa [P] using hPcard, ⟨e0⟩⟩
      have hfactor := lemma114_borel_factorization_of_card root
        c85.card_P_prime.pos
        hBorel
        (hm.toIsSimpleBenderGroup c85.card_P_prime.two_le)
        (hm.isPerfect c85.card_P_prime.two_le)
        (lemma114_suzuki_expected_borel_card root
          hsupport hcore
          m hmpos e0 (by simpa [P] using hPcard))
      have hFhatInf := lemma114_FHat_inf_M_eq_root_fixed root
        c85.card_P_prime.two_le hAVA hPV hPV hPnormS hVmul
        hfactor
        (by simpa [D, P] using d.choice.P_fixedPointFree)
      have hcentralizerRank :
          ¬ TwoRankAtLeastTwo (Subgroup.centralizer (P : Set X)) := by
        intro h
        apply d.not_twoRankAtLeastTwo_normalizer hM ht htM d83
        exact h.map_of_injective
          (Subgroup.inclusion (centralizer_le_normalizer P))
          (Subgroup.inclusion_injective (centralizer_le_normalizer P))
      have hrootFixed := lemma114_suzuki_fixedSylow_card_ambient
        root hsupport hcore
        m hmpos e0 (by simpa [P] using hPcard)
        (by simpa [P] using c85.card_P_prime)
        hPnormS hcentralizerRank
      have hFhatInfCard :
          Nat.card (Fhat ⊓ M : Subgroup X) = 4 := by
        rw [show Fhat ⊓ M =
            root.S ⊓ Subgroup.centralizer (P : Set X) by
          simpa [Fhat] using hFhatInf]
        exact hrootFixed
      have hPunctCard :
          Nat.card {omega : conjugateCosetSpace M //
            omega ∈ FixedSet ∧ omega ≠ alpha} = 4 := by
        calc
          Nat.card {omega : conjugateCosetSpace M //
              omega ∈ FixedSet ∧ omega ≠ alpha} =
              Nat.card
                (root.S ⊓ Subgroup.centralizer (P : Set X) :
                  Subgroup X) := by
            symm
            simpa [P, FixedSet, alpha] using hfixedRootCard
          _ = 4 := hrootFixed
      have hFixedSetCard :
          Nat.card {omega : conjugateCosetSpace M //
            omega ∈ FixedSet} = 5 := by
        have hcard :=
          lemma114_card_fixed_eq_punct_add_one FixedSet alpha halpha
        rw [hPunctCard] at hcard
        norm_num at hcard ⊢
        exact hcard
      have hFixedCard : Nat.card Fixed = 5 := by
        change Nat.card {omega : conjugateCosetSpace M // omega ∈ FixedSet} = 5
        exact hFixedSetCard
