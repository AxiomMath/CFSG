    have hcard : Nat.card R = Nat.card Rc := Nat.card_congr eConj.toEquiv
    rwa [← hcard]
  have hTcOdd : Odd (Nat.card Tc) := by
    have hcard : Nat.card Rc = Nat.card Tc := Nat.card_congr eTc.toEquiv
    rwa [← hcard]
  have hTcCyclic : IsCyclic Tc :=
    lemma114_suzuki_standardBorel_oddSubgroup_isCyclic m hm Tc hTcOdd
  have hRcCyclic : IsCyclic Rc := eTc.isCyclic.mpr hTcCyclic
  exact eConj.isCyclic.mpr hRcCyclic

/-- Every odd Sylow subgroup of a binary Suzuki matrix group is cyclic. -/
public theorem lemma114_suzuki_oddSylow_isCyclic
    (m r : ℕ) (hr : r.Prime) (hrne2 : r ≠ 2)
    (R : Sylow r (SuzukiMatrixGroup m)) :
    IsCyclic R := by
  letI : Fact r.Prime := ⟨hr⟩
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · by_cases hr20 : r ∣ 20
    · have hrprod : r ∣ 2 ^ 2 * 5 := by
        norm_num at hr20 ⊢
        exact hr20
      rcases hr.dvd_mul.mp hrprod with hrpow | hrfive
      · have hrtwo : r ∣ 2 := hr.dvd_of_dvd_pow hrpow
        rcases (Nat.dvd_prime Nat.prime_two).mp hrtwo with hrone | hrtwoeq
        · exact False.elim (hr.ne_one hrone)
        · exact False.elim (hrne2 hrtwoeq)
      · rcases (Nat.dvd_prime Nat.prime_five).mp hrfive with hrone | hrfiveeq
        · exact False.elim (hr.ne_one hrone)
        · subst r
          apply isCyclic_of_prime_card (p := 5)
          rw [Sylow.card_eq_multiplicity, lemma114_suzukiZero_card]
          rw [Nat.factorization_def _ Nat.prime_five]
          rw [show 20 = 2 ^ 2 * 5 ^ 1 by norm_num,
            padicValNat_mul_pow_right (p := 2) (q := 5) 2 1
              (by norm_num : 5 ≠ 2)]
          norm_num
    · have hRcard : Nat.card R = 1 := by
        rcases R.isPGroup'.card_eq_or_dvd with hcard | hrR
        · exact hcard
        · exfalso
          apply hr20
          exact hrR.trans (by
            simpa [lemma114_suzukiZero_card] using R.card_subgroup_dvd_card)
      letI : Subsingleton R := (Nat.card_eq_one_iff_unique.mp hRcard).1
      exact isCyclic_of_subsingleton
  · by_cases hRbot : (R : Subgroup (SuzukiMatrixGroup m)) = ⊥
    · have hRcard : Nat.card R = 1 := by
        rw [show Nat.card R =
            Nat.card (R : Subgroup (SuzukiMatrixGroup m)) by rfl,
          hRbot, Subgroup.card_bot]
      letI : Subsingleton R := (Nat.card_eq_one_iff_unique.mp hRcard).1
      exact isCyclic_of_subsingleton
    · have hRcardne : Nat.card R ≠ 1 := by
        intro hcard
        exact hRbot (Subgroup.card_eq_one.mp hcard)
      have hrR : r ∣ Nat.card R :=
        R.isPGroup'.card_eq_or_dvd.resolve_left hRcardne
      have hrG : r ∣ Nat.card (SuzukiMatrixGroup m) :=
        hrR.trans R.card_subgroup_dvd_card
      let K := BinaryGaloisField (2 * m + 1)
      let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
      have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) := by
        intro x
        exact iterateFrobeniusEquiv_def K 2 (m + 1) x
      rcases External.huppert_blackburn_XI_3_3 m hm pi hpi with
        ⟨_hpres, _hrecognition, _hfaithful, _htwo, _hthree,
          _hOcard, hGcard, _hstabilizer⟩
      let q := 2 ^ (2 * m + 1)
      have hGcard' : Nat.card (SuzukiMatrixGroup m) =
          (q ^ 2 + 1) * q ^ 2 * (q - 1) := by
        simpa [q] using hGcard
      have hrprod : r ∣ (q ^ 2 + 1) * q ^ 2 * (q - 1) := by
        rw [← hGcard']
        exact hrG
      rcases hr.dvd_mul.mp hrprod with hrleft | hrsplit
      · rcases hr.dvd_mul.mp hrleft with hrnonsplit | hrqsq
        · exact lemma114_suzuki_nonsplit_oddSylow_isCyclic
            m r hr hrne2 R hrnonsplit hrG
        · have hrq : r ∣ q := hr.dvd_of_dvd_pow hrqsq
          have hrtwo : r ∣ 2 := by
            apply hr.dvd_of_dvd_pow
            simpa [q] using hrq
          exfalso
          rcases (Nat.dvd_prime Nat.prime_two).mp hrtwo with hrone | hrtwoeq
          · exact hr.ne_one hrone
          · exact hrne2 hrtwoeq
      · exact lemma114_suzuki_split_oddSylow_isCyclic
          m r hm hr hrne2 R hrsplit

/-- Odd Sylow cyclicity transported from a binary Suzuki matrix model. -/
public theorem lemma114_suzuki_oddSylow_isCyclic_of_equiv
    {E : Type*} [Group E] [Finite E] {m : ℕ}
    (e : E ≃* SuzukiMatrixGroup m) :
    ∀ r [Fact r.Prime], r ≠ 2 →
      ∀ R : Sylow r E, IsCyclic R := by
  intro r hrFact hrne R
  let Rbar : Sylow r (SuzukiMatrixGroup m) :=
    Sylow.mapSurjective (f := e.toMonoidHom) e.surjective R
  have hbar : IsCyclic Rbar :=
    lemma114_suzuki_oddSylow_isCyclic m r hrFact.out hrne Rbar
  have hmap : (Rbar : Subgroup (SuzukiMatrixGroup m)) =
      (R : Subgroup E).map e.toMonoidHom := by
    exact Sylow.coe_mapSurjective (f := e.toMonoidHom) e.surjective R
  have hmapcyc : IsCyclic ((R : Subgroup E).map e.toMonoidHom) := by
    change IsCyclic (Rbar : Subgroup (SuzukiMatrixGroup m)) at hbar
    rw [hmap] at hbar
    exact hbar
  exact (e.subgroupMap (R : Subgroup E)).isCyclic.mpr hmapcyc

