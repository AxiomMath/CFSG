/-- If the Mersenne factor in Proposition 10.2(c) is prime, it is the
selected prime, and the anti-fixed-set cardinal is a pure power of it. -/
public theorem lemma113_mersenne_prime_specialization
    {X : Type u} [Group X] [Finite X]
    {M W D E : Subgroup X} {t : X}
    (d : Lemma101Conclusion M W D E (peterfalviV D t) t)
    (e : Proposition102ExponentConclusion M W D E t d)
    (hq : Nat.Prime (2 ^ d.choice.p - 1)) :
    e.r = 2 ^ d.choice.p - 1 ∧
      Nat.card {x : X // x ∈ peterfalviKSet D t} =
        e.r ^ (e.a + 1) := by
  have hre : e.r = 2 ^ d.choice.p - 1 :=
    (Nat.prime_dvd_prime_iff_eq e.r_prime hq).mp e.r_dvd_mersenne
  refine ⟨hre, ?_⟩
  rw [e.kset_card_eq, ← hre, pow_succ]

/-- A finite subgroup all of whose support primes divide a power of one
prime is a group at that prime. -/
public theorem lemma113_isPGroup_of_prime_support
    {X : Type u} [Group X] [Finite X]
    {r n : ℕ} {H : Subgroup X}
    (hr : r.Prime)
    (hsupport : ∀ q : Nat.Primes,
      q.val ∣ Nat.card H ↔ q.val ∣ r ^ n) :
    IsPGroup r H := by
  let q : Nat.Primes := ⟨r, hr⟩
  apply isPGroup_of_isPiSubgroup_singleton (q := q)
  intro s hs
  have hsr : s.val ∣ r :=
    s.property.dvd_of_dvd_pow ((hsupport s).mp hs)
  have hsval : s.val = r :=
    (Nat.prime_dvd_prime_iff_eq s.property hr).mp hsr
  have hsq : s = q := Subtype.ext hsval
  simpa [hsq]

/-- A Hall subgroup which is an `r`-group and whose order is divisible by
`r` is an ambient Sylow `r`-subgroup. -/
public theorem lemma113_sylow_of_hall_and_support
    {X : Type u} [Group X] [Finite X]
    {r : ℕ} {H : Subgroup X}
    (hr : r.Prime)
    (hHall : IsHallSubgroup (subgroupPrimeSet H) H)
    (hHp : IsPGroup r H)
    (hrcard : r ∣ Nat.card H) :
    ∃ S : Sylow r X, (S : Subgroup X) = H := by
  letI : Fact r.Prime := ⟨hr⟩
  letI : IsHallSubgroup (subgroupPrimeSet H) H := hHall
  let q : Nat.Primes := ⟨r, hr⟩
  have hqmem : q ∈ subgroupPrimeSet H := by
    change (q : ℕ) ∣ Nat.card H
    exact hrcard
  have hnot : ¬ r ∣ H.index := by
    intro hrdvd
    exact (IsHallSubgroup.p_in_pi_of_p_dvd_index q hrdvd) hqmem
  let S : Sylow r X := hHp.toSylow hnot
  exact ⟨S, by simpa [S] using hHp.toSylow_coe hnot⟩

/-- In an odd normal-supplement factorization, the subgroup generated by
the involutions of `M` lies in the normal supplement. -/
public theorem lemma113_involutionCoreIn_le_of_normalSupplement_odd
    {X : Type u} [Group X] [Finite X]
    {M D W : Subgroup X}
    (hDle : D ≤ M) (hDodd : Odd (Nat.card D))
    (hW : IsNormalSupplement M D W) :
    involutionCoreIn M ≤ W := by
  rw [involutionCoreIn, Subgroup.map_le_iff_le_comap,
    involutionCore_eq_closure, Subgroup.closure_le]
  intro z hz
  change IsInvolution z at hz
  have hzX : IsInvolution (z : X) :=
    IsInvolution.map_of_injective hz M.subtype M.subtype_injective
  have hzpowM : Subgroup.zpowers (z : X) ≤ M :=
    Subgroup.zpowers_le.mpr z.property
  have hzpow2 : IsPGroup 2 (Subgroup.zpowers (z : X)) :=
    isPGroup_two_zpowers_of_isInvolution hzX
  have hzpowW : Subgroup.zpowers (z : X) ≤ W :=
    hW.two_subgroup_le_of_odd hDle hDodd hzpowM hzpow2
  exact hzpowW (Subgroup.mem_zpowers (z : X))

/-- Coprime action by an `r`-subgroup fixes a Sylow `2`-subgroup of the
normalized subgroup.  This is the exact invariant-Sylow step used in the
disjoint branch of Lemma 11.3. -/
public theorem lemma113_exists_invariant_sylow_two
    {X : Type u} [Group X] [Finite X]
    {r : ℕ} {C H : Subgroup X}
    (hr : r.Prime)
    (hHp : IsPGroup r H)
    (hHnormC : H ≤ Subgroup.normalizer (C : Set X))
    (hcop : Nat.Coprime r (Nat.card C)) :
    let _ : Subgroup.Normalizes H C := ⟨hHnormC⟩
    ∃ S : Sylow 2 C,
      IsInvariant H C (S : Subgroup C) := by
  letI : Fact r.Prime := ⟨hr⟩
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  letI : Subgroup.Normalizes H C := ⟨hHnormC⟩
  letI : Fact (IsPGroup r H) := ⟨hHp⟩
  exact exists_invariant_sylow_of_pgroup_operator_coprime
    (G := C) (A := H) (r := r) (p := 2) hcop

/-- If `C` is normal in `M`, `H` is a Sylow `r`-subgroup of `M`, and
`C ∩ H = 1`, then `C` has order prime to `r`.  The proof uses Sylow
conjugacy inside `M` and transports a Sylow subgroup of `C` across the
normality of `C`. -/
public theorem lemma113_coprime_card_of_normal_disjoint_sylow
    {X : Type u} [Group X] [Finite X]
    {r : ℕ} {M C H : Subgroup X}
    (hr : r.Prime)
    (hCM : C ≤ M)
    (hHM : H ≤ M)
    (hHsyl : theorem4bIsSylowSubgroupOf r H M)
    (hCnormal : (C.subgroupOf M).Normal)
    (hinf : C ⊓ H = ⊥) :
    Nat.Coprime r (Nat.card C) := by
  letI : Fact r.Prime := ⟨hr⟩
  rcases hHsyl with ⟨P, hPH⟩
  let HM : Subgroup M := H.subgroupOf M
  have hHM_eq : HM = (P : Subgroup M) := by
    apply Subgroup.map_injective M.subtype_injective
    simpa [HM, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hHM] using hPH
  let CS : Subgroup M := C.subgroupOf M
  let S : Sylow r CS := default
  obtain ⟨Q, hQS⟩ := S.exists_comap_subtype_eq
  obtain ⟨m, hm⟩ := MulAction.exists_smul_eq M Q P
  have hSbot : (S : Subgroup CS) = ⊥ := by
    apply le_antisymm
    · intro x hxS
      have hxQ : ((x : CS) : M) ∈ (Q : Subgroup M) := by
        have hxComap : (x : CS) ∈ Q.comap CS.subtype := by
          rw [hQS]
          exact hxS
        exact hxComap
      let y : M := m * ((x : CS) : M) * m⁻¹
      have hyP : y ∈ (P : Subgroup M) := by
        have hyConj : y ∈
            (MulAut.conj m) • (Q : Subgroup M) := by
          exact Subgroup.smul_mem_pointwise_smul
            ((x : CS) : M) (MulAut.conj m) (Q : Subgroup M) hxQ
        have heq : (MulAut.conj m) • (Q : Subgroup M) =
            (P : Subgroup M) := by
          rw [← Sylow.coe_subgroup_smul, hm]
        rw [heq] at hyConj
        exact hyConj
      have hxCS : ((x : CS) : M) ∈ CS := x.property
      have hyCS : y ∈ CS := by
        simpa [y] using
          hCnormal.conj_mem ((x : CS) : M) hxCS m
      have hyHM : y ∈ HM := by
        rw [hHM_eq]
        exact hyP
      have hyC : ((y : M) : X) ∈ C := by
        exact hyCS
      have hyH : ((y : M) : X) ∈ H := by
        exact hyHM
      have hyInf : ((y : M) : X) ∈ C ⊓ H := ⟨hyC, hyH⟩
      have hyOneX : ((y : M) : X) = 1 := by
        simpa [hinf] using hyInf
      have hyOneM : y = 1 := Subtype.ext hyOneX
      have hxOneM : ((x : CS) : M) = 1 := by
        calc
          ((x : CS) : M) = m⁻¹ * y * m := by simp [y, mul_assoc]
          _ = 1 := by rw [hyOneM]; simp
      have hxOneCS : (x : CS) = 1 := Subtype.ext hxOneM
      exact hxOneCS
    · exact bot_le
  apply hr.coprime_iff_not_dvd.mpr
  intro hrdvdC
  have hrdvdCS : r ∣ Nat.card CS := by
    simpa [CS, natCard_subgroupOf_eq C M hCM] using hrdvdC
  have hSne : (S : Subgroup CS) ≠ ⊥ :=
    S.ne_bot_of_dvd_card hrdvdCS
  exact hSne hSbot

/-- The intersection of a Sylow subgroup of `M` with a normal subgroup `C`
is Sylow in `C`, in the ambient-subgroup encoding used by Section 11. -/
public theorem lemma113_intersection_isSylow_of_normal
    {X : Type u} [Group X] [Finite X]
    {r : ℕ} {M C H : Subgroup X}
    (hr : r.Prime)
    (hCM : C ≤ M)
    (hHsyl : theorem4bIsSylowSubgroupOf r H M)
    (hCnormal : (C.subgroupOf M).Normal) :
    theorem4bIsSylowSubgroupOf r (C ⊓ H) C := by
  letI : Fact r.Prime := ⟨hr⟩
  rcases hHsyl with ⟨P, hPH⟩
  let CM : Subgroup M := C.subgroupOf M
  letI : CM.Normal := by simpa [CM] using hCnormal
  let T : Sylow r CM := External.hallSylowSubgroupOfNormal P CM
  let e : CM ≃* C := Subgroup.subgroupOfEquivOfLe hCM
  let S : Sylow r C :=
    T.mapSurjective (f := e.toMonoidHom) e.surjective
  refine ⟨S, ?_⟩
  calc
    C ⊓ H = H ⊓ C := by rw [inf_comm]
    _ = (P : Subgroup M).map M.subtype ⊓ C := by rw [← hPH]
    _ = (P : Subgroup M).map M.subtype ⊓ CM.map M.subtype := by
      rw [show CM.map M.subtype = C by
        simpa [CM, inf_eq_left.mpr hCM] using
          Subgroup.subgroupOf_map_subtype C M]
    _ = ((P : Subgroup M) ⊓ CM).map M.subtype := by
      symm
      exact Subgroup.map_inf _ _ _ M.subtype_injective
    _ = (((P : Subgroup M).comap CM.subtype).map CM.subtype).map
          M.subtype := by
      rw [show (P : Subgroup M).comap CM.subtype =
          (P : Subgroup M).subgroupOf CM by rfl,
        Subgroup.subgroupOf_map_subtype]
    _ = ((T : Subgroup CM).map CM.subtype).map M.subtype := by
      rw [External.hallSylowSubgroupOfNormal_coe]
    _ = (T : Subgroup CM).map (M.subtype.comp CM.subtype) := by
      rw [Subgroup.map_map]
    _ = (T : Subgroup CM).map (C.subtype.comp e.toMonoidHom) := by
      congr 1
    _ = ((T : Subgroup CM).map e.toMonoidHom).map C.subtype := by
      rw [Subgroup.map_map]
    _ = (S : Subgroup C).map C.subtype := by
      rw [show (S : Subgroup C) =
        (T : Subgroup CM).map e.toMonoidHom by
          exact Sylow.coe_mapSurjective (f := e.toMonoidHom) e.surjective T]

/-- In the nontrivial-intersection branch of Lemma 11.3, normality and the
ambient Sylow input give both the local Sylow statement and Frattini's
factorization.  Nontriviality is intentionally not needed for these two
structural conclusions. -/
public theorem lemma113_intersection_sylow_and_frattini
    {X : Type u} [Group X] [Finite X]
    {r : ℕ} {M C H : Subgroup X}
    (hr : r.Prime)
    (hCM : C ≤ M)
    (hHsyl : theorem4bIsSylowSubgroupOf r H M)
    (hCnormal : (C.subgroupOf M).Normal) :
    theorem4bIsSylowSubgroupOf r (C ⊓ H) C ∧
      C ⊔ normalizerIn M (C ⊓ H) = M := by
  letI : Fact r.Prime := ⟨hr⟩
  have hSyl := lemma113_intersection_isSylow_of_normal
    hr hCM hHsyl hCnormal
  rcases hSyl with ⟨S, hS⟩
  refine ⟨⟨S, hS⟩, ?_⟩
  exact normal_sup_normalizerIn_eq_of_sylow hCM hCnormal S hS.symm

/-- If `C` is normal in `M` and `H` is normal in `D ≤ M`, then `C ∩ H`
is normal in `D`. -/
public theorem lemma113_normal_intersection_in_D
    {X : Type u} [Group X]
    {M D C H : Subgroup X}
    (hDM : D ≤ M) (hCM : C ≤ M) (hHD : H ≤ D)
    (hCnormal : (C.subgroupOf M).Normal)
    (hHnormal : (H.subgroupOf D).Normal) :
    ((C ⊓ H).subgroupOf D).Normal := by
  have hRleD : C ⊓ H ≤ D := inf_le_right.trans hHD
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer hRleD).2
  have hDnormC : D ≤ Subgroup.normalizer (C : Set X) := by
    exact hDM.trans
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hCM).mp hCnormal)
  have hDnormH : D ≤ Subgroup.normalizer (H : Set X) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hHD).mp hHnormal
  exact (le_inf hDnormC hDnormH).trans
    Subgroup.inf_normalizer_le_normalizer_inf

/-- A `D`-normal subgroup with at least three fixed cosets lies in
`V = C_D(t)`: Lemma 8.3(b) puts a `D`-conjugate in `V`, and normality makes
that conjugate equal to the original subgroup. -/
public theorem lemma113_normal_intersection_le_V_of_three_fixed
    {X : Type u} [Group X] [Finite X]
    {M R : Subgroup X} {t : X}
    (d83 : Lemma83Data M t)
    (hRD : R ≤ M ⊓ rightConjugate M t)
    (hRnormal : (R.subgroupOf (M ⊓ rightConjugate M t)).Normal)
    (hthree : 3 ≤ Nat.card (theorem4bFixedPoints M R)) :
    R ≤ peterfalviV (M ⊓ rightConjugate M t) t := by
  obtain ⟨d, hdD, hRdV⟩ := d83.conjugate_le R hRD hthree
  have hdNormR : d ∈ Subgroup.normalizer (R : Set X) := by
    exact ((Subgroup.normal_subgroupOf_iff_le_normalizer hRD).mp hRnormal) hdD
  have hright : rightConjugate R d = R := by
    rw [rightConjugate]
    exact section11_conjBy_eq_of_mem_normalizer
      ((Subgroup.normalizer (R : Set X)).inv_mem hdNormR)
  rw [hright] at hRdV
  exact hRdV

/-- Every subgroup of the selected two-point stabilizer fixes the two base
cosets. -/
public theorem lemma113_two_le_fixedPoints_of_le_twoPointStabilizer
    {X : Type u} [Group X] [Finite X]
    {M U : Subgroup X} {t : X}
    (ht : IsInvolution t) (htM : t ∉ M)
    (hU : U ≤ M ⊓ rightConjugate M t) :
    2 ≤ Nat.card (theorem4bFixedPoints M U) := by
  let alpha : conjugateCosetSpace M := QuotientGroup.mk 1
  let beta : conjugateCosetSpace M := QuotientGroup.mk t
  have halpha : alpha ∈
      fixedPointsOfSubgroup X (conjugateCosetSpace M) U :=
    theorem4b_baseCoset_mem_fixedPoints (hU.trans inf_le_left)
  have hbeta : beta ∈
      fixedPointsOfSubgroup X (conjugateCosetSpace M) U := by
    intro x hx
    apply MulAction.mem_stabilizer_iff.mp
    rw [conjugateCoset_stabilizer M t, ht.inv_eq_self]
    exact hU.trans inf_le_right hx
  let alphaFixed : theorem4bFixedPoints M U := ⟨alpha, halpha⟩
  let betaFixed : theorem4bFixedPoints M U := ⟨beta, hbeta⟩
  have hne : alphaFixed ≠ betaFixed := by
    intro h
    apply htM
    simpa [alphaFixed, betaFixed, alpha, beta] using
      QuotientGroup.eq.mp (congrArg Subtype.val h)
  let f : Bool → theorem4bFixedPoints M U :=
    fun b => if b then betaFixed else alphaFixed
  have hf : Function.Injective f := by
    intro a b hab
    cases a <;> cases b
    · rfl
    · exact (hne (by simpa [f] using hab)).elim
    · exact (hne (by simpa [f] using hab.symm)).elim
    · rfl
  simpa using Nat.card_le_card_of_injective f hf

/-- If Lemma 9.4 gives exactly the two base fixed points, the normalizer in
`W` is contained in the two-point stabilizer `D`. -/
public theorem lemma113_normalizerIn_le_D_of_fixedPoints_card_eq_two
    {X : Type u} [Group X] [Finite X]
    {M W D U : Subgroup X} {t : X}
    (ht : IsInvolution t) (htM : t ∉ M)
    (hWM : W ≤ M)
    (hUD : U ≤ D)
    (hD : D = M ⊓ rightConjugate M t)
    (hcard : Nat.card (theorem4bFixedPoints M U) = 2) :
    normalizerIn W U ≤ D := by
  rw [hD] at hUD ⊢
  have hnorm := normalizerIn_eq_inf_of_fixedPoints_card_eq_two
    ht htM hWM hUD hcard
  intro n hn
  have hn' : n ∈ normalizerIn
      (W ⊓ (M ⊓ rightConjugate M t)) U := by
    rw [← hnorm]
    exact hn
  exact hn'.1.2

/-- If `R` is normal in `D` and lies in `C_D(t)`, then the action
commutator `[D, ⟨t⟩]` centralizes `R`.  This is the explicit
three-subgroups argument behind the corresponding source step in Lemma 11.3. -/
public theorem lemma113_commutator_zpowers_le_centralizer_of_normal_le_V
    {X : Type u} [Group X]
    {D R : Subgroup X} {t : X}
    (hRleD : R ≤ D)
    (hRnormal : (R.subgroupOf D).Normal)
    (hRV : R ≤ peterfalviV D t) :
    ⁅D, Subgroup.zpowers t⁆ ≤ Subgroup.centralizer (R : Set X) := by
  have htcentR : t ∈ Subgroup.centralizer (R : Set X) := by
    rw [Subgroup.mem_centralizer_iff]
    intro r hr
    exact (Subgroup.mem_centralizer_iff.mp (hRV hr).2 t (by simp)).symm
  have hzpcentR : Subgroup.zpowers t ≤
      Subgroup.centralizer (R : Set X) :=
    Subgroup.zpowers_le.mpr htcentR
  have hzpR : ⁅Subgroup.zpowers t, R⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hzpcentR
  have hDnormR : D ≤ Subgroup.normalizer (R : Set X) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hRleD).mp hRnormal
  have hRDle : ⁅R, D⁆ ≤ R :=
    section12_commutator_le_left_of_le_normalizer_pre hDnormR
  have hRcentzp : R ≤
      Subgroup.centralizer (Subgroup.zpowers t : Set X) :=
    Subgroup.le_centralizer_iff.mp hzpcentR
  have hRDzp : ⁅⁅R, D⁆, Subgroup.zpowers t⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      (hRDle.trans hRcentzp)
  have hcomm : ⁅⁅D, Subgroup.zpowers t⁆, R⁆ = ⊥ :=
    Subgroup.commutator_commutator_eq_bot_of_rotate
      (by rw [hzpR]; simp) hRDzp
  exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm

/-- The nontrivial-intersection branch of Lemma 11.3 cannot have at least
three fixed points: normality makes the Peterfalvi commutator centralize `R`,
while the Proposition 10.2 fixed-point-free conclusion forces `R = 1`. -/
public theorem lemma113_normal_le_V_eq_bot_of_peterfalvi_fixedPointFree
    {X : Type u} [Group X] [Finite X]
    {D R : Subgroup X} {t : X}
    (ht : IsInvolution t)
    (hDnorm : t ∈ Subgroup.normalizer (D : Set X))
    (hDodd : Odd (Nat.card D))
    (hRleD : R ≤ D)
    (hRnormal : (R.subgroupOf D).Normal)
    (hRV : R ≤ peterfalviV D t)
    (hVC : peterfalviV D t ⊓
      Subgroup.centralizer (peterfalviKSet D t) = ⊥) :
    R = ⊥ := by
  have hclosureCentR : Subgroup.closure (peterfalviKSet D t) ≤
      Subgroup.centralizer (R : Set X) := by
    rw [closure_peterfalviKSet_eq_commutator_zpowers ht hDnorm hDodd]
    exact lemma113_commutator_zpowers_le_centralizer_of_normal_le_V
      hRleD hRnormal hRV
  have hRcentClosure : R ≤
      Subgroup.centralizer
        (Subgroup.closure (peterfalviKSet D t) : Set X) :=
    Subgroup.le_centralizer_iff.mp hclosureCentR
  have hRcentK : R ≤ Subgroup.centralizer (peterfalviKSet D t) :=
    hRcentClosure.trans (Subgroup.centralizer_le Subgroup.subset_closure)
  apply le_bot_iff.mp
  rw [← hVC]
  exact le_inf hRV hRcentK

/-- In the nontrivial normal-intersection branch, the fixed-point set has
exactly the two base points.  Three fixed points would put `R` in `V`, and
the preceding centralization argument would then force `R = 1`. -/
public theorem lemma113_fixedPoints_card_eq_two_of_normal_fixedPointFree
    {X : Type u} [Group X] [Finite X]
    {M R : Subgroup X} {t : X}
    (ht : IsInvolution t) (htM : t ∉ M)
    (d83 : Lemma83Data M t)
    (hDodd : Odd (Nat.card (M ⊓ rightConjugate M t : Subgroup X)))
    (hDnorm : t ∈ Subgroup.normalizer
      ((M ⊓ rightConjugate M t : Subgroup X) : Set X))
    (hRleD : R ≤ M ⊓ rightConjugate M t)
    (hRnormal :
      (R.subgroupOf (M ⊓ rightConjugate M t)).Normal)
    (hRne : R ≠ ⊥)
    (hVC : peterfalviV (M ⊓ rightConjugate M t) t ⊓
      Subgroup.centralizer
        (peterfalviKSet (M ⊓ rightConjugate M t) t) = ⊥) :
    Nat.card (theorem4bFixedPoints M R) = 2 := by
  have htwo : 2 ≤ Nat.card (theorem4bFixedPoints M R) :=
    lemma113_two_le_fixedPoints_of_le_twoPointStabilizer ht htM hRleD
  by_contra hne
  have hthree : 3 ≤ Nat.card (theorem4bFixedPoints M R) := by omega
  have hRV : R ≤ peterfalviV (M ⊓ rightConjugate M t) t :=
    lemma113_normal_intersection_le_V_of_three_fixed
      d83 hRleD hRnormal hthree
  exact hRne (lemma113_normal_le_V_eq_bot_of_peterfalvi_fixedPointFree
    ht hDnorm hDodd hRleD hRnormal hRV hVC)

/-- Minimality of the chosen normal supplement identifies the involution core
once Frattini has reduced its normalizer to the odd two-point stabilizer. -/
public theorem lemma113_involutionCoreIn_eq_minimalSupplement_of_normalizer_le
    {X : Type u} [Group X] [Finite X]
    {M D W R : Subgroup X}
    (hDle : D ≤ M) (hDodd : Odd (Nat.card D))
    (hW : IsMinimalNormalSupplement M D W)
    (hfrattini : involutionCoreIn M ⊔ normalizerIn M R = M)
    (hnorm : normalizerIn M R ≤ D) :
    involutionCoreIn M = W := by
  let C : Subgroup X := involutionCoreIn M
  have hCleM : C ≤ M := by
    intro x hx
    change x ∈ involutionCoreIn M at hx
    rw [involutionCoreIn, Subgroup.mem_map] at hx
    rcases hx with ⟨y, _hy, rfl⟩
    exact y.property
  have hCnormal : (C.subgroupOf M).Normal := by
    dsimp [C]
    rw [involutionCoreIn, subgroupOf_map_subtype_eq]
    exact involutionCore_normal
  have hCD : C ⊔ D = M := by
    apply le_antisymm
    · exact sup_le hCleM hDle
    · rw [← hfrattini]
      exact sup_le_sup le_rfl hnorm
  have hC : IsNormalSupplement M D C :=
    { le_M := hCleM
      normal_in_M := hCnormal
      sup_eq := hCD }
  have hCW : C ≤ W := by
    simpa [C] using
      lemma113_involutionCoreIn_le_of_normalSupplement_odd
        hDle hDodd hW.prop
  simpa [C] using hW.eq_of_le hC hCW

/-- Complete nonzero-intersection branch of Lemma 11.3.  For
`R = M° ∩ H`, normal Sylow intersection and Frattini give
`M = M° N_M(R)`; the fixed-point-free argument forces exactly two fixed
points, so `N_M(R) ≤ D`, and minimality then gives `M° = W`. -/
public theorem lemma113_involutionCoreIn_eq_W_of_nontrivial_intersection
    {X : Type u} [Group X] [Finite X]
    {r : ℕ} {M W D H : Subgroup X} {t : X}
    (hr : r.Prime)
    (ht : IsInvolution t) (htM : t ∉ M)
    (d83 : Lemma83Data M t)
    (hD : D = M ⊓ rightConjugate M t)
    (hDodd : Odd (Nat.card D))
    (hDnorm : t ∈ Subgroup.normalizer (D : Set X))
    (hW : IsMinimalNormalSupplement M D W)
    (hHD : H ≤ D)
    (hHsyl : theorem4bIsSylowSubgroupOf r H M)
    (hHnormal : (H.subgroupOf D).Normal)
    (hRne : involutionCoreIn M ⊓ H ≠ ⊥)
    (hVC : peterfalviV D t ⊓
      Subgroup.centralizer (peterfalviKSet D t) = ⊥) :
    involutionCoreIn M = W := by
  subst D
  let C : Subgroup X := involutionCoreIn M
  let R : Subgroup X := C ⊓ H
  have hCleM : C ≤ M := by
    intro x hx
    change x ∈ involutionCoreIn M at hx
    rw [involutionCoreIn, Subgroup.mem_map] at hx
    rcases hx with ⟨y, _hy, rfl⟩
    exact y.property
  have hCnormal : (C.subgroupOf M).Normal := by
    dsimp [C]
    rw [involutionCoreIn, subgroupOf_map_subtype_eq]
    exact involutionCore_normal
  have hfrattini : C ⊔ normalizerIn M R = M :=
    (lemma113_intersection_sylow_and_frattini
      hr hCleM hHsyl hCnormal).2
  have hRleD : R ≤ M ⊓ rightConjugate M t :=
    inf_le_right.trans hHD
  have hRnormal :
      (R.subgroupOf (M ⊓ rightConjugate M t)).Normal :=
    lemma113_normal_intersection_in_D
      inf_le_left hCleM hHD hCnormal hHnormal
  have hRne' : R ≠ ⊥ := by simpa [R, C] using hRne
  have hcard : Nat.card (theorem4bFixedPoints M R) = 2 :=
    lemma113_fixedPoints_card_eq_two_of_normal_fixedPointFree
      ht htM d83 hDodd hDnorm hRleD hRnormal hRne' hVC
  have hnormM : normalizerIn M R ≤ M ⊓ rightConjugate M t :=
    lemma113_normalizerIn_le_D_of_fixedPoints_card_eq_two
      ht htM le_rfl hRleD rfl hcard
  exact lemma113_involutionCoreIn_eq_minimalSupplement_of_normalizer_le
    inf_le_left hDodd hW (by simpa [C, R] using hfrattini) hnormM

end CFSG.BenderSuzuki
