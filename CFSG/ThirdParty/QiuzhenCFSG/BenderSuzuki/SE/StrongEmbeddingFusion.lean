module


public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.ConjugateAction

namespace CFSG
end CFSG
open CFSG

/-!
# Involution fusion and unique fixed points

This file isolates the fusion contract used by the action-theoretic arguments,
proves it from the source-faithful strong-embedding criterion `[IG; 17.11(ii)]`,
and retains conditional versions of the downstream theorems for reuse.  No
source theorem is hidden behind an axiom or placeholder.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1

universe u

/-- A subgroup controls fusion of ambient-conjugate involutions that lie in it. -/
public def ControlsInvolutionFusion {X : Type u} [Group X]
    (M : Subgroup X) : Prop :=
  ∀ {a b : X}, a ∈ M → b ∈ M → IsInvolution a →
    ∀ {g : X}, rightConjugateElem a g = b →
      ∃ m : X, m ∈ M ∧ rightConjugateElem a m = b

/-- Apply involution fusion control without unfolding its private-by-default
definition in downstream modules. -/
public theorem ControlsInvolutionFusion.exists_conjugator
    {X : Type u} [Group X] {M : Subgroup X}
    (hfusion : ControlsInvolutionFusion M)
    {a b : X} (haM : a ∈ M) (hbM : b ∈ M)
    (ha : IsInvolution a) {g : X}
    (hab : rightConjugateElem a g = b) :
    ∃ m : X, m ∈ M ∧ rightConjugateElem a m = b := by
  exact hfusion haM hbM ha hab

/-- A point is fixed by the cyclic subgroup generated by `x` exactly when it
is fixed by `x`. -/
public theorem mem_fixedPointsOfSubgroup_zpowers_iff
    {X Ω : Type*} [Group X] [MulAction X Ω] {x : X} {ω : Ω} :
    ω ∈ fixedPointsOfSubgroup X Ω (Subgroup.zpowers x) ↔ x • ω = ω := by
  constructor
  · intro h
    exact h x (Subgroup.mem_zpowers x)
  · intro hx y hy
    have hxstab : x ∈ MulAction.stabilizer X ω :=
      MulAction.mem_stabilizer_iff.mpr hx
    exact MulAction.mem_stabilizer_iff.mp
      ((Subgroup.zpowers_le.mpr hxstab) hy)

namespace IsStronglyEmbedded

/-- A strongly embedded subgroup controls fusion of ambient-conjugate
involutions lying in it. -/
public theorem involution_fusion_control
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) :
    ControlsInvolutionFusion M := by
  intro a b haM hbM ha g hab
  have hbconj : b ∈ rightConjugate M g := by
    rw [← hab]
    exact rightConjugateElem_mem_rightConjugate haM
  have hgM : g ∈ M :=
    hM.mem_of_involution_mem_rightConjugate hbM hbconj
      (hab ▸ isInvolution_rightConjugateElem ha)
  exact ⟨g, hgM, hab⟩

/-- Assuming involution fusion control, every involution fixes a unique point
of the conjugate coset action. -/
public theorem involution_fixed_coset_unique_of_controlsInvolutionFusion
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) (hfusion : ControlsInvolutionFusion M)
    {x : X} (hx : IsInvolution x) :
    ∃! ω : conjugateCosetSpace M, x • ω = ω := by
  obtain ⟨g, hxg⟩ := hM.involution_mem_conjugate hx
  let q : conjugateCosetSpace M := QuotientGroup.mk g⁻¹
  have hq : x • q = q := by
    change x • (QuotientGroup.mk g⁻¹ : conjugateCosetSpace M) =
      QuotientGroup.mk g⁻¹
    apply (fixed_coset_iff_mem_rightConjugate M g⁻¹ x).mpr
    simpa using hxg
  refine ⟨q, hq, ?_⟩
  intro r
  refine Quotient.inductionOn' r ?_
  intro h hr
  have hxh : x ∈ rightConjugate M h⁻¹ :=
    (fixed_coset_iff_mem_rightConjugate M h x).mp hr
  let a : X := rightConjugateElem x h
  let b : X := rightConjugateElem x g⁻¹
  let k : X := h⁻¹ * g⁻¹
  have haM : a ∈ M :=
    rightConjugateElem_mem_of_mem_rightConjugate hxh
  have hbM : b ∈ M := by
    apply rightConjugateElem_mem_of_mem_rightConjugate
    simpa using hxg
  have ha : IsInvolution a :=
    isInvolution_rightConjugateElem hx
  have hak : rightConjugateElem a k = b := by
    dsimp [a, b, k]
    simp [rightConjugateElem, mul_assoc]
  obtain ⟨m, hmM, hma⟩ := hfusion haM hbM ha hak
  let c : X := m * k⁻¹
  have hcfix : rightConjugateElem a c = a := by
    calc
      rightConjugateElem a c =
          rightConjugateElem (rightConjugateElem a m) k⁻¹ := by
            simp [c, rightConjugateElem, mul_assoc]
      _ = rightConjugateElem b k⁻¹ := by rw [hma]
      _ = rightConjugateElem (rightConjugateElem a k) k⁻¹ := by rw [hak]
      _ = a := by simp [rightConjugateElem, mul_assoc]
  have hca : c * a = a * c := by
    have hc := congrArg (fun z : X => c * z) hcfix
    have hac : a * c = c * a := by
      simpa [rightConjugateElem, mul_assoc] using hc
    exact hac.symm
  have hcM : c ∈ M :=
    hM.centralizer_le haM ha
      (Subgroup.mem_centralizer_singleton_iff.mpr hca)
  have hkM : k ∈ M := by
    have hk : k = c⁻¹ * m := by
      dsimp [c]
      group
    rw [hk]
    exact M.mul_mem (M.inv_mem hcM) hmM
  change QuotientGroup.mk h = QuotientGroup.mk g⁻¹
  exact QuotientGroup.eq.mpr hkM

/-- Assuming involution fusion control, two right conjugates of `M` that
contain a common involution are equal. -/
public theorem rightConjugate_eq_of_common_involution_of_controlsInvolutionFusion
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) (hfusion : ControlsInvolutionFusion M)
    {x g h : X} (hx : IsInvolution x)
    (hxg : x ∈ rightConjugate M g) (hxh : x ∈ rightConjugate M h) :
    rightConjugate M g = rightConjugate M h := by
  obtain ⟨ω, _hω, huniq⟩ :=
    hM.involution_fixed_coset_unique_of_controlsInvolutionFusion hfusion hx
  have hxfixg : x • (QuotientGroup.mk g⁻¹ : conjugateCosetSpace M) =
      QuotientGroup.mk g⁻¹ := by
    apply (fixed_coset_iff_mem_rightConjugate M g⁻¹ x).mpr
    simpa using hxg
  have hxfixh : x • (QuotientGroup.mk h⁻¹ : conjugateCosetSpace M) =
      QuotientGroup.mk h⁻¹ := by
    apply (fixed_coset_iff_mem_rightConjugate M h⁻¹ x).mpr
    simpa using hxh
  have hcoset : (QuotientGroup.mk g⁻¹ : conjugateCosetSpace M) =
      QuotientGroup.mk h⁻¹ :=
    (huniq _ hxfixg).trans (huniq _ hxfixh).symm
  have hgstab := conjugateCoset_stabilizer M g⁻¹
  have hhstab := conjugateCoset_stabilizer M h⁻¹
  simp only [inv_inv] at hgstab hhstab
  calc
    rightConjugate M g =
        MulAction.stabilizer X (QuotientGroup.mk g⁻¹ : conjugateCosetSpace M) :=
      hgstab.symm
    _ = MulAction.stabilizer X (QuotientGroup.mk h⁻¹ : conjugateCosetSpace M) := by
      rw [hcoset]
    _ = rightConjugate M h := hhstab

/-- Assuming involution fusion control, the fixed-point set of the cyclic
subgroup generated by an involution has cardinality one. -/
public theorem involution_fixedPoints_card_eq_one_of_controlsInvolutionFusion
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) (hfusion : ControlsInvolutionFusion M)
    {x : X} (hx : IsInvolution x) :
    Nat.card {ω : conjugateCosetSpace M //
      ω ∈ fixedPointsOfSubgroup X (conjugateCosetSpace M)
        (Subgroup.zpowers x)} = 1 := by
  obtain ⟨ω, hω, huniq⟩ :=
    hM.involution_fixed_coset_unique_of_controlsInvolutionFusion hfusion hx
  apply Nat.card_eq_one_iff_exists.mpr
  refine ⟨⟨ω, mem_fixedPointsOfSubgroup_zpowers_iff.mpr hω⟩, ?_⟩
  intro y
  apply Subtype.ext
  apply huniq
  exact mem_fixedPointsOfSubgroup_zpowers_iff.mp y.2

/-- Every involution fixes a unique point of the conjugate coset action. -/
public theorem involution_fixed_coset_unique
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x : X} (hx : IsInvolution x) :
    ∃! ω : conjugateCosetSpace M, x • ω = ω :=
  hM.involution_fixed_coset_unique_of_controlsInvolutionFusion
    hM.involution_fusion_control hx

/-- Two right conjugates of a strongly embedded subgroup that contain a
common involution are equal. -/
public theorem rightConjugate_eq_of_common_involution
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x g h : X} (hx : IsInvolution x)
    (hxg : x ∈ rightConjugate M g) (hxh : x ∈ rightConjugate M h) :
    rightConjugate M g = rightConjugate M h :=
  hM.rightConjugate_eq_of_common_involution_of_controlsInvolutionFusion
    hM.involution_fusion_control hx hxg hxh

/-- The fixed-point set of the cyclic subgroup generated by an involution has
cardinality one. -/
public theorem involution_fixedPoints_card_eq_one
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x : X} (hx : IsInvolution x) :
    Nat.card {ω : conjugateCosetSpace M //
      ω ∈ fixedPointsOfSubgroup X (conjugateCosetSpace M)
        (Subgroup.zpowers x)} = 1 :=
  hM.involution_fixedPoints_card_eq_one_of_controlsInvolutionFusion
    hM.involution_fusion_control hx

end IsStronglyEmbedded
end CFSG.BenderSuzuki
