/-! ## Per-involution data -/

/-- Construct the exact per-involution data consumed by Theorem 6 in the
simple minimal-counterexample setting. -/
public theorem IsStronglyEmbedded.theorem6InvolutionData
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) (hX : IsSimpleGroup X)
    (hrank : TwoRankAtLeastTwo (involutionCore M))
    (hinduction : ∀ H : Subgroup X, H ≠ ⊤ →
      ∀ N : Subgroup H, IsStronglyEmbedded N →
        TheoremSEConclusion N)
    {t : X} (ht : IsInvolution t) (htM : t ∉ M) :
    Nonempty (Theorem6InvolutionData M t) := by
  let hT2 : Theorem4bProposition63Theorem2 M (involutionsSet X) :=
    hM.theorem4bProposition63Theorem2
  have htwo : MulAction.IsMultiplyPretransitive X
      (conjugateCosetSpace M) 2 :=
    hM.theorem4a_twoTransitive_of_section7
      hX hrank hT2 hinduction
  have htrans : IsTransitiveOn M
      {omega : conjugateCosetSpace M |
        omega ≠ (QuotientGroup.mk 1 : conjugateCosetSpace M)} :=
    hM.theorem4a_baseStabilizer_transitive_of_section7
      hX hrank hT2 hinduction
  obtain ⟨d83, h84, h84support⟩ :=
    hM.exists_proposition84_with_modelSupport_of_source_endpoints
      hX hrank hinduction ht htM
  obtain ⟨z, s, hzM, hz, hsM, hs, hzs⟩ :=
    exists_two_distinct_involutions_in_involutionCore hrank
  obtain ⟨k, hk, hzk⟩ :=
    hM.exists_mem_peterfalviKSet_of_involution_mem
      hzM hz ht htM hsM hs
  have hkne : k ≠ 1 := by
    intro hkone
    apply hzs
    simpa [hkone, rightConjugateElem] using hzk
  exact ⟨
    { lemma83 := d83
      proposition84 := h84
      proposition84_modelSupport := h84support
      peterfalviKSet_nontrivial := ⟨k, hk, hkne⟩
      base_stabilizer_transitive := htrans
      rank := hrank
      two_transitive := htwo }⟩

/-! ## Involution-core transport -/

/-- Strong embedding restricts to the subgroup generated by the ambient
involutions. -/
public theorem IsStronglyEmbedded.comap_involutionCore
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) :
    IsStronglyEmbedded (M.comap (involutionCore X).subtype) := by
  let L : Subgroup X := involutionCore X
  let ML : Subgroup L := M.comap L.subtype
  obtain ⟨z, hzM, hz⟩ := hM.exists_involution
  have hzL : z ∈ L := by
    change z ∈ involutionCore X
    rw [involutionCore_eq_closure]
    exact Subgroup.subset_closure hz
  obtain ⟨t, ht, htM⟩ := hM.exists_involution_not_mem
  have htL : t ∈ L := by
    change t ∈ involutionCore X
    rw [involutionCore_eq_closure]
    exact Subgroup.subset_closure ht
  have hproper : ML ≠ ⊤ := by
    intro htop
    have htML : (⟨t, htL⟩ : L) ∈ ML := by
      rw [htop]
      trivial
    exact htM htML
  exact hM.comap_of_injective L.subtype Subtype.val_injective hproper
    ⟨⟨z, hzL⟩, hzM, IsInvolution.subtype hz hzL⟩

/-- Theorem SE for the restriction to the ambient involution core gives the
exact model and Borel data appearing in the ambient conclusion. -/
public theorem recognition_borel_of_involutionCore_theoremSE
    {X : Type u} [Group X] [Finite X]
    (M : Subgroup X)
    (hSE : TheoremSEBenderConclusion
      (M.comap (involutionCore X).subtype)) :
    IsSimpleBenderGroup
        (involutionCore X ⧸ twoPrimeCore (involutionCore X)) ∧
      IsBorelSubgroup
        (((M ⊓ involutionCore X).subgroupOf (involutionCore X)).map
          (QuotientGroup.mk' (twoPrimeCore (involutionCore X)))) := by
  let L : Subgroup X := involutionCore X
  let ML : Subgroup L := M.comap L.subtype
  let C : Subgroup L := involutionCore L
  have hCtop : C = ⊤ := by
    simpa [C, L] using involutionCore_involutionCore_eq_top X
  let e : C ≃* L :=
    { toFun := fun c => c
      invFun := fun l => ⟨l, by rw [hCtop]; exact Subgroup.mem_top l⟩
      left_inv := fun c => Subtype.ext rfl
      right_inv := fun l => rfl
      map_mul' := fun _ _ => rfl }
  have hcoremap :
      (twoPrimeCore C).map e.toMonoidHom = twoPrimeCore L := by
    simpa [twoPrimeCore] using
      (pPrimeCore_map_iso (p := 2) e)
  letI : ((twoPrimeCore C).map e.toMonoidHom).Normal :=
    Subgroup.Normal.map (inferInstance : (twoPrimeCore C).Normal)
      e.toMonoidHom e.surjective
  let q0 : (C ⧸ twoPrimeCore C) ≃*
      (L ⧸ (twoPrimeCore C).map e.toMonoidHom) :=
    quotientMulEquivOfMulEquiv e (twoPrimeCore C)
  let qeq : (L ⧸ (twoPrimeCore C).map e.toMonoidHom) ≃*
      (L ⧸ twoPrimeCore L) :=
    QuotientGroup.quotientMulEquivOfEq hcoremap
  let qe : (C ⧸ twoPrimeCore C) ≃*
      (L ⧸ twoPrimeCore L) := q0.trans qeq
  change TheoremSEBenderConclusion ML at hSE
  dsimp [TheoremSEBenderConclusion] at hSE
  change IsSimpleBenderGroup (C ⧸ twoPrimeCore C) ∧ _ at hSE
  have hbender : IsSimpleBenderGroup (L ⧸ twoPrimeCore L) :=
    hSE.1.map_mulEquiv qe
  let BC : Subgroup C := (ML ⊓ C).subgroupOf C
  let qC : C →* (C ⧸ twoPrimeCore C) :=
    QuotientGroup.mk' (twoPrimeCore C)
  let qL : L →* (L ⧸ twoPrimeCore L) :=
    QuotientGroup.mk' (twoPrimeCore L)
  have hBCmap : BC.map e.toMonoidHom = ML := by
    ext x
    constructor
    · rintro ⟨c, hc, rfl⟩
      exact hc.1
    · intro hx
      let c : C := e.symm x
      refine ⟨c, ?_, by simp [c]⟩
      refine ⟨?_, c.property⟩
      change x ∈ ML
      exact hx
  have hqcomp : qe.toMonoidHom.comp qC =
      qL.comp e.toMonoidHom := by
    apply MonoidHom.ext
    intro c
    change qe (QuotientGroup.mk c) = QuotientGroup.mk (e c)
    have hq0c : q0 (QuotientGroup.mk c) = QuotientGroup.mk (e c) :=
      quotientMulEquivOfMulEquiv_mk e (twoPrimeCore C) c
    have hqeqc : qeq (QuotientGroup.mk (e c)) =
        QuotientGroup.mk (e c) :=
      QuotientGroup.quotientMulEquivOfEq_mk hcoremap (e c)
    rw [show qe (QuotientGroup.mk c) =
      qeq (q0 (QuotientGroup.mk c)) by rfl, hq0c, hqeqc]
  let B0 : Subgroup (C ⧸ twoPrimeCore C) := BC.map qC
  let BL : Subgroup (L ⧸ twoPrimeCore L) := ML.map qL
  have hBmap : B0.map qe.toMonoidHom = BL := by
    calc
      B0.map qe.toMonoidHom =
          BC.map (qe.toMonoidHom.comp qC) := by
            simp [B0, Subgroup.map_map]
      _ = BC.map (qL.comp e.toMonoidHom) := by rw [hqcomp]
      _ = (BC.map e.toMonoidHom).map qL := by
            simp [Subgroup.map_map]
      _ = BL := by rw [hBCmap]
  have hB0 : IsBorelSubgroup B0 := hSE.2.2
  have hBL : IsBorelSubgroup BL := by
    rw [← hBmap]
    exact hB0.map_mulEquiv qe
  refine ⟨?_, ?_⟩
  · simpa [L] using hbender
  · have hML : (M ⊓ L).subgroupOf L = ML := by
      ext x
      change ((x : X) ∈ M ∧ (x : X) ∈ L) ↔ (x : X) ∈ M
      simp
    simpa [L, BL, qL, hML] using hBL

/-! ## Simple quotient and Borel transport -/

/-- If the involution core is the whole ambient group, quotienting by its
odd core produces a simple group.  A proper normal preimage has odd order and
is therefore contained in the odd core, while a preimage containing an
involution contains the whole involution core. -/
public theorem IsStronglyEmbedded.isSimpleGroup_quotient_twoPrimeCore
    {G : Type u} [Group G] [Finite G] {M : Subgroup G}
    (hM : IsStronglyEmbedded M)
    (hcore : involutionCore G = ⊤) :
    IsSimpleGroup (G ⧸ twoPrimeCore G) := by
  let O : Subgroup G := twoPrimeCore G
  let q : G →* (G ⧸ O) := QuotientGroup.mk' O
  have hOtop : O ≠ ⊤ := by
    intro htop
    have hOcop : Nat.Coprime 2 (Nat.card O) := by
      simpa [O, twoPrimeCore] using
        (pPrimeCore_coprime_card (G := G) (p := 2))
    have hOodd : Odd (Nat.card O) := Nat.coprime_two_left.mp hOcop
    have hGodd : Odd (Nat.card G) := by
      simpa [O, htop] using hOodd
    have hModd : Odd (Nat.card M) :=
      hGodd.of_dvd_nat (Subgroup.card_subgroup_dvd_card M)
    exact (Nat.not_even_iff_odd.mpr hModd) hM.card_even
  letI : Nontrivial (G ⧸ O) := QuotientGroup.nontrivial_iff.mpr hOtop
  apply IsSimpleGroup.mk
  intro K hK
  let N : Subgroup G := K.comap q
  letI : N.Normal := by
    dsimp [N]
    infer_instance
  have hmap : N.map q = K := by
    exact Subgroup.map_comap_eq_self_of_surjective
      (f := q) (QuotientGroup.mk'_surjective O) K
  by_cases hInv : ∃ x : G, x ∈ N ∧ IsInvolution x
  · obtain ⟨x, hxN, hx⟩ := hInv
    have hcoreN : involutionCore G ≤ N :=
      hM.involutionCore_le_normal_of_mem hx hxN
    have hNtop : N = ⊤ := by
      apply top_unique
      rw [← hcore]
      exact hcoreN
    right
    rw [← hmap, hNtop]
    apply top_unique
    intro y hy
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective O y
    exact ⟨x, Subgroup.mem_top x, rfl⟩
  · have hNodd : Odd (Nat.card N) := by
      rw [← Nat.not_even_iff_odd]
      intro hEven
      obtain ⟨x, hxOrder⟩ :=
        exists_prime_orderOf_dvd_card' (G := N) 2
          (even_iff_two_dvd.mp hEven)
      have hxOrderG : orderOf (x : G) = 2 := by
        rw [Subgroup.orderOf_coe]
        exact hxOrder
      have hxData :=
        (orderOf_eq_prime_iff (x := (x : G)) (p := 2)).mp hxOrderG
      exact hInv ⟨(x : G), x.property, ⟨hxData.2, hxData.1⟩⟩
    have hNO : N ≤ O := by
      simpa [O, twoPrimeCore] using
        (show N ≤ pPrimeCore 2 G from
          le_sSup ⟨inferInstance, hNodd.coprime_two_left⟩)
    have hON : O ≤ N := by
      change O ≤ K.comap (QuotientGroup.mk' O)
      exact QuotientGroup.le_comap_mk' O K
    have hNOeq : N = O := le_antisymm hNO hON
    left
    rw [← hmap, hNOeq]
    simp [q, O]

/-- A nilpotent normal complement to an odd two-point stabilizer is the
Sylow-2 subgroup whose normalizer is the strongly embedded subgroup.  This
is the Borel conclusion used by the final Suzuki branch. -/
public theorem IsStronglyEmbedded.isBorelSubgroup_of_normal_complement
    {G : Type u} [Group G] [Finite G] {M Q : Subgroup G} {t : G}
    (hM : IsStronglyEmbedded M)
    (htM : t ∉ M)
    (hQ : IsNormalComplementIn M (M ⊓ rightConjugate M t) Q)
    (hQp : IsPGroup 2 Q)
    (hQnil : Group.IsNilpotent Q) :
    IsBorelSubgroup M := by
  let D : Subgroup G := M ⊓ rightConjugate M t
  have hDodd : Odd (Nat.card D) := by
    simpa [D] using hM.inf_rightConjugate_card_odd htM
  have hQeven : Even (Nat.card Q) := by
    simpa [D] using hM.normal_complement_even htM hQ
  have hQMnormal : (Q.subgroupOf M).Normal := by
    simpa using hQ.normal_in_M
  have hQMsolv : Group.IsSolvable (Q.subgroupOf M) := by
    let eQ : Q.subgroupOf M ≃* Q :=
      Subgroup.subgroupOfEquivOfLe hQ.le_M
    letI : Group.IsNilpotent Q := hQnil
    exact Group.isSolvable_of_surjective eQ.symm.toEquiv.surjective
      (f := eQ.symm.toMonoidHom)
  have hDMsolv : Group.IsSolvable (D.subgroupOf M) := by
    have hcard : Nat.card (D.subgroupOf M) = Nat.card D :=
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe (H := D) (K := M)
          (show D ≤ M from inf_le_left)).toEquiv
    have hodd : Odd (Nat.card (D.subgroupOf M)) := by
      rw [hcard]
      exact hDodd
    exact odd_order_theorem _ hodd
  let QM : Subgroup M := Q.subgroupOf M
  let DM : Subgroup M := D.subgroupOf M
  letI : QM.Normal := by
    simpa [QM] using hQMnormal
  have hdisjointM : Disjoint QM DM := by
    rw [Subgroup.disjoint_def]
    intro x hxQ hxD
    apply Subtype.ext
    exact Subgroup.disjoint_def.mp hQ.disjoint_D hxQ hxD
  have hsupM : QM ⊔ DM = ⊤ := by
    calc
      QM ⊔ DM = (Q ⊔ D).subgroupOf M := by
        simpa [QM, DM] using
          (Subgroup.subgroupOf_sup (A := Q) (A' := D) (B := M)
            hQ.le_M inf_le_left).symm
      _ = M.subgroupOf M := by
        simpa [D] using congrArg (Subgroup.subgroupOf · M) hQ.sup_eq
      _ = ⊤ := Subgroup.subgroupOf_self M
  have hcomp : QM.IsComplement' DM :=
    isComplement'_of_disjoint_sup_eq_top_of_normal QM DM
      hdisjointM hsupM
  have hMsolv : Group.IsSolvable M := by
    let eQuot : M ⧸ QM ≃* DM := hcomp.symm.QuotientMulEquiv
    letI : Group.IsSolvable QM := by simpa [QM] using hQMsolv
    letI : Group.IsSolvable DM := by simpa [DM] using hDMsolv
    letI : Group.IsSolvable (M ⧸ QM) :=
      Group.isSolvable_of_surjective eQuot.symm.toEquiv.surjective
        (f := eQuot.symm.toMonoidHom)
    exact isSolvable_of_normal_subgroup_and_quotient QM
  have hQnormalizer : M ≤ Subgroup.normalizer (Q : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hQ.le_M).mp hQMnormal
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨PM, hPM⟩ := exists_sylow_map_eq_of_normal_complement
    (p := 2) hQ.le_M inf_le_left hQnormalizer
      (by exact hQ.disjoint_D.eq_bot) hQ.sup_eq hQp
      hDodd.not_two_dvd_nat
  have hnormalizer_le : Subgroup.normalizer (Q : Set G) ≤ M := by
    intro g hg
    by_contra hgM
    obtain ⟨z, hzOrder⟩ :=
      exists_prime_orderOf_dvd_card' (G := Q) 2 hQeven.two_dvd
    have hzOrderG : orderOf (z : G) = 2 := by
      rw [Subgroup.orderOf_coe]
      exact hzOrder
    have hzData :=
      (orderOf_eq_prime_iff (x := (z : G)) (p := 2)).mp hzOrderG
    have hz : IsInvolution (z : G) := ⟨hzData.2, hzData.1⟩
    have hzM : (z : G) ∈ M := hQ.le_M z.property
    have hzgQ : g * (z : G) * g⁻¹ ∈ Q :=
      (Subgroup.mem_normalizer_iff.mp hg (z : G)).1 z.property
    have hzRight : (z : G) ∈ rightConjugate M g := by
      have hconjM : g * (z : G) * g⁻¹ ∈ M := hQ.le_M hzgQ
      have hmem := rightConjugateElem_mem_rightConjugate (M := M)
        (x := g * (z : G) * g⁻¹) (g := g) hconjM
      simpa [rightConjugateElem, mul_assoc] using hmem
    exact hM.2.2 hgM hzM hzRight hz
  obtain ⟨S, hS⟩ :=
    exists_sylow_map_eq_of_normalizer_le PM (by
      simpa [hPM] using hnormalizer_le)
  refine ⟨hMsolv, S, ?_⟩
  have hSQ : (S : Subgroup G) = Q := hS.trans hPM
  rw [hSQ]
  exact le_antisymm hQnormalizer hnormalizer_le

/-- In a simple ambient group, the Bender branch of Theorem SE is exactly
ambient Bender recognition together with the Borel property of the original
strongly embedded subgroup. -/
public theorem recognition_borel_of_simple_theoremSEBenderConclusion
    {G : Type u} [Group G] [Finite G] (N : Subgroup G)
    (hN : IsStronglyEmbedded N) (hG : IsSimpleGroup G)
    (hSE : TheoremSEBenderConclusion N) :
    IsSimpleBenderGroup G ∧ IsBorelSubgroup N := by
  let L : Subgroup G := involutionCore G
  have hL : L = ⊤ := hN.involutionCore_eq_top_of_isSimple hG
  let eL : L ≃* G :=
    (MulEquiv.subgroupCongr hL).trans Subgroup.topEquiv
  have hsimpleL : IsSimpleGroup L := eL.isSimpleGroup_congr.mpr hG
  have hcore : twoPrimeCore L = ⊥ := by
    rcases hsimpleL.eq_bot_or_eq_top_of_normal (twoPrimeCore L)
        with hbot | htop
    · exact hbot
    · obtain ⟨x, _hxN, hx⟩ := hN.exists_involution
      have hxL : x ∈ L := by
        change x ∈ involutionCore G
        rw [involutionCore_eq_closure]
        exact Subgroup.subset_closure hx
      let xL : L := ⟨x, hxL⟩
      have hxLinv : IsInvolution xL := IsInvolution.subtype hx hxL
      let xc : twoPrimeCore L := ⟨xL, by simp [htop]⟩
      have hxc : IsInvolution xc :=
        IsInvolution.subtype hxLinv (by simp [htop])
      have horder : orderOf xc = 2 :=
        orderOf_eq_prime hxc.sq_eq_one hxc.ne_one
      have hdvd : 2 ∣ Nat.card (twoPrimeCore L) := by
        rw [← horder]
        exact orderOf_dvd_natCard xc
      exact ((Nat.prime_two.coprime_iff_not_dvd.mp
        (by simpa [twoPrimeCore] using
          (pPrimeCore_coprime_card (G := L) (p := 2)))) hdvd).elim
  let eCore : (L ⧸ twoPrimeCore L) ≃* L :=
    (QuotientGroup.quotientMulEquivOfEq hcore).trans
      (QuotientGroup.quotientBot (G := L))
  let e : (L ⧸ twoPrimeCore L) ≃* G := eCore.trans eL
  change IsSimpleBenderGroup (L ⧸ twoPrimeCore L) ∧ _ at hSE
  refine ⟨IsSimpleBenderGroup.of_mulEquiv e hSE.1, ?_⟩
  have he_mk : ∀ l : L, e (QuotientGroup.mk l) = (l : G) := by
    intro l
    change eL (eCore (QuotientGroup.mk l)) = (l : G)
    have h1 :
        (QuotientGroup.quotientMulEquivOfEq hcore)
            (QuotientGroup.mk l) = QuotientGroup.mk l :=
      QuotientGroup.quotientMulEquivOfEq_mk hcore l
    rw [show eCore (QuotientGroup.mk l) =
      QuotientGroup.quotientBot
        ((QuotientGroup.quotientMulEquivOfEq hcore)
          (QuotientGroup.mk l)) by rfl, h1]
    change eL ((QuotientGroup.kerLift (MonoidHom.id L))
      (QuotientGroup.mk l)) = (l : G)
    rw [QuotientGroup.kerLift_mk]
    rfl
  have hBmap :
      (((N ⊓ L).subgroupOf L).map
          (QuotientGroup.mk' (twoPrimeCore L))).map
          e.toMonoidHom = N := by
    ext x
    constructor
    · rintro ⟨y, hy, hxy⟩
      rcases hy with ⟨l, hl, hly⟩
      have hx_eq : x = (l : G) := by
        calc
          x = e y := hxy.symm
          _ = e (QuotientGroup.mk' (twoPrimeCore L) l) :=
            congrArg e hly.symm
          _ = (l : G) := he_mk l
      rw [hx_eq]
      exact hl.1
    · intro hx
      let l : L := ⟨x, by rw [hL]; trivial⟩
      have hl : l ∈ (N ⊓ L).subgroupOf L := ⟨hx, l.property⟩
      refine ⟨QuotientGroup.mk l, ?_, ?_⟩
      · exact ⟨l, hl, rfl⟩
      · exact he_mk l
  have hB := hSE.2.2.map_mulEquiv e
  rw [hBmap] at hB
  exact hB

/-- Conversely, recognition and Borel data for the ambient odd-core quotient
give the exact Bender branch of Theorem SE when the ambient group is generated
by its involutions. -/
public theorem theoremSEBenderConclusion_of_involutionCore_eq_top
    {G : Type u} [Group G] [Finite G] (M : Subgroup G)
    (hcore : involutionCore G = ⊤)
    (hBender : IsSimpleBenderGroup (G ⧸ twoPrimeCore G))
    (hOLeM : twoPrimeCore G ≤ M)
    (hBorel : IsBorelSubgroup
      (M.map (QuotientGroup.mk' (twoPrimeCore G)))) :
    TheoremSEBenderConclusion M := by
  let L : Subgroup G := involutionCore G
  let e : L ≃* G :=
    (MulEquiv.subgroupCongr hcore).trans Subgroup.topEquiv
  have hcoremap :
      (twoPrimeCore L).map e.toMonoidHom = twoPrimeCore G := by
    simpa [twoPrimeCore] using (pPrimeCore_map_iso (p := 2) e)
  letI : ((twoPrimeCore L).map e.toMonoidHom).Normal :=
    Subgroup.Normal.map (inferInstance : (twoPrimeCore L).Normal)
      e.toMonoidHom e.surjective
  let q0 : (L ⧸ twoPrimeCore L) ≃*
      (G ⧸ (twoPrimeCore L).map e.toMonoidHom) :=
    quotientMulEquivOfMulEquiv e (twoPrimeCore L)
  let qeq : (G ⧸ (twoPrimeCore L).map e.toMonoidHom) ≃*
      (G ⧸ twoPrimeCore G) :=
    QuotientGroup.quotientMulEquivOfEq hcoremap
  let qe : (L ⧸ twoPrimeCore L) ≃*
      (G ⧸ twoPrimeCore G) := q0.trans qeq
  have hbenderL : IsSimpleBenderGroup (L ⧸ twoPrimeCore L) :=
    IsSimpleBenderGroup.of_mulEquiv qe.symm hBender
  let ML : Subgroup L := (M ⊓ L).subgroupOf L
  let qL : L →* (L ⧸ twoPrimeCore L) :=
    QuotientGroup.mk' (twoPrimeCore L)
  let qG : G →* (G ⧸ twoPrimeCore G) :=
    QuotientGroup.mk' (twoPrimeCore G)
  have hMLmap : ML.map e.toMonoidHom = M := by
    ext x
    constructor
    · rintro ⟨l, hl, rfl⟩
      exact hl.1
    · intro hx
      let l : L := e.symm x
      refine ⟨l, ?_, by simp [l]⟩
      refine ⟨?_, l.property⟩
      change x ∈ M
      exact hx
  have hqcomp : qe.toMonoidHom.comp qL =
      qG.comp e.toMonoidHom := by
    apply MonoidHom.ext
    intro l
    change qe (QuotientGroup.mk l) = QuotientGroup.mk (e l)
    have hq0l : q0 (QuotientGroup.mk l) = QuotientGroup.mk (e l) :=
      quotientMulEquivOfMulEquiv_mk e (twoPrimeCore L) l
    have hqeql : qeq (QuotientGroup.mk (e l)) =
        QuotientGroup.mk (e l) :=
      QuotientGroup.quotientMulEquivOfEq_mk hcoremap (e l)
    rw [show qe (QuotientGroup.mk l) =
      qeq (q0 (QuotientGroup.mk l)) by rfl, hq0l, hqeql]
  let BL : Subgroup (L ⧸ twoPrimeCore L) := ML.map qL
  let BG : Subgroup (G ⧸ twoPrimeCore G) := M.map qG
  have hBLmap : BL.map qe.toMonoidHom = BG := by
    calc
      BL.map qe.toMonoidHom =
          ML.map (qe.toMonoidHom.comp qL) := by
            simp [BL, Subgroup.map_map]
      _ = ML.map (qG.comp e.toMonoidHom) := by rw [hqcomp]
      _ = (ML.map e.toMonoidHom).map qG := by
            simp [Subgroup.map_map]
      _ = BG := by rw [hMLmap]
  have hBL : IsBorelSubgroup BL := by
    have h := hBorel.map_mulEquiv qe.symm
    change IsBorelSubgroup (BG.map qe.symm.toMonoidHom) at h
    rw [← hBLmap] at h
    simpa [Subgroup.map_map] using h
  have hcoreAmbient :
      (twoPrimeCore L).map L.subtype = twoPrimeCore G := by
    have he : e.toMonoidHom = L.subtype := by
      ext l
      rfl
    exact (congrArg (fun f : L →* G => (twoPrimeCore L).map f) he).symm.trans
      hcoremap
  change IsSimpleBenderGroup (L ⧸ twoPrimeCore L) ∧ _
  refine ⟨hbenderL, ?_, ?_⟩
  · rw [hcoreAmbient]
    exact fun x hx => ⟨hOLeM hx, by rw [hcore]; trivial⟩
  · simpa [BL, ML, qL] using hBL

/-! ## Simple ambient Suzuki assembly -/

/-- The checked Sections 7--11 argument and Suzuki recognition classify a
simple ambient group and identify its strongly embedded subgroup as a Borel
subgroup. -/
public theorem simple_recognition_borel
    {X : Type u} [Group X] [Finite X] (M : Subgroup X)
    (hM : IsStronglyEmbedded M) (hX : IsSimpleGroup X)
    (hrank : TwoRankAtLeastTwo (involutionCore X))
    (hinduction : ∀ H : Subgroup X, H ≠ ⊤ →
      ∀ N : Subgroup H, IsStronglyEmbedded N →
        TheoremSEConclusion N) :
    IsSimpleBenderGroup X ∧ IsBorelSubgroup M := by
  have hrankM : TwoRankAtLeastTwo (involutionCore M) :=
    rank_involutionCore_of_ambient_rank hM hrank
  let hT2 : Theorem4bProposition63Theorem2 M (involutionsSet X) :=
    hM.theorem4bProposition63Theorem2
  have htwo : MulAction.IsMultiplyPretransitive X
      (conjugateCosetSpace M) 2 :=
    hM.theorem4a_twoTransitive_of_section7
      hX hrankM hT2 hinduction
  have hdata : ∀ (t : X), IsInvolution t → t ∉ M →
      Nonempty (Theorem6InvolutionData M t) := by
    intro t ht htM
    exact hM.theorem6InvolutionData hX
      hrankM hinduction ht htM
  have h6 : Theorem6Conclusion M :=
    hM.theorem_6_of_involution_data hdata
  obtain ⟨t, ht, htM⟩ := hM.exists_involution_not_mem
  obtain ⟨Q, hQ, hQnil⟩ := h6 t htM
  have hfaithful : FaithfulSMul X (conjugateCosetSpace M) :=
    faithful_conjugateCosetSpace_of_simple hM hX
  have hrankX : TwoRankAtLeastTwo X :=
    hrank.map_of_injective (involutionCore X).subtype
      Subtype.val_injective
  have hA : HypothesisA X (conjugateCosetSpace M)
      M (M ⊓ rightConjugate M t) Q t :=
    hM.hypothesisA_of_normal_complement
      htwo hfaithful hrankX ht htM hQ
  obtain ⟨L, hLnormal, q, hodd, hq, hqgt, hmodel⟩ :=
    suzuki M (M ⊓ rightConjugate M t) Q t hA
  have hresData :=
    PFchapter1section3.hypothesisA_model_subgroup_eq_twoPrimeResidual
      M (M ⊓ rightConjugate M t) Q t hA
        L hLnormal q hodd hq hqgt hmodel
  have hQp : IsPGroup 2 Q := hresData.1
  have hres : twoPrimeResidual X = L := hresData.2
  have hBenderL : IsSimpleBenderGroup L := by
    rcases hmodel with hpsl | hsuzuki | hpsu
    · rcases hpsl with
        ⟨k, hk, hqk, eL, _rho, _eOmega, _hnatural, _hequiv⟩
      have hpowgt : 2 < 2 ^ k := by simpa [hqk] using hqgt
      have hkone : k ≠ 1 := by
        intro hkone
        subst k
        norm_num at hpowgt
      apply IsSimpleBenderGroup.isPSL2
      exact ⟨k, by omega, ⟨eL⟩⟩
    · rcases hsuzuki with
        ⟨k, hk, _hqk, eL, _rho, _eOmega, _hnatural, _hequiv⟩
      apply IsSimpleBenderGroup.isSuzuki
      exact ⟨k, by omega, ⟨eL⟩⟩
    · rcases hpsu with
        ⟨E, hEfield, hEfinite, J, hJ, hEcard, hfixedCard,
          eL, _rho, _eOmega, _hnatural, _hequiv⟩
      rcases hq with ⟨n, hqn⟩
      have hpowgt : 2 < 2 ^ n := by simpa [hqn] using hqgt
      have hnzero : n ≠ 0 := by
        intro hnzero
        subst n
        norm_num at hpowgt
      have hnone : n ≠ 1 := by
        intro hnone
        subst n
        norm_num at hpowgt
      apply IsSimpleBenderGroup.isPSU3
      exact ⟨n, by omega, E, hEfield, hEfinite, J, hJ,
        by simpa [hqn] using hEcard,
        by simpa [hqn] using hfixedCard, ⟨eL⟩⟩
  have hcoreResidual : involutionCore X ≤ twoPrimeResidual X := by
    rw [involutionCore_eq_closure, Subgroup.closure_le]
    intro x hx
    exact isPGroup_le_twoPrimeResidual
      (isPGroup_two_zpowers_of_isInvolution hx)
      (Subgroup.mem_zpowers x)
  have hcoreTop : involutionCore X = ⊤ :=
    hM.involutionCore_eq_top_of_isSimple hX
  have hresTop : twoPrimeResidual X = ⊤ := by
    apply top_unique
    rw [← hcoreTop]
    exact hcoreResidual
  have hLtop : L = ⊤ := hres.symm.trans hresTop
  let eL : L ≃* X :=
    (MulEquiv.subgroupCongr hLtop).trans Subgroup.topEquiv
  refine ⟨hBenderL.map_mulEquiv eL, ?_⟩
  exact hM.isBorelSubgroup_of_normal_complement
    htM hQ hQp hQnil

/-! ## The minimal-counterexample step -/

/-- The source-faithful minimal step for Theorem SE.  Induction is genuinely
on all smaller finite groups, because both a proper involution-core subgroup
and a nontrivial odd-core quotient occur in the reduction. -/
public theorem theoremSEMinimalStep
    (hrankExcl : SimpleStronglyEmbeddedRankTwo.{u}) :
    TheoremSEMinimalStep.{u} := by
  intro X _ _ M hM hinduction hrank
  let L : Subgroup X := involutionCore X
  have hrankM : TwoRankAtLeastTwo (involutionCore M) :=
    rank_involutionCore_of_ambient_rank hM hrank
  have hcoreML : (involutionCore M).map M.subtype ≤ L := by
    rw [involutionCore_eq_closure, MonoidHom.map_closure,
      Subgroup.closure_le]
    rintro x ⟨y, hy, rfl⟩
    apply Subgroup.subset_closure
    exact IsInvolution.map_of_injective hy M.subtype
      Subtype.val_injective
  have hrankML : TwoRankAtLeastTwo (M.comap L.subtype) :=
    theorem4bProposition63_twoRank_comap hrankM hcoreML
  have hOLM : (twoPrimeCore L).map L.subtype ≤ M :=
    oddCore_map_le_stronglyEmbedded_of_twoRank_intersection
      M L hM hrankML
  by_cases hLtop : L = ⊤
  · let eL : L ≃* X :=
      (MulEquiv.subgroupCongr hLtop).trans Subgroup.topEquiv
    have hcoremap :
        (twoPrimeCore L).map eL.toMonoidHom = twoPrimeCore X := by
      simpa [twoPrimeCore] using (pPrimeCore_map_iso (p := 2) eL)
    have hcoreAmbient :
        (twoPrimeCore L).map L.subtype = twoPrimeCore X := by
      have he : eL.toMonoidHom = L.subtype := by
        ext l
        rfl
      exact (congrArg (fun f : L →* X => (twoPrimeCore L).map f) he).symm.trans
        hcoremap
    have hOLeM : twoPrimeCore X ≤ M := by
      rw [← hcoreAmbient]
      exact hOLM
    let O : Subgroup X := twoPrimeCore X
    have hOodd : Odd (Nat.card O) := by
      apply Nat.coprime_two_left.mp
      simpa [O, twoPrimeCore] using
        (pPrimeCore_coprime_card (G := X) (p := 2))
    by_cases hObot : O = ⊥
    · have hsimpleX : IsSimpleGroup X := by
        have hsimpleQ := hM.isSimpleGroup_quotient_twoPrimeCore hLtop
        let e : (X ⧸ O) ≃* X :=
          (QuotientGroup.quotientMulEquivOfEq hObot).trans
            (QuotientGroup.quotientBot (G := X))
        exact e.isSimpleGroup_congr.mp (by simpa [O] using hsimpleQ)
      obtain ⟨hBenderX, hBorelX⟩ :=
        simple_recognition_borel M hM hsimpleX hrank
          (fun H hHtop N hN => hinduction (Y := H) (by
            have hlt : H < (⊤ : Subgroup X) := lt_of_le_of_ne
              le_top hHtop
            simpa using natCard_lt_of_subgroup_lt hlt) N hN)
      let e : (X ⧸ O) ≃* X :=
        (QuotientGroup.quotientMulEquivOfEq hObot).trans
          (QuotientGroup.quotientBot (G := X))
      have hBenderQ : IsSimpleBenderGroup (X ⧸ O) :=
        IsSimpleBenderGroup.of_mulEquiv e.symm hBenderX
      have hBorelQ : IsBorelSubgroup
          (M.map (QuotientGroup.mk' O)) := by
        have h := hBorelX.map_mulEquiv e.symm
        have he_mk (x : X) :
            e (QuotientGroup.mk x : X ⧸ O) = x := by
          change QuotientGroup.quotientBot
              (QuotientGroup.quotientMulEquivOfEq hObot
                (QuotientGroup.mk x)) = x
          rw [QuotientGroup.quotientMulEquivOfEq_mk]
          rfl
        have he : e.symm.toMonoidHom = QuotientGroup.mk' O := by
          ext x
          change e.symm x = QuotientGroup.mk x
          apply e.injective
          rw [e.apply_symm_apply, he_mk]
        have hmap : M.map e.symm.toMonoidHom =
            M.map (QuotientGroup.mk' O) :=
          congrArg (fun f : X →* (X ⧸ O) => M.map f) he
        change IsBorelSubgroup (M.map e.symm.toMonoidHom) at h
        rw [hmap] at h
        exact h
      exact theoremSEBenderConclusion_of_involutionCore_eq_top M hLtop
        (by simpa [O] using hBenderQ) hOLeM hBorelQ
    · have hsimpleQ : IsSimpleGroup (X ⧸ O) := by
        exact hM.isSimpleGroup_quotient_twoPrimeCore hLtop
      let q : X →* (X ⧸ O) := QuotientGroup.mk' O
      let MQ : Subgroup (X ⧸ O) := M.map q
      have hMQ : IsStronglyEmbedded MQ := by
        exact IsStronglyEmbedded.map_quotient_of_odd_kernel
          hM hOLeM hOodd
      have hQcard : Nat.card (X ⧸ O) < Nat.card X := by
        simpa [O] using natCard_quotient_lt_of_ne_bot O hObot
      have hSEQ : TheoremSEConclusion MQ :=
        hinduction (Y := (X ⧸ O)) hQcard MQ hMQ
      have hQrank : TwoRankAtLeastTwo (X ⧸ O) :=
        hrankExcl MQ hsimpleQ hMQ
      have hQcoretop : involutionCore (X ⧸ O) = ⊤ :=
        hMQ.involutionCore_eq_top_of_isSimple hsimpleQ
      have hQrankCore :
          TwoRankAtLeastTwo (involutionCore (X ⧸ O)) := by
        let eQ : involutionCore (X ⧸ O) ≃* (X ⧸ O) :=
          (MulEquiv.subgroupCongr hQcoretop).trans Subgroup.topEquiv
        exact twoRankAtLeastTwo_of_mulEquiv eQ.symm hQrank
      rcases hSEQ with hQrankFalse | hQbender
      · exact (hQrankFalse hQrankCore).elim
      · obtain ⟨hBenderQ, hBorelQ⟩ :=
          recognition_borel_of_simple_theoremSEBenderConclusion
            MQ hMQ hsimpleQ hQbender
        exact theoremSEBenderConclusion_of_involutionCore_eq_top M hLtop
          hBenderQ hOLeM hBorelQ
  · have hLcard : Nat.card L < Nat.card X := by
      have hlt : L < (⊤ : Subgroup X) :=
        lt_of_le_of_ne le_top hLtop
      simpa using natCard_lt_of_subgroup_lt hlt
    let ML : Subgroup L := M.comap L.subtype
    have hML : IsStronglyEmbedded ML :=
      hM.comap_involutionCore
    have hSEML : TheoremSEConclusion ML :=
      hinduction (Y := L) hLcard ML hML
    have hcoreLtop : involutionCore L = ⊤ := by
      simpa [L] using involutionCore_involutionCore_eq_top X
    let eL : involutionCore L ≃* L :=
      (MulEquiv.subgroupCongr hcoreLtop).trans Subgroup.topEquiv
    have hrankL : TwoRankAtLeastTwo (involutionCore L) :=
      twoRankAtLeastTwo_of_mulEquiv eL.symm hrank
    rcases hSEML with hrankFalse | hBender
    · exact (hrankFalse hrankL).elim
    · obtain ⟨hBenderL, hBorelL⟩ :=
        recognition_borel_of_involutionCore_theoremSE M hBender
      have hOLeM :
          (twoPrimeCore L).map L.subtype ≤ M ⊓ L := by
        intro x hx
        exact ⟨hOLM hx, by
          rcases hx with ⟨y, hy, rfl⟩
          exact y.property⟩
      exact ⟨hBenderL, hOLeM, hBorelL⟩

/-! ## Public Theorem SE endpoints -/

/-- The simple-ambient consequence of the Bender--Suzuki theorem. -/
public theorem theorem_SE_simple
    {X : Type u} [Group X] [Finite X]
    (M : Subgroup X) (hM : IsStronglyEmbedded M)
    (hX : IsSimpleGroup X) :
    IsSimpleBenderGroup X :=
  isSimpleBenderGroup_of_minimalStep
    (theoremSEMinimalStep simpleStronglyEmbeddedRankTwo)
    simpleStronglyEmbeddedRankTwo M hM hX

-- The statement is never allowed to change
public theorem theorem_SE
    {X : Type u} [Group X] [Finite X]
    (M : Subgroup X) (hM : IsStronglyEmbedded M) :
    TheoremSEConclusion M := by
  exact theoremSEConclusion_of_minimalStep
    (theoremSEMinimalStep simpleStronglyEmbeddedRankTwo) M hM

end CFSG.BenderSuzuki
