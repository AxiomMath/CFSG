/-!
# Section 7: coprime-action generation for Lemma 7.5

This module contains the checked solvable coprime-action proof of the
source lemma [II1; 4.6], together with its specialization to the actor
used in Lemma 7.5.
-/

open scoped Pointwise IsMulCommutative commutatorElement

noncomputable section


universe u

namespace CFSG.BenderSuzuki

open PFAppendixIII

/-- The subgroup generated by all `W`-conjugates of `C_T(z)`.

The project convention is left conjugation: `C.conjBy w = w C w⁻¹`.  Since
`w` ranges over a subgroup, this generates the same subgroup as the usual
right-conjugate notation `C_T(z)^W` in the source. -/
public def lemma75ConjugateCentralizers
    {X : Type u} [Group X] (T W : Subgroup X) (z : X) : Subgroup X :=
  ⨆ w : W, (elementCentralizerIn T z).conjBy (w : X)

/-- The exact specialized conclusion of `[II1; 4.6]`, separated from the
routine Section 7 containment step. -/
public def Lemma75II146Conclusion
    {X : Type u} [Group X] (T W : Subgroup X) (z : X) : Prop :=
  T = subgroupCentralizerIn T W ⊔ lemma75ConjugateCentralizers T W z

/-- The source actor `W⟨z⟩` normalizes the target whenever both generators
do. -/
public theorem lemma75_actor_le_normalizer
    {X : Type u} [Group X] {T W : Subgroup X} {z : X}
    (hWT : W ≤ Subgroup.normalizer (T : Set X))
    (hzT : z ∈ Subgroup.normalizer (T : Set X)) :
    W ⊔ Subgroup.zpowers z ≤ Subgroup.normalizer (T : Set X) := by
  apply sup_le hWT
  rw [Subgroup.zpowers_le]
  exact hzT

/-- The source condition `W = [W,⟨z⟩]` is exactly the `J = W`
specialization in `[II1; 4.6]`: for the full actor `W⟨z⟩`, one has
`[⟨z⟩, W⟨z⟩] = W`. -/
public theorem lemma75_actor_commutator_eq
    {X : Type u} [Group X] {W : Subgroup X} {z : X}
    (hzNormW : z ∈ Subgroup.normalizer (W : Set X))
    (hcomm : ⁅W, Subgroup.zpowers z⁆ = W) :
    ⁅Subgroup.zpowers z, W ⊔ Subgroup.zpowers z⁆ = W := by
  let Z : Subgroup X := Subgroup.zpowers z
  let A : Subgroup X := W ⊔ Z
  let WA : Subgroup A := W.subgroupOf A
  let ZA : Subgroup A := Z.subgroupOf A
  have hZnormW : Z ≤ Subgroup.normalizer (W : Set X) := by
    rw [Subgroup.zpowers_le]
    exact hzNormW
  have hAnormW : A ≤ Subgroup.normalizer (W : Set X) :=
    sup_le Subgroup.le_normalizer hZnormW
  have hWAnormal : WA.Normal := by
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer
      (H := W) (K := A) (by simp [A])).mpr hAnormW
  letI : WA.Normal := hWAnormal
  have hsupTop : WA ⊔ ZA = ⊤ := by
    rw [← Subgroup.subgroupOf_sup (A := W) (A' := Z) (B := A)
      (by simp [A]) (by simp [A])]
    simp [A]
  have hupper : ⁅Z, A⁆ ≤ W := by
    rw [Subgroup.commutator_le]
    intro x hxZ a haA
    let aA : A := ⟨a, haA⟩
    have haTop : aA ∈ WA ⊔ ZA := by simpa [hsupTop]
    rcases (Subgroup.mem_sup_of_normal_left.mp haTop) with
      ⟨wA, hwA, zA, hzA, hdecomp⟩
    have hwW : (wA : X) ∈ W := hwA
    have hzZ : (zA : X) ∈ Z := hzA
    have hdecompX : (wA : X) * (zA : X) = a := by
      exact congrArg Subtype.val hdecomp
    have hcommZW : ⁅Z, W⁆ = W := by
      simpa [Z, Subgroup.commutator_comm] using hcomm
    have hxwW : ⁅x, (wA : X)⁆ ∈ W := by
      rw [← hcommZW]
      exact Subgroup.commutator_mem_commutator hxZ hwW
    have hxzComm : Commute x (zA : X) := by
      let xZ : Z := ⟨x, hxZ⟩
      let zZ : Z := ⟨(zA : X), hzZ⟩
      exact congrArg Subtype.val
        (IsMulCommutative.is_comm.comm xZ zZ)
    have hxzOne : ⁅x, (zA : X)⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr hxzComm.eq
    rw [← hdecompX, commutator_mul_right, hxzOne]
    simpa using hxwW
  apply le_antisymm
  · simpa [A, Z] using hupper
  · have hcommZW : ⁅Z, W⁆ = W := by
      simpa [Z, Subgroup.commutator_comm] using hcomm
    calc
      W = ⁅Z, W⁆ := hcommZW.symm
      _ ≤ ⁅Z, A⁆ := by
        apply Subgroup.commutator_mono
        · exact le_rfl
        · change W ≤ W ⊔ Z
          exact le_sup_left

/-- The routine cardinality bridge needed before invoking a coprime-action
theorem: the actor `W⟨z⟩` is coprime to an odd target `T` as soon as
`|W|` is coprime to `|T|`.  The proof uses only the normality of `W` in the
join and the fact that `|<z>| = 2`. -/
public theorem lemma75_actor_card_coprime
    {X : Type u} [Group X] [Finite X]
    {T W : Subgroup X} {z : X}
    (hz : IsInvolution z)
    (hzNormW : z ∈ Subgroup.normalizer (W : Set X))
    (hWT : Nat.Coprime (Nat.card W) (Nat.card T))
    (hTodd : Odd (Nat.card T)) :
    Nat.Coprime (Nat.card ↥(W ⊔ Subgroup.zpowers z)) (Nat.card T) := by
  let Z : Subgroup X := Subgroup.zpowers z
  let A : Subgroup X := Z ⊔ W
  let WA : Subgroup A := W.subgroupOf A
  let ZA : Subgroup A := Z.subgroupOf A
  have hZnormW : Z ≤ Subgroup.normalizer (W : Set X) := by
    rw [Subgroup.zpowers_le]
    exact hzNormW
  have hWAnormal : WA.Normal := by
    simpa [WA, A, Z] using
      (Subgroup.normal_subgroupOf_sup_of_le_normalizer
        (H := Z) (N := W) hZnormW)
  letI : WA.Normal := hWAnormal
  have hsupTop : ZA ⊔ WA = ⊤ := by
    rw [← Subgroup.subgroupOf_sup (A := Z) (A' := W) (B := A)
      (by simp [A, Z]) (by simp [A, Z])]
    simp [A, Z]
  let q : A →* (A ⧸ WA) := QuotientGroup.mk' WA
  have hmapZA : ZA.map q = ⊤ := by
    apply top_unique
    intro x hx
    obtain ⟨a, rfl⟩ := (QuotientGroup.mk'_surjective WA) x
    have ha : a ∈ ZA ⊔ WA := by simpa [hsupTop]
    rcases (Subgroup.mem_sup_of_normal_right.mp ha) with ⟨z', hz', w', hw', hzw⟩
    refine Subgroup.mem_map.mpr ⟨z', hz', ?_⟩
    change q z' = q a
    rw [← hzw]
    simp [q, hw']
  have hQdvdZA : Nat.card (A ⧸ WA) ∣ Nat.card ZA := by
    have hmap := Subgroup.card_map_dvd ZA q
    rw [hmapZA] at hmap
    simpa using hmap
  have hcardZA : Nat.card ZA = 2 := by
    change Nat.card (Z.subgroupOf A) = 2
    rw [natCard_subgroupOf_eq Z A (by simp [A])]
    simp [Z, Nat.card_zpowers, (orderOf_eq_prime_iff).2
      ⟨hz.sq_eq_one, hz.ne_one⟩]
  have hQcop : Nat.Coprime (Nat.card (A ⧸ WA)) (Nat.card T) := by
    apply Nat.Coprime.of_dvd_left hQdvdZA
    simpa [hcardZA] using hTodd.coprime_two_left
  have hWAcop : Nat.Coprime (Nat.card WA) (Nat.card T) := by
    change Nat.Coprime (Nat.card (W.subgroupOf A)) (Nat.card T)
    rw [natCard_subgroupOf_eq W A (by simp [A])]
    exact hWT
  have hprod : Nat.Coprime (Nat.card (A ⧸ WA) * Nat.card WA) (Nat.card T) :=
    Nat.Coprime.mul_left hQcop hWAcop
  have hcardA : Nat.card A = Nat.card (A ⧸ WA) * Nat.card WA :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (s := WA)
  have hactor : W ⊔ Subgroup.zpowers z = A := by
    simp [A, Z, sup_comm]
  rw [hactor, hcardA]
  exact hprod

public theorem lemma75_pgroup_odd_card
    {X : Type u} [Group X] [Finite X] {W : Subgroup X} {p : ℕ}
    (hp : Nat.Prime p) (hpOdd : Odd p) (hWp : IsPGroup p W) :
    Odd (Nat.card W) := by
  letI : Fact p.Prime := ⟨hp⟩
  obtain ⟨n, hn⟩ := hWp.exists_card_eq
  rw [hn]
  exact hpOdd.pow

public theorem lemma75_pgroup_coprime_card
    {X : Type u} [Group X] [Finite X]
    {T W : Subgroup X} {p : ℕ}
    (hp : Nat.Prime p) (hWp : IsPGroup p W)
    (hpcop : Nat.Coprime p (Nat.card T)) :
    Nat.Coprime (Nat.card W) (Nat.card T) := by
  letI : Fact p.Prime := ⟨hp⟩
  obtain ⟨n, hn⟩ := hWp.exists_card_eq
  rw [hn]
  exact hpcop.pow_left n

public theorem lemma75_theta_odd_card
    {X : Type u} [Group X] [Finite X] (p : ℕ) (F : Subgroup X) :
    Odd (Nat.card (corollary64Theta p F)) := by
  let O : Subgroup X := corollary64OddCore F
  let T : Subgroup X := corollary64Theta p F
  have hTO : T ≤ O := by
    simpa [T, O, corollary64Theta] using
      (Subgroup.map_subtype_le (pPrimeCore p O))
  have hcardO : Nat.card O = Nat.card (twoPrimeCore F) := by
    simpa [O, corollary64OddCore] using
      (Subgroup.card_map_of_injective
        (K := twoPrimeCore F) (f := F.subtype) F.subtype_injective)
  have h2copO : Nat.Coprime 2 (Nat.card O) := by
    rw [hcardO]
    exact pPrimeCore_coprime_card (p := 2) (G := F)
  have h2copT : Nat.Coprime 2 (Nat.card T) :=
    Nat.Coprime.of_dvd_right (Subgroup.card_dvd_of_le hTO) h2copO
  simpa [T] using h2copT.odd_of_left

public theorem lemma75_theta_p_coprime_card
    {X : Type u} [Group X] [Finite X] {p : ℕ}
    (hp : Nat.Prime p) (F : Subgroup X) :
    Nat.Coprime p (Nat.card (corollary64Theta p F)) := by
  letI : Fact p.Prime := ⟨hp⟩
  let O : Subgroup X := corollary64OddCore F
  let T : Subgroup X := corollary64Theta p F
  have hcardT : Nat.card T = Nat.card (pPrimeCore p O) := by
    simpa [T, O, corollary64Theta] using
      (Subgroup.card_map_of_injective
        (K := pPrimeCore p O) (f := O.subtype) O.subtype_injective)
  rw [hcardT]
  exact pPrimeCore_coprime_card (p := p) (G := O)

public theorem lemma75_theta_actor_card_coprime
    {X : Type u} [Group X] [Finite X] {p : ℕ}
    (hp : Nat.Prime p) {W : Subgroup X} (hWp : IsPGroup p W)
    {z : X} (hz : IsInvolution z)
    (hzNormW : z ∈ Subgroup.normalizer (W : Set X))
    (F : Subgroup X) :
    Nat.Coprime (Nat.card ↥(W ⊔ Subgroup.zpowers z))
      (Nat.card (corollary64Theta p F)) := by
  have hWT : Nat.Coprime (Nat.card W)
      (Nat.card (corollary64Theta p F)) :=
    lemma75_pgroup_coprime_card hp hWp
      (lemma75_theta_p_coprime_card hp F)
  exact lemma75_actor_card_coprime hz hzNormW hWT
    (lemma75_theta_odd_card p F)

private noncomputable def lemma75ActorOrbit
    {H V : Type u} [Group H] [Group V] [MulDistribMulAction H V]
    (K : Subgroup V) : Subgroup V :=
  ⨆ h : H, K.map
    (MulDistribMulAction.toMulAut H V h).toMonoidHom

private theorem lemma75ActorOrbit_isInvariant
    {H V : Type u} [Group H] [Group V] [MulDistribMulAction H V]
    (K : Subgroup V) : IsInvariant H V
      (lemma75ActorOrbit (H := H) (V := V) K) := by
  let O : Subgroup V := lemma75ActorOrbit (H := H) (V := V) K
  have hforward (a : H) {x : V} (hx : x ∈ O) : a • x ∈ O := by
    change x ∈ ⨆ h : H, K.map
      (MulDistribMulAction.toMulAut H V h).toMonoidHom at hx
    change a • x ∈ ⨆ h : H, K.map
      (MulDistribMulAction.toMulAut H V h).toMonoidHom
    refine Subgroup.iSup_induction
      (fun h : H => K.map
        (MulDistribMulAction.toMulAut H V h).toMonoidHom)
      (C := fun y => a • y ∈ O) hx ?_ ?_ ?_
    · intro h x hx
      rcases hx with ⟨y, hy, rfl⟩
      refine Subgroup.mem_iSup_of_mem (a * h) ?_
      refine ⟨y, hy, ?_⟩
      change (a * h) • y = a • (h • y)
      exact mul_smul a h y
    · simp
    · intro x y hx hy
      simpa [smul_mul'] using (O.mul_mem hx hy)
  refine ⟨?_ ⟩
  intro a x
  constructor
  · exact hforward a
  · intro hx
    have hx' := hforward a⁻¹ hx
    simpa [inv_smul_smul] using hx'

private theorem lemma75_le_actorOrbit
    {H V : Type u} [Group H] [Group V] [MulDistribMulAction H V]
    (K : Subgroup V) : K ≤ lemma75ActorOrbit (H := H) (V := V) K := by
  intro x hx
  refine Subgroup.mem_iSup_of_mem (1 : H) ?_
  simpa using Subgroup.mem_map_of_mem
    (MulDistribMulAction.toMulAut H V (1 : H)).toMonoidHom hx

private theorem lemma75_involutiveMulAut_eq_inv_of_fixed_eq_one
    {V : Type u} [Group V] [Finite V]
    (tau : MulAut V) (htau : ∀ x : V, tau (tau x) = x)
    (hfix : ∀ x : V, tau x = x → x = 1) :
    ∀ x : V, tau x = x⁻¹ := by
  let f : V → V := fun y => (tau y)⁻¹ * y
  have hf_injective : Function.Injective f := by
    intro a b hab
    change (tau a)⁻¹ * a = (tau b)⁻¹ * b at hab
    have hfixed : tau (b * a⁻¹) = b * a⁻¹ := by
      rw [map_mul, map_inv]
      calc
        tau b * (tau a)⁻¹ =
            tau b * ((tau a)⁻¹ * a) * a⁻¹ := by group
        _ = tau b * ((tau b)⁻¹ * b) * a⁻¹ := by rw [hab]
        _ = b * a⁻¹ := by group
    have hba : b * a⁻¹ = 1 := hfix _ hfixed
    have hba' := congrArg (fun z : V => z * a) hba
    have : b = a := by simpa [mul_assoc] using hba'
    exact this.symm
  have hf_surjective : Function.Surjective f :=
    Finite.injective_iff_surjective.mp hf_injective
  intro x
  obtain ⟨y, rfl⟩ := hf_surjective x
  change tau ((tau y)⁻¹ * y) = ((tau y)⁻¹ * y)⁻¹
  rw [map_mul, map_inv, htau]
  simp

private noncomputable def lemma75JOrbit
    {H V : Type u} [Group H] [Group V] [MulDistribMulAction H V]
    (J : Subgroup H) (z : H) : Subgroup V :=
  ⨆ j : J,
    (fixedPointSubgroup (Subgroup.zpowers z) V).map
      (MulDistribMulAction.toMulAut H V (j : H)).toMonoidHom

private theorem lemma75_minimal_elementary
    {H V : Type u} [Group H] [Finite H] [Group V] [Finite V]
    [MulDistribMulAction H V] [Nontrivial V]
    {r : ℕ} [Fact r.Prime] [IsElementaryAbelian r V]
    (J : Subgroup H) (z : H) (hz : IsInvolution z)
    (hJnormal : J.Normal)
    (hgen : J ⊔ Subgroup.zpowers z = ⊤)
    (hcomm : ⁅Subgroup.zpowers z, J⁆ = J)
    (hminv : ∀ N : Subgroup V,
      N.Normal → IsInvariant H V N → N ≠ ⊥ → N = ⊤) :
    fixedPointSubgroup J V ⊔ lemma75JOrbit J z = ⊤ := by
  let K : Subgroup V := fixedPointSubgroup (Subgroup.zpowers z) V
  let O : Subgroup V := lemma75ActorOrbit (H := H) (V := V) K
  let L : Subgroup V := lemma75JOrbit (H := H) (V := V) J z
  by_cases hK : K = ⊥
  · let rho : H →* MulAut V := MulDistribMulAction.toMulAut H V
    let tau : MulAut V := rho z
    have htau : ∀ v : V, tau (tau v) = v := by
      intro v
      change z • (z • v) = v
      rw [← mul_smul]
      have hzz : z * z = 1 := by
        simpa [pow_two] using hz.sq_eq_one
      rw [hzz]
      exact one_smul H v
    have hfix : ∀ v : V, tau v = v → v = 1 := by
      intro v hv
      have hvK : v ∈ K := by
        change v ∈ fixedPointSubgroup (Subgroup.zpowers z) V
        rw [fixedPointSubgroup, FixedPoints.mem_subgroup]
        intro a
        exact smul_eq_self_of_mem_zpowers a.property hv
      have hvbot : v ∈ (⊥ : Subgroup V) := by simpa [hK] using hvK
      simpa using hvbot
    have hzinv : ∀ v : V, z • v = v⁻¹ := by
      simpa [tau, rho] using
        lemma75_involutiveMulAut_eq_inv_of_fixed_eq_one tau htau hfix
    have hzcent : rho z ∈
        Subgroup.centralizer ((J.map rho : Subgroup (MulAut V)) : Set (MulAut V)) := by
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      rcases ha with ⟨j, hj, rfl⟩
      ext v
      change j • (z • v) = z • (j • v)
      rw [hzinv, hzinv]
      simp [smul_inv']
    have hZcent : (Subgroup.zpowers z).map rho ≤
        Subgroup.centralizer ((J.map rho : Subgroup (MulAut V)) : Set (MulAut V)) := by
      rw [MonoidHom.map_zpowers]
      exact Subgroup.zpowers_le.mpr hzcent
    have hcommImage : (⁅Subgroup.zpowers z, J⁆).map rho = ⊥ := by
      rw [Subgroup.map_commutator]
      exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hZcent
    have hJmap : J.map rho = ⊥ := by
      rw [← hcomm]
      exact hcommImage
    have hJfix : fixedPointSubgroup J V = ⊤ := by
      apply top_unique
      intro v _hv
      rw [fixedPointSubgroup, FixedPoints.mem_subgroup]
      intro j
      have hjmap : rho (j : H) ∈ J.map rho :=
        Subgroup.mem_map_of_mem rho j.property
      rw [hJmap] at hjmap
      have hrho : rho (j : H) = 1 := Subgroup.mem_bot.mp hjmap
      change rho (j : H) v = v
      rw [hrho]
      rfl
    simp [hJfix]
  · letI : IsMulCommutative V := IsElementaryAbelian.toIsMulCommutative r
    letI : CommGroup V := IsMulCommutative.instCommGroup
    have hOnormal : O.Normal := by infer_instance
    have hOinv : IsInvariant H V O := by
      simpa [O] using lemma75ActorOrbit_isInvariant (H := H) (V := V) K
    have hOne : O ≠ ⊥ := by
      intro hObot
      apply hK
      apply le_antisymm
      · rw [← hObot]
        exact lemma75_le_actorOrbit (H := H) (V := V) K
      · exact bot_le
    have hOtop : O = ⊤ := hminv O hOnormal hOinv hOne
    have hO_le_L : O ≤ L := by
      intro x hx
      change x ∈ ⨆ h : H, K.map
        (MulDistribMulAction.toMulAut H V h).toMonoidHom at hx
      change x ∈ lemma75JOrbit (H := H) (V := V) J z
      refine Subgroup.iSup_induction
        (fun h : H => K.map
          (MulDistribMulAction.toMulAut H V h).toMonoidHom)
        (C := fun y => y ∈ L) hx ?_ ?_ ?_
      · intro h y hy
        rcases hy with ⟨v, hvK, rfl⟩
        have hh : h ∈ J ⊔ Subgroup.zpowers z := by
          rw [hgen]
          exact Subgroup.mem_top h
        letI : J.Normal := hJnormal
        obtain ⟨j, hjJ, k, hkZ, hjk⟩ :=
          Subgroup.mem_sup_of_normal_left.mp hh
        let jJ : J := ⟨j, hjJ⟩
        have hkv : k • v = v := by
          have hvfix :=
            (FixedPoints.mem_subgroup (M := Subgroup.zpowers z) (a := v)).mp
              (by simpa [K] using hvK)
          exact hvfix ⟨k, hkZ⟩
        change (h : H) • v ∈ L
        refine Subgroup.mem_iSup_of_mem jJ ?_
        refine ⟨v, hvK, ?_⟩
        change j • v = h • v
        rw [← hjk, mul_smul, hkv]
      · exact L.one_mem
      · intro x y hxL hyL
        exact L.mul_mem hxL hyL
    apply top_unique
    rw [← hOtop]
    exact hO_le_L.trans le_sup_right

private theorem lemma75_generated_map_subtype_le
    {H V : Type u} [Group H] [Group V] [MulDistribMulAction H V]
    (J : Subgroup H) (z : H) (N : Subgroup V) [IsInvariant H V N] :
    (fixedPointSubgroup J N ⊔
        lemma75JOrbit (H := H) (V := N) J z).map N.subtype ≤
      fixedPointSubgroup J V ⊔ lemma75JOrbit J z := by
  letI : IsInvariant J V N :=
    ⟨fun j v =>
      IsInvariant.invariant (A := H) (G := V) (H := N) (j : H) v⟩
  rw [Subgroup.map_sup]
  apply sup_le
  · rw [fixedPointSubgroup_map_subtype_eq_inf]
    exact inf_le_right.trans le_sup_left
  · intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
    change y ∈ ⨆ j : J,
      (fixedPointSubgroup (Subgroup.zpowers z) N).map
        (MulDistribMulAction.toMulAut H N (j : H)).toMonoidHom at hy
    refine Subgroup.iSup_induction
      (fun j : J =>
        (fixedPointSubgroup (Subgroup.zpowers z) N).map
          (MulDistribMulAction.toMulAut H N (j : H)).toMonoidHom)
      (C := fun y : N => (y : V) ∈
        fixedPointSubgroup J V ⊔ lemma75JOrbit J z)
      hy ?_ ?_ ?_
    · intro j y hy
      rcases hy with ⟨v, hv, rfl⟩
      have horbit :
          (((MulDistribMulAction.toMulAut H N (j : H)) v : N) : V) ∈
          lemma75JOrbit (H := H) (V := V) J z := by
        refine Subgroup.mem_iSup_of_mem j ?_
        refine ⟨(v : V), ?_, ?_⟩
        · change ∀ a : Subgroup.zpowers z, a • (v : V) = (v : V)
          intro a
          have hv' :=
            (FixedPoints.mem_subgroup
              (M := Subgroup.zpowers z) (a := v)).mp hv a
          exact congrArg Subtype.val hv'
        · rfl
      exact (show lemma75JOrbit J z ≤
        fixedPointSubgroup J V ⊔ lemma75JOrbit J z from le_sup_right) horbit
    · simp
    · intro x y hx hy
      simpa using (fixedPointSubgroup J V ⊔ lemma75JOrbit J z).mul_mem hx hy

private theorem lemma75_generated_map_quotient_eq
    {H V : Type u} [Group H] [Finite H] [Group V] [Finite V]
    [MulDistribMulAction H V]
    (J : Subgroup H) (z : H) (N : Subgroup V)
    [N.Normal] (hNinv : IsInvariant H V N)
    (hsolv : Group.IsSolvable V)
    (hcopJ : Nat.Coprime (Nat.card J) (Nat.card V))
    (hcopZ : Nat.Coprime (Nat.card (Subgroup.zpowers z)) (Nat.card V)) :
    letI : IsInvariant H V N := hNinv
    letI : MulDistribMulAction H (V ⧸ N) :=
      quotientMulDistribMulAction (A := H) (G := V) N hNinv
    (fixedPointSubgroup J V ⊔ lemma75JOrbit J z).map
        (QuotientGroup.mk' N) =
      fixedPointSubgroup J (V ⧸ N) ⊔
        lemma75JOrbit (H := H) (V := V ⧸ N) J z := by
  letI : IsInvariant H V N := hNinv
  letI : MulDistribMulAction H (V ⧸ N) :=
    quotientMulDistribMulAction (A := H) (G := V) N hNinv
  let q : V →* V ⧸ N := QuotientGroup.mk' N
  let hJinv : IsInvariant J V N := by
    refine ⟨?_⟩
    intro j v
    exact IsInvariant.invariant (A := H) (G := V) (H := N) (j : H) v
  let hZinv : IsInvariant (Subgroup.zpowers z) V N := by
    refine ⟨?_⟩
    intro a v
    exact IsInvariant.invariant (A := H) (G := V) (H := N) (a : H) v
  have hJfix :
      fixedPointSubgroup J (V ⧸ N) =
        (fixedPointSubgroup J V).map q := by
    simpa [q] using
      (fixedPointSubgroup_quotient_eq_map_of_solvable_coprime_action
        (G := V) (A := J) hsolv hcopJ (∅ : Set Nat.Primes) N hJinv)
  have hZfix :
      fixedPointSubgroup (Subgroup.zpowers z) (V ⧸ N) =
        (fixedPointSubgroup (Subgroup.zpowers z) V).map q := by
    simpa [q] using
      (fixedPointSubgroup_quotient_eq_map_of_solvable_coprime_action
        (G := V) (A := Subgroup.zpowers z) hsolv hcopZ
          (∅ : Set Nat.Primes) N hZinv)
  have hLmap : (lemma75JOrbit (H := H) (V := V) J z).map q =
      lemma75JOrbit (H := H) (V := V ⧸ N) J z := by
    apply le_antisymm
    · intro x hx
      rcases Subgroup.mem_map.mp hx with ⟨y, hy, rfl⟩
      change y ∈ ⨆ j : J,
        (fixedPointSubgroup (Subgroup.zpowers z) V).map
          (MulDistribMulAction.toMulAut H V (j : H)).toMonoidHom at hy
      refine Subgroup.iSup_induction
        (fun j : J =>
          (fixedPointSubgroup (Subgroup.zpowers z) V).map
            (MulDistribMulAction.toMulAut H V (j : H)).toMonoidHom)
        (C := fun y : V => q y ∈
          lemma75JOrbit (H := H) (V := V ⧸ N) J z)
        hy ?_ ?_ ?_
      · intro j y hy
        rcases hy with ⟨v, hv, rfl⟩
        refine Subgroup.mem_iSup_of_mem j ?_
        refine ⟨q v, ?_, ?_⟩
        · rw [hZfix]
          exact Subgroup.mem_map_of_mem q hv
        · change q ((j : H) • v) = (j : H) • q v
          rfl
      · simp [q]
      · intro x y hx hy
        simpa [map_mul] using
          (lemma75JOrbit (H := H) (V := V ⧸ N) J z).mul_mem hx hy
    · intro x hx
      change x ∈ ⨆ j : J,
        (fixedPointSubgroup (Subgroup.zpowers z) (V ⧸ N)).map
          (MulDistribMulAction.toMulAut H (V ⧸ N) (j : H)).toMonoidHom at hx
      refine Subgroup.iSup_induction
        (fun j : J =>
          (fixedPointSubgroup (Subgroup.zpowers z) (V ⧸ N)).map
            (MulDistribMulAction.toMulAut H (V ⧸ N) (j : H)).toMonoidHom)
        (C := fun x : V ⧸ N => x ∈
          (lemma75JOrbit (H := H) (V := V) J z).map q)
        hx ?_ ?_ ?_
      · intro j y hy
        rcases hy with ⟨vbar, hvbar, rfl⟩
        rw [hZfix] at hvbar
        rcases Subgroup.mem_map.mp hvbar with ⟨v, hv, rfl⟩
        refine Subgroup.mem_map.mpr ⟨(j : H) • v, ?_, ?_⟩
        · refine Subgroup.mem_iSup_of_mem j ?_
          exact Subgroup.mem_map_of_mem
            (MulDistribMulAction.toMulAut H V (j : H)).toMonoidHom hv
        · rfl
      · simp
      · intro x y hx hy
        exact Subgroup.mul_mem _ hx hy
  rw [Subgroup.map_sup, ← hJfix, hLmap]

private theorem lemma75_generation_of_solvable_coprime
    {H V : Type u} [Group H] [Finite H] [Group V] [Finite V]
    [MulDistribMulAction H V]
    (J : Subgroup H) (z : H) (hz : IsInvolution z)
    (hJnormal : J.Normal)
    (hgen : J ⊔ Subgroup.zpowers z = ⊤)
    (hcomm : ⁅Subgroup.zpowers z, J⁆ = J)
    (hsolv : Group.IsSolvable V)
    (hcop : Nat.Coprime (Nat.card H) (Nat.card V)) :
    fixedPointSubgroup J V ⊔ lemma75JOrbit J z = ⊤ := by
  classical
  let P : ℕ → Prop := fun n =>
    ∀ (V' : Type u) [Group V'] [Finite V']
      [MulDistribMulAction H V'],
      Nat.card V' = n →
      Group.IsSolvable V' →
      Nat.Coprime (Nat.card H) (Nat.card V') →
      fixedPointSubgroup J V' ⊔
        lemma75JOrbit (H := H) (V := V') J z = ⊤
  have hP : ∀ n, P n := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih V' _ _ _ hn hsolv' hcop'
    by_cases hminv :
        ∀ N : Subgroup V',
          N.Normal → IsInvariant H V' N → N ≠ ⊥ → N = ⊤
    · rcases Wielandt.chiefFactor_elementaryAbelian_or_subsingleton
          hsolv' hminv with hsub | ⟨hnontriv, r, hr, hElem⟩
      · letI : Subsingleton V' := hsub
        have hfix : fixedPointSubgroup J V' = ⊤ := by
          apply top_unique
          intro x _hx
          rw [fixedPointSubgroup, FixedPoints.mem_subgroup]
          intro a
          exact Subsingleton.elim (a • x) x
        simp [hfix]
      · letI : Nontrivial V' := hnontriv
        letI : Fact r.Prime := ⟨hr⟩
        letI : IsElementaryAbelian r V' := hElem
        exact lemma75_minimal_elementary (H := H) (V := V') (r := r)
          J z hz hJnormal hgen hcomm hminv
    · push Not at hminv
      rcases hminv with ⟨N, hNnormal, hNinv, hNne_bot, hNne_top⟩
      letI : N.Normal := hNnormal
      letI : IsInvariant H V' N := hNinv
      letI : MulDistribMulAction H (V' ⧸ N) :=
        quotientMulDistribMulAction (A := H) (G := V') N hNinv
      have hNlt : Nat.card N < n := by
        have hN_lt_top : N < ⊤ := lt_top_iff_ne_top.mpr hNne_top
        have hlt : Nat.card N < Nat.card V' := by
          simpa using natCard_lt_of_subgroup_lt hN_lt_top
        simpa [hn] using hlt
      have hQlt : Nat.card (V' ⧸ N) < n := by
        have hlt := natCard_quotient_lt_natCard_of_ne_bot N hNne_bot
        simpa [hn] using hlt
      have hsolvN : Group.IsSolvable N := by
        let : Group.IsSolvable V' := hsolv'
        infer_instance
      have hsolvQ : Group.IsSolvable (V' ⧸ N) := by
        let : Group.IsSolvable V' := hsolv'
        infer_instance
      have hcopN : Nat.Coprime (Nat.card H) (Nat.card N) :=
        Nat.Coprime.of_dvd_right (Subgroup.card_subgroup_dvd_card N) hcop'
      have hcopQ : Nat.Coprime (Nat.card H) (Nat.card (V' ⧸ N)) :=
        Nat.Coprime.of_dvd_right (Subgroup.card_quotient_dvd_card (s := N)) hcop'
      have hgenN : fixedPointSubgroup J N ⊔
          lemma75JOrbit (H := H) (V := N) J z = ⊤ :=
        ih (Nat.card N) hNlt N rfl hsolvN hcopN
      have hgenQ : fixedPointSubgroup J (V' ⧸ N) ⊔
          lemma75JOrbit (H := H) (V := V' ⧸ N) J z = ⊤ :=
        ih (Nat.card (V' ⧸ N)) hQlt (V' ⧸ N) rfl hsolvQ hcopQ
      let S : Subgroup V' :=
        fixedPointSubgroup J V' ⊔ lemma75JOrbit J z
      have hNleS : N ≤ S := by
        have hmap := lemma75_generated_map_subtype_le
          (H := H) (V := V') J z N
        rw [hgenN] at hmap
        have htopmap : (⊤ : Subgroup N).map N.subtype = N := by
          simpa [MonoidHom.range_eq_map] using (Subgroup.range_subtype (H := N))
        rw [htopmap] at hmap
        simpa [S] using hmap
      have hcopJ : Nat.Coprime (Nat.card J) (Nat.card V') :=
        Nat.Coprime.of_dvd_left (Subgroup.card_subgroup_dvd_card J) hcop'
      have hcopZ : Nat.Coprime (Nat.card (Subgroup.zpowers z)) (Nat.card V') :=
        Nat.Coprime.of_dvd_left
          (Subgroup.card_subgroup_dvd_card (Subgroup.zpowers z)) hcop'
      have hmapS : S.map (QuotientGroup.mk' N) = ⊤ := by
        rw [lemma75_generated_map_quotient_eq
          (H := H) (V := V') J z N hNinv hsolv' hcopJ hcopZ]
        exact hgenQ
      have hsup : S ⊔ N = ⊤ := by
        calc
          S ⊔ N = Subgroup.comap (QuotientGroup.mk' N)
              (S.map (QuotientGroup.mk' N)) := by simp [sup_comm]
          _ = ⊤ := by rw [hmapS]; simp
      rw [sup_eq_left.mpr hNleS] at hsup
      exact hsup
  exact hP (Nat.card V) V rfl hsolv hcop

private theorem lemma75_zpowers_subgroupOf_actor
    {X : Type u} [Group X] {W : Subgroup X} {z : X} :
    let A : Subgroup X := W ⊔ Subgroup.zpowers z
    let zA : A := ⟨z,
      (show Subgroup.zpowers z ≤ W ⊔ Subgroup.zpowers z from le_sup_right)
        (Subgroup.mem_zpowers z)⟩
    (Subgroup.zpowers z).subgroupOf A = Subgroup.zpowers zA := by
  intro A zA
  ext x
  constructor
  · intro hx
    have hxZ : (x : X) ∈ Subgroup.zpowers z := by
      simpa [Subgroup.mem_subgroupOf] using hx
    rcases Subgroup.mem_zpowers_iff.mp hxZ with ⟨n, hn⟩
    exact Subgroup.mem_zpowers_iff.mpr ⟨n, by
      apply Subtype.ext
      simpa [zA] using hn⟩
  · intro hx
    rcases Subgroup.mem_zpowers_iff.mp hx with ⟨n, hn⟩
    have hxZ : (x : X) ∈ Subgroup.zpowers z :=
      Subgroup.mem_zpowers_iff.mpr ⟨n, by
        simpa [zA] using congrArg Subtype.val hn⟩
    simpa [Subgroup.mem_subgroupOf] using hxZ

private theorem lemma75_actor_internal_normal
    {X : Type u} [Group X] {W : Subgroup X} {z : X}
    (hzNormW : z ∈ Subgroup.normalizer (W : Set X)) :
    let A : Subgroup X := W ⊔ Subgroup.zpowers z
    (W.subgroupOf A).Normal := by
  intro A
  have hZnormW : Subgroup.zpowers z ≤
      Subgroup.normalizer (W : Set X) := by
    rw [Subgroup.zpowers_le]
    exact hzNormW
  have hAnormW : A ≤ Subgroup.normalizer (W : Set X) :=
    sup_le Subgroup.le_normalizer hZnormW
  exact (Subgroup.normal_subgroupOf_iff_le_normalizer
    (H := W) (K := A) (by simp [A])).mpr hAnormW

private theorem lemma75_actor_internal_gen
    {X : Type u} [Group X] {W : Subgroup X} {z : X} :
    let A : Subgroup X := W ⊔ Subgroup.zpowers z
    let zA : A := ⟨z,
      (show Subgroup.zpowers z ≤ W ⊔ Subgroup.zpowers z from le_sup_right)
        (Subgroup.mem_zpowers z)⟩
    W.subgroupOf A ⊔ Subgroup.zpowers zA = ⊤ := by
  intro A zA
  rw [← lemma75_zpowers_subgroupOf_actor (W := W) (z := z)]
  rw [← Subgroup.subgroupOf_sup
    (A := W) (A' := Subgroup.zpowers z) (B := A)
    (by simp [A]) (by simp [A])]
  simp [A]

private theorem lemma75_actor_internal_commutator
    {X : Type u} [Group X] {W : Subgroup X} {z : X}
    (hcomm : ⁅W, Subgroup.zpowers z⁆ = W) :
    let A : Subgroup X := W ⊔ Subgroup.zpowers z
    let zA : A := ⟨z,
      (show Subgroup.zpowers z ≤ W ⊔ Subgroup.zpowers z from le_sup_right)
        (Subgroup.mem_zpowers z)⟩
    ⁅Subgroup.zpowers zA, W.subgroupOf A⁆ = W.subgroupOf A := by
  intro A zA
  rw [← lemma75_zpowers_subgroupOf_actor (W := W) (z := z)]
  apply (Subgroup.map_injective A.subtype_injective)
  rw [commutator_subgroupOf_map_eq A W (Subgroup.zpowers z)
    le_sup_left le_sup_right]
  rw [Subgroup.map_subgroupOf_eq_of_le le_sup_left]
  simpa [Subgroup.commutator_comm] using hcomm

public theorem lemma75_II146_specialized
    {X : Type u} [Group X] [Finite X]
    {T W : Subgroup X} {z : X}
    (hz : IsInvolution z)
    (hzNormW : z ∈ Subgroup.normalizer (W : Set X))
    (hWTnorm : W ≤ Subgroup.normalizer (T : Set X))
    (hzTnorm : z ∈ Subgroup.normalizer (T : Set X))
    (hcomm : ⁅W, Subgroup.zpowers z⁆ = W)
    (hTodd : Odd (Nat.card T))
    (hcop : Nat.Coprime
      (Nat.card ↥(W ⊔ Subgroup.zpowers z)) (Nat.card T)) :
    Lemma75II146Conclusion T W z := by
  classical
  let A : Subgroup X := W ⊔ Subgroup.zpowers z
  let J : Subgroup A := W.subgroupOf A
  let zA : A := ⟨z,
    (show Subgroup.zpowers z ≤ W ⊔ Subgroup.zpowers z from le_sup_right)
      (Subgroup.mem_zpowers z)⟩
  have hAT : A ≤ Subgroup.normalizer (T : Set X) := by
    simpa [A] using lemma75_actor_le_normalizer hWTnorm hzTnorm
  letI : Subgroup.Normalizes A T := ⟨hAT⟩
  have hzA : IsInvolution zA := by
    constructor
    · intro h
      apply hz.ne_one
      exact congrArg Subtype.val h
    · apply Subtype.ext
      exact hz.sq_eq_one
  have hJnormal : J.Normal := by
    simpa [A, J] using lemma75_actor_internal_normal hzNormW
  have hgenA : J ⊔ Subgroup.zpowers zA = ⊤ := by
    simpa [A, J, zA] using
      (lemma75_actor_internal_gen (W := W) (z := z))
  have hcommA : ⁅Subgroup.zpowers zA, J⁆ = J := by
    simpa [A, J, zA] using lemma75_actor_internal_commutator hcomm
  have hsolvT : Group.IsSolvable T := odd_order_theorem T hTodd
  have hcopAT : Nat.Coprime (Nat.card A) (Nat.card T) := by
    simpa [A] using hcop
  have hinternal : fixedPointSubgroup J T ⊔
      lemma75JOrbit (H := A) (V := T) J zA = ⊤ :=
    lemma75_generation_of_solvable_coprime
      J zA hzA hJnormal hgenA hcommA hsolvT hcopAT
  have hfixMap : (fixedPointSubgroup J T).map T.subtype =
      subgroupCentralizerIn T W := by
    ext x
    constructor
    · rintro ⟨t, ht, rfl⟩
      refine ⟨t.property, ?_⟩
      change ∀ w : X, w ∈ W → w * (t : X) = (t : X) * w
      intro w hw
      let wA : A := ⟨w, (show W ≤ A from le_sup_left) hw⟩
      let wJ : J := ⟨wA, hw⟩
      have htfix :=
        (FixedPoints.mem_subgroup (M := J) (a := t)).mp ht wJ
      have hconj : w * (t : X) * w⁻¹ = (t : X) :=
        congrArg Subtype.val htfix
      have hmul := congrArg (fun q : X => q * w) hconj
      simpa [mul_assoc] using hmul
    · rintro ⟨hxT, hxC⟩
      let t : T := ⟨x, hxT⟩
      refine Subgroup.mem_map.mpr ⟨t, ?_, rfl⟩
      rw [fixedPointSubgroup, FixedPoints.mem_subgroup]
      intro j
      apply Subtype.ext
      have hjW : ((j : A) : X) ∈ W := j.property
      have hcent := Subgroup.mem_centralizer_iff.mp hxC ((j : A) : X) hjW
      change ((j : A) : X) * x * ((j : A) : X)⁻¹ = x
      calc
        ((j : A) : X) * x * ((j : A) : X)⁻¹ =
            x * ((j : A) : X) * ((j : A) : X)⁻¹ := by rw [hcent]
        _ = x := by simp
  have hZfixMap :
      (fixedPointSubgroup (Subgroup.zpowers zA) T).map T.subtype =
        elementCentralizerIn T z := by
    have hfix :=
      fixedPointSubgroup_zpowers_subgroup_conj_eq_elementCentralizerIn
        T A hAT zA
    rw [hfix]
    rw [Subgroup.subgroupOf_map_subtype]
    exact inf_eq_left.mpr inf_le_left
  have hconjMap (j : J) :
      ((fixedPointSubgroup (Subgroup.zpowers zA) T).map
          (MulDistribMulAction.toMulAut A T (j : A)).toMonoidHom).map T.subtype =
        (elementCentralizerIn T z).conjBy ((j : A) : X) := by
    rw [Subgroup.map_map]
    have hcomp : T.subtype.comp
          (MulDistribMulAction.toMulAut A T (j : A)).toMonoidHom =
        (MulAut.conj ((j : A) : X)).toMonoidHom.comp T.subtype := by
      ext t
      rfl
    rw [hcomp, ← Subgroup.map_map, hZfixMap]
    rfl
  have horbitMap :
      (lemma75JOrbit (H := A) (V := T) J zA).map T.subtype =
        lemma75ConjugateCentralizers T W z := by
    rw [lemma75JOrbit, Subgroup.map_iSup]
    apply le_antisymm
    · refine iSup_le ?_
      intro j
      rw [hconjMap]
      let w : W := ⟨((j : A) : X), j.property⟩
      exact le_iSup (fun w : W =>
        (elementCentralizerIn T z).conjBy (w : X)) w
    · refine iSup_le ?_
      intro w
      let wA : A := ⟨(w : X), (show W ≤ A from le_sup_left) w.property⟩
      let j : J := ⟨wA, w.property⟩
      have hj := le_iSup (fun j : J =>
        ((fixedPointSubgroup (Subgroup.zpowers zA) T).map
          (MulDistribMulAction.toMulAut A T (j : A)).toMonoidHom).map
            T.subtype) j
      rw [hconjMap] at hj
      simpa [wA, j] using hj
  have hmapped :
      (fixedPointSubgroup J T).map T.subtype ⊔
          (lemma75JOrbit (H := A) (V := T) J zA).map T.subtype =
        (⊤ : Subgroup T).map T.subtype := by
    calc
      _ = (fixedPointSubgroup J T ⊔
            lemma75JOrbit (H := A) (V := T) J zA).map T.subtype := by
          rw [Subgroup.map_sup]
      _ = (⊤ : Subgroup T).map T.subtype := congrArg
        (fun S : Subgroup T => S.map T.subtype) hinternal
  rw [hfixMap, horbitMap] at hmapped
  have htopmap : (⊤ : Subgroup T).map T.subtype = T := by
    simpa [MonoidHom.range_eq_map] using (Subgroup.range_subtype (H := T))
  rw [htopmap] at hmapped
  exact hmapped.symm

/-- Once the source generation identity is available, the Section 7
containment follows from the three containments actually used in the text.

The hypothesis `W ≤ E` is essential for the conjugates of `C_T(z)` to stay
inside `E`; in the source it follows from `W ≤ F ∩ M = E`. -/
public theorem lemma75_le_of_II146Conclusion
    {X : Type u} [Group X]
    {T W E : Subgroup X} {z : X}
    (hgen : Lemma75II146Conclusion T W z)
    (hCTW : subgroupCentralizerIn T W ≤ E)
    (hCTz : elementCentralizerIn T z ≤ E)
    (hWE : W ≤ E) :
    T ≤ E := by
  rw [hgen]
  apply sup_le hCTW
  refine iSup_le ?_
  intro w
  intro x hx
  rcases Subgroup.mem_map.mp hx with ⟨c, hc, rfl⟩
  change (w : X) * c * (w : X)⁻¹ ∈ E
  exact E.mul_mem (E.mul_mem (hWE w.property) (hCTz hc))
    (E.inv_mem (hWE w.property))

