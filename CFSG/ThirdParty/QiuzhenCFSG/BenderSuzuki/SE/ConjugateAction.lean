module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.SE.StrongEmbedding

namespace CFSG
end CFSG
open CFSG

/-!
# The coset action attached to a strongly embedded subgroup

The transitive left action of `X` on `X ⧸ M` realizes the action on the
conjugates of `M`: the coset represented by `g` has stabilizer
`rightConjugate M g⁻¹`.  This file records that interface and turns the
involution-cover theorem into a fixed-point theorem for the action.
-/

noncomputable section

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1

universe u

/-- The canonical transitive `X`-set associated with the conjugates of `M`.
The coset represented by `g` corresponds to the right conjugate `M^(g⁻¹)`. -/
public abbrev conjugateCosetSpace {X : Type u} [Group X]
    (M : Subgroup X) : Type u :=
  X ⧸ M

/-- The left action on the conjugate coset space is transitive. -/
public theorem conjugateCosetSpace_isPretransitive
    {X : Type u} [Group X] (M : Subgroup X) :
    MulAction.IsPretransitive X (conjugateCosetSpace M) := by
  infer_instance

/-- An element fixes the coset represented by `g` exactly when it belongs to
the corresponding right conjugate `M^(g⁻¹)`. -/
public theorem fixed_coset_iff_mem_rightConjugate
    {X : Type u} [Group X] (M : Subgroup X) (g x : X) :
    x • (QuotientGroup.mk g : conjugateCosetSpace M) = QuotientGroup.mk g ↔
      x ∈ rightConjugate M g⁻¹ := by
  rw [MulAction.Quotient.smul_mk, QuotientGroup.eq]
  rw [rightConjugate]
  simp only [smul_eq_mul, mul_inv_rev, inv_inv]
  constructor
  · intro h
    refine ⟨g⁻¹ * x * g, ?_, ?_⟩
    · simpa [mul_assoc] using M.inv_mem h
    · change g * (g⁻¹ * x * g) * g⁻¹ = x
      group
  · rintro ⟨y, hy, rfl⟩
    simpa [mul_assoc] using M.inv_mem hy

/-- Point stabilizers in the coset action are the corresponding right
conjugates of `M`. -/
public theorem conjugateCoset_stabilizer
    {X : Type u} [Group X] (M : Subgroup X) (g : X) :
    MulAction.stabilizer X (QuotientGroup.mk g : conjugateCosetSpace M) =
      rightConjugate M g⁻¹ := by
  ext x
  rw [MulAction.mem_stabilizer_iff]
  exact fixed_coset_iff_mem_rightConjugate M g x

/-- The distinguished coset has stabilizer `M`. -/
public theorem baseCoset_stabilizer
    {X : Type u} [Group X] (M : Subgroup X) :
    MulAction.stabilizer X (QuotientGroup.mk 1 : conjugateCosetSpace M) = M := by
  calc
    MulAction.stabilizer X (QuotientGroup.mk 1 : conjugateCosetSpace M) =
        rightConjugate M (1 : X)⁻¹ := conjugateCoset_stabilizer M 1
    _ = M := by
      ext x
      simp [rightConjugate, Subgroup.conjBy]

namespace IsStronglyEmbedded

/-- Every involution fixes a point of the conjugate coset action. -/
public theorem involution_fixed_coset
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x : X} (hx : IsInvolution x) :
    ∃ ω : conjugateCosetSpace M, x • ω = ω := by
  obtain ⟨g, hxg⟩ := hM.involution_mem_conjugate hx
  refine ⟨QuotientGroup.mk g⁻¹, ?_⟩
  rw [fixed_coset_iff_mem_rightConjugate]
  simpa using hxg

/-- The cyclic subgroup generated by every involution has a nonempty
fixed-point set on the conjugate coset space. -/
public theorem involution_fixedPoints_nonempty
    {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (hM : IsStronglyEmbedded M) {x : X} (hx : IsInvolution x) :
    (fixedPointsOfSubgroup X (conjugateCosetSpace M)
      (Subgroup.zpowers x)).Nonempty := by
  obtain ⟨ω, hxω⟩ := hM.involution_fixed_coset hx
  refine ⟨ω, ?_⟩
  intro y hy
  have hxstab : x ∈ MulAction.stabilizer X ω :=
    MulAction.mem_stabilizer_iff.mpr hxω
  exact MulAction.mem_stabilizer_iff.mp
    ((Subgroup.zpowers_le.mpr hxstab) hy)

end IsStronglyEmbedded
end CFSG.BenderSuzuki
