/-!
# Corollary 7.13: checked assembly and source leaves

This file proves the group-action and subgroup glue surrounding Corollary 7.13
of `docs/cfsg-vol4.tex`.  In particular:

* the unique involution supplied by Lemma 3.12 inside `M ∩ F°` is also the
  unique involution of `M ∩ F`, and strong embedding identifies
  `M ∩ F = F ∩ C_X(u)`;
* the Frattini factorization `F = F° (F ∩ M)` identifies the `F`- and
  `F°`-orbits of the base point;
* two-transitivity of `F°` on that orbit implies the source factorization
  `F = F° F_{α,β}` for every nonbase point `β`;
* centerlessness of the recognized simple quotient supplies the reverse
  inclusion `Z(F°) ≤ O_{2'}(F°)`.

The final theorem has explicit hypotheses for the original source premises
`F ≰ M` and an involution in `F ∩ M`, plus the source results not yet available
on the checked SE import surface: Theorem 4(b) and the proper-subgroup
induction hypothesis for Theorem SE.  It derives the Lemma 3.12 fixed-coset
premise and solvable conclusion internally, as well as the
nonsolvable rank exclusion from the independent rank-one/Brauer--Suzuki
factorization, as well as Proposition 4.4 noncontainment, odd-core containment
and centrality, Bender recognition and the source Borel identification by
induction transport, Frattini normalizer control, and two-transitivity
internally.
-/

noncomputable section

open scoped Pointwise

namespace CFSG.BenderSuzuki

open PFAppendixIII PFchapter1section1

universe u

/-- Every involution of `F` lies in the copy of `⟨I(F)⟩` embedded in the
ambient group. -/
public theorem involution_mem_involutionCoreIn
    {X : Type u} [Group X] {F : Subgroup X} {x : X}
    (hxF : x ∈ F) (hx : IsInvolution x) :
    x ∈ involutionCoreIn F := by
  rw [involutionCoreIn, Subgroup.mem_map]
  refine ⟨⟨x, hxF⟩, ?_, rfl⟩
  rw [involutionCore_eq_closure]
  apply Subgroup.subset_closure
  exact ⟨by
    intro h
    exact hx.ne_one (congrArg Subtype.val h), by
    apply Subtype.ext
    exact hx.sq_eq_one⟩

/-- The embedded involution core of a subgroup is contained in that subgroup. -/
public theorem involutionCoreIn_le
    {X : Type u} [Group X] (F : Subgroup X) :
    involutionCoreIn F ≤ F := by
  intro x hx
  rw [involutionCoreIn, Subgroup.mem_map] at hx
  rcases hx with ⟨y, _hy, rfl⟩
  exact y.property

/-- A four-group in `M ∩ F°`, together with normality and coprime action,
proves Lemma 3.13's containment of `O_{2'}(F°)` in `M`. -/
public theorem corollary713_oddCore_le_M_of_twoRank_intersection
    {X : Type*} [Group X] [Finite X]
    (M F : Subgroup X)
    (hM : IsStronglyEmbedded M)
    (hrank : TwoRankAtLeastTwo
      (M.comap (involutionCoreIn F).subtype)) :
    (twoPrimeCore (involutionCoreIn F)).map
        (involutionCoreIn F).subtype ≤ M := by
  exact oddCore_map_le_stronglyEmbedded_of_twoRank_intersection
    M (involutionCoreIn F) hM hrank

/-- The embedded involution core is itself generated by its involutions. -/
public theorem involutionCore_involutionCoreIn_eq_top
    {X : Type u} [Group X] (F : Subgroup X) :
    involutionCore (involutionCoreIn F) = ⊤ := by
  let C : Subgroup F := involutionCore F
  let e : C ≃* involutionCoreIn F := by
    change C ≃* Subgroup.map F.subtype C
    exact Subgroup.equivMapOfInjective C F.subtype Subtype.val_injective
  have hCtop : involutionCore C = ⊤ := by
    simpa [C] using involutionCore_involutionCore_eq_top F
  have he_le : (involutionCore C).map e.toMonoidHom ≤
      involutionCore (involutionCoreIn F) := by
    rw [Subgroup.map_le_iff_le_comap]
    rw [involutionCore_eq_closure, Subgroup.closure_le]
    intro y hy
    change e y ∈ involutionCore (involutionCoreIn F)
    rw [involutionCore_eq_closure]
    apply Subgroup.subset_closure
    exact IsInvolution.map_of_injective hy e.toMonoidHom e.injective
  apply top_unique
  intro z _hz
  obtain ⟨y, rfl⟩ := e.surjective z
  apply he_le
  apply Subgroup.mem_map_of_mem e.toMonoidHom
  rw [hCtop]
  exact Subgroup.mem_top y

/-- Theorem SE for the strongly embedded subgroup of `F°` gives the exact
recognition and Borel data used by Corollary 7.13.  Since `F°` is itself
generated by involutions, its internal involution core is the whole group;
this theorem performs the resulting odd-core quotient and Borel transports. -/
public theorem corollary713_recognition_borel_of_theoremSEBenderConclusion
    {X : Type*} [Group X] [Finite X]
    (M F : Subgroup X)
    (hSE : TheoremSEBenderConclusion
      (M.comap (involutionCoreIn F).subtype)) :
    IsSimpleBenderGroup
        (involutionCoreIn F ⧸ twoPrimeCore (involutionCoreIn F)) ∧
      IsBorelSubgroup
        (((M ⊓ involutionCoreIn F).subgroupOf
            (involutionCoreIn F)).map
          (QuotientGroup.mk' (twoPrimeCore (involutionCoreIn F)))) := by
  let L : Subgroup X := involutionCoreIn F
  let ML : Subgroup L := M.comap L.subtype
  let C : Subgroup L := involutionCore L
  have hCtop : C = ⊤ := by
    simpa [C, L] using involutionCore_involutionCoreIn_eq_top F
  let e : C ≃* L :=
    { toFun := fun c => c
      invFun := fun l => ⟨l, by rw [hCtop]; exact Subgroup.mem_top l⟩
      left_inv := fun c => Subtype.ext rfl
      right_inv := fun l => rfl
      map_mul' := fun _ _ => rfl }
  have hcoremap :
      (twoPrimeCore C).map e.toMonoidHom = twoPrimeCore L := by
    simpa [twoPrimeCore] using
      (pPrimeCore_map_iso (p := 2) e)
  letI : ((twoPrimeCore C).map e.toMonoidHom).Normal :=
    Subgroup.Normal.map (inferInstance : (twoPrimeCore C).Normal)
      e.toMonoidHom e.surjective
  let q0 : (C ⧸ twoPrimeCore C) ≃*
      (L ⧸ (twoPrimeCore C).map e.toMonoidHom) :=
    quotientMulEquivOfMulEquiv e (twoPrimeCore C)
  let qeq : (L ⧸ (twoPrimeCore C).map e.toMonoidHom) ≃*
      (L ⧸ twoPrimeCore L) :=
    QuotientGroup.quotientMulEquivOfEq hcoremap
  let qe : (C ⧸ twoPrimeCore C) ≃*
      (L ⧸ twoPrimeCore L) := q0.trans qeq
  change TheoremSEBenderConclusion ML at hSE
  dsimp [TheoremSEBenderConclusion] at hSE
  change IsSimpleBenderGroup (C ⧸ twoPrimeCore C) ∧ _ at hSE
  have hbender : IsSimpleBenderGroup (L ⧸ twoPrimeCore L) :=
    hSE.1.map_mulEquiv qe
  let BC : Subgroup C := (ML ⊓ C).subgroupOf C
  let qC : C →* (C ⧸ twoPrimeCore C) :=
    QuotientGroup.mk' (twoPrimeCore C)
  let qL : L →* (L ⧸ twoPrimeCore L) :=
    QuotientGroup.mk' (twoPrimeCore L)
  have hBCmap : BC.map e.toMonoidHom = ML := by
    ext x
    constructor
    · rintro ⟨c, hc, rfl⟩
      exact hc.1
    · intro hx
      let c : C := e.symm x
      refine ⟨c, ?_, by simp [c]⟩
      have hxe : e c ∈ ML := by
        change x ∈ ML
        exact hx
      exact ⟨by
        change (e c : L) ∈ ML
        exact hxe, c.property⟩
  have hqcomp : qe.toMonoidHom.comp qC =
      qL.comp e.toMonoidHom := by
    apply MonoidHom.ext
    intro c
    change qe (QuotientGroup.mk c) = QuotientGroup.mk (e c)
    have hq0c : q0 (QuotientGroup.mk c) = QuotientGroup.mk (e c) := by
      exact quotientMulEquivOfMulEquiv_mk e (twoPrimeCore C) c
    have hqeqc : qeq (QuotientGroup.mk (e c)) =
        QuotientGroup.mk (e c) := by
      exact QuotientGroup.quotientMulEquivOfEq_mk hcoremap (e c)
    rw [show qe (QuotientGroup.mk c) =
      qeq (q0 (QuotientGroup.mk c)) by rfl, hq0c, hqeqc]
  let B0 : Subgroup (C ⧸ twoPrimeCore C) := BC.map qC
  let BL : Subgroup (L ⧸ twoPrimeCore L) := ML.map qL
  have hBmap : B0.map qe.toMonoidHom = BL := by
    calc
      B0.map qe.toMonoidHom =
          BC.map (qe.toMonoidHom.comp qC) := by
            simp [B0, Subgroup.map_map]
      _ = BC.map (qL.comp e.toMonoidHom) := by rw [hqcomp]
      _ = (BC.map e.toMonoidHom).map qL := by
            simp [Subgroup.map_map]
      _ = BL := by rw [hBCmap]
  have hB0 : IsBorelSubgroup B0 := by
    exact hSE.2.2
  have hBL : IsBorelSubgroup BL := by
    rw [← hBmap]
    exact hB0.map_mulEquiv qe
  refine ⟨?_, ?_⟩
  · simpa [L] using hbender
  · have hML : (M ⊓ L).subgroupOf L = ML := by
      ext x
      change ((x : X) ∈ M ∧ (x : X) ∈ L) ↔ (x : X) ∈ M
      simp
    simpa [L, BL, qL, hML] using hBL

/-- Proposition 4.4 noncontainment in the strongly embedded specialization:
if `F` is not contained in `M` but `F ∩ M` contains an involution, then the
involution core of `F` is not contained in `M`. -/
public theorem proposition44_involutionCore_not_le
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X) (hM : IsStronglyEmbedded M)
    (hFnotle : ¬ F ≤ M)
    {u : X} (huFM : u ∈ F ⊓ M) (hu : IsInvolution u) :
    ¬ involutionCoreIn F ≤ M := by
  intro hcore
  apply hFnotle
  intro g hgF
  by_contra hgM
  let v : X := rightConjugateElem u g
  have hvF : v ∈ F := by
    dsimp [v, rightConjugateElem]
    exact F.mul_mem (F.mul_mem (F.inv_mem hgF) huFM.1) hgF
  have hv : IsInvolution v := isInvolution_rightConjugateElem hu
  have hvM : v ∈ M :=
    hcore (involution_mem_involutionCoreIn hvF hv)
  have hvright : v ∈ rightConjugate M g :=
    rightConjugateElem_mem_rightConjugate huFM.2
  exact hgM (hM.mem_of_involution_mem_rightConjugate hvM hvright hv)

/-- Lemma 3.13's containment of the odd core in `M`, together with Theorem
4(b), forces the chosen involution to centralize that odd core.  Normality
inside `F°` makes the odd core fix both the base coset and a distinct coset
coming from `F° ≰ M`, so the unique-fixed-point alternative is impossible. -/
public theorem corollary713_oddCore_le_centralizer_of_theorem4b
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X)
    (h4b : Theorem4bAtBase M)
    (hnotle : ¬ involutionCoreIn F ≤ M)
    {u : X} (huFM : u ∈ F ⊓ M) (hu : IsInvolution u)
    (hcoreM :
      (twoPrimeCore (involutionCoreIn F)).map
          (involutionCoreIn F).subtype ≤ M) :
    (twoPrimeCore (involutionCoreIn F)).map
        (involutionCoreIn F).subtype ≤
      Subgroup.centralizer ({u} : Set X) := by
  let L : Subgroup X := involutionCoreIn F
  let K : Subgroup L := twoPrimeCore L
  let W : Subgroup X := K.map L.subtype
  have hWL : W ≤ L := by
    intro x hx
    rcases hx with ⟨k, hk, rfl⟩
    exact k.property
  have hWsub : W.subgroupOf L = K := by
    change W.comap L.subtype = K
    dsimp [W]
    exact Subgroup.comap_map_eq_self_of_injective Subtype.val_injective K
  have hWnormalL : (W.subgroupOf L).Normal := by
    rw [hWsub]
    infer_instance
  have hLnormW : L ≤ Subgroup.normalizer (W : Set X) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hWL).mp hWnormalL
  have huL : u ∈ L := by
    dsimp [L]
    exact involution_mem_involutionCoreIn huFM.1 hu
  have huNormW : u ∈ Subgroup.normalizer (W : Set X) := hLnormW huL
  have hWM : W ≤ M := by
    simpa [W, K, L] using hcoreM
  have hWodd : Odd (Nat.card W) := by
    have hcard : Nat.card W = Nat.card K :=
      Subgroup.card_map_of_injective Subtype.val_injective
    rw [hcard]
    exact Nat.coprime_two_left.mp (by
      simpa [K, twoPrimeCore] using
        (pPrimeCore_coprime_card (p := 2) (G := L)))
  obtain ⟨g, hgL, hgM⟩ : ∃ g : X, g ∈ L ∧ g ∉ M := by
    by_contra h
    push_neg at h
    exact hnotle h
  let alpha : conjugateCosetSpace M := QuotientGroup.mk 1
  let beta : conjugateCosetSpace M := QuotientGroup.mk g
  have halpha : alpha ∈
      fixedPointsOfSubgroup X (conjugateCosetSpace M) W :=
    theorem4b_baseCoset_mem_fixedPoints hWM
  have hbeta : beta ∈
      fixedPointsOfSubgroup X (conjugateCosetSpace M) W := by
    intro w hw
    apply MulAction.mem_stabilizer_iff.mp
    rw [show MulAction.stabilizer X beta = rightConjugate M g⁻¹ by
      simpa [beta] using conjugateCoset_stabilizer M g]
    rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map]
    let w' : X := g⁻¹ * w * g
    have hginvNorm : g⁻¹ ∈ Subgroup.normalizer (W : Set X) :=
      (Subgroup.normalizer (W : Set X)).inv_mem (hLnormW hgL)
    have hw'W : w' ∈ W := by
      simpa [w'] using (Subgroup.mem_normalizer_iff.mp hginvNorm w).mp hw
    refine ⟨w', hWM hw'W, ?_⟩
    simp [w', mul_assoc]
  have hab : alpha ≠ beta := by
    intro h
    apply hgM
    have heq : (QuotientGroup.mk 1 : conjugateCosetSpace M) =
        QuotientGroup.mk g := by simpa [alpha, beta] using h
    simpa using QuotientGroup.eq.mp heq
  let p0 : theorem4bFixedPoints M W := ⟨alpha, halpha⟩
  let p1 : theorem4bFixedPoints M W := ⟨beta, hbeta⟩
  let f : Fin 2 → theorem4bFixedPoints M W := ![p0, p1]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · rfl
    · exfalso
      have hp : p0 = p1 := by simpa [f, p0, p1] using hij
      exact hab (congrArg (fun z : theorem4bFixedPoints M W =>
        (z : conjugateCosetSpace M)) hp)
    · exfalso
      have hp : p1 = p0 := by simpa [f, p0, p1] using hij
      exact hab.symm (congrArg (fun z : theorem4bFixedPoints M W =>
        (z : conjugateCosetSpace M)) hp)
    · rfl
  have hfixed : 2 ≤ Nat.card (theorem4bFixedPoints M W) := by
    simpa using Nat.card_le_card_of_injective f hf
  exact h4b.centralizes_of_two_le_fixedPoints_card
    hu huFM.2 hWodd hWM huNormW hfixed

/-- Centralization of the odd core by one source involution implies that the
odd core of `F°` is central.  Strong embedding restricts to `M ∩ F°`, so all
involutions of `F°` are conjugate; normality transports the one centralizer
inclusion across that conjugacy class, and the involutions generate `F°`. -/
public theorem corollary713_oddCore_le_center_of_one_involution
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X) (hM : IsStronglyEmbedded M)
    (hnotle : ¬ involutionCoreIn F ≤ M)
    {u : X} (huFM : u ∈ F ⊓ M) (hu : IsInvolution u)
    (huCentral :
      (twoPrimeCore (involutionCoreIn F)).map
          (involutionCoreIn F).subtype ≤
        Subgroup.centralizer ({u} : Set X)) :
    twoPrimeCore (involutionCoreIn F) ≤
      Subgroup.center (involutionCoreIn F) := by
  let L : Subgroup X := involutionCoreIn F
  have huLmem : u ∈ L := by
    change u ∈ involutionCoreIn F
    exact involution_mem_involutionCoreIn huFM.1 hu
  let uL : L := ⟨u, huLmem⟩
  have huL : IsInvolution uL := IsInvolution.subtype hu huLmem
  let ML : Subgroup L := M.comap L.subtype
  have huML : uL ∈ ML := huFM.2
  have hMLproper : ML ≠ ⊤ := by
    intro htop
    apply hnotle
    intro x hxL
    let xL : L := ⟨x, hxL⟩
    have hxTop : xL ∈ (⊤ : Subgroup L) := Subgroup.mem_top xL
    rw [← htop] at hxTop
    exact hxTop
  have hML : IsStronglyEmbedded ML :=
    hM.comap_of_injective L.subtype Subtype.val_injective
      hMLproper ⟨uL, huML, huL⟩
  have huCentralL :
      twoPrimeCore L ≤ Subgroup.centralizer ({uL} : Set L) := by
    intro q hq
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    apply Subtype.ext
    exact Subgroup.mem_centralizer_singleton_iff.mp
      (huCentral (Subgroup.mem_map_of_mem L.subtype hq))
  have hgenL : involutionCore L = ⊤ := by
    simpa [L] using involutionCore_involutionCoreIn_eq_top F
  change twoPrimeCore L ≤ Subgroup.center L
  exact hML.twoPrimeCore_le_center_of_involutionCore_eq_top
    huL huCentralL hgenL

/-- The source premise that `F ∩ M` contains an involution, together with
strong embedding and `F° ≰ M`, supplies the Sylow-normalizer control needed
for the Frattini argument. -/
public theorem corollary713_frattini_normalizer_control
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X) (hM : IsStronglyEmbedded M)
    (hnotle : ¬ involutionCoreIn F ≤ M)
    {u : X} (huFM : u ∈ F ⊓ M) (hu : IsInvolution u) :
    HasInvolutionCoreSylowNormalizerIn M F := by
  let MF : Subgroup F := M.comap F.subtype
  have hFnotle : ¬ F ≤ M := by
    intro hFM
    exact hnotle ((involutionCoreIn_le F).trans hFM)
  have hMFproper : MF ≠ ⊤ := by
    intro htop
    apply hFnotle
    intro x hxF
    let xF : F := ⟨x, hxF⟩
    have hxTop : xF ∈ (⊤ : Subgroup F) := Subgroup.mem_top xF
    rw [← htop] at hxTop
    exact hxTop
  let uF : F := ⟨u, huFM.1⟩
  have huF : IsInvolution uF := IsInvolution.subtype hu huFM.1
  have huMF : uF ∈ MF := huFM.2
  have hMF : IsStronglyEmbedded MF :=
    hM.comap_of_injective F.subtype Subtype.val_injective
      hMFproper ⟨uF, huMF, huF⟩
  let C : Subgroup F := involutionCore F
  have huC : uF ∈ C := by
    change uF ∈ involutionCore F
    rw [involutionCore_eq_closure]
    exact Subgroup.subset_closure huF
  have hCnotle : ¬ C ≤ MF := by
    intro hCM
    apply hnotle
    rw [involutionCoreIn, Subgroup.map_le_iff_le_comap]
    exact hCM
  have hMCproper : MF.comap C.subtype ≠ ⊤ := by
    intro htop
    apply hCnotle
    intro x hxC
    let xC : C := ⟨x, hxC⟩
    have hxTop : xC ∈ (⊤ : Subgroup C) := Subgroup.mem_top xC
    rw [← htop] at hxTop
    exact hxTop
  let uC : C := ⟨uF, huC⟩
  have huCinv : IsInvolution uC := IsInvolution.subtype huF huC
  have huMC : uC ∈ MF.comap C.subtype := huMF
  have hMC : IsStronglyEmbedded (MF.comap C.subtype) :=
    hMF.comap_of_injective C.subtype Subtype.val_injective
      hMCproper ⟨uC, huMC, huCinv⟩
  obtain ⟨P, hP⟩ := hMC.containsSylowTwo
  refine ⟨P, ?_⟩
  let Q : Subgroup F :=
    (P : Subgroup C).map C.subtype
  change Subgroup.normalizer (Q : Set F) ≤ MF
  have hQMF : Q ≤ MF := by
    rw [Subgroup.map_le_iff_le_comap]
    exact hP
  have hCtwo : 2 ∣ Nat.card C :=
    (even_iff_two_dvd.mp hMC.card_even).trans
      (Subgroup.card_subgroup_dvd_card (MF.comap C.subtype))
  have hPtwo : 2 ∣ Nat.card (P : Subgroup C) :=
    P.dvd_card_of_dvd_card hCtwo
  obtain ⟨x, hxorder⟩ :=
    exists_prime_orderOf_dvd_card'
      (G := (P : Subgroup C)) 2 hPtwo
  have hxInvP : IsInvolution x := by
    have hxdata := orderOf_eq_prime_iff.mp hxorder
    exact ⟨hxdata.2, hxdata.1⟩
  let xC : C := (x : C)
  let xF : F := (xC : F)
  have hxInvC : IsInvolution xC :=
    IsInvolution.map_of_injective hxInvP
      (P : Subgroup C).subtype Subtype.val_injective
  have hxInvF : IsInvolution xF :=
    IsInvolution.map_of_injective hxInvC C.subtype Subtype.val_injective
  have hxQ : xF ∈ Q :=
    Subgroup.mem_map_of_mem C.subtype x.property
  have hxMF : xF ∈ MF := hQMF hxQ
  intro g hg
  apply hMF.mem_of_involution_mem_rightConjugate hxMF ?_ hxInvF
  have hyQ : g * xF * g⁻¹ ∈ Q :=
    (Subgroup.mem_normalizer_iff.mp hg xF).mp hxQ
  have hyMF : g * xF * g⁻¹ ∈ MF := hQMF hyQ
  rw [rightConjugate, Subgroup.conjBy, Subgroup.mem_map]
  refine ⟨g * xF * g⁻¹, hyMF, ?_⟩
  simp [mul_assoc]

/-- If a quotient by a normal subgroup is centerless, the center of the
original group lies in the quotient kernel. -/
public theorem center_le_normal_of_quotient_center_eq_bot
    {G : Type u} [Group G] (N : Subgroup G) [N.Normal]
    (hcenter : Subgroup.center (G ⧸ N) = ⊥) :
    Subgroup.center G ≤ N := by
  intro z hz
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have hqz : q z ∈ Subgroup.center (G ⧸ N) := by
    rw [Subgroup.mem_center_iff]
    intro y
    rcases QuotientGroup.mk'_surjective N y with ⟨x, rfl⟩
    simpa [q] using congrArg q (Subgroup.mem_center_iff.mp hz x)
  rw [hcenter] at hqz
  have hqz_one : q z = 1 := by simpa using hqz
  exact (QuotientGroup.eq_one_iff z).mp hqz_one

/-- A noncommutative simple group is centerless. -/
public theorem center_eq_bot_of_isSimpleGroup_of_not_commutative
    {G : Type u} [Group G] (hsimple : IsSimpleGroup G)
    (hnoncommutative : ¬ ∀ x y : G, x * y = y * x) :
    Subgroup.center G = ⊥ := by
  let : IsSimpleGroup G := hsimple
  rcases (IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center G)) with hcenter | hcenter
  · exact hcenter
  · exfalso
    apply hnoncommutative
    intro x y
    have hx : x ∈ Subgroup.center G := by rw [hcenter]; simp
    exact (Subgroup.mem_center_iff.mp hx y).symm

/-- Checked solvable-case glue after Lemma 3.12 has supplied the unique
involution of `M ∩ F°`. -/
public theorem corollary713_solvable_of_unique_core_involution
    {X : Type u} [Group X] [Finite X]
    {M F : Subgroup X} (hM : IsStronglyEmbedded M)
    (hsolv : IsSolvable (involutionCoreIn F))
    {u : X} (huCoreM : u ∈ involutionCoreIn F ⊓ M)
    (hu : IsInvolution u)
    (hunique : ∀ v : X,
      v ∈ involutionCoreIn F ⊓ M → IsInvolution v → v = u) :
    Corollary713SolvableConclusion M F := by
  have huFM : u ∈ F ⊓ M := ⟨involutionCoreIn_le F huCoreM.1, huCoreM.2⟩
  refine ⟨hsolv, u, huFM, hu, ?_, ?_⟩
  · intro v hvFM hv
    apply hunique v
    exact ⟨involution_mem_involutionCoreIn hvFM.1 hv, hvFM.2⟩
    exact hv
  · apply le_antisymm
    · intro x hxFM
      refine ⟨hxFM.1, ?_⟩
      change x ∈ Subgroup.centralizer ({u} : Set X)
      rw [Subgroup.mem_centralizer_singleton_iff]
      let v : X := rightConjugateElem u x
      have hvF : v ∈ F := by
        dsimp [v, rightConjugateElem]
        exact F.mul_mem (F.mul_mem (F.inv_mem hxFM.1) huFM.1) hxFM.1
      have hvM : v ∈ M := by
        dsimp [v, rightConjugateElem]
        exact M.mul_mem (M.mul_mem (M.inv_mem hxFM.2) huFM.2) hxFM.2
      have hv : IsInvolution v := isInvolution_rightConjugateElem hu
      have hvcore : v ∈ involutionCoreIn F :=
        involution_mem_involutionCoreIn hvF hv
      have hvu : v = u := hunique v ⟨hvcore, hvM⟩ hv
      have hmul := congrArg (fun y : X => x * y) hvu
      simpa [v, rightConjugateElem, mul_assoc] using hmul.symm
    · intro x hx
      exact ⟨hx.1, hM.centralizer_le huFM.2 hu hx.2⟩

/-- In a two-transitive orbit, every element of `F` is a product of an
element of `F0` and an element fixing two prescribed distinct points. -/
public theorem set_eq_mul_twoPointStabilizer_of_twoTransitiveOn
    {X Ω : Type u} [Group X] [MulAction X Ω]
    (F F0 : Subgroup X) (alpha beta : Ω)
    (hF0F : F0 ≤ F)
    (htwo : IsTwoTransitiveOn F0 {omega : Ω | InOrbit F alpha omega})
    (hbeta : InOrbit F alpha beta) (hbeta_ne : beta ≠ alpha) :
    (F : Set X) =
      (F0 : Set X) *
        ((F ⊓ MulAction.stabilizer X alpha ⊓
          MulAction.stabilizer X beta : Subgroup X) : Set X) := by
  apply Set.Subset.antisymm
  · intro x hxF
    let xf : F := ⟨x, hxF⟩
    have halpha : InOrbit F alpha alpha := ⟨1, by simp⟩
    have hxalpha : InOrbit F alpha (x • alpha) := ⟨xf, rfl⟩
    have hxbeta : InOrbit F alpha (x • beta) := by
      rcases hbeta with ⟨f, hf⟩
      refine ⟨xf * f, ?_⟩
      rw [show ((xf * f : F) : X) = x * (f : X) by rfl, mul_smul, hf]
    have himages_ne : x • alpha ≠ x • beta := by
      intro h
      apply hbeta_ne
      exact (MulAction.injective x h).symm
    obtain ⟨f0, hf0alpha, hf0beta⟩ :=
      htwo halpha hbeta hxalpha hxbeta hbeta_ne.symm himages_ne
    let h : X := (f0 : X)⁻¹ * x
    have hhF : h ∈ F := F.mul_mem (F.inv_mem (hF0F f0.property)) hxF
    have hhAlpha : h ∈ MulAction.stabilizer X alpha := by
      change h • alpha = alpha
      dsimp [h]
      rw [mul_smul, ← hf0alpha]
      simp
    have hhBeta : h ∈ MulAction.stabilizer X beta := by
      change h • beta = beta
      dsimp [h]
      rw [mul_smul, ← hf0beta]
      simp
    rw [Set.mem_mul]
    refine ⟨(f0 : X), f0.property, h, ⟨⟨hhF, hhAlpha⟩, hhBeta⟩, ?_⟩
    simp [h]
  · intro x hx
    rw [Set.mem_mul] at hx
    rcases hx with ⟨a, haF0, b, hb, rfl⟩
    exact F.mul_mem (hF0F haF0) hb.1.1

/-- Transport two-transitivity across an equality of the relevant orbits. -/
public theorem twoTransitiveOn_orbit_of_orbit_iff
    {X Ω : Type u} [Group X] [MulAction X Ω]
    (F F0 : Subgroup X) (alpha : Ω)
    (horbit : ∀ omega : Ω,
      InOrbit F alpha omega ↔ InOrbit F0 alpha omega)
    (htwo : IsTwoTransitiveOn F0
      {omega : Ω | InOrbit F0 alpha omega}) :
    IsTwoTransitiveOn F0 {omega : Ω | InOrbit F alpha omega} := by
  intro a b c d ha hb hc hd hab hcd
  exact htwo ((horbit a).mp ha) ((horbit b).mp hb)
    ((horbit c).mp hc) ((horbit d).mp hd) hab hcd

/-- A factorization by a subgroup of the point stabilizer identifies the
orbits of the large and small factors. -/
public theorem inOrbit_iff_of_eq_mul_pointStabilizer
    {X Ω : Type u} [Group X] [MulAction X Ω]
    (F F0 : Subgroup X) (alpha omega : Ω)
    (hF0F : F0 ≤ F)
    (hfactor : (F : Set X) =
      (F0 : Set X) *
        ((F ⊓ MulAction.stabilizer X alpha : Subgroup X) : Set X)) :
    InOrbit F alpha omega ↔ InOrbit F0 alpha omega := by
  constructor
  · rintro ⟨f, hf⟩
    have hfF : (f : X) ∈
        (F0 : Set X) *
          ((F ⊓ MulAction.stabilizer X alpha : Subgroup X) : Set X) := by
      rw [← hfactor]
      exact f.property
    rw [Set.mem_mul] at hfF
    rcases hfF with ⟨a, haF0, b, hb, hab⟩
    let a0 : F0 := ⟨a, haF0⟩
    refine ⟨a0, ?_⟩
    calc
      (a0 : X) • alpha = (a * b) • alpha := by
        rw [mul_smul, show b • alpha = alpha by exact hb.2]
      _ = (f : X) • alpha := by rw [hab]
      _ = omega := hf
  · rintro ⟨f0, hf0⟩
    exact ⟨⟨(f0 : X), hF0F f0.property⟩, hf0⟩

/-- The literal Frattini equality from Corollary 7.13 identifies the `F`-orbit
of the base coset with the `F°`-orbit. -/
public theorem involutionCore_orbit_iff_of_frattini_factorization
    {X : Type u} [Group X]
    (M F : Subgroup X)
    (hfrattini : (F : Set X) =
      (involutionCoreIn F : Set X) * ((F ⊓ M : Subgroup X) : Set X))
    (omega : conjugateCosetSpace M) :
    InOrbit F (QuotientGroup.mk 1) omega ↔
      InOrbit (involutionCoreIn F) (QuotientGroup.mk 1) omega := by
  apply inOrbit_iff_of_eq_mul_pointStabilizer
    F (involutionCoreIn F) (QuotientGroup.mk 1) omega
      (involutionCoreIn_le F)
  simpa [baseCoset_stabilizer M] using hfrattini

/-- Frattini's argument inside `F`: normalizer control for a Sylow `2`-subgroup
of `F°` gives the literal source factorization `F = F° (F ∩ M)`. -/
public theorem involutionCoreIn_frattini_factorization
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X)
    (hfrattiniNormalizer : HasInvolutionCoreSylowNormalizerIn M F) :
    (F : Set X) =
      (involutionCoreIn F : Set X) * ((F ⊓ M : Subgroup X) : Set X) := by
  rcases hfrattiniNormalizer with ⟨P, hnormalizer⟩
  let Q : Subgroup F :=
    (P : Subgroup (involutionCore F)).map (involutionCore F).subtype
  have hQle : Subgroup.normalizer (Q : Set F) ≤ M.comap F.subtype := by
    simpa [Q] using hnormalizer
  have hfrattini :
      Subgroup.normalizer (Q : Set F) ⊔ involutionCore F = ⊤ := by
    simpa [Q] using Sylow.normalizer_sup_eq_top P
  have hsup : involutionCore F ⊔ M.comap F.subtype = ⊤ := by
    apply top_unique
    rw [← hfrattini]
    calc
      Subgroup.normalizer (Q : Set F) ⊔ involutionCore F ≤
          M.comap F.subtype ⊔ involutionCore F :=
        sup_le_sup hQle le_rfl
      _ = involutionCore F ⊔ M.comap F.subtype := sup_comm _ _
  have hmulF :
      (involutionCore F : Set F) * (M.comap F.subtype : Set F) =
        Set.univ := by
    rw [← Subgroup.normal_mul (involutionCore F) (M.comap F.subtype), hsup]
    rfl
  apply Set.Subset.antisymm
  · intro x hxF
    let xf : F := ⟨x, hxF⟩
    have hxf : xf ∈
        (involutionCore F : Set F) * (M.comap F.subtype : Set F) := by
      rw [hmulF]
      exact Set.mem_univ xf
    rw [Set.mem_mul] at hxf ⊢
    rcases hxf with ⟨a, ha, b, hb, hab⟩
    refine ⟨(a : X), ?_, (b : X), ?_, ?_⟩
    · change (a : X) ∈ (involutionCore F).map F.subtype
      exact ⟨a, ha, rfl⟩
    · exact ⟨b.property, hb⟩
    · simpa [xf] using congrArg Subtype.val hab
  · intro x hx
    rw [Set.mem_mul] at hx
    rcases hx with ⟨a, ha, b, hb, rfl⟩
    exact F.mul_mem (involutionCoreIn_le F ha) hb.1

/-- Bender recognition plus the source Borel subgroup in the central
quotient gives two-transitivity of `F°` on its base-coset orbit. -/
public theorem corollary713_core_twoTransitive_of_bender_borel
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X)
    (hcore_le_M :
      (twoPrimeCore (involutionCoreIn F)).map
          (involutionCoreIn F).subtype ≤ M)
    (hbender : IsSimpleBenderGroup
      (involutionCoreIn F ⧸ twoPrimeCore (involutionCoreIn F)))
    (hBorel : IsBorelSubgroup
      (((M ⊓ involutionCoreIn F).subgroupOf (involutionCoreIn F)).map
        (QuotientGroup.mk' (twoPrimeCore (involutionCoreIn F))))) :
    IsTwoTransitiveOn (involutionCoreIn F)
      {omega : conjugateCosetSpace M |
        InOrbit (involutionCoreIn F) (QuotientGroup.mk 1) omega} := by
  let alpha : conjugateCosetSpace M := QuotientGroup.mk 1
  apply isTwoTransitiveOn_orbit_of_quotient_image
    (involutionCoreIn F) alpha
      (twoPrimeCore (involutionCoreIn F))
  · intro z hz
    change (z : X) ∈ MulAction.stabilizer X alpha
    rw [show MulAction.stabilizer X alpha = M by
      simpa [alpha] using baseCoset_stabilizer M]
    exact hcore_le_M
      (Subgroup.mem_map_of_mem (involutionCoreIn F).subtype hz)
  · have hpoint :
        pointStabilizerIn (involutionCoreIn F) alpha =
          (M ⊓ involutionCoreIn F).subgroupOf (involutionCoreIn F) := by
      ext z
      simp [pointStabilizerIn, alpha, baseCoset_stabilizer]
    rw [hpoint]
    exact simpleBender_borel_coset_twoTransitive hBorel hbender

/-- Checked nonsolvable-case assembly.  The hypotheses are the separate source
outputs: odd-core centralization, Bender recognition, Sylow-normalizer control
for the Frattini argument, and two-transitivity on the `F°`-orbit. -/
public theorem corollary713_nonsolvable_of_structure
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X)
    (hcore_le_center : twoPrimeCore (involutionCoreIn F) ≤
      Subgroup.center (involutionCoreIn F))
    (hbender : IsSimpleBenderGroup
      (involutionCoreIn F ⧸ twoPrimeCore (involutionCoreIn F)))
    (hfrattiniNormalizer : HasInvolutionCoreSylowNormalizerIn M F)
    (htwo_core : IsTwoTransitiveOn (involutionCoreIn F)
      {omega : conjugateCosetSpace M |
        InOrbit (involutionCoreIn F) (QuotientGroup.mk 1) omega}) :
    Corollary713NonsolvableConclusion M F := by
  dsimp [Corollary713NonsolvableConclusion]
  have hfrattini :=
    involutionCoreIn_frattini_factorization M F hfrattiniNormalizer
  have hquotient_center : Subgroup.center
      (involutionCoreIn F ⧸ twoPrimeCore (involutionCoreIn F)) = ⊥ :=
    center_eq_bot_of_isSimpleGroup_of_not_commutative
      hbender.isSimple hbender.not_commutative
  have hcenter_le_core : Subgroup.center (involutionCoreIn F) ≤
      twoPrimeCore (involutionCoreIn F) :=
    center_le_normal_of_quotient_center_eq_bot
      (twoPrimeCore (involutionCoreIn F)) hquotient_center
  have hcore : twoPrimeCore (involutionCoreIn F) =
      Subgroup.center (involutionCoreIn F) :=
    le_antisymm hcore_le_center hcenter_le_core
  have htwo : IsTwoTransitiveOn (involutionCoreIn F)
      {omega : conjugateCosetSpace M |
        InOrbit F (QuotientGroup.mk 1) omega} :=
    twoTransitiveOn_orbit_of_orbit_iff F (involutionCoreIn F)
      (QuotientGroup.mk 1)
      (involutionCore_orbit_iff_of_frattini_factorization M F hfrattini)
      htwo_core
  refine ⟨hcore, hbender, htwo, ?_⟩
  intro beta hbeta hbeta_ne
  exact set_eq_mul_twoPointStabilizer_of_twoTransitiveOn
    F (involutionCoreIn F) (QuotientGroup.mk 1) beta
      (involutionCoreIn_le F) htwo hbeta hbeta_ne

private theorem twoRankAtLeastTwo_of_injective
    {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Injective f)
    (hG : TwoRankAtLeastTwo G) :
    TwoRankAtLeastTwo H := by
  rcases hG with ⟨E, hEcard, hEsq⟩
  let EH : Subgroup H := E.map f
  have hEHcard : Nat.card EH = 4 := by
    rw [Subgroup.card_map_of_injective hf]
    exact hEcard
  refine ⟨EH, hEHcard, ?_⟩
  rintro ⟨x, hx⟩
  rcases hx with ⟨y, hy, rfl⟩
  apply Subtype.ext
  have hy_sq : y ^ 2 = (1 : G) :=
    congrArg (fun z : E => (z : G)) (hEsq ⟨y, hy⟩)
  simpa using congrArg f hy_sq

/-- Corollary 7.13 together with the Borel witness used in Proposition 8.4.
The numbered corollary itself does not state this witness, but its nonsolvable
proof obtains it from the proper-subgroup Theorem SE induction hypothesis
before using the model action. -/
@[expose] public def Corollary713BorelConclusion
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X) : Prop :=
  ¬ involutionCoreIn F ≤ M ∧
    (Corollary713SolvableConclusion M F ∨
      (¬ IsSolvable (involutionCoreIn F) ∧
        Corollary713NonsolvableConclusion M F ∧
        IsBorelSubgroup
          (((M ⊓ involutionCoreIn F).subgroupOf
              (involutionCoreIn F)).map
            (QuotientGroup.mk' (twoPrimeCore (involutionCoreIn F))))))

/-- Source-level Corollary 7.13 with the nonsolvable Borel witness retained
for later use. -/
public theorem corollary713_borel_of_source_endpoints
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X) (hM : IsStronglyEmbedded M)
    (h4b : Theorem4bAtBase M)
    (hFnotle : ¬ F ≤ M)
    (hFproper : F ≠ ⊤)
    (hinduction : ∀ (H : Subgroup X), H ≠ ⊤ →
      ∀ (N : Subgroup H), IsStronglyEmbedded N →
        TheoremSEConclusion N)
    {u : X} (huFM : u ∈ F ⊓ M) (hu : IsInvolution u) :
    Corollary713BorelConclusion M F := by
  have hnotle :=
    proposition44_involutionCore_not_le M F hM hFnotle huFM hu
  refine ⟨hnotle, ?_⟩
  by_cases hsolv : IsSolvable (involutionCoreIn F)
  · left
    let L : Subgroup X := involutionCoreIn F
    let ML : Subgroup L := M.comap L.subtype
    have huLmem : u ∈ L := by
      change u ∈ involutionCoreIn F
      exact involution_mem_involutionCoreIn huFM.1 hu
    let uL : L := ⟨u, huLmem⟩
    have huL : IsInvolution uL := IsInvolution.subtype hu huLmem
    have huML : uL ∈ ML := huFM.2
    have hMLproper : ML ≠ ⊤ := by
      intro htop
      apply hnotle
      intro x hxL
      let xL : L := ⟨x, hxL⟩
      have hxTop : xL ∈ (⊤ : Subgroup L) := Subgroup.mem_top xL
      rw [← htop] at hxTop
      exact hxTop
    have hML : IsStronglyEmbedded ML :=
      hM.comap_of_injective L.subtype Subtype.val_injective
        hMLproper ⟨uL, huML, huL⟩
    have hLeven : Even (Nat.card L) := by
      apply even_iff_two_dvd.mpr
      have huOrder : orderOf uL = 2 :=
        orderOf_eq_prime huL.sq_eq_one huL.ne_one
      rw [← huOrder]
      exact orderOf_dvd_natCard uL
    have hfixed : Lemma312FixedPointCondition ML uL :=
      lemma312_fixedPointCondition_of_theorem4b_comap
        M L hM h4b huML huL
    have h312 := lemma_3_12 ML (show IsSolvable L from hsolv)
      hLeven hML huML huL hfixed
    have huCoreM : u ∈ involutionCoreIn F ⊓ M := ⟨huLmem, huFM.2⟩
    have hunique : ∀ v : X, v ∈ involutionCoreIn F ⊓ M →
        IsInvolution v → v = u := by
      intro v hvCoreM hv
      let vL : L := ⟨v, hvCoreM.1⟩
      have hvL : IsInvolution vL := IsInvolution.subtype hv hvCoreM.1
      have hvML : vL ∈ ML := hvCoreM.2
      exact congrArg Subtype.val (h312.2 vL hvML hvL)
    exact corollary713_solvable_of_unique_core_involution
      hM hsolv huCoreM hu hunique
  · right
    let L : Subgroup X := involutionCoreIn F
    let ML : Subgroup L := M.comap L.subtype
    have hLproper : L ≠ ⊤ := by
      intro hLtop
      apply hFproper
      apply top_unique
      rw [← hLtop]
      simpa [L] using involutionCoreIn_le F
    have huLmem : u ∈ L := by
      change u ∈ involutionCoreIn F
      exact involution_mem_involutionCoreIn huFM.1 hu
    let uL : L := ⟨u, huLmem⟩
    have huL : IsInvolution uL := IsInvolution.subtype hu huLmem
    have huML : uL ∈ ML := huFM.2
    have hMLproper : ML ≠ ⊤ := by
      intro htop
      apply hnotle
      intro x hxL
      let xL : L := ⟨x, hxL⟩
      have hxTop : xL ∈ (⊤ : Subgroup L) := Subgroup.mem_top xL
      rw [← htop] at hxTop
      exact hxTop
    have hML : IsStronglyEmbedded ML :=
      hM.comap_of_injective L.subtype Subtype.val_injective
        hMLproper ⟨uL, huML, huL⟩
    have hCtop : involutionCore L = ⊤ := by
      simpa [L] using involutionCore_involutionCoreIn_eq_top F
    have hLnotSolvable : ¬ IsSolvable L := by
      simpa [L] using hsolv
    have hrank : TwoRankAtLeastTwo ML :=
      hML.twoRankAtLeastTwo_of_not_solvable_of_involutionCore_eq_top
        hCtop hLnotSolvable
    have hSE : TheoremSEBenderConclusion ML := by
      have hrankL : TwoRankAtLeastTwo L :=
        twoRankAtLeastTwo_of_injective ML.subtype
          Subtype.val_injective hrank
      let eC : involutionCore L ≃* L :=
        (MulEquiv.subgroupCongr hCtop).trans Subgroup.topEquiv
      have hrankC : TwoRankAtLeastTwo (involutionCore L) :=
        twoRankAtLeastTwo_of_injective eC.symm.toMonoidHom
          eC.symm.injective hrankL
      have hIH : TheoremSEConclusion ML :=
        hinduction L hLproper ML hML
      change ¬ TwoRankAtLeastTwo (involutionCore L) ∨
        TheoremSEBenderConclusion ML at hIH
      rcases hIH with hnorank | hSE
      · exact (hnorank hrankC).elim
      · exact hSE
    rcases corollary713_recognition_borel_of_theoremSEBenderConclusion M F hSE with
      ⟨hbender, hBorel⟩
    have hcore_le_M :=
      corollary713_oddCore_le_M_of_twoRank_intersection M F hM hrank
    have huCentral :=
      corollary713_oddCore_le_centralizer_of_theorem4b
        M F h4b hnotle huFM hu hcore_le_M
    have hcore_le_center :=
      corollary713_oddCore_le_center_of_one_involution
        M F hM hnotle huFM hu huCentral
    have hfrattiniNormalizer :=
      corollary713_frattini_normalizer_control M F hM hnotle huFM hu
    have htwo_core :=
      corollary713_core_twoTransitive_of_bender_borel
        M F hcore_le_M hbender hBorel
    have hnonsolvable := corollary713_nonsolvable_of_structure M F
      hcore_le_center hbender hfrattiniNormalizer htwo_core
    exact ⟨hsolv, hnonsolvable, hBorel⟩

/-- Corollary 7.13 from its source-level endpoints.  This is the exact
numbered statement; the stronger helper above merely retains a Borel witness
already constructed in its nonsolvable proof. -/
public theorem corollary713_of_source_endpoints
    {X : Type u} [Group X] [Finite X]
    (M F : Subgroup X) (hM : IsStronglyEmbedded M)
    (h4b : Theorem4bAtBase M)
    (hFnotle : ¬ F ≤ M)
    (hFproper : F ≠ ⊤)
    (hinduction : ∀ (H : Subgroup X), H ≠ ⊤ →
      ∀ (N : Subgroup H), IsStronglyEmbedded N →
        TheoremSEConclusion N)
    {u : X} (huFM : u ∈ F ⊓ M) (hu : IsInvolution u) :
    Corollary713Conclusion M F := by
  rcases corollary713_borel_of_source_endpoints
      M F hM h4b hFnotle hFproper hinduction huFM hu with
    ⟨hnotle, hsolv | ⟨_hnonsolvable, hnonsolvable, _hBorel⟩⟩
  · exact ⟨hnotle, Or.inl hsolv⟩
  · exact ⟨hnotle, Or.inr hnonsolvable⟩

end CFSG.BenderSuzuki
