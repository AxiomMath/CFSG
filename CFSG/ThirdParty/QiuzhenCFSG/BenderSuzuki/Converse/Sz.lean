module

public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.Converse.PSL2
public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.Converse.Lift
public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.PFchapter1section1.Basic
public import CFSG.ThirdParty.QiuzhenCFSG.BenderSuzuki.External.Huppert.XI.theorem_3_3
public import Mathlib.FieldTheory.Finite.GaloisField

namespace CFSG
end CFSG
open CFSG

namespace CFSG.BenderSuzuki
namespace Converse

open PFchapter1section1 PFAppendixIII Matrix MatrixGroups
open scoped LinearAlgebra.Projectivization Matrix

universe u

section Setup

variable (m : ℕ)

/-- The field `GF(2^(2m+1))`. -/
public abbrev SzK : Type := BinaryGaloisField (2 * m + 1)

/-- The Tits endomorphism `x ↦ x^(2^(m+1))`. -/
public noncomputable def szPi : SzK m ≃+* SzK m :=
  iterateFrobeniusEquiv (SzK m) 2 (m + 1)

public theorem szPi_apply (x : SzK m) : szPi m x = x ^ (2 ^ (m + 1)) :=
  iterateFrobeniusEquiv_def (SzK m) 2 (m + 1) x

public theorem szPi_sq (x : SzK m) : szPi m (szPi m x) = x ^ 2 :=
  External.binaryGaloisField_tits_formula_sq m (szPi m) (szPi_apply m) x

/-- The point at infinity of the Suzuki ovoid. -/
@[expose] public noncomputable def szPinf : ℙ (SzK m) (Fin 4 → SzK m) :=
  Projectivization.mk (SzK m) ![1, 0, 0, 0] (by simp)

/-- The finite points of the Suzuki ovoid. -/
@[expose] public noncomputable def szP (x y : SzK m) : ℙ (SzK m) (Fin 4 → SzK m) :=
  Projectivization.mk (SzK m)
    ![x * y + szPi m x * x ^ 2 + szPi m y, y, x, 1] (by simp)

/-- The Suzuki ovoid in `PG(3, q)`. -/
@[expose] public noncomputable def szO : Set (ℙ (SzK m) (Fin 4 → SzK m)) :=
  {szPinf m} ∪ Set.range fun z : SzK m × SzK m => szP m z.1 z.2

/-- The ovoid as a type: the `q² + 1` points on which `Sz(q)` acts. -/
public noncomputable abbrev SzOmega := {z : ℙ (SzK m) (Fin 4 → SzK m) // z ∈ szO m}

/-- The Suzuki group in its concrete matrix model. -/
public noncomputable abbrev SzG := SuzukiMatrixGroup m

/-- The root subgroup of `GL(4, q)` generated by the Suzuki root matrices. -/
public noncomputable def szF : Subgroup (GL (Fin 4) (SzK m)) :=
  Subgroup.closure {A | ∃ a b : SzK m, A = SuzukiRootGL m a b}

/-- The split torus of `GL(4, q)` generated by the Suzuki torus matrices. -/
public noncomputable def szH : Subgroup (GL (Fin 4) (SzK m)) :=
  Subgroup.closure {A | ∃ u : (SzK m)ˣ, A = SuzukiTorusGL m u}

/-- The action of the ambient linear group on the projective space, restricted
to the Suzuki matrix group. -/
@[expose] public noncomputable def szLinRep :
    SzG m →* LinearMap.GeneralLinearGroup (SzK m) (Fin 4 → SzK m) :=
  Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp (SuzukiMatrixSubgroup m).subtype

public noncomputable instance szProjAction :
    MulAction (SzG m) (ℙ (SzK m) (Fin 4 → SzK m)) :=
  MulAction.compHom _ (szLinRep m)

public theorem szProj_smul (g : SzG m) (z : ℙ (SzK m) (Fin 4 → SzK m)) :
    g • z =
      (Matrix.GeneralLinearGroup.toLin (g : GL (Fin 4) (SzK m))).toLinearEquiv • z := rfl

/-- The package of facts about `Sz(q)` acting on its ovoid, extracted from
Huppert–Blackburn XI.3.3. -/
public theorem sz_data (hm : 0 < m) :
    (∀ g : SzG m, ∀ z, z ∈ szO m → g • z ∈ szO m) ∧
    (∀ g : SzG m, (∀ z, z ∈ szO m → g • z = z) → g = 1) ∧
    (∀ a b c d, a ∈ szO m → b ∈ szO m → c ∈ szO m → d ∈ szO m →
      a ≠ b → c ≠ d → ∃ g : SzG m, g • a = c ∧ g • b = d) ∧
    Nat.card (SzOmega m) = (2 ^ (2 * m + 1)) ^ 2 + 1 ∧
    Nat.card (SzG m) =
      ((2 ^ (2 * m + 1)) ^ 2 + 1) * (2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1) ∧
    (∀ g : SzG m, g • szPinf m = szPinf m ↔ (g : GL (Fin 4) (SzK m)) ∈ szF m ⊔ szH m) := by
  obtain ⟨hpres, -, hfaith, htwo, -, hOcard, hGcard, hstab⟩ :=
    External.huppert_blackburn_XI_3_3 m hm (szPi m) (szPi_apply m)
  exact ⟨hpres, hfaith, htwo, hOcard, hGcard, hstab⟩

end Setup

/-! ### The action on the ovoid -/

section Action

variable (m : ℕ) [NeZero m]

public theorem m_pos : 0 < m := Nat.pos_of_ne_zero (NeZero.ne m)

public noncomputable instance szOmegaAction : MulAction (SzG m) (SzOmega m) where
  smul g z := ⟨g • (z : ℙ (SzK m) (Fin 4 → SzK m)), (sz_data m (m_pos m)).1 g z z.2⟩
  one_smul _ := Subtype.ext (one_smul _ _)
  mul_smul _ _ _ := Subtype.ext (mul_smul _ _ _)

@[simp] public theorem szOmega_smul_coe (g : SzG m) (z : SzOmega m) :
    ((g • z : SzOmega m) : ℙ (SzK m) (Fin 4 → SzK m)) =
      g • (z : ℙ (SzK m) (Fin 4 → SzK m)) := rfl

/-- The point at infinity, as a point of the ovoid. -/
public noncomputable def szPinfΩ : SzOmega m := ⟨szPinf m, Or.inl rfl⟩

omit [NeZero m] in
public theorem szWeyl_mem : SuzukiWeylGL m ∈ SuzukiMatrixSubgroup m :=
  Subgroup.subset_closure (Or.inr (Or.inr rfl))

/-- The Weyl involution, as an element of `Sz(q)`. -/
public noncomputable def szT : SzG m := ⟨SuzukiWeylGL m, szWeyl_mem m⟩

omit [NeZero m] in
public theorem szF_le : szF m ≤ SuzukiMatrixSubgroup m := by
  rw [szF]
  refine Subgroup.closure_mono ?_
  rintro A ⟨a, b, rfl⟩
  exact Or.inl ⟨a, b, rfl⟩

omit [NeZero m] in
public theorem szT_sq : szT m * szT m = 1 :=
  Subtype.ext (External.suzukiWeylGL_mul_self m)

omit [NeZero m] in
public theorem szT_ne_one : szT m ≠ 1 := by
  intro h
  have := congrFun (congrFun (congrArg
    (fun A : GL (Fin 4) (SzK m) => (A : Matrix (Fin 4) (Fin 4) (SzK m)))
    (congrArg Subtype.val h)) 0) 0
  simp [szT, SuzukiWeylGL, SuzukiWeylMatrix] at this

omit [NeZero m] in
public theorem szT_smul_pinf_ne : (szT m) • szPinf m ≠ szPinf m := by
  intro heq
  rw [szProj_smul, szPinf, Projectivization.smul_mk,
    Projectivization.mk_eq_mk_iff] at heq
  obtain ⟨c, hc⟩ := heq
  have h0 := congrFun hc 0
  simp [szT, SuzukiWeylGL, SuzukiWeylMatrix, Units.smul_def,
    Matrix.mulVec, Matrix.vecHead, Matrix.vecTail] at h0

/-! ### The order of the root group -/

omit [NeZero m] in
public theorem szRoot_injective {a b a' b' : SzK m}
    (h : SuzukiRootGL m a b = SuzukiRootGL m a' b') : a = a' ∧ b = b' := by
  constructor
  · have h01 := congrFun (congrFun (congrArg
      (fun A : GL (Fin 4) (SzK m) => (A : Matrix (Fin 4) (Fin 4) (SzK m))) h) 0) 1
    simpa [SuzukiRootGL, SuzukiRootMatrix] using h01
  · have h02 := congrFun (congrFun (congrArg
      (fun A : GL (Fin 4) (SzK m) => (A : Matrix (Fin 4) (Fin 4) (SzK m))) h) 0) 2
    simpa [SuzukiRootGL, SuzukiRootMatrix] using h02

omit [NeZero m] in
public theorem card_SzK : Nat.card (SzK m) = 2 ^ (2 * m + 1) :=
  GaloisField.card 2 (2 * m + 1) (by omega)

omit [NeZero m] in
public theorem szF_card : Nat.card (szF m) = (2 ^ (2 * m + 1)) ^ 2 := by
  have hcarrier : (szF m : Set (GL (Fin 4) (SzK m))) =
      Set.range (fun z : SzK m × SzK m => SuzukiRootGL m z.1 z.2) := by
    ext A
    rw [Set.mem_range]
    constructor
    · intro hA
      obtain ⟨a, b, rfl⟩ :=
        (External.suzukiRootGL_mem_closure_iff m (szPi m) (szPi_sq m) (szPi_apply m) A).1 hA
      exact ⟨(a, b), rfl⟩
    · rintro ⟨⟨a, b⟩, rfl⟩
      exact Subgroup.subset_closure ⟨a, b, rfl⟩
  have hinj : Function.Injective (fun z : SzK m × SzK m => SuzukiRootGL m z.1 z.2) := by
    rintro ⟨a, b⟩ ⟨a', b'⟩ h
    obtain ⟨h1, h2⟩ := szRoot_injective m h
    simp only [Prod.mk.injEq]
    exact ⟨h1, h2⟩
  show (szF m : Set (GL (Fin 4) (SzK m))).ncard = _
  rw [hcarrier, ← Set.image_univ, Set.ncard_image_of_injective _ hinj, Set.ncard_univ,
    Nat.card_prod, card_SzK, ← pow_two]

/-! ### A Klein four subgroup inside the root group -/

omit [NeZero m] in
public theorem szRoot0_mem (b : SzK m) : SuzukiRootGL m 0 b ∈ SuzukiMatrixSubgroup m :=
  Subgroup.subset_closure (Or.inl ⟨0, b, rfl⟩)

/-- A central root element of `Sz(q)`. -/
public noncomputable def szRoot0 (b : SzK m) : SzG m := ⟨SuzukiRootGL m 0 b, szRoot0_mem m b⟩

omit [NeZero m] in
public theorem szRootGL_zero_mul (b d : SzK m) :
    SuzukiRootGL m 0 b * SuzukiRootGL m 0 d = SuzukiRootGL m 0 (b + d) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [SuzukiRootGL, SuzukiRootMatrix, Matrix.mul_apply, Fin.sum_univ_four,
      add_pow_char_pow (R := SzK m) (p := 2) (n := m + 1)] <;> ring

omit [NeZero m] in
public theorem szRoot0_mul (b d : SzK m) :
    szRoot0 m b * szRoot0 m d = szRoot0 m (b + d) :=
  Subtype.ext (szRootGL_zero_mul m b d)

omit [NeZero m] in
public theorem szRoot0_zero : szRoot0 m 0 = 1 :=
  Subtype.ext (External.suzukiRootGL_zero_zero m)

omit [NeZero m] in
public theorem szRoot0_injective : Function.Injective (szRoot0 m) := by
  intro b d h
  exact (szRoot_injective m (congrArg Subtype.val h)).2

omit [NeZero m] in
public theorem szRoot0_sq (b : SzK m) : szRoot0 m b * szRoot0 m b = 1 := by
  rw [szRoot0_mul, CharTwo.add_self_eq_zero]
  exact szRoot0_zero m

/-- The Klein four subgroup of `Sz(q)` spanned by two central root elements. -/
public noncomputable def szKlein (a b : SzK m) : Subgroup (SzG m) where
  carrier := szRoot0 m '' kleinCarrier a b
  mul_mem' := by
    rintro _ _ ⟨c, hc, rfl⟩ ⟨d, hd, rfl⟩
    exact ⟨c + d, kleinCarrier_add hc hd, (szRoot0_mul m c d).symm⟩
  one_mem' := ⟨0, by simp [kleinCarrier], szRoot0_zero m⟩
  inv_mem' := by
    rintro _ ⟨c, hc, rfl⟩
    refine ⟨c, hc, ?_⟩
    rw [eq_comm, inv_eq_iff_mul_eq_one]
    exact szRoot0_sq m c

omit [NeZero m] in
public theorem szKlein_card {a b : SzK m} (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ≠ b) :
    Nat.card (szKlein m a b) = 4 := by
  show (szRoot0 m '' kleinCarrier a b).ncard = 4
  rw [Set.ncard_image_of_injective _ (szRoot0_injective m), kleinCarrier_ncard ha hb hab]

omit [NeZero m] in
public theorem szKlein_sq (a b : SzK m) (g : szKlein m a b) :
    (g : szKlein m a b) ^ 2 = 1 := by
  obtain ⟨_, c, -, rfl⟩ := g
  apply Subtype.ext
  rw [Subgroup.coe_pow, sq]
  exact szRoot0_sq m c

public theorem szTwoRank : TwoRankAtLeastTwo (SzG m) := by
  have hcard : 4 ≤ Nat.card (SzK m) := by
    rw [card_SzK]
    calc (4 : ℕ) = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (2 * m + 1) := Nat.pow_le_pow_right (by norm_num) (by have := m_pos m; omega)
  obtain ⟨b, hb0, hb1⟩ : ∃ b : SzK m, b ≠ 0 ∧ b ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hsub : (Set.univ : Set (SzK m)) ⊆ ({0, 1} : Set (SzK m)) := by
      intro x _
      rcases eq_or_ne x 0 with h | h
      · exact Or.inl h
      · exact Or.inr (hcon x h)
    have h1 : Nat.card (SzK m) ≤ 2 := by
      have := Set.ncard_le_ncard hsub (Set.toFinite _)
      rw [Set.ncard_univ] at this
      refine le_trans this (le_trans (Set.ncard_insert_le _ _) ?_)
      simp
    omega
  exact ⟨szKlein m 1 b, szKlein_card m one_ne_zero hb0 (Ne.symm hb1), szKlein_sq m 1 b⟩

/-! ### Hypothesis (A) for `Sz(q)` -/

public instance szPretransitive : MulAction.IsPretransitive (SzG m) (SzOmega m) := by
  constructor
  intro x y
  rcases eq_or_ne x y with rfl | hxy
  · exact ⟨1, one_smul _ _⟩
  · obtain ⟨g, h1, -⟩ := (sz_data m (m_pos m)).2.2.1 (x : ℙ (SzK m) (Fin 4 → SzK m))
      (y : ℙ (SzK m) (Fin 4 → SzK m)) (y : ℙ (SzK m) (Fin 4 → SzK m))
      (x : ℙ (SzK m) (Fin 4 → SzK m)) x.2 y.2 y.2 x.2
      (fun h => hxy (Subtype.ext h)) (fun h => hxy (Subtype.ext h).symm)
    exact ⟨g, Subtype.ext h1⟩

public instance szTwoPretransitive :
    MulAction.IsMultiplyPretransitive (SzG m) (SzOmega m) 2 := by
  rw [MulAction.is_two_pretransitive_iff]
  intro a b c d hab hcd
  obtain ⟨g, h1, h2⟩ := (sz_data m (m_pos m)).2.2.1 (a : ℙ (SzK m) (Fin 4 → SzK m))
    (b : ℙ (SzK m) (Fin 4 → SzK m)) (c : ℙ (SzK m) (Fin 4 → SzK m))
    (d : ℙ (SzK m) (Fin 4 → SzK m)) a.2 b.2 c.2 d.2
    (fun h => hab (Subtype.ext h)) (fun h => hcd (Subtype.ext h))
  exact ⟨g, Subtype.ext h1, Subtype.ext h2⟩

/-- The point stabilizer: a Borel subgroup of `Sz(q)`. -/
public noncomputable def szHstab : Subgroup (SzG m) :=
  MulAction.stabilizer (SzG m) (szPinfΩ m)

/-- The unipotent radical of the Borel, as a subgroup of `Sz(q)`. -/
public noncomputable def szQ : Subgroup (SzG m) :=
  (szF m).subgroupOf (SuzukiMatrixSubgroup m)

public theorem szHstab_eq :
    szHstab m = (szF m ⊔ szH m).subgroupOf (SuzukiMatrixSubgroup m) := by
  ext g
  rw [szHstab, MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf]
  constructor
  · intro h
    exact ((sz_data m (m_pos m)).2.2.2.2.2 g).1 (congrArg Subtype.val h)
  · intro h
    exact Subtype.ext (((sz_data m (m_pos m)).2.2.2.2.2 g).2 h)

omit [NeZero m] in
public theorem szFH_le_normalizer : szF m ⊔ szH m ≤ Subgroup.normalizer (szF m) := by
  refine sup_le Subgroup.le_normalizer ?_
  exact External.suzukiTorusClosure_le_normalizer_rootClosure m (szPi m)
    (szPi_sq m) (szPi_apply m)

public theorem szQ_le : szQ m ≤ szHstab m := by
  intro x hx
  rw [szQ, Subgroup.mem_subgroupOf] at hx
  rw [szHstab_eq, Subgroup.mem_subgroupOf]
  exact (le_sup_left : szF m ≤ szF m ⊔ szH m) hx

public theorem szQ_normal : ((szQ m).subgroupOf (szHstab m)).Normal := by
  apply Subgroup.normal_subgroupOf_of_le_normalizer
  intro x hx
  rw [Subgroup.mem_normalizer_iff]
  intro y
  have hxF : (x : GL (Fin 4) (SzK m)) ∈ Subgroup.normalizer (szF m) := by
    rw [szHstab_eq, Subgroup.mem_subgroupOf] at hx
    exact szFH_le_normalizer m hx
  rw [Subgroup.mem_normalizer_iff] at hxF
  rw [szQ, Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf]
  simpa using hxF (y : GL (Fin 4) (SzK m))

omit [NeZero m] in
public theorem szQ_card : Nat.card (szQ m) = (2 ^ (2 * m + 1)) ^ 2 := by
  rw [szQ, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (szF_le m)).toEquiv]
  exact szF_card m

public theorem szHstab_card :
    Nat.card (szHstab m) = (2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1) := by
  have horb : MulAction.orbit (SzG m) (szPinfΩ m) = Set.univ :=
    MulAction.orbit_eq_univ _ _
  have h := card_stabilizer_mul_card_orbit (G := SzG m) (szPinfΩ m)
  rw [horb] at h
  simp only [Nat.card_coe_set_eq, Set.ncard_univ] at h
  have hOc : (szO m).ncard = (2 ^ (2 * m + 1)) ^ 2 + 1 := (sz_data m (m_pos m)).2.2.2.1
  rw [hOc, (sz_data m (m_pos m)).2.2.2.2.1, ← szHstab] at h
  have hpos : 0 < (2 ^ (2 * m + 1)) ^ 2 + 1 := by positivity
  refine Nat.eq_of_mul_eq_mul_right hpos ?_
  rw [h]
  ring

/-- The second base point, the image of `p∞` under the Weyl involution. -/
public noncomputable def szP0 : SzOmega m := szT m • szPinfΩ m

public theorem szP0_ne : szP0 m ≠ szPinfΩ m := fun h =>
  szT_smul_pinf_ne m (congrArg Subtype.val h)

omit [NeZero m] in
public theorem szT_inv : (szT m)⁻¹ = szT m := inv_eq_of_mul_eq_one_left (szT_sq m)

/-- The torus of `Sz(q)`: the two-point stabilizer. -/
public noncomputable def szD : Subgroup (SzG m) :=
  szHstab m ⊓ rightConjugate (szHstab m) (szT m)

public theorem szD_eq : szD m = szHstab m ⊓ MulAction.stabilizer (SzG m) (szP0 m) := by
  rw [szD, szHstab, rightConjugate_stabilizer, szT_inv]
  rfl

public theorem szD_le : szD m ≤ szHstab m := by rw [szD]; exact inf_le_left

public theorem szT_notMem_Hstab : szT m ∉ szHstab m := by
  intro h
  exact szP0_ne m h

public theorem szHstab_orbit :
    MulAction.orbit (szHstab m) (szP0 m) = {z : SzOmega m | z ≠ szPinfΩ m} := by
  ext z
  constructor
  · rintro ⟨h, rfl⟩
    intro hcon
    apply szP0_ne m
    have hfix : (h : SzG m) • szPinfΩ m = szPinfΩ m := h.2
    have hcon' : (h : SzG m) • szP0 m = szPinfΩ m := hcon
    have hinvfix : ((h : SzG m))⁻¹ • szPinfΩ m = szPinfΩ m := by
      conv_lhs => rw [← hfix]
      rw [← mul_smul, inv_mul_cancel, one_smul]
    calc szP0 m = ((h : SzG m))⁻¹ • ((h : SzG m) • szP0 m) := by
          rw [← mul_smul, inv_mul_cancel, one_smul]
      _ = ((h : SzG m))⁻¹ • szPinfΩ m := by rw [hcon']
      _ = szPinfΩ m := hinvfix
  · intro hz
    have h2 : ∀ {a b c d : SzOmega m}, a ≠ b → c ≠ d →
        ∃ g : SzG m, g • a = c ∧ g • b = d :=
      MulAction.is_two_pretransitive_iff.1 (szTwoPretransitive m)
    obtain ⟨g, hg1, hg2⟩ := @h2 (szPinfΩ m) (szP0 m) (szPinfΩ m) z
      (Ne.symm (szP0_ne m)) (Ne.symm hz)
    exact ⟨⟨g, hg1⟩, hg2⟩

public theorem szD_card : Nat.card (szD m) = 2 ^ (2 * m + 1) - 1 := by
  haveI : Fintype (SzOmega m) := Fintype.ofFinite _
  have hstabeq : MulAction.stabilizer (szHstab m) (szP0 m) =
      (szD m).subgroupOf (szHstab m) := by
    ext x
    rw [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf, szD_eq, Subgroup.mem_inf]
    exact ⟨fun h => ⟨x.2, h⟩, fun h => h.2⟩
  have h := card_stabilizer_mul_card_orbit (G := szHstab m) (szP0 m)
  rw [hstabeq, szHstab_orbit,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (szD_le m)).toEquiv, szHstab_card] at h
  have hcompl : Nat.card {z : SzOmega m | z ≠ szPinfΩ m} = (2 ^ (2 * m + 1)) ^ 2 := by
    classical
    have hcardΩ : Fintype.card (SzOmega m) = (2 ^ (2 * m + 1)) ^ 2 + 1 := by
      rw [← Nat.card_eq_fintype_card]; exact (sz_data m (m_pos m)).2.2.2.1
    have h1 : Nat.card {z : SzOmega m // ¬ (z = szPinfΩ m)} = (2 ^ (2 * m + 1)) ^ 2 := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl, Fintype.card_subtype_eq,
        hcardΩ]
      omega
    exact h1
  rw [hcompl] at h
  have hpos : 0 < (2 ^ (2 * m + 1)) ^ 2 := by positivity
  refine Nat.eq_of_mul_eq_mul_right hpos ?_
  rw [h]
  ring

public theorem szQ_disjoint_szD : Disjoint (szQ m) (szD m) := by
  have hcop : Nat.Coprime ((2 ^ (2 * m + 1)) ^ 2) (2 ^ (2 * m + 1) - 1) := by
    have hodd : ¬ (2 ∣ 2 ^ (2 * m + 1) - 1) := by
      have h1 : 2 ∣ 2 ^ (2 * m + 1) := dvd_pow_self 2 (by omega)
      have h2 : 2 ≤ 2 ^ (2 * m + 1) := Nat.one_lt_two_pow (by omega)
      omega
    have h2 : Nat.Coprime 2 (2 ^ (2 * m + 1) - 1) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 hodd
    exact Nat.Coprime.pow_left _ (Nat.Coprime.pow_left _ h2)
  have hdvdQ : Nat.card (szQ m ⊓ szD m : Subgroup (SzG m)) ∣ (2 ^ (2 * m + 1)) ^ 2 := by
    rw [← szQ_card m]
    exact Subgroup.card_dvd_of_le inf_le_left
  have hdvdD : Nat.card (szQ m ⊓ szD m : Subgroup (SzG m)) ∣ 2 ^ (2 * m + 1) - 1 := by
    rw [← szD_card m]
    exact Subgroup.card_dvd_of_le inf_le_right
  have hone : Nat.card (szQ m ⊓ szD m : Subgroup (SzG m)) = 1 := by
    have hg : Nat.gcd ((2 ^ (2 * m + 1)) ^ 2) (2 ^ (2 * m + 1) - 1) = 1 := hcop
    have hd := Nat.dvd_gcd hdvdQ hdvdD
    rw [hg] at hd
    exact Nat.dvd_one.mp hd
  rw [disjoint_iff]
  exact Subgroup.card_eq_one.1 hone

public theorem szQ_sup_szD : szQ m ⊔ szD m = szHstab m := by
  have hQle := szQ_le m
  have hDle := szD_le m
  have hdisj : Disjoint ((szQ m).subgroupOf (szHstab m)) ((szD m).subgroupOf (szHstab m)) := by
    rw [Subgroup.disjoint_def]
    intro x hx1 hx2
    rw [Subgroup.mem_subgroupOf] at hx1 hx2
    exact Subtype.ext ((Subgroup.disjoint_def.1 (szQ_disjoint_szD m)) hx1 hx2)
  have hcard : Nat.card ((szQ m).subgroupOf (szHstab m)) *
      Nat.card ((szD m).subgroupOf (szHstab m)) = Nat.card (szHstab m) := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQle).toEquiv,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDle).toEquiv,
      szQ_card, szD_card, szHstab_card]
  have hcompl := Subgroup.isComplement'_of_card_mul_and_disjoint hcard hdisj
  have htop := hcompl.sup_eq_top
  have := congrArg (fun S : Subgroup (szHstab m) => S.map (szHstab m).subtype) htop
  rw [Subgroup.map_sup, Subgroup.subgroupOf_map_subtype, Subgroup.subgroupOf_map_subtype,
    inf_eq_left.2 hQle, inf_eq_left.2 hDle] at this
  rw [this, ← MonoidHom.range_eq_map, Subgroup.range_subtype]

public instance szFaithful : FaithfulSMul (SzG m) (SzOmega m) where
  eq_of_smul_eq_smul {g₁ g₂} h := by
    have hfix : ∀ z, z ∈ szO m → (g₂⁻¹ * g₁) • z = z := by
      intro z hz
      have hz' : g₁ • z = g₂ • z := congrArg Subtype.val (h ⟨z, hz⟩)
      rw [mul_smul, hz', ← mul_smul, inv_mul_cancel, one_smul]
    have hone := (sz_data m (m_pos m)).2.1 (g₂⁻¹ * g₁) hfix
    exact (inv_mul_eq_one.1 hone).symm

/-- **Converse to the Suzuki theorem, `Sz` case.**  For every `m ≥ 1` the Suzuki
group `Sz(2^(2m+1))`, acting on its ovoid of `q² + 1` points in `PG(3, q)`,
satisfies Hypothesis (A) of Peterfalvi Part II — with `H` the point stabilizer,
`Q` its root subgroup, `D` the two-point stabilizer, and `t` the Weyl
involution. -/
public theorem hypothesisA_Sz :
    HypothesisA (SzG m) (SzOmega m) (szHstab m) (szD m) (szQ m) (szT m) where
  A1 :=
    { two_transitive := szTwoPretransitive m
      point_stabilizer := ⟨szPinfΩ m, rfl⟩
      involution_t := ⟨szT_ne_one m, by rw [sq]; exact szT_sq m⟩
      t_not_mem_H := szT_notMem_Hstab m
      D_eq := rfl
      Q_le_H := szQ_le m
      D_le_H := szD_le m
      Q_normal_in_H := szQ_normal m
      Q_disjoint_D := szQ_disjoint_szD m
      Q_sup_D := szQ_sup_szD m
      Q_even := by
        rw [szQ_card, ← pow_mul]
        exact (Nat.even_pow' (by omega)).2 even_two
      D_odd := by
        rw [szD_card]
        refine Nat.Even.sub_odd (Nat.one_le_two_pow) ?_ odd_one
        exact (Nat.even_pow' (by omega)).2 even_two }
  A2 := szFaithful m
  A3 := szTwoRank m

end Action

end Converse
end CFSG.BenderSuzuki
