@[expose] def hbadTGoodMats (j : Nat) : List B8 := (hbadTGoodData.lookup j).getD []

theorem hbadTGoodMats_spec : ∀ j ∈ hbadTClassReps,
    (hbadTGoodMats j).map b8Code =
      (hbadTMats.filter (fun A => hbadTGood j A)).map b8Code := by
  simp only [hbadTGood, hbadTQ, hbadTFixedList_eqL, bapply_eq, bq_eq, memK_eq, all_eq]
  decide +kernel

theorem hbadTGoodMats_mem {j : Nat} {A : B8} (hj : j ∈ hbadTClassReps) :
    A ∈ hbadTGoodMats j ↔ A ∈ hbadTMats ∧ hbadTGood j A = true := by
  constructor
  · intro hA
    have hcode : b8Code A ∈ (hbadTGoodMats j).map b8Code := List.mem_map_of_mem hA
    rw [hbadTGoodMats_spec j hj] at hcode
    obtain ⟨B, hB, hBA⟩ := List.mem_map.1 hcode
    have hBA' : B = A := b8Code_injective hBA
    rw [hBA'] at hB
    exact List.mem_filter.1 hB
  · rintro ⟨hM, hG⟩
    have hB : A ∈ hbadTMats.filter (fun A => hbadTGood j A) := List.mem_filter.2 ⟨hM, hG⟩
    have hcode : b8Code A ∈ (hbadTMats.filter (fun A => hbadTGood j A)).map b8Code :=
      List.mem_map_of_mem hB
    rw [← hbadTGoodMats_spec j hj] at hcode
    obtain ⟨B, hB', hBA⟩ := List.mem_map.1 hcode
    have hBA' : B = A := b8Code_injective hBA
    rwa [hBA'] at hB'

theorem hbadTGoodMats_key_chain : ∀ j ∈ hbadTClassReps,
    List.IsChain (· < ·) ((hbadTGoodMats j).map stabKey) := by decide +kernel

theorem hbadTGoodMats_nodup {j : Nat} (hj : j ∈ hbadTClassReps) :
    (hbadTGoodMats j).Nodup := by
  have hpair := List.isChain_iff_pairwise.1 (hbadTGoodMats_key_chain j hj)
  exact List.Nodup.of_map stabKey (hpair.imp ne_of_lt)

theorem hbadTAdmissible : ∀ j0 ∈ hbadTClassReps, ∀ l ∈ hbadTImage,
    ∀ j1 ∈ hbadTImage.map (fun r => j0 ^^^ r),
      ∀ x ∈ [0, l, j1, j1 ^^^ l], x ∈ hbadTQperp j0 := by decide +kernel

@[expose] def hbadTFilter (j0 l j1 : Nat) : List B8 :=
  (hbadTGoodMats j0).filter fun A => hbadTPred j0 l j1 A

theorem hbadTBound : ∀ j0 ∈ hbadTClassReps, ∀ l ∈ hbadTImage,
    ∀ j1 ∈ hbadTImage.map (fun r => j0 ^^^ r),
      (hbadTFilter j0 l j1).length ≤ 16 := by
  simp only [hbadTFilter, hbadTPred, hbadTQ, hbadTFixedList_eqL, bapply_eq, bq_eq, memK_eq,
    all_eq]
  decide +kernel

