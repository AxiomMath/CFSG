theorem hbadTSigmaPre_spec : ∀ p ∈ hbadTSigmaPre,
    p.1 ∈ hbadTFixedList ∧ p.2.1 ∈ hbadTFixedList ∧ p.2.2 < 256 ∧
      p.1 = bapply bRho p.2.1 ^^^ p.2.1 ^^^ (bapply bT p.2.2 ^^^ p.2.2) := by
  decide +kernel

theorem hbadTSigmaCover : ∀ k ∈ hbadTFixedList, ∃ p ∈ hbadTSigmaPre, p.1 = k := by
  decide +kernel

@[expose] def hbadTFixedPerp (j : Nat) : List Nat :=
  (List.range 256).filter fun k => fixesT k && (bq j k == 0)

theorem hbadTFixedPerp_length : ∀ j ∈ hbadTFixedList, j ∉ hbadTImage →
    (hbadTFixedPerp j).length = 32 := by
  simp only [hbadTFixedPerp, hbadTFixedList_eqL, fixesT, bapply_eq, bq_eq]
  decide +kernel

theorem hbadTPerpFixed : ∀ j ∈ hbadTFixedList, ∀ v ∈ hbadTFixedList,
    (∀ k ∈ hbadTFixedList, bq j k = 0 → bq v k = 0) →
      v ∈ hbadTImage ∨ (v ^^^ j) ∈ hbadTImage := by
  simp only [hbadTFixedList_eqL, bq_eq]
  decide +kernel

@[expose] def hbadTQ (j : Nat) : List Nat :=
  hbadTFixedList.filter fun m => bq j m == 0

@[expose] def hbadTQperp (j : Nat) : List Nat :=
  hbadTImage.map (fun r => j ^^^ r) ++ hbadTImage

@[expose] def hbadTGood (j : Nat) (A : B8) : Bool :=
  (hbadTQ j).all fun m => decide ((bapply A m ^^^ m) ∈ hbadTQperp j)

@[expose] def hbadTPred (j0 l j1 : Nat) (A : B8) : Bool :=
  (hbadTQ j0).all fun m => decide ((bapply A m ^^^ m) ∈ [0, l, j1, j1 ^^^ l])

