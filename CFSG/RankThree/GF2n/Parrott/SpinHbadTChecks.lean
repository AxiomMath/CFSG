@[expose] def hbadTImage : List Nat := [0, 4, 26, 30]

@[expose] def hbadTPre : List (Nat × Nat) := [(0, 0), (4, 1), (26, 2), (30, 3)]

@[expose] def hbadTPreOf (n : Nat) : Nat := (hbadTPre.lookup n).getD 0

theorem hbadTPreOf_lt : ∀ n ∈ hbadTImage, hbadTPreOf n < 256 := by decide +kernel

theorem hbadTImage_pre : ∀ n ∈ hbadTImage,
    bapply bT (hbadTPreOf n) ^^^ hbadTPreOf n = n := by decide +kernel

theorem hbadTImage_cover : ∀ m < 256, (bapply bT m ^^^ m) ∈ hbadTImage := by
  decide +kernel

theorem hbadTImage_xor : ∀ r ∈ hbadTImage, ∀ s ∈ hbadTImage,
    (r ^^^ s) ∈ hbadTImage := by decide +kernel

@[expose] def hbadTFixedList : List Nat := (List.range 256).filter fun m => fixesT m

private theorem hbadTFixedList_eqL : hbadTFixedList = fixedL := fixedL_eq

theorem hbadTFixedList_lt : ∀ m ∈ hbadTFixedList, m < 256 := by
  intro m hm
  exact List.mem_range.1 (List.mem_filter.1 hm).1

theorem hbadTFixedList_mem {m : Nat} (hm : m < 256) :
    m ∈ hbadTFixedList ↔ fixesT m = true := by
  rw [hbadTFixedList, List.mem_filter, List.mem_range]
  exact ⟨fun h => h.2, fun h => ⟨hm, h⟩⟩

theorem hbadTImage_perp : ∀ r ∈ hbadTImage, ∀ m ∈ hbadTFixedList, bq r m = 0 := by
  decide +kernel

@[expose] def hbadTClassReps : List Nat :=
  [10, 33, 43, 64, 74, 97, 107, 128, 138, 161, 171, 192, 202, 225, 235]

theorem hbadTClassCover : ∀ j ∈ hbadTFixedList, j ∉ hbadTImage →
    ∃ j0 ∈ hbadTClassReps, ∃ r ∈ hbadTImage, j = j0 ^^^ r := by decide +kernel

theorem hbadTClassCover_mul : ∀ j ∈ hbadTClassReps, ∀ r ∈ hbadTImage,
    ∀ s ∈ hbadTImage, ∃ r' ∈ hbadTImage, j ^^^ r ^^^ s = j ^^^ r' := by
  intro j _ r hr s hs
  exact ⟨r ^^^ s, hbadTImage_xor r hr s hs, by rw [Nat.xor_assoc]⟩

theorem hbadTbq_xor : ∀ j ∈ hbadTClassReps, ∀ r ∈ hbadTImage,
    ∀ m ∈ hbadTFixedList, bq (j ^^^ r) m = bq j m ^^^ bq r m := by
  simp only [hbadTFixedList_eqL, bq_eq]
  decide +kernel

theorem hbadTQSing : ∀ m < 256, qTab.getD (bapply bT m ^^^ m) 0 = 0 := by
  decide +kernel

theorem hbadTPerp : ∀ v < 256, (∀ k ∈ hbadTFixedList, bq v k = 0) →
    v ∈ hbadTImage := by
  simp only [hbadTFixedList_eqL, bq_eq]
  decide +kernel

