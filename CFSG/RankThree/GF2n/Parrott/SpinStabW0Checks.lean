@[expose] def tauMat : B8 := ⟨1, 2, 240, 10, 16, 34, 66, 116⟩
@[expose] def xMat : B8 := ⟨3, 2, 101, 48, 230, 238, 140, 21⟩
@[expose] def gMat : B8 := ⟨207, 2, 178, 34, 188, 82, 198, 108⟩

@[expose] def w0m : Nat := 2

@[expose] def w4List : List Nat :=
  [0, 2, 56, 58, 88, 90, 96, 98, 148, 150, 172, 174, 204, 206, 244, 246]

@[expose] def l2List : List Nat := [0, 2, 244, 246]

@[expose] def stabKey (A : B8) : Nat :=
  A.c0 + 256 * A.c1 + 256 ^ 2 * A.c2 + 256 ^ 3 * A.c3 + 256 ^ 4 * A.c4 + 256 ^ 5 * A.c5 +
    256 ^ 6 * A.c6 + 256 ^ 7 * A.c7

@[expose] def perpList : List Nat := (List.range 256).filter fun m => bq m w0m == 0

theorem stabMats_eq : stabWords.map (fun w => evalB b3 (toW w)) = stabMats := by
  apply List.map_injective_iff.mpr b8Code_injective
  decide +kernel

theorem stabMats_length : stabMats.length = 384 := by
  decide +kernel

theorem stabKey_chain : List.IsChain (· < ·) (stabMats.map stabKey) := by
  decide +kernel

theorem stabMats_fix : ∀ M ∈ stabMats, bapply M w0m = w0m := by
  decide +kernel

theorem orbWords_length : orbWords.length = 135 := by
  decide +kernel

theorem orbWords_eq : orbWords.map (fun w => bapply (evalB b3 (toW w)) w0m) = singList := by
  decide +kernel

theorem singList_chain : List.IsChain (· < ·) singList := by
  decide +kernel

theorem fin1 : ∀ m ∈ perpList, qTab.getD m 0 = 0 → m ∉ w4List →
    ∃ M ∈ stabMats, bq m (bapply M m) ≠ 0 := by
  decide +kernel

theorem fin2 : ∀ m ∈ w4List, m ∉ l2List →
    ∃ M₁ ∈ stabMats, ∃ M₂ ∈ stabMats, ∀ n ∈ w4List, ∃ e : Fin 16,
      n = (if e.val % 2 = 1 then w0m else 0) ^^^ (if e.val / 2 % 2 = 1 then m else 0) ^^^
        (if e.val / 4 % 2 = 1 then bapply M₁ m else 0) ^^^
        (if e.val / 8 % 2 = 1 then bapply M₂ m else 0) := by
  decide +kernel

theorem fin3 : ∀ M ∈ stabMats, (∀ m ∈ perpList, (bapply M m ^^^ m) ∈ l2List) →
    M = bone ∨ M = tauMat := by
  have h : ∀ M ∈ stabMats, (∀ m ∈ perpList, (bapply M m ^^^ m) ∈ l2List) →
      b8Code M = b8Code bone ∨ b8Code M = b8Code tauMat := by
    decide +kernel
  intro M hM hfix
  rcases h M hM hfix with h' | h'
  · exact Or.inl (b8Code_injective h')
  · exact Or.inr (b8Code_injective h')

theorem p4_spec : ∀ M ∈ stabMats,
    ((∀ m ∈ perpList, (bapply M m ^^^ m) ∈ w4List) ∧
      (∀ m ∈ w4List, (bapply M m ^^^ m) = 0 ∨ (bapply M m ^^^ m) = w0m)) ↔ M ∈ p4Mats := by
  decide +kernel

theorem p4Mats_length : p4Mats.length = 16 := by
  decide +kernel

theorem p4Mats_sub : ∀ M ∈ p4Mats, M ∈ stabMats := by
  decide +kernel

theorem tau_mem : tauMat ∈ p4Mats := by
  decide +kernel

theorem tau_ne_one : tauMat ≠ bone := by
  have h : b8Code tauMat ≠ b8Code bone := by decide +kernel
  intro h'
  exact h (congrArg b8Code h')

theorem tau_fix_w4 : ∀ m ∈ w4List, bapply tauMat m = m := by
  decide +kernel

theorem p4_mul_tau : ∀ M ∈ p4Mats, bmul tauMat M ∈ p4Mats := by
  decide +kernel

theorem p4_comm : ∀ M ∈ p4Mats, ∀ N ∈ p4Mats, bmul M N = bmul N M := by
  have h : ∀ M ∈ p4Mats, ∀ N ∈ p4Mats, b8Code (bmul M N) = b8Code (bmul N M) := by
    decide +kernel
  intro M hM N hN
  exact b8Code_injective (h M hM N hN)

theorem tau_sq : bmul tauMat tauMat = bone := by
  apply b8Code_injective
  decide +kernel

theorem p4_sq : ∀ M ∈ p4Mats, bmul M M = bone := by
  have h : ∀ M ∈ p4Mats, b8Code (bmul M M) = b8Code bone := by
    decide +kernel
  intro M hM
  exact b8Code_injective (h M hM)

theorem x_mem : xMat ∈ p4Mats := by
  decide +kernel

theorem g_mem : gMat ∈ stabMats := by
  decide +kernel

theorem g_x : bmul gMat xMat = bmul (bmul xMat tauMat) gMat := by
  apply b8Code_injective
  decide +kernel

theorem g_tau : bmul gMat tauMat = bmul tauMat gMat := by
  apply b8Code_injective
  decide +kernel

theorem fin5 : ∀ M ∈ stabMats, (∀ m ∈ perpList, bapply M m = m) → M = bone := by
  decide +kernel

theorem fin6 : ∀ m ∈ List.range 256, (∀ n ∈ perpList, bq m n = 0) → m = 0 ∨ m = w0m := by
  decide +kernel

theorem fin7 : ∀ m ∈ List.range 256, (∀ n ∈ w4List, bq m n = 0) → m ∈ w4List := by
