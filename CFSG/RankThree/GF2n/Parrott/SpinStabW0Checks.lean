@[expose] def b8Code (A : B8) : List Nat := [A.c0, A.c1, A.c2, A.c3, A.c4, A.c5, A.c6, A.c7]

theorem b8Code_injective : Function.Injective b8Code := by
  intro A B h
  have h0 : A.c0 = B.c0 := by
    have := congrArg (fun l => l.getD 0 0) h
    simpa [b8Code] using this
  have h1 : A.c1 = B.c1 := by
    have := congrArg (fun l => l.getD 1 0) h
    simpa [b8Code] using this
  have h2 : A.c2 = B.c2 := by
    have := congrArg (fun l => l.getD 2 0) h
    simpa [b8Code] using this
  have h3 : A.c3 = B.c3 := by
    have := congrArg (fun l => l.getD 3 0) h
    simpa [b8Code] using this
  have h4 : A.c4 = B.c4 := by
    have := congrArg (fun l => l.getD 4 0) h
    simpa [b8Code] using this
  have h5 : A.c5 = B.c5 := by
    have := congrArg (fun l => l.getD 5 0) h
    simpa [b8Code] using this
  have h6 : A.c6 = B.c6 := by
    have := congrArg (fun l => l.getD 6 0) h
    simpa [b8Code] using this
  have h7 : A.c7 = B.c7 := by
    have := congrArg (fun l => l.getD 7 0) h
    simpa [b8Code] using this
  exact B8.ext h0 h1 h2 h3 h4 h5 h6 h7

@[instance_reducible]
def b8DecEq (A B : B8) : Decidable (A = B) :=
  if h : b8Code A = b8Code B then isTrue (b8Code_injective h)
  else isFalse (fun hAB => h (congrArg b8Code hAB))

attribute [local instance] b8DecEq

