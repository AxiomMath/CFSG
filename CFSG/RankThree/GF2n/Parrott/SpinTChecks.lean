@[expose] def bq (m n : Nat) : Nat :=
  (qTab.getD (m ^^^ n) 0 + qTab.getD m 0 + qTab.getD n 0) % 2

@[expose] def sCols : List B8 :=
  [evalB b3 (toW lU), evalB b3 (toW lAl), evalB b3 (toW lBe), evalB b3 (toW lT)]

@[expose] def fixesS (m : Nat) : Bool := sCols.all fun A => bapply A m == m

@[expose] def fixesT (m : Nat) : Bool := bapply (evalB b3 (toW lT)) m == m

theorem iso_check : ∀ m < 256, ∀ n < 256, fixesS m = true → fixesS n = true → bq m n = 0 := by
  decide +kernel

theorem rest_check : ∀ m < 256, fixesT m = true → qTab.getD m 0 = 0 →
    fixesS m = true ∨ fixesS (bapply (evalB b3 (toW lGA)) m) = true ∨
      fixesS (bapply (evalB b3 (toW lGB)) m) = true := by
  decide +kernel

