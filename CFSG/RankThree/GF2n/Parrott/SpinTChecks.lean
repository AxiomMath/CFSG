@[expose] def toW (l : List Nat) : List (Fin 3 × Nat) :=
  l.map fun i => (⟨i % 3, Nat.mod_lt _ (by decide)⟩, 1)

@[expose] def lU : List Nat :=
  [1, 1, 0, 2, 1, 0, 1, 1, 1, 1, 0, 2, 1, 1, 1]

@[expose] def lAl : List Nat :=
