theorem zWords_length : zWords.length = 289 := by decide +kernel

theorem zPairs_ok : ∀ p ∈ zPairs, p.1 < 256 ∧ p.2.1 < 256 ∧ p.2.2 < 256 ∧ fixesT p.1 = true ∧
    fixesT p.2.1 = true ∧ fixesT p.2.2 = true ∧ bq p.2.1 p.1 = 0 ∧ bq p.2.2 p.1 = 0 := by
  decide +kernel

theorem zPairs_cover : ∀ m < 256, fixesT m = true → ∃ p ∈ zPairs, p.1 = m := by
  decide +kernel

@[expose] def seenStep (acc : Option Nat) (p : Nat × Nat) : Option Nat :=
  acc.bind fun s =>
    if p.1 < 256 ∧ p.2 < 256 ∧ s.testBit (256 * p.1 + p.2) = false then
      some (s ||| (1 <<< (256 * p.1 + p.2)))
    else none

@[expose] def distinctPairs (ps : List (Nat × Nat)) : Bool :=
  (ps.foldl seenStep (some 0)).isSome

theorem foldl_seenStep_none (l : List (Nat × Nat)) : l.foldl seenStep none = none := by
  induction l with
  | nil => rfl
  | cons p l ih => simpa [List.foldl_cons, seenStep] using ih

theorem foldl_seenStep (l : List (Nat × Nat)) : ∀ s : Nat,
    (l.foldl seenStep (some s)).isSome = true →
      l.Nodup ∧ ∀ p ∈ l, ¬ (p.1 < 256 ∧ p.2 < 256 ∧ s.testBit (256 * p.1 + p.2) = true) := by
  induction l with
  | nil =>
    intro s _
    simp
  | cons p l ih =>
    intro s hs
    rw [List.foldl_cons] at hs
    by_cases hc : p.1 < 256 ∧ p.2 < 256 ∧ s.testBit (256 * p.1 + p.2) = false
    · have hstep : seenStep (some s) p = some (s ||| (1 <<< (256 * p.1 + p.2))) := by
        simp [seenStep, hc]
      rw [hstep] at hs
      obtain ⟨hnd, hall⟩ := ih _ hs
      have hbit : (s ||| (1 <<< (256 * p.1 + p.2))).testBit (256 * p.1 + p.2) = true := by
        rw [Nat.testBit_or, Nat.testBit_shiftLeft]
        simp
      refine ⟨List.nodup_cons.mpr ⟨fun hp => ?_, hnd⟩, ?_⟩
      · exact hall p hp ⟨hc.1, hc.2.1, hbit⟩
      · intro q hq ⟨hq1, hq2, hq3⟩
        rcases List.mem_cons.mp hq with rfl | hq
        · rw [hc.2.2] at hq3
          exact Bool.false_ne_true hq3
        · refine hall q hq ⟨hq1, hq2, ?_⟩
          rw [Nat.testBit_or, hq3]
          simp
    · have hstep : seenStep (some s) p = none := by
        simp only [seenStep, Option.bind_some]
        rw [if_neg hc]
      rw [hstep, foldl_seenStep_none] at hs
      simp at hs

theorem nodup_of_distinctPairs {ps : List (Nat × Nat)} (h : distinctPairs ps = true) :
    ps.Nodup :=
  (foldl_seenStep ps 0 h).1

theorem zKeys_distinct : ∀ p ∈ zPairs,
    distinctPairs (zMats.map fun A => (bapply A p.2.1, bapply A p.2.2)) = true := by
  decide +kernel

theorem gA_comm :
    tcomp (evalT t3 (toW lGA)) tx = tcomp tx (evalT t3 (toW lGA)) ∧
    tcomp (evalT t3 (toW lGA)) (tcomp tM1 tM2) = tcomp (tcomp tM1 tM2) (evalT t3 (toW lGA)) := by
  decide +kernel

theorem gB_comm :
    tcomp (evalT t3 (toW lGB)) tx = tcomp tx (evalT t3 (toW lGB)) ∧
    tcomp (evalT t3 (toW lGB)) (tcomp tM1 tM2) = tcomp (tcomp tM1 tM2) (evalT t3 (toW lGB)) := by
  decide +kernel

theorem zWords_comm :
    ∀ w ∈ zWords, tcomp (evalT t3 (toW w)) tx = tcomp tx (evalT t3 (toW w)) := by
  decide +kernel

