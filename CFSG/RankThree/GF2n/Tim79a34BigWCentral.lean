variable {G : Type} [Group G]

theorem bigRW_comm_mem_wOf_and_centralizes [Finite G] {M V Q P H : Subgroup G}
    (hc : MinCex M V Q P H) {r w : G} (hr : r ∈ xOf V H ⊓ Subgroup.centralizer (V : Set G))
    (hw : w ∈ wOf V H) :
    ⁅r, w⁆ ∈ wOf V H ∧ ∀ v ∈ V, v * ⁅r, w⁆ = ⁅r, w⁆ * v := by
  have hVH : V ≤ H := hc.V_le_H
  obtain ⟨hrX, hrC⟩ := Subgroup.mem_inf.mp hr
  have hrH : r ∈ H := xOf_le_H hVH hrX
  have hWn : ∀ h ∈ H, ∀ x ∈ wOf V H, h * x * h⁻¹ ∈ wOf V H := fun h hh x hx =>
    (Subgroup.mem_normalizer_iff.mp (H_le_normalizer_wOf V H hh) x).mp hx
  have hWcomm : ∀ x ∈ wOf V H, ∀ y ∈ wOf V H, x * y = y * x := fun x hx y hy =>
    hc.wOf_isElemAbelian.comm hx hy
  have hz : ⁅r, w⁆ ∈ wOf V H := by
    rw [commutatorElement_def]
    exact (wOf V H).mul_mem (hWn r hrH w hw) ((wOf V H).inv_mem hw)
  refine ⟨hz, fun v hv => ?_⟩
  have hvH : v ∈ H := hVH hv
  have hw' : v * w * v⁻¹ ∈ wOf V H := hWn v hvH w hw
  have hwN : w ∈ Subgroup.normalizer (V : Set G) := by
    rw [hc.normalizer_eq]
    exact wOf_le_M_of_minCex hc hw
  obtain ⟨a', ha'⟩ : ∃ a' : G, a' = v * w * v⁻¹ * w⁻¹ := ⟨_, rfl⟩
  have ha'V : a' ∈ V := by
    have h1 : w * v⁻¹ * w⁻¹ ∈ V := (Subgroup.mem_normalizer_iff.mp hwN _).mp (V.inv_mem hv)
    have e : a' = v * (w * v⁻¹ * w⁻¹) := by rw [ha']; group
    rw [e]
    exact V.mul_mem hv h1
  have ha'W : a' ∈ wOf V H := by
    rw [ha']
    exact (wOf V H).mul_mem hw' ((wOf V H).inv_mem hw)
  have hra : a' * r = r * a' := Subgroup.mem_centralizer_iff.mp hrC a' ha'V
  have hvr : v * r = r * v := Subgroup.mem_centralizer_iff.mp hrC v hv
  have e1 : v * ⁅r, w⁆ * v⁻¹ = ⁅v * r * v⁻¹, v * w * v⁻¹⁆ := by
    simp only [commutatorElement_def]
    group
  have e2 : v * r * v⁻¹ = r := by rw [hvr]; group
  have e3 : v * w * v⁻¹ = a' * w := by rw [ha']; group
  have e4 : ⁅r, a' * w⁆ = a' * ⁅r, w⁆ * a'⁻¹ := by
    calc ⁅r, a' * w⁆ = (r * a') * w * r⁻¹ * w⁻¹ * a'⁻¹ := by
          simp only [commutatorElement_def]; group
      _ = (a' * r) * w * r⁻¹ * w⁻¹ * a'⁻¹ := by rw [← hra]
      _ = a' * ⁅r, w⁆ * a'⁻¹ := by simp only [commutatorElement_def]; group
  have e5 : a' * ⁅r, w⁆ * a'⁻¹ = ⁅r, w⁆ := by
    rw [hWcomm a' ha'W _ hz]
    group
  have e6 : v * ⁅r, w⁆ * v⁻¹ = ⁅r, w⁆ := by rw [e1, e2, e3, e4, e5]
  calc v * ⁅r, w⁆ = v * ⁅r, w⁆ * v⁻¹ * v := by group
    _ = ⁅r, w⁆ * v := by rw [e6]

section Natural

variable {M V Q P H : Subgroup G} {n f : ℕ}
  {Φ : ↥(StatedSp n (GaloisField 2 f)) ≃* Xbar V H}
  {ψ : (Fin n ⊕ Fin n → GaloisField 2 f) ≃+ Additive ↥(wOf V H)}
  {a : Fin n ⊕ Fin n → GaloisField 2 f} {T : Subgroup ↥(StatedSp n (GaloisField 2 f))}

set_option hygiene false in
local notation "ψG " v:max => ((Additive.toMul (ψ v) : ↥(wOf V H)) : G)

theorem bigRW_psi_mul (u v : Fin n ⊕ Fin n → GaloisField 2 f) : ψG u * ψG v = ψG (u + v) := by
  rw [map_add]
  rfl

theorem bigRW_psi_injective {u v : Fin n ⊕ Fin n → GaloisField 2 f} (h : ψG u = ψG v) :
    u = v :=
  ψ.injective (Additive.toMul.injective (Subtype.ext h))

theorem bigRW_psi_zero : ψG 0 = 1 := by simp

theorem bigRW_vec_add_self (u : Fin n ⊕ Fin n → GaloisField 2 f) : u + u = 0 := by
  funext i
  exact CharTwo.add_self_eq_zero (u i)

theorem bigRW_psi_mul_self (u : Fin n ⊕ Fin n → GaloisField 2 f) : ψG u * ψG u = 1 := by
  rw [bigRW_psi_mul, bigRW_vec_add_self, bigRW_psi_zero]

theorem bigRW_conj_act_eq_trans (hVH : V ≤ H) (hNat : BigNatCfg V H hVH Φ ψ)
    (hT : CaseM.IsTransGroup a T) (hTV : T.map Φ.toMonoidHom = Vy V H) {v : G} (hvV : v ∈ V)
    (hvW : v ∉ wOf V H) :
    ∃ μ : GaloisField 2 f, μ ≠ 0 ∧ ∀ (x : ↥(xOf V H)) (g : ↥(StatedSp n (GaloisField 2 f))),
      Φ.symm (xToXbar hVH x) = g → ∀ w : Fin n ⊕ Fin n → GaloisField 2 f,
        ((x : G) * v * (x : G)⁻¹) * ψG w * ((x : G) * v * (x : G)⁻¹)⁻¹ =
          ψG (w + (μ * CaseM.spForm (SpExtras.mat n (GaloisField 2 f) g *ᵥ a) w) •
            (SpExtras.mat n (GaloisField 2 f) g *ᵥ a)) := by
  have hVX : V ≤ xOf V H := le_xOf (V_mem_omegaOf V H)
  set z : ↥(xOf V H) := ⟨v, hVX hvV⟩
  have hzV : xToXbar hVH z ∈ Vy V H :=
    Subgroup.mem_subgroupOf.mpr
      (mem_barOf_iff.mpr ⟨Subgroup.inclusion (xOf_le_H hVH) z, hvV, rfl⟩)
  rw [← hTV] at hzV
  obtain ⟨t, htT, htz⟩ := Subgroup.mem_map.mp hzV
  have ht1 : t ≠ 1 := by
    intro h1
    apply hvW
    have h2 : xToXbar hVH z = 1 := by rw [← htz, h1, map_one]
    have h4 : piBar V H (Subgroup.inclusion (xOf_le_H hVH) z) = 1 := by
      rw [← coe_xToXbar hVH z, h2, Subgroup.coe_one]
    exact (piBar_eq_one_iff _).mp h4
  obtain ⟨μ, hct⟩ := (hT.1 t).1 htT
  have hμ : μ ≠ 0 := by
    rintro rfl
    apply ht1
    apply SpExtras.mat_injective
    rw [hct, ModelRank.spTrans_zero, map_one]
  refine ⟨μ, hμ, fun x g hg w => ?_⟩
  have htz' : Φ.symm (xToXbar hVH z) = t := by
    rw [← htz]
    exact Φ.symm_apply_apply t
  set y : ↥(xOf V H) := x * z * x⁻¹ with hy
  have hyΦ : Φ.symm (xToXbar hVH y) = g * t * g⁻¹ := by
    rw [hy]
    simp only [map_mul, map_inv]
    rw [htz', hg]
  have hymat : SpExtras.mat n (GaloisField 2 f) (Φ.symm (xToXbar hVH y)) =
      CaseM.spTrans (SpExtras.mat n (GaloisField 2 f) g *ᵥ a) μ := by
    rw [hyΦ, CaseM.mat_conj_of_mat_eq hct g]
  have key := hNat.equiv y w
  rw [hymat, CFSG.Timmesfeld.Transvection.ModelRank.spTrans_mulVec] at key
  exact key.symm

theorem bigRW_spForm_eq_zero_of_commute [Finite G] (hc : MinCex M V Q P H)
    (hNat : BigNatCfg V H hc.V_le_H Φ ψ) (ha : a ≠ 0) (hT : CaseM.IsTransGroup a T)
    (hTV : T.map Φ.toMonoidHom = Vy V H) {w : Fin n ⊕ Fin n → GaloisField 2 f}
    (hw : ∀ v ∈ V, v * ψG w = ψG w * v) : CaseM.spForm a w = 0 := by
  obtain ⟨v, hvV, hvW⟩ := SetLike.not_le_iff_exists.mp hc.not_V_le_wOf
  obtain ⟨μ, hμ, hact⟩ := bigRW_conj_act_eq_trans hc.V_le_H hNat hT hTV hvV hvW
  have h1 := hact 1 1 (by rw [map_one, map_one]) w
  simp only [OneMemClass.coe_one, one_mul, inv_one, mul_one, map_one, Matrix.one_mulVec] at h1
  have h2 : v * ψG w * v⁻¹ = ψG w := by rw [hw v hvV]; group
  rw [h2] at h1
  have h3 := bigRW_psi_injective h1
  have h4 : (μ * CaseM.spForm a w) • a = 0 := by
    have := congrArg (fun y => y - w) h3
    simpa using this.symm
  rcases smul_eq_zero.mp h4 with h | h
  · exact (mul_eq_zero.mp h).resolve_left hμ
  · exact absurd h ha

theorem bigRW_eq_smul_of_psi_mem_V [Finite G] (hH : BigEndHyp M V Q P H) (hf : 2 ^ f = qBar V H)
    (hNat : BigNatCfg V H hH.setup.mc.toMinCex.V_le_H Φ ψ) (ha : a ≠ 0)
    (hT : CaseM.IsTransGroup a T) (hTV : T.map Φ.toMonoidHom = Vy V H)
    {u : Fin n ⊕ Fin n → GaloisField 2 f} (hu : ψG u ∈ V) : ∃ l : GaloisField 2 f, u = l • a := by
  have hf0 : f ≠ 0 := by
    rintro rfl
    have h4 := hH.q_big
    rw [← hf] at h4
    norm_num at h4
  have hFcard : Nat.card (GaloisField 2 f) = qBar V H := by
    rw [GaloisField.card 2 f hf0, hf]
  have hmem : ∀ l : GaloisField 2 f, ψG (l • a) ∈ V ⊓ wOf V H := by
    intro l
    refine Subgroup.mem_inf.mpr ⟨?_, (Additive.toMul (ψ (l • a))).2⟩
    by_cases hl : l = 0
    · rw [hl, zero_smul, bigRW_psi_zero]
      exact V.one_mem
    · exact hNat.point (l • a) T (smul_ne_zero hl ha) (CaseOADeg.isTransGroup_smul hl hT) hTV
  let θ : GaloisField 2 f → ↥(V ⊓ wOf V H) := fun l => ⟨ψG (l • a), hmem l⟩
  have hθinj : Function.Injective θ := by
    intro l l' h
    have h1 : ψG (l • a) = ψG (l' • a) := congrArg (fun x : ↥(V ⊓ wOf V H) => (x : G)) h
    have h2 := bigRW_psi_injective h1
    have h3 : (l - l') • a = 0 := by rw [sub_smul, h2, sub_self]
    rcases smul_eq_zero.mp h3 with h4 | h4
    · exact sub_eq_zero.mp h4
    · exact absurd h4 ha
  have hθbij : Function.Bijective θ :=
    hθinj.bijective_of_nat_card_le (hH.module.trans hFcard.symm).le
  obtain ⟨l, hl⟩ := hθbij.2 ⟨ψG u, Subgroup.mem_inf.mpr ⟨hu, (Additive.toMul (ψ u)).2⟩⟩
  exact ⟨l, (bigRW_psi_injective (congrArg (fun x : ↥(V ⊓ wOf V H) => (x : G)) hl)).symm⟩

theorem bigRW_commute_conj [Finite G] (hc : MinCex M V Q P H) (hT : CaseM.IsTransGroup a T)
    (hTV : T.map Φ.toMonoidHom = Vy V H) {g : ↥(StatedSp n (GaloisField 2 f))}
    {x₀ : ↥(xOf V H)} (hx : xToXbar hc.V_le_H x₀ = Φ g)
    (hperp : CaseM.spForm a (SpExtras.mat n (GaloisField 2 f) g *ᵥ a) = 0) :
    ∀ u ∈ V, ∀ r ∈ conjSubgroup (x₀ : G) V, u * r = r * u := by
  have hVH : V ≤ H := hc.V_le_H
  have hVZ : VZ V H = (T.map Φ.toMonoidHom).map (projZ V H) := by
    unfold VZ
    rw [hTV]
  have hxz : xToZ hVH x₀ = projZ V H (Φ g) := by rw [xToZ_apply, hx]
  have hcom : Commuting T (conjSub T g) := hT.commuting (hT.conjSub g) hperp
  have h := hc.commute_conj_of_commute_tilde (x₁ := 1) (x₂ := x₀) (by
    intro α hα β hβ
    rw [map_one, conjSubgroup_one, hVZ] at hα
    rw [hxz] at hβ
    have hβ' := mem_conjSubgroup.mp hβ
    rw [hVZ] at hβ'
    obtain ⟨y₁, hy₁, rfl⟩ := Subgroup.mem_map.mp hα
    obtain ⟨t₁, ht₁, rfl⟩ := Subgroup.mem_map.mp hy₁
    obtain ⟨y₂, hy₂, h₂⟩ := Subgroup.mem_map.mp hβ'
    obtain ⟨t₂, ht₂, rfl⟩ := Subgroup.mem_map.mp hy₂
    have hβeq : β = projZ V H (Φ.toMonoidHom (g * t₂ * g⁻¹)) := by
      simp only [map_mul, map_inv]
      simp only [MulEquiv.coe_toMonoidHom] at h₂ ⊢
      rw [h₂]
      group
    have hc1 : t₁ * (g * t₂ * g⁻¹) = (g * t₂ * g⁻¹) * t₁ :=
      (hcom t₁ ht₁ _ (conj_mem_conjSub g ht₂)).eq
    rw [hβeq]
    calc projZ V H (Φ.toMonoidHom t₁) * projZ V H (Φ.toMonoidHom (g * t₂ * g⁻¹))
        = projZ V H (Φ.toMonoidHom (t₁ * (g * t₂ * g⁻¹))) := by simp only [map_mul]
      _ = projZ V H (Φ.toMonoidHom ((g * t₂ * g⁻¹) * t₁)) := by rw [hc1]
      _ = projZ V H (Φ.toMonoidHom (g * t₂ * g⁻¹)) * projZ V H (Φ.toMonoidHom t₁) := by
          simp only [map_mul])
  intro u hu r hr
  refine h u ?_ r hr
  rw [OneMemClass.coe_one, conjSubgroup_one]
  exact hu

end Natural

theorem bigWbarCentralizesStatement_holds : BigWbarCentralizesStatement := by
  intro G _ _ M V Q P H hH
  have hc : MinCex M V Q P H := hH.setup.mc.toMinCex
  intro x hx
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  obtain ⟨w, hwW, rfl⟩ := mem_WbarM_iff.mp hx
  have hy' : y ∈ RbarM M V H := hy
  obtain ⟨r, hr, rfl⟩ := Subgroup.mem_map.mp hy'
  have hrG : (r : G) ∈ xOf V H ⊓ Subgroup.centralizer (V : Set G) :=
    Subgroup.mem_subgroupOf.mp hr
  obtain ⟨hzW, hzV⟩ := bigRW_comm_mem_wOf_and_centralizes hc hrG hwW
  have hzC : ⁅(r : G), (w : G)⁆ ∈ wOf V H ⊓ Subgroup.centralizer (V : Set G) :=
    Subgroup.mem_inf.mpr ⟨hzW, Subgroup.mem_centralizer_iff.mpr fun v hv => hzV v hv⟩
  have hzP : ⁅(r : G), (w : G)⁆ ∈ P ⊓ wOf V H := hH.wOf_inf_centralizer_eq ▸ hzC
  have hzQ : ⁅(r : G), (w : G)⁆ ∈ inSubgroup (pCore 2) M := by
    have h1 := hc.P_le_Q (Subgroup.mem_inf.mp hzP).1
    rwa [hc.hQ] at h1
  have key : ((r * w : ↥M) : Mbar M) = ((w * r : ↥M) : Mbar M) := by
    rw [QuotientGroup.eq_iff_div_mem, Subgroup.mem_subgroupOf]
    have e : (((r * w) / (w * r) : ↥M) : G) = ⁅(r : G), (w : G)⁆ := by
      simp only [div_eq_mul_inv, _root_.mul_inv_rev, Subgroup.coe_mul, Subgroup.coe_inv,
        commutatorElement_def]
      group
    rw [e]
    exact hzQ
  simpa only [QuotientGroup.mk'_apply, QuotientGroup.mk_mul] using key

theorem bigRNontrivialStatement_of_local (hZ : Sec34CentreTrivialStatement)
    (hN : BigNaturalStatement) (hIW : BigIWStatement) (hLoc : BigPLocalStatement) :
    BigRNontrivialStatement := by
  intro G _ _ M V Q P H hH
  have hc : MinCex M V Q P H := hH.setup.mc.toMinCex
  have hVH : V ≤ H := hc.V_le_H
  have hVX : V ≤ xOf V H := le_xOf (V_mem_omegaOf V H)
  have hcentre : Subgroup.center (Xbar V H) = ⊥ :=
    hZ G M V Q P H ⟨hH.setup, hH.tilde, hH.concl⟩ hH.three hH.centre
  have hcP : cPbar V H P ≤ wOf V H := hIW G M V Q P H hH hcentre
  obtain ⟨n, f, Φ, ψ, hn2, hf, hequiv, ⟨a, T, ha, hT, hTV⟩, hpoint⟩ := hN G M V Q P H hH hcentre
  have hNat : BigNatCfg V H hH.setup.mc.toMinCex.V_le_H Φ ψ := ⟨hequiv, hpoint⟩
  have hiff := (hLoc G M V Q P H hH hcentre hcP hf Φ ψ hNat a T ha hT hTV).1
  obtain ⟨a'', ha''0, haa'', ha''F⟩ := exists_perp_vec_not_smul hn2 ha
  obtain ⟨g, hg⟩ := exists_mat_mulVec_eq_of_ne_zero ha ha''0
  obtain ⟨x₀, hx₀⟩ := xToXbar_surjective hVH (Φ g)
