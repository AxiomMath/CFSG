variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}
  {hc : Ctx M Q Z B} {n : ℕ} {t : G} {m : ℕ} {X : Subgroup G}

theorem Env.exists_mem_CN_not_mem_Q (e : Env hc n t m X) : ∃ a ∈ hc.CN t, a ∉ Q := by
  by_contra hcon
  push Not at hcon
  have h1 : Nat.card ↥(hc.CN t) ≤ Nat.card ↥Q := Subgroup.card_le_of_le hcon
  rw [e.hs.cardN] at h1
  have h4 := hc.hyp.q4
  have hQpos : 0 < Nat.card ↥Q := Nat.card_pos
  nlinarith

theorem Env.conj_Vt_eq (I : Inputs) (e : Env hc n t m X) {h : G} (hh : h ∈ M)
    (hN : conjSubgroup h (hc.CN t) = hc.CN t) :
    conjSubgroup h (Vt M (LB M Q B) B Z t) = Vt M (LB M Q B) B Z t := by
  obtain ⟨a, ha, haQ⟩ := e.exists_mem_CN_not_mem_Q
  have haM : a ∈ M := e.CN_le_M ha
  have hha : h * a * h⁻¹ ∈ hc.CN t := by
    rw [← hN]
    exact mem_conjSubgroup.mpr (by rw [show h⁻¹ * (h * a * h⁻¹) * h = a by group]; exact ha)
  have hhaQ : h * a * h⁻¹ ∉ Q := by
    intro hq
    apply haQ
    have := (hc.conj_mem_Q_of_mem_M (M.inv_mem hh)).1 _ hq
    rwa [show h⁻¹ * (h * a * h⁻¹) * h⁻¹⁻¹ = a by group] at this
  have h1 : Q1 hc (h * a * h⁻¹) = conjSubgroup h (Q1 hc a) := Q1_conj hc hh haM
  rw [e.Q1_eq_V I hha hhaQ, e.Q1_eq_V I ha haQ] at h1
  exact h1.symm

theorem Env.conj_Rt_le (I : Inputs) (e : Env hc n t m X) {h : G} (hh : h ∈ M)
    (hV : conjSubgroup h (Vt M (LB M Q B) B Z t) = Vt M (LB M Q B) B Z t) :
    conjSubgroup h (Rt M (LB M Q B) t) ≤ Rt M (LB M Q B) t := by
  have ht := e.hs.toSec5.mem
  have hle : Rt M (LB M Q B) t ≤
      (Rt M (LB M Q B) t).comap (MulAut.conj h).toMonoidHom := by
    refine iSup₂_le fun m' hm' => iSup_le fun hT => ?_
    intro y hy
    show h * y * h⁻¹ ∈ Rt M (LB M Q B) t
    have hy' : h * y * h⁻¹ ∈ conjSubgroup (h * m') (LB M Q B) := by
      rw [mem_conjSubgroup]
      have : (h * m')⁻¹ * (h * y * h⁻¹) * (h * m') = m'⁻¹ * y * m' := by group
      rw [this]
      exact mem_conjSubgroup.mp hy
    have hBV : conjSubgroup (h * m') B ⊔ Z ≤ Vt M (LB M Q B) B Z t := by
      refine sup_le ?_ sec39_Z_le_Vt
      have h1 : conjSubgroup h (conjSubgroup m' B) ≤ conjSubgroup h
          (Vt M (LB M Q B) B Z t) := Subgroup.map_mono (sec39_conjB_le_Vt hm' hT)
      rwa [← conjSubgroup_mul, hV] at h1
    obtain ⟨r, hr, hrBZ⟩ := e.conj_orbit I (h * m') (M.mul_mem hh hm') hBV
    have hLeq : conjSubgroup (h * m') (LB M Q B) = conjSubgroup r (LB M Q B) :=
      hc.conj_LB_eq_of_conj_BZ (M.mul_mem hh hm') (hc.Rt_le_M t hr) hrBZ
    rw [hLeq] at hy'
    have hy2 : r⁻¹ * (h * y * h⁻¹) * r ∈ LB M Q B := mem_conjSubgroup.mp hy'
    have hy3 : r⁻¹ * (h * y * h⁻¹) * r ∈ Rt M (LB M Q B) t := le_Rt (LB M Q B) ht hy2
    have := (Rt M (LB M Q B) t).mul_mem ((Rt M (LB M Q B) t).mul_mem hr hy3)
      ((Rt M (LB M Q B) t).inv_mem hr)
    rwa [show r * (r⁻¹ * (h * y * h⁻¹) * r) * r⁻¹ = h * y * h⁻¹ by group] at this
  intro y hy
  obtain ⟨r, hr, rfl⟩ := hy
  exact hle hr


theorem Env.commutator_Rt_le (I : Inputs) (e : Env hc n t m X) :
    ⁅Rt M (LB M Q B) t, Rt M (LB M Q B) t⁆ ≤ X := by
  have hQX := e.hQX
  have hcen := e.N_central I.h34
  rw [Subgroup.commutator_le]
  intro r hr r' hr'
  have hr1 : r ∈ X ⊔ hc.CN t := by rw [sup_comm, e.hNX]; exact hr
  have hr2 : r' ∈ X ⊔ hc.CN t := by rw [sup_comm, e.hNX]; exact hr'
  obtain ⟨x, hx, n₁, hn₁, rfl⟩ := exists_mul_of_mem_sup_of_le_normalizer e.X_le_normalizer_CN hr1
  obtain ⟨x', hx', n₂, hn₂, rfl⟩ := exists_mul_of_mem_sup_of_le_normalizer e.X_le_normalizer_CN hr2
  have hxM : x ∈ M := e.X_le_M hx
  have hxR : x ∈ Rt M (LB M Q B) t := e.hXR hx
  have hx'R : x' ∈ Rt M (LB M Q B) t := e.hXR hx'
  have hn₂R : n₂ ∈ Rt M (LB M Q B) t := (Ctx.mem_CN.mp hn₂).1
  have hx'n₂R : x' * n₂ ∈ Rt M (LB M Q B) t := (Rt M (LB M Q B) t).mul_mem hx'R hn₂R
  have q1 : ⁅n₁, x' * n₂⁆ ∈ Q := by
    rw [← commutatorElement_inv]
    exact Q.inv_mem (hcen _ hx'n₂R n₁ hn₁)
  have q2 : ⁅x, n₂⁆ ∈ Q := hcen x hxR n₂ hn₂
  have hxx' : ⁅x, x'⁆ ∈ X := by
    simp only [commutatorElement_def]
    exact X.mul_mem (X.mul_mem (X.mul_mem hx hx') (X.inv_mem hx)) (X.inv_mem hx')
  have e1 : ⁅x * n₁, x' * n₂⁆ =
      (x * ⁅n₁, x' * n₂⁆ * x⁻¹) * (⁅x, x'⁆ * (x' * ⁅x, n₂⁆ * x'⁻¹)) := by
    simp only [commutatorElement_def]
    group
  rw [e1]
  have hQ1 : x * ⁅n₁, x' * n₂⁆ * x⁻¹ ∈ Q := (hc.conj_mem_Q_of_mem_M hxM).1 _ q1
  have hQ2 : x' * ⁅x, n₂⁆ * x'⁻¹ ∈ Q := (hc.conj_mem_Q_of_mem_M (e.X_le_M hx')).1 _ q2
  exact X.mul_mem (hQX hQ1) (X.mul_mem hxx' (hQX hQ2))

theorem le_commutator_sup_of_perfect {X Q : Subgroup G} (hQX : Q ≤ X) [(Q.subgroupOf X).Normal]
    (hperf : commutator (↥X ⧸ Q.subgroupOf X) = ⊤) : X ≤ ⁅X, X⁆ ⊔ Q := by
  let π : ↥X →* ↥X ⧸ Q.subgroupOf X := QuotientGroup.mk' (Q.subgroupOf X)
  let T : Subgroup ↥X := (⁅X, X⁆ ⊔ Q).subgroupOf X
  have hker : π.ker ≤ T := by
    intro x hx
    rw [QuotientGroup.ker_mk'] at hx
    exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_right (Subgroup.mem_subgroupOf.mp hx))
  have hcomm : commutator (↥X ⧸ Q.subgroupOf X) ≤ T.map π := by
    rw [commutator_def, Subgroup.commutator_le]
    intro a _ b _
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective b
    refine ⟨⁅x, y⁆, ?_, ?_⟩
    · refine Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_left ?_)
      exact Subgroup.commutator_mem_commutator x.2 y.2
    · simp [π]
  rw [hperf, top_le_iff] at hcomm
  intro x hx
  have h1 : π ⟨x, hx⟩ ∈ T.map π := by rw [hcomm]; exact Subgroup.mem_top _
  obtain ⟨t, ht, hte⟩ := h1
  have h2 : t⁻¹ * ⟨x, hx⟩ ∈ π.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hte, inv_mul_cancel]
  have h3 : ⟨x, hx⟩ ∈ T := by
    have := T.mul_mem ht (hker h2)
    rwa [mul_inv_cancel_left] at this
  exact Subgroup.mem_subgroupOf.mp h3


theorem commutator_quot_eq_top {X Q : Subgroup G} {m q : ℕ} (hm : 3 ≤ m)
    (hq2 : ∃ e : ℕ, q = 2 ^ e)
    (h : QuotSat X Q (IsOmegaPlus m q) ∨ QuotSat X Q (IsOmegaMinus m q)) :
    ∃ _ : (Q.subgroupOf X).Normal, commutator (↥X ⧸ Q.subgroupOf X) = ⊤ := by
  rcases h with ⟨hN, K, fK, finK, hK, ⟨e⟩⟩ | ⟨hN, K, fK, finK, hK, b, c, hirr, ⟨e⟩⟩
  · haveI : Group.IsPerfect ↥(StatedOmega (StatedQuadPlus m K)) :=
      (statedOmega_plus_quasisimple_of_three_le K m hm).1
    haveI : Group.IsPerfect (↥X ⧸ Q.subgroupOf X) :=
      Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
    exact ⟨hN, Group.isPerfect_def.mp inferInstance⟩
  · obtain ⟨ee, hee⟩ := hq2
    haveI : CharP K 2 := charP_two_of_card_eq_two_pow (hK.trans hee)
    haveI : Group.IsPerfect ↥(StatedOmega (StatedQuadMinus m K b c)) :=
      (statedOmega_minus_quasisimple_of_two_le K (by omega) hirr).1
    haveI : Group.IsPerfect (↥X ⧸ Q.subgroupOf X) :=
      Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
    exact ⟨hN, Group.isPerfect_def.mp inferInstance⟩

theorem Env.conj_X_le (I : Inputs) (e : Env hc n t m X) [(Q.subgroupOf X).Normal]
    (hperf : commutator (↥X ⧸ Q.subgroupOf X) = ⊤) {h : G} (hh : h ∈ M)
    (hN : conjSubgroup h (hc.CN t) = hc.CN t) : conjSubgroup h X ≤ X := by
  have hV := e.conj_Vt_eq I hh hN
  have hR := e.conj_Rt_le I hh hV
  have h1 := le_commutator_sup_of_perfect e.hQX hperf
  calc conjSubgroup h X ≤ conjSubgroup h (⁅X, X⁆ ⊔ Q) := Subgroup.map_mono h1
    _ = ⁅conjSubgroup h X, conjSubgroup h X⁆ ⊔ Q := by
        rw [conjSubgroup_sup', conjSubgroup_commutator, hc.conj_Q_eq hh]
    _ ≤ ⁅Rt M (LB M Q B) t, Rt M (LB M Q B) t⁆ ⊔ Q := by
        refine sup_le_sup_right (Subgroup.commutator_mono ?_ ?_) Q <;>
          exact (Subgroup.map_mono e.hXR).trans hR
    _ ≤ X := sup_le (e.commutator_Rt_le I) e.hQX

end Norm

