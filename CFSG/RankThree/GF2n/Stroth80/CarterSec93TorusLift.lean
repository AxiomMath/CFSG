theorem sup_Fhat_le_normalizer (h34 : Stroth34Statement) (hc : Ctx M Q Z B) {n : ℕ} {t : G}
    (hs : Sec5Hyp hc n t) {h : G} (hh : h ∈ M) :
    LB M Q B ⊔ Fhat M Q B h ≤ Subgroup.normalizer (LB M Q B : Set G) := by
  refine sup_le Subgroup.le_normalizer ?_
  intro f hf
  rw [← conjSubgroup_eq_self_iff]
  exact (pCoreIn_conj_LB_eq h34 hs hh hf).1

theorem conj_LB_eq_of_le_sup_Fhat (h34 : Stroth34Statement) (hc : Ctx M Q Z B) {n : ℕ} {t : G}
    (hs : Sec5Hyp hc n t) {h : G} (hh : h ∈ M) {g : G} (hgM : g ∈ M)
    (hle : conjSubgroup g (LB M Q B) ≤ LB M Q B ⊔ Fhat M Q B h) :
    conjSubgroup g (LB M Q B) = LB M Q B :=
  (stroth_3_5 h34 hc hs.width hs.n_gt hs.noA2 hs.gen).1 g hgM fun x hx =>
    sup_Fhat_le_normalizer h34 hc hs hh (hle hx)

theorem torus_transitive_of_inf_transitive
    {hc : Ctx M Q Z B} {n : ℕ} {t r : G} {Z0 : Subgroup G} {h : G}
    (cfg : Cfg93c hc n t r Z0 h)
    (hTI : ∀ x ∈ LB M Q B, x ∉ LB M Q B ⊓ conjSubgroup h (LB M Q B) →
      ∀ y ∈ LB M Q B, y ∉ LB M Q B ⊓ conjSubgroup h (LB M Q B) →
        ∃ g ∈ Xhat M Q B h, conjSubgroup g (LB M Q B) = LB M Q B ∧
          g * x * g⁻¹ * y⁻¹ ∈ LB M Q B ⊓ conjSubgroup h (LB M Q B)) :
    ∀ x ∈ LB M Q B, x ∉ Fhat M Q B h →
      ∀ y ∈ LB M Q B, y ∉ Fhat M Q B h →
        ∃ g ∈ M, conjSubgroup g (LB M Q B) = LB M Q B ∧
          g * x * g⁻¹ * y⁻¹ ∈ Fhat M Q B h := by
  intro x hxL hxF y hyL hyF
  have hHF : LB M Q B ⊓ conjSubgroup h (LB M Q B) ≤ Fhat M Q B h :=
    step93L2Second_H_le_pCore hc cfg.hh
  have hxH : x ∉ LB M Q B ⊓ conjSubgroup h (LB M Q B) := fun hxH => hxF (hHF hxH)
  have hyH : y ∉ LB M Q B ⊓ conjSubgroup h (LB M Q B) := fun hyH => hyF (hHF hyH)
  obtain ⟨g, hgX, hgL, hgy⟩ := hTI x hxL hxH y hyL hyH
  have hc' : Ctx M Q Z (conjSubgroup h B) := hc.conj_of_mem cfg.hh
  have hLconj : LB M Q (conjSubgroup h B) = conjSubgroup h (LB M Q B) := hc.LB_conj cfg.hh
  have hXH : Xhat M Q B h ≤ H0 M Z :=
    sup_le hc.LB_le_H0 (hLconj ▸ hc'.LB_le_H0)
  exact ⟨g, (hXH hgX).1, hgL, hHF hgy⟩

theorem torus_transitive_of_relIndex_eq
    (h34 : Stroth34Statement) {hc : Ctx M Q Z B} {n : ℕ} {t r : G} {Z0 : Subgroup G} {h : G}
    (cfg : Cfg93c hc n t r Z0 h)
    (hq : QuotSat (Xhat M Q B h) (Fhat M Q B h) (IsSLModel 2 (Nat.card Z)))
    (hsyl : Nat.card ↥(LB M Q B ⊔ Fhat M Q B h) =
      Nat.card ↥(Fhat M Q B h) * Nat.card Z) :
    ∀ x ∈ LB M Q B, x ∉ Fhat M Q B h →
      ∀ y ∈ LB M Q B, y ∉ Fhat M Q B h →
        ∃ g ∈ M, conjSubgroup g (LB M Q B) = LB M Q B ∧
          g * x * g⁻¹ * y⁻¹ ∈ Fhat M Q B h := by
  classical
  obtain ⟨hN, hSL⟩ := hq
  obtain ⟨K, hKF, hKFin, hKcard, hE⟩ := hSL
  letI : Field K := hKF
  letI : Finite K := hKFin
  obtain ⟨eSL⟩ := hE
  obtain ⟨⟨e, he⟩, hq4⟩ := card_Z_facts hc
  have hKe : Nat.card K = 2 ^ e := hKcard.trans he
  haveI : CharP K 2 := charP_two_of_card_eq_two_pow hKe
  let Fx : Subgroup ↥(Xhat M Q B h) := (Fhat M Q B h).subgroupOf (Xhat M Q B h)
  let Lx : Subgroup ↥(Xhat M Q B h) := (LB M Q B).subgroupOf (Xhat M Q B h)
  let U : Subgroup (↥(Xhat M Q B h) ⧸ Fx) := Lx.map (QuotientGroup.mk' Fx)
  let e₀ : (↥(Xhat M Q B h) ⧸ Fx) ≃* Matrix.SpecialLinearGroup (Fin 2) K :=
    eSL.trans (specialLinearGroupEquivStatedSL 2 K).symm
  let U₀ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K) := U.map e₀.toMonoidHom
  haveI hFxN : Fx.Normal := hN
  have hFxdef : Fx = (Fhat M Q B h).subgroupOf (Xhat M Q B h) := rfl
  have hLxdef : Lx = (LB M Q B).subgroupOf (Xhat M Q B h) := rfl
  have hUdef : U = Lx.map (QuotientGroup.mk' Fx) := rfl
  have hrel : (Fhat M Q B h).relIndex (LB M Q B) = Nat.card Z := by
    have hLn : LB M Q B ≤ Subgroup.normalizer (Fhat M Q B h : Set G) :=
      (le_sup_left : LB M Q B ≤ Xhat M Q B h).trans
        (le_normalizer_pCoreIn (Xhat M Q B h))
    have hcard := relIndex_mul_card_eq_card_sup hLn
    rw [hsyl] at hcard
    have hFpos : 0 < Nat.card ↥(Fhat M Q B h) := Nat.card_pos
    refine Nat.eq_of_mul_eq_mul_left hFpos ?_
    rw [mul_comm]
    exact hcard
  have hUcard : Nat.card U = Nat.card Z := by
    rw [hUdef, hLxdef]
    rw [← Subgroup.relIndex_ker (f := QuotientGroup.mk' Fx)
      (K := (LB M Q B).subgroupOf (Xhat M Q B h))]
    rw [QuotientGroup.ker_mk']
    rw [hFxdef]
    rw [Subgroup.relIndex_subgroupOf (le_sup_left : LB M Q B ≤ Xhat M Q B h)]
    exact hrel
  have hU₀card : Nat.card U₀ = Nat.card K := by
    show Nat.card (U.map e₀.toMonoidHom) = Nat.card K
    rw [Subgroup.card_map_of_injective e₀.injective, hUcard, hKcard]
  have hLx2 : IsPGroup 2 ↥Lx :=
    (isPGroup_LB_of_ctx hc).of_equiv
      (Subgroup.subgroupOfEquivOfLe (le_sup_left : LB M Q B ≤ Xhat M Q B h)).symm
  have hU2 : IsPGroup 2 ↥U := by
    show IsPGroup 2 ↥(Lx.map (QuotientGroup.mk' Fx))
    exact hLx2.map (QuotientGroup.mk' Fx)
  have hU₀2 : IsPGroup 2 ↥U₀ := by
    show IsPGroup 2 ↥(U.map e₀.toMonoidHom)
    exact hU2.of_equiv (Subgroup.equivMapOfInjective U e₀.toMonoidHom e₀.injective)
  have hidx : U₀.index = Nat.card K ^ 2 - 1 := by
    have h := Subgroup.card_mul_index U₀
    rw [card_sl2 (F := K), hU₀card] at h
    have hKpos : 0 < Nat.card K := Nat.card_pos
    exact Nat.eq_of_mul_eq_mul_left hKpos h
  have hodd : ¬ 2 ∣ U₀.index := by
    rw [hidx]
    have h4K : 4 ≤ Nat.card K := by rw [hKcard]; exact hq4
    exact (odd_sq_sub_one_of_two_pow ⟨e, hKe⟩ h4K).not_two_dvd_nat
  obtain ⟨c, hcU⟩ := exists_conjSubgroup_utri_eq_of_sylow (hU₀2.toSylow hodd)
  have hcU' : conjSubgroup c (utri K) = U₀ := by simpa using hcU
  let e₁ : (↥(Xhat M Q B h) ⧸ Fx) ≃* Matrix.SpecialLinearGroup (Fin 2) K :=
    e₀.trans (MulAut.conj c⁻¹)
  have hUe : U.map e₁.toMonoidHom = utri K := by
    have h1 : U.map e₁.toMonoidHom =
        (U.map e₀.toMonoidHom).map (MulAut.conj c⁻¹).toMonoidHom := by
      rw [show (e₀.trans (MulAut.conj c⁻¹)).toMonoidHom =
          (MulAut.conj c⁻¹).toMonoidHom.comp e₀.toMonoidHom from rfl]
      conv_rhs => rw [Subgroup.map_map]
    rw [h1]
    have h2 : U.map e₀.toMonoidHom = U₀ := rfl
    rw [h2, ← hcU']
    change conjSubgroup c⁻¹ (conjSubgroup c (utri K)) = utri K
    rw [conjSubgroup_conjSubgroup, inv_mul_cancel, conjSubgroup_one]
  have hXH : Xhat M Q B h ≤ H0 M Z := by
    have hc' : Ctx M Q Z (conjSubgroup h B) := hc.conj_of_mem cfg.hh
    have hLconj : LB M Q (conjSubgroup h B) = conjSubgroup h (LB M Q B) := hc.LB_conj cfg.hh
    exact sup_le hc.LB_le_H0 (hLconj ▸ hc'.LB_le_H0)
  intro x hxL hxF y hyL hyF
  have hxX' : x ∈ LB M Q B ⊔ conjSubgroup h (LB M Q B) := Subgroup.mem_sup_left hxL
  have hyX' : y ∈ LB M Q B ⊔ conjSubgroup h (LB M Q B) := Subgroup.mem_sup_left hyL
  have hxX : x ∈ Xhat M Q B h := hxX'
  have hyX : y ∈ Xhat M Q B h := hyX'
  let ux : ↥(Xhat M Q B h) ⧸ Fx := QuotientGroup.mk' Fx (⟨x, hxX⟩ : ↥(Xhat M Q B h))
  let uy : ↥(Xhat M Q B h) ⧸ Fx := QuotientGroup.mk' Fx (⟨y, hyX⟩ : ↥(Xhat M Q B h))
  have hux1 : ux ≠ 1 := by
    intro h1
    have hmem : (⟨x, hxX⟩ : ↥(Xhat M Q B h)) ∈ Fx :=
      (QuotientGroup.eq_one_iff (N := Fx) (x := (⟨x, hxX⟩ : ↥(Xhat M Q B h)))).mp h1
    exact hxF (Subgroup.mem_subgroupOf.mp hmem)
  have huy1 : uy ≠ 1 := by
    intro h1
    have hmem : (⟨y, hyX⟩ : ↥(Xhat M Q B h)) ∈ Fx :=
      (QuotientGroup.eq_one_iff (N := Fx) (x := (⟨y, hyX⟩ : ↥(Xhat M Q B h)))).mp h1
    exact hyF (Subgroup.mem_subgroupOf.mp hmem)
  have huxU : ux ∈ U := by
    show QuotientGroup.mk' Fx (⟨x, hxX⟩ : ↥(Xhat M Q B h)) ∈
      Lx.map (QuotientGroup.mk' Fx)
    exact Subgroup.mem_map.mpr
      ⟨(⟨x, hxX⟩ : ↥(Xhat M Q B h)),
        show (⟨x, hxX⟩ : ↥(Xhat M Q B h)) ∈ (LB M Q B).subgroupOf (Xhat M Q B h)
          from Subgroup.mem_subgroupOf.mpr hxL, rfl⟩
  have huyU : uy ∈ U := by
    show QuotientGroup.mk' Fx (⟨y, hyX⟩ : ↥(Xhat M Q B h)) ∈
      Lx.map (QuotientGroup.mk' Fx)
    exact Subgroup.mem_map.mpr
      ⟨(⟨y, hyX⟩ : ↥(Xhat M Q B h)),
        show (⟨y, hyX⟩ : ↥(Xhat M Q B h)) ∈ (LB M Q B).subgroupOf (Xhat M Q B h)
          from Subgroup.mem_subgroupOf.mpr hyL, rfl⟩
  have huxu : e₁ ux ∈ utri K := by
    rw [← hUe]
    exact Subgroup.mem_map.mpr ⟨ux, huxU, rfl⟩
  have huyu : e₁ uy ∈ utri K := by
    rw [← hUe]
    exact Subgroup.mem_map.mpr ⟨uy, huyU, rfl⟩
  obtain ⟨s, hs⟩ := mem_utri_iff.mp huxu
  obtain ⟨t', ht'⟩ := mem_utri_iff.mp huyu
  have hs0 : s ≠ 0 := by
    intro h0
    exact hux1 (e₁.injective (by rw [hs, h0, utriElt_zero, map_one]))
  have ht'0 : t' ≠ 0 := by
    intro h0
    exact huy1 (e₁.injective (by rw [ht', h0, utriElt_zero, map_one]))
  obtain ⟨b, hbB, hb⟩ := exists_mem_borel_conj_utriElt (F := K) hs0 ht'0
  have hbN : b ∈ Subgroup.normalizer (utri K : Set (Matrix.SpecialLinearGroup (Fin 2) K)) := by
    rw [normalizer_utri]
    exact hbB
  have hgQU : ∀ u ∈ U, e₁.symm b * u * (e₁.symm b)⁻¹ ∈ U := by
    intro u hu
    have hu' : e₁ u ∈ utri K := by
      rw [← hUe]
      exact Subgroup.mem_map.mpr ⟨u, hu, rfl⟩
    have hbu : b * e₁ u * b⁻¹ ∈ utri K :=
      ((Subgroup.mem_normalizer_iff.mp hbN) (e₁ u)).mp hu'
    have hcalc : e₁ (e₁.symm b * u * (e₁.symm b)⁻¹) = b * e₁ u * b⁻¹ := by
      simp only [map_mul, map_inv, MulEquiv.apply_symm_apply]
    have hmem : e₁ (e₁.symm b * u * (e₁.symm b)⁻¹) ∈ U.map e₁.toMonoidHom := by
      rw [hUe, hcalc]
      exact hbu
    exact (Subgroup.mem_map_iff_mem e₁.injective).mp hmem
  obtain ⟨gX, hgXπ⟩ := QuotientGroup.mk'_surjective Fx (e₁.symm b)
  have hgM : (gX : G) ∈ M := (hXH gX.2).1
  have hmemL : ∀ z ∈ LB M Q B,
      (gX : G) * z * (gX : G)⁻¹ ∈ LB M Q B ⊔ Fhat M Q B h := by
    intro z hz
    have hzX' : z ∈ LB M Q B ⊔ conjSubgroup h (LB M Q B) := Subgroup.mem_sup_left hz
    have hzX : z ∈ Xhat M Q B h := hzX'
    have hprodX : (gX : G) * z * (gX : G)⁻¹ ∈ Xhat M Q B h :=
      (Xhat M Q B h).mul_mem ((Xhat M Q B h).mul_mem gX.2 hzX)
        ((Xhat M Q B h).inv_mem gX.2)
    have hπU : QuotientGroup.mk' Fx
        (⟨(gX : G) * z * (gX : G)⁻¹, hprodX⟩ : ↥(Xhat M Q B h)) ∈ U := by
      have heq : QuotientGroup.mk' Fx
          (⟨(gX : G) * z * (gX : G)⁻¹, hprodX⟩ : ↥(Xhat M Q B h)) =
          e₁.symm b * QuotientGroup.mk' Fx (⟨z, hzX⟩ : ↥(Xhat M Q B h)) *
            (e₁.symm b)⁻¹ := by
        have h1 : (⟨(gX : G) * z * (gX : G)⁻¹, hprodX⟩ : ↥(Xhat M Q B h)) =
            gX * (⟨z, hzX⟩ : ↥(Xhat M Q B h)) * gX⁻¹ := Subtype.ext rfl
        rw [h1, map_mul, map_mul, map_inv, hgXπ]
      rw [heq]
      have hzU : QuotientGroup.mk' Fx (⟨z, hzX⟩ : ↥(Xhat M Q B h)) ∈ U := by
        show QuotientGroup.mk' Fx (⟨z, hzX⟩ : ↥(Xhat M Q B h)) ∈ Lx.map (QuotientGroup.mk' Fx)
        exact Subgroup.mem_map.mpr
          ⟨(⟨z, hzX⟩ : ↥(Xhat M Q B h)),
            show (⟨z, hzX⟩ : ↥(Xhat M Q B h)) ∈ (LB M Q B).subgroupOf (Xhat M Q B h)
              from Subgroup.mem_subgroupOf.mpr hz, rfl⟩
      exact hgQU _ hzU
    have hcomap : (⟨(gX : G) * z * (gX : G)⁻¹, hprodX⟩ : ↥(Xhat M Q B h)) ∈
        Subgroup.comap (QuotientGroup.mk' Fx) U := Subgroup.mem_comap.mpr hπU
    have hcomap' : (⟨(gX : G) * z * (gX : G)⁻¹, hprodX⟩ : ↥(Xhat M Q B h)) ∈
        Lx ⊔ Fx := by
      rw [hUdef, QuotientGroup.comap_map_mk' Fx Lx] at hcomap
      rwa [sup_comm] at hcomap
    have hsub : (⟨(gX : G) * z * (gX : G)⁻¹, hprodX⟩ : ↥(Xhat M Q B h)) ∈
        (LB M Q B ⊔ Fhat M Q B h).subgroupOf (Xhat M Q B h) := by
      rw [Subgroup.subgroupOf_sup (le_sup_left : LB M Q B ≤ Xhat M Q B h)
        (pCoreIn_le (Xhat M Q B h))]
      exact hcomap'
    exact Subgroup.mem_subgroupOf.mp hsub
  have hconjL : conjSubgroup (gX : G) (LB M Q B) ≤ LB M Q B ⊔ Fhat M Q B h := by
    intro z hz
    rw [mem_conjSubgroup] at hz
    have h := hmemL ((gX : G)⁻¹ * z * (gX : G)) hz
    rwa [show (gX : G) * ((gX : G)⁻¹ * z * (gX : G)) * (gX : G)⁻¹ = z by group] at h
  have hgL : conjSubgroup (gX : G) (LB M Q B) = LB M Q B :=
    conj_LB_eq_of_le_sup_Fhat h34 hc cfg.hs.toSec5 cfg.hh hgM hconjL
  have hzX : (gX : G) * x * (gX : G)⁻¹ * y⁻¹ ∈ Xhat M Q B h :=
