section Linear7

variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}

theorem sec7_natural_data (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec7Hyp hc n t) :
    NaturalScalarData hc t := by
  obtain ⟨m, hm2, hm⟩ := hs.orth
  rcases hm with hP | hMi
  · have hm3 : 3 ≤ m := by
      by_contra hlt
      have h2 : m = 2 := by omega
      subst h2
      exact hs.notPlus4 hP
    obtain ⟨K', hF, hFin, hcard, hnat⟩ := hP
    exact ⟨K', hF, hFin, Fin m ⊕ Fin m, inferInstance, inferInstance,
      ⟨Sum.inl ⟨0, by omega⟩⟩, _, hcard, addCommutantScalar_statedOmegaPlus hm3, hnat⟩
  · obtain ⟨K', hF, hFin, hcard, b, c, hirr, hnat⟩ := hMi
    exact ⟨K', hF, hFin, Fin (m - 1) ⊕ Fin (m - 1) ⊕ Fin 2, inferInstance, inferInstance,
      ⟨Sum.inr (Sum.inr 0)⟩, _, hcard, addCommutantScalar_statedOmegaMinus hm2 hirr, hnat⟩

theorem sec7_linModel [(Q.subgroupOf M).Normal] (h34 : Stroth34Statement)
    (h310chi : Stroth310ChiStatement) (hZV : Sec7ZVStatement) (hZc : Sec7CentreMpStatement)
    (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec7Hyp hc n t) {Z0 : Subgroup G}
    (hZ0 : IsCentrePre Z0 (Rt M (LB M Q B) t) Q) :
    EndLinModel (Mbar M Q) (bar M Q (H0 M Z)) (bar M Q Z0) :=
  endg_linModel h34 h310chi hc hs.toSec5 (Or.inr hs.omegaNat) (sec7_natural_data hc hs) hZ0
    (fun z hz w hw => (hZc G M Q Z B hc n t hs Z0 hZ0 z hz).2 w hw)
    (fun u hu huQ => hZV G M Q Z B hc n t hs Z0 hZ0 u hu huQ)

end Linear7

section Quot7

variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}
  [(Q.subgroupOf M).Normal]

theorem endg_quot_facts (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec7Hyp hc n t)
    {a : ℕ} (ha : a = Nat.card Z) :
    ∃ (S : Type) (_ : Group S)
      (π : ↥(bar M Q (Rt M (LB M Q B) t)) →* S), Function.Surjective π ∧
      (∀ r : ↥(bar M Q (Rt M (LB M Q B) t)), π r = 1 ↔ (r : Mbar M Q) ∈ bar M Q (hc.CN t)) ∧
      IsSimpleGroup S ∧ 16 ∣ Nat.card S ∧
      ∀ p : ℕ, p.Prime → p ∣ a ^ 2 + 1 → p ∣ Nat.card S := by
  have ht : t ∈ LB M Q B := hs.toSec5.mem
  obtain ⟨jj, kk, hZ2, -⟩ := hc.hyp.cp
  have hq4 : 4 ≤ Nat.card Z := hc.hyp.q4
  obtain ⟨m, hm2, hm⟩ := hs.orth
  rcases hm with hP | hMi
  · have hm3 : 3 ≤ m := by
      by_contra hlt
      have h2 : m = 2 := by omega
      subst h2
      exact hs.notPlus4 hP
    obtain ⟨K', hF, hFin, hcard, hnat⟩ := hP
    haveI : CharP K' 2 := charP_two_of_card_eq_two_pow (hcard.trans hZ2)
    have hK4 : 4 ≤ Nat.card K' := by rw [hcard]; exact hq4
    obtain ⟨φ, hφr, hφk, -⟩ := hnat
    obtain ⟨π, hπs, hπk⟩ := hc.exists_bar_hom ht φ hφr hφk
    obtain ⟨h1, h2, h3⟩ := endg_omegaPlus_facts hK4 hm3
    refine ⟨_, inferInstance, π, hπs, hπk, h1, h2, fun p hp hpd => h3 p hp ?_⟩
    rw [hcard, ← ha]
    exact hpd
  · obtain ⟨K', hF, hFin, hcard, b, c, hirr, hnat⟩ := hMi
    haveI : CharP K' 2 := charP_two_of_card_eq_two_pow (hcard.trans hZ2)
    have hK4 : 4 ≤ Nat.card K' := by rw [hcard]; exact hq4
    obtain ⟨φ, hφr, hφk, -⟩ := hnat
    obtain ⟨π, hπs, hπk⟩ := hc.exists_bar_hom ht φ hφr hφk
    obtain ⟨h1, h2, h3⟩ := endg_omegaMinus_facts hK4 hm2 hirr
    refine ⟨_, inferInstance, π, hπs, hπk, h1, h2, fun p hp hpd => h3 p hp ?_⟩
    rw [hcard, ← ha]
    exact hpd

end Quot7

section EndHyp7

variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}
  [(Q.subgroupOf M).Normal]

theorem sec7_endHyp (h34 : Stroth34Statement) (h310chi : Stroth310ChiStatement)
    (hZV : Sec7ZVStatement) (hZc : Sec7CentreMpStatement) (hzcard : Sec7ZCardStatement)
    (h311a : Stroth311aStatement) (h44 : Stroth44Statement) (h45 : Stroth45Statement)
    (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec7Hyp hc n t) {Z0 : Subgroup G}
    (hZ0 : IsCentrePre Z0 (Rt M (LB M Q B) t) Q) :
    EndgameHyp (Mbar M Q) (bar M Q Z0) (bar M Q (Rt M (LB M Q B) t)) (bar M Q (hc.CN t))
      (bar M Q (H0 M Z)) (QuotientGroup.mk (⟨t, hc.LB_le_M hs.toSec5.mem⟩ : ↥M)) :=
  endg_endHyp h34 h44 h45 h311a hc hs.toSec5 hZ0
    (fun z hz => (hZc G M Q Z B hc n t hs Z0 hZ0 z hz).1)
    (hzcard G M Q Z B hc n t hs Z0 hZ0) hs.large (sec7_linModel h34 h310chi hZV hZc hc hs hZ0)
    (endg_quot_facts hc hs rfl)

end EndHyp7

section Final


theorem sec7End_of_parts (h34 : Stroth34Statement) (h310chi : Stroth310ChiStatement)
    (hzt : Sec7ZtStatement) (hZc : Sec7CentreMpStatement) (hzcard : Sec7ZCardStatement)
    (h311a : Stroth311aStatement) (h44 : Stroth44Statement) (h45 : Stroth45Statement) :
    Sec7EndStatement := by
  intro G _ _ M Q Z B _ hc n t hs Z0 hZ0 hTI hSyl hE
  have hZV : Sec7ZVStatement := sec7ZV_of_parts hzt hZc h310chi
  have hH := sec7_endHyp h34 h310chi hZV hZc hzcard h311a h44 h45 hc hs hZ0
  have hQZ0 : Q ≤ Z0 := hc.Q_le_centre hs.toSec5.mem hZ0
  have hZ0M : Z0 ≤ M := hc.centre_le_M t hZ0
  exact endg_core_of hH (endg_isTI_bar hQZ0 hZ0M hTI) hSyl (endg_hE_bar hQZ0 hZ0M hE)
    (CFSG.LargeExtraspecial.S8.corBListFacts_of CFSG.LargeExtraspecial.S8.corBSectResidual)
    (fun b hb => endg_arith b hb)

end Final

