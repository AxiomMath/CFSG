theorem close8Final_of_parts (h34 : Stroth34Statement) (h310chi : Stroth310ChiStatement)
    (h51 : Stroth51Statement) (hA : Sec8AExistsStatement) (hzt : Sec8ZtStatement)
    (h311a : Stroth311aStatement) (h44 : Stroth44Statement)
