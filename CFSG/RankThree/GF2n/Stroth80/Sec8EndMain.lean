section Linear8

variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}

theorem sec8_natural_data (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec8Hyp hc n t) :
    NaturalScalarData hc t := by
  obtain ⟨m, hm2, K', hF, hFin, hcard, hnat⟩ := hs.sp
  exact ⟨K', hF, hFin, Fin m ⊕ Fin m, inferInstance, inferInstance,
    ⟨Sum.inl ⟨0, by omega⟩⟩, _, hcard, addCommutantScalar_statedSp, hnat⟩

theorem sec8_ZV_of_parts (h51 : Stroth51Statement) (hA : Sec8AExistsStatement)
    (hzt : Sec8ZtStatement) (h310chi : Stroth310ChiStatement) (hc : Ctx M Q Z B) {n : ℕ}
    {t : G} (hs : Sec8Hyp hc n t) {Z0 : Subgroup G}
    (hZ0 : IsCentrePre Z0 (Rt M (LB M Q B) t) Q) {u : G} (hu : u ∈ Z0) (huQ : u ∉ Q) :
    Ut Q Z u = Vt M (LB M Q B) B Z t := by
  have huL : u ∈ LB M Q B := sec8_Z0_le_LB h51 hA hc hs hZ0 hu
  obtain ⟨hR, hV⟩ := hzt G M Q Z B hc n t hs Z0 hZ0 u hu huQ
  have hs' := hs.congr huL huQ hR hV
  exact ((h310chi G M Q Z B hc n u hs'.toSec5 (Or.inl hs'.spNat)).1).symm.trans hV

theorem sec8_W_centralized (h51 : Stroth51Statement) (hA : Sec8AExistsStatement)
    (hzt : Sec8ZtStatement) (h310chi : Stroth310ChiStatement) (hc : Ctx M Q Z B) {n : ℕ}
    {t : G} (hs : Sec8Hyp hc n t) {Z0 : Subgroup G}
    (hZ0 : IsCentrePre Z0 (Rt M (LB M Q B) t) Q) {z : G} (hz : z ∈ Z0)
    {w : G} (hw : w ∈ Wt Q (Vt M (LB M Q B) B Z t)) : ⁅z, w⁆ ∈ Z := by
  by_cases hzQ : z ∈ Q
  · exact hc.hyp.toHyp79.comm_mem_V hzQ hw.1
  · have hzL : z ∈ LB M Q B := sec8_Z0_le_LB h51 hA hc hs hZ0 hz
    obtain ⟨hR, hV⟩ := hzt G M Q Z B hc n t hs Z0 hZ0 z hz hzQ
    have hs' := hs.congr hzL hzQ hR hV
    have hzM : z ∈ M := hc.centre_le_M t hZ0 hz
    have hW := (h310chi G M Q Z B hc n z hs'.toSec5 (Or.inl hs'.spNat)).2
    rw [hV] at hW
    have hw' : w ∈ Q1 hc z := hW ▸ hw
    exact ((hc.mem_Q1_iff hzM).mp hw').2

theorem sec8_linModel [(Q.subgroupOf M).Normal] (h34 : Stroth34Statement)
    (h310chi : Stroth310ChiStatement) (h51 : Stroth51Statement) (hA : Sec8AExistsStatement)
    (hzt : Sec8ZtStatement) (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec8Hyp hc n t)
    {Z0 : Subgroup G} (hZ0 : IsCentrePre Z0 (Rt M (LB M Q B) t) Q) :
    EndLinModel (Mbar M Q) (bar M Q (H0 M Z)) (bar M Q Z0) :=
  endg_linModel h34 h310chi hc hs.toSec5 (Or.inl hs.spNat) (sec8_natural_data hc hs) hZ0
    (fun z hz w hw => sec8_W_centralized h51 hA hzt h310chi hc hs hZ0 hz hw)
    (fun u hu huQ => sec8_ZV_of_parts h51 hA hzt h310chi hc hs hZ0 hu huQ)

end Linear8

section Quot8

variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}
  [(Q.subgroupOf M).Normal]

theorem endg_quot_facts_sp (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec8Hyp hc n t) :
    ∃ (S : Type) (_ : Group S)
      (π : ↥(bar M Q (Rt M (LB M Q B) t)) →* S), Function.Surjective π ∧
      (∀ r : ↥(bar M Q (Rt M (LB M Q B) t)), π r = 1 ↔ (r : Mbar M Q) ∈ bar M Q (hc.CN t)) ∧
      IsSimpleGroup S ∧ 16 ∣ Nat.card S ∧
      ∀ p : ℕ, p.Prime → p ∣ Nat.card Z ^ 2 + 1 → p ∣ Nat.card S := by
  have ht : t ∈ LB M Q B := hs.toSec5.mem
  obtain ⟨jj, kk, hZ2, -⟩ := hc.hyp.cp
  have hq4 : 4 ≤ Nat.card Z := hc.hyp.q4
  obtain ⟨m, hm2, K', hF, hFin, hcard, hnat⟩ := hs.sp
  haveI : CharP K' 2 := charP_two_of_card_eq_two_pow (hcard.trans hZ2)
  have hK4 : 4 ≤ Nat.card K' := by rw [hcard]; exact hq4
  obtain ⟨φ, hφr, hφk, -⟩ := hnat
  obtain ⟨π, hπs, hπk⟩ := hc.exists_bar_hom ht φ hφr hφk
  obtain ⟨h1, h2, h3⟩ := endg_sp_facts hK4 hm2
  refine ⟨_, inferInstance, π, hπs, hπk, h1, h2, fun p hp hpd => h3 p hp ?_⟩
  rw [hcard]
  exact hpd

end Quot8

section EndHyp8

variable {G : Type} [Group G] [Finite G] {M Q Z B : Subgroup G}
