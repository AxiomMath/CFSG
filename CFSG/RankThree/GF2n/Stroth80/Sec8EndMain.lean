theorem sec8_endHyp (h34 : Stroth34Statement) (h310chi : Stroth310ChiStatement)
    (h51 : Stroth51Statement) (hA : Sec8AExistsStatement) (hzt : Sec8ZtStatement)
    (h311a : Stroth311aStatement) (h44 : Stroth44Statement)
    (h45 : Stroth45Statement) (h54 : Stroth54Statement) (hge : Stroth6NbarGeStatement)
    (hc : Ctx M Q Z B) {n : ℕ} {t : G} (hs : Sec8Hyp hc n t) {Z0 : Subgroup G}
    (hZ0 : IsCentrePre Z0 (Rt M (LB M Q B) t) Q) :
    EndgameHyp (Mbar M Q) (bar M Q Z0) (bar M Q (Rt M (LB M Q B) t)) (bar M Q (hc.CN t))
      (bar M Q (H0 M Z)) (QuotientGroup.mk (⟨t, hc.LB_le_M hs.toSec5.mem⟩ : ↥M)) :=
  endg_endHyp h34 h44 h45 h311a hc hs.toSec5 hZ0 (sec8_Z0_le_LB h51 hA hc hs hZ0)
    (sec86ZCard_of_51 h51 hA G M Q Z B hc n t hs Z0 hZ0) (Sec8Hyp.large h54 hge hs)
    (sec8_linModel h34 h310chi h51 hA hzt hc hs hZ0) (endg_quot_facts_sp hc hs)

