variable {G : Type} [Group G] [Finite G] {M V Q P H : Subgroup G}

private structure SL2Setup (h : BigEndHyp M V Q P H)
    (hZ : Subgroup.center (Xbar V H) = ⊥) where
  f : ℕ
  n : ℕ
  hn : 2 ≤ n
  hf : 2 ≤ f
  h2f : 2 ^ f = qBar V H
  Φ : ↥(StatedSp n (GaloisField 2 f)) ≃* Xbar V H
  g : ↥(StatedSp n (GaloisField 2 f))
  hroot : ((conjSub ((Symplectic.rootDatum n (GaloisField 2 f)).rootGroup
    (Pi.single (⟨n - 1, by omega⟩ : Fin n) 1)) g).map Φ.toMonoidHom = Vy V H)

theorem map_conj_weyl_upper (F : Type) [Field F] [CharP F 2] :
    (upperUnipotent F).map (MulAut.conj (weylElt F)).toMonoidHom = lowerUnipotent F := by
  ext g
  have hw : (weylElt F)⁻¹ = weylElt F :=
    inv_eq_of_mul_eq_one_right weylElt_mul_self
  rw [RankOne.mem_map_conj, hw, RankOne.mem_upperUnipotent_iff,
    RankOne.mem_lowerUnipotent_iff]
  constructor
  · rintro ⟨t, ht⟩
    refine ⟨t, ?_⟩
    calc g = weylElt F * weylElt F * g * (weylElt F * weylElt F) := by
          rw [weylElt_mul_self]; group
      _ = weylElt F * (weylElt F * g * weylElt F) * weylElt F := by group
      _ = weylElt F * upperElt F t * weylElt F := by rw [← ht]
      _ = lowerElt F t := weylElt_mul_upperElt_mul_weylElt t
  · rintro ⟨t, rfl⟩
    refine ⟨t, ?_⟩
    calc weylElt F * lowerElt F t * weylElt F
        = weylElt F * (weylElt F * upperElt F t * weylElt F) * weylElt F := by
          rw [weylElt_mul_upperElt_mul_weylElt]
      _ = (weylElt F * weylElt F) * upperElt F t * (weylElt F * weylElt F) := by group
      _ = upperElt F t := by rw [weylElt_mul_self]; group

namespace SL2Setup

variable {h : BigEndHyp M V Q P H} {hZ : Subgroup.center (Xbar V H) = ⊥}

private def k (D : SL2Setup h hZ) : Fin D.n :=
  ⟨D.n - 1, Nat.sub_lt (by have := D.hn; omega : 1 ≤ D.n) (by norm_num)⟩

private noncomputable def sigma (D : SL2Setup h hZ) :
    Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f) →* Xbar V H :=
  D.Φ.toMonoidHom.comp ((MulAut.conj D.g).toMonoidHom.comp
    (longBlock (GaloisField 2 D.f) D.n D.k))

private theorem sigma_apply (D : SL2Setup h hZ)
    (s : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f)) :
    D.sigma s = D.Φ (D.g * longBlock (GaloisField 2 D.f) D.n D.k s * D.g⁻¹) := rfl

private theorem sigma_injective (D : SL2Setup h hZ) : Function.Injective D.sigma := by
  intro s t hst
  exact longBlock_injective (K := GaloisField 2 D.f) D.k
    ((MulAut.conj D.g).injective (D.Φ.injective hst))

private theorem map_upper (D : SL2Setup h hZ) :
    (upperUnipotent (GaloisField 2 D.f)).map D.sigma = Vy V H := by
  rw [sigma, ← Subgroup.map_map, ← Subgroup.map_map]
  change (conjSub ((upperUnipotent (GaloisField 2 D.f)).map
    (longBlock (GaloisField 2 D.f) D.n D.k)) D.g).map D.Φ.toMonoidHom = Vy V H
  rw [show (upperUnipotent (GaloisField 2 D.f)).map
      (longBlock (GaloisField 2 D.f) D.n D.k) =
      (Symplectic.rootDatum D.n (GaloisField 2 D.f)).rootGroup
        (Pi.single D.k (1 : ℤ)) from
    (CaseM.rootGroup_last_eq_map_upper (F := GaloisField 2 D.f)
      (by have := D.hn; omega : 1 ≤ D.n)).symm]
  simpa [k] using D.hroot

private theorem map_lower (D : SL2Setup h hZ) :
    (lowerUnipotent (GaloisField 2 D.f)).map D.sigma =
      (Vy V H).map (MulAut.conj (D.sigma (weylElt (GaloisField 2 D.f)))).toMonoidHom := by
  rw [← map_conj_weyl_upper (F := GaloisField 2 D.f), Subgroup.map_map]
  rw [show D.sigma.comp (MulAut.conj (weylElt (GaloisField 2 D.f))).toMonoidHom =
      (MulAut.conj (D.sigma (weylElt (GaloisField 2 D.f)))).toMonoidHom.comp D.sigma by
    refine MonoidHom.ext fun x => Subtype.ext ?_
    change ((D.sigma ((weylElt (GaloisField 2 D.f)) * x *
      (weylElt (GaloisField 2 D.f))⁻¹) : Xbar V H) : Hbar V H) =
      (((MulAut.conj (D.sigma (weylElt (GaloisField 2 D.f)))) (D.sigma x) :
        Xbar V H) : Hbar V H)
    rw [map_mul, map_mul, map_inv]
    rfl]
  rw [← Subgroup.map_map, map_upper]

end SL2Setup




private def NN (V H : Subgroup G) (y : G) : Subgroup G :=
  (V ⊓ wOf V H) ⊔ (conjSubgroup y V ⊓ wOf V H)

private def Ksub (V : Subgroup G) (y : G) : Subgroup G := V ⊔ conjSubgroup y V

private theorem NN_le_wOf (V H : Subgroup G) (y : G) : NN V H y ≤ wOf V H :=
  sup_le inf_le_right inf_le_right

private theorem V_le_normalizer_NN (hc : MinCex M V Q P H) {y : G} (hyH : y ∈ H) :
    V ≤ Subgroup.normalizer (NN V H y : Set G) := by
  have hmap : ∀ v ∈ V, ∀ n ∈ NN V H y, v * n * v⁻¹ ∈ NN V H y := by
    intro v hv n hn
    rw [NN, Subgroup.sup_eq_closure] at hn
    refine Subgroup.closure_induction (p := fun n _ => v * n * v⁻¹ ∈ NN V H y)
      ?_ ?_ ?_ ?_ hn
    · intro a ha
      rcases ha with ha | ha
      · obtain ⟨haV, haW⟩ := Subgroup.mem_inf.mp ha
        rw [show v * a * v⁻¹ = a by rw [hc.elemAb.comm hv haV]; group]
        exact Subgroup.mem_sup_left ⟨haV, haW⟩
      · obtain ⟨haV, haW⟩ := Subgroup.mem_inf.mp ha
        have hv' : v ∈ conjSubgroup (1 : G) V := by simpa [conjSubgroup_one] using hv
        have hcomm := hc.commutator_mem_conj_inf_wOf (y := (1 : G)) H.one_mem hv' haW
        rw [conjSubgroup_one] at hcomm
        have hmem : ⁅v, a⁆ ∈ NN V H y := Subgroup.mem_sup_left hcomm
        rw [show v * a * v⁻¹ = ⁅v, a⁆ * a by rw [commutatorElement_def]; group]
        exact (NN V H y).mul_mem hmem (Subgroup.mem_sup_right (by simpa using ha))
    · rw [show v * 1 * v⁻¹ = 1 by group]
      exact (NN V H y).one_mem
    · intro a b _ _ ha hb
      rw [show v * (a * b) * v⁻¹ = (v * a * v⁻¹) * (v * b * v⁻¹) by group]
      exact (NN V H y).mul_mem ha hb
    · intro a _ ha
      rw [show v * a⁻¹ * v⁻¹ = (v * a * v⁻¹)⁻¹ by group]
      exact (NN V H y).inv_mem ha
  intro v hv
  refine Subgroup.mem_normalizer_iff.mpr fun n => ⟨fun hn => hmap v hv n hn, fun hn => ?_⟩
  have h := hmap v⁻¹ (V.inv_mem hv) (v * n * v⁻¹) hn
  simpa [mul_assoc] using h

private theorem Vy_le_normalizer_NN (hc : MinCex M V Q P H) {y : G} (hyH : y ∈ H) :
    conjSubgroup y V ≤ Subgroup.normalizer (NN V H y : Set G) := by
  have hyVH : conjSubgroup y V ≤ H :=
    conjSubgroup_le_of_le_of_mem hc.V_le_H hyH
  have hmap : ∀ w ∈ conjSubgroup y V, ∀ n ∈ NN V H y,
      w * n * w⁻¹ ∈ NN V H y := by
    intro w hw n hn
    rw [NN, Subgroup.sup_eq_closure] at hn
    refine Subgroup.closure_induction (p := fun n _ => w * n * w⁻¹ ∈ NN V H y)
      ?_ ?_ ?_ ?_ hn
    · intro a ha
      rcases ha with ha | ha
      · obtain ⟨haV, haW⟩ := Subgroup.mem_inf.mp ha
        have hcomm := hc.commutator_mem_conj_inf_wOf (y := y) hyH hw haW
        have hmem : ⁅w, a⁆ ∈ NN V H y := Subgroup.mem_sup_right hcomm
        rw [show w * a * w⁻¹ = ⁅w, a⁆ * a by rw [commutatorElement_def]; group]
        exact (NN V H y).mul_mem hmem (Subgroup.mem_sup_left (by simpa using ha))
      · obtain ⟨haV, haW⟩ := Subgroup.mem_inf.mp ha
        have hmem : w * a * w⁻¹ ∈ conjSubgroup y V ⊓ wOf V H :=
          ⟨(conjSubgroup y V).mul_mem ((conjSubgroup y V).mul_mem hw haV)
              ((conjSubgroup y V).inv_mem hw),
            (Subgroup.mem_normalizer_iff.mp
              (H_le_normalizer_wOf V H (hyVH hw)) a).mp haW⟩
        exact Subgroup.mem_sup_right hmem
    · rw [show w * 1 * w⁻¹ = 1 by group]
      exact (NN V H y).one_mem
    · intro a b _ _ ha hb
      rw [show w * (a * b) * w⁻¹ = (w * a * w⁻¹) * (w * b * w⁻¹) by group]
      exact (NN V H y).mul_mem ha hb
    · intro a _ ha
      rw [show w * a⁻¹ * w⁻¹ = (w * a * w⁻¹)⁻¹ by group]
      exact (NN V H y).inv_mem ha
  intro w hw
  refine Subgroup.mem_normalizer_iff.mpr fun n => ⟨fun hn => hmap w hw n hn, fun hn => ?_⟩
  have h := hmap w⁻¹ ((conjSubgroup y V).inv_mem hw) (w * n * w⁻¹) hn
  simpa [mul_assoc] using h

private theorem Ksub_le_normalizer_NN (hc : MinCex M V Q P H) {y : G} (hyH : y ∈ H) :
    Ksub V y ≤ Subgroup.normalizer (NN V H y : Set G) :=
  sup_le (V_le_normalizer_NN hc hyH) (Vy_le_normalizer_NN hc hyH)

private theorem map_subgroupOf_xToXbar (hc : MinCex M V Q P H) {S : Subgroup G}
    (hS : S ≤ xOf V H) :
    (S.subgroupOf (xOf V H)).map (xToXbar hc.V_le_H) =
      (barOf V H S).subgroupOf (barOf V H (xOf V H)) := by
  ext y
  constructor
  · rintro ⟨s, hs, rfl⟩
    refine Subgroup.mem_subgroupOf.mpr (mem_barOf_iff.mpr ?_)
    exact ⟨⟨(s : G), xOf_le_H hc.V_le_H (hS (Subgroup.mem_subgroupOf.mp hs))⟩,
      Subgroup.mem_subgroupOf.mp hs, rfl⟩
  · intro hy
    obtain ⟨s, hsS, hsy⟩ := mem_barOf_iff.mp (Subgroup.mem_subgroupOf.mp hy)
    refine ⟨⟨(s : G), hS hsS⟩, hsS, ?_⟩
    refine Subtype.ext ?_
    rw [coe_xToXbar]
    rw [show (Subgroup.inclusion (xOf_le_H hc.V_le_H) ⟨(s : G), hS hsS⟩ : ↥H) = s from
      Subtype.ext rfl]
    exact hsy

private theorem map_V (hc : MinCex M V Q P H) :
    (V.subgroupOf (xOf V H)).map (xToXbar hc.V_le_H) = Vy V H := by
  rw [map_subgroupOf_xToXbar hc (le_xOf (V_mem_omegaOf V H))]
  rfl

private theorem map_Vy {h : BigEndHyp M V Q P H} {hZ : Subgroup.center (Xbar V H) = ⊥}
    (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    ((conjSubgroup (y : G) V).subgroupOf (xOf V H)).map
        (xToXbar h.setup.mc.toMinCex.V_le_H) =
      (Vy V H).map (MulAut.conj (D.sigma (weylElt (GaloisField 2 D.f)))).toMonoidHom := by
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  let yH : ↥H := ⟨(y : G), xOf_le_H hc.V_le_H y.2⟩
  rw [map_subgroupOf_xToXbar hc
    (le_xOf (conjSubgroup_mem_omegaOf (xOf_le_H hc.V_le_H y.2)))]
  rw [← conjSubgroup_piBar_barOf (V := V) (H := H) yH V]
  have hpi : (piBar V H yH : Hbar V H) = (xToXbar hc.V_le_H y : Hbar V H) := rfl
  rw [hpi]
  rw [subgroupOf_conjSubgroup (barOf V H (xOf V H)) (barOf V H V) (xToXbar hc.V_le_H y)]
  rw [hy]
  rfl

private theorem map_K {h : BigEndHyp M V Q P H} {hZ : Subgroup.center (Xbar V H) = ⊥}
    (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    ((Ksub V (y : G)).subgroupOf (xOf V H)).map
        (xToXbar h.setup.mc.toMinCex.V_le_H) =
      Vy V H ⊔ (Vy V H).map
        (MulAut.conj (D.sigma (weylElt (GaloisField 2 D.f)))).toMonoidHom := by
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  rw [Ksub, Subgroup.subgroupOf_sup (le_xOf (V_mem_omegaOf V H))
    (le_xOf (conjSubgroup_mem_omegaOf (xOf_le_H hc.V_le_H y.2))),
    Subgroup.map_sup, map_V hc, map_Vy D hy]

private theorem sigma_range {h : BigEndHyp M V Q P H} {hZ : Subgroup.center (Xbar V H) = ⊥}
    (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    D.sigma.range = ((Ksub V (y : G)).subgroupOf (xOf V H)).map
      (xToXbar h.setup.mc.toMinCex.V_le_H) := by
  rw [← Subgroup.map_top D.sigma,
    ← upperUnipotent_sup_lowerUnipotent (K := GaloisField 2 D.f),
    Subgroup.map_sup, D.map_upper, D.map_lower, map_K D hy]

private theorem exists_lift {h : BigEndHyp M V Q P H} {hZ : Subgroup.center (Xbar V H) = ⊥}
    (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f)))
    (s : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f)) :
    ∃ x : ↥(xOf V H), xToXbar h.setup.mc.toMinCex.V_le_H x = D.sigma s ∧
      (x : G) ∈ Ksub V (y : G) := by
  have hs : D.sigma s ∈ ((Ksub V (y : G)).subgroupOf (xOf V H)).map
      (xToXbar h.setup.mc.toMinCex.V_le_H) := by
    rw [← sigma_range D hy]
    exact ⟨s, rfl⟩
  obtain ⟨x, hx, hxs⟩ := Subgroup.mem_map.mp hs
  exact ⟨x, hxs, Subgroup.mem_subgroupOf.mp hx⟩

private theorem conjAutOn_eq_of_lift (hc : MinCex M V Q P H) {y : G} (hyH : y ∈ H)
    {x x' : ↥(xOf V H)} (hx : (x : G) ∈ Ksub V y) (hx' : (x' : G) ∈ Ksub V y)
    (heq : xToXbar hc.V_le_H x = xToXbar hc.V_le_H x') :
    (CFSG.GroupTheory.conjAutOn (NN V H y) (Subgroup.normalizer (NN V H y : Set G))
        le_rfl ⟨(x : G), Ksub_le_normalizer_NN hc hyH hx⟩) =
      (CFSG.GroupTheory.conjAutOn (NN V H y) (Subgroup.normalizer (NN V H y : Set G))
        le_rfl ⟨(x' : G), Ksub_le_normalizer_NN hc hyH hx'⟩) := by
  have hker : (x : G)⁻¹ * (x' : G) ∈ wOf V H := by
    have h1 : xToXbar hc.V_le_H (x⁻¹ * x') = 1 := by
      rw [map_mul, map_inv, heq, inv_mul_cancel]
    exact (cxw_xToXbar_eq_one hc.V_le_H (x⁻¹ * x')).mp h1
  ext n
  change (x : G) * n * (x : G)⁻¹ = (x' : G) * n * (x' : G)⁻¹
  have hcomm := hc.wOf_isElemAbelian.comm hker (NN_le_wOf V H y n.2)
  rw [show (x' : G) = (x : G) * ((x : G)⁻¹ * (x' : G)) by group]
  rw [show (x : G) * ((x : G)⁻¹ * (x' : G)) * n * ((x : G) * ((x : G)⁻¹ * (x' : G)))⁻¹ =
      (x : G) * (((x : G)⁻¹ * (x' : G)) * n * ((x : G)⁻¹ * (x' : G))⁻¹) *
        (x : G)⁻¹ by group]
  rw [show ((x : G)⁻¹ * (x' : G)) * n * ((x : G)⁻¹ * (x' : G))⁻¹ = n by
    rw [hcomm]; group]


private noncomputable def rho {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f) →*
      MulAut ↥(NN V H (y : G)) where
  toFun s := CFSG.GroupTheory.conjAutOn (NN V H (y : G))
    (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
    ⟨((Classical.choose (exists_lift D hy s) : ↥(xOf V H)) : G),
      Ksub_le_normalizer_NN h.setup.mc.toMinCex
        (xOf_le_H h.setup.mc.toMinCex.V_le_H y.2)
        (Classical.choose_spec (exists_lift D hy s)).2⟩
  map_one' := by
    let x := Classical.choose (exists_lift D hy 1)
    have hx := Classical.choose_spec (exists_lift D hy 1)
    have h1 : xToXbar h.setup.mc.toMinCex.V_le_H x =
        xToXbar h.setup.mc.toMinCex.V_le_H (1 : ↥(xOf V H)) := by
      rw [hx.1, map_one, map_one]
    have heq := conjAutOn_eq_of_lift h.setup.mc.toMinCex
      (xOf_le_H h.setup.mc.toMinCex.V_le_H y.2) hx.2 (Ksub V (y : G)).one_mem h1
    change CFSG.GroupTheory.conjAutOn (NN V H (y : G))
      (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
      ⟨((Classical.choose (exists_lift D hy 1) : ↥(xOf V H)) : G), _⟩ = 1
    rw [heq]
    exact map_one _
  map_mul' := by
    intro s t
    let xs := Classical.choose (exists_lift D hy s)
    let xt := Classical.choose (exists_lift D hy t)
    have hxs := Classical.choose_spec (exists_lift D hy s)
    have hxt := Classical.choose_spec (exists_lift D hy t)
    have hxst := Classical.choose_spec (exists_lift D hy (s * t))
    have hlift : xToXbar h.setup.mc.toMinCex.V_le_H (xs * xt) =
        xToXbar h.setup.mc.toMinCex.V_le_H
          (Classical.choose (exists_lift D hy (s * t))) := by
      rw [map_mul, hxs.1, hxt.1, hxst.1, map_mul]
    have hmem : ((xs * xt : ↥(xOf V H)) : G) ∈ Ksub V (y : G) :=
      (Ksub V (y : G)).mul_mem hxs.2 hxt.2
    have heq := conjAutOn_eq_of_lift h.setup.mc.toMinCex
      (xOf_le_H h.setup.mc.toMinCex.V_le_H y.2) hxst.2 hmem hlift.symm
    change CFSG.GroupTheory.conjAutOn (NN V H (y : G))
        (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
        ⟨((Classical.choose (exists_lift D hy (s * t)) : ↥(xOf V H)) : G), _⟩ =
      CFSG.GroupTheory.conjAutOn (NN V H (y : G))
          (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
          ⟨((Classical.choose (exists_lift D hy s) : ↥(xOf V H)) : G), _⟩ *
        CFSG.GroupTheory.conjAutOn (NN V H (y : G))
          (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
          ⟨((Classical.choose (exists_lift D hy t) : ↥(xOf V H)) : G), _⟩
    calc CFSG.GroupTheory.conjAutOn (NN V H (y : G))
          (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
          ⟨((Classical.choose (exists_lift D hy (s * t)) : ↥(xOf V H)) : G), _⟩
        = CFSG.GroupTheory.conjAutOn (NN V H (y : G))
            (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
            ⟨(xs : G) * (xt : G), _⟩ := heq
      _ = CFSG.GroupTheory.conjAutOn (NN V H (y : G))
            (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
            ⟨(xs : G), _⟩ *
          CFSG.GroupTheory.conjAutOn (NN V H (y : G))
            (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
            ⟨(xt : G), _⟩ := by
          rw [show (⟨((xs : ↥(xOf V H)) : G) * ((xt : ↥(xOf V H)) : G), _⟩ :
              ↥(Subgroup.normalizer (NN V H (y : G) : Set G))) =
            (⟨((xs : ↥(xOf V H)) : G), _⟩ *
              ⟨((xt : ↥(xOf V H)) : G), _⟩ :
                ↥(Subgroup.normalizer (NN V H (y : G) : Set G))) from Subtype.ext rfl]
          rw [map_mul]
      _ = CFSG.GroupTheory.conjAutOn (NN V H (y : G))
            (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
            ⟨((Classical.choose (exists_lift D hy s) : ↥(xOf V H)) : G), _⟩ *
          CFSG.GroupTheory.conjAutOn (NN V H (y : G))
            (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
            ⟨((Classical.choose (exists_lift D hy t) : ↥(xOf V H)) : G), _⟩ := rfl

private theorem coe_rho {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f)))
    {s : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f)} {x : ↥(xOf V H)}
    (hx : xToXbar h.setup.mc.toMinCex.V_le_H x = D.sigma s)
    (n : ↥(NN V H (y : G))) :
    ((rho D hy s n : ↥(NN V H (y : G))) : G) = (x : G) * n * (x : G)⁻¹ := by
  let hc : MinCex M V Q P H := h.setup.mc.toMinCex
  let xc := Classical.choose (exists_lift D hy s)
  have hxc := Classical.choose_spec (exists_lift D hy s)
  have heq : xToXbar hc.V_le_H x = xToXbar hc.V_le_H xc := by rw [hx, hxc.1]
  have hker : (x : G)⁻¹ * (xc : G) ∈ wOf V H := by
    refine (cxw_xToXbar_eq_one hc.V_le_H (x⁻¹ * xc)).mp ?_
    rw [map_mul, map_inv, heq, inv_mul_cancel]
  change ((CFSG.GroupTheory.conjAutOn (NN V H (y : G))
    (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
    ⟨(xc : G), Ksub_le_normalizer_NN hc (xOf_le_H hc.V_le_H y.2) hxc.2⟩ n :
      ↥(NN V H (y : G))) : G) = (x : G) * n * (x : G)⁻¹
  rw [show ((CFSG.GroupTheory.conjAutOn (NN V H (y : G))
      (Subgroup.normalizer (NN V H (y : G) : Set G)) le_rfl
      ⟨(xc : G), Ksub_le_normalizer_NN hc (xOf_le_H hc.V_le_H y.2) hxc.2⟩ n :
        ↥(NN V H (y : G))) : G) = (xc : G) * n * (xc : G)⁻¹ from rfl]
  have hcomm := hc.wOf_isElemAbelian.comm hker (NN_le_wOf V H (y : G) n.2)
  rw [show (xc : G) = (x : G) * ((x : G)⁻¹ * (xc : G)) by group]
  rw [show (x : G) * ((x : G)⁻¹ * (xc : G)) * n * ((x : G) * ((x : G)⁻¹ * (xc : G)))⁻¹ =
      (x : G) * (((x : G)⁻¹ * (xc : G)) * n * ((x : G)⁻¹ * (xc : G))⁻¹) *
        (x : G)⁻¹ by group]
  rw [show ((x : G)⁻¹ * (xc : G)) * n * ((x : G)⁻¹ * (xc : G))⁻¹ = n by
    rw [hcomm]; group]

theorem upperElt_one_commutator_ne_one (F : Type) [Field F] [CharP F 2] :
    ⁅upperElt F 1, lowerElt F 1⁆ ≠ 1 := by
  intro h
  have h01 := congrArg (fun g : Matrix.SpecialLinearGroup (Fin 2) F =>
    ((g : Matrix (Fin 2) (Fin 2) F) 0 1)) h
  simp [commutatorElement_def, coe_upperElt, coe_lowerElt, Matrix.mul_apply,
    Fin.sum_univ_two, CharTwo.neg_eq] at h01
  have h2 : (1 : F) + 1 = 0 := CharTwo.add_self_eq_zero 1
  have h3 : (1 : F) + 1 + 1 = 1 := by rw [h2]; ring
  rw [h3] at h01
  exact one_ne_zero h01

private theorem exists_noncommuting {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    ∃ u ∈ V, ∃ w ∈ conjSubgroup (y : G) V, ⁅u, w⁆ ∉ wOf V H := by
  classical
  by_contra hcon
  push Not at hcon
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  let F := GaloisField 2 D.f
  have hcomm : ∀ a ∈ upperUnipotent F, ∀ b ∈ lowerUnipotent F, a * b = b * a := by
    intro a ha b hb
    have haVy : D.sigma a ∈ Vy V H := by
      rw [← D.map_upper]
      exact Subgroup.mem_map.mpr ⟨a, ha, rfl⟩
    let hex := Vy.exists_lift hc haVy
    let u : ↥V := Classical.choose hex
    have hu : (u : G) ∈ V := u.2
    have hua : xToXbar hc.V_le_H
        ⟨(u : G), le_xOf (V_mem_omegaOf V H) u.2⟩ = D.sigma a :=
      Classical.choose_spec hex
    have hb' : b ∈ (upperUnipotent F).map (MulAut.conj (weylElt F)).toMonoidHom := by
      rwa [← map_conj_weyl_upper (F := F)] at hb
    obtain ⟨a', ha', hba'⟩ := Subgroup.mem_map.mp hb'
    have ha'Vy : D.sigma a' ∈ Vy V H := by
      rw [← D.map_upper]
      exact Subgroup.mem_map.mpr ⟨a', ha', rfl⟩
    let hex' := Vy.exists_lift hc ha'Vy
    let u' : ↥V := Classical.choose hex'
    have hu' : (u' : G) ∈ V := u'.2
    have hua' : xToXbar hc.V_le_H
        ⟨(u' : G), le_xOf (V_mem_omegaOf V H) u'.2⟩ = D.sigma a' :=
      Classical.choose_spec hex' 
    let uX : ↥(xOf V H) := ⟨(u : G), le_xOf (V_mem_omegaOf V H) u.2⟩
    let u'X : ↥(xOf V H) := ⟨(u' : G), le_xOf (V_mem_omegaOf V H) u'.2⟩
    let wX : ↥(xOf V H) := y * u'X * y⁻¹
    have hwmem : (wX : G) ∈ conjSubgroup (y : G) V := by
      have h1 : (wX : G) = (y : G) * (u' : G) * (y : G)⁻¹ := rfl
      rw [h1, mem_conjSubgroup]
      have h2 : (y : G)⁻¹ * ((y : G) * (u' : G) * (y : G)⁻¹) * (y : G) = (u' : G) := by
        group
      rw [h2]
      exact u'.2
    have hwx : xToXbar hc.V_le_H wX = D.sigma b := by
      have hbw : b = weylElt F * a' * (weylElt F)⁻¹ := by
        rw [← hba']
        rfl
      calc xToXbar hc.V_le_H wX
          = xToXbar hc.V_le_H y * xToXbar hc.V_le_H u'X *
              (xToXbar hc.V_le_H y)⁻¹ := by
            simp only [wX, map_mul, map_inv]
        _ = D.sigma (weylElt F) * D.sigma a' * (D.sigma (weylElt F))⁻¹ := by
            rw [hy, hua']
        _ = D.sigma b := by
            rw [hbw, map_mul, map_mul, map_inv]
    have hncW : ⁅(u : G), (wX : G)⁆ ∈ wOf V H := hcon (u : G) hu (wX : G) hwmem
    have hncX : xToXbar hc.V_le_H ⁅uX, wX⁆ = 1 := by
      rw [map_commutatorElement]
      refine (cxw_xToXbar_eq_one hc.V_le_H ⁅uX, wX⁆).mpr ?_
      change ⁅(uX : G), (wX : G)⁆ ∈ wOf V H
      simpa [uX, wX] using hncW
    have hσ : ⁅D.sigma a, D.sigma b⁆ = 1 := by
      have h1 : xToXbar hc.V_le_H ⁅uX, wX⁆ = ⁅D.sigma a, D.sigma b⁆ := by
        rw [map_commutatorElement,
          show xToXbar hc.V_le_H uX = D.sigma a from hua, hwx]
      rw [← h1]
      exact hncX
    have hab : ⁅a, b⁆ = 1 := D.sigma_injective (by simpa using hσ)
    exact commutatorElement_eq_one_iff_mul_comm.mp hab
  have hU : upperElt F 1 ∈ upperUnipotent F :=
    (mem_upperUnipotent_iff F).2 ⟨1, rfl⟩
  have hL : lowerElt F 1 ∈ lowerUnipotent F :=
    (mem_lowerUnipotent_iff F).2 ⟨1, rfl⟩
  have hcomm1 : upperElt F 1 * lowerElt F 1 = lowerElt F 1 * upperElt F 1 :=
    hcomm _ hU _ hL
  exact upperElt_one_commutator_ne_one F
    (commutatorElement_eq_one_iff_mul_comm.mpr hcomm1)

private theorem mem_left_of_centralizes {A B Pz U : Subgroup G} {n : G}
    (hAB : ∀ a ∈ A, ∀ b ∈ B, a * b = b * a) (hBW : B ≤ wOf V H) (hn : n ∈ A ⊔ B)
    (hUn : ∀ u ∈ U, u * n = n * u) (hUA : ∀ u ∈ U, ∀ a ∈ A, u * a = a * u)
    (hCWU : wOf V H ⊓ Subgroup.centralizer (U : Set G) = Pz ⊓ wOf V H)
    (hdisj : (Pz ⊓ wOf V H) ⊓ B = ⊥) : n ∈ A := by
  obtain ⟨a, ha, b, hb, rfl⟩ := exists_mul_of_mem_sup hAB hn
  have hbcomm : ∀ u ∈ U, u * b = b * u := by
    intro u hu
    have h1 := hUn u hu
    have h3 : a * (u * b) = a * (b * u) := by
      calc a * (u * b) = (a * u) * b := by group
        _ = (u * a) * b := by rw [show a * u = u * a from (hUA u hu a ha).symm]
        _ = u * (a * b) := by group
        _ = (a * b) * u := h1
        _ = a * (b * u) := by group
    exact mul_left_cancel h3
  have hbW : b ∈ wOf V H := hBW hb
  have hbC : b ∈ Subgroup.centralizer (U : Set G) :=
    Subgroup.mem_centralizer_iff.mpr hbcomm
  have hbP : b ∈ Pz ⊓ wOf V H := by
    rw [← hCWU]
    exact ⟨hbW, hbC⟩
  have hbBot : b ∈ (⊥ : Subgroup G) := by
    have h : b ∈ (Pz ⊓ wOf V H) ⊓ B := ⟨hbP, hb⟩
    rwa [hdisj] at h
  have hb1 : b = 1 := Subgroup.mem_bot.mp hbBot
  rw [hb1, mul_one]
  exact ha

private theorem hCW_conj (hCW : wOf V H ⊓ Subgroup.centralizer (V : Set G) = P ⊓ wOf V H)
    {y : G} (hyH : y ∈ H) :
    wOf V H ⊓ Subgroup.centralizer ((conjSubgroup y V) : Set G) =
      conjSubgroup y P ⊓ wOf V H := by
  have hW : conjSubgroup y (wOf V H) = wOf V H :=
    mem_normalizer_iff_conjSubgroup_eq.mp (H_le_normalizer_wOf V H hyH)
  calc wOf V H ⊓ Subgroup.centralizer ((conjSubgroup y V) : Set G)
      = conjSubgroup y (wOf V H) ⊓
          conjSubgroup y (Subgroup.centralizer (V : Set G)) := by
        rw [hW, (centralizer_conjSubgroup_eq y V).symm]
    _ = conjSubgroup y (wOf V H ⊓ Subgroup.centralizer (V : Set G)) := by
        rw [conjSubgroup_inf]
    _ = conjSubgroup y (P ⊓ wOf V H) := by rw [hCW]
    _ = conjSubgroup y P ⊓ wOf V H := by rw [conjSubgroup_inf, hW]

private theorem exists_noncommuting_inv {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    ∃ u ∈ V, ∃ w ∈ conjSubgroup ((y : G)⁻¹) V, ⁅u, w⁆ ∉ wOf V H := by
  have hw0 : (weylElt (GaloisField 2 D.f))⁻¹ = weylElt (GaloisField 2 D.f) :=
    inv_eq_of_mul_eq_one_right weylElt_mul_self
  have hyinv : xToXbar h.setup.mc.toMinCex.V_le_H y⁻¹ =
      D.sigma (weylElt (GaloisField 2 D.f)) := by
    rw [map_inv, hy, ← map_inv, hw0]
  exact exists_noncommuting D (y := y⁻¹) hyinv

private theorem hdisj_conj (h : BigEndHyp M V Q P H) {y : ↥(xOf V H)}
    (hnc_inv : ∃ u ∈ V, ∃ w ∈ conjSubgroup ((y : G)⁻¹) V, ⁅u, w⁆ ∉ wOf V H) :
    (conjSubgroup (y : G) P ⊓ wOf V H) ⊓ (V ⊓ wOf V H) = ⊥ := by
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  have hdisj := (h.concl.1 (y⁻¹) ((xOf V H).inv_mem y.2) hnc_inv).2.2
  have hW : conjSubgroup (y : G) (wOf V H) = wOf V H :=
    mem_normalizer_iff_conjSubgroup_eq.mp
      (H_le_normalizer_wOf V H (xOf_le_H hc.V_le_H y.2))
  have hbot : conjSubgroup (y : G) (⊥ : Subgroup G) = ⊥ := by simp [conjSubgroup]
  have hconj := congrArg (fun S : Subgroup G => conjSubgroup (y : G) S) hdisj
  rw [hbot] at hconj
  simp only [conjSubgroup_inf, hW, conjSubgroup_conjSubgroup, mul_inv_cancel,
    conjSubgroup_one] at hconj
  simpa using hconj

@[instance_reducible] private noncomputable def commGroupNN (hc : MinCex M V Q P H) (y : G) :
    CommGroup ↥(NN V H y) :=
  { (inferInstance : Group ↥(NN V H y)) with
    mul_comm := fun a b => Subtype.ext
      (hc.wOf_isElemAbelian.comm (NN_le_wOf V H y a.2) (NN_le_wOf V H y b.2)) }

@[instance_reducible] private noncomputable def rhoAction {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    DistribMulAction (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f))
      (Additive ↥(NN V H (y : G))) :=
  @CFSG.RankThree.GF2n.Tim78.distribActionOfMulAut
    (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f))
    (↥(NN V H (y : G))) _ (commGroupNN h.setup.mc.toMinCex (y : G)) (rho D hy)

private theorem rhoAction_smul {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ) {y : ↥(xOf V H)}
    (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f)))
    (s : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f))
    (n : ↥(NN V H (y : G))) :
    letI := rhoAction D hy
    s • (Additive.ofMul n : Additive ↥(NN V H (y : G))) =
      Additive.ofMul (rho D hy s n) := rfl

private theorem hfix {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (hCW : wOf V H ⊓
      Subgroup.centralizer (V : Set G) = P ⊓ wOf V H) (D : SL2Setup h hZ)
    {y : ↥(xOf V H)} (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    letI := rhoAction D hy
    ∀ v : Additive ↥(NN V H (y : G)),
      (∀ x : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f), x • v = v) → v = 0 := by
  letI := rhoAction D hy
  intro v hv
  let F := GaloisField 2 D.f
  let hc : MinCex M V Q P H := h.setup.mc.toMinCex
  let n : ↥(NN V H (y : G)) := v.toMul
  have hVcent : ∀ u ∈ V, u * (n : G) = (n : G) * u := by
    intro u hu
    let vX : ↥(xOf V H) := ⟨(u : G), le_xOf (V_mem_omegaOf V H) hu⟩
    have hvVy : xToXbar hc.V_le_H vX ∈ (upperUnipotent F).map D.sigma := by
      rw [D.map_upper, ← map_V hc]
      exact Subgroup.mem_map.mpr ⟨vX, Subgroup.mem_subgroupOf.mpr hu, rfl⟩
    obtain ⟨a, ha, haσ⟩ := Subgroup.mem_map.mp hvVy
    have hv' : a • (Additive.ofMul n : Additive ↥(NN V H (y : G))) =
        Additive.ofMul n := by
      simpa [n] using hv a
    rw [rhoAction_smul D hy] at hv'
    have hrn : rho D hy a n = n := Additive.ofMul.injective hv'
    have hcoe := coe_rho D hy haσ.symm n
    calc u * n = (u * n * u⁻¹) * u := by group
      _ = (rho D hy a n : G) * u := by rw [← hcoe]
      _ = n * u := by rw [hrn]
  have hVycent : ∀ w ∈ conjSubgroup (y : G) V, w * (n : G) = (n : G) * w := by
    intro w hw
    have hwX : w ∈ xOf V H :=
      le_xOf (conjSubgroup_mem_omegaOf (xOf_le_H hc.V_le_H y.2)) hw
    let wX : ↥(xOf V H) := ⟨w, hwX⟩
    have hwVy : xToXbar hc.V_le_H wX ∈ (lowerUnipotent F).map D.sigma := by
      rw [D.map_lower]
      have hmem : xToXbar hc.V_le_H wX ∈
          ((conjSubgroup (y : G) V).subgroupOf (xOf V H)).map (xToXbar hc.V_le_H) :=
        Subgroup.mem_map.mpr ⟨wX, hw, rfl⟩
      rwa [map_Vy D hy] at hmem
    obtain ⟨b, hb, hbσ⟩ := Subgroup.mem_map.mp hwVy
    have hv' : b • (Additive.ofMul n : Additive ↥(NN V H (y : G))) =
        Additive.ofMul n := by
      simpa [n] using hv b
    rw [rhoAction_smul D hy] at hv'
    have hrn : rho D hy b n = n := Additive.ofMul.injective hv'
    have hcoe := coe_rho D hy hbσ.symm n
    calc w * n = (w * n * w⁻¹) * w := by group
      _ = (rho D hy b n : G) * w := by rw [← hcoe]
      _ = n * w := by rw [hrn]
  have hnc := exists_noncommuting D hy
  have hnA : (n : G) ∈ V ⊓ wOf V H := by
    refine mem_left_of_centralizes (A := V ⊓ wOf V H)
      (B := conjSubgroup (y : G) V ⊓ wOf V H) (Pz := P) (U := V) ?_ inf_le_right ?_
      hVcent ?_ hCW ?_
    · intro a ha b hb
      exact hc.wOf_isElemAbelian.comm (Subgroup.mem_inf.mp ha).2 (Subgroup.mem_inf.mp hb).2
    · change (n : G) ∈ (V ⊓ wOf V H) ⊔ (conjSubgroup (y : G) V ⊓ wOf V H)
      exact n.2
    · intro u hu a ha
      exact hc.elemAb.comm hu (Subgroup.mem_inf.mp ha).1
    · exact (h.concl.1 y y.2 hnc).2.2
  have hnB : (n : G) ∈ conjSubgroup (y : G) V ⊓ wOf V H := by
    refine mem_left_of_centralizes (A := conjSubgroup (y : G) V ⊓ wOf V H)
      (B := V ⊓ wOf V H) (Pz := conjSubgroup (y : G) P)
      (U := conjSubgroup (y : G) V) ?_ inf_le_right ?_ hVycent ?_
      (hCW_conj hCW (xOf_le_H hc.V_le_H y.2)) ?_
    · intro a ha b hb
      exact hc.wOf_isElemAbelian.comm (Subgroup.mem_inf.mp ha).2 (Subgroup.mem_inf.mp hb).2
    · change (n : G) ∈ (conjSubgroup (y : G) V ⊓ wOf V H) ⊔ (V ⊓ wOf V H)
      rw [sup_comm]
      exact n.2
    · intro u hu a ha
      exact (isElemAbelian_conjSubgroup hc.elemAb (y : G)).comm hu
        (Subgroup.mem_inf.mp ha).1
    · exact hdisj_conj h (exists_noncommuting_inv D hy)
  have hVne : conjSubgroup (y : G) V ≠ V := by
    intro hEq
    obtain ⟨u, hu, w, hw, hncw⟩ := hnc
    rw [hEq] at hw
    exact hncw (by
      rw [commutatorElement_eq_one_iff_mul_comm.mpr (hc.elemAb.comm hu hw)]
      exact (wOf V H).one_mem)
  have hVinf : V ⊓ conjSubgroup (y : G) V = ⊥ :=
    inf_conjSubgroup_eq_bot_of_isTI hc.ti hVne
  have hABinf : (V ⊓ wOf V H) ⊓ (conjSubgroup (y : G) V ⊓ wOf V H) = ⊥ := by
    refine le_bot_iff.mp ?_
    intro x hx
    exact hVinf.le ⟨(Subgroup.mem_inf.mp (Subgroup.mem_inf.mp hx).1).1,
      (Subgroup.mem_inf.mp (Subgroup.mem_inf.mp hx).2).1⟩
  have hn1 : (n : G) = 1 := by
    have hmem : (n : G) ∈ (V ⊓ wOf V H) ⊓ (conjSubgroup (y : G) V ⊓ wOf V H) :=
      ⟨hnA, hnB⟩
    rw [hABinf] at hmem
    exact Subgroup.mem_bot.mp hmem
  exact Additive.toMul.injective (Subtype.ext hn1)

private theorem hquad {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ)
    {y : ↥(xOf V H)} (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    letI := rhoAction D hy
    ∀ a ∈ upperUnipotent (GaloisField 2 D.f),
      ∀ a' ∈ upperUnipotent (GaloisField 2 D.f),
        ∀ v : Additive ↥(NN V H (y : G)), a' • (a • v - v) = a • v - v := by
  letI := rhoAction D hy
  intro a ha a' ha' v
  let F := GaloisField 2 D.f
  let hc : MinCex M V Q P H := h.setup.mc.toMinCex
  let n : ↥(NN V H (y : G)) := v.toMul
  have haVy : D.sigma a ∈ Vy V H := by
    rw [← D.map_upper]
    exact Subgroup.mem_map.mpr ⟨a, ha, rfl⟩
  let hex := Vy.exists_lift hc haVy
  let x : ↥V := Classical.choose hex
  have hxσ : xToXbar hc.V_le_H ⟨(x : G), le_xOf (V_mem_omegaOf V H) x.2⟩ =
      D.sigma a := Classical.choose_spec hex
  have ha'Vy : D.sigma a' ∈ Vy V H := by
    rw [← D.map_upper]
    exact Subgroup.mem_map.mpr ⟨a', ha', rfl⟩
  let hex' := Vy.exists_lift hc ha'Vy
  let x' : ↥V := Classical.choose hex'
  have hx'σ : xToXbar hc.V_le_H ⟨(x' : G), le_xOf (V_mem_omegaOf V H) x'.2⟩ =
      D.sigma a' := Classical.choose_spec hex'
  have hmem : ⁅(x : G), (n : G)⁆ ∈ V ⊓ wOf V H := by
    have hxV : (x : G) ∈ conjSubgroup (1 : G) V := by
      rw [conjSubgroup_one]
      exact x.2
    have hcomm := hc.commutator_mem_conj_inf_wOf (y := (1 : G)) H.one_mem hxV
      (NN_le_wOf V H (y : G) n.2)
    rwa [conjSubgroup_one] at hcomm
  have hx'comm : (x' : G) * ⁅(x : G), (n : G)⁆ = ⁅(x : G), (n : G)⁆ * (x' : G) :=
    hc.elemAb.comm x'.2 (Subgroup.mem_inf.mp hmem).1
  apply Additive.toMul.injective
  apply Subtype.ext
  have h1 : (((a • v - v).toMul : ↥(NN V H (y : G))) : G) = ⁅(x : G), (n : G)⁆ := by
    change (((rho D hy a n : ↥(NN V H (y : G))) / n : ↥(NN V H (y : G))) : G) =
      ⁅(x : G), (n : G)⁆
    rw [Subgroup.coe_div, coe_rho D hy hxσ n, commutatorElement_def, div_eq_mul_inv]
  have h2 : (((a' • (a • v - v)).toMul : ↥(NN V H (y : G))) : G) =
      (x' : G) * (((a • v - v).toMul : ↥(NN V H (y : G))) : G) * (x' : G)⁻¹ := by
    change (((rho D hy a' ((a • v - v).toMul) : ↥(NN V H (y : G))) : G)) =
      (x' : G) * (((a • v - v).toMul : ↥(NN V H (y : G))) : G) * (x' : G)⁻¹
    rw [coe_rho D hy hx'σ ((a • v - v).toMul)]
  rw [h2, h1, hx'comm]
  group

private theorem hw {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (D : SL2Setup h hZ)
    {y : ↥(xOf V H)} (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f)))
    (w : ↥(V ⊓ wOf V H)) :
    letI := rhoAction D hy
    ∀ a ∈ upperUnipotent (GaloisField 2 D.f),
      a • (Additive.ofMul (⟨(w : G), Subgroup.mem_sup_left w.2⟩ :
        ↥(NN V H (y : G)))) =
      (Additive.ofMul (⟨(w : G), Subgroup.mem_sup_left w.2⟩ :
        ↥(NN V H (y : G)))) := by
  letI := rhoAction D hy
  intro a ha
  let F := GaloisField 2 D.f
  let hc : MinCex M V Q P H := h.setup.mc.toMinCex
  let n : ↥(NN V H (y : G)) := ⟨(w : G), Subgroup.mem_sup_left w.2⟩
  have haVy : D.sigma a ∈ Vy V H := by
    rw [← D.map_upper]
    exact Subgroup.mem_map.mpr ⟨a, ha, rfl⟩
  let hex := Vy.exists_lift hc haVy
  let x : ↥V := Classical.choose hex
  have hxσ : xToXbar hc.V_le_H ⟨(x : G), le_xOf (V_mem_omegaOf V H) x.2⟩ =
      D.sigma a := Classical.choose_spec hex
  apply Additive.ofMul.injective
  apply Subtype.ext
  rw [rhoAction_smul D hy]
  change ((rho D hy a n : ↥(NN V H (y : G))) : G) = (n : G)
  rw [coe_rho D hy hxσ n]
  have hcomm : (x : G) * (w : G) = (w : G) * (x : G) :=
    hc.elemAb.comm x.2 (Subgroup.mem_inf.mp w.2).1
  rw [hcomm]
  group
  rfl

private theorem theta_exists {h : BigEndHyp M V Q P H}
    {hZ : Subgroup.center (Xbar V H) = ⊥} (hCW : wOf V H ⊓
      Subgroup.centralizer (V : Set G) = P ⊓ wOf V H) (D : SL2Setup h hZ)
    {y : ↥(xOf V H)} (hy : xToXbar h.setup.mc.toMinCex.V_le_H y =
      D.sigma (weylElt (GaloisField 2 D.f))) :
    ∃ θ : (Fin 2 → GaloisField 2 D.f) → G,
      (∀ u u', θ (u + u') = θ u * θ u') ∧
      Function.Injective θ ∧
      (∀ u, θ u ∈ wOf V H) ∧
      (∀ c, θ ![c, 0] ∈ V) ∧
      (∀ x ∈ V ⊓ wOf V H, ∃ c, θ ![c, 0] = x) ∧
      (∀ (x : ↥(xOf V H)) (s : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f)),
        xToXbar h.setup.mc.toMinCex.V_le_H x = D.sigma s →
        ∀ u, θ ((s : Matrix (Fin 2) (Fin 2) (GaloisField 2 D.f)) *ᵥ u) =
          (x : G) * θ u * (x : G)⁻¹) := by
  let hc : MinCex M V Q P H := h.setup.mc.toMinCex
  letI : CommGroup ↥(NN V H (y : G)) := commGroupNN hc (y : G)
  letI : DistribMulAction (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 D.f))
      (Additive ↥(NN V H (y : G))) := rhoAction D hy
  obtain ⟨⟨w, hwmem⟩, hw1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hc.V_inf_wOf_ne_bot
  let w' : ↥(V ⊓ wOf V H) := ⟨w, hwmem⟩
  let wN : ↥(NN V H (y : G)) := ⟨w, Subgroup.mem_sup_left hwmem⟩
  have hwN0 : Additive.ofMul wN ≠ 0 := by
    intro h0
    apply hw1
    apply Subtype.ext
    have h1 : (wN : G) = 1 := by
      have h := congrArg (fun x : ↥(NN V H (y : G)) => (x : G))
        (congrArg Additive.toMul h0)
      simpa using h
    simpa [wN] using h1
  have hwfix : ∀ a ∈ upperUnipotent (GaloisField 2 D.f),
      a • (Additive.ofMul wN) = Additive.ofMul wN :=
    hw D hy w'
  obtain ⟨θ₀, hinj, hrange, he, hθ⟩ :=
    @CFSG.Timmesfeld.ARS.exists_natural_of_quadratic
      (GaloisField 2 D.f) (Additive ↥(NN V H (y : G)))
      _ _ _ _ (rhoAction D hy) (hfix hCW D hy) (hquad D hy) (Additive.ofMul wN)
      hwfix hwN0
  let θ : (Fin 2 → (GaloisField 2 D.f)) → G := fun u => (((θ₀ u).toMul : ↥(NN V H (y : G))) : G)
  have hadd : ∀ u u', θ (u + u') = θ u * θ u' := by
    intro u u'
    show (((θ₀ (u + u')).toMul : ↥(NN V H (y : G))) : G) =
      (((θ₀ u).toMul : ↥(NN V H (y : G))) : G) *
        (((θ₀ u').toMul : ↥(NN V H (y : G))) : G)
    rw [map_add]
    rfl
  have hinjθ : Function.Injective θ := by
    intro u u' huv
    apply hinj
    apply Additive.toMul.injective
    apply Subtype.ext
    exact huv
  have hmemW : ∀ u, θ u ∈ wOf V H := fun u =>
    NN_le_wOf V H (y : G) (θ₀ u).toMul.2
  have hmemV : ∀ c : (GaloisField 2 D.f), θ ![c, 0] ∈ V := by
    intro c
    let nθ : ↥(NN V H (y : G)) := (θ₀ ![c, 0]).toMul
    have hfixA : ∀ a ∈ upperUnipotent (GaloisField 2 D.f),
        a • (Additive.ofMul nθ) = Additive.ofMul nθ := by
      intro a ha
      have h := hθ a ![c, 0]
      change a • θ₀ ![c, 0] = θ₀ ![c, 0]
      rw [← h]
      congr 1
      obtain ⟨t, rfl⟩ := (mem_upperUnipotent_iff (GaloisField 2 D.f)).mp ha
      rw [upperElt_mulVec]
      ext i
      fin_cases i <;> simp
    have hVcent : ∀ v ∈ V, v * (nθ : G) = (nθ : G) * v := by
      intro v hv
      let vX : ↥(xOf V H) := ⟨(v : G), le_xOf (V_mem_omegaOf V H) hv⟩
      have hvVy : xToXbar hc.V_le_H vX ∈ (upperUnipotent (GaloisField 2 D.f)).map D.sigma := by
        rw [D.map_upper, ← map_V hc]
        exact Subgroup.mem_map.mpr ⟨vX, Subgroup.mem_subgroupOf.mpr hv, rfl⟩
      obtain ⟨a, ha, haσ⟩ := Subgroup.mem_map.mp hvVy
      have hv' : a • (Additive.ofMul nθ) = Additive.ofMul nθ := hfixA a ha
      rw [rhoAction_smul D hy] at hv'
      have hrn : rho D hy a nθ = nθ := Additive.ofMul.injective hv'
      have hcoe := coe_rho D hy haσ.symm nθ
      calc v * nθ = (v * nθ * v⁻¹) * v := by group
        _ = (rho D hy a nθ : G) * v := by rw [← hcoe]
        _ = nθ * v := by rw [hrn]
    have hnc := exists_noncommuting D hy
    have hnA : (nθ : G) ∈ V ⊓ wOf V H := by
      refine mem_left_of_centralizes (A := V ⊓ wOf V H)
        (B := conjSubgroup (y : G) V ⊓ wOf V H) (Pz := P) (U := V) ?_ inf_le_right ?_
        hVcent ?_ hCW ?_
      · intro a ha b hb
        exact hc.wOf_isElemAbelian.comm (Subgroup.mem_inf.mp ha).2 (Subgroup.mem_inf.mp hb).2
      · change (nθ : G) ∈ (V ⊓ wOf V H) ⊔ (conjSubgroup (y : G) V ⊓ wOf V H)
        exact nθ.2
      · intro u hu a ha
        exact hc.elemAb.comm hu (Subgroup.mem_inf.mp ha).1
      · exact (h.concl.1 y y.2 hnc).2.2
    exact (Subgroup.mem_inf.mp hnA).1
  have hsurj : ∀ x ∈ V ⊓ wOf V H, ∃ c : (GaloisField 2 D.f), θ ![c, 0] = x := by
    let f : (GaloisField 2 D.f) → ↥(V ⊓ wOf V H) := fun c => ⟨θ ![c, 0], hmemV c, hmemW ![c, 0]⟩
    have hfinj : Function.Injective f := by
      intro c c' h
      have h1 : θ ![c, 0] = θ ![c', 0] := by
        simpa [f] using congrArg Subtype.val h
      have h2 : ![c, 0] = ![c', 0] := hinjθ h1
      have h3 := congrFun h2 0
      simpa using h3
    have hcard : Nat.card (GaloisField 2 D.f) = Nat.card ↥(V ⊓ wOf V H) := by
      rw [GaloisField.card 2 D.f (by have := D.hf; omega), D.h2f, ← h.module]
    have hbij : Function.Bijective f :=
      Nat.bijective_iff_injective_and_card f |>.mpr ⟨hfinj, hcard⟩
    intro x hx
    obtain ⟨c, hc⟩ := hbij.2 ⟨x, hx⟩
    exact ⟨c, congrArg Subtype.val hc⟩
  refine ⟨θ, hadd, hinjθ, hmemW, hmemV, hsurj, ?_⟩
  intro x s hx u
  have h1 : θ ((s : Matrix (Fin 2) (Fin 2) (GaloisField 2 D.f)) *ᵥ u) =
      ((rho D hy s (θ₀ u) : ↥(NN V H (y : G))) : G) := by
    show (((θ₀ ((s : Matrix (Fin 2) (Fin 2) (GaloisField 2 D.f)) *ᵥ u)).toMul :
      ↥(NN V H (y : G))) : G) = _
    rw [hθ]
    rfl
  rw [h1, coe_rho D hy hx (θ₀ u)]
  rfl

theorem BigEndHyp.exists_sl2_natural (h : BigEndHyp M V Q P H)
    (hZ : Subgroup.center (Xbar V H) = ⊥)
    (hCW : wOf V H ⊓ Subgroup.centralizer (V : Set G) = P ⊓ wOf V H) :
    ∃ (f n : ℕ) (k : Fin n) (Φ : ↥(StatedSp n (GaloisField 2 f)) ≃* Xbar V H)
      (g : ↥(StatedSp n (GaloisField 2 f)))
      (θ : (Fin 2 → GaloisField 2 f) → G),
      2 ≤ n ∧ 2 ≤ f ∧ 2 ^ f = qBar V H ∧
      (∃ T, CaseM.IsTransGroup
        (SpExtras.mat n (GaloisField 2 f) g *ᵥ
          Pi.single (Sum.inl k) (1 : GaloisField 2 f)) T ∧
        T.map Φ.toMonoidHom = Vy V H) ∧
      (∀ u u', θ (u + u') = θ u * θ u') ∧ Function.Injective θ ∧
      (∀ u, θ u ∈ wOf V H) ∧ (∀ c, θ ![c, 0] ∈ V) ∧
      (∀ x ∈ V ⊓ wOf V H, ∃ c, θ ![c, 0] = x) ∧
      ∀ (x : ↥(xOf V H))
        (s : Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)),
        xToXbar h.setup.mc.toMinCex.V_le_H x =
          Φ (g * longBlock (GaloisField 2 f) n k s * g⁻¹) →
        ∀ u, θ ((s : Matrix (Fin 2) (Fin 2) (GaloisField 2 f)) *ᵥ u) =
          (x : G) * θ u * (x : G)⁻¹ := by
  obtain ⟨f, n, hn, hf, h2f, Φ, g, hroot⟩ := h.exists_sp_data hZ
  let D : SL2Setup h hZ := ⟨f, n, hn, hf, h2f, Φ, g, hroot⟩
  let F := GaloisField 2 D.f
  let hc : MinCex M V Q P H := h.setup.mc.toMinCex
  obtain ⟨y, hy⟩ := xToXbar_surjective hc.V_le_H
    (D.sigma (weylElt (GaloisField 2 D.f)))
  obtain ⟨θ, hadd, hinj, hmemW, hmemV, hsurj, hequiv⟩ := theta_exists hCW D hy
  let T : Subgroup ↥(StatedSp D.n (GaloisField 2 D.f)) :=
    (upperUnipotent (GaloisField 2 D.f)).map
      ((MulAut.conj D.g).toMonoidHom.comp (longBlock (GaloisField 2 D.f) D.n D.k))
  refine ⟨D.f, D.n, D.k, D.Φ, D.g, θ, D.hn, D.hf, D.h2f, ⟨T, ?_, ?_⟩,
    hadd, hinj, hmemW, hmemV, hsurj, ?_⟩
  · exact CaseM.isTransGroup_upper_longBlock_conj (F := GaloisField 2 D.f) (n := D.n) D.k D.g
  · have h1 : T = conjSub ((upperUnipotent (GaloisField 2 D.f)).map
        (longBlock (GaloisField 2 D.f) D.n D.k)) D.g := by
      dsimp only [T]
      rw [← Subgroup.map_map]
    rw [h1]
    have h2 : (upperUnipotent (GaloisField 2 D.f)).map
        (longBlock (GaloisField 2 D.f) D.n D.k) =
        (Symplectic.rootDatum D.n (GaloisField 2 D.f)).rootGroup
          (Pi.single D.k (1 : ℤ)) :=
      (CaseM.rootGroup_last_eq_map_upper (F := GaloisField 2 D.f)
        (by have := D.hn; omega : 1 ≤ D.n)).symm
    rw [h2]
    simpa [SL2Setup.k] using D.hroot
  · intro x s hx u
    have hx' : xToXbar hc.V_le_H x = D.sigma s := by
      simpa [SL2Setup.sigma_apply] using hx
    exact hequiv x s hx' u

end CFSG.RankThree.GF2n.Tim79a
