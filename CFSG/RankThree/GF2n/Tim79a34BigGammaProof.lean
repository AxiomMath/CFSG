variable {G : Type} [Group G] {M V Q P H : Subgroup G} {n f : ℕ}
  {Φ : ↥(StatedSp n (GaloisField 2 f)) ≃* Xbar V H}
  {ψ : (Fin n ⊕ Fin n → GaloisField 2 f) ≃+ Additive ↥(wOf V H)}
  {a : Fin n ⊕ Fin n → GaloisField 2 f} {T : Subgroup ↥(StatedSp n (GaloisField 2 f))}

set_option hygiene false in
local notation "ψG " v:max => ((Additive.toMul (ψ v) : ↥(wOf V H)) : G)

theorem BigEndHyp.sup_inf_centralizer_eq [Finite G] (h : BigEndHyp M V Q P H)
    (hZ : Subgroup.center (Xbar V H) = ⊥) (hf : 2 ^ f = qBar V H)
    (hNat : BigNatCfg V H h.setup.mc.toMinCex.V_le_H Φ ψ) (ha : a ≠ 0)
    (hT : CaseM.IsTransGroup a T) (hTV : T.map Φ.toMonoidHom = Vy V H)
    (hWQ : ∀ w ∈ wOf V H, ∀ x ∈ Q, ⁅w, x⁆ ∈ P)
    (hQW : ∀ x ∈ Q, conjSubgroup x (wOf V H) = wOf V H) :
    P ⊔ (Q ⊓ Subgroup.centralizer (wOf V H : Set G)) = Q := by
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  obtain ⟨h₀, g₁, b₀, hgh, hb₀, hg₁⟩ := h.exists_gammaB_data ha
  obtain ⟨hBW, hBP, -, hBTI, hBne⟩ :=
    h.gammaB_spec hf hNat ha hT hTV hgh hb₀ hg₁
      (B := conjSubgroup (h₀ : G) V ⊓ wOf V H) rfl
  refine le_antisymm (sup_le hc.P_le_Q inf_le_left) ?_
  intro x hx
  obtain ⟨r, hr, hcomm⟩ :=
    h.exists_mem_P_commute_of_mem_Q hZ hBW hBP hBTI hBne hWQ hx
  have hyQ : r⁻¹ * x ∈ Q := Q.mul_mem (Q.inv_mem (hc.P_le_Q hr)) hx
  have hxW : conjSubgroup (r⁻¹ * x) (wOf V H) = wOf V H := hQW _ hyQ
  have hxA : ∀ u ∈ V ⊓ wOf V H, (r⁻¹ * x) * u = u * (r⁻¹ * x) :=
    fun u hu => h.commute_of_mem_Q_of_mem_inf hZ hyQ hu
  have hxP : ∀ u ∈ P ⊓ wOf V H, ⁅u, r⁻¹ * x⁆ ∈ V ⊓ wOf V H :=
    fun u hu => h.commutator_mem_inf_of_mem_P_inf_wOf hZ hQW hu hyQ
  have hyW : ∀ w ∈ wOf V H, (r⁻¹ * x) * w = w * (r⁻¹ * x) :=
    h.commute_wOf_of_commute_gammaB hf hNat ha hT hTV hgh hb₀ hg₁ hxW hxA hcomm hxP
  have hyC : r⁻¹ * x ∈ Q ⊓ Subgroup.centralizer (wOf V H : Set G) :=
    Subgroup.mem_inf.mpr ⟨hyQ, Subgroup.mem_centralizer_iff.mpr
      (fun w hw => (hyW w hw).symm)⟩
  have hx_eq : x = r * (r⁻¹ * x) := by group
  rw [hx_eq]
  exact Subgroup.mul_mem_sup hr hyC

private theorem BigEndHyp.inf_wOf_le_P_of_config [Finite G] (h : BigEndHyp M V Q P H)
    (hZ : Subgroup.center (Xbar V H) = ⊥) : Q ⊓ wOf V H ≤ P := by
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  obtain ⟨n, f, Φ, ψ, -, hf, hequiv, ⟨a, T, ha, hT, hTV⟩, hpoint⟩ :=
    bigNaturalStatement_holds G M V Q P H h hZ
  have hNat : BigNatCfg V H hc.V_le_H Φ ψ := ⟨hequiv, hpoint⟩
  have hWQ : ∀ w ∈ wOf V H, ∀ x ∈ Q, ⁅w, x⁆ ∈ P :=
    fun w hw x hx => h.commutator_mem_P_of_mem_wOf_of_mem_Q hZ hw hx
  have hQW : ∀ x ∈ Q, conjSubgroup x (wOf V H) = wOf V H :=
    fun x hx => h.conjSubgroup_wOf_eq_of_mem_Q hZ hWQ hx
  have hQX : ∀ x ∈ Q, conjSubgroup x (xOf V H) = xOf V H :=
    fun x hx => h.conjSubgroup_xOf_eq_of_mem_Q hZ hWQ hx
  have hQPC : P ⊔ (Q ⊓ Subgroup.centralizer (wOf V H : Set G)) = Q :=
    h.sup_inf_centralizer_eq hZ hf hNat ha hT hTV hWQ hQW
  have hcov : ∀ b ∈ wOf V H, b ∉ P → ∀ w ∈ P ⊓ wOf V H, ∃ p ∈ P, ⁅p, b⁆ = w :=
    fun b hbW hbP => h.exists_commutator_eq_of_not_mem_P hZ hbW hbP
  exact h.inf_wOf_le_P hZ hQW hQX hQPC hcov (h.not_le_normalizer_P_inf_wOf hZ)

theorem bigGammaStatement_holds : BigGammaStatement := by
  intro G _ _ M V Q P H h hZ
  have hc : MinCex M V Q P H := h.setup.mc.toMinCex
  obtain ⟨n, f, Φ, ψ, -, hf, hequiv, ⟨a, T, ha, hT, hTV⟩, hpoint⟩ :=
    bigNaturalStatement_holds G M V Q P H h hZ
  have hNat : BigNatCfg V H hc.V_le_H Φ ψ := ⟨hequiv, hpoint⟩
  have hWQ : ∀ w ∈ wOf V H, ∀ x ∈ Q, ⁅w, x⁆ ∈ P :=
    fun w hw x hx => h.commutator_mem_P_of_mem_wOf_of_mem_Q hZ hw hx
  have hQW : ∀ x ∈ Q, conjSubgroup x (wOf V H) = wOf V H :=
    fun x hx => h.conjSubgroup_wOf_eq_of_mem_Q hZ hWQ hx
  have hQX : ∀ x ∈ Q, conjSubgroup x (xOf V H) = xOf V H :=
    fun x hx => h.conjSubgroup_xOf_eq_of_mem_Q hZ hWQ hx
  let C : Subgroup G := Q ⊓ Subgroup.centralizer (wOf V H : Set G)
  have hCQ : C ≤ Q := inf_le_left
  have hQPC : P ⊔ C = Q :=
    h.sup_inf_centralizer_eq hZ hf hNat ha hT hTV hWQ hQW
  have hCW : ∀ c ∈ C, ∀ w ∈ wOf V H, c * w = w * c :=
    fun c hcC w hw => (Subgroup.mem_centralizer_iff.mp hcC.2 w hw).symm
  have hXC : ∀ c ∈ C, ∀ x ∈ xOf V H, ⁅x, c⁆ ∈ wOf V H :=
    fun c hcC x hx => h.commutator_mem_wOf_of_mem_centralizer hZ hQX hcC hx
  have hCWP : C ⊓ wOf V H ≤ P :=
    (le_inf (inf_le_left.trans hCQ) inf_le_right).trans (h.inf_wOf_le_P_of_config hZ)
  have hCX : ∀ z : G, (∀ x ∈ xOf V H, z * x = x * z) → z = 1 :=
    fun z hz => h.eq_one_of_forall_commute_xOf hZ hz
  have hirrW : ∀ S : Subgroup G, S ≤ wOf V H →
      (∀ x ∈ xOf V H, ∀ s ∈ S, x * s * x⁻¹ ∈ S) → S = ⊥ ∨ S = wOf V H :=
    fun S hSW hX => h.eq_bot_or_eq_wOf_of_xOf_invariant hZ hSW hX
  refine ⟨C, hCQ, hQPC, ?_, hCW, hXC, ?_, ?_⟩
  · intro p hp c hcC
    exact h.commutator_mem_inf_of_mem_P_of_mem_centralizer hZ hQW hQX hQPC
      (fun S hAS hSP hR => h.eq_or_eq_of_rootInvariant hZ hAS hSP hR)
      (h.not_le_normalizer_P_inf_wOf hZ) hp hcC
  · exact h.relIndex_le_qBar hZ hQPC hCW hXC
      (h.isElemAbelian_inf_centralizer hZ hQX) hCWP hCX hirrW
  · exact h.isElemAbelian_inf_centralizer hZ hQX

