variable {G : Type} [Group G] [Finite G] {M V : Subgroup G}

@[expose] def BadPair (a c : G) : Prop := ¬ (orderOf (a * c) ∣ 2 ∨ Odd (orderOf (a * c)))

abbrev ZU (U : Subgroup G) : Subgroup G := U ⊓ Subgroup.centralizer (U : Set G)

abbrev OmegaM (M V : Subgroup G) : Prop :=
  ∀ B ∈ omegaSet V, B ≤ M → B = V ∨ B ∈ sigmaSet M V

theorem classD_ne_one {t : G} (ht : t ∈ Tim78.classD V) : t ≠ 1 := by
  obtain ⟨g, b, -, hb1, rfl⟩ := ht
  intro h
  apply hb1
  calc b = g⁻¹ * (g * b * g⁻¹) * g := by group
    _ = g⁻¹ * 1 * g := by rw [h]
    _ = 1 := by group

theorem exists_omegaSet_of_mem_classD {f : G} (hf : f ∈ Tim78.classD V) :
    ∃ B ∈ omegaSet V, f ∈ B := by
  obtain ⟨g, b, hb, -, rfl⟩ := hf
  refine ⟨conjSubgroup g V, ?_, ?_⟩
  · exact Tim79a.conjSubgroup_mem_omegaOf (H := ⊤) (Subgroup.mem_top g)
  · rw [mem_conjSubgroup,
      show g⁻¹ * (g * b * g⁻¹) * g = b by group]
    exact hb

theorem mem_classD_of_mem {A : Subgroup G} (hA : A ∈ omegaSet V) {d : G} (hd : d ∈ A)
    (hd1 : d ≠ 1) : d ∈ Tim78.classD V := by
  obtain ⟨g, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA
  exact Tim78.mem_classD_of_mem_conjSubgroup hd hd1

theorem RootHyp.mul_self_of_mem (h : RootHyp M V) {A : Subgroup G} (hA : A ∈ omegaSet V)
    {d : G} (hd : d ∈ A) : d * d = 1 := by
  obtain ⟨g, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA
  exact Tim78.mul_self_of_mem_conj (fun v hv => by
    simpa [pow_two] using h.elem.2 v hv) hd

private theorem isElemAbelian_of_mem_omegaSet (h : RootHyp M V) {A : Subgroup G}
    (hA : A ∈ omegaSet V) : Assembly.IsElemAbelian 2 A := by
  obtain ⟨g, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA
  exact Tim78.isElemAbelian_conjSubgroup h.elem g

private theorem RootHyp.exists_omegaSet_le_M_of_mem (h : RootHyp M V) {d : G}
    (hd : d ∈ Tim78.classD V) (hdM : d ∈ M) :
    ∃ A ∈ omegaSet V, d ∈ A ∧ A ≤ M := by
  obtain ⟨A, hA, hdA⟩ := exists_omegaSet_of_mem_classD hd
  have hd1 : d ≠ 1 := classD_ne_one hd
  obtain ⟨g, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA
  refine ⟨conjSubgroup g V, Tim79a.conjSubgroup_mem_omegaOf (H := ⊤) (Subgroup.mem_top g),
    hdA, ?_⟩
  have hmem : d ∈ conjSubgroup g V ⊓ Subgroup.normalizer (conjSubgroup 1 V : Set G) := by
    refine ⟨hdA, ?_⟩
    rw [conjSubgroup_one, h.toHyp.normalizer_eq]
    exact hdM
  have hne : conjSubgroup g V ⊓ Subgroup.normalizer (conjSubgroup 1 V : Set G) ≠ ⊥ :=
    fun hbot => by
      rw [hbot, Subgroup.mem_bot] at hmem
      exact hd1 hmem
  have hcomm := Tim78.commute_of_isRootTypeTI h.rootType hne
  rw [conjSubgroup_one] at hcomm
  have hCen : conjSubgroup g V ≤ Subgroup.centralizer (V : Set G) := by
    intro y hy
    rw [Subgroup.mem_centralizer_iff]
    intro v hv
    exact (hcomm y hy v hv).symm
  exact hCen.trans (by
    rw [← h.toHyp.normalizer_eq]
    exact Subgroup.centralizer_le_normalizer (V : Set G))

theorem IsL2Gen.odd_orderOf_mul {A B : Subgroup G} (h : IsL2Gen A B) {a b : G}
    (ha : a ∈ A) (hb : b ∈ B) (ha1 : a ≠ 1) (hb1 : b ≠ 1) : Odd (orderOf (a * b)) := by
  obtain ⟨F, hField, hFin, hCharP, φ, -, hA, hB⟩ := h
  letI := hField
  letI := hFin
  letI := hCharP
  let ψ : ↥(A ⊔ B) →* SL(2, F) := φ.toMonoidHom
  have hψinj : Function.Injective ψ := fun x y hxy => φ.injective hxy
  let a' : ↥(A ⊔ B) := ⟨a, Subgroup.mem_sup_left ha⟩
  let b' : ↥(A ⊔ B) := ⟨b, Subgroup.mem_sup_right hb⟩
  have hψa : ψ a' ∈ utri F := by
    rw [← hA]
    exact Subgroup.mem_map.mpr ⟨a', Subgroup.mem_subgroupOf.mpr ha, rfl⟩
  have hψb : ψ b' ∈ ltri F := by
    rw [← hB]
    exact Subgroup.mem_map.mpr ⟨b', Subgroup.mem_subgroupOf.mpr hb, rfl⟩
  obtain ⟨s, hs⟩ := mem_utri_iff.mp hψa
  obtain ⟨t, ht⟩ := mem_ltri_iff.mp hψb
  have hs0 : s ≠ 0 := by
    intro h0
    apply ha1
    have h1 : ψ a' = 1 := by rw [hs, h0, utriElt_zero]
    have h2 : a' = 1 := hψinj (by simpa using h1)
    have h2' : (a' : G) = 1 := congrArg Subtype.val h2
    simpa [a'] using h2'
  have ht0 : t ≠ 0 := by
    intro h0
    apply hb1
    have h1 : ψ b' = 1 := by rw [ht, h0, ltriElt_zero]
    have h2 : b' = 1 := hψinj (by simpa using h1)
    have h2' : (b' : G) = 1 := congrArg Subtype.val h2
    simpa [b'] using h2'
  have htr : ((ψ (a' * b') : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) 0 0 +
      ((ψ (a' * b') : SL(2, F)) : Matrix (Fin 2) (Fin 2) F) 1 1 ≠ 0 := by
    rw [map_mul, hs, ht]
    sl2_simp
    simp only [one_mul, mul_one, mul_zero, zero_mul, zero_add, add_zero]
    rw [show (1 + s * t) + 1 = s * t by
      rw [add_assoc, add_comm (s * t) (1 : F), ← add_assoc,
        CharTwo.add_self_eq_zero, zero_add]]
    exact mul_ne_zero hs0 ht0
  have hodd : Odd (orderOf (ψ (a' * b'))) :=
    CFSG.RankThree.PartTwo.Sec14.Item148Res8.odd_orderOf_of_trace_ne_zero htr
  have hord : orderOf (ψ (a' * b')) = orderOf (a' * b') :=
    orderOf_injective ψ hψinj (a' * b')
  have hcoe : orderOf (a * b) = orderOf (a' * b') := Subgroup.orderOf_coe (a' * b')
  rw [hord] at hodd
  rw [← hcoe] at hodd
  exact hodd

theorem RootHyp.commute_of_commute_mem (h : RootHyp M V) {A C : Subgroup G}
    (hA : A ∈ omegaSet V) (hC : C ∈ omegaSet V) {a c : G} (ha : a ∈ A) (hc : c ∈ C)
    (ha1 : a ≠ 1) (hc1 : c ≠ 1) (hac : Commute a c) :
    ∀ x ∈ A, ∀ y ∈ C, Commute x y := by
  obtain ⟨g, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA
  obtain ⟨h', -, rfl⟩ := Tim79a.mem_omegaOf.mp hC
  have hTI := h.rootType.1
  have hac' : a⁻¹ * c * a = c := by
    calc a⁻¹ * c * a = a⁻¹ * (c * a) := by group
      _ = a⁻¹ * (a * c) := by rw [← hac.eq]
      _ = c := by group
  have hmem1 : c ∈ conjSubgroup (a * h') V := by
    rw [mem_conjSubgroup,
      show (a * h')⁻¹ * c * (a * h') = h'⁻¹ * (a⁻¹ * c * a) * h' by group, hac']
    exact mem_conjSubgroup.mp hc
  have hmem : c ∈ conjSubgroup (a * h') V ⊓ conjSubgroup h' V := ⟨hmem1, hc⟩
  have hne : conjSubgroup (a * h') V ⊓ conjSubgroup h' V ≠ ⊥ := fun hbot => by
    rw [hbot, Subgroup.mem_bot] at hmem
    exact hc1 hmem
  have heq : conjSubgroup (a * h') V = conjSubgroup h' V :=
    Tim78.conjSubgroup_eq_of_inf_ne_bot hTI hne
  have hanorm : a ∈ Subgroup.normalizer (conjSubgroup h' V : Set G) := by
    rw [← conjSubgroup_eq_self_iff]
    rw [CGT.Timmesfeld75.conjSubgroup_conjSubgroup, heq]
  have haN : a ∈ conjSubgroup g V ⊓ Subgroup.normalizer (conjSubgroup h' V : Set G) :=
    ⟨ha, hanorm⟩
  have hne2 : conjSubgroup g V ⊓ Subgroup.normalizer (conjSubgroup h' V : Set G) ≠ ⊥ :=
    fun hbot => by
      rw [hbot, Subgroup.mem_bot] at haN
      exact ha1 haN
  exact fun x hx y hy => Tim78.commute_of_isRootTypeTI h.rootType hne2 x hx y hy

theorem Sec6Hyp.commute_or_odd (hS : Sec6Hyp M V) (h64 : OmegaM M V) {A C : Subgroup G}
    (hA : A ∈ omegaSet V) (hC : C ∈ omegaSet V) (hAM : A ≤ M) (hCM : C ≤ M)
    {a c : G} (ha : a ∈ A) (hc : c ∈ C) : Commute a c ∨ Odd (orderOf (a * c)) := by
  by_cases ha1 : a = 1
  · exact Or.inl (by rw [ha1]; exact Commute.one_left c)
  by_cases hc1 : c = 1
  · exact Or.inl (by rw [hc1]; exact Commute.one_right a)
  rcases h64 A hA hAM with hAV | hAsig
  · rcases h64 C hC hCM with hCV | hCsig
    · subst hAV; subst hCV
      have hEl := isElemAbelian_of_mem_omegaSet hS.sec5.toRootHyp hA
      exact Or.inl ((Subgroup.commute_subtype_iff _ _).mpr
        (hEl.1.is_comm.comm ⟨a, ha⟩ ⟨c, hc⟩))
    · subst hAV
      have hCcent := (hS.sec5.le_M_of_mem_sigmaSet hCsig).2
      exact Or.inl (Subgroup.mem_centralizer_iff.mp (hCcent hc) a ha)
  · rcases h64 C hC hCM with hCV | hCsig
    · subst hCV
      have hAcent := (hS.sec5.le_M_of_mem_sigmaSet hAsig).2
      exact Or.inl ((Subgroup.mem_centralizer_iff.mp (hAcent ha) c hc).symm)
    · by_cases hAC : A = C
      · subst hAC
        have hEl := isElemAbelian_of_mem_omegaSet hS.sec5.toRootHyp hA
        exact Or.inl ((Subgroup.commute_subtype_iff _ _).mpr
          (hEl.1.is_comm.comm ⟨a, ha⟩ ⟨c, hc⟩))
      · rcases hS.res.s513 M V hS.sec5 A hAsig C hCsig with ⟨hbot, -⟩ | ⟨hL2, -⟩
        · exact Or.inl ((Subgroup.mem_centralizer_iff.mp
            ((Subgroup.commutator_eq_bot_iff_le_centralizer).mp hbot ha) c hc).symm)
        · exact Or.inr (hL2.odd_orderOf_mul ha hc ha1 hc1)

theorem Sec6Hyp.commute_of_pow_two_pow (hS : Sec6Hyp M V) (h64 : OmegaM M V) {d e : G}
    (hd : d ∈ Tim78.classD V) (he : e ∈ Tim78.classD V) {k : ℕ}
    (hk : (d * e) ^ 2 ^ k = 1) : Commute d e := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hd2 : d * d = 1 := by
    obtain ⟨A, hA, hdA⟩ := exists_omegaSet_of_mem_classD hd
    exact hS.sec5.toRootHyp.mul_self_of_mem hA hdA
  have he2 : e * e = 1 := by
    obtain ⟨C, hC, heC⟩ := exists_omegaSet_of_mem_classD he
    exact hS.sec5.toRootHyp.mul_self_of_mem hC heC
  have hP : IsPGroup 2 (Subgroup.closure ({d, e} : Set G)) :=
    isPGroup_two_closure_pair hd2 he2 hk
  obtain ⟨S, hSle⟩ := hP.exists_le_sylow
  let SM : Sylow 2 M := default
  obtain ⟨T, hT⟩ := hS.sec5.toRootHyp.toHyp.isSylow_of_sylow_M SM
  obtain ⟨x, hx⟩ := MulAction.exists_smul_eq G S T
  let d' : G := x * d * x⁻¹
  let e' : G := x * e * x⁻¹
  have hdS : d ∈ (S : Subgroup G) := hSle (Subgroup.subset_closure (by simp))
  have heS : e ∈ (S : Subgroup G) := hSle (Subgroup.subset_closure (by simp))
  have hd'coe : d' ∈ (T : Subgroup G) := by
    have hcoe : ((x • S : Sylow 2 G) : Subgroup G) = T := congrArg _ hx
    rw [← hcoe]
    rw [Sylow.coe_subgroup_smul]
    exact Set.mem_smul_set.mpr ⟨d, hdS, rfl⟩
  have he'coe : e' ∈ (T : Subgroup G) := by
    have hcoe : ((x • S : Sylow 2 G) : Subgroup G) = T := congrArg _ hx
    rw [← hcoe]
    rw [Sylow.coe_subgroup_smul]
    exact Set.mem_smul_set.mpr ⟨e, heS, rfl⟩
  have hd'm : d' ∈ M := by
    rw [hT] at hd'coe
    obtain ⟨y, -, hy⟩ := Subgroup.mem_map.mp hd'coe
    rw [← hy]
    exact y.2
  have he'm : e' ∈ M := by
    rw [hT] at he'coe
    obtain ⟨y, -, hy⟩ := Subgroup.mem_map.mp he'coe
    rw [← hy]
    exact y.2
  have hd'D : d' ∈ Tim78.classD V := by
    simpa [d'] using Tim78.mem_classD_conj hd x
  have he'D : e' ∈ Tim78.classD V := by
    simpa [e'] using Tim78.mem_classD_conj he x
  obtain ⟨A, hA, hd'A, hAM⟩ := hS.sec5.toRootHyp.exists_omegaSet_le_M_of_mem hd'D hd'm
  obtain ⟨C, hC, he'C, hCM⟩ := hS.sec5.toRootHyp.exists_omegaSet_le_M_of_mem he'D he'm
  rcases hS.commute_or_odd h64 hA hC hAM hCM hd'A he'C with hcomm | hodd
  · have h1 : x⁻¹ * d' * x = d := by
      show x⁻¹ * (x * d * x⁻¹) * x = d
      group
    have h2 : x⁻¹ * e' * x = e := by
      show x⁻¹ * (x * e * x⁻¹) * x = e
      group
    have hconj : Commute (x⁻¹ * d' * x) (x⁻¹ * e' * x) := by
      simpa using (Commute.conj_iff x⁻¹).mpr hcomm
    rwa [h1, h2] at hconj
  · have horder : orderOf (d * e) = orderOf (d' * e') := by
      have hsem : SemiconjBy x (d * e) (d' * e') := by
        show x * (d * e) = (d' * e') * x
        simp only [d', e']
        group
      exact SemiconjBy.orderOf_eq x hsem
    have hodd' : Odd (orderOf (d * e)) := by rw [horder]; exact hodd
    have hdvd : orderOf (d * e) ∣ 2 ^ k := orderOf_dvd_iff_pow_eq_one.mpr hk
    have hcop : Nat.Coprime (orderOf (d * e)) (2 ^ k) := hodd'.coprime_two_right.pow_right k
    have hone : orderOf (d * e) = 1 := Nat.eq_one_of_dvd_coprimes hcop dvd_rfl hdvd
    have hde1 : d * e = 1 := orderOf_eq_one_iff.mp hone
    have heq : e = d := by
      have h1 : e = d⁻¹ := eq_inv_of_mul_eq_one_right hde1
      rw [inv_eq_of_mul_eq_one_right hd2] at h1
      exact h1
    subst heq
    exact Commute.refl _

theorem Sec6Hyp.exists_odd_of_bad (hS : Sec6Hyp M V) (h64 : OmegaM M V) {d e : G}
    (hd : d ∈ Tim78.classD V) (he : e ∈ Tim78.classD V) (hb : BadPair d e) :
    ∃ r : ℕ, Odd r ∧ 3 ≤ r ∧ orderOf (d * e) = 2 * r := by
  have hd2 : d * d = 1 := by
    obtain ⟨A, hA, hdA⟩ := exists_omegaSet_of_mem_classD hd
    exact hS.sec5.toRootHyp.mul_self_of_mem hA hdA
  have he2 : e * e = 1 := by
    obtain ⟨C, hC, heC⟩ := exists_omegaSet_of_mem_classD he
    exact hS.sec5.toRootHyp.mul_self_of_mem hC heC
  have hne : orderOf (d * e) ≠ 0 := (orderOf_pos (d * e)).ne'
  obtain ⟨k, m, hm, hnm⟩ := Nat.exists_eq_two_pow_mul_odd hne
  have hk0 : k ≠ 0 := by
    intro hk0
    rw [hk0, pow_zero, one_mul] at hnm
    exact hb (Or.inr (by rw [hnm]; exact hm))
  have hk1 : k ≤ 1 := by
    obtain ⟨j, rfl⟩ := hm
    let d' : G := (((d * e) ^ j)⁻¹ * e * (d * e) ^ j)
    have hd'D : d' ∈ Tim78.classD V := by
      simpa [d'] using Tim78.mem_classD_conj he (((d * e) ^ j)⁻¹)
    have hd'd : d * d' = (d * e) ^ (2 * j + 1) := by
      simpa [d'] using dihedral_mul_conj_inv_pow' hd2 he2 j
    have hd'2 : d' * d' = 1 := by
      calc d' * d' = ((d * e) ^ j)⁻¹ * (e * e) * ((d * e) ^ j) := by
            simp only [d']
            group
        _ = 1 := by rw [he2]; group
    have hpow : (d * d') ^ 2 ^ k = 1 := by
      rw [hd'd, ← pow_mul, mul_comm (2 * j + 1) (2 ^ k), ← hnm]
      exact pow_orderOf_eq_one _
    have hcomm : Commute d d' := hS.commute_of_pow_two_pow h64 hd hd'D hpow
    have hcomm2 : (d * d') ^ 2 = 1 :=
      (commute_iff_mul_sq_eq_one hd2 hd'2).mp hcomm
    have hr0 : (d * e) ^ (2 * (2 * j + 1)) = 1 := by
      have h2 := hcomm2
      rw [hd'd] at h2
      rwa [pow_two, ← pow_add,
        show 2 * j + 1 + (2 * j + 1) = 2 * (2 * j + 1) by ring] at h2
    have hdvd : orderOf (d * e) ∣ 2 * (2 * j + 1) :=
      orderOf_dvd_iff_pow_eq_one.mpr hr0
    have hdvd' : 2 ^ k * (2 * j + 1) ∣ 2 * (2 * j + 1) := by
      rwa [hnm] at hdvd
    have h2k : 2 ^ k ∣ 2 :=
      Nat.dvd_of_mul_dvd_mul_right (by omega : 0 < 2 * j + 1) hdvd'
    exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp
      (Nat.le_of_dvd (by norm_num) h2k)
  have hk1' : k = 1 := by omega
  have hmne1 : m ≠ 1 := by
    intro hm1
    have hn2 : orderOf (d * e) = 2 := by
      rw [hk1', pow_one] at hnm
      rw [hm1, mul_one] at hnm
      exact hnm
    exact hb (Or.inl (by simpa [hn2]))
  have hm3 : 3 ≤ m := by
    obtain ⟨j, rfl⟩ := hm
    omega
  refine ⟨m, hm, hm3, ?_⟩
  rw [hk1', pow_one] at hnm
  exact hnm

private theorem RootHyp.commute_pow_of_mem_left (h : RootHyp M V) {d e : G}
    (hd : d ∈ Tim78.classD V) (he : e ∈ Tim78.classD V) {r : ℕ} (hr : Odd r)
    (ho : orderOf (d * e) = 2 * r) {A : Subgroup G} (hA : A ∈ omegaSet V) (hdA : d ∈ A) :
    ∀ x ∈ A, Commute x ((d * e) ^ r) := by
  have hd2 : d * d = 1 := h.mul_self_of_mem hA hdA
  have he2 : e * e = 1 := by
    obtain ⟨C, hC, heC⟩ := exists_omegaSet_of_mem_classD he
    exact h.mul_self_of_mem hC heC
  have hd1 : d ≠ 1 := classD_ne_one hd
  have hk : (d * e) ^ (2 * r) = 1 := by rw [← ho]; exact pow_orderOf_eq_one _
  have hcenter := dihedral_center_comm hd2 he2 (k := r) hk
  obtain ⟨j, rfl⟩ := hr
  let z : G := (d * e) ^ (2 * j + 1)
  have hz_eq : z = d * (((d * e) ^ j)⁻¹ * e * (d * e) ^ j) :=
    (dihedral_mul_conj_inv_pow' hd2 he2 j).symm
  have hdz_eq : d * z = ((d * e) ^ j)⁻¹ * e * (d * e) ^ j := by
    rw [hz_eq, ← mul_assoc, hd2, one_mul]
  have hdzD : d * z ∈ Tim78.classD V := by
    rw [hdz_eq]
    simpa using Tim78.mem_classD_conj he (((d * e) ^ j)⁻¹)
  obtain ⟨B, hB, hdzB⟩ := exists_omegaSet_of_mem_classD hdzD
  have hdz1 : d * z ≠ 1 := classD_ne_one hdzD
  have hcomm_dz : Commute d (d * z) := (Commute.refl d).mul_right hcenter.1
  have hcommAll := h.commute_of_commute_mem hA hB hdA hdzB hd1 hdz1 hcomm_dz
  have hcommAd : ∀ x ∈ A, Commute x d := fun x hx =>
    h.commute_of_commute_mem hA hA hdA hdA hd1 hd1 (Commute.refl d) x hx d hdA
  intro x hx
  have hxd : Commute x d := hcommAd x hx
  have hxdz : Commute x (d * z) := hcommAll x hx (d * z) hdzB
  have hxz : Commute x z := by
    have hz : z = d * (d * z) := by
      rw [← mul_assoc, hd2, one_mul]
    rw [hz]
    exact hxd.mul_right hxdz
  exact hxz

theorem RootHyp.commute_pow_of_orderOf (h : RootHyp M V) {d e : G}
    (hd : d ∈ Tim78.classD V) (he : e ∈ Tim78.classD V) {r : ℕ} (hr : Odd r)
    (ho : orderOf (d * e) = 2 * r) {A : Subgroup G} (hA : A ∈ omegaSet V)
    (hdA : d ∈ A ∨ e ∈ A) : ∀ x ∈ A, Commute x ((d * e) ^ r) := by
  rcases hdA with hdA | heA
  · exact h.commute_pow_of_mem_left hd he hr ho hA hdA
  · have ho' : orderOf (e * d) = 2 * r := by
      have horder : orderOf (e * d) = orderOf (d * e) := by
        have hsem : SemiconjBy d (e * d) (d * e) := by
          show d * (e * d) = (d * e) * d
          group
        exact SemiconjBy.orderOf_eq d hsem
      rw [horder, ho]
    have hd2 : d * d = 1 := by
      obtain ⟨B, hB, hdB⟩ := exists_omegaSet_of_mem_classD hd
      exact h.mul_self_of_mem hB hdB
    have he2 : e * e = 1 := h.mul_self_of_mem hA heA
    have hk : (d * e) ^ (2 * r) = 1 := by rw [← ho]; exact pow_orderOf_eq_one _
    have hcenter := dihedral_center_comm hd2 he2 (k := r) hk
    have hz : (e * d) ^ r = (d * e) ^ r := by
      calc (e * d) ^ r = (d * (d * e) * d⁻¹) ^ r := by
            rw [show d * (d * e) * d⁻¹ = e * d by
              rw [← mul_assoc, hd2, one_mul, inv_eq_of_mul_eq_one_right hd2]]
        _ = d * (d * e) ^ r * d⁻¹ := conj_pow
        _ = (d * e) ^ r := by rw [hcenter.1]; group
    have hcomm := h.commute_pow_of_mem_left he hd hr ho' hA heA
    intro x hx
    rw [← hz]
    exact hcomm x hx

theorem Sec6Hyp.not_bad_of_common (hS : Sec6Hyp M V) (h64 : OmegaM M V) {A C A₀ : Subgroup G}
    (hA : A ∈ omegaSet V) (hC : C ∈ omegaSet V) (hA₀ : A₀ ∈ omegaSet V)
    (hAA₀ : ∀ x ∈ A₀, ∀ y ∈ A, Commute x y)
    (hCA₀ : ∀ x ∈ A₀, ∀ y ∈ C, Commute x y)
    {a c : G} (ha : a ∈ A) (hc : c ∈ C) : ¬ BadPair a c := by
  obtain ⟨g, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA₀
  let a' : G := g⁻¹ * a * g
  let c' : G := g⁻¹ * c * g
  have ha' : a' ∈ conjSubgroup g⁻¹ A := by
    have h : MulAut.conj g⁻¹ a ∈ conjSubgroup g⁻¹ A :=
      Subgroup.mem_map.mpr ⟨a, ha, rfl⟩
    simpa [a', MulAut.conj_apply] using h
  have hc' : c' ∈ conjSubgroup g⁻¹ C := by
    have h : MulAut.conj g⁻¹ c ∈ conjSubgroup g⁻¹ C :=
      Subgroup.mem_map.mpr ⟨c, hc, rfl⟩
    simpa [c', MulAut.conj_apply] using h
  have hA' : conjSubgroup g⁻¹ A ∈ omegaSet V := by
    obtain ⟨k, -, rfl⟩ := Tim79a.mem_omegaOf.mp hA
    rw [CGT.Timmesfeld75.conjSubgroup_conjSubgroup]
    exact Tim79a.conjSubgroup_mem_omegaOf (H := ⊤) (Subgroup.mem_top (g⁻¹ * k))
  have hC' : conjSubgroup g⁻¹ C ∈ omegaSet V := by
    obtain ⟨k, -, rfl⟩ := Tim79a.mem_omegaOf.mp hC
    rw [CGT.Timmesfeld75.conjSubgroup_conjSubgroup]
    exact Tim79a.conjSubgroup_mem_omegaOf (H := ⊤) (Subgroup.mem_top (g⁻¹ * k))
  have hMof : ∀ {X : Subgroup G},
      (∀ x ∈ conjSubgroup g V, ∀ y ∈ X, Commute x y) → conjSubgroup g⁻¹ X ≤ M := by
    intro X hXcomm
    have hCen : conjSubgroup g⁻¹ X ≤ Subgroup.centralizer (V : Set G) := by
      intro y hy
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      have hyX : g * y * g⁻¹ ∈ X := by
        simpa using mem_conjSubgroup.mp hy
      have hvA : g * v * g⁻¹ ∈ conjSubgroup g V := by
        rw [mem_conjSubgroup]
        rw [show g⁻¹ * (g * v * g⁻¹) * g = v by group]
        exact hv
      have hconj := (hXcomm (g * v * g⁻¹) hvA (g * y * g⁻¹) hyX).conj g⁻¹
      rw [show g⁻¹ * (g * v * g⁻¹) * g⁻¹⁻¹ = v by group,
        show g⁻¹ * (g * y * g⁻¹) * g⁻¹⁻¹ = y by group] at hconj
      exact hconj
    exact hCen.trans (by
      rw [← hS.sec5.toRootHyp.toHyp.normalizer_eq]
      exact Subgroup.centralizer_le_normalizer (V : Set G))
  have hA'M : conjSubgroup g⁻¹ A ≤ M := hMof hAA₀
  have hC'M : conjSubgroup g⁻¹ C ≤ M := hMof hCA₀
  have horder : orderOf (a * c) = orderOf (a' * c') := by
    have hsem : SemiconjBy g⁻¹ (a * c) (a' * c') := by
      show g⁻¹ * (a * c) = (a' * c') * g⁻¹
      simp only [a', c']
      group
    exact SemiconjBy.orderOf_eq g⁻¹ hsem
  rcases hS.commute_or_odd h64 hA' hC' hA'M hC'M ha' hc' with hcomm | hodd
  · intro hb
    exact hb (Or.inl (by
      have hcommAC : Commute a c := by
        have h := hcomm.conj g
        rw [show g * (g⁻¹ * a * g) * g⁻¹ = a by group,
          show g * (g⁻¹ * c * g) * g⁻¹ = c by group] at h
        exact h
      have ha2 : a * a = 1 := hS.sec5.toRootHyp.mul_self_of_mem hA ha
      have hc2 : c * c = 1 := hS.sec5.toRootHyp.mul_self_of_mem hC hc
      have h2 : (a * c) ^ 2 = 1 := by
        rw [pow_two]
        calc (a * c) * (a * c) = (c * a) * (a * c) := by rw [hcommAC.eq]
          _ = c * (a * a) * c := by group
          _ = c * 1 * c := by rw [ha2]
          _ = c * c := by rw [mul_one]
          _ = 1 := hc2
      exact orderOf_dvd_iff_pow_eq_one.mpr h2))
  · intro hb
    exact hb (Or.inr (by rwa [horder]))

end CFSG.RankThree.GF2n.Tim81
