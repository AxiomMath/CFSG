private theorem suMat_conj_mulVec_sub {F : Type} [Field F] {σ : F ≃+* F} {N : ℕ}
    (g w : SU σ N) (x : Fin N → F) :
    suMat σ N (g * w * g⁻¹) *ᵥ x - x =
      suMat σ N g *ᵥ (suMat σ N w *ᵥ (suMat σ N g⁻¹ *ᵥ x) -
        suMat σ N g⁻¹ *ᵥ x) := by
  let y : Fin N → F := suMat σ N g⁻¹ *ᵥ x
  have hx : suMat σ N g *ᵥ y = x := ModelRank.suMat_mulVec_suMat_inv_mulVec g x
  calc suMat σ N (g * w * g⁻¹) *ᵥ x - x
      = suMat σ N g *ᵥ (suMat σ N w *ᵥ y) - suMat σ N g *ᵥ y := by
        rw [map_mul, map_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← hx,
          ModelRank.suMat_inv_mulVec_suMat_mulVec]
    _ = suMat σ N g *ᵥ (suMat σ N w *ᵥ (suMat σ N g⁻¹ *ᵥ x) -
          suMat σ N g⁻¹ *ᵥ x) := by
        rw [← Matrix.mulVec_sub]

private theorem isUTransGroup_pow_two_eq_one {F : Type} [Field F] [CharP F 2]
    {σ : F ≃+* F} {N : ℕ} {v : Fin N → F} (hvv : uForm σ v v = 0)
    {T : Subgroup (SU σ N)} (hT : IsUTransGroup σ v T) {t : SU σ N} (ht : t ∈ T) :
    t ^ 2 = 1 := by
  rw [pow_two]
  obtain ⟨c, -, htc⟩ := (hT.1 t).1 ht
  apply suMat_injective σ
  rw [map_mul, htc, uTrans_mul_uTrans σ hvv, CharTwo.add_self_eq_zero, uTrans_zero, map_one]

private theorem exists_involution_lift_subgroup {F : Type} [Field F] [Finite F] [CharP F 2]
    {σ : F ≃+* F} {N : ℕ} {K : Type} [Group K] {X₀ : Subgroup K}
    {Φ : SU σ N →* K} (hker : Φ.ker ≤ Subgroup.center (SU σ N))
    (hrange : Φ.range = X₀) {W : Subgroup K} (hW2 : IsPGroup 2 W)
    (hsqW : ∀ x ∈ W, x * x = 1) (hWX : W ≤ X₀) :
    ∃ Ŵ : Subgroup (SU σ N), Ŵ.map Φ = W ∧ IsPGroup 2 Ŵ ∧
      Function.Injective (Φ.comp Ŵ.subtype) ∧ ∀ x ∈ Ŵ, x * x = 1 := by
  haveI : Finite (SU σ N) :=
    Finite.of_injective (SUExtras.mat σ N) (SUExtras.mat_injective (σ := σ) (n := N))
  have hodd : Odd (Nat.card Φ.ker) :=
    CFSG.StandardType.odd_natCard_of_le_center_SU σ hker
  have hE : W ≤ Φ.range := by rw [hrange]; exact hWX
  obtain ⟨P, hP2, hPmap, hPinj⟩ :=
    CFSG.GroupTheory.exists_isPGroup_map_eq_of_odd (Φ := Φ) hodd hE hW2
  refine ⟨P, hPmap, hP2, hPinj, fun x hx => ?_⟩
  have hxW : Φ x ∈ W := hPmap ▸ Subgroup.mem_map_of_mem Φ hx
  have hsq : Φ x * Φ x = 1 := hsqW (Φ x) hxW
  have hsub : (Φ.comp P.subtype) ⟨x * x, P.mul_mem hx hx⟩ =
      (Φ.comp P.subtype) ⟨1, P.one_mem⟩ := by
    simpa using hsq
  exact Subtype.ext_iff.mp (hPinj hsub)

private theorem fix_p₀ {F : Type} [Field F] [Finite F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) {N : ℕ} {K : Type} [Group K]
    {Φ : SU σ N →* K}
    (hker : Φ.ker ≤ Subgroup.center (SU σ N)) {p₀ : Fin N → F} (hp₀ : p₀ ≠ 0)
    (hp₀iso : uForm σ p₀ p₀ = 0) {T₀ : Subgroup (SU σ N)}
    (hT₀ : IsUTransGroup σ p₀ T₀) {W : Subgroup K} (hWT : ⁅T₀.map Φ, W⁆ = ⊥)
    {Ŵ : Subgroup (SU σ N)} (hŴmap : Ŵ.map Φ = W) (hŴsq : ∀ x ∈ Ŵ, x * x = 1) :
    ∀ x ∈ Ŵ, suMat σ N x *ᵥ p₀ = p₀ := by
  have hodd : ∀ z ∈ Φ.ker, Odd (orderOf z) := fun z hz =>
    CFSG.StandardType.odd_orderOf_of_mem_center_SU σ (hker hz)
  have hcommWT : ∀ a ∈ T₀.map Φ, ∀ b ∈ W, a * b = b * a := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer] at hWT
    intro a ha b hb
    exact ((Subgroup.mem_centralizer_iff.1 (hWT ha)) b hb).symm
  intro x hx
  have hΦxW : Φ x ∈ W := hŴmap ▸ Subgroup.mem_map_of_mem Φ hx
  have hcomm : ∀ t ∈ T₀, x * t = t * x := by
    intro t ht
    have ht2 : t ^ 2 = 1 := isUTransGroup_pow_two_eq_one hp₀iso hT₀ ht
    have h := hcommWT (Φ t) (Subgroup.mem_map_of_mem Φ ht) (Φ x) hΦxW
    exact CFSG.Quasithin.SmithA36.commute_of_sq_eq_one hker hodd ht2 h.symm
  exact ModelRank.suMat_mulVec_eq_of_commute hσ hp₀ hT₀ (hŴsq x hx) hcomm

private theorem fix_sub {F : Type} [Field F] [Finite F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) (htr : ∀ a, σ a = a → ∃ c, c + σ c = a)
    {N : ℕ} {hN : 2 ≤ N} {K : Type} [Group K] {Φ : SU σ N →* K}
    {Δ : Set (Subgroup K)}
    (hΔ : ∀ U, U ∈ Δ ↔ ∃ x : SU σ N,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ)
    (hker : Φ.ker ≤ Subgroup.center (SU σ N)) {W : Subgroup K}
    (hW : Tim78.IsRootTypeTI W) (hWΔ : ∃ k : K, conjSubgroup k W ∈ Δ)
    {Ŵ : Subgroup (SU σ N)} (hŴmap : Ŵ.map Φ = W) (hŴsq : ∀ x ∈ Ŵ, x * x = 1)
    (hŴinj : Function.Injective (Φ.comp Ŵ.subtype))
    {w : ↥Ŵ} {x₀ : Fin N → F}
    (hv : suMat σ N (w : SU σ N) *ᵥ x₀ - x₀ ≠ 0) :
    ∀ w' ∈ Ŵ, suMat σ N (w' : SU σ N) *ᵥ
        (suMat σ N (w : SU σ N) *ᵥ x₀ - x₀) =
      suMat σ N (w : SU σ N) *ᵥ x₀ - x₀ := by
  have hodd : ∀ z ∈ Φ.ker, Odd (orderOf z) := fun z hz =>
    CFSG.StandardType.odd_orderOf_of_mem_center_SU σ (hker hz)
  let v : Fin N → F := suMat σ N (w : SU σ N) *ᵥ x₀ - x₀
  have hvv : uForm σ v v = 0 := ModelRank.uForm_sub_sub_eq_zero (hŴsq w w.2) x₀ x₀
  have hfixw : suMat σ N (w : SU σ N) *ᵥ v = v :=
    ModelRank.suMat_mulVec_sub_eq (hŴsq w w.2) x₀
  obtain ⟨Tv, hTv⟩ := ModelRank.exists_isUTransGroup hσ hvv
  have hvΔ : Tv.map Φ ∈ Δ := SUTrans.map_mem hσ htr hN hΔ hv hvv hTv
  have hwN : (w : SU σ N) ∈ Subgroup.normalizer (Tv : Set (SU σ N)) := by
    rw [mem_normalizer_iff_conjSubgroup_eq]
    have h := hTv.conjSub (w : SU σ N)
    rw [hfixw] at h
    exact h.eq hTv
  have hΦwN : Φ (w : SU σ N) ∈ Subgroup.normalizer (Tv.map Φ : Set K) :=
    Subgroup.le_normalizer_map Φ (H := Tv) (Subgroup.mem_map.mpr ⟨(w : SU σ N), hwN, rfl⟩)
  have hΦwW : Φ (w : SU σ N) ∈ W :=
    hŴmap ▸ Subgroup.mem_map_of_mem Φ w.2
  have hΦw1 : Φ (w : SU σ N) ≠ 1 := by
    intro h1
    have hw1 : (w : ↥Ŵ) = 1 := hŴinj (by simpa using h1)
    exact hv (by rw [show (w : SU σ N) = 1 from congrArg Subtype.val hw1]; simp)
  have hne : W ⊓ Subgroup.normalizer (Tv.map Φ : Set K) ≠ ⊥ := by
    intro hbot
    have hmem : Φ (w : SU σ N) ∈ W ⊓ Subgroup.normalizer (Tv.map Φ : Set K) :=
      ⟨hΦwW, hΦwN⟩
    rw [hbot, Subgroup.mem_bot] at hmem
    exact hΦw1 hmem
  have hcommRoot : ∀ a ∈ W, ∀ b ∈ Tv.map Φ, a * b = b * a :=
    SUTrans.commute_of_isRootTypeTI hσ hN hΔ hW hWΔ hvΔ hne
  intro w' hw'
  have hΦw'W : Φ (w' : SU σ N) ∈ W := hŴmap ▸ Subgroup.mem_map_of_mem Φ hw'
  refine ModelRank.suMat_mulVec_eq_of_commute hσ hv hTv (hŴsq w' hw') (fun t ht => ?_)
  have ht2 : t ^ 2 = 1 := isUTransGroup_pow_two_eq_one hvv hTv ht
  have h := hcommRoot (Φ (w' : SU σ N)) hΦw'W (Φ t)
    (Subgroup.mem_map_of_mem Φ ht)
  exact CFSG.Quasithin.SmithA36.commute_of_sq_eq_one hker hodd ht2 h

private theorem isotropic_I {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) {N : ℕ} {p₀ : Fin N → F} {Ŵ : Subgroup (SU σ N)}
    (hp₀iso : uForm σ p₀ p₀ = 0)
    (hfix : ∀ v : Fin N → F,
      (v = p₀ ∨ ∃ w : ↥Ŵ, ∃ x : Fin N → F, v = suMat σ N (w : SU σ N) *ᵥ x - x) →
      ∀ w' ∈ Ŵ, suMat σ N (w' : SU σ N) *ᵥ v = v)
    {v v' : Fin N → F}
    (hv : v = p₀ ∨ ∃ w : ↥Ŵ, ∃ x : Fin N → F, v = suMat σ N (w : SU σ N) *ᵥ x - x)
    (hv' : v' = p₀ ∨ ∃ w : ↥Ŵ, ∃ x : Fin N → F, v' = suMat σ N (w : SU σ N) *ᵥ x - x) :
    uForm σ v v' = 0 := by
  rcases hv with hv0 | ⟨w, x, rfl⟩
  · rw [hv0]
    rcases hv' with hv0' | ⟨w', x', rfl⟩
    · rw [hv0']; exact hp₀iso
    · exact ModelRank.uForm_sub_eq_zero_of_mulVec_eq (hfix p₀ (Or.inl rfl) w' w'.2) x'
  · rcases hv' with hv0' | ⟨w', x', rfl⟩
    · rw [hv0']
      exact uForm_eq_zero_comm hσ
        (ModelRank.uForm_sub_eq_zero_of_mulVec_eq (hfix p₀ (Or.inl rfl) w w.2) x)
    · exact ModelRank.uForm_sub_eq_zero_of_mulVec_eq
        (hfix _ (Or.inr ⟨w, x, rfl⟩) w' w'.2) x'

private theorem conj_le_lowRad {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F}
    {N : ℕ} {p₀ : Fin N → F} {Ŵ : Subgroup (SU σ N)}
    {T₀ : Subgroup (SU σ N)} {g : SU σ N} (hT₀ : IsUTransGroup σ p₀ T₀)
    (hI : ∀ v : Fin N → F,
      (v = p₀ ∨ ∃ w : ↥Ŵ, ∃ x : Fin N → F, v = suMat σ N (w : SU σ N) *ᵥ x - x) →
      suMat σ N g *ᵥ v ∈ lowSpan F N) :
    conjSub Ŵ g ≤ lowRad σ N ∧ conjSub T₀ g ≤ lowRad σ N := by
  constructor
  · intro y hy
    obtain ⟨w, hw, rfl⟩ := Subgroup.mem_map.1 hy
    change (g * (w : SU σ N) * g⁻¹) ∈ lowRad σ N
    refine ModelRank.mem_lowRad_of_forall_sub_mem (g := g * (w : SU σ N) * g⁻¹) fun x => ?_
    rw [suMat_conj_mulVec_sub]
    exact hI _ (Or.inr ⟨⟨w, hw⟩, _, rfl⟩)
  · have hmem : suMat σ N g *ᵥ p₀ ∈ lowSpan F N := hI p₀ (Or.inl rfl)
    exact ModelRank.le_lowRad_of_isUTransGroup hmem (hT₀.conjSub g)

private theorem exists_sylow {F : Type} [Field F] [Finite F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) (htr : ∀ a, σ a = a → ∃ c, c + σ c = a)
    {N : ℕ} {hN : 2 ≤ N} {K : Type} [Group K] [Finite K] {X₀ : Subgroup K}
    {Δ : Set (Subgroup K)} {Φ : SU σ N →* K}
    (hker : Φ.ker ≤ Subgroup.center (SU σ N)) (hrange : Φ.range = X₀)
    (hΔ : ∀ U, U ∈ Δ ↔ ∃ x : SU σ N,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ)
    (g : SU σ N) :
    ∃ S : Sylow 2 ↥X₀, sylowRoots X₀ Δ S =
      (lowRad σ N).map (Φ.comp (MulAut.conj g⁻¹).toMonoidHom) := by
  let Φ' : SU σ N →* K := Φ.comp (MulAut.conj g⁻¹).toMonoidHom
  have hker' : Φ'.ker ≤ Subgroup.center (SU σ N) :=
    CFSG.Timmesfeld.ARS.CaseMSU.ker_comp_conj_le_center hker g⁻¹
  have hrange' : Φ'.range = X₀ := (range_comp_conj Φ g⁻¹).trans hrange
  have hΔ' : ∀ U, U ∈ Δ ↔ ∃ x : SU σ N,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ' := by
    intro U
    rw [hΔ U]
    exact (exists_eq_map_conjSub_comp_conj_iff Φ
      (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) g⁻¹ U).symm
  let Qbar : Subgroup K := (lowRad σ N).map Φ'
  have hQbar_le_X : Qbar ≤ X₀ :=
    (Subgroup.map_le_range Φ' (lowRad σ N)).trans_eq hrange'
  let Q' : Subgroup ↥X₀ := Qbar.subgroupOf X₀
  have hQ'2 : IsPGroup 2 Q' :=
    (ModelRank.isPGroup_lowRad (σ := σ) (m := N)).map Φ' |>.of_equiv
      (Subgroup.subgroupOfEquivOfLe hQbar_le_X).symm
  obtain ⟨S, hQ'S⟩ := hQ'2.exists_le_sylow
  have hQbar_le_S : Qbar ≤ (S : Subgroup ↥X₀).map X₀.subtype := by
    calc Qbar = Q'.map X₀.subtype := (Subgroup.map_subgroupOf_eq_of_le hQbar_le_X).symm
      _ ≤ (S : Subgroup ↥X₀).map X₀.subtype := Subgroup.map_mono hQ'S
  exact ⟨S, sylowRoots_eq_map_lowRad hσ htr hN hker' hrange' hΔ' S hQbar_le_S⟩

theorem unitaryRootTypeSylow : UnitaryRootTypeSylow := by
  intro K _ _ X₀ Δ f N hf hN hf2 hX hC W hWN hWΔ hW T hT hWT
  classical
  have hWX : W ≤ X₀ := hX.le_of_isRootTypeTI hf2 (by omega) hC hWN hWΔ hW
  obtain ⟨Φ, hker, hrange, hΔ⟩ := hX
  let F := GaloisField 2 (2 * f)
  let σ : F ≃+* F := unitaryInvolution F 2 f
  have hF : Nat.card F = (2 ^ f) ^ 2 := card_galoisField_two_mul hf
  have hσ : ∀ c, σ (σ c) = c := unitaryInvolution_involutive hF
  have htr : ∀ a, σ a = a → ∃ c, c + σ c = a :=
    fun a ha => exists_add_unitaryInvolution_eq hF ha
  obtain ⟨p₀, T₀, hp₀, hp₀iso, hT₀, hTeq⟩ :=
    SUTrans.exists_eq_map_of_mem hσ (by omega : 2 ≤ N) hΔ hT
  have hWT' : ⁅T₀.map Φ, W⁆ = ⊥ := by rw [← hTeq]; exact hWT
  obtain ⟨hW2, hsqW⟩ :=
    isPGroup_and_mul_self_eq_one_of_conjSubgroup_mem hσ hΔ hWΔ
  obtain ⟨Ŵ, hŴmap, hŴ2, hŴinj, hŴsq⟩ :=
    exists_involution_lift_subgroup hker hrange hW2 hsqW hWX
  let I : Set (Fin N → F) :=
    {v | v = p₀ ∨ ∃ w : ↥Ŵ, ∃ x : Fin N → F, v = suMat σ N (w : SU σ N) *ᵥ x - x}
  have hfix : ∀ v : Fin N → F, v ∈ I → ∀ w' ∈ Ŵ,
      suMat σ N (w' : SU σ N) *ᵥ v = v := by
    intro v hv w' hw'
    change v = p₀ ∨ ∃ w : ↥Ŵ, ∃ x : Fin N → F,
      v = suMat σ N (w : SU σ N) *ᵥ x - x at hv
    rcases hv with hv0 | ⟨w, x, rfl⟩
    · rw [hv0]
      exact fix_p₀ hσ hker hp₀ hp₀iso hT₀ hWT' hŴmap hŴsq w' hw'
    · by_cases h0 : suMat σ N (w : SU σ N) *ᵥ x - x = 0
      · rw [h0, mulVec_zero]
      · exact fix_sub hσ htr hΔ hker hW hWΔ hŴmap hŴsq hŴinj h0 w' hw'
  have hIso : ∀ v ∈ I, ∀ v' ∈ I, uForm σ v v' = 0 := by
    intro v hv v' hv'
    exact isotropic_I hσ hp₀iso hfix hv hv'
  obtain ⟨g, hg⟩ := ModelRank.exists_suMat_mulVec_mem_lowSpan hσ htr hIso
  have hQ : conjSub Ŵ g ≤ lowRad σ N ∧ conjSub T₀ g ≤ lowRad σ N := by
    refine conj_le_lowRad hT₀ ?_
    intro v hv
    exact hg v hv
  let Φ' : SU σ N →* K := Φ.comp (MulAut.conj g⁻¹).toMonoidHom
  obtain ⟨S, hS⟩ := exists_sylow hσ htr hker hrange hΔ g
  have hWQ : W ≤ (lowRad σ N).map Φ' := by
    rw [← hŴmap]
    have h1 : (conjSub Ŵ g).map Φ' = Ŵ.map Φ := by
      rw [map_conjSub_comp_conj Φ Ŵ g⁻¹ g, inv_mul_cancel, conjSub_one]
    calc Ŵ.map Φ = (conjSub Ŵ g).map Φ' := h1.symm
      _ ≤ (lowRad σ N).map Φ' := Subgroup.map_mono hQ.1
  have hTQ : T ≤ (lowRad σ N).map Φ' := by
    rw [hTeq]
    have h1 : (conjSub T₀ g).map Φ' = T₀.map Φ := by
      rw [map_conjSub_comp_conj Φ T₀ g⁻¹ g, inv_mul_cancel, conjSub_one]
    calc T₀.map Φ = (conjSub T₀ g).map Φ' := h1.symm
      _ ≤ (lowRad σ N).map Φ' := Subgroup.map_mono hQ.2
  exact ⟨S, by rw [hS]; exact hWQ, by rw [hS]; exact hTQ⟩

end CFSG.RankThree.GF2n.Tim81
