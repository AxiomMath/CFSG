theorem SUTrans.isPGroup_and_mul_self_eq_one_of_conjSubgroup_mem {F : Type} [Field F]
    [CharP F 2] {σ : F ≃+* F} (hσ : ∀ c, σ (σ c) = c) {N : ℕ} {hN : 2 ≤ N}
    {K : Type} [Group K] {Φ : SU σ N →* K} {Δ : Set (Subgroup K)}
    (hΔ : ∀ U, U ∈ Δ ↔ ∃ x : SU σ N,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ)
    {W : Subgroup K} (hWΔ : ∃ k : K, conjSubgroup k W ∈ Δ) :
    IsPGroup 2 W ∧ ∀ x ∈ W, x * x = 1 := by
  obtain ⟨k, hk⟩ := hWΔ
  have hP : IsPGroup 2 (conjSubgroup k W) := SUTrans.isPGroup_of_mem hσ hN hΔ hk
  have hsq : ∀ y ∈ conjSubgroup k W, y * y = 1 :=
    fun y hy => SUTrans.mul_self_eq_one_of_mem hσ hN hΔ hk hy
  have hW : W = conjSubgroup k⁻¹ (conjSubgroup k W) := by
    rw [conjSubgroup_conjSubgroup, inv_mul_cancel, conjSubgroup_one]
  constructor
  · rw [hW]
    exact hP.map (MulAut.conj k⁻¹).toMonoidHom
  · intro x hx
    have hy : k * x * k⁻¹ ∈ conjSubgroup k W := by
      rw [mem_conjSubgroup]
      rw [show k⁻¹ * (k * x * k⁻¹) * k = x by group]
      exact hx
    have h1 := hsq (k * x * k⁻¹) hy
    calc x * x = k⁻¹ * ((k * x * k⁻¹) * (k * x * k⁻¹)) * k := by group
      _ = k⁻¹ * 1 * k := by rw [h1]
      _ = 1 := by group

private theorem W_data {F : Type} [Field F] [Finite F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) {K : Type} [Group K] {N f : ℕ} {hN : 2 ≤ N}
    {Φ : SU σ N →* K} {Δ : Set (Subgroup K)}
    (hΔ : ∀ U : Subgroup K, U ∈ Δ ↔ ∃ x,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ)
    (hker : Φ.ker ≤ Subgroup.center (SU σ N))
    (hcard : Nat.card (traceZero σ) = 2 ^ f)
    {W : Subgroup K} (hWΔ : ∃ k : K, conjSubgroup k W ∈ Δ) :
    Nat.card W = 2 ^ f ∧ IsPGroup 2 W ∧ ∀ x ∈ W, x * x = 1 := by
  obtain ⟨hW2, hsq⟩ := SUTrans.isPGroup_and_mul_self_eq_one_of_conjSubgroup_mem hσ hΔ hWΔ
  obtain ⟨k, hk⟩ := hWΔ
  refine ⟨?_, hW2, hsq⟩
  rw [← CFSG.CGT.Timmesfeld75.card_conjSubgroup k W]
  exact (SUTrans.natCard_of_mem hσ hN hΔ hker hk).trans hcard

private theorem exists_involution_lift {F : Type} [Field F] [Finite F] [CharP F 2]
    {σ : F ≃+* F} {K : Type} [Group K] {N : ℕ} {Φ : SU σ N →* K}
    (hker : Φ.ker ≤ Subgroup.center (SU σ N)) {u : K} (hu : u ∈ Φ.range)
    (hu2 : u * u = 1) :
    ∃ x : SU σ N, Φ x = u ∧ x * x = 1 := by
  obtain ⟨y, rfl⟩ := hu
  have hodd : ∀ z ∈ Φ.ker, Odd (orderOf z) := fun z hz =>
    CFSG.StandardType.odd_orderOf_of_mem_center_SU σ (hker hz)
  obtain ⟨x, hx, hx2⟩ := CFSG.Quasithin.SmithA36.exists_lift_sq_eq_one hodd
    (y := y) (by simpa [sq] using hu2)
  exact ⟨x, hx, by simpa [sq] using hx2⟩

private theorem exists_plane_of_not_mem_span {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) {N : ℕ} {x : SU σ N} (hx : x * x = 1) {p₁ : Fin N → F}
    {x₁ : Fin N → F} (hp₁def : p₁ = suMat σ N x *ᵥ x₁ - x₁)
    (hp₁0 : p₁ ≠ 0) (hp₁iso : uForm σ p₁ p₁ = 0)
    (hp₁fix : suMat σ N x *ᵥ p₁ = p₁)
    (hcase : ∃ y : Fin N → F, suMat σ N x *ᵥ y - y ∉ Submodule.span F {p₁}) :
    ∃ p₂ : Fin N → F,
      (∀ a b : F, a • p₁ + b • p₂ = 0 → a = 0 ∧ b = 0) ∧
      uForm σ p₂ p₂ = 0 ∧ (∀ c : F, uForm σ (p₁ + c • p₂) (p₁ + c • p₂) = 0) ∧
      suMat σ N x *ᵥ p₂ = p₂ ∧
      (∀ c : F, suMat σ N x *ᵥ (p₁ + c • p₂) = p₁ + c • p₂) := by
  obtain ⟨x₂, hx₂⟩ := hcase
  let p₂ : Fin N → F := suMat σ N x *ᵥ x₂ - x₂
  have hp₂0 : p₂ ≠ 0 := by
    intro h
    have h' : suMat σ N x *ᵥ x₂ - x₂ = 0 := by simpa [p₂] using h
    exact hx₂ (by rw [h']; exact Submodule.zero_mem _)
  have hp₂iso : uForm σ p₂ p₂ = 0 := ModelRank.uForm_sub_sub_eq_zero hx x₂ x₂
  have hp₂fix : suMat σ N x *ᵥ p₂ = p₂ := ModelRank.suMat_mulVec_sub_eq hx x₂
  have hp₁p₂ : uForm σ p₁ p₂ = 0 := by
    rw [hp₁def]
    simpa [p₂] using ModelRank.uForm_sub_sub_eq_zero hx x₁ x₂
  have h21 : uForm σ p₂ p₁ = 0 := by rw [← uForm_conj σ hσ p₁ p₂, hp₁p₂, map_zero]
  refine ⟨p₂, ?_, hp₂iso, ?_, hp₂fix, ?_⟩
  · intro a b hab
    by_cases hb : b = 0
    · subst hb
      simp only [zero_smul, add_zero] at hab
      exact ⟨(smul_eq_zero.mp hab).resolve_right hp₁0, rfl⟩
    · have h' : b • p₂ = -(a • p₁) := add_eq_zero_iff_eq_neg'.mp hab
      have hp₂span : p₂ ∈ Submodule.span F {p₁} := by
        refine Submodule.mem_span_singleton.mpr ⟨-(b⁻¹ * a), ?_⟩
        have h1 : p₂ = b⁻¹ • (b • p₂) := by
          rw [smul_smul, inv_mul_cancel₀ hb, one_smul]
        rw [h1, h']
        module
      exact absurd hp₂span hx₂
  · intro c
    have h21c : uForm σ (c • p₂) p₁ = 0 := by
      rw [uForm_smul_left, h21, mul_zero]
    simp only [uForm_add_left, uForm_add_right, uForm_smul_left, uForm_smul_right,
      hp₁iso, hp₂iso, hp₁p₂, h21, h21c, mul_zero, add_zero, zero_add]
  · intro c
    rw [mulVec_add, mulVec_smul, hp₁fix, hp₂fix]

private theorem exists_plane_of_forall_mem_span {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) (htr : ∀ a, σ a = a → ∃ c, c + σ c = a)
    (hnorm : ∀ d, σ d = d → ∃ l, σ l * l = d) {N : ℕ} (hN : 4 ≤ N) {x : SU σ N}
    {p₁ : Fin N → F} (hp₁0 : p₁ ≠ 0) (hp₁iso : uForm σ p₁ p₁ = 0)
    (hp₁fix : suMat σ N x *ᵥ p₁ = p₁)
    (hcase : ∀ y : Fin N → F, suMat σ N x *ᵥ y - y ∈ Submodule.span F {p₁}) :
    ∃ p₂ : Fin N → F,
      (∀ a b : F, a • p₁ + b • p₂ = 0 → a = 0 ∧ b = 0) ∧
      uForm σ p₂ p₂ = 0 ∧ (∀ c : F, uForm σ (p₁ + c • p₂) (p₁ + c • p₂) = 0) ∧
      suMat σ N x *ᵥ p₂ = p₂ ∧
      (∀ c : F, suMat σ N x *ᵥ (p₁ + c • p₂) = p₁ + c • p₂) := by
  obtain ⟨d, hd_iso, hpd⟩ := ModelRank.exists_isotropic_partner hσ htr hp₁0 hp₁iso
  obtain ⟨p₂, hp₂0, hp₂iso, hp₁p₂', hdp₂'⟩ :=
    CFSG.Timmesfeld.LieEmbed.exists_isotropic_perp (σ := σ) hσ hnorm
      (P := fun _ : Fin 1 => p₁) (Q := fun _ : Fin 1 => d)
      (Nat.lt_of_lt_of_le (by norm_num : 2 * 1 + 1 < 4) hN)
  have hp₁p₂ : uForm σ p₁ p₂ = 0 := hp₁p₂' ⟨0, by omega⟩
  have hdp₂ : uForm σ d p₂ = 0 := hdp₂' ⟨0, by omega⟩
  have hp₂fix : suMat σ N x *ᵥ p₂ = p₂ := by
    refine ModelRank.suMat_mulVec_eq_of_forall_uForm_sub_eq_zero fun y => ?_
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hcase y)
    rw [← ha, uForm_smul_left, hp₁p₂, mul_zero]
  have hp₂d : uForm σ p₂ d = 0 := by
    rw [← uForm_conj σ hσ d p₂, hdp₂, map_zero]
  have hp₁fixc : ∀ c : F, suMat σ N x *ᵥ (p₁ + c • p₂) = p₁ + c • p₂ := by
    intro c
    rw [mulVec_add, mulVec_smul, hp₁fix, hp₂fix]
  have h21 : uForm σ p₂ p₁ = 0 := by rw [← uForm_conj σ hσ p₁ p₂, hp₁p₂, map_zero]
  refine ⟨p₂, ?_, hp₂iso, ?_, hp₂fix, hp₁fixc⟩
  · intro a b hab
    have h0 : uForm σ (0 : Fin N → F) d = 0 := by simp [uForm_eq]
    have h := congrArg (fun z => uForm σ z d) hab
    simp only [uForm_add_left, uForm_smul_left, hpd, hp₂d, h0, mul_one, mul_zero,
      add_zero] at h
    have ha : a = 0 := (map_eq_zero σ).mp (by simpa using h)
    refine ⟨ha, ?_⟩
    subst ha
    simp only [zero_smul, zero_add] at hab
    exact (smul_eq_zero.mp hab).resolve_right hp₂0
  · intro c
    have h21c : uForm σ (c • p₂) p₁ = 0 := by
      rw [uForm_smul_left, h21, mul_zero]
    simp only [uForm_add_left, uForm_add_right, uForm_smul_left, uForm_smul_right,
      hp₁iso, hp₂iso, hp₁p₂, h21, h21c, mul_zero, add_zero, zero_add]

private theorem exists_plane {F : Type} [Field F] [CharP F 2] {σ : F ≃+* F}
    (hσ : ∀ c, σ (σ c) = c) (htr : ∀ a, σ a = a → ∃ c, c + σ c = a)
    (hnorm : ∀ d, σ d = d → ∃ l, σ l * l = d) {N : ℕ} (hN : 4 ≤ N) {x : SU σ N}
    (hx : x * x = 1) (hxne : x ≠ 1) :
    ∃ p₁ p₂ : Fin N → F,
      (∀ a b : F, a • p₁ + b • p₂ = 0 → a = 0 ∧ b = 0) ∧
      uForm σ p₂ p₂ = 0 ∧ (∀ c : F, uForm σ (p₁ + c • p₂) (p₁ + c • p₂) = 0) ∧
      suMat σ N x *ᵥ p₂ = p₂ ∧
      (∀ c : F, suMat σ N x *ᵥ (p₁ + c • p₂) = p₁ + c • p₂) := by
  classical
  have hex : ∃ y, suMat σ N x *ᵥ y ≠ y := by
    by_contra h
    push Not at h
    exact hxne (ModelRank.eq_of_suMat_mulVec_eq fun y => by
      simpa [map_one, one_mulVec] using h y)
  obtain ⟨x₁, hx₁⟩ := hex
  let p₁ : Fin N → F := suMat σ N x *ᵥ x₁ - x₁
  have hp₁0 : p₁ ≠ 0 := sub_ne_zero.mpr hx₁
  have hp₁iso : uForm σ p₁ p₁ = 0 := ModelRank.uForm_sub_sub_eq_zero hx x₁ x₁
  have hp₁fix : suMat σ N x *ᵥ p₁ = p₁ := ModelRank.suMat_mulVec_sub_eq hx x₁
  by_cases hcase : ∃ y, suMat σ N x *ᵥ y - y ∉ Submodule.span F {p₁}
  · obtain ⟨p₂, h1, h2, h3, h4, h5⟩ :=
      exists_plane_of_not_mem_span hσ hx (x₁ := x₁) rfl hp₁0 hp₁iso hp₁fix hcase
    exact ⟨p₁, p₂, h1, h2, h3, h4, h5⟩
  · push Not at hcase
    obtain ⟨p₂, h1, h2, h3, h4, h5⟩ :=
      exists_plane_of_forall_mem_span hσ htr hnorm hN hp₁0 hp₁iso hp₁fix hcase
    exact ⟨p₁, p₂, h1, h2, h3, h4, h5⟩

private theorem inf_ne_bot {F : Type} [Field F] [Finite F] [CharP F 2]
    {K : Type} [Group K] [Finite K] {f N : ℕ} (hf2 : 2 ≤ f)
    (hN3 : 3 ≤ N) (h : UnitaryFieldData 2 f F) {C : GL (Fin N) F}
    (hCg : IsPrimeFormGram C) {X₀ : Subgroup K}
    (e : primeFormP h (C : Matrix (Fin N) (Fin N) F) ≃* X₀)
    (hC : Subgroup.centralizer (X₀ : Set K) = ⊥) {W : Subgroup K}
    (hWN : W ≤ Subgroup.normalizer (X₀ : Set K)) (hW2 : IsPGroup 2 W)
    (hsq : ∀ x ∈ W, x * x = 1) (hcardW : Nat.card W = 2 ^ f) :
    W ⊓ X₀ ≠ ⊥ := by
  intro hbot
  have hq : ¬(N = 3 ∧ 2 ^ f = 2) := by
    rintro ⟨-, h2⟩
    have hlt : 2 < 2 ^ f := by
      simpa using Nat.pow_lt_pow_right (by norm_num : 1 < (2 : ℕ)) hf2
    exact absurd h2 (by omega)
  have hcyc : IsCyclic W :=
    CFSG.SeitzReduction.UnitaryPilot.isCyclic_of_inf_eq_bot h hN3 hq hCg e hC hWN hW2 hbot
  have hexp : Monoid.exponent W ∣ 2 :=
    Monoid.exponent_dvd_of_forall_pow_eq_one fun x => by
      have hx : (x : K) * (x : K) = 1 := hsq (x : K) x.2
      exact Subtype.ext (by simpa [pow_two] using hx)
  have hcardexp : Nat.card W = Monoid.exponent W := (IsCyclic.exponent_eq_card).symm
  have hdvd : Nat.card W ∣ 2 := by rw [hcardexp]; exact hexp
  rw [hcardW] at hdvd
  have h4 : 4 ≤ 2 ^ f := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf2
  have h2le : 2 ^ f ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
  omega

private theorem commute_map_of_fixed {F : Type} [Field F] [Finite F] [CharP F 2]
    {σ : F ≃+* F} (hσ : ∀ c, σ (σ c) = c) (htr : ∀ a, σ a = a → ∃ c, c + σ c = a)
    {K : Type} [Group K] {N : ℕ} {hN : 2 ≤ N} {Φ : SU σ N →* K}
    {Δ : Set (Subgroup K)}
    (hΔ : ∀ U : Subgroup K, U ∈ Δ ↔ ∃ x,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ)
    {W : Subgroup K} (hW : Tim78.IsRootTypeTI W)
    (hWΔ : ∃ k : K, conjSubgroup k W ∈ Δ) {u : K} (huW : u ∈ W) (hu1 : u ≠ 1)
    {v : Fin N → F} (hv : v ≠ 0) (hvv : uForm σ v v = 0)
    {T : Subgroup (SU σ N)} (hT : IsUTransGroup σ v T)
    {x : SU σ N} (hxΦ : Φ x = u) (hxv : suMat σ N x *ᵥ v = v) :
    ∀ a ∈ W, ∀ b ∈ T.map Φ, a * b = b * a := by
  have hxN : x ∈ Subgroup.normalizer (T : Set (SU σ N)) := by
    rw [ModelRank.normalizer_eq_uLine hσ hv hT]
    exact ⟨1, one_ne_zero, by rw [hxv, one_smul]⟩
  have huN : u ∈ Subgroup.normalizer (T.map Φ : Set K) := by
    have hle := Subgroup.le_normalizer_map Φ (H := T)
    exact hle (Subgroup.mem_map.mpr ⟨x, hxN, hxΦ⟩)
  have hne : W ⊓ Subgroup.normalizer (T.map Φ : Set K) ≠ ⊥ := by
    intro hbot
    have hu : u ∈ W ⊓ Subgroup.normalizer (T.map Φ : Set K) := ⟨huW, huN⟩
    rw [hbot, Subgroup.mem_bot] at hu
    exact hu1 hu
  exact SUTrans.commute_of_isRootTypeTI hσ hN hΔ hW hWΔ
    (SUTrans.map_mem hσ htr hN hΔ hv hvv hT) hne


private theorem exists_smul_of_fixed_transvection {F : Type} [Field F] [Finite F] [CharP F 2]
    {K : Type} [Group K] [Finite K] {N f : ℕ}
    {Φ : SU (unitaryInvolution F 2 f) N →* K}
    (hσ : ∀ c, unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c)
    (hN1 : 1 ≤ N) (h : UnitaryFieldData 2 f F) {C : GL (Fin N) F}
    (hCg : IsPrimeFormGram C) (hCa : (C : Matrix (Fin N) (Fin N) F) = antidiag N)
    (e : primeFormP h (C : Matrix (Fin N) (Fin N) F) ≃* Φ.range)
    (he : ∀ (g : gramSU h (C : Matrix (Fin N) (Fin N) F))
      (g' : SU (unitaryInvolution F 2 f) N),
      (g : GL (Fin N) F) = (g' : GL (Fin N) F) →
        e (g : primeFormP h (C : Matrix (Fin N) (Fin N) F)) = Φ.rangeRestrict g')
    (hSU : SU (unitaryInvolution F 2 f) N = gramSU h (C : Matrix (Fin N) (Fin N) F))
    {W : Subgroup K} {p₁ p₂ : Fin N → F}
    (hcomm : ∀ (v : Fin N → F), (v = p₂ ∨ ∃ c : F, v = p₁ + c • p₂) →
      ∀ {T : Subgroup (SU (unitaryInvolution F 2 f) N)},
        IsUTransGroup (unitaryInvolution F 2 f) v T →
          ∀ a ∈ W, ∀ b ∈ T.map Φ, a * b = b * a)
    {w : K} (hwW : w ∈ W) (hwN : w ∈ Subgroup.normalizer (Φ.range : Set K))
    {A : primeFormUnitary h (C : Matrix (Fin N) (Fin N) F)} {φ : F ≃+* F}
    (hβ : primeFormPsi h hCg ⟨A, φ⟩ =
      MulAut.congr e.symm (Φ.range.normalizerMonoidHom ⟨w, hwN⟩))
    {v : Fin N → F} (hv : v = p₂ ∨ ∃ c : F, v = p₁ + c • p₂)
    (hvv : uForm (unitaryInvolution F 2 f) v v = 0) :
    ∃ μ : F,
      ((A : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) *ᵥ (fun i => φ (v i)) = μ • v := by
  classical
  have htr1 : (1 : F) + unitaryInvolution F 2 f 1 = 0 := by
    rw [map_one, CharTwo.add_self_eq_zero]
  obtain ⟨T, hT⟩ := ModelRank.exists_isUTransGroup hσ hvv
  obtain ⟨t, ht⟩ := ModelRank.exists_suMat_eq_uTrans hσ hvv htr1
  have htT : t ∈ T := (hT.1 t).2 ⟨1, htr1, ht⟩
  let tG : gramSU h (C : Matrix (Fin N) (Fin N) F) := (MulEquiv.subgroupCongr hSU) t
  have htG : ((tG : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) =
      uTrans (unitaryInvolution F 2 f) v 1 := by
    change ((t : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) =
      uTrans (unitaryInvolution F 2 f) v 1
    rw [← suMat_apply, ht]
  have hcoe_tG : ((e (tG : primeFormP h (C : Matrix (Fin N) (Fin N) F))) : K) = Φ t := by
    rw [he tG t (MulEquiv.subgroupCongr_apply hSU t)]
    rfl
  have hcommt : w * Φ t = Φ t * w :=
    hcomm v hv hT w hwW (Φ t) (Subgroup.mem_map.mpr ⟨t, htT, rfl⟩)
  let α : MulAut Φ.range := Φ.range.normalizerMonoidHom ⟨w, hwN⟩
  have hα : α (e (tG : primeFormP h (C : Matrix (Fin N) (Fin N) F))) =
      e (tG : primeFormP h (C : Matrix (Fin N) (Fin N) F)) := by
    apply Subtype.ext
    rw [Subgroup.normalizerMonoidHom_apply_apply_coe, hcoe_tG]
    calc w * Φ t * w⁻¹ = (Φ t * w) * w⁻¹ := by rw [hcommt]
      _ = Φ t := by group
  have hfix : primeFormPsi h hCg ⟨A, φ⟩
      (tG : primeFormP h (C : Matrix (Fin N) (Fin N) F)) =
      (tG : primeFormP h (C : Matrix (Fin N) (Fin N) F)) := by
    rw [hβ, MulAut.congr_apply]
    simp only [MulEquiv.trans_apply, MulEquiv.symm_symm]
    rw [hα]
    exact e.symm_apply_apply _
  exact CFSG.StandardType.exists_mulVec_map_eq_smul_of_primeFormPsi_apply_eq h hN1 hCg hCa
    A φ hvv tG htG hfix

private theorem field_eq_refl {F : Type} [Field F] [Finite F] [CharP F 2]
    {K : Type} [Group K] [Finite K] {N f : ℕ}
    (hσ : ∀ c, unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c)
    (hN1 : 1 ≤ N) {Φ : SU (unitaryInvolution F 2 f) N →* K}
    (h : UnitaryFieldData 2 f F) {C : GL (Fin N) F}
    (hCg : IsPrimeFormGram C) (hCa : (C : Matrix (Fin N) (Fin N) F) = antidiag N)
    (e : primeFormP h (C : Matrix (Fin N) (Fin N) F) ≃* Φ.range)
    (he : ∀ (g : gramSU h (C : Matrix (Fin N) (Fin N) F))
      (g' : SU (unitaryInvolution F 2 f) N),
      (g : GL (Fin N) F) = (g' : GL (Fin N) F) →
        e (g : primeFormP h (C : Matrix (Fin N) (Fin N) F)) = Φ.rangeRestrict g')
    (hSU : SU (unitaryInvolution F 2 f) N = gramSU h (C : Matrix (Fin N) (Fin N) F))
    {W : Subgroup K} {p₁ p₂ : Fin N → F}
    (hind : ∀ a b : F, a • p₁ + b • p₂ = 0 → a = 0 ∧ b = 0)
    (hp₂ : uForm (unitaryInvolution F 2 f) p₂ p₂ = 0)
    (hp₁ : ∀ c : F, uForm (unitaryInvolution F 2 f) (p₁ + c • p₂) (p₁ + c • p₂) = 0)
    (hcomm : ∀ (v : Fin N → F), (v = p₂ ∨ ∃ c : F, v = p₁ + c • p₂) →
      ∀ {T : Subgroup (SU (unitaryInvolution F 2 f) N)},
        IsUTransGroup (unitaryInvolution F 2 f) v T →
          ∀ a ∈ W, ∀ b ∈ T.map Φ, a * b = b * a)
    {w : K} (hwW : w ∈ W) (hwN : w ∈ Subgroup.normalizer (Φ.range : Set K))
    {A : primeFormUnitary h (C : Matrix (Fin N) (Fin N) F)} {φ : F ≃+* F}
    (hβ : primeFormPsi h hCg ⟨A, φ⟩ =
      MulAut.congr e.symm (Φ.range.normalizerMonoidHom ⟨w, hwN⟩)) :
    φ = RingEquiv.refl F := by
  have hsmul : ∀ (v : Fin N → F), (v = p₂ ∨ ∃ c : F, v = p₁ + c • p₂) → ∃ μ : F,
      ((A : GL (Fin N) F) : Matrix (Fin N) (Fin N) F) *ᵥ (fun i => φ (v i)) = μ • v := by
    intro v hv
    have hvv : uForm (unitaryInvolution F 2 f) v v = 0 := by
      rcases hv with rfl | ⟨c, rfl⟩
      · exact hp₂
      · exact hp₁ c
    exact exists_smul_of_fixed_transvection hσ hN1 h hCg hCa e he hSU hcomm hwW hwN hβ hv hvv
  exact CFSG.LinearAlgebra.ringEquiv_eq_refl_of_forall_exists_smul (A : GL (Fin N) F) φ hind
    (hsmul p₂ (Or.inl rfl)) (fun c => hsmul (p₁ + c • p₂) (Or.inr ⟨c, rfl⟩))

private theorem mem_of_mem_W {F : Type} [Field F] [Finite F] [CharP F 2]
    {K : Type} [Group K] [Finite K] {N f : ℕ}
    {Φ : SU (unitaryInvolution F 2 f) N →* K}
    (hσ : ∀ c, unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c)
    (hN3 : 3 ≤ N) (hq : ¬(N = 3 ∧ 2 ^ f = 2))
    (h : UnitaryFieldData 2 f F) {C : GL (Fin N) F}
    (hCg : IsPrimeFormGram C) (hCa : (C : Matrix (Fin N) (Fin N) F) = antidiag N)
    (e : primeFormP h (C : Matrix (Fin N) (Fin N) F) ≃* Φ.range)
    (he : ∀ (g : gramSU h (C : Matrix (Fin N) (Fin N) F))
      (g' : SU (unitaryInvolution F 2 f) N),
      (g : GL (Fin N) F) = (g' : GL (Fin N) F) →
        e (g : primeFormP h (C : Matrix (Fin N) (Fin N) F)) = Φ.rangeRestrict g')
    (hSU : SU (unitaryInvolution F 2 f) N = gramSU h (C : Matrix (Fin N) (Fin N) F))
    (hC : Subgroup.centralizer (Φ.range : Set K) = ⊥)
    {W : Subgroup K} (hWN : W ≤ Subgroup.normalizer (Φ.range : Set K))
    (hW2 : IsPGroup 2 W) {p₁ p₂ : Fin N → F}
    (hind : ∀ a b : F, a • p₁ + b • p₂ = 0 → a = 0 ∧ b = 0)
    (hp₂ : uForm (unitaryInvolution F 2 f) p₂ p₂ = 0)
    (hp₁ : ∀ c : F,
      uForm (unitaryInvolution F 2 f) (p₁ + c • p₂) (p₁ + c • p₂) = 0)
    (hcomm : ∀ (v : Fin N → F), (v = p₂ ∨ ∃ c : F, v = p₁ + c • p₂) →
      ∀ {T : Subgroup (SU (unitaryInvolution F 2 f) N)},
        IsUTransGroup (unitaryInvolution F 2 f) v T →
          ∀ a ∈ W, ∀ b ∈ T.map Φ, a * b = b * a) :
    W ≤ Φ.range := by
  intro w hwW
  have hwN : w ∈ Subgroup.normalizer (Φ.range : Set K) := hWN hwW
  let α : MulAut Φ.range := Φ.range.normalizerMonoidHom ⟨w, hwN⟩
  let β : MulAut (primeFormP h (C : Matrix (Fin N) (Fin N) F)) := MulAut.congr e.symm α
  obtain ⟨⟨A, φ⟩, hAφ⟩ := primeFormPsi_surjective h hCg hN3 hq β
  have hφ : φ = RingEquiv.refl F :=
    field_eq_refl (f := f) hσ (by omega) h hCg hCa e he hSU hind hp₂ hp₁ hcomm hwW hwN hAφ
  subst φ
  have hAφ' : primeFormConjHom h (C : Matrix (Fin N) (Fin N) F) A = β := by
    rw [← hAφ, primeFormPsi_apply h hCg]
    rw [show primeFormFieldHom h hCg (RingEquiv.refl F) = 1 from map_one _]
    rw [mul_one]
  obtain ⟨k, hk⟩ := hW2 ⟨w, hwW⟩
  have hwpow : w ^ 2 ^ k = 1 := by
    simpa using congrArg Subtype.val hk
  refine CFSG.SeitzReduction.UnitaryPilot.mem_of_forall_map_primeFormConjHom_eq h e
    (by simpa using hC) A hwpow ?_
  intro z
  have hβapply : (e ((MulAut.congr e.symm α) z) : K) = w * (e z : K) * w⁻¹ := by
    rw [MulAut.congr_apply]
    simp only [MulEquiv.trans_apply, MulEquiv.symm_symm]
    rw [e.apply_symm_apply]
    simpa [α] using Subgroup.normalizerMonoidHom_apply_apply_coe Φ.range ⟨w, hwN⟩ (e z)
  rw [hAφ']
  exact hβapply

theorem IsSUImage.le_of_isRootTypeTI {K : Type} [Group K] [Finite K] {X₀ : Subgroup K}
    {Δ : Set (Subgroup K)} {f N : ℕ} {hf : 1 ≤ f} {hN : 2 ≤ N}
    (hX : IsSUImage X₀ Δ f N hf hN) (hf2 : 2 ≤ f) (hN4 : 4 ≤ N)
    (hC : Subgroup.centralizer (X₀ : Set K) = ⊥) {W : Subgroup K}
    (hWN : W ≤ Subgroup.normalizer (X₀ : Set K))
    (hWΔ : ∃ k : K, conjSubgroup k W ∈ Δ) (hW : Tim78.IsRootTypeTI W) : W ≤ X₀ := by
  classical
  obtain ⟨Φ, hker, hrange, hΔ⟩ := hX
  subst hrange
  let F := GaloisField 2 (2 * f)
  let σ : F ≃+* F := unitaryInvolution F 2 f
  let hF : Nat.card F = (2 ^ f) ^ 2 := card_galoisField_two_mul hf
  let hσ : ∀ c, σ (σ c) = c := unitaryInvolution_involutive hF
  let h : UnitaryFieldData 2 f F := RootDetectSU.unitaryFieldData_two hF hf
  let htr : ∀ a, σ a = a → ∃ c, c + σ c = a :=
    fun a ha => exists_add_unitaryInvolution_eq hF ha
  let hnorm : ∀ d, σ d = d → ∃ l, σ l * l = d :=
    fun d hd => exists_sigma_mul_self_eq hF hd
  let C : GL (Fin N) F :=
    ⟨antidiag N, antidiag N, antidiag_mul_antidiag, antidiag_mul_antidiag⟩
  have hCa : (C : Matrix (Fin N) (Fin N) F) = antidiag N := rfl
  have hCg : IsPrimeFormGram C := RootDetectSU.isPrimeFormGram_of_eq_antidiag hCa
  have hΔ' : ∀ U : Subgroup K, U ∈ Δ ↔ ∃ x : SU σ N,
      U = (conjSub (Unitary.rootGroup σ hσ N (unitaryLongRoot N hN)) x).map Φ := hΔ
  have hker_eq : Φ.ker = Subgroup.center (SU σ N) :=
    CFSG.GroupTheory.ker_eq_center_of_centralizer_range_eq_bot hker (by simpa using hC)
  have hcard : Nat.card (traceZero σ) = 2 ^ f := CFSG.Timmesfeld.LieEmbed.card_traceZero hF
  obtain ⟨hcardW, hW2, hsqW⟩ := W_data hσ hΔ' hker hcard hWΔ
  have hq : ¬(N = 3 ∧ 2 ^ f = 2) := fun h => by omega
  obtain ⟨e, he⟩ :=
    CFSG.StandardType.exists_mulEquiv_primeFormP_range h (by omega) hq hCa hker_eq
  have hSU : SU σ N = gramSU h (C : Matrix (Fin N) (Fin N) F) := by
    rw [hCa]
    exact RootDetectSU.SU_eq_gramSU_antidiag h
  have hInf : W ⊓ Φ.range ≠ ⊥ :=
    inf_ne_bot hf2 (by omega) h hCg e (by simpa using hC) hWN hW2 hsqW hcardW
  obtain ⟨⟨u, hu⟩, hu1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hInf
  have huW : u ∈ W := (Subgroup.mem_inf.mp hu).1
  have huX : u ∈ Φ.range := (Subgroup.mem_inf.mp hu).2
  have hu_ne : u ≠ 1 := fun h => hu1 (Subtype.ext h)
  obtain ⟨x, hxΦ, hx2⟩ := exists_involution_lift hker huX (hsqW u huW)
  have hxne : x ≠ 1 := fun h => hu_ne (by rw [← hxΦ, h, map_one])
  obtain ⟨p₁, p₂, hind, hp₂iso, hp₁iso, hp₂fix, hp₁fix⟩ :=
    exists_plane hσ htr hnorm hN4 hx2 hxne
  have hcomm : ∀ (v : Fin N → F), (v = p₂ ∨ ∃ c : F, v = p₁ + c • p₂) →
      ∀ {T : Subgroup (SU σ N)}, IsUTransGroup σ v T →
        ∀ a ∈ W, ∀ b ∈ T.map Φ, a * b = b * a := by
    intro v hv T hT
    have hvv : uForm σ v v = 0 := by
      rcases hv with rfl | ⟨c, rfl⟩
      · exact hp₂iso
      · exact hp₁iso c
    have hv0 : v ≠ 0 := by
      rcases hv with rfl | ⟨c, rfl⟩
      · intro h
        exact one_ne_zero (hind 0 1 (by simpa [h])).2
      · intro h
        exact one_ne_zero (hind 1 c (by simpa [h])).1
    have hxv : suMat σ N x *ᵥ v = v := by
      rcases hv with rfl | ⟨c, rfl⟩
      · exact hp₂fix
      · exact hp₁fix c
    exact commute_map_of_fixed hσ htr hΔ' hW hWΔ huW hu_ne hv0 hvv hT hxΦ hxv
  exact mem_of_mem_W hσ (by omega) hq h hCg hCa e he hSU (by simpa using hC) hWN hW2
    hind hp₂iso hp₁iso hcomm

