private theorem mul_comm_of_map_commutatorElement_eq_one {R M : Type*} [Group R] [Monoid M]
    (f : R →* M) {x y : R}
    (h : f ⁅x, y⁆ = 1) : f x * f y = f y * f x := by
  rw [commutatorElement_def] at h
  have h1 : f x * f y * f x⁻¹ * f y⁻¹ = 1 := by
    simpa only [map_mul, map_inv] using h
  have hx : f x⁻¹ * f x = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  have hy : f y⁻¹ * f y = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  have h2 : f x * f y * f x⁻¹ = f y := by
    have h' := congrArg (fun z => z * f y) h1
    simpa only [mul_assoc, hy, mul_one, one_mul] using h'
  have h3 : f x * f y = f y * f x := by
    have h' := congrArg (fun z => z * f x) h2
    simpa only [mul_assoc, hx, mul_one, one_mul] using h'
  exact h3

private theorem secHyp_p0 (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) :
    SecHyp (M ⊓ cenOf (A ⊔ B)) (p0Of M V (A ⊔ B)) (p0Of M V (A ⊔ B)) V := by
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hPM : Pc M V ≤ M := hS.sec5.toRootHyp.toHyp.Pc_le_M
  have hP0M : p0Of M V (A ⊔ B) ≤ M := inf_le_left.trans hPM
  have hP0K : p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B) := le_inf hP0M inf_le_right
  have hKnormP0 : M ⊓ cenOf (A ⊔ B) ≤
      Subgroup.normalizer (p0Of M V (A ⊔ B) : Set G) := by
    intro r hr
    obtain ⟨hrM, hrC⟩ := Subgroup.mem_inf.mp hr
    rw [mem_normalizer_iff_conjSubgroup_eq]
    have hP : conjSubgroup r (Pc M V) = Pc M V :=
      conjSubgroup_eq_self_iff.mpr (hS.sec5.toRootHyp.toHyp.le_normalizer_Pc hrM)
    have hX : conjSubgroup r (A ⊔ B) = A ⊔ B := by
      rw [conjSubgroup_eq_self_iff]
      exact Subgroup.centralizer_le_normalizer _ hrC
    have hCen : conjSubgroup r (cenOf (A ⊔ B)) = cenOf (A ⊔ B) := by
      rw [← centralizer_conjSubgroup_eq r (A ⊔ B), hX]
    rw [p0Of, conjSubgroup_inf, hP, hCen]
  refine
    { le := L2Datum.V_le_p0 hS.toSec6Hyp hD
      le_R := hP0K
      conj_E := fun r hr e he => (Subgroup.mem_normalizer_iff.mp (hKnormP0 hr) e).mp he
      conj_A := fun r hr x hx =>
        (Subgroup.mem_normalizer_iff.mp
          (hS.sec5.toRootHyp.toHyp.le_normalizer (Subgroup.mem_inf.mp hr).1) x).mp hx
      comm := fun x hx y hy => ?_
      sq := fun x hx => hS5 x hx
      ker := fun k hk e he => ?_ }
  · have h := Subgroup.commutator_mem_commutator hx hy
    rwa [hS3] at h
  · have h := Subgroup.commutator_mem_commutator hk he
    rwa [hS3] at h

private theorem fixed_commutator_mem_V {C D : Subgroup G}
    {hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B)}
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    {e : ↥((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))}
    (hw : ∀ a : SL(2, F),
      ((secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
        ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)) a
        (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
          (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) e) =
      secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) e)
    {c : G} (hc : c ∈ C ⊔ D) :
    ⁅((e : ↥(M ⊓ cenOf (A ⊔ B))) : G), c⁆ ∈ V := by
  have hfixed := hw (φ ⟨c, hc⟩)
  have hkey : φ.symm.toMonoidHom (φ ⟨c, hc⟩) = ⟨c, hc⟩ := MulEquiv.symm_apply_apply φ _
  rw [MonoidHom.comp_apply, MonoidHom.comp_apply, hkey] at hfixed
  rw [show (Subgroup.inclusion hCDK) ⟨c, hc⟩ = ⟨c, hCDK hc⟩ from rfl] at hfixed
  have h2 := secRep_sub_secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hCDK hc⟩ e
  rw [hfixed, sub_self] at h2
  let E : Subgroup ↥(M ⊓ cenOf (A ⊔ B)) :=
    (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))
  let x : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨c, hCDK hc⟩
  have h3 : ((secConj E x e * e⁻¹ : E) : ↥(M ⊓ cenOf (A ⊔ B))) ∈
      V.subgroupOf (M ⊓ cenOf (A ⊔ B)) :=
    (secMk_eq_zero_iff E (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) _).mp h2.symm
  have h4 : ⁅c, ((e : ↥(M ⊓ cenOf (A ⊔ B))) : G)⁆ ∈ V := by
    have h := Subgroup.mem_subgroupOf.mp h3
    simpa [coe_secConj, commutatorElement_def, x] using h
  rw [← commutatorElement_inv] at h4
  simpa using V.inv_mem h4

private theorem fixedSub_rho_bot (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V)
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)))
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    (ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))))
    (hρ : ρ = (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
      ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)) :
    fixedSub ρ ⊤ = ⊥ := by
  subst h4
  rw [hρ, eq_bot_iff]
  intro w hw
  obtain ⟨e, rfl⟩ :=
    secMk_surjective ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) w
  have hxP0 : (((e : ↥(M ⊓ cenOf (A ⊔ B))) : G)) ∈ p0Of M V (A ⊔ B) := e.2
  have heC : ∀ c ∈ C, ⁅((e : ↥(M ⊓ cenOf (A ⊔ B))) : G), c⁆ ∈ V := fun c hc =>
    fixed_commutator_mem_V (C := C) (D := D) (hCDK := hCDK) φ
      (fun a => mem_fixedSub.mp hw a (Subgroup.mem_top _)) (Subgroup.mem_sup_left hc)
  have heD : ∀ d ∈ D, ⁅((e : ↥(M ⊓ cenOf (A ⊔ B))) : G), d⁆ ∈ V := fun d hd =>
    fixed_commutator_mem_V (C := C) (D := D) (hCDK := hCDK) φ
      (fun a => mem_fixedSub.mp hw a (Subgroup.mem_top _)) (Subgroup.mem_sup_right hd)
  have hcomm : ∀ r ∈ C ⊔ D, ⁅((e : ↥(M ⊓ cenOf (A ⊔ B))) : G), r⁆ ∈ V :=
    Sec6Hyp.commutator_mem_of_mem_sup (H₁ := C) (H₂ := D) hS.toSec6Hyp
      (hS.sec5.le_M_of_mem_sigmaSet hC).1 (hS.sec5.le_M_of_mem_sigmaSet hD').1 heC heD
  have hxV : ((e : ↥(M ⊓ cenOf (A ⊔ B))) : G) ∈ V :=
    L2Datum.mem_V_of_commutator_mem hS h72 hD rfl hC hD' hR0 hg hxP0 fun r hr => by
      have h := hcomm r hr
      rw [← commutatorElement_inv] at h
      simpa using V.inv_mem h
  have hzero : secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) e = 0 := by
    rw [secMk_eq_zero_iff]
    exact Subgroup.mem_subgroupOf.mpr hxV
  simpa using hzero


private theorem quadratic_rho (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B))
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    (hCφ : (C.subgroupOf (C ⊔ D)).map φ.toMonoidHom = utri F)
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    (ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))))
    (hρ : ρ = (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
      ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)) :
    ∀ a ∈ utri F, ∀ b ∈ utri F, (ρ a - 1) ∘ₗ (ρ b - 1) = 0 := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  obtain ⟨hquadC, -⟩ := L2Datum.p0_quadratic hS h72 hD rfl hC hD' hCDX
  subst hρ
  intro a ha b hb
  have hca_mem : φ.symm a ∈ C.subgroupOf (C ⊔ D) := by
    have h : a ∈ (C.subgroupOf (C ⊔ D)).map φ.toMonoidHom := by rw [hCφ]; exact ha
    obtain ⟨c, hc, rfl⟩ := Subgroup.mem_map.mp h
    simpa using hc
  have hcb_mem : φ.symm b ∈ C.subgroupOf (C ⊔ D) := by
    have h : b ∈ (C.subgroupOf (C ⊔ D)).map φ.toMonoidHom := by rw [hCφ]; exact hb
    obtain ⟨c, hc, rfl⟩ := Subgroup.mem_map.mp h
    simpa using hc
  have hca : ((φ.symm a : ↥(C ⊔ D)) : G) ∈ C := Subgroup.mem_subgroupOf.mp hca_mem
  have hcb : ((φ.symm b : ↥(C ⊔ D)) : G) ∈ C := Subgroup.mem_subgroupOf.mp hcb_mem
  let ca : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨((φ.symm a : ↥(C ⊔ D)) : G), hCDK (φ.symm a).2⟩
  let cb : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨((φ.symm b : ↥(C ⊔ D)) : G), hCDK (φ.symm b).2⟩
  have hquad : (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ca - 1) ∘ₗ
      (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) cb - 1) = 0 := by
    refine secRep_quadratic _ _ ?_
    intro x hx
    have hxP0 : (x : G) ∈ p0Of M V (A ⊔ B) := hx
    have hmem : ⁅((φ.symm b : ↥(C ⊔ D)) : G), (x : G)⁆ ∈ ⁅p0Of M V (A ⊔ B), C⁆ := by
      have h := Subgroup.commutator_mem_commutator hcb hxP0
      rwa [Subgroup.commutator_comm] at h
    have h1 : ⁅((φ.symm a : ↥(C ⊔ D)) : G),
        ⁅((φ.symm b : ↥(C ⊔ D)) : G), (x : G)⁆⁆ = 1 :=
      hquadC _ hca _ hmem
    refine Subgroup.mem_subgroupOf.mpr ?_
    have heq : (((ca * (cb * x * cb⁻¹ * x⁻¹) * ca⁻¹ * (cb * x * cb⁻¹ * x⁻¹)⁻¹ :
        ↥(M ⊓ cenOf (A ⊔ B))) : G)) =
        ⁅((φ.symm a : ↥(C ⊔ D)) : G),
          ⁅((φ.symm b : ↥(C ⊔ D)) : G), (x : G)⁆⁆ := by
      simp only [ca, cb, Subgroup.coe_mul, Subgroup.coe_inv, commutatorElement_def]
    rw [heq, h1]
    exact V.one_mem
  change (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ca - 1) ∘ₗ
    (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) cb - 1) = 0
  exact hquad

private theorem secRep_fixed_of_mem_commutator {C D T : Subgroup G}
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    {U : Subgroup (SL(2, F))}
    (hφ : (T.subgroupOf (C ⊔ D)).map φ.toMonoidHom = U)
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    {HC : Subgroup G} (hquad : ∀ c ∈ T, ∀ e ∈ HC, ⁅c, e⁆ = 1)
    {z : G} (hz : z ∈ HC) (hzK : z ∈ M ⊓ cenOf (A ⊔ B))
    (hzP0 : z ∈ p0Of M V (A ⊔ B)) (a : SL(2, F)) (ha : a ∈ U) :
    secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
      ⟨((φ.symm a : ↥(C ⊔ D)) : G), hCDK (φ.symm a).2⟩
      (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
        ⟨⟨z, hzK⟩, Subgroup.mem_subgroupOf.mpr hzP0⟩) =
    secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
      ⟨⟨z, hzK⟩, Subgroup.mem_subgroupOf.mpr hzP0⟩ := by
  set E : Subgroup ↥(M ⊓ cenOf (A ⊔ B)) :=
    (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))
  set A' : Subgroup ↥(M ⊓ cenOf (A ⊔ B)) := V.subgroupOf (M ⊓ cenOf (A ⊔ B))
  have hca_mem : φ.symm a ∈ T.subgroupOf (C ⊔ D) := by
    have h : a ∈ (T.subgroupOf (C ⊔ D)).map φ.toMonoidHom := by rw [hφ]; exact ha
    obtain ⟨c, hc, rfl⟩ := Subgroup.mem_map.mp h
    simpa using hc
  have hca : ((φ.symm a : ↥(C ⊔ D)) : G) ∈ T := Subgroup.mem_subgroupOf.mp hca_mem
  let caK : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨((φ.symm a : ↥(C ⊔ D)) : G), hCDK (φ.symm a).2⟩
  let x1 : ↥E := ⟨⟨z, hzK⟩, Subgroup.mem_subgroupOf.mpr hzP0⟩
  change secRep E A' caK (secMk E A' x1) = secMk E A' x1
  have hq := hquad _ hca z hz
  have hmemV : (((secConj E caK x1 * x1⁻¹ : E) : ↥(M ⊓ cenOf (A ⊔ B))) : G) ∈ V := by
    rw [show (((secConj E caK x1 * x1⁻¹ : E) : ↥(M ⊓ cenOf (A ⊔ B))) : G) =
        ⁅((φ.symm a : ↥(C ⊔ D)) : G), z⁆ from by
      simp only [coe_secConj, caK, x1, Subgroup.coe_mul, Subgroup.coe_inv,
        commutatorElement_def]]
    rw [hq]
    exact V.one_mem
  have hzero : secMk E A' (secConj E caK x1 * x1⁻¹) = 0 :=
    (secMk_eq_zero_iff E A' _).mpr (Subgroup.mem_subgroupOf.mpr hmemV)
  have h2 := secRep_sub_secMk E A' caK x1
  rw [hzero] at h2
  exact sub_eq_zero.mp h2

private theorem exists_mul_of_mem_p0_commutators (hS : Sec7Hyp M V n f)
    (h72 : Sec7.Stmt72 M V n f) (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B))
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)))
    {x : G} (hx : x ∈ p0Of M V (A ⊔ B)) :
    ∃ z1 ∈ ⁅p0Of M V (A ⊔ B), C⁆, ∃ z2 ∈ ⁅p0Of M V (A ⊔ B), D⁆,
      z1 * z2 = x ∧ z1 ∈ M ⊓ cenOf (A ⊔ B) ∧ z2 ∈ M ⊓ cenOf (A ⊔ B) ∧
        z1 ∈ p0Of M V (A ⊔ B) ∧ z2 ∈ p0Of M V (A ⊔ B) := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hCX : C ≤ cenOf (A ⊔ B) := (le_sup_left : C ≤ C ⊔ D).trans hCDX
  have hDX : D ≤ cenOf (A ⊔ B) := (le_sup_right : D ≤ C ⊔ D).trans hCDX
  have hP0K : p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B) :=
    le_inf (inf_le_left.trans hS.sec5.toRootHyp.toHyp.Pc_le_M) inf_le_right
  have hHCleP0 : ⁅p0Of M V (A ⊔ B), C⁆ ≤ p0Of M V (A ⊔ B) := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hC hCX]
    exact L2Datum.commutator_Pc_le_p0 hS.toSec6Hyp hD hC hCX
  have hHDleP0 : ⁅p0Of M V (A ⊔ B), D⁆ ≤ p0Of M V (A ⊔ B) := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hD' hDX]
    exact L2Datum.commutator_Pc_le_p0 hS.toSec6Hyp hD hD' hDX
  have hP0eq : p0Of M V (A ⊔ B) = ⁅p0Of M V (A ⊔ B), C⁆ ⊔ ⁅p0Of M V (A ⊔ B), D⁆ :=
    L2Datum.p0_eq_commutator_sup hS h72 hD rfl hC hD' hCDX hR0 hg
  have hP0nHD : p0Of M V (A ⊔ B) ≤
      Subgroup.normalizer ((⁅p0Of M V (A ⊔ B), D⁆ : Subgroup G) : Set G) :=
    L2Datum.p0_le_normalizer_commutator hS h72 hD rfl hD' hDX
  let HC : Subgroup G := ⁅p0Of M V (A ⊔ B), C⁆
  let HD : Subgroup G := ⁅p0Of M V (A ⊔ B), D⁆
  have hHCnHD : HC ≤ Subgroup.normalizer (HD : Set G) := by
    show ⁅p0Of M V (A ⊔ B), C⁆ ≤
      Subgroup.normalizer ((⁅p0Of M V (A ⊔ B), D⁆ : Subgroup G) : Set G)
    exact hHCleP0.trans hP0nHD
  have hxsup : x ∈ HC ⊔ HD := by
    show x ∈ ⁅p0Of M V (A ⊔ B), C⁆ ⊔ ⁅p0Of M V (A ⊔ B), D⁆
    rw [← hP0eq]; exact hx
  have hxmem : x ∈ (HC : Set G) * (HD : Set G) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right HC HD hHCnHD]
    exact hxsup
  obtain ⟨z1, hz1, z2, hz2, hz12⟩ := hxmem
  have hz1' : z1 ∈ ⁅p0Of M V (A ⊔ B), C⁆ := by simpa [HC] using hz1
  have hz2' : z2 ∈ ⁅p0Of M V (A ⊔ B), D⁆ := by simpa [HD] using hz2
  exact ⟨z1, hz1', z2, hz2', hz12, hP0K (hHCleP0 hz1'), hP0K (hHDleP0 hz2'),
    hHCleP0 hz1', hHDleP0 hz2'⟩


private theorem span_fixedSub (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B))
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)))
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    (hCφ : (C.subgroupOf (C ⊔ D)).map φ.toMonoidHom = utri F)
    (hDφ : (D.subgroupOf (C ⊔ D)).map φ.toMonoidHom = ltri F)
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    (ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))))
    (hρ : ρ = (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
      ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)) :
    fixedSub ρ (utri F) ⊔ fixedSub ρ (ltri F) = ⊤ := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  obtain ⟨hquadC, hquadD⟩ := L2Datum.p0_quadratic hS h72 hD rfl hC hD' hCDX
  have hP0M : p0Of M V (A ⊔ B) ≤ M :=
    inf_le_left.trans hS.sec5.toRootHyp.toHyp.Pc_le_M
  have hP0K : p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B) := le_inf hP0M inf_le_right
  set E : Subgroup ↥(M ⊓ cenOf (A ⊔ B)) :=
    (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))
  set A' : Subgroup ↥(M ⊓ cenOf (A ⊔ B)) := V.subgroupOf (M ⊓ cenOf (A ⊔ B))
  set HC : Subgroup G := ⁅p0Of M V (A ⊔ B), C⁆
  set HD : Subgroup G := ⁅p0Of M V (A ⊔ B), D⁆
  subst hρ
  rw [eq_top_iff]
  intro w _
  obtain ⟨x, rfl⟩ := secMk_surjective E A' w
  have hxP0 : (x : G) ∈ p0Of M V (A ⊔ B) := x.2
  obtain ⟨z1, hz1, z2, hz2, hz12, hz1K, hz2K, hz1P0, hz2P0⟩ :=
    exists_mul_of_mem_p0_commutators hS h72 hD rfl hC hD' hCDX hR0 hg hxP0
  let x1 : ↥E := ⟨⟨z1, hz1K⟩, Subgroup.mem_subgroupOf.mpr hz1P0⟩
  let x2 : ↥E := ⟨⟨z2, hz2K⟩, Subgroup.mem_subgroupOf.mpr hz2P0⟩
  have hx12 : x = x1 * x2 := by
    apply Subtype.ext
    apply Subtype.ext
    simpa [x1, x2] using hz12.symm
  have hsplit : secMk E A' x = secMk E A' x1 + secMk E A' x2 := by
    rw [hx12, secMk_mul]
  have keyC : secMk E A' x1 ∈ fixedSub
      ((secRep E A').comp ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)) (utri F) := by
    rw [mem_fixedSub]
    intro a ha
    exact secRep_fixed_of_mem_commutator (C := C) (D := D) (T := C) (U := utri F)
      (F := F) φ hCφ hCDK hquadC hz1 hz1K hz1P0 a ha
  have keyD : secMk E A' x2 ∈ fixedSub
      ((secRep E A').comp ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)) (ltri F) := by
    rw [mem_fixedSub]
    intro b hb
    exact secRep_fixed_of_mem_commutator (C := C) (D := D) (T := D) (U := ltri F)
      (F := F) φ hDφ hCDK hquadD hz2 hz2K hz2P0 b hb
  rw [hsplit]
  exact Submodule.add_mem _ (Submodule.mem_sup_left keyC) (Submodule.mem_sup_right keyD)

private theorem nat_sum_transport {F : Type} {V : Type*} {W : Type}
    [Field F] [Fintype F] [CharP F 2]
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (ρ : Representation (ZMod 2) SL(2, F) W)
    (hnat : CFSG.RankThree.GF2n.Tim81.Sec2.IsNatSumModule ρ)
    (hW : Nat.card W = Nat.card V ^ 4) (hFcardV : Nat.card F = Nat.card V)
    (hV : Nat.card V = 2 ^ f) (hf : 1 ≤ f) :
    ∃ e : W ≃+ ((Fin 2 → F) × (Fin 2 → F)), ∀ a w, e (ρ a w) = slAct a (e w) := by
  obtain ⟨k, ψ, hψ⟩ := hnat
  have hW2 : Nat.card W = Nat.card F ^ (2 * k) := by
    calc Nat.card W = Nat.card (Fin k → Fin 2 → F) := Nat.card_congr ψ.toEquiv
      _ = (Nat.card F ^ 2) ^ k := by
        rw [Nat.card_fun, Nat.card_fun]
        simp [Nat.card_fin]
      _ = Nat.card F ^ (2 * k) := by rw [← pow_mul]
  have hq : 2 ≤ Nat.card F := by
    rw [hFcardV, hV]
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  have hk : k = 2 := by
    have h : Nat.card F ^ (2 * k) = Nat.card F ^ 4 := by
      rw [← hW2, hW, hFcardV]
    have h2k : 2 * k = 4 := Nat.pow_right_injective hq h
    omega
  subst hk
  refine ⟨ψ.trans (((LinearEquiv.finTwoArrow F) (Fin 2 → F))).toAddEquiv, ?_⟩
  intro a w
  apply Prod.ext
  · funext i; exact congrFun (hψ a w 0) i
  · funext i; exact congrFun (hψ a w 1) i

private theorem card_secMod_p0 (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4)
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    (hsec : SecHyp (M ⊓ cenOf (A ⊔ B)) (p0Of M V (A ⊔ B)) (p0Of M V (A ⊔ B)) V) :
    Nat.card (CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))) = Nat.card V ^ 4 := by
  subst h4
  obtain ⟨-, hS2, -, -, -, -, -, -, -, -⟩ := h72 A B h hD
  have hP0 : Nat.card ↥(p0Of M V (A ⊔ B)) = Nat.card V ^ 5 := by
    have h := hS2
    norm_num at h
    exact h
  have h := CFSG.Timmesfeld.Bridge.RootMany.card_secMod
    ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
  rw [hsec.card_E, hsec.card_A, hP0] at h
  refine Nat.mul_right_cancel (Nat.card_pos (α := V)) ?_
  rw [h]
  ring

private theorem exists_sigma_pair_swap (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hLP : UnitaryLinePair) (hD : L2Datum M V A B h) (h4 : n = 4) :
    ∃ (C D : Subgroup G) (g : ↥M), C ∈ sigmaSet M V ∧ D ∈ sigmaSet M V ∧
      C ⊔ D ≤ cenOf (A ⊔ B) ∧ IsL2Gen C D ∧
      r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B) ∧
      C ⊔ D ≤ M ⊓ cenOf (A ⊔ B) ∧
      p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B) ∧
      imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)) := by
  obtain ⟨-, -, -, -, -, -, -, -, -, hS10⟩ := h72 A B h hD
  obtain ⟨C, hC, D, hD', hCDX, hCDl2, hR0⟩ := hS10 h4
  obtain ⟨g, hg, -, -⟩ := L2Datum.exists_swap hS hLP hD h4
  have hCDM : C ⊔ D ≤ M := _root_.sup_le (hS.sec5.le_M_of_mem_sigmaSet hC).1
    (hS.sec5.le_M_of_mem_sigmaSet hD').1
  exact ⟨C, D, g, hC, hD', hCDX, hCDl2, hR0, le_inf hCDM hCDX,
    le_inf (inf_le_left.trans hS.sec5.toRootHyp.toHyp.Pc_le_M) inf_le_right, hg⟩

private theorem exists_nat_sum_equiv (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B))
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)))
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    (hCφ : (C.subgroupOf (C ⊔ D)).map φ.toMonoidHom = utri F)
    (hDφ : (D.subgroupOf (C ⊔ D)).map φ.toMonoidHom = ltri F)
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    (hsec : SecHyp (M ⊓ cenOf (A ⊔ B)) (p0Of M V (A ⊔ B)) (p0Of M V (A ⊔ B)) V)
    (ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))))
    (hρ : ρ = (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
      ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom))
    (hFcard : Nat.card F = Nat.card C) :
    ∃ e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F)),
      ∀ (a : SL(2, F)) (w : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))), e (ρ a w) = slAct a (e w) := by
  have hfix : fixedSub ρ ⊤ = ⊥ :=
    fixedSub_rho_bot hS h72 hD h4 hC hD' hR0 hg φ hCDK ρ hρ
  have hquad : ∀ a ∈ utri F, ∀ b ∈ utri F, (ρ a - 1) ∘ₗ (ρ b - 1) = 0 :=
    quadratic_rho hS h72 hD h4 hC hD' hCDX φ hCφ hCDK ρ hρ
  have hspan : fixedSub ρ (utri F) ⊔ fixedSub ρ (ltri F) = ⊤ :=
    span_fixedSub hS h72 hD h4 hC hD' hCDX hR0 hg φ hCφ hDφ hCDK ρ hρ
  have hnat : CFSG.RankThree.GF2n.Tim81.Sec2.IsNatSumModule ρ :=
    CFSG.RankThree.GF2n.Tim81.Sec2.isNatSumModule_of_fixedSub ρ hfix hquad hspan
  have hW : Nat.card (CFSG.Timmesfeld.Bridge.RootMany.SecMod
      ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))) = Nat.card V ^ 4 :=
    card_secMod_p0 h72 hD h4 hsec
  have hFcardV : Nat.card F = Nat.card V := hFcard.trans (by
    obtain ⟨x, rfl, -⟩ := hC
    rw [card_conjSubgroup])
  exact nat_sum_transport (V := ↥V) ρ hnat hW hFcardV hS.card_V hS.one_le

private theorem twist_comm_slAct {C D : Subgroup G}
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B))
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] (φ : ↥(C ⊔ D) ≃* SL(2, F))
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    (ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))))
    (hρ : ρ = (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
      ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom))
    {e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F))}
    (he : ∀ (a : SL(2, F)) (w : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))), e (ρ a w) = slAct a (e w))
    {c : G} (hcK : c ∈ M ⊓ cenOf (A ⊔ B))
    (hcr0 : ∀ r ∈ r0Of M V (A ⊔ B), ⁅c, r⁆ ∈ p0Of M V (A ⊔ B))
    (hsec : SecHyp (M ⊓ cenOf (A ⊔ B)) (p0Of M V (A ⊔ B)) (p0Of M V (A ⊔ B)) V)
    {T : ((Fin 2 → F) × (Fin 2 → F)) →+ ((Fin 2 → F) × (Fin 2 → F))}
    (hT : ∀ w, T w = e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm w))) :
    ∀ (a : SL(2, F)) (u : (Fin 2 → F) × (Fin 2 → F)), T (slAct a u) = slAct a (T u) := by
  intro a u
  let r : ↥(M ⊓ cenOf (A ⊔ B)) := Subgroup.inclusion hCDK (φ.symm a)
  have hρa : ρ a = secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) r := by
    rw [hρ]
    rfl
  have h1 : e.symm (slAct a u) = ρ a (e.symm u) := by
    apply e.injective
    rw [e.apply_symm_apply, he, e.apply_symm_apply]
  have hmem : ⁅(⟨c, hcK⟩ : ↥(M ⊓ cenOf (A ⊔ B))), r⁆ ∈
      (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)) := by
    rw [commutatorElement_def]
    refine Subgroup.mem_subgroupOf.mpr ?_
    have h := hcr0 ((φ.symm a : ↥(C ⊔ D)) : G) (by
      rw [hR0]
      exact Subgroup.mem_sup_left (φ.symm a).2)
    change c * ((φ.symm a : ↥(C ⊔ D)) : G) * c⁻¹ *
      (((φ.symm a : ↥(C ⊔ D)) : G))⁻¹ ∈ p0Of M V (A ⊔ B)
    simpa [r, commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv] using h
  have hone : secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⁅(⟨c, hcK⟩ : ↥(M ⊓ cenOf (A ⊔ B))), r⁆ = 1 := by
    rw [secRep_eq_one_iff]
    intro x hx
    exact hsec.ker _ hmem _ hx
  have hcomm : secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ *
        secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
          (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) r =
      secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
          (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) r *
        secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
          (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ :=
    mul_comm_of_map_commutatorElement_eq_one _ hone
  have h2 : secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (ρ a (e.symm u)) =
      ρ a (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm u)) := by
    rw [hρa]
    rw [← Module.End.mul_apply, ← Module.End.mul_apply, hcomm]
  calc T (slAct a u) =
      e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm (slAct a u))) := hT _
    _ = e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (ρ a (e.symm u))) := by rw [h1]
    _ = e (ρ a (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm u))) := by rw [h2]
    _ = slAct a (e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm u))) := he a _
    _ = slAct a (T u) := by rw [hT]

private theorem twist_iterate_pow (hS : Sec7Hyp M V n f)
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2]
    {e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F))}
    {c : G} (hcK : c ∈ M ⊓ cenOf (A ⊔ B))
    (hcpow : c ^ (2 ^ f + 1) ∈ p0Of M V (A ⊔ B))
    (hsec : SecHyp (M ⊓ cenOf (A ⊔ B)) (p0Of M V (A ⊔ B)) (p0Of M V (A ⊔ B)) V)
    (hFcardV : Nat.card F = Nat.card V)
    {T : ((Fin 2 → F) × (Fin 2 → F)) →+ ((Fin 2 → F) × (Fin 2 → F))}
    (hT : ∀ w, T w = e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm w))) :
    ∀ u, (⇑T)^[Fintype.card F + 1] u = u := by
  have hcpowK : (⟨c, hcK⟩ ^ (2 ^ f + 1) : ↥(M ⊓ cenOf (A ⊔ B))) ∈
      (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)) := by
    refine Subgroup.mem_subgroupOf.mpr ?_
    change c ^ (2 ^ f + 1) ∈ p0Of M V (A ⊔ B)
    simpa using hcpow
  have hLpow : (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩) ^ (2 ^ f + 1) = 1 := by
    rw [← map_pow]
    rw [secRep_eq_one_iff]
    intro x hx
    exact hsec.ker _ hcpowK _ hx
  have hFq : Fintype.card F = 2 ^ f := by
    rw [← Nat.card_eq_fintype_card, hFcardV, hS.card_V]
  intro u
  have hiter : ∀ (m : ℕ) (w : (Fin 2 → F) × (Fin 2 → F)),
      (⇑T)^[m] w = e ((secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ ^ m) (e.symm w)) := by
    intro m
    induction m with
    | zero => intro w; simp
    | succ m ih =>
        intro w
        rw [Function.iterate_succ_apply', ih, hT, e.symm_apply_apply, pow_succ']
        rfl
  rw [hFq, hiter, hLpow, Module.End.one_apply, e.apply_symm_apply]

private theorem twist_ne_one
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2]
    {e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F))}
    {c : G} (hcK : c ∈ M ⊓ cenOf (A ⊔ B))
    (hP0K : p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B))
    (hcx : ∃ x ∈ p0Of M V (A ⊔ B), ⁅c, x⁆ ∉ V)
    {T : ((Fin 2 → F) × (Fin 2 → F)) →+ ((Fin 2 → F) × (Fin 2 → F))}
    (hT : ∀ w, T w = e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm w))) :
    ∃ u, T u ≠ u := by
  obtain ⟨x, hxP0, hxne⟩ := hcx
  let xm : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨x, hP0K hxP0⟩
  let xe : ↥((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) :=
    ⟨xm, Subgroup.mem_subgroupOf.mpr hxP0⟩
  refine ⟨e (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xe), fun hcontra => ?_⟩
  have hLfix : secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩
        (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
          (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xe) =
      secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xe := by
    apply e.injective
    rw [hT, e.symm_apply_apply] at hcontra
    exact hcontra
  have h2 := secRep_sub_secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ xe
  rw [hLfix, sub_self] at h2
  have hmem : ((secConj ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ xe *
      xe⁻¹ : ↥((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))) : ↥(M ⊓ cenOf (A ⊔ B))) ∈
      V.subgroupOf (M ⊓ cenOf (A ⊔ B)) := (secMk_eq_zero_iff _ _ _).mp h2.symm
  exact hxne (by
    have h := Subgroup.mem_subgroupOf.mp hmem
    simpa [coe_secConj, xe, xm, Subgroup.coe_mul, Subgroup.coe_inv,
      commutatorElement_def] using h)

private theorem secSub_map_isSLInv_of_normalizer
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2] {C D : Subgroup G}
    (φ : ↥(C ⊔ D) ≃* SL(2, F))
    (hCDK : C ⊔ D ≤ M ⊓ cenOf (A ⊔ B))
    (ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))))
    (hρ : ρ = (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
      ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom))
    {e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F))}
    (he : ∀ (a : SL(2, F)) (w : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))), e (ρ a w) = slAct a (e w))
    {N : Subgroup G}
    (hKN : M ⊓ cenOf (A ⊔ B) ≤ Subgroup.normalizer (N : Set G))
    (U : AddSubgroup ((Fin 2 → F) × (Fin 2 → F)))
    (hU : U = (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map
        e.toAddMonoidHom) :
    CFSG.CGT.Timmesfeld75.IsSLInv U := by
  subst hU
  have hρa : ∀ a : SL(2, F), ρ a = secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (Subgroup.inclusion hCDK (φ.symm a)) := fun a => by
    rw [hρ]
    rfl
  intro a u hu
  obtain ⟨w, hw, rfl⟩ := AddSubgroup.mem_map.mp hu
  obtain ⟨x, hxN, rfl⟩ := (CFSG.Timmesfeld.Bridge.RootMany.mem_secSub
    (E := (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (A := V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (B := N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).mp hw
  change slAct a (e (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) x)) ∈
    (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map
      e.toAddMonoidHom
  rw [← he a]
  refine AddSubgroup.mem_map.mpr ⟨ρ a (secMk ((p0Of M V (A ⊔ B)).subgroupOf
    (M ⊓ cenOf (A ⊔ B))) (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) x), ?_, rfl⟩
  refine (CFSG.Timmesfeld.Bridge.RootMany.mem_secSub
    (E := (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (A := V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (B := N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).mpr
    ⟨secConj ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (Subgroup.inclusion hCDK (φ.symm a)) x, ?_, ?_⟩
  · exact Subgroup.mem_subgroupOf.mpr
      ((Subgroup.mem_normalizer_iff.mp (hKN (Subgroup.inclusion hCDK (φ.symm a)).2)
        ((x : ↥(M ⊓ cenOf (A ⊔ B))) : G)).mp (Subgroup.mem_subgroupOf.mp hxN))
  · rw [hρa a, secRep_mk]

private theorem secSub_map_stab_of_twist
    [hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
