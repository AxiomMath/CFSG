    (U : AddSubgroup ((Fin 2 → F) × (Fin 2 → F)))
    (hU : U = (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map
        e.toAddMonoidHom) :
    ∀ u ∈ U, T u ∈ U := by
  subst hU
  let cm : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨c, hcK⟩
  intro u hu
  obtain ⟨w, hw, rfl⟩ := AddSubgroup.mem_map.mp hu
  obtain ⟨x, hxN, rfl⟩ := (CFSG.Timmesfeld.Bridge.RootMany.mem_secSub
    (E := (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (A := V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (B := N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).mp hw
  refine AddSubgroup.mem_map.mpr ⟨secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (secConj ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) cm x), ?_, ?_⟩
  · have hxN' : ((secConj ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) cm x :
        ↥((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))) : ↥(M ⊓ cenOf (A ⊔ B))) ∈
        N.subgroupOf (M ⊓ cenOf (A ⊔ B)) :=
      Subgroup.mem_subgroupOf.mpr
        ((Subgroup.mem_normalizer_iff.mp (hKN hcK) ((x : ↥(M ⊓ cenOf (A ⊔ B))) : G)).mp
          (Subgroup.mem_subgroupOf.mp hxN))
    exact (CFSG.Timmesfeld.Bridge.RootMany.mem_secSub
      (E := (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (A := V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (B := N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).mpr
      ⟨secConj ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) cm x, hxN', rfl⟩
  · rw [hT]
    have hco : e.symm (e.toAddMonoidHom (secMk ((p0Of M V (A ⊔ B)).subgroupOf
        (M ⊓ cenOf (A ⊔ B))) (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) x)) =
        secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
          (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) x := e.symm_apply_apply _
