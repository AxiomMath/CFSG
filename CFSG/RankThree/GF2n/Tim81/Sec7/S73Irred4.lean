    {F : Type} [Field F] [Fintype F] [CharP F 2]
    (e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F)))
    (hP0K : p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B))
    {N : Subgroup G} (hVN : V ≤ N) (hNP : N ≤ p0Of M V (A ⊔ B))
    (hbot : (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map
        e.toAddMonoidHom = ⊥) :
    N = V := by
  refine le_antisymm ?_ hVN
  intro n hn
  let xE : ↥((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) :=
    ⟨⟨n, hP0K (hNP hn)⟩, Subgroup.mem_subgroupOf.mpr (hNP hn)⟩
  have hxE : secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xE ∈
      secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B))) :=
    (CFSG.Timmesfeld.Bridge.RootMany.mem_secSub
      (E := (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (A := V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (B := N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).mpr
      ⟨xE, Subgroup.mem_subgroupOf.mpr hn, rfl⟩
  have hmem : e (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xE) ∈
      (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map e.toAddMonoidHom :=
    AddSubgroup.mem_map.mpr ⟨_, hxE, rfl⟩
  rw [hbot, AddSubgroup.mem_bot] at hmem
  have hzero : secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xE = 0 := e.injective (by simpa using hmem)
  rw [secMk_eq_zero_iff] at hzero
  exact Subgroup.mem_subgroupOf.mp hzero

private theorem eq_p0_of_secSub_map_eq_top
    [hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal]
    [hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))))]
    {F : Type} [Field F] [Fintype F] [CharP F 2]
    (e : CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ≃+ ((Fin 2 → F) × (Fin 2 → F)))
    (hP0K : p0Of M V (A ⊔ B) ≤ M ⊓ cenOf (A ⊔ B))
    {N : Subgroup G} (hVN : V ≤ N) (hNP : N ≤ p0Of M V (A ⊔ B))
    (htop : (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map
        e.toAddMonoidHom = ⊤) :
    N = p0Of M V (A ⊔ B) := by
  refine le_antisymm hNP ?_
  intro x hx
  let xm : ↥(M ⊓ cenOf (A ⊔ B)) := ⟨x, hP0K hx⟩
  let xe : ↥((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))) :=
    ⟨xm, Subgroup.mem_subgroupOf.mpr hx⟩
  have hmem : e (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xe) ∈
      (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map e.toAddMonoidHom := by
    rw [htop]
    exact AddSubgroup.mem_top _
  obtain ⟨w, hw, hwU⟩ := AddSubgroup.mem_map.mp hmem
  obtain ⟨y, hyN, hyw⟩ := (CFSG.Timmesfeld.Bridge.RootMany.mem_secSub
    (E := (p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (A := V.subgroupOf (M ⊓ cenOf (A ⊔ B)))
    (B := N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).mp hw
  have hyx : secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) y =
      secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) xe := by
    apply e.injective
    have h1 : e (secMk ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) y) = e.toAddMonoidHom w := by
      rw [hyw]
      rfl
    exact h1.trans hwU
  rw [secMk_eq_secMk_iff] at hyx
  have hmemV : ((y : ↥(M ⊓ cenOf (A ⊔ B))) : G)⁻¹ * x ∈ V := Subgroup.mem_subgroupOf.mp hyx
  have hyN' : ((y : ↥(M ⊓ cenOf (A ⊔ B))) : G) ∈ N := Subgroup.mem_subgroupOf.mp hyN
  have hxN : ((y : ↥(M ⊓ cenOf (A ⊔ B))) : G)⁻¹ * x ∈ N := hVN hmemV
  have h := N.mul_mem hyN' hxN
  rwa [show ((y : ↥(M ⊓ cenOf (A ⊔ B))) : G) *
    (((y : ↥(M ⊓ cenOf (A ⊔ B))) : G)⁻¹ * x) = x by group] at h

theorem L2Datum.irred_four (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hLP : UnitaryLinePair) (hD : L2Datum M V A B h) (h4 : n = 4) :
    ∀ N : Subgroup G, V ≤ N → N ≤ p0Of M V (A ⊔ B) →
      M ⊓ cenOf (A ⊔ B) ≤ Subgroup.normalizer (N : Set G) →
      N = V ∨ N = p0Of M V (A ⊔ B) := by
  intro N hVN hNP hKN
  obtain ⟨C, D, g, hC, hD', hCDX, hCDl2, hR0, hCDK, hP0K, hg⟩ :=
    exists_sigma_pair_swap hS h72 hLP hD h4
  obtain ⟨F, hF, hFfin, hFchar, φ, hFcard, hCφ, hDφ⟩ := hCDl2
  letI := hF
  letI := hFfin
  letI := hFchar
  haveI : Fintype F := Fintype.ofFinite F
  have hsec : SecHyp (M ⊓ cenOf (A ⊔ B)) (p0Of M V (A ⊔ B)) (p0Of M V (A ⊔ B)) V :=
    secHyp_p0 hS h72 hD
  haveI hNE : ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal := hsec.normal_E
  haveI hNA : (V.subgroupOf (M ⊓ cenOf (A ⊔ B))).Normal := hsec.normal_A
  haveI hEl : Fact (IsElemSection ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))) := ⟨hsec.isElemSection⟩
  let ρ : Representation (ZMod 2) SL(2, F)
      (CFSG.Timmesfeld.Bridge.RootMany.SecMod
        ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))) :=
    (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B)))).comp
        ((Subgroup.inclusion hCDK).comp φ.symm.toMonoidHom)
  obtain ⟨e, he⟩ := exists_nat_sum_equiv hS h72 hD h4 hC hD' hCDX hR0 hg φ hCφ hDφ hCDK
    hsec ρ rfl hFcard
  obtain ⟨c, hcK, hcr0, hcpow, hcx⟩ := L2Datum.exists_twist hS h72 hLP hD h4
  let T : ((Fin 2 → F) × (Fin 2 → F)) →+ ((Fin 2 → F) × (Fin 2 → F)) :=
    e.toAddMonoidHom.comp
      ((secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
        (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩).toAddMonoidHom.comp
          e.symm.toAddMonoidHom)
  have hT : ∀ w, T w = e (secRep ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) ⟨c, hcK⟩ (e.symm w)) := fun w => rfl
  have hTcomm := twist_comm_slAct hR0 φ hCDK ρ rfl he hcK hcr0 hsec hT
  have hFcardV : Nat.card F = Nat.card V := hFcard.trans (by
    obtain ⟨x, rfl, -⟩ := hC
    rw [card_conjSubgroup])
  have hTpow := twist_iterate_pow hS hcK hcpow hsec hFcardV hT
  have hTne := twist_ne_one hcK hP0K hcx hT
  let U : AddSubgroup ((Fin 2 → F) × (Fin 2 → F)) :=
    (secSub ((p0Of M V (A ⊔ B)).subgroupOf (M ⊓ cenOf (A ⊔ B)))
      (V.subgroupOf (M ⊓ cenOf (A ⊔ B))) (N.subgroupOf (M ⊓ cenOf (A ⊔ B)))).toAddSubgroup.map
        e.toAddMonoidHom
  have hUInv := secSub_map_isSLInv_of_normalizer φ hCDK ρ rfl he hKN U rfl
  have hUStab := secSub_map_stab_of_twist hcK hKN hT U rfl
  have hNS := CFSG.GroupTheory.eq_bot_or_top_of_isSLInv_of_commute T hTcomm hTpow hTne
    hUInv hUStab
  rcases hNS with hbot | htop
  · exact Or.inl (eq_V_of_secSub_map_eq_bot e hP0K hVN hNP hbot)
  · exact Or.inr (eq_p0_of_secSub_map_eq_top e hP0K hVN hNP htop)


