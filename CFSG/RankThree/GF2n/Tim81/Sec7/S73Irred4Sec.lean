namespace CFSG.Timmesfeld.Bridge.RootMany

open scoped commutatorElement

variable {R : Type*} [Group R] (E A : Subgroup R) [A.Normal] [E.Normal]
  [hEs : Fact (IsElemSection E A)]

theorem secRep_sub_secMk (r : R) (e : E) :
    secRep E A r (secMk E A e) - secMk E A e = secMk E A (secConj E r e * e⁻¹) := by
  rw [secRep_mk, sub_eq_add_neg, ← secMk_inv, ← secMk_mul]

theorem secRep_quadratic {a b : R}
    (h : ∀ x ∈ E, a * (b * (x : R) * b⁻¹ * (x : R)⁻¹) * a⁻¹ *
      (b * (x : R) * b⁻¹ * (x : R)⁻¹)⁻¹ ∈ A) :
    (secRep E A a - 1) ∘ₗ (secRep E A b - 1) = 0 := by
  refine LinearMap.ext fun w => ?_
  obtain ⟨x, rfl⟩ := secMk_surjective E A w
  have h1 : (secRep E A b - 1) (secMk E A x) = secMk E A (secConj E b x * x⁻¹) := by
    rw [LinearMap.sub_apply, Module.End.one_apply, secRep_sub_secMk]
  rw [LinearMap.comp_apply, h1]
  have h2 : (secRep E A a - 1) (secMk E A (secConj E b x * x⁻¹)) =
      secMk E A (secConj E a (secConj E b x * x⁻¹) * (secConj E b x * x⁻¹)⁻¹) := by
    rw [LinearMap.sub_apply, Module.End.one_apply, secRep_sub_secMk]
  rw [h2]
  refine (secMk_eq_zero_iff E A _).mpr ?_
  simpa only [coe_secConj, Subgroup.coe_mul, Subgroup.coe_inv] using h (x : R) x.2
end CFSG.Timmesfeld.Bridge.RootMany

