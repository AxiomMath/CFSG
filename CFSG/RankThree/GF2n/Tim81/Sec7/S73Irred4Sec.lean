variable {G : Type} [Group G] [Finite G] {M V A B : Subgroup G} {h : G} {n f : ℕ}

theorem L2Datum.mem_V_of_commutator_mem (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V)
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)))
    {x : G} (hx : x ∈ p0Of M V (A ⊔ B)) (hcomm : ∀ r ∈ C ⊔ D, ⁅r, x⁆ ∈ V) :
    x ∈ V := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hAM : A ≤ M := (hS.sec5.le_M_of_mem_sigmaSet hD.memA).1
  have hBM : B ≤ M := (hS.sec5.le_M_of_mem_sigmaSet hD.memB).1
  have hPM : Pc M V ≤ M := hS.sec5.toRootHyp.toHyp.Pc_le_M
  have hP0M : p0Of M V (A ⊔ B) ≤ M := inf_le_left.trans hPM
  have hCM : C ≤ M := (hS.sec5.le_M_of_mem_sigmaSet hC).1
  have hDM : D ≤ M := (hS.sec5.le_M_of_mem_sigmaSet hD').1
  have hCDM : C ⊔ D ≤ M := _root_.sup_le hCM hDM
  have hxP0 : ∀ p ∈ p0Of M V (A ⊔ B), ⁅x, p⁆ ∈ V := by
    intro p hp
    have h := Subgroup.commutator_mem_commutator hx hp
    rwa [hS3] at h
  have hcomm' : ∀ r ∈ C ⊔ D, ⁅x, r⁆ ∈ V := fun r hr => by
    have h : ⁅r, x⁆ ∈ V := hcomm r hr
    rw [← commutatorElement_inv] at h
    simpa using V.inv_mem h
  have hxCD : ∀ r ∈ C ⊔ D, ⁅x, r⁆ ∈ V :=
    Sec6Hyp.commutator_mem_of_mem_sup (H₁ := C) (H₂ := D) hS.toSec6Hyp hCM hDM
      (fun c hc => hcomm' c (Subgroup.mem_sup_left hc))
      (fun d hd => hcomm' d (Subgroup.mem_sup_right hd))
  have hall : ∀ r ∈ C ⊔ D ⊔ p0Of M V (A ⊔ B), ⁅x, r⁆ ∈ V :=
    Sec6Hyp.commutator_mem_of_mem_sup (H₁ := C ⊔ D) (H₂ := p0Of M V (A ⊔ B))
      hS.toSec6Hyp hCDM hP0M hxCD hxP0
  have hxconj : x ∈ conjSubgroup (g : G) (p0Of M V (A ⊔ B)) := by
    refine (L2Datum.mem_conj_p0_iff hS h72 hD g hg (Subgroup.mem_inf.mp hx).1).mpr fun r hr => ?_
    have hr' : r ∈ C ⊔ D ⊔ p0Of M V (A ⊔ B) := by rwa [← hR0]
    have h : ⁅x, r⁆ ∈ V := hall r hr'
    rw [← commutatorElement_inv] at h
    simpa using V.inv_mem h
  have hxinf : x ∈ p0Of M V (A ⊔ B) ⊓ conjSubgroup (g : G) (p0Of M V (A ⊔ B)) :=
    Subgroup.mem_inf.mpr ⟨hx, hxconj⟩
  rwa [L2Datum.p0_inf_conj_p0 hS h72 hD rfl g hg] at hxinf

theorem L2Datum.p0_quadratic (hS : Sec7Hyp M V n f)
    (h72 : Sec7.Stmt72 M V n f) (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B)) :
    (∀ c ∈ C, ∀ e ∈ ⁅p0Of M V (A ⊔ B), C⁆, ⁅c, e⁆ = 1) ∧
      (∀ d ∈ D, ∀ e ∈ ⁅p0Of M V (A ⊔ B), D⁆, ⁅d, e⁆ = 1) := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hCX : C ≤ cenOf (A ⊔ B) := (le_sup_left : C ≤ C ⊔ D).trans hCDX
  have hDX : D ≤ cenOf (A ⊔ B) := (le_sup_right : D ≤ C ⊔ D).trans hCDX
  constructor
  · intro c hc e he
    have he' : e ∈ ⁅Pc M V, C⁆ := by
      rw [L2Datum.commutator_Pc_eq_p0 hS hD hS1 hC hCX]
      exact he
    rcases hS.toSec6Hyp.res.s513 M V hS.sec5 C hC C hC with ⟨-, hle⟩ | ⟨hL2, -⟩
    · have heC : e ∈ cenOf C := (Subgroup.mem_inf.mp (hle he')).2
      exact commutatorElement_eq_one_iff_mul_comm.mpr
        (Subgroup.mem_centralizer_iff.mp heC c hc)
    · exact (hL2.ne rfl).elim
  · intro d hd e he
    have he' : e ∈ ⁅Pc M V, D⁆ := by
      rw [L2Datum.commutator_Pc_eq_p0 hS hD hS1 hD' hDX]
      exact he
    rcases hS.toSec6Hyp.res.s513 M V hS.sec5 D hD' D hD' with ⟨-, hle⟩ | ⟨hL2, -⟩
    · have heD : e ∈ cenOf D := (Subgroup.mem_inf.mp (hle he')).2
      exact commutatorElement_eq_one_iff_mul_comm.mpr
        (Subgroup.mem_centralizer_iff.mp heD d hd)
    · exact (hL2.ne rfl).elim

theorem L2Datum.commutator_p0_inf_eq_V (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B))
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B)))
    (hquadC : ∀ c ∈ C, ∀ e ∈ ⁅p0Of M V (A ⊔ B), C⁆, ⁅c, e⁆ = 1)
    (hquadD : ∀ d ∈ D, ∀ e ∈ ⁅p0Of M V (A ⊔ B), D⁆, ⁅d, e⁆ = 1) :
    ⁅p0Of M V (A ⊔ B), C⁆ ⊓ ⁅p0Of M V (A ⊔ B), D⁆ = V := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hCX : C ≤ cenOf (A ⊔ B) := (le_sup_left : C ≤ C ⊔ D).trans hCDX
  have hDX : D ≤ cenOf (A ⊔ B) := (le_sup_right : D ≤ C ⊔ D).trans hCDX
  have hCM : C ≤ M := (hS.sec5.le_M_of_mem_sigmaSet hC).1
  have hDM : D ≤ M := (hS.sec5.le_M_of_mem_sigmaSet hD').1
  have hPM : Pc M V ≤ M := hS.sec5.toRootHyp.toHyp.Pc_le_M
  have hP0M : p0Of M V (A ⊔ B) ≤ M := inf_le_left.trans hPM
  have hCP0 : ⁅p0Of M V (A ⊔ B), C⁆ ≤ p0Of M V (A ⊔ B) := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hC hCX]
    exact L2Datum.commutator_Pc_le_p0 hS.toSec6Hyp hD hC hCX
  have hVleHC : V ≤ ⁅p0Of M V (A ⊔ B), C⁆ := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hC hCX]
    exact hS.sec5.V_le_commutator hC
  have hVleHD : V ≤ ⁅p0Of M V (A ⊔ B), D⁆ := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hD' hDX]
    exact hS.sec5.V_le_commutator hD'
  refine le_antisymm ?_ (le_inf hVleHC hVleHD)
  intro x hx
  have hxHC : x ∈ ⁅p0Of M V (A ⊔ B), C⁆ := (Subgroup.mem_inf.mp hx).1
  have hxHD : x ∈ ⁅p0Of M V (A ⊔ B), D⁆ := (Subgroup.mem_inf.mp hx).2
  have hxP0 : x ∈ p0Of M V (A ⊔ B) := hCP0 hxHC
  refine L2Datum.mem_V_of_commutator_mem hS h72 hD rfl hC hD' hR0 hg hxP0 ?_
  have hxcomm : ∀ r ∈ C ⊔ D, ⁅x, r⁆ ∈ V := by
    refine Sec6Hyp.commutator_mem_of_mem_sup (H₁ := C) (H₂ := D) hS.toSec6Hyp hCM hDM ?_ ?_
    · intro c hc
      have h := hquadC c hc x hxHC
      rw [← commutatorElement_inv c x, h, inv_one]
      exact V.one_mem
    · intro d hd
      have h := hquadD d hd x hxHD
      rw [← commutatorElement_inv d x, h, inv_one]
      exact V.one_mem
  intro r hr
  have h := hxcomm r hr
  rw [← commutatorElement_inv] at h
  simpa using V.inv_mem h

theorem L2Datum.p0_le_normalizer_commutator (hS : Sec7Hyp M V n f)
    (h72 : Sec7.Stmt72 M V n f) (hD : L2Datum M V A B h) (h4 : n = 4)
    {D : Subgroup G} (hD' : D ∈ sigmaSet M V) (hDX : D ≤ cenOf (A ⊔ B)) :
    p0Of M V (A ⊔ B) ≤
      Subgroup.normalizer ((⁅p0Of M V (A ⊔ B), D⁆ : Subgroup G) : Set G) := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hPM : Pc M V ≤ M := hS.sec5.toRootHyp.toHyp.Pc_le_M
  have hP0M : p0Of M V (A ⊔ B) ≤ M := inf_le_left.trans hPM
  have hDP0 : ⁅p0Of M V (A ⊔ B), D⁆ ≤ p0Of M V (A ⊔ B) := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hD' hDX]
    exact L2Datum.commutator_Pc_le_p0 hS.toSec6Hyp hD hD' hDX
  have hVleHD : V ≤ ⁅p0Of M V (A ⊔ B), D⁆ := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hD' hDX]
    exact hS.sec5.V_le_commutator hD'
  have hconjHD : ∀ y ∈ p0Of M V (A ⊔ B), ∀ z ∈ ⁅p0Of M V (A ⊔ B), D⁆,
      y * z * y⁻¹ ∈ ⁅p0Of M V (A ⊔ B), D⁆ := by
    intro y hy z hz
    have hyz : ⁅y, z⁆ ∈ V := by
      have h := Subgroup.commutator_mem_commutator hy (hDP0 hz)
      rwa [hS3] at h
    have heq : y * z * y⁻¹ = ⁅y, z⁆ * z := by rw [commutatorElement_def]; group
    rw [heq]
    exact (⁅p0Of M V (A ⊔ B), D⁆).mul_mem (hVleHD hyz) hz
  intro y hy
  rw [Subgroup.mem_normalizer_iff]
  intro z
  exact ⟨fun hz => hconjHD y hy z hz, fun hz => by
    have h := hconjHD y⁻¹ ((p0Of M V (A ⊔ B)).inv_mem hy) (y * z * y⁻¹) hz
    rwa [show y⁻¹ * (y * z * y⁻¹) * (y⁻¹)⁻¹ = z by group] at h⟩

theorem L2Datum.p0_eq_commutator_sup (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) (h4 : n = 4) {C D : Subgroup G}
    (hC : C ∈ sigmaSet M V) (hD' : D ∈ sigmaSet M V) (hCDX : C ⊔ D ≤ cenOf (A ⊔ B))
    (hR0 : r0Of M V (A ⊔ B) = C ⊔ D ⊔ p0Of M V (A ⊔ B)) {g : ↥M}
    (hg : imgQ M (conjSubgroup (g : G) (A ⊔ B)) = imgQ M (r0Of M V (A ⊔ B))) :
    p0Of M V (A ⊔ B) = ⁅p0Of M V (A ⊔ B), C⁆ ⊔ ⁅p0Of M V (A ⊔ B), D⁆ := by
  subst h4
  obtain ⟨hS1, hS2, hS3, hS4, hS5, hS6, hS7, hS8, hS9, hS10⟩ := h72 A B h hD
  have hCX : C ≤ cenOf (A ⊔ B) := (le_sup_left : C ≤ C ⊔ D).trans hCDX
  have hDX : D ≤ cenOf (A ⊔ B) := (le_sup_right : D ≤ C ⊔ D).trans hCDX
  have hPM : Pc M V ≤ M := hS.sec5.toRootHyp.toHyp.Pc_le_M
  have hP0M : p0Of M V (A ⊔ B) ≤ M := inf_le_left.trans hPM
  have hCP0 : ⁅p0Of M V (A ⊔ B), C⁆ ≤ p0Of M V (A ⊔ B) := by
    rw [← L2Datum.commutator_Pc_eq_p0 hS hD hS1 hC hCX]
    exact L2Datum.commutator_Pc_le_p0 hS.toSec6Hyp hD hC hCX
