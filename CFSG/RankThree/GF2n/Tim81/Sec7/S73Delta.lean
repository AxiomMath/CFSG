theorem IsL2Gen.exists_mem_conj_eq_inv (hAB : IsL2Gen A B) {x : G} (hx : x ∈ A ⊔ B)
    (hord : orderOf x = Nat.card A + 1) : ∃ t ∈ A, t * x * t⁻¹ = x⁻¹ := by
  obtain ⟨F, hField, hFin, hCharP, φ, hcard, hA, -⟩ := hAB
  letI := hField
  letI := hFin
  letI := hCharP
  have hxo : orderOf (φ ⟨x, hx⟩) = Nat.card F + 1 := by
    rw [MulEquiv.orderOf_eq, Subgroup.orderOf_mk, hord, hcard]
  obtain ⟨s, hs⟩ := CFSG.GroupTheory.exists_utriElt_conj_eq_inv hxo
  have hsA : utriElt s ∈ (A.subgroupOf (A ⊔ B)).map φ.toMonoidHom := by
    rw [hA]
    exact utriElt_mem_utri s
  obtain ⟨a, haA, ha⟩ := Subgroup.mem_map.mp hsA
  refine ⟨(a : G), Subgroup.mem_subgroupOf.mp haA, ?_⟩
  have ha' : φ a = utriElt s := ha
  have key : a * ⟨x, hx⟩ * a⁻¹ = (⟨x, hx⟩ : ↥(A ⊔ B))⁻¹ := by
    apply φ.injective
    rw [map_mul, map_mul, map_inv, map_inv, ha']
    exact hs
  exact congrArg Subtype.val key

theorem L2Datum.exists_mem_conj_eq_inv (hD : L2Datum M V A B h) :
    (∃ t ∈ A, t * h * t⁻¹ = h⁻¹) ∧ ∃ t ∈ B, t * h * t⁻¹ = h⁻¹ := by
  have hA : Nat.card A = Nat.card V := by
    obtain ⟨g, hg, -⟩ := hD.memA
    rw [hg]
    exact card_conjSubgroup g V
  have hB : Nat.card B = Nat.card V := by
    obtain ⟨g, hg, -⟩ := hD.memB
    rw [hg]
    exact card_conjSubgroup g V
  exact ⟨hD.l2.exists_mem_conj_eq_inv hD.mem (by rw [hA]; exact hD.order),
    hD.l2.symm.exists_mem_conj_eq_inv (by rw [sup_comm]; exact hD.mem)
      (by rw [hB]; exact hD.order)⟩

theorem L2Datum.mul_self_ne_one (hD : L2Datum M V A B h) (hR : RootHyp M V) : h * h ≠ 1 := by
  intro hh
  have hdvd : orderOf h ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [pow_two]; exact hh)
  have h2 := Nat.le_of_dvd (by norm_num) hdvd
  rw [hD.order] at h2
  have := hR.four_le_card
  omega

theorem L2Datum.cenOf_le_yOf (hD : L2Datum M V A B h) : cenOf (A ⊔ B) ≤ yOf h :=
  Subgroup.centralizer_le (Subgroup.zpowers_le.mpr hD.mem)

theorem L2Datum.conj_inv_of_le_cenOf (hS : Sec6Hyp M V) (hD : L2Datum M V A B h) {g : G}
    (hg : conjSubgroup g V ∈ sigmaSet M V) (hgX : conjSubgroup g V ≤ cenOf (A ⊔ B)) :
    L2Datum M V (conjSubgroup g⁻¹ A) (conjSubgroup g⁻¹ B) (g⁻¹ * h * g) := by
  have hH := hS.sec5.toRootHyp.toHyp
  have hgA : conjSubgroup g V ≤ cenOf A := hgX.trans (Subgroup.centralizer_le
    (s := (A : Set G)) (t := ((A ⊔ B : Subgroup G) : Set G)) fun z hz => Subgroup.mem_sup_left hz)
  have hgB : conjSubgroup g V ≤ cenOf B := hgX.trans (Subgroup.centralizer_le
    (s := (B : Set G)) (t := ((A ⊔ B : Subgroup G) : Set G)) fun z hz => Subgroup.mem_sup_right hz)
  have hVg : conjSubgroup g V ≠ ⊥ := fun h0 => hH.ne_bot (conjSubgroup_eq_bot_iff.mp h0)
  have hneA : conjSubgroup g V ≠ A := fun hA =>
    hVg (le_bot_iff.mp ((le_inf hA.le hgB).trans hD.l2.inf_cenOf_eq_bot.le))
  have hneB : conjSubgroup g V ≠ B := fun hB =>
    hVg (le_bot_iff.mp ((le_inf hB.le hgA).trans hD.l2.symm.inf_cenOf_eq_bot.le))
  refine ⟨(hH.mem_sigmaAt_conjSubgroup_iff g).mp (hS.mem_sigmaAt_of_commute hg hD.memA
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hgA) hneA),
    (hH.mem_sigmaAt_conjSubgroup_iff g).mp (hS.mem_sigmaAt_of_commute hg hD.memB
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hgB) hneB),
    hD.l2.conj g⁻¹, ?_, ?_⟩
  · rw [← conjSubgroup_sup, mem_conjSubgroup, inv_inv,
      show g * (g⁻¹ * h * g) * g⁻¹ = h by group]
    exact hD.mem
  · rw [show g⁻¹ * h * g = MulAut.conj g⁻¹ h by simp [MulAut.conj_apply], MulEquiv.orderOf_eq,
      hD.order]

theorem Sec5Hyp.lOf_le_cenOf (hS : Sec5Hyp M V) {g : G}
    (hg : conjSubgroup g V ∈ sigmaSet M V) : lOf M V g ≤ cenOf V := by
  have h1 := Sec45Shape.conj_Pc_inf_M hS.toRootHyp (hS.shape hg)
  have h2 := Sec45Shape.conj_Pc_inf_centralizer hS.toRootHyp (hS.shape hg)
  change conjSubgroup g (Pc M V) ⊓ M ≤ Subgroup.centralizer (V : Set G)
  rw [h1, ← h2]
  exact inf_le_right

theorem Sec5Hyp.inSubgroup_pCore_hOf_inf_cenOf_ne_bot (hS : Sec5Hyp M V) {g : G}
    (hg : conjSubgroup g V ∈ sigmaSet M V) {X : Subgroup G} (hVX : V ≤ cenOf X) :
    inSubgroup (pCore 2) (hOf M V g ⊓ cenOf X) ≠ ⊥ := by
  obtain ⟨hQ2, -, hHQ⟩ := inSubgroup_pCore_two (hOf M V g)
  have hB : inSubgroup (pCore 2) (hOf M V g) ⊓ (hOf M V g ⊓ cenOf X) ≤
      inSubgroup (pCore 2) (hOf M V g ⊓ cenOf X) :=
    le_inSubgroup_pCore inf_le_right
      (fun y hy => mem_normalizer_inf (hHQ hy.1) (Subgroup.le_normalizer hy))
      (hQ2.to_le inf_le_left)
  have hV : V ≤ inSubgroup (pCore 2) (hOf M V g) ⊓ (hOf M V g ⊓ cenOf X) :=
    le_inf (hS.shape hg).le_pCore (le_inf (hS.toRootHyp.toHyp.le_Pc.trans le_sup_left) hVX)
  intro hbot
  exact hS.toRootHyp.toHyp.ne_bot (le_bot_iff.mp ((hV.trans hB).trans hbot.le))

theorem Sec7Hyp.exists_mem_sigmaSet_le_cenOf (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) :
    ∃ g : G, conjSubgroup g V ∈ sigmaSet M V ∧ conjSubgroup g V ≤ cenOf (A ⊔ B) := by
  have h72' := h72 A B h hD
  have hne : ∃ C, C ∈ sigmaSet M V ∧ C ≤ cenOf (A ⊔ B) := by
    rcases Nat.lt_or_ge n 5 with h5 | h5
    · obtain ⟨C, hC, D, -, hCD, -⟩ := h72'.2.2.2.2.2.2.2.2.2 (by have := hS.four_le; omega)
      exact ⟨C, hC, le_sup_left.trans hCD⟩
    · obtain ⟨Φ, -, -, hclass⟩ := h72'.2.2.2.2.2.2.2.2.1 hS.one_le h5
      obtain ⟨U, hU, -⟩ := (hclass _).mpr ⟨1, rfl⟩
      exact ⟨U, hU.1, hU.2⟩
  obtain ⟨C, ⟨g, rfl, hH⟩, hCX⟩ := hne
  exact ⟨g, ⟨g, rfl, hH⟩, hCX⟩

theorem Sec7Hyp.exists_mem_conj_Pc_not_mem (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) {g : G} (hg : conjSubgroup g V ∈ sigmaSet M V)
    (hgX : conjSubgroup g V ≤ cenOf (A ⊔ B)) :
    ∃ c ∈ conjSubgroup g (Pc M V) ⊓ cenOf (A ⊔ B), c ∉ M := by
  have hR := hS.sec5.toRootHyp
  by_contra hcon
  push Not at hcon
  have h1 : conjSubgroup g (Pc M V) ⊓ cenOf (A ⊔ B) ≤ cenOf V := fun c hc =>
    hS.sec5.lOf_le_cenOf hg (Subgroup.mem_inf.mpr ⟨hc.1, hcon c hc⟩)
  have hD' := L2Datum.conj_inv_of_le_cenOf hS.toSec6Hyp hD hg hgX
  have e1 : conjSubgroup g⁻¹ (conjSubgroup g (Pc M V)) = Pc M V := by
    rw [conjSubgroup_conjSubgroup, inv_mul_cancel, conjSubgroup_one]
  have e2 : conjSubgroup g⁻¹ (cenOf (A ⊔ B)) =
      cenOf (conjSubgroup g⁻¹ A ⊔ conjSubgroup g⁻¹ B) := by
    change conjSubgroup g⁻¹ (Subgroup.centralizer ((A ⊔ B : Subgroup G) : Set G)) =
      Subgroup.centralizer ((conjSubgroup g⁻¹ A ⊔ conjSubgroup g⁻¹ B : Subgroup G) : Set G)
    rw [← centralizer_conjSubgroup_eq, conjSubgroup_sup]
  have e3 : conjSubgroup g⁻¹ (cenOf V) = cenOf (conjSubgroup g⁻¹ V) := by
    change conjSubgroup g⁻¹ (Subgroup.centralizer (V : Set G)) =
      Subgroup.centralizer (conjSubgroup g⁻¹ V : Set G)
    rw [centralizer_conjSubgroup_eq]
  have h2 : p0Of M V (conjSubgroup g⁻¹ A ⊔ conjSubgroup g⁻¹ B) ≤ cenOf (conjSubgroup g⁻¹ V) := by
    have := conjSubgroup_mono (g := g⁻¹) h1
    rwa [conjSubgroup_inf, e1, e2, e3] at this
  have hVX : V ≤ cenOf (A ⊔ B) :=
    Subgroup.le_centralizer_iff.mp ((hD.sup_le hS.toSec6Hyp).trans inf_le_right)
  have hmem : conjSubgroup g⁻¹ V ∈ sigmaSet M V := hS.sec5.conj_inv_mem_sigmaSet_iff.mp hg
  have hle : conjSubgroup g⁻¹ V ≤ cenOf (conjSubgroup g⁻¹ A ⊔ conjSubgroup g⁻¹ B) := by
    have := conjSubgroup_mono (g := g⁻¹) hVX
    rwa [e2] at this
  have hr0 : conjSubgroup g⁻¹ V ≤ r0Of M V (conjSubgroup g⁻¹ A ⊔ conjSubgroup g⁻¹ B) := by
    unfold r0Of
    exact le_iSup₂_of_le _ ⟨hmem, hle⟩ le_rfl
  have h8 := (h72 _ _ _ hD').2.2.2.2.2.2.2.1
  have hVV : conjSubgroup g⁻¹ V ≤ V :=
    (le_inf hr0 (Subgroup.le_centralizer_iff.mp h2)).trans h8.le
  exact ne_of_mem_sigmaSet hR hmem
    (Subgroup.eq_of_le_of_card_ge hVV (le_of_eq (card_conjSubgroup _ _).symm))

theorem Sec7Hyp.exists_mem_cenOf_not_mem (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f)
    (hD : L2Datum M V A B h) : ∃ c ∈ cenOf (A ⊔ B), c ∉ M := by
  obtain ⟨g, hg, hgX⟩ := hS.exists_mem_sigmaSet_le_cenOf h72 hD
  obtain ⟨c, hc, hcM⟩ := hS.exists_mem_conj_Pc_not_mem h72 hD hg hgX
  exact ⟨c, hc.2, hcM⟩

theorem Sec7Hyp.stmt73delta (hS : Sec7Hyp M V n f) (h72 : Sec7.Stmt72 M V n f) :
    Sec7.Stmt73delta M V := by
  intro A B h hD
  have hR := hS.sec5.toRootHyp
  obtain ⟨g, hg, hgX⟩ := hS.exists_mem_sigmaSet_le_cenOf h72 hD
  obtain ⟨c, hc, hcM⟩ := hS.exists_mem_conj_Pc_not_mem h72 hD hg hgX
  have hVX : V ≤ cenOf (A ⊔ B) :=
    Subgroup.le_centralizer_iff.mp ((hD.sup_le hS.toSec6Hyp).trans inf_le_right)
  have hcH : c ∈ hOf M V g := Subgroup.mem_sup_right hc.1
  have hcH₀ : c ∈ hOf M V g ⊓ cenOf (A ⊔ B) := Subgroup.mem_inf.mpr ⟨hcH, hc.2⟩
  refine ⟨hOf M V g ⊓ cenOf (A ⊔ B), inf_le_right.trans hD.cenOf_le_yOf,
    inf_le_inf_right _ le_sup_left, fun hle => hcM (hle hcH₀),
    hS.sec5.inSubgroup_pCore_hOf_inf_cenOf_ne_bot hg hVX, c, hcH₀, ?_, le_inf ?_ ?_⟩
  · intro heq
    exact hcM (by rw [← hR.toHyp.normalizer_eq]; exact conjSubgroup_eq_self_iff.mp heq)
  · exact (Tim79a.le_xOf (V := V) (H := hOf M V g) (Tim79a.conjSubgroup_mem_omegaOf hcH)).trans
      (hR.xOf_le_M (H := hOf M V g) le_sup_left (hS.sec5.shape hg).le_pCore)
  · exact (conjSubgroup_mono hVX).trans
      (conjSubgroup_eq_self_iff.mpr (Subgroup.le_normalizer hc.2)).le

