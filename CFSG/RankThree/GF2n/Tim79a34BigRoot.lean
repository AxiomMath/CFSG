variable {G : Type} [Group G] {M V Q P H : Subgroup G} {n f : ℕ}
  {Φ : ↥(StatedSp n (GaloisField 2 f)) ≃* Xbar V H}
  {ψ : (Fin n ⊕ Fin n → GaloisField 2 f) ≃+ Additive ↥(wOf V H)}

set_option hygiene false in
local notation "ψG " v:max => ((Additive.toMul (ψ v) : ↥(wOf V H)) : G)

omit Φ in
theorem psiG_injective {u v : Fin n ⊕ Fin n → GaloisField 2 f} (h : ψG u = ψG v) : u = v :=
  ψ.injective (Additive.toMul.injective (Subtype.ext h))

omit Φ in
theorem psiG_zero : ψG 0 = 1 := by
  simp

theorem exists_smul_of_psiG_mem_V [Finite G] (hH : BigEndHyp M V Q P H) (hf : 2 ^ f = qBar V H)
    (hNat : BigNatCfg V H hH.setup.mc.toMinCex.V_le_H Φ ψ)
    {a : Fin n ⊕ Fin n → GaloisField 2 f} {T : Subgroup ↥(StatedSp n (GaloisField 2 f))}
    (ha : a ≠ 0) (hT : CaseM.IsTransGroup a T) (hTV : T.map Φ.toMonoidHom = Vy V H)
    {w : Fin n ⊕ Fin n → GaloisField 2 f} (hw : ψG w ∈ V) :
    ∃ l : GaloisField 2 f, w = l • a := by
  have hf0 : f ≠ 0 := by
    rintro rfl
    have h4 := hH.q_big
    rw [← hf] at h4
    norm_num at h4
  have hFcard : Nat.card (GaloisField 2 f) = qBar V H := by
    rw [GaloisField.card 2 f hf0, hf]
  have hmem : ∀ l : GaloisField 2 f, ψG (l • a) ∈ V := by
    intro l
    by_cases hl : l = 0
    · rw [hl, zero_smul, psiG_zero (ψ := ψ)]
      exact V.one_mem
    · have hT' : CaseM.IsTransGroup (l • a) T :=
        CaseM.IsTransGroup.of_smul (inv_ne_zero hl) (by rwa [inv_smul_smul₀ hl a])
      exact hNat.point (l • a) T (smul_ne_zero hl ha) hT' hTV
  let φ : GaloisField 2 f → ↥(V ⊓ wOf V H) := fun l =>
    ⟨ψG (l • a), Subgroup.mem_inf.mpr ⟨hmem l, (Additive.toMul (ψ (l • a))).2⟩⟩
  have hinj : Function.Injective φ := by
    intro l l' h
    have h1 : ψG (l • a) = ψG (l' • a) := congrArg (fun y : ↥(V ⊓ wOf V H) => (y : G)) h
    exact smul_left_injective (GaloisField 2 f) ha (psiG_injective (ψ := ψ) h1)
  have hbij : Function.Bijective φ :=
    hinj.bijective_of_nat_card_le (by rw [hFcard, hH.module])
  obtain ⟨l, hl⟩ := hbij.2 ⟨ψG w, Subgroup.mem_inf.mpr ⟨hw, (Additive.toMul (ψ w)).2⟩⟩
  have h1 : ψG (l • a) = ψG w := congrArg (fun y : ↥(V ⊓ wOf V H) => (y : G)) hl
  exact ⟨l, (psiG_injective (ψ := ψ) h1).symm⟩

theorem exists_lift_spTrans [Finite G] (hc : MinCex M V Q P H)
    {a : Fin n ⊕ Fin n → GaloisField 2 f} {T : Subgroup ↥(StatedSp n (GaloisField 2 f))}
    (hT : CaseM.IsTransGroup a T) (hTV : T.map Φ.toMonoidHom = Vy V H) (μ : GaloisField 2 f) :
    ∃ (z : ↥(xOf V H)) (t : ↥(StatedSp n (GaloisField 2 f))), (z : G) ∈ V ∧
      SpExtras.mat n (GaloisField 2 f) t = CaseM.spTrans a μ ∧
      xToXbar hc.V_le_H z = Φ t := by
  obtain ⟨t, ht⟩ := exists_mat_eq_spTrans a μ
  have htT : t ∈ T := (hT.1 t).2 ⟨μ, ht⟩
  have hΦt : Φ t ∈ Vy V H := by
    rw [← hTV]
    exact Subgroup.mem_map.mpr ⟨t, htT, rfl⟩
  obtain ⟨y, hyV, hy⟩ := mem_barOf_iff.mp (Subgroup.mem_subgroupOf.mp hΦt)
  have hyX : (y : G) ∈ xOf V H := le_xOf (V_mem_omegaOf V H) hyV
  refine ⟨⟨y, hyX⟩, t, hyV, ht, Subtype.ext ?_⟩
  rw [coe_xToXbar]
  exact hy

theorem conj_act_spTrans [Finite G] (hc : MinCex M V Q P H)
    (hNat : BigNatCfg V H hc.V_le_H Φ ψ) {x z : ↥(xOf V H)}
    {g t : ↥(StatedSp n (GaloisField 2 f))} {a c : Fin n ⊕ Fin n → GaloisField 2 f}
    {μ : GaloisField 2 f} (hx : xToXbar hc.V_le_H x = Φ g) (hz : xToXbar hc.V_le_H z = Φ t)
    (ht : SpExtras.mat n (GaloisField 2 f) t = CaseM.spTrans a μ)
    (hga : SpExtras.mat n (GaloisField 2 f) g *ᵥ a = c) (w : Fin n ⊕ Fin n → GaloisField 2 f) :
    ((x : G) * (z : G) * (x : G)⁻¹) * ψG w * ((x : G) * (z : G) * (x : G)⁻¹)⁻¹ =
      ψG (w + (μ * CaseM.spForm c w) • c) := by
  have h1 : xToXbar hc.V_le_H (x * z * x⁻¹) = Φ (g * t * g⁻¹) := by
    rw [map_mul, map_mul, map_inv, hx, hz, map_mul, map_mul, map_inv]
  have hΦ : Φ.symm (xToXbar hc.V_le_H (x * z * x⁻¹)) = g * t * g⁻¹ := by
    rw [h1]
    exact Φ.symm_apply_apply _
  have key := hNat.equiv (x * z * x⁻¹) w
  rw [hΦ, CaseM.mat_conj_of_mat_eq ht g, hga, spTrans_mulVec] at key
  exact key.symm

theorem comm_of_mem_conj_of_normalizes [Finite G] {V M : Subgroup G} (hti : IsTI V)
    (hN : Subgroup.normalizer (V : Set G) = M) {x r : G} (hrM : r ∈ M)
    (hrx : r ∈ conjSubgroup x V)
    (hVN : ∀ v ∈ V, v ∈ Subgroup.normalizer (conjSubgroup x V : Set G))
    (hne : conjSubgroup x V ≠ V) {v : G} (hv : v ∈ V) : v * r = r * v := by
  have hbot := inf_conjSubgroup_eq_bot_of_isTI hti hne
  have h1 : r * v * r⁻¹ * v⁻¹ ∈ V := by
    have hrN : r ∈ Subgroup.normalizer (V : Set G) := hN ▸ hrM
    exact V.mul_mem ((Subgroup.mem_normalizer_iff.mp hrN v).mp hv) (V.inv_mem hv)
  have h2 : r * v * r⁻¹ * v⁻¹ ∈ conjSubgroup x V := by
    have h3 : v * r * v⁻¹ ∈ conjSubgroup x V :=
      (Subgroup.mem_normalizer_iff.mp (hVN v hv) r).mp hrx
    have h4 : v * r * v⁻¹ * r⁻¹ ∈ conjSubgroup x V :=
      (conjSubgroup x V).mul_mem h3 ((conjSubgroup x V).inv_mem hrx)
    have h5 := (conjSubgroup x V).inv_mem h4
    simpa [mul_assoc] using h5
  have h3 : r * v * r⁻¹ * v⁻¹ ∈ V ⊓ conjSubgroup x V := Subgroup.mem_inf.mpr ⟨h1, h2⟩
  rw [hbot, Subgroup.mem_bot] at h3
  exact (mul_inv_eq_iff_eq_mul.mp (mul_inv_eq_one.mp h3)).symm

end BigRoot

theorem bigRootElement_holds (hLoc : BigPLocalStatement) : BigRootElementStatement := by
  intro G _ _ M V Q P H hH hZ hcP n f hf Φ ψ hNat a T ha hT hTV c μ hca hcl _hμ
  have hc : MinCex M V Q P H := hH.setup.mc.toMinCex
  have hVH : V ≤ H := hc.V_le_H
  have hc0 : c ≠ 0 := fun h => hcl 0 (by rw [h, zero_smul])
  obtain ⟨g, hga⟩ := exists_mat_mulVec_eq_of_ne_zero ha hc0
  obtain ⟨x, hx⟩ := xToXbar_surjective hVH (Φ g)
  obtain ⟨z, t, hzV, ht, hz⟩ := BigRoot.exists_lift_spTrans hc hT hTV μ
  have hψc : ((Additive.toMul (ψ c) : ↥(wOf V H)) : G) =
      (x : G) * ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) * (x : G)⁻¹ := by
    have key := hNat.equiv x a
    rw [hx, Φ.symm_apply_apply, hga] at key
    exact key
  have haV : ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) ∈ V := hNat.point a T ha hT hTV
  have haW : ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) ≠ 1 := fun h =>
    ha (ψ.injective (Additive.toMul.injective (Subtype.ext (h.trans (by simp)))))
  have hψc1 : ((Additive.toMul (ψ c) : ↥(wOf V H)) : G) ≠ 1 := fun h =>
    hc0 (ψ.injective (Additive.toMul.injective (Subtype.ext (h.trans (by simp)))))
  have hψcP : ((Additive.toMul (ψ c) : ↥(wOf V H)) : G) ∈ P :=
    ((hLoc G M V Q P H hH hZ hcP hf Φ ψ hNat a T ha hT hTV).1 c).mpr hca
  have hact := BigRoot.conj_act_spTrans hc hNat hx hz ht hga
  have hrX : (x : G) * (z : G) * (x : G)⁻¹ ∈ xOf V H :=
    (xOf V H).mul_mem ((xOf V H).mul_mem x.2 z.2) ((xOf V H).inv_mem x.2)
  refine ⟨(x : G) * (z : G) * (x : G)⁻¹, Subgroup.mem_inf.mpr ⟨hrX, ?_⟩, hact⟩
  have hcomm_ca : CaseM.spForm c a = 0 := spForm_eq_zero_comm hca
  have hfix : ∀ l : GaloisField 2 f, ((x : G) * (z : G) * (x : G)⁻¹) *
      ((Additive.toMul (ψ (l • a)) : ↥(wOf V H)) : G) * ((x : G) * (z : G) * (x : G)⁻¹)⁻¹ =
      ((Additive.toMul (ψ (l • a)) : ↥(wOf V H)) : G) := by
    intro l
    rw [hact, spForm_smul_right', hcomm_ca, mul_zero, mul_zero, zero_smul, add_zero]
  have hrψa : ((x : G) * (z : G) * (x : G)⁻¹) * ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) =
      ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) * ((x : G) * (z : G) * (x : G)⁻¹) := by
    have h1 := hfix 1
    rw [one_smul] at h1
    exact mul_inv_eq_iff_eq_mul.mp h1
  have hrM : (x : G) * (z : G) * (x : G)⁻¹ ∈ M := hc.mem_M_of_commute haV haW hrψa
  have hTIx : IsTI (conjSubgroup (x : G) V) := isTI_conjSubgroup hc.ti x
  have hψcx : ((Additive.toMul (ψ c) : ↥(wOf V H)) : G) ∈ conjSubgroup (x : G) V := by
    rw [mem_conjSubgroup, hψc]
    have e : (x : G)⁻¹ * ((x : G) * ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) * (x : G)⁻¹) *
        (x : G) = ((Additive.toMul (ψ a) : ↥(wOf V H)) : G) := by group
    rw [e]
    exact haV
  have hVN : ∀ v ∈ V, v ∈ Subgroup.normalizer (conjSubgroup (x : G) V : Set G) := fun v hv =>
    Tim77.mem_normalizer_of_commute_of_isTI hTIx hψcx hψc1 (hc.commute_of_mem_P hψcP hv)
  have hne : conjSubgroup (x : G) V ≠ V := by
    intro h
    have hcV : ((Additive.toMul (ψ c) : ↥(wOf V H)) : G) ∈ V := by
      have h1 := hψcx
      rwa [h] at h1
    obtain ⟨l, hl⟩ := BigRoot.exists_smul_of_psiG_mem_V hH hf hNat ha hT hTV hcV
    exact hcl l hl
  have hrx : (x : G) * (z : G) * (x : G)⁻¹ ∈ conjSubgroup (x : G) V := by
    rw [mem_conjSubgroup]
    have e : (x : G)⁻¹ * ((x : G) * (z : G) * (x : G)⁻¹) * (x : G) = (z : G) := by group
    rw [e]
    exact hzV
  exact Subgroup.mem_centralizer_iff.mpr fun v hv =>
    BigRoot.comm_of_mem_conj_of_normalizes hc.ti hc.normalizer_eq hrM hrx hVN hne hv

