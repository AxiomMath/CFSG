section Minus

variable {K : Type} [Field K]

@[expose] def mIxKF3p : Fin (2 - 1) := ⟨0, by norm_num⟩

lemma fin_sub_one_eq_KF3p (i : Fin (2 - 1)) : i = mIxKF3p :=
  Fin.ext (by have := i.2; show i.val = 0; omega)

local notation "cX" z:max => z (Sum.inl mIxKF3p)
local notation "cY" z:max => z (Sum.inr (Sum.inl mIxKF3p))
local notation "cP" z:max => z (Sum.inr (Sum.inr 0))
local notation "cR" z:max => z (Sum.inr (Sum.inr 1))

lemma quad_minus_eq (b c0 : K) (z : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :
    StatedQuadMinus 2 K b c0 z = cX z * cY z + cP z ^ 2 + b * cP z * cR z + c0 * cR z ^ 2 := by
  unfold StatedQuadMinus
  rw [Finset.sum_eq_single mIxKF3p (fun i _ hi => absurd (fin_sub_one_eq_KF3p i) hi)
    (fun h => absurd (Finset.mem_univ _) h)]

@[expose] def minusFormKF3p (b : K) (v w : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) : K :=
  cX v * cY w + cX w * cY v + b * (cP v * cR w + cP w * cR v)

lemma minusFormKF3p_comm (b : K) (v w : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :
    minusFormKF3p b v w = minusFormKF3p b w v := by
  unfold minusFormKF3p; ring

lemma minusFormKF3p_self [CharP K 2] (b : K) (v : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :
    minusFormKF3p b v v = 0 := by
  have h2 : (2 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 2
  unfold minusFormKF3p
  linear_combination (cX v * cY v + b * cP v * cR v) * h2

lemma quad_add_smul_KF3p [CharP K 2] (b c0 : K) (v w : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K)
    (t : K) :
    StatedQuadMinus 2 K b c0 (v + t • w) = StatedQuadMinus 2 K b c0 v +
      t ^ 2 * StatedQuadMinus 2 K b c0 w + t * minusFormKF3p b v w := by
  have h2 : (2 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 2
  rw [quad_minus_eq, quad_minus_eq, quad_minus_eq, minusFormKF3p]
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  linear_combination (t * cP v * cP w + t * c0 * cR v * cR w) * h2

lemma quad_add_KF3p [CharP K 2] (b c0 : K) (v w : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :
    StatedQuadMinus 2 K b c0 (v + w) = StatedQuadMinus 2 K b c0 v +
      StatedQuadMinus 2 K b c0 w + minusFormKF3p b v w := by
  simpa using quad_add_smul_KF3p b c0 v w 1

lemma aniso_KF3p {b c0 : K} (hirr : ∀ s : K, s ^ 2 + b * s + c0 ≠ 0) {p r : K}
    (h : p ^ 2 + b * p * r + c0 * r ^ 2 = 0) : p = 0 ∧ r = 0 := by
  by_cases hr : r = 0
  · subst hr
    exact ⟨by simpa using h, rfl⟩
  · exfalso
    apply hirr (p / r)
    have e : (p / r) ^ 2 + b * (p / r) + c0 = (p ^ 2 + b * p * r + c0 * r ^ 2) / r ^ 2 := by
      field_simp
    rw [e, h, zero_div]

lemma eq_zero_of_coords_KF3p (z : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K)
    (hX : cX z = 0) (hY : cY z = 0) (hP : cP z = 0) (hR : cR z = 0) : z = 0 := by
  funext i
  rcases i with i | i | i
  · obtain rfl := fin_sub_one_eq_KF3p i
    simpa using hX
  · obtain rfl := fin_sub_one_eq_KF3p i
    simpa using hY
  · fin_cases i
    · simpa using hP
    · simpa using hR

@[expose] def isoSubKF3p {ι : Type} [Fintype ι] [DecidableEq ι] (Q : (ι → K) → K) :
    Subgroup (GL ι K) where
  carrier := {g | ∀ v, Q ((g : Matrix ι ι K) *ᵥ v) = Q v}
  one_mem' := fun v => by simp
  mul_mem' := fun {a b} ha hb v => by
    show Q (((a * b : GL ι K) : Matrix ι ι K) *ᵥ v) = Q v
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, ha, hb]
  inv_mem' := fun {g} hg v => by
    have h1 : (g : Matrix ι ι K) *ᵥ (((g⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ v) = v := by
      rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec]
    have := hg (((g⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ v)
    rw [h1] at this
    exact this.symm

lemma statedOmega_minus_iso_KF3p (b c0 : K) {a : GL (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) K}
    (ha : a ∈ StatedOmega (StatedQuadMinus 2 K b c0))
    (v : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :
    StatedQuadMinus 2 K b c0 ((a : Matrix _ _ K) *ᵥ v) = StatedQuadMinus 2 K b c0 v := by
  have hle : StatedOmega (StatedQuadMinus 2 K b c0) ≤ isoSubKF3p (StatedQuadMinus 2 K b c0) := by
    unfold StatedOmega
    refine Subgroup.commutator_le.2 fun g₁ h₁ g₂ h₂ => ?_
    have hc : CFSG.MatrixModel.isometryCore (StatedQuadMinus 2 K b c0) ≤
        isoSubKF3p (StatedQuadMinus 2 K b c0) :=
      (Subgroup.closure_le _).2 fun g hg => hg
    have h₁' := hc h₁
    have h₂' := hc h₂
    rw [commutatorElement_def]
    exact (isoSubKF3p _).mul_mem ((isoSubKF3p _).mul_mem ((isoSubKF3p _).mul_mem h₁' h₂')
      ((isoSubKF3p _).inv_mem h₁')) ((isoSubKF3p _).inv_mem h₂')
  have h := hle ha
  exact h v

lemma minus_witt_KF3p [CharP K 2] {b c0 : K} (hirr : ∀ s : K, s ^ 2 + b * s + c0 ≠ 0)
    (w₁ w₂ : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K)
    (h₁ : StatedQuadMinus 2 K b c0 w₁ = 0) (h₂ : StatedQuadMinus 2 K b c0 w₂ = 0)
    (hB : minusFormKF3p b w₁ w₂ = 0)
    (hind : ∀ α β : K, α • w₁ + β • w₂ = 0 → α = 0 ∧ β = 0) : False := by
  have h2 : (2 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 2
  obtain ⟨α, β, hab, hx⟩ : ∃ α β : K, (α ≠ 0 ∨ β ≠ 0) ∧ α * cX w₁ + β * cX w₂ = 0 := by
    by_cases hx1 : cX w₁ = 0
    · exact ⟨1, 0, Or.inl one_ne_zero, by simp [hx1]⟩
    · exact ⟨cX w₂, cX w₁, Or.inr hx1, by linear_combination (cX w₁ * cX w₂) * h2⟩
  have hz0 : α • w₁ + β • w₂ ≠ 0 := fun h => by
    obtain ⟨e1, e2⟩ := hind α β h
    exact hab.elim (fun h' => h' e1) (fun h' => h' e2)
  have hzX : cX (α • w₁ + β • w₂) = 0 := by simpa using hx
  have e1 : StatedQuadMinus 2 K b c0 (α • w₁) = α ^ 2 * StatedQuadMinus 2 K b c0 w₁ := by
    rw [quad_minus_eq, quad_minus_eq]
    simp only [Pi.smul_apply, smul_eq_mul]
    ring
  have e2 : StatedQuadMinus 2 K b c0 (β • w₂) = β ^ 2 * StatedQuadMinus 2 K b c0 w₂ := by
    rw [quad_minus_eq, quad_minus_eq]
    simp only [Pi.smul_apply, smul_eq_mul]
    ring
  have e3 : minusFormKF3p b (α • w₁) (β • w₂) = α * β * minusFormKF3p b w₁ w₂ := by
    unfold minusFormKF3p
    simp only [Pi.smul_apply, smul_eq_mul]
    ring
  have hQz : StatedQuadMinus 2 K b c0 (α • w₁ + β • w₂) = 0 := by
    have k := quad_add_smul_KF3p b c0 (α • w₁) (β • w₂) 1
    simp only [one_smul, one_pow, one_mul] at k
    rw [k, e1, e2, e3, h₁, h₂, hB]
    ring
  set z := α • w₁ + β • w₂ with hz
  have hzP : cP z = 0 ∧ cR z = 0 := by
    rw [quad_minus_eq, hzX] at hQz
    exact aniso_KF3p hirr (by linear_combination hQz)
  have hzY : cY z ≠ 0 := fun hY =>
    hz0 (eq_zero_of_coords_KF3p z hzX hY hzP.1 hzP.2)
  have hexp : ∀ w, minusFormKF3p b z w = α * minusFormKF3p b w₁ w + β * minusFormKF3p b w₂ w := by
    intro w
    unfold minusFormKF3p
    simp only [hz, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hBzw : ∀ w, minusFormKF3p b z w = cX w * cY z := by
    intro w
    unfold minusFormKF3p
    rw [hzX, hzP.1, hzP.2]
    ring
  have hBz₁ : minusFormKF3p b z w₁ = 0 := by
    rw [hexp, minusFormKF3p_self, minusFormKF3p_comm b w₂ w₁, hB]
    ring
  have hBz₂ : minusFormKF3p b z w₂ = 0 := by
    rw [hexp, hB, minusFormKF3p_self]
    ring
  have hXw₁ : cX w₁ = 0 := by
    have h := hBz₁
    rw [hBzw] at h
    exact (mul_eq_zero.mp h).resolve_right hzY
  have hXw₂ : cX w₂ = 0 := by
    have h := hBz₂
    rw [hBzw] at h
    exact (mul_eq_zero.mp h).resolve_right hzY
  have hPR₁ : cP w₁ = 0 ∧ cR w₁ = 0 := by
    rw [quad_minus_eq, hXw₁] at h₁
    exact aniso_KF3p hirr (by linear_combination h₁)
  have hPR₂ : cP w₂ = 0 ∧ cR w₂ = 0 := by
    rw [quad_minus_eq, hXw₂] at h₂
    exact aniso_KF3p hirr (by linear_combination h₂)
  have hsum : cY w₂ • w₁ + cY w₁ • w₂ = 0 := by
    apply eq_zero_of_coords_KF3p
    · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hXw₁, hXw₂]
      ring
    · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      linear_combination (cY w₁ * cY w₂) * h2
    · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hPR₁.1, hPR₂.1]
      ring
    · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hPR₁.2, hPR₂.2]
      ring
  obtain ⟨hη₂, hη₁⟩ := hind (cY w₂) (cY w₁) hsum
  have hw₁0 : w₁ = 0 :=
    eq_zero_of_coords_KF3p w₁ hXw₁ hη₁ hPR₁.1 hPR₁.2
  have := hind 1 0 (by rw [hw₁0]; simp)
  exact one_ne_zero this.1

lemma minusFormKF3p_smul_left (b a : K) (v u : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :
    minusFormKF3p b (a • v) u = a * minusFormKF3p b v u := by
  unfold minusFormKF3p
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

lemma minus_line_false_KF3p [CharP K 2] [Finite K] {b c0 : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c0 ≠ 0) (hK : 4 ≤ Nat.card K)
    (A : Subgroup (GL (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) K))
    (hA : A ≤ StatedOmega (StatedQuadMinus 2 K b c0))
    (Γ : Matrix (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) K)
    (hΓ : Γ ≠ 0)
    (hline : ∀ c : K, ∃ a ∈ A,
      ((a : GL (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) K) : Matrix _ _ K) - 1 = c • Γ) : False := by
  have h2 : (2 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 2
  have hiso : ∀ (c : K) (v : Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K),
      StatedQuadMinus 2 K b c0 (v + c • (Γ *ᵥ v)) = StatedQuadMinus 2 K b c0 v := by
    intro c v
    obtain ⟨a, ha, hac⟩ := hline c
    have hav : (a : Matrix _ _ K) *ᵥ v = v + c • (Γ *ᵥ v) := by
      have e : (a : Matrix _ _ K) = c • Γ + 1 := sub_eq_iff_eq_add.mp hac
      rw [e, Matrix.add_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec, add_comm]
    rw [← hav]
    exact statedOmega_minus_iso_KF3p b c0 (hA ha) v
  have hiso1 : ∀ v, StatedQuadMinus 2 K b c0 (v + Γ *ᵥ v) = StatedQuadMinus 2 K b c0 v := by
    intro v
    simpa using hiso 1 v
  obtain ⟨c₀, hc₀0, hc₀⟩ := CFSG.ClassicalModels.exists_ne_zero_sq_ne_one_of_four_le_card K hK
  have hc₀1 : c₀ ≠ 1 := fun h => hc₀ (by rw [h, one_pow])
  have hne : c₀ ^ 2 - c₀ ≠ 0 := by
    have : c₀ ^ 2 - c₀ = c₀ * (c₀ - 1) := by ring
    rw [this]
    exact mul_ne_zero hc₀0 (sub_ne_zero.mpr hc₀1)
  have hQΓ : ∀ v, StatedQuadMinus 2 K b c0 (Γ *ᵥ v) = 0 ∧
      minusFormKF3p b v (Γ *ᵥ v) = 0 := by
    intro v
    have e1 := hiso 1 v
    have e2 := hiso c₀ v
    rw [quad_add_smul_KF3p b c0 v _ 1] at e1
    rw [quad_add_smul_KF3p b c0 v _ c₀] at e2
    have f1 : StatedQuadMinus 2 K b c0 (Γ *ᵥ v) + minusFormKF3p b v (Γ *ᵥ v) = 0 := by
      linear_combination e1
    have f2 : c₀ ^ 2 * StatedQuadMinus 2 K b c0 (Γ *ᵥ v) +
        c₀ * minusFormKF3p b v (Γ *ᵥ v) = 0 := by
      linear_combination e2
    have f3 : (c₀ ^ 2 - c₀) * StatedQuadMinus 2 K b c0 (Γ *ᵥ v) = 0 := by
      linear_combination f2 - c₀ * f1
    have hQw := (mul_eq_zero.mp f3).resolve_left hne
    exact ⟨hQw, by linear_combination f1 - hQw⟩
  have hBGG : ∀ v w, minusFormKF3p b (Γ *ᵥ v) (Γ *ᵥ w) = 0 := by
    intro v w
    have e := (hQΓ (v + w)).1
    rw [Matrix.mulVec_add, quad_add_KF3p b c0] at e
    linear_combination e - (hQΓ v).1 - (hQΓ w).1
  have hBsym : ∀ v w, minusFormKF3p b v (Γ *ᵥ w) = minusFormKF3p b (Γ *ᵥ v) w := by
    intro v w
    have hsum : (v + Γ *ᵥ v) + (w + Γ *ᵥ w) = (v + w) + Γ *ᵥ (v + w) := by
      rw [Matrix.mulVec_add]
      abel
    have k1 := quad_add_KF3p b c0 (v + Γ *ᵥ v) (w + Γ *ᵥ w)
    rw [hsum, hiso1 (v + w), quad_add_KF3p b c0 v w, hiso1 v, hiso1 w] at k1
    have k2 : minusFormKF3p b (v + Γ *ᵥ v) (w + Γ *ᵥ w) =
        minusFormKF3p b v w + minusFormKF3p b v (Γ *ᵥ w) + minusFormKF3p b (Γ *ᵥ v) w +
          minusFormKF3p b (Γ *ᵥ v) (Γ *ᵥ w) := by
      unfold minusFormKF3p
      simp only [Pi.add_apply]
      ring
    have k3 := hBGG v w
    have hs : minusFormKF3p b v (Γ *ᵥ w) + minusFormKF3p b (Γ *ᵥ v) w = 0 := by
      linear_combination -k1 - k2 - k3
    linear_combination hs - (minusFormKF3p b (Γ *ᵥ v) w) * h2
  obtain ⟨v₀, hv₀⟩ : ∃ v₀, Γ *ᵥ v₀ ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hΓ
    ext i j
    have := congrFun (hcon (Pi.single j 1)) i
    simpa [Matrix.mulVec_single_one] using this
  set w := Γ *ᵥ v₀ with hw
  by_cases hcase : ∃ v, ∀ a : K, Γ *ᵥ v ≠ a • w
  ·
    obtain ⟨v, hv⟩ := hcase
    refine minus_witt_KF3p hirr w (Γ *ᵥ v) (hQΓ v₀).1 (hQΓ v).1 (hBGG v₀ v) ?_
    intro α β hαβ
    by_cases hβ : β = 0
    · subst hβ
      have hα : α • w = 0 := by simpa using hαβ
      rcases smul_eq_zero.mp hα with h | h
      · exact ⟨h, rfl⟩
      · exact absurd h hv₀
    · exfalso
      apply hv (-α / β)
      have h3 : β • (Γ *ᵥ v) = -(α • w) := eq_neg_of_add_eq_zero_right hαβ
      calc Γ *ᵥ v = β⁻¹ • (β • (Γ *ᵥ v)) := (inv_smul_smul₀ hβ _).symm
        _ = (-α / β) • w := by rw [h3]; module
  ·
    push_neg at hcase
    have hBw : ∀ v, minusFormKF3p b v w = 0 := by
      intro v
      obtain ⟨a, ha⟩ := hcase v
      have e1 := hBsym v v₀
      rw [← hw, ha, minusFormKF3p_smul_left, minusFormKF3p_comm b w v₀] at e1
      have e2 : minusFormKF3p b v₀ w = 0 := (hQΓ v₀).2
      rw [e2, mul_zero] at e1
      exact e1
    have hb : b ≠ 0 := by
      intro hb0
      obtain ⟨d, hd⟩ := FiniteField.isSquare_of_char_two (ringChar.eq K 2) c0
      apply hirr d
      rw [hb0, hd]
      linear_combination (d ^ 2) * h2
    have hX : cX w = 0 := by
      have := hBw (Pi.single (Sum.inr (Sum.inl mIxKF3p)) 1)
      unfold minusFormKF3p at this
      simpa [Pi.single_apply] using this
    have hY : cY w = 0 := by
      have := hBw (Pi.single (Sum.inl mIxKF3p) 1)
      unfold minusFormKF3p at this
      simpa [Pi.single_apply] using this
    have hR : cR w = 0 := by
      have := hBw (Pi.single (Sum.inr (Sum.inr 0)) 1)
      unfold minusFormKF3p at this
      simpa [Pi.single_apply, hb] using this
    have hP : cP w = 0 := by
      have := hBw (Pi.single (Sum.inr (Sum.inr 1)) 1)
      unfold minusFormKF3p at this
      simpa [Pi.single_apply, hb] using this
    exact hv₀ (eq_zero_of_coords_KF3p w hX hY hP hR)

end Minus

section Plus

variable {K : Type} [Field K] [Finite K] [CharP K 2]

@[expose] def pmKF3p (v : Fin 2 ⊕ Fin 2 → K) : Matrix (Fin 2) (Fin 2) K :=
  !![v (.inl 0), v (.inl 1); v (.inr 1), v (.inr 0)]

@[expose] def vmKF3p (X : Matrix (Fin 2) (Fin 2) K) : Fin 2 ⊕ Fin 2 → K :=
  Sum.elim ![X 0 0, X 0 1] ![X 1 1, X 1 0]

lemma pm_vm_KF3p (X : Matrix (Fin 2) (Fin 2) K) : pmKF3p (vmKF3p X) = X := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

lemma vm_pm_KF3p (v : Fin 2 ⊕ Fin 2 → K) : vmKF3p (pmKF3p v) = v := by
  funext i
  rcases i with i | i <;> fin_cases i <;> rfl

@[expose] def pEquivKF3p : (Fin 2 ⊕ Fin 2 → K) ≃ₗ[K] Matrix (Fin 2) (Fin 2) K where
  toFun := pmKF3p
  map_add' v w := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  map_smul' c v := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  invFun := vmKF3p
  left_inv := vm_pm_KF3p
  right_inv := pm_vm_KF3p

@[expose] def lmKF3p (A : Matrix (Fin 2) (Fin 2) K) :
    (Fin 2 ⊕ Fin 2 → K) →ₗ[K] (Fin 2 ⊕ Fin 2 → K) :=
  pEquivKF3p.symm.toLinearMap ∘ₗ LinearMap.mulLeft K A ∘ₗ pEquivKF3p.toLinearMap

@[expose] def rmKF3p (C : Matrix (Fin 2) (Fin 2) K) :
    (Fin 2 ⊕ Fin 2 → K) →ₗ[K] (Fin 2 ⊕ Fin 2 → K) :=
  pEquivKF3p.symm.toLinearMap ∘ₗ LinearMap.mulRight K C ∘ₗ pEquivKF3p.toLinearMap

lemma lmKF3p_apply (A : Matrix (Fin 2) (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    lmKF3p A v = vmKF3p (A * pmKF3p v) := rfl

lemma rmKF3p_apply (C : Matrix (Fin 2) (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    rmKF3p C v = vmKF3p (pmKF3p v * C) := rfl

lemma pm_lmKF3p (A : Matrix (Fin 2) (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    pmKF3p (lmKF3p A v) = A * pmKF3p v := by
  rw [lmKF3p_apply, pm_vm_KF3p]

lemma pm_rmKF3p (C : Matrix (Fin 2) (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    pmKF3p (rmKF3p C v) = pmKF3p v * C := by
  rw [rmKF3p_apply, pm_vm_KF3p]

lemma lmKF3p_mul (A B : Matrix (Fin 2) (Fin 2) K) : lmKF3p A * lmKF3p B = lmKF3p (A * B) := by
  apply LinearMap.ext
  intro v
  simp only [Module.End.mul_apply, lmKF3p_apply, pm_vm_KF3p, Matrix.mul_assoc]

lemma rmKF3p_mul (C D : Matrix (Fin 2) (Fin 2) K) :
    rmKF3p C * rmKF3p D = rmKF3p (D * C) := by
  apply LinearMap.ext
  intro v
  simp only [Module.End.mul_apply, rmKF3p_apply, pm_vm_KF3p, Matrix.mul_assoc]

lemma lmKF3p_rmKF3p_comm (A C : Matrix (Fin 2) (Fin 2) K) :
    lmKF3p A * rmKF3p C = rmKF3p C * lmKF3p A := by
  apply LinearMap.ext
  intro v
  simp only [Module.End.mul_apply, lmKF3p_apply, rmKF3p_apply, pm_vm_KF3p, Matrix.mul_assoc]

lemma lmKF3p_one : lmKF3p (1 : Matrix (Fin 2) (Fin 2) K) = 1 := by
  apply LinearMap.ext
  intro v
  simp [lmKF3p_apply, vm_pm_KF3p]

lemma rmKF3p_one : rmKF3p (1 : Matrix (Fin 2) (Fin 2) K) = 1 := by
  apply LinearMap.ext
  intro v
  simp [rmKF3p_apply, vm_pm_KF3p]

lemma lmKF3p_injective {A B : Matrix (Fin 2) (Fin 2) K} (h : lmKF3p A = lmKF3p B) : A = B := by
  have := congrArg (fun f => pmKF3p (f (vmKF3p 1))) h
  simpa [pm_lmKF3p, pm_vm_KF3p] using this

lemma rmKF3p_injective {A B : Matrix (Fin 2) (Fin 2) K} (h : rmKF3p A = rmKF3p B) : A = B := by
  have := congrArg (fun f => pmKF3p (f (vmKF3p 1))) h
  simpa [pm_rmKF3p, pm_vm_KF3p] using this

lemma statedQuadPlus_eq_det (v : Fin 2 ⊕ Fin 2 → K) :
    StatedQuadPlus 2 K v = (pmKF3p v).det := by
  have h2 : (2 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 2
  unfold StatedQuadPlus
  simp only [CFSG.MatrixModel.plusQuadCore, Fin.sum_univ_two, pmKF3p, Matrix.det_fin_two,
    Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const]
  linear_combination (v (.inl 1) * v (.inr 1)) * h2

lemma sl_mul_inv_KF3p (A : Matrix.SpecialLinearGroup (Fin 2) K) :
    (A : Matrix (Fin 2) (Fin 2) K) * ((A⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
      Matrix (Fin 2) (Fin 2) K) = 1 := by
  rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel, Matrix.SpecialLinearGroup.coe_one]

lemma inv_sl_mul_KF3p (A : Matrix.SpecialLinearGroup (Fin 2) K) :
    ((A⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) *
      (A : Matrix (Fin 2) (Fin 2) K) = 1 := by
  rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel, Matrix.SpecialLinearGroup.coe_one]

@[expose] def glLmKF3p (A : Matrix.SpecialLinearGroup (Fin 2) K) : GL (Fin 2 ⊕ Fin 2) K where
  val := LinearMap.toMatrix' (lmKF3p (A : Matrix (Fin 2) (Fin 2) K))
  inv := LinearMap.toMatrix' (lmKF3p ((A⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K))
  val_inv := by
    rw [← LinearMap.toMatrix'_mul, lmKF3p_mul, sl_mul_inv_KF3p, lmKF3p_one,
      LinearMap.toMatrix'_one]
  inv_val := by
    rw [← LinearMap.toMatrix'_mul, lmKF3p_mul, inv_sl_mul_KF3p, lmKF3p_one,
      LinearMap.toMatrix'_one]

@[expose] def glRmKF3p (C : Matrix.SpecialLinearGroup (Fin 2) K) : GL (Fin 2 ⊕ Fin 2) K where
  val := LinearMap.toMatrix' (rmKF3p (C : Matrix (Fin 2) (Fin 2) K))
  inv := LinearMap.toMatrix' (rmKF3p ((C⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K))
  val_inv := by
    rw [← LinearMap.toMatrix'_mul, rmKF3p_mul, inv_sl_mul_KF3p, rmKF3p_one,
      LinearMap.toMatrix'_one]
  inv_val := by
    rw [← LinearMap.toMatrix'_mul, rmKF3p_mul, sl_mul_inv_KF3p, rmKF3p_one,
      LinearMap.toMatrix'_one]

lemma glLmKF3p_mul (A B : Matrix.SpecialLinearGroup (Fin 2) K) :
    (glLmKF3p (A * B)).val = (glLmKF3p A).val * (glLmKF3p B).val := by
  show LinearMap.toMatrix' (lmKF3p ((A * B : Matrix.SpecialLinearGroup (Fin 2) K) :
      Matrix (Fin 2) (Fin 2) K)) =
    LinearMap.toMatrix' (lmKF3p (A : Matrix (Fin 2) (Fin 2) K)) *
      LinearMap.toMatrix' (lmKF3p (B : Matrix (Fin 2) (Fin 2) K))
  rw [← LinearMap.toMatrix'_mul, lmKF3p_mul, Matrix.SpecialLinearGroup.coe_mul]

lemma glRmKF3p_mul (A B : Matrix.SpecialLinearGroup (Fin 2) K) :
    (glRmKF3p (B⁻¹ * A⁻¹)).val = (glRmKF3p A⁻¹).val * (glRmKF3p B⁻¹).val := by
  show LinearMap.toMatrix' (rmKF3p ((B⁻¹ * A⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
      Matrix (Fin 2) (Fin 2) K)) =
    LinearMap.toMatrix' (rmKF3p ((A⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
      Matrix (Fin 2) (Fin 2) K)) *
      LinearMap.toMatrix' (rmKF3p ((B⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
      Matrix (Fin 2) (Fin 2) K))
  rw [← LinearMap.toMatrix'_mul, rmKF3p_mul, Matrix.SpecialLinearGroup.coe_mul]

@[expose] def rhoLKF3p : Matrix.SpecialLinearGroup (Fin 2) K →* GL (Fin 2 ⊕ Fin 2) K :=
  MonoidHom.mk' glLmKF3p fun A B => Units.ext (glLmKF3p_mul A B)

@[expose] def rhoRKF3p : Matrix.SpecialLinearGroup (Fin 2) K →* GL (Fin 2 ⊕ Fin 2) K :=
  MonoidHom.mk' (fun C => glRmKF3p C⁻¹) fun A B => Units.ext (by
    rw [mul_inv_rev]
    exact glRmKF3p_mul A B)

lemma rhoLKF3p_apply (A : Matrix.SpecialLinearGroup (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    ((rhoLKF3p A : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ v =
      lmKF3p (A : Matrix (Fin 2) (Fin 2) K) v := by
  show LinearMap.toMatrix' _ *ᵥ v = _
  rw [LinearMap.toMatrix'_mulVec]

lemma rhoRKF3p_apply (C : Matrix.SpecialLinearGroup (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    ((rhoRKF3p C : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ v =
      rmKF3p ((C⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) v := by
  show LinearMap.toMatrix' _ *ᵥ v = _
  rw [LinearMap.toMatrix'_mulVec]

lemma rho_commute (A C : Matrix.SpecialLinearGroup (Fin 2) K) :
    rhoLKF3p A * rhoRKF3p C = rhoRKF3p C * rhoLKF3p A := by
  apply Units.ext
  show LinearMap.toMatrix' (lmKF3p (A : Matrix (Fin 2) (Fin 2) K)) *
      LinearMap.toMatrix' (rmKF3p ((C⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
        Matrix (Fin 2) (Fin 2) K)) =
    LinearMap.toMatrix' (rmKF3p ((C⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) :
        Matrix (Fin 2) (Fin 2) K)) *
      LinearMap.toMatrix' (lmKF3p (A : Matrix (Fin 2) (Fin 2) K))
  rw [← LinearMap.toMatrix'_mul, ← LinearMap.toMatrix'_mul, lmKF3p_rmKF3p_comm]

lemma rhoLKF3p_injective : Function.Injective (rhoLKF3p (K := K)) := by
  intro A B h
  have h' : lmKF3p (A : Matrix (Fin 2) (Fin 2) K) = lmKF3p (B : Matrix (Fin 2) (Fin 2) K) := by
    have := congrArg Units.val h
    exact LinearMap.toMatrix'.injective this
  exact Subtype.ext (lmKF3p_injective h')

lemma rhoRKF3p_injective : Function.Injective (rhoRKF3p (K := K)) := by
  intro A B h
  have h' : rmKF3p ((A⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) =
      rmKF3p ((B⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) := by
    have := congrArg Units.val h
    exact LinearMap.toMatrix'.injective this
  have := rmKF3p_injective h'
  exact inv_injective (Subtype.ext this)

lemma rhoL_iso (A : Matrix.SpecialLinearGroup (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    StatedQuadPlus 2 K (((rhoLKF3p A : GL (Fin 2 ⊕ Fin 2) K) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ v) = StatedQuadPlus 2 K v := by
  rw [rhoLKF3p_apply, statedQuadPlus_eq_det, statedQuadPlus_eq_det, pm_lmKF3p, Matrix.det_mul,
    Matrix.SpecialLinearGroup.det_coe, one_mul]

lemma rhoR_iso (C : Matrix.SpecialLinearGroup (Fin 2) K) (v : Fin 2 ⊕ Fin 2 → K) :
    StatedQuadPlus 2 K (((rhoRKF3p C : GL (Fin 2 ⊕ Fin 2) K) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ v) = StatedQuadPlus 2 K v := by
  rw [rhoRKF3p_apply, statedQuadPlus_eq_det, statedQuadPlus_eq_det, pm_rmKF3p, Matrix.det_mul,
    Matrix.SpecialLinearGroup.det_coe, mul_one]

@[expose] def factorOneKF3p : Subgroup (GL (Fin 2 ⊕ Fin 2) K) := (rhoLKF3p (K := K)).range

@[expose] def factorTwoKF3p : Subgroup (GL (Fin 2 ⊕ Fin 2) K) := (rhoRKF3p (K := K)).range

lemma factorOne_le_isoSub (A : Matrix.SpecialLinearGroup (Fin 2) K) :
    rhoLKF3p A ∈ CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K) :=
  Subgroup.subset_closure fun v => rhoL_iso A v

lemma factorTwo_le_isoSub (C : Matrix.SpecialLinearGroup (Fin 2) K) :
    rhoRKF3p C ∈ CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K) :=
  Subgroup.subset_closure fun v => rhoR_iso C v

lemma factorOne_le_omega (h4 : 4 ≤ Nat.card K) :
    factorOneKF3p (K := K) ≤ StatedOmega (StatedQuadPlus 2 K) := by
  have hperf : ⁅(⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K)), ⊤⁆ = ⊤ :=
    (CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card K h4).commutator_eq_top
  have hle : factorOneKF3p (K := K) ≤ CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K) := by
    rintro g ⟨A, rfl⟩
    exact factorOne_le_isoSub A
  have hmap : factorOneKF3p (K := K) =
      Subgroup.map rhoLKF3p (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K)) :=
    MonoidHom.range_eq_map _
  unfold StatedOmega
  calc factorOneKF3p (K := K) = Subgroup.map rhoLKF3p
        ⁅(⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K)), ⊤⁆ := by
        rw [hperf]; exact hmap
    _ = ⁅Subgroup.map rhoLKF3p ⊤, Subgroup.map rhoLKF3p ⊤⁆ := Subgroup.map_commutator _ _ _
    _ = ⁅factorOneKF3p (K := K), factorOneKF3p (K := K)⁆ := by rw [← hmap]
    _ ≤ ⁅CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K),
          CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K)⁆ :=
        Subgroup.commutator_mono hle hle

lemma factorTwo_le_omega (h4 : 4 ≤ Nat.card K) :
    factorTwoKF3p (K := K) ≤ StatedOmega (StatedQuadPlus 2 K) := by
  have hperf : ⁅(⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K)), ⊤⁆ = ⊤ :=
    (CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card K h4).commutator_eq_top
  have hle : factorTwoKF3p (K := K) ≤ CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K) := by
    rintro g ⟨C, rfl⟩
    exact factorTwo_le_isoSub C
  have hmap : factorTwoKF3p (K := K) =
      Subgroup.map rhoRKF3p (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K)) :=
    MonoidHom.range_eq_map _
  unfold StatedOmega
  calc factorTwoKF3p (K := K) = Subgroup.map rhoRKF3p
        ⁅(⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K)), ⊤⁆ := by
        rw [hperf]; exact hmap
    _ = ⁅Subgroup.map rhoRKF3p ⊤, Subgroup.map rhoRKF3p ⊤⁆ := Subgroup.map_commutator _ _ _
    _ = ⁅factorTwoKF3p (K := K), factorTwoKF3p (K := K)⁆ := by rw [← hmap]
    _ ≤ ⁅CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K),
          CFSG.MatrixModel.isometryCore (StatedQuadPlus 2 K)⁆ :=
        Subgroup.commutator_mono hle hle

lemma lm_eq_rm_eq_one {A D : Matrix (Fin 2) (Fin 2) K} (hA : A.det = 1)
    (h : lmKF3p A = rmKF3p D) : A = 1 := by
  have h2 : (2 : K) = 0 := by exact_mod_cast CharP.cast_eq_zero K 2
  have hAD : A = D := by
    have := congrArg (fun f => pmKF3p (f (vmKF3p 1))) h
    simpa [pm_lmKF3p, pm_rmKF3p, pm_vm_KF3p] using this
  have hcomm : ∀ X : Matrix (Fin 2) (Fin 2) K, A * X = X * A := by
    intro X
    have := congrArg (fun f => pmKF3p (f (vmKF3p X))) h
    simpa [pm_lmKF3p, pm_rmKF3p, pm_vm_KF3p, hAD] using this
  have eE := hcomm !![0, 1; 0, 0]
  have eF := hcomm !![0, 0; 1, 0]
  have e10 : A 1 0 = 0 := by
    have := congrFun (congrFun eE 0) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this.symm
  have e01 : A 0 1 = 0 := by
    have := congrFun (congrFun eF 0) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have e00 : A 0 0 = A 1 1 := by
    have := congrFun (congrFun eE 0) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have hsq : A 0 0 * A 0 0 = 1 := by
    rw [Matrix.det_fin_two, e01, e10, ← e00] at hA
    simpa using hA
  have ha : A 0 0 = 1 := by
    have h3 : (A 0 0 - 1) ^ 2 = 0 := by linear_combination hsq - A 0 0 * h2 + h2
    exact sub_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp h3)
  have e11 : A 1 1 = 1 := by rw [← e00, ha]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [e01, e10, ha, e11]

lemma factorOne_inf_factorTwo :
    factorOneKF3p (K := K) ⊓ factorTwoKF3p (K := K) = ⊥ := by
  rw [eq_bot_iff]
  rintro g ⟨⟨A, rfl⟩, ⟨C, hC⟩⟩
  rw [Subgroup.mem_bot]
  have h1 : lmKF3p (A : Matrix (Fin 2) (Fin 2) K) =
      rmKF3p ((C⁻¹ : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) := by
    apply LinearMap.toMatrix'.injective
    exact (congrArg Units.val hC).symm
  have hA1 : (A : Matrix (Fin 2) (Fin 2) K) = 1 := lm_eq_rm_eq_one A.2 h1
  have : A = 1 := Subtype.ext hA1
  rw [this, map_one]

lemma factorOne_factorTwo_commute (a b : GL (Fin 2 ⊕ Fin 2) K) (ha : a ∈ factorOneKF3p (K := K))
    (hb : b ∈ factorTwoKF3p (K := K)) : a * b = b * a := by
  obtain ⟨A, rfl⟩ := ha
  obtain ⟨C, rfl⟩ := hb
  exact rho_commute A C

lemma factorOne_isSL :
    IsSLModel 2 (Nat.card K) ↥(factorOneKF3p (K := K)) :=
  ⟨K, inferInstance, inferInstance, rfl, ⟨(MonoidHom.ofInjective rhoLKF3p_injective).symm.trans
    (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 K)⟩⟩

lemma factorTwo_isSL :
    IsSLModel 2 (Nat.card K) ↥(factorTwoKF3p (K := K)) :=
  ⟨K, inferInstance, inferInstance, rfl, ⟨(MonoidHom.ofInjective rhoRKF3p_injective).symm.trans
    (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 K)⟩⟩

lemma card_SL_KF3p :
    Nat.card (Matrix.SpecialLinearGroup (Fin 2) K) = Nat.card K * (Nat.card K ^ 2 - 1) :=
  (Nat.card_congr (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 K).toEquiv).trans
    (CFSG.Open.StatedAPI.card_statedSL_two K)

lemma card_omega_plus_nat (h4 : 4 ≤ Nat.card K) :
    Nat.card ↥(StatedOmega (StatedQuadPlus 2 K)) = Nat.card K ^ 2 * (Nat.card K ^ 2 - 1) ^ 2 := by
  have h := orthE2_card_omega_plus_two h4
  have hq : 1 ≤ Nat.card K ^ 2 := Nat.one_le_pow _ _ (by omega)
  have e : ((Nat.card K ^ 2 * (Nat.card K ^ 2 - 1) ^ 2 : ℕ) : ℤ) =
      (Nat.card K : ℤ) ^ 2 * ((Nat.card K : ℤ) ^ 2 - 1) ^ 2 := by
    push_cast [Nat.cast_sub hq]
    ring
  exact_mod_cast h.trans e.symm

@[expose] def psiKF3p :
    Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K →*
      GL (Fin 2 ⊕ Fin 2) K :=
  (rhoLKF3p (K := K)).noncommCoprod rhoRKF3p
    (fun A C => show Commute (rhoLKF3p A) (rhoRKF3p C) from rho_commute A C)

lemma psiKF3p_apply (A C : Matrix.SpecialLinearGroup (Fin 2) K) :
    psiKF3p (A, C) = rhoRKF3p C * rhoLKF3p A := by
  unfold psiKF3p
  rw [MonoidHom.noncommCoprod_apply']

lemma psiKF3p_injective : Function.Injective (psiKF3p (K := K)) := by
  rw [injective_iff_map_eq_one]
  rintro ⟨A, C⟩ h
  rw [psiKF3p_apply] at h
  have hLmem : rhoLKF3p A ∈ factorOneKF3p (K := K) := ⟨A, rfl⟩
  have hRmem : rhoRKF3p C ∈ factorTwoKF3p (K := K) := ⟨C, rfl⟩
  have hinv : rhoLKF3p A = (rhoRKF3p C)⁻¹ := eq_inv_of_mul_eq_one_right h
  have hmem : rhoLKF3p A ∈ factorOneKF3p (K := K) ⊓ factorTwoKF3p (K := K) :=
    ⟨hLmem, by rw [hinv]; exact (factorTwoKF3p (K := K)).inv_mem hRmem⟩
  rw [factorOne_inf_factorTwo, Subgroup.mem_bot] at hmem
  have hA : A = 1 := rhoLKF3p_injective (hmem.trans (map_one _).symm)
  have hRC : rhoRKF3p C = 1 := inv_eq_one.mp (hinv.symm.trans hmem)
  have hC : C = 1 := rhoRKF3p_injective (hRC.trans (map_one _).symm)
  rw [hA, hC]
  rfl

lemma card_range_psi :
    Nat.card (psiKF3p (K := K)).range = Nat.card K ^ 2 * (Nat.card K ^ 2 - 1) ^ 2 := by
  rw [← Nat.card_congr (MonoidHom.ofInjective psiKF3p_injective).toEquiv, Nat.card_prod,
    card_SL_KF3p]
  ring

lemma range_psi_eq_omega (h4 : 4 ≤ Nat.card K) :
    (psiKF3p (K := K)).range = StatedOmega (StatedQuadPlus 2 K) := by
  apply Subgroup.eq_of_le_of_card_ge
  · rintro g ⟨⟨A, C⟩, rfl⟩
    rw [psiKF3p_apply]
    exact Subgroup.mul_mem _ (factorTwo_le_omega h4 ⟨C, rfl⟩) (factorOne_le_omega h4 ⟨A, rfl⟩)
  · rw [card_omega_plus_nat h4, card_range_psi]

lemma factorOne_sup_factorTwo (h4 : 4 ≤ Nat.card K) :
    factorOneKF3p (K := K) ⊔ factorTwoKF3p (K := K) = StatedOmega (StatedQuadPlus 2 K) := by
  apply le_antisymm
  · exact sup_le (factorOne_le_omega h4) (factorTwo_le_omega h4)
  · rw [← range_psi_eq_omega h4]
    rintro g ⟨⟨A, C⟩, rfl⟩
    rw [psiKF3p_apply]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_right ⟨C, rfl⟩) (Subgroup.mem_sup_left ⟨A, rfl⟩)

lemma factorOne_normalizes (h4 : 4 ≤ Nat.card K) {g : GL (Fin 2 ⊕ Fin 2) K}
    (hg : g ∈ StatedOmega (StatedQuadPlus 2 K)) {x : GL (Fin 2 ⊕ Fin 2) K}
    (hx : x ∈ factorOneKF3p (K := K)) : g * x * g⁻¹ ∈ factorOneKF3p (K := K) := by
  have hle : factorOneKF3p (K := K) ⊔ factorTwoKF3p (K := K) ≤
      Subgroup.normalizer ((factorOneKF3p (K := K)) : Set (GL (Fin 2 ⊕ Fin 2) K)) := by
    apply sup_le Subgroup.le_normalizer
    intro y hy
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · intro hh
      have e := factorOne_factorTwo_commute h y hh hy
      rw [← e, mul_inv_cancel_right]
      exact hh
    · intro hh
      have e := factorOne_factorTwo_commute (y * h * y⁻¹) y⁻¹ hh
        ((factorTwoKF3p (K := K)).inv_mem hy)
      have hh' : h = y * h * y⁻¹ := by
        calc h = y⁻¹ * (y * h * y⁻¹) * y := by group
          _ = (y * h * y⁻¹) * y⁻¹ * y := by rw [e]
          _ = y * h * y⁻¹ := by group
      rw [hh']
      exact hh
  have hg' : g ∈ factorOneKF3p (K := K) ⊔ factorTwoKF3p (K := K) := by
    rw [factorOne_sup_factorTwo h4]
    exact hg
  exact (Subgroup.mem_normalizer_iff.mp (hle hg') x).mp hx

lemma LR_mul_eq_one {A C : Matrix.SpecialLinearGroup (Fin 2) K}
    (h : rhoLKF3p A * rhoRKF3p C = 1) : A = 1 ∧ C = 1 := by
  have hinv : rhoLKF3p A = (rhoRKF3p C)⁻¹ := eq_inv_of_mul_eq_one_left h
  have hmem : rhoLKF3p A ∈ factorOneKF3p (K := K) ⊓ factorTwoKF3p (K := K) :=
    ⟨⟨A, rfl⟩, by rw [hinv]; exact (factorTwoKF3p (K := K)).inv_mem ⟨C, rfl⟩⟩
  rw [factorOne_inf_factorTwo, Subgroup.mem_bot] at hmem
  have hA : A = 1 := rhoLKF3p_injective (hmem.trans (map_one _).symm)
  have hRC : rhoRKF3p C = 1 := inv_eq_one.mp (hinv.symm.trans hmem)
  exact ⟨hA, rhoRKF3p_injective (hRC.trans (map_one _).symm)⟩

@[expose] def uUpKF3p (x : K) : Matrix.SpecialLinearGroup (Fin 2) K :=
  ⟨!![1, x; 0, 1], by simp [Matrix.det_fin_two]⟩

@[expose] def uLoKF3p (y : K) : Matrix.SpecialLinearGroup (Fin 2) K :=
  ⟨!![1, 0; y, 1], by simp [Matrix.det_fin_two]⟩

lemma uUp_add (x x' : K) : uUpKF3p (x + x') = uUpKF3p x * uUpKF3p x' := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uUpKF3p, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma uLo_add (y y' : K) : uLoKF3p (y + y') = uLoKF3p y * uLoKF3p y' := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uLoKF3p, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

lemma uUp_zero : uUpKF3p (0 : K) = 1 := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uUpKF3p]

lemma uLo_zero : uLoKF3p (0 : K) = 1 := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uLoKF3p]

lemma uLo_neg_inv (y : K) : (uLoKF3p (-y))⁻¹ = uLoKF3p y := by
  apply inv_eq_of_mul_eq_one_right
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uLoKF3p, Matrix.mul_apply, Fin.sum_univ_two]

lemma uUp_eq_one {x : K} (h : uUpKF3p x = 1) : x = 0 := by
  have := congrArg
    (fun A : Matrix.SpecialLinearGroup (Fin 2) K => (A : Matrix (Fin 2) (Fin 2) K) 0 1) h
  simpa [uUpKF3p] using this

lemma uLo_eq_one {y : K} (h : uLoKF3p y = 1) : y = 0 := by
  have := congrArg
    (fun A : Matrix.SpecialLinearGroup (Fin 2) K => (A : Matrix (Fin 2) (Fin 2) K) 1 0) h
  simpa [uLoKF3p] using this

@[expose] def thetaKF3p (x y : K) : GL (Fin 2 ⊕ Fin 2) K :=
  rhoLKF3p (uUpKF3p x) * rhoRKF3p (uLoKF3p (-y))

lemma theta_mul_aux {G : Type*} [Group G] (L L' R R' : G) (h : L' * R = R * L') :
    L * L' * (R * R') = L * R * (L' * R') := by
  simp only [mul_assoc]
  rw [← mul_assoc L' R, h]
  simp only [mul_assoc]

lemma theta_add (x x' y y' : K) :
    thetaKF3p (x + x') (y + y') = thetaKF3p x y * thetaKF3p x' y' := by
  unfold thetaKF3p
  rw [uUp_add, neg_add, uLo_add]
  simp only [map_mul]
  exact theta_mul_aux _ _ _ _ (rho_commute _ _)

@[expose] def thetaHomKF3p : Multiplicative (K × K) →* GL (Fin 2 ⊕ Fin 2) K :=
  MonoidHom.mk' (fun p => thetaKF3p (Multiplicative.toAdd p).1 (Multiplicative.toAdd p).2)
    (fun p q => by
      simp only [toAdd_mul, Prod.fst_add, Prod.snd_add]
      exact theta_add _ _ _ _)

@[expose] def sylowP0KF3p : Subgroup (GL (Fin 2 ⊕ Fin 2) K) := thetaHomKF3p.range

lemma thetaHom_injective : Function.Injective (thetaHomKF3p (K := K)) := by
  rw [injective_iff_map_eq_one]
  rintro ⟨x, y⟩ h
  have h' : thetaKF3p x y = 1 := h
  obtain ⟨h1, h2⟩ := LR_mul_eq_one h'
  have hx : x = 0 := uUp_eq_one h1
  have hy : -y = 0 := uLo_eq_one (by rw [h2])
  rw [hx, neg_eq_zero.mp hy]
  rfl

lemma sylowP0_card : Nat.card (sylowP0KF3p (K := K)) = Nat.card K * Nat.card K := by
  rw [sylowP0KF3p, ← Nat.card_congr (MonoidHom.ofInjective thetaHom_injective).toEquiv]
  exact Nat.card_prod K K

lemma sylowP0_le_omega (h4 : 4 ≤ Nat.card K) :
    sylowP0KF3p (K := K) ≤ StatedOmega (StatedQuadPlus 2 K) := by
  rintro g ⟨⟨x, y⟩, rfl⟩
  have h : thetaHomKF3p (⟨x, y⟩ : Multiplicative (K × K)) = thetaKF3p x y := rfl
  rw [h, thetaKF3p]
  exact Subgroup.mul_mem _ (factorOne_le_omega h4 ⟨_, rfl⟩) (factorTwo_le_omega h4 ⟨_, rfl⟩)

lemma sylowP0_mem_param {g : GL (Fin 2 ⊕ Fin 2) K} (hg : g ∈ sylowP0KF3p (K := K)) :
    ∃ x y : K, g = thetaKF3p x y := by
  obtain ⟨p, rfl⟩ := hg
  exact ⟨(Multiplicative.toAdd p).1, (Multiplicative.toAdd p).2, rfl⟩

lemma factorization_two_pow_mul_odd {a m : ℕ} (hm : Odd m) :
    (2 ^ a * m).factorization 2 = a := by
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact (Nat.not_even_iff_odd.mpr hm) ⟨0, rfl⟩
  have hndvd : ¬ 2 ∣ m := by
    intro h
    exact (Nat.not_even_iff_odd.mpr hm) (even_iff_two_dvd.mpr h)
  rw [Nat.factorization_mul (pow_ne_zero _ two_ne_zero) hm0, Finsupp.add_apply,
    Nat.Prime.factorization_pow Nat.prime_two, Finsupp.single_eq_same,
    Nat.factorization_eq_zero_of_not_dvd hndvd, add_zero]

lemma sylow_conj_KF3p (h4 : 4 ≤ Nat.card K) (A : Subgroup (GL (Fin 2 ⊕ Fin 2) K))
    (hA : A ≤ StatedOmega (StatedQuadPlus 2 K)) (hcard : Nat.card A = Nat.card K) :
    ∃ g ∈ StatedOmega (StatedQuadPlus 2 K), ∀ a ∈ A, g⁻¹ * a * g ∈ sylowP0KF3p (K := K) := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨k, hk⟩ : ∃ k : ℕ, Nat.card K = 2 ^ k := by
    obtain ⟨n, -, hn⟩ := FiniteField.card K 2
    exact ⟨n, by rw [Nat.card_eq_fintype_card, hn]⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hk1 : k ≠ 0 := by
    rintro rfl
    rw [pow_zero] at hk
    omega
  have hP0 : sylowP0KF3p (K := K) ≤ StatedOmega (StatedQuadPlus 2 K) := sylowP0_le_omega h4
  have e2 : Nat.card K ^ 2 = 2 ^ (2 * k) := by
    rw [hk, ← pow_mul, mul_comm]
  have hdvd : 2 ∣ 2 ^ (2 * k) := dvd_pow_self 2 (by omega)
  have hone : 1 ≤ 2 ^ (2 * k) := Nat.one_le_two_pow
  have hodd : Odd ((2 ^ (2 * k) - 1) ^ 2) := by
    have : (2 ^ (2 * k) - 1) % 2 = 1 := by omega
    exact Odd.pow (Nat.odd_iff.mpr this)
  have hΩcard : Nat.card ↥(StatedOmega (StatedQuadPlus 2 K)) =
      2 ^ (2 * k) * (2 ^ (2 * k) - 1) ^ 2 := by
    rw [card_omega_plus_nat h4, e2]
  have hfac : (Nat.card ↥(StatedOmega (StatedQuadPlus 2 K))).factorization 2 = 2 * k := by
    rw [hΩcard]
    exact factorization_two_pow_mul_odd hodd
  set Ω := StatedOmega (StatedQuadPlus 2 K)
  have hP0card : Nat.card ((sylowP0KF3p (K := K)).subgroupOf Ω) = 2 ^ (2 * k) := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hP0).toEquiv, sylowP0_card, hk, ← pow_add,
      show 2 * k = k + k by ring]
  have hcardP0 : Nat.card ((sylowP0KF3p (K := K)).subgroupOf Ω) =
      2 ^ (Nat.card ↥Ω).factorization 2 := by
    rw [hP0card, hfac]
  let P0s : Sylow 2 Ω := Sylow.ofCard ((sylowP0KF3p (K := K)).subgroupOf Ω) hcardP0
  have hA'card : Nat.card (A.subgroupOf Ω) = 2 ^ k := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA).toEquiv, hcard, hk]
  have hA'p : IsPGroup 2 (A.subgroupOf Ω) := IsPGroup.iff_card.mpr ⟨k, hA'card⟩
  obtain ⟨S, hS⟩ := hA'p.exists_le_sylow
  obtain ⟨g', hg'⟩ := MulAction.exists_smul_eq Ω P0s S
  refine ⟨(g' : GL (Fin 2 ⊕ Fin 2) K), g'.2, fun a ha => ?_⟩
  have haΩ : a ∈ Ω := hA ha
  have hmemSub : (⟨a, haΩ⟩ : Ω) ∈ (S : Subgroup Ω) := hS (Subgroup.mem_subgroupOf.mpr ha)
  rw [← hg', Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hmemSub
  have hyP : (MulAut.conj g')⁻¹ • (⟨a, haΩ⟩ : Ω) ∈
      (Sylow.ofCard ((sylowP0KF3p (K := K)).subgroupOf Ω) hcardP0 : Subgroup Ω) := hmemSub
  rw [Sylow.coe_ofCard] at hyP
  have hval : (((MulAut.conj g')⁻¹ • (⟨a, haΩ⟩ : Ω) : Ω) : GL (Fin 2 ⊕ Fin 2) K) =
      (g' : GL (Fin 2 ⊕ Fin 2) K)⁻¹ * a * (g' : GL (Fin 2 ⊕ Fin 2) K) := by
    simp [MulAut.conj_apply, MulAut.smul_def]
  have hfin := Subgroup.mem_subgroupOf.mp hyP
  rw [hval] at hfin
  exact hfin

lemma pm_add_KF3p (v w : Fin 2 ⊕ Fin 2 → K) : pmKF3p (v + w) = pmKF3p v + pmKF3p w :=
  map_add pEquivKF3p v w

lemma pm_smul_KF3p (c : K) (v : Fin 2 ⊕ Fin 2 → K) : pmKF3p (c • v) = c • pmKF3p v :=
  map_smul pEquivKF3p c v

lemma uUp_lo_sub_one (x y : K) :
    ((uUpKF3p x : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) *
      ((uLoKF3p y : Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) - 1 =
      !![x * y, x; y, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [uUpKF3p, uLoKF3p, Matrix.mul_apply, Fin.sum_univ_two]

lemma theta_mulVec_v0 (x y : K) :
    pmKF3p (((thetaKF3p x y : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ
      vmKF3p 1) =
      (uUpKF3p x : Matrix (Fin 2) (Fin 2) K) * (uLoKF3p y : Matrix (Fin 2) (Fin 2) K) := by
  unfold thetaKF3p
  rw [Units.val_mul, ← Matrix.mulVec_mulVec, rhoRKF3p_apply, uLo_neg_inv, rhoLKF3p_apply,
    pm_lmKF3p, pm_rmKF3p, pm_vm_KF3p, Matrix.one_mul]

lemma theta_zero_left (y : K) : thetaKF3p 0 y ∈ factorTwoKF3p (K := K) := by
  unfold thetaKF3p
  rw [uUp_zero, map_one, one_mul]
  exact ⟨_, rfl⟩

lemma theta_zero_right (x : K) : thetaKF3p x 0 ∈ factorOneKF3p (K := K) := by
  unfold thetaKF3p
  rw [neg_zero, uLo_zero, map_one, mul_one]
  exact ⟨_, rfl⟩

lemma core_KF3p (h4 : 4 ≤ Nat.card K) (Γ : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)
    (S : Set (GL (Fin 2 ⊕ Fin 2) K)) (hSP : ∀ s ∈ S, s ∈ sylowP0KF3p (K := K))
    (hfin : ∀ s ∈ S, ∃ c : K, ((s : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) - 1 = c • Γ)
    (hS : ∀ c : K, ∃ s ∈ S, ((s : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) - 1 = c • Γ) :
    (∀ s ∈ S, s ∈ factorOneKF3p (K := K)) ∨ (∀ s ∈ S, s ∈ factorTwoKF3p (K := K)) := by
  set v₀ : Fin 2 ⊕ Fin 2 → K := vmKF3p 1 with hv₀
  set G₀ : Matrix (Fin 2) (Fin 2) K := pmKF3p (Γ *ᵥ v₀) with hG₀
  have entries : ∀ (x y c : K) (s : GL (Fin 2 ⊕ Fin 2) K), s = thetaKF3p x y →
      ((s : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) - 1 = c • Γ →
      x = c * G₀ 0 1 ∧ y = c * G₀ 1 0 ∧ x * y = c * G₀ 0 0 := by
    intro x y c s hs hsc
    have hvec : ((s : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) *ᵥ v₀ = c • (Γ *ᵥ v₀) + v₀ := by
      have := congrArg (fun M : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K => M *ᵥ v₀) hsc
      simp only [Matrix.sub_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec] at this
      exact sub_eq_iff_eq_add.mp this
    have hp := congrArg pmKF3p hvec
    rw [pm_add_KF3p, pm_smul_KF3p, hs, theta_mulVec_v0, hv₀, pm_vm_KF3p] at hp
    have hpm : (uUpKF3p x : Matrix (Fin 2) (Fin 2) K) * (uLoKF3p y : Matrix (Fin 2) (Fin 2) K) - 1 =
        c • G₀ := by
      rw [hp, hG₀]
      abel
    rw [uUp_lo_sub_one] at hpm
    refine ⟨?_, ?_, ?_⟩
    · have := congrFun (congrFun hpm 0) 1
      simpa using this
    · have := congrFun (congrFun hpm 1) 0
      simpa using this
    · have := congrFun (congrFun hpm 0) 0
      simpa using this
  obtain ⟨c₀, hc₀0, hc₀⟩ := CFSG.ClassicalModels.exists_ne_zero_sq_ne_one_of_four_le_card K h4
  have hc₀1 : c₀ ≠ 1 := fun h => hc₀ (by rw [h, one_pow])
  have hne : c₀ ^ 2 - c₀ ≠ 0 := by
    have : c₀ ^ 2 - c₀ = c₀ * (c₀ - 1) := by ring
    rw [this]
    exact mul_ne_zero hc₀0 (sub_ne_zero.mpr hc₀1)
  obtain ⟨s₁, hs₁, hsc₁⟩ := hS 1
  obtain ⟨s₂, hs₂, hsc₂⟩ := hS c₀
  obtain ⟨x₁, y₁, hθ₁⟩ := sylowP0_mem_param (hSP s₁ hs₁)
  obtain ⟨x₂, y₂, hθ₂⟩ := sylowP0_mem_param (hSP s₂ hs₂)
  obtain ⟨e1x, e1y, e1xy⟩ := entries x₁ y₁ 1 s₁ hθ₁ (by simpa using hsc₁)
  obtain ⟨e2x, e2y, e2xy⟩ := entries x₂ y₂ c₀ s₂ hθ₂ hsc₂
  have hprod : G₀ 0 1 * G₀ 1 0 = 0 := by
    have f1 : G₀ 0 1 * G₀ 1 0 - G₀ 0 0 = 0 := by
      rw [e1x, e1y] at e1xy
      linear_combination e1xy
    have f2 : c₀ ^ 2 * (G₀ 0 1 * G₀ 1 0) - c₀ * G₀ 0 0 = 0 := by
      rw [e2x, e2y] at e2xy
      linear_combination e2xy
    have h3 : (c₀ ^ 2 - c₀) * (G₀ 0 1 * G₀ 1 0) = 0 := by
      linear_combination f2 - c₀ * f1
    exact (mul_eq_zero.mp h3).resolve_left hne
  rcases mul_eq_zero.mp hprod with h0 | h0
  · right
    intro s hs
    obtain ⟨x, y, hθ⟩ := sylowP0_mem_param (hSP s hs)
    obtain ⟨c, hc⟩ := hfin s hs
    obtain ⟨ex, -, -⟩ := entries x y c s hθ hc
    rw [h0, mul_zero] at ex
    rw [hθ, ex]
    exact theta_zero_left y
  · left
    intro s hs
    obtain ⟨x, y, hθ⟩ := sylowP0_mem_param (hSP s hs)
    obtain ⟨c, hc⟩ := hfin s hs
    obtain ⟨-, ey, -⟩ := entries x y c s hθ hc
    rw [h0, mul_zero] at ey
    rw [hθ, ey]
    exact theta_zero_right x

lemma line_all_KF3p {Γ : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K} (hΓ : Γ ≠ 0)
    (A : Subgroup (GL (Fin 2 ⊕ Fin 2) K)) (hA : Nat.card A = Nat.card K)
    (hline : ∀ c : K, ∃ a ∈ A,
      ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1 = c • Γ) :
    ∀ a ∈ A, ∃ c : K, ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) -
      1 = c • Γ := by
  classical
  set T : Set (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) :=
    (fun a : GL (Fin 2 ⊕ Fin 2) K => ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) - 1) ''
      (A : Set (GL (Fin 2 ⊕ Fin 2) K)) with hT
  set L : Set (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) :=
    (fun c : K => c • Γ) '' Set.univ with hL
  have hsub : L ⊆ T := by
    rintro _ ⟨c, -, rfl⟩
    obtain ⟨a, ha, hac⟩ := hline c
    exact ⟨a, ha, hac⟩
  have hinjT : Function.Injective (fun a : GL (Fin 2 ⊕ Fin 2) K =>
      ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1) := by
    intro a b h
    apply Units.ext
    simpa using h
  have hinjL : Function.Injective (fun c : K => c • Γ) := smul_left_injective K hΓ
  have hAn : (A : Set (GL (Fin 2 ⊕ Fin 2) K)).ncard = Nat.card K := by
    rw [← hA]
    exact (Nat.card_coe_set_eq _).symm
  have hcardT : T.ncard = Nat.card K := by
    rw [hT, Set.ncard_image_of_injective _ hinjT, hAn]
  have hcardL : L.ncard = Nat.card K := by
    rw [hL, Set.ncard_image_of_injective _ hinjL, Set.ncard_univ]
  have heq : L = T :=
    Set.eq_of_subset_of_ncard_le hsub (by rw [hcardT, hcardL]) (Set.toFinite _)
  intro a ha
  have hmem : ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) - 1 ∈ L := by
    rw [heq, hT]
    exact ⟨a, ha, rfl⟩
  obtain ⟨c, -, hc⟩ := hmem
  exact ⟨c, hc.symm⟩

lemma conj_sub_one_KF3p (g a : GL (Fin 2 ⊕ Fin 2) K) :
    ((g⁻¹ * a * g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1 =
      ((g⁻¹ : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) *
        (((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) - 1) *
        ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix _ _ K) := by
  have hgg : ((g⁻¹ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *
      ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  simp only [Units.val_mul, Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, Matrix.mul_assoc, hgg]

lemma factorTwo_normalizes (h4 : 4 ≤ Nat.card K) {g : GL (Fin 2 ⊕ Fin 2) K}
    (hg : g ∈ StatedOmega (StatedQuadPlus 2 K)) {x : GL (Fin 2 ⊕ Fin 2) K}
    (hx : x ∈ factorTwoKF3p (K := K)) : g * x * g⁻¹ ∈ factorTwoKF3p (K := K) := by
  have hle : factorOneKF3p (K := K) ⊔ factorTwoKF3p (K := K) ≤
      Subgroup.normalizer ((factorTwoKF3p (K := K)) : Set (GL (Fin 2 ⊕ Fin 2) K)) := by
    apply sup_le _ Subgroup.le_normalizer
    intro y hy
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · intro hh
      have e := factorOne_factorTwo_commute y h hy hh
      rw [e, mul_inv_cancel_right]
      exact hh
    · intro hh
      have e := factorOne_factorTwo_commute y (y * h * y⁻¹) hy hh
      have hz : h = y * h * y⁻¹ := by
        calc h = y⁻¹ * ((y * h * y⁻¹) * y) := by group
          _ = y⁻¹ * (y * (y * h * y⁻¹)) := by rw [e]
          _ = y * h * y⁻¹ := by group
      rw [hz]
      exact hh
  have hg' : g ∈ factorOneKF3p (K := K) ⊔ factorTwoKF3p (K := K) := by
    rw [factorOne_sup_factorTwo h4]
    exact hg
  exact (Subgroup.mem_normalizer_iff.mp (hle hg') x).mp hx

lemma plus_line_KF3p (h4 : 4 ≤ Nat.card K) (A : Subgroup (GL (Fin 2 ⊕ Fin 2) K))
    (hA : A ≤ StatedOmega (StatedQuadPlus 2 K)) (hcard : Nat.card A = Nat.card K)
    (Γ : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) (hΓ : Γ ≠ 0)
    (hline : ∀ c : K, ∃ a ∈ A,
      ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1 = c • Γ) :
    A ≤ factorOneKF3p (K := K) ∨ A ≤ factorTwoKF3p (K := K) := by
  obtain ⟨g, hg, hconj⟩ := sylow_conj_KF3p h4 A hA hcard
  set Γ' : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K :=
    ((g⁻¹ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) * Γ *
      ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)
  set S : Set (GL (Fin 2 ⊕ Fin 2) K) := {s | ∃ a ∈ A, s = g⁻¹ * a * g}
  have hSP : ∀ s ∈ S, s ∈ sylowP0KF3p (K := K) := by
    rintro s ⟨a, ha, rfl⟩
    exact hconj a ha
  have hfin : ∀ s ∈ S, ∃ c : K,
      ((s : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1 = c • Γ' := by
    rintro s ⟨a, ha, rfl⟩
    obtain ⟨c, hc⟩ := line_all_KF3p hΓ A hcard hline a ha
    exact ⟨c, by rw [conj_sub_one_KF3p, hc, Matrix.mul_smul, Matrix.smul_mul]⟩
  have hS : ∀ c : K, ∃ s ∈ S,
      ((s : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1 = c • Γ' := by
    intro c
    obtain ⟨a, ha, hac⟩ := hline c
    exact ⟨g⁻¹ * a * g, ⟨a, ha, rfl⟩,
      by rw [conj_sub_one_KF3p, hac, Matrix.mul_smul, Matrix.smul_mul]⟩
  have hgconj : ∀ a : GL (Fin 2 ⊕ Fin 2) K, g * (g⁻¹ * a * g) * g⁻¹ = a := fun a => by group
  rcases core_KF3p h4 Γ' S hSP hfin hS with h | h
  · left
    intro a ha
    have hn := factorOne_normalizes h4 hg (h _ ⟨a, ha, rfl⟩)
    rwa [hgconj] at hn
  · right
    intro a ha
    have hn := factorTwo_normalizes h4 hg (h _ ⟨a, ha, rfl⟩)
    rwa [hgconj] at hn

lemma plus_part_KF3p (h4 : 4 ≤ Nat.card K) : ∃ F₁ F₂ : Subgroup (GL (Fin 2 ⊕ Fin 2) K),
    F₁ ⊔ F₂ = StatedOmega (StatedQuadPlus 2 K) ∧ F₁ ⊓ F₂ = ⊥ ∧
    (∀ a ∈ F₁, ∀ b ∈ F₂, a * b = b * a) ∧
    IsSLModel 2 (Nat.card K) ↥F₁ ∧ IsSLModel 2 (Nat.card K) ↥F₂ ∧
    ∀ A : Subgroup (GL (Fin 2 ⊕ Fin 2) K), A ≤ StatedOmega (StatedQuadPlus 2 K) →
      IsPGroup 2 A → Nat.card A = Nat.card K →
      (∃ Γ : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K, Γ ≠ 0 ∧
        ∀ c : K, ∃ a ∈ A,
          ((a : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) - 1 = c • Γ) →
      A ≤ F₁ ∨ A ≤ F₂ :=
  ⟨factorOneKF3p, factorTwoKF3p, factorOne_sup_factorTwo h4, factorOne_inf_factorTwo,
    fun a ha b hb => factorOne_factorTwo_commute a b ha hb, factorOne_isSL,
    factorTwo_isSL,
    fun A hA _ hcard ⟨Γ, hΓ, hline⟩ => plus_line_KF3p h4 A hA hcard Γ hΓ hline⟩

end Plus

theorem omegaLine_holds : OmegaLineStatement := by
  intro K _ _ _ h4
  refine ⟨plus_part_KF3p h4, fun b c hirr A hA _ _ hΓ => ?_⟩
  obtain ⟨Γ, hΓ0, hline⟩ := hΓ
  exact minus_line_false_KF3p hirr h4 A hA Γ hΓ0 hline

