@[expose] def e6SimpleList (i : Fin 6) : List (List ℤ) := e6SimpleLists.getD i.val []

theorem weylMatrix_simple (i : Fin 6) :
    weylMatrix ((coxeterSystem Tag.E6).simple (e6Index i)) = toMat Tag.E6.rank (e6SimpleList i) := by
  have key : ∀ i j : Fin 6, (e6Word [i]).foldr (reflect Tag.E6) (Pi.single (e6Index j) 1) =
      fun a => toMat Tag.E6.rank (e6SimpleList i) a (e6Index j) := by
    decide +kernel
  have h := weylMatrix_wordProd_e6 (ω := [i]) (M := toMat Tag.E6.rank (e6SimpleList i)) (key i)
  change weylMatrix ((coxeterSystem Tag.E6).wordProd [e6Index i]) = _ at h
  rwa [CoxeterSystem.wordProd_singleton] at h

