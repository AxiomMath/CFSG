structure HessSetup {G : Type} [Group G] [Finite G] (p : ℕ) (A : Subgroup G) (c : G)
    (L : Subgroup G) (f : ℕ) (P : Subgroup (MulAut A)) (z : MulAut A) : Prop where
  ctx : HessCtx p A c L
  good : ∀ J ∈ thetaCompZeroStarE p A, ∃ c' : G, JGood p A c' J
  model : ∀ J ∈ thetaCompZeroStarE p A,
    StatedClassicalModel (↥J ⧸ Subgroup.center ↥J) .PSL 3 2 f
  f_dvd : p ∣ 2 ^ f - 1
  f_odd : 2 ^ f % 3 = 2
  pair : ∀ t ∈ reflectionSet p A, ∀ s ∈ reflectionSet p A, t * s ≠ s * t →
    ∃ I ∈ thetaCompZeroStarE p A, t ∈ torusImage A I ∧ s ∈ torusImage A I
  spec : HessianSpec p A P z
  card : Nat.card (reflectionGroup p A) = 54
  griess : CFSG.Open.GriessAllModelsStatement

section Defs

variable {G : Type} [Group G] [Finite G]

@[expose] noncomputable def KNode (p : ℕ) (A : Subgroup G) (t : MulAut A) : Subgroup G :=
  sSup {K | ∃ J ∈ thetaCompZeroStarE p A, t ∈ torusImage A J ∧ K = Kof A J t}

@[expose] def RootSet (A : Subgroup G) (f : ℕ) (p : ℕ) (t : MulAut A) : Set (Subgroup G) :=
  {S | S ≤ KNode p A t ∧ (∀ s ∈ S, s * s = 1) ∧ Nat.card S = 2 ^ f ∧
    ∀ a ∈ A, ∀ s ∈ S, a * s * a⁻¹ ∈ S}

@[expose] def RootPairs (p : ℕ) (A : Subgroup G) (f : ℕ) : Set (MulAut A × Subgroup G) :=
  {r | r.1 ∈ reflectionSet p A ∧ r.2 ∈ RootSet A f p r.1}

@[expose] noncomputable def actPair (A : Subgroup G) (g : G) (r : MulAut A × Subgroup G) :
    MulAut A × Subgroup G :=
  (piAut A g * r.1 * (piAut A g)⁻¹, conjBy g r.2)

end Defs

section Setup

variable {G : Type} [Group G] [Finite G] {p : ℕ} {A : Subgroup G} {c : G} {L : Subgroup G} {f : ℕ}
  {P : Subgroup (MulAut A)} {z : MulAut A}

theorem HessSetup.prime (hS : HessSetup p A c L f P z) : p.Prime := hS.ctx.hyp.prime

theorem HessSetup.moved (hS : HessSetup p A c L f P z) :
    ∀ t ∈ reflectionSet p A, Nat.card (autMovedInG A t) = p := fun t ht =>
  (hS.ctx.facts13.reflection t ht).2.2

theorem HessSetup.kt1 (hS : HessSetup p A c L f P z) : JLemmaKt1 := jLemmaKt1_holds hS.griess

theorem HessSetup.kNode_eq (hS : HessSetup p A c L f P z) {J : Subgroup G}
    (hJ : J ∈ thetaCompZeroStarE p A) {t : MulAut A} (ht : t ∈ reflectionSet p A)
    (htJ : t ∈ torusImage A J) : KNode p A t = Kof A J t := by
  have hset : {K | ∃ J' ∈ thetaCompZeroStarE p A, t ∈ torusImage A J' ∧ K = Kof A J' t} =
      {Kof A J t} := by
    ext K
    constructor
    · rintro ⟨J', hJ', htJ', rfl⟩
      obtain ⟨c1, h1⟩ := hS.good J hJ
      obtain ⟨c2, h2⟩ := hS.good J' hJ'
      exact (Kof_eq_of_share hS.kt1 h1 h2 hS.moved ht htJ htJ' hS.f_dvd (hS.model J hJ) hS.f_dvd
        (hS.model J' hJ')).symm
    · intro hK
      exact ⟨J, hJ, htJ, hK⟩
  unfold KNode
  rw [hset, sSup_singleton]

omit [Finite G] in
theorem inf_conjBy (g : G) (H K : Subgroup G) : conjBy g (H ⊓ K) = conjBy g H ⊓ conjBy g K := by
  unfold conjBy
  exact Subgroup.map_inf H K _ (MulAut.conj g).injective

omit [Finite G] in
theorem commutator_conjBy (g : G) (H : Subgroup G) : conjBy g ⁅H, H⁆ = ⁅conjBy g H, conjBy g H⁆ := by
  unfold conjBy
  exact Subgroup.map_commutator H H _

omit [Finite G] in
theorem kof_conjBy (A J : Subgroup G) (t : MulAut A) {g : G} (hg : g ∈ torusNormalizer A) :
    Kof A (conjBy g J) (conjAut A g hg * t * (conjAut A g hg)⁻¹) = conjBy g (Kof A J t) := by
  unfold Kof Nt
  rw [Equivariance.autFixedInG_conj t hg, Equivariance.centralizer_conjBy, ← inf_conjBy,
    ← commutator_conjBy]

theorem HessSetup.kNode_conj (hS : HessSetup p A c L f P z) {g : G} (hg : g ∈ torusNormalizer A)
    {t : MulAut A} (ht : t ∈ reflectionSet p A) :
    piAut A g * t * (piAut A g)⁻¹ ∈ reflectionSet p A ∧
      KNode p A (piAut A g * t * (piAut A g)⁻¹) = conjBy g (KNode p A t) := by
  rw [piAut_of_mem hg]
  have ht' : conjAut A g hg * t * (conjAut A g hg)⁻¹ ∈ reflectionSet p A :=
    conj_mem_reflectionSet hS.prime ht hg
  refine ⟨ht', ?_⟩
  have ht0 := ht
  obtain ⟨-, J, hJ, htJ⟩ := ht0
  have hJ' : conjBy g J ∈ thetaCompZeroStarE p A := conjBy_mem_thetaCompZeroStarE hS.prime hg hJ
  have htJ' : conjAut A g hg * t * (conjAut A g hg)⁻¹ ∈ torusImage A (conjBy g J) := by
    rw [torusImage_conjBy A J hg]
    exact Subgroup.mem_map_of_mem (MulAut.conj (conjAut A g hg)).toMonoidHom htJ
  rw [hS.kNode_eq hJ' ht' htJ', hS.kNode_eq hJ ht htJ, kof_conjBy]

omit [Finite G] in
theorem inv_conj_mem {A : Subgroup G} {g a : G} (hg : g ∈ torusNormalizer A) (ha : a ∈ A) :
    g⁻¹ * a * g ∈ A := by
  have := (Subgroup.mem_normalizer_iff.1 ((torusNormalizer A).inv_mem hg) a).1 ha
  simpa using this

theorem HessSetup.conjBy_mem_rootSet (hS : HessSetup p A c L f P z) {g : G}
    (hg : g ∈ torusNormalizer A) {t : MulAut A} (ht : t ∈ reflectionSet p A) {S : Subgroup G}
    (hSr : S ∈ RootSet A f p t) :
    conjBy g S ∈ RootSet A f p (piAut A g * t * (piAut A g)⁻¹) := by
  obtain ⟨hSK, hsq, hcard, hinv⟩ := hSr
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [(hS.kNode_conj hg ht).2]
    exact Subgroup.map_mono hSK
  · intro s hs
    rw [Equivariance.mem_conjBy] at hs
    have h1 := hsq _ hs
    calc s * s = g * ((g⁻¹ * s * g) * (g⁻¹ * s * g)) * g⁻¹ := by group
      _ = 1 := by rw [h1]; group
  · unfold conjBy
    rw [Subgroup.card_map_of_injective (MulAut.conj g).injective]
    exact hcard
  · intro a ha s hs
    rw [Equivariance.mem_conjBy] at hs ⊢
    have h1 := hinv _ (inv_conj_mem hg ha) _ hs
    have e : g⁻¹ * (a * s * a⁻¹) * g = (g⁻¹ * a * g) * (g⁻¹ * s * g) * (g⁻¹ * a * g)⁻¹ := by group
    rw [e]
    exact h1

theorem HessSetup.exists_line (hS : HessSetup p A c L f P z) {t : MulAut A}
    (ht : t ∈ reflectionSet p A) :
    ∃ (J : Subgroup G) (_ : J ∈ thetaCompZeroStarE p A) (K : Type) (_ : Field K) (_ : Finite K)
      (_ : CharP K 2) (ρ : SL3 K →* G) (c' : G), LineHyp p A c' J f ρ ∧ t ∈ torusImage A J := by
  obtain ⟨-, J, hJ, htJ⟩ := ht
  obtain ⟨c', hJg⟩ := hS.good J hJ
  obtain ⟨K, hKf, hKfin, hK, ρ, hρ⟩ := exists_psl3Data hS.griess hJg hS.f_dvd (hS.model J hJ)
  have hKc : CharP K 2 := charP_two_of_card hK
  exact ⟨J, hJ, K, hKf, hKfin, hKc, ρ, c', ⟨hJg, hρ, hK, hS.f_dvd⟩, htJ⟩

omit [Finite G] in
theorem isAutReflection_sq {t : MulAut A} (ht : IsAutReflection p A t) : t * t = 1 ∧ t ≠ 1 := by
  obtain ⟨ho, -⟩ := ht
  refine ⟨?_, fun h => ?_⟩
  · have := pow_orderOf_eq_one t
    rwa [ho, sq] at this
  · rw [h, orderOf_one] at ho
    omega

theorem HessSetup.rootSet_eq_two (hS : HessSetup p A c L f P z) {t : MulAut A}
    (ht : t ∈ reflectionSet p A) :
    ∃ S₁ S₂ : Subgroup G, S₁ ≠ S₂ ∧ RootSet A f p t = {S₁, S₂} := by
  obtain ⟨J, hJ, K, hKf, hKfin, hKc, ρ, c', hL, htJ⟩ := hS.exists_line ht
  obtain ⟨ht2, ht1⟩ := isAutReflection_sq ht.1
  obtain ⟨i, j, hij, rfl⟩ := hL.exists_nodeOf_eq htJ ht2 ht1
  have hset : RootSet A f p (nodeOf A ρ i j) = RootSetJ A J f (nodeOf A ρ i j) := by
    ext S
    simp only [RootSet, RootSetJ, hS.kNode_eq hJ ht htJ]
  rw [hset, hL.rootSetJ_eq hij]
  exact ⟨rootG ρ hij, rootG ρ hij.symm, hL.rootG_ne hij, rfl⟩

end Setup

