section Witt

variable {K : Type} [Field K] [Finite K] {b c : K}

omit [Finite K] in
theorem r_le_three (hbc : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {r : ℕ} {U : Type} [AddCommGroup U] [Module K U]
    [FiniteDimensional K U] {qU : QuadraticForm K U}
    (e : (quadMinus 4 K b c).IsometryEquiv (quadTail r qU)) : r ≤ 3 := by
  have θ : (quadTail r qU).IsometryEquiv (quadTail (4 - 1) (minusTailForm K b c)) :=
    e.symm.trans (minusTailIsometry 4 K b c).symm
  have hsing : ∀ x ∈ (tailFlag K U r r).map θ.toLinearEquiv.toLinearMap,
      quadTail (4 - 1) (minusTailForm K b c) x = 0 := by
    rintro _ ⟨t, ht, rfl⟩
    have := θ.map_app t
    rw [LinearEquiv.coe_coe, IsometryEquiv.coe_toLinearEquiv, this]
    exact quadTail_eq_zero_of_mem_tailFlag ht
  have h1 := finrank_le_of_totSing_tail (anisotropic_minusTailForm hbc) hsing
  rw [LinearEquiv.finrank_map_eq, finrank_tailFlag_top] at h1
  omega

end Witt

section Main

variable {X : Type} [Group X] {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}

local notation "V₈" => (Fin (4 - 1) ⊕ Fin (4 - 1) ⊕ Fin 2 → K)

theorem exists_tail_model (hbc : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (φ₀ : X ≃* projOmegaMinus 3 K b c)
    {p : ℕ} [NeZero p] (hp : p.Prime) (hp2 : p ≠ 2) {ζ : Kˣ} (hζ : IsPrimitiveRoot ζ p)
    (E' : Subgroup X) (hEcard : Nat.card E' = p ^ 3) (hEexp : ∀ x ∈ E', x ^ p = 1)
    (hEcomm : ∀ x ∈ E', ∀ y ∈ E', x * y = y * x) :
    ∃ (A : Type) (_ : AddCommGroup A) (_ : Module K A) (_ : FiniteDimensional K A) (qA : QuadraticForm K A)
      (_ : (polarBilin qA).Nondegenerate) (_ : qA.Anisotropic) (_ : finrank K A = 2) (ψ : X ≃* ↥(Om qA 3)),
      E'.map ψ.toMonoidHom = Tg qA hζ := by
  classical
  have hQ := S15K.polar_nondegenerate_quadMinus hbc
  have : Nontrivial V₈ := by
    have : Inhabited (Fin (4 - 1) ⊕ Fin (4 - 1) ⊕ Fin 2) := ⟨Sum.inl ⟨0, by omega⟩⟩
    exact Pi.nontrivial
  set Q := quadMinus 4 K b c with hQdef
  let ψ₀ : X ≃* ↥(orthDerived Q) :=
    (φ₀.trans (S15K.projOmegaMinusEquivOrth K b c)).trans
      (MulEquiv.ofBijective (piOrth Q) ⟨piOrth_injective hQ, piOrth_surjective⟩).symm
  let Eo : Subgroup (V₈ ≃ₗ[K] V₈) := (E'.map ψ₀.toMonoidHom).map (orthDerived Q).subtype
  have hEoCard : Nat.card Eo = p ^ 3 := by
    rw [Subgroup.card_map_of_injective (orthDerived Q).subtype_injective,
      Subgroup.card_map_of_injective ψ₀.injective, hEcard]
  have : Finite Eo := Nat.finite_of_card_ne_zero (by rw [hEoCard]; exact pow_ne_zero 3 hp.ne_zero)
  have hEo : ∀ g ∈ Eo, ∃ x ∈ E', g = ((ψ₀ x : ↥(orthDerived Q)) : V₈ ≃ₗ[K] V₈) := by
    intro g hg
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.1 hg
    obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hy
    exact ⟨x, hx, rfl⟩
  have : IsMulCommutative Eo := ⟨⟨fun a b => by
    obtain ⟨x, hx, hxa⟩ := hEo a.1 a.2
    obtain ⟨y, hy, hyb⟩ := hEo b.1 b.2
    apply Subtype.ext
    show a.1 * b.1 = b.1 * a.1
    rw [hxa, hyb]
    have := congrArg (fun z : X => ((ψ₀ z : ↥(orthDerived Q)) : V₈ ≃ₗ[K] V₈)) (hEcomm x hx y hy)
    simpa using this⟩⟩
  have hζK : IsPrimitiveRoot (ζ : K) p := IsPrimitiveRoot.coe_units_iff.2 hζ
  have hGQ : Eo ≤ TauCeti.QuadraticMap.orthogonalGroup Q := by
    intro g hg
    obtain ⟨x, -, rfl⟩ := hEo g hg
    exact Subgroup.commutator_le_of_le le_rfl le_rfl (ψ₀ x).2
  have hGexp : ∀ g ∈ Eo, g ^ p = 1 := by
    intro g hg
    obtain ⟨x, hx, rfl⟩ := hEo g hg
    have : (ψ₀ x) ^ p = 1 := by rw [← map_pow, hEexp x hx, map_one]
    have := congrArg (fun z : ↥(orthDerived Q) => (z : V₈ ≃ₗ[K] V₈)) this
    simpa using this
  have hGcard : (Nat.card Eo : K) ≠ 0 := by
    rw [hEoCard]
    push_cast
    refine pow_ne_zero 3 ?_
    intro h
    rw [CharP.cast_eq_zero_iff K 2] at h
    exact hp2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).1 h).symm
  obtain ⟨r, U, φ, χ, hQφ, hUan, hUnd, hdiag, hUfix⟩ :=
    KCOrthogonal.exists_split_coordinates hQ hp hp2 hζK Eo hGQ hGexp hGcard
  have hr3 : r ≤ 3 := r_le_three hbc (⟨φ, hQφ⟩ : Q.IsometryEquiv (quadTail r (Q.comp U.subtype)))
  have hinj : Function.Injective (fun (g : Eo) (i : Fin r) => (χ i g).toAdd) := by
    intro g g' h
    have hχ : ∀ i, χ i g = χ i g' := fun i => Multiplicative.toAdd.injective (congrFun h i)
    have : LinearEquiv.autCongr φ (g : V₈ ≃ₗ[K] V₈) = LinearEquiv.autCongr φ (g' : V₈ ≃ₗ[K] V₈) := by
      refine ext_frame_tail (fun j => ?_) (fun a => ?_)
      · rcases j with i | i
        · rw [(hdiag g i).1, (hdiag g' i).1, hχ i]
        · rw [(hdiag g i).2, (hdiag g' i).2, hχ i]
      · rw [hUfix g a, hUfix g' a]
    exact Subtype.ext ((LinearEquiv.autCongr φ).injective this)
  have hr3' : 3 ≤ r := by
    have hcardle : Nat.card Eo ≤ Nat.card (Fin r → ZMod p) := Nat.card_le_card_of_injective _ hinj
    rw [hEoCard, Nat.card_fun, Nat.card_zmod] at hcardle
    simp only [Nat.card_eq_fintype_card, Fintype.card_fin] at hcardle
    exact (Nat.pow_le_pow_iff_right hp.one_lt).1 hcardle
  obtain rfl : r = 3 := le_antisymm hr3 hr3'
  have hdimV : finrank K V₈ = 8 := by
    rw [Module.finrank_fintype_fun_eq_card]
    simp
  have hU2 : finrank K U = 2 := by
    have h1 := LinearEquiv.finrank_eq φ
    rw [hdimV, Module.finrank_prod, Module.finrank_fintype_fun_eq_card] at h1
    simp at h1
    exact Nat.add_left_cancel (h1.symm.trans (by norm_num : 8 = 6 + 2))
  set qU : QuadraticForm K ↥U := Q.comp U.subtype with hqU
  have hreg : (polarBilin qU).Nondegenerate := nondegenerate_polarBilin_restrict hUnd
  have hani : qU.Anisotropic := fun x hx => Subtype.ext (hUan x x.2 hx)
  let ψ : X ≃* ↥(Om qU 3) := ψ₀.trans (orthDerivedEquiv (⟨φ, hQφ⟩ : Q.IsometryEquiv (quadTail 3 qU)))
  have hle : E'.map ψ.toMonoidHom ≤ Tg qU hζ := by
    rintro _ ⟨x, hx, rfl⟩
    have hgx : ((ψ₀ x : ↥(orthDerived Q)) : V₈ ≃ₗ[K] V₈) ∈ Eo := ⟨ψ₀ x, ⟨x, hx, rfl⟩, rfl⟩
    set gx : Eo := ⟨_, hgx⟩ with hgxdef
    show ((ψ x : ↥(Om qU 3)) : VG K ↥U 3) ∈ (torP (K := K) (A := ↥U) hζ).range
    refine ⟨Multiplicative.ofAdd (fun i => (χ i gx).toAdd), ?_⟩
    have hψx : ((ψ x : ↥(Om qU 3)) : VG K ↥U 3) =
        LinearEquiv.autCongr φ ((ψ₀ x : ↥(orthDerived Q)) : V₈ ≃ₗ[K] V₈) :=
      LinearEquiv.ext fun v => by
        rw [LinearEquiv.autCongr_apply_apply]
        rfl
    rw [hψx]
    refine ext_frame_tail (fun j => ?_) (fun a => ?_)
    · rw [torP_apply]
      rcases j with i | i
      · refine Eq.trans ?_ (hdiag gx i).1.symm
        rw [torH_hypVec, wt_dOf_inl]
        simp [zpowE]
      · refine Eq.trans ?_ (hdiag gx i).2.symm
        rw [torH_hypVec, wt_inr]
        simp [dOf, zpowE]
    · rw [torP_apply, torH_snd_zero]
      exact (hUfix gx a).symm
  refine ⟨↥U, inferInstance, inferInstance, inferInstance, qU, hreg, hani, hU2, ψ, ?_⟩
  have hcardT := card_Tg hreg hζ
  have : Finite ↥(Tg qU hζ) := Nat.finite_of_card_ne_zero (by rw [hcardT]; exact pow_ne_zero 3 hp.ne_zero)
  refine Subgroup.eq_of_le_of_card_ge hle ?_
  rw [hcardT, Subgroup.card_map_of_injective ψ.injective, hEcard]

theorem exists_rootData_of_omegaMinus (hbc : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (φ₀ : X ≃* projOmegaMinus 3 K b c)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) {ζ : Kˣ} (hζ : IsPrimitiveRoot ζ p) (hK4 : 4 ≤ Nat.card K)
    (E' : Subgroup X) (hEcard : Nat.card E' = p ^ 3) (hEexp : ∀ x ∈ E', x ^ p = 1)
    (hEcomm : ∀ x ∈ E', ∀ y ∈ E', x * y = y * x) :
    ∃ R : CFSG.RankThree.PartOne.KFCL.RootData p E', Nonempty (R.ReflData 48) := by
  have : NeZero p := ⟨hp.ne_zero⟩
  obtain ⟨A, _, _, _, qA, hreg, hani, hdim, ψ, hψ⟩ :=
    exists_tail_model hbc φ₀ hp (by omega) hζ E' hEcard hEexp hEcomm
  obtain ⟨R0, ⟨rd⟩⟩ := exists_rootData_tail hp hp5 hK4 hreg hani hdim hζ
  have hT : (Tg qA hζ).map ψ.symm.toMonoidHom = E' := by
    rw [← hψ, Subgroup.map_map]
    have : ψ.symm.toMonoidHom.comp ψ.toMonoidHom = MonoidHom.id X := by
      ext x
      simp
    rw [this, Subgroup.map_id]
  rw [← hT]
  exact ⟨R0.map ψ.symm, ⟨rd.map ψ.symm⟩⟩

end Main

section Row

open CFSG CFSG.Assembly CFSG.RankThree CFSG.RankThree.PartOne

theorem rootModelRow_three : KFCL.RootModelRow 3 := by
  intro G _ _ p A c L E h15 hF hF13 hout hEI
  have h := h15.h12
  obtain ⟨f, hf1, hpf, ⟨b, c', hbc, ⟨φ⟩⟩, -, hEA, -⟩ := hout
  have hp : p.Prime := h.prime
  have hp3 : 3 < p := h.three_lt
  have hp5 : 5 ≤ p := by
    by_contra hlt
    obtain rfl : p = 4 := by omega
    exact absurd hp (by decide)
  have : NeZero f := ⟨by omega⟩
  have hcardK : Nat.card (GaloisField 2 f) = 2 ^ f := GaloisField.card 2 f (by omega)
  have hpK : p ∣ Nat.card (GaloisField 2 f) - 1 := by rw [hcardK]; exact hpf
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨ζ, hζ⟩ : ∃ ζ : (GaloisField 2 f)ˣ, IsPrimitiveRoot ζ p := by
    have h1 : p ∣ Nat.card (GaloisField 2 f)ˣ := by rw [Nat.card_units]; exact hpK
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' p h1
    exact ⟨x, by simpa [hx] using IsPrimitiveRoot.orderOf x⟩
  have h4 : 4 ≤ Nat.card (GaloisField 2 f) := by
    rw [hcardK]
    have hpos : 0 < 2 ^ f - 1 := by
      have : 2 ≤ 2 ^ f := by
        calc 2 = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf1
      omega
    have := Nat.le_of_dvd hpos hpf
    omega
  have hEel : IsElementaryAbelian p E := h.E_elem
  have hcommE : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := fun a ha b hb => by
    have := congrArg Subtype.val (IsMulCommutative.is_comm.comm (⟨a, ha⟩ : ↥E) ⟨b, hb⟩)
    simpa using this
  have hpowE : ∀ a ∈ E, a ^ p = 1 := fun a ha => elemPow_eq_one_of_isElementaryAbelian a ha
  have hEcard : Nat.card E = p ^ 3 := by rw [hEA]; exact h.A_card
  have hcard' : Nat.card (E.subgroupOf (lieGenerated p E)) = p ^ 3 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hEI).toEquiv]
    exact hEcard
  obtain ⟨R, hR⟩ := exists_rootData_of_omegaMinus hbc φ hp hp5 hζ h4
    (E.subgroupOf (lieGenerated p E)) hcard'
    (fun x hx => Subtype.ext (by simpa using hpowE _ (Subgroup.mem_subgroupOf.1 hx)))
    (fun x hx y hy => Subtype.ext
      (hcommE _ (Subgroup.mem_subgroupOf.1 hx) _ (Subgroup.mem_subgroupOf.1 hy)))
  exact ⟨R, Or.inr (by rw [show KFCL.weylOrder 3 = 48 from rfl]; exact hR)⟩

end Row

