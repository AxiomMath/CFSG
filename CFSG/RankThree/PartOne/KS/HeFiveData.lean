@[expose] def heFiveArr (k : ℕ) : Array ℕ := hexTable 4 8330 (8330 * k) heFiveHex

@[expose] def heFiveRec : List ℕ :=
  [0, 0, 0, 0, 0, 0]

@[expose] def heFiveQGens : Array (Array ℕ) := #[heFiveArr 0, heFiveArr 1]

@[expose] def heFiveTransporters : Array (Array ℕ) :=
  Array.ofFn fun j : Fin 6 => heFiveArr (j + 2)

@[expose] def heFiveC0Gens : Array (Array ℕ) := #[heFiveArr 8, heFiveArr 9, heFiveArr 10]

@[expose] def heFiveDWit0 : Array (Array ℕ) := #[heFiveArr 11, heFiveArr 12]

@[expose] def heFiveDGens0 : Array (Array ℕ) :=
  #[commutatorA 8330 heFiveC0Gens[1]! heFiveC0Gens[2]!, heFiveC0Gens[2]!]

@[expose] def heFiveReps : Array (Array ℕ) :=
  #[heFiveC0Gens[0]!]

@[expose] def heFiveLines : Array (Array ℕ) :=
  Array.ofFn fun j : Fin 6 =>
    conjA 8330 heFiveTransporters[(j : ℕ)]! heFiveReps[heFiveRec.getD j 0 % 1]!

@[expose] noncomputable def heFiveQ : Subgroup (Equiv.Perm (Fin 8330)) :=
  Subgroup.closure (permsA 8330 heFiveQGens)

@[expose] def heFiveLine (j : Fin 6) : Equiv.Perm (Fin 8330) :=
  permOfArr 8330 heFiveLines[(j : ℕ)]!

@[expose] def heFiveTransporter (j : Fin 6) : Equiv.Perm (Fin 8330) :=
  permOfArr 8330 heFiveTransporters[(j : ℕ)]!

@[expose] def heFiveRecordOf (j : Fin 6) : Fin 6 :=
  ⟨heFiveRec.getD j 0 % 6, Nat.mod_lt _ (by norm_num)⟩

@[expose] noncomputable def heFiveC0 : Subgroup (Equiv.Perm (Fin 8330)) :=
  Subgroup.closure (permsA 8330 heFiveC0Gens)

@[expose] noncomputable def heFiveD0 : Subgroup (Equiv.Perm (Fin 8330)) :=
  ⁅heFiveC0, heFiveC0⁆

