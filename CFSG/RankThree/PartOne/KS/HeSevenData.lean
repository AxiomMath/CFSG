@[expose] def heSevenC2Gens : Array (Array ℕ) := #[heSevenArr 70, heSevenArr 71, heSevenArr 72]

@[expose] def heSevenA2Gens : Array (Array ℕ) := #[heSevenArr 73, heSevenArr 74]

