@[expose] def heSevenQGens : Array (Array ℕ) := #[heSevenArr 0, heSevenArr 1]

@[expose] def heSevenTransporters : Array (Array ℕ) :=
  Array.ofFn fun j : Fin 57 => heSevenArr (j + 2)

@[expose] def heSevenC0Gens : Array (Array ℕ) := #[heSevenArr 59, heSevenArr 60, heSevenArr 61]

@[expose] def heSevenA0Gens : Array (Array ℕ) := #[heSevenArr 62, heSevenArr 63, heSevenArr 64]

