@[expose] def heSevenLines : Array (Array ℕ) :=
  Array.ofFn fun j : Fin 57 =>
    conjA 8330 heSevenTransporters[(j : ℕ)]! heSevenReps[heSevenRec.getD j 0 % 3]!

@[expose] noncomputable def heSevenQ : Subgroup (Equiv.Perm (Fin 8330)) :=
  Subgroup.closure (permsA 8330 heSevenQGens)

