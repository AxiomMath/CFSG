  #[commutatorA 4060 ruFiveC1Gens[1]! ruFiveC1Gens[2]!, ruFiveC1Gens[2]!]

@[expose] noncomputable def ruFiveQ : Subgroup (Equiv.Perm (Fin 4060)) :=
  Subgroup.closure (permsA 4060 ruFiveQGens)

@[expose] def ruFiveLine (j : Fin 31) : Equiv.Perm (Fin 4060) :=
  permOfArr 4060 ruFiveLines[(j : ℕ)]!

@[expose] def ruFiveTransporter (j : Fin 31) : Equiv.Perm (Fin 4060) :=
  permOfArr 4060 ruFiveTransporters[(j : ℕ)]!

@[expose] def ruFiveRecordOf (j : Fin 31) : Fin 31 :=
  ⟨ruFiveRec.getD j 0 % 31, Nat.mod_lt _ (by norm_num)⟩

@[expose] noncomputable def ruFiveC0 : Subgroup (Equiv.Perm (Fin 4060)) :=
