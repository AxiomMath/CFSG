theorem two_le_pRank_psl_of_six_le {T : Type} [Group T] [Finite T] {n f₀ : ℕ} (hn : 6 ≤ n)
    (hM : LieModel T .PSL n 2 (7 * f₀)) : 2 ≤ CFSG.pRank 7 T := by
  classical
  have hp : (7 : ℕ).Prime := by norm_num
  have hC : StatedClassicalModel T .PSL n 2 (7 * f₀) :=
    (lieModel_classical_iff (by decide)).mp hM
  obtain ⟨hadm, K, _, _, hK, ⟨e0⟩⟩ := hC
  have hf₀ : 1 ≤ f₀ := by
    have := hadm.2.1
    omega
  let e : T ≃* projectiveSL n K :=
    (e0.trans (projectiveSpecialLinearGroupEquivStatedProj n K).symm).trans
      (LinearCover.projectiveSpecialLinearEquivProjectiveSL n K)
  have : Fintype K := Fintype.ofFinite K
  have hcharK : CharP K 2 := charP_of_card_eq_prime_pow (f := 7 * f₀) (by
    rw [← Nat.card_eq_fintype_card, hK])
  have : NeZero n := ⟨by omega⟩
  rw [pRank_eq_of_mulEquiv_of_one_lt hp.one_lt e]
  have hle : ∀ R : Subgroup (projectiveSL n K), CFSG.IsElementaryAbelian 7 R → Nat.card R = 7 ^ 2 →
      2 ≤ CFSG.pRank 7 (projectiveSL n K) := fun R hRe hRc => by
    rw [CFSG.SectionRank.pRank_eq_open_pRank_top]
    exact CFSG.SectionRank.le_pRank hp.one_lt (le_top : R ≤ ⊤)
      ((CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 7 R).mp hRe) hRc
  by_cases hpK : 7 ∣ Nat.card Kˣ
  · exact two_le_pRank_projectiveSL (by omega) hp (by norm_num) hpK
  · have h8 : 7 ∣ Nat.card K ^ 3 - 1 := by
      have h1 : 8 ^ (7 * f₀) ≡ 1 [MOD 7] := by
        simpa using Nat.ModEq.pow (7 * f₀) (show 8 ≡ 1 [MOD 7] by decide)
      have h2 : Nat.card K ^ 3 = 8 ^ (7 * f₀) := by
        rw [hK, ← pow_mul, mul_comm, pow_mul]
        norm_num
      rw [h2]
      exact (Nat.modEq_iff_dvd' (Nat.one_le_pow _ _ (by norm_num))).mp h1.symm
    obtain ⟨R, U, hRe, hRc, -, -, -⟩ := exists_rank_two_unip_psl (k := K) (e := 3) hp hpK
      (by norm_num) h8 (by omega)
    exact hle R hRe hRc

variable {G : Type} [Group G] [Finite G]

theorem outer_small (hSchreier : SchreierFor InCatalog) (h112 : InSec11Two)
    (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    (hOdd : OddCenterLie) (hHR : ∀ t, TCX.HighRankFalse t) (hF : TagFixedFacts .PSL)
    {A : Subgroup G} (hS : SteinbergBM.SectionTenSetup G 7 A) {K : Subgroup G}
    (hK : K ∈ sectionTenZeroStar 7 A) (hK2 : K ∈ sectionTenTwo 7 A) :
    ∃ (X : Type) (_ : Group X) (_ : Finite X) (φ : ↥K →* X), Function.Surjective φ ∧
      φ.ker ≤ center ↥K ∧ IsSimpleGroup X ∧ (∃ a b : X, a * b ≠ b * a) ∧
      EvenLieTypeSmall X := by
  classical
  have hp : (7 : ℕ).Prime := by norm_num
  have : Fact (7 : ℕ).Prime := ⟨hp⟩
  obtain ⟨hsimple, hnonab, hKP, -, -, -, hAe, -, -, -⟩ := id hS
  have : IsSimpleGroup G := hsimple
  have he3 : evenRank G ≤ 3 := (sectionTenSetup_evenRank_eq hS).le
  obtain ⟨c, hcA, hc1, hKc⟩ := mem_thetaComponentFamily_iff.mp
    ((sectionTenZeroStar_subset 7 A).2.2.1 hK.2)
  obtain ⟨hKq, -, -⟩ := moving_maximal_data_at hSchreier hS hK hcA hc1 hKc
  obtain ⟨-, hZ7, a, -, haA, -, -, -, -, hfa⟩ :=
    h112 G 7 A hS c hcA hc1 K ⟨⟨hK, hK2⟩, hKc⟩
  have hup : a ^ 7 = 1 := elemPow_eq_one_of_isElementaryAbelian (p := 7) (A := A) a haA
  have hcp : c ^ 7 = 1 := elemPow_eq_one_of_isElementaryAbelian (p := 7) (A := A) c hcA
  have hcC : c ∈ centralizer (K : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro k hk
    exact Subgroup.mem_centralizer_singleton_iff.mp ((mem_thetaComponentsAt_iff.mp hKc).1 hk)
  have huc : a * c = c * a := congrArg Subtype.val (hAe.is_comm.comm ⟨a, haA⟩ ⟨c, hcA⟩)
  have hu : a ∈ normalizer (K : Set G) := hfa.1
  have huJ : a ∉ K ⊔ centralizer (K : Set G) := hfa.2.1
  have heK : evenRank ↥K ≤ 3 := (Sec9A.evenRank_subgroup_le K).trans he3
  obtain ⟨t, n, f₀, hf₀, hM, hX⟩ := fieldAutT_of_inducesFieldAut hp hZ7 hu hup hfa
  have hZ2 : ¬ 2 ∣ Nat.card (center ↥K) := hOdd ↥K hKq t n (7 * f₀) (by omega) hM
  have hLow : TCX.LowRank t n := by
    by_contra hnl
    exact hHR t hGA ↥K 7 n f₀ hKq hp (by norm_num) hf₀ hZ2 hZ7 heK hM hnl
  have hadm : StatedLieAdmissible t n 2 (7 * f₀) := statedLieAdmissible_of_lieModel hM
  have hsmall : SmallEvenParams t n (7 * f₀) := by
    cases t
    case PSL =>
      by_contra hbig
      have hn6 : 6 ≤ n := by
        by_contra h
        exact hbig (Or.inl (by omega))
      have hαp := centerQuotientConj_pow hu hup
      have hαinn : centerQuotientConj K ⟨a, hu⟩ ∉ innerAut (↥K ⧸ center ↥K) := by
        rintro ⟨q', hq'⟩
        exact huJ (mem_sup_of_inner hKq.1 hu hq'.symm)
      have hrank := localRankLeTwo_of_evenRank he3 hp (by norm_num) hZ7 hcC hc1 hcp
      have hLR := localRankAut_of_evenRank he3 hp (by norm_num) hZ7 hu hup huJ hcC hc1 hcp huc
      exact psl_false hF hp (by norm_num) hrank (two_le_pRank_psl_of_six_le hn6 hM) hf₀ hM _
        hαp hαinn hLR hX
    case PSU => exact Or.inl hLow
    case PSp => exact (by simp only [TCX.LowRank] at hLow; omega : n ≤ 4)
    case POmegaOdd => exact absurd rfl hadm.2.2.2
    case POmegaPlus => exact hLow.elim
    case POmegaMinus => exact hLow
    case G2 => trivial
    case F4 => exact hLow.elim
    case E6 => exact hLow.elim
    case E7 => exact hLow.elim
    case E8 => exact hLow.elim
    case twistedE6 => exact hLow.elim
    case trialityD4 => trivial
    case twistedB2 => trivial
    case twistedG2 => exact absurd hadm.2.2.2.1 (by norm_num)
    case twistedF4 => trivial
    case Tits => trivial
  refine ⟨↥K ⧸ center ↥K, inferInstance, inferInstance, QuotientGroup.mk' (center ↥K),
    QuotientGroup.mk'_surjective _, (QuotientGroup.ker_mk' _).le, hKq.2.1, hKq.2.2,
    ⟨t, n, 7 * f₀, hadm, hM, hsmall⟩⟩

