theorem card_diagramOrbit_D4 {α : Fin TwistTag.D4.tag.rank → ℤ} (hα : IsRoot TwistTag.D4.tag α) :
    (TwistTag.D4.diagramOrbit α).card = 1 ∨ (TwistTag.D4.diagramOrbit α).card = 3 := by
  obtain ⟨w, -, a, ha⟩ := TwistTag.D4.exists_diagramOrbit_eq hα
  rw [ha, TwistTag.D4.card_image_smul_single]
  have h3 : TwistTag.D4.order = 3 := by decide
  have := TwistTag.D4.card_orbit a
  rwa [h3] at this

theorem compDvdAt_D4_split {ℓ f p : ℕ} (hℓ : ℓ.Prime) (hf : 1 ≤ f) (K : Type) [Field K]
    [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    (hp : p.Prime) (hp3 : 3 < p) (hpq : p ∣ ℓ ^ f - 1)
    (b : graphFixedRootGroup TwistTag.D4 K σ.toRingHom) (hb1 : b ≠ 1) (hbp : b ^ p = 1) :
    CompDvdAt p b := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
  obtain ⟨hconj, ⟨eT, heT⟩, -, -, hcases⟩ :=
    triality_split_prime_toral_Sylow_and_centralizers hℓ hf K hK σ hσ hp hp3 hpq
  have hbord : orderOf b = p := orderOf_eq_prime hbp hb1
  have hbP : IsPGroup p (Subgroup.zpowers b) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hbord, pow_one])
  obtain ⟨g, hg⟩ := hconj _ hbP
  have hb'mem : ((g * b * g⁻¹ : graphFixedRootGroup TwistTag.D4 K σ.toRingHom) :
      ModGL TwistTag.D4.tag K) ∈ graphFixedRootTorus TwistTag.D4 K σ.toRingHom := by
    have h1 : (MulAut.conj g) b ∈ (Subgroup.zpowers b).map (MulAut.conj g).toMonoidHom :=
      Subgroup.mem_map_of_mem _ (Subgroup.mem_zpowers b)
    exact Subgroup.mem_subgroupOf.1 (hg h1)
  refine compDvdAt_conj g ?_
  set b' : graphFixedRootGroup TwistTag.D4 K σ.toRingHom := g * b * g⁻¹ with hb'
  have hb'ord : orderOf b' = p := by
    rw [hb', ← MulAut.conj_apply, MulEquiv.orderOf_eq]
    exact hbord
  have hb'p : b' ^ p = 1 := hb'ord ▸ pow_orderOf_eq_one b'
  have hb'1 : b' ≠ 1 := fun h => by
    rw [h, orderOf_one] at hb'ord
    exact hp.one_lt.ne hb'ord
  obtain ⟨ζ, hζ, hζ'⟩ := exists_fixedUnit_orderOf_eq hℓ hf hK σ hσ hp hpq
  obtain ⟨u, v, huv⟩ := exists_torus_coords_of_pow_eq_one hp eT heT hζ hζ' hb'mem
    (by
      have := congrArg Subtype.val hb'p
      rwa [Subgroup.coe_pow, Subgroup.coe_one] at this)
  have hne : trialityOuterTorus K σ (trialityFixedUnit K σ ζ ^ u) *
      trialityMiddleTorus K σ (ζ ^ v) ≠ 1 := by
    rw [← huv]
    intro h
    exact hb'1 (Subtype.ext h)
  obtain ⟨a, ha, -, hcase⟩ := hcases ζ hζ u v hne
  have hba : (b' : ModGL TwistTag.D4.tag K) = rootDiagUnit TwistTag.D4.tag a := huv.trans ha
  have hdJ : rootDiagUnit TwistTag.D4.tag a ∈ graphFixedRootGroup TwistTag.D4 K σ.toRingHom :=
    hba ▸ b'.2
  have hbeq : b' = ⟨rootDiagUnit TwistTag.D4.tag a, hdJ⟩ := Subtype.ext hba
  rw [hbeq]
  have hHcomm : ∀ x ∈ graphFixedRootTorus TwistTag.D4 K σ.toRingHom,
      ∀ y ∈ graphFixedRootTorus TwistTag.D4 K σ.toRingHom, x * y = y * x := by
    intro x hx y hy
    obtain ⟨u, hu⟩ : ∃ u, eT u = ⟨x, hx⟩ := ⟨eT.symm ⟨x, hx⟩, eT.apply_symm_apply _⟩
    obtain ⟨v, hv⟩ : ∃ v, eT v = ⟨y, hy⟩ := ⟨eT.symm ⟨y, hy⟩, eT.apply_symm_apply _⟩
    have := congrArg Subtype.val
      (show eT u * eT v = eT v * eT u by rw [← map_mul, ← map_mul, mul_comm])
    rw [hu, hv] at this
    exact this
  rcases hcase with ⟨-, hD⟩ |
    ⟨α, hα, -, -, D, Q, hDdef, -, hDsup, -, h3, h1, hQs, hcomm, -, -, -, -⟩
  ·
    refine compDvdAt_of_comm fun x hx y hy => ?_
    have hx' : (x : ModGL TwistTag.D4.tag K) ∈ graphFixedRootGroup TwistTag.D4 K σ.toRingHom ⊓
        Subgroup.centralizer ({rootDiagUnit TwistTag.D4.tag a} : Set (ModGL TwistTag.D4.tag K)) :=
      ⟨x.2, Subgroup.mem_centralizer_singleton_iff.mpr
        (congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.1 hx))⟩
    have hy' : (y : ModGL TwistTag.D4.tag K) ∈ graphFixedRootGroup TwistTag.D4 K σ.toRingHom ⊓
        Subgroup.centralizer ({rootDiagUnit TwistTag.D4.tag a} : Set (ModGL TwistTag.D4.tag K)) :=
      ⟨y.2, Subgroup.mem_centralizer_singleton_iff.mpr
        (congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.1 hy))⟩
    rw [hD] at hx' hy'
    exact Subtype.ext (hHcomm _ hx' _ hy')
  ·
    have hQD : Q ≤ graphFixedRootGroup TwistTag.D4 K σ.toRingHom ⊓
        Subgroup.centralizer ({rootDiagUnit TwistTag.D4.tag a} : Set (ModGL TwistTag.D4.tag K)) :=
      hDdef ▸ (hDsup ▸ le_sup_right)
    have hDQ : ⁅graphFixedRootGroup TwistTag.D4 K σ.toRingHom ⊓
        Subgroup.centralizer ({rootDiagUnit TwistTag.D4.tag a} : Set (ModGL TwistTag.D4.tag K)),
        graphFixedRootGroup TwistTag.D4 K σ.toRingHom ⊓
        Subgroup.centralizer ({rootDiagUnit TwistTag.D4.tag a} : Set (ModGL TwistTag.D4.tag K))⁆ ≤
        Q := by
      rw [← hDdef]
      exact le_of_eq hcomm
    have hdvd : p ∣ ℓ ^ f - 1 := hpq
    have hpQ : p ∣ Nat.card Q := by
      rcases card_diagramOrbit_D4 hα with hc | hc
      · obtain ⟨e⟩ := h1 hc
        rw [← Nat.card_congr e.toEquiv, CFSG.SL2MinimalFaithful.card_specialLinearGroup_fin_two,
          card_trialityFixedField hℓ hf hK σ hσ]
        refine Dvd.dvd.mul_left (hdvd.trans ?_) _
        have := Nat.sub_dvd_pow_sub_pow (ℓ ^ f) 1 2
        simpa using this
      · obtain ⟨e⟩ := h3 hc
        rw [← Nat.card_congr e.toEquiv, CFSG.SL2MinimalFaithful.card_specialLinearGroup_fin_two,
          hK]
        refine Dvd.dvd.mul_left (hdvd.trans ?_) _
        have := Nat.sub_dvd_pow_sub_pow (ℓ ^ f) 1 6
        rw [← pow_mul]
        simpa using this
    exact compDvdAt_of_quasisimple_layer hdJ hQs hQD hDQ hpQ

end CFSG.RankThree.PartOne.FOC
