theorem eq_of_sq_eq (hp : p.Prime) (hp2 : p ≠ 2) {x y : E} (hx : x ^ p = 1) (hy : y ^ p = 1)
    (h : x ^ 2 = y ^ 2) : x = y := by
  have hodd : Odd p := hp.odd_of_ne_two hp2
  obtain ⟨k, hk⟩ := hodd
  have hpow : ∀ z : E, z ^ p = 1 → z = (z ^ 2) ^ (k + 1) := by
    intro z hz
    have : (z ^ 2) ^ (k + 1) = z ^ p * z := by
      rw [← pow_mul, show 2 * (k + 1) = p + 1 by omega, pow_succ]
    rw [this, hz, one_mul]
  rw [hpow x hx, hpow y hy, h]

variable (M : Model p E c)

theorem autFixed_ne_aux {a b x y : Fin 5} (hab : a ≠ b) (hxy : x ≠ y) (hxa : x ≠ a) (hxb : x ≠ b) :
    autFixed E (fiveT M a b) ≠ autFixed E (fiveT M x y) := by
  intro h
  have hp := M.prime
  have : Fact p.Prime := ⟨hp⟩
  have := M.elem
  have hp2 : p ≠ 2 := by have := M.five_le; omega
  have hpow : ∀ z : E, z ^ p = 1 := fun z =>
    Subtype.ext (by simpa using CFSG.elemPow_eq_one_of_isElementaryAbelian (p := p) (A := E) (z : G) z.2)
  by_cases hya : y = a
  · have hmem : M.v a * M.v b ∈ autFixed E (fiveT M a b) := fiveT_fix_prod M a b
    rw [h] at hmem
    have h2 : fiveT M x y (M.v a * M.v b) = M.v a * M.v b := hmem
    rw [map_mul, fiveT_apply_v, fiveT_apply_v, hya, Equiv.swap_apply_right,
      Equiv.swap_apply_of_ne_of_ne hxb.symm hab.symm] at h2
    exact five_v_ne M hxa (mul_right_cancel h2)
  · by_cases hyb : y = b
    · have hmem : M.v a * M.v b ∈ autFixed E (fiveT M a b) := fiveT_fix_prod M a b
      rw [h] at hmem
      have h2 : fiveT M x y (M.v a * M.v b) = M.v a * M.v b := hmem
      rw [map_mul, fiveT_apply_v, fiveT_apply_v, hyb, Equiv.swap_apply_right,
        Equiv.swap_apply_of_ne_of_ne hxa.symm hab] at h2
      exact five_v_ne M hxb (mul_left_cancel h2)
    · have hmem : M.v x * (M.v y)⁻¹ ∈ autFixed E (fiveT M a b) := by
        show fiveT M a b (M.v x * (M.v y)⁻¹) = M.v x * (M.v y)⁻¹
        rw [map_mul, map_inv, fiveT_apply_v, fiveT_apply_v, Equiv.swap_apply_of_ne_of_ne hxa hxb,
          Equiv.swap_apply_of_ne_of_ne hya hyb]
      rw [h] at hmem
      have h2 : fiveT M x y (M.v x * (M.v y)⁻¹) = M.v x * (M.v y)⁻¹ := hmem
      rw [map_mul, map_inv, fiveT_apply_v, fiveT_apply_v, Equiv.swap_apply_left,
        Equiv.swap_apply_right] at h2
      have hw : M.v y * (M.v x)⁻¹ = (M.v y * (M.v x)⁻¹)⁻¹ := by
        rw [mul_inv_rev, inv_inv]
        exact h2
      have hw2 : (M.v y * (M.v x)⁻¹) ^ 2 = 1 ^ 2 := by
        rw [pow_two, one_pow]
        nth_rewrite 2 [hw]
        exact mul_inv_cancel _
      have hw1 := eq_of_sq_eq hp hp2 (hpow _) (hpow 1) hw2
      exact five_v_ne M hxy.symm (mul_inv_eq_one.1 hw1)

theorem fiveT_comm' (x y : Fin 5) : fiveT M x y = fiveT M y x := by
  unfold fiveT
  rw [Equiv.swap_comm]

theorem autFixed_ne_of_ne {a b c d : Fin 5} (hab : a ≠ b) (hcd : c ≠ d)
    (h : ¬ (a = c ∧ b = d) ∧ ¬ (a = d ∧ b = c)) :
    autFixed E (fiveT M a b) ≠ autFixed E (fiveT M c d) := by
  by_cases h1 : c ≠ a ∧ c ≠ b
  · exact autFixed_ne_aux M hab hcd h1.1 h1.2
  by_cases h2 : d ≠ a ∧ d ≠ b
  · rw [fiveT_comm' M c d]
    exact autFixed_ne_aux M hab hcd.symm h2.1 h2.2
  by_cases h3 : a ≠ c ∧ a ≠ d
  · exact (autFixed_ne_aux M hcd hab h3.1 h3.2).symm
  by_cases h4 : b ≠ c ∧ b ≠ d
  · rw [fiveT_comm' M a b]
    exact (autFixed_ne_aux M hcd hab.symm h4.1 h4.2).symm
  exfalso
  have key : ∀ a b c d : Fin 5, a ≠ b → c ≠ d → ¬ (a = c ∧ b = d) → ¬ (a = d ∧ b = c) →
      ¬ (c ≠ a ∧ c ≠ b) → ¬ (d ≠ a ∧ d ≠ b) → ¬ (a ≠ c ∧ a ≠ d) → ¬ (b ≠ c ∧ b ≠ d) → False := by
    decide
  exact key a b c d hab hcd h.1 h.2 h1 h2 h3 h4

theorem autFixedInG_ne_of_ne {a b c d : Fin 5} (hab : a ≠ b) (hcd : c ≠ d)
    (h : ¬ (a = c ∧ b = d) ∧ ¬ (a = d ∧ b = c)) :
    autFixedInG E (fiveT M a b) ≠ autFixedInG E (fiveT M c d) := by
  intro heq
  apply autFixed_ne_of_ne M hab hcd h
  exact Subgroup.map_injective E.subtype_injective heq

theorem exists_involution_of_model_psl_two {X : Type} [Group X] {f : ℕ}
    (h : CFSG.Assembly.LowTwoRank.StatedClassicalModel X .PSL 2 2 f) :
    ∃ s : X, s ≠ 1 ∧ s ^ 2 = 1 := by
  obtain ⟨hadm, K, hK, hKfin, hcard, ⟨e⟩⟩ := h
  have hch : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hcard
  obtain ⟨e'⟩ := CFSG.RankThree.PartOne.KFU.nonempty_SL2_mulEquiv_statedProj (F := K)
  let s₀ : Matrix.SpecialLinearGroup (Fin 2) K := ⟨!![1, 1; 0, 1], by simp [Matrix.det_fin_two]⟩
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  have hs₀1 : s₀ ≠ 1 := by
    intro h1
    have := congrArg (fun g : Matrix.SpecialLinearGroup (Fin 2) K => (g : Matrix (Fin 2) (Fin 2) K) 0 1) h1
    simp [s₀] at this
  have hs₀2 : s₀ ^ 2 = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_pow]
    have : (!![1, 1; 0, 1] : Matrix (Fin 2) (Fin 2) K) ^ 2 = 1 := by
      rw [pow_two, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [h2, one_add_one_eq_two]
    simpa [s₀] using this
  refine ⟨(e'.trans e.symm) s₀, ?_, ?_⟩
  · intro h1
    exact hs₀1 ((e'.trans e.symm).injective (h1.trans (map_one _).symm))
  · rw [← map_pow, hs₀2, map_one]

omit [Finite G] in
theorem mem_center_of_act_eq_one {I : Subgroup G} {f : ℕ} (hf : 1 ≤ f)
    (e : ↥I ⧸ Subgroup.center ↥I ≃* projSU 5 2 f) {s : G} (hsI : s ∈ I)
    (h : U5Act I e ⟨s, I.le_normalizer hsI⟩ = 1) : (⟨s, hsI⟩ : ↥I) ∈ Subgroup.center ↥I := by
  have h1 := U5Act_of_mem I e ⟨s, hsI⟩
  rw [h] at h1
  have hz : e (((⟨s, hsI⟩ : ↥I) : ↥I ⧸ Subgroup.center ↥I)) ∈
      Subgroup.center (projSU 5 2 f) := by
    rw [Subgroup.mem_center_iff]
    intro g
    have h2 := congrArg (fun φ : MulAut (projSU 5 2 f) => φ g) h1
    simp only [MulAut.conj_apply, MulAut.one_apply] at h2
    calc g * e (((⟨s, hsI⟩ : ↥I) : ↥I ⧸ Subgroup.center ↥I))
        = e (((⟨s, hsI⟩ : ↥I) : ↥I ⧸ Subgroup.center ↥I)) * g *
            (e (((⟨s, hsI⟩ : ↥I) : ↥I ⧸ Subgroup.center ↥I)))⁻¹ *
          e (((⟨s, hsI⟩ : ↥I) : ↥I ⧸ Subgroup.center ↥I)) := by rw [← h2]
      _ = e (((⟨s, hsI⟩ : ↥I) : ↥I ⧸ Subgroup.center ↥I)) * g := by group
  rw [u5_center_eq_bot f hf, Subgroup.mem_bot] at hz
  exact (QuotientGroup.eq_one_iff _).1 (e.injective (hz.trans (map_one e).symm))

omit [Finite G] in
theorem act_ne_one_of_center_bot {I K : Subgroup G} (hKI : K ≤ I)
    (hKc : Subgroup.center ↥K = ⊥) {f : ℕ} (hf : 1 ≤ f)
    (e : ↥I ⧸ Subgroup.center ↥I ≃* projSU 5 2 f) {s : G} (hs : s ∈ K) (hs1 : s ≠ 1) :
    U5Act I e ⟨s, I.le_normalizer (hKI hs)⟩ ≠ 1 := by
  intro h
  have h4 : (⟨s, hKI hs⟩ : ↥I) ∈ Subgroup.center ↥I := mem_center_of_act_eq_one hf e (hKI hs) h
  have h5 : (⟨s, hs⟩ : ↥K) ∈ Subgroup.center ↥K := by
    rw [Subgroup.mem_center_iff]
    intro k
    have h6 := Subgroup.mem_center_iff.1 h4 ⟨k, hKI k.2⟩
    have h7 : (k : G) * s = s * (k : G) := congrArg (fun z : ↥I => (z : G)) h6
    exact Subtype.ext h7
  rw [hKc, Subgroup.mem_bot] at h5
  exact hs1 (congrArg Subtype.val h5)

theorem autFixedInG_mem_normTwo {A : Subgroup G} {c : G} {L : Subgroup G}
    (h15 : Sec15Hyp G p A c L E) {f : ℕ} (hf : 1 ≤ f)
    (e : ↥(lieGenerated p E) ⧸ Subgroup.center ↥(lieGenerated p E) ≃* projSU 5 2 f)
    (hcardE : Nat.card ↥E = p ^ 4) {t : MulAut E} (ht : t ∈ reflectionSet p E)
    (hAt : KFAt p E f t) :
    autFixedInG E t ∈ NormTwo p E (U5Act (lieGenerated p E) e) := by
  classical
  obtain ⟨hne, hmod, hcent, hmov, -⟩ := hAt
  have hKI : kZero p E t ≤ lieGenerated p E :=
    le_sSup ⟨t, ht, (isKt_iff_of_nonexceptional hne).2 rfl⟩
  have hKc : Subgroup.center ↥(kZero p E t) = ⊥ :=
    (S13K.isQuasisimple_and_center_of_model_psl_two hmod).2
  obtain ⟨s, hs1, hs2⟩ := exists_involution_of_model_psl_two hmod
  have hsK : (s : G) ∈ kZero p E t := s.2
  have hs1' : (s : G) ≠ 1 := fun h => hs1 (Subtype.ext h)
  have hs2' : (s : G) ^ 2 = 1 := by
    have := congrArg Subtype.val hs2
    simpa using this
  have hord : orderOf (s : G) = 2 := orderOf_eq_prime hs2' hs1'
  refine ⟨Subgroup.map_subtype_le _, card_autFixedInG_five h15.h12 hcardE ht,
    Subgroup.zpowers (s : G), ?_, ?_, ⟨(s : G), Subgroup.le_normalizer (hKI hsK), Subgroup.mem_zpowers _,
      act_ne_one_of_center_bot hKI hKc hf e hsK hs1'⟩, ?_⟩
  · rw [Subgroup.zpowers_le]
    exact Subgroup.le_normalizer (hKI hsK)
  · refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_zpowers, hord]
    norm_num
  · intro b hb
    have hbE : b ∈ E ⊓ Subgroup.centralizer (kZero p E t : Set G) := by
      rw [hcent]
      exact hb
    have hcomm : Commute b (s : G) := (Subgroup.mem_centralizer_iff.1 hbE.2 (s : G) hsK).symm
    have : b ∈ Subgroup.centralizer ((Subgroup.zpowers (s : G) : Subgroup G) : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro x hx
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
      exact ((Commute.zpow_right hcomm n).eq).symm
    exact Subgroup.centralizer_le_normalizer _ this

theorem exists_refl_pairs (hAt : KFU5At) (hEin : U5EInndiag) {A : Subgroup G} {c : G} {L : Subgroup G}
    (h15 : Sec15Hyp G p A c L E) (hF : Sec12Facts G p A c L E)
    (hout : Outcome152Five p E A (lieGenerated p E)) {f : ℕ} (hf : 1 ≤ f) (hpf : p ∣ 2 ^ f + 1)
    (e : ↥(lieGenerated p E) ⧸ Subgroup.center ↥(lieGenerated p E) ≃* projSU 5 2 f)
    [Fact p.Prime] (fd : FrameData p hf (EbarOf hf (U5Act (lieGenerated p E) e) E)) :
    ∃ ι : Subgroup G → Fin 5 × Fin 5,
      (∀ B ∈ NormTwo p E (U5Act (lieGenerated p E) e), (ι B).1 < (ι B).2) ∧
      (∀ B ∈ NormTwo p E (U5Act (lieGenerated p E) e),
        fd.Z.Atil fd.P (EbarOf hf (U5Act (lieGenerated p E) e) B) = Hsub p (ι B).1 (ι B).2) ∧
      (∀ B ∈ NormTwo p E (U5Act (lieGenerated p E) e), ∀ B' ∈ NormTwo p E (U5Act (lieGenerated p E) e),
        ι B = ι B' → B = B') ∧
      (∀ t ∈ reflectionSet p E, autFixedInG E t ∈ NormTwo p E (U5Act (lieGenerated p E) e)) ∧
      (∀ q : Fin 5 × Fin 5, q.1 < q.2 → ∃ t ∈ reflectionSet p E, ι (autFixedInG E t) = q) := by
  classical
  obtain ⟨ι, hιlt, hιeq, hιinj⟩ := exists_pair_inj hEin h15 hF hout hf e fd
  have hcardE : Nat.card ↥E = p ^ 4 := by
    obtain ⟨-, -, -, -, -, hc, -⟩ := hout
    exact hc
  have hmem : ∀ t ∈ reflectionSet p E,
      autFixedInG E t ∈ NormTwo p E (U5Act (lieGenerated p E) e) := fun t ht =>
    autFixedInG_mem_normTwo h15 hf e hcardE ht
      (hAt G p A c L E f h15 hF hout hf hpf ⟨e⟩ t ht)
  refine ⟨ι, hιlt, hιeq, hιinj, hmem, ?_⟩
  obtain ⟨ψ, k, hk, hstab⟩ := U5K.Pkg.exists_psi_k h15 hF hout
  let M := U5K.Pkg.mkModel h15 hF hout ψ k hk hstab
  obtain ⟨F, hFcard, hFmem⟩ : ∃ F : Finset (Fin 5 × Fin 5), F.card = 10 ∧
      ∀ q : Fin 5 × Fin 5, q ∈ F ↔ q.1 < q.2 :=
    ⟨Finset.univ.filter (fun q : Fin 5 × Fin 5 => q.1 < q.2), by decide, fun q => by simp⟩
  have hrefl : ∀ q ∈ F, fiveT M q.1 q.2 ∈ reflectionSet p E := fun q hq =>
    fiveT_mem M (ne_of_lt ((hFmem q).1 hq))
  have hg : ∀ q ∈ F, ι (autFixedInG E (fiveT M q.1 q.2)) ∈ F := fun q hq =>
    (hFmem _).2 (hιlt _ (hmem _ (hrefl q hq)))
  have hinj : ∀ q₁ q₂ (h₁ : q₁ ∈ F) (h₂ : q₂ ∈ F),
      ι (autFixedInG E (fiveT M q₁.1 q₁.2)) = ι (autFixedInG E (fiveT M q₂.1 q₂.2)) → q₁ = q₂ := by
    intro q₁ q₂ h₁ h₂ hι
    by_contra hne
    have hlt₁ := (hFmem q₁).1 h₁
    have hlt₂ := (hFmem q₂).1 h₂
    have hB := hιinj _ (hmem _ (hrefl q₁ h₁)) _ (hmem _ (hrefl q₂ h₂)) hι
    refine autFixedInG_ne_of_ne M (ne_of_lt hlt₁) (ne_of_lt hlt₂) ⟨?_, ?_⟩ hB
    · rintro ⟨ha, hb⟩
      exact hne (Prod.ext ha hb)
    · rintro ⟨ha, hb⟩
      have : q₁.1 < q₁.1 := by
        calc q₁.1 < q₁.2 := hlt₁
          _ = q₂.1 := hb
          _ < q₂.2 := hlt₂
          _ = q₁.1 := ha.symm
      exact lt_irrefl _ this
  intro q hq
  obtain ⟨q', hq', hqq'⟩ := Finset.surj_on_of_inj_on_of_card_le (s := F) (t := F)
    (fun q _ => ι (autFixedInG E (fiveT M q.1 q.2))) hg (fun q₁ q₂ h₁ h₂ h => hinj q₁ q₂ h₁ h₂ h)
    le_rfl q ((hFmem q).2 hq)
  exact ⟨fiveT M q'.1 q'.2, hrefl q' hq', hqq'.symm⟩

@[expose] def U5CenterOddFive : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) (A : Subgroup G) (c : G) (L E : Subgroup G),
    Sec15Hyp G p A c L E → Sec12Facts G p A c L E → Outcome152Five p E A (lieGenerated p E) →
    p = 5 → ¬ E ≤ lieGenerated p E → ¬ 2 ∣ Nat.card ↥(Subgroup.center ↥(lieGenerated p E))

omit [Finite G] in
theorem false_of_central {I S A : Subgroup G} (hSI : S ≤ I) (hS1 : S ≠ ⊥) (hS2 : IsPGroup 2 ↥S)
    (hSA : S = ⁅S, A⁆) (hcase : A ≤ I ∨ ¬ 2 ∣ Nat.card ↥(Subgroup.center ↥I))
    (hcent : ∀ (s : G) (hs : s ∈ S), (⟨s, hSI hs⟩ : ↥I) ∈ Subgroup.center ↥I) : False := by
  rcases hcase with hAI | hodd
  · apply hS1
    rw [hSA, eq_bot_iff]
    refine Subgroup.commutator_le.2 fun s hs a ha => ?_
    have h1 := Subgroup.mem_center_iff.1 (hcent s hs) ⟨a, hAI ha⟩
    have h2 : a * s = s * a := congrArg (fun z : ↥I => (z : G)) h1
    rw [Subgroup.mem_bot, commutatorElement_def]
    calc s * a * s⁻¹ * a⁻¹ = (s * a) * s⁻¹ * a⁻¹ := rfl
      _ = (a * s) * s⁻¹ * a⁻¹ := by rw [← h2]
      _ = 1 := by group
  · obtain ⟨s, hs1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hS1
    obtain ⟨k, hk⟩ := hS2 s
    set z : ↥(Subgroup.center ↥I) := ⟨⟨(s : G), hSI s.2⟩, hcent s s.2⟩ with hz
    have hzk : z ^ 2 ^ k = 1 := by
      apply Subtype.ext
      apply Subtype.ext
      have := congrArg (fun w : ↥S => ((w : ↥S) : G)) hk
      simpa using this
    have hdvd : orderOf z ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hzk
    obtain ⟨j, hj, hjz⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
    have hord : orderOf z = 1 := by
      by_contra hne
      have hj0 : j ≠ 0 := fun h0 => hne (by rw [hjz, h0]; rfl)
      have h2 : 2 ∣ orderOf z := by
        rw [hjz]
        exact dvd_pow_self 2 hj0
      exact hodd (h2.trans (orderOf_dvd_natCard z))
    have hz1 : z = 1 := orderOf_eq_one_iff.1 hord
    apply hs1
    apply Subtype.ext
    have := congrArg (fun w : ↥(Subgroup.center ↥I) => (((w : ↥I) : G))) hz1
    simpa [hz] using this

theorem kf158FiveRefl_of (hMod : KFU5Mod) (hAt : KFU5At) (hEin : U5EInndiag) (h156 : KF156')
    (hZ : U5CenterOddFive) : KF158FiveRefl := by
  intro G _ _ p A c L E h15 hF hout
  classical
  obtain ⟨f, hf, hpf, ⟨e⟩, -, hcardE, -, -⟩ := id hout
  have h := h15.h12
  have hp := h.prime
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨fd⟩ := exists_frameData hEin h15 hF hout hf hpf e
  obtain ⟨ι, hιlt, hιeq, hιinj, hmem, hsurj⟩ := exists_refl_pairs hAt hEin h15 hF hout hf hpf e fd
  have hout' : Outcome152 p E A (lieGenerated p E) := Or.inr (Or.inr (Or.inr (Or.inr hout)))
  have hAadm : A ∈ admissibleTriples p E :=
    ⟨h.A_le_E, h.A_elem, h.A_card, h.setup.2.2.2.2.2.2.2.2.1⟩
  have hL0 : L ∈ sectionTenZero p A := h.L_mem.1.1.1
  have hLI : L ≤ lieGenerated p E := h156 G p A c L E h15 hF hout' L ⟨A, hAadm, hL0⟩
  obtain ⟨-, S, hSL, hS1, hS2, hAS, hSA⟩ := hL0
  have hSI : S ≤ lieGenerated p E := hSL.trans hLI
  have hcase : A ≤ lieGenerated p E ∨ ¬ 2 ∣ Nat.card ↥(Subgroup.center ↥(lieGenerated p E)) := by
    by_cases hEI : E ≤ lieGenerated p E
    · exact Or.inl (h.A_le_E.trans hEI)
    · refine Or.inr (hZ G p A c L E h15 hF hout ?_ hEI)
      by_contra hne
      exact hEI (Sec153.E_le_of_ne_five hMod hAt G p A c L E h15 hF hout hne)
  have hA : A ∈ NormTwo p E (U5Act (lieGenerated p E) e) := by
    refine ⟨h.A_le_E, h.A_card, S, hSI.trans Subgroup.le_normalizer, hS2, ?_, hAS⟩
    by_contra hno
    push Not at hno
    refine false_of_central hSI hS1 hS2 hSA hcase (fun s hs => ?_)
    exact mem_center_of_act_eq_one hf e (hSI hs) (hno s _ hs)
  obtain ⟨t, ht, hιt⟩ := hsurj (ι A) (hιlt A hA)
  exact ⟨t, ht, hιinj _ (hmem t ht) A hA hιt⟩

