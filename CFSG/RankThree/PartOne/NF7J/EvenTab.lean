@[expose] def chkNodeE (e : ℕ × ℕ) : Bool :=
  decide (det3 (mk32 e.2) = 1) && decide (mk32 e.2 * mk32 84 = mk32 e.1 * mk32 e.2)

@[expose] def chkMateE (e : ℕ × ℕ × ℕ × ℕ × ℕ) : Bool :=
  decide (det3 (mk32 e.2.2.1) = 1) && decide (e.2.2.2.1 < 4) && decide (e.2.2.2.2 < 4) &&
    decide (e.2.2.2.1 ≠ e.2.2.2.2) &&
    decide (mk32 e.2.2.1 * mk32 (baseNode e.2.2.2.1) = mk32 e.1 * mk32 e.2.2.1) &&
    decide (mk32 e.2.2.1 * mk32 (baseNode e.2.2.2.2) = mk32 e.2.1 * mk32 e.2.2.1)

@[expose] def chkOrd3E (e : ℕ × ℕ × ℕ) : Bool :=
  decide (det3 (mk32 e.2.2) = 1) && decide (mk32 e.2.2 * mk32 84 = mk32 e.1 * mk32 e.2.2) &&
    decide (mk32 e.2.2 * mk32 161 = mk32 e.2.1 * mk32 e.2.2)

@[expose] def stepOK (S : List ℕ) (e : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : Bool :=
  decide (det3 (mk32 e.2.1) = 1) && decide (e.2.2.1 < 4) && decide (e.2.2.2.1 < 4) &&
    decide (e.2.2.2.2.1 < 4) && decide (e.2.2.1 ≠ e.2.2.2.1) && decide (e.2.2.2.2.1 ≠ e.2.2.1) &&
    decide (e.2.2.2.2.1 ≠ e.2.2.2.1) &&
    decide (e.2.2.2.2.2.1 ∈ S) && decide (e.2.2.2.2.2.2 ∈ S) &&
    decide (mk32 e.2.1 * mk32 (baseNode e.2.2.1) = mk32 e.2.2.2.2.2.1 * mk32 e.2.1) &&
    decide (mk32 e.2.1 * mk32 (baseNode e.2.2.2.1) = mk32 e.2.2.2.2.2.2 * mk32 e.2.1) &&
    decide (mk32 e.2.1 * mk32 (baseNode e.2.2.2.2.1) = mk32 e.1 * mk32 e.2.1)

@[expose] def stepsCheck : List ℕ → List (ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) → Bool
  | _, [] => true
  | S, e :: es => stepOK S e && stepsCheck (e.1 :: S) es

@[expose] def stepsOut : List ℕ → List (ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) → List ℕ
  | S, [] => S
  | S, e :: es => stepsOut (e.1 :: S) es

theorem node_cover : invCodes.all (fun t => nodeTab.any (fun e => e.1 == t && chkNodeE e)) = true := by
  decide +kernel

theorem pair_cover : invCodes.all (fun t => invCodes.all (fun t' => t == t' ||
    mateTab.any (fun e => e.1 == t && e.2.1 == t' && chkMateE e) ||
    ord3Tab.any (fun e => e.1 == t && e.2.1 == t' && chkOrd3E e))) = true := by
  decide +kernel

theorem steps_ok : stepsCheck [84, 124, 167] stepTab = true := by decide +kernel

theorem steps_cover : invCodes.all (fun t => t ∈ stepsOut [84, 124, 167] stepTab) = true := by
  decide +kernel

theorem trick_ok : det3 (mk32 124) = 1 ∧ mk32 124 * mk32 84 = mk32 84 * mk32 124 ∧
    mk32 124 * mk32 161 = mk32 279 * mk32 124 ∧
    mateTab.any (fun e => e.1 == 161 && e.2.1 == 279 && chkMateE e) = true := by
  decide +kernel

theorem triple_mates :
    mateTab.any (fun e => e.1 == 84 && e.2.1 == 124 && chkMateE e) = true ∧
    mateTab.any (fun e => e.1 == 84 && e.2.1 == 167 && chkMateE e) = true ∧
    mateTab.any (fun e => e.1 == 124 && e.2.1 == 167 && chkMateE e) = true := by
  decide +kernel

theorem det3_base : ∀ i < 4, det3 (mk32 (baseNode i)) = 1 := by decide +kernel

theorem det3_84_161 : det3 (mk32 84) = 1 ∧ det3 (mk32 161) = 1 := by decide +kernel

