  decide +kernel

theorem e8T8_cover : ∀ l ∈ Tag.E8.artifactRoots,
    l ∈ ([] : List (List ℤ)) ∨ ∃ r ∈ e8T8Rows, l ∈ r.orbit := by
  decide +kernel

theorem e8T8_orbit_roots :
    ∀ r ∈ e8T8Rows, ∀ l ∈ r.orbit, l ∈ Tag.E8.artifactRoots := by
  decide +kernel

theorem e8T8_d_rows : ∀ r ∈ e8T8Rows, r.d = 1 ∨ r.d = 2 := by decide +kernel

theorem e8T8_d_classes : ∀ c ∈ e8T8Classes, c.d = 1 := by decide +kernel

theorem e8T8_d_crosses : ∀ c ∈ e8T8Crosses, c.d = 1 ∨ c.d = 2 ∨ c.d = 3 := by decide +kernel

theorem e8T8_cols_pair {p : ℕ} [Fact p.Prime] {ρ : ZMod p} {z : Fin Tag.E8.rank → ZMod p}
    (hz : ((toMat Tag.E8.rank e8T8VList).map (Int.cast : ℤ → ZMod p))ᵀ *ᵥ z = ρ • z)
    (h1 : pair (toVec Tag.E8.rank e8T12B1List) z = 0)
    (h2 : pair (toVec Tag.E8.rank e8T12B2List) z = 0) (j : Fin Tag.E8.rank) :
    pair (fun i => toMat Tag.E8.rank (lcols Tag.E8.rank e8T8ColsList) i j) z = 0 := by
  have hcol : (fun i => toMat Tag.E8.rank (lcols Tag.E8.rank e8T8ColsList) i j) =
      toVec Tag.E8.rank (e8T8ColsList.getD j []) := by
    funext i
    rw [toMat_lcols]
    rfl
  rw [hcol]
  have hj : (j : ℕ) < 8 := j.isLt
  by_cases h4 : (j : ℕ) < 4
  · simp only [e8T8ColsList]
    rw [List.getD_append _ _ _ _ (by simp [lorbit]; omega), toVec_lorbit_getD h4,
      pair_pow_mulVec hz, h1, mul_zero]
  · simp only [e8T8ColsList]
    rw [List.getD_append_right _ _ _ _ (by simp [lorbit]; omega)]
    have h5 : (j : ℕ) - (lorbit Tag.E8.rank e8T8VList e8T12B1List 4).length = (j : ℕ) - 4 := by
      simp [lorbit]
    rw [h5, toVec_lorbit_getD (by omega), pair_pow_mulVec hz, h2, mul_zero]

theorem e8T8_root_kernel (p : ℕ) [Fact p.Prime] (hp3 : 3 < p) (ρ : ZMod p)
    (hρ : ρ ^ 4 + 1 = 0) (z : Fin Tag.E8.rank → ZMod p) (hz0 : z ≠ 0)
    (hz : (e8T8V.map (Int.cast : ℤ → ZMod p))ᵀ *ᵥ z = ρ • z) :
    {r | IsRoot .E8 r ∧ pair r z = 0} = ∅ ∨ ∃ j < 18,
      {r | IsRoot .E8 r ∧ pair r z = 0} =
        {α | ∃ l ∈ lineClassRoots e8T8Rows j, α = toVec Tag.E8.rank l} := by
  rw [e8T8V_eq] at hz
  have hρ0 : ρ ≠ 0 := by
    rintro rfl
    simp at hρ
  have hΦ : peval e8T8Phi ρ = 0 := by
    have h : peval e8T8Phi ρ = ρ ^ 4 + 1 := by
      simp only [e8T8Phi, peval_cons, peval_nil, Int.cast_one, Int.cast_zero]
      ring
    rw [h, hρ]
  have hst : ¬ (pair (toVec Tag.E8.rank e8T12B1List) z = 0 ∧
      pair (toVec Tag.E8.rank e8T12B2List) z = 0) := by
    rintro ⟨h1, h2⟩
    apply hz0
    exact eq_zero_of_pair_cols_eq_zero (B := toMat Tag.E8.rank (lcols Tag.E8.rank e8T8ColsList))
      (by rw [e8T8Cols_det]; exact isUnit_one.neg) fun j => e8T8_cols_pair hz h1 h2 j
  have hlen : e8T8Classes.length = 18 := by decide +kernel
  have hp0 : ∀ d : ℤ, 0 < d → d < p → (d : ZMod p) ≠ 0 := fun d hd hdp =>
    intCast_zmod_ne_zero hd hdp
  have h := rootKernel_eq_of_lines (τ := .E8) (W := e8T8VList) (F := []) (β₁ := e8T12B1List)
    (β₂ := e8T12B2List) (Φ := e8T8Phi) (m := 8) e8T8Rows e8T8Classes e8T8Crosses []
    e8T8_rows_check e8T8_rows_cls e8T8_classes_check e8T8_cross e8T8_cross_check
    e8T8_cover (by simp) e8T8_orbit_roots hz hρ0 hΦ (by simp) (by simp) hst
    (fun r hr => by
      rcases e8T8_d_rows r hr with h | h <;> rw [h] <;>
        exact hp0 _ (by norm_num) (by omega))
    (fun c hc => by rw [e8T8_d_classes c hc]; exact hp0 1 (by norm_num) (by omega))
    (fun c hc => by
      rcases e8T8_d_crosses c hc with h | h | h <;> rw [h] <;>
        exact hp0 _ (by norm_num) (by omega))
  rw [hlen] at h
  simpa using h

end CFSG.RankThree.PartOne.KE
