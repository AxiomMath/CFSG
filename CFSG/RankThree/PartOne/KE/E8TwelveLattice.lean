    ∃ c ∈ e8T12Crosses, (c.i = i.val ∧ c.j = j.val) ∨ (c.i = j.val ∧ c.j = i.val) := by
  decide +kernel

theorem e8T12_cross : ∀ i j, i < e8T12Classes.length → j < e8T12Classes.length → i ≠ j →
    ∃ c ∈ e8T12Crosses, (c.i = i ∧ c.j = j) ∨ (c.i = j ∧ c.j = i) := fun i j hi hj hij =>
  e8T12_cross' ⟨i, hi⟩ ⟨j, hj⟩ fun h => hij (congrArg Fin.val h)

