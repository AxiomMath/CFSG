@[expose] def certOf (T : List ((Fin 4 → ℤ) × Cert)) (α : Fin 4 → ℤ) : Cert :=
  ((T.find? fun x => decide (x.1 = α)).map Prod.snd).getD ⟨0, 0, 0, 0, 0⟩

@[expose] def certCheck (U0 U1 : Fin 2 → Fin 4 → ℤ) (m0 m1 m2 : ℤ) (α : Fin 4 → ℤ) (c : Cert) :
    Bool :=
  let P0 := U0 0 0 * α 0 + U0 0 1 * α 1 + U0 0 2 * α 2 + U0 0 3 * α 3
  let Q0 := U1 0 0 * α 0 + U1 0 1 * α 1 + U1 0 2 * α 2 + U1 0 3 * α 3
  let P1 := U0 1 0 * α 0 + U0 1 1 * α 1 + U0 1 2 * α 2 + U0 1 3 * α 3
  let Q1 := U1 1 0 * α 0 + U1 1 1 * α 1 + U1 1 2 * α 2 + U1 1 3 * α 3
  decide (c.a0 * P0 + c.b0 * P1 + c.c0 * m0 = 1 ∧
    c.a0 * Q0 + c.a1 * P0 + c.b0 * Q1 + c.b1 * P1 + c.c0 * m1 = 0 ∧
    c.a1 * Q0 + c.b1 * Q1 + c.c0 * m2 = 0)

@[expose] def U0Phi2 : Fin 2 → Fin 4 → ℤ := ![![0, -1, 0, 1], ![-1, -1, 0, 2]]
@[expose] def U1Phi2 : Fin 2 → Fin 4 → ℤ := ![![0, 0, 0, -1], ![0, 0, -1, 0]]
@[expose] def U0Phi4m : Fin 2 → Fin 4 → ℤ := ![![-1, 0, 0, 1], ![-1, -1, 1, 1]]
@[expose] def U1Phi4m : Fin 2 → Fin 4 → ℤ := ![![0, 0, 0, -1], ![0, 0, -1, 0]]
@[expose] def U0Phi4p : Fin 2 → Fin 4 → ℤ := ![![-1, 0, 0, 0], ![-1, -1, 0, 1]]
@[expose] def U1Phi4p : Fin 2 → Fin 4 → ℤ := ![![0, 0, 0, -1], ![0, 0, -1, 0]]

theorem certTablePhi2_ok : ∀ α ∈ rootFinset ReeTag.F4.tag,
    certCheck U0Phi2 U1Phi2 1 0 2 α (certOf certTablePhi2 α) = true := by
  decide +kernel

theorem certTablePhi4m_ok : ∀ α ∈ rootFinset ReeTag.F4.tag,
    certCheck U0Phi4m U1Phi4m 1 (-2) 2 α (certOf certTablePhi4m α) = true := by
  decide +kernel

theorem certTablePhi4p_ok : ∀ α ∈ rootFinset ReeTag.F4.tag,
    certCheck U0Phi4p U1Phi4p 1 2 2 α (certOf certTablePhi4p α) = true := by
  decide +kernel

theorem exists_cert {U0 U1 : Fin 2 → Fin 4 → ℤ} {m0 m1 m2 : ℤ}
    {T : List ((Fin 4 → ℤ) × Cert)}
    (hT : ∀ α ∈ rootFinset ReeTag.F4.tag, certCheck U0 U1 m0 m1 m2 α (certOf T α) = true)
    (X : ℤ) {α : Fin 4 → ℤ} (hα : IsRoot ReeTag.F4.tag α) :
    ∃ A B C : ℤ, A * (∑ i, (U0 0 i + U1 0 i * X) * α i) +
      B * (∑ i, (U0 1 i + U1 1 i * X) * α i) + C * (m0 + m1 * X + m2 * X ^ 2) = 1 := by
  have h := hT α (mem_rootFinset.2 hα)
  unfold certCheck at h
  simp only [decide_eq_true_eq] at h
  obtain ⟨e0, e1, e2⟩ := h
  refine ⟨(certOf T α).a0 + (certOf T α).a1 * X, (certOf T α).b0 + (certOf T α).b1 * X,
    (certOf T α).c0, ?_⟩
  simp only [Fin.sum_univ_four]
  linear_combination e0 + X * e1 + X ^ 2 * e2

theorem not_dvd_of_cert {U0 U1 : Fin 2 → Fin 4 → ℤ} {m0 m1 m2 : ℤ}
    {T : List ((Fin 4 → ℤ) × Cert)}
    (hT : ∀ α ∈ rootFinset ReeTag.F4.tag, certCheck U0 U1 m0 m1 m2 α (certOf T α) = true)
    (X : ℤ) {α : Fin 4 → ℤ} (hα : IsRoot ReeTag.F4.tag α) {p : ℕ} (hp : p.Prime)
    (hm : (p : ℤ) ∣ m0 + m1 * X + m2 * X ^ 2) :
    ¬ ((p : ℤ) ∣ ∑ i, (U0 0 i + U1 0 i * X) * α i ∧
      (p : ℤ) ∣ ∑ i, (U0 1 i + U1 1 i * X) * α i) := by
  rintro ⟨h0, h1⟩
  obtain ⟨A, B, C, hABC⟩ := exists_cert hT X hα
  have : (p : ℤ) ∣ 1 := by
    rw [← hABC]
    exact dvd_add (dvd_add (dvd_mul_of_dvd_right h0 _) (dvd_mul_of_dvd_right h1 _))
      (dvd_mul_of_dvd_right hm _)
  have := Int.natCast_dvd_natCast.1 (by simpa using this : ((p : ℕ) : ℤ) ∣ ((1 : ℕ) : ℤ))
  exact hp.one_lt.ne' (Nat.dvd_one.1 this)

theorem uPhi2_eq (a : ℕ) (s : Fin 2) (i : Fin 4) :
    uPhi2 a s i = U0Phi2 s i + U1Phi2 s i * (2 : ℤ) ^ a := by
  fin_cases s <;> fin_cases i <;> simp [uPhi2, U0Phi2, U1Phi2]
  ring

theorem uPhi4m_eq (a : ℕ) (s : Fin 2) (i : Fin 4) :
    uPhi4m a s i = U0Phi4m s i + U1Phi4m s i * (2 : ℤ) ^ a := by
  fin_cases s <;> fin_cases i <;> simp [uPhi4m, U0Phi4m, U1Phi4m] <;> ring

theorem uPhi4p_eq (a : ℕ) (s : Fin 2) (i : Fin 4) :
    uPhi4p a s i = U0Phi4p s i + U1Phi4p s i * (2 : ℤ) ^ a := by
  fin_cases s <;> fin_cases i <;> simp [uPhi4p, U0Phi4p, U1Phi4p]

theorem hroots_phi2 (a : ℕ) {p : ℕ} (hp : p.Prime)
    (hpm : p ∣ mPhi2 a) {α : Fin 4 → ℤ} (hα : IsRoot ReeTag.F4.tag α) :
    ¬ ((p : ℤ) ∣ ∑ i, uPhi2 a 0 i * α i ∧ (p : ℤ) ∣ ∑ i, uPhi2 a 1 i * α i) := by
  have hm : (p : ℤ) ∣ 1 + 0 * (2 : ℤ) ^ a + 2 * ((2 : ℤ) ^ a) ^ 2 := by
    have : (mPhi2 a : ℤ) = 1 + 0 * (2 : ℤ) ^ a + 2 * ((2 : ℤ) ^ a) ^ 2 := by
      simp only [mPhi2]
      push_cast
      ring
    rw [← this]
    exact Int.natCast_dvd_natCast.2 hpm
  simp only [uPhi2_eq]
  exact not_dvd_of_cert certTablePhi2_ok ((2 : ℤ) ^ a) hα hp hm

theorem hroots_phi4m (a : ℕ) {p : ℕ} (hp : p.Prime)
    (hpm : p ∣ mPhi4m a) {α : Fin 4 → ℤ} (hα : IsRoot ReeTag.F4.tag α) :
    ¬ ((p : ℤ) ∣ ∑ i, uPhi4m a 0 i * α i ∧ (p : ℤ) ∣ ∑ i, uPhi4m a 1 i * α i) := by
  have hle : 2 ^ (a + 1) ≤ 2 ^ (2 * a + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hm : (p : ℤ) ∣ 1 + (-2) * (2 : ℤ) ^ a + 2 * ((2 : ℤ) ^ a) ^ 2 := by
    have : (mPhi4m a : ℤ) = 1 + (-2) * (2 : ℤ) ^ a + 2 * ((2 : ℤ) ^ a) ^ 2 := by
      simp only [mPhi4m]
      push_cast [Nat.cast_sub hle]
      ring
    rw [← this]
    exact Int.natCast_dvd_natCast.2 hpm
  simp only [uPhi4m_eq]
  exact not_dvd_of_cert certTablePhi4m_ok ((2 : ℤ) ^ a) hα hp hm

theorem hroots_phi4p (a : ℕ) {p : ℕ} (hp : p.Prime)
    (hpm : p ∣ mPhi4p a) {α : Fin 4 → ℤ} (hα : IsRoot ReeTag.F4.tag α) :
    ¬ ((p : ℤ) ∣ ∑ i, uPhi4p a 0 i * α i ∧ (p : ℤ) ∣ ∑ i, uPhi4p a 1 i * α i) := by
  have hm : (p : ℤ) ∣ 1 + 2 * (2 : ℤ) ^ a + 2 * ((2 : ℤ) ^ a) ^ 2 := by
    have : (mPhi4p a : ℤ) = 1 + 2 * (2 : ℤ) ^ a + 2 * ((2 : ℤ) ^ a) ^ 2 := by
      simp only [mPhi4p]
      push_cast
      ring
    rw [← this]
    exact Int.natCast_dvd_natCast.2 hpm
  simp only [uPhi4p_eq]
  exact not_dvd_of_cert certTablePhi4p_ok ((2 : ℤ) ^ a) hα hp hm

