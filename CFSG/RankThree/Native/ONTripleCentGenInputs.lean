@[expose] def centWord (j k : ℕ) : List (ℕ × Bool) := (centWords.getD j []).getD k []

theorem centWord_lt : ∀ j < 2, ∀ k < 8, ∀ l ∈ centWord j k, l.1 < 8 := by decide +kernel

@[expose] noncomputable def centChkM (j : ℕ) : Bool :=
  forceL ((List.range 8).map (e27C j)) fun L => forceL ((List.range 8).map (e27IC j)) fun LI =>
    allN 8 fun k => Nat.beq (wordC (nthN L) (nthN LI) (centWord j k)) (genM k)

end CFSG.RankThree.Native.ONTriple
