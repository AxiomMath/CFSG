@[expose] def hs100Arr (k : ℕ) : Array ℕ := CFSG.Monster.B.Fischer.hexTable3 100 (100 * k) hs100Hex

@[expose] def hs100StrongArrs : Array (Array ℕ) := Array.ofFn fun j : Fin 15 => hs100Arr j

@[expose] def hs100Words : Array (List ℤ) :=
    #[[], [], [-2, -2, 1, 2, 2], [-3, -1, -3, 1, 3, 1], [-2, -1, 4, 2], [-5, 2, -4, -2, 5, 1],
      [-4, 6, 4, 6], [-6, 7, 4], [-5, -6, 3], [-8, -9, -9, 4], [-4, -6, -9, 6],
      [-11, -7, 8, 11], [-2, 8, 2], [-13, -4, -9, 13], [11, -14, -4, 6, 14]]

@[expose] def hs100Base : List (Fin 100) := [0, 1, 2, 3, 4]

@[expose] def hs100Chain : RawSchreierDatum 100 :=
  RawSchreierDatum.ofArrays 100 (by decide) hs100StrongArrs 2 (by simp [hs100StrongArrs])
    hs100Base (by decide) hs100Words

@[expose] def hs100A : Equiv.Perm (Fin 100) := permOfArr 100 (hs100Arr 0)

@[expose] def hs100B : Equiv.Perm (Fin 100) := permOfArr 100 (hs100Arr 1)

@[expose] def hs100U : Equiv.Perm (Fin 100) := permOfArr 100 (hs100Arr 15)

@[expose] def hs100P : Subgroup (Equiv.Perm (Fin 100)) := Subgroup.closure {hs100A, hs100B}

@[expose] def hs100R : Subgroup (Equiv.Perm (Fin 100)) :=
  Subgroup.closure {hs100A, hs100B, hs100U}

@[expose] def hs100PairSeed : ℕ × ℕ := (0, 78)

@[expose] def mcl275Chain : RawSchreierDatum 275 := CFSG.Sporadic.Schreier.mclChain

@[expose] def mcl275A : Equiv.Perm (Fin 275) := CFSG.Sporadic.Schreier.mclGen 0

@[expose] def mcl275B : Equiv.Perm (Fin 275) := CFSG.Sporadic.Schreier.mclGen 1

@[expose] noncomputable def mcl275U : Equiv.Perm (Fin 275) := CFSG.Sporadic.SmallOddCore.mclU

@[expose] def mcl275P : Subgroup (Equiv.Perm (Fin 275)) := Subgroup.closure {mcl275A, mcl275B}

@[expose] noncomputable def mcl275R : Subgroup (Equiv.Perm (Fin 275)) :=
  Subgroup.closure {mcl275A, mcl275B, mcl275U}

