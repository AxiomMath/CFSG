@[expose] def d4TupCode (e : ℕ) : ℕ :=
  e % 331776

@[expose] def d4TupLam (e : ℕ) : Fin Tag.D4.rank → ℤ :=
  d4CertLam ⟨e / 331776 % 12, Nat.mod_lt _ (by norm_num)⟩

@[expose] def d4TupRoot (e : ℕ) : Fin 24 :=
  ⟨e / 331776 / 12 % 24, Nat.mod_lt _ (by norm_num)⟩

@[expose] def d4Dig (i : Fin Tag.D4.rank) (c : ℕ) : Fin 24 :=
  ⟨c / 24 ^ (i : ℕ) % 24, Nat.mod_lt _ (by norm_num)⟩

@[expose] def d4TupRefl (j : Fin Tag.D4.rank) (c : ℕ) : ℕ :=
  ∑ i : Fin Tag.D4.rank, 24 ^ (i : ℕ) * (d4RootRefl j (d4Dig i c) : ℕ)

abbrev d4TupOne : ℕ := 42648

theorem d4RootVec_reflect :
    ∀ j k, reflect Tag.D4 j (d4RootVec k) = d4RootVec (d4RootRefl j k) := by
  decide +kernel

theorem d4RootVec_root :
    ∀ k : Fin 24, ∃ k' < 24, Tag.D4.rootCertificate.root k' = d4RootVec k := by
  decide +kernel

theorem d4RootVec_d4TupOne : ∀ i, d4RootVec (d4Dig i d4TupOne) = Pi.single i 1 := by
  decide +kernel

theorem d4TupOne_mem : d4TupOne ∈ d4WeylTab.map d4TupCode := by
  decide +kernel

theorem d4WeylTab_closed :
    ∀ e ∈ d4WeylTab, ∀ j, d4TupRefl j (d4TupCode e) ∈ d4WeylTab.map d4TupCode := by
  decide +kernel

theorem d4Dig_d4TupRefl : ∀ e ∈ d4WeylTab, ∀ j i,
    d4Dig i (d4TupRefl j (d4TupCode e)) = d4RootRefl j (d4Dig i (d4TupCode e)) := by
  decide +kernel

theorem d4WeylTab_cert : ∀ e ∈ d4WeylTab, d4TupCode e ≠ d4TupOne →
    (∑ i, d4TupLam e i • d4RootVec (d4Dig i (d4TupCode e))) - d4TupLam e =
      (2 : ℤ) • d4RootVec (d4TupRoot e) := by
  decide +kernel

