section Kinds


@[expose] def K419UnitaryCensus : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (L : Subgroup G), IsComponent L →
    IsList46 (L ⧸ aschbacherSolvableCore 3 L) →
    ∀ a ∈ Subgroup.normalizer (L : Set G), orderOf a = 3 →
    a ∉ Subgroup.centralizer (L : Set G) → ∀ K : Subgroup G,
    K ≤ L ⊓ Subgroup.centralizer ({a} : Set G) →
    IsComponent (K.subgroupOf (L ⊓ Subgroup.centralizer ({a} : Set G))) →
    (∃ m : ℕ, Odd m ∧ Nonempty (K ≃* projSU 3 2 m)) →
      InducesStdKind L a .field ∨ InducesStdKind L a .graphField

end Kinds

namespace Res419Two

theorem isList46_of_centralizer (h46 : Item4_6) {G : Type} [Group G] [Finite G]
    (hG : SectionFourHyp G) {L : Subgroup G} (hL : IsComponent L) {c : G} (hc : orderOf c = 3)
    (hcL : c ∈ Subgroup.centralizer (L : Set G)) :
    IsList46 (L ⧸ aschbacherSolvableCore 3 L) := by
  set C := Subgroup.centralizer ({c} : Set G) with hCdef
  have hLC : L ≤ C := fun l hl =>
    Subgroup.mem_centralizer_singleton_iff.mpr (Subgroup.mem_centralizer_iff.mp hcL l hl)
  have hC4 : SectionFourHyp C := Census.sectionFourHyp_subgroup hG C
  have hcC : c ∈ C := Subgroup.mem_centralizer_singleton_iff.mpr rfl
  have hcZ : (⟨c, hcC⟩ : C) ∈ Subgroup.center C :=
    Subgroup.mem_center_iff.mpr fun g =>
      Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp g.2)
  have hZ3 : 3 ∣ Nat.card (Subgroup.center C) := by
    have h := orderOf_dvd_natCard (⟨⟨c, hcC⟩, hcZ⟩ : Subgroup.center C)
    rwa [← Subgroup.orderOf_coe, ← Subgroup.orderOf_coe, hc] at h
  set e₀ : L.subgroupOf C ≃* L := Subgroup.subgroupOfEquivOfLe hLC with he₀
  have hq : CFSG.IsQuasisimple (L.subgroupOf C) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv e₀.symm hL.1
  have hθ : L.subgroupOf C ∈ thetaComponents 3 C :=
    CFSG.RankThree.PartOne.mem_thetaComponents_of_quasisimple Nat.prime_three hq
      hL.2.subgroupOf
  have h := h46 C hC4 hZ3 (L.subgroupOf C) hθ
  exact Sec21.Item223PrintProof.isList46_of_mulEquiv
    (QuotientGroup.congr _ _ e₀
      (CFSG.RankThree.aschbacherSolvableCore_map_mulEquiv Nat.prime_three e₀)) h

end Res419Two

open Res419Two

theorem item4_19NUnitary_of
    (h46 : Item4_6) (hC : K419UnitaryCensus) :
    Item4_19NUnitary := by
  intro G _ _ hG L hL A c hA h81 hAc hc a ha hac K hK hKc hU _
  obtain ⟨x, hx, y, hy, hxy⟩ := exists_ne_comm_of_isComponent hKc
  have haL : a ∈ Subgroup.normalizer (L : Set G) := mem_normalizer_of_le hL hK hx hy hxy
  have ha3 : a ^ 3 = 1 := hA.prop.2 a ha
  have ha1 : a ≠ 1 := fun h1 => hac (h1 ▸ Subgroup.one_mem _)
  have haC : a ∉ Subgroup.centralizer (L : Set G) := fun h => hac (hAc ▸ ⟨ha, h⟩)
  have hcL : c ∈ Subgroup.centralizer (L : Set G) :=
    (show c ∈ A ⊓ Subgroup.centralizer (L : Set G) from hAc ▸ Subgroup.mem_zpowers c).2
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact hC G L hL (isList46_of_centralizer h46 hG hL hc hcL) a haL (orderOf_eq_prime ha3 ha1)
    haC K hK hKc hU

theorem item4_19NJ3_of_census
    (h417 : Item4_17) (h46 : Item4_6) (hE : K419E27) (hOne : K419OneField)
    (hU4 : K419U4Odd) (hC : K419UnitaryCensus) : Item4_19NJ3 :=
  item4_19NJ3_of_res2 h417 (item4_19NUnitary_of h46 hC) hE hOne hU4

