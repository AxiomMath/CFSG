@[expose] def orbPush (S : Array (Array ℕ)) (y : Array ℕ) : Array (Array ℕ) :=
  if S.any (eqA 315 y) then S else S.push y

@[expose] def orbStep (S : Array (Array ℕ)) (i : ℕ) : Array (Array ℕ) :=
  let x := S[i]!
  orbPush (orbPush S (conjA 315 autStrong[0]! x)) (conjA 315 autStrong[1]! x)

@[expose] def orbLoop : ℕ → Array (Array ℕ) → ℕ → Array (Array ℕ)
  | 0, S, _ => S
  | fuel + 1, S, i => if i < S.size then orbLoop fuel (orbStep S i) (i + 1) else S

@[expose] def zOrbit (_ : Unit := ()) : Array (Array ℕ) := orbLoop 1000 #[zArr] 0

@[expose] def closedAt (S : Array (Array ℕ)) (g : Array ℕ) (i : ℕ) : Bool :=
  S.any (eqA 315 (conjA 315 g S[i]!)) && S.any (eqA 315 (conjInvA 315 g S[i]!))

@[expose] def coveredBy (Hs T : Array (Array ℕ)) (s : Array ℕ) : Bool :=
  Hs.any fun h => T.any (eqA 315 (conjA 315 h s))

@[expose] def wGens (m : Array ℕ) : Array (Array ℕ) := #[gensCzArr[0]!, gensCzArr[1]!, m]

@[expose] def wordsOK (r : ℕ) : Bool :=
  let gs := wGens mArrs[r]!
  let gi := gs.map (invCand 315)
  lettersOK 3 wordsA[r]! && eqA 315 (wordA 315 gs gi wordsA[r]!) autStrong[0]! &&
    lettersOK 3 wordsB[r]! && eqA 315 (wordA 315 gs gi wordsB[r]!) autStrong[1]!

@[expose] def overCheck (_ : Unit := ()) : Bool :=
  let S := zOrbit ()
  let Hs := cCz.pts
  let T := mArrs.map fun m => conjA 315 m zArr
  validA 315 autStrong[0]! && validA 315 autStrong[1]! && gensCzArr.size == 2 &&
    mArrs.size == 8 && wordsA.size == 8 && wordsB.size == 8 &&
    allLt 8 (fun r => okA mArrs[r]!) && decide (0 < S.size) && eqA 315 S[0]! zArr &&
    allLt S.size (fun i => closedAt S autStrong[0]! i && closedAt S autStrong[1]! i) &&
    allLt S.size (fun i => inZ S[i]! || coveredBy Hs T S[i]!) &&
    allLt 8 wordsOK

