structure K432OpenRows : Prop where
  seven_D4 : ∀ (q : TauCeti.PrimePower) (hq : (TauCeti.LieTypeIndex.trialityD4 q).Valid), q.p = 2 →
    RowOf (TauCeti.CFSGIndex.lie ⟨.trialityD4 q, hq⟩).Group
  seven_Tits : ∀ ht : TauCeti.LieTypeIndex.tits.Valid,
    ListRowOf (TauCeti.CFSGIndex.lie ⟨.tits, ht⟩).Group
  eight_OmegaPlus : RowOf (projOmegaPlus 4 (GaloisField 2 1))
  eight_F4 : ListRowOf (TauCeti.CFSGIndex.lie f4TwoIndex).Group

section Holds

theorem pow_mod_three_ne_zero {p e : ℕ} (hp : p.Prime) (h3 : 3 < p) : p ^ e % 3 ≠ 0 := by
  intro h
  have h1 : 3 ∣ p ^ e := Nat.dvd_of_mod_eq_zero h
  have h2 := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h1
  have h4 := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp h2
  omega

theorem six_of_open :
    ∀ s ∈ sporadics42, RowOf (Spor s) := by
  intro s hs
  simp only [sporadics42, List.mem_cons, List.mem_nil_iff, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.M11.nonempty_mulEquiv row_carrier_m11
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.M12.nonempty_mulEquiv row_carrier_m12
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.M22.nonempty_mulEquiv row_carrier_m22
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.M23.nonempty_mulEquiv row_carrier_m23
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.M24.nonempty_mulEquiv row_carrier_m24
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.J1.nonempty_mulEquiv row_carrier_j1
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.J2.nonempty_mulEquiv row_carrier_j2
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.J3.nonempty_mulEquiv row_carrier_j3
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.J4.nonempty_mulEquiv row_carrier_j4
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.McL.nonempty_mulEquiv row_carrier_mcl
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.Ly.nonempty_mulEquiv row_carrier_ly
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.HS.nonempty_mulEquiv row_carrier_hs
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.He.nonempty_mulEquiv
      (rowOf_of_listRowOf listRowOf_he outerRowOf_he)
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.Suz.nonempty_mulEquiv row_carrier_suz
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.Ru.nonempty_mulEquiv row_carrier_ru
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.ON.nonempty_mulEquiv row_carrier_on
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.Co3.nonempty_mulEquiv row_carrier_co3
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.Co2.nonempty_mulEquiv row_carrier_co2
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.HN.nonempty_mulEquiv row_carrier_hn
  · exact rowOf_spor_of_carrier CFSG.Sporadic.Bridge.Th.nonempty_mulEquiv row_carrier_th

theorem k432Rows_of_open
    (O : K432OpenRows) : K432Rows :=
  {
    one := fun p e [Fact p.Prime] _ he => by haveI : NeZero e := ⟨by omega⟩; exact rowOf_projSL_two (GaloisField p e)
    two_SL := fun p e [Fact p.Prime] hp he he2 => by
      by_cases h : p ^ e % 3 = 2
      · exact rowOf_two_SL_of_mod_two p e hp he he2 h
      · exact rowOf_two_SL_of_mod_one p e hp he he2
          (by have := pow_mod_three_ne_zero (e := e) (Fact.out : p.Prime) hp; omega)
    two_SU := fun p e [Fact p.Prime] hp he he2 => by
      by_cases h : p ^ e % 3 = 1
      · exact rowOf_two_SU_of_mod_one p e hp he he2 h
      · exact rowOf_two_SU_of_mod_two p e hp he he2
          (by have := pow_mod_three_ne_zero (e := e) (Fact.out : p.Prime) hp; omega)
    three := rowOf_r27
    four_G2 := rowOf_g2_odd
    four_Sp := rowOf_four_Sp
    four_SL := fun p [Fact p.Prime] hp => by
      by_cases h : p % 3 = 2
      · exact rowOf_four_SL_of_mod_two p hp h
      · exact L4Diag.rowOf_four_SL_of_mod_one p hp
          (by have := pow_mod_three_ne_zero (e := 1) (Fact.out : p.Prime) hp; simp at this; omega)
    four_SU := fun p [Fact p.Prime] hp => by
      by_cases h : p % 3 = 1
      · exact rowOf_four_SU_of_mod_one p hp h
      · exact rowOf_four_SU_of_mod_two p hp
          (by have := pow_mod_three_ne_zero (e := 1) (Fact.out : p.Prime) hp; simp at this; omega)
    five := row_five
    six := six_of_open
    seven_SL2 := fun n hn => by haveI : NeZero n := ⟨by omega⟩; exact rowOf_projSL_two (GaloisField 2 n)
    seven_SL3 := fun n hn => by
      by_cases h : n % 2 = 1
      · exact rowOf_seven_SL3_of_odd n hn h
      · by_cases h3 : n % 3 = 0
        · exact rowOf_seven_SL3_of_even_of_three_dvd n hn (by omega) h3
        · exact rowOf_seven_SL3_of_even_of_not_three_dvd n hn (by omega) h3
    seven_SU3 := fun n hn => by
      by_cases h : n % 2 = 0
      · exact rowOf_seven_SU3_of_even n hn h
      · by_cases h3 : n % 3 = 0
        · exact rowOf_seven_SU3_of_odd_of_three_dvd n hn (by omega) h3
        · exact rowOf_seven_SU3_of_odd_of_not_three_dvd n hn (by omega) h3
    seven_Sp4 := rowOf_seven_Sp4
    seven_SU4 := rowOf_seven_SU4
    seven_G2 := rowOf_g2_even
    seven_D4 := O.seven_D4
    seven_Sz := rowOf_suzuki
    seven_F4 := rowOf_f4_ree
    seven_Tits := fun ht => rowOf_of_listRowOf (O.seven_Tits ht) (outerRowOf_tits ht)
    eight_SL5 := row_l52
    eight_SU5 := row_u52
    eight_SL6 := row_l62
    eight_SU6 := row_u62
    eight_SL7 := row_l72
    eight_Sp6 := row_sp62
    eight_Sp8 := row_sp82
    eight_OmegaPlus := O.eight_OmegaPlus
    eight_OmegaMinus := row_omegaMinus
    eight_SL4 := row_l44
    eight_Sp6_4 := row_sp64
    eight_SU5_4 := row_u54
    eight_SU5_8 := row_u58
    eight_F4 := rowOf_of_listRowOf O.eight_F4 outerRowOf_f4_two
    nine_SL3 := fun e he he3 => by
      by_cases h : e = 1
      · subst h
        exact rowOf_nine_SL3_one
      · exact rowOf_nine_SL3_ge_two e (by omega) he3
    nine_SU3 := rowOf_nine_SU3
    nine_G2 := rowOf_g23
    nine_SL4 := row_l43
    nine_SU4 := row_u43
  }

theorem k432InnerThree_of_openRows
    (O : K432OpenRows) : K432InnerThree :=
  k432InnerThree_of_rows (k432Rows_of_open O)

theorem k432List_of_openRows
    (O : K432OpenRows) : K432List :=
  k432List_of_rows (k432Rows_of_open O)

