theorem card_le_nine_of_cyclicSylow_outThreeCyclic {Y : Type} [Group Y] [Finite Y]
    (hS : ∀ S : Sylow 3 Y, IsCyclic S) (hO : KFacts.OutThreeCyclic Y)
    (B : Subgroup (MulAut Y)) (hB : IsElemAbelian 3 B) : Nat.card B ≤ 9 := by
  by_cases hin : ∀ τ ∈ B, KFacts.IsInnerAut τ
  · have := Sec8.Item82Proof.card_inf_inner_le_three hS (fun α hα => hB.2 α hα) hin
    omega
  · push Not at hin
    obtain ⟨τ, hτB, hτ⟩ := hin
    have hk : ∀ β ∈ B, ∃ k < 3, τ ^ k * β ∈ (MulAut.conj : Y →* MulAut Y).range := fun β hβ =>
      hO τ β (congrArg Subtype.val (hB.1.is_comm.comm ⟨τ, hτB⟩ ⟨β, hβ⟩)) (hB.2 τ hτB)
        (hB.2 β hβ) hτ
    have hle3 := KFacts.card_le_three_mul_card_inf_of_forall_pow_mul_mem hτB hk
    have hD := Sec8.Item82Proof.card_inf_inner_le_three hS
      (fun α hα => hB.2 α (Subgroup.mem_inf.mp hα).1) inf_le_right
    omega

theorem seitz27_projSL_wrongpi {p e : ℕ} [Fact p.Prime] (he : 1 ≤ e) (hmod : p ^ e % 3 = 2)
    {X : Type} [Group X] (φ : X ≃* projSL 3 (GaloisField p e)) : Seitz27 X := by
  have hK : Nat.card (GaloisField p e) % 3 = 2 := by
    rw [GaloisField.card p e (by omega)]
    exact hmod
  have : Finite (ProjGenLinGroup (Fin 3) (GaloisField p e)) :=
    Finite.of_surjective (ProjGenLinGroup.mk : GL (Fin 3) (GaloisField p e) →* _)
      ProjGenLinGroup.mk_surjective
  have : Finite (projSL 3 (GaloisField p e)) := Subtype.finite
  have hO : KFacts.OutThreeCyclic (projSL 3 (GaloisField p e)) :=
    (KFacts.outThreeCyclic_psl3 _).of_mulEquiv (Sec4.projSLEquivProjectiveSL 3 _)
  exact seitz27_of_card_le_nine fun B hB =>
    CFSG.RankThree.PartTwo.Sec10.Item1015Proof.card_le_nine_of_injective
      (MulAut.congr φ).toMonoidHom (MulAut.congr φ).injective
      (fun B' hB' => card_le_nine_of_cyclicSylow_outThreeCyclic
        (fun S => KFacts.isCyclic_sylow_three_projSL hK S) hO B' hB') B hB

theorem seitz27_projSU_wrongpi {p e : ℕ} [Fact p.Prime] (he : 1 ≤ e) (hmod : p ^ e % 3 = 1)
    {X : Type} [Group X] (φ : X ≃* projSU 3 p e) : Seitz27 X := by
  have hU := Sec4.unitaryFieldData_galoisField p e he
  have hq2 : 2 < p ^ e := by
    have h2 : 2 ≤ p ^ e := le_trans (Fact.out : p.Prime).two_le (Nat.le_self_pow (by omega) p)
    omega
  have : Finite (ProjGenLinGroup (Fin 3) (GaloisField p (2 * e))) :=
    Finite.of_surjective (ProjGenLinGroup.mk : GL (Fin 3) (GaloisField p (2 * e)) →* _)
      ProjGenLinGroup.mk_surjective
  have : Finite (projSU 3 p e) := Subtype.finite
  have hO : KFacts.OutThreeCyclic (projSU 3 p e) :=
    (KFacts.outThreeCyclic_psu3 hU hq2).of_mulEquiv (Sec4.projSUEquivUnitaryPSU p e hU)
  exact seitz27_of_card_le_nine fun B hB =>
    CFSG.RankThree.PartTwo.Sec10.Item1015Proof.card_le_nine_of_injective
      (MulAut.congr φ).toMonoidHom (MulAut.congr φ).injective
      (fun B' hB' => card_le_nine_of_cyclicSylow_outThreeCyclic
        (fun S => KFacts.isCyclic_sylow_three_projSU (by omega) hmod S) hO B' hB') B hB

section Sp4Prime

open CFSG.Assembly.LowTwoRank
open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher
