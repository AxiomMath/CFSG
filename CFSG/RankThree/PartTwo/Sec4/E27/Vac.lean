theorem psp4_prime_order_three_inner {F : Type} [Field F] [Finite F] {p : ℕ} [Fact p.Prime]
    (hp3 : 3 < p) (hF : Nat.card F = p) (β : MulAut (StatedProj (StatedSp 2 F))) (hβ : β ^ 3 = 1) :
    β ∈ (MulAut.conj : StatedProj (StatedSp 2 F) →* MulAut (StatedProj (StatedSp 2 F))).range := by
  have hp : p.Prime := Fact.out
  have hodd : ringChar F ≠ 2 := by
    haveI := Fintype.ofFinite F
    have : CharP F p := charP_of_card_eq_prime (by rw [← Nat.card_eq_fintype_card]; exact hF)
    rw [ringChar.eq F p]
    omega
  have hD : β ∈ (conjAut 2 F).range := by
    by_contra hD
    obtain ⟨σ, hσ3, -⟩ := KFacts.psp4_odd_order_three_field_descent hodd β hβ hD
    exact Sec6.BThreeCensus.orderOf_ne_three_of_card_prime hp hF σ hσ3
  obtain ⟨A, rfl⟩ := hD
  have h4A : conjAut 2 F A = conjAut 2 F (A ^ 2) ^ 2 := by
    rw [← map_pow, ← pow_mul, map_pow]
    calc conjAut 2 F A = conjAut 2 F A ^ 3 * conjAut 2 F A := by rw [hβ, one_mul]
      _ = conjAut 2 F A ^ (2 * 2) := by rw [← pow_succ]
  rw [h4A]
  refine Subgroup.pow_mem _ (conjAut_mem_inner_of_isSquare ⟨(multiplier 2 F A : F), ?_⟩) 2
  rw [map_pow, Units.val_pow_eq_pow_val, sq]

theorem seitz27_projSp_prime {p : ℕ} [Fact p.Prime] (hp3 : 3 < p) {X : Type} [Group X]
    (e : X ≃* CFSG.PGLModel.projSp 2 (GaloisField p 1)) : Seitz27 X := by
  have hp : p.Prime := Fact.out
  set F := GaloisField p 1 with hFdef
  have hF : Nat.card F = p := by rw [hFdef, GaloisField.card p 1 one_ne_zero, pow_one]
  have h4 : 4 ≤ Nat.card F := by omega
  let eP : CFSG.PGLModel.projSp 2 F ≃* StatedProj (StatedSp 2 F) :=
    CFSG.PGLModel.projSpEquivStatedProj 2 F
  have hZY : Subgroup.center (StatedProj (StatedSp 2 F)) = ⊥ :=
    CFSG.LieType.SeitzGeneration.center_statedProj_statedSp_eq_bot (by norm_num)
  have hZP : Subgroup.center (CFSG.PGLModel.projSp 2 F) = ⊥ :=
    KFacts.KS14.center_eq_bot_of_mulEquiv eP hZY
  have hsY : IsSimpleGroup (StatedProj (StatedSp 2 F)) :=
    CFSG.ClassicalGroups.Symplectic.isSimpleGroup_statedProj_statedSp F 2 (by norm_num)
      (Or.inl (Or.inr h4))
  haveI := hsY
  have hsP : IsSimpleGroup (CFSG.PGLModel.projSp 2 F) := eP.isSimpleGroup
  have hR : CFSG.pRank 3 (CFSG.PGLModel.projSp 2 F ⧸
      Subgroup.center (CFSG.PGLModel.projSp 2 F)) ≤ 2 :=
    Sec4.Res417Three.pRank_projSp_two_le (by omega) le_rfl hsP
  have hRQ : RankLE2 3 (CFSG.PGLModel.projSp 2 F ⧸ Subgroup.center (CFSG.PGLModel.projSp 2 F)) :=
    fun B hB => by simpa using Sec4.Res4Three.card_le_nine_of_pRank_le_two hR B hB
  have hinj : Function.Injective (QuotientGroup.mk' (Subgroup.center (CFSG.PGLModel.projSp 2 F))) := by
    rw [← MonoidHom.ker_eq_bot_iff, QuotientGroup.ker_mk', hZP]
  have hRP : RankLE2 3 (CFSG.PGLModel.projSp 2 F) := RankLE2.of_injective _ hinj hRQ
  have hRY : RankLE2 3 (StatedProj (StatedSp 2 F)) := RankLE2.of_mulEquiv eP hRP
  exact seitz27_of_mulEquiv (e.trans eP)
    (seitz27_of_allInner hZY (psp4_prime_order_three_inner hp3 hF) (hinner_of_rankLE2 hRY))

end Sp4Prime

section G2Prime


theorem seitz27_isoGTwo_prime {X : Type} [Group X] (q : TauCeti.PrimePower)
    (hq1 : q.exponent = 1) (hp3 : 3 < q.p) (hX : CFSG.RankThree.PartTwo.Sec4.IsoGTwo X q) :
    Seitz27 X := by
  obtain ⟨hv, ⟨e⟩⟩ := hX
  obtain ⟨K, _, _, hK, -, ⟨e2⟩⟩ := CFSG.LieType.SeitzGeneration.exists_catEquiv_adjointGroup
    CFSG.TauCetiBridge.Even.chevalleyBridgesAll.g2 q hv
  refine seitz27_of_mulEquiv (e.trans e2) (seitz27_adjointG2_prime q.prime_p hp3 ?_)
  rw [hK, TauCeti.PrimePower.card_def, hq1, pow_one]

end G2Prime

