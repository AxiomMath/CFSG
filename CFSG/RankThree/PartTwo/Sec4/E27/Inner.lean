theorem hinner_unitary4 {ℓ f : ℕ} {K : Type} [Field K] (h : UnitaryFieldData ℓ f K) (hℓ3 : ℓ ≠ 3)
    (hq : 3 ≤ ℓ ^ f) :
    ∀ E : Subgroup (primeFormP h (idGram K 4)), IsElemAbelian 3 E → Nat.card E = 27 →
      HyperGen 3 (⊤ : Subgroup (primeFormP h (idGram K 4))) E := by
  intro E hE hc
  haveI := h.finite
  have hne : ¬ (4 = 3 ∧ ℓ ^ f = 2) := by omega
  let ψ : primeFormP h (idGram K 4) ≃* StatedProj (StatedSU 4 (ℓ ^ f) K) :=
    (Classical.choice (unitary_prime_form_full_semilinear_realization h
      (isPrimeFormGram_idGram (K := K) (n := 4)) (by norm_num) hne).1).trans
      (unitaryPSUEquiv h (by omega))
  have hE' : IsElemAbelian 3 (E.map ψ.toMonoidHom) :=
    CFSG.PreuniquenessRankFour.Helpers.elementary_abelian_map 3 hE _
  have hc' : Nat.card (E.map ψ.toMonoidHom) = 3 ^ 3 := by
    rw [Subgroup.card_map_of_injective ψ.injective, hc]
    norm_num
  refine hyperGen_top_of_mulEquiv ψ ?_
  have h3 : ¬ 3 ∣ ℓ ^ f := fun hd => by
    have h1 := Nat.Prime.dvd_of_dvd_pow Nat.prime_three hd
    exact hℓ3 ((Nat.prime_dvd_prime_iff_eq Nat.prime_three h.prime).1 h1).symm
  by_cases hq1 : 3 ∣ ℓ ^ f + 1
  · refine hyperGen_statedProj_unitary_toral (n := 3) h Nat.prime_three hq1 (by omega) ?_ hE' hc'
    intro hd
    have : 3 ∣ 3 + 1 := hd.trans (Nat.gcd_dvd_left _ _)
    omega
  · have hq' : 3 ∣ ℓ ^ f - 1 := by omega
    exact hyperGen_statedProj_unitary_split h (by norm_num) (fun h3 => absurd h3 (by norm_num))
      Nat.prime_three (by norm_num) hq' hE' hc'

theorem primeFormP_prime_order_three_inner {ℓ : ℕ} {K : Type} [Field K] (h : UnitaryFieldData ℓ 1 K)
    (hℓ3 : 3 < ℓ) (α : MulAut (primeFormP h (idGram K 4))) (hα : α ^ 3 = 1) :
    α ∈ (MulAut.conj : primeFormP h (idGram K 4) →* MulAut (primeFormP h (idGram K 4))).range := by
  haveI := h.finite
  have hne : ¬ (4 = 3 ∧ ℓ ^ 1 = 2) := by omega
  have hC : IsPrimeFormGram (1 : GL (Fin 4) K) := isPrimeFormGram_one
  have hg : ¬ 3 ∣ Nat.gcd 4 (ℓ ^ 1 + 1) := by
    intro hd
    have : 3 ∣ 4 := hd.trans (Nat.gcd_dvd_left _ _)
    omega
  have hKc : Nat.card K = ℓ ^ 2 := by
    have := h.card_eq_sq
    rw [this]
    ring
  have hauts : Nat.card (K ≃+* K) = 2 :=
    (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic h.prime K hKc).1
  set τ := primeFormFieldFactor h hC (by norm_num) hne α with hτ
  have hτ3 : τ ^ 3 = 1 := by rw [hτ, ← map_pow, hα, map_one]
  have hτ1 : τ = 1 := by
    have h1 : orderOf τ ∣ 3 := orderOf_dvd_of_pow_eq_one hτ3
    have h2 : orderOf τ ∣ 2 := hauts ▸ orderOf_dvd_natCard τ
    have : orderOf τ ∣ Nat.gcd 3 2 := Nat.dvd_gcd h1 h2
    norm_num at this
    exact this
  have hD : α ∈ primeFormD h ((1 : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) := by
    rw [← ker_primeFormFieldFactor h hC (by norm_num) hne]
    exact hτ1
  exact pElement_mem_inner_of_not_dvd_gcd h (by norm_num) hne Nat.prime_three hg hD hα

theorem seitz27_projSU4_prime {p : ℕ} [Fact p.Prime] (hp3 : 3 < p) {X : Type} [Group X]
    (e : X ≃* projSU 4 p 1) : Seitz27 X := by
  have hp : p.Prime := Fact.out
  have hU : UnitaryFieldData p 1 (GaloisField p (2 * 1)) :=
    CFSG.RankThree.PartTwo.Sec4.unitaryFieldData_galoisField p 1 le_rfl
  haveI := hU.finite
  have hne : ¬ (4 = 3 ∧ p ^ 1 = 2) := by omega
  haveI : IsSimpleGroup (primeFormP hU (idGram (GaloisField p (2 * 1)) 4)) :=
    CFSG.RankThree.Classical.isSimpleGroup_primeFormP_one hU (by norm_num) hne
  have hnab : ∃ a b : primeFormP hU (idGram (GaloisField p (2 * 1)) 4), a * b ≠ b * a := by
    have hnc := CFSG.RankThree.Classical.not_commute_primeFormP_one hU (by norm_num) hne
    push Not at hnc
    exact hnc
  have hS : Seitz27 (primeFormP hU (idGram (GaloisField p (2 * 1)) 4)) :=
    seitz27_of_allInner (center_bot_of_simple_nonab hnab)
      (primeFormP_prime_order_three_inner hU hp3) (hinner_unitary4 hU (by omega) (by simpa using by omega))
  let ψ : primeFormP hU (idGram (GaloisField p (2 * 1)) 4) ≃*
      StatedProj (StatedSU 4 (p ^ 1) (GaloisField p (2 * 1))) :=
    (Classical.choice (unitary_prime_form_full_semilinear_realization hU
      (isPrimeFormGram_idGram (K := GaloisField p (2 * 1)) (n := 4)) (by norm_num) hne).1).trans
      (unitaryPSUEquiv hU (by omega))
  exact seitz27_of_mulEquiv ((e.trans (CFSG.PGLModel.projSUEquivStatedProj 4 p 1)).trans ψ.symm) hS

end Unitary

