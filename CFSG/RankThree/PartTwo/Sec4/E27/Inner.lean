variable {F : Type} [Field F] [Finite F]

theorem psl4_prime_order_three_inner {p : ℕ} (hp : p.Prime) (hF : Nat.card F = p)
    (α : MulAut (projectiveSL 4 F)) (hα : α ^ 3 = 1) :
    α ∈ (MulAut.conj : projectiveSL 4 F →* MulAut (projectiveSL 4 F)).range := by
  by_cases hD : α ∈ linearAutGroup 4 F
  · rw [linearAutGroup_eq_range] at hD
    obtain ⟨H, rfl⟩ := hD
    have h1 : conjAut 4 F (H ^ 3) = 1 := by rw [map_pow]; exact hα
    obtain ⟨c, hc⟩ := (CFSG.ComponentClassification.UnbalancedCatalog.conjAut_eq_one_iff
      (by norm_num) (H ^ 3)).1 h1
    have hdet : Matrix.GeneralLinearGroup.det H ^ 3 = c ^ 4 := by
      rw [← map_pow, ← hc]
      ext
      simp
    refine CFSG.SeitzReduction.SymplecticPilot.conjAut_mem_inner_of_det_eq_units_pow
      (n := 4) (by norm_num) (u := Matrix.GeneralLinearGroup.det H * c⁻¹) ?_
    rw [mul_pow, inv_pow, ← hdet]
    group
  · obtain ⟨σ, hσ, -⟩ := CFSG.RankThree.PartTwo.KFacts.linear_order_three_field_descent (by norm_num) α hα hD
    exact absurd hσ (CFSG.RankThree.PartTwo.Sec6.BThreeCensus.orderOf_ne_three_of_card_prime hp hF σ)

theorem not_p1ThreeLieList_A3 (q : TauCeti.PrimePower) (hv : (TauCeti.LieTypeIndex.A 3 q).Valid) :
    ¬ CFSG.AGLEmbedding.P1ThreeLieList 3 ⟨TauCeti.LieTypeIndex.A 3 q, hv⟩ := by
  unfold CFSG.AGLEmbedding.P1ThreeLieList
  rintro (⟨n, q', hq', -⟩ | ⟨q', -, hq'⟩ | ⟨-, m, hm⟩ | ⟨q', ⟨-, -, hq'⟩ | ⟨-, -, -, hq'⟩⟩ | hch)
  · exact absurd (TauCeti.LieTypeIndex.A.inj hq').1 (by norm_num)
  · cases hq'
  · cases hm
  · cases hq'
  · cases hq'
  · unfold CFSG.AGLEmbedding.IsP1ChevTwoIndex at hch
    rcases hch with ⟨-, q', -, -, h | h | h | h | h | h | h | h⟩ |
      ⟨-, q', -, -, h | h | h | h⟩ | ⟨h5, -⟩ <;> first | cases h | omega

theorem seitz27_projSL4_prime {p : ℕ} [Fact p.Prime] (hp3 : 3 < p) {X : Type} [Group X]
    (e : X ≃* projSL 4 (GaloisField p 1)) : Seitz27 X := by
  have hp : p.Prime := Fact.out
  set F := GaloisField p 1 with hFdef
  have hF : Nat.card F = p := by rw [hFdef, GaloisField.card p 1 one_ne_zero, pow_one]
  set q : TauCeti.PrimePower := ⟨p, 1, hp, Nat.one_pos⟩ with hqdef
  have hqc : q.card = p := by rw [TauCeti.PrimePower.card_def]; simp [hqdef]
  have hv : (TauCeti.LieTypeIndex.A 3 q).Valid := by
    refine (TauCeti.LieTypeIndex.valid_iff _).2 ⟨?_, ?_⟩
    · simp only [TauCeti.LieTypeIndex.inStandardRange_iff]
      omega
    · simp [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
      rw [← TauCeti.PrimePower.card_def, hqc]
      omega
  let d : TauCeti.ValidLieTypeIndex := ⟨TauCeti.LieTypeIndex.A 3 q, hv⟩
  let θ : projectiveSL 4 F ≃* Cat d :=
    (CFSG.RankThree.PartTwo.Sec4.projSLEquivProjectiveSL 4 F).symm.trans
      ((CFSG.RankThree.PartTwo.Sec4.projSLEquivPSLn 4 F).trans
        (CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 3 q hv).symm)
  have hZ : Subgroup.center (projectiveSL 4 F) = ⊥ :=
    CFSG.RankThree.RegularUnipotent.center_projectiveSL_eq_bot (by norm_num)
  have hinner : ∀ E : Subgroup (projectiveSL 4 F), IsElemAbelian 3 E → Nat.card E = 27 →
      HyperGen 3 (⊤ : Subgroup (projectiveSL 4 F)) E := by
    intro E hE hc
    refine hyperGen_top_of_mulEquiv θ ?_
    have hE' : IsElemAbelian 3 (E.map θ.toMonoidHom) :=
      CFSG.PreuniquenessRankFour.Helpers.elementary_abelian_map 3 hE _
    have hc' : Nat.card (E.map θ.toMonoidHom) = 3 ^ 3 := by
      rw [Subgroup.card_map_of_injective θ.injective, hc]
      norm_num
    refine seitzHyperLieLinear_unconditional d 3 Nat.prime_three (by norm_num) ?_
      (not_p1ThreeLieList_A3 q hv) _ hE' hc' ⟨3, q, rfl⟩
    change 3 ≠ (TauCeti.LieTypeIndex.A 3 q).characteristic
    rw [TauCeti.LieTypeIndex.characteristic_A]
    exact Ne.symm (by simp [hqdef]; omega)
  have hS : Seitz27 (projectiveSL 4 F) :=
    seitz27_of_allInner hZ (psl4_prime_order_three_inner hp hF) hinner
  exact seitz27_of_mulEquiv (e.trans (CFSG.RankThree.PartTwo.Sec4.projSLEquivProjectiveSL 4 F)) hS

end Linear

section Unitary

theorem center_bot_of_simple_nonab {G : Type} [Group G] [IsSimpleGroup G]
    (hnab : ∃ a b : G, a * b ≠ b * a) : Subgroup.center G = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center G) with h | h
  · exact h
  · exfalso
    obtain ⟨a, b, hab⟩ := hnab
    have ha : a ∈ Subgroup.center G := by rw [h]; trivial
    exact hab ((Subgroup.mem_center_iff.1 ha b).symm)

