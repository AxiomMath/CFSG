open Item434L34 in
theorem concl434_of_isL34_of_center_eq_bot
    (hS : SeitzL34Outer) (h : Ctx434Core G A M Q)
    (hL : IsL34 (layer G ⧸ Subgroup.center (layer G)))
    (hZ : Subgroup.center (layer G) = ⊥) : Concl434 A Q := by
  have : (layer G).Characteristic := layer_characteristic
  have hinn := h.layerStar_le_range_conj hS hL
  have h9 := h.card_layerStar_eq_nine_of_isL34 hL
  obtain ⟨e⟩ := hL
  set C := A ⊓ Subgroup.centralizer (layer G : Set G) with hC
  have hC3 : Nat.card C = 3 := h.card_inf_centralizer_layer_eq_three h9
  have hC1 : C ≠ ⊥ := by
    intro hbot
    rw [hbot, Subgroup.card_bot] at hC3
    omega
  have hCZ : ¬ C ≤ (Subgroup.center (layer G)).map (layer G).subtype := by
    rw [hZ, Subgroup.map_bot, le_bot_iff]
    exact hC1
  obtain ⟨-, hdir | ⟨a, ha, hout, -⟩⟩ := h.rank3II_4_39 hC1 hCZ
  swap
  · exfalso
    obtain ⟨hx, hx'⟩ := hout
    apply hx'
    rw [compAction_eq_layerConj]
    exact hinn ⟨a, ha, rfl⟩
  obtain ⟨hAL, hCL⟩ := hdir
  set ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 (GaloisField 2 2) :=
    e.trans (KFacts.L34.projSLEquivProjectiveSL 3 _) with hψ
  obtain ⟨hQ2, hQg⟩ := h.card_eq_two_and_isGraphField hinn h9 KFacts.L34.card_galoisField_two_two ψ
  refine ⟨Or.inl ⟨?_⟩, hQ2, fun q hq hq1 => ?_⟩
  ·
    have hcomm : ∀ {c l : G}, c ∈ C → l ∈ layer G → Commute c l := fun hc hl =>
      ((Subgroup.mem_centralizer_iff.mp hc.2) _ hl).symm
    have hdec : ∀ {x : G}, x ∈ C ⊔ layer G → ∃ c ∈ C, ∃ l ∈ layer G, c * l = x :=
      fun hx => Subgroup.mem_sup_of_normal_right.mp hx
    set e₁ : (C × layer G) ≃* (C ⊔ layer G : Subgroup G) :=
      Subgroup.mulEquivProdOfInternalDirect C (layer G) (C ⊔ layer G) le_sup_left le_sup_right
        hcomm hCL hdec
    have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    set e₂ : C ≃* Multiplicative (ZMod 3) :=
      mulEquivOfPrimeCardEq hC3 (by rw [Nat.card_congr Multiplicative.toAdd, Nat.card_zmod])
    set e₃ : layer G ≃* projSL 3 (GaloisField 2 2) := (quotientCenterEquivOfBot hZ).symm.trans e
    exact (MulEquiv.subgroupCongr hAL).trans (e₁.symm.trans (MulEquiv.prodCongr e₂ e₃))
  ·
    have hθZ : aschbacherSolvableCore 3 (layer G) = Subgroup.center (layer G) := by
      rw [h.aschbacherSolvableCore_layer_eq_bot, hZ]
    have hqN : q ∈ Subgroup.normalizer (layer G : Set G) := by
      rw [Subgroup.normalizer_eq_top (layer G)]
      exact Subgroup.mem_top q
    refine KFacts.InducesStdKind.psl 3 (GaloisField 2 2) le_rfl
      ⟨(QuotientGroup.quotientMulEquivOfEq hθZ).trans ψ, hqN, ?_⟩
    rw [KFacts.PinnedAut.hasKind_graphField, inducedAutHom_eq_barConj hθZ ψ hqN]
    exact hQg q hq hq1

