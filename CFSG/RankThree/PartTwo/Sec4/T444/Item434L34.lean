open Item434L34 in
theorem card_eq_two_and_isGraphField (h : Ctx434Core G A M Q)
    (hinn : h.layerStar ≤ (MulAut.conj : layer G →* MulAut (layer G)).range)
    (h9 : Nat.card h.layerStar = 9) {k : Type} [Field k] (hk : Nat.card k = 4)
    (ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 k) :
    Nat.card Q = 2 ∧
      ∀ q ∈ Q, q ≠ 1 → (KFacts.stdPinnedPSL 3 k).IsGraphField (barConj G ψ q) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨-, hQ3, hAQ⟩ := (mem_invariantPiSubgroups_piCompl_iff Nat.prime_three).mp
    h.mem_invariant
  set P := projectiveSL 3 k
  set β := barConj G ψ with hβ
  have hQinj : ∀ q ∈ Q, β q = 1 → q = 1 := by
    intro q hq hq1
    have hqC := mem_centralizer_of_barConj_eq_one h.isQuasisimple ψ hq1
    have hmem : q ∈ Q ⊓ Subgroup.centralizer (layer G : Set G) := ⟨hq, hqC⟩
    rw [Item434.inf_centralizer_layer_eq_bot h, Subgroup.mem_bot] at hmem
    exact hmem
  have hβQinj : Function.Injective (β.comp Q.subtype) := by
    rw [injective_iff_map_eq_one]
    intro q hq
    exact Subtype.ext (hQinj q q.2 hq)
  set X := Q.map β with hX
  have hXcard : Nat.card X = Nat.card Q := by
    have hr : (β.comp Q.subtype).range = Q.map β := by
      rw [MonoidHom.range_comp, Subgroup.range_subtype]
    rw [hX, ← hr]
    exact (Nat.card_congr (MonoidHom.ofInjective hβQinj).toEquiv).symm
  have hδinj : Function.Injective ((MulAut.congr ψ).toMonoidHom.comp
      (KFacts.centerDescend (layer G))) := by
    rw [injective_iff_map_eq_one]
    intro σ hσ
    apply eq_one_of_centerDescend_eq_one h.isQuasisimple
    have h1 : MulAut.congr ψ (KFacts.centerDescend (layer G) σ) = 1 := hσ
    exact (MulAut.congr ψ).injective (h1.trans (map_one _).symm)
  have hβA : A.map β = h.layerStar.map ((MulAut.congr ψ).toMonoidHom.comp
      (KFacts.centerDescend (layer G))) := by
    rw [layerStar, Subgroup.map_map]
    rfl
  have hβAcard : Nat.card (A.map β) = 9 := by
    rw [hβA, Subgroup.card_map_of_injective hδinj, h9]
  have hβAinn : A.map β ≤ (MulAut.conj : P →* MulAut P).range := by
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨l, hl⟩ := hinn ⟨a, ha, rfl⟩
    exact ⟨_, (barConj_eq_conj ψ hl.symm).symm⟩
  set E := (A.map β).comap (MulAut.conj : P →* MulAut P) with hE
  have hEmap : E.map (MulAut.conj : P →* MulAut P) = A.map β :=
    Subgroup.map_comap_eq_self hβAinn
  have hEcard : Nat.card E = 9 := by
    rw [← hβAcard, ← hEmap, Subgroup.card_map_of_injective (KFacts.L34.conj_injective hk)]
  have hX3 : ¬ 3 ∣ Nat.card X := by rw [hXcard]; exact hQ3
  have hEX : ∀ e ∈ E, MulAut.conj e ∈ Subgroup.normalizer (X : Set (MulAut P)) := by
    intro e he
    obtain ⟨a, ha, hae⟩ := he
    rw [← hae]
    exact Subgroup.le_normalizer_map β ⟨a, hAQ ha, rfl⟩
  rcases KFacts.L34.eq_bot_or_eq_zpowers_graphField hk hEcard hX3 hEX with hbot |
    ⟨τ, hτX, hτ1, hττ, hτg, -⟩
  · exfalso
    apply h.ne_bot
    rw [eq_bot_iff]
    intro q hq
    have hq' : β q ∈ X := ⟨q, hq, rfl⟩
    rw [hbot, Subgroup.mem_bot] at hq'
    exact (Subgroup.mem_bot).mpr (hQinj q hq hq')
  · have hτ2 : orderOf τ = 2 :=
      orderOf_eq_prime (by rw [sq]; exact hττ) hτ1
    refine ⟨?_, fun q hq hq1 => ?_⟩
    · rw [← hXcard, hτX, Nat.card_zpowers, hτ2]
    · have hqX : β q ∈ Subgroup.zpowers τ := hτX ▸ ⟨q, hq, rfl⟩
      have hβq1 : β q ≠ 1 := fun h1 => hq1 (hQinj q hq h1)
      have hτinv : τ⁻¹ = τ := inv_eq_of_mul_eq_one_right hττ
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hqX
      have hcases : β q = τ := by
        rw [← hn, ← zpow_mod_orderOf, hτ2]
        rcases Int.emod_two_eq_zero_or_one n with h0 | h1
        · exfalso
          apply hβq1
          rw [← hn, ← zpow_mod_orderOf, hτ2]
          rw [show ((2 : ℕ) : ℤ) = 2 from rfl, h0, zpow_zero]
        · rw [show ((2 : ℕ) : ℤ) = 2 from rfl, h1, zpow_one]
      rw [hcases]
      exact hτg

theorem two_le_pRank_mulAut_quotient (h : Ctx434Core G A M Q) :
    2 ≤ CFSG.pRank 3 (MulAut (layer G ⧸ Subgroup.center (layer G))) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set δ := KFacts.centerDescend (layer G) with hδ
  have hδinj : Function.Injective δ := by
    rw [injective_iff_map_eq_one]
    intro σ hσ
    exact Item434L34.eq_one_of_centerDescend_eq_one h.isQuasisimple hσ
  set E := h.layerStar.map δ with hE
  have hEcard : Nat.card E = Nat.card h.layerStar := Subgroup.card_map_of_injective hδinj
  have hEe : CFSG.Assembly.IsElemAbelian 3 E :=
    CFSG.RankThreeEvenClassification.Helpers.isElemAbelian_map 3 δ _ h.isElemAbelian_layerStar
  have hEea : CFSG.IsElementaryAbelian 3 E :=
    { is_comm := hEe.1.is_comm
      exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one fun a =>
        Subtype.ext (by rw [SubgroupClass.coe_pow, hEe.2 a a.2, OneMemClass.coe_one]) }
  rcases h.card_layerStar with h9 | ⟨h27, -⟩
  · exact CFSG.RankThree.Coprime.le_pRank_of_isElementaryAbelian (by norm_num) hEea (k := 2)
      (by rw [hEcard, h9]; norm_num)
  · exact (by norm_num : 2 ≤ 3).trans
      (CFSG.RankThree.Coprime.le_pRank_of_isElementaryAbelian (by norm_num) hEea (k := 3)
        (by rw [hEcard, h27]; norm_num))

