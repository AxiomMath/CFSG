theorem mul_inv_mem_centralizer_of_layerConj_eq {a : G} {m : layer G}
    (ham : layerConj G a = MulAut.conj m) :
    a * (m : G)⁻¹ ∈ Subgroup.centralizer (layer G : Set G) := by
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  have h1 := congrArg (fun φ : MulAut (layer G) => ((φ (m⁻¹ * ⟨x, hx⟩ * m) : layer G) : G)) ham
  simp only [layerConj_apply_coe, MulAut.conj_apply] at h1
  push_cast at h1
  calc x * (a * (m : G)⁻¹) = a * ((m : G)⁻¹ * x * m) * a⁻¹ * (a * (m : G)⁻¹) := by
        rw [h1]; group
    _ = a * (m : G)⁻¹ * x := by group

open Item434L34 CFSG.LocalAnalysis.ComponentInitial.LinearFlag in
theorem concl434_of_isL34_of_center_ne_bot
    (hS : SeitzL34Outer) (h : Ctx434Core G A M Q)
    (hL : IsL34 (layer G ⧸ Subgroup.center (layer G)))
    (hZ : Subgroup.center (layer G) ≠ ⊥) : Concl434 A Q := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : (layer G).Characteristic := layer_characteristic
  have hinn := h.layerStar_le_range_conj hS hL
  have h9 := h.card_layerStar_eq_nine_of_isL34 hL
  obtain ⟨e⟩ := hL
  obtain ⟨K, _, _, ⟨hK, ⟨ψ₀⟩⟩ | ⟨hK, ⟨ψ₀⟩⟩⟩ := Census.coverSLThree46 (layer G) h.isQuasisimple
    h.isPGroup_center_layer hZ 2 2 (by norm_num) (Or.inl rfl) (Or.inl ⟨by norm_num, ⟨e⟩⟩)
  swap
  · exact absurd (KFacts.center_eq_bot_of_mulEquiv ψ₀
      (KFacts.center_statedSU_three_eq_bot (p := 2) (f := 2) (by norm_num) hK (by norm_num))) hZ
  have hK4 : Nat.card K = 4 := by rw [hK]; norm_num
  set ψ : layer G ≃* Matrix.SpecialLinearGroup (Fin 3) K := ψ₀.trans (statedSLEquiv 3 K) with hψ
  have hZ3 : Nat.card (Subgroup.center (layer G)) = 3 := by
    rw [card_center_congr ψ, KFacts.L34.card_center_specialLinearGroup hK4]
  have hZ3G : Nat.card (layer G ⊓ Subgroup.centralizer (layer G : Set G) : Subgroup G) = 3 := by
    rw [CFSG.GroupTheory.inf_centralizer_eq_map_center,
      Subgroup.card_map_of_injective (layer G).subtype_injective, hZ3]
  obtain ⟨hQ2, hQg⟩ := h.card_eq_two_and_isGraphField hinn h9 hK4 (quotCenterEquiv ψ)
  set E : Subgroup (layer G) := h.layerStar.comap (MulAut.conj : layer G →* MulAut (layer G))
    with hEdef
  have hmemE : ∀ m : layer G, m ∈ E ↔ ∃ a ∈ A, layerConj G a = MulAut.conj m := by
    intro m
    rw [hEdef, Subgroup.mem_comap]
    rfl
  have hconj1 : ∀ m : layer G, MulAut.conj m = 1 ↔ m ∈ Subgroup.center (layer G) := by
    intro m
    rw [Subgroup.mem_center_iff]
    constructor
    · intro hm y
      have h1 := congrArg (fun φ : MulAut (layer G) => φ y) hm
      simp only [MulAut.conj_apply, MulAut.one_apply] at h1
      calc y * m = m * y * m⁻¹ * m := by rw [h1]
        _ = m * y := by group
    · intro hm
      ext y
      rw [MulAut.conj_apply, MulAut.one_apply, ← hm y, mul_inv_cancel_right]
  have hZE : Subgroup.center (layer G) ≤ E := fun z hz => by
    rw [hmemE]
    exact ⟨1, one_mem _, by rw [map_one, (hconj1 z).mpr hz]⟩
  have hEcard : Nat.card E = 27 := by
    set f := (MulAut.conj : layer G →* MulAut (layer G)).comp E.subtype with hf
    have hker : f.ker = (Subgroup.center (layer G)).subgroupOf E := by
      ext m
      rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
      exact hconj1 m
    have hrange : f.range = h.layerStar := by
      rw [hf, MonoidHom.range_comp, Subgroup.range_subtype]
      exact Subgroup.map_comap_eq_self hinn
    have h1 := card_ker_mul_card_range f
    rw [hker, hrange, h9, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hZE).toEquiv, hZ3] at h1
    omega
  have hEheis : IsHeisThree E := by
    set V₀ := E.map ψ.toMonoidHom with hV₀
    have hscal : scalars 3 K ≤ V₀ := by
      intro s hs
      refine ⟨ψ.symm s, hZE ?_, by simp⟩
      have hsc : s ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) K) :=
        scalars_le_center 3 K hs
      rw [← map_center_mulEquiv ψ.symm]
      exact ⟨s, hsc, rfl⟩
    have hV₀card : Nat.card V₀ = 27 := by
      rw [hV₀, Subgroup.card_map_of_injective ψ.injective, hEcard]
    set E' := V₀.map (proj 3 K) with hE'
    have hE'card : Nat.card E' = 9 := by
      set f' := (proj 3 K).comp V₀.subtype with hf'
      have hker : f'.ker = (scalars 3 K).subgroupOf V₀ := by
        ext v
        rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
        exact proj_eq_one_iff
      have hrange : f'.range = E' := by rw [hf', MonoidHom.range_comp, Subgroup.range_subtype]
      have h1 := card_ker_mul_card_range f'
      rw [hker, hrange, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hscal).toEquiv,
        CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourFixedNine.card_scalars hK4,
        hV₀card] at h1
      omega
    have hV₀eq : E'.comap (proj 3 K) = V₀ :=
      Subgroup.comap_map_eq_self (by rw [ker_proj]; exact hscal)
    have h1 := KFacts.L34.isHeisThree_comap_proj hK4 hE'card
    rw [hV₀eq] at h1
    exact Sec13.isHeisThree_of_mulEquiv (E.equivMapOfInjective ψ.toMonoidHom ψ.injective).symm h1
  obtain ⟨⟨-, -, -, hEZ⟩, -, hEexp⟩ := hEheis
  have hE3 : ∀ m ∈ E, (m : G) ^ 3 = 1 := by
    intro m hm
    have h1 : (⟨m, hm⟩ : E) ^ 3 = 1 := by
      rw [← hEexp]
      exact Monoid.pow_exponent_eq_one _
    have h2 := congrArg (fun x : E => ((x : layer G) : G)) h1
    simpa using h2
  have hdec : ∀ a ∈ A, ∃ v ∈ layer G, v ^ 3 = 1 ∧
      a * v⁻¹ ∈ Subgroup.centralizer (layer G : Set G) := by
    intro a ha
    obtain ⟨m, hm⟩ := hinn ⟨a, ha, rfl⟩
    exact ⟨m, m.2, hE3 m ((hmemE m).mpr ⟨a, ha, hm.symm⟩),
      mul_inv_mem_centralizer_of_layerConj_eq hm.symm⟩
  have hnc : ∃ a₁ ∈ A, ∃ a₂ ∈ A, ∀ v₁ ∈ layer G, ∀ v₂ ∈ layer G,
      a₁ * v₁⁻¹ ∈ Subgroup.centralizer (layer G : Set G) →
        a₂ * v₂⁻¹ ∈ Subgroup.centralizer (layer G : Set G) → v₁ * v₂ ≠ v₂ * v₁ := by
    have hEnc : ∃ m₁ ∈ E, ∃ m₂ ∈ E, m₁ * m₂ ≠ m₂ * m₁ := by
      by_contra hall
      push Not at hall
      have htop : Subgroup.center E = ⊤ := by
        rw [eq_top_iff]
        intro x _
        rw [Subgroup.mem_center_iff]
        intro y
        exact Subtype.ext (hall y y.2 x x.2)
      rw [htop, Subgroup.card_top, hEcard] at hEZ
      omega
    obtain ⟨m₁, hm₁, m₂, hm₂, hne⟩ := hEnc
    obtain ⟨a₁, ha₁, h₁⟩ := (hmemE m₁).mp hm₁
    obtain ⟨a₂, ha₂, h₂⟩ := (hmemE m₂).mp hm₂
    refine ⟨a₁, ha₁, a₂, ha₂, fun v₁ hv₁ v₂ hv₂ hv₁C hv₂C hvv => hne ?_⟩
    have hw : ∀ {a : G} {m : layer G} {v : G}, v ∈ layer G → layerConj G a = MulAut.conj m →
        a * v⁻¹ ∈ Subgroup.centralizer (layer G : Set G) →
        (m : G) * v⁻¹ ∈ Subgroup.centralizer (layer G : Set G) := by
      intro a m v _ ham hav
      have h1 := mul_inv_mem_centralizer_of_layerConj_eq ham
      have : (m : G) * v⁻¹ = (a * (m : G)⁻¹)⁻¹ * (a * v⁻¹) := by group
      rw [this]
      exact mul_mem (inv_mem h1) hav
    have hw₁ := hw hv₁ h₁ hv₁C
    have hw₂ := hw hv₂ h₂ hv₂C
    apply Subtype.ext
    push_cast
    set w₁ := (m₁ : G) * v₁⁻¹
    set w₂ := (m₂ : G) * v₂⁻¹
    have hm₁' : (m₁ : G) = w₁ * v₁ := by simp [w₁]
    have hm₂' : (m₂ : G) = w₂ * v₂ := by simp [w₂]
    have hw₂L : w₂ ∈ layer G := mul_mem m₂.2 (inv_mem hv₂)
    have c1 : v₁ * w₂ = w₂ * v₁ := (Subgroup.mem_centralizer_iff.mp hw₂ v₁ hv₁)
    have c2 : v₂ * w₁ = w₁ * v₂ := (Subgroup.mem_centralizer_iff.mp hw₁ v₂ hv₂)
    have c3 : w₂ * w₁ = w₁ * w₂ := (Subgroup.mem_centralizer_iff.mp hw₁ w₂ hw₂L)
    rw [hm₁', hm₂']
    calc w₁ * v₁ * (w₂ * v₂) = w₁ * (v₁ * w₂) * v₂ := by group
      _ = w₁ * w₂ * (v₁ * v₂) := by rw [c1]; group
      _ = w₂ * w₁ * (v₂ * v₁) := by rw [hvv, c3]
      _ = w₂ * (w₁ * v₂) * v₁ := by group
      _ = w₂ * v₂ * (w₁ * v₁) := by rw [← c2]; group
  have hAL3 : Nat.card (A ⊓ layer G : Subgroup G) = 3 := by
    set C := A ⊓ Subgroup.centralizer (layer G : Set G) with hC
    have hC3 : Nat.card C = 3 := h.card_inf_centralizer_layer_eq_three h9
    set ZG := (Subgroup.center (layer G)).map (layer G).subtype with hZG
    have hZGp : IsPGroup 3 ZG := (CFSG.pCore_isPGroup (p := 3) (G := G)).to_le
      h.map_center_layer_le_pCore
    have hZGne : ZG ≠ ⊥ := by
      rw [hZG, Ne, Subgroup.map_eq_bot_iff_of_injective _ (layer G).subtype_injective]
      exact hZ
    have hAZ := inf_ne_bot_of_gamma_le h.isE27 h.gamma_le h.pRank_eq hZGp hZGne
    have hZGC : ZG ≤ Subgroup.centralizer (layer G : Set G) := by
      rw [hZG, ← CFSG.GroupTheory.inf_centralizer_eq_map_center]
      exact inf_le_right
    have hAZC : A ⊓ ZG ≤ C := inf_le_inf_left _ hZGC
    have h3 : 3 ≤ Nat.card (A ⊓ ZG : Subgroup G) := by
      rcases (hZGp.to_le (inf_le_right : A ⊓ ZG ≤ ZG)).card_eq_or_dvd with hc | hc
      · exact absurd (Subgroup.card_eq_one.mp hc) hAZ
      · exact Nat.le_of_dvd Nat.card_pos hc
    have hAZeq : A ⊓ ZG = C := Subgroup.eq_of_le_of_card_ge hAZC (hC3.trans_le h3)
    have hCL : C ≤ A ⊓ layer G := by
      rw [← hAZeq]
      exact inf_le_inf_left _ (Subgroup.map_subtype_le _)
    have hALZ : A ⊓ layer G ≤
        ((Subgroup.center E).map E.subtype).map (layer G).subtype := by
      intro b hb
      obtain ⟨hbA, hbL⟩ := Subgroup.mem_inf.mp hb
      have hbE : (⟨b, hbL⟩ : layer G) ∈ E := by
        rw [hmemE]
        refine ⟨b, hbA, ?_⟩
        ext x
        rw [layerConj_apply_coe]
        rfl
      have hbZ : (⟨⟨b, hbL⟩, hbE⟩ : E) ∈ Subgroup.center E := by
        rw [Subgroup.mem_center_iff]
        intro y
        obtain ⟨a, ha, hay⟩ := (hmemE y).mp y.2
        have h1 := congrArg (fun φ : MulAut (layer G) => ((φ ⟨b, hbL⟩ : layer G) : G)) hay
        simp only [layerConj_apply_coe, MulAut.conj_apply] at h1
        push_cast at h1
        have hab : a * b * a⁻¹ = b := by
          have hcomm : a * b = b * a :=
            congrArg Subtype.val (h.isE27.1.1.is_comm.comm ⟨a, ha⟩ ⟨b, hbA⟩)
          rw [hcomm]
          group
        apply Subtype.ext
        apply Subtype.ext
        push_cast
        calc ((y : layer G) : G) * b = ((y : layer G) : G) * b * ((y : layer G) : G)⁻¹ *
              ((y : layer G) : G) := by group
          _ = b * ((y : layer G) : G) := by rw [← h1, hab]
      exact ⟨⟨b, hbL⟩, ⟨⟨⟨b, hbL⟩, hbE⟩, hbZ, rfl⟩, rfl⟩
    have hle := Subgroup.card_le_of_le hALZ
    rw [Subgroup.card_map_of_injective (layer G).subtype_injective,
      Subgroup.card_map_of_injective E.subtype_injective, hEZ] at hle
    have hge := Subgroup.card_le_of_le hCL
    rw [hC3] at hge
    omega
  obtain ⟨ψ'⟩ := nonempty_slEquiv hK4
  refine ⟨Or.inr (isHeisSLThreeFour_sup h.isE27.1 h.isE27.2 (ψ.trans ψ') hZ3G hAL3 hdec hnc),
    hQ2, fun q hq hq1 => ?_⟩
  have hθ := h.aschbacherSolvableCore_layer_eq_bot
  have hqN : q ∈ Subgroup.normalizer (layer G : Set G) := by
    rw [Subgroup.normalizer_eq_top (layer G)]
    exact Subgroup.mem_top q
  refine KFacts.InducesStdKind.sl 3 K le_rfl
    ⟨(QuotientGroup.quotientMulEquivOfEq hθ).trans (QuotientGroup.quotientBot.trans ψ), hqN, ?_⟩
  rw [KFacts.PinnedAut.hasKind_graphField, descendAut_inducedAutHom_eq_barConj hθ ψ hqN]
  exact hQg q hq hq1

