@[expose] def IsL34 (X : Type) [Group X] : Prop :=
  Nonempty (X ≃* projSL 3 (GaloisField 2 2))

@[expose] def SeitzL34Outer : Prop :=
  ∀ (X : Type) [Group X] [Finite X], IsQuasisimple X → IsPGroup 3 (Subgroup.center X) →
    IsL34 (X ⧸ Subgroup.center X) →
    ∀ E : Subgroup (MulAut X), CFSG.Assembly.IsElemAbelian 3 E → Nat.card E = 9 →
      ¬ E ≤ (MulAut.conj : X →* MulAut X).range →
      CFSG.LieType.Seitz.seitzHyperGamma 3 E = ⊤

namespace Item434L34

theorem card_le_nine_of_mulEquiv {X : Type} [Group X] (ψ : X ≃* projectiveSL 3 (GaloisField 2 2))
    {W : Subgroup (MulAut X)} (hW : CFSG.Assembly.IsElemAbelian 3 W) [Finite W] :
    Nat.card W ≤ 9 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hk := KFacts.L34.card_galoisField_two_two
  have : Finite (MulAut (projectiveSL 3 (GaloisField 2 2))) :=
    Nat.finite_of_card_ne_zero (by rw [KFacts.L34.card_mulAut hk]; norm_num)
  set φ : MulAut X →* MulAut (projectiveSL 3 (GaloisField 2 2)) :=
    (MulAut.congr ψ).toMonoidHom with hφ
  have hφinj : Function.Injective φ := (MulAut.congr ψ).injective
  set W' := W.map φ with hW'
  have hW'card : Nat.card W' = Nat.card W := Subgroup.card_map_of_injective hφinj
  have hW3 : IsPGroup 3 W := fun w => ⟨1, Subtype.ext (by simpa using hW.2 w w.2)⟩
  obtain ⟨n, hn⟩ := hW3.exists_card_eq
  have hW'ea : CFSG.IsElementaryAbelian 3 W' :=
    { is_comm := ⟨fun a b => by
        obtain ⟨_, ⟨x, hx, rfl⟩⟩ := a
        obtain ⟨_, ⟨y, hy, rfl⟩⟩ := b
        apply Subtype.ext
        change φ x * φ y = φ y * φ x
        rw [← map_mul, ← map_mul]
        exact congrArg (fun z => φ z)
          (congrArg Subtype.val (hW.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩))⟩
      exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one fun a => by
        obtain ⟨_, ⟨x, hx, rfl⟩⟩ := a
        apply Subtype.ext
        change φ x ^ 3 = 1
        rw [← map_pow, hW.2 x hx, map_one] }
  have hle := CFSG.RankThree.Coprime.le_pRank_of_isElementaryAbelian (by norm_num) hW'ea
    (k := n) (by rw [hW'card, hn])
  rw [KFacts.L34.pRank_three_mulAut hk] at hle
  rw [hn]
  calc 3 ^ n ≤ 3 ^ 2 := Nat.pow_le_pow_right (by norm_num) hle
    _ = 9 := by norm_num

section Bar

variable (G : Type) [Group G] {k : Type} [Field k]

noncomputable def barConj (ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 k) :
    G →* MulAut (projectiveSL 3 k) :=
  (MulAut.congr ψ).toMonoidHom.comp ((KFacts.centerDescend (layer G)).comp (layerConj G))

variable {G}

theorem barConj_apply_mk (ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 k) (g : G)
    (x : layer G) :
    barConj G ψ g (ψ (x : layer G ⧸ Subgroup.center (layer G))) =
      ψ ((layerConj G g x : layer G) : layer G ⧸ Subgroup.center (layer G)) := by
  simp [barConj, MulAut.congr_apply, KFacts.centerDescend_mk]

theorem eq_one_of_centerDescend_eq_one (hL : IsQuasisimple (layer G)) {σ : MulAut (layer G)}
    (hσ : KFacts.centerDescend (layer G) σ = 1) : σ = 1 := by
  have : Group.IsPerfect (layer G) := hL.1
  refine KFacts.eq_one_of_forall_mul_inv_mem_center fun s => ?_
  have h1 := congrArg (fun φ : MulAut (layer G ⧸ Subgroup.center (layer G)) =>
    φ (s : layer G ⧸ Subgroup.center (layer G))) hσ
  simp only [KFacts.centerDescend_mk, MulAut.one_apply] at h1
  have h2 := QuotientGroup.eq.mp h1.symm
  exact h2

theorem mem_centralizer_of_barConj_eq_one (hL : IsQuasisimple (layer G))
    (ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 k) {g : G}
    (hg : barConj G ψ g = 1) : g ∈ Subgroup.centralizer (layer G : Set G) := by
  rw [← layerConj_eq_one_iff]
  apply eq_one_of_centerDescend_eq_one hL
  have h1 : MulAut.congr ψ (KFacts.centerDescend (layer G) (layerConj G g)) = 1 := hg
  exact (MulAut.congr ψ).injective (h1.trans (map_one _).symm)

theorem barConj_eq_conj (ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 k) {g : G}
    {l : layer G} (hgl : layerConj G g = MulAut.conj l) :
    barConj G ψ g = MulAut.conj (ψ (l : layer G ⧸ Subgroup.center (layer G))) := by
  change MulAut.congr ψ (KFacts.centerDescend (layer G) (layerConj G g)) = _
  rw [hgl, KFacts.centerDescend_conj, KFacts.congr_mulAutConj]

theorem compAction_eq_layerConj {g : G} (hg : g ∈ Subgroup.normalizer (layer G : Set G)) :
    compAction (layer G) ⟨g, hg⟩ = layerConj G g := by
  ext x
  rw [layerConj_apply_coe]
  rfl

theorem inducedAutHom_eq_barConj [Finite G]
    (hθZ : aschbacherSolvableCore 3 (layer G) = Subgroup.center (layer G))
    (ψ : layer G ⧸ Subgroup.center (layer G) ≃* projectiveSL 3 k) {g : G}
    (hg : g ∈ Subgroup.normalizer (layer G : Set G)) :
    KFacts.inducedAutHom (layer G) ((QuotientGroup.quotientMulEquivOfEq hθZ).trans ψ)
      ⟨g, hg⟩ = barConj G ψ g := by
  ext y
  obtain ⟨z, rfl⟩ := ((QuotientGroup.quotientMulEquivOfEq hθZ).trans ψ).surjective y
  have key : ∀ y : layer G, ((QuotientGroup.quotientMulEquivOfEq hθZ).trans ψ)
      ((y : layer G) : layer G ⧸ aschbacherSolvableCore 3 (layer G)) =
        ψ ((y : layer G) : layer G ⧸ Subgroup.center (layer G)) := fun y => by
    rw [MulEquiv.trans_apply, QuotientGroup.quotientMulEquivOfEq_mk]
  induction z using QuotientGroup.induction_on with
  | H x =>
    rw [KFacts.inducedAutHom_apply, MulAut.congr_apply, MulEquiv.trans_apply,
      MulEquiv.trans_apply, MulEquiv.symm_apply_apply, thetaQuotMulAut_mk,
      compAction_eq_layerConj, key, key, barConj_apply_mk]

end Bar

section Heis

variable {G : Type} [Group G] [Finite G]

theorem card_ker_mul_card_range {X Y : Type*} [Group X] [Group Y] (f : X →* Y) :
    Nat.card f.ker * Nat.card f.range = Nat.card X := by
  rw [← Subgroup.index_ker, Subgroup.card_mul_index]

omit [Finite G] in
theorem card_sup_mul_card_inf (A L : Subgroup G) [L.Normal] :
    Nat.card (A ⊔ L : Subgroup G) * Nat.card (A ⊓ L : Subgroup G) = Nat.card A * Nat.card L := by
  have h1 := Subgroup.relIndex_mul_card (H := L) (K := A ⊔ L)
  have h2 := Subgroup.relIndex_mul_card (H := L) (K := A)
  rw [Subgroup.relIndex_sup_right, inf_of_le_left (le_sup_right : L ≤ A ⊔ L)] at h1
  rw [inf_comm] at h2
  rw [← h1, ← h2]
  ring

omit [Finite G] in
theorem inf_subgroupOf' (H K X : Subgroup G) :
    (H ⊓ K).subgroupOf X = H.subgroupOf X ⊓ K.subgroupOf X := by
  ext x
  simp [Subgroup.mem_subgroupOf]

theorem isHeisSLThreeFour_sup {A L : Subgroup G} [L.Normal]
    (hAel : CFSG.Assembly.IsElemAbelian 3 A) (hA27 : Nat.card A = 27)
    (ψ : L ≃* Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 2))
    (hZ3 : Nat.card (L ⊓ Subgroup.centralizer (L : Set G) : Subgroup G) = 3)
    (hAL3 : Nat.card (A ⊓ L : Subgroup G) = 3)
    (hdec : ∀ a ∈ A, ∃ v ∈ L, v ^ 3 = 1 ∧ a * v⁻¹ ∈ Subgroup.centralizer (L : Set G))
    (hnc : ∃ a₁ ∈ A, ∃ a₂ ∈ A, ∀ v₁ ∈ L, ∀ v₂ ∈ L,
      a₁ * v₁⁻¹ ∈ Subgroup.centralizer (L : Set G) →
        a₂ * v₂⁻¹ ∈ Subgroup.centralizer (L : Set G) → v₁ * v₂ ≠ v₂ * v₁) :
    IsHeisSLThreeFour ↥(A ⊔ L) := by
  have hAcomm : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hAel.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hva : ∀ {a v : G}, v ∈ L → a * v⁻¹ ∈ Subgroup.centralizer (L : Set G) → a * v = v * a := by
    intro a v hv hav
    have h := Subgroup.mem_centralizer_iff.mp hav v hv
    calc a * v = a * v⁻¹ * v * v := by group
      _ = v * (a * v⁻¹) * v := by rw [h]
      _ = v * a := by group
  set U : Subgroup G := (A ⊔ L) ⊓ Subgroup.centralizer (L : Set G) with hU
  have hUL : U ⊔ L = A ⊔ L := by
    apply le_antisymm (sup_le inf_le_left le_sup_right)
    refine sup_le (fun a ha => ?_) le_sup_right
    obtain ⟨v, hv, -, hvC⟩ := hdec a ha
    have hav : a * v⁻¹ ∈ U :=
      ⟨mul_mem (Subgroup.mem_sup_left ha) (Subgroup.mem_sup_right (inv_mem hv)), hvC⟩
    have : a = a * v⁻¹ * v := by group
    rw [this]
    exact mul_mem (Subgroup.mem_sup_left hav) (Subgroup.mem_sup_right hv)
  have hUinf : U ⊓ L = L ⊓ Subgroup.centralizer (L : Set G) := by
    ext x
    simp only [Subgroup.mem_inf, hU]
    constructor
    · rintro ⟨⟨-, h⟩, h'⟩
      exact ⟨h', h⟩
    · rintro ⟨h', h⟩
      exact ⟨⟨Subgroup.mem_sup_right h', h⟩, h'⟩
  have hcardAL := card_sup_mul_card_inf A L
  rw [hAL3, hA27] at hcardAL
  have hcommUL : ∀ x ∈ U, ∀ y ∈ L, x * y = y * x := fun x hx y hy =>
    (Subgroup.mem_centralizer_iff.mp hx.2 y hy).symm
  have hcardUL := (CFSG.GroupTheory.card_sup_mul_card_inf_of_commute U L hcommUL).1
  rw [hUL, hUinf, hZ3] at hcardUL
  have hLpos : 0 < Nat.card L := Nat.card_pos
  have hU27 : Nat.card U = 27 := by
    have : Nat.card U * Nat.card L = 27 * Nat.card L := by rw [← hcardUL, hcardAL]
    exact Nat.eq_of_mul_eq_mul_right hLpos this
  have hZexp : ∀ z ∈ L ⊓ Subgroup.centralizer (L : Set G), z ^ 3 = 1 := by
    intro z hz
    have h := orderOf_dvd_natCard (⟨z, hz⟩ : (L ⊓ Subgroup.centralizer (L : Set G) :
      Subgroup G))
    rw [hZ3, Subgroup.orderOf_mk] at h
    exact orderOf_dvd_iff_pow_eq_one.mp h
  have hU3 : ∀ u ∈ U, u ^ 3 = 1 := by
    intro u hu
    obtain ⟨huAL, huC⟩ := Subgroup.mem_inf.mp hu
    obtain ⟨a, ha, l, hl, rfl⟩ := Subgroup.mem_sup_of_normal_right.mp huAL
    obtain ⟨v, hv, hv3, hvC⟩ := hdec a ha
    have hvl : v * l ∈ L ⊓ Subgroup.centralizer (L : Set G) := by
      refine Subgroup.mem_inf.mpr ⟨mul_mem hv hl, ?_⟩
      have : v * l = (a * v⁻¹)⁻¹ * (a * l) := by group
      rw [this]
      exact mul_mem (inv_mem hvC) huC
    have hal : a * l = (a * v⁻¹) * (v * l) := by group
    rw [hal]
    have hc1 : Commute (a * v⁻¹) (v * l) :=
      (Subgroup.mem_centralizer_iff.mp hvC (v * l) hvl.1).symm
    have hc2 : Commute a v⁻¹ := Commute.inv_right (hva hv hvC)
    rw [hc1.mul_pow, hc2.mul_pow, hAel.2 a ha, inv_pow, hv3, inv_one, one_mul, one_mul,
      hZexp _ hvl]
  have hUnc : ¬ ∀ u ∈ U, ∀ u' ∈ U, u * u' = u' * u := by
    intro hUc
    obtain ⟨a₁, ha₁, a₂, ha₂, hne⟩ := hnc
    obtain ⟨v₁, hv₁, -, hv₁C⟩ := hdec a₁ ha₁
    obtain ⟨v₂, hv₂, -, hv₂C⟩ := hdec a₂ ha₂
    apply hne v₁ hv₁ v₂ hv₂ hv₁C hv₂C
    have hu₁ : a₁ * v₁⁻¹ ∈ U :=
      ⟨mul_mem (Subgroup.mem_sup_left ha₁) (Subgroup.mem_sup_right (inv_mem hv₁)), hv₁C⟩
    have hu₂ : a₂ * v₂⁻¹ ∈ U :=
      ⟨mul_mem (Subgroup.mem_sup_left ha₂) (Subgroup.mem_sup_right (inv_mem hv₂)), hv₂C⟩
    have hcu := hUc _ hu₁ _ hu₂
    obtain ⟨u₁, hu₁d⟩ : ∃ u, u = a₁ * v₁⁻¹ := ⟨_, rfl⟩
    obtain ⟨u₂, hu₂d⟩ : ∃ u, u = a₂ * v₂⁻¹ := ⟨_, rfl⟩
    rw [← hu₁d, ← hu₂d] at hcu
    have hu₂v₁ : u₂ * v₁ = v₁ * u₂ := by
      rw [hu₂d]
      exact (Subgroup.mem_centralizer_iff.mp hv₂C v₁ hv₁).symm
    have hu₁v₂ : u₁ * v₂ = v₂ * u₁ := by
      rw [hu₁d]
      exact (Subgroup.mem_centralizer_iff.mp hv₁C v₂ hv₂).symm
    have ha₁' : a₁ = u₁ * v₁ := by rw [hu₁d]; group
    have ha₂' : a₂ = u₂ * v₂ := by rw [hu₂d]; group
    have h := hAcomm a₁ ha₁ a₂ ha₂
    rw [ha₁', ha₂'] at h
    have h' : u₁ * u₂ * (v₁ * v₂) = u₁ * u₂ * (v₂ * v₁) :=
      calc u₁ * u₂ * (v₁ * v₂) = u₁ * (u₂ * v₁) * v₂ := by group
        _ = u₁ * (v₁ * u₂) * v₂ := by rw [hu₂v₁]
        _ = u₁ * v₁ * (u₂ * v₂) := by group
        _ = u₂ * v₂ * (u₁ * v₁) := h
        _ = u₂ * (v₂ * u₁) * v₁ := by group
        _ = u₂ * (u₁ * v₂) * v₁ := by rw [hu₁v₂]
        _ = u₂ * u₁ * (v₂ * v₁) := by group
        _ = u₁ * u₂ * (v₂ * v₁) := by rw [hcu]
    exact mul_left_cancel h'
  refine ⟨U.subgroupOf (A ⊔ L), L.subgroupOf (A ⊔ L), ?_, ?_, ?_,
    ⟨(Subgroup.subgroupOfEquivOfLe le_sup_right).trans ψ⟩, ?_⟩
  · rw [← Subgroup.subgroupOf_sup inf_le_left le_sup_right, hUL, Subgroup.subgroupOf_self]
  · intro u hu v hv
    rw [Subgroup.mem_subgroupOf] at hu hv
    exact Subtype.ext ((Subgroup.mem_centralizer_iff.mp hu.2 _ hv).symm)
  · apply isHeisThree_of
    · rw [← hU27]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_left).toEquiv
    · intro x
      apply Subtype.ext
      apply Subtype.ext
      have := hU3 _ (Subgroup.mem_subgroupOf.mp x.2)
      simpa using this
    · intro hcomm
      apply hUnc
      intro u hu u' hu'
      have h := hcomm.is_comm.comm ⟨⟨u, hu.1⟩, Subgroup.mem_subgroupOf.mpr hu⟩
        ⟨⟨u', hu'.1⟩, Subgroup.mem_subgroupOf.mpr hu'⟩
      exact congrArg (fun x : ↥(U.subgroupOf (A ⊔ L)) => ((x : ↥(A ⊔ L)) : G)) h
  · rw [← inf_subgroupOf', ← Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      ((inf_le_right : U ⊓ L ≤ L).trans le_sup_right)).toEquiv.symm, hUinf, hZ3]

end Heis

section SL

open CFSG.LocalAnalysis.ComponentInitial.LinearFlag (scalars proj)

@[expose] noncomputable def slCongr {S S' : Type} [Field S] [Field S'] (φ : S ≃+* S') :
    Matrix.SpecialLinearGroup (Fin 3) S ≃* Matrix.SpecialLinearGroup (Fin 3) S' where
  toFun := Matrix.SpecialLinearGroup.map φ.toRingHom
  invFun := Matrix.SpecialLinearGroup.map φ.symm.toRingHom
  left_inv A := by ext i j; simp
  right_inv A := by ext i j; simp
  map_mul' := map_mul _

theorem nonempty_slEquiv {K : Type} [Field K] [Finite K] (hK : Nat.card K = 4) :
    Nonempty (Matrix.SpecialLinearGroup (Fin 3) K ≃*
      Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 2)) := by
  have := Fintype.ofFinite K
  have : Fintype (GaloisField 2 2) := Fintype.ofFinite _
  have hc : Fintype.card K = Fintype.card (GaloisField 2 2) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hK,
      KFacts.L34.card_galoisField_two_two]
  exact ⟨slCongr (FiniteField.ringEquivOfCardEq hc)⟩

noncomputable def quotCenterEquiv {S : Type} [Group S] {K : Type} [Field K]
    (ψ : S ≃* Matrix.SpecialLinearGroup (Fin 3) K) :
    S ⧸ Subgroup.center S ≃* projectiveSL 3 K :=
  QuotientGroup.congr (Subgroup.center S) (scalars 3 K) ψ
    ((map_center_mulEquiv ψ).trans
      (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center 3 K).symm)

theorem quotCenterEquiv_mk {S : Type} [Group S] {K : Type} [Field K]
    (ψ : S ≃* Matrix.SpecialLinearGroup (Fin 3) K) (x : S) :
    quotCenterEquiv ψ (x : S ⧸ Subgroup.center S) = proj 3 K (ψ x) :=
  QuotientGroup.congr_mk _ _ _ _ x

theorem descendAut_inducedAutHom_eq_barConj {G : Type} [Group G] [Finite G] {K : Type} [Field K]
    (hθ : aschbacherSolvableCore 3 (layer G) = ⊥)
    (ψ : layer G ≃* Matrix.SpecialLinearGroup (Fin 3) K) {g : G}
    (hg : g ∈ Subgroup.normalizer (layer G : Set G)) :
    CFSG.LocalAnalysis.ComponentInitial.LinearFlag.descendAut 3 K
        (KFacts.inducedAutHom (layer G)
          ((QuotientGroup.quotientMulEquivOfEq hθ).trans (QuotientGroup.quotientBot.trans ψ))
          ⟨g, hg⟩) =
      barConj G (quotCenterEquiv ψ) g := by
  set e : layer G ⧸ aschbacherSolvableCore 3 (layer G) ≃* Matrix.SpecialLinearGroup (Fin 3) K :=
    (QuotientGroup.quotientMulEquivOfEq hθ).trans (QuotientGroup.quotientBot.trans ψ) with he
  have key : ∀ y : layer G, e (y : layer G ⧸ aschbacherSolvableCore 3 (layer G)) = ψ y :=
    fun y => rfl
  ext p
  obtain ⟨s, rfl⟩ := CFSG.LocalAnalysis.ComponentInitial.LinearFlag.proj_surjective 3 K p
  obtain ⟨x, rfl⟩ := ψ.surjective s
  rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.descendAut_proj, ← key x,
    KFacts.inducedAutHom_apply, MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply,
    MulEquiv.symm_apply_apply, thetaQuotMulAut_mk, compAction_eq_layerConj, key, key,
    ← quotCenterEquiv_mk ψ x, barConj_apply_mk, quotCenterEquiv_mk]

