  exact KFacts.L34.card_center_of_mulEquiv e

omit [Finite X] in
theorem eq_or_le_center {K : Subgroup X} (hKI : K ≤ I)
    (hIK : I ≤ Subgroup.normalizer (K : Set X)) :
    K = I ∨ K ≤ I ⊓ Subgroup.centralizer (I : Set X) := by
  have hn : (K.subgroupOf I).Normal := (Subgroup.normal_subgroupOf_iff_le_normalizer hKI).mpr hIK
  rcases LocalCores.quasisimple_normal_subgroups h.isQuasisimple_I hn with htop | hcen
  · left
    refine le_antisymm hKI fun x hx => ?_
    have : (⟨x, hx⟩ : I) ∈ K.subgroupOf I := htop ▸ Subgroup.mem_top _
    exact Subgroup.mem_subgroupOf.mp this
  · right
    rw [inf_centralizer_eq_map_center]
    intro x hx
    exact ⟨⟨x, hKI hx⟩, hcen (Subgroup.mem_subgroupOf.mpr hx), rfl⟩

omit [Finite X] in
theorem pow_three_of_le_I {P : Subgroup X} (hPI : P ≤ I) (hP : IsPGroup 3 P) {x : X}
    (hx : x ∈ P) : x ^ 3 = 1 := by
  obtain ⟨e⟩ := h.equivSL
  obtain ⟨n, hn⟩ := hP ⟨x, hx⟩
  have hn' : (⟨x, hPI hx⟩ : I) ^ (3 ^ n) = 1 :=
    Subtype.ext (by simpa using congrArg Subtype.val hn)
  have h3 := pow_three_eq_one_of_mulEquiv e (fun y hy => pow_three_eq_one_of_SL hy)
    (isPGroup_zpowers_of_pow_eq_one hn')
  simpa using congrArg Subtype.val h3

theorem card_le_nine_of_le_I {E : Subgroup X} (hEI : E ≤ I)
    (hE : CFSG.Assembly.IsElemAbelian 3 E) : Nat.card E ≤ 9 := by
  obtain ⟨e⟩ := h.equivSL
  have hr : CFSG.pRank 3 I = 2 := by
    rw [CFSG.RankThree.Asc83Table.pRank_congr e]
    exact KFacts.L34.pRank_three_specialLinearGroup KFacts.L34.card_galoisField_two_two
  have := KFacts.KS18.card_inf_le_nine hE hr
  rwa [inf_eq_left.mpr hEI] at this

omit [Finite X] in
theorem center_le_A : I ⊓ Subgroup.centralizer (I : Set X) ≤ A := by
  intro z hz
  apply h.mem_of_mem_centralizer
  · rw [Subgroup.mem_centralizer_iff]
    intro a ha
    obtain ⟨i, hi, hai⟩ := h.inner a ha
    have h1 := hai z hz.1
    rw [Subgroup.mem_centralizer_iff.mp hz.2 i hi, mul_inv_cancel_right] at h1
    calc a * z = (a * z * a⁻¹) * a := by group
      _ = z * a := by rw [h1]
  · have hord := orderOf_dvd_natCard (⟨z, hz⟩ : (I ⊓ Subgroup.centralizer (I : Set X) :
      Subgroup X))
    rw [h.card_center_I, Subgroup.orderOf_mk] at hord
    exact orderOf_dvd_iff_pow_eq_one.mp hord

theorem shape_L :
    (Nonempty (L ≃* projSL 3 (GaloisField 2 2)) ∨
        Nonempty (L ≃* Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 2))) ∧
      Nat.card (A ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) ≤ 3 ∧
      ∀ a ∈ A, ∃ l ∈ L, ∀ y ∈ L, a * y * a⁻¹ = l * y * l⁻¹ :=
  shape_sup h.isE27 h.le_normalizer_A h.isQuasisimple.1 h.shape

theorem card_L : Nat.card L = 20160 * Nat.card (L ⊓ Subgroup.centralizer (L : Set X) :
      Subgroup X) ∧ Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) ∣ 3 :=
  card_of_shape h.shape_L.1

theorem le_sup_centralizer_L : L ≤ I ⊔ Subgroup.centralizer (L : Set X) := by
  set C := Subgroup.centralizer (L : Set X) with hC
  have hIC : I ≤ Subgroup.normalizer (C : Set X) := fun i hi => Subgroup.mem_normalizer_iff.mpr
    fun c => ⟨fun hc => conj_mem_centralizer (h.le_normalizer_L hi) hc, fun hc => by
      have := conj_mem_centralizer (Subgroup.inv_mem _ (h.le_normalizer_L hi)) hc
      simpa [mul_assoc] using this⟩
  have hIZ : I ⊓ C ≤ I ⊓ Subgroup.centralizer (I : Set X) := by
    rcases h.eq_or_le_center (K := I ⊓ C) inf_le_left
        (fun i hi => Subgroup.inf_normalizer_le_normalizer_inf ⟨Subgroup.le_normalizer hi,
          hIC hi⟩) with heq | hle
    · exact absurd (heq ▸ inf_le_right : I ≤ C) h.not_le_centralizer
    · exact hle
  have hcIC : Nat.card (I ⊓ C : Subgroup X) ≤ 3 :=
    (Subgroup.card_le_of_le hIZ).trans h.card_center_I.le
  have h1 := card_sup_mul_card_inf hIC
  have h2 := card_sup_mul_card_inf (le_normalizer_centralizer L)
  rw [h.card_I] at h1
  obtain ⟨hL, -⟩ := h.card_L
  rw [hL] at h2
  have hZL : 0 < Nat.card (L ⊓ C : Subgroup X) := Nat.card_pos
  have hle : I ⊔ C ≤ L ⊔ C := sup_le h.le_sup_centralizer le_sup_right
  have hcard : Nat.card (L ⊔ C : Subgroup X) ≤ Nat.card (I ⊔ C : Subgroup X) := by
    have hCpos : 0 < Nat.card C := Nat.card_pos
    have hIpos : 0 < Nat.card (I ⊓ C : Subgroup X) := Nat.card_pos
    have h3 : Nat.card (L ⊔ C : Subgroup X) = 20160 * Nat.card C := by
      have := h2
      rw [mul_comm 20160, mul_assoc] at this
      have h4 : Nat.card (L ⊔ C : Subgroup X) * Nat.card (L ⊓ C : Subgroup X) =
          (20160 * Nat.card C) * Nat.card (L ⊓ C : Subgroup X) := by
        rw [h2]; ring
      exact Nat.eq_of_mul_eq_mul_right hZL h4
    rw [h3]
    by_contra hlt
    push Not at hlt
    have h5 : Nat.card (I ⊔ C : Subgroup X) * Nat.card (I ⊓ C : Subgroup X) <
        20160 * Nat.card C * 3 :=
      calc Nat.card (I ⊔ C : Subgroup X) * Nat.card (I ⊓ C : Subgroup X)
          ≤ Nat.card (I ⊔ C : Subgroup X) * 3 := Nat.mul_le_mul_left _ hcIC
        _ < 20160 * Nat.card C * 3 := Nat.mul_lt_mul_of_pos_right hlt (by norm_num)
    rw [h1] at h5
    nlinarith
  have heq : I ⊔ C = L ⊔ C := Subgroup.eq_of_le_of_card_ge hle hcard
  rw [heq]
  exact le_sup_left

omit [Finite X] in
theorem center_I_le_centralizer_L (hLI : L ≤ I ⊔ Subgroup.centralizer (L : Set X)) :
    I ⊓ Subgroup.centralizer (I : Set X) ≤ Subgroup.centralizer (L : Set X) := fun _ hz =>
  mem_centralizer_of_inner_of_mem_centralizer h.isQuasisimple h.le_normalizer_L hLI
    (h.le_normalizer_L hz.1) (inner_of_mem_sup_centralizer (h.le_sup_centralizer hz.1)) hz.2

theorem inf_centralizer_L_eq :
    A ⊓ Subgroup.centralizer (L : Set X) = I ⊓ Subgroup.centralizer (I : Set X) := by
  have hle : I ⊓ Subgroup.centralizer (I : Set X) ≤ A ⊓ Subgroup.centralizer (L : Set X) :=
    le_inf h.center_le_A (h.center_I_le_centralizer_L h.le_sup_centralizer_L)
  exact (Subgroup.eq_of_le_of_card_ge hle (by rw [h.card_center_I]; exact h.shape_L.2.1)).symm

theorem center_L_le : L ⊓ Subgroup.centralizer (L : Set X) ≤
    I ⊓ Subgroup.centralizer (I : Set X) := by
  rw [← h.inf_centralizer_L_eq]
  refine le_inf (fun z hz => h.mem_of_mem_centralizer z ?_ ?_) inf_le_right
  · rw [Subgroup.mem_centralizer_iff]
    intro a ha
    obtain ⟨l, hl, hal⟩ := h.shape_L.2.2 a ha
    have h1 := hal z hz.1
    rw [(Subgroup.mem_centralizer_iff.mp hz.2 l hl), mul_inv_cancel_right] at h1
    calc a * z = (a * z * a⁻¹) * a := by group
      _ = z * a := by rw [h1]
  · have hord := orderOf_dvd_natCard (⟨z, hz⟩ : (L ⊓ Subgroup.centralizer (L : Set X) :
      Subgroup X))
    rw [Subgroup.orderOf_mk] at hord
    exact orderOf_dvd_iff_pow_eq_one.mp (hord.trans h.card_L.2)

theorem inf_centralizer_I_eq :
    A ⊓ Subgroup.centralizer (I : Set X) = I ⊓ Subgroup.centralizer (I : Set X) := by
  apply le_antisymm
  · rw [← h.inf_centralizer_L_eq]
    exact fun a ha => ⟨ha.1, mem_centralizer_of_inner_of_mem_centralizer h.isQuasisimple
      h.le_normalizer_L h.le_sup_centralizer_L (h.le_normalizer_A ha.1) (h.shape_L.2.2 a ha.1)
      ha.2⟩
  · exact le_inf h.center_le_A inf_le_right

omit [Finite X] in
theorem le_normalizer_centralizer_I :
    A ≤ Subgroup.normalizer ((Subgroup.centralizer (I : Set X) : Subgroup X) : Set X) :=
  fun a ha => Subgroup.mem_normalizer_iff.mpr fun c =>
    ⟨fun hc => conj_mem_centralizer (h.le_normalizer_I ha) hc, fun hc => by
      have := conj_mem_centralizer (Subgroup.inv_mem _ (h.le_normalizer_I ha)) hc
      simpa [mul_assoc] using this⟩

omit [Finite X] in
theorem coe_sup_A_I : ((A ⊔ I : Subgroup X) : Set X) = (A : Set X) * (I : Set X) :=
  Subgroup.coe_mul_of_left_le_normalizer_right A I h.le_normalizer_I

omit [Finite X] in
theorem exists_mul_eq (a : X) (ha : a ∈ A) :
    ∃ b ∈ (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X), ∃ i ∈ I, a = b * i := by
  obtain ⟨i, hi, hai⟩ := h.inner a ha
  refine ⟨a * i⁻¹, ⟨Subgroup.mul_mem _ (Subgroup.mem_sup_left ha)
    (Subgroup.inv_mem _ (Subgroup.mem_sup_right hi)), ?_⟩, i, hi, by group⟩
  show a * i⁻¹ ∈ Subgroup.centralizer (I : Set X)
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  have h1 := hai (i⁻¹ * x * i) (I.mul_mem (I.mul_mem (I.inv_mem hi) hx) hi)
  have h2 : a * (i⁻¹ * x * i) * a⁻¹ = x := by rw [h1]; group
  calc x * (a * i⁻¹) = a * (i⁻¹ * x * i) * a⁻¹ * (a * i⁻¹) := by rw [h2]
    _ = a * i⁻¹ * x := by group

omit [Finite X] h in
theorem B_inf_I : (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) ⊓ I =
    I ⊓ Subgroup.centralizer (I : Set X) := by
  ext x
  constructor
  · rintro ⟨⟨-, hc⟩, hx⟩
    exact ⟨hx, hc⟩
  · rintro ⟨hx, hc⟩
    exact ⟨⟨Subgroup.mem_sup_right hx, hc⟩, hx⟩

theorem B_le_centralizer_L (hLI : L ≤ I ⊔ Subgroup.centralizer (L : Set X)) :
    (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) ≤ Subgroup.centralizer (L : Set X) := by
  rintro b ⟨hbAI, hbC⟩
  have hb : b ∈ ((A ⊔ I : Subgroup X) : Set X) := hbAI
  rw [h.coe_sup_A_I] at hb
  obtain ⟨a, ha, i, hi, rfl⟩ := hb
  refine mem_centralizer_of_inner_of_mem_centralizer h.isQuasisimple h.le_normalizer_L hLI
    (Subgroup.mul_mem _ (h.le_normalizer_A ha) (h.le_normalizer_L hi)) ?_ hbC
  obtain ⟨l, hl, hal⟩ := h.shape_L.2.2 a ha
  obtain ⟨m, hm, him⟩ := inner_of_mem_sup_centralizer (h.le_sup_centralizer hi)
  refine ⟨l * m, L.mul_mem hl hm, fun y hy => ?_⟩
  have hiy : i * y * i⁻¹ ∈ L := (Subgroup.mem_normalizer_iff.mp (h.le_normalizer_L hi) y).mp hy
  calc a * i * y * (a * i)⁻¹ = a * (i * y * i⁻¹) * a⁻¹ := by group
    _ = l * (i * y * i⁻¹) * l⁻¹ := hal _ hiy
    _ = l * (m * y * m⁻¹) * l⁻¹ := by rw [him y hy]
    _ = l * m * y * (l * m)⁻¹ := by group

omit [Finite X] in
theorem le_normalizer_B : A ≤ Subgroup.normalizer
    (((A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) : Subgroup X) : Set X) := fun _ ha =>
  Subgroup.inf_normalizer_le_normalizer_inf
    ⟨Subgroup.le_normalizer (Subgroup.mem_sup_left ha), h.le_normalizer_centralizer_I ha⟩

omit [Finite X] in
theorem commutator_mem_I_of_mem_sup {g g' : X} (hg : g ∈ A ⊔ I) (hg' : g' ∈ A ⊔ I) :
    g * g' * g⁻¹ * g'⁻¹ ∈ I := by
  have hg1 : g ∈ ((A ⊔ I : Subgroup X) : Set X) := hg
  have hg2 : g' ∈ ((A ⊔ I : Subgroup X) : Set X) := hg'
  rw [h.coe_sup_A_I] at hg1 hg2
  obtain ⟨a, ha, i, hi, rfl⟩ := hg1
  obtain ⟨a', ha', i', hi', rfl⟩ := hg2
  have hcomm : a * a'⁻¹ * a⁻¹ = a'⁻¹ := by
    have h1 : a * a' = a' * a :=
      congrArg Subtype.val (h.isE27.1.1.is_comm.comm (⟨a, ha⟩ : A) ⟨a', ha'⟩)
    calc a * a'⁻¹ * a⁻¹ = a'⁻¹ * (a' * a) * a'⁻¹ * a⁻¹ := by group
      _ = a'⁻¹ * (a * a') * a'⁻¹ * a⁻¹ := by rw [h1]
      _ = a'⁻¹ := by group
  have hk : (a'⁻¹ * i * a') * i' * i⁻¹ * (a⁻¹ * i' * a)⁻¹ ∈ I := by
    have h1 : a'⁻¹ * i * a' ∈ I :=
      (Subgroup.mem_normalizer_iff''.mp (h.le_normalizer_I ha') i).mp hi
    have h2 : a⁻¹ * i' * a ∈ I :=
      (Subgroup.mem_normalizer_iff''.mp (h.le_normalizer_I ha) i').mp hi'
    exact I.mul_mem (I.mul_mem (I.mul_mem h1 hi') (I.inv_mem hi)) (I.inv_mem h2)
  have hconj := (Subgroup.mem_normalizer_iff.mp
    (Subgroup.mul_mem _ (h.le_normalizer_I ha) (h.le_normalizer_I ha')) _).mp hk
  have heq : a * i * (a' * i') * (a * i)⁻¹ * (a' * i')⁻¹ =
      a * a' * ((a'⁻¹ * i * a') * i' * i⁻¹ * (a⁻¹ * i' * a)⁻¹) * (a * a')⁻¹ := by
    calc a * i * (a' * i') * (a * i)⁻¹ * (a' * i')⁻¹
        = a * i * a' * i' * i⁻¹ * a⁻¹ * i'⁻¹ * (a * a'⁻¹ * a⁻¹) := by rw [hcomm]; group
      _ = a * a' * ((a'⁻¹ * i * a') * i' * i⁻¹ * (a⁻¹ * i' * a)⁻¹) * (a * a')⁻¹ := by group
  rw [heq]
  exact hconj

theorem A_inf_I : A ⊓ I = I ⊓ Subgroup.centralizer (I : Set X) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set B := (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) with hBdef
  set Z := I ⊓ Subgroup.centralizer (I : Set X) with hZdef
  have hBI : B ≤ Subgroup.normalizer (I : Set X) :=
    inf_le_right.trans (Subgroup.centralizer_le_normalizer _)
  have hABI : A ⊔ B ≤ Subgroup.normalizer (I : Set X) := sup_le h.le_normalizer_I hBI
  have hAB : A ⊓ B = Z := by
    rw [hBdef, ← inf_assoc, inf_eq_left.mpr (le_sup_left : A ≤ A ⊔ I), hZdef]
    exact h.inf_centralizer_I_eq
  have hBsup : B ⊔ I = A ⊔ I := by
    refine le_antisymm (sup_le inf_le_left le_sup_right) (sup_le (fun a ha => ?_) le_sup_right)
    obtain ⟨b, hb, i, hi, rfl⟩ := h.exists_mul_eq a ha
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hb) (Subgroup.mem_sup_right hi)
  have hABsup : A ⊔ B ⊔ I = A ⊔ I :=
    le_antisymm (sup_le (sup_le le_sup_left inf_le_left) le_sup_right)
      (sup_le (le_sup_left.trans le_sup_left) le_sup_right)
  have h1 := card_sup_mul_card_inf h.le_normalizer_B
  have h2 := card_sup_mul_card_inf hABI
  have h3 := card_sup_mul_card_inf hBI
  rw [hAB, h.card_center_I, h.isE27.2] at h1
  rw [hABsup] at h2
  rw [hBsup, B_inf_I, h.card_center_I] at h3
  set P := (A ⊔ B) ⊓ I with hPdef
  have hIpos : 0 < Nat.card I := Nat.card_pos
  have hPcard : Nat.card P = 27 := by
    have hAIpos : 0 < Nat.card (A ⊔ I : Subgroup X) := Nat.card_pos
    have h4 : Nat.card (A ⊔ I : Subgroup X) * (Nat.card P * 3) =
        Nat.card (A ⊔ I : Subgroup X) * 81 := by
      calc Nat.card (A ⊔ I : Subgroup X) * (Nat.card P * 3)
          = (Nat.card (A ⊔ B : Subgroup X) * 3) * Nat.card I := by rw [← mul_assoc, h2]; ring
        _ = 27 * (Nat.card B * Nat.card I) := by rw [h1]; ring
        _ = Nat.card (A ⊔ I : Subgroup X) * 81 := by rw [← h3]; ring
    have h5 := Nat.eq_of_mul_eq_mul_left hAIpos h4
    omega
  have hPI : P ≤ I := inf_le_right
  have hP3 : IsPGroup 3 P := IsPGroup.of_card (n := 3) (by rw [hPcard]; norm_num)
  have hPnab : ¬ ∀ x ∈ P, ∀ y ∈ P, x * y = y * x := by
    intro hcomm
    have hE : CFSG.Assembly.IsElemAbelian 3 P :=
      ⟨⟨⟨fun x y => Subtype.ext (hcomm x x.2 y y.2)⟩⟩,
        fun x hx => h.pow_three_of_le_I hPI hP3 hx⟩
    have := h.card_le_nine_of_le_I hPI hE
    omega
  have hcent : ∀ x ∈ A ⊓ I, ∀ y ∈ P, x * y = y * x := by
    intro x hx y hy
    have hy' : y ∈ ((A ⊔ B : Subgroup X) : Set X) := hy.1
    rw [Subgroup.coe_mul_of_left_le_normalizer_right A B h.le_normalizer_B] at hy'
    obtain ⟨a, ha, b, hb, rfl⟩ := hy'
    have h1 : x * a = a * x :=
      congrArg Subtype.val (h.isE27.1.1.is_comm.comm (⟨x, hx.1⟩ : A) ⟨a, ha⟩)
    have h2 : x * b = b * x := Subgroup.mem_centralizer_iff.mp hb.2 x hx.2
    calc x * (a * b) = a * (x * b) := by rw [← mul_assoc, h1, mul_assoc]
      _ = a * b * x := by rw [h2, mul_assoc]
  have hZle : Z ≤ A ⊓ I := le_inf h.center_le_A inf_le_left
  refine le_antisymm ?_ (hZle.trans le_rfl)
  intro x hx
  by_contra hxZ
  apply hPnab
  have hAI9 : Nat.card (A ⊓ I : Subgroup X) = 9 := by
    have hle := h.card_le_nine_of_le_I (inf_le_right : A ⊓ I ≤ I)
      ⟨⟨⟨fun a b => Subtype.ext (congrArg Subtype.val
        (h.isE27.1.1.is_comm.comm (⟨a, a.2.1⟩ : A) ⟨b, b.2.1⟩) : (a : X) * b = b * a)⟩⟩,
        fun a ha => h.isE27.1.2 a ha.1⟩
    have hlt : Nat.card Z < Nat.card (A ⊓ I : Subgroup X) :=
      Subgroup.card_lt_of_lt (lt_of_le_of_ne hZle fun heq => hxZ (heq ▸ hx))
    rw [h.card_center_I] at hlt
    have hdvd : Nat.card (A ⊓ I : Subgroup X) ∣ 27 := by
      rw [← h.isE27.2]
      exact Subgroup.card_dvd_of_le inf_le_left
    have : Nat.card (A ⊓ I : Subgroup X) ∈ Nat.divisors 27 := by
      rw [Nat.mem_divisors]; exact ⟨hdvd, by norm_num⟩
    have hd : Nat.divisors 27 = {1, 3, 9, 27} := by decide
    rw [hd] at this
    simp only [Finset.mem_insert, Finset.mem_singleton] at this
    omega
  have hAIP : A ⊓ I ≤ P := le_inf (inf_le_left.trans le_sup_left) inf_le_right
  set E : Subgroup P := (A ⊓ I).subgroupOf P with hEdef
  have hEcen : E ≤ Subgroup.center P := by
    intro y hy
    rw [Subgroup.mem_center_iff]
    intro w
    exact Subtype.ext (hcent _ (Subgroup.mem_subgroupOf.mp hy) w w.2).symm
  have hEcard : Nat.card E = 9 := by
    rw [hEdef, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAIP).toEquiv, hAI9]
  have hcyc : IsCyclic (P ⧸ Subgroup.center P) := by
    have hc9 : 9 ≤ Nat.card (Subgroup.center P) :=
      hEcard ▸ Subgroup.card_le_of_le hEcen
    have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup (Subgroup.center P)
    rw [hPcard] at hmul
    have hq : Nat.card (P ⧸ Subgroup.center P) ∣ 3 := by
      have hdvd : Nat.card (P ⧸ Subgroup.center P) ∣ 27 := ⟨_, hmul⟩
      have hpos : 0 < Nat.card (P ⧸ Subgroup.center P) := Nat.card_pos
      have hle : Nat.card (P ⧸ Subgroup.center P) ≤ 3 := by nlinarith
      have : Nat.card (P ⧸ Subgroup.center P) ∈ Nat.divisors 27 := by
        rw [Nat.mem_divisors]; exact ⟨hdvd, by norm_num⟩
      have hd : Nat.divisors 27 = {1, 3, 9, 27} := by decide
      rw [hd] at this
      simp only [Finset.mem_insert, Finset.mem_singleton] at this
      rcases this with h0 | h0 | h0 | h0 <;> simp [h0] at hle ⊢
    rcases (Nat.dvd_prime Nat.prime_three).mp hq with h0 | h0
    · have : Subsingleton (P ⧸ Subgroup.center P) := (Nat.card_eq_one_iff_unique.mp h0).1
      exact isCyclic_of_subsingleton
    · exact isCyclic_of_prime_card h0
  have hcomm := (isMulCommutative_of_isCyclic_quotient_center_self (G := P)).is_comm.comm
  intro x hx y hy
  exact congrArg Subtype.val (hcomm ⟨x, hx⟩ ⟨y, hy⟩)

theorem card_B : Nat.card ((A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) : Subgroup X) = 27 := by
  set B := (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) with hBdef
  have hBI : B ≤ Subgroup.normalizer (I : Set X) :=
    inf_le_right.trans (Subgroup.centralizer_le_normalizer _)
  have hBsup : B ⊔ I = A ⊔ I := by
    refine le_antisymm (sup_le inf_le_left le_sup_right) (sup_le (fun a ha => ?_) le_sup_right)
    obtain ⟨b, hb, i, hi, rfl⟩ := h.exists_mul_eq a ha
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hb) (Subgroup.mem_sup_right hi)
  have h1 := card_sup_mul_card_inf h.le_normalizer_I
  have h3 := card_sup_mul_card_inf hBI
  rw [h.A_inf_I, h.card_center_I, h.isE27.2] at h1
  rw [hBsup, B_inf_I, h.card_center_I] at h3
  have hIpos : 0 < Nat.card I := Nat.card_pos
  have h4 : Nat.card B * Nat.card I = 27 * Nat.card I := by rw [← h3, h1]
  exact Nat.eq_of_mul_eq_mul_right hIpos h4

omit [Finite X] in
theorem pow_three_of_mem_B {b : X}
    (hb : b ∈ (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X)) : b ^ 3 = 1 := by
  obtain ⟨hbAI, hbC⟩ := hb
  have hb' : b ∈ ((A ⊔ I : Subgroup X) : Set X) := hbAI
  rw [h.coe_sup_A_I] at hb'
  obtain ⟨a, ha, i, hi, hai⟩ := hb'
  have hai' : a * i = b := hai
  subst hai'
  have hact : ∀ x ∈ I, i * x * i⁻¹ = a⁻¹ * x * a := by
    intro x hx
    have h1 : x * (a * i) = a * i * x := Subgroup.mem_centralizer_iff.mp hbC x hx
    calc i * x * i⁻¹ = a⁻¹ * ((a * i) * x) * i⁻¹ := by group
      _ = a⁻¹ * (x * (a * i)) * i⁻¹ := by rw [h1]
      _ = a⁻¹ * x * a := by group
  have ha3 : a ^ 3 = 1 := h.isE27.1.2 a ha
  have hi3c : i ^ 3 ∈ I ⊓ Subgroup.centralizer (I : Set X) := by
    refine ⟨I.pow_mem hi 3, Subgroup.mem_centralizer_iff.mpr fun x hx => ?_⟩
    have hx1 : i * x * i⁻¹ ∈ I := I.mul_mem (I.mul_mem hi hx) (I.inv_mem hi)
    have hx2 : i * (i * x * i⁻¹) * i⁻¹ ∈ I := I.mul_mem (I.mul_mem hi hx1) (I.inv_mem hi)
    have hconj : i ^ 3 * x * (i ^ 3)⁻¹ = x := by
      calc i ^ 3 * x * (i ^ 3)⁻¹ = i * (i * (i * x * i⁻¹) * i⁻¹) * i⁻¹ := by
            rw [pow_three]; group
        _ = a⁻¹ * (a⁻¹ * (a⁻¹ * x * a) * a) * a := by
            rw [hact _ hx2, hact _ hx1, hact x hx]
        _ = (a ^ 3)⁻¹ * x * a ^ 3 := by rw [pow_three]; group
        _ = x := by rw [ha3]; group
    calc x * i ^ 3 = (i ^ 3 * x * (i ^ 3)⁻¹) * i ^ 3 := by rw [hconj]
      _ = i ^ 3 * x := by rw [inv_mul_cancel_right]
  have hi9 : i ^ (3 ^ 2) = 1 := by
    have hord := orderOf_dvd_natCard (⟨i ^ 3, hi3c⟩ :
      (I ⊓ Subgroup.centralizer (I : Set X) : Subgroup X))
    rw [h.card_center_I, Subgroup.orderOf_mk] at hord
    have := orderOf_dvd_iff_pow_eq_one.mp hord
    rw [← pow_mul] at this
    exact this
  have hi3 : i ^ 3 = 1 := by
    have hzp : Subgroup.zpowers i ≤ I := Subgroup.zpowers_le.mpr hi
    exact h.pow_three_of_le_I hzp (isPGroup_zpowers_of_pow_eq_one hi9) (Subgroup.mem_zpowers i)
  have hcomm : Commute a i := by
    have h1 := Subgroup.mem_centralizer_iff.mp hbC i hi
    have h2 : i * a = a * i := by
      have := congrArg (· * i⁻¹) h1
      simpa [mul_assoc] using this
    exact h2.symm
  rw [hcomm.mul_pow, ha3, hi3, one_mul]

omit [Finite X] in
theorem commutator_mem_center_of_mem_B {b b' : X}
    (hb : b ∈ (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X))
    (hb' : b' ∈ (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X)) :
    b * b' * b⁻¹ * b'⁻¹ ∈ I ⊓ Subgroup.centralizer (I : Set X) := by
  rw [← B_inf_I (A := A)]
  refine ⟨?_, h.commutator_mem_I_of_mem_sup hb.1 hb'.1⟩
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hb hb') (Subgroup.inv_mem _ hb))
    (Subgroup.inv_mem _ hb')

omit [Finite X] in
theorem le_normalizer_centralizer_L :
    A ≤ Subgroup.normalizer ((Subgroup.centralizer (L : Set X) : Subgroup X) : Set X) :=
  fun a ha => Subgroup.mem_normalizer_iff.mpr fun c =>
    ⟨fun hc => conj_mem_centralizer (h.le_normalizer_A ha) hc, fun hc => by
      have := conj_mem_centralizer (Subgroup.inv_mem _ (h.le_normalizer_A ha)) hc
      simpa [mul_assoc] using this⟩

theorem exists_mem_PL (a : X) (ha : a ∈ A) :
    ∃ l ∈ L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A),
      a * l⁻¹ ∈ Subgroup.centralizer (L : Set X) ∧ ∀ y ∈ L, a * y * a⁻¹ = l * y * l⁻¹ := by
  obtain ⟨l, hl, hal⟩ := h.shape_L.2.2 a ha
  have hc : a * l⁻¹ ∈ Subgroup.centralizer (L : Set X) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have hy' : l⁻¹ * y * l ∈ L := L.mul_mem (L.mul_mem (L.inv_mem hl) hy) hl
    have h1 := hal _ hy'
    have h2 : a * (l⁻¹ * y * l) * a⁻¹ = y := by rw [h1]; group
    calc y * (a * l⁻¹) = a * (l⁻¹ * y * l) * a⁻¹ * (a * l⁻¹) := by rw [h2]
      _ = a * l⁻¹ * y := by group
  refine ⟨l, ⟨hl, ?_⟩, hc, hal⟩
  have hl' : l = (a * l⁻¹)⁻¹ * a := by group
  rw [hl']
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left (Subgroup.inv_mem _ hc))
    (Subgroup.mem_sup_right ha)

theorem card_PL : Nat.card (L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A) : Subgroup X) =
    9 * Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) := by
  set C := Subgroup.centralizer (L : Set X) with hC
  set P := L ⊓ (C ⊔ A) with hP
  have hPC : P ≤ Subgroup.normalizer (C : Set X) := inf_le_left.trans (le_normalizer_centralizer L)
  have hsup : P ⊔ C = A ⊔ C := by
    apply le_antisymm
    · exact sup_le (inf_le_right.trans (sup_comm C A).le) le_sup_right
    · refine sup_le (fun a ha => ?_) le_sup_right
      obtain ⟨l, hl, hc, -⟩ := h.exists_mem_PL a ha
      have ha' : a = (a * l⁻¹) * l := by group
      rw [ha']
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hc) (Subgroup.mem_sup_left hl)
  have hinf : P ⊓ C = L ⊓ C := by
    apply le_antisymm
    · exact inf_le_inf_right C inf_le_left
    · exact le_inf (le_inf inf_le_left (inf_le_right.trans le_sup_left)) inf_le_right
  have h1 := card_sup_mul_card_inf h.le_normalizer_centralizer_L
  have h2 := card_sup_mul_card_inf hPC
  rw [h.inf_centralizer_L_eq, h.card_center_I, h.isE27.2] at h1
  rw [hsup, hinf] at h2
  have hCpos : 0 < Nat.card C := Nat.card_pos
  have h3 : Nat.card P * Nat.card C * 3 =
      (9 * Nat.card (L ⊓ C : Subgroup X)) * Nat.card C * 3 := by
    calc Nat.card P * Nat.card C * 3
        = Nat.card (A ⊔ C : Subgroup X) * 3 * Nat.card (L ⊓ C : Subgroup X) := by
          rw [← h2]; ring
      _ = (9 * Nat.card (L ⊓ C : Subgroup X)) * Nat.card C * 3 := by rw [h1]; ring
  have h4 := Nat.eq_of_mul_eq_mul_right (by norm_num : 0 < 3) h3
  exact Nat.eq_of_mul_eq_mul_right hCpos h4

omit [Finite X] in
theorem exists_act_of_mem_sup {p : X} (hp : p ∈ Subgroup.centralizer (L : Set X) ⊔ A) :
    ∃ a ∈ A, (∀ y ∈ L, p * y * p⁻¹ = a * y * a⁻¹) ∧ ∀ y ∈ L, p⁻¹ * y * p = a⁻¹ * y * a := by
  rw [sup_comm] at hp
  have hp' : p ∈ ((A ⊔ Subgroup.centralizer (L : Set X) : Subgroup X) : Set X) := hp
  rw [Subgroup.coe_mul_of_left_le_normalizer_right A _ h.le_normalizer_centralizer_L] at hp'
  obtain ⟨a, ha, c, hc, hac⟩ := hp'
  have hac' : a * c = p := hac
  subst hac'
  refine ⟨a, ha, fun y hy => ?_, fun y hy => ?_⟩
  · have hcy : c * y = y * c := (Subgroup.mem_centralizer_iff.mp hc y hy).symm
    calc a * c * y * (a * c)⁻¹ = a * (c * y) * c⁻¹ * a⁻¹ := by group
      _ = a * y * a⁻¹ := by rw [hcy]; group
  · have hy' : a⁻¹ * y * a ∈ L :=
      (Subgroup.mem_normalizer_iff''.mp (h.le_normalizer_A ha) y).mp hy
    have hcy : c * (a⁻¹ * y * a) = (a⁻¹ * y * a) * c :=
      (Subgroup.mem_centralizer_iff.mp hc _ hy').symm
    calc (a * c)⁻¹ * y * (a * c) = c⁻¹ * ((a⁻¹ * y * a) * c) := by group
      _ = c⁻¹ * (c * (a⁻¹ * y * a)) := by rw [hcy]
      _ = a⁻¹ * y * a := by group

omit [Finite X] in
theorem commutator_mem_of_mem_PL {p q : X}
    (hp : p ∈ L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A))
    (hq : q ∈ L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A)) :
    p * q * p⁻¹ * q⁻¹ ∈ L ⊓ Subgroup.centralizer (L : Set X) := by
  obtain ⟨a, ha, hpa, hpa'⟩ := h.exists_act_of_mem_sup hp.2
  obtain ⟨a', ha', hqa, hqa'⟩ := h.exists_act_of_mem_sup hq.2
  refine ⟨L.mul_mem (L.mul_mem (L.mul_mem hp.1 hq.1) (L.inv_mem hp.1)) (L.inv_mem hq.1), ?_⟩
  show p * q * p⁻¹ * q⁻¹ ∈ Subgroup.centralizer (L : Set X)
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hcomm : a * a' = a' * a :=
    congrArg Subtype.val (h.isE27.1.1.is_comm.comm (⟨a, ha⟩ : A) ⟨a', ha'⟩)
  have hNa : ∀ z ∈ L, a * z * a⁻¹ ∈ L := fun z hz =>
    (Subgroup.mem_normalizer_iff.mp (h.le_normalizer_A ha) z).mp hz
  have hNa' : ∀ z ∈ L, a'⁻¹ * z * a' ∈ L := fun z hz =>
    (Subgroup.mem_normalizer_iff''.mp (h.le_normalizer_A ha') z).mp hz
  have hNai : ∀ z ∈ L, a⁻¹ * z * a ∈ L := fun z hz =>
    (Subgroup.mem_normalizer_iff''.mp (h.le_normalizer_A ha) z).mp hz
  have hNa'' : ∀ z ∈ L, a' * z * a'⁻¹ ∈ L := fun z hz =>
    (Subgroup.mem_normalizer_iff.mp (h.le_normalizer_A ha') z).mp hz
  set y₁ := a'⁻¹ * y * a' with hy₁
  set y₂ := a⁻¹ * y₁ * a with hy₂
  set y₃ := a' * y₂ * a'⁻¹ with hy₃
  have h1 : y₁ ∈ L := hNa' y hy
  have h2 : y₂ ∈ L := hNai _ h1
  have h3 : y₃ ∈ L := hNa'' _ h2
  have hconj : p * q * p⁻¹ * q⁻¹ * y * (p * q * p⁻¹ * q⁻¹)⁻¹ = y := by
    calc p * q * p⁻¹ * q⁻¹ * y * (p * q * p⁻¹ * q⁻¹)⁻¹
        = p * (q * (p⁻¹ * (q⁻¹ * y * q) * p) * q⁻¹) * p⁻¹ := by group
      _ = a * y₃ * a⁻¹ := by rw [hqa' y hy, hpa' _ h1, hqa _ h2, hpa _ h3]
      _ = (a * a') * (a⁻¹ * a'⁻¹) * y * ((a * a') * (a⁻¹ * a'⁻¹))⁻¹ := by
          rw [hy₃, hy₂, hy₁]; group
      _ = y := by
          rw [show (a * a') * (a⁻¹ * a'⁻¹) = 1 by rw [hcomm]; group]
          group
  calc y * (p * q * p⁻¹ * q⁻¹) =
      (p * q * p⁻¹ * q⁻¹ * y * (p * q * p⁻¹ * q⁻¹)⁻¹) * (p * q * p⁻¹ * q⁻¹) := by rw [hconj]
    _ = p * q * p⁻¹ * q⁻¹ * y := by group

theorem pow_three_of_mem_PL {p : X} (hp : p ∈ L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A)) :
    p ^ 3 = 1 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hP3 : IsPGroup 3 (L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A) : Subgroup X) := by
    rw [IsPGroup.iff_card, h.card_PL]
    rcases (Nat.dvd_prime Nat.prime_three).mp h.card_L.2 with h0 | h0
    · exact ⟨2, by rw [h0]; norm_num⟩
    · exact ⟨3, by rw [h0]; norm_num⟩
  obtain ⟨n, hn⟩ := hP3 ⟨p, hp⟩
  have hn' : (⟨p, hp.1⟩ : L) ^ (3 ^ n) = 1 :=
    Subtype.ext (by simpa using congrArg Subtype.val hn)
  have hz := isPGroup_zpowers_of_pow_eq_one hn'
  have h3 : (⟨p, hp.1⟩ : L) ^ 3 = 1 := by
    rcases h.shape_L.1 with ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩
    · exact pow_three_eq_one_of_mulEquiv e (fun y hy => pow_three_eq_one_of_projSL hy) hz
    · exact pow_three_eq_one_of_mulEquiv e (fun y hy => pow_three_eq_one_of_SL hy) hz
  simpa using congrArg Subtype.val h3

theorem le_D : A ≤ (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) ⊔
    L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A) := by
  set B := (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) with hBdef
  set P := L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A) with hPdef
  set Z := I ⊓ Subgroup.centralizer (I : Set X) with hZdef
  set D := B ⊔ P with hDdef
  have hBL : B ≤ Subgroup.centralizer (L : Set X) := h.B_le_centralizer_L h.le_sup_centralizer_L
  have hcommBP : ∀ b ∈ B, ∀ p ∈ P, b * p = p * b := fun b hb p hp =>
    (Subgroup.mem_centralizer_iff.mp (hBL hb) p hp.1).symm
  have hBP : B ≤ Subgroup.normalizer (P : Set X) := fun b hb =>
    Subgroup.centralizer_le_normalizer _ (Subgroup.mem_centralizer_iff.mpr fun p hp =>
      (hcommBP b hb p hp).symm)
  have hDset : (D : Set X) = (B : Set X) * (P : Set X) :=
    Subgroup.coe_mul_of_left_le_normalizer_right B P hBP
  have hdec : ∀ x ∈ D, ∃ b ∈ B, ∃ p ∈ P, x = b * p := by
    intro x hx
    have hx' : x ∈ (D : Set X) := hx
    rw [hDset] at hx'
    obtain ⟨b, hb, p, hp, hbp⟩ := hx'
    exact ⟨b, hb, p, hp, hbp.symm⟩
  have hcard : 243 ≤ Nat.card D := by
    have h1 := card_sup_mul_card_inf hBP
    rw [h.card_B, h.card_PL] at h1
    have hle : B ⊓ P ≤ L ⊓ Subgroup.centralizer (L : Set X) :=
      fun x hx => ⟨hx.2.1, hBL hx.1⟩
    have h2 := Subgroup.card_le_of_le hle
    have hZpos : 0 < Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) := Nat.card_pos
    by_contra hlt
    push Not at hlt
    have h3 : Nat.card D * Nat.card (B ⊓ P : Subgroup X) <
        243 * Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) :=
      calc Nat.card D * Nat.card (B ⊓ P : Subgroup X)
          ≤ Nat.card D * Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) :=
            Nat.mul_le_mul_left _ h2
        _ < 243 * Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) :=
            Nat.mul_lt_mul_of_pos_right hlt hZpos
    rw [h1] at h3
    omega
  have hZD : Z ≤ Subgroup.centralizer (D : Set X) := by
    rw [Subgroup.le_centralizer_iff]
    refine sup_le ?_ ?_
    · intro b hb
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      exact Subgroup.mem_centralizer_iff.mp hb.2 z hz.1
    · intro p hp
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      exact (Subgroup.mem_centralizer_iff.mp
        (h.center_I_le_centralizer_L h.le_sup_centralizer_L hz) p hp.1).symm
  set φ : B × P →* X := B.subtype.noncommCoprod P.subtype (fun b p => hcommBP b b.2 p p.2)
    with hφ
  have hφapp : ∀ u : B × P, φ u = (u.1 : X) * u.2 := fun u => rfl
  have hφmem : ∀ x ∈ D, ∃ u : B × P, φ u = x := by
    intro x hx
    obtain ⟨b, hb, p, hp, rfl⟩ := hdec x hx
    exact ⟨(⟨b, hb⟩, ⟨p, hp⟩), rfl⟩
  have hDD : ∀ x ∈ D, ∀ y ∈ D, x * y * x⁻¹ * y⁻¹ ∈ Z := by
    intro x hx y hy
    obtain ⟨u, rfl⟩ := hφmem x hx
    obtain ⟨v, rfl⟩ := hφmem y hy
    rw [← map_inv, ← map_inv, ← map_mul, ← map_mul, ← map_mul, hφapp]
    simp only [Prod.fst_mul, Prod.snd_mul, Prod.fst_inv, Prod.snd_inv, Subgroup.coe_mul,
      Subgroup.coe_inv]
    exact Z.mul_mem (h.commutator_mem_center_of_mem_B u.1.2 v.1.2)
      (h.center_L_le (h.commutator_mem_of_mem_PL u.2.2 v.2.2))
  have hD3 : ∀ x ∈ D, x ^ 3 = 1 := by
    intro x hx
    obtain ⟨u, rfl⟩ := hφmem x hx
    rw [← map_pow, hφapp]
    simp only [Prod.pow_fst, Prod.pow_snd, Subgroup.coe_pow]
    rw [h.pow_three_of_mem_B u.1.2, h.pow_three_of_mem_PL u.2.2, one_mul]
  have hinnerD : ∀ a ∈ A, ∃ d ∈ D, ∀ y ∈ D, a * y * a⁻¹ = d * y * d⁻¹ := by
    intro a ha
    obtain ⟨b, hb, i, hi, rfl⟩ := h.exists_mul_eq a ha
    obtain ⟨l, hl, -, hal⟩ := h.exists_mem_PL (b * i) ha
    refine ⟨b * l, Subgroup.mul_mem _ (Subgroup.mem_sup_left hb) (Subgroup.mem_sup_right hl),
      fun y hy => ?_⟩
    suffices hsuf : D ≤ Subgroup.centralizer ({(b * l)⁻¹ * (b * i)} : Set X) by
      have h1 := Subgroup.mem_centralizer_singleton_iff.mp (hsuf hy)
      calc b * i * y * (b * i)⁻¹ = (b * l) * (((b * l)⁻¹ * (b * i)) * y) * (b * i)⁻¹ := by
            group
        _ = (b * l) * (y * ((b * l)⁻¹ * (b * i))) * (b * i)⁻¹ := by rw [h1]
        _ = b * l * y * (b * l)⁻¹ := by group
    refine sup_le (fun y hy => ?_) (fun y hy => ?_)
    ·
      rw [Subgroup.mem_centralizer_singleton_iff]
      have hiy : i * y = y * i := Subgroup.mem_centralizer_iff.mp hy.2 i hi
      have hly : l * y = y * l := Subgroup.mem_centralizer_iff.mp (hBL hy) l hl.1
      calc y * ((b * l)⁻¹ * (b * i)) = (y * l⁻¹) * i := by group
        _ = (l⁻¹ * y) * i := by
            rw [show y * l⁻¹ = l⁻¹ * y by
              calc y * l⁻¹ = l⁻¹ * (l * y) * l⁻¹ := by group
                _ = l⁻¹ * (y * l) * l⁻¹ := by rw [hly]
                _ = l⁻¹ * y := by group]
        _ = l⁻¹ * (y * i) := by group
        _ = l⁻¹ * (i * y) := by rw [hiy]
        _ = (b * l)⁻¹ * (b * i) * y := by group
    ·
      rw [Subgroup.mem_centralizer_singleton_iff]
      have h1 := hal y hy.1
      have hly : l * y * l⁻¹ ∈ L := L.mul_mem (L.mul_mem hl.1 hy.1) (L.inv_mem hl.1)
      have hbly : b * (l * y * l⁻¹) = (l * y * l⁻¹) * b :=
        (Subgroup.mem_centralizer_iff.mp (hBL hb) _ hly).symm
      have h2 : (b * l) * y * (b * l)⁻¹ = b * i * y * (b * i)⁻¹ := by
        calc (b * l) * y * (b * l)⁻¹ = b * (l * y * l⁻¹) * b⁻¹ := by group
          _ = (l * y * l⁻¹) * b * b⁻¹ := by rw [hbly]
          _ = b * i * y * (b * i)⁻¹ := by rw [h1]; group
      calc y * ((b * l)⁻¹ * (b * i)) = (b * l)⁻¹ * ((b * l) * y * (b * l)⁻¹) * (b * i) := by
            group
        _ = (b * l)⁻¹ * (b * i * y * (b * i)⁻¹) * (b * i) := by rw [h2]
        _ = (b * l)⁻¹ * (b * i) * y := by group
  obtain ⟨a₁, ha₁, a₂, ha₂, hgen⟩ :=
    exists_two_generators h.center_le_A h.card_center_I h.isE27.2
  obtain ⟨d₁, hd₁, hd₁a⟩ := hinnerD a₁ ha₁
  obtain ⟨d₂, hd₂, hd₂a⟩ := hinnerD a₂ ha₂
  set S := D ⊓ Subgroup.centralizer ({d₁} : Set X) ⊓ Subgroup.centralizer ({d₂} : Set X)
    with hSdef
  have hSA : S ≤ A := by
    rintro y ⟨⟨hyD, hy1⟩, hy2⟩
    refine h.mem_of_mem_centralizer y ?_ (hD3 y hyD)
    have hcy : A ≤ Subgroup.centralizer ({y} : Set X) := by
      refine hgen.trans (sup_le (sup_le ?_ ?_) ?_)
      · intro z hz
        rw [Subgroup.mem_centralizer_singleton_iff]
        exact (Subgroup.mem_centralizer_iff.mp (hZD hz) y hyD).symm
      · rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
        have h1 := hd₁a y hyD
        rw [← Subgroup.mem_centralizer_singleton_iff.mp hy1, mul_inv_cancel_right] at h1
        calc a₁ * y = (a₁ * y * a₁⁻¹) * a₁ := by group
          _ = y * a₁ := by rw [h1]
      · rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
        have h1 := hd₂a y hyD
        rw [← Subgroup.mem_centralizer_singleton_iff.mp hy2, mul_inv_cancel_right] at h1
        calc a₂ * y = (a₂ * y * a₂⁻¹) * a₂ := by group
          _ = y * a₂ := by rw [h1]
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact Subgroup.mem_centralizer_singleton_iff.mp (hcy ha)
  have hcount := card_le_nine_mul_card_inf h.card_center_I.le hZD hDD hd₁ hd₂
  rw [← hSdef] at hcount
  have hS27 : 27 ≤ Nat.card S := by omega
  have hSeq : S = A := Subgroup.eq_of_le_of_card_ge hSA (by rw [h.isE27.2]; exact hS27)
  rw [← hSeq]
  exact inf_le_left.trans inf_le_left

theorem le : I ≤ L := by
  by_contra hIL
  have hAD := h.le_D
  set B := (A ⊔ I) ⊓ Subgroup.centralizer (I : Set X) with hBdef
  set P := L ⊓ (Subgroup.centralizer (L : Set X) ⊔ A) with hPdef
  have hBL : B ≤ Subgroup.centralizer (L : Set X) := h.B_le_centralizer_L h.le_sup_centralizer_L
  have hBP : B ≤ Subgroup.normalizer (P : Set X) := fun b hb =>
    Subgroup.centralizer_le_normalizer _ (Subgroup.mem_centralizer_iff.mpr fun p hp =>
      Subgroup.mem_centralizer_iff.mp (hBL hb) p hp.1)
  have hIZ : I ⊓ L ≤ I ⊓ Subgroup.centralizer (I : Set X) := by
    rcases h.eq_or_le_center (K := I ⊓ L) inf_le_left
        (fun i hi => Subgroup.inf_normalizer_le_normalizer_inf ⟨Subgroup.le_normalizer hi,
          h.le_normalizer_L hi⟩) with heq | hle
    · exact absurd (heq ▸ inf_le_right : I ≤ L) hIL
    · exact hle
  have hcomm : ∀ a ∈ A, ∀ x ∈ I, a * x * a⁻¹ * x⁻¹ ∈ I ⊓ Subgroup.centralizer (I : Set X) := by
    intro a ha x hx
    have ha' : a ∈ ((B ⊔ P : Subgroup X) : Set X) := hAD ha
    rw [Subgroup.coe_mul_of_left_le_normalizer_right B P hBP] at ha'
    obtain ⟨b, hb, p, hp, hbp⟩ := ha'
    have hbp' : b * p = a := hbp
    subst hbp'
    have hpN : p ∈ Subgroup.normalizer (I : Set X) := by
      have h1 : b⁻¹ * (b * p) = p := by group
      rw [← h1]
      exact Subgroup.mul_mem _ (Subgroup.centralizer_le_normalizer _ (Subgroup.inv_mem _ hb.2))
        (h.le_normalizer_I ha)
