  exact LocalCores.isQuasisimple_of_mulEquiv e.symm isQuasisimple_SL

omit [Finite X] in
theorem isPerfect_I : Group.IsPerfect I := h.isQuasisimple_I.1

omit [Finite X] in
theorem card_center_I : Nat.card (I ⊓ Subgroup.centralizer (I : Set X) : Subgroup X) = 3 := by
  obtain ⟨e⟩ := h.equivSL
