structure CoreHyp (A I L : Subgroup X) : Prop where
  equivSL : Nonempty (I ≃* Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 2))
  isQuasisimple : CFSG.IsQuasisimple L
  le_normalizer_L : I ≤ Subgroup.normalizer (L : Set X)
  le_sup_centralizer : I ≤ L ⊔ Subgroup.centralizer (L : Set X)
  not_le_centralizer : ¬ I ≤ Subgroup.centralizer (L : Set X)
  isE27 : Late.IsE27 A
  le_normalizer_I : A ≤ Subgroup.normalizer (I : Set X)
  le_normalizer_A : A ≤ Subgroup.normalizer (L : Set X)
  inner : ∀ a ∈ A, ∃ i ∈ I, ∀ x ∈ I, a * x * a⁻¹ = i * x * i⁻¹
  mem_of_mem_centralizer : ∀ y ∈ Subgroup.centralizer (A : Set X), y ^ 3 = 1 → y ∈ A
  shape : IsZ3L34OrHeisSL34 ↥(A ⊔ L)

omit [Finite X] in
theorem inf_centralizer_eq_map_center (I : Subgroup X) :
    I ⊓ Subgroup.centralizer (I : Set X) = (Subgroup.center I).map I.subtype := by
  ext x
  constructor
  · rintro ⟨hx, hxc⟩
    refine ⟨⟨x, hx⟩, Subgroup.mem_center_iff.mpr fun w => ?_, rfl⟩
    apply Subtype.ext
    exact Subgroup.mem_centralizer_iff.mp hxc (w : X) w.2
  · rintro ⟨y, hy, rfl⟩
    refine ⟨y.2, Subgroup.mem_centralizer_iff.mpr fun w hw => ?_⟩
    have := Subgroup.mem_center_iff.mp hy ⟨w, hw⟩
    exact congrArg Subtype.val this

omit [Finite X] in
theorem card_sup_mul_card_inf {H K : Subgroup X} (hHK : H ≤ Subgroup.normalizer (K : Set X)) :
    Nat.card (H ⊔ K : Subgroup X) * Nat.card (H ⊓ K : Subgroup X) =
      Nat.card H * Nat.card K := by
  set N := Subgroup.normalizer (K : Set X)
  have hKN : K ≤ N := Subgroup.le_normalizer
  have : (K.subgroupOf N).Normal := Subgroup.normal_in_normalizer
  have h1 := Subgroup.relIndex_mul_card (H := K.subgroupOf N) (K := H.subgroupOf N ⊔ K.subgroupOf N)
  have h2 := Subgroup.relIndex_mul_card (H := K.subgroupOf N) (K := H.subgroupOf N)
  rw [Subgroup.relIndex_sup_right, inf_of_le_left (le_sup_right :
    K.subgroupOf N ≤ H.subgroupOf N ⊔ K.subgroupOf N)] at h1
  rw [inf_comm] at h2
  have hc : ∀ Y : Subgroup X, Y ≤ N → Nat.card (Y.subgroupOf N) = Nat.card Y := fun Y hY =>
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hY).toEquiv
  have hsup : H.subgroupOf N ⊔ K.subgroupOf N = (H ⊔ K).subgroupOf N :=
    (Subgroup.subgroupOf_sup hHK hKN).symm
  have hinf : H.subgroupOf N ⊓ K.subgroupOf N = (H ⊓ K).subgroupOf N :=
    Subgroup.ext fun _ => Iff.rfl
  rw [hsup, hc _ (sup_le hHK hKN), hc K hKN] at h1
  rw [hinf, hc _ (inf_le_left.trans hHK), hc H hHK] at h2
  rw [← h1, ← h2]
  ring

theorem shape_sup {A L : Subgroup X} (hA : Late.IsE27 A)
    (hAL : A ≤ Subgroup.normalizer (L : Set X)) (hLp : Group.IsPerfect L)
    (hZ : IsZ3L34OrHeisSL34 ↥(A ⊔ L)) :
    (Nonempty (L ≃* projSL 3 (GaloisField 2 2)) ∨
        Nonempty (L ≃* Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 2))) ∧
      Nat.card (A ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) ≤ 3 ∧
      ∀ a ∈ A, ∃ l ∈ L, ∀ y ∈ L, a * y * a⁻¹ = l * y * l⁻¹ := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set W := A ⊔ L with hW
  have hAW : A ≤ W := le_sup_left
  have hLW : L ≤ W := le_sup_right
  have hWL : W ≤ Subgroup.normalizer (L : Set X) := sup_le hAL Subgroup.le_normalizer
  set N := L.subgroupOf W with hN
  have hNn : N.Normal := (Subgroup.normal_subgroupOf_iff_le_normalizer hLW).mpr hWL
  set eN : N ≃* L := Subgroup.subgroupOfEquivOfLe hLW with heN
  have hNp : Group.IsPerfect N :=
    Group.IsPerfect.ofSurjective (f := eN.symm.toMonoidHom) eN.symm.surjective
  set E := A.subgroupOf W with hE
  have hEN : E ⊔ N = ⊤ := by
    rw [hE, hN, ← Subgroup.subgroupOf_sup hAW hLW, Subgroup.subgroupOf_self]
  have hEc : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := fun a ha b hb => Subtype.ext
    (congrArg Subtype.val (hA.1.1.is_comm.comm (⟨(a : X), ha⟩ : A) ⟨(b : X), hb⟩) :
      (a : X) * b = b * a)
  have hs : Group.IsSolvable (W ⧸ N) := by
    have hAn : Group.IsNilpotent A := hA.isPGroup.isNilpotent
    refine Group.isSolvable_of_surjective
      (f := (QuotientGroup.mk' N).comp (Subgroup.inclusion hAW)) ?_
    intro q
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective N q
    have hw : (w : X) ∈ ((A ⊔ L : Subgroup X) : Set X) := w.2
    rw [Subgroup.coe_mul_of_left_le_normalizer_right A L hAL] at hw
    obtain ⟨a, ha, l, hl, hal⟩ := hw
    refine ⟨⟨a, ha⟩, ?_⟩
    rw [MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
    refine Subgroup.mem_subgroupOf.mpr ?_
    change a⁻¹ * (w : X) ∈ L
    rw [← hal, inv_mul_cancel_left]
    exact hl
  obtain ⟨hshape, hcard⟩ := shape_of_isZ3L34OrHeisSL34 hZ hs hEc hEN
  refine ⟨?_, ?_, ?_⟩
  · rcases hshape with ⟨⟨φ⟩⟩ | ⟨⟨φ⟩⟩
    · exact Or.inl ⟨eN.symm.trans φ⟩
    · exact Or.inr ⟨eN.symm.trans φ⟩
  · have hmap : (E ⊓ Subgroup.centralizer (N : Set W)).map W.subtype =
        A ⊓ Subgroup.centralizer (L : Set X) := by
      ext x
      constructor
      · rintro ⟨w, ⟨hwE, hwC⟩, rfl⟩
        refine ⟨Subgroup.mem_subgroupOf.mp hwE, Subgroup.mem_centralizer_iff.mpr fun y hy => ?_⟩
        have := Subgroup.mem_centralizer_iff.mp hwC ⟨y, hLW hy⟩ (Subgroup.mem_subgroupOf.mpr hy)
        exact congrArg Subtype.val this
      · rintro ⟨hxA, hxC⟩
        refine ⟨⟨x, hAW hxA⟩, ⟨Subgroup.mem_subgroupOf.mpr hxA,
          Subgroup.mem_centralizer_iff.mpr fun y hy => Subtype.ext ?_⟩, rfl⟩
        exact Subgroup.mem_centralizer_iff.mp hxC (y : X) (Subgroup.mem_subgroupOf.mp hy)
    rw [← hmap, Subgroup.card_map_of_injective W.subtype_injective]
    exact hcard
  · intro a ha
    obtain ⟨n, hn, hconj⟩ :=
      Item4442.exists_mem_conj_eq_of_isZ3L34OrHeisSL34 hZ hs (⟨a, hAW ha⟩ : W)
    refine ⟨(n : X), Subgroup.mem_subgroupOf.mp hn, fun y hy => ?_⟩
    have := hconj ⟨y, hLW hy⟩ (Subgroup.mem_subgroupOf.mpr hy)
    exact congrArg Subtype.val this


theorem nine_le_card_of_lt {Z Y : Subgroup X} (hZ : Nat.card Z = 3) (hZY : Z < Y)
    (hY : Nat.card Y ∣ 27) : 9 ≤ Nat.card Y := by
  have hlt := Subgroup.card_lt_of_lt hZY
  rw [hZ] at hlt
  have : Nat.card Y ∈ Nat.divisors 27 := by
    rw [Nat.mem_divisors]; exact ⟨hY, by norm_num⟩
  have hd : Nat.divisors 27 = {1, 3, 9, 27} := by decide
  rw [hd] at this
  simp only [Finset.mem_insert, Finset.mem_singleton] at this
  omega

theorem exists_two_generators {A Z : Subgroup X} (hZA : Z ≤ A) (hZ : Nat.card Z = 3)
    (hA : Nat.card A = 27) :
    ∃ a₁ ∈ A, ∃ a₂ ∈ A, A ≤ Z ⊔ Subgroup.zpowers a₁ ⊔ Subgroup.zpowers a₂ := by
  have hZA' : Z < A := lt_of_le_of_ne hZA fun heq => by rw [heq, hA] at hZ; norm_num at hZ
  obtain ⟨a₁, ha₁, ha₁Z⟩ := IsConcreteLE.exists_of_lt hZA'
  set A₁ := Z ⊔ Subgroup.zpowers a₁ with hA₁
  have hA₁A : A₁ ≤ A := sup_le hZA (Subgroup.zpowers_le.mpr ha₁)
  have hZA₁ : Z < A₁ := lt_of_le_of_ne le_sup_left fun heq =>
    ha₁Z (heq ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers a₁))
  have h9 : 9 ≤ Nat.card A₁ :=
    nine_le_card_of_lt hZ hZA₁ (hA ▸ Subgroup.card_dvd_of_le hA₁A)
  by_cases heq : A₁ = A
  · exact ⟨a₁, ha₁, a₁, ha₁, heq ▸ le_sup_left⟩
  · obtain ⟨a₂, ha₂, ha₂A₁⟩ := IsConcreteLE.exists_of_lt (lt_of_le_of_ne hA₁A heq)
    refine ⟨a₁, ha₁, a₂, ha₂, ?_⟩
    set A₂ := A₁ ⊔ Subgroup.zpowers a₂ with hA₂
    have hA₂A : A₂ ≤ A := sup_le hA₁A (Subgroup.zpowers_le.mpr ha₂)
    have hA₁A₂ : A₁ < A₂ := lt_of_le_of_ne le_sup_left fun heq' =>
      ha₂A₁ (heq' ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers a₂))
    have hlt := Subgroup.card_lt_of_lt hA₁A₂
    have hdvd : Nat.card A₂ ∣ 27 := hA ▸ Subgroup.card_dvd_of_le hA₂A
    have h27 : Nat.card A₂ = 27 := by
      have : Nat.card A₂ ∈ Nat.divisors 27 := by
        rw [Nat.mem_divisors]; exact ⟨hdvd, by norm_num⟩
      have hd : Nat.divisors 27 = {1, 3, 9, 27} := by decide
      rw [hd] at this
      simp only [Finset.mem_insert, Finset.mem_singleton] at this
      omega
    exact (Subgroup.eq_of_le_of_card_ge hA₂A (by rw [hA, h27])).symm.le

omit [Finite X] in
theorem le_normalizer_centralizer (L : Subgroup X) :
    L ≤ Subgroup.normalizer ((Subgroup.centralizer (L : Set X) : Subgroup X) : Set X) :=
  fun l hl => Subgroup.mem_normalizer_iff.mpr fun c =>
    ⟨fun hc => conj_mem_centralizer (Subgroup.le_normalizer hl) hc, fun hc => by
      have := conj_mem_centralizer (Subgroup.inv_mem _ (Subgroup.le_normalizer hl)) hc
      simpa [mul_assoc] using this⟩

omit [Finite X] in
theorem inner_of_mem_sup_centralizer {L : Subgroup X} {g : X}
    (hg : g ∈ L ⊔ Subgroup.centralizer (L : Set X)) :
    ∃ m ∈ L, ∀ y ∈ L, g * y * g⁻¹ = m * y * m⁻¹ := by
  have hg' : g ∈ ((L ⊔ Subgroup.centralizer (L : Set X) : Subgroup X) : Set X) := hg
  rw [Subgroup.coe_mul_of_left_le_normalizer_right L _ (le_normalizer_centralizer L)] at hg'
  obtain ⟨m, hm, c, hc, rfl⟩ := hg'
  refine ⟨m, hm, fun y hy => ?_⟩
  have hcy : c * y = y * c := (Subgroup.mem_centralizer_iff.mp hc y hy).symm
  calc m * c * y * (m * c)⁻¹ = m * (c * y) * c⁻¹ * m⁻¹ := by group
    _ = m * y * m⁻¹ := by rw [hcy]; group

omit [Finite X] in
theorem card_of_shape {L : Subgroup X}
    (hL : Nonempty (L ≃* projSL 3 (GaloisField 2 2)) ∨
      Nonempty (L ≃* Matrix.SpecialLinearGroup (Fin 3) (GaloisField 2 2))) :
    Nat.card L = 20160 * Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) ∧
      Nat.card (L ⊓ Subgroup.centralizer (L : Set X) : Subgroup X) ∣ 3 := by
  rw [inf_centralizer_eq_map_center, Subgroup.card_map_of_injective L.subtype_injective]
  rcases hL with ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩
  · have hZ : Subgroup.center L = ⊥ := by
      rw [← Subgroup.map_center_eq e.symm, center_projSL_eq_bot, Subgroup.map_bot]
    rw [hZ, Subgroup.card_bot, Nat.card_congr e.toEquiv, KFacts.L34.card_projSL]
    exact ⟨rfl, one_dvd 3⟩
  · rw [KFacts.L34.card_center_of_mulEquiv e, Nat.card_congr e.toEquiv,
      KFacts.KS14.card_SL_three_four]
    exact ⟨rfl, dvd_rfl⟩

