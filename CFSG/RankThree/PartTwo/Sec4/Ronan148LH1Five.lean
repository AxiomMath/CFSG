theorem RowOf427.of_mulEquiv {X Y : Type} [Group X] [Group Y] (φ : X ≃* Y) (h : RowOf427 Y) :
    RowOf427 X :=
  fun S _ _ hs hna ⟨e⟩ => h S hs hna ⟨e.trans φ⟩

section Crit

theorem rowOf427_of_not_nine_dvd {X : Type} [Group X] (h9 : ¬ 9 ∣ Nat.card X)
    (h60 : Nat.card X ≠ 60) (hcube : CubeInner X) : RowOf427 X := by
  intro S _ _ hs hna ⟨eS⟩
  refine row427_of_noA5ON fun T _ _ ⟨eT⟩ τ hτ => ?_
  let φ : T ≃* X := eT.trans eS
  have hT9 : ¬ 9 ∣ Nat.card T := by rwa [Nat.card_congr φ.toEquiv]
  have hT60 : Nat.card T ≠ 60 := by rwa [Nat.card_congr φ.toEquiv]
  haveI hsT : IsSimpleGroup T := (MulEquiv.isSimpleGroup_congr eT).2 hs
  have hnaT : ∃ a b : T, a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hna
    exact ⟨eT.symm a, eT.symm b, fun h => hab (by simpa using congrArg eT h)⟩
  have hZ : Subgroup.center T = ⊥ := RonanK429H.center_eq_bot_of_simple_nonab hnaT
  intro J hJ hq hsn hX
  have h3Q : 3 ∣ Nat.card (↥J ⧸ Subgroup.center ↥J) := by
    rcases hX with h5 | hO
    · obtain ⟨e⟩ := h5
      rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup,
        Fintype.card_fin]
      decide
    · obtain ⟨e⟩ := hO
      rw [Nat.card_congr e.toEquiv, CFSG.Sporadic.ON.card_ON_eq]
      norm_num
  have hJcard : Nat.card J = Nat.card (Subgroup.center ↥J) * Nat.card (↥J ⧸ Subgroup.center ↥J) :=
    (Subgroup.card_eq_card_quotient_mul_card_subgroup _).trans (mul_comm _ _)
  have hJT : Nat.card J ∣ Nat.card T := Subgroup.card_subgroup_dvd_card J
  by_cases hτ1 : τ = 1
  ·
    subst hτ1
    have htop : Sec4.autFix (1 : MulAut T) = ⊤ :=
      Subgroup.ext fun x => ⟨fun _ => Subgroup.mem_top x, fun _ => Sec4.mem_autFix.2 rfl⟩
    rw [htop] at hsn
    have hsn' : J.IsSubnormal := by
      have h := hsn.map (f := (⊤ : Subgroup T).subtype) fun x => ⟨⟨x, Subgroup.mem_top x⟩, rfl⟩
      rwa [Subgroup.subgroupOf_map_subtype, inf_of_le_left le_top] at h
    rcases Subgroup.IsSubnormal.eq_bot_or_top_of_isSimpleGroup hsT hsn' with hb | ht
    ·
      haveI : Nontrivial (↥J ⧸ Subgroup.center ↥J) := hq.2.1.toNontrivial
      obtain ⟨a, b, hab⟩ := exists_pair_ne (↥J ⧸ Subgroup.center ↥J)
      obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
      obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
      have ha : a = 1 := Subtype.ext (by simpa [hb] using a.2)
      have hb' : b = 1 := Subtype.ext (by simpa [hb] using b.2)
      exact hab (by rw [ha, hb'])
    ·
      have hZJ : Nat.card (Subgroup.center ↥J) = 1 := by
        rw [Subgroup.card_eq_one, eq_bot_iff]
        intro z hz
        rw [Subgroup.mem_bot]
        have hzT : (z : T) ∈ Subgroup.center T := by
          rw [Subgroup.mem_center_iff]
          intro g
          have hg : g ∈ J := ht ▸ Subgroup.mem_top g
          exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hz ⟨g, hg⟩)
        rw [hZ, Subgroup.mem_bot] at hzT
        exact Subtype.ext hzT
      have hJTeq : Nat.card J = Nat.card T := by
        rw [ht, Subgroup.card_top]
      rw [hZJ, one_mul] at hJcard
      rcases hX with h5 | hO
      · obtain ⟨e⟩ := h5
        apply hT60
        rw [← hJTeq, hJcard, Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card,
          card_alternatingGroup, Fintype.card_fin]
        rfl
      · obtain ⟨e⟩ := hO
        apply hT9
        rw [← hJTeq, hJcard, Nat.card_congr e.toEquiv, CFSG.Sporadic.ON.card_ON_eq]
        norm_num
  ·
    obtain ⟨s, hsτ⟩ := cubeInner_of_mulEquiv φ hcube τ hτ
    have hs1 : s ≠ 1 := by
      rintro rfl
      exact hτ1 (by rw [← hsτ, map_one])
    have hs3 : s ^ 3 = 1 := by
      have hc : MulAut.conj (s ^ 3) = 1 := by rw [map_pow, hsτ, hτ]
      have hmem : s ^ 3 ∈ Subgroup.center T := by
        rw [Subgroup.mem_center_iff]
        intro g
        have hg := congrArg (fun α : MulAut T => α g) hc
        simp only [MulAut.conj_apply, MulAut.one_apply] at hg
        calc g * s ^ 3 = s ^ 3 * g * (s ^ 3)⁻¹ * s ^ 3 := by rw [hg]
          _ = s ^ 3 * g := by group
      rw [hZ, Subgroup.mem_bot] at hmem
      exact hmem
    have hso : orderOf s = 3 := orderOf_eq_prime hs3 hs1
    have hJC : J ≤ Subgroup.centralizer ({s} : Set T) := by
      rw [← RonanK429.RowV.autFix_conj_eq_centralizer, hsτ]
      exact hJ
    have h3J : 3 ∣ Nat.card J := h3Q.trans (Subgroup.card_quotient_dvd_card _)
    by_cases hsJ : s ∈ J
    ·
      have hsZ : (⟨s, hsJ⟩ : ↥J) ∈ Subgroup.center ↥J := by
        rw [Subgroup.mem_center_iff]
        intro g
        exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp (hJC g.2))
      have h3Z : 3 ∣ Nat.card (Subgroup.center ↥J) := by
        have ho : orderOf (⟨⟨s, hsJ⟩, hsZ⟩ : Subgroup.center ↥J) = 3 := by
          rw [Subgroup.orderOf_mk, Subgroup.orderOf_mk, hso]
        rw [← ho]
        exact orderOf_dvd_natCard _
      apply hT9
      refine Dvd.dvd.trans ?_ hJT
      rw [hJcard, show (9 : ℕ) = 3 * 3 by norm_num]
      exact Nat.mul_dvd_mul h3Z h3Q
    ·
      have hc : ∀ x ∈ J, ∀ y ∈ Subgroup.zpowers s, x * y = y * x := by
        intro x hx y hy
        obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
        exact (Commute.zpow_right
          (show Commute x s from Subgroup.mem_centralizer_singleton_iff.mp (hJC hx)) k).eq
      have hinf : J ⊓ Subgroup.zpowers s = ⊥ := by
        rw [eq_bot_iff]
        rintro x ⟨hxJ, hxs⟩
        rw [Subgroup.mem_bot]
        by_contra hx1
        apply hsJ
        have hxo : orderOf x = 3 := by
          have hx3 : x ^ 3 = 1 := by
            obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hxs
            rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hs3, one_zpow]
          have hd : orderOf x ∣ 3 := orderOf_dvd_of_pow_eq_one hx3
          rcases (Nat.dvd_prime Nat.prime_three).mp hd with h1 | h3
          · exact absurd (orderOf_eq_one_iff.mp h1) hx1
          · exact h3
        have hzp : Subgroup.zpowers x = Subgroup.zpowers s := by
          refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hxs) ?_
          rw [Nat.card_zpowers, Nat.card_zpowers, hxo, hso]
        have : s ∈ Subgroup.zpowers x := hzp ▸ Subgroup.mem_zpowers s
        exact (Subgroup.zpowers_le.mpr hxJ) this
      have hcard := Ronan148R.card_sup_of_commute_of_inf hc hinf
      rw [Nat.card_zpowers, hso] at hcard
      apply hT9
      refine Dvd.dvd.trans ?_ (Subgroup.card_subgroup_dvd_card (J ⊔ Subgroup.zpowers s))
      rw [hcard, show (9 : ℕ) = 3 * 3 by norm_num]
      exact Nat.mul_dvd_mul h3J dvd_rfl

end Crit

theorem not_three_dvd_card_outer_projSL_two {p f : ℕ} [Fact p.Prime] (hf : ¬ 3 ∣ f) :
    ¬ 3 ∣ Nat.card (Outer (projSL 2 (GaloisField p f))) := by
  rcases Nat.eq_zero_or_pos f with rfl | hf0
  · exact absurd (dvd_zero 3) hf
  have hK := GaloisField.card p f (by omega)
  have hd := (CFSG.LocalAnalysis.ComponentInitial.linear_two_outer_order_divisor
    (Fact.out : p.Prime) (GaloisField p f) hK).2 _ ⟨projSLEquivPSLn 2 (GaloisField p f)⟩
  intro h3
  have h3' := h3.trans hd
  rcases (Nat.Prime.dvd_mul Nat.prime_three).mp h3' with h | h
  · exact hf h
  · have := Nat.le_of_dvd (by norm_num) (h.trans (Nat.gcd_dvd_left 2 _))
    omega

theorem not_three_dvd_card_outer_projSL_three_five :
    ¬ 3 ∣ Nat.card (Outer (projSL 3 (GaloisField 5 1))) := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hd := higher_linear_outer_order_divides_field_gcd_bound
      (k := GaloisField 5 1) (p := 5) (f := 1) (n := 3) (by norm_num) le_rfl le_rfl
      (GaloisField.card 5 1 (by norm_num))
  rw [← Nat.card_congr (CFSG.ComponentClassification.OuterAutomorphisms.equivalence
    (projSLEquivProjectiveSL 3 (GaloisField 5 1))).toEquiv] at hd
  intro h3
  have := Nat.le_of_dvd (by norm_num) (h3.trans hd)
  norm_num at this

theorem not_three_dvd_card_outer_projSU_three_five_two :
    ¬ 3 ∣ Nat.card (Outer (projSU 3 5 2)) := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hd := card_outer_projSU_dvd 3 5 2 (by norm_num) le_rfl (by norm_num)
  intro h3
  have h3' := h3.trans hd
  norm_num at h3'

