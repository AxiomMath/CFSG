variable {n : ℕ} {X : Type} [Field X] [Finite X] {σ : X ≃+* X}
variable {ε : ℤ} {p : ℕ} {L : Type} [Field L] [Algebra X L] [IsAlgClosure X L] [CharP L 2]

noncomputable def rcfaPhi (g0 : ModGL TwistTag.D4.tag L) (c : C0 σ) : C0 σ →* ModGL TwistTag.D4.tag L :=
  (MulAut.conj g0⁻¹).toMonoidHom.comp ((triEmb X σ L).comp (MulAut.conj c).toMonoidHom)

theorem rcfaPhi_apply (g0 : ModGL TwistTag.D4.tag L) (c y : C0 σ) :
    rcfaPhi g0 c y = g0⁻¹ * triEmb X σ L (c * y * c⁻¹) * g0 := by
  show (MulAut.conj g0⁻¹) (triEmb X σ L (MulAut.conj c y)) = _
  simp only [MulAut.conj_apply, inv_inv]

theorem rcfaPhi_injective (g0 : ModGL TwistTag.D4.tag L) (c : C0 σ) :
    Function.Injective (rcfaPhi g0 c) := by
  intro a b hab
  rw [rcfaPhi_apply, rcfaPhi_apply] at hab
  have h1 := mul_left_cancel (mul_right_cancel hab)
  have h2 := triEmb_injective h1
  exact mul_left_cancel (mul_right_cancel h2)

theorem rcfaPhi_mem_adjointGroup {g0 : ModGL TwistTag.D4.tag L}
    (hg0 : g0 ∈ adjointGroup TwistTag.D4.tag L) (c y : C0 σ) :
    rcfaPhi g0 c y ∈ adjointGroup TwistTag.D4.tag L := by
  rw [rcfaPhi_apply]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hg0)
    (triEmb_mem_adjointGroup _)) hg0

theorem rcfa_toral_iff (r s : ℕ) (hr : r.Prime) (hs : s.Prime) (hr2 : r ≠ 2) (hs2 : s ≠ 2)
    (hrK : ringChar L ≠ r) (hsK : ringChar L ≠ s) (a b : Fin Tag.D4.rank → Lˣ)
    (ha : orderOf (rootDiagUnit Tag.D4 a) = r) (hb : orderOf (rootDiagUnit Tag.D4 b) = s)
    (w : WeylGroup Tag.D4) (hSa : rootCharKernel a = (fun α => w • α) '' d4A2Sigma)
    (hSb : rootCharKernel b = (fun α => w • α) '' d4A2Sigma)
    (Y : ModGL Tag.D4 L) (hY : Y ∈ adjointGroup Tag.D4 L) :
    Y * rootDiagUnit Tag.D4 a = rootDiagUnit Tag.D4 a * Y ↔
      Y * rootDiagUnit Tag.D4 b = rootDiagUnit Tag.D4 b * Y := by
  have hA := (CFSG.RankThree.Chevalley.D4_odd_prime_A2_root_character_centralizer L r hr hr2
    hrK a ha w hSa).2.1
  have hB := (CFSG.RankThree.Chevalley.D4_odd_prime_A2_root_character_centralizer L s hs hs2
    hsK b hb w hSb).2.1
  have hmemT : ∀ c : Fin Tag.D4.rank → Lˣ,
      (Y * rootDiagUnit Tag.D4 c = rootDiagUnit Tag.D4 c * Y ↔
        Y ∈ toralCentralizer Tag.D4 L c) := by
    intro c
    rw [toralCentralizer, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff]
    exact ⟨fun h => ⟨hY, h⟩, fun h => h.2⟩
  have hsub : toralCentralizer Tag.D4 L a = toralCentralizer Tag.D4 L b :=
    SetLike.coe_injective (hA.trans hB.symm)
  rw [hmemT a, hmemT b, hsub]

theorem rcfa_zeta {x : C0 σ} {i : Fin 4} {F : RclFrame 2 n X σ ε p L} (sp : RclSpecial F x i)
    (D : RclAlgData F i) {z : Matrix.SpecialLinearGroup (Fin 3) L} (hz : z ∈ fixSubgroup D.Φ')
    (hc : ∀ g : Matrix.SpecialLinearGroup (Fin 3) L, g * z = z * g) (hz3 : z ^ 3 = 1)
    (hz1 : z ≠ 1) :
    ∃ ζ : C0 σ, ∃ hζ : ζ ∈ Subgroup.centralizer ({x} : Set (C0 σ)),
      ζ ∈ rclPx sp ∧ (∀ u ∈ rclPx sp, ζ * u = u * ζ) ∧ ζ ^ 3 = 1 ∧ ζ ≠ 1 := by
  classical
  have hinj : Function.Injective (rclPsi sp) :=
    d4QPsi_injective (triEmb_injective (K := X) (σ := σ) (L := L)) F.g0 sp.c x
  have hrange : D.ρ.range = rootSpan TwistTag.D4.tag L (d4Sigma i) := by
    rw [D.frame.range, D.sigma_eq]
  have hQP : (fixSubgroup D.Φ').map D.ρ = rclQ F i :=
    rcl_map_fix_eq D.frame.injective hrange D.Φ_eq
  have hzQ : D.ρ z ∈ rclQ F i := by
    rw [← hQP]
    exact Subgroup.mem_map_of_mem _ hz
  obtain ⟨y, hy⟩ := MonoidHom.mem_range.1 ((rcl_psi_props F sp).2.2.2.2.2.1 hzQ)
  have hyQ : rclPsi sp y ∈ rclQ F i := by
    rw [hy]
    exact hzQ
  have hyPx : (y : C0 σ) ∈ rclPx sp := (mem_rclPx_iff sp y.2).2 hyQ
  have hcent : ∀ u ∈ rclPx sp, (y : C0 σ) * u = u * y := by
    intro u hu
    have hu' : u ∈ Subgroup.centralizer ({x} : Set (C0 σ)) := rclPx_le_centralizer sp hu
    have huQ : rclPsi sp ⟨u, hu'⟩ ∈ rclQ F i := (mem_rclPx_iff sp hu').1 hu
    rw [← hQP] at huQ
    obtain ⟨w, -, hwu⟩ := Subgroup.mem_map.1 huQ
    have hcomm : y * (⟨u, hu'⟩ : Subgroup.centralizer ({x} : Set (C0 σ))) = ⟨u, hu'⟩ * y := by
      apply hinj
      rw [map_mul, map_mul, hy, ← hwu, ← map_mul, ← map_mul, hc w]
    exact congrArg Subtype.val hcomm
  have hy3 : y ^ 3 = 1 := by
    apply hinj
    rw [map_pow, hy, ← map_pow, hz3, map_one, map_one]
  have hζ3 : (y : C0 σ) ^ 3 = 1 := congrArg Subtype.val hy3
  have hζ1 : (y : C0 σ) ≠ 1 := by
    intro h
    have hy1 : y = 1 := Subtype.ext h
    apply hz1
    apply D.frame.injective
    rw [map_one, ← hy, hy1, map_one]
  exact ⟨(y : C0 σ), y.2, hyPx, hcent, hζ3, hζ1⟩

theorem rcfa_psi_eq {x : C0 σ} {i : Fin 4} {F : RclFrame 2 n X σ ε p L} (sp : RclSpecial F x i)
    {ζ : C0 σ} (hζ : ζ ∈ Subgroup.centralizer ({x} : Set (C0 σ))) :
    rclPsi sp ⟨ζ, hζ⟩ = rcfaPhi F.g0 sp.c ζ := by
  rw [rclPsi, d4QPsi_apply, rcfaPhi_apply]
  all_goals rfl

theorem rcfa_kernel {x : C0 σ} {i : Fin 4} {F : RclFrame 2 n X σ ε p L} (sp : RclSpecial F x i)
    {ζ : C0 σ} (hζ : ζ ∈ Subgroup.centralizer ({x} : Set (C0 σ)))
    (hP : ∀ u ∈ rclPx sp, ζ * u = u * ζ) (hne : ζ ≠ 1) :
    ∃ b : Fin TwistTag.D4.tag.rank → Lˣ, rootDiagUnit TwistTag.D4.tag b = rclPsi sp ⟨ζ, hζ⟩ ∧
      rootCharKernel b = d4Sigma i := by
  classical
  have : IsAlgClosed L := IsAlgClosure.isAlgClosed X
  have hinj : Function.Injective (rclPsi sp) :=
    d4QPsi_injective (triEmb_injective (K := X) (σ := σ) (L := L)) F.g0 sp.c x
  have hsub := rcz_mem_subtorus F sp hζ hP
  have hT := twistedTorus_D4_eq_map_of_weylImage (iterateFrobenius L 2 n) F.hn F.w F.hnw
    (d4T36M ε) F.hw
  obtain ⟨hiT, hiC⟩ := hsub
  rw [hT] at hiT
  obtain ⟨b, hb, hbw⟩ := hiT
  rw [← hbw] at hiC
  have hbw' : (rootDiagUnitHom TwistTag.D4.tag L) b = rclPsi sp ⟨ζ, hζ⟩ :=
    hbw.trans ((rcfaPhi_apply F.g0 sp.c ζ).symm.trans (rcfa_psi_eq sp hζ).symm)
  have hb1 : b ≠ 1 := by
    intro h
    apply hne
    have h1 : (rootDiagUnitHom TwistTag.D4.tag L) b = 1 := by rw [h, map_one]
    have h2 : rclPsi sp ⟨ζ, hζ⟩ = 1 := hbw'.symm.trans h1
    have h3 : (⟨ζ, hζ⟩ : Subgroup.centralizer ({x} : Set (C0 σ))) = 1 :=
      hinj (h2.trans (map_one (rclPsi sp)).symm)
    exact congrArg Subtype.val h3
  have hci := (rootDiagUnit_mem_centralizer_rootSpan_iff b
    (fun α hα => isRoot_of_mem_d4Sigma hα)).1 hiC
  have hu : ∀ k : Fin 4, trialityU k ∈ d4Sigma k := fun k =>
    mem_trialitySigma.2 List.mem_cons_self
  rcases d4T36_rootCharKernel_cases F.hε hb hb1 with h0 | ⟨k, hk⟩
  · have hmem : trialityU i ∈ rootCharKernel b :=
      ⟨isRoot_of_mem_d4Sigma (hu i), hci _ (hu i)⟩
    rw [h0] at hmem
    exact (hmem : False).elim
  · have hmi : trialityU i ∈ trialitySigma k := by
      rw [← hk]
      exact ⟨isRoot_of_mem_d4Sigma (hu i), hci _ (hu i)⟩
    have h1 : i = k := by
      by_contra h
      exact Set.disjoint_left.1 (pairwise_disjoint_trialitySigma h) (hu i) hmi
    subst h1
    exact ⟨b, hbw', hk⟩

theorem rcfa_centralizer_eq {x : C0 σ} {i : Fin 4} {F : RclFrame 2 n X σ ε p L}
    (sp : RclSpecial F x i) {ζ : C0 σ} (hζ : ζ ∈ Subgroup.centralizer ({x} : Set (C0 σ)))
    (hζ3 : ζ ^ 3 = 1) (hζ1 : ζ ≠ 1) (b' : Fin TwistTag.D4.tag.rank → Lˣ)
    (hb' : rootDiagUnit TwistTag.D4.tag b' = rclPsi sp ⟨ζ, hζ⟩)
    (hker' : rootCharKernel b' = d4Sigma i) :
    Subgroup.centralizer ({x} : Set (C0 σ)) = Subgroup.centralizer ({ζ} : Set (C0 σ)) := by
  classical
  have hinj : Function.Injective (rcfaPhi F.g0 sp.c) := rcfaPhi_injective F.g0 sp.c
  have hφx : rootDiagUnit TwistTag.D4.tag sp.b = rcfaPhi F.g0 sp.c x := by
    rw [sp.hb, rcfaPhi_apply]
  have hφζ : rootDiagUnit TwistTag.D4.tag b' = rcfaPhi F.g0 sp.c ζ := hb'
  have hp2 : p ≠ 2 := by
    have := F.hp3
    omega
  have hpK : ringChar L ≠ p := by
    rw [ringChar.eq L 2]
    have := F.hp3
    omega
  have hqK : ringChar L ≠ 3 := by
    rw [ringChar.eq L 2]
    norm_num
  have hordA : orderOf (rootDiagUnit TwistTag.D4.tag sp.b) = p := by
    rw [hφx]
    exact (orderOf_injective _ hinj x).trans sp.hx
  have hordB : orderOf (rootDiagUnit TwistTag.D4.tag b') = 3 := by
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    rw [hφζ, orderOf_injective _ hinj ζ]
    exact orderOf_eq_prime hζ3 hζ1
  obtain ⟨w0, -, -, hw0⟩ := exists_smul_d4StdA2 i
  have hA2 : d4A2Sigma = d4StdA2 := d4A2Sigma_eq_trialityStdA2.trans d4StdA2_eq.symm
  have hSa : rootCharKernel sp.b = (fun α : Fin TwistTag.D4.tag.rank → ℤ => w0 • α) '' d4A2Sigma := by
    rw [sp.hker, hA2]
    exact hw0.symm
  have hSb : rootCharKernel b' = (fun α : Fin TwistTag.D4.tag.rank → ℤ => w0 • α) '' d4A2Sigma := by
    rw [hker', hA2]
    exact hw0.symm
  ext y
  rw [Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff]
  have e1 : y * x = x * y ↔
      rcfaPhi F.g0 sp.c y * rcfaPhi F.g0 sp.c x = rcfaPhi F.g0 sp.c x * rcfaPhi F.g0 sp.c y := by
    rw [← map_mul, ← map_mul]
    exact hinj.eq_iff.symm
  have e2 : y * ζ = ζ * y ↔
      rcfaPhi F.g0 sp.c y * rcfaPhi F.g0 sp.c ζ = rcfaPhi F.g0 sp.c ζ * rcfaPhi F.g0 sp.c y := by
    rw [← map_mul, ← map_mul]
    exact hinj.eq_iff.symm
  rw [e1, e2, ← hφx, ← hφζ]
  exact rcfa_toral_iff p 3 F.hp Nat.prime_three hp2 (by norm_num) hpK hqK sp.b b' hordA hordB
    w0 hSa hSb (rcfaPhi F.g0 sp.c y) (rcfaPhi_mem_adjointGroup F.hg0C sp.c y)

