theorem not_dvd_minus_case (x : ℤ) (hx : 4 ≤ x) :
    ¬ (x ^ 3 * (x ^ 2 - 1) * (x ^ 3 - 1) ∣ x ^ 3 * ((x ^ 3) ^ 2 - 1)) := by
  intro h
  have hx0 : (0 : ℤ) < x := by linarith
  have hx2 : 16 ≤ x ^ 2 := by nlinarith
  have hx3 : 64 ≤ x ^ 3 := by nlinarith
  have hA : x ^ 3 * (x ^ 3 - 1) ≠ 0 := by
    have : 0 < x ^ 3 * (x ^ 3 - 1) := mul_pos (by linarith) (by linarith)
    exact this.ne'
  have e1 : x ^ 3 * (x ^ 2 - 1) * (x ^ 3 - 1) = x ^ 3 * (x ^ 3 - 1) * (x ^ 2 - 1) := by ring
  have e2 : x ^ 3 * ((x ^ 3) ^ 2 - 1) = x ^ 3 * (x ^ 3 - 1) * (x ^ 3 + 1) := by ring
  rw [e1, e2] at h
  have h3 : x ^ 2 - 1 ∣ x ^ 3 + 1 := (mul_dvd_mul_iff_left hA).mp h
  have e3 : x ^ 3 + 1 = x * (x ^ 2 - 1) + (x + 1) := by ring
  rw [e3] at h3
  have h4 : x ^ 2 - 1 ∣ x + 1 := (dvd_add_right (dvd_mul_left _ _)).mp h3
  have h5 : x ^ 2 - 1 ≤ x + 1 := Int.le_of_dvd (by linarith) h4
  nlinarith

theorem not_dvd_plus_case (x : ℤ) (hx : 4 ≤ x) :
    ¬ (x ^ 3 * (x ^ 2 - 1) * (x ^ 3 + 1) ∣ x ^ 3 * ((x ^ 3) ^ 2 - 1)) := by
  intro h
  have hx0 : (0 : ℤ) < x := by linarith
  have hx2 : 16 ≤ x ^ 2 := by nlinarith
  have hx3 : 64 ≤ x ^ 3 := by nlinarith
  have hA : x ^ 3 * (x ^ 3 + 1) ≠ 0 := by
    have : 0 < x ^ 3 * (x ^ 3 + 1) := mul_pos (by linarith) (by linarith)
    exact this.ne'
  have e1 : x ^ 3 * (x ^ 2 - 1) * (x ^ 3 + 1) = x ^ 3 * (x ^ 3 + 1) * (x ^ 2 - 1) := by ring
  have e2 : x ^ 3 * ((x ^ 3) ^ 2 - 1) = x ^ 3 * (x ^ 3 + 1) * (x ^ 3 - 1) := by ring
  rw [e1, e2] at h
  have h3 : x ^ 2 - 1 ∣ x ^ 3 - 1 := (mul_dvd_mul_iff_left hA).mp h
  have e3 : x ^ 3 - 1 = x * (x ^ 2 - 1) + (x - 1) := by ring
  rw [e3] at h3
  have h4 : x ^ 2 - 1 ∣ x - 1 := (dvd_add_right (dvd_mul_left _ _)).mp h3
  have h5 : x ^ 2 - 1 ≤ x - 1 := Int.le_of_dvd (by linarith) h4
  nlinarith

theorem not_dvd_nat_minus (q : ℕ) (hq : 4 ≤ q) :
    ¬ (q ^ 3 * (q ^ 2 - 1) * (q ^ 3 - 1) ∣ q ^ 3 * ((q ^ 3) ^ 2 - 1)) := by
  intro h
  have h1 : 1 ≤ q ^ 2 := Nat.one_le_pow _ _ (by omega)
  have h2 : 1 ≤ q ^ 3 := Nat.one_le_pow _ _ (by omega)
  have h4 : 1 ≤ (q ^ 3) ^ 2 := Nat.one_le_pow _ _ (pow_pos (by omega) 3)
  have hz := Int.natCast_dvd_natCast.mpr h
  push_cast [Nat.cast_sub h1, Nat.cast_sub h2, Nat.cast_sub h4] at hz
  exact not_dvd_minus_case (q : ℤ) (by exact_mod_cast hq) hz

theorem not_dvd_nat_plus (q : ℕ) (hq : 4 ≤ q) :
    ¬ (q ^ 3 * (q ^ 2 - 1) * (q ^ 3 + 1) ∣ q ^ 3 * ((q ^ 3) ^ 2 - 1)) := by
  intro h
  have h1 : 1 ≤ q ^ 2 := Nat.one_le_pow _ _ (by omega)
  have h4 : 1 ≤ (q ^ 3) ^ 2 := Nat.one_le_pow _ _ (pow_pos (by omega) 3)
  have hz := Int.natCast_dvd_natCast.mpr h
  push_cast [Nat.cast_sub h1, Nat.cast_sub h4] at hz
  exact not_dvd_plus_case (q : ℤ) (by exact_mod_cast hq) hz

section FibreB


variable {n : ℕ} {X : Type} [Field X] [Finite X] (σ : X ≃+* X)

theorem special_center_classX (P : D4Par n X σ) (hn : 2 ≤ n) {ε : ℤ} {p : ℕ} {L : Type}
    [Field L] [Algebra X L] [IsAlgClosure X L] [CharP L 2] {F : RclFrame 2 n X σ ε p L}
    {S : Sylow p (C0 σ)} {c : C0 σ} {E : Subgroup (C0 σ)} (Ln : RceLines F S c E) (j : Fin 4)
    {ζ : C0 σ} (hζP : ζ ∈ rclPx (Ln.sp j)) (hζc : ∀ u ∈ rclPx (Ln.sp j), ζ * u = u * ζ)
    (hζ3 : ζ ^ 3 = 1) (hζ1 : ζ ≠ 1) : IsClassX σ ζ := by
  classical
  by_contra hnot
  have h3 : ¬ 3 ∣ 2 ^ n := fun h => by
    have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h
    omega
  have hX : Nat.card X = (2 ^ n) ^ 3 := P.card
  have hσ : ∀ t : X, σ t = t ^ (2 ^ n) := P.frob
  have hq4 : 4 ≤ 2 ^ n := by
    have := Nat.pow_le_pow_right (show 0 < 2 by norm_num) hn
    simpa using this
  obtain ⟨g, hgB⟩ : ∃ g : C0 σ, g * ζ * g⁻¹ ∈ Bsub σ := by
    obtain ⟨g, hg⟩ := KS11Lie6Proof.d4ThreeConj_holds X (2 ^ n) σ hX hσ h3 ζ hζ3 hζ1
    rcases hg with hA | hB
    · exact (hnot ⟨hζ3, hζ1, g, hA⟩).elim
    · exact ⟨g, hB⟩
  have hz3 : (g * ζ * g⁻¹) ^ 3 = 1 := by
    rw [conj_pow, hζ3]
    group
  have hz1 : g * ζ * g⁻¹ ≠ 1 := by
    intro e
    apply hζ1
    have : ζ = g⁻¹ * (g * ζ * g⁻¹) * g := by group
    rw [this, e]
    group
  have hK := KS11Lie6Proof.d4ThreeBCent_holds X (2 ^ n) σ hX hσ h3 (g * ζ * g⁻¹) hgB hz3 hz1
  have hHC : (rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom ≤
      Subgroup.centralizer ({g * ζ * g⁻¹} : Set (C0 σ)) := by
    rintro _ ⟨u, hu, rfl⟩
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    subst hh
    change g * ζ * g⁻¹ * (g * u * g⁻¹) = g * u * g⁻¹ * (g * ζ * g⁻¹)
    calc g * ζ * g⁻¹ * (g * u * g⁻¹) = g * (ζ * u) * g⁻¹ := by group
      _ = g * (u * ζ) * g⁻¹ := by rw [hζc u hu]
      _ = g * u * g⁻¹ * (g * ζ * g⁻¹) := by group
  have hperf : ⁅(rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom,
      (rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom⁆ =
        (rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom := by
    rw [← Subgroup.map_commutator, rcy_perfect_rclPx F (Ln.sp j)]
  have hHA : (rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom ≤ Asub σ := by
    calc (rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom
        = ⁅(rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom,
            (rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom⁆ := hperf.symm
      _ ≤ ⁅Subgroup.centralizer ({g * ζ * g⁻¹} : Set (C0 σ)),
            Subgroup.centralizer ({g * ζ * g⁻¹} : Set (C0 σ))⁆ :=
          Subgroup.commutator_mono hHC hHC
      _ ≤ Asub σ := by
          rw [Subgroup.commutator_le]
          intro x hx y hy
          exact hK.1 x hx y hy
  have hcard1 : Nat.card ((rclPx (Ln.sp j)).map (MulAut.conj g).toMonoidHom) =
      Nat.card (rclPx (Ln.sp j)) :=
    Subgroup.card_map_of_injective (MulEquiv.injective (MulAut.conj g))
  have hcardA : Nat.card (Asub σ) = (2 ^ n) ^ 3 * (((2 ^ n) ^ 3) ^ 2 - 1) := by
    rw [KS11Lie4Proof.card_d4ShortSL2 P.sigma_pow_three, hX]
  have hdvd : Nat.card (rclPx (Ln.sp j)) ∣ Nat.card (Asub σ) := by
    rw [← hcard1]
    exact Subgroup.card_dvd_of_le hHA
  rw [card_rclPx (Ln.sp j), hcardA] at hdvd
  rcases F.hε with hε | hε
  · rw [(rcl_card_rclQ F j).1 hε] at hdvd
    exact not_dvd_nat_minus (2 ^ n) hq4 hdvd
  · rw [(rcl_card_rclQ F j).2 hε] at hdvd
    exact not_dvd_nat_plus (2 ^ n) hq4 hdvd

end FibreB

