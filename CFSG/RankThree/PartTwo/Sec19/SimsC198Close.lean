theorem noLocalDatum_of_suzuki {m : ℕ} (hm : (TauCeti.LieTypeIndex.suzuki m).Valid)
    (e : S ≃* (TauCeti.CFSGIndex.lie ⟨.suzuki m, hm⟩).Group) : NoLocalDatum S := by
  have hm1 : 1 ≤ m :=
    (TauCeti.LieTypeIndex.inStandardRange_iff _).1 ((TauCeti.LieTypeIndex.valid_iff _).1 hm).1
  refine noLocalDatum_of_not_dvd fun h27 => ?_
  rw [Nat.card_congr (e.trans (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hm)).toEquiv]
    at h27
  exact CFSG.RankThree.PartTwo.Census.not_three_dvd_card_suzukiMatrixGroup hm1
    (dvd_trans (by norm_num : 3 ∣ 27) h27)

theorem noLocalDatum_of_U42 (e : S ≃* projSU 4 2 1) : NoLocalDatum S := by
  refine noLocalDatum_of_primes fun r hr hrd => ?_
  rw [Nat.card_congr e.toEquiv, CFSG.PGLModel.card_projSU_four_two,
    show (25920 : ℕ) = 2 ^ 6 * 3 ^ 4 * 5 by norm_num] at hrd
  rcases (Nat.Prime.dvd_mul hr).mp hrd with h1 | h1
  · rcases (Nat.Prime.dvd_mul hr).mp h1 with h2 | h2
    · have := (Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).mp (hr.dvd_of_dvd_pow h2)
      omega
    · have := (Nat.prime_dvd_prime_iff_eq hr Nat.prime_three).mp (hr.dvd_of_dvd_pow h2)
      omega
  · have := (Nat.prime_dvd_prime_iff_eq hr (by norm_num : Nat.Prime 5)).mp h1
    omega

theorem noLocalDatum_of_L52 (e : S ≃* projSL 5 (GaloisField 2 1)) : NoLocalDatum S := by
  refine noLocalDatum_of_not_dvd fun h27 => ?_
  rw [Nat.card_congr e.toEquiv,
    ← Nat.card_congr (slEquivProjSL (by norm_num : 1 ≤ 5)).toEquiv,
    CFSG.RankThree.PartTwo.Sec4.Item434SmallTwoOther.L52.card_SL5] at h27
  norm_num at h27

