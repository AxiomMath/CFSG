section Quasisimple

variable {S : Type} [Group S] [Finite S]

private theorem commutator_mul_commute {G : Type*} [Group G] {a b z w : G}
    (hzb : z * b = b * z) (hzw : z * w = w * z) (hwa : w * a⁻¹ = a⁻¹ * w) :
    a * z * (b * w) * (a * z)⁻¹ * (b * w)⁻¹ = a * b * a⁻¹ * b⁻¹ := by
  calc a * z * (b * w) * (a * z)⁻¹ * (b * w)⁻¹
      = a * (z * b) * w * z⁻¹ * a⁻¹ * w⁻¹ * b⁻¹ := by group
    _ = a * (b * z) * w * z⁻¹ * a⁻¹ * w⁻¹ * b⁻¹ := by rw [hzb]
    _ = a * b * (z * w * z⁻¹) * a⁻¹ * w⁻¹ * b⁻¹ := by group
    _ = a * b * w * a⁻¹ * w⁻¹ * b⁻¹ := by rw [hzw, mul_inv_cancel_right]
    _ = a * b * (w * a⁻¹) * w⁻¹ * b⁻¹ := by group
    _ = a * b * (a⁻¹ * w) * w⁻¹ * b⁻¹ := by rw [hwa]
    _ = a * b * a⁻¹ * b⁻¹ := by group

theorem AutDatum.fixIn_eq_of_isQuasisimple {c : S} {L : Subgroup S} {𝒟 : Subgroup (MulAut S)}
    (h : AutDatum S c L 𝒟) (hL : IsQuasisimple L) : fixIn 𝒟 L = L := by
  refine le_antisymm (fixIn_le 𝒟 L) ?_
  have hθ : aschbacherSolvableCore 3 L ≤ Subgroup.center L := by
    rcases CFSG.LocalCores.quasisimple_normal_subgroups hL
      (inferInstance : (aschbacherSolvableCore 3 L).Normal) with htop | hcen
    · exfalso
      haveI := CFSG.LocalCores.isQuasisimple_nontrivial h.quasisimple
      obtain ⟨u, v, huv⟩ := exists_pair_ne (L ⧸ aschbacherSolvableCore 3 L)
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective u
      obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective v
      have hu : (u : L ⧸ aschbacherSolvableCore 3 L) = 1 :=
        (QuotientGroup.eq_one_iff u).mpr (htop ▸ Subgroup.mem_top u)
      have hv : (v : L ⧸ aschbacherSolvableCore 3 L) = 1 :=
        (QuotientGroup.eq_one_iff v).mpr (htop ▸ Subgroup.mem_top v)
      exact huv (hu.trans hv.symm)
    · exact hcen
  have hcent : ∀ z : S, z ∈ thetaIn L → ∀ g ∈ L, g * z = z * g := by
    intro z hz g hg
    obtain ⟨z', hz', rfl⟩ := CoprimeAux.mem_thetaIn_iff.mp hz
    exact congrArg Subtype.val (Subgroup.mem_center_iff.mp (hθ hz') ⟨g, hg⟩)
  have hdec : ∀ x ∈ L, ∃ f ∈ fixIn 𝒟 L, f⁻¹ * x ∈ thetaIn L := by
    intro x hx
    obtain ⟨l, hl, hlt⟩ := h.surj_fixIn (((⟨x, hx⟩ : L)) : L ⧸ aschbacherSolvableCore 3 L)
    refine ⟨l, hl, ?_⟩
    have hmem : l⁻¹ * (⟨x, hx⟩ : L) ∈ aschbacherSolvableCore 3 L := QuotientGroup.eq.mp hlt
    exact (CoprimeAux.coe_mem_thetaIn_iff (l⁻¹ * ⟨x, hx⟩)).mpr hmem
  haveI := h.perfect
  calc L = ⁅L, L⁆ := (Subgroup.commutator_eq_self (H := L)).symm
    _ ≤ fixIn 𝒟 L := by
      rw [Subgroup.commutator_le]
      intro x hx y hy
      obtain ⟨f₁, hf₁, hz₁⟩ := hdec x hx
      obtain ⟨f₂, hf₂, hz₂⟩ := hdec y hy
      have hx' : x = f₁ * (f₁⁻¹ * x) := by group
      have hy' : y = f₂ * (f₂⁻¹ * y) := by group
      have hL₁ : ∀ g ∈ L, g * (f₁⁻¹ * x) = (f₁⁻¹ * x) * g := hcent _ hz₁
      have hL₂ : ∀ g ∈ L, g * (f₂⁻¹ * y) = (f₂⁻¹ * y) * g := hcent _ hz₂
      have hzb : (f₁⁻¹ * x) * f₂ = f₂ * (f₁⁻¹ * x) :=
        (hL₁ f₂ (fixIn_le 𝒟 L hf₂)).symm
      have hzw : (f₁⁻¹ * x) * (f₂⁻¹ * y) = (f₂⁻¹ * y) * (f₁⁻¹ * x) :=
        (hL₁ _ (CoprimeAux.thetaIn_le L hz₂)).symm
      have hwa : (f₂⁻¹ * y) * f₁⁻¹ = f₁⁻¹ * (f₂⁻¹ * y) :=
        (hL₂ _ (inv_mem (fixIn_le 𝒟 L hf₁))).symm
      have key := commutator_mul_commute hzb hzw hwa
      rw [← hx', ← hy'] at key
      rw [commutatorElement_def, key]
      exact mul_mem (mul_mem (mul_mem hf₁ hf₂) (inv_mem hf₁)) (inv_mem hf₂)

end Quasisimple

