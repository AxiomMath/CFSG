section G2Case

open CFSG.Blueprint.Chevalley

variable {S : Type} [Group S] [Finite S]

theorem noAutDatum_of_G2 [IsSimpleGroup S] {K : Type} [Field K] [Finite K] (hK2 : ringChar K = 2)
    (hK4 : 4 ≤ Nat.card K) (e : S ≃* adjointGroup .G2 K) : NoAutDatum S := by
  haveI : Finite (adjointGroup .G2 K) := Finite.of_equiv S e.toEquiv
  haveI := e.symm.isSimpleGroup
  refine NoAutDatum.of_mulEquiv e ?_
  intro c L 𝒟 h
  by_cases hinn : 𝒟 ≤ CFSG.ComponentClassification.OuterAutomorphisms.inner (adjointGroup .G2 K)
  · obtain ⟨E, hE, hE27⟩ := h.exists_elemAbelian_27 hinn
    obtain ⟨n, -, hn⟩ := G2.exists_card_eq_two_pow hK2
    have h3 : ¬ 3 ∣ Nat.card K := fun h3 => by
      rw [hn] at h3
      have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three Nat.prime_two).mp
        (Nat.prime_three.dvd_of_dvd_pow h3)
      omega
    have := CFSG.AGLEmbedding.KFactProofs.G2Q.card_le_nine_of_not_dvd (K := K) h3 (E := E)
      (fun a ha b hb => congrArg Subtype.val (isMulCommutative_iff.mp hE.1 ⟨a, ha⟩ ⟨b, hb⟩))
      (fun x hx => hE.2 x hx)
    omega
  · obtain ⟨φ, hφ, hφout⟩ : ∃ φ ∈ 𝒟,
        φ ∉ (MulAut.conj : _ →* MulAut (adjointGroup .G2 K)).range := by
      by_contra hcon
      push Not at hcon
      exact hinn fun φ hφ => hcon φ hφ
    obtain ⟨hLq, hdvd⟩ := g2_perfect_subnormal_centralizer hK2 hK4 h.orderOf_eq h.le_centralizer
      h.subnormal h.perfect h.mem h.toLocalDatum.exists_elemAbelian
    have hfix := h.fixIn_eq_of_isQuasisimple hLq
    exact g2_not_dvd_of_outer hK2 hK4 φ (h.pow_three φ hφ) hφout L
      (fun l hl => (mem_fixIn.mp (hfix ▸ hl)).2 φ hφ) hdvd

end G2Case

section ReeCase

open CFSG.LieType.Ree

variable {S : Type} [Group S] [Finite S]

private theorem unitary_order_strictMono {x y : ℕ} (hx : 2 ≤ x) (hxy : x < y) :
    x ^ 3 * (x ^ 2 - 1) * (x ^ 3 + 1) < y ^ 3 * (y ^ 2 - 1) * (y ^ 3 + 1) := by
  have h1 : x ^ 3 < y ^ 3 := Nat.pow_lt_pow_left hxy (by norm_num)
  have h2 : x ^ 2 - 1 ≤ y ^ 2 - 1 := Nat.sub_le_sub_right (Nat.pow_le_pow_left hxy.le 2) 1
  have h2pos : 0 < x ^ 2 - 1 := by
    have : 4 ≤ x ^ 2 := by nlinarith
    omega
  have h3 : x ^ 3 + 1 < y ^ 3 + 1 := by omega
  exact mul_lt_mul'' (mul_lt_mul h1 h2 h2pos (Nat.zero_le _)) h3 (Nat.zero_le _) (Nat.zero_le _)

theorem noAutDatum_of_reeGamma [IsSimpleGroup S] {a : ℕ} {K : Type} [Field K] [Finite K]
    [CharP K ReeTag.F4.prime] (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (e : S ≃* ReeTag.F4.reeGamma K a) : NoAutDatum S := by
  haveI : Finite (ReeTag.F4.reeGamma K a) := Finite.of_equiv S e.toEquiv
  haveI := e.symm.isSimpleGroup
  refine NoAutDatum.of_mulEquiv e ?_
  intro c L 𝒟 h
  by_cases hinn : 𝒟 ≤ CFSG.ComponentClassification.OuterAutomorphisms.inner
      (ReeTag.F4.reeGamma K a)
  · obtain ⟨E, hE, hE27⟩ := h.exists_elemAbelian_27 hinn
    have := CFSG.RankThree.PartTwo.Sec21.ReeF4ThreeLocalProof.card_le_nine_of_reeGamma a K hK E hE
    omega
  · obtain ⟨φ, hφ, hφout⟩ : ∃ φ ∈ 𝒟,
        φ ∉ (MulAut.conj : _ →* MulAut (ReeTag.F4.reeGamma K a)).range := by
      by_contra hcon
      push Not at hcon
      exact hinn fun φ hφ => hcon φ hφ
    have hqs := reeGamma_isQuasisimple_centralizer ha hK c h.orderOf_eq
    have hc1 : c ≠ 1 := by
      rintro rfl
      have := h.orderOf_eq
      rw [orderOf_one] at this
      omega
    have hL1 : L ≠ ⊥ := fun hb => hc1 (Subgroup.mem_bot.mp (hb ▸ h.mem))
    have hLeq : L = Subgroup.centralizer ({c} : Set (ReeTag.F4.reeGamma K a)) :=
      G2.eq_of_isPerfect_of_isSubnormal_of_isQuasisimple hqs h.le_centralizer h.perfect
        h.subnormal hL1
    have hLq : IsQuasisimple L := by rw [hLeq]; exact hqs
    have hfix := h.fixIn_eq_of_isQuasisimple hLq
    have hφc : φ c = c := h.apply_eq h.center_eq_bot hφ
    have hφL : ∀ x ∈ Subgroup.centralizer ({c} : Set (ReeTag.F4.reeGamma K a)), φ x = x :=
      fun x hx => (mem_fixIn.mp (hfix ▸ (hLeq ▸ hx : x ∈ L))).2 φ hφ
    have hcorder := h.orderOf_eq
    obtain ⟨b, k, _, _, _, hk, hb, ι, hι, hrange⟩ :=
      reeGamma_fixed_of_outer ha hK φ (h.pow_three φ hφ) hφout
    obtain ⟨c', rfl⟩ := MonoidHom.mem_range.mp ((hrange c).mpr hφc)
    have hc'3 : orderOf c' = 3 := by rw [← orderOf_injective ι hι c']; exact hcorder
    have hmap : (Subgroup.centralizer ({c'} : Set (ReeTag.F4.reeGamma k b))).map ι =
        Subgroup.centralizer ({ι c'} : Set (ReeTag.F4.reeGamma K a)) := by
      ext x
      simp only [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff]
      constructor
      · rintro ⟨y, hy, rfl⟩
        rw [← map_mul, ← map_mul, hy]
      · intro hx
        obtain ⟨y, rfl⟩ := MonoidHom.mem_range.mp ((hrange x).mpr (hφL x
          (Subgroup.mem_centralizer_singleton_iff.mpr hx)))
        refine ⟨y, hι ?_, rfl⟩
        rw [map_mul, map_mul]
        exact hx
    have hcard : Nat.card (Subgroup.centralizer ({ι c'} : Set (ReeTag.F4.reeGamma K a))) =
        Nat.card (Subgroup.centralizer ({c'} : Set (ReeTag.F4.reeGamma k b))) := by
      rw [← hmap, Subgroup.card_map_of_injective hι]
    rw [reeGamma_card_centralizer hK _ hcorder, reeGamma_card_centralizer hk c' hc'3] at hcard
    have hlt : 2 ^ (2 * b + 1) < 2 ^ (2 * a + 1) :=
      Nat.pow_lt_pow_right (by norm_num) (by omega)
    have h2 : 2 ≤ 2 ^ (2 * b + 1) := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (2 * b + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact absurd hcard (ne_of_gt (unitary_order_strictMono h2 hlt))

end ReeCase

