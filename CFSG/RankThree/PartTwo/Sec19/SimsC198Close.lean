theorem outerAutDatum_of_trialityD4 [IsSimpleGroup S] {q : TauCeti.PrimePower}
    {hv : (TauCeti.LieTypeIndex.trialityD4 q).Valid} (hq3 : q.p ≠ 3)
    (e : S ≃* (TauCeti.CFSGIndex.lie ⟨.trialityD4 q, hv⟩).Group) : OuterAutDatum S := by
  refine outerAutDatum_of_elemAbelian fun E hE => ?_
  have h := CFSG.HardMathSupport.Timmesfeld.CrossChar.rankLE2_three_cat_trialityD4 q hv hq3
    (E.map e.toMonoidHom) (CFSG.SectionRank.isElemAbelian_map hE e.toMonoidHom)
  rwa [Subgroup.card_map_of_injective e.injective, show (3 : ℕ) ^ 2 = 9 by norm_num] at h

