theorem false_of_two_transvections {A : Subgroup G}
    (hA : CFSG.Assembly.IsElemAbelian 3 A) (h27 : Nat.card A = 27) {c d d' u w : G}
    (hcA : c ∈ A) (hdA : d ∈ A) (hd'A : d' ∈ A) (hc3 : Nat.card (Subgroup.zpowers c) = 3)
    (hdc : d ∉ Subgroup.zpowers c)
    (huN : u ∈ Subgroup.normalizer (A : Set G)) (hwN : w ∈ Subgroup.normalizer (A : Set G))
    (huc : u * c * u⁻¹ = c) (hud : u * d * u⁻¹ = d)
    (huA : ∀ a ∈ A, u * a * u⁻¹ * a⁻¹ ∈ Subgroup.zpowers d)
    (huB : ∀ a ∈ A, u * a * u⁻¹ = a → a ∈ Subgroup.zpowers c ⊔ Subgroup.zpowers d)
    (hwd' : w * d' * w⁻¹ = d') (hwA : ∀ a ∈ A, w * a * w⁻¹ * a⁻¹ ∈ Subgroup.zpowers d')
    (hwH : w ∉ Subgroup.normalizer (Subgroup.zpowers c : Set G))
    (hΩ : ∀ x ∈ Subgroup.normalizer (A : Set G),
      x * c * x⁻¹ ∈ Subgroup.zpowers c ⊔ Subgroup.zpowers d →
        Subgroup.zpowers (x * c * x⁻¹) = Subgroup.zpowers c) : False := by
  classical
  set B := Subgroup.zpowers c ⊔ Subgroup.zpowers d with hB
  have hcomm : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := fun x hx y hy =>
    congrArg Subtype.val (hA.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)
  have hd3 : d ^ 3 = 1 := hA.2 d hdA
  have hd'3 : d' ^ 3 = 1 := hA.2 d' hd'A
  have hcB : c ∈ B := (le_sup_left : Subgroup.zpowers c ≤ B) (Subgroup.mem_zpowers c)
  have hdB : d ∈ B := (le_sup_right : Subgroup.zpowers d ≤ B) (Subgroup.mem_zpowers d)
  have hfin : ∀ x ∈ Subgroup.normalizer (A : Set G), ∀ m : ℕ, m % 3 ≠ 0 →
      x * c * x⁻¹ = c * d ^ m → False := by
    intro x hx m hm hxc
    have hmem : x * c * x⁻¹ ∈ B := by
      rw [hxc]
      exact B.mul_mem hcB (B.pow_mem hdB m)
    have hz := hΩ x hx hmem
    have hcd : c * d ^ m ∈ Subgroup.zpowers c := by
      rw [← hxc, ← hz]
      exact Subgroup.mem_zpowers _
    have hdm : d ^ m ∈ Subgroup.zpowers c := by
      have : d ^ m = c⁻¹ * (c * d ^ m) := by group
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.mem_zpowers c)) hcd
    rw [Sec11.pow_eq_pow_mod_three hd3 m] at hdm
    have hm3 : m % 3 < 3 := Nat.mod_lt _ (by norm_num)
    interval_cases hmm : m % 3
    · exact absurd rfl hm
    · exact hdc (by rwa [pow_one] at hdm)
    · apply hdc
      have h1 : d = (d ^ 2) ^ 2 := by
        rw [← pow_mul, show 2 * 2 = 3 + 1 by norm_num, pow_succ, hd3, one_mul]
      rw [h1]
      exact Subgroup.pow_mem _ hdm 2
  by_cases hd'B : d' ∈ B
  ·
    apply hwH
    have hwc : w * c * w⁻¹ ∈ B := by
      have h1 : w * c * w⁻¹ = (w * c * w⁻¹ * c⁻¹) * c := by group
      rw [h1]
      exact B.mul_mem ((Subgroup.zpowers_le.mpr hd'B) (hwA c hcA)) hcB
    have hz := hΩ w hwN hwc
