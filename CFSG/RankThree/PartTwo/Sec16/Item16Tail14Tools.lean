variable {G : Type} [Group G]

theorem conj_eq_of_mem_zpowers {w y : G} {k : ℕ} (hw : w ^ 3 ^ k = 1) (hy3 : y ^ 3 = 1)
    (hwy : w * y * w⁻¹ ∈ Subgroup.zpowers y) : w * y * w⁻¹ = y := by
  set σ := MulAut.conj w with hσ
  have hσy : ∀ z : G, σ z = w * z * w⁻¹ := fun z => rfl
  have hσk : σ ^ 3 ^ k = 1 := by rw [hσ, ← map_pow, hw, map_one]
  rcases eq_of_mem_zpowers_of_pow_three hy3 hwy with h | h | h
  · have hy1 : y = 1 := by
      have h1 : σ y = σ 1 := by rw [hσy, h, map_one]
      exact σ.injective h1
    rw [hy1]
    group
  · exact h
  ·
    have h2 : (σ ^ 2) y = y := by
      rw [pow_two, MulAut.mul_apply, hσy y, h, map_pow, hσy y, h, ← pow_mul,
        show 2 * 2 = 3 + 1 by norm_num, pow_succ, hy3, one_mul]
    have h2q : ∀ q : ℕ, ((σ ^ 2) ^ q) y = y := by
      intro q
      induction q with
      | zero => rfl
      | succ q ih => rw [pow_succ, MulAut.mul_apply, h2, ih]
    have hodd : 3 ^ k = 2 * (3 ^ k / 2) + 1 := by
      have h21 : 3 ^ k % 2 = 1 := Nat.odd_iff.mp (Odd.pow (by decide))
      omega
    have hy : y = y ^ 2 := by
      have h1 : (σ ^ 3 ^ k) y = y := by rw [hσk, MulAut.one_apply]
      rw [hodd, pow_succ, pow_mul, MulAut.mul_apply, hσy y, h, map_pow, h2q] at h1
      exact h1.symm
    have hy1 : y = 1 := by
      have h1 : y * y = y * 1 := by rw [mul_one, ← pow_two, ← hy]
      exact mul_left_cancel h1
    rw [h, hy1, one_pow]

theorem card_zpowers_eq_three {y : G} (hy3 : y ^ 3 = 1) (hy1 : y ≠ 1) :
    Nat.card (Subgroup.zpowers y) = 3 := by
  rw [Nat.card_zpowers]
  exact orderOf_eq_prime hy3 hy1

variable [Finite G]

theorem card_inf_centralizer_le_nine {A : Subgroup G} (hA27 : Nat.card A = 27) {w : G}
    (hw : ∃ a ∈ A, w * a * w⁻¹ ≠ a) :
    Nat.card (A ⊓ Subgroup.centralizer ({w} : Set G) : Subgroup G) ≤ 9 := by
  obtain ⟨a, haA, hwa⟩ := hw
  have hlt : A ⊓ Subgroup.centralizer ({w} : Set G) < A := by
    refine lt_of_le_of_ne inf_le_left fun heq => hwa ?_
    have ha : a ∈ A ⊓ Subgroup.centralizer ({w} : Set G) := by rw [heq]; exact haA
    have := Subgroup.mem_centralizer_singleton_iff.mp ha.2
    rw [← this, mul_inv_cancel_right]
  have hcard := Subgroup.card_lt_of_lt hlt
  have hdvd : Nat.card (A ⊓ Subgroup.centralizer ({w} : Set G) : Subgroup G) ∣ 3 ^ 3 := by
    rw [show (3 : ℕ) ^ 3 = 27 by norm_num, ← hA27]
    exact Subgroup.card_dvd_of_le inf_le_left
  obtain ⟨m, hm, hmeq⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hdvd
  rw [hmeq] at hcard ⊢
  rw [hA27] at hcard
  have hm2 : m ≤ 2 := by
    by_contra hm2
    have : m = 3 := by omega
    rw [this] at hcard
    norm_num at hcard
  calc 3 ^ m ≤ 3 ^ 2 := Nat.pow_le_pow_right (by norm_num) hm2
    _ = 9 := by norm_num

omit [Finite G] in
theorem conj_center_eq {A : Subgroup G} (hA : CFSG.Assembly.IsElemAbelian 3 A) {w d : G}
    {k : ℕ} (hw : w ^ 3 ^ k = 1) (hdA : d ∈ A)
    (hwA : ∀ a ∈ A, w * a * w⁻¹ * a⁻¹ ∈ Subgroup.zpowers d) : w * d * w⁻¹ = d := by
  refine conj_eq_of_mem_zpowers hw (hA.2 d hdA) ?_
  have h1 := hwA d hdA
  have h2 : w * d * w⁻¹ = (w * d * w⁻¹ * d⁻¹) * d := by group
  rw [h2]
  exact Subgroup.mul_mem _ h1 (Subgroup.mem_zpowers d)

theorem center_mem {A N : Subgroup G} (hA : CFSG.Assembly.IsElemAbelian 3 A)
    (hAN : A ≤ Subgroup.normalizer (N : Set G)) {x d : G} (hxN : x ∈ N) (hdA : d ∈ A)
    (hxA : ∀ a ∈ A, x * a * x⁻¹ * a⁻¹ ∈ Subgroup.zpowers d) (hx1 : ∃ a ∈ A, x * a * x⁻¹ ≠ a) :
    d ∈ N := by
  obtain ⟨y, hyA, hxy⟩ := hx1
  set z := x * y * x⁻¹ * y⁻¹ with hz
  have hz1 : z ≠ 1 := by
    intro h1
    apply hxy
    rw [hz, mul_inv_eq_one] at h1
    exact h1
  have hzN : z ∈ N := by
    have hyx : y * x⁻¹ * y⁻¹ ∈ N := (Subgroup.mem_normalizer_iff.mp (hAN hyA) _).mp (N.inv_mem hxN)
    have : z = x * (y * x⁻¹ * y⁻¹) := by rw [hz]; group
    rw [this]
    exact N.mul_mem hxN hyx
  have hd1 : d ≠ 1 := by
    rintro rfl
    apply hz1
    have := hxA y hyA
    rwa [Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot] at this
  have hzd : Subgroup.zpowers z = Subgroup.zpowers d :=
    zpowers_eq_of_mem_of_ne_one (card_zpowers_eq_three (hA.2 d hdA) hd1) (hxA y hyA) hz1
  have hdz : d ∈ Subgroup.zpowers z := hzd ▸ Subgroup.mem_zpowers d
  exact (Subgroup.zpowers_le.mpr hzN) hdz

omit [Finite G] in
theorem zpowers_mul_ne {a δ : G} (hcomm : a * δ = δ * a) (ha3 : a ^ 3 = 1) (hδ3 : δ ^ 3 = 1)
    (haδ : a ∉ Subgroup.zpowers δ) (hδ1 : δ ≠ 1) :
    Subgroup.zpowers (a * δ) ≠ Subgroup.zpowers (a * δ ^ 2) := by
  intro heq
  have hcom : Commute a δ := hcomm
  have hmem : a * δ ^ 2 ∈ Subgroup.zpowers (a * δ) := heq ▸ Subgroup.mem_zpowers _
  have h3 : (a * δ) ^ 3 = 1 := by rw [hcom.mul_pow, ha3, hδ3, one_mul]
  rcases eq_of_mem_zpowers_of_pow_three h3 hmem with h | h | h
  ·
    apply haδ
    have : a = δ := by
      have h1 : a * δ ^ 2 * δ = δ := by rw [h, one_mul]
      rwa [mul_assoc, ← pow_succ, hδ3, mul_one] at h1
    rw [this]
    exact Subgroup.mem_zpowers δ
  ·
    apply hδ1
    have h1 : δ ^ 2 = δ := mul_left_cancel h
    have h2 : δ * δ = δ * 1 := by rw [mul_one, ← pow_two, h1]
    exact mul_left_cancel h2
  ·
    apply haδ
    have h1 : a * δ ^ 2 = a ^ 2 * δ ^ 2 := by rw [h, hcom.mul_pow]
    have h2 : a = a ^ 2 := mul_right_cancel h1
    have ha1 : a = 1 := by
      have h4 : a * a = a * 1 := by rw [mul_one, ← pow_two, ← h2]
      exact mul_left_cancel h4
    rw [ha1]
    exact Subgroup.one_mem _

omit [Finite G] in
theorem mem_centralizer_of_conj_eq {x y : G} (h : x * y * x⁻¹ = y) :
    y ∈ Subgroup.centralizer ({x} : Set G) :=
  Subgroup.mem_centralizer_singleton_iff.mpr (Sec11.mul_comm_of_conj_eq h)

theorem checkSL_a7 : ∀ q < 14, 2 ≤ q → q ^ 3 ∣ 2520 →
    2520 * Nat.gcd 3 (q - 1) ≠ q ^ 3 * ((q ^ 2 - 1) * (q ^ 3 - 1)) := by
  decide +kernel

theorem checkSU_a7 : ∀ q < 14, 2 ≤ q → q ^ 3 ∣ 2520 →
    2520 * Nat.gcd 3 (q + 1) ≠ q ^ 3 * ((q ^ 2 - 1) * (q ^ 3 + 1)) := by
  decide +kernel

theorem not_isoLThreePi_a7 (p e : ℕ) [Fact p.Prime] :
    ¬ Sec4.IsoLThreePi (alternatingGroup (Fin 7)) p e :=
  KFacts.KS14.not_isoLThreePi_of_card KFacts.KS14.card_alternatingGroup_five_seven_ten.2.1
    (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) checkSL_a7)
    (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) checkSU_a7) p e

