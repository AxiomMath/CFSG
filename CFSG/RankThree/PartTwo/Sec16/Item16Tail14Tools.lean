theorem false_of_transvection_in_C (h1611 : Step1611) (h1613 : Step1613) (hInv : KS1613Inv)
    {A M N : Subgroup G} {a b : G} (hb : Ctx169 G A b M) (ha : Ctx169 G A a N)
    (hab : Subgroup.zpowers a ≠ Subgroup.zpowers b) {x δ : G}
    (hxN : x ∈ N ⊓ Subgroup.normalizer (A : Set G)) {k : ℕ} (hx3 : x ^ 3 ^ k = 1)
    (hδA : δ ∈ A) (hxA : ∀ y ∈ A, x * y * x⁻¹ * y⁻¹ ∈ Subgroup.zpowers δ)
    (hx1 : ∃ y ∈ A, x * y * x⁻¹ ≠ y) (hxb : x * b * x⁻¹ = b) (hδM : δ ∈ M) : False := by
  obtain ⟨hxN', -⟩ := Subgroup.mem_inf.mp hxN
  have hA := hb.isElemAbelian
  have hδN : δ ∈ N := center_mem hA ha.le_normalizer hxN' hδA hxA hx1
  have hδ1 : δ ≠ 1 := by
    rintro rfl
    obtain ⟨y, hyA, hxy⟩ := hx1
    apply hxy
    have := hxA y hyA
    rwa [Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot, mul_inv_eq_one] at this
  have hδ3 : Nat.card (Subgroup.zpowers δ) = 3 := card_zpowers_eq_three (hA.2 δ hδA) hδ1
  have haN : a ∉ N := ha.toSec15R.hypS.2.2 a ha.zpowers_mem_omegaA N ha.mem_lA
  have hbM : b ∉ M := hb.toSec15R.hypS.2.2 b hb.zpowers_mem_omegaA M hb.mem_lA
  have haA : a ∈ A := ha.mem_A
  have hbA : b ∈ A := hb.mem_A
  have ha3 : a ^ 3 = 1 := hA.2 a haA
  have hδ3' : δ ^ 3 = 1 := hA.2 δ hδA
  have hcomm : a * δ = δ * a := hb.commute haA hδA
  have haδ : a ∉ Subgroup.zpowers δ := fun h => haN ((Subgroup.zpowers_le.mpr hδN) h)
  have hbδ : b ∉ Subgroup.zpowers δ := fun h => hbM ((Subgroup.zpowers_le.mpr hδM) h)
  have hxa : x * a * x⁻¹ = a := by
    rw [Subgroup.mem_centralizer_singleton_iff.mp (ha.le_centralizer hxN'), mul_inv_cancel_right]
  have hxδ : x * δ * x⁻¹ = δ := conj_center_eq hA hx3 hδA hxA
  set B' := Subgroup.zpowers δ ⊔ Subgroup.zpowers a with hB'
  have hB'A : B' ≤ A := sup_le (Subgroup.zpowers_le.mpr hδA) (Subgroup.zpowers_le.mpr haA)
  have hB'C : B' ≤ A ⊓ Subgroup.centralizer ({x} : Set G) :=
    le_inf hB'A (sup_le (Subgroup.zpowers_le.mpr (mem_centralizer_of_conj_eq hxδ))
      (Subgroup.zpowers_le.mpr (mem_centralizer_of_conj_eq hxa)))
  have hB'9 : 9 ≤ Nat.card B' := nine_le_card_of_lt hB'A hb.card_eq hδ3
    (lt_of_le_of_ne le_sup_left fun heq =>
      haδ (heq ▸ (le_sup_right : Subgroup.zpowers a ≤ B') (Subgroup.mem_zpowers a)))
  have hCx := card_inf_centralizer_le_nine hb.card_eq hx1
  have hB'eq : B' = A ⊓ Subgroup.centralizer ({x} : Set G) :=
    Subgroup.eq_of_le_of_card_ge hB'C (hCx.trans hB'9)
  have hbB' : b ∈ B' := by
    rw [hB'eq]
    exact ⟨hbA, mem_centralizer_of_conj_eq hxb⟩
  obtain ⟨j, hj, hbj⟩ := zpowers_eq_mul_pow_of_mem_sup hcomm ha3 hδ3' hbB' hbδ
  have hj0 : j ≠ 0 := by
    rintro rfl
    apply hab
    rw [hbj, pow_zero, mul_one]
  obtain ⟨t, htN, ht⟩ := hInv G A a N ha (h1611 G A a N ha) (Subgroup.zpowers δ)
    (le_inf (Subgroup.zpowers_le.mpr hδA) (Subgroup.zpowers_le.mpr hδN)) hδ3
  have htδ : t * δ * t⁻¹ = δ⁻¹ := ht δ (Subgroup.mem_zpowers δ)
  have hta : t * a * t⁻¹ = a := by
    rw [Subgroup.mem_centralizer_singleton_iff.mp (ha.le_centralizer htN), mul_inv_cancel_right]
  have hDb : Subgroup.zpowers δ ⊔ Subgroup.zpowers b = B' := by
    refine Subgroup.eq_of_le_of_card_ge (sup_le le_sup_left (Subgroup.zpowers_le.mpr hbB')) ?_
    have h1 : Nat.card B' ≤ 9 := hB'eq ▸ hCx
    have h2 : 9 ≤ Nat.card (Subgroup.zpowers δ ⊔ Subgroup.zpowers b : Subgroup G) :=
      nine_le_card_of_lt (sup_le (Subgroup.zpowers_le.mpr hδA) (Subgroup.zpowers_le.mpr hbA))
        hb.card_eq hδ3 (lt_of_le_of_ne le_sup_left fun heq =>
          hbδ (heq ▸ (le_sup_right : Subgroup.zpowers b ≤ _) (Subgroup.mem_zpowers b)))
    omega
  have htD : (Subgroup.zpowers δ).map (MulAut.conj t).toMonoidHom = Subgroup.zpowers δ := by
    rw [MonoidHom.map_zpowers]
    change Subgroup.zpowers (t * δ * t⁻¹) = _
    rw [htδ, Subgroup.zpowers_inv]
  have htA' : (Subgroup.zpowers a).map (MulAut.conj t).toMonoidHom = Subgroup.zpowers a := by
    rw [MonoidHom.map_zpowers]
    change Subgroup.zpowers (t * a * t⁻¹) = _
    rw [hta]
  have htU : t ∈ Subgroup.normalizer
      ((Subgroup.zpowers δ ⊔ Subgroup.zpowers b : Subgroup G) : Set G) ⊓
      Subgroup.normalizer (Subgroup.zpowers δ : Set G) := by
    refine Subgroup.mem_inf.mpr ⟨Subgroup.mem_normalizer_iff_map_conj_eq.mpr ?_,
      Subgroup.mem_normalizer_iff_map_conj_eq.mpr htD⟩
    rw [hDb]
    have h := congrArg₂ (· ⊔ ·) htD htA'
    rwa [← Subgroup.map_sup] at h
  have htH := h1613 G A b M hb (Subgroup.zpowers δ)
    (le_inf (Subgroup.zpowers_le.mpr hδA) (Subgroup.zpowers_le.mpr hδM)) hδ3 htU
  have hmap : Subgroup.zpowers (t * (a * δ ^ j) * t⁻¹) = Subgroup.zpowers (a * δ ^ j) := by
    have h1 := Subgroup.mem_normalizer_iff_map_conj_eq.mp htH
    rw [hbj, MonoidHom.map_zpowers] at h1
    exact h1
  rw [conj_mul_pow_of_inv hδ3' hta htδ j] at hmap
  interval_cases j
  · exact absurd rfl hj0
  · exact zpowers_mul_ne hcomm ha3 hδ3' haδ hδ1 (by simpa using hmap.symm)
  · have h4 : δ ^ (2 * 2) = δ := by
      rw [show 2 * 2 = 3 + 1 by norm_num, pow_succ, hδ3', one_mul]
    rw [h4] at hmap
    exact zpowers_mul_ne hcomm ha3 hδ3' haδ hδ1 hmap

theorem le_or_pgl (h1611 : Step1611) (h1613 : Step1613) (h133 : Item133)
    {A M : Subgroup G} {a : G} (h : Ctx169 G A a M) :
    Subgroup.normalizer (A : Set G) ≤ Subgroup.normalizer (Subgroup.zpowers a : Set G) ∨
      Sec8.IsZ3PGLThreePi ↥(lBarA a M A) := by
  rcases h1611 G A a M h with hPGL | ⟨n, -, hiso, ⟨ψ⟩⟩
  · exact Or.inr hPGL
  by_cases hWa : Subgroup.normalizer (A : Set G) ≤ Subgroup.normalizer (Subgroup.zpowers a : Set G)
  · exact Or.inl hWa
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have haM : a ∉ M := h.toSec15R.hypS.2.2 a h.zpowers_mem_omegaA M h.mem_lA
  obtain ⟨-, ⟨hM12p, hM12z⟩, ⟨hJ2p, hJ2z⟩⟩ := sporadicModels131
  rcases h133 G A a M h.toSec13Data h.hypS_or_hypT with h1 | ⟨-, ⟨e7⟩, -⟩ |
      ⟨hirr, hWB, -⟩ | hP | ⟨⟨e12⟩⟩ | ⟨⟨eJ⟩⟩
  · exact absurd h1 hWa
  · exfalso
    obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data isPerfect_center_alt7.1
      isPerfect_center_alt7.2 e7
    exact not_isoLThreePi_a7 2 n (isoLThreePi_of_mulEquiv χ hiso)
  · exfalso
    have h9 : Nat.card (A ⊓ M : Subgroup G) = 9 :=
      card_inf_eq_nine h.toSec13Data (isPerfect_lBar h.toSec13Data) ψ
    have hBh : IsHyperplane A (A ⊓ M) := ⟨inf_le_left, by rw [h.card_eq, h9]⟩
    have haB : a ∉ A ⊓ M := fun h' => haM h'.2
    have hAa : A = Subgroup.zpowers a ⊔ (A ⊓ M) :=
      le_antisymm (le_zpowers_sup_of_not_mem hBh h.mem_A haB)
        (sup_le (Subgroup.zpowers_le.mpr h.mem_A) inf_le_left)
    have hne : A ⊓ M ≠ ⊥ := by
      intro hbot
      rw [hbot, Subgroup.card_bot] at h9
      norm_num at h9
    obtain ⟨⟨b, hb⟩, hb1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
    have hb1' : b ≠ 1 := fun h1 => hb1 (Subtype.ext h1)
    have hKa : ∀ k ∈ M ⊓ Subgroup.normalizer (A : Set G), k * a = a * k := fun k hk =>
      Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer (Subgroup.mem_inf.mp hk).1)
    obtain ⟨w, hwA, hwT, hwa⟩ := exists_transv_of_irreducible h.isElemAbelian h.mem_A hAa h9
      hKa hirr inf_le_right (inf_normalizer_le_normalizer_inf A M) hWB hWa hb
    have hwb : w * b * w⁻¹ = b := congrArg Subtype.val (hwT.1 ⟨b, hb.1⟩ hb)
    have hD3 : Nat.card (Subgroup.zpowers b) = 3 :=
      card_zpowers_eq_three (h.isElemAbelian.2 b hb.1) hb1'
    have hDw : (Subgroup.zpowers b).map (MulAut.conj w).toMonoidHom = Subgroup.zpowers b := by
      rw [MonoidHom.map_zpowers]
      change Subgroup.zpowers (w * b * w⁻¹) = _
      rw [hwb]
    have haw : (Subgroup.zpowers a).map (MulAut.conj w).toMonoidHom =
        Subgroup.zpowers (a * b) := by
      rw [MonoidHom.map_zpowers]
      change Subgroup.zpowers (w * a * w⁻¹) = _
      rw [hwa]
    have hab : Subgroup.zpowers b ⊔ Subgroup.zpowers (a * b) =
        Subgroup.zpowers b ⊔ Subgroup.zpowers a := by
      apply le_antisymm
      · refine sup_le le_sup_left (Subgroup.zpowers_le.mpr (Subgroup.mul_mem _
          ((le_sup_right : Subgroup.zpowers a ≤ _) (Subgroup.mem_zpowers a))
          ((le_sup_left : Subgroup.zpowers b ≤ _) (Subgroup.mem_zpowers b))))
      · refine sup_le le_sup_left (Subgroup.zpowers_le.mpr ?_)
        have hmem : (a * b) * b⁻¹ ∈ Subgroup.zpowers b ⊔ Subgroup.zpowers (a * b) :=
          Subgroup.mul_mem _
            ((le_sup_right : Subgroup.zpowers (a * b) ≤ _) (Subgroup.mem_zpowers _))
            (Subgroup.inv_mem _ ((le_sup_left : Subgroup.zpowers b ≤ _) (Subgroup.mem_zpowers b)))
        rwa [mul_inv_cancel_right] at hmem
    have hwU : w ∈ Subgroup.normalizer
        ((Subgroup.zpowers b ⊔ Subgroup.zpowers a : Subgroup G) : Set G) ⊓
        Subgroup.normalizer (Subgroup.zpowers b : Set G) := by
      refine Subgroup.mem_inf.mpr ⟨Subgroup.mem_normalizer_iff_map_conj_eq.mpr ?_,
        Subgroup.mem_normalizer_iff_map_conj_eq.mpr hDw⟩
      have h := congrArg₂ (· ⊔ ·) hDw haw
      rw [← Subgroup.map_sup] at h
      exact h.trans hab
    have hwH := h1613 G A a M h (Subgroup.zpowers b) (Subgroup.zpowers_le.mpr hb) hD3 hwU
    have habm : a * b ∈ Subgroup.zpowers a := by
      rw [← hwa]
      exact (Subgroup.mem_normalizer_iff.mp hwH a).mp (Subgroup.mem_zpowers a)
    have hba : b ∈ Subgroup.zpowers a := by
      have : b = a⁻¹ * (a * b) := by group
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.mem_zpowers a)) habm
    have hzb := zpowers_eq_of_mem_of_ne_one h.card_zpowers hba hb1'
    exact haM ((Subgroup.zpowers_le.mpr hb.2) (hzb ▸ Subgroup.mem_zpowers a))
  · exact Or.inr hP
  · exfalso
    obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data hM12p hM12z e12
    exact KFacts.KS14.not_isoLThreePi_M12 2 n (isoLThreePi_of_mulEquiv χ hiso)
  · exfalso
    obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data hJ2p hJ2z eJ
    exact KFacts.KS14.ks17J2NotList.1 2 n (isoLThreePi_of_mulEquiv χ hiso)

theorem false_of_pgl_of_prod (hPP : KSPGLProper) {A L : Subgroup G} {c : G}
    (h : Sec13Data G A c L) (hPGL : Sec8.IsZ3PGLThreePi ↥(lBarA c L A))
    (ψ : lBarA c L A ≃* Multiplicative (ZMod 3) × Sec12.lBar c L) : False := by
  obtain ⟨π, p, f, K, _, hK, hq, ⟨φ⟩⟩ := hPGL
  have hq2 : 2 < p ^ f := by
    by_contra hle
    have h2 : p ^ f = 2 := by
      have hf : f ≠ 0 := by have := hK.one_le; omega
      have : 2 ≤ p ^ f := le_trans hK.prime.two_le (Nat.le_self_pow hf _)
      omega
    cases π
    · exact false_of_isSolvable h (isSolvable_projImage_glPi_two hK h2) φ
    · change p ^ f % 3 = 1 at hq
      omega
  obtain ⟨e⟩ := Sec13.nonempty_lBar_equiv h φ
  have hπ : π = false → CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f K :=
    fun hπ => by subst hπ; exact hK.unitary
  have hSP : projImage (Sec4.slPi π 3 (p ^ f) K) ≤ projImage (Sec4.glPi π 3 (p ^ f) K) :=
    Subgroup.map_mono (Sec4.slPi_le_glPi hπ)
  have hcPSL : Nat.card (projImage (Sec4.slPi π 3 (p ^ f) K)) = Nat.card (Sec12.lBar c L) := by
    have h1 : Nat.card (commutator ↥(projImage (Sec4.glPi π 3 (p ^ f) K))) =
        Nat.card (projImage (Sec4.slPi π 3 (p ^ f) K)) := by
      rw [commutator_projImage_glPi hK hq2]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hSP).toEquiv
    rw [← h1, Nat.card_congr e.toEquiv]
  have hcPGL : Nat.card (projImage (Sec4.glPi π 3 (p ^ f) K)) = Nat.card (Sec12.lBar c L) := by
    have h1 := Nat.card_congr ψ.toEquiv
    have h2 := Nat.card_congr φ.toEquiv
    rw [card_z3_prod] at h1 h2
    omega
  have hpos : Nat.card (projImage (Sec4.glPi π 3 (p ^ f) K)) ≠ 0 := by
    rw [hcPGL]
    exact Nat.card_pos.ne'
  have : Finite ↥(projImage (Sec4.glPi π 3 (p ^ f) K)) := Nat.finite_of_card_ne_zero hpos
  exact hPP π p f K hK hq (Subgroup.eq_of_le_of_card_ge hSP (by rw [hcPSL, hcPGL]))

theorem not_le_normalizer_of_l3 (h131 : Item131) (hPP : KSPGLProper) {A L : Subgroup G}
    {c : G} (h : Ctx169 G A c L) {n : ℕ} (hn : IsZ3LThreeTwo A c L n) {e : G} (heA : e ∈ A)
    (he1 : e ≠ 1) (hec : Subgroup.zpowers e ≠ Subgroup.zpowers c) :
    ¬ Subgroup.normalizer (A : Set G) ≤ Subgroup.normalizer (Subgroup.zpowers e : Set G) := by
  intro hWe
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨-, hiso, ⟨ψ⟩⟩ := hn
  have hcL : c ∉ L := h.toSec15R.hypS.2.2 c h.zpowers_mem_omegaA L h.mem_lA
  have hA := h.isElemAbelian
  obtain ⟨-, ⟨hM12p, hM12z⟩, ⟨hJ2p, hJ2z⟩⟩ := sporadicModels131
  rcases cases131 h131 sporadicModels131 slTwoCenter h.toSec13Data with
      ⟨-, h9, -, hcase⟩ | ⟨-, -, hMJ, -⟩ | ⟨-, hPGL, -, -⟩ | ⟨hcL', -⟩
  ·
    have hBh : IsHyperplane A (A ⊓ L) := ⟨inf_le_left, by rw [h.card_eq, h9]⟩
    have hAa : A = Subgroup.zpowers c ⊔ (A ⊓ L) :=
      le_antisymm (le_zpowers_sup_of_not_mem hBh h.mem_A fun hc => hcL hc.2)
        (sup_le (Subgroup.zpowers_le.mpr h.mem_A) inf_le_left)
    obtain ⟨τ, hτ, h4, h2⟩ := exists_order_four_of_cases hcase
    obtain ⟨ρ, hρ, hρ4, hρ2⟩ := exists_order_four_restrict h.toSec13Data hAa hτ h4 h2
    obtain ⟨l, hlB, hlLW, rfl⟩ := Sec4.mem_autIn_iff.mp hρ
    obtain ⟨hlL, hlW⟩ := Subgroup.mem_inf.mp hlLW
    have hBe : CFSG.Assembly.IsElemAbelian 3 (A ⊓ L) := isElemAbelian_of_le hA inf_le_left
    have hρ4' : (A ⊓ L).normalizerMonoidHom ⟨l, hlB⟩ * (A ⊓ L).normalizerMonoidHom ⟨l, hlB⟩ *
        ((A ⊓ L).normalizerMonoidHom ⟨l, hlB⟩ * (A ⊓ L).normalizerMonoidHom ⟨l, hlB⟩) = 1 := by
      simpa only [pow_succ, pow_zero, one_mul, mul_assoc] using hρ4
    have hρ2' : (A ⊓ L).normalizerMonoidHom ⟨l, hlB⟩ *
        (A ⊓ L).normalizerMonoidHom ⟨l, hlB⟩ ≠ 1 := by
      rw [← pow_two]
      exact hρ2
    have hinv : ∀ y ∈ A ⊓ L, l * (l * y * l⁻¹) * l⁻¹ = y⁻¹ := by
      intro y hy
      have h1 := sq_apply_eq_inv hBe h9 hρ4' hρ2' ⟨y, hy⟩
      exact congrArg Subtype.val h1
    have hlc : l * c * l⁻¹ = c := by
      rw [Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer hlL), mul_inv_cancel_right]
    have hle : l ∈ Subgroup.normalizer (Subgroup.zpowers e : Set G) := hWe hlW
    have he3 : e ^ 3 = 1 := hA.2 e heA
    have hl1 : l * e * l⁻¹ ∈ Subgroup.zpowers e :=
      (Subgroup.mem_normalizer_iff.mp hle e).mp (Subgroup.mem_zpowers e)
    have hl2 : l * (l * e * l⁻¹) * l⁻¹ ∈ Subgroup.zpowers e :=
      (Subgroup.mem_normalizer_iff.mp hle _).mp hl1
    obtain ⟨i, hi, y, hy, hey⟩ := exists_pow_mul_of_mem hA h.mem_A hAa heA
    have hyA : y ∈ A := hy.1
    have hcy : c * y = y * c := h.commute h.mem_A hyA
    have hc3 : c ^ 3 = 1 := hA.2 c h.mem_A
    have hy3 : y ^ 3 = 1 := hA.2 y hyA
    have hse : l * (l * e * l⁻¹) * l⁻¹ = c ^ i * y⁻¹ := by
      have h1 : l * (l * e * l⁻¹) * l⁻¹ = (l * l) * e * (l * l)⁻¹ := by group
      have h2 : (l * l) * c * (l * l)⁻¹ = c := by
        rw [show (l * l) * c * (l * l)⁻¹ = l * (l * c * l⁻¹) * l⁻¹ by group, hlc, hlc]
      have h3 : (l * l) * y * (l * l)⁻¹ = y⁻¹ := by
        rw [show (l * l) * y * (l * l)⁻¹ = l * (l * y * l⁻¹) * l⁻¹ by group, hinv y hy]
      rw [h1, hey, ← MulAut.conj_apply, map_mul, map_pow, MulAut.conj_apply, MulAut.conj_apply,
        h2, h3]
    have hcases : e ∈ Subgroup.zpowers c ∨ e ∈ A ⊓ L := by
      rcases eq_of_mem_zpowers_of_pow_three he3 hl2 with h0 | h0 | h0
      · exfalso
        apply he1
        have h5 : (l * l) * e * (l * l)⁻¹ = 1 := by rw [← h0]; group
        exact (MulEquiv.map_eq_one_iff (MulAut.conj (l * l))).mp h5
      ·
        left
        rw [hse, hey] at h0
        have hyy : y⁻¹ = y := mul_left_cancel h0
        have hy1 : y = 1 := by
          have h5 : y * y = y * 1 := by
            rw [mul_one]
            calc y * y = y ^ 3 * y⁻¹ := by rw [pow_succ, pow_two, mul_inv_cancel_right]
              _ = y⁻¹ := by rw [hy3, one_mul]
              _ = y := hyy
          exact mul_left_cancel h5
        rw [hey, hy1, mul_one]
        exact Subgroup.npow_mem_zpowers c i
      ·
        right
        rw [hse, hey] at h0
        have hci : c ^ i = 1 := by
          have h5 : c ^ i * y⁻¹ = c ^ (2 * i) * y ^ 2 := by
            rw [h0, (Commute.pow_left hcy i).mul_pow, ← pow_mul, mul_comm i 2]
          have h6 : c ^ i = c ^ (2 * i) * y ^ 3 := by
            calc c ^ i = c ^ i * y⁻¹ * y := by group
              _ = c ^ (2 * i) * y ^ 2 * y := by rw [h5]
              _ = c ^ (2 * i) * y ^ 3 := by rw [mul_assoc, ← pow_succ]
          rw [hy3, mul_one, two_mul, pow_add] at h6
          have h7 : c ^ i * 1 = c ^ i * c ^ i := by rw [mul_one]; exact h6
          have h8 : c ^ i = 1 := (mul_left_cancel h7).symm
          exact h8
        rw [hey, hci, one_mul]
        exact hy
    rcases hcases with hc | hL
    · exact hec (zpowers_eq_of_mem_of_ne_one h.card_zpowers hc he1)
    ·
      have hs : l * (l * e * l⁻¹) * l⁻¹ = e⁻¹ := hinv e hL
      rcases eq_of_mem_zpowers_of_pow_three he3 hl1 with h0 | h0 | h0
      · apply he1
        exact (MulEquiv.map_eq_one_iff (MulAut.conj l)).mp h0
      · rw [h0, h0] at hs
        apply he1
        have h5 : e * e = e * 1 := by
          rw [mul_one]
          calc e * e = e ^ 3 * e⁻¹ := by rw [pow_succ, pow_two, mul_inv_cancel_right]
            _ = e⁻¹ := by rw [he3, one_mul]
            _ = e := hs.symm
        exact mul_left_cancel h5
      · rw [h0] at hs
        have h6 : l * e ^ 2 * l⁻¹ = (l * e * l⁻¹) ^ 2 := by
          rw [← MulAut.conj_apply, map_pow, MulAut.conj_apply]
        rw [h6, h0, ← pow_mul, show 2 * 2 = 3 + 1 by norm_num, pow_succ, he3, one_mul] at hs
        apply he1
        have h5 : e * e = e * 1 := by
          rw [mul_one]
          calc e * e = e ^ 3 * e⁻¹ := by rw [pow_succ, pow_two, mul_inv_cancel_right]
            _ = e⁻¹ := by rw [he3, one_mul]
            _ = e := hs.symm
        exact mul_left_cancel h5
  · rcases hMJ with ⟨⟨φ⟩⟩ | ⟨⟨φ⟩⟩
    · obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data hM12p hM12z φ
      exact KFacts.KS14.not_isoLThreePi_M12 2 n (isoLThreePi_of_mulEquiv χ hiso)
    · obtain ⟨-, -, -, ⟨χ⟩⟩ := facts_of_prod h.toSec13Data hJ2p hJ2z φ
      exact KFacts.KS14.ks17J2NotList.1 2 n (isoLThreePi_of_mulEquiv χ hiso)
  · exact false_of_pgl_of_prod hPP h.toSec13Data hPGL ψ
  · exact hcL hcL'

end Certs

