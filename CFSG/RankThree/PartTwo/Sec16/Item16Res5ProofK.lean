theorem eq_bot_of_isPerfect_of_isSolvable {J : Subgroup G} (hJ : Group.IsPerfect J)
    (hs : Group.IsSolvable J) : J = ⊥ := by
  obtain ⟨n, hn⟩ := hs.solvable
  have htop : ∀ k : ℕ, derivedSeries J k = ⊤ := by
    intro k
    induction k with
    | zero => rfl
    | succ k ih =>
      rw [derivedSeries_succ, ih, ← commutator_def]
      exact hJ.commutator_eq_top
  rw [htop n] at hn
  have hsub : Subsingleton J := by
    refine ⟨fun a b => ?_⟩
    have ha : a ∈ (⊥ : Subgroup J) := hn ▸ Subgroup.mem_top a
    have hb : b ∈ (⊥ : Subgroup J) := hn ▸ Subgroup.mem_top b
    rw [Subgroup.mem_bot] at ha hb
    rw [ha, hb]
  rw [eq_bot_iff]
  intro x hx
  have h1 : (⟨x, hx⟩ : J) = 1 := Subsingleton.elim _ _
  exact Subgroup.mem_bot.mpr (congrArg Subtype.val h1)

omit [Finite G] in
theorem isSolvable_sup {X D : Subgroup G} (hDX : D ≤ Subgroup.normalizer (X : Set G))
    (hX : Group.IsSolvable X) (hD : Group.IsSolvable D) : Group.IsSolvable ↥(X ⊔ D) := by
  set Y := X ⊔ D with hY
  have hXY : X ≤ Y := le_sup_left
  have hDY : D ≤ Y := le_sup_right
  have hYN : Y ≤ Subgroup.normalizer (X : Set G) :=
    sup_le Subgroup.le_normalizer hDX
  have hnorm : (X.subgroupOf Y).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hXY).mpr hYN
  have hX' : Group.IsSolvable (X.subgroupOf Y) :=
    Group.isSolvable_of_isSolvable_injective (f := (Subgroup.subgroupOfEquivOfLe hXY).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hXY).injective
  let f : ↥D →* ↥Y ⧸ X.subgroupOf Y :=
    (QuotientGroup.mk' (X.subgroupOf Y)).comp (Subgroup.inclusion hDY)
  have hf : Function.Surjective f := by
    intro q
    obtain ⟨⟨y, hy⟩, rfl⟩ := QuotientGroup.mk'_surjective (X.subgroupOf Y) q
    have hy' : y ∈ ((X : Set G) * (D : Set G)) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left X D hDX]
      exact hy
    obtain ⟨x, hx, d, hd, rfl⟩ := hy'
    refine ⟨⟨d, hd⟩, ?_⟩
    change QuotientGroup.mk' (X.subgroupOf Y) (Subgroup.inclusion hDY ⟨d, hd⟩) =
      QuotientGroup.mk' (X.subgroupOf Y) ⟨x * d, hy⟩
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
    rw [Subgroup.mem_subgroupOf]
    have : ((Subgroup.inclusion hDY ⟨d, hd⟩)⁻¹ * ⟨x * d, hy⟩ : ↥Y) = ⟨d⁻¹ * x * d, by
      exact Y.mul_mem (Y.mul_mem (Y.inv_mem (hDY hd)) (hXY hx)) (hDY hd)⟩ := by
      apply Subtype.ext
      simp [mul_assoc]
    rw [this]
    change d⁻¹ * x * d ∈ X
    have hd' : d⁻¹ ∈ Subgroup.normalizer (X : Set G) := hDX (D.inv_mem hd)
    have := (Subgroup.mem_normalizer_iff.mp hd' x).mp hx
    simpa [mul_assoc] using this
  have hQ : Group.IsSolvable (↥Y ⧸ X.subgroupOf Y) := Group.isSolvable_of_surjective hf
  exact Group.isSolvable_of_ker_le_range (X.subgroupOf Y).subtype
    (QuotientGroup.mk' (X.subgroupOf Y)) (by rw [QuotientGroup.ker_mk', Subgroup.range_subtype])

theorem not_isSolvable_deltaZero (hLCen : KS1619LCen) {A L : Subgroup G} {c : G}
    (h : Ctx169 G A c L) (hbot : ∃ B, IsHyperplane A B ∧ lB A B = ⊥) (hLs : IsSimpleGroup ↥L)
    (hnoTwo : ∀ T ∈ invariantPiSubgroups (Subgroup.centralizer (L : Set G)) A (piOf 2), T = ⊥)
    {n : ℕ} (hz : IsZ3LThreeTwo A c L n) {Y : Subgroup G} (hY : Y ∈ scriptY1 A (lB A))
    (hns : ¬ Group.IsSolvable ↥Y) : ¬ Group.IsSolvable ↥(deltaZero A (lB A) Y) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  intro hXs
  have hA : Late.IsE27 A := h.toSec14Std.isE27
  have hAY : A ≤ Subgroup.normalizer (Y : Set G) := hY.1.1.1.2
  obtain ⟨hΔ, -, hN⟩ := rank3II_14_5_lB hA hbot hAY
  have hYΔ : Y = delta A (lB A) Y := hY.1.2
  set X := deltaZero A (lB A) Y with hX
  set D := pPrimeCoreOf 3 (Subgroup.centralizer (A : Set G)) ⊓ Y with hD
  have hY3 : ¬ 3 ∣ Nat.card Y := Sec14.not_three_dvd_of_oPrimeResidualOf_eq_bot hY.2
  have hDs : Group.IsSolvable ↥D := by
    set J := inSubgroup perfectResidual D with hJ
    have hJperf : Group.IsPerfect J :=
      CFSG.RankThree.PartOne.EmbeddingFixedResidual.isPerfect_inSubgroup_perfectResidual D
    have hJD : J ≤ D := Subgroup.map_subtype_le _
    have hJ3 : ¬ 3 ∣ Nat.card J := fun h3 =>
      hY3 (h3.trans (Subgroup.card_dvd_of_le (hJD.trans inf_le_right)))
    have hCA : Subgroup.centralizer (A : Set G) ≤ Subgroup.centralizer ({c} : Set G) :=
      Subgroup.centralizer_le (Set.singleton_subset_iff.mpr h.mem_A)
    have hJN : J ≤ Subgroup.normalizer (L : Set G) :=
      ((hJD.trans inf_le_left).trans ((pPrimeCoreOf_le 3 _).trans hCA)).trans
        (Proof1617.centralizer_le_normalizer_L h hz)
    have hJL : J ≤ Subgroup.centralizer (L : Set G) :=
      hLCen G L J n hLs hz.1 hz.2.1 hJN hJperf hJ3
    have hAC : A ≤ Subgroup.centralizer (A : Set G) :=
      Subgroup.le_centralizer_iff_isMulCommutative.mpr hA.1.1
    have hAD : A ≤ Subgroup.normalizer (D : Set G) :=
      CFSG.RankThree.PartTwo.Late.le_normalizer_inf (hAC.trans (le_normalizer_pPrimeCoreOf 3 _)) hAY
    have hAJ : A ≤ Subgroup.normalizer (J : Set G) :=
      hAD.trans (CFSG.RankThreeCoreUniqueness.Helpers.perfectResidualOf_normalizer_contains _)
    have hJbot : J = ⊥ := by
      by_contra hJ1
      have hJns : ¬ Group.IsSolvable J := fun hs =>
        hJ1 (eq_bot_of_isPerfect_of_isSolvable hJperf hs)
      have hJ2 : 2 ∣ Nat.card J := by
        by_contra h2
        exact hJns (CFSG.FeitThompson.isSolvable_of_odd_natCard _ (Nat.odd_iff.mpr (Nat.two_dvd_ne_zero.mp h2)))
      have hA3 : IsPGroup 3 A := hA.isPGroup
      obtain ⟨T, hTA, hT1⟩ :=
        CFSG.SignalizerFunctor.Helpers.normalized_subgroup_invariant_sylow_nontrivial 3 2
          Nat.prime_three Nat.prime_two A J hA3 hAJ
          ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr hJ3) hJ2
      refine hT1 (hnoTwo _ ⟨(Subgroup.map_subtype_le _).trans hJL, ?_, hTA⟩)
      exact (isPiSubgroup_piOf_iff Nat.prime_two _).mpr (T.isPGroup'.map _)
    have hres : perfectResidual ↥D = ⊥ := by
      have h0 : (perfectResidual ↥D).map D.subtype = ⊥ := hJbot
      exact (Subgroup.map_eq_bot_iff_of_injective _ D.subtype_injective).mp h0
    exact (CFSG.perfect_residual_characterization (G := ↥D)).2.2.2.2.2.mp hres
  have hDN : D ≤ Subgroup.normalizer (X : Set G) := (inf_le_right.trans hYΔ.le).trans hN
  have hYs : Group.IsSolvable ↥(X ⊔ D) := isSolvable_sup hDN hXs hDs
  have hYeq : Y = X ⊔ D := hYΔ.trans hΔ
  apply hns
  rw [hYeq]
  exact hYs

theorem exists_isComponent_of_generalizedFitting_eq {H : Type*} [Group H] [Finite H]
    (hF : generalizedFitting H = oResidual 2 H) (hns : ¬ Group.IsSolvable H) :
    ∃ K : Subgroup H, IsComponent K := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hno
  push Not at hno
  have hE : layer H = ⊥ := CFSG.LocalCores.layer_eq_bot_of_forall hno
  have hFit : oResidual 2 H = fittingSubgroup H := by
    rw [← hF, CFSG.generalizedFitting, hE, sup_bot_eq]
  have : (oResidual 2 H).Normal := Crit167.oResidual_two_normal
  have h1 : Group.IsSolvable ↥(oResidual 2 H) := by
    have : Group.IsSolvable ↥(fittingSubgroup H) := inferInstance
    exact Group.isSolvable_of_isSolvable_injective
      (f := (MulEquiv.subgroupCongr hFit).toMonoidHom) (MulEquiv.subgroupCongr hFit).injective
  have h2 : Group.IsSolvable (H ⧸ oResidual 2 H) := by
    have hp : IsPGroup 2 (H ⧸ oResidual 2 H) :=
      CFSG.RankThree.Transfer.isPGroup_quotient_of_oResidual_le (oResidual 2 H) le_rfl
    have := hp.isNilpotent
    infer_instance
  exact hns (Group.isSolvable_of_ker_le_range (oResidual 2 H).subtype
    (QuotientGroup.mk' (oResidual 2 H)) (by rw [QuotientGroup.ker_mk', Subgroup.range_subtype]))

theorem isCharacteristicP_of_mulEquiv {P Q : Type*} [Group P] [Group Q] (e : P ≃* Q) {p : ℕ}
    (h : IsCharacteristicP p P) : IsCharacteristicP p Q := by
  unfold IsCharacteristicP at h ⊢
  intro b hb
  rw [← CFSG.pCore_map_iso p e] at hb ⊢
  refine ⟨e.symm b, h ?_, by simp⟩
  rw [Subgroup.mem_centralizer_iff] at hb ⊢
  intro a ha
  have h1 := hb (e a) ⟨a, ha, rfl⟩
  apply e.injective
  simpa using h1

theorem exists_ne_of_mulEquiv {P Q : Type*} [Group P] [Group Q] (e : P ≃* Q)
    (h : ∃ a b : Q, a * b ≠ b * a) : ∃ a b : P, a * b ≠ b * a := by
  obtain ⟨a, b, hab⟩ := h
  refine ⟨e.symm a, e.symm b, fun h' => hab ?_⟩
  have := congrArg e h'
  simpa using this

theorem preimage_facts {X : Type*} [Group X] [Finite X] (hX : IsCharacteristicP 2 X)
    {J : Subgroup (X ⧸ CFSG.pCore 2 X)} (hJ : IsComponent J) (hZ : Subgroup.center J = ⊥) :
    IsCharacteristicP 2 ↥(J.comap (QuotientGroup.mk' (CFSG.pCore 2 X))) ∧
      Nonempty (↥(J.comap (QuotientGroup.mk' (CFSG.pCore 2 X))) ⧸
        CFSG.pCore 2 ↥(J.comap (QuotientGroup.mk' (CFSG.pCore 2 X))) ≃* ↥J) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set N := CFSG.pCore 2 X with hN
  set K' := J.comap (QuotientGroup.mk' N) with hK'
  have hNK' : N ≤ K' := fun x hx => by
    change QuotientGroup.mk' N x ∈ J
    rw [QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff x).mpr hx]
    exact J.one_mem
  have eZ : ↥J ≃* ↥J ⧸ Subgroup.center ↥J :=
    (QuotientGroup.quotientBot.symm).trans (QuotientGroup.quotientMulEquivOfEq hZ.symm)
  have : IsSimpleGroup (↥J ⧸ Subgroup.center ↥J) := hJ.1.2.1
  have hJs : IsSimpleGroup ↥J := eZ.isSimpleGroup
  let f : ↥K' →* ↥J :=
    ((QuotientGroup.mk' N).comp K'.subtype).codRestrict J (fun k => k.2)
  have hfapp : ∀ k : ↥K', ((f k : ↥J) : X ⧸ N) = QuotientGroup.mk' N (k : X) := fun _ => rfl
  have hfs : Function.Surjective f := by
    intro j
    obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective N (j : X ⧸ N)
    have hxK : x ∈ K' := by
      change QuotientGroup.mk' N x ∈ J
      rw [hx]
      exact j.2
    refine ⟨⟨x, hxK⟩, Subtype.ext ?_⟩
    rw [hfapp]
    exact hx
  have hfker : f.ker = N.subgroupOf K' := by
    ext k
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    constructor
    · intro hk
      have h1 : ((f k : ↥J) : X ⧸ N) = 1 := by rw [hk]; rfl
      rw [hfapp, QuotientGroup.mk'_apply] at h1
      exact (QuotientGroup.eq_one_iff _).mp h1
    · intro hk
      apply Subtype.ext
      rw [hfapp, QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff _).mpr hk]
      rfl
  have hO2 : CFSG.pCore 2 ↥K' = N.subgroupOf K' := by
    apply le_antisymm
    · rw [← hfker, ← Subgroup.map_eq_bot_iff]
      set Q := (CFSG.pCore 2 ↥K').map f with hQ
      have hQn : Q.Normal := Subgroup.Normal.map inferInstance f hfs
      have hQ2 : IsPGroup 2 Q := (CFSG.pCore_isPGroup (p := 2) (G := ↥K')).map f
      rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal Q with hQb | hQt
      · exact hQb
      · exfalso
        have hJ2 : IsPGroup 2 ↥J := by
          intro j
          obtain ⟨k, hk⟩ := hQ2 ⟨j, hQt ▸ Subgroup.mem_top j⟩
          exact ⟨k, by simpa using congrArg Subtype.val hk⟩
        have : Nontrivial ↥J := CFSG.LocalCores.isQuasisimple_nontrivial hJ.1
        have hc := hJ2.center_nontrivial
        rw [hZ] at hc
        exact (not_nontrivial_iff_subsingleton.mpr inferInstance) hc
    · refine le_sSup ⟨inferInstance, ?_⟩
      exact (CFSG.pCore_isPGroup (p := 2) (G := X)).comap_subtype (K := K')
