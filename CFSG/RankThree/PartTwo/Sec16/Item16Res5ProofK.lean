  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G) (c : G) (L : Subgroup G),
    Ctx169 G A c L → Item167 A (lB A) c L → IsSimpleGroup ↥L →
    (∀ T ∈ invariantPiSubgroups (Subgroup.centralizer (L : Set G)) A (piOf 2), T = ⊥) →
    ∀ n : ℕ, IsZ3LThreeTwo A c L n →
    ∀ Y ∈ scriptY1Star A (lB A), ¬ Group.IsSolvable ↥Y →
      ∃ K : Subgroup G, ¬ 3 ∣ Nat.card K ∧ K ≠ ⊤ ∧ A ≤ Subgroup.normalizer (K : Set G) ∧
        generalizedFitting ↥K = CFSG.pCore 2 ↥K ∧
