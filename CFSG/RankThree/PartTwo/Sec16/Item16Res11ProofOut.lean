theorem mem_omegaA_of_typeC_conj (h133 : Item133) (h138 : Item138N) {A L : Subgroup G} {c : G}
    (h : Ctx169 G A c L) {n : ℕ} (hn : IsZ3LThreeTwo A c L n) {A' : Subgroup G}
    (hA'e : CFSG.Assembly.IsElemAbelian 3 A') (hA'27 : Nat.card A' = 27)
    (hA'E : A' ∈ partTwoE G) (hcA' : c ∈ A') (hA'N : A' ≤ Subgroup.normalizer (L : Set G))
    (hsec : Late.sectionCentralizer A' L ((aschbacherSolvableCore 3 L).map L.subtype) =
      (Subgroup.zpowers c : Set G))
    (hTC : Sec4.IsTypeCOn A' L) {D : Subgroup G} (hDA' : D ≤ A') (hDAL : D ≤ A ⊓ L)
    (hD3 : Nat.card D = 3) {e : G} (heA : e ∈ A) (heL : e ∉ L) :
    Subgroup.zpowers e ∈ omegaA A := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hn1, hiso, ⟨φ⟩⟩ := hn
  have hD13 := h.toSec13Data
  obtain ⟨π, K, _, hKf, hq, ⟨ψ⟩⟩ := Sec13.exists_projImage_model hn1 hiso
  have hq2 : 2 < 2 ^ n := Sec14.L3PGL.two_lt_of_model
    (Sec6.isQuasisimple_of_mem_thetaComponentsAt h.mem_thetaComponentsAt) hKf hq ψ
  have hZ : Subgroup.center (↥L ⧸ aschbacherSolvableCore 3 ↥L) = ⊥ :=
    Sec13.center_eq_bot_of_mulEquiv ψ (Sec13.center_projImage_slPi hKf hq hq2)
  have hcL : c ∉ L := Sec13.not_mem_of_center_eq_bot hD13 hZ
  have hcA : c ∈ A := h.mem_A
  have hAe := h.isElemAbelian
  have hAL9 : Nat.card (A ⊓ L : Subgroup G) = 9 := card_inf_eq_nine hD13 (isPerfect_lBar hD13) φ
  have hAeq : A = Subgroup.zpowers c ⊔ (A ⊓ L) := eq_sup_of_card_nine hD13 hAL9 fun hc => hcL hc.2
  have hL3 : IsLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) := ⟨2, n, inferInstance, hn1, hiso⟩
  have hLc : ∀ l ∈ L, l * c = c * l := fun l hl =>
    Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer hl)
  have hTA' : HypT A' := Proof158Steps.hypT_of_mem_of_mem h.toSec15R hA'E hcA'
  obtain ⟨-, hmod9, hF138⟩ := h138 G A c L hD13 hL3 A' hcA' hA'e hA'27 hA'N hsec (Or.inr hTA') hTC
  have h9 : ¬ (2 ^ n % 9 = 1 ∨ 2 ^ n % 9 = 8) := hmod9 2 n hn1 hiso
  have hLbar9 : (Nat.card (↥L ⧸ aschbacherSolvableCore 3 ↥L)).factorization 3 = 2 :=
    Item138Proof.factorization_card_three_eq_two hn1 hiso h9
  have hL9 : (Nat.card L).factorization 3 = 2 := by
    obtain ⟨-, -, hθ3, -⟩ :=
      solvable_prime_complement_core_characterization (H := ↥L) Nat.prime_three
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (aschbacherSolvableCore 3 ↥L),
      Nat.factorization_mul (Nat.card_pos.ne') (Nat.card_pos.ne'), Finsupp.add_apply,
      Nat.factorization_eq_zero_of_not_dvd hθ3, add_zero, hLbar9]
  have hALSyl : ABGLocalTools.IsSylowOf 3 (A ⊓ L) L :=
    ABGLocalTools.isSylowOf_of_card inf_le_right (by rw [hAL9, hL9]; norm_num)
  obtain ⟨P₀, hP₀, hA'P₀⟩ := Proof156Res4.exists_invariant_sylowOf' hA'N
    (Proof1613.isPGroup_three_of_isElemAbelian hA'e)
  obtain ⟨l, hlL, hP₀eq⟩ := Proof158Steps.exists_conj_of_isSylowOf hALSyl hP₀
  have hlc : l * c * l⁻¹ = c := by rw [hLc l hlL, mul_inv_cancel_right]
  have hlN : L.map (MulAut.conj l).toMonoidHom = L :=
    map_conj_eq_of_mem_normalizer (Subgroup.le_normalizer hlL)
  have hcl : (Subgroup.zpowers c).map (MulAut.conj l).toMonoidHom = Subgroup.zpowers c := by
    rw [MonoidHom.map_zpowers]
    exact congrArg Subgroup.zpowers hlc
  set F := A.map (MulAut.conj l).toMonoidHom with hFdef
  have hFL : F ⊓ L = P₀ := by
    rw [hP₀eq, hFdef, Subgroup.map_inf_eq _ _ _ (MulAut.conj l).injective, hlN]
  have hFeq : F = Subgroup.zpowers c ⊔ P₀ := by
    rw [hFdef]
    conv_lhs => rw [hAeq]
    rw [Subgroup.map_sup, hcl, ← hP₀eq]
  have hcF : c ∈ F := hFeq ▸ Subgroup.mem_sup_left (Subgroup.mem_zpowers c)
  have hFe : CFSG.Assembly.IsElemAbelian 3 F :=
    CFSG.RankThreeEvenClassification.Helpers.isElemAbelian_map 3 _ A hAe
  have hF27 : Nat.card F = 27 := by
    rw [hFdef, Subgroup.card_map_of_injective (MulAut.conj l).injective, h.card_eq]
  have hFEL : F ≤ A' ⊔ L := by
    rw [hFeq]
    exact sup_le (Subgroup.zpowers_le.mpr (Subgroup.mem_sup_left hcA'))
      (hP₀.le.trans le_sup_right)
  have hP₀9 : Nat.card P₀ = 9 := by rw [hP₀.card_eq, hL9]; norm_num
  have hFL9 : Nat.card (F ⊓ L : Subgroup G) = 9 := by rw [hFL, hP₀9]
  have hP₀e : CFSG.Assembly.IsElemAbelian 3 P₀ := by
    rw [hP₀eq]
    exact CFSG.RankThreeEvenClassification.Helpers.isElemAbelian_map 3 _ _
      (Sec5.isElemAbelian_of_le hAe inf_le_left)
  have hfus : ∀ y ∈ F ⊓ L, y ≠ 1 → ∀ z ∈ F ⊓ L, z ≠ 1 → ∃ l ∈ L, l * y * l⁻¹ = z := by
    rw [hFL]
    intro y hy hy1 z hz hz1
    exact Proof158Cartan.exists_conj_of_elemAbelian_nine hn1 hiso h9 hP₀.le hP₀e hP₀9 hy hy1 hz
      hz1
  have hDL : D ≤ L := hDAL.trans inf_le_right
  have hDP₀ : D ≤ P₀ := by
    have hD3g : IsPGroup 3 D := (Proof1613.isPGroup_three_of_isElemAbelian hA'e).to_le hDA'
    have hsup : IsPGroup 3 (D ⊔ P₀ : Subgroup G) :=
      IsPGroup.to_sup_of_normal_right' hD3g hP₀.isPGroup (hDA'.trans hA'P₀)
    have heq := hP₀.eq_of_le (le_sup_right : P₀ ≤ D ⊔ P₀) (sup_le hDL hP₀.le) hsup
    rw [← heq]
    exact le_sup_left
  have hA'NF : A' ≤ Subgroup.normalizer (F : Set G) := by
    intro a ha
    rw [Subgroup.mem_normalizer_iff_map_conj_eq, hFeq, Subgroup.map_sup,
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hA'P₀ ha), MonoidHom.map_zpowers]
    congr 2
    have hac : a * c = c * a :=
      congrArg Subtype.val (hA'e.1.is_comm.comm ⟨a, ha⟩ ⟨c, hcA'⟩)
    change a * c * a⁻¹ = c
    rw [hac, mul_inv_cancel_right]
  obtain ⟨d, hdD, hd1, hDd⟩ := Sec5.exists_eq_zpowers_of_card_eq_prime Nat.prime_three hD3
  have hcD : c ∉ D := fun hc => hcL (hDL hc)
  have hDe : CFSG.Assembly.IsElemAbelian 3 D := Sec5.isElemAbelian_of_le hA'e hDA'
  obtain ⟨-, hB9⟩ := Sec5.isElemAbelian_sup_zpowers hDe hcD (hA'e.2 c hcA')
    (fun a ha => congrArg Subtype.val (hA'e.1.is_comm.comm ⟨a, hDA' ha⟩ ⟨c, hcA'⟩))
  rw [hD3] at hB9
  have hBF : IsHyperplane F (D ⊔ Subgroup.zpowers c) :=
    ⟨sup_le (hDP₀.trans (hFL ▸ inf_le_left)) (Subgroup.zpowers_le.mpr hcF), by
      rw [hF27, hB9]⟩
  have hFNA' : F ≤ Subgroup.normalizer (A' : Set G) :=
    le_normalizer_of_hyperplane_le hFe hA'e hBF
      (sup_le hDA' (Subgroup.zpowers_le.mpr hcA')) hA'NF
  have hFE : F ∈ partTwoE G := (map_mem_partTwoE_iff (MulAut.conj l)).mpr hD13.mem_partTwoE
  have hTF : HypT F := Proof158Steps.hypT_of_mem_of_mem h.toSec15R hFE hcF
  obtain ⟨-, hΩF⟩ := hF138 F hFEL hFe hF27 hFL9 hfus hFNA'
  obtain ⟨hΩFeq, hΩF9⟩ := hΩF (Or.inr hTF)
  have hlc' : l⁻¹ * c = c * l⁻¹ := by
    rw [inv_mul_eq_iff_eq_mul, ← mul_assoc, hLc l hlL, mul_inv_cancel_right]
  obtain ⟨hΩA', hΩA9'⟩ := Proof158Steps.omegaA_map_conj_of_commute hlc' hΩFeq
  have hFA : F.map (MulAut.conj l⁻¹).toMonoidHom = A := by
    rw [hFdef, Late.map_conj_map_conj, inv_mul_cancel, Late.map_conj_one]
  rw [hFA] at hΩA' hΩA9'
  rw [hΩF9] at hΩA9'
  have hTA : HypT A := Proof158Steps.hypT_of_mem_of_mem h.toSec15R hD13.mem_partTwoE hcA
  rcases h133 G A c L hD13 (Or.inr hTA) with hW | ⟨-, -, h3, -⟩ |
      ⟨-, hWAL, -, -, -, -, -, -, -⟩ | hPGL | ⟨⟨e12⟩⟩ | ⟨⟨eJ⟩⟩
  ·
    exfalso
    have hsub : omegaA A ⊆ {Subgroup.zpowers c} := by
      intro X hX
      rw [hΩA'] at hX
      obtain ⟨w, hw, rfl⟩ := hX
      exact map_conj_eq_of_mem_normalizer (hW hw)
    have := Set.ncard_le_ncard hsub (Set.toFinite _)
    rw [Set.ncard_singleton, hΩA9'] at this
    omega
  · exfalso
    rw [h3] at hΩA9'
    omega
  · exact mem_omegaA_of_orbit hAe hcA hcL hAeq hAL9 hWAL hΩA' hΩA9' heA heL
  · exact (Proof1514.false_of_prod_of_isZ3PGLThreePi hD13 hcL ⟨φ⟩ hPGL).elim
  · exfalso
    obtain ⟨η, -⟩ := exists_lBarEquiv h.mem_thetaComponentsAt
    have h1 := Nat.card_congr e12.toEquiv
    rw [← Nat.card_congr φ.symm.toEquiv, Proof1613.card_z3_prod, Proof1613.card_z3_prod,
      ← Nat.card_congr η.toEquiv, KFacts.KS14.card_nativeM12] at h1
    have h27 : ¬ 3 ^ 3 ∣ Nat.card (↥L ⧸ aschbacherSolvableCore 3 ↥L) := by
      rw [Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_three Nat.card_pos.ne', hLbar9]
      norm_num
    apply h27
    rw [show Nat.card (↥L ⧸ aschbacherSolvableCore 3 ↥L) = 95040 by omega]
    norm_num
  · exfalso
    obtain ⟨η, -⟩ := exists_lBarEquiv h.mem_thetaComponentsAt
    have h1 := Nat.card_congr eJ.toEquiv
    rw [← Nat.card_congr φ.symm.toEquiv, Proof1613.card_z3_prod, Proof1613.card_z3_prod,
      ← Nat.card_congr η.toEquiv, KFacts.KS14.card_nativeJ2] at h1
    have h27 : ¬ 3 ^ 3 ∣ Nat.card (↥L ⧸ aschbacherSolvableCore 3 ↥L) := by
      rw [Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_three Nat.card_pos.ne', hLbar9]
      norm_num
    apply h27
    rw [show Nat.card (↥L ⧸ aschbacherSolvableCore 3 ↥L) = 604800 by omega]
    norm_num

