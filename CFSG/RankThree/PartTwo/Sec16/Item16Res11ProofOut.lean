theorem isTypeCOn_of_not_le_theta (h41 : Sec4.Item4_1LargePrime) {A L : Subgroup G} {c : G}
    (h : Ctx169 G A c L) {n : ℕ} (hn1 : 1 ≤ n)
    (hiso : Sec4.IsoLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) 2 n)
    (h9 : ¬ (2 ^ n % 9 = 1 ∨ 2 ^ n % 9 = 8)) {A' : Subgroup G}
    (hA'e : CFSG.Assembly.IsElemAbelian 3 A') (hA'27 : Nat.card A' = 27)
    (hA'max : ∀ B : Subgroup G, CFSG.Assembly.IsElemAbelian 3 B → A' ≤ B → B = A')
    (hcA' : c ∈ A') (hc1 : c ≠ 1) (hA'C : A' ≤ Subgroup.centralizer ({c} : Set G))
    (hA'N : A' ≤ Subgroup.normalizer (L : Set G))
    (hsec : Late.sectionCentralizer A' L ((aschbacherSolvableCore 3 L).map L.subtype) =
      (Subgroup.zpowers c : Set G))
    {d : G} (hdA' : d ∈ A') (hdL : d ∈ L) (hd1 : d ≠ 1) {T : Subgroup G}
    (hT : T ∈ invariantPiSubgroups L A' (piOf 2)) (hTD : T = ⁅T, Subgroup.zpowers d⁆)
    (hTθ : ¬ T ≤ inSubgroup (aschbacherSolvableCore 3) L) :
    Sec4.IsTypeCOn A' L := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hTL, hT2', hA'T⟩ := hT
  have hT2 : IsPGroup 2 T := (isPiSubgroup_piOf_iff Nat.prime_two T).mp hT2'
  have hT3 : ¬ 3 ∣ Nat.card T :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp (coprime_three_of_isPGroup_two hT2)
  have hd3 : d ^ 3 = 1 := hA'e.2 d hdA'
  have hDL : Subgroup.zpowers d ≤ L := Subgroup.zpowers_le.mpr hdL
  have hfin : ⁅T, Subgroup.zpowers d⁆ ≤ inSubgroup (aschbacherSolvableCore 3) L → False :=
    fun hle => hTθ (hTD ▸ hle)
  have hA'c : ∀ x ∈ A', ∀ y ∈ A', x * y = y * x := fun x hx y hy =>
    congrArg Subtype.val (hA'e.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)
  have hA'p : IsPGroup 3 A' := fun g => ⟨1, Subtype.ext (by simpa using hA'e.2 g g.2)⟩
  have hG4 := h.toTheoremFourHyp
  have hLA' : L ⊔ A' ≠ ⊤ := fun htop =>
    Sec6.centralizer_ne_top_of_ne_one hG4 hc1
      (eq_top_iff.mpr (htop ▸ sup_le h.le_centralizer hA'C))
  have hΛ : SectionFourHyp ↥(L ⊔ A') := hG4.sectionFourHyp hLA'
  obtain ⟨Φ₀, hΦ₀⟩ := Sec21.Item211Proof.exists_lEquiv hA'N
  have hq : IsQuasisimple (↥L ⧸ aschbacherSolvableCore 3 ↥L) :=
    Sec6.isQuasisimple_of_mem_thetaComponentsAt h.mem_thetaComponentsAt
  have hX := Sec21.Item211Proof.sectionFourHyp_quotX h41 hΛ hA'p hA'N Φ₀ hq
  have hq₁ : IsQuasisimple (Sec21.Item211Proof.lOne L A') :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv Φ₀ hq
  have hmax := Sec21.Item211Proof.maximal_aOne (L := L) hA'e hA'max
  have hcard₁ : Nat.card (Sec21.Item211Proof.aOne L A') = 27 := by
    rw [← Nat.card_congr (Sec21.Item211Proof.aEquiv (L := L) hA'p).toEquiv, hA'27]
  have hc₁ : orderOf (Sec21.Item211Proof.piX L A' ⟨c, Subgroup.mem_sup_right hcA'⟩) = 3 := by
    have h1 : (Sec21.Item211Proof.piX L A' ⟨c, Subgroup.mem_sup_right hcA'⟩) =
        ((Sec21.Item211Proof.aEquiv (L := L) hA'p ⟨c, hcA'⟩ : Sec21.Item211Proof.aOne L A') :
          Sec21.Item211Proof.QuotX L A') := rfl
    rw [h1, Subgroup.orderOf_coe, MulEquiv.orderOf_eq, Subgroup.orderOf_mk]
    exact orderOf_eq_prime (hA'e.2 c hcA') hc1
  have hCA' : A' ⊓ Sec4.thetaQuotCentralizer L = Subgroup.zpowers c := by
    have hset := Sec13.sectionCentralizer_eq_inf hA'N
    rw [hsec] at hset
    exact SetLike.coe_injective hset.symm
  have hCA₁ := Sec21.Item211Proof.aOne_inf_centralizer hA'p hA'N hcA' hCA'
  have hL₁ : ∃ (p e : ℕ) (_ : Fact p.Prime), 1 ≤ e ∧
      Sec4.IsoLThreePi ↥(Sec21.Item211Proof.lOne L A') p e :=
    ⟨2, n, inferInstance, hn1, Sec8.Item82OneProof.isoLThreePi_of_mulEquiv Φ₀.symm hiso⟩
  rcases Sec4.rank3II_4_12 (Sec21.Item211Proof.QuotX L A') hX (Sec21.Item211Proof.lOne L A')
      (Sec21.Item211Proof.normal_lOne hA'N) hL₁ hq₁ (Sec21.Item211Proof.aOne L A') hmax
      (by omega) _ hc₁ hCA₁ with ⟨-, hsup, -⟩ | ⟨-, hTC'⟩ | ⟨-, ⟨a₁, ha₁, ha₁3⟩, -⟩ | ⟨h81, -⟩
  ·
    exfalso
    have hA'Lc := Sec21.Item2130Res5Proof.le_sup_zpowers_of_sup_eq hA'p hA'N hcA' hsup
    have hcN : Subgroup.zpowers c ≤ Subgroup.normalizer (L : Set G) :=
      Subgroup.zpowers_le.mpr (hA'N hcA')
    set E := A' ⊓ L with hEdef
    have hEe : CFSG.Assembly.IsElemAbelian 3 E := Sec5.isElemAbelian_of_le hA'e inf_le_left
    have hA'E : A' ≤ E ⊔ Subgroup.zpowers c := by
      intro a ha
      have ha' : a ∈ (Subgroup.zpowers c : Set G) * (L : Set G) := by
        rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ hcN, sup_comm]
        exact hA'Lc ha
      obtain ⟨w, hw, l, hl, rfl⟩ := Set.mem_mul.mp ha'
      have hwA : w ∈ A' := (Subgroup.zpowers_le.mpr hcA') hw
      have hlA : l ∈ A' := by
        have : l = w⁻¹ * (w * l) := by group
        rw [this]
        exact A'.mul_mem (A'.inv_mem hwA) ha
      rw [hA'c w hwA l hlA]
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_left ⟨hlA, hl⟩) (Subgroup.mem_sup_right hw)
    have hE9 : 9 ≤ Nat.card E := by
      have hcard := (CFSG.GroupTheory.card_sup_mul_card_inf_of_commute E (Subgroup.zpowers c)
        (fun a ha b hb => hA'c a ha.1 b ((Subgroup.zpowers_le.mpr hcA') hb))).1
      have h1 : 27 ≤ Nat.card (E ⊔ Subgroup.zpowers c : Subgroup G) :=
        hA'27 ▸ Subgroup.card_le_of_le hA'E
      have h2 : 1 ≤ Nat.card (E ⊓ Subgroup.zpowers c : Subgroup G) := Nat.card_pos
      rw [Nat.card_zpowers, orderOf_eq_prime (hA'e.2 c hcA') hc1] at hcard
      nlinarith
    apply hfin
    refine Proof1613Fix.commutator_le_theta_of hTL hDL hEe hE9 (inf_le_left.trans hA'T) hT3 ?_
    intro F hFE hF3 _
    obtain ⟨z, hzF, hz1, -⟩ := Sec5.exists_eq_zpowers_of_card_eq_prime Nat.prime_three hF3
    have hzE : z ∈ E := hFE hzF
    have hzN : z ∈ Subgroup.normalizer (L : Set G) := Subgroup.le_normalizer hzE.2
    refine (inf_le_inf_left _ (Subgroup.centralizer_le
      (Set.singleton_subset_iff.mpr hzF))).trans ?_
    exact Proof1613Fix.inf_centralizer_le_theta hzN hTL hT2
      (Proof1613Fix.fix_of_not_modNine hzE.2 (hA'e.2 z hzE.1) hz1 hn1 hiso h9 hzN)
  · exact Sec21.Item211Proof.isTypeCOn_of_lOne hA'N hΦ₀ hTC'
  ·
    exfalso
    obtain ⟨a, haA', rfl⟩ := Sec21.Item211Proof.exists_eq_piX_of_mem_aOne ha₁
    have ha3 := Sec21.Item2130Res5Proof.inducesTypeOn_of_lOne hA'N hΦ₀ haA' ha₁3
    have ha3' : a ^ 3 = 1 := hA'e.2 a haA'
    have had : a * d = d * a := hA'c a haA' d hdA'
    have haL : a ∉ L := Proof1613Fix.not_mem_of_inducesTypeOn_three h.mem_thetaComponentsAt ha3
    have haD : a ∉ Subgroup.zpowers d := fun hmem => haL (hDL hmem)
    set E := Subgroup.zpowers a ⊔ Subgroup.zpowers d with hEdef
    have hEA' : E ≤ A' := sup_le (Subgroup.zpowers_le.mpr haA') (Subgroup.zpowers_le.mpr hdA')
    have hEe : CFSG.Assembly.IsElemAbelian 3 E := Sec5.isElemAbelian_of_le hA'e hEA'
    have hE9 : Nat.card E = 9 := by
      rw [hEdef, sup_comm]
      exact Sec4.card_zpowers_sup_zpowers ha3' (orderOf_eq_prime hd3 hd1) haD had
    apply hfin
    refine Proof1613Fix.commutator_le_theta_of hTL hDL hEe hE9.ge (hEA'.trans hA'T) hT3 ?_
    intro F hFE hF3 hFD
    obtain ⟨j, hjF⟩ := Proof1613Fix.exists_mul_zpow_mem ha3' had hFE hF3 hFD hd3
    have hzN : a * d ^ j ∈ Subgroup.normalizer (L : Set G) :=
      Subgroup.mul_mem _ (hA'N haA') (Subgroup.zpow_mem _ (Subgroup.le_normalizer hdL) j)
    refine (inf_le_inf_left _ (Subgroup.centralizer_le
      (Set.singleton_subset_iff.mpr hjF))).trans ?_
    exact Proof1613Fix.inf_centralizer_le_theta hzN hTL hT2
      (Proof1613Fix.fix_of_type3 hdL hd3 hd1 had ha3 j hzN)
  · omega

theorem not_odd_of_isZ3LThreeTwo (h41 : Sec4.Item4_1LargePrime) (h133 : Item133)
    (h138 : Item138N) (hInv : KS1613Inv) {A L : Subgroup G} {c : G} (h : Ctx169 G A c L)
    (h11 : Concl1611 A c L) {n : ℕ} (hn : IsZ3LThreeTwo A c L n) {D : Subgroup G}
    (hDAL : D ≤ A ⊓ L) (hD3 : Nat.card D = 3)
    (hU : ¬ Subgroup.normalizer ((D ⊔ Subgroup.zpowers c : Subgroup G) : Set G) ⊓
        Subgroup.normalizer (D : Set G) ≤ Subgroup.normalizer (Subgroup.zpowers c : Set G))
    {S : Subgroup G} (hS : S ∈ scriptQPiStar A (lB A) ⊤ (piOf 2)) {e : G}
    (heB : e ∈ D ⊔ Subgroup.zpowers c) (heD : e ∉ D) (heΩ : Subgroup.zpowers e ∉ omegaA A)
    (hT1 : ⁅inSubgroup (CFSG.pCore 2) (Subgroup.normalizer (S : Set G)) ⊓
        Subgroup.centralizer ({e} : Set G), D⁆ ≠ ⊥) :
    ¬ Odd (Nat.card (pPrimeCoreOf 3 (Subgroup.centralizer ({e} : Set G)))) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨d, hdD, hd1, rfl⟩ := Sec5.exists_eq_zpowers_of_card_eq_prime Nat.prime_three hD3
  obtain ⟨x, hx, hxH⟩ := IsConcreteLE.not_le_iff_exists.mp hU
  have hD13 := h.toSec13Data
  obtain ⟨π, K, _, hKf, hq, ⟨ψ⟩⟩ := Sec13.exists_projImage_model hn.1 hn.2.1
  have hq2 : 2 < 2 ^ n := Sec14.L3PGL.two_lt_of_model
    (Sec6.isQuasisimple_of_mem_thetaComponentsAt h.mem_thetaComponentsAt) hKf hq ψ
  have hZ : Subgroup.center (↥L ⧸ aschbacherSolvableCore 3 ↥L) = ⊥ :=
    Sec13.center_eq_bot_of_mulEquiv ψ (Sec13.center_projImage_slPi hKf hq hq2)
  have hcL : c ∉ L := Sec13.not_mem_of_center_eq_bot hD13 hZ
  have hAL9 : Nat.card (A ⊓ L : Subgroup G) = 9 :=
    card_inf_eq_nine hD13 (isPerfect_lBar hD13) hn.2.2.some
  have hdA : d ∈ A := (hDAL hdD).1
  have hdL : d ∈ L := (hDAL hdD).2
  have hcA : c ∈ A := h.mem_A
  have hc3 : c ^ 3 = 1 := h.isElemAbelian.2 c hcA
  have hd3 : d ^ 3 = 1 := h.isElemAbelian.2 d hdA
  have hcd : c * d = d * c := h.commute hcA hdA
  have hcD : c ∉ Subgroup.zpowers d := fun hc => hcL ((Subgroup.zpowers_le.mpr hdL) hc)
  have hc1 : c ≠ 1 := fun h1 => hcL (h1 ▸ L.one_mem)
  obtain ⟨t, htL, ht⟩ := hInv G A c L h h11 (Subgroup.zpowers d) hDAL hD3
  have htd : t * d * t⁻¹ = d⁻¹ := ht d (Subgroup.mem_zpowers d)
  have htc : t * c * t⁻¹ = c := by
    rw [Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer htL), mul_inv_cancel_right]
  obtain ⟨u, huU, heu⟩ := exists_conj_eq_zpowers hcd hc3 hd3 hcD hx hxH htc htd heB heD
  have hBA : Subgroup.zpowers d ⊔ Subgroup.zpowers c ≤ A :=
    sup_le (Subgroup.zpowers_le.mpr hdA) (Subgroup.zpowers_le.mpr hcA)
  have heA : e ∈ A := hBA heB
  have heL : e ∉ L := by
    intro heL
    obtain ⟨i, j, hij⟩ := Sec4.exists_zpow_mul_of_mem_sup hcd.symm heB
    have hcj : c ^ j ∈ L := by
      have h1 : c ^ j = (d ^ i)⁻¹ * e := by rw [hij]; group
      rw [h1]
      exact L.mul_mem (L.inv_mem (L.zpow_mem hdL i)) heL
    by_cases hcj1 : c ^ j = 1
    · apply heD
      rw [hij, hcj1, mul_one]
      exact Subgroup.zpow_mem_zpowers d i
    · have h1 := zpowers_eq_of_mem_of_ne_one h.card_zpowers (Subgroup.zpow_mem_zpowers c j) hcj1
      apply hcL
      have hcmem : c ∈ Subgroup.zpowers (c ^ j) := h1 ▸ Subgroup.mem_zpowers c
      exact (Subgroup.zpowers_le.mpr hcj) hcmem
  set N := Subgroup.normalizer (S : Set G) with hN
  set R := inSubgroup (CFSG.pCore 2) N with hR
  have hR2 : IsPGroup 2 R := CFSG.pCore_isPGroup.map _
  have hAS : A ≤ N := hS.prop.1.1.1.2.2
  have hNR : N ≤ Subgroup.normalizer (R : Set G) :=
    Subgroup.le_normalizer.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic (CFSG.pCore 2 N))
  have hDA : Subgroup.zpowers d ≤ A := hDAL.trans inf_le_left
  obtain ⟨hTmem, hTD, -⟩ :=
    commutator_inf_centralizer_mem h.isElemAbelian hDA hR2 (hAS.trans hNR) heA
  set T := ⁅R ⊓ Subgroup.centralizer ({e} : Set G), Subgroup.zpowers d⁆ with hTdef
  have hT2 : IsPGroup 2 T := (isPiSubgroup_piOf_iff Nat.prime_two T).mp hTmem.2.1
  intro hodd
  have hoddc : Odd (Nat.card (pPrimeCoreOf 3 (Subgroup.centralizer ({c} : Set G)))) := by
    rwa [card_pPrimeCoreOf_centralizer_eq heu] at hodd
  set g := u⁻¹ with hg
  have hgD : (Subgroup.zpowers d).map (MulAut.conj g).toMonoidHom = Subgroup.zpowers d :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (inv_mem (Subgroup.mem_inf.mp huU).2)
  have hguc : g * (u * c * u⁻¹) * g⁻¹ = c := by rw [hg]; group
  have hucA : u * c * u⁻¹ ∈ A := by
    have h1 : u * c * u⁻¹ ∈ Subgroup.zpowers e := heu ▸ Subgroup.mem_zpowers _
    exact (Subgroup.zpowers_le.mpr heA) h1
  set A' := A.map (MulAut.conj g).toMonoidHom with hA'def
  have hcA' : c ∈ A' := ⟨u * c * u⁻¹, hucA, hguc⟩
  have hA'e : CFSG.Assembly.IsElemAbelian 3 A' :=
    CFSG.RankThreeEvenClassification.Helpers.isElemAbelian_map 3 _ A h.isElemAbelian
  have hA'27 : Nat.card A' = 27 := by
    rw [hA'def, Subgroup.card_map_of_injective (MulAut.conj g).injective, h.card_eq]
  have hA'max : ∀ B : Subgroup G, CFSG.Assembly.IsElemAbelian 3 B → A' ≤ B → B = A' := by
    intro B hB hA'B
    have h1 : A ≤ B.map (MulAut.conj g⁻¹).toMonoidHom := by
      have h2 := Subgroup.map_mono (f := (MulAut.conj g⁻¹).toMonoidHom) hA'B
      rwa [hA'def, Late.map_conj_map_conj, inv_mul_cancel, Late.map_conj_one] at h2
    have h2 := h.mem_partTwoF.2.1 _
      (CFSG.RankThreeEvenClassification.Helpers.isElemAbelian_map 3 _ B hB) h1
    have h3 := congrArg (fun X : Subgroup G => X.map (MulAut.conj g).toMonoidHom) h2
    rwa [Late.map_conj_map_conj, mul_inv_cancel, Late.map_conj_one] at h3
  have hDA' : Subgroup.zpowers d ≤ A' := by
    rw [← hgD]
    exact Subgroup.map_mono hDA
  have hA'C : A' ≤ Subgroup.centralizer ({c} : Set G) := fun y hy =>
    Subgroup.mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (hA'e.1.is_comm.comm ⟨y, hy⟩ ⟨c, hcA'⟩))
  have hA'N : A' ≤ Subgroup.normalizer (L : Set G) :=
    hA'C.trans (centralizer_le_normalizer_L h.toSec14Std)
  set T' := T.map (MulAut.conj g).toMonoidHom with hT'def
  have hT'D : T' = ⁅T', Subgroup.zpowers d⁆ := by
    rw [hT'def]
    conv_lhs => rw [hTD]
    rw [Subgroup.map_commutator, hgD]
  have hTe : T ≤ Subgroup.centralizer ({u * c * u⁻¹} : Set G) := by
    rw [← Sec13.centralizer_singleton_eq_of_zpowers_eq heu]
    exact hTmem.1
  have hT'C : T' ≤ Subgroup.centralizer ({c} : Set G) := by
    rintro _ ⟨y, hy, rfl⟩
    have hy' := Subgroup.mem_centralizer_singleton_iff.mp (hTe hy)
    rw [Subgroup.mem_centralizer_singleton_iff]
    change g * y * g⁻¹ * c = c * (g * y * g⁻¹)
    rw [← hguc]
    calc g * y * g⁻¹ * (g * (u * c * u⁻¹) * g⁻¹) = g * (y * (u * c * u⁻¹)) * g⁻¹ := by group
      _ = g * ((u * c * u⁻¹) * y) * g⁻¹ := by rw [hy']
      _ = g * (u * c * u⁻¹) * g⁻¹ * (g * y * g⁻¹) := by group
  have hT'L : T' ≤ L := by
    rw [hT'D, Subgroup.commutator_le]
    intro t' ht' d' hd'
    have hNK : t' ∈ Subgroup.normalizer (L : Set G) :=
      centralizer_le_normalizer_L h.toSec14Std (hT'C ht')
    have hd'L : d' ∈ L := (Subgroup.zpowers_le.mpr hdL) hd'
    rw [commutatorElement_def]
    exact L.mul_mem ((Subgroup.mem_normalizer_iff.mp hNK d').mp hd'L) (L.inv_mem hd'L)
  have hT'2 : IsPGroup 2 T' := hT2.map _
  have hT'1 : T' ≠ ⊥ := fun hbot =>
    hT1 ((Subgroup.map_eq_bot_iff_of_injective _ (MulAut.conj g).injective).mp hbot)
  have hA'T' : A' ≤ Subgroup.normalizer (T' : Set G) := by
    have h1 := Subgroup.map_mono (f := (MulAut.conj g).toMonoidHom) hTmem.2.2
    rwa [Subgroup.map_equiv_normalizer_eq] at h1
  by_cases hT'θ : T' ≤ inSubgroup (aschbacherSolvableCore 3) L
  ·
    have hTO : T' ≤ pPrimeCoreOf 3 (Subgroup.centralizer ({c} : Set G)) :=
      (hT'θ.trans (Sec21.theta_le_theta_centralizer h.mem_thetaComponentsAt)).trans
        (thetaCen_le_pPrimeCoreOf c)
    exact not_odd_of_le hTO hT'2 hT'1 hoddc
  ·
    have hYAL : CFSG.Assembly.IsElemAbelian 3 (A ⊓ L) :=
      Sec5.isElemAbelian_of_le h.isElemAbelian inf_le_left
    have hsec := sectionCentralizer_eq_zpowers hA'e hA'27 hA'max hcA' hc1 h.le_centralizer hA'N
      hZ hDA' hDAL hD3 inf_le_right hYAL hAL9
    have h9 := Sec15.not_modNine_of_inner h.toSec15R h138 KFacts.kSL3PiOrder3TypeC hn.1 hn.2.1
      hn.2.2
    have hTC := isTypeCOn_of_not_le_theta h41 h hn.1 hn.2.1 h9 hA'e hA'27 hA'max hcA' hc1 hA'C
      hA'N hsec (hDA' (Subgroup.mem_zpowers d)) hdL hd1
      ⟨hT'L, (isPiSubgroup_piOf_iff Nat.prime_two T').mpr hT'2, hA'T'⟩ hT'D hT'θ
    have hA'E : A' ∈ partTwoE G := ⟨hA'e, hA'27, T', hT'1, hT'2, hA'T'⟩
    exact heΩ (mem_omegaA_of_typeC_conj h133 h138 h hn hA'e hA'27 hA'E hcA' hA'N hsec hTC hDA'
      hDAL hD3 heA heL)

end Certs

