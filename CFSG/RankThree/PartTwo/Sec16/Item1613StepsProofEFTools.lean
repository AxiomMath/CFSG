variable {G : Type} [Group G] [Finite G]

section Act

variable {L : Subgroup G}

theorem act_mul {q₁ q₂ : G} (h₁ : q₁ ∈ Subgroup.normalizer (L : Set G))
    (h₂ : q₂ ∈ Subgroup.normalizer (L : Set G)) :
    thetaQuotMulAut L (L.normalizerMonoidHom ⟨q₁ * q₂, Subgroup.mul_mem _ h₁ h₂⟩) =
      thetaQuotMulAut L (L.normalizerMonoidHom ⟨q₁, h₁⟩) *
        thetaQuotMulAut L (L.normalizerMonoidHom ⟨q₂, h₂⟩) := by
  rw [show (⟨q₁ * q₂, Subgroup.mul_mem _ h₁ h₂⟩ : Subgroup.normalizer (L : Set G)) =
    ⟨q₁, h₁⟩ * ⟨q₂, h₂⟩ from rfl, map_mul, map_mul]

theorem act_inner {l : G} (hl : l ∈ L) (hlN : l ∈ Subgroup.normalizer (L : Set G)) :
    thetaQuotMulAut L (L.normalizerMonoidHom ⟨l, hlN⟩) =
      MulAut.conj (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥L) ⟨l, hl⟩) := by
  ext v
  induction v using QuotientGroup.induction_on with
  | H m =>
    rw [thetaQuotMulAut_mk, MulAut.conj_apply, QuotientGroup.mk'_apply, ← QuotientGroup.mk_mul,
      ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
    congr 1

end Act

section Acts

variable {X : Type*} [Group X] {K : Type} [Field K] {H : Subgroup (GL (Fin 3) K)}
  (e : X ≃* projImage H)

theorem acts_mul {σ₁ σ₂ : MulAut X} {m₁ m₂ : GL (Fin 3) K}
    (h₁ : ∀ u, ((e (σ₁ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m₁ * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m₁)⁻¹)
    (h₂ : ∀ u, ((e (σ₂ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m₂ * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m₂)⁻¹) :
    ∀ u, ((e ((σ₁ * σ₂) u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk (m₁ * m₂) * (e u : ProjGenLinGroup (Fin 3) K) *
        (ProjGenLinGroup.mk (m₁ * m₂))⁻¹ := by
  intro u
  rw [MulAut.mul_apply, h₁, h₂, map_mul]
  group

theorem acts_zpow {σ : MulAut X} {m : GL (Fin 3) K}
    (h : ∀ u, ((e (σ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m)⁻¹)
    (j : ℕ) :
    ∀ u, ((e ((σ ^ j) u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk (m ^ j) * (e u : ProjGenLinGroup (Fin 3) K) *
        (ProjGenLinGroup.mk (m ^ j))⁻¹ := by
  induction j with
  | zero => intro u; simp
  | succ j ih =>
    intro u
    rw [pow_succ, acts_mul e ih h u, ← pow_succ]

theorem acts_inv {σ : MulAut X} {m : GL (Fin 3) K}
    (h : ∀ u, ((e (σ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m)⁻¹) :
    ∀ u, ((e (σ⁻¹ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m⁻¹ * (e u : ProjGenLinGroup (Fin 3) K) *
        (ProjGenLinGroup.mk m⁻¹)⁻¹ := by
  intro u
  have h1 := h (σ⁻¹ u)
  rw [MulAut.apply_inv_self] at h1
  rw [map_inv, inv_inv]
  calc ((e (σ⁻¹ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      (ProjGenLinGroup.mk m)⁻¹ * (ProjGenLinGroup.mk m *
        (e (σ⁻¹ u) : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m)⁻¹) *
        ProjGenLinGroup.mk m := by group
    _ = (ProjGenLinGroup.mk m)⁻¹ * (e u : ProjGenLinGroup (Fin 3) K) * ProjGenLinGroup.mk m := by
        rw [← h1]

theorem acts_zpow' {σ : MulAut X} {m : GL (Fin 3) K}
    (h : ∀ u, ((e (σ u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m)⁻¹)
    (j : ℤ) :
    ∀ u, ((e ((σ ^ j) u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk (m ^ j) * (e u : ProjGenLinGroup (Fin 3) K) *
        (ProjGenLinGroup.mk (m ^ j))⁻¹ := by
  rcases Int.eq_nat_or_neg j with ⟨n, rfl | rfl⟩
  · simp only [zpow_natCast]
    exact acts_zpow e h n
  · simp only [zpow_neg, zpow_natCast]
    exact acts_inv e (acts_zpow e h n)

theorem acts_conj {v : X} {m : GL (Fin 3) K}
    (hv : ((e v : projImage H) : ProjGenLinGroup (Fin 3) K) = ProjGenLinGroup.mk m) :
    ∀ u, ((e (MulAut.conj v u) : projImage H) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m)⁻¹ := by
  intro u
  rw [MulAut.conj_apply, map_mul, map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_mul,
    Subgroup.coe_inv, hv]

end Acts

section Unique

variable {X : Type*} [Group X] {K : Type} [Field K] {π : Bool} {p f : ℕ}

theorem acts_unique (hK : PiField π p f K) (hq : ModThree π (p ^ f))
    [Group.IsPerfect (projImage (slPi π 3 (p ^ f) K))]
    (e : X ≃* projImage (slPi π 3 (p ^ f) K)) {σ : MulAut X} {m₁ m₂ : GL (Fin 3) K}
    (h₁ : ∀ u, ((e (σ u) : projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m₁ * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m₁)⁻¹)
    (h₂ : ∀ u, ((e (σ u) : projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) =
      ProjGenLinGroup.mk m₂ * (e u : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk m₂)⁻¹) :
    ProjGenLinGroup.mk m₁ = ProjGenLinGroup.mk m₂ := by
  obtain ⟨κ, hκ⟩ := Sec12.KS128NotHJTC.exists_scalar_of_conj_eq hK hq (P := m₁) (Q := m₂)
    fun m hm => by
      set u := e.symm ⟨ProjGenLinGroup.mk m, Subgroup.mem_map_of_mem _ hm⟩ with hu
      have heu : (e u : ProjGenLinGroup (Fin 3) K) = ProjGenLinGroup.mk m := by
        rw [hu, MulEquiv.apply_symm_apply]
      rw [← heu, ← h₁, ← h₂]
  rw [hκ, map_mul, mk_eq_one_iff_mem_statedScalars.mpr ⟨κ, rfl⟩, one_mul]

end Unique

section TypeOne

theorem exists_type_one_lift {L : Subgroup G} {d x : G} (hdL : d ∈ L) (hd3 : d ^ 3 = 1)
    (hd1 : d ≠ 1) (hxd : x * d = d * x) (hxN : x ∈ Subgroup.normalizer (L : Set G))
    {π : Bool} {p f : ℕ} {K : Type} [Field K] (hK : PiField π p f K) (hq : ModThree π (p ^ f))
    (e : ↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* projImage (slPi π 3 (p ^ f) K))
    {y : GL (Fin 3) K} (hy3 : Type123 π (p ^ f) K y 3)
    (hact : ∀ z : ↥L ⧸ aschbacherSolvableCore 3 ↥L,
      ((e (thetaQuotMulAut L (L.normalizerMonoidHom ⟨x, hxN⟩) z) :
        projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) =
          ProjGenLinGroup.mk y * (e z : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk y)⁻¹) :
    ∃ s ∈ slPi π 3 (p ^ f) K, ProjGenLinGroup.mk s =
      ((e (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥L) ⟨d, hdL⟩) :
        projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) ∧
      ∃ (τ : K) (hτ : τ ^ 3 = 1), τ ≠ 1 ∧ ∃ z₀ ∈ zPi π 3 (p ^ f) K,
        ∃ g ∈ glPi π 3 (p ^ f) K, g⁻¹ * (s * z₀) * g = diagTau hτ := by
  have hπ : π = false → UnitaryFieldData p f K := fun h => by subst h; exact hK.unitary
  have hq' : π = false → ModThree false (p ^ f) := fun h => by subst h; exact hq
  have h3 := hK.three_ne_zero hq
  obtain ⟨τ, hτ, hτ1⟩ := exists_tau hK hq
  set d' : ↥L := ⟨d, hdL⟩ with hd'
  have hd'3 : d' ^ 3 = 1 := Subtype.ext (by simpa using hd3)
  set db : ↥L ⧸ aschbacherSolvableCore 3 ↥L := QuotientGroup.mk' _ d' with hdb
  have hdb3 : db ^ 3 = 1 := by rw [hdb, ← map_pow, hd'3, map_one]
  have hdb1 : db ≠ 1 := by
    intro h1
    have h2 := CFSG.RankThree.injOn_mk_of_isPGroup Nat.prime_three
      (isPGroup_zpowers_three hd'3) (Subgroup.mem_zpowers _) (Subgroup.one_mem _)
      (by rw [map_one]; exact h1)
    exact hd1 (congrArg Subtype.val h2)
  obtain ⟨s, hs, hse⟩ := Subgroup.mem_map.mp (e db).2
  refine ⟨s, hs, hse, ?_⟩
  have hsH : s ∈ glPi π 3 (p ^ f) K := slPi_le_glPi hπ hs
  have hsZ : s ∉ StatedScalars (Fin 3) K := by
    intro hsZ
    apply hdb1
    apply e.injective
    apply Subtype.ext
    rw [← hse, map_one, Subgroup.coe_one, mk_eq_one_iff_mem_statedScalars]
    exact hsZ
  have hs3 : s ^ 3 ∈ StatedScalars (Fin 3) K := by
    rw [← mk_eq_one_iff_mem_statedScalars, map_pow, hse, ← Subgroup.coe_pow, ← map_pow, hdb3,
      map_one, Subgroup.coe_one]
  have hsdet : (s : Matrix (Fin 3) (Fin 3) K).det = 1 := ((mem_slPi_iff hπ).mp hs).2
  have hfix : thetaQuotMulAut L (L.normalizerMonoidHom ⟨x, hxN⟩) db = db := by
    rw [hdb, QuotientGroup.mk'_apply, thetaQuotMulAut_mk]
    congr 1
    apply Subtype.ext
    rw [normalizerMonoidHom_apply_coe, hxd, mul_inv_cancel_right]
  have h1 := hact db
  rw [hfix, ← hse] at h1
  have hysZ : y * s * y⁻¹ * s⁻¹ ∈ StatedScalars (Fin 3) K := by
    rw [← mk_eq_one_iff_mem_statedScalars, map_mul, map_mul, map_mul, map_inv, map_inv, ← h1,
      mul_inv_cancel]
  obtain ⟨lam, hlam⟩ := hysZ
  have hys : y * s * y⁻¹ = GeneralLinearGroup.scalar (Fin 3) lam * s := by
    rw [hlam]
    group
  have hlam1 : lam ≠ 1 := by
    intro hlam1
    refine Sec12.KS128NotHJTC.false_of_commute_irreducible hτ hτ1 h3 hsdet hs3 hsZ ?_ hy3.2.2
    rw [hlam1, map_one, one_mul] at hys
    calc y * s = y * s * y⁻¹ * y := by group
      _ = s * y := by rw [hys]
  have htr := trace_eq_zero_of_conj_eq_scalar_mul hlam1 hys
  have hsZ' : s ∉ zPi π 3 (p ^ f) K := fun hz =>
    hsZ (mem_statedScalars_of_mem_zPi hK hq hτ hτ1 hz)
  have hs3' : s ^ 3 ∈ zPi π 3 (p ^ f) K := by
    rw [zPi_eq hπ hq' hτ hτ1]
    exact ⟨pow_mem hsH 3, hs3⟩
  rcases type123_exhaust hK hq hsH hsZ' hs3' with h1 | h2 | h3'
  · obtain ⟨τ', hτ', hτ'1, z₀, hz₀, g, hg, hD⟩ := h1
    exact ⟨τ', hτ', hτ'1, z₀, hz₀, g, hg, hD⟩
  · exact absurd htr (trace_ne_zero_of_type2 hK hq h2)
  · exact absurd ⟨s, hs, fun m _ => rfl⟩ (not_inner_of_type3 hK hq hsH h3')

end TypeOne

section Realize

theorem exists_acts_of_mem_glPi {L : Subgroup G} {x : G}
    (hxN : x ∈ Subgroup.normalizer (L : Set G))
    {π : Bool} {p f : ℕ} {K : Type} [Field K] (hK : PiField π p f K) (hq : ModThree π (p ^ f))
    (e : ↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* projImage (slPi π 3 (p ^ f) K))
    {y : GL (Fin 3) K} (hyH : y ∈ glPi π 3 (p ^ f) K) (hy3 : Type123 π (p ^ f) K y 3)
    (hact : ∀ z : ↥L ⧸ aschbacherSolvableCore 3 ↥L,
      ((e (thetaQuotMulAut L (L.normalizerMonoidHom ⟨x, hxN⟩) z) :
        projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) =
          ProjGenLinGroup.mk y * (e z : ProjGenLinGroup (Fin 3) K) * (ProjGenLinGroup.mk y)⁻¹)
    {m : GL (Fin 3) K} (hm : m ∈ glPi π 3 (p ^ f) K) :
    ∃ l ∈ L, ∃ k : ℕ, ∃ hN : l * x ^ k ∈ Subgroup.normalizer (L : Set G),
      ∀ u, ((e (thetaQuotMulAut L (L.normalizerMonoidHom ⟨l * x ^ k, hN⟩) u) :
        projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) =
          ProjGenLinGroup.mk m * (e u : ProjGenLinGroup (Fin 3) K) *
            (ProjGenLinGroup.mk m)⁻¹ := by
  have hyP : ProjGenLinGroup.mk y ∉ projImage (slPi π 3 (p ^ f) K) := by
    rintro ⟨l, hl, hly⟩
    apply not_inner_of_type3 hK hq hyH hy3
    obtain ⟨κ, hκ⟩ : l⁻¹ * y ∈ StatedScalars (Fin 3) K := by
      rw [← mk_eq_one_iff_mem_statedScalars, map_mul, map_inv, hly, inv_mul_cancel]
    refine ⟨l, hl, fun m' _ => ?_⟩
    have hy : y = l * GeneralLinearGroup.scalar (Fin 3) κ := by rw [hκ]; group
    rw [hy, mul_inv_rev]
    calc l * GeneralLinearGroup.scalar (Fin 3) κ * m' *
          ((GeneralLinearGroup.scalar (Fin 3) κ)⁻¹ * l⁻¹) =
        l * (GeneralLinearGroup.scalar (Fin 3) κ * m') *
          (GeneralLinearGroup.scalar (Fin 3) κ)⁻¹ * l⁻¹ := by group
      _ = l * (m' * GeneralLinearGroup.scalar (Fin 3) κ) *
          (GeneralLinearGroup.scalar (Fin 3) κ)⁻¹ * l⁻¹ := by
          rw [(CFSG.ClassicalGroups.UnitaryFlag.commute_scalar κ m').eq]
      _ = l * m' * l⁻¹ := by group
  obtain ⟨s, hs, k, hmk⟩ := Item138Proof.exists_mk_eq_mk_mul_pow hK hyH hyP hm
  obtain ⟨⟨l, hl⟩, hle⟩ := QuotientGroup.mk'_surjective (aschbacherSolvableCore 3 ↥L)
    (e.symm (projOf _ ⟨s, hs⟩))
  have hlN : l ∈ Subgroup.normalizer (L : Set G) := Subgroup.le_normalizer hl
  have hxk : x ^ k ∈ Subgroup.normalizer (L : Set G) := Subgroup.pow_mem _ hxN k
  refine ⟨l, hl, k, Subgroup.mul_mem _ hlN hxk, ?_⟩
  have hel : ((e (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥L) ⟨l, hl⟩) :
      projImage (slPi π 3 (p ^ f) K)) : ProjGenLinGroup (Fin 3) K) = ProjGenLinGroup.mk s := by
    rw [hle, MulEquiv.apply_symm_apply, coe_projOf]
  have h1 := acts_conj e hel
  have h2 := acts_zpow e hact k
  rw [act_mul hlN hxk, act_inner hl hlN]
  have hxk' : thetaQuotMulAut L (L.normalizerMonoidHom ⟨x ^ k, hxk⟩) =
      thetaQuotMulAut L (L.normalizerMonoidHom ⟨x, hxN⟩) ^ k := by
    rw [show (⟨x ^ k, hxk⟩ : Subgroup.normalizer (L : Set G)) = ⟨x, hxN⟩ ^ k from rfl, map_pow,
      map_pow]
  rw [hxk']
  intro u
  rw [acts_mul e h1 h2 u, map_mul, map_pow, ← hmk]

end Realize

