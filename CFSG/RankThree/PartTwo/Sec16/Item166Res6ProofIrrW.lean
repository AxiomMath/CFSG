@[expose] def KSL3TwoIrrSimpleNonab : Prop :=
  ∀ (K : Type) [Field K] [Finite K] [CharP K 2] (J : Subgroup (GL (Fin 3) K)),
    (∀ W : Submodule K (Fin 3 → K),
      (∀ g ∈ J, ∀ v ∈ W, (g : Matrix (Fin 3) (Fin 3) K) *ᵥ v ∈ W) → W = ⊥ ∨ W = ⊤) →
    IsSimpleGroup ↥J → ∀ P : Sylow 2 ↥J, ¬ IsMulCommutative (P : Subgroup ↥J) →
      3 ∣ Nat.card J

namespace Proof166Res6

theorem three_dvd_card_PSL2 (F : Type) [Field F] [Finite F] : 3 ∣ Nat.card PSL(2, F) := by
  have h := (Subgroup.center SL(2, F)).card_eq_card_quotient_mul_card_subgroup
  rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (n := 2) (by norm_num),
    show 2 * (2 - 1) / 2 = 1 from rfl, show Finset.Icc 2 2 = ({2} : Finset ℕ) from rfl,
    Finset.prod_singleton, pow_one] at h
  have hZ : Nat.card (Subgroup.center SL(2, F)) ≤ 2 := by
    rw [Nat.card_congr (Matrix.SpecialLinearGroup.center_equiv_rootsOfUnity' (0 : Fin 2)).toEquiv]
    exact card_rootsOfUnity F _
  have hZ0 : 0 < Nat.card (Subgroup.center SL(2, F)) := Nat.card_pos
  have hq : 3 ∣ Nat.card F * (Nat.card F ^ 2 - 1) := by
    set q := Nat.card F
    have hmod : q % 3 = 0 ∨ q % 3 = 1 ∨ q % 3 = 2 := by omega
    rcases hmod with h0 | h1 | h2
    · exact Dvd.dvd.mul_right (Nat.dvd_of_mod_eq_zero h0) _
    · refine Dvd.dvd.mul_left ?_ _
      obtain ⟨r, hr⟩ : ∃ r, q = 3 * r + 1 := ⟨q / 3, by omega⟩
      rw [hr, show (3 * r + 1) ^ 2 = 3 * (3 * r ^ 2 + 2 * r) + 1 by ring, Nat.add_sub_cancel]
      exact dvd_mul_right 3 _
    · refine Dvd.dvd.mul_left ?_ _
      obtain ⟨r, hr⟩ : ∃ r, q = 3 * r + 2 := ⟨q / 3, by omega⟩
      rw [hr, show (3 * r + 2) ^ 2 = 3 * (3 * r ^ 2 + 4 * r + 1) + 1 by ring, Nat.add_sub_cancel]
      exact dvd_mul_right 3 _
  rw [h] at hq
  have hcop : Nat.Coprime 3 (Nat.card (Subgroup.center SL(2, F))) := by
    interval_cases Nat.card (Subgroup.center SL(2, F)) <;> norm_num
  exact hcop.dvd_of_dvd_mul_right hq

theorem three_dvd_card_of_walter
    (X : Type) [Group X] [Finite X] [IsSimpleGroup X] (hnab : ∃ a b : X, a * b ≠ b * a)
    (P : Sylow 2 X) (hP : IsMulCommutative (P : Subgroup X)) : 3 ∣ Nat.card X := by
  rcases CFSG.Milestones.cl_lit_walter_abelian_sylow_two_simple X hnab P hP with
    ⟨f, -, ⟨e⟩⟩ | ⟨p, f, _, -, -, -, -, ⟨e⟩⟩ | ⟨m, -, hcard⟩ | hJ1
  · rw [Nat.card_congr e.toEquiv]
    exact three_dvd_card_PSL2 _
  · rw [Nat.card_congr e.toEquiv]
    exact three_dvd_card_PSL2 _
  · rw [hcard, CFSG.Open.ordRee]
    refine Dvd.dvd.mul_right (Dvd.dvd.mul_right (Dvd.dvd.mul_left ?_ _) _) _
    exact dvd_pow_self 3 (by omega)
  · obtain ⟨e⟩ := hJ1
    rw [Nat.card_congr e.toEquiv, CFSG.Walter.J1Props.J1_card]
    norm_num

variable {K : Type} [Field K]

theorem det_eq_one_of_isPerfect {J : Subgroup (GL (Fin 3) K)} (hJ : Group.IsPerfect J)
    {g : GL (Fin 3) K} (hg : g ∈ J) : (g : Matrix (Fin 3) (Fin 3) K).det = 1 := by
  set φ : ↥J →* Kˣ := Matrix.GeneralLinearGroup.det.comp J.subtype with hφ
  have hle : commutator ↥J ≤ φ.ker := Abelianization.commutator_subset_ker φ
  have hmem : (⟨g, hg⟩ : ↥J) ∈ commutator ↥J := by
    rw [Group.IsPerfect.commutator_eq_top (self := hJ)]
    exact Subgroup.mem_top _
  have h1 := hle hmem
  rw [MonoidHom.mem_ker, hφ, MonoidHom.comp_apply] at h1
  rw [← Matrix.GeneralLinearGroup.val_det_apply]
  exact congrArg Units.val h1

theorem eq_one_of_scalar {J : Subgroup (GL (Fin 3) K)} [Finite J] (hJ : Group.IsPerfect J)
    (hJ3 : ¬ 3 ∣ Nat.card J) {g : GL (Fin 3) K} (hg : g ∈ J) {c : K}
    (hc : (g : Matrix (Fin 3) (Fin 3) K) = c • 1) : g = 1 := by
  have hdet := det_eq_one_of_isPerfect hJ hg
  rw [hc, Matrix.det_smul, Matrix.det_one, mul_one, Fintype.card_fin] at hdet
  have hg3 : (⟨g, hg⟩ : ↥J) ^ 3 = 1 := by
    apply Subtype.ext
    apply Units.ext
    rw [Subgroup.coe_pow, Units.val_pow_eq_pow_val, hc, smul_pow, one_pow, hdet, one_smul]
    rfl
  have hord : orderOf (⟨g, hg⟩ : ↥J) ∣ 3 := orderOf_dvd_of_pow_eq_one hg3
  have hord' : orderOf (⟨g, hg⟩ : ↥J) ∣ Nat.card J := orderOf_dvd_natCard _
  rcases (Nat.dvd_prime Nat.prime_three).mp hord with h1 | h3
  · have := orderOf_eq_one_iff.mp h1
    exact congrArg Subtype.val this
  · rw [h3] at hord'
    exact absurd hord' hJ3

theorem isSimpleGroup_of_minimal {J : Subgroup (GL (Fin 3) K)} [Finite J] (hJ : Group.IsPerfect J)
    (hJ3 : ¬ 3 ∣ Nat.card J) (hJs : ¬ IsScal J)
    (hmin : ∀ M : Subgroup (GL (Fin 3) K), M ≤ J →
      J ≤ Subgroup.normalizer (M : Set (GL (Fin 3) K)) → ¬ IsScal M → J ≤ M) :
    IsSimpleGroup ↥J := by
  have hJ1 : ∃ g ∈ J, g ≠ 1 := by
    by_contra h
    push Not at h
    exact hJs fun n hn => ⟨1, by rw [h n hn, Units.val_one, one_smul]⟩
  obtain ⟨g, hgJ, hg1⟩ := hJ1
  have : Nontrivial ↥J := ⟨⟨⟨g, hgJ⟩, 1, fun h => hg1 (congrArg Subtype.val h)⟩⟩
  refine ⟨fun H hH => ?_⟩
  obtain ⟨M, hM⟩ : ∃ M : Subgroup (GL (Fin 3) K), M = H.map J.subtype := ⟨_, rfl⟩
  have hMJ : M ≤ J := hM ▸ Subgroup.map_subtype_le H
  have : Finite M := Set.Finite.to_subtype ((Set.toFinite (J : Set (GL (Fin 3) K))).subset hMJ)
  have hJM : J ≤ Subgroup.normalizer (M : Set (GL (Fin 3) K)) := by
    intro x hx
    refine mem_normalizer_of_conj_mem ?_
    intro m hm
    rw [hM] at hm ⊢
    obtain ⟨h, hh, rfl⟩ := Subgroup.mem_map.mp hm
    have hc : (⟨x, hx⟩ : ↥J) * h * (⟨x, hx⟩ : ↥J)⁻¹ ∈ H := hH.conj_mem h hh ⟨x, hx⟩
    refine Subgroup.mem_map.mpr ⟨_, hc, ?_⟩
    rw [map_mul, map_mul, map_inv]
    rfl
  by_cases hMs : IsScal M
  · left
    rw [eq_bot_iff]
    intro h hh
    obtain ⟨c, hc⟩ := hMs _ (hM ▸ Subgroup.mem_map.mpr ⟨h, hh, rfl⟩)
    exact Subtype.ext (eq_one_of_scalar hJ hJ3 h.2 hc)
  · right
    rw [eq_top_iff]
    intro x _
    have hx := hmin M hMJ hJM hMs x.2
    rw [hM] at hx
    obtain ⟨h, hh, hhx⟩ := Subgroup.mem_map.mp hx
    have : h = x := Subtype.ext hhx
    exact this ▸ hh

theorem three_dvd_card_of_perfect
    [Finite K] [CharP K 2] (hS : KSL3TwoIrrSimpleNonab) :
    ∀ (n : ℕ) (J : Subgroup (GL (Fin 3) K)), Nat.card J = n → IsIrr J → Group.IsPerfect J →
      3 ∣ Nat.card J := by
  classical
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro J hJn hJi hJp
  by_contra hJ3
  obtain ⟨N, -, hNmin⟩ := Finite.exists_le_minimal
    (p := fun N : Subgroup (GL (Fin 3) K) =>
      N ≤ J ∧ J ≤ Subgroup.normalizer (N : Set (GL (Fin 3) K)) ∧ ¬ IsScal N)
    (a := J) ⟨le_rfl, Subgroup.le_normalizer, not_isScal_of_isIrr hJi⟩
  obtain ⟨hNJ, hJN, hNs⟩ := hNmin.prop
  have hNi : IsIrr N := (dichotomy hJi hJ3 hJN).resolve_left hNs
  have hN'N : ⁅N, N⁆ ≤ N := Subgroup.commutator_le.mpr fun a ha b hb => by
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem ha hb) (inv_mem ha)) (inv_mem hb)
  have hJN' : J ≤ Subgroup.normalizer ((⁅N, N⁆ : Subgroup (GL (Fin 3) K)) : Set (GL (Fin 3) K)) :=
    fun g hg => mem_normalizer_commutator (hJN hg)
  by_cases hN'eq : ⁅N, N⁆ = N
  · have hNp := isPerfect_of_commutator_eq hN'eq
    by_cases hNJeq : N = J
    ·
      subst hNJeq
      have hsimp : IsSimpleGroup ↥N := isSimpleGroup_of_minimal hJp hJ3 hNs
        fun M hM hJM hMs => hNmin.2 ⟨hM, hJM, hMs⟩ hM
      have hnab : ∃ a b : ↥N, a * b ≠ b * a := by
        by_contra h
        push Not at h
        have htop : commutator ↥N = ⊤ := Group.IsPerfect.commutator_eq_top (self := hJp)
        have hbot : ⁅(⊤ : Subgroup ↥N), (⊤ : Subgroup ↥N)⁆ = ⊥ := by
          rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
          intro a _
          rw [Subgroup.mem_centralizer_iff]
          intro b _
          exact (h b a)
        obtain ⟨g, hgN, hg1⟩ : ∃ g ∈ N, g ≠ 1 := by
          by_contra h'
          push Not at h'
          exact hNs fun n hn => ⟨1, by rw [h' n hn, Units.val_one, one_smul]⟩
        have hmem : (⟨g, hgN⟩ : ↥N) ∈ (⊤ : Subgroup ↥N) := Subgroup.mem_top _
        rw [← htop, commutator_def, hbot, Subgroup.mem_bot] at hmem
        exact hg1 (congrArg Subtype.val hmem)
      let P : Sylow 2 ↥N := default
      by_cases hPab : IsMulCommutative (P : Subgroup ↥N)
      · exact hJ3 (three_dvd_card_of_walter ↥N hnab P hPab)
      · exact hJ3 (hS K N hJi hsimp P hPab)
    · have hlt : Nat.card N < n := by
        rw [← hJn]
        exact Subgroup.card_lt_of_lt (lt_of_le_of_ne hNJ hNJeq)
      exact hJ3 ((ih _ hlt N rfl hNi hNp).trans (Subgroup.card_dvd_of_le hNJ))
  · have hN's : IsScal ⁅N, N⁆ := by
      by_contra hs
      exact hN'eq (le_antisymm hN'N (hNmin.2 ⟨hN'N.trans hNJ, hJN', hs⟩ hN'N))
    have hNab : ∀ a ∈ N, ∀ b ∈ N, a * b = b * a := by
      intro a ha b hb
      obtain ⟨ζ, hζ⟩ := hN's _ (Subgroup.commutator_mem_commutator ha hb)
      rw [commutatorElement_def] at hζ
      exact commute_of_scalar_commutator hJ3 (hNJ ha) (hNJ hb) hζ
    have hJab := isMulCommutative_of_abelian hJ3 hJN hNab hNi
    apply not_isScal_of_isIrr hJi
    intro g hg
    refine ⟨1, ?_⟩
    have hbot : ⁅(⊤ : Subgroup ↥J), (⊤ : Subgroup ↥J)⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro a _
      rw [Subgroup.mem_centralizer_iff]
      intro b _
      exact Subtype.ext (hJab b b.2 a a.2)
    have hmem : (⟨g, hg⟩ : ↥J) ∈ (⊤ : Subgroup ↥J) := Subgroup.mem_top _
    rw [← Group.IsPerfect.commutator_eq_top (self := hJp), commutator_def, hbot,
      Subgroup.mem_bot] at hmem
    rw [show g = 1 from congrArg Subtype.val hmem, Units.val_one, one_smul]

end Proof166Res6

open Proof166Res6 in
theorem ksl3TwoIrrPerfect_of_simpleNonab
    (hS : KSL3TwoIrrSimpleNonab) : KSL3TwoIrrPerfect := by
  intro K _ _ _ J hJ hJp
  exact three_dvd_card_of_perfect hS _ J rfl hJ hJp

