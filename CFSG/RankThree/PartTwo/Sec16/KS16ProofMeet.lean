open CFSG CFSG.RankThree CFSG.RankThree.LocalRank CFSG.RankThree.PartTwo
  CFSG.RankThree.PartTwo.Sec13
open CFSG.Assembly.RankThreeEven (projImage)
open Matrix (GeneralLinearGroup ProjGenLinGroup)
open CFSG.RankThree.PartTwo.Sec4 (slPi glPi PiField ModThree)
open CFSG.LocalAnalysis.ComponentInitial (UnitaryFieldData)

section Index

variable {K : Type} [Field K] {p f : ℕ} {π : Bool}

theorem mk_pow_three_mem (hK : PiField π p f K) {δ : GL (Fin 3) K}
    (hδ : δ ∈ glPi π 3 (p ^ f) K) :
    ProjGenLinGroup.mk δ ^ 3 ∈ projImage (slPi π 3 (p ^ f) K) := by
  have hπ : π = false → UnitaryFieldData p f K := fun h => by subst h; exact hK.unitary
  have hdsc : ∀ ℓ : Kˣ, GeneralLinearGroup.det (GeneralLinearGroup.scalar (Fin 3) ℓ) = ℓ ^ 3 :=
    fun ℓ => Units.ext (by rw [GeneralLinearGroup.val_det_apply, Sec4.det_scalar,
      Units.val_pow_eq_pow_val])
  set ℓ := GeneralLinearGroup.det δ with hℓdef
  have hℓ : ℓ ∈ rootsOfUnity (Sec4.qSubPi π (p ^ f)) K := Sec4.det_mem_rootsOfUnity hK hδ
  have hsc : GeneralLinearGroup.scalar (Fin 3) ℓ ∈ glPi π 3 (p ^ f) K :=
    (Sec4.scalar_mem_glPi_iff hK ℓ).mpr hℓ
  refine ⟨(GeneralLinearGroup.scalar (Fin 3) ℓ)⁻¹ * δ ^ 3, ?_, ?_⟩
  · refine (Sec4.mem_slPi_iff hπ).mpr ⟨mul_mem (inv_mem hsc) (pow_mem hδ 3), ?_⟩
    have h1 : GeneralLinearGroup.det ((GeneralLinearGroup.scalar (Fin 3) ℓ)⁻¹ * δ ^ 3) = 1 := by
      rw [map_mul, map_inv, map_pow, hdsc, ← hℓdef, inv_mul_cancel]
    have h2 := congrArg Units.val h1
    rwa [GeneralLinearGroup.val_det_apply, Units.val_one] at h2
  · rw [map_mul, map_inv, ProjGenLinGroup.mk_scalar, inv_one, one_mul, map_pow]

theorem index_commutator_le_three (hK : PiField π p f K) (hq2 : 2 < p ^ f) :
    (commutator (projImage (glPi π 3 (p ^ f) K))).index ≤ 3 := by
  have hπ : π = false → UnitaryFieldData p f K := fun h => by subst h; exact hK.unitary
  set P := projImage (glPi π 3 (p ^ f) K) with hP
  have hcomm := commutator_projImage_glPi hK hq2
  have hmemS : ∀ y : P, (y : ProjGenLinGroup (Fin 3) K) ∈ projImage (slPi π 3 (p ^ f) K) →
      y ∈ commutator P := by
    intro y hy
    rw [hcomm, Subgroup.mem_subgroupOf]
    exact hy
  by_cases hall : ∀ g ∈ glPi π 3 (p ^ f) K,
      ProjGenLinGroup.mk g ∈ projImage (slPi π 3 (p ^ f) K)
  · have htop : commutator P = ⊤ := by
      rw [eq_top_iff]
      rintro ⟨_, ⟨g, hg, rfl⟩⟩ -
      exact hmemS _ (hall g hg)
    rw [htop, Subgroup.index_top]
    norm_num
  · push Not at hall
    obtain ⟨δ₀, hδ₀, hδ₀P⟩ := hall
    set d : P := ⟨ProjGenLinGroup.mk δ₀, Subgroup.mem_map_of_mem _ hδ₀⟩ with hd
    have hd3 : d ^ 3 ∈ commutator P := hmemS _ (by
      rw [Subgroup.coe_pow]
      exact mk_pow_three_mem hK hδ₀)
    have hsurj : Function.Surjective
        (fun i : Fin 3 => (QuotientGroup.mk (d ^ (i : ℕ)) : P ⧸ commutator P)) := by
      intro z
      obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective z
      obtain ⟨g, hg, hgy⟩ := y.2
      obtain ⟨s, hs, k, hk⟩ := Item138Proof.exists_mk_eq_mk_mul_pow hK hδ₀ hδ₀P hg
      refine ⟨⟨k % 3, Nat.mod_lt _ (by norm_num)⟩, ?_⟩
      set t : P := ⟨ProjGenLinGroup.mk s, Subgroup.mem_map_of_mem _ (Sec4.slPi_le_glPi hπ hs)⟩
        with ht
      have hy : y = t * d ^ k := by
        apply Subtype.ext
        rw [Subgroup.coe_mul, Subgroup.coe_pow]
        exact hgy.symm.trans hk
      have htS : t ∈ commutator P := hmemS t ⟨s, hs, rfl⟩
      have hdk : d ^ k = (d ^ 3) ^ (k / 3) * d ^ (k % 3) := by
        rw [← pow_mul, ← pow_add, Nat.div_add_mod]
      change (QuotientGroup.mk (d ^ (k % 3)) : P ⧸ commutator P) = QuotientGroup.mk y
      rw [hy, hdk, QuotientGroup.mk_mul, QuotientGroup.mk_mul,
        (QuotientGroup.eq_one_iff t).mpr htS, (QuotientGroup.eq_one_iff _).mpr (pow_mem hd3 _),
        one_mul, one_mul]
    calc (commutator P).index = Nat.card (P ⧸ commutator P) := rfl
      _ ≤ Nat.card (Fin 3) := Nat.card_le_card_of_surjective _ hsurj
      _ = 3 := Nat.card_fin 3

end Index

