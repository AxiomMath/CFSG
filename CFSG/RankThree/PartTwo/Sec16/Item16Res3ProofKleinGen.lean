noncomputable abbrev yRep (p : Fin 4) : PU5 :=
  x1 ^ (repA p : ℕ) * x2 ^ (repB p : ℕ)

private theorem y_mem_E0 (p : Fin 4) : yRep p ∈ E0 :=
  mem_E0 _ _

private theorem y_pow_three (p : Fin 4) : yRep p ^ 3 = 1 :=
  pow_three_of_mem_E0 (y_mem_E0 p)

private theorem y_ne_one (p : Fin 4) : yRep p ≠ 1 :=
  x1_pow_mul_x2_pow_ne_one _ _ (repA_repB_ne p)

private theorem commute_x1_x2 : Commute x1 x2 := x1_mul_x2

private theorem orderOf_y (p : Fin 4) : orderOf (yRep p) = 3 :=
  orderOf_eq_prime (y_pow_three p) (y_ne_one p)

private theorem zpowers_y_sq (p : Fin 4) :
    Subgroup.zpowers (yRep p ^ 2) = Subgroup.zpowers (yRep p) := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.zpowers_le]
    exact Subgroup.pow_mem (Subgroup.zpowers (yRep p)) (Subgroup.mem_zpowers (yRep p)) 2
  · rw [Subgroup.zpowers_le]
    exact mem_zpowers_pow_iff.mpr (by rw [orderOf_y p]; decide)

private theorem y_zero : yRep 0 = x1 := by
  change x1 ^ (repA 0 : ℕ) * x2 ^ (repB 0 : ℕ) = x1
  rw [show repA 0 = 1 by decide +kernel, show repB 0 = 0 by decide +kernel]
  simp

private theorem y_one : yRep 1 = x2 := by
  change x1 ^ (repA 1 : ℕ) * x2 ^ (repB 1 : ℕ) = x2
  rw [show repA 1 = 0 by decide +kernel, show repB 1 = 1 by decide +kernel]
  simp

private theorem y_two : yRep 2 = x1 * x2 := by
  change x1 ^ (repA 2 : ℕ) * x2 ^ (repB 2 : ℕ) = x1 * x2
  rw [show repA 2 = 1 by decide +kernel, show repB 2 = 1 by decide +kernel]
  simp

private theorem y_three : yRep 3 = x1 * x2 ^ 2 := by
  change x1 ^ (repA 3 : ℕ) * x2 ^ (repB 3 : ℕ) = x1 * x2 ^ 2
  rw [show repA 3 = 1 by decide +kernel, show repB 3 = 2 by decide +kernel]
  simp

private theorem x2_pow_four : x2 ^ 4 = x2 := by
  rw [show (4 : ℕ) = 3 + 1 by norm_num, pow_add, x2_pow_three, one_mul, pow_one]

private theorem y_zero_sq : yRep 0 ^ 2 = x1 ^ 2 := by
  rw [y_zero, pow_two]

private theorem y_one_sq : yRep 1 ^ 2 = x2 ^ 2 := by
  rw [y_one, pow_two]

private theorem y_two_sq : yRep 2 ^ 2 = x1 ^ 2 * x2 ^ 2 := by
  rw [y_two, commute_x1_x2.mul_pow 2]

private theorem y_three_sq : yRep 3 ^ 2 = x1 ^ 2 * x2 := by
  rw [y_three, (commute_x1_x2.pow_right 2).mul_pow 2, ← pow_mul,
    show (2 : ℕ) * 2 = 4 by norm_num, x2_pow_four]

private theorem exists_eq_y_or_y_sq {h : PU5} (hh : h ∈ E0) (h1 : h ≠ 1) :
    ∃ p : Fin 4, h = yRep p ∨ h = yRep p ^ 2 := by
  obtain ⟨i, j, rfl⟩ := exists_eq_of_mem_E0 hh
  have hij : (i, j) ≠ (0, 0) := by
    intro h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj h
    exact h1 (by simp)
  fin_cases i <;> fin_cases j
  · exact absurd rfl hij
  · exact ⟨1, Or.inl (by rw [y_one]; simp)⟩
  · exact ⟨1, Or.inr (by rw [y_one_sq]; simp)⟩
  · exact ⟨0, Or.inl (by rw [y_zero]; simp)⟩
  · exact ⟨2, Or.inl (by rw [y_two]; simp)⟩
  · exact ⟨3, Or.inl (by rw [y_three]; simp)⟩
  · exact ⟨0, Or.inr (by rw [y_zero_sq]; simp)⟩
  · exact ⟨3, Or.inr (by rw [y_three_sq]; simp)⟩
  · exact ⟨2, Or.inr (by rw [y_two_sq])⟩

private theorem kSU_zero_zero : kSU 0 0 = s1 := by
  apply SU5_ext
  rw [coe_s1]
  change kMat 0 0 = sMat1
  decide +kernel

private theorem kSU_zero_one : kSU 0 1 = s2 := by
  apply SU5_ext
  rw [coe_s2]
  change kMat 0 1 = sMat2
  decide +kernel

private theorem kPU_zero_zero : kPU 0 0 = k1 :=
  congrArg (fun g : SU5 => (g : PU5)) kSU_zero_zero

private theorem kPU_zero_one : kPU 0 1 = k2 :=
  congrArg (fun g : SU5 => (g : PU5)) kSU_zero_one

theorem kY_zero : kY 0 = kD := by
  change Subgroup.closure {kPU 0 0, kPU 0 1} = Subgroup.closure {k1, k2}
  rw [kPU_zero_zero, kPU_zero_one]

theorem uPU_conj_x1 (p : Fin 4) :
    uPU (repA p) (repB p) (repA_repB_ne p) * x1 *
      (uPU (repA p) (repB p) (repA_repB_ne p))⁻¹ = yRep p := by
  rw [uPU_mul_x1, mul_inv_cancel_right]

theorem uPU_mem_normalizer_E0 (p : Fin 4) :
    uPU (repA p) (repB p) (repA_repB_ne p) ∈
      Subgroup.normalizer (E0 : Set PU5) := by
  refine mem_normalizer_E0 ?_ ?_
  · rw [uPU_conj_x1 p]
    exact y_mem_E0 p
  · rw [uPU_mul_x2, mul_inv_cancel_right]
    exact mem_E0 _ _

theorem exists_eq_zpowers_rep {H : Subgroup PU5} (hHE : H ≤ E0) (hH : Nat.card H = 3) :
    ∃ p : Fin 4, H = Subgroup.zpowers (yRep p) := by
  obtain ⟨h, hhH, hh1, rfl⟩ :=
    Sec5.exists_eq_zpowers_of_card_eq_prime Nat.prime_three hH
  obtain ⟨p, hp | hp⟩ := exists_eq_y_or_y_sq (hHE hhH) hh1
  · exact ⟨p, by rw [hp]⟩
  · exact ⟨p, by rw [hp, zpowers_y_sq]⟩

theorem card_kY (p : Fin 4) : Nat.card (kY p) = 4 := by
  rw [kY_eq_map p, kY_zero,
    Subgroup.card_map_of_injective
      (f := (MulAut.conj (uPU (repA p) (repB p) (repA_repB_ne p))).toMonoidHom)
      (MulAut.conj (uPU (repA p) (repB p) (repA_repB_ne p))).injective,
    card_kD]

theorem le_kY_of_le_centralizer (p : Fin 4) {W : Subgroup PU5} (hW : IsPGroup 2 W)
    (hWC : W ≤ Subgroup.centralizer ({yRep p} : Set PU5)) : W ≤ kY p := by
  let u := uPU (repA p) (repB p) (repA_repB_ne p)
  let φ : MulAut PU5 := MulAut.conj u
  have hkY : kY p = (kY 0).map φ.toMonoidHom := by
    simpa [u, φ] using kY_eq_map p
  have hφx1 : φ x1 = yRep p := by
    simpa [u, φ, MulAut.conj_apply] using uPU_conj_x1 p
  have hWC' : W.map φ.symm.toMonoidHom ≤ Subgroup.centralizer ({x1} : Set PU5) := by
    refine (Subgroup.map_mono (f := φ.symm.toMonoidHom) hWC).trans ?_
    have h := Subgroup.map_centralizer_le_centralizer_image ({yRep p} : Set PU5)
      φ.symm.toMonoidHom
    have hsymm : φ.symm.toMonoidHom (yRep p) = x1 := by
      apply φ.injective
      simpa [hφx1] using φ.apply_symm_apply (yRep p)
    rwa [Set.image_singleton, hsymm] at h
  have hle : W.map φ.symm.toMonoidHom ≤ kD :=
    le_kD_of_le_centralizer (IsPGroup.map hW φ.symm.toMonoidHom) hWC'
  intro w hw
  have hw' : φ.symm w ∈ kD := hle (Subgroup.mem_map_of_mem (f := φ.symm.toMonoidHom) hw)
  have hw_eq : w = φ.toMonoidHom (φ.symm w) := by simp
  rw [hw_eq, hkY, kY_zero]
  exact Subgroup.mem_map_of_mem (f := φ.toMonoidHom) hw'

theorem eq_bot_or_eq_kY (p : Fin 4) {W : Subgroup PU5} (hWk : W ≤ kY p)
    (hE : E0 ≤ Subgroup.normalizer (W : Set PU5)) : W = ⊥ ∨ W = kY p := by
  let u := uPU (repA p) (repB p) (repA_repB_ne p)
  let φ : MulAut PU5 := MulAut.conj u
  have hu : u ∈ Subgroup.normalizer (E0 : Set PU5) := by
    simpa [u] using uPU_mem_normalizer_E0 p
  have hkY : kY p = MulEquiv.mapSubgroup φ (kY 0) := by
    simpa [MulEquiv.mapSubgroup, u, φ] using kY_eq_map p
  have hmap_symm : MulEquiv.mapSubgroup φ.symm (kY p) = kD := by
    rw [hkY]
    change (MulEquiv.mapSubgroup φ).symm ((MulEquiv.mapSubgroup φ) (kY 0)) = kD
    rw [OrderIso.symm_apply_apply, kY_zero]
  set W' := MulEquiv.mapSubgroup φ.symm W with hW'
  have hW'' : W.map φ.symm.toMonoidHom = W' := by
    simpa [MulEquiv.mapSubgroup] using hW'.symm
  have hW'k : W' ≤ kD := by
    have h : MulEquiv.mapSubgroup φ.symm W ≤ MulEquiv.mapSubgroup φ.symm (kY p) :=
      Subgroup.map_mono hWk
    rwa [← hW', hmap_symm] at h
  have hmap : MulEquiv.mapSubgroup φ E0 = E0 := by
    change E0.map φ.toMonoidHom = E0
    exact Subgroup.mem_normalizer_iff_map_conj_eq.mp hu
  have hE0map : MulEquiv.mapSubgroup φ.symm E0 = E0 := by
    calc MulEquiv.mapSubgroup φ.symm E0
        = MulEquiv.mapSubgroup φ.symm (MulEquiv.mapSubgroup φ E0) := by rw [hmap]
      _ = E0 := by
          change (MulEquiv.mapSubgroup φ).symm ((MulEquiv.mapSubgroup φ) E0) = E0
          rw [OrderIso.symm_apply_apply]
  have hE0map' : E0.map φ.symm.toMonoidHom = E0 := by
    change (MulEquiv.mapSubgroup φ.symm E0) = E0
    exact hE0map
  have hN : E0 ≤ Subgroup.normalizer (W' : Set PU5) := by
    have h := Subgroup.map_mono (f := φ.symm.toMonoidHom) hE
    rw [hE0map', Subgroup.map_normalizer_eq_of_bijective W
      (f := φ.symm.toMonoidHom) ⟨φ.symm.injective, φ.symm.surjective⟩, hW''] at h
    exact h
  have hx2 : x2 ∈ Subgroup.normalizer (W' : Set PU5) :=
    hN (Subgroup.mem_sup_right (Subgroup.mem_zpowers x2))
  have hWW' : W = MulEquiv.mapSubgroup φ W' := by
    rw [hW']
    change W = (MulEquiv.mapSubgroup φ) ((MulEquiv.mapSubgroup φ).symm W)
    rw [OrderIso.apply_symm_apply]
  rcases eq_bot_or_eq_kD hW'k hx2 with hbot | hkd
  · left
    rw [hWW', hbot]
    simp
  · right
    rw [hWW', hkd, hkY, kY_zero]

private theorem isElemAbelian_E0 : CFSG.Assembly.IsElemAbelian 3 E0 := by
  have hE0 : E0 = Subgroup.zpowers x1 ⊔ Subgroup.zpowers x2 := rfl
  rw [hE0, Subgroup.zpowers_eq_closure, Subgroup.zpowers_eq_closure, ← Subgroup.closure_union]
  refine CFSG.Open.IsElemAbelian.closure_of_commute ?_ ?_
  · rintro a (rfl | rfl) b (rfl | rfl)
    · rfl
    · exact x1_mul_x2
    · exact x1_mul_x2.symm
    · rfl
  · rintro a (rfl | rfl)
    · exact x1_pow_three
    · exact x2_pow_three

private theorem normalizer_centralizer_singleton_y (p : Fin 4) :
    E0 ≤ Subgroup.normalizer
      (Subgroup.centralizer ({yRep p} : Set PU5) : Set PU5) := by
  rw [Subgroup.le_normalizer_iff]
  intro b hb c hc
  rw [Subgroup.mem_centralizer_iff] at hc ⊢
  intro a ha
  rw [Set.mem_singleton_iff] at ha
  subst ha
  have hbC : Commute b (yRep p) :=
    CFSG.Open.IsElemAbelian.comm isElemAbelian_E0 hb (y_mem_E0 p)
  have hcC : Commute c (yRep p) := ((Subgroup.mem_centralizer_iff.mp hc) (yRep p) rfl).symm
  exact (calc
    (b * c * b⁻¹) * yRep p = b * c * (b⁻¹ * yRep p) := by group
    _ = b * c * (yRep p * b⁻¹) := by rw [hbC.inv_left.eq]
    _ = b * (c * yRep p) * b⁻¹ := by group
    _ = b * (yRep p * c) * b⁻¹ := by rw [hcC.eq]
    _ = (b * yRep p) * c * b⁻¹ := by group
    _ = (yRep p * b) * c * b⁻¹ := by rw [hbC.eq]
    _ = yRep p * (b * c * b⁻¹) := by group).symm

private theorem inf_centralizer_normalized {V : Subgroup PU5}
    (hE : E0 ≤ Subgroup.normalizer (V : Set PU5)) (q : Fin 4) :
    E0 ≤ Subgroup.normalizer
      ((V ⊓ Subgroup.centralizer (Subgroup.zpowers (yRep q) : Set PU5)) : Set PU5) := by
  have hC : E0 ≤ Subgroup.normalizer
      (Subgroup.centralizer (Subgroup.zpowers (yRep q) : Set PU5) : Set PU5) := by
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
    exact normalizer_centralizer_singleton_y q
  exact (le_inf hE hC).trans Subgroup.inf_normalizer_le_normalizer_inf

private theorem inf_centralizer_le_kY {V : Subgroup PU5} (hV : IsPGroup 2 V) (q : Fin 4) :
    V ⊓ Subgroup.centralizer (Subgroup.zpowers (yRep q) : Set PU5) ≤ kY q := by
  refine le_kY_of_le_centralizer q (hV.to_le inf_le_left) ?_
  rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  exact inf_le_right

theorem exists_eq_kY {V : Subgroup PU5} (hV : IsPGroup 2 V)
    (hE : E0 ≤ Subgroup.normalizer (V : Set PU5)) (hV1 : V ≠ ⊥) :
    ∃ p : Fin 4, V = kY p := by
  have hE0ea : CFSG.Assembly.IsElemAbelian 3 E0 := isElemAbelian_E0
  have hcop : Nat.Coprime 3 (Nat.card V) := by
    obtain ⟨n, hn⟩ := hV.exists_card_eq
    rw [hn]
    exact Nat.Coprime.pow_right n (by decide : Nat.Coprime 3 2)
  obtain ⟨p, hp⟩ : ∃ p : Fin 4, V ⊓ Subgroup.centralizer ({yRep p} : Set PU5) ≠ ⊥ := by
    by_contra h
    have hbot : ∀ q : Fin 4, V ⊓ Subgroup.centralizer ({yRep q} : Set PU5) = ⊥ := by
      intro q
      by_contra hq
      exact h ⟨q, hq⟩
    have hAll : ∀ H : Subgroup PU5, H ≤ E0 → Nat.card H = 3 →
        V ⊓ Subgroup.centralizer (H : Set PU5) ≤ ⊥ := by
      intro H hHE hHc
      obtain ⟨q, rfl⟩ := exists_eq_zpowers_rep hHE hHc
      rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure, hbot q]
    have hVle : V ≤ ⊥ := Sec5.le_of_forall_inf_centralizer_sub_le (p := 3) (k := 1)
      Nat.prime_three hE0ea (by rw [card_E0]; norm_num) hE hcop hAll
    exact hV1 (le_bot_iff.mp hVle)
  set W := V ⊓ Subgroup.centralizer ({yRep p} : Set PU5) with hW
  have hW2 : IsPGroup 2 W := hV.to_le inf_le_left
  have hWk : W ≤ kY p := le_kY_of_le_centralizer p hW2 inf_le_right
  have hEW : E0 ≤ Subgroup.normalizer (W : Set PU5) := by
    exact (le_inf hE (normalizer_centralizer_singleton_y p)).trans
      Subgroup.inf_normalizer_le_normalizer_inf
  have hkYp_le_V : kY p ≤ V := by
    rcases eq_bot_or_eq_kY p hWk hEW with hb | hk
    · exact absurd hb hp
    · rw [← hk]
      exact inf_le_left
  have hAll : ∀ H : Subgroup PU5, H ≤ E0 → Nat.card H = 3 →
      V ⊓ Subgroup.centralizer (H : Set PU5) ≤ kY p := by
    intro H hHE hHc
    obtain ⟨q, rfl⟩ := exists_eq_zpowers_rep hHE hHc
    by_cases hqp : q = p
    · subst hqp
      rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure, ← hW]
      exact hWk
    · have hzero : V ⊓ Subgroup.centralizer (Subgroup.zpowers (yRep q) : Set PU5) = ⊥ := by
        by_contra hne
        have hqk : V ⊓ Subgroup.centralizer (Subgroup.zpowers (yRep q) : Set PU5) ≤ kY q :=
          inf_centralizer_le_kY hV q
        have hqE := inf_centralizer_normalized hE q
        have hq_eq : V ⊓ Subgroup.centralizer (Subgroup.zpowers (yRep q) : Set PU5) = kY q := by
          rcases eq_bot_or_eq_kY q hqk hqE with hb | hk
          · exact absurd hb hne
          · exact hk
        have hsupV : kY q ⊔ kY p ≤ V :=
          sup_le (by rw [← hq_eq]; exact inf_le_left) hkYp_le_V
        exact not_isPGroup_kY_sup hqp (hV.to_le hsupV)
      rw [hzero]
      exact bot_le
  have hVle : V ≤ kY p := Sec5.le_of_forall_inf_centralizer_sub_le (p := 3) (k := 1)
    Nat.prime_three hE0ea (by rw [card_E0]; norm_num) hE hcop hAll
  exact ⟨p, le_antisymm hVle hkYp_le_V⟩

private def InvTwo (G : Type*) [Group G] (E : Subgroup G) : Prop :=
  ∀ V : Subgroup G, IsPGroup 2 V → E ≤ Subgroup.normalizer (V : Set G) → V ≠ ⊥ →
    Nat.card V = 4 ∧ ∀ W : Subgroup G, W ≤ V →
      E ≤ Subgroup.normalizer (W : Set G) → W = ⊥ ∨ W = V

private def KleinGen (G : Type*) [Group G] (E : Subgroup G) : Prop :=
  ∀ V₁ V₂ : Subgroup G, IsPGroup 2 V₁ → IsPGroup 2 V₂ →
    E ≤ Subgroup.normalizer (V₁ : Set G) → E ≤ Subgroup.normalizer (V₂ : Set G) →
      V₁ ≠ ⊥ → V₂ ≠ ⊥ → V₁ ≠ V₂ →
        Nonempty (↥(V₁ ⊔ V₂) ≃* alternatingGroup (Fin 7))

private theorem invTwo_E0 : InvTwo PU5 E0 := by
  intro V hV hEV hV1
  obtain ⟨p, rfl⟩ := exists_eq_kY hV hEV hV1
  refine ⟨card_kY p, fun W hWV hEW => ?_⟩
  exact eq_bot_or_eq_kY p hWV hEW

private theorem kleinGen_E0 : KleinGen PU5 E0 := by
  intro V₁ V₂ hV₁ hV₂ hEV₁ hEV₂ hV₁1 hV₂1 hne
  obtain ⟨p, rfl⟩ := exists_eq_kY hV₁ hEV₁ hV₁1
  obtain ⟨q, rfl⟩ := exists_eq_kY hV₂ hEV₂ hV₂1
  have hpq : p ≠ q := fun h => hne (by rw [h])
  exact nonempty_mulEquiv_kY_sup hpq

private theorem invTwo_map {G H : Type*} [Group G] [Group H] (φ : G ≃* H)
    {E : Subgroup G} (h : InvTwo H (E.map φ.toMonoidHom)) : InvTwo G E := by
  intro V hV hEV hV1
  set V' := V.map φ.toMonoidHom with hV'
  have hV'2 : IsPGroup 2 V' := IsPGroup.map hV φ.toMonoidHom
  have hEV' : E.map φ.toMonoidHom ≤ Subgroup.normalizer (V' : Set H) := by
    have h := (Subgroup.map_mono hEV).trans
      (Subgroup.le_normalizer_map (H := V) φ.toMonoidHom)
    rwa [← hV'] at h
  have hV'1 : V' ≠ ⊥ := by
    intro hbot
    apply hV1
    exact Subgroup.map_injective (f := φ.toMonoidHom) φ.injective (by
      rw [← hV', hbot, Subgroup.map_bot])
  obtain ⟨hcard, hprop⟩ := h V' hV'2 hEV' hV'1
  refine ⟨?_, fun W hWV hEW => ?_⟩
  · rw [hV', Subgroup.card_map_of_injective (f := φ.toMonoidHom) φ.injective] at hcard
    exact hcard
  · set W' := W.map φ.toMonoidHom with hW'
    have hW'le : W' ≤ V' := by
      rw [hW', hV']
      exact Subgroup.map_mono hWV
    have hEW' : E.map φ.toMonoidHom ≤ Subgroup.normalizer (W' : Set H) := by
      have h := (Subgroup.map_mono hEW).trans
        (Subgroup.le_normalizer_map (H := W) φ.toMonoidHom)
      rwa [← hW'] at h
    rcases hprop W' hW'le hEW' with hbot | htop
    · left
      exact Subgroup.map_injective (f := φ.toMonoidHom) φ.injective (by
        rw [← hW', hbot, Subgroup.map_bot])
    · right
      exact Subgroup.map_injective (f := φ.toMonoidHom) φ.injective (by
        rw [← hW', htop, hV'])

private theorem kleinGen_map {G H : Type*} [Group G] [Group H] (φ : G ≃* H)
    {E : Subgroup G} (h : KleinGen H (E.map φ.toMonoidHom)) : KleinGen G E := by
  intro V₁ V₂ hV₁ hV₂ hEV₁ hEV₂ hV₁1 hV₂1 hne
  set V₁' := V₁.map φ.toMonoidHom with hV₁'
  set V₂' := V₂.map φ.toMonoidHom with hV₂'
  have hV₁'2 : IsPGroup 2 V₁' := IsPGroup.map hV₁ φ.toMonoidHom
  have hV₂'2 : IsPGroup 2 V₂' := IsPGroup.map hV₂ φ.toMonoidHom
  have hEV₁' : E.map φ.toMonoidHom ≤ Subgroup.normalizer (V₁' : Set H) := by
    have h := (Subgroup.map_mono hEV₁).trans
      (Subgroup.le_normalizer_map (H := V₁) φ.toMonoidHom)
    rwa [← hV₁'] at h
  have hEV₂' : E.map φ.toMonoidHom ≤ Subgroup.normalizer (V₂' : Set H) := by
    have h := (Subgroup.map_mono hEV₂).trans
      (Subgroup.le_normalizer_map (H := V₂) φ.toMonoidHom)
    rwa [← hV₂'] at h
  have hV₁'1 : V₁' ≠ ⊥ := by
    intro hbot
    apply hV₁1
    exact Subgroup.map_injective (f := φ.toMonoidHom) φ.injective (by
      rw [← hV₁', hbot, Subgroup.map_bot])
  have hV₂'1 : V₂' ≠ ⊥ := by
    intro hbot
    apply hV₂1
    exact Subgroup.map_injective (f := φ.toMonoidHom) φ.injective (by
      rw [← hV₂', hbot, Subgroup.map_bot])
  have hne' : V₁' ≠ V₂' := by
    intro heq
    apply hne
    exact Subgroup.map_injective (f := φ.toMonoidHom) φ.injective (by
      rw [← hV₁', ← hV₂', heq])
  obtain ⟨e⟩ := h V₁' V₂' hV₁'2 hV₂'2 hEV₁' hEV₂' hV₁'1 hV₂'1 hne'
  have hsup : (V₁ ⊔ V₂).map φ.toMonoidHom = V₁' ⊔ V₂' := by
    rw [Subgroup.map_sup, ← hV₁', ← hV₂']
  exact ⟨(Subgroup.equivMapOfInjective (V₁ ⊔ V₂) φ.toMonoidHom φ.injective).trans
    ((MulEquiv.subgroupCongr hsup).trans e)⟩

private theorem map_conj_eq_E0 {E : Subgroup PU5} {g : PU5}
    (hg : ∀ x, x ∈ E ↔ g * x * g⁻¹ ∈ E0) : E.map (MulAut.conj g).toMonoidHom = E0 := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (hg y).mp hy
  · intro hx
    refine ⟨g⁻¹ * x * g, ?_, ?_⟩
    · exact (hg (g⁻¹ * x * g)).mpr (by
        rw [show g * (g⁻¹ * x * g) * g⁻¹ = x by group]
        exact hx)
    · change g * (g⁻¹ * x * g) * g⁻¹ = x
      group

private theorem invTwo_of_card {E : Subgroup PU5} (hE : Nat.card E = 9) : InvTwo PU5 E := by
  obtain ⟨g, hg⟩ := exists_conj_eq_E0 hE
  have hEmap := map_conj_eq_E0 hg
  exact invTwo_map (MulAut.conj g) (by rw [hEmap]; exact invTwo_E0)

private theorem kleinGen_of_card {E : Subgroup PU5} (hE : Nat.card E = 9) :
    KleinGen PU5 E := by
  obtain ⟨g, hg⟩ := exists_conj_eq_E0 hE
  have hEmap := map_conj_eq_E0 hg
  exact kleinGen_map (MulAut.conj g) (by rw [hEmap]; exact kleinGen_E0)

theorem ks163U35InvTwo : KFacts.KS163U35InvTwo := by
  intro h5 E hE
  haveI : Fact (Nat.Prime 5) := h5
  exact invTwo_map equivPU (invTwo_of_card (by
    rw [Subgroup.card_map_of_injective (f := equivPU.toMonoidHom) equivPU.injective, hE]))

theorem ks163U35KleinGen : KFacts.KS163U35KleinGen := by
  intro h5 E hE
  haveI : Fact (Nat.Prime 5) := h5
  exact kleinGen_map equivPU (kleinGen_of_card (by
    rw [Subgroup.card_map_of_injective (f := equivPU.toMonoidHom) equivPU.injective, hE]))

end CFSG.RankThree.PartTwo.Sec16.Res3U35
