section Frobenius

variable {a : ℕ} {K : Type} [Field K] [Finite K]

theorem two_pow_odd_mod_five (a : ℕ) : 2 ^ (2 * a + 1) % 5 = 2 ∨ 2 ^ (2 * a + 1) % 5 = 3 := by
  induction a with
  | zero => norm_num
  | succ a ih =>
    have h : 2 ^ (2 * (a + 1) + 1) = 4 * 2 ^ (2 * a + 1) := by ring
    rw [h, Nat.mul_mod]
    rcases ih with h' | h' <;> rw [h'] <;> norm_num

theorem not_five_dvd_two_pow_odd_sub_one (a : ℕ) : ¬ 5 ∣ 2 ^ (2 * a + 1) - 1 := by
  have h1 : 1 ≤ 2 ^ (2 * a + 1) := Nat.one_le_two_pow
  rcases two_pow_odd_mod_five a with h | h <;> omega

theorem exists_frobenius_pair_ne_five (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    ∃ p : ℕ, p.Prime ∧ 3 < p ∧ p ≠ 5 ∧ ∃ t : suzukiGroup a K, t ^ p = 1 ∧
      t ∈ Subgroup.normalizer (suzukiZ0 a K : Set (suzukiGroup a K)) ∧
      ∀ x ∈ suzukiZ0 a K, t * x * t⁻¹ = x → x = 1 := by
  set N := 2 ^ (2 * a + 1) - 1 with hN
  have h8 : 8 ≤ 2 ^ (2 * a + 1) :=
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ (2 * a + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hN1 : N ≠ 1 := by omega
  set p := N.minFac with hp
  have hpp : p.Prime := Nat.minFac_prime hN1
  have hpN : p ∣ N := Nat.minFac_dvd N
  have hp2 : p ≠ 2 := by
    rintro h2
    rw [h2] at hpN
    have := Steps166.two_pow_odd_sub_one_mod_two a
    omega
  have hp3 : p ≠ 3 := by
    rintro h3
    rw [h3] at hpN
    have := Steps166.two_pow_odd_sub_one_mod_three a
    omega
  have hp5 : p ≠ 5 := by
    rintro h5
    rw [h5] at hpN
    exact not_five_dvd_two_pow_odd_sub_one a hpN
  have hp3' : 3 < p := by
    have := hpp.two_le
    omega
  refine ⟨p, hpp, hp3', hp5, ?_⟩
  have : Fact p.Prime := ⟨hpp⟩
  have hcardU : Nat.card Kˣ = N := by rw [Nat.card_units, hK]
  obtain ⟨l, hl⟩ := exists_prime_orderOf_dvd_card' p (hcardU ▸ hpN)
  refine ⟨Steps166.suzukiDHom166 (a := a) l⁻¹, ?_, ?_, ?_⟩
  · rw [← map_pow, inv_pow, ← hl, pow_orderOf_eq_one, inv_one, map_one]
  · have ht : Steps166.suzukiDHom166 (a := a) l⁻¹ = (suzukiDElt a K l)⁻¹ := by
      change suzukiDElt a K l⁻¹ = _
      rw [suzukiDElt_inv]
    rw [ht]
    refine Subgroup.mem_normalizer_iff.mpr fun x => ?_
    constructor
    · intro hx
      obtain ⟨v, rfl⟩ := (mem_suzukiZ0_iff hK).mp hx
      rw [inv_inv, suzukiDElt_conj hK, mul_zero]
      exact (mem_suzukiZ0_iff hK).mpr ⟨_, rfl⟩
    · intro hx
      rw [inv_inv] at hx
      obtain ⟨v, hv⟩ := (mem_suzukiZ0_iff hK).mp hx
      have hx' : x = suzukiDElt a K l * suzukiSElt a K 0 v * (suzukiDElt a K l)⁻¹ := by
        rw [hv]
        group
      rw [hx', suzukiDElt_conj' hK, mul_zero]
      exact (mem_suzukiZ0_iff hK).mpr ⟨_, rfl⟩
  · intro x hx hfix
    obtain ⟨v, rfl⟩ := (mem_suzukiZ0_iff hK).mp hx
    have ht : Steps166.suzukiDHom166 (a := a) l⁻¹ = (suzukiDElt a K l)⁻¹ := by
      change suzukiDElt a K l⁻¹ = _
      rw [suzukiDElt_inv]
    rw [ht, inv_inv, suzukiDElt_conj hK, mul_zero, suzukiSElt_inj] at hfix
    have hv : ((l : K) ^ (2 ^ (a + 1) + 1) - 1) * v = 0 := by
      rw [sub_mul, one_mul, hfix.2, sub_self]
    rcases mul_eq_zero.mp hv with h | h
    · exfalso
      have hl1 : l ^ (2 ^ (a + 1) + 1) = 1 := by
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, Units.val_one]
        exact sub_eq_zero.mp h
      have hdvd : p ∣ 2 ^ (a + 1) + 1 := hl ▸ orderOf_dvd_of_pow_eq_one hl1
      have hcop := CFSG.LieType.Steinberg.CentralExt.SuzukiClosed.coprime_tits a
      rw [add_comm 1] at hcop
      exact hpp.one_lt.ne' ((Nat.Coprime.coprime_dvd_left hpN hcop).eq_one_of_dvd hdvd)
    · rw [h]
      exact suzukiSElt_zero_zero hK

end Frobenius

section Holomorph

variable {Q : Type*} [Group Q]

theorem eq_one_of_inr_mem_centralizer {σ : MulAut Q}
    (h : (SemidirectProduct.inr σ : Q ⋊[MonoidHom.id (MulAut Q)] MulAut Q) ∈
      Subgroup.centralizer
        ((SemidirectProduct.inl : Q →* Q ⋊[MonoidHom.id (MulAut Q)] MulAut Q).range :
          Set (Q ⋊[MonoidHom.id (MulAut Q)] MulAut Q))) : σ = 1 := by
  refine MulEquiv.ext fun w => ?_
  have hw := Subgroup.mem_centralizer_iff.mp h _ ⟨w, rfl⟩
  have h1 : (SemidirectProduct.inl (σ w) : Q ⋊[MonoidHom.id (MulAut Q)] MulAut Q) =
      SemidirectProduct.inl w := by
    have h0 := SemidirectProduct.inl_aut (φ := MonoidHom.id (MulAut Q)) σ w
    rw [MonoidHom.id_apply] at h0
    rw [h0, ← hw, map_inv, mul_inv_cancel_right]
  exact SemidirectProduct.inl_injective h1

theorem apply_eq_of_inl_mul_inr {σ : MulAut Q} {w : Q}
    (h : (SemidirectProduct.inl w : Q ⋊[MonoidHom.id (MulAut Q)] MulAut Q) *
      SemidirectProduct.inr σ = SemidirectProduct.inr σ * SemidirectProduct.inl w) :
    σ w = w := by
  have h1 : (SemidirectProduct.inl (σ w) : Q ⋊[MonoidHom.id (MulAut Q)] MulAut Q) =
      SemidirectProduct.inl w := by
    have h0 := SemidirectProduct.inl_aut (φ := MonoidHom.id (MulAut Q)) σ w
    rw [MonoidHom.id_apply] at h0
    rw [h0, ← h, map_inv, mul_inv_cancel_right]
  exact SemidirectProduct.inl_injective h1

end Holomorph

section Faithful

variable {H : Type} [Group H] [Finite H]

theorem commute_of_pow_commute {M : Type*} [Group M] {p m : ℕ} (hp : p.Prime) (hpm : ¬ p ∣ m)
    {t z : M} (htp : t ^ p = 1) (h : t ^ m * z * (t ^ m)⁻¹ = z) : t * z * t⁻¹ = z := by
  have hcop : Nat.Coprime m p := (Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd hp).mpr hpm))
  obtain ⟨k, -, hk⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hp.one_lt
  have hcomm : Commute (t ^ m) z := by
    rw [Commute, SemiconjBy]
    calc t ^ m * z = t ^ m * z * (t ^ m)⁻¹ * t ^ m := by group
      _ = z * t ^ m := by rw [h]
  have hcomm' : Commute ((t ^ m) ^ k) z := hcomm.pow_left k
  have htk : (t ^ m) ^ k = t := by
    rw [← pow_mul]
    conv_lhs => rw [← Nat.div_add_mod (m * k) p, hk, pow_add, pow_mul, htp, one_pow, one_mul,
      pow_one]
  rw [htk] at hcomm'
  rw [hcomm'.eq, mul_inv_cancel_right]

theorem false_of_noncentral_pCore_pow [Group.IsPerfect H]
    {θ R : Subgroup H} [θ.Normal] [R.Normal] (hRθ : R ≤ θ) (hθs : Group.IsSolvable θ)
    {a : ℕ} (ha : 1 ≤ a) {F : Type} [Field F] [Finite F] (hF : Nat.card F = 2 ^ (2 * a + 1))
    (e : H ⧸ θ ≃* suzukiGroup a F) {q : ℕ} [hq : Fact q.Prime] (hq2 : q ≠ 2)
    {V : Subgroup (H ⧸ R)} [V.Normal] (hVq : IsPGroup q V)
    (hVc : Subgroup.centralizer (V : Set (H ⧸ R)) ≠ ⊤)
    (hloc : ∀ Q : Subgroup H, IsPGroup q Q → ∀ u : H, u ≠ 1 → IsPGroup 2 (Subgroup.zpowers u) →
      CFSG.pRank q ↥(Q ⊓ Subgroup.centralizer {u}) ≤ 2) : False := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π := QuotientGroup.mk' R with hπ
  have hπs : Function.Surjective π := QuotientGroup.mk'_surjective R
  have hsimple : IsSimpleGroup (H ⧸ θ) :=
    isSimpleGroup_of_suzukiModel ⟨rfl, a, ha, F, inferInstance, inferInstance, rfl, hF, ⟨e⟩⟩
  have hK2 : ∀ h : H, π h ∈ Subgroup.centralizer (V : Set (H ⧸ R)) → h ∈ θ := by
    set C := (Subgroup.centralizer (V : Set (H ⧸ R))).comap π with hC
    have : C.Normal := Subgroup.Normal.comap inferInstance π
    rcases Steps166.le_or_eq_top_of_simple (C := C) hθs hsimple with hle | htop
    · exact fun h hh => hle hh
    · exfalso
      apply hVc
      rw [eq_top_iff]
      intro g _
      obtain ⟨h, rfl⟩ := hπs g
      have : h ∈ C := htop ▸ Subgroup.mem_top h
      exact this
  set Vh := V.comap π with hVh
  have : Vh.Normal := Subgroup.Normal.comap inferInstance π
  obtain ⟨S⟩ : Nonempty (Sylow q Vh) := inferInstance
  set Q : Subgroup H := (S : Subgroup Vh).map Vh.subtype with hQ
  have hQq : IsPGroup q Q := S.isPGroup'.map Vh.subtype
  have hVQ : ∀ v ∈ V, ∃ x ∈ Q, π x = v := by
    let f : Vh →* V := (π.comp Vh.subtype).codRestrict V fun x => x.2
    have hf : Function.Surjective f := by
      rintro ⟨v, hv⟩
      obtain ⟨h, rfl⟩ := hπs v
      exact ⟨⟨h, hv⟩, rfl⟩
    have htop : ((S.mapSurjective hf : Sylow q V) : Subgroup V) = ⊤ :=
      ((S.mapSurjective hf).is_maximal' (hVq.to_subgroup ⊤) le_top).symm
    intro v hv
    have hmem : (⟨v, hv⟩ : V) ∈ ((S.mapSurjective hf : Sylow q V) : Subgroup V) :=
      htop ▸ Subgroup.mem_top _
    rw [Sylow.coe_mapSurjective] at hmem
    obtain ⟨s, hs, hsv⟩ := hmem
    exact ⟨s, ⟨s, hs, rfl⟩, congrArg Subtype.val hsv⟩
  have hCQ : ∀ n : H, n ∈ Subgroup.centralizer (Q : Set H) → n ∈ θ := by
    intro n hn
    apply hK2
    rw [Subgroup.mem_centralizer_iff] at hn ⊢
    intro v hv
    obtain ⟨x, hx, rfl⟩ := hVQ v hv
    rw [← map_mul, ← map_mul, hn x hx]
  have hFrat : ∀ h : H, ∃ n ∈ Subgroup.normalizer (Q : Set H), ∃ r ∈ R, n * r = h := by
    have htop := Sylow.normalizer_sup_eq_top S
    have hVh : Vh ≤ Subgroup.normalizer (Q : Set H) ⊔ R := by
      intro h hh
      obtain ⟨x, hx, hxh⟩ := hVQ (π h) hh
      have hxR : x⁻¹ * h ∈ R := by
        rw [← QuotientGroup.eq]
        exact hxh
      have := Subgroup.mul_mem_sup (Subgroup.le_normalizer hx) hxR
      simpa using this
    intro h
    have hh : h ∈ Subgroup.normalizer (Q : Set H) ⊔ R := by
      have : h ∈ Subgroup.normalizer (Q : Set H) ⊔ Vh := by
        rw [hQ, htop]
        exact Subgroup.mem_top h
      exact (sup_le le_sup_left hVh) this
    exact Subgroup.mem_sup_of_normal_right.mp hh
  set ψ : H →* suzukiGroup a F := e.toMonoidHom.comp (QuotientGroup.mk' θ) with hψ
  have hψker : ∀ h : H, ψ h = 1 ↔ h ∈ θ := by
    intro h
    simp only [hψ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.map_eq_one_iff,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  have hψsurjN : ∀ s : suzukiGroup a F, ∃ n ∈ Subgroup.normalizer (Q : Set H), ψ n = s := by
    intro s
    obtain ⟨g, hg⟩ := e.surjective s
    obtain ⟨h, rfl⟩ := QuotientGroup.mk'_surjective θ g
    obtain ⟨n, hn, r, hr, rfl⟩ := hFrat h
    refine ⟨n, hn, ?_⟩
    have h1 : ψ (n * r) = s := hg
    rwa [map_mul, (hψker r).mpr (hRθ hr), mul_one] at h1
  obtain ⟨p, hp, hp3, hp5, t, htp, htN, htfix⟩ := exists_frobenius_pair_ne_five (K := F) ha hF
  have : Fact p.Prime := ⟨hp⟩
  set Z := suzukiZ0 a F with hZ
  set NA : Subgroup H := Z.comap ψ ⊓ Subgroup.normalizer (Q : Set H) with hNA
  obtain ⟨P⟩ : Nonempty (Sylow 2 NA) := inferInstance
  set Ah : Subgroup H := (P : Subgroup NA).map NA.subtype with hAh
  have hAhNA : Ah ≤ NA := Subgroup.map_subtype_le _
  have hAh2 : IsPGroup 2 Ah := P.isPGroup'.map NA.subtype
  have hAhN : Ah ≤ Subgroup.normalizer (Q : Set H) := hAhNA.trans inf_le_right
  have hZ2 : IsPGroup 2 Z := fun z => ⟨1, Subtype.ext (by
    rw [Subgroup.coe_pow, pow_one, Steps166.suzukiZ0_sq hF z.2, Subgroup.coe_one])⟩
  have hψAh : ∀ z ∈ Z, ∃ x ∈ Ah, ψ x = z := by
    let f : NA →* Z := (ψ.comp NA.subtype).codRestrict Z fun x => x.2.1
    have hf : Function.Surjective f := by
      rintro ⟨z, hz⟩
      obtain ⟨n, hn, hnz⟩ := hψsurjN z
      exact ⟨⟨n, (show ψ n ∈ Z from hnz ▸ hz), hn⟩, Subtype.ext hnz⟩
    have htop : ((P.mapSurjective hf : Sylow 2 Z) : Subgroup Z) = ⊤ :=
      ((P.mapSurjective hf).is_maximal' (hZ2.to_subgroup ⊤) le_top).symm
    intro z hz
    have hmem : (⟨z, hz⟩ : Z) ∈ ((P.mapSurjective hf : Sylow 2 Z) : Subgroup Z) :=
      htop ▸ Subgroup.mem_top _
    rw [Sylow.coe_mapSurjective] at hmem
    obtain ⟨s, hs, hsz⟩ := hmem
    exact ⟨s, ⟨s, hs, rfl⟩, congrArg Subtype.val hsz⟩
  obtain ⟨y₀, hy₀N, hy₀⟩ := hψsurjN t
  have hy₀NA : y₀ ∈ Subgroup.normalizer (NA : Set H) := by
    apply Sec3.mem_normalizer_of_forall_conj_mem
    intro x hx
    obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.mp hx
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · change ψ (y₀ * x * y₀⁻¹) ∈ Z
      rw [map_mul, map_mul, map_inv, hy₀]
      exact (Subgroup.mem_normalizer_iff.mp htN _).mp hx1
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hy₀N hx2) (Subgroup.inv_mem _ hy₀N)
  obtain ⟨c, hc, hyAh⟩ := Steps166.exists_mul_mem_normalizer_of_sylow P rfl hy₀NA
  set y := c * y₀ with hydef
  have hyN : y ∈ Subgroup.normalizer (Q : Set H) := mul_mem hc.2 hy₀N
  have hψc : ψ c ∈ Z := hc.1
  have hconj : ∀ z ∈ Z, ψ y * z * (ψ y)⁻¹ = t * z * t⁻¹ := by
    intro z hz
    have htz : t * z * t⁻¹ ∈ Z := (Subgroup.mem_normalizer_iff.mp htN z).mp hz
    rw [hydef, map_mul, hy₀, mul_inv_rev]
    calc ψ c * t * z * (t⁻¹ * (ψ c)⁻¹) = ψ c * (t * z * t⁻¹) * (ψ c)⁻¹ := by group
      _ = (t * z * t⁻¹) * ψ c * (ψ c)⁻¹ := by rw [Steps166.suzukiZ0_comm hF hψc htz]
      _ = t * z * t⁻¹ := by group
  have hconj_pow : ∀ (k : ℕ), ∀ z ∈ Z, ψ y ^ k * z * (ψ y ^ k)⁻¹ = t ^ k * z * (t ^ k)⁻¹ := by
    intro k
    induction k with
    | zero => intro z _; simp
    | succ k ih =>
      intro z hz
      have htz : t * z * t⁻¹ ∈ Z := (Subgroup.mem_normalizer_iff.mp htN z).mp hz
      calc ψ y ^ (k + 1) * z * (ψ y ^ (k + 1))⁻¹ = ψ y ^ k * (ψ y * z * (ψ y)⁻¹) *
            (ψ y ^ k)⁻¹ := by group
        _ = ψ y ^ k * (t * z * t⁻¹) * (ψ y ^ k)⁻¹ := by rw [hconj z hz]
        _ = t ^ k * (t * z * t⁻¹) * (t ^ k)⁻¹ := ih _ htz
        _ = t ^ (k + 1) * z * (t ^ (k + 1))⁻¹ := by group
  obtain ⟨b, m, hpm, hym⟩ := Nat.exists_eq_pow_mul_and_not_dvd (orderOf_pos y).ne' p hp.ne_one
  set y' := y ^ m with hy'def
  have hy'p : y' ^ (p ^ b) = 1 := by
    rw [hy'def, ← pow_mul, mul_comm, ← hym, pow_orderOf_eq_one]
  have hy'N : y' ∈ Subgroup.normalizer (Q : Set H) := pow_mem hyN m
  have hy'Ah : y' ∈ Subgroup.normalizer (Ah : Set H) := pow_mem hyAh m
  have hfpf : ∀ z ∈ Z, ψ y' * z * (ψ y')⁻¹ = z → z = 1 := by
    intro z hz h
    rw [hy'def, map_pow, hconj_pow m z hz] at h
    exact htfix z hz (commute_of_pow_commute hp hpm htp h)
  set X := Subgroup.zpowers y' with hXdef
  have hXp : IsPGroup p X := isPGroup_zpowers_of_pow_eq_one hy'p
  have hXAh : X ≤ Subgroup.normalizer (Ah : Set H) := Subgroup.zpowers_le.mpr hy'Ah
  have hXQ : X ≤ Subgroup.normalizer (Q : Set H) := Subgroup.zpowers_le.mpr hy'N
  set U := ⁅Ah, X⁆ with hUdef
  have hUAh : U ≤ Ah := Subgroup.le_normalizer_iff_commutator_le_left.mp hXAh
  have hU2 : IsPGroup 2 U := hAh2.to_le hUAh
  have hcopAh : ¬ p ∣ Nat.card Ah := by
    obtain ⟨k, hk⟩ := hAh2.exists_card_eq
    rw [hk]
    intro h
    have h2 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h)
    omega
  have hUX : ⁅U, X⁆ = U :=
    CFSG.RankThreeEvenClassification.Helpers.coprime_commutator_idempotent p hp X Ah hXp hcopAh
      hXAh
  have hUQ : U ≤ Subgroup.normalizer (Q : Set H) := hUAh.trans hAhN
  obtain ⟨u, huU, huC⟩ : ∃ u ∈ U, u ∉ Subgroup.centralizer (Q : Set H) := by
    by_contra hcon
    push Not at hcon
    obtain ⟨⟨z, hz⟩, hz1⟩ :=
      (Subgroup.ne_bot_iff_exists_ne_one).mp (Steps166.suzukiZ0_ne_bot (a := a) hF)
    have hz1' : z ≠ 1 := fun h => hz1 (Subtype.ext h)
    obtain ⟨w, hwAh, hwz⟩ := hψAh z hz
    have hcw : ⁅w, y'⁆ ∈ U := Subgroup.commutator_mem_commutator hwAh (Subgroup.mem_zpowers y')
    have h1 : ψ ⁅w, y'⁆ = 1 := (hψker _).mpr (hCQ _ (hcon _ hcw))
    rw [commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv, hwz] at h1
    apply hz1'
    apply hfpf z hz
    calc ψ y' * z * (ψ y')⁻¹ = (z * ψ y' * z⁻¹ * (ψ y')⁻¹)⁻¹ * z := by group
      _ = z := by rw [h1, inv_one, one_mul]
  set NQ := Subgroup.normalizer (Q : Set H) with hNQ
  let ρ : NQ →* MulAut Q := Q.normalizerMonoidHom
  have hρ_apply : ∀ (n : NQ) (w : Q), ((ρ n w : Q) : H) = (n : H) * w * (n : H)⁻¹ :=
    fun n w => Subgroup.normalizerMonoidHom_apply_apply_coe Q n w
  let G' := ↥Q ⋊[MonoidHom.id (MulAut ↥Q)] MulAut ↥Q
  have : Finite G' := Finite.of_equiv _ SemidirectProduct.equivProd.symm
  let f : NQ →* G' := SemidirectProduct.inr.comp ρ
  set P' : Subgroup G' := (SemidirectProduct.inl : ↥Q →* G').range with hP'
  set U' : Subgroup G' := (U.subgroupOf NQ).map f with hU'
  set X' : Subgroup G' := (X.subgroupOf NQ).map f with hX'
  have hXsub : X.subgroupOf NQ = Subgroup.zpowers ⟨y', hy'N⟩ := by
    ext n
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
    constructor
    · rintro ⟨k, hk⟩
      exact ⟨k, Subtype.ext (by rw [Subgroup.coe_zpow]; exact hk)⟩
    · rintro ⟨k, rfl⟩
      exact ⟨k, by rw [Subgroup.coe_zpow]⟩
  have hX'eq : X' = Subgroup.zpowers (f ⟨y', hy'N⟩) := by
    rw [hX', hXsub, MonoidHom.map_zpowers]
  have hP'q : IsPGroup q P' := by
    rw [hP', MonoidHom.range_eq_map]
    exact (hQq.to_subgroup ⊤).map _
  have hU'2 : IsPGroup 2 U' := (hU2.of_equiv (Subgroup.subgroupOfEquivOfLe hUQ).symm).map f
  have hX'p : IsPGroup p X' := (hXp.of_equiv (Subgroup.subgroupOfEquivOfLe hXQ).symm).map f
  have hU'X' : ⁅U', X'⁆ = U' := by
    rw [hU', hX', ← Subgroup.map_commutator, Sec3.commutator_subgroupOf hUQ hXQ, hUX]
  have hnorm : ∀ K : Subgroup G', K ≤ Subgroup.normalizer (P' : Set G') := by
    intro K
    have : P'.Normal := by
      rw [hP', SemidirectProduct.range_inl_eq_ker_rightHom]
      infer_instance
    rw [Subgroup.normalizer_eq_top_iff.mpr this]
    exact le_top
  have hρne : ρ ⟨u, hUQ huU⟩ ≠ 1 := by
    intro h1
    apply huC
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    have h2 := congrArg (fun σ : MulAut Q => ((σ ⟨w, hw⟩ : Q) : H)) h1
    simp only [MulAut.one_apply, hρ_apply] at h2
    calc w * u = (u * w * u⁻¹) * u := by rw [h2]
      _ = u * w := by group
  have hU'1 : U' ≠ ⊥ := by
    intro h0
    apply hρne
    have hmem : f ⟨u, hUQ huU⟩ ∈ U' := ⟨⟨u, hUQ huU⟩, huU, rfl⟩
    rw [h0, Subgroup.mem_bot] at hmem
    exact SemidirectProduct.inr_injective (hmem.trans (map_one _).symm)
  have hfaith : U' ⊓ Subgroup.centralizer (P' : Set G') = ⊥ := by
    rw [eq_bot_iff]
    rintro _ ⟨⟨n, -, rfl⟩, hnC⟩
    rw [Subgroup.mem_bot]
    change SemidirectProduct.inr (ρ n) = 1
    rw [eq_one_of_inr_mem_centralizer hnC, map_one]
  have hfix : ∀ w ∈ U', w ≠ 1 →
      CFSG.Assembly.pRank q (P' ⊓ Subgroup.centralizer ({w} : Set G')) ≤ 2 := by
    rintro _ ⟨n, hn, rfl⟩ hw1
    have hnU : (n : H) ∈ U := hn
    have hn1 : (n : H) ≠ 1 := by
      intro h1
      apply hw1
      have : n = 1 := Subtype.ext h1
      rw [this, map_one]
    have hn2 : IsPGroup 2 (Subgroup.zpowers (n : H)) :=
      hU2.to_le (Subgroup.zpowers_le.mpr hnU)
    set C' := P' ⊓ Subgroup.centralizer ({f n} : Set G') with hC'
    have hleft : ∀ v : C', (v : G') = SemidirectProduct.inl (v : G').left := by
      rintro ⟨_, ⟨w, rfl⟩, -⟩
      rfl
    have hmemC : ∀ v : C', (((v : G').left : Q) : H) ∈ Q ⊓ Subgroup.centralizer {(n : H)} := by
      intro v
      refine ⟨((v : G').left).2, Subgroup.mem_centralizer_singleton_iff.mpr ?_⟩
      have hv := Subgroup.mem_centralizer_singleton_iff.mp v.2.2
      rw [hleft v] at hv
      have h1 := apply_eq_of_inl_mul_inr hv
      have h2 := congrArg (fun w : Q => (w : H)) h1
      simp only [hρ_apply] at h2
      calc (((v : G').left : Q) : H) * n
          = ((n : H) * ((v : G').left : Q) * (n : H)⁻¹) * n := by rw [h2]
        _ = n * (((v : G').left : Q) : H) := by group
    let g : C' →* ↥(Q ⊓ Subgroup.centralizer {(n : H)}) :=
      { toFun := fun v => ⟨(((v : G').left : Q) : H), hmemC v⟩
        map_one' := rfl
        map_mul' := by
          intro v₁ v₂
          apply Subtype.ext
          change ((((v₁ : G') * (v₂ : G')).left : Q) : H) = _
          rw [SemidirectProduct.mul_left]
          have hr : (v₁ : G').right = 1 := by rw [hleft v₁]; rfl
          rw [hr]
          rfl }
    have hg : Function.Injective g := by
      intro v₁ v₂ h
      have h0 : ((g v₁ : ↥(Q ⊓ Subgroup.centralizer {(n : H)})) : H) = (g v₂ : H) :=
        congrArg Subtype.val h
      have h1 : (v₁ : G').left = (v₂ : G').left := Subtype.ext h0
      apply Subtype.ext
      rw [hleft v₁, hleft v₂, h1]
    have h1 := CFSG.RankThree.OddKernel.pRank_le_of_injective hq.out.one_lt g hg
    have h2 := hloc Q hQq n hn1 hn2
    have h3 : CFSG.Assembly.pRank q C' = CFSG.pRank q ↥C' :=
      ((CFSG.SectionRank.pRank_eq_open_pRank_top q ↥C').trans
        (CFSG.SectionRank.pRank_eq_pRank_top_subgroup C').symm).symm
    rw [h3]
    exact h1.trans h2
  have h5 := rank3II_3_6_pow hq.out hq2 hp hp3 hP'q hU'2 hX'eq hX'p hU'X' hU'1 (hnorm U')
    (hnorm X') hfaith hfix
  exact hp5 h5

end Faithful

section Main

variable {H : Type} [Group H] [Finite H]

theorem mem_pCore_two_of_mem [Group.IsPerfect H] {n : ℕ}
    (hSz : SuzukiModel (H ⧸ aschbacherSolvableCore 3 H) 2 n)
    (hloc : ∀ q : ℕ, q.Prime → 3 < q → ∀ Q : Subgroup H, IsPGroup q Q → ∀ u : H, u ≠ 1 →
      IsPGroup 2 (Subgroup.zpowers u) → CFSG.pRank q ↥(Q ⊓ Subgroup.centralizer {u}) ≤ 2)
    {x : H} (hx : x ∈ aschbacherSolvableCore 3 H) (hx2 : IsPGroup 2 (Subgroup.zpowers x)) :
    x ∈ CFSG.pCore 2 H := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set θ := aschbacherSolvableCore 3 H with hθdef
  set R := CFSG.pCore 2 H with hRdef
  obtain ⟨hθs, -, hθ3, -, -, -, hθmax⟩ :=
    solvable_prime_complement_core_characterization (H := H) Nat.prime_three
  have hRθ : R ≤ θ := hθmax 2 Nat.prime_two (by norm_num)
  by_contra hxR
  set π := QuotientGroup.mk' R with hπ
  set Θ := θ.map π with hΘ
  have hΘn : Θ.Normal := Subgroup.Normal.map inferInstance π (QuotientGroup.mk'_surjective R)
  have hΘs : Group.IsSolvable Θ := Group.isSolvable_of_surjective (π.subgroupMap_surjective θ)
  have hO2 : CFSG.pCore 2 (H ⧸ R) = ⊥ := CFSG.ABGLocalTools.pCore_quotient_pCore_eq_bot
  have hnormal2 : ∀ N : Subgroup (H ⧸ R), N.Normal → IsPGroup 2 N → N = ⊥ := fun N hN hN2 =>
    le_bot_iff.mp (hO2 ▸ le_sSup ⟨hN, hN2⟩)
  have hcent_bot : Subgroup.centralizer ((⊥ : Subgroup (H ⧸ R)) : Set (H ⧸ R)) = ⊤ :=
    eq_top_iff.mpr fun g _ => Subgroup.mem_centralizer_iff.mpr fun h hh => by
      rw [(Subgroup.mem_bot).mp hh, one_mul, mul_one]
  have hc : ¬ Θ ≤ Subgroup.center (H ⧸ R) := by
    intro hc
    apply hxR
    have hxc : π x ∈ Subgroup.center (H ⧸ R) := hc ⟨x, hx, rfl⟩
    have hN : (Subgroup.zpowers (π x)).Normal := ⟨fun w hw g => by
      have hwc : w ∈ Subgroup.center (H ⧸ R) := (Subgroup.zpowers_le.mpr hxc) hw
      rw [Subgroup.mem_center_iff.mp hwc g, mul_inv_cancel_right]
      exact hw⟩
    have h2 : IsPGroup 2 (Subgroup.zpowers (π x)) := by
      rw [← MonoidHom.map_zpowers]
      exact hx2.map π
    have h0 := hnormal2 _ hN h2
    rw [Subgroup.zpowers_eq_bot, hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h0
    exact h0
  have hΘ3 : ¬ 3 ∣ Nat.card Θ := fun h3 => hθ3 (h3.trans (Subgroup.card_map_dvd θ π))
  have hcore_bot : ∀ r : ℕ, r.Prime → ¬ r ∣ Nat.card Θ → CFSG.pCore r Θ = ⊥ := by
    intro r hr hrΘ
    have : Fact r.Prime := ⟨hr⟩
    rw [← Subgroup.card_eq_one]
    rcases (CFSG.pCore_isPGroup (p := r) (G := Θ)).card_eq_or_dvd with h1 | h1
    · exact h1
    · exact absurd (h1.trans (Subgroup.card_subgroup_dvd_card _)) hrΘ
  obtain ⟨r, hr, hrc⟩ := Steps166.exists_pCore_centralizer_ne_top hΘs hc
  have : Fact r.Prime := ⟨hr⟩
  have hr2 : r ≠ 2 := by
    rintro rfl
    apply hrc
    have hN : ((CFSG.pCore 2 Θ).map Θ.subtype).Normal := inferInstance
    rw [hnormal2 _ hN (CFSG.pCore_isPGroup.map Θ.subtype)]
    exact hcent_bot
  have hr3 : r ≠ 3 := by
    rintro rfl
    apply hrc
    rw [hcore_bot 3 Nat.prime_three hΘ3, Subgroup.map_bot]
    exact hcent_bot
  have hr3' : 3 < r := by
    have := hr.two_le
    omega
  obtain ⟨-, a, ha, F, _, _, hn, hF, ⟨e⟩⟩ := hSz
  rw [hn] at hF
  have : ((CFSG.pCore r Θ).map Θ.subtype).Normal := inferInstance
  exact false_of_noncentral_pCore_pow hRθ hθs ha hF e hr2 (CFSG.pCore_isPGroup.map Θ.subtype)
    hrc (hloc r hr hr3')

end Main

