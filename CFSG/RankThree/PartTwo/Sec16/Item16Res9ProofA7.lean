variable {G : Type} [Group G] [Finite G]

theorem zpowers_eq_of_mem {F : Subgroup G} (hF : Nat.card F = 3) {y : G} (hy : y ∈ F)
    (hy1 : y ≠ 1) : Subgroup.zpowers y = F := by
  have hle : Subgroup.zpowers y ≤ F := Subgroup.zpowers_le.mpr hy
  have hdvd : orderOf y ∣ 3 := hF ▸ Subgroup.orderOf_dvd_natCard F hy
  have hord : orderOf y = 3 := by
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · exact absurd (orderOf_eq_one_iff.mp h1) hy1
    · exact h3
  refine Subgroup.eq_of_le_of_card_ge hle ?_
  rw [hF, Nat.card_zpowers, hord]

theorem map_conj_sq_eq_of_ncard {A F : Subgroup G} {c l : G} (hΩ3 : (omegaA A).ncard = 3)
    (hc : Subgroup.zpowers c ∈ omegaA A) (hlN : l ∈ Subgroup.normalizer (A : Set G))
    (hlc : l * c * l⁻¹ = c) (hF : F ∈ omegaA A) (hFc : F ≠ Subgroup.zpowers c) :
    F.map (MulAut.conj (l ^ 2)).toMonoidHom = F := by
  set f : Subgroup G → Subgroup G := fun K => K.map (MulAut.conj l).toMonoidHom with hf
  have hfinj : Function.Injective f := Subgroup.map_injective (MulAut.conj l).injective
  have hfΩ : ∀ K ∈ omegaA A, f K ∈ omegaA A := fun K hK => (map_conj_mem_omegaA_iff hlN).mpr hK
  have hfc : f (Subgroup.zpowers c) = Subgroup.zpowers c := by
    simp only [hf, MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, hlc]
  have hsq : F.map (MulAut.conj (l ^ 2)).toMonoidHom = f (f F) := by
    simp only [hf, Late.map_conj_map_conj, pow_two]
  rw [hsq]
  set F₁ := f F with hF₁
  have hF₁Ω : F₁ ∈ omegaA A := hfΩ F hF
  have hF₂Ω : f F₁ ∈ omegaA A := hfΩ F₁ hF₁Ω
  have hF₁c : F₁ ≠ Subgroup.zpowers c := fun h => hFc (hfinj (h.trans hfc.symm))
  have hF₂c : f F₁ ≠ Subgroup.zpowers c := fun h => hF₁c (hfinj (h.trans hfc.symm))
  by_cases h1 : F₁ = F
  · rw [h1]
    exact h1
  by_contra h2
  have h21 : f F₁ ≠ F₁ := fun h => h1 (hfinj h)
  have hsub : ({Subgroup.zpowers c, F, F₁, f F₁} : Set (Subgroup G)) ⊆ omegaA A := by
    intro K hK
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hK
    rcases hK with rfl | rfl | rfl | rfl
    exacts [hc, hF, hF₁Ω, hF₂Ω]
  have hcard : ({Subgroup.zpowers c, F, F₁, f F₁} : Set (Subgroup G)).ncard = 4 := by
    rw [Set.ncard_insert_of_notMem, Set.ncard_insert_of_notMem, Set.ncard_pair h21.symm]
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨fun h => h1 h.symm, fun h => h2 h.symm⟩
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨fun h => hFc h.symm, fun h => hF₁c h.symm, fun h => hF₂c h.symm⟩
  have := Set.ncard_le_ncard hsub (Set.toFinite _)
  omega

theorem exists_sq_inv
    (h131 : Item131) {A L : Subgroup G} {c : G}
    (hD : Sec13Data G A c L)
    (φ : ↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* alternatingGroup (Fin 7)) :
    c ∉ L ∧ Nat.card (A ⊓ L : Subgroup G) = 9 ∧
      ∃ l ∈ L ⊓ Subgroup.normalizer (A : Set G), ∀ x ∈ A ⊓ L, l ^ 2 * x * (l ^ 2)⁻¹ = x⁻¹ := by
  obtain ⟨-, hZ4, hcL, h9⟩ := Sec13.Res4Proof.facts131_of_alt7 h131 hD φ
  refine ⟨hcL, h9, ?_⟩
  have hAa := eq_sup_of_card_nine hD h9 (fun h => hcL h.2)
  obtain ⟨τ, hτ, h4, h2⟩ := exists_order_four_of_cases (P := False) (R := False)
    (Or.inr (Or.inl ⟨trivial, hZ4⟩))
  obtain ⟨ρ, hρ, hρ4, hρ2⟩ := exists_order_four_restrict hD hAa hτ h4 h2
  obtain ⟨l, hlN, hlLW, rfl⟩ := Sec4.mem_autIn_iff.mp hρ
  have hBe : CFSG.Assembly.IsElemAbelian 3 (A ⊓ L) :=
    ⟨⟨⟨fun x y => Subtype.ext (hD.commute x.2.1 y.2.1)⟩⟩, fun x hx => hD.isElemAbelian.2 x hx.1⟩
  refine ⟨l, hlLW, fun x hx => ?_⟩
  have h1 := Proof1413Res3.sq_eq_inv_of_order_four hBe h9 hρ4 hρ2 ⟨x, hx⟩
  have h2' := congrArg Subtype.val h1
  rw [normalizerMonoidHom_pow_apply_val] at h2'
  simpa using h2'

theorem mem_of_mem_omegaA
    (h131 : Item131) {A L : Subgroup G} {c : G}
    (hD : Sec13Data G A c L)
    (h7 : Nonempty (↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* alternatingGroup (Fin 7)))
    (hΩ3 : (omegaA A).ncard = 3) {b : G} (hb : Subgroup.zpowers b ∈ omegaA A)
    (hbc : Subgroup.zpowers b ≠ Subgroup.zpowers c) : b ∈ L := by
  obtain ⟨φ⟩ := h7
  obtain ⟨hcL, h9, l, hlLW, hinv⟩ := exists_sq_inv h131 hD φ
  have hAa := eq_sup_of_card_nine hD h9 (fun h => hcL h.2)
  have hlc : l * c * l⁻¹ = c := by
    rw [Subgroup.mem_centralizer_singleton_iff.mp (hD.le_centralizer hlLW.1), mul_inv_cancel_right]
  have hl2c : l ^ 2 * c * (l ^ 2)⁻¹ = c := by
    rw [Subgroup.mem_centralizer_singleton_iff.mp (hD.le_centralizer (L.pow_mem hlLW.1 2)),
      mul_inv_cancel_right]
  have hFix := map_conj_sq_eq_of_ncard hΩ3 hD.zpowers_mem_omegaA hlLW.2 hlc hb hbc
  have hmem : l ^ 2 * b * (l ^ 2)⁻¹ ∈ Subgroup.zpowers b := by
    rw [← hFix]
    exact ⟨b, Subgroup.mem_zpowers b, rfl⟩
  have hbA : b ∈ A := hb.1 (Subgroup.mem_zpowers b)
  obtain ⟨i, -, e, he, hbe⟩ := exists_pow_mul_of_mem hD.isElemAbelian hD.mem_A hAa hbA
  have hci : c ^ i ∈ A := A.pow_mem hD.mem_A i
  have hcomm : c ^ i * e = e * c ^ i := hD.commute hci he.1
  have hconj : l ^ 2 * b * (l ^ 2)⁻¹ = c ^ i * e⁻¹ := by
    rw [hbe]
    calc l ^ 2 * (c ^ i * e) * (l ^ 2)⁻¹ =
        (l ^ 2 * c * (l ^ 2)⁻¹) ^ i * (l ^ 2 * e * (l ^ 2)⁻¹) := by
          rw [← MulAut.conj_apply, ← MulAut.conj_apply, ← MulAut.conj_apply, map_mul, map_pow]
      _ = c ^ i * e⁻¹ := by rw [hl2c, hinv e he]
  have hc2 : c ^ i * c ^ i ∈ Subgroup.zpowers b := by
    have h1 : b * (l ^ 2 * b * (l ^ 2)⁻¹) ∈ Subgroup.zpowers b :=
      mul_mem (Subgroup.mem_zpowers b) hmem
    have h2 : b * (l ^ 2 * b * (l ^ 2)⁻¹) = c ^ i * c ^ i := by
      rw [hconj, hbe]
      calc c ^ i * e * (c ^ i * e⁻¹) = c ^ i * (e * c ^ i) * e⁻¹ := by group
        _ = c ^ i * (c ^ i * e) * e⁻¹ := by rw [hcomm]
        _ = c ^ i * c ^ i := by group
    rwa [h2] at h1
  have hci1 : c ^ i = 1 := by
    by_contra hne
    have hne2 : c ^ i * c ^ i ≠ 1 := by
      intro h1
      apply hne
      have h3 : (c ^ i) ^ 3 = 1 := hD.isElemAbelian.2 _ hci
      calc c ^ i = (c ^ i) ^ 3 * (c ^ i * c ^ i)⁻¹ := by group
        _ = 1 := by rw [h3, h1]; group
    have hcard : Nat.card (Subgroup.zpowers b) = 3 := hb.2.1
    have h1 := zpowers_eq_of_mem hcard hc2 hne2
    have h2 : c ^ i * c ^ i ∈ Subgroup.zpowers c := by
      rw [← pow_add]
      exact Subgroup.npow_mem_zpowers c _
    have h3 := zpowers_eq_of_mem hD.card_zpowers h2 hne2
    exact hbc (h1.symm.trans h3)
  rw [hbe, hci1, one_mul]
  exact he.2

end Res9A7

