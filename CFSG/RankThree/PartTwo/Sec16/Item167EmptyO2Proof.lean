        (((img148 A D.N D.R ⊔ Subgroup.centralizer (img148 A D.N D.J :
            Set (↥(D.N ⊔ A) ⧸ Sec14.ker148 A D.N))) ⊓ img148 A D.N D.J).subgroupOf
