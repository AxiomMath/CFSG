  have hxC : QuotientGroup.mk' (Sec14.ker148 A D.N)
      ⟨r, Subgroup.mem_sup_left (D.hYN (D.hXY (D.hXR r.2)))⟩ ∈
      Subgroup.centralizer (img148 A D.N D.J :
        Set (↥(D.N ⊔ A) ⧸ Sec14.ker148 A D.N)) := by
