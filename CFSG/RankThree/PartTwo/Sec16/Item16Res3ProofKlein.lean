    simp [sMat2, fe_one, fe_zero, fe_four, Matrix.one_apply] <;> ring

private theorem sMat1_mul_sMat2_eq :
    sMat1 * sMat2 = !![fe 4 0, fe 0 0, fe 0 0;
      fe 0 0, fe 4 0, fe 0 0; fe 0 0, fe 0 0, fe 1 0] := by decide +kernel

private theorem diagonal_smul_s12 (μ : F25) :
    (Matrix.diagonal ![-μ, -μ, μ] : Matrix (Fin 3) (Fin 3) F25) = μ • (sMat1 * sMat2) := by
  rw [sMat1_mul_sMat2_eq]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [fe_one, fe_zero, fe_four, Matrix.one_apply] <;> ring

private theorem mem_kD_of_matrix_eq_smul {B D : SU5} {μ : F25}
    (hD : (D : PU5) = 1 ∨ (D : PU5) = k1 ∨ (D : PU5) = k2 ∨ (D : PU5) = k1 * k2)
    (h : M[B] = μ • M[D]) : (B : PU5) ∈ kD := by
  have hBD : (B : PU5) = (D : PU5) := mk_eq_mk_of_smul h
  rw [mem_kD_iff, hBD]
  exact hD

private theorem diagonal_mem_kD_of_pow_two {B : SU5}
    (hdiag : M[B] = Matrix.diagonal ![M[B] 0 0, M[B] 1 1, M[B] 2 2])
    (ha : M[B] 0 0 ^ 6 = 1) (hb : M[B] 1 1 ^ 6 = 1) (hd : M[B] 2 2 ^ 6 = 1)
    (hdet : M[B] 0 0 * M[B] 1 1 * M[B] 2 2 = 1) (hg6 : (B : PU5) ^ 6 = 1)
    {n : ℕ} (hn : (B : PU5) ^ 2 ^ (n + 1) = 1) : (B : PU5) ∈ kD := by
  have hg2 : (B : PU5) ^ 2 = 1 := by
    have h := (pow_gcd_eq_one (a := (B : PU5)) (m := 6) (n := 2 ^ (n + 1))).mpr ⟨hg6, hn⟩
    rw [U35A6.gcd_six_two_pow n] at h
    exact h
  have hB2 : ∃ μ : F25, M[B] ^ 2 = μ • 1 := by
    have h : ((B ^ 2 : SU5) : PU5) = 1 := by
      rw [QuotientGroup.mk_pow, hg2]
    rw [QuotientGroup.eq_one_iff, mem_unitaryScalars] at h
    obtain ⟨c, -, -, hc⟩ := h
    refine ⟨(c : F25), ?_⟩
    have hc' : ((B ^ 2 : SU5) : GL (Fin 3) F25) = GeneralLinearGroup.scalar (Fin 3) c := hc
    rw [Subgroup.coe_pow] at hc'
    have h2 := congrArg (fun x : GL (Fin 3) F25 =>
      ((x : Matrix (Fin 3) (Fin 3) F25))) hc'
    simpa [GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, ← Matrix.smul_one_eq_diagonal]
      using h2
  obtain ⟨μ, hμ⟩ := hB2
  have hsq0 : M[B] 0 0 ^ 2 = M[B] 1 1 ^ 2 := by
    have h1 : (Matrix.diagonal ![M[B] 0 0, M[B] 1 1, M[B] 2 2] :
        Matrix (Fin 3) (Fin 3) F25) ^ 2 = μ • 1 := by
      rw [← hdiag]
      exact hμ
    rw [Matrix.diagonal_pow] at h1
    have e0 := congrFun (congrFun h1 0) 0
    have e1 := congrFun (congrFun h1 1) 1
    simp [Matrix.one_apply] at e0 e1
    rw [e0, e1]
  have hsq1 : M[B] 1 1 ^ 2 = M[B] 2 2 ^ 2 := by
    have h1 : (Matrix.diagonal ![M[B] 0 0, M[B] 1 1, M[B] 2 2] :
        Matrix (Fin 3) (Fin 3) F25) ^ 2 = μ • 1 := by
      rw [← hdiag]
      exact hμ
    rw [Matrix.diagonal_pow] at h1
    have e1 := congrFun (congrFun h1 1) 1
    have e2 := congrFun (congrFun h1 2) 2
    simp [Matrix.one_apply] at e1 e2
    rw [e1, e2]
  obtain ⟨ν, hν⟩ := diag_exists_smul_sign (M[B] 0 0) (M[B] 1 1) (M[B] 2 2) ha hb hd hdet
    hsq0 hsq1
  rcases hν with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩
  · refine mem_kD_of_matrix_eq_smul (D := 1) (μ := ν) (Or.inl rfl) ?_
    rw [hdiag, h1, h2, h3]
    simpa using diagonal_smul_one ν
  · refine mem_kD_of_matrix_eq_smul (D := s1) (μ := ν) (Or.inr (Or.inl rfl)) ?_
    rw [hdiag, h1, h2, h3]
    simpa [coe_s1] using diagonal_smul_sMat1 ν
  · refine mem_kD_of_matrix_eq_smul (D := s2) (μ := ν) (Or.inr (Or.inr (Or.inl rfl))) ?_
    rw [hdiag, h1, h2, h3]
    simpa [coe_s2] using diagonal_smul_sMat2 ν
  · refine mem_kD_of_matrix_eq_smul (D := s1 * s2) (μ := ν)
      (Or.inr (Or.inr (Or.inr ?_))) ?_
    · rw [QuotientGroup.mk_mul]
    · rw [hdiag, h1, h2, h3, coe_mul, coe_s1, coe_s2]
      exact diagonal_smul_s12 ν

private theorem diagonal_case {B : SU5}
    (hpat : ∀ i j : Fin 3, M[B] i j ≠ 0 → (i : ℕ) = (j : ℕ)) {n : ℕ}
    (hn : (B : PU5) ^ 2 ^ n = 1) : (B : PU5) ∈ kD := by
  have hz : ∀ i j : Fin 3, i ≠ j → M[B] i j = 0 := by
    intro i j hij
    by_contra h
    exact hij (Fin.ext (hpat i j h))
  have hdiag : M[B] = Matrix.diagonal ![M[B] 0 0, M[B] 1 1, M[B] 2 2] := by
    ext i j
    by_cases h : i = j
    · rw [h, Matrix.diagonal_apply_eq]
      fin_cases j <;> simp
    · rw [hz i j h, Matrix.diagonal_apply_ne _ h]
  have hu : ((Matrix.diagonal ![M[B] 0 0, M[B] 1 1, M[B] 2 2] :
      Matrix (Fin 3) (Fin 3) F25).map hF.bar)ᵀ *
      Matrix.diagonal ![M[B] 0 0, M[B] 1 1, M[B] 2 2] = 1 := by
    rw [← hdiag]
    exact ((mem_unitarySU_iff hF).1 B.2).2
  obtain ⟨ha, hb, hd⟩ := diagonal_unit_pow_six hu
  have hdet : M[B] 0 0 * M[B] 1 1 * M[B] 2 2 = 1 := by
    have h := ((mem_unitarySU_iff hF).1 B.2).1
    rw [hdiag, Matrix.det_diagonal, Fin.prod_univ_three] at h
    simpa using h
  have hB6 : M[B] ^ 6 = 1 := by
    rw [hdiag, Matrix.diagonal_pow]
    have hv : (![M[B] 0 0, M[B] 1 1, M[B] 2 2] : Fin 3 → F25) ^ 6 = fun _ => 1 := by
      funext i
      fin_cases i <;> simp [ha, hb, hd]
    rw [hv, Matrix.diagonal_one]
  have hg6 : (B : PU5) ^ 6 = 1 := by
    have h' : ((B ^ 6 : SU5) : PU5) = ((1 : SU5) : PU5) := by
      apply mk_eq_mk_of_smul (c := 1)
      rw [coe_pow, hB6]
      simp
    rwa [QuotientGroup.mk_pow, QuotientGroup.mk_one] at h'
  rcases n with - | n
  · have h1 : (B : PU5) = 1 := by simpa using hn
    exact mem_kD_iff.mpr (Or.inl h1)
  · exact diagonal_mem_kD_of_pow_two hdiag ha hb hd hdet hg6 hn

theorem mem_kD_of_commute {g : PU5} (hg : g * x1 = x1 * g) {n : ℕ} (hn : g ^ 2 ^ n = 1) :
    g ∈ kD := by
  obtain ⟨B, hB⟩ := QuotientGroup.mk_surjective g
  have hrel : ((B * g1 : SU5) : PU5) = ((g1 * B : SU5) : PU5) := by
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, hB]
    exact hg
  obtain ⟨c, hc⟩ := exists_smul_of_mk_eq hrel
  have hBdet : (M[B]).det = 1 := ((mem_unitarySU_iff hF).1 B.2).1
  have hc3 : c ^ 3 = 1 := by
    have h := congrArg Matrix.det hc
    rw [coe_mul, coe_mul, coe_g1, Matrix.det_mul, Matrix.det_smul, Fintype.card_fin,
      Matrix.det_mul, det_dMat, hBdet] at h
    simpa using h.symm
  obtain ⟨k, hk⟩ := exists_eq_om_pow c hc3
  have hpat : ∀ i j : Fin 3, M[B] i j ≠ 0 → (i : ℕ) = ((j : ℕ) + (k : ℕ)) % 3 := by
    intro i j hij
    have e := congrFun (congrFun hc i) j
    rw [coe_mul, coe_mul, coe_g1, smul_entry, dMat_mul_apply, mul_dMat_apply, hk] at e
    rw [vec_diag, vec_diag] at e
    have e1 : om ^ (i : ℕ) * M[B] i j = om ^ ((k : ℕ) + (j : ℕ)) * M[B] i j := by
      rw [e, pow_add]
      ring
    exact om_pow_eq_mod i j k (mul_right_cancel₀ hij e1)
  by_cases hk0 : k = 0
  · have hpat' : ∀ i j : Fin 3, M[B] i j ≠ 0 → (i : ℕ) = (j : ℕ) := by
      intro i j hij
      have h := hpat i j hij
      rw [hk0] at h
      simpa [Nat.mod_eq_of_lt j.isLt] using h
    rw [← hB]
    exact diagonal_case hpat' (by rwa [← hB] at hn)
  · exact (false_of_ne_zero hk0 hpat (by rwa [← hB] at hn)).elim

theorem le_kD_of_le_centralizer {W : Subgroup PU5} (hW : IsPGroup 2 W)
    (hWC : W ≤ Subgroup.centralizer ({x1} : Set PU5)) : W ≤ kD := by
  intro w hw
  have hcomm : w * x1 = x1 * w :=
    (Subgroup.mem_centralizer_iff.mp (hWC hw) x1 (Set.mem_singleton x1)).symm
  obtain ⟨k, hk⟩ := hW ⟨w, hw⟩
  have hwk : w ^ 2 ^ k = 1 := by
    have h := congrArg (fun x : W => (x : PU5)) hk
    simpa using h
  exact mem_kD_of_commute hcomm hwk

theorem eq_bot_or_eq_kD {W : Subgroup PU5} (hWk : W ≤ kD)
    (hx2 : x2 ∈ Subgroup.normalizer (W : Set PU5)) : W = ⊥ ∨ W = kD := by
  rcases W.bot_or_exists_ne_one with hbot | ⟨g, hgW, hg1⟩
  · exact Or.inl hbot
  right
  have hconj : ∀ w ∈ W, x2 * w * x2⁻¹ ∈ W := fun w hw =>
    (Subgroup.mem_normalizer_iff.mp hx2 w).mp hw
  have hgk : g ∈ kD := hWk hgW
  rw [mem_kD_iff] at hgk
  have hk1k2 : k1 ∈ W ∧ k2 ∈ W := by
    rcases hgk with rfl | rfl | rfl | rfl
    · exact absurd rfl hg1
    · refine ⟨hgW, ?_⟩
      have h := hconj k1 hgW
      rwa [x2_mul_k1] at h
    · refine ⟨?_, hgW⟩
      · have h2 := hconj k2 hgW
        rw [x2_mul_k2] at h2
        have h := hconj (k1 * k2) h2
        rwa [x2_mul_k12] at h
    · refine ⟨?_, ?_⟩
      · have h := hconj (k1 * k2) hgW
        rwa [x2_mul_k12] at h
      · have h := hconj (k1 * k2) hgW
        rw [x2_mul_k12] at h
        have h2 := hconj k1 h
        rwa [x2_mul_k1] at h2
  have hle : kD ≤ W := by
    rw [kD, Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact hk1k2.1
    · exact hk1k2.2
  exact le_antisymm hWk hle

