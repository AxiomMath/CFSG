@[expose] def sMat1 : Matrix (Fin 3) (Fin 3) F25 :=
  !![fe 1 0, fe 0 0, fe 0 0; fe 0 0, fe 4 0, fe 0 0; fe 0 0, fe 0 0, fe 4 0]

@[expose] def sMat2 : Matrix (Fin 3) (Fin 3) F25 :=
  !![fe 4 0, fe 0 0, fe 0 0; fe 0 0, fe 1 0, fe 0 0; fe 0 0, fe 0 0, fe 4 0]

local notation "M[" g "]" => ((g : GL (Fin 3) F25) : Matrix (Fin 3) (Fin 3) F25)

noncomputable def s1 : SU5 :=
  mkSU sMat1 (by rw [det_eq_det3]; decide +kernel) (by decide +kernel)

noncomputable def s2 : SU5 :=
  mkSU sMat2 (by rw [det_eq_det3]; decide +kernel) (by decide +kernel)

theorem coe_s1 : M[s1] = sMat1 :=
  coe_mkSU _ _ _

theorem coe_s2 : M[s2] = sMat2 :=
  coe_mkSU _ _ _

noncomputable abbrev k1 : PU5 := (s1 : PU5)

noncomputable abbrev k2 : PU5 := (s2 : PU5)

@[expose] noncomputable def kD : Subgroup PU5 := Subgroup.closure {k1, k2}

private theorem sMat1_mul_self : sMat1 * sMat1 = 1 := by decide +kernel

private theorem sMat2_mul_self : sMat2 * sMat2 = 1 := by decide +kernel

private theorem sMat1_comm_sMat2 : sMat1 * sMat2 = sMat2 * sMat1 := by decide +kernel

private theorem sMat1_ne_scalar : ∀ c : F25, sMat1 ≠ c • 1 := by decide +kernel

private theorem sMat2_ne_scalar : ∀ c : F25, sMat2 ≠ c • 1 := by decide +kernel

private theorem sMat2_ne_smul_sMat1 : ∀ c : F25, sMat2 ≠ c • sMat1 := by decide +kernel

theorem k1_mul_self : k1 * k1 = 1 := by
  have h : ((s1 * s1 : SU5) : PU5) = ((1 : SU5) : PU5) := by
    apply mk_eq_mk_of_smul (c := 1)
    rw [coe_mul, coe_s1, sMat1_mul_self, one_smul]
    simp
  rwa [QuotientGroup.mk_mul, QuotientGroup.mk_one] at h

theorem k2_mul_self : k2 * k2 = 1 := by
  have h : ((s2 * s2 : SU5) : PU5) = ((1 : SU5) : PU5) := by
    apply mk_eq_mk_of_smul (c := 1)
    rw [coe_mul, coe_s2, sMat2_mul_self, one_smul]
    simp
  rwa [QuotientGroup.mk_mul, QuotientGroup.mk_one] at h

theorem k1_commute_k2 : Commute k1 k2 := by
  have h : ((s1 * s2 : SU5) : PU5) = ((s2 * s1 : SU5) : PU5) := by
    apply mk_eq_mk_of_smul (c := 1)
    rw [coe_mul, coe_mul, coe_s1, coe_s2, sMat1_comm_sMat2, one_smul]
  rwa [QuotientGroup.mk_mul, QuotientGroup.mk_mul] at h

theorem k1_ne_one : k1 ≠ 1 := by
  refine mk_ne_one_of (g := s1) fun c => ?_
  rw [coe_s1]
  exact sMat1_ne_scalar c

theorem k2_ne_one : k2 ≠ 1 := by
  refine mk_ne_one_of (g := s2) fun c => ?_
  rw [coe_s2]
  exact sMat2_ne_scalar c

theorem k1_ne_k2 : k1 ≠ k2 := by
  intro h
  obtain ⟨c, hc⟩ := exists_smul_of_mk_eq (g := s1) (k := s2) h
  rw [coe_s1, coe_s2] at hc
  exact sMat2_ne_smul_sMat1 c hc

private theorem kD_eq_klein :
    kD = CFSG.GorensteinWalter.kleinFourOfCommutingInvolutions k1 k2 k1_mul_self k2_mul_self
      k1_commute_k2 := by
  apply le_antisymm
  · rw [kD, Subgroup.closure_le]
    intro g hg
    change g ∈ ({k1 * k2, k1, k2, 1} : Set PU5)
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg ⊢
    rcases hg with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr (Or.inl rfl))
  · intro g hg
    change g ∈ ({k1 * k2, k1, k2, 1} : Set PU5) at hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl | rfl | rfl
    · exact kD.mul_mem (Subgroup.subset_closure (by simp)) (Subgroup.subset_closure (by simp))
    · exact Subgroup.subset_closure (by simp)
    · exact Subgroup.subset_closure (by simp)
    · exact kD.one_mem

theorem mem_kD_iff {g : PU5} : g ∈ kD ↔ g = 1 ∨ g = k1 ∨ g = k2 ∨ g = k1 * k2 := by
  rw [kD_eq_klein]
  change g ∈ ({k1 * k2, k1, k2, 1} : Set PU5) ↔ g = 1 ∨ g = k1 ∨ g = k2 ∨ g = k1 * k2
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  tauto

theorem card_kD : Nat.card kD = 4 := by
  rw [kD_eq_klein]
  exact (CFSG.GorensteinWalter.isKleinFour_kleinFourOfCommutingInvolutions k1 k2 k1_mul_self
    k2_mul_self k1_ne_one k2_ne_one k1_ne_k2 k1_commute_k2).card_four

private theorem cMat_mul_sMat1 : U35A6.cMat * sMat1 = sMat2 * U35A6.cMat := by decide +kernel

private theorem cMat_mul_sMat2 :
    U35A6.cMat * sMat2 = (sMat1 * sMat2) * U35A6.cMat := by decide +kernel

private theorem x2_mul_k1_mul : x2 * k1 = k2 * x2 := by
  have h : ((g2 * s1 : SU5) : PU5) = ((s2 * g2 : SU5) : PU5) := by
    apply mk_eq_mk_of_smul (c := 1)
    rw [coe_mul, coe_mul, coe_s1, coe_s2, coe_g2, one_smul]
    exact cMat_mul_sMat1
  rwa [QuotientGroup.mk_mul, QuotientGroup.mk_mul] at h

private theorem x2_mul_k2_mul : x2 * k2 = (k1 * k2) * x2 := by
  have h : ((g2 * s2 : SU5) : PU5) = (((s1 * s2) * g2 : SU5) : PU5) := by
    apply mk_eq_mk_of_smul (c := 1)
    rw [coe_mul, coe_mul, coe_mul, coe_s1, coe_s2, coe_g2, one_smul]
    exact cMat_mul_sMat2
  rwa [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul] at h

theorem x2_mul_k1 : x2 * k1 * x2⁻¹ = k2 := by
  calc x2 * k1 * x2⁻¹ = (k2 * x2) * x2⁻¹ := by rw [x2_mul_k1_mul]
    _ = k2 := by group

theorem x2_mul_k2 : x2 * k2 * x2⁻¹ = k1 * k2 := by
  calc x2 * k2 * x2⁻¹ = ((k1 * k2) * x2) * x2⁻¹ := by rw [x2_mul_k2_mul]
    _ = k1 * k2 := by group

private theorem k2_mul_k1k2 : k2 * (k1 * k2) = k1 := by
  rw [← mul_assoc, ← k1_commute_k2.eq, mul_assoc, k2_mul_self, mul_one]

private theorem x2_mul_k12 : x2 * (k1 * k2) * x2⁻¹ = k1 := by
  calc x2 * (k1 * k2) * x2⁻¹ = (x2 * k1 * x2⁻¹) * (x2 * k2 * x2⁻¹) := by group
    _ = k2 * (k1 * k2) := by rw [x2_mul_k1, x2_mul_k2]
    _ = k1 := k2_mul_k1k2

private theorem vec_diag (i : Fin 3) : (![1, om, om ^ 2] : Fin 3 → F25) i = om ^ (i : ℕ) := by
  fin_cases i <;> simp

private theorem om_pow_eq_mod : ∀ i j k : Fin 3,
    om ^ (i : ℕ) = om ^ ((k : ℕ) + (j : ℕ)) → (i : ℕ) = ((j : ℕ) + (k : ℕ)) % 3 := by
  decide +kernel

private theorem smul_entry (c : F25) (M : Matrix (Fin 3) (Fin 3) F25) (i j : Fin 3) :
    (c • M) i j = c * M i j := rfl

private theorem cube_eq_smul_one_of_shape₁ {B : Matrix (Fin 3) (Fin 3) F25}
    (h00 : B 0 0 = 0) (h01 : B 0 1 = 0) (h11 : B 1 1 = 0) (h12 : B 1 2 = 0)
    (h20 : B 2 0 = 0) (h22 : B 2 2 = 0) :
    B ^ 3 = (B 0 2 * B 1 0 * B 2 1) • 1 := by
  have hB : B = !![0, 0, B 0 2; B 1 0, 0, 0; 0, B 2 1, 0] := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp_all
  rw [hB]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [pow_three, Matrix.mul_apply, Fin.sum_univ_three, Matrix.one_apply] <;> ring

private theorem cube_eq_smul_one_of_shape₂ {B : Matrix (Fin 3) (Fin 3) F25}
    (h00 : B 0 0 = 0) (h02 : B 0 2 = 0) (h10 : B 1 0 = 0) (h11 : B 1 1 = 0)
    (h21 : B 2 1 = 0) (h22 : B 2 2 = 0) :
    B ^ 3 = (B 0 1 * B 1 2 * B 2 0) • 1 := by
  have hB : B = !![0, B 0 1, 0; 0, 0, B 1 2; B 2 0, 0, 0] := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp_all
  rw [hB]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [pow_three, Matrix.mul_apply, Fin.sum_univ_three, Matrix.one_apply] <;> ring

private theorem eq_one_of_cube_eq_smul_one {B : SU5} {μ : F25}
    (h : M[B] ^ 3 = μ • 1) : (B : PU5) ^ 3 = 1 := by
  have h' : ((B ^ 3 : SU5) : PU5) = ((1 : SU5) : PU5) := by
    apply mk_eq_mk_of_smul (c := μ)
    rw [coe_pow, h]
    simp
  rwa [QuotientGroup.mk_pow, QuotientGroup.mk_one] at h'

private theorem eq_one_of_pow_three_of_pow_two {g : PU5} {n : ℕ} (h3 : g ^ 3 = 1)
    (hn : g ^ 2 ^ n = 1) : g = 1 := by
  have h := (pow_gcd_eq_one (a := g) (m := 3) (n := 2 ^ n)).mpr ⟨h3, hn⟩
  have hc : Nat.gcd 3 (2 ^ n) = 1 := by
    rw [← Nat.coprime_iff_gcd_eq_one]
    exact Nat.Coprime.pow_right n (by decide : Nat.Coprime 3 2)
  rwa [hc, pow_one] at h

private theorem exists_smul_one_of_mk_eq_one {B : SU5} (h : (B : PU5) = 1) :
    ∃ c : F25, M[B] = c • 1 := by
  rw [QuotientGroup.eq_one_iff, mem_unitaryScalars] at h
  obtain ⟨c, -, -, hc⟩ := h
  refine ⟨(c : F25), ?_⟩
  rw [hc, GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, ← Matrix.smul_one_eq_diagonal]

private theorem false_of_ne_zero {B : SU5} {k : Fin 3} (hk : k ≠ 0)
    (hpat : ∀ i j : Fin 3, M[B] i j ≠ 0 → (i : ℕ) = ((j : ℕ) + (k : ℕ)) % 3)
    {n : ℕ} (hn : (B : PU5) ^ 2 ^ n = 1) : False := by
  have hz : ∀ i j : Fin 3, (i : ℕ) ≠ ((j : ℕ) + (k : ℕ)) % 3 → M[B] i j = 0 := by
    intro i j hij
    by_contra h
    exact hij (hpat i j h)
  have hcube : ∃ μ : F25, M[B] ^ 3 = μ • 1 := by
    fin_cases k
    · exact absurd rfl hk
    · exact ⟨M[B] 0 2 * M[B] 1 0 * M[B] 2 1,
        cube_eq_smul_one_of_shape₁ (hz 0 0 (by decide)) (hz 0 1 (by decide))
          (hz 1 1 (by decide)) (hz 1 2 (by decide)) (hz 2 0 (by decide))
          (hz 2 2 (by decide))⟩
    · exact ⟨M[B] 0 1 * M[B] 1 2 * M[B] 2 0,
        cube_eq_smul_one_of_shape₂ (hz 0 0 (by decide)) (hz 0 2 (by decide))
          (hz 1 0 (by decide)) (hz 1 1 (by decide)) (hz 2 1 (by decide))
          (hz 2 2 (by decide))⟩
  obtain ⟨μ, hμ⟩ := hcube
  have hg3 : (B : PU5) ^ 3 = 1 := eq_one_of_cube_eq_smul_one hμ
  have hg1 : (B : PU5) = 1 := eq_one_of_pow_three_of_pow_two hg3 hn
  obtain ⟨c, hc⟩ := exists_smul_one_of_mk_eq_one hg1
  have h00 : M[B] 0 0 = 0 := by
    by_contra h
    have h' : (k : ℕ) % 3 = 0 := by
      simpa using (hpat 0 0 h).symm
    rw [Nat.mod_eq_of_lt k.isLt] at h'
    exact hk (Fin.ext h')
  have hc0 : c = 0 := by
    have h1 : M[B] 0 0 = c := by
      have := congrFun (congrFun hc 0) 0
      simpa [Matrix.one_apply] using this
    rw [← h1, h00]
  have hdet : (M[B]).det = 1 := ((mem_unitarySU_iff hF).1 B.2).1
  rw [hc, Matrix.det_smul, Fintype.card_fin, Matrix.det_one, mul_one, hc0] at hdet
  have h0 : (0 : F25) ^ 3 = 0 := by norm_num
  rw [h0] at hdet
  exact zero_ne_one hdet

private theorem diagonal_unit_pow_six {a b c : F25}
    (hu : ((Matrix.diagonal ![a, b, c] : Matrix (Fin 3) (Fin 3) F25).map hF.bar)ᵀ *
      Matrix.diagonal ![a, b, c] = 1) :
    a ^ 6 = 1 ∧ b ^ 6 = 1 ∧ c ^ 6 = 1 := by
  have h1 : Matrix.diagonal (fun i => hF.bar (![a, b, c] i) * ![a, b, c] i) =
      (1 : Matrix (Fin 3) (Fin 3) F25) := by
    rw [← hu, Matrix.diagonal_map (by simp [bar_eq]), Matrix.diagonal_transpose,
      Matrix.diagonal_mul_diagonal]
  have h0 := congrFun (congrFun h1 0) 0
  have h1' := congrFun (congrFun h1 1) 1
  have h2 := congrFun (congrFun h1 2) 2
  simp only [Matrix.diagonal_apply_eq, Matrix.one_apply_eq] at h0 h1' h2
  refine ⟨?_, ?_, ?_⟩
  · rw [bar_eq, ← pow_succ] at h0
    exact h0
  · rw [bar_eq, ← pow_succ] at h1'
    exact h1'
  · rw [bar_eq, ← pow_succ] at h2
    exact h2

private theorem diag_exists_smul_sign : ∀ a b c : F25, a ^ 6 = 1 → b ^ 6 = 1 → c ^ 6 = 1 →
    a * b * c = 1 → a ^ 2 = b ^ 2 → b ^ 2 = c ^ 2 →
    ∃ μ : F25, (a = μ ∧ b = μ ∧ c = μ) ∨ (a = μ ∧ b = -μ ∧ c = -μ) ∨
      (a = -μ ∧ b = μ ∧ c = -μ) ∨ (a = -μ ∧ b = -μ ∧ c = μ) := by
  decide +kernel

