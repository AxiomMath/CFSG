theorem isQuasisimple_img148_of_theta {A : Subgroup G} {c : G} {L : Subgroup G}
    (h : Sec14Std G A c L) {N : Subgroup G}
    (hN : N ∈ scriptY A) (hAN : A ≤ N) (hLN : L ≤ N) {J : Subgroup G}
    (hJ : J ∈ thetaComponentsIn N) (hLJ : L ≤ J) (hGW : Sec6.GWLBalanceStatement) :
    letI := ker148_normal hN.2
    IsQuasisimple ↥(img148 A N L) := by
  letI := ker148_normal hN.2
  have hA : Late.IsE27 A := h.isE27
  have hcA : c ∈ A := h.zpowers_mem_omegaA.1 (Subgroup.mem_zpowers c)
  have hc3 : c ^ 3 = 1 := hA.1.2 c hcA
  have hLθ : L ∈ thetaComponentsAt 3 c := lA_subset A c h.mem_lA
  have hLperf : Group.IsPerfect ↥L := isPerfect_of_mem_thetaComponentsAt hLθ
  have hLθq : IsQuasisimple (↥L ⧸ aschbacherSolvableCore 3 ↥L) :=
    isQuasisimple_of_mem_thetaComponentsAt hLθ
  have hLc : L ≤ Subgroup.centralizer ({c} : Set G) :=
    Sec14.le_centralizer_of_mem_thetaComponentsAt hLθ
  have h3L : 3 ∣ Nat.card L := Proof1613.three_dvd_card_L h
  have hN4 : SectionFourHyp ↥N := h.toTheoremFourHyp.sectionFourHyp hN.1
  have hLsnJ : (L.subgroupOf (J ⊓ Subgroup.centralizer ({c} : Set G))).IsSubnormal := by
    have hLsn : (L.subgroupOf (Subgroup.centralizer ({c} : Set G))).IsSubnormal :=
      (mem_thetaComponentsIn_iff.mp hLθ).2.2.1
    have hle : J ⊓ Subgroup.centralizer ({c} : Set G) ≤ Subgroup.centralizer ({c} : Set G) :=
      inf_le_right
    have h1 := hLsn.comap (Subgroup.inclusion hle)
    have h2 : (L.subgroupOf (Subgroup.centralizer ({c} : Set G))).comap
        (Subgroup.inclusion hle) =
        L.subgroupOf (J ⊓ Subgroup.centralizer ({c} : Set G)) := by
      ext x
      simp [Subgroup.mem_subgroupOf]
    rwa [h2] at h1
  have hB3 : ⁅inSubgroup (aschbacherSolvableCore 3) L, L⁆ ≤
      inSubgroup (aschbacherSolvableCore 3) J :=
    Sec6.bThreeProperty_of_three_dvd hGW hN4 hJ (hAN hcA) hc3
      (le_inf hLJ hLc) hLperf hLsnJ hLθq h3L
  have hθNle : inSubgroup (aschbacherSolvableCore 3) N ≤ pPrimeCoreOf 3 N := by
    rw [inSubgroup]
    refine Subgroup.map_mono fun x hx => ?_
    exact le_sSup (show aschbacherSolvableCore 3 ↥N ∈
        {K : Subgroup ↥N | K.Normal ∧ Nat.Coprime 3 (Nat.card K)} from
      ⟨inferInstance, (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr
        (solvable_prime_complement_core_characterization (H := ↥N) Nat.prime_three).2.2.1⟩) hx
  have hθJle : inSubgroup (aschbacherSolvableCore 3) J ≤ pPrimeCoreOf 3 N := by
    rw [theta_eq_inf_of_mem_thetaComponentsIn hJ]
    exact inf_le_right.trans hθNle
  let θL : Subgroup ↥L := aschbacherSolvableCore 3 ↥L
  let C : Subgroup ↥L := ⁅θL, ⊤⁆
  have hCθ : C ≤ θL := Subgroup.commutator_le_left θL ⊤
  have hCnormal : C.Normal := Subgroup.commutator_normal θL ⊤
  let K : Subgroup ↥L := (CFSG.pPrimeCore 3 ↥N).comap (Subgroup.inclusion hLN)
  have hKnormal : K.Normal := Subgroup.Normal.comap (CFSG.pPrimeCore_normal (p := 3) (G := ↥N))
    (Subgroup.inclusion hLN)
  have htopL : (⊤ : Subgroup ↥L).map L.subtype = L := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hCmap : C.map L.subtype = ⁅inSubgroup (aschbacherSolvableCore 3) L, L⁆ := by
    change (⁅θL, ⊤⁆ : Subgroup ↥L).map L.subtype = _
    rw [Subgroup.map_commutator, inSubgroup, htopL]
  have hC_le_K : C ≤ K := by
    intro x hx
    have hxmap : (x : G) ∈ ⁅inSubgroup (aschbacherSolvableCore 3) L, L⁆ :=
      hCmap ▸ Subgroup.mem_map_of_mem L.subtype hx
    have hle := hB3.trans hθJle
    refine Subgroup.mem_comap.mpr ?_
    have hx' := hle hxmap
    rw [pPrimeCoreOf, Subgroup.mem_map] at hx'
    obtain ⟨a, ha, hxa⟩ := hx'
    rwa [show a = Subgroup.inclusion hLN x from Subtype.ext hxa] at ha
  have hK3 : ¬ 3 ∣ Nat.card K := by
    have hdvd : Nat.card K ∣ Nat.card (CFSG.pPrimeCore 3 ↥N) :=
      Subgroup.card_comap_dvd_of_injective (CFSG.pPrimeCore 3 ↥N)
        (Subgroup.inclusion hLN) (Subgroup.inclusion_injective hLN)
    intro h3
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp
      (CFSG.pPrimeCore_coprime_card (p := 3) (G := ↥N)) (h3.trans hdvd)
  have hθC_center : θL.map (QuotientGroup.mk' C) ≤ Subgroup.center (↥L ⧸ C) := by
    intro x hx
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hx
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective C y
    have hcomm : ⁅a, b⁆ ∈ C := Subgroup.commutator_mem_commutator ha (Subgroup.mem_top b)
    have h1 : QuotientGroup.mk' C ⁅a, b⁆ = 1 :=
      (QuotientGroup.eq_one_iff ⁅a, b⁆).mpr hcomm
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm] at h1
    exact h1.symm
  have hqC : IsQuasisimple ((↥L ⧸ C) ⧸ θL.map (QuotientGroup.mk' C)) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      (QuotientGroup.quotientQuotientEquivQuotient C θL hCθ).symm hLθq
  have hLCq : IsQuasisimple (↥L ⧸ C) := by
    have hder := CFSG.LocalCores.quasisimple_central_extension_derived
      (θL.map (QuotientGroup.mk' C)) hθC_center hqC
    have hperf : Group.IsPerfect (↥L ⧸ C) :=
      Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective C)
    have htop : commutator (↥L ⧸ C) = ⊤ := Group.isPerfect_def.mp hperf
    exact CFSG.LocalCores.isQuasisimple_of_mulEquiv
      ((MulEquiv.subgroupCongr htop).trans Subgroup.topEquiv) hder
  have hKCcenter : K.map (QuotientGroup.mk' C) ≤ Subgroup.center (↥L ⧸ C) := by
    rcases CFSG.LocalCores.quasisimple_normal_subgroups hLCq
      (hKnormal.map (QuotientGroup.mk' C) (QuotientGroup.mk'_surjective C)) with htop | hle
    · exfalso
      have hsup : K ⊔ C = ⊤ := by
        have h1 := Subgroup.comap_map_eq (QuotientGroup.mk' C) K
        rw [htop, Subgroup.comap_top, QuotientGroup.ker_mk'] at h1
        exact h1.symm
      have hKtop : K = ⊤ := by rwa [sup_eq_left.mpr hC_le_K] at hsup
      apply hK3
      simpa [hKtop, Subgroup.card_top] using h3L
    · exact hle
  have hLKq : IsQuasisimple (↥L ⧸ K) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      (QuotientGroup.quotientQuotientEquivQuotient C K hC_le_K)
      (CFSG.LocalCores.quasisimple_central_quotient hLCq
        (K.map (QuotientGroup.mk' C)) hKCcenter).1
  let f : ↥L →* (↥(N ⊔ A)) ⧸ ker148 A N :=
    (QuotientGroup.mk' (ker148 A N)).comp (Subgroup.inclusion (hLN.trans le_sup_left))
  have hfker : f.ker = K := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, mk'_ker148_eq_one_iff, Subgroup.mem_comap]
    constructor
    · intro hx
      rw [pPrimeCoreOf, Subgroup.mem_map] at hx
      obtain ⟨a, ha, hax⟩ := hx
      exact (Subtype.ext hax : a = Subgroup.inclusion hLN x) ▸ ha
    · intro hx
      rw [pPrimeCoreOf, Subgroup.mem_map]
      exact ⟨Subgroup.inclusion hLN x, hx, rfl⟩
  have hfrange : f.range = img148 A N L := by
    change ((QuotientGroup.mk' (ker148 A N)).comp
      (Subgroup.inclusion (hLN.trans le_sup_left))).range = img148 A N L
    rw [MonoidHom.range_comp, Subgroup.inclusion_range]
    rfl
  refine CFSG.LocalCores.isQuasisimple_of_mulEquiv ?_ hLKq
  exact ((QuotientGroup.quotientMulEquivOfEq hfker.symm).trans
    (QuotientGroup.quotientKerEquivRange f)).trans (MulEquiv.subgroupCongr hfrange)

theorem type429_pCore_img148_of_theta
    {A : Subgroup G} {c : G} {L : Subgroup G} (h : Sec14Std G A c L) {N : Subgroup G}
    (hN : N ∈ scriptY A) (hAN : A ≤ N) (hLN : L ≤ N) {J : Subgroup G}
    (hJ : J ∈ thetaComponentsIn N) (hLJ : L ≤ J) (hGW : Sec6.GWLBalanceStatement)
    (hGA : CFSG.Open.GriessAllModelsStatement) :
    letI := ker148_normal hN.2
    Main148.Type429 (↥(img148 A N L) ⧸ CFSG.pCore 2 ↥(img148 A N L)) := by
  letI := ker148_normal hN.2
  have hA : Late.IsE27 A := h.isE27
  have hcA : c ∈ A := h.zpowers_mem_omegaA.1 (Subgroup.mem_zpowers c)
