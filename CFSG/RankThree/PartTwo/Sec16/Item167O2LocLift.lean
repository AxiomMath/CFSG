    CFSG.RankThree.PartTwo.Sec14.Ronan148K.pCore_two_eq_center hLKq h2
  let f : ↥L →* (↥(N ⊔ A)) ⧸ ker148 A N :=
    (QuotientGroup.mk' (ker148 A N)).comp (Subgroup.inclusion (hLN.trans le_sup_left))
  have hfker : f.ker = K := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, mk'_ker148_eq_one_iff, Subgroup.mem_comap]
    constructor
    · intro hx
      rw [pPrimeCoreOf, Subgroup.mem_map] at hx
      obtain ⟨a, ha, hax⟩ := hx
      exact (Subtype.ext hax : a = Subgroup.inclusion hLN x) ▸ ha
    · intro hx
      rw [pPrimeCoreOf, Subgroup.mem_map]
      exact ⟨Subgroup.inclusion hLN x, hx, rfl⟩
  have hfrange : f.range = img148 A N L := by
    change ((QuotientGroup.mk' (ker148 A N)).comp
      (Subgroup.inclusion (hLN.trans le_sup_left))).range = img148 A N L
    rw [MonoidHom.range_comp, Subgroup.inclusion_range]
    rfl
  let eImg : ↥L ⧸ K ≃* ↥(img148 A N L) :=
    ((QuotientGroup.quotientMulEquivOfEq hfker.symm).trans
      (QuotientGroup.quotientKerEquivRange f)).trans (MulEquiv.subgroupCongr hfrange)
  have hKqImg : IsQuasisimple ↥(img148 A N L) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv eImg hLKq
  haveI : Group.IsPerfect ↥(img148 A N L) := hKqImg.1
  haveI : Nontrivial ↥(img148 A N L) := CFSG.LocalCores.isQuasisimple_nontrivial hKqImg
  have hZα : Subgroup.center (↥(img148 A N L)) = ⊥ :=
    CFSG.RankThree.PartTwo.Sec4.RonanK429.center_eq_bot_of_isoLThreePi hn hK2
  have hZLK : Subgroup.center (↥L ⧸ K) = ⊥ := by
    have hmap := Subgroup.map_center_eq eImg
    rw [hZα] at hmap
    exact (Subgroup.map_eq_bot_iff_of_injective _ eImg.injective).mp hmap
  have hθbot : θL.map (QuotientGroup.mk' K) = ⊥ := by
    rw [← hcenterQ]
    exact hZLK
  have hθK : θL ≤ K := by
    intro x hx
    have hx' : QuotientGroup.mk' K x = 1 := by
      have hm : QuotientGroup.mk' K x ∈ θL.map (QuotientGroup.mk' K) :=
        Subgroup.mem_map_of_mem _ hx
      rwa [hθbot] at hm
    exact (QuotientGroup.eq_one_iff x).mp hx'
  have eLθα : (↥L ⧸ θL) ≃* ↥(img148 A N L) := by
    have e1 : (↥L ⧸ θL) ≃* (↥L ⧸ K) ⧸ θL.map (QuotientGroup.mk' K) :=
      (QuotientGroup.quotientQuotientEquivQuotient K θL hK_le_θ).symm
    exact e1.trans ((QuotientGroup.quotientMulEquivOfEq hθbot).trans
      (QuotientGroup.quotientBot.trans eImg))
  exact ⟨n, hn, Main148.isoLThreePi_congr eLθα.symm hK2⟩

theorem comap_pPrimeCore_le_theta
    {A : Subgroup G} {c : G} {L : Subgroup G}
    (h : Sec14Std G A c L) {N : Subgroup G} (hLN : L ≤ N) :
    (CFSG.pPrimeCore 3 ↥N).comap (Subgroup.inclusion hLN) ≤
      aschbacherSolvableCore 3 ↥L := by
  let θL : Subgroup ↥L := aschbacherSolvableCore 3 ↥L
  let K : Subgroup ↥L := (CFSG.pPrimeCore 3 ↥N).comap (Subgroup.inclusion hLN)
  have hKnormal : K.Normal := Subgroup.Normal.comap (CFSG.pPrimeCore_normal (p := 3) (G := ↥N))
    (Subgroup.inclusion hLN)
  have hLθq : IsQuasisimple (↥L ⧸ θL) :=
    isQuasisimple_of_mem_thetaComponentsAt (lA_subset A c h.mem_lA)
  have hTypeL : Main148.Type429 (↥L ⧸ θL) := by
    rcases (h.chosen136.2 c h.zpowers_mem_omegaA L h.mem_lA).1 with hJ2 | hL3 | hA7 | hM22 | hM12
    · exact Or.inr (Or.inr (Or.inr (Or.inr hJ2)))
    · exact Or.inl hL3
    · exact Or.inr (Or.inl hA7)
    · exact Or.inr (Or.inr (Or.inr (Or.inl hM22)))
    · exact Or.inr (Or.inr (Or.inl hM12))
  obtain ⟨hS, -⟩ := Main148.isSimpleGroup_of_type429 hLθq.1 hTypeL
  have h3Lbar : 3 ∣ Nat.card (↥L ⧸ θL) := Main148.three_dvd_card_of_type429 hTypeL
  have hK3 : ¬ 3 ∣ Nat.card K := by
    have hdvd : Nat.card K ∣ Nat.card (CFSG.pPrimeCore 3 ↥N) :=
      Subgroup.card_comap_dvd_of_injective (CFSG.pPrimeCore 3 ↥N)
        (Subgroup.inclusion hLN) (Subgroup.inclusion_injective hLN)
    intro h3
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp
      (CFSG.pPrimeCore_coprime_card (p := 3) (G := ↥N)) (h3.trans hdvd)
  have hKmap_normal : (K.map (QuotientGroup.mk' θL)).Normal :=
    hKnormal.map (QuotientGroup.mk' θL) (QuotientGroup.mk'_surjective θL)
  rcases hS.eq_bot_or_eq_top_of_normal (K.map (QuotientGroup.mk' θL)) with hbot | htop
  · intro x hx
    have hxmap : QuotientGroup.mk' θL x ∈ K.map (QuotientGroup.mk' θL) :=
      Subgroup.mem_map_of_mem _ hx
    rw [hbot] at hxmap
    exact (QuotientGroup.eq_one_iff x).mp (Subgroup.mem_bot.mp hxmap)
  · exfalso
    have hdvd : Nat.card (↥L ⧸ θL) ∣ Nat.card K := by
      have h1 : Nat.card (K.map (QuotientGroup.mk' θL)) ∣ Nat.card K :=
        Subgroup.card_map_dvd (H := K) (QuotientGroup.mk' θL)
      rwa [htop, Subgroup.card_top] at h1
    exact hK3 (h3Lbar.trans hdvd)

theorem lift429_cases_of_aux
    (h429 : Sec4.Item4_29) (h41 : Sec4.Item4_1LargePrime)
    (hGW : Sec6.GWLBalanceStatement) (hGA : CFSG.Open.GriessAllModelsStatement)
    {A : Subgroup G} {c : G} {L : Subgroup G} (h : Sec14Std G A c L) {N : Subgroup G}
    (hN : N ∈ scriptY A) (hAN : A ≤ N) (hLN : L ≤ N) {J : Subgroup G}
    (hJ : J ∈ thetaComponentsIn N) (hLJ : L ≤ J)
    (hAJ : A ≤ Subgroup.normalizer (J : Set G)) (hcA : c ∈ A) :
    (letI := ker148_normal hN.2;
      img148 A N L = img148 A N J ∨
      (Nonempty (↥(img148 A N L) ≃* alternatingGroup (Fin 7)) ∧
        Nonempty (↥(img148 A N J) ≃* alternatingGroup (Fin 10))) ∨
      (∃ n : ℕ, 1 ≤ n ∧ Sec4.IsoLThreePi ↥(img148 A N L) 2 n ∧
        Sec4.IsoLThreePi ↥(img148 A N J) 2 (3 * n) ∧
        KFacts.InducesStdKind (img148 A N J) (alpha148 A N c hcA) .field) ∨
      (∃ n : ℕ, 1 ≤ n ∧ Sec4.IsoLThreePi ↥(img148 A N L) 2 n ∧
        CFSG.Blueprint.ChevalleyExceptionalModel ↥(img148 A N J) .trialityD4 2 n ∧
        KFacts.InducesStdKind (img148 A N J) (alpha148 A N c hcA) .graphField)) := by
  letI := ker148_normal hN.2
  have hA : Late.IsE27 A := h.isE27
  have hc3 : c ^ 3 = 1 := hA.1.2 c hcA
  have hc1 : c ≠ 1 := by
    intro h1
    have hcard : Nat.card (Subgroup.zpowers c) = 3 := h.zpowers_mem_omegaA.2.1
    rw [h1, Subgroup.zpowers_one_eq_bot, Subgroup.card_bot] at hcard
    norm_num at hcard
  have hLθ : L ∈ thetaComponentsAt 3 c := lA_subset A c h.mem_lA
  have hLperf : Group.IsPerfect ↥L := isPerfect_of_mem_thetaComponentsAt hLθ
  have hLc : L ≤ Subgroup.centralizer ({c} : Set G) :=
    Sec14.le_centralizer_of_mem_thetaComponentsAt hLθ
  have h3L : 3 ∣ Nat.card L := Proof1613.three_dvd_card_L h
  have hNsol : ¬ Group.IsSolvable ↥N := by
    intro hsol
    haveI := hsol
    haveI : Group.IsPerfect ↥L := hLperf
    have hLne : L ≠ ⊥ := by
      intro hb
      rw [hb, Subgroup.card_bot] at h3L
      norm_num at h3L
    haveI : Nontrivial ↥L := (Subgroup.nontrivial_iff_ne_bot L).mpr hLne
    have hLsolN : Group.IsSolvable ↥(L.subgroupOf N) :=
      subgroup_solvable_of_solvable (H := L.subgroupOf N)
    have hLsol : Group.IsSolvable ↥L :=
      Group.isSolvable_of_surjective
        (f := (Subgroup.subgroupOfEquivOfLe hLN).toMonoidHom)
        (MulEquiv.surjective (Subgroup.subgroupOfEquivOfLe hLN))
    exact Group.IsPerfect.not_isSolvable ↥L hLsol
  have hJY : J ≤ N := le_of_mem_thetaComponentsIn hJ
  have hJM : J ≤ N ⊔ A := hJY.trans le_sup_left
  have h3J : 3 ∣ Nat.card J := h3L.trans (Subgroup.card_dvd_of_le hLJ)
  obtain ⟨hJq, hJθ⟩ := img148_isQuasisimple (A := A) (Y := N) hJ h3J
  obtain ⟨hC4, hCE⟩ := hyp429In148_of h41 G A c L h N hN hNsol J hJ hAJ h3J
  have hCeq : img148 A N (J ⊔ A) = img148 A N J ⊔ img148 A N A := img148_sup hJM le_sup_right
  have hAαJα : img148 A N A ≤
      Subgroup.normalizer (img148 A N J : Set (↥(N ⊔ A) ⧸ ker148 A N)) :=
    img148_le_normalizer hAJ
  have hAα3 : ∀ a ∈ img148 A N A, a ^ 3 = 1 := (img148_isE27 hA).1.2
  have hCθ : aschbacherSolvableCore 3 ↥(img148 A N (J ⊔ A)) = ⊥ := by
    rw [hCeq]
    exact aschbacherSolvableCore_sup_eq_bot hAαJα hAα3 hJθ
  have hAC : img148 A N A ≤ img148 A N (J ⊔ A) := img148_mono le_sup_right
  have hLC : img148 A N J ≤ img148 A N (J ⊔ A) := img148_mono le_sup_left
  have hLn : img148 A N (J ⊔ A) ≤
      Subgroup.normalizer (img148 A N J : Set (↥(N ⊔ A) ⧸ ker148 A N)) := by
    rw [hCeq]
    exact sup_le Subgroup.le_normalizer hAαJα
  have hK_le_θ : (CFSG.pPrimeCore 3 ↥N).comap (Subgroup.inclusion hLN) ≤
      aschbacherSolvableCore 3 ↥L := comap_pPrimeCore_le_theta h hLN
  have hsecO : Late.sectionCentralizer A L (pPrimeCoreOf 3 N) =
      (Subgroup.zpowers c : Set G) := by
    apply le_antisymm
    · intro a ha
      have hsecθ : Late.sectionCentralizer A L
          ((aschbacherSolvableCore 3 L).map L.subtype) = (Subgroup.zpowers c : Set G) :=
        h.mem_lA.2.2.1
      rw [← hsecθ]
      refine ⟨ha.1, fun x hx => ?_⟩
      have hmemL : a * x * a⁻¹ * x⁻¹ ∈ L :=
        L.mul_mem ((Subgroup.mem_normalizer_iff.mp (h.mem_lA.2.1 ha.1) x).mp hx) (L.inv_mem hx)
      have hmemK : (⟨a * x * a⁻¹ * x⁻¹, hmemL⟩ : ↥L) ∈
          (CFSG.pPrimeCore 3 ↥N).comap (Subgroup.inclusion hLN) := by
        refine Subgroup.mem_comap.mpr ?_
        have h := ha.2 x hx
        rw [pPrimeCoreOf, Subgroup.mem_map] at h
        obtain ⟨n, hn, hnx⟩ := h
        exact (Subtype.ext hnx : n = Subgroup.inclusion hLN
          ⟨a * x * a⁻¹ * x⁻¹, hmemL⟩) ▸ hn
      exact Subgroup.mem_map_of_mem L.subtype (hK_le_θ hmemK)
    · intro a ha
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
      refine ⟨A.zpow_mem hcA k, fun x hx => ?_⟩
      have hcomm : Commute c x := by
        exact Subgroup.mem_centralizer_iff.mp (hLc hx) c (Set.mem_singleton c)
      have hone : c ^ k * x * (c ^ k)⁻¹ * x⁻¹ = 1 := by
        rw [(hcomm.zpow_left k).eq]
        group
      rw [hone]
      exact (pPrimeCoreOf 3 N).one_mem
  have hcent := img148_inf_centralizer_eq (A := A) (Y := N) (J := L) (K := L)
    (hLN.trans le_sup_left) hcA hLc hsecO rfl
  have hCJ := img148_inf_centralizer_alpha148 hN.2 hJM hAJ hcA hc3
  have hLsn : (L.subgroupOf (Subgroup.centralizer ({c} : Set G))).IsSubnormal :=
    (mem_thetaComponentsIn_iff.mp hLθ).2.2.1
  have hLsnJ : (L.subgroupOf (J ⊓ Subgroup.centralizer ({c} : Set G))).IsSubnormal := by
    have hle : J ⊓ Subgroup.centralizer ({c} : Set G) ≤ Subgroup.centralizer ({c} : Set G) :=
      inf_le_right
    have h1 := hLsn.comap (Subgroup.inclusion hle)
    have h2 : (L.subgroupOf (Subgroup.centralizer ({c} : Set G))).comap
        (Subgroup.inclusion hle) =
        L.subgroupOf (J ⊓ Subgroup.centralizer ({c} : Set G)) := by
      ext x
      simp [Subgroup.mem_subgroupOf]
    rwa [h2] at h1
  have hKL : img148 A N L ≤ img148 A N J ⊓
      Subgroup.centralizer {alpha148 A N c hcA} := by
    rw [hCJ]
    exact img148_mono (le_inf hLJ hLc)
  have hKsub : ((img148 A N L).subgroupOf (img148 A N J ⊓
      Subgroup.centralizer {alpha148 A N c hcA})).IsSubnormal := by
    rw [hCJ]
    exact isSubnormal_img148 (le_inf hLJ hLc) (inf_le_left.trans hJM) hLsnJ
  have htype := type429_pCore_img148_of_theta h hN hAN hLN hJ hLJ hGW hGA
  have hKq := isQuasisimple_img148_of_theta h hN hAN hLN hJ hLJ hGW
  rcases Main148.item4_29_of_le_cover h429 (img148 A N (J ⊔ A)) hC4 hCθ hCE hAC hLC
      (img148_isE27 hA) (alpha148_mem_img148 hcA) (alpha148_ne_one hcA hc1 hc3) hJq hLn
      hKL hKq hKsub htype hcent.symm with h1 | h2 | h3 | h4
  · exact Or.inl h1
  · exact Or.inr (Or.inl h2)
  · exact Or.inr (Or.inr (Or.inl h3))
  · exact Or.inr (Or.inr (Or.inr h4))

private theorem lift429_of_aux
    (h429 : Sec4.Item4_29) (h41 : Sec4.Item4_1LargePrime)
    (hGW : Sec6.GWLBalanceStatement) (hGA : CFSG.Open.GriessAllModelsStatement)
    {A : Subgroup G} {c : G} {L : Subgroup G} (h : Sec14Std G A c L) {N : Subgroup G}
    (hN : N ∈ scriptY A) (hAN : A ≤ N) (hLN : L ≤ N) {J : Subgroup G}
    (hJ : J ∈ thetaComponentsIn N) (hLJ : L ≤ J)
    (hAJ : A ≤ Subgroup.normalizer (J : Set G)) :
    (letI := ker148_normal hN.2;
