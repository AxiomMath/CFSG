  rcases lift429_cases_of_aux h429 h41 hGW hGA h hN hAN hLN hJ hLJ hAJ hcA
    with h1 | h2 | h3 | h4
  · exact Or.inl h1
  · exact Or.inr (Or.inl h2)
  · obtain ⟨n, hn, hK2, -, -⟩ := h3
    exact Or.inr (Or.inr (isL3TwoPow_of_isoLThreePi_img h hN hAN hLN hJ hLJ hGW hGA hn hK2))
  · obtain ⟨n, hn, hK2, -, -⟩ := h4
    exact Or.inr (Or.inr (isL3TwoPow_of_isoLThreePi_img h hN hAN hLN hJ hLJ hGW hGA hn hK2))

