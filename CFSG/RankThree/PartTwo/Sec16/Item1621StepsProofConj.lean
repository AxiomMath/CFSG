theorem apply_not_mem_zpowers {B : Subgroup G} (hB : CFSG.Assembly.IsElemAbelian 3 B)
    (h9 : Nat.card B = 9) {ρ : MulAut B} (h4 : ρ ^ 4 = 1) (h2 : ρ ^ 2 ≠ 1) {x : B}
    (hx : x ≠ 1) : ρ x ∉ Subgroup.zpowers x := by
  intro hρx
  have hirr := isIrreducibleOn_of_order_four hB h9 (T := Subgroup.zpowers ρ)
    (Subgroup.mem_zpowers ρ) h4 h2
  set D : Subgroup B := Subgroup.zpowers x with hD
  have hx3 : orderOf x = 3 :=
    orderOf_eq_prime (Subtype.ext (by simpa using hB.2 _ x.2)) hx
  have hρD : ∀ y ∈ D, ρ y ∈ D := by
    intro y hy
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    rw [map_zpow]
    exact D.zpow_mem hρx k
  have hpowD : ∀ m : ℕ, ∀ y ∈ D, (ρ ^ m) y ∈ D := by
    intro m
    induction m with
    | zero => intro y hy; simpa using hy
    | succ m ih =>
      intro y hy
      rw [pow_succ', MulAut.mul_apply]
      exact hρD _ (ih y hy)
  have hinv : ∀ φ ∈ Subgroup.zpowers ρ, D.map φ.toMonoidHom = D := by
    intro φ hφ
    obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp (mem_powers_iff_mem_zpowers.mpr hφ)
    have hle : D.map (ρ ^ m).toMonoidHom ≤ D := by
      rintro _ ⟨y, hy, rfl⟩
      exact hpowD m y hy
    exact Subgroup.eq_of_le_of_card_ge hle
      (by rw [Subgroup.card_map_of_injective (ρ ^ m).injective])
  rcases hirr D hinv with h | h
  · apply hx
    have : x ∈ D := Subgroup.mem_zpowers x
    rw [h] at this
    exact Subgroup.mem_bot.mp this
  · have h1 : Nat.card D = 3 := by rw [hD, Nat.card_zpowers, hx3]
    rw [h, Subgroup.card_top, h9] at h1
    omega

theorem sq_apply_ne_of_order_four {B : Subgroup G} (hB : CFSG.Assembly.IsElemAbelian 3 B)
    (h9 : Nat.card B = 9) {ρ : MulAut B} (h4 : ρ ^ 4 = 1) (h2 : ρ ^ 2 ≠ 1) {v : B}
    (hv : v ≠ 1) : (ρ ^ 2) v ≠ v := by
  intro hfix
  have hcomm : ∀ x y : B, x * y = y * x := fun x y => hB.1.is_comm.comm x y
  have hρw : ρ (ρ v) = v := by
    rw [← MulAut.mul_apply, ← pow_two]
    exact hfix
  by_cases hu : v * ρ v = 1
  · apply apply_not_mem_zpowers hB h9 h4 h2 hv
    rw [eq_inv_of_mul_eq_one_right hu]
    exact inv_mem (Subgroup.mem_zpowers v)
  · apply apply_not_mem_zpowers hB h9 h4 h2 hu
    rw [map_mul, hρw, hcomm]
    exact Subgroup.mem_zpowers _

theorem quaternion_facts :
    (QuaternionGroup.a 1 : QuaternionGroup 2) ^ 4 = 1 ∧
      (QuaternionGroup.a 1 : QuaternionGroup 2) ^ 2 ≠ 1 ∧
      ∀ g : QuaternionGroup 2, g ^ 2 = 1 → g = 1 ∨ g = QuaternionGroup.a 1 ^ 2 := by
  decide

theorem sl23_facts :
    slI ^ 4 = 1 ∧ slI ^ 2 ≠ 1 ∧
      ∀ g : Matrix.SpecialLinearGroup (Fin 2) (ZMod 3), g ^ 2 = 1 → g = 1 ∨ g = slI ^ 2 := by
  decide

omit [Finite G] in
theorem exists_sq_of_cases {X : Type*} [Group X] {T : Subgroup X}
    (hT : Nonempty (T ≃* QuaternionGroup 2) ∨
      Nonempty (T ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3))) :
    ∃ σ ∈ T, σ ^ 4 = 1 ∧ σ ^ 2 ≠ 1 ∧ (∀ τ ∈ T, τ ^ 2 = 1 → τ = 1 ∨ τ = σ ^ 2) ∧
      (Nat.card T = 8 ∨ Nat.card T = 24) := by
  have key : ∀ {M : Type} [Group M] (e : T ≃* M) (s : M), s ^ 4 = 1 → s ^ 2 ≠ 1 →
      (∀ g : M, g ^ 2 = 1 → g = 1 ∨ g = s ^ 2) →
      ∃ σ ∈ T, σ ^ 4 = 1 ∧ σ ^ 2 ≠ 1 ∧ ∀ τ ∈ T, τ ^ 2 = 1 → τ = 1 ∨ τ = σ ^ 2 := by
    intro M _ e s h4 h2 hinv
    refine ⟨e.symm s, (e.symm s).2, ?_, ?_, ?_⟩
    · rw [← Subgroup.coe_pow, ← map_pow, h4, map_one, Subgroup.coe_one]
    · intro h
      apply h2
      have : (e.symm s) ^ 2 = 1 := Subtype.ext (by rw [Subgroup.coe_pow, h, Subgroup.coe_one])
      rwa [← map_pow, MulEquiv.map_eq_one_iff] at this
    · intro τ hτ hτ2
      have h1 : (e ⟨τ, hτ⟩) ^ 2 = 1 := by
        rw [← map_pow, MulEquiv.map_eq_one_iff]
        exact Subtype.ext (by rw [Subgroup.coe_pow, hτ2, Subgroup.coe_one])
      rcases hinv _ h1 with h | h
      · left
        have := congrArg e.symm h
        rw [MulEquiv.symm_apply_apply, map_one] at this
        exact congrArg Subtype.val this
      · right
        have := congrArg e.symm h
        rw [MulEquiv.symm_apply_apply, map_pow] at this
        exact (congrArg Subtype.val this).trans (by rw [Subgroup.coe_pow])
  rcases hT with he | he
  · obtain ⟨e⟩ := he
    obtain ⟨h4, h2, hinv⟩ := quaternion_facts
    obtain ⟨σ, hσ, hσ4, hσ2, hσinv⟩ := key e _ h4 h2 hinv
    refine ⟨σ, hσ, hσ4, hσ2, hσinv, Or.inl ?_⟩
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  · obtain ⟨e⟩ := he
    obtain ⟨h4, h2, hinv⟩ := sl23_facts
    obtain ⟨σ, hσ, hσ4, hσ2, hσinv⟩ := key e _ h4 h2 hinv
    refine ⟨σ, hσ, hσ4, hσ2, hσinv, Or.inr ?_⟩
    rw [Nat.card_congr e.toEquiv, card_SL_two_three]

theorem exists_conj_eq_of_cases {A L : Subgroup G} {c : G} (hD : Sec13Data G A c L)
    (hcL : c ∉ L) (h9 : Nat.card (A ⊓ L : Subgroup G) = 9)
    (hstar : Nonempty (Sec4.autIn L A ≃* QuaternionGroup 2) ∨
      Nonempty (Sec4.autIn L A ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)))
    {y : G} (hy : y ∈ A ⊓ L) (hy1 : y ≠ 1) {z : G} (hz : z ∈ A ⊓ L) (hz1 : z ≠ 1) :
    ∃ l ∈ L ⊓ Subgroup.normalizer (A : Set G), l * y * l⁻¹ = z := by
  set T := Sec4.autIn L A with hT
  obtain ⟨σ, hσT, hσ4, hσ2, hσinv, hTcard⟩ := exists_sq_of_cases hstar
  obtain ⟨l₀, hl₀N, hl₀L, hσl₀⟩ := Sec4.mem_autIn_iff.mp hσT
  have hAa : A = Subgroup.zpowers c ⊔ (A ⊓ L) :=
    eq_sup_of_card_nine hD h9 (fun h => hcL h.2)
  set B := A ⊓ L with hB
  have hBe : CFSG.Assembly.IsElemAbelian 3 B :=
    ⟨⟨⟨fun x y => Subtype.ext (hD.commute x.2.1 y.2.1)⟩⟩, fun x hx => hD.isElemAbelian.2 x hx.1⟩
  have hl₀B : l₀ ∈ Subgroup.normalizer (B : Set G) :=
    inf_normalizer_le_normalizer_inf A L ⟨hl₀L, hl₀N⟩
  set ρ := B.normalizerMonoidHom ⟨l₀, hl₀B⟩ with hρ
  have hσpow : ∀ (m : ℕ) (x : A), (((σ ^ m) x : A) : G) = l₀ ^ m * x * (l₀ ^ m)⁻¹ := by
    intro m x
    rw [← hσl₀]
    exact normalizerMonoidHom_pow_apply_val l₀ hl₀N m x
  have hρpow : ∀ (m : ℕ) (x : B), (((ρ ^ m) x : B) : G) = l₀ ^ m * x * (l₀ ^ m)⁻¹ :=
    fun m x => normalizerMonoidHom_pow_apply_val l₀ hl₀B m x
  have hl₀c : ∀ m : ℕ, l₀ ^ m * c * (l₀ ^ m)⁻¹ = c := by
    intro m
    have h1 := Subgroup.mem_centralizer_singleton_iff.mp (hD.le_centralizer (L.pow_mem hl₀L m))
    rw [h1, mul_inv_cancel_right]
  have hρ4 : ρ ^ 4 = 1 := by
    ext x
    rw [hρpow, MulAut.one_apply]
    have := hσpow 4 ⟨x, x.2.1⟩
    rw [hσ4, MulAut.one_apply] at this
    exact this.symm
  have hρ2 : ρ ^ 2 ≠ 1 := by
    intro h
    apply hσ2
    ext ⟨x, hx⟩
    rw [hσpow, MulAut.one_apply]
    obtain ⟨i, -, f, hf, rfl⟩ := exists_pow_mul_of_mem hD.isElemAbelian hD.mem_A hAa hx
    have hff : l₀ ^ 2 * f * (l₀ ^ 2)⁻¹ = f := by
      have := congrArg (fun τ : MulAut B => ((τ ⟨f, hf⟩ : B) : G)) h
      simp only [MulAut.one_apply] at this
      rwa [hρpow] at this
    change l₀ ^ 2 * (c ^ i * f) * (l₀ ^ 2)⁻¹ = c ^ i * f
    calc l₀ ^ 2 * (c ^ i * f) * (l₀ ^ 2)⁻¹ =
        (l₀ ^ 2 * c * (l₀ ^ 2)⁻¹) ^ i * (l₀ ^ 2 * f * (l₀ ^ 2)⁻¹) := by
          rw [← MulAut.conj_apply, ← MulAut.conj_apply, ← MulAut.conj_apply, map_mul, map_pow]
      _ = c ^ i * f := by rw [hl₀c, hff]
  have hstab : ∀ x : A, (x : G) ∈ L → x ≠ 1 → ¬ 2 ∣ Nat.card (MulAction.stabilizer T x) := by
    intro x hxL hx1 h2d
    obtain ⟨τ, hτ⟩ := exists_prime_orderOf_dvd_card' (G := MulAction.stabilizer T x) 2 h2d
    have hτ2 : ((τ : T) : MulAut A) ^ 2 = 1 := by
      have := pow_orderOf_eq_one τ
      rw [hτ] at this
      exact congrArg (fun t : MulAction.stabilizer T x => ((t : T) : MulAut A)) this
    have hτ1 : ((τ : T) : MulAut A) ≠ 1 := by
      intro h1
      have : τ = 1 := Subtype.ext (Subtype.ext h1)
      rw [this, orderOf_one] at hτ
      omega
    rcases hσinv _ (τ : T).2 hτ2 with h | h
    · exact hτ1 h
    · have hfix : ((τ : T) : MulAut A) x = x := τ.2
      rw [h] at hfix
      have h1 : l₀ ^ 2 * (x : G) * (l₀ ^ 2)⁻¹ = x := by
        rw [← hσpow]
        exact congrArg Subtype.val hfix
      apply sq_apply_ne_of_order_four hBe h9 hρ4 hρ2 (v := ⟨x, x.2, hxL⟩)
        (fun h => hx1 (Subtype.ext (by simpa using congrArg Subtype.val h)))
      apply Subtype.ext
      rw [hρpow]
      exact h1
  set yA : A := ⟨y, hy.1⟩ with hyA
  set zA : A := ⟨z, hz.1⟩ with hzA
  have hyA1 : yA ≠ 1 := fun h => hy1 (congrArg Subtype.val h)
  have hzA1 : zA ≠ 1 := fun h => hz1 (congrArg Subtype.val h)
  have horb : zA ∈ MulAction.orbit T yA := by
    by_contra hnot
    set S : Set A := ((B.subgroupOf A : Subgroup A) : Set A) \ {1, zA} with hS
    have hsub : MulAction.orbit T yA ⊆ S := by
      rintro _ ⟨τ, rfl⟩
      refine ⟨?_, ?_⟩
      · change ((τ : MulAut A) yA) ∈ B.subgroupOf A
        rw [Subgroup.mem_subgroupOf]
        exact ⟨((τ : MulAut A) yA).2, autIn_mem_inf τ.2 (x := yA) hy.2⟩
      · rintro (h | h)
        · apply hyA1
          have h' : (τ : MulAut A) yA = 1 := h
          exact (MulEquiv.map_eq_one_iff _).mp h'
        · exact hnot ⟨τ, h⟩
    have hBA : Nat.card (B.subgroupOf A) = 9 := by
      rw [← h9]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_left).toEquiv
    have hSc : S.ncard = 7 := by
      rw [hS, Set.ncard_sdiff (by
        rintro w (rfl | rfl)
        · exact (B.subgroupOf A).one_mem
        · exact Subgroup.mem_subgroupOf.mpr hz)]
      rw [Set.ncard_pair (Ne.symm hzA1), ← Nat.card_coe_set_eq, SetLike.coe_sort_coe, hBA]
    have hle : (MulAction.orbit T yA).ncard ≤ 7 := hSc ▸ Set.ncard_le_ncard hsub (Set.toFinite S)
    have hmul : Nat.card (MulAction.stabilizer T yA) * (MulAction.orbit T yA).ncard =
        Nat.card T := by
      have h1 := Subgroup.card_mul_index (MulAction.stabilizer T yA)
      rw [MulAction.index_stabilizer] at h1
      exact h1
    have hodd := hstab yA hy.2 hyA1
    have hge : 8 ≤ (MulAction.orbit T yA).ncard := by
      have hdvd : Nat.card (MulAction.stabilizer T yA) ∣ Nat.card T := Dvd.intro _ hmul
      rcases hTcard with h8 | h24
      · rw [h8] at hmul hdvd
        have hdiv : Nat.card (MulAction.stabilizer T yA) ∈ Nat.divisors 8 :=
          Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
        have h8d : Nat.divisors 8 = {1, 2, 4, 8} := by decide
        rw [h8d] at hdiv
        simp only [Finset.mem_insert, Finset.mem_singleton] at hdiv
        rcases hdiv with h | h | h | h <;> rw [h] at hodd hmul
        · omega
        all_goals exact absurd (by norm_num) hodd
      · rw [h24] at hmul hdvd
        have hdiv : Nat.card (MulAction.stabilizer T yA) ∈ Nat.divisors 24 :=
          Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
        have h24d : Nat.divisors 24 = {1, 2, 3, 4, 6, 8, 12, 24} := by decide
        rw [h24d] at hdiv
        simp only [Finset.mem_insert, Finset.mem_singleton] at hdiv
        rcases hdiv with h | h | h | h | h | h | h | h <;> rw [h] at hodd hmul
        · omega
        · exact absurd (by norm_num) hodd
        · omega
        all_goals exact absurd (by norm_num) hodd
    omega
  obtain ⟨τ, hτ⟩ := horb
  obtain ⟨l, hlN, hlL, hlτ⟩ := Sec4.mem_autIn_iff.mp (τ : T).2
  refine ⟨l, ⟨hlL, hlN⟩, ?_⟩
  have hz' : (((τ : MulAut A) yA : A) : G) = z := congrArg Subtype.val hτ
  rw [← hz', ← hlτ]
  rfl

theorem center_eq_bot_of_isZ3 {A L : Subgroup G} {c : G} (h : Sec13Data G A c L) {n : ℕ}
    (hn : 1 ≤ n) (hiso : Sec4.IsoLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) 2 n) :
    Subgroup.center (↥L ⧸ aschbacherSolvableCore 3 ↥L) = ⊥ := by
  rcases hiso with ⟨hq, ⟨φ⟩⟩ | ⟨hq, ⟨φ⟩⟩
  · exact center_eq_bot_of_mulEquiv φ (isPerfect_center_projSL 2 n hn hq).2
  · by_cases hq2 : 2 < 2 ^ n
    · exact center_eq_bot_of_mulEquiv φ (isPerfect_center_projSU 2 n hn hq hq2).2
    · exfalso
      have hn1 : n = 1 := by
        rcases Nat.lt_or_ge n 2 with h' | h'
        · omega
        · have : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) h'
          omega
      subst hn1
      have hqs := Sec6.isQuasisimple_of_mem_thetaComponentsAt h.mem_thetaComponentsAt
      obtain ⟨hperf, -, x, y, hxy⟩ := hqs
      have hsolv : Group.IsSolvable (projSU 3 2 1) := isSolvable_projSU_two
      have : Group.IsSolvable (↥L ⧸ aschbacherSolvableCore 3 ↥L) :=
        Group.isSolvable_of_isSolvable_injective (f := φ.toMonoidHom) φ.injective
      have : Nontrivial (↥L ⧸ aschbacherSolvableCore 3 ↥L) := by
        by_contra hnt
        rw [not_nontrivial_iff_subsingleton] at hnt
        have : Subsingleton ((↥L ⧸ aschbacherSolvableCore 3 ↥L) ⧸
            Subgroup.center (↥L ⧸ aschbacherSolvableCore 3 ↥L)) :=
          QuotientGroup.mk_surjective.subsingleton
        exact hxy (Subsingleton.elim _ _)
      have := hperf
      exact Group.IsPerfect.not_isSolvable (↥L ⧸ aschbacherSolvableCore 3 ↥L) inferInstance

theorem autIn_cases_of_isZ3 (h131 : Item131) {A L : Subgroup G} {c : G} (h : Ctx169 G A c L)
    {n : ℕ} (hz : IsZ3LThreeTwo A c L n) :
    c ∉ L ∧ (Nonempty (Sec4.autIn L A ≃* QuaternionGroup 2) ∨
      Nonempty (Sec4.autIn L A ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3))) := by
  obtain ⟨hn, hiso, ⟨φ⟩⟩ := hz
  have hD := h.toSec13Data
  have hcL : c ∉ L := not_mem_of_center_eq_bot hD (center_eq_bot_of_isZ3 hD hn hiso)
  refine ⟨hcL, ?_⟩
  have hcard : ∀ {S : Type} [Group S], (lBarA c L A ≃* Multiplicative (ZMod 3) × S) →
      Nat.card (↥L ⧸ aschbacherSolvableCore 3 ↥L) = Nat.card S := by
    intro S _ ψ
    obtain ⟨η⟩ := nonempty_thetaQuot_equiv hD (isPerfect_lBar hD) φ
    have h1 := Nat.card_congr φ.toEquiv
    have h2 := Nat.card_congr ψ.toEquiv
    have h3 : Nat.card (Multiplicative (ZMod 3)) = 3 := by
      rw [Nat.card_congr (Multiplicative.toAdd (α := ZMod 3)), Nat.card_zmod]
    rw [Nat.card_prod, h3] at h1 h2
    rw [Nat.card_congr η.toEquiv]
    omega
  rcases h131 G A c L hD with ⟨-, hstar⟩ | ⟨hPGL, -, -⟩ | ⟨⟨ψ⟩, -⟩ | ⟨⟨ψ⟩, -⟩ | ⟨⟨ψ⟩, -⟩ |
      ⟨⟨ψ⟩, -⟩ | ⟨h7, -, -⟩
  · exact hstar
  · exact (Proof1514.false_of_prod_of_isZ3PGLThreePi hD hcL ⟨φ⟩ hPGL).elim
  · exact (Proof1514.not_isoLThreePi_of_card_2520
      (by rw [hcard ψ, KFacts.KS14.card_alternatingGroup_five_seven_ten.2.1]) 2 n hiso).elim
  · exact (KFacts.KS14.not_isoLThreePi_of_card (by rw [hcard ψ, KFacts.KS14.card_nativeM22])
      (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) KFacts.KS14.checkSL_m22)
      (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) KFacts.KS14.checkSU_m22)
      2 n hiso).elim
  · exact (KFacts.KS14.not_isoLThreePi_of_card (by rw [hcard ψ, KFacts.KS14.card_nativeM12])
      (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) KFacts.KS14.checkSL_m12)
      (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) KFacts.KS14.checkSU_m12)
      2 n hiso).elim
  · exact (KFacts.KS14.not_isoLThreePi_of_card (by rw [hcard ψ, KFacts.KS14.card_nativeJ2])
      (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) KFacts.KS14.checkSL_j2)
      (KFacts.KS14.forall_of_forall_lt (by norm_num) (by norm_num) KFacts.KS14.checkSU_j2)
      2 n hiso).elim
  · exfalso
    rcases h7 with hSL | ⟨hH, -⟩
    · exact hcL (mem_of_isSLThreePiTwo slTwoCenter hD hSL)
    · exact hcL (mem_of_isHeisCentral hD hH)

end CFSG.RankThree.PartTwo.Sec16.Proof1621

