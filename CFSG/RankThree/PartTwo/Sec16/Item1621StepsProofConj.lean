open CFSG CFSG.RankThree CFSG.RankThree.PartTwo CFSG.RankThree.PartTwo.Sec13
  CFSG.RankThree.PartTwo.Sec16.Proof1621

theorem step1621Conj_of (h131 : Item131) : Step1621Conj := by
  intro G _ _ A c L h b n p P hD a ha ha1
  obtain ⟨hcL, hstar⟩ := autIn_cases_of_isZ3 h131 h hD.isZ3
  have hS := h.toSec13Data
  obtain ⟨-, -, ⟨φ⟩⟩ := hD.isZ3
  have h9 : Nat.card (A ⊓ L : Subgroup G) = 9 := card_inf_eq_nine hS (isPerfect_lBar hS) φ
  have hAa : A = Subgroup.zpowers c ⊔ (A ⊓ L) := eq_sup_of_card_nine hS h9 (fun h => hcL h.2)
  have hPL : P ≤ L ⊓ Subgroup.centralizer ({b} : Set G) := hD.mem_Q.1.2
  have hPc : ∀ x ∈ P, x * c = c * x := fun x hx =>
    Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer (hPL hx).1)
  have hPb : ∀ x ∈ P, x * b = b * x := fun x hx =>
    Subgroup.mem_centralizer_singleton_iff.mp (hPL hx).2
  obtain ⟨i, -, f, hf, rfl⟩ := exists_pow_mul_of_mem hS.isElemAbelian hS.mem_A hAa ha
  by_cases hf1 : f = 1
  · refine ⟨1, Subgroup.one_mem _, ?_⟩
    rw [Late.map_conj_one]
    intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff, hf1, mul_one]
    exact (Commute.pow_right (hPc x hx) i).eq
  · have hb1 : b ≠ 1 := fun h1 => hD.not_mem (h1 ▸ Subgroup.one_mem _)
    obtain ⟨l, ⟨hlL, hlN⟩, hlf⟩ := exists_conj_eq_of_cases hS hcL h9 hstar hf hf1
      ⟨hD.mem_A, hD.mem_L⟩ hb1
    refine ⟨l⁻¹, inv_mem hlN, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    have hlc : l * c * l⁻¹ = c := by
      rw [Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer hlL), mul_inv_cancel_right]
    have hconj : l * (c ^ i * f) * l⁻¹ = c ^ i * b := by
      calc l * (c ^ i * f) * l⁻¹ = (l * c * l⁻¹) ^ i * (l * f * l⁻¹) := by
            rw [← MulAut.conj_apply, ← MulAut.conj_apply, ← MulAut.conj_apply, map_mul, map_pow]
        _ = c ^ i * b := by rw [hlc, hlf]
    have hxcb : x * (c ^ i * b) = (c ^ i * b) * x := by
      rw [← mul_assoc, (Commute.pow_right (hPc x hx) i).eq, mul_assoc, hPb x hx, mul_assoc]
    rw [Subgroup.mem_centralizer_singleton_iff]
    change l⁻¹ * x * l⁻¹⁻¹ * (c ^ i * f) = c ^ i * f * (l⁻¹ * x * l⁻¹⁻¹)
    have hcf : c ^ i * f = l⁻¹ * (c ^ i * b) * l := by
      rw [← hconj]
      group
    rw [hcf]
    calc l⁻¹ * x * l⁻¹⁻¹ * (l⁻¹ * (c ^ i * b) * l) = l⁻¹ * (x * (c ^ i * b)) * l := by group
      _ = l⁻¹ * ((c ^ i * b) * x) * l := by rw [hxcb]
      _ = l⁻¹ * (c ^ i * b) * l * (l⁻¹ * x * l⁻¹⁻¹) := by group

end CFSG.RankThree.PartTwo.Sec16
