variable {G : Type*} [Group G]

theorem le_normalizer_of_commute {H K : Subgroup G} (h : ∀ x ∈ H, ∀ y ∈ K, x * y = y * x) :
    H ≤ Subgroup.normalizer (K : Set G) := by
  apply le_normalizer_of_forall_conj_mem
  intro x hx y hy
  rw [h x hx y hy, mul_inv_cancel_right]
  exact hy

theorem conj_commutatorElement_eq {k v b : G}
    (h : ⁅k, b⁆ * (b * (k * v * k⁻¹)⁻¹ * b⁻¹) = (b * (k * v * k⁻¹)⁻¹ * b⁻¹) * ⁅k, b⁆) :
    k * ⁅v, b⁆ * k⁻¹ = ⁅k * v * k⁻¹, b⁆ := by
  calc k * ⁅v, b⁆ * k⁻¹
      = (k * v * k⁻¹) * (⁅k, b⁆ * (b * (k * v * k⁻¹)⁻¹ * b⁻¹)) * ⁅k, b⁆⁻¹ := by
        simp only [commutatorElement_def]
        group
    _ = (k * v * k⁻¹) * ((b * (k * v * k⁻¹)⁻¹ * b⁻¹) * ⁅k, b⁆) * ⁅k, b⁆⁻¹ := by rw [h]
    _ = ⁅k * v * k⁻¹, b⁆ := by
        simp only [commutatorElement_def]
        group

theorem le_normalizer_commutator_of_comm {Ω V K B : Subgroup G} (hVΩ : V ≤ Ω)
    (hKV : K ≤ Subgroup.normalizer (V : Set G)) (hBV : B ≤ Subgroup.normalizer (V : Set G))
    (hKB : ∀ k ∈ K, ∀ b ∈ B, ∀ ω ∈ Ω, ⁅k, b⁆ * ω = ω * ⁅k, b⁆) :
    K ≤ Subgroup.normalizer ((⁅V, B⁆ : Subgroup G) : Set G) := by
  apply le_normalizer_of_forall_conj_mem
  intro k hk x hx
  have hle : ⁅V, B⁆ ≤ (⁅V, B⁆ : Subgroup G).comap (MulAut.conj k).toMonoidHom := by
    rw [Subgroup.commutator_le]
    intro v hv b hb
    rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    have hv' : k * v * k⁻¹ ∈ V := (Subgroup.mem_normalizer_iff.mp (hKV hk) v).mp hv
    have hw : b * (k * v * k⁻¹)⁻¹ * b⁻¹ ∈ V :=
      (Subgroup.mem_normalizer_iff.mp (hBV hb) _).mp (V.inv_mem hv')
    rw [conj_commutatorElement_eq (hKB k hk b hb _ (hVΩ hw))]
    exact Subgroup.commutator_mem_commutator hv' hb
  have := hle hx
  rwa [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at this

theorem commute_conj_of_commute {k b ω : G} (hb : b * ω = ω * b)
    (ho : ⁅k⁻¹, b⁆ * ω = ω * ⁅k⁻¹, b⁆) : b * (k * ω * k⁻¹) = (k * ω * k⁻¹) * b := by
  have e : b * k = k * ⁅k⁻¹, b⁆ * b := by
    simp only [commutatorElement_def]
    group
  have e' : ⁅k⁻¹, b⁆ * b * k⁻¹ = k⁻¹ * b := by
    simp only [commutatorElement_def]
    group
  calc b * (k * ω * k⁻¹) = (b * k) * ω * k⁻¹ := by group
    _ = k * ⁅k⁻¹, b⁆ * b * ω * k⁻¹ := by rw [e]
    _ = k * (⁅k⁻¹, b⁆ * (b * ω)) * k⁻¹ := by group
    _ = k * (⁅k⁻¹, b⁆ * (ω * b)) * k⁻¹ := by rw [hb]
    _ = k * ((⁅k⁻¹, b⁆ * ω) * b) * k⁻¹ := by group
    _ = k * ((ω * ⁅k⁻¹, b⁆) * b) * k⁻¹ := by rw [ho]
    _ = k * ω * (⁅k⁻¹, b⁆ * b * k⁻¹) := by group
    _ = k * ω * (k⁻¹ * b) := by rw [e']
    _ = (k * ω * k⁻¹) * b := by group

theorem le_normalizer_inf_centralizer {Ω W K B : Subgroup G} {D : Set G} (hDB : D ⊆ B)
    (hWΩ : W ≤ Ω) (hKW : K ≤ Subgroup.normalizer (W : Set G))
    (hKB : ∀ k ∈ K, ∀ b ∈ B, ∀ ω ∈ Ω, ⁅k, b⁆ * ω = ω * ⁅k, b⁆) :
    K ≤ Subgroup.normalizer ((W ⊓ Subgroup.centralizer D : Subgroup G) : Set G) := by
  apply le_normalizer_of_forall_conj_mem
  intro k hk x hx
  obtain ⟨hxW, hxD⟩ := Subgroup.mem_inf.mp hx
  refine Subgroup.mem_inf.mpr ⟨(Subgroup.mem_normalizer_iff.mp (hKW hk) x).mp hxW, ?_⟩
  rw [Subgroup.mem_centralizer_iff] at hxD ⊢
  intro d hd
  exact commute_conj_of_commute (hxD d hd) (hKB _ (K.inv_mem hk) d (hDB hd) x (hWΩ hxW))

theorem mem_centralizer_of_eq_mul {U : Subgroup G} {d₁ d₂ d₃ x y z : G}
    (hd₁U : d₁ ∈ Subgroup.normalizer (U : Set G)) (h12 : Commute d₁ d₂) (h13 : Commute d₁ d₃)
    (hx : x ∈ U) (hxy : x = y * z) (hx3 : Commute d₃ x) (hy1 : Commute d₁ y)
    (hz2 : Commute d₂ z) (h23 : ∀ u ∈ U, Commute d₂ u → Commute d₃ u → u = 1) :
    Commute d₁ x := by
  have hδU : x⁻¹ * (d₁ * x * d₁⁻¹) ∈ U :=
    U.mul_mem (U.inv_mem hx) ((Subgroup.mem_normalizer_iff.mp hd₁U x).mp hx)
  have hδ : x⁻¹ * (d₁ * x * d₁⁻¹) = z⁻¹ * (d₁ * z * d₁⁻¹) := by
    rw [hxy]
    calc (y * z)⁻¹ * (d₁ * (y * z) * d₁⁻¹) = z⁻¹ * y⁻¹ * ((d₁ * y) * z * d₁⁻¹) := by group
      _ = z⁻¹ * y⁻¹ * ((y * d₁) * z * d₁⁻¹) := by rw [hy1.eq]
      _ = z⁻¹ * (d₁ * z * d₁⁻¹) := by group
  have h2 : Commute d₂ (x⁻¹ * (d₁ * x * d₁⁻¹)) := by
    rw [hδ]
    exact hz2.inv_right.mul_right ((h12.symm.mul_right hz2).mul_right h12.symm.inv_right)
  have h3 : Commute d₃ (x⁻¹ * (d₁ * x * d₁⁻¹)) :=
    hx3.inv_right.mul_right ((h13.symm.mul_right hx3).mul_right h13.symm.inv_right)
  have h4 : d₁ * x * d₁⁻¹ = x := (inv_mul_eq_one.mp (h23 _ hδU h2 h3)).symm
  calc d₁ * x = d₁ * x * d₁⁻¹ * d₁ := by group
    _ = x * d₁ := by rw [h4]

end General

variable {G : Type} [Group G] [Finite G]

theorem exists_layers {Ω Z K B : Subgroup G} {S : Set G}
    (hK : K = Subgroup.closure S) (hS : ∀ s ∈ S, s ^ 3 = 1)
    (hΩc : ∀ x ∈ Ω, ∀ y ∈ Ω, x * y = y * x) (hΩ2 : ∀ x ∈ Ω, x * x = 1) (hΩp : IsPGroup 2 Ω)
    (hKΩ : K ≤ Subgroup.normalizer (Ω : Set G)) (hZΩ : Z ≤ Ω)
    (hBc : ∀ a ∈ B, ∀ b ∈ B, a * b = b * a) (hB3 : ∀ b ∈ B, b ^ 3 = 1) (hB9 : Nat.card B = 9)
    (hBV : B ≤ Subgroup.normalizer ((⁅Z, K⁆ : Subgroup G) : Set G))
    (hKB : ∀ k ∈ K, ∀ b ∈ B, ∀ ω ∈ Ω, ⁅k, b⁆ * ω = ω * ⁅k, b⁆)
    (htr : ∀ d ∈ B, ∀ d' ∈ B, d ≠ 1 → d' ≠ 1 → ∃ t : G,
      t ∈ Subgroup.normalizer (K : Set G) ∧ t ∈ Subgroup.normalizer (Z : Set G) ∧
        t ∈ Subgroup.normalizer (B : Set G) ∧ t * d * t⁻¹ = d')
    (hne : ⁅⁅Z, K⁆, B⁆ ≠ ⊥) :
    ∃ W₁ W₂ W₃ : Subgroup G, ⊥ < W₁ ∧ W₁ < W₂ ∧ W₂ < W₃ ∧ W₃ ≤ Ω ∧
      K ≤ Subgroup.normalizer (W₁ : Set G) ∧ K ≤ Subgroup.normalizer (W₂ : Set G) ∧
      K ≤ Subgroup.normalizer (W₃ : Set G) ∧
      W₁ ≤ ⁅W₁, K⁆ ∧ W₂ ≤ W₁ ⊔ ⁅W₂, K⁆ ∧ W₃ ≤ W₂ ⊔ ⁅W₃, K⁆ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set V := ⁅Z, K⁆ with hV
  set U := ⁅V, B⁆ with hU
  have hVΩ : V ≤ Ω := commutator_le_of_le_of_le_normalizer hZΩ hKΩ
  have hKV : K ≤ Subgroup.normalizer (V : Set G) := le_normalizer_commutator_right Z K
  have hUV : U ≤ V := commutator_le_left_of_le_normalizer hBV
  have hUΩ : U ≤ Ω := hUV.trans hVΩ
  have hBU : B ≤ Subgroup.normalizer (U : Set G) := le_normalizer_commutator_right V B
  have hKU : K ≤ Subgroup.normalizer (U : Set G) := le_normalizer_commutator_of_comm hVΩ hKV hBV hKB
  have hcop : ∀ W : Subgroup G, W ≤ Ω → Nat.Coprime (Nat.card B) (Nat.card W) := by
    intro W hW
    obtain ⟨k, hk⟩ := (hΩp.to_le hW).exists_card_eq
    rw [hB9, hk]
    exact Nat.Coprime.pow_right _ (by norm_num)
  have hU3 : ¬ 3 ∣ Nat.card U := by
    obtain ⟨k, hk⟩ := (hΩp.to_le hUΩ).exists_card_eq
    rw [hk]
    exact fun h => absurd (Nat.prime_three.dvd_of_dvd_pow h) (by norm_num)
  have hUB : U ⊓ Subgroup.centralizer (B : Set G) = ⊥ := by
    have := CFSG.RankThree.Coprime.commutator_inf_centralizer_eq_bot (B := B) (K := V)
      (fun x hx y hy => hΩc x (hVΩ hx) y (hVΩ hy)) hBV (hcop V hVΩ)
    rwa [Subgroup.commutator_comm] at this
  have hVVK : V ≤ ⁅V, K⁆ := commutator_le_commutator_commutator hK hS hΩc hΩ2 hKΩ hZΩ
  have hUK : ⁅U, K⁆ ≠ ⊥ := by
    intro hbot
    apply hne
    have hKVB : K ≤ Subgroup.normalizer
        ((V ⊓ Subgroup.centralizer (B : Set G) : Subgroup G) : Set G) :=
      le_normalizer_inf_centralizer (D := (B : Set G)) subset_rfl hVΩ hKV hKB
    have hVs : Group.IsSolvable V := by
      have : IsMulCommutative V :=
        ⟨⟨fun x y => Subtype.ext (hΩc _ (hVΩ x.2) _ (hVΩ y.2))⟩⟩
      infer_instance
    have hVKB : ⁅V, K⁆ ≤ V ⊓ Subgroup.centralizer (B : Set G) := by
      rw [Subgroup.commutator_le]
      intro v hv k hk
      obtain ⟨c, hc, d, hd, rfl⟩ :=
        CFSG.LocalAnalysis.EvenBN.TwoF4.exists_mul_inf_centralizer_commutator hBV hVs
          (hcop V hVΩ) hv
      have hdk : d * k = k * d := by
        have h1 : ⁅d, k⁆ ∈ ⁅U, K⁆ := Subgroup.commutator_mem_commutator hd hk
        rw [hbot, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at h1
        exact h1
      have e : ⁅c * d, k⁆ = c * (k * c⁻¹ * k⁻¹) := by
        rw [commutatorElement_def]
        calc c * d * k * (c * d)⁻¹ * k⁻¹ = c * (d * k) * d⁻¹ * c⁻¹ * k⁻¹ := by group
          _ = c * (k * d) * d⁻¹ * c⁻¹ * k⁻¹ := by rw [hdk]
          _ = c * (k * c⁻¹ * k⁻¹) := by group
      rw [e]
      exact Subgroup.mul_mem _ hc
        ((Subgroup.mem_normalizer_iff.mp (hKVB hk) c⁻¹).mp (Subgroup.inv_mem _ hc))
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact (hVVK.trans hVKB).trans inf_le_right
  have hgen := CFSG.RankThreeEvenClassification.Helpers.coprime_centralizer_generation_of_plane
    3 Nat.prime_three B U (fun b => Subtype.ext (by rw [Subgroup.coe_pow]; exact hB3 _ b.2))
    (by rw [hB9]; norm_num) hU3 hBU
  obtain ⟨d₀, hd₀B, hd₀1, hd₀⟩ : ∃ d ∈ B, d ≠ 1 ∧
      ⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ ≠ ⊥ := by
    by_contra hall
    push Not at hall
    apply hUK
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer, hgen]
    refine iSup₂_le fun b hb => ?_
    rw [← Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hall b b.2 (fun h => hb (Subtype.ext h))
  have hall : ∀ d ∈ B, d ≠ 1 → ⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ ≠ ⊥ := by
    intro d hdB hd1 hbot
    obtain ⟨t, htK, htZ, htB, rfl⟩ := htr d₀ hd₀B d hdB hd₀1 hd1
    apply hd₀
    have htV : t ∈ Subgroup.normalizer (V : Set G) := by
      rw [Subgroup.mem_normalizer_iff_map_conj_eq, hV, Subgroup.map_commutator,
        Subgroup.mem_normalizer_iff_map_conj_eq.mp htZ,
        Subgroup.mem_normalizer_iff_map_conj_eq.mp htK]
    have htU : t ∈ Subgroup.normalizer (U : Set G) := by
      rw [Subgroup.mem_normalizer_iff_map_conj_eq, hU, Subgroup.map_commutator,
        Subgroup.mem_normalizer_iff_map_conj_eq.mp htV,
        Subgroup.mem_normalizer_iff_map_conj_eq.mp htB]
    rw [eq_bot_iff, Subgroup.commutator_le]
    intro u hu k hk
    have hu' : t * u * t⁻¹ ∈ U ⊓ Subgroup.centralizer ({t * d₀ * t⁻¹} : Set G) := by
      obtain ⟨huU, huC⟩ := Subgroup.mem_inf.mp hu
      refine Subgroup.mem_inf.mpr ⟨(Subgroup.mem_normalizer_iff.mp htU u).mp huU, ?_⟩
      have h1 : u * d₀ = d₀ * u := Subgroup.mem_centralizer_singleton_iff.mp huC
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc t * u * t⁻¹ * (t * d₀ * t⁻¹) = t * (u * d₀) * t⁻¹ := by group
        _ = t * (d₀ * u) * t⁻¹ := by rw [h1]
        _ = t * d₀ * t⁻¹ * (t * u * t⁻¹) := by group
    have hk' : t * k * t⁻¹ ∈ K := (Subgroup.mem_normalizer_iff.mp htK k).mp hk
    have h1 : ⁅t * u * t⁻¹, t * k * t⁻¹⁆ = 1 := by
      have := Subgroup.commutator_mem_commutator hu' hk'
      rwa [hbot, Subgroup.mem_bot] at this
    have h2 : ⁅u, k⁆ = t⁻¹ * ⁅t * u * t⁻¹, t * k * t⁻¹⁆ * t := by
      simp only [commutatorElement_def]
      group
    rw [Subgroup.mem_bot, h2, h1, mul_one, inv_mul_cancel]
  let _ : CommGroup B :=
    { (inferInstance : Group B) with mul_comm := fun x y => Subtype.ext (hBc _ x.2 _ y.2) }
  have h3 : ∀ x : B, x ^ 3 = 1 := fun x => Subtype.ext (by
    rw [Subgroup.coe_pow]
    exact hB3 _ x.2)
  have hx₀ : (⟨d₀, hd₀B⟩ : B) ≠ 1 := fun h => hd₀1 (congrArg Subtype.val h)
  obtain ⟨y₀, hy₀⟩ := Sec3.exists_not_mem_zpowers h3 hB9 (⟨d₀, hd₀B⟩ : B)
  have hBgen : ∀ u : G, Commute d₀ u → Commute (y₀ : G) u →
      u ∈ Subgroup.centralizer (B : Set G) := by
    intro u h0 h2
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    obtain ⟨⟨i, j⟩, hij⟩ := (Sec3.bijective_pow_mul_pow h3 hB9 hx₀ hy₀).2 ⟨b, hb⟩
    have hb' : b = d₀ ^ (i : ℕ) * (y₀ : G) ^ (j : ℕ) := by
      have := congrArg Subtype.val hij
      rw [Subgroup.coe_mul, Subgroup.coe_pow, Subgroup.coe_pow] at this
      exact this.symm
    rw [hb']
    exact ((h0.pow_left _).mul_left (h2.pow_left _)).eq
  have hd₂B : (y₀ : G) ∈ B := y₀.2
  have hd₃B : d₀ * (y₀ : G) ∈ B := B.mul_mem hd₀B y₀.2
  have hd₂1 : (y₀ : G) ≠ 1 := fun h => hy₀ (by
    rw [show y₀ = 1 from Subtype.ext h]
    exact Subgroup.one_mem _)
  have hd₃1 : d₀ * (y₀ : G) ≠ 1 := fun h => hy₀ (by
    rw [show y₀ = (⟨d₀, hd₀B⟩ : B)⁻¹ from Subtype.ext (eq_inv_of_mul_eq_one_right h)]
    exact Subgroup.inv_mem _ (Subgroup.mem_zpowers _))
  have hcB : ∀ a ∈ B, ∀ b ∈ B, Commute a b := fun a ha b hb => hBc a ha b hb
  have hp02 : ∀ u ∈ U, Commute d₀ u → Commute (y₀ : G) u → u = 1 := fun u hu h0 h2 => by
    have : u ∈ U ⊓ Subgroup.centralizer (B : Set G) := ⟨hu, hBgen u h0 h2⟩
    rwa [hUB, Subgroup.mem_bot] at this
  have hp03 : ∀ u ∈ U, Commute d₀ u → Commute (d₀ * y₀) u → u = 1 := fun u hu h0 h3' =>
    hp02 u hu h0 (by
      have := h0.inv_left.mul_left h3'
      rwa [inv_mul_cancel_left] at this)
  have hp23 : ∀ u ∈ U, Commute (y₀ : G) u → Commute (d₀ * y₀) u → u = 1 := fun u hu h2 h3' =>
    hp02 u hu (by
      have := h3'.mul_left h2.inv_left
      rwa [mul_inv_cancel_right] at this) h2
  have hY : ∀ d ∈ B, d ≠ 1 →
      ⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ ≠ ⊥ ∧
      ⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ ≤ U ⊓ Subgroup.centralizer ({d} : Set G) ∧
      K ≤ Subgroup.normalizer
        ((⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ : Subgroup G) : Set G) ∧
      ⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ ≤
        ⁅⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆, K⁆ := by
    intro d hdB hd1
    refine ⟨hall d hdB hd1, commutator_le_left_of_le_normalizer
      (le_normalizer_inf_centralizer (Set.singleton_subset_iff.mpr hdB) hUΩ hKU hKB),
      le_normalizer_commutator_right _ K,
      commutator_le_commutator_commutator hK hS hΩc hΩ2 hKΩ (inf_le_left.trans hUΩ)⟩
  obtain ⟨hY₀ne, hY₀le, hY₀K, hY₀p⟩ := hY d₀ hd₀B hd₀1
  obtain ⟨hY₂ne, hY₂le, hY₂K, hY₂p⟩ := hY y₀ hd₂B hd₂1
  obtain ⟨hY₃ne, hY₃le, hY₃K, hY₃p⟩ := hY _ hd₃B hd₃1
  set Y₀ := ⁅U ⊓ Subgroup.centralizer ({d₀} : Set G), K⁆ with hY₀
  set Y₂ := ⁅U ⊓ Subgroup.centralizer ({(y₀ : G)} : Set G), K⁆ with hY₂
  set Y₃ := ⁅U ⊓ Subgroup.centralizer ({d₀ * (y₀ : G)} : Set G), K⁆ with hY₃
  have hmem : ∀ {d u : G}, u ∈ U ⊓ Subgroup.centralizer ({d} : Set G) → u ∈ U ∧ Commute d u :=
    fun hu => ⟨(Subgroup.mem_inf.mp hu).1,
      (Subgroup.mem_centralizer_singleton_iff.mp (Subgroup.mem_inf.mp hu).2).symm⟩
  have hYΩ : ∀ {d : G}, ⁅U ⊓ Subgroup.centralizer ({d} : Set G), K⁆ ≤ Ω := fun {d} =>
    commutator_le_of_le_of_le_normalizer (inf_le_left.trans hUΩ) hKΩ
  have hKsup : ∀ {P Q : Subgroup G}, K ≤ Subgroup.normalizer (P : Set G) →
      K ≤ Subgroup.normalizer (Q : Set G) →
        K ≤ Subgroup.normalizer ((P ⊔ Q : Subgroup G) : Set G) :=
    fun hP hQ k hk => Subgroup.inf_normalizer_le_normalizer_sup _ _ ⟨hP hk, hQ hk⟩
  refine ⟨Y₀, Y₀ ⊔ Y₂, Y₀ ⊔ Y₂ ⊔ Y₃, bot_lt_iff_ne_bot.mpr hY₀ne,
    lt_of_le_of_ne le_sup_left fun h => hY₂ne ?_, lt_of_le_of_ne le_sup_left fun h => hY₃ne ?_,
    sup_le (sup_le hYΩ hYΩ) hYΩ, hY₀K, hKsup hY₀K hY₂K, hKsup (hKsup hY₀K hY₂K) hY₃K, hY₀p,
    sup_le le_sup_left (hY₂p.trans ((Subgroup.commutator_mono le_sup_right le_rfl).trans
      le_sup_right)),
    sup_le le_sup_left (hY₃p.trans ((Subgroup.commutator_mono le_sup_right le_rfl).trans
      le_sup_right))⟩
  ·
    rw [eq_bot_iff]
    intro u hu
    have hu0 : u ∈ Y₀ := h ▸ (le_sup_right : Y₂ ≤ Y₀ ⊔ Y₂) hu
    obtain ⟨huU, hu2⟩ := hmem (hY₂le hu)
    exact (Subgroup.mem_bot).mpr (hp02 u huU (hmem (hY₀le hu0)).2 hu2)
  ·
    rw [eq_bot_iff]
    intro x hx
    have hx02 : x ∈ Y₀ ⊔ Y₂ := h ▸ (le_sup_right : Y₃ ≤ Y₀ ⊔ Y₂ ⊔ Y₃) hx
    have hx' : x ∈ (Y₀ : Set G) * (Y₂ : Set G) := by
      rw [← Subgroup.coe_mul_of_left_le_normalizer_right Y₀ Y₂
        (le_normalizer_of_commute fun a ha b hb => hΩc a (hYΩ ha) b (hYΩ hb))]
      exact hx02
    obtain ⟨y, hy, z, hz, hyz⟩ := hx'
    obtain ⟨hxU, hx3⟩ := hmem (hY₃le hx)
    have h0 : Commute d₀ x := mem_centralizer_of_eq_mul (hBU hd₀B)
      (hcB _ hd₀B _ hd₂B) (hcB _ hd₀B _ hd₃B) hxU hyz.symm hx3 (hmem (hY₀le hy)).2
      (hmem (hY₂le hz)).2 hp23
    exact (Subgroup.mem_bot).mpr (hp03 x hxU h0 hx3)

end Res3

