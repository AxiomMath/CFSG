theorem omegaZOf_props (Q : Subgroup G) :
    (∀ x ∈ Sec3.omegaZOf Q, ∀ y ∈ Sec3.omegaZOf Q, x * y = y * x) ∧
      (∀ x ∈ Sec3.omegaZOf Q, x * x = 1) ∧ Sec3.omegaZOf Q ≤ Q ∧
      ∀ x ∈ Sec3.omegaZOf Q, ∀ q ∈ Q, q * x = x * q := by
  have key : ∀ x ∈ Sec3.omegaZOf Q, x ∈ Q ∧ x * x = 1 ∧ ∀ q ∈ Q, q * x = x * q := by
    rintro _ ⟨w, hw, rfl⟩
    rw [SetLike.mem_coe, mem_omegaOneCenter_top_iff] at hw
    refine ⟨w.2, ?_, fun q hq => ?_⟩
    · have := congrArg Subtype.val hw.2
      rwa [Subgroup.coe_pow, pow_two] at this
    · exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hw.1 ⟨q, hq⟩)
  refine ⟨fun x hx y hy => ?_, fun x hx => (key x hx).2.1, fun x hx => (key x hx).1,
    fun x hx => (key x hx).2.2⟩
  exact ((key y hy).2.2 x (key x hx).1)

theorem commutator_mem_pCoreOf_core {A M L N : Subgroup G} {c : G} {T : Subgroup G}
    (hT : Ctx20 G A M L N c T)
    (hBn : M ≤ Subgroup.normalizer (((A ⊓ L) ⊔ CFSG.Open.pCoreOf 2 M : Subgroup G) : Set G))
    (hKC : kTwenty M c ∈ oTwoComponentsIn M) (h3 : KIsL3 M c) {k b : G}
    (hk : k ∈ kTwenty M c) (hb : b ∈ A ⊓ L) : ⁅k, b⁆ ∈ CFSG.Open.pCoreOf 2 (kTwenty M c) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set K := kTwenty M c with hKdef
  set R₀ := (A ⊓ L) ⊔ CFSG.Open.pCoreOf 2 M with hR₀
  have hMR : M ≤ Subgroup.normalizer (R₀ : Set G) := hBn
  have hKM : K ≤ M := kTwenty_le_of_hyp201 hT.toHyp201
  have hMK : M ≤ Subgroup.normalizer (K : Set G) := le_normalizer_normalClosureIn M c
  have hAM : A ≤ M := le_of_hyp201 hT.toHyp201
  have hbR : b ∈ R₀ := le_sup_left (a := A ⊓ L) hb
  have hkbK : ⁅k, b⁆ ∈ K := by
    rw [commutatorElement_def, show k * b * k⁻¹ * b⁻¹ = k * (b * k⁻¹ * b⁻¹) by group]
    exact K.mul_mem hk ((Subgroup.mem_normalizer_iff.mp (hMK (hAM hb.1)) _).mp (K.inv_mem hk))
  have hkbR : ⁅k, b⁆ ∈ R₀ := by
    rw [commutatorElement_def]
    exact R₀.mul_mem ((Subgroup.mem_normalizer_iff.mp (hMR (hKM hk)) b).mp hbR) (R₀.inv_mem hbR)
  have hsimple : IsSimpleGroup (↥K ⧸ CFSG.pCore 2 ↥K) :=
    Sec18.isSimpleGroup_of_item189Three (Or.inl h3)
  obtain ⟨-, hperf, -, -⟩ := mem_oTwoComponentsIn_iff.mp hKC
  have hperfK : Group.IsPerfect ↥K :=
    Group.IsPerfect.ofSurjective (f := (Subgroup.subgroupOfEquivOfLe hKM).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hKM).surjective
  have hperfQ : Group.IsPerfect (↥K ⧸ CFSG.pCore 2 ↥K) :=
    Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' (CFSG.pCore 2 ↥K))
      (QuotientGroup.mk'_surjective _)
  set J : Subgroup ↥K := R₀.subgroupOf K with hJ
  have hJn : J.Normal := ⟨fun x hx g => by
    rw [hJ, Subgroup.mem_subgroupOf] at hx ⊢
    rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv]
    exact (Subgroup.mem_normalizer_iff.mp (hMR (hKM g.2)) x).mp hx⟩
  have hR₀s : Group.IsSolvable R₀ := by
    have hAE := hT.mem_partTwoE.1
    have hAc : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := fun a ha b hb =>
      congrArg Subtype.val (hAE.1.is_comm.comm (⟨a, ha⟩ : A) ⟨b, hb⟩)
    have hBc : IsMulCommutative ↥(A ⊓ L) :=
      ⟨⟨fun x y => Subtype.ext (hAc _ x.2.1 _ y.2.1)⟩⟩
    exact Sec18.isSolvable_sup_of_le_normalizer hBc
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 M)
      ((inf_le_left.trans hAM).trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 M))
  have hJs : Group.IsSolvable J := by
    let ι : J →* R₀ :=
      { toFun := fun x => ⟨((x : ↥K) : G), Subgroup.mem_subgroupOf.mp x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    refine Group.isSolvable_of_isSolvable_injective (f := ι) fun x y hxy => ?_
    have h1 := congrArg Subtype.val hxy
    exact Subtype.ext (Subtype.ext h1)
  have : (J.map (QuotientGroup.mk' (CFSG.pCore 2 ↥K))).Normal :=
    hJn.map _ (QuotientGroup.mk'_surjective _)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (J.map (QuotientGroup.mk' (CFSG.pCore 2 ↥K)))
    with hbot | htop
  ·
    have hJle : J ≤ CFSG.pCore 2 ↥K := by
      rw [← QuotientGroup.ker_mk' (CFSG.pCore 2 ↥K), ← Subgroup.map_eq_bot_iff]
      exact hbot
    have hmem : (⟨⁅k, b⁆, hkbK⟩ : ↥K) ∈ CFSG.pCore 2 ↥K :=
      hJle (Subgroup.mem_subgroupOf.mpr hkbR)
    exact ⟨⟨⁅k, b⁆, hkbK⟩, hmem, rfl⟩
  ·
    exfalso
    have hsurj : Function.Surjective ((QuotientGroup.mk' (CFSG.pCore 2 ↥K)).comp J.subtype) := by
      intro q
      have hq : q ∈ J.map (QuotientGroup.mk' (CFSG.pCore 2 ↥K)) := htop ▸ Subgroup.mem_top q
      obtain ⟨x, hx, rfl⟩ := hq
      exact ⟨⟨x, hx⟩, rfl⟩
    have : Group.IsSolvable (↥K ⧸ CFSG.pCore 2 ↥K) := Group.isSolvable_of_surjective hsurj
    exact absurd this (Group.IsPerfect.not_isSolvable _)

end Concrete

