theorem Res6.exists_le_autIn_sylow {G : Type} [Group G] [Finite G] {M T B : Subgroup G}
    (hT : IsSylowOf 2 T M) (hB3 : IsPGroup 3 B) (hBM : B ≤ M)
    (hBn : M ≤ Subgroup.normalizer ((B ⊔ CFSG.Open.pCoreOf 2 M : Subgroup G) : Set G))
    {E : Subgroup G} (hE2 : IsPGroup 2 E) (hEM : E ≤ M)
    (Q : Subgroup (MulAut B)) (hQ : Q ≤ Sec4.autIn E B) :
    ∃ Q' : Subgroup (MulAut B), Q' ≤ Sec4.autIn T B ∧ Nonempty (Q ≃* Q') := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set O := CFSG.Open.pCoreOf 2 M with hO
  have hTM : T ≤ M := hT.le
  have hOT : O ≤ T := Sec20.pCoreOf_le_of_isSylowOf hT
  obtain ⟨S, hS, hES⟩ := Sec20.exists_isSylowOf_le hE2 hEM
  obtain ⟨n, hnM, rfl⟩ := Sec18.exists_map_conj_eq_of_isSylowOf hT hS
  have hE1 : E.map (MulAut.conj n⁻¹).toMonoidHom ≤ T := by
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨t, ht, htx⟩ := hES hx
    rw [← htx]
    simpa [MulAut.conj_apply, mul_assoc] using ht
  obtain ⟨o, ho, hBo⟩ := Res6.exists_conj_eq_of_sup hB3 hBM hBn (M.inv_mem hnM)
  set h := o⁻¹ * n⁻¹ with hh
  have hhB : B.map (MulAut.conj h).toMonoidHom = B := by
    rw [hh, ← Res5.map_conj_map_conj, hBo, Res5.map_conj_map_conj, inv_mul_cancel,
      Res5.map_conj_one]
  have hhN : h ∈ Subgroup.normalizer (B : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    exact hhB
  have hET : E.map (MulAut.conj h).toMonoidHom ≤ T := by
    rw [hh, ← Res5.map_conj_map_conj]
    have hoT : o⁻¹ ∈ T := hOT (inv_mem ho)
    rw [← Late.map_conj_eq_of_mem_normalizer (Subgroup.le_normalizer hoT)]
    exact Subgroup.map_mono hE1
  set σ : MulAut B := B.normalizerMonoidHom ⟨h, hhN⟩ with hσ
  refine ⟨Q.map (MulAut.conj σ).toMonoidHom, ?_,
    ⟨Q.equivMapOfInjective _ (MulAut.conj σ).injective⟩⟩
  rintro _ ⟨τ, hτ, rfl⟩
  obtain ⟨e, heN, heE, rfl⟩ := Sec4.mem_autIn_iff.mp (hQ hτ)
  have hheN : h * e * h⁻¹ ∈ Subgroup.normalizer (B : Set G) :=
    mul_mem (mul_mem hhN heN) (inv_mem hhN)
  refine Sec4.mem_autIn_iff.mpr ⟨h * e * h⁻¹, hheN, hET ⟨e, heE, rfl⟩, ?_⟩
  have e1 : (⟨h * e * h⁻¹, hheN⟩ : Subgroup.normalizer (B : Set G)) =
      ⟨h, hhN⟩ * ⟨e, heN⟩ * (⟨h, hhN⟩ : Subgroup.normalizer (B : Set G))⁻¹ := rfl
  rw [e1, map_mul, map_mul, map_inv]
  rfl

theorem step204Normal_core {G : Type} [Group G] [Finite G] {A M L N : Subgroup G} {c : G}
    {T : Subgroup G} (hT : Ctx20 G A M L N c T) (hB9 : Nat.card (A ⊓ L : Subgroup G) = 9)
    (hB3 : IsPGroup 3 (A ⊓ L : Subgroup G))
    (hQ : ∃ Q : Subgroup (MulAut ↥(A ⊓ L)), Q ≤ Sec4.autIn M (A ⊓ L) ∧
      Nonempty (↥Q ≃* QuaternionGroup 2))
    (hc1 : c ≠ 1) (hAeq : A = Subgroup.zpowers c ⊔ (A ⊓ L))
    (hBn : M ≤ Subgroup.normalizer (((A ⊓ L) ⊔ CFSG.Open.pCoreOf 2 M : Subgroup G) : Set G)) :
      ∃ i j : Fin 4, i ≠ j ∧ i ≠ 3 ∧ j ≠ 3 ∧
        Sec18.fourChar (CFSG.Open.pCoreOf 2 (kTwenty M c ⊔ T)) i ≠ ⊥ ∧
        Sec18.fourChar (CFSG.Open.pCoreOf 2 (kTwenty M c ⊔ T)) j ≠ ⊥ ∧
        kTwenty M c ⊔ A ⊔ T ≤ Subgroup.normalizer
          (Sec18.fourChar (CFSG.Open.pCoreOf 2 (kTwenty M c ⊔ T)) i : Set G) ∧
        kTwenty M c ⊔ A ⊔ T ≤ Subgroup.normalizer
          (Sec18.fourChar (CFSG.Open.pCoreOf 2 (kTwenty M c ⊔ T)) j : Set G) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set K := kTwenty M c with hKdef
  set R := CFSG.Open.pCoreOf 2 (K ⊔ T) with hRdef
  set B := A ⊓ L with hBdef
  set O := CFSG.Open.pCoreOf 2 M with hOdef
  have hKM : K ≤ M := kTwenty_le_of_hyp201 hT.toHyp201
  have hTM : T ≤ M := hT.sylow.le
  have hKTM : K ⊔ T ≤ M := sup_le hKM hTM
  have hRM : R ≤ M := (CFSG.LieType.BorelTits.pCoreOf_le 2 _).trans hKTM
  have hR2 : IsPGroup 2 R := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 _
  have hAM : A ≤ M := le_of_hyp201 hT.toHyp201
  have hBM : B ≤ M := inf_le_left.trans hAM
  have hA := isE27_of_mem_partTwoE hT.mem_partTwoE
  have hBc : ∀ a ∈ B, ∀ b ∈ B, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hA.1.1.is_comm.comm ⟨a, ha.1⟩ ⟨b, hb.1⟩)
  have hBe : ∀ b ∈ B, b ^ 3 = 1 := fun b hb => hA.1.2 b hb.1
  have hT2 : IsPGroup 2 T := hT.sylow.isPGroup
  have hOT : O ≤ T := pCoreOf_le_of_isSylowOf hT.sylow
  have hOR : O ≤ R := CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
    (hOT.trans le_sup_right) (hKTM.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 M))
    (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 M)
  have hR1 : R ≠ ⊥ := fun h =>
    pCoreOf_ne_bot_of_isMaximalTwoLocal hT.mem_scriptM.1 (le_bot_iff.mp (h ▸ hOR))
  have hTKT : CFSG.ABGLocalTools.IsSylowOf 2 T (K ⊔ T) := by
    rw [CFSG.ABGLocalTools.isSylowOf_iff]
    refine ⟨le_sup_right, hT2, fun h2 => ?_⟩
    apply (CFSG.ABGLocalTools.isSylowOf_iff.mp hT.sylow).2.2
    rw [← Subgroup.relIndex_mul_relIndex T (K ⊔ T) M le_sup_right hKTM]
    exact Dvd.dvd.mul_right h2 _
  have hRT : R ≤ T := pCoreOf_le_of_isSylowOf hTKT
  obtain ⟨Q0, hQ0M, ⟨eQ0⟩⟩ := hQ
  have hQ0c : IsPGroup 2 Q0 := by
    have hcard : Nat.card Q0 = 8 := by
      rw [Nat.card_congr eQ0.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card] <;>
        norm_num
    exact IsPGroup.of_card (n := 3) (by norm_num [hcard])
  obtain ⟨D, hD2, hDM, -, hQ0D⟩ := Res6.exists_two_subgroup_of_le_autIn hQ0M hQ0c
  obtain ⟨Q1, hQ1T, ⟨eQ1⟩⟩ := Res6.exists_le_autIn_sylow hT.sylow hB3 hBM hBn hD2 hDM Q0 hQ0D
  have hQ8T : ∃ Q : Subgroup (MulAut ↥B), Q ≤ Sec4.autIn T B ∧
      Nonempty (↥Q ≃* QuaternionGroup 2) := ⟨Q1, hQ1T, ⟨eQ1.symm.trans eQ0⟩⟩
  set X := T ⊔ B with hXdef
  have hTXle : T ≤ X := le_sup_left
  have hBXle : B ≤ X := le_sup_right
  have hXM : X ≤ M := sup_le hTM hBM
  have hOX : O ≤ X := hOT.trans hTXle
  have hTBO : T ≤ Subgroup.normalizer ((B ⊔ O : Subgroup G) : Set G) := hTM.trans hBn
  have hBO : B ≤ Subgroup.normalizer (O : Set G) :=
    hBM.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 M)
  have hTNO : T ≤ Subgroup.normalizer (O : Set G) :=
    hTM.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 M)
  have hXeq : X = T ⊔ (B ⊔ O) := by
    apply le_antisymm
    · exact sup_le le_sup_left (le_sup_left.trans le_sup_right)
    · exact sup_le le_sup_left (sup_le le_sup_right (hOT.trans le_sup_left))
  have hTB' : ∀ g ∈ X, ∃ t ∈ T, ∃ b ∈ B, g = t * b := by
    intro g hg
    have hg' : g ∈ ((T ⊔ (B ⊔ O) : Subgroup G) : Set G) := hXeq ▸ hg
    rw [Subgroup.coe_mul_of_left_le_normalizer_right T (B ⊔ O) hTBO] at hg'
    obtain ⟨t, ht, y, hy, rfl⟩ := hg'
    have hy' : y ∈ ((B ⊔ O : Subgroup G) : Set G) := hy
    rw [Subgroup.coe_mul_of_left_le_normalizer_right B O hBO] at hy'
    obtain ⟨b, hb, o, ho, rfl⟩ := hy'
    have ho' : b * o * b⁻¹ ∈ O := (Subgroup.mem_normalizer_iff.mp (hBO hb) o).mp ho
    exact ⟨t * (b * o * b⁻¹), T.mul_mem ht (hOT ho'), b, hb, by group⟩
  have hTBinf : T ⊓ B = ⊥ :=
