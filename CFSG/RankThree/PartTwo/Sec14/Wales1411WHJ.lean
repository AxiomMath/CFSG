      Nonempty (↥La ⧸ aschbacherSolvableCore 3 ↥La ≃* CFSG.Blueprint.NativeSporadic.J2)
  · obtain ⟨ha, La, hLa, ⟨φ⟩⟩ := hj
    exact isConjIn_of_j2_point h142 hbot hJ2 hR ha hLa φ hY hIH hYa hS hT
  · refine h G A c L hR Y hYΔ hY hs h3 hBc hIH S hS T hT hD hbig hres a haA ha1 haS haT hpt
      fun ha La hLa => ⟨(hout ha La hLa).1, (hout ha La hLa).2.1, (hout ha La hLa).2.2.1,
        (hout ha La hLa).2.2.2.1, (hout ha La hLa).2.2.2.2.1, (hout ha La hLa).2.2.2.2.2,
        ⟨fun φ => hj ⟨ha, La, hLa, ⟨φ⟩⟩⟩⟩

