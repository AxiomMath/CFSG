variable {G : Type} [Group G] [Finite G]

theorem isConjIn_of_sup_ne {A Y S T : Subgroup G} (hY : Y ∈ scriptY A)
    (hIH : ∀ Y' ∈ scriptY A, Nat.card Y' < Nat.card Y →
      TransOn A (lB A) (Subgroup.normalizer (A : Set G)) Y')
    (hS : S ∈ scriptQPiStar A (lB A) Y (piOf 2)) (hT : T ∈ scriptQPiStar A (lB A) Y (piOf 2))
    (hne : S ⊔ T ≠ Y) : IsConjIn (Subgroup.normalizer (A : Set G) ⊓ Y) S T := by
  have hle : S ⊔ T ≤ Y := sup_le hS.prop.1.2 hT.prop.1.2
  have hlt : S ⊔ T < Y := lt_of_le_of_ne hle hne
  have hY' : S ⊔ T ∈ scriptY A :=
    ⟨fun htop => hY.1 (top_le_iff.mp (htop ▸ hle)),
      le_normalizer_sup_of_le hS.prop.1.1.1.2.2 hT.prop.1.1.1.2.2⟩
  have hsub : ∀ U ∈ scriptQPiStar A (lB A) Y (piOf 2), U ≤ S ⊔ T →
      U ∈ scriptQPiStar A (lB A) (S ⊔ T) (piOf 2) := fun U hU hUST =>
    ⟨⟨⟨hU.prop.1.1, hUST⟩, hU.prop.2⟩,
      fun V hV hUV => hU.2 ⟨⟨hV.1.1, hV.1.2.trans hle⟩, hV.2⟩ hUV⟩
  exact (hIH _ hY' (Subgroup.card_lt_of_lt hlt) S (hsub S hS le_sup_left) T
    (hsub T hT le_sup_right)).mono (inf_le_inf_left _ hle)

open Proof1413Res5 in
theorem isConjIn_of_etrans2_point
    (h142 : Item142AllS14) (hbot : Item145BotS14)
    {A L : Subgroup G} {c : G} (hR : Sec15R G A c L) {a : G}
    (ha : Subgroup.zpowers a ∈ omegaA A) {La : Subgroup G} (hLa : La ∈ lA A a)
    (hAa : A = Subgroup.zpowers a ⊔ (A ⊓ La))
    (hcent : ∀ r ∈ xA A, ∀ l ∈ La, ⁅r, l⁆ ∈ inSubgroup (aschbacherSolvableCore 3) La)
    (hET : ETrans2 (↥La ⧸ aschbacherSolvableCore 3 ↥La)
      (((A ⊓ La).subgroupOf La).map (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥La))))
    {Y : Subgroup G} (hAY : A ≤ Subgroup.normalizer (Y : Set G))
    (hYa : Y ≤ Subgroup.centralizer ({a} : Set G))
    {S T : Subgroup G} (hS : S ∈ scriptQPiStar A (lB A) Y (piOf 2))
    (hT : T ∈ scriptQPiStar A (lB A) Y (piOf 2)) (hYST : Y = S ⊔ T) :
    IsConjIn (Subgroup.normalizer (A : Set G) ⊓ Y) S T := by
  have h' : Sec14Std G A a La := Proof1413.sec14Std_at hR.toSec14Std ha hLa
  have hD := h'.toSec13Data
  have := ker142_normal (LB := lB A) hD.isElemAbelian.1 hD.mem_A
  have hXW : xA A ≤ Subgroup.normalizer (A : Set G) :=
    (pPrimeCoreOf_le 3 _).trans (Subgroup.centralizer_le_normalizer _)
  set H := Subgroup.normalizer (Subgroup.zpowers a : Set G) with hH
  obtain ⟨Q₀, hQ₀⟩ := maxInvariantPiSubgroups_nonempty H A (piCompl 3)
  obtain ⟨hQ₀q, hQ₀b⟩ := h142 G A a La h' Q₀ hQ₀
  rcases hQ₀b with ⟨-, hQK, -, -⟩ | ⟨hK, -⟩
  ·
    have hKq : k142 A (lB A) a ∈ scriptQ A (lB A) := by
      rw [← hQK]
      exact hQ₀q.1
    have hCH : Subgroup.centralizer ({a} : Set G) ≤ H :=
      centralizer_singleton_le_normalizer_zpowers a
    have hSY : S ≤ Y := hS.prop.1.2
    have hTY : T ≤ Y := hT.prop.1.2
    have hZY : k142 A (lB A) a ⊓ Y ∈ scriptQ A (lB A) :=
      mem_scriptQ_of_le hKq inf_le_left (le_normalizer_inf hKq.1.2.2 hAY)
    exact (isConjIn_of_le_mem_scriptQ h'.isE27 (hbot G A a La h') hZY inf_le_right hS hT
      (le_inf (le_delta hS.prop.1.1 ((hSY.trans hYa).trans hCH)) hSY)
      (le_inf (le_delta hT.prop.1.1 ((hTY.trans hYa).trans hCH)) hTY)).mono
      (inf_le_inf_right Y hXW)
  · have d : Res5Types.Inner142 A a La := ⟨h', hAa, hK, hcent⟩
    exact d.isConjIn_of_etrans2 (h142 G A a La h') (hbot G A a La h') hET hAY hYa hS hT hYST

open CFSG.RankThree.PartTwo.Sec4.Sporadic.J2 in
theorem isConjIn_of_j2_point
    (h142 : Item142AllS14) (hbot : Item145BotS14) (hJ2 : ETrans2 GJ E0)
    {A L : Subgroup G} {c : G} (hR : Sec15R G A c L) {a : G}
    (ha : Subgroup.zpowers a ∈ omegaA A) {La : Subgroup G} (hLa : La ∈ lA A a)
    (φ : ↥La ⧸ aschbacherSolvableCore 3 ↥La ≃* CFSG.Blueprint.NativeSporadic.J2)
    {Y : Subgroup G} (hY : Y ∈ scriptY A)
    (hIH : ∀ Y' ∈ scriptY A, Nat.card Y' < Nat.card Y →
      TransOn A (lB A) (Subgroup.normalizer (A : Set G)) Y')
    (hYa : Y ≤ Subgroup.centralizer ({a} : Set G))
    {S T : Subgroup G} (hS : S ∈ scriptQPiStar A (lB A) Y (piOf 2))
    (hT : T ∈ scriptQPiStar A (lB A) Y (piOf 2)) :
    IsConjIn (Subgroup.normalizer (A : Set G) ⊓ Y) S T := by
  by_cases hYST : S ⊔ T = Y
  swap
  · exact isConjIn_of_sup_ne hY hIH hS hT hYST
  have h' : Sec14Std G A a La := Proof1413.sec14Std_at hR.toSec14Std ha hLa
  have hD := h'.toSec13Data
  obtain ⟨-, h9, hAa⟩ := j2_point_facts hD ⟨φ⟩
  set θ := aschbacherSolvableCore 3 ↥La with hθ
  set Eb := ((A ⊓ La).subgroupOf La).map (QuotientGroup.mk' θ) with hEb
  have hE9 : Nat.card Eb = 9 := Res5Gen.card_image_inf h' h9
  set ψ : (↥La ⧸ θ) ≃* GJ := φ.trans CFSG.ComponentClassification.J2Cover.nativeEquivP with hψ
  have hGJ : Nonempty (GJ ≃* CFSG.Blueprint.NativeSporadic.J2) :=
    ⟨CFSG.ComponentClassification.J2Cover.nativeEquivP.symm⟩
  have hψE9 : Nat.card (Eb.map ψ.toMonoidHom) = 9 := by
    rw [Subgroup.card_map_of_injective ψ.injective, hE9]
  have hE0 : Nat.card E0 = 9 := by
    rw [card_E0]
    norm_num
  obtain ⟨g, hg⟩ := KFacts.KS14.Native.j2_exists_conjugate_of_card_nine hGJ hψE9 hE0
  set φ' : (↥La ⧸ θ) ≃* GJ := ψ.trans (MulAut.conj g⁻¹) with hφ'
  have hφ'E : Eb.map φ'.toMonoidHom = E0 := by
    rw [hg, conjugate]
    conv_rhs => rw [Subgroup.map_map]
    rfl
  have hcent := Res5Types.cent_of_rigid h' φ' hφ'E fun τ hτ n hn hτn =>
    ks142J2Rigid GJ hGJ E0 hE0 τ hτ n hn hτn
  exact isConjIn_of_etrans2_point h142 hbot hR ha hLa hAa hcent
    (ETrans2.of_mulEquiv φ' hφ'E hJ2) hY.2 hYa hS hT hYST.symm

