theorem heisAct_of_hessian {X : Type} [Group X] [Finite X] {p e : ℕ} [Fact p.Prime]
    (he : 1 ≤ e) (hiso : Sec4.IsoLThreePi X p e) {E : Subgroup X}
    (hEe : CFSG.Assembly.IsElemAbelian 3 E) (hE9 : Nat.card E = 9)
    (htr : ∀ y₀ ∈ E, y₀ ≠ 1 → ∀ y₁ ∈ E, y₁ ≠ 1 →
      ∃ w ∈ Subgroup.normalizer (E : Set X), w * y₀ * w⁻¹ = y₁)
    {P : Subgroup (MulAut X)} (hP : P = E.map (MulAut.conj : X →* MulAut X)) :
    HeisAct148 X P := by
  obtain ⟨π, F, _, hF, hq, τ, hτ, hτ1, dM, cM, hdM, hcM, hdc, -, -, -, Φ, hΦE⟩ :=
    Res8Hess.exists_hessian_equiv he hiso hEe hE9 htr
  have hπ : π = false → UnitaryFieldData p e F := fun h => by subst h; exact hF.unitary
  have hq' : π = false → ModThree false (p ^ e) := fun h => by subst h; exact hq
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    simp at hτ
  refine ⟨π, p, e, F, inferInstance, hF, hq, Φ.symm, diagTau hτ, cycThree, Units.mk0 τ hτ0,
    Sec4.slPi_le_glPi hπ (Sec4.diagTau_mem_slPi hπ hq' hτ),
    Sec4.slPi_le_glPi hπ (Sec4.cycThree_mem_slPi hπ), ?_, ?_, ?_,
    Ronan148W.diagTau_conj_cycThree hτ hτ0, ?_⟩
  · rw [Sec4.diagTau_pow_three hτ]
    exact one_mem _
  · rw [Sec4.cycThree_pow_three]
    exact one_mem _
  · intro h
    apply hτ1
    have := congrArg Units.val h
    simpa using this
  · intro σ hσ
    rw [hP] at hσ
    obtain ⟨x, hx, rfl⟩ := hσ
    rw [← hΦE] at hx
    obtain ⟨m, hm, rfl⟩ := hx
    obtain ⟨i, j, rfl⟩ := Sec4.exists_zpow_mul_of_mem_sup hdc hm
    refine ⟨i, j, fun z => ?_⟩
    have h1 : Φ.symm ((MulAut.conj (Φ.toMonoidHom (dM ^ i * cM ^ j))) z) =
        (dM ^ i * cM ^ j) * Φ.symm z * (dM ^ i * cM ^ j)⁻¹ := by
      change Φ.symm (Φ (dM ^ i * cM ^ j) * z * (Φ (dM ^ i * cM ^ j))⁻¹) = _
      rw [map_mul, map_mul, map_inv, MulEquiv.symm_apply_apply]
    rw [h1, Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_mul,
      Subgroup.coe_zpow, Subgroup.coe_zpow, hdM, hcM, map_mul, map_zpow, map_zpow]

theorem sup_zpowers_comm_exp {F : Type} [Field F] {s y : GL (Fin 3) F}
    (hsy : ((s * y : GL (Fin 3) F) : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F) = y * s)
    (hs3 : s ^ 3 ∈ StatedScalars (Fin 3) F) (hy3 : y ^ 3 ∈ StatedScalars (Fin 3) F) :
    (∀ a ∈ Subgroup.zpowers (s : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F) ⊔
        Subgroup.zpowers (y : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F),
      ∀ b ∈ Subgroup.zpowers (s : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F) ⊔
        Subgroup.zpowers (y : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F), a * b = b * a) ∧
      ∀ a ∈ Subgroup.zpowers (s : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F) ⊔
        Subgroup.zpowers (y : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F), a ^ 3 = 1 := by
  set S : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F := (s : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F)
  set Y : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F := (y : GL (Fin 3) F ⧸ StatedScalars (Fin 3) F)
  have hSY : S * Y = Y * S := by
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
    exact hsy
  have hS3 : S ^ 3 = 1 := by
    rw [← QuotientGroup.mk_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hs3
  have hY3 : Y ^ 3 = 1 := by
    rw [← QuotientGroup.mk_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hy3
  refine ⟨fun a ha b hb => ?_, fun a ha => ?_⟩
  · obtain ⟨i, j, rfl⟩ := Sec4.exists_zpow_mul_of_mem_sup hSY ha
    obtain ⟨k, l, rfl⟩ := Sec4.exists_zpow_mul_of_mem_sup hSY hb
    have c1 : Commute S Y := hSY
    have h1 := (c1.zpow_zpow i l)
    have h2 := (c1.zpow_zpow k j)
    calc S ^ i * Y ^ j * (S ^ k * Y ^ l) = S ^ i * S ^ k * (Y ^ j * Y ^ l) := by
          rw [mul_assoc, ← mul_assoc (Y ^ j), ← h2.eq, mul_assoc, mul_assoc]
      _ = S ^ k * S ^ i * (Y ^ l * Y ^ j) := by
          rw [← zpow_add, ← zpow_add, ← zpow_add, ← zpow_add, add_comm i k, add_comm j l]
      _ = S ^ k * Y ^ l * (S ^ i * Y ^ j) := by
          rw [mul_assoc, ← mul_assoc (S ^ i), h1.eq, mul_assoc, mul_assoc]
  · obtain ⟨i, j, rfl⟩ := Sec4.exists_zpow_mul_of_mem_sup hSY ha
    have c1 : Commute (S ^ i) (Y ^ j) := (Commute.zpow_zpow hSY i j)
    rw [c1.mul_pow, ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, mul_comm i,
      mul_comm j, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast, hS3, hY3, one_zpow, one_zpow,
      one_mul]

theorem heisAct_of_pglModel {X : Type} [Group X] [Finite X] {P : Subgroup (MulAut X)}
    (hM : Ronan148B.PGLModel X P) (hP9 : Nat.card P = 9) : HeisAct148 X P := by
  classical
  obtain ⟨π, p, f, F, _, hF, hq, φ, y, s, hyH, hy3, hs, hsZ, hs3, hysZ, hcorr⟩ := hM
  have hπ : π = false → UnitaryFieldData p f F := fun h => by subst h; exact hF.unitary
  obtain ⟨τ, hτ, hτ1⟩ := Sec4.exists_tau hF hq
  obtain ⟨hyZ, hyc, hirr⟩ := hy3
  have hyc' : y ^ 3 ∈ StatedScalars (Fin 3) F := Sec4.mem_statedScalars_of_mem_zPi hF hq hτ hτ1 hyc
  obtain ⟨c, hc⟩ := hysZ
  have hsc : ∀ (u : Fˣ) (A : GL (Fin 3) F),
      A * GeneralLinearGroup.scalar (Fin 3) u = GeneralLinearGroup.scalar (Fin 3) u * A :=
    fun u A => (CFSG.ClassicalGroups.UnitaryFlag.commute_scalar u A).eq
  have hys : y * s = GeneralLinearGroup.scalar (Fin 3) c * (s * y) := by
    have h1 : y * s * y⁻¹ * s⁻¹ = GeneralLinearGroup.scalar (Fin 3) c := hc.symm
    calc y * s = (y * s * y⁻¹ * s⁻¹) * (s * y) := by group
      _ = GeneralLinearGroup.scalar (Fin 3) c * (s * y) := by rw [h1]
  have hsy : s * y * s⁻¹ = GeneralLinearGroup.scalar (Fin 3) c⁻¹ * y := by
    have h1 : s * y = GeneralLinearGroup.scalar (Fin 3) c⁻¹ * (y * s) := by
      rw [hys, ← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]
    rw [h1]
    group
  refine ⟨π, p, f, F, inferInstance, hF, hq, φ, s, y, c⁻¹, Sec4.slPi_le_glPi hπ hs, hyH, hs3,
    hyc', ?_, hsy, fun σ hσ => ?_⟩
  swap
  · obtain ⟨i, j, hij⟩ := hcorr σ hσ
    refine ⟨i, j, fun z => ?_⟩
    rw [hij z, map_mul, map_zpow, map_zpow]
  intro hc1
  rw [inv_eq_one] at hc1
  subst hc1
  have hcomm : s * y = y * s := by
    rw [hys, map_one, one_mul]
  set Q := GL (Fin 3) F ⧸ StatedScalars (Fin 3) F
  set E : Subgroup Q := Subgroup.zpowers (s : Q) ⊔ Subgroup.zpowers (y : Q) with hE
  obtain ⟨hEc, hE3⟩ := sup_zpowers_comm_exp (s := s) (y := y)
    (by rw [hcomm, QuotientGroup.mk_mul]) hs3 hyc'
  have hmemE : ∀ w : GL (Fin 3) F, (w : Q) ∈ E → ∃ (i j : ℤ) (u : Fˣ),
      w = GeneralLinearGroup.scalar (Fin 3) u * (s ^ i * y ^ j) := by
    intro w hw
    have hSY : (s : Q) * (y : Q) = (y : Q) * (s : Q) := by
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, hcomm]
    obtain ⟨i, j, hij⟩ := Sec4.exists_zpow_mul_of_mem_sup hSY hw
    rw [← QuotientGroup.mk_zpow, ← QuotientGroup.mk_zpow, ← QuotientGroup.mk_mul,
      QuotientGroup.eq] at hij
    obtain ⟨u, hu⟩ := hij
    refine ⟨i, j, u⁻¹, ?_⟩
    have hu' : (s ^ i * y ^ j) = w * GeneralLinearGroup.scalar (Fin 3) u := by
      rw [hu]
      group
    rw [hu', ← hsc, mul_assoc, ← map_mul, mul_inv_cancel, map_one, mul_one]
  have hnoheis : ∀ y₁ y₂ : GL (Fin 3) F, (y₁ : Q) ∈ E → (y₂ : Q) ∈ E → ∀ ζ : Fˣ, ζ ≠ 1 →
      y₁ * y₂ * y₁⁻¹ ≠ GeneralLinearGroup.scalar (Fin 3) ζ * y₂ := by
    intro y₁ y₂ h₁ h₂ ζ hζ1 hζ
    obtain ⟨i, j, u, rfl⟩ := hmemE y₁ h₁
    obtain ⟨k, l, v, rfl⟩ := hmemE y₂ h₂
    have hc' : Commute s y := hcomm
    have hC : ∀ (w : Fˣ) (A : GL (Fin 3) F), Commute (GeneralLinearGroup.scalar (Fin 3) w) A :=
      fun w A => (CFSG.ClassicalGroups.UnitaryFlag.commute_scalar w A).symm
    have h1 : Commute (s ^ i * y ^ j) (s ^ k * y ^ l) := by
      refine Commute.mul_left ?_ ?_
      · exact Commute.mul_right (Commute.zpow_zpow_self s i k) (hc'.zpow_zpow i l)
      · exact Commute.mul_right (hc'.symm.zpow_zpow j k) (Commute.zpow_zpow_self y j l)
    have hcom : (GeneralLinearGroup.scalar (Fin 3) u * (s ^ i * y ^ j)) *
        (GeneralLinearGroup.scalar (Fin 3) v * (s ^ k * y ^ l)) =
        (GeneralLinearGroup.scalar (Fin 3) v * (s ^ k * y ^ l)) *
        (GeneralLinearGroup.scalar (Fin 3) u * (s ^ i * y ^ j)) :=
      (Commute.mul_left (hC u _) (Commute.mul_right (hC v _).symm h1)).eq
    apply hζ1
    rw [hcom, mul_inv_cancel_right] at hζ
    have h1 : GeneralLinearGroup.scalar (Fin 3) ζ = 1 := by
      have := congrArg (fun w => w * (GeneralLinearGroup.scalar (Fin 3) v * (s ^ k * y ^ l))⁻¹)
        hζ
      simpa using this.symm
    have h2 := congrArg (fun w : GL (Fin 3) F => (w : Matrix (Fin 3) (Fin 3) F) 0 0) h1
    simp [GeneralLinearGroup.coe_scalar] at h2
    exact h2
  have := hF.finite
  have : Finite Q := inferInstance
  have hcard : 3 < Nat.card E := by
    have hmk : ∀ w : GL (Fin 3) F, ((w : Q) = 1) ↔ ProjGenLinGroup.mk w = 1 := by
      intro w
      rw [QuotientGroup.eq_one_iff, Sec4.mk_eq_one_iff_mem_statedScalars]
    choose i₀ j₀ hij using hcorr
    let g : P → E := fun σ => ⟨((s ^ i₀ σ σ.2 * y ^ j₀ σ σ.2 : GL (Fin 3) F) : Q),
      by
        rw [QuotientGroup.mk_mul, QuotientGroup.mk_zpow, QuotientGroup.mk_zpow]
        exact mul_mem (Subgroup.zpow_mem _ (Subgroup.mem_sup_left (Subgroup.mem_zpowers _)) _)
          (Subgroup.zpow_mem _ (Subgroup.mem_sup_right (Subgroup.mem_zpowers _)) _)⟩
    have hg : Function.Injective g := by
      intro σ₁ σ₂ h12
      have h1 := congrArg Subtype.val h12
      simp only [g] at h1
      have h2 : ProjGenLinGroup.mk (s ^ i₀ σ₁ σ₁.2 * y ^ j₀ σ₁ σ₁.2) =
          ProjGenLinGroup.mk (s ^ i₀ σ₂ σ₂.2 * y ^ j₀ σ₂ σ₂.2) := by
        have h3 : (((s ^ i₀ σ₁ σ₁.2 * y ^ j₀ σ₁ σ₁.2)⁻¹ * (s ^ i₀ σ₂ σ₂.2 * y ^ j₀ σ₂ σ₂.2) :
            GL (Fin 3) F) : Q) = 1 := by
          rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, h1, inv_mul_cancel]
        have h4 := (hmk _).mp h3
        rw [map_mul, map_inv, inv_mul_eq_one] at h4
        exact h4
      have h2' : ProjGenLinGroup.mk s ^ i₀ σ₁ σ₁.2 * ProjGenLinGroup.mk y ^ j₀ σ₁ σ₁.2 =
          ProjGenLinGroup.mk s ^ i₀ σ₂ σ₂.2 * ProjGenLinGroup.mk y ^ j₀ σ₂ σ₂.2 := by
        rw [← map_zpow, ← map_zpow, ← map_mul, ← map_zpow, ← map_zpow, ← map_mul]
        exact h2
      apply Subtype.ext
      ext z
      apply φ.injective
      apply Subtype.ext
      rw [hij σ₁ σ₁.2 z, hij σ₂ σ₂.2 z, h2']
    have := Nat.card_le_card_of_injective g hg
    omega
  rcases Sec4.frame_or_heis (hF.three_ne_zero hq) hτ hτ1 E hEc hE3 hcard with
      ⟨b, hb, hd, -⟩ | ⟨y₁, y₂, hy₁, hy₂, ζ, hζ1, hζ⟩
  · obtain ⟨c₀, hc₀⟩ := hd y (Subgroup.mem_sup_right (Subgroup.mem_zpowers _)) 0
    have hb0 : b 0 ≠ 0 := hb.ne_zero 0
