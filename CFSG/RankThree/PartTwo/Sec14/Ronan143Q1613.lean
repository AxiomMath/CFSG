variable {G : Type} [Group G] [Finite G]

theorem false_of_pglQ (h1611 : Step1611) (h1612 : Step1612) (h131 : Item131) (h133 : Item133)
    (h138 : Item138N) (h143 : Ronan148Q.Item143QS14) (h1510 : Item1510R) (hBr : Step169TwoBridge)
    (hset : Item13SetupAt) (h41 : Sec4.Item4_1LargePrime) (h163 : Item163R)
    (hMeets : Step163Meets) (h1514 : Item1514R) (h1411 : Item1411_1R)
    {A L : Subgroup G} {c : G} (h : Ctx169 G A c L) (hPGL : Sec8.IsZ3PGLThreePi ↥(lBarA c L A)) :
    False := by
  obtain ⟨hodd, hoddB⟩ := thetaCen_odd_of_pglQ h1611 h1612 h131 h133 h138 h143 h1510 hBr hset h41
    h163 hMeets h1514 h hPGL
  set B := Subgroup.zpowers c ⊔ (A ⊓ L) with hB
  have hBA : B ≤ A := sup_le (Subgroup.zpowers_le.mpr h.mem_A) inf_le_left
  have hA27 : Nat.card A = 27 := h.card_eq
  have hcL : c ∉ L := h.toSec15R.hypS.2.2 c h.zpowers_mem_omegaA L h.mem_lA
  have hB9 : 9 ≤ Nat.card B := by
    have hne : A ⊓ L ≠ ⊥ := by
      intro hbot
      have h3 := Proof1614Trans.card_inf_eq_three_of_pgl h.toSec13Data hPGL
      rw [hbot, Subgroup.card_bot] at h3
      norm_num at h3
    obtain ⟨⟨x, hx⟩, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
    have hx1' : x ≠ 1 := fun h1 => hx1 (Subtype.ext h1)
    have hxc : x ∉ Subgroup.zpowers c := by
      intro hxc
      have heq := Sec16.Proof169.zpowers_eq_of_mem_of_ne_one h.card_zpowers hxc hx1'
      apply hcL
      have hcx : c ∈ Subgroup.zpowers x := heq ▸ Subgroup.mem_zpowers c
      exact (Subgroup.zpowers_le.mpr (Subgroup.mem_inf.mp hx).2) hcx
    refine Sec16.Proof169.nine_le_card_of_lt hBA hA27 h.card_zpowers
      (lt_of_le_of_ne le_sup_left fun heq => hxc ?_)
    rw [heq]
    exact (le_sup_right : A ⊓ L ≤ B) hx
  obtain ⟨S, hS⟩ := exists_mem_scriptQPiStar_top A
  have hBS : B ≤ Subgroup.normalizer (S : Set G) := hBA.trans hS.prop.1.1.1.2.2
  have hS3 : ¬ 3 ∣ Nat.card S :=
    (isPiSubgroup_piCompl_iff Nat.prime_three S).mp hS.prop.1.1.1.2.1
  have hBe : CFSG.Assembly.IsElemAbelian 3 B := Sec16.Proof169.isElemAbelian_of_le h.isElemAbelian
    hBA
  by_cases hSc : ⁅S, Subgroup.zpowers c⁆ = ⊥
  ·
    rcases step1616Fix_of_steps h1612 h131 h138 G A c L h hPGL S hS hSc with hSA | hev
    · obtain ⟨E, hEA, hE9, hEev⟩ :=
        exists_card_nine_not_odd h.toSec13Data (step1616Comm_of h1411 G A c L h S hS hSA)
      obtain ⟨⟨e, he⟩, he1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp
        (inf_ne_bot_of_nine_le hBA hEA hA27 hB9 hE9.ge)
      have he1' : e ≠ 1 := fun h1 => he1 (Subtype.ext h1)
      exact hEev ((hodd e (Subgroup.mem_inf.mp he).1 he1').of_dvd_nat
        (Subgroup.card_dvd_of_le (thetaT_le_thetaCen (Subgroup.mem_inf.mp he).2 he1')))
    · exact hev hoddB
  ·
    obtain ⟨b, hbB, hb1, hbT⟩ : ∃ b ∈ B, b ≠ 1 ∧
        ⁅S ⊓ Subgroup.centralizer ({b} : Set G), Subgroup.zpowers c⁆ ≠ ⊥ := by
      by_contra hall
      push Not at hall
      apply hSc
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      exact le_centralizer_of_forall_ne_one hBe hB9 hBS hS3 fun b hb hb1 =>
        Subgroup.commutator_eq_bot_iff_le_centralizer.mp (hall b hb hb1)
    have hΩb := mem_omegaA_of_thetaCen_oddQ h1611 h143 (step1616OmegaSolv_of h1612 kSL3PiNoSz_holds)
      Res3Omega.ks1616SzOdd h hPGL hoddB hS hbB hb1 (hodd b hbB hb1) hbT
    obtain ⟨K, hK⟩ := hset G h.toPartTwoStanding h.partTwoS_eq A h.mem_partTwoF
      h.not_mem_partTwoT b hΩb
    have hbK : Ctx169 G A b K := ctx169_of_point h hΩb hK
    exact false_of_point h131 h138 h1611 hbK h.mem_A (mem_sup_of_point h131 h1611 h hbK hPGL hbB)
      (hodd b hbB hb1) hS hbT

end

