theorem step1613OutQ_ofQ (h1611 : Step1611) :
    ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G) (c : G) (L : Subgroup G),
      Ctx169 G A c L → Concl1611 A c L → Ronan148Q.Item143Q A (Sec14.lB A) →
        ∀ D : Subgroup G, D ≤ A ⊓ L → Nat.card D = 3 →
          ∀ e ∈ D ⊔ Subgroup.zpowers c, e ∉ D → Subgroup.zpowers e ∉ omegaA A →
            ∀ T ∈ invariantPiSubgroups (Subgroup.centralizer ({e} : Set G)) A (piOf 2),
              T ∈ scriptQ A (Sec14.lB A) → T = ⁅T, D⁆ →
                T ≤ pPrimeCoreOf 3 (Subgroup.centralizer ({e} : Set G)) := by
  intro G _ _ A c L h _ h143 D hDAL hD3 e heB heD heΩ T hT hTQ hTD
  have hDA : D ≤ A := hDAL.trans inf_le_left
  have heA : e ∈ A := (sup_le hDA (Subgroup.zpowers_le.mpr h.mem_A)) heB
  have he1 : e ≠ 1 := fun h1 => heD (h1 ▸ D.one_mem)
  exact le_pPrimeCoreOf_of_mem_scriptQ_outQ h1611 h h143 heA he1 heΩ hDA hTQ hT.1 hTD

end

