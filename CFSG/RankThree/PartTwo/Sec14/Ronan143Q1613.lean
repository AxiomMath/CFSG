  obtain ⟨-, -, hF138⟩ := h138 G A c L h.toSec13Data hL3 E hcE hEe hE27 hEN hEsec (Or.inr hTE)
    hEC
  obtain ⟨-, hΩF⟩ := hF138 F hFEL hFe hF27 hFL9 hfus hFNE
  obtain ⟨hΩFeq, hΩF9⟩ := hΩF (Or.inr hTF)
  have hcL : c ∉ L := h.toSec15R.hypS.2.2 c h.zpowers_mem_omegaA L h.mem_lA
  have hFhyp : IsHyperplane F (F ⊓ L) := by
    refine ⟨inf_le_left, ?_⟩
    rw [hF27, hFL9]
  have hFcL : F ≤ Subgroup.zpowers c ⊔ L :=
    (le_zpowers_sup_of_not_mem hFhyp hcF fun hc => hcL hc.2).trans
      (sup_le_sup_left inf_le_right _)
  have hFE : partTwoF G = partTwoE G :=
    (h.toTheoremFourHyp.partTwoF_eq_partTwoE h.partTwoS_eq).1
  have hRF : Sec15R G F c L :=
    sec15R_of_le h.toSec15R hset (hFE ▸ hF𝓔) hFcL hΩFeq hcL
  have hY0F : scriptY0 F (Sec14.lB F) = ∅ := by
    by_contra hne0
    obtain ⟨Y, hY⟩ := Set.nonempty_iff_ne_empty.mpr hne0
    obtain ⟨Y₀, -, hY₀⟩ := Finite.exists_le_maximal (p := (· ∈ scriptY0 F (Sec14.lB F))) hY
    have hLY : L ≤ Y₀ := (h163 G F c L hRF Y₀ hY₀).2.2.2.1
    have hmeet := hMeets G F c L hRF Y₀ hY₀ hLY
    rcases h1514 G F c L hRF Y₀ hY₀ hmeet with ⟨-, -, hΩ, -⟩ | ⟨-, -, hT, -⟩ |
        ⟨-, -, -, hΩ, -⟩
    · rw [hΩ, Set.ncard_singleton] at hΩF9
      omega
    · rw [hT.1] at hΩF9
      omega
    · rw [hΩ, Set.ncard_singleton] at hΩF9
      omega
  have hF : Ctx169 G F c L := ⟨hRF, hY0F⟩
  obtain ⟨n, hn⟩ : ∃ n : ℕ, IsZ3LThreeTwo F c L n := by
    rcases h1611 G F c L hF with hP | hn
    · have h3 := Proof1614Trans.card_inf_eq_three_of_pgl hF.toSec13Data hP
      rw [hFL9] at h3
      omega
    · exact hn
  have hWF := normalizer_le_of_isZ3LThreeTwoQ' h1611 h1612 h133 h138 h143 h1510 hBr hset h131
    h41 hF hn
  have hsub : omegaA F ⊆ {Subgroup.zpowers c} := by
    intro X hX
    rw [hΩFeq] at hX
    obtain ⟨w, hw, rfl⟩ := hX
    exact Sec13.map_conj_eq_of_mem_normalizer (hWF hw)
  have hle := Set.ncard_le_ncard hsub (Set.toFinite _)
  rw [Set.ncard_singleton, hΩF9] at hle
