theorem not_odd_of_commutator_ne_botQ (h1611 : Step1611) (hset : Item13SetupAt)
    (hInv : KS1613Inv) (hFix : KS1613Fix) {A L : Subgroup G} {c : G} (h : Ctx169 G A c L)
    (h143 : Ronan148Q.Item143Q A (Sec14.lB A)) {d : G} (hDAL : Subgroup.zpowers d ≤ A ⊓ L)
    (hD3 : Nat.card (Subgroup.zpowers d) = 3) {x : G}
    (hx : x ∈ Subgroup.normalizer
        ((Subgroup.zpowers d ⊔ Subgroup.zpowers c : Subgroup G) : Set G) ⊓
      Subgroup.normalizer (Subgroup.zpowers d : Set G))
    (hxH : x ∉ Subgroup.normalizer (Subgroup.zpowers c : Set G))
    {S' : Subgroup G} (hS' : S' ∈ scriptQPiStar A (Sec14.lB A) ⊤ (piOf 2))
    (hSD : ⁅S', Subgroup.zpowers d⁆ ≠ ⊥) :
    ¬ Odd (Nat.card (pPrimeCoreOf 3 (Subgroup.centralizer ({c} : Set G)))) := by
  have hcL : c ∉ L := h.toSec15R.hypS.2.2 c h.zpowers_mem_omegaA L h.mem_lA
  have hdA : d ∈ A := (hDAL (Subgroup.mem_zpowers d)).1
  have hdL : d ∈ L := (hDAL (Subgroup.mem_zpowers d)).2
  have hcA : c ∈ A := h.mem_A
  have hc3 : c ^ 3 = 1 := h.isElemAbelian.2 c hcA
  have hd3 : d ^ 3 = 1 := h.isElemAbelian.2 d hdA
  have hcd : c * d = d * c := h.commute hcA hdA
  have hcD : c ∉ Subgroup.zpowers d := fun hc => hcL ((Subgroup.zpowers_le.mpr hdL) hc)
  set B := Subgroup.zpowers d ⊔ Subgroup.zpowers c with hB
  have hBA : B ≤ A := sup_le (Subgroup.zpowers_le.mpr hdA) (Subgroup.zpowers_le.mpr hcA)
  have hcB : c ∈ B := (le_sup_right : Subgroup.zpowers c ≤ B) (Subgroup.mem_zpowers c)
  have hB9 : 9 ≤ Nat.card B := Sec16.Proof169.nine_le_card_of_lt hBA h.card_eq hD3
    (lt_of_le_of_ne le_sup_left fun heq => hcD (heq ▸ hcB))
  have h11 : Concl1611 A c L := h1611 G A c L h
  obtain ⟨t, htL, ht⟩ := hInv G A c L h h11 (Subgroup.zpowers d) hDAL hD3
  have htd : t * d * t⁻¹ = d⁻¹ := ht d (Subgroup.mem_zpowers d)
  have htc : t * c * t⁻¹ = c := by
    rw [Subgroup.mem_centralizer_singleton_iff.mp (h.le_centralizer htL), mul_inv_cancel_right]
  have hS2 : IsPGroup 2 S' := (isPiSubgroup_piOf_iff Nat.prime_two S').mp hS'.prop.2
  have hAS : A ≤ Subgroup.normalizer (S' : Set G) := hS'.prop.1.1.1.2.2
  have hSQ : S' ∈ scriptQ A (Sec14.lB A) := hS'.prop.1.1
  have hSD' : ¬ S' ≤ Subgroup.centralizer ((Subgroup.zpowers d : Subgroup G) : Set G) :=
    fun hle => hSD (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hle)
  obtain ⟨b, hbB, hb1, hT, hTD, hT1, hTS⟩ := exists_commutator_ne_bot_of_le h.isElemAbelian
    hBA hB9 le_sup_left hS2 hAS hSD'
  set T := ⁅S' ⊓ Subgroup.centralizer ({b} : Set G), Subgroup.zpowers d⁆ with hTdef
  have hTQ : T ∈ scriptQ A (Sec14.lB A) := mem_scriptQ_of_le hSQ hTS hT.2.2
  have hT2 : IsPGroup 2 T := (isPiSubgroup_piOf_iff Nat.prime_two T).mp hT.2.1
  have hbD : b ∉ Subgroup.zpowers d := by
    intro hbd
    apply hT1
    have hzb := Sec16.Proof169.zpowers_eq_of_mem_of_ne_one hD3 hbd hb1
    have hTC : T ≤ Subgroup.centralizer ((Subgroup.zpowers d : Subgroup G) : Set G) :=
      hT.1.trans (centralizer_le_of_zpowers_eq hzb)
    exact hTD.trans (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hTC)
  obtain ⟨u, huU, hbu⟩ := exists_conj_eq_zpowers hcd hc3 hd3 hcD hx hxH htc htd hbB hbD
  have hevb : ¬ Odd (Nat.card (pPrimeCoreOf 3 (Subgroup.centralizer ({b} : Set G)))) := by
    by_cases hbΩ : Subgroup.zpowers b ∈ omegaA A
    · obtain ⟨K, hK⟩ := hset G h.toPartTwoStanding h.partTwoS_eq A h.mem_partTwoF
        h.not_mem_partTwoT b hbΩ
      have hbK : Ctx169 G A b K := ctx169_of_point h hbΩ hK
      have hLu : L.map (MulAut.conj u).toMonoidHom = K := by
        refine (hbK.chosen136.2 b hbΩ K hK).2 _ ?_ ?_
        · have h1 := map_mem_thetaComponentsAt (MulAut.conj u) h.mem_thetaComponentsAt
          rw
          [thetaComponentsAt_eq_thetaComponentsIn, Sec13.centralizer_singleton_eq_of_zpowers_eq hbu]
          exact h1
        · rw [Subgroup.card_map_of_injective (MulAut.conj u).injective]
          exact Sec16.Proof1613.three_dvd_card_L h.toSec14Std
      have hDK : Subgroup.zpowers d ≤ A ⊓ K := by
        refine le_inf (Subgroup.zpowers_le.mpr hdA) ?_
        rw [← hLu, Subgroup.zpowers_le]
        have huD := (Subgroup.mem_inf.mp huU).2
        have hd' : u⁻¹ * d * u⁻¹⁻¹ ∈ Subgroup.zpowers d :=
          (Subgroup.mem_normalizer_iff.mp (inv_mem huD) d).mp (Subgroup.mem_zpowers d)
        refine ⟨u⁻¹ * d * u⁻¹⁻¹, (hDAL hd').2, ?_⟩
        change u * (u⁻¹ * d * u⁻¹⁻¹) * u⁻¹ = d
        group
      have hTK : T ≤ K := by
        rw [hTD, Subgroup.commutator_le]
        intro t' ht' d' hd'
        have hNK : t' ∈ Subgroup.normalizer (K : Set G) :=
          Sec16.Proof1613.centralizer_le_normalizer_L hbK.toSec14Std (hT.1 (hTD ▸ ht'))
        have hd'K : d' ∈ K := (hDK hd').2
        rw [commutatorElement_def]
        exact K.mul_mem ((Subgroup.mem_normalizer_iff.mp hNK d').mp hd'K) (K.inv_mem hd'K)
      have hθ := hFix G A b K hbK (h1611 G A b K hbK) (Subgroup.zpowers d) hDK hD3 T
        ⟨hTK, hT.2.1, hT.2.2⟩
      have hTO : T ≤ pPrimeCoreOf 3 (Subgroup.centralizer ({b} : Set G)) :=
        ((hTD ▸ hθ : T ≤ inSubgroup (aschbacherSolvableCore 3) K).trans
          (Sec21.theta_le_theta_centralizer hbK.mem_thetaComponentsAt)).trans
          (thetaCen_le_pPrimeCoreOf b)
      exact not_odd_of_le hTO hT2 hT1
    · exact not_odd_of_le (step1613OutQ_ofQ h1611 G A c L h h11 h143 (Subgroup.zpowers d) hDAL
        hD3 b hbB hbD hbΩ T hT hTQ hTD) hT2 hT1
  rwa [card_pPrimeCoreOf_centralizer_eq hbu] at hevb

end

