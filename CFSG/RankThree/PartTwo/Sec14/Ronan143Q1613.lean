theorem step1613OutEven_of_allQ (h1611 : Step1611) (hset : Item13SetupAt) (hInv : KS1613Inv)
    (hFix : KS1613Fix) (hAll : Step1613OutEvenAllQ) : Step1613OutEvenQ := by
  intro G _ _ A c L h h11 h143 D hDAL hD3 hU S hS hSD e heB heD heΩ hT1 hTQ
  by_cases hall : ∀ S' ∈ scriptQPiStar A (Sec14.lB A) ⊤ (piOf 2), ⁅S', D⁆ = ⊥
  · exact hAll G A c L h h11 h143 D hDAL hD3 hU hall S hS e heB heD heΩ hT1 hTQ
