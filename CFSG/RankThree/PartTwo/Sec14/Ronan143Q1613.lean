theorem le_pPrimeCoreOf_of_mem_scriptQ_outQ (h1611 : Step1611) {G : Type} [Group G] [Finite G]
    {A L : Subgroup G} {c : G} (h : Ctx169 G A c L) (h143 : Ronan148Q.Item143Q A (Sec14.lB A))
    {e : G}
    (heA : e ∈ A) (he1 : e ≠ 1) (heΩ : Subgroup.zpowers e ∉ omegaA A) {D T : Subgroup G}
    (hDA : D ≤ A) (hTQ : T ∈ scriptQ A (Sec14.lB A)) (hTe : T ≤ Subgroup.centralizer ({e} : Set G))
    (hTD : T = ⁅T, D⁆) : T ≤ pPrimeCoreOf 3 (Subgroup.centralizer ({e} : Set G)) := by
  have hTΔ : T ≤ Sec14.delta A (Sec14.lB A) (Subgroup.centralizer ({e} : Set G)) := le_delta hTQ hTe
  obtain ⟨Q, hQ⟩ := maxInvariantPiSubgroups_nonempty
    (Sec14.delta A (Sec14.lB A) (Subgroup.centralizer ({e} : Set G))) A (piCompl 3)
  rcases (h143 e heA he1 heΩ Q hQ).2 with hΔ | ⟨b, -, Lb, hbΩ, hLb, ⟨φ⟩, -⟩
  · rw [hTD]
    refine (Subgroup.commutator_mono hTΔ le_rfl).trans ?_
    rw [hΔ]
    exact Sec16.Proof1613Res.commutator_sup_le_pPrimeCoreOf h.isElemAbelian heA hDA
  · exfalso
    have hb : Ctx169 G A b Lb := ctx169_of_point h hbΩ hLb
    rcases h1611 G A b Lb hb with hPGL | ⟨n, -, hiso, -⟩
    · obtain ⟨hL3, -, -⟩ := Sec13.facts_of_isZ3PGLThreePi hb.toSec13Data hPGL
      obtain ⟨p, f, hp, -, hisoL⟩ := hL3
      exact KFacts.KS14.ks17J2NotList.1 p f (Sec16.Proof169.isoLThreePi_of_mulEquiv φ hisoL)
    · have hJ := KFacts.KS14.ks17J2NotList.1 2 n
      rcases hiso with ⟨h1, ⟨ψ⟩⟩ | ⟨h1, ⟨ψ⟩⟩
      · exact hJ (Or.inl ⟨h1, ⟨φ.symm.trans ψ⟩⟩)
      · exact hJ (Or.inr ⟨h1, ⟨φ.symm.trans ψ⟩⟩)

end

