theorem exists_ne_one_mem_inf (hA : Late.IsE27 A) {E F : Subgroup G} (hE : IsHyperplane A E)
    (hF : IsHyperplane A F) : ∃ b ∈ E, b ∈ F ∧ b ≠ 1 := by
  have h9 : ∀ {H : Subgroup G}, IsHyperplane A H → Nat.card H = 9 := fun {H} hH => by
    have h := hH.2
    rw [hA.2] at h
    omega
  have hi : ∀ {H : Subgroup G}, IsHyperplane A H → H.relIndex A = 3 := fun {H} hH => by
    have h := Subgroup.relIndex_mul_card H A
    rw [inf_eq_left.mpr hH.1, h9 hH, hA.2] at h
    omega
  by_contra hno
  push Not at hno
  have hbot : E ⊓ F = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    exact Subgroup.mem_bot.mpr (hno x (Subgroup.mem_inf.mp hx).1 (Subgroup.mem_inf.mp hx).2)
  have hle : (E ⊓ F).relIndex A ≤ E.relIndex A * F.relIndex A := Subgroup.relIndex_inf_le
  have h2 := Subgroup.relIndex_mul_card (E ⊓ F) A
  rw [hbot, bot_inf_eq, Subgroup.card_bot, mul_one, hA.2] at h2
  rw [hbot, h2, hi hE, hi hF] at hle
  omega

theorem mem_normalizer_of_map_conj_le {g : G} {H : Subgroup G}
    (h : H.map (MulAut.conj g).toMonoidHom ≤ H) : g ∈ Subgroup.normalizer (H : Set G) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  exact Subgroup.eq_of_le_of_card_ge h
    (by rw [Subgroup.card_map_of_injective (MulAut.conj g).injective])

theorem conj_mem_delta_of_mem_deltaZero (hA : Late.IsE27 A) (h444 : Item1444 A LB)
    {Y : Subgroup G} (hY : A ≤ Subgroup.normalizer (Y : Set G)) {E : Subgroup G}
    (hE : IsHyperplane A E) {g : G} (hgK : g ∈ pPrimeCoreOf 3 Y)
    (hgE : g ∈ Subgroup.centralizer (E : Set G)) {x : G} (hx : x ∈ deltaZero A LB Y) :
    g * x * g⁻¹ ∈ delta A LB Y := by
  have hle : deltaZero A LB Y ≤ (delta A LB Y).comap (MulAut.conj g).toMonoidHom := by
    rw [deltaZero_eq_iSup hA Y]
    refine iSup₂_le fun F hF => sSup_le fun Q hQ q hq => ?_
    obtain ⟨b, hbE, hbF, hb1⟩ := exists_ne_one_mem_inf hA hE hF
    have hQb : Q ≤ Subgroup.centralizer ({b} : Set G) :=
      (hQ.2.trans inf_le_right).trans
        (Subgroup.centralizer_le (Set.singleton_subset_iff.mpr hbF))
    have hQY : Q ≤ Y := hQ.2.trans inf_le_left
    have hgb : g ∈ pPrimeCoreOf 3 Y ⊓ Subgroup.centralizer ({b} : Set G) :=
      Subgroup.mem_inf.mpr ⟨hgK, Subgroup.centralizer_le (Set.singleton_subset_iff.mpr hbE) hgE⟩
    have hc := commutator_inf_centralizer_le_delta h444 hA.1.1 hY (hE.1 hbE) hb1 ⟨hQ.1, hQb⟩ hQY
      (Subgroup.commutator_mem_commutator (inv_mem hq) hgb)
    have hqΔ : q ∈ delta A LB Y := le_delta hQ.1.1 hQY hq
    have e : g * q * g⁻¹ = q * ⁅q⁻¹, g⁆ := by
      rw [commutatorElement_def]
      group
    rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, e]
    exact mul_mem hqΔ (delta_mono (pPrimeCoreOf_le 3 Y) hc)
  have h := hle hx
  rwa [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h

theorem mem_deltaZero_of_pow_eq_one (hA : Late.IsE27 A) (hnat : IsNaturalFamily A LB)
    (hbot : ∃ B, IsHyperplane A B ∧ LB B = ⊥) {Y : Subgroup G}
    (hY : A ≤ Subgroup.normalizer (Y : Set G)) {x : G} (hx : x ∈ delta A LB Y) {k : ℕ}
    (hk : x ^ 3 ^ k = 1) : x ∈ deltaZero A LB Y := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hdelta, -, hnorm⟩ := rank3II_14_5 hA hnat hbot hY
  have hC'N : pPrimeCoreOf 3 (Subgroup.centralizer (A : Set G)) ⊓ Y ≤
      Subgroup.normalizer (deltaZero A LB Y : Set G) :=
    (le_sup_right.trans hdelta.symm.le).trans hnorm
  have hcop : Nat.Coprime 3
      (Nat.card (pPrimeCoreOf 3 (Subgroup.centralizer (A : Set G)) ⊓ Y : Subgroup G)) :=
    Nat.Coprime.coprime_dvd_right (Subgroup.card_dvd_of_le inf_le_left)
      (coprime_card_pPrimeCoreOf 3 _)
  exact mem_left_of_pow_prime_pow Nat.prime_three hC'N hcop (hdelta ▸ hx) hk

theorem pPrimeCoreOf_le_normalizer_oPrimeResidualOf (hA : Late.IsE27 A)
    (hnat : IsNaturalFamily A LB) (hbot : ∃ B, IsHyperplane A B ∧ LB B = ⊥)
    (h444 : Item1444 A LB) {Y : Subgroup G} (hY : A ≤ Subgroup.normalizer (Y : Set G)) :
    pPrimeCoreOf 3 Y ≤ Subgroup.normalizer (oPrimeResidualOf 3 (deltaZero A LB Y) : Set G) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine Sec5.le_of_forall_inf_centralizer_sub_le (k := 2) Nat.prime_three hA.1
    (by rw [hA.2]; norm_num) (hY.trans (normalizer_le_normalizer_pPrimeCoreOf 3 Y))
    (coprime_card_pPrimeCoreOf 3 Y) fun E hEA hE9 => ?_
  have hE : IsHyperplane A E := ⟨hEA, by rw [hA.2, hE9]; norm_num⟩
  intro g hg
  refine mem_normalizer_of_map_conj_le ?_
  rw [oPrimeResidualOf_eq_closure, MonoidHom.map_closure, Subgroup.closure_le]
  rintro _ ⟨x, ⟨hx, k, hk⟩, rfl⟩
  rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
  have hpow : (g * x * g⁻¹) ^ 3 ^ k = 1 := by
    rw [conj_pow, hk, mul_one, mul_inv_cancel]
  exact Subgroup.subset_closure ⟨mem_deltaZero_of_pow_eq_one hA hnat hbot hY
    (conj_mem_delta_of_mem_deltaZero hA h444 hY hE (Subgroup.mem_inf.mp hg).1
      (Subgroup.mem_inf.mp hg).2 hx) hpow, k, hpow⟩

theorem pCoreOf_le_normalizer_inSubgroup_oResidual (hA : Late.IsE27 A)
    (hnat : IsNaturalFamily A LB) (hbot : ∃ B, IsHyperplane A B ∧ LB B = ⊥)
    (h444 : Item1444 A LB) {Y : Subgroup G} (hY : A ≤ Subgroup.normalizer (Y : Set G)) :
    CFSG.Open.pCoreOf 2 Y ≤
      Subgroup.normalizer (inSubgroup (oResidual 2) (deltaZero A LB Y) : Set G) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hPY : CFSG.Open.pCoreOf 2 Y ≤ Y := Subgroup.map_subtype_le _
  have hYP : Y ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 Y : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 Y
  have hP2 : IsPGroup 2 (CFSG.Open.pCoreOf 2 Y) := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 Y
  have hcopP : Nat.Coprime 3 (Nat.card (CFSG.Open.pCoreOf 2 Y)) := by
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hP2
    rw [hn]
    exact Nat.Coprime.pow_right n (by norm_num)
  have hPR : CFSG.Open.pCoreOf 2 Y ≤ pPrimeCoreOf 3 Y :=
    le_pPrimeCoreOf hPY hYP hcopP
  obtain ⟨-, -, hnorm⟩ := rank3II_14_5 hA hnat hbot hY
  have hMN : CFSG.Open.pCoreOf 2 Y ⊓ delta A LB Y ≤
      Subgroup.normalizer (deltaZero A LB Y : Set G) := inf_le_right.trans hnorm
  have hM2 : IsPGroup 2 (CFSG.Open.pCoreOf 2 Y ⊓ delta A LB Y : Subgroup G) :=
    hP2.to_le inf_le_left
  refine Sec5.le_of_forall_inf_centralizer_sub_le (k := 2) Nat.prime_three hA.1
    (by rw [hA.2]; norm_num)
    (hY.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 Y)) hcopP
    fun E hEA hE9 => ?_
  have hE : IsHyperplane A E := ⟨hEA, by rw [hA.2, hE9]; norm_num⟩
  intro g hg
  have hgP : g ∈ CFSG.Open.pCoreOf 2 Y := (Subgroup.mem_inf.mp hg).1
  have hgE : g ∈ Subgroup.centralizer (E : Set G) := (Subgroup.mem_inf.mp hg).2
  refine mem_normalizer_of_map_conj_le ?_
  rw [inSubgroup_oResidual_eq_closure, MonoidHom.map_closure, Subgroup.closure_le]
  rintro _ ⟨x, ⟨hx, hco⟩, rfl⟩
  rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
  have hxY : x ∈ Y := deltaZero_le Y hx
  have hgx : g * x * g⁻¹ ∈ delta A LB Y :=
    conj_mem_delta_of_mem_deltaZero hA h444 hY hE (hPR hgP) hgE hx
  have hcomm : ⁅x⁻¹, g⁆ ∈ CFSG.Open.pCoreOf 2 Y ⊓ delta A LB Y := by
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · rw [commutatorElement_def]
      exact mul_mem ((Subgroup.mem_normalizer_iff.mp (hYP (inv_mem hxY)) g).mp hgP)
        (inv_mem hgP)
    · have e : ⁅x⁻¹, g⁆ = x⁻¹ * (g * x * g⁻¹) := by
        rw [commutatorElement_def]
        group
      rw [e]
      exact mul_mem (inv_mem (deltaZero_le_delta Y hx)) hgx
  have hmem : g * x * g⁻¹ ∈ deltaZero A LB Y ⊔ (CFSG.Open.pCoreOf 2 Y ⊓ delta A LB Y) := by
    have e : g * x * g⁻¹ = x * ⁅x⁻¹, g⁆ := by
      rw [commutatorElement_def]
      group
    rw [e]
    exact mul_mem (Subgroup.mem_sup_left hx) (Subgroup.mem_sup_right hcomm)
  have hco' : Nat.Coprime (orderOf (g * x * g⁻¹)) 2 := by
    have e := (MulAut.conj g).orderOf_eq x
    rw [MulAut.conj_apply] at e
    rwa [e]
  exact Subgroup.subset_closure
    ⟨mem_left_of_coprime_of_isPGroup Nat.prime_two hMN hM2 hmem hco', hco'⟩

