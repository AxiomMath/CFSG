theorem exists_mem_thetaQuotCentralizer_of_card {G : Type} [Group G] [Finite G]
    {K A : Subgroup G}
    (hsimple : IsSimpleGroup (↥K ⧸ aschbacherSolvableCore 3 ↥K))
    (hnab : ∃ a b : ↥K ⧸ aschbacherSolvableCore 3 ↥K, a * b ≠ b * a)
    (hcat : CFSG.Open.IsCatalogGroup (↥K ⧸ aschbacherSolvableCore 3 ↥K))
    (h3 : CFSG.Open.pRank 3 (⊤ : Subgroup (↥K ⧸ aschbacherSolvableCore 3 ↥K)) ≤ 1)
    (hA : CFSG.Assembly.IsElemAbelian 3 A) (hA27 : Nat.card A = 27)
    (hAK : A ≤ Subgroup.normalizer (K : Set G)) :
    ∃ d ∈ A, d ≠ 1 ∧ d ∈ Sec4.thetaQuotCentralizer K := by
  haveI := hsimple
  by_contra hcon
  have hnot : ∀ d ∈ A, d ∈ Sec4.thetaQuotCentralizer K → d = 1 := fun d hd hdC => by
    by_contra hd1
    exact hcon ⟨d, hd, hd1, hdC⟩
  have hf : Function.Injective
      (((Sec4.thetaQuotMulAut K).comp K.normalizerMonoidHom).comp
        (A.subgroupOf (Subgroup.normalizer (K : Set G))).subtype) := by
    rw [injective_iff_map_eq_one]
    intro a ha
    have hx : (A.subgroupOf (Subgroup.normalizer (K : Set G))).subtype a ∈
        ((Sec4.thetaQuotMulAut K).comp K.normalizerMonoidHom).ker :=
      MonoidHom.mem_ker.mpr ha
    have hdC : (((A.subgroupOf (Subgroup.normalizer (K : Set G))).subtype a :
        Subgroup.normalizer (K : Set G)) : G) ∈ Sec4.thetaQuotCentralizer K := by
      unfold Sec4.thetaQuotCentralizer
      exact Subgroup.mem_map.mpr ⟨_, hx, rfl⟩
    have hdA : (((A.subgroupOf (Subgroup.normalizer (K : Set G))).subtype a :
        Subgroup.normalizer (K : Set G)) : G) ∈ A :=
      Subgroup.mem_subgroupOf.mp a.2
    exact Subtype.ext (Subtype.ext (hnot _ hdA hdC))
  have hcomm : ∀ a b : ↥(A.subgroupOf (Subgroup.normalizer (K : Set G))),
      a * b = b * a := by
    have := hA.1
    intro a b
    have hab : (a.1 : G) * (b.1 : G) = (b.1 : G) * (a.1 : G) :=
      congrArg (Subtype.val : ↥A → G)
        (mul_comm' (⟨(a.1 : G), Subgroup.mem_subgroupOf.mp a.2⟩ : ↥A)
          ⟨(b.1 : G), Subgroup.mem_subgroupOf.mp b.2⟩)
    exact Subtype.ext (Subtype.ext hab)
  have hpow : ∀ a : ↥(A.subgroupOf (Subgroup.normalizer (K : Set G))), a ^ 3 = 1 := by
    intro a
    have h1 : ((a.1 : G)) ^ 3 = 1 := hA.2 _ (Subgroup.mem_subgroupOf.mp a.2)
    exact Subtype.ext (Subtype.ext (by simpa using h1))
  have hcardB : Nat.card ↥(A.subgroupOf (Subgroup.normalizer (K : Set G))) = 3 ^ 3 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAK).toEquiv, hA27] <;> norm_num
  have h4 : 3 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (MulAut (↥K ⧸ aschbacherSolvableCore 3 ↥K))) :=
    CFSG.SectionRank.le_pRank_of_injective (by norm_num) hcomm hpow hcardB _ hf le_top
  have hZ : Subgroup.center (↥K ⧸ aschbacherSolvableCore 3 ↥K) = ⊥ :=
    CFSG.LocalAnalysis.RankThreeTheoremC.center_eq_bot_of_simple hnab
  have hmul := CFSG.LocalAnalysis.RankFourTheoremC.pRank_mulAut_le_add_pRank_outer
    Nat.prime_three hZ
  obtain ⟨T⟩ : Nonempty (Sylow 3 (↥K ⧸ aschbacherSolvableCore 3 ↥K)) := inferInstance
  have hT : IsCyclic (T : Subgroup (↥K ⧸ aschbacherSolvableCore 3 ↥K)) :=
    CFSG.AGLEmbedding.isCyclic_sylow_of_pRank_le_one Nat.prime_three (by norm_num) h3 T
  have hout := CFSG.LocalAnalysis.RankThreeTheoremC.kFactOutCyclic_holds
    (↥K ⧸ aschbacherSolvableCore 3 ↥K) hsimple hnab hcat 3 Nat.prime_three (by norm_num) T hT
  omega

end Item189QProof

