theorem sec15R_point {A L : Subgroup G} {c : G} (h : Sec15R G A c L) {c' : G}
    (hc' : Subgroup.zpowers c' ∈ omegaA A) {L' : Subgroup G} (hL' : L' ∈ lA A c') :
    Sec15R G A c' L' :=
  { h with zpowers_mem_omegaA := hc', mem_lA := hL' }

omit [Finite G] in
theorem orbitIn_eq_singleton {X F : Subgroup G} (hX : X ≤ Subgroup.normalizer (F : Set G)) :
    orbitIn X F = {F} := by
  ext F'
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact Subgroup.mem_normalizer_iff_map_conj_eq.mp (hX hx)
  · rintro rfl
    exact ⟨1, one_mem _, (Late.map_conj_one _).symm⟩

omit [Finite G] in
theorem ncard_omegaA_eq_one_of_le {A X : Subgroup G} {c : G}
    (hΩ : omegaA A = orbitIn X (Subgroup.zpowers c))
    (hX : X ≤ Subgroup.normalizer (Subgroup.zpowers c : Set G)) : (omegaA A).ncard = 1 := by
  rw [hΩ, orbitIn_eq_singleton hX, Set.ncard_singleton]

theorem eq_map_conj_of_mem_lA {A L : Subgroup G} {c : G} (hD : Sec13Data G A c L) {f : G}
    (hfA : f ∈ A) (hfL : f ∈ L) (hfc : f ∉ Subgroup.zpowers c) {w : G}
    (hw : w ∈ Subgroup.normalizer (A : Set G)) {c' : G}
    (hc' : Subgroup.zpowers c' = (Subgroup.zpowers c).map (MulAut.conj w).toMonoidHom)
    {L' : Subgroup G} (hL' : L' ∈ lA A c') : L' = L.map (MulAut.conj w).toMonoidHom := by
  have hzx : Subgroup.zpowers c' = Subgroup.zpowers (w * c * w⁻¹) := by
    rw [hc', MonoidHom.map_zpowers]
    rfl
  have hL'x : L' ∈ lA A (w * c * w⁻¹) := lA_eq_of_zpowers_eq hzx ▸ hL'
  have hL'0 : L'.map (MulAut.conj w⁻¹).toMonoidHom ∈ lA A c := by
    refine (map_conj_mem_lA_iff (A := A) (L := L'.map (MulAut.conj w⁻¹).toMonoidHom) (c := c)
      hw).mp ?_
    rwa [Late.map_conj_map_conj, mul_inv_cancel, Late.map_conj_one]
  have h0 := eq_of_mem_lA_of_mem hD.mem_thetaComponentsAt hL'0 hfA hfL hfc
  rw [← h0, Late.map_conj_map_conj, mul_inv_cancel, Late.map_conj_one]

omit [Finite G] in
theorem map_conj_eq_self {A : Subgroup G} {w : G} (hw : w ∈ Subgroup.normalizer (A : Set G)) :
    A.map (MulAut.conj w).toMonoidHom = A :=
  Subgroup.mem_normalizer_iff_map_conj_eq.mp hw

omit [Finite G] in
theorem nonempty_quot_conj {A L : Subgroup G} (hAL : A ≤ Subgroup.normalizer (L : Set G))
    {w : G} (hw : w ∈ Subgroup.normalizer (A : Set G)) {T : Type*} [Group T]
    (hAL' : A ≤ Subgroup.normalizer ((L.map (MulAut.conj w).toMonoidHom : Subgroup G) : Set G))
    (hq : letI := kerAO2_normal hAL
      Nonempty (↥(A ⊔ L) ⧸ kerAO2 A L ≃* T)) :
    letI := kerAO2_normal hAL'
    Nonempty (↥(A ⊔ L.map (MulAut.conj w).toMonoidHom) ⧸
      kerAO2 A (L.map (MulAut.conj w).toMonoidHom) ≃* T) := by
  let _ := kerAO2_normal hAL
  let _ := kerAO2_normal hAL'
  obtain ⟨φ⟩ := hq
  set σ := MulAut.conj w with hσ
  have hN : (A ⊔ L).map σ.toMonoidHom = A ⊔ L.map σ.toMonoidHom := by
    rw [Subgroup.map_sup, map_conj_eq_self hw]
  let e : ↥(A ⊔ L) ≃* ↥(A ⊔ L.map σ.toMonoidHom) :=
    ((A ⊔ L).equivMapOfInjective σ.toMonoidHom σ.injective).trans (MulEquiv.subgroupCongr hN)
  have he : ∀ x : ↥(A ⊔ L), ((e x : ↥(A ⊔ L.map σ.toMonoidHom)) : G) = σ (x : G) := fun x => rfl
  have hK : (kerAO2 A L).map e.toMonoidHom = kerAO2 A (L.map σ.toMonoidHom) := by
    have hP : CFSG.Open.pCoreOf 2 (L.map σ.toMonoidHom) =
        (CFSG.Open.pCoreOf 2 L).map σ.toMonoidHom :=
      CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 σ L
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      show ((e x : ↥(A ⊔ L.map σ.toMonoidHom)) : G) ∈ CFSG.Open.pCoreOf 2 (L.map σ.toMonoidHom)
      rw [he, hP]
      exact Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mp hx)
    · intro hy
      have hy' : (y : G) ∈ (CFSG.Open.pCoreOf 2 L).map σ.toMonoidHom := by
        rw [← hP]
        exact Subgroup.mem_subgroupOf.mp hy
      obtain ⟨z, hz, hzy⟩ := hy'
      have hzN : z ∈ A ⊔ L :=
        Subgroup.mem_sup_right (CFSG.LieType.BorelTits.pCoreOf_le 2 L hz)
      refine ⟨⟨z, hzN⟩, Subgroup.mem_subgroupOf.mpr hz, ?_⟩
      apply Subtype.ext
      show ((e ⟨z, hzN⟩ : ↥(A ⊔ L.map σ.toMonoidHom)) : G) = (y : G)
      rw [he]
      exact hzy
  exact ⟨(QuotientGroup.congr _ _ e hK).symm.trans φ⟩

theorem exists_mem_inf_not_mem_of_card_nine {A L : Subgroup G} {c : G}
    (hc : Nat.card (Subgroup.zpowers c) = 3) (h9 : Nat.card (A ⊓ L : Subgroup G) = 9) :
    ∃ f ∈ A, f ∈ L ∧ f ∉ Subgroup.zpowers c := by
  by_contra hall
  push Not at hall
  have hle : A ⊓ L ≤ Subgroup.zpowers c := fun f hf => hall f hf.1 hf.2
  have := Subgroup.card_le_of_le hle
  omega

theorem false_of_orbit_quot {A L : Subgroup G} {c : G} (hD : Sec13Data G A c L)
    (h1510 : Item1510 A)
    (htr : ∀ F ∈ omegaA A, ∃ w ∈ Subgroup.normalizer (A : Set G),
      F = (Subgroup.zpowers c).map (MulAut.conj w).toMonoidHom)
    {f : G} (hfA : f ∈ A) (hfL : f ∈ L) (hfc : f ∉ Subgroup.zpowers c)
    (hq : letI := kerAO2_normal hD.le_normalizer
      Nonempty (↥(A ⊔ L) ⧸ kerAO2 A L ≃*
        Multiplicative (ZMod 3) × projSL 3 (GaloisField 2 2))) : False := by
  obtain ⟨c', L', hL', hc', hempty⟩ := h1510
  obtain ⟨w, hw, hcw⟩ := htr _ hc'
  have hL'eq := eq_map_conj_of_mem_lA hD hfA hfL hfc hw hcw hL'
  subst hL'eq
  exact hempty.false (nonempty_quot_conj hD.le_normalizer hw hL'.2.1 hq).some

theorem card_inf_eq_nine_of_le_sup {F L : Subgroup G} {c : G}
    (hFN : F ≤ Subgroup.normalizer (L : Set G)) (hcN : c ∈ Subgroup.normalizer (L : Set G))
    (hF27 : Nat.card F = 27) (hFL : F ≤ Subgroup.zpowers c ⊔ L) (hc3 : orderOf c = 3)
    (hcL : c ∉ L) (hcF : c ∈ F) : Nat.card (F ⊓ L : Subgroup G) = 9 := by
  have hcN' : Subgroup.zpowers c ≤ Subgroup.normalizer (L : Set G) :=
    Subgroup.zpowers_le.mpr hcN
  have h1 := Sec6.card_sup_mul_card_inf hFN
  have h2 := Sec6.card_sup_mul_card_inf hcN'
  have hdisj : Subgroup.zpowers c ⊓ L = ⊥ := by
    rw [inf_comm]
    exact Sec4.Census.inf_zpowers_eq_bot_of_not_mem Nat.prime_three hc3 hcL
  rw [hdisj, Subgroup.card_bot, mul_one, Nat.card_zpowers, hc3] at h2
  have hle : Nat.card (F ⊔ L : Subgroup G) ≤ Nat.card (Subgroup.zpowers c ⊔ L : Subgroup G) :=
    Subgroup.card_le_of_le (sup_le hFL le_sup_right)
  have hLpos : 0 < Nat.card L := Nat.card_pos
  have h9 : 9 ≤ Nat.card (F ⊓ L : Subgroup G) := by
    by_contra hlt
    push Not at hlt
    have : Nat.card (F ⊔ L : Subgroup G) * Nat.card (F ⊓ L : Subgroup G) <
        3 * Nat.card L * 9 := by
      calc Nat.card (F ⊔ L : Subgroup G) * Nat.card (F ⊓ L : Subgroup G)
          ≤ 3 * Nat.card L * Nat.card (F ⊓ L : Subgroup G) := by
            exact Nat.mul_le_mul_right _ (h2 ▸ hle)
        _ < 3 * Nat.card L * 9 := Nat.mul_lt_mul_of_pos_left hlt (by omega)
    rw [h1, hF27] at this
    omega
  have hdvd : Nat.card (F ⊓ L : Subgroup G) ∣ 3 ^ 3 := by
    rw [show (3 : ℕ) ^ 3 = 27 by norm_num, ← hF27]
    exact Subgroup.card_dvd_of_le inf_le_left
  obtain ⟨k, hk3, hk⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hdvd
  have hne : Nat.card (F ⊓ L : Subgroup G) ≠ 27 := by
    intro h27
    have hEq : F ⊓ L = F := Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [h27, hF27])
    have hmem : c ∈ F ⊓ L := by
      rw [hEq]
      exact hcF
    exact hcL hmem.2
  interval_cases k <;> simp_all

theorem false_of_card_nine_of_isZ3PGLThreePi {A L : Subgroup G} {c : G}
    (hD : Sec13Data G A c L) (hcL : c ∉ L) (h9 : Nat.card (A ⊓ L : Subgroup G) = 9)
    (hPGL : Sec8.IsZ3PGLThreePi (lBarA c L A)) : False := by
  have hcB : c ∉ A ⊓ L := fun h => hcL h.2
  have hAa := eq_sup_of_card_nine hD h9 hcB
  have hEH : A ≤ Subgroup.normalizer (Subgroup.zpowers c : Set G) :=
    hD.A_le_centralizer.trans (centralizer_singleton_le_normalizer_zpowers c)
  have hEc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := fun x hx y hy => hD.commute hx hy
  have hcl : ∀ (k : ℤ), ∀ y ∈ L, c ^ k * y = y * c ^ k := fun k y hy =>
    (Commute.zpow_left (Subgroup.mem_centralizer_singleton_iff.mp (hD.le_centralizer hy)).symm
      k)
  have hcN : Subgroup.zpowers c ≤ Subgroup.normalizer ((A ⊓ L : Subgroup G) : Set G) := by
    rw [Subgroup.zpowers_le]
    refine Subgroup.mem_normalizer_iff.mpr fun y => ?_
    constructor
    · intro hy
      have hcy : c * y = y * c := hD.commute hD.mem_A hy.1
      rw [hcy, mul_inv_cancel_right]
      exact hy
    · intro hy
      have hy' : c * y * c⁻¹ ∈ A := hy.1
      have hcy : c * y * c⁻¹ * c = c * (c * y * c⁻¹) := hD.commute hy' hD.mem_A
      have hyy : y = c * y * c⁻¹ := by
        have := congrArg (fun t => c⁻¹ * t) hcy
        simpa [mul_assoc] using this
      rw [hyy]
      exact hy
  have hinn : ∀ e ∈ A, ∀ hN : e ∈ Subgroup.normalizer (L : Set G),
      ∃ w : L ⧸ aschbacherSolvableCore 3 L, ∀ z,
        Sec4.thetaQuotMulAut L (L.normalizerMonoidHom ⟨e, hN⟩) z = w * z * w⁻¹ := by
    intro e he hN
    have he' : e ∈ ((Subgroup.zpowers c ⊔ (A ⊓ L) : Subgroup G) : Set G) := by
      rw [← hAa]
      exact he
    rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ hcN] at he'
    obtain ⟨z, hz, a, ha, rfl⟩ := Set.mem_mul.mp he'
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
    refine ⟨((⟨a, ha.2⟩ : L) : L ⧸ aschbacherSolvableCore 3 L), fun w => ?_⟩
    induction w using QuotientGroup.induction_on with
    | H x =>
      rw [Sec4.thetaQuotMulAut_mk, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul,
        ← QuotientGroup.mk_mul]
      congr 1
      apply Subtype.ext
      rw [Sec4.normalizerMonoidHom_apply_coe]
      have hax : a * (x : G) * a⁻¹ ∈ L :=
        mul_mem (mul_mem ha.2 x.2) (inv_mem ha.2)
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_rev]
      calc c ^ k * a * (x : G) * (a⁻¹ * (c ^ k)⁻¹)
          = c ^ k * (a * (x : G) * a⁻¹) * (c ^ k)⁻¹ := by group
        _ = a * (x : G) * a⁻¹ := by rw [hcl k _ hax, mul_inv_cancel_right]
  exact false_of_inner_of_isZ3PGLThreePi hD hD.le_normalizer hEH hEc
    (fun x hx => exists_lBar_conj_eq_of_inner hD.mem_thetaComponentsAt hD.le_normalizer hEH hinn
      hx) hPGL

theorem isoLThreePi_of_mulEquiv {X Y : Type} [Group X] [Group Y] (φ : X ≃* Y) {p e : ℕ}
    [Fact p.Prime] (h : Sec4.IsoLThreePi X p e) : Sec4.IsoLThreePi Y p e := by
  rcases h with ⟨hq, ⟨ψ⟩⟩ | ⟨hq, ⟨ψ⟩⟩
  · exact Or.inl ⟨hq, ⟨φ.symm.trans ψ⟩⟩
  · exact Or.inr ⟨hq, ⟨φ.symm.trans ψ⟩⟩

theorem not_isoLThreePi_of_A7 {X : Type} [Group X] (ψ : X ≃* alternatingGroup (Fin 7))
    {p e : ℕ} [Fact p.Prime] (hL3 : Sec4.IsoLThreePi X p e) : False :=
  not_isoLThreePi_alternating_seven p e (isoLThreePi_of_mulEquiv ψ hL3)


theorem not_isoLThreePi_of_prod_M12 {A L : Subgroup G} {c : G} (hD : Sec13Data G A c L)
    (φ : lBarA c L A ≃* Multiplicative (ZMod 3) × CFSG.Blueprint.NativeSporadic.M12)
    {p e : ℕ} [Fact p.Prime] (hL3 : Sec4.IsoLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) p e) :
    False := by
  obtain ⟨-, ⟨hM12p, hM12z⟩, -⟩ := sporadicModels131
