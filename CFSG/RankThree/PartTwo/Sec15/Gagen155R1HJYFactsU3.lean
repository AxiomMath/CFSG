noncomputable def projSU3EquivPSU3 (n : ℕ) :
    ↥(CFSG.PGLModel.projSU 3 2 n) ≃* ↥(CFSG.Open.PSU3 2 n) :=
  ((CFSG.PGLModel.projSUEquivStatedProj 3 2 n).trans
      (CFSG.ShultStronglyClosedTI.glaSUCanonicalEquivNative n)).trans
    (MulEquiv.subgroupCongr (CFSG.Models.benderPSU3Model_eq_psu3 n).symm)

theorem five_dvd_card_of_borel_complement {n : ℕ} (hn2 : 2 ≤ n) (hn : Even n)
    (U : Sylow 2 (PSU3 2 n)) (D : Subgroup (PSU3 2 n))
    (hUcard : Nat.card (U : Subgroup (PSU3 2 n)) = (2 ^ n) ^ 3)
    (hinf : (U : Subgroup (PSU3 2 n)) ⊓ D = ⊥)
    (hsup : (U : Subgroup (PSU3 2 n)) ⊔ D =
      Subgroup.normalizer ((U : Subgroup (PSU3 2 n)) : Set (PSU3 2 n))) :
    5 ∣ Nat.card D := by
  have hDnorm : D ≤ Subgroup.normalizer ((U : Subgroup (PSU3 2 n)) : Set (PSU3 2 n)) := by
    rw [← hsup]
    exact le_sup_right
  have hdisj : Disjoint (U : Subgroup (PSU3 2 n)) D := disjoint_iff.mpr hinf
  have hcard := CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer
    (U : Subgroup (PSU3 2 n)) D hDnorm hdisj
  rw [hsup, CFSG.SignalizerFunctorTheorem.McBride.UnitaryFrame.card_normalizer_sylow_two_psu3
    hn2 U, hUcard] at hcard
  have hg_dvd : Nat.gcd (2 ^ n + 1) 3 ∣ (2 ^ n) ^ 2 - 1 := by
    have h1 : Nat.gcd (2 ^ n + 1) 3 ∣ 2 ^ n + 1 := Nat.gcd_dvd_left _ _
    have h2 : 2 ^ n + 1 ∣ (2 ^ n) ^ 2 - 1 := by
      rw [show (2 ^ n) ^ 2 - 1 = (2 ^ n + 1) * (2 ^ n - 1) by
        simpa using Nat.sq_sub_sq (2 ^ n) 1]
      exact dvd_mul_right _ _
    exact h1.trans h2
  have hcard' : (2 ^ n) ^ 3 * (((2 ^ n) ^ 2 - 1) / Nat.gcd (2 ^ n + 1) 3) =
      (2 ^ n) ^ 3 * Nat.card D := by
    rw [← Nat.mul_div_assoc ((2 ^ n) ^ 3) hg_dvd]
    exact hcard
  have hDeq : Nat.card D = ((2 ^ n) ^ 2 - 1) / Nat.gcd (2 ^ n + 1) 3 := by
    exact (Nat.eq_of_mul_eq_mul_left (pow_pos (by positivity : 0 < 2 ^ n) 3) hcard').symm
  have h5q : 5 ∣ (2 ^ n) ^ 2 - 1 := by
    have h4 : (2 ^ n) ^ 2 = 4 ^ n := by
      calc (2 ^ n) ^ 2 = 2 ^ (n * 2) := by rw [pow_mul]
        _ = 2 ^ (2 * n) := by rw [Nat.mul_comm]
        _ = (2 ^ 2) ^ n := by rw [pow_mul]
        _ = 4 ^ n := by norm_num
    rw [h4]
    exact CFSG.Quasithin.Vol2.Ch10.SecB.five_dvd_four_pow_sub_one hn
  have hcop : Nat.Coprime 5 (Nat.gcd (2 ^ n + 1) 3) :=
    Nat.Coprime.coprime_dvd_right (Nat.gcd_dvd_right (2 ^ n + 1) 3) (by norm_num)
  have h5g : 5 ∣ ((2 ^ n) ^ 2 - 1) / Nat.gcd (2 ^ n + 1) 3 := by
    apply Nat.Coprime.dvd_of_dvd_mul_right hcop
    rw [Nat.div_mul_cancel hg_dvd]
    exact h5q
  rwa [hDeq]

theorem exists_borelComplement_psu3 {n : ℕ} (hn2 : 2 ≤ n) (hn : Even n) :
    ∀ U : Sylow 2 (PSU3 2 n), ∃ D : Subgroup (PSU3 2 n), IsCyclic D ∧ 5 ∣ Nat.card D ∧
      (U : Subgroup (PSU3 2 n)) ⊓ D = ⊥ ∧
      (U : Subgroup (PSU3 2 n)) ⊔ D =
        Subgroup.normalizer ((U : Subgroup (PSU3 2 n)) : Set (PSU3 2 n)) := by
  intro U
  obtain ⟨-, ⟨D, hDcyc, -, hinf, hsup⟩, -, -, hUcard⟩ :=
    (CFSG.Open.bender_psu3_borel_full n hn2) U
  exact ⟨D, hDcyc, five_dvd_card_of_borel_complement hn2 hn U D hUcard hinf hsup, hinf, hsup⟩

theorem exists_borelComplement_map_mulEquiv {G H : Type} [Group G] [Group H]
    [Finite G] [Finite H] (e : G ≃* H)
    (h : ∀ U : Sylow 2 G, ∃ D : Subgroup G, IsCyclic D ∧ 5 ∣ Nat.card D ∧
      (U : Subgroup G) ⊓ D = ⊥ ∧
      (U : Subgroup G) ⊔ D = Subgroup.normalizer ((U : Subgroup G) : Set G)) :
    ∀ U : Sylow 2 H, ∃ D : Subgroup H, IsCyclic D ∧ 5 ∣ Nat.card D ∧
      (U : Subgroup H) ⊓ D = ⊥ ∧
      (U : Subgroup H) ⊔ D = Subgroup.normalizer ((U : Subgroup H) : Set H) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro U
  let U' : Sylow 2 G := U.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  obtain ⟨D', hcyc, h5, hinf, hsup⟩ := h U'
  have hUmap : (U' : Subgroup G).map e.toMonoidHom = (U : Subgroup H) := by
    rw [show (U' : Subgroup G) = (U : Subgroup H).map e.symm.toMonoidHom from
      Sylow.coe_mapSurjective _ U]
    rw [Subgroup.map_map]
    have hcomp : e.toMonoidHom.comp e.symm.toMonoidHom = MonoidHom.id H := by
      ext x
      simp
    rw [hcomp, Subgroup.map_id]
  refine ⟨D'.map e.toMonoidHom, ?_, ?_, ?_, ?_⟩
  · letI : IsCyclic ↥D' := hcyc
    let eD := e.subgroupMap D'
    exact isCyclic_of_surjective eD eD.surjective
  · rw [Subgroup.card_map_of_injective e.injective]
    exact h5
  · rw [← hUmap, ← Subgroup.map_inf _ _ _ e.injective, hinf, Subgroup.map_bot]
  · rw [← hUmap, ← Subgroup.map_sup, hsup, Subgroup.map_equiv_normalizer_eq U' e, hUmap]

theorem res1HJYFacts_projSU {n : ℕ} (hn0 : 0 < n) (hn : Even n) :
    Res1HJYFacts ↥(CFSG.PGLModel.projSU 3 2 n) := by
  have hn2 : 2 ≤ n := by
    obtain ⟨m, rfl⟩ := hn
    omega
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let Y := ↥(CFSG.PGLModel.projSU 3 2 n)
  change Res1HJYFacts Y
  let e : Y ≃* ↥(CFSG.Open.PSU3 2 n) := projSU3EquivPSU3 n
  haveI : Finite Y := Finite.of_equiv (↥(CFSG.Open.PSU3 2 n)) e.symm.toEquiv
  have hTI : ∀ U V : Sylow 2 Y, U ≠ V → (U : Subgroup Y) ⊓ V = ⊥ := by
    intro U V hne
    have hBend : CFSG.Open.fusionIsBenderGroup Y :=
      CFSG.RankThree.PartTwo.Sec18.fusionIsBenderGroup_of_projSU_three hn2 (MulEquiv.refl Y)
    have hU : CFSG.ABGLocalTools.IsSylowOf 2 (U : Subgroup Y) ⊤ := by
      rw [CFSG.ABGLocalTools.isSylowOf_iff, Subgroup.relIndex_top_right]
      exact ⟨le_top, U.isPGroup', U.not_dvd_index⟩
    have hV : CFSG.ABGLocalTools.IsSylowOf 2 (V : Subgroup Y) ⊤ := by
      rw [CFSG.ABGLocalTools.isSylowOf_iff, Subgroup.relIndex_top_right]
      exact ⟨le_top, V.isPGroup', V.not_dvd_index⟩
    have hne' : (U : Subgroup Y) ≠ (V : Subgroup Y) := fun h => hne (Sylow.ext h)
    exact CFSG.CGT.PushingUpLit.C2L.StrongTI.bender_sylow_inf_eq_bot hBend hU hV hne'
  have hB : ∀ U : Sylow 2 Y, ∃ D : Subgroup Y, IsCyclic D ∧ 5 ∣ Nat.card D ∧
      (U : Subgroup Y) ⊓ D = ⊥ ∧
      (U : Subgroup Y) ⊔ D = Subgroup.normalizer ((U : Subgroup Y) : Set Y) :=
    exists_borelComplement_map_mulEquiv e.symm (exists_borelComplement_psu3 hn2 hn)
  exact res1HJYFacts_of_borel hTI hB

