  have hRH : R ≤ H := h.r_le.trans (sup_comm _ _).le
  have hJM : J ⊓ M = ⊥ := h.centralizer_inf_eq_bot h152 h153
  have hRM : R ⊓ M = ⊥ := h.R_inf_eq_bot
  have hRJ : R ≤ J := h.R_le_centralizer
  have hx0L : x0 ≤ L := Item148HJ.residual_le L d
  have hinj : ∀ {K : Subgroup G}, K ⊓ M = ⊥ →
      Function.Injective (ρ.comp (K.subgroupOf H).subtype) := by
    intro K hKM x y hxy
    have h1 : ρ ((x : ↥H) * (y : ↥H)⁻¹) = 1 := by
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype] at hxy
      rw [map_mul, map_inv, hxy, mul_inv_cancel]
    have hmem : (((x : ↥H) * (y : ↥H)⁻¹ : ↥H) : G) ∈ K :=
