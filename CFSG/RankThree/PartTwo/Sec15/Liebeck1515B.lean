  have hCV' : Subgroup.centralizer (U' : Set _) = V' :=
    centralizer_eq_of_isCentralProduct hUV' hcUV' h3' hU' hV'
  have hZQ : Subgroup.center (↥X ⧸ aschbacherSolvableCore 3 ↥X) ≤ U' ⊓ V' :=
    center_le_inf hUV' hcUV' h3' hU'.1 hV'.1
  have hEJ : E ≤ J := h.le_centralizer_E
  have hJC : J ≤ C := h.le_centralizer_d
  have hEC : E ≤ C := hEJ.trans hJC
  have hEN : E ≤ Subgroup.normalizer (H : Set G) ⊓ Subgroup.normalizer (M : Set G) :=
