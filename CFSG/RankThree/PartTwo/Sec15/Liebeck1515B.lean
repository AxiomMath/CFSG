private theorem mul_conj_mul_inv {Q : Type*} [Group Q] (σ : MulAut Q) (v : Q) :
    σ * MulAut.conj v * σ⁻¹ = MulAut.conj (σ v) := by
  ext q
  simp only [MulAut.mul_apply, MulAut.conj_apply, map_mul, map_inv]
  rw [MulAut.inv_apply, MulEquiv.apply_symm_apply]

private theorem map_mem_centralizer {Q : Type*} [Group Q] {U : Subgroup Q} (σ : MulAut Q)
    (hσ : ∀ u ∈ U, σ u = u) {v : Q} (hv : v ∈ Subgroup.centralizer (U : Set Q)) :
    σ v ∈ Subgroup.centralizer (U : Set Q) := by
  rw [Subgroup.mem_centralizer_iff] at hv ⊢
  intro u hu
  have := congrArg σ (hv u hu)
  rw [map_mul, map_mul, hσ u hu] at this
  exact this

private theorem mul_comm_of_sq_eq_one {G : Type*} [Group G] {R : Subgroup G}
    (hR : ∀ r ∈ R, r ^ 2 = 1) : ∀ u ∈ R, ∀ v ∈ R, u * v = v * u := by
  have hinv : ∀ r ∈ R, r⁻¹ = r := fun r hr => by
    rw [inv_eq_iff_mul_eq_one, ← sq, hR r hr]
  intro u hu v hv
  calc u * v = (u * v)⁻¹ := (hinv _ (mul_mem hu hv)).symm
    _ = v⁻¹ * u⁻¹ := mul_inv_rev u v
    _ = v * u := by rw [hinv v hv, hinv u hu]

variable {G : Type} [Group G] [Finite G]

private theorem eq_one_of_map_eq_one {H M K : Subgroup G} {Q : Type*} [Group Q] {ρ : ↥H →* Q}
    (hker : ρ.ker = M.subgroupOf H) (hKM : K ⊓ M = ⊥) {x : ↥H} (hxK : (x : G) ∈ K)
    (hx : ρ x = 1) : x = 1 := by
  have hxM : x ∈ ρ.ker := hx
  rw [hker, Subgroup.mem_subgroupOf] at hxM
  have : (x : G) ∈ K ⊓ M := ⟨hxK, hxM⟩
  rw [hKM, Subgroup.mem_bot] at this
  exact Subtype.ext this

