  let κ : ↥E →* MulAut (↥X ⧸ aschbacherSolvableCore 3 ↥X) :=
    (actHom hρs hρk).comp (Subgroup.inclusion hEN)
  have hκ : ∀ (e : ↥E) (y : ↥H), κ e (ρ y) = ρ (conjOn (hEN e.2).1 y) := fun e y =>
    actAut_apply hρs hρk (hEN e.2).1 (hEN e.2).2 y
  have hκU : ∀ (e : ↥E), ∀ u ∈ U', κ e u = u := by
    intro e u hu
