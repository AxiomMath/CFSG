variable {G : Type} [Group G]

@[expose] def secCent (R J V : Subgroup G) : Subgroup G where
  carrier := {r | r ∈ R ∧ r ∈ Subgroup.normalizer (V : Set G) ∧
    ∀ j ∈ J, r * j * r⁻¹ * j⁻¹ ∈ V}
  one_mem' := ⟨R.one_mem, Subgroup.one_mem _, fun j _ => by simp⟩
  mul_mem' := by
    rintro a b ⟨haR, haN, ha⟩ ⟨hbR, hbN, hb⟩
    refine ⟨R.mul_mem haR hbR, Subgroup.mul_mem _ haN hbN, fun j hj => ?_⟩
    have e : a * b * j * (a * b)⁻¹ * j⁻¹ =
        a * (b * j * b⁻¹ * j⁻¹) * a⁻¹ * (a * j * a⁻¹ * j⁻¹) := by group
    rw [e]
    exact V.mul_mem ((Subgroup.mem_normalizer_iff.mp haN _).mp (hb j hj)) (ha j hj)
  inv_mem' := by
    rintro a ⟨haR, haN, ha⟩
    refine ⟨R.inv_mem haR, Subgroup.inv_mem _ haN, fun j hj => ?_⟩
    have e : a⁻¹ * j * a⁻¹⁻¹ * j⁻¹ = a⁻¹ * (a * j * a⁻¹ * j⁻¹)⁻¹ * a⁻¹⁻¹ := by group
    rw [e]
    exact (Subgroup.mem_normalizer_iff.mp (Subgroup.inv_mem _ haN) _).mp (V.inv_mem (ha j hj))

theorem secCent_le (R J V : Subgroup G) : secCent R J V ≤ R := fun _ h => h.1

theorem le_secCent {R J V : Subgroup G} (hVR : V ≤ R)
    (hJV : J ≤ Subgroup.normalizer (V : Set G)) : V ≤ secCent R J V := by
  intro v hv
  refine ⟨hVR hv, Subgroup.le_normalizer hv, fun j hj => ?_⟩
  have e : v * j * v⁻¹ * j⁻¹ = v * (j * v⁻¹ * j⁻¹) := by group
  rw [e]
  exact V.mul_mem hv ((Subgroup.mem_normalizer_iff.mp (hJV hj) _).mp (V.inv_mem hv))

theorem mem_normalizer_of_forall {H : Subgroup G} {g : G}
    (h : ∀ g' ∈ ({g, g⁻¹} : Set G), ∀ x ∈ H, g' * x * g'⁻¹ ∈ H) :
    g ∈ Subgroup.normalizer (H : Set G) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨fun hx => h g (by simp) x hx, fun hx => ?_⟩
  have := h g⁻¹ (by simp) _ hx
  rwa [show g⁻¹ * (g * x * g⁻¹) * g⁻¹⁻¹ = x by group] at this

theorem le_normalizer_secCent_left {R J V : Subgroup G} (hVR : V ≤ R)
    (hJV : J ≤ Subgroup.normalizer (V : Set G)) :
    J ≤ Subgroup.normalizer (secCent R J V : Set G) := by
  have key : ∀ j₀ ∈ J, ∀ r ∈ secCent R J V, j₀ * r * j₀⁻¹ ∈ secCent R J V := by
    intro j₀ hj₀ r hr
    have hri : r⁻¹ ∈ secCent R J V := (secCent R J V).inv_mem hr
    have hc : r⁻¹ * j₀ * r⁻¹⁻¹ * j₀⁻¹ ∈ V := hri.2.2 j₀ hj₀
    have e : j₀ * r * j₀⁻¹ = r * (r⁻¹ * j₀ * r⁻¹⁻¹ * j₀⁻¹) := by group
    rw [e]
    exact (secCent R J V).mul_mem hr (le_secCent hVR hJV hc)
  intro j₀ hj₀
  refine mem_normalizer_of_forall fun g hg x hx => ?_
  rcases hg with rfl | rfl
  · exact key g hj₀ x hx
  · exact key _ (J.inv_mem hj₀) x hx

theorem le_normalizer_secCent_right {R J V : Subgroup G}
    (hRJ : R ≤ Subgroup.normalizer (J : Set G)) (hRV : R ≤ Subgroup.normalizer (V : Set G)) :
    R ≤ Subgroup.normalizer (secCent R J V : Set G) := by
  have key : ∀ r₀ ∈ R, ∀ r ∈ secCent R J V, r₀ * r * r₀⁻¹ ∈ secCent R J V := by
    intro r₀ hr₀ r ⟨hrR, hrN, hr⟩
    refine ⟨R.mul_mem (R.mul_mem hr₀ hrR) (R.inv_mem hr₀), Subgroup.mul_mem _
      (Subgroup.mul_mem _ (hRV hr₀) hrN) (Subgroup.inv_mem _ (hRV hr₀)), fun j hj => ?_⟩
    have hj' : r₀⁻¹ * j * r₀⁻¹⁻¹ ∈ J :=
      (Subgroup.mem_normalizer_iff.mp (hRJ (R.inv_mem hr₀)) j).mp hj
    have hc := hr _ hj'
    have e : r₀ * r * r₀⁻¹ * j * (r₀ * r * r₀⁻¹)⁻¹ * j⁻¹ =
        r₀ * (r * (r₀⁻¹ * j * r₀⁻¹⁻¹) * r⁻¹ * (r₀⁻¹ * j * r₀⁻¹⁻¹)⁻¹) * r₀⁻¹ := by group
    rw [e]
    exact (Subgroup.mem_normalizer_iff.mp (hRV hr₀) _).mp hc
  intro r₀ hr₀
  refine mem_normalizer_of_forall fun g hg x hx => ?_
  rcases hg with rfl | rfl
  · exact key g hr₀ x hx
  · exact key _ (R.inv_mem hr₀) x hx

theorem mem_secCent_of_centralizes {R J V W : Subgroup G}
    (hRJ : R ≤ Subgroup.normalizer (J : Set G)) (hJW : J ≤ Subgroup.normalizer (W : Set G))
    (hCW : J ⊓ Subgroup.centralizer (W : Set G) ≤ V) {r : G} (hr : r ∈ R)
    (hrV : r ∈ Subgroup.normalizer (V : Set G)) (hrW : r ∈ Subgroup.centralizer (W : Set G)) :
    r ∈ secCent R J V := by
  refine ⟨hr, hrV, fun j hj => hCW (Subgroup.mem_inf.mpr ⟨?_, ?_⟩)⟩
  · exact J.mul_mem ((Subgroup.mem_normalizer_iff.mp (hRJ hr) j).mp hj) (J.inv_mem hj)
  · rw [Subgroup.mem_centralizer_iff]
    intro w hw
    have hw' : j⁻¹ * w * j⁻¹⁻¹ ∈ W := (Subgroup.mem_normalizer_iff.mp (hJW (J.inv_mem hj)) w).mp hw
    have h1 : (j⁻¹ * w * j⁻¹⁻¹) * r⁻¹ = r⁻¹ * (j⁻¹ * w * j⁻¹⁻¹) :=
      Subgroup.mem_centralizer_iff.mp ((Subgroup.centralizer (W : Set G)).inv_mem hrW) _ hw'
    have h2 : w * r = r * w := Subgroup.mem_centralizer_iff.mp hrW w hw
    calc w * (r * j * r⁻¹ * j⁻¹) = (w * r) * j * r⁻¹ * j⁻¹ := by group
      _ = r * j * ((j⁻¹ * w * j⁻¹⁻¹) * r⁻¹) * j⁻¹ := by rw [h2]; group
      _ = r * j * (r⁻¹ * (j⁻¹ * w * j⁻¹⁻¹)) * j⁻¹ := by rw [h1]
      _ = r * j * r⁻¹ * j⁻¹ * w := by group

theorem le_normalizer_inf' {X H K : Subgroup G} (hH : X ≤ Subgroup.normalizer (H : Set G))
    (hK : X ≤ Subgroup.normalizer (K : Set G)) :
    X ≤ Subgroup.normalizer ((H ⊓ K : Subgroup G) : Set G) := by
  intro x hx
  rw [Subgroup.mem_normalizer_iff]
  intro y
  simp only [SetLike.mem_coe, Subgroup.mem_inf]
  rw [Subgroup.mem_normalizer_iff.mp (hH hx) y, Subgroup.mem_normalizer_iff.mp (hK hx) y]

theorem le_normalizer_centralizer' {X W : Subgroup G} (hW : X ≤ Subgroup.normalizer (W : Set G)) :
    X ≤ Subgroup.normalizer (Subgroup.centralizer (W : Set G) : Set G) := by
  have key : ∀ x ∈ X, ∀ c ∈ Subgroup.centralizer (W : Set G),
      x * c * x⁻¹ ∈ Subgroup.centralizer (W : Set G) := by
    intro x hx c hc
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    have hw' : x⁻¹ * w * x⁻¹⁻¹ ∈ W := (Subgroup.mem_normalizer_iff.mp (hW (X.inv_mem hx)) w).mp hw
    have h1 := Subgroup.mem_centralizer_iff.mp hc _ hw'
    calc w * (x * c * x⁻¹) = x * ((x⁻¹ * w * x⁻¹⁻¹) * c) * x⁻¹ := by group
      _ = x * (c * (x⁻¹ * w * x⁻¹⁻¹)) * x⁻¹ := by rw [h1]
      _ = x * c * x⁻¹ * w := by group
  intro x hx
  refine mem_normalizer_of_forall fun g hg y hy => ?_
  rcases hg with rfl | rfl
  · exact key g hx y hy
  · exact key _ (X.inv_mem hx) y hy

