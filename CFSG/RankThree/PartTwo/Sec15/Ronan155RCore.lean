theorem index_subgroupOf_dvd_two {H K : Subgroup G} (hHK : H ≤ K)
    (h : Nat.card K ≤ 2 * Nat.card H) : (H.subgroupOf K).index ∣ 2 := by
  have hrel := Subgroup.relIndex_mul_card H K
  rw [inf_eq_left.mpr hHK] at hrel
  have hpos : 0 < Nat.card H := Nat.card_pos
  have hKpos : 0 < Nat.card K := Nat.card_pos
  have hle : H.relIndex K ≤ 2 := by
    by_contra hc
    push_neg at hc
    have : 3 * Nat.card H ≤ H.relIndex K * Nat.card H := Nat.mul_le_mul_right _ hc
    omega
  have hne : H.relIndex K ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hrel
    omega
  change H.relIndex K ∣ 2
  rcases (by omega : H.relIndex K = 1 ∨ H.relIndex K = 2) with h1 | h1 <;> rw [h1]
  · exact one_dvd 2

theorem card_le_two_mul_of_index_dvd_two {H K : Subgroup G} (hHK : H ≤ K)
    (h : (H.subgroupOf K).index ∣ 2) : Nat.card K ≤ 2 * Nat.card H := by
  have hrel := Subgroup.relIndex_mul_card H K
  rw [inf_eq_left.mpr hHK] at hrel
  have hle : H.relIndex K ≤ 2 := Nat.le_of_dvd two_pos h
  rw [← hrel]
  exact Nat.mul_le_mul_right _ hle

theorem pow_twelve_mem_centralizer {Z : Subgroup G} (hZ : IsElementaryAbelian 2 Z) {b c : G}
    (hb : b ∈ Subgroup.normalizer (Z : Set G)) (hc : c ∈ Subgroup.normalizer (Z : Set G))
    {w₁ w₂ : G} (hw₁ : w₁ ∈ Z) (hw₂ : w₂ ∈ Z)
    (h₁ : ∀ z ∈ Z, b * z * b⁻¹ = z ∨ b * z * b⁻¹ = z * w₁)
    (h₂ : ∀ z ∈ Z, c * z * c⁻¹ = z ∨ c * z * c⁻¹ = z * w₂) :
    (b * c) ^ 12 ∈ Subgroup.centralizer (Z : Set G) := by
  haveI : IsMulCommutative ↥Z := hZ.toIsMulCommutative
  have hW : ∀ w : ↥Z, w ^ 2 = 1 := fun w =>
    Subtype.ext (by simpa using (isElementaryAbelian_iff.mp hZ).2 w w.2)
  set t₁ : MulAut ↥Z := Subgroup.normalizerMonoidHom Z ⟨b, hb⟩ with ht₁
  set t₂ : MulAut ↥Z := Subgroup.normalizerMonoidHom Z ⟨c, hc⟩ with ht₂
  have h₁' : ∀ v : ↥Z, t₁ v = v ∨ t₁ v = v * ⟨w₁, hw₁⟩ := fun v => by
    rcases h₁ v v.2 with h | h
    · left
      exact Subtype.ext (by simpa [ht₁] using h)
    · right
      exact Subtype.ext (by simpa [ht₁] using h)
  have h₂' : ∀ v : ↥Z, t₂ v = v ∨ t₂ v = v * ⟨w₂, hw₂⟩ := fun v => by
    rcases h₂ v v.2 with h | h
    · left
      exact Subtype.ext (by simpa [ht₂] using h)
    · right
      exact Subtype.ext (by simpa [ht₂] using h)
  have h12 := CFSG.Quasithin.H13.A6.A6L24.pow_twelve_of_transv hW h₁' h₂'
  have hmul : t₁ * t₂ = Subgroup.normalizerMonoidHom Z (⟨b, hb⟩ * ⟨c, hc⟩) := by
    rw [map_mul]
  rw [hmul, ← map_pow] at h12
  rw [Subgroup.mem_centralizer_iff]
  intro z hz
  have hz' := congrArg (fun φ : MulAut ↥Z => ((φ ⟨z, hz⟩ : ↥Z) : G)) h12
  simp only [Subgroup.normalizerMonoidHom_apply_apply_coe, MulAut.one_apply] at hz'
  have hcoe : (((⟨b, hb⟩ * ⟨c, hc⟩ : ↥(Subgroup.normalizer (Z : Set G))) ^ 12 :
      ↥(Subgroup.normalizer (Z : Set G))) : G) = (b * c) ^ 12 := by
    simp
  rw [hcoe] at hz'
  calc z * (b * c) ^ 12 = ((b * c) ^ 12 * z * ((b * c) ^ 12)⁻¹) * (b * c) ^ 12 := by
        rw [hz']
    _ = (b * c) ^ 12 * z := by group

theorem le_secCent_of_mem_elemFamilyIn {R J V : Subgroup G} (hVR : V ≤ R)
    (hJV : J ≤ Subgroup.normalizer (V : Set G)) (hRJ : R ≤ Subgroup.normalizer (J : Set G))
    (hRV : R ≤ Subgroup.normalizer (V : Set G))
    (hJZ : J ⊓ Subgroup.centralizer (omegaOneCenterIn (secCent R J V) : Set G) ≤ V)
    (h3 : ∀ b₁ ∈ R, ∀ b₂ ∈ R, b₁ ^ 2 = 1 → b₂ ^ 2 = 1 → b₁ ∉ secCent R J V →
      b₂ ∉ secCent R J V → b₁ * b₂ ∈ secCent R J V)
    (h4 : ∀ b ∈ R, b ^ 2 = 1 → b ∉ secCent R J V → ∃ j ∈ J, (b * j * b⁻¹ * j⁻¹) ^ 12 ∉ V)
    {A : Subgroup G} (hA : A ∈ elemFamilyIn 2 R) : A ≤ secCent R J V := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set D := secCent R J V with hD
  set Z := omegaOneCenterIn D with hZ
  have hDR : D ≤ R := secCent_le R J V
  have hZD : Z ≤ D := omegaOneCenterIn_le D
  have hZE : IsElementaryAbelian 2 Z := isElementaryAbelian_omegaOneCenterIn D
  have hNZ : Subgroup.normalizer (D : Set G) ≤ Subgroup.normalizer (Z : Set G) :=
    normalizer_le_normalizer_of_characteristic' hZD (characteristic_omegaOneCenterIn D)
  have hJZn : J ≤ Subgroup.normalizer (Z : Set G) := (le_normalizer_secCent_left hVR hJV).trans hNZ
  have hRZn : R ≤ Subgroup.normalizer (Z : Set G) :=
    (le_normalizer_secCent_right hRJ hRV).trans hNZ
  obtain ⟨hAR, hAe, hAc⟩ := mem_elemFamilyIn.mp hA
  have hAcomm := (isElementaryAbelian_iff.mp hAe).1
  have hA2 := (isElementaryAbelian_iff.mp hAe).2
  by_contra hAD
  obtain ⟨b, hbA, hbD⟩ := SetLike.not_le_iff_exists.mp hAD
  have hbR : b ∈ R := hAR hbA
  have hb2 : b ^ 2 = 1 := hA2 b hbA
  set A₀ := A ⊓ D with hA₀
  have hidxA : (A₀.subgroupOf A).index ∣ 2 := by
    rw [Subgroup.index_dvd_two_iff]
    refine ⟨⟨b, hbA⟩, fun x => ?_⟩
    by_cases hx : (x : G) ∈ D
    · right
      exact Subgroup.mem_subgroupOf.mpr ⟨x.2, hx⟩
    · left
      rw [Subgroup.mem_subgroupOf]
      exact ⟨A.mul_mem x.2 hbA, h3 x (hAR x.2) b hbR (hA2 x x.2) hb2 hx hbD⟩
  have hcardA : Nat.card A ≤ 2 * Nat.card A₀ :=
    card_le_two_mul_of_index_dvd_two inf_le_left hidxA
  have hA₀Z : ∀ a ∈ A₀, ∀ z ∈ Z, a * z = z * a := fun a ha z hz =>
    (mem_omegaOneCenterIn_iff.mp hz).2.1 a ha.2
  have hA₀e : IsElementaryAbelian 2 A₀ :=
    isElementaryAbelian_iff.mpr ⟨fun a ha c hc => hAcomm a ha.1 c hc.1, fun a ha => hA2 a ha.1⟩
  have hEe : IsElementaryAbelian 2 (A₀ ⊔ Z : Subgroup G) :=
    isElementaryAbelian_sup_of_le_centralizer hA₀e hZE
      (fun z hz => Subgroup.mem_centralizer_iff.mpr fun a ha => hA₀Z a ha z hz)
  have hER : A₀ ⊔ Z ≤ R := sup_le (inf_le_left.trans hAR) (hZD.trans hDR)
  have hcardE : Nat.card (A₀ ⊔ Z : Subgroup G) ≤ Nat.card A := by
    rw [hAc]
    exact card_le_pow_pRank_of_le hER hEe
  have hprod := CFSG.RankThree.PartTwo.Sec3.card_sup_mul_card_inf_of_commute hA₀Z
  have hZ2 : Nat.card Z ≤ 2 * Nat.card (A₀ ⊓ Z : Subgroup G) := by
    have hpos : 0 < Nat.card A₀ := Nat.card_pos
    have h1 : Nat.card A₀ * Nat.card Z ≤
        Nat.card A₀ * (2 * Nat.card (A₀ ⊓ Z : Subgroup G)) := by
      calc Nat.card A₀ * Nat.card Z =
            Nat.card (A₀ ⊔ Z : Subgroup G) * Nat.card (A₀ ⊓ Z : Subgroup G) := hprod.symm
        _ ≤ Nat.card A * Nat.card (A₀ ⊓ Z : Subgroup G) := Nat.mul_le_mul_right _ hcardE
        _ ≤ (2 * Nat.card A₀) * Nat.card (A₀ ⊓ Z : Subgroup G) := Nat.mul_le_mul_right _ hcardA
        _ = Nat.card A₀ * (2 * Nat.card (A₀ ⊓ Z : Subgroup G)) := by ring
    exact Nat.le_of_mul_le_mul_left h1 hpos
  set Zb := Z ⊓ Subgroup.centralizer ({b} : Set G) with hZb
  have hA₀Zb : (A₀ ⊓ Z : Subgroup G) ≤ Zb := fun x hx =>
    Subgroup.mem_inf.mpr ⟨hx.2, Subgroup.mem_centralizer_singleton_iff.mpr (hAcomm x hx.1.1 b hbA)⟩
  have hidxZ : (Zb.subgroupOf Z).index ∣ 2 :=
    index_subgroupOf_dvd_two inf_le_left
      (hZ2.trans (Nat.mul_le_mul_left 2 (Subgroup.card_le_of_le hA₀Zb)))
  obtain ⟨a, ha⟩ := Subgroup.index_dvd_two_iff.mp hidxZ
  set w : G := (a : G) * b * (a : G)⁻¹ * b⁻¹ with hw
  have hwZ : w ∈ Z := by
    have h1 : b * (a : G)⁻¹ * b⁻¹ ∈ Z :=
      (Subgroup.mem_normalizer_iff.mp (hRZn hbR) _).mp (Z.inv_mem a.2)
    have e : w = (a : G) * (b * (a : G)⁻¹ * b⁻¹) := by rw [hw]; group
    rw [e]
    exact Z.mul_mem a.2 h1
  have htr : ∀ z ∈ Z, b * z * b⁻¹ = z ∨ b * z * b⁻¹ = z * w := by
    intro z hz
    rcases ha ⟨z, hz⟩ with h | h
    · right
      have h' := (Subgroup.mem_inf.mp (Subgroup.mem_subgroupOf.mp h)).2
      have hza : (z * (a : G)) * b = b * (z * (a : G)) := by
        simpa using Subgroup.mem_centralizer_singleton_iff.mp h'
      calc b * z * b⁻¹ = b * (z * (a : G)) * (a : G)⁻¹ * b⁻¹ := by group
        _ = (z * (a : G)) * b * (a : G)⁻¹ * b⁻¹ := by rw [← hza]
        _ = z * w := by rw [hw]; group
    · left
      have h' := (Subgroup.mem_inf.mp (Subgroup.mem_subgroupOf.mp h)).2
      have hzb : z * b = b * z := by simpa using Subgroup.mem_centralizer_singleton_iff.mp h'
      calc b * z * b⁻¹ = z * b * b⁻¹ := by rw [hzb]
        _ = z := by group
  obtain ⟨j, hj, hj12⟩ := h4 b hbR hb2 hbD
  apply hj12
  have hc : j * b * j⁻¹ ∈ Subgroup.normalizer (Z : Set G) :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ (hJZn hj) (hRZn hbR)) (Subgroup.inv_mem _ (hJZn hj))
  have hw' : j * w * j⁻¹ ∈ Z := (Subgroup.mem_normalizer_iff.mp (hJZn hj) w).mp hwZ
  have htr' : ∀ z ∈ Z, (j * b * j⁻¹) * z * (j * b * j⁻¹)⁻¹ = z ∨
      (j * b * j⁻¹) * z * (j * b * j⁻¹)⁻¹ = z * (j * w * j⁻¹) := by
    intro z hz
    have hz' : j⁻¹ * z * j⁻¹⁻¹ ∈ Z :=
      (Subgroup.mem_normalizer_iff.mp (hJZn (J.inv_mem hj)) z).mp hz
    rcases htr _ hz' with h | h
    · left
      calc (j * b * j⁻¹) * z * (j * b * j⁻¹)⁻¹ = j * (b * (j⁻¹ * z * j⁻¹⁻¹) * b⁻¹) * j⁻¹ := by
            group
        _ = j * (j⁻¹ * z * j⁻¹⁻¹) * j⁻¹ := by rw [h]
        _ = z := by group
    · right
      calc (j * b * j⁻¹) * z * (j * b * j⁻¹)⁻¹ = j * (b * (j⁻¹ * z * j⁻¹⁻¹) * b⁻¹) * j⁻¹ := by
            group
        _ = j * ((j⁻¹ * z * j⁻¹⁻¹) * w) * j⁻¹ := by rw [h]
        _ = z * (j * w * j⁻¹) := by group
  have h12 := pow_twelve_mem_centralizer hZE (hRZn hbR) hc hwZ hw' htr htr'
  have hbinv : b⁻¹ = b := inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact hb2)
  have heq : b * (j * b * j⁻¹) = b * j * b⁻¹ * j⁻¹ := by
    rw [hbinv]
    group
  rw [heq] at h12
  have hmemJ : (b * j * b⁻¹ * j⁻¹) ^ 12 ∈ J :=
    J.pow_mem (J.mul_mem ((Subgroup.mem_normalizer_iff.mp (hRJ hbR) j).mp hj) (J.inv_mem hj)) 12
  exact hJZ (Subgroup.mem_inf.mpr ⟨hmemJ, h12⟩)

theorem exists_char_of_secCent {R J V : Subgroup G} (hR2 : IsPGroup 2 R) (hR1 : R ≠ ⊥)
    (hVR : V ≤ R) (hJV : J ≤ Subgroup.normalizer (V : Set G))
    (hRJ : R ≤ Subgroup.normalizer (J : Set G)) (hRV : R ≤ Subgroup.normalizer (V : Set G))
    (hCV : J ⊓ Subgroup.centralizer (V : Set G) ≤ V)
    (hdich : ∀ W : Subgroup G, W ≤ J → J ≤ Subgroup.normalizer (W : Set G) → W ≤ V ∨ W = J)
    (h3 : ∀ b₁ ∈ R, ∀ b₂ ∈ R, b₁ ^ 2 = 1 → b₂ ^ 2 = 1 → b₁ ∉ secCent R J V →
      b₂ ∉ secCent R J V → b₁ * b₂ ∈ secCent R J V)
    (h4 : ∀ b ∈ R, b ^ 2 = 1 → b ∉ secCent R J V → ∃ j ∈ J, (b * j * b⁻¹ * j⁻¹) ^ 12 ∉ V) :
    ∃ C : Subgroup G, C ≠ ⊥ ∧ C ≤ R ∧ (C.subgroupOf R).Characteristic ∧
      J ≤ Subgroup.normalizer (C : Set G) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set D := secCent R J V with hD
  set Z := omegaOneCenterIn D with hZ
  have hDR : D ≤ R := secCent_le R J V
  have hZD : Z ≤ D := omegaOneCenterIn_le D
  have hNZ : Subgroup.normalizer (D : Set G) ≤ Subgroup.normalizer (Z : Set G) :=
    normalizer_le_normalizer_of_characteristic' hZD (characteristic_omegaOneCenterIn D)
  have hJD : J ≤ Subgroup.normalizer (D : Set G) := le_normalizer_secCent_left hVR hJV
  have hJZn : J ≤ Subgroup.normalizer (Z : Set G) := hJD.trans hNZ
  have hZR : omegaOneCenterIn R ≤ Z := by
    intro z hz
    obtain ⟨hzR, hzc, hz2⟩ := mem_omegaOneCenterIn_iff.mp hz
    have hzC : z ∈ Subgroup.centralizer (V : Set G) :=
      Subgroup.mem_centralizer_iff.mpr fun v hv => hzc v (hVR hv)
    have hzD : z ∈ D := mem_secCent_of_centralizes hRJ hJV hCV hzR (hRV hzR) hzC
    exact mem_omegaOneCenterIn_iff.mpr ⟨hzD, fun k hk => hzc k (hDR hk), hz2⟩
  by_cases hJC : J ≤ Subgroup.centralizer (Z : Set G)
  · refine ⟨omegaOneCenterIn R, omegaOneCenterIn_ne_bot hR2 hR1, omegaOneCenterIn_le R,
      characteristic_omegaOneCenterIn R, ?_⟩
    exact (hJC.trans (Subgroup.centralizer_le hZR)).trans (Subgroup.centralizer_le_normalizer _)
  · have hJW : J ≤ Subgroup.normalizer
        ((J ⊓ Subgroup.centralizer (Z : Set G) : Subgroup G) : Set G) :=
      le_normalizer_inf' Subgroup.le_normalizer (le_normalizer_centralizer' hJZn)
    have hWV : J ⊓ Subgroup.centralizer (Z : Set G) ≤ V := by
      rcases hdich _ inf_le_left hJW with h | h
      · exact h
      · exact absurd (h.ge.trans inf_le_right) hJC
    have hAD : ∀ A ∈ elemFamilyIn 2 R, A ≤ D := fun A hA =>
      le_secCent_of_mem_elemFamilyIn hVR hJV hRJ hRV hWV h3 h4 hA
    obtain ⟨A, hA⟩ := exists_mem_elemFamilyIn R
    obtain ⟨-, hAe, hAc⟩ := mem_elemFamilyIn.mp hA
    have hrank : pRank 2 ↥D = pRank 2 ↥R :=
      le_antisymm (pRank_mono hDR)
        (CFSG.QuasithinUnique.Setup.Campbell.pRank_le_of_card_le (hAD A hA) hAe hAc)
    have hJRD : jIn R ≤ jIn D := by
      rw [jIn_eq_elemThompsonIn, elemThompsonIn_eq]
      refine sSup_le fun B hB => le_elemThompsonIn (mem_elemFamilyIn.mpr ?_)
      obtain ⟨-, hBe, hBc⟩ := mem_elemFamilyIn.mp hB
      exact ⟨hAD B hB, hBe, by rw [hBc, hrank]⟩
    have hJeq : jIn R = jIn D := le_antisymm hJRD (jIn_mono_of_pRank_eq hDR hrank)
    refine ⟨jIn R, jIn_ne_bot hR2 hR1, jIn_le R, characteristic_jIn_subgroupOf R, ?_⟩
    rw [hJeq]
    exact hJD.trans (normalizer_le_normalizer_jIn D)

end Finite

