@[expose] noncomputable def DiamondR : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G) (c : G) (L : Subgroup G),
    Sec15R G A c L → ¬ AllPointsHJ A → ∀ X K Y M T : Subgroup G, Ctx155 A X K Y M T →
    MaxT155 A X K T → Above155w A X →
    (¬ ∃ (c' : G) (L' : Subgroup G), Subgroup.zpowers c' ∈ omegaA A ∧ L' ∈ lA A c' ∧
      L' = (L' ⊓ X) ⊔ CFSG.Open.pCoreOf 2 L') →
    K = X ⊔ CFSG.Open.pCoreOf 2 K →
    ∀ J ∈ thetaComponentsIn M, J ∈ scriptY0 A (lB A) → X ≤ J →
    ∀ n m : ℕ, 1 ≤ n → 1 ≤ m →
      Nonempty (↥J ⧸ CFSG.pCore 2 ↥J ≃*
        CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 (2 * n * m))) →
      IsLThreeEpsAt (↥X ⧸ CFSG.pCore 2 ↥X) 2 n → False

theorem step155CasesTwoNHJWR_of_diamond (hY4 : Y4LThreePiNHJR) (hd : DiamondR) :
    Step155CasesTwoNHJWR := by
  intro G _ _ A c L hR hS hNHJ X K Y M T hC hmax hab J hJM hJ0 hXJ hcl
  rintro ⟨⟨n, m, hn, hm, ⟨φ⟩, hXε, -⟩, -⟩
  have hX4 : X ∈ scriptY4 A (lB A) := hC.res ▸ hC.isY.2.1
  have hpi : Sec4.IsoLThreePi (↥X ⧸ CFSG.pCore 2 ↥X) 2 n :=
    hY4 G A c L hR hNHJ X hX4 n hn hXε
  have hK : K = X ⊔ CFSG.Open.pCoreOf 2 K := by
    rcases hC.hyp with hom | hK
    · rcases hom with ⟨hno, -⟩ | hcl'
      · exact absurd ⟨n, hn, hpi⟩ hno
      · exact absurd hcl' hcl
    · exact hK
  exact hd G A c L hR hNHJ X K Y M T hC hmax hab hcl hK J hJM hJ0 hXJ n m hn hm ⟨φ⟩ hXε

