variable {G : Type} [Group G] [Finite G]

theorem exists_section_of_le {X J : Subgroup G} (hXJ : X ≤ J) (Ker : Subgroup ↥X) [Ker.Normal]
    (hKer : (X ⊓ CFSG.Open.pCoreOf 2 J).subgroupOf X ≤ Ker) :
    ∃ (H : Subgroup (↥J ⧸ CFSG.pCore 2 ↥J)) (N : Subgroup H) (_ : N.Normal),
      Nonempty (↥X ⧸ Ker ≃* ↥H ⧸ N) := by
  set φ : ↥X →* ↥J ⧸ CFSG.pCore 2 ↥J :=
    (QuotientGroup.mk' (CFSG.pCore 2 ↥J)).comp (Subgroup.inclusion hXJ) with hφ
  set ψ : ↥X →* ↥φ.range := φ.rangeRestrict with hψ
  have hsurj : Function.Surjective ψ := φ.rangeRestrict_surjective
  have hker : ψ.ker ≤ Ker := by
    intro x hx
    have h1 : φ x = 1 := by
      have := (MonoidHom.mem_ker.mp hx)
      exact congrArg Subtype.val this
    have h2 : Subgroup.inclusion hXJ x ∈ CFSG.pCore 2 ↥J := by
      rw [hφ, MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
      exact h1
    have h3 : ((Subgroup.inclusion hXJ x : ↥J) : G) ∈ CFSG.Open.pCoreOf 2 J :=
      (CFSG.mem_openPCoreOf_iff _).mpr h2
    apply hKer
    rw [Subgroup.mem_subgroupOf]
    exact ⟨x.2, h3⟩
  haveI hNorm : (Ker.map ψ).Normal := Subgroup.Normal.map inferInstance ψ hsurj
  refine ⟨φ.range, Ker.map ψ, hNorm, ⟨?_⟩⟩
  set χ : ↥X →* ↥φ.range ⧸ Ker.map ψ := (QuotientGroup.mk' (Ker.map ψ)).comp ψ with hχ
  have hχs : Function.Surjective χ :=
    (QuotientGroup.mk'_surjective (Ker.map ψ)).comp hsurj
  have hχk : χ.ker = Ker := by
    ext x
    rw [MonoidHom.mem_ker, hχ, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    constructor
    · intro hx
      have : x ∈ Subgroup.comap ψ (Ker.map ψ) := hx
      rw [Subgroup.comap_map_eq] at this
      exact (sup_le le_rfl hker) this
    · intro hx
      exact Subgroup.mem_map_of_mem _ hx
  exact (QuotientGroup.quotientMulEquivOfEq hχk.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective χ hχs)

theorem card_quot_le_of_le {X J : Subgroup G} (hXJ : X ≤ J) :
    Nat.card (↥X ⧸ CFSG.pCore 2 ↥X) ≤ Nat.card (↥J ⧸ CFSG.pCore 2 ↥J) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hKer : (X ⊓ CFSG.Open.pCoreOf 2 J).subgroupOf X ≤ CFSG.pCore 2 ↥X := by
    refine le_pCore155 ?_ ?_
    · have hle : X ⊓ CFSG.Open.pCoreOf 2 J ≤ X := inf_le_left
      rw [Subgroup.normal_subgroupOf_iff_le_normalizer hle]
      exact Late.le_normalizer_inf Subgroup.le_normalizer
        (hXJ.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 J))
    · have hp := (CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) J).to_le
        (inf_le_right : X ⊓ CFSG.Open.pCoreOf 2 J ≤ CFSG.Open.pCoreOf 2 J)
      exact hp.of_equiv
        (Subgroup.subgroupOfEquivOfLe (inf_le_left : X ⊓ CFSG.Open.pCoreOf 2 J ≤ X)).symm
  obtain ⟨H, N, hN, ⟨e⟩⟩ := exists_section_of_le hXJ (CFSG.pCore 2 ↥X) hKer
  rw [Nat.card_congr e.toEquiv]
  exact (Nat.card_le_card_of_surjective _ (QuotientGroup.mk'_surjective N)).trans
    (Subgroup.card_le_card_group H)

theorem not_le_of_diamond {X J K : Subgroup G} (hXJ : X ≤ J) (hJK : J ≤ K)
    (hK : K = X ⊔ CFSG.Open.pCoreOf 2 K) {n m : ℕ} (hn : 1 ≤ n) (hm : 1 ≤ m)
    (hJ : Nonempty (↥J ⧸ CFSG.pCore 2 ↥J ≃*
      CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 (2 * n * m))))
    (hX : IsLThreeEpsAt (↥X ⧸ CFSG.pCore 2 ↥X) 2 n) : False := by
  have h1 : Nat.card (↥K ⧸ CFSG.pCore 2 ↥K) = Nat.card (↥X ⧸ CFSG.pCore 2 ↥X) :=
    CFSG.RankThree.PartTwo.Sec16.card_quot_pCore_eq_of_eq_sup (hXJ.trans hJK) hK
  have h2 := card_quot_le_of_le hJK
  have h3 := card_quot_le_of_le hXJ
  have h4 : Nat.card (↥J ⧸ CFSG.pCore 2 ↥J) = Nat.card (↥X ⧸ CFSG.pCore 2 ↥X) :=
    le_antisymm (h2.trans h1.le) h3
  obtain ⟨φ⟩ := hJ
  rw [Nat.card_congr φ.toEquiv] at h4
  exact CFSG.RankThree.PartTwo.Sec16.false_of_card_eq_projSL hn hm hX h4

end Orders

@[expose] noncomputable def DiamondCharR : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G) (c : G) (L : Subgroup G),
    Sec15R G A c L → ¬ AllPointsHJ A → ∀ X K Y M T : Subgroup G, Ctx155 A X K Y M T →
    MaxT155 A X K T → Above155w A X →
    (¬ ∃ (c' : G) (L' : Subgroup G), Subgroup.zpowers c' ∈ omegaA A ∧ L' ∈ lA A c' ∧
      L' = (L' ⊓ X) ⊔ CFSG.Open.pCoreOf 2 L') →
    K = X ⊔ CFSG.Open.pCoreOf 2 K →
    ∀ J ∈ thetaComponentsIn M, J ∈ scriptY0 A (lB A) → X ≤ J →
    ∀ n m : ℕ, 1 ≤ n → 1 ≤ m →
      Nonempty (↥J ⧸ CFSG.pCore 2 ↥J ≃*
        CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 (2 * n * m))) →
      IsLThreeEpsAt (↥X ⧸ CFSG.pCore 2 ↥X) 2 n →
      ∃ C : Subgroup G, C ≠ ⊥ ∧ C ≤ CFSG.Open.pCoreOf 2 Y ∧
        (C.subgroupOf (CFSG.Open.pCoreOf 2 Y)).Characteristic ∧
        J ≤ Subgroup.normalizer (C : Set G)

theorem diamondR_of_char (h152 : Item152R) (h153 : Item153MainR) (hgrow : Step155GrowWR)
    (hc : DiamondCharR) : DiamondR := by
  intro G _ _ A c L hR hNHJ X K Y M T hC hmax hab hcl hK J hJM hJ0 hXJ n m hn hm hφ hXε
  have hS : Sec14Std G A c L := hR.toSec14Std
  have hX4 : X ∈ scriptY4 A (lB A) := hC.res ▸ hC.isY.2.1
  have hY3 : Y ∈ scriptY3 A (lB A) := hC.isY.1
  have hAY : A ≤ Subgroup.normalizer (Y : Set G) := hY3.1.1.2
  have hAR : A ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 Y : Set G) :=
    hAY.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 Y)
  have hclaim : Claim155 A K Y := by
    by_cases hKR : K ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 Y : Set G)
    · exact claim155_of_le_normalizer (h153 G A c L hR) hC.mem_k hKR hAR
    · exact hgrow G A c L hR hS X K Y M T hC hmax hab hKR
  obtain ⟨C, hC1, hCR, hCc, hJC⟩ :=
    hc G A c L hR hNHJ X K Y M T hC hmax hab hcl hK J hJM hJ0 hXJ n m hn hm hφ hXε
  have hJΔ : J = delta A (lB A) J := hJ0.1.2.2.1
  have hJN : J ≤ n155 A K :=
    calc J = delta A (lB A) J := hJΔ
      _ ≤ delta A (lB A) (Subgroup.normalizer (C : Set G)) := delta_mono hJC
      _ ≤ n155 A K := hclaim C hC1 hCR hCc
  have hJK : J ≤ K :=
    le_of_le_n155' hS (h152 G A c L hR) (h153 G A c L hR) hC.mem_k hX4 hJ0 hXJ hC.le_k hJN
  exact not_le_of_diamond hXJ hJK hK hn hm hφ hXε

theorem step155CasesTwoNHJWR_of_char (hY4 : Y4LThreePiNHJR) (h152 : Item152R)
    (h153 : Item153MainR) (hgrow : Step155GrowWR) (hc : DiamondCharR) :
    Step155CasesTwoNHJWR :=
  step155CasesTwoNHJWR_of_diamond hY4 (diamondR_of_char h152 h153 hgrow hc)

