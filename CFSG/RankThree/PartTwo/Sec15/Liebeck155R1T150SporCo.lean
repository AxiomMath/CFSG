open CFSG.Sporadic.Schreier.Co3 (co3P co3PermEquiv)
open CFSG.HardMathSupport.Dickson.I271 (exists_conj_classes caseA_spec caseB_spec caseC_spec)
open CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T (yPerm_pow)


theorem k150s_goodFor_co3 {J : Type} [Group J] (hJ : K150sTgt J) (x : Equiv.Perm (Fin 276))
    (hx : x ∈ co3P) (hxo : orderOf x = 3) :
    GoodFor J (centralizer ({x} : Set (Equiv.Perm (Fin 276))) ⊓ co3P) := by
  obtain ⟨k, hk, c, hc, e, he, rfl⟩ := exists_conj_classes hx hxo
  rcases hc with rfl | rfl | rfl
  · obtain ⟨h3, -, -, hcard, -, hnorm, hcent⟩ := caseA_spec
    exact k150s_goodFor_conj hk h3 he (k150s_goodFor_of_prime_not_dvd hJ.seven_dvd
      (k150s_not_seven_dvd_card_of_selfCentralizing_three hnorm
        (IsPGroup.of_card (n := 5) (by rw [hcard]; norm_num)) hcent (by rw [hcard]; norm_num)))
  · obtain ⟨h3, -, -, hcard, -, hnorm, hcent⟩ := caseB_spec
    exact k150s_goodFor_conj hk h3 he (k150s_goodFor_of_prime_not_dvd hJ.seven_dvd
      (k150s_not_seven_dvd_card_of_selfCentralizing_three hnorm
        (IsPGroup.of_card (n := 5) (by rw [hcard]; norm_num)) hcent (by rw [hcard]; norm_num)))
  · obtain ⟨⟨hCeq, hcard⟩, -⟩ := caseC_spec
    have h4536 : Nat.card ↥(centralizer
        ({CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T.yPerm} :
          Set (Equiv.Perm (Fin 276))) ⊓ co3P) = 4536 := by
      rw [← hCeq]
      exact hcard
    exact k150s_goodFor_conj hk yPerm_pow he
      (k150s_goodFor_of_not_dvd (hJ.not_dvd (by rw [h4536]; norm_num) (by rw [h4536]; norm_num)))


theorem k150s_noCfg_co3 {J : Type} [Group J] (hJ : K150sTgt J) :
    ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → (∃ a b : S, a * b ≠ b * a) →
      Nonempty (S ≃* Blueprint.NativeSporadic.Carrier .Co3) → NoCfgFor J S := by
  intro S _ _ _ hna ⟨e⟩
  have hout : ¬ 3 ∣ Nat.card (Outer (Blueprint.NativeSporadic.Carrier .Co3)) := by
    rw [show Nat.card (Outer (Blueprint.NativeSporadic.Carrier .Co3)) = 1 from
      CFSG.RankThree.PartOne.CTUC_Co3_all_automorphisms_inner.{0}.2.2.2.1]
    norm_num
  exact k150s_noCfg_of_subgroupModel (e.trans co3PermEquiv)
    (RonanK429H.center_eq_bot_of_simple_nonab hna)
    (RonanK429H.not_three_dvd_outer_of_mulEquiv e hout) (k150s_goodFor_co3 hJ)


theorem k150s_co3 {J : Type} [Group J] (hJ : K150sTgt J) : RowOfK150 J (Spor .Co3) :=
  k150s_row_of_native (s := .Co3) CFSG.Sporadic.Bridge.Co3.nonempty_mulEquiv (k150s_noCfg_co3 hJ)

end Co3

section Co2

open CFSG.Sporadic.Co2Cert (co2P co2PermEquiv)
open CFSG.HardMathSupport.Dickson.I271 (co2_exists_conj_classes co2CaseA_spec co2CaseB_spec Lsub
  uvGen nonempty_mulEquiv_QP45_of_rels)


theorem k150s_goodFor_co2 {J : Type} [Group J] (hJ : K150sTgt J) (x : Equiv.Perm (Fin 2300))
    (hx : x ∈ co2P) (hxo : orderOf x = 3) :
    GoodFor J (centralizer ({x} : Set (Equiv.Perm (Fin 2300))) ⊓ co2P) := by
  obtain ⟨k, hk, c, hc, e, he, rfl⟩ := co2_exists_conj_classes hx hxo
  rcases hc with rfl | rfl
  · obtain ⟨h3, -, -, hcard, -, hnorm, hcent⟩ := co2CaseA_spec
    exact k150s_goodFor_conj hk h3 he (k150s_goodFor_of_prime_not_dvd hJ.seven_dvd
      (k150s_not_seven_dvd_card_of_selfCentralizing_three hnorm
        (IsPGroup.of_card (n := 5) (by rw [hcard]; norm_num)) hcent (by rw [hcard]; norm_num)))
  · obtain ⟨h3, -, -, hcard, -, hnorm, hK, hrels⟩ := co2CaseB_spec
    obtain ⟨F⟩ := nonempty_mulEquiv_QP45_of_rels uvGen hrels hcard
    have hAut : Nat.card (MulAut Lsub) = 51840 :=
      (CFSG.LocalAnalysis.GLTheoremA.S2019.card_mulAut_U42 F).2
    have hK3 : IsPGroup 3 ↥(centralizer (Lsub : Set (Equiv.Perm (Fin 2300))) ⊓
        (centralizer ({CFSG.HardMathSupport.Dickson.I271.co2XB} : Set (Equiv.Perm (Fin 2300))) ⊓
          co2P)) := fun g => by
      refine ⟨1, ?_⟩
      have hg := hK g.1 (Subgroup.mem_inf.1 g.2).2 fun l hl =>
        (Subgroup.mem_centralizer_iff.1 (Subgroup.mem_inf.1 g.2).1 l hl)
      exact Subtype.ext (by simpa using hg)
    exact k150s_goodFor_conj hk h3 he (k150s_goodFor_of_prime_not_dvd hJ.seven_dvd
      (k150s_not_dvd_card_of_normalizes hnorm hK3 (by norm_num) (by norm_num)
        (by rw [hAut]; norm_num)))


theorem k150s_noCfg_co2 {J : Type} [Group J] (hJ : K150sTgt J) :
    ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → (∃ a b : S, a * b ≠ b * a) →
      Nonempty (S ≃* Blueprint.NativeSporadic.Carrier .Co2) → NoCfgFor J S := by
  intro S _ _ _ hna ⟨e⟩
  have hout : ¬ 3 ∣ Nat.card (Outer (Blueprint.NativeSporadic.Carrier .Co2)) := by
    rw [CFSG.RankThree.PartOne.SPOR.card_outer_Co2]
    norm_num
  exact k150s_noCfg_of_subgroupModel (e.trans co2PermEquiv)
    (RonanK429H.center_eq_bot_of_simple_nonab hna)
    (RonanK429H.not_three_dvd_outer_of_mulEquiv e hout) (k150s_goodFor_co2 hJ)


theorem k150s_co2 {J : Type} [Group J] (hJ : K150sTgt J) : RowOfK150 J (Spor .Co2) :=
  k150s_row_of_native (s := .Co2) CFSG.Sporadic.Bridge.Co2.nonempty_mulEquiv (k150s_noCfg_co2 hJ)

end Co2

