variable {Q : Type} [Group Q] [Finite Q]

private theorem mem_normalizer_of_forall_mem {J : Subgroup Q} {g : Q}
    (hg : ∀ x ∈ J, g * x * g⁻¹ ∈ J) : g ∈ Subgroup.normalizer (J : Set Q) :=
  Subgroup.mem_normalizer_iff.2 fun x =>
    (Sylow155KA6.apply_mem_iff_of_finite (MulAut.conj g) hg x).symm

private theorem mem_normalizer_map_subtype {J : Subgroup Q} {V : Subgroup ↥J} {y : ↥J}
    (hy : y ∈ Subgroup.normalizer (V : Set ↥J)) :
    (y : Q) ∈ Subgroup.normalizer ((V.map J.subtype : Subgroup Q) : Set Q) := by
  rw [Subgroup.mem_normalizer_iff] at hy ⊢
  intro x
  constructor
  · rintro ⟨v, hv, rfl⟩
    exact ⟨y * v * y⁻¹, (hy v).mp hv, rfl⟩
  · rintro ⟨w, hw, hwx⟩
    have hxJ : x ∈ J := by
      have : x = (y : Q)⁻¹ * (w : Q) * y := by
        rw [show (w : Q) = y * x * (y : Q)⁻¹ from hwx]
        group
      rw [this]
      exact J.mul_mem (J.mul_mem (J.inv_mem y.2) w.2) y.2
    refine ⟨⟨x, hxJ⟩, (hy _).mpr ?_, rfl⟩
    have : y * (⟨x, hxJ⟩ : ↥J) * y⁻¹ = w := Subtype.ext hwx.symm
    rw [this]
    exact hw

private theorem card_centerIn {J : Subgroup Q}
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6))) :
    Nat.card (Sec14.Item148PtRes.centerIn J) = 3 := by
  rw [Sec14.Item148PtRes.centerIn, Subgroup.card_map_of_injective J.subtype_injective]
  exact hT.1

private theorem isElemAbelian_centerIn {J : Subgroup Q}
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6)))
    (hZ : Sec14.Item148PtRes.centerIn J ≤ Subgroup.center Q) :
    CFSG.Assembly.IsElemAbelian 3 (Sec14.Item148PtRes.centerIn J) := by
  refine ⟨isMulCommutative_iff.mpr fun a b => Subtype.ext ?_, fun x hx => ?_⟩
  · exact (Subgroup.mem_center_iff.mp (hZ a.2) b).symm
  · have h := Subgroup.orderOf_dvd_natCard _ hx
    rw [card_centerIn hT] at h
    exact orderOf_dvd_iff_pow_eq_one.mp h

theorem exists_conj_eq_of_pow_three {J : Subgroup Q} (hperf : commutator ↥J = ⊤)
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6))) {y : Q}
    (hyJ : ∀ x ∈ J, y * x * y⁻¹ ∈ J) (hy3 : y ^ 3 = 1) (hy1 : ∃ x ∈ J, y * x * y⁻¹ ≠ x) :
    ∃ k ∈ J, k ^ 3 = 1 ∧ (∃ x ∈ J, k * x ≠ x * k) ∧ ∀ x ∈ J, y * x * y⁻¹ = k * x * k⁻¹ := by
  have hyN := mem_normalizer_of_forall_mem hyJ
  obtain ⟨σ, hσ, hσ3, hσ1⟩ : ∃ σ : MulAut ↥J, (∀ x : ↥J, ((σ x : ↥J) : Q) = y * x * y⁻¹) ∧
      σ ^ 3 = 1 ∧ σ ≠ 1 := by
    refine ⟨J.normalizerMonoidHom ⟨y, hyN⟩, fun x => rfl, ?_, ?_⟩
    · rw [← map_pow, ← map_one J.normalizerMonoidHom]
      exact congrArg _ (Subtype.ext (by simpa using hy3))
    · intro h
      obtain ⟨x, hx, hne⟩ := hy1
      apply hne
      have h2 := congrArg (fun φ : MulAut ↥J => ((φ ⟨x, hx⟩ : ↥J) : Q)) h
      simpa using h2
  obtain ⟨hZ, ⟨e⟩⟩ := hT
  obtain ⟨ψ⟩ := QuasithinUnique.Out21.A6.exists_psl29_equiv
  let ψ6 : ↥J ⧸ Subgroup.center ↥J ≃* ↥A6Models.psl29 := e.trans ψ.symm
  have hβ3 : ((Sylow155B3Q.rhoQ ψ6 σ : ↥A6Models.autA6) : P10) ^ 3 = 1 := by
    rw [← Subgroup.coe_pow, ← map_pow, hσ3, map_one, Subgroup.coe_one]
  have hβ1 : ((Sylow155B3Q.rhoQ ψ6 σ : ↥A6Models.autA6) : P10) ≠ 1 := fun h =>
    hσ1 ((Sylow155B3Q.rhoQ_eq_one_iff hperf ψ6 σ).1 (Subtype.ext h))
  have hβpsl : ((Sylow155B3Q.rhoQ ψ6 σ : ↥A6Models.autA6) : P10) ∈ A6Models.psl29 :=
    (mem_psl29_of_prime_pow Nat.prime_three (by norm_num) (Sylow155B3Q.rhoQ ψ6 σ).2 hβ3 hβ1).1
  obtain ⟨c, hc⟩ := ψ6.surjective ⟨_, hβpsl⟩
  obtain ⟨q, rfl⟩ := QuotientGroup.mk_surjective c
  have hσq : σ = MulAut.conj q := by
    refine Sylow155B3Q.rhoQ_injective hperf ψ6 (Subtype.ext ?_)
    rw [Sylow155B3Q.rhoQ_conj, hc]
  obtain ⟨g, hg, hgx⟩ := Sylow155KA6P.exists_conj_inv hβpsl hβ3
  obtain ⟨d, hd⟩ := ψ6.surjective ⟨g, hg⟩
  obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective d
  have hq3 : q ^ 3 = 1 :=
    Sylow155B3.pow_three_eq_one_of_psl29 hZ ψ6 (q := q) (r := r) (congrArg Subtype.val hc)
      (congrArg Subtype.val hd) hβ3 hgx
  have hconj : ∀ x ∈ J, y * x * y⁻¹ = (q : Q) * x * (q : Q)⁻¹ := by
    intro x hx
    have h2 := congrArg (fun φ : MulAut ↥J => ((φ ⟨x, hx⟩ : ↥J) : Q)) hσq
    simpa [hσ] using h2
  refine ⟨q, q.2, by simpa using congrArg Subtype.val hq3, ?_, hconj⟩
  obtain ⟨x, hx, hne⟩ := hy1
  refine ⟨x, hx, fun hcomm => hne ?_⟩
  rw [hconj x hx, hcomm, mul_inv_cancel_right]

theorem mem_centerIn_sup_zpowers {J : Subgroup Q}
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6)))
    (hZ : Sec14.Item148PtRes.centerIn J ≤ Subgroup.center Q)
    (hR4 : ∀ E T : Subgroup Q, CFSG.Assembly.IsElemAbelian 3 E → Nat.card E = 81 →
      IsPGroup 2 T → T ≠ ⊥ → E ≤ Subgroup.normalizer (T : Set Q) → False)
    {k z u : Q} (hkJ : k ∈ J) (hk3 : k ^ 3 = 1) (hk1 : ∃ x ∈ J, k * x ≠ x * k)
    (hz : z ∈ Subgroup.centralizer (J : Set Q)) (hz3 : z ^ 3 = 1) (hzJ : z ∉ J)
    (hu : u ∈ Subgroup.centralizer (J : Set Q)) (huz : u * z = z * u) (hu3 : u ^ 3 = 1) :
    u ∈ Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers z := by
  by_contra hunot
  have hcZ := card_centerIn hT
  have hZe := isElemAbelian_centerIn hT hZ
  have hZJ : Sec14.Item148PtRes.centerIn J ≤ J := Sec14.Item148PtRes.centerIn_le J
  have hcomm : ∀ a ∈ Sec14.Item148PtRes.centerIn J, ∀ w : Q, a * w = w * a := fun a ha w =>
    (Subgroup.mem_center_iff.mp (hZ ha) w).symm
  have hzZ : z ∉ Sec14.Item148PtRes.centerIn J := fun h => hzJ (hZJ h)
  obtain ⟨hE₁, hE₁c⟩ := Sec5.isElemAbelian_sup_zpowers (p := 3) hZe hzZ hz3 fun a ha =>
    hcomm a ha z
  have hE₁u : ∀ a ∈ Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers z, a * u = u * a := by
    intro a ha
    have hle : Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers z ≤
        Subgroup.centralizer ({u} : Set Q) := by
      refine sup_le (fun c hc => ?_) (Subgroup.zpowers_le.mpr ?_)
      · exact Subgroup.mem_centralizer_singleton_iff.mpr (hcomm c hc u)
      · exact Subgroup.mem_centralizer_singleton_iff.mpr huz.symm
    exact Subgroup.mem_centralizer_singleton_iff.mp (hle ha)
  obtain ⟨hE₂, hE₂c⟩ := Sec5.isElemAbelian_sup_zpowers (p := 3) hE₁ hunot hu3 hE₁u
  have hE₂J : (Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers z) ⊔ Subgroup.zpowers u ≤
      Subgroup.centralizer (J : Set Q) := by
    refine sup_le (sup_le (fun c hc => ?_) (Subgroup.zpowers_le.mpr hz))
      (Subgroup.zpowers_le.mpr hu)
    exact Subgroup.mem_centralizer_iff.mpr fun h _ => (hcomm c hc h).symm
  have hkE₂ : k ∉ (Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers z) ⊔ Subgroup.zpowers u := by
    intro h
    obtain ⟨x, hx, hne⟩ := hk1
    exact hne (Subgroup.mem_centralizer_iff.mp (hE₂J h) x hx).symm
  obtain ⟨hE, hEc⟩ := Sec5.isElemAbelian_sup_zpowers (p := 3) hE₂ hkE₂ hk3 fun a ha =>
    (Subgroup.mem_centralizer_iff.mp (hE₂J ha) k hkJ).symm
  have hE81 : Nat.card ↥(((Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers z) ⊔
      Subgroup.zpowers u) ⊔ Subgroup.zpowers k : Subgroup Q) = 81 := by
    rw [hEc, hE₂c, hE₁c, hcZ]
  have hk3' : (⟨k, hkJ⟩ : ↥J) ^ 3 = 1 := Subtype.ext (by simpa using hk3)
  have hkZ : (⟨k, hkJ⟩ : ↥J) ∉ Subgroup.center ↥J := by
    intro h
    obtain ⟨x, hx, hne⟩ := hk1
    exact hne (congrArg Subtype.val (Subgroup.mem_center_iff.mp h ⟨x, hx⟩)).symm
  obtain ⟨V, hV2, hV1, hkV⟩ :=
    Sylow155CD.exists_two_subgroup_normalized_of_pow_three hT hk3' hkZ
  have hV'2 : IsPGroup 2 (V.map J.subtype) := hV2.map J.subtype
  have hV'1 : V.map J.subtype ≠ ⊥ := fun h =>
    hV1 ((Subgroup.map_eq_bot_iff_of_injective V J.subtype_injective).mp h)
  have hV'J : V.map J.subtype ≤ J := Subgroup.map_subtype_le V
  have hcent : ∀ g : Q, (∀ x ∈ J, x * g = g * x) →
      g ∈ Subgroup.normalizer ((V.map J.subtype : Subgroup Q) : Set Q) := fun g hg =>
    Subgroup.centralizer_le_normalizer _
      (Subgroup.mem_centralizer_iff.mpr fun h hh => hg h (hV'J hh))
  refine hR4 _ (V.map J.subtype) hE hE81 hV'2 hV'1 ?_
  exact sup_le (fun g hg => hcent g fun x hx => Subgroup.mem_centralizer_iff.mp (hE₂J hg) x hx)
    (Subgroup.zpowers_le.mpr (mem_normalizer_map_subtype hkV))

theorem isPSolvable_of_pow_three_mem {X Z : Subgroup Q}
    (hZX : Z ≤ Subgroup.centralizer (X : Set Q)) (h3 : ∀ x ∈ X, x ^ 3 = 1 → x ∈ Z) :
    CFSG.HallHigman.IsPSolvable 3 ↥X := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨N, hN, hcop, k, hk⟩ := CFSG.Quasithin.Vol2.Ch11.SecS.KF.ito_normalPComplement
    (p := 3) (G := ↥X) (by norm_num) fun x hx3 => by
      rw [Subgroup.mem_center_iff]
      intro w
      apply Subtype.ext
      have hx : (x : Q) ∈ Z := h3 x x.2 (by simpa using congrArg Subtype.val hx3)
      exact Subgroup.mem_centralizer_iff.mp (hZX hx) w w.2
  haveI := hN
  refine isPSolvable_of_normal N (isPSolvable_of_coprime_three hcop.symm)
    (isPSolvable_of_isPGroup_three (IsPGroup.of_card (n := k) ?_))
  rw [← Subgroup.index_eq_card]
  exact hk

theorem isPSolvable_centralizer_inf_normalizer {J : Subgroup Q} (hperf : commutator ↥J = ⊤)
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6)))
    (hZ : Sec14.Item148PtRes.centerIn J ≤ Subgroup.center Q) {y : Q}
    (hyJ : ∀ x ∈ J, y * x * y⁻¹ ∈ J) (hy3 : y ^ 3 = 1) (hy1 : ∃ x ∈ J, y * x * y⁻¹ ≠ x)
    (hX : CFSG.HallHigman.IsPSolvable 3
      ↥(Subgroup.centralizer (J : Set Q) ⊓ Subgroup.centralizer ({y} : Set Q))) :
    CFSG.HallHigman.IsPSolvable 3
      ↥(Subgroup.centralizer ({y} : Set Q) ⊓ Subgroup.normalizer (J : Set Q)) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let H₁ : Subgroup Q := Subgroup.centralizer ({y} : Set Q) ⊓ Subgroup.normalizer (J : Set Q)
  let φ : ↥H₁ →* MulAut ↥J := J.normalizerMonoidHom.comp (Subgroup.inclusion inf_le_right)
  refine isPSolvable_of_hom φ ?_ ?_
  ·
    have hXH : Subgroup.centralizer (J : Set Q) ⊓ Subgroup.centralizer ({y} : Set Q) ≤ H₁ :=
      fun g hg => ⟨hg.2, Subgroup.centralizer_le_normalizer _ hg.1⟩
    refine isPSolvable_of_le (N := (Subgroup.centralizer (J : Set Q) ⊓
      Subgroup.centralizer ({y} : Set Q)).subgroupOf H₁) ?_ ?_
    · exact isPSolvable_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hXH).symm hX
    · intro g hg
      rw [Subgroup.mem_subgroupOf]
      refine ⟨Subgroup.mem_centralizer_iff.mpr fun a ha => ?_, g.2.1⟩
      have h1 := congrArg (fun ψ : MulAut ↥J => ((ψ ⟨a, ha⟩ : ↥J) : Q)) (MonoidHom.mem_ker.mp hg)
      have h2 : (g : Q) * a * (g : Q)⁻¹ = a := h1
      exact (mul_inv_eq_iff_eq_mul.mp h2).symm
  ·
    haveI : Finite ↥φ.range := Finite.of_surjective φ.rangeRestrict φ.rangeRestrict_surjective
    refine isPSolvable_of_isPGroup_three ?_
    rintro ⟨_, g, rfl⟩
    obtain ⟨a, m, hm, hn⟩ :=
      Nat.exists_eq_pow_mul_and_not_dvd (orderOf_pos g).ne' 3 (by norm_num)
    refine ⟨a, Subtype.ext ?_⟩
    show φ g ^ 3 ^ a = 1
    rw [← map_pow]
    have hord : orderOf (g ^ 3 ^ a) = m := by
      rw [orderOf_pow_of_dvd (pow_ne_zero a (by norm_num)) (hn ▸ dvd_mul_right _ _), hn]
      exact Nat.mul_div_cancel_left m (pow_pos (by norm_num) a)
    have hgN : ((g ^ 3 ^ a : ↥H₁) : Q) ∈ Subgroup.normalizer (J : Set Q) := (g ^ 3 ^ a).2.2
    have hcon : ∀ x ∈ J, ((g ^ 3 ^ a : ↥H₁) : Q) * x * ((g ^ 3 ^ a : ↥H₁) : Q)⁻¹ = x := by
      refine Sylow155CD.conj_eq_of_commute_of_pow_three hperf hT (g := ((g ^ 3 ^ a : ↥H₁) : Q))
        (f := y) (fun x hx => (Subgroup.mem_normalizer_iff.mp hgN x).mp hx) hyJ
        (fun z hz => ?_) (Subgroup.mem_centralizer_singleton_iff.mp (g ^ 3 ^ a).2.1) hy3 hy1 ?_
      · rw [Subgroup.mem_center_iff.mp (hZ hz) ((g ^ 3 ^ a : ↥H₁) : Q), mul_inv_cancel_right]
      · rw [Subgroup.orderOf_coe, hord]
        exact hm
    exact MulEquiv.ext fun x => Subtype.ext (hcon x x.2)

theorem conj_mem_of_commute {J : Subgroup Q}
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6)))
    (hZ : Sec14.Item148PtRes.centerIn J ≤ Subgroup.center Q)
    (hR4 : ∀ E T : Subgroup Q, CFSG.Assembly.IsElemAbelian 3 E → Nat.card E = 81 →
      IsPGroup 2 T → T ≠ ⊥ → E ≤ Subgroup.normalizer (T : Set Q) → False)
    {y k : Q} (hkJ : k ∈ J) (hk3 : k ^ 3 = 1) (hk1 : ∃ x ∈ J, k * x ≠ x * k)
    (hyk : y * k = k * y) (hz : y * k⁻¹ ∈ Subgroup.centralizer (J : Set Q))
    (hz3 : (y * k⁻¹) ^ 3 = 1) (hzJ : y * k⁻¹ ∉ J) {h : Q}
    (hh : h ∈ Subgroup.centralizer ({y} : Set Q))
    (hJh : ∀ a ∈ J, ∀ b ∈ J, a * (h * b * h⁻¹) = (h * b * h⁻¹) * a) :
    h⁻¹ * (y * k⁻¹) * h ∈ J := by
  have hZe := isElemAbelian_centerIn hT hZ
  have hZJ : Sec14.Item148PtRes.centerIn J ≤ J := Sec14.Item148PtRes.centerIn_le J
  have hcomm : ∀ a ∈ Sec14.Item148PtRes.centerIn J, ∀ w : Q, a * w = w * a := fun a ha w =>
    (Subgroup.mem_center_iff.mp (hZ ha) w).symm
  have hhy : Commute h y := Subgroup.mem_centralizer_singleton_iff.mp hh
  have hyk' : Commute y k := hyk
  have hu : h * k * h⁻¹ ∈ Subgroup.centralizer (J : Set Q) :=
    Subgroup.mem_centralizer_iff.mpr fun a ha => hJh a ha k hkJ
  have huy : Commute (h * k * h⁻¹) y :=
    ((hhy.symm.mul_right hyk').mul_right hhy.symm.inv_right).symm
  have huk : Commute (h * k * h⁻¹) k := (Subgroup.mem_centralizer_iff.mp hu k hkJ).symm
  have huz : h * k * h⁻¹ * (y * k⁻¹) = (y * k⁻¹) * (h * k * h⁻¹) :=
    huy.mul_right huk.inv_right
  have hu3 : (h * k * h⁻¹) ^ 3 = 1 := by
    rw [conj_pow, hk3]
    simp
  have hmem : h * k * h⁻¹ ∈ Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers (y * k⁻¹) :=
    mem_centerIn_sup_zpowers hT hZ hR4 hkJ hk3 hk1 hz hz3 hzJ hu huz hu3
  have huZ : h * k * h⁻¹ ∉ Sec14.Item148PtRes.centerIn J := by
    intro huZ
    obtain ⟨x, hx, hne⟩ := hk1
    have hku : k = h * k * h⁻¹ := by
      have h1 := hcomm _ huZ h
      calc k = h⁻¹ * (h * k * h⁻¹) * h := by group
        _ = h⁻¹ * ((h * k * h⁻¹) * h) := by rw [mul_assoc]
        _ = h * k * h⁻¹ := by rw [h1, ← mul_assoc, inv_mul_cancel, one_mul]
    exact hne (by rw [hku]; exact hcomm _ huZ x)
  have hzZ : y * k⁻¹ ∉ Sec14.Item148PtRes.centerIn J := fun h => hzJ (hZJ h)
  obtain ⟨-, hEzc⟩ := Sec5.isElemAbelian_sup_zpowers (p := 3) hZe hzZ hz3 fun a ha =>
    hcomm a ha (y * k⁻¹)
  obtain ⟨-, hEuc⟩ := Sec5.isElemAbelian_sup_zpowers (p := 3) hZe huZ hu3 fun a ha =>
    hcomm a ha (h * k * h⁻¹)
  have hle : Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers (h * k * h⁻¹) ≤
      Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers (y * k⁻¹) :=
    sup_le le_sup_left (Subgroup.zpowers_le.mpr hmem)
  have heq := Subgroup.eq_of_le_of_card_ge hle (by rw [hEzc, hEuc])
  have hzmem : y * k⁻¹ ∈ Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers (h * k * h⁻¹) := by
    rw [heq]
    exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
  have hle2 : Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers (h * k * h⁻¹) ≤
      J.comap (MulAut.conj h⁻¹).toMonoidHom := by
    refine sup_le (fun c hc => ?_) (Subgroup.zpowers_le.mpr ?_)
    · have hcJ : c ∈ J := hZJ hc
      have e : h⁻¹ * c * h = c := by
        rw [mul_assoc, hcomm c hc h, ← mul_assoc, inv_mul_cancel, one_mul]
      show h⁻¹ * c * h⁻¹⁻¹ ∈ J
      rw [inv_inv, e]
      exact hcJ
    · show h⁻¹ * (h * k * h⁻¹) * h⁻¹⁻¹ ∈ J
      have e : h⁻¹ * (h * k * h⁻¹) * h⁻¹⁻¹ = k := by group
      rw [e]
      exact hkJ
  have h1 := hle2 hzmem
  have h2 : h⁻¹ * (y * k⁻¹) * h⁻¹⁻¹ ∈ J := h1
  rwa [inv_inv] at h2

theorem sq_mem_normalizer {J : Subgroup Q}
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6)))
    (hZ : Sec14.Item148PtRes.centerIn J ≤ Subgroup.center Q)
    (hcomp : ∀ h : Q, h ∈ Subgroup.normalizer (J : Set Q) ∨
      ∀ a ∈ J, ∀ b ∈ J, a * (h * b * h⁻¹) = (h * b * h⁻¹) * a)
    (hR4 : ∀ E T : Subgroup Q, CFSG.Assembly.IsElemAbelian 3 E → Nat.card E = 81 →
      IsPGroup 2 T → T ≠ ⊥ → E ≤ Subgroup.normalizer (T : Set Q) → False)
    {y k : Q} (hkJ : k ∈ J) (hk3 : k ^ 3 = 1) (hk1 : ∃ x ∈ J, k * x ≠ x * k)
    (hyk : y * k = k * y) (hz : y * k⁻¹ ∈ Subgroup.centralizer (J : Set Q))
    (hz3 : (y * k⁻¹) ^ 3 = 1) (hzJ : y * k⁻¹ ∉ J) {h : Q}
    (hh : h ∈ Subgroup.centralizer ({y} : Set Q)) :
    h ^ 2 ∈ Subgroup.normalizer (J : Set Q) := by
  by_contra hn
  have hhn : h ∉ Subgroup.normalizer (J : Set Q) := fun hh' => hn (Subgroup.pow_mem _ hh' 2)
  have hJh := (hcomp h).resolve_left hhn
  have hJh2 := (hcomp (h ^ 2)).resolve_left hn
  have hh2 : h ^ 2 ∈ Subgroup.centralizer ({y} : Set Q) := Subgroup.pow_mem _ hh 2
  have hw1 := conj_mem_of_commute hT hZ hR4 hkJ hk3 hk1 hyk hz hz3 hzJ hh hJh
  have hw2 := conj_mem_of_commute hT hZ hR4 hkJ hk3 hk1 hyk hz hz3 hzJ hh2 hJh2
  have hc1 : ∀ b ∈ J, b * (h⁻¹ * (y * k⁻¹) * h) = (h⁻¹ * (y * k⁻¹) * h) * b := by
    intro b hb
    have h1 := hJh b hb _ hw2
    have e : h * ((h ^ 2)⁻¹ * (y * k⁻¹) * h ^ 2) * h⁻¹ = h⁻¹ * (y * k⁻¹) * h := by group
    rwa [e] at h1
  have hw1Z : h⁻¹ * (y * k⁻¹) * h ∈ Sec14.Item148PtRes.centerIn J :=
    Sec14.Item148PtRes.mem_centerIn_iff.mpr
      ⟨hw1, Subgroup.mem_center_iff.mpr fun g => Subtype.ext (hc1 g g.2)⟩
  have hw1c := Subgroup.mem_center_iff.mp (hZ hw1Z) h
  have e : y * k⁻¹ = h * (h⁻¹ * (y * k⁻¹) * h) * h⁻¹ := by group
  apply hzJ
  rw [e, hw1c, mul_inv_cancel_right]
  exact hw1

theorem isPSolvable_centralizer {J : Subgroup Q} (hperf : commutator ↥J = ⊤)
    (hT : Sec4.IsTripleCover ↥J (alternatingGroup (Fin 6)))
    (hZ : Sec14.Item148PtRes.centerIn J ≤ Subgroup.center Q)
    (hcomp : ∀ h : Q, h ∈ Subgroup.normalizer (J : Set Q) ∨
      ∀ a ∈ J, ∀ b ∈ J, a * (h * b * h⁻¹) = (h * b * h⁻¹) * a)
    (hR4 : ∀ E T : Subgroup Q, CFSG.Assembly.IsElemAbelian 3 E → Nat.card E = 81 →
      IsPGroup 2 T → T ≠ ⊥ → E ≤ Subgroup.normalizer (T : Set Q) → False)
    {y : Q} (hyJ : ∀ x ∈ J, y * x * y⁻¹ ∈ J) (hy3 : y ^ 3 = 1)
    (hy1 : ∃ x ∈ J, y * x * y⁻¹ ≠ x) (hyJ' : y ∉ J) :
    CFSG.HallHigman.IsPSolvable 3 ↥(Subgroup.centralizer ({y} : Set Q)) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨k, hkJ, hk3, hk1, hkconj⟩ := exists_conj_eq_of_pow_three hperf hT hyJ hy3 hy1
  have hyk : y * k = k * y := by
    have h1 := hkconj k hkJ
    rw [mul_inv_cancel_right] at h1
    exact mul_inv_eq_iff_eq_mul.mp h1
  have hz : y * k⁻¹ ∈ Subgroup.centralizer (J : Set Q) := by
    refine Subgroup.mem_centralizer_iff.mpr fun a ha => ?_
    have hka : k⁻¹ * a * k ∈ J := J.mul_mem (J.mul_mem (J.inv_mem hkJ) ha) hkJ
    have h1 := hkconj _ hka
    have h2 : k * (k⁻¹ * a * k) * k⁻¹ = a := by group
    rw [h2] at h1
    have h3 : y * (k⁻¹ * a * k) = a * y := by
      calc y * (k⁻¹ * a * k) = (y * (k⁻¹ * a * k) * y⁻¹) * y := by group
        _ = a * y := by rw [h1]
    calc a * (y * k⁻¹) = (a * y) * k⁻¹ := by group
      _ = (y * (k⁻¹ * a * k)) * k⁻¹ := by rw [h3]
      _ = (y * k⁻¹) * a := by group
  have hz3 : (y * k⁻¹) ^ 3 = 1 := by
    have hc : Commute y k⁻¹ := (show Commute y k from hyk).inv_right
    rw [hc.mul_pow, hy3, inv_pow, hk3, inv_one, one_mul]
  have hzJ : y * k⁻¹ ∉ J := by
    intro h
    apply hyJ'
    have e : y = (y * k⁻¹) * k := by group
    rw [e]
    exact J.mul_mem h hkJ
  have hzX : ∀ x ∈ Subgroup.centralizer (J : Set Q) ⊓ Subgroup.centralizer ({y} : Set Q),
      x * (y * k⁻¹) = (y * k⁻¹) * x := by
    intro x hx
    have hxk : Commute x k := (Subgroup.mem_centralizer_iff.mp hx.1 k hkJ).symm
    have hxy : Commute x y := Subgroup.mem_centralizer_singleton_iff.mp hx.2
    exact hxy.mul_right hxk.inv_right
  have hXsolv : CFSG.HallHigman.IsPSolvable 3
      ↥(Subgroup.centralizer (J : Set Q) ⊓ Subgroup.centralizer ({y} : Set Q)) := by
    refine isPSolvable_of_pow_three_mem
      (Z := Sec14.Item148PtRes.centerIn J ⊔ Subgroup.zpowers (y * k⁻¹)) ?_ ?_
    · refine sup_le (fun c hc => ?_) (Subgroup.zpowers_le.mpr ?_)
      · exact Subgroup.mem_centralizer_iff.mpr fun x _ => Subgroup.mem_center_iff.mp (hZ hc) x
      · exact Subgroup.mem_centralizer_iff.mpr fun x hx => hzX x hx
    · intro x hx hx3
      exact mem_centerIn_sup_zpowers hT hZ hR4 hkJ hk3 hk1 hz hz3 hzJ hx.1 (hzX x hx) hx3
  have hH₁ := isPSolvable_centralizer_inf_normalizer hperf hT hZ hyJ hy3 hy1 hXsolv
  have hsq : ∀ w ∈ Subgroup.centralizer ({y} : Set Q), w ^ 2 ∈ Subgroup.normalizer (J : Set Q) :=
    fun w hw => sq_mem_normalizer hT hZ hcomp hR4 hkJ hk3 hk1 hyk hz hz3 hzJ hw
  set C : Subgroup Q := Subgroup.centralizer ({y} : Set Q)
  set H₁ : Subgroup Q := C ⊓ Subgroup.normalizer (J : Set Q)
  have hnorm : (H₁.subgroupOf C).Normal := by
    refine ⟨fun g hg w => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hg ⊢
    have hwg : (w : Q) * g ∈ C := C.mul_mem w.2 g.2
    have hsq1 : ((w : Q) * g) ^ 2 ∈ H₁ := ⟨Subgroup.pow_mem _ hwg 2, hsq _ hwg⟩
    have hsq2 : ((w : Q)⁻¹) ^ 2 ∈ H₁ :=
      ⟨Subgroup.pow_mem _ (C.inv_mem w.2) 2, hsq _ (C.inv_mem w.2)⟩
    have e : ((w * g * w⁻¹ : ↥C) : Q) = ((w : Q) * g) ^ 2 * (g : Q)⁻¹ * ((w : Q)⁻¹) ^ 2 := by
      push_cast
      simp only [pow_two]
      group
    rw [e]
    exact H₁.mul_mem (H₁.mul_mem hsq1 (H₁.inv_mem hg)) hsq2
  haveI := hnorm
  have hQ2 : IsPGroup 2 (↥C ⧸ H₁.subgroupOf C) := by
    intro x
    refine ⟨1, ?_⟩
    induction x using QuotientGroup.induction_on with
    | H w =>
      show (w : ↥C ⧸ H₁.subgroupOf C) ^ 2 = 1
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
      exact ⟨Subgroup.pow_mem _ w.2 2, hsq _ w.2⟩
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hQ2
  have hcop : Nat.Coprime 3 (Nat.card (↥C ⧸ H₁.subgroupOf C)) := by
    rw [hn]
    exact Nat.Coprime.pow_right n (by norm_num)
  exact isPSolvable_of_normal (H₁.subgroupOf C)
    (isPSolvable_of_mulEquiv (Subgroup.subgroupOfEquivOfLe inf_le_left).symm hH₁)
    (isPSolvable_of_coprime_three hcop)

theorem isPConstrained_of_isPSolvable {M : Type} [Group M] [Finite M]
    (h : CFSG.HallHigman.IsPSolvable 3 M) : CFSG.ABGLocalTools.IsPConstrained 3 M := by
  by_contra hM
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨Y, hY⟩ := Sylow155T51.exists_isComponent_of_not_isPConstrained hM
  have h3 : 3 ∣ Nat.card Y :=
    Sylow155T51.three_dvd_card_of_isComponent
      (CFSG.pPrimeCore_quotient_eq_bot Nat.prime_three) hY
  have hq : CFSG.Open.IsQuasisimple ↥Y := ⟨(Group.isPerfect_def (G := _)).1 hY.1.1, hY.1.2.1⟩
  have hsolv : CFSG.HallHigman.IsPSolvable 3 (M ⧸ CFSG.pPrimeCore 3 M) :=
    CFSG.LocalAnalysis.RankThreeTheoremC.RankOneCent.isPSolvable_of_surjective
      (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _) h
  have hsolvY : CFSG.HallHigman.IsPSolvable 3 ↥Y :=
    isPSolvable_of_le (isPSolvable_of_mulEquiv Subgroup.topEquiv.symm hsolv) le_top
  exact CFSG.LocalAnalysis.RankThreeTheoremC.RankOneCent.not_isPSolvable_of_isQuasisimple
    hq h3 hsolvY

theorem isPSolvable_of_le_centralizer_map {M : Type} [Group M] [Finite M] {N : Subgroup M}
    [N.Normal] (hN : ¬ 3 ∣ Nat.card N) {y : M}
    (h : CFSG.HallHigman.IsPSolvable 3
      ↥(Subgroup.centralizer ({QuotientGroup.mk' N y} : Set (M ⧸ N))))
    {H : Subgroup M} (hH : H ≤ Subgroup.centralizer ({y} : Set M)) :
    CFSG.HallHigman.IsPSolvable 3 ↥H := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let f : ↥H →* M ⧸ N := (QuotientGroup.mk' N).comp H.subtype
  have hker : CFSG.HallHigman.IsPSolvable 3 ↥f.ker := by
    refine isPSolvable_of_coprime_three ?_
    let g : ↥f.ker →* N := (H.subtype.comp f.ker.subtype).codRestrict N fun x => by
      have hx := x.2
      rwa [MonoidHom.mem_ker, MonoidHom.comp_apply, Subgroup.coe_subtype, QuotientGroup.mk'_apply,
        QuotientGroup.eq_one_iff] at hx
    have hg : Function.Injective g := by
      intro a b hab
      have h1 : ((g a : ↥N) : M) = ((g b : ↥N) : M) := congrArg Subtype.val hab
      exact Subtype.ext (Subtype.ext h1)
    exact Nat.Coprime.coprime_dvd_right (Subgroup.card_dvd_of_injective g hg)
      ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr hN)
  have him : CFSG.HallHigman.IsPSolvable 3 ↥f.range := by
    refine isPSolvable_of_le h ?_
    rintro _ ⟨x, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hx := Subgroup.mem_centralizer_singleton_iff.mp (hH x.2)
    show (QuotientGroup.mk' N) (x : M) * (QuotientGroup.mk' N) y =
      (QuotientGroup.mk' N) y * (QuotientGroup.mk' N) (x : M)
    rw [← map_mul, ← map_mul, hx]
  exact isPSolvable_of_hom f hker him

