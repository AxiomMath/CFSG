theorem mem_normalizer_zpowers {H : Type*} [Group H] [Finite H] {t n : H}
    (h : n * t * n⁻¹ ∈ Subgroup.zpowers t) :
    n ∈ Subgroup.normalizer (Subgroup.zpowers t : Set H) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  have hle : (Subgroup.zpowers t).map (MulAut.conj n).toMonoidHom ≤ Subgroup.zpowers t := by
    rw [MonoidHom.map_zpowers]
    exact Subgroup.zpowers_le.mpr h
  exact Subgroup.eq_of_le_of_card_ge hle
    (Subgroup.card_map_of_injective (MulAut.conj n).injective).ge

abbrev InnerOn (A M X : Subgroup G) : Prop :=
  ∀ d ∈ pPrimeCoreOf 3 (Subgroup.centralizer (A : Set G)) ⊓ M, ∃ y ∈ w155 A M X,
    ∀ w ∈ w155 A M X, (y⁻¹ * d) * w * (y⁻¹ * d)⁻¹ * w⁻¹ ∈ pPrimeCoreOf 3 M

section Sign

variable {A X K Y M T : Subgroup G} [((pPrimeCoreOf 3 M).subgroupOf (w155 A M X)).Normal]
  {n : ℕ}
  (φ : ↥(w155 A M X) ⧸ (pPrimeCoreOf 3 M).subgroupOf (w155 A M X) ≃* alternatingGroup (Fin n))
  (autE : Perm (Fin n) ≃* MulAut (alternatingGroup (Fin n)))

noncomputable abbrev evenPart (A M X : Subgroup G)
    [((pPrimeCoreOf 3 M).subgroupOf (w155 A M X)).Normal]
    (φ : ↥(w155 A M X) ⧸ (pPrimeCoreOf 3 M).subgroupOf (w155 A M X) ≃* alternatingGroup (Fin n))
    (autE : Perm (Fin n) ≃* MulAut (alternatingGroup (Fin n))) : Subgroup G :=
  ((alternatingGroup (Fin n)).comap (rho φ autE)).map
    (nWK (w155 A M X) (pPrimeCoreOf 3 M)).subtype

theorem mem_evenPart_iff {x : G} :
    x ∈ evenPart A M X φ autE ↔ ∃ hx : x ∈ nWK (w155 A M X) (pPrimeCoreOf 3 M),
      rho φ autE ⟨x, hx⟩ ∈ alternatingGroup (Fin n) := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.2, hy⟩
  · rintro ⟨hx, h⟩
    exact ⟨⟨x, hx⟩, h, rfl⟩

theorem conj_mem_evenPart {g : G} (hg : g ∈ nWK (w155 A M X) (pPrimeCoreOf 3 M)) {x : G}
    (hx : x ∈ evenPart A M X φ autE) : g * x * g⁻¹ ∈ evenPart A M X φ autE := by
  obtain ⟨hxn, hρ⟩ := (mem_evenPart_iff φ autE).mp hx
  have hgx := (nWK (w155 A M X) (pPrimeCoreOf 3 M)).mul_mem
    ((nWK (w155 A M X) (pPrimeCoreOf 3 M)).mul_mem hg hxn)
    ((nWK (w155 A M X) (pPrimeCoreOf 3 M)).inv_mem hg)
  refine (mem_evenPart_iff φ autE).mpr ⟨hgx, ?_⟩
  have e : (⟨g * x * g⁻¹, hgx⟩ : ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))) =
      ⟨g, hg⟩ * ⟨x, hxn⟩ * (⟨g, hg⟩)⁻¹ := Subtype.ext rfl
  rw [e, map_mul, map_mul, map_inv]
  exact (inferInstance : (alternatingGroup (Fin n)).Normal).conj_mem _ hρ _

theorem rho_mem_alternatingGroup_of_mem_scriptQ (hautE : ∀ σ, autE σ = MulAut.conjNormal σ)
    {c : G} {L : Subgroup G} (h : Sec14Std G A c L) (hC : Ctx155 A X K Y M T)
    (hIX : delta A (lB A) M ≤ Subgroup.normalizer (X : Set G)) (hNO : InnerOn A M X)
    {V : Subgroup G} (hV : V ∈ scriptQ A (lB A)) (hVM : V ≤ M) {v : G} (hv : v ∈ V) :
    rho φ autE ⟨v, delta_le_nWK hIX (le_delta hV hVM hv)⟩ ∈ alternatingGroup (Fin n) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hAF : A ∈ partTwoF G := h.mem_partTwoF
  have hA3 : IsPGroup 3 ↥A := fun a => ⟨1, Subtype.ext (by simpa using hAF.1.2 a a.2)⟩
  have hVn : V ≤ nWK (w155 A M X) (pPrimeCoreOf 3 M) := (le_delta hV hVM).trans (delta_le_nWK hIX)
  have hAn := a_le_nWK hC
  have hAV : A ≤ Subgroup.normalizer (V : Set G) := hV.1.2.2
  have hV3 : ¬ 3 ∣ Nat.card V := (isPiSubgroup_piCompl_iff Nat.prime_three _).mp hV.1.2.1
  have hAL : A ≤ Subgroup.normalizer (evenPart A M X φ autE : Set G) := by
    intro a ha
    rw [Subgroup.mem_normalizer_iff]
    intro x
    refine ⟨fun hx => conj_mem_evenPart φ autE (hAn ha) hx, fun hx => ?_⟩
    have h1 := conj_mem_evenPart φ autE ((nWK (w155 A M X) (pPrimeCoreOf 3 M)).inv_mem (hAn ha)) hx
    have e : a⁻¹ * (a * x * a⁻¹) * a⁻¹⁻¹ = x := by group
    rwa [e] at h1
  have hcop : ¬ 3 ∣ Nat.card ↥(V ⊓ evenPart A M X φ autE) := fun h3 =>
    hV3 (h3.trans (Subgroup.card_dvd_of_le inf_le_left))
  have hfix : ∀ a ∈ A, a * v * a⁻¹ * v⁻¹ ∈ evenPart A M X φ autE := by
    intro a ha
    have hvn := hVn hv
    have hmem : a * v * a⁻¹ * v⁻¹ ∈ nWK (w155 A M X) (pPrimeCoreOf 3 M) :=
      (nWK _ _).mul_mem ((nWK _ _).mul_mem ((nWK _ _).mul_mem (hAn ha) hvn)
        ((nWK _ _).inv_mem (hAn ha))) ((nWK _ _).inv_mem hvn)
    refine (mem_evenPart_iff φ autE).mpr ⟨hmem, ?_⟩
    have e : (⟨a * v * a⁻¹ * v⁻¹, hmem⟩ : ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))) =
        ⟨a, hAn ha⟩ * ⟨v, hvn⟩ * (⟨a, hAn ha⟩)⁻¹ * (⟨v, hvn⟩)⁻¹ := Subtype.ext rfl
    rw [e, Perm.mem_alternatingGroup, map_mul, map_mul, map_mul, map_inv, map_inv, map_mul,
      map_mul, map_mul, map_inv, map_inv]
    exact mul_inv_eq_one.mpr (mul_inv_eq_iff_eq_mul.mpr (mul_comm _ _))
  obtain ⟨c', hc'V, hc'A, hc'v⟩ := Sylow155G.exists_fixed_mul_inv_mem hA3 hAV hAL hcop hv hfix
  have hc'C : c' ∈ Subgroup.centralizer (A : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    have h1 := hc'A a ha
    calc a * c' = a * c' * a⁻¹ * a := by group
      _ = c' * a := by rw [h1]
  have hc'D : c' ∈ pPrimeCoreOf 3 (Subgroup.centralizer (A : Set G)) ⊓ M :=
    ⟨inf_centralizer_le_xA (Sec14Std.maximal_isElemAbelian h) hV3 ⟨hc'V, hc'C⟩, hVM hc'V⟩
  obtain ⟨y, hyW, hy⟩ := hNO c' hc'D
  have hρc : rho φ autE ⟨c', hVn hc'V⟩ =
      rho φ autE ⟨y, mem_nWK (w155_le_normalizer A M X) hyW⟩ :=
    rho_eq_rho_of_forall φ autE (w155_le_normalizer A M X) _ hyW hy
  have hc'even : rho φ autE ⟨c', hVn hc'V⟩ ∈ alternatingGroup (Fin n) := by
    rw [hρc]
    exact rho_mem_alternatingGroup φ autE hautE (w155_le_normalizer A M X) y hyW
  obtain ⟨hcvn, hcv⟩ := (mem_evenPart_iff φ autE).mp hc'v
  have e : (⟨c' * v⁻¹, hcvn⟩ : ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))) =
      ⟨c', hVn hc'V⟩ * (⟨v, hVn hv⟩)⁻¹ := Subtype.ext rfl
  rw [e, map_mul, map_inv] at hcv
  have e2 : rho φ autE ⟨v, hVn hv⟩ = (rho φ autE ⟨c', hVn hc'V⟩ *
      (rho φ autE ⟨v, hVn hv⟩)⁻¹)⁻¹ * rho φ autE ⟨c', hVn hc'V⟩ := by group
  change rho φ autE ⟨v, hVn hv⟩ ∈ alternatingGroup (Fin n)
  rw [e2]
  exact (alternatingGroup (Fin n)).mul_mem ((alternatingGroup (Fin n)).inv_mem hcv) hc'even

theorem rho_mem_normalizer {H : Subgroup G} {g : ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))}
    (hg : (g : G) ∈ Subgroup.normalizer (H : Set G)) :
    rho φ autE g ∈ Subgroup.normalizer
      (((H.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M))).map (rho φ autE) :
        Subgroup (Perm (Fin n))) : Set (Perm (Fin n))) := by
  have hg' : g ∈ Subgroup.normalizer
      ((H.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M)) :
        Subgroup ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))) :
        Set ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))) :=
    Subgroup.mem_normalizer_iff.mpr fun x => Subgroup.mem_normalizer_iff.mp hg x
  exact Subgroup.le_normalizer_map (rho φ autE) (Subgroup.mem_map_of_mem _ hg')

theorem not_dvd_card_map {H : Subgroup G} (hH : H ≤ nWK (w155 A M X) (pPrimeCoreOf 3 M))
    (hH3 : ¬ 3 ∣ Nat.card H) :
    ¬ 3 ∣ Nat.card ↥((H.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M))).map (rho φ autE)) :=
  fun h3 => hH3 ((h3.trans (Subgroup.card_map_dvd _ _)).trans
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hH).toEquiv).dvd)

end Sign

section Five

variable {A X K Y M T P : Subgroup G} [((pPrimeCoreOf 3 M).subgroupOf (w155 A M X)).Normal]
  (φ : ↥(w155 A M X) ⧸ (pPrimeCoreOf 3 M).subgroupOf (w155 A M X) ≃* alternatingGroup (Fin 5))
  (autE : Perm (Fin 5) ≃* MulAut (alternatingGroup (Fin 5)))

noncomputable abbrev rhoA : Subgroup (Perm (Fin 5)) :=
  (A.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M))).map (rho φ autE)

theorem exists_rhoA_eq (hautE : ∀ σ, autE σ = MulAut.conjNormal σ) {c : G} {L : Subgroup G}
    (h : Sec14Std G A c L) (hC : Ctx155 A X K Y M T) :
    ∃ t ∈ alternatingGroup (Fin 5), orderOf t = 3 ∧ rhoA φ autE = Subgroup.zpowers t ∧
      ∀ z ∈ Subgroup.zpowers t, ∃ (a₀ : G) (ha₀ : a₀ ∈ A ⊓ w155 A M X),
        rho φ autE ⟨a₀, mem_nWK (w155_le_normalizer A M X) ha₀.2⟩ = z := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hAF : A ∈ partTwoF G := h.mem_partTwoF
  have hA3 : IsPGroup 3 ↥A := fun a => ⟨1, Subtype.ext (by simpa using hAF.1.2 a a.2)⟩
  have hAn := a_le_nWK hC
  have hAW : A ≤ Subgroup.normalizer (w155 A M X : Set G) := fun a ha => (hAn ha).1
  have hAK : A ≤ Subgroup.normalizer (pPrimeCoreOf 3 M : Set G) := fun a ha => (hAn ha).2
  have hK : ¬ 3 ∣ Nat.card (pPrimeCoreOf 3 M) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp (coprime_card_pPrimeCoreOf 3 M)
  have hWK := w155_le_normalizer A M X
  have hlift : ∀ {z : Perm (Fin 5)}, z ^ 3 = 1 → (∀ (a : G) (ha : a ∈ A),
      rho φ autE ⟨a, hAW ha, hAK ha⟩ * z = z * rho φ autE ⟨a, hAW ha, hAK ha⟩) →
      ∃ (a₀ : G) (ha₀ : a₀ ∈ A ⊓ w155 A M X), rho φ autE ⟨a₀, mem_nWK hWK ha₀.2⟩ = z :=
    fun hz3 hzA => exists_mem_inf_rho_eq φ autE hautE hAF hAW hAK hWK hK hz3 hzA
  have hAρ : IsPGroup 3 ↥(rhoA φ autE) :=
    (hA3.comap_of_injective _ Subtype.coe_injective).map _
  obtain ⟨a, ha, hρa⟩ : ∃ (a : G) (ha : a ∈ A), rho φ autE ⟨a, hAn ha⟩ ≠ 1 := by
    by_contra hcon
    push Not at hcon
    obtain ⟨a₀, ha₀, hρa₀⟩ := hlift (z := swap 0 1 * swap 1 2) (by decide) fun a ha => by
      rw [show rho φ autE ⟨a, hAW ha, hAK ha⟩ = 1 from hcon a ha, one_mul, mul_one]
    rw [hcon a₀ ha₀.1] at hρa₀
    exact absurd hρa₀.symm (by decide)
  have hta : rho φ autE ⟨a, hAn ha⟩ ∈ rhoA φ autE :=
    Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr ha)
  obtain ⟨hAt, ht3⟩ := Sylow155A5.eq_zpowers_of_isPGroup_three hAρ hta hρa
  set t := rho φ autE ⟨a, hAn ha⟩ with htdef
  have htpow : t ^ 3 = 1 := by
    rw [← ht3]
    exact pow_orderOf_eq_one t
  refine ⟨t, Sylow155A5.mem_alternatingGroup_of_pow_three htpow, ht3, hAt, fun z hz => ?_⟩
  refine hlift ?_ fun b hb => ?_
  · exact orderOf_dvd_iff_pow_eq_one.mp ((orderOf_dvd_of_mem_zpowers hz).trans ht3.dvd)
  · have hb' : rho φ autE ⟨b, hAW hb, hAK hb⟩ ∈ Subgroup.zpowers t := by
      rw [← hAt]
      exact Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr hb)
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hb'
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp hz
    rw [← hi, ← hj]
    exact (Commute.zpow_zpow_self t i j).eq

theorem exists_mem_normalizer_rho_eq (hautE : ∀ σ, autE σ = MulAut.conjNormal σ) {c : G}
    {L : Subgroup G} (h : Sec14Std G A c L) (hC : Ctx155 A X K Y M T) {t : Perm (Fin 5)}
    (hAt : rhoA φ autE = Subgroup.zpowers t)
    (htW : ∀ z ∈ Subgroup.zpowers t, ∃ (a₀ : G) (ha₀ : a₀ ∈ A ⊓ w155 A M X),
      rho φ autE ⟨a₀, mem_nWK (w155_le_normalizer A M X) ha₀.2⟩ = z)
    {m : Perm (Fin 5)} (hm : m ∈ alternatingGroup (Fin 5))
    (hmt : m ∈ Subgroup.normalizer (Subgroup.zpowers t : Set (Perm (Fin 5)))) :
    ∃ (w : G) (hw : w ∈ w155 A M X), w ∈ Subgroup.normalizer (A : Set G) ∧
      rho φ autE ⟨w, mem_nWK (w155_le_normalizer A M X) hw⟩ = m := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hAF : A ∈ partTwoF G := h.mem_partTwoF
  have hA3 : IsPGroup 3 ↥A := fun a => ⟨1, Subtype.ext (by simpa using hAF.1.2 a a.2)⟩
  have hAn := a_le_nWK hC
  have hWK := w155_le_normalizer A M X
  set W := w155 A M X with hWdef
  set K' := pPrimeCoreOf 3 M with hK'def
  have hK : ¬ 3 ∣ Nat.card K' :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp (coprime_card_pPrimeCoreOf 3 M)
  have hρK : ∀ (k : G) (hk : k ∈ W), k ∈ K' → rho φ autE ⟨k, mem_nWK hWK hk⟩ = 1 :=
    fun k hk hkK => (rho_eq_one_iff φ autE hautE hWK k hk).mpr hkK
  obtain ⟨j, hjW, hρj⟩ := exists_rho_eq φ autE hautE hWK hm
  set J : Subgroup G := W ⊓ ((Subgroup.normalizer (Subgroup.zpowers t : Set (Perm (Fin 5)))).comap
    (rho φ autE)).map (nWK W K').subtype with hJdef
  have hJmem : ∀ {x : G} (hx : x ∈ W), rho φ autE ⟨x, mem_nWK hWK hx⟩ ∈
      Subgroup.normalizer (Subgroup.zpowers t : Set (Perm (Fin 5))) → x ∈ J :=
    fun {x} hx hρx => ⟨hx, ⟨x, mem_nWK hWK hx⟩, hρx, rfl⟩
  have hN : ¬ 3 ∣ Nat.card ↥(K' ⊓ W) := fun h3 =>
    hK (h3.trans (Subgroup.card_dvd_of_le inf_le_left))
  have hNJ : K' ⊓ W ≤ J := fun k hk => hJmem hk.2 (by rw [hρK k hk.2 hk.1]; exact one_mem _)
  have hAN : A ≤ Subgroup.normalizer ((K' ⊓ W : Subgroup G) : Set G) :=
    (le_inf (fun a ha => (hAn ha).2) fun a ha => (hAn ha).1).trans
      Subgroup.inf_normalizer_le_normalizer_inf
  have hJN : J ≤ Subgroup.normalizer ((K' ⊓ W : Subgroup G) : Set G) :=
    (inf_le_left.trans (le_inf hWK Subgroup.le_normalizer)).trans
      Subgroup.inf_normalizer_le_normalizer_inf
  have hJA : ∀ j' ∈ J, ∀ a ∈ A, ∃ k ∈ K' ⊓ W, ∃ a' ∈ A, j' * a * j'⁻¹ = k * a' := by
    rintro j' ⟨hj'W, ⟨j'', hj''N, hj''⟩⟩ a ha
    have hj'n : j' ∈ nWK W K' := mem_nWK hWK hj'W
    have hρj' : rho φ autE ⟨j', hj'n⟩ ∈
        Subgroup.normalizer (Subgroup.zpowers t : Set (Perm (Fin 5))) := by
      have e : (⟨j', hj'n⟩ : ↥(nWK W K')) = j'' := Subtype.ext hj''.symm
      rw [e]
      exact hj''N
    have hρa : rho φ autE ⟨a, hAn ha⟩ ∈ Subgroup.zpowers t := by
      rw [← hAt]
      exact Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr ha)
    have haW : a * j'⁻¹ * a⁻¹ ∈ W :=
      (Subgroup.mem_normalizer_iff.mp (hAn ha).1 _).mp (W.inv_mem hj'W)
    have hxW : j' * a * j'⁻¹ * a⁻¹ ∈ W := by
      have e : j' * a * j'⁻¹ * a⁻¹ = j' * (a * j'⁻¹ * a⁻¹) := by group
      rw [e]
      exact W.mul_mem hj'W haW
    have hρx : rho φ autE ⟨j' * a * j'⁻¹ * a⁻¹, mem_nWK hWK hxW⟩ ∈ Subgroup.zpowers t := by
      have e : (⟨j' * a * j'⁻¹ * a⁻¹, mem_nWK hWK hxW⟩ : ↥(nWK W K')) =
          ⟨j', hj'n⟩ * ⟨a, hAn ha⟩ * (⟨j', hj'n⟩)⁻¹ * (⟨a, hAn ha⟩)⁻¹ := Subtype.ext rfl
      rw [e, map_mul, map_inv]
      refine (Subgroup.zpowers t).mul_mem ?_ ((Subgroup.zpowers t).inv_mem hρa)
      rw [map_mul, map_mul, map_inv]
      exact (Subgroup.mem_normalizer_iff.mp hρj' _).mp hρa
    obtain ⟨a₀, ha₀, hρa₀⟩ := htW _ hρx
    have hkW : j' * a * j'⁻¹ * a⁻¹ * a₀⁻¹ ∈ W := W.mul_mem hxW (W.inv_mem ha₀.2)
    have hkK : j' * a * j'⁻¹ * a⁻¹ * a₀⁻¹ ∈ K' := by
      refine (rho_eq_one_iff φ autE hautE hWK _ hkW).mp ?_
      have e : (⟨j' * a * j'⁻¹ * a⁻¹ * a₀⁻¹, mem_nWK hWK hkW⟩ : ↥(nWK W K')) =
          ⟨j' * a * j'⁻¹ * a⁻¹, mem_nWK hWK hxW⟩ * (⟨a₀, mem_nWK hWK ha₀.2⟩)⁻¹ :=
        Subtype.ext rfl
      rw [e, map_mul, map_inv, hρa₀, mul_inv_cancel]
    refine ⟨_, ⟨hkK, hkW⟩, a₀ * a, A.mul_mem ha₀.1 ha, ?_⟩
    group
  obtain ⟨k, hkN, hkj⟩ := Sylow155G.exists_mul_mem_normalizer hA3 hN hNJ hAN hJN hJA
    (hJmem hjW (by rw [hρj]; exact hmt))
  have hkjW : k * j ∈ W := W.mul_mem hkN.2 hjW
  refine ⟨k * j, hkjW, hkj, ?_⟩
  have e : (⟨k * j, mem_nWK hWK hkjW⟩ : ↥(nWK W K')) =
      ⟨k, mem_nWK hWK hkN.2⟩ * ⟨j, mem_nWK hWK hjW⟩ := Subtype.ext rfl
  rw [e, map_mul, hρK k hkN.2 hkN.1, one_mul, hρj]

include φ in
theorem exists_conj_le_normalizer (hautE : ∀ σ, autE σ = MulAut.conjNormal σ) {c : G}
    {L : Subgroup G} (h : Sec14Std G A c L) (hC : Ctx155 A X K Y M T) (hE : End155N A X K Y M T P)
    (hRP : CFSG.Open.pCoreOf 2 Y ≤ P) (hIX : delta A (lB A) M ≤ Subgroup.normalizer (X : Set G))
    (hf : Proof155Wx.Facts155W A X Y M P) (hBXW : b155 A M X ≤ X ⊔ w155 A M X)
    (hBN : b155 A M X ≤ n155 A K) (hNO : InnerOn A M X) {V : Subgroup G}
    (hV : V ∈ scriptQ A (lB A)) (hVM : V ≤ M) :
    ∃ w ∈ n155 A K, w ∈ Subgroup.normalizer (A : Set G) ∧
      V.map (MulAut.conj w).toMonoidHom ≤ Subgroup.normalizer
        ((CFSG.Open.pCoreOf 2 Y ⊔ pPrimeCoreOf 3 (u155 A M X) : Subgroup G) : Set G) := by
  obtain ⟨t, htA5, ht3, hAt, htW⟩ := exists_rhoA_eq φ autE hautE h hC
  have hP𝓠 : P ∈ scriptQ A (lB A) := hE.mem_p.prop.1.1
  have hR𝓠 : CFSG.Open.pCoreOf 2 Y ∈ scriptQ A (lB A) :=
    mem_scriptQ_of_le hP𝓠 hRP (Sylow155B1.le_normalizer_r hC)
  have hRM : CFSG.Open.pCoreOf 2 Y ≤ M := hRP.trans (hE.mem_p.prop.1.2.trans inf_le_left)
  have hn : ∀ {Q : Subgroup G}, Q ∈ scriptQ A (lB A) → Q ≤ M →
      Q ≤ nWK (w155 A M X) (pPrimeCoreOf 3 M) := fun hQ hQM =>
    (le_delta hQ hQM).trans (delta_le_nWK hIX)
  have hA5 : ∀ {Q : Subgroup G}, Q ∈ scriptQ A (lB A) → Q ≤ M →
      (Q.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M))).map (rho φ autE) ≤
        alternatingGroup (Fin 5) := by
    rintro Q hQ hQM _ ⟨⟨q, hqn⟩, hq, rfl⟩
    exact rho_mem_alternatingGroup_of_mem_scriptQ φ autE hautE h hC hIX hNO hQ hQM
      (Subgroup.mem_subgroupOf.mp hq)
  have h3 : ∀ {Q : Subgroup G}, Q ∈ scriptQ A (lB A) → Q ≤ M →
      ¬ 3 ∣ Nat.card ↥((Q.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M))).map (rho φ autE)) :=
    fun hQ hQM => not_dvd_card_map φ autE (hn hQ hQM)
      ((isPiSubgroup_piCompl_iff Nat.prime_three _).mp hQ.1.2.1)
  have htN : ∀ {Q : Subgroup G}, A ≤ Subgroup.normalizer (Q : Set G) →
      t ∈ Subgroup.normalizer
        ((((Q.subgroupOf (nWK (w155 A M X) (pPrimeCoreOf 3 M))).map (rho φ autE)) :
          Subgroup (Perm (Fin 5))) : Set (Perm (Fin 5))) := by
    intro Q hAQ
    have ht : t ∈ rhoA φ autE := by
      rw [hAt]
      exact Subgroup.mem_zpowers t
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp ht
    exact rho_mem_normalizer φ autE (hAQ (Subgroup.mem_subgroupOf.mp ha))
  obtain ⟨m, hmA5, hmt, hmV⟩ := Sylow155A5.exists_swap htA5 ht3 (hA5 hR𝓠 hRM) (hA5 hV hVM)
    (h3 hR𝓠 hRM) (h3 hV hVM) (htN (Sylow155B1.le_normalizer_r hC)) (htN hV.1.2.2)
  obtain ⟨w, hwW, hwA, hρw⟩ := exists_mem_normalizer_rho_eq φ autE hautE h hC hAt htW hmA5
    (mem_normalizer_zpowers hmt)
  have hWB : w155 A M X ≤ b155 A M X := Subgroup.map_subtype_le _
  refine ⟨w, hBN (hWB hwW), hwA, ?_⟩
  rintro _ ⟨v, hv, rfl⟩
  have hvI : v ∈ delta A (lB A) M := le_delta hV hVM hv
  have hwI : w ∈ delta A (lB A) M := ((Proof155Wx.w155_le_u155 A M X).trans inf_le_left) hwW
  have hgI : w * v * w⁻¹ ∈ delta A (lB A) M :=
    (delta A (lB A) M).mul_mem ((delta A (lB A) M).mul_mem hwI hvI) ((delta A (lB A) M).inv_mem hwI)
  change w * v * w⁻¹ ∈ _
  refine mem_normalizer_sup φ autE hautE hE hRP hIX hf hBXW hgI ?_
  have hwn := delta_le_nWK hIX hwI
  have hvn := delta_le_nWK hIX hvI
  have e : (⟨w * v * w⁻¹, delta_le_nWK hIX hgI⟩ : ↥(nWK (w155 A M X) (pPrimeCoreOf 3 M))) =
      ⟨w, hwn⟩ * ⟨v, hvn⟩ * (⟨w, hwn⟩)⁻¹ := Subtype.ext rfl
  have hρw' : rho φ autE ⟨w, hwn⟩ = m := hρw
  rw [e, map_mul, map_mul, map_inv, hρw']
  exact hmV ⟨rho φ autE ⟨v, hvn⟩, Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr hv), rfl⟩

end Five

