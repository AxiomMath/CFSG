theorem noY2_of_U35_at (h135 : Item135Simple) (h142 : Concl142R) (h152 : Item152 A (lB A))
    (hgen : KS1517Gen) (h : Sec15R G A c L) [Fact (Nat.Prime 5)]
    (φU : ↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* CFSG.Assembly.RankThreeEven.projSU 3 5 1)
    (hprod : Nonempty (lBarA c L A ≃* Multiplicative (ZMod 3) × Sec12.lBar c L))
    (hno : ∀ Y₀ ∈ scriptY0Star A (lB A), ¬ L ≤ Y₀) : ∀ X ∈ scriptY2 A, ¬ L ≤ X := by
  intro X hX hLX
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hL4 := mem_scriptY4_L_of_U35 h135 h142 hgen h φU hprod
  set M := Subgroup.normalizer (CFSG.Open.pCoreOf 2 X : Set G) with hM
  have hM2 : M ∈ scriptY2 A :=
    Sec16.normalizer_pCoreOf_mem_scriptY2 h.isSimpleGroup h.nonabelian hX
  have hLM : L ≤ M := hLX.trans (Subgroup.le_normalizer.trans
    (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 X))
  have hloc := CFSG.CGT.PushingUp.isPLocal_normalizer_of_isPGroup
    (CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) X) hX.2
  have hF : generalizedFitting ↥M = CFSG.pCore 2 ↥M :=
    (isCharacteristicP_iff_generalizedFitting_eq_pCore ↥M 2).mp
      (CFSG.CGT.PushingUp.isCharacteristicP_of_isPLocal h.toTheoremFourHyp.charTwoType hloc)
  obtain ⟨J, -, hLJ, hJ0⟩ := h152 L hL4 M hM2 hLM hF
  obtain ⟨Y₀, hJY₀, hY₀⟩ := Finite.exists_le_maximal (p := (· ∈ scriptY0 A (lB A))) hJ0
  exact hno Y₀ hY₀ (hLJ.trans hJY₀)

theorem step1515LA7Y0_at (h153 : Item153Main A (lB A)) (hobs : Claim153Obs A (lB A))
    (h1411 : Item1411_1 A (lB A)) (h1444 : Item1444S14) (h146 : Item146S14)
    (hbot : Item145BotS14) (h142 : Concl142R) (h : Sec15R G A c L)
    (hΩ : omegaA A = {Subgroup.zpowers c}) [Fact (Nat.Prime 5)]
    (φU : ↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* CFSG.Assembly.RankThreeEven.projSU 3 5 1)
    {Y : Subgroup G} (hY : Y ∈ scriptY0Star A (lB A)) (hm : MeetsY4 A (lB A) L Y)
    (hYL : Y = (L ⊓ Y) ⊔ CFSG.Open.pCoreOf 2 Y)
    (φY : ↥Y ⧸ CFSG.pCore 2 ↥Y ≃* alternatingGroup (Fin 7)) :
    ∀ Y₀ ∈ scriptY0Star A (lB A), ¬ L ≤ Y₀ := by
  intro Y₀ hY₀ hLY₀
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hY4 : Y ∈ scriptY4 A (lB A) := hY.prop.1
  have h14 := h.toSec14Std
  obtain ⟨S₀, hS₀, hS₀Y₀⟩ := Sec16.exists_qStar_le_normalizer h153 hobs hY₀
  set O := CFSG.Open.pCoreOf 2 Y with hO
  have hO2 : IsPGroup 2 O := CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) Y
  have hcov : Y = (Y ⊓ L) ⊔ O := by rw [inf_comm]; exact hYL
  have hOQ0 : O ∈ scriptQ A (lB A) :=
    Sec17.Proof17Q0.pCoreOf_mem_scriptQ_of_cover h14 (h1444 G A c L h14) (h146 G A c L h14)
      (hbot G A c L h14) (h142 G A c L h) hY4 (Or.inl hcov)
  have hOQ : O ∈ scriptQPi A (lB A) ⊤ (piOf 2) :=
    ⟨⟨hOQ0, le_top⟩, (isPiSubgroup_piOf_iff Nat.prime_two O).mpr hO2⟩
  obtain ⟨w, hw, hOw⟩ := Sec16.exists_conj_le_normalizer h1411 hS₀ hS₀Y₀ hOQ
  set Y₁ := Y₀.map (MulAut.conj w).toMonoidHom with hY₁def
  have hY₁ : Y₁ ∈ scriptY0Star A (lB A) := Sec16.map_conj_mem_scriptY0Star hw hY₀
  have h3 : 3 ∣ Nat.card L :=
    (Proof1514.three_dvd_card_inf_of_meetsY4 hm).trans (Subgroup.card_dvd_of_le inf_le_left)
  have hwL : w ∈ Subgroup.normalizer (L : Set G) :=
    Sec16.normalizer_zpowers_le_normalizer_L h h3 (normalizer_le_of_omegaA_eq hΩ hw)
  have hLY₁ : L ≤ Y₁ := by
    rw [← Late.map_conj_eq_of_mem_normalizer hwL, hY₁def]
    exact Subgroup.map_mono hLY₀
  have hYN : Y ≤ Subgroup.normalizer (Y₁ : Set G) := by
    rw [hYL]
    exact sup_le (inf_le_left.trans (hLY₁.trans Subgroup.le_normalizer)) hOw
  have hYY₁ : Y ≤ Y₁ := Proof1517.le_of_le_normalizer_of_cover hY4.2.1 hYL hLY₁ hYN
  have hYeq : Y = Y₁ := hY.eq_of_le hY₁.prop hYY₁
  exact not_dvd_card_U35 φU φY (Proof1514.card_thetaQuot_dvd (hYeq ▸ hLY₁))

theorem step1515LA7Simple_at
    (h135 : Item135Simple) (h142 : Concl142R)
    (h152 : Item152 A (lB A)) (h1511 : Item1511 A (lB A) c L) (hgen : KS1517Gen)
    (h : Sec15R G A c L) [Fact (Nat.Prime 5)]
    (φU : ↥L ⧸ aschbacherSolvableCore 3 ↥L ≃* CFSG.Assembly.RankThreeEven.projSU 3 5 1)
    {Y : Subgroup G} (hY : Y ∈ scriptY0Star A (lB A)) (hm : MeetsY4 A (lB A) L Y)
    (hno : ∀ Y₀ ∈ scriptY0Star A (lB A), ¬ L ≤ Y₀) :
    IsSimpleGroup ↥L ∧ Odd (Nat.card ↥(Subgroup.centralizer ({c} : Set G) ⊓
      Subgroup.centralizer (L : Set G))) := by
  have hD := h.toSec13Data
  have hiso : Sec4.IsoLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) 5 1 :=
    Or.inr ⟨by norm_num, ⟨φU⟩⟩
  have hAHY : A ≤ Subgroup.normalizer (Subgroup.zpowers c : Set G) ⊓
      Subgroup.normalizer (Y : Set G) :=
    le_inf (hD.A_le_centralizer.trans (centralizer_singleton_le_normalizer_zpowers c))
      hY.prop.1.1.2
  have hA3 : IsPGroup 3 A := IsPGroup.of_card (n := 3) (by rw [hD.card_eq]; norm_num)
  obtain ⟨P, hP, hAP⟩ := Item134SylowBarProof.exists_isSylowOf_le hAHY hA3
  obtain ⟨hprod, -⟩ := h1511 5 1 le_rfl hiso Y hY.prop hm P hAP hP
  have hno2 := noY2_of_U35_at h135 h142 h152 hgen h φU hprod hno
  have hsimpL := Proof1514.isSimpleGroup_of_isoLThreePi h.mem_thetaComponentsAt le_rfl hiso
  obtain ⟨-, -, hAeq⟩ := point_facts_of_prod h hsimpL hprod
  have hL3 : IsLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) :=
    ⟨5, 1, inferInstance, le_rfl, hiso⟩
  have hθ : aschbacherSolvableCore 3 ↥L = ⊥ := by
    rw [Sec19.theta_eq_pCore_two_of_mult KFacts.KS14.ks18Mult (h135 G A c L hD (Or.inl hL3))
      (Or.inl hL3)]
    exact Proof1517.pCore_two_eq_bot h hno2
  have := hsimpL
  exact ⟨((QuotientGroup.quotientMulEquivOfEq hθ).trans
    QuotientGroup.quotientBot).symm.isSimpleGroup, odd_card_inf_centralizer_of h hAeq hno2⟩

theorem step1515LA7L325_at (h153 : Item153Main A (lB A)) (hobs : Claim153Obs A (lB A))
    (h149 : Item149 A (lB A)) (h1411 : Item1411_1 A (lB A)) (hloc : Claim1411Local A (lB A))
    (hgen : Step1515LA7L325Gen) (h : Sec15R G A c L) (hΩ : omegaA A = {Subgroup.zpowers c})
    {Y : Subgroup G} (hY : Y ∈ scriptY0Star A (lB A)) (hm : MeetsY4 A (lB A) L Y)
    (hYL : Y = (L ⊓ Y) ⊔ CFSG.Open.pCoreOf 2 Y)
    (φY : ↥Y ⧸ CFSG.pCore 2 ↥Y ≃* alternatingGroup (Fin 7)) [hf5 : Fact (Nat.Prime 5)] :
    IsEmpty (↥L ⧸ aschbacherSolvableCore 3 ↥L ≃*
      CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 5 2)) := by
  refine ⟨fun φ => ?_⟩
  obtain ⟨S, -, hS⟩ := Finite.exists_le_maximal
    (p := (· ∈ scriptQPi A (lB A) (Subgroup.normalizer (Y : Set G)) (piOf 2)))
    (Proof1514.bot_mem_scriptQPi_two A (lB A) _)
  have hSY : S ≤ Subgroup.normalizer (Y : Set G) := hS.prop.1.2
  have hT := step1516_of_mem h h153 hobs h149 h1411 hloc hY hΩ S hS
  have hLN : L ≤ Subgroup.normalizer (Y : Set G) :=
    (hgen G A c L h hΩ Y hY hm hYL ⟨φY⟩ hf5 ⟨φ⟩ _ hT).trans
      (sup_le (inf_le_left.trans (inf_le_left.trans hSY))
        (inf_le_right.trans Subgroup.le_normalizer))
  have hiso : Sec4.IsoLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) 5 2 :=
    Or.inl ⟨by norm_num, ⟨φ⟩⟩
  have hsimp := Proof1514.isSimpleGroup_of_isoLThreePi h.mem_thetaComponentsAt (by norm_num) hiso
  have hLY := le_of_le_normalizer_of_theta
    (Sec6.isPerfect_of_mem_thetaComponentsAt h.mem_thetaComponentsAt) hsimp hLN
    (Proof1514.three_dvd_card_inf_of_meetsY4 hm)
  have hdvd := Proof1514.card_thetaQuot_dvd hLY
  rw [Nat.card_congr φ.toEquiv, card_projSL_three_twentyFive, Nat.card_congr φY.toEquiv,
    card_alternatingGroup_seven] at hdvd
  norm_num at hdvd

theorem step1515LA7_at
    (h148 : Item148R) (hbot : Item145BotS14)
    (h135 : Item135Simple) (h142 : Concl142R) (hgen : KS1517Gen) (h152 : Item152 A (lB A))
    (h153 : Item153Main A (lB A)) (hobs : Claim153Obs A (lB A)) (h149 : Item149 A (lB A))
    (h1411 : Item1411_1 A (lB A)) (hloc : Claim1411Local A (lB A))
    (h1511 : Item1511 A (lB A) c L) (h1444 : Item1444S14) (h146 : Item146S14)
    (hgen325 : Step1515LA7L325Gen) (h : Sec15R G A c L) {p e : ℕ} [Fact p.Prime] (he : 1 ≤ e)
    (hiso : Sec4.IsoLThreePi (↥L ⧸ aschbacherSolvableCore 3 ↥L) p e)
    (hΩ : omegaA A = {Subgroup.zpowers c}) {Y : Subgroup G} (hY : Y ∈ scriptY0Star A (lB A))
    (hm : MeetsY4 A (lB A) L Y) (hYL : Y = (L ⊓ Y) ⊔ CFSG.Open.pCoreOf 2 Y)
    (hY7 : Nonempty (↥Y ⧸ CFSG.pCore 2 ↥Y ≃* alternatingGroup (Fin 7))) :
    (∃ _ : Fact (Nat.Prime 5), Nonempty (↥L ⧸ aschbacherSolvableCore 3 ↥L ≃*
        CFSG.Assembly.RankThreeEven.projSU 3 5 1)) ∧
      (∀ Y₀ ∈ scriptY0Star A (lB A), ¬ L ≤ Y₀) ∧ IsSimpleGroup ↥L ∧
      Odd (Nat.card ↥(Subgroup.centralizer ({c} : Set G) ⊓
        Subgroup.centralizer (L : Set G))) := by
  have hY4 : Y ∈ scriptY4 A (lB A) := hY.prop.1
  have hYΔ := eq_deltaZero_of_mem_scriptY4 hbot h hY4
  obtain ⟨φY⟩ := hY7
  have hYc : Nat.card (↥Y ⧸ CFSG.pCore 2 ↥Y) = 2520 := by
    rw [Nat.card_congr φY.toEquiv, card_alternatingGroup_seven]
  have hQs : IsSimpleGroup (↥Y ⧸ CFSG.pCore 2 ↥Y) :=
    Proof1514.isSimpleGroup_of_mulEquiv_alternating (by norm_num) φY
  have heq : CFSG.pPrimeCore 3 ↥Y = CFSG.pCore 2 ↥Y :=
    pPrimeCore_three_eq_pCore_two (pPrimeCore_three_eq_bot_of_isSimpleGroup hQs
      (by rw [hYc]; norm_num))
  have hY7' : Nat.card (↥Y ⧸ CFSG.pPrimeCore 3 ↥Y) = 2520 := by
    rw [Nat.card_congr (QuotientGroup.quotientMulEquivOfEq heq).toEquiv, hYc]
  have h3L : 3 ∣ Nat.card L :=
    (Proof1514.three_dvd_card_inf_of_meetsY4 hm).trans (Subgroup.card_dvd_of_le inf_le_left)
  have hpt : ∀ (c' : G) (L' : Subgroup G), Subgroup.zpowers c' ∈ omegaA A → L' ∈ lA A c' →
      L' = L := by
    intro c' L' hc' hL'
    have hcc : Subgroup.zpowers c' = Subgroup.zpowers c := by
      rw [hΩ] at hc'
      exact hc'
    exact eq_of_mem_lA_of_zpowers_eq h.toSec14Std h3L hcc hL'
  have hU : ∃ _ : Fact (Nat.Prime 5), Nonempty (↥L ⧸ aschbacherSolvableCore 3 ↥L ≃*
      CFSG.Assembly.RankThreeEven.projSU 3 5 1) := by
    rcases cases148_of_mem_scriptY4 (h148 G A c L h) h.isElemAbelian.1 hY4 hYΔ with
      ⟨c', hc', -, L', hL', hcases⟩ | ⟨c', L', hc', hL', ⟨φJ⟩, -⟩ |
        ⟨⟨φ10⟩, -, -⟩ | ⟨c', L', n, m, hc', hL', -, -, hiso', -⟩
    · have hLL := hpt c' L' hc' hL'
      subst hLL
      rcases hcases with hφ | ⟨hL'', -⟩ | ⟨p', f, e', hp', -, -, -, hε⟩ | ⟨⟨φJ⟩, -⟩
      · exfalso
        obtain ⟨φ⟩ := hφ
        exact Proof1514.not_isoLThreePi_of_card_2520 (by
          rw [← Nat.card_congr φ.toEquiv, hY7']) p e hiso
      · rcases hL'' with hM | ⟨_, ⟨φ⟩⟩ | hU
        · obtain ⟨φM⟩ := hM
          exact (KFacts.KS14.not_isoLThreePi_M22 p e (isoLThreePi_congr φM hiso)).elim
        · exact ((step1515LA7L325_at h153 hobs h149 h1411 hloc hgen325 h hΩ hY hm hYL
            φY).false φ).elim
        · exact hU
      · exact (not_isLThreeEpsAt_of_card_2520 hY7' p' f hε).elim
      · exact (Proof1514.not_isoLThreePi_of_j2 φJ hiso).elim
    · have hLL := hpt c' L' hc' hL'
      subst hLL
      exact (Proof1514.not_isoLThreePi_of_j2 φJ hiso).elim
    · exfalso
      have h1 := Nat.card_congr φ10.toEquiv
      rw [hY7', KFacts.KS14.card_alternatingGroup_five_seven_ten.2.2] at h1
      omega
    · exfalso
      have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      exact Proof1514.not_isoLThreePi_of_card_2520 hY7' 2 (3 * n) hiso'
  obtain ⟨_, ⟨φU⟩⟩ := hU
  have hno := step1515LA7Y0_at h153 hobs h1411 h1444 h146 hbot h142 h hΩ φU hY hm hYL φY
  obtain ⟨hs, hodd⟩ := step1515LA7Simple_at h135 h142 h152 h1511 hgen h φU hY hm hno
  exact ⟨⟨inferInstance, ⟨φU⟩⟩, hno, hs, hodd⟩

