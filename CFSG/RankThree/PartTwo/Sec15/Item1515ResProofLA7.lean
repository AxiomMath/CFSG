    exact (Commute.zpow_left (Subgroup.mem_centralizer_iff.mp hg (t : G) t.2) k).eq
  have hLC : L ≤ Subgroup.centralizer (X₀ : Set G) := fun l hl =>
    Subgroup.mem_centralizer_iff.mpr fun x hx =>
