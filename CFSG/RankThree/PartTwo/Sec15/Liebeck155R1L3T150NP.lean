private theorem not_commutative_of_order_four {K : Type*} [Group K] [Finite K] [IsSimpleGroup K]
    (h4 : ∃ s : K, orderOf s = 4) : ¬ ∀ a b : K, a * b = b * a := by
  intro hc
  let _ : CommGroup K := { ‹Group K› with mul_comm := hc }
  have hp : (Nat.card K).Prime := IsSimpleGroup.prime_card
  obtain ⟨s, hs⟩ := h4
  have hd : 4 ∣ Nat.card K := hs ▸ orderOf_dvd_natCard s
  have h2 : 2 ∣ Nat.card K := (by norm_num : 2 ∣ 4).trans hd
  have := (Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).1 h2
  rw [← this] at hd
  norm_num at hd

private theorem eq_bot_of_normal_isPGroup {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (hnc : ¬ ∀ a b : G, a * b = b * a) {D : Subgroup G} [D.Normal] (hD : IsPGroup 2 D) :
    D = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal D with h | h
  · exact h
  · exfalso
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hG : IsPGroup 2 G := fun g => by
      obtain ⟨k, hk⟩ := hD ⟨g, h ▸ Subgroup.mem_top g⟩
      exact ⟨k, congrArg Subtype.val hk⟩
    have := hG.isNilpotent
    exact hnc (IsSimpleGroup.comm_iff_isSolvable.2 inferInstance)

private theorem isLThreeEpsAt_of_simple {K : Type} [Group K] (hKs : IsSimpleGroup K)
    {n : ℕ} (hn : 1 ≤ n) (h : IsoLThreePi K 2 n) : Sec14.IsLThreeEpsAt K 2 n := by
  rcases h with ⟨-, ⟨e⟩⟩ | ⟨-, ⟨e⟩⟩
  · exact Or.inl ⟨e⟩
  · refine Or.inr ⟨?_, ⟨e⟩⟩
    by_contra hlt
    have hn1 : n = 1 := by
      by_contra hne
      have h2 : 2 ≤ n := by omega
      have h4 : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) h2
      omega
    subst hn1
    refine Quasithin.Background.Harris.OrdinaryProofs.not_isSimpleGroup_of_card_72
      (Y := K) ?_ hKs
    rw [Nat.card_congr e.toEquiv]
    have h := KFacts.KS14.card_projSU_three_mul_gcd 2 1 le_rfl
    norm_num at h
    omega

private theorem exists_orderOf_eq_four_of_simple {K : Type} [Group K] (hKs : IsSimpleGroup K)
    {n : ℕ} (hn : 1 ≤ n) (h : IsoLThreePi K 2 n) : ∃ s : K, orderOf s = 4 :=
  Sec15.exists_orderOf_eq_four_of_isLThreeEpsAt (isLThreeEpsAt_of_simple hKs hn h)

theorem not_commutative_of_isoLThreePi {K : Type} [Group K] [Finite K] (hKs : IsSimpleGroup K)
    {n : ℕ} (hn : 1 ≤ n) (h : IsoLThreePi K 2 n) : ¬ ∀ a b : K, a * b = b * a := by
  have := hKs
  exact not_commutative_of_order_four (exists_orderOf_eq_four_of_simple hKs hn h)

private theorem hasOrderFourMod_of_simple {G : Type*} [Group G] {H : Subgroup G} [Finite H]
    (hH : IsSimpleGroup H) (h4 : ∃ s : H, orderOf s = 4) : HasOrderFourMod H := by
  obtain ⟨s, hs⟩ := h4
  have hnc := not_commutative_of_order_four ⟨s, hs⟩
  have hs4 : s ^ 4 = 1 := hs ▸ pow_orderOf_eq_one s
  refine ⟨⊥, bot_le, fun D hDH hHD hD2 => ?_, (s : G), s.2, ⟨2, ?_⟩, ?_⟩
  · have hn : (D.subgroupOf H).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hDH).2 hHD
    have h2 : IsPGroup 2 (D.subgroupOf H) :=
      hD2.of_injective (Subgroup.subgroupOfEquivOfLe hDH).toMonoidHom
        (Subgroup.subgroupOfEquivOfLe hDH).injective
    have hb := eq_bot_of_normal_isPGroup hnc h2
    intro x hx
    have : (⟨x, hDH hx⟩ : H) ∈ D.subgroupOf H := Subgroup.mem_subgroupOf.2 hx
    rw [hb, Subgroup.mem_bot] at this
    rw [Subgroup.mem_bot]
    exact congrArg Subtype.val this
  · have := congrArg Subtype.val hs4
    simpa using this
  · intro h2
    rw [Subgroup.mem_bot] at h2
    have h2' : s ^ 2 = 1 := Subtype.ext (by simpa using h2)
    have := orderOf_dvd_of_pow_eq_one h2'
    rw [hs] at this
    norm_num at this

private theorem hasOrderFourMod_map_equiv {G G' : Type*} [Group G] [Group G'] {H : Subgroup G}
    (hH : HasOrderFourMod H) (e : G ≃* G') : HasOrderFourMod (H.map e.toMonoidHom) := by
  obtain ⟨N, hNH, hDN, y, hyH, ⟨k, hyk⟩, hy2⟩ := hH
  refine ⟨N.map e.toMonoidHom, Subgroup.map_mono hNH, fun D hDH hHD hD2 => ?_,
    e y, Subgroup.mem_map_of_mem _ hyH, ⟨k, by rw [← map_pow]; simp [hyk]⟩, ?_⟩
  · have hDc : D.comap e.toMonoidHom ≤ H := by
      intro x hx
      have := hDH hx
      rw [Subgroup.mem_map_equiv] at this
      simpa using this
    have hHDc : H ≤ Subgroup.normalizer ((D.comap e.toMonoidHom : Subgroup G) : Set G) := by
      intro x hx
      have hx' := hHD (Subgroup.mem_map_of_mem e.toMonoidHom hx)
      rw [Subgroup.mem_normalizer_iff] at hx' ⊢
      intro d
      rw [Subgroup.mem_comap, Subgroup.mem_comap, hx' (e.toMonoidHom d), map_mul, map_mul,
        map_inv]
    have hD2c : IsPGroup 2 (D.comap e.toMonoidHom) :=
      hD2.comap_of_injective e.toMonoidHom e.injective
    have hle := hDN _ hDc hHDc hD2c
    intro x hx
    refine ⟨e.symm x, hle ?_, by simp⟩
    rw [Subgroup.mem_comap]
    simpa using hx
  · intro hmem
    apply hy2
    rw [← map_pow] at hmem
    obtain ⟨z, hz, hze⟩ := hmem
    have : z = y ^ 2 := e.injective hze
    rwa [← this]

private theorem le_normalizer_of_forall {S : Type*} [Group S] {K W : Subgroup S}
    (h : ∀ k ∈ K, ∀ w ∈ W, k * w * k⁻¹ ∈ W) : K ≤ Subgroup.normalizer (W : Set S) := by
  intro k hk
  rw [Subgroup.mem_normalizer_iff]
  intro w
  refine ⟨fun hw => h k hk w hw, fun hw => ?_⟩
  have := h k⁻¹ (K.inv_mem hk) _ hw
  simpa [mul_assoc] using this


private theorem isSolvable_of_normalizes_unitaryPSU {p f : ℕ} {K : Type} [Field K]
    (h : UnitaryFieldData p f K) {W B : Subgroup (unitaryPSU h 3)} (hWp : IsPGroup p W)
    (hW : W ≠ ⊥) (hB : ∀ b ∈ B, ∀ w ∈ W, b * w * b⁻¹ ∈ W) : Group.IsSolvable B := by
  have : Fact p.Prime := ⟨h.prime⟩
  have := h.finite
  set φ := unitaryProj h 3 with hφdef
  have hφ : Function.Surjective φ := unitaryProj_surjective h 3
  have hker : φ.ker ≤ unitaryScalars h 3 := (ker_unitaryProj h 3).le
  have hcen : φ.ker ≤ Subgroup.center (unitarySU p f K 3) :=
    hker.trans (unitaryScalars_le_center h 3)
  have hC := not_dvd_card_of_le_unitaryScalars h hker
  set U := liftSubgroup p φ W with hU
  have hUp : IsPGroup p U := liftSubgroup_isPGroup hcen hWp
  have hU1 : U ≠ ⊥ := by
    intro hbot
    apply hW
    apply Subgroup.eq_bot_of_card_eq
    rw [← Nat.card_congr (liftSubgroupEquiv hφ hcen hC hWp).toEquiv, ← hU, hbot,
      Subgroup.card_bot]
  have hnorm : ∀ g ∈ B.comap φ, ∀ e ∈ U, g * e * g⁻¹ ∈ U := by
    intro g hg e he
    obtain ⟨he1, n, hn⟩ := (mem_liftSubgroup_iff hcen hWp).1 he
    refine (mem_liftSubgroup_iff hcen hWp).2 ⟨?_, n, ?_⟩
    · have := hB (φ g) hg (φ e) he1
      rw [map_mul, map_mul, map_inv]
      exact this
    · rw [← hn]
      exact orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective e
  obtain ⟨J, J₂, hJJ, hJ1, hJ2, hinv⟩ := exists_flag_of_isPGroup h
    (U := U.map (unitarySU p f K 3).subtype) (Subgroup.map_subtype_le U) (hUp.map _)
    (fun hbot => hU1 ((Subgroup.map_eq_bot_iff_of_injective _
      (unitarySU p f K 3).subtype_injective).1 hbot))
  have hgl : ∀ g ∈ B.comap φ, ∀ u ∈ U.map (unitarySU p f K 3).subtype,
      (g : GL (Fin 3) K) * u * (g : GL (Fin 3) K)⁻¹ ∈ U.map (unitarySU p f K 3).subtype := by
    rintro g hg _ ⟨e, he, rfl⟩
    exact ⟨g * e * g⁻¹, hnorm g hg e he, rfl⟩
  have hstab : ∀ g ∈ B.comap φ, unitaryToSL h g ∈ stabilizer J ⊓ stabilizer J₂ := by
    intro g hg
    have hgi : ((g⁻¹ : unitarySU p f K 3) : GL (Fin 3) K) = (g : GL (Fin 3) K)⁻¹ := rfl
    have hc2 : ∀ u ∈ U.map (unitarySU p f K 3).subtype,
        (g : GL (Fin 3) K)⁻¹ * u * (g : GL (Fin 3) K) ∈ U.map (unitarySU p f K 3).subtype := by
      intro u hu
      have e := hgl g⁻¹ (inv_mem hg) u hu
      rwa [hgi, inv_inv] at e
    have h1 := hinv g g.2 (hgl g hg) hc2
    have h2 := hinv (g : GL (Fin 3) K)⁻¹ (inv_mem g.2)
      (fun u hu => by rw [inv_inv]; exact hc2 u hu)
      (fun u hu => by rw [inv_inv]; exact hgl g hg u hu)
    refine Subgroup.mem_inf.2 ⟨?_, ?_⟩
    · exact mem_stabilizer.2 (map_mulVecLin_eq h1.1 h2.1)
    · exact mem_stabilizer.2 (map_mulVecLin_eq h1.2 h2.2)
  let ψ : B.comap φ →* (stabilizer J ⊓ stabilizer J₂ :
      Subgroup (Matrix.SpecialLinearGroup (Fin 3) K)) :=
    ((unitaryToSL h).comp (B.comap φ).subtype).codRestrict _ fun g => hstab g g.2
  have hψ : Function.Injective ψ := fun x y e =>
    Subtype.ext (unitaryToSL_injective h (congrArg Subtype.val e))
  have := isSolvable_stabilizer_inf_stabilizer h.prime h.card hJJ hJ1 hJ2
  have : Group.IsSolvable (B.comap φ) := Group.isSolvable_of_isSolvable_injective hψ
  have hBs : Group.IsSolvable ((B.comap φ).map φ) :=
    Group.isSolvable_of_surjective (φ.subgroupMap_surjective (B.comap φ))
  rwa [Subgroup.map_comap_eq_self_of_surjective hφ] at hBs



theorem noTwoNormalized_of_survL3 {S : Type} [Group S] [Finite S] {σ : MulAut S}
    {K : Subgroup S} (hKs : IsSimpleGroup ↥K) (h : Sec4.RonanK429.SurvL3 S σ K) :
    NoTwoNormalized K := by
  obtain ⟨n, hn, hK, hS, -⟩ := h
  have h4 := exists_orderOf_eq_four_of_simple hKs hn hK
  intro W hW2 hKW
  by_contra hW1
  have hKN := le_normalizer_of_forall hKW
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rcases hS with ⟨-, ⟨e⟩⟩ | ⟨-, ⟨e⟩⟩
  ·
    set F := GaloisField 2 (3 * n) with hF
    let e' : S ≃* projectiveSL 3 F := e.trans (KFacts.L34.projSLEquivProjectiveSL 3 F)
    have : Finite (projectiveSL 3 F) := Finite.of_equiv S e'.toEquiv
    have hOF : HasOrderFourMod K := hasOrderFourMod_of_simple hKs h4
    have hb := Ronan155DiamondL3.eq_bot_of_isPGroup_of_le_normalizer
      (hasOrderFourMod_map_equiv hOF e') (hW2.map e'.toMonoidHom)
      (by
        rw [← Subgroup.map_equiv_normalizer_eq]
        exact Subgroup.map_mono hKN)
    exact hW1 ((Subgroup.map_eq_bot_iff_of_injective _ e'.injective).1 hb)
  ·
    have hU : UnitaryFieldData 2 (3 * n) (GaloisField 2 (2 * (3 * n))) :=
      ⟨Nat.prime_two, by omega, GaloisField.card 2 (2 * (3 * n)) (by omega)⟩
    obtain ⟨e2⟩ := KFacts.nonempty_unitaryPSU_mulEquiv_projSU hU
    let e' : S ≃* unitaryPSU hU 3 := e.trans e2.symm
    have hsolv : Group.IsSolvable ↥(K.map e'.toMonoidHom) :=
      isSolvable_of_normalizes_unitaryPSU hU (hW2.map e'.toMonoidHom)
        (fun hb => hW1 ((Subgroup.map_eq_bot_iff_of_injective _ e'.injective).1 hb))
        (fun b hb w hw => by
          obtain ⟨k, hk, rfl⟩ := hb
          obtain ⟨w₀, hw₀, rfl⟩ := hw
          exact ⟨k * w₀ * k⁻¹, hKW k hk w₀ hw₀, by simp⟩)
    have : Group.IsSolvable ↥K := Group.isSolvable_of_isSolvable_injective
      (f := (K.equivMapOfInjective e'.toMonoidHom e'.injective).toMonoidHom)
      (K.equivMapOfInjective e'.toMonoidHom e'.injective).injective
    exact not_commutative_of_order_four h4 (IsSimpleGroup.comm_iff_isSolvable.2 inferInstance)


private theorem sylowNonabelian_of_isoLThreePi {K : Type}
    [Group K] [Finite K] (hKs : IsSimpleGroup K) {n : ℕ} (hn : 1 ≤ n) (h : IsoLThreePi K 2 n) :
    EvenSporadicStandard.Induction.SylowNonabelian K := by
  have hnc := not_commutative_of_isoLThreePi hKs hn h
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rcases h with ⟨-, ⟨e⟩⟩ | ⟨-, ⟨e⟩⟩
  · obtain ⟨u, v, hu, hv, huv, hne⟩ :=
      EvenSporadicStandard.Induction.projSL_three_dihedral (K := GaloisField 2 n)
    have : Finite (CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 n)) :=
      Finite.of_equiv K e.toEquiv
    exact EvenSporadicStandard.Induction.SylowNonabelian.of_mulEquiv e
      (EvenSporadicStandard.Induction.sylowNonabelian_of_dihedral hu hv huv hne)
  · let e' : K ≃* Theory.Comparator.PSU3Model n :=
      e.trans (((CFSG.PGLModel.projSUEquivStatedProj 3 2 n).trans
        (CFSG.ShultStronglyClosedTI.glaSUCanonicalEquivNative n)).trans
          (MulEquiv.subgroupCongr (CFSG.Models.benderPSU3Model_eq_psu3 n).symm))
    intro Q
    exact ClassicalInvolution.Q3.PhilipHall.Frame.TwinThmEW.psu3_sylow_nonabelian
      (fun hc => hnc fun a b => hc.is_comm.comm a b) e' Q

theorem noTwoNormalized_of_survD4

    {S : Type} [Group S] [Finite S] {σ : MulAut S}
    {K : Subgroup S} (hKs : IsSimpleGroup ↥K) (h : SurvD4 S σ K) : NoTwoNormalized K := by
  obtain ⟨n, hn, hK, hm, -⟩ := h
  have hSyl := sylowNonabelian_of_isoLThreePi hKs hn hK
  obtain ⟨F, _, _, _, σF, hF, hσF, hσ3, hf1, hsimp, ⟨φ⟩⟩ :=
    Res417Seven.exists_graphFixedRootGroup_of_trialityD4 hm
  have hHolds : LieType.BorelTits.Holds ↥(LieType.Chevalley.graphFixedRootGroup
      Blueprint.Chevalley.TwistTag.D4 F σF.toRingHom) 2 :=
    (LieType.BorelTits.holds_of_chevalleyExceptionalModel hm).of_mulEquiv φ
  intro W hW2 hKW
  by_contra hW1
  set C := LieType.Chevalley.graphFixedRootGroup Blueprint.Chevalley.TwistTag.D4 F σF.toRingHom
    with hC
  have hKN := le_normalizer_of_forall hKW
  obtain ⟨g, J, hJ, hle⟩ :=
    LocalAnalysis.GLTheoremA.T173O.exists_conj_normalizer_le_graphFixedParabolic
    hHolds (R := W.map φ.toMonoidHom)
    (fun hb => hW1 ((Subgroup.map_eq_bot_iff_of_injective _ φ.injective).1 hb))
    (hW2.map φ.toMonoidHom)
  have := hKs
  set P := LieType.Chevalley.graphFixedParabolic Blueprint.Chevalley.TwistTag.D4 F
    σF.toRingHom J with hP
  let ι : ↥K →* Blueprint.Chevalley.ModGL Blueprint.Chevalley.TwistTag.D4.tag F :=
    C.subtype.comp ((MulAut.conj g).toMonoidHom.comp (φ.toMonoidHom.comp K.subtype))
  have hι : Function.Injective ι := by
    intro a b hab
    have : (MulAut.conj g) (φ a) = (MulAut.conj g) (φ b) := Subtype.ext hab
    exact Subtype.ext (φ.injective ((MulAut.conj g).injective this))
  have hιP : ∀ k : ↥K, ι k ∈ P := by
    intro k
    refine hle ⟨(MulAut.conj g) (φ k), ⟨φ k, ?_, rfl⟩, rfl⟩
    have h1 : K.map φ.toMonoidHom ≤ Subgroup.normalizer
        ((W.map φ.toMonoidHom : Subgroup _) : Set _) := by
      rw [← Subgroup.map_equiv_normalizer_eq]
      exact Subgroup.map_mono hKN
    exact h1 ⟨k, k.2, rfl⟩
  obtain ⟨Q⟩ : Nonempty (Sylow 2 ↥K) := inferInstance
  obtain ⟨x, hx, y, hy, hxy⟩ := hSyl Q
  have hnc : ¬ ∀ a b : ↥K, a * b = b * a := fun hc => hxy (hc x y)
  set T : Subgroup (Blueprint.Chevalley.ModGL Blueprint.Chevalley.TwistTag.D4.tag F) :=
    (Q : Subgroup ↥K).map ι with hT
  have hT2 : IsPGroup 2 T := Q.isPGroup'.map ι
  have hTP : T ≤ P := by
    rintro _ ⟨q, -, rfl⟩
    exact hιP q
  have hcomm := LargeExtraspecial.S8.commutator_le_graphFixedParabolicRadical σF hσ3 hJ hTP hT2
  set D : LieType.Chevalley.RootWeightDatum F :=
    .fixed Blueprint.Chevalley.TwistTag.D4 σF hσ3 with hD
  set R := LieType.Chevalley.graphFixedParabolicRadical Blueprint.Chevalley.TwistTag.D4 F
    σF.toRingHom J with hR
  have hRn : (R.comap ι).Normal := ⟨fun d hd z => by
    have h1 : ι z * ι d * (ι z)⁻¹ ∈ R :=
      D.conj_mem_radical J (show ι z ∈ D.parabolic J from hιP z) hd
    simpa using h1⟩
  have hR2 : IsPGroup 2 (R.comap ι) := (D.isPGroup_radical 2 J).comap_of_injective ι hι
  have hbot := eq_bot_of_normal_isPGroup hnc hR2
  have hmem : ι ⁅x, y⁆ ∈ R := by
    rw [map_commutatorElement]
    exact hcomm (Subgroup.commutator_mem_commutator ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩)
  have h1 : ⁅x, y⁆ ∈ R.comap ι := hmem
  rw [hbot, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at h1
  exact hxy h1

end CFSG.RankThree.PartTwo.Sec15.Liebeck155R1L3T150
