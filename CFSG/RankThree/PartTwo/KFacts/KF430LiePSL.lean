section Det

variable {F : Type} [Field F]

@[expose] def planeIdx : Fin 2 ⊕ Fin 2 ≃ Fin 2 ⊕ Fin 2 := Equiv.swap (Sum.inr 0) (Sum.inl 1)

theorem planeMat_eq_submatrix (M N : Matrix (Fin 2) (Fin 2) F) :
    planeMat M N = (fromBlocks M 0 0 N).submatrix planeIdx planeIdx := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
    simp [planeMat, planeIdx, Equiv.swap_apply_def]

theorem det_planeMat (M N : Matrix (Fin 2) (Fin 2) F) :
    (planeMat M N).det = M.det * N.det := by
  rw [planeMat_eq_submatrix, det_submatrix_equiv_self, det_fromBlocks_zero₂₁]

theorem det_swapMat : (swapMat (F := F)).det = 1 := by
  rw [swapMat, det_fromBlocks_zero₂₁]
  simp [Matrix.det_fin_two]

end Det

theorem exists_lift_elemAbelian {G X : Type*} [Group G] [Group X] [Finite G] (π : G →* X)
    (hπ : Function.Surjective π) {m : ℕ} (hm : Nat.Coprime m 3)
    (hker : ∀ x, π x = 1 → x ^ m = 1) (E : Subgroup X) (hE : CFSG.Assembly.IsElemAbelian 3 E) :
    ∃ S : Subgroup G, CFSG.Assembly.IsElemAbelian 3 S ∧ Nat.card S = Nat.card E := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hEp : IsPGroup 3 E := fun x => ⟨1, Subtype.ext (by simpa using hE.2 x x.2)⟩
  obtain ⟨S, hSp, hSE⟩ :=
    CFSG.RankThree.PartTwo.Sec4.Ronan148L.exists_isPGroup_map_eq_of_surjective hπ hEp
  set f : S →* X := π.comp S.subtype with hf
  have hfinj : Function.Injective f := by
    rw [injective_iff_map_eq_one]
    intro x hx
    obtain ⟨k, hk⟩ := hSp x
    have h1 : orderOf (x : G) ∣ 3 ^ k := by
      apply orderOf_dvd_of_pow_eq_one
      exact congrArg Subtype.val hk
    have h2 : orderOf (x : G) ∣ m := orderOf_dvd_of_pow_eq_one (hker _ hx)
    have h3 : orderOf (x : G) = 1 :=
      Nat.eq_one_of_dvd_coprimes (Nat.Coprime.pow_left k (Nat.coprime_comm.1 hm)) h1 h2
    exact Subtype.ext (orderOf_eq_one_iff.1 h3)
  have hrange : f.range = E := by
    rw [hf, MonoidHom.range_comp, Subgroup.range_subtype, hSE]
  have hmemE : ∀ x : S, f x ∈ E := fun x => hrange ▸ ⟨x, rfl⟩
  refine ⟨S, ⟨⟨⟨fun x y => hfinj ?_⟩⟩, fun x hx => ?_⟩, ?_⟩
  · rw [map_mul, map_mul]
    exact congrArg Subtype.val (hE.1.is_comm.comm ⟨f x, hmemE x⟩ ⟨f y, hmemE y⟩)
  · have : f ⟨x, hx⟩ ^ 3 = 1 := hE.2 _ (hmemE _)
    rw [← map_pow] at this
    exact congrArg Subtype.val (hfinj (this.trans (map_one f).symm))
  · rw [← hrange]
    exact Nat.card_congr (MonoidHom.ofInjective hfinj).toEquiv

section E9

variable {F : Type} [Field F] [Finite F]

@[expose] noncomputable def reindexGL4 : GL (Fin 2 ⊕ Fin 2) F ≃* GL (Fin 4) F :=
  Units.mapEquiv (Matrix.reindexAlgEquiv F F finSumFinEquiv).toRingEquiv.toMulEquiv

theorem coe_reindexGL4 (A : GL (Fin 2 ⊕ Fin 2) F) :
    ((reindexGL4 A : GL (Fin 4) F) : Matrix (Fin 4) (Fin 4) F) =
      (A : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) F).submatrix finSumFinEquiv.symm
        finSumFinEquiv.symm := rfl

theorem det_reindexGL4 (A : GL (Fin 2 ⊕ Fin 2) F) :
    ((reindexGL4 A : GL (Fin 4) F) : Matrix (Fin 4) (Fin 4) F).det =
      (A : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) F).det := by
  rw [coe_reindexGL4, det_submatrix_equiv_self]

theorem reindexGL4_scalar (c : Fˣ) :
    reindexGL4 (Matrix.GeneralLinearGroup.scalar (Fin 2 ⊕ Fin 2) c) =
      Matrix.GeneralLinearGroup.scalar (Fin 4) c := by
  apply Units.ext
  rw [coe_reindexGL4, Matrix.GeneralLinearGroup.coe_scalar, Matrix.GeneralLinearGroup.coe_scalar,
    Matrix.scalar_apply, Matrix.scalar_apply, submatrix_diagonal_equiv]
  rfl

theorem e9Move_projSL4 {p : ℕ} [Fact p.Prime] [CharP F p] (hp3 : 3 < p) (hp2 : p % 3 = 2)
    (hF : Nat.card F = p) : E9Move (CFSG.PGLModel.projSL 4 F) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Fintype F := Fintype.ofFinite F
  obtain ⟨h2, h3⟩ := two_three_ne_zero hp3 hF
  have hF3 : Nat.card F % 3 = 2 := by rw [hF]; exact hp2
  rw [← CFSG.PGLModel.projImage_statedSL]
  haveI : Finite (CFSG.PGLModel.projImage (StatedSL 4 F)) := inferInstance
  have hsyl := CFSG.RankThree.PartTwo.Sec4.Ronan148L.comm_sylow_projImage
    (H := StatedSL 4 F) (r := 3) fun P hP a ha b hb => by
      have hP' : IsPGroup 3 (P.map (StatedSL 4 F).subtype) := hP.map _
      exact Subtype.ext (CFSG.RankThree.PartTwo.Sec4.Ronan148L.comm_of_isPGroup_GL4 hF3 _ hP'
        _ (Subgroup.mem_map_of_mem _ ha) _ (Subgroup.mem_map_of_mem _ hb))
  set π : StatedSL 4 F →* CFSG.PGLModel.projImage (StatedSL 4 F) :=
    ((Matrix.ProjGenLinGroup.mk : GL (Fin 4) F →* _).comp (StatedSL 4 F).subtype).codRestrict _
      (fun x => Subgroup.mem_map_of_mem _ x.2) with hπ
  have hπs : Function.Surjective π := by
    rintro ⟨_, x, hx, rfl⟩
    exact ⟨⟨x, hx⟩, rfl⟩
  have hker : ∀ x, π x = 1 → x ^ 4 = 1 := by
    intro x hx
    have hx' : x ∈ ((Matrix.ProjGenLinGroup.mk : GL (Fin 4) F →* _).comp
        (StatedSL 4 F).subtype).ker := MonoidHom.mem_ker.2 (congrArg Subtype.val hx)
    rw [CFSG.Open.StatedAPI.ker_mk_comp_subtype] at hx'
    obtain ⟨c, hc⟩ := hx'
    have hc' : (x : GL (Fin 4) F) = Matrix.GeneralLinearGroup.scalar (Fin 4) c := hc.symm
    have hdet := CFSG.Open.StatedAPI.mem_statedSL_iff.1 x.2
    rw [hc', Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, det_diagonal,
      Fin.prod_const] at hdet
    have hc4 : c ^ 4 = 1 := Units.ext (by simpa using hdet)
    apply Subtype.ext
    rw [Subgroup.coe_pow, hc', ← map_pow, hc4, map_one, Subgroup.coe_one]
  have hle : ∀ E : Subgroup (CFSG.PGLModel.projImage (StatedSL 4 F)),
      CFSG.Assembly.IsElemAbelian 3 E → Nat.card E ≤ 9 := by
    intro E hE
    obtain ⟨S, hS, hSc⟩ := exists_lift_elemAbelian π hπs (by norm_num) hker E hE
    have hS' := isElemAbelian_map (StatedSL 4 F).subtype hS
    have hcard := CFSG.RankThree.PartTwo.Sec21.Item223CensusResProof.card_sq_le_of_card_mod_two
      (ι := Fin 4) (p := p) (f := 1) (by rw [pow_one, ← Nat.card_eq_fintype_card, hF])
      (by rw [pow_one]; exact hp2) (S.map (StatedSL 4 F).subtype)
      (fun x hx y hy => congrArg Subtype.val (hS'.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩))
      (fun x hx => hS'.2 x hx)
    rw [Subgroup.card_map_of_injective (StatedSL 4 F).subtype_injective, hSc,
      Fintype.card_fin] at hcard
    by_contra h
    push Not at h
    have : 10 ^ 2 ≤ Nat.card E ^ 2 := Nat.pow_le_pow_left h 2
    omega
  obtain ⟨a, b, w, hmat, ha3, hb3, hab, hind, hsa, hsb, hwa, hwb⟩ := exists_std h2 h3
  have hSL : ∀ g ∈ [a, b, w], reindexGL4 g ∈ StatedSL 4 F := by
    intro g hg
    obtain ⟨M, N, hM, hN, hgMN⟩ := hmat g hg
    rw [CFSG.Open.StatedAPI.mem_statedSL_iff, det_reindexGL4, hgMN, det_planeMat, hM, hN, one_mul]
  refine e9Move_projImage_of_mats hsyl hle (hSL a (by simp)) (hSL b (by simp))
    (s := reindexGL4 swapGL)
    (by rw [CFSG.Open.StatedAPI.mem_statedSL_iff, det_reindexGL4]; exact det_swapMat)
    (hSL w (by simp)) (by rw [← map_pow, ha3, map_one]) (by rw [← map_pow, hb3, map_one])
    (by rw [← map_mul, hab, map_mul]) ?_
    (by rw [← map_inv, ← map_mul, ← map_mul, hsa])
    (by rw [← map_inv, ← map_mul, ← map_mul, hsb])
    (by rw [← map_inv, ← map_mul, ← map_mul, hwa, map_pow])
    (by rw [← map_inv, ← map_mul, ← map_mul, hwb])
  intro i j c hc
  rw [← map_pow, ← map_pow, ← map_mul, ← reindexGL4_scalar] at hc
  exact hind i j c (reindexGL4.injective hc)

end E9

theorem inner_of_not_three_dvd_outer {S : Type*} [Group S]
    (h : ¬ 3 ∣ Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer S))
    (σ : MulAut S) (hσ : orderOf σ = 3) : σ ∈ (MulAut.conj : S →* MulAut S).range := by
  have h1 : orderOf (QuotientGroup.mk σ :
      CFSG.ComponentClassification.OuterAutomorphisms.Outer S) ∣ 3 := by
    rw [← hσ]
    exact orderOf_map_dvd (QuotientGroup.mk' _) σ
  have h2 : orderOf (QuotientGroup.mk σ :
      CFSG.ComponentClassification.OuterAutomorphisms.Outer S) ∣
      Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer S) := orderOf_dvd_natCard _
  have h3 : orderOf (QuotientGroup.mk σ :
      CFSG.ComponentClassification.OuterAutomorphisms.Outer S) = 1 := by
    rcases (Nat.dvd_prime Nat.prime_three).1 h1 with h4 | h4
    · exact h4
    · exact absurd (h4 ▸ h2) h
  exact (QuotientGroup.eq_one_iff (N := CFSG.ComponentClassification.OuterAutomorphisms.inner S)
    σ).1 (orderOf_eq_one_iff.1 h3)

theorem concl_projSL4 {p : ℕ} [Fact p.Prime] (hp3 : 3 < p) (hp2 : p % 3 = 2) :
    Concl (CFSG.PGLModel.projSL 4 (GaloisField p 1)) := by
  have hF : Nat.card (GaloisField p 1) = p := by
    rw [GaloisField.card p 1 one_ne_zero, pow_one]
  exact ⟨inner_of_not_three_dvd_outer
      (CFSG.RankThree.PartTwo.Sec4.RonanK429H.l4_not_three_dvd_outer p),
    CFSG.RankThree.PartTwo.Sec21.Item211Res4Proof.center_projSL_four_eq_bot,
    e9Move_projSL4 hp3 hp2 hF⟩

theorem kf430LiePSL_holds : KF430LiePSL := by
  intro p _ hp hp2 L _ _ ⟨e⟩
  exact Concl.of_mulEquiv e (concl_projSL4 hp hp2)

