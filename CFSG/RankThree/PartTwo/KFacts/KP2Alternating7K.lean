open Equiv CFSG.Permutation.FinPack

theorem h16 : 7 ≤ 16 := by norm_num

@[expose] noncomputable def commK (c d : ℕ) : Bool := Nat.beq (mulK 7 c d) (mulK 7 d c)

@[expose] noncomputable def qC (G₁ G₂ : ℕ) (L : List ℕ) (c : ℕ) : Bool :=
  !commK c G₁ || !commK c G₂ || memK c L

theorem cent_of {ι : Type} (f : ι → Perm (Fin 7)) (T : List (ι × ℕ)) {g₁ g₂ : Perm (Fin 7)}
    {G₁ G₂ : ℕ} (h₁ : enc g₁ = G₁) (h₂ : enc g₂ = G₂) (hT : ∀ t ∈ T, enc (f t.1) = t.2)
    (hw : walkK 7 (qC G₁ G₂ (T.map Prod.snd)) 7 0 0 0 = true) :
    ∀ x, x * g₁ = g₁ * x → x * g₂ = g₂ * x → ∃ t ∈ T, x = f t.1 := by
  intro x hx₁ hx₂
  have h := walkK_sound hw x
  have e₁ : commK (enc x) G₁ = true := by
    rw [← h₁]
    exact (comm_enc_iff h16).2 hx₁
  have e₂ : commK (enc x) G₂ = true := by
    rw [← h₂]
    exact (comm_enc_iff h16).2 hx₂
  rw [qC.eq_1, e₁, e₂] at h
  simp only [Bool.not_true, Bool.false_or] at h
  rw [memK_iff, List.mem_map] at h
  obtain ⟨t, ht, he⟩ := h
  exact ⟨t, ht, enc_inj h16 (by rw [hT t ht, he])⟩

