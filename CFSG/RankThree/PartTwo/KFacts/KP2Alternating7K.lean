theorem norm_of {ι : Type} (f : ι → Perm (Fin 7)) (T : List (ι × ℕ))
    {e9 : Fin 3 → Fin 3 → Perm (Fin 7)} {g₁ g₂ : Perm (Fin 7)}
    (hc9 : ∀ i j : Fin 3, enc (e9 i j) ∈ T9.map Prod.snd) (h₁ : enc g₁ = 106180641)
    (h₂ : enc g₂ = 104153616) (hT : ∀ t ∈ T, enc (f t.1) = t.2)
    (hw : walkK 7 (qN (T.map Prod.snd)) 7 0 0 0 = true) :
    ∀ g : Perm (Fin 7), g 6 = 6 → (∃ i j : Fin 3, g * g₁ = e9 i j * g) →
      (∃ i j : Fin 3, g * g₂ = e9 i j * g) → ∃ t ∈ T, g = f t.1 := by
  intro g h6 hg₁ hg₂
  have h := walkK_sound hw g
  have e6 : rd (enc g) 6 = (g 6 : ℕ) := rd_enc h16 g 6
  have e0 : Nat.beq (rd (enc g) 6) 6 = true := by
    rw [e6, h6]
    rfl
  rw [qN.eq_1, e0, nB_of hc9 h₁ hg₁, nB_of hc9 h₂ hg₂] at h
  simp only [Bool.not_true, Bool.false_or] at h
  rw [memK_iff, List.mem_map] at h
  obtain ⟨t, ht, he⟩ := h
  exact ⟨t, ht, enc_inj h16 (by rw [hT t ht, he])⟩

