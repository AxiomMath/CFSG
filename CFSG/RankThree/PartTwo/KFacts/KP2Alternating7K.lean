@[expose] noncomputable def nB (C c : ℕ) : Bool :=
  anyK (fun e => Nat.beq (mulK 7 c C) (mulK 7 e c)) (T9.map Prod.snd)

@[expose] noncomputable def qN (L : List ℕ) (c : ℕ) : Bool :=
  !Nat.beq (rd c 6) 6 || !nB 106180641 c || !nB 104153616 c || memK c L

theorem nB_of {e9 : Fin 3 → Fin 3 → Perm (Fin 7)}
    (hc9 : ∀ i j : Fin 3, enc (e9 i j) ∈ T9.map Prod.snd) {g c : Perm (Fin 7)} {C : ℕ}
    (hC : enc c = C) (h : ∃ i j : Fin 3, g * c = e9 i j * g) : nB C (enc g) = true := by
  obtain ⟨i, j, hij⟩ := h
  refine anyK_iff.2 ⟨enc (e9 i j), hc9 i j, ?_⟩
  change Nat.beq (mulK 7 (enc g) C) (mulK 7 (enc (e9 i j)) (enc g)) = true
  rw [← hC, ← enc_mul h16, ← enc_mul h16, hij]
  exact Nat.beq_refl _

