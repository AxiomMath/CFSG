@[expose] def lk (t i : ℕ) : ℕ := Nat.land (Nat.shiftRight t (10 * i)) 1023

theorem toList_tabA : tabA.toList = (List.range 820).map (lk pA) := by
  decide +kernel

theorem toList_tabB : tabB.toList = (List.range 820).map (lk pB) := by
  decide +kernel

theorem pBi_spec : ∀ i < 820, lk pBi i < 820 ∧ lk pB (lk pBi i) = i := by
  decide +kernel

theorem smul_eq (g : X₀) (i : Fin 820) : g • i = psi g i := rfl

theorem lk_eq_getElem {t : Array ℕ} {p : ℕ} (ht : t.toList = (List.range 820).map (lk p))
    (i : Fin 820) : lk p i = t[(i : ℕ)]! := by
  have hs : (i : ℕ) < t.size := by
    rw [← Array.length_toList, ht, List.length_map, List.length_range]
    exact i.2
  rw [getElem!_pos t (i : ℕ) hs, ← Array.getElem_toList]
  simp only [ht, List.getElem_map, List.getElem_range]

theorem lk_pA (i : Fin 820) : lk pA i = (psi xElt i : ℕ) := by
  rw [lk_eq_getElem toList_tabA i]
  exact rep_tabA i

theorem lk_pB (i : Fin 820) : lk pB i = (psi yElt i : ℕ) := by
  rw [lk_eq_getElem toList_tabB i]
  exact rep_tabB i

theorem lk_pBi (i : Fin 820) : lk pBi i = (psi yElt⁻¹ i : ℕ) := by
  obtain ⟨hlt, hinv⟩ := pBi_spec i i.2
  have h : psi yElt ⟨lk pBi i, hlt⟩ = i := Fin.ext (by rw [← lk_pB]; exact hinv)
  have h2 : (psi yElt)⁻¹ i = ⟨lk pBi i, hlt⟩ := by
    rw [Equiv.Perm.inv_eq_iff_eq]
    exact h.symm
  rw [map_inv, h2]

@[expose] noncomputable def genL (l : ℕ) : X₀ :=
  if l = 1 then xElt else if l = 2 then yElt else if l = 3 then yElt⁻¹ else 1

@[expose] def actL (l i : ℕ) : ℕ :=
  if l = 1 then lk pA i else if l = 2 then lk pB i else if l = 3 then lk pBi i else i

theorem actL_spec (l : ℕ) (i : Fin 820) : ((genL l • i : Fin 820) : ℕ) = actL l i := by
  unfold genL actL
  split_ifs
  · rw [smul_eq, lk_pA]
  · rw [smul_eq, lk_pB]
  · rw [smul_eq, lk_pBi]
  · rw [one_smul]

@[expose] def actP : ℕ → ℕ → ℕ → ℕ
  | 0, _, i => i
  | f + 1, w, i => if w = 0 then i else actP f (w / 4) (actL (w % 4) i)

@[expose] noncomputable def evalP : ℕ → ℕ → X₀
  | 0, _ => 1
  | f + 1, w => if w = 0 then 1 else evalP f (w / 4) * genL (w % 4)

theorem actP_spec (f w : ℕ) (i : Fin 820) : ((evalP f w • i : Fin 820) : ℕ) = actP f w i := by
  induction f generalizing w i with
  | zero => simp [evalP, actP]
  | succ f ih =>
    by_cases hw : w = 0
    · simp [evalP, actP, hw]
    · simp only [evalP, actP, hw, ↓reduceIte, mul_smul]
      rw [ih, actL_spec]

@[expose] def act (w i : ℕ) : ℕ := actP 64 w i

@[expose] noncomputable def ev (w : ℕ) : X₀ := evalP 64 w

theorem act_spec (w : ℕ) (i : Fin 820) : ((ev w • i : Fin 820) : ℕ) = act w i :=
  actP_spec 64 w i

@[expose] def invL (l : ℕ) : ℕ := if l = 2 then 3 else if l = 3 then 2 else l

@[expose] def invPF : ℕ → ℕ → ℕ → ℕ
  | 0, _, acc => acc
  | f + 1, w, acc => if w = 0 then acc else invPF f (w / 4) (acc * 4 + invL (w % 4))

@[expose] def invP (w : ℕ) : ℕ := invPF 64 w 0

noncomputable abbrev chQ : RawSchreierDatum 820 :=
  RawSchreierDatum.ofArrays 820 (by norm_num) chainS 2 (by decide) chainBase (by decide) chainW

theorem chQ_base_toList : chQ.base.toList = [0, 1, 9] :=
  RawSchreierDatum.ofArrays_base_toList

theorem eq_of_rep {n : ℕ} {t : Array ℕ} {g g' : Equiv.Perm (Fin n)}
    (h : CFSG.Monster.B.Co2.Rep n t g) (h' : CFSG.Monster.B.Co2.Rep n t g') : g = g' :=
  Equiv.ext fun i => Fin.ext (by rw [← h i, ← h' i])

theorem chQ_base_get (i : Fin chQ.baseCount) :
    chQ.base.get i = 0 ∨ chQ.base.get i = 1 ∨ chQ.base.get i = 9 := by
  have hmem : chQ.base.get i ∈ chQ.base.toList := by
    rw [Vector.mem_toList_iff]
    exact Vector.getElem_mem i.2
  rw [chQ_base_toList] at hmem
  simpa using hmem

section Base


theorem validSchreier_chQ : ValidSchreier chQ :=
  (validSchreier_of_chainOK (chainArrays_ofArrays (chainCheckFacts chain_check).strong_inv)
    (by norm_num) chain_check).1

theorem chQ_eq : chQ.originalSubgroup = Subgroup.closure {psi xElt, psi yElt} := by
  rw [RawSchreierDatum.originalSubgroup]
  congr 1
  ext g
  simp only [chQ, Set.mem_ofPred_eq, RawSchreierDatum.mem_ofArrays_original, Set.mem_insert_iff,
    Set.mem_singleton_iff]
  have h0 := (CFSG.Monster.B.Co2.rep_permOfArr
    ((chainCheckFacts chain_check).strong_inv 0 (by decide))).1
  have h1 := (CFSG.Monster.B.Co2.rep_permOfArr
    ((chainCheckFacts chain_check).strong_inv 1 (by decide))).1
  have e0 : CFSG.Monster.B.Co2.permOfArr 820 chainS[0]! = psi xElt := eq_of_rep h0 rep_tabA
  have e1 : CFSG.Monster.B.Co2.permOfArr 820 chainS[1]! = psi yElt := eq_of_rep h1 rep_tabB
  constructor
  · rintro ⟨i, hi, rfl⟩
    interval_cases i
    · exact Or.inl e0
    · exact Or.inr e1
  · rintro (rfl | rfl)
    · exact ⟨0, by norm_num, e0⟩
    · exact ⟨1, by norm_num, e1⟩

theorem psi_mem_chQ (g : X₀) : psi g ∈ chQ.originalSubgroup := by
  rw [chQ_eq, ← Set.image_pair, ← MonoidHom.map_closure, closure_xy]
  exact ⟨g, Subgroup.mem_top g, rfl⟩

theorem eq_of_base {g h : X₀} (h0 : psi g 0 = psi h 0) (h1 : psi g 1 = psi h 1)
    (h9 : psi g 9 = psi h 9) : g = h := by
  apply psi_injective
  obtain ⟨-, huniq, -, -⟩ := chQ.schreier_base_image_decoding validSchreier_chQ
    (fun i => psi g (chQ.base.get i))
  have hbase : ∀ i, psi h (chQ.base.get i) = psi g (chQ.base.get i) := by
    intro i
    rcases chQ_base_get i with e | e | e <;> rw [e] <;> symm <;> assumption
  have e1 := (huniq (psi g)).2 ⟨psi_mem_chQ g, fun i => rfl⟩
  have e2 := (huniq (psi h)).2 ⟨psi_mem_chQ h, hbase⟩
  rw [e1] at e2
  exact Option.some_injective _ e2

theorem eq_of_smul_base {g h : X₀} (h0 : ((g • (0 : Fin 820) : Fin 820) : ℕ) = (h • 0 : Fin 820))
    (h1 : ((g • (1 : Fin 820) : Fin 820) : ℕ) = (h • 1 : Fin 820))
    (h9 : ((g • (9 : Fin 820) : Fin 820) : ℕ) = (h • 9 : Fin 820)) : g = h :=
  eq_of_base (Fin.ext h0) (Fin.ext h1) (Fin.ext h9)

