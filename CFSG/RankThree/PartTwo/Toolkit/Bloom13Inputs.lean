  ⟨0, 0, 1, 0, 2, 2, 1, 1, 1⟩]

@[expose] def cover13 : List R9 :=
  f0R.filter (fun r => r != rone) ++ nf0Pairs.flatMap fun p => reps13.flatMap fun r =>
    (List.range 12).map fun k => rmul (rmul p.1 (rpowR r (k + 1))) p.2

@[expose] def f0Codes : List ℕ := f0R.map code

@[expose] def cover13Codes : List ℕ :=
  f0Codes.filter (fun c => c != 6643) ++ nf0Pairs.flatMap fun p => reps13.flatMap fun r =>
    (List.range 12).map fun k => nmul (nmul (code p.1) (npow (code r) (k + 1))) (code p.2)

@[expose] def coverMask : ℕ := codeMask cover13Codes

@[expose] def nfMask : ℕ := codeMask (nf0Pairs.map fun p => code p.1)

@[expose] def bloom13At (r : ℕ) (F : List ℕ) (N M c : ℕ) : Bool :=
  (ndet c == 0 || !(F.any fun p => nmul c r == nmul p c) || N.testBit c) &&
  (!(npow c 13 == 6643 && c != 6643) || M.testBit c)

@[expose] def bloom13Tree (k : ℕ) : Bool :=
  let t := bl13Trees.getD k (0, 0, 0)
  slCoverP [code cR, code (reps13.getD k rone)] t.1 t.2.1 t.2.2 5616

@[expose] def bloom13Check : Bool :=
  rpowR cR 13 == rone && cR != rone &&
  (nf0Pairs.all fun p => rmul p.1 p.2 == rone && f0R.contains (rmul (rmul p.1 cR) p.2) &&
    rdet p.1 != 0) &&
  decide (nf0Pairs.map Prod.fst).Nodup &&
  (List.range 19683).all (bloom13At (code cR) f0Codes nfMask coverMask) &&
  (reps13.all fun r => rdet r != 0 && rpowR r 13 == rone) && reps13.length == 7 &&
  (List.range 7).all bloom13Tree

