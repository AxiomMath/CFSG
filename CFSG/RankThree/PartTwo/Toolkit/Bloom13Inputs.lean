@[expose] def reps13 : List R9 :=
  [⟨0, 0, 1, 0, 1, 1, 2, 1, 1⟩, ⟨0, 0, 1, 0, 1, 1, 2, 1, 2⟩, ⟨0, 0, 1, 0, 1, 1, 2, 2, 0⟩,
