namespace CFSG.RankThree.PartTwo.Sec10.KS1012GL34.Light

open CFSG.Fischer

structure M3 where
  a00 : F4
  a01 : F4
  a02 : F4
  a10 : F4
  a11 : F4
  a12 : F4
  a20 : F4
  a21 : F4
  a22 : F4
deriving DecidableEq

structure V3 where
  x : F4
  y : F4
  z : F4
deriving DecidableEq

@[expose] def oneL : M3 := ⟨1, 0, 0, 0, 1, 0, 0, 0, 1⟩

@[expose] def XdL : M3 := ⟨1, 0, 0, 0, ⟨3⟩, 0, 0, 0, ⟨2⟩⟩

@[expose] def ZsL : M3 := ⟨⟨2⟩, 0, 0, 0, ⟨2⟩, 0, 0, 0, ⟨2⟩⟩

@[expose] def WmL (μ : F4) : M3 := ⟨0, 0, μ, 1, 0, 0, 0, 1, 0⟩

@[expose] def E01L : M3 := ⟨1, 1, 0, 0, 1, 0, 0, 0, 1⟩
@[expose] def E02L : M3 := ⟨1, 0, 1, 0, 1, 0, 0, 0, 1⟩
@[expose] def E10L : M3 := ⟨1, 0, 0, 1, 1, 0, 0, 0, 1⟩
@[expose] def E12L : M3 := ⟨1, 0, 0, 0, 1, 1, 0, 0, 1⟩
@[expose] def E20L : M3 := ⟨1, 0, 0, 0, 1, 0, 1, 0, 1⟩
@[expose] def E21L : M3 := ⟨1, 0, 0, 0, 1, 0, 0, 1, 1⟩

@[expose] def mulL (A B : M3) : M3 :=
  ⟨A.a00 * B.a00 + A.a01 * B.a10 + A.a02 * B.a20, A.a00 * B.a01 + A.a01 * B.a11 + A.a02 * B.a21,
    A.a00 * B.a02 + A.a01 * B.a12 + A.a02 * B.a22,
    A.a10 * B.a00 + A.a11 * B.a10 + A.a12 * B.a20, A.a10 * B.a01 + A.a11 * B.a11 + A.a12 * B.a21,
    A.a10 * B.a02 + A.a11 * B.a12 + A.a12 * B.a22,
    A.a20 * B.a00 + A.a21 * B.a10 + A.a22 * B.a20, A.a20 * B.a01 + A.a21 * B.a11 + A.a22 * B.a21,
    A.a20 * B.a02 + A.a21 * B.a12 + A.a22 * B.a22⟩

@[expose] def mulV (A : M3) (v : V3) : V3 :=
  ⟨A.a00 * v.x + A.a01 * v.y + A.a02 * v.z, A.a10 * v.x + A.a11 * v.y + A.a12 * v.z,
    A.a20 * v.x + A.a21 * v.y + A.a22 * v.z⟩

@[expose] def smulV (c : F4) (v : V3) : V3 := ⟨c * v.x, c * v.y, c * v.z⟩

@[expose] def detL (A : M3) : F4 :=
  A.a00 * (A.a11 * A.a22 - A.a12 * A.a21) - A.a01 * (A.a10 * A.a22 - A.a12 * A.a20) +
    A.a02 * (A.a10 * A.a21 - A.a11 * A.a20)

@[expose] def allF4 : List F4 := [0, 1, F4.ω, ⟨3⟩]

@[expose] def allM3L (_ : Unit := ()) : List M3 :=
  allF4.flatMap fun a00 => allF4.flatMap fun a01 => allF4.flatMap fun a02 =>
  allF4.flatMap fun a10 => allF4.flatMap fun a11 => allF4.flatMap fun a12 =>
  allF4.flatMap fun a20 => allF4.flatMap fun a21 => allF4.map fun a22 =>
    (⟨a00, a01, a02, a10, a11, a12, a20, a21, a22⟩ : M3)

@[expose] def NZL : List F4 := [1, F4.ω, ⟨3⟩]

@[expose] def omegaL : Nat → List V3
  | 0 => [⟨1, 1, 1⟩, ⟨1, ⟨3⟩, ⟨3⟩⟩, ⟨1, F4.ω, ⟨3⟩⟩, ⟨1, 1, F4.ω⟩, ⟨1, ⟨3⟩, F4.ω⟩, ⟨1, F4.ω, 1⟩]
  | 1 => [⟨0, 0, 1⟩, ⟨1, F4.ω, F4.ω⟩, ⟨0, 1, 0⟩, ⟨1, 0, 0⟩, ⟨1, 1, ⟨3⟩⟩, ⟨1, ⟨3⟩, 1⟩]
  | 2 => [⟨0, 0, 1⟩, ⟨1, ⟨3⟩, ⟨3⟩⟩, ⟨1, 0, 0⟩, ⟨1, F4.ω, 1⟩, ⟨1, 1, F4.ω⟩, ⟨0, 1, 0⟩]
  | 3 => [⟨1, 1, 1⟩, ⟨1, ⟨3⟩, 1⟩, ⟨1, 1, ⟨3⟩⟩, ⟨1, F4.ω, ⟨3⟩⟩, ⟨1, ⟨3⟩, F4.ω⟩, ⟨1, F4.ω, F4.ω⟩]
  | 4 => [⟨1, 1, F4.ω⟩, ⟨1, ⟨3⟩, ⟨3⟩⟩, ⟨1, F4.ω, 1⟩, ⟨1, 1, ⟨3⟩⟩, ⟨1, F4.ω, F4.ω⟩, ⟨1, ⟨3⟩, 1⟩]
  | 5 => [⟨0, 0, 1⟩, ⟨1, F4.ω, ⟨3⟩⟩, ⟨1, ⟨3⟩, F4.ω⟩, ⟨1, 1, 1⟩, ⟨1, 0, 0⟩, ⟨0, 1, 0⟩]
  | _ => []

@[expose] def stabOf (Om Av : List V3) : Bool :=
  Av.all fun x => Om.any fun u => NZL.any fun c => x == smulV c u

@[expose] def stabLn (k : Nat) (A : M3) : Bool :=
  stabOf (omegaL k) ((omegaL k).map (mulV A))

@[expose] def sameLv (Bv Au : List V3) : Bool :=
  Bv.all fun x => Au.any fun y => NZL.any fun c => x == smulV c y

@[expose] def plistOf (all : List M3) (k : Nat) : List M3 :=
  all.filter fun A => detL A == 1 && stabLn k A

@[expose] def plistArr (all : List M3) : List (List M3) :=
  [plistOf all 0, plistOf all 1, plistOf all 2, plistOf all 3, plistOf all 4, plistOf all 5]

@[expose] def evalL (gens : List M3) (w : List Nat) : M3 :=
  w.foldl (fun acc k => mulL acc (gens.getD k oneL)) oneL

@[expose] def decodeW (s : String) : List Nat := s.toList.map fun c => c.toNat - 48

@[expose] def decodeF4 (c : Char) : F4 := ⟨⟨(c.toNat - 48) % 4, Nat.mod_lt _ (by decide)⟩⟩

@[expose] def decodeM3 (s : String) : M3 :=
  match s.toList.map decodeF4 with
  | [a00, a01, a02, a10, a11, a12, a20, a21, a22] => ⟨a00, a01, a02, a10, a11, a12, a20, a21, a22⟩
  | _ => oneL

structure Words6 where
  e01 : String
  e02 : String
  e10 : String
  e12 : String
  e20 : String
  e21 : String

@[expose] def checkW6 (gens : List M3) (w : Words6) : Bool :=
  (evalL gens (decodeW w.e01) == E01L) && (evalL gens (decodeW w.e02) == E02L) &&
  (evalL gens (decodeW w.e10) == E10L) && (evalL gens (decodeW w.e12) == E12L) &&
  (evalL gens (decodeW w.e20) == E20L) && (evalL gens (decodeW w.e21) == E21L)

@[expose] def gensT3 (μ : F4) (A : M3) : List M3 :=
  [XdL, mulL XdL XdL, WmL μ, mulL (WmL μ) (WmL μ), ZsL, mulL ZsL ZsL, A]

@[expose] def lettersL (A : M3) : List M3 :=
  [A, mulL (mulL XdL A) (mulL XdL XdL), mulL (mulL (mulL XdL XdL) A) XdL]

@[expose] def words3L (A : M3) : List M3 :=
  let L := lettersL A
  L ++ L.flatMap (fun a => L.map fun b => mulL a b) ++
    L.flatMap (fun a => L.flatMap fun b => L.map fun c => mulL (mulL a b) c)

@[expose] def pow4L (w : M3) : M3 := mulL (mulL w w) (mulL w w)

@[expose] def goodL (A : M3) : Bool :=
  (mulL A A == oneL) && (A != oneL) && (words3L A).all fun w => pow4L w == oneL

@[expose] def isRootL (A : M3) : Bool :=
  (A.a00 == 1) && (A.a11 == 1) && (A.a22 == 1) &&
    ([A.a01, A.a02, A.a10, A.a12, A.a20, A.a21].filter fun c => c != 0).length == 1

@[expose] def addProd (gens : List M3) (g : M3) (st : List M3 × List M3) : List M3 × List M3 :=
  gens.foldl (fun st x =>
    let h := mulL g x
    if st.2.contains h then st else (st.1 ++ [h], st.2 ++ [h])) st

@[expose] def bfsFuel (gens : List M3) : Nat → List M3 → List M3 → List M3
  | 0, _, seen => seen
  | _ + 1, [], seen => seen
  | n + 1, g :: q, seen =>
    let st := addProd gens g (q, seen)
    bfsFuel gens n st.1 st.2

@[expose] def groupL (gens : List M3) : List M3 := bfsFuel gens 1200 [oneL] [oneL]

structure T3Row where
  code : String
  wOne : Words6
  wOm : Words6
  wOm2 : Words6
  idx : Nat

@[expose] def checkNonRoot (ps : List (List M3)) (A : M3) (k : Nat) : Bool :=
  let G := groupL [XdL, WmL 1, ZsL, A]
  (k < 6) && (detL A == 1) && stabLn k A && (ps.getD k []).all fun p => G.contains p

@[expose] def checkT3Row (ps : List (List M3)) (r : T3Row) : Bool :=
  let A := decodeM3 r.code
  checkW6 (gensT3 F4.ω A) r.wOm && checkW6 (gensT3 ⟨3⟩ A) r.wOm2 &&
    cond (isRootL A) (checkW6 (gensT3 1 A) r.wOne) (checkNonRoot ps A r.idx)

@[expose] def fc0Check (all : List M3) (rows : List T3Row) : Bool :=
  all.all fun A => !(goodL A) || rows.any fun r => decodeM3 r.code == A

structure T4Row where
  rep : String
  words : Words6

structure T4Block where
  r : String
  rows : List T4Row

@[expose] def checkT4Block (i : Nat) (b : T4Block) (sl : List M3) : Bool :=
  let r := decodeM3 b.r
  let Om := omegaL i
  let Rv := b.rows.map fun e => (decodeM3 e.rep, Om.map (mulV (decodeM3 e.rep)))
  (detL r == 1) && stabLn i r &&
    b.rows.all (fun e => (detL (decodeM3 e.rep) == 1) &&
      checkW6 [XdL, WmL 1, ZsL, r, decodeM3 e.rep] e.words) &&
    sl.all fun A =>
      let Au := Om.map (mulV A)
      stabOf Om Au || Rv.any fun p => sameLv Au p.2

