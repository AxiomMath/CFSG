theorem kFG2Ord3InvTwo_holds :
    KFG2Ord3InvTwo := by
  intro k _ _ hk y hy
  classical
  have : Fintype k := Fintype.ofFinite k
  have hF : Fintype.card k = 2 := by rw [← Nat.card_eq_fintype_card, hk]
  have : CharP k 2 := charP_of_card_eq_prime_pow (f := 1) (by rw [hF, pow_one])
  let ε : k ≃+* ZMod 2 := (ZMod.ringEquivOfPrime k Nat.prime_two hF).symm
  obtain ⟨E⟩ := Sec11.KS11Lie3Proof.nonempty_adjointGroup_g2_mulEquiv_quasithinG2 hk
  let Θ : ↥(cayleyGroup k) ≃* ↥(cayleyGroup (ZMod 2)) :=
    ((zornConj ε).subgroupMap _).trans (MulEquiv.subgroupCongr (map_cayleyGroup ε))
  let φ : adjointGroup .G2 k ≃* ↥(cayleyGroup (ZMod 2)) :=
    (E.trans (MulEquiv.subgroupCongr
      (CFSG.Quasithin.G11.P3G2.quasithinG2_eq_cayleyGroup (K := k)))).trans Θ
  have hcard : Nat.card ↥(cayleyGroup (ZMod 2)) = 12096 := by
    rw [← Nat.card_congr φ.toEquiv, CFSG.Timmesfeld.ExceptionalOrders.card_adjointGroup_G2, hk]
    rfl
  obtain ⟨j, hj1, hj2, hjy⟩ :=
    forall_commute_involution_cayley hcard (φ y) (by rw [MulEquiv.orderOf_eq, hy])
  refine ⟨φ.symm j, fun h => hj1 (by rw [← φ.apply_symm_apply j, h, map_one]), ?_, ?_⟩
  · rw [← map_pow, hj2, map_one]
  · apply φ.injective
    rw [map_mul, map_mul, MulEquiv.apply_symm_apply, hjy]

theorem kFG2Ord3Inv_of_minus
    (hMinus : Sec11.KS11Lie4Proof.G2ThreeConjSL2Minus) : KFG2Ord3Inv :=
  kFG2Ord3Inv_of hMinus kFG2Ord3InvTwo_holds

