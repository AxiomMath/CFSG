theorem exists_mul_pow_inn_g2 {Kf : Type} [Field Kf] [Finite Kf] (hK3 : ringChar Kf ≠ 3)
    (hK4 : 4 ≤ Nat.card Kf) {p f : ℕ} (hp : p.Prime) (hf : 1 ≤ f) (hKf : Nat.card Kf = p ^ f)
    {A B : MulAut (adjointGroup Tag.G2 Kf)} (hA3 : A ^ 3 = 1) (hB3 : B ^ 3 = 1)
    (hAout : ¬ KFacts.IsInnerAut A) (hBout : ¬ KFacts.IsInnerAut B) :
    ∃ j : ℕ, KFacts.IsInnerAut (A * B ^ j) := by
  obtain ⟨σ₁, hσ₁, k₁, hA⟩ := KFacts.g2_order_three_field_descent hK3 hK4 hA3 hAout
  obtain ⟨σ₂, hσ₂, k₂, hB⟩ := KFacts.g2_order_three_field_descent hK3 hK4 hB3 hBout
  have h3 : σ₁ ^ 3 = 1 := by rw [← hσ₁]; exact pow_orderOf_eq_one σ₁
  have hΦ : ∀ (σ : Kf ≃+* Kf) (t : adjointGroup Tag.G2 Kf), ∃ t' : adjointGroup Tag.G2 Kf,
      KFacts.g2FieldHom Kf σ * MulAut.conj t * (KFacts.g2FieldHom Kf σ)⁻¹ = MulAut.conj t' :=
    fun σ t => ⟨_, KFacts.mul_mulAutConj_mul_inv _ t⟩
  obtain ⟨t₁, ht₁⟩ := exists_conj_mul_inv_eq_of_normalizes
    (MulAut.conj : adjointGroup Tag.G2 Kf →* MulAut (adjointGroup Tag.G2 Kf))
    (KFacts.g2FieldHom Kf σ₁) (hΦ σ₁) k₁
  obtain ⟨t₂, ht₂⟩ := exists_conj_mul_inv_eq_of_normalizes
    (MulAut.conj : adjointGroup Tag.G2 Kf →* MulAut (adjointGroup Tag.G2 Kf))
    (KFacts.g2FieldHom Kf σ₂) (hΦ σ₂) k₂
  obtain ⟨j, hj⟩ := exists_mul_pow_mem_range_of_normalizes
    (MulAut.conj : adjointGroup Tag.G2 Kf →* MulAut (adjointGroup Tag.G2 Kf))
    (KFacts.g2FieldHom Kf) hΦ (ringAut_order_three_rel hp hf hKf hσ₁ hσ₂) h3 t₁ t₂
  refine ⟨j, ?_⟩
  rw [hA, hB, ht₁, ht₂]
  exact hj

theorem kF418OuterOn_G2Six_of_gTwoTwo (hG2 : Sec8.Item86ResProof.KF83GTwoTwo) :
    KF418OuterOn (fun X _ => IsGTwoSix X) := by
  intro G _ _ L hL hl a b ha3 hb3 hab hb1 habz haN hbN hbC haC K hK n hn htype hKa hbk
  obtain ⟨f, ⟨m, rfl⟩, hX⟩ := hl
  have hm1 : 1 ≤ m := by
    have := hX.1.2.1
    omega
  have c := Cfg.of_model hK ha3 hb3 hab haN hbN hbC haC hKa
  have hKq := Sec6.isQuasisimple_of_mem_thetaComponentsIn hK
  have hβ : Sec4.InducesOuterTheta b L := by
    rcases hbk with h | h
    · exact KFacts.InducesStdKind.inducesOuterTheta (k := .field) L h (by decide)
    · exact KFacts.InducesStdKind.inducesOuterTheta (k := .graphField) L h (by decide)
  obtain ⟨Kf, _, _, hKf, ⟨e⟩⟩ := Sec4.exists_mulEquiv_adjointGroup_G2 hX
  obtain ⟨-, k, _, _, hk, ⟨eC⟩⟩ :=
    KFacts.barCentralizer_mulEquiv_g2 (n := m) (by omega) hKf hb3 hβ e
  have hZ : Subgroup.center (L ⧸ aschbacherSolvableCore 3 L) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hex : e x ∈ Subgroup.center (adjointGroup Tag.G2 Kf) := by
      rw [← map_center_eq e]
      exact ⟨x, hx, rfl⟩
    rw [center_adjointGroup_eq_bot, Subgroup.mem_bot] at hex
    rw [Subgroup.mem_bot]
    exact e.injective (by rw [hex, map_one])
  by_cases hm : m = 1
  ·
    subst hm
    obtain ⟨kk, hkk⟩ := c.exists_nine_dvd_orderOf_rhoK (hasNineQuot_of_isType418 hn hKq htype)
    set z : L ⧸ aschbacherSolvableCore 3 L :=
      ((⟨(kk : G), c.hKL kk.2⟩ : L) : L ⧸ aschbacherSolvableCore 3 L) with hz
    have hρ : rhoK c.hKL kk = MulAut.conj z := rho_eq_conj L (c.hKL kk.2)
    have hz9 : 9 ∣ orderOf z := by
      have h1 : orderOf (MulAut.conj z) = orderOf z :=
        orderOf_injective _ (conj_injective_of_center_eq_bot hZ) z
      rw [← h1, ← hρ]
      exact hkk
    have hzK : z ∈ Sec8.imageModTheta L K :=
      ⟨⟨kk, c.hKL kk.2⟩, Subgroup.mem_subgroupOf.mpr kk.2, rfl⟩
    have hzC : z ∈ Sec8.barCentralizer (Subgroup.zpowers b) L :=
      Sec8.Item86ResProof.imageModTheta_le_barCentralizer c.hbL c.hKb hzK
    set g := eC ⟨z, hzC⟩ with hg
    have hgo : orderOf g = orderOf z := by
      rw [hg, MulEquiv.orderOf_eq, Subgroup.orderOf_mk]
    obtain ⟨t, ht⟩ : 9 ∣ orderOf g := hgo ▸ hz9
    have ht0 : t ≠ 0 := by
      rintro rfl
      have := orderOf_pos g
      omega
    have hdvd : t ∣ orderOf g := ⟨9, by rw [ht, mul_comm]⟩
    have h9 : orderOf (g ^ t) = 9 := by
      rw [orderOf_pow_of_dvd ht0 hdvd, ht, Nat.mul_div_cancel _ (Nat.pos_of_ne_zero ht0)]
    exact hG2 k (by rw [hk]; norm_num) (g ^ t) h9
  ·
    have hm2 : 2 ≤ m := by omega
    have hmodel : Blueprint.ChevalleyExceptionalModel
        ↥(Sec8.barCentralizer (Subgroup.zpowers b) L) .G2 2 m := by
      refine ⟨⟨Nat.prime_two, hm1, rfl, ?_⟩, k, inferInstance, inferInstance, hk, ⟨?_⟩⟩
      · calc 3 ≤ 2 ^ 2 := by norm_num
          _ ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) hm2
      · exact eC.trans (QuotientGroup.quotientBot.symm.trans (QuotientGroup.quotientMulEquivOfEq
          (center_adjointGroup_eq_bot (τ := Tag.G2) (K := k)).symm))
    have hsimple := (CFSG.LieType.Simplicity.fam_g2_simplicity _ 2 m hmodel).2
    have hC := barCentralizer_le_imageModTheta_of_simple c.hbL hb3 hK hsimple
      (imageModTheta_ne_bot c.hKL hKq)
    have hinn : ∃ j : ℕ, c.alpha * c.beta ^ j ∈ innBar L := by
      have hA3 : KFacts.inducedAutHom L e ⟨a, c.haL⟩ ^ 3 = 1 :=
        KFacts.inducedAutHom_pow_eq_one L e c.haL c.ha3
      have hB3 : KFacts.inducedAutHom L e ⟨b, c.hbL⟩ ^ 3 = 1 :=
        KFacts.inducedAutHom_pow_eq_one L e c.hbL c.hb3
      have hBout : ¬ KFacts.IsInnerAut (KFacts.inducedAutHom L e ⟨b, c.hbL⟩) :=
        (KFacts.not_isInnerAut_inducedAutHom_iff L e c.hbL).mpr hβ
      by_cases hAin : KFacts.IsInnerAut (KFacts.inducedAutHom L e ⟨a, c.haL⟩)
      · refine ⟨0, ?_⟩
        rw [pow_zero, mul_one]
        exact (KFacts.isInnerAut_congr e c.alpha).mp hAin
      · have : Fintype Kf := Fintype.ofFinite Kf
        have hcharP : CharP Kf 2 := charP_of_card_eq_prime_pow (f := 3 * m)
          (by rw [← Nat.card_eq_fintype_card, hKf])
        have hK3 : ringChar Kf ≠ 3 := by
          rw [ringChar.eq Kf 2]
          norm_num
        have hK4 : 4 ≤ Nat.card Kf := by
          rw [hKf]
          calc 4 ≤ 2 ^ 3 := by norm_num
            _ ≤ 2 ^ (3 * m) := Nat.pow_le_pow_right (by norm_num) (by omega)
        obtain ⟨j, hj⟩ := exists_mul_pow_inn_g2 hK3 hK4 Nat.prime_two (by omega : 1 ≤ 3 * m) hKf
          hA3 hB3 hAin hBout
        refine ⟨j, ?_⟩
        have h1 : KFacts.inducedAutHom L e ⟨a, c.haL⟩ *
            KFacts.inducedAutHom L e ⟨b, c.hbL⟩ ^ j = MulAut.congr e (c.alpha * c.beta ^ j) := by
          rw [map_mul, map_pow]
          rfl
        rw [h1] at hj
        exact (KFacts.isInnerAut_congr e _).mp hj
    exact c.false_of_outer_core hZ hinn hC


