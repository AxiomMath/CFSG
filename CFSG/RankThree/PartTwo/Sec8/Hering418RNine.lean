theorem exists_cubic_root {K : Type*} [Field K] [Finite K] [CharP K 2]
    (h7 : 7 ∣ Nat.card K - 1) : ∃ t : K, t ^ 3 + t + 1 = 0 ∧ t ^ 7 = 1 := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hdvd : 7 ∣ Nat.card Kˣ := by rwa [Nat.card_units]
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := Kˣ) 7 hdvd
  have hζ7 : (ζ : K) ^ 7 = 1 := by
    rw [← Units.val_pow_eq_pow_val, ← hζ, pow_orderOf_eq_one, Units.val_one]
  have hζ1 : (ζ : K) ≠ 1 := fun h => by
    have : ζ = 1 := Units.ext h
    rw [this, orderOf_one] at hζ
    norm_num at hζ
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  have hcyc : (ζ : K) ^ 6 + ζ ^ 5 + ζ ^ 4 + ζ ^ 3 + ζ ^ 2 + ζ + 1 = 0 := by
    have : ((ζ : K) - 1) * ((ζ : K) ^ 6 + ζ ^ 5 + ζ ^ 4 + ζ ^ 3 + ζ ^ 2 + ζ + 1) = 0 := by
      linear_combination hζ7
    rcases mul_eq_zero.mp this with h | h
    · exact absurd (sub_eq_zero.mp h) hζ1
    · exact h
  have hfac : ((ζ : K) ^ 3 + ζ + 1) * ((ζ : K) ^ 3 + ζ ^ 2 + 1) = 0 := by
    linear_combination hcyc + (ζ : K) ^ 3 * h2
  rcases mul_eq_zero.mp hfac with h | h
  · exact ⟨ζ, h, hζ7⟩
  · have hz0 : (ζ : K) ≠ 0 := Units.ne_zero ζ
    refine ⟨(ζ : K)⁻¹, ?_, by rw [inv_pow, hζ7, inv_one]⟩
    have : ((ζ : K)⁻¹) ^ 3 + (ζ : K)⁻¹ + 1 = ((ζ : K) ^ 3 + ζ ^ 2 + 1) / (ζ : K) ^ 3 := by
      field_simp
      ring
    rw [this, h, zero_div]

theorem pow_eight_pow_eq_self {K : Type*} [Field K] {t : K} (h : t ^ 7 = 1) (n : ℕ) :
    t ^ (8 ^ n) = t := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, pow_mul, ih]
    calc t ^ 8 = t ^ 7 * t := by ring
      _ = t := by rw [h, one_mul]

end Field

section Elements

open CFSG.Assembly.RankThreeEven (projSL)

variable {F : Type*} [Field F]

@[expose] def glOfDet {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) : GL (Fin n) F :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero A (by rw [h]; exact one_ne_zero)

theorem glOfDet_coe {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) :
    (glOfDet A h : Matrix (Fin n) (Fin n) F) = A := rfl

theorem glOfDet_pow_coe {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) (k : ℕ) :
    ((glOfDet A h ^ k : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) = A ^ k := by
  rw [Units.val_pow_eq_pow_val, glOfDet_coe]

theorem glOfDet_pow_eq_one {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) {k : ℕ}
    (hk : A ^ k = 1) : glOfDet A h ^ k = 1 :=
  Units.ext (by rw [glOfDet_pow_coe, hk]; rfl)

theorem glOfDet_mem_slCore {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) :
    glOfDet A h ∈ CFSG.MatrixModel.slCore (Fin n) F := by
  rw [CFSG.MatrixModel.slCore, MonoidHom.mem_ker]
  apply Units.ext
  simpa [Matrix.GeneralLinearGroup.val_det_apply, glOfDet_coe] using h

theorem scalar_offdiag {n : ℕ} (u : Fˣ) {i j : Fin n} (hij : i ≠ j) :
    ((Matrix.GeneralLinearGroup.scalar (Fin n) u : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F) i j = 0 := by
  simp [Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, Matrix.diagonal_apply_ne _ hij]

theorem scalar_diag {n : ℕ} (u : Fˣ) (i j : Fin n) :
    ((Matrix.GeneralLinearGroup.scalar (Fin n) u : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F) i i =
    ((Matrix.GeneralLinearGroup.scalar (Fin n) u : GL (Fin n) F) :
      Matrix (Fin n) (Fin n) F) j j := by
  simp [Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply]

@[expose] noncomputable def projSLOfDet {n : ℕ} (A : Matrix (Fin n) (Fin n) F)
    (h : A.det = 1) : projSL n F :=
  ⟨Matrix.ProjGenLinGroup.mk (glOfDet A h), Subgroup.mem_map_of_mem _ (glOfDet_mem_slCore A h)⟩

theorem projSLOfDet_pow_val {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) (k : ℕ) :
    ((projSLOfDet A h ^ k : projSL n F) : Matrix.ProjGenLinGroup (Fin n) F) =
      Matrix.ProjGenLinGroup.mk (glOfDet A h ^ k) := by
  rw [Subgroup.coe_pow, map_pow]
  rfl

theorem projSLOfDet_pow_eq_one {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (h : A.det = 1) {k : ℕ}
    (hk : A ^ k = 1) : projSLOfDet A h ^ k = 1 := by
  apply Subtype.ext
  rw [projSLOfDet_pow_val, glOfDet_pow_eq_one A h hk]
  rfl

theorem projSLOfDet_pow_ne_one_of_offdiag {n : ℕ} (A : Matrix (Fin n) (Fin n) F)
    (h : A.det = 1) {k : ℕ} {i j : Fin n} (hij : i ≠ j) (hne : (A ^ k) i j ≠ 0) :
    projSLOfDet A h ^ k ≠ 1 := by
  intro h1
  have h2 : Matrix.ProjGenLinGroup.mk (glOfDet A h ^ k) = 1 := by
    rw [← projSLOfDet_pow_val, h1]
    rfl
  rw [Matrix.ProjGenLinGroup.mk_eq_one, Matrix.GeneralLinearGroup.center_eq_range_scalar] at h2
  obtain ⟨u, hu⟩ := h2
  have := congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F) i j) hu
  simp only [glOfDet_pow_coe] at this
  exact hne (this.symm.trans (scalar_offdiag u hij))

end Elements

section Types

open CFSG.Assembly.RankThreeEven (projSL)
open CFSG.AGLEmbeddingD2.Wilson.Coordinator.KF418 (admissible_psl sixtythree_dvd map_center_eq)

theorem mem_center_equiv_iff {X Y : Type*} [Group X] [Group Y] (e : X ≃* Y) (x : X) :
    x ∈ Subgroup.center X ↔ e x ∈ Subgroup.center Y := by
  rw [← map_center_eq e, Subgroup.mem_map_equiv, MulEquiv.symm_apply_apply]

theorem HasNineQuot.of_equiv {X Y : Type*} [Group X] [Group Y] (e : X ≃* Y)
    (h : HasNineQuot Y) : HasNineQuot X := by
  obtain ⟨y, h9, h3⟩ := h
  refine ⟨e.symm y, ?_, ?_⟩
  · rw [← map_pow, ← mem_center_equiv_iff e.symm]
    exact h9
  · rw [← map_pow, ← mem_center_equiv_iff e.symm]
    exact h3

theorem hasNineQuot_of_equiv {X Y : Type*} [Group X] [Group Y] (e : X ≃* Y)
    (hZ : Subgroup.center X = ⊥) (y : Y) (h9 : y ^ 9 = 1) (h3 : y ^ 3 ≠ 1) : HasNineQuot X := by
  refine ⟨e.symm y, ?_, ?_⟩
  · rw [← map_pow, h9, map_one]
    exact Subgroup.one_mem _
  · rw [← map_pow, hZ, Subgroup.mem_bot]
    intro h
    apply h3
    have := congrArg e h
    simpa using this

theorem hasNineQuot_of_projSL_two {n : ℕ} (hn : 1 ≤ n) {X : Type} [Group X]
    (hq : IsQuasisimple X) (φ : X ≃* projSL 2 (GaloisField 2 (3 * n))) : HasNineQuot X := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hK : Nat.card (GaloisField 2 (3 * n)) = 2 ^ (3 * n) := GaloisField.card 2 _ (by omega)
  have h7 : 7 ∣ Nat.card (GaloisField 2 (3 * n)) - 1 := by
    rw [hK, show 2 ^ (3 * n) = 8 ^ n by rw [pow_mul]; norm_num]
    simpa using Nat.sub_dvd_pow_sub_pow 8 1 n
  obtain ⟨t, ht, -⟩ := exists_cubic_root h7
  have h2 : (2 : GaloisField 2 (3 * n)) = 0 := CharP.cast_eq_zero _ 2
  refine hasNineQuot_of_equiv φ
    (Sec13.Res5Proof.center_eq_bot_of_projSL (admissible_psl (Or.inl rfl) hn) hq φ)
    (projSLOfDet (nineM t) (nineM_det h2)) (projSLOfDet_pow_eq_one _ _ (nineM_pow_nine h2 ht))
    (projSLOfDet_pow_ne_one_of_offdiag _ _ (i := 0) (j := 1) (by decide) ?_)
  rw [nineM_pow_three h2 ht]
  simpa [nineV] using one_add_sq_ne_zero ht

theorem hasNineQuot_of_projSL_three {n : ℕ} (hn : 1 ≤ n) {X : Type} [Group X]
    (hq : IsQuasisimple X) (φ : X ≃* projSL 3 (GaloisField 2 (3 * n))) : HasNineQuot X := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hK : Nat.card (GaloisField 2 (3 * n)) = 2 ^ (3 * n) := GaloisField.card 2 _ (by omega)
  have h7 : 7 ∣ Nat.card (GaloisField 2 (3 * n)) - 1 := by
    rw [hK, show 2 ^ (3 * n) = 8 ^ n by rw [pow_mul]; norm_num]
    simpa using Nat.sub_dvd_pow_sub_pow 8 1 n
  obtain ⟨t, ht, -⟩ := exists_cubic_root h7
  have h2 : (2 : GaloisField 2 (3 * n)) = 0 := CharP.cast_eq_zero _ 2
  refine hasNineQuot_of_equiv φ
    (Sec13.Res5Proof.center_eq_bot_of_projSL (admissible_psl (Or.inr rfl) hn) hq φ)
    (projSLOfDet (nineN t) (nineN_det h2)) (projSLOfDet_pow_eq_one _ _ (nineN_pow_nine h2 ht))
    (projSLOfDet_pow_ne_one_of_offdiag _ _ (i := 0) (j := 1) (by decide) ?_)
  rw [nineN_pow_three h2 ht]
  simpa [nineNV] using one_add_sq_ne_zero ht

theorem hasNineQuot_statedSU {K : Type} [Field K] [Finite K] {n : ℕ} (hn : 1 ≤ n)
    (hK : Nat.card K = (2 ^ (3 * n)) ^ 2) :
    HasNineQuot (CFSG.Open.StatedSU 3 (2 ^ (3 * n)) K) := by
  haveI : Fintype K := Fintype.ofFinite K
  haveI hchar : CharP K 2 := charP_of_card_eq_prime_pow (f := 6 * n) (by
    rw [← Nat.card_eq_fintype_card, hK, ← pow_mul]
    ring_nf)
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h7 : 7 ∣ Nat.card K - 1 := by
    rw [hK]
    exact (by norm_num : 7 ∣ 63).trans (sixtythree_dvd n)
  obtain ⟨t, ht, ht7⟩ := exists_cubic_root h7
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  have hq : (2 : ℕ) ^ (3 * n) = 8 ^ n := by rw [pow_mul]; norm_num
  have htq : t ^ (2 ^ (3 * n)) = t := by rw [hq]; exact pow_eight_pow_eq_self ht7 n
  have ht1q : (t + 1) ^ (2 ^ (3 * n)) = t + 1 := by
    rw [add_pow_char_pow t 1 2 (3 * n), htq, one_pow]
  have hmap : (nineU t).map (· ^ (2 ^ (3 * n))) = nineU t := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [nineU, htq, ht1q, zero_pow (pow_ne_zero _ (two_ne_zero)), one_pow]
  have hdet := nineU_det (t := t) h2
  have hmem : glOfDet (nineU t) hdet ∈ CFSG.Open.StatedSU 3 (2 ^ (3 * n)) K := by
    refine Subgroup.subset_closure ⟨hdet, ?_⟩
    rw [glOfDet_coe, hmap]
    exact nineU_transpose_mul h2
  refine ⟨⟨glOfDet (nineU t) hdet, hmem⟩, ?_, ?_⟩
  · have : (⟨glOfDet (nineU t) hdet, hmem⟩ : CFSG.Open.StatedSU 3 (2 ^ (3 * n)) K) ^ 9 = 1 :=
      Subtype.ext (glOfDet_pow_eq_one _ hdet (nineU_pow_nine h2 ht))
    rw [this]
    exact Subgroup.one_mem _
  · rw [CFSG.HardMathSupport.Solomon.Proving.center_statedSU_three_eq_scalars hK,
      Subgroup.mem_subgroupOf]
    rintro ⟨u, hu⟩
    have h00 := congrArg (fun g : GL (Fin 3) K => (g : Matrix (Fin 3) (Fin 3) K) 0 0) hu
    have h11 := congrArg (fun g : GL (Fin 3) K => (g : Matrix (Fin 3) (Fin 3) K) 1 1) hu
    simp only [Subgroup.coe_pow, glOfDet_pow_coe] at h00 h11
    have hd := scalar_diag (n := 3) (F := K) u 0 1
    rw [h00, h11, nineU_pow_three h2 ht] at hd
    have hz : (nineW t) 0 0 = t ^ 2 := rfl
    have hz' : (nineW t) 1 1 = 0 := rfl
    rw [hz, hz'] at hd
    exact sq_ne_zero_of_root ht hd

theorem hasNineQuot_of_isType418 {X : Type} [Group X] {n : ℕ} (hn : 1 ≤ n)
    (hq : IsQuasisimple X) (h : Sec8.IsType418 X n) : HasNineQuot X := by
  rcases h with ⟨K, _, _, hK, ⟨e⟩⟩ | ⟨⟨φ⟩⟩ | ⟨⟨φ⟩⟩
  · have heq : CFSG.Assembly.LowTwoRank.StatedSU 3 (2 ^ (3 * n)) K =
        CFSG.Open.StatedSU 3 (2 ^ (3 * n)) K := rfl
    have hc := hasNineQuot_statedSU hn hK
    obtain ⟨y, hy9, hy3⟩ := hc
    let ψ : X ≃* CFSG.Open.StatedSU 3 (2 ^ (3 * n)) K := e.trans (MulEquiv.subgroupCongr heq)
    exact HasNineQuot.of_equiv ψ ⟨y, hy9, hy3⟩
  · exact hasNineQuot_of_projSL_two hn hq φ
  · exact hasNineQuot_of_projSL_three hn hq φ

end Types

