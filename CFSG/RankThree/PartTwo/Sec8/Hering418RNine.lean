variable {R : Type*} [CommRing R] {t : R}

@[expose] def nineM (t : R) : Matrix (Fin 2) (Fin 2) R := !![0, 1; 1, t]

@[expose] def nineV (t : R) : Matrix (Fin 2) (Fin 2) R := !![t, 1 + t ^ 2; 1 + t ^ 2, t + 1]

@[expose] def nineN (t : R) : Matrix (Fin 3) (Fin 3) R := !![0, 1, 0; 1, t, 0; 0, 0, 1]

@[expose] def nineNV (t : R) : Matrix (Fin 3) (Fin 3) R :=
  !![t, 1 + t ^ 2, 0; 1 + t ^ 2, t + 1, 0; 0, 0, 1]

@[expose] def nineU (t : R) : Matrix (Fin 3) (Fin 3) R := !![0, 0, 1; t, t + 1, 0; t + 1, t, 0]

@[expose] def nineW (t : R) : Matrix (Fin 3) (Fin 3) R :=
  !![t ^ 2, t ^ 2 + t, t + 1; t ^ 2 + t + 1, 0, t ^ 2 + t; t, t ^ 2 + t + 1, t ^ 2]

local macro "matexpand" : tactic =>
  `(tactic| simp only [pow_succ, pow_zero, one_mul, Matrix.mul_apply, Fin.sum_univ_two,
    Fin.sum_univ_three, nineM, nineV, nineN, nineNV, nineU, nineW, Matrix.of_apply,
    Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.empty_val', Matrix.cons_val_fin_one, Fin.isValue, Fin.zero_eta, Fin.mk_one,
    Matrix.one_apply, Matrix.cons_val_two, Matrix.tail_cons, Fin.reduceFinMk,
    Matrix.head_fin_const, Fin.mk.injEq, if_true, if_false, zero_ne_one, one_ne_zero,
    OfNat.ofNat_ne_zero, OfNat.zero_ne_ofNat, OfNat.ofNat_ne_one, OfNat.one_ne_ofNat,
    Nat.reduceEqDiff, Fin.reduceEq, Fin.reduceNe])

local macro "matexprT" : tactic =>
  `(tactic| simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_three, nineU,
    Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.empty_val', Matrix.cons_val_fin_one, Fin.isValue, Fin.zero_eta,
    Fin.mk_one, Matrix.one_apply, Matrix.cons_val_two, Matrix.tail_cons,
    Fin.reduceFinMk, Matrix.head_fin_const, Fin.mk.injEq, if_true, if_false, zero_ne_one,
    one_ne_zero, OfNat.ofNat_ne_zero, OfNat.zero_ne_ofNat, OfNat.ofNat_ne_one,
    OfNat.one_ne_ofNat, Nat.reduceEqDiff, zero_add, add_zero, Fin.reduceEq, Fin.reduceNe])

theorem nineM_pow_three (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) :
    nineM t ^ 3 = nineV t := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination ((1 : R)) * ht + ((-1 : R)) * h2

theorem nineV_pow_three (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) :
    nineV t ^ 3 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexpand
    linear_combination ((4 : R) + t + (3 : R) * t ^ 2) * ht +
      ((-2 : R) + (-1 : R) * t + (-1 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((2 : R) + (5 : R) * t + t ^ 3) * ht + ((-2 : R) * t + t ^ 2) * h2
  · matexpand
    linear_combination ((2 : R) + (5 : R) * t + t ^ 3) * ht + ((-2 : R) * t + t ^ 2) * h2
  · matexpand
    linear_combination ((4 : R) + (2 : R) * t + (3 : R) * t ^ 2) * ht + ((-1 : R) + t ^ 2) * h2

theorem nineN_pow_three (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) :
    nineN t ^ 3 = nineNV t := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination ((1 : R)) * ht + ((-1 : R)) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2

theorem nineNV_pow_three (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) :
    nineNV t ^ 3 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexpand
    linear_combination ((4 : R) + t + (3 : R) * t ^ 2) * ht +
      ((-2 : R) + (-1 : R) * t + (-1 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((2 : R) + (5 : R) * t + t ^ 3) * ht + ((-2 : R) * t + t ^ 2) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination ((2 : R) + (5 : R) * t + t ^ 3) * ht + ((-2 : R) * t + t ^ 2) * h2
  · matexpand
    linear_combination ((4 : R) + (2 : R) * t + (3 : R) * t ^ 2) * ht + ((-1 : R) + t ^ 2) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2

theorem nineU_pow_three (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) :
    nineU t ^ 3 = nineW t := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination ((1 : R)) * ht + ((-1 : R) + t ^ 2) * h2
  · matexpand
    linear_combination ((1 : R)) * ht + (t + (2 : R) * t ^ 2) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2
  · matexpand
    linear_combination ((1 : R)) * ht + (t ^ 2) * h2
  · matexpand
    linear_combination ((1 : R)) * ht + ((-1 : R) + t ^ 2) * h2
  · matexpand
    linear_combination (0) * ht + (0) * h2

theorem nineW_pow_three (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) :
    nineW t ^ 3 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexpand
    linear_combination ((2 : R) + (9 : R) * t + (6 : R) * t ^ 2 + (3 : R) * t ^ 3) * ht +
      ((-1 : R) + (-4 : R) * t + (-5 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((10 : R) * t + (9 : R) * t ^ 2 + (3 : R) * t ^ 3) * ht +
      ((-5 : R) * t + (-7 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((-2 : R) + (9 : R) * t + (9 : R) * t ^ 2 + (2 : R) * t ^ 3) * ht +
      ((1 : R) + (-2 : R) * t + (-5 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((11 : R) * t + (9 : R) * t ^ 2 + (3 : R) * t ^ 3) * ht +
      ((-4 : R) * t + (-6 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((7 : R) * t + (6 : R) * t ^ 2 + (2 : R) * t ^ 3) * ht +
      ((-2 : R) * t + (-4 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((10 : R) * t + (9 : R) * t ^ 2 + (3 : R) * t ^ 3) * ht +
      ((-5 : R) * t + (-7 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((-2 : R) + (8 : R) * t + (9 : R) * t ^ 2 + (2 : R) * t ^ 3) * ht +
      ((1 : R) + (-3 : R) * t + (-6 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((11 : R) * t + (9 : R) * t ^ 2 + (3 : R) * t ^ 3) * ht +
      ((-4 : R) * t + (-6 : R) * t ^ 2) * h2
  · matexpand
    linear_combination ((2 : R) + (9 : R) * t + (6 : R) * t ^ 2 + (3 : R) * t ^ 3) * ht +
      ((-1 : R) + (-4 : R) * t + (-5 : R) * t ^ 2) * h2

theorem nineU_transpose_mul (h2 : (2 : R) = 0) : (nineU t)ᵀ * nineU t = 1 := by
  ext i j
  fin_cases i <;> fin_cases j
  · matexprT
    linear_combination (t + t ^ 2) * h2
  · matexprT
