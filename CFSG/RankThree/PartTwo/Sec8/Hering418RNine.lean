theorem nineM_pow_nine (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) : nineM t ^ 9 = 1 := by
  rw [show 9 = 3 * 3 by norm_num, pow_mul, nineM_pow_three h2 ht, nineV_pow_three h2 ht]

theorem nineN_pow_nine (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) : nineN t ^ 9 = 1 := by
  rw [show 9 = 3 * 3 by norm_num, pow_mul, nineN_pow_three h2 ht]
  exact nineNV_pow_three h2 ht

theorem nineU_pow_nine (h2 : (2 : R) = 0) (ht : t ^ 3 + t + 1 = 0) : nineU t ^ 9 = 1 := by
  rw [show 9 = 3 * 3 by norm_num, pow_mul, nineU_pow_three h2 ht]
  exact nineW_pow_three h2 ht

theorem one_add_sq_ne_zero [Nontrivial R] (ht : t ^ 3 + t + 1 = 0) : (1 : R) + t ^ 2 ≠ 0 := by
  intro h
  have : (1 : R) = 0 := by linear_combination ht - t * h
  exact one_ne_zero this

theorem sq_ne_zero_of_root [IsDomain R] (ht : t ^ 3 + t + 1 = 0) : t ^ 2 ≠ 0 := by
  intro h
  have h0 : t = 0 := pow_eq_zero_iff (two_ne_zero) |>.mp h
  rw [h0] at ht
  norm_num at ht

