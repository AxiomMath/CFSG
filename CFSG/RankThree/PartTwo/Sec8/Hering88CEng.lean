variable {G : Type} [Group G] [Finite G]

theorem exists_inner_core {A Y : Subgroup G} {a x y : G}
    (hAc : ∀ u ∈ A, ∀ v ∈ A, u * v = v * u) (hA3 : ∀ u ∈ A, u ^ 3 = 1)
    (hAN : A ≤ Subgroup.normalizer (Y : Set G)) (haA : a ∈ A) (ha1 : a ≠ 1)
    (hxA : x ∈ A) (hyA : y ∈ A)
    (hC : ∀ g ∈ A, (∀ z ∈ Y, g * z * g⁻¹ * z⁻¹ ∈ (aschbacherSolvableCore 3 Y).map Y.subtype) →
      g ∈ Subgroup.zpowers a)
    (hxout : Sec4.InducesOuterTheta x Y) (hyx : y ∉ Subgroup.zpowers x)
    (hay : a ∉ Subgroup.closure ({x, y} : Set G))
    (hOTC : KFacts.OutThreeCyclic (Y ⧸ aschbacherSolvableCore 3 Y)) :
    ∃ d ∈ Subgroup.closure ({x, y} : Set G), d ∉ Subgroup.zpowers x ∧ d ∈ A ∧ d ^ 3 = 1 ∧
      ∃ hdN : d ∈ Subgroup.normalizer (Y : Set G),
        KFacts.IsInnerAut (Sec4.thetaQuotMulAut Y (Sec4.compAction Y ⟨d, hdN⟩)) ∧
        Sec4.thetaQuotMulAut Y (Sec4.compAction Y ⟨d, hdN⟩) ≠ 1 := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set φ : A →* MulAut (Y ⧸ aschbacherSolvableCore 3 Y) :=
    ((Sec4.thetaQuotMulAut Y).comp (Sec4.compAction Y)).comp (Subgroup.inclusion hAN) with hφ
  have hφapp : ∀ (g : G) (hg : g ∈ A),
      φ ⟨g, hg⟩ = Sec4.thetaQuotMulAut Y (Sec4.compAction Y ⟨g, hAN hg⟩) := fun _ _ => rfl
  have hpow3 : ∀ g (hg : g ∈ A), (⟨g, hg⟩ : A) ^ 3 = 1 := fun g hg =>
    Subtype.ext (by simpa using hA3 g hg)
  have hα3 : φ ⟨x, hxA⟩ ^ 3 = 1 := by rw [← map_pow, hpow3 x hxA, map_one]
  have hβ3 : φ ⟨y, hyA⟩ ^ 3 = 1 := by rw [← map_pow, hpow3 y hyA, map_one]
  have hcomm : Commute (φ ⟨x, hxA⟩) (φ ⟨y, hyA⟩) := by
    have : (⟨x, hxA⟩ : A) * ⟨y, hyA⟩ = ⟨y, hyA⟩ * ⟨x, hxA⟩ := Subtype.ext (hAc x hxA y hyA)
    exact (map_mul φ _ _).symm.trans ((congrArg φ this).trans (map_mul φ _ _))
  have hαout : ¬ KFacts.IsInnerAut (φ ⟨x, hxA⟩) := by
    obtain ⟨hxN, hxo⟩ := hxout
    exact hxo
  obtain ⟨k, hk3, hkin⟩ := hOTC _ _ hcomm hα3 hβ3 hαout
  have hxk : x ^ k ∈ A := A.pow_mem hxA k
  have hdA : x ^ k * y ∈ A := A.mul_mem hxk hyA
  have hxy : Commute x y := hAc x hxA y hyA
  have hd3 : (x ^ k * y) ^ 3 = 1 := by
    rw [(hxy.pow_left k).mul_pow, ← pow_mul, mul_comm k 3, pow_mul, hA3 x hxA, one_pow,
      hA3 y hyA, one_mul]
  have hdcl : x ^ k * y ∈ Subgroup.closure ({x, y} : Set G) :=
    Subgroup.mul_mem _ (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) k)
      (Subgroup.subset_closure (by simp))
  have hdx : x ^ k * y ∉ Subgroup.zpowers x := by
    intro h
    apply hyx
    have : y = (x ^ k)⁻¹ * (x ^ k * y) := by group
    rw [this]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.pow_mem _ (Subgroup.mem_zpowers x) k)) h
  have hdN : x ^ k * y ∈ Subgroup.normalizer (Y : Set G) := hAN hdA
  have hφd : φ ⟨x ^ k * y, hdA⟩ = φ ⟨x, hxA⟩ ^ k * φ ⟨y, hyA⟩ := by
    rw [← map_pow, ← map_mul]
    exact congrArg φ (Subtype.ext (by simp))
  refine ⟨x ^ k * y, hdcl, hdx, hdA, hd3, hdN, ?_, ?_⟩
  · rw [← hφapp _ hdA, hφd]
    exact hkin
  · intro h1
    rw [← hφapp _ hdA] at h1
    have hmem : x ^ k * y ∈ Subgroup.zpowers a := by
      refine hC _ hdA fun z hz => ?_
      have h2 := congrArg (fun τ : MulAut (Y ⧸ aschbacherSolvableCore 3 Y) =>
        τ ((⟨z, hz⟩ : Y) : Y ⧸ aschbacherSolvableCore 3 Y)) h1
      simp only [MulAut.one_apply] at h2
      rw [hφapp _ hdA, Sec4.thetaQuotMulAut_mk, QuotientGroup.eq] at h2
      have h4 : (⟨z, hz⟩ : Y)⁻¹ * (Sec4.compAction Y ⟨x ^ k * y, hdN⟩ ⟨z, hz⟩) ∈
          aschbacherSolvableCore 3 Y := by
        have := (aschbacherSolvableCore 3 Y).inv_mem h2
        simpa using this
      refine ⟨(⟨z, hz⟩ : Y) * ((⟨z, hz⟩ : Y)⁻¹ *
        (Sec4.compAction Y ⟨x ^ k * y, hdN⟩ ⟨z, hz⟩)) * (⟨z, hz⟩ : Y)⁻¹,
        (inferInstance : (aschbacherSolvableCore 3 Y).Normal).conj_mem _ h4 ⟨z, hz⟩, ?_⟩
      change z * (z⁻¹ * ((x ^ k * y) * z * (x ^ k * y)⁻¹)) * z⁻¹ =
        (x ^ k * y) * z * (x ^ k * y)⁻¹ * z⁻¹
      group
    have hd1 : x ^ k * y ≠ 1 := fun h => hdx (h ▸ Subgroup.one_mem _)
    have ha3 : a ^ 3 = 1 := hA3 a haA
    have hanot : a ∈ Subgroup.zpowers (x ^ k * y) := by
      by_contra hna
      exact Item86ResProof.not_mem_zpowers_symm ha3 hd3 ha1 hd1 hna hmem
    exact hay (Subgroup.zpowers_le.mpr hdcl hanot)

end Core

section Pair


variable {G : Type} [Group G] [Finite G] {A : Subgroup G} {c : G} {L : Subgroup G} {a b : G}
  {X : Subgroup G} {n : ℕ}

theorem pair_commute_pow_three (h : Sec8Pair G A c L a b X n) :
    (∀ u ∈ A, ∀ v ∈ A, u * v = v * u) ∧ (∀ u ∈ A, u ^ 3 = 1) :=
  ⟨fun u hu v hv => congrArg Subtype.val (h.mem_partTwoF.1.1.is_comm.comm ⟨u, hu⟩ ⟨v, hv⟩),
    h.mem_partTwoF.1.2⟩

theorem le_normalizer_of_pair (h45 : Sec4.Item4_5) (h : Sec8Pair G A c L a b X n)
    {Y : Subgroup G} (hY : Y ∈ thetaComponentsAt 3 a) : A ≤ Subgroup.normalizer (Y : Set G) := by
  obtain ⟨hAc, hA3⟩ := pair_commute_pow_three h
  have hAp : IsPGroup 3 A := fun g => ⟨1, Subtype.ext (by simpa using hA3 g g.2)⟩
  exact Sec11.le_normalizer_of_isPGroup_of_le_centralizer h45 h.toTheoremFourHyp
    (hA3 a h.a_mem) h.a_ne_one hAp
    (fun u hu => Subgroup.mem_centralizer_singleton_iff.mpr (hAc u hu a h.a_mem)) Y hY

theorem a_not_mem_closure (hF : KF84Field) (h : Sec8Pair G A c L a b X n) :
    a ∉ Subgroup.closure ({c, b} : Set G) := by
  intro ha
  set K := inSubgroup perfectResidual (L ⊓ Subgroup.centralizer ({b} : Set G)) with hK
  have hLc : L ≤ Subgroup.centralizer ({c} : Set G) :=
    (PartOne.mem_thetaComponentsAt_iff.mp h.mem_thetaComponentsAt).1
  have hKc : K ≤ Subgroup.centralizer ({c} : Set G) :=
    (Item87Proof.residual_le _).trans (inf_le_left.trans hLc)
  have hKb : K ≤ Subgroup.centralizer ({b} : Set G) :=
    (Item87Proof.residual_le _).trans inf_le_right
  have haK : a ∈ Subgroup.centralizer (K : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro k hk
    have hk' : k ∈ Subgroup.centralizer ((Subgroup.closure ({c, b} : Set G) : Subgroup G) :
        Set G) := by
      rw [Subgroup.centralizer_closure, Subgroup.mem_centralizer_iff]
      intro w hw
      rcases hw with rfl | rfl
      · exact (Subgroup.mem_centralizer_singleton_iff.mp (hKc hk)).symm
      · exact (Subgroup.mem_centralizer_singleton_iff.mp (hKb hk)).symm
    exact (Subgroup.mem_centralizer_iff.mp hk' a ha).symm
  exact Sec10.Sec10XProof.not_inducesOuterTheta_of_mem_centralizer haK
    (KFacts.InducesStdKind.inducesOuterTheta K (hF G A c L a b X n h) (by decide))

theorem exists_inner_d
    (h45 : Sec4.Item4_5) (hC : KF88SwapCent) (hF : KF84Field)
    (h : Sec8Pair G A c L a b X n) {Y : Subgroup G} (hY : Y ∈ thetaComponentsAt 3 a)
    (hIJ : sec8I L a ⊔ sec8J X a ≤ Y) {x : G} (hx : x = c ∨ x = b)
    (hxY : KFacts.InducesStdKind Y x .field ∨ KFacts.InducesStdKind Y x .graphField)
    (hOTC : KFacts.OutThreeCyclic (Y ⧸ aschbacherSolvableCore 3 Y)) :
    ∃ d ∈ Subgroup.closure ({c, b} : Set G), d ∉ Subgroup.zpowers x ∧ d ∈ A ∧ d ^ 3 = 1 ∧
      ∃ hdN : d ∈ Subgroup.normalizer (Y : Set G),
        KFacts.IsInnerAut (Sec4.thetaQuotMulAut Y (Sec4.compAction Y ⟨d, hdN⟩)) ∧
        Sec4.thetaQuotMulAut Y (Sec4.compAction Y ⟨d, hdN⟩) ≠ 1 := by
  obtain ⟨hAc, hA3⟩ := pair_commute_pow_three h
  obtain ⟨hbA, hb1, -, -⟩ := Item87Proof.isGammaIndex_cases h.isGammaIndex
  have hAN := le_normalizer_of_pair h45 h hY
  have hxout : Sec4.InducesOuterTheta x Y := by
    rcases hxY with h' | h'
    · exact KFacts.InducesStdKind.inducesOuterTheta Y h' (by decide)
    · exact KFacts.InducesStdKind.inducesOuterTheta Y h' (by decide)
  have hSC := hC G A c L a b X n h Y hY hIJ x hx hxY
  have hCa : ∀ g ∈ A, (∀ z ∈ Y, g * z * g⁻¹ * z⁻¹ ∈
      (aschbacherSolvableCore 3 Y).map Y.subtype) → g ∈ Subgroup.zpowers a := fun g hg hz =>
    show g ∈ ((Subgroup.zpowers a : Subgroup G) : Set G) from hSC ▸ ⟨hg, hz⟩
  have hbc : b ∉ Subgroup.zpowers c :=
    Item86ResProof.not_mem_zpowers_of_isGammaIndex h.mem_thetaComponentsAt h.isGammaIndex
  have hb3 := hA3 b hbA
  have hc3 := hA3 c h.mem_A
  have hcb : c ∉ Subgroup.zpowers b :=
    Item86ResProof.not_mem_zpowers_symm hb3 hc3 hb1 h.ne_one hbc
  have hay := a_not_mem_closure hF h
  rcases hx with rfl | rfl
  · exact exists_inner_core hAc hA3 hAN h.a_mem h.a_ne_one h.mem_A hbA hCa hxout hbc hay hOTC
  · rw [Set.pair_comm] at hay ⊢
    exact exists_inner_core hAc hA3 hAN h.a_mem h.a_ne_one hbA h.mem_A hCa hxout hcb hay hOTC

end Pair

