theorem triple2_adjointG2 {K : Type} [Field K] [Finite K] (hK : ringChar K ≠ 2) :
    Triple2 ↥(adjointGroup .G2 K) := by
  obtain ⟨a, b, h⟩ := (odd_field_two_dimensional_quaternion_matrices hK).1
  let ρ : QuaternionGroup 2 →* SL2 K := quatHom h
  have hρ : Function.Injective ρ := quatHom_injective hK h
  have hρz : ρ (QuaternionGroup.a 2) = -1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]
    exact quatHom_a_two h
  have hρzz : ρ (QuaternionGroup.a 2) * ρ (QuaternionGroup.a 2) = 1 := by
    rw [← map_mul]
    have : (QuaternionGroup.a 2 : QuaternionGroup 2) * QuaternionGroup.a 2 = 1 := by decide
    rw [this, map_one]
  have hsign : G2SignPair (g2v 1 0) (g2v 1 2) := Or.inr (Or.inl ⟨rfl, rfl⟩)
  let μ := g2Mul hsign K
  have hHSL : (HSL (-1 : Kˣ) : SL2 K) = -1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [HSL]
  have hneg : rootSL2 .G2 K (g2v 1 0) (-1) = rootSL2 .G2 K (g2v 1 2) (-1) := by
    have h1 := g2_pair_HSL_neg_one (K := K) hsign
    rwa [hHSL] at h1
  let Θ0 : QuaternionGroup 2 × QuaternionGroup 2 →* ModGL .G2 K := μ.comp (ρ.prodMap ρ)
  have hΘ0 : ∀ u : QuaternionGroup 2 × QuaternionGroup 2,
      Θ0 u = rootSL2 .G2 K (g2v 1 0) (ρ u.1) * rootSL2 .G2 K (g2v 1 2) (ρ u.2) := fun u =>
    g2Mul_apply hsign (ρ u.1) (ρ u.2)
  have hmem : ∀ u, Θ0 u ∈ adjointGroup .G2 K := fun u => by
    rw [hΘ0]
    exact mul_mem (rootSL2_mem_adjoint _ _) (rootSL2_mem_adjoint _ _)
  let Θ : QuaternionGroup 2 × QuaternionGroup 2 →* ↥(adjointGroup .G2 K) :=
    { toFun := fun u => ⟨Θ0 u, hmem u⟩
      map_one' := Subtype.ext (map_one Θ0)
      map_mul' := fun u v => Subtype.ext (map_mul Θ0 u v) }
  have hΘ : ∀ u, (Θ u : ModGL .G2 K) = Θ0 u := fun u => rfl
  have hinj : Function.Injective (rootSL2 .G2 K (g2v 1 0)) := rootSL2_injective' hK _
  refine triple2_of_quaternion_pair Θ ?_ ?_ ?_
  · apply Subtype.ext
    rw [hΘ, hΘ0]
    change rootSL2 .G2 K (g2v 1 0) (ρ (QuaternionGroup.a 2)) *
      rootSL2 .G2 K (g2v 1 2) (ρ (QuaternionGroup.a 2)) =
        ((1 : ↥(adjointGroup .G2 K)) : ModGL .G2 K)
    rw [hρz, ← hneg, ← map_mul, ← hρz, hρzz, map_one]
    rfl
  · intro h1
    have h1' : (Θ (QuaternionGroup.a 2, 1) : ModGL .G2 K) = 1 := congrArg Subtype.val h1
    rw [hΘ, hΘ0] at h1'
    change rootSL2 .G2 K (g2v 1 0) (ρ (QuaternionGroup.a 2)) *
      rootSL2 .G2 K (g2v 1 2) (ρ 1) = 1 at h1'
    rw [map_one, map_one, mul_one, ← map_one (rootSL2 .G2 K (g2v 1 0))] at h1'
    have h2 := hinj h1'
    have h3 : ρ (QuaternionGroup.a 2) = ρ 1 := by rw [map_one]; exact h2
    exact absurd (hρ h3) (by decide)
  · intro x y hxy
    have hxy' : rootSL2 .G2 K (g2v 1 0) (ρ x) * rootSL2 .G2 K (g2v 1 2) (ρ y) = 1 := by
      have := congrArg Subtype.val hxy
      rw [hΘ, hΘ0] at this
      exact this
    have hker : (ρ x, ρ y) ∈ (g2Mul hsign K).ker := by
      rw [MonoidHom.mem_ker, g2Mul_apply]
      exact hxy'
    obtain ⟨hx, hy⟩ := ker_g2Mul_central hsign _ hker
    refine ⟨fun w => hρ ?_, fun w => hρ ?_⟩
    · rw [map_mul, map_mul]
      exact (Subgroup.mem_center_iff.mp hx (ρ w)).symm
    · rw [map_mul, map_mul]
      exact (Subgroup.mem_center_iff.mp hy (ρ w)).symm

end G2Odd


