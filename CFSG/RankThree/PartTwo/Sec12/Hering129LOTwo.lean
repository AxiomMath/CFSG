theorem triple2_of_quaternion_pair {G : Type*} [Group G]
    (Θ : QuaternionGroup 2 × QuaternionGroup 2 →* G)
    (h1 : Θ (QuaternionGroup.a 2, QuaternionGroup.a 2) = 1)
    (h2 : Θ (QuaternionGroup.a 2, 1) ≠ 1)
    (h3 : ∀ x y : QuaternionGroup 2, Θ (x, y) = 1 →
      (∀ w, x * w = w * x) ∧ (∀ w, y * w = w * y)) : Triple2 G := by
  have hz : ∀ u : QuaternionGroup 2 × QuaternionGroup 2,
      Θ (QuaternionGroup.a 2, QuaternionGroup.a 2) * Θ u = Θ u := fun u => by
    rw [h1, one_mul]
  have key : ∀ u v : QuaternionGroup 2 × QuaternionGroup 2,
      u * v = (QuaternionGroup.a 2, QuaternionGroup.a 2) * (v * u) → Θ u * Θ v = Θ v * Θ u := by
    intro u v huv
    rw [← map_mul, ← map_mul, huv, map_mul, h1, one_mul]
  have key0 : ∀ u v : QuaternionGroup 2 × QuaternionGroup 2,
      u * v = v * u → Θ u * Θ v = Θ v * Θ u := by
    intro u v huv
    rw [← map_mul, ← map_mul, huv]
  have key2 : ∀ u : QuaternionGroup 2 × QuaternionGroup 2,
      u * u = (QuaternionGroup.a 2, QuaternionGroup.a 2) → Θ u * Θ u = 1 := by
    intro u hu
    rw [← map_mul, hu, h1]
  have nt : ∀ u : QuaternionGroup 2 × QuaternionGroup 2,
      ¬ ((∀ w, u.1 * w = w * u.1) ∧ (∀ w, u.2 * w = w * u.2)) → Θ u ≠ 1 := by
    intro u hu h
    exact hu (h3 u.1 u.2 h)
  refine ⟨Θ (QuaternionGroup.a 1, QuaternionGroup.a 1),
    Θ (QuaternionGroup.xa 0, QuaternionGroup.xa 0), Θ (QuaternionGroup.a 2, 1),
    key2 _ (by decide), key2 _ (by decide), ?_, key _ _ (by decide), key0 _ _ (by decide),
    key0 _ _ (by decide), nt _ (by decide), nt _ (by decide), h2, ?_, ?_, ?_, ?_⟩
  · rw [← map_mul]
    have : ((QuaternionGroup.a 2 : QuaternionGroup 2), (1 : QuaternionGroup 2)) *
        ((QuaternionGroup.a 2 : QuaternionGroup 2), (1 : QuaternionGroup 2)) = 1 := by decide
    rw [this, map_one]
  · rw [← map_mul]
    exact nt _ (by decide)
  · rw [← map_mul]
    exact nt _ (by decide)
  · rw [← map_mul]
    exact nt _ (by decide)
  · rw [← map_mul, ← map_mul]
    exact nt _ (by decide)


