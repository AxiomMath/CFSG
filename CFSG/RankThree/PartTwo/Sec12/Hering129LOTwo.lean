theorem theta_eq_pCore_two_of_good (hperf : Group.IsPerfect X) (h44 : Sec4.Item4_4)
    (hX : SectionFourHyp X)
    (hsimple : IsSimpleGroup (X ⧸ aschbacherSolvableCore 3 X))
    (hbig : 5616 < Nat.card (X ⧸ aschbacherSolvableCore 3 X))
    (hrank : 3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup (X ⧸ aschbacherSolvableCore 3 X)))
    (hmult : MultGood (X ⧸ aschbacherSolvableCore 3 X)) :
    aschbacherSolvableCore 3 X = CFSG.pCore 2 X := by
  haveI := hperf
  haveI := hsimple.toNontrivial
  obtain ⟨hθsol, -, hθ3, -, -, -, hθO⟩ :=
    solvable_prime_complement_core_characterization (H := X) Nat.prime_three
  have hO2 : CFSG.pCore 2 X ≤ aschbacherSolvableCore 3 X := hθO 2 Nat.prime_two (by norm_num)
  refine le_antisymm ?_ hO2
  rcases h44 X hX hperf (aschbacherSolvableCore 3 X) hθsol hsimple with
    h1 | h2 | h3 | h4 | h5
  · exact theta_le_pCore_two_of_quasisimple hperf hsimple hmult h1
  · exfalso
    obtain ⟨e2⟩ := h2
    haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
    exact false_of_sl2_case hperf hsimple hrank (le_refl 5) e2
  · exfalso
    obtain ⟨p, hp, hp3, ⟨e3⟩⟩ := h3
    haveI := Fact.mk hp
    have hp5 : 5 ≤ p := by
      by_contra h
      have : p = 4 := by omega
      subst this
      exact absurd hp (by norm_num)
    exact false_of_sl2_case hperf hsimple hrank hp5 e3
  · exfalso
    rcases h4 with h4a | h4
    · obtain ⟨e4⟩ := h4a
      exact false_of_projSL_three_three hperf hsimple hbig e4
    · exact false_of_isExtOf hperf hsimple hbig h4 (by rw [card_alt_five]; norm_num)
        (by rw [card_alt_five]; norm_num)
  · obtain ⟨-, h5⟩ := h5
    exfalso
    have hOodd : ¬ 2 ∣ Nat.card (CFSG.oddCore X) := fun h =>
      (Nat.not_even_iff_odd.mpr (odd_card_oddCore' X)) (even_iff_two_dvd.mpr h)
    have hA5 : 2 ≤ Nat.card (alternatingGroup (Fin 5)) ∧
        Nat.card (alternatingGroup (Fin 5)) ≤ 5616 := by rw [card_alt_five]; norm_num
    have hA6 : 2 ≤ Nat.card (alternatingGroup (Fin 6)) ∧
        Nat.card (alternatingGroup (Fin 6)) ≤ 5616 := by rw [card_alt_six]; norm_num
    rcases h5 hθ3 with ⟨hr2, hq | hext⟩ | ⟨-, hext | hext | hext⟩
    ·
      haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      haveI hnt : Nontrivial (X ⧸ CFSG.oddCore X) := by
        haveI := hq.2.1.toNontrivial
        obtain ⟨y, hy⟩ :=
          exists_ne (1 : (X ⧸ CFSG.oddCore X) ⧸ Subgroup.center (X ⧸ CFSG.oddCore X))
        obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
        exact ⟨x, 1, fun h => hy (by rw [h]; rfl)⟩
      have hOtop : CFSG.oddCore X ≠ ⊤ := by
        intro h
        haveI : Subsingleton (X ⧸ CFSG.oddCore X) := by
          rw [h]
          exact QuotientGroup.subsingleton_quotient_top
        exact not_subsingleton _ ‹_›
      have hOθ := normal_le_of_ne_top hθsol hsimple hOtop
      obtain ⟨-, hcases⟩ := map_theta_cases hperf hsimple hmult hOθ hq
      have hrk : 3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup (X ⧸ CFSG.oddCore X)) := by
        rcases hcases with hbot | ⟨-, hrk⟩
        · have hθO' : aschbacherSolvableCore 3 X ≤ CFSG.oddCore X := by
            rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hbot
          have e' : X ⧸ aschbacherSolvableCore 3 X ≃* X ⧸ CFSG.oddCore X :=
            QuotientGroup.quotientMulEquivOfEq (le_antisymm hθO' hOθ)
          rw [← CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num) e']
          exact hrank
        · exact hrk
      rw [CFSG.SectionRank.pRank_quotient_eq (CFSG.oddCore X) hOodd] at hrk
      omega
    · exact false_of_isExtOf hperf hsimple hbig hext hA5.1 hA5.2
    · exact false_of_isExtOf hperf hsimple hbig hext hA5.1 hA5.2
    · exact false_of_isExtOf hperf hsimple hbig hext hA5.1 hA5.2
    · exact false_of_isExtOf hperf hsimple hbig hext hA6.1 hA6.2

