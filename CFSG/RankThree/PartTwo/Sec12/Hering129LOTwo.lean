section L3Even

open CFSG.Assembly.RankThreeEven (projSL projSU)
open CFSG.Assembly.LowTwoRank (StatedLieTag StatedLieAdmissible)
open CFSG.Blueprint.Multiplier (genericOrders exceptionalOrders)

theorem MultGood.of_mulEquiv {Q Q' : Type} [Group Q] [Group Q'] (e : Q ≃* Q')
    (h : MultGood Q') : MultGood Q :=
  fun P _ _ hP Z _ hZc ⟨f⟩ h3 => h P hP Z hZc ⟨f.trans e⟩ h3

theorem card_dvd_table (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    {Q : Type} [Group Q] {t : StatedLieTag} {n p f : ℕ} (hm : CFSG.Models.LieModel Q t n p f)
    {P : Type} [Group P] (hP : Group.IsPerfect P) {Z : Subgroup P} [Z.Normal]
    (hZc : Z ≤ Subgroup.center P) (e : P ⧸ Z ≃* Q) :
    Nat.card Z ∣ (genericOrders t n p f).1 * (genericOrders t n p f).2 *
      ((exceptionalOrders t n p f).1 * (exceptionalOrders t n p f).2) := by
  have hdvd := KFacts.KS14.card_dvd_griess_of_le_center hP hZc e
  rwa [Nat.card_congr (RankThree.PerfectCover.hopfMultiplierEquivGriess Q).toEquiv,
    CFSG.GH74.Generic.card_hopfMultiplier_of_griess hGA hm] at hdvd

theorem center_eq_of_quotient {P Q : Type} [Group P] [Group Q] {Z : Subgroup P} [Z.Normal]
    (hZc : Z ≤ Subgroup.center P) (e : P ⧸ Z ≃* Q) (hQ : Subgroup.center Q = ⊥) :
    Subgroup.center P = Z := by
  refine le_antisymm (fun x hx => ?_) hZc
  have h1 : e (QuotientGroup.mk x) ∈ Subgroup.center Q := by
    rw [Subgroup.mem_center_iff]
    intro g
    obtain ⟨y, rfl⟩ := e.surjective g
    obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective y
    rw [← map_mul, ← map_mul, ← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul,
      Subgroup.mem_center_iff.mp hx w]
  rw [hQ, Subgroup.mem_bot, map_eq_one_iff _ e.injective, QuotientGroup.eq_one_iff] at h1
  exact h1

theorem center_eq_bot_of_perfect_simple (Q : Type) [Group Q] [IsSimpleGroup Q]
    [Group.IsPerfect Q] : Subgroup.center Q = ⊥ := by
  haveI := (inferInstance : IsSimpleGroup Q).toNontrivial
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center Q) with h | h
  · exact h
  · exfalso
    letI : CommGroup Q := { ‹Group Q› with
      mul_comm := fun a b => Subgroup.mem_center_iff.mp (h ▸ Subgroup.mem_top b) a }
    exact Group.IsPerfect.not_isSolvable Q inferInstance

theorem isPerfect_of_quotient_equiv {P Q : Type} [Group P] [Group Q] (hP : Group.IsPerfect P)
    {Z : Subgroup P} [Z.Normal] (e : P ⧸ Z ≃* Q) : Group.IsPerfect Q :=
  haveI := hP
  Group.IsPerfect.ofSurjective (f := e.toMonoidHom.comp (QuotientGroup.mk' Z))
    (e.surjective.comp (QuotientGroup.mk'_surjective Z))

theorem isQuasisimple_of_central_cover {P Q : Type} [Group P] [Group Q] [IsSimpleGroup Q]
    (hP : Group.IsPerfect P) {Z : Subgroup P} [Z.Normal] (hZc : Z ≤ Subgroup.center P)
    (e : P ⧸ Z ≃* Q) : CFSG.IsQuasisimple P ∧ Subgroup.center P = Z := by
  haveI := isPerfect_of_quotient_equiv hP e
  have hQ : Subgroup.center Q = ⊥ := center_eq_bot_of_perfect_simple Q
  have hc := center_eq_of_quotient hZc e hQ
  let e' : P ⧸ Subgroup.center P ≃* Q := (QuotientGroup.quotientMulEquivOfEq hc).trans e
  haveI := (inferInstance : IsSimpleGroup Q).toNontrivial
  obtain ⟨a, b, hab⟩ : ∃ a b : Q, a * b ≠ b * a := by
    by_contra hcon
    push Not at hcon
    letI : CommGroup Q := { ‹Group Q› with mul_comm := hcon }
    exact Group.IsPerfect.not_isSolvable Q inferInstance
  exact ⟨⟨hP, e'.isSimpleGroup, e'.symm a, e'.symm b,
    fun h' => hab (e'.symm.injective (by rw [map_mul, map_mul, h']))⟩, hc⟩

theorem exceptional_psl_three_two_dvd (f : ℕ) :
    (exceptionalOrders .PSL 3 2 f).1 * (exceptionalOrders .PSL 3 2 f).2 ∣ 16 := by
  unfold CFSG.Blueprint.Multiplier.exceptionalOrders
  split <;> simp_all <;> norm_num

theorem exceptional_psu_three (p f : ℕ) : exceptionalOrders .PSU 3 p f = (1, 1) := by
  unfold CFSG.Blueprint.Multiplier.exceptionalOrders
  split <;> simp_all

theorem multGood_of_projSL_three_two
    (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels) {Q : Type} [Group Q]
    {e : ℕ} (he : 2 ≤ e) (φ : Q ≃* projSL 3 (GaloisField 2 e)) : MultGood Q := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI := Sec4.Item462AltProof.isSimpleGroup_projSL_three (GaloisField 2 e)
  haveI : IsSimpleGroup Q := φ.isSimpleGroup
  intro P _ _ hP Z _ hZc ⟨f⟩ h3
  have hadm : StatedLieAdmissible .PSL 3 2 e :=
    ⟨Nat.prime_two, by omega, by norm_num, by simp, by simp⟩
  have hm := KFacts.KS21Mult.lieModel_of_mulEquiv φ (KFacts.KS21Mult.lieModel_projSL hadm)
  have hd := card_dvd_table hGA hm hP hZc f
  have hg : (genericOrders .PSL 3 2 e).1 ∣ 3 ∧ (genericOrders .PSL 3 2 e).2 = 1 :=
    ⟨Nat.gcd_dvd_left _ _, rfl⟩
  rw [hg.2, mul_one] at hd
  have h48 : Nat.card Z ∣ 3 * 16 :=
    hd.trans (Nat.mul_dvd_mul hg.1 (exceptional_psl_three_two_dvd e))
  have h16 : Nat.card Z ∣ 16 :=
    ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr h3).symm.dvd_of_dvd_mul_left h48
  by_cases hZ : Z = ⊥
  · exact Or.inl hZ
  · right
    obtain ⟨k, -, hk2⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp (by simpa using h16 :
      Nat.card Z ∣ 2 ^ 4)
    have hZ2 : IsPGroup 2 Z := IsPGroup.of_card hk2
    obtain ⟨hq, hc⟩ := isQuasisimple_of_central_cover hP hZc f
    refine ⟨hZ2, ?_⟩
    exact Sec21.Item21Early2Proof.twoRankGood_projSL_three he P hq (by rw [hc]; exact hZ2)
      ⟨(QuotientGroup.quotientMulEquivOfEq hc).trans (f.trans φ)⟩

theorem multGood_of_projSU_three_two
    (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels) {Q : Type} [Group Q]
    {e : ℕ} (he : 3 ≤ e) (φ : Q ≃* projSU 3 2 e) : MultGood Q := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro P _ _ hP Z _ hZc ⟨f⟩ h3
  have h2e : 2 < 2 ^ e :=
    calc 2 < 2 ^ 2 := by norm_num
      _ ≤ 2 ^ e := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hadm : StatedLieAdmissible .PSU 3 2 e :=
    ⟨Nat.prime_two, by omega, le_rfl, by
      intro h
      have := (Prod.mk.inj h).2
      omega⟩
  have hm := KFacts.KS21Mult.lieModel_of_mulEquiv φ (KFacts.KS21Mult.lieModel_projSU hadm)
  have hd := card_dvd_table hGA hm hP hZc f
  have hg : (genericOrders .PSU 3 2 e).1 ∣ 3 ∧ (genericOrders .PSU 3 2 e).2 = 1 :=
    ⟨Nat.gcd_dvd_left _ _, rfl⟩
  rw [hg.2, exceptional_psu_three] at hd
  have h3' : Nat.card Z ∣ 3 := by
    simp only [mul_one] at hd
    exact hd.trans hg.1
  rcases (Nat.dvd_prime Nat.prime_three).mp h3' with h1 | h1
  · exact Or.inl (Subgroup.eq_bot_of_card_eq _ h1)
  · exact (h3 (by rw [h1])).elim

theorem nontrivial_projSU_three_two_one : Nontrivial (projSU 3 2 1) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [← Finite.one_lt_card_iff_nontrivial, KFacts.card_projSU_three_two (le_refl 1),
    CFSG.GH74.Generic.S3.L3Ord.ordTwistedA_two]
  norm_num

section Even


theorem theta_eq_pCore_two_of_isoLThreePi_even
    (h44 : Sec4.Item4_4) (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    {X : Type} [Group X] [Finite X] (hX : SectionFourHyp X) (hperf : Group.IsPerfect X) {e : ℕ}
    (he : 1 ≤ e) (h : Sec4.IsoLThreePi (X ⧸ aschbacherSolvableCore 3 X) 2 e) :
    aschbacherSolvableCore 3 X = CFSG.pCore 2 X := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI := hperf
  rcases h with ⟨h1, ⟨φ⟩⟩ | ⟨h2, ⟨φ⟩⟩
  ·
    have he2 : 2 ≤ e := by
      by_contra hlt
      have : e = 1 := by omega
      subst this
      norm_num at h1
    haveI := Sec4.Item462AltProof.isSimpleGroup_projSL_three (GaloisField 2 e)
    haveI hsimple : IsSimpleGroup (X ⧸ aschbacherSolvableCore 3 X) := φ.isSimpleGroup
    have hK : Nat.card (GaloisField 2 e) = 2 ^ e := GaloisField.card 2 e (by omega)
    have h3q : 3 < 2 ^ e :=
      calc 3 < 2 ^ 2 := by norm_num
        _ ≤ 2 ^ e := Nat.pow_le_pow_right (by norm_num) he2
    have hbig : 5616 < Nat.card (X ⧸ aschbacherSolvableCore 3 X) := by
      rw [Nat.card_congr φ.toEquiv, Sec8.Item8ModelProof.card_projSL_three_galois (by omega)]
      have := CFSG.GH74.Generic.BProg.B2.SD2.SDOrders.lt_ordA h3q
      omega
