variable {X : Type} [Group X] [Finite X]

@[expose] def MultGood (Q : Type) [Group Q] : Prop :=
  ∀ (P : Type) [Group P] [Finite P], Group.IsPerfect P →
    ∀ (Z : Subgroup P) [Z.Normal], Z ≤ Subgroup.center P → Nonempty (P ⧸ Z ≃* Q) →
      ¬ 3 ∣ Nat.card Z → Z = ⊥ ∨ (IsPGroup 2 Z ∧ 3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup P))

theorem map_theta_cases (hperf : Group.IsPerfect X)
    (hsimple : IsSimpleGroup (X ⧸ aschbacherSolvableCore 3 X))
    (hmult : MultGood (X ⧸ aschbacherSolvableCore 3 X)) {N : Subgroup X} [N.Normal]
    (hNθ : N ≤ aschbacherSolvableCore 3 X) (hq : IsQuasisimple (X ⧸ N)) :
    (aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N) ≤ Subgroup.center (X ⧸ N) ∧
    ((aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N) = ⊥ ∨
      (IsPGroup 2 ((aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N)) ∧
        3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup (X ⧸ N)))) := by
  haveI := hperf
  obtain ⟨hθsol, -, hθ3, -, -, -, -⟩ :=
    solvable_prime_complement_core_characterization (H := X) Nat.prime_three
  haveI hZn : ((aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N)).Normal :=
    Subgroup.Normal.map inferInstance (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
  obtain ⟨e⟩ := CFSG.LocalAnalysis.GLTheoremA.H248.quotient_quotient_map_equiv N
    (aschbacherSolvableCore 3 X) hNθ
  haveI := hsimple.toNontrivial
  haveI : Nontrivial ((X ⧸ N) ⧸ (aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N)) :=
    e.symm.injective.nontrivial
  have hZsol : Group.IsSolvable ((aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N)) :=
    Group.isSolvable_of_surjective
      (MonoidHom.subgroupMap_surjective (QuotientGroup.mk' N) (aschbacherSolvableCore 3 X))
  have hZc := le_center_of_isQuasisimple hq hZsol
  have hdvd : Nat.card ((aschbacherSolvableCore 3 X).map (QuotientGroup.mk' N)) ∣
      Nat.card (aschbacherSolvableCore 3 X) := Subgroup.card_map_dvd _ (QuotientGroup.mk' N)
  exact ⟨hZc, hmult (X ⧸ N) inferInstance _ hZc ⟨e⟩ (fun h => hθ3 (h.trans hdvd))⟩

