def Triple2 (G : Type*) [Group G] : Prop :=
  ∃ a b c : G, a * a = 1 ∧ b * b = 1 ∧ c * c = 1 ∧ a * b = b * a ∧ a * c = c * a ∧
    b * c = c * b ∧ a ≠ 1 ∧ b ≠ 1 ∧ c ≠ 1 ∧ a * b ≠ 1 ∧ a * c ≠ 1 ∧ b * c ≠ 1 ∧ a * b * c ≠ 1

theorem normal_le_of_ne_top {X : Type} [Group X] [Group.IsPerfect X] {K : Subgroup X}
    [K.Normal] (hK : Group.IsSolvable K) (hs : IsSimpleGroup (X ⧸ K)) {N : Subgroup X}
    [N.Normal] (hN : N ≠ ⊤) : N ≤ K := by
  by_contra hle
  have hmapn : (N.map (QuotientGroup.mk' K)).Normal :=
    Subgroup.Normal.map ‹N.Normal› (QuotientGroup.mk' K) (QuotientGroup.mk'_surjective K)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (N.map (QuotientGroup.mk' K)) with h | h
  · apply hle
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  · apply hN
    have hsurj : Function.Surjective ((QuotientGroup.mk' N).comp K.subtype) := by
      intro y
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N y
      have hx : QuotientGroup.mk' K x ∈ N.map (QuotientGroup.mk' K) := by
        rw [h]
        trivial
      obtain ⟨n, hn, hnx⟩ := hx
      have hk : n⁻¹ * x ∈ K := by
        rw [← QuotientGroup.eq]
        exact hnx
      refine ⟨⟨n⁻¹ * x, hk⟩, ?_⟩
      change QuotientGroup.mk' N (n⁻¹ * x) = QuotientGroup.mk' N x
      rw [map_mul, map_inv, show QuotientGroup.mk' N n = 1 from (QuotientGroup.eq_one_iff n).mpr hn,
        inv_one, one_mul]
    haveI : Group.IsSolvable K := hK
    have : Group.IsSolvable (X ⧸ N) := Group.isSolvable_of_surjective hsurj
    exact Sec4.Census.eq_top_of_isSolvable_quotient this

theorem three_le_pRank_of_triple2 {G : Type} [Group G] [Finite G] (h : Triple2 G) :
    3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup G) := by
  obtain ⟨a, b, c, ha, hb, hc, hab, hac, hbc, h1, h2, h3, h4, h5, h6, h7⟩ := h
  obtain ⟨ι, hι⟩ := Gap128OTwoHJ.exists_injective_e8 (a := a) (b := b) (c := c)
    (by rw [sq]; exact ha) (by rw [sq]; exact hb) (by rw [sq]; exact hc) hab hac hbc h1 h2 h3 h4
    h5 h6 h7
  exact CFSG.SectionRank.le_pRank_of_injective (p := 2) (by norm_num) (by decide)
    Gap128OTwoHJ.e8_sq (k := 3) (by rw [Gap128OTwoHJ.card_e8]; norm_num) ι hι le_top

theorem exists_notMem_of_card_lt {E : Type*} [Fintype E] [DecidableEq E] (s : Finset E)
    (h : s.card < Fintype.card E) : ∃ x : E, x ∉ s := by
  by_contra hcon
  push Not at hcon
  have : s = Finset.univ := Finset.eq_univ_of_forall hcon
  rw [this, Finset.card_univ] at h
  exact lt_irrefl _ h

theorem triple2_of_three_le_pRank {G : Type} [Group G] [Finite G]
    (h : 3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup G)) : Triple2 G := by
  classical
  obtain ⟨E, -, hE, hcard⟩ := CFSG.SectionRank.exists_pRank (p := 2) (by norm_num) (⊤ : Subgroup G)
  have h8 : 8 ≤ Nat.card E := by
    rw [hcard]
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ CFSG.Open.pRank 2 (⊤ : Subgroup G) := Nat.pow_le_pow_right (by norm_num) h
  haveI : Fintype E := Fintype.ofFinite E
  have hcardE : Fintype.card E = Nat.card E := (Nat.card_eq_fintype_card).symm
  have hsq : ∀ x : E, x * x = 1 := fun x =>
    Subtype.ext (by simpa [sq] using hE.2 (x : G) x.2)
  have hcomm : ∀ x y : E, x * y = y * x := fun x y => hE.1.is_comm.comm x y
  obtain ⟨a, ha⟩ := exists_notMem_of_card_lt ({1} : Finset E) (by
    rw [Finset.card_singleton]; omega)
  obtain ⟨b, hb⟩ := exists_notMem_of_card_lt ({1, a} : Finset E) (by
    have := Finset.card_le_two (a := (1 : E)) (b := a)
    omega)
  obtain ⟨c, hc⟩ := exists_notMem_of_card_lt ({1, a, b, a * b} : Finset E) (by
    have := Finset.card_le_four (a := (1 : E)) (b := a) (c := b) (d := a * b)
    omega)
  simp only [Finset.mem_singleton, Finset.mem_insert, not_or] at ha hb hc
  obtain ⟨hb1, hba⟩ := hb
  obtain ⟨hc1, hca, hcb, hcab⟩ := hc
  have hinv : ∀ x : E, x⁻¹ = x := fun x => inv_eq_of_mul_eq_one_right (hsq x)
  refine ⟨a, b, c, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact congrArg Subtype.val (hsq a)
  · exact congrArg Subtype.val (hsq b)
  · exact congrArg Subtype.val (hsq c)
  · exact congrArg Subtype.val (hcomm a b)
  · exact congrArg Subtype.val (hcomm a c)
  · exact congrArg Subtype.val (hcomm b c)
  · exact fun h => ha (Subtype.ext h)
  · exact fun h => hb1 (Subtype.ext h)
  · exact fun h => hc1 (Subtype.ext h)
  · intro h
    have : a * b = 1 := Subtype.ext h
    exact hba (by rw [← hinv a]; exact (eq_inv_of_mul_eq_one_right this))
  · intro h
    have : a * c = 1 := Subtype.ext h
    exact hca (by rw [← hinv a]; exact (eq_inv_of_mul_eq_one_right this))
  · intro h
    have : b * c = 1 := Subtype.ext h
    exact hcb (by rw [← hinv b]; exact (eq_inv_of_mul_eq_one_right this))
  · intro h
    have : a * b * c = 1 := Subtype.ext h
    exact hcab (by rw [← hinv (a * b)]; exact (eq_inv_of_mul_eq_one_right this))

theorem false_of_triple_quotient {S Q : Type*} [Group S] [Group Q] (π : S →* Q)
    (hπ : Function.Surjective π) {z : S} (hz : z ∈ Subgroup.center S) (hz1 : z ≠ 1)
    (hz2 : z * z = 1) (hinv : ∀ x : S, x * x = 1 → x = 1 ∨ x = z)
    (hker : ∀ x : S, π x = 1 → x = 1 ∨ x = z) (h : Triple2 Q) : False := by
  obtain ⟨a, b, c, ha, hb, hc, hab, hac, hbc, ha1, hb1, hc1, hab1, hac1, hbc1, habc1⟩ := h
  obtain ⟨a', rfl⟩ := hπ a
  obtain ⟨b', rfl⟩ := hπ b
  obtain ⟨c', rfl⟩ := hπ c
  have hzc : ∀ x : S, z * x = x * z := fun x => (Subgroup.mem_center_iff.mp hz x).symm
  by_cases hπz : π z = 1
  ·
    have hsq : ∀ x : S, π x * π x = 1 → π x ≠ 1 → x * x = z := by
      intro x hx1 hx2
      have : π (x * x) = 1 := by rw [map_mul]; exact hx1
      rcases hker _ this with h | h
      · exfalso
        rcases hinv x h with h' | h'
        · exact hx2 (by rw [h', map_one])
        · exact hx2 (by rw [h', hπz])
      · exact h
    have hanti : ∀ x y : S, x * x = z → y * y = z → π x * π y = π y * π x → π (x * y) ≠ 1 →
        x * y = z * (y * x) := by
      intro x y hx hy hxy hne
      have hcm : π (x * y * (y * x)⁻¹) = 1 := by
        simp only [map_mul, map_inv]
        rw [← hxy]
        exact mul_inv_cancel _
      rcases hker _ hcm with h | h
      · exfalso
        have hxy' : x * y = y * x := by
          rwa [mul_inv_eq_one] at h
        have hsqxy : (x * y) * (x * y) = 1 := by
          calc x * y * (x * y) = x * (y * x) * y := by group
            _ = x * (x * y) * y := by rw [← hxy']
            _ = x * x * (y * y) := by group
            _ = z * z := by rw [hx, hy]
            _ = 1 := hz2
        rcases hinv _ hsqxy with h' | h'
        · exact hne (by rw [h', map_one])
        · exact hne (by rw [h', hπz])
      · calc x * y = x * y * (y * x)⁻¹ * (y * x) := by group
          _ = z * (y * x) := by rw [h]
    have hz' : ∀ g : S, g * z = z * g := fun g => Subgroup.mem_center_iff.mp hz g
    have ha2 := hsq a' ha ha1
    have hb2 := hsq b' hb hb1
    have hc2 := hsq c' hc hc1
    have hπab : π (a' * b') = π a' * π b' := map_mul π a' b'
    have habsq : π (a' * b') * π (a' * b') = 1 := by
      rw [hπab]
      calc π a' * π b' * (π a' * π b') = π a' * (π b' * π a') * π b' := by group
        _ = π a' * (π a' * π b') * π b' := by rw [← hab]
        _ = (π a' * π a') * (π b' * π b') := by group
        _ = 1 := by rw [ha, hb, one_mul]
    have hab2 := hsq (a' * b') habsq (by rw [hπab]; exact hab1)
    have e2 := hanti a' c' ha2 hc2 hac (by rw [map_mul]; exact hac1)
    have e3 := hanti b' c' hb2 hc2 hbc (by rw [map_mul]; exact hbc1)
    have habc : π (a' * b') * π c' = π c' * π (a' * b') := by
      rw [hπab]
      calc π a' * π b' * π c' = π a' * (π b' * π c') := by group
        _ = π a' * (π c' * π b') := by rw [hbc]
        _ = (π a' * π c') * π b' := by group
        _ = (π c' * π a') * π b' := by rw [hac]
        _ = π c' * (π a' * π b') := by group
    have e4 := hanti (a' * b') c' hab2 hc2 habc (by rw [map_mul, map_mul]; exact habc1)
    have stepA : a' * (z * (c' * b')) = z * (a' * (c' * b')) := by
      rw [← mul_assoc, hz' a', mul_assoc]
    have stepB : a' * (c' * b') = z * (c' * a' * b') := by
      rw [← mul_assoc, e2, mul_assoc]
    have e5 : a' * b' * c' = c' * (a' * b') := by
      calc a' * b' * c' = a' * (b' * c') := mul_assoc _ _ _
        _ = a' * (z * (c' * b')) := by rw [e3]
        _ = z * (a' * (c' * b')) := stepA
        _ = z * (z * (c' * a' * b')) := by rw [stepB]
        _ = (z * z) * (c' * a' * b') := (mul_assoc _ _ _).symm
        _ = c' * a' * b' := by rw [hz2, one_mul]
        _ = c' * (a' * b') := mul_assoc _ _ _
    have : z * (c' * (a' * b')) = 1 * (c' * (a' * b')) := by rw [← e4, e5, one_mul]
    exact hz1 (mul_right_cancel this)
  · have hinj : ∀ x : S, π x = 1 → x = 1 := fun x hx =>
      (hker x hx).resolve_right (fun h => hπz (by rw [← h]; exact hx))
    have hsqa : ∀ x : S, π x * π x = 1 → π x ≠ 1 → x = z := by
      intro x hx1 hx2
      have : x * x = 1 := hinj _ (by rw [map_mul]; exact hx1)
      exact (hinv x this).resolve_left (fun h => hx2 (by rw [h, map_one]))
    have ea := hsqa a' ha ha1
    have eb := hsqa b' hb hb1
    exact hab1 (by rw [ea, eb, ← map_mul, hz2, map_one])

theorem false_of_sl2_quotient {p : ℕ} [hp : Fact p.Prime] (hp5 : 5 ≤ p) {Q : Type} [Group Q]
    [Finite Q] [Nontrivial Q] (π : Matrix.SpecialLinearGroup (Fin 2) (ZMod p) →* Q)
    (hπ : Function.Surjective π) (hr : 3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup Q)) : False := by
  haveI : NeZero p := ⟨hp.out.ne_zero⟩
  have hodd : Odd (Nat.card (ZMod p)) := by
    rw [Nat.card_zmod]
    exact hp.out.odd_of_ne_two (by omega)
  have h2 : (2 : ZMod p) ≠ 0 := CFSG.Semidihedral.OddFieldSL2.two_ne_zero_of_odd_card _ hodd
  have h4 : 4 ≤ Nat.card (ZMod p) := by
    rw [Nat.card_zmod]
    omega
  have hker : ∀ x, π x = 1 → x = 1 ∨ x = -1 := by
    intro x hx
    have hxk : x ∈ π.ker := hx
    rcases CFSG.ClassicalInvolution.sl2_normal_cases h4 π.ker (MonoidHom.normal_ker π) with
      h | h | h
    · left
      rw [h] at hxk
      exact hxk
    · rw [h] at hxk
      exact (CFSG.ClassicalInvolution.mem_center_sl2_iff x).mp hxk
    · exfalso
      obtain ⟨q, hq⟩ := exists_ne (1 : Q)
      obtain ⟨y, rfl⟩ := hπ q
      exact hq (MonoidHom.mem_ker.mp (h ▸ Subgroup.mem_top y))
  have hneg2 : (-1 : Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) *
      (-1 : Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) = 1 := by
    have := pow_orderOf_eq_one (-1 : Matrix.SpecialLinearGroup (Fin 2) (ZMod p))
    rwa [CFSG.ClassicalInvolution.sl2_orderOf_neg_one hodd, sq] at this
  exact false_of_triple_quotient π hπ
    ((CFSG.ClassicalInvolution.mem_center_sl2_iff _).mpr (Or.inr rfl))
    (CFSG.ClassicalInvolution.sl2_neg_one_ne_one hodd) hneg2
    (fun x hx => CFSG.RankThree.PartTwo.Sec21.Hering233i.sl2_eq_one_or_neg_one_of_mul_self h2 hx)
    hker (triple2_of_three_le_pRank hr)

theorem odd_card_oddCore' (G : Type*) [Group G] [Finite G] : Odd (Nat.card (CFSG.oddCore G)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [(CFSG.oddCore_eq_piCore (G := G)).trans (CFSG.pPrimeCore_eq_piCore (G := G) 2).symm]
  exact Nat.coprime_two_left.mp CFSG.pPrimeCore_coprime_card

theorem le_center_of_isQuasisimple {P : Type} [Group P] [Group.IsPerfect P]
    (hq : IsQuasisimple P) {Z : Subgroup P} [Z.Normal] (hZ : Group.IsSolvable Z)
    [Nontrivial (P ⧸ Z)] : Z ≤ Subgroup.center P := by
  have hs : IsSimpleGroup (P ⧸ Subgroup.center P) := hq.2.1
  have hn : (Z.map (QuotientGroup.mk' (Subgroup.center P))).Normal :=
    Subgroup.Normal.map ‹Z.Normal› _ (QuotientGroup.mk'_surjective _)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
    (Z.map (QuotientGroup.mk' (Subgroup.center P))) with h | h
  · rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  · exfalso
    have hsurj : Function.Surjective ((QuotientGroup.mk' Z).comp (Subgroup.center P).subtype) := by
      intro y
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective Z y
      have hx : QuotientGroup.mk' (Subgroup.center P) x ∈
          Z.map (QuotientGroup.mk' (Subgroup.center P)) := by
        rw [h]
        trivial
      obtain ⟨n, hn, hnx⟩ := hx
      have hk : n⁻¹ * x ∈ Subgroup.center P := by
        rw [← QuotientGroup.eq]
        exact hnx
      refine ⟨⟨n⁻¹ * x, hk⟩, ?_⟩
      change QuotientGroup.mk' Z (n⁻¹ * x) = QuotientGroup.mk' Z x
      rw [map_mul, map_inv, show QuotientGroup.mk' Z n = 1 from (QuotientGroup.eq_one_iff n).mpr hn,
        inv_one, one_mul]
    have : Group.IsSolvable (P ⧸ Z) := Group.isSolvable_of_surjective hsurj
    exact Group.IsPerfect.not_isSolvable (P ⧸ Z) this

theorem false_of_central_pGroup {P : Type} [Group P] [Finite P] (hP : CFSG.pCore 2 P = ⊥)
    {Z : Subgroup P} (hZ : Z ≤ Subgroup.center P) (hZ2 : IsPGroup 2 Z) (hZ1 : Z ≠ ⊥) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : 2 ∣ Nat.card Z := by
    obtain ⟨k, hk⟩ := hZ2.exists_card_eq
    rcases Nat.eq_zero_or_pos k with rfl | hk0
    · exact absurd (Subgroup.eq_bot_of_card_eq _ (by rw [hk, pow_zero])) hZ1
    · rw [hk]
      exact dvd_pow_self 2 hk0.ne'
  obtain ⟨t, ht⟩ := exists_prime_orderOf_dvd_card' (G := Z) 2 h2
  have ht' : orderOf (t : P) = 2 := by rw [Subgroup.orderOf_coe, ht]
  have ht1' : (t : P) ≠ 1 := by
    intro h
    rw [h, orderOf_one] at ht'
    omega
  have hnorm : (Subgroup.zpowers (t : P)).Normal :=
    Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr (hZ t.2))
  have hpg : IsPGroup 2 (Subgroup.zpowers (t : P)) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, ht', pow_one])
  have hle : Subgroup.zpowers (t : P) ≤ CFSG.pCore 2 P := le_sSup ⟨hnorm, hpg⟩
  rw [hP, le_bot_iff, Subgroup.zpowers_eq_bot] at hle
  exact ht1' hle


