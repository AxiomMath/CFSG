theorem five_thousand_lt_card_of_isG2D4 {X : Type} [Group X] {r : TauCeti.PrimePower} {δ : ℕ}
    (h : IsG2D4 X r δ) : 5616 < Nat.card X := by
  rcases Hering129KOrders.card_of_isG2D4 h with ⟨h1, hc⟩ | ⟨-, hc⟩
  · rw [hc]
    have h3 : 3 ≤ r.card := Hering129KOrders.three_le_card_of_isG2D4_one (h1 ▸ h)
    have := Hering129KOrders.le_ordG2 h3
    rw [Hering129KOrders.ordG2_three] at this
    omega
  · rw [hc]
    have := Hering129KOrders.le_ordTrialityD4 (Hering129KOrders.two_le_card r)
    rw [Hering129KOrders.ordTrialityD4_two] at this
    omega

theorem untwistedModel_of_isoGTwo {X : Type} [Group X] {r : TauCeti.PrimePower}
    (hX : Sec4.IsoGTwo X r) : UntwistedChevalleyModel X .G2 r.card := by
  obtain ⟨K, _, _, hcard, -, ⟨e⟩⟩ := Hering129KModels.exists_adjoint_model hX
  exact ⟨K, inferInstance, inferInstance, hcard, ⟨e.trans
    ((QuotientGroup.quotientMulEquivOfEq center_adjointGroup_eq_bot).trans
      QuotientGroup.quotientBot).symm⟩⟩

theorem twistedModel_of_isoD4 {X : Type} [Group X] {r : TauCeti.PrimePower}
    {hr : (TauCeti.LieTypeIndex.trialityD4 r).Valid}
    (f : X ≃* (TauCeti.CFSGIndex.lie ⟨.trialityD4 r, hr⟩).Group) :
    TwistedChevalleyModel X .D4 r.card := by
  have : Fact r.p.Prime := ⟨r.prime_p⟩
  set K := GaloisField r.p (3 * r.exponent)
  have hK3 : Nat.card K = r.card ^ 3 := by
    rw [TauCeti.PrimePower.card_def, GaloisField.card _ _ (by have := r.exponent_pos; omega),
      ← pow_mul, mul_comm]
  set σ' : K ≃+* K := iterateFrobeniusEquiv K r.p r.exponent with hσ'def
  have hσ'y : ∀ y : K, σ' y = y ^ r.card := fun y => by
    rw [hσ'def, iterateFrobeniusEquiv_def, TauCeti.PrimePower.card_def]
  have hK3' : Nat.card K = r.card ^ TwistTag.D4.order := hK3
  obtain ⟨b⟩ := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.trialityD4 r hr K hK3'
    σ'.toRingHom hσ'y
  exact ⟨K, inferInstance, inferInstance, hK3', σ'.toRingHom, hσ'y, ⟨f.trans b.symm⟩⟩

theorem three_le_pRank_of_isG2D4 {Q : Type} [Group Q] [Finite Q] {r : TauCeti.PrimePower}
    {δ : ℕ} (h : IsG2D4 Q r δ) (hD4 : δ = 3 → r.p = 2) :
    3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup Q) := by
  rcases h with ⟨h1, hX⟩ | ⟨h3, hr, ⟨f⟩⟩
  · by_cases hp2 : r.p = 2
    · haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      have hU : UntwistedChevalleyModel Q .G2 (2 ^ r.exponent) := by
        have := untwistedModel_of_isoGTwo hX
        rwa [TauCeti.PrimePower.card_def, hp2] at this
      have := CFSG.SectionRank.three_mul_le_pRank_of_G2Model (p := 2) hU
      have := r.exponent_pos
      omega
    · obtain ⟨K, _, _, hcard, hKp, ⟨e⟩⟩ := Hering129KModels.exists_adjoint_model hX
      have hK : ringChar K ≠ 2 := by rw [hKp]; exact hp2
      rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num) e]
      exact three_le_pRank_of_triple2 (triple2_adjointG2 hK)
  · have hp2 := hD4 h3
    have hM := twistedModel_of_isoD4 f
    rw [TauCeti.PrimePower.card_def, hp2] at hM
    have := CFSG.GH74.Filter.Lie.five_le_pRank_of_trialityD4Model_two r.exponent_pos hM
    omega

theorem exceptionalOrders_g2 (p f : ℕ) :
    (CFSG.Blueprint.Multiplier.exceptionalOrders .G2 0 p f = (2, 1) ∧ p = 2 ∧ f = 2) ∨
    (CFSG.Blueprint.Multiplier.exceptionalOrders .G2 0 p f = (3, 1) ∧ p = 3 ∧ f = 1) ∨
    CFSG.Blueprint.Multiplier.exceptionalOrders .G2 0 p f = (1, 1) := by
  unfold CFSG.Blueprint.Multiplier.exceptionalOrders
  split <;> simp_all

theorem exceptionalOrders_d4 (p f : ℕ) :
    CFSG.Blueprint.Multiplier.exceptionalOrders .trialityD4 0 p f = (1, 1) := by
  unfold CFSG.Blueprint.Multiplier.exceptionalOrders
  split <;> simp_all

theorem card_dvd_exceptional (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    {Q : Type} [Group Q] {t : CFSG.Assembly.LowTwoRank.StatedLieTag}
    (ht : t = .G2 ∨ t = .trialityD4)
    {p f : ℕ} (hm : CFSG.Models.LieModel Q t 0 p f) {P : Type} [Group P] (hP : Group.IsPerfect P)
    {Z : Subgroup P} [Z.Normal] (hZc : Z ≤ Subgroup.center P) (e : P ⧸ Z ≃* Q) :
    Nat.card Z ∣ (CFSG.Blueprint.Multiplier.exceptionalOrders t 0 p f).1 *
      (CFSG.Blueprint.Multiplier.exceptionalOrders t 0 p f).2 := by
  have hdvd := KFacts.KS14.card_dvd_griess_of_le_center hP hZc e
  rw [Nat.card_congr (RankThree.PerfectCover.hopfMultiplierEquivGriess Q).toEquiv,
    CFSG.GH74.Generic.card_hopfMultiplier_of_griess hGA hm] at hdvd
  have hgen : CFSG.Blueprint.Multiplier.genericOrders t 0 p f = (1, 1) := by
    rcases ht with rfl | rfl <;> rfl
  rw [hgen] at hdvd
  simpa using hdvd


theorem lieModel_g2 {Q : Type} [Group Q] {r : TauCeti.PrimePower} (hX : Sec4.IsoGTwo Q r) :
    CFSG.Models.LieModel Q .G2 0 r.p r.exponent := by
  have h3 : 3 ≤ r.p ^ r.exponent := by
    have := Hering129KOrders.three_le_card_of_isoGTwo hX
    rwa [TauCeti.PrimePower.card_def] at this
  obtain ⟨hq, ⟨f⟩⟩ := hX
  exact ⟨⟨r.prime_p, r.exponent_pos, rfl, h3⟩, Or.inr ⟨rfl, ⟨.G2 r, hq⟩, ⟨rfl, rfl⟩, ⟨f⟩⟩⟩

theorem lieModel_d4 {Q : Type} [Group Q] {r : TauCeti.PrimePower}
    {hr : (TauCeti.LieTypeIndex.trialityD4 r).Valid}
    (f : Q ≃* (TauCeti.CFSGIndex.lie ⟨.trialityD4 r, hr⟩).Group) :
    CFSG.Models.LieModel Q .trialityD4 0 r.p r.exponent :=
  ⟨⟨r.prime_p, r.exponent_pos, rfl⟩, Or.inr ⟨rfl, ⟨.trialityD4 r, hr⟩, ⟨rfl, rfl⟩, ⟨f⟩⟩⟩

theorem three_le_pRank_double_cover {P : Type} [Group P] [Finite P] {Q : Type} [Group Q]
    {r : TauCeti.PrimePower} (hX : Sec4.IsoGTwo Q r) (hp : r.p = 2) (hf : r.exponent = 2)
    {Z : Subgroup P} [Z.Normal] (hZc : Z ≤ Subgroup.center P) (e : P ⧸ Z ≃* Q)
    (hZ2 : Nat.card Z = 2) : 3 ≤ CFSG.Open.pRank 2 (⊤ : Subgroup P) := by
  obtain ⟨K, _, _, hcard, hKp, ⟨eK⟩⟩ := Hering129KModels.exists_adjoint_model hX
  have hK4 : Nat.card K = 4 := by
    rw [hcard, TauCeti.PrimePower.card_def, hp, hf]
    norm_num
  haveI : CharP K 2 := (ringChar.eq_iff).mp (hKp.trans hp)
  let π : P →* adjointGroup .G2 K :=
    eK.toMonoidHom.comp (e.toMonoidHom.comp (QuotientGroup.mk' Z))
  have hπ : Function.Surjective π := by
    intro y
    obtain ⟨q, rfl⟩ := eK.surjective y
    obtain ⟨u, rfl⟩ := e.surjective q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective u
    exact ⟨x, rfl⟩
  have hkerZ : π.ker = Z := by
    ext x
    rw [MonoidHom.mem_ker]
    change eK (e (QuotientGroup.mk' Z x)) = 1 ↔ x ∈ Z
    rw [map_eq_one_iff _ eK.injective, map_eq_one_iff _ e.injective, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
  have hker : π.ker = Subgroup.center P := by
    refine le_antisymm (hkerZ ▸ hZc) ?_
    intro x hx
    have hxc : π x ∈ Subgroup.center (adjointGroup .G2 K) := by
      rw [Subgroup.mem_center_iff]
      intro g
      obtain ⟨w, rfl⟩ := hπ g
      rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hx w]
    rw [center_adjointGroup_eq_bot, Subgroup.mem_bot] at hxc
    exact hxc
  have hcenter : Nat.card (Subgroup.center P) = 2 := by
    rw [← hker, hkerZ]
    exact hZ2
  have h5 := Sec4.Census.DoubleCoverRanksTwo.five_le_pRank_adjointGroup hK4 π hπ hker hcenter
  rw [CFSG.SectionRank.pRank_eq_open_pRank_top] at h5
  omega

theorem multGood_of_isG2D4 (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    {Q : Type} [Group Q] {r : TauCeti.PrimePower} {δ : ℕ} (h : IsG2D4 Q r δ) : MultGood Q := by
  intro P _ _ hP Z _ hZc ⟨e⟩ h3
  rcases h with ⟨h1, hX⟩ | ⟨h3', hr, ⟨f⟩⟩
  · have hm := lieModel_g2 hX
    have hd := card_dvd_exceptional hGA (Or.inl rfl) hm hP hZc e
    rcases exceptionalOrders_g2 r.p r.exponent with ⟨hE, hp, hf⟩ | ⟨hE, hp, hf⟩ | hE
    · rw [hE] at hd
      have hd2 : Nat.card Z ∣ 2 := by simpa using hd
      rcases (Nat.dvd_prime Nat.prime_two).mp hd2 with h1 | h2
      · exact Or.inl (Subgroup.eq_bot_of_card_eq _ h1)
      · exact Or.inr ⟨IsPGroup.of_card (n := 1) (by rw [h2, pow_one]),
          three_le_pRank_double_cover hX hp hf hZc e h2⟩
    · rw [hE] at hd
      have hd3 : Nat.card Z ∣ 3 := by simpa using hd
      rcases (Nat.dvd_prime Nat.prime_three).mp hd3 with h1 | h2
      · exact Or.inl (Subgroup.eq_bot_of_card_eq _ h1)
      · exact (h3 (by rw [h2])).elim
    · rw [hE] at hd
      exact Or.inl (Subgroup.eq_bot_of_card_eq _ (Nat.dvd_one.mp (by simpa using hd)))
  · have hm := lieModel_d4 f
    have hd := card_dvd_exceptional hGA (Or.inr rfl) hm hP hZc e
    rw [exceptionalOrders_d4] at hd
    exact Or.inl (Subgroup.eq_bot_of_card_eq _ (Nat.dvd_one.mp (by simpa using hd)))


theorem isQuasisimple_of_isG2D4 {Q : Type} [Group Q] {r : TauCeti.PrimePower} {δ : ℕ}
    (h : IsG2D4 Q r δ) : CFSG.IsQuasisimple Q := by
  haveI := Hering129KModels.isSimpleGroup_of_isG2D4 h
  have hperf := Hering129KModels.isPerfect_of_isG2D4 h
  have e : Q ⧸ Subgroup.center Q ≃* Q :=
    (QuotientGroup.quotientMulEquivOfEq (Hering129KModels.center_eq_bot_of_isG2D4 h)).trans
      QuotientGroup.quotientBot
  refine ⟨hperf, e.isSimpleGroup, ?_⟩
  obtain ⟨a, b, hab⟩ := Hering129KModels.exists_noncomm_of_perfect hperf
  exact ⟨e.symm a, e.symm b, fun h' => hab (e.symm.injective (by rw [map_mul, map_mul, h']))⟩

