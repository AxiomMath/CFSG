theorem raiseBlk_check : ∀ (i : Fin 4) (k : Fin 3),
    (Matrix.of fun r c => if TauCeti.DynkinType.d4TripledWeight (blkIdx k c) i = -1 ∧
      blkIdx k r = TauCeti.DynkinType.d4TripledReflection i (blkIdx k c) then (1 : ℤ) else 0) =
      raiseBlk i k := by
  decide +kernel

theorem lowerBlk_check : ∀ (i : Fin 4) (k : Fin 3),
    (Matrix.of fun r c => if TauCeti.DynkinType.d4TripledWeight (blkIdx k c) i = 1 ∧
      blkIdx k r = TauCeti.DynkinType.d4TripledReflection i (blkIdx k c) then (1 : ℤ) else 0) =
      lowerBlk i k := by
  decide +kernel

theorem raisingMatrix_blkIdx (i : Fin 4) (k : Fin 3) (r c : Fin 8) :
    TauCeti.D4Tripled.raisingMatrix i (blkIdx k r) (blkIdx k c) = raiseBlk i k r c := by
  rw [TauCeti.D4Tripled.raisingMatrix_apply, ← raiseBlk_check i k, Matrix.of_apply]

theorem loweringMatrix_blkIdx (i : Fin 4) (k : Fin 3) (r c : Fin 8) :
    TauCeti.D4Tripled.loweringMatrix i (blkIdx k r) (blkIdx k c) = lowerBlk i k r c := by
  rw [TauCeti.D4Tripled.loweringMatrix_apply, ← lowerBlk_check i k, Matrix.of_apply]

theorem clifford_check : ∀ a b : Fin 8,
    nuMat a * muMat b + nuMat b * muMat a = formMat a b • (1 : Matrix (Fin 8) (Fin 8) ℤ) := by
  decide +kernel

theorem mu_raise_check : ∀ (i : Fin 4) (a : Fin 8),
    raiseBlk i 2 * muMat a - muMat a * raiseBlk i 1 = ∑ b, raiseBlk i 0 b a • muMat b := by
  decide +kernel

theorem mu_lower_check : ∀ (i : Fin 4) (a : Fin 8),
    lowerBlk i 2 * muMat a - muMat a * lowerBlk i 1 = ∑ b, lowerBlk i 0 b a • muMat b := by
  decide +kernel

theorem nu_raise_check : ∀ (i : Fin 4) (a : Fin 8),
    raiseBlk i 1 * nuMat a - nuMat a * raiseBlk i 2 = ∑ b, raiseBlk i 0 b a • nuMat b := by
  decide +kernel

theorem nu_lower_check : ∀ (i : Fin 4) (a : Fin 8),
    lowerBlk i 1 * nuMat a - nuMat a * lowerBlk i 2 = ∑ b, lowerBlk i 0 b a • nuMat b := by
  decide +kernel

theorem mu_raise_sq_check : ∀ (i : Fin 4) (a : Fin 8),
    (∑ b, raiseBlk i 0 b a • muMat b) * raiseBlk i 1 = 0 := by
  decide +kernel

theorem mu_lower_sq_check : ∀ (i : Fin 4) (a : Fin 8),
    (∑ b, lowerBlk i 0 b a • muMat b) * lowerBlk i 1 = 0 := by
  decide +kernel

theorem nu_raise_sq_check : ∀ (i : Fin 4) (a : Fin 8),
    (∑ b, raiseBlk i 0 b a • nuMat b) * raiseBlk i 2 = 0 := by
  decide +kernel

theorem nu_lower_sq_check : ∀ (i : Fin 4) (a : Fin 8),
    (∑ b, lowerBlk i 0 b a • nuMat b) * lowerBlk i 2 = 0 := by
  decide +kernel

theorem formMat_mul_self : formMat * formMat = 1 := by
  decide +kernel

