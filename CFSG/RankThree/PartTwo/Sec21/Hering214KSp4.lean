section Sp4

variable {F : Type} [Field F] [Finite F] [CharP F 2]

local notation "Z" => StatedProj (StatedSp 2 F)

noncomputable abbrev sp4Equiv : StatedProj (StatedSp 2 F) ≃* StatedSp 2 F :=
  CFSG.SeitzReduction.OmegaPilot.spProjEquivCharTwo F 2

theorem sp4Equiv_proj (g : StatedSp 2 F) : sp4Equiv (proj 2 F g) = g := rfl

theorem sp4Equiv_symm (g : StatedSp 2 F) : (sp4Equiv (F := F)).symm g = proj 2 F g := by
  apply sp4Equiv.injective
  rw [MulEquiv.apply_symm_apply, sp4Equiv_proj]

theorem proj_injective_sp4 : Function.Injective (proj 2 F : StatedSp 2 F →* Z) := by
  intro a b h
  have := congrArg (sp4Equiv (F := F)) h
  rwa [sp4Equiv_proj, sp4Equiv_proj] at this

theorem conj_injective_sp4 : Function.Injective (MulAut.conj : Z →* MulAut Z) :=
  conj_injective_of_mulEquiv (sp4Equiv (F := F))
    (CFSG.SeitzReduction.SymplecticPilot.center_statedSp_eq_bot 2)

theorem sp4_aut_cube_form {α : MulAut Z} (hα : α ^ 3 = 1) :
    ∃ (g : Z) (σ : F ≃+* F), α = MulAut.conj g * fieldAut 2 F σ := by
  by_cases hD : α ∈ (conjAut 2 F).range
  · obtain ⟨A, rfl⟩ := hD
    obtain ⟨g, hg⟩ := conjAut_mem_inner_of_charTwo A
    exact ⟨g, 1, by rw [map_one, mul_one]; exact hg.symm⟩
  · obtain ⟨σ, -, H, hH⟩ := sp4_even_order_three_field_descent α hα hD
    have key := CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher.fieldAut_mul_conjAut_mul_inv
      (r := 2) σ H
    obtain ⟨g, hg⟩ := conjAut_mem_inner_of_charTwo (H * (gspFieldMap σ H)⁻¹)
    refine ⟨g, σ, ?_⟩
    rw [hg, hH, map_mul, map_inv, ← key]
    group

theorem eInvFour_sp4_inner (h3 : 3 ∣ Nat.card F - 1) {Ē : Subgroup (MulAut Z)}
    (hE3 : IsElemAbelian 3 Ē) (hE9 : Nat.card Ē = 9)
    (hrange : Ē ≤ (MulAut.conj : Z →* MulAut Z).range) : EInvFour Z Ē := by
  classical
  obtain ⟨ω, hω, hω1⟩ := exists_primitive_cube_root h3
  have hinj := conj_injective_sp4 (F := F)
  haveI : Finite Ē := Nat.finite_of_card_ne_zero (by omega)
  have : Nontrivial Ē := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨⟨σ₀, hσ₀E⟩, hne⟩ := exists_ne (1 : Ē)
  have hσ₀1 : σ₀ ≠ 1 := fun h => hne (Subtype.ext h)
  obtain ⟨τ₀, hτ₀E, hτ₀⟩ := exists_not_mem_zpowers hE3 hE9 hσ₀E hσ₀1
  obtain ⟨z₁, hz₁⟩ := hrange hσ₀E
  obtain ⟨z₂, hz₂⟩ := hrange hτ₀E
  have hz₁3 : z₁ ^ 3 = 1 := by
    apply hinj
    rw [map_pow, hz₁, map_one]
    exact hE3.2 _ hσ₀E
  have hz₂3 : z₂ ^ 3 = 1 := by
    apply hinj
    rw [map_pow, hz₂, map_one]
    exact hE3.2 _ hτ₀E
  have hz₁₂ : z₁ * z₂ = z₂ * z₁ := by
    apply hinj
    rw [map_mul, map_mul, hz₁, hz₂]
    exact congrArg Subtype.val (hE3.1.is_comm.comm ⟨_, hσ₀E⟩ ⟨_, hτ₀E⟩)
  have hz₁1 : z₁ ≠ 1 := by
    rintro rfl
    exact hσ₀1 (by rw [← hz₁, map_one])
  obtain ⟨W, hWab, hW4, hW1, hW2, w, hw, hmove⟩ := sp4_four_inner hω hω1
    (g₁ := sp4Equiv z₁) (g₂ := sp4Equiv z₂) (by rw [← map_pow, hz₁3, map_one])
    (by rw [← map_pow, hz₂3, map_one]) (by rw [← map_mul, ← map_mul, hz₁₂])
    (fun h => hz₁1 (sp4Equiv.injective (h.trans sp4Equiv.map_one.symm)))
  have hconjW : ∀ (z : Z) (x : StatedSp 2 F), z * proj 2 F x * z⁻¹ =
      proj 2 F (sp4Equiv z * x * (sp4Equiv z)⁻¹) := by
    intro z x
    have : z = proj 2 F (sp4Equiv z) := by rw [← sp4Equiv_symm, MulEquiv.symm_apply_apply]
    conv_lhs => rw [this]
    rw [← map_mul, ← map_inv, ← map_mul]
  refine eInvFour_of_two_gens hE3 hE9 hσ₀E hτ₀E hσ₀1 hτ₀
    (W := W.map (proj 2 F)) (CFSG.Open.IsElemAbelian.map hWab _)
    (by rw [Subgroup.card_map_of_injective proj_injective_sp4, hW4]) ?_ ?_ (Or.inl ?_)
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨_, hW1 x hx, ?_⟩
    rw [← hz₁, MulAut.conj_apply]
    exact (hconjW z₁ x).symm
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨_, hW2 x hx, ?_⟩
    rw [← hz₂, MulAut.conj_apply]
    exact (hconjW z₂ x).symm
  · refine ⟨proj 2 F w, ⟨w, hw, rfl⟩, fun h => hmove ?_⟩
    rw [← hz₁, MulAut.conj_apply, hconjW] at h
    exact proj_injective_sp4 h

theorem eInvFour_sp4_fixing (h3 : 3 ∣ Nat.card F - 1) {σ : F ≃+* F} (hσ : orderOf σ = 3)
    {Ē : Subgroup (MulAut Z)} (hE3 : IsElemAbelian 3 Ē) (hE9 : Nat.card Ē = 9)
    (hσE : fieldAut 2 F σ ∈ Ē) : EInvFour Z Ē := by
  classical
  haveI := CFSG.RankThree.GF2n.Stroth80.isCyclic_ringEquiv F
  haveI : Finite (F ≃+* F) := Finite.of_injective (fun τ : F ≃+* F => (τ : F → F))
    (fun a b h => RingEquiv.ext (fun x => congrFun h x))
  have hinj := conj_injective_sp4 (F := F)
  have hfaith : ∀ γ : F ≃+* F, fieldAut 2 F γ ∈ (MulAut.conj : Z →* MulAut Z).range → γ = 1 :=
    fun γ hγ => (fieldAut_mem_range_conjAut_iff (r := 2) (K := F) (by norm_num)).mp
      (innAut_le_range_spConjAut 2 F hγ)
  have hdec : ∀ β ∈ Ē, ∃ (g : Z) (γ : F ≃+* F), β = MulAut.conj g * fieldAut 2 F γ :=
    fun β hβ => sp4_aut_cube_form (hE3.2 β hβ)
  obtain ⟨g₀, hg₀E, hg₀a⟩ :=
    exists_inner_of_cyclic_out (fieldAut 2 F) hdec hfaith hE3 hE9 hσ hσE
  have hΦ1 : fieldAut 2 F σ ≠ 1 := by
    intro h
    have := hfaith σ (by rw [h]; exact ⟨1, map_one _⟩)
    rw [this, orderOf_one] at hσ
    omega
  have hcomm : fieldAut 2 F σ * MulAut.conj g₀ = MulAut.conj g₀ * fieldAut 2 F σ := by
    have := hE3.1.is_comm.comm ⟨_, hσE⟩ ⟨_, hg₀E⟩
    exact congrArg Subtype.val this
  have hfix : fieldAut 2 F σ g₀ = g₀ := by
    apply hinj
    rw [← mul_mulAutConj_mul_inv (fieldAut 2 F σ) g₀, hcomm]
    group
  have hg₀3 : g₀ ^ 3 = 1 := by
    apply hinj
    rw [map_pow, map_one]
    exact hE3.2 _ hg₀E
  have hg₀1 : g₀ ≠ 1 := by
    rintro rfl
    exact hg₀a (by rw [map_one]; exact Subgroup.one_mem _)
  obtain ⟨g, hg⟩ : ∃ g : StatedSp 2 F, g = sp4Equiv g₀ := ⟨_, rfl⟩
  have hg₀proj : g₀ = proj 2 F g := by rw [hg, ← sp4Equiv_symm, MulEquiv.symm_apply_apply]
  have hgfix : fieldSp 2 F σ g = g := by
    apply proj_injective_sp4
    rw [← fieldAut_proj, ← hg₀proj]
    exact hfix
  obtain ⟨ω, hω, hω1⟩ := exists_primitive_cube_root h3
  have hσ3 : σ ^ 3 = 1 := by rw [← hσ]; exact pow_orderOf_eq_one σ
  have hσω : σ ω = ω := ringEquiv_fixes_cube_root hσ3 hω hω1
  obtain ⟨W, hWab, hW4, hWσ, hWg, w, hw, hmove⟩ := sp4_four_fixed hω hω1 hσω (g := g)
    (by rw [hg, ← map_pow, hg₀3, map_one])
    (fun h => hg₀1 (sp4Equiv.injective (by rw [← hg, h, map_one]))) hgfix
  refine eInvFour_of_two_gens hE3 hE9 hσE hg₀E hΦ1 hg₀a (W := W.map (proj 2 F))
    (CFSG.Open.IsElemAbelian.map hWab _)
    (by rw [Subgroup.card_map_of_injective proj_injective_sp4, hW4]) ?_ ?_ (Or.inr ?_)
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨x, hx, ?_⟩
    rw [fieldAut_proj, hWσ x hx]
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨_, hWg x hx, ?_⟩
    rw [MulAut.conj_apply, hg₀proj, ← map_mul, ← map_inv, ← map_mul]
  · refine ⟨proj 2 F w, ⟨w, hw, rfl⟩, fun h => hmove ?_⟩
    rw [MulAut.conj_apply, hg₀proj, ← map_mul, ← map_inv, ← map_mul] at h
    exact proj_injective_sp4 h

theorem eInvFour_sp4_outer (h3 : 3 ∣ Nat.card F - 1) {Ē : Subgroup (MulAut Z)}
    (hE3 : IsElemAbelian 3 Ē) (hE9 : Nat.card Ē = 9)
    (hout : ¬ Ē ≤ (MulAut.conj : Z →* MulAut Z).range) : EInvFour Z Ē := by
  obtain ⟨a, haE, haI⟩ := SetLike.not_le_iff_exists.mp hout
  have ha3 : a ^ 3 = 1 := hE3.2 a haE
  have hD : a ∉ (conjAut 2 F).range := by
    rintro ⟨A, rfl⟩
    exact haI (conjAut_mem_inner_of_charTwo A)
  obtain ⟨σ, hσ3, H, hH⟩ := sp4_even_order_three_field_descent a ha3 hD
  refine eInvFour_of_map_conj (conjAut 2 F H)⁻¹ ?_
  refine eInvFour_sp4_fixing h3 hσ3 (CFSG.Open.IsElemAbelian.map hE3 _) ?_ ⟨a, haE, ?_⟩
  · rw [Subgroup.card_map_of_injective (MulAut.conj _).injective, hE9]
  · simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    rw [hH]
    group

theorem eInvNine_statedProjSp4 (h3 : 3 ∣ Nat.card F - 1) : EInvNine Z := by
  intro Ē hE3 hE9
  by_cases hin : Ē ≤ (MulAut.conj : Z →* MulAut Z).range
  · exact eInvFour_sp4_inner h3 hE3 hE9 hin
  · exact eInvFour_sp4_outer h3 hE3 hE9 hin

end Sp4

theorem eInvNine_of_projSp {X : Type} [Group X] {n : ℕ} (hn0 : 0 < n) (hn : Even n)
    (e : X ≃* projSp 2 (GaloisField 2 n)) : EInvNine X := by
  have hcard : Nat.card (GaloisField 2 n) = 2 ^ n := GaloisField.card 2 n hn0.ne'
  exact EInvNine.of_mulEquiv (e.trans (CFSG.PGLModel.projSpEquivStatedProj 2 (GaloisField 2 n)))
    (eInvNine_statedProjSp4 (F := GaloisField 2 n)
      (by rw [hcard]; exact three_dvd_two_pow_sub_one hn))

