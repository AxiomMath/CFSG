theorem inclusion_apply' {H : Type*} [Group H] {A B : Subgroup H} (h : A ≤ B) (x : ↥A) :
    Subgroup.inclusion h x = ⟨x.1, h x.2⟩ :=
  Subtype.ext (Subgroup.coe_inclusion h x)

theorem range_comp_le {M N P : Type*} [Group M] [Group N] [Group P] (f : M →* N) (g : N →* P) :
    (g.comp f).range ≤ g.range := by
  rintro _ ⟨x, rfl⟩
  exact ⟨f x, rfl⟩

section Ext

variable {I : Type*} [DecidableEq I] {K G : Type*} [Group K] [Group G]
  (X : (I → ℤ) → Subgroup K)

theorem levi_hom_ext {J : Finset I} {f₁ f₂ : ↥(lv X J) →* G}
    (h : ∀ j (hj : j ∈ J) (x : K) (hx : x ∈ rankOne X j),
      f₁ ⟨x, rankOne_le_levi X hj hx⟩ = f₂ ⟨x, rankOne_le_levi X hj hx⟩) : f₁ = f₂ := by
  ext ⟨x, hx⟩
  have hx' : x ∈ ⨆ j, ⨆ (_ : j ∈ J), rankOne X j := hx
  refine Subgroup.iSup_induction' (fun j => ⨆ (_ : j ∈ J), rankOne X j)
    (C := fun y hy => f₁ ⟨y, hy⟩ = f₂ ⟨y, hy⟩) ?_ ?_ ?_ hx'
  · intro j y hy
    refine Subgroup.iSup_induction' (fun _ : j ∈ J => rankOne X j)
      (C := fun y hy' => f₁ ⟨y, (Subgroup.mem_iSup_of_mem j hy' :
          y ∈ ⨆ j, ⨆ (_ : j ∈ J), rankOne X j)⟩ =
        f₂ ⟨y, (Subgroup.mem_iSup_of_mem j hy' : y ∈ ⨆ j, ⨆ (_ : j ∈ J), rankOne X j)⟩)
      ?_ ?_ ?_ hy
    · intro hj z hz
      exact h j hj z hz
    · exact (map_one f₁).trans (map_one f₂).symm
    · intro a b ha hb h₁ h₂
      have := congrArg₂ (· * ·) h₁ h₂
      rw [← map_mul, ← map_mul] at this
      exact this
  · exact (map_one f₁).trans (map_one f₂).symm
  · intro a b ha hb h₁ h₂
    have := congrArg₂ (· * ·) h₁ h₂
    rw [← map_mul, ← map_mul] at this
    exact this

theorem levi_hom_ext' {J : Finset I} {f₁ f₂ : ↥(lv X J) →* G}
    (h : ∀ j (hj : j ∈ J) (x : K) (hx : x ∈ lv X {j}),
      f₁ ⟨x, levi_mono X (Finset.singleton_subset_iff.2 hj) hx⟩ =
        f₂ ⟨x, levi_mono X (Finset.singleton_subset_iff.2 hj) hx⟩) : f₁ = f₂ :=
  levi_hom_ext X fun j hj x hx => h j hj x (by rwa [CFSG.LieType.CurtisTits.levi_singleton])

end Ext

theorem f4_root_support_one_three_check :
    ∀ γ ∈ rootFinset .F4, γ 0 = 0 → γ 2 = 0 → γ 1 = 0 ∨ γ 3 = 0 := by
  decide +kernel

section Pair

variable {K : Type} [Field K]

theorem commute_rootGroup_one_three {s t : Fin (Tag.rank .F4) → ℤ}
    (hs : s = Pi.single 1 1 ∨ s = -Pi.single 1 1) (ht : t = Pi.single 3 1 ∨ t = -Pi.single 3 1)
    {x y : adjointGroup .F4 K} (hx : x ∈ (Adjoint.f4Datum K).rootGroup s)
    (hy : y ∈ (Adjoint.f4Datum K).rootGroup t) : Commute x y := by
  have hroot : ∀ v, v ∈ (Adjoint.f4Datum K).roots ↔ IsRoot .F4 v := fun v =>
    Adjoint.mem_adjDatum_roots
  have h10 : (1 : Fin (Tag.rank .F4)) ≠ 0 := by decide
  have h20 : (2 : Fin (Tag.rank .F4)) ≠ 0 := by decide
  have h30 : (3 : Fin (Tag.rank .F4)) ≠ 0 := by decide
  have h12 : (1 : Fin (Tag.rank .F4)) ≠ 2 := by decide
  have h13 : (1 : Fin (Tag.rank .F4)) ≠ 3 := by decide
  have h23 : (2 : Fin (Tag.rank .F4)) ≠ 3 := by decide
  refine commute_of_forall_not_mem_roots (Adjoint.f4_steinbergExtras K) ?_ ?_ ?_ ?_ hx hy
  · rw [hroot]
    rcases hs with rfl | rfl
    exacts [isRoot_single _ 1, isRoot_neg_single _ 1]
  · rw [hroot]
    rcases ht with rfl | rfl
    exacts [isRoot_single _ 3, isRoot_neg_single _ 3]
  · intro a b hab
    have h0 := congrFun hab 1
    have h3 := congrFun hab 3
    rcases hs with rfl | rfl <;> rcases ht with rfl | rfl <;>
      simp [h13, h13.symm] at h0 h3 <;> exact ⟨h0, h3⟩
  · intro a b ha hb hmem
    rw [hroot, ← mem_rootFinset] at hmem
    have h := f4_root_support_one_three_check _ hmem
    rcases hs with rfl | rfl <;> rcases ht with rfl | rfl <;>
      simp [h10, h20, h30, h12, h13, h23, h13.symm] at h <;> omega

theorem commute_levi_one_three :
    ∀ x ∈ CFSG.LieType.CurtisTits.levi (Adjoint.f4Datum K).rootGroup {1},
      ∀ y ∈ CFSG.LieType.CurtisTits.levi (Adjoint.f4Datum K).rootGroup {3}, Commute x y := by
  rw [CFSG.LieType.CurtisTits.levi_singleton, CFSG.LieType.CurtisTits.levi_singleton,
    CFSG.LieType.CurtisTits.rankOne, CFSG.LieType.CurtisTits.rankOne]
  refine forall_commute_sup_left (forall_commute_sup_right ?_ ?_)
    (forall_commute_sup_right ?_ ?_)
  · exact fun x hx y hy => commute_rootGroup_one_three (Or.inl rfl) (Or.inl rfl) hx hy
  · exact fun x hx y hy => commute_rootGroup_one_three (Or.inl rfl) (Or.inr rfl) hx hy
  · exact fun x hx y hy => commute_rootGroup_one_three (Or.inr rfl) (Or.inl rfl) hx hy
  · exact fun x hx y hy => commute_rootGroup_one_three (Or.inr rfl) (Or.inr rfl) hx hy

theorem levi_one_inf_levi_three_eq_bot :
    CFSG.LieType.CurtisTits.levi (Adjoint.f4Datum K).rootGroup {1} ⊓
      CFSG.LieType.CurtisTits.levi (Adjoint.f4Datum K).rootGroup {3} = ⊥ := by
  have hc := commute_levi_one_three (K := K)
  rw [CFSG.LieType.CurtisTits.levi_singleton, CFSG.LieType.CurtisTits.levi_singleton] at hc ⊢
  exact rankOne_inf_rankOne_eq_bot (Adjoint.f4_isCTGroupDatum K) (Adjoint.f4_steinbergExtras K)
    (by decide : (1 : Fin (Tag.rank .F4)) ≠ 3) hc

end Pair

section Family

variable {K : Type} [Field K] [Finite K] [CharP K CFSG.LieType.Ree.ReeTag.F4.prime]

local instance (priority := low) am6CharPTwo : CharP K 2 := ‹_›

noncomputable abbrev Lv (K : Type) [Field K] (J : Finset (Fin (Tag.rank .F4))) :
    Subgroup ↥(adjointGroup .F4 K) :=
  CFSG.LieType.CurtisTits.levi (Adjoint.f4Datum K).rootGroup J

theorem Lv_le_B3Levi {J : Finset (Fin (Tag.rank .F4))} (h : (3 : Fin (Tag.rank .F4)) ∉ J) :
    Lv K J ≤ B3Levi K :=
  levi_le_B3Levi h

theorem eq_pair_of_mem {I : Type*} [DecidableEq I] {J : Finset I} {a b : I} (hab : a ≠ b)
    (hJ : J.card ≤ 2) (ha : a ∈ J) (hb : b ∈ J) : J = {a, b} := by
  have hsub : ({a, b} : Finset I) ⊆ J := by
    intro j hj
    rw [Finset.mem_insert, Finset.mem_singleton] at hj
    rcases hj with rfl | rfl
    exacts [ha, hb]
  have h2 : ({a, b} : Finset I).card = 2 := Finset.card_pair hab
  exact (Finset.eq_of_subset_of_card_le hsub (by rw [h2]; exact hJ)).symm

theorem Lv_le_sup_of_mem_of_mem {J : Finset (Fin (Tag.rank .F4))} {a b : Fin (Tag.rank .F4)}
    (hJ : J.card ≤ 2) (ha : a ∈ J) (hb : b ∈ J) (hab : a ≠ b) :
    Lv K J ≤ Lv K {a} ⊔ Lv K {b} := by
  rw [eq_pair_of_mem hab hJ ha hb]
  exact (levi_pair (Adjoint.f4Datum K).rootGroup a b).le

theorem Lv_two_le_A : Lv K {2} ≤ Lv K {2, 3} :=
  CFSG.LieType.CurtisTits.levi_mono _ (Finset.singleton_subset_iff.2 (by simp))

theorem Lv_three_le_A : Lv K {3} ≤ Lv K {2, 3} :=
  CFSG.LieType.CurtisTits.levi_mono _ (Finset.singleton_subset_iff.2 (by simp))

theorem Lv_two_le_P : Lv K {2} ≤ B3Levi K := Lv_le_B3Levi (by decide)

theorem Lv_one_le_P : Lv K {1} ≤ B3Levi K := Lv_le_B3Levi (by decide)

theorem Lv_zero_le_P : Lv K {0} ≤ B3Levi K := Lv_le_B3Levi (by decide)

variable (K) (G : Type) [Group G]

structure FamilyData where
  θP : ↥(B3Levi K) →* G
  θA : ↥(Lv K {2, 3}) →* G
  agree : ∀ (x : ↥(adjointGroup .F4 K)) (hx : x ∈ Lv K {2}),
    θA ⟨x, Lv_two_le_A hx⟩ = θP ⟨x, Lv_two_le_P hx⟩
  comm0 : ∀ (a : ↥(Lv K {0})) (b : ↥(Lv K {3})),
    Commute (θP ⟨a.1, Lv_zero_le_P a.2⟩) (θA ⟨b.1, Lv_three_le_A b.2⟩)
  comm1 : ∀ (a : ↥(Lv K {1})) (b : ↥(Lv K {3})),
    Commute (θP ⟨a.1, Lv_one_le_P a.2⟩) (θA ⟨b.1, Lv_three_le_A b.2⟩)

variable {K G} (D : FamilyData K G)

noncomputable def FamilyData.rho (j : Fin (Tag.rank .F4)) : ↥(Lv K {j}) →* G :=
  if h : j = 3 then
    D.θA.comp (Subgroup.inclusion (by subst h; exact Lv_three_le_A))
  else
    D.θP.comp (Subgroup.inclusion (Lv_le_B3Levi (by simpa using fun h' => h h'.symm)))

theorem FamilyData.rho_of_ne {j : Fin (Tag.rank .F4)} (hj : j ≠ 3) (x : ↥(Lv K {j})) :
    D.rho j x = D.θP ⟨x.1, Lv_le_B3Levi (by simpa using fun h' => hj h'.symm) x.2⟩ := by
  rw [FamilyData.rho, dif_neg hj]
  rfl

theorem FamilyData.rho_three (x : ↥(Lv K {3})) :
    D.rho 3 x = D.θA ⟨x.1, Lv_three_le_A x.2⟩ := by
  rw [FamilyData.rho, dif_pos rfl]
  rfl

theorem FamilyData.rho_comm0 (a : ↥(Lv K {0})) (b : ↥(Lv K {3})) :
    Commute (D.rho 0 a) (D.rho 3 b) := by
  rw [D.rho_of_ne (by decide), D.rho_three]
  exact D.comm0 a b

theorem FamilyData.rho_comm1 (a : ↥(Lv K {1})) (b : ↥(Lv K {3})) :
    Commute (D.rho 1 a) (D.rho 3 b) := by
  rw [D.rho_of_ne (by decide), D.rho_three]
  exact D.comm1 a b

theorem eq_three_of_not_mem {J : Finset (Fin (Tag.rank .F4))}
    (h0 : (0 : Fin (Tag.rank .F4)) ∉ J) (h1 : (1 : Fin (Tag.rank .F4)) ∉ J)
    (h2 : (2 : Fin (Tag.rank .F4)) ∉ J) : ∀ j ∈ J, j = 3 := by
  intro j hj
  have hall : ∀ j : Fin (Tag.rank .F4), j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 := by decide
  rcases hall j with rfl | rfl | rfl | rfl
  · exact absurd hj h0
  · exact absurd hj h1
  · exact absurd hj h2
  · rfl

theorem zero_ne_three' : (0 : Fin (Tag.rank .F4)) ≠ 3 := by decide

theorem one_ne_three' : (1 : Fin (Tag.rank .F4)) ≠ 3 := by decide

theorem two_ne_three' : (2 : Fin (Tag.rank .F4)) ≠ 3 := by decide

theorem Lv_le_A_of_mem {J : Finset (Fin (Tag.rank .F4))} (hJ : J.card ≤ 2)
    (h2 : (2 : Fin (Tag.rank .F4)) ∈ J) (h3 : (3 : Fin (Tag.rank .F4)) ∈ J) :
    Lv K J ≤ Lv K {2, 3} := by
  rw [eq_pair_of_mem two_ne_three' hJ h2 h3]

theorem Lv_le_A_of_not_mem {J : Finset (Fin (Tag.rank .F4))}
    (h0 : (0 : Fin (Tag.rank .F4)) ∉ J) (h1 : (1 : Fin (Tag.rank .F4)) ∉ J)
    (h2 : (2 : Fin (Tag.rank .F4)) ∉ J) : Lv K J ≤ Lv K {2, 3} :=
  CFSG.LieType.CurtisTits.levi_mono _ (by
    intro j hj
    rw [eq_three_of_not_mem h0 h1 h2 j hj]
    simp)

noncomputable def FamilyData.phi (J : {J : Finset (Fin (Adjoint.f4Datum K).rank) // J.card ≤ 2}) :
    (Adjoint.f4Datum K).leviAmalgam J →* G :=
  if h3 : (3 : Fin (Tag.rank .F4)) ∈ J.1 then
    if h2 : (2 : Fin (Tag.rank .F4)) ∈ J.1 then
      D.θA.comp (Subgroup.inclusion (Lv_le_A_of_mem J.2 h2 h3))
    else if h0 : (0 : Fin (Tag.rank .F4)) ∈ J.1 then
      (supLift commute_levi_zero_three levi_zero_inf_levi_three_eq_bot (D.rho 0) (D.rho 3)
        D.rho_comm0).comp
        (Subgroup.inclusion (Lv_le_sup_of_mem_of_mem J.2 h0 h3 zero_ne_three'))
    else if h1 : (1 : Fin (Tag.rank .F4)) ∈ J.1 then
      (supLift commute_levi_one_three levi_one_inf_levi_three_eq_bot (D.rho 1) (D.rho 3)
        D.rho_comm1).comp
        (Subgroup.inclusion (Lv_le_sup_of_mem_of_mem J.2 h1 h3 one_ne_three'))
    else
      D.θA.comp (Subgroup.inclusion (Lv_le_A_of_not_mem h0 h1 h2))
  else D.θP.comp (Subgroup.inclusion (Lv_le_B3Levi h3))

theorem FamilyData.phi_spec (J : {J : Finset (Fin (Adjoint.f4Datum K).rank) // J.card ≤ 2})
    {j : Fin (Tag.rank .F4)} (hj : j ∈ J.1) (x : ↥(adjointGroup .F4 K)) (hx : x ∈ Lv K {j}) :
    D.phi J ⟨x, levi_mono _ (Finset.singleton_subset_iff.2 hj) hx⟩ = D.rho j ⟨x, hx⟩ := by
  unfold FamilyData.phi
  by_cases h3 : (3 : Fin (Tag.rank .F4)) ∈ J.1
  · rw [dif_pos h3]
    by_cases h2 : (2 : Fin (Tag.rank .F4)) ∈ J.1
    · rw [dif_pos h2]
      have hJ := eq_pair_of_mem two_ne_three' J.2 h2 h3
      have hj' : j = 2 ∨ j = 3 := by
        rw [hJ] at hj
        simpa using hj
      rcases hj' with rfl | rfl
      · rw [D.rho_of_ne two_ne_three']
        exact D.agree x hx
      · rw [D.rho_three]
        rfl
    · rw [dif_neg h2]
      by_cases h0 : (0 : Fin (Tag.rank .F4)) ∈ J.1
      · rw [dif_pos h0]
        have hJ := eq_pair_of_mem zero_ne_three' J.2 h0 h3
        have hj' : j = 0 ∨ j = 3 := by
          rw [hJ] at hj
          simpa using hj
        rcases hj' with rfl | rfl
        · exact supLift_apply_left (A := Lv K {0}) (B := Lv K {3}) commute_levi_zero_three
            levi_zero_inf_levi_three_eq_bot D.rho_comm0 ⟨x, hx⟩
        · exact supLift_apply_right (A := Lv K {0}) (B := Lv K {3}) commute_levi_zero_three
            levi_zero_inf_levi_three_eq_bot D.rho_comm0 ⟨x, hx⟩
      · rw [dif_neg h0]
        by_cases h1 : (1 : Fin (Tag.rank .F4)) ∈ J.1
        · rw [dif_pos h1]
          have hJ := eq_pair_of_mem one_ne_three' J.2 h1 h3
          have hj' : j = 1 ∨ j = 3 := by
            rw [hJ] at hj
            simpa using hj
          rcases hj' with rfl | rfl
          · exact supLift_apply_left (A := Lv K {1}) (B := Lv K {3}) commute_levi_one_three
              levi_one_inf_levi_three_eq_bot D.rho_comm1 ⟨x, hx⟩
          · exact supLift_apply_right (A := Lv K {1}) (B := Lv K {3}) commute_levi_one_three
              levi_one_inf_levi_three_eq_bot D.rho_comm1 ⟨x, hx⟩
        · rw [dif_neg h1]
          have hj3 := eq_three_of_not_mem h0 h1 h2 j hj
          subst hj3
          rw [D.rho_three]
          rfl
  · rw [dif_neg h3]
    have hj3 : j ≠ 3 := fun h => h3 (h ▸ hj)
    rw [D.rho_of_ne hj3]
    rfl

theorem FamilyData.compat_Lv (I J : Finset (Fin (Adjoint.f4Datum K).rank)) (hI : I.card ≤ 2)
    (hJ : J.card ≤ 2) (hsub : I ⊆ J) (x : ↥(Lv K I)) (y : ↥(Lv K J))
    (hxy : (x : ↥(adjointGroup .F4 K)) = y) : D.phi ⟨I, hI⟩ x = D.phi ⟨J, hJ⟩ y := by
  have key : D.phi ⟨I, hI⟩ = (D.phi ⟨J, hJ⟩).comp (Subgroup.inclusion (levi_mono _ hsub)) := by
    refine levi_hom_ext' _ fun k hk z hz => ?_
    rw [D.phi_spec ⟨I, hI⟩ hk z hz]
    exact (D.phi_spec ⟨J, hJ⟩ (hsub hk) z hz).symm
  have h1 : D.phi ⟨I, hI⟩ x = D.phi ⟨J, hJ⟩ (Subgroup.inclusion (levi_mono _ hsub) x) :=
    DFunLike.congr_fun key x
  have hxy' : Subgroup.inclusion (levi_mono (Adjoint.f4Datum K).rootGroup hsub) x = y := by
    apply Subtype.ext
    rw [Subgroup.coe_inclusion]
    exact hxy
  rw [h1, hxy']

theorem FamilyData.isCompatible : IsCompatible (Adjoint.f4Datum K).leviAmalgam D.phi :=
  fun i j hij x y hxy => D.compat_Lv i.1 j.1 i.2 j.2 hij x y hxy

section B3Gen

theorem map_graphAutF4_rankOne {j k : Fin (Tag.rank .F4)}
    (hjk : psiF4 (Pi.single j 1) = Pi.single k 1) :
    (rankOne (Adjoint.f4Datum K).rootGroup j).map (graphAutF4 K).toMonoidHom =
      rankOne (Adjoint.f4Datum K).rootGroup k := by
  unfold rankOne
  rw [Subgroup.map_sup, map_graphAutF4_rootGroup (isRoot_single _ j),
    map_graphAutF4_rootGroup (isRoot_neg_single _ j), psiF4_neg (isRoot_single _ j), hjk]

theorem psiF4_single_one : psiF4 (Pi.single (1 : Fin (Tag.rank .F4)) 1) = Pi.single 2 1 := by
  decide +kernel

theorem psiF4_single_two : psiF4 (Pi.single (2 : Fin (Tag.rank .F4)) 1) = Pi.single 1 1 := by
  decide +kernel

theorem psiF4_single_three : psiF4 (Pi.single (3 : Fin (Tag.rank .F4)) 1) = Pi.single 0 1 := by
  decide +kernel

theorem B3Levi_le_Lv : B3Levi K ≤ Lv K {0, 1, 2} := by
  rw [← map_graphAutF4_C3Levi]
  refine (Subgroup.map_mono C3Levi_le_levi_one_two_three).trans ?_
  rw [Subgroup.map_le_iff_le_comap]
  unfold CFSG.LieType.CurtisTits.levi
  refine iSup₂_le fun j hj => ?_
  rw [← Subgroup.map_le_iff_le_comap]
  have hj' : j = 1 ∨ j = 2 ∨ j = 3 := by simpa using hj
  rcases hj' with rfl | rfl | rfl
  · rw [map_graphAutF4_rankOne psiF4_single_one]
    exact CFSG.LieType.CurtisTits.rankOne_le_levi _ (by simp)
  · rw [map_graphAutF4_rankOne psiF4_single_two]
    exact CFSG.LieType.CurtisTits.rankOne_le_levi _ (by simp)
  · rw [map_graphAutF4_rankOne psiF4_single_three]
    exact CFSG.LieType.CurtisTits.rankOne_le_levi _ (by simp)

end B3Gen

end Family

section Main

variable {K : Type} [Field K] [Finite K] [CharP K CFSG.LieType.Ree.ReeTag.F4.prime]
  {G : Type} [Group G] (D : FamilyData K G)

theorem FamilyData.exists_ne_one (hθ : Function.Injective D.θP) :
    ∃ (x : ↥(adjointGroup .F4 K)) (hx : x ∈ Lv K {0}), D.θP ⟨x, Lv_zero_le_P hx⟩ ≠ 1 := by
  have hX0 := (Adjoint.f4_steinbergExtras K).ne_bot (Pi.single 0 1)
    ((CFSG.LieType.RootSystem.isCTRootSystem _ _).single_mem 0)
  obtain ⟨u, hu⟩ := (Subgroup.ne_bot_iff_exists_ne_one).1 hX0
  have hu0 : (u : ↥(adjointGroup .F4 K)) ∈ Lv K {0} := by
    unfold Lv
    rw [CFSG.LieType.CurtisTits.levi_singleton]
    exact mem_sup_left u.2
  refine ⟨u, hu0, fun h => hu ?_⟩
  have h1 : D.θP ⟨u, Lv_zero_le_P hu0⟩ = D.θP 1 := by rw [h, map_one]
  have h2 := hθ h1
  have h3 : ((⟨u, Lv_zero_le_P hu0⟩ : ↥(B3Levi K)) : ↥(adjointGroup .F4 K)) = 1 :=
    congrArg Subtype.val h2
  exact Subtype.ext h3

theorem FamilyData.range_phi_le (J : {J : Finset (Fin (Adjoint.f4Datum K).rank) // J.card ≤ 2}) :
    (D.phi J).range ≤ D.θP.range ⊔ D.θA.range := by
  have hP : ∀ j (x : ↥(Lv K {j})), j ≠ 3 → D.rho j x ∈ D.θP.range ⊔ D.θA.range := fun j x hj =>
    mem_sup_left ⟨_, (D.rho_of_ne hj x).symm⟩
  have hA : ∀ (x : ↥(Lv K {3})), D.rho 3 x ∈ D.θP.range ⊔ D.θA.range := fun x =>
    mem_sup_right ⟨_, (D.rho_three x).symm⟩
  unfold FamilyData.phi
  by_cases h3 : (3 : Fin (Tag.rank .F4)) ∈ J.1
  · rw [dif_pos h3]
    by_cases h2 : (2 : Fin (Tag.rank .F4)) ∈ J.1
    · rw [dif_pos h2]
      exact (range_comp_le _ _).trans le_sup_right
    · rw [dif_neg h2]
      by_cases h0 : (0 : Fin (Tag.rank .F4)) ∈ J.1
      · rw [dif_pos h0]
        refine (range_comp_le _ _).trans ?_
        rw [range_supLift]
        exact sup_le (fun _ ⟨x, hx⟩ => hx ▸ hP 0 x zero_ne_three') (fun _ ⟨x, hx⟩ => hx ▸ hA x)
      · rw [dif_neg h0]
        by_cases h1 : (1 : Fin (Tag.rank .F4)) ∈ J.1
        · rw [dif_pos h1]
          refine (range_comp_le _ _).trans ?_
          rw [range_supLift]
          exact sup_le (fun _ ⟨x, hx⟩ => hx ▸ hP 1 x one_ne_three') (fun _ ⟨x, hx⟩ => hx ▸ hA x)
        · rw [dif_neg h1]
          exact (range_comp_le _ _).trans le_sup_right
  · rw [dif_neg h3]
    exact (range_comp_le _ _).trans le_sup_left

theorem FamilyData.exists_injective (hθ : Function.Injective D.θP) :
    ∃ ψ : ↥(adjointGroup .F4 K) →* G, Function.Injective ψ ∧
      (∀ (x : ↥(adjointGroup .F4 K)) (hx : x ∈ B3Levi K), ψ x = D.θP ⟨x, hx⟩) ∧
      (∀ (x : ↥(adjointGroup .F4 K)) (hx : x ∈ Lv K {2, 3}), ψ x = D.θA ⟨x, hx⟩) ∧
      ψ.range = D.θP.range ⊔ D.θA.range := by
  set G₀ : Subgroup G := ⨆ J, (D.phi J).range with hG₀
  have hle : ∀ J x, D.phi J x ∈ G₀ := fun J x => le_iSup (fun J => (D.phi J).range) J ⟨x, rfl⟩
  set φ' : ∀ J, (Adjoint.f4Datum K).leviAmalgam J →* G₀ :=
    fun J => (D.phi J).codRestrict G₀ (hle J) with hφ'def
  have hφ' : IsCompatible (Adjoint.f4Datum K).leviAmalgam φ' := fun i j hij x y hxy =>
    Subtype.ext (D.isCompatible i j hij x y hxy)
  have hgen' : ⨆ J, (φ' J).range = ⊤ := by
    apply Subgroup.map_injective G₀.subtype_injective
    rw [Subgroup.map_iSup, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    refine (iSup_congr fun J => ?_).trans hG₀.symm
    rw [← MonoidHom.range_comp]
    rfl
  have hcard : ({0} : Finset (Fin (Adjoint.f4Datum K).rank)).card ≤ 2 := by simp
  have hnt : ∃ J, ∃ x, φ' J x ≠ 1 := by
    obtain ⟨u, hu0, hu⟩ := D.exists_ne_one hθ
    refine ⟨⟨{0}, hcard⟩, ⟨u, hu0⟩, fun h => hu ?_⟩
    have h1 : D.phi ⟨{0}, hcard⟩ ⟨u, hu0⟩ = 1 := congrArg Subtype.val h
    rw [show (⟨u, hu0⟩ : ↥(Lv K {0})) = ⟨u, levi_mono _ (Finset.singleton_subset_iff.2
        (Finset.mem_singleton_self _)) hu0⟩ from rfl,
      D.phi_spec ⟨{0}, hcard⟩ (Finset.mem_singleton_self _) u hu0,
      D.rho_of_ne zero_ne_three'] at h1
    exact h1
  obtain ⟨ψ₀, hψ₀, hsurj, hker⟩ := exists_surjective_of_isCompatible_f4 K φ' hφ' hgen' hnt
  have hinj₀ : Function.Injective ψ₀ := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    exact hker.trans CFSG.LieType.Chevalley.center_adjointGroup_eq_bot.le
  have hψφ : ∀ J (x : (Adjoint.f4Datum K).leviAmalgam J), (G₀.subtype.comp ψ₀) x = D.phi J x :=
    fun J x => congrArg Subtype.val (hψ₀ J x)
  set ψ := G₀.subtype.comp ψ₀ with hψ
  have hrank : ∀ (j : Fin (Tag.rank .F4)) (z : ↥(adjointGroup .F4 K)) (hz : z ∈ Lv K {j}),
      ψ z = D.rho j ⟨z, hz⟩ := by
    intro j z hz
    have hcard' : ({j} : Finset (Fin (Adjoint.f4Datum K).rank)).card ≤ 2 := by simp
    have h1 := hψφ ⟨{j}, hcard'⟩ ⟨z, hz⟩
    have h2 := D.phi_spec ⟨{j}, hcard'⟩ (Finset.mem_singleton_self j) z hz
    exact h1.trans h2
  have hrangeψ : ψ.range = G₀ := by
    rw [hψ, MonoidHom.range_comp, MonoidHom.range_eq_top.2 hsurj, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]
  have hP : ∀ (x : ↥(adjointGroup .F4 K)) (hx : x ∈ B3Levi K), ψ x = D.θP ⟨x, hx⟩ := by
    have hext : ψ.comp (Lv K {0, 1, 2}).subtype =
        D.θP.comp (Subgroup.inclusion (Lv_le_B3Levi (by decide))) := by
      refine levi_hom_ext' _ fun j hj z hz => ?_
      have hj3 : j ≠ 3 := by
        intro h
        subst h
        simp at hj
      calc (ψ.comp (Lv K {0, 1, 2}).subtype) ⟨z, levi_mono _
            (Finset.singleton_subset_iff.2 hj) hz⟩ = ψ z := rfl
        _ = D.rho j ⟨z, hz⟩ := hrank j z hz
        _ = D.θP ⟨z, Lv_le_B3Levi (by simpa using fun h => hj3 h.symm) hz⟩ := D.rho_of_ne hj3 _
        _ = (D.θP.comp (Subgroup.inclusion (Lv_le_B3Levi (J := {0, 1, 2}) (by decide)))) ⟨z,
            levi_mono _ (Finset.singleton_subset_iff.2 hj) hz⟩ := by
          rw [MonoidHom.comp_apply, inclusion_apply']
    intro x hx
    exact DFunLike.congr_fun hext ⟨x, B3Levi_le_Lv hx⟩
  have hA : ∀ (x : ↥(adjointGroup .F4 K)) (hx : x ∈ Lv K {2, 3}), ψ x = D.θA ⟨x, hx⟩ := by
    have hext : ψ.comp (Lv K {2, 3}).subtype = D.θA := by
      refine levi_hom_ext' _ fun j hj z hz => ?_
      have hj' : j = 2 ∨ j = 3 := by simpa using hj
      rw [MonoidHom.comp_apply, Subgroup.coe_subtype, hrank j z hz]
      rcases hj' with rfl | rfl
      · rw [D.rho_of_ne two_ne_three']
        exact (D.agree z hz).symm
      · rw [D.rho_three]
    intro x hx
    exact DFunLike.congr_fun hext ⟨x, hx⟩
  refine ⟨ψ, G₀.subtype_injective.comp hinj₀, hP, hA, le_antisymm ?_ ?_⟩
  · rw [hrangeψ]
    exact iSup_le fun J => D.range_phi_le J
  · refine sup_le ?_ ?_
    · rintro _ ⟨p, rfl⟩
      exact ⟨p.1, (hP p.1 p.2).symm ▸ rfl⟩
    · rintro _ ⟨a, rfl⟩
      exact ⟨a.1, (hA a.1 a.2).symm ▸ rfl⟩

end Main

end CFSG.RankThree.PartTwo.Sec21.FF81.Am6
