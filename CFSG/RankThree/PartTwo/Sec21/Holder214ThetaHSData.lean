@[expose] def pow2A (n : ℕ) (x : Array ℕ) : ℕ → Array ℕ
  | 0 => x
  | k + 1 => compA n (pow2A n x k) (pow2A n x k)

@[expose] def twoA (n : ℕ) (x : Array ℕ) : Bool := eqA n (pow2A n x 9) (idA n)

@[expose] def badA (n : ℕ) (c c' p : Array ℕ) : Bool :=
  twoA n (commutatorA n p c) && twoA n (commutatorA n p c')

@[expose] def o2SimpleOK (n : ℕ) (cD : ArrCert) (c c' : Array ℕ) : Bool :=
  allLt cD.pts.size fun k => eqA n cD.pts[k]! (idA n) || !twoA n cD.pts[k]! ||
    !badA n c c' cD.pts[k]!

@[expose] def o2RefinedOK (n : ℕ) (cD : ArrCert) (c c' : Array ℕ) : Bool :=
  allLt cD.pts.size fun k => eqA n cD.pts[k]! (idA n) || !twoA n cD.pts[k]! ||
    !badA n c c' cD.pts[k]! ||
      !(allLt cD.pts.size fun j => !validA n (conjA n cD.pts[j]! cD.pts[k]!) ||
        badA n c c' (conjA n cD.pts[j]! cD.pts[k]!))

@[expose] def involOK (n : ℕ) (cC : ArrCert) (c v₁ v₂ v₃ : Array ℕ) : Bool :=
  allLt cC.pts.size fun k => !(eqA n (compA n cC.pts[k]! cC.pts[k]!) (idA n)) ||
    !(commA n cC.pts[k]! c) || eqA n cC.pts[k]! (idA n) || eqA n cC.pts[k]! v₁ ||
      eqA n cC.pts[k]! v₂ || eqA n cC.pts[k]! v₃

@[expose] def dGensA (n : ℕ) (w : Array (Array ℕ)) : Array (Array ℕ) :=
  #[commutatorA n w[0]! w[1]!, commutatorA n w[2]! w[3]!]

@[expose] def derivedWitOK (n : ℕ) (gM w : Array (Array ℕ)) (ps : List ℕ) (cM cD : ArrCert)
    (N : ℕ) : Bool :=
  enumOK n (dGensA n w) ps cD && cD.pts.size == N && w.size == 4 &&
    allLt 4 (fun i => validA n w[i]! && cM.pts.toList.any (eqA n w[i]!)) &&
    allLt gM.size (fun k => allLt 2 fun l =>
      cD.pts.toList.any (eqA n (conjA n gM[k]! (dGensA n w)[l]!))) &&
    allLt gM.size (fun k => allLt gM.size fun l =>
      cD.pts.toList.any (eqA n (commutatorA n gM[k]! gM[l]!)))

