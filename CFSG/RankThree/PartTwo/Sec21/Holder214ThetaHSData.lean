    eqA 100 (powArr 100 hsThC1 3) (idA 100) && eqA 100 (powArr 100 hsThC2 3) (idA 100) &&
    commA 100 hsThC1 hsThC2 && !(eqA 100 hsThC1 (idA 100)) && !(eqA 100 hsThC2 (idA 100)) &&
    !(eqA 100 hsThC2 hsThC1) && !(eqA 100 hsThC2 (powArr 100 hsThC1 2)) &&
    eqA 100 hsThV3 (compA 100 hsThV1 hsThV2) &&
    allLt 4 (fun i => validA 100 hsThEW[i]! && siftA 100 hs100PLevels hs100BaseArr 0 hsThEW[i]! &&
      commA 100 hsThEW[i]! hsThV1 && commA 100 hsThEW[i]! hsThV2) &&
    eqA 100 (commutatorA 100 hsThEW[0]! hsThEW[1]!) hsThC1 &&
    eqA 100 (commutatorA 100 hsThEW[2]! hsThEW[3]!) hsThC2

