theorem model_of_central_sp8 {H : Type} [Group H] (θ : Sp8.K →* H)
    (hs : Function.Surjective θ) (hk : θ.ker ≤ Subgroup.center _) :
    StatedClassicalModel H .PSp 4 2 1 := by
  have hZ : Subgroup.center (StatedSp 4 (GaloisField 2 1)) = ⊥ := by
    rw [CFSG.LieType.Universal.Symplectic.center_eq,
      CFSG.Open.StatedAPI.statedScalars_subgroupOf_statedSp_eq_bot]
  obtain ⟨e⟩ := nonempty_mulEquiv_quotient_center
    (K := StatedSp 4 (GaloisField 2 1)) θ hs hk hZ
  exact CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv e.symm
    (CFSG.LieType.Universal.Symplectic.statedClassicalModel_center_quotient 4 (GaloisField 2 1)
      ⟨Nat.prime_two, le_rfl, by decide, by decide⟩ (GaloisField.card 2 1 one_ne_zero))

theorem model_of_central_f4 {H : Type} [Group H] (θ : F42.K →* H)
    (hs : Function.Surjective θ) (hk : θ.ker ≤ Subgroup.center _) :
    ChevalleyExceptionalModel H .F4 2 1 := by
  have hZ : Subgroup.center ↥(CFSG.Blueprint.Chevalley.adjointGroup .F4 (GaloisField 2 1)) = ⊥ :=
    CFSG.LieType.Chevalley.center_adjointGroup_eq_bot
  obtain ⟨e⟩ := nonempty_mulEquiv_quotient_center
    (K := ↥(CFSG.Blueprint.Chevalley.adjointGroup .F4 (GaloisField 2 1))) θ hs hk hZ
  exact ⟨⟨Nat.prime_two, le_rfl, rfl⟩, GaloisField 2 1, inferInstance, inferInstance,
    GaloisField.card 2 1 one_ne_zero, ⟨e⟩⟩

theorem ff81_4_10 (hCT : CurtisTitsConclusion.{0} Sp8.D .PSp 4 2 1) {Y : Type} [Group Y]
    (hA : HasLeviAmalgam Sp8 Y) : StatedClassicalModel Y .PSp 4 2 1 := by
  obtain ⟨M, ψ, hgen, hcomp⟩ := hA
  obtain ⟨θ, -, hs, hk⟩ := hCT.2.2.2 _ M hgen ψ hcomp
  exact model_of_central_sp8 θ hs hk

theorem ff81_6_1 (hCT : CurtisTitsConclusion.{0} F42.D .F4 0 2 1) {Y : Type} [Group Y]
