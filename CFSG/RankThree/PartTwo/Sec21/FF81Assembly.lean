theorem le_padicValNat_three_factorial_div_two {n k : ℕ} (hn : 2 ≤ n)
    (h : 2 * 3 ^ k ∣ Nat.factorial n) :
    k ≤ padicValNat 3 (Nat.factorial n / 2) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hpos : Nat.factorial n / 2 ≠ 0 := by
    have : 2 ≤ Nat.factorial n := (Nat.self_le_factorial n).trans' hn
    omega
  exact (padicValNat_dvd_iff_le hpos).mp (Nat.dvd_div_of_mul_dvd h)

theorem kf_altOrder :
    ∀ (X : Type) [Group X] [Finite X] (n : ℕ), Nonempty (X ≃* alternatingGroup (Fin n)) →
      (padicValNat 3 (Nat.card X) = 5 → Nat.card X < 47377612800) ∧
      (padicValNat 3 (Nat.card X) = 6 → Nat.card X < 3311126603366400) := by
  intro X _ _ n ⟨e⟩
  have hc : Nat.card X = Nat.card (alternatingGroup (Fin n)) := Nat.card_congr e.toEquiv
  rcases lt_or_ge n 2 with hn | hn
  · have h1 : Nat.card X ≤ 1 := by
      rw [hc]
      refine (Subgroup.card_le_card_group _).trans ?_
      rw [Nat.card_perm, Nat.card_eq_fintype_card, Fintype.card_fin]
      interval_cases n <;> rfl
    have h0 : Nat.card X = 1 := le_antisymm h1 Nat.card_pos
    simp [h0]
  · have hA : Nat.card X = Nat.factorial n / 2 := by
      have : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
      rw [hc, Nat.card_eq_fintype_card, card_alternatingGroup, Fintype.card_fin]
    rw [hA]
    refine ⟨fun h5 => ?_, fun h6 => ?_⟩
    · have hn14 : n ≤ 14 := by
        by_contra hlt
        have h := le_padicValNat_three_factorial_div_two (k := 6) hn
          ((show 2 * 3 ^ 6 ∣ Nat.factorial 15 by decide).trans
            (Nat.factorial_dvd_factorial (by omega)))
        omega
      calc Nat.factorial n / 2 ≤ Nat.factorial 14 / 2 :=
          Nat.div_le_div_right (Nat.factorial_le hn14)
        _ < 47377612800 := by decide
    · have hn17 : n ≤ 17 := by
        by_contra hlt
        have h := le_padicValNat_three_factorial_div_two (k := 8) hn
          ((show 2 * 3 ^ 8 ∣ Nat.factorial 18 by decide).trans
            (Nat.factorial_dvd_factorial (by omega)))
        omega
      calc Nat.factorial n / 2 ≤ Nat.factorial 17 / 2 :=
          Nat.div_le_div_right (Nat.factorial_le hn17)
        _ < 3311126603366400 := by decide

theorem ff81_eq_top (hHolt : HoltUniqueFixedPointSimple) (hSE : KF_SE3)
    {G : Type} [Group G] [Finite G] [IsSimpleGroup G] (hnab : ∃ x y : G, x * y ≠ y * x)
    (Y : Subgroup G) (B : Subgroup G) (hB : IsElemAb 3 4 B)
    (hcase : (padicValNat 3 (Nat.card G) = 5 ∧ Nat.card Y = 47377612800) ∨
      (padicValNat 3 (Nat.card G) = 6 ∧ Nat.card Y = 3311126603366400))
    (t : G) (ht : orderOf t = 2)
    (hS : ∃ S : Sylow 2 G, t ∈ (S : Subgroup G) ∧ (S : Subgroup G) ≤ Cen t)
    (hfix : ∃! q : G ⧸ Y, t • q = q) : Y = ⊤ := by
  by_contra hne
  rcases hHolt G hnab Y hne t ht hS hfix with ⟨M, hM⟩ | ⟨n, -, ⟨e⟩⟩
  · exact absurd (hSE G hnab ⟨M, hM⟩ B 4 hB) (by norm_num)
  · have hY : Nat.card Y ≤ Nat.card G := Subgroup.card_le_card_group Y
    have h := kf_altOrder G n ⟨e⟩
    rcases hcase with ⟨h3, hc⟩ | ⟨h3, hc⟩
    · have := h.1 h3
      omega
    · have := h.2 h3
      omega

