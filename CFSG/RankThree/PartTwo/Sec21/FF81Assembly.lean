theorem nonempty_mulEquiv_quotient_center {K H : Type} [Group K] [Group H] (θ : K →* H)
    (hs : Function.Surjective θ) (hk : θ.ker ≤ Subgroup.center K)
    (hZ : Subgroup.center K = ⊥) : Nonempty (H ≃* K ⧸ Subgroup.center K) := by
  have hinj : Function.Injective θ :=
    (MonoidHom.ker_eq_bot_iff θ).mp (eq_bot_iff.mpr (hZ ▸ hk))
  exact ⟨(MulEquiv.ofBijective θ ⟨hinj, hs⟩).symm.trans
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm⟩

theorem card_of_model_sp8 {H : Type} [Group H] (h : StatedClassicalModel H .PSp 4 2 1) :
    Nat.card H = 47377612800 := by
  obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := h
  have := Fintype.ofFinite K
  have : CharP K 2 := charP_of_card_eq_prime (by rw [← Nat.card_eq_fintype_card, hK]; rfl)
  rw [Nat.card_congr e.toEquiv,
    CFSG.Timmesfeld.ClassicalOrders.card_statedProj_statedSp_of_charTwo, hK]
  decide

theorem card_of_model_f4 {H : Type} [Group H] (h : ChevalleyExceptionalModel H .F4 2 1) :
    Nat.card H = 3311126603366400 := by
