theorem false_of_card_le_three (h : Config228 Y E y N Kb m) (hZ : Subgroup.center Y = ⊥)
    (h3 : ∀ F : Subgroup Y, (∀ x ∈ F, x ^ 3 = 1) → Nat.card F ≤ 3) : False := by
