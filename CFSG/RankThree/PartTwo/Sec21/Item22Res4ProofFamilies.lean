    rw [injective_iff_map_eq_one]
    intro z hz
    have hzc : z ∈ Subgroup.center Y := by
      rw [← Sec4.ker_conj_eq_center]
      exact hz
    rw [hZ, Subgroup.mem_bot] at hzc
    exact hzc
  set F := E.comap (MulAut.conj : Y →* MulAut Y) with hF
  have hFE : F.map (MulAut.conj : Y →* MulAut Y) = E := Subgroup.map_comap_eq_self h.le_inner
  have hcard : Nat.card F = 9 := by
    have h1 : Nat.card (F.map (MulAut.conj : Y →* MulAut Y)) = Nat.card F :=
      (Nat.card_congr (F.equivMapOfInjective _ hinj).toEquiv).symm
    rw [hFE, h.card_E] at h1
    rw [← h1]
    norm_num
  have hexp : ∀ x ∈ F, x ^ 3 = 1 := by
    intro x hx
    have h1 : MulAut.conj (x ^ 3) = 1 := by
      rw [map_pow]
      exact h.elemAbelian.2 _ hx
    exact hinj (h1.trans (map_one _).symm)
  have := h3 F hexp
  omega

