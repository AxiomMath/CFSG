namespace Config228

variable {Y : Type} [Group Y] {E : Subgroup (MulAut Y)} {y : Y} {N Kb : Subgroup Y} {m : ℕ}

theorem pow_three_mem_center (h : Config228 Y E y N Kb m) : y ^ 3 ∈ Subgroup.center Y := by
  rw [← Sec4.ker_conj_eq_center, MonoidHom.mem_ker, map_pow]
  exact h.elemAbelian.2 _ h.mem_E

theorem isSimpleGroup_Kb (h : Config228 Y E y N Kb m) : IsSimpleGroup Kb := by
  obtain ⟨eK⟩ := h.equiv
  have : IsSimpleGroup (projSL 2 (GaloisField 2 m)) :=
    isSimpleGroup_projSL_two (by obtain ⟨r, hr⟩ := h.even; have := h.pos; omega)
  exact eK.isSimpleGroup

theorem Kb_ne_bot (h : Config228 Y E y N Kb m) : Kb ≠ ⊥ := by
  have := h.isSimpleGroup_Kb
  intro hb
  obtain ⟨a, b, hab⟩ := (IsSimpleGroup.toNontrivial : Nontrivial Kb)
  apply hab
  apply Subtype.ext
  have ha : (a : Y) ∈ (⊥ : Subgroup Y) := hb ▸ a.2
  have hb' : (b : Y) ∈ (⊥ : Subgroup Y) := hb ▸ b.2
  rw [Subgroup.mem_bot] at ha hb'
  rw [ha, hb']

theorem card_dvd [Finite Y] (h : Config228 Y E y N Kb m) :
    Nat.card (projSL 2 (GaloisField 2 m)) ∣ Nat.card Y := by
  obtain ⟨eK⟩ := h.equiv
  rw [← Nat.card_congr eK.toEquiv]
  exact Subgroup.card_subgroup_dvd_card Kb

theorem five_dvd_card [Finite Y] (h : Config228 Y E y N Kb m) : 5 ∣ Nat.card Y :=
  (five_dvd_card_projSL_two h.pos h.even).trans h.card_dvd

theorem false_of_pRank (h : Config228 Y E y N Kb m) {S : Type} [Group S] [Finite S]
    (e : Y ⧸ Subgroup.center Y ≃* S) (hS : CFSG.pRank 3 S ≤ 1) : False := by
  have := Sec4.le_pRank_of_le_inner e h.elemAbelian h.le_inner h.card_E
  omega

theorem false_of_noL2Normal (h : Config228 Y E y N Kb m) {S : Type} [Group S] (e : Y ≃* S)
    (hS : NoL2Normal228 S) : False := by
  have hZ := Sec4.map_center_mulEquiv e
  have hmemZ : ∀ z : Y, e z ∈ Subgroup.center S ↔ z ∈ Subgroup.center Y := fun z => by
    rw [← hZ]
    exact ⟨fun ⟨w, hw, hwz⟩ => (e.injective hwz) ▸ hw, fun hz => ⟨z, hz, rfl⟩⟩
  obtain ⟨eK⟩ := h.equiv
  refine hS (e y) (N.map e.toMonoidHom) (Kb.map e.toMonoidHom) m
    (fun h1 => h.not_mem_center ((hmemZ y).mp h1))
    (by rw [← map_pow]; exact (hmemZ _).mpr h.pow_three_mem_center) ?_ ?_
    (Subgroup.map_mono h.le)
    ⟨(Kb.equivMapOfInjective e.toMonoidHom e.injective).symm.trans eK⟩ h.pos h.even ?_
  · rintro _ ⟨k, hk, rfl⟩
    change e y * e k = e k * e y
    rw [← map_mul, ← map_mul, h.comm k hk]
  · rintro g hg _ ⟨k, hk, rfl⟩
    obtain ⟨g', rfl⟩ := e.surjective g
    have hg' : g' * y = y * g' := e.injective (by rw [map_mul, map_mul]; exact hg)
    refine ⟨g' * k * g'⁻¹, h.normalizes g' hg' k hk, ?_⟩
    change e (g' * k * g'⁻¹) = e g' * e k * (e g')⁻¹
    rw [map_mul, map_mul, map_inv]
  · rcases h.eq_or with heq | hU
    · exact Or.inl (by rw [heq])
    · exact Or.inr (CFSG.SectionRank.statedClassicalModel_of_mulEquiv
        (N.equivMapOfInjective e.toMonoidHom e.injective).symm hU)

theorem false_of_fact [Finite Y] (h : Config228 Y E y N Kb m) {S : Type} [Group S] (e : Y ≃* S)
    (hS : Census228Fact S) : False := by
  have : Finite S := Finite.of_equiv _ e.toEquiv
  rcases hS with hS | hS
  · exact h.false_of_pRank (Sec4.quotientCenterCongr e) hS
  · exact h.false_of_noL2Normal e hS

abbrev cent (y : Y) : Subgroup Y :=
  (⊤ : Subgroup Y) ⊓ Subgroup.centralizer ((Subgroup.zpowers y : Subgroup Y) : Set Y)

theorem mem_cent_iff {g : Y} : g ∈ cent y ↔ g * y = y * g := by
  constructor
  · rintro ⟨-, hg⟩
    exact (Subgroup.mem_centralizer_iff.mp hg y (Subgroup.mem_zpowers y)).symm
  · intro hg
    refine ⟨Subgroup.mem_top g, Subgroup.mem_centralizer_iff.mpr ?_⟩
    rintro _ ⟨k, rfl⟩
    exact ((Commute.zpow_left hg.symm k).eq)

theorem le_perfectResidual [Finite Y] (h : Config228 Y E y N Kb m) :
    Kb ≤ inSubgroup perfectResidual (cent y) := by
  obtain ⟨eK⟩ := h.equiv
  have hKp : Group.IsPerfect Kb :=
    isPerfect_of_mulEquiv_projSL (by obtain ⟨r, hr⟩ := h.even; have := h.pos; omega) eK
  refine CFSG.RankThree.PartOne.EmbeddingTransport.le_inSubgroup_perfectResidual_of_isPerfect ?_ hKp
  intro k hk
  exact mem_cent_iff.mpr (h.comm k (h.le hk)).symm

theorem le_of_simple [Finite Y] (h : Config228 Y E y N Kb m)
    (hP : IsSimpleGroup (inSubgroup perfectResidual (cent y))) :
    inSubgroup perfectResidual (cent y) ≤ N := by
  set P := inSubgroup perfectResidual (cent y) with hPdef
  have hPC : P ≤ cent y := Subgroup.map_subtype_le _
  have hnorm : (N.subgroupOf P).Normal := by
    refine ⟨fun n hn g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    have hg := mem_cent_iff.mp (hPC g.2)
    simpa using h.normalizes g hg n hn
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (N.subgroupOf P) with hb | ht
  · exfalso
    apply h.Kb_ne_bot
    rw [eq_bot_iff]
    intro k hk
    have hkP := h.le_perfectResidual hk
    have : (⟨k, hkP⟩ : P) ∈ N.subgroupOf P := Subgroup.mem_subgroupOf.mpr (h.le hk)
    rw [hb, Subgroup.mem_bot] at this
    exact Subgroup.mem_bot.mpr (congrArg Subtype.val this)
  · intro p hp
    have : (⟨p, hp⟩ : P) ∈ N.subgroupOf P := ht ▸ Subgroup.mem_top _
    exact Subgroup.mem_subgroupOf.mp this

theorem eq_of_perfectResidual [Finite Y] (h : Config228 Y E y N Kb m) {k : ℕ} (hk : 2 ≤ k)
    (eP : inSubgroup perfectResidual (cent y) ≃* projSL 2 (GaloisField 2 k)) :
    m = k ∨ (StatedClassicalModel N .PSU 3 2 2 ∧ k = 2 ∧ m = 2) := by
  have : IsSimpleGroup (projSL 2 (GaloisField 2 k)) := isSimpleGroup_projSL_two hk
  have hP : IsSimpleGroup (inSubgroup perfectResidual (cent y)) := eP.isSimpleGroup
  have hPN := h.le_of_simple hP
  have hKP := h.le_perfectResidual
  obtain ⟨eK⟩ := h.equiv
  rcases h.eq_or with heq | hU
  · left
    have hKbP : Kb = inSubgroup perfectResidual (cent y) := le_antisymm hKP (heq ▸ hPN)
    have e' : projSL 2 (GaloisField 2 m) ≃* projSL 2 (GaloisField 2 k) :=
      eK.symm.trans ((MulEquiv.subgroupCongr hKbP).trans eP)
    exact eq_of_mulEquiv_projSL_two (by have := h.pos; omega) (by omega) e'
  · right
    have h62 := card_of_statedU34 hU
    have hPd : Nat.card (projSL 2 (GaloisField 2 k)) ∣ 62400 := by
      rw [← Nat.card_congr eP.toEquiv, ← h62]
      exact Subgroup.card_dvd_of_le hPN
    have hKd : Nat.card (projSL 2 (GaloisField 2 m)) ∣ 62400 := by
      rw [← Nat.card_congr eK.toEquiv, ← h62]
      exact Subgroup.card_dvd_of_le h.le
    refine ⟨hU, ?_, ?_⟩
    · have hke : k = 2 ∨ k ≠ 2 := eq_or_ne k 2
      rcases hke with hk2 | hk2
      · exact hk2
      · exfalso
        rw [card_projSL_two k (by omega)] at hPd
