@[expose] def NoL2Normal228 (S : Type) [Group S] : Prop :=
  ∀ (y : S) (N Kb : Subgroup S) (m : ℕ), y ∉ Subgroup.center S → y ^ 3 ∈ Subgroup.center S →
    (∀ k ∈ N, y * k = k * y) → (∀ g : S, g * y = y * g → ∀ k ∈ N, g * k * g⁻¹ ∈ N) →
    Kb ≤ N → Nonempty (Kb ≃* projSL 2 (GaloisField 2 m)) → 0 < m → Even m →
    (Kb = N ∨ StatedClassicalModel N .PSU 3 2 2) → False

@[expose] def Census228Fact (S : Type) [Group S] : Prop :=
  CFSG.pRank 3 (S ⧸ Subgroup.center S) ≤ 1 ∨ NoL2Normal228 S

@[expose] def Census228InnerFor (P : (Y : Type) → [Group Y] → Prop) : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (X A K K₀ : Subgroup G) (m : ℕ),
    P (X ⧸ aschbacherSolvableCore 3 X) →
    Maximal (fun B : Subgroup G => IsElemAbelian 3 B) A → Nat.card A = 3 ^ 3 →
    A ≤ Subgroup.normalizer (X : Set G) →
    Nat.card (A ⊓ Sec4.thetaQuotCentralizer X : Subgroup G) = 3 →
    (∀ x ∈ A, ¬ Sec4.InducesOuterTheta x X) →
    (∃ f : Multiplicative (Fin 3 → ZMod 3) ≃* A,
      (starOf A X).map (coordGL f) ≤ KFacts.KP14.monomial) →
    (∀ ρ ∈ starOf A X, ¬ IsTransvectionOn ρ) →
    ∀ ρ ∈ starOf A X, IsReflectionOn ρ →
      K ≤ K₀ → K₀ ≤ X → K₀ ≤ Subgroup.centralizer (fixedInG A ρ : Set G) →
      (∀ y ∈ X ⊓ Subgroup.centralizer (fixedInG A ρ : Set G), ∀ k ∈ K₀, y * k * y⁻¹ ∈ K₀) →
      (K = K₀ ∨ StatedClassicalModel K₀ .PSU 3 2 2) →
      Nonempty (K ≃* projSL 2 (GaloisField 2 m)) → 0 < m → Even m → False

@[expose] def Census228L3Rest : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y], ¬ IsL3Type228 Y →
    ((∃ (p e : ℕ) (_ : Fact p.Prime), 3 < p ∧ 1 ≤ e ∧ e ≤ 2 ∧
        (Sec4.IsSLThreeEpsAt Y (p ^ e) ∨ Nonempty (Y ≃* projSL 3 (GaloisField p e)) ∨
          Nonempty (Y ≃* projSU 3 p e))) ∨
      ∃ n : ℕ, 1 ≤ n ∧ (Nonempty (Y ≃* projSL 3 (GaloisField 2 n)) ∨
        Nonempty (Y ≃* projSU 3 2 n) ∨ Sec4.IsSLThreeEpsAt Y (2 ^ n))) →
    CFSG.pRank 3 (Y ⧸ Subgroup.center Y) ≤ 1

@[expose] def Census228LieOdd : Prop :=
  ∀ (p : ℕ) [Fact p.Prime], 3 < p → ∀ (Y : Type) [Group Y] [Finite Y],
    (Blueprint.ChevalleyExceptionalModel Y .G2 p 1 ∨
      (p ≠ 5 ∧ Nonempty (Y ≃* projSp 2 (GaloisField p 1))) ∨
      (p % 3 = 1 ∧ Nonempty (Y ≃* projSU 4 p 1)) ∨
      (p % 3 = 2 ∧ Nonempty (Y ≃* projSL 4 (GaloisField p 1)))) →
    Census228Fact Y

@[expose] def Census228Alt : Prop :=
  (∀ n : ℕ, n ≤ 9 → n ≠ 8 → Census228Fact (alternatingGroup (Fin n))) ∧
  ∀ (Y : Type) [Group Y] [Finite Y],
    (Sec4.IsExtOf Y (alternatingGroup (Fin 6)) (Multiplicative (ZMod 3)) ∨
      Sec4.IsExtOf Y (alternatingGroup (Fin 7)) (Multiplicative (ZMod 3))) → Census228Fact Y

@[expose] def sporadicsStar228 : List TauCeti.SporadicName := [.M23, .HS, .M24, .He, .Ru, .J4]

@[expose] def Census228Spor : Prop :=
  (∀ s ∈ Sec4.sporadics46, s ∉ sporadicsStar228 →
      Census228Fact (Blueprint.NativeSporadic.Carrier s)) ∧
  ∀ s ∈ Sec4.sporadicCovers46, ∀ (Y : Type) [Group Y] [Finite Y],
    Sec4.IsExtOf Y (Blueprint.NativeSporadic.Carrier s) (Multiplicative (ZMod 3)) →
      Census228Fact Y

@[expose] def Census228SporStar : Prop :=
  Census228InnerFor fun Y _ => ∃ s ∈ sporadicsStar228,
    Nonempty (Y ≃* Blueprint.NativeSporadic.Carrier s)

@[expose] def Census228ChevTwoRest : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y],
    ((∃ n : ℕ, 1 ≤ n ∧ Odd n ∧ (Nonempty (Y ≃* projSp 2 (GaloisField 2 n)) ∨
        Nonempty (Y ≃* projSU 4 2 n))) ∨
      ∃ f : ℕ, Blueprint.ReeTitsModel Y .twistedF4 2 f ∨ Blueprint.ReeTitsModel Y .Tits 2 f) →
    Census228Fact Y

@[expose] def Census228ExcStar : Prop :=
  Census228InnerFor fun Y _ => ∃ f : ℕ, Blueprint.ChevalleyExceptionalModel Y .G2 2 f ∨
    Blueprint.ChevalleyExceptionalModel Y .trialityD4 2 f

@[expose] def Census228Sp62 : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y], Nonempty (Y ≃* projSp 3 (GaloisField 2 1)) → Census228Fact Y

@[expose] def Census228CharThree : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y],
    (Nonempty (Y ≃* projSL 3 (GaloisField 3 2)) ∨ Nonempty (Y ≃* projSU 3 3 2) ∨
      Nonempty (Y ≃* projSL 4 (GaloisField 3 1)) ∨
      (Nat.card (Subgroup.center Y) ≤ 3 ∧ Nonempty (Y ⧸ Subgroup.center Y ≃* projSU 4 3 1))) →
    Census228Fact Y

namespace Item22Res4Proof

theorem five_dvd_card_projSL_two {m : ℕ} (hm : 0 < m) (he : Even m) :
    5 ∣ Nat.card (projSL 2 (GaloisField 2 m)) := by
  rw [card_projSL_two m hm]
  refine Dvd.dvd.mul_left ?_ _
  obtain ⟨r, rfl⟩ := he
  have h : (2 ^ (r + r)) ^ 2 = 16 ^ r := by
    rw [← pow_mul, show (r + r) * 2 = 4 * r by ring, pow_mul]
    norm_num
  rw [h]
  have h15 : 15 ∣ 16 ^ r - 1 := by simpa using Nat.sub_dvd_pow_sub_pow 16 1 r
  exact (show 5 ∣ 15 by norm_num).trans h15

theorem card_of_statedU34 {N : Type} [Group N] (h : StatedClassicalModel N .PSU 3 2 2) :
    Nat.card N = 62400 :=
  CFSG.Open.StatedAPI.card_of_statedClassicalModel_psu_three_four h

theorem le_two_of_card_dvd {m N b : ℕ} (hm : 0 < m) (he : Even m)
    (hdvd : Nat.card (projSL 2 (GaloisField 2 m)) ∣ N) (hN : 0 < N) (hb : N < 2 ^ b)
    (hcheck : ∀ k < b, 2 < k → Even k → ¬ 2 ^ k * ((2 ^ k) ^ 2 - 1) ∣ N) : m = 2 := by
  rw [card_projSL_two m hm] at hdvd
  have h2 : 2 ^ m ∣ N := (Dvd.intro _ rfl).trans hdvd
  have hmb : m < b := by
    by_contra h
    have h1 : 2 ^ b ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) (by omega)
    have h3 := Nat.le_of_dvd hN h2
    omega
  by_contra hm2
  obtain ⟨r, rfl⟩ := he
  exact hcheck (r + r) hmb (by omega) ⟨r, rfl⟩ hdvd

end Item22Res4Proof

