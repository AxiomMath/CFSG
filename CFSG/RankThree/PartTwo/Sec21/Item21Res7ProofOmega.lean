theorem card_le_and_pow_three {L : Subgroup G} {n : ℕ} (hn0 : 0 < n) (hev : Even n)
    (eL : lBar L ≃* CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 n))
    (h91 : 2 ^ n % 9 ≠ 1) {R : Subgroup G} (hRL : R ≤ L) (hR : IsPGroup 3 R) :
    Nat.card R ≤ 9 ∧ ∀ r ∈ R, r ^ 3 = 1 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h3 : 2 ^ n % 3 = 1 := by
    obtain ⟨k, hk⟩ := hev
    rw [hk, ← two_mul, pow_mul, Nat.pow_mod]
    norm_num
  have hiso : Sec4.IsoLThreePi (lBar L) 2 n := Or.inl ⟨h3, ⟨eL⟩⟩
  have h98 : 2 ^ n % 9 ≠ 8 := by omega
  set R' := R.subgroupOf L with hR'
  have hR'p : IsPGroup 3 R' := hR.comap_of_injective L.subtype L.subtype_injective
  set π := QuotientGroup.mk' (aschbacherSolvableCore 3 ↥L) with hπ
  have hinj := injOn_mk_of_isPGroup Nat.prime_three hR'p
  have hRb : IsPGroup 3 (R'.map π) := hR'p.map π
  obtain ⟨S, hS⟩ := hRb.exists_le_sylow
  obtain ⟨hS9, hS3⟩ := Sec19.Step1915WProof.ks1917Lie3Sylow (lBar L) 2 n (by omega) hiso h91
    h98 S
  have hcardR : Nat.card R = Nat.card (R'.map π) := by
    have hinj' : Function.Injective (π.comp R'.subtype) := fun a b h =>
      Subtype.ext (hinj a.2 b.2 h)
    have hrange : (π.comp R'.subtype).range = R'.map π := by
      rw [MonoidHom.range_comp, range_subtype]
    rw [← hrange, ← Nat.card_congr (MonoidHom.ofInjective hinj').toEquiv, hR',
      Nat.card_congr (subgroupOfEquivOfLe hRL).toEquiv]
  refine ⟨?_, fun r hr => ?_⟩
  · rw [hcardR, ← hS9]
    exact card_le_of_le hS
  · have hr' : (⟨r, hRL hr⟩ : L) ∈ R' := mem_subgroupOf.mpr hr
    have hr3 : (⟨r, hRL hr⟩ : L) ^ 3 ∈ R' := pow_mem hr' 3
    have himg : π ((⟨r, hRL hr⟩ : L) ^ 3) = π 1 := by
      rw [map_pow, map_one]
      exact hS3 _ (hS ⟨_, hr', rfl⟩)
    have h1 := hinj hr3 (one_mem R') himg
    have h2 := congrArg Subtype.val h1
    simpa using h2

theorem card_le_mul_card_inf {L : Subgroup G} {n : ℕ} (hn0 : 0 < n) (hev : Even n)
    (eL : lBar L ≃* CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 n))
    (h91 : 2 ^ n % 9 ≠ 1) {P : Subgroup G} (hPL : P ≤ normalizer (L : Set G))
    (hP : IsPGroup 3 P) :
    Nat.card P ≤ 27 * Nat.card (P ⊓ Sec4.thetaQuotCentralizer L : Subgroup G) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h3 : 2 ^ n % 3 = 1 := by
    obtain ⟨k, hk⟩ := hev
    rw [hk, ← two_mul, pow_mul, Nat.pow_mod]
    norm_num
  have hiso : Sec4.IsoLThreePi (lBar L) 2 n := Or.inl ⟨h3, ⟨eL⟩⟩
  have h98 : 2 ^ n % 9 ≠ 8 := by omega
  have hn2 : 2 ^ n ≠ 2 := by
    obtain ⟨k, hk⟩ := hev
    intro h
    have : n = 1 := by
      have := Nat.pow_right_injective (le_refl 2) (h.trans (pow_one 2).symm)
      exact this
    omega
  have hX := Sec13.Item138Proof.factorization_card_three_eq_two (by omega) hiso (by omega)
  have hOut := Sec19.Item19ResProof.not_nine_dvd_card_outer (by omega) hiso hn2 h91 h98
  set ρ : P →* MulAut (lBar L) :=
    (Sec4.thetaQuotMulAut L).comp (L.normalizerMonoidHom.comp (inclusion hPL)) with hρ
  have hrange : Nat.card ρ.range ≤ 27 :=
    Sec19.Item19ResProof.card_le_of_isPGroup hX hOut ρ.range
      (hP.of_surjective ρ.rangeRestrict ρ.rangeRestrict_surjective)
  have hker : Nat.card ρ.ker = Nat.card (P ⊓ Sec4.thetaQuotCentralizer L : Subgroup G) := by
    have hmap : ρ.ker.map P.subtype = P ⊓ Sec4.thetaQuotCentralizer L := by
      ext g
      constructor
      · rintro ⟨p, hp, rfl⟩
        refine ⟨p.2, ⟨⟨p, hPL p.2⟩, ?_, rfl⟩⟩
        exact hp
      · rintro ⟨hgP, ⟨g', hg', hgg'⟩⟩
        refine ⟨⟨g, hgP⟩, ?_, rfl⟩
        have hg'' : ((Sec4.thetaQuotMulAut ↥L).comp L.normalizerMonoidHom) g' = 1 := hg'
        have : (⟨(g : G), hPL hgP⟩ : normalizer (L : Set G)) = g' :=
          Subtype.ext hgg'.symm
        change (Sec4.thetaQuotMulAut L) (L.normalizerMonoidHom ⟨g, hPL hgP⟩) = 1
        rw [this]
        exact hg''
    rw [← hmap, card_map_of_injective P.subtype_injective]
  have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup ρ.ker
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange ρ).toEquiv, hker] at hcard
  rw [hcard]
  exact Nat.mul_le_mul_right _ hrange

theorem not_mod_nine {A E U L : Subgroup G} {c : G} (h45 : Sec4.Item4_5) (h66 : Sec6.Item6_6)
    (hcfg : Config2119 G A E U c L) (hAL3 : Nat.card (A ⊓ L : Subgroup G) = 3) {n : ℕ}
    (eL : lBar L ≃* CFSG.Assembly.RankThreeEven.projSL 3 (GaloisField 2 n)) (hn0 : 0 < n)
    (hev : Even n) : 2 ^ n % 9 ≠ 1 := by
  intro h91
  have hpair := hcfg.pair
  have hpairs := mem_lThreeStarPairs_iff.mp hpair.mem_pair
  have hAe : IsElemAbelian 3 A := hpair.mem_S.1.1
  have hAmax : ∀ B : Subgroup G, IsElemAbelian 3 B → A ≤ B → B = A := hpair.mem_S.1.2.1
  have hcA : c ∈ A := hpair.mem_E.2 hpairs.1.1
  have hc1 : c ≠ 1 := hpairs.2.1
  have hc3 : orderOf c = 3 := orderOf_eq_prime (hAe.2 c hcA) hc1
  have hLc : L ∈ thetaComponentsAt 3 c := lZeroStarAt_subset A c hpairs.2.2.1
  have hAL : A ≤ normalizer (L : Set G) :=
    Sec6.le_normalizer_of_mem_thetaComponentsAt h45 hpair.standing.toTheoremFourHyp hAe hcA hc1
      L hLc
  have hZ : center (lBar L) = ⊥ := Item2119End3Proof.center_eq_bot_of_mulEquiv' eL
    (Item21Early2Proof.center_projSL_three_eq_bot hn0 hev)
  have hsc := Item211Proof.sectionCentralizer_eq h45 h66 hpair
  obtain ⟨π, p, f, K, _, hPi, hmod, e, D, hD, hconj, -⟩ := hcfg.typeC
  have hcard := Sec13.card_projImage_slPi_mul_three hPi hmod
  rw [← Nat.card_congr e.toEquiv] at hcard
  obtain ⟨rfl, rfl, hfn⟩ := Sec19.Step1917EqProof.eq_two_of_card hPi.prime hPi.one_le
    (by omega) hmod hcard (Sec19.Step1917EqProof.card_kStar (by omega) (Or.inr ⟨eL⟩))
  subst hfn
  have h9 : Sec4.ModNine true (2 ^ f) := h91
  have hsub : A ≤ zpowers c ⊔ (A ⊓ L) := by
    intro a ha
    obtain ⟨y, hyD, hy⟩ := hconj _ (Sec4.mem_autThetaQuot_iff.mpr ⟨a, hAL ha, ha, rfl⟩)
    obtain ⟨w', hw'⟩ := Sec13.exists_conj_eq_of_isTypeC hPi hmod h9 e hD hyD hy
    obtain ⟨m, hmA, -, k, hk⟩ :=
      Sec13.Item138Proof.exists_eq_zpow_mul_of_inner hAL hAe hAmax hZ hsc ha hw'
    rw [hk]
    exact mul_mem (mem_sup_left (zpow_mem (mem_zpowers c) k)) (mem_sup_right ⟨hmA, m.2⟩)
  have hN : zpowers c ≤ normalizer ((A ⊓ L : Subgroup G) : Set G) := by
    rw [zpowers_le]
    refine mem_normalizer_fintype fun z hz => ?_
    have hcz : c * z = z * c :=
      congrArg Subtype.val (hAe.1.is_comm.comm ⟨c, hcA⟩ ⟨z, hz.1⟩)
    rw [hcz, mul_inv_cancel_right]
    exact hz
  have hprod := Sec6.card_sup_mul_card_inf hN
  rw [Nat.card_zpowers, hc3, hAL3] at hprod
  have hpos : 0 < Nat.card (zpowers c ⊓ (A ⊓ L) : Subgroup G) := Nat.card_pos
  have hle := card_le_of_le hsub
  have h27 : Nat.card A = 27 := by rw [hcfg.card]; norm_num
  rw [h27] at hle
  nlinarith

end Item21Res7Proof

