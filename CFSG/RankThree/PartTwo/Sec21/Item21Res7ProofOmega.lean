  have h1 : a₀⁻¹ * l * a₀ ∈ L := by
    have := (mem_normalizer_iff.mp (hAL (A.inv_mem ha₀)) l).mp hlL
    simpa using this
  exact L.mul_mem h1 (L.inv_mem hlL)

end CFSG.RankThree.PartTwo.Sec21
