theorem item2120Omega_of (h45 : Sec4.Item4_5) (h66 : Sec6.Item6_6) : Item2120Omega := by
  intro G _ _ A E U c L hcfg hAL3 x hxW hx3 hxc
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hcL, d₀, hd₀AL, hd₀1, -, -, -, hHd, hHW, ⟨w, ⟨hwL, hwN⟩, hw3, hwd, -, ⟨a₁, ha₁A, hwa₁⟩⟩,
    -⟩ := Item21Late2Proof.frame_of h45 h66 hcfg
  have hpair := hcfg.pair
  have hpairs := mem_lThreeStarPairs_iff.mp hpair.mem_pair
  have hAe : IsElemAbelian 3 A := hpair.mem_S.1.1
  have hcomm : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hAe.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have h3 : ∀ a ∈ A, a ^ 3 = 1 := hAe.2
  have hA27 : Nat.card A = 27 := by rw [hcfg.card]; norm_num
  have hcA : c ∈ A := hpair.mem_E.2 hpairs.1.1
  have hc1 : c ≠ 1 := hpairs.2.1
  have hc3 : c ^ 3 = 1 := h3 c hcA
  have hLc : L ∈ thetaComponentsAt 3 c := lZeroStarAt_subset A c hpairs.2.2.1
  have hLC : L ≤ centralizer ({c} : Set G) := Sec6.le_centralizer_of_mem_thetaComponentsAt hLc
  have hAL : A ≤ normalizer (L : Set G) :=
    Sec6.le_normalizer_of_mem_thetaComponentsAt h45 hpair.standing.toTheoremFourHyp hAe hcA hc1
      L hLc
  have hLs : L ∈ lStar A :=
    lZeroStar_subset_lStar A (lZeroStarAt_subset_lZeroStar A c hpairs.2.2.1)
  obtain ⟨n, hn0, hev, ⟨eL⟩⟩ := hcfg.lthree
  have hZ : center (lBar L) = ⊥ := Item2119End3Proof.center_eq_bot_of_mulEquiv' eL
    (Item21Early2Proof.center_projSL_three_eq_bot hn0 hev)
  have h91 := not_mod_nine h45 h66 hcfg hAL3 eL hn0 hev
  have hsc := Item211Proof.sectionCentralizer_eq h45 h66 hpair
  have hAmax : ∀ B : Subgroup G, IsElemAbelian 3 B → A ≤ B → B = A := hpair.mem_S.1.2.1
  have hcC : c ∈ Sec4.thetaQuotCentralizer L :=
    Sec6.mem_thetaQuotCentralizer_of_mem_thetaComponentsAt hLc
  have hCA : A ⊓ Sec4.thetaQuotCentralizer L = zpowers c := by
    symm
    refine eq_of_le_of_card_ge (zpowers_le.mpr ⟨hcA, hcC⟩) ?_
    rw [Nat.card_zpowers, orderOf_eq_prime hc3 hc1]
    exact Sec6.card_le_three_of_isCyclic (h66 G hpair.standing A hpair.mem_S L hLs)
      fun y hy => h3 y hy.1
  have hd₀A : d₀ ∈ A := hd₀AL.1
  have hd₀L : d₀ ∈ L := hd₀AL.2
  have hd₀3 : d₀ ^ 3 = 1 := h3 d₀ hd₀A
  have hALd : A ⊓ L = zpowers d₀ := by
    symm
    refine eq_of_le_of_card_ge (zpowers_le.mpr hd₀AL) ?_
    rw [hAL3, Nat.card_zpowers, orderOf_eq_prime hd₀3 hd₀1]
  set Q := normalizer ((zpowers c : Subgroup G) : Set G) ⊓ normalizer (A : Set G) with hQ
  have hmemQ : ∀ g : G, g * c * g⁻¹ = c → g ∈ normalizer (A : Set G) → g ∈ Q := by
    intro g hgc hgA
    refine ⟨mem_normalizer_fintype fun z hz => ?_, hgA⟩
    rw [Item21LateProof.conj_eq_of_mem_zpowers hgc hz]
    exact hz
  have hAQ : A ≤ Q := fun a ha =>
    hmemQ a (by rw [hcomm a ha c hcA, mul_inv_cancel_right]) (le_normalizer ha)
  have hxQ : x ∈ Q := hmemQ x hxc hxW
  have hfixL : ∀ l ∈ L, l * c * l⁻¹ = c := fun l hl => by
    rw [mem_centralizer_singleton_iff.mp (hLC hl), mul_inv_cancel_right]
  have hR₀3 : IsPGroup 3 (zpowers x ⊔ A : Subgroup G) := by
    have hprod := Sec6.card_sup_mul_card_inf (zpowers_le.mpr hxW)
    have hx' : Nat.card (zpowers x) ∣ 3 := by
      rw [Nat.card_zpowers]
      exact orderOf_dvd_of_pow_eq_one hx3
    have hdvd : Nat.card (zpowers x ⊔ A : Subgroup G) ∣ 3 ^ 4 := by
      have h1 : Nat.card (zpowers x ⊔ A : Subgroup G) ∣ Nat.card (zpowers x) * Nat.card A :=
        ⟨_, hprod.symm⟩
      refine h1.trans ?_
      rw [hA27, show (3 : ℕ) ^ 4 = 3 * 27 by norm_num]
      exact Nat.mul_dvd_mul_right hx' 27
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hdvd
    exact IsPGroup.of_card hj
  obtain ⟨P, hR₀P, hPQ⟩ := exists_isSylowOf_le (sup_le (zpowers_le.mpr hxQ) hAQ) hR₀3
  have hPle : P ≤ Q := hPQ.le
  have hP3 : IsPGroup 3 P := hPQ.isPGroup
  have hAP : A ≤ P := le_sup_right.trans hR₀P
  have hxP : x ∈ P := hR₀P (mem_sup_left (mem_zpowers x))
  have hPL : P ≤ normalizer (L : Set G) := hPle.trans hHW
  have hpow : ∀ p ∈ P, ∃ k : ℕ, p ^ (3 ^ k) = 1 := fun p hp => by
    obtain ⟨k, hk⟩ := hP3 ⟨p, hp⟩
    exact ⟨k, by simpa using congrArg Subtype.val hk⟩
  have hPc : ∀ p ∈ P, p * c = c * p := by
    intro p hp
    obtain ⟨k, hk⟩ := hpow p hp
    exact Item2110Res3Proof.commute_of_mem_zpowers_of_pow_three hc3 hk
      ((mem_normalizer_iff.mp (hPle hp).1 c).mp (mem_zpowers c))
  have hPd : ∀ p ∈ P, p * d₀ = d₀ * p := by
    intro p hp
    obtain ⟨k, hk⟩ := hpow p hp
    refine Item2110Res3Proof.commute_of_mem_zpowers_of_pow_three hd₀3 hk ?_
    rcases hHd p (hPle hp) with h | h
    · rw [h]
      exact mem_zpowers d₀
    · rw [h]
      exact inv_mem (mem_zpowers d₀)
  have hLCP : ∀ z ∈ L, z ∈ Sec4.thetaQuotCentralizer L → z ∈ P → z = 1 := by
