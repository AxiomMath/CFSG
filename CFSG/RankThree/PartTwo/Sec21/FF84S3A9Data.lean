      have hx := x.isLt
      have hy := y.isLt
      have h1 : x = y := Fin.ext (by omega)
      have h2 : a9enc l = a9enc m := by omega
      rw [h1, a9_enc_inj h2]

private def a9getN (A j : Nat) : Nat := if A / 8 ^ j < 8 then 0 else A / 8 ^ j % 8

private theorem a9_getN_enc :
