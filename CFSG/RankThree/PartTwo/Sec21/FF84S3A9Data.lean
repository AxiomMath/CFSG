theorem sign_fp_of (l : List (Fin 8)) (hl : l.Nodup) (hn : 2 ≤ l.length) :
    Equiv.Perm.sign (List.formPerm l) = -(-1) ^ l.length := by
  rw [(List.isCycle_formPerm hl hn).sign,
    List.support_formPerm_of_nodup l hl (fun x h => by rw [h] at hn; simp at hn),
    List.toFinset_card_of_nodup hl]

theorem sign_fp' (l : List (Fin 8)) (h : l.Nodup ∧ 2 ≤ l.length) :
    Equiv.Perm.sign (List.formPerm l) = -(-1) ^ l.length := sign_fp_of l h.1 h.2

