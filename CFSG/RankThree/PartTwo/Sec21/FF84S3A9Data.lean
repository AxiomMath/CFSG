  subst h; exact List.mem_map.1 hX

private theorem a9_nodup_enc {L : List (List (Fin 8))} {N : List Nat} (h : L.map a9enc = N)
    (hN : N.Nodup) : L.Nodup :=
  List.Nodup.of_map a9enc (h ▸ hN)

private def a9dec (QB k : Nat) : Nat := QB / (8 ^ 9) ^ k % 8 ^ 9

private def A9TabN (S I : Nat) (HN QN EN : List Nat) (GN HW : List (Nat × Nat))
    (QB : Nat) : Prop :=
  HW.map Prod.fst = HN ∧ (List.range 32).map (a9dec QB) = QN ∧ HN.Nodup ∧
  (∀ X ∈ HN, a9cN X S = a9cN S X) ∧ QN.Nodup ∧
  (∀ X ∈ QN, X ∈ HN) ∧ I ∈ QN ∧ S ∈ QN ∧
  (∀ A ∈ QN, ∀ B ∈ QN, a9cN A B ∈ QN) ∧ (∀ A ∈ QN, ∃ B ∈ QN, a9cN A B = I) ∧
  (∀ p ∈ HW, ∀ k ∈ List.range 32,
    a9cN p.1 (a9dec QB k) = a9cN (a9dec QB (p.2 / 32 ^ k % 32)) p.1) ∧
  (∀ X ∈ QN, a9sqN (a9sqN (a9sqN X)) = I) ∧
  (∀ G ∈ QN, (∀ H ∈ QN, a9cN H G = a9cN G H) → G = I ∨ G = S) ∧
  (∀ A ∈ QN, ∀ B ∈ QN, a9cN A B = a9cN I (a9cN B A) ∨ a9cN A B = a9cN S (a9cN B A)) ∧
  (∃ A ∈ QN, ∃ B ∈ QN, a9cN A B = a9cN S (a9cN B A)) ∧
  (∀ X ∈ QN, a9sqN X = I ∨ a9sqN X = S) ∧ (∀ H ∈ QN, a9cN H S = a9cN S H) ∧
  EN.Nodup ∧ (∀ X ∈ EN, X ∈ QN) ∧ I ∈ EN ∧ (∀ A ∈ EN, ∀ B ∈ EN, a9cN A B ∈ EN) ∧
  (∀ A ∈ EN, ∃ B ∈ EN, a9cN A B = I) ∧
  (∀ A ∈ EN, ∀ B ∈ EN, a9cN A B = a9cN B A) ∧
  (∀ A ∈ EN, a9sqN A = I) ∧ (∀ g ∈ GN, g.1 ∈ HN) ∧
  (∀ X ∈ HN, a9sqN (a9sqN (a9sqN X)) = I → X ∈ QN ∨
    ∃ a ∈ GN, ∃ b ∈ GN,
      a9sqN (a9sqN (a9sqN (a9cN (a9cN (a9cN a.1 X) a.2) (a9cN (a9cN b.1 X) b.2)))) ≠ I)

private theorem A9Tab_of_N {s t : P8} {HL QL EL GP : List P8} {HT QT ET : List (List (Fin 8))}
    {GT : List (List (Fin 8) × List (Fin 8))} {S I : Nat} {HN QN EN : List Nat}
    {GN : List (Nat × Nat)}
    (h0 : t * s = s * t ∧ HL.length = 192 ∧ QL.length = 32 ∧ EL.length = 8 ∧
      HL.map tab = HT ∧ QL.map tab = QT ∧ EL.map tab = ET ∧
      GP.map (fun g => (tab g, tab g⁻¹)) = GT)
    (hH : HT.map a9enc = HN) (hQ : QT.map a9enc = QN) (hE : ET.map a9enc = EN)
    (hG : GT.map (fun g => (a9enc g.1, a9enc g.2)) = GN) (hS : a9enc (tab s) = S)
    (hI : a9enc (tab 1) = I) {HW : List (Nat × Nat)} {QB : Nat}
    (hN : A9TabN S I HN QN EN GN HW QB) :
    A9Tab s t HL QL EL GP HT QT ET GT := by
  obtain ⟨h1, h2, h3, h4, h5, h8, h22, h30⟩ := h0
  obtain ⟨n5, n5q, n6, n7, n9, n10, n11, n12, n13, n14, n15, n16, n17, n18, n19, n20, n21, n23,
    n24, n25, n26, n27, n28, n29, n31, n32⟩ := hN
  have mH : ∀ {x}, x ∈ HT ↔ a9enc x ∈ HN := a9_mem_enc hH
  have mQ : ∀ {x}, x ∈ QT ↔ a9enc x ∈ QN := a9_mem_enc hQ
  have mE : ∀ {x}, x ∈ ET ↔ a9enc x ∈ EN := a9_mem_enc hE
  subst hS hI
  refine ⟨h1, h2, h3, h4, h5, a9_nodup_enc hH n6, ?_, h8, a9_nodup_enc hQ n9,
    fun x hx => mH.2 (n10 _ (mQ.1 hx)), mQ.2 n11, mQ.2 n12, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
    h22, a9_nodup_enc hE n23, fun x hx => mQ.2 (n24 _ (mE.1 hx)), mE.2 n25, ?_, ?_, ?_, ?_, h30,
    ?_, ?_⟩
  · exact fun x hx => a9_enc_inj (by rw [a9_enc_comp, a9_enc_comp]; exact n7 _ (mH.1 hx))
  · exact fun a ha b hb => mQ.2 (by rw [a9_enc_comp]; exact n13 _ (mQ.1 ha) _ (mQ.1 hb))
  · intro a ha
    obtain ⟨B, hB, e⟩ := n14 _ (mQ.1 ha)
    obtain ⟨b, hb, rfl⟩ := a9_ex_enc hQ hB
    exact ⟨b, hb, a9_enc_inj (by rw [a9_enc_comp]; exact e)⟩
  · intro h hh x hx
    have hm : a9enc h ∈ HW.map Prod.fst := n5 ▸ mH.1 hh
    obtain ⟨p, hp, hp1⟩ := List.mem_map.1 hm
    have hxq : a9enc x ∈ (List.range 32).map (a9dec QB) := n5q ▸ mQ.1 hx
    obtain ⟨k, hk, hk1⟩ := List.mem_map.1 hxq
    have e := n15 p hp k hk
    have hY : a9dec QB (p.2 / 32 ^ k % 32) ∈ QN :=
      n5q ▸ List.mem_map_of_mem (List.mem_range.2 (Nat.mod_lt _ (by omega)))
    obtain ⟨y, hy, hyY⟩ := a9_ex_enc hQ hY
    refine ⟨y, hy, a9_enc_inj ?_⟩
    rw [a9_enc_comp, a9_enc_comp, hyY, ← hp1, ← hk1]
    exact e
  · exact fun x hx => a9_enc_inj (by
      rw [a9_enc_sqT, a9_enc_sqT, a9_enc_sqT]; exact n16 _ (mQ.1 hx))
  · intro g hg hc
    rcases n17 _ (mQ.1 hg) (fun H hH' => by
        obtain ⟨h, hh, rfl⟩ := a9_ex_enc hQ hH'
        rw [← a9_enc_comp, ← a9_enc_comp, hc h hh]) with e | e
    · exact Or.inl (a9_enc_inj e)
    · exact Or.inr (a9_enc_inj e)
  · intro a ha b hb
    rcases n18 _ (mQ.1 ha) _ (mQ.1 hb) with e | e
    · exact ⟨tab 1, by simp, a9_enc_inj (by
        rw [a9_enc_comp, a9_enc_comp, a9_enc_comp]; exact e)⟩
    · exact ⟨tab s, by simp, a9_enc_inj (by
        rw [a9_enc_comp, a9_enc_comp, a9_enc_comp]; exact e)⟩
  · obtain ⟨A, hA, B, hB, e⟩ := n19
    obtain ⟨a, ha, rfl⟩ := a9_ex_enc hQ hA
    obtain ⟨b, hb, rfl⟩ := a9_ex_enc hQ hB
    exact ⟨a, ha, b, hb, a9_enc_inj (by rw [a9_enc_comp, a9_enc_comp, a9_enc_comp]; exact e)⟩
  · exact fun x hx => (n20 _ (mQ.1 hx)).imp (fun e => a9_enc_inj (by rw [a9_enc_sqT]; exact e))
      (fun e => a9_enc_inj (by rw [a9_enc_sqT]; exact e))
  · exact fun x hx => a9_enc_inj (by rw [a9_enc_comp, a9_enc_comp]; exact n21 _ (mQ.1 hx))
  · exact fun a ha b hb => mE.2 (by rw [a9_enc_comp]; exact n26 _ (mE.1 ha) _ (mE.1 hb))
  · intro a ha
    obtain ⟨B, hB, e⟩ := n27 _ (mE.1 ha)
    obtain ⟨b, hb, rfl⟩ := a9_ex_enc hE hB
    exact ⟨b, hb, a9_enc_inj (by rw [a9_enc_comp]; exact e)⟩
  · exact fun a ha b hb => a9_enc_inj (by
      rw [a9_enc_comp, a9_enc_comp]; exact n28 _ (mE.1 ha) _ (mE.1 hb))
  · exact fun a ha => a9_enc_inj (by rw [a9_enc_sqT]; exact n29 _ (mE.1 ha))
  · intro g hg
    exact mH.2 (n31 _ (by rw [← hG]; exact List.mem_map_of_mem hg))
  · intro x hx hsq
    rcases n32 _ (mH.1 hx) (by rw [← a9_enc_sqT, ← a9_enc_sqT, ← a9_enc_sqT, hsq]) with
      h | ⟨A, hA, B, hB, hne⟩
    · exact Or.inl (mQ.2 h)
    · right
      obtain ⟨a, ha, rfl⟩ := a9_ex_enc2 hG hA
      obtain ⟨b, hb, rfl⟩ := a9_ex_enc2 hG hB
      refine ⟨a, ha, b, hb, fun e => hne ?_⟩
      have := congrArg a9enc e
      simp only [a9_enc_comp, a9_enc_sqT] at this
      exact this

