      have : 1 < 8 ^ (j + 1) := Nat.one_lt_pow (Nat.succ_ne_zero j) (by omega)
      show (if 1 / 8 ^ (j + 1) < 8 then 0 else 1 / 8 ^ (j + 1) % 8) = 0
      simp only [Nat.div_eq_of_lt this]; rfl
  | x :: l, 0 => by
      have := a9_one_le_enc l; have := x.isLt
      show (if (x.val + 8 * a9enc l) / 8 ^ 0 < 8 then 0 else (x.val + 8 * a9enc l) / 8 ^ 0 % 8)
        = x.val
      rw [pow_zero, Nat.div_one]; split <;> omega
  | x :: l, j + 1 => by
      have := a9_one_le_enc l; have := x.isLt
      have e : (x.val + 8 * a9enc l) / 8 ^ (j + 1) = a9enc l / 8 ^ j := by
        rw [pow_succ, mul_comm (8 ^ j) 8, ← Nat.div_div_eq_div_mul]; congr 1; omega
      show (if (x.val + 8 * a9enc l) / 8 ^ (j + 1) < 8 then 0
        else (x.val + 8 * a9enc l) / 8 ^ (j + 1) % 8) = (l.getD j 0).val
      simp only [e]
      exact a9_getN_enc l j

