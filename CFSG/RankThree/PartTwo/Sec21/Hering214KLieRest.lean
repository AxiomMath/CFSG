open CFSG CFSG.Blueprint
open CFSG.Assembly.LowTwoRank (StatedClassicalModel)
open Hering214

namespace Hering214

@[expose] def IsBarLieRest (X : Type) [Group X] : Prop :=
  StatedClassicalModel X .PSp 3 2 1

@[expose] def Item214BarLieRest : Prop :=
  ∀ (X : Type) [Group X] [Finite X], IsBarLieRest X → ∀ Ē Ū : Subgroup (MulAut X),
    BarData X Ē Ū → EInvFour X Ē

end Hering214

theorem item214BarLieNo3D4_of_rest
    (hrest : Item214BarLieRest) : Item214BarLieNo3D4 := by
  intro X _ _ hX Ē Ū hd
  rcases hX with ⟨n, hn0, hn, hG2 | hSp | hSU⟩ | hU5 | hSp6
  · exact eInvNine_chevalleyG2 hn0 hn hG2 Ē hd.elem3 hd.card9
  · obtain ⟨e⟩ := hSp
    exact eInvNine_of_projSp hn0 hn e Ē hd.elem3 hd.card9
  · obtain ⟨e⟩ := hSU
    exact eInvNine_of_projSU4 hn0 hn e Ē hd.elem3 hd.card9
  · obtain ⟨e⟩ := hU5
    exact EInvNine.of_mulEquiv e eInvNine_projSU_five_four Ē hd.elem3 hd.card9
  · exact hrest X hSp6 Ē Ū hd

theorem item214BarLie_of_rest
    (hrest : Item214BarLieRest) (h3D4 : Item214BarLie3D4') : Item214BarLie :=
  ⟨item214BarLieNo3D4_of_rest hrest, h3D4⟩

end CFSG.RankThree.PartTwo.Sec21
