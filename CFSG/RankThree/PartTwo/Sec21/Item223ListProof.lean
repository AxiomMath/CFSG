theorem blocks_of_oneData [Finite G] (hBlocks : U4TorusBlocks) (h222 : Item222)
    (hKW : KOfWellDefinedAll) {A E U L : Subgroup G} {c : G} (hpair : Sec21Pair G A E U c L)
    {φ ψ : MulAut A} (hφ : φ ∈ dStar A) (hψ : ψ ∈ dStar A) (hne : φ ≠ ψ) {Z : Subgroup G}
    (hKZ : kOf A φ ≤ Z) (hJZ : kOf A ψ ≤ Z) {m m' : ℕ} (hm : OneData A φ Z m)
    (hm' : OneData A ψ Z m') :
    (ψ * φ = φ * ψ → ⁅kOf A φ, kOf A ψ⁆ = ⊥) ∧
      (ψ * φ ≠ φ * ψ →
        (∃ m : ℕ, Nonempty (kOf A φ ≃* projSL 2 (GaloisField 2 m)) ∧
          Nonempty ((kOf A φ ⊔ kOf A ψ : Subgroup G) ≃* SU3 m)) ∧
        Nonempty (Subgroup.closure {φ, ψ} ≃* Equiv.Perm (Fin 3))) := by
  have hAF := hpair.mem_S.1
  have hAe : IsElemAbelian 3 A := hAF.1
  have hAc : ∀ a b : A, a * b = b * a := hAe.1.is_comm.comm
  have hA3 : ∀ a : A, a ^ 3 = 1 := fun a => Subtype.ext (by simpa using hAe.2 a a.2)
  have hK := hKW G A E U c L hpair
  obtain ⟨eZ⟩ := hm.equiv
  obtain ⟨eZ'⟩ := hm'.equiv
  have hm1 := hm.one_lt
  have hm1' := hm'.one_lt
  obtain rfl : m = m' := eq_of_mulEquiv_projSU_four (by omega) (by omega) (eZ.symm.trans eZ')
  set T := A ⊓ Z with hT
  have hdec := hm.decomp
  have hcφ : A ⊓ Subgroup.centralizer (Z : Set G) ≤ fixedInG A φ := by
    rw [← inf_centralizer_kOf_eq h222 hpair hK hφ]
    exact inf_le_inf_left _ (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr hKZ))
  have hcψ : A ⊓ Subgroup.centralizer (Z : Set G) ≤ fixedInG A ψ := by
    rw [← inf_centralizer_kOf_eq h222 hpair hK hψ]
    exact inf_le_inf_left _ (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr hJZ))
  obtain ⟨j, hjK, -, hj⟩ := exists_involution_kOf_wConj_eq h222 hpair hK hφ
  obtain ⟨i, hiJ, -, hi⟩ := exists_involution_kOf_wConj_eq h222 hpair hK hψ
  have hjZ : (j : G) ∈ Z := hKZ hjK
  have hiZ : (i : G) ∈ Z := hJZ hiJ
  have hjT : (j : G) ∈ Subgroup.normalizer (T : Set G) :=
    Subgroup.inf_normalizer_le_normalizer_inf ⟨j.2, Subgroup.le_normalizer hjZ⟩
  have hiT : (i : G) ∈ Subgroup.normalizer (T : Set G) :=
    Subgroup.inf_normalizer_le_normalizer_inf ⟨i.2, Subgroup.le_normalizer hiZ⟩
  have hjφ : wConj A ⟨(j : G), j.2⟩ = φ := hj
  have hiψ : wConj A ⟨(i : G), i.2⟩ = ψ := hi
  have hcTφ : (commOf (wConj A ⟨(j : G), j.2⟩)).map A.subtype ≤ T := by
    rw [hjφ]
    exact le_inf (Subgroup.map_subtype_le _) ((map_commOf_le_kOf h222 hpair hK hφ).trans hKZ)
  have hcTψ : (commOf (wConj A ⟨(i : G), i.2⟩)).map A.subtype ≤ T := by
    rw [hiψ]
    exact le_inf (Subgroup.map_subtype_le _) ((map_commOf_le_kOf h222 hpair hK hψ).trans hJZ)
  obtain ⟨hρ₁, hcomm₁, hfix₁⟩ := restrict_reflection inf_le_left hAc hA3 j.2 hjT
    (by rw [hjφ]; exact hφ.1) hcTφ
  obtain ⟨hρ₂, hcomm₂, hfix₂⟩ := restrict_reflection inf_le_left hAc hA3 i.2 hiT
    (by rw [hiψ]; exact hψ.1) hcTψ
  rw [hjφ] at hcomm₁ hfix₁
  rw [hiψ] at hcomm₂ hfix₂
  set ρ₁ := wConj T ⟨(j : G), hjT⟩ with hρ₁def
  set ρ₂ := wConj T ⟨(i : G), hiT⟩ with hρ₂def
  have hTab : IsElemAbelian 3 T := Sec5.isElemAbelian_of_le hAe inf_le_left
  have hTc : ∀ a b : T, a * b = b * a := hTab.1.is_comm.comm
  have hT27 : Nat.card T = 3 ^ 3 := hm.card_inf
  have hB9 : ∀ ρ : MulAut T, IsReflectionOn ρ → Nat.card (fixedInG T ρ) = 3 ^ 2 := by
    intro ρ hρ
    rw [fixedInG, Subgroup.card_map_of_injective T.subtype_injective]
    have := card_eq_three_mul_card_fixed hTc hρ
    rw [hT27] at this
    omega
  have hB12 : fixedInG T ρ₁ ≠ fixedInG T ρ₂ := by
    intro h
    rw [hfix₁, hfix₂] at h
    have h' := fixedInG_eq_of_inf_eq hdec (Subgroup.map_subtype_le _) (Subgroup.map_subtype_le _)
      hcφ hcψ h
    exact fixedSubgroupOf_ne_of_ne h222 hpair hK hφ hψ hne
      (Subgroup.map_injective A.subtype_injective h')
  have hKB : kOf A φ ≤ Subgroup.centralizer (fixedInG A φ : Set G) :=
    (kOf_le_kZero hK hφ).trans (kZero_le_centralizer A φ)
  have hJB : kOf A ψ ≤ Subgroup.centralizer (fixedInG A ψ : Set G) :=
    (kOf_le_kZero hK hψ).trans (kZero_le_centralizer A ψ)
  have hKB₁ : kOf A φ ≤ Subgroup.centralizer (fixedInG T ρ₁ : Set G) := by
    rw [hfix₁]
    exact hKB.trans (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr inf_le_right))
  have hJB₂ : kOf A ψ ≤ Subgroup.centralizer (fixedInG T ρ₂ : Set G) := by
    rw [hfix₂]
    exact hJB.trans (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr inf_le_right))
  obtain ⟨eK⟩ := hm.kOf_equiv
  obtain ⟨eJ⟩ := hm'.kOf_equiv
  have hKeq : kOf A φ = kZero A φ :=
    kOf_eq_kZero_of_mulEquiv hK hφ (by omega) (fun h => by
      have := hm.odd
      rw [h] at this
      exact (Nat.not_odd_iff_even.mpr even_two) this) eK
  have hJeq : kOf A ψ = kZero A ψ :=
    kOf_eq_kZero_of_mulEquiv hK hψ (by omega) (fun h => by
      have := hm.odd
      rw [h] at this
      exact (Nat.not_odd_iff_even.mpr even_two) this) eJ
  have hnorm₁ : ∀ y ∈ Z ⊓ Subgroup.centralizer (fixedInG T ρ₁ : Set G), ∀ k ∈ kOf A φ,
      y * k * y⁻¹ ∈ kOf A φ := by
    intro y hy k hk
    rw [hfix₁] at hy
    have hyC := mem_centralizer_of_mem_centralizer_inf hdec (Subgroup.map_subtype_le _) hcφ
      hy.1 hy.2
    rw [hKeq] at hk ⊢
    exact (Subgroup.mem_normalizer_iff.mp
      (Item233One.centralizer_le_normalizer_kZero A φ hyC) k).mp hk
  have hnorm₂ : ∀ y ∈ Z ⊓ Subgroup.centralizer (fixedInG T ρ₂ : Set G), ∀ k ∈ kOf A ψ,
      y * k * y⁻¹ ∈ kOf A ψ := by
    intro y hy k hk
    rw [hfix₂] at hy
    have hyC := mem_centralizer_of_mem_centralizer_inf hdec (Subgroup.map_subtype_le _) hcψ
      hy.1 hy.2
    rw [hJeq] at hk ⊢
    exact (Subgroup.mem_normalizer_iff.mp
      (Item233One.centralizer_le_normalizer_kZero A ψ hyC) k).mp hk
  have hcK : (commOf ρ₁).map T.subtype ≤ kOf A φ := by
    rw [hcomm₁]
    exact map_commOf_le_kOf h222 hpair hK hφ
  have hcJ : (commOf ρ₂).map T.subtype ≤ kOf A ψ := by
    rw [hcomm₂]
    exact map_commOf_le_kOf h222 hpair hK hψ
  obtain ⟨hcom, hnc⟩ := hBlocks G Z T (fixedInG T ρ₁) (fixedInG T ρ₂) (kOf A φ) (kOf A ψ) m
    ⟨eZ⟩ hm.one_lt hm.odd inf_le_right hTab hT27 (Subgroup.map_subtype_le _)
    (Subgroup.map_subtype_le _) (hB9 ρ₁ hρ₁) (hB9 ρ₂ hρ₂) hB12 hKZ hJZ hKB₁ hJB₂ hnorm₁ hnorm₂
    ⟨eK⟩ ⟨eJ⟩ ρ₁ ρ₂ hρ₁ hρ₂ rfl rfl hcK hcJ
  have hres : ∀ t : T, (((ρ₁ * ρ₂) t : T) : G) = (((φ * ψ) ⟨t, t.2.1⟩ : A) : G) ∧
      (((ρ₂ * ρ₁) t : T) : G) = (((ψ * φ) ⟨t, t.2.1⟩ : A) : G) := by
    intro t
    rw [← hjφ, ← hiψ]
    exact ⟨rfl, rfl⟩
  have hiff : ρ₁ * ρ₂ = ρ₂ * ρ₁ ↔ ψ * φ = φ * ψ := by
    constructor
    · intro h
      set g : G := ((i : G) * j)⁻¹ * ((j : G) * i) with hg
      have hgZ : g ∈ Z := Z.mul_mem (Z.inv_mem (Z.mul_mem hiZ hjZ)) (Z.mul_mem hjZ hiZ)
      have hgT : ∀ t ∈ T, g * t * g⁻¹ = t := by
        intro t ht
        have h1 := congrArg (fun σ : MulAut T => ((σ ⟨t, ht⟩ : T) : G)) h
        simp only [(hres ⟨t, ht⟩).1, (hres ⟨t, ht⟩).2] at h1
        rw [← hjφ, ← hiψ] at h1
        change (j : G) * ((i : G) * t * (i : G)⁻¹) * (j : G)⁻¹ =
          (i : G) * ((j : G) * t * (j : G)⁻¹) * (i : G)⁻¹ at h1
        calc g * t * g⁻¹ = ((i : G) * j)⁻¹ * ((j : G) * ((i : G) * t * (i : G)⁻¹) * (j : G)⁻¹) *
              ((i : G) * j) := by rw [hg]; group
          _ = ((i : G) * j)⁻¹ * ((i : G) * ((j : G) * t * (j : G)⁻¹) * (i : G)⁻¹) *
              ((i : G) * j) := by rw [h1]
          _ = t := by group
      have hgA := conj_eq_of_conj_eq_on_inf hdec hgZ hgT
      rw [← hjφ, ← hiψ]
      ext b
      change (i : G) * ((j : G) * b * (j : G)⁻¹) * (i : G)⁻¹ =
        (j : G) * ((i : G) * b * (i : G)⁻¹) * (j : G)⁻¹
      have h2 := hgA b b.2
      calc (i : G) * ((j : G) * b * (j : G)⁻¹) * (i : G)⁻¹ =
            ((i : G) * j) * (b : G) * ((i : G) * j)⁻¹ := by group
        _ = ((i : G) * j) * (g * b * g⁻¹) * ((i : G) * j)⁻¹ := by rw [h2]
        _ = (j : G) * ((i : G) * b * (i : G)⁻¹) * (j : G)⁻¹ := by rw [hg]; group
    · intro h
      ext t
      rw [(hres t).1, (hres t).2, h]
  refine ⟨fun h => hcom (hiff.mpr h), fun h => ?_⟩
  have hρ : ρ₁ * ρ₂ ≠ ρ₂ * ρ₁ := fun h' => h (hiff.mp h')
  obtain ⟨⟨eSU⟩, ⟨eS3⟩⟩ := hnc hρ
  obtain ⟨eCl⟩ := nonempty_closure_pair_mulEquiv hdec j i hjZ hiZ hjT hiT
  rw [hj, hi] at eCl
  exact ⟨⟨m, ⟨eK⟩, ⟨eSU⟩⟩, ⟨eCl.trans eS3⟩⟩

end Item223ListProof

