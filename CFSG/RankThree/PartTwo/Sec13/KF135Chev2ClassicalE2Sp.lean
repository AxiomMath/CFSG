section Fixed

variable {k : Type*} [Field k] {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem geom_sum_eq_zero_of_fixed {p : ℕ} {z : Matrix ι ι k} (hz : z ^ p = 1)
    (hfix : ∀ v : ι → k, z *ᵥ v = v → v = 0) : ∑ i ∈ Finset.range p, z ^ i = 0 := by
  have h1 : (z - 1) * ∑ i ∈ Finset.range p, z ^ i = 0 := by
    rw [mul_geom_sum, hz, sub_self]
  set N := ∑ i ∈ Finset.range p, z ^ i with hN
  ext a b
  have hcol : z *ᵥ (N *ᵥ Pi.single b 1) = N *ᵥ Pi.single b 1 := by
    have := congrArg (· *ᵥ Pi.single b 1) h1
    simp only [Matrix.sub_mul, Matrix.one_mul, Matrix.sub_mulVec, Matrix.zero_mulVec,
      sub_eq_zero] at this
    rw [Matrix.mulVec_mulVec]
    exact this
  have h2 := congrFun (hfix _ hcol) a
  rw [Matrix.mulVec_single_one] at h2
  simpa using h2

theorem mulVec_eq_of_pow {p : ℕ} (hp : p.Prime) {y : Matrix ι ι k} (hy : y ^ p = 1) {i : ℕ}
    (hi0 : 0 < i) (hip : i < p) {v : ι → k} (hv : (y ^ i) *ᵥ v = v) : y *ᵥ v = v := by
  have hcop : Nat.Coprime i p := (hp.coprime_iff_not_dvd.2 fun hd => by
    have := Nat.le_of_dvd hi0 hd
    omega).symm
  obtain ⟨a, -, ha⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hp.one_lt
  have hpow : ∀ m : ℕ, ((y ^ i) ^ m) *ᵥ v = v := by
    intro m
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ, ← Matrix.mulVec_mulVec, hv, ih]
  have hy1 : y = (y ^ i) ^ a := by
    rw [← pow_mul, pow_eq_pow_mod (i * a) hy, ha, pow_one]
  rw [hy1]
  exact hpow a

theorem exists_fixed_vector_of_commute [Nonempty ι] {p : ℕ} (hp : p.Prime) (hpk : (p : k) ≠ 0)
    {x y : Matrix ι ι k} (hxy : Commute x y) (hx : x ^ p = 1) (hy : y ^ p = 1) :
    (∃ v : ι → k, v ≠ 0 ∧ y *ᵥ v = v) ∨
      ∃ j < p, ∃ v : ι → k, v ≠ 0 ∧ (x * y ^ j) *ᵥ v = v := by
  by_contra hcon
  push Not at hcon
  obtain ⟨hy0, hxy0⟩ := hcon
  have hyfix : ∀ v : ι → k, y *ᵥ v = v → v = 0 := fun v hv => by
    by_contra hv0
    exact hy0 v hv0 hv
  have hNy : ∀ i ∈ Finset.range p, i ≠ 0 →
      ∑ j ∈ Finset.range p, (y ^ i) ^ j = 0 := fun i hi hi0 =>
    geom_sum_eq_zero_of_fixed (by rw [← pow_mul, mul_comm, pow_mul, hy, one_pow])
      fun v hv => hyfix v (mulVec_eq_of_pow hp hy (Nat.pos_of_ne_zero hi0)
        (Finset.mem_range.1 hi) hv)
  have hNxy : ∀ j ∈ Finset.range p, ∑ i ∈ Finset.range p, (x * y ^ j) ^ i = 0 :=
    fun j hj => geom_sum_eq_zero_of_fixed
      (by rw [(hxy.pow_right j).mul_pow, hx, ← pow_mul, mul_comm, pow_mul, hy, one_pow,
        one_mul])
      fun v hv => by
        by_contra hv0
        exact hxy0 j (Finset.mem_range.1 hj) v hv0 hv
  have hsum : ∑ j ∈ Finset.range p, ∑ i ∈ Finset.range p, (x * y ^ j) ^ i =
      ∑ i ∈ Finset.range p, x ^ i * ∑ j ∈ Finset.range p, (y ^ i) ^ j := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [(hxy.pow_right j).mul_pow, ← pow_mul, ← pow_mul, mul_comm j i]
  have hzero : ∑ j ∈ Finset.range p, ∑ i ∈ Finset.range p, (x * y ^ j) ^ i = 0 :=
    Finset.sum_eq_zero hNxy
  have hp0 : 0 < p := hp.pos
  rw [hsum, Finset.sum_eq_single_of_mem 0 (Finset.mem_range.2 hp0)
    (fun i hi hi0 => by rw [hNy i hi hi0, mul_zero])] at hzero
  simp only [pow_zero, one_pow, Finset.sum_const, Finset.card_range, one_mul] at hzero
  obtain ⟨a⟩ := (inferInstance : Nonempty ι)
  have := congrFun (congrFun hzero a) a
  simp only [Matrix.smul_apply, Matrix.one_apply_eq, Matrix.zero_apply, nsmul_eq_mul,
    mul_one] at this
  exact hpk this

end Fixed

section Transvection

variable {k : Type} [Field k] [CharP k 2] {m : ℕ}

theorem mul_vecMulVec_eq {ι : Type*} [Fintype ι] (M : Matrix ι ι k) (w v : ι → k) :
    M * vecMulVec w v = vecMulVec (M *ᵥ w) v := by
  ext i j
  simp [Matrix.mul_apply, vecMulVec_apply, mulVec, dotProduct, Finset.sum_mul, mul_assoc]

theorem vecMulVec_mul_eq {ι : Type*} [Fintype ι] (w v : ι → k) (M : Matrix ι ι k) :
    vecMulVec w v * M = vecMulVec w (v ᵥ* M) := by
  ext i j
  simp [Matrix.mul_apply, vecMulVec_apply, vecMul, dotProduct, Finset.mul_sum, mul_assoc]

theorem vecMulVec_mul_vecMulVec_eq {ι : Type*} [Fintype ι] (a b c d : ι → k) :
    vecMulVec a b * vecMulVec c d = (b ⬝ᵥ c) • vecMulVec a d := by
  ext i j
  simp only [Matrix.mul_apply, vecMulVec_apply, dotProduct, Matrix.smul_apply, smul_eq_mul,
    Finset.sum_mul]
  refine Finset.sum_congr rfl fun l _ => ?_
  ring

local notation "Jm" => (fromBlocks 0 1 (-1) 0 : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) k)

theorem matrix_neg_eq_char_two {ι ι' : Type*} (M : Matrix ι ι' k) : -M = M := by
  ext i j
  rw [Matrix.neg_apply, CharTwo.neg_eq]

theorem matrix_add_self_char_two {ι ι' : Type*} (M : Matrix ι ι' k) : M + M = 0 := by
  ext i j
  rw [Matrix.add_apply, CharTwo.add_self_eq_zero, Matrix.zero_apply]

theorem sympJ_transpose : (Jm)ᵀ = (Jm : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) k) := by
  rw [fromBlocks_transpose, transpose_zero, transpose_one, transpose_neg, transpose_one,
    matrix_neg_eq_char_two]

theorem sympJ_mul_self : (Jm : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) k) * Jm = 1 := by
  rw [fromBlocks_multiply]
  simp only [Matrix.zero_mul, Matrix.mul_zero, zero_add, add_zero, Matrix.one_mul,
    Matrix.mul_one, Matrix.mul_neg, Matrix.neg_mul, neg_zero]
  rw [matrix_neg_eq_char_two, fromBlocks_one]

theorem sympJ_alt (v : Fin m ⊕ Fin m → k) : (v ᵥ* Jm) ⬝ᵥ v = 0 := by
  rw [← Matrix.dotProduct_mulVec]
  exact CFSG.RankThree.PartOne.LIT.sympForm_alt m v

@[expose] noncomputable def spTransv (v : Fin m ⊕ Fin m → k) :
    Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) k :=
  1 + vecMulVec v (v ᵥ* Jm)

theorem spTransv_mul_self (v : Fin m ⊕ Fin m → k) : spTransv v * spTransv v = 1 := by
  rw [spTransv, add_mul, mul_add, mul_add, Matrix.one_mul, Matrix.mul_one, Matrix.one_mul,
    vecMulVec_mul_vecMulVec_eq, sympJ_alt, zero_smul, add_zero, add_assoc,
    matrix_add_self_char_two, add_zero]

theorem spTransv_transpose_mul (v : Fin m ⊕ Fin m → k) :
    (spTransv v)ᵀ * Jm * spTransv v = Jm := by
  set u := v ᵥ* Jm with hu
  have hJv : Jm *ᵥ v = u := by
    rw [hu, ← Matrix.vecMul_transpose, sympJ_transpose]
  rw [spTransv, ← hu, transpose_add, transpose_one, transpose_vecMulVec, add_mul, Matrix.one_mul,
    vecMulVec_mul_eq, ← hu, add_mul, mul_add, mul_add, Matrix.mul_one, mul_vecMulVec_eq, hJv,
    Matrix.mul_one, vecMulVec_mul_vecMulVec_eq, hu, sympJ_alt, zero_smul, add_zero, ← hu]
  rw [add_assoc, matrix_add_self_char_two, add_zero]

theorem spTransv_commute {z : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) k}
    (hz : zᵀ * Jm * z = Jm) {v : Fin m ⊕ Fin m → k} (hv : z *ᵥ v = v) :
    z * spTransv v = spTransv v * z := by
  have hu : (v ᵥ* Jm) ᵥ* z = v ᵥ* Jm := by
    rw [Matrix.vecMul_vecMul]
    conv_lhs => rw [← hv]
    rw [← Matrix.vecMul_transpose, Matrix.vecMul_vecMul, ← Matrix.mul_assoc, hz]
  rw [spTransv, mul_add, add_mul, Matrix.mul_one, Matrix.one_mul, mul_vecMulVec_eq, hv,
    vecMulVec_mul_eq, hu]

theorem spTransv_ne_one {v : Fin m ⊕ Fin m → k} (hv : v ≠ 0) : spTransv v ≠ 1 := by
  intro h
  have h0 : vecMulVec v (v ᵥ* Jm) = 0 := by
    have := congrArg (· - 1) h
    simpa [spTransv] using this
  have hu : v ᵥ* Jm ≠ 0 := by
    intro hu
    apply hv
    calc v = v ᵥ* (Jm * Jm) := by rw [sympJ_mul_self, Matrix.vecMul_one]
      _ = (v ᵥ* Jm) ᵥ* Jm := by rw [Matrix.vecMul_vecMul]
      _ = 0 := by rw [hu, Matrix.zero_vecMul]
  obtain ⟨a, ha⟩ := Function.ne_iff.1 hv
  obtain ⟨b, hb⟩ := Function.ne_iff.1 hu
  have := congrFun (congrFun h0 a) b
  rw [vecMulVec_apply, Matrix.zero_apply] at this
  exact (mul_ne_zero ha hb) this

end Transvection

section PSp4

variable {k : Type} [Field k] [Finite k] [CharP k 2]

open CFSG.Open (StatedProj StatedSp StatedScalars)

theorem exists_involution_commute_psp4 {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {B : Subgroup (StatedProj (StatedSp 2 k))} (hB : CFSG.Open.IsElemAbelian p B)
    (hBc : p ^ 2 ≤ Nat.card B) :
    ∃ t ∈ B, t ≠ 1 ∧ ∃ s : StatedProj (StatedSp 2 k), s ≠ 1 ∧ s * s = 1 ∧ s * t = t * s := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  set H := StatedSp 2 k with hH
  set N := (StatedScalars (Fin 2 ⊕ Fin 2) k).subgroupOf H with hN
  set π : H →* StatedProj H := QuotientGroup.mk' N with hπ
  have hker : ∀ z ∈ π.ker, z = 1 := by
    intro z hz
    rw [hπ, QuotientGroup.ker_mk', hN, Subgroup.mem_subgroupOf] at hz
    obtain ⟨c, hc⟩ := hz
    have hc2 : c ^ 2 = 1 := (CFSG.Open.StatedAPI.scalar_mem_statedSp_iff (n := 2) (by norm_num)
      c).1 (hc ▸ z.2)
    have hc1 : c = 1 := Units.ext (CFSG.RankThree.PartTwo.Census.eq_one_of_mul_self_eq_one
      (by rw [← Units.val_mul, ← sq, hc2, Units.val_one]))
    apply Subtype.ext
    rw [← hc, hc1, map_one]
    rfl
  obtain ⟨Et, hEtmap, hEtinj, hEtab, hEtcard⟩ :=
    CFSG.StandardType.TableBUE.exists_lift_of_noTorsion π (QuotientGroup.mk'_surjective N) hp
      (fun z hz _ => hker z hz) hB
  have hEtc : p ^ 2 ≤ Nat.card Et := hEtcard ▸ hBc
  have hcardpos : 1 < Nat.card Et := by
    have : 1 < p ^ 2 := Nat.one_lt_pow (by norm_num) hp.one_lt
    omega
  obtain ⟨⟨x, hxE⟩, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1
    ((Subgroup.one_lt_card_iff_ne_bot _).1 hcardpos)
  have hx1' : x ≠ 1 := fun h => hx1 (Subtype.ext h)
  have hzx : Nat.card (Subgroup.zpowers x) = p := by
    rw [Nat.card_zpowers, orderOf_eq_prime (hEtab.2 x hxE) hx1']
  obtain ⟨y, hyE, hyx⟩ : ∃ y ∈ Et, y ∉ Subgroup.zpowers x := by
    by_contra hcon
    push Not at hcon
    have hle : Et ≤ Subgroup.zpowers x := hcon
    have := Subgroup.card_le_of_le hle
    rw [hzx] at this
    have : p < p ^ 2 := by
      calc p = p ^ 1 := (pow_one p).symm
        _ < p ^ 2 := Nat.pow_lt_pow_right hp.one_lt (by norm_num)
    omega
  have hy1 : y ≠ 1 := fun h => hyx (h ▸ Subgroup.one_mem _)
  have hcomm : x * y = y * x := congrArg Subtype.val (hEtab.1.is_comm.comm ⟨x, hxE⟩ ⟨y, hyE⟩)
  set X : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k :=
    Units.val ((x : H) : GL (Fin 2 ⊕ Fin 2) k) with hX
  set Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k :=
    Units.val ((y : H) : GL (Fin 2 ⊕ Fin 2) k) with hY
  have hXY : Commute X Y := by
    change X * Y = Y * X
    rw [hX, hY, ← Units.val_mul, ← Units.val_mul, ← Subgroup.coe_mul, ← Subgroup.coe_mul, hcomm]
  have hpowM : ∀ (w : H) (j : ℕ), (((w ^ j : H) : GL (Fin 2 ⊕ Fin 2) k) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k) = ((w : H) : GL (Fin 2 ⊕ Fin 2) k) ^ j :=
    fun w j => by rw [Subgroup.coe_pow, Units.val_pow_eq_pow_val]
  have hXp : X ^ p = 1 := by rw [hX, ← hpowM, hEtab.2 x hxE]; rfl
  have hYp : Y ^ p = 1 := by rw [hY, ← hpowM, hEtab.2 y hyE]; rfl
  have hpk : (p : k) ≠ 0 := CFSG.RankThree.PartOne.LIT.natCast_ne_zero_of_charTwo hp hp2
  obtain ⟨z, hzE, hz1, v, hv0, hzv⟩ : ∃ z ∈ Et, z ≠ 1 ∧ ∃ v : Fin 2 ⊕ Fin 2 → k, v ≠ 0 ∧
      (((z : H) : GL (Fin 2 ⊕ Fin 2) k) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k) *ᵥ v = v := by
    rcases exists_fixed_vector_of_commute hp hpk hXY hXp hYp with ⟨v, hv0, hv⟩ |
      ⟨j, hj, v, hv0, hv⟩
    · exact ⟨y, hyE, hy1, v, hv0, hv⟩
    · refine ⟨x * y ^ j, mul_mem hxE (pow_mem hyE j), ?_, v, hv0, ?_⟩
      · intro h1
        have hxy : x = (y ^ j)⁻¹ := eq_inv_of_mul_eq_one_left h1
        have hzy : Nat.card (Subgroup.zpowers y) = p := by
          rw [Nat.card_zpowers, orderOf_eq_prime (hEtab.2 y hyE) hy1]
        have hle : Subgroup.zpowers x ≤ Subgroup.zpowers y := by
          rw [Subgroup.zpowers_le, hxy]
          exact inv_mem (pow_mem (Subgroup.mem_zpowers y) j)
        have heq := Subgroup.eq_of_le_of_card_ge hle (by rw [hzx, hzy])
        exact hyx (heq ▸ Subgroup.mem_zpowers y)
      · rw [Subgroup.coe_mul, Units.val_mul, hpowM]
        exact hv
  set sM := spTransv (m := 2) v with hsM
  have hs2 : sM * sM = 1 := spTransv_mul_self v
  set sG : GL (Fin 2 ⊕ Fin 2) k := ⟨sM, sM, hs2, hs2⟩ with hsG
  have hsH : sG ∈ H := CFSG.Open.StatedAPI.mem_statedSp_iff.2 (spTransv_transpose_mul v)
  set s : H := ⟨sG, hsH⟩ with hs
  have hzS : (((z : H) : GL (Fin 2 ⊕ Fin 2) k) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k)ᵀ *
      fromBlocks 0 1 (-1) 0 * (((z : H) : GL (Fin 2 ⊕ Fin 2) k) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k) = fromBlocks 0 1 (-1) 0 :=
    CFSG.Open.StatedAPI.mem_statedSp_iff.1 (z : H).2
  have hzs : z * s = s * z := by
    apply Subtype.ext
    apply Units.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul, Units.val_mul, Units.val_mul]
    exact spTransv_commute hzS hzv
  refine ⟨π z, ?_, ?_, π s, ?_, ?_, ?_⟩
  · rw [← hEtmap]
    exact ⟨z, hzE, rfl⟩
  · intro h1
    exact hz1 (hEtinj z hzE h1)
  · intro h1
    have := hker s h1
    apply spTransv_ne_one (m := 2) hv0
    have := congrArg (fun w : H => (((w : H) : GL (Fin 2 ⊕ Fin 2) k) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) k)) this
    simpa [hs, hsG] using this
  · rw [← map_mul]
    have : s * s = 1 := Subtype.ext (Units.ext hs2)
    rw [this, map_one]
  · rw [← map_mul, ← map_mul, hzs]

end PSp4

section MainSp

variable {K : Type} [Field K] [Finite K] [CharP K 2]

open CFSG.Open (StatedProj StatedSp)
open CFSG.RankThree.PartOne.OutStructure (OutPChain)
open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (conjAut fieldAut gsp statedSp_le_gsp)
open CFSG.ComponentClassification.UnbalancedCatalog (descentField)
open CFSG.ComponentClassification.UnbalancedCatalog.SpChain (exceptionalAut spInner)

theorem false_of_e2_psp4 {n p e : ℕ} (hK : Nat.card K = 2 ^ n) (hn : 1 ≤ n) (hp : p.Prime)
    (hp7 : 7 ≤ p)
    (hshape : CFSG.RankThree.PartOne.K1214.SylowShape p 2 e (StatedProj (StatedSp 2 K)))
    (he : 2 ≤ e) (hout : OutPChain p (StatedProj (StatedSp 2 K)))
    {P : Subgroup (MulAut (StatedProj (StatedSp 2 K)))} (hP : IsPGroup p P)
    (hexp : ∀ y ∈ P, y ^ p = 1) (hcard : p ^ 3 ≤ Nat.card P)
    (h2b : H2bFor (StatedProj (StatedSp 2 K)) p P) {α : MulAut (StatedProj (StatedSp 2 K))}
    (hαP : α ∈ P)
    (hαI : α ∉ (MulAut.conj : StatedProj (StatedSp 2 K) →* MulAut (StatedProj (StatedSp 2 K))).range) :
    False := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  have hp2 : p ≠ 2 := by omega
  obtain ⟨Fr, hFr, hord, hzp, -, -⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_automorphism_fixed_field_cardinality
      Nat.prime_two hn hK
  obtain ⟨-, hall, -, -, -, -, -, -, hγI, -⟩ :=
    CFSG.ComponentClassification.UnbalancedCatalog.SpChain.exceptionalAut_structure hn hFr hord hzp
  obtain ⟨⟨g, j⟩, hαgj, -⟩ := hall α
  have hginn : spInner 2 K g ∈
      CFSG.ComponentClassification.OuterAutomorphisms.inner (StatedProj (StatedSp 2 K)) :=
    ⟨_, (CFSG.ComponentClassification.UnbalancedCatalog.SpChain.spInner_eq_conj g).symm⟩
  have hj2 : 2 ∣ (j : ℕ) := by
    set q := QuotientGroup.mk'
      (CFSG.ComponentClassification.OuterAutomorphisms.inner (StatedProj (StatedSp 2 K))) with hq
    have hqi : q (spInner 2 K g) = 1 := (QuotientGroup.eq_one_iff _).2 hginn
    have h1 : q α = q (exceptionalAut K) ^ (j : ℕ) := by
      rw [hαgj, map_mul, hqi, one_mul, map_pow]
    have h2 : q (exceptionalAut K ^ ((j : ℕ) * p)) = 1 := by
      rw [map_pow, pow_mul, ← h1, ← map_pow, hexp α hαP, map_one]
    have h3 := (hγI _).1 ((QuotientGroup.eq_one_iff _).1 h2)
    have h5 : 2 ∣ (j : ℕ) * p := (Dvd.intro n rfl).trans h3
    rcases (Nat.Prime.dvd_mul Nat.prime_two).1 h5 with h | h
    · exact h
    · exact absurd ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).1 h).symm hp2
  obtain ⟨i, hi⟩ := hj2
  set σ : K ≃+* K := Fr ^ i with hσdef
  have hγj : exceptionalAut K ^ (j : ℕ) = fieldAut 2 K σ := by
    rw [hi, pow_mul, CFSG.ComponentClassification.UnbalancedCatalog.SpChain.exceptionalAut_sq hFr,
      map_pow]
  set A : gsp 2 K := ⟨g, statedSp_le_gsp g.2⟩ with hA
  have hαA : α = conjAut 2 K A * fieldAut 2 K σ := by
    rw [hαgj, hγj, CFSG.ComponentClassification.UnbalancedCatalog.SpChain.spInner_apply]
  have hσ1 : σ ≠ 1 := by
    intro hσ
    apply hαI
    have : α = spInner 2 K g := by
      rw [hαA, hσ, map_one, mul_one, CFSG.ComponentClassification.UnbalancedCatalog.SpChain.spInner_apply]
    rw [this]
    exact hginn
  have hαp : (conjAut 2 K A * fieldAut 2 K σ) ^ p = 1 := by
    rw [← hαA]
    exact hexp α hαP
  obtain ⟨hσo, H, hH⟩ := CFSG.StandardType.RecipeFieldSpU.conjAut_mul_fieldAut_of_pow_eq_one
    (r := 2) (by norm_num) hp A σ hσ1 hαp
  set β : MulAut (StatedProj (StatedSp 2 K)) := conjAut 2 K H with hβ
  set a : MulAut (StatedProj (StatedSp 2 K)) := fieldAut 2 K σ with ha
  have hαβ : α = β * a * β⁻¹ := by rw [hαA, hH]
  set P' := P.map (MulAut.congr (β⁻¹ : StatedProj (StatedSp 2 K) ≃* StatedProj (StatedSp 2 K))).toMonoidHom
    with hP'
  have hcongr : ∀ ψ : MulAut (StatedProj (StatedSp 2 K)),
      MulAut.congr (β⁻¹ : StatedProj (StatedSp 2 K) ≃* StatedProj (StatedSp 2 K)) ψ =
        β⁻¹ * ψ * β := fun ψ => by
    ext y
    simp [MulAut.congr_apply, MulAut.mul_apply]
  have haP' : a ∈ P' := ⟨α, hαP, by
    change MulAut.congr (β⁻¹ : StatedProj (StatedSp 2 K) ≃* StatedProj (StatedSp 2 K)) α = a
    rw [hcongr, hαβ]
    group⟩
  have hexp' : ∀ y ∈ P', y ^ p = 1 := by
    rintro _ ⟨z, hz, rfl⟩
    rw [← map_pow, hexp z hz, map_one]
  have hP'p : IsPGroup p P' := hP.map _
  have hcard' : p ^ 3 ≤ Nat.card P' := by
    rw [hP', Subgroup.card_map_of_injective
      (MulAut.congr (β⁻¹ : StatedProj (StatedSp 2 K) ≃* StatedProj (StatedSp 2 K))).injective]
    exact hcard
  have h2b' : H2bFor (StatedProj (StatedSp 2 K)) p P' :=
    h2b.map_congr (β⁻¹ : StatedProj (StatedSp 2 K) ≃* StatedProj (StatedSp 2 K))
  have haI : a ∉ (MulAut.conj : StatedProj (StatedSp 2 K) →*
      MulAut (StatedProj (StatedSp 2 K))).range := by
    rintro ⟨x, hx⟩
    apply hαI
    refine ⟨β x, ?_⟩
    rw [hαβ, ← hx]
    ext y
    simp [MulAut.mul_apply, MulAut.conj_apply]
  obtain ⟨-, -, hTs, hTn, -⟩ :=
    CFSG.RankThree.CASymplecticSubfield.symplectic_prime_subfield_fixed_group_and_full_centralizer
      Nat.prime_two hp (by omega) hp2 hn (le_refl 2) hK σ hσo
  have hinj : Function.Injective (MulAut.conj : StatedProj (StatedSp 2 K) →*
      MulAut (StatedProj (StatedSp 2 K))) := by
    refine conj_injective_of_simple hTs fun hc => ?_
    obtain ⟨x, y, hxy⟩ := hTn
    exact hxy (hc x y)
  have hodd : Odd (orderOf σ) := hσo ▸ hp.odd_of_ne_two hp2
  set jj := CFSG.RankThree.CASymplecticSubfield.subfieldSpProj 2 (descentField σ) with hjj
  have hjinj : Function.Injective jj :=
    CFSG.RankThree.CASymplecticSubfield.subfieldSpProj_injective (by norm_num) _
  haveI : CharP (descentField σ) 2 :=
    (algebraMap (descentField σ) K).charP (algebraMap (descentField σ) K).injective 2
  refine false_of_e2_core hp (by omega) hinj hshape he hout hP'p hexp' hcard' h2b' haP' haI ?_
  intro B hBab hBcard haB
  have hBj : ∀ t ∈ B, t ∈ jj.range := fun t ht =>
    (CFSG.RankThree.CASymplecticSubfield.fieldAut_apply_eq_self_iff (by norm_num) hodd t).1
      (haB t ht)
  set B₀ := B.comap jj with hB₀
  have hB₀card : p ^ 2 ≤ Nat.card B₀ := by
    have hmap : B₀.map jj = B := Subgroup.map_comap_eq_self fun t ht => hBj t ht
    rw [← Subgroup.card_map_of_injective hjinj, hmap]
    exact hBcard
  have hB₀ab : CFSG.Open.IsElemAbelian p B₀ := by
    refine ⟨⟨⟨fun x y => Subtype.ext (hjinj ?_)⟩⟩, fun x hx => hjinj ?_⟩
    · rw [Subgroup.coe_mul, Subgroup.coe_mul, map_mul, map_mul]
      exact congrArg Subtype.val (hBab.1.is_comm.comm ⟨_, x.2⟩ ⟨_, y.2⟩)
    · rw [map_pow, map_one]
      exact hBab.2 _ hx
  obtain ⟨t₀, ht₀B, ht₀1, s₀, hs₀1, hs₀2, hs₀t₀⟩ :=
    exists_involution_commute_psp4 (k := descentField σ) hp hp2 hB₀ab hB₀card
  refine ⟨jj t₀, ht₀B, fun h1 => ht₀1 (hjinj (by rw [h1, map_one])), jj s₀,
    fun h1 => hs₀1 (hjinj (by rw [h1, map_one])), by rw [← map_mul, hs₀2, map_one], ?_, ?_⟩
  · exact (CFSG.RankThree.CASymplecticSubfield.fieldAut_apply_eq_self_iff (by norm_num) hodd
      _).2 ⟨s₀, rfl⟩
  · rw [← map_mul, ← map_mul, hs₀t₀]

end MainSp

section FamilySp

variable {S : Type} [Group S] [Finite S] {p : ℕ} {P : Subgroup (MulAut S)} {x u : MulAut S}
  {V : Subgroup (MulAut S)}

open CFSG.Assembly.RankThreeEven (projSp)
open CFSG.RankThree.PartOne.OutStructure (OutPChain)

theorem false_of_kF135Hyp_projSp_two_e2 {n : ℕ} (hn : 1 ≤ n)
    (e : S ≃* projSp 2 (GaloisField 2 n))
    (h : CFSG.RankThree.PartTwo.Sec13.KF135Proof.KF135Hyp S p P x u V) (hpn : p ∣ n)
    (hx : ((2 ^ n : ℕ) : ZMod p) = -1) : False := by
  have hp := h.prime
  have hp7 := h.seven_le
  have hp2 : p ≠ 2 := by omega
  haveI : Fact p.Prime := ⟨hp⟩
  have hn7 : p ≤ n := Nat.le_of_dvd (by omega) hpn
  have hn2 : 2 ≤ n := by omega
  by_cases hinn : P ≤ (MulAut.conj : S →* MulAut S).range
  · exact KF135Chev2Exc.false_of_rankLE2_inner h hinn
      ((rankLE2_projSp_two hp hp2 (natCast_ne_zero_galoisField hp hp2)).of_mulEquiv e.symm)
      (fun Q => CFSG.LocalAnalysis.RankFourTheoremC.isMulCommutative_sylow_of_mulEquiv e
        (isMulCommutative_sylow_projSp_two hn2 hp hp2 hx) Q)
  obtain ⟨φ, hφP, hφI⟩ := SetLike.not_le_iff_exists.1 hinn
  set K := GaloisField 2 n
  set eT : CFSG.Open.StatedProj (CFSG.Open.StatedSp 2 K) ≃* projSp 2 K :=
    (CFSG.PGLModel.projSpEquivStatedProj 2 K).symm with heT
  set ε : S ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSp 2 K) := e.trans eT.symm with hε
  have hne := CFSG.RankThree.PartTwo.Sec13.F135Last.two_pow_ne_of_two_le' hn2
  have hlie := CFSG.RankThree.PartTwo.Sec4.Census.lieModel_projSp (n := 2) (p := 2) (e := n)
    ⟨Nat.prime_two, by omega, le_refl 2, fun h => hne.1 (Prod.mk.inj h).2⟩
  have hout : OutPChain p (CFSG.Open.StatedProj (CFSG.Open.StatedSp 2 K)) :=
    CFSG.RankThree.PartTwo.Sec13.F135Last.chain_psp eT hp hp7 hlie (by norm_num) (fun _ => rfl)
  have hX := CFSG.RankThree.PartTwo.Sec13.F135Last.stated_of_lieModel eT hlie (by norm_num)
  have hpq : p ∣ 2 ^ n + 1 := dvd_two_pow_add_one_iff.2 hx
  have h0 : 2 ^ n + 1 ≠ 0 := by positivity
  have he2 := two_le_factorization_two_pow_add_one hp hp2 hpn hpq
  have hshape := CFSG.RankThree.PartOne.K1214.sylowShape_of_psp4Model hp hp2 (by omega)
    (Nat.ordProj_mul_ordCompl_eq_self (2 ^ n + 1) p).symm (Nat.not_dvd_ordCompl hp h0) hX
  set PT := P.map (MulAut.congr ε).toMonoidHom with hPT
  have hexpT : ∀ y ∈ PT, y ^ p = 1 := by
    rintro _ ⟨z, hz, rfl⟩
    rw [← map_pow, h.exponent z hz, map_one]
  have hcardT : p ^ 3 ≤ Nat.card PT := by
    rw [hPT, Subgroup.card_map_of_injective (MulAut.congr ε).injective]
    exact h.card
  have h2bT : H2bFor (CFSG.Open.StatedProj (CFSG.Open.StatedSp 2 K)) p PT :=
    (show H2bFor S p P from h.h2b).map_congr ε
  refine false_of_e2_psp4 (K := K) (GaloisField.card 2 n (by omega)) hn hp hp7 hshape he2 hout
    (h.pgroup.map _) hexpT hcardT h2bT (α := MulAut.congr ε φ) ⟨φ, hφP, rfl⟩ ?_
  rintro ⟨g, hg⟩
  apply hφI
  refine ⟨ε.symm g, ?_⟩
  apply (MulAut.congr ε).injective
  rw [← hg]
  have := CFSG.ComponentClassification.OuterAutomorphisms.congr_conj ε (ε.symm g)
  rw [MulEquiv.apply_symm_apply] at this
  exact this

theorem false_of_kF135Hyp_projSp_two {n : ℕ} (hn : 1 ≤ n) (e : S ≃* projSp 2 (GaloisField 2 n))
    (h : CFSG.RankThree.PartTwo.Sec13.KF135Proof.KF135Hyp S p P x u V) : False := by
  by_cases hE2 : p ∣ n ∧ ((2 ^ n : ℕ) : ZMod p) = -1
  · exact false_of_kF135Hyp_projSp_two_e2 hn e h hE2.1 hE2.2
  · exact false_of_kF135Hyp_projSp_two_of_not_e2 hn e h hE2

end FamilySp

