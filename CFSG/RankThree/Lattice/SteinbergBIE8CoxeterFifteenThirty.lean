theorem e8Coxeter_eq : e8Coxeter = toMat Tag.E8.rank e8CoxeterList :=
  wordMat_eq_toMat .E8 _ (by decide +kernel)

theorem e8Coxeter_sq_eq : e8Coxeter ^ 2 = toMat Tag.E8.rank e8CoxeterSqList := by
  rw [e8Coxeter_eq, ← toMat_lpow]
  exact congrArg (toMat Tag.E8.rank) (by decide +kernel)

theorem isUnit_det_e8Coxeter : IsUnit (toMat Tag.E8.rank e8CoxeterList).det :=
  isUnit_det_of_lmul_eq_lid (N := lpow Tag.E8.rank e8CoxeterList 29) (by decide +kernel)

theorem isUnit_det_e8CoxeterSq : IsUnit (toMat Tag.E8.rank e8CoxeterSqList).det :=
  isUnit_det_of_lmul_eq_lid (N := lpow Tag.E8.rank e8CoxeterSqList 14) (by decide +kernel)

theorem isUnit_det_orbitMat_e8Coxeter :
    ∀ α, IsRoot .E8 α → IsUnit (orbitMat (toMat Tag.E8.rank e8CoxeterList) α Tag.E8.rank).det :=
  isUnit_det_orbitMat_of_certs e8CoxeterCerts 30 isUnit_det_e8Coxeter (by decide +kernel)
    (by decide +kernel)

theorem isUnit_det_orbitMat_e8CoxeterSq :
    ∀ α, IsRoot .E8 α → IsUnit (orbitMat (toMat Tag.E8.rank e8CoxeterSqList) α Tag.E8.rank).det :=
  isUnit_det_orbitMat_of_certs e8CoxeterSqCerts 15 isUnit_det_e8CoxeterSq (by decide +kernel)
    (by decide +kernel)

theorem e8_basis_isRoot : IsRoot .E8 (toVec Tag.E8.rank [1, 0, 0, 0, 0, 0, 0, 0]) :=
  isRoot_toVec (by decide +kernel)

theorem E8_fifteen_thirty_Coxeter_cyclic_lattices :
    orderOf e8Coxeter = 30 ∧ orderOf (e8Coxeter ^ 2) = 15 ∧
    e8Coxeter.charpoly = X ^ 8 + X ^ 7 - X ^ 5 - X ^ 4 - X ^ 3 + X + 1 ∧
    (e8Coxeter ^ 2).charpoly = X ^ 8 - X ^ 7 + X ^ 5 - X ^ 4 + X ^ 3 - X + 1 ∧
    ∀ w ∈ [e8Coxeter, e8Coxeter ^ 2], ∀ α : Fin Tag.E8.rank → ℤ, IsRoot .E8 α →
      (LinearIndependent ℤ (fun j : Fin Tag.E8.rank => (w ^ (j : ℕ)) *ᵥ α) ∧
        Submodule.span ℤ (Set.range fun j : Fin Tag.E8.rank => (w ^ (j : ℕ)) *ᵥ α) = ⊤) ∧
      ((orbitMat w α Tag.E8.rank).det = 1 ∨ (orbitMat w α Tag.E8.rank).det = -1) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [e8Coxeter_eq]
    exact orderOf_toMat_eq (by norm_num) (by decide +kernel) (by decide +kernel)
  · rw [e8Coxeter_sq_eq]
    exact orderOf_toMat_eq (by norm_num) (by decide +kernel) (by decide +kernel)
  · rw [e8Coxeter_eq]
    exact charpoly_eq_of_lists (cs := [1, 1, 0, -1, -1, -1, 0, 1, 1]) (by monicity!)
      (by compute_degree!) (by simp [polyOfList]; ring) (by decide +kernel) _
      (isUnit_det_orbitMat_e8Coxeter _ e8_basis_isRoot)
  · rw [e8Coxeter_sq_eq]
    exact charpoly_eq_of_lists (cs := [1, -1, 0, 1, -1, 1, 0, -1, 1]) (by monicity!)
      (by compute_degree!) (by simp [polyOfList]; ring) (by decide +kernel) _
      (isUnit_det_orbitMat_e8CoxeterSq _ e8_basis_isRoot)
  · intro w hw α hα
    have hunit : IsUnit (orbitMat w α Tag.E8.rank).det := by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hw
      rcases hw with rfl | rfl
      · rw [e8Coxeter_eq]
        exact isUnit_det_orbitMat_e8Coxeter α hα
      · rw [e8Coxeter_sq_eq]
        exact isUnit_det_orbitMat_e8CoxeterSq α hα
    exact ⟨(isBasis_iff_isUnit_det w α).2 hunit, Int.isUnit_iff.1 hunit⟩

end CFSG.RankThree.Lattice
