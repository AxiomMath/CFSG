theorem e8W20_eq : e8W20 = toMat Tag.E8.rank e8W20List :=
  wordMat_eq_toMat .E8 _ (by decide +kernel)

theorem e8W24_eq : e8W24 = toMat Tag.E8.rank e8W24List :=
  wordMat_eq_toMat .E8 _ (by decide +kernel)

theorem isUnit_det_e8W20 : IsUnit (toMat Tag.E8.rank e8W20List).det :=
  isUnit_det_of_lmul_eq_lid (N := lpow Tag.E8.rank e8W20List 19) (by decide +kernel)

theorem isUnit_det_e8W24 : IsUnit (toMat Tag.E8.rank e8W24List).det :=
  isUnit_det_of_lmul_eq_lid (N := lpow Tag.E8.rank e8W24List 23) (by decide +kernel)

theorem natAbs_det_orbitMat_e8W20 : ∀ α, IsRoot .E8 α →
    (orbitMat (toMat Tag.E8.rank e8W20List) α Tag.E8.rank).det.natAbs ∈ [1, 5] :=
  natAbs_det_orbitMat_mem_of_certs e8W20Certs 20 isUnit_det_e8W20 (by decide +kernel) _
    (by decide +kernel)

theorem natAbs_det_orbitMat_e8W24 : ∀ α, IsRoot .E8 α →
    (orbitMat (toMat Tag.E8.rank e8W24List) α Tag.E8.rank).det.natAbs ∈ [1, 4, 9] :=
  natAbs_det_orbitMat_mem_of_certs e8W24Certs 24 isUnit_det_e8W24 (by decide +kernel) _
    (by decide +kernel)

theorem e8_e₁_eq : (Pi.single 0 1 : Fin Tag.E8.rank → ℤ) =
    toVec Tag.E8.rank [1, 0, 0, 0, 0, 0, 0, 0] := by
  decide +kernel

theorem isUnit_det_orbitMat_e8W_e₁ :
    IsUnit (orbitMat (toMat Tag.E8.rank e8W20List) (Pi.single 0 1) Tag.E8.rank).det ∧
      IsUnit (orbitMat (toMat Tag.E8.rank e8W24List) (Pi.single 0 1) Tag.E8.rank).det := by
  rw [e8_e₁_eq, orbitMat_eq_toMat, orbitMat_eq_toMat]
  exact ⟨isUnit_det_of_lmul_eq_lid (N := e8W20E₁Inv) (by decide +kernel),
    isUnit_det_of_lmul_eq_lid (N := e8W24E₁Inv) (by decide +kernel)⟩

theorem index_span_orbit {n : ℕ} (w : Matrix (Fin n) (Fin n) ℤ) (α : Fin n → ℤ)
    (h : (orbitMat w α n).det ≠ 0) :
    (Submodule.span ℤ (Set.range fun j : Fin n => (w ^ (j : ℕ)) *ᵥ α)).toAddSubgroup.index =
      (orbitMat w α n).det.natAbs := by
  rw [← orbitLattice_eq_span_of_charpoly, index_orbitLattice w α h]

theorem E8_twenty_twenty_four_explicit_cyclic_lattices :
    orderOf e8W20 = 20 ∧ orderOf e8W24 = 24 ∧
    e8W20.charpoly = X ^ 8 - X ^ 6 + X ^ 4 - X ^ 2 + 1 ∧ e8W24.charpoly = X ^ 8 - X ^ 4 + 1 ∧
    (∀ w ∈ [e8W20, e8W24],
      LinearIndependent ℤ (fun j : Fin Tag.E8.rank => (w ^ (j : ℕ)) *ᵥ Pi.single 0 1) ∧
        Submodule.span ℤ (Set.range fun j : Fin Tag.E8.rank =>
          (w ^ (j : ℕ)) *ᵥ Pi.single 0 1) = ⊤) ∧
    (∀ α : Fin Tag.E8.rank → ℤ, IsRoot .E8 α →
      (Submodule.span ℤ (Set.range fun j : Fin Tag.E8.rank =>
        (e8W20 ^ (j : ℕ)) *ᵥ α)).toAddSubgroup.index ∈ ({1, 5} : Set ℕ)) ∧
    ∀ α : Fin Tag.E8.rank → ℤ, IsRoot .E8 α →
      (Submodule.span ℤ (Set.range fun j : Fin Tag.E8.rank =>
        (e8W24 ^ (j : ℕ)) *ᵥ α)).toAddSubgroup.index ∈ ({1, 4, 9} : Set ℕ) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [e8W20_eq]
    exact orderOf_toMat_eq (by norm_num) (by decide +kernel) (by decide +kernel)
  · rw [e8W24_eq]
    exact orderOf_toMat_eq (by norm_num) (by decide +kernel) (by decide +kernel)
  · rw [e8W20_eq]
    exact charpoly_eq_of_lists (cs := [1, 0, -1, 0, 1, 0, -1, 0, 1]) (by monicity!)
      (by compute_degree!) (by simp [polyOfList]; ring) (by decide +kernel) _
      (e8_e₁_eq ▸ isUnit_det_orbitMat_e8W_e₁.1)
  · rw [e8W24_eq]
    exact charpoly_eq_of_lists (cs := [1, 0, 0, 0, -1, 0, 0, 0, 1]) (by monicity!)
      (by compute_degree!) (by simp [polyOfList]; ring) (by decide +kernel) _
      (e8_e₁_eq ▸ isUnit_det_orbitMat_e8W_e₁.2)
  · intro w hw
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl
    · rw [e8W20_eq]
      exact (isBasis_iff_isUnit_det _ _).2 isUnit_det_orbitMat_e8W_e₁.1
    · rw [e8W24_eq]
      exact (isBasis_iff_isUnit_det _ _).2 isUnit_det_orbitMat_e8W_e₁.2
  · intro α hα
    have h := natAbs_det_orbitMat_e8W20 α hα
    have hne : (orbitMat (toMat Tag.E8.rank e8W20List) α Tag.E8.rank).det ≠ 0 := by
      intro h0
      rw [h0] at h
      simp at h
    rw [e8W20_eq, index_span_orbit _ _ hne]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with h | h <;> simp [h]
  · intro α hα
    have h := natAbs_det_orbitMat_e8W24 α hα
    have hne : (orbitMat (toMat Tag.E8.rank e8W24List) α Tag.E8.rank).det ≠ 0 := by
      intro h0
      rw [h0] at h
      simp at h
    rw [e8W24_eq, index_span_orbit _ _ hne]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with h | h | h <;> simp [h]

