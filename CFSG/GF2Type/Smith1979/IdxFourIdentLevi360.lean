theorem levWords360_length : levWords360.length = 360 := by decide +kernel

instance : DecidableEq T4 := inferInstance

theorem levWords360_nodup : (levWords360.map wordKey).Nodup := by decide +kernel

theorem sw_mem_closure (w : List Gen) : sw w ∈ Subgroup.closure (Set.range sg) := by
  induction w with
  | nil => exact one_mem _
  | cons k w ih =>
    have h : sw (k :: w) = sg k * sw w := MulEquiv.ext fun x => rfl
    rw [h]
    exact mul_mem (Subgroup.subset_closure ⟨k, rfl⟩) ih

theorem wordKey_eq_of_sw_eq {w w' : List Gen} (h : sw w = sw w') : wordKey w = wordKey w' := by
  have hx : ∀ x : T4, swFun w x = swFun w' x := fun x => by
    have := congrArg (fun f : A4 ≃* A4 => (f (Multiplicative.ofAdd x)).toAdd) h
    simpa [sw_apply_toAdd] using this
  simp only [wordKey, hx]

theorem card_closure_sg_ge : 360 ≤ Nat.card (Subgroup.closure (Set.range sg)) := by
  have hnd := levWords360_nodup
  have hlt : ∀ i : Fin 360, (i : ℕ) < levWords360.length := fun i => by
    rw [levWords360_length]; exact i.2
  let f : Fin 360 → Subgroup.closure (Set.range sg) := fun i =>
    ⟨sw (levWords360[(i : ℕ)]'(hlt i)), sw_mem_closure _⟩
  have hf : Function.Injective f := by
    intro i j hij
    have h1 : sw (levWords360[(i : ℕ)]'(hlt i)) = sw (levWords360[(j : ℕ)]'(hlt j)) :=
      congrArg Subtype.val hij
    have h2 := wordKey_eq_of_sw_eq h1
    have hi : (i : ℕ) < (levWords360.map wordKey).length := by
      rw [List.length_map]; exact hlt i
    have hj : (j : ℕ) < (levWords360.map wordKey).length := by
      rw [List.length_map]; exact hlt j
    have h3 : (levWords360.map wordKey)[(i : ℕ)]'hi = (levWords360.map wordKey)[(j : ℕ)]'hj := by
      simpa using h2
    exact Fin.ext ((hnd.getElem_inj_iff).1 h3)
  have := Nat.card_le_card_of_injective f hf
  simpa using this

