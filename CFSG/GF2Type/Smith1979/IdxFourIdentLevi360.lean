@[expose] def swFun : List Gen → T4 → T4
  | [], x => x
  | k :: w, x => mAct k (swFun w x)

theorem sw_apply_toAdd : ∀ (w : List Gen) (x : A4), (sw w x).toAdd = swFun w x.toAdd
  | [], _ => rfl
  | k :: w, x => by
    show (sg k (sw w x)).toAdd = mAct k (swFun w x.toAdd)
    show mAct k (sw w x).toAdd = _
    rw [sw_apply_toAdd w x]

@[expose] def wordKey (w : List Gen) : T4 × T4 × T4 × T4 :=
  (swFun w (1, 0, 0, 0), swFun w (0, 1, 0, 0), swFun w (0, 0, 1, 0), swFun w (0, 0, 0, 1))

