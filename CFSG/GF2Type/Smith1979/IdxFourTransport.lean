section Linear

variable {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]

theorem map_fixSpace_tr (ψ : W ≃ₗ[ZMod 2] V12) (m : W ≃ₗ[ZMod 2] W) :
    (fixSpace m).map (ψ : W →ₗ[ZMod 2] V12) = fixSpace (trEquiv ψ m) := by
  ext y
  constructor
  · rintro ⟨v, hv, rfl⟩
    have hv' : m v = v := mem_fixSpace.mp hv
    refine mem_fixSpace.mpr ?_
    show trEquiv ψ m (ψ v) = ψ v
    rw [trEquiv_apply_φ, hv']
  · intro hy
    have hy' : trEquiv ψ m y = y := mem_fixSpace.mp hy
    refine ⟨ψ.symm y, mem_fixSpace.mpr ?_, by simp⟩
    apply ψ.injective
    rw [← trEquiv_apply_φ, LinearEquiv.apply_symm_apply, hy']

theorem map_commSpace_tr (ψ : W ≃ₗ[ZMod 2] V12) (m : W ≃ₗ[ZMod 2] W) :
    (commSpace m).map (ψ : W →ₗ[ZMod 2] V12) = commSpace (trEquiv ψ m) := by
  ext y
  constructor
  · rintro ⟨_, hv, rfl⟩
    obtain ⟨v, rfl⟩ := mem_commSpace.mp hv
    refine mem_commSpace.mpr ⟨ψ v, ?_⟩
    rw [LinearEquiv.coe_coe, trEquiv_apply_φ, map_sub]
  · intro hy
    obtain ⟨u, rfl⟩ := mem_commSpace.mp hy
    refine ⟨m (ψ.symm u) - ψ.symm u, sub_mem_commSpace m _, ?_⟩
    rw [LinearEquiv.coe_coe, map_sub, LinearEquiv.apply_symm_apply, trEquiv_apply]

theorem mem_map_equiv_iff (ψ : W ≃ₗ[ZMod 2] V12) {A : Submodule (ZMod 2) W} {v : W} :
    ψ v ∈ A.map (ψ : W →ₗ[ZMod 2] V12) ↔ v ∈ A := by
  constructor
  · rintro ⟨w, hw, h⟩
    have h' : w = v := ψ.injective h
    exact h' ▸ hw
  · intro hv
    exact ⟨v, hv, rfl⟩

end Linear

theorem thetaU_pow_three : thetaU ^ 3 = 1 :=
  LinearEquiv.ext fun x => by
    simp [pow_succ, LinearEquiv.mul_apply, theta0_theta0_theta0]

variable {G : Type} [Group G] [Finite G] {S : Setting G}

@[expose] noncomputable def tau (S : Setting G) (ψ : S.Qt ≃ₗ[ZMod 2] V12) :
    S.O →* (V12 ≃ₗ[ZMod 2] V12) :=
  (trEquiv ψ).toMonoidHom.comp S.O.subtype

theorem tau_apply (ψ : S.Qt ≃ₗ[ZMod 2] V12) (s : S.O) :
    tau S ψ s = trEquiv ψ (s : S.Qt ≃ₗ[ZMod 2] S.Qt) := rfl

theorem tau_apply_apply (ψ : S.Qt ≃ₗ[ZMod 2] V12) (s : S.O) (v : S.Qt) :
    tau S ψ s (ψ v) = ψ ((s : S.Qt ≃ₗ[ZMod 2] S.Qt) v) :=
  trEquiv_apply_φ ψ _ v

theorem tau_injective (ψ : S.Qt ≃ₗ[ZMod 2] V12) : Function.Injective (tau S ψ) :=
  (trEquiv ψ).injective.comp S.O.subtype_injective

theorem map_tau_eq (ψ : S.Qt ≃ₗ[ZMod 2] V12) :
    S.Mbar.map (tau S ψ) = (S.Mbar.map S.O.subtype).map (trEquiv ψ).toMonoidHom := by
  rw [Subgroup.map_map]
  rfl

theorem tau_mul_tau_inv_eq (ψ : S.Qt ≃ₗ[ZMod 2] V12) (m : V12 ≃ₗ[ZMod 2] V12) (s : S.O) :
    tau S (ψ.trans m) s = m * tau S ψ s * m⁻¹ :=
  trEquiv_trans ψ m _

section Transport

variable {M : Subgroup (V12 ≃ₗ[ZMod 2] V12)} {ψ : S.Qt ≃ₗ[ZMod 2] V12}

theorem stab_map_tau (hM : S.Mbar.map (tau S ψ) = M) (v : S.Qt) :
    (stab S v).map (tau S ψ) = M ⊓ MulAction.stabilizer (V12 ≃ₗ[ZMod 2] V12) (ψ v) := by
  ext y
  rw [Subgroup.mem_inf, MulAction.mem_stabilizer_iff, ← hM]
  constructor
  · rintro ⟨s, ⟨hsM, hsv⟩, rfl⟩
    refine ⟨⟨s, hsM, rfl⟩, ?_⟩
    show tau S ψ s (ψ v) = ψ v
    rw [tau_apply_apply, hsv]
  · rintro ⟨⟨s, hsM, rfl⟩, hy⟩
    refine ⟨s, ⟨hsM, ψ.injective ?_⟩, rfl⟩
    rw [← tau_apply_apply]
    exact hy

theorem card_stab_eq (hM : S.Mbar.map (tau S ψ) = M) (v : S.Qt) :
    Nat.card (stab S v) =
      Nat.card (M ⊓ MulAction.stabilizer (V12 ≃ₗ[ZMod 2] V12) (ψ v) :
        Subgroup (V12 ≃ₗ[ZMod 2] V12)) := by
  rw [← stab_map_tau hM, Subgroup.card_map_of_injective (tau_injective ψ)]

theorem normal_map_tau (hM : S.Mbar.map (tau S ψ) = M) {v : S.Qt} {P : Subgroup S.O}
    (hP : P ≤ stab S v) (hPn : ∀ s ∈ stab S v, ∀ p ∈ P, s * p * s⁻¹ ∈ P) :
    P.map (tau S ψ) ≤ M ⊓ MulAction.stabilizer (V12 ≃ₗ[ZMod 2] V12) (ψ v) ∧
      ∀ s ∈ M ⊓ MulAction.stabilizer (V12 ≃ₗ[ZMod 2] V12) (ψ v), ∀ p ∈ P.map (tau S ψ),
        s * p * s⁻¹ ∈ P.map (tau S ψ) := by
  rw [← stab_map_tau hM]
  refine ⟨Subgroup.map_mono hP, ?_⟩
  rintro _ ⟨s, hs, rfl⟩ _ ⟨p, hp, rfl⟩
  exact ⟨s * p * s⁻¹, hPn s hs p hp, by rw [map_mul, map_mul, map_inv]⟩

theorem mem_M_iff (hM : S.Mbar.map (tau S ψ) = M) {y : V12 ≃ₗ[ZMod 2] V12} :
    y ∈ M ↔ ∃ s ∈ S.Mbar, tau S ψ s = y := by
  rw [← hM, Subgroup.mem_map]

end Transport

theorem exists_idxFourFacts_of_base (hw : S.width = 6) {g : G} (H : Hyp4 S g)
    (C : Cons311 S g) {M K2 L : Subgroup (V12 ≃ₗ[ZMod 2] V12)} {x0 : V12 ≃ₗ[ZMod 2] V12}
    {a0 : V12} {Vt : Submodule (ZMod 2) V12} (hF : ModelFacts M K2 L x0 a0 Vt)
    {ψ : S.Qt ≃ₗ[ZMod 2] V12} (hq : ∀ v, q0 (ψ v) = S.q v) {θ : S.O} (hθ : ThetaCompat ψ θ)
    (hM : S.Mbar.map (tau S ψ) = M) (hbase : ψ (aT S g) = a0) (hθM : θ ∈ S.Mbar)
    (hθ3 : θ ^ 3 = 1) (hfpf : ∀ v, (θ : S.Qt ≃ₗ[ZMod 2] S.Qt) v = v → v = 0) :
    ∃ (K : Subgroup S.O) (xb : S.O), IdxFourFacts S g K θ xb := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hτ := tau_injective (S := S) ψ
  have hLstab : S.Lbar g ≤ stab S (aT S g) := fun l hl =>
    (Case25.mem_NLbar_iff H).mp (Case25.Lbar_le_NLbar hl)
  have hLnorm : ∀ s ∈ stab S (aT S g), ∀ l ∈ S.Lbar g, s * l * s⁻¹ ∈ S.Lbar g := by
    intro s hs l hl
    have hsN : s ∈ NLbar S g := (Case25.mem_NLbar_iff H).mpr hs
    exact (mem_normalizer_iff.mp hsN.2 l).mp hl
  have hLcard : Nat.card (S.Lbar g) = 2 ^ 5 := by rw [card_Lbar C hw]; norm_num
  have hLp : IsPGroup 2 (S.Lbar g) := IsPGroup.of_card hLcard
  obtain ⟨hLle, hLn⟩ := normal_map_tau hM hLstab hLnorm
  rw [hbase] at hLle hLn
  have hτL : (S.Lbar g).map (tau S ψ) = L :=
    hF.lbar_unique _ hLle hLn (hLp.map _)
      (by rw [Subgroup.card_map_of_injective hτ, hLcard])
  have hmemL : ∀ s : S.O, tau S ψ s ∈ L ↔ s ∈ S.Lbar g := by
    intro s
    rw [← hτL]
    exact ⟨fun ⟨l, hl, h⟩ => hτ h ▸ hl, fun h => ⟨s, h, rfl⟩⟩
  have hDt : (Dt S g).map (ψ : S.Qt →ₗ[ZMod 2] V12) = Vt := by
    have hle : Vt ≤ (Dt S g).map (ψ : S.Qt →ₗ[ZMod 2] V12) := by
      refine hF.vt_le.trans (Submodule.span_le.mpr ?_)
      rintro _ ⟨l, hl, x, hx, rfl⟩
      obtain ⟨s, hs, rfl⟩ : ∃ s ∈ S.Lbar g, tau S ψ s = l := by
        rw [← hτL] at hl
        exact hl
      obtain ⟨v, rfl⟩ := ψ.surjective x
      have hv : QuadraticMap.polar S.q v (aT S g) = 0 := by
        rw [← f0_tr hq, hbase]
        exact hx
      refine ⟨(s : S.Qt ≃ₗ[ZMod 2] S.Qt) v - v, Lbar_perp H C hs hv, ?_⟩
      rw [LinearEquiv.coe_coe, map_sub, tau_apply_apply]
    refine (Submodule.eq_of_le_of_finrank_eq hle ?_).symm
    rw [hF.vt_rank, LinearEquiv.finrank_map_eq, finrank_Dt H C, hw]
  have hτθ : tau S ψ θ = thetaU ∨ tau S ψ θ = thetaU⁻¹ := tr_theta hθ
  have hcommθ : ∀ s : S.O, thetaU * tau S ψ s = tau S ψ s * thetaU → θ * s = s * θ := by
    intro s h
    apply hτ
    rw [map_mul, map_mul]
    rcases hτθ with h1 | h1
    · rw [h1]
      exact h
    · rw [h1]
      calc thetaU⁻¹ * tau S ψ s = thetaU⁻¹ * (tau S ψ s * thetaU) * thetaU⁻¹ := by group
        _ = thetaU⁻¹ * (thetaU * tau S ψ s) * thetaU⁻¹ := by rw [h]
        _ = tau S ψ s * thetaU⁻¹ := by group
  have hfix : ∀ s : S.O, (fixO S s).map (ψ : S.Qt →ₗ[ZMod 2] V12) = fixSpace (tau S ψ s) :=
    fun s => map_fixSpace_tr ψ _
  have hcomm : ∀ s : S.O, (commO S s).map (ψ : S.Qt →ₗ[ZMod 2] V12) = commSpace (tau S ψ s) :=
    fun s => map_commSpace_tr ψ _
  have hmemfix : ∀ (s : S.O) (v : S.Qt), ψ v ∈ fixSpace (tau S ψ s) ↔ v ∈ fixO S s := by
    intro s v
    rw [← hfix, mem_map_equiv_iff]
  have hmemcomm : ∀ (s : S.O) (v : S.Qt), ψ v ∈ commSpace (tau S ψ s) ↔ v ∈ commO S s := by
    intro s v
    rw [← hcomm, mem_map_equiv_iff]
  have hmemDt : ∀ v : S.Qt, ψ v ∈ Vt ↔ v ∈ Dt S g := by
    intro v
    rw [← hDt, mem_map_equiv_iff]
  have hfinfix : ∀ s : S.O, finrank (ZMod 2) (fixO S s) =
      finrank (ZMod 2) (fixSpace (tau S ψ s)) := fun s => by
    rw [← hfix, LinearEquiv.finrank_map_eq]
  have hfincomm : ∀ s : S.O, finrank (ZMod 2) (commO S s) =
      finrank (ZMod 2) (commSpace (tau S ψ s)) := fun s => by
    rw [← hcomm, LinearEquiv.finrank_map_eq]
  have hK2range : K2 ≤ (tau S ψ).range := fun y hy => by
    obtain ⟨s, -, hs⟩ := (mem_M_iff hM).mp (hF.K2_le hy)
    exact ⟨s, hs⟩
  have hKmap : (K2.comap (tau S ψ)).map (tau S ψ) = K2 :=
    Subgroup.map_comap_eq_self hK2range
  have hKle : K2.comap (tau S ψ) ≤ S.Mbar := by
    intro s hs
    obtain ⟨m, hm, hms⟩ := (mem_M_iff hM).mp (hF.K2_le hs)
    exact hτ hms ▸ hm
  obtain ⟨xb, hxbM, hxb⟩ := (mem_M_iff hM).mp hF.x_mem
  refine ⟨K2.comap (tau S ψ), xb, ?_⟩
  exact
    { K_le := hKle
      K_index := by
        rw [← Subgroup.relIndex_map_map_of_injective _ _ hτ, hKmap, hM]
        exact hF.K2_index
      θ_mem := hθM
      θ_cube := hθ3
      θ_fpf := hfpf
      x_mem := hxbM
      x_not_mem := fun h => hF.x_not_mem (hxb ▸ h)
      x_sq := hτ (by rw [map_mul, hxb, hF.x_sq, map_one])
      x_comm := by
        apply hτ
        rw [map_mul, map_mul, hxb]
        rcases hτθ with h1 | h1
        · rw [h1]
          exact hF.x_comm
        · rw [h1]
          calc x0 * thetaU⁻¹ = thetaU⁻¹ * (thetaU * x0) * thetaU⁻¹ := by group
            _ = thetaU⁻¹ * (x0 * thetaU) * thetaU⁻¹ := by rw [hF.x_comm]
            _ = thetaU⁻¹ * x0 := by group
      x_dim := by rw [hfincomm, hxb, hF.x_dim]
      x_sing := fun w hw => by
        rw [← hq]
        exact hF.x_sing _ (hxb ▸ (hmemcomm xb w).mpr hw)
      x_cent := by
        have hmap : (S.Mbar ⊓ Subgroup.centralizer ({xb} : Set S.O)).map (tau S ψ) =
            M ⊓ Subgroup.centralizer ({x0} : Set (V12 ≃ₗ[ZMod 2] V12)) := by
          ext y
          simp only [Subgroup.mem_map, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff]
          constructor
          · rintro ⟨s, ⟨hsM, hs⟩, rfl⟩
            refine ⟨(mem_M_iff hM).mpr ⟨s, hsM, rfl⟩, ?_⟩
            rw [← hxb, ← map_mul, ← map_mul, hs]
          · rintro ⟨hyM, hy⟩
            obtain ⟨s, hsM, rfl⟩ := (mem_M_iff hM).mp hyM
            refine ⟨s, ⟨hsM, hτ ?_⟩, rfl⟩
            rw [map_mul, map_mul, hxb]
            exact hy
        rw [← Subgroup.card_map_of_injective hτ, hmap]
        exact hF.x_cent
      lemma5 := by
        intro w hw hw0 P hP hPn hP2 hcard
        obtain ⟨hle, hn⟩ := normal_map_tau hM hP hPn
        refine hF.lemma5 (ψ w) (hxb ▸ (hmemcomm xb w).mpr hw)
          (fun h => hw0 (ψ.injective (h.trans (map_zero ψ).symm))) _ hle hn (hP2.map _) ?_
        rw [Subgroup.card_map_of_injective hτ, hcard]
      stab_two := by
        intro v hv0 hv
        rw [card_stab_eq hM]
        exact hF.stab_two (ψ v) (fun h => hv0 (ψ.injective (h.trans (map_zero ψ).symm)))
          (by rw [hq, hv])
      inv_conj := by
        intro t ht ht1 htt
        obtain ⟨m', hm', hconj⟩ := hF.inv_conj (tau S ψ t) ht
          (fun h => ht1 (hτ (h.trans (map_one _).symm)))
          (by rw [← map_mul, htt, map_one])
        obtain ⟨m, hm, rfl⟩ := (mem_M_iff hM).mp hm'
        refine ⟨m, hm, (hmemL _).mp ?_⟩
        rw [map_mul, map_mul, map_inv]
        exact hconj
      lbar := by
        intro t ht ht1
        rcases hF.lbar (tau S ψ t) ((hmemL t).mpr ht)
            (fun h => ht1 (hτ (h.trans (map_one _).symm))) with hout | ⟨h1, h2, h3, h4, h5⟩
        · left
          intro v hv
          rw [← hmemcomm]
          exact hout ((hmemfix t v).mpr hv)
        · right
          refine ⟨hcommθ t h1, by rw [hfinfix]; exact h2, fun r hr => ?_, fun w hw hperp => ?_,
            fun v hv hv0 => ?_⟩
          · rw [← hq]
            exact h3 _ ((hmemcomm t r).mpr hr)
          · obtain ⟨p', ⟨hp'V, hp'f⟩, r', hr', hw'⟩ := h4 (ψ w) ((hmemfix t w).mpr hw) (by
              rintro p' ⟨hp'V, hp'f⟩
              obtain ⟨p, rfl⟩ := ψ.surjective p'
              rw [f0_tr hq]
              exact hperp p ⟨(hmemDt p).mp hp'V, (hmemfix t p).mp hp'f⟩)
            obtain ⟨p, rfl⟩ := ψ.surjective p'
            obtain ⟨r, rfl⟩ := ψ.surjective r'
            refine ⟨p, ⟨(hmemDt p).mp hp'V, (hmemfix t p).mp hp'f⟩, r, (hmemcomm t r).mp hr',
              ψ.injective ?_⟩
            rw [map_add]
            exact hw'
          · obtain ⟨i, u', ⟨hu'V, hu'f⟩, r', hr', hv'⟩ :=
              h5 (ψ v) ((hmemfix t v).mpr hv) (by rw [hq, hv0])
            obtain ⟨u, rfl⟩ := ψ.surjective u'
            obtain ⟨r, rfl⟩ := ψ.surjective r'
            have hpow : ∃ j : ℕ, tau S ψ (θ ^ j) = thetaU ^ i := by
              rcases hτθ with h1 | h1
              · exact ⟨i, by rw [map_pow, h1]⟩
              · refine ⟨2 * i, ?_⟩
                rw [map_pow, h1, inv_pow]
                have h3' : thetaU ^ (3 * i) = 1 := by rw [pow_mul, thetaU_pow_three, one_pow]
                calc (thetaU ^ (2 * i))⁻¹ = (thetaU ^ (2 * i))⁻¹ * thetaU ^ (3 * i) := by
                      rw [h3', mul_one]
                  _ = thetaU ^ i := by
                      rw [inv_mul_eq_iff_eq_mul, ← pow_add]
                      congr 1
                      ring
            obtain ⟨j, hj⟩ := hpow
            refine ⟨j, u, ⟨(hmemDt u).mp hu'V, (hmemfix t u).mp hu'f⟩, r, (hmemcomm t r).mp hr',
              ψ.injective ?_⟩
            rw [map_add, ← tau_apply_apply, hj]
            exact hv' }

theorem exists_idxFourFacts (hw : S.width = 6) {g : G} (H : Hyp4 S g) (C : Cons311 S g)
    {M K2 L : Subgroup (V12 ≃ₗ[ZMod 2] V12)} {x0 : V12 ≃ₗ[ZMod 2] V12} {a0 : V12}
    {Vt : Submodule (ZMod 2) V12} (hF : ModelFacts M K2 L x0 a0 Vt)
    {ψ : S.Qt ≃ₗ[ZMod 2] V12} (hq : ∀ v, q0 (ψ v) = S.q v) {θ : S.O} (hθ : ThetaCompat ψ θ)
    (hM : (S.Mbar.map S.O.subtype).map (trEquiv ψ).toMonoidHom = M) (hθM : θ ∈ S.Mbar)
    (hθ3 : θ ^ 3 = 1) (hfpf : ∀ v, (θ : S.Qt ≃ₗ[ZMod 2] S.Qt) v = v → v = 0) :
    ∃ (K : Subgroup S.O) (xb : S.O), IdxFourFacts S g K θ xb := by
  classical
  have hM' : S.Mbar.map (tau S ψ) = M := by rw [map_tau_eq, hM]
  have hτ := tau_injective (S := S) ψ
  have hLstab : S.Lbar g ≤ stab S (aT S g) := fun l hl =>
    (Case25.mem_NLbar_iff H).mp (Case25.Lbar_le_NLbar hl)
  have hLnorm : ∀ s ∈ stab S (aT S g), ∀ l ∈ S.Lbar g, s * l * s⁻¹ ∈ S.Lbar g := fun s hs l hl =>
    (mem_normalizer_iff.mp ((Case25.mem_NLbar_iff H).mpr hs).2 l).mp hl
  have hLcard : Nat.card (S.Lbar g) = 2 ^ 5 := by rw [card_Lbar C hw]; norm_num
  obtain ⟨hLle, hLn⟩ := normal_map_tau hM' hLstab hLnorm
  obtain ⟨m, hmM, hma⟩ := hF.base (ψ (aT S g))
    (fun h => aT_ne_zero H (ψ.injective (h.trans (map_zero ψ).symm)))
    (by rw [hq, q_aT H]) _ hLle hLn ((IsPGroup.of_card hLcard).map _)
    (by rw [Subgroup.card_map_of_injective hτ, hLcard])
  have hmg := hF.M_le hmM
  refine exists_idxFourFacts_of_base hw H C hF (ψ := ψ.trans m) (fun v => ?_) ?_ ?_ hma hθM hθ3
    hfpf
  · rw [LinearEquiv.trans_apply, hmg.1, hq]
  · rcases hθ with h | h <;> rcases hmg.2 with hm | hm
    · exact Or.inl fun v => by rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, h, hm]
    · exact Or.inr fun v => by rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, h, hm]
    · exact Or.inr fun v => by rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, h, hm, hm]
    · exact Or.inl fun v => by
        rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, h, hm, hm, theta0_theta0_theta0]
  · ext y
    constructor
    · rintro ⟨s, hs, rfl⟩
      rw [tau_mul_tau_inv_eq]
      exact M.mul_mem (M.mul_mem hmM ((mem_M_iff hM').mpr ⟨s, hs, rfl⟩)) (M.inv_mem hmM)
    · intro hy
      obtain ⟨s, hs, hsy⟩ := (mem_M_iff hM').mp (M.mul_mem (M.mul_mem (M.inv_mem hmM) hy) hmM)
      refine ⟨s, hs, ?_⟩
      rw [tau_mul_tau_inv_eq, hsy]
      group

end CFSG.GF2Type.Smith1979.IdxFour
