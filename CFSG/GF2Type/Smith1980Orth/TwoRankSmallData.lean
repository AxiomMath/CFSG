@[expose] def getN (N t x : Nat) : Nat := t / N ^ x % N

@[expose] def packN (B : Nat) (l : List Nat) : Nat := l.foldr (fun d acc => d + B * acc) 0

@[expose] def idN (N : Nat) : Nat := (List.range N).foldr (fun x acc => x + N * acc) 0

@[expose] def compN (N s t : Nat) : Nat :=
  (List.range N).foldr (fun x acc => getN N s (getN N t x) + N * acc) 0

@[expose] def isInvN (N s : Nat) : Bool := compN N s s == idN N && s != idN N

@[expose] def colN (N k m : Nat) : Nat :=
  ((List.range k).foldl (fun (st : Nat × Nat × Nat) j =>
      let c := (m >>> (k * j)) &&& (N - 1)
      (st.1 + st.2.2 * (st.1 ^^^ (c * st.2.1)), st.2.1 + st.2.2 * st.2.1, st.2.2 * st.2.2))
    (0, 1, N)).1

@[expose] def GensOK (N : Nat) (gens : List Nat) : Prop :=
  ∀ t ∈ gens, t < N ^ N ∧
    (∀ x < N, ∀ y < N, x ≤ y → getN N t (x ^^^ y) = getN N t x ^^^ getN N t y) ∧
    ((List.range N).map (getN N t)).Nodup

instance (N : Nat) (gens : List Nat) : Decidable (GensOK N gens) := by
  unfold GensOK
  infer_instance

@[expose] def TreeOK (N a succ : Nat) (gens P : List Nat) (info : List (Nat × Nat)) : Prop :=
  P.getD 0 0 = idN N ∧ P.Nodup ∧ P.length = 2 ^ a ∧ info.length + 1 = P.length ∧
  (∀ k < info.length, (info.getD k (0, 0)).1 < k + 1 ∧ (info.getD k (0, 0)).2 < gens.length ∧
    getN 128 succ ((info.getD k (0, 0)).1 * gens.length + (info.getD k (0, 0)).2) = k + 1) ∧
  ∀ i < P.length, ∀ j < gens.length, getN 128 succ (i * gens.length + j) < P.length ∧
    compN N (P.getD i 0) (gens.getD j 0) = P.getD (getN 128 succ (i * gens.length + j)) 0

instance (N a succ : Nat) (gens P : List Nat) (info : List (Nat × Nat)) :
    Decidable (TreeOK N a succ gens P info) := by
  unfold TreeOK
  infer_instance

@[expose] def IsoOK (N qt : Nat) (gens : List Nat) : Prop :=
  ∀ t ∈ gens, ∀ x < N, getN 2 qt (getN N t x) = getN 2 qt x

instance (N qt : Nat) (gens : List Nat) : Decidable (IsoOK N qt gens) := by
  unfold IsoOK
  infer_instance

@[expose] def ColorOK₁ (N m cls : Nat) (P : List Nat) : Prop :=
  ∀ i < P.length, isInvN N (P.getD i 0) = true → getN 64 cls i < m

instance (N m cls : Nat) (P : List Nat) : Decidable (ColorOK₁ N m cls P) := by
  unfold ColorOK₁
  infer_instance

@[expose] def PairOK (N cls : Nat) (P : List Nat) (i : Nat) : Prop :=
  ∀ j < P.length, i ≠ j → getN 64 cls i = getN 64 cls j →
    compN N (P.getD i 0) (P.getD j 0) ≠ compN N (P.getD j 0) (P.getD i 0)

instance (N cls : Nat) (P : List Nat) (i : Nat) : Decidable (PairOK N cls P i) := by
  unfold PairOK
  infer_instance

@[expose] def ColorOK₂ (N m cls : Nat) (P : List Nat) : Prop :=
  ∀ i < P.length, getN 64 cls i < m → PairOK N cls P i

instance (N m cls : Nat) (P : List Nat) : Decidable (ColorOK₂ N m cls P) := by
  unfold ColorOK₂
  infer_instance

@[expose] def TabCert (N a r qt cls succ : Nat) (gens P : List Nat) (info : List (Nat × Nat)) :
    Prop :=
  GensOK N gens ∧ TreeOK N a succ gens P info ∧ IsoOK N qt gens ∧
    ColorOK₁ N (2 ^ (r + 1) - 2) cls P ∧ ColorOK₂ N (2 ^ (r + 1) - 2) cls P

instance (N a r qt cls succ : Nat) (gens P : List Nat) (info : List (Nat × Nat)) :
    Decidable (TabCert N a r qt cls succ gens P info) := by
  unfold TabCert
  infer_instance

