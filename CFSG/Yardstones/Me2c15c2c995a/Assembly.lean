    (h124 : ∃ H₀ ∈ hSet S.T S.M, Hyp124 S.M H₀) : ∃ V₀ V : Subgroup G, Hyp123 S.M S.T V₀ V := by
  by_cases hW : ∃ W : Subgroup G, InCalW S.M S.T W
