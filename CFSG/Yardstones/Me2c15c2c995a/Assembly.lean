    (h : ∃ W : Subgroup G, InCalW M T W) : ∃ V₀ V : Subgroup G, Hyp123 M T V₀ V := by
  obtain ⟨W, hW⟩ := h
  obtain ⟨V, hV⟩ := (Set.toFinite {W : Subgroup G | InCalW M T W}).exists_minimal ⟨W, hW⟩
