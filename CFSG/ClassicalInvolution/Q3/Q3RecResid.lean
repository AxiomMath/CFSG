namespace CFSG.ClassicalInvolution.Q3.Q3W

structure RecResiduals3 : Prop where
  twinKinds : Q3OF.TwinKindsMF

theorem setupRecognition3_of_recResiduals (h : RecResiduals3) : SetupRecognition3I := by
  have h3 : OddThreeFreeInput := oddThreeFreeInput_proved
  have hprod : Q3TY.CommutingProductP1Input3 :=
    Q3PP.commutingProductP1Input3_of_twin Q3PP.oddAutLayerRigidHyp
      (Q3OF.hTwin_of_mfComp Q3PP.oddAutLayerRigidHyp Q3PP.mfComp_g2 Q3PP.mfComp_trialityD4
        h.twinKinds)
  have hP : Q3TC.ProductP1Input3 := Q3TY.productP1Input3_of_commuting hprod
  have hSL7 : Piece3SL7 := piece3SL7_of_odd3 h3
  have hSL6 : Piece3SL6 := piece3SL6_proved h3
  have hSLs : Piece3SLs := piece3SLs_proved h3 (chainRow3_two h3 hP)
  have hSU7 : Piece3SU7 := piece3SU7_of_odd3 h3 phan3Rec_proved
  have hSU6 : Piece3SU6 := Q3E6T.piece3SU6_of_obstruction_proved h3 phan3Rec_proved
    (Q3E6T.endObstructionData3_of_productP1 hP phan3Rec_proved)
  have hcls : Q3TY.TwinInvolution3 := Q3TIV.twinInvolution3_of_odd3 h3
  have hLink : Q3TY.TwinLinked3 := Q3TLK.twinLinked3_of_inputs h3 hprod
    (Q3TIY.twinYType3On_sp2 h3) (Q3TZ.twinYType3On_su4 h3)
  have hSUs : Piece3SUs := piece3SUs_of_chain h3 phan3Rec_proved
    (chainRow3U_two h3 hP Phan.Q3G.phanA3Completion3_of_cert) (chainRow3U_three h3)
    (chainRow3U_four h3)
  have hSp4 : Piece3Sp4 := Q3V.Chain.piece3Sp4_of_odd3 h3
  have hSp3 : Piece3Sp3 := Q3V.F4S.piece3Sp3_of_product h3 hP
  have hSp2 : Piece3Sp2 := Q3V.piece3Sp2_of_collapse h3 Q3ZB.c3ChainInput_proved
    Q3V.v6Collapse_proved
  have hE7 : Piece3E7 := piece3E7_proved h3
  have hE8 : Piece3E8 := piece3E8_of_odd3_product h3 hP
  have hTD : Piece3TwinD := Q3TIY.piece3TwinD_of_inputs_noY2 h3 hcls hprod
  have hTSL4 : Piece3TwinSL4 :=
    Q3P21.piece3TwinSL4_of_linking h3 hprod (Q3TIY.twinYType3On_sl4 h3)
  have hTB : Piece3TwinB := Q3TIY.piece3TwinB_of_y4_noY2 h3 hcls hprod
  have hTSp2 : Piece3TwinSp2 := Q3TPS.piece3TwinSp2_of_inputs_pair h3
    (Q3TW.weakCT3OddMapPair_of_collapse Q3TW.b3Collapse_proved (by norm_num)) hP hLink
  have hTTD : Piece3TwinTD := Q3TW.piece3TwinTD_of_chain h3 Q3TW.weakCT3MinusMap_proved
    Q3TW.leviEmbed3Minus_proved
    (Q3TIY.chainPiece3TwinTD_of_inputs_noY2 h3 hcls hprod)
  have hTSU4 : Piece3TwinSU4 := Q3P21.piece3TwinSU4_proved h3
    (Q3TW.weakCT3MinusMap_of_collapse Q3TW.td4Collapse_proved (by norm_num)) hP hLink
  have hA1 : PieceAllA1₃ := pieceAllA1₃_of_odd3 h3
  have hM11 : PieceM11₃ := pieceM11₃_of_inputs h3 hP m11AutInner_proved
  have hrows : RowPiece3 ShapeTable3 := rowPiece3_table hSL7 hSL6 hSLs hSU7 hSU6 hSUs hSp4 hSp3
    hSp2 hE7 hE8 hTD hTSL4 hTB hTSp2 hTTD hTSU4
  exact setupRecognition3_of_pieces hrows hA1 hM11 pieceNoA1₃
    (pieceExotic₃_of_formal h3 hrows hA1 hM11) (multiPiece3_of_odd3 h3)

theorem twinKindsMF_proved : Q3OF.TwinKindsMF :=
  Q3OF.twinKindsMF_of_tags Q3PP.mfComp_psl4 Q3PP.mfComp_psu4 Q3MFO.mfComp_psp Q3MFO.mfComp_spin7
    Q3PP.mfComp_plus4 Q3PP.mfComp_minus4

theorem setupRecognition3_proved : SetupRecognition3I :=
  setupRecognition3_of_recResiduals ⟨twinKindsMF_proved⟩

end CFSG.ClassicalInvolution.Q3.Q3W
