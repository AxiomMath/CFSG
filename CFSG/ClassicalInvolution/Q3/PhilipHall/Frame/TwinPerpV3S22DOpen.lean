variable {X : Type} [Group X] [Finite X] {Φ : Set (Subgroup X)} {n : ℕ}

structure SecMuExclOpen (X : Type) [Group X] [Finite X] (Φ : Set (Subgroup X)) : Prop where
  noE4 : (¬ ∃ M ∈ Φ, ∃ zb : X, IsUniqueInvolution M zb ∧ TightInO2 zb) → ¬ TwinE4 X
  noAE7 : (∃ M ∈ Φ, ∃ zb : X, IsUniqueInvolution M zb ∧ TightInO2 zb) →
    (¬ ∃ V : Subgroup X, WSet Φ = {V}) → ¬ Nonempty (TC.Thin.AEIdent Φ 7)
  noE64 : (∃ M ∈ Φ, ∃ zb : X, IsUniqueInvolution M zb ∧ TightInO2 zb) →
    (¬ ∃ V : Subgroup X, WSet Φ = {V}) → ¬ Nonempty (TC.Thin.AEIdentOn Φ 7 AE.e64Sets AE.e64Sub)

theorem exitResidual_of_section_open (hcit : CIT3Below n) (hP : TL4.TightBelowRPlus 3 n)
    (h4 : Thm4RTwinBelow 3 n) (hOE : OddCentEdge n) (hlt : Nat.card X < n) (hS : Q8Section X Φ)
    {A A' : Subgroup X} (hA : A ∈ Φ) (hA' : A' ∈ Φ) (h2A : IsPGroup 2 A) (h2A' : IsPGroup 2 A')
    (hne : A ≠ A') {x₀ : X} (hxA : IsUniqueInvolution A x₀) (hxA' : IsUniqueInvolution A' x₀)
    (hnb : ∀ M ∈ Φ, M ∈ omegaNbr Φ A → M = A') (hnb' : ∀ M ∈ Φ, M ∈ omegaNbr Φ A' → M = A)
    (hedge : ∃ M ∈ Φ, ∃ N : Subgroup X, N ∈ omegaNbr Φ M) (hno : ¬ NoExit X Φ)
    (h3 : 3 ∣ Nat.card X) (hMu : SecMuExclOpen X Φ) :
    (∃ M ∈ Φ, ∃ zb : X, IsUniqueInvolution M zb ∧ TightInO2 zb) ∧
      ((∃ V : Subgroup X, WSet Φ = {V}) ∨
        ∃ m : ℕ, (m = 5 ∨ m = 6) ∧ Nonempty (AEIdent Φ m)) := by
  by_cases hconj : ∃ g : X, conjSub g A = A'
  · have htrans := transitive_of_conj_twin h4 hlt hS hA hA' hnb hnb' hconj
    have hodd := hOE hcit hP X hlt Φ hS htrans hedge
    by_cases hO2m : ∃ M ∈ Φ, ∃ zb : X, IsUniqueInvolution M zb ∧ TightInO2 zb
    · refine ⟨hO2m, ?_⟩
      obtain ⟨M, hM, zb, hzb, hO⟩ := hO2m
      have F := q8Fam_of_q8Section hS htrans hM hzb (hodd M hM zb hzb) hO
      by_cases hWc : ∃ V : Subgroup X, WSet Φ = {V}
      · exact Or.inl hWc
      right
      have hD : TC.Thin.ThmDHyp 3 Φ :=
        ⟨F.hyp, F.two, F.card, F.aEmpty, F.gen, F.trans, F.oddFree, F.inO2⟩
      have hTO : TwinOnlyNbr Φ := twinOnly_of_trans hS.hyp.conjInvariant htrans hA (fun M hM => hnb M hM.1 hM)
      rcases F.thmDConcl hP.thmD.d2 hlt with h1 | ⟨W', hW⟩ | ⟨E, hE⟩ | I64 | ⟨m, hm5, ⟨I⟩⟩ | I29
      · exact absurd (h1 A hA A' hA') hne
      · exact absurd ⟨W', hW⟩ hWc
      · exact absurd (TC.Thin.eq_of_inv_e8 hD hE hA hA' hxA hxA') hne
      · exact absurd I64 (hMu.noE64 ⟨M, hM, zb, hzb, hO⟩ hWc)
      · by_cases hm6 : m ≤ 6
        · exact ⟨m, by omega, ⟨I⟩⟩
        · by_cases hm7 : m = 7
          · subst hm7
            exact absurd ⟨I⟩ (hMu.noAE7 ⟨M, hM, zb, hzb, hO⟩ hWc)
          · exfalso
            obtain ⟨B, hB, C, hC, D, hD', hCD⟩ :=
              TL4.LinkE2.exists_two_nbrs_of_aeIdent hD (by omega) I
            exact hCD (hTO B hB C hC D hD')
      · exfalso
        obtain ⟨I'⟩ := I29
        obtain ⟨B, hB, C, hC, D, hD', hCD⟩ := TL4.LinkE2.exists_two_nbrs_of_e29 hD I' hA
        exact hCD (hTO B hB C hC D hD')
    · exfalso
      rcases noExit_or_o2_or_e4 hS htrans hedge hodd with hN | hO | hE4
      · exact hno hN
      · exact hO2m (by obtain ⟨M, hM, z, hz, hO⟩ := hO; exact ⟨M, hM, z, hz, hO⟩)
      · exact hMu.noE4 hO2m hE4
  · exfalso
    obtain ⟨k, hk⟩ := twin_only_two_group h4 hlt hS hA hA' h2A h2A' hnb hnb' hconj
    rw [hk] at h3
    exact absurd (Nat.prime_three.dvd_of_dvd_pow h3) (by norm_num)

end Abs

