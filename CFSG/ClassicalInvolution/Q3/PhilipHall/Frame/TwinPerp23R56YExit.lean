theorem p23_cu_le_ce (hT : Thm4RTwinBelow 3 n) (hc : P23Cfg n Y R S t K' W u e g)
    (hZ : u * e ∈ zStarOf (rLayer (Om R) u))
    (hα : alphaOf (Subgroup.closure ({u, t} : Set Y)) = ⊥)
    (halpha : ∀ A : Subgroup Y, A ≤ Subgroup.closure ({u * e, u, t} : Set Y) → IsElemAbelian2 A 2 →
      alphaOf A = alphaOf (Subgroup.closure ({u, t} : Set Y))) :
    Subgroup.centralizer ({u} : Set Y) ≤ Subgroup.centralizer ({e} : Set Y) := by
  intro x hx
  have hd := hc.data
  obtain ⟨o, ho, hm⟩ := p23_cu_split hT hc hZ hx
  have hBle : Subgroup.closure ({u * e, u} : Set Y) ≤ Subgroup.closure ({u * e, u, t} : Set Y) :=
    Subgroup.closure_mono (by intro x hx; rcases hx with rfl | rfl <;> simp)
  have hAue : IsElemAbelian2 (Subgroup.closure ({u * e, u} : Set Y)) 2 :=
    T7A.isElemAbelian2_closure_pair (ue_sq hc) hd.hu2 (ue_ne_one hc) hd.hu1
      (fun h => hd.he1 (by simpa using h)) (by
        have := (Subgroup.mem_centralizer_singleton_iff.mp (ue_comm_u hc))
        exact this)
  have hαue : alphaOf (Subgroup.closure ({u * e, u} : Set Y)) = ⊥ := by
    rw [halpha _ hBle hAue]; exact hα
  have huA : u ∈ Subgroup.closure ({u * e, u} : Set Y) := Subgroup.subset_closure (by simp)
  have hueA : u * e ∈ Subgroup.closure ({u * e, u} : Set Y) := Subgroup.subset_closure (by simp)
  have hoc : o * (u * e) = (u * e) * o :=
    CFSG.ClassicalInvolution.Asc77.T8.oddCoreOf_centralizer_commutes hαue huA hd.hu1 hueA o ho
  have hoC : o ∈ Subgroup.centralizer ({u} : Set Y) := oddCoreOf_le_self _ ho
  have hou : o * u = u * o := Subgroup.mem_centralizer_singleton_iff.mp hoC
  have hmu : (o⁻¹ * x) * u = u * (o⁻¹ * x) := by
    have hxu : x * u = u * x := Subgroup.mem_centralizer_singleton_iff.mp hx
    have hou' : o⁻¹ * u = u * o⁻¹ := by
      calc o⁻¹ * u = o⁻¹ * u * o * o⁻¹ := by group
        _ = o⁻¹ * (u * o) * o⁻¹ := by group
        _ = o⁻¹ * (o * u) * o⁻¹ := by rw [hou]
        _ = u * o⁻¹ := by group
    calc (o⁻¹ * x) * u = o⁻¹ * (x * u) := by group
      _ = o⁻¹ * (u * x) := by rw [hxu]
      _ = (o⁻¹ * u) * x := by group
      _ = (u * o⁻¹) * x := by rw [hou']
      _ = u * (o⁻¹ * x) := by group
  have hmue : (o⁻¹ * x) * (u * e) = (u * e) * (o⁻¹ * x) :=
    (Subgroup.mem_centralizer_singleton_iff.mp hm)
  have hme : (o⁻¹ * x) * e = e * (o⁻¹ * x) :=
    CFSG.ClassicalInvolution.Asc77.T7Y.comm_e_of_comm_u_ue hd.hu2 hmu hmue
  have hoe : o * e = e * o :=
    CFSG.ClassicalInvolution.Asc77.T7Y.comm_e_of_comm_u_ue hd.hu2 hou hoc
  rw [Subgroup.mem_centralizer_singleton_iff]
  have hx' : x = o * (o⁻¹ * x) := by group
  rw [hx']
  calc o * (o⁻¹ * x) * e = o * ((o⁻¹ * x) * e) := by group
    _ = o * (e * (o⁻¹ * x)) := by rw [hme]
    _ = (o * e) * (o⁻¹ * x) := by group
    _ = (e * o) * (o⁻¹ * x) := by rw [hoe]
    _ = e * (o * (o⁻¹ * x)) := by group

theorem p23_gamma_u_of_zstar (hT : Thm4RTwinBelow 3 n) (hc : P23Cfg n Y R S t K' W u e g)
    (hZ : u * e ∈ zStarOf (rLayer (Om R) u)) :
    Subgroup.centralizer ({u} : Set Y) ≤
      gamma2 (Subgroup.closure ({u * e, u, t} : Set Y)) (Subgroup.centralizer ({u} : Set Y)) := by
  intro x hx
  have hd := hc.data
  obtain ⟨o, ho, hm⟩ := p23_cu_split hT hc hZ hx
  have hB := B_isElemAbelian hc
  have hB8 := B_natCard hc
  have hBu : Subgroup.closure ({u * e, u, t} : Set Y) ≤ Subgroup.centralizer ({u} : Set Y) := by
    rw [Subgroup.closure_le]
    intro a ha
    rcases ha with rfl | rfl | rfl
    · exact ue_comm_u hc
    · exact Subgroup.mem_centralizer_singleton_iff.mpr rfl
    · exact Subgroup.mem_centralizer_singleton_iff.mpr (comm_ut hc).symm
  have hoG : o ∈ gamma2 (Subgroup.closure ({u * e, u, t} : Set Y)) (Subgroup.centralizer ({u} : Set Y)) :=
    CFSG.ClassicalInvolution.Asc77.S24.oddCore_le_gamma2_of hB hB8 hBu ho
  have hBle : Subgroup.closure ({u * e, u} : Set Y) ≤ Subgroup.closure ({u * e, u, t} : Set Y) :=
    Subgroup.closure_mono (by intro x hx; rcases hx with rfl | rfl <;> simp)
  have hAue : IsElemAbelian2 (Subgroup.closure ({u * e, u} : Set Y)) 2 :=
    T7A.isElemAbelian2_closure_pair (ue_sq hc) hd.hu2 (ue_ne_one hc) hd.hu1
      (fun h => hd.he1 (by simpa using h)) (by
        have := (Subgroup.mem_centralizer_singleton_iff.mp (ue_comm_u hc))
        exact this)
  have hoC : o ∈ Subgroup.centralizer ({u} : Set Y) := oddCoreOf_le_self _ ho
  have hmC : o⁻¹ * x ∈ Subgroup.centralizer ({u} : Set Y) :=
    Subgroup.mul_mem _ (Subgroup.inv_mem _ hoC) hx
  have hmG : o⁻¹ * x ∈ gamma2 (Subgroup.closure ({u * e, u, t} : Set Y))
      (Subgroup.centralizer ({u} : Set Y)) :=
    T7K.le_gamma2 hBle hAue ⟨hmC, T7B.mem_centralizer_closure_pair
      (Subgroup.mem_centralizer_singleton_iff.mp hm).symm
      (Subgroup.mem_centralizer_singleton_iff.mp hmC).symm⟩
  have := Subgroup.mul_mem _ hoG hmG
  simpa using this

@[expose] def P23YExitZC (n : ℕ) : Prop :=
  CIT3Below n → TL4.TightBelowRPlus 3 n →
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t : Y) (K' W : Subgroup Y)
    (u e g : Y), P23Cfg n Y R S t K' W u e g → ¬ SecNoExit R u → SecNoExit R e →
      SecOrthLift R e 6 (piSign 3 1) → u * e ∈ zStarOf (rLayer (Om R) u) →
      alphaOf (Subgroup.closure ({u, t} : Set Y)) = ⊥ →
      classicalInvolutionOddCore ↥(Subgroup.centralizer ({t} : Set Y)) = ⊥ →
      Subgroup.centralizer ({u} : Set Y) ≤ Subgroup.centralizer ({e} : Set Y) →
        Subgroup.centralizer ({t} : Set Y) ≤ Subgroup.centralizer ({e} : Set Y)

@[expose] def P23CtDec (n : ℕ) : Prop :=
  CIT3Below n → TL4.TightBelowRPlus 3 n →
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t : Y) (K' W : Subgroup Y)
    (u e g : Y), P23Cfg n Y R S t K' W u e g → SecNoExit R e →
      SecOrthLift R e 6 (piSign 3 1) →
      ∀ c ∈ Subgroup.centralizer ({t} : Set Y),
        ∃ d ∈ Subgroup.centralizer ((tightCore R ⊔ K' : Subgroup Y) : Set Y),
          c * d⁻¹ ∈ Subgroup.centralizer ({e} : Set Y)

theorem p23YExitZC_of_ctDec (hCt : P23CtDec n) : P23YExitZC n := by
  intro hcit hP Y _ _ R S t K' W u e g hc hnoU hno hEorth hZ hα hodd hCe c hct
  obtain ⟨d, hd, hcd⟩ := hCt hcit hP Y R S t K' W u e g hc hno hEorth c hct
  have hdu : d ∈ Subgroup.centralizer ({u} : Set Y) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact ((Subgroup.mem_centralizer_iff.mp hd) u hc.data.hu).symm
  have h := Subgroup.mul_mem _ hcd (hCe hdu)
  simpa using h

@[expose] def P23YExitAE (n : ℕ) : Prop :=
  CIT3Below n → TL4.TightBelowRPlus 3 n →
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t : Y) (K' W : Subgroup Y)
    (u e g : Y), P23Cfg n Y R S t K' W u e g → ¬ SecNoExit R u → SecAE R u 5 → SecNoExit R e →
      SecOrthLift R e 6 (piSign 3 1) → False

theorem p23YExitNE'_of_split (hE : TwinThmE.TwinThmEP n) (hT : TwinThmE.T4Supply)
    (hD4 : TwinCentRes.ModelFactD42) (hM12 : TwinCentRes.ModelFactM12) (hY5x : P23Y5Exit n)
    (hZC : P23YExitZC n) (hAE : P23YExitAE n) : P23YExitNE' n := by
  intro hcit hP Y _ _ R S t K' W u e g hc hnoU hno hEorth
  rcases hY5x hcit hP Y R S t K' W u e g hc hnoU with hZ | h5
  · have hY : YType R u e := Or.inl hZ
    obtain ⟨hodd, halpha⟩ := p23Alpha_proved hD4 hM12 hT hcit hP Y R S t K' W u e g hc hY
    have hTwo := p23TwoN_of_fuseN hE hcit hP (p23FuseN hP) Y R S t K' W u e g hc hno
    have hΓz := gamma_t hP hc hno
    have hΓu := p23_gamma_u_of_zstar (hT n hcit hP) hc hZ
    have hC := CoreData.of_S hc.std.perp.core
    have hα1 : alphaOf (Subgroup.closure ({u, t} : Set Y)) = ⊥ :=
      alpha_eq_bot_of_gamma hC.oddFree hTwo hΓz hΓu hodd halpha
    have hOddC := p23_oddCent_eq_bot₂ hD4 hT hcit hP hc hno hα1 halpha hTwo
    have hCe := p23_cu_le_ce (hT n hcit hP) hc hZ hα1 halpha
    have hCt := hZC hcit hP Y R S t K' W u e g hc hnoU hno hEorth hZ hα1 hOddC hCe
    haveI := CFSG.ClassicalInvolution.Q8P.coreLike_of_core hC
    have hecen : e ∈ Subgroup.center Y := by
      rw [Subgroup.mem_center_iff]
      intro y
      have hy : y ∈ Subgroup.centralizer ({u} : Set Y) ⊔ Subgroup.centralizer ({t} : Set Y) := by
        rw [hTwo]; exact Subgroup.mem_top y
      have hye : y ∈ Subgroup.centralizer ({e} : Set Y) :=
        (sup_le hCe hCt) hy
      exact Subgroup.mem_centralizer_singleton_iff.mp hye
    rw [CFSG.ClassicalInvolution.Q8P.Asc77.CoreLike.center_eq_bot (G := Y), Subgroup.mem_bot] at hecen
    exact hc.data.he1 hecen
  · exact hAE hcit hP Y R S t K' W u e g hc hnoU h5 hno hEorth

