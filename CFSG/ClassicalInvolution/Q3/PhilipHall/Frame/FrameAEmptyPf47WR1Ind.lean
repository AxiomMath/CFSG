variable {G : Type} [Group G] [Finite G]

set_option hygiene false in
local notation "𝕌𝕍" => (Subgroup.zpowers u ⊔ Subgroup.zpowers v : Subgroup G)
set_option hygiene false in
local notation "𝕏𝕏" =>
  ((J ⊓ Subgroup.normalizer (K : Set G)) ⊔ (K ⊓ Subgroup.normalizer (J : Set G)) : Subgroup G)
set_option hygiene false in
local notation "𝕐𝕐" => (pairNormalizers K J z j)
set_option hygiene false in
local notation "πN" => (QuotientGroup.mk' (classicalInvolutionOddCore G))
set_option hygiene false in
local notation "𝕄" => ((W.map (QuotientGroup.mk' (classicalInvolutionOddCore G))).comap
  (QuotientGroup.mk' (classicalInvolutionOddCore G)))

theorem inf_oddCore_eq_bot {P : Subgroup G} (hP : IsPGroup 2 P) :
    P ⊓ classicalInvolutionOddCore G = ⊥ :=
  TwinThmEW.inf_bot_of_isPGroup (CFSG.ComponentClassification.OddCore.odd_card G) hP

theorem eq_of_mk_eq {P : Subgroup G} (hP : IsPGroup 2 P) {a b : G} (ha : a ∈ P) (hb : b ∈ P)
    (h : πN a = πN b) : a = b := by
  have h1 : a⁻¹ * b ∈ P ⊓ classicalInvolutionOddCore G := by
    refine ⟨P.mul_mem (P.inv_mem ha) hb, ?_⟩
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at h
    exact h
  rw [inf_oddCore_eq_bot hP, Subgroup.mem_bot] at h1
  exact inv_mul_eq_one.mp h1

theorem conj_eq_of_comm {H : Type*} [Group H] {a b c : H} (hb : b * c = c * b)
    (ha : a * c = c * a) : (a⁻¹ * b) * c * (a⁻¹ * b)⁻¹ = c := by
  calc (a⁻¹ * b) * c * (a⁻¹ * b)⁻¹ = a⁻¹ * (b * c) * b⁻¹ * a := by group
    _ = a⁻¹ * (c * b) * b⁻¹ * a := by rw [hb]
    _ = a⁻¹ * (c * a) := by group
    _ = a⁻¹ * (a * c) := by rw [ha]
    _ = c := by group

namespace Data

variable {Ω : Set (Subgroup G)} {K J K' W : Subgroup G} {z j u v : G} {R R' T : Subgroup G}
  (d : Data Ω K J K' W z j u v R R' T)
include d

theorem W_le_M : W ≤ 𝕄 := Subgroup.le_comap_map _ _

theorem mk_comm {a b : G} (ha : a ∈ 𝕄) (hb : b ∈ 𝕄) : πN a * πN b = πN b * πN a := by
  obtain ⟨wa, hwa, ea⟩ := Subgroup.mem_comap.mp ha
  obtain ⟨wb, hwb, eb⟩ := Subgroup.mem_comap.mp hb
  rw [← ea, ← eb, ← map_mul, ← map_mul, d.hWab wa hwa wb hwb]

theorem abelian_of_le {P : Subgroup G} (hPM : P ≤ 𝕄) (hP : IsPGroup 2 P) :
    ∀ a ∈ P, ∀ b ∈ P, a * b = b * a := by
  intro a ha b hb
  refine eq_of_mk_eq hP (P.mul_mem ha hb) (P.mul_mem hb ha) ?_
  rw [map_mul, map_mul]
  exact d.mk_comm (hPM ha) (hPM hb)

theorem isSylow2In_UV {A : Subgroup G} (hEA : 𝕌𝕍 ≤ A) (hAY : A ≤ 𝕐𝕐) (hAM : A ≤ 𝕄) :
    IsSylow2In 𝕌𝕍 A := by
  refine ⟨hEA, d.hW2.to_le d.UV_le_W, fun P hPA hP2 hEP => ?_⟩
  have hab := d.abelian_of_le (hPA.trans hAM) hP2
  have hPC : P ≤ Subgroup.centralizer (𝕌𝕍 : Set G) := fun p hp =>
    Subgroup.mem_centralizer_iff.mpr fun e he => hab e (hEP he) p hp
  have h := d.hYW P hP2 hEP hPC
  rwa [inf_eq_right.mpr (hPA.trans hAY)] at h

theorem mem_X_of_conj {A : Subgroup G} (hEA : IsSylow2In 𝕌𝕍 A) (hAX : A ≤ 𝕏𝕏) (hAM : A ≤ 𝕄)
    {y : G} (hyY : y ∈ 𝕐𝕐) (hyA : conjSub y A = A)
    (hyc : ∀ e ∈ 𝕌𝕍, πN y * πN e = πN e * πN y) : y ∈ 𝕏𝕏 := by
  have hconj : IsSylow2In (conjSub y 𝕌𝕍) A := by
    have := hEA.conj y
    rwa [hyA] at this
  obtain ⟨x, hxA, hx⟩ := Sec6Gen.exists_conjSub_eq_of_isSylow2In hEA hconj
  have hxY : x ∈ 𝕐𝕐 := d.tor.hXY (hAX hxA)
  have hy'Y : x⁻¹ * y ∈ 𝕐𝕐 := Subgroup.mul_mem _ (Subgroup.inv_mem _ hxY) hyY
  have hy'N : conjSub (x⁻¹ * y) 𝕌𝕍 = 𝕌𝕍 := by
    rw [conjSub_mul, ← hx, conjSub_inv_conjSub]
  have hE2 : IsPGroup 2 𝕌𝕍 := d.hW2.to_le d.UV_le_W
  have hy'C : x⁻¹ * y ∈ Subgroup.centralizer (𝕌𝕍 : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro e he
    have hmem : (x⁻¹ * y) * e * (x⁻¹ * y)⁻¹ ∈ 𝕌𝕍 := by
      have := conj_mem_conjSub (n := x⁻¹ * y) he
      rwa [hy'N] at this
    have hxe : πN x * πN e = πN e * πN x := d.mk_comm (hAM hxA) (d.W_le_M (d.UV_le_W he))
    have hπ : πN ((x⁻¹ * y) * e * (x⁻¹ * y)⁻¹) = πN e := by
      simp only [map_mul, map_inv]
      exact conj_eq_of_comm (hyc e he) hxe
    have h1 := eq_of_mk_eq hE2 hmem he hπ
    calc e * (x⁻¹ * y) = ((x⁻¹ * y) * e * (x⁻¹ * y)⁻¹) * (x⁻¹ * y) := by rw [h1]
      _ = (x⁻¹ * y) * e := by group
  have hy'X : x⁻¹ * y ∈ 𝕏𝕏 := d.tor.hf ⟨hy'Y, hy'C⟩
  have e : y = x * (x⁻¹ * y) := by group
  rw [e]
  exact Subgroup.mul_mem _ (hAX hxA) hy'X

theorem inf_le_X : 𝕐𝕐 ⊓ 𝕄 ≤ 𝕏𝕏 := by
  intro h hh
  have hEX : 𝕌𝕍 ≤ 𝕏𝕏 := d.tor.UV_le_X
  have hEA : 𝕌𝕍 ≤ (𝕐𝕐 ⊓ 𝕄) ⊓ 𝕏𝕏 :=
    le_inf (le_inf (hEX.trans d.tor.hXY) (d.UV_le_W.trans d.W_le_M)) hEX
  have hsyl := d.isSylow2In_UV hEA (inf_le_left.trans inf_le_left)
    (inf_le_left.trans inf_le_right)
  refine d.mem_X_of_conj hsyl inf_le_right (inf_le_left.trans inf_le_right) hh.1 ?_ ?_
  · rw [conjSub_inf, conjSub_eq_self_of_mem hh,
      mem_normalizer_iff_conjSub_eq.mp (d.tor.hYX hh.1)]
  · intro e he
    exact d.mk_comm hh.2 (d.W_le_M (d.UV_le_W he))

theorem index [(W.map πN).Normal]
    (hD : Nonempty (((G ⧸ classicalInvolutionOddCore G) ⧸ W.map πN) ≃* DihedralGroup 6)) :
    𝕏𝕏 ≤ 𝕄 ∧ ∀ g : G, ∃ y ∈ 𝕐𝕐, ∃ w ∈ W, πN g = πN (y * w) := by
  obtain ⟨φ, hφs, hφk⟩ := d.hφ
  let ψ : ↥𝕐𝕐 →* ((G ⧸ classicalInvolutionOddCore G) ⧸ W.map πN) :=
    MonoidHom.comp (QuotientGroup.mk' (W.map πN)) (MonoidHom.comp πN (Subgroup.subtype 𝕐𝕐))
  have hmemker : ∀ y : ↥𝕐𝕐, y ∈ ψ.ker ↔ (y : G) ∈ 𝕄 := by
    intro y
    rw [MonoidHom.mem_ker, Subgroup.mem_comap]
    exact QuotientGroup.eq_one_iff _
  have hker : ψ.ker ≤ φ.ker := by
    intro y hy
    rw [hφk, Subgroup.mem_subgroupOf]
    exact d.inf_le_X ⟨y.2, (hmemker y).mp hy⟩
  have h12 : Nat.card ((G ⧸ classicalInvolutionOddCore G) ⧸ W.map πN) = 12 := by
    obtain ⟨e⟩ := hD
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
  have hφi : φ.ker.index = 12 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hφs, Subgroup.card_top,
      DihedralGroup.nat_card]
  have hdvd : φ.ker.index ∣ ψ.ker.index := Subgroup.index_dvd_of_le hker
  have hψi : ψ.ker.index = Nat.card ψ.range := Subgroup.index_ker ψ
  have hle : Nat.card ψ.range ≤ 12 := h12 ▸ Subgroup.card_le_card_group _
  have hpos : 0 < Nat.card ψ.range := Nat.card_pos
  have hψ12 : Nat.card ψ.range = 12 := by
    rw [hψi, hφi] at hdvd
    have := Nat.le_of_dvd hpos hdvd
    omega
  have htop : ψ.range = ⊤ := Subgroup.eq_top_of_card_eq _ (hψ12.trans h12.symm)
  have hkereq : ψ.ker = φ.ker := by
    refine Subgroup.eq_of_le_of_card_ge hker ?_
    have h1 := Subgroup.card_mul_index ψ.ker
    have h2 := Subgroup.card_mul_index φ.ker
    rw [hψi, hψ12] at h1
    rw [hφi] at h2
    omega
  refine ⟨fun x hx => ?_, fun g => ?_⟩
  · have hxY : x ∈ 𝕐𝕐 := d.tor.hXY hx
    have : (⟨x, hxY⟩ : ↥𝕐𝕐) ∈ ψ.ker := by
      rw [hkereq, hφk, Subgroup.mem_subgroupOf]
      exact hx
    exact (hmemker _).mp this
  · obtain ⟨y, hy⟩ : QuotientGroup.mk' (W.map πN) (πN g) ∈ ψ.range := by
      rw [htop]
      trivial
    have h1 : (πN (y : G))⁻¹ * πN g ∈ W.map πN := by
      have h2 : QuotientGroup.mk' (W.map πN) (πN (y : G)) =
          QuotientGroup.mk' (W.map πN) (πN g) := hy
      exact QuotientGroup.eq.mp h2
    obtain ⟨w, hw, hwe⟩ := h1
    refine ⟨y, y.2, w, hw, ?_⟩
    rw [map_mul, hwe]
    group

