variable {G : Type} [Group G] [Finite G]

theorem conjSub_zpowers' (g x : G) :
    conjSub g (Subgroup.zpowers x) = Subgroup.zpowers (g * x * g⁻¹) := by
  ext y
  rw [mem_conjSub_iff, Subgroup.mem_zpowers_iff, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [conj_zpow, hk]
    group
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [← hk, conj_zpow]
    group

theorem orderOf_conj' (g x : G) : orderOf (g * x * g⁻¹) = orderOf x := by
  rw [← Nat.card_zpowers, ← Nat.card_zpowers, ← conjSub_zpowers', natCard_conjSub]

theorem not_two_dvd_relIndex {P Z Y : Subgroup G} (hP : IsSylow2In P Y) (hPZ : P ≤ Z)
    (hZY : Z ≤ Y) : ¬ 2 ∣ Z.relIndex Y := by
  intro h2
  have e1 : Nat.card Z * Z.relIndex Y = Nat.card Y := by
    rw [← Subgroup.relIndex_bot_left, ← Subgroup.relIndex_bot_left,
      Subgroup.relIndex_mul_relIndex ⊥ Z Y bot_le hZY]
  have e2 := natCard_eq_pow_of_isSylow2In hP
  have h3 : 2 ^ (Nat.card Y).factorization 2 * 2 ∣ Nat.card Y := by
    rw [← e2]
    conv_rhs => rw [← e1]
    exact Nat.mul_dvd_mul (Subgroup.card_dvd_of_le hPZ) h2
  rw [← pow_succ] at h3
  exact Nat.pow_succ_factorization_not_dvd Nat.card_pos.ne' Nat.prime_two h3

theorem le_of_relIndex_dvd_two_pow {Z Y : Subgroup G} {n : ℕ} (hd : Z.relIndex Y ∣ 2 ^ n)
    (hodd : ¬ 2 ∣ Z.relIndex Y) : Y ≤ Z := by
  obtain ⟨i, -, hi⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hd
  rcases i with _ | i
  · exact Subgroup.relIndex_eq_one.mp (by simpa using hi)
  · exact absurd (hi ▸ dvd_pow_self 2 (Nat.succ_ne_zero i)) hodd

theorem eq_of_sylow_le_of_odd_mem {Y Z : Subgroup G} (S₁ : Sylow 2 G)
    (hS₁ : (S₁ : Subgroup G) ≤ Z) (hZY : Z ≤ Y) (hodd : ∀ y ∈ Y, Odd (orderOf y) → y ∈ Z) :
    Z = Y := by
  set X : Subgroup G := Subgroup.closure {y | y ∈ Y ∧ Odd (orderOf y)} with hXdef
  have hXZ : X ≤ Z := (Subgroup.closure_le Z).mpr fun y hy => hodd y hy.1 hy.2
  have hXY : X ≤ Y := (Subgroup.closure_le Y).mpr fun y hy => hy.1
  have hconj : ∀ g ∈ Y, ∀ x ∈ X, g * x * g⁻¹ ∈ X := by
    intro g hg x hx
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
      refine Subgroup.subset_closure ⟨Y.mul_mem (Y.mul_mem hg hy.1) (Y.inv_mem hg), ?_⟩
      rw [orderOf_conj']
      exact hy.2
    | one => simp
    | mul a b _ _ ha hb =>
      have e : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
      rw [e]
      exact X.mul_mem ha hb
    | inv a _ ha =>
      have e : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
      rw [e]
      exact X.inv_mem ha
  haveI hn : (X.subgroupOf Y).Normal := ⟨fun n hn g => by
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    exact hconj g g.2 n hn⟩
  have h2 : IsPGroup 2 (↥Y ⧸ X.subgroupOf Y) := by
    intro q
    induction q using QuotientGroup.induction_on with
    | H g =>
      have hn0 : orderOf (g : G) ≠ 0 := (orderOf_pos (g : G)).ne'
      obtain ⟨k, m, hm, hkm⟩ := Nat.exists_eq_two_pow_mul_odd hn0
      refine ⟨k, ?_⟩
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
      refine Subgroup.subset_closure ⟨Y.pow_mem g.2 _, ?_⟩
      rw [Subgroup.coe_pow, orderOf_pow_of_dvd (pow_ne_zero _ two_ne_zero) ⟨m, hkm⟩, hkm,
        Nat.mul_div_cancel_left _ (pow_pos two_pos _)]
      exact hm
  obtain ⟨t, ht⟩ := h2.exists_card_eq
  have hXi : X.relIndex Y = 2 ^ t := by
    rw [Subgroup.relIndex, Subgroup.index_eq_card, ht]
  have hd : Z.relIndex Y ∣ 2 ^ t := hXi ▸ Subgroup.relIndex_dvd_of_le_left Y hXZ
  exact le_antisymm hZY (le_of_relIndex_dvd_two_pow hd
    (not_two_dvd_relIndex (T8.isSylow2In_of_sylow_le S₁ (hS₁.trans hZY)) hS₁ hZY))

theorem le_oddCoreOf_sup {J P : Subgroup G}
    (h2 : IsPGroup 2 (↥J ⧸ classicalInvolutionOddCore ↥J)) (hP : IsSylow2In P J) :
    J ≤ oddCoreOf J ⊔ P := by
  have hZJ : oddCoreOf J ⊔ P ≤ J := sup_le (oddCoreOf_le_self J) hP.1
  obtain ⟨t, ht⟩ := h2.exists_card_eq
  have e : (oddCoreOf J).subgroupOf J = classicalInvolutionOddCore ↥J :=
    Subgroup.comap_map_eq_self_of_injective Subtype.coe_injective _
  have hXi : (oddCoreOf J).relIndex J = 2 ^ t := by
    rw [Subgroup.relIndex, e, Subgroup.index_eq_card, ht]
  have hd : (oddCoreOf J ⊔ P).relIndex J ∣ 2 ^ t :=
    hXi ▸ Subgroup.relIndex_dvd_of_le_left J le_sup_left
  exact le_of_relIndex_dvd_two_pow hd (not_two_dvd_relIndex hP le_sup_right hZJ)

theorem exists_pow_conj_eq {j o : G} (hj : j * j = 1) (ho : Odd (orderOf o))
    (hjo : j * o * (j * o) = 1) : ∃ k : ℕ, o ^ k * j * (o ^ k)⁻¹ = j * o := by
  obtain ⟨m, hm⟩ := ho
  have hji : j⁻¹ = j := (eq_inv_of_mul_eq_one_left hj).symm
  have h1 : j * o * j⁻¹ = o⁻¹ := by
    rw [hji]
    have : j * o * j * o = 1 := by rw [← hjo]; group
    exact eq_inv_of_mul_eq_one_left this
  have h2 : j * o ^ m * j = (o ^ m)⁻¹ := by
    have := conj_pow (a := j) (b := o) (i := m)
    rw [h1, hji] at this
    rw [← this, inv_pow]
  have h3 : o ^ m * o ^ m * o = 1 := by
    rw [← pow_add, ← pow_succ, ← two_mul, ← hm, pow_orderOf_eq_one]
  refine ⟨m, ?_⟩
  have h4 : (o ^ m)⁻¹ * (o ^ m)⁻¹ = o := by
    rw [← mul_inv_rev]
    exact (eq_inv_of_mul_eq_one_right h3).symm
  calc o ^ m * j * (o ^ m)⁻¹ = (j * j) * o ^ m * j * (o ^ m)⁻¹ := by rw [hj, one_mul]
    _ = j * (j * o ^ m * j) * (o ^ m)⁻¹ := by group
    _ = j * ((o ^ m)⁻¹ * (o ^ m)⁻¹) := by rw [h2]; group
    _ = j * o := by rw [h4]

theorem exists_conj_of_le_sup_odd {N P U : Subgroup G} (hN : Odd (Nat.card N))
    (hP : IsPGroup 2 P) (hPN : P ≤ Subgroup.normalizer (N : Set G)) (hU : IsPGroup 2 U)
    (hUle : U ≤ N ⊔ P) (hcard : Nat.card U = Nat.card P) : ∃ o ∈ N, conjSub o P = U := by
  have hP' : IsSylow2In P (N ⊔ P) := T7L.isSylow2In_sup_of_normalizes hN hP hPN
  have hU' : IsSylow2In U (N ⊔ P) := hP'.of_natCard_le hU hUle hcard.symm.le
  obtain ⟨x, hx, hxU⟩ := exists_conjSub_eq_of_isSylow2In hP' hU'
  obtain ⟨o, ho, p, hp, rfl⟩ := T7L.mem_sup_normalForm hPN hx
  refine ⟨o, ho, ?_⟩
  rwa [conjSub_mul, conjSub_eq_self_of_mem hp] at hxU

theorem odd_card_sup_of_le_normalizer' {H N : Subgroup G}
    (hHN : H ≤ Subgroup.normalizer (N : Set G)) (hH : Odd (Nat.card H)) (hN : Odd (Nat.card N)) :
    Odd (Nat.card (H ⊔ N : Subgroup G)) := by
  have := Subgroup.normal_subgroupOf_of_le_normalizer hHN
  have := Subgroup.normal_subgroupOf_sup_of_le_normalizer hHN
  have e := QuotientGroup.quotientInfEquivProdNormalizerQuotient H N hHN
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (N.subgroupOf (H ⊔ N)),
    ← Nat.card_congr e.toEquiv,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (le_sup_right : N ≤ H ⊔ N)).toEquiv]
  exact (Odd.of_dvd_nat hH (Subgroup.card_quotient_dvd_card _)).mul hN

theorem commute_of_thompson_AxB' {Q B : Subgroup G} {c : G} (hQ : IsPGroup 2 Q)
    (hB : IsPGroup 2 B) (hcQ : c ∈ Subgroup.normalizer (Q : Set G))
    (hBQ : B ≤ Subgroup.normalizer (Q : Set G)) (hc : Odd (orderOf c))
    (hcB : ∀ b ∈ B, c * b = b * c)
    (hfix : ∀ q ∈ Q, (∀ b ∈ B, q * b = b * q) → c * q = q * c) :
    ∀ q ∈ Q, c * q = q * c := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set A := Subgroup.zpowers c with hAdef
  have hAQ : A ≤ Subgroup.normalizer (Q : Set G) := Subgroup.zpowers_le.mpr hcQ
  let α : A →* MulAut Q := Q.normalizerMonoidHom.comp (Subgroup.inclusion hAQ)
  let β : B →* MulAut Q := Q.normalizerMonoidHom.comp (Subgroup.inclusion hBQ)
  have hα : ∀ (a : A) (q : Q), ((α a q : Q) : G) = (a : G) * q * (a : G)⁻¹ := fun _ _ => rfl
  have hβ : ∀ (b : B) (q : Q), ((β b q : Q) : G) = (b : G) * q * (b : G)⁻¹ := fun _ _ => rfl
  have hA2 : ¬ 2 ∣ Nat.card A := by
    rw [hAdef, Nat.card_zpowers]
    exact Nat.odd_iff.mp hc |> fun h => by omega
  have hab : ∀ (a : A) (b : B), (a : G) * b = b * a := by
    rintro ⟨a, ha⟩ ⟨b, hb⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    exact (Commute.zpow_left (hcB b hb) k).eq
  have hcomm : ∀ a b, α a * β b = β b * α a := by
    intro a b
    ext q
    simp only [MulAut.mul_apply]
    rw [hα, hβ, hβ, hα]
    calc (a : G) * ((b : G) * q * (b : G)⁻¹) * (a : G)⁻¹
        = ((a : G) * b) * q * ((a : G) * b)⁻¹ := by group
      _ = ((b : G) * a) * q * ((b : G) * a)⁻¹ := by rw [hab a b]
      _ = (b : G) * ((a : G) * q * (a : G)⁻¹) * (b : G)⁻¹ := by group
  have hfix' : ∀ a r, (∀ b, β b r = r) → α a r = r := by
    rintro ⟨a, ha⟩ r hr
    have hrB : ∀ b ∈ B, (r : G) * b = b * r := by
      intro b hb
      have h := congrArg Subtype.val (hr ⟨b, hb⟩)
      rw [hβ] at h
      calc (r : G) * b = b * r * b⁻¹ * b := by rw [h]
        _ = b * r := by group
    have hcr := hfix r r.2 hrB
    apply Subtype.ext
    rw [hα]
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    have : Commute (c ^ k) (r : G) := Commute.zpow_left hcr k
    change c ^ k * r * (c ^ k)⁻¹ = r
    rw [this.eq]
    group
  have h := CFSG.GroupTheory.thompson_A_times_B hQ hA2 hB α β hcomm hfix'
  intro q hq
  have hq' := congrArg (fun φ : MulAut Q => ((φ ⟨q, hq⟩ : Q) : G))
    (h ⟨c, Subgroup.mem_zpowers c⟩)
  rw [hα] at hq'
  change c * q * c⁻¹ = ((1 : MulAut Q) ⟨q, hq⟩ : G) at hq'
  rw [MulAut.one_apply] at hq'
  calc c * q = c * q * c⁻¹ * c := by group
    _ = q * c := by rw [hq']

theorem eq_one_of_odd_of_isPGroup {Q : Type*} [Group Q] {P : Subgroup Q} (hP : IsPGroup 2 P)
    {x : Q} (hx : x ∈ P) (hodd : Odd (orderOf x)) : x = 1 := by
  obtain ⟨k, hk⟩ := hP ⟨x, hx⟩
  have hk' : x ^ 2 ^ k = 1 := by
    have := congrArg Subtype.val hk
    simpa using this
  have hd := orderOf_dvd_of_pow_eq_one hk'
  obtain ⟨i, -, hi⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hd
  rcases i with _ | i
  · exact orderOf_eq_one_iff.mp (by simpa using hi)
  · exfalso
    rw [hi, Nat.odd_iff] at hodd
    rw [pow_succ] at hodd
    omega

end Generic

