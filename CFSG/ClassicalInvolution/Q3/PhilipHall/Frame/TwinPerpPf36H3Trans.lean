variable {G : Type} [Group G] [Finite G] {Ω : Set (Subgroup G)}
  {K K' W : Subgroup G} {S : Sylow 2 G} {R R' : Subgroup G} {z u : G}
  (H : Asc77.S24B.HCtx Ω K K' W S R R' z u)

local notation "Cz" => Subgroup.centralizer (Singleton.singleton z : Set G)
local notation "Oz" => oddCoreOf (Subgroup.centralizer (Singleton.singleton z : Set G))

structure TC (S₁ : Sylow 2 G) : Prop where
  hS₁W : (S₁ : Subgroup G) ≤ Subgroup.normalizer (W : Set G)
  hRS₁ : R ≤ (S₁ : Subgroup G)
  hR'S₁ : R' ≤ (S₁ : Subgroup G)
  haS₁ : H.a ∈ Subgroup.centralizer ((S₁ : Subgroup G) : Set G)

include H in
theorem W_le_Cz : W ≤ Cz := fun w hw => Subgroup.mem_centralizer_singleton_iff.mpr
  (Q3.Q3CL.Thompson.commutes_of_mem_WSet H.C.D.c.hΩ H.C.D.c.hW _ hw _ H.C.hd.hzW)

include H in
theorem W_comm {v w : G} (hv : v ∈ W) (hw : w ∈ W) : v * w = w * v :=
  Q3.Q3CL.Thompson.commutes_of_mem_WSet H.C.D.c.hΩ H.C.D.c.hW _ hv _ hw

include H in
theorem isPGroup_W : IsPGroup 2 W := S.isPGroup'.to_le H.C.hd.hWS

include H in
theorem exists_weaklyClosed : ∃ S₀ : Sylow 2 G, W ≤ (S₀ : Subgroup G) ∧
    AschTight.Sec7.WeaklyClosedIn W (S₀ : Subgroup G) := by
  let F := H.C.toCtx8.toFrame
  obtain ⟨η, hηG, hWη⟩ := id H.C.hd.hW
  obtain ⟨S₀, hηS₀, hinv⟩ := id hηG
  have hUS₀ : ∀ U ∈ η, U ≤ (S₀ : Subgroup G) := fun U hU => (hηS₀.1 hU).2
  have hWS₀ : W ≤ (S₀ : Subgroup G) := by
    rw [hWη]; exact iSup₂_le fun U hU => hUS₀ U hU
  refine ⟨S₀, hWS₀, ?_⟩
  have htr : ∀ K₁ ∈ Ω, ∀ J ∈ Ω, ∃ g : G, conjSub g K₁ = J := by
    intro K₁ hK₁ J hJ
    obtain ⟨g₁, rfl⟩ := F.trans K₁ hK₁
    obtain ⟨g₂, rfl⟩ := F.trans J hJ
    exact ⟨g₂ * g₁⁻¹, by rw [conjSub_mul, conjSub_inv_conjSub]⟩
  have h612 := CFSG.ClassicalInvolution.Q8P.Disconnected.AschTight.Sec7.l6_12_mod G Ω
    ⟨F.hyp, F.partI.cls, F.partI.aEmpty⟩ htr S₀
  dsimp only at h612
  rcases h612 with ⟨η₀, -, -, huniq, hwc⟩ | h2
  · have hMS₀ : (⨆ U ∈ {U : Subgroup G | (∃ η ∈ etaG Ω, U ∈ η) ∧ U ≤ (S₀ : Subgroup G)}, U) ≤
        (S₀ : Subgroup G) := iSup₂_le fun U hU => hU.2
    have hηeq : η = η₀ := huniq η hηG fun m hm U hU => hinv m (hMS₀ hm) U hU
    subst hηeq
    intro g hg
    rw [hWη] at hg ⊢
    refine AschTight.Sec7.conjSub_iSup_eq_of_forall_mem (hwc g fun U hU => ?_)
    exact le_trans (conjSub_mono (le_iSup₂ (f := fun V (_ : V ∈ η) => V) U hU)) hg
  · exact (F.not_alt_two hWS₀ h2).elim

theorem conj_mem_zhat_of_centralizer {a' g : G} (ha' : a' ∈ zhat H.hΩ W)
    (ha'W : a' ∈ Subgroup.centralizer (W : Set G))
    (hg : g * a' * g⁻¹ ∈ Subgroup.centralizer (W : Set G)) : g * a' * g⁻¹ ∈ zhat H.hΩ W := by
  obtain ⟨S₀, -, hWC⟩ := H.exists_weaklyClosed
  obtain ⟨n, hn, hn'⟩ :=
    AschTight.Sec7.control_centralizer_of_weaklyClosed H.isPGroup_W hWC ha'W hg
  rw [← hn']
  exact conj_mem_zhat H.hΩ hn ha'

theorem z_not_mem_zhat : z ∉ zhat H.hΩ W := by
  intro hz
  have hsM : H.C.D.F.ρ₃.r ∈ MGrp Ω W :=
    Thompson.le_MGrp_of_mem_D H.C.D.F.ρ₃.hR H.C.D.F.ρ₃.hr
  have h := hz.2 _ hsM
  have hs := H.C.s_conj_z
  have e : z * H.C.D.F.ρ₃.r * z⁻¹ * H.C.D.F.ρ₃.r⁻¹ = H.C.D.F.j⁻¹ := by
    calc z * H.C.D.F.ρ₃.r * z⁻¹ * H.C.D.F.ρ₃.r⁻¹
        = z * (H.C.D.F.ρ₃.r * z * H.C.D.F.ρ₃.r⁻¹)⁻¹ := by group
      _ = z * (z * H.C.D.F.j)⁻¹ := by rw [hs]
      _ = z * (H.C.D.F.j * z)⁻¹ := by rw [H.C.comm_jz]
      _ = H.C.D.F.j⁻¹ := by group
  rw [e] at h
  have hj2 : H.C.D.F.j⁻¹ * H.C.D.F.j⁻¹ = 1 := by
    rw [← mul_inv_rev, H.C.hjJ.sq, inv_one]
  have h1 := eq_one_of_isPGroup_of_mem_odd (oddCoreOf_odd_natCard _) h
    (ExactLayer.isPGroup_zpowers_of_sq_eq_one hj2)
  exact H.C.hjJ.ne_one (inv_eq_one.mp h1)

variable {H} {S₁ : Sylow 2 G}

theorem TC.le_Cz (hT : H.TC S₁) : (S₁ : Subgroup G) ≤ Cz := by
  let F := H.C.toCtx8.toFrame
  intro y hy
  have hΩ := F.hyp
  have hT' : conjSub y R ∈ RSet Ω := RSet.conj hΩ.conjInvariant H.C.hd.hR.1 y
  have hTS : conjSub y R ≤ (S₁ : Subgroup G) := by
    have h := conjSub_mono (n := y) hT.hRS₁
    rwa [conjSub_eq_self_of_mem hy] at h
  have hL : conjSub y K ∈ Ω := hΩ.conjInvariant y K F.mem
  have hTL : conjSub y R ≤ conjSub y K := conjSub_mono H.C.hd.hR.2.1
  have hT2 : IsPGroup 2 ↥(conjSub y R) := S₁.isPGroup'.to_le hTS
  have h8 : Nat.card ↥(conjSub y R) = 8 := by rw [natCard_conjSub]; exact H.C.h8
  have hK : conjSub y K = K ∨ conjSub y K = K' := by
    by_cases hTR : conjSub y R = R
    · left
      exact (hΩ.eq_of_le_of_le F.mem hL hT2 (by omega) ((le_of_eq hTR).trans H.C.hd.hR.2.1)
        hTL).symm
    · by_cases hLK : conjSub y K = K
      · exact Or.inl hLK
      · right
        have hcomm := CFSG.ClassicalInvolution.Q3.Q3CP.l67Gen G Ω hΩ S₁ R H.C.hd.hR.1 _ hT'
          hT.hRS₁ hTS (Ne.symm hTR)
        have hTc : conjSub y R ≤ Subgroup.centralizer ({z} : Set G) := fun t ht => by
          rw [Subgroup.mem_centralizer_singleton_iff]
          exact (hcomm z H.C.z_mem_R t ht).symm
        have hTN := hΩ.le_normalizer_of_le_centralizer F.mem hL (Ne.symm hLK)
          H.C.hzK hTL hT2 (by omega) hTc
        have hnbr : conjSub y K ∈ omegaNbr Ω K := ⟨hL, hLK, _, hT', hTL, hTN⟩
        have hperp : conjSub y K ∈ KPerp Ω K := Set.mem_insert_of_mem _ hnbr
        rw [F.perp] at hperp
        rcases hperp with h | h
        · exact absurd h hLK
        · exact h
  rw [Subgroup.mem_centralizer_singleton_iff]
  have h1 := H.C.hzK.conj y
  have h2 : y * z * y⁻¹ = z := by
    rcases hK with h | h
    · rw [h] at h1; exact (H.C.hzK.eq h1).symm
    · rw [h] at h1; exact (H.C.hzK'.eq h1).symm
  calc y * z = y * z * y⁻¹ * y := by group
    _ = z * y := by rw [h2]

theorem TC.inf_K (hT : H.TC S₁) : (S₁ : Subgroup G) ⊓ K ≤ R :=
  le_of_eq (H.C.hRsyl.2.2 _ inf_le_right (S₁.isPGroup'.to_le inf_le_left)
    (le_inf hT.hRS₁ H.C.hd.hR.2.1))

theorem TC.inf_K' (hT : H.TC S₁) : (S₁ : Subgroup G) ⊓ K' ≤ R' :=
  le_of_eq (H.hR'syl.2.2 _ inf_le_right (S₁.isPGroup'.to_le inf_le_left)
    (le_inf hT.hR'S₁ H.C.hd.hR'.2.1))

theorem TC.a_mem (hT : H.TC S₁) : H.a ∈ (S₁ : Subgroup G) := by
  have hza : Subgroup.zpowers H.a ≤ Subgroup.normalizer ((S₁ : Subgroup G) : Set G) :=
    Subgroup.zpowers_le.mpr (Subgroup.centralizer_le_normalizer _ hT.haS₁)
  have hP : IsPGroup 2 ↥(Subgroup.zpowers H.a ⊔ (S₁ : Subgroup G)) :=
    IsPGroup.to_sup_of_normal_right' (ExactLayer.isPGroup_zpowers_of_sq_eq_one H.ha2)
      S₁.isPGroup' hza
  have := S₁.is_maximal' hP le_sup_right
  rw [← this]
  exact Subgroup.mem_sup_left (Subgroup.mem_zpowers _)

omit [Finite G] in
theorem Oz_le_Cz : Oz ≤ Cz := oddCoreOf_le_self _

omit [Finite G] in
theorem conjSub_Oz {c : G} (hc : c ∈ Cz) : conjSub c Oz = Oz :=
  mem_normalizer_iff_conjSub_eq.mp (T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer hc))

omit [Finite G] in
theorem conjSub_sup_Oz {c : G} (hc : c ∈ Cz) (U : Subgroup G) :
    conjSub c (U ⊔ Oz) = conjSub c U ⊔ Oz := by
  rw [conjSub_sup, conjSub_Oz hc]

theorem conj_sup_Oz_of_comm {y : G} (hy : y ∈ Cz) {U : Subgroup G}
    (hU : ∀ u ∈ U, y * u * y⁻¹ * u⁻¹ ∈ Oz) : conjSub y (U ⊔ Oz) = U ⊔ Oz := by
  apply AschTight.Sec7.conjSub_eq_of_le_self
  rw [conjSub_sup_Oz hy]
  refine sup_le ?_ le_sup_right
  intro x hx
  rw [mem_conjSub_iff] at hx
  have e : x = (y * (y⁻¹ * x * y) * y⁻¹ * (y⁻¹ * x * y)⁻¹) * (y⁻¹ * x * y) := by group
  rw [e]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_right (hU _ hx)) (Subgroup.mem_sup_left hx)

omit [Finite G] in
theorem conj_sup_Oz_of_normalizes {y : G} (hy : y ∈ Cz) {U : Subgroup G}
    (hyU : conjSub y U = U) : conjSub y (U ⊔ Oz) = U ⊔ Oz := by
  rw [conjSub_sup_Oz hy, hyU]

variable (H) in
include H in
theorem oddCore_le_Oz {M : Subgroup G} (hM : M ∈ Ω) (hzM : IsUniqueInvolution M z) :
    oddCoreOf M ≤ Oz :=
  Balance.oddCoreIn_le_of_isSubnormal (H.C.hs.stand.cls.isSubnormal_of_uniqueInvolution hM hzM)

variable (H) in
include H in
theorem conj_sup_Oz_of_mem_member {M P U : Subgroup G} (hM : M ∈ Ω)
    (hzM : IsUniqueInvolution M z) (hP : IsSylow2In P M) (hPU : ∀ p ∈ P, conjSub p U = U)
    {k : G} (hk : k ∈ M) : conjSub k (U ⊔ Oz) = U ⊔ Oz := by
  have hkM : k ∈ oddCoreOf M ⊔ P := le_oddCoreOf_sup (H.C.hyp.std.1.quot2 M hM) hP hk
  have hPN : P ≤ Subgroup.normalizer (oddCoreOf M : Set G) := fun x hx =>
    T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer (hP.1 hx))
  obtain ⟨o, ho, p, hp, rfl⟩ := T7L.mem_sup_normalForm hPN hkM
  have hMz : M ≤ Cz := le_centralizer_of_unique hzM
  rw [conjSub_mul, conj_sup_Oz_of_normalizes (hMz (hP.1 hp)) (hPU p hp)]
  exact conjSub_eq_self_of_mem (Subgroup.mem_sup_right (H.oddCore_le_Oz hM hzM ho))

variable (H) in
@[expose] def NN : Subgroup G where
  carrier := {n | n ∈ Cz ∧ ∀ c ∈ Cz,
    conjSub n (conjSub c (Subgroup.zpowers H.C.D.x₁ ⊔ Oz)) =
        conjSub c (Subgroup.zpowers H.C.D.x₁ ⊔ Oz) ∧
      conjSub n (conjSub c (Subgroup.zpowers H.C.D.x₂ ⊔ Oz)) =
        conjSub c (Subgroup.zpowers H.C.D.x₂ ⊔ Oz)}
  one_mem' := ⟨Subgroup.one_mem _, fun c _ => ⟨conjSub_one _, conjSub_one _⟩⟩
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨Subgroup.mul_mem _ ha hb, fun c hc => ⟨?_, ?_⟩⟩
    · rw [conjSub_mul, (hb' c hc).1, (ha' c hc).1]
    · rw [conjSub_mul, (hb' c hc).2, (ha' c hc).2]
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    exact ⟨Subgroup.inv_mem _ ha, fun c hc =>
      ⟨AschTight.Sec7.conjSub_inv_eq (ha' c hc).1, AschTight.Sec7.conjSub_inv_eq (ha' c hc).2⟩⟩

variable (H) in
theorem NN_le : H.NN ≤ Cz := fun _ hn => hn.1

variable (H) in
theorem conj_mem_NN {g n : G} (hg : g ∈ Cz) (hn : n ∈ H.NN) : g * n * g⁻¹ ∈ H.NN := by
  refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hg hn.1) (Subgroup.inv_mem _ hg),
    fun c hc => ⟨?_, ?_⟩⟩
  · rw [conjSub_mul, conjSub_mul, ← conjSub_mul g⁻¹ c,
      (hn.2 _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hg) hc)).1, ← conjSub_mul,
      mul_inv_cancel_left]
  · rw [conjSub_mul, conjSub_mul, ← conjSub_mul g⁻¹ c,
      (hn.2 _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hg) hc)).2, ← conjSub_mul,
      mul_inv_cancel_left]

variable (H) in
theorem Cz_le_normalizer_NN : Cz ≤ Subgroup.normalizer (H.NN : Set G) := by
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro n
  refine ⟨fun hn => H.conj_mem_NN hg hn, fun hn => ?_⟩
  have := H.conj_mem_NN (Subgroup.inv_mem _ hg) hn
  simpa [mul_assoc] using this

theorem R_le_normalizer_x₁ : ∀ p ∈ R, conjSub p (Subgroup.zpowers H.C.D.x₁) =
    Subgroup.zpowers H.C.D.x₁ := by
  intro p hp
  rw [H.C.D.h₁, H.C.hR, conjSub_inf, conjSub_eq_self_of_mem hp,
    mem_normalizer_iff_conjSub_eq.mp (H.R_le_normalizer hp)]

theorem R'_le_normalizer_x₂ : ∀ p ∈ R', conjSub p (Subgroup.zpowers H.C.D.x₂) =
    Subgroup.zpowers H.C.D.x₂ := by
  intro p hp
  rw [H.C.D.h₂, H.C.hR', conjSub_inf, conjSub_eq_self_of_mem hp,
    mem_normalizer_iff_conjSub_eq.mp (H.R'_le_normalizer hp)]

omit [Finite G] in
theorem conj_normalizes {c : G} {P U : Subgroup G} (hPU : ∀ p ∈ P, conjSub p U = U) :
    ∀ p ∈ conjSub c P, conjSub p (conjSub c U) = conjSub c U := by
  intro p hp
  rw [mem_conjSub_iff] at hp
  have e : p * c = c * (c⁻¹ * p * c) := by group
  rw [← conjSub_mul, e, conjSub_mul, hPU _ hp]

theorem mem_NN_of {y : G} (hy : y ∈ Cz)
    (hfix : ∀ M P U : Subgroup G, (M = K ∨ M = K') → IsSylow2In P M → U ≤ P →
      (∀ p ∈ P, conjSub p U = U) → conjSub y (U ⊔ Oz) = U ⊔ Oz) : y ∈ H.NN := by
  refine ⟨hy, fun c hc => ⟨?_, ?_⟩⟩
  · rw [conjSub_sup_Oz hc]
    have hM : conjSub c K = K ∨ conjSub c K = K' := by
      rcases Asc77.S24.twin_cases H.C hc with h | h
      · exact Or.inl h.1
      · exact Or.inr h.1
    exact hfix _ _ _ hM (H.C.hRsyl.conj c)
      (conjSub_mono (Subgroup.zpowers_le.mpr H.C.x₁_mem_R)) (conj_normalizes H.R_le_normalizer_x₁)
  · rw [conjSub_sup_Oz hc]
    have hM : conjSub c K' = K ∨ conjSub c K' = K' := by
      rcases Asc77.S24.twin_cases H.C hc with h | h
      · exact Or.inr h.2
      · exact Or.inl h.2
    exact hfix _ _ _ hM (H.hR'syl.conj c)
      (conjSub_mono (Subgroup.zpowers_le.mpr H.C.x₂_mem_R')) (conj_normalizes H.R'_le_normalizer_x₂)

include H in
theorem K_ne_K' : K ≠ K' := fun h => H.C.hs.hne h.symm

variable (H) in
theorem K_le_NN : K ≤ H.NN := by
  intro k hk
  refine H.mem_NN_of (le_centralizer_of_unique H.C.hzK hk) fun M P U hM hP hUP hPU => ?_
  rcases hM with rfl | rfl
  · exact H.conj_sup_Oz_of_mem_member H.C.hs.stand.mem H.C.hzK hP hPU hk
  · refine conj_sup_Oz_of_comm (le_centralizer_of_unique H.C.hzK hk) fun u hu => ?_
    have h := H.hΩ.comm_le_oddCore_of_twin H.C.hs.stand.mem H.C.hs.hK'.1 H.K_ne_K' H.C.hzK
      H.C.hzK' (Subgroup.commutator_mem_commutator hk (hP.1 (hUP hu)))
    rw [commutatorElement_def] at h
    exact H.oddCore_le_Oz H.C.hs.stand.mem H.C.hzK h.1

variable (H) in
theorem K'_le_NN : K' ≤ H.NN := by
  intro k hk
  refine H.mem_NN_of (le_centralizer_of_unique H.C.hzK' hk) fun M P U hM hP hUP hPU => ?_
  rcases hM with rfl | rfl
  · refine conj_sup_Oz_of_comm (le_centralizer_of_unique H.C.hzK' hk) fun u hu => ?_
    have h := H.hΩ.comm_le_oddCore_of_twin H.C.hs.hK'.1 H.C.hs.stand.mem H.K_ne_K'.symm H.C.hzK'
      H.C.hzK (Subgroup.commutator_mem_commutator hk (hP.1 (hUP hu)))
    rw [commutatorElement_def] at h
    exact H.oddCore_le_Oz H.C.hs.hK'.1 H.C.hzK' h.1
  · exact H.conj_sup_Oz_of_mem_member H.C.hs.hK'.1 H.C.hzK' hP hPU hk

variable (H) in
theorem a_mem_NN : H.a ∈ H.NN := by
  have haz : H.a ∈ Cz := Subgroup.mem_centralizer_singleton_iff.mpr H.comm_z.symm
  refine H.mem_NN_of haz fun M P U hM hP hUP _ => ?_
  have htq : H.a ∈ Balance.Bootstrap.trivialOnQuot M := by
    rcases hM with rfl | rfl
    · exact (H.K_tq H.a H.ha2 H.haR).2
    · exact (H.K'_tq H.a H.ha2 H.haR').2
  have hzM : IsUniqueInvolution M z := by
    rcases hM with rfl | rfl
    · exact H.C.hzK
    · exact H.C.hzK'
  have hMΩ : M ∈ Ω := by
    rcases hM with rfl | rfl
    · exact H.C.hs.stand.mem
    · exact H.C.hs.hK'.1
  refine conj_sup_Oz_of_comm haz fun u hu => ?_
  have h := (Balance.Bootstrap.mem_trivialOnQuot_iff.mp htq).2 u (hP.1 (hUP hu))
  rw [commutatorElement_def] at h
  exact H.oddCore_le_Oz hMΩ hzM h

variable (H) in
@[expose] def TT (S₁ : Sylow 2 G) : Subgroup G := (S₁ : Subgroup G) ⊓ H.NN

variable (H) in
@[expose] def YY (S₁ : Sylow 2 G) : Subgroup G :=
  Subgroup.centralizer ({z} : Set G) ⊓ Subgroup.normalizer (H.TT S₁ : Set G)

theorem TC.isSylow2In_TT (hT : H.TC S₁) : IsSylow2In (H.TT S₁) H.NN :=
  isSylow2In_inf_of_le_normalizer (T8.isSylow2In_of_sylow_le S₁ hT.le_Cz) (H.NN_le)
    (H.Cz_le_normalizer_NN)

theorem TC.frattini (hT : H.TC S₁) {g : G} (hg : g ∈ Cz) :
    ∃ n ∈ H.NN, ∃ y ∈ H.YY S₁, g = n * y := by
  have hTs := hT.isSylow2In_TT
  have hgT : conjSub g (H.TT S₁) ≤ H.NN := by
    intro x hx
    rw [mem_conjSub_iff] at hx
    have := H.conj_mem_NN hg (hTs.1 hx)
    simpa [mul_assoc] using this
  have hgs : IsSylow2In (conjSub g (H.TT S₁)) H.NN :=
    hTs.of_natCard_le (isPGroup_conjSub g hTs.2.1) hgT
      (by rw [natCard_conjSub])
  obtain ⟨n, hn, hnT⟩ := exists_conjSub_eq_of_isSylow2In hTs hgs
  refine ⟨n, hn, n⁻¹ * g, Subgroup.mem_inf.mpr
    ⟨Subgroup.mul_mem _ (Subgroup.inv_mem _ (H.NN_le hn)) hg, ?_⟩, (mul_inv_cancel_left n g).symm⟩
  rw [mem_normalizer_iff_conjSub_eq, conjSub_mul, ← hnT, conjSub_inv_conjSub]

theorem TC.le_YY (hT : H.TC S₁) : (S₁ : Subgroup G) ≤ H.YY S₁ := by
  intro s hs
  refine Subgroup.mem_inf.mpr ⟨hT.le_Cz hs, ?_⟩
  rw [mem_normalizer_iff_conjSub_eq, TT, conjSub_inf, conjSub_eq_self_of_mem hs,
    mem_normalizer_iff_conjSub_eq.mp (H.Cz_le_normalizer_NN (hT.le_Cz hs))]

variable (H) in
@[expose] def Pa (S₁ : Sylow 2 G) (a' : G) : Prop :=
  a' ∈ H.TT S₁ ∧ a' ∈ zhat H.hΩ W ∧ R ≤ Subgroup.centralizer ({a'} : Set G) ∧
    R' ≤ Subgroup.centralizer ({a'} : Set G) ∧ W ≤ Subgroup.centralizer ({a'} : Set G)

theorem TC.pa_a (hT : H.TC S₁) : H.Pa S₁ H.a :=
  ⟨Subgroup.mem_inf.mpr ⟨hT.a_mem, H.a_mem_NN⟩, H.a_mem_zhat, H.haR, H.haR',
    H.W_le_centralizer_a⟩

theorem TC.pa_conj_S₁ (hT : H.TC S₁) {s a' : G} (hs : s ∈ (S₁ : Subgroup G))
    (ha' : H.Pa S₁ a') : H.Pa S₁ (s * a' * s⁻¹) := by
  obtain ⟨haT, haZ, haR, haR', haW⟩ := ha'
  have hsY := hT.le_YY hs
  have hsz := hT.le_Cz hs
  have hsi : s⁻¹ ∈ (S₁ : Subgroup G) := Subgroup.inv_mem _ hs
  have hcomm : ∀ {x : G}, (s⁻¹ * x * s) * a' = a' * (s⁻¹ * x * s) →
      x * (s * a' * s⁻¹) = s * a' * s⁻¹ * x := by
    intro x h
    calc x * (s * a' * s⁻¹) = s * ((s⁻¹ * x * s) * a') * s⁻¹ := by group
      _ = s * (a' * (s⁻¹ * x * s)) * s⁻¹ := by rw [h]
      _ = s * a' * s⁻¹ * x := by group
  have hmemK : ∀ {x : G} {L : Subgroup G}, conjSub s⁻¹ L = L → x ∈ L → s⁻¹ * x * s ∈ L := by
    intro x L hL hx
    rw [← hL, mem_conjSub_iff]
    simpa [mul_assoc] using hx
  have hmemK' : ∀ {x : G} {L L' : Subgroup G}, conjSub s⁻¹ L = L' → x ∈ L → s⁻¹ * x * s ∈ L' := by
    intro x L L' hL hx
    rw [← hL, mem_conjSub_iff]
    simpa [mul_assoc] using hx
  have hRR : ∀ {x : G}, x ∈ (S₁ : Subgroup G) → (x ∈ K ∨ x ∈ K') →
      s⁻¹ * x * s ∈ R ∨ s⁻¹ * x * s ∈ R' := by
    intro x hxS hxK
    have hxS' : s⁻¹ * x * s ∈ (S₁ : Subgroup G) :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ hsi hxS) hs
    rcases Asc77.S24.twin_cases H.C (Subgroup.inv_mem _ hsz) with h | h
    · rcases hxK with hx | hx
      · exact Or.inl (hT.inf_K ⟨hxS', hmemK h.1 hx⟩)
      · exact Or.inr (hT.inf_K' ⟨hxS', hmemK h.2 hx⟩)
    · rcases hxK with hx | hx
      · exact Or.inr (hT.inf_K' ⟨hxS', hmemK' h.1 hx⟩)
      · exact Or.inl (hT.inf_K ⟨hxS', hmemK' h.2 hx⟩)
  have hRR' : ∀ {x : G}, s⁻¹ * x * s ∈ R ∨ s⁻¹ * x * s ∈ R' →
      x * (s * a' * s⁻¹) = s * a' * s⁻¹ * x := by
    intro x h
    refine hcomm ?_
    rcases h with h | h
    · exact Subgroup.mem_centralizer_singleton_iff.mp (haR h)
    · exact Subgroup.mem_centralizer_singleton_iff.mp (haR' h)
  refine ⟨?_, conj_mem_zhat H.hΩ (hT.hS₁W hs) haZ, ?_, ?_, ?_⟩
  · exact (Subgroup.mem_normalizer_iff.mp (Subgroup.mem_inf.mp hsY).2 a').mp haT
  · intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hRR' (hRR (hT.hRS₁ hx) (Or.inl (H.C.hd.hR.2.1 hx)))
  · intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hRR' (hRR (hT.hR'S₁ hx) (Or.inr (H.C.hd.hR'.2.1 hx)))
  · intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    refine hcomm ?_
    have hx' : s⁻¹ * x * s ∈ W := by
      have := (Subgroup.mem_normalizer_iff.mp (hT.hS₁W hsi) x).mp hx
      simpa using this
    exact Subgroup.mem_centralizer_singleton_iff.mp (haW hx')

theorem TC.pa_conj_odd (hT : H.TC S₁) {h a' : G} (hh : h ∈ H.YY S₁) (hodd : Odd (orderOf h))
    (ha' : H.Pa S₁ a') : H.Pa S₁ (h⁻¹ * a' * h) := by
  obtain ⟨haT, haZ, haR, haR', haW⟩ := ha'
  obtain ⟨hhz, hhN⟩ := Subgroup.mem_inf.mp hh
  have hKK : conjSub h K = K ∧ conjSub h K' = K' := by
    rcases Asc77.S24.twin_cases H.C hhz with h1 | h1
    · exact h1
    · exfalso
      have key : ∀ n : ℕ, conjSub (h ^ (2 * n + 1)) K = K' := by
        intro n
        induction n with
        | zero => simpa using h1.1
        | succ n ih =>
          rw [show 2 * (n + 1) + 1 = 2 * n + 1 + 1 + 1 by ring, pow_succ', pow_succ', conjSub_mul,
            conjSub_mul, ih, h1.2, h1.1]
      obtain ⟨m, hm⟩ := hodd
      have := key m
      rw [← hm, pow_orderOf_eq_one, conjSub_one] at this
      exact H.K_ne_K' this
  have hTT : conjSub h (H.TT S₁) = H.TT S₁ := mem_normalizer_iff_conjSub_eq.mp hhN
  have hRT : R ≤ H.TT S₁ := fun x hx =>
    Subgroup.mem_inf.mpr ⟨hT.hRS₁ hx, H.K_le_NN (H.C.hd.hR.2.1 hx)⟩
  have hR'T : R' ≤ H.TT S₁ := fun x hx =>
    Subgroup.mem_inf.mpr ⟨hT.hR'S₁ hx, H.K'_le_NN (H.C.hd.hR'.2.1 hx)⟩
  have hTK : H.TT S₁ ⊓ K = R :=
    le_antisymm ((inf_le_inf_right K inf_le_left).trans hT.inf_K) (le_inf hRT H.C.hd.hR.2.1)
  have hTK' : H.TT S₁ ⊓ K' = R' :=
    le_antisymm ((inf_le_inf_right K' inf_le_left).trans hT.inf_K') (le_inf hR'T H.C.hd.hR'.2.1)
  have hhR : conjSub h R = R := by rw [← hTK, conjSub_inf, hTT, hKK.1]
  have hhR' : conjSub h R' = R' := by rw [← hTK', conjSub_inf, hTT, hKK.2]
  have hconj : ∀ {L : Subgroup G}, conjSub h L = L → ∀ x ∈ L, h * x * h⁻¹ ∈ L := by
    intro L hL x hx
    rw [← hL, mem_conjSub_iff]
    simpa [mul_assoc] using hx
  set b := h⁻¹ * a' * h with hbdef
  have hbT : b ∈ H.TT S₁ := by
    have := (Subgroup.mem_normalizer_iff.mp (Subgroup.inv_mem _ hhN) a').mp haT
    simpa using this
  have hbN : b ∈ Subgroup.normalizer (W : Set G) := hT.hS₁W (Subgroup.mem_inf.mp hbT).1
  have hcommL : ∀ {L : Subgroup G}, conjSub h L = L → L ≤ Subgroup.centralizer ({a'} : Set G) →
      ∀ x ∈ L, x * b = b * x := by
    intro L hL hLa x hx
    have h1 := Subgroup.mem_centralizer_singleton_iff.mp (hLa (hconj hL x hx))
    calc x * (h⁻¹ * a' * h) = h⁻¹ * ((h * x * h⁻¹) * a') * h := by group
      _ = h⁻¹ * (a' * (h * x * h⁻¹)) * h := by rw [h1]
      _ = h⁻¹ * a' * h * x := by group
  have hbR := hcommL hhR haR
  have hbR' := hcommL hhR' haR'
  have hx₁ : H.C.D.x₁ * b = b * H.C.D.x₁ := hbR _ H.C.x₁_mem_R
  have hx₂ : H.C.D.x₂ * b = b * H.C.D.x₂ := hbR' _ H.C.x₂_mem_R'
  have htb : H.C.D.F.ρ'.r * b = b * H.C.D.F.ρ'.r := hbR' _ H.C.t_mem_R'
  have hjb : Commute H.C.D.F.j b := by
    rw [H.C.j_eq]
    exact (Commute.inv_left hx₁).mul_left hx₂
  set y₃ := b * H.C.D.x₃ * b⁻¹ with hy₃def
  have hy₃W : y₃ ∈ W := (Subgroup.mem_normalizer_iff.mp hbN _).mp H.C.D.x₃_mem
  set w₀ := H.C.D.x₃⁻¹ * y₃ with hw₀def
  have hw₀W : w₀ ∈ W := Subgroup.mul_mem _ (Subgroup.inv_mem _ H.C.D.x₃_mem) hy₃W
  have hy₃sq : y₃ ^ 2 = H.C.D.F.j := by
    rw [hy₃def, conj_pow, H.C.x₃_sq, hjb.symm.eq]
    group
  have hw₀sq : w₀ * w₀ = 1 := by
    have hc : Commute H.C.D.x₃⁻¹ y₃ := H.W_comm (Subgroup.inv_mem _ H.C.D.x₃_mem) hy₃W
    rw [← pow_two, hw₀def, hc.mul_pow, hy₃sq, inv_pow, H.C.x₃_sq, inv_mul_cancel]
  have hbx₂ : b * H.C.D.x₂ * b⁻¹ = H.C.D.x₂ := by rw [← hx₂]; group
  have e1 : H.C.D.F.ρ'.r * y₃ * H.C.D.F.ρ'.r⁻¹ = y₃ * H.C.D.x₂ := by
    calc H.C.D.F.ρ'.r * (b * H.C.D.x₃ * b⁻¹) * H.C.D.F.ρ'.r⁻¹
        = (H.C.D.F.ρ'.r * b) * H.C.D.x₃ * (H.C.D.F.ρ'.r * b)⁻¹ := by group
      _ = (b * H.C.D.F.ρ'.r) * H.C.D.x₃ * (b * H.C.D.F.ρ'.r)⁻¹ := by rw [htb]
      _ = b * (H.C.D.F.ρ'.r * H.C.D.x₃ * H.C.D.F.ρ'.r⁻¹) * b⁻¹ := by group
      _ = b * (H.C.D.x₃ * H.C.D.x₂) * b⁻¹ := by rw [H.C.D.t₃]
      _ = (b * H.C.D.x₃ * b⁻¹) * (b * H.C.D.x₂ * b⁻¹) := by group
      _ = (b * H.C.D.x₃ * b⁻¹) * H.C.D.x₂ := by rw [hbx₂]
  have e2 : H.C.D.x₃ * H.C.D.x₂ * (H.C.D.F.ρ'.r * w₀ * H.C.D.F.ρ'.r⁻¹) =
      H.C.D.x₃ * H.C.D.x₂ * w₀ := by
    calc H.C.D.x₃ * H.C.D.x₂ * (H.C.D.F.ρ'.r * w₀ * H.C.D.F.ρ'.r⁻¹)
        = (H.C.D.F.ρ'.r * H.C.D.x₃ * H.C.D.F.ρ'.r⁻¹) * (H.C.D.F.ρ'.r * w₀ * H.C.D.F.ρ'.r⁻¹) := by
          rw [H.C.D.t₃]
      _ = H.C.D.F.ρ'.r * (H.C.D.x₃ * w₀) * H.C.D.F.ρ'.r⁻¹ := by group
      _ = H.C.D.F.ρ'.r * y₃ * H.C.D.F.ρ'.r⁻¹ := by rw [hw₀def]; group
      _ = y₃ * H.C.D.x₂ := e1
      _ = H.C.D.x₃ * w₀ * H.C.D.x₂ := by rw [hw₀def]; group
      _ = H.C.D.x₃ * H.C.D.x₂ * w₀ := by rw [mul_assoc, H.W_comm hw₀W H.C.D.x₂_mem, ← mul_assoc]
  have hrw : H.C.D.F.ρ'.r * w₀ * H.C.D.F.ρ'.r⁻¹ = w₀ := mul_left_cancel e2
  have htz : H.C.D.F.ρ'.r * z = z * H.C.D.F.ρ'.r :=
    Subgroup.mem_centralizer_singleton_iff.mp
      (le_centralizer_of_unique H.C.hzK' (H.C.hd.hR'.2.1 H.C.t_mem_R'))
  have hz1 : z ≠ 1 := H.C.hzK.ne_one
  have hbx₃ : y₃ = H.C.D.x₃ := by
    rcases Asc77.S24.inv_W H.C hw₀W hw₀sq with h0 | h0 | h0 | h0
    · rw [hw₀def] at h0
      calc y₃ = H.C.D.x₃ * (H.C.D.x₃⁻¹ * y₃) := by group
        _ = H.C.D.x₃ := by rw [h0, mul_one]
    ·
      exfalso
      have hy₃z : b * H.C.D.x₃ * b⁻¹ = H.C.D.x₃ * z := by
        calc b * H.C.D.x₃ * b⁻¹ = H.C.D.x₃ * (H.C.D.x₃⁻¹ * y₃) := by rw [hy₃def]; group
          _ = H.C.D.x₃ * z := by rw [← hw₀def, h0]
      have hhz' : h * z = z * h := Subgroup.mem_centralizer_singleton_iff.mp hhz
      set v := h * H.C.D.x₃ * h⁻¹ with hvdef
      have ha'b : a' = h * b * h⁻¹ := by rw [hbdef]; group
      have hav : a' * v * a'⁻¹ = v * z := by
        calc a' * v * a'⁻¹ = h * (b * H.C.D.x₃ * b⁻¹) * h⁻¹ := by rw [ha'b, hvdef]; group
          _ = h * (H.C.D.x₃ * z) * h⁻¹ := by rw [hy₃z]
          _ = h * H.C.D.x₃ * h⁻¹ * (h * z * h⁻¹) := by group
          _ = v * z := by rw [hhz', hvdef]; group
      have hza : v⁻¹ * a' * v⁻¹⁻¹ = z * a' := by
        have hzv : z = v⁻¹ * (a' * v * a'⁻¹) := by rw [hav]; group
        calc v⁻¹ * a' * v⁻¹⁻¹ = v⁻¹ * (a' * v * a'⁻¹) * a' := by group
          _ = z * a' := by rw [← hzv]
      have ha'W : a' ∈ Subgroup.centralizer (W : Set G) :=
        Subgroup.mem_centralizer_iff.mpr fun w hw =>
          (Subgroup.mem_centralizer_singleton_iff.mp (haW hw))
      have hzaW : v⁻¹ * a' * v⁻¹⁻¹ ∈ Subgroup.centralizer (W : Set G) := by
        rw [hza, Subgroup.mem_centralizer_iff]
        intro w hw
        have h1 : w * z = z * w := Subgroup.mem_centralizer_singleton_iff.mp (H.W_le_Cz hw)
        have h2 : w * a' = a' * w := Subgroup.mem_centralizer_singleton_iff.mp (haW hw)
        calc w * (z * a') = (w * z) * a' := by group
          _ = z * (w * a') := by rw [h1]; group
          _ = z * a' * w := by rw [h2]; group
      have hzZ := H.conj_mem_zhat_of_centralizer haZ ha'W hzaW
      rw [hza] at hzZ
      have : z ∈ zhat H.hΩ W := by
        have := Subgroup.mul_mem _ hzZ (Subgroup.inv_mem _ haZ)
        simpa using this
      exact H.z_not_mem_zhat this
    · exfalso
      rw [h0, H.C.t_conj_j] at hrw
      exact hz1 (mul_eq_left.mp hrw)
    · exfalso
      have : H.C.D.F.ρ'.r * (z * H.C.D.F.j) * H.C.D.F.ρ'.r⁻¹ = H.C.D.F.j := by
        calc H.C.D.F.ρ'.r * (z * H.C.D.F.j) * H.C.D.F.ρ'.r⁻¹
            = (H.C.D.F.ρ'.r * z) * H.C.D.F.ρ'.r⁻¹ * (H.C.D.F.ρ'.r * H.C.D.F.j * H.C.D.F.ρ'.r⁻¹) := by
              group
          _ = z * (H.C.D.F.j * z) := by rw [htz, H.C.t_conj_j]; group
          _ = H.C.D.F.j := by rw [H.C.comm_jz, ← mul_assoc, H.C.hzK.sq, one_mul]
      rw [h0, this] at hrw
      exact hz1 (mul_eq_right.mp hrw.symm)
  have hx₃ : H.C.D.x₃ * b = b * H.C.D.x₃ := by
    have : b * H.C.D.x₃ * b⁻¹ = H.C.D.x₃ := hbx₃
    calc H.C.D.x₃ * b = (b * H.C.D.x₃ * b⁻¹) * b := by rw [this]
      _ = b * H.C.D.x₃ := by group
  have hbW : W ≤ Subgroup.centralizer ({b} : Set G) := by
    refine H.C.D.hgen.trans ((Subgroup.closure_le _).mpr ?_)
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff]
    rcases hx with rfl | rfl | rfl
    · exact hx₁
    · exact hx₂
    · exact hx₃
  have ha'W : a' ∈ Subgroup.centralizer (W : Set G) :=
    Subgroup.mem_centralizer_iff.mpr fun w hw => Subgroup.mem_centralizer_singleton_iff.mp (haW hw)
  have hbC : h⁻¹ * a' * h⁻¹⁻¹ ∈ Subgroup.centralizer (W : Set G) := by
    rw [inv_inv, Subgroup.mem_centralizer_iff]
    exact fun w hw => Subgroup.mem_centralizer_singleton_iff.mp (hbW hw)
  have hbZ := H.conj_mem_zhat_of_centralizer haZ ha'W hbC
  rw [inv_inv] at hbZ
  exact ⟨hbT, hbZ, fun x hx => Subgroup.mem_centralizer_singleton_iff.mpr (hbR x hx),
    fun x hx => Subgroup.mem_centralizer_singleton_iff.mpr (hbR' x hx), hbW⟩

theorem TC.pa_conj_YY (hT : H.TC S₁) {y : G} (hy : y ∈ H.YY S₁) : H.Pa S₁ (y⁻¹ * H.a * y) := by
  let Y' : Subgroup G :=
    { carrier := {y | y ∈ H.YY S₁ ∧ ∀ a', H.Pa S₁ a' →
        H.Pa S₁ (y * a' * y⁻¹) ∧ H.Pa S₁ (y⁻¹ * a' * y)}
      one_mem' := ⟨Subgroup.one_mem _, fun a' h => by simpa using h⟩
      mul_mem' := by
        rintro y₁ y₂ ⟨h₁, k₁⟩ ⟨h₂, k₂⟩
        refine ⟨Subgroup.mul_mem _ h₁ h₂, fun a' ha' => ⟨?_, ?_⟩⟩
        · have e : y₁ * y₂ * a' * (y₁ * y₂)⁻¹ = y₁ * (y₂ * a' * y₂⁻¹) * y₁⁻¹ := by group
          rw [e]
          exact (k₁ _ (k₂ a' ha').1).1
        · have e : (y₁ * y₂)⁻¹ * a' * (y₁ * y₂) = y₂⁻¹ * (y₁⁻¹ * a' * y₁) * y₂ := by group
          rw [e]
          exact (k₂ _ (k₁ a' ha').2).2
      inv_mem' := by
        rintro y ⟨h, k⟩
        refine ⟨Subgroup.inv_mem _ h, fun a' ha' => ⟨?_, ?_⟩⟩
        · rw [inv_inv]; exact (k a' ha').2
        · rw [inv_inv]; exact (k a' ha').1 }
  have hY : Y' = H.YY S₁ := by
    refine eq_of_sylow_le_of_odd_mem S₁ (fun s hs => ⟨hT.le_YY hs, fun a' ha' =>
      ⟨hT.pa_conj_S₁ hs ha', ?_⟩⟩) (fun y hy => hy.1) (fun h hh hodd => ⟨hh, fun a' ha' =>
      ⟨?_, hT.pa_conj_odd hh hodd ha'⟩⟩)
    · have := hT.pa_conj_S₁ (Subgroup.inv_mem _ hs) ha'
      rwa [inv_inv] at this
    · have := hT.pa_conj_odd (Subgroup.inv_mem _ hh) (by rwa [orderOf_inv]) ha'
      rwa [inv_inv] at this
  have hyY : y ∈ Y' := hY ▸ hy
  exact (hyY.2 H.a hT.pa_a).2

theorem TC.exists_conj_YY (hT : H.TC S₁) {y : G} (hy : y ∈ H.YY S₁) :
    ∃ c ∈ Subgroup.centralizer ((Subgroup.closure ({z, H.a} : Set G) : Subgroup G) : Set G),
      conjSub y W = conjSub c W := by
  have hP := (hT.pa_conj_YY hy).2.2.2.2
  have hyz : y * z = z * y := Subgroup.mem_centralizer_singleton_iff.mp (Subgroup.mem_inf.mp hy).1
  have hWH : W ≤ Subgroup.centralizer
      ((Subgroup.closure ({z, H.a} : Set G) : Subgroup G) : Set G) := fun w hw =>
    mem_centralizer_closure_pair' (Subgroup.mem_centralizer_singleton_iff.mp (H.W_le_Cz hw)).symm
      (H.comm_W hw).symm
  have hyW : conjSub y W ≤ Subgroup.centralizer
      ((Subgroup.closure ({z, H.a} : Set G) : Subgroup G) : Set G) := by
    intro v hv
    rw [mem_conjSub_iff] at hv
    obtain ⟨w, hw, rfl⟩ : ∃ w ∈ W, v = y * w * y⁻¹ := ⟨_, hv, by group⟩
    have h1 : Commute z w :=
      (Subgroup.mem_centralizer_singleton_iff.mp (H.W_le_Cz hw)).symm
    have h2 := Subgroup.mem_centralizer_singleton_iff.mp (hP hw)
    have hzy : Commute z y := hyz.symm
    refine mem_centralizer_closure_pair' ?_ ?_
    · exact ((hzy.mul_right h1).mul_right hzy.inv_right).eq
    · calc H.a * (y * w * y⁻¹) = y * ((y⁻¹ * H.a * y) * w) * y⁻¹ := by group
        _ = y * (w * (y⁻¹ * H.a * y)) * y⁻¹ := by rw [h2]
        _ = y * w * y⁻¹ * H.a := by group
  obtain ⟨S₀, -, hWC⟩ := H.exists_weaklyClosed
  obtain ⟨c, hc, hcW⟩ := hWC.exists_mem_mul H.isPGroup_W hWH hyW
  refine ⟨c⁻¹, Subgroup.inv_mem _ hc, ?_⟩
  have := congrArg (conjSub c⁻¹) hcW
  rwa [conjSub_mul, conjSub_inv_conjSub] at this

include H in
theorem isPGroup_RR' : IsPGroup 2 ↥(R ⊔ R') :=
  S.isPGroup'.to_le (sup_le H.C.hd.hR.2.2 H.C.hd.hR'.2.2)

include H in
theorem RR'_le_Cz : R ⊔ R' ≤ Cz :=
  sup_le (H.C.hd.hR.2.1.trans (le_centralizer_of_unique H.C.hzK))
    (H.C.hd.hR'.2.1.trans (le_centralizer_of_unique H.C.hzK'))

theorem j_mem_RR' : H.C.D.F.j ∈ R ⊔ R' := by
  rw [H.C.j_eq]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left (Subgroup.inv_mem _ H.C.x₁_mem_R))
    (Subgroup.mem_sup_right H.C.x₂_mem_R')

theorem j_mem_Cz : H.C.D.F.j ∈ Cz := Subgroup.mem_centralizer_singleton_iff.mpr H.C.comm_jz

include H in
theorem K_le_Q : K ≤ Oz ⊔ (R ⊔ R') :=
  (le_oddCoreOf_sup (H.C.hyp.std.1.quot2 _ H.C.hs.stand.mem) H.C.hRsyl).trans
    (sup_le_sup (H.oddCore_le_Oz H.C.hs.stand.mem H.C.hzK) le_sup_left)

include H in
theorem K'_le_Q : K' ≤ Oz ⊔ (R ⊔ R') :=
  (le_oddCoreOf_sup (H.C.hyp.std.1.quot2 _ H.C.hs.hK'.1) H.hR'syl).trans
    (sup_le_sup (H.oddCore_le_Oz H.C.hs.hK'.1 H.C.hzK') le_sup_right)

include H in
theorem Q_le_Cz : Oz ⊔ (R ⊔ R') ≤ Cz := sup_le Oz_le_Cz H.RR'_le_Cz

include H in
theorem conj_mem_Q {g x : G} (hg : g ∈ Cz) (hx : x ∈ Oz ⊔ (R ⊔ R')) :
    g * x * g⁻¹ ∈ Oz ⊔ (R ⊔ R') := by
  have hle : Oz ⊔ (R ⊔ R') ≤ conjSub g⁻¹ (Oz ⊔ (R ⊔ R')) := by
    have hK : ∀ y ∈ R ⊔ R', g * y * g⁻¹ ∈ Oz ⊔ (R ⊔ R') := by
      have hcases := Asc77.S24.twin_cases H.C hg
      have hKc : ∀ y ∈ K, g * y * g⁻¹ ∈ Oz ⊔ (R ⊔ R') := by
        intro y hy
        have : g * y * g⁻¹ ∈ conjSub g K := by
          rw [mem_conjSub_iff]; simpa [mul_assoc] using hy
        rcases hcases with h | h
        · rw [h.1] at this; exact H.K_le_Q this
        · rw [h.1] at this; exact H.K'_le_Q this
      have hK'c : ∀ y ∈ K', g * y * g⁻¹ ∈ Oz ⊔ (R ⊔ R') := by
        intro y hy
        have : g * y * g⁻¹ ∈ conjSub g K' := by
          rw [mem_conjSub_iff]; simpa [mul_assoc] using hy
        rcases hcases with h | h
        · rw [h.2] at this; exact H.K'_le_Q this
        · rw [h.2] at this; exact H.K_le_Q this
      have hle' : R ⊔ R' ≤ conjSub g⁻¹ (Oz ⊔ (R ⊔ R')) := by
        refine sup_le (fun y hy => ?_) (fun y hy => ?_)
        · rw [mem_conjSub_iff, inv_inv]; exact hKc y (H.C.hd.hR.2.1 hy)
        · rw [mem_conjSub_iff, inv_inv]; exact hK'c y (H.C.hd.hR'.2.1 hy)
      intro y hy
      have := hle' hy
      rwa [mem_conjSub_iff, inv_inv] at this
    refine sup_le (fun o ho => ?_) (fun y hy => ?_)
    · rw [mem_conjSub_iff, inv_inv]
      exact Subgroup.mem_sup_left (T7R.conj_mem_oddCoreOf hg ho)
    · rw [mem_conjSub_iff, inv_inv]
      exact hK y hy
  have := hle hx
  rwa [mem_conjSub_iff, inv_inv] at this

omit [Finite G] in
@[expose] def Y₀ (z₀ : G) (P₁ P₂ : Subgroup G) : Subgroup G where
  carrier := {y | y ∈ Subgroup.centralizer ({z₀} : Set G) ∧
    ∀ x ∈ oddCoreOf (Subgroup.centralizer ({z₀} : Set G)) ⊔ (P₁ ⊔ P₂),
      y * x * y⁻¹ * x⁻¹ ∈ oddCoreOf (Subgroup.centralizer ({z₀} : Set G))}
  one_mem' := ⟨Subgroup.one_mem _, fun x _ => by simp⟩
  mul_mem' := by
    rintro y₁ y₂ ⟨h₁, k₁⟩ ⟨h₂, k₂⟩
    refine ⟨Subgroup.mul_mem _ h₁ h₂, fun x hx => ?_⟩
    have e : y₁ * y₂ * x * (y₁ * y₂)⁻¹ * x⁻¹ =
        y₁ * (y₂ * x * y₂⁻¹ * x⁻¹) * y₁⁻¹ * (y₁ * x * y₁⁻¹ * x⁻¹) := by group
    rw [e]
    exact Subgroup.mul_mem _ (T7R.conj_mem_oddCoreOf h₁ (k₂ x hx)) (k₁ x hx)
  inv_mem' := by
    rintro y ⟨h, k⟩
    refine ⟨Subgroup.inv_mem _ h, fun x hx => ?_⟩
    have e : y⁻¹ * x * y⁻¹⁻¹ * x⁻¹ = y⁻¹ * (y * x * y⁻¹ * x⁻¹)⁻¹ * y⁻¹⁻¹ := by group
    rw [e]
    exact T7R.conj_mem_oddCoreOf (Subgroup.inv_mem _ h) (Subgroup.inv_mem _ (k x hx))

omit [Finite G] in
theorem Y₀_le_Cz : Y₀ z R R' ≤ Cz := fun _ hy => hy.1

variable (H) in
include H in
theorem conj_mem_Y₀ {g y : G} (hg : g ∈ Cz) (hy : y ∈ Y₀ z R R') : g * y * g⁻¹ ∈ Y₀ z R R' := by
  refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hg hy.1) (Subgroup.inv_mem _ hg), fun x hx => ?_⟩
  have hx' : g⁻¹ * x * g⁻¹⁻¹ ∈ Oz ⊔ (R ⊔ R') := H.conj_mem_Q (Subgroup.inv_mem _ hg) hx
  rw [inv_inv] at hx'
  have e : g * y * g⁻¹ * x * (g * y * g⁻¹)⁻¹ * x⁻¹ =
      g * (y * (g⁻¹ * x * g) * y⁻¹ * (g⁻¹ * x * g)⁻¹) * g⁻¹ := by group
  rw [e]
  exact T7R.conj_mem_oddCoreOf hg (hy.2 _ hx')

variable (H) in
include H in
theorem Cz_le_normalizer_Y₀ : Cz ≤ Subgroup.normalizer (Y₀ z R R' : Set G) := by
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro y
  refine ⟨fun hy => H.conj_mem_Y₀ hg hy, fun hy => ?_⟩
  have := H.conj_mem_Y₀ (Subgroup.inv_mem _ hg) hy
  simpa [mul_assoc] using this

variable (H) in
include H in
theorem Oz_le_Y₀ : Oz ≤ Y₀ z R R' := by
  intro o ho
  refine ⟨Oz_le_Cz ho, fun x hx => ?_⟩
  have e : o * x * o⁻¹ * x⁻¹ = o * (x * o⁻¹ * x⁻¹) := by group
  rw [e]
  exact Subgroup.mul_mem _ ho (T7R.conj_mem_oddCoreOf (H.Q_le_Cz hx) (Subgroup.inv_mem _ ho))

variable (H) in
theorem comm_RR'_of_mem_X₀ {o : G}
    (hoj : o ∈ oddCoreOf (Subgroup.centralizer ({H.C.D.F.j} : Set G))) (hoz : o ∈ Cz) :
    ∀ q ∈ R ⊔ R', o * q * o⁻¹ * q⁻¹ ∈ Oz := by
  set C := Subgroup.centralizer ({z} : Set G) with hCdef
  set Oc := (oddCoreOf C).subgroupOf C with hOcdef
  haveI hN : Oc.Normal := ⟨fun n hn g => by
    rw [hOcdef, Subgroup.mem_subgroupOf] at hn ⊢
    simpa using T7R.conj_mem_oddCoreOf g.2 hn⟩
  let φ : ↥C →* ↥C ⧸ Oc := QuotientGroup.mk' Oc
  have hφ : ∀ a b : ↥C, φ a = φ b ↔ (a : G)⁻¹ * b ∈ oddCoreOf C := by
    intro a b
    change ((a : ↥C ⧸ Oc) = b) ↔ _
    rw [QuotientGroup.eq, hOcdef, Subgroup.mem_subgroupOf]
    simp
  set Qb := ((R ⊔ R').subgroupOf C).map φ with hQbdef
  have hQb : IsPGroup 2 Qb := (H.isPGroup_RR'.comap_subtype (K := C)).map φ
  have hM : ∀ x : ↥C, (x : G) ∈ oddCoreOf C ⊔ (R ⊔ R') → φ x ∈ Qb := by
    intro x hx
    have hRN : R ⊔ R' ≤ Subgroup.normalizer (oddCoreOf C : Set G) := fun y hy =>
      T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer (H.RR'_le_Cz hy))
    obtain ⟨o₁, ho₁, q, hq, hxq⟩ := T7L.mem_sup_normalForm hRN hx
    have hqC : q ∈ C := H.RR'_le_Cz hq
    have e : φ x = φ ⟨q, hqC⟩ := by
      rw [hφ]
      change (x : G)⁻¹ * q ∈ oddCoreOf C
      rw [hxq]
      have e' : (o₁ * q)⁻¹ * q = q⁻¹ * o₁⁻¹ * q⁻¹⁻¹ := by group
      rw [e']
      exact T7R.conj_mem_oddCoreOf (Subgroup.inv_mem _ hqC) (Subgroup.inv_mem _ ho₁)
    rw [e]
    exact Subgroup.mem_map_of_mem φ (Subgroup.mem_subgroupOf.mpr hq)
  have hCQ : ∀ g : ↥C, ∀ x ∈ Qb, φ g * x * (φ g)⁻¹ ∈ Qb := by
    intro g x hx
    obtain ⟨q, hq, rfl⟩ := Subgroup.mem_map.mp hx
    rw [← map_inv, ← map_mul, ← map_mul]
    refine hM _ ?_
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    exact H.conj_mem_Q g.2 (Subgroup.mem_sup_right (Subgroup.mem_subgroupOf.mp hq))
  have hjC : H.C.D.F.j ∈ C := H.j_mem_Cz
  set c := φ ⟨o, hoz⟩ with hcdef
  set jb := φ ⟨H.C.D.F.j, hjC⟩ with hjbdef
  have hjb2 : jb * jb = 1 := by
    rw [hjbdef, ← map_mul]
    have : (⟨H.C.D.F.j, hjC⟩ : ↥C) * ⟨H.C.D.F.j, hjC⟩ = 1 := Subtype.ext H.C.hjJ.sq
    rw [this, map_one]
  have hjbQ : jb ∈ Qb := hM _ (Subgroup.mem_sup_right H.j_mem_RR')
  have hoCj : o * H.C.D.F.j = H.C.D.F.j * o :=
    Subgroup.mem_centralizer_singleton_iff.mp (oddCoreOf_le_self _ hoj)
  have hcj : c * jb = jb * c := by
    rw [hcdef, hjbdef, ← map_mul, ← map_mul]
    congr 1
    exact Subtype.ext hoCj
  have hodd_j : ∀ {d : G}, d ∈ oddCoreOf (Subgroup.centralizer ({H.C.D.F.j} : Set G)) →
      Odd (orderOf d) := fun hd =>
    Odd.of_dvd_nat (oddCoreOf_odd_natCard _) (Subgroup.orderOf_dvd_natCard _ hd)
  have hc : Odd (orderOf c) :=
    Odd.of_dvd_nat (by rw [Subgroup.orderOf_mk]; exact hodd_j hoj) (orderOf_map_dvd φ _)
  have hcQ : c ∈ Subgroup.normalizer (Qb : Set (↥C ⧸ Oc)) := by
    rw [Subgroup.mem_normalizer_iff]
    intro x
    refine ⟨fun hx => hCQ _ x hx, fun hx => ?_⟩
    have := hCQ ⟨o, hoz⟩⁻¹ _ hx
    rw [map_inv] at this
    simpa [hcdef, mul_assoc] using this
  have hBQ : Subgroup.zpowers jb ≤ Subgroup.normalizer (Qb : Set (↥C ⧸ Oc)) :=
    Subgroup.zpowers_le.mpr (Subgroup.le_normalizer hjbQ)
  have hcB : ∀ b ∈ Subgroup.zpowers jb, c * b = b * c := by
    intro b hb
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb
    exact (Commute.zpow_right hcj k).eq
  have hfix : ∀ x ∈ Qb, (∀ b ∈ Subgroup.zpowers jb, x * b = b * x) → c * x = x * c := by
    intro x hx hxb
    obtain ⟨q', hq', rfl⟩ := Subgroup.mem_map.mp hx
    have hqR : (q' : G) ∈ R ⊔ R' := Subgroup.mem_subgroupOf.mp hq'
    have hqj := hxb jb (Subgroup.mem_zpowers _)
    rw [hjbdef, ← map_mul, ← map_mul, hφ] at hqj
    simp only [Subgroup.coe_mul, mul_inv_rev] at hqj
    set q : G := (q' : G) with hqdef
    set j := H.C.D.F.j with hjdef
    set o'' := j⁻¹ * (q⁻¹ * j * q) with ho''def
    have ho'' : o'' ∈ oddCoreOf C := by
      have e : o'' = j⁻¹ * q⁻¹ * (j * q) := by rw [ho''def]; group
      rw [e]
      exact hqj
    have hj2 : j * j = 1 := H.C.hjJ.sq
    have hjo : j * o'' * (j * o'') = 1 := by
      have e : j * o'' = q⁻¹ * j * q := by rw [ho''def]; group
      rw [e]
      calc q⁻¹ * j * q * (q⁻¹ * j * q) = q⁻¹ * (j * j) * q := by group
        _ = 1 := by rw [hj2]; group
    have hodd'' : Odd (orderOf o'') :=
      Odd.of_dvd_nat (oddCoreOf_odd_natCard _) (Subgroup.orderOf_dvd_natCard _ ho'')
    obtain ⟨k, hk⟩ := exists_pow_conj_eq hj2 hodd'' hjo
    have hpk : o'' ^ k ∈ oddCoreOf C := Subgroup.pow_mem _ ho'' k
    set p := q * o'' ^ k with hpdef
    have hpC : p ∈ C := Subgroup.mul_mem _ q'.2 (Oz_le_Cz hpk)
    have hpj : p * j = j * p := by
      have e : p * j * p⁻¹ = j := by
        calc p * j * p⁻¹ = q * (o'' ^ k * j * (o'' ^ k)⁻¹) * q⁻¹ := by rw [hpdef]; group
          _ = q * (j * o'') * q⁻¹ := by rw [hk]
          _ = j := by rw [ho''def]; group
      calc p * j = p * j * p⁻¹ * p := by group
        _ = j * p := by rw [e]
    have hpCj : p ∈ Subgroup.centralizer ({j} : Set G) :=
      Subgroup.mem_centralizer_singleton_iff.mpr hpj
    set d := o * p * o⁻¹ * p⁻¹ with hddef
    have hdj : d ∈ oddCoreOf (Subgroup.centralizer ({j} : Set G)) := by
      have e : d = o * (p * o⁻¹ * p⁻¹) := by rw [hddef]; group
      rw [e]
      exact Subgroup.mul_mem _ hoj (T7R.conj_mem_oddCoreOf hpCj (Subgroup.inv_mem _ hoj))
    have hpQ : p ∈ oddCoreOf C ⊔ (R ⊔ R') :=
      Subgroup.mul_mem _ (Subgroup.mem_sup_right hqR) (Subgroup.mem_sup_left hpk)
    have hdQ : d ∈ oddCoreOf C ⊔ (R ⊔ R') :=
      Subgroup.mul_mem _ (H.conj_mem_Q hoz hpQ) (Subgroup.inv_mem _ hpQ)
    have hdC : d ∈ C := H.Q_le_Cz hdQ
    have hφd : φ ⟨d, hdC⟩ = 1 := by
      refine eq_one_of_odd_of_isPGroup hQb (hM _ hdQ) ?_
      exact Odd.of_dvd_nat (by rw [Subgroup.orderOf_mk]; exact hodd_j hdj) (orderOf_map_dvd φ _)
    have hdφ : φ ⟨d, hdC⟩ = c * φ ⟨p, hpC⟩ * c⁻¹ * (φ ⟨p, hpC⟩)⁻¹ := by
      rw [hcdef, ← map_inv, ← map_inv, ← map_mul, ← map_mul, ← map_mul]
      rfl
    have hcp : c * φ ⟨p, hpC⟩ = φ ⟨p, hpC⟩ * c := by
      rw [hφd] at hdφ
      have := hdφ.symm
      rw [mul_inv_eq_one, mul_inv_eq_iff_eq_mul] at this
      exact this
    have hpq : φ ⟨p, hpC⟩ = φ q' := by
      rw [hφ]
      change p⁻¹ * q ∈ oddCoreOf C
      have e : p⁻¹ * q = (o'' ^ k)⁻¹ := by rw [hpdef]; group
      rw [e]
      exact Subgroup.inv_mem _ hpk
    rw [← hpq]
    exact hcp
  have hAB := commute_of_thompson_AxB' hQb
    (ExactLayer.isPGroup_zpowers_of_sq_eq_one hjb2) hcQ hBQ hc hcB hfix
  intro q hq
  have hqC : q ∈ C := H.RR'_le_Cz hq
  have h := hAB (φ ⟨q, hqC⟩) (Subgroup.mem_map_of_mem φ (Subgroup.mem_subgroupOf.mpr hq))
  have h1 : φ (⟨o, hoz⟩ * ⟨q, hqC⟩ * ⟨o, hoz⟩⁻¹ * ⟨q, hqC⟩⁻¹) = 1 := by
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, ← hcdef, h]
    group
  have h2 : (⟨o, hoz⟩ * ⟨q, hqC⟩ * ⟨o, hoz⟩⁻¹ * ⟨q, hqC⟩⁻¹ : ↥C) ∈ Oc :=
    (QuotientGroup.eq_one_iff _).mp h1
  rw [hOcdef, Subgroup.mem_subgroupOf] at h2
  simpa using h2

variable (H) in
theorem oddCore_Cj_inf_le :
    oddCoreOf (Subgroup.centralizer ({H.C.D.F.j} : Set G)) ⊓ Cz ≤ Oz := by
  set X₀ := oddCoreOf (Subgroup.centralizer ({H.C.D.F.j} : Set G)) ⊓ Cz with hX₀def
  have hX₀Y : X₀ ≤ Y₀ z R R' := by
    intro o ho
    refine ⟨ho.2, fun x hx => ?_⟩
    have hRN : R ⊔ R' ≤ Subgroup.normalizer (Oz : Set G) := fun y hy =>
      T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer (H.RR'_le_Cz hy))
    obtain ⟨o₁, ho₁, q, hq, rfl⟩ := T7L.mem_sup_normalForm hRN hx
    have e : o * (o₁ * q) * o⁻¹ * (o₁ * q)⁻¹ =
        (o * o₁ * o⁻¹) * (o * q * o⁻¹ * q⁻¹) * o₁⁻¹ := by group
    rw [e]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (T7R.conj_mem_oddCoreOf ho.2 ho₁)
      (H.comm_RR'_of_mem_X₀ ho.1 ho.2 q hq)) (Subgroup.inv_mem _ ho₁)
  have hY₀N : Y₀ z R R' ≤ Subgroup.normalizer ((X₀ ⊔ Oz : Subgroup G) : Set G) := by
    intro y hy
    have hyi : y⁻¹ ∈ Y₀ z R R' := Subgroup.inv_mem _ hy
    set j := H.C.D.F.j with hjdef
    have hjQ : j ∈ Oz ⊔ (R ⊔ R') := Subgroup.mem_sup_right H.j_mem_RR'
    have hc₁ := hyi.2 j hjQ
    rw [inv_inv] at hc₁
    set o'' := j⁻¹ * (y⁻¹ * j * y) with ho''def
    have hjz : j ∈ Cz := H.j_mem_Cz
    have ho'' : o'' ∈ Oz := by
      have e : o'' = j⁻¹ * (y⁻¹ * j * y * j⁻¹) * j⁻¹⁻¹ := by rw [ho''def]; group
      rw [e]
      exact T7R.conj_mem_oddCoreOf (Subgroup.inv_mem _ hjz) hc₁
    have hj2 : j * j = 1 := H.C.hjJ.sq
    have hjo : j * o'' * (j * o'') = 1 := by
      have e : j * o'' = y⁻¹ * j * y := by rw [ho''def]; group
      rw [e]
      calc y⁻¹ * j * y * (y⁻¹ * j * y) = y⁻¹ * (j * j) * y := by group
        _ = 1 := by rw [hj2]; group
    have hodd'' : Odd (orderOf o'') :=
      Odd.of_dvd_nat (oddCoreOf_odd_natCard _) (Subgroup.orderOf_dvd_natCard _ ho'')
    obtain ⟨k, hk⟩ := exists_pow_conj_eq hj2 hodd'' hjo
    have hpk : o'' ^ k ∈ Oz := Subgroup.pow_mem _ ho'' k
    set c := y * o'' ^ k with hcdef
    have hcz : c ∈ Cz := Subgroup.mul_mem _ (Y₀_le_Cz hy) (Oz_le_Cz hpk)
    have hcj : c * j * c⁻¹ = j := by
      calc c * j * c⁻¹ = y * (o'' ^ k * j * (o'' ^ k)⁻¹) * y⁻¹ := by rw [hcdef]; group
        _ = y * (j * o'') * y⁻¹ := by rw [hk]
        _ = j := by rw [ho''def]; group
    have hcCj : c ∈ Subgroup.centralizer ({j} : Set G) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc c * j = c * j * c⁻¹ * c := by group
        _ = j * c := by rw [hcj]
    have hcX : conjSub c X₀ = X₀ := by
      rw [hX₀def, conjSub_inf, conjSub_eq_self_of_mem hcz,
        mem_normalizer_iff_conjSub_eq.mp (T7L.mem_normalizer_oddCoreOf
          (Subgroup.le_normalizer hcCj))]
    have hy' : y = c * (o'' ^ k)⁻¹ := by rw [hcdef]; group
    rw [mem_normalizer_iff_conjSub_eq, hy', conjSub_mul,
      conjSub_eq_self_of_mem (Subgroup.mem_sup_right (Subgroup.inv_mem _ hpk)), conjSub_sup,
      hcX, conjSub_Oz hcz]
  have hX₀N : X₀ ≤ Subgroup.normalizer (Oz : Set G) := fun x hx =>
    T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer hx.2)
  have hX₀odd : Odd (Nat.card X₀) :=
    Odd.of_dvd_nat (oddCoreOf_odd_natCard _) (Subgroup.card_dvd_of_le inf_le_left)
  have hodd := odd_card_sup_of_le_normalizer' hX₀N hX₀odd (oddCoreOf_odd_natCard _)
  have h1 : X₀ ⊔ Oz ≤ oddCoreOf (Y₀ z R R') :=
    AscFusion.le_oddCoreOf_of_normal_odd (sup_le hX₀Y (H.Oz_le_Y₀)) hY₀N hodd
  have h2 : oddCoreOf (Y₀ z R R') ≤ Oz :=
    AscFusion.le_oddCoreOf_of_normal_odd ((oddCoreOf_le_self _).trans Y₀_le_Cz)
      (fun g hg => T7L.mem_normalizer_oddCoreOf (H.Cz_le_normalizer_Y₀ hg))
      (oddCoreOf_odd_natCard _)
  exact le_sup_left.trans (h1.trans h2)

variable (H) in
theorem oddCore_J_inf_le :
    oddCoreOf H.C.D.F.ρ₃.K ⊓
        Subgroup.centralizer ((Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ :
          Subgroup G) : Set G) ≤ Oz := by
  intro o ho
  have hoj : o ∈ oddCoreOf (Subgroup.centralizer ({H.C.D.F.j} : Set G)) :=
    Balance.oddCoreIn_le_of_isSubnormal
      (H.C.hs.stand.cls.isSubnormal_of_uniqueInvolution H.C.D.F.ρ₃.hK H.C.hjJ) ho.1
  have hzB : z ∈ Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ := by
    have : H.C.D.x₁ ^ 2 ∈ Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ :=
      Subgroup.mem_sup_left (Subgroup.pow_mem _ (Subgroup.mem_zpowers H.C.D.x₁) 2)
    rwa [H.C.x₁_sq] at this
  have hoz : o ∈ Cz := Subgroup.mem_centralizer_singleton_iff.mpr
    (Subgroup.mem_centralizer_iff.mp ho.2 z hzB).symm
  exact H.oddCore_Cj_inf_le ⟨hoj, hoz⟩

variable (H) in
theorem mem_oddCore_sup_x₃ {x : G} (hxJ : x ∈ H.C.D.F.ρ₃.K) (hxz : x * z = z * x) :
    x ∈ oddCoreOf H.C.D.F.ρ₃.K ⊔ Subgroup.zpowers H.C.D.x₃ := by
  let F := H.C.toCtx8.toFrame
  have hΩ := F.hyp
  have hJ : H.C.D.F.ρ₃.K ∈ Ω := H.C.D.F.ρ₃.hK
  have hzx₃ : H.C.D.x₃ * z = z * H.C.D.x₃ := H.W_comm H.C.D.x₃_mem H.C.hd.hzW
  have h4 : 4 ≤ Nat.card (Subgroup.zpowers H.C.D.x₃) := by
    rw [Nat.card_zpowers, H.C.orderOf_x₃]
  have hzJ : conjSub z H.C.D.F.ρ₃.K = H.C.D.F.ρ₃.K := by
    have h2 : IsPGroup 2 (Subgroup.zpowers H.C.D.x₃) :=
      H.isPGroup_W.to_le (Subgroup.zpowers_le.mpr H.C.D.x₃_mem)
    refine AschTight.Sec6Gen.eq_of_le_of_le hΩ (hΩ.conjInvariant z _ hJ) hJ h2 h4 ?_
      (Subgroup.zpowers_le.mpr H.C.x₃_mem_J)
    rw [Subgroup.zpowers_le, mem_conjSub_iff]
    have e : z⁻¹ * H.C.D.x₃ * z = H.C.D.x₃ := by
      rw [mul_assoc, hzx₃, ← mul_assoc, inv_mul_cancel, one_mul]
    rw [e]
    exact H.C.x₃_mem_J
  have hzN : z ∈ Subgroup.normalizer (H.C.D.F.ρ₃.K : Set G) := mem_normalizer_iff_conjSub_eq.mpr hzJ
  have hLN : H.C.D.F.ρ₃.K ⊔ Subgroup.zpowers z ≤ Subgroup.normalizer (H.C.D.F.ρ₃.K : Set G) :=
    sup_le Subgroup.le_normalizer (Subgroup.zpowers_le.mpr hzN)
  have hP₀ : Subgroup.zpowers H.C.D.x₃ ⊔ Subgroup.zpowers z ≤ W :=
    sup_le (Subgroup.zpowers_le.mpr H.C.D.x₃_mem) (Subgroup.zpowers_le.mpr H.C.hd.hzW)
  obtain ⟨V, hV, hP₀V⟩ := IsSylow2In.exists_ge (H.isPGroup_W.to_le hP₀)
    (sup_le_sup_right (Subgroup.zpowers_le.mpr H.C.x₃_mem_J) (Subgroup.zpowers z))
  have hTs : IsSylow2In (V ⊓ H.C.D.F.ρ₃.K) H.C.D.F.ρ₃.K :=
    isSylow2In_inf_of_le_normalizer hV le_sup_left hLN
  have hx₃T : H.C.D.x₃ ∈ V ⊓ H.C.D.F.ρ₃.K :=
    ⟨hP₀V (Subgroup.mem_sup_left (Subgroup.mem_zpowers _)), H.C.x₃_mem_J⟩
  have hzV : z ∈ V := hP₀V (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
  have hzT : ∀ t ∈ V ⊓ H.C.D.F.ρ₃.K, z * t * z⁻¹ ∈ V ⊓ H.C.D.F.ρ₃.K := fun t ht =>
    ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hzV ht.1) (Subgroup.inv_mem _ hzV),
      (Subgroup.mem_normalizer_iff.mp hzN t).mp ht.2⟩
  have hnc : ¬ (V ⊓ H.C.D.F.ρ₃.K ≤ Subgroup.centralizer ({z} : Set G)) := fun hle =>
    F.ne_conj_z hJ hTs H.C.hjJ hle H.C.z_ne_j 1 (by group)
  have hcard8 : Nat.card ↥(V ⊓ H.C.D.F.ρ₃.K) = 8 := by
    rw [hTs.natCard_eq H.hT, H.T_card, Nat.card_zpowers, H.C.orderOf_x₃]
  have hx₃D : Subgroup.zpowers H.C.D.x₃ ≤ (V ⊓ H.C.D.F.ρ₃.K) ⊓ Subgroup.centralizer ({z} : Set G) :=
    Subgroup.zpowers_le.mpr ⟨hx₃T, Subgroup.mem_centralizer_singleton_iff.mpr hzx₃⟩
  have hDcard : Nat.card ↥((V ⊓ H.C.D.F.ρ₃.K) ⊓ Subgroup.centralizer ({z} : Set G)) = 4 := by
    have hd : Nat.card ↥((V ⊓ H.C.D.F.ρ₃.K) ⊓ Subgroup.centralizer ({z} : Set G)) ∣ 2 ^ 3 := by
      rw [show (2 : ℕ) ^ 3 = 8 by norm_num, ← hcard8]
      exact Subgroup.card_dvd_of_le inf_le_left
    have hge := (Subgroup.card_le_of_le hx₃D).trans' h4
    have hne : Nat.card ↥((V ⊓ H.C.D.F.ρ₃.K) ⊓ Subgroup.centralizer ({z} : Set G)) ≠ 8 := by
      intro h8
      apply hnc
      have := Subgroup.eq_of_le_of_card_ge (inf_le_left :
        (V ⊓ H.C.D.F.ρ₃.K) ⊓ Subgroup.centralizer ({z} : Set G) ≤ V ⊓ H.C.D.F.ρ₃.K)
        (by rw [h8, hcard8])
      rw [← this]
      exact inf_le_right
    obtain ⟨i, hi, hiD⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hd
    rw [hiD] at hge hne ⊢
    interval_cases i <;> simp_all
  have hDeq : (V ⊓ H.C.D.F.ρ₃.K) ⊓ Subgroup.centralizer ({z} : Set G) =
      Subgroup.zpowers H.C.D.x₃ :=
    (Subgroup.eq_of_le_of_card_ge hx₃D (by rw [hDcard, Nat.card_zpowers, H.C.orderOf_x₃])).symm
  have hxJ' : x ∈ oddCoreOf H.C.D.F.ρ₃.K ⊔ (V ⊓ H.C.D.F.ρ₃.K) :=
    le_oddCoreOf_sup (H.C.hyp.std.1.quot2 _ hJ) hTs hxJ
  have hTN : V ⊓ H.C.D.F.ρ₃.K ≤ Subgroup.normalizer (oddCoreOf H.C.D.F.ρ₃.K : Set G) :=
    fun t ht => T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer ht.2)
  obtain ⟨o, ho, t, ht, rfl⟩ := T7L.mem_sup_normalForm hTN hxJ'
  have hzO : z * o * z⁻¹ ∈ oddCoreOf H.C.D.F.ρ₃.K :=
    mem_normalizer_oddCoreOf_of_mem_normalizer hzN ho
  have hxz' : z * (o * t) * z⁻¹ = o * t := by rw [← hxz]; group
  have e : o⁻¹ * (z * o * z⁻¹) = t * (z * t * z⁻¹)⁻¹ := by
    calc o⁻¹ * (z * o * z⁻¹) = o⁻¹ * (z * (o * t) * z⁻¹) * (z * t * z⁻¹)⁻¹ := by group
      _ = o⁻¹ * (o * t) * (z * t * z⁻¹)⁻¹ := by rw [hxz']
      _ = t * (z * t * z⁻¹)⁻¹ := by group
  have hmem : t * (z * t * z⁻¹)⁻¹ ∈ V ⊓ H.C.D.F.ρ₃.K :=
    Subgroup.mul_mem _ ht (Subgroup.inv_mem _ (hzT t ht))
  have h1 : t * (z * t * z⁻¹)⁻¹ = 1 :=
    eq_one_of_isPGroup_of_mem_odd (oddCoreOf_odd_natCard _)
      (e ▸ Subgroup.mul_mem _ (Subgroup.inv_mem _ ho) hzO)
      (hTs.2.1.to_le (Subgroup.zpowers_le.mpr hmem))
  have htz : t * z = z * t := by
    have h2 : t = z * t * z⁻¹ := by
      calc t = t * (z * t * z⁻¹)⁻¹ * (z * t * z⁻¹) := by group
        _ = z * t * z⁻¹ := by rw [h1, one_mul]
    calc t * z = (z * t * z⁻¹) * z := by rw [← h2]
      _ = z * t := by group
  have htD : t ∈ Subgroup.zpowers H.C.D.x₃ :=
    hDeq ▸ ⟨ht, Subgroup.mem_centralizer_singleton_iff.mpr htz⟩
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left ho) (Subgroup.mem_sup_right htD)

theorem W_eq_B_sup :
    W = (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) ⊔ Subgroup.zpowers H.C.D.x₃ := by
  refine le_antisymm (H.C.D.hgen.trans ((Subgroup.closure_le _).mpr ?_)) (sup_le
    (sup_le (Subgroup.zpowers_le.mpr H.C.D.x₁_mem) (Subgroup.zpowers_le.mpr H.C.D.x₂_mem))
    (Subgroup.zpowers_le.mpr H.C.D.x₃_mem))
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · exact Subgroup.mem_sup_left (Subgroup.mem_sup_left (Subgroup.mem_zpowers _))
  · exact Subgroup.mem_sup_left (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
  · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

variable (H) in
theorem exists_Oz_of_fix_J {m : G} (hm : m ∈ Cz)
    (hmB : conjSub m (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
      Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂)
    (hmJ : conjSub m H.C.D.F.ρ₃.K = H.C.D.F.ρ₃.K) :
    ∃ o ∈ Oz, conjSub m W = conjSub o W := by
  have hW := H.W_eq_B_sup
  have hBW : Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ ≤ W :=
    sup_le (Subgroup.zpowers_le.mpr H.C.D.x₁_mem) (Subgroup.zpowers_le.mpr H.C.D.x₂_mem)
  set B := Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ with hBdef
  set x' := m * H.C.D.x₃ * m⁻¹ with hx'def
  have hx'J : x' ∈ H.C.D.F.ρ₃.K := by
    rw [← hmJ, mem_conjSub_iff, hx'def]
    simpa [mul_assoc] using H.C.x₃_mem_J
  have hBcomm : ∀ b ∈ B, H.C.D.x₃ * b = b * H.C.D.x₃ := fun b hb =>
    H.W_comm H.C.D.x₃_mem (hBW hb)
  have hx'B : ∀ b ∈ B, x' * b = b * x' := by
    intro b hb
    have hb' : m⁻¹ * b * m ∈ B := by
      rw [← hmB, mem_conjSub_iff] at hb
      exact hb
    calc x' * b = m * (H.C.D.x₃ * (m⁻¹ * b * m)) * m⁻¹ := by rw [hx'def]; group
      _ = m * ((m⁻¹ * b * m) * H.C.D.x₃) * m⁻¹ := by rw [hBcomm _ hb']
      _ = b * x' := by rw [hx'def]; group
  have hzB : z ∈ B := by
    rw [← H.C.x₁_sq]
    exact Subgroup.mem_sup_left (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) 2)
  have hx'mem := H.mem_oddCore_sup_x₃ hx'J (hx'B z hzB)
  have hx₃N : Subgroup.zpowers H.C.D.x₃ ≤ Subgroup.normalizer (oddCoreOf H.C.D.F.ρ₃.K : Set G) :=
    Subgroup.zpowers_le.mpr (T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer H.C.x₃_mem_J))
  obtain ⟨o₀, ho₀, t, ht, hx't⟩ := T7L.mem_sup_normalForm hx₃N hx'mem
  have htB : ∀ b ∈ B, t * b = b * t := by
    intro b hb
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ht
    exact (Commute.zpow_left (hBcomm b hb) k).eq
  set N := oddCoreOf H.C.D.F.ρ₃.K ⊓ Subgroup.centralizer (B : Set G) with hNdef
  have ho₀N : o₀ ∈ N := by
    refine ⟨ho₀, Subgroup.mem_centralizer_iff.mpr fun b hb => ?_⟩
    have e : o₀ = x' * t⁻¹ := by rw [hx't]; group
    rw [e]
    exact ((Commute.symm (hx'B b hb)).mul_right (Commute.symm (htB b hb)).inv_right).eq
  have hNodd : Odd (Nat.card N) :=
    Odd.of_dvd_nat (oddCoreOf_odd_natCard _) (Subgroup.card_dvd_of_le inf_le_left)
  have hP2 : IsPGroup 2 (Subgroup.zpowers H.C.D.x₃) :=
    H.isPGroup_W.to_le (Subgroup.zpowers_le.mpr H.C.D.x₃_mem)
  have hx₃C : H.C.D.x₃ ∈ Subgroup.centralizer (B : Set G) :=
    Subgroup.mem_centralizer_iff.mpr fun b hb => (hBcomm b hb).symm
  have hPN : Subgroup.zpowers H.C.D.x₃ ≤ Subgroup.normalizer (N : Set G) := by
    refine Subgroup.zpowers_le.mpr ?_
    rw [Subgroup.mem_normalizer_iff]
    intro y
    rw [hNdef, Subgroup.mem_inf, Subgroup.mem_inf]
    exact and_congr (Subgroup.mem_normalizer_iff.mp
        (T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer H.C.x₃_mem_J)) y)
      (Subgroup.mem_normalizer_iff.mp (Subgroup.le_normalizer hx₃C) y)
  have hU2 : IsPGroup 2 (Subgroup.zpowers x') := by
    refine (isPGroup_conjSub m H.isPGroup_W).to_le (Subgroup.zpowers_le.mpr ?_)
    rw [mem_conjSub_iff, hx'def]
    simpa [mul_assoc] using H.C.D.x₃_mem
  have hUle : Subgroup.zpowers x' ≤ N ⊔ Subgroup.zpowers H.C.D.x₃ :=
    Subgroup.zpowers_le.mpr (hx't ▸ Subgroup.mul_mem _ (Subgroup.mem_sup_left ho₀N)
      (Subgroup.mem_sup_right ht))
  have hcard : Nat.card (Subgroup.zpowers x') = Nat.card (Subgroup.zpowers H.C.D.x₃) := by
    rw [Nat.card_zpowers, Nat.card_zpowers, hx'def, orderOf_conj']
  obtain ⟨o, ho, hoP⟩ := exists_conj_of_le_sup_odd hNodd hP2 hPN hU2 hUle hcard
  have hoB : conjSub o B = B := by
    refine AschTight.Sec7.conjSub_eq_of_le_self fun x hx => ?_
    rw [mem_conjSub_iff] at hx
    have hc := Subgroup.mem_centralizer_iff.mp ho.2 _ hx
    have e : o⁻¹ * x * o = x := by
      calc o⁻¹ * x * o = (o⁻¹ * x * o) * o * o⁻¹ := by group
        _ = o * (o⁻¹ * x * o) * o⁻¹ := by rw [hc]
        _ = x := by group
    rw [← e]
    exact hx
  refine ⟨o, H.oddCore_J_inf_le ho, ?_⟩
  rw [hW, conjSub_sup m B, conjSub_sup o B, hmB, hoB, hoP, conjSub_zpowers']

include H in
theorem conjSub_B_of {g : G}
    (h1 : g * H.C.D.x₁ * g⁻¹ ∈ Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂)
    (h2 : g * H.C.D.x₂ * g⁻¹ ∈ Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) :
    conjSub g (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
      Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ :=
  AschTight.Sec7.conjSub_eq_of_le_self (by
    rw [conjSub_sup, conjSub_zpowers', conjSub_zpowers']
    exact sup_le (Subgroup.zpowers_le.mpr h1) (Subgroup.zpowers_le.mpr h2))

theorem t_comm_z : H.C.D.F.ρ'.r * z = z * H.C.D.F.ρ'.r :=
  Subgroup.mem_centralizer_singleton_iff.mp
    (le_centralizer_of_unique H.C.hzK' (H.C.hd.hR'.2.1 H.C.t_mem_R'))

theorem t_conj_zj : H.C.D.F.ρ'.r * (z * H.C.D.F.j) * H.C.D.F.ρ'.r⁻¹ = H.C.D.F.j := by
  calc H.C.D.F.ρ'.r * (z * H.C.D.F.j) * H.C.D.F.ρ'.r⁻¹
      = (H.C.D.F.ρ'.r * z) * H.C.D.F.ρ'.r⁻¹ * (H.C.D.F.ρ'.r * H.C.D.F.j * H.C.D.F.ρ'.r⁻¹) := by
        group
    _ = z * (H.C.D.F.j * z) := by rw [H.t_comm_z, H.C.t_conj_j]; group
    _ = H.C.D.F.j := by rw [H.C.comm_jz, ← mul_assoc, H.C.hzK.sq, one_mul]

theorem t_mem_Hc : H.C.D.F.ρ'.r ∈
    Subgroup.centralizer ((Subgroup.closure ({z, H.a} : Set G) : Subgroup G) : Set G) :=
  mem_centralizer_closure_pair' H.t_comm_z.symm H.comm_t.symm

theorem rt_comm_z : H.rt * z = z * H.rt := by
  have hr : Commute H.C.D.F.ρ.r z :=
    Subgroup.mem_centralizer_singleton_iff.mp H.C.r_mem_centralizer_z
  exact (hr.mul_left H.t_comm_z).eq

theorem rt_mem_Hc : H.rt ∈
    Subgroup.centralizer ((Subgroup.closure ({z, H.a} : Set G) : Subgroup G) : Set G) :=
  mem_centralizer_closure_pair' H.rt_comm_z.symm H.comm_rt.symm

theorem t_B : conjSub H.C.D.F.ρ'.r (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
    Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ :=
  H.conjSub_B_of (by rw [H.C.D.t₁]; exact Subgroup.mem_sup_left (Subgroup.mem_zpowers _))
    (by rw [H.C.D.t₂]; exact Subgroup.mem_sup_right (Subgroup.inv_mem _ (Subgroup.mem_zpowers _)))

theorem r_B : conjSub H.C.D.F.ρ.r (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
    Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ :=
  H.conjSub_B_of (by rw [H.C.D.r₁]; exact Subgroup.mem_sup_left (Subgroup.inv_mem _ (Subgroup.mem_zpowers _)))
    (by rw [H.C.D.r₂]; exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _))

theorem rt_B : conjSub H.rt (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
    Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ := by
  rw [rt, conjSub_mul, H.t_B, H.r_B]

variable (H) in
theorem eq_J_or_Js {L : Subgroup G} (hL : L ∈ Ω) (hjL : IsUniqueInvolution L H.C.D.F.j) :
    L = H.C.D.F.ρ₃.K ∨ L = H.Js := by
  let F := H.C.toCtx8.toFrame
  obtain ⟨g, hg⟩ := F.trans _ H.C.D.F.ρ₃.hK
  have hKj : IsUniqueInvolution K (g⁻¹ * H.C.D.F.j * g) := by
    have := H.C.hjJ.conj g⁻¹
    rwa [← hg, conjSub_inv_conjSub, inv_inv] at this
  have key : ∀ L : Subgroup G, L ∈ Ω → IsUniqueInvolution L H.C.D.F.j →
      L = H.C.D.F.ρ₃.K ∨ L = conjSub g K' := by
    intro L hL hjL
    have hL' : conjSub g⁻¹ L ∈ Ω := F.hyp.conjInvariant _ _ hL
    have hjL' : IsUniqueInvolution (conjSub g⁻¹ L) (g⁻¹ * H.C.D.F.j * g) := by
      have := hjL.conj g⁻¹
      rwa [inv_inv] at this
    have hmem : conjSub g⁻¹ L ∈ twinSet Ω K := ⟨hL', _, hKj, hjL'⟩
    rw [F.twinSet_eq] at hmem
    rcases hmem with h | h
    · left
      rw [← hg, ← h, conjSub_conjSub_inv]
    · right
      rw [← h, conjSub_conjSub_inv]
  rcases key _ H.Js_mem H.hjJs with h | h
  · exact absurd h H.Js_ne
  · rcases key L hL hjL with h' | h'
    · exact Or.inl h'
    · exact Or.inr (h'.trans h.symm)

variable (H) in
theorem exists_H0_of_normalizes_B {m : G} (hm : m ∈ Cz)
    (hmB : conjSub m (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
      Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) :
    ∃ h ∈ H.H0, conjSub m W = conjSub h W := by
  have hBW : Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ ≤ W :=
    sup_le (Subgroup.zpowers_le.mpr H.C.D.x₁_mem) (Subgroup.zpowers_le.mpr H.C.D.x₂_mem)
  have stage2 : ∀ m : G, m ∈ Cz →
      conjSub m (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) =
        Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ →
      m * H.C.D.F.j * m⁻¹ = H.C.D.F.j → ∃ h ∈ H.H0, conjSub m W = conjSub h W := by
    intro m hm hmB hmj
    have hJ' : conjSub m H.C.D.F.ρ₃.K ∈ Ω :=
      H.C.hs.stand.hyp.conjInvariant m _ H.C.D.F.ρ₃.hK
    have hjJ' : IsUniqueInvolution (conjSub m H.C.D.F.ρ₃.K) H.C.D.F.j := hmj ▸ H.C.hjJ.conj m
    rcases H.eq_J_or_Js hJ' hjJ' with h | h
    · obtain ⟨o, ho, hoW⟩ := H.exists_Oz_of_fix_J hm hmB h
      exact ⟨o, Subgroup.mem_sup_right ho, hoW⟩
    · have hrtz : H.rt ∈ Cz := Subgroup.mem_centralizer_singleton_iff.mpr H.rt_comm_z
      obtain ⟨o, ho, hoW⟩ := H.exists_Oz_of_fix_J (m := H.rt⁻¹ * m)
        (Subgroup.mul_mem _ (Subgroup.inv_mem _ hrtz) hm)
        (by rw [conjSub_mul, hmB, AschTight.Sec7.conjSub_inv_eq H.rt_B])
        (by rw [conjSub_mul, h, Js, conjSub_inv_conjSub])
      refine ⟨H.rt * o, Subgroup.mul_mem _ (Subgroup.mem_sup_left H.rt_mem_Hc)
        (Subgroup.mem_sup_right ho), ?_⟩
      rw [conjSub_mul, ← hoW, ← conjSub_mul, mul_inv_cancel_left]
  have hjB : H.C.D.F.j ∈ Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ := by
    rw [H.C.j_eq]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left (Subgroup.inv_mem _ (Subgroup.mem_zpowers _)))
      (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
  have hmjB : m * H.C.D.F.j * m⁻¹ ∈ Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ := by
    have : m * H.C.D.F.j * m⁻¹ ∈
        conjSub m (Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂) := by
      rw [mem_conjSub_iff]
      simpa [mul_assoc] using hjB
    rwa [hmB] at this
  have hmj2 : m * H.C.D.F.j * m⁻¹ * (m * H.C.D.F.j * m⁻¹) = 1 := by
    calc m * H.C.D.F.j * m⁻¹ * (m * H.C.D.F.j * m⁻¹) = m * (H.C.D.F.j * H.C.D.F.j) * m⁻¹ := by
          group
      _ = 1 := by rw [H.C.hjJ.sq]; group
  have hmz : m * z = z * m := Subgroup.mem_centralizer_singleton_iff.mp hm
  rcases Asc77.S24.inv_W H.C (hBW hmjB) hmj2 with h0 | h0 | h0 | h0
  · exfalso
    apply H.C.hjJ.ne_one
    calc H.C.D.F.j = m⁻¹ * (m * H.C.D.F.j * m⁻¹) * m := by group
      _ = 1 := by rw [h0]; group
  · exfalso
    apply H.C.z_ne_j
    calc z = m⁻¹ * (m * z) := by group
      _ = m⁻¹ * (z * m) := by rw [hmz]
      _ = m⁻¹ * z * m := by group
      _ = m⁻¹ * (m * H.C.D.F.j * m⁻¹) * m := by rw [h0]
      _ = H.C.D.F.j := by group
  · exact stage2 m hm hmB h0
  · have htz : H.C.D.F.ρ'.r ∈ Cz := Subgroup.mem_centralizer_singleton_iff.mpr H.t_comm_z
    obtain ⟨h, hh, hW⟩ := stage2 (H.C.D.F.ρ'.r * m) (Subgroup.mul_mem _ htz hm)
      (by rw [conjSub_mul, hmB, H.t_B])
      (by
        calc H.C.D.F.ρ'.r * m * H.C.D.F.j * (H.C.D.F.ρ'.r * m)⁻¹
            = H.C.D.F.ρ'.r * (m * H.C.D.F.j * m⁻¹) * H.C.D.F.ρ'.r⁻¹ := by group
          _ = H.C.D.F.j := by rw [h0, H.t_conj_zj])
    refine ⟨H.C.D.F.ρ'.r⁻¹ * h, Subgroup.mul_mem _
      (Subgroup.mem_sup_left (Subgroup.inv_mem _ H.t_mem_Hc)) hh, ?_⟩
    rw [conjSub_mul, ← hW, ← conjSub_mul, inv_mul_cancel_left]

variable (H) in
theorem exists_H0_of_mem_NN {n : G} (hn : n ∈ H.NN) : ∃ h ∈ H.H0, conjSub n W = conjSub h W := by
  have hn1 := hn.2 1 (Subgroup.one_mem _)
  simp only [conjSub_one] at hn1
  have hBW : Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ ≤ W :=
    sup_le (Subgroup.zpowers_le.mpr H.C.D.x₁_mem) (Subgroup.zpowers_le.mpr H.C.D.x₂_mem)
  set B := Subgroup.zpowers H.C.D.x₁ ⊔ Subgroup.zpowers H.C.D.x₂ with hBdef
  have hnB : conjSub n B ≤ Oz ⊔ B := by
    rw [hBdef, conjSub_sup]
    refine sup_le ?_ ?_
    · calc conjSub n (Subgroup.zpowers H.C.D.x₁)
          ≤ conjSub n (Subgroup.zpowers H.C.D.x₁ ⊔ Oz) := conjSub_mono le_sup_left
        _ = Subgroup.zpowers H.C.D.x₁ ⊔ Oz := hn1.1
        _ ≤ Oz ⊔ B := sup_le (le_sup_left.trans le_sup_right) le_sup_left
    · calc conjSub n (Subgroup.zpowers H.C.D.x₂)
          ≤ conjSub n (Subgroup.zpowers H.C.D.x₂ ⊔ Oz) := conjSub_mono le_sup_left
        _ = Subgroup.zpowers H.C.D.x₂ ⊔ Oz := hn1.2
        _ ≤ Oz ⊔ B := sup_le (le_sup_right.trans le_sup_right) le_sup_left
  have hB2 : IsPGroup 2 B := H.isPGroup_W.to_le hBW
  have hBN : B ≤ Subgroup.normalizer (Oz : Set G) := fun b hb =>
    T7L.mem_normalizer_oddCoreOf (Subgroup.le_normalizer (H.W_le_Cz (hBW hb)))
  obtain ⟨o, ho, hoB⟩ := exists_conj_of_le_sup_odd (oddCoreOf_odd_natCard _) hB2 hBN
    (isPGroup_conjSub n hB2) hnB (natCard_conjSub _ _)
  have hoz : o ∈ Cz := Oz_le_Cz ho
  have hm : o⁻¹ * n ∈ Cz := Subgroup.mul_mem _ (Subgroup.inv_mem _ hoz) (H.NN_le hn)
  have hmB : conjSub (o⁻¹ * n) B = B := by rw [conjSub_mul, ← hoB, conjSub_inv_conjSub]
  obtain ⟨h, hh, hW⟩ := H.exists_H0_of_normalizes_B hm hmB
  refine ⟨o * h, Subgroup.mul_mem _ (Subgroup.mem_sup_right ho) hh, ?_⟩
  rw [conjSub_mul, ← hW, ← conjSub_mul, mul_inv_cancel_left]

theorem TC.transH0 (hT : H.TC S₁) : H.TransH0 := by
  intro W₁ hW₁ hzW₁
  obtain ⟨g, hg, hgW⟩ := Asc77.S24.exists_centralizer_conj_W H.C hW₁ hzW₁
  obtain ⟨n, hn, y, hy, rfl⟩ := hT.frattini hg
  obtain ⟨c, hc, hcW⟩ := hT.exists_conj_YY hy
  have hcH : c ∈ H.H0 := Subgroup.mem_sup_left hc
  have hcz : c ∈ Cz := H.H0_le_centralizer_z hcH
  have hn' : c⁻¹ * n * c ∈ H.NN := by
    have := H.conj_mem_NN (Subgroup.inv_mem _ hcz) hn
    rwa [inv_inv] at this
  obtain ⟨h, hh, hhW⟩ := H.exists_H0_of_mem_NN hn'
  refine ⟨c * h, Subgroup.mul_mem _ hcH hh, ?_⟩
  rw [← hgW, conjSub_mul c h, conjSub_mul n y, hcW, ← hhW, ← conjSub_mul, ← conjSub_mul]
  congr 1
  group

end HCtx

theorem transCentral_proved : TransCentral := by
  intro G _ _ _ Ω K K' W S R R' z u _ H S₁ hS₁W hRS₁ hR'S₁ haS₁ _
  exact HCtx.TC.transH0 (H := H) (S₁ := S₁) ⟨hS₁W, hRS₁, hR'S₁, haS₁⟩

