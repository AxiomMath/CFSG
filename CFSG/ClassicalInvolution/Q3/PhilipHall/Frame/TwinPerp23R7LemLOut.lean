variable {G : Type} [Group G] [Finite G] {Φ : Set (Subgroup G)}

theorem Q8Fam.thmDHyp (F : TwinDisc.ExitO2.Q8Fam G Φ) : ThmDHyp 3 Φ where
  hyp := F.hyp
  two := F.two
  card := F.card
  aEmpty := F.aEmpty
  gen := F.gen
  trans := F.trans
  odd := F.oddFree
  inO2 := F.inO2

theorem false_of_aeIdent (F : TwinDisc.ExitO2.Q8Fam G Φ) {m : ℕ} (hm : 5 ≤ m) (I : AEIdent Φ m)
    {K K' : Subgroup G} (hK : K ∈ Φ) (hK' : K' ∈ Φ) (hne : K' ≠ K)
    (hperp : ∀ J ∈ Φ, J ≠ K → J ≤ Subgroup.normalizer (K : Set G) → J = K') {a : G}
    (ha : HasS3Quot ↥(Ea Φ a))
    (mf5 : ModelNoS3 5 Set.univ ((AE.aeSub 5).map (AE.mkQ 5)))
    (mf6 : ModelNoS3 6 Set.univ ((AE.aeSub 6).map (AE.mkQ 6)))
    (mf7 : ModelNoS3 7 Set.univ ((AE.aeSub 7).map (AE.mkQ 7))) : False := by
  have hlabel : ∀ L ∈ Φ, ∃ α ∈ (Set.univ : Set (Finset (Fin m))), ∃ (h : α.card = 4) (b : Bool),
      (L.subgroupOf (pSpan Φ)).map I.φ = AE.memBar α h b := fun L hL => by
    obtain ⟨α, h, b, hlab⟩ := I.label L hL
    exact ⟨α, Set.mem_univ _, h, b, hlab⟩
  have hsurj : ∀ α ∈ (Set.univ : Set (Finset (Fin m))), ∀ (h : α.card = 4) (b : Bool), ∃ L ∈ Φ,
      (L.subgroupOf (pSpan Φ)).map I.φ = AE.memBar α h b := fun α _ h b => I.label_surj α h b
  have hrange : (I.φ.comp (toPSpan F.gen)) a ∈ (AE.aeSub m).map (AE.mkQ m) := by
    rw [← I.range_eq]; exact ⟨_, rfl⟩
  by_cases hm8 : 8 ≤ m
  · refine false_of_far F hm I.φ I.ker_le hlabel hsurj ?_ hK hne hperp hK'
    intro α _ hα
    have hc : 4 ≤ (αᶜ).card := by
      rw [Finset.card_compl, Fintype.card_fin]; omega
    obtain ⟨β, hβ, hβ4⟩ := Finset.exists_subset_card_eq hc
    exact ⟨β, Set.mem_univ _, hβ4, Finset.disjoint_of_subset_right hβ disjoint_compl_right⟩
  · have hS := hasS3Quot_model F hm I.φ I.ker_le hlabel hsurj ha
    have hm' : m = 5 ∨ m = 6 ∨ m = 7 := by omega
    rcases hm' with rfl | rfl | rfl
    · exact mf5 _ hrange hS
    · exact mf6 _ hrange hS
    · exact mf7 _ hrange hS

theorem false_of_e29 (F : TwinDisc.ExitO2.Q8Fam G Φ) (I : AEIdentOn Φ 8 AE.e29Sets AE.e29Sub)
    {K K' : Subgroup G} (hK : K ∈ Φ) (hK' : K' ∈ Φ) (hne : K' ≠ K)
    (hperp : ∀ J ∈ Φ, J ≠ K → J ≤ Subgroup.normalizer (K : Set G) → J = K') : False := by
  have hlabel : ∀ L ∈ Φ, ∃ α ∈ AE.e29Sets, ∃ (h : α.card = 4) (b : Bool),
      (L.subgroupOf (pSpan Φ)).map I.φ = AE.memBar α h b := fun L hL => I.label L hL
  have hsurj : ∀ α ∈ AE.e29Sets, ∀ (h : α.card = 4) (b : Bool), ∃ L ∈ Φ,
      (L.subgroupOf (pSpan Φ)).map I.φ = AE.memBar α h b := fun α hα h b => I.label_surj α hα h b
  refine false_of_far F (by norm_num) I.φ I.ker_le hlabel hsurj ?_ hK hne hperp hK'
  intro α hα hα4
  have key : ∀ α ∈ AE.affinePlanes, ∃ β ∈ AE.affinePlanes, β.card = 4 ∧ Disjoint α β := by
    decide +kernel
  obtain ⟨β, hβ, hβ4, hd⟩ := key α hα
  exact ⟨β, hβ, hβ4, hd⟩

theorem aeIdentOn_of_concl (F : TwinDisc.ExitO2.Q8Fam G Φ) (hconcl : ThmDConcl Φ)
    {K K' : Subgroup G} (hK : K ∈ Φ) (hK'tw : K' ∈ twinSet Φ K) (hne : K' ≠ K)
    (hperp : ∀ J ∈ Φ, J ≠ K → J ≤ Subgroup.normalizer (K : Set G) → J = K') {a : G}
    (ha : HasS3Quot ↥(Ea Φ a)) (hW : ¬ ∃ W : Subgroup G, WSet Φ = {W})
    (mf5 : ModelNoS3 5 Set.univ ((AE.aeSub 5).map (AE.mkQ 5)))
    (mf6 : ModelNoS3 6 Set.univ ((AE.aeSub 6).map (AE.mkQ 6)))
    (mf7 : ModelNoS3 7 Set.univ ((AE.aeSub 7).map (AE.mkQ 7))) :
    Nonempty (AEIdentOn Φ 7 AE.e64Sets AE.e64Sub) := by
  obtain ⟨hK'Φ, z, hzK, hzK'⟩ := hK'tw
  rcases hconcl with h1 | h2 | ⟨E, hE⟩ | h4 | ⟨m, hm, hI⟩ | hI29
  · exact absurd (h1 K' hK'Φ K hK) hne
  · exact absurd h2 hW
  · exact absurd (TC.Thin.eq_of_inv_e8 (Q8Fam.thmDHyp F) hE hK hK'Φ hzK hzK').symm hne
  · exact h4
  · obtain ⟨I⟩ := hI
    exact (false_of_aeIdent F hm I hK hK'Φ hne hperp ha mf5 mf6 mf7).elim
  · obtain ⟨I⟩ := hI29
    exact (false_of_e29 F I hK hK'Φ hne hperp).elim

