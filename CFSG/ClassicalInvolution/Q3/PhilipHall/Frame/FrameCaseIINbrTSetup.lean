theorem tightCore_eq_self_of_typeRHyp {G : Type} [Group G] {Ω : Set (Subgroup G)}
    (h : TypeRHyp Ω) {K : Subgroup G} (hK : K ∈ Ω) : tightCore K = K := by
  rcases h.hyp.omega2 K hK with h1 | hne
  · exact h1
  · exfalso
    obtain ⟨e⟩ := hne
    have h3 : IsPGroup 2 SL(2, ZMod 3) := (h.twoGroup K hK).of_equiv e
    obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 2)).mp h3
    rw [natCard_sl2Three] at hk
    have h3dvd : 3 ∣ 2 ^ k := by
      rw [← hk]
      norm_num
    exact absurd (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3dvd) (by norm_num)

theorem le_centralizer_of_isUniqueInvolution {G : Type} [Group G] {K : Subgroup G} {z : G}
    (h : IsUniqueInvolution K z) : K ≤ Subgroup.centralizer ({z} : Set G) := by
  intro k hk
  rw [Subgroup.mem_centralizer_singleton_iff]
  have hy : k * z * k⁻¹ ∈ K := K.mul_mem (K.mul_mem hk h.mem) (K.inv_mem hk)
  have hy2 : (k * z * k⁻¹) * (k * z * k⁻¹) = 1 := by
    calc (k * z * k⁻¹) * (k * z * k⁻¹) = k * (z * z) * k⁻¹ := by group
      _ = 1 := by rw [h.sq]; group
  rcases h.unique _ hy hy2 with h1 | h1
  · exfalso
    apply h.ne_one
    calc z = k⁻¹ * (k * z * k⁻¹) * k := by group
      _ = 1 := by rw [h1]; group
  · calc k * z = (k * z * k⁻¹) * k := by group
      _ = z * k := by rw [h1]

