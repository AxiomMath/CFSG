open PkG CFSG.EvenSmallLie.SympSix CFSG.LieType.Multipliers

@[expose] def baseGl : List ℕ :=
  [,
    ,
    ,
    ,
    ,
    ]

@[expose] def letterWords : List (List ℕ) :=
  [[0], [1], [2], [3], [4], [5], [0, 0, 0, 2, 3, 4, 5, 4, 3, 2, 3], [3, 3, 4, 5, 4, 3, 5, 1, 0, 2,
    2, 4, 5], [3, 3, 5, 3, 1, 0, 1, 3, 1, 5, 4, 3, 4, 2, 3, 4, 4, 5, 3, 4, 3, 3, 5, 3, 3, 1, 5, 3,
    2, 3, 4, 4, 0, 5, 0], [0, 5, 0, 1, 2, 1, 0, 5, 3, 3, 3], [2, 1, 5, 5, 3, 4, 2, 0, 1, 2, 1, 0,
    0], [3, 2, 3, 1, 1, 0, 5, 0, 2, 4, 0, 0, 2, 0, 0, 1, 0, 2, 1, 1, 0, 5, 1, 0, 1, 2, 4, 0, 4, 3,
    4, 0, 2, 0, 0], [3, 3, 3]]

@[expose] def GLt : List ℕ :=
  [,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ]

theorem GLt_eq : letterWords.map (evalW 256 240 baseGl) = GLt := by decide +kernel

@[expose] def invL (l : ℕ) : ℕ := ([3, 4, 5, 0, 1, 2, 9, 10, 11, 6, 7, 8, 12] : List ℕ).getD l l

@[expose] def invChk : Bool :=
  (List.range 13).all fun l => comp 256 240 (GLt.getD l (one 256 240)) (GLt.getD (invL l) (one 256 240)) ==
    one 256 240

@[expose] def zp : ℕ := GLt.getD 12 (one 256 240)

@[expose] def zChk : Bool :=
  comp 256 240 zp zp == one 256 240 && zp != one 256 240 &&
    (List.range 3).all fun k => comp 256 240 zp (GLt.getD k (one 256 240)) ==
      comp 256 240 (GLt.getD k (one 256 240)) zp

@[expose] def toLetters (w : List (Fin 3 × Bool)) : List ℕ :=
  w.map fun x => if x.2 then 6 + x.1.val else 9 + x.1.val

@[expose] def relChk : Bool :=
  rels.all fun r => evalW 256 240 GLt (toLetters r) == one 256 240 ||
    evalW 256 240 GLt (toLetters r) == zp

@[expose] def fixChk : Bool :=
  (List.finRange 3).all fun i =>
    evalW 256 240 GLt (toLetters (commWords (coverPairs i))) == GLt.getD (6 + i.val) (one 256 240)

@[expose] def dWords : List (List ℕ) :=
  [[8, 10, 11, 6, 7, 7, 8, 6, 10, 8, 6, 7, 11, 9, 10, 8, 10, 10, 9, 8, 7, 8, 7, 8], [6, 10, 10, 8,
    9, 10, 8, 10, 10, 9, 10, 11, 9, 7, 6, 8, 7, 6, 10, 11, 10, 6, 7, 6, 10], [10, 6, 7, 11, 10,
    10, 11, 9, 11, 11, 10, 6, 10, 6, 7, 6, 7, 11, 7]]

@[expose] def dChk : Bool :=
  (List.range 3).all fun k => evalW 256 240 GLt (dWords.getD k []) == baseGl.getD k (one 256 240)

end CFSG.ClassicalInvolution.Q3.PhilipHall.Frame.Twin1711.CovK
