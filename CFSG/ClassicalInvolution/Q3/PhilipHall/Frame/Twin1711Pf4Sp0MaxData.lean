@[expose] def omP : List ℕ := r2p :: omRecs.map (fun r => r.getD 0 0)

@[expose] def omRecChk (r : List ℕ) : Bool :=
  (r.drop 2).all tLetter && decide (r.getD 1 0 < 4) &&
    compP (compP (compP (compP (evalW GL (r.drop 2)) (GL.getD (16 + r.getD 1 0) oneP)) r2p)
      (GL.getD (20 + r.getD 1 0) oneP)) (evalW GL (invW (r.drop 2))) == r.getD 0 0

@[expose] def omRecsChk : Bool := omRecs.all omRecChk

@[expose] def omClosed : Bool :=
  omP.all fun p => (List.range 4).all fun l =>
    omP.contains (compP (compP (GL.getD l oneP) p) (GL.getD (invL l) oneP))

@[expose] def genWords : List (List ℕ) :=
  [[9, 20, 8, 16, 6, 20, 6, 20, 6, 20, 8, 4, 20, 4], [4, 20, 5, 16], [8, 4, 6, 7, 6, 4, 4, 4, 21,
    5, 7, 21, 9, 21, 21, 21, 4, 17, 4], [21, 9, 5, 21, 5, 17, 7, 21, 7, 21, 6, 6], [7, 6, 7, 9, 7,
    5, 18, 4], [7, 6, 7, 9, 7, 5, 18, 4, 4], [7, 23, 8, 23, 4], [7, 23, 8, 23, 4, 4]]

@[expose] def genLetter (i l : ℕ) : Bool := (decide (4 ≤ l) && decide (l ≤ 9)) || l == 16 + i || l == 20 + i

@[expose] def genChk : Bool :=
  (List.range 4).all fun i =>
    (genWords.getD (2 * i) []).all (genLetter i) && (genWords.getD (2 * i + 1) []).all (genLetter i) &&
    evalW GL (genWords.getD (2 * i) []) == pA && evalW GL (genWords.getD (2 * i + 1) []) == pB

theorem omRecsChk_true : omRecsChk = true := by decide +kernel

theorem omClosed_true : omClosed = true := by decide +kernel

theorem genChk_true : genChk = true := by decide +kernel

