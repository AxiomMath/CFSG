theorem p25_typedO2_proved
    : P25_TypedO2 := by
  intro G _ _ _ Ω K K' W S R R' z t u₁ u₂ hyp a haA ha2 ha1 hbad hO2
  have hT := TwinThmE.t4Supply_proved
  have hOE := TwinDisc.oddCentEdge_proved
  have hC := twinSecCtx_of_bad hyp ha2 ha1 haA hT (hOE _) hbad
  have hS := hC.S
  have htr := hC.trans
  have hcenter : a ∉ Subgroup.center G := by
    have hZ := CoreLike.center_eq_bot (G := G)
    rw [hZ]
    exact fun h => ha1 (Subgroup.mem_bot.mp h)
  have hlt := card_secQuot_lt (Ω := Ω) hcenter
  have hih : TwinThmE.EIH (Nat.card G) := hyp.std.1.ih
  have hedge := layer_edge hyp ha2 haA
  have hodd := hOE _ hih.1 hih.2 _ hlt _ hS htr hedge
  obtain ⟨M, hM, zb, hzb, hzbO⟩ := hO2
  have F := ExitU.q8Fam_of_q8Section hS htr hM hzb (hodd M hM zb hzb) hzbO
  have hD : TC.Thin.ThmDHyp 3 (TwinDisc.secFam Ω a) :=
    ⟨F.hyp, F.two, F.card, F.aEmpty, F.gen, F.trans, F.oddFree, F.inO2⟩
  obtain ⟨A, hA, A', hA', w, hnb, hw, hw', -⟩ := hC.twin
  have hne : A' ≠ A := hnb.2.1
  rcases F.thmDConcl hih.2.thmD.d2 hlt with h1 | ⟨W', hW'⟩ | ⟨E, hE⟩ | I64 | ⟨m, hm5, ⟨I⟩⟩ | I29
  · exact (hne (h1 A' hA' A hA)).elim
  · exact (false_of_wUnique hC hW').elim
  · exact (hne (TC.Thin.eq_of_inv_e8 hD hE hA' hA hw' hw)).elim
  · obtain ⟨I⟩ := I64
    exact (false_of_e64 hC aeNC4_e64 I).elim
  · by_cases hm6 : m ≤ 7
    · by_cases hm5' : m = 5
      · subst hm5'
        exact ⟨I, TwinThmEW.Ae5Q8.ae5_ker_bot hS I hA hA' hne hw hw'⟩
      · have hm67 : m = 6 ∨ m = 7 := by omega
        rcases hm67 with rfl | rfl
        · exact (false_of_aeIdent hC (by norm_num) (by norm_num) aeNC4_six I).elim
        · exact (false_of_aeIdent hC (by norm_num) (by norm_num) aeNC4_seven I).elim
    · exfalso
      obtain ⟨B, hB, C, hCB, D, hDB, hCD⟩ :=
        TL4.LinkE2.exists_two_nbrs_of_aeIdent hD (by omega) I
      exact hCD (hC.twinOnly B hB C hCB D hDB)
  · exfalso
    obtain ⟨I'⟩ := I29
    obtain ⟨B, hB, C, hCB, D, hDB, hCD⟩ := TL4.LinkE2.exists_two_nbrs_of_e29 hD I' hA
    exact hCD (hC.twinOnly B hB C hCB D hDB)

