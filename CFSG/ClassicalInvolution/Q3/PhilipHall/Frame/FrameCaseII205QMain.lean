section Tri

variable {G : Type} [Group G] [Finite G]

theorem tri_of_pair_bar {n : ℕ} (hSp : ModelFactSp62) (hD4 : ModelFactD42)
    (h4 : Thm4RTwinBelow 3 n) (hP : TL4.TightBelowRPlus 3 n) {K : Subgroup G}
    (hΩ : HypOmegaGen (CoreAssembly.conjClass K))
    (h2 : IsPGroup 2 (↥K ⧸ classicalInvolutionOddCore ↥K)) {M M₂ : Subgroup G}
    (hM : M ∈ CoreAssembly.conjClass K) (hM₂ : M₂ ∈ CoreAssembly.conjClass K) (hne : M₂ ≠ M)
    {z : G} (hz : IsUniqueInvolution M z) (hz₂ : IsUniqueInvolution M₂ z) {P : Subgroup G}
    (hPs : IsSylow2In P M) (hq : Nonempty (↥P ≃* QuaternionGroup 2)) {c : G} (hc2 : c * c = 1)
    (hc1 : c ≠ 1) (hlt0 : Nat.card ↥(Subgroup.centralizer ({c} : Set G)) < n)
    (hcM : c ∈ Balance.Bootstrap.trivialOnQuot M) (hcM₂ : c ∈ Balance.Bootstrap.trivialOnQuot M₂)
    (htc : z ∈ Subgroup.centralizer ({c} : Set G))
    (hPB : PairBarEmpty (tightCore (M.subgroupOf (Subgroup.centralizer ({c} : Set G))))
      ((TwinADescent.coreAt c M₂).subgroupOf (Subgroup.centralizer ({c} : Set G)))) :
    Quiet c z htc ∨ LiftedAtSec M c z htc ∨ (ExitAt M c z htc ∧ MovedOddFreeAt c z htc) := by
  obtain ⟨hMc, S, hh⟩ := secCoreHyp_of_member hP hΩ h2 hM hz hPs hq
  have hcl : CoreAssembly.conjClass M = CoreAssembly.conjClass K := conjClass_eq_of_mem hM
  have hcm : c ∈ centralizerModOdd ⊤ M :=
    ⟨Subgroup.mem_top _, hcM.1, Asc77.mem_normalizer_oddCore_of_mem_normalizer hcM.1,
      fun l hl => hcM.2 l hl⟩
  have hK' : M₂ ∈ twinSet (CoreAssembly.conjClass (tightCore M)) (tightCore M) := by
    rw [hMc, hcl]
    exact ⟨hM₂, z, hz, hz₂⟩
  have hK'ne : M₂ ≠ tightCore M := by
    rw [hMc]
    exact hne
  exact AzTri.quietLiftedSecExit_bar hSp hD4 h4 hh hMc hc2 hc1 hlt0 hPB hcm htc hK' hK'ne hcM₂

end Tri

section Vertex

variable {G : Type} [Group G] [Finite G] [FrameCore G]
  {K K' J : Subgroup G} {S : Sylow 2 G} {R R' W V : Subgroup G} {z t : G}
  {a c : G} {d : Std20Frame K K' J S R R' W V z t}

theorem hyp51At_of_quotEmpty (hSp : ModelFactSp62) (hD4 : ModelFactD42) (hM12 : ModelFactM12)
    (hT4 : ∀ n, CIT3Below n → TL4.TightBelowRPlus 3 n → Thm4RTwinBelow 3 n)
    (hcit : CIT3Below (Nat.card G)) (hP : TL4.TightBelowRPlus 3 (Nat.card G))
    (hd : Frame205Data d a) (hv : Vertex205 d a c)
    (hKe : AEmpty (oddQuotientFamily (omegaAFam (CoreAssembly.conjClass K)
        (Subgroup.centralizer ({c} : Set G))))
          ((frameKa K c).map (oqMk ↥(Subgroup.centralizer ({c} : Set G)))))
    (hK'e : AEmpty (oddQuotientFamily (omegaAFam (CoreAssembly.conjClass K)
        (Subgroup.centralizer ({c} : Set G))))
          ((frameKa K' c).map (oqMk ↥(Subgroup.centralizer ({c} : Set G))))) :
    Hyp51At (Subgroup.closure ({z, t, a} : Set G)) c := by
  have hB := isElemAbelian_B_vertex hd
  have hzB : z ∈ Subgroup.closure ({z, t, a} : Set G) := Subgroup.subset_closure (by simp)
  have hz1 : z ≠ 1 := d.viol.hzK.ne_one
  have hc2' := isPGroup_zpowers_vertex hv
  have hΛeq := omegaAFam_centralizer_eq_cFam d.hyp
    (TwinADescent3.isPGroup_two_quotient_conjClass d.twoGroup) hc2'
  have hKm := frameKa_mem_omegaAFam_of_vertex hv
  have hK'm := frameKa'_mem_omegaAFam_of_vertex hv
  rw [hΛeq] at hKe hK'e hKm hK'm
  have hΛ : HypOmegaGen (TwinDisc.cFam (CoreAssembly.conjClass K) c) :=
    TwinADescent.hypOmegaGen_coreFamily d.hyp hc2'
  have hPB : PairBarEmpty (frameKa K c) (frameKa K' c) :=
    pairBarEmpty_of_bar hΛ hKm hK'm hKe hK'e
  have hPB' : PairBarEmpty (frameKa K' c) (frameKa K c) :=
    pairBarEmpty_of_bar hΛ hK'm hKm hK'e hKe
  have hPB₁ : PairBarEmpty (tightCore (K.subgroupOf (Subgroup.centralizer ({c} : Set G))))
      ((TwinADescent.coreAt c K').subgroupOf (Subgroup.centralizer ({c} : Set G))) := by
    rw [TwinExitPf2.tightCore_subgroupOf_cent]
    exact hPB
  have hPB₂ : PairBarEmpty (tightCore (K'.subgroupOf (Subgroup.centralizer ({c} : Set G))))
      ((TwinADescent.coreAt c K).subgroupOf (Subgroup.centralizer ({c} : Set G))) := by
    rw [TwinExitPf2.tightCore_subgroupOf_cent]
    exact hPB'
  have h4 := hT4 _ hcit hP
  obtain ⟨ψ⟩ := (std20Frame_typeRHyp d).sylow K (CoreAssembly.mem_conjClass_self K) R d.hR
  obtain ⟨ψ'⟩ := (std20Frame_typeRHyp d).sylow K' d.late_mem_K' R' d.hR'
  have tK := tri_of_pair_bar hSp hD4 h4 hP d.hyp d.twoGroup (CoreAssembly.mem_conjClass_self K)
    d.late_mem_K' d.ne d.viol.hzK d.late_hzK' d.hR ⟨ψ⟩ hv.sq hv.ne_one
    (by simpa using hv.card_lt) hv.tqK hv.tqK' hv.z_cent hPB₁
  have tK' := tri_of_pair_bar hSp hD4 h4 hP d.hyp d.twoGroup d.late_mem_K'
    (CoreAssembly.mem_conjClass_self K) d.K_ne_K' d.late_hzK' d.viol.hzK d.hR' ⟨ψ'⟩ hv.sq
    hv.ne_one (by simpa using hv.card_lt) hv.tqK' hv.tqK hv.z_cent hPB₂
  rcases tK with q | l | ⟨e, m⟩
  · exact hyp51At_of_quiet hB hv.mem hzB hv.ne_one hz1 hv.z_ne hv.z_cent q
  · rcases tK' with q' | l' | ⟨e', m'⟩
    · exact hyp51At_of_quiet hB hv.mem hzB hv.ne_one hz1 hv.z_ne hv.z_cent q'
    · obtain ⟨-, S₁, h₁⟩ := secCoreHyp_of_member hP d.hyp d.twoGroup
        (CoreAssembly.mem_conjClass_self K) d.viol.hzK d.hR ⟨ψ⟩
      obtain ⟨-, S₂, h₂⟩ := secCoreHyp_of_member hP d.hyp d.twoGroup d.late_mem_K'
        d.late_hzK' d.hR' ⟨ψ'⟩
      exact hyp51At_of_liftedAt_vertex hcit hd hv (AzTri.liftedAt_of_liftedAtSec h₁ l)
        (AzTri.liftedAt_of_liftedAtSec h₂ l')
    · exact hyp51At_of_exit hSp hD4 hM12 hB hv.mem hzB hv.ne_one hz1 hv.z_ne hv.z_cent e' m'
  · exact hyp51At_of_exit hSp hD4 hM12 hB hv.mem hzB hv.ne_one hz1 hv.z_ne hv.z_cent e m

end Vertex

