@[expose] def Disc14YConnT (n : ℕ) : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t₀ : Y)
    (K K' : Subgroup Y) (z u : Y) (J : Subgroup Y) (t : Y) (W : Subgroup Y),
    Setting n R S t₀ K K' z u J t W →
      TwinMu.ThompsonWitness (CoreAssembly.conjClass (tightCore R)) K K' z u J →
      alphaOf (Subgroup.closure ({u, z} : Set Y)) = ⊥ →
        dComp (CoreAssembly.conjClass (tightCore R)) K ≠
            dstarComp (CoreAssembly.conjClass (tightCore R)) K →
          SecConnU (CoreAssembly.conjClass (tightCore R)) u →
            rLayer (CoreAssembly.conjClass (tightCore R)) u ≤
                sigmaGen (CoreAssembly.conjClass (tightCore R)) K ∨
              rLayer (CoreAssembly.conjClass (tightCore R)) u ≤ Subgroup.centralizer ({t * z} : Set Y)

@[expose] def Disc14YT (n : ℕ) : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t₀ : Y)
    (K K' : Subgroup Y) (z u : Y) (J : Subgroup Y) (t : Y) (W : Subgroup Y),
    Setting n R S t₀ K K' z u J t W →
      TwinMu.ThompsonWitness (CoreAssembly.conjClass (tightCore R)) K K' z u J →
      alphaOf (Subgroup.closure ({u, z} : Set Y)) = ⊥ →
        dComp (CoreAssembly.conjClass (tightCore R)) K ≠
            dstarComp (CoreAssembly.conjClass (tightCore R)) K →
          rLayer (CoreAssembly.conjClass (tightCore R)) u ≤
              sigmaGen (CoreAssembly.conjClass (tightCore R)) K ∨
            rLayer (CoreAssembly.conjClass (tightCore R)) u ≤ Subgroup.centralizer ({t * z} : Set Y)

@[expose] def Disc14YConnStar (n : ℕ) : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t₀ : Y)
    (K K' : Subgroup Y) (z u : Y) (J : Subgroup Y) (t : Y) (W : Subgroup Y),
    Setting n R S t₀ K K' z u J t W →
      TwinMu.ThompsonWitness (CoreAssembly.conjClass (tightCore R)) K K' z u J →
      alphaOf (Subgroup.closure ({u, z} : Set Y)) = ⊥ →
        dComp (CoreAssembly.conjClass (tightCore R)) K ≠
            dstarComp (CoreAssembly.conjClass (tightCore R)) K →
          SecConnU (CoreAssembly.conjClass (tightCore R)) u →
            ¬ rLayer (CoreAssembly.conjClass (tightCore R)) u ≤
                sigmaGen (CoreAssembly.conjClass (tightCore R)) K →
              rLayer (CoreAssembly.conjClass (tightCore R)) u ≤ Subgroup.centralizer ({t * z} : Set Y)

theorem disc14YConnT_of_star {n : ℕ} (h : Disc14YConnStar n) : Disc14YConnT n := by
  intro Y _ _ R S t₀ K K' z u J t W s hw hα hne hconn
  by_cases hA : rLayer (CoreAssembly.conjClass (tightCore R)) u ≤
      sigmaGen (CoreAssembly.conjClass (tightCore R)) K
  · exact Or.inl hA
  · exact Or.inr (h Y R S t₀ K K' z u J t W s hw hα hne hconn hA)

theorem disc14YT_of_connT {n : ℕ} (I : TwinDiscBase n) (hZT : DiscZT n) (hc : Disc14YConnT n) :
    Disc14YT n := by
  intro Y _ _ R S t₀ K K' z u J t W s hw hα hne
  set Ω := CoreAssembly.conjClass (tightCore R) with hΩdef
  have hf := s.data.frame
  have hs := alphaStepsBase I s
  have hΩ : HypOmegaGen Ω := s.core.hyp
  obtain ⟨h2, hq, hA⟩ := setup_members s
  have hc2 : IsPGroup 2 (Subgroup.zpowers u) :=
    CFSG.ClassicalInvolution.Asc77.ExactLayer.isPGroup_zpowers_of_sq_eq_one hf.hu2
  have hrY : rLayer Ω u ≤ coreLayer Ω u := rLayer_le_coreLayer hΩ h2 hc2
  by_cases hconn : SecConnU Ω u
  · exact hc Y R S t₀ K K' z u J t W s hw hα hne hconn
  · rcases hZT Y R S t₀ K K' z u J t W s hconn with hzt | htz
    · refine Or.inl (hrY.trans ?_)
      exact coreLayer_le_sigmaGen_of_le_centralizer_z hΩ hc2 hf.mem hf.hz
        (coreLayer_le_centralizer_of_trivial hs hf hc2 hα (Or.inl rfl) hzt)
    · exact Or.inr (hrY.trans
        (coreLayer_le_centralizer_of_trivial hs hf hc2 hα (Or.inr rfl) htz))


