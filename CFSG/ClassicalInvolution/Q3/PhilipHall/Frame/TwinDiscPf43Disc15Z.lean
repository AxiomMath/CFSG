variable {G : Type} [Group G] [Finite G] {Ω : Set (Subgroup G)} {W : Subgroup G}

theorem exists_w_adapted (c : Q3CL.Thompson.Ctx Ω W) (ρa ρb ρL : Rep Ω W) {z z_L : G}
    (hza : IsUniqueInvolution ρa.K z) (hzL : IsUniqueInvolution ρL.K z_L)
    (hLa : ρL.K ≠ ρa.K) (hLb : ρL.K ≠ ρb.K) (hnb : ρL.K ∉ omegaNbr Ω ρa.K)
    {w v : G} (hw : w ∈ ρa.K ⊓ W) (hv : v ∈ ρb.K ⊓ W) (hw2 : w * w = z) (hv2 : v * v = z) :
    ∃ w₀ : G, w₀ ∈ ρa.K ⊓ W ∧ w₀ * w₀ = z ∧ (w₀ * v = w * v ∨ w₀ * v = (w * v) * z) ∧
      ρL.R ≤ Subgroup.centralizer ({w₀ * v} : Set G) := by
  classical
  have hΩ := c.hΩ
  have hab := c.comm_W
  have hzW : z ∈ W := hw2 ▸ W.mul_mem hw.2 hw.2
  have hzz : z * z = 1 := hza.sq
  have hwv : w * v = v * w := hab w hw.2 v hv.2
  have hu₀W : w * v ∈ W := W.mul_mem hw.2 hv.2
  have hu₀sq : (w * v) * (w * v) = 1 := by
    calc (w * v) * (w * v) = w * (v * w) * v := by group
      _ = w * (w * v) * v := by rw [hwv]
      _ = (w * w) * (v * v) := by group
      _ = 1 := by rw [hw2, hv2, hzz]
  have hcw : ρL.r * w * ρL.r⁻¹ * w⁻¹ ∈ ρL.K ⊓ W := c.comm_mem ρL ρa hLa hw
  have hcv : ρL.r * v * ρL.r⁻¹ * v⁻¹ ∈ ρL.K ⊓ W := c.comm_mem ρL ρb hLb hv
  have hr₁ : ρL.r * w * ρL.r⁻¹ = (ρL.r * w * ρL.r⁻¹ * w⁻¹) * w := by group
  have hr₂ : ρL.r * v * ρL.r⁻¹ = (ρL.r * v * ρL.r⁻¹ * v⁻¹) * v := by group
  have heL : (ρL.r * w * ρL.r⁻¹ * w⁻¹) * (ρL.r * v * ρL.r⁻¹ * v⁻¹) ∈ ρL.K :=
    ρL.K.mul_mem hcw.1 hcv.1
  have heW : (ρL.r * w * ρL.r⁻¹ * w⁻¹) * (ρL.r * v * ρL.r⁻¹ * v⁻¹) ∈ W := W.mul_mem hcw.2 hcv.2
  generalize he₁ : ρL.r * w * ρL.r⁻¹ * w⁻¹ = e₁ at hcw hr₁ heL heW
  generalize he₂ : ρL.r * v * ρL.r⁻¹ * v⁻¹ = e₂ at hcv hr₂ heL heW
  have hru₀ : ρL.r * (w * v) * ρL.r⁻¹ = (e₁ * e₂) * (w * v) := by
    have h1 : ρL.r * (w * v) * ρL.r⁻¹ = (ρL.r * w * ρL.r⁻¹) * (ρL.r * v * ρL.r⁻¹) := by group
    rw [h1, hr₁, hr₂]
    have h2 : e₂ * w = w * e₂ := hab e₂ hcv.2 w hw.2
    calc e₁ * w * (e₂ * v) = e₁ * (w * e₂) * v := by group
      _ = e₁ * (e₂ * w) * v := by rw [h2]
      _ = (e₁ * e₂) * (w * v) := by group
  have hesq : (e₁ * e₂) * (e₁ * e₂) = 1 := by
    have hconj : (ρL.r * (w * v) * ρL.r⁻¹) * (ρL.r * (w * v) * ρL.r⁻¹) = 1 := by
      calc (ρL.r * (w * v) * ρL.r⁻¹) * (ρL.r * (w * v) * ρL.r⁻¹)
          = ρL.r * ((w * v) * (w * v)) * ρL.r⁻¹ := by group
        _ = 1 := by rw [hu₀sq]; group
    rw [hru₀] at hconj
    have heu : (e₁ * e₂) * (w * v) = (w * v) * (e₁ * e₂) := hab _ heW _ hu₀W
    calc (e₁ * e₂) * (e₁ * e₂) = ((e₁ * e₂) * (e₁ * e₂)) * ((w * v) * (w * v)) := by
          rw [hu₀sq, mul_one]
      _ = ((e₁ * e₂) * (w * v)) * ((e₁ * e₂) * (w * v)) := by
          calc ((e₁ * e₂) * (e₁ * e₂)) * ((w * v) * (w * v))
              = (e₁ * e₂) * ((e₁ * e₂) * (w * v)) * (w * v) := by group
            _ = (e₁ * e₂) * ((w * v) * (e₁ * e₂)) * (w * v) := by rw [heu]
            _ = ((e₁ * e₂) * (w * v)) * ((e₁ * e₂) * (w * v)) := by group
      _ = 1 := hconj
  have hrz : ρL.r * z * ρL.r⁻¹ = z_L * z :=
    c.conj_involution ρL ρa hLa (fun hnb' => hnb (Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ ρL.hK ρa.hK hnb'))
      hzL hza
  have hzLW : z_L ∈ W :=
    (Q3CL.Thompson.uniqueInvolution_mem_W hΩ c.hW ρL.hK ρL.hR ρL.hRK hzL).2
  rcases hzL.unique (e₁ * e₂) heL hesq with he1 | hez
  · refine ⟨w, hw, hw2, Or.inl rfl, ?_⟩
    have : ρL.r * (w * v) * ρL.r⁻¹ = w * v := by rw [hru₀, he1, one_mul]
    exact Q3T8.Asc77.T7N.R_le_centralizer_of_r_comm c ρL hu₀W (mul_inv_eq_iff_eq_mul.mp this)
  · have hwinv : w⁻¹ = w * z := by
      have h1 : w * (w * z) = 1 := by rw [← mul_assoc, hw2]; exact hzz
      exact (eq_inv_of_mul_eq_one_right h1).symm
    have hzv : z * v = v * z := hab z hzW v hv.2
    have hwv' : w⁻¹ * v = (w * v) * z := by
      rw [hwinv]
      calc w * z * v = w * (z * v) := mul_assoc _ _ _
        _ = w * (v * z) := by rw [hzv]
        _ = (w * v) * z := (mul_assoc _ _ _).symm
    refine ⟨w⁻¹, ⟨ρa.K.inv_mem hw.1, W.inv_mem hw.2⟩, ?_, Or.inr hwv', ?_⟩
    · calc w⁻¹ * w⁻¹ = (w * w)⁻¹ := (mul_inv_rev w w).symm
        _ = z⁻¹ := by rw [hw2]
        _ = z := inv_eq_of_mul_eq_one_right hzz
    · rw [hwv']
      refine Q3T8.Asc77.T7N.R_le_centralizer_of_r_comm c ρL (W.mul_mem hu₀W hzW) ?_
      have h1 : ρL.r * ((w * v) * z) * ρL.r⁻¹ =
          (ρL.r * (w * v) * ρL.r⁻¹) * (ρL.r * z * ρL.r⁻¹) := by group
      have h2 : ρL.r * ((w * v) * z) * ρL.r⁻¹ = (w * v) * z := by
        rw [h1, hru₀, hrz, hez]
        have hzu : z_L * (w * v) = (w * v) * z_L := hab z_L hzLW _ hu₀W
        have hzz' : z_L * z = z * z_L := hab z_L hzLW z hzW
        calc z_L * (w * v) * (z_L * z) = (z_L * (w * v)) * z_L * z := by group
          _ = ((w * v) * z_L) * z_L * z := by rw [hzu]
          _ = (w * v) * (z_L * z_L) * z := by group
          _ = (w * v) * z := by rw [hzL.sq, mul_one]
      exact mul_inv_eq_iff_eq_mul.mp h2


theorem exists_adapted_witness_frame (hP : Q3CL.PartIHypG Ω) {K K' J : Subgroup G} {z u t : G}
    (hf : TwinFrameData Ω K K' z u J t) (hD : dComp Ω K ≠ dstarComp Ω K)
    (hT : TwinMu.ThompsonWitness Ω K K' z u J) :
    ∃ (W' : Subgroup G) (w v r : G), Data Ω K K' z (w * v) J t W' ∧
      TwinMu.ThompsonWitness Ω K K' z (w * v) J ∧ w ∈ K ∧ v ∈ K' ∧ w * w = z ∧ v * v = z ∧
      W' ∈ WSet Ω ∧ w ∈ W' ∧ v ∈ W' ∧ r ∈ rLayer Ω (w * v) ∧ r ∉ sigmaNorm Ω K := by
  classical
  have hΩ : HypOmegaGen Ω := hP.hyp
  obtain ⟨W', hW', ρa, ρb, ρc, w, v, hKa, hKb, hKc, hw, hv, hw2, hv2, huv⟩ := hT
  have hK : K ∈ Ω := hf.mem
  have hz : IsUniqueInvolution K z := hf.hz
  have hzK' : IsUniqueInvolution K' z := isUniqueInvolution_of_mem_twinSet hz hf.hK'
  have hK'Ω : K' ∈ Ω := hf.hK'.1
  have c : Q3CL.Thompson.Ctx Ω W' := Q3CL.T8.ctxOf hP hW'
  have hnc : ¬ DbarConnected Ω W' := Q3T6.Mu.thompsonGraphAll hP hK hD hW'
  obtain ⟨ρL, hL1', hL2'⟩ := Q3T8.Asc77.T7N.exists_noncomm_rep c hnc ρa
  have hL1 : ρL.K ≠ K := by rw [← hKa]; exact hL1'
  have hL2 : ρL.K ∉ omegaNbr Ω K := by rw [← hKa]; exact hL2'
  have hK'K : K' ∈ omegaNbr Ω K := Q3CL.T3.twin_mem_omegaNbr hΩ hK hK'Ω hf.hne hz hzK'
  have hLK' : ρL.K ≠ K' := fun e => hL2 (e ▸ hK'K)
  obtain ⟨z_L, hzL⟩ := Sec6Gen.exists_uniqueInvolution hΩ ρL.hK
  have hwa : w ∈ ρa.K ⊓ W' := by rw [hKa]; exact hw
  have hvb : v ∈ ρb.K ⊓ W' := by rw [hKb]; exact hv
  obtain ⟨w₀, hw₀, hw₀2, hw₀v, hRL⟩ := exists_w_adapted c ρa ρb ρL (hKa ▸ hz) hzL
    (by rw [hKa]; exact hL1) (by rw [hKb]; exact hLK') (by rw [hKa]; exact hL2) hwa hvb hw2 hv2
  have hw₀K : w₀ ∈ K ⊓ W' := by rw [← hKa]; exact hw₀
  have hzc : IsUniqueInvolution ρc.K t := by rw [hKc]; exact hf.ht
  have htW' : t ∈ W' := (Q3CL.Thompson.uniqueInvolution_mem_W hΩ hW' ρc.hK ρc.hR ρc.hRK hzc).2
  have hzW' : z ∈ W' := hw2 ▸ W'.mul_mem hw.2 hw.2
  have hcW := Q3CL.Thompson.commutes_of_mem_WSet hΩ hW'
  have hu₀W : w₀ * v ∈ W' := W'.mul_mem hw₀K.2 hv.2
  have hu₂ : (w₀ * v) * (w₀ * v) = 1 := by
    have hwv : w₀ * v = v * w₀ := hcW _ hw₀K.2 _ hv.2
    calc (w₀ * v) * (w₀ * v) = w₀ * (v * w₀) * v := by group
      _ = w₀ * (w₀ * v) * v := by rw [← hwv]
      _ = (w₀ * w₀) * (v * v) := by group
      _ = 1 := by rw [hw₀2, hv2]; exact hz.sq
  have hzinv : z⁻¹ = z := inv_eq_of_mul_eq_one_right hz.sq
  have hu1 : w₀ * v ≠ 1 := by
    rcases hw₀v with h | h
    · rw [h, huv]; exact hf.hu1
    · rw [h, huv]; intro h1
      apply hf.huz
      have : u = z⁻¹ := eq_inv_of_mul_eq_one_left h1
      rw [this, hzinv]
  have huz : w₀ * v ≠ z := by
    rcases hw₀v with h | h
    · rw [h, huv]; exact hf.huz
    · rw [h, huv]; intro h1
      apply hf.hu1
      have : u * z = 1 * z := by rw [h1, one_mul]
      exact mul_right_cancel this
  have hfr : TwinFrameData Ω K K' z (w₀ * v) J t :=
    { mem := hK
      hz := hz
      hK' := hf.hK'
      hne := hf.hne
      hu := Subgroup.mul_mem _ (Subgroup.mem_sup_left hw₀K.1) (Subgroup.mem_sup_right hv.1)
      hu2 := hu₂
      hu1 := hu1
      huz := huz
      hJ := hf.hJ
      ht := hf.ht
      htu := hcW _ htW' _ hu₀W }
  have hRL' : ρL.R ≤ rLayer Ω (w₀ * v) := le_iSup₂_of_le _ ρL.hR.1 (le_iSup_of_le hRL le_rfl)
  refine ⟨W', w₀, v, ρL.r, ⟨hfr, hW', hzW', htW'⟩,
    ⟨W', hW', ρa, ρb, ρc, w₀, v, hKa, hKb, hKc, hw₀K, hv, hw₀2, hv2, rfl⟩, hw₀K.1, hv.1, hw₀2, hv2,
    hW', hw₀K.2, hv.2, hRL' ρL.hr, ?_⟩
  exact rep_not_mem_sigmaNorm_gen hP hW' hK hD ρa ρL hKa hL1 hL2

end Adapt

section Move

variable {G : Type} [Group G] [Finite G]

theorem commute_of_comm_le_oddCore {K S R₁ : Subgroup G} (hS2 : IsPGroup 2 ↥S)
    (hSinv : ∀ r ∈ R₁, conjSub r S = S) (hc : ⁅R₁, K⁆ ≤ oddCoreOf K) {r x : G} (hr : r ∈ R₁)
    (hxS : x ∈ S) (hxK : x ∈ K) : r * x = x * r := by
  have h1 : ⁅r, x⁆ ∈ oddCoreOf K := hc (Subgroup.commutator_mem_commutator hr hxK)
  have h2 : ⁅r, x⁆ ∈ S := by
    have : r * x * r⁻¹ ∈ conjSub r S := conj_mem_conjSub hxS
    rw [hSinv r hr] at this
    rw [commutatorElement_def]
    exact S.mul_mem this (S.inv_mem hxS)
  have h3 : ⁅r, x⁆ = 1 :=
    eq_one_of_isPGroup_of_mem_odd (oddCoreOf_odd_natCard K) h1
      (hS2.to_le (Subgroup.zpowers_le.mpr h2))
  exact commutatorElement_eq_one_iff_mul_comm.mp h3

theorem exists_conj_centralizes_wv {K K' R₁ W' : Subgroup G} (hR₁2 : IsPGroup 2 ↥R₁)
    (hR₁K : R₁ ≤ Subgroup.normalizer (K : Set G)) (hR₁K' : R₁ ≤ Subgroup.normalizer (K' : Set G))
    (hKK' : K ≤ Subgroup.normalizer (K' : Set G)) (hK'K : K' ≤ Subgroup.normalizer (K : Set G))
    (hc : ⁅R₁, K⁆ ≤ oddCoreOf K) (hc' : ⁅R₁, K'⁆ ≤ oddCoreOf K') (hW2 : IsPGroup 2 ↥W')
    {w v : G} (hw : w ∈ K ⊓ W') (hv : v ∈ K' ⊓ W') :
    ∃ h ∈ K ⊔ K', conjSub h R₁ ≤
      Subgroup.centralizer ({w} : Set G) ⊓ Subgroup.centralizer ({v} : Set G) := by
  classical
  have hHK : K ⊔ K' ≤ Subgroup.normalizer (K : Set G) := sup_le Subgroup.le_normalizer hK'K
  have hHK' : K ⊔ K' ≤ Subgroup.normalizer (K' : Set G) := sup_le hKK' Subgroup.le_normalizer
  have hR₁H : R₁ ≤ Subgroup.normalizer ((K ⊔ K' : Subgroup G) : Set G) := by
    intro r hr
    rw [mem_normalizer_iff_conjSub_eq, T7A.conjSub_sup_eq,
      mem_normalizer_iff_conjSub_eq.mp (hR₁K hr), mem_normalizer_iff_conjSub_eq.mp (hR₁K' hr)]
  obtain ⟨S, hS, hSinv⟩ := T3.exists_sylow_normalized hR₁2 hR₁H
  have hT2 : IsPGroup 2 ↥(W' ⊓ (K ⊔ K')) := hW2.to_inf_left
  obtain ⟨S₀, hS₀, hTS₀⟩ := IsSylow2In.exists_ge hT2 (inf_le_right : W' ⊓ (K ⊔ K') ≤ K ⊔ K')
  obtain ⟨h, hhH, hconj⟩ := Thompson.exists_conj_of_isSylow2In hS hS₀
  refine ⟨h, hhH, ?_⟩
  have hwS₀ : w ∈ S₀ := hTS₀ ⟨hw.2, Subgroup.mem_sup_left hw.1⟩
  have hvS₀ : v ∈ S₀ := hTS₀ ⟨hv.2, Subgroup.mem_sup_right hv.1⟩
  have hhK : h ∈ Subgroup.normalizer (K : Set G) := hHK hhH
  have hhK' : h ∈ Subgroup.normalizer (K' : Set G) := hHK' hhH
  have hKe : conjSub h K = K := mem_normalizer_iff_conjSub_eq.mp hhK
  have hK'e : conjSub h K' = K' := mem_normalizer_iff_conjSub_eq.mp hhK'
  have hwS : h⁻¹ * w * h ∈ S := by
    rw [← mem_conjSub_iff, hconj]; exact hwS₀
  have hvS : h⁻¹ * v * h ∈ S := by
    rw [← mem_conjSub_iff, hconj]; exact hvS₀
  have hwK : h⁻¹ * w * h ∈ K := by
    rw [← mem_conjSub_iff, hKe]; exact hw.1
  have hvK : h⁻¹ * v * h ∈ K' := by
    rw [← mem_conjSub_iff, hK'e]; exact hv.1
  have hS2 : IsPGroup 2 ↥S := hS.2.1
  intro x hx
  rw [mem_conjSub_iff] at hx
  have hxw := commute_of_comm_le_oddCore hS2 hSinv hc hx hwS hwK
  have hxv := commute_of_comm_le_oddCore hS2 hSinv hc' hx hvS hvK
  refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
  · rw [Subgroup.mem_centralizer_singleton_iff]
    calc x * w = h * ((h⁻¹ * x * h) * (h⁻¹ * w * h)) * h⁻¹ := by group
      _ = h * ((h⁻¹ * w * h) * (h⁻¹ * x * h)) * h⁻¹ := by rw [hxw]
      _ = w * x := by group
  · rw [Subgroup.mem_centralizer_singleton_iff]
    calc x * v = h * ((h⁻¹ * x * h) * (h⁻¹ * v * h)) * h⁻¹ := by group
      _ = h * ((h⁻¹ * v * h) * (h⁻¹ * x * h)) * h⁻¹ := by rw [hxv]
      _ = v * x := by group

end Move

section Layer

variable {Y : Type} [Group Y] [Finite Y] {Ω : Set (Subgroup Y)} {K K' J W' : Subgroup Y} {z u t : Y}

theorem involution_eq_of_layer (hP : Q3CL.PartIHypG Ω) (hf : TwinFrameData Ω K K' z u J t)
    (hne : dComp Ω K ≠ dstarComp Ω K) (hKt : K ≤ Subgroup.centralizer ({t} : Set Y))
    (hK't : K' ≤ Subgroup.centralizer ({t} : Set Y)) (hW2 : IsPGroup 2 ↥W') {w v : Y}
    (hw : w ∈ K ⊓ W') (hv : v ∈ K' ⊓ W')
    (hlayer : ∀ R' ∈ RSet Ω, R' ≤ Subgroup.centralizer ({w * v} : Set Y) →
      R' ≤ Subgroup.centralizer ({t * z} : Set Y))
    {J₁ : Subgroup Y} {t₁ : Y} (hJ₁ : J₁ ∈ omegaNbr Ω K) (ht₁ : IsUniqueInvolution J₁ t₁)
    (hJ₁K' : J₁ ≠ K') (hJ₁J : J₁ ≠ J) : t₁ = t := by
  classical
  have hΩ : HypOmegaGen Ω := hP.hyp
  have hK : K ∈ Ω := hf.mem
  have hK'Ω : K' ∈ Ω := hf.hK'.1
  have hz : IsUniqueInvolution K z := hf.hz
  have hzK' : IsUniqueInvolution K' z := isUniqueInvolution_of_mem_twinSet hz hf.hK'
  obtain ⟨hJ₁Ω, hJ₁K, R₁, hR₁, hR₁J₁, hR₁N⟩ := hJ₁
  have hR₁S : IsSylow2In R₁ J₁ := Q3CL.T3.isSylow2In_of_mem_RSet_of_le hΩ hJ₁Ω hR₁ hR₁J₁
  have hR₁2 : IsPGroup 2 R₁ := hR₁S.2.1
  have h8₁ : 8 ≤ Nat.card R₁ := Sec6Gen.eight_le_of_mem_RSet hΩ hR₁
  have hR₁z : R₁ ≤ Subgroup.centralizer ({z} : Set Y) := fun x hx => by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact commute_involution_of_conjSub_eq hz (mem_normalizer_iff_conjSub_eq.mp (hR₁N hx))
  have hR₁K' : R₁ ≤ Subgroup.normalizer (K' : Set Y) :=
    Sec6Gen.le_normalizer_of_le_centralizer hΩ hK'Ω hJ₁Ω (fun e => hJ₁K' e.symm) hzK' hR₁J₁ hR₁2
      (by omega) hR₁z
  have hKN' : K ≤ Subgroup.normalizer (K' : Set Y) :=
    Sec6Gen.le_normalizer_of_twin hΩ hK hK'Ω hf.hne.symm hz hzK'
  have hK'N : K' ≤ Subgroup.normalizer (K : Set Y) :=
    Sec6Gen.le_normalizer_of_twin hΩ hK'Ω hK hf.hne hzK' hz
  have hc : ⁅R₁, K⁆ ≤ oddCoreOf K :=
    Q3CL.Thompson.comm_le_oddCore_of_isSylow2In Sec6Gen.l6_2Gen hΩ hK hJ₁Ω hJ₁K.symm hz ht₁ hR₁S
      hR₁z
  have hc' : ⁅R₁, K'⁆ ≤ oddCoreOf K' :=
    Q3CL.Thompson.comm_le_oddCore_of_isSylow2In Sec6Gen.l6_2Gen hΩ hK'Ω hJ₁Ω hJ₁K'.symm hzK' ht₁
      hR₁S hR₁z
  obtain ⟨h, hhH, hconj⟩ := exists_conj_centralizes_wv hR₁2 hR₁N hR₁K' hKN' hK'N hc hc' hW2 hw hv
  have hhK : h ∈ Subgroup.normalizer (K : Set Y) := (sup_le Subgroup.le_normalizer hK'N) hhH
  have hhK' : h ∈ Subgroup.normalizer (K' : Set Y) := (sup_le hKN' Subgroup.le_normalizer) hhH
  have hht : h ∈ Subgroup.centralizer ({t} : Set Y) := (sup_le hKt hK't) hhH
  have hR₂set : conjSub h R₁ ∈ RSet Ω := RSet.conj hΩ.conjInvariant hR₁ h
  have hR₂J₂ : conjSub h R₁ ≤ conjSub h J₁ := conjSub_mono (n := h) hR₁J₁
  have hJ₂Ω : conjSub h J₁ ∈ Ω := hΩ.conjInvariant h J₁ hJ₁Ω
  have hR₂N : conjSub h R₁ ≤ Subgroup.normalizer (K : Set Y) := by
    intro x hx
    rw [mem_conjSub_iff] at hx
    have hx' := hR₁N hx
    have e : x = h * (h⁻¹ * x * h) * h⁻¹ := by group
    rw [e]
    exact (Subgroup.normalizer (K : Set Y)).mul_mem
      ((Subgroup.normalizer (K : Set Y)).mul_mem hhK hx')
      ((Subgroup.normalizer (K : Set Y)).inv_mem hhK)
  have hR₂z : conjSub h R₁ ≤ Subgroup.centralizer ({z} : Set Y) := fun x hx => by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact commute_involution_of_conjSub_eq hz (mem_normalizer_iff_conjSub_eq.mp (hR₂N hx))
  have hR₂c : conjSub h R₁ ≤ Subgroup.centralizer ({w * v} : Set Y) := by
    intro x hx
    obtain ⟨hxw, hxv⟩ := Subgroup.mem_inf.mp (hconj hx)
    have hxw' := Subgroup.mem_centralizer_singleton_iff.mp hxw
    have hxv' := Subgroup.mem_centralizer_singleton_iff.mp hxv
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc x * (w * v) = (x * w) * v := by rw [mul_assoc]
      _ = (w * x) * v := by rw [hxw']
      _ = w * (x * v) := by rw [mul_assoc]
      _ = w * (v * x) := by rw [hxv']
      _ = (w * v) * x := by rw [mul_assoc]
  have hR₂tz := hlayer _ hR₂set hR₂c
  have hR₂t : conjSub h R₁ ≤ Subgroup.centralizer ({t} : Set Y) :=
    le_centralizer_of_le_centralizer_mul hR₂tz fun y hy =>
      Subgroup.mem_centralizer_singleton_iff.mp (hR₂z hy)
  have ht₂ : IsUniqueInvolution (conjSub h J₁) (h * t₁ * h⁻¹) := ht₁.conj h
  have hJ₂K : conjSub h J₁ ≠ K := by
    intro e
    apply hJ₁K
    have h1 := congrArg (conjSub h⁻¹) e
    rw [conjSub_inv_conjSub, mem_normalizer_iff_conjSub_eq.mp (Subgroup.inv_mem _ hhK)] at h1
    exact h1
  have hJ₂K' : conjSub h J₁ ≠ K' := by
    intro e
    apply hJ₁K'
    have h1 := congrArg (conjSub h⁻¹) e
    rw [conjSub_inv_conjSub, mem_normalizer_iff_conjSub_eq.mp (Subgroup.inv_mem _ hhK')] at h1
    exact h1
  have hJ₂t : h * t₁ * h⁻¹ = t := by
    by_cases hJ₂J : conjSub h J₁ = J
    · exact (hf.ht.eq (by rw [← hJ₂J]; exact ht₂)).symm
    · exact involution_eq_of_sylow_gen hP hf hne hKt hK't hJ₂Ω hR₂set hR₂J₂ hR₂N hR₂t ht₂ hJ₂K
        hJ₂K' hJ₂J
  have hht' : h * t = t * h := Subgroup.mem_centralizer_singleton_iff.mp hht
  calc t₁ = h⁻¹ * (h * t₁ * h⁻¹) * h := by group
    _ = h⁻¹ * t * h := by rw [hJ₂t]
    _ = h⁻¹ * (t * h) := by group
    _ = h⁻¹ * (h * t) := by rw [hht']
    _ = t := by group

end Layer

section Main

variable {n : ℕ}

theorem discNormCentT_of_y14T (I : TwinDiscBase n) (hT : DiscTqTz n) (hY : Disc14YT n) :
    DiscNormCentT n := by
  classical
  intro Y _ _ R S t₀ K K' z u J t W s hw hα hD
  set Ω := CoreAssembly.conjClass (tightCore R) with hΩdef
  have hP : Q3CL.PartIHypG Ω := TwinPerp.partIHypG s.core
  have hΩ : HypOmegaGen Ω := hP.hyp
  have hs := alphaStepsBase I s
  have hf := s.data.frame
  have hne : dComp Ω K ≠ dstarComp Ω K := fun heq =>
    hD (Pf2.rLayer_tz_le_sigmaGen_of_eq hT s hα heq)
  have hK : K ∈ Ω := hf.mem
  have hz : IsUniqueInvolution K z := hf.hz
  have hzK' : IsUniqueInvolution K' z := isUniqueInvolution_of_mem_twinSet hz hf.hK'
  have htz : t ≠ z := by
    intro htz
    have hJV : J ∈ twinSet Ω K := ⟨hf.hJ.1, z, hz, htz ▸ hf.ht⟩
    exact (hf.hJ.2 J hJV).2.1 rfl
  have hKt : K ≤ Subgroup.centralizer ({t} : Set Y) :=
    twin_le_centralizer_t_gen hs hf hα (mem_twinSet_self hK hz)
  have hK't : K' ≤ Subgroup.centralizer ({t} : Set Y) :=
    twin_le_centralizer_t_gen hs hf hα hf.hK'
  obtain ⟨W', w, v, r, d₀, hw₀, hwK, hvK', hw2, hv2, hW', hwW, hvW, hr, hrn⟩ :=
    exists_adapted_witness_frame hP hf hne hw
  have s₀ : Setting n R S t₀ K K' z (w * v) J t W' := ⟨s.core, s.disc, d₀⟩
  have hα₀ : alphaOf (Subgroup.closure ({w * v, z} : Set Y)) = ⊥ := by
    rw [← hs.alpha_zt d₀.frame, hs.alpha_zt hf, hα]
  have hYD : rLayer Ω (w * v) ≤ Subgroup.centralizer ({t * z} : Set Y) := by
    rcases hY Y R S t₀ K K' z (w * v) J t W' s₀ hw₀ hα₀ hne with hA | hB
    · exact absurd (T7A.sigmaGen_le_sigmaNorm hΩ.conjInvariant hK (hA hr)) hrn
    · exact hB
  have hlayer : ∀ R' ∈ RSet Ω, R' ≤ Subgroup.centralizer ({w * v} : Set Y) →
      R' ≤ Subgroup.centralizer ({t * z} : Set Y) := fun R' hR' hc => by
    have h1 : R' ≤ rLayer Ω (w * v) := le_iSup₂_of_le R' hR' (le_iSup_of_le hc le_rfl)
    exact h1.trans hYD
  have hW2 : IsPGroup 2 ↥W' := isPGroup_of_mem_WSet hW'
  intro g hg
  have hgK : conjSub g K = K := mem_normalizer_iff_conjSub_eq.mp hg
  have hgz : g * z = z * g := commute_involution_of_conjSub_eq hz hgK
  have hJ₁ : conjSub g J ∈ omegaNbr Ω K := by
    have := omegaNbr_conj hΩ.conjInvariant (hf.hJ.2 K (mem_twinSet_self hK hz)) g
    rwa [hgK] at this
  have ht₁ : IsUniqueInvolution (conjSub g J) (g * t * g⁻¹) := hf.ht.conj g
  have htt : g * t * g⁻¹ = t := by
    by_cases hJK' : conjSub g J = K'
    · exfalso
      have e1 : g * t * g⁻¹ = z := ht₁.eq (by rw [hJK']; exact hzK')
      apply htz
      have e2 : g * t = z * g := mul_inv_eq_iff_eq_mul.mp e1
      calc t = g⁻¹ * (g * t) := by group
        _ = g⁻¹ * (z * g) := by rw [e2]
        _ = g⁻¹ * (g * z) := by rw [hgz]
        _ = z := by group
    · by_cases hJJ : conjSub g J = J
      · exact (hf.ht.eq (by rw [← hJJ]; exact ht₁)).symm
      · exact involution_eq_of_layer hP hf hne hKt hK't hW2 ⟨hwK, hwW⟩ ⟨hvK', hvW⟩ hlayer hJ₁ ht₁
          hJK' hJJ
  have hgt : g * t = t * g := mul_inv_eq_iff_eq_mul.mp htt
  rw [Subgroup.mem_centralizer_singleton_iff]
  calc g * (t * z) = (g * t) * z := by rw [mul_assoc]
    _ = (t * g) * z := by rw [hgt]
    _ = t * (g * z) := by rw [mul_assoc]
    _ = t * (z * g) := by rw [hgz]
    _ = (t * z) * g := by rw [mul_assoc]

theorem disc15T_of_y14T (I : TwinDiscBase n) (hT : DiscTqTz n) (hY : Disc14YT n) : Disc15T n := by
  intro Y _ _ R S t₀ K K' z u J t W s _ hα hD
  exact disc15_of_normCent (discNormCent_of_normCentT I (discNormCentT_of_y14T I hT hY)) hT
    Y R S t₀ K K' z u J t W s hα hD

theorem disc15T_of_y14ConnT (hcit : CIT3Below n) (hP : TL4.TightBelowRPlus 3 n)
    (h4 : Thm4RTwinBelow 3 n) (hc : Disc14YConnT n) : Disc15T n :=
  disc15T_of_y14T (twinDiscBase_of_thm4 h4)
    (discTqTz_of_conn (twinDiscBase_of_thm4 h4)
      (discSecConnTz_of h4 (dstarConnectedTwinQ8Below_of_exit hcit hP
        (dstarExitQ8_proved ExitE4.e4ModelDStar_of_certs hcit hP))))
    (disc14YT_of_connT (twinDiscBase_of_thm4 h4) (discZT_proved hcit hP h4) hc)

end Main

