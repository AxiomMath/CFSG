theorem eq_one_of_mem_pGroup_of_mem_oddCoreIn {P X : Subgroup G} (hP : IsPGroup 2 P) {g : G}
    (hgP : g ∈ P) (hg : g ∈ oddCoreIn X) : g = 1 := by
  obtain ⟨k, hk⟩ := hP ⟨g, hgP⟩
  have h1 : orderOf g ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one (by simpa using congrArg Subtype.val hk)
  have h2 : Odd (orderOf g) := (odd_card_oddCoreIn X).of_dvd_nat (Subgroup.orderOf_dvd_natCard _ hg)
  obtain ⟨i, -, hi⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp h1
  rcases i with _ | i
  · exact orderOf_eq_one_iff.mp (by simpa using hi)
  · rw [hi, pow_succ] at h2
    exact absurd h2 (by simp [Nat.not_odd_iff_even])

theorem inf_le_centralizer_of_trivialOnQuot {P X : Subgroup G} (hP : IsPGroup 2 P) {u : G}
    (huP : u ∈ P) (hu : u ∈ trivialOnQuot X) : P ⊓ X ≤ Subgroup.centralizer ({u} : Set G) := by
  intro s hs
  rw [Subgroup.mem_centralizer_singleton_iff]
  have hc : ⁅u, s⁆ ∈ oddCoreIn X := hu.2 s hs.2
  have hcP : ⁅u, s⁆ ∈ P := by
    rw [commutatorElement_def]
    exact P.mul_mem (P.mul_mem (P.mul_mem huP hs.1) (P.inv_mem huP)) (P.inv_mem hs.1)
  have h1 := eq_one_of_mem_pGroup_of_mem_oddCoreIn hP hcP hc
  rw [commutatorElement_def] at h1
  have : u * s * u⁻¹ = s := by
    calc u * s * u⁻¹ = (u * s * u⁻¹ * s⁻¹) * s := by group
      _ = s := by rw [h1, one_mul]
  calc s * u = (u * s * u⁻¹) * u := by rw [this]
    _ = u * s := by group

theorem isSylow2In_inf_of_sylow_le {P N X T : Subgroup G} (hP : IsSylow2In P N)
    (hNX : N ≤ Subgroup.normalizer (X : Set G)) (hT : IsSylow2In T X) (hTN : T ≤ N) :
    IsSylow2In (P ⊓ X) X := by
  set Y := X ⊓ N with hYdef
  have hYN : Y ≤ N := inf_le_right
  have hnY : N ≤ Subgroup.normalizer (Y : Set G) := by
    intro g hg
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · rintro ⟨hX, hN⟩
      exact ⟨(Subgroup.mem_normalizer_iff.mp (hNX hg) h).mp hX,
        N.mul_mem (N.mul_mem hg hN) (N.inv_mem hg)⟩
    · rintro ⟨hX, hN⟩
      refine ⟨(Subgroup.mem_normalizer_iff.mp (hNX hg) h).mpr hX, ?_⟩
      have := N.mul_mem (N.mul_mem (N.inv_mem hg) hN) hg
      simpa [mul_assoc] using this
  have hPY : IsSylow2In (P ⊓ Y) Y := Sec7.isSylow2In_inf_of_normal hP hYN hnY
  have hTY : IsSylow2In T Y :=
    ⟨le_inf hT.1 hTN, hT.2.1, fun V' hV' h2 hle => hT.2.2 V' (hV'.trans inf_le_left) h2 hle⟩
  obtain ⟨c, hcY, hc⟩ := S1916.IsSylow2In.exists_conj hTY hPY
  have hPYX : P ⊓ Y = P ⊓ X := by
    rw [hYdef, ← inf_assoc, inf_comm P X, inf_assoc, inf_eq_left.mpr hP.1, inf_comm]
  rw [← hPYX, ← hc]
  have := IsSylow2In.conj hT c
  rwa [conjSub_eq_self_of_mem hcY.1] at this

theorem exists_commuting_sylows (hΩ : HypOmegaGen Ω) {J J' J₀ : Subgroup G} {t u : G}
    (hq : ∀ M ∈ Ω, ∀ P : Subgroup G, IsSylow2In P M → Nonempty (↥P ≃* QuaternionGroup 2))
    (hu2 : IsPGroup 2 (Subgroup.zpowers u))
    (hJ : J ∈ tqMembers3 Ω u) (hJ' : J' ∈ tqMembers3 Ω u) (hJ₀ : J₀ ∈ tqMembers3 Ω u)
    (ht : IsUniqueInvolution J t) (htw : J' ∈ twinSet Ω J) (hne : J' ≠ J)
    (hJ₀J : J₀ ∈ omegaNbr Ω J) (hJ₀J' : J₀ ≠ J') :
    ∃ T T' T₀ : Subgroup G, IsSylow2In T J ∧ IsSylow2In T' J' ∧ IsSylow2In T₀ J₀ ∧
      T ≤ Subgroup.centralizer ({u} : Set G) ∧ T' ≤ Subgroup.centralizer ({u} : Set G) ∧
      T₀ ≤ Subgroup.centralizer ({u} : Set G) ∧
      Commutes T T' ∧ Commutes T T₀ ∧ Commutes T' T₀ ∧ IsPGroup 2 ↥(T ⊔ T' ⊔ T₀) := by
  have hJΩ : J ∈ Ω := hJ.1
  have hJ'Ω : J' ∈ Ω := hJ'.1
  have hJ₀Ω : J₀ ∈ Ω := hJ₀.1
  have ht' : IsUniqueInvolution J' t := Asc77.isUniqueInvolution_of_mem_twinSet ht htw
  have hJ₀ne : J₀ ≠ J := hJ₀J.2.1
  have hJJ' : J ≤ Subgroup.normalizer (J' : Set G) :=
    Sec6Gen.le_normalizer_of_twin hΩ hJΩ hJ'Ω hne.symm ht ht'
  have hJ'J : J' ≤ Subgroup.normalizer (J : Set G) :=
    Sec6Gen.le_normalizer_of_twin hΩ hJ'Ω hJΩ hne ht' ht
  have h1 : J ∈ omegaNbr Ω J₀ := Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ hJΩ hJ₀Ω hJ₀J
  have h2' : J₀ ∈ omegaNbr Ω J' := by
    have hm : J₀ ∈ KPerp Ω J' := by
      rw [← A7Q.Gen.kPerp_eq_of_twin hΩ hJΩ htw]
      exact Set.mem_insert_of_mem _ hJ₀J
    rcases hm with h | h
    · exact absurd h hJ₀J'
    · exact h
  have h2 : J' ∈ omegaNbr Ω J₀ := Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ hJ'Ω hJ₀Ω h2'
  obtain ⟨T₁, hT₁R, hT₁J, hT₁N⟩ := h1.2.2
  obtain ⟨T₂, hT₂R, hT₂J', hT₂N⟩ := h2.2.2
  obtain ⟨T₃, hT₃R, hT₃J₀, hT₃N⟩ := hJ₀J.2.2
  have sT₁ : IsSylow2In T₁ J := Q3CL.T3.isSylow2In_of_mem_RSet_of_le hΩ hJΩ hT₁R hT₁J
  have sT₂ : IsSylow2In T₂ J' := Q3CL.T3.isSylow2In_of_mem_RSet_of_le hΩ hJ'Ω hT₂R hT₂J'
  have sT₃ : IsSylow2In T₃ J₀ := Q3CL.T3.isSylow2In_of_mem_RSet_of_le hΩ hJ₀Ω hT₃R hT₃J₀
  have hT₃t : T₃ ≤ Subgroup.centralizer ({t} : Set G) :=
    Sec6Gen.le_centralizer_of_le_normalizer' ht hT₃N
  have hT₃N' : T₃ ≤ Subgroup.normalizer (J' : Set G) :=
    Hat2A7S.le_normalizer_of_sylow_centralizes hΩ hJ₀Ω hJ'Ω (fun h => hJ₀J' h.symm) ht' sT₃
      (fun x hx => (Subgroup.mem_centralizer_singleton_iff.mp (hT₃t hx)).symm)
  set N : Subgroup G := Subgroup.normalizer (J : Set G) ⊓ Subgroup.normalizer (J' : Set G) ⊓
    Subgroup.normalizer (J₀ : Set G) with hNdef
  have huN : u ∈ N := ⟨⟨hJ.2.1, hJ'.2.1⟩, hJ₀.2.1⟩
  obtain ⟨P, hP, huP⟩ := IsSylow2In.exists_ge hu2 ((Subgroup.zpowers_le).mpr huN)
  have huP' : u ∈ P := huP (Subgroup.mem_zpowers u)
  have hP2 : IsPGroup 2 P := hP.2.1
  have hNJ : N ≤ Subgroup.normalizer (J : Set G) := inf_le_left.trans inf_le_left
  have hNJ' : N ≤ Subgroup.normalizer (J' : Set G) := inf_le_left.trans inf_le_right
  have hNJ₀ : N ≤ Subgroup.normalizer (J₀ : Set G) := inf_le_right
  have hT₁le : T₁ ≤ N := le_inf (le_inf (fun x hx => Subgroup.le_normalizer (hT₁J hx))
    (sT₁.1.trans hJJ')) hT₁N
  have hT₂le : T₂ ≤ N := le_inf (le_inf (sT₂.1.trans hJ'J)
    (fun x hx => Subgroup.le_normalizer (hT₂J' hx))) hT₂N
  have hT₃le : T₃ ≤ N := le_inf (le_inf hT₃N hT₃N') (fun x hx => Subgroup.le_normalizer (hT₃J₀ hx))
  have sJ := isSylow2In_inf_of_sylow_le hP hNJ sT₁ hT₁le
  have sJ' := isSylow2In_inf_of_sylow_le hP hNJ' sT₂ hT₂le
  have sJ₀ := isSylow2In_inf_of_sylow_le hP hNJ₀ sT₃ hT₃le
  have cJ := inf_le_centralizer_of_trivialOnQuot hP2 huP' hJ.2
  have cJ' := inf_le_centralizer_of_trivialOnQuot hP2 huP' hJ'.2
  have cJ₀ := inf_le_centralizer_of_trivialOnQuot hP2 huP' hJ₀.2
  obtain ⟨S, hS⟩ := IsPGroup.exists_le_sylow hP2
  have rJ := mem_RSet_of_isSylow2In hJΩ sJ
  have rJ' := mem_RSet_of_isSylow2In hJ'Ω sJ'
  have rJ₀ := mem_RSet_of_isSylow2In hJ₀Ω sJ₀
  have hne' : ∀ {X X' : Subgroup G}, X ∈ Ω → X' ∈ Ω → X ≠ X' → IsSylow2In (P ⊓ X) X →
      IsSylow2In (P ⊓ X') X' → P ⊓ X ≠ P ⊓ X' := by
    intro X X' hX hX' hXX' sX sX' heq
    obtain ⟨e⟩ := hq X hX _ sX
    have h8 : Nat.card ↥(P ⊓ X) = 8 := by
      rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
    exact hXX' (Sec6Gen.eq_of_le_of_le hΩ hX hX' sX.2.1 (by omega) inf_le_right
      (heq ▸ inf_le_right))
  refine ⟨P ⊓ J, P ⊓ J', P ⊓ J₀, sJ, sJ', sJ₀, cJ, cJ', cJ₀, ?_, ?_, ?_, ?_⟩
  · exact Q3CP.l67Gen G Ω hΩ S _ rJ _ rJ' (inf_le_left.trans hS) (inf_le_left.trans hS)
      (hne' hJΩ hJ'Ω hne.symm sJ sJ')
  · exact Q3CP.l67Gen G Ω hΩ S _ rJ _ rJ₀ (inf_le_left.trans hS) (inf_le_left.trans hS)
      (hne' hJΩ hJ₀Ω hJ₀ne.symm sJ sJ₀)
  · exact Q3CP.l67Gen G Ω hΩ S _ rJ' _ rJ₀ (inf_le_left.trans hS) (inf_le_left.trans hS)
      (hne' hJ'Ω hJ₀Ω hJ₀J'.symm sJ' sJ₀)
  · exact hP2.to_le (sup_le (sup_le inf_le_left inf_le_left) inf_le_left)

theorem exists_conj_le_DSet (hΩ : HypOmegaGen Ω) {W : Subgroup G} (hW : W ∈ WSet Ω) {x : G}
    (hxW : x ∈ W) {P' : Subgroup G} (hP' : IsPGroup 2 P') (hP'Y : P' ≤ rLayer Ω x) :
    ∃ y ∈ rLayer Ω x, ∀ R ∈ RSet Ω, R ≤ P' → conjSub y R ∈ DSet Ω W := by
  set Y : Subgroup G := rLayer Ω x with hY
  have hcomm := Q3CL.Thompson.commutes_of_mem_WSet hΩ hW
  have hW2 : IsPGroup 2 W := isPGroup_of_mem_WSet hW
  have hWC : W ≤ Subgroup.centralizer ({x} : Set G) := fun w hw => by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (hcomm x hxW w hw).symm
  have hWY : W ≤ Subgroup.normalizer (Y : Set G) := fun w hw =>
    mem_normalizer_iff_conjSub_eq.mpr (TwinMu.Pf3.conjSub_rLayer hΩ (hWC hw))
  obtain ⟨P, hP, hWP⟩ := AscQuot.exists_sylow_normalized' hW2 hWY
  have hWPn : W ≤ Subgroup.normalizer (P : Set G) := fun w hw =>
    mem_normalizer_iff_conjSub_eq.mpr (hWP w hw)
  have hWPsup : IsPGroup 2 ↥(W ⊔ P) := hW2.to_sup_of_normal_right' hP.2.1 hWPn
  obtain ⟨S, hS⟩ := IsPGroup.exists_le_sylow hWPsup
  have hPS : P ≤ (S : Subgroup G) := le_sup_right.trans hS
  have hWS : W ≤ (S : Subgroup G) := le_sup_left.trans hS
  obtain ⟨R', hR'Y, hRR'⟩ := IsSylow2In.exists_ge hP' hP'Y
  obtain ⟨c, hcY, hc⟩ := S1916.IsSylow2In.exists_conj hP hR'Y
  refine ⟨c⁻¹, Y.inv_mem hcY, fun R hR hRP => ?_⟩
  have hle : conjSub c⁻¹ R ≤ P := by
    have h1 := conjSub_mono (n := c⁻¹) ((hRP.trans hRR').trans hc.symm.le)
    rwa [conjSub_inv_conjSub] at h1
  exact Q3CL.Thompson.mem_DSet_of_le_sylow hΩ hW hWS (Q3CL.Thompson.conjSub_mem_RSet hΩ hR c⁻¹)
    (hle.trans hPS)

theorem no_comm_triple_swap (a b c : Equiv.Perm (Fin 4)) (ha : a.IsSwap) (hb : b.IsSwap)
    (hc : c.IsSwap) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) (cab : a * b = b * a)
    (cac : a * c = c * a) : b * c ≠ c * b := by
  obtain ⟨i, j, hij, rfl⟩ := ha
  obtain ⟨k, l, hkl, rfl⟩ := hb
  obtain ⟨m, n, hmn, rfl⟩ := hc
  revert i j k l m n
  decide

theorem no_comm_triple_muDeltaCent (hP : Q3CL.PartIHypG Ω) {W : Subgroup G} (hW : W ∈ WSet Ω)
    (hnc : ¬ DbarConnected Ω W)
    {ρa ρb ρc : Rep Ω W} (hab : muTabElt ρa ≠ muTabElt ρb) (hac : muTabElt ρa ≠ muTabElt ρc)
    (hbc : muTabElt ρb ≠ muTabElt ρc)
    (cab : muTabElt ρa * muTabElt ρb = muTabElt ρb * muTabElt ρa)
    (cac : muTabElt ρa * muTabElt ρc = muTabElt ρc * muTabElt ρa)
    {w v : G} (hw : w ∈ ρa.R ⊓ W) (hv : v ∈ ρb.R ⊓ W) (hw4 : orderOf w = 4) (hv4 : orderOf v = 4)
    {x₁ x₂ x₃ : ↥(muGroup Ω W)} (h₁ : x₁ ∈ muDeltaCent Ω W (w * v))
    (h₂ : x₂ ∈ muDeltaCent Ω W (w * v)) (h₃ : x₃ ∈ muDeltaCent Ω W (w * v))
    (h12 : x₁ ≠ x₂) (h13 : x₁ ≠ x₃) (h23 : x₂ ≠ x₃)
    (c12 : x₁ * x₂ = x₂ * x₁) (c13 : x₁ * x₃ = x₃ * x₁) : x₂ * x₃ ≠ x₃ * x₂ := by
  obtain ⟨ψ, hψ⟩ := TwinMu.perm_four_twin hP hW hnc hab hac hbc cab cac hw hv hw4 hv4
  have m₁ := Subgroup.subset_closure h₁
  have m₂ := Subgroup.subset_closure h₂
  have m₃ := Subgroup.subset_closure h₃
  intro c23
  apply no_comm_triple_swap (ψ ⟨x₁, m₁⟩) (ψ ⟨x₂, m₂⟩) (ψ ⟨x₃, m₃⟩)
    ((hψ x₁ m₁).mp h₁) ((hψ x₂ m₂).mp h₂) ((hψ x₃ m₃).mp h₃)
  · exact fun h => h12 (by simpa using congrArg Subtype.val (ψ.injective h))
  · exact fun h => h13 (by simpa using congrArg Subtype.val (ψ.injective h))
  · exact fun h => h23 (by simpa using congrArg Subtype.val (ψ.injective h))
  · rw [← map_mul, ← map_mul]; congr 1; exact Subtype.ext c12
  · rw [← map_mul, ← map_mul]; congr 1; exact Subtype.ext c13
  · rw [← map_mul, ← map_mul]; congr 1; exact Subtype.ext c23

theorem exists_rep_conj (hΩ : HypOmegaGen Ω) {W : Subgroup G} (hW : W ∈ WSet Ω) {x y : G}
    (hyC : y ∈ Subgroup.centralizer ({x} : Set G)) {X T : Subgroup G} (hX : X ∈ Ω)
    (sT : IsSylow2In T X) (hTx : T ≤ Subgroup.centralizer ({x} : Set G))
    (hD : conjSub y T ∈ DSet Ω W) :
    ∃ ρ : Rep Ω W, ρ.K = conjSub y X ∧ ρ.R = conjSub y T ∧ muTabElt ρ ∈ muDeltaCent Ω W x := by
  obtain ⟨r, hr, hrW⟩ := Q3CL.Thompson.exists_not_mem_of_mem_D hΩ hW hD
  let ρ : Rep Ω W := ⟨conjSub y X, conjSub y T, r, hΩ.conjInvariant y X hX, hD,
    IsSylow2In.conj sT y, hr, hrW⟩
  have hTC : conjSub y T ≤ Subgroup.centralizer ({x} : Set G) := by
    have h1 := conjSub_mono (n := y) hTx
    rwa [conjSub_eq_self_of_mem hyC] at h1
  exact ⟨ρ, rfl, rfl, ⟨conjSub y T, ⟨hD, hTC⟩, r, hr, hrW, rfl⟩⟩

theorem twin_count_core (hP : Q3CL.PartIHypG Ω)
    (hq : ∀ M ∈ Ω, ∀ P : Subgroup G, IsSylow2In P M → Nonempty (↥P ≃* QuaternionGroup 2))
    {W : Subgroup G} (hW : W ∈ WSet Ω) (hnc : ¬ DbarConnected Ω W)
    {ρa ρb ρc : Rep Ω W} (hab : muTabElt ρa ≠ muTabElt ρb) (hac : muTabElt ρa ≠ muTabElt ρc)
    (hbc : muTabElt ρb ≠ muTabElt ρc)
    (cab : muTabElt ρa * muTabElt ρb = muTabElt ρb * muTabElt ρa)
    (cac : muTabElt ρa * muTabElt ρc = muTabElt ρc * muTabElt ρa)
    {w v : G} (hw : w ∈ ρa.R ⊓ W) (hv : v ∈ ρb.R ⊓ W) (hw4 : orderOf w = 4) (hv4 : orderOf v = 4)
    (hu2 : IsPGroup 2 (Subgroup.zpowers (w * v)))
    {J J' J₀ : Subgroup G} {t : G}
    (hJ : J ∈ tqMembers3 Ω (w * v)) (hJ' : J' ∈ tqMembers3 Ω (w * v))
    (hJ₀ : J₀ ∈ tqMembers3 Ω (w * v)) (ht : IsUniqueInvolution J t)
    (htw : J' ∈ twinSet Ω J) (hne : J' ≠ J) (hJ₀J : J₀ ∈ omegaNbr Ω J) (hJ₀J' : J₀ ≠ J') :
    False := by
  have ctx := Q3CL.T8.ctxOf hP hW
  have hΩ : HypOmegaGen Ω := hP.hyp
  obtain ⟨T, T', T₀, sT, sT', sT₀, cT, cT', cT₀, mTT', mTT₀, mT'T₀, h2⟩ :=
    exists_commuting_sylows hΩ hq hu2 hJ hJ' hJ₀ ht htw hne hJ₀J hJ₀J'
  have huW : w * v ∈ W := W.mul_mem hw.2 hv.2
  have lay : ∀ R ∈ RSet Ω, R ≤ Subgroup.centralizer ({w * v} : Set G) → R ≤ rLayer Ω (w * v) :=
    fun R hR hRx => le_iSup₂_of_le R hR
      (le_iSup (fun _ : R ≤ Subgroup.centralizer ({w * v} : Set G) => R) hRx)
  have rT := mem_RSet_of_isSylow2In hJ.1 sT
  have rT' := mem_RSet_of_isSylow2In hJ'.1 sT'
  have rT₀ := mem_RSet_of_isSylow2In hJ₀.1 sT₀
  have hle : T ⊔ T' ⊔ T₀ ≤ rLayer Ω (w * v) :=
    sup_le (sup_le (lay T rT cT) (lay T' rT' cT')) (lay T₀ rT₀ cT₀)
  obtain ⟨y, hyY, hyD⟩ := exists_conj_le_DSet hΩ hW huW h2 hle
  have hyC : y ∈ Subgroup.centralizer ({w * v} : Set G) := Asc77.rLayer_le_centralizer Ω _ hyY
  obtain ⟨ρ₁, hK₁, hR₁, hm₁⟩ := exists_rep_conj hΩ hW hyC hJ.1 sT cT
    (hyD T rT (le_sup_left.trans le_sup_left))
  obtain ⟨ρ₂, hK₂, hR₂, hm₂⟩ := exists_rep_conj hΩ hW hyC hJ'.1 sT' cT'
    (hyD T' rT' (le_sup_right.trans le_sup_left))
  obtain ⟨ρ₃, hK₃, hR₃, hm₃⟩ := exists_rep_conj hΩ hW hyC hJ₀.1 sT₀ cT₀
    (hyD T₀ rT₀ le_sup_right)
  have dist : ∀ (σ τ : Rep Ω W) (X X' : Subgroup G), σ.K = conjSub y X → τ.K = conjSub y X' →
      X ≠ X' → muTabElt σ ≠ muTabElt τ := by
    intro σ τ X X' hσ hτ hXX' h
    have hK := ctx.K_eq_of_img_eq σ τ (congrArg Subtype.val h)
    rw [hσ, hτ] at hK
    exact hXX' ((conjSub_inj y).mp hK)
  have comm : ∀ (σ τ : Rep Ω W) (A B : Subgroup G), σ.R = conjSub y A → τ.R = conjSub y B →
      Commutes A B → muTabElt σ * muTabElt τ = muTabElt τ * muTabElt σ := by
    intro σ τ A B hσ hτ hAB
    apply Subtype.ext
    have hσr : y⁻¹ * σ.r * y ∈ A := mem_conjSub_iff.mp (hσ ▸ σ.hr)
    have hτr : y⁻¹ * τ.r * y ∈ B := mem_conjSub_iff.mp (hτ ▸ τ.hr)
    have hc := hAB _ hσr _ hτr
    have hc' : σ.r * τ.r = τ.r * σ.r := by
      have := congrArg (fun g => y * g * y⁻¹) hc
      simpa [mul_assoc] using this
    refine (piG_comm_iff σ.r_mem_normalizer τ.r_mem_normalizer).mpr ?_
    have : σ.r * τ.r * σ.r⁻¹ * τ.r⁻¹ = 1 := by
      rw [hc']; group
    rw [this]
    exact one_mem _
  exact no_comm_triple_muDeltaCent hP hW hnc hab hac hbc cab cac hw hv hw4 hv4 hm₁ hm₂ hm₃
    (dist ρ₁ ρ₂ J J' hK₁ hK₂ hne.symm) (dist ρ₁ ρ₃ J J₀ hK₁ hK₃ hJ₀J.2.1.symm)
    (dist ρ₂ ρ₃ J' J₀ hK₂ hK₃ hJ₀J'.symm)
    (comm ρ₁ ρ₂ T T' hR₁ hR₂ mTT') (comm ρ₁ ρ₃ T T₀ hR₁ hR₃ mTT₀) (comm ρ₂ ρ₃ T' T₀ hR₂ hR₃ mT'T₀)

end Generic

