theorem discUConnPerpYW_core (n : ℕ) :
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t₀ : Y)
    (K K' : Subgroup Y) (z u : Y) (J : Subgroup Y) (t : Y) (W : Subgroup Y),
    Setting n R S t₀ K K' z u J t W →
      TwinMu.ThompsonWitness (CoreAssembly.conjClass (tightCore R)) K K' z u J →
        dComp (CoreAssembly.conjClass (tightCore R)) K ≠
            dstarComp (CoreAssembly.conjClass (tightCore R)) K →
              ∀ J' : Subgroup Y, J' ∈ twinSet (CoreAssembly.conjClass (tightCore R)) J → J' ≠ J →
                J' ∈ tqMembers3 (CoreAssembly.conjClass (tightCore R)) u →
                  (∀ J₀ ∈ tqMembers3 (CoreAssembly.conjClass (tightCore R)) u,
                      J₀ ∈ KPerp (CoreAssembly.conjClass (tightCore R)) J → J₀ = J ∨ J₀ = J') ∧
                    (∀ J₀ ∈ tqMembers3 (CoreAssembly.conjClass (tightCore R)) u,
                      J₀ ∈ KPerp (CoreAssembly.conjClass (tightCore R)) J' → J₀ = J' ∨ J₀ = J) := by
  intro Y _ _ R S t₀ K K' z u J t W s hwit hne J' hJ'tw hJ'ne hJ'tq
  set Ω := CoreAssembly.conjClass (tightCore R) with hΩdef
  have hP : Q3CL.PartIHypG Ω := TwinPerp.partIHypG s.core
  have hΩ : HypOmegaGen Ω := s.core.hyp
  have hf := s.data.frame
  obtain ⟨h2, hq, -⟩ := setup_members s
  have htr : ∀ M ∈ Ω, ∀ N ∈ Ω, ∃ g : Y, conjSub g M = N := TwinFrame.trans_conjClass _
  have hJtq : J ∈ tqMembers3 Ω u := mem_tqMembers_u_J hΩ htr h2 s.data
  have hu2 : IsPGroup 2 (Subgroup.zpowers u) :=
    CFSG.ClassicalInvolution.Asc77.ExactLayer.isPGroup_zpowers_of_sq_eq_one hf.hu2
  have hK : K ∈ Ω := hf.mem
  have hK'Ω : K' ∈ Ω := hf.hK'.1
  have hzK' : IsUniqueInvolution K' z := isUniqueInvolution_of_mem_twinSet hf.hz hf.hK'
  unfold TwinMu.ThompsonWitness at hwit
  obtain ⟨W', hW', ρa, ρb, ρc, w, v, hKa, hKb, hKc, hw, hv, hw2, hv2, huv⟩ := hwit
  have ctx := Q3CL.T8.ctxOf hP hW'
  have hnc : ¬ DbarConnected Ω W' := Q3T6.Mu.thompsonGraphAll hP hK hne hW'
  have n12 : K' ∈ omegaNbr Ω K :=
    Q3.Q3CL.T3.twin_mem_omegaNbr hP.hyp hK hK'Ω hf.hne hf.hz hzK'
  have n13 : J ∈ omegaNbr Ω K := hf.hJ.2 K (mem_twinSet_self hK hf.hz)
  have h12 : ρb.K ∈ omegaNbr Ω ρa.K := by rw [hKa, hKb]; exact n12
  have h13 : ρc.K ∈ omegaNbr Ω ρa.K := by rw [hKa, hKc]; exact n13
  have cab : muTabElt ρa * muTabElt ρb = muTabElt ρb * muTabElt ρa :=
    Subtype.ext (Q3T6.Mu.ctx_comm_of_omega ctx ρa ρb h12)
  have cac : muTabElt ρa * muTabElt ρc = muTabElt ρc * muTabElt ρa :=
    Subtype.ext (Q3T6.Mu.ctx_comm_of_omega ctx ρa ρc h13)
  have hab : muTabElt ρa ≠ muTabElt ρb := fun h => h12.2.1 (by
    have := ctx.K_eq_of_img_eq ρa ρb (congrArg Subtype.val h)
    exact this.symm)
  have hac : muTabElt ρa ≠ muTabElt ρc := fun h => h13.2.1 (by
    have := ctx.K_eq_of_img_eq ρa ρc (congrArg Subtype.val h)
    exact this.symm)
  have n23 : J ∈ omegaNbr Ω K' := hf.hJ.2 K' hf.hK'
  have h23 : ρc.K ∈ omegaNbr Ω ρb.K := by rw [hKb, hKc]; exact n23
  have hbc : muTabElt ρb ≠ muTabElt ρc := fun h => h23.2.1 (by
    have := ctx.K_eq_of_img_eq ρb ρc (congrArg Subtype.val h)
    exact this.symm)
  have hza : IsUniqueInvolution ρa.K z := by rw [hKa]; exact hf.hz
  have hwa : w ∈ ρa.K ⊓ W' := by rw [hKa]; exact hw
  have hvb : v ∈ ρb.K ⊓ W' := by rw [hKb]; exact hv
  have hw4 : orderOf w = 4 := TwinMu.orderOf_four_of_sq hw2 hza.sq hza.ne_one
  have hv4 : orderOf v = 4 := TwinMu.orderOf_four_of_sq hv2 hza.sq hza.ne_one
  have hwR : w ∈ ρa.R ⊓ W' := by
    rw [(Q3CL.Thompson.inf_W_of_mem_D hΩ hW' ρa.hR ρa.hK ρa.hRK).1]; exact hwa
  have hvR : v ∈ ρb.R ⊓ W' := by
    rw [(Q3CL.Thompson.inf_W_of_mem_D hΩ hW' ρb.hR ρb.hK ρb.hRK).1]; exact hvb
  subst huv
  have hJΩ : J ∈ Ω := hJtq.1
  have one : ∀ J₀ ∈ tqMembers3 Ω (w * v), J₀ ∈ KPerp Ω J → J₀ = J ∨ J₀ = J' := by
    intro J₀ hJ₀ hJ₀p
    rcases hJ₀p with h | h
    · exact Or.inl h
    · by_cases hc : J₀ = J'
      · exact Or.inr hc
      · exact (twin_count_core hP hq hW' hnc hab hac hbc cab cac hwR hvR hw4 hv4 hu2 hJtq hJ'tq hJ₀
          hf.ht hJ'tw hJ'ne h hc).elim
  refine ⟨one, fun J₀ hJ₀ hJ₀p => ?_⟩
  rw [← A7Q.Gen.kPerp_eq_of_twin hΩ hJΩ hJ'tw] at hJ₀p
  exact (one J₀ hJ₀ hJ₀p).symm

theorem discUConnSecNbrW (n : ℕ) :
  ∀ (Y : Type) [Group Y] [Finite Y] (R : Subgroup Y) (S : Sylow 2 R) (t₀ : Y)
    (K K' : Subgroup Y) (z u : Y) (J : Subgroup Y) (t : Y) (W : Subgroup Y),
    Setting n R S t₀ K K' z u J t W →
      TwinMu.ThompsonWitness (CoreAssembly.conjClass (tightCore R)) K K' z u J →
      dComp (CoreAssembly.conjClass (tightCore R)) K ≠
          dstarComp (CoreAssembly.conjClass (tightCore R)) K →
        ∀ J' : Subgroup Y, J' ∈ twinSet (CoreAssembly.conjClass (tightCore R)) J → J' ≠ J →
          J' ∈ tqMembers3 (CoreAssembly.conjClass (tightCore R)) u →
            (∀ M ∈ omegaNbr (TwinDisc.secFam (CoreAssembly.conjClass (tightCore R)) u)
                (TwinDisc.secImg (CoreAssembly.conjClass (tightCore R)) u J),
              M = TwinDisc.secImg (CoreAssembly.conjClass (tightCore R)) u J') ∧
            (∀ M ∈ omegaNbr (TwinDisc.secFam (CoreAssembly.conjClass (tightCore R)) u)
                (TwinDisc.secImg (CoreAssembly.conjClass (tightCore R)) u J'),
              M = TwinDisc.secImg (CoreAssembly.conjClass (tightCore R)) u J) := by
  intro Y _ _ R S t₀ K K' z u J t W s hwit hne J' hJ'tw hJ'ne hJ'tq
  set Ω := CoreAssembly.conjClass (tightCore R) with hΩdef
  have hf := s.data.frame
  have hΩ : HypOmegaGen Ω := s.core.hyp
  obtain ⟨h2, -, -⟩ := setup_members s
  have hc2 : IsPGroup 2 (Subgroup.zpowers u) :=
    CFSG.ClassicalInvolution.Asc77.ExactLayer.isPGroup_zpowers_of_sq_eq_one hf.hu2
  have htr : ∀ M ∈ Ω, ∀ N ∈ Ω, ∃ g : Y, conjSub g M = N := TwinFrame.trans_conjClass _
  have hJtq : J ∈ tqMembers3 Ω u := mem_tqMembers_u_J hΩ htr h2 s.data
  obtain ⟨hperp, hperp'⟩ := discUConnPerpYW_core n Y R S t₀ K K' z u J t W s hwit hne J' hJ'tw hJ'ne hJ'tq
  refine ⟨fun M hM => ?_, fun M hM => ?_⟩
  · obtain ⟨J₀, hJ₀, rfl⟩ := exists_of_mem_secFam hM.1
    exact TwinLayerGen.secNbr_eq_of_perp hΩ hc2 hJtq hJ₀ hperp hM
  · obtain ⟨J₀, hJ₀, rfl⟩ := exists_of_mem_secFam hM.1
    exact TwinLayerGen.secNbr_eq_of_perp hΩ hc2 hJ'tq hJ₀ hperp' hM

