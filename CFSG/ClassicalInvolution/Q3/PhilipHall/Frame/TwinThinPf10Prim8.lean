variable {n : ℕ}

@[expose] def okRep (n : ℕ) (r k : ℕ) (st : List (Step n)) : Bool :=
  match (sets n)[0]?, (sets n)[r]? with
  | some a, some b =>
    decide ((a ∩ b).card = k) &&
      (match runChain [a, b] st with
        | some T => (sets n).all fun s => decide (s ∈ T)
        | none => false)
  | _, _ => false

theorem prim0_rep {r k : ℕ} {st : List (Step n)} (hck : okRep n r k st = true)
    (hcomp : ∀ γ : Finset (Fin n), γ.card = 4 → γ ∈ sets n)
    {X : Set (Finset (Fin n))} (hXc : ∀ x ∈ X, x.card = 4) {a0 : Finset (Fin n)}
    (ha0 : (sets n)[0]? = some a0) (hα : a0 ∈ X) {β : Finset (Fin n)} (hβ : β ∈ X)
    (hβk : (a0 ∩ β).card = k)
    (rule : ∀ x ∈ X, ∀ y ∈ X, ∀ p : Equiv.Perm (Fin n), Equiv.Perm.sign p = 1 →
      x.map p.toEmbedding ∈ X → y.map p.toEmbedding ∈ X) :
    ∀ γ : Finset (Fin n), γ.card = 4 → γ ∈ X := by
  unfold okRep at hck
  rw [ha0] at hck
  cases hr : (sets n)[r]? with
  | none => rw [hr] at hck; simp at hck
  | some b =>
    rw [hr] at hck
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hck
    obtain ⟨hab, hrun⟩ := hck
    have hbc : b.card = 4 := by
      have hb : b ∈ sets n := List.mem_of_getElem? hr
      simp only [sets, List.mem_map, List.mem_sublistsLen] at hb
      obtain ⟨l, hl, rfl⟩ := hb
      rw [List.toFinset_card_of_nodup]
      · exact hl.2.symm ▸ rfl
      · exact (List.nodup_finRange n).sublist hl.1
    have hbX : b ∈ X :=
      closed_of_block hXc rule hα hβ a0 hα b hbc (hab.trans hβk.symm)
    cases hc : runChain [a0, b] st with
    | none => rw [hc] at hrun; simp at hrun
    | some T =>
      rw [hc] at hrun
      simp only [List.all_eq_true, decide_eq_true_eq] at hrun
      have hTX := runChain_sound rule st [a0, b] T (by
        intro s hs
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
        rcases hs with rfl | rfl
        · exact hα
        · exact hbX) hc
      intro γ hγ
      exact hTX γ (hrun γ (hcomp γ hγ))

