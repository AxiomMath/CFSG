@[expose] def pairOk (r : List ℕ) : Bool :=
  let a := r.getD 0 0
  let b := r.getD 1 0
  let x := IP.getD a (one 64 48)
  let y := IP.getD b (one 64 48)
  let xi := IiP.getD a (one 64 48)
  let yi := IiP.getD b (one 64 48)
  if r.getD 2 0 == 0 then comp 64 48 (comp 64 48 y x) yi != xi
  else if r.getD 2 0 == 1 then L0P.contains x && L0P.contains y
  else
    let c := evalW 64 48 base48 (r.drop 6)
    let ci := evalW 64 48 base48 (invW6 (r.drop 6))
    let x2 := comp 64 48 x x
    let x3 := comp 64 48 x2 x
    let Rl := [one 64 48, x, x2, x3, y, comp 64 48 y x, comp 64 48 y x2, comp 64 48 y x3]
    let g := if r.getD 3 0 == 0 then x else y
    let u := if r.getD 4 0 == 0 then x else y
    let g' := if r.getD 5 0 == 0 then x else y
    let cg := comp 64 48 c (comp 64 48 g ci)
    let cg' := comp 64 48 c (comp 64 48 g' ci)
    (r.drop 6).all (fun l => decide (l < 6)) && comp 64 48 (comp 64 48 y x) yi == xi &&
      !Rl.contains cg && comp 64 48 u cg' != comp 64 48 cg' u

theorem pairs_exh : pairRecs.map (fun r => (r.getD 0 0, r.getD 1 0)) =
    (List.range 48).flatMap fun a => (List.range 48).map fun b => (a, b) := by decide +kernel

theorem pairs_true : pairRecs.all pairOk = true := by decide +kernel

