variable {G : Type} [Group G] [Finite G]

theorem aviol_symm_of_hypOmegaGen {Ω : Set (Subgroup G)} (hΩ : HypOmegaGen Ω)
    {K J : Subgroup G} {zK zJ : G} (hK : K ∈ Ω) (h : AViol Ω K J zK zJ) :
    AViol Ω J K zJ zK where
  star := Q3T6.Mu.omegaStarNbr_symm hΩ hK h.mem h.star
  not_nbr := fun hn => h.not_nbr (Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ h.mem hK hn)
  hzK := h.hzJ
  hzJ := h.hzK
  no_conj := by
    intro g hg hcon
    have hg' : g ∈ pairNormalizers K J zK zJ := by
      unfold pairNormalizers at hg ⊢
      rw [Set.pair_comm, sup_comm]
      exact hg
    apply h.no_conj g⁻¹ ((pairNormalizers K J zK zJ).inv_mem hg')
    rw [← hcon, conjSub_inv_conjSub]

theorem omegaOfSet_subset_of_normalizes {Ω : Set (Subgroup G)} (hΩ : HypOmegaGen Ω)
    (hN : ∀ K ∈ Ω, ∀ L ∈ omegaNbr Ω K, L ∉ twinSet Ω K → K ≤ Subgroup.normalizer (L : Set G))
    {M J : Subgroup G} {zM zJ : G} (hM : M ∈ Ω) (hv : AViol Ω M J zM zJ) :
    omegaOfSet Ω (twinSet Ω M) ⊆ omegaOfSet Ω (twinSet Ω J) := by
  intro L hLset
  obtain ⟨v, Ms, hVU, hVJ, -, hMsM, htw, hvv⟩ :=
    exists_hexagon_data3 hΩ hM hv.mem hv.hzK hv.hzJ hv.star hv.not_nbr hv.no_conj
  have hMT : M ∈ twinSet Ω M := ⟨hM, zM, hv.hzK, hv.hzK⟩
  have hMsT : Ms ∈ twinSet Ω M := by rw [htw]; exact Or.inr rfl
  have hzJM : zJ ∈ M ⊔ Ms := mem_sup_of_hexagon3 hΩ hv.hzJ hVU hVJ hvv
  have hLΩ : L ∈ Ω := hLset.1
  have hLM : L ∈ omegaNbr Ω M := hLset.2 M hMT
  have hLtwM : L ∉ twinSet Ω M := fun h => (hLset.2 L h).2.1 rfl
  have hnorm : ∀ N ∈ twinSet Ω M, N ≤ trivialOnQuot L := by
    intro N hN'
    have hNΩ : N ∈ Ω := hN'.1
    have hLN : L ∈ omegaNbr Ω N := hLset.2 N hN'
    have hLtwN : L ∉ twinSet Ω N := by
      rw [NDB.NDBG.twinSet_eq_of_mem hN']
      exact hLtwM
    have hNL : N ∈ omegaNbr Ω L := Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ hNΩ hLΩ hLN
    have hNtwL : N ∉ twinSet Ω L := by
      rintro ⟨-, z', hLz', hNz'⟩
      exact hLtwN ⟨hLΩ, z', hNz', hLz'⟩
    exact le_trivialOnQuot_of_mutual_normalizer hΩ hNΩ hLΩ hLN.2.1.symm
      (hN N hNΩ L hLN hLtwN) (hN L hLΩ N hNL hNtwL)
  have hzJq : zJ ∈ trivialOnQuot L := sup_le (hnorm M hMT) (hnorm Ms hMsT) hzJM
  have hzJ2 : IsPGroup 2 (Subgroup.zpowers zJ) :=
    CFSG.ClassicalInvolution.Asc77.ExactLayer.isPGroup_zpowers_of_sq_eq_one hv.hzJ.sq
  obtain ⟨T, hTs, hTC⟩ := TwinADescent.exists_sylow_centralizer_of_tq hzJ2 hzJq
  have hTset : T ∈ RSet Ω := mem_RSet_of_isSylow2In hLΩ hTs
  have h8 : 8 ≤ Nat.card T := Sec6Gen.eight_le_of_mem_RSet hΩ hTset
  refine ⟨hLΩ, fun J' hJ' => ?_⟩
  have hzJ' : IsUniqueInvolution J' zJ := isUniqueInvolution_of_mem_twinSet hv.hzJ hJ'
  have hLJ' : L ≠ J' := by
    rintro rfl
    have h1 : M ∈ omegaNbr Ω L := Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ hM hLΩ hLM
    have hKP := (Q3T7M.l6_3 G Ω hΩ J hv.mem L hJ').1
    have h2 : M ∈ KPerp Ω J := by
      rw [hKP]
      exact Or.inr h1
    rcases h2 with h | h
    · exact hv.star.2.1 h.symm
    · exact hv.not_nbr (Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hΩ hv.mem hM h)
  exact ⟨hLΩ, hLJ', T, hTset, hTs.1,
    Sec6Gen.le_normalizer_of_le_centralizer hΩ hJ'.1 hLΩ (Ne.symm hLJ') hzJ' hTs.1 hTs.2.1
      (by omega) hTC⟩

end Transfer

theorem omegaNbr_twin_of_transfer {G : Type} [Group G] [Finite G] {K J : Subgroup G}
    {z t a g : G} (h : FrameIIHyp K J z t a g)
    (h95 : ∀ M ∈ CoreAssembly.conjClass K, ∀ (J' : Subgroup G) (zM zJ : G),
      AViol (CoreAssembly.conjClass K) M J' zM zJ →
        omegaOfSet (CoreAssembly.conjClass K) (twinSet (CoreAssembly.conjClass K) M) ⊆
          omegaOfSet (CoreAssembly.conjClass K) (twinSet (CoreAssembly.conjClass K) J')) :
    ∀ L ∈ omegaNbr (CoreAssembly.conjClass K) K, L ∈ twinSet (CoreAssembly.conjClass K) K := by
  intro L hL
  by_contra hLtw
  have hΩ : HypOmegaGen (CoreAssembly.conjClass K) := h.hyp
  have hK : K ∈ CoreAssembly.conjClass K := CoreAssembly.mem_conjClass_self K
  have hLΩ : L ∈ CoreAssembly.conjClass K := hL.1
  have hLset : L ∈ omegaOfSet (CoreAssembly.conjClass K)
      (twinSet (CoreAssembly.conjClass K) K) := by
    refine ⟨hLΩ, fun M hM => ?_⟩
    have hKP := (Q3T7M.l6_3 G _ hΩ K hK M hM).1
    have hmem : L ∈ KPerp (CoreAssembly.conjClass K) K := Set.mem_insert_of_mem _ hL
    rw [hKP] at hmem
    rcases Set.mem_insert_iff.mp hmem with h1 | h1
    · exact absurd (h1 ▸ hM) hLtw
    · exact h1
  have key : ∀ B, Relation.ReflTransGen (aGraphAdj (CoreAssembly.conjClass K)) K B →
      omegaOfSet (CoreAssembly.conjClass K) (twinSet (CoreAssembly.conjClass K) K) ⊆
        omegaOfSet (CoreAssembly.conjClass K) (twinSet (CoreAssembly.conjClass K) B) := by
    intro B hB
    induction hB with
    | refl => exact fun _ h => h
    | @tail B C hB hBC ih =>
      have hBΩ : B ∈ CoreAssembly.conjClass K := T3Core.mem_of_mem_aStar hK hB
      obtain ⟨hCΩ, h' | h' | ⟨ht, -⟩⟩ := hBC
      · obtain ⟨zB, zC, hv⟩ := h'
        exact ih.trans (h95 B hBΩ C zB zC hv)
      · obtain ⟨zC, zB, hv⟩ := h'
        exact ih.trans (h95 B hBΩ C zB zC (aviol_symm_of_hypOmegaGen hΩ hCΩ hv))
      · rw [NDB.NDBG.twinSet_eq_of_mem ht]
        exact ih
  have hLa : L ∈ aStar (CoreAssembly.conjClass K) K := by rw [h.star]; exact hLΩ
  have h2 := key L hLa hLset
  obtain ⟨l, hl⟩ := Sec6Gen.exists_uniqueInvolution hΩ hLΩ
  exact (h2.2 L ⟨hLΩ, l, hl, hl⟩).2.1 rfl

