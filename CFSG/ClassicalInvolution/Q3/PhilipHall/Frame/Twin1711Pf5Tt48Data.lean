@[expose] def witVal (k : ℕ) (wd : List (List ℕ × Bool) × ℕ) : ℕ :=
  comp 64 48 (wd.1.foldl (fun z f => comp 64 48 z
      (if f.2 then comp 64 48 (evalW 64 48 base48 f.1)
          (comp 64 48 (repP.getD k (one 64 48)) (evalW 64 48 base48 (invW6 f.1)))
        else comp 64 48 (evalW 64 48 base48 f.1)
          (comp 64 48 (repIP.getD k (one 64 48)) (evalW 64 48 base48 (invW6 f.1)))))
    (one 64 48)) (L0P.getD wd.2 (one 64 48))

@[expose] def witChk1 : Bool :=
  (List.range 51).all fun k =>
    S1f.getD k 0 == 1 || BadP1.contains (witVal k (W1d.getD k ([], 0)))

@[expose] def witChk2 : Bool :=
  (List.range 51).all fun k =>
    S2f.getD k 0 == 1 || BadP2.contains (witVal k (W2d.getD k ([], 0)))

@[expose] def tP : ℕ := SP48.getD 0 (one 64 48)

@[expose] def tzP : ℕ := SP48.getD 10 (one 64 48)

@[expose] def badNeChk : Bool :=
  BadP1.all (fun b => b != tP) && BadP2.all (fun b => b != tP && b != tzP)

theorem witChk1_true : witChk1 = true := by decide +kernel

theorem witChk2_true : witChk2 = true := by decide +kernel

theorem badNeChk_true : badNeChk = true := by decide +kernel

