theorem e29Certs_ok : ∀ c ∈ e29Certs, CertData.check affinePlanes c = true := by decide +kernel

theorem e29Certs_cover : ∀ α ∈ affinePlanes, ∀ β ∈ affinePlanes,
    ∃ c ∈ e29Certs, c.1.toFinset = α ∧ c.2.1.toFinset = β := by decide +kernel

theorem oddClosure_e29 : OddClosure e29Sub e29Sets := by
  intro α hα h4 β hβ h4'
  obtain ⟨c, hc, h1, h2⟩ := e29Certs_cover α hα β hβ
  have := CertData.ok_of_check (e29Certs_ok c hc)
  unfold CertData.ok at this
  rw [h1, h2] at this
  exact cert_mem (F := affinePlanes) h4 h4' this

