theorem e64Certs_ok : ∀ c ∈ e64Certs, CertData.check fanoLines c = true := by decide +kernel

theorem e64Certs_cover : ∀ ℓ ∈ fanoLines, ∀ ℓ' ∈ fanoLines,
    ∃ c ∈ e64Certs, c.1.toFinset = ℓᶜ ∧ c.2.1.toFinset = ℓ'ᶜ := by decide +kernel

theorem oddClosure_e64 : OddClosure e64Sub e64Sets := by
  rintro α ⟨ℓ, hℓ, rfl⟩ h4 β ⟨ℓ', hℓ', rfl⟩ h4'
  obtain ⟨c, hc, h1, h2⟩ := e64Certs_cover ℓ hℓ ℓ' hℓ'
  have := CertData.ok_of_check (e64Certs_ok c hc)
  unfold CertData.ok at this
  rw [h1, h2] at this
  exact cert_mem (F := fanoLines) h4 h4' this

