@[expose] def invL2 (l : ℕ) : ℕ :=
  ([3, 4, 5, 0, 1, 2, 9, 10, 11, 6, 7, 8, 12, 14, 13, 16, 15, 18, 17, 20, 19, 22, 21, 24, 23, 26, 25,
    28, 27] : List ℕ).getD l l

@[expose] def invChk2 : Bool :=
  (List.range 29).all fun l => comp 256 240 (GL2.getD l (one 256 240)) (GL2.getD (invL2 l) (one 256 240)) ==
    one 256 240

@[expose] def sqChk : Bool :=
  comp 256 240 (GL2.getD 8 (one 256 240)) (GL2.getD 8 (one 256 240)) == zp &&
    comp 256 240 (GL2.getD 17 (one 256 240)) (GL2.getD 17 (one 256 240)) == zp

@[expose] def conjChk2 : Bool :=
  comp 256 240 (comp 256 240 (GL2.getD 25 (one 256 240)) (GL2.getD 15 (one 256 240)))
      (GL2.getD 26 (one 256 240)) == GL2.getD 19 (one 256 240) &&
    comp 256 240 (comp 256 240 (GL2.getD 27 (one 256 240)) (GL2.getD 19 (one 256 240)))
      (GL2.getD 28 (one 256 240)) == comp 256 240 (GL2.getD 19 (one 256 240)) zp

@[expose] def expandW : List ℤ → List (Fin 3 × Bool)
  | [] => []
  | c :: cs =>
    (if c = 1 then [((2 : Fin 3), true)]
      else if c = 2 then wordSB
      else if c = -1 then [((2 : Fin 3), false)]
      else if c = -2 then FreeGroup.invRev wordSB else []) ++ expandW cs

theorem invChk2_true : invChk2 = true := by decide +kernel

theorem sqChk_true : sqChk = true := by decide +kernel

theorem conjChk2_true : conjChk2 = true := by decide +kernel

theorem ell2_words : letterWords2.getD 15 [] =
    toLetters (expandW [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2]) := by decide +kernel

theorem ell3_words : letterWords2.getD 17 [] = toLetters (expandW [1, 2, 1, -2]) := by decide +kernel

