section E29

theorem ind_add_eq_zero_iff {n : ℕ} (δ γ : Finset (Fin n)) (i : Fin n) :
    ind δ i + ind γ i = 0 ↔ (i ∈ δ ↔ i ∈ γ) := by
  unfold ind
  by_cases h1 : i ∈ δ <;> by_cases h2 : i ∈ γ <;> simp [h1, h2] <;> decide

theorem ind_add_eq_one_iff {n : ℕ} (δ γ : Finset (Fin n)) (i : Fin n) :
    ind δ i + ind γ i = 1 ↔ (i ∈ δ ↔ i ∉ γ) := by
  unfold ind
  by_cases h1 : i ∈ δ <;> by_cases h2 : i ∈ γ <;> simp [h1, h2] <;> decide

open CFSG.ClassicalInvolution.Q3.AE in
theorem zBar_eq_eight {δ γ : Finset (Fin 8)} (hδ : δ.card = 4) (hγ : γ.card = 4)
    (h : AE.zBar δ hδ = AE.zBar γ hγ) : δ = γ ∨ δ = γᶜ := by
  unfold AE.zBar at h
  have h1 := (AE.mkQ_eq_iff).mp h
  have hv : ∀ i, ((zOf (emb δ hδ))⁻¹ * zOf (emb γ hγ)).vec i = ind δ i + ind γ i := by
    intro i
    have e : (zOf (emb δ hδ)).perm = 1 := zOf_perm _
    have e' : ((zOf (emb δ hδ))⁻¹).perm = 1 := by rw [AE.Wr.inv_perm, e, inv_one]
    rw [AE.Wr.mul_vec, AE.Wr.inv_vec, e', e]
    have p1 : (1 : Equiv.Perm (Fin 8)) i = i := rfl
    have p2 : (1 : Equiv.Perm (Fin 8)).symm i = i := rfl
    rw [p1, p2, zOf_vec_apply, zOf_vec_apply]
    have r1 : i ∈ Set.range (emb δ hδ) ↔ i ∈ δ := by rw [range_emb]; exact Finset.mem_coe
    have r2 : i ∈ Set.range (emb γ hγ) ↔ i ∈ γ := by rw [range_emb]; exact Finset.mem_coe
    simp only [r1, r2, ind]
  rcases h1 with h1 | h1
  · left
    ext i
    have := congrArg (fun a : AE.Wr 8 => a.vec i) h1
    simp only [hv, AE.Wr.one_vec] at this
    exact (ind_add_eq_zero_iff δ γ i).mp this
  · right
    ext i
    have := congrArg (fun a : AE.Wr 8 => a.vec i) h1
    simp only [hv] at this
    have h2 : ind δ i + ind γ i = 1 := this
    rw [Finset.mem_compl]
    exact (ind_add_eq_one_iff δ γ i).mp h2

@[expose] def aglT : List (Equiv.Perm (Fin 8)) :=
  [1,
    Equiv.swap 0 1 * Equiv.swap 2 3 * Equiv.swap 4 5 * Equiv.swap 6 7,
    Equiv.swap 1 2 * Equiv.swap 5 6,
    Equiv.swap 0 2 * Equiv.swap 2 3 * Equiv.swap 3 1 * Equiv.swap 4 6 * Equiv.swap 6 7 * Equiv.swap 7 5,
    Equiv.swap 2 3 * Equiv.swap 6 7,
    Equiv.swap 0 1 * Equiv.swap 4 5,
    Equiv.swap 1 4 * Equiv.swap 4 2 * Equiv.swap 3 5 * Equiv.swap 5 6,
    Equiv.swap 0 4 * Equiv.swap 4 6 * Equiv.swap 6 7 * Equiv.swap 7 3 * Equiv.swap 3 1 * Equiv.swap 2 5,
    Equiv.swap 4 5 * Equiv.swap 6 7,
    Equiv.swap 0 1 * Equiv.swap 2 3,
    Equiv.swap 1 2 * Equiv.swap 4 6 * Equiv.swap 6 7 * Equiv.swap 7 5,
    Equiv.swap 0 2 * Equiv.swap 2 3 * Equiv.swap 3 1 * Equiv.swap 5 6,
    Equiv.swap 2 3 * Equiv.swap 4 5,
    Equiv.swap 0 1 * Equiv.swap 6 7]

theorem aglT_trans : ∀ γ ∈ AE.affinePlanes, ∃ σ ∈ aglT,
    γ = ({0, 2, 4, 6} : Finset (Fin 8)).map σ.toEmbedding := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
set_option maxRecDepth 100000 in
theorem aglT_stab : ∀ σ ∈ aglT, ∀ s ∈ AE.affinePlanes,
    s.map σ.toEmbedding ∈ AE.affinePlanes ∧ s.map σ⁻¹.toEmbedding ∈ AE.affinePlanes := by
  decide +kernel

theorem aglT_sign : ∀ σ ∈ aglT, Equiv.Perm.sign σ = 1 := by
  intro σ hσ
  simp only [aglT, List.mem_cons, List.not_mem_nil, or_false] at hσ
  rcases hσ with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [Equiv.Perm.sign_mul, Equiv.Perm.sign_swap']

open scoped CFSG.Decide.Bounded in
theorem e29_core : ∀ α ∈ AE.affinePlanes, ∀ β ∈ AE.affinePlanes, ∃ γ ∈ AE.affinePlanes,
    ∀ δ ∈ AE.affinePlanes, (δ = γ ∨ δ = γᶜ) → ∃ c : ZMod 2, ∀ i ∈ δ, ind α i + ind β i = c := by
  decide +kernel

theorem card_affinePlane : ∀ γ ∈ AE.affinePlanes, γ.card = 4 := by decide +kernel

theorem affinePlanes_compl : ∀ γ ∈ AE.affinePlanes, γᶜ ∈ AE.affinePlanes := by decide +kernel

theorem e29_comb : ∀ α ∈ AE.e29Sets, ∀ β ∈ AE.e29Sets, ∃ γ ∈ AE.e29Sets, ∃ (hγ : γ.card = 4),
    (∀ δ ∈ AE.e29Sets, ∀ hδ : δ.card = 4, AE.zBar δ hδ = AE.zBar γ hγ →
      ∃ c : ZMod 2, ∀ i ∈ δ, ind α i + ind β i = c) ∧
    ∃ σ : Equiv.Perm (Fin 8), (σ ∈ AE.agl32 ∧ Equiv.Perm.sign σ = 1) ∧
      ∀ y, y ∈ γ ↔ σ.symm y ∈ α := by
  intro α hα β hβ
  obtain ⟨γ, hγ, hcγ⟩ := e29_core α hα β hβ
  refine ⟨γ, hγ, card_affinePlane γ hγ, fun δ hδ hδc he => ?_, ?_⟩
  · exact hcγ δ hδ (zBar_eq_eight hδc (card_affinePlane γ hγ) he)
  · obtain ⟨σa, hσa, hαeq⟩ := aglT_trans α hα
    obtain ⟨σg, hσg, hγeq⟩ := aglT_trans γ hγ
    refine ⟨σg * σa⁻¹, ⟨?_, ?_⟩, ?_⟩
    · exact AE.agl32.mul_mem (fun s hs => aglT_stab σg hσg s hs)
        (AE.agl32.inv_mem (fun s hs => aglT_stab σa hσa s hs))
    · rw [map_mul, map_inv, aglT_sign σg hσg, aglT_sign σa hσa]; rfl
    · intro y
      have key : σa.symm ((σg * σa⁻¹).symm y) = σg.symm y := by
        rw [Equiv.symm_apply_eq, Equiv.symm_apply_eq]
        simp
      rw [hαeq, hγeq]
      simp only [Finset.mem_map_equiv, key]
end E29

section E29Main


open AeM CFSG.ClassicalInvolution.Q3.AE in
theorem e189_e29_alt2 {Y : Type} [Group Y] [Finite Y] {Δ : Set (Subgroup Y)}
    (F : TwinDisc.ExitO2.Q8Fam Y Δ) (I : AEIdentOn Δ 8 AE.e29Sets AE.e29Sub)
    {K J : Subgroup Y} (hK : K ∈ Δ) (hJ : J ∈ Δ) {z t : Y} (hz : IsUniqueInvolution K z)
    (ht : IsUniqueInvolution J t) (hzt : z * t = t * z) (hne : conjSub t K ≠ K) :
    ∃ x : Y, ∃ M' ∈ twinSet Δ (conjSub x K), M' ≠ conjSub x K ∧ ∃ R₁ R₂ : Subgroup Y,
      IsSylow2In R₁ (conjSub x K) ∧ IsSylow2In R₂ M' ∧ Commutes R₁ R₂ ∧
        ∀ w ∈ R₁ ⊔ R₂, w * (z * t) = (z * t) * w := by
  refine e189_aeOn_alt2 F (by norm_num) I
    (fun σ => σ ∈ AE.agl32 ∧ Equiv.Perm.sign σ = 1) ?_ e29_comb hK hJ hz ht hzt hne
  rintro σ ⟨hl, hs⟩
  exact Subgroup.mem_map_of_mem _ ⟨ofPerm_mem_aeSub hs, hl⟩

end E29Main

