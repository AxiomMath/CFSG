variable {n : ℕ} {Y : Type} [Group Y] [Finite Y] {R : Subgroup Y} {S : Sylow 2 R} {t₀ : Y}
  {K K' : Subgroup Y} {z u : Y} {J : Subgroup Y} {t : Y} {W : Subgroup Y}

theorem conjSub_mem_dComp_of_comm {G : Type} [Group G] [Finite G] {Ω : Set (Subgroup G)}
    (hΩ : HypOmegaGen Ω) {A : Subgroup G} (hA : A ∈ Ω) {a : G} (ha : IsUniqueInvolution A a)
    {g : G} (hg : g * a = a * g) {M : Subgroup G} (hM : M ∈ dComp Ω A) :
    conjSub g M ∈ dComp Ω A := by
  have hAg : conjSub g A ∈ dComp Ω A := by
    by_cases hgA : conjSub g A = A
    · rw [hgA]
      exact Relation.ReflTransGen.refl
    · have hga : g * a * g⁻¹ = a := by
        calc g * a * g⁻¹ = (a * g) * g⁻¹ := by rw [hg]
          _ = a := by group
      have hzg : IsUniqueInvolution (conjSub g A) a := by
        have := ha.conj g
        rwa [hga] at this
      exact T7A.mem_dComp_of_mem_omegaNbr
        (Q3.Q3CL.T3.twin_mem_omegaNbr hΩ hA (hΩ.conjInvariant g A hA) hgA ha hzg)
  have h1 := T7A.dComp_conj hΩ.conjInvariant hM g
  rwa [T7A.dComp_eq_of_mem hA hAg] at h1

theorem conjSub_mem_dComp_of_centralizer_z (s : Setting n R S t₀ K K' z u J t W) {g : Y}
    (hg : g ∈ Subgroup.centralizer ({z} : Set Y)) {M : Subgroup Y}
    (hM : M ∈ dComp (CoreAssembly.conjClass (tightCore R)) K) :
    conjSub g M ∈ dComp (CoreAssembly.conjClass (tightCore R)) K :=
  conjSub_mem_dComp_of_comm s.core.hyp s.data.frame.mem s.data.frame.hz
    (Subgroup.mem_centralizer_singleton_iff.mp hg) hM

theorem mem_centralizer_z_of_oddCore_centralizer_u (s : Setting n R S t₀ K K' z u J t W)
    (hα : alphaOf (Subgroup.closure ({u, z} : Set Y)) = ⊥) {m : Y}
    (hm : m ∈ oddCoreOf (Subgroup.centralizer ({u} : Set Y))) :
    m ∈ Subgroup.centralizer ({z} : Set Y) :=
  Subgroup.mem_centralizer_singleton_iff.mpr
    (oddCore_comm_of_alpha hα (Subgroup.subset_closure (by simp)) s.data.frame.hu1
      (Subgroup.subset_closure (by simp)) hm)

theorem conjSub_mem_dComp_of_oddCore_centralizer_u (s : Setting n R S t₀ K K' z u J t W)
    (hα : alphaOf (Subgroup.closure ({u, z} : Set Y)) = ⊥) {m : Y}
    (hm : m ∈ oddCoreOf (Subgroup.centralizer ({u} : Set Y))) {M : Subgroup Y}
    (hM : M ∈ dComp (CoreAssembly.conjClass (tightCore R)) K) :
    conjSub m M ∈ dComp (CoreAssembly.conjClass (tightCore R)) K :=
  conjSub_mem_dComp_of_centralizer_z s (mem_centralizer_z_of_oddCore_centralizer_u s hα hm) hM

