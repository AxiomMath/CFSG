variable {n : ℕ} {Y : Type} [Group Y] [Finite Y] {R : Subgroup Y} {S : Sylow 2 R} {t : Y}
  {K' W : Subgroup Y} {u e g : Y}

theorem sup_le_sigmaStarNorm (hc : P23Cfg n Y R S t K' W u e g) :
    Subgroup.centralizer ({u * e} : Set Y) ⊔ Subgroup.centralizer ({t} : Set Y) ⊔
      oddCoreOf (Subgroup.centralizer ({u} : Set Y)) ≤ sigmaStarNorm (Om R) (tightCore R) :=
  sup_le (sup_le (centralizer_ue_le_sigmaStarNorm hc) (R56.centralizer_t_le_sigmaStarNorm hc))
    (oddCoreOf_centralizer_u_le_sigmaStarNorm hc)

theorem rLayer_le_sigmaStarNorm (hc : P23Cfg n Y R S t K' W u e g)
    (hgen : rLayer (Om R) u ≤ (rLayer (Om R) u ⊓ Subgroup.centralizer ({u * e} : Set Y)) ⊔
      (rLayer (Om R) u ⊓ Subgroup.centralizer ({t} : Set Y)) ⊔
      (rLayer (Om R) u ⊓ oddCoreOf (Subgroup.centralizer ({u} : Set Y)))) :
    rLayer (Om R) u ≤ sigmaStarNorm (Om R) (tightCore R) :=
  hgen.trans ((sup_le_sup (sup_le_sup inf_le_right inf_le_right) inf_le_right).trans
    (sup_le_sigmaStarNorm hc))

theorem mem_dstarComp_of_isUniqueInvolution_ue (hc : P23Cfg n Y R S t K' W u e g) {J : Subgroup Y}
    (hJ : J ∈ Om R) (hτ : IsUniqueInvolution J (u * e)) :
    J ∈ dstarComp (Om R) (tightCore R) := by
  have hC := CoreData.of_S hc.std.perp.core
  have hΩ : HypOmegaGen (Om R) := hC.hyp
  have hK : tightCore R ∈ Om R := CoreAssembly.mem_conjClass_self _
  have hz : IsUniqueInvolution (tightCore R) t := Inner.isUniqueInvolution_core hC.datum
  have hτK : IsUniqueInvolution (conjSub g (tightCore R)) (u * e) := by
    rw [← hc.data.hgt]
    exact hz.conj g
  have hL : J ∈ twinSet (Om R) (conjSub g (tightCore R)) := ⟨hJ, u * e, hτK, hτ⟩
  exact (conjSub_g_mem_dstarComp hc).trans
    (mem_dstarComp_of_twin_gen hΩ (hΩ.conjInvariant g _ hK) hL)

theorem mem_dstarComp_of_mem_tqMembers3 (hT : Thm4RTwinBelow 3 n) (hc : P23Cfg n Y R S t K' W u e g)
    (hY : rLayer (Om R) u ≤ sigmaStarNorm (Om R) (tightCore R)) :
    ∀ J ∈ tqMembers3 (Om R) u, J ∈ dstarComp (Om R) (tightCore R) := by
  classical
  have hd := hc.data
  have hC := CoreData.of_S hc.std.perp.core
  have hΩ : HypOmegaGen (Om R) := hC.hyp
  have hc2 : IsPGroup 2 (Subgroup.zpowers u) :=
    CFSG.ClassicalInvolution.Asc77.ExactLayer.isPGroup_zpowers_of_sq_eq_one hd.hu2
  obtain ⟨J₁, J₂, hJ₁, hJ₂, hτ₁, hτ₂, hdich⟩ := R56.u_trans_or_pair hT hc
  have hmem₁ := mem_dstarComp_of_isUniqueInvolution_ue hc hJ₁.1 hτ₁
  have hmem₂ := mem_dstarComp_of_isUniqueInvolution_ue hc hJ₂.1 hτ₂
  have key : ∀ J ∈ tqMembers3 (Om R) u, ∃ Jᵢ ∈ tqMembers3 (Om R) u,
      Jᵢ ∈ dstarComp (Om R) (tightCore R) ∧
        ∃ x : SecQ R u, conjSub x (TwinDisc.secImg (Om R) u Jᵢ) = TwinDisc.secImg (Om R) u J := by
    intro J hJ
    have hJs := TwinDisc.secImg_mem_secFam hJ
    rcases hdich with htr | hpair
    · exact ⟨J₁, hJ₁, hmem₁, htr _ (TwinDisc.secImg_mem_secFam hJ₁) _ hJs⟩
    · rcases hpair _ hJs with h | h
      · exact ⟨J₁, hJ₁, hmem₁, 1, by rw [conjSub_one, h]⟩
      · exact ⟨J₂, hJ₂, hmem₂, 1, by rw [conjSub_one, h]⟩
  intro J hJ
  obtain ⟨Jᵢ, hJᵢ, hmem, x, hx⟩ := key J hJ
  obtain ⟨c', hc'⟩ := TwinPerpV3.A6d.exists_conj_hull_of_secImg hΩ hc2 hJᵢ hJ ⟨x, hx⟩
  have hcY : (((c' : ↥(Subgroup.centralizer ({u} : Set Y))) : Y)) ∈ rLayer (Om R) u :=
    TwinDisc.coreHull_map_le_rLayer hΩ hc2 ⟨_, c'.2, rfl⟩
  rw [hc']
  exact (mem_sigmaStarNorm_iff.mp (hY hcY) Jᵢ).mp hmem

theorem p23E8ALay_of_gen (hT : Thm4RTwinBelow 3 n) (hG : P23E8LayerGen n) : P23E8ALay n := by
  intro hcit hP Y _ _ R S t K' W u e g hc hno hA5 hA6 _ b _ _ J hJ
  exact mem_dstarComp_of_mem_tqMembers3 hT hc
    (rLayer_le_sigmaStarNorm hc (hG hcit hP Y R S t K' W u e g hc hno hA5 hA6)) J hJ

