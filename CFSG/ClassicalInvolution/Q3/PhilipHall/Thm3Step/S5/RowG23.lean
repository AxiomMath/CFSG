  Certificates.certificate516003

theorem getD_mem_of_lt {es : Array (List ℕ)} {t : ℕ} (ht : t < es.size) : es.getD t [] ∈ es := by
  rw [Array.getD_eq_getD_getElem?, Array.getElem?_eq_getElem ht, Option.getD_some]
  exact Array.getElem_mem ht

theorem exists_getD_of_mem {es : Array (List ℕ)} {c : List ℕ} (hc : c ∈ es) :
    ∃ t < es.size, es.getD t [] = c := by
  obtain ⟨t, ht, rfl⟩ := Array.getElem_of_mem hc
  exact ⟨t, ht, by rw [Array.getD_eq_getD_getElem?, Array.getElem?_eq_getElem ht,
    Option.getD_some]⟩

theorem q8RelC_of_q8Rel {ci cj : List ℕ} (hcj : canon14 cj = true) {i j : GL14}
    (hi : (i : M14) = dec14 ci) (hj : (j : M14) = dec14 cj) (h : Q8Rel i j) :
    q8RelC ci cj = true := by
  have hi2 : ((i ^ 2 : GL14) : M14) = dec14 (sq14 ci) := coe_sq hi
  have hj2 : ((j ^ 2 : GL14) : M14) = dec14 (sq14 cj) := coe_sq hj
  simp only [q8RelC, Bool.and_eq_true, beq_iff_eq, bne_iff_ne, ne_eq]
  refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩
  · apply dec14_injective (canon14_mul14 _ _) canon14_one14
    rw [dec14_mul14, ← hi2, ← Units.val_mul, ← pow_add, h.1, Units.val_one, dec14_one14]
  · intro he
    apply h.2.1
    apply Units.ext
    rw [hi2, he, dec14_one14, Units.val_one]
  · apply dec14_injective (canon14_mul14 _ _) (canon14_mul14 _ _)
    change dec14 (sq14 ci) = dec14 (sq14 cj)
    rw [← hi2, ← hj2, h.2.2.1]
  · apply dec14_injective (canon14_mul14 _ _) hcj
    rw [dec14_mul14, dec14_mul14, ← hi, ← hj, ← Units.val_mul, ← Units.val_mul]
    congr 1
    calc i * j * i = j * (j⁻¹ * i * j) * i := by group
      _ = j * i⁻¹ * i := by rw [h.2.2.2]
      _ = j := by group

theorem threeCyc_of_threeCycC {ci cj yc : List ℕ} {i j y : GL14} (hi : (i : M14) = dec14 ci)
    (hj : (j : M14) = dec14 cj) (hy : (y : M14) = dec14 yc) (h : threeCycC yc ci cj = true) :
    y⁻¹ * i * y = j ∧ (y⁻¹ * j * y = i * j ∨ y⁻¹ * j * y = j * i) := by
  simp only [threeCycC, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at h
  obtain ⟨h1, h2⟩ := h
  have key : ∀ (a b : GL14) (ca cb : List ℕ), (a : M14) = dec14 ca → (b : M14) = dec14 cb →
      ∀ (c d : GL14) (cc cd : List ℕ), (c : M14) = dec14 cc → (d : M14) = dec14 cd →
      mul14 ca cb = mul14 cc cd → a * b = c * d := by
    intro a b ca cb ha hb c d cc cd hc hd he
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, ha, hb, hc, hd, ← dec14_mul14, ← dec14_mul14, he]
  have hconj : ∀ a b : GL14, a * y = y * b → y⁻¹ * a * y = b := fun a b hab => by
    rw [mul_assoc, hab]
    group
  refine ⟨hconj i j (key i y ci yc hi hy y j yc cj hy hj h1), ?_⟩
  rcases h2 with h2 | h2
  · exact Or.inl (hconj j (i * j) (key j y cj yc hj hy y (i * j) yc (mul14 ci cj) hy
      (by rw [Units.val_mul, hi, hj, dec14_mul14]) h2))
  · exact Or.inr (hconj j (j * i) (key j y cj yc hj hy y (j * i) yc (mul14 cj ci) hy
      (by rw [Units.val_mul, hi, hj, dec14_mul14]) h2))


theorem g23_threeCyc {i j : H3} (hi : i ∈ S2H) (hj : j ∈ S2H)
    (hij : Q8Rel i j) :
    ∃ y : H3, y⁻¹ * i * y = j ∧ (y⁻¹ * j * y = i * j ∨ y⁻¹ * j * y = j * i) := by
  obtain ⟨ki, hki, hci⟩ := exists_code_S2 (Subgroup.mem_subgroupOf.mp hi)
  obtain ⟨kj, hkj, hcj⟩ := exists_code_S2 (Subgroup.mem_subgroupOf.mp hj)
  have hcanon := certS.2.2.2
  have hq : Q8Rel (i : GL14) (j : GL14) :=
    hij.map R3.subtype fun h1 => hij.2.1 (Subtype.ext (by simpa using h1))
  have hqc := q8RelC_of_q8Rel (allCheck_spec hcanon hkj) hci.symm hcj.symm hq
  have h := g23RowsF4_holds
  simp only [g23RowsF4, Array.all_eq_true', Bool.or_eq_true, Bool.not_eq_true',
    Array.any_eq_true'] at h
  rcases h _ (getD_mem_of_lt hki) _ (getD_mem_of_lt hkj) with h1 | ⟨yc, hyc, hy⟩
  · rw [hqc] at h1
    exact absurd h1 (by decide)
  obtain ⟨t, ht, rfl⟩ := exists_getD_of_mem hyc
  have hmem : dec14 (elemsX.getD t []) ∈ (Units.coeHom M14) '' (X0 : Set GL14) := by
    rw [image_X0]
    exact ⟨t, ht, rfl⟩
  obtain ⟨y, hyX, hyc'⟩ := hmem
  have hyc'' : (y : M14) = dec14 (elemsX.getD t []) := hyc'
  have h3 := threeCyc_of_threeCycC hci.symm hcj.symm hyc'' hy
  refine ⟨⟨y, X0_le_R3 hyX⟩, Subtype.ext ?_, ?_⟩
  · simpa using h3.1
  · rcases h3.2 with h4 | h4
    · exact Or.inl (Subtype.ext (by simpa using h4))
    · exact Or.inr (Subtype.ext (by simpa using h4))


theorem g23_conj_mem_S2H (H : Subgroup H3) (hH : IsPGroup 2 H) :
    ∃ g : H3, ∀ x ∈ H, g⁻¹ * x * g ∈ S2H := by
  haveI : Finite H3 := Nat.finite_of_card_ne_zero (by rw [card_R3]; norm_num)
  refine exists_conj_mem_of_isPGroup (IsPGroup.of_card (n := 6) (by rw [card_S2H]; norm_num))
    ?_ hH
  have h := Subgroup.card_mul_index S2H
  rw [card_S2H, card_R3] at h
  have h1 : S2H.index = 66339 := by omega
  rw [h1]
  decide

section Row

variable {G : Type} [Group G] [Finite G] {Φ : Set (Subgroup G)} {K Q : Subgroup G}
  {X : Type} [Group X] {ρ : G →* X}

theorem S5Hyp.commutator_eq_top_of_g23 (h : S5Hyp Φ K Q)
    (hρ : Function.Surjective ρ) (hker : ρ.ker = Q) (θ : X ≃* H3) : commutator G = ⊤ :=
  h.commutator_eq_top fun _ hT => @S5Hyp.le_commutator_of_model G _ _ Φ K Q X _ ρ H3
    inferInstance h hρ hker θ S2H g23_conj_mem_S2H ⊤ inferInstance
    (fun _ hi _ hj _ _ hij => g23_threeCyc hi hj hij) _ hT fun _ _ => Subgroup.mem_top _

theorem eq_bot_of_g23_cover (hQc : Q ≤ Subgroup.center G) (hQ2 : IsPGroup 2 Q)
    (hperf : commutator G = ⊤) (π : G →* ↥(adjointGroup .G2 (ZMod 3)))
    (hπs : Function.Surjective π) (hπk : π.ker = Q) : Q = ⊥ := by
  haveI : Group.IsPerfect G := ⟨hperf⟩
  obtain ⟨c, hc3, hle⟩ := LieType.Steinberg.CentralExt.FieldThree.g2_three_ker_le_zpowers
    (K := ZMod 3) (by simp) hπs (by rw [hπk]; exact hQc)
  rw [eq_bot_iff]
  intro q hq
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hle (hπk ▸ hq))
  have h3 : (c ^ k) ^ 3 = 1 := by
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hc3, one_zpow]
  obtain ⟨n, hn⟩ := hQ2 ⟨c ^ k, hq⟩
  have h2 : (c ^ k) ^ 2 ^ n = 1 := by simpa using congrArg Subtype.val hn
  have hcop : Nat.Coprime (orderOf (c ^ k)) (2 ^ n) :=
    Nat.Coprime.coprime_dvd_left (orderOf_dvd_of_pow_eq_one h3)
      (Nat.Coprime.pow_right n (by norm_num))
  rw [Subgroup.mem_bot, ← orderOf_eq_one_iff]
  exact Nat.Coprime.eq_one_of_dvd hcop (orderOf_dvd_of_pow_eq_one h2)

theorem S5Hyp.false_of_rowG23 (h : S5Hyp Φ K Q)
    (hρ : Function.Surjective ρ) (hker : ρ.ker = Q) (hrow : LieModel X .G2 0 3 1) : False := by
  obtain ⟨θ₀⟩ := HardMathSupport.Timmesfeld.LieRank.nonempty_mulEquiv_adjointGroup_G2_of_lieModel
    hrow
  have hperf : commutator G = ⊤ := h.commutator_eq_top_of_g23 hρ hker (θ₀.trans adjointEquivR3)
  refine h.ne_bot (eq_bot_of_g23_cover h.le_center h.pgrp hperf (θ₀.toMonoidHom.comp ρ)
    (θ₀.surjective.comp hρ) ?_)
  rw [MonoidHom.ker_comp_of_injective _ _ θ₀.injective, hker]

