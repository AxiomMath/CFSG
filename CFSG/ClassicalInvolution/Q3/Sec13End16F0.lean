theorem mem_omegaNbr_of_map_comm (h : EndHyp Ω) {P : Set (Subgroup G)} (hP : P ⊆ Ω)
    (hinv : ∀ L ∈ P, ∀ x ∈ pSpan P, conjSub x L ∈ P) {Q : Type} [Group Q]
    (φ : ↥(pSpan P) →* Q)
    (hinj : ∀ L ∈ P, ∀ L' ∈ P,
      (L.subgroupOf (pSpan P)).map φ = (L'.subgroupOf (pSpan P)).map φ → L = L')
    {L M : Subgroup G} (hL : L ∈ P) (hM : M ∈ P) (hne : M ≠ L)
    (hc : ∀ x ∈ (M.subgroupOf (pSpan P)).map φ, ∀ y ∈ (L.subgroupOf (pSpan P)).map φ,
      x * y = y * x) :
    M ∈ omegaNbr Ω L := by
  have hN : M ≤ Subgroup.normalizer (L : Set G) := by
    intro x hx
    have hxX : x ∈ pSpan P := le_pSpan hM hx
    rw [mem_normalizer_iff_conjSub_eq]
    refine hinj _ (hinv L hL x hxX) L hL ?_
    have e1 : (conjSub x L).subgroupOf (pSpan P) =
        conjSub (⟨x, hxX⟩ : ↥(pSpan P)) (L.subgroupOf (pSpan P)) :=
      (conjSub_subgroupOf (pSpan P) ⟨x, hxX⟩ L).symm
    have hφx : φ ⟨x, hxX⟩ ∈ (M.subgroupOf (pSpan P)).map φ :=
      ⟨⟨x, hxX⟩, Subgroup.mem_subgroupOf.mpr hx, rfl⟩
    rw [e1, AscQuot.map_conjSub]
    exact conjSub_eq_self_of_commute fun y hy => hc _ hφx y hy
  exact ⟨hP hM, hne, M, TC.mem_RSet_of_isPGroup (hP hM) (h.thmD.two M (hP hM)), le_rfl, hN⟩

theorem centMembers_eq_pair_of_not_conj (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G}
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    (hR' : R' ∈ centMembers Ω a)
    (hcomm : ∀ L ∈ centMembers Ω a, ∀ L' ∈ centMembers Ω a,
      (¬ ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = L') → Commutes L L')
    (hnc : ∃ L ∈ centMembers Ω a, ∃ L' ∈ centMembers Ω a,
      ¬ ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = L') :
    centMembers Ω a = {R, R'} := by
  have hΩ : HypOmegaGen Ω := h.thmD.hyp
  have hsymm : ∀ L M : Subgroup G, (∃ x ∈ pSpan (centMembers Ω a), conjSub x L = M) →
      ∃ x ∈ pSpan (centMembers Ω a), conjSub x M = L := by
    rintro L M ⟨x, hx, rfl⟩
    exact ⟨x⁻¹, Subgroup.inv_mem _ hx, conjSub_inv_conjSub _ _⟩
  have htrans : ∀ L M N : Subgroup G, (∃ x ∈ pSpan (centMembers Ω a), conjSub x L = M) →
      (∃ x ∈ pSpan (centMembers Ω a), conjSub x M = N) →
      ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = N := by
    rintro L M N ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
    exact ⟨y * x, Subgroup.mul_mem _ hy hx, conjSub_mul y x L⟩
  have hrefl : ∀ L : Subgroup G, ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = L :=
    fun L => ⟨1, Subgroup.one_mem _, conjSub_one L⟩
  have hkey : ∀ M ∈ centMembers Ω a, IsUniqueInvolution M r → ∀ L ∈ centMembers Ω a,
      Commutes M L → L = R ∨ L = R' := by
    intro M hM hMr L hL hc
    obtain ⟨j, hj⟩ := Sec6Gen.exists_uniqueInvolution hΩ hL.1
    have hrj : r = j := h9 M hM.1 L hL.1 hc r j hMr hj
    have hLt : L ∈ twinSet Ω R := ⟨hL.1, r, s.isInv, hrj ▸ hj⟩
    rw [s.twin] at hLt
    exact hLt
  have hcase : ∀ M ∈ centMembers Ω a, IsUniqueInvolution M r → ∀ L ∈ centMembers Ω a,
      (∃ x ∈ pSpan (centMembers Ω a), conjSub x M = L) ∨ L = R ∨ L = R' := by
    intro M hM hMr L hL
    by_cases hc : ∃ x ∈ pSpan (centMembers Ω a), conjSub x M = L
    · exact Or.inl hc
    · exact Or.inr (hkey M hM hMr L hL (hcomm M hM L hL hc))
  have hR'n : ¬ ∃ x ∈ pSpan (centMembers Ω a), conjSub x R = R' := by
    intro hRR'
    obtain ⟨L, hL, L', hL', hnLL'⟩ := hnc
    have hconj : ∀ M ∈ centMembers Ω a, ∃ x ∈ pSpan (centMembers Ω a), conjSub x R = M := by
      intro M hM
      rcases hcase R hR s.isInv M hM with h1 | h1 | h1
      · exact h1
      · exact h1 ▸ hrefl R
      · exact h1 ▸ hRR'
    exact hnLL' (htrans _ _ _ (hsymm _ _ (hconj L hL)) (hconj L' hL'))
  refine Set.Subset.antisymm (fun L hL => ?_)
    (Set.insert_subset_iff.mpr ⟨hR, Set.singleton_subset_iff.mpr hR'⟩)
  rcases hcase R hR s.isInv L hL with h1 | h1 | h1
  · rcases hcase R' hR' s.mem_twin.2 L hL with h2 | h2 | h2
    · exact absurd (htrans _ _ _ h1 (hsymm _ _ h2)) hR'n
    · exact Or.inl h2
    · exact Or.inr h2
  · exact Or.inl h1
  · exact Or.inr h1

theorem oneOrbit_of_ne_pair (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G} (ha : a ≠ 1)
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    (hR' : R' ∈ centMembers Ω a) (hne : centMembers Ω a ≠ {R, R'}) :
    ∀ L ∈ centMembers Ω a, ∀ L' ∈ centMembers Ω a,
      ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = L' := by
  rcases h.toStarHyp.sectionConcl_centMembers ha with ⟨hnc, hcomm⟩ | ⟨hone, -, -⟩
  · exact absurd (h.centMembers_eq_pair_of_not_conj h9 s hR hR' hcomm hnc) hne
  · exact hone

theorem twinSet_subset_centMembers (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G} (ha : a ≠ 1)
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    (hR' : R' ∈ centMembers Ω a) (hne : centMembers Ω a ≠ {R, R'}) :
    ∀ L ∈ centMembers Ω a, twinSet Ω L ⊆ centMembers Ω a := by
  intro L hL M hM
  obtain ⟨x, hx, rfl⟩ := h.oneOrbit_of_ne_pair h9 ha s hR hR' hne R hR L hL
  have hM' : conjSub x⁻¹ M ∈ twinSet Ω R := by
    have := twinSet_conj h.thmD.hyp.conjInvariant hM x⁻¹
    rwa [conjSub_inv_conjSub] at this
  rw [s.twin] at hM'
  have hMx : M = conjSub x R ∨ M = conjSub x R' := by
    rcases hM' with h1 | h1
    · left
      rw [← h1, conjSub_conjSub_inv]
    · right
      rw [← h1, conjSub_conjSub_inv]
  rcases hMx with rfl | rfl
  · exact hL
  · exact h.toStarHyp.conjSub_mem_centMembers hR' hx

theorem aeIdentOn_map_injective (h : EndHyp Ω) {P : Set (Subgroup G)} (hP : P ⊆ Ω)
    {n : ℕ} {𝒜 : Set (Finset (Fin n))} {H : Subgroup (AE.AEQ n)}
    (I : AEIdentOn P n 𝒜 H) {L L' : Subgroup G} (hL : L ∈ P) (hL' : L' ∈ P)
    (he : (L.subgroupOf (pSpan P)).map I.φ = (L'.subgroupOf (pSpan P)).map I.φ) : L = L' := by
  by_contra hne
  have key : ∀ l' ∈ L', ∃ l ∈ L, ∃ c : G, (∀ y ∈ pSpan P, c * y = y * c) ∧ l' = l * c := by
    intro l' hl'
    have hx : I.φ ⟨l', le_pSpan hL' hl'⟩ ∈ (L'.subgroupOf (pSpan P)).map I.φ :=
      ⟨⟨l', le_pSpan hL' hl'⟩, Subgroup.mem_subgroupOf.mpr hl', rfl⟩
    rw [← he] at hx
    obtain ⟨x, hxL, hxe⟩ := hx
    have hk : x⁻¹ * ⟨l', le_pSpan hL' hl'⟩ ∈ I.φ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hxe, inv_mul_cancel]
    refine ⟨(x : G), Subgroup.mem_subgroupOf.mp hxL, (x : G)⁻¹ * l', fun y hy => ?_,
      (mul_inv_cancel_left (x : G) l').symm⟩
    exact (congrArg Subtype.val (Subgroup.mem_center_iff.mp (I.ker_le hk) ⟨y, hy⟩)).symm
  have hN : L' ≤ Subgroup.normalizer (L : Set G) := by
    intro l' hl'
    obtain ⟨l, hl, c, hc, rfl⟩ := key l' hl'
    refine Subgroup.mul_mem _ (Subgroup.le_normalizer hl)
      (Subgroup.centralizer_le_normalizer _ ?_)
    exact Subgroup.mem_centralizer_iff.mpr fun x hx => (hc x (le_pSpan hL hx)).symm
  have hL2 := h.thmD.two L (hP hL)
  have hL'2 := h.thmD.two L' (hP hL')
  obtain ⟨S, hS⟩ := (hL'2.to_sup_of_normal_right' hL2 hN).exists_le_sylow
  have hcomm : Commutes L L' := Q3CP.l67Gen G Ω h.thmD.hyp S L
    (TC.mem_RSet_of_isPGroup (hP hL) hL2) L' (TC.mem_RSet_of_isPGroup (hP hL') hL'2)
    (le_sup_right.trans hS) (le_sup_left.trans hS) hne
  obtain ⟨v, hv, hvc⟩ := Sec6Gen.exists_noncentral h.thmD.hyp (hP hL') le_rfl hL'2
    (by rw [h.thmD.card L' (hP hL')]; norm_num)
  refine hvc fun w hw => ?_
  obtain ⟨l, hl, c, hc, rfl⟩ := key w hw
  calc v * (l * c) = v * l * c := (mul_assoc _ _ _).symm
    _ = l * v * c := by rw [hcomm l hl v hv]
    _ = l * (v * c) := mul_assoc _ _ _
    _ = l * (c * v) := by rw [hc v (le_pSpan hL' hv)]
    _ = l * c * v := (mul_assoc _ _ _).symm

theorem false_of_two_commuting (h : EndHyp Ω) (h9 : Perp9 Ω) {P : Set (Subgroup G)} (hP : P ⊆ Ω)
    (hinv : ∀ L ∈ P, ∀ x ∈ pSpan P, conjSub x L ∈ P) {Q : Type} [Group Q]
    (φ : ↥(pSpan P) →* Q)
    (hinj : ∀ L ∈ P, ∀ L' ∈ P,
      (L.subgroupOf (pSpan P)).map φ = (L'.subgroupOf (pSpan P)).map φ → L = L')
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ P) {R₂ L : Subgroup G}
    (hR₂ : R₂ ∈ P) (hL : L ∈ P) (hR₂R : R₂ ≠ R) (hLR : L ≠ R) (hLR₂ : L ≠ R₂)
    (hR₂c : ∀ x ∈ (R₂.subgroupOf (pSpan P)).map φ, ∀ y ∈ (R.subgroupOf (pSpan P)).map φ,
      x * y = y * x)
    (hLc : ∀ x ∈ (L.subgroupOf (pSpan P)).map φ, ∀ y ∈ (R.subgroupOf (pSpan P)).map φ,
      x * y = y * x) : False := by
  have hkp := h.kPerp_eq_twinSet_of_perp9 h9 (hP hR)
  have key : ∀ M ∈ P, M ≠ R → M ∈ omegaNbr Ω R → M = R' := by
    intro M hM hMR hMn
    have hmem : M ∈ KPerp Ω R := Set.mem_insert_of_mem _ hMn
    rw [hkp, s.twin] at hmem
    rcases hmem with h1 | h1
    · exact absurd h1 hMR
    · exact h1
  have h1 := key R₂ hR₂ hR₂R (h.mem_omegaNbr_of_map_comm hP hinv φ hinj hR hR₂ hR₂R hR₂c)
  have h2 := key L hL hLR (h.mem_omegaNbr_of_map_comm hP hinv φ hinj hR hL hLR hLc)
  exact hLR₂ (h2.trans h1.symm)

theorem false_of_aeIdent_of_eight_le (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G}
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    {m : ℕ} (hm : 8 ≤ m) (I : AEIdent (centMembers Ω a) m) : False := by
  have hm5 : 5 ≤ m := by omega
  have hPΩ : centMembers Ω a ⊆ Ω := fun L hL => hL.1
  have hinv : ∀ L ∈ centMembers Ω a, ∀ x ∈ pSpan (centMembers Ω a),
      conjSub x L ∈ centMembers Ω a := fun L hL x hx =>
    h.toStarHyp.conjSub_mem_centMembers hL hx
  have hinj : ∀ L ∈ centMembers Ω a, ∀ L' ∈ centMembers Ω a,
      (L.subgroupOf (pSpan (centMembers Ω a))).map I.φ =
        (L'.subgroupOf (pSpan (centMembers Ω a))).map I.φ → L = L' :=
    fun L hL L' hL' he => h.toStarHyp.aeIdent_map_injective hPΩ I hL hL' he
  obtain ⟨α, hα, b, hRlab⟩ := I.label R hR
  obtain ⟨R₂, hR₂, hR₂lab⟩ := I.label_surj α hα (!b)
  obtain ⟨β, hβsub, hβ⟩ : ∃ β ⊆ αᶜ, β.card = 4 :=
    Finset.exists_subset_card_eq (by rw [Finset.card_compl, Fintype.card_fin, hα]; omega)
  have hαβ : Disjoint α β := Finset.disjoint_of_subset_right hβsub disjoint_compl_right
  obtain ⟨L, hL, hLlab⟩ := I.label_surj β hβ true
  have hβα : β ≠ α := by
    rintro rfl
    have : β = ∅ := Finset.disjoint_self_iff_empty _ |>.mp hαβ
    rw [this, Finset.card_empty] at hβ
    omega
  have hR₂R : R₂ ≠ R := by
    rintro rfl
    rw [hRlab] at hR₂lab
    cases b
    · exact AE.memBar_true_ne_false hm5 α hα hR₂lab.symm
    · exact AE.memBar_true_ne_false hm5 α hα hR₂lab
  have hLR : L ≠ R := by
    rintro rfl
    rw [hRlab] at hLlab
    exact hβα (AE.eq_of_memBar_eq' hm5 hLlab.symm)
  have hLR₂ : L ≠ R₂ := by
    rintro rfl
    rw [hR₂lab] at hLlab
    exact hβα (AE.eq_of_memBar_eq' hm5 hLlab.symm)
  have hR₂c : ∀ x ∈ (R₂.subgroupOf (pSpan (centMembers Ω a))).map I.φ,
      ∀ y ∈ (R.subgroupOf (pSpan (centMembers Ω a))).map I.φ, x * y = y * x := by
    rw [hR₂lab, hRlab]
    cases b
    · exact fun x hx y hy => AE.comm_memBar_true_false x hx y hy
    · exact fun x hx y hy => (AE.comm_memBar_true_false y hy x hx).symm
  have hLc : ∀ x ∈ (L.subgroupOf (pSpan (centMembers Ω a))).map I.φ,
      ∀ y ∈ (R.subgroupOf (pSpan (centMembers Ω a))).map I.φ, x * y = y * x := by
    rw [hLlab, hRlab]
    exact AE.comm_memBar_of_disjoint hαβ.symm true b
  exact h.false_of_two_commuting h9 hPΩ hinv I.φ hinj s hR hR₂ hL hR₂R hLR hLR₂ hR₂c hLc

theorem false_of_e29 (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G}
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    (I : AEIdentOn (centMembers Ω a) 8 AE.e29Sets AE.e29Sub) : False := by
  have hm5 : 5 ≤ 8 := by norm_num
  have hPΩ : centMembers Ω a ⊆ Ω := fun L hL => hL.1
  have hinv : ∀ L ∈ centMembers Ω a, ∀ x ∈ pSpan (centMembers Ω a),
      conjSub x L ∈ centMembers Ω a := fun L hL x hx =>
    h.toStarHyp.conjSub_mem_centMembers hL hx
  have hinj : ∀ L ∈ centMembers Ω a, ∀ L' ∈ centMembers Ω a,
      (L.subgroupOf (pSpan (centMembers Ω a))).map I.φ =
        (L'.subgroupOf (pSpan (centMembers Ω a))).map I.φ → L = L' :=
    fun L hL L' hL' he => h.aeIdentOn_map_injective hPΩ I hL hL' he
  obtain ⟨α, hαmem, hα, b, hRlab⟩ := I.label R hR
  obtain ⟨R₂, hR₂, hR₂lab⟩ := I.label_surj α hαmem hα (!b)
  have hcompl : ∀ α ∈ AE.affinePlanes, αᶜ ∈ AE.affinePlanes := by decide +kernel
  have hβmem : αᶜ ∈ AE.e29Sets := hcompl α hαmem
  have hβ : (αᶜ).card = 4 := by rw [Finset.card_compl, Fintype.card_fin, hα]
  obtain ⟨L, hL, hLlab⟩ := I.label_surj αᶜ hβmem hβ true
  have hαβ : Disjoint α αᶜ := disjoint_compl_right
  have hβα : αᶜ ≠ α := by
    intro he
    rw [he] at hαβ
    have : α = ∅ := Finset.disjoint_self_iff_empty _ |>.mp hαβ
    rw [this, Finset.card_empty] at hα
    omega
  have hR₂R : R₂ ≠ R := by
    rintro rfl
    rw [hRlab] at hR₂lab
    cases b
    · exact AE.memBar_true_ne_false hm5 α hα hR₂lab.symm
    · exact AE.memBar_true_ne_false hm5 α hα hR₂lab
  have hLR : L ≠ R := by
    rintro rfl
    rw [hRlab] at hLlab
    exact hβα (AE.eq_of_memBar_eq' hm5 hLlab.symm)
  have hLR₂ : L ≠ R₂ := by
    rintro rfl
    rw [hR₂lab] at hLlab
    exact hβα (AE.eq_of_memBar_eq' hm5 hLlab.symm)
  have hR₂c : ∀ x ∈ (R₂.subgroupOf (pSpan (centMembers Ω a))).map I.φ,
      ∀ y ∈ (R.subgroupOf (pSpan (centMembers Ω a))).map I.φ, x * y = y * x := by
    rw [hR₂lab, hRlab]
    cases b
    · exact fun x hx y hy => AE.comm_memBar_true_false x hx y hy
    · exact fun x hx y hy => (AE.comm_memBar_true_false y hy x hx).symm
  have hLc : ∀ x ∈ (L.subgroupOf (pSpan (centMembers Ω a))).map I.φ,
      ∀ y ∈ (R.subgroupOf (pSpan (centMembers Ω a))).map I.φ, x * y = y * x := by
    rw [hLlab, hRlab]
    exact AE.comm_memBar_of_disjoint hαβ.symm true b
  exact h.false_of_two_commuting h9 hPΩ hinv I.φ hinj s hR hR₂ hL hR₂R hLR hLR₂ hR₂c hLc

theorem le_sup_of_e8Struct (h : EndHyp Ω) {a : G} {R R' : Subgroup G} {r : G}
    (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a) (hR' : R' ∈ centMembers Ω a)
    {E : Subgroup G} (hE : E8Struct (pSpan (centMembers Ω a)) E) : r ∈ E ∧ E ≤ R ⊔ R' := by
  have hΩ := h.thmD.hyp
  have hcomm : ∀ x ∈ R, ∀ y ∈ R', x * y = y * x := s.commutes h
  have hnormR' : R' ≤ Subgroup.normalizer (R : Set G) :=
    PhilipHall.Frame.TwinThin.E8.le_normalizer_of_commute hcomm
  have hrE : r ∈ E := by
    obtain ⟨Q, hQn, hQ2, hrQ⟩ := h.thmD.inO2 R hR.1 r s.isInv
    refine hE.core (Q ⊓ pSpan (centMembers Ω a)) inf_le_right (fun x hx q hq => ?_)
      (hQ2.to_le inf_le_left) ⟨hrQ, le_pSpan hR s.isInv.mem⟩
    exact ⟨hQn.conj_mem q hq.1 x,
      Subgroup.mul_mem _ (Subgroup.mul_mem _ hx hq.2) (Subgroup.inv_mem _ hx)⟩
  refine ⟨hrE, ?_⟩
  have hsqR : ∀ y ∈ R, y * y ∈ E := fun y hy => by
    have h4 := PhilipHall.Frame.TwinThin.E8.pow_four_of_card_eight hΩ hR.1
      (h.card_eq_eight hR.1) hy
    rcases s.isInv.unique (y * y) (R.mul_mem hy hy) h4 with h1 | h1
    · rw [h1]
      exact E.one_mem
    · rw [h1]
      exact hrE
  have hsqR' : ∀ y ∈ R', y * y ∈ E := fun y hy => by
    have h4 := PhilipHall.Frame.TwinThin.E8.pow_four_of_card_eight hΩ hR'.1
      (h.card_eq_eight hR'.1) hy
    rcases s.mem_twin.2.unique (y * y) (R'.mul_mem hy hy) h4 with h1 | h1
    · rw [h1]
      exact E.one_mem
    · rw [h1]
      exact hrE
  have hsq : ∀ t ∈ R ⊔ R', t * t ∈ E := by
    intro t ht
    have ht' : t ∈ (R : Set G) * (R' : Set G) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left R R' hnormR']
      exact ht
    obtain ⟨x, hx, y, hy, rfl⟩ := ht'
    have hxy := hcomm x hx y hy
    have e : x * y * (x * y) = (x * x) * (y * y) := by
      calc x * y * (x * y) = x * (y * x) * y := by group
        _ = x * (x * y) * y := by rw [← hxy]
        _ = (x * x) * (y * y) := by group
    rw [e]
    exact E.mul_mem (hsqR x hx) (hsqR' y hy)
  exact PhilipHall.Frame.TwinThin.E8.le_of_card_thirtyTwo hE
    (sup_le (le_pSpan hR) (le_pSpan hR')) (s.card_sup h) hsq

theorem exists_swapHom (h : EndHyp Ω) {a : G} {R R' : Subgroup G} {r : G}
    (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a) (hR' : R' ∈ centMembers Ω a)
    (hone : ∀ L ∈ centMembers Ω a, ∀ L' ∈ centMembers Ω a,
      ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = L') :
    ∃ θ : ↥(Subgroup.centralizer ({r} : Set G) ⊓ pSpan (centMembers Ω a)) →*
        Multiplicative (ZMod 2),
      (∀ x, θ x = 1 ↔ conjSub (x : G) R = R) ∧ ∃ x, θ x ≠ 1 := by
  classical
  set C := Subgroup.centralizer ({r} : Set G) ⊓ pSpan (centMembers Ω a) with hC
  have hRR' : R' ≠ R := s.ne.symm
  have hperm : ∀ x : C, (conjSub (x : G) R = R ∧ conjSub (x : G) R' = R') ∨
      (conjSub (x : G) R = R' ∧ conjSub (x : G) R' = R) := by
    intro x
    have hxr : (x : G) * r * (x : G)⁻¹ = r := by
      rw [Subgroup.mem_centralizer_singleton_iff.mp x.2.1]
      group
    have hxt : ∀ M, M ∈ centMembers Ω a → IsUniqueInvolution M r →
        conjSub (x : G) M = R ∨ conjSub (x : G) M = R' := by
      intro M hMP hMi
      have hxM : conjSub (x : G) M ∈ centMembers Ω a :=
        h.toStarHyp.conjSub_mem_centMembers hMP x.2.2
      have hmem : conjSub (x : G) M ∈ twinSet Ω R :=
        ⟨hxM.1, r, s.isInv, by have := hMi.conj (x : G); rwa [hxr] at this⟩
      rw [s.twin] at hmem
      exact hmem
    have hinj := conjSub_injective (x : G)
    rcases hxt R hR s.isInv with h1 | h1 <;> rcases hxt R' hR' s.mem_twin.2 with h2 | h2
    · exact absurd (hinj (h1.trans h2.symm)) s.ne
    · exact Or.inl ⟨h1, h2⟩
    · exact Or.inr ⟨h1, h2⟩
    · exact absurd (hinj (h1.trans h2.symm)) s.ne
  have h11 : (Multiplicative.ofAdd (1 : ZMod 2)) * Multiplicative.ofAdd 1 = 1 := by decide
  have hne1 : (Multiplicative.ofAdd (1 : ZMod 2)) ≠ 1 := by decide
  let θ : C →* Multiplicative (ZMod 2) := MonoidHom.mk'
    (fun x : C => if conjSub (x : G) R = R then 1 else Multiplicative.ofAdd (1 : ZMod 2))
    (by
      intro x y
      have hxy : conjSub ((x : G) * (y : G)) R = conjSub (x : G) (conjSub (y : G) R) :=
        conjSub_mul _ _ _
      rcases hperm x with ⟨hx1, hx2⟩ | ⟨hx1, hx2⟩ <;>
        rcases hperm y with ⟨hy1, hy2⟩ | ⟨hy1, hy2⟩
      · have e : conjSub ((x : G) * (y : G)) R = R := by rw [hxy, hy1, hx1]
        simp [hx1, hy1, e]
      · have e : conjSub ((x : G) * (y : G)) R = R' := by rw [hxy, hy1, hx2]
        simp [hx1, hy1, e, hRR']
      · have e : conjSub ((x : G) * (y : G)) R = R' := by rw [hxy, hy1, hx1]
        simp [hx1, hy1, e, hRR']
      · have e : conjSub ((x : G) * (y : G)) R = R := by rw [hxy, hy1, hx2]
        simp [hx1, hy1, e, hRR', h11])
  have hθ : ∀ x : C, θ x = 1 ↔ conjSub (x : G) R = R := by
    intro x
    by_cases hx : conjSub (x : G) R = R
    · simp [θ, hx]
    · simp [θ, hx, hne1]
  refine ⟨θ, hθ, ?_⟩
  obtain ⟨x, hxP, hx⟩ := hone R hR R' hR'
  have hxr : x * r * x⁻¹ = r := by
    have := s.isInv.conj x
    rw [hx] at this
    exact this.eq s.mem_twin.2
  have hxC : x ∈ Subgroup.centralizer ({r} : Set G) :=
    Subgroup.mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hxr)
  refine ⟨⟨x, hxC, hxP⟩, ?_⟩
  rw [Ne, hθ]
  exact fun hx' => hRR' (hx.symm.trans hx')

theorem false_of_e8Struct (h : EndHyp Ω) {a : G} {R R' : Subgroup G} {r : G}
    (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a) (hR' : R' ∈ centMembers Ω a)
    (hone : ∀ L ∈ centMembers Ω a, ∀ L' ∈ centMembers Ω a,
      ∃ x ∈ pSpan (centMembers Ω a), conjSub x L = L')
    {E : Subgroup G} (hE : E8Struct (pSpan (centMembers Ω a)) E) : False := by
  classical
  set X := pSpan (centMembers Ω a) with hX
  have hΩ := h.thmD.hyp
  obtain ⟨hrE, hES⟩ := h.le_sup_of_e8Struct s hR hR' hE
  have hEN : E ≤ Subgroup.normalizer (R : Set G) :=
    hES.trans (sup_le Subgroup.le_normalizer
      (PhilipHall.Frame.TwinThin.E8.le_normalizer_of_commute (s.commutes h)))
  set C := Subgroup.centralizer ({r} : Set G) ⊓ X with hC
  have hCX : C ≤ X := inf_le_right
  obtain ⟨θ, hθ, x₀, hx₀⟩ := h.exists_swapHom s hR hR' hone
  obtain ⟨e, he, he0⟩ := TL4.SecIdE2.exists_e8Basis_of_mem hE.sq hE.card hrE s.isInv.ne_one
  let ρ : ↥C →* E8Fin.SL32 := (TL4.e8Hom hE he).comp (Subgroup.inclusion hCX)
  have hw0 : TL4.e8Coord e E8Fin.w0 = r := by
    simp [TL4.e8Coord, E8Fin.w0, he0]
  have hconj : ∀ x : ↥X, (x : G) * r * (x : G)⁻¹ =
      TL4.e8Coord e (((TL4.e8Hom hE he x).1).mulVec E8Fin.w0) := by
    intro x
    have := TL4.conj_e8Coord_e8Hom hE he x E8Fin.w0
    rwa [hw0] at this
  have hfixiff : ∀ x : ↥X, (((TL4.e8Hom hE he x).1).mulVec E8Fin.w0 = E8Fin.w0) ↔
      (x : G) * r = r * x := by
    intro x
    constructor
    · intro hx
      have := hconj x
      rw [hx, hw0] at this
      exact mul_inv_eq_iff_eq_mul.mp this
    · intro hx
      apply TL4.e8Coord_injective he
      rw [← hconj x, hw0]
      calc (x : G) * r * (x : G)⁻¹ = r * (x : G) * (x : G)⁻¹ := by rw [hx]
        _ = r := by group
  have hfix : ∀ γ : ↥C, (ρ γ).1.mulVec E8Fin.w0 = E8Fin.w0 := fun γ =>
    (hfixiff ⟨γ, hCX γ.2⟩).mpr (Subgroup.mem_centralizer_singleton_iff.mp γ.2.1)
  have hsurj : ∀ M : E8Fin.SL32, M.1.mulVec E8Fin.w0 = E8Fin.w0 → ∃ γ : ↥C, ρ γ = M := by
    intro M hM
    obtain ⟨y, hy⟩ := TL4.e8Hom_surjective hE he M
    have hyC : (y : G) * r = r * y := (hfixiff y).mp (hy ▸ hM)
    exact ⟨⟨(y : G), Subgroup.mem_centralizer_singleton_iff.mpr hyC, y.2⟩, hy⟩
  have hρE : ∀ γ : ↥C, ρ γ = 1 ↔ (γ : G) ∈ E := fun γ =>
    TL4.e8Hom_eq_one_iff hE he (Subgroup.inclusion hCX γ)
  have hker : ∀ γ : ↥C, ρ γ = 1 → θ γ = 1 := fun γ hγ =>
    (hθ γ).mpr (mem_normalizer_iff_conjSub_eq.mp (hEN ((hρE γ).mp hγ)))
  have hq : IsQuatSub R :=
    Sec6Gen.isQuatSub_of_mem_RSet hΩ (TC.mem_RSet_of_isPGroup hR.1 (h.thmD.two R hR.1))
  obtain ⟨i, j, hi, hj, hii, hjj, hji, -⟩ := exists_q8_gen s.isInv hq (h.card_eq_eight hR.1)
  have hRX : R ≤ X := le_pSpan hR
  have hir : i * r = r * i := isUniqueInvolution_comm s.isInv hi
  have hjr : j * r = r * j := isUniqueInvolution_comm s.isInv hj
  have hiC : i ∈ C := ⟨Subgroup.mem_centralizer_singleton_iff.mpr hir, hRX hi⟩
  have hjC : j ∈ C := ⟨Subgroup.mem_centralizer_singleton_iff.mpr hjr, hRX hj⟩
  have hijij : i * j * (i * j) = r := by
    calc i * j * (i * j) = i * (j * i) * j := by group
      _ = i * (r * (i * j)) * j := by rw [hji]
      _ = (i * r) * (i * j) * j := by group
      _ = (r * i) * (i * j) * j := by rw [hir]
      _ = r * (i * i) * (j * j) := by group
      _ = r * r * r := by rw [hii, hjj]
      _ = r := by rw [s.isInv.sq, one_mul]
  let ι₁ : ↥C := ⟨i, hiC⟩
  let ι₂ : ↥C := ⟨j, hjC⟩
  have hAA : ρ ι₁ * ρ ι₁ = 1 := by
    rw [← map_mul]
    exact (hρE _).mpr (by show i * i ∈ E; rw [hii]; exact hrE)
  have hBB : ρ ι₂ * ρ ι₂ = 1 := by
    rw [← map_mul]
    exact (hρE _).mpr (by show j * j ∈ E; rw [hjj]; exact hrE)
  have hABAB : (ρ ι₁ * ρ ι₂) * (ρ ι₁ * ρ ι₂) = 1 := by
    rw [← map_mul, ← map_mul]
    exact (hρE _).mpr (by show i * j * (i * j) ∈ E; rw [hijij]; exact hrE)
  have hr1 := s.isInv.ne_one
  have hA1 : ρ ι₁ ≠ 1 := fun h1 => hr1 (by
    have := hE.sq i ((hρE ι₁).mp h1)
    rwa [hii] at this)
  have hB1 : ρ ι₂ ≠ 1 := fun h1 => hr1 (by
    have := hE.sq j ((hρE ι₂).mp h1)
    rwa [hjj] at this)
  have hAB1 : ρ ι₁ * ρ ι₂ ≠ 1 := fun h1 => hr1 (by
    rw [← map_mul] at h1
    have := hE.sq (i * j) ((hρE (ι₁ * ι₂)).mp h1)
    rwa [hijij] at this)
  obtain ⟨τ, hτ, σ, hσ0, hσT⟩ := E8Fin.f_key (ρ ι₁) (ρ ι₂) (hfix ι₁) (hfix ι₂) hAA hBB hABAB hA1 hB1
    hAB1
  have key : ∀ κ : ↥C, (κ : G) ∈ R → (κ : G) * (κ : G) = r →
      E8Fin.IsT (σ * ρ κ * σ⁻¹) → ∃ v : ↥C, E8Fin.IsT (ρ v) ∧ θ v = 1 := by
    intro κ hκR hκκ hσT'
    obtain ⟨x, hx⟩ := TL4.e8Hom_surjective hE he σ
    set v : G := (x : G) * (κ : G) * (x : G)⁻¹ with hv
    have hvX : v ∈ X := X.mul_mem (X.mul_mem x.2 (hCX κ.2)) (X.inv_mem x.2)
    have hρv : TL4.e8Hom hE he ⟨v, hvX⟩ = σ * ρ κ * σ⁻¹ := by
      have e1 : (⟨v, hvX⟩ : ↥X) = x * Subgroup.inclusion hCX κ * x⁻¹ := Subtype.ext rfl
      rw [e1, map_mul, map_mul, map_inv, hx]
      rfl
    have hTv : E8Fin.IsT (TL4.e8Hom hE he ⟨v, hvX⟩) := hρv ▸ hσT'
    have hvr : v * r = r * v := (hfixiff ⟨v, hvX⟩).mp hTv.1
    let v' : ↥C := ⟨v, Subgroup.mem_centralizer_singleton_iff.mpr hvr, hvX⟩
    refine ⟨v', hTv, (hθ v').mpr ?_⟩
    have hJΩ : conjSub (x : G) R ∈ Ω := hΩ.conjInvariant (x : G) R hR.1
    have hxr : (x : G) * r * (x : G)⁻¹ ≠ r := by
      intro hxr
      rw [hconj x, ← hw0] at hxr
      exact hσ0 (hx ▸ TL4.e8Coord_injective he hxr)
    have hRJ : R ≠ conjSub (x : G) R := by
      intro hRJ
      have := s.isInv.conj (x : G)
      rw [← hRJ] at this
      exact hxr (this.eq s.isInv)
    have hvJ : v ∈ conjSub (x : G) R := conj_mem_conjSub hκR
    have hvv : v * v = (x : G) * r * (x : G)⁻¹ := by
      rw [← hκκ, hv]
      group
    have hord : orderOf v = 4 := by
      have h2 : ¬ v ^ 2 ^ 1 = 1 := by
        rw [pow_one, pow_two, hvv]
        exact (s.isInv.conj (x : G)).ne_one
      have h4 : v ^ 2 ^ (1 + 1) = 1 := by
        have e4 : v ^ 2 ^ (1 + 1) = (v * v) * (v * v) := by
          rw [show 2 ^ (1 + 1) = 2 + 2 by norm_num, pow_add, pow_two]
        rw [e4, hvv]
        calc (x : G) * r * (x : G)⁻¹ * ((x : G) * r * (x : G)⁻¹) =
            (x : G) * (r * r) * (x : G)⁻¹ := by group
          _ = 1 := by rw [s.isInv.sq]; group
      simpa using orderOf_eq_prime_pow h2 h4
    have hA3 : 3 ≤ Nat.card (Subgroup.zpowers v) := by
      rw [Nat.card_zpowers, hord]
      norm_num
    have hAJ : Subgroup.zpowers v ≤ conjSub (x : G) R := Subgroup.zpowers_le.mpr hvJ
    have hA2 : IsPGroup 2 (Subgroup.zpowers v) := (h.thmD.two _ hJΩ).to_le hAJ
    have hAc : Subgroup.zpowers v ≤ Subgroup.centralizer ({r} : Set G) :=
      Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr hvr)
    have hvN : v ∈ Subgroup.normalizer (R : Set G) :=
      Sec6Gen.le_normalizer_of_le_centralizer hΩ hR.1 hJΩ hRJ s.isInv hAJ hA2 hA3 hAc
        (Subgroup.mem_zpowers v)
    exact mem_normalizer_iff_conjSub_eq.mp hvN
  obtain ⟨v, hvT, hθv⟩ : ∃ v : ↥C, E8Fin.IsT (ρ v) ∧ θ v = 1 := by
    rcases hτ with h1 | h1 | h1
    · exact key ι₁ hi hii (h1 ▸ hσT)
    · exact key ι₂ hj hjj (h1 ▸ hσT)
    · exact key (ι₁ * ι₂) (R.mul_mem hi hj) hijij (by rw [map_mul]; exact h1 ▸ hσT)
  exact hx₀ (E8Fin.e8_abs ρ θ hfix hsurj hker hvT hθv x₀)

end EndHyp

theorem ncard_eq_six_of_normal_wSet {Y : Type} [Group Y] [Finite Y] {Φ : Set (Subgroup Y)}
    (hP : Q3CL.PartIHypG Φ) (h2 : ∀ L ∈ Φ, IsPGroup 2 L) {W : Subgroup Y} (hW : W ∈ WSet Φ)
    (hWn : W.Normal) (hpair : ∀ L ∈ Φ, ∃ L' ∈ Φ, L' ≠ L ∧ omegaNbr Φ L = {L'})
    (hmore : ∃ L ∈ Φ, ∃ T ∈ Φ, T ≠ L ∧ T ∉ omegaNbr Φ L) :
    Φ.ncard = 6 ∧ ∀ L ∈ Φ, ∀ T ∈ Φ, T ≠ L → T ∈ omegaStarNbr Φ L := by
  classical
  have hrepex : ∀ L ∈ Φ, ∃ ρ : Thompson.Rep Φ W, ρ.K = L := by
    intro L hL
    have hLD : L ∈ DSet Φ W :=
      ⟨TC.mem_RSet_of_isPGroup hL (h2 L hL),
        (Subgroup.normalizer_eq_top_iff.mpr hWn).symm ▸ le_top⟩
    obtain ⟨r, hr, hrW⟩ := Q3CL.Thompson.exists_not_mem_of_mem_D hP.hyp hW hLD
    exact ⟨⟨L, L, r, hL, hLD, ⟨le_rfl, h2 L hL, fun V hVL _ hLV => le_antisymm hVL hLV⟩, hr,
      hrW⟩, rfl⟩
  obtain ⟨L₁, hL₁, T₁, hT₁, hT₁ne, hT₁n⟩ := hmore
  obtain ⟨ρ₀, -⟩ := hrepex L₁ hL₁
  haveI : Nonempty (Thompson.Rep Φ W) := ⟨ρ₀⟩
  choose! rep hrepK using hrepex
  have hstar : ∀ L ∈ Φ, ∀ T ∈ Φ, T ≠ L → T ∈ omegaStarNbr Φ L := by
    intro L hL T hT hne
    have := Q3T6.Mu.muTab_omegaStar hP hW (rep L) (rep T)
      (by rw [hrepK L hL, hrepK T hT]; exact Ne.symm hne)
    rwa [hrepK L hL, hrepK T hT] at this
  refine ⟨?_, hstar⟩
  obtain ⟨L₁', hL₁'Φ, hL₁'ne, hnbr⟩ := hpair L₁ hL₁
  have hL₁'mem : L₁' ∈ omegaNbr Φ L₁ := by rw [hnbr]; exact Set.mem_singleton _
  have hL₁mem : L₁ ∈ omegaNbr Φ L₁' :=
    Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hP.hyp hL₁ hL₁'Φ hL₁'mem
  have hnbr' : omegaNbr Φ L₁' = {L₁} := by
    obtain ⟨L'', -, -, hL''⟩ := hpair L₁' hL₁'Φ
    rw [hL''] at hL₁mem ⊢
    rw [Set.mem_singleton_iff] at hL₁mem
    rw [hL₁mem]
  have hcomp : ∀ J, J ∈ dComp Φ L₁ → J = L₁ ∨ J = L₁' := by
    intro J hJ
    have hJ' : Relation.ReflTransGen (fun M N : Subgroup Y => N ∈ Φ ∧ Disconnected.dAdj Φ M N)
        L₁ J := hJ
    clear hJ
    induction hJ' with
    | refl => exact Or.inl rfl
    | @tail J' N _ hstep ih =>
      obtain ⟨hNΦ, hadj⟩ := hstep
      rcases ih with h1 | h1
      · have hJ'Φ : J' ∈ Φ := h1 ▸ hL₁
        rcases hadj with hadj | hadj
        · rw [h1, hnbr, Set.mem_singleton_iff] at hadj
          exact Or.inr hadj
        · have := Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hP.hyp hNΦ hJ'Φ hadj
          rw [h1, hnbr, Set.mem_singleton_iff] at this
          exact Or.inr this
      · have hJ'Φ : J' ∈ Φ := h1 ▸ hL₁'Φ
        rcases hadj with hadj | hadj
        · rw [h1, hnbr', Set.mem_singleton_iff] at hadj
          exact Or.inl hadj
        · have := Q3CL.T3.omegaNbr_symm Sec6Gen.l6_2Gen hP.hyp hNΦ hJ'Φ hadj
          rw [h1, hnbr', Set.mem_singleton_iff] at this
          exact Or.inl this
  have hT₁star : T₁ ∈ dstarComp Φ L₁ :=
    Relation.ReflTransGen.single ⟨hT₁, Or.inl (hstar L₁ hL₁ T₁ hT₁ hT₁ne)⟩
  have hshape : dComp Φ L₁ ≠ dstarComp Φ L₁ := by
    intro he
    rw [← he] at hT₁star
    rcases hcomp T₁ hT₁star with h1 | h1
    · exact hT₁ne h1
    · exact hT₁n (h1 ▸ hL₁'mem)
  have hnc : ¬ DbarConnected Φ W := Q3T6.Mu.not_dbarConnected_of_shape hP hW hL₁ hshape
  set Δ := Thompson.muDelta Φ W with hΔ
  set p := MuTab.muTabElt (rep L₁) with hp
  obtain ⟨q, hqΔ, hpq⟩ := Q3T6.Mu.exists_not_conn_at hP hW hnc p
  have hpl : Star3T.IsPlane Δ p q (p * q * p) := ⟨MuTab.muTabElt_mem _, hqΔ, hpq, rfl⟩
  have hΔcard : Δ.ncard = 3 * (Star3T.cent Δ p).ncard :=
    (Q3T6.Mu.isTT_muDelta hP hW).ncard_eq_three_mul
      (Q3T6.Mu.isStar_muDelta (Q3CL.T8.ctxOf hP hW)) hpl
  have hcent_le : (Star3T.cent Δ p).ncard ≤ 2 := by
    refine Q3T6.Mu.ncard_cent_le hP hW (rep L₁) (n := 1) ?_
    rw [hrepK L₁ hL₁, hnbr, Set.ncard_singleton]
  have hcent_ge : 2 ≤ (Star3T.cent Δ p).ncard := by
    set p' := MuTab.muTabElt (rep L₁') with hp'
    have hne : (rep L₁).K ≠ (rep L₁').K := by
      rw [hrepK L₁ hL₁, hrepK L₁' hL₁'Φ]
      exact hL₁'ne.symm
    have hcomm := (Q3T6.Mu.muTab_commute_iff hP hW (rep L₁) (rep L₁') hne).mpr
      (by rw [hrepK L₁ hL₁, hrepK L₁' hL₁'Φ]; exact hL₁'mem)
    have hpp' : p ≠ p' := fun e =>
      hne ((Q3T6.Mu.muTabElt_eq_iff hP hW _ _).mp e)
    have hsub : ({p, p'} : Set ↥(muGroup Φ W)) ⊆ Star3T.cent Δ p := by
      intro x hx
      rcases hx with rfl | rfl
      · exact Star3T.self_mem_cent (MuTab.muTabElt_mem _)
      · exact ⟨MuTab.muTabElt_mem _, hcomm.symm⟩
    calc 2 = ({p, p'} : Set ↥(muGroup Φ W)).ncard := (Set.ncard_pair hpp').symm
      _ ≤ _ := Set.ncard_le_ncard hsub (Set.toFinite _)
  have hΔ6 : Δ.ncard = 6 := by omega
  rw [← hΔ6]
  refine Set.ncard_congr (fun L _ => MuTab.muTabElt (rep L)) (fun L _ => MuTab.muTabElt_mem _)
    (fun L L' hL hL' he => ?_) (fun d hd => ?_)
  · have := (Q3T6.Mu.muTabElt_eq_iff hP hW _ _).mp he
    rwa [hrepK L hL, hrepK L' hL'] at this
  · obtain ⟨σ, rfl⟩ := MuTab.exists_rep_of_mem_muDelta hd
    refine ⟨σ.K, σ.hK, ?_⟩
    exact (Q3T6.Mu.muTabElt_eq_iff hP hW _ _).mpr (hrepK σ.K σ.hK)

theorem exists_wSet_normal_of_WIn_singleton {P : Set (Subgroup G)}
    (hinv : ∀ L ∈ P, ∀ x ∈ pSpan P, conjSub x L ∈ P) {W₀ : Subgroup G}
    (hW : WIn P (pSpan P) = {W₀}) :
    ∃ W' ∈ WSet (restrictFamily P (pSpan P)),
      (∀ W'' ∈ WSet (restrictFamily P (pSpan P)), W'' = W') ∧ W'.Normal := by
  have hc' : ConjInvariant (restrictFamily P (pSpan P)) :=
    conjInvariant_restrictFamily fun L hL x hx => hinv L hL x hx
  have hWmem : W₀ ∈ WIn P (pSpan P) := by rw [hW]; rfl
  obtain ⟨W', hW'mem, -⟩ := hWmem
  have hW'uniq : ∀ W'' ∈ WSet (restrictFamily P (pSpan P)), W'' = W' := by
    intro W'' h
    have h1 : W''.map (pSpan P).subtype ∈ WIn P (pSpan P) := ⟨W'', h, rfl⟩
    have h2 : W'.map (pSpan P).subtype ∈ WIn P (pSpan P) := ⟨W', hW'mem, rfl⟩
    rw [hW, Set.mem_singleton_iff] at h1 h2
    exact Subgroup.map_injective (pSpan P).subtype_injective (h1.trans h2.symm)
  refine ⟨W', hW'mem, hW'uniq, ⟨fun n hn g => ?_⟩⟩
  have h1 := conj_mem_conjSub (n := g) hn
  rwa [hW'uniq _ (WSet.conj hc' hW'mem g)] at h1

theorem restrictFamily_centMembers_eq {Ω : Set (Subgroup G)} (a : G) :
    restrictFamily (centMembers Ω a) (pSpan (centMembers Ω a)) =
      restrictFamily Ω (pSpan (centMembers Ω a)) := by
  ext L'
  constructor
  · rintro ⟨L, hL, hLX, rfl⟩
    exact ⟨L, hL.1, hLX, rfl⟩
  · rintro ⟨L, hL, hLX, rfl⟩
    exact ⟨L, ⟨hL, hLX.trans (pSpan_le fun M hM => hM.2)⟩, hLX, rfl⟩

namespace EndHyp

variable {Ω : Set (Subgroup G)}

theorem mem_omegaNbr_iff_of_perp9 (h : EndHyp Ω) (h9 : Perp9 Ω) {L : Subgroup G} (hL : L ∈ Ω)
    {J : Subgroup G} : J ∈ omegaNbr Ω L ↔ J ∈ twinSet Ω L ∧ J ≠ L := by
  have hkp := h.kPerp_eq_twinSet_of_perp9 h9 hL
  constructor
  · intro hJ
    refine ⟨?_, hJ.2.1⟩
    rw [← hkp]
    exact Set.mem_insert_of_mem _ hJ
  · rintro ⟨hJ, hne⟩
    rw [← hkp] at hJ
    rcases hJ with h1 | h1
    · exact absurd h1 hne
    · exact h1

theorem section_six_of_uniqueW (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G} (ha : a ≠ 1)
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    (hR' : R' ∈ centMembers Ω a) (hne : centMembers Ω a ≠ {R, R'})
    (hW : ∃ W₀ : Subgroup G, WIn (centMembers Ω a) (pSpan (centMembers Ω a)) = {W₀}) :
    (centMembers Ω a).ncard = 6 ∧
      ∀ L ∈ centMembers Ω a, ∀ T ∈ centMembers Ω a, T ≠ L → T ∈ omegaStarNbr Ω L := by
  set P := centMembers Ω a with hPdef
  set X := pSpan P with hXdef
  have hinv : ∀ L ∈ P, ∀ x ∈ pSpan P, conjSub x L ∈ P := fun L hL x hx =>
    h.toStarHyp.conjSub_mem_centMembers hL hx
  obtain ⟨W₀, hW₀⟩ := hW
  obtain ⟨W, hWmem, -, hWn⟩ := exists_wSet_normal_of_WIn_singleton hinv hW₀
  have hΦeq : restrictFamily P X = restrictFamily Ω X := restrictFamily_centMembers_eq a
  have hO := thmDHypO_restrict (r := 3) h.thmD.hyp h.thmD.two h.thmD.card h.thmD.aEmpty
    h.thmD.inO2 (fun L hL => hL.1) hinv
  have hPI : Q3CL.PartIHypG (restrictFamily Ω X) := hΦeq ▸
    ⟨hO.hyp, classicalClause_of_two hO.hyp hO.two, hO.aEmpty⟩
  have hΦtwo : ∀ L ∈ restrictFamily Ω X, IsPGroup 2 L := hΦeq ▸ hO.two
  have hWΦ : W ∈ WSet (restrictFamily Ω X) := hΦeq ▸ hWmem
  have hsyl : ∀ {J T : Subgroup G}, J ∈ Ω → T ∈ RSet Ω → T ≤ J → IsSylow2In T J :=
    fun hJ hT hTJ => Sec6Gen.isSylow2In_of_mem_RSet_of_le h.thmD.hyp hJ hT hTJ
  have hJP : ∀ J ∈ Ω, J ≤ X → J ∈ P := fun J hJ hJX =>
    ⟨hJ, hJX.trans (pSpan_le fun M hM => hM.2)⟩
  have htw : ∀ L ∈ P, ∃ L', L' ≠ L ∧ twinSet Ω L = {L, L'} ∧ L' ∈ P := by
    intro L hL
    obtain ⟨L', hLL', hL'⟩ := h.twinSet_pair s hL.1
    exact ⟨L', hLL', hL', h.twinSet_subset_centMembers h9 ha s hR hR' hne L hL
      (by rw [hL']; exact Set.mem_insert_of_mem _ rfl)⟩
  have hpair : ∀ L' ∈ restrictFamily Ω X, ∃ L'' ∈ restrictFamily Ω X, L'' ≠ L' ∧
      omegaNbr (restrictFamily Ω X) L' = {L''} := by
    rintro _ ⟨L, hL, hLX, rfl⟩
    have hLP := hJP L hL hLX
    obtain ⟨L', hLL', htwin, hL'P⟩ := htw L hLP
    refine ⟨L'.subgroupOf X, subgroupOf_mem_restrictFamily hL'P.1 (le_pSpan hL'P),
      subgroupOf_ne_of_ne hLX (le_pSpan hL'P) hLL', ?_⟩
    ext J'
    constructor
    · intro hJ'
      obtain ⟨J, hJ, hJX, rfl⟩ := hJ'.1
      have hJn := omegaNbr_of_restrict hLX hJX hJ'
      rw [mem_omegaNbr_iff_of_perp9 h h9 hL, htwin] at hJn
      rcases hJn with ⟨h1 | h1, hJL⟩
      · exact absurd h1 hJL
      · rw [h1]
        exact Set.mem_singleton _
    · intro hJ'
      rw [Set.mem_singleton_iff] at hJ'
      rw [hJ']
      refine E187C.omegaNbr_subgroupOf_of hsyl hLX (le_pSpan hL'P) hL'P.1 ?_
      rw [mem_omegaNbr_iff_of_perp9 h h9 hL, htwin]
      exact ⟨Set.mem_insert_of_mem _ rfl, hLL'⟩
  have hmore : ∃ L ∈ restrictFamily Ω X, ∃ T ∈ restrictFamily Ω X, T ≠ L ∧
      T ∉ omegaNbr (restrictFamily Ω X) L := by
    obtain ⟨T₀, hT₀P, hT₀⟩ : ∃ T ∈ P, T ∉ ({R, R'} : Set (Subgroup G)) := by
      by_contra hcon
      push Not at hcon
      exact hne (Set.Subset.antisymm hcon (Set.insert_subset_iff.mpr
        ⟨hR, Set.singleton_subset_iff.mpr hR'⟩))
    refine ⟨R.subgroupOf X, subgroupOf_mem_restrictFamily hR.1 (le_pSpan hR),
      T₀.subgroupOf X, subgroupOf_mem_restrictFamily hT₀P.1 (le_pSpan hT₀P), ?_, ?_⟩
    · exact subgroupOf_ne_of_ne (le_pSpan hR) (le_pSpan hT₀P) fun e => hT₀ (Or.inl e)
    · intro hn
      have := omegaNbr_of_restrict (le_pSpan hR) (le_pSpan hT₀P) hn
      rw [mem_omegaNbr_iff_of_perp9 h h9 hR.1, s.twin] at this
      exact hT₀ this.1
  obtain ⟨hcard, hstar⟩ := ncard_eq_six_of_normal_wSet hPI hΦtwo hWΦ hWn hpair hmore
  refine ⟨?_, fun L hL T hT hTL => ?_⟩
  · have himg : restrictFamily Ω X = (fun L => L.subgroupOf X) '' P := by
      rw [← hΦeq]
      ext J'
      constructor
      · rintro ⟨J, hJ, hJX, rfl⟩
        exact ⟨J, hJ, rfl⟩
      · rintro ⟨J, hJ, rfl⟩
        exact ⟨J, hJ, le_pSpan hJ, rfl⟩
    rw [← hcard, himg]
    symm
    refine Set.InjOn.ncard_image fun L hL L' hL' he => ?_
    by_contra hLL'
    exact subgroupOf_ne_of_ne (le_pSpan hL') (le_pSpan hL) hLL' he
  · exact omegaStarNbr_of_restrict (le_pSpan hL) (le_pSpan hT)
      (hstar _ (subgroupOf_mem_restrictFamily hL.1 (le_pSpan hL)) _
        (subgroupOf_mem_restrictFamily hT.1 (le_pSpan hT))
        (subgroupOf_ne_of_ne (le_pSpan hL) (le_pSpan hT) hTL))

theorem exists_line_of_uniqueW_gen (h : EndHyp Ω) (h9 : Perp9 Ω) {a : G} (ha : a ≠ 1)
    {R R' : Subgroup G} {r : G} (s : TwinSit Ω R R' r) (hR : R ∈ centMembers Ω a)
    (hR' : R' ∈ centMembers Ω a) (hne : centMembers Ω a ≠ {R, R'})
    (hW : ∃ W₀ : Subgroup G, WIn (centMembers Ω a) (pSpan (centMembers Ω a)) = {W₀}) :
    ∃ b : G, (∃ T ∈ centMembers Ω a, IsUniqueInvolution T b) ∧ b ≠ r ∧
      b ∈ Subgroup.normalizer (R : Set G) ∧
      {x | ∃ L ∈ centMembers Ω a, IsUniqueInvolution L x} = {r, b, r * b} := by
  have hΩ := h.thmD.hyp
  obtain ⟨hcard, hstar⟩ := h.section_six_of_uniqueW h9 ha s hR hR' hne hW
  have hinv : ∀ L ∈ centMembers Ω a, ∀ x ∈ pSpan (centMembers Ω a),
      conjSub x L ∈ centMembers Ω a := fun L hL x hx =>
    h.toStarHyp.conjSub_mem_centMembers hL hx
  obtain ⟨T, hTP, hT⟩ : ∃ T ∈ centMembers Ω a, T ∉ ({R, R'} : Set (Subgroup G)) := by
    by_contra hcon
    push Not at hcon
    exact hne (Set.Subset.antisymm hcon (Set.insert_subset_iff.mpr
      ⟨hR, Set.singleton_subset_iff.mpr hR'⟩))
  have hTR : T ≠ R := fun e => hT (Or.inl e)
  have hstarT : T ∈ omegaStarNbr Ω R := hstar R hR T hTP hTR
  have hnotT : T ∉ omegaNbr Ω R := fun hn => by
    rw [mem_omegaNbr_iff_of_perp9 h h9 hR.1, s.twin] at hn
    exact hT hn.1
  obtain ⟨b, hb⟩ := Sec6Gen.exists_uniqueInvolution hΩ hTP.1
  have hbr : b ≠ r := by
    intro e
    have hTt : T ∈ twinSet Ω R := ⟨hTP.1, r, s.isInv, e ▸ hb⟩
    rw [s.twin] at hTt
    exact hT hTt
  obtain ⟨-, -, -, hV4, -, -⟩ := pair_structure h hR.1 hstarT hnotT
  have hbN : b ∈ Subgroup.normalizer (R : Set G) :=
    (hb.mem_of_le (inf_le_left : T ⊓ Subgroup.normalizer (R : Set G) ≤ T)
      ((h.thmD.two T hTP.1).to_le inf_le_left) (by omega)).2
  obtain ⟨τ, hτT, hτN⟩ : ∃ τ ∈ T, τ ∉ Subgroup.normalizer (R : Set G) := by
    by_contra hcon
    push Not at hcon
    exact hnotT ⟨hTP.1, hTR, T, TC.mem_RSet_of_isPGroup hTP.1 (h.thmD.two T hTP.1), le_rfl,
      hcon⟩
  have hτ := conj_involution_eq_mul h hR.1 hstarT hnotT s.isInv hb hτT hτN
  have hτP : conjSub τ R ∈ centMembers Ω a := hinv R hR τ (le_pSpan hTP hτT)
  have hRτ : IsUniqueInvolution (conjSub τ R) (r * b) := by
    have := s.isInv.conj τ
    rwa [hτ] at this
  have hcls : ∀ M ∈ centMembers Ω a,
      twinSet Ω M ⊆ centMembers Ω a ∧ (twinSet Ω M).ncard = 2 := by
    intro M hM
    refine ⟨h.twinSet_subset_centMembers h9 ha s hR hR' hne M hM, ?_⟩
    obtain ⟨M', hMM', hM'⟩ := h.twinSet_pair s hM.1
    rw [hM', Set.ncard_pair hMM'.symm]
  have hdisj : ∀ {M N : Subgroup G} {x y : G}, IsUniqueInvolution M x →
      IsUniqueInvolution N y → x ≠ y → Disjoint (twinSet Ω M) (twinSet Ω N) := by
    intro M N x y hx hy hxy
    refine Set.disjoint_left.mpr fun J hJM hJN => ?_
    obtain ⟨-, z₁, hz₁M, hz₁J⟩ := hJM
    obtain ⟨-, z₂, hz₂N, hz₂J⟩ := hJN
    exact hxy ((hx.eq hz₁M).trans ((hz₁J.eq hz₂J).trans (hz₂N.eq hy)))
  have hrb : r ≠ r * b := fun e =>
    hb.ne_one (mul_left_cancel (a := r) (by rw [mul_one]; exact e.symm))
  have hbrb : b ≠ r * b := fun e =>
    s.isInv.ne_one (mul_right_cancel (a := r) (b := b) (c := 1) (by rw [one_mul]; exact e.symm))
  refine ⟨b, ⟨T, hTP, hb⟩, hbr, hbN, ?_⟩
  ext x
  constructor
  · rintro ⟨L, hLP, hLx⟩
    by_contra hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] at hx
    obtain ⟨hxr, hxb, hxrb⟩ := hx
    obtain ⟨h1sub, h1c⟩ := hcls R hR
    obtain ⟨h2sub, h2c⟩ := hcls T hTP
    obtain ⟨h3sub, h3c⟩ := hcls _ hτP
    obtain ⟨h4sub, h4c⟩ := hcls L hLP
    have hd12 := hdisj s.isInv hb (Ne.symm hbr)
    have hd13 := hdisj s.isInv hRτ hrb
    have hd14 := hdisj s.isInv hLx (Ne.symm hxr)
    have hd23 := hdisj hb hRτ hbrb
    have hd24 := hdisj hb hLx (Ne.symm hxb)
    have hd34 := hdisj hRτ hLx (Ne.symm hxrb)
    have hsub : twinSet Ω R ∪ twinSet Ω T ∪ twinSet Ω (conjSub τ R) ∪ twinSet Ω L ⊆
        centMembers Ω a :=
      Set.union_subset (Set.union_subset (Set.union_subset h1sub h2sub) h3sub) h4sub
    have hc : (twinSet Ω R ∪ twinSet Ω T ∪ twinSet Ω (conjSub τ R) ∪ twinSet Ω L).ncard = 8 := by
      rw [Set.ncard_union_eq (Set.disjoint_union_left.mpr
          ⟨Set.disjoint_union_left.mpr ⟨hd14, hd24⟩, hd34⟩),
        Set.ncard_union_eq (Set.disjoint_union_left.mpr ⟨hd13, hd23⟩),
        Set.ncard_union_eq hd12, h1c, h2c, h3c, h4c]
    have := Set.ncard_le_ncard hsub (Set.toFinite _)
    omega
  · intro hx
    rcases hx with hx | hx | hx
    · exact ⟨R, hR, hx ▸ s.isInv⟩
    · exact ⟨T, hTP, hx ▸ hb⟩
    · exact ⟨conjSub τ R, hτP, hx ▸ hRτ⟩

end EndHyp

end CFSG.ClassicalInvolution.Q3.Sec13
