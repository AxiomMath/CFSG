variable {G : Type} [Group G] [Finite G]

theorem conjSub_eq_self_of_commute {Q : Type*} [Group Q] {g : Q} {B : Subgroup Q}
    (h : ∀ y ∈ B, g * y = y * g) : conjSub g B = B := by
  ext y
  rw [mem_conjSub_iff]
  constructor
  · intro hw
    have h1 : g * (g⁻¹ * y * g) = (g⁻¹ * y * g) * g := h _ hw
    have h2 : y * g = g⁻¹ * y * g * g := by rw [← h1]; group
    have e : g⁻¹ * y * g = y := (mul_right_cancel h2).symm
    rwa [e] at hw
  · intro hy
    have e : g⁻¹ * y * g = y := by
      calc g⁻¹ * y * g = g⁻¹ * (y * g) := by group
        _ = g⁻¹ * (g * y) := by rw [h y hy]
        _ = y := by group
    rwa [e]

