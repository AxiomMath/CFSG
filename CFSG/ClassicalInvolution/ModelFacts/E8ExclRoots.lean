@[expose] def iform7 (u v : Fin 7 → ℤ) : ℤ :=
  2 * (u 0 * v 0 + u 1 * v 1 + u 2 * v 2 + u 3 * v 3 + u 4 * v 4 + u 5 * v 5 + u 6 * v 6)
    - (u 0 * v 2 + u 2 * v 0) - (u 1 * v 3 + u 3 * v 1) - (u 2 * v 3 + u 3 * v 2)
    - (u 3 * v 4 + u 4 * v 3) - (u 4 * v 5 + u 5 * v 4) - (u 5 * v 6 + u 6 * v 5)

@[expose] def e7B : Fin (Tag.rank .E7) → Fin (Tag.rank .E7) → ℤ :=
  ![![2, 0, -1, 0, 0, 0, 0], ![0, 2, 0, -1, 0, 0, 0], ![-1, 0, 2, -1, 0, 0, 0],
    ![0, -1, -1, 2, -1, 0, 0], ![0, 0, 0, -1, 2, -1, 0], ![0, 0, 0, 0, -1, 2, -1],
    ![0, 0, 0, 0, 0, -1, 2]]

theorem symmetrizedCartan_E7' : ∀ p : Fin (Tag.rank .E7) × Fin (Tag.rank .E7),
    Tag.symmetrizedCartan Tag.E7 p.1 p.2 = e7B p.1 p.2 := by decide +kernel

theorem iform_eq_iform7 (u v : V7) : iform u v = iform7 u v := by
  have h : ∀ i j : Fin 7, Tag.symmetrizedCartan Tag.E7 i j = e7B i j := fun i j =>
    symmetrizedCartan_E7' (i, j)
  change ∑ i : Fin 7, ∑ j : Fin 7, u i * Tag.symmetrizedCartan Tag.E7 i j * v j = _
  simp only [h, Fin.sum_univ_seven, iform7, e7B]
  simp
  ring

@[expose] def vecOf (l : List ℤ) : Fin 7 → ℤ := fun i => l.getD i 0

