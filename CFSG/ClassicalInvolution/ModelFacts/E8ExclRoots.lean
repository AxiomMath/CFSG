@[expose] def rootListV : List V7 := rootList

theorem rootListV_toFinset : rootListV.toFinset = rootFinset .E7 := by decide +kernel

theorem mem_rootList_iff (v : V7) : v ∈ rootList ↔ IsRoot .E7 v := by
  have h : v ∈ rootListV ↔ IsRoot .E7 v := by
    rw [← mem_rootFinset, ← rootListV_toFinset, List.mem_toFinset]
  exact h

