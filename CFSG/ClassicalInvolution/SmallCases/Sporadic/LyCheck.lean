@[expose] def hexVal (c : UInt8) : Nat := if c < 58 then (c - 48).toNat else (c - 55).toNat

@[expose] def piMasks (_ : Unit) : Array Nat :=
  let b := piHex.toUTF8
  Array.ofFn (n := 2772) fun t =>
    hexVal (b.get! (3 * t.val)) * 256 + hexVal (b.get! (3 * t.val + 1)) * 16 +
      hexVal (b.get! (3 * t.val + 2))

@[expose] def tzOf (n : Nat) (L : Array Table) : Table := powT n 4 L[10]!

@[expose] def fixL (n : Nat) (T : Table) : List Nat := (List.range n).filter fun p => ap T p == p

@[expose] def zOK (Tz : Table) : Bool :=
  ap Tz 0 == 0 && chainQ.all fun q => ap Tz (ap Tz q) == q

@[expose] def conjImg (L : Array Table) (Tz : Table) (path : List Nat) (p : Nat) : Nat :=
  applyL L path (ap Tz (applyL L (invW path) p))

@[expose] def conjKey (L : Array Table) (Tz : Table) (path : List Nat) : Nat :=
  packL [conjImg L Tz path 3, conjImg L Tz path 1]

@[expose] def conjSearch (L : Array Table) (Tz : Table) (cap : Nat) : Array (List Nat) :=
  Id.run do
    let mut paths : Array (List Nat) := #[[]]
    let mut seen : Std.HashSet Nat := (∅ : Std.HashSet Nat).insert (conjKey L Tz [])
    let mut h := 0
    for _ in [0:cap] do
      if h < paths.size then
        let p := paths[h]!
        for l in [4, 5, 6, 7] do
          let q := l :: p
          let k := conjKey L Tz q
          if !seen.contains k then
            seen := seen.insert k
            paths := paths.push q
        h := h + 1
      else break
    return paths

@[expose] def conjOK (L : Array Table) (Tz : Table) (paths : Array (List Nat)) : Bool :=
  decide (paths.size = 406875) && paths.all (fun p => p.all fun l => decide (4 ≤ l ∧ l ≤ 7)) &&
    CFSG.Sporadic.Co1.InvNative.distinctKeys (paths.toList.map (conjKey L Tz))

@[expose] def kTabOf (n : Nat) (L : Array Table) (Tz : Table) (r : List Nat) (m : Nat) : Table :=
  powT n m (compT n Tz (compT n (listT n L r) (compT n Tz (listT n L (invW r)))))

@[expose] def tksOf (n : Nat) (L : Array Table) (Tz : Table) : Array Table :=
  (kRl.zip kMl).toArray.map fun rm => kTabOf n L Tz rm.1 rm.2

@[expose] def kOK (Tz : Table) (Tks : Array Table) : Bool :=
  Tks.size == 3 && Tks.all fun T =>
    chainQ.all fun q => ap T (ap T q) == q && ap Tz (ap T q) == ap T (ap Tz q)

@[expose] def tyOf (n : Nat) (Tks : Array Table) : Table :=
  compT n Tks[1]! (compT n Tks[0]! (compT n Tks[1]! (compT n Tks[0]! Tks[1]!)))

@[expose] def commOK (n : Nat) (Tz : Table) (Tks : Array Table) : Bool :=
  let Ty := tyOf n Tks
  chainQ.all fun q => ap Ty (ap Ty q) == q &&
    ap Tks[0]! (ap Ty (ap Tks[0]! (ap Ty q))) == ap Tz q

@[expose] def piOf (Fl masks : Array Nat) (p : Nat) : Nat :=
  masks[(Fl.findIdx? fun x => x == p).getD 0]!

@[expose] def eqvOK (Fl masks : Array Nat) (T : Table) (sig : List Nat) : Bool :=
  Fl.all fun p => (List.range 11).all fun b =>
    (piOf Fl masks (ap T p)).testBit (sig.getD b 0) == (piOf Fl masks p).testBit b

@[expose] def predB1 (i b : Nat) : Bool := decide ((b + 11 - i) % 11 < 5)

@[expose] def predB2 (i b : Nat) : Bool :=
  b == i || decide (5 ≤ (b + 11 - i) % 11 ∧ (b + 11 - i) % 11 < 9)

@[expose] def witOK (Fl masks : Array Nat) : Bool :=
  (List.range 11).all fun i =>
    (Fl.any fun p => (List.range 11).all fun b => (piOf Fl masks p).testBit b == predB1 i b) &&
      (Fl.any fun p => (List.range 11).all fun b => (piOf Fl masks p).testBit b == predB2 i b)

@[expose] def tsOf (n : Nat) (Tks : Array Table) : Array Table :=
  sWl.toArray.map fun w => listT n Tks w

@[expose] def sKey (Ts : Array Table) (path : List Nat) : Nat :=
  packL (chainQ.toList.map fun q => applyL Ts path q)

@[expose] def sSearch (Ts : Array Table) (cap : Nat) : Array (List Nat) := Id.run do
  let mut paths : Array (List Nat) := #[[]]
  let mut seen : Std.HashSet Nat := (∅ : Std.HashSet Nat).insert (sKey Ts [])
  let mut h := 0
  for _ in [0:cap] do
    if h < paths.size then
      let p := paths[h]!
      for g in [0, 1, 2] do
        let q := p ++ [g]
        let k := sKey Ts q
        if !seen.contains k then
          seen := seen.insert k
          paths := paths.push q
      h := h + 1
    else break
  return paths

@[expose] def sOK (Ts : Array Table) (paths : Array (List Nat)) : Bool :=
  let keys := paths.toList.map (sKey Ts)
  decide (paths.size = 256) && paths[0]! == [] && Ts.size == 3 &&
    paths.all (fun p => p.all fun g => decide (g < 3)) &&
    CFSG.Sporadic.Co1.InvNative.distinctKeys keys &&
    paths.all fun p => [0, 1, 2].all fun g => keys.contains (sKey Ts (p ++ [g]))

@[expose] def isInvolP (Ts : Array Table) (p : List Nat) : Bool :=
  chainQ.all (fun q => applyL Ts (p ++ p) q == q) && !(chainQ.all fun q => applyL Ts p q == q)

@[expose] def dMap (L : Array Table) (Tz : Table) (Ts : Array Table) (pj r : List Nat)
    (p : Nat) : Nat :=
  applyL L r (ap Tz (applyL L (invW r) (applyL Ts pj p)))

@[expose] def iterD (d : Nat → Nat) : Nat → Nat → Nat
  | 0, p => p
  | m + 1, p => iterD d m (d p)

@[expose] def coverEq (L : Array Table) (Tz : Table) (Ts : Array Table) (pj r : List Nat)
    (m : Nat) : Bool :=
  chainQ.all fun q =>
    applyL Ts pj (iterD (dMap L Tz Ts pj r) m (applyL L r q)) ==
      iterD (dMap L Tz Ts pj r) m (applyL L r (ap Tz q))

@[expose] def lcg (s : Nat) : Nat := (s * 6364136223846793005 + 1442695040888963407) % 2 ^ 64

@[expose] def randWord : Nat → Nat → List Nat × Nat
  | 0, s => ([], s)
  | len + 1, s =>
    let s' := lcg s
    let rest := randWord len s'
    (((s' / 65536) % 12) :: rest.1, rest.2)

@[expose] def ordD (d : Nat → Nat) (bound : Nat) : Nat := Id.run do
  let mut cur := chainQ.toList
  for k in [1:bound + 1] do
    cur := cur.map d
    if cur == chainQ.toList then return k
  return 0

@[expose] def coverFor (L : Array Table) (Tz : Table) (Ts : Array Table) (pj : List Nat)
    (seed : Nat) : List Nat × Nat := Id.run do
  let mut s := seed
  for _ in [0:600] do
    let (r, s') := randWord 10 s
    s := s'
    let o := ordD (dMap L Tz Ts pj r) 150
    if o % 2 == 1 then
      if coverEq L Tz Ts pj r ((o - 1) / 2) then return (r, (o - 1) / 2)
  return ([], 0)

@[expose] def coverSearch (L : Array Table) (Tz : Table) (Ts : Array Table)
    (paths : Array (List Nat)) : Array (List Nat × Nat) :=
  (List.range paths.size).toArray.map fun j =>
    if isInvolP Ts paths[j]! then coverFor L Tz Ts paths[j]! (12345 + 7919 * j) else ([], 0)

@[expose] def coverOK (L : Array Table) (Tz : Table) (Ts : Array Table) (paths : Array (List Nat))
    (cov : Array (List Nat × Nat)) : Bool :=
  (List.range paths.size).all fun j =>
    !isInvolP Ts paths[j]! ||
      ((cov[j]!).1.all (fun l => decide (l < 12)) && coverEq L Tz Ts paths[j]! cov[j]!.1 cov[j]!.2)

@[expose] def lyCheckAt (L : Array Table) : Bool :=
  let Tz := tzOf 8835156 L
  let Fl := (fixL 8835156 Tz).toArray
  let masks := piMasks ()
  let Tks := tksOf 8835156 L Tz
  let Ts := tsOf 8835156 Tks
  let cp := conjSearch L Tz 500000
  let sp := sSearch Ts 300
  let cov := coverSearch L Tz Ts sp
  decide (L.size = 12) && zOK Tz && decide (Fl.size ≤ 2772) && decide (masks.size = 2772) &&
    conjOK L Tz cp && kOK Tz Tks && commOK 8835156 Tz Tks &&
    (List.range 3).all (fun i => eqvOK Fl masks Tks[i]! (sigArr.getD i [])) &&
    witOK Fl masks && sOK Ts sp && coverOK L Tz Ts sp cov

end LyProof

