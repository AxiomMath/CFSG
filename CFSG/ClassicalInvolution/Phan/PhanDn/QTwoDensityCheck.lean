@[expose] def witOK (k w : Nat) : Bool := orthOK (ofCode w) (ofCode k) && ptOK (ofCode w)

@[expose] def witGo : Nat → List Nat → Bool
  | _, [] => true
  | k, w :: ws => witOK k w && witGo (k + 1) ws

@[expose] def densityCheck : Bool := densityWit.length == 4096 && witGo 0 densityWit

theorem densityCheck_eq_true : densityCheck = true := by decide +kernel

theorem witGo_spec : ∀ (ws : List Nat) (k : Nat), witGo k ws = true →
    ∀ j < ws.length, witOK (k + j) (ws.getD j 0) = true
  | [], _, _, j, hj => absurd hj (by simp)
  | w :: ws, k, h, j, hj => by
    simp only [witGo, Bool.and_eq_true] at h
    cases j with
    | zero => simpa using h.1
    | succ j =>
      have := witGo_spec ws (k + 1) h.2 j (by simpa using hj)
      simpa [Nat.add_assoc, Nat.add_comm 1 j] using this

theorem density_spec (F : V6) :
    ∃ u : V6, qC u = 0 ∧ hC u u = 1 ∧ pC u F = 0 ∧ hC u F = 0 := by
  have h := densityCheck_eq_true
  simp only [densityCheck, Bool.and_eq_true, beq_iff_eq] at h
  have hk : code F < densityWit.length := by
    obtain ⟨⟨a0, h0⟩, ⟨a1, h1⟩, ⟨a2, h2⟩, ⟨b0, h3⟩, ⟨b1, h4⟩, ⟨b2, h5⟩⟩ := F
    rw [h.1]
    simp only [code]
    omega
  have hw := witGo_spec densityWit 0 h.2 (code F) hk
  simp only [Nat.zero_add, witOK, orthOK, ptOK, Bool.and_eq_true, beq_iff_eq, ofCode_code] at hw
  exact ⟨_, hw.2.1, hw.2.2, hw.1.1, hw.1.2⟩

end CFSG.ClassicalInvolution.PhanDn.QTwoGammaThree
