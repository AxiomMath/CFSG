@[expose] def fAdd (a b : Fin 4) : Fin 4 := ⟨(a.val ^^^ b.val) % 4, Nat.mod_lt _ (by omega)⟩

@[expose] def fMul (a b : Fin 4) : Fin 4 :=
  ⟨(a.val % 2 * (b.val % 2) + a.val / 2 * (b.val / 2)) % 2 +
    2 * ((a.val % 2 * (b.val / 2) + a.val / 2 * (b.val % 2) + a.val / 2 * (b.val / 2)) % 2),
    by omega⟩

structure V6 where
  x0 : Fin 4
  x1 : Fin 4
  x2 : Fin 4
  y0 : Fin 4
  y1 : Fin 4
  y2 : Fin 4
  deriving DecidableEq

@[expose] def qC (v : V6) : Fin 4 := fAdd (fAdd (fMul v.x0 v.y0) (fMul v.x1 v.y1)) (fMul v.x2 v.y2)

@[expose] def pC (u v : V6) : Fin 4 :=
  fAdd (fAdd (fAdd (fMul u.x0 v.y0) (fMul v.x0 u.y0)) (fAdd (fMul u.x1 v.y1) (fMul v.x1 u.y1)))
    (fAdd (fMul u.x2 v.y2) (fMul v.x2 u.y2))

@[expose] def hC (u v : V6) : Fin 4 :=
  fAdd (fAdd (fAdd (fMul u.x0 (fMul v.x0 v.x0)) (fMul u.y0 (fMul v.y0 v.y0)))
      (fAdd (fMul u.x1 (fMul v.x1 v.x1)) (fMul u.y1 (fMul v.y1 v.y1))))
    (fAdd (fMul u.x2 (fMul v.x2 v.x2)) (fMul u.y2 (fMul v.y2 v.y2)))

@[expose] def smulC (c : Fin 4) (v : V6) : V6 :=
  ⟨fMul c v.x0, fMul c v.x1, fMul c v.x2, fMul c v.y0, fMul c v.y1, fMul c v.y2⟩

@[expose] def addC (u v : V6) : V6 :=
  ⟨fAdd u.x0 v.x0, fAdd u.x1 v.x1, fAdd u.x2 v.x2, fAdd u.y0 v.y0, fAdd u.y1 v.y1, fAdd u.y2 v.y2⟩

@[expose] def code (v : V6) : Nat :=
  v.x0.val + 4 * v.x1.val + 16 * v.x2.val + 64 * v.y0.val + 256 * v.y1.val + 1024 * v.y2.val

@[expose] def ofCode (k : Nat) : V6 :=
  ⟨⟨k % 4, by omega⟩, ⟨k / 4 % 4, by omega⟩, ⟨k / 16 % 4, by omega⟩, ⟨k / 64 % 4, by omega⟩,
    ⟨k / 256 % 4, by omega⟩, ⟨k / 1024 % 4, by omega⟩⟩

theorem ofCode_code (v : V6) : ofCode (code v) = v := by
  obtain ⟨⟨a0, h0⟩, ⟨a1, h1⟩, ⟨a2, h2⟩, ⟨b0, h3⟩, ⟨b1, h4⟩, ⟨b2, h5⟩⟩ := v
  simp only [ofCode, code, V6.mk.injEq, Fin.mk.injEq]
  omega

