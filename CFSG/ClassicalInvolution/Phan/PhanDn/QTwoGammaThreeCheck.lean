@[expose] def pt (i : Nat) : V6 := ofCode (pts.getD i 0)

@[expose] def ptOK (v : V6) : Bool := qC v == 0 && hC v v == 1

@[expose] def orthOK (a b : V6) : Bool := pC a b == 0 && hC a b == 0

@[expose] def expandOK (v a b c : V6) : Bool :=
  addC (addC (smulC (hC v a) a) (smulC (hC v b) b)) (smulC (hC v c) c) == v

@[expose] def treeOK (i : Nat) (e : Nat × Nat × Nat × Nat) : Bool :=
  decide (e.1 < i) && ptOK (pt e.2.1) && ptOK (pt e.2.2.1) && ptOK (pt e.2.2.2) &&
    orthOK (pt e.2.1) (pt e.2.2.1) && orthOK (pt e.2.1) (pt e.2.2.2) &&
    orthOK (pt e.2.2.1) (pt e.2.2.2) &&
    expandOK (pt i) (pt e.2.1) (pt e.2.2.1) (pt e.2.2.2) &&
    expandOK (pt e.1) (pt e.2.1) (pt e.2.2.1) (pt e.2.2.2)

@[expose] def ptsCheck : Bool := (List.range 240).all fun i => ptOK (pt i)

@[expose] def treeCheck : Bool :=
  (List.range 239).all fun k => treeOK (k + 1) (tree.getD k (0, 0, 0, 0))

@[expose] def f4s : List (Fin 4) := [0, 1, 2, 3]

@[expose] def coverOK (v : V6) : Bool :=
  !(qC v == 0 && hC v v != 0) || pts.elem (code v) || pts.elem (code (smulC 2 v)) ||
    pts.elem (code (smulC 3 v))

@[expose] def coverCheck : Bool :=
  f4s.all fun a0 => f4s.all fun a1 => f4s.all fun a2 => f4s.all fun b0 => f4s.all fun b1 =>
    f4s.all fun b2 => coverOK ⟨a0, a1, a2, b0, b1, b2⟩

theorem ptsCheck_eq_true : ptsCheck = true := by decide +kernel

theorem treeCheck_eq_true : treeCheck = true := by decide +kernel

theorem coverCheck_eq_true : coverCheck = true := by decide +kernel

