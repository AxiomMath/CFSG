theorem patternLemma_E6 : PatternLemma ((CartanMatrix.E 6).transpose) := by
  intro v hv
  have hvec : v = ![v 0, v 1, v 2, v 3, v 4, v 5] := by
    funext i; fin_cases i <;> rfl
  have hnz : ¬ (v 0 = 0 ∧ v 1 = 0 ∧ v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0 ∧ v 5 = 0) := by
    rintro ⟨h0, h1, h2, h3, h4, h5⟩
