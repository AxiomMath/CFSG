namespace CFSG.ClassicalInvolution.RouteD

open TauCeti

private def entZ {n : ℕ} (M : Matrix (Fin n) (Fin n) ℤ) : Fin n → Fin n → ZMod 2 :=
  fun i j => ((M i j : ℤ) : ZMod 2)

private def reflW {n : ℕ} (a : Fin n → Fin n → ZMod 2) (l : List (Fin n))
    (v : Fin n → ZMod 2) : Fin n → ZMod 2 :=
  l.foldl (fun v i j => v j + a i j * v i) v

private theorem charReach_reflW {n : ℕ} (M : Matrix (Fin n) (Fin n) ℤ) (l : List (Fin n)) :
    ∀ v : Fin n → ZMod 2, CharReach M v (reflW (entZ M) l v) := by
  induction l with
  | nil => intro v; exact CharReach.refl' _ _
  | cons i l ih =>
    intro v
    exact (CharReach.single' (A := M) i v).trans' (ih _)

