  rw [entZ_E6] at hreach
  exact ⟨_, hreach, j, (congrArg (reflW aE6 ((tableE6).getD (1 * (v 0).val + 2 * (v 1).val + 4 * (v 2).val + 8 * (v 3).val + 16 * (v 4).val + 32 * (v 5).val - 1) [])) hvec).trans hj⟩

