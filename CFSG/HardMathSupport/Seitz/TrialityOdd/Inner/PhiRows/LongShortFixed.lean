section Range


theorem g2RootSL2_coe {L : Type} [Field L] (i : Fin (Tag.rank .G2))
    (M : Matrix.SpecialLinearGroup (Fin 2) L) :
    ((g2RootSL2 i L M : adjointGroup Tag.G2 L) : ModGL Tag.G2 L) =
      simpleRootSL2 Tag.G2 L i M := rfl

theorem range_g2RootSL2_coe {L : Type} [Field L] (i : Fin (Tag.rank .G2)) :
    ((g2RootSL2 i L).range.map (adjointGroup Tag.G2 L).subtype) =
      rootPair Tag.G2 L (Pi.single i 1) := by
  rw [← range_simpleRootSL2_eq_rootPair]
  ext x
  constructor
  · rintro ⟨y, ⟨M, rfl⟩, rfl⟩
    exact ⟨M, rfl⟩
  · rintro ⟨M, rfl⟩
    exact ⟨g2RootSL2 i L M, ⟨M, rfl⟩, rfl⟩

end Range

section ShortGen


variable {K : Type} [Field K] {σ : K ≃+* K}
  (hσ : ∀ c, σ.toRingHom (σ.toRingHom (σ.toRingHom c)) = c)

@[expose] def LongShortFixedGen : Prop :=
  ∀ H : Subgroup (twistedGroup σ.toRingHom),
    longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H →
    (d4X hσ 2 (1 : K) ∈ H ∨ d4X hσ 4 (1 : K) ∈ H) →
    ∀ M : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ),
      slShort σ.toRingHom hσ
        (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) ∈ H

theorem slLong_range_le_longSub :
    (slLong σ.toRingHom hσ).range ≤ longSub 6 (hexGroup (twistedX σ.toRingHom)) := by
  rw [← CFSG.ClassicalInvolution.ModelFacts.rankOne_long_eq_range (σ := σ.toRingHom) hσ]
  refine sup_le ?_ ?_
  · rw [show twistedRootGroup σ.toRingHom (Pi.single (ng 0) 1) =
        hexGroup (twistedX σ.toRingHom) 6 by
      rw [hexGroup, hexPos_six_eq_single]
      rfl]
    exact root_le_longSub ⟨by norm_num, by norm_num⟩ (by norm_num)
  · rw [show twistedRootGroup σ.toRingHom (-Pi.single (ng 0) 1) =
        hexGroup (twistedX σ.toRingHom) (-6) by
      rw [hexGroup, hexPos_neg_six_eq_single]
      rfl]
    exact root_le_longSub ⟨by norm_num, by norm_num⟩ (by norm_num)

end ShortGen


section Entrywise


variable {K : Type} [Field K] {σ : K ≃+* K}
  (hσ : ∀ c, σ.toRingHom (σ.toRingHom (σ.toRingHom c)) = c)

theorem entrywise_xOrbit_fixed {γ : Fin d4.rank → ℤ} {c : K} (hc : σ c = c) :
    entrywiseAdjointAut TwistTag.D4.tag σ (xOrbit σ.toRingHom γ c) = xOrbit σ.toRingHom γ c := by
  have hc' : σ.toRingHom c = c := hc
  have hc2 : σ.toRingHom (σ.toRingHom c) = c := by rw [hc', hc']
  have hc3 : σ.toRingHom (σ.toRingHom (σ.toRingHom c)) = c := by rw [hc2, hc']
  have hsign1 : σ (twistSign σ.toRingHom γ) = twistSign σ.toRingHom γ :=
    map_sign (σ := σ.toRingHom) (twistSign_eq_one_or σ.toRingHom γ)
  have hsign2 : σ (twistSign σ.toRingHom (rho γ)) = twistSign σ.toRingHom (rho γ) :=
    map_sign (σ := σ.toRingHom) (twistSign_eq_one_or σ.toRingHom (rho γ))
  rw [xOrbit, map_mul, map_mul, entrywiseAdjointAut_xPar, entrywiseAdjointAut_xPar,
    entrywiseAdjointAut_xPar]
  simp only [map_mul, hsign1, hsign2, hc, hc', hc2, hc3]

end Entrywise

section Main


variable {K : Type} [Field K] [Finite K] {σ : K ≃+* K}
  (hσ : ∀ c, σ.toRingHom (σ.toRingHom (σ.toRingHom c)) = c)

include hσ

theorem r2_mem_longSub :
    nHat σ.toRingHom (ng 0) ∈ longSub 6 (hexGroup (twistedX σ.toRingHom)) :=
  slLong_range_le_longSub hσ
    (CFSG.ClassicalInvolution.ModelFacts.rankOne_long_le_range_slLong σ.toRingHom hσ
      (nHat_mem_rankOne σ.toRingHom (ng 0)))

theorem r1_mem_N : nHat σ.toRingHom (ng 1) ∈ (d4RGD2 σ.toRingHom hσ).N :=
  Subgroup.subset_closure (Or.inr (Or.inl rfl))

theorem r1_normalizes_longSub :
    nHat σ.toRingHom (ng 1) ∈ Subgroup.normalizer
      (longSub 6 (hexGroup (twistedX σ.toRingHom)) : Set (twistedGroup σ.toRingHom)) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    exact conj_mem_longSub (n := 6) (by norm_num) (by norm_num)
      ((d4RGD2 σ.toRingHom hσ).goodActEven_of_mem_N (by norm_num) (r1_mem_N hσ)) hx
  · intro hx
    have h := conj_mem_longSub (n := 6) (by norm_num) (by norm_num)
      ((d4RGD2 σ.toRingHom hσ).goodActEven_of_mem_N (by norm_num) (r1_mem_N hσ)).inv hx
    rwa [show (nHat σ.toRingHom (ng 1))⁻¹ * ((nHat σ.toRingHom (ng 1)) * x *
      (nHat σ.toRingHom (ng 1))⁻¹) * ((nHat σ.toRingHom (ng 1))⁻¹)⁻¹ = x by group] at h

theorem nprime_mem_longSub :
    nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) * (nHat σ.toRingHom (ng 1))⁻¹ ∈
      longSub 6 (hexGroup (twistedX σ.toRingHom)) :=
  (Subgroup.mem_normalizer_iff.1 (r1_normalizes_longSub hσ) _).1 (r2_mem_longSub hσ)

theorem twistedIncl_d43X (i : Fin 6) (c : d43Par σ.toRingHom i) :
    twistedIncl σ.toRingHom (d43X hσ i c) =
      (d43XE σ.toRingHom i c : adjointGroup d4 K) := rfl

theorem d43X_two_mem_FixedSub {c : K} (hc : σ c = c) :
    d43X hσ 2 (show d43Par σ.toRingHom 2 from c) ∈ FixedSub σ := by
  rw [mem_FixedSub]
  rw [twistedIncl_d43X]
  rw [d43XE_two]
  exact congrArg Subtype.val
    (entrywise_xOrbit_fixed (γ := CFSG.LieType.Steinberg.TwistedD4.d4Root 15) hc)

theorem d43X_four_mem_FixedSub {c : K} (hc : σ c = c) :
    d43X hσ 4 (show d43Par σ.toRingHom 4 from c) ∈ FixedSub σ := by
  rw [mem_FixedSub]
  rw [twistedIncl_d43X]
  rw [d43XE_four]
  exact congrArg Subtype.val
    (entrywise_xOrbit_fixed (γ := CFSG.LieType.Steinberg.TwistedD4.d4Root 5) hc)

theorem r1_conj_root3 :
    conjBy (nHat σ.toRingHom (ng 1)) (hexGroup (twistedX σ.toRingHom) 3) =
      hexGroup (twistedX σ.toRingHom) 5 := by
  let R := d4RGD2 σ.toRingHom hσ
  exact R.conjBy_r₁ (⟨by norm_num, by norm_num⟩ : IsRoot 6 5)
    (R.act₁.2.2 3 (by norm_num) (by norm_num)).1

theorem nprime_inv_conj_root3 :
    conjBy (nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) *
        (nHat σ.toRingHom (ng 1))⁻¹)⁻¹
      (hexGroup (twistedX σ.toRingHom) 3) = hexGroup (twistedX σ.toRingHom) (-1) := by
  let R := d4RGD2 σ.toRingHom hσ
  have h1 : conjBy (nHat σ.toRingHom (ng 1)) (hexGroup (twistedX σ.toRingHom) 3) =
      hexGroup (twistedX σ.toRingHom) 5 :=
    R.conjBy_r₁ (⟨by norm_num, by norm_num⟩ : IsRoot 6 5)
      (R.act₁.2.2 3 (by norm_num) (by norm_num)).1
  have h2 : conjBy (nHat σ.toRingHom (ng 0))⁻¹ (hexGroup (twistedX σ.toRingHom) 5) =
      hexGroup (twistedX σ.toRingHom) 1 :=
    (R.act₂.2.2 5 (by norm_num) (by norm_num)).1
  have h3 : conjBy (nHat σ.toRingHom (ng 1))⁻¹ (hexGroup (twistedX σ.toRingHom) 1) =
      hexGroup (twistedX σ.toRingHom) (-1) := R.act₁.1
  rw [show (nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) *
      (nHat σ.toRingHom (ng 1))⁻¹)⁻¹ =
      nHat σ.toRingHom (ng 1) * (nHat σ.toRingHom (ng 0))⁻¹ *
        (nHat σ.toRingHom (ng 1))⁻¹ by group]
  rw [conjBy_mul, conjBy_mul, h1, h2, h3]

theorem nprime_conj_root3 {x : twistedGroup σ.toRingHom}
    (hx : x ∈ hexGroup (twistedX σ.toRingHom) 3) :
    nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) * (nHat σ.toRingHom (ng 1))⁻¹ *
        x * (nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) *
          (nHat σ.toRingHom (ng 1))⁻¹)⁻¹ ∈ hexGroup (twistedX σ.toRingHom) (-1) := by
  let n' := nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) *
    (nHat σ.toRingHom (ng 1))⁻¹
  have h : conjBy n'⁻¹ (hexGroup (twistedX σ.toRingHom) 3) =
      hexGroup (twistedX σ.toRingHom) (-1) := nprime_inv_conj_root3 hσ
  have h' : conjBy n' (hexGroup (twistedX σ.toRingHom) (-1)) =
      hexGroup (twistedX σ.toRingHom) 3 := by
    ext y
    rw [mem_conjBy_iff]
    have hiff : ∀ z, n'⁻¹ * z * n'⁻¹⁻¹ ∈ hexGroup (twistedX σ.toRingHom) 3 ↔
        z ∈ hexGroup (twistedX σ.toRingHom) (-1) := by
      intro z
      rw [← h, mem_conjBy_iff]
    have := hiff (n' * y * n'⁻¹)
    rw [show n'⁻¹ * (n' * y * n'⁻¹) * n'⁻¹⁻¹ = y by group] at this
    exact this.symm
  have hmem : x ∈ conjBy n' (hexGroup (twistedX σ.toRingHom) (-1)) := by
    rw [h']
    exact hx
  exact mem_conjBy_iff.1 hmem

theorem r2_conj_root5 {y : twistedGroup σ.toRingHom}
    (hy : y ∈ hexGroup (twistedX σ.toRingHom) 5) :
    nHat σ.toRingHom (ng 0) * y * (nHat σ.toRingHom (ng 0))⁻¹ ∈
      hexGroup (twistedX σ.toRingHom) 1 := by
  have h := (d4RGD2 σ.toRingHom hσ).actsPos_r₂ 4 y (by simpa [Rt6_small.2.2.2.2.1] using hy)
  change nHat σ.toRingHom (ng 0) * y * (nHat σ.toRingHom (ng 0))⁻¹ ∈
    hexGroup (twistedX σ.toRingHom) (Rt 6 0) at h
  rw [show Rt 6 0 = 1 from Rt6_small.1] at h
  exact h

theorem d43XE_four_entrywise (c : K) :
    entrywiseAdjointAut TwistTag.D4.tag σ
      (xOrbit σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) c) =
      xOrbit σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) (σ c) := by
  have hsign1 : σ (twistSign σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5)) =
      twistSign σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) :=
    map_sign (σ := σ.toRingHom)
      (twistSign_eq_one_or σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5))
  have hsign2 : σ (twistSign σ.toRingHom
      (rho (CFSG.LieType.Steinberg.TwistedD4.d4Root 5))) =
      twistSign σ.toRingHom (rho (CFSG.LieType.Steinberg.TwistedD4.d4Root 5)) :=
    map_sign (σ := σ.toRingHom)
      (twistSign_eq_one_or σ.toRingHom (rho (CFSG.LieType.Steinberg.TwistedD4.d4Root 5)))
  have hcomp : ∀ x : K, σ (σ.toRingHom x) = σ.toRingHom (σ x) := fun x => rfl
  rw [xOrbit, xOrbit, map_mul, map_mul, entrywiseAdjointAut_xPar, entrywiseAdjointAut_xPar,
    entrywiseAdjointAut_xPar]
  simp only [map_mul, hsign1, hsign2, hcomp, hσ]

theorem d43X_four_mem_FixedSub_iff {c : K} :
    d43X hσ 4 (show d43Par σ.toRingHom 4 from c) ∈ FixedSub σ ↔ σ c = c := by
  constructor
  · intro hmem
    rw [mem_FixedSub, twistedIncl_d43X, d43XE_four] at hmem
    have hmem' : entrywiseAdjointAut TwistTag.D4.tag σ
        (xOrbit σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) c) =
        xOrbit σ.toRingHom (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) c :=
      Subtype.ext hmem
    rw [d43XE_four_entrywise (hσ := hσ)] at hmem'
    have hγ : IsRoot d4 (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) :=
      CFSG.LieType.Steinberg.TwistedD4.isRoot_d4Root (by decide)
    have hne : rho (CFSG.LieType.Steinberg.TwistedD4.d4Root 5) ≠
        CFSG.LieType.Steinberg.TwistedD4.d4Root 5 := by decide +kernel
    exact CFSG.LieType.Steinberg.TwistedD4.xOrbit_injective σ.toRingHom hγ hne hmem'
  · exact d43X_four_mem_FixedSub hσ

theorem map_sl2Upper (c : K) :
    Matrix.SpecialLinearGroup.map σ.toRingHom (sl2Upper c) = sl2Upper (σ.toRingHom c) := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.map_apply_coe]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [LieType.Steinberg.sl2Upper]

theorem map_sl2Lower (c : K) :
    Matrix.SpecialLinearGroup.map σ.toRingHom (sl2Lower c) = sl2Lower (σ.toRingHom c) := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.map_apply_coe]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [LieType.Steinberg.sl2Lower]

theorem sl2Upper_entry (x : K) :
    ((sl2Upper x : Matrix (Fin 2) (Fin 2) K) 0 1) = x := rfl

theorem sl2Lower_entry (x : K) :
    ((sl2Lower x : Matrix (Fin 2) (Fin 2) K) 1 0) = x := rfl

theorem slShort_upper_mem_FixedSub_iff {c : K} :
    slShort σ.toRingHom hσ (sl2Upper c) ∈ FixedSub σ ↔ σ c = c := by
  constructor
  · intro hmem
    rw [mem_FixedSub] at hmem
    have hentry := slShort_entrywise (σ := σ.toRingHom) hσ σ (fun c => rfl) (sl2Upper c)
    rw [map_sl2Upper hσ c] at hentry
    have h : slShort σ.toRingHom hσ (sl2Upper (σ c)) =
        slShort σ.toRingHom hσ (sl2Upper c) :=
      twistedIncl_injective σ.toRingHom (hentry.symm.trans hmem)
    have h2 : sl2Upper (σ c) = sl2Upper c := slShort_injective hσ h
    have h3 := congrArg
      (fun M : Matrix.SpecialLinearGroup (Fin 2) K =>
        (M : Matrix (Fin 2) (Fin 2) K) 0 1) h2
    simpa [sl2Upper_entry hσ] using h3
  · intro hc
    refine slShort_mem_FixedSub σ hσ (sl2Upper c) ?_
    change Matrix.SpecialLinearGroup.map σ.toRingHom (sl2Upper c) = sl2Upper c
    have hc' : σ.toRingHom c = c := hc
    rw [map_sl2Upper hσ c, hc']

theorem slShort_lower_mem_FixedSub_iff {c : K} :
    slShort σ.toRingHom hσ (sl2Lower c) ∈ FixedSub σ ↔ σ c = c := by
  constructor
  · intro hmem
    rw [mem_FixedSub] at hmem
    have hentry := slShort_entrywise (σ := σ.toRingHom) hσ σ (fun c => rfl) (sl2Lower c)
    rw [map_sl2Lower hσ c] at hentry
    have h : slShort σ.toRingHom hσ (sl2Lower (σ c)) =
        slShort σ.toRingHom hσ (sl2Lower c) :=
      twistedIncl_injective σ.toRingHom (hentry.symm.trans hmem)
    have h2 : sl2Lower (σ c) = sl2Lower c := slShort_injective hσ h
    have h3 := congrArg
      (fun M : Matrix.SpecialLinearGroup (Fin 2) K =>
        (M : Matrix (Fin 2) (Fin 2) K) 1 0) h2
    simpa [sl2Lower_entry hσ] using h3
  · intro hc
    refine slShort_mem_FixedSub σ hσ (sl2Lower c) ?_
    change Matrix.SpecialLinearGroup.map σ.toRingHom (sl2Lower c) = sl2Lower c
    have hc' : σ.toRingHom c = c := hc
    rw [map_sl2Lower hσ c, hc']

theorem exists_upper_of_root5 {H : Subgroup (twistedGroup σ.toRingHom)}
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H)
    {y : twistedGroup σ.toRingHom} (hyH : y ∈ H) (hyJ : y ∈ FixedSub σ)
    (hy5 : y ∈ hexGroup (twistedX σ.toRingHom) 5) (hy1 : y ≠ 1) :
    ∃ c : K, σ c = c ∧ c ≠ 0 ∧ slShort σ.toRingHom hσ (sl2Upper c) ∈ H := by
  let r₂ := nHat σ.toRingHom (ng 0)
  have hr2H : r₂ ∈ H := hL (r2_mem_longSub hσ)
  have hr2J : r₂ ∈ FixedSub σ := nHat_zero_mem_FixedSub σ hσ
  have hy'H : r₂ * y * r₂⁻¹ ∈ H := H.mul_mem (H.mul_mem hr2H hyH) (H.inv_mem hr2H)
  have hy'J : r₂ * y * r₂⁻¹ ∈ FixedSub σ :=
    (FixedSub σ).mul_mem ((FixedSub σ).mul_mem hr2J hyJ) ((FixedSub σ).inv_mem hr2J)
  have hy'1 : r₂ * y * r₂⁻¹ ≠ 1 := by
    intro h
    apply hy1
    have := congrArg (fun z => r₂⁻¹ * z * r₂) h
    rwa [show r₂⁻¹ * (r₂ * y * r₂⁻¹) * r₂ = y by group,
      show r₂⁻¹ * 1 * r₂ = 1 by group] at this
  have hy'root : r₂ * y * r₂⁻¹ ∈ hexGroup (twistedX σ.toRingHom) 1 :=
    r2_conj_root5 hσ hy5
  obtain ⟨c, hc⟩ := (mem_hexGroup_iff' hσ 0 (by norm_num) (y := r₂ * y * r₂⁻¹)).1 hy'root
  have hc' : slShort σ.toRingHom hσ (sl2Upper c) = r₂ * y * r₂⁻¹ := by
    rw [← d4X_zero_eq hσ c]
    exact hc
  have hcJ : slShort σ.toRingHom hσ (sl2Upper c) ∈ FixedSub σ := by
    rw [hc']
    exact hy'J
  have hcF : σ c = c := (slShort_upper_mem_FixedSub_iff hσ).1 hcJ
  have hc0 : c ≠ 0 := by
    intro h0
    apply hy'1
    rw [← hc', h0]
    change slShort σ.toRingHom hσ (sl2Upper (0 : K)) = 1
    rw [← d4X_zero_eq hσ (0 : K)]
    exact d4X_zero_zero hσ
  exact ⟨c, hcF, hc0, by rw [hc']; exact hy'H⟩

theorem WSL_conj_upper (c : K) :
    WSL * sl2Upper c * WSL⁻¹ = sl2Lower (-c) := by
  rw [← uSL_eq_sl2Upper c, ← vSL_eq_sl2Lower (-c)]
  simpa using (vSL_eq_conj (-c)).symm

theorem exists_lower_param {y : twistedGroup σ.toRingHom}
    (hyroot : y ∈ hexGroup (twistedX σ.toRingHom) (-1)) (hyJ : y ∈ FixedSub σ) :
    ∃ c : fixSubfield σ, slShort σ.toRingHom hσ (sl2Lower (c : K)) = y := by
  let R := d4RGD2 σ.toRingHom hσ
  let r₁ := nHat σ.toRingHom (ng 1)
  have hW : r₁ = slShort σ.toRingHom hσ WSL := (slShort_WSL hσ).symm
  have hzroot : r₁⁻¹ * y * r₁ ∈ hexGroup (twistedX σ.toRingHom) 1 := by
    have hy' : y ∈ conjBy r₁⁻¹ (hexGroup (twistedX σ.toRingHom) 1) := by
      rw [show conjBy r₁⁻¹ (hexGroup (twistedX σ.toRingHom) 1) =
        hexGroup (twistedX σ.toRingHom) (-1) from R.act₁.1]
      exact hyroot
    exact mem_conjBy_iff.1 hy'
  obtain ⟨c, hc⟩ := (mem_hexGroup_iff' hσ 0 (by norm_num)
    (y := r₁⁻¹ * y * r₁)).1 hzroot
  let cK : K := c
  have hcK : d4X hσ 0 cK = r₁⁻¹ * y * r₁ := hc
  have hc' : slShort σ.toRingHom hσ (sl2Lower (-cK)) = y := by
    have hy : y = r₁ * (r₁⁻¹ * y * r₁) * r₁⁻¹ := by group
    rw [hy, ← hcK, hW, d4X_zero_eq (σ := σ.toRingHom) hσ, ← map_inv, ← map_mul, ← map_mul,
      WSL_conj_upper hσ]
  refine ⟨⟨-cK, ?_⟩, ?_⟩
  · have hmem : slShort σ.toRingHom hσ (sl2Lower (-cK)) ∈ FixedSub σ := by
      rw [hc']
      exact hyJ
    exact (slShort_lower_mem_FixedSub_iff hσ).1 hmem
  · simpa using hc'

theorem root3_all {H : Subgroup (twistedGroup σ.toRingHom)}
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H) (h2 : (2 : K) ≠ 0)
    (h0 : ∀ c : K, σ c = c → slShort σ.toRingHom hσ (sl2Upper c) ∈ H)
    {t : K} (htF : σ t = t) (ht0 : t ≠ 0) (h4 : d4X hσ 4 t ∈ H) :
    ∀ c : K, σ c = c → d4X hσ 2 c ∈ H := by
  intro c hc
  by_cases hc0 : c = 0
  · rw [hc0]
    have hzero : d4X hσ 2 (show d43Par σ.toRingHom 2 from (0 : K)) = 1 :=
      (d4X_eq_one_iff hσ).2 rfl
    rw [hzero]
    exact H.one_mem
  let s : K := -c / (2 * t)
  have hsF : σ s = s := by
    simp only [s, map_div₀, map_neg, map_mul, map_ofNat, hc, htF]
  have hs0 : s ≠ 0 := by
    exact div_ne_zero (neg_ne_zero.mpr hc0) (mul_ne_zero (by norm_num [h2]) ht0)
  have hx0 : d4X hσ 0 s ∈ H := by
    rw [d4X_zero_eq (σ := σ.toRingHom) hσ]
    exact h0 s hsF
  have hlong' : ∀ (i : Fin 6) (d : d43Par σ.toRingHom i) (k : ℤ), (i : ℤ) + 1 = k →
      k % 2 = 0 → IsRoot 6 k → d4X hσ i d ∈ H := fun i d k hk hk2 hkr =>
    hL (root_le_longSub hkr hk2 (d4X_mem_hexGroup' hσ i d hk))
  have hA1 := hlong' 1 (-d43Tr hσ (d43Sharp σ s * t)) 2 (by norm_num) (by norm_num)
    ⟨by norm_num, by norm_num⟩
  have hA3 := hlong' 3 (-d43Tr hσ (s * d43Sharp σ t)) 4 (by norm_num) (by norm_num)
    ⟨by norm_num, by norm_num⟩
  have hcomm : ⁅d4X hσ 0 s, d4X hσ 4 t⁆ ∈ H := by
    rw [commutatorElement_def]
    exact H.mul_mem (H.mul_mem (H.mul_mem hx0 h4) (H.inv_mem hx0)) (H.inv_mem h4)
  have hrel := (d4Rel_model hσ).r04 s t
  rw [hrel] at hcomm
  have hB : d4X hσ 2 (-(d43Cross σ.toRingHom s t : K)) ∈ H := by
    have e : d4X hσ 2 (-(d43Cross σ.toRingHom s t : K)) =
        (d4X hσ 1 (-d43Tr hσ (d43Sharp σ s * t)))⁻¹ *
          (d4X hσ 1 (-d43Tr hσ (d43Sharp σ s * t)) *
            d4X hσ 2 (-(d43Cross σ.toRingHom s t : K)) *
              d4X hσ 3 (-d43Tr hσ (s * d43Sharp σ t))) *
            (d4X hσ 3 (-d43Tr hσ (s * d43Sharp σ t)))⁻¹ := by group
    rw [e]
    exact H.mul_mem (H.mul_mem (H.inv_mem hA1) hcomm) (H.inv_mem hA3)
  have hsF' : σ.toRingHom s = s := hsF
  have htF' : σ.toRingHom t = t := htF
  have hcross : d43Cross σ.toRingHom s t = 2 * s * t := by
    unfold d43Cross
    simp only [hsF', htF']
    ring
  have harg : -(d43Cross σ.toRingHom s t : K) = c := by
    rw [hcross]
    simp only [s]
    field_simp
  rw [← harg]
  exact hB

theorem lower_all {H : Subgroup (twistedGroup σ.toRingHom)}
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H)
    (h2root : ∀ c : fixSubfield σ,
      d4X hσ 2 (show d43Par σ.toRingHom 2 from (c : K)) ∈ H) :
    ∀ c : fixSubfield σ, slShort σ.toRingHom hσ (sl2Lower (c : K)) ∈ H := by
  let n' := nHat σ.toRingHom (ng 1) * nHat σ.toRingHom (ng 0) *
    (nHat σ.toRingHom (ng 1))⁻¹
  have hn'H : n' ∈ H := hL (nprime_mem_longSub hσ)
  have hn'J : n' ∈ FixedSub σ :=
    (FixedSub σ).mul_mem
      ((FixedSub σ).mul_mem (nHat_one_mem_FixedSub σ hσ) (nHat_zero_mem_FixedSub σ hσ))
      ((FixedSub σ).inv_mem (nHat_one_mem_FixedSub σ hσ))
  have hxJ : ∀ c : fixSubfield σ,
      d4X hσ 2 (show d43Par σ.toRingHom 2 from (c : K)) ∈ FixedSub σ := by
    intro c
    have hcneg : σ (d4Sgn σ.toRingHom 2 (c : K)) = d4Sgn σ.toRingHom 2 (c : K) := by
      rw [show d4Sgn σ.toRingHom 2 (c : K) = -(c : K) by rfl, map_neg]
      exact congrArg Neg.neg c.2
    exact d43X_two_mem_FixedSub hσ hcneg
  let g : fixSubfield σ → fixSubfield σ := fun c =>
    Classical.choose (exists_lower_param hσ
      (nprime_conj_root3 hσ (d4X_mem_hexGroup' hσ 2
        (show d43Par σ.toRingHom 2 from (c : K)) (by norm_num)))
      ((FixedSub σ).mul_mem ((FixedSub σ).mul_mem hn'J (hxJ c)) ((FixedSub σ).inv_mem hn'J)))
  have hg : ∀ c : fixSubfield σ,
      slShort σ.toRingHom hσ (sl2Lower (g c : K)) =
        n' * d4X hσ 2 (show d43Par σ.toRingHom 2 from (c : K)) * n'⁻¹ := fun c =>
    Classical.choose_spec (exists_lower_param hσ
      (nprime_conj_root3 hσ (d4X_mem_hexGroup' hσ 2
        (show d43Par σ.toRingHom 2 from (c : K)) (by norm_num)))
      ((FixedSub σ).mul_mem ((FixedSub σ).mul_mem hn'J (hxJ c)) ((FixedSub σ).inv_mem hn'J)))
  have hg_inj : Function.Injective g := by
    intro a b hab
    have hz : n' * d4X hσ 2 (show d43Par σ.toRingHom 2 from (a : K)) * n'⁻¹ =
        n' * d4X hσ 2 (show d43Par σ.toRingHom 2 from (b : K)) * n'⁻¹ := by
      rw [← hg a, ← hg b, hab]
    have hx : d4X hσ 2 (show d43Par σ.toRingHom 2 from (a : K)) =
        d4X hσ 2 (show d43Par σ.toRingHom 2 from (b : K)) := by
      have := congrArg (fun z => n'⁻¹ * z * n') hz
      have ha_eq : n'⁻¹ * (n' * d4X hσ 2
          (show d43Par σ.toRingHom 2 from (a : K)) * n'⁻¹) * n' =
          d4X hσ 2 (show d43Par σ.toRingHom 2 from (a : K)) := by group
      have hb_eq : n'⁻¹ * (n' * d4X hσ 2
          (show d43Par σ.toRingHom 2 from (b : K)) * n'⁻¹) * n' =
          d4X hσ 2 (show d43Par σ.toRingHom 2 from (b : K)) := by group
      rwa [ha_eq, hb_eq] at this
    exact Subtype.ext (d4X_injective hσ 2 hx)
  have hsurj : Function.Surjective g := Finite.surjective_of_injective hg_inj
  intro c'
  obtain ⟨c, hc⟩ := hsurj c'
  have hz : slShort σ.toRingHom hσ (sl2Lower (c' : K)) =
      n' * d4X hσ 2 (show d43Par σ.toRingHom 2 from (c : K)) * n'⁻¹ := by
    rw [← hc]
    exact hg c
  rw [hz]
  exact H.mul_mem (H.mul_mem hn'H (h2root c)) (H.inv_mem hn'H)

theorem map_sl2Upper_subtype (c : fixSubfield σ) :
    Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype (sl2Upper c) =
      sl2Upper (c : K) := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.map_apply_coe]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [LieType.Steinberg.sl2Upper]

theorem map_sl2Lower_subtype (c : fixSubfield σ) :
    Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype (sl2Lower c) =
      sl2Lower (c : K) := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.map_apply_coe]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [LieType.Steinberg.sl2Lower]

theorem exists_t_of_root5 {y : twistedGroup σ.toRingHom}
    (hyJ : y ∈ FixedSub σ) (hy5 : y ∈ hexGroup (twistedX σ.toRingHom) 5) (hy1 : y ≠ 1) :
    ∃ t : fixSubfield σ, t ≠ 0 ∧ d4X hσ 4 (t : K) = y := by
  obtain ⟨t, ht⟩ := (mem_hexGroup_iff' hσ 4 (by norm_num) (y := y)).1 hy5
  let tK : K := t
  have htK : d4X hσ 4 tK = y := ht
  have htJ : d4X hσ 4 tK ∈ FixedSub σ := by rw [htK]; exact hyJ
  have htJ' : d43X hσ 4 (show d43Par σ.toRingHom 4 from tK) ∈ FixedSub σ := by
    change d43X hσ 4 (show d43Par σ.toRingHom 4 from tK) ∈ FixedSub σ at htJ
    exact htJ
  have htF : σ tK = tK := (d43X_four_mem_FixedSub_iff hσ).1 htJ' 
  have ht0 : tK ≠ 0 := by
    intro h0
    apply hy1
    rw [← htK, h0]
    exact (d4X_eq_one_iff hσ).2 rfl
  exact ⟨⟨tK, htF⟩, fun h => ht0 (congrArg Subtype.val h), by simpa using htK⟩

theorem shortUpper_fixed_eq_top (h2 : (2 : K) ≠ 0) (H : Subgroup (twistedGroup σ.toRingHom))
    (htor : ∀ l : (fixSubfield σ)ˣ,
      slShort σ.toRingHom hσ (HSL (Units.map (fixSubfield σ).subtype.toMonoidHom l)) ∈ H)
    {c₀ : K} (hc₀ : c₀ ≠ 0) (hc₀F : σ c₀ = c₀)
    (hH : slShort σ.toRingHom hσ (sl2Upper c₀) ∈ H) :
    ∀ c : K, σ c = c → slShort σ.toRingHom hσ (sl2Upper c) ∈ H := by
  have hsq : ∀ a : (fixSubfield σ), ((a : K) ^ 2 * c₀) ∈ shortCoords hσ H := by
    intro a
    by_cases ha : a = 0
    · have h0 : ((a : K) ^ 2 * c₀) = 0 := by rw [ha]; simp
      rw [h0]
      exact (shortCoords hσ H).zero_mem
    · have haK : ((a : K)) ≠ 0 := by exact_mod_cast ha
      let u : (fixSubfield σ)ˣ := Units.mk0 a ha
      have hu : (Units.map (fixSubfield σ).subtype.toMonoidHom u : Kˣ) =
          Units.mk0 (a : K) haK := Units.ext rfl
      have e := diagSL_conj_sl2Upper (Units.mk0 (a : K) haK) c₀
      simp only [Units.val_mk0] at e
      rw [mem_shortCoords, d4X_zero_eq, ← e, map_mul, map_mul, map_inv]
      refine H.mul_mem (H.mul_mem ?_ ?_) (H.inv_mem ?_)
      · rw [← hu]
        exact htor u
      · exact hH
      · rw [← hu]
        exact htor u
  intro c hc
  let a : fixSubfield σ := (⟨c, hc⟩ / ⟨c₀, hc₀F⟩ + 1) / 2
  let b : fixSubfield σ := (⟨c, hc⟩ / ⟨c₀, hc₀F⟩ - 1) / 2
  have ha : (a : K) = (c / c₀ + 1) / 2 := rfl
  have hb : (b : K) = (c / c₀ - 1) / 2 := rfl
  have hx : c = (a : K) ^ 2 * c₀ - (b : K) ^ 2 * c₀ := by
    rw [ha, hb]
    field_simp
    ring
  have hmem : c ∈ shortCoords hσ H := by
    rw [hx]
    exact (shortCoords hσ H).sub_mem (hsq a) (hsq b)
  rw [mem_shortCoords, d4X_zero_eq] at hmem
  exact hmem

theorem slShort_le_of_root5 (h2 : (2 : K) ≠ 0) {H : Subgroup (twistedGroup σ.toRingHom)}
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H)
    {y : twistedGroup σ.toRingHom} (hyH : y ∈ H) (hyJ : y ∈ FixedSub σ)
    (hy5 : y ∈ hexGroup (twistedX σ.toRingHom) 5) (hy1 : y ≠ 1) :
    ∀ M : SL(2, fixSubfield σ),
      slShort σ.toRingHom hσ (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) ∈ H := by
  obtain ⟨t, ht0, hty⟩ := exists_t_of_root5 hσ hyJ hy5 hy1
  obtain ⟨c₀, hc₀F, hc₀0, hx0⟩ := exists_upper_of_root5 hσ hL hyH hyJ hy5 hy1
  have htor : ∀ l : (fixSubfield σ)ˣ,
      slShort σ.toRingHom hσ (HSL (Units.map (fixSubfield σ).subtype.toMonoidHom l)) ∈ H :=
    fun l => hL
      (CFSG.HardMathSupport.Seitz.TrialityOdd.Coordinator.slShort_HSL_fixed_mem_longSub hσ l)
  have h0all := shortUpper_fixed_eq_top hσ h2 H htor hc₀0 hc₀F hx0
  have h2root := root3_all hσ hL h2 h0all (t := (t : K)) t.2
    (by exact_mod_cast ht0) (by rw [hty]; exact hyH)
  have hlow : ∀ c : fixSubfield σ, slShort σ.toRingHom hσ (sl2Lower (c : K)) ∈ H :=
    lower_all hσ hL (fun c => h2root (c : K) c.2)
  let Pset : Set (SL(2, fixSubfield σ)) :=
    {M | slShort σ.toRingHom hσ
      (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) ∈ H}
  let P : Subgroup SL(2, fixSubfield σ) :=
    { carrier := Pset
      one_mem' := by
        change slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype 1) ∈ H
        rw [map_one, map_one]
        exact H.one_mem
      mul_mem' := by
        intro a b ha hb
        change slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype (a * b)) ∈ H
        rw [map_mul, map_mul]
        exact H.mul_mem ha hb
      inv_mem' := by
        intro a ha
        change slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype a⁻¹) ∈ H
        rw [map_inv, map_inv]
        exact H.inv_mem ha }
  have hP : P = ⊤ := by
    rw [eq_top_iff,
      ← CFSG.LocalAnalysis.ComponentInitial.sl2_closure_upper_lower (K := fixSubfield σ)]
    refine (Subgroup.closure_le P).2 ?_
    rintro M (⟨c, rfl⟩ | ⟨c, rfl⟩)
    · change slShort σ.toRingHom hσ
        (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype (sl2Upper c)) ∈ H
      rw [map_sl2Upper_subtype hσ]
      exact h0all (c : K) c.2
    · change slShort σ.toRingHom hσ
        (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype (sl2Lower c)) ∈ H
      rw [map_sl2Lower_subtype hσ]
      exact hlow c
  intro M
  exact (show M ∈ P from by rw [hP]; trivial)

theorem slShort_le_of_root3_conj (h2 : (2 : K) ≠ 0)
    {H : Subgroup (twistedGroup σ.toRingHom)}
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H)
    {r : twistedGroup σ.toRingHom}
    (hrL : r ∈ Subgroup.normalizer
      (longSub 6 (hexGroup (twistedX σ.toRingHom)) : Set (twistedGroup σ.toRingHom)))
    (hrJ : r ∈ FixedSub σ)
    (hr35 : conjBy r⁻¹ (hexGroup (twistedX σ.toRingHom) 3) =
      hexGroup (twistedX σ.toRingHom) 5)
    (hrS : ∀ M : SL(2, fixSubfield σ), ∃ M' : SL(2, fixSubfield σ),
      r⁻¹ * slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M') * r =
        slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M))
    {x : twistedGroup σ.toRingHom} (hxH : x ∈ H) (hxJ : x ∈ FixedSub σ)
    (hx3 : x ∈ hexGroup (twistedX σ.toRingHom) 3) (hx1 : x ≠ 1) :
    ∀ M : SL(2, fixSubfield σ),
      slShort σ.toRingHom hσ
        (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) ∈ H := by
  let H' : Subgroup (twistedGroup σ.toRingHom) :=
    H.comap (MulAut.conj r⁻¹).toMonoidHom
  have hL' : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H' := by
    intro l hl
    rw [Subgroup.mem_comap]
    change (MulAut.conj r⁻¹) l ∈ H
    rw [MulAut.conj_apply]
    have hr1inv : r⁻¹ ∈ Subgroup.normalizer
        (longSub 6 (hexGroup (twistedX σ.toRingHom)) : Set (twistedGroup σ.toRingHom)) :=
      (Subgroup.normalizer _).inv_mem hrL
    have hl' : r⁻¹ * l * (r⁻¹)⁻¹ ∈
        longSub 6 (hexGroup (twistedX σ.toRingHom)) :=
      (Subgroup.mem_normalizer_iff.mp hr1inv l).1 hl
    exact hL (by simpa using hl')
  have hyH' : r * x * r⁻¹ ∈ H' := by
    rw [Subgroup.mem_comap]
    change (MulAut.conj r⁻¹) (r * x * r⁻¹) ∈ H
    rw [MulAut.conj_apply]
    rw [show r⁻¹ * (r * x * r⁻¹) * (r⁻¹)⁻¹ = x by group]
    exact hxH
  have hyJ : r * x * r⁻¹ ∈ FixedSub σ :=
    (FixedSub σ).mul_mem ((FixedSub σ).mul_mem hrJ hxJ) ((FixedSub σ).inv_mem hrJ)
  have hy5 : r * x * r⁻¹ ∈ hexGroup (twistedX σ.toRingHom) 5 := by
    have : r * x * r⁻¹ ∈ conjBy r⁻¹ (hexGroup (twistedX σ.toRingHom) 3) := by
      rw [mem_conjBy_iff]
      change r⁻¹ * (r * x * r⁻¹) * r ∈ hexGroup (twistedX σ.toRingHom) 3
      rw [show r⁻¹ * (r * x * r⁻¹) * r = x by group]
      exact hx3
    rwa [hr35] at this
  have hy1 : r * x * r⁻¹ ≠ 1 := by
    intro h
    apply hx1
    have := congrArg (fun z => r⁻¹ * z * r) h
    rwa [show r⁻¹ * (r * x * r⁻¹) * r = x by group,
      show r⁻¹ * 1 * r = 1 by group] at this
  have hshort' : ∀ M : SL(2, fixSubfield σ),
      slShort σ.toRingHom hσ
        (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) ∈ H' :=
    slShort_le_of_root5 (hσ := hσ) (h2 := h2) (H := H') (hL := hL')
      (hyH := hyH') (hyJ := hyJ) (hy5 := hy5) (hy1 := hy1)
  intro M
  obtain ⟨M', hM'⟩ := hrS M
  have hu' : slShort σ.toRingHom hσ
      (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M') ∈ H' := hshort' M'
  rw [Subgroup.mem_comap] at hu'
  change (MulAut.conj r⁻¹) (slShort σ.toRingHom hσ
    (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M')) ∈ H at hu'
  rw [MulAut.conj_apply] at hu'
  rwa [show r⁻¹ * slShort σ.toRingHom hσ
      (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M') * (r⁻¹)⁻¹ =
        slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) by
    rw [← hM']
    group] at hu'

theorem r1_inv_conj_root3 :
    conjBy (nHat σ.toRingHom (ng 1))⁻¹ (hexGroup (twistedX σ.toRingHom) 3) =
      hexGroup (twistedX σ.toRingHom) 5 :=
  ((d4RGD2 σ.toRingHom hσ).act₁.2.2 3 (by norm_num) (by norm_num)).1

theorem map_subtype_WSL :
    Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype
        (WSL : SL(2, fixSubfield σ)) = (WSL : SL(2, K)) := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.map_apply_coe, coe_WSL, coe_WSL]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

theorem r1_hrS (M : SL(2, fixSubfield σ)) :
    ∃ M' : SL(2, fixSubfield σ),
      (nHat σ.toRingHom (ng 1))⁻¹ * slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M') *
          nHat σ.toRingHom (ng 1) =
        slShort σ.toRingHom hσ
          (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) := by
  refine ⟨(WSL : SL(2, fixSubfield σ)) * M *
    (WSL : SL(2, fixSubfield σ))⁻¹, ?_⟩
  rw [← slShort_WSL hσ]
  rw [← map_inv, ← map_mul, ← map_mul]
  congr 1
  rw [map_mul, map_mul, map_inv, map_subtype_WSL hσ]
  group

theorem d4X_two_eq_d43X :
    d4X hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)) =
      d43X hσ 2 (show d43Par σ.toRingHom 2 from (-1 : K)) := rfl

theorem d4X_four_eq_d43X :
    d4X hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) =
      d43X hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) := rfl

theorem d4X_two_one_mem_FixedSub :
    d4X hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)) ∈ FixedSub σ := by
  rw [d4X_two_eq_d43X]
  exact d43X_two_mem_FixedSub hσ (c := (-1 : K)) (by norm_num)

theorem d4X_four_one_mem_FixedSub :
    d4X hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) ∈ FixedSub σ := by
  rw [d4X_four_eq_d43X]
  exact d43X_four_mem_FixedSub hσ (c := (1 : K)) (by norm_num)

theorem fixedSub_le_of_slLong_slShort (hK2 : ringChar K ≠ 2) {q : ℕ} (hq5 : 5 ≤ q)
    (hK : Nat.card K = q ^ 3) (hσq : ∀ c, σ c = c ^ q)
    (H : Subgroup (twistedGroup σ.toRingHom))
    (hLong : ∀ M : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ),
      slLong σ.toRingHom hσ M ∈ H)
    (hShort : ∀ M : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ),
      slShort σ.toRingHom hσ
        (Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype M) ∈ H) :
    FixedSub σ ≤ H := by
  classical
  have hq2 : 2 ≤ q := by omega
  have hcardF : Nat.card (fixSubfield σ) = q :=
    card_fixedField_of_cube σ.toRingHom hq2 hK hσq
  have hk3 : (3 : ℕ∞) ≤ ENat.card (fixSubfield σ) := by
    rw [ENat.card_eq_coe_natCard]
    exact_mod_cast (by rw [hcardF]; omega : 3 ≤ Nat.card (fixSubfield σ))
  let hσ3 : ∀ c, σ (σ (σ c)) = c := hσ
  let Φ := triOddJDict σ hK2 hq2 hK hσq hσ3 hk3
  let Ksub : Subgroup ↥(FixedSub σ) := H.comap (FixedSub σ).subtype
  have hLongK : ∀ M : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ),
      triOddSlLongJ σ hσ3 M ∈ Ksub := by
    intro M
    show (triOddSlLongJ σ hσ3 M : twistedGroup σ.toRingHom) ∈ H
    simpa only [triOddSlLongJ, MonoidHom.codRestrict_apply] using hLong M
  have hShortK : ∀ M : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ),
      triOddSlShortJ σ hσ3 M ∈ Ksub := by
    intro M
    show (triOddSlShortJ σ hσ3 M : twistedGroup σ.toRingHom) ∈ H
    simpa only [triOddSlShortJ, MonoidHom.codRestrict_apply, MonoidHom.comp_apply] using hShort M
  let P : Subgroup (ModGL Tag.G2 (fixSubfield σ)) :=
    (Ksub.map Φ.toMonoidHom).map (adjointGroup Tag.G2 (fixSubfield σ)).subtype
  have hPle : P ≤ adjointGroup Tag.G2 (fixSubfield σ) :=
    Subgroup.map_subtype_le _
  have hpair_long : rootPair Tag.G2 (fixSubfield σ) (Pi.single g2ia 1) ≤ P := by
    rw [show g2ia = g2l by decide,
      ← range_g2RootSL2_coe (L := fixSubfield σ) g2l]
    rintro _ ⟨x, ⟨M, rfl⟩, rfl⟩
    exact ⟨Φ (triOddSlLongJ σ hσ3 M), ⟨triOddSlLongJ σ hσ3 M, hLongK M, rfl⟩, by
      rw [triOddJDict_slLongJ]⟩
  have hpair_short : rootPair Tag.G2 (fixSubfield σ) (Pi.single g2ir 1) ≤ P := by
    rw [show g2ir = g2s by decide,
      ← range_g2RootSL2_coe (L := fixSubfield σ) g2s]
    rintro _ ⟨x, ⟨M, rfl⟩, rfl⟩
    exact ⟨Φ (triOddSlShortJ σ hσ3 M), ⟨triOddSlShortJ σ hσ3 M, hShortK M, rfl⟩, by
      rw [triOddJDict_slShortJ]⟩
  have hroot_ia : rootSubgroup Tag.G2 (fixSubfield σ) (Pi.single g2ia 1) ≤ P := by
    refine (show rootSubgroup Tag.G2 (fixSubfield σ) (Pi.single g2ia 1) ≤
      rootPair Tag.G2 (fixSubfield σ) (Pi.single g2ia 1) from ?_).trans hpair_long
    rw [rootPair]; exact le_sup_left
  have hroot_nia : rootSubgroup Tag.G2 (fixSubfield σ) (-Pi.single g2ia 1) ≤ P := by
    refine (show rootSubgroup Tag.G2 (fixSubfield σ) (-Pi.single g2ia 1) ≤
      rootPair Tag.G2 (fixSubfield σ) (Pi.single g2ia 1) from ?_).trans hpair_long
    rw [rootPair]; exact le_sup_right
  have hroot_ir : rootSubgroup Tag.G2 (fixSubfield σ) (Pi.single g2ir 1) ≤ P := by
    refine (show rootSubgroup Tag.G2 (fixSubfield σ) (Pi.single g2ir 1) ≤
      rootPair Tag.G2 (fixSubfield σ) (Pi.single g2ir 1) from ?_).trans hpair_short
    rw [rootPair]; exact le_sup_left
  have hroot_nir : rootSubgroup Tag.G2 (fixSubfield σ) (-Pi.single g2ir 1) ≤ P := by
    refine (show rootSubgroup Tag.G2 (fixSubfield σ) (-Pi.single g2ir 1) ≤
      rootPair Tag.G2 (fixSubfield σ) (Pi.single g2ir 1) from ?_).trans hpair_short
    rw [rootPair]; exact le_sup_right
  have htop : adjointGroup Tag.G2 (fixSubfield σ) ≤ P := by
    rw [← rootSubgroup_simple_sup_eq_adjointGroup (K := fixSubfield σ)]
    exact sup_le (sup_le hroot_ia hroot_nia) (sup_le hroot_ir hroot_nir)
  have hP : P = adjointGroup Tag.G2 (fixSubfield σ) := le_antisymm hPle htop
  have hmap : (Ksub.map Φ.toMonoidHom).map
      (adjointGroup Tag.G2 (fixSubfield σ)).subtype =
      (⊤ : Subgroup ↥(adjointGroup Tag.G2 (fixSubfield σ))).map
        (adjointGroup Tag.G2 (fixSubfield σ)).subtype := by
    rw [Subgroup.map_top, Subgroup.range_subtype]
    exact hP
  have hKmap : Ksub.map Φ.toMonoidHom = ⊤ :=
    Subgroup.map_injective (Subgroup.subtype_injective _) hmap
  have hKsub : Ksub = ⊤ := by
    refine Subgroup.map_injective (f := Φ.toMonoidHom) Φ.injective ?_
    rw [hKmap, Subgroup.map_top, MonoidHom.range_eq_top.mpr Φ.surjective]
  intro z hz
  have hzK : (⟨z, hz⟩ : ↥(FixedSub σ)) ∈ Ksub := by rw [hKsub]; trivial
  exact hzK

theorem fixedSub_le_of_root5 (hK2 : ringChar K ≠ 2) {q : ℕ} (hq5 : 5 ≤ q)
    (hK : Nat.card K = q ^ 3) (hσq : ∀ c, σ c = c ^ q)
    (H : Subgroup (twistedGroup σ.toRingHom))
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H)
    {y : twistedGroup σ.toRingHom} (hyH : y ∈ H) (hyJ : y ∈ FixedSub σ)
    (hy5 : y ∈ hexGroup (twistedX σ.toRingHom) 5) (hy1 : y ≠ 1) :
    FixedSub σ ≤ H := by
  refine fixedSub_le_of_slLong_slShort hσ hK2 hq5 hK hσq H ?_ ?_
  · intro M
    exact hL (slLong_range_le_longSub hσ ⟨M, rfl⟩)
  · exact slShort_le_of_root5 (hσ := hσ) (h2 := Ring.two_ne_zero hK2)
      (H := H) (hL := hL) (hyH := hyH) (hyJ := hyJ) (hy5 := hy5) (hy1 := hy1)

theorem longShortFixedGen_holds (hK2 : ringChar K ≠ 2) : LongShortFixedGen hσ := by
  intro H hL hgen
  have h2 : (2 : K) ≠ 0 := Ring.two_ne_zero hK2
  cases hgen with
  | inr hx4 =>
      have hyJ : d4X hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) ∈ FixedSub σ :=
        d4X_four_one_mem_FixedSub hσ
      have hy5 : d4X hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) ∈
          hexGroup (twistedX σ.toRingHom) 5 :=
        d4X_mem_hexGroup' hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) (by norm_num)
      have hy1 : d4X hσ 4 (show d43Par σ.toRingHom 4 from (1 : K)) ≠ 1 := by
        intro h
        have h0 := (d4X_eq_one_iff hσ).1 h
        have h0' : (1 : K) = 0 := h0
        exact one_ne_zero h0'
      exact slShort_le_of_root5 (hσ := hσ) (h2 := h2) (H := H) (hL := hL)
        (hyH := hx4) (hyJ := hyJ) (hy5 := hy5) (hy1 := hy1)
  | inl hx2 =>
      have hxJ : d4X hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)) ∈ FixedSub σ :=
        d4X_two_one_mem_FixedSub hσ
      have hx3 : d4X hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)) ∈
          hexGroup (twistedX σ.toRingHom) 3 :=
        d4X_mem_hexGroup' hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)) (by norm_num)
      have hx1 : d4X hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)) ≠ 1 := by
        intro h
        have h0 := (d4X_eq_one_iff hσ).1 h
        have h0' : (1 : K) = 0 := h0
        exact one_ne_zero h0'
      exact slShort_le_of_root3_conj hσ h2 (H := H) (hL := hL)
        (r := nHat σ.toRingHom (ng 1))
        (hrL := r1_normalizes_longSub hσ)
        (hrJ := nHat_one_mem_FixedSub σ hσ)
        (hr35 := r1_inv_conj_root3 hσ)
        (hrS := r1_hrS hσ)
        (x := d4X hσ 2 (show d43Par σ.toRingHom 2 from (1 : K)))
        (hxH := hx2) (hxJ := hxJ) (hx3 := hx3) (hx1 := hx1)

theorem fixedSub_le_of_longSub_short
    (hK2 : ringChar K ≠ 2) {q : ℕ} (hq5 : 5 ≤ q)
    (hK : Nat.card K = q ^ 3) (hσq : ∀ c, σ c = c ^ q)
    (H : Subgroup (twistedGroup σ.toRingHom))
    (hL : longSub 6 (hexGroup (twistedX σ.toRingHom)) ≤ H)
    (hx : d4X hσ 2 (1 : K) ∈ H ∨ d4X hσ 4 (1 : K) ∈ H) :
    FixedSub σ ≤ H :=
  fixedSub_le_of_slLong_slShort hσ hK2 hq5 hK hσq H
    (fun M => hL (slLong_range_le_longSub hσ ⟨M, rfl⟩))
    (longShortFixedGen_holds hσ hK2 H hL hx)

