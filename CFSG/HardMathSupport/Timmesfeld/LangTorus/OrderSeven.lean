@[expose] def wordCFrom (τ : Tag) (j k : Fin τ.rank) (M : List Entry) (w : List ℕ) : List Entry :=
  w.foldl (fun M g => wc (nilE τ j k g) M) M

theorem wordC_eq_from (τ : Tag) (j k : Fin τ.rank) (w : List ℕ) :
    wordC τ j k w = wordCFrom τ j k [] w := rfl

theorem wordCFrom_append (τ : Tag) (j k : Fin τ.rank) (M : List Entry) (A B : List ℕ) :
    wordCFrom τ j k M (A ++ B) = wordCFrom τ j k (wordCFrom τ j k M A) B := by
  simp only [wordCFrom, List.foldl_append]

theorem replicate_seven_ordWord : (List.replicate 7 ordWord).flatten =
    ordWord ++ ordWord ++ ordWord ++ ordWord ++ ordWord ++ ordWord ++ ordWord := rfl

