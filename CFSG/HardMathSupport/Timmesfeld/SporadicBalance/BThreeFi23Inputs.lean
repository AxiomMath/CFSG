@[expose] def censusData (_ : Unit := ()) : Array (Nat × List Nat) :=
  ((censusText.splitOn ";").map fun t =>
    match (t.splitOn " ").filterMap String.toNat? with
    | c :: w => (c, w)
    | [] => (4, [])).toArray

@[expose] def t2Point : Nat := 30132

@[expose] def applyW (L : Array Table) (w : List Nat) (p : Nat) : Nat :=
  w.foldr (fun l q => ap L[l]! q) p

@[expose] def applyInvW (L : Array Table) (w : List Nat) (p : Nat) : Nat :=
  w.foldl (fun q l => ap L[invL l]! q) p

@[expose] def imgTab (O : WOrbit) (k : Nat) : Table :=
  wordT 31671 (genTables O) (imgWords ())[k]!

@[expose] def t3Tabs (O : WOrbit) (L : Array Table) : Array Table :=
  #[compT 31671 (imgTab O 2) (imgTab O 3), qLettersT L kleinZ,
    compT 31671 (compT 31671 (compT 31671 (imgTab O 4) (imgTab O 5)) (imgTab O 2)) (imgTab O 1),
    compT 31671 (compT 31671 (compT 31671 (compT 31671 (compT 31671 (imgTab O 5) (imgTab O 3))
      (imgTab O 7)) (imgTab O 0)) (imgTab O 6)) (imgTab O 1)]

@[expose] def censusAt (L G : Array Table) (P : Array (Nat × Nat)) (tT : Array Table) (r : Nat)
    (x : Nat × List Nat) : Bool :=
  decide (x.1 < 4) && x.2.all (fun l => decide (l < L.size)) && decide (r < qN) &&
    allIn 0 6 fun t => applyW L x.2 (qActPt P G r (applyInvW L x.2 t)) == ap tT[x.1]! t

@[expose] def censusOK (L G : Array Table) (P : Array (Nat × Nat)) (rep : Array Nat)
    (tT : Array Table) (data : Array (Nat × List Nat)) : Bool :=
  allIn 0 rep.size fun l => censusAt L G P tT rep[l]! data[l]!

@[expose] def zCommOK (L G : Array Table) : Bool :=
  kleinZ.all (fun l => decide (l < L.size)) && G.size == 3 &&
    allIn 0 3 fun j => allIn 0 6 fun t =>
      applyW L kleinZ (ap G[j]! t) == ap G[j]! (applyW L kleinZ t)

@[expose] def t2OK (O : WOrbit) : Bool :=
  allIn 0 6 fun t =>
    ap (imgTab O 2) t ==
      treeAct O.par O.lab O.alpha O.beta (dTab O) (genTables O (-2)) t2Point t

@[expose] def b3CensusOK (O : WOrbit) : Bool :=
  let L := chainLetters O
  let G := qGens L
  let E := qEnum G
  let lb := qLabels E.par E.L qN (qInvIdx G E) G.size
  censusOK L G E.par lb.rep (t3Tabs O L) (censusData ()) && zCommOK L G && t2OK O

