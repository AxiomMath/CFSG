@[expose] def keys : List Nat := [0, 1, 2, 3, 4, 5, 6]

@[expose] def yRels : List (Nat × Nat × Nat) := [(0, 1, 1), (2, 3, 1), (4, 5, 1), (5, 6, 1)]

@[expose] def levels (_ : Unit := ()) : Array Level := rawLevels 276 co3ChainArrs co3ChainBaseArr

@[expose] def inP (L : Array Level) (g : Array Nat) : Bool := siftA 276 L co3ChainBaseArr 0 g

@[expose] def qCert (_ : Unit := ()) : ArrCert := enumBfs 276 (qGens ()) keys 2200

@[expose] def cCert (_ : Unit := ()) : ArrCert := enumBfs 276 (cGens ()) keys 4600

@[expose] def digit3 (k i : Nat) : Nat := k / 3 ^ i % 3

@[expose] def dProd (dg : Array (Array Nat)) (k : Nat) : Array Nat :=
  compA 276 (powArr 276 dg[0]! (digit3 k 0)) (compA 276 (powArr 276 dg[1]! (digit3 k 1))
    (compA 276 (powArr 276 dg[2]! (digit3 k 2)) (compA 276 (powArr 276 dg[3]! (digit3 k 3))
      (powArr 276 dg[4]! (digit3 k 4)))))

@[expose] def dElts (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 243) fun k => dProd (dGens ()) k.val

@[expose] def dot3 (m k : Nat) : Nat :=
  (digit3 m 0 * digit3 k 0 + digit3 m 1 * digit3 k 1 + digit3 m 2 * digit3 k 2 +
    digit3 m 3 * digit3 k 3 + digit3 m 4 * digit3 k 4) % 3

@[expose] def rebuild (L : Array Level) (beta : Array Nat) : Array Nat := Id.run do
  let mut acc := idA 276
  let mut accI := idA 276
  for i in [0:7] do
    let k := L[i]!.pos[accI[beta[i]!]!]!
    acc := compA 276 acc L[i]!.tr[k]!
    accI := compA 276 L[i]!.trInv[k]! accI
  return acc

@[expose] def coordOf (E : Array (Array Nat)) (g : Array Nat) (l : Nat) : Nat :=
  ((List.range 243).find? fun k => (E[k]!)[g[0]!]! == g[l]!).getD 243

@[expose] def inD (E : Array (Array Nat)) (t : Array Nat) : Bool :=
  anyLt 243 fun k => eqA 276 t E[k]!

@[expose] def commCount (E : Array (Array Nat)) (w : Array Nat) : Nat :=
  ((Finset.range E.size).filter fun j => commA 276 E[j]! w = true).card

@[expose] def qCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let gs := qGens ()
  let c := qCert ()
  enumOK 276 gs keys c && c.pts.size == 2187 && allLt 4 fun k => inP L gs[k]!

@[expose] def dCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let dg := dGens ()
  let E := dElts ()
  allLt 5 (fun i => validA 276 dg[i]! && inP L dg[i]! &&
    eqA 276 (powArr 276 dg[i]! 3) (idA 276)) &&
  allLt 5 (fun i => allLt 5 fun j => commA 276 dg[i]! dg[j]!) &&
  allLt 243 (fun k => allLt 243 fun k' => k == k' || !(eqA 276 E[k]! E[k']!))

@[expose] def hypCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let E := dElts ()
  let G := hypTuples.map (rebuild L)
  let C := G.map fun g => Array.ofFn (n := 7) fun l => coordOf E g l.val
  G.size == 121 &&
  allLt 121 (fun j => validA 276 G[j]! && inP L G[j]! &&
    allLt 7 fun l => decide ((C[j]!)[l]! < 243) && (E[(C[j]!)[l]!]!)[(G[j]!)[0]!]! ==
      (G[j]!)[l]!) &&
  allLt 243 (fun m => m == 0 || anyLt 121 fun j => allLt 7 fun l => dot3 m (C[j]!)[l]! == 0)

@[expose] def fusCheck (_ : Unit := ()) : Bool :=
  let c := qCert ()
  let E := dElts ()
  let Ls := Array.ofFn (n := 12) fun j => lineArr j.val
  let Ls2 := Ls.map fun x => compA 276 x x
  c.pts.size == 2187 &&
  allLt 2187 fun k =>
    let t := c.pts[k]!
    !(eqA 276 (powArr 276 t 3) (idA 276)) || eqA 276 t (idA 276) || inD E t ||
      anyLt 2187 fun u =>
        let x := conjA 276 c.pts[u]! t
        anyLt 12 fun j => eqA 276 x Ls[j]! || eqA 276 x Ls2[j]!

@[expose] def transCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let E := dElts ()
  let y := yArr ()
  let y2 := compA 276 y y
  allLt 12 fun j =>
    let h := transArr j
    let x := lineArr j
    let z := conjA 276 h x
    validA 276 h && validA 276 x && inP L h &&
      (if transToD.getD j false then inD E z else eqA 276 z y || eqA 276 z y2)

@[expose] def cCheck (_ : Unit := ()) : Bool :=
  let y := yArr ()
  validA 276 y && inP (levels ()) y && eqA 276 (powArr 276 y 3) (idA 276) &&
    !(eqA 276 y (idA 276)) &&
    centOKP 3 276 co3ChainArrs co3ChainBaseArr y yRels (cGens ()) keys (cCert ()) 4536

@[expose] def classCheck (_ : Unit := ()) : Bool :=
  let E := (cCert ()).pts
  allLt E.size fun i =>
    let w := E[i]!
    eqA 276 w (idA 276) ||
      !(eqA 276 (powArr 276 w 2) (idA 276) || eqA 276 (powArr 276 w 7) (idA 276)) ||
      decide (commCount E w < 81)

