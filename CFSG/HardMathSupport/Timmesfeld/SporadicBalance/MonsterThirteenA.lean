theorem eq_bot_of_central_two_quotient {H Q : Type*} [Group H] [Group Q] [Finite H]
    (ψ : H →* Q) (hψ : Function.Surjective ψ) {t : H} (ht2 : t * t = 1)
    (htc : ∀ g : H, g * t = t * g) (hker : ∀ g : H, ψ g = 1 → g = 1 ∨ g = t) {x : H}
    (hx : orderOf x = 13)
    (hQ : orderOf (ψ x) = 13 → ∀ K : Subgroup Q, K ≤ Subgroup.centralizer ({ψ x} : Set Q) →
      (∀ g ∈ Subgroup.centralizer ({ψ x} : Set Q), ∀ k ∈ K, g * k * g⁻¹ ∈ K) →
      Odd (Nat.card K) → ¬ 13 ∣ Nat.card K → K = ⊥)
    {Y : Subgroup H} (hYC : Y ≤ Subgroup.centralizer ({x} : Set H))
    (hYn : ∀ g ∈ Subgroup.centralizer ({x} : Set H), ∀ y ∈ Y, g * y * g⁻¹ ∈ Y)
    (hodd : Odd (Nat.card Y)) (h13 : ¬ 13 ∣ Nat.card Y) : Y = ⊥ := by
  have hinj : ∀ y ∈ Y, ψ y = 1 → y = 1 := by
    intro y hy h1
    rcases hker y h1 with h | h
    · exact h
    · have h2 : y * y = 1 := by rw [h, ht2]
      have hdvd : orderOf y ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [pow_two]; exact h2)
      have hodd' : Odd (orderOf y) :=
        Odd.of_dvd_nat hodd (Subgroup.orderOf_dvd_natCard Y hy)
      rcases (Nat.dvd_prime Nat.prime_two).1 hdvd with h' | h'
      · exact orderOf_eq_one_iff.1 h'
      · rw [h'] at hodd'; exact absurd hodd' (by decide)
  have hcard : Nat.card (Y.map ψ) = Nat.card Y := by
    refine (Nat.card_congr (Equiv.ofBijective (fun y : Y => (⟨ψ y, ⟨y, y.2, rfl⟩⟩ : Y.map ψ))
      ⟨fun y y' hyy => ?_, fun z => ?_⟩)).symm
    · have h := congrArg Subtype.val hyy
      simp only at h
      have : ψ ((y : H) * (y' : H)⁻¹) = 1 := by rw [map_mul, map_inv, h, mul_inv_cancel]
      have h1 := hinj _ (Y.mul_mem y.2 (Y.inv_mem y'.2)) this
      exact Subtype.ext (mul_inv_eq_one.1 h1)
    · obtain ⟨_, ⟨y, hy, rfl⟩⟩ := z
      exact ⟨⟨y, hy⟩, rfl⟩
  have hψx : orderOf (ψ x) = 13 := by
    have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
    refine orderOf_eq_prime (by rw [← map_pow, ← hx, pow_orderOf_eq_one, map_one]) fun h1 => ?_
    rcases hker x h1 with h | h
    · rw [h, orderOf_one] at hx; norm_num at hx
    · have : x ^ 2 = 1 := by rw [pow_two, h, ht2]
      have h2 := orderOf_dvd_of_pow_eq_one this
      rw [hx] at h2; norm_num at h2
  have hK := hQ hψx (Y.map ψ)
    (by
      rintro _ ⟨y, hy, rfl⟩
      rw [Subgroup.mem_centralizer_singleton_iff]
      rw [← map_mul, ← map_mul, Subgroup.mem_centralizer_singleton_iff.1 (hYC hy)])
    (by
      rintro b hb _ ⟨y, hy, rfl⟩
      obtain ⟨g, rfl⟩ := hψ b
      have hgx : g * x * g⁻¹ = x := by
        have h1 : ψ (g * x * g⁻¹ * x⁻¹) = 1 := by
          rw [map_mul, map_mul, map_mul, map_inv, map_inv,
            Subgroup.mem_centralizer_singleton_iff.1 hb, mul_inv_cancel_right, mul_inv_cancel]
        rcases hker _ h1 with h | h
        · exact mul_inv_eq_one.1 h
        · have hgt : g * x * g⁻¹ = t * x := by rw [← h]; group
          have hx13 : x ^ 13 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
          have hp : (g * x * g⁻¹) ^ 13 = 1 := by
            rw [show g * x * g⁻¹ = (MulAut.conj g) x by simp [MulAut.conj_apply], ← map_pow, hx13,
              map_one]
          rw [hgt, (show Commute t x from (htc x).symm).mul_pow, hx13, mul_one] at hp
          have ht13 : t ^ 13 = t := by
            rw [show (13 : ℕ) = 2 * 6 + 1 by norm_num, pow_succ, pow_mul, pow_two, ht2, one_pow,
              one_mul]
          rw [ht13] at hp
          rw [hgt, hp, one_mul]
      have hgC : g ∈ Subgroup.centralizer ({x} : Set H) := by
        rw [Subgroup.mem_centralizer_singleton_iff]
        calc g * x = g * x * g⁻¹ * g := by group
          _ = x * g := by rw [hgx]
      exact ⟨g * y * g⁻¹, hYn g hgC y hy, by simp only [map_mul, map_inv]⟩)
    (by rw [hcard]; exact hodd) (by rw [hcard]; exact h13)
  rw [hK, Subgroup.card_bot] at hcard
  exact Subgroup.eq_bot_of_card_eq Y hcard.symm

@[expose] def OddCoreProp {Q : Type*} [Group Q] (y : Q) : Prop :=
  ∀ K : Subgroup Q, K ≤ Subgroup.centralizer ({y} : Set Q) →
    (∀ g ∈ Subgroup.centralizer ({y} : Set Q), ∀ k ∈ K, g * k * g⁻¹ ∈ K) →
    Odd (Nat.card K) → ¬ 13 ∣ Nat.card K → K = ⊥

theorem OddCoreProp.of_mulEquiv {Q Q' : Type*} [Group Q] [Group Q'] (e : Q ≃* Q') {y : Q}
    (h : OddCoreProp (e y)) : OddCoreProp y := by
  intro K hKC hKn hodd h13
  have hcard : Nat.card (K.map e.toMonoidHom) = Nat.card K :=
    Subgroup.card_map_of_injective e.injective
  have hK := h (K.map e.toMonoidHom)
    (by
      rintro _ ⟨k, hk, rfl⟩
      rw [Subgroup.mem_centralizer_singleton_iff]
      simp only [MulEquiv.coe_toMonoidHom]
      rw [← map_mul, ← map_mul, Subgroup.mem_centralizer_singleton_iff.1 (hKC hk)])
    (by
      rintro g hg _ ⟨k, hk, rfl⟩
      have hg' : e.symm g ∈ Subgroup.centralizer ({y} : Set Q) := by
        rw [Subgroup.mem_centralizer_singleton_iff] at hg ⊢
        apply e.injective
        rw [map_mul, map_mul, MulEquiv.apply_symm_apply, hg]
      refine ⟨e.symm g * k * (e.symm g)⁻¹, hKn _ hg' k hk, ?_⟩
      simp only [MulEquiv.coe_toMonoidHom, map_mul, map_inv, MulEquiv.apply_symm_apply])
    (by rw [hcard]; exact hodd) (by rw [hcard]; exact h13)
  rw [hK, Subgroup.card_bot] at hcard
  exact Subgroup.eq_bot_of_card_eq K hcard.symm

theorem sq_mul_eq_one {G : Type*} [Group G] {a b : G} (ha : a * a = 1) (hb : b * b = 1)
    (hab : b * a = a * b) : (a * b) ^ 2 = 1 := by
  calc (a * b) ^ 2 = a * (b * a) * b := by simp only [pow_two, mul_assoc]
    _ = a * (a * b) * b := by rw [hab]
    _ = (a * a) * (b * b) := by group
    _ = 1 := by rw [ha, hb, one_mul]

theorem thirteen_a_facts :
    gw j1W * gw j1W = 1 ∧ gw j2W * gw j2W = 1 ∧ gw j2W * gw j1W = gw j1W * gw j2W ∧
      gw j1W * gw thirteenX = gw thirteenX * gw j1W ∧
      gw j2W * gw thirteenX = gw thirteenX * gw j2W ∧
      gw tj1W * gw j1W = gw tStarW * gw tj1W ∧ gw tj2W * gw j2W = gw tStarW * gw tj2W ∧
      gw tj12W * (gw j2W * gw j1W) = gw tStarW * gw tj12W ∧
      gw j1W ≠ 1 ∧ gw j2W ≠ 1 ∧ gw j2W * gw j1W ≠ 1 ∧
      ∀ e ∈ censusLines, gw (lineConjW e) * gw (lineRepW e) =
        gw (lineTargetW e) ^ e.lam * gw (lineConjW e) :=
  Certificates.certificate16959


theorem tGmat_mem_cent : tGmat ∈ cent tGmat := Subgroup.mem_centralizer_singleton_iff.2 rfl

theorem centToCbar_ker (g : cent tGmat) (hg : centToCbar g = 1) :
    g = 1 ∨ g = ⟨tGmat, tGmat_mem_cent⟩ := by
  have h2 : (g : Gmat) ∈ Subgroup.zpowers tGmat := by
    rw [← map_ker_centToCbar]
    exact ⟨g, hg, rfl⟩
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 h2
  rw [← zpow_mod_orderOf, orderOf_tGmat] at hk
  have h0 : 0 ≤ k % ((2 : ℕ) : ℤ) := Int.emod_nonneg _ (by norm_num)
  have h3 : k % ((2 : ℕ) : ℤ) < 2 := Int.emod_lt_of_pos _ (by norm_num)
  generalize k % ((2 : ℕ) : ℤ) = r at h0 h3 hk
  interval_cases r
  · left; apply Subtype.ext; rw [← hk, zpow_zero]; rfl
  · right; apply Subtype.ext; rw [← hk, zpow_one]

theorem oddCoreProp_Cbar (hB13 : BThirteenOddCore) (y : CFSG.Monster.B.Cbar) (hy : orderOf y = 13) :
    OddCoreProp y := by
  have hy' : orderOf (phiB y) = 13 := by rw [MulEquiv.orderOf_eq]; exact hy
  exact @OddCoreProp.of_mulEquiv CFSG.Monster.B.Cbar CFSG.Blueprint.NativeSporadic.B _ Units.instGroup
    phiB y
    (hB13 (phiB y) hy')

theorem inf_centralizer_tGmat_eq_bot (hB13 : BThirteenOddCore) {x' : Gmat}
    (hx't : x' * tGmat = tGmat * x') (hx' : orderOf x' = 13)
    (hodd : Odd (Nat.card (GLAPPrimeCoreOf 13 (Subgroup.centralizer ({x'} : Set Gmat))))) :
    GLAPPrimeCoreOf 13 (Subgroup.centralizer ({x'} : Set Gmat)) ⊓
      Subgroup.centralizer ({tGmat} : Set Gmat) = ⊥ := by
  have : Finite Gmat := generated_rational_group_finite_simple.2.2
  set N' := GLAPPrimeCoreOf 13 (Subgroup.centralizer ({x'} : Set Gmat)) with hN'
  set xH : cent tGmat := ⟨x', Subgroup.mem_centralizer_singleton_iff.2 hx't⟩ with hxH
  set tH : cent tGmat := ⟨tGmat, tGmat_mem_cent⟩ with htH
  set Y := N'.subgroupOf (cent tGmat) with hY
  have hxHo : orderOf xH = 13 := by rw [hxH, Subgroup.orderOf_mk]; exact hx'
  have ht2 : tH * tH = 1 := by
    apply Subtype.ext
    show tGmat * tGmat = 1
    rw [← pow_two, ← orderOf_tGmat, pow_orderOf_eq_one]
  have htc : ∀ g : cent tGmat, g * tH = tH * g := fun g =>
    Subtype.ext (Subgroup.mem_centralizer_singleton_iff.1 g.2)
  have hcardY : Nat.card Y = Nat.card (N' ⊓ cent tGmat : Subgroup Gmat) := by
    rw [← Subgroup.subgroupOf_map_subtype, Subgroup.card_map_of_injective (cent tGmat).subtype_injective]
  have hYdvd : Nat.card Y ∣ Nat.card N' := hcardY ▸ Subgroup.card_dvd_of_le inf_le_left
  have hoddY : Odd (Nat.card Y) := Odd.of_dvd_nat hodd hYdvd
  have h13Y : ¬ 13 ∣ Nat.card Y := fun h =>
    (Nat.Prime.coprime_iff_not_dvd (by norm_num)).1
      (coprime_card_GLAPPrimeCoreOf (by norm_num) _) (h.trans hYdvd)
  have hYbot := eq_bot_of_central_two_quotient centToCbar centToCbar_surjective ht2 htc
    centToCbar_ker hxHo (fun h13 => oddCoreProp_Cbar hB13 _ h13) (Y := Y)
    (fun y hy => Subgroup.mem_centralizer_singleton_iff.2 (Subtype.ext
      (Subgroup.mem_centralizer_singleton_iff.1 (GLAPPrimeCoreOf_le _ (Subgroup.mem_subgroupOf.1 hy)))))
    (fun g hg y hy => by
      rw [hY, Subgroup.mem_subgroupOf] at hy ⊢
      exact GLAPPrimeCoreOf_conj_mem (g : Gmat) (Subgroup.mem_centralizer_singleton_iff.2
        (congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.1 hg))) _ hy)
    hoddY h13Y
  rw [eq_bot_iff]
  intro n hn
  obtain ⟨hnN, hnt⟩ := Subgroup.mem_inf.1 hn
  have hnY : (⟨n, hnt⟩ : cent tGmat) ∈ Y := Subgroup.mem_subgroupOf.2 hnN
  rw [hYbot, Subgroup.mem_bot] at hnY
  exact Subgroup.mem_bot.2 (congrArg Subtype.val hnY)


theorem orderOf_xE : orderOf (gw thirteenX) = 13 := by
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  obtain ⟨hx, -, hz, hz1, -⟩ := thirteen_gw_facts
  refine orderOf_eq_prime hx fun h1 => hz1 ?_
  rw [← hz, h1, commutatorElement_def, one_mul, inv_one, mul_one, mul_inv_cancel]

theorem gLAPPrimeCoreOf_xE_eq_bot (hB13 : BThirteenOddCore)
    (hodd : ∀ s : Gmat, orderOf s = 13 →
      Odd (Nat.card (GLAPPrimeCoreOf 13 (Subgroup.centralizer ({s} : Set Gmat))))) :
    GLAPPrimeCoreOf 13 (Subgroup.centralizer ({gw thirteenX} : Set Gmat)) = ⊥ := by
  have : Finite Gmat := generated_rational_group_finite_simple.2.2
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  obtain ⟨hj1, hj2, hj12, hxj1, hxj2, hT1, hT2, hT12, hj1ne, hj2ne, hj12ne, -⟩ := thirteen_a_facts
  set N := GLAPPrimeCoreOf 13 (Subgroup.centralizer ({gw thirteenX} : Set Gmat)) with hN
  have hxo := orderOf_xE
  have key : ∀ α T : Gmat, α * gw thirteenX = gw thirteenX * α → T * α * T⁻¹ = tGmat →
      N ⊓ Subgroup.centralizer ({α} : Set Gmat) = ⊥ := by
    intro α T hαx hT
    rw [eq_bot_iff]
    intro n hn
    obtain ⟨hnN, hnα⟩ := Subgroup.mem_inf.1 hn
    have h1 := conj_mem_gLAPPrimeCoreOf_conj (m := T) (by norm_num : Nat.Prime 13) hnN
    have h2 := mem_centralizer_conj_of_mem (c := T) hnα
    rw [hT] at h2
    have hx't : T * gw thirteenX * T⁻¹ * tGmat = tGmat * (T * gw thirteenX * T⁻¹) := by
      rw [← hT]
      calc T * gw thirteenX * T⁻¹ * (T * α * T⁻¹) = T * (gw thirteenX * α) * T⁻¹ := by group
        _ = T * (α * gw thirteenX) * T⁻¹ := by rw [hαx]
        _ = T * α * T⁻¹ * (T * gw thirteenX * T⁻¹) := by group
    have hx'o : orderOf (T * gw thirteenX * T⁻¹) = 13 := by
      rw [show T * gw thirteenX * T⁻¹ = (MulAut.conj T) (gw thirteenX) by simp [MulAut.conj_apply],
        MulEquiv.orderOf_eq, hxo]
    have hbot := inf_centralizer_tGmat_eq_bot hB13 hx't hx'o (hodd _ hx'o)
    have h3 : T * n * T⁻¹ ∈ GLAPPrimeCoreOf 13
        (Subgroup.centralizer ({T * gw thirteenX * T⁻¹} : Set Gmat)) ⊓
        Subgroup.centralizer ({tGmat} : Set Gmat) := Subgroup.mem_inf.2 ⟨h1, h2⟩
    rw [hbot, Subgroup.mem_bot] at h3
    rw [Subgroup.mem_bot]
    have := congrArg (fun a => T⁻¹ * a * T) h3
    simpa [mul_assoc] using this
  have hj1t : gw tj1W * gw j1W * (gw tj1W)⁻¹ = tGmat := by
    rw [hT1, mul_inv_cancel_right, gw_tStarW]
  have hj2t : gw tj2W * gw j2W * (gw tj2W)⁻¹ = tGmat := by
    rw [hT2, mul_inv_cancel_right, gw_tStarW]
  have hj12t : gw tj12W * (gw j1W * gw j2W) * (gw tj12W)⁻¹ = tGmat := by
    rw [← hj12, hT12, mul_inv_cancel_right, gw_tStarW]
  have hxj12 : gw j1W * gw j2W * gw thirteenX = gw thirteenX * (gw j1W * gw j2W) := by
    rw [mul_assoc, hxj2, ← mul_assoc, hxj1, mul_assoc]
  set V := fourGroup (gw j1W) (gw j2W) hj1 hj2 hj12.symm with hV
  have hVx : ∀ v ∈ V, v * gw thirteenX = gw thirteenX * v := by
    rintro v (rfl | rfl | rfl | rfl)
    · simp
    · exact hxj1
    · exact hxj2
    · exact hxj12
  have hzero : ∀ v ∈ V, v ≠ 1 → N ⊓ Subgroup.centralizer ({v} : Set Gmat) = ⊥ := by
    intro v hv hv1
    rcases hv with h | h | h | h
    · exact absurd h hv1
    · rw [h]; exact key _ _ hxj1 hj1t
    · rw [h]; exact key _ _ hxj2 hj2t
    · rw [h]; exact key _ _ hxj12 hj12t
  have hj12ne' : gw j1W * gw j2W ≠ 1 := by rw [← hj12]; exact hj12ne
  have htwt : gw j1W * gw j2W ≠ gw j1W := fun h => hj2ne (by
    have := congrArg (fun g => (gw j1W)⁻¹ * g) h
    simpa using this)
  have htww : gw j1W * gw j2W ≠ gw j2W := fun h => hj1ne (by
    have := congrArg (fun g => g * (gw j2W)⁻¹) h
    simpa using this)
  have hwt : gw j2W ≠ gw j1W := fun h => hj12ne' (by rw [h, hj1])
  have hcard : Nat.card V = 2 ^ 2 := by
    have : Nat.card V = Set.ncard ({1, gw j1W, gw j2W, gw j1W * gw j2W} : Set Gmat) := by
