      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      exact ⟨Ne.symm hwt, Ne.symm htwt⟩
    rw [this, Set.ncard_insert_of_notMem hs1, Set.ncard_insert_of_notMem hs2,
      Set.ncard_pair htww.symm]
    norm_num
  have hpow : ∀ v : V, v ^ 2 = 1 := by
    rintro ⟨v, hv⟩
    apply Subtype.ext
    show v ^ 2 = 1
    rcases hv with h | h | h | h
    · rw [h, one_pow]
    · rw [h, pow_two, hj1]
    · rw [h, pow_two, hj2]
    · rw [h]; exact sq_mul_eq_one hj1 hj2 hj12
  have hoddN := hodd _ hxo
  have hgen := CFSG.RankThreeEvenClassification.Helpers.coprime_centralizer_generation_of_plane 2
    Nat.prime_two V N hpow hcard (fun h => (Nat.not_even_iff_odd.2 hoddN) (even_iff_two_dvd.2 h))
    (by
      intro v hv
      rw [Subgroup.mem_normalizer_iff]
      intro y
      have hvC : v ∈ Subgroup.centralizer ({gw thirteenX} : Set Gmat) :=
        Subgroup.mem_centralizer_singleton_iff.2 (hVx v hv)
      constructor
      · exact fun hy => GLAPPrimeCoreOf_conj_mem v hvC y hy
      · intro hy
        have := GLAPPrimeCoreOf_conj_mem v⁻¹ (Subgroup.inv_mem _ hvC) _ hy
        simpa [mul_assoc] using this)
  rw [hgen]
