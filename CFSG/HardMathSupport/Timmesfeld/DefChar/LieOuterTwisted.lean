theorem lieOuterRankFamReeG2 :
    LieOuterRankFam .reeG2 := by
  intro S _ _ _ _ idx hidx hS p hp hp2 D hD hcard
  obtain ⟨d, hv⟩ := idx
  obtain ⟨m, rfl⟩ := hidx
  obtain ⟨e0⟩ := hS
  have hm1 : 1 ≤ m :=
    (TauCeti.LieTypeIndex.inStandardRange_iff _).1 ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hK : Nat.card (GaloisField 3 (2 * m + 1)) = 3 ^ (2 * m + 1) :=
    GaloisField.card 3 (2 * m + 1) (by omega)
  have : CharP (GaloisField 3 (2 * m + 1)) ReeTag.G2.prime :=
    (inferInstance : CharP (GaloisField 3 (2 * m + 1)) 3)
  obtain ⟨b⟩ := CFSG.TauCetiBridge.reeG2Bridge m hv (GaloisField 3 (2 * m + 1)) hK
  have e1 : DerivedCentralQuotient (reeFixedGroup .G2 (GaloisField 3 (2 * m + 1)) reeG2Perm
      fun i => if i ∈ reeG2Long then 3 ^ m else 3 ^ (m + 1)) ≃*
        DerivedCentralQuotient (ReeTag.G2.reeGamma (GaloisField 3 (2 * m + 1)) m) := by
    rw [ReeTag.reeGamma_eq_reeFixedGroup]
    exact MulEquiv.refl _
  obtain ⟨E⟩ := ReeTag.nonempty_derivedCentralQuotient_mulEquiv_reeGamma_G2
    (K := GaloisField 3 (2 * m + 1)) hm1 hK
  let e : S ≃* ReeTag.G2.reeGamma (GaloisField 3 (2 * m + 1)) m :=
    ((e0.trans b.symm).trans e1).trans E
  exact exists_inner_transport e hp D hcard (fun a ha => hD.2 a ha)
    (fun D' hexp hc => exists_inner_of_elemAbelian_of_outerCyclic
      (frobeniusΓ : MulAut (ReeTag.G2.reeGamma (GaloisField 3 (2 * m + 1)) m))
      (exists_eq_conj_mul_frobeniusΓ_pow hm1 hK) hp D' hexp hc)


theorem lieOuterRankFamTrialityD4 :
    LieOuterRankFam .trialityD4 := by
  intro S _ _ _ _ idx hidx hS p hp hp2 D hD hcard
  obtain ⟨q, hr⟩ := hidx
  obtain ⟨d, hv⟩ := idx
  simp only at hr
  subst hr
  obtain ⟨e0⟩ := hS
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  let K := GaloisField q.p (3 * q.exponent)
  have hf : 1 ≤ q.exponent := q.exponent_pos
  have hKc : Nat.card K = (q.p ^ q.exponent) ^ TwistTag.D4.order := by
    change Nat.card (GaloisField q.p (3 * q.exponent)) = _
    rw [GaloisField.card _ _ (by have := q.exponent_pos; omega)]
    change _ = (q.p ^ q.exponent) ^ 3
    rw [← pow_mul, mul_comm]
  obtain ⟨σ, hσ, -⟩ := finite_graph_field_parameter_fields TwistTag.D4 q.prime_p hf K hKc
  have hK3 : Nat.card K = (q.p ^ q.exponent) ^ 3 := hKc
  have hΘ : ∃ Θ : MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) →* (K ≃+* K),
      Θ.ker = inner (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) ∧
      Nonempty (DerivedCentralQuotient (twistedFixedGroup TwistTag.D4 K σ.toRingHom) ≃*
        graphFixedRootGroup TwistTag.D4 K σ.toRingHom) := by
    by_cases h2 : q.p = 2
    · have hK3' : Nat.card K = (2 ^ q.exponent) ^ 3 := by rw [← h2]; exact hK3
      have hσ' : ∀ c, σ c = c ^ (2 ^ q.exponent) := by rw [← h2]; exact hσ
      obtain ⟨-, -, ⟨Θ, -, -, hΘker, -⟩, -, -, -, -, heC⟩ :=
        even_triality_exact_automorphism_normal_form hf K hK3' σ hσ'
      exact ⟨Θ, hΘker, heC⟩
    · obtain ⟨-, -, ⟨Θ, -, -, hΘker, -⟩, -, -, -, -, heC⟩ :=
        odd_triality_exact_automorphism_normal_form q.prime_p h2 hf K hK3 σ hσ
      exact ⟨Θ, hΘker, heC⟩
  obtain ⟨Θ, hΘker, ⟨eC⟩⟩ := hΘ
  have hcyc : IsCyclic (K ≃+* K) :=
    CFSG.ComponentClassification.CatalogueSchreierLinearTwo.fieldAut_isCyclic K
  have hqc : q.card = q.p ^ q.exponent := TauCeti.PrimePower.card_def q
  obtain ⟨eB⟩ := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.trialityD4 q hv K
    (by rw [hqc]; exact hK3) σ.toRingHom (fun x => by rw [hqc]; exact hσ x)
  have e : S ≃* graphFixedRootGroup TwistTag.D4 K σ.toRingHom :=
    e0.trans (eB.symm.trans eC)
  exact exists_inner_transport e hp D hcard (fun a ha => hD.2 a ha)
    (fun D' hexp hc => exists_inner_of_cyclic_hom Θ hp
      (fun x hx _ => by
        have : x ∈ Θ.ker := hx
        rw [hΘker] at this
        exact this)
      D' hexp hc)


theorem lot_exists_inner_of_two_step {M : Type} [Group M] (I : Subgroup M) [I.Normal] {Q : Type}
    [Group Q] [IsCyclic Q] (Θ : M →* Q) {p : ℕ} (hp : p.Prime)
    (hNfin : Finite ((Θ.ker).map (QuotientGroup.mk' I)))
    (hN : Nat.card ((Θ.ker).map (QuotientGroup.mk' I)) ≤ p)
    (D : Subgroup M) (hexp : ∀ a ∈ D, a ^ p = 1) (hcard : p ^ 2 < Nat.card D) :
    ∃ x ∈ D ⊓ I, x ≠ 1 := by
  classical
  have hDfin : Finite D := Nat.finite_of_card_ne_zero (by omega)
  let π := QuotientGroup.mk' I
  let α : D →* Q := Θ.comp D.subtype
  have hexpα : Monoid.exponent α.range ∣ p := by
    refine Monoid.exponent_dvd_of_forall_pow_eq_one fun y => ?_
    obtain ⟨x, rfl⟩ := α.rangeRestrict_surjective y
    have : (x : D) ^ p = 1 := Subtype.ext (hexp x x.2)
    rw [← map_pow, this, map_one]
  rw [IsCyclic.exponent_eq_card] at hexpα
  have hsplit : Nat.card D = Nat.card α.range * Nat.card α.ker := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup α.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivRange α).toEquiv]
  have hrle : Nat.card α.range ≤ p := Nat.le_of_dvd hp.pos hexpα
  let β : α.ker →* M ⧸ I := π.comp (D.subtype.comp α.ker.subtype)
  have hsplitB : Nat.card α.ker = Nat.card β.range * Nat.card β.ker := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup β.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivRange β).toEquiv]
  have hβr : Nat.card β.range ≤ p := by
    refine le_trans ?_ hN
    refine Subgroup.card_le_of_le ?_
    rintro _ ⟨x, rfl⟩
    have hx : ((x : D) : M) ∈ Θ.ker := x.2
    exact ⟨((x : D) : M), hx, rfl⟩
  have hk1 : 1 < Nat.card β.ker := by
    by_contra hle
    have h1 : Nat.card D ≤ p * (p * 1) := by
      rw [hsplit, hsplitB]
      exact Nat.mul_le_mul hrle (Nat.mul_le_mul hβr (by omega))
    nlinarith
  have : Finite β.ker := Nat.finite_of_card_ne_zero (by omega)
  have : Nontrivial β.ker := Finite.one_lt_card_iff_nontrivial.1 hk1
  obtain ⟨⟨⟨⟨d, hdD⟩, hdα⟩, hdβ⟩, hd1⟩ := exists_ne (1 : β.ker)
  refine ⟨d, ⟨hdD, ?_⟩, fun h => hd1 (Subtype.ext (Subtype.ext (Subtype.ext h)))⟩
  exact (QuotientGroup.eq_one_iff d).1 hdβ


section E6

variable {K : Type} [Field K]

noncomputable def lot_e6CompatHom (σ : K ≃+* K) :
    ((a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) →*
      compatSubgroup (t := TwistTag.E6) σ.toRingHom where
  toFun u := ⟨compatDiag TwistTag.E6 σ.toRingHom u, compatDiag_perm u⟩
  map_one' := Subtype.ext compatDiag_one
  map_mul' u v := Subtype.ext (compatDiag_mul u v)

theorem lot_compatDiagAutHom_mem_inner_of_cartan
    (σ : K ≃+* K)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ)
    (c : compatSubgroup (t := TwistTag.E6) σ.toRingHom)
    (h : zpowMatrix (G := Kˣ) TwistTag.E6.tag.cartan c.1 =
      compatDiag TwistTag.E6 σ.toRingHom u) :
    compatDiagAutHom TwistTag.E6 K σ.toRingHom u ∈ twistedE6Inn K σ := by
  have hT : (torusCoordHom TwistTag.E6.tag K c.1 : ModGL TwistTag.E6.tag K) ∈
      compatTorus (t := TwistTag.E6) σ.toRingHom :=
    (mem_compatTorus σ.toRingHom).2 ⟨c.1, c.2, rfl⟩
  have h' := compatTorus_le_graphFixedRootGroup (t := TwistTag.E6) (K := K) σ.toRingHom hT
  have hmem : rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u) ∈
      graphFixedRootGroup TwistTag.E6 K σ.toRingHom := by
    rwa [torusCoordHom_eq_rootDiagUnit, h] at h'
  refine ⟨⟨_, hmem⟩, ?_⟩
  refine MulEquiv.ext fun g => Subtype.ext ?_
  rw [coe_compatDiagAutHom]
  simp only [MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv]

theorem lot_zpowMatrix_cartan_mem_compat' (σ : K ≃+* K)
    {c : Fin TwistTag.E6.tag.rank → Kˣ} (hc : c ∈ compatSubgroup (t := TwistTag.E6) σ.toRingHom) :
    zpowMatrix (G := Kˣ) TwistTag.E6.tag.cartan c ∈
      compatSubgroup (t := TwistTag.E6) σ.toRingHom := by
  intro j
  simp only [zpowMatrix_apply, map_prod, map_zpow]
  rw [← Equiv.prod_comp TwistTag.E6.perm]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [hc i, TwistTag.cartan_perm]

noncomputable def lot_e6CartanHom (σ : K ≃+* K) :
    compatSubgroup (t := TwistTag.E6) σ.toRingHom →*
      compatSubgroup (t := TwistTag.E6) σ.toRingHom :=
  ((zpowMatrix (G := Kˣ) TwistTag.E6.tag.cartan).domRestrict
    (compatSubgroup (t := TwistTag.E6) σ.toRingHom)).codRestrict
      (compatSubgroup (t := TwistTag.E6) σ.toRingHom)
      (fun c => lot_zpowMatrix_cartan_mem_compat' σ c.2)

theorem lot_card_range_diag_outer_le_three [Finite K] {q : ℕ}
    (hK : Nat.card K = q ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ q) :
    Nat.card ((QuotientGroup.mk' (twistedE6Inn K σ)).comp
      (compatDiagAutHom TwistTag.E6 K σ.toRingHom)).range ≤ 3 := by
  classical
  set S := compatSubgroup (t := TwistTag.E6) σ.toRingHom with hS
  set Z' := lot_e6CartanHom σ with hZ'
  have hI : Z'.range.Normal := Subgroup.normal_of_isMulCommutative _
  let π1 : ((a : Fin TwistTag.E6.foldedTag.rank) → (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) →*
      S ⧸ Z'.range := (QuotientGroup.mk' Z'.range).comp (lot_e6CompatHom σ)
  set ψ := (QuotientGroup.mk' (twistedE6Inn K σ)).comp
      (compatDiagAutHom TwistTag.E6 K σ.toRingHom) with hψ
  have hle : π1.ker ≤ ψ.ker := by
    intro u hu
    have hu' : lot_e6CompatHom σ u ∈ Z'.range := (QuotientGroup.eq_one_iff _).1 hu
    obtain ⟨c, hc⟩ := hu'
    have hinner := lot_compatDiagAutHom_mem_inner_of_cartan σ u c (congrArg Subtype.val hc)
    exact (QuotientGroup.eq_one_iff _).2 hinner
  have h1 : Nat.card ψ.range = ψ.ker.index := (Subgroup.index_ker ψ).symm
  have h2 : ψ.ker.index ∣ π1.ker.index := Subgroup.index_dvd_of_le hle
  have h3 : π1.ker.index = Nat.card π1.range := Subgroup.index_ker π1
  have h4 : Nat.card π1.range ≤ Z'.range.index :=
    Nat.card_le_card_of_injective (Subtype.val : π1.range → S ⧸ Z'.range) Subtype.val_injective
  have h5 : Z'.range.index = Nat.card Z'.ker := by
    have e1 : Nat.card S = Nat.card Z'.range * Nat.card Z'.ker := by
      rw [Subgroup.card_eq_card_quotient_mul_card_subgroup Z'.ker,
        Nat.card_congr (QuotientGroup.quotientKerEquivRange Z').toEquiv]
    have e2 : Nat.card Z'.range * Z'.range.index = Nat.card S := Subgroup.card_mul_index _
    have hpos : 0 < Nat.card Z'.range := Nat.card_pos
    exact Nat.eq_of_mul_eq_mul_left hpos (e2.trans e1)
  have h6 : Nat.card Z'.ker ≤ 3 := by
    have hinj : Function.Injective (fun x : Z'.ker =>
        (⟨(x : S).1, Subgroup.mem_inf.2 ⟨(x : S).2, by
          have hx : Z' (x : S) = 1 := x.2
          have := congrArg Subtype.val hx
          exact this⟩⟩ :
        ↥(S ⊓ (zpowMatrix (G := Kˣ) TwistTag.E6.tag.cartan).ker))) := by
      intro x y hxy
      have h := congrArg Subtype.val hxy
      exact Subtype.ext (Subtype.ext h)
    have := Nat.card_le_card_of_injective _ hinj
    rw [hS, card_compat_inf_ker_E6_of_card hK hσ] at this
    exact this.trans (Nat.gcd_le_left _ (by norm_num))
  have hpos : 0 < π1.ker.index := by
    rw [h3]; exact Nat.card_pos
  calc Nat.card ψ.range = ψ.ker.index := h1
    _ ≤ π1.ker.index := Nat.le_of_dvd hpos h2
    _ ≤ 3 := by rw [h3]; exact h4.trans (h5 ▸ h6)

end E6


theorem lot_exists_inner_transport_sq {S C : Type} [Group S] [Group C] (e : S ≃* C) {p : ℕ}
    (hp : p.Prime) (D : Subgroup (MulAut S)) (hcard : Nat.card D = p ^ 3)
    (hD : ∀ a ∈ D, a ^ p = 1)
    (H : ∀ D' : Subgroup (MulAut C), (∀ a ∈ D', a ^ p = 1) → p ^ 2 < Nat.card D' →
      ∃ x ∈ D' ⊓ inner C, x ≠ 1) :
    ∃ x ∈ D ⊓ CFSG.HardMathSupport.Solomon.LocalBalance.innerAut S, x ≠ 1 := by
  set φ := MulAut.congr e with hφ
  have hcardD : Nat.card (D.map φ.toMonoidHom) = p ^ 3 := by
    rw [Subgroup.card_map_of_injective φ.injective]; exact hcard
  obtain ⟨x', ⟨hx'D, hx'I⟩, hx'1⟩ := H (D.map φ.toMonoidHom)
    (by
      rintro _ ⟨a, ha, rfl⟩
      change φ a ^ p = 1
      rw [← map_pow, hD a ha, map_one])
    (by
      rw [hcardD]
      exact Nat.pow_lt_pow_right hp.one_lt (by norm_num))
  obtain ⟨x, hxD, rfl⟩ := hx'D
  obtain ⟨g, hg⟩ := hx'I
  refine ⟨x, ⟨hxD, e.symm g, ?_⟩, fun h => hx'1 (by simp [h])⟩
  apply φ.injective
  change _ = φ.toMonoidHom x
  rw [← hg]
  ext s
  simp [hφ, MulAut.congr_apply]

theorem lieOuterRankFamTwistedE6 :
    LieOuterRankFam .twistedE6 := by
  intro S _ _ _ _ idx hidx hS p hp hp2 D hD hcard
  obtain ⟨q, hr⟩ := hidx
  obtain ⟨d, hv⟩ := idx
  simp only at hr
  subst hr
  obtain ⟨e0⟩ := hS
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  let K := GaloisField q.p (2 * q.exponent)
  have hf : 1 ≤ q.exponent := q.exponent_pos
  have hKc : Nat.card K = (q.p ^ q.exponent) ^ TwistTag.E6.order := by
    change Nat.card (GaloisField q.p (2 * q.exponent)) = _
    rw [GaloisField.card _ _ (by have := q.exponent_pos; omega)]
    change _ = (q.p ^ q.exponent) ^ 2
    rw [← pow_mul, mul_comm]
  obtain ⟨σ, hσ, -⟩ := finite_graph_field_parameter_fields TwistTag.E6 q.prime_p hf K hKc
  have hK2 : Nat.card K = (q.p ^ q.exponent) ^ 2 := hKc
  obtain ⟨-, -, -, -, -, -, -, -, ⟨Θ, -, -, hΘker, -, -, -⟩, -, -, -, ⟨eC⟩, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form q.prime_p hf K hK2 σ hσ
  have hqc : q.card = q.p ^ q.exponent := TauCeti.PrimePower.card_def q
  obtain ⟨eB⟩ := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.twistedE6 q hv K
    (by rw [hqc]; exact hK2) σ.toRingHom (fun x => by rw [hqc]; exact hσ x)
  have e : S ≃* graphFixedRootGroup TwistTag.E6 K σ.toRingHom :=
    e0.trans (eB.symm.trans eC)
  have hcyc : IsCyclic (K ≃+* K) :=
    CFSG.ComponentClassification.CatalogueSchreierLinearTwo.fieldAut_isCyclic K
  have hinn : (inner (twistedE6RootGroup K σ)).Normal :=
    CFSG.ComponentClassification.OuterAutomorphisms.inner_normal _
  have h3p : 3 ≤ p := by have := hp.two_le; omega
  have hψ := lot_card_range_diag_outer_le_three hK2 σ hσ
  have hN1 : (Θ.ker).map (QuotientGroup.mk' (inner (twistedE6RootGroup K σ))) ≤
      ((QuotientGroup.mk' (twistedE6Inn K σ)).comp
        (compatDiagAutHom TwistTag.E6 K σ.toRingHom)).range := by
    rintro _ ⟨x, hx, rfl⟩
    rw [hΘker] at hx
    obtain ⟨y, hy, z, ⟨u, rfl⟩, hyz⟩ := Subgroup.mem_sup_of_normal_left.1 hx
    refine ⟨u, ?_⟩
    change QuotientGroup.mk' (twistedE6Inn K σ) (compatDiagAutHom TwistTag.E6 K σ.toRingHom u) = _
    have hy1 : QuotientGroup.mk' (inner (twistedE6RootGroup K σ)) y = 1 :=
      (QuotientGroup.eq_one_iff y).2 hy
    rw [← hyz, map_mul, hy1, one_mul]
  have hfin : Finite ((QuotientGroup.mk' (twistedE6Inn K σ)).comp
        (compatDiagAutHom TwistTag.E6 K σ.toRingHom)).range := inferInstance
  have hNfin : Finite ((Θ.ker).map (QuotientGroup.mk' (inner (twistedE6RootGroup K σ)))) :=
    Finite.of_injective (Subgroup.inclusion hN1) (Subgroup.inclusion_injective hN1)
  have hN : Nat.card ((Θ.ker).map (QuotientGroup.mk' (inner (twistedE6RootGroup K σ)))) ≤ p :=
    (Subgroup.card_le_of_le hN1).trans (hψ.trans h3p)
  exact lot_exists_inner_transport_sq e hp D hcard (fun a ha => hD.2 a ha)
    (fun D' hexp hc => lot_exists_inner_of_two_step (inner (twistedE6RootGroup K σ)) Θ hp hNfin hN
      D' hexp hc)

end CFSG.HardMathSupport.Timmesfeld.DefChar
