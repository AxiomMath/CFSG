theorem lot_exists_inner_of_isCyclic_outer {G : Type} [Group G] (hc : IsCyclic (Outer G)) {p : ℕ}
    (hp : p.Prime) (D : Subgroup (MulAut G)) (hexp : ∀ a ∈ D, a ^ p = 1)
    (hcard : p < Nat.card D) : ∃ x ∈ D ⊓ inner G, x ≠ 1 :=
  exists_inner_of_cyclic_hom (Q := Outer G) (QuotientGroup.mk' (inner G)) hp
    (fun x hx _ => (QuotientGroup.eq_one_iff x).1 hx) D hexp hcard

theorem lieOuterRankFamSuzuki : LieOuterRankFam .suzuki := by
  intro S _ _ _ _ idx hidx hS p hp hp2 D hD hcard
  obtain ⟨d, hv⟩ := idx
  obtain ⟨m, rfl⟩ := hidx
  obtain ⟨e0⟩ := hS
  have hM : SuzukiModel S 2 (2 * m + 1) :=
    CFSG.SectionRank.suzukiModel_of_mulEquiv e0
      (CFSG.RankThree.PartTwo.Sec4.Census.suzukiModel_of_index m hv)
  have hc := (CFSG.LieType.Suzuki.Suzuki_model_and_perfect_cover_outer_cyclicity.{0} S 2 _ hM).1.1
  exact lot_exists_inner_of_isCyclic_outer hc hp D (fun a ha => hD.2 a ha)
    (by rw [hcard]; simpa using Nat.pow_lt_pow_right hp.one_lt (show 1 < 3 by norm_num))


open TauCeti CFSG.Assembly.LowTwoRank in
theorem lot_reeTitsModel_twistedF4_of_index
    {S : Type} [Group S] (m : ℕ) (hv : (LieTypeIndex.reeF4 m).Valid)
    (e : S ≃* (CFSGIndex.lie ⟨.reeF4 m, hv⟩).Group) : ReeTitsModel S .twistedF4 2 (2 * m + 1) := by
  have hfin : ∀ d : ReeF4LieIndex, Finite d.1.fixedField := fun _ => inferInstance
  have hchar : ∀ d : ReeF4LieIndex, CharP d.1.fixedField 2 := fun _ => inferInstance
  have := hfin (ReeF4LieIndex.of m hv)
  have := hchar (ReeF4LieIndex.of m hv)
  have hm : 1 ≤ m :=
    (LieTypeIndex.inStandardRange_iff _).1 ((LieTypeIndex.valid_iff _).1 hv).1
  have hhalf : (ReeF4LieIndex.of m hv).toSuzukiReeIndex.halfExponent = m :=
    SuzukiReeIndex.halfExponent_reeF4 m hv
  obtain ⟨e₁⟩ := CFSG.TauCetiBridge.ReeF4.nonempty_candidate_equiv_reeF4 (ReeF4LieIndex.of m hv)
  rw [hhalf] at e₁
  have hK := CFSG.TauCetiBridge.ReeF4.card_fixedField_reeF4 (ReeF4LieIndex.of m hv)
  rw [hhalf] at hK
  exact ⟨⟨Nat.prime_two, by omega, ⟨rfl, rfl, ⟨m, rfl⟩, by omega⟩⟩, m, rfl,
    ⟨(ReeF4LieIndex.of m hv).1.fixedField, inferInstance, inferInstance, hK,
      ⟨(e.trans e₁).trans (CFSG.TauCetiBridge.ReeF4.nativeModelEquiv m).symm⟩⟩⟩

