theorem lot_exists_inner_of_isPGroup_two_outer {G : Type} [Group G] (h2 : IsPGroup 2 (Outer G))
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (D : Subgroup (MulAut G)) (hexp : ∀ a ∈ D, a ^ p = 1)
    (hcard : 1 < Nat.card D) : ∃ x ∈ D ⊓ inner G, x ≠ 1 := by
  have : Finite D := Nat.finite_of_card_ne_zero (by omega)
  have : Nontrivial D := Finite.one_lt_card_iff_nontrivial.1 hcard
  obtain ⟨⟨d, hd⟩, hd1⟩ := exists_ne (1 : D)
  have hd1' : d ≠ 1 := fun h => hd1 (Subtype.ext h)
  refine ⟨d, ⟨hd, ?_⟩, hd1'⟩
  have hp' : (QuotientGroup.mk' (inner G) d) ^ p = 1 := by
    rw [← map_pow, hexp d hd, map_one]
  obtain ⟨k, hk⟩ := h2 (QuotientGroup.mk' (inner G) d)
  have h1 : orderOf (QuotientGroup.mk' (inner G) d) ∣ p := orderOf_dvd_of_pow_eq_one hp'
  have h2' : orderOf (QuotientGroup.mk' (inner G) d) ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hk
  have hcop : Nat.Coprime p (2 ^ k) :=
    Nat.Coprime.pow_right _ ((Nat.coprime_primes hp Nat.prime_two).2 hp2)
  have h3 : orderOf (QuotientGroup.mk' (inner G) d) = 1 :=
    Nat.eq_one_of_dvd_coprimes hcop h1 h2'
  exact (QuotientGroup.eq_one_iff d).1 (orderOf_eq_one_iff.1 h3)

