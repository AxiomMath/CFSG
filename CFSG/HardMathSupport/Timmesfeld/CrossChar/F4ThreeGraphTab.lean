@[expose] def f4Kills (c : Fin 4 → Fin 3) (γ : Fin 4 → ℤ) : Prop :=
  (∑ i, ((c i : ℕ) : ℤ) * γ i) % 3 = 0

instance (c : Fin 4 → Fin 3) (γ : Fin 4 → ℤ) : Decidable (f4Kills c γ) := by
  unfold f4Kills
  infer_instance

@[expose] def f4iform (x y : Fin 4 → ℤ) : ℤ := iform (τ := Tag.F4) x y

@[expose] def f4cp (β v : Fin 4 → ℤ) : ℤ := corootPair (τ := Tag.F4) β v

@[expose] def f4vec (l : List ℤ) : Fin 4 → ℤ := fun i => l.getD i 0

@[expose] def f4row (M : List (List ℤ)) (k : ℕ) : Fin 4 → ℤ := f4vec (M.getD k [])

@[expose] def F4LeftInv (r : ℕ) (R A : List (List ℤ)) (D : ℤ) : Prop :=
  ∀ k j : Fin r, ∑ i, f4row A k i * f4cp (f4row R j) (Pi.single i 1) = if k = j then D else 0

instance (r : ℕ) (R A : List (List ℤ)) (D : ℤ) : Decidable (F4LeftInv r R A D) := by
  unfold F4LeftInv
  infer_instance

@[expose] def F4R3Good (c : Fin 4 → Fin 3) (R A : List (List ℤ)) (D : ℤ) : Prop :=
  (∀ k : Fin 3, List.ofFn (f4row R k) ∈ Tag.F4.artifactRoots) ∧
    (∀ k : Fin 3, f4Kills c (f4row R k)) ∧
    f4iform (f4row R 0) (f4row R 1) ≠ 0 ∧ f4iform (f4row R 1) (f4row R 2) ≠ 0 ∧
    F4LeftInv 3 R A D ∧ (D = 1 ∨ D = -1 ∨ D = 2 ∨ D = -2)

instance (c : Fin 4 → Fin 3) (R A : List (List ℤ)) (D : ℤ) : Decidable (F4R3Good c R A D) := by
  unfold F4R3Good
  infer_instance

@[expose] def F4R22Good (c : Fin 4 → Fin 3) (R A : List (List ℤ)) (D : ℤ)
    (R' A' : List (List ℤ)) (D' : ℤ) : Prop :=
  (∀ k : Fin 2, List.ofFn (f4row R k) ∈ Tag.F4.artifactRoots) ∧
    (∀ k : Fin 2, List.ofFn (f4row R' k) ∈ Tag.F4.artifactRoots) ∧
    (∀ k : Fin 2, f4Kills c (f4row R k)) ∧ (∀ k : Fin 2, f4Kills c (f4row R' k)) ∧
    f4cp (f4row R 0) (f4row R 1) = -1 ∧ f4cp (f4row R 1) (f4row R 0) = -1 ∧
    f4iform (f4row R' 0) (f4row R' 1) ≠ 0 ∧
    f4iform (f4row R 0) (f4row R 0) = 4 ∧ f4iform (f4row R' 0) (f4row R' 0) ≠ 4 ∧
    (∀ l ∈ Tag.F4.artifactRoots.filter (fun l => decide (f4Kills c (f4vec l))),
      ∀ l' ∈ Tag.F4.artifactRoots.filter (fun l => decide (f4Kills c (f4vec l))),
        f4iform (f4vec l) (f4vec l') ≠ 0 →
          (f4iform (f4vec l) (f4vec l) = 4 ↔ f4iform (f4vec l') (f4vec l') = 4)) ∧
    F4LeftInv 2 R A D ∧ F4LeftInv 2 R' A' D' ∧
    (D = 1 ∨ D = -1 ∨ D = 2 ∨ D = -2) ∧ (D' = 1 ∨ D' = -1 ∨ D' = 2 ∨ D' = -2)

instance (c : Fin 4 → Fin 3) (R A : List (List ℤ)) (D : ℤ) (R' A' : List (List ℤ)) (D' : ℤ) :
    Decidable (F4R22Good c R A D R' A' D') := by
  unfold F4R22Good
  infer_instance

