@[expose] def regimeG2 (idx : TauCeti.ValidLieTypeIndex) (p : ℕ) : Prop :=
  ∃ q : TauCeti.PrimePower, idx.1 = .G2 q ∧ ¬ p ∣ q.card ^ 2 - 1

@[expose] def regimeG2Inner (idx : TauCeti.ValidLieTypeIndex) (p : ℕ) : Prop :=
  ∃ q : TauCeti.PrimePower, idx.1 = .G2 q ∧ 5 ≤ p ∧ ¬ p ∣ q.exponent

@[expose] def regimeG2Vac (idx : TauCeti.ValidLieTypeIndex) (p : ℕ) : Prop :=
  regimeG2 idx p ∨ regimeG2Inner idx p

section G2


theorem exists_hom_cyclic_G2 (q : TauCeti.PrimePower) (hq : 3 ≤ q.card) (K : Type) [Field K]
    [Finite K] [CharP K q.p] (hK : Nat.card K = q.card) :
    ∃ (Q : Type) (_ : Group Q) (_ : IsCyclic Q) (Θ : MulAut (adjointGroup .G2 K) →* Q),
      Nat.card Q ∣ 2 * q.exponent ∧
      Θ.ker = (MulAut.conj : adjointGroup .G2 K →* MulAut (adjointGroup .G2 K)).range := by
  have hK' : Nat.card K = q.p ^ q.exponent := hK.trans (TauCeti.PrimePower.card_def q)
  obtain ⟨-, -, -, -, hcard, -⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_automorphism_fixed_field_cardinality
      q.prime_p q.exponent_pos hK'
  have hdvd : Nat.card (K ≃+* K) ∣ 2 * q.exponent := by
    rw [hcard]
    exact Dvd.intro_left 2 rfl
  by_cases h2 : q.p = 2
  · have hf2 : 2 ≤ q.exponent := by
      by_contra hlt
      have h1 : q.exponent = 1 := by have := q.exponent_pos; omega
      rw [TauCeti.PrimePower.card_def, h2, h1] at hq
      omega
    obtain ⟨-, Θ, -, -, hker, -⟩ :=
      CFSG.ComponentClassification.UnbalancedCatalog.even_G2_exact_automorphism_normal_form
        hf2 K (by rw [hK', h2])
    exact ⟨_, _, fieldAut_isCyclic K, Θ, hdvd, hker⟩
  by_cases h3 : q.p = 3
  · have : CharP K ReeTag.G2.prime := by
      rw [show ReeTag.G2.prime = 3 from rfl, ← h3]
      infer_instance
    obtain ⟨-, -, ⟨Θ, -, -, hker⟩, -⟩ :=
      G2_three_exact_automorphism_normal_form q.exponent_pos K (by rw [hK', h3])
    have : NeZero (2 * q.exponent) := ⟨by have := q.exponent_pos; omega⟩
    refine ⟨_, _, inferInstance, Θ, ?_, hker⟩
    rw [Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card]
  · obtain ⟨-, Θ, -, -, hker, -⟩ := odd_F4_and_nonexceptional_G2_automorphism_normal_form
      q.prime_p h2 q.exponent_pos K hK' .G2 (Or.inr ⟨rfl, h3⟩)
    exact ⟨_, _, fieldAut_isCyclic K, Θ, hdvd, hker⟩

end G2

section Cat


theorem rankLE1_cat_G2 (q : TauCeti.PrimePower) (hv : (TauCeti.LieTypeIndex.G2 q).Valid) {p : ℕ}
    (hp : p.Prime) (hp5 : 5 ≤ p) (hpq : p ≠ q.p) (hnd : ¬ p ∣ q.card ^ 2 - 1) :
    RankLE1 p (Cat ⟨.G2 q, hv⟩) := by
  obtain ⟨K, _, _, hK, hKc, ⟨e⟩⟩ := exists_catEquiv_adjointGroup Even.chevalleyBridgesAll.g2 q hv
  have : Finite (ModGL .G2 K) := finite_modGL
  have hK' : Nat.card K = q.p ^ q.exponent := hK.trans (TauCeti.PrimePower.card_def q)
  have hpK : ¬ p ∣ Nat.card K := by
    rw [hK]
    exact not_dvd_card_of_ne hp hpq
  rw [← hK] at hnd
  refine RankLE1.of_mulEquiv e.symm (rankLE1_of_pRank hp fun hdvd => ?_)
  by_cases h2 : q.p = 2
  · have : CharP K 2 := h2 ▸ hKc
    exact CFSG.RankThree.PartOne.K128.pRank_le_one_G2 K hp hp5 (by rw [hK', h2]) q.exponent_pos
      hdvd hnd
  · have hodd : Odd (Nat.card K) := by
      rw [hK']
      exact (q.prime_p.odd_of_ne_two h2).pow
    exact pRank_le_one_adjointG2_odd K hodd hp hp5 hpK hdvd hnd

theorem conj_injective_cat_G2 (q : TauCeti.PrimePower) (hv : (TauCeti.LieTypeIndex.G2 q).Valid) :
    Function.Injective (MulAut.conj : Cat ⟨.G2 q, hv⟩ →* MulAut (Cat ⟨.G2 q, hv⟩)) := by
  obtain ⟨K, _, _, -, -, ⟨e⟩⟩ := exists_catEquiv_adjointGroup Even.chevalleyBridgesAll.g2 q hv
  exact conj_injective_of_mulEquiv e (conj_injective_of_center_eq_bot
    (center_adjointGroup_eq_bot (τ := .G2) (K := K)))

theorem crossCharFamAt_G2 : CrossCharFamAt .G2 regimeG2 := by
  rintro ⟨d, hv⟩ _ p hp hp2 hc ⟨q, hd, hnd⟩
  change d = _ at hd
  subst hd
  have hpq : p ≠ q.p := fun h => hc (by simp [h])
  have hp5 := five_le_of_not_dvd_sq_sub_one hp hp2 (not_dvd_card_of_ne hp hpq) hnd
  have hq3 : 3 ≤ q.card := (TauCeti.LieTypeIndex.inStandardRange_iff (.G2 q)).1
    ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
  obtain ⟨K, _, _, hK, _, ⟨e⟩⟩ := exists_catEquiv_adjointGroup Even.chevalleyBridgesAll.g2 q hv
  obtain ⟨Q, _, _, Θ, -, hker⟩ := exists_hom_cyclic_G2 q hq3 K hK
  exact isLocallyBalancedAbs_of_rankLE1 e Θ hp (fun x hx _ => hker ▸ hx)
    (conj_injective_cat_G2 q hv) (rankLE1_cat_G2 q hv hp hp5 hpq hnd)

theorem crossCharFamAt_G2_inner : CrossCharFamAt .G2 regimeG2Inner := by
  rintro ⟨d, hv⟩ _ p hp hp2 hc ⟨q, hd, hp5, hf⟩
  change d = _ at hd
  subst hd
  have hpq : p ≠ q.p := fun h => hc (by simp [h])
  have hq3 : 3 ≤ q.card := (TauCeti.LieTypeIndex.inStandardRange_iff (.G2 q)).1
    ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
  obtain ⟨K, _, _, hK, _, ⟨e⟩⟩ := exists_catEquiv_adjointGroup Even.chevalleyBridgesAll.g2 q hv
  obtain ⟨Q, _, _, Θ, hQ, hker⟩ := exists_hom_cyclic_G2 q hq3 K hK
  have hpK : ¬ p ∣ Nat.card K := by
    rw [hK]
    exact not_dvd_card_of_ne hp hpq
  have hcop : Nat.Coprime p (Nat.card Q) := Nat.Coprime.coprime_dvd_right hQ
    (Nat.Coprime.mul_right (Nat.coprime_two_right.2 (hp.odd_of_ne_two hp2))
      ((Nat.Prime.coprime_iff_not_dvd hp).2 hf))
  exact isLocallyBalancedAbs_of_rankLE2 e Θ hp hcop (fun x hx _ => hker ▸ hx)
    (conj_injective_cat_G2 q hv)
    (RankLE2.of_mulEquiv e.symm (rankLE2_adjointGroup_G2 K hp hp5 hpK))

theorem crossCharFamAt_G2_vac : CrossCharFamAt .G2 regimeG2Vac :=
  crossCharFamAt_G2.or crossCharFamAt_G2_inner

