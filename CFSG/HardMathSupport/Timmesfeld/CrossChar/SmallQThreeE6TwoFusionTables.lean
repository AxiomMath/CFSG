@[expose] def gOf (a b : ZMod 3) : G9 := (Multiplicative.ofAdd a, Multiplicative.ofAdd b)

@[expose] def normG (g : G9) (v : Fin 4 → ZMod 3) : Fin 4 → ZMod 3 :=
  v + actG g v + actG g (actG g v)

theorem g9_cases : ∀ g : G9, g ≠ 1 →
    (g = gOf 0 1 ∨ g = gOf 1 0 ∨ g = gOf 1 1 ∨ g = gOf 2 1) ∨
      (g⁻¹ = gOf 0 1 ∨ g⁻¹ = gOf 1 0 ∨ g⁻¹ = gOf 1 1 ∨ g⁻¹ = gOf 2 1) := by
  decide

