@[expose] noncomputable def RG : Subgroup GL14 :=
  (adjointGroup .G2 (ZMod 3)).map (glHom (RingEquiv.refl (ZMod 3)))

theorem mem_RG_of_val {g : GL14} (i : Fin Tag.G2.rank)
    (h : (g : M14) = XMat (ZMod 3) i 1 ∨ (g : M14) = YMat (ZMod 3) i 1) : g ∈ RG := by
  have hinj := (endEquiv (RingEquiv.refl (ZMod 3))).injective
  refine ⟨(glEquiv (RingEquiv.refl (ZMod 3))).symm g, Subgroup.subset_closure ⟨i, 1, ?_⟩, by
    rw [glHom_apply, MulEquiv.apply_symm_apply]⟩
  have hg : endEquiv (RingEquiv.refl (ZMod 3))
      ((glEquiv (RingEquiv.refl (ZMod 3))).symm g : Module.End (ZMod 3) _) = (g : M14) := by
    rw [← coe_glEquiv, MulEquiv.apply_symm_apply]
  rcases h with h | h
  · exact Or.inl (hinj (by rw [hg, h, endEquiv_xOp, map_one]))
  · exact Or.inr (hinj (by rw [hg, h, endEquiv_yOp, map_one]))

theorem XMat_xa : XMat (ZMod 3) (ix 1) 1 = Lxa := by decide +kernel
theorem XMat_xb : XMat (ZMod 3) (ix 0) 1 = Lxb := by decide +kernel
theorem YMat_ya : YMat (ZMod 3) (ix 1) 1 = Lya := by decide +kernel
theorem YMat_yb : YMat (ZMod 3) (ix 0) 1 = Lyb := by decide +kernel

@[expose] def uxa : GL14 := ⟨Lxa, Lxa', by decide +kernel, by decide +kernel⟩
@[expose] def uxb : GL14 := ⟨Lxb, Lxb', by decide +kernel, by decide +kernel⟩
@[expose] def uya : GL14 := ⟨Lya, Lya', by decide +kernel, by decide +kernel⟩
@[expose] def uyb : GL14 := ⟨Lyb, Lyb', by decide +kernel, by decide +kernel⟩

@[expose] noncomputable def gxa : RG := ⟨uxa, mem_RG_of_val (ix 1) (Or.inl XMat_xa.symm)⟩
@[expose] noncomputable def gxb : RG := ⟨uxb, mem_RG_of_val (ix 0) (Or.inl XMat_xb.symm)⟩
@[expose] noncomputable def gya : RG := ⟨uya, mem_RG_of_val (ix 1) (Or.inr YMat_ya.symm)⟩
@[expose] noncomputable def gyb : RG := ⟨uyb, mem_RG_of_val (ix 0) (Or.inr YMat_yb.symm)⟩

@[expose] noncomputable def valHom : RG →* M14 := (Units.coeHom M14).comp RG.subtype

theorem valHom_injective : Function.Injective valHom :=
  fun _ _ h => Subtype.ext (Units.ext h)

@[expose] noncomputable def na : RG := gxa * gya⁻¹ * gxa
@[expose] noncomputable def nb : RG := gxb * gyb⁻¹ * gxb
@[expose] noncomputable def nai : RG := gxa⁻¹ * gya * gxa⁻¹
@[expose] noncomputable def nbi : RG := gxb⁻¹ * gyb * gxb⁻¹

@[expose] noncomputable def aX : Fin 4 → RG :=
  ![nb * gxa * nbi, na * (nb * gxa * nbi) * nai, na * gxb * nai,
    nb * (na * gxb * nai) * nbi]

@[expose] noncomputable def tA : RG := na * na
@[expose] noncomputable def tB : RG := nb * nb

@[expose] def LA : Fin 4 → M14 := ![La0, La1, La2, La3]

theorem valHom_gxa : valHom gxa = Lxa := rfl
theorem valHom_gxb : valHom gxb = Lxb := rfl

set_option maxRecDepth 100000 in
theorem valHom_aX : ∀ i, valHom (aX i) = LA i := by decide +kernel

set_option maxRecDepth 100000 in
theorem valHom_tA : valHom tA = Lta := by decide +kernel

set_option maxRecDepth 100000 in
theorem valHom_tB : valHom tB = Ltb := by decide +kernel

end CFSG.HardMathSupport.Timmesfeld.LieRank
