theorem rel_pk3 {A : List ℕ} (hA : A.length ≤ 49) : Rel3 7 49 A (pk3 49 A) :=
  pk3_sound (d := 7) (N := 49) rfl hA

theorem rel_sq {A : List ℕ} {X : ℕ} (h : Rel3 7 49 A X) : Rel3 7 49 (mmulL 3 7 A A) (mul7 X X) := by
  have hm := mul3s_sound consts7 h.1 h.1
  exact ⟨hm.1, by rw [mul7, hm.2, h.2, toMatL_mmulL]⟩

theorem exists_left_of_forall₂ {α β : Type} {R : α → β → Prop} :
    ∀ {l1 : List α} {l2 : List β}, List.Forall₂ R l1 l2 → ∀ b ∈ l2, ∃ a ∈ l1, R a b
  | [], [], List.Forall₂.nil, _, hb => by simp at hb
  | a :: l1, b :: l2, List.Forall₂.cons hab hr, b', hb' => by
    rcases List.mem_cons.1 hb' with rfl | hb'
    · exact ⟨a, List.mem_cons_self, hab⟩
    · obtain ⟨a', ha', h⟩ := exists_left_of_forall₂ hr b' hb'
      exact ⟨a', List.mem_cons_of_mem _ ha', h⟩

theorem closed_of_check {As G : List (List ℕ)} {qs gs : List ℕ} (hA : ∀ A ∈ As, A.length ≤ 49)
    (hG : List.Forall₂ (Rel3 7 49) G gs) (hqs : words7 (As.map (pk3 49)) = qs)
    (hc : closeB qs gs = true) :
    ∀ A ∈ wordsL 3 7 As, ∀ γ ∈ G, mmulL 3 7 A γ ∈ wordsL 3 7 As := by
  intro A hA' γ hγ
  have hF := forall₂_wordsS consts7 As hA
  change List.Forall₂ (Rel3 7 49) (wordsL 3 7 As) (words7 (As.map (pk3 49))) at hF
  rw [hqs] at hF
  obtain ⟨X, hX, rX⟩ := exists_of_forall₂ hF A hA'
  obtain ⟨Y, hY, rY⟩ := exists_of_forall₂ hG γ hγ
  have hm := memK_iff.1 (allK_iff.1 (allK_iff.1 hc X hX) Y hY)
  obtain ⟨B, hB, rB⟩ := exists_left_of_forall₂ hF _ hm
  have mP : mat3 7 49 (mul7 X Y) = mat3 7 49 X * mat3 7 49 Y := (mul3s_sound consts7 rX.1 rY.1).2
  have e : toMatL 3 7 B = toMatL 3 7 (mmulL 3 7 A γ) := by
    rw [toMatL_mmulL, ← rX.2, ← rY.2, ← mP, rB.2]
  have hB' := wordsL_spec 3 7 (by norm_num) As B hB
  rwa [toMatL_inj 3 7 hB'.1 (length_mmulL 3 7 A γ) hB'.2 (lt_mmulL 3 7 (by norm_num) A γ) e]
    at hB

