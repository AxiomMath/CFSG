    refine iInf_le_of_le d (iInf_le_of_le hdE (iInf_le_of_le hd1 ?_))
    rw [top_inf_eq, hd]

theorem mem_of_abelian_of_card_sq {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    {P E : Subgroup G} (hEP : E ≤ P) (hP : Nat.card P = p ^ 3) (hE : Nat.card E = p ^ 2)
    {z : G} (hzP : z ∈ P) (hzo : orderOf z = p) (hzc : ∀ g ∈ P, g * z = z * g)
    (hEc : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a) (hnc : ∃ a ∈ P, ∃ b ∈ P, a * b ≠ b * a) :
    z ∈ E := by
  by_contra hzE
  set F : Subgroup G := E ⊔ Subgroup.zpowers z with hF
  have hFP : F ≤ P := sup_le hEP ((Subgroup.zpowers_le).2 hzP)
  have hEF : E ≤ F := le_sup_left
  have hzF : z ∈ F := Subgroup.mem_sup_right (Subgroup.mem_zpowers z)
  have hd1 : Nat.card E ∣ Nat.card F := Subgroup.card_dvd_of_le hEF
  have hd2 : Nat.card F ∣ Nat.card P := Subgroup.card_dvd_of_le hFP
  rw [hE] at hd1
  rw [hP] at hd2
  obtain ⟨k, hk, hkF⟩ := (Nat.dvd_prime_pow hp).1 hd2
  have hk2 : 2 ≤ k := by
    rw [hkF] at hd1
    exact (Nat.pow_dvd_pow_iff_le_right hp.one_lt).1 hd1
  have hk2' : k ≠ 2 := by
    intro h2
    apply hzE
    have : E = F := Subgroup.eq_of_le_of_card_ge hEF (by rw [hkF, h2, hE])
    rw [this]
    exact hzF
  have hFcard : Nat.card F = p ^ 3 := by
    rw [hkF]
    congr 1
    omega
  have hFP' : F = P := Subgroup.eq_of_le_of_card_ge hFP (by rw [hFcard, hP])
  have hZE : ∀ e ∈ E, e * z = z * e := fun e he => hzc e (hEP he)
  have h1 : F ≤ Subgroup.centralizer (E : Set G) := by
    refine sup_le ?_ ?_
    · intro a ha
      rw [Subgroup.mem_centralizer_iff]
      exact fun b hb => (hEc b hb a ha)
    · rw [Subgroup.zpowers_le]
      rw [Subgroup.mem_centralizer_iff]
      exact fun b hb => hZE b hb
  have h2 : F ≤ Subgroup.centralizer ((Subgroup.zpowers z : Subgroup G) : Set G) := by
    refine sup_le ?_ ?_
    · intro a ha
      rw [Subgroup.mem_centralizer_iff]
      intro b hb
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
      exact ((Commute.zpow_right (show Commute a z from hZE a ha) n).symm.eq)
    · intro a ha
      rw [Subgroup.mem_centralizer_iff]
      intro b hb
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 ha
      exact ((Commute.zpow_zpow_self z n m).eq)
  have h3 : F ≤ Subgroup.centralizer (F : Set G) := by
    refine sup_le ?_ ?_
    · exact Subgroup.le_centralizer_iff.2 h1
    · exact Subgroup.le_centralizer_iff.2 h2
  obtain ⟨a, ha, b, hb, hab⟩ := hnc
  rw [← hFP'] at ha hb
  exact hab (Subgroup.mem_centralizer_iff.1 (h3 ha) b hb).symm

theorem exists_plane_witness_of_sylow_card_cube' {G : Type*} [Group G] [Finite G] {p : ℕ}
    (hp : p.Prime) (Q : Sylow p G) (hQ : Nat.card Q = p ^ 3) {z : G} (hzQ : z ∈ Q)
    (hzo : orderOf z = p) (hzc : ∀ g ∈ Q, g * z = z * g)
    (hnc : ∃ a ∈ Q, ∃ b ∈ Q, a * b ≠ b * a)
    (Φ : G → Prop) (hΦ : ∀ g d, Φ d → Φ (g * d * g⁻¹)) (hz : Φ z)
    (E : Subgroup G) (hE : IsElemAbelian p E) (hEc : Nat.card E = p ^ 2) :
    ∃ d ∈ E, d ≠ 1 ∧ Φ d := by
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨P', hP'⟩ := hE.isPGroup.exists_le_sylow
  obtain ⟨h, hh⟩ := MulAction.exists_smul_eq G Q P'
  have hconj : ∀ x ∈ E, h⁻¹ * x * h ∈ (Q : Subgroup G) := fun x hx => by
    have hxP' : x ∈ (P' : Subgroup G) := hP' hx
    have : (P' : Subgroup G) = (h • Q : Sylow p G) := by rw [hh]
    rw [this, Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hxP'
    exact hxP'
  set E₀ : Subgroup G := E.map (MulAut.conj h⁻¹).toMonoidHom with hE₀
  have hE₀Q : E₀ ≤ (Q : Subgroup G) := by
    rintro _ ⟨x, hx, rfl⟩
    simpa [MulAut.conj_apply] using hconj x hx
  have hE₀c : Nat.card E₀ = p ^ 2 := by
    rw [hE₀, Subgroup.card_map_of_injective (MulAut.conj h⁻¹).injective, hEc]
  have hE₀a : IsElemAbelian p E₀ := hE.map _
  have hqz : z ∈ E₀ := mem_of_abelian_of_card_sq hp hE₀Q hQ hE₀c hzQ hzo hzc
    (fun a ha b hb => CFSG.Open.IsElemAbelian.comm hE₀a ha hb) hnc
  obtain ⟨d, hdE, hd⟩ := hqz
  have hd' : d = h * z * h⁻¹ := by
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv] at hd
    rw [← hd]
    group
  refine ⟨d, hdE, ?_, ?_⟩
  · rw [hd']
    intro h1
    have hz1 : z = 1 := by simpa using h1
    rw [hz1, orderOf_one] at hzo
    exact hp.one_lt.ne hzo
  · rw [hd']
    exact hΦ h z hz

theorem exists_plane_witness_of_sylow_card_cube {G : Type*} [Group G] [Finite G] {p : ℕ}
    (hp : p.Prime) (Q : Sylow p G) (hQ : Nat.card Q = p ^ 3) {z : G} (hzQ : z ∈ Q)
    (hzo : orderOf z = p) (hzc : ∀ g ∈ Q, g * z = z * g)
    (hnc : ∃ a ∈ Q, ∃ b ∈ Q, a * b ≠ b * a)
    (hO : GLAPPrimeCoreOf p (Subgroup.centralizer ({z} : Set G)) = ⊥)
    (E : Subgroup G) (hE : IsElemAbelian p E) (hEc : Nat.card E = p ^ 2) :
    ∃ d ∈ E, d ≠ 1 ∧ GLAPPrimeCoreOf p (Subgroup.centralizer ({d} : Set G)) = ⊥ :=
  exists_plane_witness_of_sylow_card_cube' hp Q hQ hzQ hzo hzc hnc
    (fun d => GLAPPrimeCoreOf p (Subgroup.centralizer ({d} : Set G)) = ⊥)
    (fun g d hd => by
      refine gLAPPrimeCoreOf_centralizer_eq_bot_of_mulEquiv (MulAut.conj g⁻¹ : G ≃* G) ?_
      have : (MulAut.conj g⁻¹ : G ≃* G) (g * d * g⁻¹) = d := by
        simp only [MulAut.conj_apply, inv_inv]
        group
      rw [this]
      exact hd) hO E hE hEc

section AutModelBalance

open CFSG.Sporadic.SmallOddCore CFSG.ComponentClassification.OuterAutomorphisms

variable {M : Type*} [Group M] {P R : Subgroup M}

noncomputable def autOfMem (h : AutModel P R) (x : M) (hx : x ∈ R) : MulAut P where
  toFun p := ⟨x * p * x⁻¹, h.conj_mem x hx p p.2⟩
  invFun p := ⟨x⁻¹ * p * x, by simpa using h.conj_mem x⁻¹ (R.inv_mem hx) p p.2⟩
  left_inv p := Subtype.ext (by simp [mul_assoc])
  right_inv p := Subtype.ext (by simp [mul_assoc])
  map_mul' a b := Subtype.ext (by simp [mul_assoc])

theorem hom_autOfMem (h : AutModel P R) {x : M} (hx : x ∈ R) : h.hom (autOfMem h x hx) = x :=
  h.elt_eq hx fun p => rfl

end AutModelBalance

section AutModelBalance2

open CFSG.Sporadic.SmallOddCore CFSG.ComponentClassification.OuterAutomorphisms

variable {M : Type*} [Group M] [Finite M] {P R : Subgroup M}

theorem isLocallyBalancedAbs_two_of_autModel {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (h : AutModel P R) {S : Type*} [Group S] [Finite S] (θ : S ≃* P)
    (hcen : Subgroup.center S = ⊥) (hout : Nat.card (Outer S) ≤ 2)
    (hwit : ∀ E : Subgroup ↥P, IsElemAbelian p E → Nat.card E = p ^ 2 →
      ∃ d ∈ E, d ≠ 1 ∧
        GLAPPrimeCoreOf p (Subgroup.centralizer ({(d : M)} : Set M) ⊓ R) = ⊥) :
    IsLocallyBalancedAbs p 2 S := by
  have hinj : Function.Injective (MulAut.conj : S →* MulAut S) :=
    SporadicBalance.conj_injective_of_center_eq_bot hcen
  set κ : MulAut S →* M := h.hom.comp (MulAut.congr θ).toMonoidHom with hκ
  have hκinj : Function.Injective κ := h.hom_injective.comp (MulAut.congr θ).injective
  have hκR : ∀ α, κ α ∈ R := fun α => h.elt_mem _
  have hκsurj : ∀ x ∈ R, ∃ α, κ α = x := fun x hx =>
    ⟨(MulAut.congr θ).symm (autOfMem h x hx), by
      simp only [hκ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.apply_symm_apply]
      exact hom_autOfMem h hx⟩
  have hκinn : ∀ s : S, κ (MulAut.conj s) = (θ s : M) := by
    intro s
    refine h.elt_eq (h.le (θ s).2) fun q => ?_
    simp [MulAut.congr_apply, MulAut.conj_apply]
  intro D hD hDc H hH hDH
  have hHn : H.Normal := by
    have hidx : H.index ∣ (innerAut S).index := Subgroup.index_dvd_of_le hH
    have h2 : (innerAut S).index ≤ 2 := hout
    have h0 : (innerAut S).index ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
    have : H.index ≤ 2 := (Nat.le_of_dvd (Nat.pos_of_ne_zero h0) hidx).trans h2
    interval_cases hi : H.index
    · exact absurd hi (Subgroup.FiniteIndex.index_ne_zero)
    · exact (Subgroup.index_eq_one.1 hi) ▸ inferInstance
    · exact Subgroup.normal_of_index_eq_two hi
  have hcop : Nat.Coprime p (Nat.card (Outer S)) :=
    coprime_of_le_two hp hp2 Nat.card_pos.ne' hout
  have hDin : D ≤ innerAut S := le_inner_of_isPGroup hcop hD.isPGroup
  set E : Subgroup S := D.comap (MulAut.conj : S →* MulAut S) with hE
  have hDE : E.map (MulAut.conj : S →* MulAut S) = D := Subgroup.map_comap_eq_self hDin
  have hEc : Nat.card E = p ^ 2 := by
    rw [← hDc, ← hDE, Subgroup.card_map_of_injective hinj]
  have hEa : IsElemAbelian p E := by
    refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
    · apply Subtype.ext
      apply hinj
      have := congrArg Subtype.val (hD.1.is_comm.comm ⟨MulAut.conj (a : S), hDE ▸ ⟨a, a.2, rfl⟩⟩
        ⟨MulAut.conj (b : S), hDE ▸ ⟨b, b.2, rfl⟩⟩)
      simpa [map_mul] using this
    · apply hinj
      rw [map_pow, map_one]
      exact hD.2 _ (hDE ▸ ⟨x, hx, rfl⟩)
  have hEPc : Nat.card (E.map θ.toMonoidHom) = p ^ 2 := by
    rw [Subgroup.card_map_of_injective θ.injective, hEc]
  obtain ⟨d', hd'E, hd'1, hd'O⟩ := hwit _ (hEa.map _) hEPc
  obtain ⟨d, hdE, rfl⟩ := Subgroup.mem_map.1 hd'E
  have hθd : (θ.toMonoidHom d : P) = θ d := rfl
  have hdD : MulAut.conj d ∈ D := hDE ▸ ⟨d, hdE, rfl⟩
  have hd1 : MulAut.conj d ≠ 1 := fun h1 => hd'1 (by
    have : d = 1 := hinj (by rw [h1, map_one])
    simp [this])
  have hΔ : localDeltaIn p H D ≤
      GLAPPrimeCoreOf p (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S))) :=
    iInf_le_of_le (MulAut.conj d) (iInf_le_of_le hdD (iInf_le_of_le hd1 le_rfl))
  refine le_bot_iff.1 (hΔ.trans (le_of_eq ?_))
  have hmap := map_glaPPrimeCoreOf_of_injective p κ hκinj
    (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S)))
  have hX : (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S))).map κ =
      Subgroup.centralizer ({((θ d : P) : M)} : Set M) ⊓ H.map κ := by
    ext y
    simp only [Subgroup.mem_map, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff]
    constructor
    · rintro ⟨α, ⟨hαH, hαc⟩, rfl⟩
      refine ⟨?_, α, hαH, rfl⟩
      have := congrArg κ hαc
      rw [map_mul, map_mul, hκinn] at this
      exact this
    · rintro ⟨hyc, α, hαH, rfl⟩
      refine ⟨α, ⟨hαH, ?_⟩, rfl⟩
      apply hκinj
      rw [map_mul, map_mul, hκinn]
      exact hyc
  have hHR : H.map κ ≤ R := by
    rintro _ ⟨α, -, rfl⟩
    exact hκR α
  have hnorm : ∀ r ∈ R, ∀ q ∈ H.map κ, r * q * r⁻¹ ∈ H.map κ := by
    intro r hr q hq
    obtain ⟨β, rfl⟩ := hκsurj r hr
    obtain ⟨α, hα, rfl⟩ := hq
    exact ⟨β * α * β⁻¹, hHn.conj_mem α hα β, by simp⟩
  have hle := CFSG.HardMathSupport.Solomon.Coordinator.gLAPPrimeCoreOf_inf_le_of_ambient hp hHR
    hnorm ((θ d : P) : M)
  have hd'O' : GLAPPrimeCoreOf p (Subgroup.centralizer ({((θ d : P) : M)} : Set M) ⊓ R) = ⊥ :=
    hd'O
  rw [hd'O'] at hle
  have : (GLAPPrimeCoreOf p (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S)))).map κ =
      ⊥ := by
    rw [hmap, hX]
    exact le_bot_iff.1 hle
  exact (Subgroup.map_eq_bot_iff_of_injective _ hκinj).1 this

end AutModelBalance2

theorem isLocallyBalancedAbs_two_of_sylow_card_cube {S G : Type*} [Group S] [Group G] [Finite G]
    {p : ℕ} (hp : p.Prime) (f : S ≃* G) (hcen : Subgroup.center S = ⊥) (hinn : innerAut S = ⊤)
    (Q : Sylow p G) (hQ : Nat.card Q = p ^ 3) {z : G} (hzQ : z ∈ Q) (hzo : orderOf z = p)
    (hzc : ∀ g ∈ Q, g * z = z * g) (hnc : ∃ a ∈ Q, ∃ b ∈ Q, a * b ≠ b * a)
    (hO : GLAPPrimeCoreOf p (Subgroup.centralizer ({z} : Set G)) = ⊥) :
    IsLocallyBalancedAbs p 2 S := by
  refine isLocallyBalancedAbs_two_of_plane_witness hcen hinn fun E hE hEc => ?_
  have hE' : IsElemAbelian p (E.map f.toMonoidHom) := hE.map _
  have hEc' : Nat.card (E.map f.toMonoidHom) = p ^ 2 := by
    rw [Subgroup.card_map_of_injective f.injective, hEc]
  obtain ⟨d', hd'E, hd'1, hd'⟩ :=
    exists_plane_witness_of_sylow_card_cube hp Q hQ hzQ hzo hzc hnc hO _ hE' hEc'
  obtain ⟨d, hdE, rfl⟩ := Subgroup.mem_map.1 hd'E
  exact ⟨d, hdE, fun h1 => hd'1 (by simp [h1]),
    gLAPPrimeCoreOf_centralizer_eq_bot_of_mulEquiv f hd'⟩

