theorem sporadicTwoPairHolds_He_seven (hB : SporadicBridges) (hOut : SporadicOuterLeTwo) :
    SporadicTwoPairHolds .He 7 := by
  intro S _ _ hS hnab he
  obtain ⟨e0⟩ := he
  have hcen : Subgroup.center S = ⊥ := center_eq_bot_of_isSimpleGroup hnab
  have hO : Nat.card (Outer S) ≤ 2 := hOut S hS hnab .He ⟨e0.trans (hB .He).some⟩
  obtain ⟨⟨hQP, hQsyl, hQcard, -⟩, ⟨hlines, -⟩, -, -, -, ⟨hC0, -⟩, -, -,
    ⟨hA0C, -, hA0P, hA0card, -, hA0centcard, hA0cent⟩, -⟩ :=
    R3E_He_full_seven_centralizer_structures
  refine isLocallyBalancedAbs_two_of_autModel Nat.prime_seven (by norm_num) heAutModel
    (e0.trans heEquivP) hcen hO fun E hE hEc => ?_
  have hPR : heP ≤ heAutGroup := heAutModel.le
  have hline0 : Subgroup.zpowers (heSevenLine 0) ∈
      {H : Subgroup (Equiv.Perm (Fin 8330)) | H ≤ heSevenQ ∧ Nat.card H = 7} := by
    rw [hlines]
    exact ⟨0, rfl⟩
  have hz0Q : heSevenLine 0 ∈ heSevenQ := hline0.1 (Subgroup.mem_zpowers _)
  have hz0P : heSevenLine 0 ∈ heP := hQP hz0Q
  have hz0o : orderOf (heSevenLine 0) = 7 := by
    rw [← Nat.card_zpowers]
    exact hline0.2
  have hA0comm : ∀ a ∈ heSevenA0, a * heSevenLine 0 = heSevenLine 0 * a := by
    intro a ha
    have := hA0C ha
    rw [hC0] at this
    exact Subgroup.mem_centralizer_singleton_iff.1 (Subgroup.mem_inf.1 this).1
  have hz0A : heSevenLine 0 ∈ heSevenA0 := by
    refine hA0cent (Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_iff.2 fun a ha => ?_, ?_⟩)
    · exact hA0comm a ha
    · rw [hC0]
      exact Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_singleton_iff.2 rfl, hPR hz0P⟩
  have hA0nc : ∃ a ∈ heSevenA0, ∃ b ∈ heSevenA0, a * b ≠ b * a := by
    by_contra hcon
    push Not at hcon
    have hle : heSevenA0 ≤ (Subgroup.centralizer (heSevenA0 : Set (Equiv.Perm (Fin 8330))) ⊓
        heSevenC0 : Subgroup (Equiv.Perm (Fin 8330))) :=
      fun a ha => Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_iff.2 fun b hb => hcon b hb a ha,
        hA0C ha⟩
    have := Subgroup.card_le_of_le hle
    rw [hA0card, hA0centcard] at this
    omega
  obtain ⟨S₀, hS₀⟩ := hQsyl
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hvQ : Nat.card heSevenQ = 7 ^ (Nat.card heP).factorization 7 :=
    CFSG.HardMathSupport.Solomon.Coordinator.card_eq_of_sylow_subgroupOf hQP ⟨S₀, hS₀⟩
  set A0P : Subgroup ↥heP := heSevenA0.subgroupOf heP with hA0Pdef
  have hA0Pcard : Nat.card A0P = 7 ^ (Nat.card heP).factorization 7 := by
    rw [← hvQ, hQcard, ← hA0card]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA0P).toEquiv
  let Q : Sylow 7 ↥heP := Sylow.ofCard A0P hA0Pcard
  have hQeq : (Q : Subgroup ↥heP) = A0P := Sylow.coe_ofCard _ _
  have hQmem : ∀ x : ↥heP, x ∈ Q ↔ (x : Equiv.Perm (Fin 8330)) ∈ heSevenA0 := fun x => by
    change x ∈ (Q : Subgroup ↥heP) ↔ _
    rw [hQeq]
    exact Iff.rfl
  have hQc : Nat.card Q = 7 ^ 3 := by
    change Nat.card (Q : Subgroup ↥heP) = _
    rw [hQeq, show (7 : ℕ) ^ 3 = 343 by norm_num, ← hA0card]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA0P).toEquiv
  refine exists_plane_witness_of_sylow_card_cube' (G := ↥heP) (p := 7) (by norm_num) Q hQc
