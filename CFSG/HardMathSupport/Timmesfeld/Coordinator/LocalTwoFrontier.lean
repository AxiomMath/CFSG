theorem isLocallyBalancedAbs_two_of_plane_witness {p : ℕ} {S : Type*} [Group S]
    (hcen : Subgroup.center S = ⊥) (hinn : innerAut S = ⊤)
    (h : ∀ E : Subgroup S, IsElemAbelian p E → Nat.card E = p ^ 2 →
      ∃ d ∈ E, d ≠ 1 ∧ GLAPPrimeCoreOf p (Subgroup.centralizer ({d} : Set S)) = ⊥) :
    IsLocallyBalancedAbs p 2 S :=
  isLocallyBalancedAbs_of_inner_eq_top hcen hinn fun E hE hEc => by
