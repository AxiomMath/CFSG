@[expose] def mclHeisTbl (k : ℕ) : Table := hexT 3 275 (275 * k) mclHeisHex

@[expose] def mclHeisTau (c : ℕ) : Table := if c = 0 then mclPGTbls[0]! else mclCentTbl 17

@[expose] def mclHeisW (c : ℕ) : Table :=
  let X := mclHeisTbl (2 * c)
  let Y := mclHeisTbl (2 * c + 1)
  compT 275 (compT 275 (compT 275 (invT 275 X) (invT 275 Y)) X) Y

@[expose] def mclHeisOK (c : ℕ) : Bool :=
  let X := mclHeisTbl (2 * c)
  let Y := mclHeisTbl (2 * c + 1)
  let W := mclHeisW c
  permOK 275 X && permOK 275 Y && invOK 275 X (invT 275 X) && invOK 275 Y (invT 275 Y) &&
    mclSift X && mclSift Y &&
    tblEq 275 (powT 275 5 X) (idT 275) && tblEq 275 (powT 275 5 Y) (idT 275) &&
    tblEq 275 (powT 275 5 W) (idT 275) && !tblEq 275 W (idT 275) &&
    commTT 275 X W && commTT 275 Y W &&
    tblEq 275 (compT 275 (compT 275 (mclHeisTau c) X) (mclHeisTau c)) (invT 275 X)

@[expose] def mclHeisCheck (_ : Unit := ()) : Bool :=
  permOK 275 (mclCentTbl 17) && mclHeisOK 0 && mclHeisOK 1

