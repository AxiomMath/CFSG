@[expose] def co3HeisTbl (k : ℕ) : Table := hexT 3 276 (276 * k) co3HeisHex

@[expose] def co3HeisTau (c : ℕ) : Table := if c = 0 then co3ZTbl else co3TtTbl

@[expose] def co3HeisW (c : ℕ) : Table :=
  compT 276 (compT 276 (compT 276 (invT 276 (co3HeisTbl (2 * c))) (invT 276 (co3HeisTbl (2 * c + 1))))
    (co3HeisTbl (2 * c))) (co3HeisTbl (2 * c + 1))

@[expose] def co3HeisOK (c : ℕ) : Bool :=
  let X := co3HeisTbl (2 * c)
  let Y := co3HeisTbl (2 * c + 1)
  let W := co3HeisW c
  permOK 276 X && permOK 276 Y && invOK 276 X (invT 276 X) && invOK 276 Y (invT 276 Y) &&
    co3Sift X && co3Sift Y &&
    tblEq 276 (powT 276 5 X) (idT 276) && tblEq 276 (powT 276 5 Y) (idT 276) &&
    tblEq 276 (powT 276 5 W) (idT 276) && !tblEq 276 W (idT 276) &&
    commTT 276 X W && commTT 276 Y W &&
    tblEq 276 (compT 276 (compT 276 (co3HeisTau c) X) (co3HeisTau c)) (invT 276 X)

@[expose] def co3HeisCheck (_ : Unit := ()) : Bool := co3HeisOK 0 && co3HeisOK 1

@[expose] def co3AEnt (s : Table) : Bool :=
  involOK 276 s && co3FusionWits.any fun w => w.2 && co3FusesTo s w

@[expose] def co3RankCheck (_ : Unit := ()) : Bool :=
  let A := (mulClosureH 276 co3TTbls 2000).1.filter co3AEnt
  decide ((A.filter fun s => decide (31 ≤ (A.filter fun s' => commTT 276 s s').size)).size ≤ 30)

