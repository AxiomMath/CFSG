@[expose] def dispIXB : Nat := 548

@[expose] def dispIYB : Nat := 549

@[expose] def dispIXC : Nat := 550

@[expose] def dispIYC : Nat := 551

@[expose] def heisInvCheck (t X Y : Rows) : Bool :=
  let Xi := inv X
  let Yi := inv Y
  let W := mul (mul (mul Xi Yi) X) Y
  mul X Xi == one && mul Y Yi == one && pow X 5 == one && pow Y 5 == one &&
    pow W 5 == one && W != one && validRows W && mul X W == mul W X && mul Y W == mul W Y &&
    mul t t == one && mul (mul t X) t == Xi

@[noinline, expose] def dispBCCheck (_ : Unit := ()) : Bool :=
  let D := dag [aR, bR, iotaARows] (dispHeis ++ dispBC)
  D.2.2 && heisInvCheck aR (D.1.getD (dispIXB - 1) one) (D.1.getD (dispIYB - 1) one) &&
    heisInvCheck iotaCRows (D.1.getD (dispIXC - 1) one) (D.1.getD (dispIYC - 1) one)

