theorem b_index_inner :
    (inner NativeSporadic.B).index = 1 := by
  rw [Subgroup.index_eq_one, eq_top_iff]
  intro α _
  obtain ⟨g, rfl⟩ := CFSG.RankThree.PartOne.SPOR.allInner_B α
  exact ⟨g, rfl⟩

noncomputable def bCarrierEquiv : NativeSporadic.B ≃* NativeSporadic.Carrier .B :=
  MulEquiv.refl _

theorem b_card_hopfMultiplier :
    Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier (NativeSporadic.Carrier .B)) = 2 :=
  Coordinator.nativeRow_of_two_one_three_zero rfl
    (Coordinator.carrierFacts_of_ne_M _ (by decide)) CFSG.EvenSporadicStandard.rowBound_B
    Coordinator.two_dvd_card_hopfMultiplier_B
    (UniversalCoverMonster.kernelTrivialAt_three_B_of_fi23_cell
      Coordinator.kernelTrivialAt_three_Fi23)
    (Proving.bigPrimeFacts_of_ne_M .B (by decide))

theorem b_center_dvd
    (L : Type) [Group L] [Finite L] (hq : CFSG.IsQuasisimple L)
    (e : L ⧸ Subgroup.center L ≃* NativeSporadic.B) :
    Nat.card (Subgroup.center L) ∣ 2 := by
  have h := CFSG.GH74.Generic.card_center_dvd_hopfMultiplier hq (e.trans bCarrierEquiv)
  rwa [b_card_hopfMultiplier] at h

theorem card_B :
    Nat.card NativeSporadic.B = 4154781481226426191177580544000000 :=
  CFSG.Monster.B.pinned_B_explicit_native_isomorphism_simplicity_and_order.2.2.2.2

private theorem orderOf_two_zmod_three : orderOf (2 : ZMod 3) = 2 := by
  rw [orderOf_eq_iff (by norm_num)]
  refine ⟨by decide, fun m hm hm0 => ?_⟩
  interval_cases m
  decide

theorem noIrrFFOffender_B_native :
    NoIrrFFOffender NativeSporadic.B := by
  obtain ⟨x, y, z, h, hy⟩ := b_heisCfg
  refine noIrrFFOffender_of_heisCfg (k := 1) (c := 1) (by norm_num)
    (fun B _ _ => card_le_mul_card_inf_inner_of_index_dvd (by norm_num)
      (by rw [b_index_inner]) B)
    (fun L _ _ hq he hodd => ?_) h hy ?_
  · obtain ⟨e⟩ := he
    have h1 : Nat.card (Subgroup.center L) = 1 := by
      rcases (Nat.dvd_prime Nat.prime_two).1 (b_center_dvd L hq e) with h1 | h2
      · exact h1
      · rw [h2] at hodd
        exact absurd hodd (by decide)
    rw [h1]
    norm_num
  · rw [card_B, orderOf_two_zmod_three]
    norm_num

theorem noIrrFFOffender_B :
    NoIrrFFOffender (TauCeti.CFSGIndex.sporadic .B).Group :=
  noIrrFFOffender_transfer noIrrFFOffender_B_native
    CFSG.Sporadic.Bridge.B.nonempty_mulEquiv

theorem gf2NoFFSporadicFor_B :
    GF2NoFFSporadicFor .B :=
  gf2NoFFSporadicFor_of_noIrrFFOffender noIrrFFOffender_B

