@[noinline, expose] def f0Check (_ : Unit := ()) : Bool :=
  let D₁ := Native.brayRows iotaARows f0D1
  let B := Native.brayElts D₁ f0Bidx
  let D₂ := dag B f0D2
  let a := iotaARows
  let b := D₁.1.getD (f0IB - 1) one
  let s₁ := D₁.1.getD (f0S1 - 1) one
  let s₂ := D₁.1.getD (f0S2 - 1) one
  D₁.2.2 && D₂.2.2 &&
    f0Bidx.all (fun j => decide (3 < j) && decide (j ≤ D₁.1.length)) &&
    decide (f0IB ≤ D₁.1.length) && decide (f0S1 ≤ D₁.1.length) && decide (f0S2 ≤ D₁.1.length) &&
    (Native.brayElts D₁ (f0Bidx.take 8)).all (fun g => mul g a == mul a g) &&
    (Native.brayElts D₁ (f0Bidx.drop 8)).all (fun g => mul g b == mul b g) &&
    mul a b == mul b a && mul b b == one && validRows b && validRows a && b != one && b != a &&
    mul s₁ a == mul b s₁ && mul s₁ b == mul a s₁ &&
    mul s₂ b == mul (mul a b) s₂ && mul s₂ (mul a b) == mul b s₂ &&
    D₂.1.getD (D₂.1.length - 2) one == aR && D₂.1.getD (D₂.1.length - 1) one == bR

