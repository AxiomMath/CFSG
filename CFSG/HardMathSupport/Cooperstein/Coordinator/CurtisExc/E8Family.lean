theorem uWords_fix : ∀ j : Fin 56, (uWords.getD j []).foldr reflectL
    (List.ofFn (Pi.single n8 (1 : ℤ))) = List.ofFn (Pi.single n8 (1 : ℤ)) := by
  decide +kernel

@[expose] def uVecs : List (List ℤ) :=
  uWords.map fun w => w.foldr reflectL (List.ofFn e8Theta)

theorem uVecs_check : ∀ j j' : Fin 56, j ≠ j' →
    1 ≤ contentL (subL (uVecs.getD j []) (uVecs.getD j' [])) ∧
      contentL (subL (uVecs.getD j []) (uVecs.getD j' [])) ≤ 2 := by
  decide +kernel

theorem subL_ofFn (x y : Fin Tag.E8.rank → ℤ) : subL (List.ofFn x) (List.ofFn y) = List.ofFn (x - y) := by
  unfold subL
  refine List.ext_getElem (by simp) fun n h1 h2 => ?_
  simp

theorem not_dvd_of_content {x y : Fin Tag.E8.rank → ℤ}
    (h : 1 ≤ contentL (subL (List.ofFn x) (List.ofFn y)) ∧
      contentL (subL (List.ofFn x) (List.ofFn y)) ≤ 2) (d : ℕ) (hd : 3 ≤ d) :
    ¬ ∀ c, (d : ℤ) ∣ (x - y) c := by
  intro hc
  have h1 : d ∣ contentL (subL (List.ofFn x) (List.ofFn y)) := by
    refine dvd_contentL d _ fun z hz => ?_
    rw [subL_ofFn, List.mem_ofFn] at hz
    obtain ⟨c, rfl⟩ := hz
    exact hc c
  have := Nat.le_of_dvd (by omega) h1
  omega

theorem betaWords_length : betaWords.length = 240 := by decide +kernel

theorem uWords_length : uWords.length = 56 := by decide +kernel

theorem betaVecs_getD (i : Fin 240) : betaVecs.getD i [] =
    (betaWords.getD i []).foldr reflectL (List.ofFn (Pi.single n8 (1 : ℤ))) := by
  have hi : (i : ℕ) < betaWords.length := by rw [betaWords_length]; exact i.isLt
  simp [betaVecs, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hi]

theorem uVecs_getD (i : Fin 56) : uVecs.getD i [] =
    (uWords.getD i []).foldr reflectL (List.ofFn e8Theta) := by
  have hi : (i : ℕ) < uWords.length := by rw [uWords_length]; exact i.isLt
  simp [uVecs, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hi]

theorem exists_betaFamily :
    ∃ w : Fin 240 → WeylGroup .E8, ∀ i i', i ≠ i' → ∀ d : ℕ, 3 ≤ d →
      ¬ ∀ c, (d : ℤ) ∣ (w i • (Pi.single n8 1 : Fin Tag.E8.rank → ℤ) -
        w i' • (Pi.single n8 1 : Fin Tag.E8.rank → ℤ)) c := by
  refine ⟨fun i => (coxeterSystem .E8).wordProd (betaWords.getD i []), fun i i' hii' d hd => ?_⟩
  apply not_dvd_of_content _ d hd
  simp only [wordProd_smul']
  rw [ofFn_foldr_reflect, ofFn_foldr_reflect, ← betaVecs_getD, ← betaVecs_getD]
  exact betaVecs_check i i' hii'

theorem exists_uFamily :
    ∃ u : Fin 56 → WeylGroup .E8,
      (∀ j, u j • (Pi.single n8 1 : Fin Tag.E8.rank → ℤ) = Pi.single n8 1) ∧
      ∀ j j', j ≠ j' → ∀ d : ℕ, 3 ≤ d →
        ¬ ∀ c, (d : ℤ) ∣ (u j • e8Theta - u j' • e8Theta) c := by
  refine ⟨fun i => (coxeterSystem .E8).wordProd (uWords.getD i []), fun j => ?_,
    fun j j' hjj' d hd => ?_⟩
  · simp only [wordProd_smul']
    refine List.ofFn_injective ?_
    rw [ofFn_foldr_reflect]
    exact uWords_fix j
  · apply not_dvd_of_content _ d hd
    simp only [wordProd_smul']
    rw [ofFn_foldr_reflect, ofFn_foldr_reflect, ← uVecs_getD, ← uVecs_getD]
    exact uVecs_check j j' hjj'

