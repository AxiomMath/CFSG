@[expose] def orbitWords (tbl : List ℕ) : List (List (Fin Tag.E8.rank)) :=
  tbl.foldl (fun acc c => acc ++ [⟨c % 8, Nat.mod_lt _ (by decide)⟩ :: acc.getD (c / 8) []]) [[]]

@[expose] def node7 (s : Fin 7) : Fin Tag.E8.rank := ⟨s.val, by have := s.isLt; show _ < 8; omega⟩

@[expose] def reflectL (i : Fin Tag.E8.rank) (l : List ℤ) : List ℤ :=
  List.ofFn fun j : Fin Tag.E8.rank =>
    l.getD j 0 - if j = i then (List.finRange Tag.E8.rank).map
      (fun k => Tag.E8.cartan i k * l.getD k 0) |>.sum else 0

theorem ofFn_reflect (i : Fin Tag.E8.rank) (v : Fin Tag.E8.rank → ℤ) :
    List.ofFn (reflect .E8 i v) = reflectL i (List.ofFn v) := by
  unfold reflectL reflect
  refine congrArg List.ofFn (funext fun j => ?_)
  simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, Pi.sub_apply, Pi.smul_apply,
    smul_eq_mul]
  have hs : ∑ k, Tag.E8.cartan i k * v k =
      ((List.finRange Tag.E8.rank).map (fun k => Tag.E8.cartan i k * (List.ofFn v).getD k 0)).sum := by
    rw [Fin.sum_univ_def]
    refine congrArg List.sum (List.map_congr_left fun k _ => ?_)
    simp [List.getD_eq_getElem?_getD]
  rw [hs]
  by_cases hj : j = i <;> simp [hj]

theorem ofFn_foldr_reflect (l : List (Fin Tag.E8.rank)) (v : Fin Tag.E8.rank → ℤ) :
    List.ofFn (l.foldr (reflect .E8) v) = l.foldr reflectL (List.ofFn v) := by
  induction l with
  | nil => rfl
  | cons i l ih => rw [List.foldr_cons, List.foldr_cons, ofFn_reflect, ih]

@[expose] def codeL (l : List ℤ) : ℕ := l.foldr (fun x a => (x + 64).toNat + 128 * a) 0

theorem orbitWords_check : ∀ s : Fin 7,
    (orbitWords (orbitTables.getD s [])).length = 248 ∧
      strictB (msortN ((orbitWords (orbitTables.getD s [])).map fun l =>
        codeL (l.foldr reflectL (List.ofFn (e8Omega (node7 s)))))) = true := by
  decide +kernel

theorem exists_orbit_e8Omega
    (s : Fin Tag.E8.rank) (hs : s.val ≠ 7) :
    ∃ w : Fin 248 → WeylGroup .E8, ∀ i j, i ≠ j → w i • e8Omega s ≠ w j • e8Omega s := by
  obtain ⟨s', rfl⟩ : ∃ s' : Fin 7, node7 s' = s := by
    refine ⟨⟨s.val, ?_⟩, Fin.ext rfl⟩
    have h1 := s.isLt
    change s.val < 8 at h1
    omega
  obtain ⟨hlen, hch⟩ := orbitWords_check s'
  have hnd := nodup_of_strictB hch
  set ws := orbitWords (orbitTables.getD s' [])
  refine ⟨fun i => (coxeterSystem .E8).wordProd (ws.get (i.cast hlen.symm)), fun i j hij h => ?_⟩
  rw [wordProd_smul', wordProd_smul'] at h
  have h2 := congrArg (fun v => codeL (List.ofFn v)) h
  simp only [ofFn_foldr_reflect] at h2
  have hinj := List.nodup_iff_injective_get.1 hnd
  have hi : (i : ℕ) < (ws.map fun l => codeL (List.foldr reflectL
      (List.ofFn (e8Omega (node7 s'))) l)).length := by simp [hlen]
  have hj : (j : ℕ) < (ws.map fun l => codeL (List.foldr reflectL
      (List.ofFn (e8Omega (node7 s'))) l)).length := by simp [hlen]
  have := hinj (a₁ := ⟨i, hi⟩) (a₂ := ⟨j, hj⟩) (by simpa using h2)
  exact hij (Fin.ext (by simpa using congrArg Fin.val this))

