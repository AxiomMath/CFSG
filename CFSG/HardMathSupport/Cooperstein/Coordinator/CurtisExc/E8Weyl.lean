@[expose] def e8W0Word : List (Fin Tag.E8.rank) :=
  (List.replicate 15 ([0, 1, 2, 3, 4, 5, 6, 7] : List (Fin 8))).flatten

theorem e8W0_single : ∀ i : Fin Tag.E8.rank,
    e8W0Word.foldr (reflect .E8) (Pi.single i 1) = -Pi.single i 1 := by
  decide +kernel

theorem wordProd_smul_neg_of_single
    {τ : Tag} {l : List (Fin τ.rank)}
    (h : ∀ i : Fin τ.rank, l.foldr (reflect τ) (Pi.single i 1) = -Pi.single i 1)
    (α : Fin τ.rank → ℤ) : (coxeterSystem τ).wordProd l • α = -α := by
  have hf : ∀ i : Fin τ.rank, ∀ c : ℤ,
      (coxeterSystem τ).wordProd l • (Pi.single i c : Fin τ.rank → ℤ) =
        -(Pi.single i c : Fin τ.rank → ℤ) := by
    intro i c
    have e : (Pi.single i c : Fin τ.rank → ℤ) = c • Pi.single i 1 := by
      rw [← Pi.single_smul, smul_eq_mul, mul_one]
    rw [e, smul_comm, wordProd_smul', h, smul_neg]
  conv_lhs => rw [← Finset.univ_sum_single α]
  rw [Finset.smul_sum]
  simp only [hf, Finset.sum_neg_distrib, Finset.univ_sum_single]

theorem exists_weyl_neg_E8 :
    ∃ w₁ : WeylGroup .E8, ∀ α : Fin Tag.E8.rank → ℤ, w₁ • α = -α :=
  ⟨_, wordProd_smul_neg_of_single e8W0_single⟩

@[expose] def e8Omega : Fin Tag.E8.rank → Fin Tag.E8.rank → ℤ :=
  ![![4, 5, 7, 10, 8, 6, 4, 2],
    ![5, 8, 10, 15, 12, 9, 6, 3],
    ![7, 10, 14, 20, 16, 12, 8, 4],
    ![10, 15, 20, 30, 24, 18, 12, 6],
    ![8, 12, 16, 24, 20, 15, 10, 5],
    ![6, 9, 12, 18, 15, 12, 8, 4],
    ![4, 6, 8, 12, 10, 8, 6, 3],
    ![2, 3, 4, 6, 5, 4, 3, 2]]

theorem reflect_e8Omega : ∀ s j : Fin Tag.E8.rank, j ≠ s → reflect .E8 j (e8Omega s) = e8Omega s := by
  decide +kernel

