@[expose] def orbitWordsRev (tbl : List ℕ) : List (List (Fin Tag.E8.rank)) :=
  tbl.foldl (fun acc c => (⟨c % 8, Nat.mod_lt _ (by decide)⟩ ::
    acc.getD (acc.length - 1 - c / 8) []) :: acc) [[]]

@[expose] def orbitWordsBig (tbl : List ℕ) : List (List (Fin Tag.E8.rank)) :=
  (orbitWordsRev tbl).reverse

theorem orbitWordsBig_check : ∀ s : Fin 7,
    (orbitWordsBig (orbitTablesBig.getD s [])).length = 1985 ∧
      strictB (msortBig ((orbitWordsBig (orbitTablesBig.getD s [])).map fun l =>
        codeL (l.foldr reflectL (List.ofFn (e8Omega (node7 s)))))) = true := by
  decide +kernel

theorem exists_orbit_e8Omega_big
    (s : Fin Tag.E8.rank) (hs : s.val ≠ 7) :
    ∃ w : Fin 1985 → WeylGroup .E8, ∀ i j, i ≠ j → w i • e8Omega s ≠ w j • e8Omega s := by
  obtain ⟨s', rfl⟩ : ∃ s' : Fin 7, node7 s' = s := by
    refine ⟨⟨s.val, ?_⟩, Fin.ext rfl⟩
    have h1 := s.isLt
    change s.val < 8 at h1
    omega
  obtain ⟨hlen, hch⟩ := orbitWordsBig_check s'
  have hnd := nodup_of_strictB_big hch
  set ws := orbitWordsBig (orbitTablesBig.getD s' [])
  refine ⟨fun i => (coxeterSystem .E8).wordProd (ws.get (i.cast hlen.symm)), fun i j hij h => ?_⟩
  rw [wordProd_smul', wordProd_smul'] at h
  have h2 := congrArg (fun v => codeL (List.ofFn v)) h
  simp only [ofFn_foldr_reflect] at h2
  have hinj := List.nodup_iff_injective_get.1 hnd
  have hi : (i : ℕ) < (ws.map fun l => codeL (List.foldr reflectL
      (List.ofFn (e8Omega (node7 s'))) l)).length := by simp [hlen]
  have hj : (j : ℕ) < (ws.map fun l => codeL (List.foldr reflectL
      (List.ofFn (e8Omega (node7 s'))) l)).length := by simp [hlen]
  have := hinj (a₁ := ⟨i, hi⟩) (a₂ := ⟨j, hj⟩) (by simpa using h2)
  exact hij (Fin.ext (by simpa using congrArg Fin.val this))

end CFSG.HardMathSupport.Cooperstein.Coordinator.CurtisExc
