@[expose] def tgt (k j : ℕ) : ℕ := (tgtTab.getD k []).getD j 0

@[expose] def Em2 (k : ℕ) : Matrix Ix Ix (ZMod 2) := fun i j => if tgt k j = i.val + 1 then 1 else 0

@[expose] def s3Z : Ix → ZMod 2 := fun i => if i.val = 12 ∨ i.val = 13 ∨ i.val = 14 then 1 else 0

@[expose] def Gm2 (k : ℕ) : Matrix Ix Ix (ZMod 2) :=
  if graphRoot (e6root k) = e6root k then 1 + Em2 k else (1 + Em2 k) * (1 + Em2 (gamK k))

@[expose] def witTab : List (ℕ × ℕ) := [(40, 7), (23, 5), (3, 3), (1, 4), (8, 3), (1, 6), (3, 8),
  (1, 9), (12, 6), (3, 11), (34, 4), (12, 9), (0, 0), (0, 0), (0, 0), (23, 22), (3, 18), (3, 19),
  (1, 20), (1, 21), (8, 18), (8, 19), (1, 23), (3, 24), (12, 23), (34, 21), (47, 20)]

theorem tgt_eq : ∀ k < 72, ∀ j : Ix, tgt k j = dig (e6Data.op k) j / 2 := by decide +kernel

theorem gamK_lt : ∀ k < 72, gamK k < 72 := by decide +kernel

theorem graphRoot_root : ∀ k < 72, graphRoot (e6root k) = e6root (gamK k) := by decide +kernel

theorem f_fix_checks : ∀ k < 72,
    (graphRoot (e6root k) = e6root k →
      Em2 k *ᵥ s3Z = 0 ∧ s3Z ᵥ* Em2 k = 0) ∧
    (graphRoot (e6root k) ≠ e6root k →
      (Em2 k + Em2 (gamK k)) *ᵥ s3Z = 0 ∧ Em2 k *ᵥ (Em2 (gamK k) *ᵥ s3Z) = 0 ∧
        s3Z ᵥ* (Em2 k + Em2 (gamK k)) = 0 ∧ (s3Z ᵥ* Em2 k) ᵥ* Em2 (gamK k) = 0) := by
  decide +kernel

theorem wit_check : ∀ b : Ix, ¬ (b.val = 12 ∨ b.val = 13 ∨ b.val = 14) →
    (witTab.getD b.val (0, 0)).1 < 72 ∧
    graphRoot (e6root (witTab.getD b.val (0, 0)).1) = e6root (witTab.getD b.val (0, 0)).1 ∧
    ∃ a : Ix, a.val = (witTab.getD b.val (0, 0)).2 ∧
      ∀ i : Ix, (Gm2 (witTab.getD b.val (0, 0)).1 - 1) i a = if i = b then 1 else 0 := by
  decide +kernel

theorem trip_check_0 : ∃ a : Ix, a.val = 15 ∧ graphRoot (e6root 0) ≠ e6root 0 ∧
    ∀ i : Ix, (Gm2 0 - 1) i a =
      if i.val = 10 ∨ i.val = 12 ∨ i.val = 13 then 1 else 0 := by
  decide +kernel

theorem trip_check_2 : ∃ a : Ix, a.val = 16 ∧ graphRoot (e6root 2) ≠ e6root 2 ∧
    ∀ i : Ix, (Gm2 2 - 1) i a =
      if i.val = 11 ∨ i.val = 13 ∨ i.val = 14 then 1 else 0 := by
  decide +kernel

@[expose] def cast2 (K : Type*) [Field K] [CharP K 2] : ZMod 2 →+* K := ZMod.castHom (dvd_refl 2) K

section CastMatrix

variable {K : Type*} [Field K] [CharP K 2]

theorem comp_zero' : cast2 K ∘ (0 : Ix → ZMod 2) = 0 := funext fun _ => map_zero _

theorem map_mulVec' (M : Matrix Ix Ix (ZMod 2)) (v : Ix → ZMod 2) :
    M.map (cast2 K) *ᵥ (cast2 K ∘ v) = cast2 K ∘ (M *ᵥ v) :=
  funext fun i => (RingHom.map_mulVec (cast2 K) M v i).symm

theorem map_vecMul' (M : Matrix Ix Ix (ZMod 2)) (v : Ix → ZMod 2) :
    (cast2 K ∘ v) ᵥ* M.map (cast2 K) = cast2 K ∘ (v ᵥ* M) :=
  funext fun i => (RingHom.map_vecMul (cast2 K) M v i).symm

end CastMatrix

section PairAlgebra

variable {R : Type*} [CommRing R] {n : Type*} [Fintype n] [DecidableEq n]

theorem pair_mulVec (X Y : Matrix n n R) (v : n → R) (c : R) (h1 : (X + Y) *ᵥ v = 0)
    (h2 : X *ᵥ (Y *ᵥ v) = 0) : ((1 + c • X) * (1 + c • Y)) *ᵥ v = v := by
  have e : (1 + c • X) * (1 + c • Y) = 1 + c • (X + Y) + c ^ 2 • (X * Y) := by
    simp only [add_mul, mul_add, one_mul, mul_one, smul_mul_assoc, mul_smul_comm, smul_smul,
      smul_add, pow_two]
    abel
  rw [e, add_mulVec, add_mulVec, one_mulVec, smul_mulVec, smul_mulVec, h1, ← mulVec_mulVec, h2]
  simp

theorem pair_vecMul (X Y : Matrix n n R) (w : n → R) (c : R) (h1 : w ᵥ* (X + Y) = 0)
    (h2 : (w ᵥ* X) ᵥ* Y = 0) : w ᵥ* ((1 + c • X) * (1 + c • Y)) = w := by
  have e : (1 + c • X) * (1 + c • Y) = 1 + c • (X + Y) + c ^ 2 • (X * Y) := by
    simp only [add_mul, mul_add, one_mul, mul_one, smul_mul_assoc, mul_smul_comm, smul_smul,
      smul_add, pow_two]
    abel
  rw [e, vecMul_add, vecMul_add, vecMul_one, vecMul_smul, vecMul_smul, h1, ← vecMul_vecMul, h2]
  simp

end PairAlgebra

