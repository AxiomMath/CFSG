theorem e6Adj_nb : e6AdjNb = (List.range (e6AllR.length + e6R.length)).map fun v =>
    bitsOf (e6AllR.length + e6R.length) (adjQ e6R e6AllR (List.replicate 6 0) v) := by
  decide +kernel

theorem e6Adj_chk : ∀ i < e6R.length,
    (pairGraph e6AllR.length e6AdjNb 2 1).bnb e6AdjO 200
      (rootMask e6AllR.length (e6AllR.length + e6R.length) e6AdjNb i) 51 = true := by
  decide +kernel

theorem e6AllR_iff : ∀ l : List ℤ, l ∈ Tag.E6.artifactRoots ↔ l ∈ e6AllR := by
  have h1 : ∀ l ∈ Tag.E6.artifactRoots, l ∈ e6AllR := by decide +kernel
  have h2 : ∀ l ∈ e6AllR, l ∈ Tag.E6.artifactRoots := by decide +kernel
  exact fun l => ⟨h1 l, h2 l⟩

theorem e6_isRoot_iff (μ : Fin Tag.E6.rank → ℤ) : IsRoot .E6 μ ↔ List.ofFn μ ∈ e6AllR := by
  rw [isRoot_iff_mem_artifactRoots, e6AllR_iff]

theorem e6_adj_numbers
    (X Y : Finset (Fin Tag.E6.rank → ℤ)) (hX : X.Nonempty)
    (hXP : ∀ γ ∈ X, IsRoot .E6 γ ∧ 0 < ht γ)
    (hXX : ∀ γ ∈ X, ∀ δ ∈ X, ¬ IsRoot .E6 (γ + δ)) (hYW : ∀ μ ∈ Y, IsRoot .E6 μ)
    (hXY : ∀ γ ∈ X, ∀ μ ∈ Y, ¬ IsRoot .E6 (γ + μ) ∧ γ + μ ≠ 0) :
    2 * X.card + Y.card ≤ 53 := by
  have := pair_transfer' (n := Tag.E6.rank) e6R e6AllR (List.replicate 6 0) e6AdjNb e6AdjO 2 1 51
    (fun γ => IsRoot .E6 γ ∧ 0 < ht γ) (fun μ => IsRoot .E6 μ) e6Adj_nb e6Adj_chk
    posData_E6.mem e6_isRoot_iff (by decide) X Y hX hXP
    (fun γ hγ δ hδ h => hXX γ hγ δ hδ h.1) hYW hXY
  omega

