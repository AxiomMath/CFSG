theorem f4Weight_fixed : ∀ a b : Fin 4, b ≠ a →
    reflect Tag.F4 b (f4Weight a) = f4Weight a := by
  decide +kernel

theorem f4Words_length : ∀ a : Fin 4, (f4Words a).length = f4OrbitSize a := by
  decide +kernel

theorem f4Words_nodup : ∀ a : Fin 4,
    ((f4Words a).map fun w => w.foldr (reflect Tag.F4) (f4Weight a)).Nodup := by
  decide +kernel

