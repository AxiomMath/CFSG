    [2, 3, 2, 1, 2, 0, 1, 2, 3, 1, 2, 0, 1, 2]
  ] : List (List (Fin 4)))

@[expose] def pairWords : Fin 4 → Fin 4 → List (List (Fin 4)) :=
  ![![[], pairWords01, pairWords02, pairWords03], ![pairWords01, [], pairWords12, pairWords13],
    ![pairWords02, pairWords12, [], pairWords23], ![pairWords03, pairWords13, pairWords23, []]]

theorem pairWeight_fixed : ∀ a b j : Fin 4, j ≠ a → j ≠ b →
    reflect Tag.F4 j (f4Weight a + f4Weight b) = f4Weight a + f4Weight b := by
  decide +kernel

theorem pairWords_length : ∀ a b : Fin 4, a ≠ b → 144 ≤ (pairWords a b).length := by
  decide +kernel

theorem pairWords_nodup : ∀ a b : Fin 4, a ≠ b →
    ((pairWords a b).map fun w => w.foldr (reflect Tag.F4) (f4Weight a + f4Weight b)).Nodup := by
  decide +kernel

