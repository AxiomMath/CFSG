  CFSG.LieType.Chevalley CoxeterSystem

section Supp

variable {τ : Tag}

theorem foldr_reflect_eq_of_notMem_supp {S : Finset (Fin τ.rank)} {v : Fin τ.rank → ℤ}
    (hv : ∀ j, j ∉ S → reflect τ j v = v) {l : List (Fin τ.rank)} (hl : ∀ s ∈ S, s ∉ l) :
    l.foldr (reflect τ) v = v := by
  induction l with
  | nil => rfl
  | cons j l ih =>
    rw [List.foldr_cons, ih (fun s hs h => hl s hs (List.mem_cons_of_mem _ h))]
    exact hv j fun hj => hl j hj List.mem_cons_self

theorem exists_letter_of_smul_ne_supp
    {S : Finset (Fin τ.rank)} {v : Fin τ.rank → ℤ} (hv : ∀ j, j ∉ S → reflect τ j v = v)
    {l : List (Fin τ.rank)} (h : (coxeterSystem τ).wordProd l • v ≠ v) : ∃ s ∈ S, s ∈ l := by
  by_contra hs
  push Not at hs
  exact h (by rw [CurtisExc.wordProd_smul', foldr_reflect_eq_of_notMem_supp hv hs])

end Supp

section Chev


variable {τ : Tag} {K : Type} [Field K] [Finite K] [CharP K 2]
  {hw : ∃ w₁ : WeylGroup τ, ∀ α : Fin τ.rank → ℤ, w₁ • α = -α}
  {k : Type} [Field k] [Algebra K k] [CharP k 2] {V : Type} [AddCommGroup V] [Module k V]

theorem card_le_finrank_of_isChevType_supp [Module.Finite k V]
    {ρ : Representation k (adjointGroup τ K) V} (hρ : IsSimpleRep ρ) {y : V}
    {χ : adjointGroup τ K → k} {J : Finset (Fin τ.rank)} (ht : IsChevType τ K 2 hw ρ y χ J)
    {S : Finset (Fin τ.rank)} (hS : ∀ s ∈ S, s ∉ J) {v : Fin τ.rank → ℤ}
    (hv : ∀ j, j ∉ S → reflect τ j v = v) {m : ℕ} (w : Fin m → WeylGroup τ)
    (hinj : ∀ i j, i ≠ j → w i • v ≠ w j • v) : m ≤ Module.finrank k V := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨μ, hμ⟩ := ht.exists_mu hρ
  refine CurtisExc.card_le_finrank hρ hμ w fun i j hij ω hω hωe => ?_
  obtain ⟨s, hsS, hsω⟩ : ∃ s ∈ S, s ∈ ω := by
    refine exists_letter_of_smul_ne_supp hv fun h => hinj i j hij ?_
    rw [hωe, mul_smul] at h
    have := congrArg (fun z => w i • z) h
    simpa [smul_smul] using this.symm
  exact ⟨s, hsω, CurtisExc.mu_eq_dScalar_of_notMem ht hμ (hS s hsS)⟩

end Chev

