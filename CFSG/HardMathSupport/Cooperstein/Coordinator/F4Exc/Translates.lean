@[expose] def omEnds : Fin Tag.F4.rank → ℤ := fun l => f4Omega (f4n 0) l + f4Omega (f4n 3) l

theorem reflect_omEnds : ∀ j : Fin Tag.F4.rank, j.val = 1 ∨ j.val = 2 → reflect .F4 j omEnds = omEnds := by
  decide +kernel

theorem orbWords_mid : ∀ (s : Fin Tag.F4.rank), (s.val = 1 ∨ s.val = 2) → ∀ (i j : Fin 96), i ≠ j →
    ((orbWords.getD (s.val - 1) []).getD i []).foldr reflectLF (List.ofFn (f4Omega s)) ≠
      ((orbWords.getD (s.val - 1) []).getD j []).foldr reflectLF (List.ofFn (f4Omega s)) := by
  decide +kernel

theorem orbWords_ends : ∀ (i j : Fin 144), i ≠ j →
    ((orbWords.getD 2 []).getD i []).foldr reflectLF (List.ofFn omEnds) ≠
      ((orbWords.getD 2 []).getD j []).foldr reflectLF (List.ofFn omEnds) := by
  decide +kernel

theorem exists_orbit_mid
    (s : Fin Tag.F4.rank) (hs : s.val = 1 ∨ s.val = 2) :
    ∃ w : Fin 96 → WeylGroup .F4, ∀ i j, i ≠ j → w i • f4Omega s ≠ w j • f4Omega s := by
  refine ⟨fun i => (coxeterSystem .F4).wordProd ((orbWords.getD (s.val - 1) []).getD i []),
    fun i j hij h => ?_⟩
  simp only [CurtisExc.wordProd_smul'] at h
  have h2 := congrArg List.ofFn h
  rw [ofFn_foldr_reflect, ofFn_foldr_reflect] at h2
  exact orbWords_mid s hs i j hij h2

theorem exists_orbit_ends :
    ∃ w : Fin 144 → WeylGroup .F4, ∀ i j, i ≠ j → w i • omEnds ≠ w j • omEnds := by
  refine ⟨fun i => (coxeterSystem .F4).wordProd ((orbWords.getD 2 []).getD i []), fun i j hij h => ?_⟩
  simp only [CurtisExc.wordProd_smul'] at h
  have h2 := congrArg List.ofFn h
  rw [ofFn_foldr_reflect, ofFn_foldr_reflect] at h2
  exact orbWords_ends i j hij h2

