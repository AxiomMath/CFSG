section Fund

variable {n : ℕ}

@[expose] def cumE (e : Fin n → ℤ) (a : Fin n) : ℤ := ∑ b ∈ Finset.univ.filter (· ≤ a), e b

@[expose] def fundOf (e : Fin n → ℤ) : Fin n → ℤ := fun a => cumE e a / (if a.val + 1 = n then 2 else 1)

theorem cumE_add (e f : Fin n → ℤ) (a : Fin n) : cumE (e + f) a = cumE e a + cumE f a := by
  simp [cumE, Finset.sum_add_distrib]

theorem cumE_neg (e : Fin n → ℤ) (a : Fin n) : cumE (-e) a = - cumE e a := by
  simp [cumE, Finset.sum_neg_distrib]

theorem cumE_sub (e f : Fin n → ℤ) (a : Fin n) : cumE (e - f) a = cumE e a - cumE f a := by
  simp [cumE, Finset.sum_sub_distrib]

theorem cumE_single (u : Fin n) (c : ℤ) (a : Fin n) :
    cumE (Pi.single u c) a = if u ≤ a then c else 0 := by
  unfold cumE
  rw [Finset.sum_pi_single']
  simp

theorem cumE_succ (e : Fin n → ℤ) (a : Fin n) (ha : 0 < a.val) :
    cumE e a = cumE e ⟨a.val - 1, by omega⟩ + e a := by
  unfold cumE
  have : Finset.univ.filter (· ≤ a) = insert a (Finset.univ.filter (· ≤ (⟨a.val - 1, by omega⟩ : Fin n))) := by
    ext b
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.le_def]
    constructor
    · intro h
      by_cases hb : b.val = a.val
      · exact Or.inl (Fin.ext hb)
      · exact Or.inr (by omega)
    · rintro (rfl | h)
      · exact le_rfl
      · have h' : b.val ≤ a.val - 1 := h
        omega
  rw [this, Finset.sum_insert (by simp [Fin.le_def]; omega), add_comm]

theorem cumE_zero (e : Fin n → ℤ) (a : Fin n) (ha : a.val = 0) : cumE e a = e a := by
  unfold cumE
  have : Finset.univ.filter (· ≤ a) = {a} := by
    ext b
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton, Fin.le_def]
    constructor
    · intro h; exact Fin.ext (by omega)
    · rintro rfl; exact le_rfl
  rw [this, Finset.sum_singleton]

theorem toStd_fundOf (e : Fin n → ℤ) (hsum : ∀ a : Fin n, a.val + 1 = n → 2 ∣ cumE e a) :
    toStd n (fundOf e) = e := by
  funext a
  simp only [toStd, fundOf]
  have h1 : (if a.val + 1 = n then (2 : ℤ) else 1) * (cumE e a / (if a.val + 1 = n then 2 else 1)) = cumE e a := by
    split_ifs with h
    · exact Int.mul_ediv_cancel' (hsum a h)
    · simp
  rw [h1]
  by_cases ha : 0 < a.val
  · rw [dif_pos ha, cumE_succ e a ha]
    have h2 : cumE e ⟨a.val - 1, by omega⟩ / (if (a.val - 1) + 1 = n then 2 else 1) = cumE e ⟨a.val - 1, by omega⟩ := by
      have : (a.val - 1) + 1 ≠ n := by omega
      simp [this]
    simp only [h2]
    ring
  · rw [dif_neg ha, cumE_zero e a (by omega)]
    simp

theorem fundOf_eq_zero (e : Fin n → ℤ) (a : Fin n) (h : cumE e a = 0) : fundOf e a = 0 := by
  simp [fundOf, h]

end Fund

section KL

variable {n : ℕ} {F : Type} [Field F]

@[expose] def rLo : RootSubgroupIndex n → ℕ
  | .positiveLong i => i.val
  | .negativeLong i => i.val
  | .difference i j _ => min i.val j.val
  | .positiveSum i _ _ => i.val
  | .negativeSum i _ _ => i.val

@[expose] def rHi : RootSubgroupIndex n → ℕ
  | .difference i j _ => max i.val j.val
  | _ => n

theorem cumE_pl (i k : Fin n) : cumE (stdVec (.positiveLong i)) k = if i ≤ k then 2 else 0 := by
  simp only [stdVec, two_nsmul, cumE_add, cumE_single]
  split_ifs <;> simp

theorem cumE_nl (i k : Fin n) : cumE (stdVec (.negativeLong i)) k = - (if i ≤ k then 2 else 0) := by
  simp only [stdVec, two_nsmul, cumE_neg, cumE_add, cumE_single]
  split_ifs <;> simp

theorem cumE_df (i j k : Fin n) (h : i ≠ j) :
    cumE (stdVec (.difference i j h)) k = (if i ≤ k then 1 else 0) - (if j ≤ k then 1 else 0) := by
  simp only [stdVec, cumE_sub, cumE_single]

theorem cumE_ps (i j k : Fin n) (h : i < j) :
    cumE (stdVec (.positiveSum i j h)) k = (if i ≤ k then 1 else 0) + (if j ≤ k then 1 else 0) := by
  simp only [stdVec, cumE_add, cumE_single]

theorem cumE_ns (i j k : Fin n) (h : i < j) :
    cumE (stdVec (.negativeSum i j h)) k =
      - ((if i ≤ k then 1 else 0) + (if j ≤ k then 1 else 0)) := by
  simp only [stdVec, cumE_neg, cumE_add, cumE_single]

theorem cumE_stdVec_ne_zero {r : RootSubgroupIndex n} {k : Fin n} (h : cumE (stdVec r) k ≠ 0) :
    rLo r ≤ k.val ∧ k.val < rHi r := by
  cases r with
  | positiveLong i =>
    rw [cumE_pl] at h
    simp only [rLo, rHi]
    refine ⟨?_, k.2⟩
    by_contra hc
    apply h
    simp only [Fin.le_def]
    split_ifs <;> omega
  | negativeLong i =>
    rw [cumE_nl] at h
    simp only [rLo, rHi]
    refine ⟨?_, k.2⟩
    by_contra hc
    apply h
    simp only [Fin.le_def]
    split_ifs <;> omega
  | difference i j hij =>
    rw [cumE_df _ _ _ hij] at h
    simp only [rLo, rHi]
    by_contra hc
    apply h
    simp only [Fin.le_def]
    split_ifs <;> omega
  | positiveSum i j hij =>
    rw [cumE_ps _ _ _ hij] at h
    simp only [rLo, rHi]
    have hij' : i.val < j.val := hij
    refine ⟨?_, k.2⟩
    by_contra hc
    apply h
    simp only [Fin.le_def]
    split_ifs <;> omega
  | negativeSum i j hij =>
    rw [cumE_ns _ _ _ hij] at h
    simp only [rLo, rHi]
    have hij' : i.val < j.val := hij
    refine ⟨?_, k.2⟩
    by_contra hc
    apply h
    simp only [Fin.le_def]
    split_ifs <;> omega

theorem even_cumE_last (r : RootSubgroupIndex n) (a : Fin n) (ha : a.val + 1 = n) :
    2 ∣ cumE (stdVec r) a := by
  have hle : ∀ i : Fin n, i ≤ a := fun i => by rw [Fin.le_def]; omega
  cases r with
  | positiveLong i => simp [cumE_pl, hle]
  | negativeLong i => simp [cumE_nl, hle]
  | difference i j h => simp [cumE_df _ _ _ h, hle]
  | positiveSum i j h => simp [cumE_ps _ _ _ h, hle]
  | negativeSum i j h => simp [cumE_ns _ _ _ h, hle]

theorem elt_mem_leviM (r : RootSubgroupIndex n) {I : Set (Fin n)}
    (hI : ∀ k : Fin n, rLo r ≤ k.val → k.val < rHi r → k ∈ I) (c : F) :
    elt r c ∈ leviM (rootDatum n F) I := by
  set γ := fundOf (stdVec r) with hγ
  have hr : stdVec r = toStd n γ := (toStd_fundOf _ (even_cumE_last r)).symm
  have hroot : γ ∈ (rootDatum n F).roots := by
    change γ ∈ CFSG.LieType.RootSystem.roots (isFiniteType_cartanC n) ∅
    rw [roots_eq]
    exact ⟨r, hr⟩
  have hsupp : ∀ k ∉ I, γ k = 0 := by
    intro k hk
    by_contra hne
    have : cumE (stdVec r) k ≠ 0 := fun h => hne (fundOf_eq_zero _ _ h)
    obtain ⟨h1, h2⟩ := cumE_stdVec_ne_zero this
    exact hk (hI k h1 h2)
  exact rootGroup_le_leviM (isCTGroupDatum n F) hroot hsupp (elt_mem_rootGroup hr c)

end KL

section Compat

variable {k n : ℕ} {F : Type} [Field F]

@[expose] def mapIdx (σ : Fin k → Fin n) (hσ : StrictMono σ) : RootSubgroupIndex k → RootSubgroupIndex n
  | .positiveLong i => .positiveLong (σ i)
  | .negativeLong i => .negativeLong (σ i)
  | .difference i j h => .difference (σ i) (σ j) (fun e => h (hσ.injective e))
  | .positiveSum i j h => .positiveSum (σ i) (σ j) (hσ h)
  | .negativeSum i j h => .negativeSum (σ i) (σ j) (hσ h)

theorem spIncl_E (σ : Fin k → Fin n) (hσ : StrictMono σ) (r : RootSubgroupIndex k) :
    spIncl (K := F) σ * E F r * (spIncl (K := F) σ)ᵀ = E F (mapIdx σ hσ r) := by
  cases r <;> simp [E, mapIdx, Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_add, Matrix.add_mul,
    spIncl_mul_single_mul_transpose, Sum.map]

theorem spEmbed_elt (σ : Fin k → Fin n) (hσ : StrictMono σ) (r : RootSubgroupIndex k) (c : F) :
    spEmbed σ hσ.injective (elt r c) = elt (mapIdx σ hσ r) c := by
  apply mat_injective
  rw [mat_spEmbed, mat_elt, mat_elt, spEmbedMat]
  have : spIncl (K := F) σ * (1 + c • E F r - 1) * (spIncl (K := F) σ)ᵀ =
      c • E F (mapIdx σ hσ r) := by
    rw [← spIncl_E σ hσ r, add_sub_cancel_left, Matrix.mul_smul, Matrix.smul_mul]
  rw [this]

end Compat


section Blocks

open Classical

variable {n : ℕ} {I : Set (Fin n)}

@[expose] noncomputable def coordsOf (B : Finset (Fin (n + 1))) : Finset (Fin n) :=
  Finset.univ.filter fun i => i.castSucc ∈ B

@[expose] def nodesOf (B : Finset (Fin (n + 1))) : Set (Fin n) := {k | k.castSucc ∈ B ∧ k.succ ∈ B}

theorem mem_coordsOf {B : Finset (Fin (n + 1))} {i : Fin n} : i ∈ coordsOf B ↔ i.castSucc ∈ B := by
  simp [coordsOf]

theorem blkSet_convex {p u v w : Fin (n + 1)} (hu : u ∈ blkSet I p) (hv : v ∈ blkSet I p)
    (huw : u ≤ w) (hwv : w ≤ v) : w ∈ blkSet I p := by
  rw [mem_blkSet] at hu hv ⊢
  intro j hj
  have h1 := hu j hj
  have h2 := hv j hj
  rw [Fin.le_def] at huw hwv
  constructor
  · intro hpj
    have := h2.mp hpj
    omega
  · intro hwj
    apply h1.mpr
    omega

theorem nodesOf_subset (p : Fin (n + 1)) : nodesOf (blkSet I p) ⊆ I := by
  intro k ⟨h1, h2⟩
  by_contra hk
  have a1 := (mem_blkSet.mp h1) k hk
  have a2 := (mem_blkSet.mp h2) k hk
  simp only [Fin.val_castSucc, Fin.val_succ] at a1 a2
  have h3 := a1.mpr (le_refl _)
  have h4 := a2.mp h3
  omega

theorem mem_nodesOf_of_mem {k : Fin n} (hk : k ∈ I) :
    k ∈ nodesOf (blkSet I k.castSucc) := by
  refine ⟨self_mem_blkSet _, mem_blkSet.mpr ?_⟩
  intro j hj
  have : j.val ≠ k.val := fun h => hj (Fin.ext h ▸ hk)
  simp only [Fin.val_castSucc, Fin.val_succ]
  omega

theorem mem_nodesOf_of_between {p : Fin (n + 1)} {a b k : Fin n}
    (ha : a.castSucc ∈ blkSet I p) (hb : b.castSucc ∈ blkSet I p) (h1 : min a.val b.val ≤ k.val)
    (h2 : k.val < max a.val b.val) : k ∈ nodesOf (blkSet I p) := by
  rcases le_total a.val b.val with hab | hab
  · rw [min_eq_left hab] at h1
    rw [max_eq_right hab] at h2
    exact ⟨blkSet_convex ha hb (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)
        (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega),
      blkSet_convex ha hb (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)
        (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)⟩
  · rw [min_eq_right hab] at h1
    rw [max_eq_left hab] at h2
    exact ⟨blkSet_convex hb ha (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)
        (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega),
      blkSet_convex hb ha (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)
        (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ]; omega)⟩

theorem mem_nodesOf_of_ge {p : Fin (n + 1)} {a k : Fin n}
    (ha : a.castSucc ∈ blkSet I p) (hl : Fin.last n ∈ blkSet I p) (h1 : a.val ≤ k.val) :
    k ∈ nodesOf (blkSet I p) :=
  ⟨blkSet_convex ha hl (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ, Fin.val_last]; omega)
      (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ, Fin.val_last]; omega),
    blkSet_convex ha hl (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ, Fin.val_last]; omega)
      (by simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ, Fin.val_last]; omega)⟩

end Blocks


section Groups

open CFSG.AGLEmbeddingD2.SquareSymplectic CFSG.AGLEmbeddingD2.SquareLinear CFSG.LieType.CurtisTits

variable {n : ℕ} {F : Type} [Field F] {I : Set (Fin n)}

@[expose] noncomputable def leviSL (n : ℕ) (F : Type) [Field F] :
    SpecialLinearGroup (Fin n) F →* StatedSp n F :=
  (leviSp n F).comp SpecialLinearGroup.toGL

theorem leviSL_injective : Function.Injective (leviSL n F) := by
  intro A B h
  have h1 := leviSp_injective h
  exact Subtype.ext (by simpa using congrArg (fun g : GL (Fin n) F => (g : Matrix (Fin n) (Fin n) F)) h1)

theorem leviSL_transvection {x y : Fin n} (hxy : x ≠ y) (c : F) :
    leviSL n F (SpecialLinearGroup.transvection hxy c) = elt (.difference x y hxy) c := by
  rw [elt_difference_eq_leviHom hxy c, ← TauCeti.toGL_transvection_eq_transvectionUnit]
  rfl

@[expose] noncomputable def GA (F : Type) [Field F] (B : Finset (Fin (n + 1))) : Subgroup (StatedSp n F) :=
  ((coordHom (F := F) (coordsOf B)).range).map (leviSL n F)

theorem rankOne_le_of_elt {i : Fin n} {P : Subgroup (StatedSp n F)} {r₁ r₂ : RootSubgroupIndex n}
    (h₁ : stdVec r₁ = toStd n (Pi.single i 1)) (h₂ : stdVec r₂ = toStd n (-Pi.single i 1))
    (hP₁ : ∀ c : F, elt r₁ c ∈ P) (hP₂ : ∀ c : F, elt r₂ c ∈ P) :
    rankOne (rootDatum n F).rootGroup i ≤ P := by
  refine sup_le ?_ ?_
  · intro g hg
    obtain ⟨c, rfl⟩ := (mem_rootGroup_iff h₁).mp hg
    exact hP₁ c
  · intro g hg
    obtain ⟨c, rfl⟩ := (mem_rootGroup_iff h₂).mp hg
    exact hP₂ c

theorem short_node_idx {i : Fin n} (hi : i.val + 1 < n) :
    stdVec (RootSubgroupIndex.difference i ⟨i.val + 1, hi⟩ (ne_succ' hi)) = toStd n (Pi.single i 1) ∧
    stdVec (RootSubgroupIndex.difference ⟨i.val + 1, hi⟩ i (ne_succ' hi).symm) =
      toStd n (-Pi.single i 1) :=
  ⟨stdVec_shortPos_eq hi, stdVec_shortNeg_eq hi⟩

theorem leviSL_range_coordHom_le (B : Finset (Fin (n + 1))) {p : Fin (n + 1)}
    (hB : B = blkSet I p) : GA F B ≤ leviM (rootDatum n F) (nodesOf B) := by
  subst hB
  rintro _ ⟨_, ⟨A, rfl⟩, rfl⟩
  have hA : A ∈ Subgroup.closure (Set.range (Matrix.TransvectionStruct.toSpecialLinearGroup :
      Matrix.TransvectionStruct ↥(coordsOf (blkSet I p)) F →
        Matrix.SpecialLinearGroup ↥(coordsOf (blkSet I p)) F)) := by
    rw [Matrix.SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top_of_field]
    exact Subgroup.mem_top _
  induction hA using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨t, rfl⟩ := hx
    obtain ⟨u, v, huv, c⟩ := t
    rw [Matrix.TransvectionStruct.toSpecialLinearGroup_mk, coordHom_transvection]
    have hne : (u : Fin n) ≠ v := fun h => huv (Subtype.ext h)
    rw [leviSL_transvection hne]
    refine elt_mem_leviM _ ?_ c
    intro k h1 h2
    simp only [rLo, rHi] at h1 h2
    exact mem_nodesOf_of_between (mem_coordsOf.mp u.2) (mem_coordsOf.mp v.2) h1 h2
  | one => rw [map_one, map_one]; exact one_mem _
  | mul x y _ _ hx hy => rw [map_mul, map_mul]; exact mul_mem hx hy
  | inv x _ hx => rw [map_inv, map_inv]; exact inv_mem hx

theorem elt_diff_mem_GA {B : Finset (Fin (n + 1))} {x y : Fin n} (hxy : x ≠ y)
    (hx : x.castSucc ∈ B) (hy : y.castSucc ∈ B) (c : F) :
    elt (.difference x y hxy) c ∈ GA F B := by
  have hne : (⟨x, mem_coordsOf.mpr hx⟩ : ↥(coordsOf B)) ≠ ⟨y, mem_coordsOf.mpr hy⟩ :=
    fun h => hxy (congrArg Subtype.val h)
  refine ⟨_, ⟨Matrix.SpecialLinearGroup.transvection hne c, rfl⟩, ?_⟩
  rw [coordHom_transvection (coordsOf B) hne c]
  exact leviSL_transvection hxy c

theorem rankOne_le_GA {B : Finset (Fin (n + 1))} (hl : Fin.last n ∉ B) {i : Fin n}
    (hi : i ∈ nodesOf B) : rankOne (rootDatum n F).rootGroup i ≤ GA F B := by
  have hs : i.val + 1 < n := by
    by_contra h
    apply hl
    have : i.succ = Fin.last n := Fin.ext (by simp only [Fin.val_succ, Fin.val_last]; omega)
    rw [← this]
    exact hi.2
  obtain ⟨h₁, h₂⟩ := short_node_idx (i := i) hs
  have hsucc : (⟨i.val + 1, hs⟩ : Fin n).castSucc ∈ B := by
    have : (⟨i.val + 1, hs⟩ : Fin n).castSucc = i.succ := Fin.ext (by simp)
    rw [this]; exact hi.2
  exact rankOne_le_of_elt h₁ h₂ (fun c => elt_diff_mem_GA _ hi.1 hsucc c)
    (fun c => elt_diff_mem_GA _ hsucc hi.1 c)

theorem GA_eq {B : Finset (Fin (n + 1))} {p : Fin (n + 1)} (hB : B = blkSet I p)
    (hl : Fin.last n ∉ B) : GA F B = leviM (rootDatum n F) (nodesOf B) :=
  le_antisymm (leviSL_range_coordHom_le B hB)
    (iSup₂_le fun i hi => rankOne_le_GA hl hi)

@[expose] noncomputable def GA_equiv (B : Finset (Fin (n + 1))) :
    ↥(GA F B) ≃* SpecialLinearGroup (Fin (coordsOf B).card) F :=
  ((Subgroup.equivMapOfInjective _ (leviSL n F) leviSL_injective).symm.trans
    (MonoidHom.ofInjective (coordHom_injective (F := F) (coordsOf B))).symm).trans
    (slReindexEquiv (Finset.equivFin (coordsOf B)))

@[expose] noncomputable def sigmaOf (B : Finset (Fin (n + 1))) : Fin (coordsOf B).card → Fin n :=
  fun i => (coordsOf B).orderEmbOfFin rfl i

theorem sigmaOf_strictMono (B : Finset (Fin (n + 1))) : StrictMono (sigmaOf B) :=
  ((coordsOf B).orderEmbOfFin rfl).strictMono

theorem sigmaOf_mem (B : Finset (Fin (n + 1))) (i : Fin (coordsOf B).card) :
    sigmaOf B i ∈ coordsOf B := Finset.orderEmbOfFin_mem _ _ _

theorem exists_sigmaOf {B : Finset (Fin (n + 1))} {x : Fin n} (hx : x ∈ coordsOf B) :
    ∃ i, sigmaOf B i = x := by
  have := Finset.range_orderEmbOfFin (coordsOf B) rfl
  have hx' : x ∈ Set.range ((coordsOf B).orderEmbOfFin rfl) := by rw [this]; exact hx
  exact hx'

@[expose] noncomputable def GE (F : Type) [Field F] (B : Finset (Fin (n + 1))) : Subgroup (StatedSp n F) :=
  (spEmbed (K := F) (sigmaOf B) (sigmaOf_strictMono B).injective).range

theorem elt_diff_mem_GE {B : Finset (Fin (n + 1))} {x y : Fin n} (hxy : x ≠ y)
    (hx : x ∈ coordsOf B) (hy : y ∈ coordsOf B) (c : F) :
    elt (.difference x y hxy) c ∈ GE F B := by
  obtain ⟨i, rfl⟩ := exists_sigmaOf hx
  obtain ⟨j, rfl⟩ := exists_sigmaOf hy
  have hij : i ≠ j := fun h => hxy (by rw [h])
  exact ⟨elt (.difference i j hij) c, by
    rw [spEmbed_elt _ (sigmaOf_strictMono B)]; rfl⟩

theorem elt_pl_mem_GE {B : Finset (Fin (n + 1))} {x : Fin n} (hx : x ∈ coordsOf B) (c : F) :
    elt (.positiveLong x) c ∈ GE F B ∧ elt (.negativeLong x) c ∈ GE F B := by
  obtain ⟨i, rfl⟩ := exists_sigmaOf hx
  exact ⟨⟨elt (.positiveLong i) c, by rw [spEmbed_elt _ (sigmaOf_strictMono B)]; rfl⟩,
    ⟨elt (.negativeLong i) c, by rw [spEmbed_elt _ (sigmaOf_strictMono B)]; rfl⟩⟩

theorem rankOne_le_GE {B : Finset (Fin (n + 1))} {i : Fin n} (hi : i ∈ nodesOf B) :
    rankOne (rootDatum n F).rootGroup i ≤ GE F B := by
  by_cases hs : i.val + 1 < n
  · obtain ⟨h₁, h₂⟩ := short_node_idx (i := i) hs
    have hsucc : (⟨i.val + 1, hs⟩ : Fin n).castSucc ∈ B := by
      have : (⟨i.val + 1, hs⟩ : Fin n).castSucc = i.succ := Fin.ext (by simp)
      rw [this]; exact hi.2
    exact rankOne_le_of_elt h₁ h₂
      (fun c => elt_diff_mem_GE _ (mem_coordsOf.mpr hi.1) (mem_coordsOf.mpr hsucc) c)
      (fun c => elt_diff_mem_GE _ (mem_coordsOf.mpr hsucc) (mem_coordsOf.mpr hi.1) c)
  · exact rankOne_le_of_elt (stdVec_positiveLong_eq hs) (stdVec_negativeLong_eq hs)
      (fun c => (elt_pl_mem_GE (mem_coordsOf.mpr hi.1) c).1)
      (fun c => (elt_pl_mem_GE (mem_coordsOf.mpr hi.1) c).2)

theorem GE_le {B : Finset (Fin (n + 1))} {p : Fin (n + 1)} (hB : B = blkSet I p)
    (hl : Fin.last n ∈ B) : GE F B ≤ leviM (rootDatum n F) (nodesOf B) := by
  subst hB
  have hH : ∀ g : StatedSp (coordsOf (blkSet I p)).card F,
      spEmbed (K := F) (sigmaOf (blkSet I p)) (sigmaOf_strictMono _).injective g ∈
        leviM (rootDatum n F) (nodesOf (blkSet I p)) := by
    let P : Subgroup (StatedSp (coordsOf (blkSet I p)).card F) :=
      (leviM (rootDatum n F) (nodesOf (blkSet I p))).comap
        (spEmbed (K := F) (sigmaOf (blkSet I p)) (sigmaOf_strictMono _).injective)
    let H : Subgroup (TauCeti.GLSymplecticFin (coordsOf (blkSet I p)).card F) :=
      P.comap (equivStatedSp (coordsOf (blkSet I p)).card F).toMonoidHom
    have hH : H = ⊤ := by
      refine eq_top_of_root_subgroups H fun root c => ?_
      change spEmbed (sigmaOf (blkSet I p)) (sigmaOf_strictMono _).injective
        (equivStatedSp _ F (root.hom c)) ∈ leviM (rootDatum n F) (nodesOf (blkSet I p))
      have : equivStatedSp (coordsOf (blkSet I p)).card F (root.hom c) =
          elt root (Multiplicative.toAdd c) := rfl
      rw [this, spEmbed_elt (sigmaOf (blkSet I p)) (sigmaOf_strictMono _)]
      refine elt_mem_leviM _ ?_ _
      intro j h1 h2
      cases root with
      | positiveLong i =>
        simp only [mapIdx, rLo, rHi] at h1 h2
        exact mem_nodesOf_of_ge (mem_coordsOf.mp (sigmaOf_mem _ i)) hl h1
      | negativeLong i =>
        simp only [mapIdx, rLo, rHi] at h1 h2
        exact mem_nodesOf_of_ge (mem_coordsOf.mp (sigmaOf_mem _ i)) hl h1
      | difference i i' h =>
        simp only [mapIdx, rLo, rHi] at h1 h2
        exact mem_nodesOf_of_between (mem_coordsOf.mp (sigmaOf_mem _ i))
          (mem_coordsOf.mp (sigmaOf_mem _ i')) h1 h2
      | positiveSum i i' h =>
        simp only [mapIdx, rLo, rHi] at h1 h2
        exact mem_nodesOf_of_ge (mem_coordsOf.mp (sigmaOf_mem _ i)) hl h1
      | negativeSum i i' h =>
        simp only [mapIdx, rLo, rHi] at h1 h2
        exact mem_nodesOf_of_ge (mem_coordsOf.mp (sigmaOf_mem _ i)) hl h1
    intro g
    have h1 : (equivStatedSp (coordsOf (blkSet I p)).card F).symm g ∈ H := by rw [hH]; trivial
    simpa [H, P] using h1
  rintro _ ⟨g, rfl⟩
  exact hH g

theorem GE_eq {B : Finset (Fin (n + 1))} {p : Fin (n + 1)} (hB : B = blkSet I p)
    (hl : Fin.last n ∈ B) : GE F B = leviM (rootDatum n F) (nodesOf B) :=
  le_antisymm (GE_le hB hl) (iSup₂_le fun i hi => rankOne_le_GE hi)

@[expose] noncomputable def GE_equiv (B : Finset (Fin (n + 1))) :
    ↥(GE F B) ≃* StatedSp (coordsOf B).card F :=
  (MonoidHom.ofInjective (spEmbed_injective (K := F) (sigmaOf_strictMono B).injective)).symm

end Groups

