namespace CFSG.HardMathSupport.Solomon.Coordinator.LieComp

open CFSG.Open

@[expose] def SpFactorFacts : Prop :=
  ∀ (E : Type) [Field E] [Fintype E] (m : ℕ), 2 ≤ m → (m, Fintype.card E) ≠ (2, 2) →
    LieFactorData (ringChar E) ↥(StatedSp m E)

@[expose] def SpAltSixFacts : Prop :=
  ∀ (E : Type) [Field E] [Fintype E] (m : ℕ), 2 ≤ m → (m, Fintype.card E) ≠ (2, 2) →
    IsEmpty ((↥(StatedSp m E) ⧸ Subgroup.center ↥(StatedSp m E)) ≃* alternatingGroup (Fin 6))

@[expose] def SpFourTwoFacts : Prop :=
  ∀ (E : Type) [Field E] [Fintype E], Fintype.card E = 2 →
    LieFactorData 2 ↥(commutator ↥(StatedSp 2 E))

end CFSG.HardMathSupport.Solomon.Coordinator.LieComp
