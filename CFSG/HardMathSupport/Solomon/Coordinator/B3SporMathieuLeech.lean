theorem b3SporPair_mathieuLeech :
    ∀ p : ℕ, p.Prime → p ≠ 2 → ∀ name ∈ ({.M11, .M12, .M22, .M23, .M24, .J2, .HS, .McL, .Suz,
      .Co1, .Co2, .Co3} : Finset TauCeti.SporadicName), B3SporPair name p := by
  have hbr : SporadicBridges := CFSG.Sporadic.Bridge.nonempty_carrier_mulEquiv_group
  have hOut : SporadicOuterLeTwo :=
    CFSG.HardMathSupport.Timmesfeld.Proving.sporadicOuterLeTwo_holds
  intro p hp hp2 name hname
  by_cases h2 : p ^ 2 ∣ Nat.card (TauCeti.CFSGIndex.sporadic name).Group
  · simp only [Finset.mem_insert, Finset.mem_singleton] at hname
    rcases sporadicP2Table_holds name p hp hp2 h2 with h | h
    · refine b3SporPair_of_sporadicOPrimeHolds hp hp2 hbr hOut ?_
      unfold SporadicOnePair at h
      simp only [Finset.mem_insert, Finset.mem_singleton] at h
      rcases h with ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, rfl⟩
      · rcases hname with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          simp only [reduceCtorEq, false_or, or_false, or_self] at h
        · exact sporadicOnePairHolds_McL.1
        · exact sporadicOPrimeHolds_Suz_three
        · exact sporadicOPrimeHolds_Co1_three
        · exact sporadicOPrimeHolds_Co2_three
        · exact sporadicOPrimeHolds_Co3_three
      · rcases hname with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          simp only [reduceCtorEq, false_or, or_false, or_self] at h
        exact sporadicOPrimeHolds_Co1_five
      · rcases hname with h | h | h | h | h | h | h | h | h | h | h | h <;> cases h
    · unfold B3SporRestPair at h
      simp only [Finset.mem_insert, Finset.mem_singleton] at h
      rcases h with ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩ | ⟨rfl, h⟩
      · rcases hname with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          simp only [reduceCtorEq, false_or, or_false, or_self] at h
        · exact b3SporPair_M11_three hbr hOut
        · exact b3SporPair_M12_three hbr hOut
        · exact b3SporPair_M22_three hbr hOut
        · exact b3SporPair_M23_three hbr hOut
        · exact b3SporPair_M24_three hbr hOut
        · exact b3SporPair_J2_three hbr hOut
        · exact b3SporPair_HS_three hbr hOut
      · rcases hname with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          simp only [reduceCtorEq, false_or, or_false, or_self] at h
        · exact b3SporPair_J2_five hbr hOut
        · exact b3SporPair_HS_five hbr hOut
        · exact b3SporPair_McL_five hbr hOut
        · exact b3SporPair_Suz_five hbr hOut
        · exact b3SporPair_of_sporadicOPrimeHolds hp hp2 hbr hOut sporadicOPrimeHolds_Co2_five
        · exact b3SporPair_Co3_five hbr hOut
      · rcases hname with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          simp only [reduceCtorEq, false_or, or_false, or_self] at h
        exact b3SporPair_of_sporadicOPrimeHolds hp hp2 hbr hOut sporadicOPrimeHolds_Co1_seven
      · rcases hname with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
          simp only [reduceCtorEq, false_or, or_false, or_self] at h
      · rcases hname with h' | h' | h' | h' | h' | h' | h' | h' | h' | h' | h' | h' <;>
          rw [h'] at h <;> cases h
  · refine b3SporPair_of_card_exact hp hp2 hOut fun S _ _ he => ?_
    rw [Nat.card_congr he.some.toEquiv]
    exact h2

