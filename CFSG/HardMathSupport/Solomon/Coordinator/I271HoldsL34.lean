theorem i271h_isLThreeFour_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B)
    (h : IsLThreeFour A) : IsLThreeFour B := by
  obtain ⟨F, hF, hfin, hc, ⟨f⟩⟩ := h
  exact ⟨F, hF, hfin, hc, ⟨e.symm.trans f⟩⟩

theorem i271h_isSLThreeFour_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B)
    (h : IsSLThreeFour A) : IsSLThreeFour B := by
  obtain ⟨F, hF, hfin, hc, ⟨f⟩⟩ := h
  exact ⟨F, hF, hfin, hc, ⟨e.symm.trans f⟩⟩

