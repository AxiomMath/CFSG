variable {X : Type} [Group X] [Finite X]

theorem i271ChevQLThreeFour_holds :
    I271ChevQLThreeFour := by
  intro X _ _ hXK K B hH hNorm hL34
  obtain ⟨hBN, -⟩ := hNorm
  have hp : (3 : ℕ).Prime := Nat.prime_three
  have hBel : IsElemAbelian 3 B := hH.scp.2.1
  have hq : CFSG.Open.IsQuasisimple ↥K := i116e_isQuasisimple hH.core hH.comp
  have hOK : GLAPPrimeCore 3 ↥K = ⊥ := i271h_primeCore_eq_bot hH.core hH.comp
  have hOKof : GLAPPrimeCoreOf 3 K = ⊥ := i271h_primeCoreOf_eq_bot hH.core hH.comp
  have hcover : IsLThreeFour ↥K ∨ IsSLThreeFour ↥K := by
    refine Proving.inputL34Cover_holds ↥K hq ?_
    exact i271h_isLThreeFour_of_mulEquiv
      (QuotientGroup.quotientMulEquivOfEq (i271h_pCore_three_eq_center hq hOK).symm) hL34
  have hbar : IsLThreeFour (↥K ⧸ GLAPPrimeCore 3 ↥K) ∨
      IsSLThreeFour (↥K ⧸ GLAPPrimeCore 3 ↥K) := by
    let e : ↥K ≃* (↥K ⧸ GLAPPrimeCore 3 ↥K) :=
      (QuotientGroup.quotientBot (G := ↥K)).symm.trans (QuotientGroup.quotientMulEquivOfEq hOK.symm)
    exact hcover.imp (i271h_isLThreeFour_of_mulEquiv e) (i271h_isSLThreeFour_of_mulEquiv e)
  have h4 := hH.rank_four
  have hmain := input23_20_proved X ⊤ K B hH.comp hbar le_top hBel hBN
  rcases hmain with h | ⟨hinn, hrel⟩
  ·
    left
    refine ⟨h4, i271h_isInGOne_of_le hBN ?_⟩
    rw [hOKof, sup_bot_eq] at h
    refine h.trans ?_
    unfold gammaClBelow
    refine iSup₂_le fun E hE => ?_
    have hE3 : 3 ≤ CFSG.Open.pRank 3 E := by
      have := hE.2
      rw [i271h_pRank_coe, i271h_pRank_coe] at this
      omega
    refine sup_le ?_ ?_
    · exact i271h_le_coreIn_of_le_centralizer hE.1 hE3 (Subgroup.map_subtype_le _)
    · exact i271h_le_coreIn_of_le_centralizer hE.1 hE3 (sSup_le fun _ hL => hL.1)
  ·
    have hdQ := i271h_dQ_eq_centralizer hOKof
    have hAut9 : autOrderIn B K = 9 := by
      rw [i271h_autOrderIn_eq_relIndex hBN, ← hdQ]
      exact hrel
    have hInn : InducesInnerIn B K := by
      intro b hb
      obtain ⟨k, hk, hbk⟩ := hinn b hb.1
      refine ⟨k, hk, ?_⟩
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      have h1 := Subgroup.mem_bot.1 (hOKof ▸ hbk y hy)
      have h2 : b * y * b⁻¹ = k * y * k⁻¹ := by
        rw [mul_inv_eq_one] at h1
        exact h1
      calc y * (k⁻¹ * b) = k⁻¹ * (k * y * k⁻¹) * b := by group
        _ = k⁻¹ * (b * y * b⁻¹) * b := by rw [h2]
        _ = k⁻¹ * b * y := by group
    by_cases h5 : 5 ≤ CFSG.Open.pRank 3 B
    · left
      exact ⟨h4, isInGOne_of_autOrderIn_le (r := 2) hp hBel hBN (by rw [hAut9]; norm_num) h5⟩
    · right
      exact ⟨hL34, by omega, hAut9, hInn⟩

end Main

