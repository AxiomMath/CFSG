variable {G : Type} [Group G] [Finite G]

structure Hyp0 (R S : Subgroup G) : Prop where
  solv : Group.IsSolvable ↥R
  not3 : ¬ 3 ∣ Nat.card R
  oddcore : ∀ N : Subgroup G, N ≤ R → R ≤ Subgroup.normalizer (N : Set G) →
    ¬ 2 ∣ Nat.card N → N = ⊥
  le : S ≤ R
  two : IsPGroup 2 S
  syl : ¬ 2 ∣ S.relIndex R

theorem Hyp0.exists_O2 {R S : Subgroup G} (h : Hyp0 R S) :
    ∃ U : Subgroup G, U ≤ S ∧ IsPGroup 2 U ∧ R ≤ Subgroup.normalizer (U : Set G) ∧
      (∀ K : Subgroup G, K ≤ R → R ≤ Subgroup.normalizer (K : Set G) → IsPGroup 2 K → K ≤ U) ∧
      ∀ x ∈ R, (∀ u ∈ U, u * x = x * u) → x ∈ U := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have := h.solv
  have hS'2 : IsPGroup 2 (S.subgroupOf R) :=
    h.two.of_equiv (Subgroup.subgroupOfEquivOfLe h.le).symm
  have hS'idx : ¬ 2 ∣ (S.subgroupOf R).index := h.syl
  let T : Sylow 2 ↥R := hS'2.toSylow hS'idx
  have hcore : CFSG.pPrimeCore 2 ↥R = ⊥ := by
    refine eq_bot_iff.2 (sSup_le fun K hK => ?_)
    obtain ⟨hKn, hKc⟩ := hK
    have hodd : ¬ 2 ∣ Nat.card K := (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).1 hKc
    have hbot := h.oddcore (K.map R.subtype) (by rintro _ ⟨k, -, rfl⟩; exact k.2)
      (fun r hr => by
        have key : ∀ r : R, ∀ y ∈ K.map R.subtype, (r : G) * y * (r : G)⁻¹ ∈ K.map R.subtype := by
          rintro r _ ⟨k, hk, rfl⟩
          exact ⟨r * k * r⁻¹, hKn.conj_mem k hk r, by simp⟩
        exact mem_normalizer_of_conj_mem' (key ⟨_, hr⟩) (fun y hy => by
          simpa using key ⟨_, R.inv_mem hr⟩ y hy))
      (by rwa [Subgroup.card_map_of_injective R.subtype_injective])
    exact le_of_eq ((Subgroup.map_eq_bot_iff_of_injective K R.subtype_injective).1 hbot)
  have hchar : CFSG.IsCharacteristicP 2 ↥R :=
    CFSG.isCharacteristicP_of_pPrimeCore_eq_bot_of_layer_eq_bot ↥R 2 hcore
      layer_eq_bot_of_solvable'
  have hCP : Subgroup.centralizer (CFSG.pCore 2 ↥R : Set ↥R) ≤ CFSG.pCore 2 ↥R := hchar
  have hnorm : (CFSG.pCore 2 ↥R).Normal := CFSG.pCore_normal
  have hp2 : IsPGroup 2 (CFSG.pCore 2 ↥R) := CFSG.pCore_isPGroup
  refine ⟨(CFSG.pCore 2 ↥R).map R.subtype, ?_, hp2.map R.subtype, ?_, ?_, ?_⟩
  ·
    have hle : CFSG.pCore 2 ↥R ≤ (T : Subgroup ↥R) := hp2.le_sylow_of_normal T
    rintro _ ⟨x, hx, rfl⟩
    have := hle hx
    exact this
  · intro r hr
    have key : ∀ r : R, ∀ y ∈ (CFSG.pCore 2 ↥R).map R.subtype,
        (r : G) * y * (r : G)⁻¹ ∈ (CFSG.pCore 2 ↥R).map R.subtype := by
      rintro r _ ⟨k, hk, rfl⟩
      exact ⟨r * k * r⁻¹, hnorm.conj_mem k hk r, by simp⟩
    exact mem_normalizer_of_conj_mem' (key ⟨_, hr⟩) (fun y hy => by
      simpa using key ⟨_, R.inv_mem hr⟩ y hy)
  ·
    intro K hKR hKn hK2 x hxK
    have hKnorm : (K.subgroupOf R).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hKR).2 hKn
    have hK2' : IsPGroup 2 (K.subgroupOf R) :=
      hK2.of_equiv (Subgroup.subgroupOfEquivOfLe hKR).symm
    have hle : K.subgroupOf R ≤ CFSG.pCore 2 ↥R := le_sSup ⟨hKnorm, hK2'⟩
    have hmem : (⟨x, hKR hxK⟩ : ↥R) ∈ K.subgroupOf R := Subgroup.mem_subgroupOf.2 hxK
    exact ⟨⟨x, hKR hxK⟩, hle hmem, rfl⟩
  · intro x hx hc
    have hxc : (⟨x, hx⟩ : ↥R) ∈ Subgroup.centralizer (CFSG.pCore 2 ↥R : Set ↥R) := by
      intro k hk
      exact Subtype.ext (hc k ⟨k, hk, rfl⟩)
    exact ⟨⟨x, hx⟩, hCP hxc, rfl⟩

theorem Hyp0.mono {R S R' : Subgroup G} (h : Hyp0 R S) (hSR' : S ≤ R') (hR'R : R' ≤ R) :
    Hyp0 R' S := by
  obtain ⟨U, hUS, hU2, hUn, -, hUc⟩ := h.exists_O2
  refine ⟨?_, ?_, ?_, hSR', h.two, ?_⟩
  · have := h.solv
    exact Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hR'R)
      (Subgroup.inclusion_injective hR'R)
  · exact fun h3 => h.not3 (h3.trans (Subgroup.card_dvd_of_le hR'R))
  · intro N hNR' hR'N hodd
    rw [eq_bot_iff]
    intro x hx
    have hxR : x ∈ R := hR'R (hNR' hx)
    have hxU : x ∈ U := by
      refine hUc x hxR (fun u hu => ?_)
      have huR' : u ∈ R' := hSR' (hUS hu)
      have hc1 : x * u * x⁻¹ * u⁻¹ ∈ U := mul_mem
        ((Subgroup.mem_normalizer_iff.1 (hUn hxR) u).1 hu) (U.inv_mem hu)
      have hc2 : x * u * x⁻¹ * u⁻¹ ∈ N := by
        have := mul_mem hx ((Subgroup.mem_normalizer_iff.1 (hR'N huR') x⁻¹).1 (N.inv_mem hx))
        simpa [mul_assoc] using this
      have h1 := eq_one_of_mem_pgroup_odd hU2 hodd hc1 hc2
      calc u * x = (x * u * x⁻¹ * u⁻¹)⁻¹ * (x * u) := by group
        _ = x * u := by rw [h1]; simp
    exact Subgroup.mem_bot.2 (eq_one_of_mem_pgroup_odd hU2 hodd hxU hx)
  · have h1 := Subgroup.relIndex_mul_relIndex S R' R hSR' hR'R
    exact fun h2 => h.syl (h2.trans ⟨_, h1.symm⟩)

private theorem le_normalizer_sup {R A B : Subgroup G} (hA : R ≤ Subgroup.normalizer (A : Set G))
    (hB : R ≤ Subgroup.normalizer (B : Set G)) :
    R ≤ Subgroup.normalizer ((A ⊔ B : Subgroup G) : Set G) := by
  have key : ∀ g ∈ R, ∀ x ∈ A ⊔ B, g * x * g⁻¹ ∈ A ⊔ B := by
    intro g hg
    have h1 : A ⊔ B ≤ (A ⊔ B).comap (MulAut.conj g).toMonoidHom :=
      sup_le (fun x hx => Subgroup.mem_sup_left ((Subgroup.mem_normalizer_iff.1 (hA hg) x).1 hx))
        (fun x hx => Subgroup.mem_sup_right ((Subgroup.mem_normalizer_iff.1 (hB hg) x).1 hx))
    exact fun x hx => h1 hx
  intro g hg
  exact mem_normalizer_of_conj_mem' (key g hg)
    (fun x hx => by simpa using key g⁻¹ (inv_mem hg) x hx)

private theorem le_normalizer_inf {A X Y : Subgroup G} (hX : A ≤ Subgroup.normalizer (X : Set G))
    (hY : A ≤ Subgroup.normalizer (Y : Set G)) :
    A ≤ Subgroup.normalizer ((X ⊓ Y : Subgroup G) : Set G) := by
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro h
  rw [Subgroup.mem_inf, Subgroup.mem_inf]
  exact and_congr (Subgroup.mem_normalizer_iff.1 (hX hg) h)
    (Subgroup.mem_normalizer_iff.1 (hY hg) h)

private theorem inf_sup_eq_of_le {S L K : Subgroup G} (hKS : K ≤ S)
    (hKL : K ≤ Subgroup.normalizer (L : Set G)) : S ⊓ (L ⊔ K) = (S ⊓ L) ⊔ K := by
  apply le_antisymm
  · intro x hx
    obtain ⟨hxS, hxLK⟩ := Subgroup.mem_inf.1 hx
    have hx' : x ∈ ((L ⊔ K : Subgroup G) : Set G) := hxLK
    rw [Subgroup.coe_mul_of_right_le_normalizer_left L K hKL] at hx'
    obtain ⟨l, hl, k, hk, rfl⟩ := hx'
    have hlS : l ∈ S := by
      have := mul_mem hxS (inv_mem (hKS hk))
      simpa using this
    exact Subgroup.mul_mem_sup (Subgroup.mem_inf.2 ⟨hlS, hl⟩) hk
  · exact sup_le (inf_le_inf_left S le_sup_left) (le_inf hKS le_sup_right)

private theorem le_of_not_two_dvd_relIndex {A B : Subgroup G} (hB : IsPGroup 2 B)
    (h : ¬ 2 ∣ A.relIndex B) : B ≤ A := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).1 hB
  have hd := Subgroup.relIndex_dvd_card A B
  rw [hn] at hd
  obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hd
  have hj0 : j = 0 := by
    by_contra hj0
    exact h (hj ▸ dvd_pow_self 2 hj0)
  rw [hj0, pow_zero] at hj
  exact Subgroup.relIndex_eq_one.1 hj

private theorem relIndex_sup_right_of_le_normalizer {S M : Subgroup G}
    (hSM : S ≤ Subgroup.normalizer (M : Set G)) :
    M.relIndex (S ⊔ M) = (S ⊓ M).relIndex S := by
  have h1 := Subgroup.relIndex_mul_relIndex (S ⊓ M) S (S ⊔ M) inf_le_left le_sup_left
  have h2 := Subgroup.relIndex_mul_relIndex (S ⊓ M) M (S ⊔ M) inf_le_right le_sup_right
  rw [relIndex_sup_of_le_normalizer hSM] at h1
  have hpos : (S ⊓ M).relIndex M ≠ 0 := Subgroup.index_ne_zero_of_finite
  apply Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hpos)
  rw [h2, ← h1, mul_comm]

private theorem exists_chief_aux {X : Type} [Group X] [Finite X] [Group.IsSolvable X]
    {L : Subgroup X} [L.Normal] (hL : L ≠ ⊤) :
    ∃ M : Subgroup X, L < M ∧ M.Normal ∧ ∃ p : ℕ, p.Prime ∧ ∃ k : ℕ, L.relIndex M = p ^ k := by
  have hcard : Nat.card (X ⧸ L) ≠ 1 := by
    rw [← Subgroup.index_eq_card]
    exact fun h => hL (Subgroup.index_eq_one.1 h)
  have hfit : CFSG.fittingSubgroup (X ⧸ L) ≠ ⊥ :=
    fun h => hcard ((CFSG.fitting_eq_bot_iff_card_eq_one_of_solvable _).1 h)
  rw [CFSG.fitting_eq_sup_pCore] at hfit
  obtain ⟨q, hq⟩ : ∃ q : ↥((Nat.card (X ⧸ L)).primeFactors.attach),
      CFSG.pCore q.1.1 (X ⧸ L) ≠ ⊥ := by
    by_contra hall
    exact hfit (iSup_eq_bot.2 fun q => by_contra fun h => hall ⟨q, h⟩)
  have hqp : (q.1.1).Prime := Nat.prime_of_mem_primeFactors q.1.2
  haveI : Fact (q.1.1).Prime := ⟨hqp⟩
  set A := CFSG.pCore q.1.1 (X ⧸ L) with hA
  have hAn : A.Normal := CFSG.pCore_normal
  have hAp : IsPGroup (q.1.1) A := CFSG.pCore_isPGroup
  set M : Subgroup X := A.comap (QuotientGroup.mk' L) with hM
  have hsurj : Function.Surjective (QuotientGroup.mk' L) := QuotientGroup.mk'_surjective L
  have hLM : L ≤ M := by
    intro x hx
    show QuotientGroup.mk' L x ∈ A
    have : QuotientGroup.mk' L x = 1 := (QuotientGroup.eq_one_iff x).2 hx
    rw [this]; exact A.one_mem
  have hLM' : L ≠ M := by
    intro h
    apply hq
    rw [eq_bot_iff]
    intro a ha
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective a
    have hx : x ∈ M := ha
    rw [← h] at hx
    exact Subgroup.mem_bot.2 ((QuotientGroup.eq_one_iff x).2 hx)
  have hidxL : L.index = Nat.card (X ⧸ L) := Subgroup.index_eq_card L
  have hidxM : M.index = A.index := Subgroup.index_comap_of_surjective A hsurj
  have h1 : L.relIndex M * M.index = L.index := Subgroup.relIndex_mul_index hLM
  have h2 : Nat.card A * A.index = Nat.card (X ⧸ L) := Subgroup.card_mul_index A
  have hA0 : 0 < A.index := Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite
  have h3 : L.relIndex M = Nat.card A := by
    apply Nat.eq_of_mul_eq_mul_right hA0
    calc L.relIndex M * A.index = L.relIndex M * M.index := by rw [hidxM]
      _ = Nat.card A * A.index := by rw [h1, hidxL, h2]
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := q.1.1)).1 hAp
  exact ⟨M, lt_of_le_of_ne hLM hLM', hAn.comap _, q.1.1, hqp, k, h3.trans hk⟩

private theorem exists_chief {R L : Subgroup G} (hR : Group.IsSolvable ↥R) (hLR : L < R)
    (hLn : R ≤ Subgroup.normalizer (L : Set G)) :
    ∃ M : Subgroup G, L < M ∧ M ≤ R ∧ R ≤ Subgroup.normalizer (M : Set G) ∧
      ∃ p : ℕ, p.Prime ∧ ∃ k : ℕ, L.relIndex M = p ^ k := by
  haveI := hR
  haveI hLnormal : (L.subgroupOf R).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLR.le).2 hLn
  have hLtop : L.subgroupOf R ≠ ⊤ := by
    intro h
    obtain ⟨x, hxR, hxL⟩ := SetLike.exists_of_lt hLR
    apply hxL
    have : (⟨x, hxR⟩ : ↥R) ∈ L.subgroupOf R := h ▸ Subgroup.mem_top _
    exact this
  obtain ⟨M', hLM', hM'n, p, hp, k, hk⟩ := exists_chief_aux hLtop
  have hMR : M'.map R.subtype ≤ R := Subgroup.map_subtype_le M'
  have hMsub : (M'.map R.subtype).subgroupOf R = M' :=
    Subgroup.comap_map_eq_self_of_injective R.subtype_injective M'
  refine ⟨M'.map R.subtype, ?_, hMR, ?_, p, hp, k, ?_⟩
  · refine lt_of_le_of_ne ?_ ?_
    · rw [← Subgroup.map_subgroupOf_eq_of_le hLR.le]
      exact Subgroup.map_mono hLM'.le
    · intro h
      have := congrArg (fun K : Subgroup G => K.subgroupOf R) h
      simp only [hMsub] at this
      exact hLM'.ne this
  · have : ((M'.map R.subtype).subgroupOf R).Normal := by rw [hMsub]; exact hM'n
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer hMR).1 this
  · rw [← Subgroup.relIndex_subgroupOf (H := L) hMR, hMsub]
    exact hk

theorem fac_of_local0 {S T₁ T₂ : Subgroup G}
    (hT₁ : S ≤ Subgroup.normalizer (T₁ : Set G)) (hT₂ : S ≤ Subgroup.normalizer (T₂ : Set G))
    (hlocal : ∀ R L H : Subgroup G, Hyp0 R S → (∀ R' : Subgroup G, Hyp0 R' S → R' < R →
        Fac R' T₁ T₂) →
      L ≤ R → R ≤ Subgroup.normalizer (L : Set G) → H = S ⊓ L →
      R ≤ Subgroup.normalizer (H : Set G) →
      (∀ K : Subgroup G, K ≤ R → R ≤ Subgroup.normalizer (K : Set G) → IsPGroup 2 K → K ≤ H) →
      (∀ x ∈ R, (∀ h ∈ H, h * x = x * h) → x ∈ H) →
      ¬ 2 ∣ H.relIndex L → (L : Set G) * (S : Set G) = (R : Set G) → Fac R T₁ T₂) :
    ∀ R : Subgroup G, Hyp0 R S → Fac R T₁ T₂ := by
  intro R
  refine WellFoundedLT.induction (motive := fun R : Subgroup G => Hyp0 R S → Fac R T₁ T₂) R ?_
  intro R ih hR
  have ih' : ∀ R' : Subgroup G, Hyp0 R' S → R' < R → Fac R' T₁ T₂ :=
    fun R' h1 h2 => ih R' h2 h1
  obtain ⟨U, hUS, hU2, hUn, hUmax, hUcen⟩ := hR.exists_O2
  have hSR : S ≤ R := hR.le
  have hS2 : IsPGroup 2 S := hR.two
  have hSyl : ¬ 2 ∣ S.relIndex R := hR.syl
  let 𝓛 : Set (Subgroup G) := {K | K ≤ R ∧ R ≤ Subgroup.normalizer (K : Set G) ∧
    R ≤ Subgroup.normalizer ((S ⊓ K : Subgroup G) : Set G)}
  have hbot : (⊥ : Subgroup G) ∈ 𝓛 := by
    refine ⟨bot_le, ?_, ?_⟩
    · rw [Subgroup.normalizer_eq_top]; exact le_top
    · rw [inf_bot_eq, Subgroup.normalizer_eq_top]; exact le_top
  obtain ⟨L, hL, hmax⟩ := (Set.toFinite 𝓛).exists_maximal ⟨⊥, hbot⟩
  obtain ⟨hLR, hLn, hSLn⟩ := hL
  by_cases hLS : (L : Set G) * (S : Set G) = (R : Set G)
  · have hK : ∀ K : Subgroup G, K ≤ R → R ≤ Subgroup.normalizer (K : Set G) → IsPGroup 2 K →
        K ≤ S ⊓ L := by
      intro K hKR hKn hK2
      have hKS : K ≤ S := (hUmax K hKR hKn hK2).trans hUS
      have hmem : L ⊔ K ∈ 𝓛 := by
        refine ⟨sup_le hLR hKR, le_normalizer_sup hLn hKn, ?_⟩
        rw [inf_sup_eq_of_le hKS (hKR.trans hLn)]
        exact le_normalizer_sup hSLn hKn
      have := hmax hmem le_sup_left
      exact le_inf hKS (le_sup_right.trans this)
    have hUeq : S ⊓ L = U := by
      apply le_antisymm
      · exact hUmax _ (inf_le_left.trans hSR) hSLn (hS2.to_le inf_le_left)
      · exact hK U (hUS.trans hSR) hUn hU2
    refine hlocal R L (S ⊓ L) hR ih' hLR hLn rfl hSLn hK ?_
      (not_two_dvd_relIndex_inf hSR hS2 hSyl hLR hLn) hLS
    intro x hx hc
    rw [hUeq] at hc ⊢
    exact hUcen x hx hc
  · have hLlt : L < R := by
      refine lt_of_le_of_ne hLR fun h => hLS ?_
      rw [h]
      apply Set.Subset.antisymm
      · rintro _ ⟨x, hx, y, hy, rfl⟩
        exact R.mul_mem hx (hSR hy)
      · intro x hx
        exact ⟨x, hx, 1, S.one_mem, mul_one x⟩
    obtain ⟨M, hLM, hMR, hMn, p, hp, k, hk⟩ := exists_chief hR.solv hLlt hLn
    have hSM : S ≤ Subgroup.normalizer (M : Set G) := hSR.trans hMn
    by_cases hp2 : p = 2
    · subst hp2
      by_cases hMS : R ≤ Subgroup.normalizer ((S ⊓ M : Subgroup G) : Set G)
      · exact absurd hLM (not_lt_of_ge (hmax (⟨hMR, hMn, hMS⟩ : M ∈ 𝓛) hLM.le))
      · set N₁ : Subgroup G := Subgroup.normalizer ((S ⊓ M : Subgroup G) : Set G) ⊓ R
        have hN₁R : N₁ ≤ R := inf_le_right
        have hN₁lt : N₁ < R :=
          lt_of_le_of_ne hN₁R fun h => hMS (by rw [← h]; exact inf_le_left)
        have hSN₁ : S ≤ N₁ :=
          le_inf (le_normalizer_inf Subgroup.le_normalizer hSM) hSR
        have hFacN₁ : Fac N₁ T₁ T₂ := ih' N₁ (hR.mono hSN₁ hN₁R) hN₁lt
        by_cases hMSR : M ⊔ S < R
        · have hFacMS : Fac (M ⊔ S) T₁ T₂ :=
            ih' (M ⊔ S) (hR.mono le_sup_right hMSR.le) hMSR
          exact fac_of_normal hSR hS2 hSyl hT₁ hT₂ hMR hMn hFacN₁ hFacMS
        · exfalso
          have hMSeq : M ⊔ S = R := eq_of_le_of_not_lt (sup_le hMR hSR) hMSR
          apply hLS
          have hRM : M.relIndex R = (S ⊓ M).relIndex S := by
            rw [← hMSeq, sup_comm, relIndex_sup_right_of_le_normalizer hSM]
          obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).1 hS2
          have h1 : M.relIndex R ∣ 2 ^ n := by
            rw [hRM, ← hn]; exact Subgroup.relIndex_dvd_card _ _
          have h2 : L.relIndex M * M.relIndex R = L.relIndex R :=
            Subgroup.relIndex_mul_relIndex L M R hLM.le hMR
          have h3 : L.relIndex R ∣ 2 ^ (k + n) := by
            rw [← h2, hk, pow_add]; exact mul_dvd_mul_left _ h1
          have h4 : (L ⊔ S).relIndex R ∣ 2 ^ (k + n) :=
            (Subgroup.relIndex_dvd_of_le_left R le_sup_left).trans h3
          have h5 : (L ⊔ S).relIndex R ∣ S.relIndex R :=
            Subgroup.relIndex_dvd_of_le_left R le_sup_right
          have hodd : ¬ 2 ∣ (L ⊔ S).relIndex R := fun h => hSyl (h.trans h5)
          have hcop : Nat.Coprime ((L ⊔ S).relIndex R) (2 ^ (k + n)) :=
            Nat.Coprime.pow_right _
              (((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 hodd).symm)
          have h6 : (L ⊔ S).relIndex R = 1 := hcop.eq_one_of_dvd h4
          have h7 : R ≤ L ⊔ S := Subgroup.relIndex_eq_one.1 h6
          rw [← Subgroup.coe_mul_of_right_le_normalizer_left L S (hSR.trans hLn),
            le_antisymm (sup_le hLR hSR) h7]
    · exfalso
      have hodd : ¬ 2 ∣ L.relIndex M := by
        rw [hk]
        intro h
        exact hp2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).1
          (Nat.prime_two.dvd_of_dvd_pow h)).symm
      have hLP : S ⊓ L ≤ S ⊓ M := inf_le_inf_left S hLM.le
      have hP : S ⊓ M = S ⊓ L := by
        refine le_antisymm ?_ hLP
        apply le_of_not_two_dvd_relIndex (hS2.to_le inf_le_left)
        have h1 : (S ⊓ L).relIndex L * L.relIndex M = (S ⊓ L).relIndex M :=
          Subgroup.relIndex_mul_relIndex _ _ _ inf_le_right hLM.le
        have h2 : (S ⊓ L).relIndex (S ⊓ M) * (S ⊓ M).relIndex M = (S ⊓ L).relIndex M :=
          Subgroup.relIndex_mul_relIndex _ _ _ hLP inf_le_right
        intro hd
        have h3 : 2 ∣ (S ⊓ L).relIndex M := h2 ▸ Dvd.dvd.mul_right hd _
        rw [← h1] at h3
        rcases (Nat.Prime.dvd_mul Nat.prime_two).1 h3 with h | h
        · exact not_two_dvd_relIndex_inf hSR hS2 hSyl hLR hLn h
        · exact hodd h
      have hmem : M ∈ 𝓛 := ⟨hMR, hMn, by rw [hP]; exact hSLn⟩
      exact absurd hLM (not_lt_of_ge (hmax hmem hLM.le))

theorem fac_zero_one0 {R S : Subgroup G} (h : Hyp0 R S) :
    Fac R (jOf S) (omegaOneZ (jOneOf S)) := by
  refine fac_of_local0 (le_normalizer_jOf S) (le_normalizer_omegaOneZ_jOneOf S) ?_ R h
  intro R L H hR _ hLR hLn hH hHn hHmax hHc hLodd hRLS
  have hZ := omegaOneZ_jOneOf_le_of_local hR.solv hR.le hR.two hLR hLn hH hHn hHmax hHc hLodd
    hRLS
  exact fac_zero_one_of_local hR.not3 hR.le hR.two hLR hLn hH hHn hLodd hRLS hZ

