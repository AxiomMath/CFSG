theorem lThreeFourComponentFacts_of_residuals
    (hB : SporL3DownInner .B) (hM : SporL3DownInner .M)
    (hA2 : LieComp.TrialityOddA2Comps) (hD43 : LieComp.D4Char3Outer)
    (hE3 : LieComp.ExcChar3Export) (hOuter : LieComp.ExcRationalLieTypesOuter)
    (hF2 : LieComp.ExcRationalLieTypesF4Two) :
    CFSG.Yardstones.M67c2c3e09a6b.LThreeFourComponentFacts := by
  have hbr : CFSG.HardMathSupport.Timmesfeld.Tables.Census.SporadicBridges :=
    CFSG.Sporadic.Bridge.nonempty_carrier_mulEquiv_group
  have hOut : CFSG.HardMathSupport.Timmesfeld.Coordinator.SporadicOuterLeTwo :=
    CFSG.HardMathSupport.Timmesfeld.Proving.sporadicOuterLeTwo_holds
  have hInner : ∀ s : TauCeti.SporadicName, SporL3DownInner s := by
    intro s
    cases s with
    | M11 => exact sporL3DownInner_M11 hbr
    | M12 => exact sporL3DownInner_M12 hbr
    | M22 => exact sporL3DownInner_M22 hbr
    | M23 => exact sporL3DownInner_M23 hbr
    | M24 => exact sporL3DownInner_M24 hbr
    | J1 => exact sporL3DownInner_J1 hbr
    | J2 => exact sporL3DownInner_J2 hbr
    | J3 => exact sporL3DownInner_J3 hbr
    | J4 => exact sporL3DownInner_J4 hbr
    | HS => exact sporL3DownInner_HS hbr
    | McL => exact sporL3DownInner_McL hbr
    | He => exact sporL3DownInner_He hbr
    | Ru => exact sporL3DownInner_Ru hbr
    | Suz => exact sporL3DownInner_Suz hbr
    | ONan => exact sporL3DownInner_ONan hbr
    | Co1 => exact sporL3DownInner_Co1 hbr
    | Co2 => exact sporL3DownInner_Co2 hbr
    | Co3 => exact sporL3DownInner_Co3 hbr
    | Fi22 => exact sporL3DownInner_Fi22 hbr
    | Fi23 => exact sporL3DownInner_Fi23 hbr
    | Fi24Prime => exact sporL3DownInner_Fi24 hbr
    | HN => exact sporL3DownInner_HN hbr
    | Ly => exact sporL3DownInner_Ly hbr
    | Th => exact CFSG.HardMathSupport.Dickson.Sec6.th_sporL3DownInner hbr
    | B => exact hB
    | M => exact hM
  have hSpor : ∀ s : TauCeti.SporadicName, SporL3Down s :=
    fun s => sporL3Down_of_inner hOut (hInner s)
  have hLieComp : LieComp.LieComp :=
    LieComp.lieComp_of_classical lieOrderBridge_holds LieQ.lieQConstrainedInner_three_holds
        (LieComp.d4OuterExport_of hA2 hD43)
        (LieComp.lieCompOn_exceptional (LieComp.excRationalLieTypes_of_residuals hOuter hF2)
            (LieComp.trialityOuterExport_of hA2) hE3)
        (LieComp.lieCompOn_suzukiReeTits
            (LieComp.reeG2Char3Export_of_lieQ lieOrderBridge_holds
                LieQ.lieQConstrainedInner_three_holds))
  have hLie : LieL3Down :=
    CFSG.HardMathSupport.Solomon.LocalBalance.Lemma27Ns.I1433.lieL3Down_of_lieComp hLieComp
      L3Char.l3CharUnique_holds
  have hodd : ∀ q : ℕ, q.Prime → 5 ≤ q → LieQ.LieQConstrainedInner q :=
    fun q hq h5 => LieQ.lieQConstrainedInner_odd hq (by omega)
  exact LieQ.lThreeFourComponentFacts_of_lieQ hSpor hLie LieQ.lieQConstrained_two_holds hodd

end CFSG.HardMathSupport.Solomon.Coordinator.YS08
