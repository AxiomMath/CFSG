theorem exists_sub49 {x : CFSG.Sporadic.Fi24.J} (h49 : 7 ^ 2 ∣ Nat.card ↥(Subgroup.centralizer ({x} : Set CFSG.Sporadic.Fi24.J))) :
    ∃ Q : Subgroup CFSG.Sporadic.Fi24.J, Nat.card Q = 7 ^ 2 ∧ (∀ g ∈ Q, g * x = x * g) ∧
      ∀ g ∈ Q, g ≠ 1 → orderOf g = 7 := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  haveI : Finite J := Nat.finite_of_card_ne_zero (by rw [CFSG.Sporadic.Fi24.card_J]; norm_num)
  obtain ⟨K, hK⟩ := Sylow.exists_subgroup_card_pow_prime
    (G := ↥(Subgroup.centralizer ({x} : Set J))) 7 h49
  refine ⟨K.map (Subgroup.centralizer ({x} : Set J)).subtype, ?_, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective _)]
    exact hK
  · rintro g ⟨k, -, rfl⟩
    show (k : J) * x = x * (k : J)
    exact (Subgroup.mem_centralizer_singleton_iff (g := x) (k := (k : J))).1 k.2
  · rintro g ⟨k, hk, rfl⟩ hg1
    have h1 : orderOf k ∣ 7 ^ 2 := by
      rw [← hK]
      exact Subgroup.orderOf_dvd_natCard K hk
    have h2 : orderOf ((Subgroup.centralizer ({x} : Set J)).subtype k) ∣ 7 ^ 2 := by
      have : (Subgroup.centralizer ({x} : Set J)).subtype k = (k : J) := rfl
      rw [this, Subgroup.orderOf_coe]
      exact h1
    have h3 : (k : J) ^ 49 = 1 := by
      have := orderOf_dvd_iff_pow_eq_one.1 (show orderOf (k : J) ∣ 49 by simpa using h2)
      exact this
    have h4 := Fi24Cent.pow_seven_eq_one h3
    exact orderOf_eq_prime h4 hg1

end Sub49

