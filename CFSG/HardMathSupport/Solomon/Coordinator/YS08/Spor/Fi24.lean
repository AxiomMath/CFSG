theorem noL3Comp_J (x : CFSG.Sporadic.Fi24.J) (hx : orderOf x = 3) :
    NoL3Comp (Subgroup.centralizer ({x} : Set CFSG.Sporadic.Fi24.J)) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨s, hs, c0, c1, c2, c3, c4, hp⟩ := Certificates.certificate214036
  let t : Fin 5 → J := fun k => ⟨s k, mem_J_of_seed (hs k).1⟩
  have hn : ∀ k, (fixS (t k) : Finset (Fin 306936)).card = cnt3 k := by
    intro k
    rw [card_fixS_eq_ptFix]
    fin_cases k
    · exact c0
    · exact c1
    · exact c2
    · exact c3
    · exact c4
  have ho : ∀ k, orderOf (t k) = 3 := fun k =>
    orderOf_eq_prime (Subtype.ext (hs k).2.1) (fun h => (hs k).2.2 (congrArg Subtype.val h))
  have hσ : ∀ k, ∃ i : Fin 5, IsConj (t k) (fi24Rep3 i) := fun k =>
    Fi24Sylow.fi24ThreeClasses_holds (t k) (ho k)
  choose σ hσ using hσ
  have hinj : Function.Injective σ := by
    intro k k' h
    have e : IsConj (t k) (t k') := (hσ k).trans (h ▸ (hσ k').symm)
    have := card_fixS_of_isConj e
    rw [hn k, hn k'] at this
    revert this
    fin_cases k <;> fin_cases k' <;> simp [cnt3]
  obtain ⟨i, hi⟩ := Fi24Sylow.fi24ThreeClasses_holds x hx
  obtain ⟨k, hk⟩ := (Finite.injective_iff_surjective.1 hinj) i
  have hxk : IsConj x (t k) := hi.trans (hk ▸ (hσ k).symm)
  have hpair : ∀ k : Fin 5, k = 0 ∨ k = 2 ∨ k = 4 → ∃ a b : J, a * t k = t k * a ∧ b * t k = t k * b ∧
      orderOf a = 7 ∧ orderOf b = 7 ∧ 81 ∣ Nat.card ↥(Subgroup.closure ({a, b} : Set J)) :=
    fun k hk => pair_J _ (hp k hk)
  have hc := hn k
  fin_cases k
  · exact noL3Comp_of_conj_fix21 hx hxk (Or.inl hc) (hpair 0 (Or.inl rfl))
  · exact noL3Comp_of_conj_fix_other hx hxk (Or.inl hc)
