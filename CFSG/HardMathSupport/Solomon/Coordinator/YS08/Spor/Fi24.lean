section Counting

theorem card_fixedBy_eq {G Ω : Type*} [Group G] [MulAction G Ω] [Fintype Ω] [DecidableEq Ω] (g : G) :
    Nat.card (MulAction.fixedBy Ω g) = (fixS g : Finset Ω).card := by
  have h : (MulAction.fixedBy Ω g : Set Ω) = ↑(fixS g : Finset Ω) := by
    ext x
    simp [MulAction.mem_fixedBy, mem_fixS]
  rw [h, Nat.card_coe_set_eq, Set.ncard_coe_finset]

theorem card_dvd_sum_fixed {G X : Type*} [Group G] [Fintype G] [MulAction G X] [Finite X] :
    Fintype.card G ∣ ∑ g : G, Nat.card (MulAction.fixedBy X g) := by
  classical
  haveI := Fintype.ofFinite X
  haveI : Fintype (MulAction.orbitRel.Quotient G X) := Fintype.ofFinite _
  have h := MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group G X
  simp only [Nat.card_eq_fintype_card]
  rw [h]
  exact Dvd.intro_left _ rfl

theorem sum_fixed_eq {G X : Type*} [Group G] [Fintype G] [MulAction G X] [Finite X] (c : ℕ)
    (hc : ∀ g : G, g ≠ 1 → Nat.card (MulAction.fixedBy X g) = c) :
    ∑ g : G, Nat.card (MulAction.fixedBy X g) = Nat.card X + (Fintype.card G - 1) * c := by
  classical
  rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (1 : G))]
  rw [MulAction.fixedBy_one_eq_univ, Nat.card_univ]
  congr 1
  rw [Finset.sum_congr rfl (fun g hg => hc g (Finset.ne_of_mem_erase hg)), Finset.sum_const,
    Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, smul_eq_mul]

end Counting

