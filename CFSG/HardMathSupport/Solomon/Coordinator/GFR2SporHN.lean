private theorem subgroupOf_commutator_self {G : Type*} [Group G] (C : Subgroup G) :
    ⁅C, C⁆.subgroupOf C = commutator C := by
  rw [← Subgroup.map_subtype_commutator C, Subgroup.subgroupOf,
    Subgroup.comap_map_eq_self_of_injective C.subtype_injective]

private theorem commutator_self_le {G : Type*} [Group G] (C : Subgroup G) : ⁅C, C⁆ ≤ C := by
  rw [Subgroup.commutator_le]
  intro a ha b hb
  rw [commutatorElement_def]
  exact C.mul_mem (C.mul_mem (C.mul_mem ha hb) (C.inv_mem ha)) (C.inv_mem hb)

private theorem le_commutator_of_perfect {G : Type*} [Group G] {C H : Subgroup G} (hH : H ≤ C)
    (hperf : commutator ↥H = ⊤) : H ≤ ⁅C, C⁆ := by
  have h1 : ⁅H, H⁆ = H := by
    rw [← Subgroup.map_subtype_commutator H, hperf, Subgroup.map_top, Subgroup.range_subtype]
  calc H = ⁅H, H⁆ := h1.symm
    _ ≤ ⁅C, C⁆ := Subgroup.commutator_mono hH hH

private theorem false_of_isHatSix_of_derived_simple {G : Type*} [Group G] [Finite G]
    {C K : Subgroup G} (hK : IsComponentOf K C) (h : IsHatSix ↥K)
    (hs : IsSimpleGroup ↥⁅C, C⁆) (hcard : Nat.card ↥⁅C, C⁆ ≠ 1080) : False := by
  have hN : (⁅C, C⁆.subgroupOf C).Normal := by
    rw [subgroupOf_commutator_self]; infer_instance
  have hKN : K = ⁅C, C⁆ := component_eq_of_normal_simple hK (commutator_self_le C) hN hs
    (fun H hH hperf => le_commutator_of_perfect hH hperf)
  apply hcard
  rw [← hKN]
  exact card_of_isHatSix h

private theorem false_of_isHatSix_of_card_29160 {G : Type*} [Group G] [Finite G]
    {C K : Subgroup G} (hK : IsComponentOf K C) (h : IsHatSix ↥K) (hC : Nat.card C = 29160)
    {g : G} (hg : g ∈ C) (hord : orderOf g = 10) : False := by
  have hKC : K ≤ C := hK.1
  have hK1080 : Nat.card K = 1080 := card_of_isHatSix h
  have hrel : K.relIndex C = 27 := by
    have h1 : Nat.card (K.subgroupOf C) = 1080 := by
      rw [← hK1080]; exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKC).toEquiv
    have h2 := Subgroup.card_mul_index (K.subgroupOf C)
    rw [h1, hC] at h2
    unfold Subgroup.relIndex
    omega
  exact false_of_isHatSix_of_elem hK h hg (by rw [hord, hrel]; norm_num)
    (by rw [hord]; norm_num) (by rw [hord]; norm_num)

private theorem map_centralizer_singleton_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (x : G) : (Subgroup.centralizer ({x} : Set G)).map e.toMonoidHom =
      Subgroup.centralizer ({e x} : Set H) := by
  ext y
  simp only [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff, MulEquiv.coe_toMonoidHom]
  constructor
  · rintro ⟨z, hz, rfl⟩
    rw [← map_mul, ← map_mul, hz]
  · intro hy
    refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
    apply e.injective
    rw [map_mul, map_mul, e.apply_symm_apply]
    exact hy

private theorem no_hatSix_of_derived {G S : Type*} [Group G] [Group S] [Finite S] (ψ : G ≃* S)
    {x : G} {s : S} (hψ : ψ x = s) {K : Subgroup S}
    (hK : IsComponentOf K (Subgroup.centralizer ({s} : Set S))) (h : IsHatSix ↥K)
    (hs : IsSimpleGroup ↥⁅Subgroup.centralizer ({x} : Set G), Subgroup.centralizer ({x} : Set G)⁆)
    (hcard : Nat.card ↥⁅Subgroup.centralizer ({x} : Set G), Subgroup.centralizer ({x} : Set G)⁆ ≠
      1080) : False := by
  have hC : Subgroup.centralizer ({s} : Set S) =
      (Subgroup.centralizer ({x} : Set G)).map ψ.toMonoidHom := by
    rw [← hψ, map_centralizer_singleton_mulEquiv]
  have hcomm : ⁅Subgroup.centralizer ({s} : Set S), Subgroup.centralizer ({s} : Set S)⁆ =
      (⁅Subgroup.centralizer ({x} : Set G), Subgroup.centralizer ({x} : Set G)⁆).map
        ψ.toMonoidHom := by
    rw [hC, ← Subgroup.map_commutator]
  refine false_of_isHatSix_of_derived_simple hK h ?_ ?_
  · rw [hcomm]
    exact MulEquiv.isSimpleGroup (Subgroup.equivMapOfInjective _ ψ.toMonoidHom ψ.injective).symm
  · rw [hcomm, Subgroup.card_map_of_injective ψ.injective]
    exact hcard

private theorem no_hatSix_of_order_ten {G S : Type*} [Group G] [Group S] [Finite S] (ψ : G ≃* S)
    {x : G} {s : S} (hψ : ψ x = s) {K : Subgroup S}
    (hK : IsComponentOf K (Subgroup.centralizer ({s} : Set S))) (h : IsHatSix ↥K)
    (hC : Nat.card (Subgroup.centralizer ({x} : Set G)) = 29160) {w : G}
    (hw : w ∈ Subgroup.centralizer ({x} : Set G)) (hord : orderOf w = 10) : False := by
  have hCs : Subgroup.centralizer ({s} : Set S) =
      (Subgroup.centralizer ({x} : Set G)).map ψ.toMonoidHom := by
    rw [← hψ, map_centralizer_singleton_mulEquiv]
  refine false_of_isHatSix_of_card_29160 hK h ?_ (g := ψ w) ?_ ?_
  · rw [hCs, Subgroup.card_map_of_injective ψ.injective, hC]
  · rw [hCs]
    exact Subgroup.mem_map_of_mem _ hw
  · rw [MulEquiv.orderOf_eq]
    exact hord

theorem orderOf_g3J_pow_three :
    orderOf (g3J ^ 3) = 10 := by
  have h := Certificates.certificate36905
  unfold HN3.g3OrderChecks HN3.g3Mat at h
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  rw [← mRegs_eq, ← mH_eq, ← mHi_eq] at h
  obtain ⟨⟨⟨⟨hroot, hlet⟩, h10⟩, h5⟩, h2⟩ := h
  have hrootL : ∀ l ∈ FAData.g3Root, l = 1 ∨ l = 2 := by
    intro l hl
    simpa using List.all_eq_true.1 hroot l hl
  have hg : toMat 5 133 (mulM 5 133 (wordM (seedSel rowsA rowsB) FAData.g3Root)
      (mword mH mHi FAData.g3H)) = matJ g3J := by
    rw [toMat_mulM, toMat_wordM_seed _ hrootL, toMat_mword_hWord _ (letters_of_plettersOK hlet),
      ← matJ_seedWordJ, ← matJ_mul]
    rfl
  have e10 := congrArg (toMat 5 133) h10
  have n5 := toMat_ne_one_of_notIdM h5
  have n2 := toMat_ne_one_of_notIdM h2
  simp only [toMat_powM, toMat_idM, hg] at e10 n5 n2
  have hpow : ∀ k : ℕ, matJ ((g3J ^ 3) ^ k) = (matJ g3J ^ 3) ^ k := fun k => by
    rw [matJ_pow, matJ_pow]
  have hP10 : (g3J ^ 3) ^ 10 = 1 := matJ_injective (by rw [hpow, matJ_one]; exact e10)
  have hP5 : (g3J ^ 3) ^ 5 ≠ 1 := fun h => n5 (by rw [← hpow, h, matJ_one])
  have hP2 : (g3J ^ 3) ^ 2 ≠ 1 := fun h => n2 (by rw [← hpow, h, matJ_one])
  refine orderOf_eq_of_pow_and_pow_div_prime (by norm_num) hP10 fun p hp hpd => ?_
  have hpd' : p ∣ 2 * 5 := hpd
  rcases (Nat.Prime.dvd_mul hp).1 hpd' with h | h
  · rw [(Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 h]
    exact hP5
  · rw [(Nat.prime_dvd_prime_iff_eq hp (by norm_num)).1 h]
    exact hP2

theorem exists_order_ten_CJ_s3 :
    ∃ w ∈ CJ (sJ 2), orderOf w = 10 :=
  ⟨g3J ^ 3, pow_mem g3J_mem_CJ 3, orderOf_g3J_pow_three⟩

set_option maxRecDepth 20000 in
theorem hn_no_hatSix
    {S : Type*} [Group S] [Finite S] (e : S ≃* JH) {s : S} (hs : orderOf s = 3) {K : Subgroup S}
    (hK : IsComponentOf K (Subgroup.centralizer ({s} : Set S))) (h : IsHatSix ↥K) : False := by
  have hs' : orderOf (e s) = 3 := by rw [MulEquiv.orderOf_eq]; exact hs
  rcases (order_three_classes (e s)).1 hs' with hc | hc
  · obtain ⟨c, hc⟩ := isConj_iff.1 hc
    obtain ⟨ψ, hψ⟩ : ∃ ψ : JH ≃* S, ψ (sJ 0) = s :=
      ⟨(MulAut.conj c).trans e.symm, by
        rw [MulEquiv.trans_apply, MulAut.conj_apply, hc, MulEquiv.symm_apply_apply]⟩
    have hL : IsSimpleGroup ↥L1J := by
      have := alt3_simple
      exact MulEquiv.isSimpleGroup (alt3.equivMapOfInjective iotaA iotaA_injective).symm
    have hcardL : Nat.card ↥(L1J) = 181440 := by
      rw [show (L1J : Subgroup JH) = alt3.map iotaA from rfl,
        Subgroup.card_map_of_injective iotaA_injective, card_alt3]
    refine @no_hatSix_of_derived ↥JH S inferInstance _ _ ψ (sJ 0) s hψ K hK h ?_ ?_
    · rw [commutator_CJ_s1]
      exact hL
    · rw [commutator_CJ_s1, hcardL]
      norm_num
  · obtain ⟨c, hc⟩ := isConj_iff.1 hc
    obtain ⟨ψ, hψ⟩ : ∃ ψ : JH ≃* S, ψ (sJ 2) = s :=
      ⟨(MulAut.conj c).trans e.symm, by
        rw [MulEquiv.trans_apply, MulAut.conj_apply, hc, MulEquiv.symm_apply_apply]⟩
    obtain ⟨w, hw, hw10⟩ := exists_order_ten_CJ_s3
    exact @no_hatSix_of_order_ten ↥JH S inferInstance _ _ ψ (sJ 2) s hψ K hK h card_CJ_s3 w hw hw10

theorem sporNoPumpup_HN
    (hSpM : SporadicMultipliers) (hOG : UniquenessMaximal.InputONGroup)
    (hOut : SporadicOuterLeTwo) (hbr : SporadicBridges) : SporNoPumpup .HN := by
  have e0 : (TauCeti.CFSGIndex.sporadic .HN).Group ≃* NativeSporadic.HN := (hbr .HN).some.symm
  have hsimple : IsSimpleGroup (TauCeti.CFSGIndex.sporadic .HN).Group :=
    @MulEquiv.isSimpleGroup _ _ _ _ fam_hn_certified_simplicity.2 e0
  haveI : Finite (TauCeti.CFSGIndex.sporadic .HN).Group := Finite.of_equiv _ e0.symm.toEquiv
  refine sporNoPumpup_of_components hSpM hOG hOut ?_ ?_ ?_ ?_
  · rw [Nat.card_congr e0.toEquiv, card_HN]
    norm_num [sporOrd, orderHN]
  · exact sporadicOPrimeHolds_HN_three _ ⟨e0⟩
  · intro s hs K hK h
    rcases h with h | ⟨h, -⟩
    · exact hn_no_hatSix (e0.trans hnEquivJ) hs hK h
    · exact absurd h (by decide)
  · intro h
    exact absurd h (by decide)

