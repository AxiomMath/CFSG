@[expose] def i242DGens : Array (Array ℕ) :=
  Array.ofFn (n := 12) fun j => (fi22FiveDGenArrs (j.val / 2))[j.val % 2]!

@[expose] def i242YArr (r : ℕ) : Array ℕ :=
  wordA 3510 i242DGens (rawInvs 3510 i242DGens) (i242Words.getD r [])

@[expose] def i242YArrs : Array (Array ℕ) := (List.range 8).toArray.map i242YArr

@[expose] def i242S : Array (Array ℕ) := pushWords 3510 i242YArrs omegaWords

@[expose] def i242Base : List (Fin 3510) :=
  [0, 2, 1, 4, 24, 8, 9].map fun v => ⟨i242Sigma.getD v 0 % 3510, Nat.mod_lt _ (by norm_num)⟩

@[expose] def i242SigmaInv : Array ℕ :=
  Array.ofFn (n := 3510) fun p =>
    match (List.range 120).find? fun v => i242Sigma.getD v 0 == p.val with
    | some v => v
    | none => 120

@[expose] def i242ChainCheck : Bool :=
  rawChainOK 3510 (i242S.extract 0 8) i242S (i242Base.map Fin.val).toArray
      (wordsOf 8 omegaWords) 4 &&
    rawOrbitSizes 3510 i242S (i242Base.map Fin.val).toArray == [120, 63, 30, 12, 8, 4, 2]

@[expose] def i242ActionCheck : Bool :=
  let sinv := i242SigmaInv
  let ys := i242YArrs
  i242Words.length == 8 && i242Words.all (lettersOK 12) && i242Sigma.length == 120 &&
    ys.size == 8 && sinv.size == 3510 &&
    (List.range 120).all (fun v => decide (i242Sigma.getD v 0 < 3510) &&
      sinv[i242Sigma.getD v 0]! == v) &&
    (List.range 3510).all (fun p => decide (sinv[p]! ≤ 120) &&
      (decide (120 ≤ sinv[p]!) || i242Sigma.getD sinv[p]! 0 == p)) &&
    (List.range 8).all fun r =>
      (List.range 120).all (fun v =>
        (ys[r]!)[i242Sigma.getD v 0]! == i242Sigma.getD ((genArrs[r]!)[v]!) 0) &&
      (List.range 3510).all fun p =>
        decide (sinv[(ys[r]!)[p]!]! < 120) == decide (sinv[p]! < 120)

