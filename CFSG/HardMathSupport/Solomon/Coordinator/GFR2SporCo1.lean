theorem order_five_data
    (hG : GOK) (r : ↥GA) (hr : orderOf r = 5) :
    Nat.card (fixAdd (mat r)) ≤ 256 ∧
      ((Xf.filter (· ∈ fixAdd (mat r))).card < 27 ∨
       54 < (Xf.filter (· ∈ fixAdd (mat r))).card) := by
  obtain ⟨c, a, hca⟩ := fusion_exists hG r hr
  have hk := idx3_lt a
  have hk0 : idx3 a ≠ 0 := by
    intro h0
    have h1 : (a 0).val = 0 := by unfold idx3 at h0; omega
    have h2 : (a 1).val = 0 := by unfold idx3 at h0; omega
    have h3 : (a 2).val = 0 := by unfold idx3 at h0; omega
    have ha0 : a = 0 := by
      funext i
      fin_cases i
      · exact (ZMod.val_eq_zero _).1 h1
      · exact (ZMod.val_eq_zero _).1 h2
      · exact (ZMod.val_eq_zero _).1 h3
    rw [ha0, show Multiplicative.ofAdd (0 : Fin 3 → ZMod 5) = 1 from rfl, map_one] at hca
    have : r = 1 := by
      have := congrArg (fun x : ↥GA => c⁻¹ * x * c) hca
      simpa [mul_assoc] using this
    rw [this, orderOf_one] at hr
    omega
  obtain ⟨hcard, hcnt⟩ := a0_data hk hk0
  have hrep := rep_a0Row hG hk
  rw [vec3_idx3] at hrep
  have hmat : rowsMatrix 24 (Timmesfeld.Co1Five.a0Row
      (CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co1F.gRows) (idx3 a)) =
      (((c : GL24) * (r : GL24) * (c : GL24)⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) := by
    have h1 : rowsMatrix 24 (Timmesfeld.Co1Five.a0Row
      (CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co1F.gRows) (idx3 a)) =
        (((φ hG (Multiplicative.ofAdd a) : ↥GA) : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) := hrep
    rw [h1, ← hca]
    rfl
  rw [hmat, card_fixAdd_conj] at hcard
  rw [hmat, card_Xf_filter_conj c.2] at hcnt
  exact ⟨hcard, hcnt⟩

