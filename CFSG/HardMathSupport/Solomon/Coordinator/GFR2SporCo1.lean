theorem fixedPoints_zpowers_eq {R S : Type*} [Group R] [MulAction R S] (r : R) :
    MulAction.fixedPoints (Subgroup.zpowers r) S = MulAction.fixedBy S r := by
  ext x
  simp only [MulAction.mem_fixedPoints, MulAction.mem_fixedBy]
  constructor
  · intro h
    exact h ⟨r, Subgroup.mem_zpowers r⟩
  · intro h ⟨g, hg⟩
    have hr : r ∈ MulAction.stabilizer R x := MulAction.mem_stabilizer_iff.2 h
    exact MulAction.mem_stabilizer_iff.1 ((Subgroup.zpowers_le.2 hr) hg)

theorem exists_one_ne_fix_all {R S : Type*} [Group R] [MulAction R S] [Finite S]
    (hR : Nat.card R = 25) (hS : Nat.card S = 64)
    (hdiv : ∀ r : R, r ≠ 1 → Nat.card (MulAction.fixedBy S r) ∣ 64) :
    ∃ r : R, r ≠ 1 ∧ ∀ x : S, r • x = x := by
  classical
  haveI : Finite R := Nat.finite_of_card_ne_zero (by rw [hR]; norm_num)
  haveI : Fintype R := Fintype.ofFinite R
  haveI : Fintype S := Fintype.ofFinite S
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  by_contra H
  push Not at H
  have hfix : ∀ r : R, r ≠ 1 → Nat.card (MulAction.fixedBy S r) = 4 := by
    intro r hr
    have hd := hdiv r hr
    have hne : Nat.card (MulAction.fixedBy S r) ≠ 64 := by
      intro h64
      obtain ⟨x, hx⟩ := H r hr
      have hsub : MulAction.fixedBy S r = Set.univ := by
        exact Set.eq_of_subset_of_ncard_le (Set.subset_univ _)
          (by rw [Set.ncard_univ, hS, ← Nat.card_coe_set_eq, h64]) (Set.toFinite _)
      have : x ∈ MulAction.fixedBy S r := hsub ▸ Set.mem_univ x
      exact hx (MulAction.mem_fixedBy.1 this)
    have hp : IsPGroup 5 (Subgroup.zpowers r) := by
      have h1 : orderOf r ∣ 25 := hR ▸ orderOf_dvd_natCard r
      obtain ⟨k, hk, hk'⟩ := (Nat.dvd_prime_pow Nat.prime_five).1 (show orderOf r ∣ 5 ^ 2 from h1)
      exact IsPGroup.of_card (n := k) (by rw [Nat.card_zpowers, hk'])
    have hmod := hp.card_modEq_card_fixedPoints S
    rw [fixedPoints_zpowers_eq, hS] at hmod
    obtain ⟨k, hk, hk'⟩ := (Nat.dvd_prime_pow Nat.prime_two).1
      (show Nat.card (MulAction.fixedBy S r) ∣ 2 ^ 6 from hd)
    rw [hk'] at hmod hne ⊢
    interval_cases k <;> simp_all [Nat.ModEq]
  have hsum := MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group R S
  have hcardR : Fintype.card R = 25 := by rw [Fintype.card_eq_nat_card]; exact hR
  have hone : Fintype.card (MulAction.fixedBy S (1 : R)) = 64 := by
    have : MulAction.fixedBy S (1 : R) = Set.univ := by
      ext x; simp [MulAction.mem_fixedBy]
    rw [Fintype.card_eq_nat_card, this, Nat.card_univ, hS]
  have hother : ∀ r ∈ Finset.univ.erase (1 : R), Fintype.card (MulAction.fixedBy S r) = 4 := by
    intro r hr
    rw [Fintype.card_eq_nat_card]
    exact hfix r (Finset.ne_of_mem_erase hr)
  rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (1 : R)), hone,
    Finset.sum_congr rfl hother, Finset.sum_const, Finset.card_erase_of_mem (Finset.mem_univ _),
    Finset.card_univ, hcardR, smul_eq_mul] at hsum
  omega

@[instance_reducible] def restrictAction {R V : Type*} [Group R] [AddCommGroup V]
    [DistribMulAction R V] (W : AddSubgroup V) (hinv : ∀ r : R, ∀ w ∈ W, r • w ∈ W) :
    MulAction R ↥W where
  smul r w := ⟨r • w.1, hinv r w.1 w.2⟩
  one_smul w := Subtype.ext (one_smul R w.1)
  mul_smul r r' w := Subtype.ext (mul_smul r r' w.1)

theorem exists_fix_pointwise_abstract {R V : Type*} [Group R] [AddCommGroup V] [Finite V]
    [DistribMulAction R V] (W : AddSubgroup V) (hinv : ∀ r : R, ∀ w ∈ W, r • w ∈ W)
    (hR : Nat.card R = 25) (hW : Nat.card W = 64) :
    ∃ r : R, r ≠ 1 ∧ ∀ w ∈ W, r • w = w := by
  letI := restrictAction W hinv
  have hdiv : ∀ r : R, r ≠ 1 → Nat.card (MulAction.fixedBy ↥W r) ∣ 64 := by
    intro r _
    let F : AddSubgroup ↥W := AddSubgroup.comap W.subtype
      { carrier := {v | r • v = v}
        add_mem' := fun {a b} ha hb => by simp only [Set.mem_setOf_eq, smul_add] at *; rw [ha, hb]
        zero_mem' := by simp
        neg_mem' := fun {a} ha => by simp only [Set.mem_setOf_eq, smul_neg] at *; rw [ha] }
    have hfb : MulAction.fixedBy ↥W r = (F : Set ↥W) := by
      ext w
      rw [MulAction.mem_fixedBy]
      constructor
      · intro h
        exact congrArg Subtype.val h
      · intro h
        exact Subtype.ext h
    rw [hfb]
    have := AddSubgroup.card_addSubgroup_dvd_card F
    rw [hW] at this
    exact this
  obtain ⟨r, hr1, hrfix⟩ := exists_one_ne_fix_all (R := R) (S := ↥W) hR hW hdiv
  exact ⟨r, hr1, fun w hw => congrArg Subtype.val (hrfix ⟨w, hw⟩)⟩

theorem exists_subgroup_card_25 {G : Type*} [Group G] [Finite G] (s : G)
    (hd : 25 ∣ Nat.card (Subgroup.centralizer ({s} : Set G))) :
    ∃ R : Subgroup G, Nat.card R = 25 ∧ ∀ r ∈ R, r * s = s * r := by
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨R0, hR0⟩ := Sylow.exists_subgroup_card_pow_prime
    (G := ↥(Subgroup.centralizer ({s} : Set G))) 5 (n := 2) (by simpa using hd)
  refine ⟨R0.map (Subgroup.centralizer ({s} : Set G)).subtype, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective (Subgroup.centralizer ({s} : Set G)).subtype_injective, hR0]
    norm_num
  · rintro _ ⟨c, -, rfl⟩
    exact Subgroup.mem_centralizer_singleton_iff.1 c.2

theorem exists_order_mul_of_centralizer {G : Type*} [Group G] [Finite G] {v : G} {p q : ℕ}
    (hq : q.Prime) (hpq : Nat.Coprime p q) (hv : orderOf v = p)
    (h : q ∣ Nat.card (Subgroup.centralizer ({v} : Set G))) : ∃ g : G, orderOf g = p * q := by
  haveI : Fact q.Prime := ⟨hq⟩
  obtain ⟨c, hc⟩ := exists_prime_orderOf_dvd_card'
    (G := ↥(Subgroup.centralizer ({v} : Set G))) q h
  have hcv : (c : G) * v = v * (c : G) := Subgroup.mem_centralizer_singleton_iff.1 c.2
  have hco : orderOf (c : G) = q := by rw [Subgroup.orderOf_coe]; exact hc
  refine ⟨v * (c : G), ?_⟩
  rw [Commute.orderOf_mul_eq_mul_orderOf_of_coprime (show Commute v (c : G) from hcv.symm)
    (by rw [hv, hco]; exact hpq), hv, hco]

end Burnside

