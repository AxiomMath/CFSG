private noncomputable def co1Iota (hbr : SporadicBridges) :
    (TauCeti.CFSGIndex.sporadic .Co1).Group ≃* ↥CFSG.Sporadic.Co1Schreier.GA :=
  (hbr .Co1).some.symm.trans CFSG.Sporadic.Co1Block.co1MatEquiv

private theorem card_sporadic_Co1 (hbr : SporadicBridges) :
    Nat.card (TauCeti.CFSGIndex.sporadic .Co1).Group = sporOrd .Co1 := by
  rw [← Nat.card_congr (hbr .Co1).some.toEquiv]
  show Nat.card NativeSporadic.Co1 = sporOrd .Co1
  rw [CFSG.Sporadic.Co1.card_Co1]
  rfl

private theorem oPrime_sporadic_Co1
    (hbr : SporadicBridges) :
    OPrimeCoreTrivialAt 3 (TauCeti.CFSGIndex.sporadic .Co1).Group := by
  haveI : Finite ↥CFSG.Sporadic.Co1Schreier.GA := Co1T.finite_GA
  exact @OPrimeCoreTrivialAt.of_mulEquiv 3 _ _ ↥CFSG.Sporadic.Co1Schreier.GA
    (Subgroup.toGroup CFSG.Sporadic.Co1Schreier.GA) (co1Iota hbr) Co1T.oPrimeCoreTrivialAt_GA

private theorem noHatSix_sporadic_Co1
    (hbr : SporadicBridges) (s : (TauCeti.CFSGIndex.sporadic .Co1).Group) (hs : orderOf s = 3)
    (K : Subgroup (TauCeti.CFSGIndex.sporadic .Co1).Group)
    (hK : CFSG.Open.IsComponentOf K (Subgroup.centralizer ({s} : Set _))) (h : IsHatSix ↥K) :
    False := by
  haveI : Finite ↥CFSG.Sporadic.Co1Schreier.GA := Co1T.finite_GA
  haveI : Finite (TauCeti.CFSGIndex.sporadic .Co1).Group :=
    Finite.of_equiv ↥CFSG.Sporadic.Co1Schreier.GA (co1Iota hbr).symm.toEquiv
  have hkt := @Co1Spor.kill_transport (TauCeti.CFSGIndex.sporadic .Co1).Group
    ↥CFSG.Sporadic.Co1Schreier.GA _ (Subgroup.toGroup CFSG.Sporadic.Co1Schreier.GA) (co1Iota hbr)
    (fun _ hg => Co1Spor.kill_all hg) s hs
  exact Co1Spor.false_of_kill hK h hkt

theorem sporNoPumpup_Co1
    (hSpM : SporadicMultipliers)
    (hOG : UniquenessMaximal.InputONGroup) (hOut : SporadicOuterLeTwo) (hbr : SporadicBridges) :
    SporNoPumpup .Co1 := by
  refine sporNoPumpup_of_components hSpM hOG hOut (card_sporadic_Co1 hbr)
    (oPrime_sporadic_Co1 hbr) ?_ ?_
  · intro s hs K hK h
    rcases h with h | ⟨hM, _⟩
    · exact noHatSix_sporadic_Co1 hbr s hs K hK h
    · exact absurd hM (by decide)
  · intro h3
    exact absurd h3 (by decide)

