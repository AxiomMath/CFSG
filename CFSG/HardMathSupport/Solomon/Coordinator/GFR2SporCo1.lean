theorem pow_mulVec_of_fixed {A : Matrix (Fin 24) (Fin 24) (ZMod 2)} {w : Vec24} (h : A *ᵥ w = w)
    (m : ℕ) : (A ^ m) *ᵥ w = w := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ', ← Matrix.mulVec_mulVec, ih, h]

@[instance_reducible] def actOnVec (R : Subgroup ↥GA) : DistribMulAction ↥R Vec24 where
  smul r v := mat (r : ↥GA) *ᵥ v
  one_smul v := by
    show mat (((1 : ↥R) : ↥GA)) *ᵥ v = v
    simp [mat]
  mul_smul r r' v := by
    show mat ((r * r' : ↥R) : ↥GA) *ᵥ v = mat (r : ↥GA) *ᵥ (mat (r' : ↥GA) *ᵥ v)
    rw [Matrix.mulVec_mulVec]
    simp [mat]
  smul_zero r := Matrix.mulVec_zero _
  smul_add r a b := Matrix.mulVec_add _ _ _

theorem exists_fix_pointwise (s : ↥GA) (R : Subgroup ↥GA) (hRC : ∀ r ∈ R, r * s = s * r)
    (hRcard : Nat.card R = 25) (hW : Nat.card (fixAdd (mat s)) = 64) :
    ∃ r ∈ R, r ≠ 1 ∧ ∀ w ∈ fixAdd (mat s), mat r *ᵥ w = w := by
  letI := actOnVec R
  have hinv : ∀ r : ↥R, ∀ w ∈ fixAdd (mat s), r • w ∈ fixAdd (mat s) := by
    intro r w hw
    show mat (r : ↥GA) *ᵥ w ∈ fixAdd (mat s)
    rw [mem_fixAdd, Matrix.mulVec_mulVec]
    have h1 : mat s * mat (r : ↥GA) = mat (r : ↥GA) * mat s := by
      have := congrArg (fun x : ↥GA => mat x) (hRC r r.2).symm
      simpa [mat] using this
    rw [h1, ← Matrix.mulVec_mulVec, mem_fixAdd.1 hw]
  obtain ⟨r, hr1, hrfix⟩ := @exists_fix_pointwise_abstract ↥R Vec24 _ _ _ (actOnVec R)
    (fixAdd (mat s)) hinv (by simpa using hRcard) hW
  exact ⟨r, r.2, fun h => hr1 (Subtype.ext h), fun w hw => hrfix w hw⟩

theorem exists_order_five_fix (s : ↥GA) (R : Subgroup ↥GA) (hRC : ∀ r ∈ R, r * s = s * r)
    (hRcard : Nat.card R = 25) (hW : Nat.card (fixAdd (mat s)) = 64) :
    ∃ r5 : ↥GA, orderOf r5 = 5 ∧ ∀ w ∈ fixAdd (mat s), mat r5 *ᵥ w = w := by
  obtain ⟨r, hrR, hr1', hfixW⟩ := exists_fix_pointwise s R hRC hRcard hW
  have hord : orderOf r ∣ 5 ^ 2 := by
    have h1 := orderOf_dvd_natCard (⟨r, hrR⟩ : ↥R)
    rw [hRcard, Subgroup.orderOf_mk] at h1
    exact h1
  obtain ⟨k, hk, hk'⟩ := (Nat.dvd_prime_pow Nat.prime_five).1 hord
  have hk1 : k ≠ 0 := by
    rintro rfl
    exact hr1' (orderOf_eq_one_iff.1 (by simpa using hk'))
  have hN5 : 5 ∣ orderOf r := by
    rw [hk']
    exact dvd_pow_self 5 hk1
  have hNpos : 0 < orderOf r := orderOf_pos _
  refine ⟨r ^ (orderOf r / 5), ?_, ?_⟩
  · have hdvd : orderOf r / 5 ∣ orderOf r := Nat.div_dvd_of_dvd hN5
    have hne : orderOf r / 5 ≠ 0 := by
      have := Nat.le_of_dvd hNpos hN5
      omega
    rw [orderOf_pow_of_dvd hne hdvd]
    exact Nat.div_div_self hN5 hNpos.ne'

  · intro w hw
    have : mat (r ^ (orderOf r / 5)) = (mat r) ^ (orderOf r / 5) := by
      simp [mat, Subgroup.coe_pow, Units.val_pow_eq_pow_val]
    rw [this]
    exact pow_mulVec_of_fixed (hfixW w hw) _

theorem no25_of_data
    (hG : GOK) (s : ↥GA)
    (hW : Nat.card (fixAdd (mat s)) = 64) (hXW : (Xf.filter (· ∈ fixAdd (mat s))).card = 27)
    (hblock : ∀ x ∈ Xf, x ∉ fixAdd (mat s) →
      (Xf.filter (fun y => y - x ∈ fixAdd (mat s))).card ≤ 9) :
    ¬ 25 ∣ Nat.card (Subgroup.centralizer ({s} : Set ↥GA)) := by
  intro hd
  haveI : Finite ↥GA := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co1T.finite_GA
  obtain ⟨R, hRcard, hRC⟩ := exists_subgroup_card_25 s hd
  obtain ⟨r5, h5, hr5fix⟩ := exists_order_five_fix s R hRC hRcard hW
  obtain ⟨hcard, hcnt⟩ := order_five_data hG r5 h5
  have hWU : fixAdd (mat s) ≤ fixAdd (mat r5) := fun w hw => mem_fixAdd.2 (hr5fix w hw)
  have h54 := card_filter_mem_le (fixAdd (mat r5)) (fixAdd (mat s)) hWU hW hcard Xf
    (le_of_eq hXW) hblock
  have h27 : 27 ≤ (Xf.filter (· ∈ fixAdd (mat r5))).card := by
    rw [← hXW]
    refine Finset.card_le_card fun x hx => ?_
    simp only [Finset.mem_filter] at hx ⊢
    exact ⟨hx.1, hWU hx.2⟩
  rcases hcnt with h | h
  · omega
  · omega

