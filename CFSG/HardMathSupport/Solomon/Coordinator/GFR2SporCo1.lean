    simp only [eE, eExp]
    rw [List.getD_eq_getElem _ _ hk6]
  have hk0 : k ≠ 0 := by
    rintro rfl
    have h0 : ∀ x ∈ eExp 0, x = 0 := by
      intro x hx
      have : eExp 0 = [0, 0, 0, 0, 0, 0] := rfl
      rw [this] at hx
      simpa using hx
    have : eE 0 = 1 := eltG_of_zeros _ _ h0
    rw [this] at hEk
    rw [← hEk, orderOf_one] at hto
    omega
  obtain ⟨h, r, hr, hrel⟩ := fus_cert k hk729 hk0
  exact ⟨h, r, hr, by rw [hrel, hEk]⟩

theorem exists_rep_root {t c : ↥GA} {j : ℕ}
    (hj : j = 0 ∨ j = 1 ∨ j = 2) (htrep : t = c * Co1T.root j * c⁻¹) :
    ∃ h r : ↥GA, (r = eE 243 ∨ r = eE 81 ∨ r = eE 324 ∨ r = Co1T.root 2) ∧ h * r * h⁻¹ = t := by
  obtain ⟨⟨c1, h1⟩, ⟨c0, h0⟩, -, -, -⟩ := kill_cert
  rcases hj with rfl | rfl | rfl
  · refine ⟨c * c0, eE 324, Or.inr (Or.inr (Or.inl rfl)), ?_⟩
    have e0 : Co1T.root 0 = c0 * eE 324 * c0⁻¹ := by
      rw [h0]; group
    rw [htrep, e0]; group
  · refine ⟨c * c1, eE 81, Or.inr (Or.inl rfl), ?_⟩
    have e1 : Co1T.root 1 = c1 * eE 81 * c1⁻¹ := by
      rw [h1]; group
    rw [htrep, e1]; group
  · exact ⟨c, Co1T.root 2, Or.inr (Or.inr (Or.inr rfl)), htrep.symm⟩

theorem exists_rep {s : ↥GA}
    (hs : orderOf s = 3) :
    ∃ k r : ↥GA, (r = eE 243 ∨ r = eE 81 ∨ r = eE 324 ∨ r = Co1T.root 2) ∧ k * r * k⁻¹ = s := by
  haveI : Finite ↥GA := Co1T.finite_GA
  obtain ⟨g, -, hg⟩ := @Co3T.exists_conj_mem_of_full ↥GA (Subgroup.toGroup GA) 3
    ⟨Nat.prime_three⟩ ⊤ Co1T.Qg inferInstance le_top
    (by rw [Co1T.card_Qg, Co1T.factorization_card_GA]) s (Subgroup.mem_top s) hs
  obtain ⟨t, htdef⟩ : ∃ t : ↥GA, t = g⁻¹ * s * g := ⟨_, rfl⟩
  rw [← htdef] at hg
  have hto : orderOf t = 3 := by
    have := Co1T.orderOf_conj_GA g⁻¹ s
    rw [inv_inv] at this
    rw [htdef, this, hs]
  have hst : s = g * t * g⁻¹ := by rw [htdef]; group
  obtain ⟨h, r, hr, hrel⟩ : ∃ h r : ↥GA,
      (r = eE 243 ∨ r = eE 81 ∨ r = eE 324 ∨ r = Co1T.root 2) ∧ h * r * h⁻¹ = t := by
    rcases Co1T.fusion_root hg hto with hE | ⟨j, hj, c, htc⟩
    · obtain ⟨h, r, hr, hrel⟩ := exists_rep_E hE hto
      refine ⟨h, r, ?_, hrel⟩
      rcases hr with hr | hr | hr
      · exact Or.inl hr
      · exact Or.inr (Or.inl hr)
      · exact Or.inr (Or.inr (Or.inl hr))
    · exact exists_rep_root hj htc
  exact ⟨g * h, r, hr, by rw [hst, ← hrel]; group⟩

end Classify

section Final

theorem kill_all {s : ↥GA} (hs : orderOf s = 3) :
    PrimeKill (Subgroup.centralizer ({s} : Set ↥GA)) ∨
      FiveKill (Subgroup.centralizer ({s} : Set ↥GA)) := by
  obtain ⟨k, r, hr, hkr⟩ := exists_rep hs
  refine kill_of_conj hkr ?_
  rcases hr with rfl | rfl | rfl | rfl
  · exact Or.inl primeKill_A
  · exact Or.inl primeKill_B
  · exact Or.inr fiveKill_C
  · exact Or.inl primeKill_D

end Final

