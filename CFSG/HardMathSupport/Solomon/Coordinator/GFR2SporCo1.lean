theorem card_filter_mem_le {V : Type*} [AddCommGroup V] [DecidableEq V] [Finite V]
    (U W : AddSubgroup V) [DecidablePred (· ∈ U)] [DecidablePred (· ∈ W)] (hWU : W ≤ U)
    (hW : Nat.card W = 64) (hU : Nat.card U ≤ 256)
    (X : Finset V) (hW27 : (X.filter (· ∈ W)).card ≤ 27)
    (hblock : ∀ x ∈ X, x ∉ W → (X.filter (fun y => y - x ∈ W)).card ≤ 9) :
    (X.filter (· ∈ U)).card ≤ 54 := by
  classical
  set W' : AddSubgroup U := W.addSubgroupOf U with hW'
  have hW'card : Nat.card W' = 64 := by
    rw [hW', Nat.card_congr (AddSubgroup.addSubgroupOfEquivOfLe hWU).toEquiv, hW]
  have hidx : W'.index ≤ 4 := by
    have h := W'.index_mul_card
    rw [hW'card] at h
    have : Nat.card U = Nat.card ↥U := rfl
    omega
  haveI : Finite (↥U ⧸ W') :=
    Finite.of_surjective (QuotientAddGroup.mk (s := W')) (QuotientAddGroup.mk_surjective)
  haveI : Fintype (↥U ⧸ W') := Fintype.ofFinite _
  have hQ : Fintype.card (↥U ⧸ W') ≤ 4 := by
    rw [Fintype.card_eq_nat_card, ← AddSubgroup.index_eq_card]; exact hidx
  let f : V → ↥U ⧸ W' := fun x => if h : x ∈ U then QuotientAddGroup.mk ⟨x, h⟩ else 0
  let S := X.filter (· ∈ U)
  let Img : Finset (↥U ⧸ W') := S.image f
  have hmaps : Set.MapsTo f (S : Set V) (Img : Set (↥U ⧸ W')) := fun x hx =>
    Finset.mem_coe.2 (Finset.mem_image_of_mem f (Finset.mem_coe.1 hx))
  have hsum := Finset.card_eq_sum_card_fiberwise hmaps
  have hfib : ∀ q ∈ Img, (S.filter (fun x => f x = q)).card ≤ 9 + (if q = 0 then 18 else 0) := by
    intro q hq
    by_cases hq0 : q = 0
    · subst hq0
      have : (S.filter (fun x => f x = 0)).card ≤ 27 := by
        refine le_trans (Finset.card_le_card ?_) hW27
        intro x hx
        simp only [S, Finset.mem_filter] at hx ⊢
        obtain ⟨⟨hxX, hxU⟩, hfx⟩ := hx
        refine ⟨hxX, ?_⟩
        simp only [f, dif_pos hxU] at hfx
        have := (QuotientAddGroup.eq_zero_iff (N := W') ⟨x, hxU⟩).1 hfx
        exact this
      simp
      omega
    · rcases (S.filter (fun x => f x = q)).eq_empty_or_nonempty with he | ⟨x0, hx0⟩
      · rw [he]; simp
      · simp only [S, Finset.mem_filter] at hx0
        obtain ⟨⟨hx0X, hx0U⟩, hfx0⟩ := hx0
        have hx0W : x0 ∉ W := by
          intro hw
          apply hq0
          rw [← hfx0]
          simp only [f, dif_pos hx0U]
          exact (QuotientAddGroup.eq_zero_iff (N := W') ⟨x0, hx0U⟩).2 hw
        have : (S.filter (fun x => f x = q)).card ≤ 9 := by
          refine le_trans (Finset.card_le_card ?_) (hblock x0 hx0X hx0W)
          intro y hy
          simp only [S, Finset.mem_filter] at hy ⊢
          obtain ⟨⟨hyX, hyU⟩, hfy⟩ := hy
          refine ⟨hyX, ?_⟩
          have h1 : f y = f x0 := hfy.trans hfx0.symm
          simp only [f, dif_pos hyU, dif_pos hx0U] at h1
          have := (QuotientAddGroup.eq_iff_sub_mem (N := W')).1 h1
          exact (by simpa [W', AddSubgroup.mem_addSubgroupOf] using this)
        simp [hq0]
        omega
  calc (X.filter (· ∈ U)).card = ∑ q ∈ Img, (S.filter (fun x => f x = q)).card := hsum
    _ ≤ ∑ q ∈ Img, (9 + (if q = 0 then 18 else 0)) := Finset.sum_le_sum hfib
    _ = 9 * Img.card + (if (0 : ↥U ⧸ W') ∈ Img then 18 else 0) := by
        rw [Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul, mul_comm, Finset.sum_ite_eq']
    _ ≤ 54 := by
        have h1 : Img.card ≤ 4 := le_trans (Finset.card_le_univ _) hQ
        split_ifs <;> omega

end Coset

