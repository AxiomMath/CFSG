section Kill

def PrimeKill {G : Type*} [Group G] (C : Subgroup G) : Prop :=
  ∃ (v : G) (p : ℕ), v ∈ C ∧ p.Prime ∧ 7 ≤ p ∧ orderOf v = p ∧ ¬ 5 ^ p ∣ Nat.card C ∧
    ¬ 1080 ∣ Nat.card (Subgroup.centralizer ({v} : Set G))

def FiveKill {G : Type*} [Group G] (C : Subgroup G) : Prop :=
  ¬ 25 ∣ Nat.card C ∧ ∃ u₁ u₂ : G, u₁ ∈ C ∧ u₂ ∈ C ∧ orderOf u₁ = 5 ∧ orderOf u₂ = 5 ∧
    1080 < Nat.card (Subgroup.closure ({u₁, u₂} : Set G))

theorem false_of_kill {G : Type*} [Group G] [Finite G] {C K : Subgroup G}
    (hK : IsComponentOf K C) (h : IsHatSix ↥K) (hk : PrimeKill C ∨ FiveKill C) : False := by
  rcases hk with ⟨v, p, hv, hp, hp7, hvp, h5p, h1080⟩ | ⟨h25, u₁, u₂, hu₁, hu₂, ho₁, ho₂, hbig⟩
  · exact false_of_component_of_prime_elem_card hK h hv hp hp7 hvp h5p h1080
  · refine false_of_isHatSix_of_five_gen hK h h25 (T := ({u₁, u₂} : Set G)) ?_ ?_ hbig
    · intro x hx
      rcases hx with rfl | rfl
      · exact hu₁
      · exact hu₂
    · intro x hx
      rcases hx with rfl | rfl
      · exact ho₁
      · exact ho₂

theorem map_centralizer_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) (s : G) :
    (Subgroup.centralizer ({s} : Set G)).map e.toMonoidHom =
      Subgroup.centralizer ({e s} : Set H) := by
  ext y
  rw [Subgroup.mem_map_equiv, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro hy
    have := congrArg e hy
    rwa [map_mul, map_mul, MulEquiv.apply_symm_apply] at this
  · intro hy
    apply e.injective
    rw [map_mul, map_mul, MulEquiv.apply_symm_apply]
    exact hy

theorem card_centralizer_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) (s : G) :
    Nat.card (Subgroup.centralizer ({e s} : Set H)) =
      Nat.card (Subgroup.centralizer ({s} : Set G)) := by
  rw [← map_centralizer_mulEquiv e s, Subgroup.card_map_of_injective e.injective]

theorem kill_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) {C : Subgroup G}
    (h : PrimeKill C ∨ FiveKill C) :
    PrimeKill (C.map e.toMonoidHom) ∨ FiveKill (C.map e.toMonoidHom) := by
  rcases h with ⟨v, p, hv, hp, hp7, hvp, h5p, h1080⟩ | ⟨h25, u₁, u₂, hu₁, hu₂, ho₁, ho₂, hbig⟩
  · refine Or.inl ⟨e v, p, ⟨v, hv, rfl⟩, hp, hp7, by rw [MulEquiv.orderOf_eq]; exact hvp, ?_, ?_⟩
    · rwa [Subgroup.card_map_of_injective e.injective]
    · rwa [card_centralizer_mulEquiv]
  · refine Or.inr ⟨?_, e u₁, e u₂, ⟨u₁, hu₁, rfl⟩, ⟨u₂, hu₂, rfl⟩,
      by rw [MulEquiv.orderOf_eq]; exact ho₁, by rw [MulEquiv.orderOf_eq]; exact ho₂, ?_⟩
    · rwa [Subgroup.card_map_of_injective e.injective]
    · have hmap : (Subgroup.closure ({u₁, u₂} : Set G)).map e.toMonoidHom =
          Subgroup.closure ({e u₁, e u₂} : Set H) := by
        rw [MonoidHom.map_closure, Set.image_pair]
        rfl
      rw [← hmap, Subgroup.card_map_of_injective e.injective]
      exact hbig

theorem primeKill_of_conj {G : Type*} [Group G] {C : Subgroup G} {v h s : G} {p N : ℕ}
    (hv : v ∈ C) (hp : p.Prime) (hp7 : 7 ≤ p) (hvp : orderOf v = p) (h5p : ¬ 5 ^ p ∣ Nat.card C)
    (hj : h * v = s * h) (hN : Nat.card (Subgroup.centralizer ({s} : Set G)) = N)
    (hN1080 : ¬ 1080 ∣ N) : PrimeKill C := by
  refine ⟨v, p, hv, hp, hp7, hvp, h5p, ?_⟩
  have h1 := card_centralizer_mulEquiv (MulAut.conj h : G ≃* G) v
  have h2 : (MulAut.conj h : G ≃* G) v = s := by
    rw [MulAut.conj_apply]
    exact mul_inv_eq_iff_eq_mul.2 hj
  rw [h2, hN] at h1
  rw [← h1]
  exact hN1080

theorem kill_of_conj {G : Type*} [Group G] {r s k : G} (hkr : k * r * k⁻¹ = s)
    (h : PrimeKill (Subgroup.centralizer ({r} : Set G)) ∨
      FiveKill (Subgroup.centralizer ({r} : Set G))) :
    PrimeKill (Subgroup.centralizer ({s} : Set G)) ∨
      FiveKill (Subgroup.centralizer ({s} : Set G)) := by
  have h1 := kill_of_mulEquiv (MulAut.conj k : G ≃* G) h
  have h2 : (MulAut.conj k : G ≃* G) r = s := by
    rw [MulAut.conj_apply]
    exact hkr
  rwa [map_centralizer_mulEquiv, h2] at h1

theorem kill_transport {S G : Type*} [Group S] [Group G] (ι : S ≃* G)
    (h : ∀ g : G, orderOf g = 3 → PrimeKill (Subgroup.centralizer ({g} : Set G)) ∨
      FiveKill (Subgroup.centralizer ({g} : Set G)))
    {s : S} (hs : orderOf s = 3) :
    PrimeKill (Subgroup.centralizer ({s} : Set S)) ∨
      FiveKill (Subgroup.centralizer ({s} : Set S)) := by
  have h2 := kill_of_mulEquiv ι.symm (h (ι s) (by rw [MulEquiv.orderOf_eq]; exact hs))
  rwa [map_centralizer_mulEquiv, MulEquiv.symm_apply_apply] at h2

end Kill

