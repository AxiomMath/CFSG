theorem unit_mulVec_inv (c : GL24) (v : Vec24) :
    (c : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ
      ((c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ v = v := by
  rw [Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.one_mulVec]

theorem unit_inv_mulVec (c : GL24) (v : Vec24) :
    ((c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ
      (c : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ v = v := by
  rw [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mulVec]

theorem conj_mulVec (c g : GL24) (v : Vec24) :
    ((c * g * c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ
        ((c : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ v) =
      (c : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ
        ((g : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ v) := by
  rw [Matrix.mulVec_mulVec, ← Units.val_mul, show c * g * c⁻¹ * c = c * g by group,
    Units.val_mul, ← Matrix.mulVec_mulVec]

noncomputable def conjEquiv (c g : GL24) :
    fixAdd (g : Matrix (Fin 24) (Fin 24) (ZMod 2)) ≃
      fixAdd ((c * g * c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) where
  toFun v := ⟨(c : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ v.1, by
    rw [mem_fixAdd, conj_mulVec, mem_fixAdd.1 v.2]⟩
  invFun w := ⟨((c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ w.1, by
    rw [mem_fixAdd]
    have h := conj_mulVec c g (((c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ w.1)
    rw [unit_mulVec_inv, mem_fixAdd.1 w.2] at h
    have h2 := congrArg (fun x => ((c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ x) h
    simp only [unit_inv_mulVec] at h2
    exact h2.symm⟩
  left_inv v := Subtype.ext (unit_inv_mulVec c v.1)
  right_inv w := Subtype.ext (unit_mulVec_inv c w.1)

theorem card_fixAdd_conj (c g : GL24) :
    Nat.card (fixAdd ((c * g * c⁻¹ : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2))) =
      Nat.card (fixAdd (g : Matrix (Fin 24) (Fin 24) (ZMod 2))) :=
  (Nat.card_congr (conjEquiv c g)).symm

