theorem sporadicOnePairOPrime_of_open
    (hBRc : BThreeFi23.BThreeRc) (hBRd : BThreeFi23.BThreeRd) (hB5A : BFiveNonCentral)
    (hM3K : TwoAPureKlein 3 CFSG.Monster.Generated.Gmat)
    (hM5K : TwoATwoCommuting 5 CFSG.Monster.Generated.Gmat)
    (hM7cl : MonsterSevenClasses CFSG.AGLEmbedding.Norton.MON5_7.dG
      CFSG.AGLEmbedding.Norton.MON5_7.zG) :
    ∀ name p, SporadicOnePair name p → SporadicOPrimeHolds name p := by
  have hbr : SporadicBridges := CFSG.Sporadic.Bridge.nonempty_carrier_mulEquiv_group
  have hB3 : OPrimeCoreTrivialAt 3 CFSG.Blueprint.NativeSporadic.B :=
    BThreeFi23.oPrimeCoreTrivialAt_B_three_of_fi23 hBRc hBRd
  have hB5 : OPrimeCoreTrivialAt 5 CFSG.Blueprint.NativeSporadic.B :=
    oPrimeCoreTrivialAt_B_five_of_nonCentral hB5A
  have hM3 : OPrimeCoreTrivialAt 3 CFSG.Monster.Generated.Gmat :=
    oPrimeCoreTrivialAt_gmat_of_uninverted Nat.prime_three (by norm_num)
      (uninvertedOPrimeTrivial_gmat_of_twoAPureKlein Nat.prime_three (by norm_num) hB3 hM3K)
  have hM5 : OPrimeCoreTrivialAt 5 CFSG.Monster.Generated.Gmat :=
    oPrimeCoreTrivialAt_gmat_of_uninverted Nat.prime_five (by norm_num)
      (uninvertedOPrimeTrivial_gmat_of_twoATwoCommuting Nat.prime_five (by norm_num) hB5
        sporadicOPrimeHolds_Co1_five hM5K)
  have hM7 : OPrimeCoreTrivialAt 7 CFSG.Monster.Generated.Gmat :=
    oPrimeCoreTrivialAt_seven_Gmat_of_classes hM7cl
  intro name p hp
  unfold SporadicOnePair at hp
  rcases hp with ⟨rfl, hn⟩ | ⟨rfl, hn⟩ | ⟨rfl, rfl⟩
  · simp only [Finset.mem_insert, Finset.mem_singleton] at hn
    rcases hn with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl
    · exact (sporadicOnePairHolds_J3 (hbr .J3)).1
    · exact sporadicOnePairHolds_McL.1
    · exact sporadicOPrimeHolds_Suz_three
    · exact sporadicOPrimeHolds_ONan_three
    · exact sporadicOPrimeHolds_Co3_three
    · exact sporadicOPrimeHolds_Co2_three
    · exact sporadicOPrimeHolds_Co1_three
    · exact sporadicOPrimeHolds_Fi22_three
    · exact sporadicOPrimeHolds_Fi23_three
    · exact sporadicOPrimeHolds_Fi24_three
    · exact sporadicOPrimeHolds_HN_three
    · exact sporadicOPrimeHolds_Ly_three
    · exact sporadicOPrimeHolds_Th_three
    · exact (sporadicOPrimeHolds_B_iff 3).2 hB3
    · exact sporadicOPrimeHolds_M_of_gmat hM3
  · simp only [Finset.mem_insert, Finset.mem_singleton] at hn
    rcases hn with rfl | rfl | rfl | rfl | rfl
    · exact sporadicOPrimeHolds_Co1_five
    · exact sporadicOPrimeHolds_HN_five_of_orders hnFiveOrders_holds
    · exact sporadicOPrimeHolds_Ly_five
    · exact (sporadicOPrimeHolds_B_iff 5).2 hB5
    · exact sporadicOPrimeHolds_M_of_gmat hM5
  · exact sporadicOPrimeHolds_M_of_gmat hM7

