theorem normalizesRGroup_of_posStable_frame {K : Type} [Field K] [Finite K]
    (hK3 : ¬ 3 ∣ Nat.card K) {E₀ P : Subgroup (adjointGroup .E8 K)} {z : adjointGroup .E8 K}
    (hz3 : z ^ 3 = 1) (hE : E₀ ≤ P ⊔ Subgroup.zpowers z) (hPz : ∀ q ∈ P, Commute z q)
    (a : Fin 2 → Fin Tag.E8.rank → (AlgebraicClosure K)ˣ)
    (Fr : AlgebraicClosure K →+* AlgebraicClosure K) (hFr : ∀ c, Fr c = c ^ Nat.card K)
    {g₁ t₁ m₁ : ModGL .E8 (AlgebraicClosure K)} {ω₁ x₁ : WeylGroup .E8}
    (hg₁ : g₁ ∈ adjointGroup .E8 (AlgebraicClosure K))
    (hz₁ : g₁ * (t₁ * canonicalRep (coxeterSystem .E8) (AlgebraicClosure K) ω₁) * g₁⁻¹ =
      baseChangeGL (algebraMap K (AlgebraicClosure K)) (z : ModGL .E8 K))
    (hν₁ : Units.map (entrywiseHom Fr) g₁ =
      g₁ * (m₁ * canonicalRep (coxeterSystem .E8) (AlgebraicClosure K) x₁))
    (ht₁ : t₁ ∈ torusGroup .E8 (AlgebraicClosure K))
    (hm₁ : m₁ ∈ familyGroup (K := AlgebraicClosure K) a)
    (hx₁ : (fun α => x₁ • α) '' familyKernel a = familyKernel a) (hx₁pos : KernelPosStable a x₁)
    (hω₁3 : ω₁ ^ 3 = 1) (hω₁S : ω₁ ∈ familyStabilizer a) (hω₁pos : KernelPosStable a ω₁)
    (hP : ∀ q ∈ P, ∀ u ∈ familyGroup (K := AlgebraicClosure K) a, Commute u
      (g₁⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) (q : ModGL .E8 K) * g₁))
    {d : Fin Tag.E8.rank → ℤ} (hdK : d ∈ familyKernel a) (hdo : IsOrthTriple ω₁ d)
    (htrans : ∀ β ∈ familyKernel a, IsOrthTriple ω₁ β → ∃ l : List (Fin Tag.E8.rank → ℤ),
      (∀ δ ∈ l, δ ∈ familyKernel a ∧ IsOrthTriple ω₁ δ) ∧
        (l.map (tripleRefl ω₁)).prod • β ∈ ({d, ω₁ • d, ω₁ ^ 2 • d} : Set (Fin Tag.E8.rank → ℤ))) :
    NormalizesRGroup (ringChar K) E₀ := by
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨⟨e, he⟩, hℓ, hf⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hℓ⟩
  haveI : CharP K (ringChar K) := ringChar.charP K
  haveI : CharP (AlgebraicClosure K) (ringChar K) :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective _
  have hcard : Nat.card K = ringChar K ^ e := by
    rw [Nat.card_eq_fintype_card]
    exact hf
  have hc := frob_baseChangeGL Fr hFr (z : ModGL Tag.E8 K)
  obtain rfl : Fr = iterateFrobenius (AlgebraicClosure K) (ringChar K) e :=
    eq_iterateFrobenius Fr hFr hcard
  set L := AlgebraicClosure K with hL
  have hfix₁ : frobTwistGL Tag.E8 L (ringChar K) e (m₁ * canonicalRep (coxeterSystem Tag.E8) L x₁)
      (t₁ * canonicalRep (coxeterSystem Tag.E8) L ω₁) =
        t₁ * canonicalRep (coxeterSystem Tag.E8) L ω₁ := by
    rw [frobTwistGL_apply]
    exact conj_frob_eq_of_frame (entrywiseFrobGL Tag.E8 L (ringChar K) e) hz₁ hν₁ hc
  obtain ⟨t₂, ht₂, hconj, ha⟩ := exists_frob_conj_monomial (ringChar K) e ht₁ hfix₁
  have hw₂3 : (x₁ * ω₁ * x₁⁻¹) ^ 3 = 1 := by rw [conj_pow, hω₁3, mul_one, mul_inv_cancel]
  obtain ⟨y, hy, t, ht, w, hwS, hm, hc'⟩ := exists_closedIdentityComponent_mul_monomial a hm₁
    ht₁ ht₂ hω₁pos ((hx₁pos.mul hω₁pos).mul hx₁pos.inv) hω₁3 hw₂3 hconj
  obtain ⟨t', ht', hν', hfix', hσw, hσK⟩ :=
    exists_monomial_twist (ringChar K) e a hwS hx₁ ht ht₁ hm hc' ha
  have hz3₁ : (t₁ * canonicalRep (coxeterSystem Tag.E8) L ω₁) ^ 3 = 1 := by
    have h : g₁ * (t₁ * canonicalRep (coxeterSystem Tag.E8) L ω₁) ^ 3 * g₁⁻¹ = 1 := by
      rw [← conj_pow, hz₁, ← map_pow, ← Subgroup.coe_pow, hz3, Subgroup.coe_one, map_one]
    exact conj_eq_one_iff.1 h
  have hzK : ∀ γ ∈ familyKernel a, ω₁ • γ ∈ familyKernel a :=
    fun γ hγ => smul_mem_of_image_eq (image_familyKernel hω₁S) hγ
  obtain ⟨n₀, hn₀, μ, hμ⟩ := exists_conj_frobTwist_orbitNorm a (ringChar K) e ht₁ hz3₁ hzK hdK
    hdo ht' hσK hσw hfix' htrans
  have hS := frobTwistGL_mem_familyGroup_inf_centralizer (ringChar K) e a hm₁ hx₁ hfix₁
  rw [hν'] at hS hν₁
  exact normalizesRGroup_of_twisted_curve (Or.inr rfl) hK3 he hcard hz3 hE hPz a hg₁ hz₁ hν₁ hP
    hS hy hn₀ (fun c => orbitNorm (t₁ * canonicalRep (coxeterSystem Tag.E8) L ω₁)
      (pinnedX Tag.E8 L d c))
    (fun c => orbitNorm_mem_closedIdentityComponent a ht₁ hz3₁ hzK hdK hdo
      (LangTorus.pinnedX_mem_rootRankOneGroup hdK.1 (Or.inl rfl) c))
    (fun c hc0 => orbitNorm_pinnedX_ne_one ht₁ hdK.1 hdo hc0)
    (fun c => orbitNorm_pinnedX_pow_char (ringChar K) ht₁ hdK.1 hdo c) μ hμ

theorem e8NonToralD4Core_holds : E8NonToralD4Core := by
  intro K _ _ hK3 E₀ hE₀ hc _ _ P hPE hPc D z hz hzP F _ hD4
  obtain ⟨g₁, t₁, m₁, ω₁, x₁, hg₁, hz₁, hν₁, ht₁, hm₁, hx₁, hx₁pos, hω₁3, hω₁S, hω₁pos, hD4₁,
    hP⟩ := exists_posStable_frame F hD4
  obtain ⟨d, hdK, hdo⟩ := hD4₁.2.2.2
  exact normalizesRGroup_of_posStable_frame hK3 (hE₀.2 z hz)
    (le_sup_zpowers_of_card hc hPE hPc hz hzP)
    (fun q hq => congrArg Subtype.val (hE₀.1.is_comm.comm ⟨z, hz⟩ ⟨q, hPE hq⟩)) F.a D.Fr D.hFr
    hg₁ hz₁ hν₁ ht₁ hm₁ hx₁ hx₁pos hω₁3 hω₁S hω₁pos hP hdK hdo
    (fun β hβ hβo => e8D4_tripleRefl_transitive hD4₁ hdK hdo hβ hβo)

