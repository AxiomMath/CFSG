section Unitary

private theorem twJ27_not_p1ThreeLieList (Q : TauCeti.PrimePower) (hQ2 : Q.card ≠ 2) :
    ¬ P1ThreeLieList 3 (twistedA5Index Q) := by
  have h1 : ¬ (Q.p = 2 ∧ Q.exponent = 1) := fun h =>
    hQ2 (by rw [TauCeti.PrimePower.card_def, h.1, h.2]; norm_num)
  unfold P1ThreeLieList
  rintro (⟨n, q', hq', -⟩ | ⟨q', -, hq'⟩ | ⟨-, m, hm⟩ | ⟨q', ⟨-, -, hq'⟩ | ⟨-, -, -, hq'⟩⟩ | hch)
  · cases hq'
  · injection hq' with h
    omega
  · cases hm
  · cases hq'
  · injection hq' with h
    omega
  · unfold IsP1ChevTwoIndex at hch
    rcases hch with ⟨-, q', hq'p, hq'e, h | h | h | h | h | h | h | h⟩ |
      ⟨-, q', -, -, h | h | h | h⟩ | ⟨h5, -⟩
    all_goals first
      | omega
      | (cases h <;> exact h1 ⟨hq'p, hq'e⟩)
      | cases h

private theorem twJ27_seitzGoodIndex (Q : TauCeti.PrimePower) (hQ2 : Q.card ≠ 2) :
    SeitzGoodIndex 3 (twistedA5Index Q).1 := by
  have h1 : ¬ IsTwoPow Q 1 := fun h =>
    hQ2 (by rw [TauCeti.PrimePower.card_def, h.1, h.2]; norm_num)
  by_cases h8 : IsTwoPow Q 3
  · exact Or.inr (Or.inr (Or.inr ⟨h8, Or.inr rfl⟩))
  · left
    rintro (⟨-, ⟨h, h6⟩ | ⟨h, -⟩⟩ | ⟨-, h | h | h | h | h⟩)
    · exact h6 (by norm_num)
    · exact h1 h
    · exact h
    · obtain ⟨-, n, hn, hn'⟩ := h
      omega
    · exact h
    · exact h
    · rcases h with h | h | ⟨h, -⟩
      · exact h
      · exact h
      · exact h8 h

private theorem twJ27_hyperGen_psu6 {Q : TauCeti.PrimePower} (hQ3 : Q.p ≠ 3) (hQ2 : Q.card ≠ 2)
    {E₀ : Subgroup (Cat (twistedA5Index Q))} (hE₀ : IsElemAbelian 3 E₀)
    (hc : Nat.card E₀ = 3 ^ 3) : HyperGen 3 (⊤ : Subgroup (Cat (twistedA5Index Q))) E₀ := by
  have hchar : (3 : ℕ) ≠ (twistedA5Index Q).1.characteristic := by
    rw [show (twistedA5Index Q).1 = .twistedA 5 Q from rfl,
      TauCeti.LieTypeIndex.characteristic_twistedA]
    exact Ne.symm hQ3
  have hlist := twJ27_not_p1ThreeLieList Q hQ2
  have h3 : ¬ 3 ∣ Q.card := by
    rw [TauCeti.PrimePower.card_def]
    intro h
    exact hQ3 ((Nat.prime_dvd_prime_iff_eq Nat.prime_three Q.prime_p).1
      (Nat.prime_three.dvd_of_dvd_pow h)).symm
  rcases (show 3 ∣ Q.card - 1 ∨ 3 ∣ Q.card + 1 by omega) with h | h
  · exact seitzHyperLie_unitary_split _ 3 Nat.prime_three (by norm_num) hchar hlist E₀ hE₀ hc
      ⟨5, Q, rfl, h⟩
  · by_cases hred : UReducible (twistedA5Index Q) 3 E₀
    · exact seitzHyperLie_unitaryReducible _ 3 Nat.prime_three (by norm_num) hchar hlist E₀ hE₀
        hc hred
    · exact seitzGoodInnerUnitary_of_nonDiag
        (seitzGoodInnerUnitaryNonDiag_of_nonabRest seitzGoodInnerUnitaryNonabRest) _ 3
        Nat.prime_three (by norm_num) hchar hlist E₀ hE₀ hc
        ⟨⟨5, Q, rfl, h, Or.inr (Nat.dvd_gcd (by norm_num) h)⟩, hred, twJ27_seitzGoodIndex Q hQ2⟩

end Unitary

section Cover

private theorem twJ27_hyperGen_map_subtype {p : ℕ} {Y : Type*} [Group Y] {K : Subgroup Y}
    {E : Subgroup K} (h : HyperGen p (⊤ : Subgroup K) E) : HyperGen p K (E.map K.subtype) := by
  intro y hy
  have hmem := h (Subgroup.mem_top (⟨y, hy⟩ : K))
  have hle : (Subgroup.closure {k : K | k ∈ (⊤ : Subgroup K) ∧ ∃ F : Subgroup K, F ≤ E ∧
      F.relIndex E = p ∧ ∀ f ∈ F, f * k = k * f}).map K.subtype ≤
      Subgroup.closure {k : Y | k ∈ K ∧ ∃ F : Subgroup Y, F ≤ E.map K.subtype ∧
        F.relIndex (E.map K.subtype) = p ∧ ∀ f ∈ F, f * k = k * f} := by
    rw [MonoidHom.map_closure]
    refine Subgroup.closure_mono ?_
    rintro _ ⟨k, ⟨-, F, hFE, hFi, hF⟩, rfl⟩
    refine ⟨k.2, F.map K.subtype, Subgroup.map_mono hFE, ?_, ?_⟩
    · rw [Subgroup.relIndex_map_map_of_injective _ _ K.subtype_injective]
      exact hFi
    · rintro _ ⟨f, hf, rfl⟩
      exact congrArg Subtype.val (hF f hf)
  exact hle ⟨⟨y, hy⟩, hmem, rfl⟩

private theorem twJ27_hyperGen_of_cover {G : Type*} [Group G] {J : Subgroup G}
    {Q : TauCeti.PrimePower} (hJ : IsPSU6Cover J Q) (hQ3 : Q.p ≠ 3) (hQ2 : Q.card ≠ 2)
    {E : Subgroup G} (hEJ : E ≤ J) (hE : IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 3) :
    HyperGen 3 J E := by
  obtain ⟨hperf, hZ, ⟨φ⟩⟩ := hJ
  haveI : Group.IsPerfect J := ⟨by
    rw [commutator_def]
    apply Subgroup.map_injective J.subtype_injective
    rw [Subgroup.map_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact hperf⟩
  set ρ : J →* Cat (twistedA5Index Q) :=
    φ.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center J))
  have hρs : Function.Surjective ρ := φ.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : ρ.ker = Subgroup.center J := by
    ext k
    rw [MonoidHom.mem_ker]
    change φ (QuotientGroup.mk' (Subgroup.center J) k) = 1 ↔ _
    rw [MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  have hcop : (Nat.card ρ.ker).Coprime 3 := by
    rw [hker]
    exact hZ
  set E' : Subgroup J := E.subgroupOf J with hE'
  have hexp : ∀ x ∈ E', x ^ 3 = 1 := fun x hx =>
    Subtype.ext (by simpa using hE.2 _ (Subgroup.mem_subgroupOf.1 hx))
  have hinj : ∀ x ∈ E', ρ x = 1 → x = 1 := by
    intro x hx h1
    have hord : orderOf x ∣ Nat.card ρ.ker := by
      have h2 := orderOf_dvd_natCard (⟨x, MonoidHom.mem_ker.2 h1⟩ : ρ.ker)
      rwa [Subgroup.orderOf_mk] at h2
    have h2 := Nat.dvd_gcd hord (orderOf_dvd_of_pow_eq_one (hexp x hx))
    rwa [hcop.gcd_eq_one, Nat.dvd_one, orderOf_eq_one_iff] at h2
  have hinj' : Function.Injective (ρ.comp E'.subtype) := by
    rw [injective_iff_map_eq_one]
    intro x hx
    exact Subtype.ext (hinj x x.2 hx)
  have hrange : (ρ.comp E'.subtype).range = E'.map ρ := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hE₀c : Nat.card (E'.map ρ) = 3 ^ 3 := by
    rw [← hrange, ← hcard, ← Nat.card_congr (Subgroup.subgroupOfEquivOfLe hEJ).toEquiv]
    exact (Nat.card_congr (MonoidHom.ofInjective hinj').toEquiv).symm
  have hE₀ : IsElemAbelian 3 (E'.map ρ) := by
    refine ⟨⟨⟨fun a b => ?_⟩⟩, ?_⟩
    · obtain ⟨x, hx, hxa⟩ := Subgroup.mem_map.1 a.2
      obtain ⟨y, hy, hyb⟩ := Subgroup.mem_map.1 b.2
      have hxy : x * y = y * x := by
        apply Subtype.ext
        have := hE.1.is_comm.comm (⟨(x : G), Subgroup.mem_subgroupOf.1 hx⟩ : E)
          ⟨(y : G), Subgroup.mem_subgroupOf.1 hy⟩
        simpa using congrArg Subtype.val this
      apply Subtype.ext
      change (a : Cat (twistedA5Index Q)) * b = b * a
      rw [← hxa, ← hyb, ← map_mul, ← map_mul, hxy]
    · rintro _ ⟨x, hx, rfl⟩
      rw [← map_pow, hexp x hx, map_one]
  have hJgen := hyperGen_of_map_of_coprime ρ hρs hker.le hcop hexp
    (twJ27_hyperGen_psu6 hQ3 hQ2 hE₀ hE₀c)
  have h := twJ27_hyperGen_map_subtype hJgen
  rwa [hE', Subgroup.subgroupOf_map_subtype, inf_of_le_left hEJ] at h

end Cover

section Levi


theorem hyperGen_twE6LongRootLevi (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (q : ℕ)
    (hK : Nat.card K = q ^ 2) (hσ : ∀ c, σ c = c ^ q) (hr : ringChar K ≠ 3) (hq2 : q ≠ 2)
    {X Xm : Subgroup (twistedE6RootGroup K σ)} (hpair : IsTwE6LongRootPair K σ X Xm)
    {E : Subgroup (twistedE6RootGroup K σ)} (hEJ : E ≤ twE6LongRootLevi X Xm)
    (hE : IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 3) :
    HyperGen 3 (twE6LongRootLevi X Xm) E := by
  have hK1 : 1 < Nat.card K := Finite.one_lt_card
  have hq2' : 2 ≤ q := by
    by_contra h
    push Not at h
    interval_cases q <;> norm_num at hK <;> omega
  obtain ⟨hpr, f, hf1, hqf⟩ := twE6_exists_pow_ringChar_of_card_sq K q hK hq2'
  let Q : TauCeti.PrimePower := ⟨ringChar K, f, hpr, hf1⟩
  have hQcard : Q.card = q := by
    rw [TauCeti.PrimePower.card_def]
    exact hqf.symm
  have hJ : IsPSU6Cover (twE6LongRootLevi X Xm) Q := by
    have h0 := twE6LeviCatalogue_holds K σ q hr hσ hK Q hQcard
    obtain ⟨g, hX, hXm⟩ := hpair
    rw [hX, hXm, twE6LongRootLevi_map]
    exact IsPSU6Cover.of_mulEquiv ((MulAut.conj g).subgroupMap _) h0
  have hQ2 : Q.card ≠ 2 := by
    rw [hQcard]
    exact hq2
  exact twJ27_hyperGen_of_cover hJ hr hQ2 hEJ hE hcard

end Levi

