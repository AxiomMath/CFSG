theorem twE6NegDatum_hyperGen (q : ℕ) (K : Type) [Field K] [Finite K] (σ : K ≃+* K)
    (hK : Nat.card K = q ^ 2) (hσ : ∀ c : K, σ c = c ^ q) (hq : q % 3 = 2) (hq2 : q ≠ 2)
    (E₀ : Subgroup (twistedE6RootGroup K σ)) (hE₀ : IsElemAbelian 3 E₀)
    (hcard : Nat.card E₀ = 3 ^ 3) (hNR : ¬ NormalizesRGroup (ringChar K) E₀)
    (Fr : AlgebraicClosure K →+* AlgebraicClosure K) (hFr : ∀ c, Fr c = c ^ q)
    (v : WeylGroup TwistTag.E6.tag) (g0 : ModGL TwistTag.E6.tag (AlgebraicClosure K))
    (hg0C : g0 ∈ adjointGroup TwistTag.E6.tag (AlgebraicClosure K))
    (hg0 : twistHom TwistTag.E6 (AlgebraicClosure K) Fr g0 =
      g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) (AlgebraicClosure K) v)
    (hT : ∀ x ∈ E₀,
      baseChangeGL (algebraMap K (AlgebraicClosure K)) (x : ModGL TwistTag.E6.tag K) ∈
        (twistedTorusOf (canonicalRep (coxeterSystem TwistTag.E6.tag) (AlgebraicClosure K) v)
          (twistHom TwistTag.E6 (AlgebraicClosure K) Fr)).map (MulAut.conj g0).toMonoidHom)
    (hv : ∀ γ : Fin TwistTag.E6.tag.rank → ℤ, v • permLattice TwistTag.E6.perm γ = -γ) :
    HyperGen 3 ⊤ E₀ := by
  classical
  have hr : ringChar K ≠ 3 := by
    intro h3
    have : Fintype K := Fintype.ofFinite K
    have : CharP K (ringChar K) := ringChar.charP K
    obtain ⟨n, -, hn⟩ := FiniteField.card K (ringChar K)
    have h1 : 3 ∣ q ^ 2 := by
      rw [← hK, Nat.card_eq_fintype_card, hn, h3]
      exact dvd_pow_self 3 n.ne_zero
    have h2 : 3 ∣ q := Nat.prime_three.dvd_of_dvd_pow h1
    omega
  have hreg : ∀ α : Fin TwistTag.E6.tag.rank → ℤ, IsRoot TwistTag.E6.tag α →
      ¬ TwKills K σ E₀ g0 α := fun α hα hk =>
    hNR (normalizesRGroup_of_twKills q K σ hK hσ hr E₀ Fr hFr v g0 hg0C hg0 hT hα hk)
  obtain ⟨θ, hθ, hES, X, Xm, hpair, hS, R, hRQ, hRH, hRX⟩ :=
    ExcWideThree.exists_radical_of_negDatum q K σ hK hσ hr E₀ hE₀ hcard Fr hFr v g0 hg0C hg0 hT
      hv hreg
  have hSH := longRootSL2_le_hyperClosure hE₀ hcard hT hθ hS
  obtain ⟨φ, hφ, hφJ, hφc⟩ :=
    exists_levi_cube_of_negDatum q K σ hK hσ hq E₀ hE₀ hcard Fr hFr v g0 hg0C hg0 hT hv hθ hES
      hpair hS
  exact hyperGen_of_levi_cube K σ q hK hσ hr hq2 hE₀ hcard hpair hSH hRQ hRH hRX φ hφ hφJ hφc

