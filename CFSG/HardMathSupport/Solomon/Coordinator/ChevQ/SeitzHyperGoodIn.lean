section InnerAut

variable {S : Type} [Group S]

theorem conj_injective_of_center_bot (hZ : Subgroup.center S = ⊥) :
    Function.Injective (MulAut.conj : S →* MulAut S) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro x hx
  rw [MonoidHom.mem_ker] at hx
  have hxz : x ∈ Subgroup.center S := by
    rw [Subgroup.mem_center_iff]
    intro g
    have h := congrArg (fun φ : MulAut S => φ g) hx
    simp only [MulAut.conj_apply, MulAut.one_apply] at h
    exact (mul_inv_eq_iff_eq_mul.1 h).symm
  rwa [hZ] at hxz

theorem mulAut_mul_conj_mul_inv (φ : MulAut S) (t : S) :
    φ * MulAut.conj t * φ⁻¹ = MulAut.conj (φ t) := by
  ext x
  simp [MulAut.conj_apply]

theorem centralizer_conj_range_eq_bot (hZ : Subgroup.center S = ⊥) :
    Subgroup.centralizer ((MulAut.conj : S →* MulAut S).range : Set (MulAut S)) = ⊥ := by
  rw [eq_bot_iff]
  intro φ hφ
  rw [Subgroup.mem_bot]
  have hinv : ∀ s : S, φ s = s := by
    intro s
    have h1 := Subgroup.mem_centralizer_iff.1 hφ (MulAut.conj s) ⟨s, rfl⟩
    have ht : (φ s)⁻¹ * s ∈ Subgroup.center S := by
      rw [Subgroup.mem_center_iff]
      intro y
      obtain ⟨x, rfl⟩ := φ.surjective y
      have h2 := congrArg (fun ψ : MulAut S => ψ x) h1
      simp only [MulAut.mul_apply, MulAut.conj_apply, map_mul, map_inv] at h2
      calc φ x * ((φ s)⁻¹ * s) = (φ s)⁻¹ * (φ s * φ x * (φ s)⁻¹) * s := by group
        _ = (φ s)⁻¹ * (s * φ x * s⁻¹) * s := by rw [h2]
        _ = (φ s)⁻¹ * s * φ x := by group
    rw [hZ, Subgroup.mem_bot, inv_mul_eq_one] at ht
    exact ht
  ext s
  exact hinv s

theorem isElemAbelian_comap_of_injective {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) {p : ℕ} {F : Subgroup H} (hF : IsElemAbelian p F) :
    IsElemAbelian p (F.comap f) := by
  refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
  · apply Subtype.ext
    apply hf
    rw [Subgroup.coe_mul, Subgroup.coe_mul, map_mul, map_mul]
    exact congrArg Subtype.val (hF.1.is_comm.comm ⟨_, a.2⟩ ⟨_, b.2⟩)
  · apply hf
    rw [map_pow, map_one]
    exact hF.2 _ hx

theorem nonempty_quot_equiv_of_center_bot {K C : Type*} [Group K] [Group C]
    (hZ : Subgroup.center K = ⊥) (e : K ≃* C) : Nonempty (K ⧸ Subgroup.center K ≃* C) :=
  ⟨((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).trans e⟩

end InnerAut

section KLevel

variable {Y : Type} [Group Y] [Finite Y]

theorem hyperGen_inner_of_simple {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hL : SeitzHyperLie fun d p _ => SeitzGoodIndex p d.1) {K E : Subgroup Y} [K.Normal]
    (d : TauCeti.ValidLieTypeIndex)
    (he : Nonempty (K ⧸ Subgroup.center K ≃* (TauCeti.CFSGIndex.lie d).Group))
    (hpd : p ≠ d.1.characteristic) (hlist : ¬ P1ThreeLieList p d)
    (hEa : IsElemAbelian p E) (hEc : Nat.card E = p ^ 3)
    (hker : ∀ c ∈ E ⊓ Subgroup.centralizer (K : Set Y), orderOf c = p →
      c ∈ (Subgroup.center K).map K.subtype)
    (hin : E ≤ K ⊔ Subgroup.centralizer (K : Set Y)) (hz : ¬ p ∣ Nat.card (Subgroup.center K))
    (hgood : SeitzGoodIndex p d.1) : HyperGen p K E := by
  obtain ⟨e⟩ := he
  let ρ : K →* Cat d := (e : K ⧸ Subgroup.center K →* Cat d).comp
    (QuotientGroup.mk' (Subgroup.center K))
  have hρs : Function.Surjective ρ := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hρk : ∀ k : K, ρ k = 1 ↔ k ∈ Subgroup.center K := by
    intro k
    change e (QuotientGroup.mk' (Subgroup.center K) k) = 1 ↔ _
    rw [MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  obtain ⟨ψ, hψi, hψs⟩ := exists_quotientMap hp ρ hρk hz hEa.2 hker hin
  have hE₀ : IsElemAbelian p ψ.range := by
    refine ⟨⟨⟨fun a b => ?_⟩⟩, ?_⟩
    · obtain ⟨x, hx⟩ := a.2
      obtain ⟨y, hy⟩ := b.2
      apply Subtype.ext
      show (a : Cat d) * b = b * a
      rw [← hx, ← hy, ← map_mul, ← map_mul, hEa.1.is_comm.comm x y]
    · rintro _ ⟨x, rfl⟩
      rw [← map_pow]
      have : x ^ p = 1 := Subtype.ext (hEa.2 x x.2)
      rw [this, map_one]
  have hcard : Nat.card ψ.range = p ^ 3 :=
    (Nat.card_congr (MonoidHom.ofInjective hψi).toEquiv).symm.trans hEc
  exact hyperGen_of_quotientMap hp ρ hρs hρk hz hEa.2 hEc hin ψ hψs
    (hL d p hp hp2 hpd hlist ψ.range hE₀ hcard hgood)

end KLevel

section SLevel

variable {S : Type} [Group S]

theorem seitzHyperGamma_eq_top_of_hyperGen_inn (hZ : Subgroup.center S = ⊥) (p : ℕ)
    {E : Subgroup (MulAut S)} (h : HyperGen p (MulAut.conj : S →* MulAut S).range E) :
    seitzHyperGamma p E = ⊤ := by
  have hinj := conj_injective_of_center_bot hZ
  rw [← closure_eq_seitzHyperGamma, eq_top_iff]
  intro s _
  have hle : Subgroup.closure {k : MulAut S | k ∈ (MulAut.conj : S →* MulAut S).range ∧
      ∃ F : Subgroup (MulAut S), F ≤ E ∧ F.relIndex E = p ∧ ∀ f ∈ F, f * k = k * f} ≤
      (Subgroup.closure {s : S | ∃ F ≤ E, F.relIndex E = p ∧ ∀ f ∈ F, f s = s}).map
        (MulAut.conj : S →* MulAut S) := by
    rw [Subgroup.closure_le]
    rintro k ⟨⟨t, rfl⟩, F, hFE, hrel, hcomm⟩
    refine ⟨t, Subgroup.subset_closure ⟨F, hFE, hrel, fun f hf => ?_⟩, rfl⟩
    have h1 := hcomm f hf
    have h2 : MulAut.conj (f t) = MulAut.conj t := by
      rw [← mulAut_mul_conj_mul_inv, h1]
      group
    exact hinj h2
  obtain ⟨y, hy, hys⟩ := hle (h ⟨s, rfl⟩)
  exact hinj hys ▸ hy

variable [Finite S]

theorem inn_data (hs : IsSimpleGroup S) (hnab : ∃ a b : S, a * b ≠ b * a) {C : Type}
    [Group C] (e : S ≃* C) :
    CFSG.Open.IsQuasisimple (MulAut.conj : S →* MulAut S).range ∧
      Subgroup.center (MulAut.conj : S →* MulAut S).range = ⊥ ∧
      Nonempty (↥(MulAut.conj : S →* MulAut S).range ⧸
        Subgroup.center (MulAut.conj : S →* MulAut S).range ≃* C) := by
  have hZ := center_eq_bot_of_simple hs hnab
  have hinj := conj_injective_of_center_bot hZ
  let ε : S ≃* (MulAut.conj : S →* MulAut S).range := MonoidHom.ofInjective hinj
  have hc : Subgroup.center (MulAut.conj : S →* MulAut S).range = ⊥ := by
    have h := Subgroup.map_center_eq ε
    rw [hZ, Subgroup.map_bot] at h
    exact h.symm
  exact ⟨CFSG.Open.IsQuasisimple.of_mulEquiv ε.symm (isQuasisimple_of_simple hs hnab), hc,
    nonempty_quot_equiv_of_center_bot hc (ε.symm.trans e)⟩

theorem seitzHyperGamma_eq_top_of_inner (hL : SeitzHyperLie fun d p _ => SeitzGoodIndex p d.1)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hs : IsSimpleGroup S)
    (hnab : ∃ a b : S, a * b ≠ b * a) (d : TauCeti.ValidLieTypeIndex)
    (e : S ≃* (TauCeti.CFSGIndex.lie d).Group) (hpd : p ≠ d.1.characteristic)
    (hlist : ¬ P1ThreeLieList p d) (hgood : SeitzGoodIndex p d.1) {E : Subgroup (MulAut S)}
    (hE : IsElemAbelian p E) (hcard : Nat.card E = p ^ 3)
    (hinn : E ≤ (MulAut.conj : S →* MulAut S).range) : seitzHyperGamma p E = ⊤ := by
  have hZ := center_eq_bot_of_simple hs hnab
  obtain ⟨-, hc, he⟩ := inn_data hs hnab e
  haveI : (MulAut.conj : S →* MulAut S).range.Normal := inferInstance
  refine seitzHyperGamma_eq_top_of_hyperGen_inn hZ p ?_
  refine hyperGen_inner_of_simple hp hp2 hL d he hpd hlist hE hcard ?_ (le_sup_of_le_left hinn)
    (by rw [hc, Subgroup.card_bot]; exact hp.not_dvd_one) hgood
  intro c hc' hco
  rw [centralizer_conj_range_eq_bot hZ] at hc'
  have : c = 1 := Subgroup.mem_bot.1 hc'.2
  rw [this, orderOf_one] at hco
  exact absurd hco hp.one_lt.ne

end SLevel

@[expose] def OuterSimple : Prop :=
  ∀ (p : ℕ), p.Prime → p ≠ 2 → ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S →
    (∃ a b : S, a * b ≠ b * a) → ∀ d : TauCeti.ValidLieTypeIndex,
    Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) → p ≠ d.1.characteristic →
    ¬ P1ThreeLieList p d → ¬ ExcIndex p d.1 →
    ¬ (p = 3 ∧ ∃ q : TauCeti.PrimePower, q.p = 2 ∧ q.exponent = 2 ∧ d.1 = .A 2 q) →
    ∀ E : Subgroup (MulAut S), IsElemAbelian p E → Nat.card E = p ^ 3 →
      ¬ E ≤ (MulAut.conj : S →* MulAut S).range → seitzHyperGamma p E = ⊤

theorem outerSimple_of_inputs (hC1 : KFactSeitzOuterCubeRankTwo)
    (hC2c : SeitzGoodOuterHighClassical) (hC2e : SeitzGoodOuterHighExceptional) : OuterSimple := by
  intro p hp hp2 S _ _ hs hnab d he hpd hlist hexc hL E hE hcard hout
  by_cases hcube : ∃ F : Subgroup S, IsElemAbelian p F ∧ Nat.card F = p ^ 3
  · by_cases hc : IsClassicalIndex d.1
    · exact hC2c p hp hp2 S hs hnab d hc he hpd hlist hexc hL hcube E hE hcard hout
    · exact hC2e p hp hp2 S hs hnab d hc he hpd hlist hexc hL hcube E hE hcard hout
  · haveI : Fact p.Prime := ⟨hp⟩
    have hZ := center_eq_bot_of_simple hs hnab
    have hinj := conj_injective_of_center_bot hZ
    obtain ⟨e⟩ := he
    let ε : S ≃* (MulAut.conj : S →* MulAut S).range := MonoidHom.ofInjective hinj
    have hHG := hC1 p hp2 (MulAut S) (MulAut.conj : S →* MulAut S).range inferInstance
      (centralizer_conj_range_eq_bot hZ) d ⟨ε.symm.trans e⟩ hpd hlist ?_ E hE hcard
    · exact seitzHyperGamma_eq_top_of_hyperGen_inn hZ p hHG
    · rintro ⟨F, hFK, hFa, hFc⟩
      refine hcube ⟨F.comap (MulAut.conj : S →* MulAut S),
        isElemAbelian_comap_of_injective _ hinj hFa, ?_⟩
      have h1 := Subgroup.card_map_of_injective (K := F.comap (MulAut.conj : S →* MulAut S)) hinj
      rw [Subgroup.map_comap_eq_self hFK] at h1
      rw [← h1]
      exact hFc

theorem seitzGoodSimple_of_regimes (hI : SeitzHyperLie fun d p _ => SeitzGoodIndex p d.1)
    (hOut : OuterSimple) : SeitzGoodSimple := by
  intro p hp hp2 S _ _ hs hnab d he hpd hlist hL E hE hcard hex
  by_cases hinn : E ≤ (MulAut.conj : S →* MulAut S).range
  · obtain ⟨e⟩ := he
    have hgood : SeitzGoodIndex p d.1 := hex.imp_right And.left
    exact seitzHyperGamma_eq_top_of_inner hI hp hp2 hs hnab d e hpd hlist hgood hE hcard hinn
  · have hexc : ¬ ExcIndex p d.1 := hex.resolve_right (fun h => hinn h.2)
    exact hOut p hp hp2 S hs hnab d he hpd hlist hexc hL E hE hcard hinn

end CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.SeitzHyperGoodInAux

