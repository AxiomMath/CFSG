theorem no_cube_G2 {d : TauCeti.ValidLieTypeIndex} (hd : IsG2Index d.1) {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hpd : p ≠ d.1.characteristic) {E₀ : Subgroup (Cat d)}
    (hE₀ : IsElemAbelian p E₀) (hc₀ : Nat.card E₀ = p ^ 3) : False := by
  obtain ⟨d, hv⟩ := d
  obtain ⟨q, rfl⟩ := hd
  have hpq : p ≠ q.p := by simpa using hpd
  rcases eq_three_or_five_le hp hp2 with rfl | hp5
  · exact false_of_rankLE2_of_card hp
      (CFSG.HardMathSupport.Seitz.G2Anisotropic.Coordinator.rankLE2_three_cat_G2 q hv hpq)
      hE₀ hc₀
  · obtain ⟨K, _, _, hK, -, ⟨e⟩⟩ := exists_catEquiv_adjointGroup Even.chevalleyBridgesAll.g2 q hv
    have hpK : ¬ p ∣ Nat.card K := by
      rw [hK]
      exact not_dvd_card_of_ne hp hpq
    exact false_of_rankLE2_of_card hp
      (RankLE2.of_injective e.toMonoidHom e.injective (rankLE2_adjointGroup_G2 K hp hp5 hpK))
      hE₀ hc₀

theorem no_cube_triality {d : TauCeti.ValidLieTypeIndex} (hd : IsTrialityIndex d.1) {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hpd : p ≠ d.1.characteristic) {E₀ : Subgroup (Cat d)}
    (hE₀ : IsElemAbelian p E₀) (hc₀ : Nat.card E₀ = p ^ 3) : False := by
  obtain ⟨d, hv⟩ := d
  obtain ⟨q, rfl⟩ := hd
  have hpq : p ≠ q.p := by simpa using hpd
  rcases eq_three_or_five_le hp hp2 with rfl | hp5
  · exact false_of_rankLE2_of_card hp
      (CFSG.HardMathSupport.Timmesfeld.CrossChar.rankLE2_three_cat_trialityD4 q hv hpq.symm)
      hE₀ hc₀
  · exact false_of_rankLE2_of_card hp
      (CFSG.HardMathSupport.Timmesfeld.CrossChar.rankLE2_cat_trialityD4 q hv hp hp5 hpq) hE₀ hc₀

theorem no_cube_reeType {d : TauCeti.ValidLieTypeIndex} (hd : IsReeTypeIndex d.1) {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hpd : p ≠ d.1.characteristic) {E₀ : Subgroup (Cat d)}
    (hE₀ : IsElemAbelian p E₀) (hc₀ : Nat.card E₀ = p ^ 3) : False := by
  obtain ⟨d, hv⟩ := d
  rcases hd with ⟨m, rfl⟩ | ⟨m, rfl⟩ | ⟨m, rfl⟩ | rfl
  · exact false_of_rankLE2_of_card hp (rankLE2_cat_suzuki hv hp hp2) hE₀ hc₀
  · have hp3 : p ≠ 3 := by simpa using hpd
    exact false_of_rankLE2_of_card hp (rankLE2_cat_reeG2 hv hp hp2 hp3) hE₀ hc₀
  · by_cases hp3 : p = 3
    · subst hp3
      exact false_of_rankLE2_of_card hp
        (CFSG.HardMathSupport.Timmesfeld.CrossChar.rankLE2_three_cat_reeF4 hv) hE₀ hc₀
    · have hp5 : 5 ≤ p := (eq_three_or_five_le hp hp2).resolve_left hp3
      exact false_of_rankLE2_of_card hp (rankLE2_cat_reeF4_five hv hp hp5) hE₀ hc₀
  · by_cases hp3 : p = 3
    · subst hp3
      exact CFSG.HardMathSupport.Timmesfeld.CrossChar.no_elemAbelian27_cat_tits hv hE₀
        (by rw [hc₀]; norm_num)
    · exact false_of_cube_tits hv hp hp2 hp3 hc₀

theorem seitzGoodInnerExcAll_of_top (hE : SeitzGoodInnerExc) : SeitzGoodInnerExcAll := by
  intro d p hp hp2 hpd hlist E₀ hE₀ hcard ⟨hnc, hgood⟩
  have hE1 : E₀ ≠ ⊥ := by
    intro h0
    rw [h0, Subgroup.card_bot] at hcard
    exact absurd hcard.symm (Nat.one_lt_pow (by norm_num) hp.one_lt).ne'
  rcases (not_isClassicalIndex_iff d.1).1 hnc with hch | hree
  · by_cases hNR : NormalizesRSub d E₀
    · rcases hch with hu | ht
      · exact seitzExcParabolicHyperUntw d p hp hpd hu E₀ hE₀ hE1 hNR
      · exact seitzExcParabolicHyperTw d p hp hpd ht E₀ hE₀ hE1 hNR
    · by_cases htop : IsTopIndex d.1
      · exact hE d p hp hp2 hpd hlist E₀ hE₀ hcard ⟨htop, hNR, hgood⟩
      · exfalso
        rcases hch with (hg2 | hf4 | he6 | he7 | he8) | (htri | htw)
        · exact no_cube_G2 hg2 hp hp2 hpd hE₀ hcard
        · exact htop (Or.inl hf4)
        · exact htop (Or.inr (Or.inl he6))
        · exact htop (Or.inr (Or.inr (Or.inl he7)))
        · exact htop (Or.inr (Or.inr (Or.inr (Or.inl he8))))
        · exact no_cube_triality htri hp hp2 hpd hE₀ hcard
        · exact htop (Or.inr (Or.inr (Or.inr (Or.inr htw))))
  · exfalso
    exact no_cube_reeType hree hp hp2 hpd hE₀ hcard

