@[expose] def SeitzGoodIndex (p : ℕ) (d : TauCeti.LieTypeIndex) : Prop :=
  ¬ ExcIndex p d ∨ IsSixIndex d

@[expose] def SeitzGoodInnerOrth : Prop :=
  SeitzHyperLie fun d p E₀ => IsOrthogonalIndex d.1 ∧ ¬ OReducible d p E₀ ∧ SeitzGoodIndex p d.1

@[expose] def SeitzGoodInnerUnitary : Prop :=
  SeitzHyperLie fun d p E₀ => UToralRestPrime d p ∧ ¬ UReducible d p E₀ ∧ SeitzGoodIndex p d.1

@[expose] def SeitzGoodInnerExc : Prop :=
  SeitzHyperLie fun d p E₀ => IsTopIndex d.1 ∧ ¬ NormalizesRSub d E₀ ∧ SeitzGoodIndex p d.1

@[expose] def SeitzGoodInnerExcAll : Prop :=
  SeitzHyperLie fun d p _ => ¬ IsClassicalIndex d.1 ∧ SeitzGoodIndex p d.1

@[expose] def SeitzGoodOuterHighFor (Fam : TauCeti.ValidLieTypeIndex → Prop) : Prop :=
  ∀ (p : ℕ), p.Prime → p ≠ 2 → ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S →
    (∃ a b : S, a * b ≠ b * a) → ∀ d : TauCeti.ValidLieTypeIndex, Fam d →
    Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) → p ≠ d.1.characteristic →
    ¬ P1ThreeLieList p d → ¬ ExcIndex p d.1 →
    ¬ (p = 3 ∧ ∃ q : TauCeti.PrimePower, q.p = 2 ∧ q.exponent = 2 ∧ d.1 = .A 2 q) →
    (∃ F : Subgroup S, IsElemAbelian p F ∧ Nat.card F = p ^ 3) →
    ∀ E : Subgroup (MulAut S), IsElemAbelian p E → Nat.card E = p ^ 3 →
      ¬ E ≤ (MulAut.conj : S →* MulAut S).range → seitzHyperGamma p E = ⊤

@[expose] def SeitzGoodOuterHighClassical : Prop :=
  SeitzGoodOuterHighFor fun d => IsClassicalIndex d.1

@[expose] def SeitzGoodOuterHighExceptional : Prop :=
  SeitzGoodOuterHighFor fun d => ¬ IsClassicalIndex d.1

@[expose] def SeitzGoodSimple : Prop :=
  ∀ (p : ℕ), p.Prime → p ≠ 2 → ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S →
    (∃ a b : S, a * b ≠ b * a) → ∀ d : TauCeti.ValidLieTypeIndex,
    Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) → p ≠ d.1.characteristic →
    ¬ P1ThreeLieList p d →
    ¬ (p = 3 ∧ ∃ q : TauCeti.PrimePower, q.p = 2 ∧ q.exponent = 2 ∧ d.1 = .A 2 q) →
    ∀ E : Subgroup (MulAut S), IsElemAbelian p E → Nat.card E = p ^ 3 →
      (¬ ExcIndex p d.1 ∨ (IsSixIndex d.1 ∧ E ≤ (MulAut.conj : S →* MulAut S).range)) →
        seitzHyperGamma p E = ⊤

