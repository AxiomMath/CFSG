  SeitzBridgeAux SeitzHyperGoodInAux

theorem seitz2310CubeSimple_of_goodSimple (hG : SeitzGoodSimple) (h3D : Seitz3D48Cube) :
    Seitz2310CubeSimple := by
  intro p hp hp2 S _ _ hs hnab d he hpd hL34 E hE hcard hex
  obtain ⟨e⟩ := he
  by_cases hP : P1ThreeLieList p d
  · obtain ⟨hp3, q, hq2, hq3, hd⟩ := p1_cases hpd hP (hex.imp_right And.left)
    subst hp3
    rcases hd with hd | hd
    · exact h3D S hs hnab d q ⟨hq2, hq3⟩ hd ⟨e⟩ E hE hcard
    · exfalso
      rcases hex with hne | ⟨-, hinn⟩
      · exact hne (by rw [hd]; simp [ExcIndex, IsSixIndex, FourIndex, IsTwoPow, hq2, hq3])
      · exact no_cube_in_inner_u38 hs hnab d q ⟨hq2, hq3⟩ hd e hE hcard hinn
  · have hL : ¬ (p = 3 ∧ ∃ q : TauCeti.PrimePower, q.p = 2 ∧ q.exponent = 2 ∧ d.1 = .A 2 q) := by
      rintro ⟨hp3, q, hq2, hq3, hd⟩
      exact hL34 ⟨hp3, isLThreeFour_of_index d q hd ⟨hq2, hq3⟩ e⟩
    exact hG p hp hp2 S hs hnab d ⟨e⟩ hpd hP hL E hE hcard hex

theorem seitzGoodSimple_of_exc_all (hO : SeitzGoodInnerOrth) (hU : SeitzGoodInnerUnitary)
    (hE : SeitzGoodInnerExcAll) (hC1 : KFactSeitzOuterCubeRankTwo)
    (hC2c : SeitzGoodOuterHighClassical) (hC2e : SeitzGoodOuterHighExceptional) :
    SeitzGoodSimple :=
  seitzGoodSimple_of_regimes (seitzHyperLie_good hO hU hE) (outerSimple_of_inputs hC1 hC2c hC2e)

theorem seitz2310CubeSimple_of_exc_all (hO : SeitzGoodInnerOrth) (hU : SeitzGoodInnerUnitary)
    (hE : SeitzGoodInnerExcAll) (hC1 : KFactSeitzOuterCubeRankTwo)
    (hC2c : SeitzGoodOuterHighClassical) (hC2e : SeitzGoodOuterHighExceptional)
    (h3D : Seitz3D48Cube) : Seitz2310CubeSimple :=
  seitz2310CubeSimple_of_goodSimple (seitzGoodSimple_of_exc_all hO hU hE hC1 hC2c hC2e) h3D

