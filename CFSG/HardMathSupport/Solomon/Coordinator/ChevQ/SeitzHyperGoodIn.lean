theorem exc_of_isSpTwoThree {d : TauCeti.ValidLieTypeIndex} {p : ℕ} (h : IsSpTwoThree d p) :
    ExcIndex p d.1 := by
  obtain ⟨d, hv⟩ := d
  obtain ⟨hp3, r, q, hq2, hq1, hd⟩ := h
  have hrange := (TauCeti.LieTypeIndex.inStandardRange_iff _).1
    ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
  subst hp3
  rcases hd with hd | hd
  · simp only at hd
    subst hd
    have hcard : q.card = 2 := by simp [TauCeti.PrimePower.card_def, hq2, hq1]
    have hr3 : 3 ≤ r := by
      have h1 := hrange.1
      have h2 := hrange.2
      by_contra hlt
      exact h2 ⟨by omega, hcard⟩
    exact Or.inl (by simp [Bal207Index, IsTwoPow, hq2, hq1, hr3])
  · simp only at hd
    subst hd
    exact absurd hq2 hrange.2

theorem not_isSixIndex_of_symplectic {d : TauCeti.LieTypeIndex} (h : IsSymplecticIndex d) :
    ¬ IsSixIndex d := by
  rcases h with ⟨q, rfl⟩ | ⟨r, q, rfl, -, -⟩ | ⟨r, q, rfl⟩ <;>
    simp [IsSixIndex, IsF4EightIndex, IsD4FourIndex, FourIndex]

theorem exc_of_twistedA_card_two {m : ℕ} {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.twistedA m q).Valid) (hq : q.card = 2) :
    ExcIndex 3 (.twistedA m q) := by
  have hrange := (TauCeti.LieTypeIndex.inStandardRange_iff _).1
    ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
  have hm3 : 3 ≤ m := by
    by_contra h
    have h2 : m = 2 := by
      have := hrange.1
      omega
    have := hrange.2 h2
    omega
  have hqp : q.p = 2 ∧ q.exponent = 1 :=
    (Nat.Prime.pow_eq_iff Nat.prime_two).mp (by simpa [TauCeti.PrimePower.card_def] using hq)
  have hIT : IsTwoPow q 1 := ⟨hqp.1, hqp.2⟩
  by_cases h3 : 3 ∣ m + 1
  · obtain ⟨n, hn⟩ := h3
    by_cases hn2 : n = 2
    · exact Or.inl ⟨rfl, Or.inr ⟨hIT, by omega⟩⟩
    · exact Or.inr ⟨rfl, Or.inr (Or.inl ⟨Or.inl hIT, n, by omega, hn⟩)⟩
  · exact Or.inl ⟨rfl, Or.inl ⟨Or.inl hIT, h3⟩⟩

theorem seitzHyperLie_good (hO : SeitzGoodInnerOrth) (hU : SeitzGoodInnerUnitary)
    (hE : SeitzGoodInnerExcAll) : SeitzHyperLie fun d p _ => SeitzGoodIndex p d.1 := by
  intro d p hp hp2 hpd hlist E₀ hE₀ hcard hgood
  by_cases hc : IsClassicalIndex d.1
  · have hrange := ((TauCeti.LieTypeIndex.valid_iff _).1 d.2).1
    rcases (isClassicalIndex_iff hrange).1 hc with hl | hu | hs | ho
    · exact seitzHyperLieLinear_unconditional d p hp hp2 hpd hlist E₀ hE₀ hcard hl
    · obtain ⟨m, q, hd⟩ := hu
      by_cases hsplit : USplitPrime d p
      · exact seitzHyperLie_unitary_split d p hp hp2 hpd hlist E₀ hE₀ hcard hsplit
      by_cases hns : UNonsplitPrime d p
      · exact seitzHyperLie_unitary_nonsplit d p hp hp2 hpd hlist E₀ hE₀ hcard hns
      by_cases htor : UToralPrime d p
      · exact seitzHyperLie_unitary_toral d p hp hp2 hpd hlist E₀ hE₀ hcard htor
      have hrest : UToralRestPrime d p := by
        have h1 : ¬ p ∣ q.card - 1 := fun h => hsplit ⟨m, q, hd, h⟩
        have h2 : p ∣ q.card + 1 := by
          by_contra h
          exact hns ⟨m, q, hd, h1, h⟩
        refine ⟨m, q, hd, h2, ?_⟩
        by_contra h
        push Not at h
        exact htor ⟨m, q, hd, h2, h.1, h.2⟩
      by_cases hred : UReducible d p E₀
      · exact seitzHyperLie_unitaryReducible d p hp hp2 hpd hlist E₀ hE₀ hcard hred
      · exact hU d p hp hp2 hpd hlist E₀ hE₀ hcard ⟨hrest, hred, hgood⟩
    · have hgood' : ¬ ExcIndex p d.1 := hgood.resolve_right (not_isSixIndex_of_symplectic hs)
      have h32 : ¬ IsSpTwoThree d p := fun h => hgood' (exc_of_isSpTwoThree h)
      rcases spReducible_or_spAnisoNotTwoThree hs hp hpd h32 E₀ with hred | hani
      · exact seitzHyperLie_symplecticReducible d p hp hp2 hpd hlist E₀ hE₀ hcard hred
      · exact seitzHyperLie_spAnisoNotTwoThree d p hp hp2 hpd hlist E₀ hE₀ hcard hani
    · by_cases hred : OReducible d p E₀
      · exact seitzHyperLie_orthReducible d p hp hp2 hpd hlist E₀ hE₀ hcard hred
      · exact hO d p hp hp2 hpd hlist E₀ hE₀ hcard ⟨ho, hred, hgood⟩
  · exact hE d p hp hp2 hpd hlist E₀ hE₀ hcard ⟨hc, hgood⟩

