set_option linter.unusedSectionVars false


theorem unitary_witness {F : Type} [Field F] [Finite F] {Q f d : ℕ} (hQ : Q = 2 ^ f)
    (hF : Nat.card F = Q ^ 2) (hf : 1 ≤ f) (hd9 : 9 ≤ d) (hd3 : 3 ∣ d) (hq3 : 3 ∣ 2 ^ f + 1)
    {K : Type} [Group K] [Finite K] (hperf : commutator K = ⊤)
    (ρ : K →* StatedProj (StatedSU d Q F)) (hρ : Function.Surjective ρ)
    (hρk : ρ.ker = Subgroup.center K) :
    ∃ E P : Subgroup K, IsElemAbelian 3 E ∧ E ⊓ Subgroup.center K = ⊥ ∧
      d - 3 ≤ CFSG.Open.pRank 3 E ∧ P ≠ ⊥ ∧ IsPGroup 2 ↥P ∧
      E ≤ Subgroup.normalizer (P : Set K) := by
  subst hQ
  have hdq : (d, 2 ^ f) ≠ (3, 2) := fun h => by
    have := congrArg Prod.fst h
    simp only at this
    omega
  obtain ⟨U, E, hU0, hU2, hEU, hEab, hEcard, hEker⟩ :=
    CFSG.StandardType.ggTorusLift_unitary (K := F) (n := f) (d := d) (p := 3) hF hf (by omega) hdq
      Nat.prime_three hq3 K ρ hρ hρk.le hperf
  have hrank : CFSG.StandardType.ggUnitaryTorusRank 3 d = d - 3 := by
    simp [CFSG.StandardType.ggUnitaryTorusRank, hd3]
  rw [hrank] at hEcard
  have hEker' : E ⊓ ρ.ker = ⊥ := hEker
  refine ⟨E, U, hEab, ?_, ?_, hU0, hU2, hEU⟩
  · rw [hρk] at hEker'
    exact hEker'
  · exact (i271_pRank_eq Nat.prime_three hEab hEcard).ge

end Gen2318LocalUAux

section Main

set_option linter.unusedSectionVars false


theorem gen2318Residual_U :
    ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K → ∀ d : TauCeti.ValidLieTypeIndex,
      Gen2318Index d.1 → (∃ r q, d.1 = TauCeti.LieTypeIndex.twistedA r q) →
        Nonempty ((K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group) →
          ∃ E P : Subgroup K, IsElemAbelian 3 E ∧ E ⊓ Subgroup.center K = ⊥ ∧
            rho2318 d.1 ≤ CFSG.Open.pRank 3 E ∧ P ≠ ⊥ ∧ IsPGroup 2 ↥P ∧
            E ≤ Subgroup.normalizer (P : Set K) := by
  intro K _ _ hq d hd hU hiso
  obtain ⟨r, q, hdq⟩ := hU
  obtain ⟨idx, hv⟩ := d
  obtain ⟨e⟩ := hiso
  have hdq' : idx = TauCeti.LieTypeIndex.twistedA r q := hdq
  subst hdq'
  obtain ⟨hq13, m, hm3, hrm⟩ := hd
  have hq1 : q.p = 2 := by
    rcases hq13 with h | h <;> exact h.1
  have hq3 : 3 ∣ 2 ^ q.exponent + 1 := by
    rcases hq13 with ⟨-, h⟩ | ⟨-, h⟩ <;> rw [h] <;> norm_num
  obtain ⟨-, F, hfield, hfinite, hcard, ⟨Φ⟩⟩ :=
    CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA r q hv e
  let ρ : K →* StatedProj (StatedSU (r + 1) (q.p ^ q.exponent) F) :=
    Φ.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center K))
  have hρ : Function.Surjective ρ := Φ.surjective.comp (QuotientGroup.mk'_surjective _)
  have hρk : ρ.ker = Subgroup.center K := by
    ext x
    rw [MonoidHom.mem_ker]
    change Φ (QuotientGroup.mk x) = 1 ↔ x ∈ Subgroup.center K
    rw [map_eq_one_iff Φ Φ.injective, QuotientGroup.eq_one_iff]
  obtain ⟨E, P, h1, h2, h3, h4, h5, h6⟩ :=
    Gen2318LocalUAux.unitary_witness (Q := q.p ^ q.exponent) (f := q.exponent) (d := r + 1)
      (by rw [hq1]) hcard q.exponent_pos (by omega) (by omega) hq3 hq.1 ρ hρ hρk
  refine ⟨E, P, h1, h2, ?_, h4, h5, h6⟩
  change r - 2 ≤ _
  have : r - 2 = r + 1 - 3 := by omega
  rw [this]
  exact h3

@[expose] def Gen2318ResidualRest : Prop :=
  ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K → ∀ d : TauCeti.ValidLieTypeIndex,
    Gen2318Index d.1 → Gen2318Open d.1 →
      ¬ (∃ q, d.1 = TauCeti.LieTypeIndex.E6 q ∧ IsTwoPow q 2) →
        ¬ (∃ r q, d.1 = TauCeti.LieTypeIndex.twistedA r q) →
          Nonempty ((K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group) →
            ∃ E P : Subgroup K, IsElemAbelian 3 E ∧ E ⊓ Subgroup.center K = ⊥ ∧
              rho2318 d.1 ≤ CFSG.Open.pRank 3 E ∧ P ≠ ⊥ ∧ IsPGroup 2 ↥P ∧
              E ≤ Subgroup.normalizer (P : Set K)

theorem gen2318ResidualNoE64_of_rest (h : Gen2318ResidualRest) : Gen2318ResidualNoE64 := by
  intro K _ _ hq d hd hopen hnE6 hiso
  by_cases hU : ∃ r q, d.1 = TauCeti.LieTypeIndex.twistedA r q
  · exact gen2318Residual_U K hq d hd hU hiso
  · exact h K hq d hd hopen hnE6 hU hiso

