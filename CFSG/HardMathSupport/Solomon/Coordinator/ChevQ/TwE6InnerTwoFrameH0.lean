private theorem fh0_not_three_dvd_index {ℓ f : ℕ} (hℓ : ℓ.Prime) (hf : 1 ≤ f)
    (hq3 : ℓ ^ f % 3 = 2) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    (Fr : AlgebraicClosure K →+* AlgebraicClosure K) (hFr : ∀ c, Fr c = c ^ (ℓ ^ f))
    {ω : (AlgebraicClosure K)ˣ} (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1)
    {g0 : ModGL TwistTag.E6.tag (AlgebraicClosure K)}
    (hg0C : g0 ∈ adjointGroup TwistTag.E6.tag (AlgebraicClosure K))
    (hg0 : twistHom TwistTag.E6 (AlgebraicClosure K) Fr g0 =
      g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) (AlgebraicClosure K) twE6W0) :
    ¬ 3 ∣ ((X6 (AlgebraicClosure K) Fr twE6W0 ⊓
        toralCentralizer TwistTag.E6.tag (AlgebraicClosure K) (e6LineChar ω)).comap
      ((MulAut.conj g0⁻¹).toMonoidHom.comp
        ((baseChangeGL (algebraMap K (AlgebraicClosure K))).comp
          (twistedE6RootGroup K σ).subtype))).index := by
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K ℓ := charP_of_card_eq_prime_pow (f := f * 2)
    (by rw [← Nat.card_eq_fintype_card, hK, ← pow_mul])
  set L := AlgebraicClosure K
  haveI : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective ℓ
  have hσ' : ∀ c, σ.toRingHom c = c ^ (ℓ ^ f) := fun c => by
    rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hσ]
  have hq1 : 1 < ℓ ^ f := Nat.one_lt_pow (by omega) hℓ.one_lt
  have hw0 : ∀ u : Fin TwistTag.E6.tag.rank → ℤ,
      twE6W0 • u = -permLattice TwistTag.E6.perm u := fun u => twE6W0_smul u
  set J := twistedE6RootGroup K σ
  haveI : Finite (ModGL TwistTag.E6.tag K) := inferInstance
  haveI hJfin : Finite J := inferInstance
  set X := X6 L Fr twE6W0 ⊓ toralCentralizer TwistTag.E6.tag L (e6LineChar ω)
  set R := twistedFixedGroup TwistTag.E6 L Fr
  set C' := J.map (baseChangeGL (algebraMap K L))
  let fc : ModGL TwistTag.E6.tag L →* ModGL TwistTag.E6.tag L := (MulAut.conj g0).toMonoidHom
  have hfc_apply : ∀ x, fc x = g0 * x * g0⁻¹ := fun x => rfl
  have hXR : ∀ x ∈ X, fc x ∈ R := by
    intro x hx
    have hx6 := (Subgroup.mem_inf.1 hx).1
    refine (mem_twistedFixedGroup_iff_twistHom _ _ _).2 ⟨?_, ?_⟩
    · rw [hfc_apply]
      exact mul_mem (mul_mem hg0C (X6_le_adjoint Fr _ hx6)) (inv_mem hg0C)
    · have h1 := X6_fix hw0 hx6
      rw [hfc_apply, map_mul, map_mul, map_inv, hg0]
      calc g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0 *
            twistHom TwistTag.E6 L Fr x *
            (g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0)⁻¹ =
          g0 * (canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0 *
            twistHom TwistTag.E6 L Fr x *
            (canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0)⁻¹) * g0⁻¹ := by group
        _ = g0 * x * g0⁻¹ := by rw [h1]
  set Y : Subgroup (ModGL TwistTag.E6.tag L) := C'.comap fc
  have hrel : Y.relIndex X ∣ 3 := by
    have h := CFSG.LieType.SeitzGeneration.twisted_E6_relIndex_dvd_three hℓ hf K hK σ.toRingHom
      hσ' L Fr hFr (X := X.map fc) (by
        rintro _ ⟨x, hx, rfl⟩
        exact hXR x hx)
    rwa [← Subgroup.relIndex_comap] at h
  set ι' : ↥J →* ModGL TwistTag.E6.tag L := (MulAut.conj g0⁻¹).toMonoidHom.comp
    ((baseChangeGL (algebraMap K L)).comp J.subtype)
  have hι'inj : Function.Injective ι' :=
    (MulAut.conj g0⁻¹).injective.comp
      ((baseChangeGL_injective _).comp (Subgroup.subtype_injective _))
  have hrange : ι'.range = Y := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      refine ⟨(z : ModGL TwistTag.E6.tag K), z.2, ?_⟩
      change baseChangeGL (algebraMap K L) (z : ModGL TwistTag.E6.tag K) =
        g0 * ((MulAut.conj g0⁻¹)
          (baseChangeGL (algebraMap K L) (z : ModGL TwistTag.E6.tag K))) * g0⁻¹
      rw [MulAut.conj_apply, inv_inv]
      group
    · rintro ⟨c, hc, hcy⟩
      refine ⟨⟨c, hc⟩, ?_⟩
      change (MulAut.conj g0⁻¹) (baseChangeGL (algebraMap K L) c) = y
      rw [MulAut.conj_apply, inv_inv]
      change baseChangeGL (algebraMap K L) c = g0 * y * g0⁻¹ at hcy
      rw [hcy]
      group
  set Z := X.comap ι' with hZ
  have hcardZ : Nat.card Z = Nat.card ↥(Y ⊓ X) := by
    rw [← Subgroup.card_map_of_injective hι'inj, hZ, Subgroup.map_comap_eq, hrange]
  have hz0 : Nat.card Z ≠ 0 := Nat.card_pos.ne'
  have hm0 : Nat.card ↥(Y ⊓ X) ≠ 0 := hcardZ ▸ hz0
  have hr0 : Y.relIndex X ≠ 0 := fun h => by
    rw [h] at hrel
    exact absurd (Nat.eq_zero_of_zero_dvd hrel) (by norm_num)
  have hcardX : Y.relIndex X * Nat.card ↥(Y ⊓ X) = Nat.card X := Subgroup.relIndex_mul_card Y X
  have hq_ne : (((ℓ ^ f + 1 : ℕ)) : L) ≠ 0 := by
    have hz : ((ℓ : ℕ) : L) = 0 := CharP.cast_eq_zero L ℓ
    have : (((ℓ ^ f + 1 : ℕ)) : L) = 1 := by
      push_cast
      rw [hz, zero_pow (by omega), zero_add]
    rw [this]
    exact one_ne_zero
  have hdvdX := fh0_card_dvd (L := L) hFr hq_ne hω3 hω1
  set v := padicValNat 3 (ℓ ^ f + 1)
  have hn0 : Nat.card X ≠ 0 := by
    rw [← hcardX]
    exact mul_ne_zero hr0 hm0
  have h3pow : 3 ^ (6 * v + 4) ∣ Nat.card X := by
    refine Dvd.dvd.trans ?_ hdvdX
    have h1 : 3 ^ v ∣ ℓ ^ f + 1 := pow_padicValNat_dvd
    have h2 : 3 ^ (6 * v) ∣ (ℓ ^ f + 1) ^ 6 := by
      rw [mul_comm, pow_mul]
      exact pow_dvd_pow_of_dvd h1 6
    rw [pow_add]
    exact mul_dvd_mul h2 (by norm_num)
  have hvX : 6 * v + 4 ≤ padicValNat 3 (Nat.card X) := (padicValNat_dvd_iff_le hn0).1 h3pow
  have hvsplit : padicValNat 3 (Nat.card X) =
      padicValNat 3 (Y.relIndex X) + padicValNat 3 (Nat.card ↥(Y ⊓ X)) := by
    rw [← hcardX, padicValNat.mul hr0 hm0]
  have hvr : padicValNat 3 (Y.relIndex X) ≤ 1 := by
    rcases (Nat.dvd_prime Nat.prime_three).1 hrel with h | h
    · rw [h]
      simp
    · rw [h, padicValNat_self]
  have hJcard : Nat.card J = CFSG.Open.ordTwistedE6 (ℓ ^ f) :=
    CFSG.HardMathSupport.Malle.E27Lie.card_graphFixedRootGroup_E6 hℓ hf hK σ.toRingHom hσ'
  have hvJ : padicValNat 3 (Nat.card J) = 6 * v + 3 := by
    rw [hJcard,
      CFSG.HardMathSupport.Malle.E27Lie.padicValNat_three_ordTwistedE6_of_mod_two hq1 hq3]
  have hidx : Z.index * Nat.card Z = Nat.card J := Subgroup.index_mul_card Z
  have hi0 : Z.index ≠ 0 := Subgroup.index_ne_zero_of_finite
  have hvidx : padicValNat 3 (Nat.card J) =
      padicValNat 3 Z.index + padicValNat 3 (Nat.card Z) := by
    rw [← hidx, padicValNat.mul hi0 hz0]
  rw [hcardZ] at hvidx
  intro h3
  have h1 : padicValNat 3 Z.index ≠ 0 := (dvd_iff_padicValNat_ne_zero hi0).1 h3
  omega

theorem twE6SylowMonoTwoAt_holds : TwE6SylowMonoTwoAt := by
  intro K _ _ σ q hK hσ hq _ E hE h₀ _ hcomm hh3 hdim
  classical
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hℓ, hn⟩ := FiniteField.card K (ringChar K)
  have hdvd : q ∣ ringChar K ^ (n : ℕ) := by
    rw [← hn, ← Nat.card_eq_fintype_card, hK]
    exact dvd_pow_self q two_ne_zero
  obtain ⟨f, -, rfl⟩ := (Nat.dvd_prime_pow hℓ).1 hdvd
  set ℓ := ringChar K
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h0 | h0
    · rw [h0, pow_zero] at hq
      omega
    · exact h0
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP K ℓ := ringChar.charP K
  set L := AlgebraicClosure K
  haveI : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective ℓ
  set Fr : L →+* L := iterateFrobenius L ℓ f
  have hFr : ∀ c, Fr c = c ^ (ℓ ^ f) := fun c => iterateFrobenius_def ℓ f c
  have hσ' : ∀ c, σ.toRingHom c = c ^ (ℓ ^ f) := fun c => by
    rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hσ]
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have h3K : 3 ∣ Nat.card Kˣ := by
    have h1 : (ℓ ^ f) ^ 2 % 3 = 1 := by rw [Nat.pow_mod, hq]
    rw [Nat.card_units, hK]
    omega
  obtain ⟨ω, hω⟩ := exists_prime_orderOf_dvd_card' 3 h3K
  have hω3 : ω ^ 3 = 1 := by
    rw [← hω]
    exact pow_orderOf_eq_one ω
  have hω1 : ω ≠ 1 := by
    rintro rfl
    rw [orderOf_one] at hω
    omega
  set ωL : Lˣ := Units.map (algebraMap K L).toMonoidHom ω
  have hωL3 : ωL ^ 3 = 1 := by
    show Units.map (algebraMap K L).toMonoidHom ω ^ 3 = 1
    rw [← map_pow, hω3, map_one]
  have hωL1 : ωL ≠ 1 := by
    intro h
    apply hω1
    apply Units.map_injective (f := (algebraMap K L).toMonoidHom) (algebraMap K L).injective
    rw [map_one]
    exact h
  have hz3 : (h₀ : ModGL TwistTag.E6.tag K) ^ 3 = 1 := by
    simpa using congrArg Subtype.val hh3
  obtain ⟨g, hgC, hgF, hgz⟩ : ∃ g : ModGL TwistTag.E6.tag L,
      g ∈ adjointGroup TwistTag.E6.tag L ∧
        twistHom TwistTag.E6 L Fr g = g * canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0 ∧
        baseChangeGL (algebraMap K L) (h₀ : ModGL TwistTag.E6.tag K) =
          g * baseChangeGL (algebraMap K L) (rootDiagUnit TwistTag.E6.tag (e6LineChar ω)) * g⁻¹ :=
    tw_exists_lang_datum_threeA2 hℓ hf hK σ hσ hq Fr hFr hω3 hω1 h₀.2 hz3 hdim
  have hd : baseChangeGL (algebraMap K L) (rootDiagUnit TwistTag.E6.tag (e6LineChar ω)) =
      rootDiagUnit TwistTag.E6.tag (e6LineChar ωL) := by
    rw [CFSG.LieType.Chevalley.baseChangeGL_rootDiagUnit (τ := TwistTag.E6.tag) _ (e6LineChar ω)]
    congr 1
    funext i
    by_cases hi : i = e6KacNode
    · rw [hi, e6LineChar_kacNode, e6LineChar_kacNode]
    · rw [e6LineChar_of_ne ω hi, e6LineChar_of_ne ωL hi, map_one]
  rw [hd] at hgz
  have hidx := fh0_not_three_dvd_index hℓ hf hq hK σ hσ Fr hFr hωL3 hωL1 hgC hgF
  haveI : Finite (ModGL TwistTag.E6.tag K) := inferInstance
  haveI : Finite (twistedE6RootGroup K σ) := inferInstance
  set ι' : ↥(twistedE6RootGroup K σ) →* ModGL TwistTag.E6.tag L :=
    (MulAut.conj g⁻¹).toMonoidHom.comp
      ((baseChangeGL (algebraMap K L)).comp (twistedE6RootGroup K σ).subtype) with hι'
  set Xd := X6 L Fr twE6W0 ⊓ toralCentralizer TwistTag.E6.tag L (e6LineChar ωL)
  change ¬ 3 ∣ (Xd.comap ι').index at hidx
  have hι'inj : Function.Injective ι' :=
    (MulAut.conj g⁻¹).injective.comp
      ((baseChangeGL_injective _).comp (Subgroup.subtype_injective _))
  have hι'_apply : ∀ z : twistedE6RootGroup K σ,
      ι' z = g⁻¹ * baseChangeGL (algebraMap K L) (z : ModGL TwistTag.E6.tag K) * g := by
    intro z
    rw [hι']
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Subgroup.coe_subtype,
      MulAut.conj_apply, inv_inv]
  have hh₀d : ι' h₀ = rootDiagUnit TwistTag.E6.tag (e6LineChar ωL) := by
    rw [hι'_apply, hgz]
    group
  set C := Subgroup.centralizer ({h₀} : Set (twistedE6RootGroup K σ))
  have hEC : E ≤ C := fun x hx => Subgroup.mem_centralizer_singleton_iff.2 (hcomm x hx)
  have hZC : Xd.comap ι' ≤ C := by
    intro z hz
    have hc := (mem_toralCentralizer.1 (Subgroup.mem_inf.1 (Subgroup.mem_comap.1 hz)).2).2
    rw [← hh₀d, ← map_inv, ← map_mul, ← map_mul] at hc
    have hc' := hι'inj hc
    rw [mul_inv_eq_iff_eq_mul] at hc'
    exact Subgroup.mem_centralizer_singleton_iff.2 hc'.symm
  have hrel : ¬ 3 ∣ (Xd.comap ι').relIndex C := by
    intro h
    apply hidx
    rw [← Subgroup.relIndex_mul_index hZC]
    exact dvd_mul_of_dvd_left h _
  obtain ⟨u, huC, hu⟩ := exists_conj_le_of_isPGroup_of_not_dvd_relIndex hEC hE hrel
  obtain ⟨-, hle, -⟩ := exceptional_ambient_twisted_Frobenius_fixed_normalizer TwistTag.E6 hℓ hf
    K hK σ.toRingHom hσ' L Fr hFr
  set b : ModGL TwistTag.E6.tag L := baseChangeGL (algebraMap K L) (u : ModGL TwistTag.E6.tag K)
  have hbR : b ∈ twistedFixedGroup TwistTag.E6 L Fr := hle ⟨u, u.2, rfl⟩
  obtain ⟨hbC, hbF⟩ := (mem_twistedFixedGroup_iff_twistHom _ _ _).1 hbR
  have huh : u * h₀ * u⁻¹ = h₀ := by
    rw [mul_inv_eq_iff_eq_mul]
    exact Subgroup.mem_centralizer_singleton_iff.1 huC
  have hub : b * baseChangeGL (algebraMap K L) (h₀ : ModGL TwistTag.E6.tag K) * b⁻¹ =
      baseChangeGL (algebraMap K L) (h₀ : ModGL TwistTag.E6.tag K) := by
    have e := congrArg (fun y : twistedE6RootGroup K σ =>
      baseChangeGL (algebraMap K L) (y : ModGL TwistTag.E6.tag K)) huh
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv] at e
    exact e
  have key : ∀ a c d : ModGL TwistTag.E6.tag L,
      (c⁻¹ * a)⁻¹ * d * (c⁻¹ * a) = a⁻¹ * (c * d * c⁻¹) * a := fun a c d => by group
  refine ⟨Fr, hFr, twE6W0, twE6W0_smul_permLattice, b⁻¹ * g, mul_mem (inv_mem hbC) hgC, ?_,
    ⟨e6LineChar ωL, ?_, fun α _ => ?_⟩, fun x hx => ?_⟩
  · rw [map_mul, map_inv, hbF, hgF, mul_assoc]
  · rw [key, hub, hgz]
    group
  · have h := rootChar_e6LineChar ωL α
    have h' := e6Line_zpow_eq_one_iff_three_dvd hωL3 hωL1 (α e6KacNode)
    exact ⟨fun h1 => h'.1 (h.symm.trans h1), fun h2 => h.trans (h'.2 h2)⟩
  · have hm := Subgroup.mem_comap.1 (hu x hx)
    rw [hι'_apply] at hm
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv] at hm
    obtain ⟨w, t, ht, hmt⟩ := monomialSubgroup_le_torusWeylCosets
      (X6_le_monomial Fr twE6W0 (Subgroup.mem_inf.1 hm).1)
    refine ⟨t, ht, w, ?_⟩
    rw [← hmt]
    exact key g b _

