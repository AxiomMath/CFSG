open CFSG.Open CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley


theorem e6NotAll24Census_of_OA
    (hOA : ∀ {K : Type} [Field K] {ω : Kˣ} [Finite K], 3 ∣ Nat.card K - 1 → ω ^ 3 = 1 →
      ω ≠ 1 → ∀ {E : Subgroup (MulAut (adjointGroup Tag.E6 K))}, E6CenCube K E →
        E6CenFrame e6CenOA E → E6CenConcl K E) :
    E6NotAll24Census := by
  intro K _ _ _ hK _ E hE hEc hED hEi hER hA
  have hcube : E6CenCube K E := ⟨hE, hEc, hED, hEi, hER, hA⟩
  have hK4 : 4 ≤ Nat.card K := e6Cen_four_le_card hK
  obtain ⟨ω, h3, h1⟩ : ∃ ω : Kˣ, ω ^ 3 = 1 ∧ ω ≠ 1 := by
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    have hcard : Nat.card Kˣ = Nat.card K - 1 := Nat.card_units K
    obtain ⟨ω, hω⟩ := exists_prime_orderOf_dvd_card' 3 (hcard ▸ hK)
    refine ⟨ω, by rw [← hω]; exact pow_orderOf_eq_one ω, fun h1 => ?_⟩
    rw [h1, orderOf_one] at hω
    omega
  have hE3 : IsPGroup 3 E := fun g => ⟨1, Subtype.ext (by simpa using hE.2 g g.2)⟩
  obtain ⟨φ, hφ, hmono⟩ := e6_exists_conj_bmMono_sylow hK hE3 hED
  set E₁ := E.map (MulAut.congr φ).toMonoidHom with hE₁
  have hcube₁ : E6CenCube K E₁ := hcube.map hφ
  have hE₁3 : IsElemAbelian 3 E₁ := by
    obtain ⟨h, -⟩ := hcube₁
    exact h
  have hF₁ : E6CenFrame (e6CenImage E₁) E₁ :=
    e6CenFrame_image fun X hX => (hmono X hX).imp fun _ h => h.2
  obtain ⟨μ, hμ⟩ := e6Cen_weyl_cases (e6CenImage_le hK4 hmono)
    (fun v hv => e6CenImage_pow_three hK4 hE₁3 hv)
    (fun v hv u hu => e6CenImage_mul_comm hK4 hE₁3 hv hu)
  have hw := e6Cen_conj_word_mem_inndiag (K := K) μ
  have hcube₂ := hcube₁.map hw
  have hF₂ := hF₁.map_word μ
  show E6CenConcl K E
  refine E6CenConcl.of_map hφ (E6CenConcl.of_map hw ?_)
  rcases hμ with ⟨l, hl, hfix⟩ | h | h | h | h | h
  ·
    exfalso
    obtain ⟨-, -, -, -, hER₂, -⟩ := hcube₂
    refine hER₂ (e6NormalizesR_of_bmMono_fixed hl fun X hX => ?_)
    obtain ⟨v, hv, hXv⟩ := hF₂.1 X hX
    exact ⟨v, hXv, hfix v hv⟩
  · rw [h] at hF₂
    exact e6Cen_O1 hK4 h3 h1 hcube₂ hF₂
  · rw [h] at hF₂
    exact hOA hK h3 h1 hcube₂ hF₂
  · rw [h] at hF₂
    exact e6Cen_OB hK h3 h1 hcube₂ hF₂
  · rw [h] at hF₂
    exact e6Cen_OT hK h3 h1 hcube₂ hF₂
  · rw [h] at hF₂
    exact e6Cen_O3 hK h3 h1 hcube₂ hF₂

end CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three

