@[expose] def IsU3EightIndex : TauCeti.LieTypeIndex → Prop
  | .twistedA r q => r = 2 ∧ IsTwoPow q 3
  | _ => False

@[expose] def IsU6EightIndex : TauCeti.LieTypeIndex → Prop
  | .twistedA r q => r = 5 ∧ IsTwoPow q 3
  | _ => False

@[expose] def IsTwE6EightIndex : TauCeti.LieTypeIndex → Prop
  | .twistedE6 q => IsTwoPow q 3
  | _ => False

theorem isUEightIndex_iff (d : TauCeti.LieTypeIndex) :
    OuterFourAux.IsUEightIndex d ↔ IsU3EightIndex d ∨ IsU6EightIndex d ∨ IsTwE6EightIndex d := by
  cases d <;> simp only [OuterFourAux.IsUEightIndex, IsU3EightIndex, IsU6EightIndex,
    IsTwE6EightIndex, or_false, false_or, iff_self]
  case twistedA r q =>
    constructor
    · rintro ⟨hq, rfl | rfl⟩
      · exact Or.inl ⟨rfl, hq⟩
      · exact Or.inr ⟨rfl, hq⟩
    · rintro (⟨rfl, hq⟩ | ⟨rfl, hq⟩)
      · exact ⟨hq, Or.inl rfl⟩
      · exact ⟨hq, Or.inr rfl⟩

@[expose] def glEntry {n : ℕ} {K : Type} [Field K] (σ : K ≃+* K) : GL (Fin n) K →* GL (Fin n) K :=
  Units.map (RingHom.mapMatrix (σ : K →+* K)).toMonoidHom

@[expose] def IsEntrywiseProj {n : ℕ} {K : Type} [Field K] (H : Subgroup (GL (Fin n) K))
    (σ : K ≃+* K) (ψ : MulAut (StatedProj H)) : Prop :=
  ∀ g : ↥H, ∃ g' : ↥H, (g' : GL (Fin n) K) = glEntry σ (g : GL (Fin n) K) ∧
    ψ (QuotientGroup.mk g) = QuotientGroup.mk g'

@[expose] noncomputable def d4PMat (K : Type) [Field K] : ModGL Tag.D4 K :=
  diagramMap TwistTag.D4 K

@[expose] def FieldAutU (n : ℕ) (S : Type) [Group S] (φ : MulAut S) : Prop :=
  ∃ (K : Type) (_ : Field K) (_ : Finite K) (e : S ≃* StatedProj (StatedSU n (2 ^ 3) K))
    (σ : K ≃+* K) (γ : MulAut (StatedProj (StatedSU n (2 ^ 3) K))),
    Nat.card K = (2 ^ 3) ^ 2 ∧ σ ≠ 1 ∧ Odd (orderOf σ) ∧
      IsEntrywiseProj (StatedSU n (2 ^ 3) K) σ (γ * MulAut.congr e φ * γ⁻¹)

@[expose] def FieldAutTwE6 (S : Type) [Group S] (φ : MulAut S) : Prop :=
  ∃ (K : Type) (_ : Field K) (_ : Finite K) (σq : K →+* K)
    (e : S ≃* DerivedCentralQuotient (twistedFixedGroup TwistTag.E6 K σq))
    (σ : K ≃+* K) (γ : MulAut (DerivedCentralQuotient (twistedFixedGroup TwistTag.E6 K σq))),
    Nat.card K = (2 ^ 3) ^ 2 ∧ (∀ c, σq c = c ^ (2 ^ 3)) ∧ σ ≠ 1 ∧ Odd (orderOf σ) ∧
      ∀ g : ↥⁅twistedFixedGroup TwistTag.E6 K σq, twistedFixedGroup TwistTag.E6 K σq⁆,
        ∃ g' : ↥⁅twistedFixedGroup TwistTag.E6 K σq, twistedFixedGroup TwistTag.E6 K σq⁆,
          (g' : ModGL TwistTag.E6.tag K) =
              Units.map (entrywiseHom σ.toRingHom) (g : ModGL TwistTag.E6.tag K) ∧
            (γ * MulAut.congr e φ * γ⁻¹) (QuotientGroup.mk g) = QuotientGroup.mk g'

@[expose] def FieldAutD4 (S : Type) [Group S] (φ : MulAut S) : Prop :=
  ∃ (K : Type) (_ : Field K) (_ : Finite K) (e : S ≃* ↥(adjointGroup Tag.D4 K))
    (σ : K ≃+* K) (γ : MulAut ↥(adjointGroup Tag.D4 K)),
    Nat.card K = 2 ^ 3 ∧ σ ≠ 1 ∧
      ∀ g : ↥(adjointGroup Tag.D4 K), ∃ g' : ↥(adjointGroup Tag.D4 K),
        (g' : ModGL Tag.D4 K) = Units.map (entrywiseHom σ.toRingHom) (g : ModGL Tag.D4 K) ∧
          (γ * MulAut.congr e φ * γ⁻¹) g = g'

@[expose] def GraphAutD4 (S : Type) [Group S] (φ : MulAut S) : Prop :=
  ∃ (K : Type) (_ : Field K) (_ : Finite K) (e : S ≃* ↥(adjointGroup Tag.D4 K))
    (x : ↥(adjointGroup Tag.D4 K)) (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (ε : ℕ),
    Nat.card K = 2 ^ 3 ∧ (ε = 1 ∨ ε = 2) ∧
      ∀ h : ↥(adjointGroup Tag.D4 K), ∃ h' : ↥(adjointGroup Tag.D4 K),
        (h' : ModGL Tag.D4 K) =
          (MulAut.conj (x : ModGL Tag.D4 K) * (exactNormalAutGL Tag.D4 K a σ 0 *
            MulAut.conj (d4PMat K ^ ε))) (h : ModGL Tag.D4 K) ∧
        MulAut.congr e φ h = h'

