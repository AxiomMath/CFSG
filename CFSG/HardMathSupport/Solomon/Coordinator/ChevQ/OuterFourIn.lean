@[expose] def Seitz2310FourFreeAt (P : TauCeti.LieTypeIndex → Prop)
    (F : ∀ (S : Type) [Group S], MulAut S → Prop) : Prop :=
  ∀ (S : Type) [Group S] [Finite S] (d : TauCeti.ValidLieTypeIndex),
    Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) → P d.1 →
      ∀ E : Subgroup (MulAut S), CFSG.Open.IsElemAbelian 3 E → Nat.card E = 3 ^ 3 →
        (∀ φ ∈ E, ¬ F S φ) → CFSG.LieType.Seitz.seitzHyperGamma 3 E = ⊤

@[expose] def Bal209FourUAt (P : TauCeti.LieTypeIndex → Prop)
    (F : ∀ (S : Type) [Group S], MulAut S → Prop) : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.IsKGroup X → ∀ K B : Subgroup X,
    CFSG.Open.IsComponentOf K ⊤ → IsSCp 3 ⊤ B → B ≤ Subgroup.normalizer (K : Set X) →
      GLATwoLocalRank 3 X ≤ CFSG.Open.pRank 3 B → IsLieQuot ↥K P →
        (∃ φ ∈ autImage B K, F (↥K ⧸ Subgroup.center ↥K) φ) → IsStronglyBalancedIn 3 B K

