theorem isEntrywiseProj_congr_psuField {p f : ℕ} {K : Type} [Field K] (h : UnitaryFieldData p f K)
    (σ : K ≃+* K) :
    IsEntrywiseProj (StatedSU 3 (p ^ f) K) σ
      (MulAut.congr (unitaryPSUEquiv h (n := 3) (by norm_num)) (psuField h σ)) := by
  intro g
  refine ⟨suField h σ g, Units.ext rfl, ?_⟩
  simp only [MulAut.congr_apply, MulEquiv.trans_apply]
  have h1 : (unitaryPSUEquiv h (n := 3) (by norm_num)).symm (QuotientGroup.mk g) =
      unitaryProj h 3 g :=
    (MulEquiv.symm_apply_eq _).2 (unitaryPSUEquiv_unitaryProj h (n := 3) (by norm_num) g).symm
  rw [h1]
  exact unitaryPSUEquiv_unitaryProj h (n := 3) (by norm_num) (suField h σ g)

theorem exists_fieldAutU_of_cube {S : Type} [Group S] {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.twistedA 2 q).Valid) (hq : IsTwoPow q 3)
    (e : S ≃* TauCeti.ValidLieTypeIndex.Group ⟨.twistedA 2 q, hv⟩)
    {E : Subgroup (MulAut S)} (hE : IsElemAbelian 3 E) (hc : Nat.card E = 3 ^ 3) :
    ∃ φ ∈ E, FieldAutU 3 S φ := by
  classical
  have hmod := CFSG.Models.lieModel_twistedA 2 q hv e
  have hc' : TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA 2 q, hv⟩ = q.p :=
    TauCeti.LieTypeIndex.characteristic_twistedA 2 q
  have hf : TauCeti.ValidLieTypeIndex.fieldExponent ⟨.twistedA 2 q, hv⟩ = q.exponent :=
    TauCeti.LieTypeIndex.fieldExponent_twistedA 2 q
  rw [hc', hf, hq.1, hq.2] at hmod
  obtain ⟨-, hcl | ⟨h0, -⟩⟩ := hmod
  swap
  · omega
  obtain ⟨-, K, _, _, hK, ⟨eS⟩⟩ := hcl
  have hU : UnitaryFieldData 2 3 K := ⟨Nat.prime_two, by norm_num, by rw [hK]; norm_num⟩
  let U := unitaryPSUEquiv hU (n := 3) (by norm_num)
  let e' : S ≃* unitaryPSU hU 3 := eS.trans U.symm
  set B : Subgroup (MulAut (unitaryPSU hU 3)) := E.map (MulAut.congr e').toMonoidHom with hBdef
  have hB : IsElemAbelian 3 B := CFSG.SectionRank.isElemAbelian_map hE _
  have hBc : Nat.card B = 3 ^ 3 := by
    rw [hBdef, Subgroup.card_map_of_injective (MulAut.congr e').injective, hc]
  have hout : ¬ B ≤ (psuConj hU).range := by
    intro hle
    have h9 := CFSG.RankThree.PartTwo.Sec19.Item19Res6Proof.card_le_nine_of_le_psuConj_range
      (h := hU) (by rw [hK]; norm_num) B hle
