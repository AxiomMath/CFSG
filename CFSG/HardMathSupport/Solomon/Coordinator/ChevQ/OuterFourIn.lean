    (GaloisField 2 3) q hv hF
  have hZ : Subgroup.center ↥(adjointGroup Tag.D4 (GaloisField 2 3)) = ⊥ :=
    center_adjointGroup_eq_bot
  refine ⟨GaloisField 2 3, inferInstance, inferInstance,
    e.trans (eB.symm.trans ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot)),
    GaloisField.card 2 3 (by norm_num)⟩

theorem d4_cube_trichotomy_model {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 3)
    (α : MulAut ↥(adjointGroup Tag.D4 K)) (hα : α ^ 3 = 1) :
    α ∈ (MulAut.conj : ↥(adjointGroup Tag.D4 K) →* MulAut ↥(adjointGroup Tag.D4 K)).range ∨
      (∃ (σ : K ≃+* K) (ψ : MulAut ↥(adjointGroup Tag.D4 K)), σ ≠ 1 ∧
        ψ * α * ψ⁻¹ = entrywiseAdjointAut Tag.D4 σ) ∨
      (∃ (g : ↥(adjointGroup Tag.D4 K)) (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (ε : ℕ),
        (ε = 1 ∨ ε = 2) ∧
          α = MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε)) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hchar : CharP K 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two
      (by norm_num) hK
  have hK4 : 4 ≤ Nat.card K := by rw [hK]; norm_num
  obtain ⟨g, a, σ, ε, hε, hσ3, hαeq⟩ := exists_cube_normal_form_sigma α hα
  by_cases hε0 : ε = 0
  · subst hε0
    rw [d4Graph_zero, mul_one] at hαeq
    by_cases hσ1 : σ = 1
    · subst hσ1
      left
      have h3 : (MulAut.conj g * (exactNormalAut Tag.D4 K a 1 0 * d4Graph K 0)) ^ 3 = 1 := by
        rw [d4Graph_zero, mul_one]
        rw [← hαeq]
        exact hα
      have := mem_inner_of_normal_form_one g a h3
      rwa [d4Graph_zero, mul_one, ← hαeq] at this
    · right
      left
      obtain ⟨d, T, hd0, hdf, hT, hT3, hσT⟩ :=
        exists_frobenius_of_cube Nat.prime_two (by norm_num) K hK σ hσ3 hσ1
      have hconj : ∀ (β : MulAut ↥(adjointGroup Tag.D4 K)) (g' : ↥(adjointGroup Tag.D4 K))
          (a' : Fin Tag.D4.rank → Kˣ), β = MulAut.conj g' * exactNormalAut Tag.D4 K a' T 0 →
          β ^ 3 = 1 → ∃ ψ : MulAut ↥(adjointGroup Tag.D4 K),
            ψ * β * ψ⁻¹ = entrywiseAdjointAut Tag.D4 T := fun β g' a' hβ hβ3 =>
        exists_conj_eq_entrywiseAdjointAut_D4 hK hK4 hd0 hdf T hT g' a' β hβ hβ3
      rcases hσT with hσ | hσ
      · rw [hσ] at hαeq hσ1
        obtain ⟨ψ, hψ⟩ := hconj α g a hαeq hα
        exact ⟨T, ψ, hσ1, hψ⟩
      · obtain ⟨g', a', hα2⟩ := sq_conj_mul_exactNormalAut g a σ
        have hσ2 : σ ^ 2 = T := by
          rw [hσ, ← pow_mul, show 2 * 2 = 3 + 1 from rfl, pow_succ, hT3, one_mul]
        rw [hσ2, ← hαeq] at hα2
        have hα23 : (α ^ 2) ^ 3 = 1 := by rw [← pow_mul, mul_comm, pow_mul, hα, one_pow]
        have hα22 : (α ^ 2) ^ 2 = α := by
          rw [← pow_mul, show 2 * 2 = 3 + 1 from rfl, pow_succ, hα, one_mul]
        obtain ⟨ψ, hψ⟩ := hconj (α ^ 2) g' a' hα2 hα23
        refine ⟨σ, ψ, hσ1, ?_⟩
        have h1 : ψ * α * ψ⁻¹ = (ψ * α ^ 2 * ψ⁻¹) ^ 2 := by
          calc ψ * α * ψ⁻¹ = ψ * (α ^ 2) ^ 2 * ψ⁻¹ := by rw [hα22]
            _ = (ψ * α ^ 2 * ψ⁻¹) ^ 2 := (conj_pow).symm
        rw [h1, hψ, ← entrywiseAdjointAut_pow, hσ]
  · right
    right
    refine ⟨g, a, σ, ε, ?_, hαeq⟩
    omega

theorem d4_cube_trichotomy {S : Type} [Group S] {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.D 4 q).Valid) (hq : IsTwoPow q 3)
    (e : S ≃* TauCeti.ValidLieTypeIndex.Group ⟨.D 4 q, hv⟩) (φ : MulAut S) (hφ : φ ^ 3 = 1) :
    φ ∈ (MulAut.conj : S →* MulAut S).range ∨ FieldAutD4 S φ ∨ GraphAutD4 S φ := by
  obtain ⟨K, _, _, e', hK⟩ := exists_mulEquiv_adjointD4 hv hq e
  have hβ3 : MulAut.congr e' φ ^ 3 = 1 := by rw [← map_pow, hφ, map_one]
  rcases d4_cube_trichotomy_model hK (MulAut.congr e' φ) hβ3 with ⟨g, hg⟩ | ⟨σ, ψ, hσ, hψ⟩ |
    ⟨g, a, σ, ε, hε, hαeq⟩
  · exact Or.inl ⟨e'.symm g, (congr_eq_conj_imp e' φ g hg.symm).symm⟩
  · refine Or.inr (Or.inl ⟨K, inferInstance, inferInstance, e', σ, ψ, hK, hσ, fun h => ?_⟩)
    exact ⟨entrywiseAdjointAut Tag.D4 σ h, rfl, by rw [hψ]⟩
  · refine Or.inr (Or.inr ⟨K, inferInstance, inferInstance, e', g, a, σ, ε, hK, hε, fun h => ?_⟩)
    refine ⟨MulAut.congr e' φ h, ?_, rfl⟩
    rw [hαeq]
    simp only [MulAut.mul_apply, MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv,
      coe_exactNormalAut, coe_d4Graph]
    rfl

theorem fieldAutD4_entrywiseAdjointAut {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 3)
    {T : K ≃+* K} (hT : T ≠ 1) :
    FieldAutD4 ↥(adjointGroup Tag.D4 K) (entrywiseAdjointAut Tag.D4 T) := by
  refine ⟨K, inferInstance, inferInstance, MulEquiv.refl _, T, 1, hK, hT, fun g => ?_⟩
  refine ⟨entrywiseAdjointAut Tag.D4 T g, rfl, ?_⟩
