  exact Group.IsPerfect.ofSurjective (f := e.toMonoidHom) e.surjective

theorem isSimpleGroup_adjointGroup_D4 (F : Type) [Field F] [Finite F] :
    IsSimpleGroup ↥(adjointGroup Tag.D4 F) := by
  have hnc := (opposite_simple_root_noncommutativity Tag.D4 F).2.2.1
  have hperf : Group.IsPerfect ↥(adjointGroup Tag.D4 F) := isPerfect_adjointGroup_D4 F
  have : Nontrivial ↥(adjointGroup Tag.D4 F) := by
    obtain ⟨a, b, hab⟩ := hnc
    exact ⟨⟨a * b, b * a, hab⟩⟩
  have hZ : Subgroup.center ↥(adjointGroup Tag.D4 F) = ⊥ := center_adjointGroup_eq_bot
  refine IsSimpleGroup.mk fun M hM => ?_
  by_cases hbot : M = ⊥
  · exact Or.inl hbot
  · right
    have hnot : ¬ M ≤ Subgroup.center ↥(adjointGroup Tag.D4 F) := by
      rw [hZ]
      exact fun h => hbot (le_bot_iff.1 h)
    have hsolv := (noncentral_normal_solvable_quotient Tag.D4 F M hnot).2.1
    by_contra htop
    have : Nontrivial (↥(adjointGroup Tag.D4 F) ⧸ M) := by
      rw [← not_subsingleton_iff_nontrivial, QuotientGroup.subsingleton_iff]
      exact htop
    exact Group.IsPerfect.not_isSolvable _ hsolv

theorem d4FieldFixed_holds :
    ∀ (X : Type) [Group X] [Finite X] (K : Subgroup X) (a : X)
      (ha : a ∈ Subgroup.normalizer (K : Set X)),
      CFSG.Open.IsComponentOf K ⊤ → IsLieQuot ↥K OuterFourAux.IsD4EightIndex → a ^ 3 = 1 →
        FieldAutD4 (↥K ⧸ Subgroup.center ↥K) (actHom K ⟨a, ha⟩) →
          IsSimpleGroup ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) ∧
            CFSG.Open.IsQuasisimple ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) ∧
            3 ∣ Nat.card ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) ∧
            IsLieQuot ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) IsD4TwoIndex := by
  intro X _ _ K a ha hK hLie hA3 hField
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hKq : CFSG.IsQuasisimple K := D4FixedAux.isQuasisimple_of_open_aux hK.2.2
  obtain ⟨d, hdD4, ⟨eL⟩⟩ := hLie
  obtain ⟨d₀, hv⟩ := d
  cases d₀ with
  | D r q =>
    obtain ⟨rfl, hq⟩ := hdD4
    have hLM : CFSG.Models.LieModel (TauCeti.ValidLieTypeIndex.Group ⟨.D 4 q, hv⟩)
        .POmegaPlus 4 2 3 := by
      have hmod := CFSG.Models.lieModel_D 4 q hv (MulEquiv.refl _)
      rw [hq.1, hq.2] at hmod
      exact hmod
    have hZK : Subgroup.center K = ⊥ := by
      have h := CFSG.HardMathSupport.Timmesfeld.Tables.Multiplier.center_dvd_table
        CFSG.HardMathSupport.Foote.FamilyReduction.griessAllModelsStatement hKq eL hLM
      have h1 : (CFSG.Blueprint.Multiplier.genericOrders .POmegaPlus 4 2 3).1 *
          (CFSG.Blueprint.Multiplier.genericOrders .POmegaPlus 4 2 3).2 *
          ((CFSG.Blueprint.Multiplier.exceptionalOrders .POmegaPlus 4 2 3).1 *
            (CFSG.Blueprint.Multiplier.exceptionalOrders .POmegaPlus 4 2 3).2) = 1 := by
        have hE8 : Even (8 : ℕ) := by decide
        simp [CFSG.Blueprint.Multiplier.genericOrders, CFSG.Blueprint.Multiplier.exceptionalOrders, hE8]
      rw [h1] at h
      exact Subgroup.eq_bot_of_card_eq _ (Nat.dvd_one.1 h)
    obtain ⟨K', _, _, e'', σ, γ, hK', hσ1, hmat⟩ := hField
    let eKq : K ≃* K ⧸ Subgroup.center K :=
      QuotientGroup.quotientBot.symm.trans (QuotientGroup.quotientMulEquivOfEq hZK.symm)
    let eD : K ≃* ↥(adjointGroup Tag.D4 K') := eKq.trans e''
    set β : MulAut ↥(adjointGroup Tag.D4 K') := MulAut.congr eD (D4FixedAux.conjOnNormal K a ha)
      with hβdef
    have hβact : MulAut.congr e'' (actHom K ⟨a, ha⟩) = β := by
      refine MulEquiv.ext fun y => ?_
      obtain ⟨x, rfl⟩ := e''.surjective y
      obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective x
      have h2 : eD.symm (e'' (QuotientGroup.mk k)) = k := (MulEquiv.symm_apply_eq eD).2 rfl
      simp only [hβdef, MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_apply_apply, h2]
      rfl
    have hγβ : γ * β * γ⁻¹ = entrywiseAdjointAut Tag.D4 σ := by
      rw [← hβact]
      refine MulEquiv.ext fun g => ?_
      obtain ⟨g', hg', hg''⟩ := hmat g
      rw [hg'']
      exact Subtype.ext hg'
    haveI : CharP K' 2 := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
      Nat.prime_two (by norm_num) hK'
    have hchar : ringChar K' = 2 := ringChar.eq K' 2
    obtain ⟨hdvd, hcardfix⟩ := CFSG.RankThree.Chevalley.SteinbergBT.card_fixSubfield
      Nat.prime_two (f := 3) (by norm_num) hK' σ
    have hord : orderOf σ = 3 := by
      have h1 : orderOf σ ≠ 1 := fun h => hσ1 (orderOf_eq_one_iff.1 h)
      exact ((Nat.dvd_prime Nat.prime_three).1 hdvd).resolve_left h1
    have h2 : Nat.card ↥(fixSubfield σ) = 2 := by
      rw [hcardfix, hord]
      norm_num
    have hΓJ := entrywiseFixedGroup_eq_fixedFieldImage_of_ringChar_two
      (τ := Tag.D4) (Or.inr (Or.inr (Or.inl rfl))) hchar σ
    have E1 : ↥(fixedSubgroup (D4FixedAux.conjOnNormal K a ha)) ≃*
        ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) :=
      (MulEquiv.subgroupCongr (D4FixedAux.fixedSubgroup_conjOnNormal K a ha)).trans
        (Subgroup.subgroupOfEquivOfLe inf_le_left)
    have E2 : ↥(fixedSubgroup (D4FixedAux.conjOnNormal K a ha)) ≃* ↥(fixedSubgroup β) :=
      (Subgroup.equivMapOfInjective _ eD.toMonoidHom eD.injective).trans
        (MulEquiv.subgroupCongr (D4FixedAux.fixed_map_congr eD (D4FixedAux.conjOnNormal K a ha)))
    have E3 : ↥(fixedSubgroup β) ≃* ↥(fixedSubgroup (entrywiseAdjointAut Tag.D4 σ)) :=
      (Subgroup.equivMapOfInjective _ γ.toMonoidHom γ.injective).trans
        (MulEquiv.subgroupCongr ((D4FixedAux.fixed_map_conj γ β).trans
          (congrArg fixedSubgroup hγβ)))
    have E4 := CFSG.LieType.SeitzGeneration.ExcOuterLeOne.fixedEquivOfEq (τ := Tag.D4) σ hΓJ
    let Ffix : ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) ≃* ↥(adjointGroup Tag.D4 (fixSubfield σ)) :=
      E1.symm.trans (E2.trans (E3.trans E4))
    have hsimpleFix : IsSimpleGroup ↥(adjointGroup Tag.D4 (fixSubfield σ)) :=
      isSimpleGroup_adjointGroup_D4 _
    have hsimpleJ : IsSimpleGroup ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) :=
      (MulEquiv.isSimpleGroup_congr Ffix).2 hsimpleFix
    have hperfFix : Group.IsPerfect ↥(adjointGroup Tag.D4 (fixSubfield σ)) :=
      isPerfect_adjointGroup_D4 _
    have hperfJ : Group.IsPerfect ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) :=
      haveI := hperfFix
      Group.IsPerfect.ofSurjective (f := Ffix.symm.toMonoidHom) Ffix.symm.surjective
    have hZJ : Subgroup.center ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) = ⊥ :=
      D4FixedAux.center_eq_bot_of_mulEquiv Ffix center_adjointGroup_eq_bot
    have hquasiJ : CFSG.Open.IsQuasisimple ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) := by
      refine ⟨hperfJ.commutator_eq_top, ?_⟩
      exact (MulEquiv.isSimpleGroup_congr ((QuotientGroup.quotientMulEquivOfEq hZJ).trans
        QuotientGroup.quotientBot)).2 hsimpleJ
    have h3 : 3 ∣ Nat.card ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) := by
      rw [Nat.card_congr Ffix.toEquiv]
      exact (by norm_num : 3 ∣ 27).trans
        (CFSG.HardMathSupport.Lang.E6Descent.twentySeven_dvd_card_adjointGroup_D4 (fixSubfield σ))
    let q₀ : TauCeti.PrimePower := ⟨2, 1, Nat.prime_two, Nat.one_pos⟩
    have hv₀ : (TauCeti.LieTypeIndex.D 4 q₀).Valid := by
      simp [TauCeti.LieTypeIndex.valid_iff]
    have hcard₀ : Nat.card ↥(fixSubfield σ) = q₀.card := by
      rw [h2, TauCeti.PrimePower.card_def]
      rfl
    obtain ⟨eB0⟩ := CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.nonempty_adjointQuotient_D4_equiv
      (fixSubfield σ) q₀ hv₀ hcard₀
    have hZ0 : Subgroup.center ↥(adjointGroup Tag.D4 (fixSubfield σ)) = ⊥ :=
      center_adjointGroup_eq_bot
    let eFix : (↥(K ⊓ Subgroup.centralizer ({a} : Set X))) ⧸
        Subgroup.center ↥(K ⊓ Subgroup.centralizer ({a} : Set X)) ≃*
        (TauCeti.CFSGIndex.lie ⟨TauCeti.LieTypeIndex.D 4 q₀, hv₀⟩).Group :=
      ((QuotientGroup.quotientMulEquivOfEq hZJ).trans QuotientGroup.quotientBot).trans
        (Ffix.trans (((QuotientGroup.quotientMulEquivOfEq hZ0).trans
          QuotientGroup.quotientBot).symm.trans eB0))
    exact ⟨hsimpleJ, hquasiJ, h3, ⟨⟨TauCeti.LieTypeIndex.D 4 q₀, hv₀⟩, ⟨rfl, ⟨rfl, rfl⟩⟩, ⟨eFix⟩⟩⟩
  | _ => exact hdD4.elim

end D4FixedProof

theorem seitz2310FourFree_of_at (h6 : Seitz2310FourFreeAt IsU6EightIndex (FieldAutU 6))
    (hE : Seitz2310FourFreeAt IsTwE6EightIndex FieldAutTwE6)
    (hD : Seitz2310FourFreeAt OuterFourAux.IsD4EightIndex FieldAutD4) :
    OuterFourAux.Seitz2310FourFree IsFieldAutFour := by
  intro S _ _ d hS hd E hEel hEcard hno
  rcases (OuterFourAux.fourIndex_iff d.1).1 hd with hU | hD4
  · rcases (isUEightIndex_iff _).1 hU with h3 | h6' | hE6
    · exact seitz2310FourFreeAt_u3 S d hS h3 E hEel hEcard fun φ hφ h => hno φ hφ (Or.inl h)
    · exact h6 S d hS h6' E hEel hEcard fun φ hφ h => hno φ hφ (Or.inr (Or.inl h))
    · exact hE S d hS hE6 E hEel hEcard fun φ hφ h => hno φ hφ (Or.inr (Or.inr (Or.inl h)))
  · exact hD S d hS hD4 E hEel hEcard fun φ hφ h => hno φ hφ (Or.inr (Or.inr (Or.inr h)))

