@[expose] def TwE6TwoInnerCompIndex : TauCeti.LieTypeIndex → Prop
  | .twistedA r q => IsTwoPow q 1 ∧ r = 5
  | .D r q => IsTwoPow q 1 ∧ r = 4
  | _ => False

@[expose] def Bal209TwoInnerCompType : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (K : Subgroup X) (a : X), CFSG.Open.IsQuasisimple ↥K →
    IsLieQuot ↥K Bal209TwoIndex → a ^ 3 = 1 → a ∉ Subgroup.centralizer (K : Set X) →
      Bal209F4Aux.InnerAt K a →
        ∀ J : Subgroup X, GLAPComponent 3 (K ⊓ Subgroup.centralizer ({a} : Set X)) J →
          IsLieQuot ↥J TwE6TwoInnerCompIndex

theorem twE6TwoInnerCompIndex_bal207 (d : TauCeti.LieTypeIndex) (hd : TwE6TwoInnerCompIndex d) :
    Bal207Index 3 d ∧ ¬ CFSG.HardMathSupport.Dickson.Bal207.IsG2EightIndex d := by
  cases d <;> simp_all [TwE6TwoInnerCompIndex, Bal207Index,
    CFSG.HardMathSupport.Dickson.Bal207.IsG2EightIndex]

namespace Bal209TwoInnerAux


theorem isComponentOf_centralizer_of_inner {X : Type} [Group X] [Finite X] {K : Subgroup X}
    {a : X} (hKc : CFSG.Open.IsComponentOf K ⊤) (hK : IsLieQuot ↥K Bal209TwoIndex) (ha3 : a ^ 3 = 1)
    (haC : a ∉ Subgroup.centralizer (K : Set X)) (hin : Bal209F4Aux.InnerAt K a) {J : Subgroup X}
    (hJ : GLAPComponent 3 (K ⊓ Subgroup.centralizer ({a} : Set X)) J) :
    CFSG.Open.IsComponentOf J (Subgroup.centralizer ({a} : Set X)) := by
  have hq : CFSG.Open.IsQuasisimple ↥K := hKc.2.2
  have hdvd : 3 ∣ Nat.card ↥K := (bal209TwoParabolic_holds X K hq hK).1
  obtain ⟨k, hk, hc⟩ := hin
  have haN : a ∈ Subgroup.normalizer (K : Set X) := by
    set c := k⁻¹ * a with hcdef
    have hcN : c ∈ Subgroup.normalizer (K : Set X) := by
      rw [Subgroup.mem_normalizer_iff]
      intro x
      constructor
      · intro hx
        have h := Subgroup.mem_centralizer_iff.1 hc x hx
        have e : c * x * c⁻¹ = x := by rw [← h]; group
        rw [e]
        exact hx
      · intro hx
        have h : (c * x * c⁻¹) * c = c * (c * x * c⁻¹) := Subgroup.mem_centralizer_iff.1 hc _ hx
        have e : x = c * x * c⁻¹ := by
          calc x = c⁻¹ * ((c * x * c⁻¹) * c) := by group
            _ = c⁻¹ * (c * (c * x * c⁻¹)) := by rw [h]
            _ = c * x * c⁻¹ := by group
        rw [e]
        exact hx
    have hkN : k ∈ Subgroup.normalizer (K : Set X) := Subgroup.le_normalizer hk
    have e : a = k * c := by rw [hcdef]; group
    rw [e]
    exact Subgroup.mul_mem _ hkN hcN
  have ha1 : a ≠ 1 := fun h => haC (h ▸ Subgroup.one_mem _)
  have hinA : ∀ a' ∈ Subgroup.zpowers a, Bal209F4Aux.InnerAt K a' := by
    intro a' ha'
    have hle : Subgroup.zpowers a ≤ Bal209F4Aux.innerSub K :=
      Subgroup.zpowers_le.2 (Bal209F4Aux.mem_innerSub.2 ⟨k, hk, hc⟩)
    exact Bal209F4Aux.mem_innerSub.1 (hle ha')
  have hloc : IsCompLocallyBalanced 3 1 (Subgroup.zpowers a) K :=
    isCompLocallyBalanced_of_inner (innerOneBalanceThree_barOf hq hK) hinA
  set N := Subgroup.normalizer (K : Set X) with hNdef
  have hKN : K ≤ N := Subgroup.le_normalizer
  have hKn : (K.subgroupOf N).Normal := Subgroup.normal_in_normalizer
  have hcore := CFSG.HardMathSupport.Dickson.I271.core_le_centralizer Nat.prime_three hq hdvd hKN hKn
    haN (Subgroup.mem_zpowers a) ha1 ha3 hloc
  have hsubKN : CFSG.Open.IsSubnormal K N :=
    CFSG.Open.IsSubnormal.step hKN hKn (CFSG.Open.IsSubnormal.refl N)
  have hsubC : CFSG.Open.IsSubnormal (K ⊓ Subgroup.centralizer ({a} : Set X))
      (N ⊓ Subgroup.centralizer ({a} : Set X)) := hsubKN.inf _
  have hcoreK : GLAPPrimeCoreOf 3 (K ⊓ Subgroup.centralizer ({a} : Set X)) ≤
      Subgroup.centralizer (K : Set X) :=
    (glaPPrimeCoreOf_le_of_isSubnormal 3 hsubC).trans hcore
  have hJq : CFSG.Open.IsQuasisimple ↥J :=
    CFSG.HardMathSupport.Solomon.Coordinator.isQuasisimple_of_glaPComponent_of_comm
      Nat.prime_three hJ fun g hg o ho =>
        (Subgroup.mem_centralizer_iff.1 (hcoreK ho) g (hJ.1 hg).1).symm
  have hsubKC : CFSG.Open.IsSubnormal (K ⊓ Subgroup.centralizer ({a} : Set X))
      (Subgroup.centralizer ({a} : Set X)) := by
    have h1 := CFSG.Open.IsSubnormal.inf hKc.2.1 (Subgroup.centralizer ({a} : Set X))
    rwa [top_inf_eq] at h1
  exact ⟨hJ.1.trans inf_le_right, hJ.2.1.trans hsubKC, hJq⟩

end Bal209TwoInnerAux


theorem bal209TwoSLOBIn_of_compType (h207 : CFSG.HardMathSupport.Dickson.Bal207.Bal207Corr)
    (hId : Bal209TwoInnerCompType) : Bal209TwoSLOBIn := by
  intro X _ _ hX K B a hcomp hSC hBN hK _ haB haC hin J hJ hBJ
  left
  have ha3 : a ^ 3 = 1 := hSC.2.1.2 a haB
  have hJc := isComponentOf_centralizer_of_inner hcomp hK ha3 haC hin hJ
  exact KSCompSLOB.sLOB_of_bal207_component h207 hX hSC haB hJc hBJ twE6TwoInnerCompIndex_bal207
    (hId X K a hcomp.2.2 hK ha3 haC hin J hJ)

