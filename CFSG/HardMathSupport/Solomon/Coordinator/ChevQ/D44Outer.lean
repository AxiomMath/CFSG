  CFSG.ComponentClassification.CatalogueBOrthogonalPointData
  CFSG.HardMathSupport.Timmesfeld.DFour

local notation "Inn" => CFSG.ComponentClassification.OuterAutomorphisms.inner

theorem card_le_of_outer_coordinate {K : Type} [Field K] [Finite K] [CharP K 2] {f : ℕ}
    (hK : Nat.card K = 2 ^ f) (hf : ¬ 3 ∣ f) (hQ : coordinateQuadPlus 4 K ≠ 0)
    (hab : ∃ m : ℕ,
      Nat.card (Abelianization (matrixIsometries (coordinateQuadPlus 4 K))) = 2 ^ m)
    (hidx : (matrixProjectiveImage (coordinateQuadPlus 4 K)).index ≤ 3)
    (hcen : Subgroup.center (matrixProjectiveDerived (coordinateQuadPlus 4 K)) = ⊥)
    (X : Subgroup (MulAut (matrixProjectiveDerived (coordinateQuadPlus 4 K))))
    (hX : CFSG.Open.IsElemAbelian 3 X)
    (hXI : ¬ X ≤ Inn (matrixProjectiveDerived (coordinateQuadPlus 4 K))) :
    Nat.card X ≤ 3 ^ 3 := by
  classical
  have hQv :=
    CFSG.ComponentClassification.CatalogueBOrthogonalSemilinearFiltration.exists_nonzero_value
      (coordinateQuadPlus 4 K) hQ
  have hcop : Nat.Coprime 3 f := (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr hf
  have hEI : ∀ y ∈ matrixProjectiveImage (coordinateQuadPlus 4 K), y ^ 3 = 1 →
      y ∈ Inn (matrixProjectiveDerived (coordinateQuadPlus 4 K)) :=
    fun y hy hyp =>
      mem_inner_of_mem_linearRange _ hQv hab Nat.prime_three (by norm_num)
        (mem_linearRange_of_pow_eq_one _ Nat.prime_two hK hcop hy hyp) hyp
  have hXE : ¬ X ≤ matrixProjectiveImage (coordinateQuadPlus 4 K) := fun h =>
    hXI fun x hx => hEI x (h hx) (hX.2 x hx)
  obtain ⟨t, htX, htE⟩ := Set.not_subset.mp hXE
  obtain ⟨A, hA, hfix, hcardA⟩ := exists_fixed_of_mem hcen hX htX
  have h9 : Nat.card A ≤ 9 := card_le_nine_of_charTwo hQv t (hX.2 t htX) htE A hA hfix
  have hmul : (matrixProjectiveImage (coordinateQuadPlus 4 K)).relIndex X *
      Nat.card (matrixProjectiveImage (coordinateQuadPlus 4 K) ⊓ X : Subgroup _) =
        Nat.card X :=
    Subgroup.relIndex_mul_card _ _
  have hY := relIndex_le_three hidx X
  have hle : Nat.card (matrixProjectiveImage (coordinateQuadPlus 4 K) ⊓ X : Subgroup _) ≤
      Nat.card (X ⊓ Inn (matrixProjectiveDerived (coordinateQuadPlus 4 K)) : Subgroup _) := by
    refine Subgroup.card_le_of_le fun y hy => ?_
    obtain ⟨hyE, hyX⟩ := Subgroup.mem_inf.mp hy
    exact Subgroup.mem_inf.mpr ⟨hyX, hEI y hyE (hX.2 y hyX)⟩
  calc Nat.card X
      = (matrixProjectiveImage (coordinateQuadPlus 4 K)).relIndex X *
          Nat.card (matrixProjectiveImage (coordinateQuadPlus 4 K) ⊓ X : Subgroup _) :=
        hmul.symm
    _ ≤ 3 * Nat.card A := by
        rw [hcardA]
        exact Nat.mul_le_mul hY hle
    _ ≤ 3 * 9 := Nat.mul_le_mul_left _ h9
    _ = 3 ^ 3 := by norm_num

theorem card_le_of_outer {T : Type} [Group T] [Finite T] {f : ℕ}
    (hm : StatedClassicalModel T .POmegaPlus 4 2 f) (hcen : Subgroup.center T = ⊥)
    (hf : ¬ 3 ∣ f) (X : Subgroup (MulAut T)) (hX : CFSG.Open.IsElemAbelian 3 X)
    (hXI : ¬ X ≤ Inn T) : Nat.card X ≤ 3 ^ 3 := by
  have h0 := hm
  obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := h0
  obtain ⟨hQ, hab, hidx⟩ := coordinate_facts_four hm K hK e
  have : CharP K 2 := ringChar.of_eq (coordinate_model_witness_plus hm K hK e).1
  set φ := coordinatePlusWitnessEquiv K e with hφ
  have hcen' := center_eq_bot_of_mulEquiv φ hcen
  have hX' : CFSG.Open.IsElemAbelian 3 (X.map (MulAut.congr φ).toMonoidHom) :=
    ⟨by
      have := hX.1
      infer_instance, by
      rintro _ ⟨a, ha, rfl⟩
      change MulAut.congr φ a ^ 3 = 1
      rw [← map_pow, hX.2 a ha, map_one]⟩
  have hXI' : ¬ X.map (MulAut.congr φ).toMonoidHom ≤ Inn (matrixProjectiveDerived _) := by
    intro h
    apply hXI
    intro x hx
    have hmem : (MulAut.congr φ).toMonoidHom x ∈ Inn (matrixProjectiveDerived _) :=
      h ⟨x, hx, rfl⟩
    rw [← CFSG.ComponentClassification.OuterAutomorphisms.inner_map_congr φ] at hmem
    obtain ⟨x', hx', hxx'⟩ := hmem
    have : x' = x := (MulAut.congr φ).injective hxx'
    exact this ▸ hx'
  have h := card_le_of_outer_coordinate hK hf hQ hab hidx hcen' _ hX' hXI'
  rwa [Subgroup.card_map_of_injective (MulAut.congr φ).injective] at h

end CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.D44OuterAux

namespace CFSG.HardMathSupport.Solomon.Coordinator.ChevQ

theorem d44OuterRank_holds :
    D44OuterRank := by
  intro Y _ _ hq _ hQ A hA hAI
  have hZ : Subgroup.center Y = ⊥ := d44_center hq hQ
  obtain ⟨⟨d, hv⟩, hd, ⟨e⟩⟩ := hQ
  cases d with
  | D r q =>
    have hd' : r = 4 ∧ q.p = 2 ∧ q.exponent = 2 := hd
    obtain ⟨rfl, hp, hexp⟩ := hd'
    let eY : Y ≃* (Y ⧸ Subgroup.center Y) :=
      (QuotientGroup.quotientBot.symm).trans (QuotientGroup.quotientMulEquivOfEq hZ.symm)
    have hmod : CFSG.Models.LieModel Y .POmegaPlus 4 q.p q.exponent :=
      CFSG.Models.lieModel_D 4 q hv (eY.trans e)
    rw [hp, hexp] at hmod
    obtain ⟨-, hcl | ⟨h0, -⟩⟩ := hmod
    · exact D44OuterAux.card_le_of_outer hcl hZ (by norm_num) A hA hAI
    · exact absurd h0 (by norm_num)
  | _ => exact absurd hd (by simp [IsD4FourIndex])

end CFSG.HardMathSupport.Solomon.Coordinator.ChevQ
