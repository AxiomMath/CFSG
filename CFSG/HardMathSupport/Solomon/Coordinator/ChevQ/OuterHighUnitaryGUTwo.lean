      exact hplane l i0
    · refine ⟨(Finset.mem_sdiff.1 hi).2, Sum.inl i0, by simp [hS₀], ?_⟩
      have : ({e (Sum.inl i0), e (Sum.inr l)} : Set (Fin n → K)) = Set.range ![a i0, b l] := by
        simp only [he_def, Sum.elim_inl, Sum.elim_inr, Matrix.range_cons, Matrix.range_empty,
