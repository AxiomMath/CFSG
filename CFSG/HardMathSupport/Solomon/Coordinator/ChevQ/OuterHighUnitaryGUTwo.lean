  set e : Fin p ⊕ Fin p → Fin n → K := Sum.elim a b with he_def
  have hc21 : c₂ ≠ c₁ := Ne.symm hc12
  have he : ∀ i j, herm σ₀ (e i) (e j) = if i = j then 1 else 0 := by
    rintro (l | l) (l' | l')
    · by_cases hll : l = l'
