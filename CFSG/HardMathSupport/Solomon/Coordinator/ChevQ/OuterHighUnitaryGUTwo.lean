  have hρζ : ∀ c : ℕ, ρ * ζ ^ c ≠ 0 := fun c => mul_ne_zero hρ (pow_ne_zero _ hζ0)
  have hplane : ∀ l l' : Fin p, AllCenters H (Submodule.span K (Set.range ![a l, b l'])) := by
    intro l l'
