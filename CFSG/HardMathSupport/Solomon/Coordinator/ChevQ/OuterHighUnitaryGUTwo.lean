  set W : Fin p → Submodule K (Fin n → K) :=
    fun l => Module.End.eigenspace (Matrix.toLin' Ym) (ν * ζ ^ (l : ℕ)) with hW
  have horthE : ∀ (s : primeFormUnitary h (idGram K n)) (c : K), c ≠ 0 → h.bar c * c = 1 →
