  set i0 : Fin p := ⟨0, hp.pos⟩ with hi0
  set S₀ : Finset (Fin p ⊕ Fin p) := {Sum.inl i0, Sum.inr i0} with hS₀
  have hS₀card : 2 ≤ S₀.card := by
    rw [hS₀, Finset.card_pair (by simp)]
  have hS₀A : AllCenters H (Submodule.span K (e '' ↑S₀)) := by
