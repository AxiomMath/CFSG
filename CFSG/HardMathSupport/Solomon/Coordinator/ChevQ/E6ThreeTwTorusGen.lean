section Unitary

variable {ℓ f : ℕ} {K : Type} [Field K] (h : UnitaryFieldData ℓ f K)

theorem mem_unitaryIsom3_of_mem_idPrimeForm {A : GL (Fin 3) K}
    (hA : A ∈ primeFormUnitary h (idGram K 3)) : A ∈ unitaryIsom3 h := by
  have hA' := mem_primeFormUnitary.1 hA
  rw [show idGram K 3 = 1 from rfl, Matrix.mul_one] at hA'
  exact hA'

theorem conjSU_eq_suConj (P : primeFormUnitary h (idGram K 3)) :
    conjSU h P = suConj h ⟨(P : GL (Fin 3) K), mem_unitaryIsom3_of_mem_idPrimeForm h P.2⟩ :=
  MulEquiv.ext fun _ => Subtype.ext rfl

theorem conjSU_mul_apply (P Q : primeFormUnitary h (idGram K 3)) (w : unitarySU ℓ f K 3) :
    conjSU h (P * Q) w = conjSU h P (conjSU h Q w) := by
  apply Subtype.ext
  simp only [coe_conjSU, Subgroup.coe_mul]
  group

theorem exists_smul_one_of_suConj_eq_one {A : unitaryIsom3 h} (hA : suConj h A = 1) :
    ∃ c : K, ((A : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) = c • 1 := by
  have hpsu : psuConj h A = 1 := by
    ext x
    induction x using QuotientGroup.induction_on with
    | H g => rw [psuConj_mk, hA]; rfl
  obtain ⟨-, c, -, hc⟩ :=
    eq_one_of_psuConj_mul_psuField_eq_one A 1 (by rw [map_one, mul_one]; exact hpsu)
  refine ⟨(c : K), ?_⟩
  rw [hc]
  simp [Matrix.smul_one_eq_diagonal, Matrix.scalar_apply]

theorem exists_pow_three_smul_one_su {G : Type*} [Group G] {ρ : unitarySU ℓ f K 3 →* G}
    (hρ : Function.Injective ρ) {ε : MulAut G} (hε3 : ε ^ 3 = 1)
    {γ : primeFormUnitary h (idGram K 3)} (hγ : ∀ w, ε (ρ w) = ρ (conjSU h γ w)) :
    ∃ α : K, ((γ : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) ^ 3 = α • 1 := by
  set a : unitaryIsom3 h := ⟨(γ : GL (Fin 3) K), mem_unitaryIsom3_of_mem_idPrimeForm h γ.2⟩
    with ha
  have hact : ∀ w, ε (ρ w) = ρ (suConj h a w) := fun w => by
    rw [hγ, conjSU_eq_suConj]
  have h1 : suConj h (a ^ 3) = 1 := by
    rw [map_pow]
    exact pow_three_eq_one_of_act hρ hε3 hact
  obtain ⟨c, hc⟩ := exists_smul_one_of_suConj_eq_one h h1
  refine ⟨c, ?_⟩
  rw [← hc, Subgroup.coe_pow, Units.val_pow_eq_pow_val]

theorem exists_conjSU_mul_eq (h3 : 3 ∣ ℓ ^ f + 1) {A B : primeFormUnitary h (idGram K 3)}
    (hAB : A * B = B * A) (x : unitarySU ℓ f K 3) {α : K}
    (hx : (((B : GL (Fin 3) K) * (x : GL (Fin 3) K) : GL (Fin 3) K) :
      Matrix (Fin 3) (Fin 3) K) ^ 3 = α • 1) :
    ∃ y : unitarySU ℓ f K 3, conjSU h A⁻¹ x * y = conjSU h B⁻¹ y * x := by
  have hAB' : (A : GL (Fin 3) K) * (B : GL (Fin 3) K) = (B : GL (Fin 3) K) * (A : GL (Fin 3) K) :=
    congrArg Subtype.val hAB
  obtain ⟨y, hy⟩ := exists_suConj_mul_eq h h3
    (A := ⟨(A : GL (Fin 3) K), mem_unitaryIsom3_of_mem_idPrimeForm h A.2⟩)
    (B := ⟨(B : GL (Fin 3) K), mem_unitaryIsom3_of_mem_idPrimeForm h B.2⟩)
    (Subtype.ext hAB') x hx
  refine ⟨y, ?_⟩
  rw [conjSU_eq_suConj, conjSU_eq_suConj]
  exact hy

end Unitary

section Prod


variable {K : Type} [Field K] {σ : K ≃+* K} {ℓ f : ℕ}
  {ρ : Fin 3 → unitarySU ℓ f K 3 →* twistedE6RootGroup K σ}

theorem twLayerProd_conj {g : ModGL TwistTag.E6.tag K}
    {φ : Fin 3 → unitarySU ℓ f K 3 → unitarySU ℓ f K 3}
    (hg : ∀ i w, g⁻¹ * ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) * g =
      ((ρ i (φ i w) : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K))
    (x : Fin 3 → unitarySU ℓ f K 3) :
    g⁻¹ * twLayerProd ρ x * g = twLayerProd ρ (fun i => φ i (x i)) := by
  simp only [twLayerProd, ← hg]
  group

theorem inv_conj_frame {h : UnitaryFieldData ℓ f K} {τ : ModGL TwistTag.E6.tag K}
    {B : Fin 3 → primeFormUnitary h (idGram K 3)}
    (hτ : ∀ i w, τ * ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) * τ⁻¹ =
      ((ρ i (conjSU h (B i) w) : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K))
    (i : Fin 3) (w : unitarySU ℓ f K 3) :
    τ⁻¹ * ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) * τ =
      ((ρ i (conjSU h (B i)⁻¹ w) : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) := by
  have h1 := hτ i (conjSU h (B i)⁻¹ w)
  have h2 : conjSU h (B i) (conjSU h (B i)⁻¹ w) = w := by
    rw [← conjSU_mul_apply, mul_inv_cancel]
    apply Subtype.ext
    simp [coe_conjSU]
  rw [h2] at h1
  rw [← h1]
  group

end Prod

section Torus


theorem twTorusGroup_le_seitzHyperGamma_sup {K : Type} [Field K] {σ : K ≃+* K} {ℓ f : ℕ}
    {h : UnitaryFieldData ℓ f K} (h3 : 3 ∣ ℓ ^ f + 1)
    {h₀ : ModGL TwistTag.E6.tag K} {L : Fin 3 → Subgroup (ModGL TwistTag.E6.tag K)}
    {T : Subgroup (ModGL TwistTag.E6.tag K)} {n : ModGL TwistTag.E6.tag K}
    (hline : TwE6ThreeA2Line K σ h₀ L T n)
    {ρ : Fin 3 → unitarySU ℓ f K 3 →* twistedE6RootGroup K σ}
    (hinj : ∀ i, Function.Injective (ρ i))
    (hrange : ∀ i, (ρ i).range.map (twistedE6RootGroup K σ).subtype = L i)
    (htor : TwTorusAct K σ h₀ T h ρ)
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : IsElemAbelian 3 E)
    (hcard : Nat.card E = 3 ^ 3) (hED : E ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    {s₀ : twistedE6RootGroup K σ} (hs₀ : (s₀ : ModGL TwistTag.E6.tag K) = h₀)
    (hsig : MulAut.conj s₀ ∈ E)
    (hsh : ∀ ε ∈ E, ∃ k : Fin 3, ∀ i, (ρ i).range.map ε.toMonoidHom = (ρ (i + k)).range) :
    T ≤ (seitzHyperGamma 3 E).map (twistedE6RootGroup K σ).subtype ⊔ ⨆ i, L i := by
  have hcard27 : Nat.card E = 27 := by rw [hcard]; norm_num
  obtain ⟨Th, A, hTTh, hThc, hAc, hAact, hDec⟩ := htor
  have hmemL : ∀ i w, ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈ L i :=
    fun i w => by
      rw [← hrange i]
      exact ⟨ρ i w, ⟨w, rfl⟩, rfl⟩
  have hcomm : ∀ i j, i ≠ j → ∀ s t, ρ i s * ρ j t = ρ j t * ρ i s := fun i j hij s t =>
    Subtype.ext (hline.L_commute i j hij _ (hmemL i s) _ (hmemL j t))
  have hπL : ∀ y : Fin 3 → unitarySU ℓ f K 3, twLayerProd ρ y ∈ ⨆ i, L i := fun y =>
    mul_mem (mul_mem (Subgroup.mem_iSup_of_mem 0 (hmemL 0 _))
      (Subgroup.mem_iSup_of_mem 1 (hmemL 1 _))) (Subgroup.mem_iSup_of_mem 2 (hmemL 2 _))
  have hσ1 : MulAut.conj s₀ ≠ 1 := by
    intro h1
    have hc : s₀ ∈ Subgroup.center (twistedE6RootGroup K σ) := by
      rw [Subgroup.mem_center_iff]
      intro g
      have := congrArg (fun φ : MulAut (twistedE6RootGroup K σ) => φ g) h1
      simp only [MulAut.conj_apply, MulAut.one_apply] at this
      exact (mul_inv_eq_iff_eq_mul.1 this).symm
    rw [exceptional_fixed_center_trivial TwistTag.E6 K σ] at hc
    exact hline.h₀_ne (by rw [← hs₀, Subgroup.mem_bot.1 hc]; rfl)
  have hEcomm : ∀ ε ∈ E, ε * MulAut.conj s₀ = MulAut.conj s₀ * ε := fun ε hε =>
    congrArg Subtype.val (hE.1.is_comm.comm (⟨ε, hε⟩ : E) ⟨_, hsig⟩)
  obtain ⟨fe, hfe, hfeσ, hfe0⟩ :=
    exists_notMem_zpowers_map_eq hE hcard27 hsig (R := fun i => (ρ i).range) hsh
  obtain ⟨τ, hτTh, x, hfx⟩ := hDec s₀ hs₀ fe (hED hfe) (hEcomm fe hfe) hfe0
  let P : Fin 3 → primeFormUnitary h (idGram K 3) := fun i =>
    ⟨(x i : GL (Fin 3) K), unitarySU_le_primeFormUnitary h (x i).2⟩
  have hact : ∀ i w, fe (ρ i w) = ρ i (conjSU h (A i τ * P i) w) := by
    intro i w
    apply Subtype.ext
    rw [hfx]
    have h1 : twLayerProd ρ x * ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) *
        (twLayerProd ρ x)⁻¹ =
        ((ρ i (x i * w * (x i)⁻¹) : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) :=
      congrArg Subtype.val (commProd3_conj_apply ρ hcomm x i w)
    have h2 := hAact i τ hτTh (x i * w * (x i)⁻¹)
    have h3' : conjSU h (P i) w = x i * w * (x i)⁻¹ := Subtype.ext rfl
    rw [conjSU_mul_apply, h3']
    calc τ * twLayerProd ρ x * ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) *
          (τ * twLayerProd ρ x)⁻¹
        = τ * (twLayerProd ρ x * ((ρ i w : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) *
          (twLayerProd ρ x)⁻¹) * τ⁻¹ := by group
      _ = _ := by rw [h1]; exact h2
  have hα : ∀ i, ∃ α : K, (((A i τ : GL (Fin 3) K) * (x i : GL (Fin 3) K) : GL (Fin 3) K) :
      Matrix (Fin 3) (Fin 3) K) ^ 3 = α • 1 := fun i => by
    obtain ⟨α, hα⟩ := exists_pow_three_smul_one_su h (hinj i) (hE.2 fe hfe) (hact i)
    exact ⟨α, hα⟩
  choose α hα using hα
  intro t ht
  have htC : t ∈ twistedE6RootGroup K σ := hline.T_le ht
  have htTh : t ∈ Th := hTTh ht
  have hAB : ∀ i, A i t * A i τ = A i τ * A i t := fun i => hAc i t htTh τ hτTh
  choose y hy using fun i => exists_conjSU_mul_eq h h3 (hAB i) (x i) (hα i)
  have hxy : twLayerProd ρ (fun i => conjSU h (A i t)⁻¹ (x i)) * twLayerProd ρ y =
      twLayerProd ρ (fun i => conjSU h (A i τ)⁻¹ (y i)) * twLayerProd ρ x := by
    have h1 : commProd3 ρ hcomm (fun i => conjSU h (A i t)⁻¹ (x i)) * commProd3 ρ hcomm y =
        commProd3 ρ hcomm (fun i => conjSU h (A i τ)⁻¹ (y i)) * commProd3 ρ hcomm x := by
      rw [← map_mul, ← map_mul]
      exact congrArg (commProd3 ρ hcomm) (funext hy)
    exact congrArg Subtype.val h1
  have hPt : t⁻¹ * twLayerProd ρ x * t = twLayerProd ρ (fun i => conjSU h (A i t)⁻¹ (x i)) :=
    twLayerProd_conj (fun i w => inv_conj_frame (B := fun i => A i t)
      (fun i w => hAact i t htTh w) i w) x
  have hQτ : τ⁻¹ * twLayerProd ρ y * τ = twLayerProd ρ (fun i => conjSU h (A i τ)⁻¹ (y i)) :=
    twLayerProd_conj (fun i w => inv_conj_frame (B := fun i => A i τ)
      (fun i w => hAact i τ hτTh w) i w) y
  have key : τ * twLayerProd ρ x * (t * twLayerProd ρ y) =
      t * twLayerProd ρ y * (τ * twLayerProd ρ x) := by
    calc τ * twLayerProd ρ x * (t * twLayerProd ρ y)
        = τ * t * (t⁻¹ * twLayerProd ρ x * t) * twLayerProd ρ y := by group
      _ = τ * t * (twLayerProd ρ (fun i => conjSU h (A i t)⁻¹ (x i)) * twLayerProd ρ y) := by
          rw [hPt]; group
      _ = τ * t * (twLayerProd ρ (fun i => conjSU h (A i τ)⁻¹ (y i)) * twLayerProd ρ x) := by
          rw [hxy]
      _ = τ * t * (τ⁻¹ * twLayerProd ρ y * τ) * twLayerProd ρ x := by rw [hQτ]; group
      _ = t * τ * (τ⁻¹ * twLayerProd ρ y * τ) * twLayerProd ρ x := by rw [hThc τ hτTh t htTh]
      _ = t * twLayerProd ρ y * (τ * twLayerProd ρ x) := by group
  have hcent : ∀ g ∈ T ⊔ ⨆ i, L i, h₀ * g = g * h₀ := fun g hg => by
    have hg' : g ∈ twistedE6RootGroup K σ ⊓ Subgroup.centralizer {h₀} := by
      rw [hline.centralizer_eq]
      exact Subgroup.mem_sup_left hg
    exact Subgroup.mem_centralizer_iff.1 (Subgroup.mem_inf.1 hg').2 h₀ (Set.mem_singleton h₀)
  have hsc : h₀ * (t * twLayerProd ρ y) = t * twLayerProd ρ y * h₀ :=
    hcent _ (mul_mem (Subgroup.mem_sup_left ht) (Subgroup.mem_sup_right (hπL y)))
  let sE : twistedE6RootGroup K σ := ⟨t, htC⟩ * commProd3 ρ hcomm y
  have hsE : (sE : ModGL TwistTag.E6.tag K) = t * twLayerProd ρ y := rfl
  have hσs : MulAut.conj s₀ sE = sE := by
    apply Subtype.ext
    rw [MulAut.conj_apply]
    show (s₀ : ModGL TwistTag.E6.tag K) * (sE : ModGL TwistTag.E6.tag K) *
      (s₀ : ModGL TwistTag.E6.tag K)⁻¹ = (sE : ModGL TwistTag.E6.tag K)
    rw [hs₀, hsE]
    exact mul_inv_eq_iff_eq_mul.2 hsc
  have hfs : fe sE = sE := by
    apply Subtype.ext
    rw [hfx, hsE, key, mul_inv_cancel_right]
  have hsΓ : sE ∈ seitzHyperGamma 3 E :=
    mem_seitzHyperGamma_of_fixed hE hcard27 hsig hfe hσ1 hfeσ hσs hfs
  have hmem : (sE : ModGL TwistTag.E6.tag K) * (twLayerProd ρ y)⁻¹ ∈
      (seitzHyperGamma 3 E).map (twistedE6RootGroup K σ).subtype ⊔ ⨆ i, L i :=
    Subgroup.mul_mem_sup ⟨sE, hsΓ, rfl⟩ (inv_mem (hπL y))
  rwa [hsE, mul_inv_cancel_right] at hmem

theorem twE6ThreeTorusGen_of_model (hm : TwTorusModel) : TwE6ThreeTorusGen := by
  intro K _ _ σ q hK3 hσ hKq h3 hq2 h₀ L T n hline E hE hEc hED _ _ _ ⟨s₀, hs₀, hsig⟩
  obtain ⟨ℓ, f, h, ρ, hqℓ, ⟨hinj, hrange, -⟩, htor⟩ :=
    hm K σ q hK3 hσ hKq h3 hq2 h₀ L T n hline
  have h3' : 3 ∣ ℓ ^ f + 1 := by rw [hqℓ]; exact h3
  refine twTorusGroup_le_seitzHyperGamma_sup h3' hline hinj hrange htor hE hEc hED hs₀ hsig ?_
  intro ε hε
  have hcomm : ε * MulAut.conj s₀ = MulAut.conj s₀ * ε :=
    congrArg Subtype.val (hE.1.is_comm.comm (⟨ε, hε⟩ : E) ⟨_, hsig⟩)
  exact twLayer_exists_shift_frames hline hs₀ (hE.2 ε hε) hcomm ρ hrange

