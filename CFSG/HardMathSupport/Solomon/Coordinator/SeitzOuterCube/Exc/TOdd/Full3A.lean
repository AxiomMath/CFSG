variable {ℓ f : ℕ} {X : Type} [Field X] [Finite X] {σ : X ≃+* X}

theorem cen_le_closure_classX_odd (P : D4ParOdd ℓ f X σ) {E : Subgroup (MulAut (C0 σ))}
    (hE : IsElemAbelian 3 E) (hcard : Nat.card E = 27) {x : C0 σ}
    (hx : MulAut.conj x ∈ E) (hx1 : x ≠ 1) (hxX : IsClassX σ x) {b : C0 σ}
    (hbE : MulAut.conj b ∈ E) (hbx : MulAut.conj b ∉ Subgroup.zpowers (MulAut.conj x)) :
    cenX σ x ≤ Subgroup.closure {l | l ∈ cenX σ x ∧ ∃ y ∈ E,
      y ∉ Subgroup.zpowers (MulAut.conj x : MulAut (C0 σ)) ∧ y l = l} := by
  haveI : Finite (C0 σ) := finite_C0
  have hinj := conj_injective_odd P
  have hx3 : x ^ 3 = 1 := pow_three_of_conj_mem P hE hx
  have hb3 : b ^ 3 = 1 := pow_three_of_conj_mem P hE hbE
  have hbxC : b * x = x * b := by
    apply hinj
    rw [map_mul, map_mul]
    exact comm_of_isElemAbelian hE hbE hx
  have ha'x : b ∉ Subgroup.zpowers x := by
    rintro ⟨k, rfl⟩
    exact hbx ⟨k, by rw [map_zpow]⟩
  obtain ⟨hxD, hZ3c⟩ := classX_layer_odd P hxX
  obtain ⟨hH, hC⟩ := layer_facts_odd' P hxX
  have hZD : ∀ w ∈ layerSub σ x, (∀ d ∈ layerSub σ x, w * d = d * w) →
      w ∈ Subgroup.zpowers x := fun w hw hwc => hZ3c w hw (hC w hw hwc) hwc
  have hH' : ∃ y ∈ layerSub σ x, ∃ p ∈ layerSub σ x,
      p * y * p⁻¹ * y⁻¹ ≠ 1 ∧ (p * y * p⁻¹ * y⁻¹) ^ 3 = 1 ∧
        ∀ d ∈ layerSub σ x, (p * y * p⁻¹ * y⁻¹) * d = d * (p * y * p⁻¹ * y⁻¹) := by
    obtain ⟨y, hy, p, hp, u, -, hu1, hu3, huc, hup⟩ := hH
    exact ⟨y, hy, p, hp, by rw [hup]; exact hu1, by rw [hup]; exact hu3,
      by rw [hup]; exact huc⟩
  obtain ⟨-, hZ3⟩ := layer_center_facts_odd P hxX hxD hZD hH'
  have hDΓ : layerSub σ x ≤ Subgroup.closure {l | l ∈ cenX σ x ∧ ∃ y ∈ E,
      y ∉ Subgroup.zpowers (MulAut.conj x : MulAut (C0 σ)) ∧ y l = l} := by
    refine (layer_le_closure_fixed_odd P hE hcard hx hx1 hxX).trans (Subgroup.closure_mono ?_)
    rintro l ⟨hl, hrest⟩
    exact ⟨layerSub_le_self _ hl, hrest⟩
  have hΓ : ∀ l ∈ cenX σ x, l * b = b * l → l ∈ Subgroup.closure {l | l ∈ cenX σ x ∧
      ∃ y ∈ E, y ∉ Subgroup.zpowers (MulAut.conj x : MulAut (C0 σ)) ∧ y l = l} := by
    intro l hl hlb
    refine Subgroup.subset_closure ⟨hl, MulAut.conj b, hbE, hbx, ?_⟩
    rw [MulAut.conj_apply, ← hlb]
    group
  rcases P.mod_three with hq1 | hq2
  · obtain ⟨F, _, _, -, h3, e, hact⟩ := layer_linear_model_odd P hq1 hxX
    exact centralizer_le_of_layer_linear hx3 hxD hZD hZ3 hbxC hb3 ha'x h3 e hact hDΓ hΓ
  · obtain ⟨F, _, hF, e, hact⟩ := layer_unitary_model_odd P hq2 hxX
    have h3 : 3 ∣ ℓ ^ f + 1 := by omega
    exact centralizer_le_of_layer_unitary hF h3 e hact hx3 hxD hZD hZ3 hbxC hb3 ha'x hDΓ hΓ

end CFSG.HardMathSupport.Solomon.Coordinator.SeitzOuterCube.Exc.TOdd
