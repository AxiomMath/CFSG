theorem exists_kill_set_twistedE6_two {ℓ f : ℕ} (hℓ : ℓ.Prime) (hf : 1 ≤ f)
    (hq3 : (ℓ ^ f) % 3 = 2) (K : Type) [Field K] (hK : Nat.card K = (ℓ ^ f) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) :
    ∃ Q : Subgroup ↥(graphFixedRootGroup TwistTag.E6 K σ.toRingHom),
      Nat.card Q = 3 ^ (Nat.card ↥(graphFixedRootGroup TwistTag.E6 K σ.toRingHom)).factorization 3 ∧
        ∀ s ∈ Q, s ^ 3 = 1 → s ≠ 1 →
          81 ∣ Nat.card (Subgroup.centralizer ({s} : Set ↥(graphFixedRootGroup TwistTag.E6 K
            σ.toRingHom))) := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have hKfin : Finite K := Nat.finite_of_card_ne_zero (by
    rw [hK]; exact pow_ne_zero _ (pow_ne_zero _ hℓ.ne_zero))
  have : Fintype K := Fintype.ofFinite K
  have : CharP K ℓ := charP_of_card_eq_prime_pow (f := f * 2)
    (by rw [← Nat.card_eq_fintype_card, hK, ← pow_mul])
  let L := AlgebraicClosure K
  have : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective ℓ
  have : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  let Fr : L →+* L := iterateFrobenius L ℓ f
  have hFr : ∀ c, Fr c = c ^ (ℓ ^ f) := fun c => iterateFrobenius_def ℓ f c
  have hσ' : ∀ c, σ.toRingHom c = c ^ (ℓ ^ f) := fun c => by
    rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hσ]
  have hq1 : 1 < ℓ ^ f := Nat.one_lt_pow (by omega) hℓ.one_lt
  have hq3' : 3 ∣ ℓ ^ f + 1 := by omega
  have hℓ3 : ℓ ≠ 3 := by
    rintro rfl
    have : 3 ∣ 3 ^ f := dvd_pow_self 3 (by omega)
    omega
  have h3L : ((3 : ℕ) : L) ≠ 0 := by
    intro h
    have := (CharP.cast_eq_zero_iff L ℓ 3).1 h
    exact hℓ3 ((Nat.prime_dvd_prime_iff_eq hℓ Nat.prime_three).1 this)
  have hw0 : ∀ u : Fin TwistTag.E6.tag.rank → ℤ,
      e6HRReflProd • u = -permLattice ρ6 u := fun u => e6HRReflProd_smul u
  obtain ⟨g0, hg0C, hg0⟩ := lang_conjugator_twisted K hf L e6HRReflProd
  set J := graphFixedRootGroup TwistTag.E6 K σ.toRingHom with hJ
  have : Finite (ModGL TwistTag.E6.tag K) := inferInstance
  have hJfin : Finite J := inferInstance
  let ι : ↥J →* ModGL TwistTag.E6.tag L :=
    (baseChangeGL (algebraMap K L)).comp J.subtype
  have hι : Function.Injective ι :=
    (baseChangeGL_injective _).comp (Subgroup.subtype_injective _)
  have hrange : ι.range = J.map (baseChangeGL (algebraMap K L)) := by
    change ((baseChangeGL (algebraMap K L)).comp J.subtype).range = _
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  obtain ⟨hmul, hle, hnormal, -, hcomm⟩ :=
    exceptional_ambient_twisted_Frobenius_fixed_normalizer TwistTag.E6 hℓ hf K hK σ.toRingHom
      hσ' L Fr hFr
  set C' := J.map (baseChangeGL (algebraMap K L)) with hC'
  set R := twistedFixedGroup TwistTag.E6 L Fr with hR
  set X := X6 L Fr e6HRReflProd with hX
  let fc : ModGL TwistTag.E6.tag L →* ModGL TwistTag.E6.tag L := (MulAut.conj g0).toMonoidHom
  have hfc : Function.Injective fc := (MulAut.conj g0).injective
  have hfc_apply : ∀ x, fc x = g0 * x * g0⁻¹ := fun x => rfl
  have hXR : ∀ x ∈ X, fc x ∈ R := by
    intro x hx
    refine (mem_twistedFixedGroup_iff_twistHom _ _ _).2 ⟨?_, ?_⟩
    · rw [hfc_apply]
      exact mul_mem (mul_mem hg0C (X6_le_adjoint Fr _ hx)) (inv_mem hg0C)
    · have h1 := X6_fix hw0 hx
      rw [hfc_apply, map_mul, map_mul, map_inv, hg0]
      calc g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L e6HRReflProd *
            twistHom TwistTag.E6 L Fr x *
            (g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L e6HRReflProd)⁻¹ =
          g0 * (canonicalRep (coxeterSystem TwistTag.E6.tag) L e6HRReflProd *
            twistHom TwistTag.E6 L Fr x *
            (canonicalRep (coxeterSystem TwistTag.E6.tag) L e6HRReflProd)⁻¹) * g0⁻¹ := by group
        _ = g0 * x * g0⁻¹ := by rw [h1]
  set Y : Subgroup (ModGL TwistTag.E6.tag L) := C'.comap fc with hY
  have hYc : ∀ x ∈ X, ∀ y ∈ X, x * y * x⁻¹ * y⁻¹ ∈ Y := by
    intro x hx y hy
    have hc := Subgroup.commutator_mem_commutator (hXR x hx) (hXR y hy)
    rw [hcomm.1, commutatorElement_def] at hc
    change fc (x * y * x⁻¹ * y⁻¹) ∈ C'
    rw [map_mul, map_mul, map_mul, map_inv, map_inv]
    exact hc
  have hYn : ∀ x ∈ X, ∀ y ∈ Y, x * y * x⁻¹ ∈ Y := by
    intro x hx y hy
    have hyC : fc y ∈ C' := hy
    have h1 := hnormal.conj_mem (⟨fc y, hle hyC⟩ : ↥R) (Subgroup.mem_subgroupOf.2 hyC)
      ⟨fc x, hXR x hx⟩
    have h2 : fc x * fc y * (fc x)⁻¹ ∈ C' := Subgroup.mem_subgroupOf.1 h1
    change fc (x * y * x⁻¹) ∈ C'
    rw [map_mul, map_mul, map_inv]
    exact h2
  have hrel : Y.relIndex X ∣ 3 := by
    have h := twisted_E6_relIndex_dvd_three hℓ hf K hK σ.toRingHom hσ' L Fr hFr
      (X := X.map fc) (by
        rintro _ ⟨x, hx, rfl⟩
        exact hXR x hx)
    rwa [← Subgroup.relIndex_comap] at h
  have hC'fin : Finite C' :=
    Finite.of_surjective ((baseChangeGL (algebraMap K L)).subgroupMap J)
      ((baseChangeGL (algebraMap K L)).subgroupMap_surjective J)
  have hYX_fin : Finite ↥(Y ⊓ X) :=
    Finite.of_injective (fun x : ↥(Y ⊓ X) => (⟨fc x.1, (Subgroup.mem_inf.1 x.2).1⟩ : ↥C'))
      (fun x y h => Subtype.ext (hfc (congrArg Subtype.val h)))
  have hm0 : Nat.card ↥(Y ⊓ X) ≠ 0 := Nat.card_pos.ne'
  have hr0 : Y.relIndex X ≠ 0 := fun h => by
    rw [h] at hrel
    exact absurd (Nat.eq_zero_of_zero_dvd hrel) (by norm_num)
  have hcardX : Y.relIndex X * Nat.card ↥(Y ⊓ X) = Nat.card X := Subgroup.relIndex_mul_card Y X
  have hq_ne : (((ℓ ^ f + 1 : ℕ)) : L) ≠ 0 := by
    have hz : ((ℓ : ℕ) : L) = 0 := CharP.cast_eq_zero L ℓ
    have : (((ℓ ^ f + 1 : ℕ)) : L) = 1 := by
      push_cast
      rw [hz, zero_pow (by omega), zero_add]
    rw [this]; exact one_ne_zero
  have hT := card_twistedTorus6 (L := L) hFr hq_ne hw0
  have hdvdX := twistedTorus6_card_mul_dvd (L := L) Fr e6HRReflProd
  rw [hT] at hdvdX
  set v := padicValNat 3 (ℓ ^ f + 1) with hv
  have hn0 : Nat.card X ≠ 0 := by rw [← hcardX]; exact mul_ne_zero hr0 hm0
  have h3pow : 3 ^ (6 * v + 4) ∣ Nat.card X := by
    refine Dvd.dvd.trans ?_ hdvdX
    have h1 : 3 ^ v ∣ ℓ ^ f + 1 := pow_padicValNat_dvd
    have h2 : 3 ^ (6 * v) ∣ (ℓ ^ f + 1) ^ 6 := by
      rw [mul_comm, pow_mul]
      exact pow_dvd_pow_of_dvd h1 6
    have h3 : 3 ^ 4 ∣ 51840 := by norm_num
    rw [pow_add]
    exact mul_dvd_mul h2 h3
  have hvX : 6 * v + 4 ≤ padicValNat 3 (Nat.card X) := (padicValNat_dvd_iff_le hn0).1 h3pow
  have hvsplit : padicValNat 3 (Nat.card X) =
      padicValNat 3 (Y.relIndex X) + padicValNat 3 (Nat.card ↥(Y ⊓ X)) := by
    rw [← hcardX, padicValNat.mul hr0 hm0]
  have hvr : padicValNat 3 (Y.relIndex X) ≤ 1 := by
    rcases (Nat.dvd_prime Nat.prime_three).1 hrel with h | h
    · rw [h]; simp
    · rw [h, padicValNat_self]
  have hvJ : padicValNat 3 (Nat.card J) = 6 * v + 3 := by
    rw [card_graphFixedRootGroup_E6 hℓ hf hK σ.toRingHom hσ',
      padicValNat_three_ordTwistedE6_of_mod_two hq1 hq3]
  set Z : Subgroup (ModGL TwistTag.E6.tag L) := (X ⊓ Y).map fc with hZdef
  have hZr : Z ≤ ι.range := by
    rintro _ ⟨x, hx, rfl⟩
    rw [hrange]
    exact (Subgroup.mem_inf.1 hx).2
  have hcardZ : Nat.card Z = Nat.card ↥(Y ⊓ X) := by
    rw [hZdef, Subgroup.card_map_of_injective hfc, inf_comm]
  have hZ3 : (Nat.card J).factorization 3 ≤ (Nat.card Z).factorization 3 := by
    rw [Nat.factorization_def _ Nat.prime_three, Nat.factorization_def _ Nat.prime_three,
      hvJ, hcardZ]
    omega
  refine exists_kill_set_of_landing ι hι Z hZr hZ3 ?_
  rintro _ ⟨x, hx, rfl⟩ hz3
  have hxX : x ∈ X := (Subgroup.mem_inf.1 hx).1
  have hxY : x ∈ Y := (Subgroup.mem_inf.1 hx).2
  have hx3 : x ^ 3 = 1 := hfc (by rw [map_pow, hz3, map_one])
  obtain ⟨B, hB1, hB2, hB3, hB4, hB5⟩ :=
    exists_three_subgroup_X6 hFr hq3' h3L hw0 Y hYc hYn hxY hxX hx3
  refine ⟨B.map fc, ?_, ?_, ?_, ?_, ?_⟩
  · rintro _ ⟨b, hb, rfl⟩
    rw [hrange]
    exact (Subgroup.mem_inf.1 (hB1 hb)).1
  · rintro _ ⟨b, hb, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul]
    exact congrArg fc (Subgroup.mem_centralizer_singleton_iff.1 (hB2 hb))
  · exact Finite.of_surjective (fc.subgroupMap B) (fc.subgroupMap_surjective B)
  · rintro _ ⟨b, hb, rfl⟩
    rw [← map_pow, hB4 b hb, map_one]
  · rw [Subgroup.card_map_of_injective hfc]
    exact hB5

