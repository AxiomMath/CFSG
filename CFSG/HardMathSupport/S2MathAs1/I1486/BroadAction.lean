theorem C3_innAutDerived_eq_inner_broad {f : ℕ} (hf : 1 ≤ f) {Q : Type} [Group Q] [Finite Q]
    (hlab : CFSG.StandardType.GGHasLabel ⟨.C, 3, f⟩ Q) :
    CFSG.ComponentClassification.OuterAutomorphisms.innAutDerived Q =
      CFSG.ComponentClassification.OuterAutomorphisms.inner Q := by
  dsimp only [CFSG.StandardType.GGHasLabel, CFSG.StandardType.LargeEvenRawDatum,
    CFSG.Assembly.LargeEvenRecipeSymplectic] at hlab
  obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hlab
  letI : Field K := hKfield
  letI : Finite K := hKfinite
  obtain ⟨e⟩ := hQ
  let e' : Q ≃* StatedProj (StatedSp 3 K) := e
  haveI : CharP K 2 := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hKcard
  have hSp : innAutDerived (StatedProj (StatedSp 3 K)) =
      CFSG.ComponentClassification.OuterAutomorphisms.inner (StatedProj (StatedSp 3 K)) :=
    CFSG.LocalAnalysis.GLTheoremA.KD264Lie.F8Sp.sp_innAutDerived_eq_inner (n := 3) (K := K)
      (by norm_num)
  apply le_antisymm
  · intro α hα
    have h1 : MulAut.congr e' α ∈ innAutDerived (StatedProj (StatedSp 3 K)) :=
      (mem_innAutDerived_congr e' (α := α)).2 hα
    rw [hSp] at h1
    exact (congr_mem_inner_iff e' α).1 h1
  · exact CFSG.ComponentClassification.OuterAutomorphisms.inner_le_innAutDerived Q

theorem f4_rational_C3_inner_action
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p p₀ f : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2)
    (S : LangSetup Tag.F4 L p₀) {a : Fin Tag.F4.rank → Lˣ}
    (hT : rootDiagUnit Tag.F4 a ∈ S.D.torus)
    (hap : ∀ j, a j ^ p = 1) (h1 : rootDiagUnit Tag.F4 a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (hqs : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i))
    (hf : 1 ≤ f)
    (hlab : CFSG.StandardType.GGHasLabel ⟨.C, 3, f⟩
      (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)))
    (y : ModGL Tag.F4 L)
    (hyZ : y ∈ torusGroup Tag.F4 L ⊔ rootSpan Tag.F4 L (kernelRoots (rootCharHom a)))
    (hyF : S.D.step y = y)
    (hyStab : MulAut.conj y ∈ subgroupStabAut
      (rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    ∃ x ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i,
      ∀ z ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i,
        y * z * y⁻¹ = x * z * x⁻¹ := by
  classical
  have hAction : ExcKernelCompAction :=
    excKernelCompAction_of twoDExcFixedPointsPerfectAll_holds innerKindSmallCompAction_holds
      (excHighRankCompAction_of_fixedPerfect excHighRankFixedPerfectAll_holds
        excHighRankCubeTransfer_holds)
  let R : Subgroup (ModGL Tag.F4 L) := rationalComponent S.ρ S.Γ (rootCharHom a) i
  haveI : Finite ↥R := finite_rationalComponent S i
  haveI : Finite (↥R ⧸ Subgroup.center ↥R) :=
    Finite.of_surjective (QuotientGroup.mk' (Subgroup.center ↥R))
      (QuotientGroup.mk'_surjective _)
  haveI : Group.IsPerfect ↥R := hqs.1
  let alpha : MulAut ↥R := subgroupStabRestrict R ⟨MulAut.conj y, hyStab⟩
  have hp₀2 : p₀ ≠ 2 := by
    rintro rfl
    exact S.hpq ((CharP.cast_eq_zero_iff L 2 S.D.q).mp S.hqpow.2)
  have hTp : rootDiagUnit Tag.F4 a ^ p = 1 :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.rootDiagUnit_pow_eq_one_of_forall hap
  have h360 : Nat.card (↥R ⧸ Subgroup.center ↥R) ≠ 360 := by
    intro hcard
    have h7 : 7 ∣ Nat.card (↥R ⧸ Subgroup.center ↥R) :=
      CFSG.StandardType.KG.kg_seven_dvd_card_C (X := ↥R ⧸ Subgroup.center ↥R)
        (k := 3) (f := f) (by omega) hlab
    rw [hcard] at h7
    norm_num at h7
  have hInn : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥R alpha ∈
      innAutDerived (↥R ⧸ Subgroup.center ↥R) :=
    hAction S S.hp hp₀2 hp hp2 (Or.inr (Or.inl rfl)) hT hap hTp h1
      (fun h => absurd h (by decide)) i hqs h360 hyZ hyF hyStab
  have hInner : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥R alpha ∈
      CFSG.ComponentClassification.OuterAutomorphisms.inner (↥R ⧸ Subgroup.center ↥R) := by
    rw [← C3_innAutDerived_eq_inner_broad (Q := ↥R ⧸ Subgroup.center ↥R) (f := f) hf hlab]
    exact hInn
  obtain ⟨q, hq⟩ := hInner
  obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective (Subgroup.center ↥R) q
  have heq : MulAut.conj x = subgroupStabRestrict R ⟨MulAut.conj y, hyStab⟩ :=
    CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom_injective ↥R (by
      calc CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥R (MulAut.conj x)
          = MulAut.conj (QuotientGroup.mk' (Subgroup.center ↥R) x) := centerQuotient_conj x
        _ = MulAut.conj q := by rw [hx]
        _ = CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥R alpha := hq)
  refine ⟨(x : ModGL Tag.F4 L), x.2, fun z hz => ?_⟩
  let z' : ↥R := ⟨z, hz⟩
  have h := congrArg (fun g : MulAut ↥R => (g z' : ModGL Tag.F4 L)) heq
  rw [MulAut.conj_apply, subgroupStabRestrict_apply, MulAut.conj_apply] at h
  simp only [Subgroup.coe_mul, Subgroup.coe_inv] at h
  exact h.symm

