@[expose] def betaVecs7 : List (List ℤ) := betaRaw7.map unshift

theorem betaWords7_spec : ∀ i : Fin 126,
    (betaWords7.getD i []).foldr reflectL7 (List.ofFn (Pi.single n7 (1 : ℤ))) =
      betaVecs7.getD i [] := by
  decide +kernel

theorem betaVecs7_check : ∀ i i' : Fin 126, i ≠ i' →
    1 ≤ contentL (subL (betaVecs7.getD i []) (betaVecs7.getD i' [])) ∧
      contentL (subL (betaVecs7.getD i []) (betaVecs7.getD i' [])) ≤ 2 := by
  decide +kernel

theorem exists_betaFamily7 :
    ∃ w : Fin 126 → WeylGroup .E7, ∀ i i', i ≠ i' → ∀ d : ℕ, 3 ≤ d →
      ¬ ∀ c, (d : ℤ) ∣ (w i • (Pi.single n7 1 : Fin Tag.E7.rank → ℤ) -
        w i' • (Pi.single n7 1 : Fin Tag.E7.rank → ℤ)) c := by
  refine ⟨fun i => (coxeterSystem .E7).wordProd (betaWords7.getD i []), fun i i' hii' d hd => ?_⟩
  apply not_dvd_of_content7 _ d hd
  simp only [wordProd_smul']
  rw [ofFn_foldr_reflect7, ofFn_foldr_reflect7, betaWords7_spec, betaWords7_spec]
  exact betaVecs7_check i i' hii'

