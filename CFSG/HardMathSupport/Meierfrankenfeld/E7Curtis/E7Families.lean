@[expose] def n7 : Fin Tag.E7.rank := ⟨6, by decide⟩

@[expose] def n1 : Fin Tag.E7.rank := ⟨0, by decide⟩

@[expose] def e7Theta7 : Fin Tag.E7.rank → ℤ := ![2, 3, 4, 6, 5, 4, 3]

@[expose] def e7Theta1 : Fin Tag.E7.rank → ℤ := ![2, 2, 3, 4, 3, 2, 1]

theorem mExp_e7Theta7 : ∀ i : Fin Tag.E7.rank, mExp .E7 i e7Theta7 = if i = n7 then 2 else 0 := by
  decide +kernel

theorem mExp_e7Theta1 : ∀ i : Fin Tag.E7.rank, mExp .E7 i e7Theta1 = if i = n1 then 1 else 0 := by
  decide +kernel

theorem e7Omega2_mul_cartan : ∀ l j : Fin Tag.E7.rank,
    ∑ c, e7Omega2 c l * Tag.E7.cartan c j = if l = j then 2 else 0 := by
  decide +kernel

theorem e7_dvd_of_dvd_mExp (m : ℤ) (hm : Odd m) (δ : Fin Tag.E7.rank → ℤ)
    (h : ∀ c, m ∣ mExp .E7 c δ) : ∀ l, m ∣ δ l := by
  intro l
  have h1 : 2 * δ l = ∑ c, e7Omega2 c l * mExp .E7 c δ := by
    unfold mExp
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    have : ∀ j, ∑ c, e7Omega2 c l * (Tag.E7.cartan c j * δ j) =
        (if l = j then 2 else 0) * δ j := by
      intro j
      rw [← e7Omega2_mul_cartan l j, Finset.sum_mul]
      exact Finset.sum_congr rfl fun c _ => by ring
    simp only [this]
    simp
  have h2 : m ∣ 2 * δ l := by
    rw [h1]
    exact Finset.dvd_sum fun c _ => dvd_mul_of_dvd_right (h c) _
  have hcop : IsCoprime m 2 := by
    obtain ⟨t, rfl⟩ := hm
    exact ⟨1, -t, by ring⟩
  exact hcop.dvd_of_dvd_mul_left h2

theorem subL_ofFn7 (x y : Fin Tag.E7.rank → ℤ) :
    subL (List.ofFn x) (List.ofFn y) = List.ofFn (x - y) := by
  unfold subL
  refine List.ext_getElem (by simp) fun n h1 h2 => ?_
  simp

theorem not_dvd_of_content7 {x y : Fin Tag.E7.rank → ℤ}
    (h : 1 ≤ contentL (subL (List.ofFn x) (List.ofFn y)) ∧
      contentL (subL (List.ofFn x) (List.ofFn y)) ≤ 2) (d : ℕ) (hd : 3 ≤ d) :
    ¬ ∀ c, (d : ℤ) ∣ (x - y) c := by
  intro hc
  have h1 : d ∣ contentL (subL (List.ofFn x) (List.ofFn y)) := by
    refine dvd_contentL d _ fun z hz => ?_
    rw [subL_ofFn7, List.mem_ofFn] at hz
    obtain ⟨c, rfl⟩ := hz
    exact hc c
  have := Nat.le_of_dvd (by omega) h1
  omega

@[expose] def goodB (x : ℤ) : Bool :=
  x != 0 && decide (-12 ≤ x) && decide (x ≤ 12) && x % 7 != 0

theorem not_dvd_of_goodB {n : ℕ} (hn : 3 ≤ n) {x : ℤ} (h : goodB x = true) :
    ¬ ((2 ^ n - 1 : ℕ) : ℤ) ∣ x := by
  simp only [goodB, Bool.and_eq_true, bne_iff_ne, ne_eq, decide_eq_true_eq] at h
  obtain ⟨⟨⟨h0, hlo⟩, hhi⟩, h7⟩ := h
  intro hd
  have h8 : 8 ≤ 2 ^ n := by
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hle : 2 ^ n - 1 ≤ x.natAbs := Nat.le_of_dvd (Int.natAbs_pos.2 h0)
    (Int.natCast_dvd.1 hd)
  have habs : x.natAbs ≤ 12 := by omega
  have hn3 : n = 3 := by
    by_contra hne
    have : 16 ≤ 2 ^ n := by
      calc 16 = 2 ^ 4 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  subst hn3
  apply h7
  have : (7 : ℤ) ∣ x := by simpa using hd
  exact Int.emod_eq_zero_of_dvd this

@[expose] def unshift (l : List ℕ) : List ℤ := l.map fun x => (x : ℤ) - 64

@[expose] def fcB (c : ℤ) (sp sq : Fin Tag.E7.rank) (xp xq : List ℤ) : Bool :=
  (List.finRange Tag.E7.rank).any (fun l => decide (l ≠ sp) && decide (l ≠ sq) &&
      goodB (xp.getD l 0 - xq.getD l 0)) ||
    (decide (sp ≠ sq) && (xp.getD sp 0 - xq.getD sp 0 == 0 || xp.getD sp 0 - xq.getD sp 0 == c ||
      xp.getD sp 0 - xq.getD sp 0 == -c))

theorem getD_ofFn7 (x : Fin Tag.E7.rank → ℤ) (l : Fin Tag.E7.rank) : (List.ofFn x).getD l 0 = x l := by
  simp [List.getD_eq_getElem?_getD]

theorem fc_of_fcB {n : ℕ} (hn : 3 ≤ n) {c : ℤ} {sp sq : Fin Tag.E7.rank}
    {x y : Fin Tag.E7.rank → ℤ} (h : fcB c sp sq (List.ofFn x) (List.ofFn y) = true) :
    (∃ l, l ≠ sp ∧ l ≠ sq ∧ ¬ ((2 ^ n - 1 : ℕ) : ℤ) ∣ (x - y) l) ∨
      (sp ≠ sq ∧ ((x - y) sp = 0 ∨ (x - y) sp = c ∨ (x - y) sp = -c)) := by
  simp only [fcB, getD_ofFn7, Bool.or_eq_true, List.any_eq_true, List.mem_finRange, true_and,
    Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  rcases h with ⟨l, ⟨hl1, hl2⟩, hl⟩ | ⟨hs, hx⟩
  · exact Or.inl ⟨l, hl1, hl2, by simpa [Pi.sub_apply] using not_dvd_of_goodB hn hl⟩
  · refine Or.inr ⟨hs, ?_⟩
    simp only [Pi.sub_apply]
    rcases hx with (hx | hx) | hx
    · exact Or.inl hx
    · exact Or.inr (Or.inl hx)
    · exact Or.inr (Or.inr hx)

