section General

variable {G : Type} [Group G] [Finite G]

omit [Finite G] in
theorem normal_pCoreOf (N : Subgroup G) [hN : N.Normal] (r : ℕ) : (Open.pCoreOf r N).Normal := by
  have := LieType.BorelTits.pCore_characteristic (G := ↥N) r
  have h := LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic (H := N)
    (Open.pCore r ↥N)
  rw [Subgroup.normalizer_eq_top_iff.mpr hN] at h
  exact Subgroup.normalizer_eq_top_iff.mp (top_le_iff.mp h)

theorem pCoreOf_three_eq_bot (N : Subgroup G) (h3 : ¬ 3 ∣ Nat.card N) : Open.pCoreOf 3 N = ⊥ := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hP : IsPGroup 3 (Open.pCoreOf 3 N) := LieType.BorelTits.pCoreOf_isPGroup 3 N
  rw [eq_bot_iff]
  intro x hx
  have hxN : x ∈ N := LieType.BorelTits.pCoreOf_le 3 N hx
  obtain ⟨k, hk⟩ := hP ⟨x, hx⟩
  have hxk : x ^ 3 ^ k = 1 := by simpa using congrArg Subtype.val hk
  have hord : orderOf x ∣ 3 ^ k := orderOf_dvd_of_pow_eq_one hxk
  have hdvd : orderOf x ∣ Nat.card N := by
    have := orderOf_dvd_natCard (⟨x, hxN⟩ : N)
    simpa using this
  obtain ⟨i, -, hi⟩ := (Nat.dvd_prime_pow Nat.prime_three).1 hord
  have hi0 : i = 0 := by
    by_contra hne
    exact h3 ((dvd_pow_self 3 hne).trans (hi ▸ hdvd))
  rw [Subgroup.mem_bot, ← orderOf_eq_one_iff, hi, hi0, pow_zero]

end General

section Offender

theorem commutator_eq_bot_of_normal_of_not_three_dvd
    (G : Type) [Group G] [Finite G] (W : Type) [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (ρ : Representation (ZMod 2) G W) (hρ : Function.Injective ρ) (hK : CFSG.Open.IsKGroup G)
    (hO2 : CFSG.pCore 2 G = ⊥) (B : Subgroup G) (hBel : CFSG.IsElementaryAbelian 2 B)
    (hBb : CFSG.RankThree.FFModules.IsBestOffender ρ B) (N : Subgroup G) [hN : N.Normal]
    (h3 : ¬ 3 ∣ Nat.card N) : ⁅N, B⁆ = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hBP : IsPGroup 2 B := CFSG.IsElementaryAbelian.isPGroup 2 B
  have hBN : B ≤ Subgroup.normalizer (N : Set G) := by
    rw [Subgroup.normalizer_eq_top_iff.mpr hN]
    exact le_top
  have hO2N : pCoreOf 2 N = ⊥ := by
    have hle : pCoreOf 2 N ≤ CFSG.pCore 2 G :=
      le_sSup ⟨normal_pCoreOf N 2, LieType.BorelTits.pCoreOf_isPGroup 2 N⟩
    rw [hO2] at hle
    exact le_bot_iff.mp hle
  have hodd : ∀ q : ℕ, q.Prime → q ≠ 2 → pCoreOf q N ≤ Subgroup.centralizer (B : Set G) := by
    intro q hq hq2
    have : Fact q.Prime := ⟨hq⟩
    by_cases hq3 : q = 3
    · subst hq3
      rw [pCoreOf_three_eq_bot N h3]
      exact bot_le
    · have hq5 : 5 ≤ q := hq.five_le_of_ne_two_of_ne_three hq2 hq3
      exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp
        (oddPrimeCoreExclusion G W ρ hρ hO2 q hq hq5 (pCoreOf q N) B
          (LieType.BorelTits.pCoreOf_isPGroup q N) (normal_pCoreOf N q) hBel hBb)
  have hNsub : IsSubnormal N ⊤ :=
    CFSG.ClassicalInvolution.isSubnormal_of_normal_subgroupOf le_top Subgroup.normal_subgroupOf
  have hcomp : ∀ K : Subgroup G, IsComponentOf K N → K ≤ Subgroup.centralizer (B : Set G) := by
    intro K hKN
    obtain ⟨hKle, hsub, hqs⟩ := hKN
    have hKo : IsComponentOf K ⊤ := ⟨le_top, LargeExtraspecial.AS35K.isSubnormal_trans hsub hNsub, hqs⟩
    have hKc : CFSG.IsComponent K := Quasithin.H13.A5.isComponent_of_isComponentOf_top hKo
    have hK3 : ¬ 3 ∣ Nat.card K := fun h => h3 (h.trans (Subgroup.card_dvd_of_le hKle))
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp
      (commutator_eq_bot_of_isComponent_of_not_three_dvd G W ρ hρ hK hO2 B hBel hBb K hKc hK3)
  have hF : quasithinGenFitting N ≤ Subgroup.centralizer (B : Set G) := by
    refine sup_le (sSup_le fun M hM => ?_) (sSup_le fun K hK => hcomp K hK)
    exact F918V3S1.nilpotent_normal_le_centralizer hO2N hodd hM.1 hM.2.1 hM.2.2
  have hBF : B ≤ Subgroup.centralizer (quasithinGenFitting N : Set G) :=
    Subgroup.le_centralizer_iff.mpr hF
  have hBc : B ≤ Subgroup.centralizer (N : Set G) :=
    centralizer_of_centralizes_genFitting hBP hBN hO2N hBF
  rw [Subgroup.commutator_comm]
  exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hBc

end Offender

