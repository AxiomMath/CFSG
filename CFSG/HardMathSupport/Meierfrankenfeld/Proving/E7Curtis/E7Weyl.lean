theorem reflect_e7Omega2 : ∀ s j : Fin Tag.E7.rank, j ≠ s → reflect .E7 j (e7Omega2 s) = e7Omega2 s := by
  decide +kernel

@[expose] def reflectL7 (i : Fin Tag.E7.rank) (l : List ℤ) : List ℤ :=
  List.ofFn fun j : Fin Tag.E7.rank =>
    l.getD j 0 - if j = i then (List.finRange Tag.E7.rank).map
      (fun k => Tag.E7.cartan i k * l.getD k 0) |>.sum else 0

theorem ofFn_reflect7 (i : Fin Tag.E7.rank) (v : Fin Tag.E7.rank → ℤ) :
    List.ofFn (reflect .E7 i v) = reflectL7 i (List.ofFn v) := by
  unfold reflectL7 reflect
  refine congrArg List.ofFn (funext fun j => ?_)
  simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, Pi.sub_apply, Pi.smul_apply,
    smul_eq_mul]
  have hs : ∑ k, Tag.E7.cartan i k * v k =
      ((List.finRange Tag.E7.rank).map (fun k => Tag.E7.cartan i k * (List.ofFn v).getD k 0)).sum := by
    rw [Fin.sum_univ_def]
    refine congrArg List.sum (List.map_congr_left fun k _ => ?_)
    simp [List.getD_eq_getElem?_getD]
  rw [hs]
  by_cases hj : j = i <;> simp [hj]

theorem ofFn_foldr_reflect7 (l : List (Fin Tag.E7.rank)) (v : Fin Tag.E7.rank → ℤ) :
    List.ofFn (l.foldr (reflect .E7) v) = l.foldr reflectL7 (List.ofFn v) := by
  induction l with
  | nil => rfl
  | cons i l ih => rw [List.foldr_cons, List.foldr_cons, ofFn_reflect7, ih]

@[expose] def codeE7 (l : List ℤ) : ℕ := l.foldr (fun x a => (x + 64).toNat + 128 * a) 0

