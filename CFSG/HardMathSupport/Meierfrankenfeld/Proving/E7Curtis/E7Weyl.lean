@[expose] def orbitWordsRevE7 (tbl : List ℕ) : List (List (Fin Tag.E7.rank)) :=
  tbl.foldl (fun acc c => (⟨c % 7, Nat.mod_lt _ (by decide)⟩ ::
    acc.getD (acc.length - 1 - c / 7) []) :: acc) [[]]

@[expose] def orbitWordsE7 (tbl : List ℕ) : List (List (Fin Tag.E7.rank)) :=
  (orbitWordsRevE7 tbl).reverse

theorem orbitWordsE7_check : ∀ s : Fin 5,
    (orbitWordsE7 (orbitTablesE7.getD s [])).length = 533 ∧
      strictB (msortBig ((orbitWordsE7 (orbitTablesE7.getD s [])).map fun l =>
        codeE7 (l.foldr reflectL7 (List.ofFn (e7Omega2 (node5 s)))))) = true := by
  decide +kernel

theorem exists_orbit_e7Omega2
    (s : Fin Tag.E7.rank) (hs : 1 ≤ s.val ∧ s.val ≤ 5) :
    ∃ w : Fin 533 → WeylGroup .E7, ∀ i j, i ≠ j → w i • e7Omega2 s ≠ w j • e7Omega2 s := by
  obtain ⟨s', rfl⟩ : ∃ s' : Fin 5, node5 s' = s := by
    refine ⟨⟨s.val - 1, by omega⟩, Fin.ext ?_⟩
    simp only [node5]
    omega
  obtain ⟨hlen, hch⟩ := orbitWordsE7_check s'
  have hnd := nodup_of_strictB_big hch
  set ws := orbitWordsE7 (orbitTablesE7.getD s' [])
  refine ⟨fun i => (coxeterSystem .E7).wordProd (ws.get (i.cast hlen.symm)), fun i j hij h => ?_⟩
  rw [wordProd_smul', wordProd_smul'] at h
  have h2 := congrArg (fun v => codeE7 (List.ofFn v)) h
  simp only [ofFn_foldr_reflect7] at h2
  have hinj := List.nodup_iff_injective_get.1 hnd
  have hi : (i : ℕ) < (ws.map fun l => codeE7 (List.foldr reflectL7
      (List.ofFn (e7Omega2 (node5 s'))) l)).length := by simp [hlen]
  have hj : (j : ℕ) < (ws.map fun l => codeE7 (List.foldr reflectL7
      (List.ofFn (e7Omega2 (node5 s'))) l)).length := by simp [hlen]
  have := hinj (a₁ := ⟨i, hi⟩) (a₂ := ⟨j, hj⟩) (by simpa using h2)
  exact hij (Fin.ext (by simpa using congrArg Fin.val this))

