theorem exists_conjAut_fieldAut_two (α : MulAut (projectiveSL 2 K)) :
    ∃ (A : GL (Fin 2) K) (φ : K ≃+* K), α = conjAut 2 K A * fieldAut 2 K φ := by
  obtain ⟨x, hx⟩ := semilinearAction_surjective K ((MulAut.congr (psl2Equiv K)).symm α)
  have hxdec := SemidirectProduct.inl_left_mul_inr_right x
  obtain ⟨A, hA⟩ := Matrix.ProjGenLinGroup.mk_surjective x.left
  refine ⟨A, x.right, ?_⟩
  have h1 : (MulAut.congr (psl2Equiv K)).symm α = pglAction K x.left * psl2FieldAut K x.right := by
    rw [← hx]
    conv_lhs => rw [← hxdec]
    rw [map_mul, semilinearAction_inl, semilinearAction_inr]
  have h2 : α = MulAut.congr (psl2Equiv K) ((MulAut.congr (psl2Equiv K)).symm α) :=
    ((MulAut.congr (psl2Equiv K)).apply_symm_apply α).symm
  have hcongr : ∀ A : GL (Fin 2) K,
      MulAut.congr (psl2Equiv K) (pglAction K (Matrix.ProjGenLinGroup.mk A)) = conjAut 2 K A :=
    fun A => congr_pglAction_mk A
  rw [h2, h1, map_mul, ← hA, hcongr, congr_psl2FieldAut]

theorem transvection_pow_natCast {R : Type*} [CommRing R] {i j : Fin 2} (hij : i ≠ j) (c : R)
    (m : ℕ) :
    Matrix.SpecialLinearGroup.transvection hij c ^ m =
      Matrix.SpecialLinearGroup.transvection hij ((m : R) * c) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, ih, ← Matrix.SpecialLinearGroup.transvection_add]
    congr 1
    push_cast
    ring

theorem transvection_pow_char {R : Type*} [CommRing R] {p : ℕ} [CharP R p] {i j : Fin 2}
    (hij : i ≠ j) (c : R) : Matrix.SpecialLinearGroup.transvection hij c ^ p = 1 := by
  rw [transvection_pow_natCast, CharP.cast_eq_zero, zero_mul]
  simp

open Matrix CFSG.RankThree.LinearPointwise in
theorem mem_zpowers_fieldAut_of_fixes_two {p : ℕ} [Fact p.Prime] [CharP K p] {k : Subfield K}
    {σ : K ≃+* K} (hk : ∀ x, x ∈ k ↔ σ x = x) {α : MulAut (projectiveSL 2 K)}
    (hα : ∀ x ∈ (linearSubfieldInclusion 2 k).range, α x = x) :
    α ∈ Subgroup.zpowers (fieldAut 2 K σ) := by
  obtain ⟨A, φ, rfl⟩ := exists_conjAut_fieldAut_two α
  set ψ : MulAut (SpecialLinearGroup (Fin 2) K) :=
    CatalogueBHigherLinearAction.slConjugation 2 K A *
      CatalogueBHigherLinearField.slFieldAut (Fin 2) K φ with hψ
  have hdesc : conjAut 2 K A * fieldAut 2 K φ = descendAut 2 K ψ := by
    rw [hψ, map_mul]
    rfl
  have hroot : ∀ (i j : Fin 2) (hij : i ≠ j) (c : K), c ∈ k →
      ψ (SpecialLinearGroup.transvection hij c) = SpecialLinearGroup.transvection hij c := by
    intro i j hij c hc
    have hmem : proj 2 K (SpecialLinearGroup.transvection hij c) ∈
        (linearSubfieldInclusion 2 k).range := by
      refine mem_range_linearSubfieldInclusion.2
        ⟨SpecialLinearGroup.transvection hij c, fun a b => ?_, rfl⟩
      rw [SpecialLinearGroup.transvection_coe]
      simp only [Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
      split_ifs <;> first
        | exact k.zero_mem
        | exact k.one_mem
        | exact hc
        | exact add_mem k.one_mem hc
        | simp_all
    have h1 := hα _ hmem
    rw [hdesc, descendAut_proj] at h1
    exact eq_of_proj_eq_of_pow_eq_one (p := p) (by norm_num) ψ.toMonoidHom (a := 1)
      (by rw [pow_one]; exact transvection_pow_char hij c) h1
  set M : Matrix (Fin 2) (Fin 2) K := (A : Matrix (Fin 2) (Fin 2) K) with hM
  set N : Matrix (Fin 2) (Fin 2) K := ((A⁻¹ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) with hN
  have hMN : M * N = 1 := by rw [hM, hN, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hNM : N * M = 1 := by rw [hM, hN, ← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hrel : ∀ (i j : Fin 2) (hij : i ≠ j) (c : K), c ∈ k →
      M * single i j (φ c) = single i j c * M := by
    intro i j hij c hc
    have h1 := congrArg (fun g : SpecialLinearGroup (Fin 2) K => (g : Matrix (Fin 2) (Fin 2) K))
      (hroot i j hij c hc)
    simp only [hψ, MulAut.mul_apply] at h1
    rw [CatalogueBHigherLinearAction.slConjugation_matrix, slFieldAut_apply,
      SpecialLinearGroup.transvection_coe] at h1
    have hmap : (1 + single i j c : Matrix (Fin 2) (Fin 2) K).map φ =
        1 + single i j (φ c) := map_transvection φ i j c
    rw [hmap] at h1
    exact mul_eq_mul_of_conj_one_add hMN hNM h1
  have hAcomm : ∀ i j : Fin 2, i ≠ j → Commute (single i j (1 : K)) M := by
    intro i j hij
    have h := hrel i j hij 1 k.one_mem
    rw [map_one] at h
    exact h.symm
  obtain ⟨r, hr⟩ := Matrix.mem_range_scalar_of_commute_single (fun i j hij => hAcomm i j hij)
  have hAc : A ∈ Subgroup.center (GL (Fin 2) K) :=
    GeneralLinearGroup.mem_center_iff_val_mem_range_scalar.mpr ⟨r, hr⟩
  rw [GeneralLinearGroup.center_eq_range_scalar] at hAc
  obtain ⟨c, hc⟩ := hAc
  have hA1 : conjAut 2 K A = 1 := by
    rw [← hc]
    exact conjAut_scalar c
  have hφ : ∀ x, σ x = x → φ x = x := by
    intro x hx
    have h01 : (0 : Fin 2) ≠ 1 := by decide
    have h3 := hrel 0 1 h01 1 k.one_mem
    rw [map_one] at h3
    have h5 := hrel 0 1 h01 x ((hk x).2 hx)
    have h2 : M * single 0 1 (φ x) = single 0 1 (φ x) * M := by
      calc M * single 0 1 (φ x) = φ x • (M * single 0 1 1) := by
            rw [← Matrix.mul_smul, smul_single, smul_eq_mul, mul_one]
        _ = single 0 1 (φ x) * M := by
            rw [h3, ← Matrix.smul_mul, smul_single, smul_eq_mul, mul_one]
    have h4 : single 0 1 (φ x) * M * N = single 0 1 x * M * N := by rw [← h2, h5]
    rw [Matrix.mul_assoc, Matrix.mul_assoc, hMN, Matrix.mul_one, Matrix.mul_one] at h4
    have := congrFun (congrFun h4 0) 1
    simpa using this
  rw [hA1, one_mul, ← MonoidHom.map_zpowers]
  exact Subgroup.mem_map_of_mem _
    (CFSG.ComponentClassification.UnbalancedCatalog.mem_zpowers_of_fixed hφ)

theorem exists_inner_transport {S G : Type} [Group S] [Group G] (e : S ≃* G) {p : ℕ}
    (h : ∀ D' : Subgroup (MulAut G), (∀ a ∈ D', a ^ p = 1) → p < Nat.card D' →
      ∃ x ∈ D' ⊓ innerAut G, x ≠ 1)
    (D : Subgroup (MulAut S)) (hD : ∀ a ∈ D, a ^ p = 1) (hcard : p < Nat.card D) :
    ∃ x ∈ D ⊓ innerAut S, x ≠ 1 := by
  set φ : MulAut S ≃* MulAut G := MulAut.congr e with hφ
  obtain ⟨x', ⟨hx'D, hx'I⟩, hx'1⟩ := h (D.map φ.toMonoidHom)
    (by
      rintro _ ⟨a, ha, rfl⟩
      change φ a ^ p = 1
      rw [← map_pow, hD a ha, map_one])
    (by rw [Subgroup.card_map_of_injective φ.injective]; exact hcard)
  obtain ⟨x, hxD, rfl⟩ := hx'D
  obtain ⟨g, hg⟩ := hx'I
  refine ⟨x, ⟨hxD, e.symm g, ?_⟩, fun h => hx'1 (by simp [h])⟩
  apply φ.injective
  change _ = φ.toMonoidHom x
  rw [← hg]
  ext s
  simp [hφ, MulAut.congr_apply]

theorem exists_inner_projectiveSL_two {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (D : Subgroup (MulAut (projectiveSL 2 K))) (hD : ∀ a ∈ D, a ^ p = 1) (hcard : p < Nat.card D) :
    ∃ x ∈ D ⊓ innerAut (projectiveSL 2 K), x ≠ 1 :=
  exists_inner_transport (psl2Equiv K).symm
    (fun D' hD' hc' => CFSG.HardMathSupport.Timmesfeld.DefChar.exists_inner_of_elemAbelian_psl2_all
      hp hp2 D' hD' hc') D hD hcard

theorem isChevSimple_projectiveSL_two {p f : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hf : 1 ≤ f) {F : Type} [Field F] (hF : Nat.card F = p ^ f)
    (h3 : p ^ f ≠ 3) : IsChevSimple p (projectiveSL 2 F) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Finite F := Nat.finite_of_card_ne_zero (by rw [hF]; exact pow_ne_zero _ hp.ne_zero)
  have hodd : Odd (p ^ f) := (hp.odd_of_ne_two hp2).pow
  have hmod : p ^ f % 2 = 1 := Nat.odd_iff.1 hodd
  have hge : 3 ≤ p ^ f := by
    have h1 : 3 ≤ p := by have := hp.two_le; omega
    exact h1.trans (Nat.le_self_pow (by omega) p)
  let eS : projectiveSL 2 F ≃* CFSG.Assembly.LowTwoRank.StatedProj
      (CFSG.Assembly.LowTwoRank.StatedSL 2 F) :=
    (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 F).symm.trans
      (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 F)
  by_cases h5 : p ^ f = 5
  · obtain ⟨e⟩ := CFSG.ClassicalModels.nonempty_statedLinearModel_equiv_alternating_five F
      (Or.inr (hF.trans h5))
    have hp5 : p = 5 := by
      have : p ∣ 5 := h5 ▸ dvd_pow_self p (by omega)
      exact (Nat.prime_dvd_prime_iff_eq hp (by norm_num)).1 this
    refine Or.inr ⟨TauCeti.CFSGIndex.alternating 5 le_rfl, ?_, ⟨eS.trans e⟩⟩
    subst hp5
    simp [ambiguousChev]
  by_cases h9 : p ^ f = 9
  · obtain ⟨e⟩ := CFSG.Open.StatedAPI.nonempty_mulEquiv_alternating_six_of_statedProj
      (K := F) (hF.trans h9) eS
    have hp3 : p = 3 := by
      have : p ∣ 9 := h9 ▸ dvd_pow_self p (by omega)
      have h33 : p ∣ 3 * 3 := by simpa using this
      rcases (Nat.Prime.dvd_mul hp).1 h33 with h | h <;>
        exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 h
    have h56 : 5 ≤ 6 := by norm_num
    refine Or.inr ⟨TauCeti.CFSGIndex.alternating 6 h56, ?_, ⟨e⟩⟩
    subst hp3
    simp [ambiguousChev]
  · let q : TauCeti.PrimePower := ⟨p, f, hp, hf⟩
    haveI : Fact q.p.Prime := ⟨hp⟩
    have hqc : q.card = p ^ f := TauCeti.PrimePower.card_def q
    have hv : (TauCeti.LieTypeIndex.A 1 q).Valid := by
      rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
      refine ⟨⟨le_rfl, fun _ => ?_⟩, ?_⟩
      · omega
      · rintro (⟨-, h | h | h⟩ | ⟨h, -⟩ | ⟨h, -⟩) <;> omega
    let e : projectiveSL 2 F ≃* (TauCeti.CFSGIndex.lie ⟨.A 1 q, hv⟩).Group :=
      ((LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 F).symm.trans
        (CFSG.ClassicalModels.projectiveSpecialLinearFieldEquiv
          (CFSG.ClassicalModels.finiteFieldEquivGaloisField F p f hf hF) (Fin 2))).trans
        (CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 1 q hv).symm
    exact Or.inl ⟨TauCeti.CFSGIndex.lie ⟨.A 1 q, hv⟩,
      TauCeti.LieTypeIndex.characteristic_A 1 q, ⟨e⟩⟩

theorem exists_finset_card_four {F : Type*} [Finite F] (h : 4 ≤ Nat.card F) :
    ∃ s : Finset F, s.card = 4 := by
  haveI : Fintype F := Fintype.ofFinite F
  rw [Nat.card_eq_fintype_card, ← Finset.card_univ] at h
  obtain ⟨t, -, ht⟩ := Finset.exists_subset_card_eq h
  exact ⟨t, ht⟩

theorem simple_nonabelian_projectiveSL_two {F : Type} [Field F] [Finite F]
    (h : 4 ≤ Nat.card F) :
    IsSimpleGroup (projectiveSL 2 F) ∧ ∃ a b : projectiveSL 2 F, a * b ≠ b * a := by
  have hcond : 3 ≤ 2 ∨ ∃ s : Finset F, s.card = 4 := Or.inr (exists_finset_card_four h)
  obtain ⟨hnt, hsimp, -⟩ := CFSG.LinearGroups.linear_projective_simple (K := F) (n := 2)
    le_rfl hcond
  have hperf := CFSG.LinearGroups.linear_projective_perfect (K := F) (n := 2) le_rfl hcond
  let e := LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 F
  haveI := hnt
  refine ⟨e.symm.isSimpleGroup, ?_⟩
  obtain ⟨a, b, hab⟩ := exists_noncomm_of_isPerfect hperf
  exact ⟨e a, e b, fun h => hab (by simpa using congrArg e.symm h)⟩

theorem outerCentData_fieldAut_two {p f : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hf : 1 ≤ f) (hK : Nat.card K = p ^ f) {τ : K ≃+* K} (hτ : orderOf τ = p)
    (hout : fieldAut 2 K τ ∉ innerAut (projectiveSL 2 K)) :
    OuterCentData p (fieldAut 2 K τ) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : CharP K p := finite_field_prime_power_characteristic hp hf hK
  set k : Subfield K := semilinearFixedSubfield τ with hk_def
  have hk : ∀ x, x ∈ k ↔ τ x = x := fun x => RingHom.mem_eqLocusField
  obtain ⟨hpf, hkcard⟩ := card_semilinearFixedSubfield hp hf hK hτ
  have hτp : τ ^ p = 1 := hτ ▸ pow_orderOf_eq_one τ
  have hf' : 1 ≤ f / p := Nat.div_pos (Nat.le_of_dvd (by omega) hpf) hp.pos
  have hC : fixSubgroup (fieldAut 2 K τ) = (linearSubfieldInclusion 2 k).range :=
    fixSubgroup_fieldAut_eq_range (by norm_num) hp hτp (not_dvd_card_units_of_card_eq hp hf hK)
  have hinj := linearSubfieldInclusion_injective (by norm_num : 0 < 2) k
  have hordf : orderOf (fieldAut 2 K τ) = p := by
    have hne : fieldAut 2 K τ ≠ 1 := fun h => hout (h ▸ (innerAut _).one_mem)
    refine orderOf_eq_prime ?_ hne
    rw [← map_pow, hτp, map_one]
  by_cases h3 : p ^ (f / p) = 3
  ·
    have hp3 : p = 3 := by
      have : p ∣ 3 := h3 ▸ dvd_pow_self p (by omega)
      exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 this
    subst hp3
    have hf3 : f / 3 = 1 := by
      have : (3 : ℕ) ^ (f / 3) = 3 ^ 1 := by rw [h3, pow_one]
      exact Nat.pow_right_injective (by norm_num : 2 ≤ 3) this
    have hK27 : Nat.card K = 27 := by
      have : f = 3 := by omega
      rw [hK, this]
      norm_num
    let eS : projectiveSL 2 K ≃* CFSG.Assembly.LowTwoRank.StatedProj
        (CFSG.Assembly.LowTwoRank.StatedSL 2 K) :=
      (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 K).symm.trans
        (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 K)
    have hL27 : IsLTwoTwentySeven (projectiveSL 2 K) :=
      ⟨K, inferInstance, inferInstance, hK27, ⟨eS⟩⟩
    have hk3 : Nat.card k = 3 := by rw [hkcard, hf3]; rfl
    have hsolv : Group.IsSolvable (projectiveSL 2 k) := by
      let eSk : projectiveSL 2 k ≃* CFSG.Assembly.LowTwoRank.StatedProj
          (CFSG.Assembly.LowTwoRank.StatedSL 2 k) :=
        (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 k).symm.trans
          (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 k)
      have hodd3 : Odd (Nat.card k) := by rw [hk3]; exact ⟨1, rfl⟩
      have hcard12 : Nat.card (projectiveSL 2 k) = 12 := by
        rw [Nat.card_congr eSk.toEquiv,
          CFSG.Open.StatedAPI.card_statedProj_statedSL_two_of_odd hodd3, hk3]
        norm_num
      refine isSolvable_of_card_primeFactors_le_two ?_
      rw [hcard12, show (12 : ℕ) = 2 ^ 2 * 3 ^ 1 by norm_num,
        Nat.primeFactors_mul (by norm_num) (by norm_num),
        Nat.primeFactors_prime_pow (by norm_num) Nat.prime_two,
        Nat.primeFactors_prime_pow (by norm_num) Nat.prime_three]
      decide
    have hCs : Group.IsSolvable ↥(fixSubgroup (fieldAut 2 K τ)) := by
      rw [hC]
      exact Group.isSolvable_of_isSolvable_injective
        (f := (MonoidHom.ofInjective hinj).symm.toMonoidHom)
        (MonoidHom.ofInjective hinj).symm.injective
    exact OuterCentData.ofNoComponent (noComponent_of_solvable hCs)
      (fun h => absurd ⟨rfl, hL27⟩ h) (fun h => absurd ⟨rfl, hL27⟩ h)
  · have hoddk : Odd (p ^ (f / p)) := (hp.odd_of_ne_two hp2).pow
    have hmodk : p ^ (f / p) % 2 = 1 := Nat.odd_iff.1 hoddk
    have hge3 : 3 ≤ p ^ (f / p) := by
      have h1 : 3 ≤ p := by have := hp.two_le; omega
      exact h1.trans (Nat.le_self_pow (by omega) p)
    have hk4 : 4 ≤ Nat.card k := by rw [hkcard]; omega
    obtain ⟨hsimp, hnab⟩ := simple_nonabelian_projectiveSL_two hk4
    have hs : IsSimpleGroup ↥(fixSubgroup (fieldAut 2 K τ)) := by
      rw [hC]
      exact (MonoidHom.ofInjective hinj).symm.isSimpleGroup
    have hnc : ∃ a b : ↥(fixSubgroup (fieldAut 2 K τ)), a * b ≠ b * a := by
      rw [hC]
      obtain ⟨a, b, hab⟩ := hnab
      exact ⟨MonoidHom.ofInjective hinj a, MonoidHom.ofInjective hinj b, fun h =>
        hab (by simpa using congrArg (MonoidHom.ofInjective hinj).symm h)⟩
    have hdvd : p ∣ Nat.card ↥(fixSubgroup (fieldAut 2 K τ)) := by
      rw [hC, ← Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv]
      refine CFSG.SignalizerFunctorTheorem.CatalogBridge.dvd_card_projectiveSL_of_dvd le_rfl hp ?_
      rw [hkcard]
      exact dvd_pow_self p (by omega)
    have hchev : IsChevSimple p ↥(fixSubgroup (fieldAut 2 K τ)) := by
      rw [hC]
      exact isChevSimple_of_mulEquiv (MonoidHom.ofInjective hinj)
        (isChevSimple_projectiveSL_two hp hp2 hf' hkcard h3)
    have hK4 : 4 ≤ Nat.card K := by
      rw [hK]
      have : p ^ (f / p) ≤ p ^ f := Nat.pow_le_pow_right hp.pos (Nat.div_le_self f p)
      omega
    have hZ : Subgroup.center (projectiveSL 2 K) = ⊥ := by
      haveI := (simple_nonabelian_projectiveSL_two hK4).1
      exact b3Lie_center_eq_bot (simple_nonabelian_projectiveSL_two hK4).2
    refine OuterCentData.ofSimpleNormal hp (SimpleNormalData.ofSimple hs hnc hchev hdvd) ?_ ?_
    · intro _ w hw _ hfix
      have hfixing : ∀ x ∈ (linearSubfieldInclusion 2 k).range, w x = x := fun x hx =>
        hfix x (by rw [hC]; exact hx)
      have hmem := mem_zpowers_fieldAut_of_fixes_two (p := p) hk hfixing
      have h1 : orderOf w ∣ orderOf (fieldAut 2 K τ) := orderOf_dvd_of_mem_zpowers hmem
      rw [hordf] at h1
      have h2 : orderOf w = 1 := Nat.Coprime.eq_one_of_dvd hw.symm h1
      rw [orderOf_eq_one_iff.1 h2]
      exact (innerAut (projectiveSL 2 K)).one_mem
    · intro hp3 _ β' hβ' hcomm _
      subst hp3
      exact exists_inner_on_fixSubgroup_of_pump hp hZ hordf hout
        (fun D hexp hcard => exists_inner_projectiveSL_two hp hp2 D hexp hcard) hβ' hcomm

theorem exists_conj_fieldAut_of_outer_two {p f : ℕ} (hp : p.Prime) (hf : 1 ≤ f)
    (hK : Nat.card K = p ^ f) {β : MulAut (projectiveSL 2 K)} (hβ : orderOf β = p)
    (hout : β ∉ innerAut (projectiveSL 2 K)) :
    ∃ (τ : K ≃+* K) (h : MulAut (projectiveSL 2 K)), orderOf τ = p ∧
      β = h * fieldAut 2 K τ * h⁻¹ := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : CharP K p := finite_field_prime_power_characteristic hp hf hK
  obtain ⟨β₀, hββ₀⟩ : ∃ β₀ : MulAut (PSL2 K), MulAut.congr (psl2Equiv K) β₀ = β :=
    ⟨(MulAut.congr (psl2Equiv K)).symm β, (MulAut.congr (psl2Equiv K)).apply_symm_apply β⟩
  have hβ₀ord : orderOf β₀ = p := by
    rw [← hβ, ← hββ₀, MulEquiv.orderOf_eq]
  have hβ₀p : β₀ ^ p = 1 := hβ₀ord ▸ pow_orderOf_eq_one β₀
  have hcongr : ∀ A : GL (Fin 2) K,
      MulAut.congr (psl2Equiv K) (pglAction K (Matrix.ProjGenLinGroup.mk A)) = conjAut 2 K A :=
    fun A => congr_pglAction_mk A
  by_cases hD : β₀ ∈ (pglAction K).range
  · exfalso
    obtain ⟨g, hg⟩ := hD
    obtain ⟨A, rfl⟩ := Matrix.ProjGenLinGroup.mk_surjective g
    have hβA : β = conjAut 2 K A := by
      rw [← hββ₀, ← hg]
      exact hcongr A
    have hAp : A ^ p ∈ Subgroup.center (Matrix.GeneralLinearGroup (Fin 2) K) := by
      have h1 : pglAction K (Matrix.ProjGenLinGroup.mk (A ^ p)) = pglAction K 1 := by
        rw [map_pow, map_pow, hg, hβ₀p, map_one]
      exact Matrix.ProjGenLinGroup.mk_eq_one.1 (pglAction_injective K h1)
    rw [Matrix.GeneralLinearGroup.center_eq_range_scalar] at hAp
    obtain ⟨c, hc⟩ := hAp
    obtain ⟨g', hg'⟩ := conjAut_eq_conj_proj_of_pow_eq_scalar' hc.symm
    exact hout ⟨LinearFlag.proj 2 K g', hg'.symm.trans hβA.symm⟩
  · have hne : β₀ ≠ 1 := fun h => hD ⟨1, by rw [map_one, h]⟩
    obtain ⟨σ, hσ, g, hgσ⟩ := CFSG.RankThree.PartTwo.KFacts.linear_two_prime_order_field_descent
      hp β₀ hβ₀ord hD
    obtain ⟨A, rfl⟩ := Matrix.ProjGenLinGroup.mk_surjective g
    refine ⟨σ, conjAut 2 K A, hσ, ?_⟩
    rw [← hββ₀, hgσ, map_mul, map_mul, map_inv, hcongr, congr_psl2FieldAut]

theorem outerCentData_projectiveSL_two {p f : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hf : 1 ≤ f) (hK : Nat.card K = p ^ f) {β : MulAut (projectiveSL 2 K)}
    (hβ : orderOf β = p) (hout : β ∉ innerAut (projectiveSL 2 K)) : OuterCentData p β := by
  obtain ⟨τ, h, hτ, rfl⟩ := exists_conj_fieldAut_of_outer_two hp hf hK hβ hout
  refine OuterCentData.of_conj hp h⁻¹ _ ?_
  have hf' : h⁻¹ * (h * fieldAut 2 K τ * h⁻¹) * h⁻¹⁻¹ = fieldAut 2 K τ := by group
  rw [hf']
  refine outerCentData_fieldAut_two hp hp2 hf hK hτ ?_
  rintro ⟨a, ha⟩
  apply hout
  refine ⟨h a, ?_⟩
  rw [← CFSG.HardMathSupport.Dickson.I271.mulAut_mul_conj_mul_inv, ha]

theorem outerCentData_A_one (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.A 1 q).Valid) {S : Type} [Group S] [Finite S]
    (e : S ≃* (TauCeti.CFSGIndex.lie ⟨.A 1 q, hv⟩).Group) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hpq : p = q.p) {β : MulAut S} (hβ : orderOf β = p) (hout : β ∉ innerAut S) :
    OuterCentData p β := by
  subst hpq
  haveI : Fact q.p.Prime := ⟨q.prime_p⟩
  let e' : S ≃* projectiveSL 2 (GaloisField q.p q.exponent) :=
    e.trans ((CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 1 q hv).trans
      (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 _))
  have hK : Nat.card (GaloisField q.p q.exponent) = q.p ^ q.exponent :=
    GaloisField.card q.p q.exponent q.exponent_pos.ne'
  refine OuterCentData.of_congr hp e' ?_
  refine outerCentData_projectiveSL_two hp hp2 q.exponent_pos hK ?_ ?_
  · rw [MulEquiv.orderOf_eq]
    exact hβ
  · rintro ⟨g, hg⟩
    apply hout
    refine ⟨e'.symm g, ?_⟩
    apply (MulAut.congr e').injective
    rw [CFSG.ComponentClassification.OuterAutomorphisms.congr_conj, e'.apply_symm_apply]
    exact hg

