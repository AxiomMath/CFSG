theorem fieldActor_D4_not_inner {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hf : 1 ≤ f) {K : Type}
    [Field K] [Finite K] (hK : Nat.card K = (p ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (p ^ f)) :
    fieldActor (t := TwistTag.D4) σ σ ∉
      (MulAut.conj : (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) →*
        MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).range := by
  obtain ⟨-, -, ⟨Θ, hΘ, -, hker, -⟩, -, -, -, -, -⟩ :=
    odd_triality_exact_automorphism_normal_form hp hp2 hf K hK σ hσ
  have hσ1 : σ ≠ 1 := by
    intro h
    have hc := CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube hp hf hK σ hσ
    have htop : fixSubfield σ = ⊤ := by
      ext c
      simp [h]
    rw [htop] at hc
    have hc' : Nat.card K = p ^ f := by
      rw [← hc]
      exact (Nat.card_congr Subfield.topEquiv.toEquiv).symm
    have hp1 : 1 < p ^ f := Nat.one_lt_pow (by omega) hp.one_lt
    rw [hK] at hc'
    nlinarith [hp1, pow_pos (lt_trans Nat.zero_lt_one hp1) 2]
  intro hmem
  have hmem' : fieldActor (t := TwistTag.D4) σ σ ∈ Θ.ker := by rw [hker]; exact hmem
  have hΘδ : Θ (fieldActor (t := TwistTag.D4) σ σ) = σ :=
    hΘ (fieldActor (t := TwistTag.D4) σ σ) 1 σ (by rw [map_one, one_mul])
  exact hσ1 (hΘδ.symm.trans hmem')

theorem mem_zpowers_of_comm_of_fixSubgroup_D4 {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (p ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (p ^ f))
    (ζ : MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))
    (hcomm : ζ * fieldActor (t := TwistTag.D4) σ σ = fieldActor σ σ * ζ)
    (hfix : ∀ x ∈ fixSubgroup (fieldActor (t := TwistTag.D4) σ σ), ζ x = x) :
    ζ ∈ Subgroup.zpowers (fieldActor (t := TwistTag.D4) σ σ) := by
  classical
  have hσ3 : ∀ c, σ (σ (σ c)) = c := ringEquiv_cube_apply_eq hK hσ
  have hσ₀3 : ∀ c : fixSubfield σ, fixSubfieldRestrict σ σ (fixSubfieldRestrict σ σ
      (fixSubfieldRestrict σ σ c)) = c := fun c => Subtype.ext (by
    simp only [coe_fixSubfieldRestrict]
    exact hσ3 c)
  obtain ⟨-, hNF, -⟩ := odd_triality_exact_automorphism_normal_form hp hp2 hf K hK σ hσ
  have hZ := exceptional_fixed_center_trivial TwistTag.D4 K σ
  have hinj := mulAut_conj_injective_of_center_eq_bot hZ
  have hJC := d4_trialityFieldImage_self_le σ
  have hιinj : Function.Injective
      (baseChangeGL (τ := TwistTag.D4.tag) (fixSubfield σ).subtype) := baseChangeGL_injective _
  have hcommδ : ∀ φ : K ≃+* K, fieldActor (t := TwistTag.D4) σ φ * fieldActor σ σ =
      fieldActor σ σ * fieldActor σ φ := fun φ => by
    rw [← fieldActor_mul (t := TwistTag.D4), ← fieldActor_mul (t := TwistTag.D4),
      (commute_ringEquiv_of_finite φ σ).eq]
  obtain ⟨⟨g, φ⟩, hgφ, -⟩ := hNF ζ
  have hζ : ζ = MulAut.conj g * fieldActor (t := TwistTag.D4) σ φ := hgφ
  have hgJ : (g : ModGL TwistTag.D4.tag K) ∈ trialityFieldImage σ σ := by
    have hβδ : fieldActor (t := TwistTag.D4) σ σ * ζ = ζ * fieldActor σ σ := hcomm.symm
    rw [hζ] at hβδ
    have e1 : MulAut.conj (fieldActor (t := TwistTag.D4) σ σ g) *
        (fieldActor σ σ * fieldActor σ φ) =
          MulAut.conj g * (fieldActor σ σ * fieldActor σ φ) := by
      calc MulAut.conj (fieldActor (t := TwistTag.D4) σ σ g) *
          (fieldActor σ σ * fieldActor σ φ) =
          fieldActor σ σ * (MulAut.conj g * fieldActor σ φ) := by
            rw [← mul_assoc, ← mulAut_mul_conj, mul_assoc]
        _ = MulAut.conj g * fieldActor σ φ * fieldActor σ σ := hβδ
        _ = MulAut.conj g * (fieldActor σ σ * fieldActor σ φ) := by rw [mul_assoc, hcommδ]
    exact (d4_mem_trialityFieldImage_self_iff σ hσ3 g).2 (hinj (mul_right_cancel e1))
  have hfixJ : ∀ j : graphFixedRootGroup TwistTag.D4 K σ.toRingHom,
      (j : ModGL TwistTag.D4.tag K) ∈ trialityFieldImage σ σ → ζ j = j := fun j hj =>
    hfix j ((d4_mem_trialityFieldImage_self_iff σ hσ3 j).1 hj)
  obtain ⟨g', hg', hgg'⟩ := hgJ
  have hid : MulAut.conj (⟨g', hg'⟩ : graphFixedRootGroup TwistTag.D4 (fixSubfield σ)
      (fixSubfieldRestrict σ σ).toRingHom) *
        fieldActor (fixSubfieldRestrict σ σ) (fixSubfieldRestrict φ σ) = 1 := by
    refine MulEquiv.ext fun j' => Subtype.ext ?_
    have hj'J : baseChangeGL (fixSubfield σ).subtype (j' : ModGL TwistTag.D4.tag
        (fixSubfield σ)) ∈ trialityFieldImage σ σ := ⟨j', j'.2, rfl⟩
    have h1 := congrArg Subtype.val (hfixJ ⟨_, hJC hj'J⟩ hj'J)
    rw [hζ] at h1
    change (g : ModGL TwistTag.D4.tag K) * Units.map (entrywiseHom φ.toRingHom)
      (baseChangeGL (fixSubfield σ).subtype (j' : ModGL TwistTag.D4.tag (fixSubfield σ))) *
        (g : ModGL TwistTag.D4.tag K)⁻¹ =
      baseChangeGL (fixSubfield σ).subtype (j' : ModGL TwistTag.D4.tag (fixSubfield σ)) at h1
    rw [← hgg', entrywise_baseChangeGL_fixSubfieldRestrict, ← map_inv, ← map_mul,
      ← map_mul] at h1
    exact hιinj h1
  obtain ⟨hg1, hψ1⟩ := conj_mul_fieldActor_injective_D4 (fixSubfieldRestrict σ σ) hσ₀3
    (g' := 1) (δ' := 1) (by rw [hid, map_one, fieldActor_one, one_mul])
  have hg1' : g = 1 := Subtype.ext (by
    rw [← hgg', show g' = 1 from congrArg Subtype.val hg1, map_one]
    rfl)
  have hφσ : ∀ x, σ x = x → φ x = x := fun x hx => by
    have h2 := congrArg (fun ψ : fixSubfield σ ≃+* fixSubfield σ => (ψ ⟨x, hx⟩ : K)) hψ1
    exact h2
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1
    (CFSG.ComponentClassification.UnbalancedCatalog.mem_zpowers_of_fixed hφσ)
  have hζn : ζ = fieldActor (t := TwistTag.D4) σ σ ^ n := by
    rw [hζ, hg1', map_one, one_mul]
    exact map_zpow (fieldActorHom (t := TwistTag.D4) σ) σ n
  exact Subgroup.mem_zpowers_iff.2 ⟨n, hζn.symm⟩

noncomputable def fixSubgroupFieldActorEquivG2 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2)
    (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) :
    fixSubgroup (fieldActor (t := TwistTag.D4) σ σ) ≃* adjointGroup Tag.G2 (fixSubfield σ) :=
  have hk3 : (3 : ℕ∞) ≤ ENat.card (fixSubfield σ) := by
    rw [ENat.card_eq_coe_natCard,
      CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube hℓ hf hK σ hσ]
    exact_mod_cast three_le_pow_of_odd_prime hℓ hℓ2 hf
  (fixSubgroupFieldActorEquiv K σ (ringEquiv_cube_apply_eq hK hσ)).trans
    (CFSG.HardMathSupport.Seitz.TrialityOdd.Inner.trialityFieldImageEquivG2 σ hk3)

theorem chevFacts_adjointGroup_G2 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hf : 1 ≤ f)
    (k : Type) [Field k] [Finite k] (hk : Nat.card k = ℓ ^ f) :
    IsChevSimple ℓ ↥(adjointGroup Tag.G2 k) ∧ ℓ ∣ Nat.card ↥(adjointGroup Tag.G2 k) ∧
      (ℓ = 3 → ¬ IsLTwoTwentySeven ↥(adjointGroup Tag.G2 k)) := by
  have h3f : 3 ≤ ℓ ^ f := three_le_pow_of_odd_prime hℓ hℓ2 hf
  have hZ : Subgroup.center (adjointGroup Tag.G2 k) = ⊥ := center_adjointGroup_eq_bot
  let eQ : ↥(adjointGroup Tag.G2 k) ≃* AdjointQuotient Tag.G2 k :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm
  have hmodel : ChevalleyExceptionalModel ↥(adjointGroup Tag.G2 k) .G2 ℓ f :=
    ⟨⟨hℓ, hf, rfl, h3f⟩, k, inferInstance, inferInstance, hk, ⟨eQ⟩⟩
  have hcardG : Nat.card ↥(adjointGroup Tag.G2 k) =
      lieOrderNumerator .G2 0 (ℓ ^ f) / lieOrderDivisor .G2 0 (ℓ ^ f) := by
    rw [CFSG.ClassicalInvolution.card_chevalleyExceptionalModel_of_ne_two hℓ2 hmodel]
    simp [ordG2, lieOrderNumerator, lieOrderDivisor]
  have hpow := excPowDvd_of_card_eq hmodel.1 hcardG
  have hN : 6 ≤ lieSylowExponent .G2 0 := excSylowExponent_ge (by decide)
  refine ⟨?_, ?_, ?_⟩
  ·
    let q₀ : TauCeti.PrimePower := ⟨ℓ, f, hℓ, hf⟩
    have hq₀ : Nat.card k = q₀.card := by rw [hk, TauCeti.PrimePower.card_def]
    have hv : (TauCeti.LieTypeIndex.G2 q₀).Valid := by
      refine (TauCeti.LieTypeIndex.valid_iff _).2 ⟨?_, ?_⟩
      · rw [TauCeti.LieTypeIndex.inStandardRange_iff]
        show 3 ≤ q₀.card
        rw [TauCeti.PrimePower.card_def]
        exact h3f
      · rw [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
        exact fun h => h
    obtain ⟨φ⟩ := CFSG.TauCetiBridge.untwistedBridge_G2 q₀ hv hℓ2 k hq₀
    exact Or.inl ⟨.lie ⟨.G2 q₀, hv⟩, TauCeti.LieTypeIndex.characteristic_G2 q₀, ⟨eQ.trans φ⟩⟩
  ·
    exact (dvd_pow_self ℓ (Nat.mul_pos (by omega) hf).ne').trans hpow
  ·
    rintro rfl
    refine excNotLTwoTwentySeven_of_pow_four_dvd ((pow_dvd_pow 3 ?_).trans hpow)
    calc 4 ≤ 6 * 1 := by norm_num
      _ ≤ lieSylowExponent .G2 0 * f := Nat.mul_le_mul hN hf

theorem chevFacts_fixSubgroup_fieldActor_D4 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2)
    (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) :
    IsChevSimple ℓ (fixSubgroup (fieldActor (t := TwistTag.D4) σ σ)) ∧
      ℓ ∣ Nat.card (fixSubgroup (fieldActor (t := TwistTag.D4) σ σ)) ∧
      (ℓ = 3 → ¬ IsLTwoTwentySeven (fixSubgroup (fieldActor (t := TwistTag.D4) σ σ))) := by
  obtain ⟨hchev, hdvd, h27⟩ := chevFacts_adjointGroup_G2 hℓ hℓ2 hf (fixSubfield σ)
    (CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube hℓ hf hK σ hσ)
  let e := fixSubgroupFieldActorEquivG2 hℓ hℓ2 hf hK σ hσ
  refine ⟨isChevSimple_of_mulEquiv e.symm hchev, ?_, fun h hL => h27 h
    (isLTwoTwentySeven_of_mulEquiv e hL)⟩
  rw [Nat.card_congr e.toEquiv]
  exact hdvd

end ExcTriClassA

theorem outerCentData_three_classA {f : ℕ} (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] [CharP K 3]
    (hK : Nat.card K = (3 ^ f) ^ 3) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (3 ^ f)) :
    OuterCentData 3 (fieldActor (t := TwistTag.D4) σ σ) := by
