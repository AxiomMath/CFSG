theorem three_le_pow_of_odd_prime {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hf : 1 ≤ f) :
    3 ≤ ℓ ^ f := by
  have h3 : 3 ≤ ℓ := by
    have := hℓ.two_le
    omega
  calc 3 ≤ ℓ := h3
    _ = ℓ ^ 1 := (pow_one ℓ).symm
    _ ≤ ℓ ^ f := Nat.pow_le_pow_right hℓ.pos hf

end ExcTriClassA

