section Eigen

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem exists_orthonormal_eigenbasis (hpq : 3 ∣ ℓ ^ f + 1) {X : primeFormUnitary h (idGram K n)}
    (hX : X ^ 3 = 1) :
    ∃ b : Fin n → Fin n → K, IsOrthonormalFamily h b ∧ ∀ i, ∃ μ : K,
      ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ b i = μ • b i := by
  classical
  have := h.finite
  haveI : NeZero (3 : ℕ) := ⟨by norm_num⟩
  obtain ⟨ζ, hζ⟩ := KCUnitaryPlane.exists_primitiveRoot_of_dvd h Nat.prime_three hpq
  set T : Module.End K (Fin n → K) := ((toLinU h n X :
      LinearMap.GeneralLinearGroup K (Fin n → K)) : Module.End K (Fin n → K)) with hT
  have hpow : T ^ 3 = 1 := by
    have h1 : (toLinU h n X) ^ 3 = 1 := by rw [← map_pow, hX, map_one]
    have h2 := congrArg (fun g : LinearMap.GeneralLinearGroup K (Fin n → K) =>
      (g : Module.End K (Fin n → K))) h1
    simpa [Units.val_pow_eq_pow_val] using h2
  have hiso : ∀ v w, idForm h n (T v) (T w) = idForm h n v w := fun v w => toLinU_mem X v w
  obtain ⟨b, μ, hbμ, hbo⟩ := KCUnitaryPlane.exists_orthonormal_common_eigenbasis h hζ hpq
    (idForm_isSymm h n) (idForm_separatingLeft h n) (ι := Unit) (fun _ => T)
    (fun _ _ => Commute.refl _) (fun _ => hpow) (fun _ v w => hiso v w)
  refine ⟨b.reindex (finCongr (Module.finrank_fin_fun K)), fun i j => ?_, fun i => ?_⟩
  · rw [Module.Basis.reindex_apply, Module.Basis.reindex_apply, hbo]
    simp
  · rw [Module.Basis.reindex_apply]
    exact ⟨μ () _, hbμ () _⟩

theorem projMat_comm_of_eigen {X : primeFormUnitary h (idGram K n)} {b : Fin n → K} {μ : K}
    (hb : idForm h n b b = 1)
    (hXb : ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ b = μ • b) :
    ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) * projMat h b =
      projMat h b * ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) := by
  set xm : Matrix (Fin n) (Fin n) K := ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) with hxm
  have hiso : ∀ v w, idForm h n (xm *ᵥ v) (xm *ᵥ w) = idForm h n v w :=
    fun v w => toLinU_mem X v w
  have hsm : ∀ (c : K) (v w : Fin n → K),
      idForm h n (c • v) w = h.bar c * idForm h n v w := fun c v w => by
    rw [map_smulₛₗ]
    rfl
  have hμ : h.bar μ * μ = 1 := by
    have h1 := hiso b b
    rw [hXb, hsm, map_smul, smul_eq_mul, hb, mul_one] at h1
    exact h1
  have h2 : ∀ v, idForm h n b (xm *ᵥ v) = μ * idForm h n b v := fun v => by
    have h1 := hiso b v
    rw [hXb, hsm] at h1
    calc idForm h n b (xm *ᵥ v) = (μ * h.bar μ) * idForm h n b (xm *ᵥ v) := by
          rw [mul_comm μ, hμ, one_mul]
      _ = μ * (h.bar μ * idForm h n b (xm *ᵥ v)) := by rw [mul_assoc]
      _ = μ * idForm h n b v := by rw [h1]
  apply Matrix.toLin'.injective
  refine LinearMap.ext fun v => ?_
  simp only [Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, projMat_mulVec, Matrix.mulVec_smul, hXb,
    h2, mul_smul, smul_comm μ]

theorem torusMat_comm_of_eigen {X : primeFormUnitary h (idGram K n)} {b₁ b₂ : Fin n → K}
    (hb : IsONPair h b₁ b₂) {μ₁ μ₂ : K}
    (h₁ : ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ b₁ = μ₁ • b₁)
    (h₂ : ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ b₂ = μ₂ • b₂) (c : K) :
    ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) * torusMat h b₁ b₂ c =
      torusMat h b₁ b₂ c * ((X : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) := by
  have c1 := projMat_comm_of_eigen (X := X) hb.self₁ h₁
  have c2 := projMat_comm_of_eigen (X := X) hb.self₂ h₂
  unfold torusMat
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_one, Matrix.one_mul, Matrix.mul_smul,
    Matrix.smul_mul, c1, c2]

end Eigen

section Tau

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem tau_eq_one_of_commute (hpq : 3 ∣ ℓ ^ f + 1) (hn : 3 ≤ n) {X : gramSU h (idGram K n)}
    (hX : X ^ 3 = 1) (A : primeFormUnitary h (idGram K n)) (φ : K ≃+* K)
    (hfix : ∀ T : gramSU h (idGram K n), T * X = X * T →
      ((A : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *
          ((T : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).map φ =
        ((T : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *
          ((A : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)) :
    φ = RingEquiv.refl K := by
  classical
  obtain ⟨b, hb, hbe⟩ := exists_orthonormal_eigenbasis hpq
    (X := toUnitary h n X) (by rw [← map_pow, hX, map_one])
  have key : ∀ i j : Fin n, i ≠ j → ∀ c : Kˣ, h.norm (c : K) = 1 →
      ((A : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) * (torusMat h (b i) (b j) c).map φ =
        torusMat h (b i) (b j) c * ((A : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) := by
    intro i j hij c hc
    have hp := hb.pair hij
    obtain ⟨μi, hμi⟩ := hbe i
    obtain ⟨μj, hμj⟩ := hbe j
    let T : gramSU h (idGram K n) :=
      ⟨(torusUnitary h hp c hc : GL (Fin n) K),
        (mem_gramSU_iff_unitary h).2 ⟨(torusUnitary h hp c hc).2, det_torusUnitary h hp c hc⟩⟩
    have hTX : T * X = X * T := Subtype.ext (Units.ext
      (torusMat_comm_of_eigen (X := toUnitary h n X) hp hμi hμj c).symm)
    exact hfix T hTX
  have h01 : (⟨0, by omega⟩ : Fin n) ≠ ⟨1, by omega⟩ := by simp [Fin.ext_iff]
  have h02 : (⟨0, by omega⟩ : Fin n) ≠ ⟨2, by omega⟩ := by simp [Fin.ext_iff]
  have h12 : (⟨1, by omega⟩ : Fin n) ≠ ⟨2, by omega⟩ := by simp [Fin.ext_iff]
  exact tau_eq_one_of_torus h (Units.isUnit (A : GL (Fin n) K)) (hb.pair h01) (hb.pair h02)
    (hb.linearIndependent_triple h01 h02 h12) (key _ _ h01) (key _ _ h02)

end Tau

section Quot

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem normOneScalars_eq_bot (hn : 1 ≤ n) (hg : Nat.gcd n (ℓ ^ f + 1) = 1) :
    normOneScalars h (gramSU h (idGram K n)) n = ⊥ :=
  Subgroup.eq_bot_of_card_eq _ ((CFSG.RankThree.Classical.card_normOneScalars_one h hn).trans hg)

theorem mk_injective_of_eq_bot (hZ : normOneScalars h (gramSU h (idGram K n)) n = ⊥) :
    Function.Injective
      (QuotientGroup.mk : gramSU h (idGram K n) → primeFormP h (idGram K n)) := by
  intro a b hab
  have := QuotientGroup.eq.1 hab
  rw [hZ, Subgroup.mem_bot, inv_mul_eq_one] at this
  exact this

theorem psi_apply_mk (A : primeFormUnitary h (idGram K n)) (φ : K ≃+* K)
    (g : gramSU h (idGram K n)) :
    ∃ g' : gramSU h (idGram K n),
      (g' : GL (Fin n) K) = (A : GL (Fin n) K) * glAut φ (g : GL (Fin n) K) *
        (A : GL (Fin n) K)⁻¹ ∧
      primeFormPsi h (isPrimeFormGram_idGram (K := K) (n := n)) ⟨A, φ⟩
        (g : primeFormP h (idGram K n)) = (g' : primeFormP h (idGram K n)) := by
  refine ⟨⟨(A : GL (Fin n) K) * glAut φ (g : GL (Fin n) K) * (A : GL (Fin n) K)⁻¹,
    conj_mem_gramSU h _ A.2 (glAut_mem_gramSU h isPrimeFormGram_idGram φ g.2)⟩, rfl, ?_⟩
  rw [primeFormPsi_apply, MulAut.mul_apply]
  change primeFormConjHom h _ A (primeFormFieldAut h isPrimeFormGram_idGram φ
    (g : primeFormP h (idGram K n))) = _
  rw [primeFormFieldAut_mk, primeFormConjHom_mk]
  rfl

end Quot

section Outer

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem exists_moved_of_outer (hn : 3 ≤ n) (hne : ¬(n = 3 ∧ ℓ ^ f = 2)) (hpq : 3 ∣ ℓ ^ f + 1)
    (hg : Nat.gcd n (ℓ ^ f + 1) = 1) {σ : MulAut (primeFormP h (idGram K n))} (hσ2 : σ ^ 2 = 1)
    (hσ : σ ∉ innerAut (primeFormP h (idGram K n))) {s : primeFormP h (idGram K n)}
    (hs3 : s ^ 3 = 1) :
    ∃ t : primeFormP h (idGram K n), s * t = t * s ∧ σ t ≠ t := by
  classical
  by_contra hno
  push Not at hno
  have hZ : normOneScalars h (gramSU h (idGram K n)) n = ⊥ := normOneScalars_eq_bot (by omega) hg
  have hinj := mk_injective_of_eq_bot hZ
  obtain ⟨⟨A, φ⟩, rfl⟩ := surjective_primeFormPsi_of_ne (h := h) hn hne σ
  obtain ⟨X, rfl⟩ := QuotientGroup.mk_surjective s
  have hX3 : X ^ 3 = 1 := by
    apply hinj
    rw [QuotientGroup.mk_pow, hs3]
    rfl
  have hφ : φ = RingEquiv.refl K := by
    refine tau_eq_one_of_commute hpq hn hX3 A φ (fun T hT => ?_)
    have hcomm : (X : primeFormP h (idGram K n)) * (T : primeFormP h (idGram K n)) =
        (T : primeFormP h (idGram K n)) * (X : primeFormP h (idGram K n)) := by
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, hT]
    have h1 := hno _ hcomm
    obtain ⟨g', hg'1, hg'2⟩ := psi_apply_mk A φ T
    rw [hg'2] at h1
    have h2 : g' = T := hinj h1
    subst h2
    have h3 : (g' : GL (Fin n) K) * (A : GL (Fin n) K) =
        (A : GL (Fin n) K) * glAut φ (g' : GL (Fin n) K) := by
      calc (g' : GL (Fin n) K) * (A : GL (Fin n) K)
          = ((A : GL (Fin n) K) * glAut φ (g' : GL (Fin n) K) * (A : GL (Fin n) K)⁻¹) *
            (A : GL (Fin n) K) := by rw [← hg'1]
        _ = (A : GL (Fin n) K) * glAut φ (g' : GL (Fin n) K) := by group
    have h4 := congrArg (fun g : GL (Fin n) K => (g : Matrix (Fin n) (Fin n) K)) h3
    simp only [Units.val_mul, coe_glAut] at h4
    exact h4.symm
  subst hφ
  have hσD : primeFormPsi h (isPrimeFormGram_idGram (K := K) (n := n)) ⟨A, RingEquiv.refl K⟩ ∈
      primeFormD h (idGram K n) := ⟨A, (psi_refl_eq A).symm⟩
  have hpg : ¬ 2 ∣ Nat.gcd n (ℓ ^ f + 1) := by rw [hg]; norm_num
  exact hσ (mem_inner_of_pow_eq_one_unitary h (1 : GL (Fin n) K) Nat.prime_two hpg hσD hσ2)

end Outer

section Core

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem core_centralizer_primeFormP_eq_bot
    (hZ : normOneScalars h (gramSU h (idGram K n)) n = ⊥) {x : gramSU h (idGram K n)}
    (hN : NoNormalPPrime 3 (Subgroup.centralizer ({x} : Set (gramSU h (idGram K n))))) :
    GLAPPrimeCoreOf 3 (Subgroup.centralizer
      ({(x : primeFormP h (idGram K n))} : Set (primeFormP h (idGram K n)))) = ⊥ := by
  classical
  haveI : Finite (primeFormP h (idGram K n)) := finite_primeFormP
  have hinj := mk_injective_of_eq_bot hZ
  have key : ∀ z : gramSU h (idGram K n), ((z : primeFormP h (idGram K n)) *
      (x : primeFormP h (idGram K n)) = (x : primeFormP h (idGram K n)) *
      (z : primeFormP h (idGram K n))) ↔ z * x = x * z := fun z => by
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
    exact hinj.eq_iff
  have hc : Subgroup.centralizer ({(x : primeFormP h (idGram K n))} :
      Set (primeFormP h (idGram K n))) =
      (Subgroup.centralizer ({x} : Set (gramSU h (idGram K n)))).map
        (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) := by
    ext y
    obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective y
    rw [Subgroup.mem_centralizer_singleton_iff, key, Subgroup.mem_map]
    constructor
    · intro hz
      exact ⟨z, Subgroup.mem_centralizer_singleton_iff.2 hz, rfl⟩
    · rintro ⟨w, hw, hwz⟩
      obtain rfl : w = z := hinj hwz
      exact Subgroup.mem_centralizer_singleton_iff.1 hw
  rw [hc]
  exact W2.core_eq_bot_of_noNormalPPrime Nat.prime_three
    ((W2.noNormalPPrime_map_iff _ hinj _).2 hN)

theorem fieldCoreAt_three_of_outer (hn : 4 ≤ n) (hpq : 3 ∣ ℓ ^ f + 1)
    (hpg : ¬ 3 ∣ Nat.gcd n (ℓ ^ f + 1)) {x : MulAut (primeFormP h (idGram K n))}
    (hx3 : x ^ 3 = 1) (hx : x ∉ innerAut (primeFormP h (idGram K n))) : FieldCoreAt 3 x := by
  classical
  have hfin := h.finite
  have hn3 : 3 ≤ n := by omega
  have hne : ¬(n = 3 ∧ ℓ ^ f = 2) := fun h' => by omega
  have hC : IsPrimeFormGram (1 : GL (Fin n) K) := isPrimeFormGram_idGram
  have hx1 : x ≠ 1 := fun h1 => hx (h1 ▸ one_mem _)
  have hxord : orderOf x = 3 := orderOf_eq_prime hx3 hx1
  have hσ1 : primeFormFieldFactor h hC hn3 hne x ≠ 1 := fun h1 => hx (by
    have hxD : x ∈ primeFormD h (idGram K n) := by
      rw [← ker_primeFormFieldFactor h hC hn3 hne]
      exact h1
    exact mem_inner_of_pow_eq_one_unitary h (1 : GL (Fin n) K) Nat.prime_three hpg hxD hx3)
  have hσp : (primeFormFieldFactor h hC hn3 hne x) ^ 3 = 1 := by rw [← map_pow, hx3, map_one]
  have hσord : orderOf (primeFormFieldFactor h hC hn3 hne x) = 3 := orderOf_eq_prime hσp hσ1
  obtain ⟨-, -, -, -, -, M, hM⟩ :=
    CFSG.HardMathSupport.Lang.Coordinator.unitary_prime_semilinear_field_descent' h hn3 hne
      Nat.prime_three (by norm_num) x hxord _ rfl hσord
  set u := primeFormConjHom h (idGram K n) M with hu
  set σ := primeFormFieldFactor h hC hn3 hne x with hσ
  set δ := primeFormFieldHom h (isPrimeFormGram_one (n := n)) σ with hδ
  have hxh : x = u * δ * u⁻¹ := by
    have : u⁻¹ * x * u = δ := hM
    rw [← this]
    group
  have hδp : orderOf δ = 3 := by
    have hδp' : δ ^ 3 = 1 := by rw [hδ, ← map_pow, ← hσord, pow_orderOf_eq_one, map_one]
    have hδ1 : δ ≠ 1 := by
      intro h1
      apply hx1
      rw [hxh, h1]
      group
    exact orderOf_eq_prime hδp' hδ1
  have hfc : FieldCoreAt 3 δ :=
    fieldCoreAt_fieldHom_of_subfield h Nat.prime_three (by norm_num) hσord hn3 hne
      (fun ⟨h1, _⟩ => by omega)
      (dvd_card_range_of_dvd_q h Nat.prime_three (by norm_num) hσord hn3 hpq)
  exact fieldCoreAt_of_conj hfc u⁻¹ (by rw [hxh]; group)

theorem outer_sq_eq_one (hn : 3 ≤ n) (hne : ¬(n = 3 ∧ ℓ ^ f = 2))
    (hg : Nat.gcd n (ℓ ^ f + 1) = 1) (hf : f = 1 ∨ f = 3)
    {y : MulAut (primeFormP h (idGram K n)) ⧸
      CFSG.ComponentClassification.OuterAutomorphisms.inner (primeFormP h (idGram K n))}
    (hy : Nat.Coprime 3 (orderOf y)) : y ^ 2 = 1 := by
  have hcard := (unitary_full_diagonal_outer_order h hn hne).2.2.2.1
  rw [hg, mul_one] at hcard
  have hdvd : orderOf y ∣ 2 * f := hcard ▸ orderOf_dvd_natCard y
  have h2 : orderOf y ∣ 2 := by
    rcases hf with rfl | rfl
    · simpa using hdvd
    · exact Nat.Coprime.dvd_of_dvd_mul_right hy.symm hdvd
  exact orderOf_dvd_iff_pow_eq_one.1 h2

