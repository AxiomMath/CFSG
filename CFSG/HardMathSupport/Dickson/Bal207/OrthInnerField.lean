variable {K : Type} [Field K] [Finite K] {k : Subfield K} {d : ℕ}
  {Q₀ : QuadraticForm k (Fin d → k)} {Q : QuadraticForm K (Fin d → K)} {σ : K ≃+* K} {p : ℕ}

private theorem comps_of_congr_fieldAutT {S : Type} [Group S] (SS : SubfieldSetup k Q₀ Q σ p)
    (hd : 0 < d) (φ : S ≃* matrixProjectiveDerived Q) {β : MulAut S}
    (he : MulAut.congr φ β = fieldAutT Q σ SS.hQσ) :
    PerfectInLayer β ∧ ∃ J : Subgroup S,
      (∀ L : Subgroup S, CFSG.Open.IsComponentOf L (fixSubgroup β) → L = J) ∧
      Subgroup.center ↥J = ⊥ ∧ Nonempty (↥J ≃* matrixProjectiveDerived Q₀) := by
  obtain ⟨hl, hc⟩ := fieldAutT_layer_and_eq SS hd
  rw [← he] at hl hc
  have : Finite ↥k := Finite.of_injective (algebraMap k K) (algebraMap k K).injective
  obtain ⟨hsimp, a, b, hab⟩ := matrix_simple_nonabelian hd SS.hnd₀ SS.hT₀
  set J₀ := subfieldDerivedImage k SS.hext with hJ₀
  let eJ : ↥(J₀.map (φ.symm : _ →* S)) ≃* matrixProjectiveDerived Q₀ :=
    (J₀.equivMapOfInjective (φ.symm : _ →* S) φ.symm.injective).symm.trans
      (inclEquiv k SS.hext hd).symm
  have : IsSimpleGroup ↥(J₀.map (φ.symm : _ →* S)) := eJ.isSimpleGroup
  refine ⟨LieSemisimple.perfectInLayer_of_congr φ β hl, J₀.map (φ.symm : _ →* S),
    fun L hL => ?_, ?_, ⟨eJ⟩⟩
  · have h1 : CFSG.Open.IsComponentOf (L.map (φ : S →* _)) (fixSubgroup (MulAut.congr φ β)) := by
      rw [Bal207.fixSubgroup_mulAutCongr]
      exact CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map φ hL
    exact ((Subgroup.map_symm_eq_iff_map_eq L).2 (hc _ h1)).symm
  · refine (IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center _)).resolve_right
      fun htop => hab ?_
    have h1 : eJ.symm a ∈ Subgroup.center ↥(J₀.map (φ.symm : _ →* S)) :=
      htop ▸ Subgroup.mem_top _
    exact eJ.symm.injective (by rw [map_mul, map_mul]; exact (Subgroup.mem_center_iff.1 h1 _).symm)

end Field

private theorem orthFieldDatum_plus {S : Type} [Group S] {n ℓ f p : ℕ} (hn : 5 ≤ n)
    (hS : StatedClassicalModel S .POmegaPlus n ℓ f) (hp : p.Prime) (hp2 : p ≠ 2)
    {β : MulAut S} (hβ : β ^ p = 1) (hout : ∀ a : S, MulAut.conj a ≠ β) :
    p ∣ f ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K) (k : Subfield K) (σ : K ≃+* K)
      (SS : SubfieldSetup k (coordinateQuadPlus n k) (coordinateQuadPlus n K) σ p)
      (φ : S ≃* matrixProjectiveDerived (coordinateQuadPlus n K)),
      Nat.card k = ℓ ^ (f / p) ∧ MulAut.congr φ β = fieldAutT _ σ SS.hQσ := by
  obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hS.2
  have hgates := orthogonal_large_prime_semilinear_field_and_diagonal_gates S .POmegaPlus
    (Or.inr (Or.inl rfl)) n ℓ f hS K hK e
  obtain ⟨hD, hord⟩ := outer_order_prime hp hp2 (coordinatePlusWitnessEquiv K e) hgates β hβ hout
  have htop := (orthogonal_geometry_plus_point_family_orbit hS hK e).2.2.2.2.1 hn
  have hE := mem_E_of_pow_eq_one_orth hp hgates (Or.inr htop)
    (β := MulAut.congr (coordinatePlusWitnessEquiv K e) β) (by rw [← map_pow, hβ, map_one])
  have hdesc := orthogonal_prime_semilinear_actual_fixed_form_descent' S .POmegaPlus
    (Or.inr (Or.inl rfl)) n ℓ f p hS hp hp2 K hK e _ hE hD hord
  obtain ⟨g, hgE⟩ := hE
  obtain ⟨hpf, hrest⟩ := hdesc
  obtain ⟨hord', hcard, U, _, _, hUκ, hUr, _, hDisp⟩ := hrest g.val.right ⟨g, hgE, rfl⟩
  obtain ⟨_, _, -, -, hT'⟩ := hDisp
  obtain ⟨_, _, -, -, -, Θ, -, g', hg'l, hg'r, hΘ⟩ := hT'
  have hord'' : orderOf U.val.right = p := by rw [hUr]; exact hord'
  have hσk : ∀ x, x ∈ semilinearFixedSubfield U.val.right ↔ U.val.right x = x := fun x =>
    RingHom.mem_eqLocusField
  have SS := subfieldSetup_plus (semilinearFixedSubfield U.val.right) hσk hp hp2 hord''
    (by omega : 3 ≤ n)
  exact ⟨hpf, K, inferInstance, inferInstance, _, U.val.right, SS,
    (coordinatePlusWitnessEquiv K e).trans Θ, by rw [hUr]; exact hcard,
    congr_trans_eq_fieldAutT SS _ Θ β U hUκ g' hg'l hg'r hΘ⟩

private theorem orthFieldDatum_minus {S : Type} [Group S] {n ℓ f p : ℕ} (hn1 : 1 ≤ n)
    (hS : StatedClassicalModel S .POmegaMinus n ℓ f) (hp : p.Prime) (hp2 : p ≠ 2)
    {β : MulAut S} (hβ : β ^ p = 1) (hout : ∀ a : S, MulAut.conj a ≠ β) :
    p ∣ f ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K) (k : Subfield K) (b c : k)
      (_ : ∀ s : k, s ^ 2 + b * s + c ≠ 0) (σ : K ≃+* K)
      (SS : SubfieldSetup k (coordinateQuadMinus n k hn1 b c)
        (coordinateQuadMinus n K hn1 (b : K) (c : K)) σ p)
      (φ : S ≃* matrixProjectiveDerived (coordinateQuadMinus n K hn1 (b : K) (c : K))),
      Nat.card k = ℓ ^ (f / p) ∧ MulAut.congr φ β = fieldAutT _ σ SS.hQσ := by
  obtain ⟨hℓ, hf, hn4⟩ := hS.1
  obtain ⟨K, _, _, hK, b, c, hirr, ⟨e⟩⟩ := hS.2
  have hgates := orthogonal_large_prime_semilinear_field_and_diagonal_gates S .POmegaMinus
    (Or.inr (Or.inr rfl)) n ℓ f hS hn1 K hK b c hirr e
  have htop : projectivePointFamilyAut (coordinateQuadMinus n K hn1 b c) = ⊤ :=
    ((orthogonal_geometry_tail_model_point_family_invariant S .POmegaMinus (.inr rfl) n ℓ f hS)
      hn1 K hK b c hirr).2
  obtain ⟨hD, hord⟩ := outer_order_prime hp hp2 (coordinateMinusWitnessEquiv K hn1 b c e) hgates
    β hβ hout
  have hE := mem_E_of_pow_eq_one_orth hp hgates (Or.inr htop)
    (β := MulAut.congr (coordinateMinusWitnessEquiv K hn1 b c e) β)
    (by rw [← map_pow, hβ, map_one])
  have hdesc := orthogonal_prime_semilinear_actual_fixed_form_descent' S .POmegaMinus
    (Or.inr (Or.inr rfl)) n ℓ f p hS hp hp2 hn1 K hK b c hirr e _ hE hD hord
  obtain ⟨g, hgE⟩ := hE
  obtain ⟨hpf, hrest⟩ := hdesc
  obtain ⟨hord', hcard, U, _, _, hUκ, hUr, _, hDisp⟩ := hrest g.val.right ⟨g, hgE, rfl⟩
  obtain ⟨b', c', hirr', _, _, -, -, hT'⟩ := hDisp
  obtain ⟨_, _, -, -, -, Θ, -, g', hg'l, hg'r, hΘ⟩ := hT'
  have hord'' : orderOf U.val.right = p := by rw [hUr]; exact hord'
  have hcard' : Nat.card (semilinearFixedSubfield U.val.right) = ℓ ^ (f / p) := by
    rw [hUr]
    exact hcard
  have hσk : ∀ x, x ∈ semilinearFixedSubfield U.val.right ↔ U.val.right x = x := fun x =>
    RingHom.mem_eqLocusField
  obtain ⟨m, hm⟩ := id hpf
  have hdiv : f / p = m := by rw [hm]; exact Nat.mul_div_cancel_left m hp.pos
  have hm1 : 1 ≤ m := by
    rcases Nat.eq_zero_or_pos m with h | h
    · rw [h, mul_zero] at hm
      omega
    · exact h
  have hK' : Nat.card K = ℓ ^ (m * p) := by rw [hK, hm, mul_comm]
  have hdeg := finrank_subfield_eq (semilinearFixedSubfield U.val.right) hℓ hm1
    (hdiv ▸ hcard') hK'
  have SS := subfieldSetup_minus (semilinearFixedSubfield U.val.right) hσk hp hp2 hord'' hn4 hdeg
    b' c' hirr'
  exact ⟨hpf, K, inferInstance, inferInstance, _, b', c', hirr', U.val.right, SS,
    (coordinateMinusWitnessEquiv K hn1 b c e).trans Θ, hcard',
    congr_trans_eq_fieldAutT SS _ Θ β U hUκ g' hg'l hg'r hΘ⟩

theorem orth_outer_dvd {S : Type} [Group S] {t : StatedLieTag} {n ℓ f p : ℕ}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) (hn : 5 ≤ n) (hS : StatedClassicalModel S t n ℓ f)
    (hp : p.Prime) (hp2 : p ≠ 2) {β : MulAut S} (hβ : β ^ p = 1)
    (hout : ∀ a : S, MulAut.conj a ≠ β) : p ∣ f := by
  rcases ht with rfl | rfl
  · exact (orthFieldDatum_plus hn hS hp hp2 hβ hout).1
  · exact (orthFieldDatum_minus (by omega) hS hp hp2 hβ hout).1

theorem orthTwo_inner {S : Type} [Group S] {t : StatedLieTag} {n : ℕ}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) (hn : 5 ≤ n) (hS : StatedClassicalModel S t n 2 1)
    {β : MulAut S} (hβ : β ^ 3 = 1) : ∃ s : S, MulAut.conj s = β := by
  by_contra h
  push Not at h
  have := orth_outer_dvd ht hn hS Nat.prime_three (by norm_num) hβ h
  omega

theorem orthField_comps {S : Type} [Group S] {t : StatedLieTag} {n : ℕ}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) (hn : 5 ≤ n) (hS : StatedClassicalModel S t n 2 3)
    {β : MulAut S} (hβ : β ^ 3 = 1) (hout : ∀ a : S, MulAut.conj a ≠ β) :
    PerfectInLayer β ∧ ∃ J : Subgroup S,
      (∀ L : Subgroup S, CFSG.Open.IsComponentOf L (fixSubgroup β) → L = J) ∧
      Subgroup.center ↥J = ⊥ ∧ StatedClassicalModel ↥J t n 2 1 := by
  rcases ht with rfl | rfl
  · obtain ⟨-, K, _, _, k, σ, SS, φ, hk, he⟩ :=
      orthFieldDatum_plus hn hS Nat.prime_three (by norm_num) hβ hout
    have : Finite ↥k := Finite.of_injective (algebraMap k K) (algebraMap k K).injective
    obtain ⟨hl, J, hJ, hZ, ⟨eJ⟩⟩ := comps_of_congr_fieldAutT SS (by omega) φ he
    exact ⟨hl, J, hJ, hZ, ⟨Nat.prime_two, le_rfl, by omega⟩, ↥k, inferInstance, inferInstance,
      hk.trans (by norm_num), ⟨eJ.trans (coordinatePlusWitnessEquiv ↥k (MulEquiv.refl _)).symm⟩⟩
  · obtain ⟨-, K, _, _, k, b, c, hirr, σ, SS, φ, hk, he⟩ :=
      orthFieldDatum_minus (by omega : 1 ≤ n) hS Nat.prime_three (by norm_num) hβ hout
    have : Finite ↥k := Finite.of_injective (algebraMap k K) (algebraMap k K).injective
    obtain ⟨hl, J, hJ, hZ, ⟨eJ⟩⟩ := comps_of_congr_fieldAutT SS (by omega) φ he
    exact ⟨hl, J, hJ, hZ, ⟨Nat.prime_two, le_rfl, by omega⟩, ↥k, inferInstance, inferInstance,
      hk.trans (by norm_num), b, c, hirr,
      ⟨eJ.trans (coordinateMinusWitnessEquiv ↥k (by omega) b c (MulEquiv.refl _)).symm⟩⟩

