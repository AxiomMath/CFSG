theorem exists_autT_of_mulAut {S : Type} [Group S] (e : S ≃* omegaT) {τ : MulAut S}
    (h3 : τ ^ 3 = 1) (hout : ∀ x : S, MulAut.conj x ≠ τ) :
    ∃ a ∈ autT, a ^ 3 = 1 ∧ a ∉ omegaT ∧
      ∀ s, ((e (τ s) : omegaT) : Equiv.Perm (Fin 360)) = a * e s * a⁻¹ := by
  obtain ⟨a, ha⟩ : ∃ a : autT, autEquiv a = MulAut.congr e τ :=
    ⟨_, MulEquiv.apply_symm_apply _ _⟩
  have hact : ∀ s, ((e (τ s) : omegaT) : Equiv.Perm (Fin 360)) =
      (a : Equiv.Perm (Fin 360)) * e s * (a : Equiv.Perm (Fin 360))⁻¹ := by
    intro s
    have h := autEquiv_apply a (e s)
    rw [ha] at h
    rw [← h]
    simp only [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_apply_apply]
  refine ⟨a, a.2, ?_, fun hmem => ?_, hact⟩
  · have h : a ^ 3 = 1 :=
      autEquiv.injective (by rw [map_pow, ha, ← map_pow, h3, map_one, map_one])
    simpa using congrArg Subtype.val h
  · refine hout (e.symm ⟨a, hmem⟩) (MulEquiv.ext fun s => e.injective (Subtype.ext ?_))
    rw [MulAut.conj_apply, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply, hact]
    rfl

theorem map_conjEmb_fixSubgroup {S : Type} [Group S] (e : S ≃* omegaT) {τ : MulAut S}
    {a y g : Equiv.Perm (Fin 360)}
    (hact : ∀ s, ((e (τ s) : omegaT) : Equiv.Perm (Fin 360)) = a * e s * a⁻¹)
    (hy : y = a ∨ y = a⁻¹) (hg : g ∈ autT) :
    (fixSubgroup τ).map (conjEmb e g) =
      CFSG.Sporadic.Schreier.centralizerIn omegaT (g * y * g⁻¹) := by
  have hya : ∀ x : Equiv.Perm (Fin 360), x * y = y * x ↔ x * a = a * x := by
    rcases hy with rfl | rfl
    · exact fun _ => Iff.rfl
    · exact fun x => Commute.inv_right_iff (a := x) (b := a)
  have hfix : ∀ s, τ s = s ↔ (e s : Equiv.Perm (Fin 360)) * a = a * e s := by
    intro s
    rw [← e.injective.eq_iff, Subtype.ext_iff, hact, mul_inv_eq_iff_eq_mul, eq_comm]
  ext x
  rw [Subgroup.mem_map, CFSG.Sporadic.Schreier.mem_centralizerIn]
  constructor
  · rintro ⟨s, hs, rfl⟩
    have hs' : τ s = s := mem_fixSubgroup.1 hs
    have hsy := (hya _).2 ((hfix s).1 hs')
    rw [conjEmb_apply]
    refine ⟨(conj_mem_omegaT hg).1 (e s).2, ?_⟩
    calc g * ↑(e s) * g⁻¹ * (g * y * g⁻¹) = g * (↑(e s) * y) * g⁻¹ := by group
      _ = g * (y * ↑(e s)) * g⁻¹ := by rw [hsy]
      _ = g * y * g⁻¹ * (g * ↑(e s) * g⁻¹) := by group
  · rintro ⟨hx, hxc⟩
    have hw : g⁻¹ * x * g ∈ omegaT := by
      have h := (conj_mem_omegaT (inv_mem hg)).1 hx
      rwa [inv_inv] at h
    refine ⟨e.symm ⟨g⁻¹ * x * g, hw⟩, mem_fixSubgroup.2 ((hfix _).2 ((hya _).1 ?_)), ?_⟩
    · rw [MulEquiv.apply_symm_apply]
      show g⁻¹ * x * g * y = y * (g⁻¹ * x * g)
      calc g⁻¹ * x * g * y = g⁻¹ * (x * (g * y * g⁻¹)) * g := by group
        _ = g⁻¹ * ((g * y * g⁻¹) * x) * g := by rw [hxc]
        _ = y * (g⁻¹ * x * g) := by group
    · rw [conjEmb_apply, MulEquiv.apply_symm_apply]
      show g * (g⁻¹ * x * g) * g⁻¹ = x
      group

end Model

theorem d42TrialityShape_of_model
    {t2 : Equiv.Perm (Fin 360)}
    {L0 : Subgroup (Equiv.Perm (Fin 360))} (h : D42TriModelFacts t2 L0) : D42TrialityShape := by
  intro S _ _ hS τ h3 hout
  obtain ⟨e⟩ := nonempty_mulEquiv_omegaT (X := S) (Or.inl ⟨by decide, hS⟩)
  obtain ⟨a, haA, ha3, haO, hact⟩ := exists_autT_of_mulAut e h3 hout
  obtain ⟨y, hy, g, hg, hc⟩ := h.exists_conj_rho_or_t2 haA ha3 haO
  have hinj := conjEmb_injective e g
  have hcomp : ∀ L : Subgroup S, CFSG.Open.IsComponentOf L (fixSubgroup τ) →
      CFSG.Open.IsComponentOf (L.map (conjEmb e g))
        (CFSG.Sporadic.Schreier.centralizerIn omegaT (g * y * g⁻¹)) := by
    intro L hL
    rw [← map_conjEmb_fixSubgroup e hact hy hg]
    exact isComponentOf_map_of_injective hinj hL
  rcases hc with hc | hc
  · rw [hc] at hcomp
    have huniq : ∀ L : Subgroup S, CFSG.Open.IsComponentOf L (fixSubgroup τ) →
        L.map (conjEmb e g) = L0 := fun L hL =>
      CFSG.LargeExtraspecial.S5.eq_of_isSubnormal_of_isQuasisimple (hcomp L hL).2.1
        (hcomp L hL).2.2 h.l0Sub_le h.isSimpleGroup_l0Sub h.relIndex_l0Sub_le
    refine ⟨fun L L' hL hL' =>
      Subgroup.map_injective hinj ((huniq L hL).trans (huniq L' hL').symm), fun L hL => ?_⟩
    haveI := h.isSimpleGroup_l0Sub
    obtain ⟨eL0⟩ := h.nonempty_l0_mulEquiv
    let eM : ↥L ≃* ↥L0 :=
      (L.equivMapOfInjective _ hinj).trans (MulEquiv.subgroupCongr (huniq L hL))
    haveI : IsSimpleGroup ↥L := eM.isSimpleGroup
    exact isLieQuot_u33_of_mulEquiv (center_eq_bot_of_isQuasisimple hL.2.2) (eM.trans eL0)
  · rw [hc] at hcomp
    haveI := h.isSolvable_centralizer_t2
    have hnone : ∀ L : Subgroup S, ¬ CFSG.Open.IsComponentOf L (fixSubgroup τ) := fun L hL =>
      CFSG.LargeExtraspecial.S5.not_isSolvable_of_isQuasisimple (hcomp L hL).2.2
        (Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective (hcomp L hL).1))
    exact ⟨fun L _ hL _ => (hnone L hL).elim, fun L hL => (hnone L hL).elim⟩

theorem d42TrialityShape_proved :
    D42TrialityShape :=
  d42TrialityShape_of_model (t2 := t2Perm) (L0 := l0Sub)
    ⟨exists_conj_rho_or_t2, l0Sub_le, isSimpleGroup_l0Sub, relIndex_l0Sub_le,
      nonempty_l0_mulEquiv, isSolvable_centralizer_t2⟩

