structure D42TriModelFacts (t2 : Equiv.Perm (Fin 360)) (L0 : Subgroup (Equiv.Perm (Fin 360))) :
    Prop where
  exists_conj_rho_or_t2 : ∀ {a : Equiv.Perm (Fin 360)}, a ∈ autT → a ^ 3 = 1 → a ∉ omegaT →
    ∃ y, (y = a ∨ y = a⁻¹) ∧ ∃ g ∈ autT, g * y * g⁻¹ = gen 8 ∨ g * y * g⁻¹ = t2
  l0Sub_le : L0 ≤ CFSG.Sporadic.Schreier.centralizerIn omegaT (gen 8)
  isSimpleGroup_l0Sub : IsSimpleGroup ↥L0
  relIndex_l0Sub_le : L0.relIndex (CFSG.Sporadic.Schreier.centralizerIn omegaT (gen 8)) ≤ 2
  nonempty_l0_mulEquiv : Nonempty (↥L0 ≃* CFSG.CosetTable.PG 5 CFSG.Quasithin.u33PresRels)
  isSolvable_centralizer_t2 :
    Group.IsSolvable ↥(CFSG.Sporadic.Schreier.centralizerIn omegaT t2)

theorem isComponentOf_map_of_injective {G G' : Type*} [Group G] [Group G'] {f : G →* G'}
    (hf : Function.Injective f) {L K : Subgroup G} (h : CFSG.Open.IsComponentOf L K) :
    CFSG.Open.IsComponentOf (L.map f) (K.map f) :=
  ⟨Subgroup.map_mono h.1, h.2.1.map f, h.2.2.of_mulEquiv (L.equivMapOfInjective f hf).symm⟩

theorem center_eq_bot_of_isQuasisimple {Y : Type*} [Group Y] [IsSimpleGroup Y]
    (hq : CFSG.Open.IsQuasisimple Y) : Subgroup.center Y = ⊥ := by
  refine (IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center Y)).resolve_right fun h => ?_
  haveI : Nontrivial (Y ⧸ Subgroup.center Y) := hq.2.toNontrivial
  obtain ⟨u, v, huv⟩ := exists_pair_ne (Y ⧸ Subgroup.center Y)
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective u
  obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective v
  exact huv (QuotientGroup.eq.2 (by rw [h]; exact Subgroup.mem_top _))

theorem isLieQuot_u33_of_mulEquiv
    {Y : Type} [Group Y] (hZ : Subgroup.center Y = ⊥)
    (e : Y ≃* CFSG.CosetTable.PG 5 CFSG.Quasithin.u33PresRels) : IsLieQuot Y IsU33Idx := by
  let q : TauCeti.PrimePower := ⟨3, 1, Nat.prime_three, one_pos⟩
  have hq : q.card = 3 := by rw [TauCeti.PrimePower.card_def]; rfl
  have hv : (TauCeti.LieTypeIndex.twistedA 2 q).Valid := by
    refine (TauCeti.LieTypeIndex.valid_iff _).2 ⟨?_, ?_⟩
    · rw [TauCeti.LieTypeIndex.inStandardRange_iff]
      exact ⟨le_rfl, fun _ => hq.symm.le⟩
    · simp [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
  obtain ⟨eU⟩ :=
    CFSG.HardMathSupport.Meierfrankenfeld.AGL81.I542.nonempty_mulEquiv_u33G_of_statedClassicalModel
      (CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 2 q hv (MulEquiv.refl _))
  exact ⟨⟨.twistedA 2 q, hv⟩, ⟨rfl, rfl, rfl⟩, ⟨(QuotientGroup.quotientMulEquivOfEq hZ).trans
    (QuotientGroup.quotientBot.trans (e.trans eU.symm))⟩⟩

@[expose] noncomputable def conjEmb {S : Type} [Group S] (e : S ≃* omegaT)
    (g : Equiv.Perm (Fin 360)) :
    S →* Equiv.Perm (Fin 360) :=
  (MulAut.conj g).toMonoidHom.comp (omegaT.subtype.comp e.toMonoidHom)

theorem conjEmb_apply {S : Type} [Group S] (e : S ≃* omegaT) (g : Equiv.Perm (Fin 360)) (s : S) :
    conjEmb e g s = g * e s * g⁻¹ := rfl

theorem conjEmb_injective {S : Type} [Group S] (e : S ≃* omegaT) (g : Equiv.Perm (Fin 360)) :
    Function.Injective (conjEmb e g) := fun s t hst => by
  rw [conjEmb_apply, conjEmb_apply, mul_left_inj, mul_right_inj] at hst
  exact e.injective (Subtype.ext hst)

