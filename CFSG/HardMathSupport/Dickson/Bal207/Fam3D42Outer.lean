theorem not_isSolvable_of_isQuasisimple {Q : Type*} [Group Q] (h : CFSG.Open.IsQuasisimple Q) :
    ¬ Group.IsSolvable Q := by
  rintro ⟨n, hn⟩
  obtain ⟨hperf, hsimp⟩ := h
  have hder : ∀ m, derivedSeries Q m = ⊤ := fun m => by
    induction m with
    | zero => rfl
    | succ m ih => rw [derivedSeries_succ, ih, ← commutator_def, hperf]
  have h1 : ∀ x : Q, x = 1 := fun x => by
    have hx : x ∈ derivedSeries Q n := by rw [hder n]; exact Subgroup.mem_top x
    rw [hn] at hx
    exact Subgroup.mem_bot.1 hx
  obtain ⟨a, b, hab⟩ := hsimp.toNontrivial.exists_pair_ne
  induction a using QuotientGroup.induction_on with | H a => ?_
  induction b using QuotientGroup.induction_on with | H b => ?_
  exact hab (by rw [h1 a, h1 b])

theorem compShape_of_isSolvable {T : ∀ (Q : Type) [Group Q], Prop} {S : Type} [Group S]
    (β : MulAut S) (h : Group.IsSolvable ↥(fixSubgroup β)) : CompShape T β := by
  have hno : ∀ L : Subgroup S, ¬ CFSG.Open.IsComponentOf L (fixSubgroup β) := by
    rintro L ⟨hLC, -, hq⟩
    haveI := h
    exact not_isSolvable_of_isQuasisimple hq
      (solvable_of_solvable_injective (Subgroup.inclusion_injective hLC))
  exact ⟨perfectInLayer_of_isSolvable_fixSubgroup β h, fun L hL => absurd hL (hno L),
    fun _ _ L hL => absurd hL (hno L)⟩

