theorem compShape_of_range_G2 {S : Type} [Group S] [Finite S]
    (β : MulAut S) (k : Type) [Field k] [Finite k] (hk : Nat.card k = 2)
    (φ : ↥(adjointGroup Tag.G2 k) →* S) (hφ : Function.Injective φ)
    (hC : fixSubgroup β = φ.range) : CompShape G28CompType β := by
  obtain ⟨hq, -, hZT, -, -⟩ := derived_range_adjointG2_two k hk φ hφ
  have hT0 : ⁅φ.range, φ.range⁆ = (commutator (adjointGroup Tag.G2 k)).map φ := by
    rw [commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map]
  let eT : ↥⁅φ.range, φ.range⁆ ≃* ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ :=
    ((MulEquiv.subgroupCongr hT0).trans
      ((commutator (adjointGroup Tag.G2 k)).equivMapOfInjective φ hφ).symm).trans
      (((commutator (adjointGroup Tag.G2 k)).equivMapOfInjective
        (adjointGroup Tag.G2 k).subtype Subtype.val_injective).trans
        (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator _)))
  have hTN : G28CompType ↥⁅φ.range, φ.range⁆ :=
    isoInvariant_g28CompType _ _ eT.symm (g28CompType_of_lieModel_u33
      (CFSG.Quasithin.EmptyFaithfulMultiple.g2TwoDerivedUnitaryTransport_holds _ hk))
  have hT : G28CompType (↥⁅φ.range, φ.range⁆ ⧸ Subgroup.center ↥⁅φ.range, φ.range⁆) :=
    isoInvariant_g28CompType _ _
      ((QuotientGroup.quotientMulEquivOfEq hZT).trans QuotientGroup.quotientBot).symm hTN
  refine excRee_compShape_of_comm_mem _ (N := ⁅φ.range, φ.range⁆) ?_ (fun c₁ hc₁ c₂ hc₂ => ?_)
    ((CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native _).2 hq) hT
  · rw [hC]
    exact (commutator_self_le_and_normalized φ.range).1
  · rw [hC] at hc₁ hc₂
    exact Subgroup.commutator_mem_commutator hc₁ hc₂

variable {K : Type} [Field K] [Finite K]

theorem finite_graphFixedRootGroup (σ : K ≃+* K) :
    Finite ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) := by
  have : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
  exact Finite.of_injective (fun x => (x : ModGL TwistTag.D4.tag K)) Subtype.val_injective

theorem compShape_of_fix_fieldActor (hK : Nat.card K = (2 ^ 1) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (2 ^ 1)) (β : MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom))
    (hβ : fixSubgroup β = fixSubgroup (fieldActor (t := TwistTag.D4) σ σ)) :
    CompShape G28CompType β := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI := finite_graphFixedRootGroup σ
  obtain ⟨e⟩ := LieComp.nonempty_fixSubgroup_fieldActor_equiv_G2 (ℓ := 2) (f := 1) (by norm_num)
    le_rfl (Or.inl rfl) hK σ hσ
  haveI : Finite (fixSubfield σ) := Subtype.finite
  have hk2 : Nat.card (fixSubfield σ) = 2 := by
    rw [CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube Nat.prime_two le_rfl hK σ hσ]
    norm_num
  let φ := (fixSubgroup (fieldActor (t := TwistTag.D4) σ σ)).subtype.comp e.symm.toMonoidHom
  have hφ : Function.Injective φ := Subtype.val_injective.comp e.symm.injective
  have hr : φ.range = fixSubgroup (fieldActor (t := TwistTag.D4) σ σ) := by
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.2 e.symm.surjective,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  exact compShape_of_range_G2 β (fixSubfield σ) hk2 φ hφ (hβ.trans hr.symm)

theorem compShape_outer (hK : Nat.card K = (2 ^ 1) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (2 ^ 1)) (β : MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom))
    (hβ3 : β ^ 3 = 1)
    (hβ : β ∉ (MulAut.conj : ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) →*
      MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).range) :
    CompShape G28CompType β := by
  by_cases hconj : ∃ γ : MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom),
      β = γ * fieldActor (t := TwistTag.D4) σ σ * γ⁻¹ ∨
        β = γ * (fieldActor (t := TwistTag.D4) σ σ)⁻¹ * γ⁻¹
  · obtain ⟨γ, hγ⟩ := hconj
    refine CompShape.of_congr isoInvariant_g28CompType
      ((γ⁻¹ : MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
        ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) ≃* _) ?_
    rw [excRee_congr_self]
    refine compShape_of_fix_fieldActor hK σ hσ _ ?_
    rcases hγ with rfl | rfl
    · rw [show γ⁻¹ * (γ * fieldActor (t := TwistTag.D4) σ σ * γ⁻¹) * γ⁻¹⁻¹ =
        fieldActor (t := TwistTag.D4) σ σ by group]
    · rw [show γ⁻¹ * (γ * (fieldActor (t := TwistTag.D4) σ σ)⁻¹ * γ⁻¹) * γ⁻¹⁻¹ =
        (fieldActor (t := TwistTag.D4) σ σ)⁻¹ by group, fixSubgroup_inv_eq]
  · rcases Item8KFacts2Proof.isStdGraphFieldConj_or_nonempty_autFix_equiv le_rfl hK hσ hβ3 hβ with
      hstd | he₂
    · exact absurd hstd hconj
    · obtain ⟨e₂⟩ := he₂
      obtain ⟨F, _, _, hF, ⟨e₃⟩⟩ := kF82D4SecondCentY0_holds 1 odd_one K σ hK hσ
      have hPi : Sec4.PiField false 2 1 F := ⟨Nat.prime_two, le_rfl, hF⟩
      haveI := Sec13.isSolvable_projImage_glPi_two hPi (by norm_num)
      have hfix : fixSubgroup β = Sec4.autFix β := Subgroup.ext fun _ => Iff.rfl
      let ε := ((MulEquiv.subgroupCongr hfix).trans e₂).trans e₃
      exact compShape_of_isSolvable β
        (solvable_of_solvable_injective (f := ε.toMonoidHom) ε.injective)

