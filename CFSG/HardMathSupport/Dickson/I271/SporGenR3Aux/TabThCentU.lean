theorem th_caseU_spec :
    ∃ R : Subgroup (GL (Fin 248) (ZMod 2)),
      R ≤ Subgroup.centralizer ({((thU : ↥J) : GL (Fin 248) (ZMod 2))} :
        Set (GL (Fin 248) (ZMod 2))) ⊓ J ∧
      (∀ x ∈ Subgroup.centralizer ({((thU : ↥J) : GL (Fin 248) (ZMod 2))} :
        Set (GL (Fin 248) (ZMod 2))) ⊓ J, ∀ r ∈ R, x * r * x⁻¹ ∈ R) ∧ Nat.card R = 3 ^ 5 ∧
      Subgroup.centralizer (R : Set (GL (Fin 248) (ZMod 2))) ⊓
        (Subgroup.centralizer ({((thU : ↥J) : GL (Fin 248) (ZMod 2))} :
          Set (GL (Fin 248) (ZMod 2))) ⊓ J) ≤ R := by
  have h := Certificates.certificate17307
  have e : slpJ a b progU 22 = thU := rfl
  rw [e] at h
  obtain ⟨-, -, R, hRC, hn, hRc, hcent⟩ := h
  have hC' := map_centralizer_subtype' J (thU : ↥J)
  refine ⟨R.map J.subtype, ?_, ?_, ?_, ?_⟩
  · rw [← hC']
    exact Subgroup.map_mono hRC
  · rw [← hC']
    rintro _ ⟨x, hx, rfl⟩ _ ⟨r, hr, rfl⟩
    exact ⟨x * r * x⁻¹, hn x hx r hr, by simp⟩
  · rw [Subgroup.card_map_of_injective J.subtype_injective]
    exact hRc
  · intro y hy
    obtain ⟨hyR, hyC⟩ := Subgroup.mem_inf.1 hy
    rw [← hC'] at hyC
    obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hyC
    refine Subgroup.mem_map.2 ⟨x, hcent x hx fun r hr => ?_, rfl⟩
    have hc := Subgroup.mem_centralizer_iff.1 hyR (r : GL (Fin 248) (ZMod 2))
      (Subgroup.mem_map_of_mem J.subtype hr)
    exact Subtype.ext hc.symm

theorem th_shape_U : ShapeRkAt 3 (LeafType 3) (fun _ _ => True) thU := by
  unfold ShapeRkAt
  left
  refine pConstrainedShape_of_map_injective J.subtype J.subtype_injective ?_
  rw [map_centralizer_subtype']
  obtain ⟨R, hle, hnorm, hcard, hcent⟩ := th_caseU_spec
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact pConstrainedShape_of_normal_pgroup hle (normal_subgroupOf_of_conj hnorm)
    (IsPGroup.of_card (n := 5) hcard) hcent

end Spec

