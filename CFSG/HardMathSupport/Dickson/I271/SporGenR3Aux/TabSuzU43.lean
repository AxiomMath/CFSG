theorem nonempty_mulEquiv_of_isPresentation {X Y : Type*} [Group X] [Group Y] {ι : Type*}
    {g : ι → X} {h : ι → Y} {R : Set (FreeGroup ι)} (hX : IsPresentation g R)
    (hY : IsPresentation h R) : Nonempty (X ≃* Y) := by
  have e1 := QuotientGroup.quotientKerEquivOfSurjective (FreeGroup.lift g) hX.lift_surjective
  have e2 := QuotientGroup.quotientKerEquivOfSurjective (FreeGroup.lift h) hY.lift_surjective
  have e3 : (FreeGroup ι ⧸ (FreeGroup.lift g).ker) ≃* (FreeGroup ι ⧸ (FreeGroup.lift h).ker) :=
    QuotientGroup.quotientMulEquivOfEq (hX.ker_lift.trans hY.ker_lift.symm)
  exact ⟨e1.symm.trans (e3.trans e2)⟩

theorem wordProd_img2_eq_evalW {G : Type*} [Group G] (x y : G) (w : List (Fin 2 × Bool)) :
    CFSG.Sporadic.Bridge.wordProd (CFSG.Sporadic.Bridge.TwoGen.img2 x y)
      (w.map fun l => (l.1.val, l.2)) = evalW ![x, y] w := by
  unfold CFSG.Sporadic.Bridge.wordProd evalW
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  rintro ⟨i, bb⟩ _
  fin_cases i <;> cases bb <;> simp [CFSG.Sporadic.Bridge.TwoGen.img2]

end Pres

