theorem exists_noncomm_of_simple_sq_dvd {G : Type} [Group G] [Finite G] [IsSimpleGroup G]
    {p : ℕ} (hp : p.Prime) (h : p ^ 2 ∣ Nat.card G) : ∃ a b : G, a * b ≠ b * a := by
  by_contra hcon
  push Not at hcon
  haveI : IsMulCommutative G := ⟨⟨fun a b => hcon a b⟩⟩
  have hprime : (Nat.card G).Prime := Group.is_simple_iff_prime_card.mp inferInstance
  have hpd : p ∣ Nat.card G := (dvd_pow_self p (by norm_num)).trans h
  rcases (Nat.dvd_prime hprime).1 hpd with h1 | h1
  · exact hp.one_lt.ne' h1
  · rw [← h1] at h
    have h2 := Nat.le_of_dvd hp.pos h
    have h3 := hp.two_le
    nlinarith

theorem isSimpleGroup_X₀' : IsSimpleGroup X₀ := by
  have hK : Nat.card F9 = (3 ^ 1) ^ 2 := by
    rw [Nat.card_eq_fintype_card, F9.card_eq]
    norm_num
  exact CFSG.ClassicalGroups.Unitary.isSimpleGroup_statedProj_statedSU F9 3 1 hK 4
    (by norm_num) (by decide)


theorem u43_central_ext {T : Type} [Group T] [Finite T] (z a b u v : T)
    (hz : z ∈ Subgroup.center T) (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    (hgen : Subgroup.closure ({a, b, z} : Set T) = ⊤)
    (hrel : ∀ w ∈ rels, evalW ![a, b] w ∈ Subgroup.zpowers z)
    (hcard : Nat.card T = 9797760) (huv : ⁅v, u⁆ = z) :
    CFSG.Open.IsQuasisimple T ∧ Subgroup.center T = Subgroup.zpowers z ∧
      Nonempty ((T ⧸ Subgroup.center T) ≃* X₀) := by
  classical
  set Z := Subgroup.zpowers z with hZdef
  have hZc : Z ≤ Subgroup.center T := by rw [hZdef, Subgroup.zpowers_le]; exact hz
  haveI hZn : Z.Normal := Subgroup.normal_of_le_center hZc
  have hord : orderOf z = 3 := orderOf_eq_prime hz3 hz1
  have hZcard : Nat.card Z = 3 := by rw [hZdef, Nat.card_zpowers, hord]
  let π : T →* T ⧸ Z := QuotientGroup.mk' Z
  have hπs : Function.Surjective π := QuotientGroup.mk'_surjective Z
  have hπker : π.ker = Z := QuotientGroup.ker_mk' Z
  have hGcard : Nat.card (T ⧸ Z) = 3265920 := by
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup Z
    rw [hcard, hZcard] at h
    omega
  have hgenG : Subgroup.closure ({π a, π b} : Set (T ⧸ Z)) = ⊤ := by
    have h1 : (Subgroup.closure ({a, b, z} : Set T)).map π =
        Subgroup.closure (π '' ({a, b, z} : Set T)) := MonoidHom.map_closure π _
    have htop : (⊤ : Subgroup T).map π = ⊤ := by
      rw [← MonoidHom.range_eq_map]
      exact MonoidHom.range_eq_top.2 hπs
    rw [hgen, htop, Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton,
      show π z = 1 from (QuotientGroup.eq_one_iff z).2 (Subgroup.mem_zpowers z)] at h1
    have h2 : Subgroup.closure ({π a, π b, 1} : Set (T ⧸ Z)) =
        Subgroup.closure ({π a, π b} : Set (T ⧸ Z)) := by
      apply le_antisymm
      · rw [Subgroup.closure_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl | rfl
        · exact Subgroup.subset_closure (by simp)
        · exact Subgroup.subset_closure (by simp)
        · exact Subgroup.one_mem _
      · exact Subgroup.closure_mono (by intro x hx; simp only [Set.mem_insert_iff,
          Set.mem_singleton_iff] at hx ⊢; tauto)
    rw [h2] at h1
    exact h1.symm
  have hrelG : ∀ v ∈ rels.map (List.map fun l => (l.1.val, l.2)),
      CFSG.Sporadic.Bridge.wordProd (CFSG.Sporadic.Bridge.TwoGen.img2 (π a) (π b)) v = 1 := by
    intro v hv
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hv
    rw [wordProd_img2_eq_evalW]
    have h1 := map_evalW π ![a, b] w
    have h2 : (fun i => π (![a, b] i)) = (![π a, π b] : Fin 2 → T ⧸ Z) := by
      funext i
      fin_cases i <;> rfl
    rw [h2] at h1
    rw [← h1]
    exact (QuotientGroup.eq_one_iff _).2 (hrel w hw)
  have hP := IsPresentation.of_wordProd_of_card hgenG hrelG CFSG.LieType.Multipliers.U43.card_le
    (by rw [hGcard])
  obtain ⟨eG⟩ := nonempty_mulEquiv_of_isPresentation hP isPresentation_X₀
  haveI hsimpleG : IsSimpleGroup (T ⧸ Z) := eG.isSimpleGroup_congr.2 isSimpleGroup_X₀'
  have hnab : ∃ x y : T ⧸ Z, x * y ≠ y * x :=
    exists_noncomm_of_simple_sq_dvd Nat.prime_two (by rw [hGcard]; norm_num)
  have hcenG : Subgroup.center (T ⧸ Z) = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center (T ⧸ Z)) with h | h
    · exact h
    · exfalso
      obtain ⟨x, y, hxy⟩ := hnab
      exact hxy (Subgroup.mem_center_iff.1 (h ▸ Subgroup.mem_top y) x)
  have hcommG : commutator (T ⧸ Z) = ⊤ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator (T ⧸ Z)) with h | h
    · exfalso
      obtain ⟨x, y, hxy⟩ := hnab
      have h1 : ⁅x, y⁆ = 1 := by
        rw [← Subgroup.mem_bot, ← h]
        exact Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
      exact hxy (commutatorElement_eq_one_iff_mul_comm.1 h1)
    · exact h
  have hcenT : Subgroup.center T = Z := by
    refine le_antisymm (fun g hg => ?_) hZc
    have hπg : π g ∈ Subgroup.center (T ⧸ Z) := by
      rw [Subgroup.mem_center_iff]
      intro h
      obtain ⟨t, rfl⟩ := hπs h
      rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.1 hg t]
    rw [hcenG, Subgroup.mem_bot] at hπg
    rw [← hπker]
    exact hπg
  have hperf : commutator T = ⊤ := by
    have hzK : z ∈ commutator T := by
      rw [← huv]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top v) (Subgroup.mem_top u)
    have hZK : Z ≤ commutator T := by rw [hZdef, Subgroup.zpowers_le]; exact hzK
    have htop : (⊤ : Subgroup T).map π = ⊤ := by
      rw [← MonoidHom.range_eq_map]
      exact MonoidHom.range_eq_top.2 hπs
    have hmapc : (commutator T).map π = commutator (T ⧸ Z) := by
      rw [commutator_def, commutator_def, Subgroup.map_commutator, htop]
    rw [eq_top_iff]
    intro t _
    have ht : π t ∈ (commutator T).map π := by rw [hmapc, hcommG]; exact Subgroup.mem_top _
    obtain ⟨k, hk, hkt⟩ := Subgroup.mem_map.1 ht
    have hkz : k⁻¹ * t ∈ Z := by
      rw [← hπker]
      change π (k⁻¹ * t) = 1
      rw [map_mul, map_inv, hkt, inv_mul_cancel]
    have : t = k * (k⁻¹ * t) := by group
    rw [this]
    exact (commutator T).mul_mem hk (hZK hkz)
  have eT : (T ⧸ Subgroup.center T) ≃* X₀ :=
    (QuotientGroup.quotientMulEquivOfEq hcenT).trans eG
  exact ⟨⟨hperf, eT.isSimpleGroup_congr.2 isSimpleGroup_X₀'⟩, hcenT, ⟨eT⟩⟩

theorem leafType_three_of_equiv_X₀' {T : Type} [Group T] (e : T ≃* X₀) : LeafType 3 T := by
  have hcard : Nat.card T = 3265920 := by rw [Nat.card_congr e.toEquiv]; exact card_X₀
  have hadm : StatedLieAdmissible StatedLieTag.PSU 4 3 1 :=
    ⟨Nat.prime_three, le_rfl, by norm_num, by decide⟩
  have hK : Nat.card F9 = (3 ^ 1) ^ 2 := by
    rw [Nat.card_eq_fintype_card, F9.card_eq]
    norm_num
  refine Or.inl ⟨CFSG.HardMathSupport.Dickson.DefCharOuter.Export.isChevSimple_of_statedPSU hadm
    (K' := F9) hK e, ?_, ?_⟩
  · intro h
    obtain ⟨F, _, _, hF, ⟨e'⟩⟩ := h
    have h2 : Nat.card (StatedProj (StatedSL 2 F)) = 9828 := by
      rw [CFSG.Open.StatedAPI.card_statedProj_statedSL_two_of_odd (by rw [hF]; decide), hF]
      norm_num
    rw [Nat.card_congr e'.toEquiv, h2] at hcard
    omega
  · rintro ⟨f⟩
    rw [Nat.card_congr f.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup] at hcard
    simp [Nat.factorial] at hcard

end Ext

end CFSG.HardMathSupport.Dickson.I271
