section Words

variable {G : Type*} [Group G]

theorem closure_range_codRestrict {n : ℕ} (ε : Fin n → G) :
    Subgroup.closure (Set.range fun i => (⟨ε i, Subgroup.subset_closure (Set.mem_range_self i)⟩ :
      Subgroup.closure (Set.range ε))) = ⊤ := by
  have hpre : ((↑) : Subgroup.closure (Set.range ε) → G) ⁻¹' Set.range ε =
      Set.range fun i => (⟨ε i, Subgroup.subset_closure (Set.mem_range_self i)⟩ :
        Subgroup.closure (Set.range ε)) := by
    ext y
    constructor
    · rintro ⟨i, hi⟩
      exact ⟨i, Subtype.ext hi⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, rfl⟩
  rw [← hpre]
  exact Subgroup.closure_closure_coe_preimage

end Words

section Six

theorem finite_closure_of_satisfiesG23Words {X : Type*} [Group X] (ρ : Fin 6 → X)
    (h : SatisfiesG23Words ρ) : Finite ↥(Subgroup.closure (Set.range ρ)) := by
  obtain ⟨hfin, -⟩ := card_PG_le
  have hrel : ∀ r ∈ {r : FreeGroup (Fin 6) | r ∈ g23Words.map FreeGroup.mk},
      FreeGroup.lift ρ r = 1 := by
    rintro r hr
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hr
    exact h w hw
  let φ : PG 6 g23Words →* X := PresentedGroup.toGroup hrel
  have hrange : φ.range = Subgroup.closure (Set.range ρ) := by
    rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of
      {r : FreeGroup (Fin 6) | r ∈ g23Words.map FreeGroup.mk}, MonoidHom.map_closure]
    congr 1
    ext x
    simp [φ, PresentedGroup.toGroup.of]
  haveI : Finite φ.range := Finite.of_surjective _ φ.rangeRestrict_surjective
  rw [← hrange]
  exact this

end Six

end TabThG2

open TabThG2

section Main

theorem nonempty_mulEquiv_adjointG2_of_six {X : Type*} [Group X] (ε : Fin 6 → X)
    (hε : SatisfiesG23Words ε) (hne : ∃ i, ε i ≠ 1) :
    Nonempty (↥(Subgroup.closure (Set.range ε)) ≃* Ghat) := by
  set S := Subgroup.closure (Set.range ε) with hS
  haveI : Finite S := finite_closure_of_satisfiesG23Words ε hε
  let ε' : Fin 6 → S := fun i => ⟨ε i, Subgroup.subset_closure (Set.mem_range_self i)⟩
  have htop : Subgroup.closure (Set.range ε') = ⊤ := closure_range_codRestrict ε
  have hε' : SatisfiesG23Words ε' := by
    intro r hr
    have hcomp : S.subtype.comp (FreeGroup.lift ε') = FreeGroup.lift ε :=
      FreeGroup.ext_hom _ _ fun i => by simp [ε']
    have h1 := congrArg (fun φ => φ (FreeGroup.mk r)) hcomp
    simp only [MonoidHom.comp_apply] at h1
    apply Subtype.ext
    simpa [hε r hr] using h1
  have hne' : ∃ i, ε' i ≠ 1 := by
    obtain ⟨i, hi⟩ := hne
    exact ⟨i, fun h => hi (congrArg Subtype.val h)⟩
  obtain ⟨u, hu, hugen⟩ := exists_letters_native
  obtain ⟨e⟩ := nonempty_mulEquiv_native_of_letters ghat_simple ghat_card u hu hugen ε' hε' hne'
  exact ⟨Subgroup.topEquiv.symm.trans ((MulEquiv.subgroupCongr htop.symm).trans e)⟩

end Main

section Leaf

theorem leafType_three_of_equiv_adjointG2 {T : Type} [Group T] (e : T ≃* Ghat) :
    LeafType 3 T ∧ IsSimpleGroup T ∧ (∃ a b : T, a * b ≠ b * a) ∧ Nat.card T = 4245696 := by
  have hcardT : Nat.card T = 4245696 :=
    (Nat.card_congr e.toEquiv).trans (ghat_card.trans (by norm_num))
  have hsimp : IsSimpleGroup T := e.isSimpleGroup_congr.2 ghat_simple
  have hchev : IsChevSimple 3 T := by
    have h := CFSG.HardMathSupport.Dickson.DefCharOuter.Export.ExcUntwisted.isChevSimple_adjoint
      .G2 (Or.inl rfl) Nat.prime_three (by norm_num) (d := 1) le_rfl (ZMod 3)
      (by rw [Nat.card_zmod, pow_one])
    rcases h with ⟨i, hi, ⟨f⟩⟩ | ⟨i, hi, ⟨f⟩⟩
    · exact Or.inl ⟨i, hi, ⟨e.trans f⟩⟩
    · exact Or.inr ⟨i, hi, ⟨e.trans f⟩⟩
  refine ⟨Or.inl ⟨hchev, ?_, ?_⟩, hsimp, ?_, hcardT⟩
  · intro h
    obtain ⟨F, _, _, hF, ⟨e'⟩⟩ := h
    have h2 : Nat.card (StatedProj (StatedSL 2 F)) = 9828 := by
      rw [CFSG.Open.StatedAPI.card_statedProj_statedSL_two_of_odd (by rw [hF]; decide), hF]
      norm_num
    rw [Nat.card_congr e'.toEquiv, h2] at hcardT
    omega
  · rintro ⟨f⟩
    rw [Nat.card_congr f.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup] at hcardT
    simp [Nat.factorial] at hcardT
  · by_contra hc
    push Not at hc
    haveI := hsimp
    letI : CommGroup T := { (inferInstance : Group T) with mul_comm := hc }
    have hp := IsSimpleGroup.prime_card (α := T)
    rw [hcardT] at hp
    norm_num at hp

end Leaf

