private theorem quasisimple_statedSU_U43 :
    CFSG.IsQuasisimple ↥(StatedSU 4 3 F9) ∧
      Subgroup.center ↥(StatedSU 4 3 F9) =
        (StatedScalars (Fin 4) F9).subgroupOf (StatedSU 4 3 F9) := by
