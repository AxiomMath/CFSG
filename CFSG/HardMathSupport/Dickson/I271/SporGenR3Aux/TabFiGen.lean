section Solvable

variable {Q : Type} [Group Q]

theorem isSolvable_inf_centralizer_of_normal_solvable {C : Subgroup Q} (E : Subgroup ↥C)
    [E.Normal] (hZ : Subgroup.center ↥(E.map C.subtype) = ⊥)
    (hq : Group.IsSolvable (↥C ⧸ E)) :
    Group.IsSolvable ↥(C ⊓ Subgroup.centralizer ((E.map C.subtype : Subgroup Q) : Set Q)) := by
  let L : Subgroup Q := E.map C.subtype
  let ι : ↥(C ⊓ Subgroup.centralizer (L : Set Q)) →* ↥C := Subgroup.inclusion inf_le_left
  let f : ↥(C ⊓ Subgroup.centralizer (L : Set Q)) →* ↥C ⧸ E := (QuotientGroup.mk' E).comp ι
  have hf : Function.Injective f := by
    rw [injective_iff_map_eq_one]
    intro z hz
    have hzE : ι z ∈ E := (QuotientGroup.eq_one_iff _).1 hz
    have hzL : (z : Q) ∈ L := ⟨ι z, hzE, rfl⟩
    let ζ : ↥L := ⟨(z : Q), hzL⟩
    have hζ : ζ ∈ Subgroup.center ↥L := by
      rw [Subgroup.mem_center_iff]
      intro b
      have h1 : (b : Q) * (z : Q) = (z : Q) * (b : Q) :=
        Subgroup.mem_centralizer_iff.1 z.2.2 _ b.2
      exact Subtype.ext h1
    rw [hZ, Subgroup.mem_bot] at hζ
    have h4 : (z : Q) = 1 := congrArg (fun x : ↥L => (x : Q)) hζ
    exact Subtype.ext h4
  exact Group.isSolvable_of_isSolvable_injective hf

theorem isOpenQuasisimple_of_simple_nonab {J : Type} [Group J] [IsSimpleGroup J]
    (hnab : ∃ a b : J, a * b ≠ b * a) : CFSG.Open.IsQuasisimple J := by
  have hZ : Subgroup.center J = ⊥ := center_eq_bot_of_simple_nonab hnab
  refine ⟨?_, ((QuotientGroup.quotientMulEquivOfEq hZ).trans
    QuotientGroup.quotientBot).isSimpleGroup⟩
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator J) with h | h
  · exfalso
    obtain ⟨a, b, hab⟩ := hnab
    have h1 : ⁅a, b⁆ = 1 := by
      rw [← Subgroup.mem_bot, ← h]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top b)
    exact hab (commutatorElement_eq_one_iff_mul_comm.1 h1)
  · exact h

theorem glaPPrimeCoreOf_eq_bot_iff_glaPPrimeCore {Y : Type} [Group Y] (p : ℕ) (H : Subgroup Y) :
    GLAPPrimeCoreOf p H = ⊥ ↔ GLAPPrimeCore p ↥H = ⊥ := by
  unfold GLAPPrimeCoreOf GLAPPrimeCore
  exact Subgroup.map_eq_bot_iff_of_injective _ H.subtype_injective

end Solvable

section Normal

variable {Q : Type} [Group Q] [Finite Q]

theorem eq_of_glaPComponent_of_normal_quasisimple_solvable {p : ℕ} (hp : p.Prime)
    {C L J : Subgroup Q} (hLC : L ≤ C) (hLn : ∀ g ∈ C, ∀ l ∈ L, g * l * g⁻¹ ∈ L)
    (hLq : CFSG.Open.IsQuasisimple ↥L) (hcore : GLAPPrimeCore p ↥C = ⊥)
    (hcent : Group.IsSolvable ↥(C ⊓ Subgroup.centralizer (L : Set Q)))
    (hJ : GLAPComponent p C J) : J = L := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hL : GLAPComponent p C L := glaPComponent_of_normal_quasisimple hLC hLn hLq hcore
  by_contra hne
  have hb : barX p C J ≠ barX p C L := fun h => hne (glaPComponent_unique hJ hL h)
  have hcomm : ⁅barX p C J, barX p C L⁆ = ⊥ :=
    CFSG.ComponentClassification.LocalComponents.commute_of_ne _ _ hJ.2.2.1 hL.2.2.1 hb
  have hinj : Function.Injective (QuotientGroup.mk' (GLAPPrimeCore p ↥C)) :=
    mk'_injective_of_eq_bot _ hcore
  have hJC : J ≤ C := hJ.1
  have hJcent : J ≤ C ⊓ Subgroup.centralizer (L : Set Q) := by
    intro x hx
    refine ⟨hJC hx, Subgroup.mem_centralizer_iff.2 ?_⟩
    intro l hl
    have hx' : (⟨x, hJC hx⟩ : ↥C) ∈ J.subgroupOf C := hx
    have hl' : (⟨l, hLC hl⟩ : ↥C) ∈ L.subgroupOf C := hl
    have h1 : QuotientGroup.mk' (GLAPPrimeCore p ↥C) ⟨x, hJC hx⟩ ∈ barX p C J :=
      Subgroup.mem_map_of_mem _ hx'
    have h2 : QuotientGroup.mk' (GLAPPrimeCore p ↥C) ⟨l, hLC hl⟩ ∈ barX p C L :=
      Subgroup.mem_map_of_mem _ hl'
    have hc : ⁅QuotientGroup.mk' (GLAPPrimeCore p ↥C) ⟨x, hJC hx⟩,
        QuotientGroup.mk' (GLAPPrimeCore p ↥C) ⟨l, hLC hl⟩⁆ = 1 := by
      have := Subgroup.commutator_mem_commutator h1 h2
      rw [hcomm, Subgroup.mem_bot] at this
      exact this
    rw [← map_commutatorElement] at hc
    have hc2 := hinj (hc.trans (map_one _).symm)
    have := commutatorElement_eq_one_iff_mul_comm.1 hc2
    exact (congrArg Subtype.val this).symm
  have hJs : Group.IsSolvable ↥J :=
    Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hJcent)
  have hbs : Group.IsSolvable ↥(barX p C J) := by
    let e1 : ↥(J.subgroupOf C) ≃* ↥J := Subgroup.subgroupOfEquivOfLe hJC
    let e2 : ↥(J.subgroupOf C) ≃* ↥(barX p C J) :=
      (J.subgroupOf C).equivMapOfInjective _ hinj
    haveI : Group.IsSolvable ↥(J.subgroupOf C) :=
      Group.isSolvable_of_isSolvable_injective (f := e1.toMonoidHom) e1.injective
    exact Group.isSolvable_of_isSolvable_injective (f := e2.symm.toMonoidHom) e2.symm.injective
  have hq := hJ.2.2.1.2.2
  haveI : Nontrivial ↥(barX p C J) := by
    have := hq.2.exists_pair_ne
    obtain ⟨a, b, hab⟩ := this
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
    exact ⟨a, b, fun h => hab (by rw [h])⟩
  have hperf : Group.IsPerfect ↥(barX p C J) := ⟨hq.1⟩
  exact Group.IsPerfect.not_isSolvable _ hbs

theorem shapeRkAt_of_normal_quasisimple_solvable {p : ℕ} (hp : p.Prime)
    {Good Rk : ∀ (T : Type) [Group T], Prop} {t : Q} {L : Subgroup Q}
    (hLC : L ≤ Subgroup.centralizer ({t} : Set Q))
    (hLn : ∀ g ∈ Subgroup.centralizer ({t} : Set Q), ∀ l ∈ L, g * l * g⁻¹ ∈ L)
    (hLq : CFSG.Open.IsQuasisimple ↥L)
    (hcore : GLAPPrimeCore p ↥(Subgroup.centralizer ({t} : Set Q)) = ⊥)
    (hcent : Group.IsSolvable ↥(Subgroup.centralizer ({t} : Set Q) ⊓
      Subgroup.centralizer (L : Set Q)))
    (hG : Good (PSimple p L)) (hR : Rk (PQuot p L)) : ShapeRkAt p Good Rk t :=
  Or.inr ⟨L, glaPComponent_of_normal_quasisimple hLC hLn hLq hcore,
    fun I hI => eq_of_glaPComponent_of_normal_quasisimple_solvable hp hLC hLn hLq hcore hcent hI,
    hG, hR⟩

end Normal

section Subtype

variable {G : Type} [Group G]

theorem shapeRkAt_of_subgroup_data_solvable {p : ℕ} (hp : p.Prime)
    {Good Rk : ∀ (T : Type) [Group T], Prop}
    (hGood : ∀ (T T' : Type) [Group T] [Group T'], T ≃* T' → Good T → Good T')
    (hRk : ∀ (T T' : Type) [Group T] [Group T'], T ≃* T' → Rk T → Rk T')
    (P : Subgroup G) [Finite P] (x : ↥P) (L : Subgroup G)
    (hLC : L ≤ Subgroup.centralizer ({(x : G)} : Set G) ⊓ P)
    (hLn : ∀ g ∈ Subgroup.centralizer ({(x : G)} : Set G) ⊓ P, ∀ l ∈ L, g * l * g⁻¹ ∈ L)
    (hs : IsSimpleGroup ↥L) (hnab : ∃ a b : ↥L, a * b ≠ b * a) (hpL : p ∣ Nat.card ↥L)
    (hcore : GLAPPrimeCore p ↥(Subgroup.centralizer ({x} : Set ↥P)) = ⊥)
    {m : ℕ} (hk : Nat.card ↥(Subgroup.centralizer ({(x : G)} : Set G) ⊓ P) = Nat.card ↥L * m)
    (hm : m ∣ 6)
    (hG : Good ↥L) (hR : Rk ↥L) : ShapeRkAt p Good Rk x := by
  have hLP : L ≤ P := fun l hl => (hLC hl).2
  haveI : Finite ↥L :=
    Finite.of_injective (Subgroup.inclusion hLP) (Subgroup.inclusion_injective hLP)
  let C' : Subgroup ↥P := Subgroup.centralizer ({x} : Set ↥P)
  let L' : Subgroup ↥P := L.comap P.subtype
  have hmapC : C'.map P.subtype = Subgroup.centralizer ({(x : G)} : Set G) ⊓ P := by
    exact map_centralizer_subtype' P x
  have hL'C : L' ≤ C' := by
    intro l hl
    have hl1 : (l : G) ∈ Subgroup.centralizer ({(x : G)} : Set G) ⊓ P :=
      hLC hl
    have hc := Subgroup.mem_centralizer_singleton_iff.1 (Subgroup.mem_inf.1 hl1).1
    exact Subgroup.mem_centralizer_singleton_iff.2 (Subtype.ext hc)
  let E : Subgroup ↥C' := L'.subgroupOf C'
  have hEn : E.Normal := by
    refine ⟨fun e he g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at he ⊢
    have hgC : ((g : ↥P) : G) ∈ Subgroup.centralizer ({(x : G)} : Set G) ⊓ P := by
      rw [← hmapC]
      exact ⟨g, g.2, rfl⟩
    have := hLn _ hgC _ he
    exact this
  haveI := hEn
  have hEmap : E.map C'.subtype = L' := Subgroup.map_subgroupOf_eq_of_le hL'C
  have eL : ↥L' ≃* ↥L := Subgroup.subgroupOfEquivOfLe hLP
  have eE : ↥(E.map C'.subtype) ≃* ↥L := (MulEquiv.subgroupCongr hEmap).trans eL
  have hsE : IsSimpleGroup ↥(E.map C'.subtype) := eE.isSimpleGroup_congr.2 hs
  have hnabE : ∃ a b : ↥(E.map C'.subtype), a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hnab
    exact ⟨eE.symm a, eE.symm b, fun h => hab (by simpa using congrArg eE h)⟩
  have hpE : p ∣ Nat.card ↥(E.map C'.subtype) := by
    rw [Nat.card_congr eE.toEquiv]; exact hpL
  have hZE : Subgroup.center ↥(E.map C'.subtype) = ⊥ := by
    haveI := hsE
    exact center_eq_bot_of_simple_nonab hnabE
  have hcoreE : GLAPPrimeCore p ↥(E.map C'.subtype) = ⊥ := by
    haveI := hsE
    exact glaPPrimeCore_eq_bot_of_simple hp hpE
  have hq : Group.IsSolvable (↥C' ⧸ E) := by
    have hcardC : Nat.card ↥C' = Nat.card ↥L * m := by
      rw [← hk, ← hmapC, Subgroup.card_map_of_injective P.subtype_injective]
    have hcardE : Nat.card ↥E = Nat.card ↥L := by
      rw [← Subgroup.card_map_of_injective C'.subtype_injective, hEmap]
      exact Nat.card_congr eL.toEquiv
    have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup E
    have hpos : 0 < Nat.card ↥L := Nat.card_pos
    rw [hcardC, hcardE] at h1
    have hmq : Nat.card (↥C' ⧸ E) = m :=
      (Nat.eq_of_mul_eq_mul_left hpos (h1.trans (mul_comm _ _))).symm
    exact isSolvable_of_card_dvd_two_three (a := 1) (b := 1) (by rw [hmq]; simpa using hm)
  have hLCP : E.map C'.subtype ≤ Subgroup.centralizer ({x} : Set ↥P) := Subgroup.map_subtype_le E
  have hLnP : ∀ g ∈ Subgroup.centralizer ({x} : Set ↥P), ∀ l ∈ E.map C'.subtype,
      g * l * g⁻¹ ∈ E.map C'.subtype := by
    rintro g hg _ ⟨e, he, rfl⟩
    exact ⟨⟨g, hg⟩ * e * ⟨g, hg⟩⁻¹, ‹E.Normal›.conj_mem e he ⟨g, hg⟩, rfl⟩
  have hLq : CFSG.Open.IsQuasisimple ↥(E.map C'.subtype) := by
    haveI := hsE
    exact isOpenQuasisimple_of_simple_nonab hnabE
  refine shapeRkAt_of_normal_quasisimple_solvable hp hLCP hLnP hLq hcore
    (isSolvable_inf_centralizer_of_normal_solvable E hZE hq) ?_ ?_
  · exact hGood ↥L _ ((pSimpleEquivSelf (E.map C'.subtype) hcoreE hZE).trans eE).symm hG
  · exact hRk ↥L _ ((pQuotEquivSelf (E.map C'.subtype) hcoreE).trans eE).symm hR

end Subtype

section Presentation

open CFSG.LieType.Multipliers.U43 CFSG.CosetTable
  CFSG.RankThree.PartTwo.Sec4.Census.CoverCenterThreeRest

private theorem closure_range_xElt_yElt :
    Subgroup.closure (Set.range (![xElt, yElt] : Fin 2 → X₀)) = ⊤ := by
  rw [← closure_xy]
  congr 1
  ext g
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

private theorem evalW_rels_xElt_yElt :
    ∀ w ∈ rels, evalW (![xElt, yElt] : Fin 2 → X₀) w = 1 := by
  intro w hw
  have h := isPresentation_X₀.lift_eq_one (r := FreeGroup.mk w) (List.mem_map_of_mem hw)
  have hg : (fun i : Fin 2 => CFSG.Sporadic.Bridge.TwoGen.img2 xElt yElt i.val) =
      (![xElt, yElt] : Fin 2 → X₀) := by
    funext i
    fin_cases i <;> rfl
  rw [hg, lift_mk_eq_evalW] at h
  exact h

theorem nonempty_mulEquiv_X₀_of_rels {G : Type} [Group G]
    (g : Fin 2 → G) (hrels : ∀ w ∈ CFSG.LieType.Multipliers.U43.rels,
      CFSG.RankThree.PartTwo.Sec4.Census.CoverCenterThreeRest.evalW g w = 1)
    (hcard : Nat.card ↥(Subgroup.closure (Set.range g)) = 3265920) :
    Nonempty (↥(Subgroup.closure (Set.range g)) ≃* CFSG.LieType.Multipliers.U43.X₀) := by
  obtain ⟨hfin, hP⟩ := CFSG.LieType.Multipliers.U43.card_le
  have hN₂ : 3265920 ≤
      Nat.card ↥(Subgroup.closure (Set.range (![xElt, yElt] : Fin 2 → X₀))) := by
    rw [closure_range_xElt_yElt, Subgroup.card_top, card_X₀]
  obtain ⟨e⟩ := CFSG.AGLEmbeddingD2.Wilson.Census228Spor.nonempty_mulEquiv_of_presented g
    (![xElt, yElt] : Fin 2 → X₀) rels hrels evalW_rels_xElt_yElt hfin 3265920 (by omega)
    hcard.ge hN₂
  exact ⟨e.trans ((MulEquiv.subgroupCongr closure_range_xElt_yElt).trans Subgroup.topEquiv)⟩

