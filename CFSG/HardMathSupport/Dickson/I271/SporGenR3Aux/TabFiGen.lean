    ↥(StatedSU 4 3 F9) ⧸ Subgroup.center ↥(StatedSU 4 3 F9) ≃* X₀ :=
  QuotientGroup.quotientMulEquivOfEq quasisimple_statedSU_U43.2

theorem isChevSimple_three_X₀ : IsChevSimple 3 X₀ := by
  have hFD := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds F9 4 3
    (by rw [F9.card_eq]; norm_num) (by norm_num) (by decide)
