section Moved

variable {G : Type} [Group G]

@[expose] def HNMovedIn (C : Subgroup G) : Prop :=
  ∃ Q : Subgroup G, Q ≤ C ∧ (Q.subgroupOf C).Normal ∧ Group.IsSolvable ↥Q ∧
    ∃ s ∈ C, orderOf s = 3 ∧ ∃ q ∈ Q, s * q ≠ q * s

theorem HNMovedIn.map (φ : G ≃* G) {C : Subgroup G} (h : HNMovedIn C) :
    HNMovedIn (C.map φ.toMonoidHom) := by
  obtain ⟨Q, hQC, hQn, hQs, s, hsC, hso, q, hq, hne⟩ := h
  refine ⟨Q.map φ.toMonoidHom, Subgroup.map_mono hQC, ?_, ?_, φ s,
    Subgroup.mem_map_of_mem _ hsC, ?_, φ q, Subgroup.mem_map_of_mem _ hq, ?_⟩
  · rw [Subgroup.normal_subgroupOf_iff_le_normalizer (Subgroup.map_mono hQC)]
    have hN := (Subgroup.normal_subgroupOf_iff_le_normalizer hQC).1 hQn
    intro g' hg'
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.1 hg'
    rw [Subgroup.mem_normalizer_iff]
    intro h
    rw [Subgroup.mem_map_equiv, Subgroup.mem_map_equiv]
    have := (Subgroup.mem_normalizer_iff.1 (hN hg)) (φ.symm h)
    rw [this]
    simp only [MulEquiv.coe_toMonoidHom, map_mul, map_inv, MulEquiv.symm_apply_apply]
  · haveI := hQs
    exact Group.isSolvable_of_surjective
      (f := (Subgroup.equivMapOfInjective Q φ.toMonoidHom φ.injective).toMonoidHom)
      (fun x => ⟨(Subgroup.equivMapOfInjective Q φ.toMonoidHom φ.injective).symm x,
        (Subgroup.equivMapOfInjective Q φ.toMonoidHom φ.injective).apply_symm_apply x⟩)
  · exact (orderOf_injective φ.toMonoidHom φ.injective s).trans hso
  · exact fun h => hne (φ.injective (by simpa only [map_mul] using h))

theorem map_centralizer_conj (c x : G) :
    (Subgroup.centralizer ({x} : Set G)).map (MulAut.conj c).toMonoidHom =
      Subgroup.centralizer ({c * x * c⁻¹} : Set G) := by
  ext y
  rw [Subgroup.mem_map_equiv, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff, MulAut.conj_symm_apply]
  constructor
  · intro h
    calc y * (c * x * c⁻¹) = c * ((c⁻¹ * y * c) * x) * c⁻¹ := by group
      _ = c * (x * (c⁻¹ * y * c)) * c⁻¹ := by rw [h]
      _ = c * x * c⁻¹ * y := by group
  · intro h
    calc c⁻¹ * y * c * x = c⁻¹ * (y * (c * x * c⁻¹)) * c := by group
      _ = c⁻¹ * ((c * x * c⁻¹) * y) * c := by rw [h]
      _ = x * (c⁻¹ * y * c) := by group

theorem HNMovedIn.of_isConj {x z : G} (h : IsConj x z)
    (hx : HNMovedIn (Subgroup.centralizer ({x} : Set G))) :
    HNMovedIn (Subgroup.centralizer ({z} : Set G)) := by
  obtain ⟨c, hc⟩ := isConj_iff.1 h
  rw [← hc, ← map_centralizer_conj]
  exact hx.map (MulAut.conj c)

theorem not_dvd_card_of_normal [Finite G] {C K : Subgroup G} (hKC : K ≤ C)
    (hKn : (K.subgroupOf C).Normal) (h9 : ¬ 3 ^ 2 ∣ Nat.card ↥C) {s : G} (hsC : s ∈ C)
    (hs : orderOf s = 3) (hsK : s ∉ K) : ¬ 3 ∣ Nat.card ↥K := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  intro h3
  obtain ⟨t, ht⟩ := exists_prime_orderOf_dvd_card' (G := ↥K) 3 h3
  have hto : orderOf (⟨t.1, hKC t.2⟩ : ↥C) = 3 := by
    rw [Subgroup.orderOf_mk, Subgroup.orderOf_coe]
    exact ht
  have hso : orderOf (⟨s, hsC⟩ : ↥C) = 3 := by rw [Subgroup.orderOf_mk]; exact hs
  obtain ⟨g, k, hgk⟩ := CFSG.RankThree.PartOne.HNRed.exists_conj_pow_of_orderOf_prime (p := 3)
    (G := ↥C) h9 hto hso
  apply hsK
  have hkK : (⟨t.1, hKC t.2⟩ : ↥C) ^ k ∈ K.subgroupOf C :=
    Subgroup.pow_mem _ (Subgroup.mem_subgroupOf.2 t.2) k
  have hs' : (⟨s, hsC⟩ : ↥C) = g⁻¹ * ((⟨t.1, hKC t.2⟩ : ↥C) ^ k) * g⁻¹⁻¹ := by
    rw [← hgk]
    group
  have hmem : (⟨s, hsC⟩ : ↥C) ∈ K.subgroupOf C := by
    rw [hs']
    exact hKn.conj_mem _ hkK g⁻¹
  exact Subgroup.mem_subgroupOf.1 hmem

end Moved

section Matrices

theorem matJ_mul (g h : JH) : matJ (g * h) = matJ g * matJ h := rfl

theorem matJ_one : matJ (1 : JH) = 1 := rfl

theorem matJ_pow (g : JH) (n : ℕ) : matJ (g ^ n) = matJ g ^ n := by
  induction n with
  | zero => exact matJ_one
  | succ n ih => rw [pow_succ, matJ_mul, ih, pow_succ]

theorem matJ_inv_mul (g : JH) : matJ g⁻¹ * matJ g = 1 := by
  rw [← matJ_mul, inv_mul_cancel, matJ_one]

theorem matJ_mul_inv (g : JH) : matJ g * matJ g⁻¹ = 1 := by
  rw [← matJ_mul, mul_inv_cancel, matJ_one]

end Matrices

section Ker

@[expose] def ActsTrivM2 (y c : JH) : Prop :=
  ∀ v : Fin 133 → ZMod 5, (matJ y - 1) *ᵥ v = 0 →
    ∃ w, (matJ c - 1) *ᵥ v = (matJ y - 1) *ᵥ ((matJ y - 1) *ᵥ w)

theorem comm_T {y c : JH} (hc : c ∈ Subgroup.centralizer ({y} : Set JH))
    (w : Fin 133 → ZMod 5) :
    matJ c *ᵥ ((matJ y - 1) *ᵥ w) = (matJ y - 1) *ᵥ (matJ c *ᵥ w) := by
  have h := Subgroup.mem_centralizer_singleton_iff.1 hc
  have hm : matJ c * matJ y = matJ y * matJ c := by rw [← matJ_mul, ← matJ_mul, h]
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, mul_sub, sub_mul, mul_one, one_mul, hm]

theorem comm_T2 {y c : JH} (hc : c ∈ Subgroup.centralizer ({y} : Set JH))
    (w : Fin 133 → ZMod 5) :
    matJ c *ᵥ ((matJ y - 1) *ᵥ ((matJ y - 1) *ᵥ w)) =
      (matJ y - 1) *ᵥ ((matJ y - 1) *ᵥ (matJ c *ᵥ w)) := by
  rw [comm_T hc, comm_T hc]

theorem actsTrivM2_one (y : JH) : ActsTrivM2 y 1 := by
  intro v _
  refine ⟨0, ?_⟩
  rw [matJ_one, sub_self, Matrix.zero_mulVec, Matrix.mulVec_zero, Matrix.mulVec_zero]

theorem actsTrivM2_mul {y c d : JH} (hc : c ∈ Subgroup.centralizer ({y} : Set JH))
    (hcA : ActsTrivM2 y c) (hdA : ActsTrivM2 y d) : ActsTrivM2 y (c * d) := by
  intro v hv
  obtain ⟨w₁, h₁⟩ := hdA v hv
  obtain ⟨w₂, h₂⟩ := hcA v hv
  refine ⟨matJ c *ᵥ w₁ + w₂, ?_⟩
  have e : matJ (c * d) - 1 = matJ c * (matJ d - 1) + (matJ c - 1) := by
    rw [matJ_mul]
    noncomm_ring
  rw [e, Matrix.add_mulVec, ← Matrix.mulVec_mulVec, h₁, h₂, comm_T2 hc, Matrix.mulVec_add,
    Matrix.mulVec_add]

theorem actsTrivM2_inv {y c : JH} (hc : c ∈ Subgroup.centralizer ({y} : Set JH))
    (hcA : ActsTrivM2 y c) : ActsTrivM2 y c⁻¹ := by
  intro v hv
  obtain ⟨w, hw⟩ := hcA v hv
  refine ⟨-(matJ c⁻¹ *ᵥ w), ?_⟩
  have e : matJ c⁻¹ - 1 = -(matJ c⁻¹ * (matJ c - 1)) := by
    rw [mul_sub, mul_one, matJ_inv_mul, neg_sub]
  rw [e, Matrix.neg_mulVec, ← Matrix.mulVec_mulVec, hw, comm_T2 (Subgroup.inv_mem _ hc),
    Matrix.mulVec_neg, Matrix.mulVec_neg]

theorem actsTrivM2_conj {y c g : JH} (hg : g ∈ Subgroup.centralizer ({y} : Set JH))
    (hcA : ActsTrivM2 y c) : ActsTrivM2 y (g * c * g⁻¹) := by
  intro v hv
  have hv' : (matJ y - 1) *ᵥ (matJ g⁻¹ *ᵥ v) = 0 := by
    rw [← comm_T (Subgroup.inv_mem _ hg), hv, Matrix.mulVec_zero]
  obtain ⟨w, hw⟩ := hcA _ hv'
  refine ⟨matJ g *ᵥ w, ?_⟩
  have e : matJ (g * c * g⁻¹) - 1 = matJ g * ((matJ c - 1) * matJ g⁻¹) := by
    have h1 := matJ_mul_inv g
    rw [matJ_mul, matJ_mul]
    calc matJ g * matJ c * matJ g⁻¹ - 1 = matJ g * matJ c * matJ g⁻¹ - matJ g * matJ g⁻¹ := by
          rw [h1]
      _ = matJ g * ((matJ c - 1) * matJ g⁻¹) := by noncomm_ring
  rw [e, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hw, comm_T2 hg]

noncomputable def hnKer (y : JH) : Subgroup JH where
  carrier := {c | c ∈ Subgroup.centralizer ({y} : Set JH) ∧ ActsTrivM2 y c}
  one_mem' := ⟨Subgroup.one_mem _, actsTrivM2_one y⟩
  mul_mem' := fun {c d} hc hd => ⟨Subgroup.mul_mem _ hc.1 hd.1, actsTrivM2_mul hc.1 hc.2 hd.2⟩
  inv_mem' := fun {c} hc => ⟨Subgroup.inv_mem _ hc.1, actsTrivM2_inv hc.1 hc.2⟩

theorem hnKer_le (y : JH) : hnKer y ≤ Subgroup.centralizer ({y} : Set JH) := fun _ hc => hc.1

theorem hnKer_normal (y : JH) :
    ((hnKer y).subgroupOf (Subgroup.centralizer ({y} : Set JH))).Normal := by
  refine ⟨fun n hn g => ?_⟩
  rw [Subgroup.mem_subgroupOf] at hn ⊢
  exact ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ g.2 hn.1) (Subgroup.inv_mem _ g.2),
    actsTrivM2_conj g.2 hn.2⟩

theorem isSolvable_hnKer [Finite JH] {y s : JH}
    (hord : Nat.card ↥(Subgroup.centralizer ({y} : Set JH)) ∣ 2 ^ 14 * 3 * 5 ^ 6)
    (hsC : s ∈ Subgroup.centralizer ({y} : Set JH)) (hso : orderOf s = 3)
    (hsA : ¬ ActsTrivM2 y s) : Group.IsSolvable ↥(hnKer y) := by
  have h9 : ¬ 3 ^ 2 ∣ Nat.card ↥(Subgroup.centralizer ({y} : Set JH)) := fun h => by
    have := h.trans hord
    norm_num at this
  have hsK : s ∉ hnKer y := fun h => hsA h.2
  have h3 : ¬ 3 ∣ Nat.card ↥(hnKer y) :=
    not_dvd_card_of_normal (hnKer_le y) (hnKer_normal y) h9 hsC hso hsK
  have hdvd : Nat.card ↥(hnKer y) ∣ 2 ^ 14 * 3 * 5 ^ 6 :=
    (Subgroup.card_dvd_of_le (hnKer_le y)).trans hord
  have hcop : Nat.Coprime (Nat.card ↥(hnKer y)) 3 :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 h3 |>.symm
  have e : 2 ^ 14 * 3 * 5 ^ 6 = 3 * (2 ^ 14 * 5 ^ 6) := by ring
  rw [e] at hdvd
  exact isSolvable_of_card_dvd_two_five (hcop.dvd_of_dvd_mul_left hdvd)

theorem hnMovedIn_of_data [Finite JH] {y s q : JH}
    (hord : Nat.card ↥(Subgroup.centralizer ({y} : Set JH)) ∣ 2 ^ 14 * 3 * 5 ^ 6)
    (hsC : s ∈ Subgroup.centralizer ({y} : Set JH)) (hso : orderOf s = 3)
    (hsA : ¬ ActsTrivM2 y s) (hqC : q ∈ Subgroup.centralizer ({y} : Set JH))
    (hqA : ActsTrivM2 y q) (hsq : s * q ≠ q * s) :
    HNMovedIn (Subgroup.centralizer ({y} : Set JH)) :=
  ⟨hnKer y, hnKer_le y, hnKer_normal y, isSolvable_hnKer hord hsC hso hsA, s, hsC, hso, q,
    ⟨hqC, hqA⟩, hsq⟩

end Ker

