namespace CFSG.HardMathSupport.Dickson.I271

open CFSG.Blueprint CFSG.HardMathSupport.Timmesfeld.Coordinator

theorem rkBMInv_of_reps {F : Type} [Group F] {ι : Type} (r : ι → F)
    (hcl : ∀ g : F, orderOf g = 3 → ∃ i, IsConj g (r i)) (h : ∀ i, RkBMInvAt (r i)) :
    RkBMInv F := by
  intro g hg1 hg3
  obtain ⟨i, hi⟩ := hcl g (orderOf_eq_prime hg3 hg1)
  obtain ⟨c, hc⟩ := isConj_iff.1 hi
  have := (h i).conj c⁻¹
  rwa [← hc, inv_inv, show c⁻¹ * (c * g * c⁻¹) * c = g by group] at this

section Fi22

open CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Fi22Three

theorem rkBMInv_Fi22_of_reps (h : ∀ k : Fin 4, RkBMInvAt (xRep k.val)) :
    RkBMInv NativeSporadic.Fi22 := by
  have hJ : RkBMInv CFSG.Sporadic.Fi22.J :=
    rkBMInv_of_reps (fun k : Fin 4 => xRep k.val)
      (fun g hg => by
        obtain ⟨k, hk, hc⟩ := fi22_classify g hg
        exact ⟨⟨k, hk⟩, hc⟩) h
  exact @RkBMInv.of_equiv ↥CFSG.Sporadic.Fi22.J NativeSporadic.Fi22
    (Subgroup.toGroup CFSG.Sporadic.Fi22.J) Units.instGroup CFSG.Sporadic.Fi22.fi22EquivJ.symm hJ

end Fi22

section Fi24

open CFSG.HardMathSupport.Timmesfeld.SporadicBalance

theorem rkBMInv_Fi24_of_reps (h : ∀ i : Fin 5, RkBMInvAt (Fi24Three.fi24Rep3 i)) :
    RkBMInv NativeSporadic.Fi24prime := by
  have hJ : RkBMInv CFSG.Sporadic.Fi24.J :=
    rkBMInv_of_reps Fi24Three.fi24Rep3 Fi24Sylow.fi24ThreeClasses_holds h
  exact @RkBMInv.of_equiv ↥CFSG.Sporadic.Fi24.J NativeSporadic.Fi24prime
    (Subgroup.toGroup CFSG.Sporadic.Fi24.J) Units.instGroup CFSG.Sporadic.Fi24.fi24EquivJ.symm hJ

end Fi24

