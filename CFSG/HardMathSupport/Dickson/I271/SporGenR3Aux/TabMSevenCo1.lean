section Generic

theorem natCard_centralizer_map {G G' : Type*} [Group G] [Group G'] (e : G ≃* G') (x : G) :
    Nat.card (Subgroup.centralizer ({e x} : Set G')) =
      Nat.card (Subgroup.centralizer ({x} : Set G)) := by
  refine (Nat.card_congr (Equiv.subtypeEquiv e.toEquiv fun y => ?_)).symm
  change y ∈ Subgroup.centralizer ({x} : Set G) ↔ e y ∈ Subgroup.centralizer ({e x} : Set G')
  rw [Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff, ← map_mul,
    ← map_mul, e.injective.eq_iff]

theorem natCard_centralizer_inf_map {G G' : Type*} [Group G] [Group G'] (e : G ≃* G')
    (x y : G) :
    Nat.card ↥(Subgroup.centralizer ({e x} : Set G') ⊓ Subgroup.centralizer ({e y} : Set G')) =
      Nat.card ↥(Subgroup.centralizer ({x} : Set G) ⊓ Subgroup.centralizer ({y} : Set G)) := by
  refine (Nat.card_congr (Equiv.subtypeEquiv e.toEquiv fun z => ?_)).symm
  change z ∈ Subgroup.centralizer ({x} : Set G) ⊓ Subgroup.centralizer ({y} : Set G) ↔
    e z ∈ Subgroup.centralizer ({e x} : Set G') ⊓ Subgroup.centralizer ({e y} : Set G')
  rw [Subgroup.mem_inf, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul, ← map_mul, ← map_mul,
    e.injective.eq_iff, e.injective.eq_iff]

theorem fixCount_pow_eq {g : GL (Fin 24) (ZMod 2)} (hg : orderOf g = 7) {m : ℕ} (hm : ¬ 7 ∣ m) :
    fixCount (((g ^ m : GL (Fin 24) (ZMod 2)) : Matrix (Fin 24) (Fin 24) (ZMod 2))) =
      fixCount ((g : Matrix (Fin 24) (Fin 24) (ZMod 2))) := by
  have hpow : ∀ (h : GL (Fin 24) (ZMod 2)) (n : ℕ) (w : Fin 24 → ZMod 2),
      (h : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ w = w →
        ((h ^ n : GL (Fin 24) (ZMod 2)) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *ᵥ w = w := by
    intro h n w hw
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ, Units.val_mul, ← Matrix.mulVec_mulVec, hw, ih]
  obtain ⟨m', hm'⟩ := exists_pow_eq_self_of_coprime (n := m) (x := g)
    (by rw [hg]; exact ((Nat.Prime.coprime_iff_not_dvd (by norm_num)).2 hm).symm)
  unfold fixCount
  refine Nat.card_congr (Equiv.subtypeEquivRight fun w => ⟨fun hw => ?_, hpow g m w⟩)
  have h := hpow (g ^ m) m' w hw
  rwa [hm'] at h

end Generic

