theorem orderOf_sJ : orderOf sJ = 7 := by
  rw [sJ, MulEquiv.orderOf_eq]
  exact Co1S.orderOf_sE Certificates.certificate13696

theorem orderOf_tJ : orderOf tJ = 7 := by
  rw [tJ, MulEquiv.orderOf_eq]
  exact Co1S.orderOf_tE Certificates.certificate13696

theorem exists_conj_pow_sE_or_tE (s : GA) (hs : orderOf s = 7) :
    ∃ c : GA, ∃ m : ℕ, 1 ≤ m ∧ m ≤ 6 ∧
      (c * s * c⁻¹ = Co1S.sE ^ m ∨ c * s * c⁻¹ = Co1S.tE ^ m) := by
  have hS : sylowOK Native.aR Native.bR = true := Certificates.certificate13696
  have : Finite ↥GA := Nat.finite_of_card_ne_zero (by rw [card_GA_eq]; norm_num)
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hQ : Nat.card Co1S.P0 = 7 ^ (Nat.card (⊤ : Subgroup ↥GA)).factorization 7 := by
    rw [Co1S.card_P0 hS, Subgroup.card_top, Co1S.factorization_card_GA_seven]
    norm_num
  obtain ⟨g, -, hg⟩ :=
    Co3T.exists_conj_mem_of_full (le_top : Co1S.P0 ≤ ⊤) hQ (Subgroup.mem_top s) hs
  have hy : orderOf (g⁻¹ * s * g) = 7 := by
    have := orderOf_conj_eq g⁻¹ s
    rw [inv_inv] at this
    rw [this, hs]
  rcases Co1S.mem_P0 hS hg with h1 | ⟨k, hk, b, hb, hyk⟩
  · rw [h1, orderOf_one] at hy
    exact absurd hy (by norm_num)
  · have hconj := Co1S.conj_to_target hS hk
    have hc : Co1S.cE k * (g⁻¹ * s * g) * (Co1S.cE k)⁻¹ = Co1S.tgtE k ^ (b + 1) := by
      rw [hyk]
      exact @conj_pow_of_conj ↥GA (Subgroup.toGroup GA) _ _ _ hconj _
    have e : Co1S.cE k * g⁻¹ * s * (Co1S.cE k * g⁻¹)⁻¹ = Co1S.tgtE k ^ (b + 1) := by
      rw [← hc]
      group
    refine ⟨Co1S.cE k * g⁻¹, b + 1, by omega, by omega, ?_⟩
    unfold Co1S.tgtE at e
    split_ifs at e
    · exact Or.inl e
    · exact Or.inr e

theorem exists_conj_pow_sJ_or_tJ (j : J24) (hj : orderOf j = 7) :
    ∃ c : J24, ∃ m : ℕ, 1 ≤ m ∧ m ≤ 6 ∧ (c * j * c⁻¹ = sJ ^ m ∨ c * j * c⁻¹ = tJ ^ m) := by
  obtain ⟨c, m, hm1, hm6, h⟩ :=
    exists_conj_pow_sE_or_tE (jEquivGA j) (by rw [MulEquiv.orderOf_eq]; exact hj)
  refine ⟨jEquivGA.symm c, m, hm1, hm6, ?_⟩
  have key : jEquivGA.symm c * j * (jEquivGA.symm c)⁻¹ =
      jEquivGA.symm (c * jEquivGA j * c⁻¹) := by
    rw [map_mul, map_mul, map_inv, MulEquiv.symm_apply_apply]
  rw [key]
  rcases h with h | h
  · left
    rw [h, map_pow]
    rfl
  · right
    rw [h, map_pow]
    rfl

theorem fixCount_pow_of_le_six {s : J24} (hs : orderOf s = 7) {m : ℕ} (hm1 : 1 ≤ m)
    (hm6 : m ≤ 6) :
    fixCount ((((s ^ m : J24) : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2))) =
      fixCount (((s : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2))) := by
  rw [Subgroup.coe_pow]
  exact fixCount_pow_eq (by rw [Subgroup.orderOf_coe]; exact hs) (by omega)

theorem card_centralizer_pow_of_le_six {s : J24} (hs : orderOf s = 7) {m : ℕ} (hm1 : 1 ≤ m)
    (hm6 : m ≤ 6) :
    Nat.card (Subgroup.centralizer ({s ^ m} : Set J24)) =
      Nat.card (Subgroup.centralizer ({s} : Set J24)) := by
  rw [centralizer_pow_eq_of_not_dvd (by norm_num) hs (by omega)]

