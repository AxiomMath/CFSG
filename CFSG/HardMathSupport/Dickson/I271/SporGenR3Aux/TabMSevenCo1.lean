section Bound


@[expose] def Co1SevenBound : Prop :=
  ∀ j : J24, orderOf j = 7 →
    2 * fixCount ((j : GL (Fin 24) (ZMod 2)) : Matrix (Fin 24) (Fin 24) (ZMod 2)) *
      Nat.card (Subgroup.centralizer ({j} : Set J24)) ≤ 150528


theorem co1SevenBound : Co1SevenBound := by
  intro j hj
  obtain ⟨c, m, hm1, hm6, h⟩ := exists_conj_pow_sJ_or_tJ j hj
  have hcard : Nat.card (Subgroup.centralizer ({c * j * c⁻¹} : Set J24)) =
      Nat.card (Subgroup.centralizer ({j} : Set J24)) := card_centralizer_conj c j
  have hfix : fixCount ((((c * j * c⁻¹ : J24) : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2))) =
      fixCount (((j : GL24) : Matrix (Fin 24) (Fin 24) (ZMod 2))) :=
    fixCount_conj (c : GL24) (j : GL24)
  rw [← hcard, ← hfix]
  rcases h with h | h
  · rw [h, fixCount_pow_of_le_six orderOf_sJ hm1 hm6,
      card_centralizer_pow_of_le_six orderOf_sJ hm1 hm6, card_centralizer_sJ]
    have := fixCount_sJ_le
    exact (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 2 this)).trans (by norm_num)
  · rw [h, fixCount_pow_of_le_six orderOf_tJ hm1 hm6,
      card_centralizer_pow_of_le_six orderOf_tJ hm1 hm6, card_centralizer_tJ]
    have := fixCount_tJ_le
    exact (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 2 this)).trans (by norm_num)

end Bound

