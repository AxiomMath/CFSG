section Model


theorem card_QP45_eq : Nat.card QP45.originalSubgroup = 25920 := by
  rw [card_group QP45 QP45_ok, QP45_valid.2]

theorem statedModel_QP45 : StatedClassicalModel QP45.originalSubgroup .PSp 2 3 1 :=
  ⟨⟨Nat.prime_three, le_rfl, by norm_num, by decide⟩, ZMod 3, inferInstance, inferInstance,
    by simp, ⟨psp43EquivP.symm⟩⟩

theorem isChevSimple_three_of_equiv_QP45 {T : Type} [Group T]
    (e : T ≃* ↥QP45.originalSubgroup) : IsChevSimple 3 T :=
  isChevSimple_of_psp (by norm_num)
    (CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv e.symm statedModel_QP45)

theorem isSimpleGroup_QP45 : IsSimpleGroup QP45.originalSubgroup :=
  (finite_simple_nonab_of_model statedModel_QP45 (Or.inl ⟨rfl, by norm_num⟩)).2.1

theorem nonabelian_QP45 : ∃ a b : QP45.originalSubgroup, a * b ≠ b * a :=
  (finite_simple_nonab_of_model statedModel_QP45 (Or.inl ⟨rfl, by norm_num⟩)).2.2

theorem isSimpleGroup_of_equiv_QP45 {T : Type} [Group T] (e : T ≃* ↥QP45.originalSubgroup) :
    IsSimpleGroup T :=
  haveI := isSimpleGroup_QP45
  e.isSimpleGroup_congr.2 inferInstance

theorem nonabelian_of_equiv_QP45 {T : Type} [Group T] (e : T ≃* ↥QP45.originalSubgroup) :
    ∃ a b : T, a * b ≠ b * a := by
  obtain ⟨a, b, hab⟩ := nonabelian_QP45
  exact ⟨e.symm a, e.symm b, fun h => hab (by simpa using congrArg e h)⟩

theorem leafType_three_of_equiv_QP45 {T : Type} [Group T] (e : T ≃* ↥QP45.originalSubgroup) :
    LeafType 3 T :=
  leafType_of_pow_four_dvd Nat.prime_three (isChevSimple_three_of_equiv_QP45 e)
    (by rw [Nat.card_congr e.toEquiv, card_QP45_eq]; norm_num)

theorem three_dvd_card_of_equiv_QP45 {T : Type} [Group T] (e : T ≃* ↥QP45.originalSubgroup) :
    3 ∣ Nat.card T := by
  rw [Nat.card_congr e.toEquiv, card_QP45_eq]
  norm_num

end Model

section Recognition


theorem u42Words_x45_y45 :
    ∀ w ∈ u42Words, evalW (![x45, y45] : Fin 2 → Equiv.Perm (Fin 45)) w = 1 := by
  decide +kernel

theorem closure_range_x45_y45 :
    closure (Set.range (![x45, y45] : Fin 2 → Equiv.Perm (Fin 45))) = QP45.originalSubgroup := by
  rw [QP45_closure]
  congr 1
  ext g
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

theorem nonempty_mulEquiv_QP45_of_rels {G : Type} [Group G] (g : Fin 2 → G)
    (hrels : ∀ w ∈ u42Words, evalW g w = 1)
    (hcard : Nat.card ↥(closure (Set.range g)) = 25920) :
    Nonempty (↥(closure (Set.range g)) ≃* ↥QP45.originalSubgroup) := by
  obtain ⟨hfin, hP⟩ := Certificates.certificate17350
  have hN₂ : 25920 ≤ Nat.card ↥(closure (Set.range (![x45, y45] :
      Fin 2 → Equiv.Perm (Fin 45)))) := by
    rw [closure_range_x45_y45, card_QP45_eq]
  obtain ⟨e⟩ := CFSG.AGLEmbeddingD2.Wilson.Census228Spor.nonempty_mulEquiv_of_presented g
    (![x45, y45] : Fin 2 → Equiv.Perm (Fin 45)) u42Words hrels u42Words_x45_y45 hfin 25920
    (by omega) hcard.ge hN₂
  exact ⟨e.trans (MulEquiv.subgroupCongr closure_range_x45_y45)⟩

end Recognition

