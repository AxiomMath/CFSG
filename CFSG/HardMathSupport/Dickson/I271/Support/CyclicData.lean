namespace CFSG.HardMathSupport.Dickson.I271

open CFSG.Open

@[expose] def LieCharOf (p : ℕ) (S : Type) [Group S] : Prop :=
  ∃ idx : TauCeti.ValidLieTypeIndex, Nonempty (S ≃* (TauCeti.CFSGIndex.lie idx).Group) ∧
    idx.1.characteristic = p

@[expose] def KDRankOne : Prop :=
  ∀ (p : ℕ), p.Prime → p ≠ 2 → ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S →
    (∃ a b : S, a * b ≠ b * a) → LieCharOf p S → CFSG.Open.pRank p (⊤ : Subgroup S) ≤ 1 →
      5 ≤ p ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = p ∧
        Nonempty (S ≃* StatedProj (StatedSL 2 F))

@[expose] def KDCenterCase : Prop :=
  ∀ (p : ℕ), p.Prime → p ≠ 2 → ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K →
    LieCharOf p (K ⧸ Subgroup.center K) → IsPGroup p (Subgroup.center K) →
      Subgroup.center K ≠ ⊥ → ∀ k : K, k ∉ Subgroup.center K → k ^ p ∈ Subgroup.center K →
        ∃ x : K, x ^ p = 1 ∧ x * k = k * x ∧ x ∉ Subgroup.zpowers k ⊔ Subgroup.center K

section Bridge

variable {X : Type} [Group X]

theorem le_centralizer_of_trivial_aut [Finite X] {p : ℕ} {K S : Subgroup X} {b₀ k : X}
    (hSN : S ≤ Subgroup.normalizer (K : Set X)) (hb₀N : b₀ ∈ Subgroup.normalizer (K : Set X))
    (hk : k ∈ K) (hact : ∀ x ∈ K, b₀ * x * b₀⁻¹ = k * x * k⁻¹)
    (hb₀S : b₀ ∈ Subgroup.normalizer (S : Set X)) (hcop : Nat.Coprime p (Nat.card S))
    (hHH : ∀ T : Subgroup (MulAut ↥K), Nat.Coprime p (Nat.card T) →
      MulAut.conj (⟨k, hk⟩ : ↥K) ∈ Subgroup.normalizer (T : Set (MulAut ↥K)) → T = ⊥) :
    S ≤ Subgroup.centralizer (K : Set X) := by
  classical
  set ψ : ↥S →* MulAut ↥K := K.normalizerMonoidHom.comp (Subgroup.inclusion hSN) with hψ
  set T : Subgroup (MulAut ↥K) := ψ.range with hT
  have hTcard : Nat.card T ∣ Nat.card S :=
    Subgroup.card_dvd_of_surjective ψ.rangeRestrict_surjective
  have hTcop : Nat.Coprime p (Nat.card T) := Nat.Coprime.coprime_dvd_right hTcard hcop
  have hconj : MulAut.conj (⟨k, hk⟩ : ↥K) = K.normalizerMonoidHom ⟨b₀, hb₀N⟩ := by
    ext x
    rw [MulAut.conj_apply]
    show k * (x : X) * k⁻¹ = b₀ * (x : X) * b₀⁻¹
    exact (hact x x.2).symm
  have hmapped : ∀ (s : ↥S) (c : X) (hcS : c ∈ Subgroup.normalizer (S : Set X))
      (hcK : c ∈ Subgroup.normalizer (K : Set X)),
      K.normalizerMonoidHom ⟨c, hcK⟩ * ψ s * (K.normalizerMonoidHom ⟨c, hcK⟩)⁻¹ ∈ T := by
    intro s c hcS hcK
    have hcs : c * (s : X) * c⁻¹ ∈ S := (Subgroup.mem_normalizer_iff.1 hcS (s : X)).1 s.2
    refine ⟨⟨c * (s : X) * c⁻¹, hcs⟩, ?_⟩
    have h1 : ψ ⟨c * (s : X) * c⁻¹, hcs⟩ = K.normalizerMonoidHom
        ((⟨c, hcK⟩ : ↥(Subgroup.normalizer (K : Set X))) *
          (⟨(s : X), hSN s.2⟩ : ↥(Subgroup.normalizer (K : Set X))) *
          (⟨c, hcK⟩ : ↥(Subgroup.normalizer (K : Set X)))⁻¹) := rfl
    rw [h1, map_mul, map_mul, map_inv]
    rfl
  have hnorm : MulAut.conj (⟨k, hk⟩ : ↥K) ∈ Subgroup.normalizer (T : Set (MulAut ↥K)) := by
    rw [Subgroup.mem_normalizer_iff]
    intro t
    rw [hconj]
    constructor
    · rintro ⟨s, rfl⟩
      exact hmapped s b₀ hb₀S hb₀N
    · intro ht
      obtain ⟨s', hs'⟩ : ∃ s' : ↥S, ψ s' = K.normalizerMonoidHom ⟨b₀, hb₀N⟩ * t *
          (K.normalizerMonoidHom ⟨b₀, hb₀N⟩)⁻¹ := ht
      have hb₀S' : b₀⁻¹ ∈ Subgroup.normalizer (S : Set X) := inv_mem hb₀S
      have hb₀N' : b₀⁻¹ ∈ Subgroup.normalizer (K : Set X) := inv_mem hb₀N
      have h2 := hmapped s' b₀⁻¹ hb₀S' hb₀N'
      have h3 : K.normalizerMonoidHom ⟨b₀⁻¹, hb₀N'⟩ = (K.normalizerMonoidHom ⟨b₀, hb₀N⟩)⁻¹ := by
        rw [← map_inv]; rfl
      rw [h3, hs'] at h2
      simpa [mul_assoc] using h2
  have hTbot := hHH T hTcop hnorm
  intro s hs
  have hs1 : ψ ⟨s, hs⟩ = 1 := by
    have : ψ ⟨s, hs⟩ ∈ T := ⟨⟨s, hs⟩, rfl⟩
    rw [hTbot, Subgroup.mem_bot] at this
    exact this
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  have h1 := congrArg (fun e : MulAut ↥K => (e ⟨x, hx⟩ : X)) hs1
  simp only [hψ, MonoidHom.comp_apply, MulAut.one_apply] at h1
  have h2 : s * x * s⁻¹ = x := h1
  calc x * s = (s * x * s⁻¹) * s := by rw [h2]
    _ = s * x := by group

end Bridge

