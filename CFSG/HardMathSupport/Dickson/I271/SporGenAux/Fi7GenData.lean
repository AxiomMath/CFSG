@[expose] def fi7Extra (_ : Unit := ()) : Array (List Int) := parseIntLists fi7ExtraStr

@[expose] def lt2w (l : Nat) : Int :=
  if l % 2 = 0 then ((l / 2 + 3 : Nat) : Int) else -((l / 2 + 3 : Nat) : Int)

@[expose] def isGen7 (k : Nat) : Bool :=
  k == 1085 || k == 1086 || k == 1089 || k == 1090 || k == 1091 || k == 1092

@[expose] def mGen (z : Int) : Array W :=
  if z = 1 ∨ z = -1 then matA () else if z = 2 then matB () else powW 781 (matB ()) 2

@[expose] def mLetter (L : Array (Array W)) (z : Int) : Array W :=
  if z.natAbs ≤ 2 then mGen z
  else if 0 < z then L[2 * (z.natAbs - 3)]! else L[2 * (z.natAbs - 3) + 1]!

@[expose] def mProd (f : Int → Array W) : List Int → Array W
  | [] => idW 781
  | l :: ls => ls.foldl (fun acc z => mulW acc (f z)) (f l)

@[expose] def mWord (L : Array (Array W)) (w : List Int) : Array W := mProd (mLetter L) w

@[expose] def mWordInv (L : Array (Array W)) (w : List Int) : Array W :=
  mProd (fun z => mLetter L (-z)) w.reverse

@[expose] def mLetters (words : Array (List Int)) : Array (Array W) :=
  words.foldl (fun L w => (L.push (mWord L w)).push (mWordInv L w)) #[]

@[expose] def fi7OK (_ : Unit := ()) : Bool :=
  let D := fi24SevenData
  let E := fi7Extra ()
  let Ws := D.words ++ E
  let L := mLetters Ws
  slpOK Ws && decide (D.words.size = 1087) && decide (E.size = 119) &&
    (D.words[0]! == [1]) && (D.words[1]! == [2]) &&
    (D.conj[91]!.1 == 1) && (D.conj[77]!.1 == 1) &&
    (E[0]! == D.conj[91]!.2.map lt2w) && (E[1]! == D.conj[77]!.2.map lt2w) &&
    (E[2]! == [-1090, 1088, 1090]) && (E[3]! == [-1090, 1089, 1090]) &&
    (E[4]! == [-1091, 1088, 1091]) && (E[5]! == [-1091, 1089, 1091]) &&
    ((List.range 112).all fun r => (Ws[1093 + r]!).all fun z =>
      decide (3 ≤ z.natAbs) && (isGen7 (z.natAbs - 3) ||
        (decide (1093 ≤ z.natAbs - 3) && decide (z.natAbs - 3 < 1093 + r)))) &&
    (E[118]! == [1087, 1085, 1086, 1086]) &&
    eqRows 781 L[2 * 1203]! L[0]! && eqRows 781 L[2 * 1204]! L[2]! &&
    eqRows 781 (mulW L[2 * 1085]! L[2 * 67]!) (mulW L[2 * 67]! L[2 * 1085]!) &&
    eqRows 781 (mulW L[2 * 1086]! L[2 * 67]!) (mulW L[2 * 67]! L[2 * 1086]!) &&
    eqRows 781 (mulW L[2 * 1082]! L[2 * 66]!) (mulW L[2 * 66]! L[2 * 1082]!) &&
    eqRows 781 (mulW L[2 * 1083]! L[2 * 66]!) (mulW L[2 * 66]! L[2 * 1083]!) &&
    eqRows 781 (mulW L[2 * 1084]! L[2 * 66]!) (mulW L[2 * 66]! L[2 * 1084]!) &&
    eqRows 781 (powW 781 L[2 * 1205]! 4) (idW 781) &&
    !eqRows 781 (powW 781 L[2 * 1205]! 2) (idW 781)

