local notation "z7" => x7 * y7 ^ 6

theorem th7_list :
    (∀ i < 1176, rowsMatrix (wordRowsL regs7 list7.words[i]!) =
      matJ ((list7.words[i]!.map R7).prod)) ∧
    (∀ i < 1176, (list7.words[i]!.map R7).prod ∈ Subgroup.centralizer ({z7} : Set J)) ∧
    (∀ c ∈ Subgroup.centralizer ({z7} : Set J), ∃ i < 1176, (list7.words[i]!.map R7).prod = c) ∧
    Nat.card (Subgroup.centralizer ({z7} : Set J)) = 1176 ∧
    (∀ i < 1176, ∀ r ∈ list7.words[i]!, r < (regs7).size) ∧ list7.words.size = 1176 := by
  obtain ⟨hcomp, hcard⟩ := thSeven_complete
  have hlt : ∀ i < 1176, ∀ r ∈ list7.words[i]!, r < (regs7).size := by
    intro i hi r hr
    rw [rowsMatrix_regs7.1]
    exact CFSG.HardMathSupport.Timmesfeld.SporadicBalance.ThList.words7_lt i hi r hr
  exact ⟨fun i hi => rowsMatrix_wordRowsL fun r hr => hR7 r (hlt i hi r hr), thSeven_mem, hcomp,
    hcard, hlt, CFSG.HardMathSupport.Timmesfeld.SporadicBalance.ThList.words7_size⟩

theorem th7_rank :
    (∃ c ∈ Subgroup.centralizer ({z7} : Set J), orderOf c = 4) ∧
    (∀ u ∈ Subgroup.centralizer ({z7} : Set J), u * y7 = y7 * u → u ^ 7 = 1) := by
  obtain ⟨hcomp, -⟩ := thSeven_complete
  obtain ⟨⟨i, hi, hord⟩, hall⟩ := Certificates.certificate17303
  refine ⟨⟨_, thSeven_mem i hi, hord⟩, fun u hu huy => ?_⟩
  obtain ⟨j, hj, rfl⟩ := hcomp u hu
  exact hall j hj huy

theorem th7_nonabelian : ∃ a b : ↥J, a * b ≠ b * a := by
  obtain ⟨-, -, -, hcard, -⟩ := th7_list
  by_contra hcon
  push Not at hcon
  have hall : Subgroup.centralizer ({z7} : Set ↥J) = ⊤ :=
    eq_top_iff.2 fun c _ => Subgroup.mem_centralizer_singleton_iff.2 (hcon c z7)
  have := th_finite
  rw [hall, Subgroup.card_top, CFSG.Sporadic.Th.Max3.natCard_J] at hcard
  norm_num at hcard

theorem th7_conj (s : ↥J) (hs : orderOf s = 7) : ∃ c : ↥J, c * s * c⁻¹ = z7 := by
  obtain ⟨h7x, h7y, hcomm, hx1, hpow⟩ := thSeven_pair
  have : Finite J := th_finite
  have : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  refine exists_conj_of_pair (z := z7) (matJ_injective ?_) h7x h7y hx1 hpow ?_
    (fun i j hi hj hij => ?_) s hs
  · simp only [matJ_mul]
    exact hcomm
  · rw [CFSG.Sporadic.Th.Max3.natCard_J,
      show (90745943887872000 : ℕ) = 7 ^ 2 * 1851958038528000 by norm_num,
      Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
      Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
      Nat.factorization_eq_zero_of_not_dvd (by norm_num)]
  · obtain ⟨m, hm⟩ := thSeven_conj hi hj hij
    refine ⟨m, matJ_injective ?_⟩
    simp only [matJ_mul, matJ_pow] at hm ⊢
    exact hm

theorem th7_card_Q :
    Nat.card (Subgroup.closure ({x7, y7} : Set ↥J)) =
      7 ^ (Nat.card (⊤ : Subgroup ↥J)).factorization 7 := by
  obtain ⟨h7x, h7y, hcomm, hx1, hpow⟩ := thSeven_pair
  have : Finite J := th_finite
  have : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  refine card_closure_pair (matJ_injective ?_) h7x h7y hx1 hpow ?_
  · simp only [matJ_mul]
    exact hcomm
  · rw [CFSG.Sporadic.Th.Max3.natCard_J,
      show (90745943887872000 : ℕ) = 7 ^ 2 * 1851958038528000 by norm_num,
      Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
      Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
      Nat.factorization_eq_zero_of_not_dvd (by norm_num)]

theorem th7_card_Q_eq : Nat.card (Subgroup.closure ({x7, y7} : Set ↥J)) = 49 := by
  have := th7_card_Q
  have hf : (Nat.card (⊤ : Subgroup ↥J)).factorization 7 = 2 := by
    rw [Subgroup.card_top, CFSG.Sporadic.Th.Max3.natCard_J,
      show (90745943887872000 : ℕ) = 7 ^ 2 * 1851958038528000 by norm_num,
      Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
      Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
      Nat.factorization_eq_zero_of_not_dvd (by norm_num)]
  rw [hf] at this
  rw [this]; norm_num

theorem th7_sylow : ∃ S : Sylow 7 ↥JT,
    (S : Subgroup ↥JT) = (Subgroup.closure ({x7, y7} : Set ↥J)).subgroupOf JT := by
  have : Finite ↥J := th_finite
  have : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  have hQ : Nat.card (Subgroup.closure ({x7, y7} : Set ↥J)) =
      7 ^ (Nat.card ↥JT).factorization 7 := by
    rw [th_card_JT, ← Subgroup.card_top (G := ↥J)]
    exact th7_card_Q
  have hle : Subgroup.closure ({x7, y7} : Set ↥J) ≤ JT := by rw [JT_eq_top]; exact le_top
  exact ⟨Sylow.ofCard ((Subgroup.closure ({x7, y7} : Set ↥J)).subgroupOf JT)
    (by rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]; exact hQ), rfl⟩

theorem th7_pfree (E : Subgroup ↥J) (hE : Nat.card E = 7 ^ 2)
    (hEQ : E ≤ Subgroup.closure ({x7, y7} : Set ↥J)) :
    PFree 7 (JT ⊓ Subgroup.centralizer (E : Set ↥J) : Subgroup ↥J) := by
  have hQ := th7_card_Q_eq
  have hEQ' : E = Subgroup.closure ({x7, y7} : Set ↥J) :=
    Subgroup.eq_of_le_of_card_ge hEQ (by rw [hQ, hE]; norm_num)
  subst hEQ'
  obtain ⟨-, hcent⟩ := th7_rank
  generalize R7 24 = x at *
  generalize R7 25 = y at *
  intro u hu hcop
  have hyQ : y ∈ Subgroup.closure ({x, y} : Set ↥J) := Subgroup.subset_closure (by simp)
  have hxQ : x ∈ Subgroup.closure ({x, y} : Set ↥J) := Subgroup.subset_closure (by simp)
  have hzQ : x * y ^ 6 ∈ Subgroup.closure ({x, y} : Set ↥J) :=
    Subgroup.mul_mem _ hxQ (Subgroup.pow_mem _ hyQ 6)
  have huz : u ∈ Subgroup.centralizer ({x * y ^ 6} : Set ↥J) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (Subgroup.mem_centralizer_iff.1 hu.2 _ hzQ).symm
  have huy : u * y = y * u := (Subgroup.mem_centralizer_iff.1 hu.2 y hyQ).symm
  have hu7 : u ^ 7 = 1 := hcent u huz huy
  exact orderOf_eq_one_iff.1 (Nat.Coprime.eq_one_of_dvd hcop (orderOf_dvd_of_pow_eq_one hu7))

theorem th7_rankOK (s : ↥J) (hs : orderOf s = 7) :
    RankOK 7 (JT ⊓ Subgroup.centralizer ({s} : Set ↥J) : Subgroup ↥J) := by
  obtain ⟨c, hc⟩ := th7_conj s hs
  obtain ⟨hwit, -⟩ := th7_rank
  obtain ⟨-, -, -, hcard, -⟩ := th7_list
  have hz : RankOK 7 (JT ⊓ Subgroup.centralizer ({z7} : Set ↥J) : Subgroup ↥J) := by
    rw [JT_eq_top, top_inf_eq]
    have : Finite ↥J := th_finite
    exact rankOK_of_two_witness hcard primePowTwo_seven_1176 hwit
  exact rankOK_inf_centralizer_of_conj JT (mem_JT c) hc hz

theorem th7_noSig :
    PlaneNoSig 7 ↥JT := by
  have : Finite ↥J := th_finite
  exact noSig_planes_of_autModel_rank (th_autModel_JT th7_nonabelian) (Nat.le_mul_of_pos_left _ (by norm_num))
    (by norm_num) (by norm_num) (Q := Subgroup.closure ({x7, y7} : Set ↥J)) th7_sylow
    (fun E hEQ _ hE => th7_pfree E hE hEQ) (fun y _ hy => th7_rankOK y hy)

