section Final

@[irreducible] noncomputable def GT : Subgroup ↥GA := ⊤

theorem GT_eq_top : GT = ⊤ := by unfold GT; rfl

theorem mem_GT (g : ↥GA) : g ∈ GT := by rw [GT_eq_top]; exact Subgroup.mem_top g

noncomputable def eGT : ↥GA ≃* ↥GT where
  toFun g := ⟨g, mem_GT g⟩
  invFun x := x.1
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

theorem co1_center_GT (hc : Subgroup.center ↥GA = ⊥) : Subgroup.center ↥GT = ⊥ := by
  rw [eq_bot_iff]
  intro z hz
  rw [Subgroup.mem_bot]
  have : z.1 ∈ Subgroup.center ↥GA := by
    rw [Subgroup.mem_center_iff]
    intro g
    have h := congrArg Subtype.val (Subgroup.mem_center_iff.1 hz ⟨g, mem_GT g⟩)
    rw [Subgroup.coe_mul, Subgroup.coe_mul] at h
    exact h
  rw [hc, Subgroup.mem_bot] at this
  exact Subtype.ext this

theorem co1_autModel_GT
    (hAut : ∀ α : MulAut CFSG.Blueprint.NativeSporadic.Co1,
      ∃ g : CFSG.Blueprint.NativeSporadic.Co1, α = MulAut.conj g) : AutModel GT GT := by
  have hall : AllInner ↥GA :=
    @AllInner.of_mulEquiv CFSG.Blueprint.NativeSporadic.Co1 ↥GA _ (Subgroup.toGroup GA)
      co1MatEquiv hAut
  have hall' : AllInner ↥GT :=
    @AllInner.of_mulEquiv ↥GA ↥GT (Subgroup.toGroup GA) (Subgroup.toGroup GT) eGT hall
  exact CFSG.RankThree.PartOne.autModel_self_of_allInner (co1_center_GT co1_center_GA) hall'

theorem co1_card_GT : Nat.card GT = Nat.card ↥GA := by rw [GT_eq_top, Subgroup.card_top]

theorem co1_sylow_GT (hS : sylowOK Native.aR Native.bR = true) :
    ∃ S : Sylow 7 ↥GT, (S : Subgroup ↥GT) = P0.subgroupOf GT := by
  have : Finite ↥GA := finite_GA
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hQ : Nat.card P0 = 7 ^ (Nat.card GT).factorization 7 := by
    rw [card_P0 hS, co1_card_GT, factorization_card_GA_seven]
    norm_num
  have hle : P0 ≤ GT := by rw [GT_eq_top]; exact le_top
  exact ⟨Sylow.ofCard (P0.subgroupOf GT)
    (by rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]; exact hQ), rfl⟩

theorem co1_pfree_GT (hS : sylowOK Native.aR Native.bR = true)
    (E : Subgroup ↥GA) (hE : Nat.card E = 7 ^ 2) :
    PFree 7 (GT ⊓ Subgroup.centralizer (E : Set ↥GA) : Subgroup ↥GA) := by
  have hE49 : Nat.card E = 49 := by rw [hE]; norm_num
  rw [GT_eq_top, top_inf_eq]
  exact PFree.of_isPGroup
    (isPGroup_centralizer_GA hS Certificates.certificate13697.2.2.2.2.1 E hE49)

theorem co1_rankOK_GT (hS : sylowOK Native.aR Native.bR = true)
    (hF : co1SevenOrderFourOK Native.aR Native.bR = true) (y : ↥GA) (hy : orderOf y = 7) :
    RankOK 7 (GT ⊓ Subgroup.centralizer ({y} : Set ↥GA) : Subgroup ↥GA) := by
  rw [GT_eq_top]
  exact co1_rankOK_all hS hF y hy

theorem co1Seven_noSig
    (hAut : ∀ α : MulAut CFSG.Blueprint.NativeSporadic.Co1,
      ∃ g : CFSG.Blueprint.NativeSporadic.Co1, α = MulAut.conj g) :
    PlaneNoSig 7 ↥GT := by
  have : Finite ↥GA := finite_GA
  have hS : sylowOK Native.aR Native.bR = true := Certificates.certificate13696
  have hF : co1SevenOrderFourOK Native.aR Native.bR = true := Certificates.certificate17302
  exact noSig_planes_of_autModel_rank (co1_autModel_GT hAut)
    (Nat.le_mul_of_pos_left _ (by norm_num)) (by norm_num) (by norm_num) (Q := P0)
    (co1_sylow_GT hS) (fun E _ _ hE => co1_pfree_GT hS E hE)
    (fun y _ hy => co1_rankOK_GT hS hF y hy)

