theorem orderOf_eq_four_of_mrep {m : Rows} {c : ↥GA} (hm : MRep m (c : GL24))
    (h : CFSG.HardMathSupport.Dickson.I271.rowsOrderFour m = true) : orderOf c = 4 := by
  simp only [rowsOrderFour, Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq] at h
  obtain ⟨⟨hv, h4⟩, h2⟩ := h
  have e4 : c ^ 4 = 1 := by
    apply Subtype.ext
    rw [Subgroup.coe_pow, Subgroup.coe_one]
    have := hm.pow 4
    rw [h4] at this
    exact this.eq MRep.one
  have e2 : c ^ 2 ≠ 1 := by
    intro hc2
    apply h2
    have h := hm.pow 2
    have hc2' : (c : GL24) ^ 2 = 1 := by
      have := congrArg Subtype.val hc2
      rwa [Subgroup.coe_pow, Subgroup.coe_one] at this
    rw [hc2'] at h
    exact rows_eq_of_mrep (validRows_pow hv 2) validRows_one h MRep.one
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  simpa using orderOf_eq_prime_pow (p := 2) (n := 1) (by simpa using e2) (by simpa using e4)

section Cen

theorem finite_GA : Finite ↥GA := Nat.finite_of_card_ne_zero (by rw [card_GA_eq]; norm_num)

theorem co1_cenA :
    Nat.card (Cen sE) = 17640 ∧ gE 68 ∈ Cen sE ∧ gE 69 ∈ Cen sE :=
  ⟨Certificates.certificate13697.1, Certificates.certificate13697.2.1,
    Certificates.certificate13697.2.2.1⟩

theorem co1_cenB :
    Nat.card (Cen tE) = 1176 ∧ gE 70 ∈ Cen tE :=
  ⟨Certificates.certificate13698.1, Certificates.certificate13698.2.1⟩

theorem co1_four
    (hS : sylowOK Native.aR Native.bR = true)
    (hF : co1SevenOrderFourOK Native.aR Native.bR = true) :
    (∃ c ∈ Cen sE, orderOf c = 4) ∧ (∃ c ∈ Cen tE, orderOf c = 4) := by
  have hflag := (sylowOK_parts hS).1
  obtain ⟨-, h68, h69⟩ := co1_cenA
  obtain ⟨-, h70⟩ := co1_cenB
  simp only [co1SevenOrderFourOK, Bool.and_eq_true] at hF
  obtain ⟨hF1, hF2⟩ := hF
  refine ⟨⟨gE 68 ^ 3 * gE 69, (Cen sE).mul_mem ((Cen sE).pow_mem h68 3) h69, ?_⟩,
    ⟨gE 70 ^ 7, (Cen tE).pow_mem h70 7, ?_⟩⟩
  · refine orderOf_eq_four_of_mrep ?_ hF1
    rw [Subgroup.coe_mul, Subgroup.coe_pow]
    exact ((rep_gE hflag 68).pow 3).mul (rep_gE hflag 69)
  · refine orderOf_eq_four_of_mrep ?_ hF2
    rw [Subgroup.coe_pow]
    exact (rep_gE hflag 70).pow 7

theorem co1_rankOK_cen
    (hS : sylowOK Native.aR Native.bR = true)
    (hF : co1SevenOrderFourOK Native.aR Native.bR = true) :
    RankOK 7 (Cen sE) ∧ RankOK 7 (Cen tE) := by
  have : Finite ↥GA := finite_GA
  obtain ⟨hwA, hwB⟩ := co1_four hS hF
  exact ⟨rankOK_of_two_witness co1_cenA.1 primePowTwo_seven_17640 hwA,
    rankOK_of_two_witness co1_cenB.1 primePowTwo_seven_1176 hwB⟩

theorem co1_rankOK_all
    (hS : sylowOK Native.aR Native.bR = true)
    (hF : co1SevenOrderFourOK Native.aR Native.bR = true) (s : ↥GA) (hs : orderOf s = 7) :
    RankOK 7 (⊤ ⊓ Subgroup.centralizer ({s} : Set ↥GA)) := by
  have : Finite ↥GA := finite_GA
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  obtain ⟨hAr, hBr⟩ := co1_rankOK_cen hS hF
  have hQ : Nat.card P0 = 7 ^ (Nat.card (⊤ : Subgroup ↥GA)).factorization 7 := by
    rw [card_P0 hS, Subgroup.card_top, factorization_card_GA_seven]
    norm_num
  obtain ⟨g, -, hg⟩ := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T.exists_conj_mem_of_full (le_top : P0 ≤ ⊤) hQ (Subgroup.mem_top s) hs
  have hy : orderOf (g⁻¹ * s * g) = 7 := by
    have := orderOf_conj_eq g⁻¹ s
    rw [inv_inv] at this
    rw [this, hs]
  have key : RankOK 7 (⊤ ⊓ Subgroup.centralizer ({g⁻¹ * s * g} : Set ↥GA)) := by
    rcases mem_P0 hS hg with h1 | ⟨k, hk, b, hb, hyk⟩
    · rw [h1, orderOf_one] at hy
      exact absurd hy (by norm_num)
    · have hconj := conj_to_target hS hk
      have hc : cE k * (g⁻¹ * s * g) * (cE k)⁻¹ = tgtE k ^ (b + 1) := by
        rw [hyk]
        exact @conj_pow_of_conj ↥GA (Subgroup.toGroup GA) _ _ _ hconj _
      have hC : Subgroup.centralizer ({tgtE k ^ (b + 1)} : Set ↥GA) =
          Subgroup.centralizer ({tgtE k} : Set ↥GA) :=
        @centralizer_pow_eq_of_not_dvd 7 ↥GA (Subgroup.toGroup GA) _ (by norm_num)
          (orderOf_tgtE hS k) _ (by omega)
      refine rankOK_inf_centralizer_of_conj ⊤ (Subgroup.mem_top (cE k)) hc ?_
      rw [hC]
      unfold tgtE
      split_ifs
      · rwa [top_inf_eq]
      · rwa [top_inf_eq]
  exact rankOK_inf_centralizer_of_conj ⊤ (Subgroup.mem_top g⁻¹) (by group) key

theorem co1_nonabelian :
    ∃ a b : ↥GA, a * b ≠ b * a := by
  by_contra hcon
  push Not at hcon
  have hall : Cen sE = ⊤ := eq_top_iff.2 fun c _ => mem_Cen.2 (hcon c sE)
  have h1 := co1_cenA.1
  rw [hall, Subgroup.card_top, card_GA_eq] at h1
  norm_num at h1

theorem co1_isSimple : IsSimpleGroup ↥GA :=
  @MulEquiv.isSimpleGroup ↥GA (Subgroup.toGroup GA) CFSG.Blueprint.NativeSporadic.Co1 _
    CFSG.Sporadic.Co1.isSimpleGroup_Co1 co1MatEquiv.symm

theorem co1_center_GA :
    Subgroup.center ↥GA = ⊥ := by
  have : Finite ↥GA := finite_GA
  have hs := co1_isSimple
  rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal ↥GA (Subgroup.toGroup GA) hs
    (Subgroup.center ↥GA) inferInstance with h | h
  · exact h
  · exfalso
    obtain ⟨a, b, hab⟩ := co1_nonabelian
    have ha : a ∈ Subgroup.center ↥GA := h ▸ Subgroup.mem_top a
    exact hab ((Subgroup.mem_center_iff.1 ha b).symm)

