local notation "regs5" => slpRows (rowsOf seedA) (rowsOf seedB) 118 prog5

local notation "R5" => slpJ a b prog5

local notation "x5" => R5 94

local notation "y5" => R5 105

local notation "c5" => R5 94 * R5 105 * R5 94 ^ 4 * R5 105 ^ 4

local notation "C5" =>
  mulRows (mulRows (mulRows regs5[94]! regs5[105]!) (powRowsN regs5[94]! 4))
    (powRowsN regs5[105]! 4)

theorem th5_list :
    (∀ i < 3000, rowsMatrix (wordRowsL regs5 list5.words[i]!) =
      matJ ((list5.words[i]!.map R5).prod)) ∧
    (∀ i < 3000, (list5.words[i]!.map R5).prod ∈ Subgroup.centralizer ({c5} : Set J)) ∧
    (∀ g ∈ Subgroup.centralizer ({c5} : Set J), ∃ i < 3000, (list5.words[i]!.map R5).prod = g) ∧
    Nat.card (Subgroup.centralizer ({c5} : Set J)) = 3000 ∧
    (∀ i < 3000, ∀ r ∈ list5.words[i]!, r < (regs5).size) ∧ list5.words.size = 3000 := by
  obtain ⟨hcomp, hcard⟩ := thFive_complete
  have hlt : ∀ i < 3000, ∀ r ∈ list5.words[i]!, r < (regs5).size := by
    intro i hi r hr
    rw [rowsMatrix_regs5.1]
    exact CFSG.HardMathSupport.Timmesfeld.SporadicBalance.ThList.words5_lt i hi r hr
  exact ⟨fun i hi => rowsMatrix_wordRowsL fun r hr => hR5 r (hlt i hi r hr), thFive_mem, hcomp,
    hcard, hlt, CFSG.HardMathSupport.Timmesfeld.SporadicBalance.ThList.words5_size⟩

theorem th5_nonabelian : ∃ a b : ↥J, a * b ≠ b * a := by
  obtain ⟨-, -, -, hcard, -⟩ := th5_list
  by_contra hcon
  push_neg at hcon
  have hall : Subgroup.centralizer ({c5} : Set ↥J) = ⊤ :=
    eq_top_iff.2 fun g _ => Subgroup.mem_centralizer_singleton_iff.2 (hcon g c5)
  have := th_finite
  rw [hall, Subgroup.card_top, CFSG.Sporadic.Th.Max3.natCard_J] at hcard
  norm_num at hcard

theorem th5_cube :
    Nat.card (Subgroup.closure ({x5, y5} : Set ↥J)) = 5 ^ 3 ∧
    Nat.card (Subgroup.closure ({x5, y5} : Set ↥J)) =
      5 ^ (Nat.card (⊤ : Subgroup ↥J)).factorization 5 ∧
    c5 ≠ 1 ∧ c5 ^ 5 = 1 ∧ c5 ∈ Subgroup.closure ({x5, y5} : Set ↥J) ∧
    (∀ q ∈ Subgroup.closure ({x5, y5} : Set ↥J), q ^ 5 = 1) ∧
    (∀ s : ↥J, orderOf s = 5 → ∃ m : ↥J, m * s * m⁻¹ = c5) ∧
    c5 * x5 = x5 * c5 ∧ c5 * y5 = y5 * c5 := by
  have : Finite J := th_finite
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hfac : (Nat.card ↥J).factorization 5 = 3 := by
    rw [CFSG.Sporadic.Th.Max3.natCard_J,
      show (90745943887872000 : ℕ) = 5 ^ 3 * 725967551102976 by norm_num,
      Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
      Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
      Nat.factorization_eq_zero_of_not_dvd (by norm_num)]
  have hcx' : c5 * x5 = x5 * c5 := thFive_facts.cx
  have hcy' : c5 * y5 = y5 * c5 := thFive_facts.cy
  have hc : c5 = x5 * y5 * x5 ^ (5 - 1) * y5 ^ (5 - 1) := rfl
  obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := cube_facts (c := c5) thFive_facts.x_pow
    thFive_facts.y_pow hc hcx' hcy' thFive_facts.inj hfac thFive_facts.conj
  exact ⟨h1, h2, h3, h4, h5, h6, h7, hcx', hcy'⟩

theorem th5_rankOK (s : ↥J) (hs : orderOf s = 5) :
    RankOK 5 (JT ⊓ Subgroup.centralizer ({s} : Set J) : Subgroup ↥J) := by
  obtain ⟨-, -, -, -, -, -, hconj, -, -⟩ := th5_cube
  obtain ⟨m, hm⟩ := hconj s hs
  obtain ⟨-, -, -, hcard, -⟩ := th5_list
  have hz : RankOK 5 (JT ⊓ Subgroup.centralizer ({c5} : Set ↥J) : Subgroup ↥J) := by
    rw [JT_eq_top, top_inf_eq]
    have : Finite ↥J := th_finite
    exact rankOK_of_primePowOK (by rw [hcard]; exact primePowOK_five_3000)
  exact rankOK_inf_centralizer_of_conj JT (mem_JT m) hm hz

theorem th5_sylow : ∃ S : Sylow 5 ↥JT,
    (S : Subgroup ↥JT) = (Subgroup.closure ({x5, y5} : Set ↥J)).subgroupOf JT := by
  have : Finite ↥J := th_finite
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨-, hQfull, -⟩ := th5_cube
  have hQ : Nat.card (Subgroup.closure ({x5, y5} : Set ↥J)) =
      5 ^ (Nat.card ↥JT).factorization 5 := by
    rw [th_card_JT, ← Subgroup.card_top (G := ↥J)]
    exact hQfull
  have hle : Subgroup.closure ({x5, y5} : Set ↥J) ≤ JT := by rw [JT_eq_top]; exact le_top
  exact ⟨Sylow.ofCard ((Subgroup.closure ({x5, y5} : Set ↥J)).subgroupOf JT)
    (by rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]; exact hQ), rfl⟩

theorem rowsMatrix_cubeProd {X Y C : Array V4} {x y c : J} (hX : rowsMatrix X = matJ x)
    (hY : rowsMatrix Y = matJ y) (hC : rowsMatrix C = matJ c) (i j k : ℕ) :
    rowsMatrix (cubeProd X Y C i j k) = matJ (x ^ i * y ^ j * c ^ k) := by
  unfold cubeProd
  rw [rowsMatrix_mulRows, rowsMatrix_mulRows, rowsMatrix_powRowsN, rowsMatrix_powRowsN,
    rowsMatrix_powRowsN, hX, hY, hC, matJ_mul, matJ_mul, matJ_pow, matJ_pow, matJ_pow]

theorem th5_Q_comm_c : ∀ q ∈ Subgroup.closure ({x5, y5} : Set ↥J), q * c5 = c5 * q := by
  obtain ⟨-, -, -, -, -, -, -, hcx, hcy⟩ := th5_cube
  generalize R5 94 * R5 105 * R5 94 ^ 4 * R5 105 ^ 4 = c at *
  generalize R5 94 = x at *
  generalize R5 105 = y at *
  have hle : Subgroup.closure ({x, y} : Set ↥J) ≤ Subgroup.centralizer ({c} : Set ↥J) := by
    rw [Subgroup.closure_le]
    rintro z (rfl | rfl)
    · exact Subgroup.mem_centralizer_singleton_iff.2 hcx.symm
    · exact Subgroup.mem_centralizer_singleton_iff.2 hcy.symm
  intro q hq
  have h1 := Subgroup.mem_centralizer_singleton_iff.1 (hle hq)
  exact h1

set_option maxRecDepth 100000 in
theorem th5_normalizes :
    ∀ g ∈ Subgroup.centralizer ({c5} : Set ↥J), ∀ q ∈ Subgroup.closure ({x5, y5} : Set ↥J),
      g * q * g⁻¹ ∈ Subgroup.closure ({x5, y5} : Set ↥J) := by
  obtain ⟨hcomp, -⟩ := thFive_complete
  obtain ⟨hnorm, -⟩ := Certificates.certificate17304
  intro g hg q hq
  obtain ⟨i, hi, rfl⟩ := hcomp g hg
  exact hnorm i hi q hq

set_option maxRecDepth 100000 in
theorem th5_K_eq :
    Subgroup.centralizer ((Subgroup.closure ({x5, y5} : Set ↥J) : Subgroup ↥J) : Set ↥J) ⊓
      (JT ⊓ Subgroup.centralizer ({c5} : Set ↥J)) = Subgroup.zpowers c5 := by
  obtain ⟨-, hK⟩ := Certificates.certificate17304
  obtain ⟨hcomp, -⟩ := thFive_complete
  have hxQ : x5 ∈ Subgroup.closure ({x5, y5} : Set ↥J) := Subgroup.subset_closure (by simp)
  have hyQ : y5 ∈ Subgroup.closure ({x5, y5} : Set ↥J) := Subgroup.subset_closure (by simp)
  apply le_antisymm
  · rintro u ⟨huQ, -, huc⟩
    obtain ⟨i, hi, rfl⟩ := hcomp u huc
    have hx := (Subgroup.mem_centralizer_iff.1 huQ x5 hxQ).symm
    have hy := (Subgroup.mem_centralizer_iff.1 huQ y5 hyQ).symm
    obtain ⟨k, -, hk⟩ := hK i hi hx hy
    rw [hk]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) k
  · rw [Subgroup.zpowers_le]
    exact ⟨Subgroup.mem_centralizer_iff.2 fun q hq => th5_Q_comm_c q hq, mem_JT c5,
      Subgroup.mem_centralizer_singleton_iff.2 rfl⟩

theorem th5_noSig :
    PlaneNoSig 5 ↥JT := by
  have : Finite ↥J := th_finite
  obtain ⟨hQ3, -, hc1, hc5, hcQ, hexp, -, -, -⟩ := th5_cube
  have hQJT : Subgroup.closure ({x5, y5} : Set ↥J) ≤ JT := by rw [JT_eq_top]; exact le_top
  refine noSig_planes_of_extra (th_autModel_JT th5_nonabelian)
    (Nat.le_mul_of_pos_left _ (by norm_num)) Nat.prime_five (by norm_num)
    (A := Subgroup.closure ({x5, y5} : Set ↥J)) hQJT hQ3 th5_sylow hexp (z := c5) (mem_JT c5) hc1
    (fun q hq => Subgroup.mem_centralizer_singleton_iff.2 (th5_Q_comm_c q hq))
    (fun g hg q hq => th5_normalizes g hg.2 q hq) ?_ ?_ (fun y _ hy => th5_rankOK y hy)
  · rw [th5_K_eq]
    exact Subgroup.zpowers_le.2 hcQ
  · rw [th5_K_eq, Nat.card_zpowers, orderOf_eq_prime hc5 hc1]

