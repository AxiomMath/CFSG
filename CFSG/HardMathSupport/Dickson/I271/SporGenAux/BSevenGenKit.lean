theorem mul_eq_one_symm {n : ℕ} {H Hi : Matrix (Fin n) (Fin n) (ZMod 2)} (h : H * Hi = 1) :
    Hi * H = 1 :=
  mul_eq_one_comm.1 h

theorem eq_top_of_intertwiner {U : Subgroup NativeSporadic.B}
    {a b : NativeSporadic.B} (ha : a ∈ U) (hb : b ∈ U)
    {H Hi : Matrix (Fin 4370) (Fin 4370) (ZMod 2)} (hHi : H * Hi = 1)
    (h1 : bMat bA₁ * H = H * bMat a) (h2 : bMat bA₂ * H = H * bMat b) : U = ⊤ := by
  haveI : Finite NativeSporadic.B := finite_B
  have hiH : Hi * H = 1 := mul_eq_one_symm hHi
  have key : ∀ g : NativeSporadic.B, ∃ u ∈ U, bMat u = Hi * bMat g * H := by
    intro g
    have hg : g ∈ Subgroup.closure ({bA₁, bA₂} : Set NativeSporadic.B) := by
      rw [closure_bA_eq_top]
      exact Subgroup.mem_top g
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · refine ⟨a, ha, ?_⟩
        rw [Matrix.mul_assoc, h1, ← Matrix.mul_assoc, hiH, Matrix.one_mul]
      · refine ⟨b, hb, ?_⟩
        rw [Matrix.mul_assoc, h2, ← Matrix.mul_assoc, hiH, Matrix.one_mul]
    | one => exact ⟨1, U.one_mem, by rw [map_one, Matrix.mul_one, hiH]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨u, hu, hux⟩ := hx
      obtain ⟨v, hv, hvy⟩ := hy
      refine ⟨u * v, U.mul_mem hu hv, ?_⟩
      rw [map_mul, map_mul, hux, hvy]
      calc Hi * bMat x * H * (Hi * bMat y * H) = Hi * bMat x * (H * Hi) * bMat y * H := by
            simp only [Matrix.mul_assoc]
        _ = Hi * (bMat x * bMat y) * H := by rw [hHi, Matrix.mul_one, Matrix.mul_assoc Hi]
    | inv x _ hx =>
      obtain ⟨u, hu, hux⟩ := hx
      refine ⟨u⁻¹, U.inv_mem hu, ?_⟩
      have e1 : bMat u⁻¹ * bMat u = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
      have e2 : bMat u * (Hi * bMat x⁻¹ * H) = 1 := by
        rw [hux]
        calc Hi * bMat x * H * (Hi * bMat x⁻¹ * H) = Hi * bMat x * (H * Hi) * bMat x⁻¹ * H := by
              simp only [Matrix.mul_assoc]
          _ = Hi * (bMat x * bMat x⁻¹) * H := by rw [hHi, Matrix.mul_one, Matrix.mul_assoc Hi]
          _ = 1 := by rw [← map_mul, mul_inv_cancel, map_one, Matrix.mul_one, hiH]
      calc bMat u⁻¹ = bMat u⁻¹ * (bMat u * (Hi * bMat x⁻¹ * H)) := by rw [e2, Matrix.mul_one]
        _ = Hi * bMat x⁻¹ * H := by rw [← Matrix.mul_assoc, e1, Matrix.one_mul]
  choose ψ hψU hψ using key
  have hinj : Function.Injective (fun g : NativeSporadic.B => (⟨ψ g, hψU g⟩ : U)) := by
    intro g g' hgg
    have e : ψ g = ψ g' := congrArg Subtype.val hgg
    have e' : Hi * bMat g * H = Hi * bMat g' * H := by rw [← hψ, ← hψ, e]
    apply bMat_injective
    calc bMat g = H * (Hi * bMat g * H) * Hi := by
          simp only [← Matrix.mul_assoc, hHi, Matrix.one_mul]
          rw [Matrix.mul_assoc, hHi, Matrix.mul_one]
      _ = H * (Hi * bMat g' * H) * Hi := by rw [e']
      _ = bMat g' := by
          simp only [← Matrix.mul_assoc, hHi, Matrix.one_mul]
          rw [Matrix.mul_assoc, hHi, Matrix.mul_one]
  exact Subgroup.eq_top_of_card_eq U
    (le_antisymm (Subgroup.card_le_card_group U) (Nat.card_le_card_of_injective _ hinj))

theorem sporPair_seven_of_model {name : TauCeti.SporadicName}
    (hSpM : CFSG.HardMathSupport.Timmesfeld.Tables.Multiplier.SporadicMultipliers)
    (hOut : SporadicOuterLeTwo) (hBr : SporadicBridges) {M : Type} [Group M] [Finite M]
    (eM : NativeSporadic.Carrier name ≃* M) (hcard : (Nat.card M).factorization 7 = 2)
    (hCG : CentGen 7 M) : SporPair name 7 :=
  sporPair_of_centGen hSpM (by norm_num)
    (sporCentGen_of_model Nat.prime_seven (by norm_num) hOut hBr eM hcard hCG)

