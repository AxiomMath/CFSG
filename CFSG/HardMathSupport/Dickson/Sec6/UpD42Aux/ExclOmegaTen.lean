theorem natCard_orthogonalGroup_of_minus_plane {K : Type} [Field K] [Finite K] {W : Type}
    [AddCommGroup W] [Module K W] [FiniteDimensional K W] {Q : QuadraticForm K W}
    (hK : Nat.card K = 2) (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hdim : Module.finrank K W = 2) (hminus : ¬ CFSG.GroupTheory.WeirSylow.IsPlusType Q) :
    Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) = 6 := by
  have h := CFSG.GroupTheory.WeirSylow.natCard_orthogonalGroup_of_type (K := K) (V := W)
    (Q := Q) hQ (m := 0) (by simpa using hdim) (ε := -1) (Or.inr ⟨rfl, hminus⟩)
  rw [hK] at h
  norm_num at h
  exact_mod_cast (show (Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) : ℤ) = 6 from by
    simpa using h)

theorem pRank_elemAbelian_three_pow_four {K : Type} [Field K] [Finite K] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {A : Subgroup (V ≃ₗ[K] V)}
    (hA : IsElemAbelian 3 A) (hcard : Nat.card A = 3 ^ 4) :
    CFSG.Open.pRank 3 A = 4 := by
  classical
  have : Finite V := Module.finite_of_finite K
  have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e f h => LinearEquiv.ext (congrFun h)
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hcomm : ∀ a b : A, a * b = b * a := fun a b => mul_comm' a b
  have hpow : ∀ a : A, a ^ 3 = 1 := fun a => Subtype.ext (by
    simpa using hA.2 (a : V ≃ₗ[K] V) a.2)
  have hle : 4 ≤ CFSG.Open.pRank 3 A :=
    CFSG.SectionRank.le_pRank_of_injective (by norm_num) hcomm hpow hcard A.subtype
      A.subtype_injective (by rw [Subgroup.range_subtype])
  obtain ⟨E, hEA, hE, hEcard⟩ := CFSG.SectionRank.exists_pRank (p := 3) (G := V ≃ₗ[K] V)
    (by norm_num) A
  have hEcardle : Nat.card E ≤ Nat.card A := by
    refine Nat.card_le_card_of_injective (fun e : E => (⟨e.1, hEA e.2⟩ : A)) ?_
    intro e f h
    exact Subtype.ext (congrArg (fun a : A => (a : V ≃ₗ[K] V)) h)
  rw [hEcard, hcard] at hEcardle
  have hle4 : CFSG.Open.pRank 3 A ≤ 4 :=
    (Nat.pow_le_pow_iff_right (by norm_num : 1 < 3)).mp hEcardle
  omega

theorem commutatorSpaceOf_le_of_fixes {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {U W : Submodule K V}
    (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) :
    commutatorSpaceOf A ≤ W := by
  classical
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  let B := QuadraticMap.polarBilin Q
  have hB : ∀ a : A, ∀ u v : V, B ((a : V ≃ₗ[K] V) u) ((a : V ≃ₗ[K] V) v) = B u v :=
    fun a u v => TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup (hAO a.2) u v
  have hWperp : W = LinearMap.BilinForm.orthogonal B U := by
    have hWle : W ≤ LinearMap.BilinForm.orthogonal B U := by
      intro w hw u hu
      exact horth u hu w hw
    have hdim : Module.finrank K W =
        Module.finrank K (LinearMap.BilinForm.orthogonal B U) := by
      rw [LinearMap.BilinForm.finrank_orthogonal (B := B) hQ U]
      have h := Submodule.finrank_add_eq_of_isCompl hUW
      omega
    exact Submodule.eq_of_le_of_finrank_eq hWle hdim
  rw [hWperp]
  rw [commutatorSpaceOf_eq_span A hp hpF hA]
  refine Submodule.span_le.mpr ?_
  rintro w ⟨a, v, rfl⟩
  change ∀ u ∈ U, B u (((a : V ≃ₗ[K] V) v) - v) = 0
  intro u hu
  have hainv : ((a⁻¹ : A) : V ≃ₗ[K] V) u = u := hAU a⁻¹ a⁻¹.2 u hu
  have hstep : B u (((a : V ≃ₗ[K] V) v)) = B (((a⁻¹ : A) : V ≃ₗ[K] V) u) v := by
    have h := hB a (((a⁻¹ : A) : V ≃ₗ[K] V) u) v
    have h1 : ((a : V ≃ₗ[K] V) (((a⁻¹ : A) : V ≃ₗ[K] V) u)) = u := by
      rw [Subgroup.coe_inv]
      exact LinearEquiv.apply_symm_apply _ _
    rwa [h1] at h
  calc B u (((a : V ≃ₗ[K] V) v) - v) = B u (((a : V ≃ₗ[K] V) v)) - B u v := by
        rw [map_sub]
    _ = B (((a⁻¹ : A) : V ≃ₗ[K] V) u) v - B u v := by rw [hstep]
    _ = 0 := by rw [hainv, sub_self]

theorem nonBotBlocks_card_le_four {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    {U W : Submodule K V} (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    (hWdim : Module.finrank K W = 8) {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) :
    (nonBotBlocks A 3).card ≤ 4 := by
  classical
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  let B := QuadraticMap.polarBilin Q
  have hB : ∀ a : A, ∀ u v : V, B ((a : V ≃ₗ[K] V) u) ((a : V ≃ₗ[K] V) v) = B u v :=
    fun a u v => TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup (hAO a.2) u v
  have hcommW : commutatorSpaceOf A ≤ W :=
    commutatorSpaceOf_le_of_fixes hQ hUW horth hAO hA hAU
  have hge2 : ∀ D ∈ nonBotBlocks A 3,
      2 ≤ Module.finrank K ↥(blockSpace A D.1) :=
    fun D hD => two_le_finrank_blockSpace A (CharP.cast_eq_zero K 2) hQ hp hpF hA hB D
      ((mem_nonBotBlocks A 3).mp hD)
  have hsum2 : 2 * (nonBotBlocks A 3).card ≤
      ∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) := by
    rw [mul_comm]
    refine Finset.card_nsmul_le_sum _ _ 2 hge2
  have hsumall : ∑ D : Hyperplane A 3, Module.finrank K ↥(blockSpace A D.1) =
      Module.finrank K ↥(commutatorSpaceOf A) := by
    have h := finrank_eq_finrank_fixedSpaceOf_add_sum_blockSpace A hp hpF hA
    have hc := Submodule.finrank_add_eq_of_isCompl
      (isCompl_fixedSpaceOf_commutatorSpaceOf A hp hpF hA)
    omega
  have hsumS : ∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) ≤
      Module.finrank K ↥(commutatorSpaceOf A) := by
    rw [← hsumall]
    refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_
    · intro D hD
      simp only [Finset.mem_univ]
    · intro D _ hD
      have hbot : blockSpace A D.1 = ⊥ := by
        by_contra hne
        exact hD ((mem_nonBotBlocks A 3).mpr hne)
      simp
  have hdimcomm : Module.finrank K ↥(commutatorSpaceOf A) ≤ 8 := by
    have hle := Submodule.finrank_mono hcommW
    rw [hWdim] at hle
    exact hle
  omega

theorem four_le_nonBotBlocks_card {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {A : Subgroup (V ≃ₗ[K] V)}
    [Fintype A] (hA : IsElemAbelian 3 A) (hcard : Nat.card A = 3 ^ 4) :
    4 ≤ (nonBotBlocks A 3).card := by
  classical
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  have hp4 : CFSG.Open.pRank 3 A = 4 := pRank_elemAbelian_three_pow_four hA hcard
  have ht_exists : ∀ D : Hyperplane A 3, ∃ x : A, x ∉ D.1 := by
    intro D
    have hD : D.1 ≠ ⊤ := by
      intro h
      have h1 : D.1.index = 1 := by rw [h, Subgroup.index_top]
      omega
    obtain ⟨x, -, hx⟩ := SetLike.not_le_iff_exists.mp (fun hle => hD (top_le_iff.mp hle))
    exact ⟨x, hx⟩
  let t : Hyperplane A 3 → A := fun D => Classical.choose (ht_exists D)
  have ht : ∀ D, t D ∉ D.1 := fun D => Classical.choose_spec (ht_exists D)
  have h := pRank_le_card_ne_bot_blockSpace A hp hpF hA t ht
  omega

theorem card_nonBotBlocks_eq_four {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    {U W : Submodule K V} (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    (hWdim : Module.finrank K W = 8) {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hcard : Nat.card A = 3 ^ 4)
    (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) : (nonBotBlocks A 3).card = 4 :=
  le_antisymm (nonBotBlocks_card_le_four hQ hUW horth hWdim hAO hA hAU)
    (four_le_nonBotBlocks_card hA hcard)

structure FourBlockData {K : Type} [Field K] {V : Type} [AddCommGroup V] [Module K V]
    (Q : QuadraticForm K V) (U W : Submodule K V) (A : Subgroup (V ≃ₗ[K] V)) where
  block : Fin 4 → Submodule K V
  finrank_block : ∀ i, Module.finrank K (block i) = 2
  invariant : ∀ i (a : A), ∀ x ∈ block i, (a : V ≃ₗ[K] V) x ∈ block i
  orthogonal : ∀ i j, i ≠ j → ∀ x ∈ block i, ∀ y ∈ block j,
    QuadraticMap.polarBilin Q x y = 0
  nondegenerate : ∀ i,
    (LinearMap.BilinForm.restrict (QuadraticMap.polarBilin Q) (block i)).Nondegenerate
  nontrivial : ∀ i, ∃ a : A, ∃ x ∈ block i, (a : V ≃ₗ[K] V) x ≠ x
  iSupIndep_block : iSupIndep block
  iSup_block : (⨆ i, block i) = W
  fixedSpace_eq : fixedSpaceOf A = U

theorem block_sum_eq_eight {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {U W : Submodule K V} (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    (hWdim : Module.finrank K W = 8) {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A)
    (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) (hS : (nonBotBlocks A 3).card = 4) :
    (∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) = 8) ∧
      Module.finrank K ↥(commutatorSpaceOf A) = 8 := by
  classical
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  let B := QuadraticMap.polarBilin Q
  have hB : ∀ a : A, ∀ u v : V, B ((a : V ≃ₗ[K] V) u) ((a : V ≃ₗ[K] V) v) = B u v :=
    fun a u v => TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup (hAO a.2) u v
  have hcommW : commutatorSpaceOf A ≤ W :=
    commutatorSpaceOf_le_of_fixes hQ hUW horth hAO hA hAU
  have hge2 : ∀ D ∈ nonBotBlocks A 3,
      2 ≤ Module.finrank K ↥(blockSpace A D.1) :=
    fun D hD => two_le_finrank_blockSpace A (CharP.cast_eq_zero K 2) hQ hp hpF hA hB D
      ((mem_nonBotBlocks A 3).mp hD)
  have hsumall : ∑ D : Hyperplane A 3, Module.finrank K ↥(blockSpace A D.1) =
      Module.finrank K ↥(commutatorSpaceOf A) := by
    have h := finrank_eq_finrank_fixedSpaceOf_add_sum_blockSpace A hp hpF hA
    have hc := Submodule.finrank_add_eq_of_isCompl
      (isCompl_fixedSpaceOf_commutatorSpaceOf A hp hpF hA)
    omega
  have hsumS : ∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) =
      Module.finrank K ↥(commutatorSpaceOf A) := by
    rw [← hsumall]
    refine Finset.sum_subset (Finset.subset_univ _) ?_
    intro D _ hD
    have hbot : blockSpace A D.1 = ⊥ := by
      by_contra hne
      exact hD ((mem_nonBotBlocks A 3).mpr hne)
    simp [hbot]
  have hsum8 : ∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) = 8 := by
    have hle : Module.finrank K ↥(commutatorSpaceOf A) ≤ 8 := by
      simpa [hWdim] using Submodule.finrank_mono hcommW
    have hge : 8 ≤ ∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) := by
      have h := Finset.card_nsmul_le_sum (nonBotBlocks A 3)
        (fun D => Module.finrank K ↥(blockSpace A D.1)) 2 hge2
      simpa [hS, smul_eq_mul] using h
    omega
  exact ⟨hsum8, by rw [← hsumS, hsum8]⟩

theorem block_dim_two_of_sum_eight {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hS : (nonBotBlocks A 3).card = 4)
    (hsum8 : ∑ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) = 8) :
    ∀ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) = 2 := by
  classical
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  let B := QuadraticMap.polarBilin Q
  have hB : ∀ a : A, ∀ u v : V, B ((a : V ≃ₗ[K] V) u) ((a : V ≃ₗ[K] V) v) = B u v :=
    fun a u v => TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup (hAO a.2) u v
  have hge2 : ∀ D ∈ nonBotBlocks A 3,
      2 ≤ Module.finrank K ↥(blockSpace A D.1) :=
    fun D hD => two_le_finrank_blockSpace A (CharP.cast_eq_zero K 2) hQ hp hpF hA hB D
      ((mem_nonBotBlocks A 3).mp hD)
  have hle : ∀ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) ≤ 2 := by
    intro D hD
    by_contra hcon
    have hlt : 2 < Module.finrank K ↥(blockSpace A D.1) := by omega
    have hsum_lt : ∑ _E ∈ nonBotBlocks A 3, (2 : ℕ) <
        ∑ E ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A E.1) := by
      refine Finset.sum_lt_sum (fun E hE => hge2 E hE) ⟨D, hD, hlt⟩
    rw [hsum8, Finset.sum_const, hS, smul_eq_mul] at hsum_lt
    omega
  intro D hD
  exact le_antisymm (hle D hD) (hge2 D hD)

theorem block_dim_two_and_span {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {U W : Submodule K V} (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    (hWdim : Module.finrank K W = 8) {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A)
    (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) (hS : (nonBotBlocks A 3).card = 4) :
    (∀ D ∈ nonBotBlocks A 3, Module.finrank K ↥(blockSpace A D.1) = 2) ∧
      (⨆ D : nonBotBlocks A 3, blockSpace A D.1) = W ∧ fixedSpaceOf A = U := by
  classical
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  obtain ⟨hsum8, hdim_comm⟩ := block_sum_eq_eight hQ hUW horth hWdim hAO hA hAU hS
  have hcommW : commutatorSpaceOf A ≤ W :=
    commutatorSpaceOf_le_of_fixes hQ hUW horth hAO hA hAU
  have hblock2 := block_dim_two_of_sum_eight hQ hAO hA hS hsum8
  have hcommEqW : commutatorSpaceOf A = W :=
    Submodule.eq_of_le_of_finrank_eq hcommW (by rw [hdim_comm, hWdim])
  have hsupAll : (⨆ D : Hyperplane A 3, blockSpace A D.1) = W := by
    rw [iSup_blockSpace_eq_commutatorSpaceOf A hp hpF hA, hcommEqW]
  have hsupS : (⨆ D : nonBotBlocks A 3, blockSpace A D.1) = W := by
    rw [← hsupAll]
    refine le_antisymm ?_ ?_
    · exact iSup_le fun D => le_iSup (fun E : Hyperplane A 3 => blockSpace A E.1) D.1
    · refine iSup_le fun D => ?_
      by_cases hD : D ∈ nonBotBlocks A 3
      · exact le_iSup (fun E : nonBotBlocks A 3 => blockSpace A E.1) ⟨D, hD⟩
      · have hbot : blockSpace A D.1 = ⊥ := by
          by_contra hne
          exact hD ((mem_nonBotBlocks A 3).mpr hne)
        rw [hbot]
        exact bot_le
  have hdimC : Module.finrank K ↥(fixedSpaceOf A) = Module.finrank K U := by
    have hc := Submodule.finrank_add_eq_of_isCompl
      (isCompl_fixedSpaceOf_commutatorSpaceOf A hp hpF hA)
    have hu := Submodule.finrank_add_eq_of_isCompl hUW
    omega
  have hUleC : U ≤ fixedSpaceOf A := by
    intro u hu
    rw [mem_fixedSpaceOf]
    intro a
    exact hAU a a.2 u hu
  have hCeq : fixedSpaceOf A = U :=
    (Submodule.eq_of_le_of_finrank_eq hUleC (by omega)).symm
  exact ⟨hblock2, hsupS, hCeq⟩

theorem exists_block_element_moving {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hA : IsElemAbelian 3 A) {D : Hyperplane A 3} (hD : blockSpace A D.1 ≠ ⊥) :
    ∃ a : A, ∃ x ∈ blockSpace A D.1, (a : V ≃ₗ[K] V) x ≠ x := by
  classical
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hD
  have hDtop : D.1 ≠ ⊤ := by
    intro h
    have h1 : D.1.index = 1 := by rw [h, Subgroup.index_top]
    omega
  obtain ⟨x, -, hx⟩ := SetLike.not_le_iff_exists.mp (fun hle => hDtop (top_le_iff.mp hle))
  exact ⟨x, v, hv, fun hfix => hv0 (eq_zero_of_fixed_mem_blockSpace A hp hpF hA hx hv hfix)⟩

theorem fourBlockData_exists {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {U W : Submodule K V} (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    (hWdim : Module.finrank K W = 8) {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hcard : Nat.card A = 3 ^ 4)
    (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) : Nonempty (FourBlockData Q U W A) := by
  classical
  let : IsMulCommutative ↥A := hA.1
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hp : Nat.Prime 3 := by norm_num
  have h3 : (3 : K) = 1 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    linear_combination h2
  have hpF : (3 : K) ≠ 0 := by rw [h3]; exact one_ne_zero
  let B := QuadraticMap.polarBilin Q
  have hB : ∀ a : A, ∀ u v : V, B ((a : V ≃ₗ[K] V) u) ((a : V ≃ₗ[K] V) v) = B u v :=
    fun a u v => TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup (hAO a.2) u v
  have hS : (nonBotBlocks A 3).card = 4 :=
    card_nonBotBlocks_eq_four hQ hUW horth hWdim hAO hA hcard hAU
  obtain ⟨hblock2, hsupS, hfix⟩ :=
    block_dim_two_and_span hQ hUW horth hWdim hAO hA hAU hS
  let e : nonBotBlocks A 3 ≃ Fin 4 := Finset.equivFinOfCardEq hS
  let block : Fin 4 → Submodule K V :=
    fun i => blockSpace A ((e.symm i : nonBotBlocks A 3) : Hyperplane A 3).1
  have hmemi : ∀ i, (e.symm i : nonBotBlocks A 3).1 ∈ nonBotBlocks A 3 := fun i => (e.symm i).2
  refine ⟨block, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hfix⟩
  · intro i
    exact hblock2 _ (hmemi i)
  · intro i a x hx
    exact blockSpace_invariant A hp hpF hA (a := a) hx
  · intro i j hij x hx y hy
    have hD : ((e.symm i : nonBotBlocks A 3) : Hyperplane A 3) ≠
        ((e.symm j : nonBotBlocks A 3) : Hyperplane A 3) := by
      intro h
      exact hij (e.symm.injective (Subtype.ext h))
    exact blockSpace_bilinear_orthogonal A hp hpF hA B hB hD hx hy
  · intro i
    exact blockSpace_polar_nondegenerate A hQ hp hpF hA hB
      ((e.symm i : nonBotBlocks A 3) : Hyperplane A 3)
  · intro i
    exact exists_block_element_moving hA (D := ((e.symm i : nonBotBlocks A 3) : Hyperplane A 3))
      ((mem_nonBotBlocks A 3).mp (hmemi i))
  · exact (iSupIndep_blockSpace A hp hpF hA).comp (fun i j hij =>
      e.symm.injective (Subtype.ext hij))
  · rw [← hsupS]
    exact e.symm.iSup_comp (g := fun D : nonBotBlocks A 3 => blockSpace A D.1)

open CFSG.RankThree.PartOne.KCOrthogonal

variable {K : Type} [Field K] {V : Type} [AddCommGroup V] [Module K V]
  {Q : QuadraticForm K V} {U W : Submodule K V} {A : Subgroup (V ≃ₗ[K] V)}

noncomputable def fourBlockAction (data : FourBlockData Q U W A) (i : Fin 4) :
    A →* (data.block i ≃ₗ[K] data.block i) where
  toFun a := restrictEquiv (data.block i) (a : V ≃ₗ[K] V)
    (fun v hv => data.invariant i a v hv)
    (fun v hv => data.invariant i a⁻¹ v hv)
  map_one' := by ext v; rfl
  map_mul' := by intro a b; ext v; rfl

theorem fourBlockAction_range_le_orthogonal (data : FourBlockData Q U W A) (i : Fin 4)
    {hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q} :
    (fourBlockAction data i).range ≤
      TauCeti.QuadraticMap.orthogonalGroup (Q.comp (data.block i).subtype) := by
  rintro y ⟨a, rfl⟩
  rw [TauCeti.QuadraticMap.mem_orthogonalGroup_iff]
  intro v
  change Q ((a : V ≃ₗ[K] V) (v : V)) = Q (v : V)
  exact TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp (hAO a.2) (v : V)

theorem fourBlockAction_range_card_le_three [Finite K] [CharP K 2] [FiniteDimensional K V]
    (hK : Nat.card K = 2) (data : FourBlockData Q U W A)
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA4 : Nat.card A = 3 ^ 4) (i : Fin 4)
    (hQ : (QuadraticMap.polarBilin (Q.comp (data.block i).subtype)).Nondegenerate)
    (hminus : ¬ CFSG.GroupTheory.WeirSylow.IsPlusType (Q.comp (data.block i).subtype)) :
    Nat.card (fourBlockAction data i).range ≤ 3 := by
  have hle := fourBlockAction_range_le_orthogonal (hAO := hAO) data i
  have hdiv6 : Nat.card (fourBlockAction data i).range ∣ 6 := by
    have h := Subgroup.card_dvd_of_le hle
    rwa [natCard_orthogonalGroup_of_minus_plane hK hQ (data.finrank_block i) hminus] at h
  have hdiv81 : Nat.card (fourBlockAction data i).range ∣ 81 := by
    have h := Subgroup.card_range_dvd (fourBlockAction data i)
    rwa [hA4] at h
  have hdiv3 : Nat.card (fourBlockAction data i).range ∣ 3 := by
    have h := Nat.dvd_gcd hdiv6 hdiv81
    norm_num at h
    simpa using h
  exact Nat.le_of_dvd (by norm_num) hdiv3

variable {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type} [AddCommGroup V]
  [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V} {U W : Submodule K V}
  {A : Subgroup (V ≃ₗ[K] V)}

theorem block_anisotropic (hK : Nat.card K = 2) (data : FourBlockData Q U W A)
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q) (hA : IsElemAbelian 3 A) (i : Fin 4) :
    ∀ v ∈ data.block i, Q v = 0 → v = 0 := by
  have hpq : ¬ 3 ∣ Nat.card K - 1 := by rw [hK]; norm_num
  have hPn : ∀ v ∈ data.block i, (∀ u ∈ data.block i, QuadraticMap.polar Q v u = 0) → v = 0 := by
    intro v hv h
    exact congrArg Subtype.val ((data.nondegenerate i).1 ⟨v, hv⟩ (fun w => by
      have := h w.1 w.2
      simpa [LinearMap.BilinForm.restrict_apply, QuadraticMap.polarBilin_apply_apply] using this))
  obtain ⟨a, x, hx, hax⟩ := data.nontrivial i
  refine CFSG.RankThree.PartOne.S15K.eq_zero_of_singular_of_isometry
    (Q := Q) (P := data.block i) (data.finrank_block i) hPn (p := 3) (by norm_num) (by norm_num)
    hpq (y := (a : V ≃ₗ[K] V)) ?_ ?_ ?_ ⟨x, hx, hax⟩
  · intro v
    exact TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp (hAO a.2) v
  · intro v hv
    exact data.invariant i a v hv
  · simpa using hA.2 (a : V ≃ₗ[K] V) a.2

theorem block_not_isPlusType (hK : Nat.card K = 2) (data : FourBlockData Q U W A)
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q) (hA : IsElemAbelian 3 A) (i : Fin 4) :
    ¬ CFSG.GroupTheory.WeirSylow.IsPlusType (Q.comp (data.block i).subtype) :=
  CFSG.RankThree.PartOne.S15K.not_isPlusType_of_aniso_plane (data.finrank_block i)
    (block_anisotropic hK data hAO hA i)

omit [Finite K] [FiniteDimensional K V] in
theorem reflection_apply_self_of_char_two {m : V} [Invertible (Q m)] :
    TauCeti.QuadraticMap.reflection Q m m = m := by
  rw [TauCeti.QuadraticMap.reflection_apply_self]
  have h2 : m + m = 0 := by
    have h2K : (2 : K) = 0 := CharTwo.two_eq_zero
    calc
      m + m = (2 : K) • m := (two_smul (R := K) m).symm
      _ = (0 : K) • m := by rw [h2K]
      _ = 0 := by rw [zero_smul]
  exact neg_eq_iff_add_eq_zero.mpr h2

omit [Finite K] in
theorem reflection_not_mem_omegaGroup
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {m : V} [Invertible (Q m)] :
    TauCeti.QuadraticMap.reflection Q m ∉
      CFSG.RankThree.OrthogonalInvolutions.omegaGroup Q hQ := by
  intro h
  have hEven : Even (Module.finrank K
      (CFSG.RankThree.OrthogonalInvolutions.commSpace (TauCeti.QuadraticMap.reflection Q m))) := h.2
  have h1 : Module.finrank K
      (CFSG.RankThree.OrthogonalInvolutions.commSpace (TauCeti.QuadraticMap.reflection Q m)) = 1 :=
    CFSG.RankThree.OrthogonalInvolutions.finrank_commSpace_reflection hQ m
  rw [h1] at hEven
  norm_num at hEven

theorem isCompl_orthPerp_fixedSpace {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    {x : V ≃ₗ[K] V} (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hx3 : orderOf x = 3) (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q) :
    IsCompl (orthPerp Q (fixedSpace x)) (fixedSpace x) := by
  have h3 : (3 : K) ≠ 0 := by
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    rw [show (3 : K) = 2 + 1 by norm_num, h2, zero_add]
    exact one_ne_zero
  have hx3' : x ^ 3 = 1 := by rw [← hx3]; exact pow_orderOf_eq_one x
  have hxodd : OddOrderIsometry Q 3 x :=
    { mem := hxO
      pow_eq_one := hx3'
      cast_ne_zero := h3
      regular := fun v hv => hQ.1 v fun w => by
        rw [QuadraticMap.polarBilin_apply_apply]
        exact hv w }
  rw [CFSG.RankThree.PartOne.KCOrthogonalD4.orthPerp_fixedSpace hxodd]
  exact hxodd.fixed_others.1.symm

theorem polarBilin_eq_zero_of_mem_orthPerp_fixedSpace {K : Type} [Field K] {V : Type}
    [AddCommGroup V] [Module K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V} :
    ∀ u ∈ orthPerp Q (fixedSpace x), ∀ w ∈ fixedSpace x,
      QuadraticMap.polarBilin Q u w = 0 := by
  intro u hu w hw
  rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar_comm]
  exact (mem_orthPerp.mp hu) w hw

theorem finrank_orthPerp_fixedSpace {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) (hdim : Module.finrank K V = 10)
    (hfix : Module.finrank K (fixedSpace x) = 8) :
    Module.finrank K (orthPerp Q (fixedSpace x)) = 2 := by
  change Module.finrank K
    (LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin Q) (fixedSpace x)) = 2
  rw [LinearMap.BilinForm.finrank_orthogonal (B := QuadraticMap.polarBilin Q) hQ, hdim, hfix]

theorem maps_orthPerp_fixedSpace_of_mem_orthogonalGroup {K : Type} [Field K] {V : Type}
    [AddCommGroup V] [Module K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q) :
    ∀ u ∈ orthPerp Q (fixedSpace x), x u ∈ orthPerp Q (fixedSpace x) := by
  intro u hu
  rw [mem_orthPerp] at hu ⊢
  intro w hw
  have hw_eq : x w = w := mem_fixedSpace.mp hw
  have hw' : x.symm w ∈ fixedSpace x := by
    rw [mem_fixedSpace]
    simpa using congrArg x.symm hw_eq
  have h1 : QuadraticMap.polar Q (x u) w = QuadraticMap.polar Q u (x.symm w) := by
    simpa using TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup hxO u (x.symm w)
  rw [QuadraticMap.polar_comm, h1, QuadraticMap.polar_comm]
  exact hu (x.symm w) hw'

theorem eq_zero_of_mem_orthPerp_fixedSpace_of_apply_eq {K : Type} [Field K] {V : Type}
    [AddCommGroup V] [Module K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hUW : IsCompl (orthPerp Q (fixedSpace x)) (fixedSpace x)) {u : V}
    (hu : u ∈ orthPerp Q (fixedSpace x)) (hfixu : x u = u) : u = 0 := by
  have hW : u ∈ fixedSpace x := mem_fixedSpace.mpr hfixu
  have hbot : u ∈ (⊥ : Submodule K V) := by
    rw [← hUW.inf_eq_bot]
    exact ⟨hu, hW⟩
  exact hbot

theorem anisotropic_orthPerp_fixedSpace {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    {x : V ≃ₗ[K] V} (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hK : Nat.card K = 2) (hdim : Module.finrank K V = 10)
    (hfix : Module.finrank K (fixedSpace x) = 8) (hx3 : orderOf x = 3)
    (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hUW : IsCompl (orthPerp Q (fixedSpace x)) (fixedSpace x)) :
    ∀ v ∈ orthPerp Q (fixedSpace x), Q v = 0 → v = 0 := by
  have hUd : Module.finrank K (orthPerp Q (fixedSpace x)) = 2 :=
    finrank_orthPerp_fixedSpace hQ hdim hfix
  have hUreg : ∀ v ∈ orthPerp Q (fixedSpace x),
      (∀ u ∈ orthPerp Q (fixedSpace x), QuadraticMap.polar Q v u = 0) → v = 0 := by
    intro v hv hvu
    refine hQ.1 v fun w => ?_
    have hmem : w ∈ orthPerp Q (fixedSpace x) ⊔ fixedSpace x := by
      rw [hUW.sup_eq_top]
      exact Submodule.mem_top
    obtain ⟨u, hu, w', hw', hsum⟩ := Submodule.mem_sup.mp hmem
    rw [← hsum]
    have h1 : QuadraticMap.polar Q v u = 0 := hvu u hu
    have h2 : QuadraticMap.polar Q v w' = 0 := by
      simpa using polarBilin_eq_zero_of_mem_orthPerp_fixedSpace v hv w' hw'
    simp [h1, h2]
  refine CFSG.RankThree.PartOne.S15K.eq_zero_of_singular_of_isometry hUd hUreg
    (p := 3) (by norm_num) (by norm_num) (by rw [hK]; norm_num) (y := x) ?_ ?_ ?_ ?_
  · exact fun v => TauCeti.QuadraticMap.map_app_of_mem_orthogonalGroup hxO v
  · intro v hv
    exact maps_orthPerp_fixedSpace_of_mem_orthogonalGroup hxO v hv
  · rw [← hx3]
    exact pow_orderOf_eq_one x
  · have hUne : orthPerp Q (fixedSpace x) ≠ ⊥ := by
      intro h
      rw [h, finrank_bot] at hUd
      omega
    obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hUne
    exact ⟨v, hv, fun h => hv0 (eq_zero_of_mem_orthPerp_fixedSpace_of_apply_eq hUW hv h)⟩

theorem fourBlockAction_apply_eq_self {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] {Q : QuadraticForm K V} {U W : Submodule K V} {A : Subgroup (V ≃ₗ[K] V)}
    (data : FourBlockData Q U W A) (i : Fin 4) {a : A}
    (ha : fourBlockAction data i a = 1) (v : V) (hv : v ∈ data.block i) :
    (a : V ≃ₗ[K] V) v = v := by
  have h := congrArg (fun e : data.block i ≃ₗ[K] data.block i => (e ⟨v, hv⟩ : V)) ha
  exact h

noncomputable def fourBlockActionProd (data : FourBlockData Q U W A) :
    A →* ((fourBlockAction data 1).range × (fourBlockAction data 2).range) ×
      (fourBlockAction data 3).range :=
  ((fourBlockAction data 1).rangeRestrict.prod (fourBlockAction data 2).rangeRestrict).prod
    (fourBlockAction data 3).rangeRestrict

theorem fourBlockAction_prod_range_card
    (hK : Nat.card K = 2) (data : FourBlockData Q U W A)
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hA4 : Nat.card A = 3 ^ 4) :
    Nat.card (fourBlockActionProd data).range ≤ 27 := by
  classical
  let ψ := fourBlockActionProd data
  have hQ1 : (QuadraticMap.polarBilin (Q.comp (data.block 1).subtype)).Nondegenerate := by
    rw [polarBilin_comp_subtype]
    exact data.nondegenerate 1
  have hQ2 : (QuadraticMap.polarBilin (Q.comp (data.block 2).subtype)).Nondegenerate := by
    rw [polarBilin_comp_subtype]
    exact data.nondegenerate 2
  have hQ3 : (QuadraticMap.polarBilin (Q.comp (data.block 3).subtype)).Nondegenerate := by
    rw [polarBilin_comp_subtype]
    exact data.nondegenerate 3
  have hr1 : Nat.card (fourBlockAction data 1).range ≤ 3 :=
    fourBlockAction_range_card_le_three hK data hAO hA4 1 hQ1
      (block_not_isPlusType hK data hAO hA 1)
  have hr2 : Nat.card (fourBlockAction data 2).range ≤ 3 :=
    fourBlockAction_range_card_le_three hK data hAO hA4 2 hQ2
      (block_not_isPlusType hK data hAO hA 2)
  have hr3 : Nat.card (fourBlockAction data 3).range ≤ 3 :=
    fourBlockAction_range_card_le_three hK data hAO hA4 3 hQ3
      (block_not_isPlusType hK data hAO hA 3)
  calc Nat.card ψ.range ≤
      Nat.card (((fourBlockAction data 1).range × (fourBlockAction data 2).range) ×
        (fourBlockAction data 3).range) := Subgroup.card_le_card_group ψ.range
    _ = Nat.card (fourBlockAction data 1).range * Nat.card (fourBlockAction data 2).range *
        Nat.card (fourBlockAction data 3).range := by rw [Nat.card_prod, Nat.card_prod]
    _ ≤ 3 * 3 * 3 := Nat.mul_le_mul (Nat.mul_le_mul hr1 hr2) hr3
    _ = 27 := by norm_num

omit [Finite K] [CharP K 2] [FiniteDimensional K V] in
theorem fourBlockAction_prod_ker_card
    (data : FourBlockData Q U W A) (hA4 : Nat.card A = 3 ^ 4)
    (hrange : Nat.card (fourBlockActionProd data).range ≤ 27) :
    3 ≤ Nat.card (fourBlockActionProd data).ker := by
  classical
  let ψ := fourBlockActionProd data
  have hker_eq : ψ.rangeRestrict.ker = ψ.ker := by
    ext a
    constructor
    · intro h
      simpa using congrArg Subtype.val h
    · intro h
      apply Subtype.ext
      simpa using h
  have hkr : Nat.card ψ.ker * Nat.card ψ.range = Nat.card A := by
    have h := Subgroup.card_ker_mul_card_of_surjective (f := ψ.rangeRestrict)
      (fun y => by
        obtain ⟨a, ha⟩ := MonoidHom.mem_range.mp y.2
        exact ⟨a, Subtype.ext ha⟩)
    rwa [hker_eq] at h
  have h1 : 3 * 27 ≤ Nat.card ψ.ker * Nat.card ψ.range := by
    rw [hkr, hA4]
    norm_num
  have h2 : Nat.card ψ.ker * Nat.card ψ.range ≤ Nat.card ψ.ker * 27 :=
    Nat.mul_le_mul_left (Nat.card ψ.ker) hrange
  exact Nat.le_of_mul_le_mul_right (le_trans h1 h2) (by norm_num)

omit [CharP K 2] in
theorem exists_ne_one_mem_blockAction_ker
    (data : FourBlockData Q U W A)
    (hker : 3 ≤ Nat.card (fourBlockActionProd data).ker) :
    ∃ aKer : (fourBlockActionProd data).ker, aKer ≠ 1 ∧
      fourBlockAction data 1 (aKer : A) = 1 ∧ fourBlockAction data 2 (aKer : A) = 1 ∧
      fourBlockAction data 3 (aKer : A) = 1 := by
  have hne : (fourBlockActionProd data).ker ≠ ⊥ :=
    (Subgroup.one_lt_card_iff_ne_bot _).mp (by omega)
  obtain ⟨aKer, ha1Ker⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
  have hψ : fourBlockActionProd data (aKer : A) = 1 := MonoidHom.mem_ker.mp aKer.2
  have hcomp1 : (fourBlockAction data 1).rangeRestrict (aKer : A) = 1 := by
    have h := congrArg (fun z => z.1.1) hψ
    simpa [fourBlockActionProd] using h
  have hcomp2 : (fourBlockAction data 2).rangeRestrict (aKer : A) = 1 := by
    have h := congrArg (fun z => z.1.2) hψ
    simpa [fourBlockActionProd] using h
  have hcomp3 : (fourBlockAction data 3).rangeRestrict (aKer : A) = 1 := by
    have h := congrArg (fun z => z.2) hψ
    simpa [fourBlockActionProd] using h
  refine ⟨aKer, ha1Ker, ?_, ?_, ?_⟩
  · simpa using congrArg (fun z : (fourBlockAction data 1).range =>
      (z : data.block 1 ≃ₗ[K] data.block 1)) hcomp1
  · simpa using congrArg (fun z : (fourBlockAction data 2).range =>
      (z : data.block 2 ≃ₗ[K] data.block 2)) hcomp2
  · simpa using congrArg (fun z : (fourBlockAction data 3).range =>
      (z : data.block 3 ≃ₗ[K] data.block 3)) hcomp3

theorem le_orthPerp_block_zero {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] {Q : QuadraticForm K V} {U W : Submodule K V} {A : Subgroup (V ≃ₗ[K] V)}
    (data : FourBlockData Q U W A)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0) :
    U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3 ≤ orthPerp Q (data.block 0) := by
  have hblock_le : ∀ j : Fin 4, data.block j ≤ W := by
    intro j x hx
    rw [← data.iSup_block]
    exact Submodule.mem_iSup_of_mem j hx
  have hUR : U ≤ orthPerp Q (data.block 0) := by
    intro u hu
    rw [mem_orthPerp]
    intro b hb
    rw [QuadraticMap.polar_comm]
    simpa using horth u hu b (hblock_le 0 hb)
  have hBR : ∀ j : Fin 4, j ≠ 0 → data.block j ≤ orthPerp Q (data.block 0) := by
    intro j hj b hb
    rw [mem_orthPerp]
    intro c hc
    rw [QuadraticMap.polar_comm, ← QuadraticMap.polarBilin_apply_apply]
    exact data.orthogonal j 0 hj b hb c hc
  exact sup_le (sup_le (sup_le hUR (hBR 1 (by decide))) (hBR 2 (by decide)))
    (hBR 3 (by decide))

theorem sup_orthPerp_block_zero_eq_top {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] {Q : QuadraticForm K V} {U W : Submodule K V} {A : Subgroup (V ≃ₗ[K] V)}
    (data : FourBlockData Q U W A) (hUW : IsCompl U W) :
    (U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3) ⊔ data.block 0 = ⊤ := by
  rw [eq_top_iff, ← hUW.sup_eq_top]
  refine sup_le ?_ ?_
  · exact le_sup_of_le_left (le_sup_of_le_left (le_sup_of_le_left le_sup_left))
  · calc W = ⨆ i, data.block i := data.iSup_block.symm
      _ ≤ U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3 ⊔ data.block 0 := by
        refine iSup_le fun i => ?_
        fin_cases i
        · exact le_sup_right
        · exact le_sup_of_le_left (le_sup_of_le_left (le_sup_of_le_left le_sup_right))
        · exact le_sup_of_le_left (le_sup_of_le_left le_sup_right)
        · exact le_sup_of_le_left le_sup_right

theorem apply_eq_self_of_mem_orthPerp_block_zero {K : Type} [Field K] {V : Type}
    [AddCommGroup V] [Module K V] {Q : QuadraticForm K V} {U W : Submodule K V}
    {A : Subgroup (V ≃ₗ[K] V)} (data : FourBlockData Q U W A) {a : A}
    (hVtop : (U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3) ⊔ data.block 0 = ⊤)
    (hle : U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3 ≤ orthPerp Q (data.block 0))
    (hAU : ∀ u ∈ U, (a : V ≃ₗ[K] V) u = u)
    (hA1 : fourBlockAction data 1 a = 1) (hA2 : fourBlockAction data 2 a = 1)
    (hA3 : fourBlockAction data 3 a = 1) :
    ∀ v ∈ orthPerp Q (data.block 0), (a : V ≃ₗ[K] V) v = v := by
  intro v hv
  have hmem : v ∈ U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3 := by
    have hVR : v ∈ (U ⊔ data.block 1 ⊔ data.block 2 ⊔ data.block 3) ⊔ data.block 0 := by
      rw [hVtop]
      exact Submodule.mem_top
    obtain ⟨s, hs, b, hb, hsum⟩ := Submodule.mem_sup.mp hVR
    have hbR : b ∈ orthPerp Q (data.block 0) := by
      have hb_eq : b = v - s := by rw [← hsum]; abel
      rw [hb_eq]
      exact (orthPerp Q (data.block 0)).sub_mem hv (hle hs)
    have hb0 : b = 0 := by
      have hb_sub : (⟨b, hb⟩ : data.block 0) = 0 := by
        refine (data.nondegenerate 0).1 ⟨b, hb⟩ fun u => ?_
        have h := mem_orthPerp.mp hbR u u.2
        rw [QuadraticMap.polar_comm] at h
        simpa [LinearMap.BilinForm.restrict_apply, QuadraticMap.polarBilin_apply_apply] using h
      exact congrArg Subtype.val hb_sub
    rw [← hsum, hb0, add_zero]
    exact hs
  obtain ⟨u1, hu1, r3, hr3, hsum1⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨u2, hu2, r2, hr2, hsum2⟩ := Submodule.mem_sup.mp hu1
  obtain ⟨u, hu, r1, hr1, hsum3⟩ := Submodule.mem_sup.mp hu2
  rw [← hsum1, ← hsum2, ← hsum3, map_add, map_add, map_add,
    hAU u hu,
    fourBlockAction_apply_eq_self data 1 hA1 r1 hr1,
    fourBlockAction_apply_eq_self data 2 hA2 r2 hr2,
    fourBlockAction_apply_eq_self data 3 hA3 r3 hr3]

theorem exists_mem_block_zero {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    {U W : Submodule K V} {A : Subgroup (V ≃ₗ[K] V)} [Fintype A]
    (hK : Nat.card K = 2) (data : FourBlockData Q U W A)
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hA : IsElemAbelian 3 A) (hA4 : Nat.card A = 3 ^ 4)
    (hUW : IsCompl U W)
    (horth : ∀ u ∈ U, ∀ w ∈ W, QuadraticMap.polarBilin Q u w = 0)
    (hAU : ∀ a ∈ A, ∀ u ∈ U, a u = u) :
    ∃ a : A, a ≠ 1 ∧ ∀ v ∈ orthPerp Q (data.block 0), (a : V ≃ₗ[K] V) v = v := by
  classical
  have hrange := fourBlockAction_prod_range_card hK data hAO hA hA4
  have hker := fourBlockAction_prod_ker_card data hA4 hrange
  obtain ⟨aKer, ha1, hA1, hA2, hA3⟩ :=
    exists_ne_one_mem_blockAction_ker data hker
  refine ⟨(aKer : A), fun h => ha1 (Subtype.ext h), ?_⟩
  exact apply_eq_self_of_mem_orthPerp_block_zero data
    (sup_orthPerp_block_zero_eq_top data hUW) (le_orthPerp_block_zero data horth)
    (fun u hu => hAU (aKer : A) (aKer : A).2 u hu) hA1 hA2 hA3

theorem exists_mem_orthDerived_conj_eq
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hdim : Module.finrank K V = 10)
    {x g : V ≃ₗ[K] V} (hgO : g ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    {m : V} (hm : m ∈ fixedSpace x) (hQm : Q m ≠ 0) :
    ∃ g' ∈ CFSG.RankThree.Classical2.orthDerived Q, g' * x * g'⁻¹ = g * x * g⁻¹ := by
  classical
  obtain ⟨T, hT3, hTs⟩ := CFSG.RankThree.PartOne.exists_threeSingular_of_dim
    (K := K) (W := V) Q hQ (m := 5) (by norm_num) (by omega)
  have hT : ∃ T : Submodule K V, Module.finrank K T = 3 ∧ ∀ u ∈ T, Q u = 0 := ⟨T, hT3, hTs⟩
  have heq : CFSG.RankThree.Classical2.orthDerived Q =
      CFSG.RankThree.OrthogonalInvolutions.omegaGroup Q hQ := by
    exact le_antisymm
      (CFSG.RankThree.PartOne.FieldFix.orthDerived_le_omegaGroup hQ)
      (CFSG.RankThree.PartOne.FieldFix.omegaGroup_le_orthDerived hQ hT)
  by_cases hg : g ∈ CFSG.RankThree.Classical2.orthDerived Q
  · exact ⟨g, hg, rfl⟩
  · let : Invertible (Q m) := invertibleOfNonzero hQm
    let r : V ≃ₗ[K] V := TauCeti.QuadraticMap.reflection Q m
    have hrO : r ∈ TauCeti.QuadraticMap.orthogonalGroup Q :=
      TauCeti.QuadraticMap.reflection_mem_orthogonalGroup Q m
    have hrm : r m = m := by
      dsimp [r]
      exact reflection_apply_self_of_char_two
    have hmx : x m = m := by simpa [fixedSpace, sub_eq_zero] using hm
    have hrcomm : r * x = x * r := by
      have := CFSG.RankThree.OrthogonalInvolutions.reflection_mul_comm hxO hmx
      simpa [r] using this.symm
    have hgNot : g ∉ CFSG.RankThree.OrthogonalInvolutions.omegaGroup Q hQ := by
      rwa [← heq]
    refine ⟨g * r, ?_, ?_⟩
    · rw [heq]
      refine ⟨mul_mem hgO hrO, ?_⟩
      have hmul := CFSG.RankThree.OrthogonalInvolutions.natCast_finrank_commSpace_mul
        hQ hgO hrO
      have hgOdd : Odd (Module.finrank K (CFSG.RankThree.OrthogonalInvolutions.commSpace g)) := by
        rw [← Nat.not_even_iff_odd]
        intro h
        exact hgNot ⟨hgO, h⟩
      have hr1 : Module.finrank K (CFSG.RankThree.OrthogonalInvolutions.commSpace r) = 1 :=
        CFSG.RankThree.OrthogonalInvolutions.finrank_commSpace_reflection hQ m
      rw [hr1] at hmul
      rw [← ZMod.natCast_eq_zero_iff_even]
      rw [hmul]
      have hg1 :
          (Module.finrank K (CFSG.RankThree.OrthogonalInvolutions.commSpace g) : ZMod 2) = 1 :=
        ZMod.natCast_eq_one_iff_odd.mpr hgOdd
      rw [hg1]
      decide
    · rw [show g * r * x = g * (r * x) by rw [mul_assoc], hrcomm]
      group

theorem quadratic_eq_one_of_anisotropic {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] {Q : QuadraticForm K V} {W : Submodule K V} (hK : Nat.card K = 2)
    (hW : ∀ v ∈ W, Q v = 0 → v = 0) {v : V} (hv : v ∈ W) (hv0 : v ≠ 0) : Q v = 1 := by
  have hunits : Nat.card Kˣ = 1 := by rw [Nat.card_units, hK]
  have hsub : Subsingleton Kˣ := (Nat.card_eq_one_iff_unique.mp hunits).1
  have hne : Q v ≠ 0 := fun h => hv0 (hW v hv h)
  exact congrArg Units.val (@Subsingleton.elim Kˣ hsub (Units.mk0 (Q v) hne) 1)

theorem polar_eq_one_of_anisotropic_basis_of_ne {K : Type} [Field K] [CharP K 2]
    {V : Type} [AddCommGroup V] [Module K V] {Q : QuadraticForm K V} {W : Submodule K V}
    {ι : Type} (hK : Nat.card K = 2) (hW : ∀ v ∈ W, Q v = 0 → v = 0)
    (bW : Module.Basis ι K W) {i j : ι} (hij : i ≠ j) :
    QuadraticMap.polar Q (bW i : V) (bW j : V) = 1 := by
  have hne : ∀ i, (bW i : V) ≠ 0 := fun i h =>
    bW.linearIndependent.ne_zero i (Subtype.ext h)
  have hsum : (bW i : V) + (bW j : V) ≠ 0 := by
    intro h
    apply hij
    apply bW.linearIndependent.injective
    apply Subtype.ext
    have h' : (bW i : V) = -((bW j : W) : V) := eq_neg_of_add_eq_zero_left h
    rw [CFSG.RankThree.OrthogonalInvolutions.neg_vec_eq K ((bW j : W) : V)] at h'
    exact h'
  rw [show QuadraticMap.polar Q (bW i : V) (bW j : V) =
      Q ((bW i : V) + (bW j : V)) - Q (bW i : V) - Q (bW j : V) from rfl,
    quadratic_eq_one_of_anisotropic hK hW (add_mem (bW i).2 (bW j).2) hsum,
    quadratic_eq_one_of_anisotropic hK hW (bW i).2 (hne i),
    quadratic_eq_one_of_anisotropic hK hW (bW j).2 (hne j),
    sub_self, zero_sub, CharTwo.neg_eq]

theorem exists_mem_orthogonalGroup_map_eq_of_anisotropic {K : Type} [Field K] [Finite K]
    [CharP K 2] {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hK : Nat.card K = 2) {P P' : Submodule K V} (hP : Module.finrank K P = 2)
    (hP' : Module.finrank K P' = 2) (haP : ∀ v ∈ P, Q v = 0 → v = 0)
    (haP' : ∀ v ∈ P', Q v = 0 → v = 0) :
    ∃ g ∈ TauCeti.QuadraticMap.orthogonalGroup Q, P.map (g : V →ₗ[K] V) = P' := by
  let b := Module.finBasisOfFinrankEq K P hP
  let b' := Module.finBasisOfFinrankEq K P' hP'
  let u : Fin 2 → V := fun i => (b i : V)
  let u' : Fin 2 → V := fun i => (b' i : V)
  have hu : LinearIndependent K u :=
    b.linearIndependent.map' P.subtype (Submodule.ker_subtype P)
  have hu' : LinearIndependent K u' :=
    b'.linearIndependent.map' P'.subtype (Submodule.ker_subtype P')
  have hQu : ∀ i, Q (u' i) = Q (u i) := by
    intro i
    rw [quadratic_eq_one_of_anisotropic hK haP (b i).2
        (fun h => b.linearIndependent.ne_zero i (Subtype.ext h)),
      quadratic_eq_one_of_anisotropic hK haP' (b' i).2
        (fun h => b'.linearIndependent.ne_zero i (Subtype.ext h))]
  have hpol : ∀ i j, QuadraticMap.polar Q (u' i) (u' j) =
      QuadraticMap.polar Q (u i) (u j) := by
    intro i j
    dsimp only [u, u']
    by_cases hij : i = j
    · subst hij
      rw [CFSG.RankThree.OrthogonalInvolutions.polar_self_eq_zero Q ((b' i : P') : V),
        CFSG.RankThree.OrthogonalInvolutions.polar_self_eq_zero Q ((b i : P) : V)]
    · rw [polar_eq_one_of_anisotropic_basis_of_ne hK haP b hij,
        polar_eq_one_of_anisotropic_basis_of_ne hK haP' b' hij]
  obtain ⟨g, hg, hgu⟩ :=
    CFSG.RankThree.OrthogonalInvolutions.exists_mem_orthogonalGroup_apply_eq hQ u u' hu hu'
      hQu hpol
  refine ⟨g, hg, ?_⟩
  have hspan : ∀ {W : Submodule K V} (bW : Module.Basis (Fin 2) K W),
      Submodule.span K (Set.range fun i => (bW i : V)) = W := by
    intro W bW
    rw [show (fun i => (bW i : V)) = W.subtype ∘ bW from rfl, Set.range_comp,
      Submodule.span_image, bW.span_eq, Submodule.map_subtype_top]
  rw [← hspan b, Submodule.map_span, ← Set.range_comp,
    show ((g : V →ₗ[K] V) ∘ u) = u' from funext hgu, hspan b']

theorem polarNondegOn_of_anisotropic_plane {K : Type} [Field K] [Finite K] [CharP K 2]
    {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hK : Nat.card K = 2) {P : Submodule K V} (hP : Module.finrank K P = 2)
    (haniso : ∀ v ∈ P, Q v = 0 → v = 0) :
    CFSG.ClassicalGroups.Orthogonal.PolarNondegOn Q P := by
  intro x hxP horth
  by_contra hx0
  have hQx : Q x ≠ 0 := fun h => hx0 (haniso x hxP h)
  have hx1 : Q x = 1 := eq_one_of_ne_zero_of_card_eq_two hK hQx
  have hnotle : ¬ P ≤ Submodule.span K {x} := by
    intro hle
    have hmono := Submodule.finrank_mono hle
    rw [finrank_span_singleton hx0, hP] at hmono
    omega
  obtain ⟨y, hyP, hyx⟩ := Set.not_subset_iff_exists_mem_notMem.mp hnotle
  have hy0 : y ≠ 0 := by
    rintro rfl
    exact hyx (Submodule.zero_mem _)
  have hQy : Q y ≠ 0 := fun h => hy0 (haniso y hyP h)
  have hy1 : Q y = 1 := eq_one_of_ne_zero_of_card_eq_two hK hQy
  have hpolar : QuadraticMap.polar Q x y ≠ 0 := by
    intro hp
    have horthxy : Q.IsOrtho x y := by
      rw [← QuadraticMap.isOrtho_polarBilin]
      simpa [QuadraticMap.polarBilin_apply_apply] using hp
    have hsum : Q (x + y) = 0 := by
      rw [QuadraticMap.isOrtho_def.mp horthxy, hx1, hy1]
      exact (CharTwo.add_eq_zero (R := K)).mpr rfl
    have hxy0 : x + y = 0 := haniso (x + y) (P.add_mem hxP hyP) hsum
    have hneg : -x = x := by
      rw [← neg_one_smul (R := K) x, CharTwo.neg_eq (1 : K)]
      exact one_smul K x
    have hxy : x = y := by
      rw [← hneg]
      exact (eq_neg_of_add_eq_zero_right hxy0).symm
    exact hyx (by rw [← hxy]; exact Submodule.mem_span_singleton_self x)
  exact hpolar (horth y hyP)

theorem eq_one_of_restrictEquiv_eq_one {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] {U W : Submodule K V} (hUW : IsCompl U W) {g : V ≃ₗ[K] V}
    (hU : ∀ v ∈ U, g v ∈ U) (hU' : ∀ v ∈ U, g⁻¹ v ∈ U) (hW : ∀ w ∈ W, g w = w)
    (hg : restrictEquiv U g hU hU' = 1) : g = 1 := by
  refine LinearEquiv.toLinearMap_injective
    (CFSG.RankThree.PartOne.LIT.ext_of_isCompl hUW (fun v hv => ?_) (fun w hw => ?_))
  · have := congrArg (fun e : U ≃ₗ[K] U => (e ⟨v, hv⟩ : V)) hg
    simpa using this
  · change g w = w
    exact hW w hw

theorem symm_mem_of_pow_three_eq_one {K : Type} [Field K] {V : Type} [AddCommGroup V]
    [Module K V] {U : Submodule K V} {g : V ≃ₗ[K] V} (hg : g ^ 3 = 1)
    (hU : ∀ u ∈ U, g u ∈ U) : ∀ u ∈ U, g⁻¹ u ∈ U := by
  have hg2 : g⁻¹ = g ^ 2 := by
    have h : g * g ^ 2 = 1 := by rw [pow_two, ← pow_three, hg]
    ext v
    change g.symm v = (g ^ 2) v
    rw [LinearEquiv.symm_apply_eq, ← LinearEquiv.mul_apply, h]
    rfl
  intro u hu
  rw [hg2]
  simpa [pow_two, LinearEquiv.mul_apply] using hU (g u) (hU u hu)

theorem exists_pow_eq_of_card_six {G : Type} [Group G] (hG : Nat.card G = 6) {g h : G}
    (hg3 : g ^ 3 = 1) (hh3 : h ^ 3 = 1) (hg1 : g ≠ 1) (hh1 : h ≠ 1) :
    ∃ k < 3, h ^ k = g := by
  classical
  have hfinite : Finite G := Nat.finite_of_card_ne_zero (by rw [hG]; norm_num)
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hgcard : Nat.card (Subgroup.zpowers g) = 3 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime hg3 hg1
  have hhcard : Nat.card (Subgroup.zpowers h) = 3 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime hh3 hh1
  have heq : Subgroup.zpowers g = Subgroup.zpowers h :=
    @CFSG.Quasithin.H13.A5.eq_of_card_three_of_card_six G _ hfinite hG
      (Subgroup.zpowers g) (Subgroup.zpowers h) hgcard hhcard
  have hmem : g ∈ Subgroup.zpowers h := by
    rw [← heq]
    simp
  have hhord : orderOf h = 3 := by rw [← Nat.card_zpowers]; exact hhcard
  have hhfin : IsOfFinOrder h := by rw [← orderOf_ne_zero_iff, hhord]; norm_num
  obtain ⟨k, hklt, hk⟩ := Finset.mem_image.mp (hhfin.mem_zpowers_iff_mem_range_orderOf.mp hmem)
  exact ⟨k, by rwa [Finset.mem_range, hhord] at hklt, hk⟩

theorem exists_pow_eq_restrictEquiv_of_anisotropic {K : Type} [Field K] [Finite K] [CharP K 2]
    {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hK : Nat.card K = 2) {P : Submodule K V} (hP : Module.finrank K P = 2)
    (haniso : ∀ v ∈ P, Q v = 0 → v = 0) {y a : V ≃ₗ[K] V}
    (hyO : y ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (haO : a ∈ TauCeti.QuadraticMap.orthogonalGroup Q) (hy3 : y ^ 3 = 1) (ha3 : a ^ 3 = 1)
    (hy1 : y ≠ 1) (ha1 : a ≠ 1) (hyP : ∀ v ∈ P, y v ∈ P) (haP : ∀ v ∈ P, a v ∈ P)
    (hyinv : ∀ v ∈ P, y⁻¹ v ∈ P) (hainv : ∀ v ∈ P, a⁻¹ v ∈ P)
    (hy : ∀ v ∈ orthPerp Q P, y v = v) (ha : ∀ v ∈ orthPerp Q P, a v = v) :
    ∃ k < 3, (restrictEquiv P a haP hainv) ^ k = restrictEquiv P y hyP hyinv := by
  classical
  have hPnd := polarNondegOn_of_anisotropic_plane hK hP haniso
  have hQP := CFSG.RankThree.PartOne.S15K.polarBilin_comp_subtype_nondegenerate hPnd
  have hPW : IsCompl P (orthPerp Q P) := isCompl_orthPerp hQP
  let yP := restrictEquiv P y hyP hyinv
  let aP := restrictEquiv P a haP hainv
  have hyPmem : yP ∈ TauCeti.QuadraticMap.orthogonalGroup (Q.comp P.subtype) :=
    CFSG.LinearAlgebra.restrictEquiv_mem_orthogonalGroup hyO hyP hyinv
  have haPmem : aP ∈ TauCeti.QuadraticMap.orthogonalGroup (Q.comp P.subtype) :=
    CFSG.LinearAlgebra.restrictEquiv_mem_orthogonalGroup haO haP hainv
  let yO : ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.comp P.subtype)) := ⟨yP, hyPmem⟩
  let aO : ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.comp P.subtype)) := ⟨aP, haPmem⟩
  have hyP3 : yP ^ 3 = 1 := by
    ext u
    have h := CFSG.LinearAlgebra.restrictEquiv_pow_apply P y hyP hyinv 3 u
    rw [hy3] at h
    simpa [yP] using h
  have haP3 : aP ^ 3 = 1 := by
    ext u
    have h := CFSG.LinearAlgebra.restrictEquiv_pow_apply P a haP hainv 3 u
    rw [ha3] at h
    simpa [aP] using h
  have hyP1 : yP ≠ 1 := fun h => hy1 (eq_one_of_restrictEquiv_eq_one hPW hyP hyinv hy h)
  have haP1 : aP ≠ 1 := fun h => ha1 (eq_one_of_restrictEquiv_eq_one hPW haP hainv ha h)
  have hcardO : Nat.card (TauCeti.QuadraticMap.orthogonalGroup (Q.comp P.subtype)) = 6 :=
    natCard_orthogonalGroup_of_minus_plane hK hQP hP
      (CFSG.RankThree.PartOne.S15K.not_isPlusType_of_aniso_plane hP haniso)
  have hyP3O : yO ^ 3 = 1 := Subtype.ext hyP3
  have haP3O : aO ^ 3 = 1 := Subtype.ext haP3
  have hyP1O : yO ≠ 1 := fun h => hyP1 (congrArg Subtype.val h)
  have haP1O : aO ≠ 1 := fun h => haP1 (congrArg Subtype.val h)
  obtain ⟨k, hklt, hk⟩ := exists_pow_eq_of_card_six hcardO hyP3O haP3O hyP1O haP1O
  refine ⟨k, hklt, ?_⟩
  have h := congrArg (fun z : ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.comp P.subtype)) =>
    (z : P ≃ₗ[K] P)) hk
  simpa [aO, yO] using h

theorem mem_zpowers_of_fixes_orthPerp_of_anisotropic {K : Type} [Field K] [Finite K] [CharP K 2]
    {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hK : Nat.card K = 2) {P : Submodule K V}
    (hP : Module.finrank K P = 2) (haniso : ∀ v ∈ P, Q v = 0 → v = 0) {y a : V ≃ₗ[K] V}
    (hyO : y ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (haO : a ∈ TauCeti.QuadraticMap.orthogonalGroup Q) (hy3 : y ^ 3 = 1) (ha3 : a ^ 3 = 1)
    (ha1 : a ≠ 1) (hyP : ∀ v ∈ P, y v ∈ P) (haP : ∀ v ∈ P, a v ∈ P)
    (hy : ∀ v ∈ orthPerp Q P, y v = v) (ha : ∀ v ∈ orthPerp Q P, a v = v) :
    y ∈ Subgroup.zpowers a := by
  classical
  by_cases hy1 : y = 1
  · rw [hy1]; exact Subgroup.one_mem _
  have hyinv : ∀ v ∈ P, y⁻¹ v ∈ P := symm_mem_of_pow_three_eq_one hy3 hyP
  have hainv : ∀ v ∈ P, a⁻¹ v ∈ P := symm_mem_of_pow_three_eq_one ha3 haP
  obtain ⟨k, hklt, hk⟩ := exists_pow_eq_restrictEquiv_of_anisotropic hK hP haniso hyO haO
    hy3 ha3 hy1 ha1 hyP haP hyinv hainv hy ha
  have hPW : IsCompl P (orthPerp Q P) := isCompl_orthPerp
    (CFSG.RankThree.PartOne.S15K.polarBilin_comp_subtype_nondegenerate
      (polarNondegOn_of_anisotropic_plane hK hP haniso))
  have hPpart : ∀ u ∈ P, y u = (a ^ k) u := by
    intro u hu
    have h := CFSG.LinearAlgebra.restrictEquiv_pow_apply P a haP hainv k ⟨u, hu⟩
    rw [hk] at h
    exact h
  have hWpart : ∀ w ∈ orthPerp Q P, y w = (a ^ k) w := by
    intro w hw
    rw [hy w hw, CFSG.LieType.SeitzGeneration.OrthBlk.pow_apply_of_fixed (ha w hw) k]
  have hyeq : y = a ^ k := LinearEquiv.toLinearMap_injective
    (CFSG.RankThree.PartOne.LIT.ext_of_isCompl hPW hPpart hWpart)
  exact Subgroup.mem_zpowers_iff.mpr ⟨k, by rw [zpow_natCast]; exact hyeq.symm⟩

theorem not_mem_zpowers_of_fixes_orthPerp_fixedSpace {K : Type} [Field K] [Finite K]
    [CharP K 2] {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hdim : Module.finrank K V = 10) {x : V ≃ₗ[K] V} (hx3 : orderOf x = 3)
    (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hfix : Module.finrank K (fixedSpace x) = 8) {y : V ≃ₗ[K] V} (hy1 : y ≠ 1)
    (hyU : ∀ v ∈ orthPerp Q (fixedSpace x), y v = v) : y ∉ Subgroup.zpowers x := by
  classical
  intro hy
  have hx3' : x ^ 3 = 1 := by simpa [hx3] using pow_orderOf_eq_one x
  have hxfin : IsOfFinOrder x := by rw [← orderOf_ne_zero_iff, hx3]; norm_num
  obtain ⟨n, hnlt, hn⟩ :=
    Finset.mem_image.mp (hxfin.mem_zpowers_iff_mem_range_orderOf.mp hy)
  rw [hx3, Finset.mem_range] at hnlt
  rw [← hn] at hy1 hyU
  have hUW := isCompl_orthPerp_fixedSpace hQ hx3 hxO
  have hUd := finrank_orthPerp_fixedSpace hQ hdim hfix
  have hUne : orthPerp Q (fixedSpace x) ≠ ⊥ := by
    intro h
    rw [h, finrank_bot] at hUd
    omega
  obtain ⟨u, hu, hu0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hUne
  interval_cases n
  · simp at hy1
  · exact hu0 (eq_zero_of_mem_orthPerp_fixedSpace_of_apply_eq hUW hu (by simpa using hyU u hu))
  · have hx2u : (x ^ 2) u = u := by simpa using hyU u hu
    have hx4 : x = (x ^ 2) ^ 2 := by
      rw [← pow_mul, show 2 * 2 = 4 by norm_num, show 4 = 3 + 1 by norm_num, pow_succ,
        hx3', one_mul]
    have hfixu : x u = u := by
      rw [hx4, pow_two, LinearEquiv.mul_apply, hx2u, hx2u]
    exact hu0 (eq_zero_of_mem_orthPerp_fixedSpace_of_apply_eq hUW hu hfixu)

theorem conj_mapsTo_and_fixes_of_map_orthPerp_eq {K : Type} [Field K] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) {x g : V ≃ₗ[K] V}
    (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hgO : g ∈ TauCeti.QuadraticMap.orthogonalGroup Q) {P : Submodule K V}
    (hg : (orthPerp Q (fixedSpace x)).map (g : V →ₗ[K] V) = P) :
    (∀ v ∈ P, (g * x * g⁻¹) v ∈ P) ∧ ∀ v ∈ orthPerp Q P, (g * x * g⁻¹) v = v := by
  have hgg : ∀ v, g (g⁻¹ v) = v := fun v => by
    rw [← LinearEquiv.mul_apply, mul_inv_cancel, LinearEquiv.coe_one, id]
  constructor
  · intro v hv
    rw [← hg] at hv ⊢
    obtain ⟨u, hu, rfl⟩ := hv
    have hgu : g⁻¹ (g u) = u := by
      rw [← LinearEquiv.mul_apply, inv_mul_cancel, LinearEquiv.coe_one, id]
    refine ⟨x u, maps_orthPerp_fixedSpace_of_mem_orthogonalGroup hxO u hu, ?_⟩
    change g (x u) = g (x (g⁻¹ (g u)))
    rw [hgu]
  · intro v hv
    have hperp : g⁻¹ v ∈ orthPerp Q (orthPerp Q (fixedSpace x)) := by
      rw [mem_orthPerp]
      intro u hu
      have hgu : g u ∈ P := by
        rw [← hg]
        exact Submodule.mem_map_of_mem hu
      have h := TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup hgO u (g⁻¹ v)
      rw [hgg] at h
      rw [← h]
      exact (mem_orthPerp.mp hv) (g u) hgu
    have hdbl : orthPerp Q (orthPerp Q (fixedSpace x)) = fixedSpace x :=
      LinearMap.BilinForm.orthogonal_orthogonal hQ (QuadraticMap.isSymm_polarBilin Q).isRefl _
    rw [hdbl, mem_fixedSpace] at hperp
    change g (x (g⁻¹ v)) = v
    rw [hperp, hgg]

theorem exists_conj_mem_of_fixedSpace_eight_of_finrank_ten {K : Type} [Field K] [Finite K]
    [CharP K 2] {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hK : Nat.card K = 2) (hdim : Module.finrank K V = 10) {x : V ≃ₗ[K] V} (hx3 : orderOf x = 3)
    (hxO : x ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hfix : Module.finrank K (fixedSpace x) = 8) {A : Subgroup (V ≃ₗ[K] V)}
    (hAO : A ≤ TauCeti.QuadraticMap.orthogonalGroup Q) (hAel : IsElemAbelian 3 A)
    (hA4 : Nat.card A = 3 ^ 4) (hAU : ∀ a ∈ A, ∀ v ∈ orthPerp Q (fixedSpace x), a v = v) :
    ∃ σ : V ≃ₗ[K] V, σ ∈ TauCeti.QuadraticMap.orthogonalGroup Q ∧
      σ ∈ CFSG.RankThree.Classical2.orthDerived Q ∧
      σ * x * σ⁻¹ ∈ A ∧ σ * x * σ⁻¹ ∉ Subgroup.zpowers x := by
  classical
  have : Fintype A := Fintype.ofFinite A
  have hUW := isCompl_orthPerp_fixedSpace hQ hx3 hxO
  obtain ⟨data⟩ := fourBlockData_exists hQ hUW polarBilin_eq_zero_of_mem_orthPerp_fixedSpace hfix
    hAO hAel hA4 hAU
  obtain ⟨a, ha1, ha⟩ := exists_mem_block_zero hK data hAO hAel hA4 hUW
    polarBilin_eq_zero_of_mem_orthPerp_fixedSpace hAU
  obtain ⟨g, hgO, hg⟩ := exists_mem_orthogonalGroup_map_eq_of_anisotropic hQ hK
    (finrank_orthPerp_fixedSpace hQ hdim hfix) (data.finrank_block 0)
    (anisotropic_orthPerp_fixedSpace hQ hK hdim hfix hx3 hxO hUW)
    (block_anisotropic hK data hAO hAel 0)
  obtain ⟨hyP, hy⟩ := conj_mapsTo_and_fixes_of_map_orthPerp_eq hQ hxO hgO hg
  have hblock : ∀ i, data.block i ≤ fixedSpace x := fun i =>
    (le_iSup data.block i).trans data.iSup_block.le
  have hx3' : x ^ 3 = 1 := by rw [← hx3]; exact pow_orderOf_eq_one x
  have hy1 : g * x * g⁻¹ ≠ 1 := fun h => by
    have hx1 : x = 1 := by
      calc x = g⁻¹ * (g * x * g⁻¹) * g := by group
        _ = 1 := by rw [h]; group
    rw [hx1, orderOf_one] at hx3
    omega
  have hmem : g * x * g⁻¹ ∈ Subgroup.zpowers (a : V ≃ₗ[K] V) :=
    mem_zpowers_of_fixes_orthPerp_of_anisotropic hK (data.finrank_block 0)
      (block_anisotropic hK data hAO hAel 0) (mul_mem (mul_mem hgO hxO) (inv_mem hgO)) (hAO a.2)
      (by rw [conj_pow, hx3', mul_one, mul_inv_cancel]) (hAel.2 a a.2)
      (fun h => ha1 (Subtype.ext h)) hyP (fun v hv => data.invariant 0 a v hv) hy ha
  have hyU : ∀ v ∈ orthPerp Q (fixedSpace x), (g * x * g⁻¹) v = v := fun v hv =>
    hy v (mem_orthPerp.mpr fun r hr => (mem_orthPerp.mp hv) r (hblock 0 hr))
  have hne : data.block 1 ≠ ⊥ := fun h => by
    have h2 := data.finrank_block 1
    rw [h, finrank_bot] at h2
    omega
  obtain ⟨m, hm, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  obtain ⟨σ, hσ, hσeq⟩ := exists_mem_orthDerived_conj_eq hQ hdim hgO hxO (hblock 1 hm)
    (fun h => hm0 (block_anisotropic hK data hAO hAel 1 m hm h))
  refine ⟨σ, CFSG.RankThree.PartOne.KCOrthogonal.orthDerived_le_orthogonalGroup hσ, hσ, ?_, ?_⟩
  · rw [hσeq]
    exact (Subgroup.zpowers_le.mpr a.2) hmem
  · rw [hσeq]
    exact not_mem_zpowers_of_fixes_orthPerp_fixedSpace hQ hdim hx3 hxO hfix hy1 hyU

