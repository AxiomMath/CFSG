namespace CFSG.HardMathSupport.Dickson.Sec6

open CFSG.Blueprint

theorem upD42Chev2Out_suzuki_holds : UpD42Chev2Out
    (fun d => match d with | .suzuki _ => True | _ => False) := by
  intro S _ _ _ _ ⟨d, hv⟩ hd _ ⟨e⟩ α _ hx
  cases d with
  | suzuki m =>
    have hm : 1 ≤ m := by
      have h := ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
      simpa only [TauCeti.LieTypeIndex.inStandardRange_iff] using h
    have hcard : Nat.card S = ((2 ^ (2 * m + 1)) ^ 2 + 1) *
        (2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1) := by
      rw [Nat.card_congr
        (e.trans (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv)).toEquiv,
        CFSG.SectionRank.card_suzukiMatrixGroup m (by omega)]
    have h3 : 3 ∣ Nat.card S := (by norm_num : 3 ∣ 174182400).trans hx.card_d42_dvd
    rw [hcard] at h3
    exact (CFSG.Quasithin.S146zX.not_three_dvd_sz_order m h3).elim
  | _ => exact hd.elim

end CFSG.HardMathSupport.Dickson.Sec6

