section Psp

variable {r : ℕ} {K : Type} [Field K] [Finite K]

theorem t6outh_commutator_psp_le_range (hr : 3 ≤ r) :
    commutator (MulAut (StatedProj (StatedSp r K))) ≤ (conjAut r K).range := by
  obtain ⟨-, hform⟩ := automorphism_generation (K := K) hr
  haveI : ((conjAut r K).range : Subgroup (MulAut (StatedProj (StatedSp r K)))).Normal := by
    refine ⟨fun n hn g => ?_⟩
    obtain ⟨A, σ, rfl⟩ := hform g
    obtain ⟨B, rfl⟩ := hn
    have h : conjAut r K A * fieldAut r K σ * conjAut r K B * (conjAut r K A * fieldAut r K σ)⁻¹ =
        conjAut r K A * (fieldAut r K σ * conjAut r K B * (fieldAut r K σ)⁻¹) *
          (conjAut r K A)⁻¹ := by group
    rw [h, fieldAut_mul_conjAut_mul_inv, ← map_inv, ← map_mul, ← map_mul]
    exact ⟨_, rfl⟩
  refine t6outpsp_commutator_le_of_eq_mul_comm _ (fieldAut r K).range ?_ ?_
  · intro g
    obtain ⟨A, σ, rfl⟩ := hform g
    exact ⟨_, ⟨A, rfl⟩, _, ⟨σ, rfl⟩, rfl⟩
  · rintro _ ⟨σ, rfl⟩ _ ⟨τ, rfl⟩
    rw [← map_mul, ← map_mul, ringAut_mul_comm K σ τ]

theorem t6outh_isInnerAut_psp (hr : 3 ≤ r) {τ : MulAut (StatedProj (StatedSp r K))}
    (hτ : τ ∈ innAutDerived (StatedProj (StatedSp r K))) (h3 : τ ^ 3 = 1) : IsInnerAut τ := by
  haveI : NeZero r := ⟨by omega⟩
  have hle : innAutDerived (StatedProj (StatedSp r K)) ≤ (conjAut r K).range :=
    sup_le (innAut_le_range_spConjAut r K) (t6outh_commutator_psp_le_range hr)
  obtain ⟨A, rfl⟩ := hle hτ
  have h4A : conjAut r K A = conjAut r K (A ^ 2) ^ 2 := by
    rw [← map_pow, ← pow_mul, map_pow]
    calc conjAut r K A = conjAut r K A ^ 3 * conjAut r K A := by rw [h3, one_mul]
      _ = conjAut r K A ^ (2 * 2) := by rw [← pow_succ]
  rw [IsInnerAut, h4A]
  refine Subgroup.pow_mem _ (conjAut_mem_inner_of_isSquare ⟨(multiplier r K A : K), ?_⟩) 2
  rw [map_pow, Units.val_pow_eq_pow_val, sq]

end Psp

theorem outDerived3_pspHighNe3 : OutDerived3At (fun t n p f => FamPspHigh t n p f ∧ p ≠ 3) := by
  intro P _ _ t n p f hadm ht hF hm τ hτ hτ3
  obtain ⟨⟨rfl, hn2, hn⟩, hp3⟩ := hF
  have hn3 : 3 ≤ n := by
    rcases hn with hn | hn
    · omega
    · exact absurd hn hp3
  have hC : StatedClassicalModel P .PSp n p f := (lieModel_classical_iff (by decide)).mp hm
  obtain ⟨-, K, _, _, -, ⟨e⟩⟩ := hC
  have h1 : MulAut.congr e τ ∈ innAutDerived (StatedProj (StatedSp n K)) :=
    (mem_innAutDerived_congr e).2 hτ
  have h3 : (MulAut.congr e τ) ^ 3 = 1 := by rw [← map_pow, hτ3, map_one]
  exact (isInnerAut_congr e τ).1 (t6outh_isInnerAut_psp hn3 h1 h3)

section Psu

theorem isInnerAut_of_outer_commutators {P : Type} [Group P] (N : Subgroup (Outer P))
    (hN : Nat.Coprime 3 (Nat.card N)) (hcomm : ∀ a b : Outer P, a * b * a⁻¹ * b⁻¹ ∈ N)
    {τ : MulAut P} (hτ : τ ∈ innAutDerived P) (h3 : τ ^ 3 = 1) : IsInnerAut τ := by
  set π : MulAut P →* Outer P := QuotientGroup.mk' (inner P) with hπ
  have hcom : commutator (MulAut P) ≤ N.comap π := by
    rw [commutator_def, Subgroup.commutator_le]
    intro a _ b _
    rw [Subgroup.mem_comap, commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv]
    exact hcomm _ _
  have hinn : inner P ≤ N.comap π := fun i hi => by
    rw [Subgroup.mem_comap]
    have : π i = 1 := (QuotientGroup.eq_one_iff i).2 hi
    rw [this]
    exact N.one_mem
  have hmem : π τ ∈ N := Subgroup.mem_comap.1 ((sup_le hinn hcom : innAutDerived P ≤ N.comap π) hτ)
  set x : ↥N := ⟨π τ, hmem⟩ with hx
  have hx3 : x ^ 3 = 1 := by
    apply Subtype.ext
    show (π τ) ^ 3 = 1
    rw [← map_pow, h3, map_one]
  have hord : orderOf x = 1 := by
    have h1 : orderOf x ∣ 3 := orderOf_dvd_of_pow_eq_one hx3
    have h2 : orderOf x ∣ Nat.card N := orderOf_dvd_natCard x
    have : orderOf x ∣ Nat.gcd 3 (Nat.card N) := Nat.dvd_gcd h1 h2
    rw [hN] at this
    exact Nat.dvd_one.1 this
  have hx1 : x = 1 := orderOf_eq_one_iff.1 hord
  have : π τ = 1 := congrArg Subtype.val hx1
  exact (QuotientGroup.eq_one_iff τ).1 this

end Psu

theorem outDerived3_psuHighNe3 : OutDerived3At (fun t n p f => FamPsuGoodHigh t n p f ∧ p ≠ 3) := by
  intro P _ _ t n p f hadm ht hF hm τ hτ hτ3
  obtain ⟨⟨rfl, hn3, hdiv, -⟩, hp3⟩ := hF
  have hC : StatedClassicalModel P .PSU n p f := (lieModel_classical_iff (by decide)).mp hm
  obtain ⟨K, _, _, h, -, hq, ⟨e⟩⟩ := CFSG.RankThree.PartOne.FOC.exists_psu_model hC
  obtain ⟨N, -, hNcard, hNcomm⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.OuterDerived.exists_unitary_outer_diagonal h hn3 hq
  have hN : Nat.Coprime 3 (Nat.card N) := by
    have hcop : Nat.Coprime 3 (Nat.gcd n (p ^ f + 1)) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 hdiv
    exact Nat.Coprime.coprime_dvd_right hNcard hcop
  have h1 : MulAut.congr e τ ∈ innAutDerived
      (primeFormP h ((1 : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)) :=
    (mem_innAutDerived_congr e).2 hτ
  have h3 : (MulAut.congr e τ) ^ 3 = 1 := by rw [← map_pow, hτ3, map_one]
  exact (isInnerAut_congr e τ).1 (isInnerAut_of_outer_commutators N hN hNcomm h1 h3)

