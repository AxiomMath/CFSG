theorem orders_of_order_65 {G : Type*} [Group G] {g : G} (hg : orderOf g = 65) :
    orderOf (g ^ 13) = 5 ∧ orderOf (g ^ 5) = 13 := by
  constructor
  · rw [orderOf_pow' _ (by norm_num), hg]
    norm_num
  · rw [orderOf_pow' _ (by norm_num), hg]
    norm_num

theorem conj_pair_of_order_65 {G : Type*} [Group G] {g : G} (hg : orderOf g = 65) (m : G) :
    ∃ w y : G, w = m⁻¹ * g ^ 13 * m ∧ orderOf w = 5 ∧ orderOf y = 13 ∧ w * y = y * w := by
  obtain ⟨h1, h2⟩ := orders_of_order_65 hg
  refine ⟨m⁻¹ * g ^ 13 * m, m⁻¹ * g ^ 5 * m, rfl, ?_, ?_, ?_⟩
  · rw [orderOf_inv_mul_mul, h1]
  · rw [orderOf_inv_mul_mul, h2]
  · have hc : g ^ 13 * g ^ 5 = g ^ 5 * g ^ 13 := (Commute.pow_pow_self g 13 5).eq
    calc (m⁻¹ * g ^ 13 * m) * (m⁻¹ * g ^ 5 * m) = m⁻¹ * (g ^ 13 * g ^ 5) * m := by group
      _ = m⁻¹ * (g ^ 5 * g ^ 13) * m := by rw [hc]
      _ = (m⁻¹ * g ^ 5 * m) * (m⁻¹ * g ^ 13 * m) := by group

