theorem exists_fixed_cls (w y : CFSG.Sporadic.Fi24.J) (hwy : w * y = y * w) (hy13 : y ^ 13 = 1)
    (hcard : ¬ 13 ∣ Nat.card {i : Fin 306936 // w • i = i}) :
    ∃ i : Fin 306936, jR w * cls i = cls i * jR w ∧ jR y * cls i = cls i * jR y := by
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  let π : J →* Equiv.Perm (Fin 306936) := MulAction.toPermHom J (Fin 306936)
  have hπ : ∀ (g : J) (i : Fin 306936), π g i = g • i := fun g i => rfl
  have hfg : π w * π y = π y * π w := by rw [← map_mul, ← map_mul, hwy]
  have hg : π y ^ 13 = 1 := by rw [← map_pow, hy13, map_one]
  have hcard' : ¬ 13 ∣ Nat.card {i : Fin 306936 // π w i = i} := hcard
  obtain ⟨i, hwi, hyi⟩ := exists_common_fixed (π w) (π y) hfg hg hcard'
  exact ⟨i, (smul_eq_iff_commute w i).1 hwi, (smul_eq_iff_commute y i).1 hyi⟩

theorem noOrder65_J24 : NoOrder 65 ↥CFSG.Sporadic.Fi24.J := by
  have hfin : Finite J := finite_J
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  obtain ⟨e, he, f, hf, h5e, he1, h5f, hcomm, hpow, h36⟩ := Certificates.certificate17221
  rw [CFSG.Sporadic.Fi24.mem_seedGrp_iff] at he hf
  intro g hg
  obtain ⟨hs, -⟩ := orders_of_order_65 hg
  obtain ⟨m, a, ha, b, hb, hab, hw⟩ := exists_conj_sylow5 J he hf h5e he1 h5f hcomm hpow
    (m := 50208228367626468851712) (by rw [CFSG.Sporadic.Fi24.card_J]; norm_num) (by norm_num) hs
  obtain ⟨w, y', hwdef, hwo, hy'o, hwy⟩ := conj_pair_of_order_65 hg m
  have hcard : ¬ 13 ∣ Nat.card {i : Fin 306936 // w • i = i} := by
    rw [CFSG.Sporadic.Fi24.card_ptFix_eq, hwdef, hw, h36 a ha b hb hab]
    norm_num
  have hy'13 : y' ^ 13 = 1 := by
    have h := pow_orderOf_eq_one y'
    rw [hy'o] at h
    exact h
  obtain ⟨i, hwi, hyi⟩ := exists_fixed_cls w y' hwy hy'13 hcard
  obtain ⟨c, hc⟩ := CFSG.Sporadic.Fi24.exists_conj_eq_tR (CFSG.Sporadic.Fi24.cls_mem i)
  obtain ⟨n, hn'⟩ : ∃ n : R, n = (jR c)⁻¹ := ⟨_, rfl⟩
  have hnT : n⁻¹ * cls i * n = tR := by rw [hn', inv_inv]; exact hc
  obtain ⟨s₁, hs₁⟩ : ∃ s₁ : R, s₁ = n⁻¹ * jR w * n := ⟨_, rfl⟩
  obtain ⟨y₁, hy₁⟩ : ∃ y₁ : R, y₁ = n⁻¹ * jR y' * n := ⟨_, rfl⟩
  have hs₁o : orderOf s₁ = 5 := by
    rw [hs₁, orderOf_inv_mul_mul, orderOf_injective jR CFSG.Sporadic.Fi24.jR_injective, hwo]
  have hy₁o : orderOf y₁ = 13 := by
    rw [hy₁, orderOf_inv_mul_mul, orderOf_injective jR CFSG.Sporadic.Fi24.jR_injective, hy'o]
  have hs₁y₁ : s₁ * y₁ = y₁ * s₁ := by
    have h : jR w * jR y' = jR y' * jR w := by rw [← map_mul, ← map_mul, hwy]
    calc s₁ * y₁ = n⁻¹ * (jR w * jR y') * n := by rw [hs₁, hy₁]; group
      _ = n⁻¹ * (jR y' * jR w) * n := by rw [h]
      _ = y₁ * s₁ := by rw [hs₁, hy₁]; group
  have hs₁T : s₁ * tR = tR * s₁ := by
    rw [← hnT]
    calc s₁ * (n⁻¹ * cls i * n) = n⁻¹ * (jR w * cls i) * n := by rw [hs₁]; group
      _ = n⁻¹ * (cls i * jR w) * n := by rw [hwi]
      _ = n⁻¹ * cls i * n * s₁ := by rw [hs₁]; group
  have hy₁T : y₁ * tR = tR * y₁ := by
    rw [← hnT]
    calc y₁ * (n⁻¹ * cls i * n) = n⁻¹ * (jR y' * cls i) * n := by rw [hy₁]; group
      _ = n⁻¹ * (cls i * jR y') * n := by rw [hyi]
      _ = n⁻¹ * cls i * n * y₁ := by rw [hy₁]; group
  have hs₁M : s₁ ∈ MR :=
    CFSG.Sporadic.FischerOddCore.mem_MR_of_odd hs₁T (by rw [hs₁o]; decide)
  have hy₁M : y₁ ∈ MR :=
    CFSG.Sporadic.FischerOddCore.mem_MR_of_odd hy₁T (by rw [hy₁o]; decide)
  let s₀ : ↥MR := ⟨s₁, hs₁M⟩
  let y₀ : ↥MR := ⟨y₁, hy₁M⟩
  have hs₀o : orderOf s₀ = 5 := by rw [← Subgroup.orderOf_coe]; exact hs₁o
  have hy₀o : orderOf y₀ = 13 := by rw [← Subgroup.orderOf_coe]; exact hy₁o
  have hs₀y₀ : s₀ * y₀ = y₀ * s₀ := Subtype.ext hs₁y₁
  exact false_of_commuting_of_noOrder noOrder65_Fi23 (CFSG.Sporadic.Fi24.fi23EquivMR s₀)
    (CFSG.Sporadic.Fi24.fi23EquivMR y₀)
    (by rw [MulEquiv.orderOf_eq]; exact hs₀o) (by rw [MulEquiv.orderOf_eq]; exact hy₀o)
    (by rw [← map_mul, ← map_mul, hs₀y₀])

theorem noOrder65_Fi24prime : NoOrder 65 NativeSporadic.Fi24prime := fun g hg =>
  noOrder65_J24 (CFSG.Sporadic.Fi24.fi24EquivJ g) (by rw [MulEquiv.orderOf_eq]; exact hg)

