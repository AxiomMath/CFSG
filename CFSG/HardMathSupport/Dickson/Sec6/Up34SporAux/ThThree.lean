theorem th_l3Lcm : ∀ (r : ℕ) (ε : Bool) (e : ℕ), (e = 1 ∨ e = 3) → L3Cond r ε →
    L3Ord r ε ∣ 90745943887872000 * e → 63685439 < Nat.lcm (L3Ord r ε / e) (3 ^ 7 * 13) :=
  l3Lcm_of_check (B0 := 200) (by norm_num) (by norm_num) (by decide +kernel)

