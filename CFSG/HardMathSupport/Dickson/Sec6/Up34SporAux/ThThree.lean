theorem factorization_eq_one_of_dvd' {p c : ℕ} (hp : p.Prime) (hc : c ≠ 0) (h1 : p ∣ c)
    (h2 : ¬ p ^ 2 ∣ c) : c.factorization p = 1 := by
  have a := (hp.pow_dvd_iff_le_factorization hc).1 (by simpa using h1 : p ^ 1 ∣ c)
  have b : ¬ 2 ≤ c.factorization p := fun h => h2 ((hp.pow_dvd_iff_le_factorization hc).2 h)
  omega

theorem exists_conj_of_seven_local' {X : Type*} [Group X] [Finite X] {h0 s u g h : X}
    (hall : ∀ v : X, orderOf v = 7 → ∃ m : X, m * v * m⁻¹ = h0)
    (h3 : (Nat.card (Subgroup.centralizer ({h0} : Set X))).factorization 3 = 1)
    (hs : orderOf s = 3) (hu : orderOf u = 7) (hsu : s * u = u * s)
    (hg : orderOf g = 3) (hh : orderOf h = 7) (hgh : g * h = h * g) :
    ∃ z : X, ∃ k : ℕ, g = z * s ^ k * z⁻¹ := by
  haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  obtain ⟨m1, hm1⟩ := hall u hu
  obtain ⟨m2, hm2⟩ := hall h hh
  have hcomm : ∀ (m x y : X), m * x * m⁻¹ = y → ∀ w : X, w * x = x * w →
      (m * w * m⁻¹) * y = y * (m * w * m⁻¹) := by
    intro m x y hxy w hw
    rw [← hxy]
    calc m * w * m⁻¹ * (m * x * m⁻¹) = m * (w * x) * m⁻¹ := by group
      _ = m * (x * w) * m⁻¹ := by rw [hw]
      _ = m * x * m⁻¹ * (m * w * m⁻¹) := by group
  have hs1 : (m1 * s * m1⁻¹) * h0 = h0 * (m1 * s * m1⁻¹) := hcomm m1 u h0 hm1 s hsu
  have hg2 : (m2 * g * m2⁻¹) * h0 = h0 * (m2 * g * m2⁻¹) := hcomm m2 h h0 hm2 g hgh
  have hs1o : orderOf (m1 * s * m1⁻¹) = 3 := by
    rw [← MulAut.conj_apply m1 s, MulEquiv.orderOf_eq]; exact hs
  have hg2o : orderOf (m2 * g * m2⁻¹) = 3 := by
    rw [← MulAut.conj_apply m2 g, MulEquiv.orderOf_eq]; exact hg
  obtain ⟨c, hcK, k, hck⟩ := exists_mem_conj_pow_of_factorization_eq_one
    (K := Subgroup.centralizer ({h0} : Set X)) (p := 3) h3
    (Subgroup.mem_centralizer_singleton_iff.2 hs1)
    (Subgroup.mem_centralizer_singleton_iff.2 hg2) hs1o hg2o
  refine ⟨m2⁻¹ * c * m1, k, ?_⟩
  have hpow : (m1 * s * m1⁻¹) ^ k = m1 * s ^ k * m1⁻¹ := by
    have := map_pow (MulAut.conj m1) s k
    simpa [MulAut.conj_apply] using this.symm
  calc g = m2⁻¹ * (m2 * g * m2⁻¹) * m2 := by group
    _ = m2⁻¹ * (c * (m1 * s * m1⁻¹) ^ k * c⁻¹) * m2 := by rw [hck]
    _ = m2⁻¹ * (c * (m1 * s ^ k * m1⁻¹) * c⁻¹) * m2 := by rw [hpow]
    _ = (m2⁻¹ * c * m1) * s ^ k * (m2⁻¹ * c * m1)⁻¹ := by group

theorem exists_conj_of_pair {G : Type*} [Group G] [Finite G] {p : ℕ} [hp : Fact p.Prime]
    {x y z : G} (hcomm : x * y = y * x) (hx : x ^ p = 1) (hy : y ^ p = 1) (hx1 : x ≠ 1)
    (hpow : ∀ k < p, y ≠ x ^ k) (hfac : (Nat.card G).factorization p = 2)
    (hconj : ∀ i j : ℕ, i < p → j < p → i + j ≠ 0 → ∃ m : G, m * (x ^ i * y ^ j) = z * m)
    {s : G} (hs : orderOf s = p) : ∃ m : G, m * s * m⁻¹ = z := by
  have hG : ¬ p ^ 3 ∣ Nat.card G := by
    intro h
    have h0 : Nat.card G ≠ 0 := Nat.card_pos.ne'
    have := (hp.out.pow_dvd_iff_le_factorization h0).1 h
    omega
  have hQ := CommutingPair.card_closure_pair_eq_sq hcomm hx hy hx1 hpow hG
  have hQfull : Nat.card (Subgroup.closure ({x, y} : Set G)) =
      p ^ (Nat.card (⊤ : Subgroup G)).factorization p := by
    rw [hQ, Subgroup.card_top, hfac]
  obtain ⟨g, -, hgQ⟩ := Co3T.exists_conj_mem_of_full le_top hQfull (Subgroup.mem_top s) hs
  obtain ⟨i, hi, j, hj, hw⟩ := CommutingPair.exists_pow_mul_pow_of_mem hp.out.pos hcomm hx hy hgQ
  have hwo : orderOf (g⁻¹ * s * g) = p := by rw [CommutingPair.orderOf_inv_mul_mul, hs]
  have hij : i + j ≠ 0 := by
    intro h0
    have hi0 : i = 0 := by omega
    have hj0 : j = 0 := by omega
    rw [hi0, hj0, pow_zero, pow_zero, mul_one] at hw
    rw [hw, orderOf_one] at hwo
    exact hp.out.one_lt.ne hwo
  obtain ⟨m, hm⟩ := hconj i j hi hj hij
  refine ⟨m * g⁻¹, ?_⟩
  rw [← hw] at hm
  calc (m * g⁻¹) * s * (m * g⁻¹)⁻¹ = (m * (g⁻¹ * s * g)) * m⁻¹ := by group
    _ = z := by rw [hm]; group

@[expose] def L3LcmCheck (N a bound B0 : ℕ) : Bool :=
  (List.range B0).all fun i => [true, false].all fun ε => [1, 3].all fun e =>
    decide (l3CondB (i + 4) ε = true → L3Ord (i + 4) ε ∣ N * e →
      bound < Nat.lcm (L3Ord (i + 4) ε / e) a)

theorem l3Lcm_of_check {N a bound B0 : ℕ} (hN : 0 < N) (hB : 12 * N < (B0 + 4) ^ 8)
    (h : L3LcmCheck N a bound B0 = true) :
    ∀ (r : ℕ) (ε : Bool) (e : ℕ), (e = 1 ∨ e = 3) → L3Cond r ε → L3Ord r ε ∣ N * e →
      bound < Nat.lcm (L3Ord r ε / e) a := by
  intro r ε e he hc hdvd
  have hr4 : 4 ≤ r := by
    cases ε
    · exact le_trans (by norm_num) (hc.2 rfl).1
    · exact (hc.1 rfl).1
  have hle : L3Ord r ε ≤ N * e := Nat.le_of_dvd (by rcases he with rfl | rfl <;> omega) hdvd
  have hrB : r < B0 + 4 := by
    by_contra hge
    push Not at hge
    have h1 : (B0 + 4) ^ 8 ≤ r ^ 8 := Nat.pow_le_pow_left hge 8
    have h2 := L3Ord_pow_le hc
    have h3 : 4 * (N * e) ≤ 12 * N := by rcases he with rfl | rfl <;> omega
    omega
  have hall := List.all_eq_true.1 h (r - 4) (List.mem_range.2 (by omega))
  have h2 := List.all_eq_true.1 hall ε (by cases ε <;> simp)
  have h3 := List.all_eq_true.1 h2 e (by rcases he with rfl | rfl <;> simp)
  have hr : r - 4 + 4 = r := by omega
  rw [hr] at h3
  exact of_decide_eq_true h3 (l3CondB_of_cond hc) hdvd

theorem noL3Comp_of_lcm_bound {G : Type} [Group G] [Finite G] {C : Subgroup G} {a bound : ℕ}
    (ha : a ∣ Nat.card ↥C) (hle : Nat.card ↥C ≤ bound)
    (hN : ∀ (r : ℕ) (ε : Bool) (e : ℕ), (e = 1 ∨ e = 3) → L3Cond r ε →
      L3Ord r ε ∣ Nat.card G * e → bound < Nat.lcm (L3Ord r ε / e) a) : NoL3Comp C := by
  intro J hJ p hL
  obtain ⟨r, ε, e, he, hc, hcard⟩ := isL3Kind_card_forms hL
  have hdvdC : Nat.card (barOf 3 J) ∣ Nat.card ↥C :=
    (Subgroup.card_quotient_dvd_card _).trans (Subgroup.card_dvd_of_le hJ.1)
  have hdvdG : Nat.card (barOf 3 J) ∣ Nat.card G :=
    hdvdC.trans (Subgroup.card_subgroup_dvd_card C)
  have hL3 : L3Ord r ε ∣ Nat.card G * e := by
    rw [← hcard]
    exact Nat.mul_dvd_mul_right hdvdG e
  have h1 := hN r ε e he hc hL3
  have he0 : 0 < e := by rcases he with rfl | rfl <;> norm_num
  have hdiv : L3Ord r ε / e = Nat.card (barOf 3 J) := by
    rw [← hcard]
    exact Nat.mul_div_cancel _ he0
  rw [hdiv] at h1
  have h3 := Nat.le_of_dvd Nat.card_pos (Nat.lcm_dvd hdvdC ha)
  omega

theorem th_noL3Eq : NoL3Eq 90745943887872000 :=
