theorem four_le_card {ℓ f : ℕ} (hℓ : ℓ.Prime) (hf : 2 ≤ f) : 4 ≤ ℓ ^ f :=
  calc 4 = 2 ^ 2 := by norm_num
    _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
    _ ≤ ℓ ^ f := Nat.pow_le_pow_left hℓ.two_le f

theorem noL2Layer_of_fieldType (hO : LieOrderFormulasInput) {ℓ f : ℕ} [Fact ℓ.Prime] (hf : 1 ≤ f)
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = ℓ ^ f)
    (α : MulAut (adjointGroup Tag.D4 K)) (hα3 : α ^ 3 = 1) (g : adjointGroup Tag.D4 K)
    (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (hσ3 : σ ^ 3 = 1) (hσ1 : σ ≠ 1)
    (hαeq : α = MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K 0)) :
    NoL2Layer α := by
  have hℓ : ℓ.Prime := Fact.out
  haveI : CharP K ℓ := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
    hℓ hf hK
  obtain ⟨d, T, hd0, hdf, hT, hT3, hσT⟩ := exists_frobenius_of_cube hℓ hf K hK σ hσ3 hσ1
  rw [d4Graph_zero, mul_one] at hαeq
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    exact four_le_card hℓ (by omega)
  have hKd : Nat.card K = (ℓ ^ d) ^ 3 := by rw [hK, ← pow_mul, hdf]
  have hfix : Nat.card (fixSubfield T) = ℓ ^ d :=
    CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube hℓ hd0 hKd T hT
  have hfield : NoL2Layer (entrywiseAdjointAut Tag.D4 T) :=
    noL2Layer_entrywiseAdjointAut_D4 hO hℓ hd0 T hfix
  have hconj : ∀ (β : MulAut (adjointGroup Tag.D4 K)) (g' : adjointGroup Tag.D4 K)
      (a' : Fin Tag.D4.rank → Kˣ), β = MulAut.conj g' * exactNormalAut Tag.D4 K a' T 0 →
      β ^ 3 = 1 → NoL2Layer β := by
    intro β g' a' hβ hβ3
    obtain ⟨ψ, hψ⟩ := exists_conj_eq_entrywiseAdjointAut_D4 hK hK4 hd0 hdf T hT g' a' β hβ hβ3
    exact TriD4Aux.noL2Layer_of_conj ψ β (hψ ▸ hfield)
  rcases hσT with hσ | hσ
  · rw [hσ] at hαeq
    exact hconj α g a hαeq hα3
  · obtain ⟨g', a', hα2⟩ := sq_conj_mul_exactNormalAut g a σ
    have hσ2 : σ ^ 2 = T := by
      rw [hσ, ← pow_mul, show 2 * 2 = 3 + 1 from rfl, pow_succ, hT3, one_mul]
    rw [hσ2, ← hαeq] at hα2
    have hα23 : (α ^ 2) ^ 3 = 1 := by rw [← pow_mul, mul_comm, pow_mul, hα3, one_pow]
    have hα22 : (α ^ 2) ^ 2 = α := by
      rw [← pow_mul, show 2 * 2 = 3 + 1 from rfl, pow_succ, hα3, one_mul]
    have hfixeq : fixSubgroup α = fixSubgroup (α ^ 2) := fixedSubgroup_pow_eq hα22
    exact noL2Layer_of_fixSubgroup_eq hfixeq (hconj (α ^ 2) g' a' hα2 hα23)

theorem noL2Layer_of_graphFieldType {ℓ f : ℕ} [Fact ℓ.Prime] (hf : 1 ≤ f)
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = ℓ ^ f)
    (α : MulAut (adjointGroup Tag.D4 K)) (hα3 : α ^ 3 = 1) (g : adjointGroup Tag.D4 K)
    (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (ε : ℕ) (hε : ε < 3) (hε0 : ε ≠ 0)
    (hσ3 : σ ^ 3 = 1) (hσ1 : σ ≠ 1)
    (hαeq : α = MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε)) :
    NoL2Layer α := by
  have hℓ : ℓ.Prime := Fact.out
  haveI : CharP K ℓ := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
    hℓ hf hK
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hord : orderOf σ = 3 := orderOf_eq_prime hσ3 hσ1
  obtain ⟨e, T, he, hef, hT, hσT⟩ := exists_frobenius_eq_or_inv_of_orderOf_three hℓ hf K hK σ hord
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    exact four_le_card hℓ (by omega)
  have hKe : Nat.card K = (ℓ ^ e) ^ 3 := by rw [hK, ← pow_mul, hef]
  have hε' : ε = 1 ∨ ε = 2 := by omega
  rcases hσT with hσ | hσ
  · rw [hσ] at hαeq
    obtain ⟨ψ, hψ⟩ :=
      exists_conj_eq_twistedEntrywiseAut_of_normalForm K hK hK4 he hef T hT α hα3 g a ε hαeq
    refine TriD4Aux.noL2Layer_of_conj ψ α ?_
    rw [hψ]
    exact noL2Layer_twistedEntrywiseAut_D4 hℓ he hKe T hT (ε : ℤ) (by omega)
  · rw [hσ] at hαeq
    obtain ⟨ψ, hψ⟩ := exists_conj_inv_eq_twistedEntrywiseAut_of_normalForm K hK hK4 he hef T T⁻¹
      hT (mul_inv_cancel T) α hα3 g a ε hαeq
    have hshift : twistedEntrywiseAut TwistTag.D4 (-(ε : ℤ)) T =
        twistedEntrywiseAut TwistTag.D4 (3 - (ε : ℤ)) T := by
      have h := twistedEntrywiseAut_add_mul_order TwistTag.D4 (-(ε : ℤ)) 1 T
      rw [show -(ε : ℤ) + 1 * ((TwistTag.D4.order : ℕ) : ℤ) = 3 - (ε : ℤ) by
        change -(ε : ℤ) + 1 * 3 = _
        ring] at h
      exact h.symm
    have hinv : NoL2Layer α⁻¹ := by
      refine TriD4Aux.noL2Layer_of_conj ψ α⁻¹ ?_
      rw [hψ, hshift]
      exact noL2Layer_twistedEntrywiseAut_D4 hℓ he hKe T hT (3 - (ε : ℤ)) (by omega)
    exact (TriD4Aux.noL2Layer_inv_iff α).1 hinv

theorem noL2Layer_adjointD4_outer (hO : LieOrderFormulasInput) (hA2 : TriD4Aux.TriD4A2NoL2)
    (hC3 : TriD4Aux.TriD4C3NoL2) {ℓ f : ℕ} [Fact ℓ.Prime] (hf : 1 ≤ f) (K : Type) [Field K]
    [Finite K] (hK : Nat.card K = ℓ ^ f) (α : MulAut (adjointGroup Tag.D4 K)) (hα3 : α ^ 3 = 1)
    (hα : α ∉ CFSG.ComponentClassification.OuterAutomorphisms.inner (adjointGroup Tag.D4 K)) : NoL2Layer α := by
  obtain ⟨g, a, σ, ε, hε, hαeq, hσ3, hcase⟩ := outer_cube_normal_form_cases α hα3 hα
  rcases hcase with ⟨hε0, hσ1⟩ | ⟨hε0, hσ1⟩ | ⟨hε0, hσ1⟩
  · subst hε0
    exact noL2Layer_of_fieldType hO hf K hK α hα3 g a σ hσ3 hσ1 hαeq
  · exact noL2Layer_of_graphFieldType hf K hK α hα3 g a σ ε hε hε0 hσ3 hσ1 hαeq
  · subst hσ1
    exact noL2Layer_of_graphType hA2 hC3 hf K hK α hα3 g a (by omega) hαeq

