variable {τ : Tag}

theorem pinnedX_commute_of_iform_nonneg
    (K : Type) [Field K] {α β : Fin τ.rank → ℤ}
    (hα : IsRoot τ α) (hβ : IsRoot τ β) (hne : α ≠ β) (h0 : 0 ≤ iform α β)
    (hp : ¬ IsRoot τ (α + β)) (c d : K) :
    pinnedX τ K α c * pinnedX τ K β d = pinnedX τ K β d * pinnedX τ K α c := by
  have hne' : α ≠ -β := by
    rintro rfl
    rw [iform_neg_left] at h0
    have := iform_self_pos_of_isRoot hβ
    omega
  obtain ⟨-, hmem, -, -, hF⟩ := root_commutator_formula τ hα hβ hne hne'
  have hnil : commPairs τ α β = [] := by
    rw [List.eq_nil_iff_forall_not_mem]
    intro p hp'
    obtain ⟨ha, hb, h⟩ := (hmem p).1 hp'
    have hn := iform_nsmul_add_nsmul p.1 p.2 α β
    obtain ⟨hα2, -⟩ := iform_self_bounds_of_isRoot hα
    obtain ⟨hβ2, -⟩ := iform_self_bounds_of_isRoot hβ
    obtain ⟨-, h6⟩ := iform_self_bounds_of_isRoot h
    by_cases h11 : p.1 = 1 ∧ p.2 = 1
    · obtain ⟨h1, h2⟩ := h11
      rw [h1, h2] at h
      exact hp (by simpa using h)
    have hA : (1 : ℤ) ≤ p.1 := by exact_mod_cast ha
    have hB : (1 : ℤ) ≤ p.2 := by exact_mod_cast hb
    have h1A : (1 : ℤ) ≤ (p.1 : ℤ) ^ 2 := by nlinarith
    have h1B : (1 : ℤ) ≤ (p.2 : ℤ) ^ 2 := by nlinarith
    have hab : (0 : ℤ) ≤ 2 * p.1 * p.2 * iform α β := by positivity
    rcases (show (2 : ℤ) ≤ p.1 ∨ (2 : ℤ) ≤ p.2 by omega) with h2 | h2
    · have h4 : (4 : ℤ) ≤ (p.1 : ℤ) ^ 2 := by nlinarith
      nlinarith [mul_le_mul h4 hα2 (by norm_num) (by positivity),
        mul_le_mul h1B hβ2 (by norm_num) (by positivity)]
    · have h4 : (4 : ℤ) ≤ (p.2 : ℤ) ^ 2 := by nlinarith
      nlinarith [mul_le_mul h4 hβ2 (by norm_num) (by positivity),
        mul_le_mul h1A hα2 (by norm_num) (by positivity)]
  have h := hF K c d
  rw [hnil, List.map_nil, List.prod_nil, ← pinnedX_neg, ← pinnedX_neg] at h
  calc pinnedX τ K α c * pinnedX τ K β d =
        (pinnedX τ K α c * pinnedX τ K β d * (pinnedX τ K α c)⁻¹ * (pinnedX τ K β d)⁻¹) *
          pinnedX τ K β d * pinnedX τ K α c := by group
    _ = pinnedX τ K β d * pinnedX τ K α c := by rw [h, one_mul]

end Commute

section Signs

def allSigns : (n : ℕ) → List (Fin n → Bool)
  | 0 => [fun i => i.elim0]
  | n + 1 => (allSigns n).flatMap fun s => [Fin.cons false s, Fin.cons true s]

theorem mem_allSigns : ∀ (n : ℕ) (s : Fin n → Bool), s ∈ allSigns n
  | 0, s => by
    have : s = fun i => i.elim0 := funext fun i => i.elim0
    simp [allSigns, this]
  | n + 1, s => by
    rw [allSigns, List.mem_flatMap]
    refine ⟨Fin.tail s, mem_allSigns n _, ?_⟩
    rcases h : s 0 with _ | _
    · simp only [List.mem_cons, List.not_mem_nil, or_false]
      left
      rw [← h]
      exact (Fin.cons_self_tail s).symm
    · simp only [List.mem_cons, List.not_mem_nil, or_false]
      right
      rw [← h]
      exact (Fin.cons_self_tail s).symm

def vecOf (τ : Tag) (l : List ℤ) : Fin τ.rank → ℤ := fun i => l.getD i 0

def signOdd (τ : Tag) (s : Fin τ.rank → Bool) (v : Fin τ.rank → ℤ) : Bool :=
  decide ((∑ k, if s k = true then v k else 0) % 2 = 1)

def pairOK (τ : Tag) (s : Fin τ.rank → Bool) (p : List ℤ × List ℤ) : Bool :=
  signOdd τ s (vecOf τ p.1) && signOdd τ s (vecOf τ p.2) &&
    RootOps.isRootB τ (vecOf τ p.1) && RootOps.isRootB τ (vecOf τ p.2) &&
    decide (0 < height (vecOf τ p.1)) && decide (0 < height (vecOf τ p.2)) &&
    decide (vecOf τ p.1 ≠ vecOf τ p.2) &&
    decide (0 ≤ iform (vecOf τ p.1) (vecOf τ p.2)) &&
    !RootOps.isRootB τ (vecOf τ p.1 + vecOf τ p.2)

def signCheck (τ : Tag) (table : List (List ℤ × List ℤ)) : Bool :=
  ((allSigns τ.rank).zip table).all fun x =>
    (List.finRange τ.rank).all (fun k => !x.1 k) || pairOK τ x.1 x.2

theorem exists_mem_zip {α β : Type} :
    ∀ (l : List α) (m : List β), l.length ≤ m.length → ∀ a ∈ l, ∃ b, (a, b) ∈ l.zip m
  | [], _, _, a, ha => by simp at ha
  | x :: l, [], h, _, _ => by simp at h
  | x :: l, y :: m, h, a, ha => by
    rcases List.mem_cons.1 ha with rfl | ha
    · exact ⟨y, by simp⟩
    · obtain ⟨b, hb⟩ := exists_mem_zip l m (by simpa using h) a ha
      exact ⟨b, by simp [hb]⟩

theorem exists_pair_of_signCheck
    {τ : Tag} {table : List (List ℤ × List ℤ)} (hc : signCheck τ table = true)
    (hl : (allSigns τ.rank).length ≤ table.length) (s : Fin τ.rank → Bool)
    (hs : ∃ k, s k = true) :
    ∃ α β : Fin τ.rank → ℤ, IsRoot τ α ∧ IsRoot τ β ∧ 0 < height α ∧ 0 < height β ∧
      α ≠ β ∧ 0 ≤ iform α β ∧ ¬ IsRoot τ (α + β) ∧
      Odd (∑ k, if s k = true then α k else 0) ∧ Odd (∑ k, if s k = true then β k else 0) := by
  obtain ⟨p, hp⟩ := exists_mem_zip _ _ hl s (mem_allSigns _ s)
  have h1 := List.all_eq_true.1 hc _ hp
  simp only [Bool.or_eq_true, List.all_eq_true, List.mem_finRange, forall_const,
    Bool.not_eq_eq_eq_not, Bool.not_true] at h1
  rcases h1 with h1 | h1
  · obtain ⟨k, hk⟩ := hs
    simp [h1 k] at hk
  · simp only [pairOK, signOdd, Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true',
      RootOps.isRootB_iff] at h1
    obtain ⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩ := h1
    refine ⟨vecOf τ p.1, vecOf τ p.2, h3, h4, h5, h6, h7, h8, ?_, ?_, ?_⟩
    · rw [← RootOps.isRootB_iff, h9]
      exact Bool.false_ne_true
    · exact Int.odd_iff.2 h1
    · exact Int.odd_iff.2 h2

theorem prod_zpow_sum {ι G : Type*} [CommGroup G] (g : G) (s : Finset ι) (f : ι → ℤ) :
    ∏ i ∈ s, g ^ f i = g ^ ∑ i ∈ s, f i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih => rw [Finset.prod_insert hi, Finset.sum_insert hi, zpow_add, ih]

open Classical in
theorem rootChar_eq_neg_one_of_odd {L : Type} [Field L] {τ : Tag} (a : Fin τ.rank → Lˣ)
    (ha : ∀ i, a i = 1 ∨ a i = -1) (v : Fin τ.rank → ℤ)
    (h : Odd (∑ k, if a k = -1 then v k else 0)) : rootChar a v = -1 := by
  classical
  have : rootChar a v = (-1 : Lˣ) ^ (∑ k, if a k = -1 then v k else 0) := by
    rw [rootChar, ← prod_zpow_sum]
    refine Finset.prod_congr rfl fun k _ => ?_
    by_cases hk : a k = -1
    · simp [hk]
    · rw [show (if a k = -1 then v k else 0) = 0 by simp [hk], zpow_zero]
      rcases ha k with h1 | h1
      · rw [h1, one_zpow]
      · exact absurd h1 hk
  rw [this]
  exact h.neg_one_zpow

theorem exists_pair_rootChar
    {τ : Tag} {table : List (List ℤ × List ℤ)} (hc : signCheck τ table = true)
    (hl : (allSigns τ.rank).length ≤ table.length) {L : Type} [Field L]
    (a : Fin τ.rank → Lˣ) (ha : ∀ i, a i = 1 ∨ a i = -1) (ha1 : a ≠ 1) :
    ∃ α β : Fin τ.rank → ℤ, IsRoot τ α ∧ IsRoot τ β ∧ 0 < height α ∧ 0 < height β ∧
      α ≠ β ∧ 0 ≤ iform α β ∧ ¬ IsRoot τ (α + β) ∧ rootChar a α = -1 ∧ rootChar a β = -1 := by
  classical
  obtain ⟨k, hk⟩ : ∃ k, a k ≠ 1 := by
    by_contra h
    exact ha1 (funext fun i => by_contra fun hi => h ⟨i, hi⟩)
  have hk' : a k = -1 := (ha k).resolve_left hk
  obtain ⟨α, β, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := exists_pair_of_signCheck hc hl
    (fun k => decide (a k = -1)) ⟨k, by simp [hk']⟩
  refine ⟨α, β, h1, h2, h3, h4, h5, h6, h7, ?_, ?_⟩
  · refine rootChar_eq_neg_one_of_odd a ha α ?_
    simpa using h8
  · refine rootChar_eq_neg_one_of_odd a ha β ?_
    simpa using h9


