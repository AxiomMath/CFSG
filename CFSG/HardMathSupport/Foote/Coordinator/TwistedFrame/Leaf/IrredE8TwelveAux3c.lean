@[expose] def wpH (u : W8) : W8 :=
  TwClass.wordE8Twelve.foldr (reflect Tag.E8) u

theorem deg1_data : (∀ ν ∈ deg1Roots, ν ∈ deg1L) ∧ (∀ ν ∈ deg1L, ν ∈ deg1Roots) ∧
    (∀ γ ∈ gensL, γ ∈ rootFinset .E8) := by
  decide +kernel

theorem list_data : (∀ γ ∈ gensL, γ 7 = 0) ∧ (∀ ν ∈ deg1L, ν 7 = 1) ∧ (∀ ν ∈ dlL, ν ∈ deg1L) ∧
    (∀ γ ∈ pos7L, γ ∈ gensL ∧ 1 ≤ height γ) ∧ (∀ ν ∈ dlL, 0 ≤ height ν ∧ height ν ≤ 29) ∧
    (∀ T ∈ topsL, T ∈ dlL) := by
  decide +kernel

theorem top_data : ∀ ν ∈ dlL, ν ∈ topsL ∨ ∃ γ ∈ pos7L, γ + ν ∈ deg1L := by
  decide +kernel

@[expose] def stepOK (R : List W8) : Bool × W8 × W8 → Bool
  | (true, μ, γ) => decide (μ ∈ R) && decide (γ ∈ gensL) && decide (μ ∈ deg1L) &&
      decide (γ + μ ∈ deg1L)
  | (false, μ, ν) => decide (μ ∈ R) && decide (μ ∈ dlL) && decide (wpH μ = ν)

@[expose] def stepTgt : Bool × W8 × W8 → W8
  | (true, μ, γ) => μ + γ
  | (false, _, ν) => ν

@[expose] def runSteps : List W8 → List (Bool × W8 × W8) → Option (List W8)
  | R, [] => some R
  | R, s :: ss => if stepOK R s then runSteps (stepTgt s :: R) ss else none

@[expose] def certOK (s : W8) (c : List (Bool × W8 × W8)) : Bool :=
  (runSteps [s] c).any fun R => dlL.all fun μ => decide (μ ∈ R)

theorem runSteps_sound (P : W8 → Prop)
    (hroot : ∀ μ γ, γ ∈ gensL → μ ∈ deg1L → γ + μ ∈ deg1L → P μ → P (μ + γ))
    (hweyl : ∀ μ, μ ∈ dlL → P μ → P (wpH μ)) :
    ∀ (ss : List (Bool × W8 × W8)) (R R' : List W8), (∀ μ ∈ R, P μ) →
      runSteps R ss = some R' → ∀ μ ∈ R', P μ := by
  intro ss
  induction ss with
  | nil =>
    intro R R' hR h
    simp only [runSteps, Option.some.injEq] at h
    subst h
    exact hR
  | cons s ss ih =>
    intro R R' hR h
    obtain ⟨b, μ₀, x⟩ := s
    unfold runSteps at h
    by_cases hs : stepOK R (b, μ₀, x) = true
    · rw [if_pos hs] at h
      refine ih _ R' ?_ h
      intro μ hμ
      rcases List.mem_cons.1 hμ with rfl | hμ
      · cases b with
        | false =>
          simp only [stepOK, Bool.and_eq_true, decide_eq_true_eq] at hs
          obtain ⟨⟨h1, h2⟩, h3⟩ := hs
          simp only [stepTgt]
          rw [← h3]
          exact hweyl μ₀ h2 (hR μ₀ h1)
        | true =>
          simp only [stepOK, Bool.and_eq_true, decide_eq_true_eq] at hs
          obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := hs
          exact hroot μ₀ x h2 h3 h4 (hR μ₀ h1)
      · exact hR μ hμ
    · rw [if_neg hs] at h
      exact absurd h (by simp)

theorem certOK_sound (P : W8 → Prop)
    (hroot : ∀ μ γ, γ ∈ gensL → μ ∈ deg1L → γ + μ ∈ deg1L → P μ → P (μ + γ))
    (hweyl : ∀ μ, μ ∈ dlL → P μ → P (wpH μ)) {s : W8} {c : List (Bool × W8 × W8)}
    (h : certOK s c = true) (hs : P s) : ∀ μ ∈ dlL, P μ := by
  unfold certOK at h
  obtain ⟨R, hR, hall⟩ := (Option.any_eq_true _ _).1 h
  have hP := runSteps_sound P hroot hweyl c [s] R (by simpa using hs) hR
  intro μ hμ
  exact hP μ (by simpa using List.all_eq_true.1 hall μ hμ)

