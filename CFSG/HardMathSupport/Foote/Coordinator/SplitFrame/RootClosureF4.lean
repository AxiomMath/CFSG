module

public import CFSG.Adapters.ProjectiveSpecialLinear
public import CFSG.Blueprint.ChevalleyRootArtifact
public import CFSG.LieType.Chevalley.RootCommutatorPairs

public section

namespace CFSG.HardMathSupport.Foote.Coordinator.SplitFrame

open CFSG.Blueprint CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley

set_option linter.unusedSectionVars false

namespace F4Closure

abbrev rootsL : List (List ℤ) := f4ArtifactRoots

def lin (a b : ℤ) (v w : List ℤ) : List ℤ := List.zipWith (fun x y => a * x + b * y) v w

def isR (v : List ℤ) : Bool := rootsL.contains v

def pairsL (v w : List ℤ) : List (ℕ × ℕ) :=
  commCandidates.filter fun p => isR (lin (p.1 : ℤ) (p.2 : ℤ) v w)

def inS (v : List ℤ) : Bool := v.getD 1 0 % 3 == 0

def S0 : List (List ℤ) := rootsL.filter inS

def stepOK (a b : List ℤ) (k : ℕ) : Bool :=
  a != b && !(isR (lin (-1) 1 a b)) &&
    ((k == 1 && pairsL a b == [(1, 1)]) ||
      (k == 2 && pairsL a b == [(1, 1), (1, 2)] && lin 1 1 a b != lin 1 2 a b &&
        lin 1 1 a b != lin (-1) (-2) a b && pairsL (lin 1 1 a b) (lin 1 2 a b) == []))

def stepNew (a b : List ℤ) (k : ℕ) : List (List ℤ) :=
  if k == 1 then [lin 1 1 a b] else [lin 1 1 a b, lin 1 2 a b]

def runSteps : List (List ℤ) → List (ℕ × ℕ × ℕ) → Option (List (List ℤ))
  | D, [] => some D
  | D, (i, j, k) :: L =>
    match D[i]?, D[j]? with
    | some a, some b => if stepOK a b k then runSteps (D ++ stepNew a b k) L else none
    | _, _ => none

def coverOK (β : List ℤ) (L : List (ℕ × ℕ × ℕ)) : Bool :=
  match runSteps (S0 ++ [β]) L with
  | some D => rootsL.all D.contains
  | none => false

