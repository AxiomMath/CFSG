@[expose] def minusQuandleSeq (a t : ℕ) : ℕ := (minusQuandleDeriv[a]!)[t]! % 65

@[expose] def minusQuandleCode (a t : ℕ) : ℕ := (minusQuandleDeriv[a]!)[t]! / 65

@[expose] def minusQuandleStep (a c' : ℕ) (acc : Array ℕ) (t : ℕ) : Array ℕ :=
  let p := minusQuandleSeq a t
  let code := minusQuandleCode a t
  let v := if code = 0 then p
    else if code = 1 then c'
    else minusQuandleT (acc[minusQuandleSeq a ((code - 2) / 65)]!)
      (acc[minusQuandleSeq a ((code - 2) % 65)]!)
  acc.set! p v

@[expose] def minusQuandleFoldFrom (a c' : ℕ) : ℕ → ℕ → Array ℕ → Array ℕ
  | 0, _, acc => acc
  | n + 1, m, acc => minusQuandleFoldFrom a c' n (m + 1) (minusQuandleStep a c' acc m)

@[expose] def minusQuandleMkD (a c' : ℕ) : Array ℕ :=
  minusQuandleFoldFrom a c' 65 0 (Array.replicate 65 0)

abbrev minusQuandleHomBad (d : Array ℕ) : Prop :=
  ∃ i j : Fin 65, d[minusQuandleT i j]! ≠ minusQuandleT (d[i]!) (d[j]!)

abbrev minusQuandlePerpOK (a : Fin 65) : Prop :=
  minusQuandleSeed[a]! < 65 ∧
  (∀ t : Fin 65, minusQuandleSeq a t < 65) ∧
  (∀ i j : Fin 65, minusQuandleSeq a i = minusQuandleSeq a j → i = j) ∧
  (∀ t : Fin 65, minusQuandleCode a t = 0 →
    minusQuandleT a (minusQuandleSeq a t) = minusQuandleSeq a t) ∧
  (∀ t : Fin 65, minusQuandleCode a t = 1 → minusQuandleSeq a t = minusQuandleSeed[a]!) ∧
  (∀ t : Fin 65, 2 ≤ minusQuandleCode a t →
    (minusQuandleCode a t - 2) / 65 < (t : ℕ) ∧ (minusQuandleCode a t - 2) % 65 < (t : ℕ) ∧
      minusQuandleT (minusQuandleSeq a ((minusQuandleCode a t - 2) / 65))
        (minusQuandleSeq a ((minusQuandleCode a t - 2) % 65)) = minusQuandleSeq a t) ∧
  (∀ c' : Fin 65, (c' : ℕ) = minusQuandleSeed[a]! ∨
    (c' : ℕ) = minusQuandleT a (minusQuandleSeed[a]!) ∨
    minusQuandleHomBad (minusQuandleMkD a c'))

abbrev minusQuandleNoncommProp : Prop := ∀ i : Fin 65, ∃ j : Fin 65, minusQuandleT i j ≠ j

@[expose] def minusQuandleNoncommCheck (_ : Unit := ()) : Bool :=
  (List.range 65).all fun i => (List.range 65).any fun j => minusQuandleT i j != j

@[expose] def minusQuandleStepF (K : Finset (Fin 65)) : Finset (Fin 65) :=
  K ∪ Finset.univ.biUnion (fun j : Fin 65 =>
    if ((K.image (minusQuandleTf j)) ∩ K).Nonempty then K.image (minusQuandleTf j) else ∅)

@[expose] def minusQuandleStepFast (K : Finset (Fin 65)) : Finset (Fin 65) :=
  K ∪ Finset.univ.biUnion (fun j : Fin 65 =>
    let I := K.image (minusQuandleTf j)
    if (I ∩ K).Nonempty then I else ∅)

theorem minusQuandleStepFast_eq : minusQuandleStepFast = minusQuandleStepF := rfl

abbrev minusQuandlePrimitiveProp : Prop :=
  ∀ a b : Fin 65, a ≠ b →
    Nat.iterate minusQuandleStepF 4 ({a, b} : Finset (Fin 65)) = Finset.univ

@[expose] def minusQuandlePrimitiveCheck (_ : Unit := ()) : Bool :=
  (List.range 65).all fun a => (List.range 65).all fun b =>
    if a == b then true
    else Nat.iterate minusQuandleStepFast 2
      ({Fin.ofNat 65 a, Fin.ofNat 65 b} : Finset (Fin 65)) == Finset.univ

@[expose] def minusQuandlePerpOKBool (a : Fin 65) : Bool :=
  decide (minusQuandleSeed[(a : ℕ)]! < 65) &&
  (List.range 65).all (fun t => decide (minusQuandleSeq (a : ℕ) t < 65)) &&
  (List.range 65).all (fun i => (List.range 65).all (fun j =>
    decide (minusQuandleSeq (a : ℕ) i = minusQuandleSeq (a : ℕ) j → i = j))) &&
  (List.range 65).all (fun t => decide (minusQuandleCode (a : ℕ) t = 0 →
    minusQuandleT (a : ℕ) (minusQuandleSeq (a : ℕ) t) = minusQuandleSeq (a : ℕ) t)) &&
  (List.range 65).all (fun t => decide (minusQuandleCode (a : ℕ) t = 1 →
    minusQuandleSeq (a : ℕ) t = minusQuandleSeed[(a : ℕ)]!)) &&
  (List.range 65).all (fun t => decide (2 ≤ minusQuandleCode (a : ℕ) t →
    (minusQuandleCode (a : ℕ) t - 2) / 65 < t ∧ (minusQuandleCode (a : ℕ) t - 2) % 65 < t ∧
      minusQuandleT (minusQuandleSeq (a : ℕ) ((minusQuandleCode (a : ℕ) t - 2) / 65))
        (minusQuandleSeq (a : ℕ) ((minusQuandleCode (a : ℕ) t - 2) % 65)) =
          minusQuandleSeq (a : ℕ) t)) &&
  (List.range 65).all (fun c' => decide ((c' : ℕ) = minusQuandleSeed[(a : ℕ)]! ∨
    (c' : ℕ) = minusQuandleT (a : ℕ) (minusQuandleSeed[(a : ℕ)]!) ∨
    minusQuandleHomBad (minusQuandleMkD (a : ℕ) c')))

@[expose] def minusQuandlePerpCheck (_ : Unit := ()) : Bool :=
  (List.range 65).all fun a => minusQuandlePerpOKBool (Fin.ofNat 65 a)

private theorem minusQuandleAll_range {p : ℕ → Bool} (h : (List.range 65).all p = true) :
    ∀ n < 65, p n = true :=
  fun n hn => List.all_eq_true.mp h n (List.mem_range.mpr hn)

theorem minusQuandleNoncommCheck_spec (h : minusQuandleNoncommCheck () = true) :
    minusQuandleNoncommProp := by
  intro i
  have h1 : ∀ n < 65, (List.range 65).any (fun j => minusQuandleT n j != j) = true := by
    simpa only [minusQuandleNoncommCheck, List.all_eq_true, List.mem_range] using h
  have h2 := h1 (i : ℕ) i.isLt
  rw [List.any_eq_true] at h2
  obtain ⟨j, hj, hne⟩ := h2
  exact ⟨⟨j, List.mem_range.mp hj⟩, by simpa [bne_iff_ne] using hne⟩

private theorem minusQuandleStepF_univ : minusQuandleStepF Finset.univ = Finset.univ := by
  apply Finset.eq_univ_of_forall
  intro x
  simp [minusQuandleStepF]

theorem minusQuandlePrimitiveCheck_spec (h : minusQuandlePrimitiveCheck () = true) :
    minusQuandlePrimitiveProp := by
  intro a b hab
  have h1 : ∀ n < 65, (List.range 65).all (fun m =>
      if n == m then true
      else Nat.iterate minusQuandleStepFast 2
        ({Fin.ofNat 65 n, Fin.ofNat 65 m} : Finset (Fin 65)) == Finset.univ) = true := by
    simpa only [minusQuandlePrimitiveCheck, List.all_eq_true, List.mem_range] using h
  have h2 := List.all_eq_true.mp (h1 (a : ℕ) a.isLt) (b : ℕ)
    (List.mem_range.mpr b.isLt)
  have hab' : ((a : ℕ) == (b : ℕ)) = false := by
    rw [beq_eq_false_iff_ne]
    intro hh
    exact hab (Fin.ext hh)
  have ha : (Fin.ofNat 65 (a : ℕ) : Fin 65) = a := by
    apply Fin.ext
    show (a : ℕ) % 65 = (a : ℕ)
    rw [Nat.mod_eq_of_lt a.isLt]
  have hb : (Fin.ofNat 65 (b : ℕ) : Fin 65) = b := by
    apply Fin.ext
    show (b : ℕ) % 65 = (b : ℕ)
    rw [Nat.mod_eq_of_lt b.isLt]
  have h2' : Nat.iterate minusQuandleStepF 2 ({a, b} : Finset (Fin 65)) = Finset.univ := by
    simpa [hab', ha, hb, minusQuandleStepFast_eq] using h2
  have huniv : ∀ n, Nat.iterate minusQuandleStepF n Finset.univ = Finset.univ := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih => rw [Function.iterate_succ_apply', ih, minusQuandleStepF_univ]
  calc Nat.iterate minusQuandleStepF 4 ({a, b} : Finset (Fin 65))
      = Nat.iterate minusQuandleStepF 2
          (Nat.iterate minusQuandleStepF 2 ({a, b} : Finset (Fin 65))) := by
          rw [show (4 : ℕ) = 2 + 2 by norm_num, Function.iterate_add_apply]
    _ = Nat.iterate minusQuandleStepF 2 Finset.univ := by rw [h2']
    _ = Finset.univ := huniv 2

theorem minusQuandlePerpOKBool_spec {a : Fin 65} (h : minusQuandlePerpOKBool a = true) :
    minusQuandlePerpOK a := by
  rw [minusQuandlePerpOKBool] at h
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨hseed, hseq⟩, hinj⟩, hc0⟩, hc1⟩, hder⟩, hhom⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact of_decide_eq_true hseed
  · intro t
    exact of_decide_eq_true (minusQuandleAll_range hseq t t.isLt)
  · intro i j hij
    have h1 := minusQuandleAll_range hinj i i.isLt
    exact Fin.ext (of_decide_eq_true (minusQuandleAll_range h1 j j.isLt) hij)
  · intro t hcode
    exact of_decide_eq_true (minusQuandleAll_range hc0 t t.isLt) hcode
  · intro t hcode
    exact of_decide_eq_true (minusQuandleAll_range hc1 t t.isLt) hcode
  · intro t hle
    exact of_decide_eq_true (minusQuandleAll_range hder t t.isLt) hle
  · intro c'
    exact of_decide_eq_true (minusQuandleAll_range hhom c' c'.isLt)

theorem minusQuandlePerpCheck_spec (h : minusQuandlePerpCheck () = true) :
    ∀ a : Fin 65, minusQuandlePerpOK a := by
  intro a
  have h1 : ∀ n < 65, minusQuandlePerpOKBool (Fin.ofNat 65 n) = true := by
    simpa only [minusQuandlePerpCheck, List.all_eq_true, List.mem_range] using h
  have h2 := h1 (a : ℕ) a.isLt
  have ha : (Fin.ofNat 65 (a : ℕ) : Fin 65) = a := by
    apply Fin.ext
    show (a : ℕ) % 65 = (a : ℕ)
    rw [Nat.mod_eq_of_lt a.isLt]
  rw [ha] at h2
  exact minusQuandlePerpOKBool_spec h2

theorem minusQuandleFoldFrom_add (a c' n₁ n₂ m : ℕ) (acc : Array ℕ) :
    minusQuandleFoldFrom a c' (n₁ + n₂) m acc =
      minusQuandleFoldFrom a c' n₂ (m + n₁) (minusQuandleFoldFrom a c' n₁ m acc) := by
  induction n₁ generalizing m acc with
  | zero => simp [minusQuandleFoldFrom]
  | succ n₁ ih =>
    have e : n₁ + 1 + n₂ = (n₁ + n₂) + 1 := by omega
    rw [e]
    simp only [minusQuandleFoldFrom]
    rw [ih (m + 1) (minusQuandleStep a c' acc m)]
    congr 1
    omega

theorem minusQuandleFoldFrom_preserve (a c' n m : ℕ) (acc : Array ℕ) (p : ℕ)
    (h : ∀ i, m ≤ i → i < m + n → minusQuandleSeq a i ≠ p) :
    (minusQuandleFoldFrom a c' n m acc)[p]! = acc[p]! := by
  induction n generalizing m acc with
  | zero => simp [minusQuandleFoldFrom]
  | succ n ih =>
    rw [minusQuandleFoldFrom]
    rw [ih (m + 1) (minusQuandleStep a c' acc m)]
    · dsimp only [minusQuandleStep]
      exact Array.getElem!_set!_ne acc (minusQuandleSeq a m) p _ (h m le_rfl (by omega))
    · intro i hi1 hi2
      exact h i (by omega) (by omega)

theorem minusQuandleFoldFrom_size (a c' n m : ℕ) (acc : Array ℕ) :
    (minusQuandleFoldFrom a c' n m acc).size = acc.size := by
  induction n generalizing m acc with
  | zero => rfl
  | succ n ih =>
    rw [minusQuandleFoldFrom, ih]
    simp only [minusQuandleStep, Array.size_set!]

theorem minusQuandleMkD_get (a c' t : ℕ) (ht : t < 65) (hseq : minusQuandleSeq a t < 65)
    (hinj : ∀ i j, i < 65 → j < 65 → minusQuandleSeq a i = minusQuandleSeq a j → i = j)
    (hsrc : 2 ≤ minusQuandleCode a t →
      (minusQuandleCode a t - 2) / 65 < t ∧ (minusQuandleCode a t - 2) % 65 < t) :
    (minusQuandleMkD a c')[minusQuandleSeq a t]! =
      (if minusQuandleCode a t = 0 then minusQuandleSeq a t
       else if minusQuandleCode a t = 1 then c'
       else minusQuandleT
         ((minusQuandleMkD a c')[minusQuandleSeq a ((minusQuandleCode a t - 2) / 65)]!)
         ((minusQuandleMkD a c')[minusQuandleSeq a ((minusQuandleCode a t - 2) % 65)]!)) := by
  set X := minusQuandleFoldFrom a c' t 0 (Array.replicate 65 0) with hX
  have h1 : minusQuandleMkD a c' = minusQuandleFoldFrom a c' (65 - t) t X := by
    have h := minusQuandleFoldFrom_add a c' t (65 - t) 0 (Array.replicate 65 0)
    rw [show t + (65 - t) = 65 by omega] at h
    rw [minusQuandleMkD, h, hX, Nat.zero_add]
  have h2 : minusQuandleFoldFrom a c' (65 - t) t X =
      minusQuandleFoldFrom a c' (65 - (t + 1)) (t + 1) (minusQuandleStep a c' X t) := by
    have h := minusQuandleFoldFrom_add a c' 1 (65 - (t + 1)) t X
    rw [show 1 + (65 - (t + 1)) = 65 - t by omega] at h
    rw [h]
    rfl
  have h3 : (minusQuandleFoldFrom a c' (65 - (t + 1)) (t + 1) (minusQuandleStep a c' X t))[
      minusQuandleSeq a t]! = (minusQuandleStep a c' X t)[minusQuandleSeq a t]! := by
    apply minusQuandleFoldFrom_preserve
    intro i hi1 hi2 heq
    exact absurd (hinj i t (by omega) ht heq) (by omega)
  have h4 : ∀ y, y < t →
      (minusQuandleMkD a c')[minusQuandleSeq a y]! = X[minusQuandleSeq a y]! := by
    intro y hy
    rw [h1]
    apply minusQuandleFoldFrom_preserve
    intro i hi1 hi2 heq
    exact absurd (hinj i y (by omega) (by omega) heq) (by omega)
  conv_lhs => rw [h1, h2, h3]
  dsimp only [minusQuandleStep]
  rw [Array.getElem!_set!_self]
  · by_cases hc0 : minusQuandleCode a t = 0
    · rw [if_pos hc0, if_pos hc0]
    · rw [if_neg hc0, if_neg hc0]
      by_cases hc1 : minusQuandleCode a t = 1
      · rw [if_pos hc1, if_pos hc1]
      · rw [if_neg hc1, if_neg hc1]
        obtain ⟨hx, hy⟩ := hsrc (by omega)
        rw [← h4 ((minusQuandleCode a t - 2) / 65) hx,
          ← h4 ((minusQuandleCode a t - 2) % 65) hy]
  · rw [hX, minusQuandleFoldFrom_size]
    simpa using hseq

end CFSG.OddTranspositions.PartThree
