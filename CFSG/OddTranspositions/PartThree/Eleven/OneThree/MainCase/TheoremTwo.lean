namespace CFSG.OddTranspositions.PartThree.ElevenThree

open CFSG.Timmesfeld.Bridge.Asc72 CFSG.Timmesfeld.Connectivity CFSG.OddTranspositions.QZ
open CFSG.OddTranspositions.PartFour

variable {G : Type} [Group G] [Finite G] {D : Set G}


namespace MainHyp

variable {hC : HypothesisC D}

theorem not_localSecond (h : MainHyp hC) : ¬ LocalSecond D := by
  intro hL
  rcases aschbacherTheoremTwo_holds (G := G) (D := D) hC.setup hC hL h.rad with h3 | hO4
  · exact h.not_three h3
  · exact h.not_o4 hO4

theorem not_isSolvable (h : MainHyp hC) : ¬ Group.IsSolvable (Halpha D hC.alpha) :=
  fun hs => h.not_localSecond (localSecond_of_isSolvable_Halpha hC hs)

end MainHyp

end CFSG.OddTranspositions.PartThree.ElevenThree
