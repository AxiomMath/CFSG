@[expose] def plusQuandleSeq (a t : ℕ) : ℕ := (plusQuandleDeriv[a]!)[t]! % 60

@[expose] def plusQuandleCode (a t : ℕ) : ℕ := (plusQuandleDeriv[a]!)[t]! / 60

@[expose] def plusQuandleStep (a c' : ℕ) (acc : Array ℕ) (t : ℕ) : Array ℕ :=
  let p := plusQuandleSeq a t
  let code := plusQuandleCode a t
  let v := if code = 0 then p
    else if code = 1 then c'
    else plusQuandleT (acc[plusQuandleSeq a ((code - 2) / 60)]!)
      (acc[plusQuandleSeq a ((code - 2) % 60)]!)
  acc.set! p v

@[expose] def plusQuandleFoldFrom (a c' : ℕ) : ℕ → ℕ → Array ℕ → Array ℕ
  | 0, _, acc => acc
  | n + 1, m, acc => plusQuandleFoldFrom a c' n (m + 1) (plusQuandleStep a c' acc m)

@[expose] def plusQuandleMkD (a c' : ℕ) : Array ℕ :=
  plusQuandleFoldFrom a c' 60 0 (Array.replicate 60 0)

abbrev plusQuandleHomBad (d : Array ℕ) : Prop :=
  ∃ i j : Fin 60, d[plusQuandleT i j]! ≠ plusQuandleT (d[i]!) (d[j]!)

abbrev plusQuandlePerpOK (a : Fin 60) : Prop :=
  plusQuandleSeed[a]! < 60 ∧
  (∀ t : Fin 60, plusQuandleSeq a t < 60) ∧
  (∀ i j : Fin 60, plusQuandleSeq a i = plusQuandleSeq a j → i = j) ∧
  (∀ t : Fin 60, plusQuandleCode a t = 0 →
    plusQuandleT a (plusQuandleSeq a t) = plusQuandleSeq a t) ∧
  (∀ t : Fin 60, plusQuandleCode a t = 1 → plusQuandleSeq a t = plusQuandleSeed[a]!) ∧
  (∀ t : Fin 60, 2 ≤ plusQuandleCode a t →
    (plusQuandleCode a t - 2) / 60 < (t : ℕ) ∧ (plusQuandleCode a t - 2) % 60 < (t : ℕ) ∧
      plusQuandleT (plusQuandleSeq a ((plusQuandleCode a t - 2) / 60))
        (plusQuandleSeq a ((plusQuandleCode a t - 2) % 60)) = plusQuandleSeq a t) ∧
  (∀ c' : Fin 60, (c' : ℕ) = plusQuandleSeed[a]! ∨ (c' : ℕ) = plusQuandleT a (plusQuandleSeed[a]!) ∨
    plusQuandleHomBad (plusQuandleMkD a c'))

abbrev plusQuandleNoncommProp : Prop := ∀ i : Fin 60, ∃ j : Fin 60, plusQuandleT i j ≠ j

@[expose] def plusQuandleNoncommCheck (_ : Unit := ()) : Bool :=
  (List.range 60).all fun i => (List.range 60).any fun j => plusQuandleT i j != j

@[expose] def plusQuandleStepF (K : Finset (Fin 60)) : Finset (Fin 60) :=
  K ∪ Finset.univ.biUnion (fun j : Fin 60 =>
    if ((K.image (plusQuandleTf j)) ∩ K).Nonempty then K.image (plusQuandleTf j) else ∅)

@[expose] def plusQuandleStepFast (K : Finset (Fin 60)) : Finset (Fin 60) :=
  K ∪ Finset.univ.biUnion (fun j : Fin 60 =>
    let I := K.image (plusQuandleTf j)
    if (I ∩ K).Nonempty then I else ∅)

theorem plusQuandleStepFast_eq : plusQuandleStepFast = plusQuandleStepF := rfl

abbrev plusQuandlePrimitiveProp : Prop :=
  ∀ a b : Fin 60, a ≠ b →
    Nat.iterate plusQuandleStepF 4 ({a, b} : Finset (Fin 60)) = Finset.univ

@[expose] def plusQuandlePrimitiveCheck (_ : Unit := ()) : Bool :=
  (List.range 60).all fun a => (List.range 60).all fun b =>
    if a == b then true
    else Nat.iterate plusQuandleStepFast 2
      ({Fin.ofNat 60 a, Fin.ofNat 60 b} : Finset (Fin 60)) == Finset.univ

@[expose] def plusQuandlePerpOKBool (a : Fin 60) : Bool :=
  decide (plusQuandleSeed[(a : ℕ)]! < 60) &&
  (List.range 60).all (fun t => decide (plusQuandleSeq (a : ℕ) t < 60)) &&
  (List.range 60).all (fun i => (List.range 60).all (fun j =>
    decide (plusQuandleSeq (a : ℕ) i = plusQuandleSeq (a : ℕ) j → i = j))) &&
  (List.range 60).all (fun t => decide (plusQuandleCode (a : ℕ) t = 0 →
    plusQuandleT (a : ℕ) (plusQuandleSeq (a : ℕ) t) = plusQuandleSeq (a : ℕ) t)) &&
  (List.range 60).all (fun t => decide (plusQuandleCode (a : ℕ) t = 1 →
    plusQuandleSeq (a : ℕ) t = plusQuandleSeed[(a : ℕ)]!)) &&
  (List.range 60).all (fun t => decide (2 ≤ plusQuandleCode (a : ℕ) t →
    (plusQuandleCode (a : ℕ) t - 2) / 60 < t ∧ (plusQuandleCode (a : ℕ) t - 2) % 60 < t ∧
      plusQuandleT (plusQuandleSeq (a : ℕ) ((plusQuandleCode (a : ℕ) t - 2) / 60))
        (plusQuandleSeq (a : ℕ) ((plusQuandleCode (a : ℕ) t - 2) % 60)) =
          plusQuandleSeq (a : ℕ) t)) &&
  (List.range 60).all (fun c' => decide ((c' : ℕ) = plusQuandleSeed[(a : ℕ)]! ∨
    (c' : ℕ) = plusQuandleT (a : ℕ) (plusQuandleSeed[(a : ℕ)]!) ∨
    plusQuandleHomBad (plusQuandleMkD (a : ℕ) c')))

@[expose] def plusQuandlePerpCheck (_ : Unit := ()) : Bool :=
  (List.range 60).all fun a => plusQuandlePerpOKBool (Fin.ofNat 60 a)

private theorem plusQuandleAll_range {p : ℕ → Bool} (h : (List.range 60).all p = true) :
    ∀ n < 60, p n = true :=
  fun n hn => List.all_eq_true.mp h n (List.mem_range.mpr hn)

theorem plusQuandleNoncommCheck_spec (h : plusQuandleNoncommCheck () = true) :
    plusQuandleNoncommProp := by
  intro i
  have h1 : ∀ n < 60, (List.range 60).any (fun j => plusQuandleT n j != j) = true := by
    simpa only [plusQuandleNoncommCheck, List.all_eq_true, List.mem_range] using h
  have h2 := h1 (i : ℕ) i.isLt
  rw [List.any_eq_true] at h2
  obtain ⟨j, hj, hne⟩ := h2
  exact ⟨⟨j, List.mem_range.mp hj⟩, by simpa [bne_iff_ne] using hne⟩

private theorem plusQuandleStepF_univ : plusQuandleStepF Finset.univ = Finset.univ := by
  apply Finset.eq_univ_of_forall
  intro x
  simp [plusQuandleStepF]

theorem plusQuandlePrimitiveCheck_spec (h : plusQuandlePrimitiveCheck () = true) :
    plusQuandlePrimitiveProp := by
  intro a b hab
  have h1 : ∀ n < 60, (List.range 60).all (fun m =>
      if n == m then true
      else Nat.iterate plusQuandleStepFast 2
        ({Fin.ofNat 60 n, Fin.ofNat 60 m} : Finset (Fin 60)) == Finset.univ) = true := by
    simpa only [plusQuandlePrimitiveCheck, List.all_eq_true, List.mem_range] using h
  have h2 := List.all_eq_true.mp (h1 (a : ℕ) a.isLt) (b : ℕ)
    (List.mem_range.mpr b.isLt)
  have hab' : ((a : ℕ) == (b : ℕ)) = false := by
    rw [beq_eq_false_iff_ne]
    intro hh
    exact hab (Fin.ext hh)
  have ha : (Fin.ofNat 60 (a : ℕ) : Fin 60) = a := by
    apply Fin.ext
    show (a : ℕ) % 60 = (a : ℕ)
    rw [Nat.mod_eq_of_lt a.isLt]
  have hb : (Fin.ofNat 60 (b : ℕ) : Fin 60) = b := by
    apply Fin.ext
    show (b : ℕ) % 60 = (b : ℕ)
    rw [Nat.mod_eq_of_lt b.isLt]
  have h2' : Nat.iterate plusQuandleStepF 2 ({a, b} : Finset (Fin 60)) = Finset.univ := by
    simpa [hab', ha, hb, plusQuandleStepFast_eq] using h2
  have huniv : ∀ n, Nat.iterate plusQuandleStepF n Finset.univ = Finset.univ := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih => rw [Function.iterate_succ_apply', ih, plusQuandleStepF_univ]
  calc Nat.iterate plusQuandleStepF 4 ({a, b} : Finset (Fin 60))
      = Nat.iterate plusQuandleStepF 2
          (Nat.iterate plusQuandleStepF 2 ({a, b} : Finset (Fin 60))) := by
          rw [show (4 : ℕ) = 2 + 2 by norm_num, Function.iterate_add_apply]
    _ = Nat.iterate plusQuandleStepF 2 Finset.univ := by rw [h2']
    _ = Finset.univ := huniv 2

theorem plusQuandlePerpOKBool_spec {a : Fin 60} (h : plusQuandlePerpOKBool a = true) :
    plusQuandlePerpOK a := by
  rw [plusQuandlePerpOKBool] at h
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨hseed, hseq⟩, hinj⟩, hc0⟩, hc1⟩, hder⟩, hhom⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact of_decide_eq_true hseed
  · intro t
    exact of_decide_eq_true (plusQuandleAll_range hseq t t.isLt)
  · intro i j hij
    have h1 := plusQuandleAll_range hinj i i.isLt
    exact Fin.ext (of_decide_eq_true (plusQuandleAll_range h1 j j.isLt) hij)
  · intro t hcode
    exact of_decide_eq_true (plusQuandleAll_range hc0 t t.isLt) hcode
  · intro t hcode
    exact of_decide_eq_true (plusQuandleAll_range hc1 t t.isLt) hcode
  · intro t hle
    exact of_decide_eq_true (plusQuandleAll_range hder t t.isLt) hle
  · intro c'
    exact of_decide_eq_true (plusQuandleAll_range hhom c' c'.isLt)

theorem plusQuandlePerpCheck_spec (h : plusQuandlePerpCheck () = true) :
    ∀ a : Fin 60, plusQuandlePerpOK a := by
  intro a
  have h1 : ∀ n < 60, plusQuandlePerpOKBool (Fin.ofNat 60 n) = true := by
    simpa only [plusQuandlePerpCheck, List.all_eq_true, List.mem_range] using h
  have h2 := h1 (a : ℕ) a.isLt
  have ha : (Fin.ofNat 60 (a : ℕ) : Fin 60) = a := by
    apply Fin.ext
    show (a : ℕ) % 60 = (a : ℕ)
    rw [Nat.mod_eq_of_lt a.isLt]
  rw [ha] at h2
  exact plusQuandlePerpOKBool_spec h2

theorem plusQuandleFoldFrom_add (a c' n₁ n₂ m : ℕ) (acc : Array ℕ) :
    plusQuandleFoldFrom a c' (n₁ + n₂) m acc =
      plusQuandleFoldFrom a c' n₂ (m + n₁) (plusQuandleFoldFrom a c' n₁ m acc) := by
  induction n₁ generalizing m acc with
  | zero => simp [plusQuandleFoldFrom]
  | succ n₁ ih =>
    have e : n₁ + 1 + n₂ = (n₁ + n₂) + 1 := by omega
    rw [e]
    simp only [plusQuandleFoldFrom]
    rw [ih (m + 1) (plusQuandleStep a c' acc m)]
    congr 1
    omega

theorem plusQuandleFoldFrom_preserve (a c' n m : ℕ) (acc : Array ℕ) (p : ℕ)
    (h : ∀ i, m ≤ i → i < m + n → plusQuandleSeq a i ≠ p) :
    (plusQuandleFoldFrom a c' n m acc)[p]! = acc[p]! := by
  induction n generalizing m acc with
  | zero => simp [plusQuandleFoldFrom]
  | succ n ih =>
    rw [plusQuandleFoldFrom]
    rw [ih (m + 1) (plusQuandleStep a c' acc m)]
    · dsimp only [plusQuandleStep]
      exact Array.getElem!_set!_ne acc (plusQuandleSeq a m) p _ (h m le_rfl (by omega))
    · intro i hi1 hi2
      exact h i (by omega) (by omega)

theorem plusQuandleFoldFrom_size (a c' n m : ℕ) (acc : Array ℕ) :
    (plusQuandleFoldFrom a c' n m acc).size = acc.size := by
  induction n generalizing m acc with
  | zero => rfl
  | succ n ih =>
    rw [plusQuandleFoldFrom, ih]
    simp only [plusQuandleStep, Array.size_set!]

theorem plusQuandleMkD_get (a c' t : ℕ) (ht : t < 60) (hseq : plusQuandleSeq a t < 60)
    (hinj : ∀ i j, i < 60 → j < 60 → plusQuandleSeq a i = plusQuandleSeq a j → i = j)
    (hsrc : 2 ≤ plusQuandleCode a t →
      (plusQuandleCode a t - 2) / 60 < t ∧ (plusQuandleCode a t - 2) % 60 < t) :
    (plusQuandleMkD a c')[plusQuandleSeq a t]! =
      (if plusQuandleCode a t = 0 then plusQuandleSeq a t
       else if plusQuandleCode a t = 1 then c'
       else plusQuandleT ((plusQuandleMkD a c')[plusQuandleSeq a ((plusQuandleCode a t - 2) / 60)]!)
         ((plusQuandleMkD a c')[plusQuandleSeq a ((plusQuandleCode a t - 2) % 60)]!)) := by
  set X := plusQuandleFoldFrom a c' t 0 (Array.replicate 60 0) with hX
  have h1 : plusQuandleMkD a c' = plusQuandleFoldFrom a c' (60 - t) t X := by
    have h := plusQuandleFoldFrom_add a c' t (60 - t) 0 (Array.replicate 60 0)
    rw [show t + (60 - t) = 60 by omega] at h
    rw [plusQuandleMkD, h, hX, Nat.zero_add]
  have h2 : plusQuandleFoldFrom a c' (60 - t) t X =
      plusQuandleFoldFrom a c' (60 - (t + 1)) (t + 1) (plusQuandleStep a c' X t) := by
    have h := plusQuandleFoldFrom_add a c' 1 (60 - (t + 1)) t X
    rw [show 1 + (60 - (t + 1)) = 60 - t by omega] at h
    rw [h]
    rfl
  have h3 : (plusQuandleFoldFrom a c' (60 - (t + 1)) (t + 1) (plusQuandleStep a c' X t))[
      plusQuandleSeq a t]! = (plusQuandleStep a c' X t)[plusQuandleSeq a t]! := by
    apply plusQuandleFoldFrom_preserve
    intro i hi1 hi2 heq
    exact absurd (hinj i t (by omega) ht heq) (by omega)
  have h4 : ∀ y, y < t → (plusQuandleMkD a c')[plusQuandleSeq a y]! = X[plusQuandleSeq a y]! := by
    intro y hy
    rw [h1]
    apply plusQuandleFoldFrom_preserve
    intro i hi1 hi2 heq
    exact absurd (hinj i y (by omega) (by omega) heq) (by omega)
  conv_lhs => rw [h1, h2, h3]
  dsimp only [plusQuandleStep]
  rw [Array.getElem!_set!_self]
  · by_cases hc0 : plusQuandleCode a t = 0
    · rw [if_pos hc0, if_pos hc0]
    · rw [if_neg hc0, if_neg hc0]
      by_cases hc1 : plusQuandleCode a t = 1
      · rw [if_pos hc1, if_pos hc1]
      · rw [if_neg hc1, if_neg hc1]
        obtain ⟨hx, hy⟩ := hsrc (by omega)
        rw [← h4 ((plusQuandleCode a t - 2) / 60) hx,
          ← h4 ((plusQuandleCode a t - 2) % 60) hy]
  · rw [hX, plusQuandleFoldFrom_size]
    simpa using hseq

end CFSG.OddTranspositions.PartThree
