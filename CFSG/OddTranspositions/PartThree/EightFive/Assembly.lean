section CardBound

variable {G : Type} [Group G] [Finite G] {D : Set G}

theorem card_quotient_solvableRadical_localGroup_lt (hC : HypothesisC D)
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥)
    {u w v : G} (htri : IsTriangle D u w v) {n : ℕ} (hn : Odd n)
    (hord : orderOf (u * v * w) = 2 * n) {z : G} (hzdef : (u * v * w) ^ n = z) :
    Nat.card (localGroup D z ⧸ CFSG.solvableRadical (localGroup D z)) < Nat.card G := by
  classical
  obtain ⟨-, hz1, -, -, -, -⟩ := htri.third_kind hC.setup.oddT hC.setup.normal hn hord
  rw [hzdef] at hz1
  have hKtop : localGroup D z ≠ ⊤ := by
    intro hK
    have hKle : localGroup D z ≤ Subgroup.centralizer ({z} : Set G) := by
      rw [localGroup, Subgroup.closure_le]
      rintro x ⟨-, hxz⟩
      exact Subgroup.mem_centralizer_singleton_iff.mpr hxz.eq
    have hzcenter : z ∈ Subgroup.center G := by
      rw [Subgroup.mem_center_iff]
      intro g
      have hg : g ∈ localGroup D z := by rw [hK]; exact Subgroup.mem_top g
      exact Subgroup.mem_centralizer_singleton_iff.mp (hKle hg)
    have hN : (Subgroup.zpowers z).Normal :=
      Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr hzcenter)
    have hbot : Subgroup.zpowers z = ⊥ := hrad _ hN inferInstance
    have hzmem : z ∈ (⊥ : Subgroup G) := by
      rw [← hbot]
      exact Subgroup.mem_zpowers z
    exact hz1 (by simpa using hzmem)
  calc Nat.card (localGroup D z ⧸ CFSG.solvableRadical (localGroup D z))
      ≤ Nat.card (localGroup D z) :=
        Nat.le_of_dvd Nat.card_pos (Subgroup.card_quotient_dvd_card _)
    _ < Nat.card G := by
      rw [← Subgroup.card_top (G := G)]
      exact Subgroup.card_lt_of_lt (H := localGroup D z) (K := ⊤) (lt_top_iff_ne_top.mpr hKtop)

end CardBound

section InputsCertificates


variable {G : Type} [Group G] [Finite G] {D : Set G}

theorem exists_commute_of_thirdKind_mem_DalphaStar (hT1 : TheoremOne)
    (h2 : AschbacherTheoremTwo) (hcase2 : EightFiveCaseTwo) (hC : HypothesisC D)
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥)
    (hO4 : ¬ O4PairData G D)
    (hIH : ∀ (Y : Type) [Group Y] [Finite Y], Nat.card Y < Nat.card G → Theorem8_5At Y)
    {w v : G} (htri : IsTriangle D hC.d w v) {n : ℕ} (hn : Odd n) (hn1 : 1 < n)
    (hord : orderOf (hC.d * v * w) = 2 * n) {z : G} (hzdef : (hC.d * v * w) ^ n = z)
    (hv : v ∈ DalphaStar D hC.alpha)
    (htrans : ∀ x ∈ centSet D z, ∃ k ∈ localGroup D z, k * hC.d * k⁻¹ = x) :
    ∃ d ∈ D, Commute d hC.d ∧ Commute d v ∧ Commute d w := by
  classical
  by_contra hno
  have hB : CFSG.BenderSuzuki.IsBenderGroup
      (localGroup D z ⧸ CFSG.solvableRadical (localGroup D z)) :=
    isBenderGroup_quotient_of_theorem8_5At hT1 hC.setup htri hn hn1 hord hzdef htrans
      (hIH (localGroup D z ⧸ CFSG.solvableRadical (localGroup D z))
        (card_quotient_solvableRadical_localGroup_lt hC hrad htri hn hord hzdef)) hno
  by_cases hQ : CFSG.pCore 2 (localGroup D z) ≤ Subgroup.center (localGroup D z)
  · exact hno (exists_commute_of_pCore_le_center h2 hC hrad hO4 htri hn hn1 hord hzdef
      htrans hQ hB)
  · by_cases hex : ∃ q ∈ CFSG.pCore 2 (localGroup D z),
        (q : G) * hC.d * (q : G)⁻¹ ∉ hC.alpha
    · obtain ⟨q, hq, hqa⟩ := hex
      exact hno (exists_commute_of_conj_pCore_not_mem_alpha hC htri hn hn1 hord hzdef hv
        htrans hB hq hqa)
    · have hα : ∀ q ∈ CFSG.pCore 2 (localGroup D z),
          (q : G) * hC.d * (q : G)⁻¹ ∈ hC.alpha := by
        intro q hq
        by_contra hqa
        exact hex ⟨q, hq, hqa⟩
      exact hno (hcase2 G D hC hrad hO4 hIH w v htri hv n hn hn1 hord z hzdef htrans hB
        hQ hα)

theorem exists_commute_of_thirdKind (hT1 : TheoremOne) (h2 : AschbacherTheoremTwo)
    (hcase2 : EightFiveCaseTwo) (hC : HypothesisC D)
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥)
    (hO4 : ¬ O4PairData G D)
    (hIH : ∀ (Y : Type) [Group Y] [Finite Y], Nat.card Y < Nat.card G → Theorem8_5At Y)
    {w v : G} (htri : IsTriangle D hC.d w v) {n : ℕ} (hn : Odd n) (hn1 : 1 < n)
    (hord : orderOf (hC.d * v * w) = 2 * n) {z : G} (hzdef : (hC.d * v * w) ^ n = z)
    (htrans : ∀ x ∈ centSet D z, ∃ k ∈ localGroup D z, k * hC.d * k⁻¹ = x) :
    ∃ d ∈ D, Commute d hC.d ∧ Commute d v ∧ Commute d w := by
  classical
  by_cases hv : v ∈ hC.alpha
  · obtain ⟨hbStar, htri', hm_odd, hm_gt1, hord', hpow⟩ :=
      exists_thirdKind_uvz_of_mem_alpha hC hrad hC.d_mem_alpha hv htri hn hord hzdef htrans
    obtain ⟨d, hdD, hdu, hdb, hdw⟩ :=
      exists_commute_of_thirdKind_mem_DalphaStar hT1 h2 hcase2 hC hrad hO4 hIH htri'
        hm_odd hm_gt1 hord' hpow hbStar htrans
    have hdz : Commute d z := by
      rw [← hpow]
      exact ((hdu.mul_right hdb).mul_right hdw).pow_right _
    have hzz : z * z = 1 := by
      have h := (htri.third_kind hC.setup.oddT hC.setup.normal hn hord).1
      rwa [hzdef] at h
    have hveq : hC.d * (hC.d * v * z) * z = v := by
      calc hC.d * (hC.d * v * z) * z = (hC.d * hC.d) * v * (z * z) := by group
        _ = v := by rw [hC.setup.oddT.mul_self_eq_one htri.1, hzz, one_mul, mul_one]
    refine ⟨d, hdD, hdu, ?_, hdw⟩
    rw [← hveq]
    exact (hdu.mul_right hdb).mul_right hdz
  · exact exists_commute_of_thirdKind_mem_DalphaStar hT1 h2 hcase2 hC hrad hO4 hIH htri
      hn hn1 hord hzdef
      (mem_DalphaStar_of_mem_D_of_not_mem_alpha_of_commute hC hC.d_mem_alpha htri.2.1 hv
        htri.2.2.2.2.1.symm)
      htrans

end InputsCertificates

section TheoremInputs


theorem theorem8_5_of_inputs (hT1 : TheoremOne) (h2 : AschbacherTheoremTwo)
    (hcase2 : EightFiveCaseTwo) : Theorem8_5 := by
  rw [theorem8_5_iff]
  have key : ∀ n : ℕ, ∀ (Y : Type) [Group Y] [Finite Y],
      Nat.card Y = n → Theorem8_5At Y := by
    intro n
    refine Nat.strong_induction_on (p := fun m : ℕ =>
      ∀ (Y : Type) [Group Y] [Finite Y], Nat.card Y = m → Theorem8_5At Y) n ?_
    intro n ih Y _ _ hY D hC hrad hO4 u w v htri hthird
    obtain ⟨g, hg⟩ := isConj_iff.mp (hC.setup.isConj hC.hd htri.1)
    let hC' : HypothesisC D := hC.conj g
    have hC'd : hC'.d = u := hg
    rw [← hC'd] at htri hthird
    obtain ⟨m, hm_odd, hm_gt1, hm_ord⟩ := hthird
    have hIH : ∀ (Z : Type) [Group Z] [Finite Z],
        Nat.card Z < Nat.card Y → Theorem8_5At Z := by
      intro Z _ _ hZ
      exact ih (Nat.card Z) (by rwa [hY] at hZ) Z rfl
    rcases transitive_or_exists_commute hC'.setup htri hm_odd hm_ord rfl with htrans | hdone
    · obtain ⟨d, hdD, hdu, hdv, hdw⟩ :=
        exists_commute_of_thirdKind hT1 h2 hcase2 hC' hrad hO4 hIH htri hm_odd hm_gt1
          hm_ord rfl htrans
      rw [hC'd] at hdu
      exact ⟨d, hdD, hdu, hdv, hdw⟩
    · rw [hC'd] at hdone
      exact hdone
  intro G _ _
  exact key (Nat.card G) G rfl

end TheoremInputs

section CaseTwoCertificates


theorem theorem8_5_of_caseTwo (hcase2 : EightFiveCaseTwo) : Theorem8_5 :=
  theorem8_5_of_inputs CFSG.Timmesfeld.Bridge.Asc72.theoremOne
    CFSG.OddTranspositions.aschbacherTheoremTwo_holds hcase2

theorem theorem8_7_of_caseTwo (hcase2 : EightFiveCaseTwo) : Theorem8_7 :=
  theorem8_7_of_theorem8_5 (theorem8_5_of_caseTwo hcase2)

end CaseTwoCertificates

