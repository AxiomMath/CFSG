theorem outer_comm_of_ggOutComm {R : Type} [Group R] (h : CFSG.StandardType.GGOutComm R) :
    ∀ a b : Outer R, a * b = b * a := by
  intro a b
  obtain ⟨α, rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨β, rfl⟩ := QuotientGroup.mk_surjective b
  have hc : ((α * β * α⁻¹ * β⁻¹ : MulAut R) : Outer R) = 1 := (QuotientGroup.eq_one_iff _).2 (h α β)
  rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
    QuotientGroup.mk_inv, ← commutatorElement_def, commutatorElement_eq_one_iff_mul_comm] at hc
  exact hc

variable {F : Type} [Field F] [Finite F] [CharP F 2]

theorem false_of_simple_normal_orthogonalPlus_two
    {N : Subgroup ↥(CFSG.PGLModel.orthogonalPlus 2 F)} [N.Normal]
    (hab : ∀ a b : ↥(CFSG.PGLModel.orthogonalPlus 2 F), a * b * a⁻¹ * b⁻¹ ∈ N)
    (hs : IsSimpleGroup N) (hnc : ∃ a b : N, a * b ≠ b * a) : False := by
  have hP : (plusN (F := F)).Normal := plusN_normal
  have hNP : N ≤ plusN (F := F) := by
    have := hP.subgroupOf N
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal ((plusN (F := F)).subgroupOf N) with h | h
    · exfalso
      obtain ⟨a, b, hne⟩ := hnc
      let φ : N →* ↥(CFSG.PGLModel.orthogonalPlus 2 F) ⧸ plusN (F := F) :=
        (QuotientGroup.mk' (plusN (F := F))).comp N.subtype
      have hker : φ.ker = ⊥ := by
        rw [← h]
        ext x
        simp [φ, Subgroup.mem_subgroupOf, QuotientGroup.eq_one_iff]
      have hinj : Function.Injective φ := (MonoidHom.ker_eq_bot_iff φ).mp hker
      have hcard : Nat.card N ≤ 2 :=
        (Nat.card_le_card_of_injective φ hinj).trans_eq (index_plusN (F := F))
      have hpos : 0 < Nat.card N := Nat.card_pos
      have hcomm : ∀ x y : N, x * y = y * x := by
        rcases (by omega : Nat.card N = 1 ∨ Nat.card N = 2) with h1 | h2
        · intro x y
          have : Subsingleton N := (Nat.card_eq_one_iff_unique.mp h1).1
          exact Subsingleton.elim _ _
        · have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
          have : IsCyclic N := isCyclic_of_prime_card h2
          exact fun x y => (IsCyclic.commGroup (α := N)).mul_comm x y
      exact hne (hcomm a b)
    · exact Subgroup.subgroupOf_eq_top.mp h
  let e := (plusNEquiv (F := F))
  let NP : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F × Matrix.SpecialLinearGroup (Fin 2) F) :=
    (N.subgroupOf (plusN (F := F))).map e.symm.toMonoidHom
  have hNPn : NP.Normal :=
    (Subgroup.Normal.subgroupOf inferInstance (plusN (F := F))).map e.symm.toMonoidHom
      e.symm.surjective
  have hNPc : ∀ a b, a * b * a⁻¹ * b⁻¹ ∈ NP := by
    intro a b
    have h1 : e a * e b * (e a)⁻¹ * (e b)⁻¹ ∈ N.subgroupOf (plusN (F := F)) := by
      rw [Subgroup.mem_subgroupOf]
      simpa using hab (e a : ↥(CFSG.PGLModel.orthogonalPlus 2 F)) (e b)
    have h2 := Subgroup.mem_map_of_mem e.symm.toMonoidHom h1
    have h3 : e.symm.toMonoidHom (e a * e b * (e a)⁻¹ * (e b)⁻¹) = a * b * a⁻¹ * b⁻¹ := by
      simp
    rw [← h3]
    exact h2
  obtain ⟨x, y, hxy⟩ : ∃ x y : Matrix.SpecialLinearGroup (Fin 2) F, x * y ≠ y * x :=
    CFSG.Quasithin.F7Two.sl2_nonabelian
  have hsNP : IsSimpleGroup NP := by
    have eN : ↥N ≃* ↥NP := (Subgroup.subgroupOfEquivOfLe hNP).symm.trans
      ((N.subgroupOf (plusN (F := F))).equivMapOfInjective e.symm.toMonoidHom e.symm.injective)
    have : Nontrivial NP := eN.symm.toEquiv.nontrivial
    exact IsSimpleGroup.isSimpleGroup_of_surjective eN.toMonoidHom eN.surjective
  have hL : NP ≤ (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)).prod ⊥ := by
    have := (Subgroup.prod_normal (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F))
      (⊥ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F))).subgroupOf NP
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
        (((⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)).prod ⊥).subgroupOf NP) with h | h
    · exfalso
      have hd := Subgroup.subgroupOf_eq_bot.mp h
      have hmem : ((x, 1) * (y, 1) * (x, 1)⁻¹ * (y, 1)⁻¹ :
          Matrix.SpecialLinearGroup (Fin 2) F × Matrix.SpecialLinearGroup (Fin 2) F) ∈
            ((⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)).prod ⊥) ⊓ NP :=
        ⟨by simp [Subgroup.mem_prod], hNPc _ _⟩
      rw [hd.eq_bot, Subgroup.mem_bot, Prod.ext_iff] at hmem
      apply hxy
      have h1 := hmem.1
      simp only [Prod.fst_mul, Prod.fst_inv, Prod.fst_one] at h1
      rw [← commutatorElement_def, commutatorElement_eq_one_iff_mul_comm] at h1
      exact h1
    · exact Subgroup.subgroupOf_eq_top.mp h
  have hR : NP ≤ (⊥ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)).prod ⊤ := by
    have := (Subgroup.prod_normal (⊥ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F))
      (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F))).subgroupOf NP
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
        (((⊥ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)).prod ⊤).subgroupOf NP) with h | h
    · exfalso
      have hd := Subgroup.subgroupOf_eq_bot.mp h
      have hmem : ((1, x) * (1, y) * (1, x)⁻¹ * (1, y)⁻¹ :
          Matrix.SpecialLinearGroup (Fin 2) F × Matrix.SpecialLinearGroup (Fin 2) F) ∈
            ((⊥ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) F)).prod ⊤) ⊓ NP :=
        ⟨by simp [Subgroup.mem_prod], hNPc _ _⟩
      rw [hd.eq_bot, Subgroup.mem_bot, Prod.ext_iff] at hmem
      apply hxy
      have h2 := hmem.2
      simp only [Prod.snd_mul, Prod.snd_inv, Prod.snd_one] at h2
      rw [← commutatorElement_def, commutatorElement_eq_one_iff_mul_comm] at h2
      exact h2
    · exact Subgroup.subgroupOf_eq_top.mp h
  have : Nontrivial NP := hsNP.toNontrivial
  obtain ⟨z, hz⟩ := exists_ne (1 : NP)
  have hzL := (Subgroup.mem_prod.mp (hL z.2)).2
  have hzR := (Subgroup.mem_prod.mp (hR z.2)).1
  rw [Subgroup.mem_bot] at hzL hzR
  exact hz (Subtype.ext (Prod.ext hzR hzL))

theorem outer_comm_of_mulEquiv_commutator_orthogonalPlus_three {X : Type} [Group X]
    (hs : IsSimpleGroup X) (hnc : ∃ a b : X, a * b ≠ b * a) {n : ℕ} (hF : Nat.card F = 2 ^ n)
    (e : X ≃* ↥(commutator ↥(CFSG.PGLModel.orthogonalPlus 3 F))) :
    ∀ a b : Outer X, a * b = b * a := by
  have hc : Subgroup.center (Matrix.SpecialLinearGroup (Fin 4) F) = ⊥ :=
    (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center 4 F).symm.trans
      (CFSG.SeitzReduction.OmegaPilot.scalars_four_eq_bot_of_charTwo F)
  let eP : Matrix.SpecialLinearGroup (Fin 4) F ≃* StatedProj (StatedSL 4 F) :=
    ((QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot).symm.trans
      (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 4 F)
  let eX : X ≃* StatedProj (StatedSL 4 F) :=
    ((e.trans (CFSG.LocalAnalysis.WeakClosure81.commutatorOrthogonalPlusEquiv 3 F)).trans
      (CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719.Thm14_5.kleinOmegaEquiv F).symm).trans
      eP
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with rfl | h
    · have := Finite.one_lt_card (α := F)
      rw [hF] at this
      simp at this
    · exact h
  have hm : StatedClassicalModel X .PSL 4 2 n := by
    refine ⟨⟨Nat.prime_two, hn, by norm_num, ?_, ?_⟩, F, inferInstance, inferInstance, hF, ⟨eX⟩⟩
    · intro h; simp at h
    · intro h; simp at h
  have : Group.IsPerfect X := by
    have := hs
    refine TauCeti.IsSimpleGroup.isPerfect_of_not_isMulCommutative fun h => ?_
    obtain ⟨a, b, hab⟩ := hnc
    exact hab (h.is_comm.comm a b)
  have hodd : Nat.gcd 4 (2 ^ n - 1) = 1 := by
    have h2 : ¬ 2 ∣ 2 ^ n - 1 := by
      have h1 : 2 ∣ 2 ^ n := dvd_pow_self 2 (by omega)
      have h3 : 1 ≤ 2 ^ n := Nat.one_le_two_pow
      omega
    have hc : Nat.Coprime 2 (2 ^ n - 1) := (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h2
    simpa using Nat.Coprime.pow_left 2 hc
  exact CFSG.Quasithin.H13.KGLieOut.outer_comm_psl hs hm hodd

theorem outer_comm_commutator_orthogonalPlus_of_five_le {k : ℕ} (hk : 5 ≤ k) :
    ∀ a b : Outer ↥(commutator ↥(CFSG.PGLModel.orthogonalPlus k F)), a * b = b * a := by
  let e : ↥(commutator ↥(CFSG.PGLModel.orthogonalPlus k F)) ≃*
      StatedProj (StatedOmega (StatedQuadPlus k F)) :=
    (CFSG.LocalAnalysis.WeakClosure81.commutatorOrthogonalPlusEquiv k F).trans
      (CFSG.RankThree.PartOne.KFU.equivProjOfScalarsBot _
        (CFSG.RankThree.PartOne.KFU.statedScalars_subgroupOf_statedOmega_quadPlus_eq_bot
          (by omega)))
  exact CFSG.Quasithin.S146zY.outer_comm_of_mulEquiv e.symm
    (outer_comm_of_ggOutComm (CFSG.StandardType.InndiagCommRest.ggOutComm_omegaPlus hk))

